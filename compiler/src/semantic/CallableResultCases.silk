  return run opaqueUnionDescriptorCollisionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn opaqueUnionDescriptorCollisionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("opaque-union-descriptor-collision.silk")
  let text = """
fn leaf() -> i32 { return 42 }
type Leaf = typeof(leaf)
struct Pair<F: fn<'static>() -> i32> { value: &'static (F | Leaf) }
fn forward(value: Pair<Leaf>) -> some<F: fn<'static>() -> i32> Pair<F> { return move value }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"forward")
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"forward")
  run Testing.expect(succeeded(&body) && opaqueUnionGapSpan(&answer, &id, text, "{ return move value }"),
    "a source-valid descriptor-only collision has the precise carried-union gap before MIR publication")
}

test effect fn opaqueUnionStorageRejectsLatentRecursiveCollision() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run opaqueUnionLatentCollisionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn opaqueUnionLatentCollisionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("opaque-union-latent-recursive-collision.silk")
  let text = """
fn leaf() -> i32 { return 42 }
type Leaf = typeof(leaf)
fn other() -> i32 { return 7 }
type Other = typeof(other)
struct Node<T: fn<'static>() -> i32, F: fn<'static>() -> i32> {
  payload: &'static (T | Leaf)
  next: &'static Node<F, F>
}
struct Wrap<T> { value: T }
fn forward<F: fn<'static>() -> i32>(value: &'static Node<Other, F>) -> some<G: fn<'static>() -> i32> Wrap<&'static Node<Other, G>> { return Wrap { value: value } }
fn entry(value: &'static Node<Other, Leaf>) -> i32 { drop forward(value) return 42 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"entry")
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"entry")
  run Testing.expect(succeeded(&body) && opaqueUnionGapSpan(&answer, &id, text, "{ drop forward(value) return 42 }"),
    "an unchanged first union cannot hide a later projected collision behind a nominal-owner recurrence")
}

fn opaqueUnionBackendGap(answer: &Result<Answer, NoRejection>) -> Option<Shared<BackendGap>> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Unsupported {gap}} => Option.some<Shared<BackendGap>>(Shared.clone<BackendGap>(&gap))
      _ => Option.none<Shared<BackendGap>>()
    }
    _ => Option.none<Shared<BackendGap>>()
  }
}
fn opaqueUnionGapSpan(answer: &Shared<Result<Answer, NoRejection>>, id: &ModuleId, text: string, spelling: string) -> bool {
  let start = offsetOf(text, spelling, usize.ZERO)
  let end = start + String.utf8Bytes(spelling).length
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<BackendGap>>>(answer, opaqueUnionBackendGap)
  if let Option<Shared<BackendGap>>.Some {value} = move found {
    return Shared.with<BackendGap, bool>(&value, fn(gap: &BackendGap) -> bool {
      let span = BackendGap.span(gap)
      return gap.code == GapCode.UnionForm && start != usize.MAX && span.start == start && span.end == end
        && BackendGap.moduleMatches(gap, id) && opaqueUnionGapDiagnostic(gap)
    })
  }
  return false
}
fn opaqueUnionGapDiagnostic(gap: &BackendGap) -> bool {
  if let BackendGapSource.Diagnostic {diagnostic} = &gap.source {
    return Shared.with<Rejection, bool>(&diagnostic, fn(value: &Rejection) -> bool {
      return value.code == RejectionCode.UnionFormUnavailable
    })
  }
  return false
}

test effect fn anonymousCallableParametersKeepExactOriginalInstances() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run anonymousParameterIdentityClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn anonymousParameterIdentityClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("anonymous-parameter-identities.silk")
  let text = """
fn main() -> i32 {
  let first = fn(value: i32) -> i32 { return value + 2 }
  let second = fn(value: i32) -> i32 { return value + 3 }
  let apply = fn(callback: fn<'static>(i32) -> i32, value: i32) -> i32 { return callback(value) }
  return apply(first, 20) + apply(second, 17)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let first = anonymousParameterApplication(&store, &entry, usize.ZERO)
  let second = anonymousParameterApplication(&store, &entry, usize.ONE)
  if let Option<Shared<SpecializationApplication>>.Some {value: left} = move first {
    if let Option<Shared<SpecializationApplication>>.Some {value: right} = move second {
      let a = run SpecializationApplication.copyShared(&left)
      let b = run SpecializationApplication.copyShared(&right)
      let header = run Semantic.demandSignatureOf(&mut store, &mut request, SpecializationApplication.bodyDeclaration(&a))
      let slot = Shared.with<Result<Answer, NoRejection>, usize>(&header, anonymousParameterHeaderSlot)
      let selectedSlots = Vector.asSlice<usize>(&a.argumentOrdinals)
      run Testing.expect(DeclarationId.equals(SpecializationApplication.bodyDeclaration(&a), SpecializationApplication.bodyDeclaration(&b))
        && anonymousIdentityOrdinal(SpecializationApplication.bodyDeclaration(&a)) == 2
        && selectedSlots.length == usize.ONE && selectedSlots[usize.ZERO] == slot && slot != usize.MAX
        && anonymousParameterRepresentation(&a) == usize.ZERO && anonymousParameterRepresentation(&b) == usize.ONE
        && !(run SpecializationApplication.equals(&a, &b)),
        "one original anonymous declaration selects distinct exact callback representations")
      return ()
    }
  }
  run Testing.expect(false, "both original anonymous applications are direct MIR calls")
}
fn anonymousParameterHeaderSlot(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
      if parameters.length != 2 { return usize.MAX }
      let slot = Shared.with<Type, usize>(&parameters[usize.ZERO], fn(value: &Type) -> usize {
        return match &value.* { Type.Parameter {ordinal, declaration} => {
          if DeclarationId.kind(&declaration) == OwnerKind.Anonymous { return ordinal }
          return usize.MAX
        } _ => usize.MAX }
      })
      if slot == signature.callableParameterStart { return slot }
    }
  }
  return usize.MAX
}
fn anonymousIdentityOrdinal(identity: &DeclarationId) -> usize {
  if DeclarationId.kind(identity) != OwnerKind.Anonymous { return usize.MAX }
  let count = DeclarationId.ownerCount(identity)
  if count == usize.ZERO { return usize.MAX }
  return DeclarationId.ownerOccurrence(identity, count - usize.ONE)
}
fn anonymousParameterRepresentation(application: &SpecializationApplication) -> usize {
  let arguments = Vector.asSlice<Argument>(&application.arguments)
  let ordinals = Vector.asSlice<usize>(&application.argumentOrdinals)
  if arguments.length != usize.ONE || ordinals.length != usize.ONE || ordinals[usize.ZERO] != usize.ZERO { return usize.MAX }
  if let Argument.Type {value} = &arguments[usize.ZERO] {
    return Shared.with<Type, usize>(&value, anonymousParameterRepresentationNode)
  }
  return usize.MAX
}
fn anonymousParameterRepresentationNode(value: &Type) -> usize {
  if let Type.CallableValue {application, captures, ..} = &value.* {
    if Vector.length<Shared<Type>>(&captures) != usize.ZERO { return usize.MAX }
    return Shared.with<SpecializationApplication, usize>(&application,
      fn(selected: &SpecializationApplication) -> usize { return anonymousIdentityOrdinal(SpecializationApplication.bodyDeclaration(selected)) })
  }
  return usize.MAX
}
fn anonymousParameterApplication(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, occurrence: usize)
  -> Option<Shared<SpecializationApplication>> {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut found = usize.ZERO
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &blocks[at].terminator {
          if let Option<Shared<SpecializationApplication>>.Some {value} = move InstanceKey.application(&key) {
            if Shared.with<SpecializationApplication, bool>(&value,
              fn(application: &SpecializationApplication) -> bool { return DeclarationId.kind(SpecializationApplication.bodyDeclaration(application)) == OwnerKind.Anonymous }) {
              if found == occurrence { return Option.some<Shared<SpecializationApplication>>(move value) }
              found = found + usize.ONE
            }
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<Shared<SpecializationApplication>>()
}

test effect fn anonymousCallableParametersSeparateMutableEnvironmentFromInvocation() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run anonymousParameterMutableClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn anonymousParameterMutableClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("anonymous-parameter-mutable.silk")
  let text = """
fn add(value: i32) -> i32 { return value + 2 }
fn main() -> i32 {
  let mut count = 0
  let mut apply = fn(mut callback: mut fn<'static>(i32) -> i32, value: i32) -> i32 { count = count + callback(value) return count }
  return apply(add, 40)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move anonymousParameterApplication(&store, &entry, usize.ZERO) {
    let application = run SpecializationApplication.copyShared(&value)
    let body = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&body, selectedMirIndex)
    if let Option<usize>.Some {value: selected} = move index {
      if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, selected) {
        let parameters = Vector.asSlice<Shared<Type>>(&function.parameters)
        run Testing.expect(parameters.length == 3 && Shared.with<Type, bool>(&parameters[usize.ZERO], anonymousMutableEnvironment)
          && Shared.with<Type, bool>(&parameters[usize.ONE], anonymousAddRepresentation)
          && Shared.with<Type, bool>(&parameters[2], opaqueUnionI32)
          && originalCallableInvocationCount(&store, &body, b"add", usize.ONE) == usize.ONE,
          "environment parameter zero is mutable and contains only the lexical count capture; callback invokes its original target")
        return ()
      }
    }
  }
  run Testing.expect(false, "the mutable anonymous invocation has retained exact MIR")
}
fn anonymousMutableEnvironment(value: &Type) -> bool {
  if let Type.Reference {referent, access, ..} = &value.* {
    return access == Access.Mutable && Shared.with<Type, bool>(&referent, anonymousSingleCaptureEnvironment)
  }
  return false
}
fn anonymousSingleCaptureEnvironment(value: &Type) -> bool {
  if let Type.CallableSchema {captures, fieldInputs, ..} = &value.* {
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    return fields.length == usize.ONE && Vector.length<CallableFieldInput>(&fieldInputs) == usize.ZERO
      && Shared.with<Type, bool>(&fields[usize.ZERO], anonymousCountCapture)
  }
  return false
}
fn anonymousCountCapture(value: &Type) -> bool {
  if let Type.Reference {referent, access, ..} = &value.* {
    return access == Access.Mutable && Shared.with<Type, bool>(&referent, opaqueUnionI32)
  }
  return false
}
fn anonymousAddRepresentation(value: &Type) -> bool { return anonymousNamedRepresentation(value, b"add") }
fn anonymousOtherRepresentation(value: &Type) -> bool { return anonymousNamedRepresentation(value, b"other") }
fn anonymousNamedRepresentation(value: &Type, name: &[u8]) -> bool {
  if let Type.CallableValue {application, captures, ..} = &value.* {
    return Vector.length<Shared<Type>>(&captures) == usize.ZERO && Shared.with<SpecializationApplication, bool>(&application,
      fn(selected: &SpecializationApplication) -> bool { return DeclarationId.named(SpecializationApplication.bodyDeclaration(selected), name) })
  }
  return false
}

test effect fn anonymousCallableParametersAppendStagedArgumentsInOriginalOrder() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run anonymousParameterStageClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn anonymousParameterStageClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("anonymous-parameter-staging.silk")
  let text = """
fn add(value: i32) -> i32 { return value + 2 }
fn other(value: i32) -> i32 { return value + 3 }
fn main() -> i32 {
  let apply = fn(value: i32, first: fn<'static>(i32) -> i32, second: fn<'static>(i32) -> i32) -> i32 { return first(value) * 10 + second(value) }
  let stage = apply(other)
  let ready = stage(add)
  return ready(18)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(anonymousStagedArgumentOrder(&store, &entry),
    "staging stores environment, second, first and appends first, second to the direct original call")
}
fn anonymousStagedArgumentOrder(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  let index = match move selected { Option<usize>.Some {value} => value _ => { return false } }
  let function = match move Semantic.mirAt(store, index) { Option<&MirFunction>.Some {value} => value _ => { return false } }
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
      let identity = InstanceKey.identity(&key)
      if Shared.with<DeclarationId, bool>(&identity, fn(value: &DeclarationId) -> bool { return anonymousIdentityOrdinal(value) == usize.ZERO }) {
        let operands = Vector.asSlice<MirOperand>(&arguments)
        if operands.length != 4 { return false }
        let scalar = anonymousStageScalar(&operands[usize.ONE])
        if !scalar || !sectionStoredField(&operands[2], 2) || !sectionStoredField(&operands[3], usize.ONE) { return false }
        let firstLocal = anonymousStageOperandLocal(&operands[2])
        let secondLocal = anonymousStageOperandLocal(&operands[3])
        if firstLocal == usize.MAX || firstLocal != secondLocal { return false }
        if !anonymousStageEnvironmentArgument(function, &operands[usize.ZERO], firstLocal) { return false }
        let locals = Vector.asSlice<MirLocal>(&function.locals)
        if firstLocal >= locals.length { return false }
        return Shared.with<Type, bool>(&locals[firstLocal].ty, anonymousStageInputs)
      }
    }
    at = at + usize.ONE
  }
  return false
}
fn anonymousStageScalar(value: &MirOperand) -> bool {
  return match &value.* { MirOperand.Integer {decimal, negative, ..} => !negative && sameBytes(Bytes.asSlice(&decimal), b"18") _ => false }
}
fn anonymousStageOperandLocal(value: &MirOperand) -> usize {
  return match &value.* { MirOperand.Copy {place} => place.local _ => usize.MAX }
}
fn anonymousStageInputs(value: &Type) -> bool {
  return match &value.* {
    Type.CallableSchema {captures, fieldInputs, ..} => anonymousStageFields(&captures, &fieldInputs)
    Type.CallableValue {captures, fieldInputs, ..} => anonymousStageFields(&captures, &fieldInputs)
    _ => false
  }
}
fn anonymousStageFields(fields: &Vector<Shared<Type>>, fieldInputs: &Vector<CallableFieldInput>) -> bool {
  let inputs = Vector.asSlice<CallableFieldInput>(fieldInputs)
  if inputs.length != 3 { return false }
  let environment = match &inputs[usize.ZERO] { CallableFieldInput.Environment => true _ => false }
  let second = match &inputs[usize.ONE] { CallableFieldInput.Argument {parameter} => parameter == 2 _ => false }
  let first = match &inputs[2] { CallableFieldInput.Argument {parameter} => parameter == usize.ONE _ => false }
  let captures = Vector.asSlice<Shared<Type>>(fields)
  return environment && second && first && captures.length == 3
    && Shared.with<Type, bool>(&captures[usize.ONE], anonymousOtherRepresentation)
    && Shared.with<Type, bool>(&captures[2], anonymousAddRepresentation)
}
fn anonymousStageEnvironmentArgument(function: &MirFunction, operand: &MirOperand, root: usize) -> bool {
  let mut temporary = usize.MAX
  if let MirOperand.Copy {place} = &operand.* {
    if Vector.length<MirProjection>(&place.projections) != usize.ZERO { return false }
    temporary = place.local
  } else { return false }
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Ref {place, access}, ..} = &statements[position] {
        if destination.local == temporary && Vector.length<MirProjection>(&destination.projections) == usize.ZERO {
          return access == Access.Shared && (place.local == root || anonymousStageBaseCopy(function, root, place.local)) && Vector.length<MirProjection>(&place.projections) == usize.ONE
            && lastProjectionCode(&place.projections) == usize.ZERO
        }
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}
fn anonymousStageBaseCopy(function: &MirFunction, snapshot: usize, original: usize) -> bool {
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Use {value: MirOperand.Copy {place}}, ..} = &statements[position] {
        if destination.local == snapshot && place.local == original && Vector.length<MirProjection>(&destination.projections) == usize.ZERO
          && Vector.length<MirProjection>(&place.projections) == usize.ZERO { return true }
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

struct DelayedContractPair { source: Shared<Type> target: Shared<Type> }
struct DelayedCallbackEvidence { representation: Shared<Type> operand: Shared<Type> }

// The expectation comes from the authored binders, including the original declaring owner.
fn delayedEnvironment(value: &Intersection, owner: &DeclarationId, invocation: bool,
  first: bool, second: bool, narrowed: bool) -> bool {
  let members = Vector.asSlice<LifetimeMember>(&value.members)
  let mut seenInvocation = false
  let mut seenFirst = false
  let mut seenSecond = false
  let mut seenNarrowed = false
  let mut at = usize.ZERO
  while at < members.length {
    let code = Shared.with<Lifetime, usize>(&members[at].region, fn(region: &Lifetime) -> usize {
      if let Lifetime.Invocation {ordinal} = &region.* {
        if ordinal == usize.ZERO { return usize.ZERO }
      }
      if let Lifetime.Parameter {declaration, ordinal} = &region.* {
        if DeclarationId.equals(&declaration, owner) {
          if ordinal == usize.ZERO { return usize.ONE }
          if ordinal == usize.ONE { return 2 }
          if ordinal == 2 { return 3 }
        }
      }
      return usize.MAX
    })
    if code == usize.ZERO { if seenInvocation { return false } seenInvocation = true }
    else if code == usize.ONE { if seenFirst { return false } seenFirst = true }
    else if code == 2 { if seenSecond { return false } seenSecond = true }
    else if code == 3 { if seenNarrowed { return false } seenNarrowed = true }
    else { return false }
    at = at + usize.ONE
  }
  return seenInvocation == invocation && seenFirst == first && seenSecond == second && seenNarrowed == narrowed
}
fn delayedEnvironmentShared(value: &Shared<Intersection>, owner: &DeclarationId, invocation: bool,
  first: bool, second: bool, narrowed: bool) -> bool {
  return Shared.with<Intersection, bool>(value, fn(environment: &Intersection) -> bool {
    return delayedEnvironment(environment, owner, invocation, first, second, narrowed)
  })
}
fn delayedI32(value: &Type) -> bool {
  if let Type.Primitive {name} = &value.* { return sameBytes(Bytes.asSlice(&name), b"i32") }
  return false
}
fn delayedEmptyFailure(value: &Type) -> bool {
  if let Type.Union {members} = &value.* { return Vector.length<Shared<Type>>(&members) == usize.ZERO }
  return false
}
fn delayedEmptyRow(value: &Row) -> bool {
  return Vector.length<Requirement>(&value.entries) == usize.ZERO
    && Vector.length<RowParameter>(&value.parameters) == usize.ZERO
    && Vector.length<RowSubtraction>(&value.subtractions) == usize.ZERO
}
fn delayedEffect(value: &Type, owner: &DeclarationId, mode: CallableMode,
  invocation: bool, first: bool, second: bool, narrowed: bool) -> bool {
  if let Type.Effect {mode: actualMode, environment, success, failure, requirements} = &value.* {
    return actualMode == mode && delayedEnvironmentShared(&environment, owner, invocation, first, second, narrowed)
      && Shared.with<Type, bool>(&success, delayedI32) && Shared.with<Type, bool>(&failure, delayedEmptyFailure)
      && Shared.with<Row, bool>(&requirements, delayedEmptyRow)
  }
  return false
}
fn delayedSameParameter(value: &Type, right: &Shared<Type>) -> bool {
  if let Type.Parameter {declaration, ordinal} = &value.* {
    return Shared.with<Type, bool>(right, fn(other: &Type) -> bool {
      if let Type.Parameter {declaration: compared, ordinal: position} = &other.* {
        return ordinal == position && DeclarationId.equals(&declaration, &compared)
      }
      return false
    })
  }
  return false
}
fn delayedParameterAddress(value: &Type) -> usize {
  return Pointer.address<Type>(Pointer.fromRef<Type>(value))
}
fn delayedIsParameter(value: &Type) -> bool {
  return match &value.* { Type.Parameter {..} => true _ => false }
}
fn delayedParameterEqual(left: &Shared<Type>, right: &Shared<Type>) -> bool {
  if Shared.with<Type, usize>(left, delayedParameterAddress)
    == Shared.with<Type, usize>(right, delayedParameterAddress) {
    return Shared.with<Type, bool>(left, delayedIsParameter)
  }
  return Shared.with<Type, bool>(left, fn(value: &Type) -> bool { return delayedSameParameter(value, right) })
}
fn delayedParameterContract(signature: &Signature, slot: usize) -> Option<Shared<Type>> {
  let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
  if slot >= parameters.length { return Option.none<Shared<Type>>() }
  let constraints = Vector.asSlice<Constraint>(&signature.constraints)
  let mut at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Represents {parameter, contract} = &constraints[at] {
      if delayedParameterEqual(&parameters[slot], &parameter) {
        return Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
      }
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Type>>()
}
fn delayedMetadataContracts(answer: &Result<Answer, NoRejection>) -> Option<DelayedContractPair> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      if Vector.length<Shared<Lifetime>>(&signature.lifetimeParameters) != 3
        || Vector.length<Shared<Type>>(&signature.parameters) != 2 { return Option.none<DelayedContractPair>() }
      let source = delayedParameterContract(&signature, usize.ZERO)
      let target = delayedParameterContract(&signature, usize.ONE)
      if let Option<Shared<Type>>.Some {value: offered} = move source {
        if let Option<Shared<Type>>.Some {value: promised} = move target {
          return Option.some<DelayedContractPair>(DelayedContractPair {source: move offered, target: move promised})
        }
      }
    }
  }
  return Option.none<DelayedContractPair>()
}
fn delayedMetadataRelation(body: &TypedBody, id: &ModuleId, pair: &DelayedContractPair,
  relation: &CallableContract.ValueRelation) -> bool {
  let owner = TypedBody.declarationId(body)
  if !ModuleId.equals(DeclarationId.moduleId(owner), id) || !DeclarationId.named(owner, b"environmentMetadata")
    || DeclarationId.kind(owner) != OwnerKind.Function || DeclarationId.ownerCount(owner) != usize.ONE
    || DeclarationId.ownerOccurrence(owner, usize.ZERO) != usize.ZERO { return false }
  if !Shared.with<Type, bool>(&pair.source, fn(value: &Type) -> bool {
    return delayedEffect(value, owner, CallableMode.Mutable, false, true, true, false)
  }) { return false }
  if !Shared.with<Type, bool>(&pair.target, fn(value: &Type) -> bool {
    return delayedEffect(value, owner, CallableMode.Once, false, false, false, true)
  }) { return false }
  let environments = Vector.asSlice<CallableContract.EnvironmentRelation>(&relation.environments)
  return Vector.length<Outlives>(&relation.outlives) == usize.ZERO && environments.length == usize.ONE
    && delayedEnvironmentShared(&environments[usize.ZERO].source, owner, false, true, true, false)
    && delayedEnvironmentShared(&environments[usize.ZERO].target, owner, false, false, false, true)
}
fn delayedMarkerType(value: &Type, caller: &DeclarationId, syntax: usize) -> bool {
  if let Type.Reference {referent, access, lifetime} = &value.* {
    return access == Access.Shared && Shared.with<Type, bool>(&referent, delayedI32)
      && Shared.with<Lifetime, bool>(&lifetime, fn(region: &Lifetime) -> bool {
        return match &region.* {
          Lifetime.Local {declaration, ordinal} => ordinal == syntax && DeclarationId.equals(&declaration, caller)
          _ => false
        }
      })
  }
  return false
}
fn delayedIntegerInitializer(node: &BodyNode) -> bool {
  return match &node.kind {
    BodyNodeKind.Expression {form: BodyExpression.Integer {..}, ..} => true
    _ => false
  }
}
// The scalar outer environment comes from this source loan, independently of the delayed result.
fn delayedMarkerOperand(body: &TypedBody, input: usize, syntax: usize, text: string) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  if input >= nodes.length { return false }
  let start = offsetOf(text, "&marker, move use", usize.ZERO)
  let declaration = offsetOf(text, "let marker = 0", usize.ZERO)
  if start == usize.MAX || declaration == usize.MAX { return false }
  let borrowed = &nodes[input]
  if borrowed.origin.span.start != start || borrowed.origin.span.end != start + 7 { return false }
  if let BodyNodeKind.Expression {ty, form: BodyExpression.Borrow {access, value}} = &borrowed.kind {
    if access != Access.Shared || value.index >= nodes.length
      || !Shared.with<Type, bool>(&ty, fn(view: &Type) -> bool {
        return delayedMarkerType(view, TypedBody.declarationId(body), syntax)
      }) { return false }
    if let BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} = &nodes[value.index].kind {
      let locals = TypedBody.localSlice(body)
      if local.index >= locals.length || locals[local.index].mutable
        || locals[local.index].origin.span.start != declaration + 4
        || locals[local.index].origin.span.end != declaration + 10
        || nodes[value.index].origin.span.start != start + usize.ONE
        || nodes[value.index].origin.span.end != start + 7
        || !Shared.with<Type, bool>(&locals[local.index].ty, delayedI32) { return false }
      let mut definitions = usize.ZERO
      let mut at = usize.ZERO
      while at < nodes.length {
        if let BodyNodeKind.LocalBinding {local: bound, initializer} = &nodes[at].kind {
          if bound.index == local.index {
            if initializer.index >= nodes.length
              || nodes[initializer.index].origin.span.start != declaration + 13
              || nodes[initializer.index].origin.span.end != declaration + 14 { return false }
            if !delayedIntegerInitializer(&nodes[initializer.index]) { return false }
            definitions = definitions + usize.ONE
          }
        }
        at = at + usize.ONE
      }
      return definitions == usize.ONE
    }
  }
  return false
}
fn delayedCallbackOperand(body: &TypedBody, input: usize, callback: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  if input >= nodes.length || callback >= nodes.length { return false }
  if let BodyNodeKind.Expression {form: BodyExpression.Move {value, ..}, ..} = &nodes[input].kind {
    if value.index >= nodes.length { return false }
    if let BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} = &nodes[value.index].kind {
      let locals = TypedBody.localSlice(body)
      if local.index >= locals.length || locals[local.index].mutable { return false }
      let mut definitions = usize.ZERO
      let mut at = usize.ZERO
      while at < nodes.length {
        if let BodyNodeKind.LocalBinding {local: bound, initializer} = &nodes[at].kind {
          if bound.index == local.index {
            if initializer.index != callback { return false }
            definitions = definitions + usize.ONE
          }
        }
        at = at + usize.ONE
      }
      return definitions == usize.ONE
    }
  }
  return false
}
fn delayedMarkerApplication(application: &SpecializationApplication, caller: &DeclarationId, syntax: usize) -> bool {
  let arguments = Vector.asSlice<Argument>(&application.arguments)
  let ordinals = Vector.asSlice<usize>(&application.argumentOrdinals)
  if arguments.length != 3 || ordinals.length != 3
    || Vector.length<ScopeBinding>(&application.scopes) != usize.ZERO { return false }
  let mut at = usize.ZERO
  while at < ordinals.length { if ordinals[at] != at { return false } at = at + usize.ONE }
  if let Argument.Lifetime {value: environment} = &arguments[usize.ZERO] {
    if !Shared.with<Lifetime, bool>(&environment, fn(region: &Lifetime) -> bool {
      return delayedParameterRegion(region, caller, 2)
    }) { return false }
  } else { return false }
  if let Argument.Type {value: representation} = &arguments[2] {
    if !Shared.with<Type, bool>(&representation, fn(value: &Type) -> bool {
      return delayedOriginalCallback(value, caller, true)
    }) { return false }
  } else { return false }
  if let Argument.Lifetime {value: outer} = &arguments[usize.ONE] {
    return Shared.with<Lifetime, bool>(&outer, fn(region: &Lifetime) -> bool {
      return match &region.* {
        Lifetime.Local {declaration, ordinal} => ordinal == syntax && DeclarationId.equals(&declaration, caller)
        _ => false
      }
    })
  }
  return false
}
fn delayedCallbackEvidence(body: &TypedBody, id: &ModuleId, caller: &[u8], consumer: &[u8],
  text: string, captured: bool) -> Option<DelayedCallbackEvidence> {
  let owner = TypedBody.declarationId(body)
  if !ModuleId.equals(DeclarationId.moduleId(owner), id) || !DeclarationId.named(owner, caller)
    || DeclarationId.kind(owner) != OwnerKind.Function || DeclarationId.ownerCount(owner) != usize.ONE
    || DeclarationId.ownerOccurrence(owner, usize.ZERO) != usize.ZERO {
    return Option.none<DelayedCallbackEvidence>()
  }
  let nodes = TypedBody.nodeSlice(body)
  let mut representation = Option.none<Shared<Type>>()
  let mut operand = Option.none<Shared<Type>>()
  let mut callbacks = usize.ZERO
  let mut callback = usize.MAX
  let mut calls = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Callable {..}} = &nodes[at].kind {
      callbacks = callbacks + usize.ONE
      callback = at
      representation = Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
    }
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration, application, arguments, ..}, ..} = &nodes[at].kind {
      if DeclarationId.named(&declaration, consumer) {
        if !ModuleId.equals(DeclarationId.moduleId(&declaration), id)
          || !Shared.with<SpecializationApplication, bool>(&application, fn(selected: &SpecializationApplication) -> bool {
            return DeclarationId.equals(SpecializationApplication.bodyDeclaration(selected), &declaration)
          }) { return Option.none<DelayedCallbackEvidence>() }
        let supplied = Vector.asSlice<BodyNodeId>(&arguments)
        let mut position = usize.ZERO
        if captured {
          if supplied.length != 2 || !delayedMarkerOperand(body, supplied[usize.ZERO].index, nodes[at].origin.syntax.index, text)
            || !Shared.with<SpecializationApplication, bool>(&application, fn(selected: &SpecializationApplication) -> bool {
              return delayedMarkerApplication(selected, owner, nodes[at].origin.syntax.index)
            }) { return Option.none<DelayedCallbackEvidence>() }
          position = usize.ONE
        } else if supplied.length != usize.ONE { return Option.none<DelayedCallbackEvidence>() }
        let input = supplied[position].index
        if input >= nodes.length || !delayedCallbackOperand(body, input, callback) { return Option.none<DelayedCallbackEvidence>() }
        operand = delayedNodeType(&nodes[input])
        calls = calls + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  if callbacks != usize.ONE || calls != usize.ONE { return Option.none<DelayedCallbackEvidence>() }
  if let Option<Shared<Type>>.Some {value: original} = move representation {
    if let Option<Shared<Type>>.Some {value: supplied} = move operand {
      return Option.some<DelayedCallbackEvidence>(DelayedCallbackEvidence {representation: move original, operand: move supplied})
    }
  }
  return Option.none<DelayedCallbackEvidence>()
}
fn delayedNodeType(node: &BodyNode) -> Option<Shared<Type>> {
  if let BodyNodeKind.Expression {ty, ..} = &node.kind { return Option.some<Shared<Type>>(Shared.clone<Type>(&ty)) }
  return Option.none<Shared<Type>>()
}
fn delayedReference(value: &Type, owner: &DeclarationId, ordinal: usize, invocation: bool, access: Access) -> bool {
  if let Type.Reference {referent, access: actual, lifetime} = &value.* {
    if actual != access || !Shared.with<Type, bool>(&referent, delayedI32) { return false }
    return Shared.with<Lifetime, bool>(&lifetime, fn(region: &Lifetime) -> bool {
      if invocation { return match &region.* { Lifetime.Invocation {ordinal: position} => position == ordinal _ => false } }
      return match &region.* {
        Lifetime.Parameter {declaration, ordinal: position} => position == ordinal && DeclarationId.equals(&declaration, owner)
        _ => false
      }
    })
  }
  return false
}
fn delayedOwnerName(left: &DeclarationId, right: &DeclarationId) -> bool {
  return DeclarationId.ownerNamed(left, usize.ZERO) && DeclarationId.ownerNamed(right, usize.ZERO)
    && sameBytes(DeclarationId.ownerName(left, usize.ZERO), DeclarationId.ownerName(right, usize.ZERO))
}
fn delayedOriginalCallback(value: &Type, owner: &DeclarationId, captured: bool) -> bool {
  if let Type.CallableValue {application, contract, captures, fieldInputs, ..} = &value.* {
    let authentic = Shared.with<SpecializationApplication, bool>(&application, fn(selected: &SpecializationApplication) -> bool {
      let original = SpecializationApplication.bodyDeclaration(selected)
      let steps = DeclarationId.ownerCount(original)
      let parent = DeclarationId.ownerCount(owner)
      return DeclarationId.kind(original) == OwnerKind.EffectBlock && parent != usize.ZERO && steps == parent + usize.ONE
        && DeclarationId.ownerOccurrence(original, steps - usize.ONE) == usize.ZERO
        && ModuleId.equals(DeclarationId.moduleId(original), DeclarationId.moduleId(owner))
        && DeclarationId.ownerKind(original, usize.ZERO) == DeclarationId.ownerKind(owner, usize.ZERO)
        && DeclarationId.ownerOccurrence(original, usize.ZERO) == DeclarationId.ownerOccurrence(owner, usize.ZERO)
        && delayedOwnerName(original, owner)
    })
    if !authentic || Vector.length<CallableFieldInput>(&fieldInputs) != usize.ZERO { return false }
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    if captured {
      if fields.length != 2 || !Shared.with<Type, bool>(&fields[usize.ZERO], fn(field: &Type) -> bool {
        return delayedReference(field, owner, usize.ZERO, false, Access.Shared)
      }) || !Shared.with<Type, bool>(&fields[usize.ONE], fn(field: &Type) -> bool {
        return delayedReference(field, owner, usize.ONE, false, Access.Shared)
      }) { return false }
    } else if fields.length != usize.ZERO { return false }
    return Shared.with<Type, bool>(&contract, fn(promised: &Type) -> bool {
      return delayedCallbackContract(promised, owner, captured)
    })
  }
  return false
}
fn delayedCallbackContract(value: &Type, owner: &DeclarationId, captured: bool) -> bool {
  if let Type.Callable {isUnsafe, environment, invocationBinders, parameters, result, ..} = &value.* {
    let inputs = Vector.asSlice<Shared<Type>>(&parameters)
    return !isUnsafe && invocationBinders == usize.ONE && inputs.length == usize.ONE
      && delayedEnvironmentShared(&environment, owner, false, captured, captured, false)
      && Shared.with<Type, bool>(&inputs[usize.ZERO], fn(input: &Type) -> bool {
        return delayedReference(input, owner, usize.ZERO, true, Access.Mutable)
      }) && Shared.with<Type, bool>(&result, fn(output: &Type) -> bool {
        return delayedEffect(output, owner, CallableMode.Mutable, true, captured, captured, false)
      })
  }
  return false
}
effect fn delayedCallbackBody(answer: &Shared<Result<Answer, NoRejection>>, id: &ModuleId,
  caller: &[u8], consumer: &[u8], text: string, captured: bool) -> bool ! OutOfMemoryError ? &mut Allocator {
  let body = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody) {
    Option<Shared<TypedBody>>.Some {value} => move value _ => { return false }
  }
  let evidence = match move Shared.with<TypedBody, Option<DelayedCallbackEvidence>>(&body, fn(value: &TypedBody) -> Option<DelayedCallbackEvidence> {
    return delayedCallbackEvidence(value, id, caller, consumer, text, captured)
  }) { Option<DelayedCallbackEvidence>.Some {value} => move value _ => { return false } }
  if !run Type.equalsShared(&evidence.representation, &evidence.operand) { return false }
  return Shared.with<TypedBody, bool>(&body, fn(value: &TypedBody) -> bool {
    return delayedBodyRepresentation(value, &evidence.representation, captured)
  })
}
fn delayedBodyRepresentation(body: &TypedBody, representation: &Shared<Type>, captured: bool) -> bool {
  return Shared.with<Type, bool>(representation, fn(value: &Type) -> bool {
    return delayedOriginalCallback(value, TypedBody.declarationId(body), captured)
  })
}

fn delayedOwnedParameter(value: &Type, owner: &DeclarationId, ordinal: usize) -> bool {
  if let Type.Parameter {declaration, ordinal: position} = &value.* {
    return position == ordinal && DeclarationId.equals(&declaration, owner)
  }
  return false
}
fn delayedStagePromise(value: &Type, owner: &DeclarationId) -> bool {
  if let Type.Callable {mode, isUnsafe, environment, invocationBinders, invocationBounds, parameters, result, ..} = &value.* {
    let inputs = Vector.asSlice<Shared<Type>>(&parameters)
    return mode == CallableMode.Shared && !isUnsafe && invocationBinders == usize.ZERO
      && Vector.length<Outlives>(&invocationBounds) == usize.ZERO && inputs.length == 2
      && delayedEnvironmentShared(&environment, owner, false, false, false, false)
      && Shared.with<Type, bool>(&inputs[usize.ZERO], delayedI32)
      && Shared.with<Type, bool>(&inputs[usize.ONE], fn(input: &Type) -> bool {
        return delayedEffect(input, owner, CallableMode.Once, false, true, true, false)
      }) && Shared.with<Type, bool>(&result, delayedI32)
  }
  return false
}
fn delayedStageBounds(signature: &Signature, owner: &DeclarationId) -> bool {
  if Vector.length<Shared<Lifetime>>(&signature.lifetimeParameters) != 2
    || signature.callableParameterStart != 3 { return false }
  let function = delayedParameterContract(signature, usize.ZERO)
  let pending = delayedParameterContract(signature, usize.ONE)
  if let Option<Shared<Type>>.Some {value: callable} = move function {
    if !Shared.with<Type, bool>(&callable, fn(value: &Type) -> bool { return delayedStagePromise(value, owner) }) { return false }
  } else { return false }
  if let Option<Shared<Type>>.Some {value: pendingEffect} = move pending {
    if !Shared.with<Type, bool>(&pendingEffect, fn(value: &Type) -> bool {
      return delayedEffect(value, owner, CallableMode.Mutable, false, true, false, false)
    }) { return false }
  } else { return false }
  let constraints = Vector.asSlice<Constraint>(&signature.constraints)
  let mut outlives = usize.ZERO
  let mut at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Outlives {longer, shorter} = &constraints[at] {
      let correct = Shared.with<Lifetime, bool>(&longer, fn(region: &Lifetime) -> bool {
        return delayedParameterRegion(region, owner, usize.ZERO)
      }) && Shared.with<Lifetime, bool>(&shorter, fn(region: &Lifetime) -> bool {
        return delayedParameterRegion(region, owner, usize.ONE)
      })
      if !correct { return false }
      outlives = outlives + usize.ONE
    }
    at = at + usize.ONE
  }
  return outlives == usize.ONE
}
fn delayedParameterRegion(value: &Lifetime, owner: &DeclarationId, ordinal: usize) -> bool {
  if let Lifetime.Parameter {declaration, ordinal: position} = &value.* {
    return position == ordinal && DeclarationId.equals(&declaration, owner)
  }
  return false
}
fn delayedStageResult(value: &Type, owner: &DeclarationId) -> bool {
  if let Type.CallableStage {base, contract, captures, remaining, suffixMode} = &value.* {
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    return remaining == usize.ONE && suffixMode == CallableMode.Once && fields.length == usize.ONE
      && Shared.with<Type, bool>(&base, fn(parameter: &Type) -> bool { return delayedOwnedParameter(parameter, owner, 2) })
      && Shared.with<Type, bool>(&fields[usize.ZERO], fn(parameter: &Type) -> bool { return delayedOwnedParameter(parameter, owner, 3) })
      && Shared.with<Type, bool>(&contract, fn(promised: &Type) -> bool { return delayedStageRemainder(promised, owner) })
  }
  return false
}
fn delayedStageRemainder(value: &Type, owner: &DeclarationId) -> bool {
  if let Type.Callable {mode, isUnsafe, environment, invocationBinders, invocationBounds, parameters, result, ..} = &value.* {
    let inputs = Vector.asSlice<Shared<Type>>(&parameters)
    return mode == CallableMode.Once && !isUnsafe && invocationBinders == usize.ZERO
      && Vector.length<Outlives>(&invocationBounds) == usize.ZERO && inputs.length == usize.ONE
      && delayedEnvironmentShared(&environment, owner, false, true, false, false)
      && Shared.with<Type, bool>(&inputs[usize.ZERO], delayedI32) && Shared.with<Type, bool>(&result, delayedI32)
  }
  return false
}
fn delayedStageBody(body: &TypedBody, id: &ModuleId) -> bool {
  let owner = TypedBody.declarationId(body)
  if !ModuleId.equals(DeclarationId.moduleId(owner), id) || !DeclarationId.named(owner, b"stageEffect")
    || DeclarationId.kind(owner) != OwnerKind.Function || DeclarationId.ownerCount(owner) != usize.ONE
    || DeclarationId.ownerOccurrence(owner, usize.ZERO) != usize.ZERO { return false }
  let nodes = TypedBody.nodeSlice(body)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.StagedCallable {arguments, ..}} = &nodes[at].kind {
      if Vector.length<BodyNodeId>(&arguments) != usize.ONE
        || !Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool { return delayedStageResult(value, owner) }) { return false }
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count == usize.ONE
}
fn delayedStageSignature(answer: &Result<Answer, NoRejection>, owner: &DeclarationId) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome { return delayedStageBounds(&signature, owner) }
  }
  return false
}
fn delayedStageBaseSchema(value: &Type, id: &ModuleId) -> bool {
  if let Type.CallableSchema {schema, captures, fieldInputs, ..} = &value.* {
    if Vector.length<Shared<Type>>(&captures) != usize.ZERO || Vector.length<CallableFieldInput>(&fieldInputs) != usize.ZERO { return false }
    return Shared.with<SectionSchema, bool>(&schema, fn(recipe: &SectionSchema) -> bool { return delayedStageSchema(recipe, id) })
  }
  return false
}
fn delayedStageApplication(application: &SpecializationApplication, caller: &DeclarationId, id: &ModuleId) -> bool {
  let target = SpecializationApplication.bodyDeclaration(application)
  if !ModuleId.equals(DeclarationId.moduleId(target), id) || !DeclarationId.named(target, b"stageEffect")
    || DeclarationId.kind(target) != OwnerKind.Function || DeclarationId.ownerCount(target) != usize.ONE
    || DeclarationId.ownerOccurrence(target, usize.ZERO) != usize.ZERO { return false }
  let arguments = Vector.asSlice<Argument>(&application.arguments)
  let ordinals = Vector.asSlice<usize>(&application.argumentOrdinals)
  if arguments.length != 4 || ordinals.length != 4 || Vector.length<ScopeBinding>(&application.scopes) != usize.ZERO { return false }
  let mut at = usize.ZERO
  while at < ordinals.length { if ordinals[at] != at { return false } at = at + usize.ONE }
  at = usize.ZERO
  while at < 2 {
    if let Argument.Lifetime {value} = &arguments[at] {
      if !Shared.with<Lifetime, bool>(&value, fn(region: &Lifetime) -> bool { return delayedParameterRegion(region, caller, usize.ZERO) }) { return false }
    } else { return false }
    at = at + usize.ONE
  }
  if let Argument.Type {value} = &arguments[2] {
    if !Shared.with<Type, bool>(&value, fn(representation: &Type) -> bool { return delayedStageBaseSchema(representation, id) }) { return false }
  } else { return false }
  if let Argument.Type {value} = &arguments[3] {
    return Shared.with<Type, bool>(&value, fn(parameter: &Type) -> bool { return delayedOwnedParameter(parameter, caller, usize.ONE) })
  }
  return false
}
fn delayedStageEntry(body: &TypedBody, id: &ModuleId) -> bool {
  let caller = TypedBody.declarationId(body)
  if !ModuleId.equals(DeclarationId.moduleId(caller), id) || !DeclarationId.named(caller, b"stagedEffectEntry")
    || DeclarationId.kind(caller) != OwnerKind.Function || DeclarationId.ownerCount(caller) != usize.ONE
    || DeclarationId.ownerOccurrence(caller, usize.ZERO) != usize.ZERO { return false }
  let nodes = TypedBody.nodeSlice(body)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration, application, ..}, ..} = &nodes[at].kind {
      if DeclarationId.named(&declaration, b"stageEffect") {
        if !Shared.with<SpecializationApplication, bool>(&application, fn(selected: &SpecializationApplication) -> bool {
          return delayedStageApplication(selected, caller, id)
        }) { return false }
        count = count + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return count == usize.ONE
}

fn delayedStageSchema(recipe: &SectionSchema, id: &ModuleId) -> bool {
  let target = Shared.with<DeclarationId, bool>(&recipe.target, fn(owner: &DeclarationId) -> bool {
    return ModuleId.equals(DeclarationId.moduleId(owner), id) && DeclarationId.named(owner, b"keepEffect")
      && DeclarationId.kind(owner) == OwnerKind.Function && DeclarationId.ownerCount(owner) == usize.ONE
      && DeclarationId.ownerOccurrence(owner, usize.ZERO) == usize.ZERO
  })
  let deferred = Vector.asSlice<usize>(&recipe.deferred)
  return target && Vector.length<Binding>(&recipe.selected) == usize.ZERO && deferred.length == 3
    && deferred[usize.ZERO] == usize.ZERO && deferred[usize.ONE] == usize.ONE && deferred[2] == 2
}

fn delayedStageHeaderForBody(body: &TypedBody, header: &Shared<Result<Answer, NoRejection>>) -> bool {
  return Shared.with<Result<Answer, NoRejection>, bool>(header, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return delayedStageSignature(answer, TypedBody.declarationId(body))
  })
}

test effect fn anonymousCallableParametersPreserveLifetimeAdmission() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run anonymousParameterLifetimeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn anonymousParameterLifetimeClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("anonymous-parameter-lifetimes.silk")
  let text = """
fn through<'env>(callback: fn<'env>(i32) -> i32) -> i32 {
  let apply = fn(selected: fn(i32) -> i32, value: i32) -> i32 { return selected(value) }
  return apply(callback, 40)
}
fn invalid<'env>(rejected: fn<'env>(i32) -> i32) -> i32 {
  let apply = fn(selected: fn<'static>(i32) -> i32, value: i32) -> i32 { return selected(value) }
  return apply(rejected, 40)
}
fn shorter<'env>(use: for<'call> once fn<'env>(&'call mut i32) -> once Effect<'call & 'env; i32>) -> () { drop use }
fn resultStatic<'env>(use: for<'call> once fn<'env>(&'call mut i32) -> once Effect<'static; i32>) -> () { drop use }
fn narrowed<'env>(marker: &'env i32) -> () {
  let use = effect fn(resource: &mut i32) -> i32 { return resource.* }
  shorter<'env>(move use)
}
fn invalidResult<'env>(marker: &'env i32) -> () {
  let use = effect fn(resource: &mut i32) -> i32 { return resource.* }
  resultStatic<'env>(move use)
}
fn retained<'env, 'outer>(marker: &'outer i32, use: for<'call> once fn<'outer>(&'call mut i32) -> once Effect<'call & 'env; i32>) -> () { drop use }
fn captured<'left: 'env, 'right: 'env, 'env>(left: &'left i32, right: &'right i32) -> () {
  let marker = 0
  let use = effect fn(resource: &mut i32) -> i32 { return resource.* + left.* + right.* }
  retained<'env>(&marker, move use)
}
fn missing<'left: 'env, 'right, 'env>(left: &'left i32, right: &'right i32) -> () {
  let marker = 0
  let use = effect fn(resource: &mut i32) -> i32 { return resource.* + left.* + right.* }
  retained<'env>(&marker, move use)
}
fn reversed<'left: 'env, 'right, 'env: 'right>(left: &'left i32, right: &'right i32) -> () {
  let marker = 0
  let use = effect fn(resource: &mut i32) -> i32 { return resource.* + left.* + right.* }
  retained<'env>(&marker, move use)
}
fn environmentMetadata<'left, 'right, 'env>(source: mut Effect<'left & 'right; i32>, target: once Effect<'env; i32>) -> () { drop source drop target }
fn keepEffect<'a, 'b>(number: i32, pending: once Effect<'a & 'b; i32>) -> i32 { drop pending return number }
fn stageEffect<'a: 'b, 'b, F: fn<'static>(i32, once Effect<'a & 'b; i32>) -> i32>(f: F, pending: mut Effect<'a; i32>) -> some<G: once fn<'a>(i32) -> i32> G { return f(move pending) }
fn stagedEffectEntry<'a>(pending: mut Effect<'a; i32>) -> i32 {
  let saved = stageEffect<'a, 'a>(keepEffect, move pending)
  return saved(42)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let valid = run Semantic.demandBody(&mut store, &mut request, &id, b"through")
  let invalid = run Semantic.demandBody(&mut store, &mut request, &id, b"invalid")
  run Testing.expect(succeeded(&valid), "elided invocation lifetimes admit the caller's abstract evidence")
  run Testing.expect(rejectsSpan(&invalid, RejectionCode.UnsatisfiedLifetimeBound, text, "rejected", usize.ONE),
    "a fixed Static callback contract rejects unsuitable caller evidence at the operand")
  let narrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"narrowed")
  let captured = run Semantic.demandBody(&mut store, &mut request, &id, b"captured")
  let narrowedEvidence = run delayedCallbackBody(&narrowed, &id, b"narrowed", b"shorter", text, false)
  let capturedEvidence = run delayedCallbackBody(&captured, &id, b"captured", b"retained", text, true)
  run Testing.expect(narrowedEvidence && capturedEvidence,
    "real anonymous callbacks retain Invocation0 and both caller-owned captures through delayed Mutable-to-Once narrowing")
  let resultStatic = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidResult")
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missing")
  let reversed = run Semantic.demandBody(&mut store, &mut request, &id, b"reversed")
  run Testing.expect(rejectsSpan(&resultStatic, RejectionCode.IncompatibleCallableSignature, text, "move use", usize.ONE)
    && rejectsSpan(&missing, RejectionCode.IncompatibleCallableSignature, text, "move use", 3)
    && rejectsSpan(&reversed, RejectionCode.IncompatibleCallableSignature, text, "move use", 4),
    "delayed environments retain the invocation loan and independently require both directed capture bounds")
  let metadata = run Semantic.demandSignature(&mut store, &mut request, &id, b"environmentMetadata")
  let metadataBody = run Semantic.demandBody(&mut store, &mut request, &id, b"environmentMetadata")
  let pair = match move Shared.with<Result<Answer, NoRejection>, Option<DelayedContractPair>>(&metadata, delayedMetadataContracts) {
    Option<DelayedContractPair>.Some {value} => move value _ => {
      run Testing.expect(false, "metadata retains actual Effect representation bounds") return ()
    }
  }
  let comparison = run CallableContract.compareValue(&pair.source, &pair.target)
  let mut exactRelation = false
  let checkedMetadataBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&metadataBody, checkedBody)
  if let Result<CallableContract.ValueRelation, CallableContract.Failure>.Success {value: relation} = move comparison {
    if let Option<Shared<TypedBody>>.Some {value: relationBody} = move checkedMetadataBody {
      exactRelation = Shared.with<TypedBody, bool>(&relationBody, fn(value: &TypedBody) -> bool {
        return delayedMetadataRelation(value, &id, &pair, &relation)
      })
    }
  }
  run Testing.expect(exactRelation,
    "compareValue preserves both real declared source members, the distinct target member and their full owner/ordinal direction")
  let staged = run Semantic.demandBody(&mut store, &mut request, &id, b"stageEffect")
  let stagedHeader = run Semantic.demandSignature(&mut store, &mut request, &id, b"stageEffect")
  let stagedEntry = run Semantic.demandBody(&mut store, &mut request, &id, b"stagedEffectEntry")
  let mut stageSource = false
  let checkedStagedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&staged, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: stagedBody} = move checkedStagedBody {
    stageSource = Shared.with<TypedBody, bool>(&stagedBody, fn(value: &TypedBody) -> bool {
      return delayedStageBody(value, &id) && delayedStageHeaderForBody(value, &stagedHeader)
    })
  }
  let mut stageSelection = false
  let checkedStagedEntry = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&stagedEntry, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: stagedEntryBody} = move checkedStagedEntry {
    stageSelection = Shared.with<TypedBody, bool>(&stagedEntryBody, fn(value: &TypedBody) -> bool { return delayedStageEntry(value, &id) })
  }
  run Testing.expect(stageSource && stageSelection,
    "abstract-F staging preserves its declared Effect bound, original schema and source-owned application coordinates")
}

test effect fn anonymousCallableParametersRejectUnknownOwnedReturns() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run anonymousParameterReturnClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn anonymousParameterReturnClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("anonymous-parameter-owned-returns.silk")
  let text = """
fn rawOnce() -> () {
  let operation = fn(onceInput: once fn<'static>() -> i32) -> once fn<'static>() -> i32 { return move onceInput }
}
fn rawMutable() -> () {
  let operation = fn(mut mutableInput: mut fn<'static>() -> i32) -> mut fn<'static>() -> i32 { return move mutableInput }
}
fn authored<F: once fn<'static>() -> i32>() -> () {
  let operation = fn(value: F) -> once fn<'static>() -> i32 { return move value }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let onceAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"rawOnce")
  let mutableAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"rawMutable")
  let authored = run Semantic.demandBody(&mut store, &mut request, &id, b"authored")
  run Testing.expect(rejectsSpan(&onceAnswer, RejectionCode.UnknownOwnedCallableReturn, text, "move onceInput", usize.ZERO)
    && rejectsSpan(&mutableAnswer, RejectionCode.UnknownOwnedCallableReturn, text, "move mutableInput", usize.ZERO) && succeeded(&authored),
    "raw Once and Mutable representations reject SEM0081 at the move; an outer authored F keeps its role")
}

