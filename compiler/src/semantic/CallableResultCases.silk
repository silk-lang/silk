effect fn interfaceCallableReturnClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("interface-callable-returns.silk")
  let text = """
interface Factory { fn make(value: &Self) -> fn<'static>(i32) -> i32 }
struct Marker {}
fn add(value: i32) -> i32 { return value + 2 }
impl Factory for Marker { fn make(value: &Self) -> fn<'static>(i32) -> i32 { return add } }
fn choose<T: Factory>(provider: &T, flag: bool) -> fn<'static>(i32) -> i32 {
  if flag { return Factory.make(provider) }
  return Factory.make(provider)
}
fn main() -> i32 { let marker = Marker {} return choose(&marker, true)(40) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry) && originalCallableInvocationCount(&store, &entry, b"add", usize.ONE) == usize.ONE,
    "unused fresh transport regions cannot split two equivalent descriptor-produced return origins")
}

