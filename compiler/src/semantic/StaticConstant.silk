//! Primitive constant admission and canonical fixed-array extents.
//!
//! # When to use
//! After a static initializer has completed, use [`matches`] against its declared type before
//! publishing it. Use [`extent`] only for a complete nonnegative integer selected as an array
//! length. The same canonical decimal bytes identify equal extents across expression spellings.

import semantic.StaticValue
import semantic.StaticValue {FloatType, IntegerType, Sign, Value}
import semantic.Type {Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.shared {Shared}
import silk.u64
import silk.usize
import silk.vector {Vector}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

/// The primitive spelling of a static integer type.
pub fn integerName(ty: IntegerType) -> &'static [u8] {
  return match ty {
    IntegerType.U8 => b"u8"
    IntegerType.U16 => b"u16"
    IntegerType.U32 => b"u32"
    IntegerType.U64 => b"u64"
    IntegerType.Usize => b"usize"
    IntegerType.I8 => b"i8"
    IntegerType.I16 => b"i16"
    IntegerType.I32 => b"i32"
    IntegerType.I64 => b"i64"
    IntegerType.Isize => b"isize"
  }
}

fn primitiveAllowed(name: &[u8]) -> bool {
  return same(name, b"bool") || same(name, b"char") || same(name, b"u8") ||
    same(name, b"u16") || same(name, b"u32") || same(name, b"u64") ||
    same(name, b"usize") || same(name, b"i8") || same(name, b"i16") ||
    same(name, b"i32") || same(name, b"i64") || same(name, b"isize") ||
    same(name, b"f32") || same(name, b"f64")
}

/// Constants contain only one supported primitive or static string, never an aggregate.
pub fn typeAllowed(ty: &Type) -> bool {
  return match & ty.* {
    Type.Primitive {name} => primitiveAllowed(Bytes.asSlice(&name))
    Type.String {..} => true
    _ => false
  }
}

fn primitiveMatches(written: &[u8], value: &Value) -> bool {
  return match & value.* {
    Value.Boolean {..} => same(written, b"bool")
    Value.Character {..} => same(written, b"char")
    Value.Integer {ty: integer, ..} => same(written, integerName(integer))
    Value.Float {ty: floatType, ..} => {
      if floatType == FloatType.F32 { return same(written, b"f32") }
      return same(written, b"f64")
    }
    _ => false
  }
}

/// Checks the complete static result against its explicit primitive constant type.
pub fn matches(ty: &Type, value: &Value) -> bool {
  return match & ty.* {
    Type.String {..} => match & value.* {
      Value.Text {..} => true
      _ => false
    }
    Type.Primitive {name} => primitiveMatches(Bytes.asSlice(&name), value)
    _ => false
  }
}

fn matchesValue(ty: &Type, value: &Shared<Value>) -> bool {
  return Shared.with<Value, bool>(value, fn(data: &Value) -> bool {
    return matches(ty, data)
  })
}

/// Checks the complete shared result without copying aggregate storage.
pub fn matchesShared(ty: &Shared<Type>, value: &Shared<Value>) -> bool {
  return Shared.with<Type, bool>(ty, fn(resolved: &Type) -> bool {
    return matchesValue(resolved, value)
  })
}

/// Encodes one selected nonnegative integer extent in canonical decimal form. Invalid kinds and
/// negative or target-unrepresentable values yield `None`; the caller attaches the authored span.
fn extentMagnitude(value: &Value) -> Option<u64> {
  if let Value.Integer {sign, magnitude, ..} = &value.* {
    if sign != Sign.Negative { return Option.some<u64>(magnitude) }
  }
  return Option.none<u64>()
}

pub effect fn extent(value: &Shared<Value>, pointerBits: u32) -> Option<Bytes>
! OutOfMemoryError
? &mut Allocator {
  let selected = Shared.with<Value, Option<u64>>(value, extentMagnitude)
  let magnitude = match move selected {
    Option<u64>.Some {value: number} => number
    Option<u64>.None => { return Option.none<Bytes>() }
  }
  let maximum = match move StaticValue.integerLimit(IntegerType.Usize, Sign.Positive, pointerBits) {
    Option<u64>.Some {value: limit} => limit
    Option<u64>.None => { return Option.none<Bytes>() }
  }
  if magnitude > maximum { return Option.none<Bytes>() }
  let mut reversed = Vector.make<u8>()
  let mut remaining = magnitude
  if remaining == 0 {
    run Vector.append<u8>(&mut reversed, 48)
  }
  while remaining > 0 {
    run Vector.append<u8>(&mut reversed, u64.toU8(48 + u64.remainder(remaining, 10)))
    remaining = u64.divide(remaining, 10)
  }
  let count = Vector.length<u8>(&reversed)
  let mut result = run Bytes.zeroed(count)
  let mut output = Bytes.asMutSlice(&mut result)
  let mut at = usize.ZERO
  while at < count {
    output[at] = Vector.get<u8>(&reversed, count - at - usize.ONE)
    at = at + usize.ONE
  }
  return Option.some<Bytes>(move result)
}
