//! Constant type admission and canonical fixed-array extents.
//!
//! # When to use
//! After a static initializer has completed, use [`admits`] against its declared type before
//! publishing it. Use [`extent`] only for a complete nonnegative integer selected as an array
//! length. The same canonical decimal bytes identify equal extents across expression spellings.

import semantic.StaticValue
import semantic.StaticValue {IntegerType, Sign, Value}
import semantic.Type {Type}
import semantic.Types {Types}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.mem.shared {Shared}
import silk.num.u64
import silk.num.usize
import silk.collections.list {List}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

/// The primitive spelling of a static integer type.
pub fn integerName(ty: IntegerType) -> &'static [u8] {
  return match ty {
    IntegerType.U8 => b"u8"
    IntegerType.U16 => b"u16"
    IntegerType.U32 => b"u32"
    IntegerType.U64 => b"u64"
    IntegerType.Usize => b"usize"
    IntegerType.I8 => b"i8"
    IntegerType.I16 => b"i16"
    IntegerType.I32 => b"i32"
    IntegerType.I64 => b"i64"
    IntegerType.Isize => b"isize"
  }
}

fn primitiveAllowed(name: &[u8]) -> bool {
  return same(name, b"bool") || same(name, b"char") || same(name, b"u8") ||
    same(name, b"u16") || same(name, b"u32") || same(name, b"u64") ||
    same(name, b"usize") || same(name, b"i8") || same(name, b"i16") ||
    same(name, b"i32") || same(name, b"i64") || same(name, b"isize") ||
    same(name, b"f32") || same(name, b"f64")
}

/// Whether a declared type can hold a constant: a supported primitive, `string`, a fixed array
/// of such types, or a nominal type. A nominal's fields and cleanup are not decided here: the
/// initializer's value must still pass [`admits`], which only static evaluation's cleanup-free
/// structs and scalar enums do.
pub fn typeAllowed(ty: &Type) -> bool {
  return match & ty.* {
    Type.Primitive {name} => primitiveAllowed(Bytes.asSlice(&name))
    Type.String {..} => true
    Type.Array {element, ..} => Shared<Type>.with<bool>(&element, typeAllowed)
    Type.Nominal {..} => true
    _ => false
  }
}

/// Checks the complete static result against the constant's declared type: a pure value of
/// exactly that type, the same admission static evaluation uses for any value it publishes.
pub effect fn admits(ty: &Shared<Type>, value: &Shared<Value>) -> bool
! OutOfMemoryError
? &mut Allocator | &mut Types {
  return run StaticValue.matchesType(value, ty)
}

/// Encodes one selected nonnegative integer extent in canonical decimal form. Invalid kinds and
/// negative or target-unrepresentable values yield `None`; the caller attaches the authored span.
fn extentMagnitude(value: &Value) -> Option<u64> {
  if let Value.Integer {sign, magnitude, ..} = &value.* {
    if sign != Sign.Negative { return Option<u64>.some(magnitude) }
  }
  return Option<u64>.none()
}

/// Whether a selected nonnegative integer extent exceeds the largest fixed-array length, the i32
/// maximum on every target.
pub fn arrayLengthExceeds(value: &Shared<Value>) -> bool {
  let selected = Shared<Value>.with<Option<u64>>(value, extentMagnitude)
  return match move selected {
    Option<u64>.Some {value: magnitude} => magnitude > 2147483647
    Option<u64>.None => false
  }
}

pub effect fn extent(value: &Shared<Value>, pointerBits: u32) -> Option<Bytes>
! OutOfMemoryError
? &mut Allocator {
  let selected = Shared<Value>.with<Option<u64>>(value, extentMagnitude)
  let magnitude = match move selected {
    Option<u64>.Some {value: number} => number
    Option<u64>.None => { return Option<Bytes>.none() }
  }
  let maximum = match move StaticValue.integerLimit(IntegerType.Usize, Sign.Positive, pointerBits) {
    Option<u64>.Some {value: limit} => limit
    Option<u64>.None => { return Option<Bytes>.none() }
  }
  if magnitude > maximum { return Option<Bytes>.none() }
  let mut reversed = List<u8>.make()
  let mut remaining = magnitude
  if remaining == 0 {
    run List<u8>.append(&mut reversed, 48)
  }
  while remaining > 0 {
    run List<u8>.append(&mut reversed, u64.toU8(48 + u64.remainder(remaining, 10)))
    remaining = u64.divide(remaining, 10)
  }
  let count = List<u8>.length(&reversed)
  let mut result = run Bytes.zeroed(count)
  let mut output = Bytes.asMutSlice(&mut result)
  let mut at = usize.ZERO
  while at < count {
    output[at] = List<u8>.get(&reversed, count - at - usize.ONE)
    at = at + usize.ONE
  }
  return Option<Bytes>.some(move result)
}
