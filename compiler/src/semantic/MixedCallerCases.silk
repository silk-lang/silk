import semantic.ModuleId {InvalidModulePath}
import semantic.Query {Cycle}
import semantic.Semantic {Semantic, Request}
import semantic.SemanticCaseSupport {module, staticSemantic, hasBorrowStatus, rejectsSpan}
import semantic.Rejection {RejectionCode}
import semantic.SourceIndex {RevisionMismatch}
import semantic.Target {Target, Id as TargetId}
import semantic.TypedBody {BorrowStatus}
import semantic.Types {TypeTable, Types}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.effect {Effect}
import silk.testing.testing {Testing, AssertionError}

// The first operand supplies a caller lifetime; the next supplies a local loan while
// the outgoing result-only child is still unbound. Typed lets and a later caller operand
// exercise distinct uses of the final bindings, through direct and interface calls.
test effect fn mixedCallerResultBinders() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run mixedCallerClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn mixedCallerClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("mixed-calls.silk")
  let text = """
import silk.core.effect {Effect}
struct Token { value: i32 }
struct Slot<'s> { r: &'s i32 }
interface Make { fn make<'w, 'v: 'w>(self: &Self, head: &'v i32) -> &'w i32 }
impl Make for Token { fn make<'w, 'v: 'w>(self: &Self, head: &'v i32) -> &'w i32 { return head } }
interface Both { fn both<'w, 'v: 'w>(self: &Self, a: &'v i32, b: &'v i32) -> &'w i32 }
impl Both for Token { fn both<'w, 'v: 'w>(self: &Self, a: &'v i32, b: &'v i32) -> &'w i32 { return b } }
interface Three { fn three<'w, 'v: 'w>(self: &Self, a: &'v i32, b: &'v i32, c: &'v i32) -> &'w i32 }
impl Three for Token { fn three<'w, 'v: 'w>(self: &Self, a: &'v i32, b: &'v i32, c: &'v i32) -> &'w i32 { return c } }
fn makeDirect<'w, 'v: 'w>(self: &Token, head: &'v i32) -> &'w i32 { return head }
fn bothDirect<'w, 'v: 'w>(self: &Token, a: &'v i32, b: &'v i32) -> &'w i32 { return b }
fn threeDirect<'w, 'v: 'w>(self: &Token, a: &'v i32, b: &'v i32, c: &'v i32) -> &'w i32 { return c }
fn yv8Direct<'p>(t: &Token, h: &'p i32) -> i32 { let l = 5 let r = bothDirect(t, h, &l) return r.* }
fn yv8tDirect<'p>(t: &Token, h: &'p i32) -> i32 { let l = 5 let r: &i32 = bothDirect(t, h, &l) return r.* }
fn wp4vDirect<'p>(t: &Token, h: &'p i32) -> i32 { let l = 5 let r = threeDirect(t, h, &l, h) return r.* }
fn yv8Interface<'p>(t: &Token, h: &'p i32) -> i32 { let l = 5 let r = Both.both(t, h, &l) return r.* }
fn yv8tInterface<'p>(t: &Token, h: &'p i32) -> i32 { let l = 5 let r: &i32 = Both.both(t, h, &l) return r.* }
fn wp4vInterface<'p>(t: &Token, h: &'p i32) -> i32 { let l = 5 let r = Three.three(t, h, &l, h) return r.* }
fn callerEscapeDirect<'p>(t: &Token, h: &'p i32) -> &'p i32 { let l = 5 return bothDirect(t, h, &l) }
fn staticEscapeDirect(t: &Token) -> &'static i32 { let l = 5 return makeDirect(t, &l) }
fn callerEscapeInterface<'p>(t: &Token, h: &'p i32) -> &'p i32 { let l = 5 return Both.both(t, h, &l) }
fn staticEscapeInterface(t: &Token) -> &'static i32 { let l = 5 return Make.make(t, &l) }
fn fixedChild<'p>(t: &Token, h: &'p i32) -> i32 { let l = 5 return bothDirect<'p, 'p>(t, h, &l).* }
fn invariant<'w, 'v: 'w>(slot: &mut Slot<'v>, b: &'v i32) -> &'w i32 { return b }
fn invariantCaller<'p>(slot: &mut Slot<'p>) -> i32 { let l = 5 let r = invariant(&mut slot.*, &l) return r.* }
service Keeper<'k> { effect fn put(v: &'k i32) -> () ? &mut Keeper<'k> }
effect<'w> fn observedRow<'w, 'v: 'w>(a: &'v i32, b: &'v i32) -> i32 ? &mut Keeper<'v> { return a.* + b.* }
fn rowCaller<'p>(h: &'p i32) -> i32 { let l = 5 let e = observedRow(h, &l) drop e return 0 }

"""
  let mut store = run staticSemantic(&id, text, Target.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let yv8Direct = run Semantic.demandBody(&mut store, &mut request, &id, b"yv8Direct")
  let yv8tDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"yv8tDirect")
  let wp4vDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"wp4vDirect")
  let yv8Interface = run Semantic.demandBody(&mut store, &mut request, &id, b"yv8Interface")
  let yv8tInterface = run Semantic.demandBody(&mut store, &mut request, &id, b"yv8tInterface")
  let wp4vInterface = run Semantic.demandBody(&mut store, &mut request, &id, b"wp4vInterface")
  let callerEscapeDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"callerEscapeDirect")
  let staticEscapeDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"staticEscapeDirect")
  let callerEscapeInterface = run Semantic.demandBody(&mut store, &mut request, &id, b"callerEscapeInterface")
  let staticEscapeInterface = run Semantic.demandBody(&mut store, &mut request, &id, b"staticEscapeInterface")
  let fixedChild = run Semantic.demandBody(&mut store, &mut request, &id, b"fixedChild")
  let invariantCaller = run Semantic.demandBody(&mut store, &mut request, &id, b"invariantCaller")
  let rowCaller = run Semantic.demandBody(&mut store, &mut request, &id, b"rowCaller")
  run Testing.expect(hasBorrowStatus(&yv8Direct, BorrowStatus.Checked), "yv8Direct must be fully Checked")
  run Testing.expect(hasBorrowStatus(&yv8tDirect, BorrowStatus.Checked), "yv8tDirect must be fully Checked")
  run Testing.expect(hasBorrowStatus(&wp4vDirect, BorrowStatus.Checked), "wp4vDirect must be fully Checked")
  run Testing.expect(hasBorrowStatus(&yv8Interface, BorrowStatus.Checked), "yv8Interface must be fully Checked")
  run Testing.expect(hasBorrowStatus(&yv8tInterface, BorrowStatus.Checked), "yv8tInterface must be fully Checked")
  run Testing.expect(hasBorrowStatus(&wp4vInterface, BorrowStatus.Checked), "wp4vInterface must be fully Checked")
  run Testing.expect(rejectsSpan(&callerEscapeDirect, RejectionCode.UnsatisfiedLifetimeBound, text, "&l", 6), "callerEscapeDirect must keep its exact source refusal")
  run Testing.expect(rejectsSpan(&staticEscapeDirect, RejectionCode.UnsatisfiedLifetimeBound, text, "&l", 7), "staticEscapeDirect must keep its exact source refusal")
  run Testing.expect(rejectsSpan(&callerEscapeInterface, RejectionCode.UnsatisfiedLifetimeBound, text, "&l", 8), "callerEscapeInterface must keep its exact source refusal")
  run Testing.expect(rejectsSpan(&staticEscapeInterface, RejectionCode.UnsatisfiedLifetimeBound, text, "&l", 9), "staticEscapeInterface must keep its exact source refusal")
  run Testing.expect(rejectsSpan(&fixedChild, RejectionCode.UnsatisfiedLifetimeBound, text, "&l", 10), "a written outgoing child cannot join the inferred meet")
  run Testing.expect(rejectsSpan(&invariantCaller, RejectionCode.UnsatisfiedLifetimeBound, text, "&l", 11),
    "invariant caller storage cannot admit a local operand: the borrow must outlive the caller's lifetime (SEM0212)")
  run Testing.expect(hasBorrowStatus(&rowCaller, BorrowStatus.Checked),
    "an Effect that is dropped unrun leaves its service requirement's binder free to shorten to the local operand")
  return ()
}

// An unbound child that a later operand names cannot borrow a result-only child's
// inference permission. Preserve the original loud gap/refusals and finite branch use.
test effect fn outgoingBoundChildrenWaitForOperands() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run outgoingChildClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn outgoingChildClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("outgoing-child-operands.silk")
  let text = """fn both<'w,'v:'w>(a:&'v i32,b:&'v i32)->&'w i32{return b}
fn cycle<'w:'v,'v:'w>(a:&'v i32,b:&'v i32)->&'w i32{return b}
fn fork<'w,'z,'v:'w+'z>(a:&'v i32,b:&'v i32,c:&'z i32)->&'w i32{return b}
fn branch<'p>(h:&'p i32,flag:bool)->i32{
 if flag {let l=1 let r=both(h,&l) return r.*}
 return h.*
}
fn branchEscape<'p>(h:&'p i32,flag:bool)->i32{
 let mut r=h
 if flag {let short=1 r=both(h,&short)}
 return r.*
}
fn cycleLocal<'p>(h:&'p i32)->i32{let c=1 let r=cycle(h,&c) return r.*}
fn cycleEscape<'p>(h:&'p i32)->&'p i32{let c=1 return cycle(h,&c)}
fn multi<'p,'q>(h:&'p i32,q:&'q i32)->i32{let c=1 let r=fork(h,&c,q) return r.*}
fn multiEscape<'p,'q>(h:&'p i32,q:&'q i32)->&'p i32{let c=1 return fork(h,&c,q)}
"""
  let mut store = run staticSemantic(&id, text, Target.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let branch = run Semantic.demandBody(&mut store, &mut request, &id, b"branch")
  let branchEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"branchEscape")
  let cycleLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"cycleLocal")
  let cycleEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"cycleEscape")
  let multi = run Semantic.demandBody(&mut store, &mut request, &id, b"multi")
  let multiEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"multiEscape")
  run Testing.expect(hasBorrowStatus(&branch, BorrowStatus.Checked),
    "a result-only child can still shorten for a finite branch-local read")
  run Testing.expect(rejectsSpan(&branchEscape, RejectionCode.ExpiredLifetime, text, "r.*", 1),
    "the finite branch loan cannot outlive its source storage")
  run Testing.expect(hasBorrowStatus(&cycleLocal, BorrowStatus.Checked),
    "cyclic bounds make the call's binders one fresh region, which shortens to a finite local read")
  run Testing.expect(rejectsSpan(&cycleEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 1),
    "a cyclic bound cannot extend a local loan to a caller lifetime")
  run Testing.expect(hasBorrowStatus(&multi, BorrowStatus.Checked),
    "a later child's independent caller lifetime lets the other child shorten to a finite local read")
  run Testing.expect(rejectsSpan(&multiEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 3),
    "multiple outgoing children never let the local escape at a caller lifetime")
}
