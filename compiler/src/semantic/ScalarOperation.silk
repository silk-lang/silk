//! The closed catalog of sealed scalar intrinsics, such as `u32ShiftLeft` or `f64IsNaN`.
//!
//! # Details
//! A scalar intrinsic is spelled as its actor scalar followed by one operation, so the catalog is
//! the product of the scalar list and each category's operation list rather than a member list.
//! The canonical bootstrap scalar catalog is the semantic reference: integer arithmetic traps on
//! overflow, conversions trap outside the destination range, shifts trap unless the count is
//! below the operand width, and rotations reduce the count modulo the width. Only the
//! authenticated sealed namespace consults this catalog.

import hir.Hir {InfixOperator, PrefixOperator}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.usize

/// One compiler-known scalar type.
pub enum Scalar {
  Bool,
  Char,
  U8,
  U16,
  U32,
  U64,
  Usize,
  I8,
  I16,
  I32,
  I64,
  Isize,
  F32,
  F64,
}

/// The operation one scalar intrinsic performs.
pub enum Code {
  Add,
  Subtract,
  Multiply,
  Divide,
  Remainder,
  Negate,
  Equals,
  NotEquals,
  LessThan,
  LessOrEqual,
  GreaterThan,
  GreaterOrEqual,
  BitAnd,
  BitOr,
  BitXor,
  BitNot,
  ShiftLeft,
  ShiftRight,
  RotateLeft,
  RotateRight,
  WrappingAdd,
  WrappingSubtract,
  WrappingMultiply,
  WrappingNegate,
  SaturatingAdd,
  SaturatingSubtract,
  SaturatingMultiply,
  SaturatingNegate,
  CheckedAdd,
  CheckedSubtract,
  CheckedMultiply,
  CheckedDivide,
  CheckedRemainder,
  IsNaN,
  IsInfinite,
  IsFinite,
  IsNormal,
  IsSubnormal,
  IsSignNegative,
  TotalOrder,
  ToBits,
  FromBits,
  Sqrt,
  Sin,
  Cos,
  Not,
  /// `aToB(value)`: the exact value of `actor` as `target`; out-of-range values trap.
  Convert,
  /// `aCheckedToB(value, present, absent)`: the exact value of `actor` as `target`, if representable.
  CheckedConvert,
}

// The category that decides which operations a scalar admits.
enum Category {
  Boolean,
  Character,
  Integer,
  Floating,
}

/// One selected scalar intrinsic. `actor` names the operand; `target` is the conversion
/// destination and equals `actor` for every other operation.
pub struct ScalarOperation {
  pub actor: Scalar
  pub code: Code
  pub target: Scalar
}

impl Copy for ScalarOperation {}

// Every scalar in canonical presentation order.
fn scalars() -> [Scalar; 14] {
  return [
    Scalar.Bool, Scalar.Char, Scalar.U8, Scalar.U16, Scalar.U32, Scalar.U64, Scalar.Usize,
    Scalar.I8, Scalar.I16, Scalar.I32, Scalar.I64, Scalar.Isize, Scalar.F32, Scalar.F64,
  ]
}

// Every operation spelled directly after its actor; conversions are spelled through their target.
fn spelledCodes() -> [Code; 46] {
  return [
    Code.Add, Code.Subtract, Code.Multiply, Code.Divide, Code.Remainder, Code.Negate,
    Code.Equals, Code.NotEquals, Code.LessThan, Code.LessOrEqual, Code.GreaterThan,
    Code.GreaterOrEqual, Code.BitAnd, Code.BitOr, Code.BitXor, Code.BitNot, Code.ShiftLeft,
    Code.ShiftRight, Code.RotateLeft, Code.RotateRight, Code.WrappingAdd, Code.WrappingSubtract,
    Code.WrappingMultiply, Code.WrappingNegate, Code.SaturatingAdd, Code.SaturatingSubtract,
    Code.SaturatingMultiply, Code.SaturatingNegate, Code.CheckedAdd, Code.CheckedSubtract,
    Code.CheckedMultiply, Code.CheckedDivide, Code.CheckedRemainder, Code.IsNaN, Code.IsInfinite,
    Code.IsFinite, Code.IsNormal, Code.IsSubnormal, Code.IsSignNegative, Code.TotalOrder,
    Code.ToBits, Code.FromBits, Code.Sqrt, Code.Sin, Code.Cos, Code.Not,
  ]
}

// The source spelling of a scalar type.
fn spellingOf(scalar: Scalar) -> &'static [u8] {
  return match scalar {
    Scalar.Bool => b"bool"
    Scalar.Char => b"char"
    Scalar.U8 => b"u8"
    Scalar.U16 => b"u16"
    Scalar.U32 => b"u32"
    Scalar.U64 => b"u64"
    Scalar.Usize => b"usize"
    Scalar.I8 => b"i8"
    Scalar.I16 => b"i16"
    Scalar.I32 => b"i32"
    Scalar.I64 => b"i64"
    Scalar.Isize => b"isize"
    Scalar.F32 => b"f32"
    Scalar.F64 => b"f64"
  }
}

// The spelling a conversion uses after `To`, such as `U8` in `u32ToU8`.
fn capitalSpelling(scalar: Scalar) -> &'static [u8] {
  return match scalar {
    Scalar.Bool => b"Bool"
    Scalar.Char => b"Char"
    Scalar.U8 => b"U8"
    Scalar.U16 => b"U16"
    Scalar.U32 => b"U32"
    Scalar.U64 => b"U64"
    Scalar.Usize => b"Usize"
    Scalar.I8 => b"I8"
    Scalar.I16 => b"I16"
    Scalar.I32 => b"I32"
    Scalar.I64 => b"I64"
    Scalar.Isize => b"Isize"
    Scalar.F32 => b"F32"
    Scalar.F64 => b"F64"
  }
}

// The spelling of an operation after its actor. Conversions have none; they spell their target.
fn codeSpelling(code: Code) -> &'static [u8] {
  return match code {
    Code.Add => b"Add"
    Code.Subtract => b"Subtract"
    Code.Multiply => b"Multiply"
    Code.Divide => b"Divide"
    Code.Remainder => b"Remainder"
    Code.Negate => b"Negate"
    Code.Equals => b"Equals"
    Code.NotEquals => b"NotEquals"
    Code.LessThan => b"LessThan"
    Code.LessOrEqual => b"LessOrEqual"
    Code.GreaterThan => b"GreaterThan"
    Code.GreaterOrEqual => b"GreaterOrEqual"
    Code.BitAnd => b"BitAnd"
    Code.BitOr => b"BitOr"
    Code.BitXor => b"BitXor"
    Code.BitNot => b"BitNot"
    Code.ShiftLeft => b"ShiftLeft"
    Code.ShiftRight => b"ShiftRight"
    Code.RotateLeft => b"RotateLeft"
    Code.RotateRight => b"RotateRight"
    Code.WrappingAdd => b"WrappingAdd"
    Code.WrappingSubtract => b"WrappingSubtract"
    Code.WrappingMultiply => b"WrappingMultiply"
    Code.WrappingNegate => b"WrappingNegate"
    Code.SaturatingAdd => b"SaturatingAdd"
    Code.SaturatingSubtract => b"SaturatingSubtract"
    Code.SaturatingMultiply => b"SaturatingMultiply"
    Code.SaturatingNegate => b"SaturatingNegate"
    Code.CheckedAdd => b"CheckedAdd"
    Code.CheckedSubtract => b"CheckedSubtract"
    Code.CheckedMultiply => b"CheckedMultiply"
    Code.CheckedDivide => b"CheckedDivide"
    Code.CheckedRemainder => b"CheckedRemainder"
    Code.IsNaN => b"IsNaN"
    Code.IsInfinite => b"IsInfinite"
    Code.IsFinite => b"IsFinite"
    Code.IsNormal => b"IsNormal"
    Code.IsSubnormal => b"IsSubnormal"
    Code.IsSignNegative => b"IsSignNegative"
    Code.TotalOrder => b"TotalOrder"
    Code.ToBits => b"ToBits"
    Code.FromBits => b"FromBits"
    Code.Sqrt => b"Sqrt"
    Code.Sin => b"Sin"
    Code.Cos => b"Cos"
    Code.Not => b"Not"
    Code.Convert => b"To"
    Code.CheckedConvert => b"CheckedTo"
  }
}

// The category of a scalar type.
fn categoryOf(scalar: Scalar) -> Category {
  return match scalar {
    Scalar.Bool => Category.Boolean
    Scalar.Char => Category.Character
    Scalar.F32 => Category.Floating
    Scalar.F64 => Category.Floating
    _ => Category.Integer
  }
}

// Whether an integer scalar is signed.
fn isSigned(scalar: Scalar) -> bool {
  return scalar == Scalar.I8 || scalar == Scalar.I16 || scalar == Scalar.I32 || scalar == Scalar.I64 || scalar == Scalar.Isize
}

// The unsigned integer holding a floating scalar's IEEE 754 bits.
fn bitsOf(scalar: Scalar) -> Scalar {
  if scalar == Scalar.F32 { return Scalar.U32 }
  return Scalar.U64
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether `name[start..]` begins with `prefix`.
fn startsAt(name: &[u8], start: usize, prefix: &[u8]) -> bool {
  if start > name.length || name.length - start < prefix.length { return false }
  let mut at = usize.ZERO
  while at < prefix.length {
    if name[start + at] != prefix[at] { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether `name[start..]` is exactly `rest`.
fn restIs(name: &[u8], start: usize, rest: &[u8]) -> bool {
  return startsAt(name, start, rest) && name.length - start == rest.length
}

fn integer(scalar: Scalar) -> bool {
  return categoryOf(scalar) == Category.Integer
}

fn numeric(scalar: Scalar) -> bool {
  return integer(scalar) || categoryOf(scalar) == Category.Floating
}

fn comparison(code: Code) -> bool {
  return code == Code.Equals || code == Code.NotEquals || code == Code.LessThan || code == Code.LessOrEqual || code == Code.GreaterThan || code == Code.GreaterOrEqual
}

// Whether the canonical catalog defines `actor` with operation `code` toward `target`.
fn defined(actor: Scalar, code: Code, target: Scalar) -> bool {
  if code == Code.Convert {
    // `charToU32` is the only character conversion; booleans convert to nothing.
    if actor == Scalar.Char { return target == Scalar.U32 }
    return numeric(actor) && numeric(target)
  }
  if code == Code.CheckedConvert {
    // `charFromU32` is the checked conversion from `u32` toward `char`.
    if target == Scalar.Char { return actor == Scalar.U32 }
    return integer(actor) && integer(target)
  }
  if target != actor { return false }
  return match categoryOf(actor) {
    Category.Boolean => code == Code.Equals || code == Code.NotEquals || code == Code.Not
    Category.Character => comparison(code)
    Category.Floating => code == Code.Negate || code == Code.Add || code == Code.Subtract || code == Code.Multiply
      || code == Code.Divide || code == Code.Remainder || comparison(code) || code == Code.IsNaN
      || code == Code.IsInfinite || code == Code.IsFinite || code == Code.IsNormal || code == Code.IsSubnormal
      || code == Code.IsSignNegative || code == Code.TotalOrder || code == Code.ToBits || code == Code.FromBits
      || code == Code.Sqrt || code == Code.Sin || code == Code.Cos
    Category.Integer => {
      if code == Code.Negate || code == Code.WrappingNegate || code == Code.SaturatingNegate { return isSigned(actor) }
      return code != Code.Not && code != Code.IsNaN && code != Code.IsInfinite && code != Code.IsFinite
        && code != Code.IsNormal && code != Code.IsSubnormal && code != Code.IsSignNegative
        && code != Code.TotalOrder && code != Code.ToBits && code != Code.FromBits && code != Code.Sqrt
        && code != Code.Sin && code != Code.Cos
    }
  }
}

impl ScalarOperation {
  /// The source spelling of a scalar type.
  pub fn scalarSpelling(scalar: Scalar) -> &'static [u8] {
    return spellingOf(scalar)
  }

  /// Selects the catalog entry spelled `name`, such as `u32ShiftLeft`, `usizeToI32` or `charFromU32`.
  pub fn lookup(name: &[u8]) -> Option<ScalarOperation> {
    if sameBytes(name, b"charFromU32") {
      return Option.some<ScalarOperation>(ScalarOperation {actor: Scalar.U32, code: Code.CheckedConvert, target: Scalar.Char})
    }
    let scalarTable = scalars()
    let all: &[Scalar] = &scalarTable
    let mut scalarAt = usize.ZERO
    while scalarAt < all.length {
      let actor = all[scalarAt]
      let prefix = spellingOf(actor)
      if startsAt(name, usize.ZERO, prefix) {
        let start = prefix.length
        let codeTable = spelledCodes()
        let codes: &[Code] = &codeTable
        let mut codeAt = usize.ZERO
        while codeAt < codes.length {
          let code = codes[codeAt]
          if restIs(name, start, codeSpelling(code)) && defined(actor, code, actor) {
            return Option.some<ScalarOperation>(ScalarOperation {actor: actor, code: code, target: actor})
          }
          codeAt = codeAt + usize.ONE
        }
        let mut targetAt = usize.ZERO
        while targetAt < all.length {
          let target = all[targetAt]
          if target != Scalar.Char {
            let mut code = Code.Convert
            let mut matched = startsAt(name, start, codeSpelling(Code.Convert))
            if startsAt(name, start, codeSpelling(Code.CheckedConvert)) {
              code = Code.CheckedConvert
              matched = true
            }
            let selected = start + codeSpelling(code).length
            if matched && restIs(name, selected, capitalSpelling(target)) && defined(actor, code, target) {
              return Option.some<ScalarOperation>(ScalarOperation {actor: actor, code: code, target: target})
            }
          }
          targetAt = targetAt + usize.ONE
        }
      }
      scalarAt = scalarAt + usize.ONE
    }
    return Option.none<ScalarOperation>()
  }

  /// The canonical member spelling of a selected operation.
  pub effect fn spelling(self: Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    if self.code == Code.CheckedConvert && self.target == Scalar.Char {
      return run Bytes.copy(b"charFromU32")
    }
    let mut text = run Bytes.copy(spellingOf(self.actor))
    run Bytes.append(&mut text, codeSpelling(self.code))
    if self.code == Code.Convert || self.code == Code.CheckedConvert {
      run Bytes.append(&mut text, capitalSpelling(self.target))
    }
    return move text
  }

  /// Whether the operation returns through its `present` and `absent` carriers.
  pub fn checked(self: Self) -> bool {
    return self.code == Code.CheckedAdd || self.code == Code.CheckedSubtract || self.code == Code.CheckedMultiply
      || self.code == Code.CheckedDivide || self.code == Code.CheckedRemainder || self.code == Code.CheckedConvert
  }

  /// The number of scalar operands, excluding the carriers of a checked operation.
  pub fn arity(self: Self) -> usize {
    return match self.code {
      Code.Negate => usize.ONE
      Code.BitNot => usize.ONE
      Code.WrappingNegate => usize.ONE
      Code.SaturatingNegate => usize.ONE
      Code.IsNaN => usize.ONE
      Code.IsInfinite => usize.ONE
      Code.IsFinite => usize.ONE
      Code.IsNormal => usize.ONE
      Code.IsSubnormal => usize.ONE
      Code.IsSignNegative => usize.ONE
      Code.ToBits => usize.ONE
      Code.FromBits => usize.ONE
      Code.Sqrt => usize.ONE
      Code.Sin => usize.ONE
      Code.Cos => usize.ONE
      Code.Not => usize.ONE
      Code.Convert => usize.ONE
      Code.CheckedConvert => usize.ONE
      _ => 2
    }
  }

  /// The scalar type of every operand. `fromBits` takes the unsigned bits of its floating actor.
  pub fn operand(self: Self) -> Scalar {
    if self.code == Code.FromBits { return bitsOf(self.actor) }
    return self.actor
  }

  /// Whether the operands are shared references to the scalar. Only `lessThan` borrows.
  pub fn borrows(self: Self) -> bool {
    return self.code == Code.LessThan
  }

  /// The scalar the operation produces; for a checked operation, the `present` carrier's input.
  pub fn result(self: Self) -> Scalar {
    if comparison(self.code) || self.code == Code.IsNaN || self.code == Code.IsInfinite || self.code == Code.IsFinite
      || self.code == Code.IsNormal || self.code == Code.IsSubnormal || self.code == Code.IsSignNegative
      || self.code == Code.TotalOrder {
      return Scalar.Bool
    }
    if self.code == Code.ToBits { return bitsOf(self.actor) }
    return self.target
  }

  /// The source operator with exactly this operation's semantics, when one exists: ordinary
  /// arithmetic traps on overflow and division by zero, and comparisons follow the operand's
  /// signedness or IEEE ordering.
  pub fn infix(self: Self) -> Option<InfixOperator> {
    return match self.code {
      Code.Add => Option.some<InfixOperator>(InfixOperator.Add)
      Code.Subtract => Option.some<InfixOperator>(InfixOperator.Subtract)
      Code.Multiply => Option.some<InfixOperator>(InfixOperator.Multiply)
      Code.Divide => Option.some<InfixOperator>(InfixOperator.Divide)
      Code.Remainder => Option.some<InfixOperator>(InfixOperator.Remainder)
      Code.Equals => Option.some<InfixOperator>(InfixOperator.Equals)
      Code.NotEquals => Option.some<InfixOperator>(InfixOperator.NotEquals)
      Code.LessThan => Option.some<InfixOperator>(InfixOperator.LessThan)
      Code.LessOrEqual => Option.some<InfixOperator>(InfixOperator.LessOrEqual)
      Code.GreaterThan => Option.some<InfixOperator>(InfixOperator.GreaterThan)
      Code.GreaterOrEqual => Option.some<InfixOperator>(InfixOperator.GreaterOrEqual)
      Code.BitAnd => Option.some<InfixOperator>(InfixOperator.BitAnd)
      Code.BitOr => Option.some<InfixOperator>(InfixOperator.BitOr)
      Code.BitXor => Option.some<InfixOperator>(InfixOperator.BitXor)
      _ => Option.none<InfixOperator>()
    }
  }

  /// The source prefix operator with exactly this operation's semantics, when one exists.
  pub fn prefix(self: Self) -> Option<PrefixOperator> {
    return match self.code {
      Code.Negate => Option.some<PrefixOperator>(PrefixOperator.Negate)
      Code.BitNot => Option.some<PrefixOperator>(PrefixOperator.BitwiseNot)
      Code.Not => Option.some<PrefixOperator>(PrefixOperator.Not)
      _ => Option.none<PrefixOperator>()
    }
  }
}
