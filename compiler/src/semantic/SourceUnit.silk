//! Parsed source bytes and authored HIR for one module in one held revision.
//!
//! # When to use
//! Use [`SourceUnit`] for syntax, authored declarations, and diagnostics from the same source
//! capture. Its parser tree owns the exact bytes that its HIR spans address.

import hir.Hir {Diagnostic, Module}
import hir.Lower
import lexer.Lexer {Lexer}
import lexer.Token {Token}
import parser.Element {Element}
import parser.Node {Node}
import parser.Parser
import parser.SyntaxTree {SyntaxTree}
import semantic.ModuleId {ModuleId}
import semantic.SourceLocations {SourceLocations}
import silk.mem.shared {Shared}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.num.usize
import silk.collections.list {List}
import Stream {Stream}

/// A complete parsed source file and its authored HIR under one revision.
pub struct SourceUnit {
  /// The canonical module identity for these bytes.
  pub id: ModuleId,
  /// The number of the revision that supplied these bytes.
  pub revision: usize,
  /// The syntax tree that owns the exact parsed source bytes and their tokens.
  ///
  /// Its node and element arrays are released once the tree is lowered: nothing after lowering
  /// walks them, and a large package's trees would otherwise stay resident for the whole run.
  /// Read [`syntaxTree`] for a tree with its nodes.
  pub syntax: SyntaxTree,
  /// The HIR lowered from this syntax tree without semantic analysis.
  pub authored: Module,
  /// Current significant-token byte projections, shared by declaration anchors.
  pub locations: Shared<SourceLocations>,
}

/// A file's syntax tree and HIR, before [`SourceUnit.assemble`] names its module.
pub struct Parsed {
  pub syntax: SyntaxTree,
  pub authored: Module,
}

effect fn lex(lexer: &mut Lexer, bytes: usize) -> List<Token> ! OutOfMemoryError ? &mut Allocator {
  let mut tokens = List<Token>.make()
  // About one token in every four bytes, trivia included; growing a large file's list copies it.
  run List<Token>.reserveExact(&mut tokens, bytes / 10 * 3 + 16)
  while true {
    let taken = run Stream.take(&mut lexer)
    if let Option<Token>.Some {value} = move taken {
      run List<Token>.append(&mut tokens, move value)
    } else {
      break
    }
  }
  return move tokens
}

impl SourceUnit {
  /// Parses and lowers one complete source capture without resolving any import or type.
  ///
  /// # Details
  ///
  /// Syntax recovery remains in the returned tree and HIR. The source bytes remain in the tree
  /// and do not depend on a later provider read.
  pub effect fn parse(id: &ModuleId, revision: usize, source: Bytes) -> SourceUnit
  ! OutOfMemoryError
  ? &mut Allocator {
    return run SourceUnit.assemble(id, revision, run SourceUnit.parseSyntax(move source))
  }
  /// The syntax tree and HIR of `source`, which hold nothing shared, so another thread can parse
  /// them for [`assemble`].
  pub effect fn parseSyntax(source: Bytes) -> Parsed ! OutOfMemoryError ? &mut Allocator {
    let mut lexer = Lexer.make(Bytes.asSlice(&source))
    let tokens = run lex(&mut lexer, Bytes.length(&source))
    let mut syntax = run Parser.parse(move source, move tokens)
    let authored = run Lower.lower(&syntax)
    drop Intrinsic.replace(syntax.nodes, List<Node>.make())
    drop Intrinsic.replace(syntax.elements, List<Element>.make())
    return Parsed {syntax: move syntax, authored: move authored}
  }

  /// Parses this unit's bytes again into a tree that keeps its nodes, for a reader such as
  /// folding that walks syntax nodes [`syntax`] no longer holds.
  pub effect fn syntaxTree(self: &Self) -> SyntaxTree ! OutOfMemoryError ? &mut Allocator {
    let source = run Bytes.copy(Bytes.asSlice(&self.syntax.source))
    let mut lexer = Lexer.make(Bytes.asSlice(&source))
    let tokens = run lex(&mut lexer, Bytes.length(&source))
    return run Parser.parse(move source, move tokens)
  }
  /// The unit of module `id` whose bytes [`parseSyntax`] parsed into `parsed`.
  pub effect fn assemble(id: &ModuleId, revision: usize, parsed: Parsed) -> SourceUnit ! OutOfMemoryError ? &mut Allocator {
    let Parsed {syntax, authored} = move parsed
    let locations = run Shared<SourceLocations>.make(
      run SourceLocations.make(List<Token>.asSlice(&syntax.tokens), Bytes.asSlice(&syntax.source)),
    )
    return SourceUnit {
      id: ModuleId.copy(id),
      revision: revision,
      syntax: move syntax,
      authored: move authored,
      locations: move locations,
    }
  }
  /// Borrows the exact bytes that were parsed and lowered for this unit.
  pub fn bytes(self: &Self) -> &[u8] {
    return Bytes.asSlice(&self.syntax.source)
  }
  /// Returns one frontend diagnostic with a span into this unit's retained bytes.
  ///
  /// # Gotchas
  ///
  /// `index` must be less than [`diagnosticCount`]. Otherwise, the program traps.
  pub fn diagnostic(self: &Self, index: usize) -> Diagnostic {
    return List<Diagnostic>.get(&self.authored.diagnostics, index)
  }
  /// Returns the number of frontend diagnostics in this unit.
  pub fn diagnosticCount(self: &Self) -> usize {
    return List<Diagnostic>.length(&self.authored.diagnostics)
  }
}
