//! Parsed source bytes and authored HIR for one module in one held revision.
//!
//! # When to use
//! Use [`SourceUnit`] for source bytes, authored declarations, significant-token locations, and
//! diagnostics from the same source capture. Its retained bytes match the offsets its HIR spans address.

import hir.Hir {Diagnostic, Module}
import hir.Lower
import lexer.Lexer {Lexer}
import lexer.Token {Token}
import parser.Element {Element}
import parser.Node {Node}
import parser.Parser
import parser.SyntaxTree {SyntaxTree}
import semantic.ModuleId {ModuleId}
import semantic.SourceLocations {SourceLocations}
import silk.mem.shared {Shared}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.num.usize
import silk.collections.list {List}
import silk.collections.column_list {ColumnList}
import Stream {Stream}
import Tracing
import silk.trace {Trace}

/// A complete parsed source file and its authored HIR under one revision.
pub struct SourceUnit {
  /// The canonical module identity for these bytes.
  pub id: ModuleId,
  /// The number of the revision that supplied these bytes.
  pub revision: usize,
  /// The exact parsed source bytes addressed by authored HIR and location spans.
  pub source: Bytes,
  /// The HIR lowered from these bytes without semantic analysis.
  pub authored: Module,
  /// Current significant-token byte projections, shared by declaration anchors.
  pub locations: Shared<SourceLocations>,
}

/// A file's source bytes, lowered HIR, and significant-token locations, before
/// [`SourceUnit.assemble`] names its module.
pub struct Parsed {
  pub source: Bytes,
  pub authored: Module,
  pub locations: SourceLocations,
}

@trace(name: "lex")
effect fn lex(lexer: &mut Lexer<'_>, bytes: usize) -> ColumnList<Token> ! OutOfMemoryError ? &mut Allocator {
  let mut tokens = ColumnList<Token>.make()
  // About one token in every four bytes, trivia included; growing a large file's list copies it.
  run ColumnList<Token>.reserve(&mut tokens, bytes / 10 * 3 + 16)
  while true {
    let taken = run Stream.take(&mut lexer)
    if let Option<Token>.Some {value} = move taken {
      run ColumnList<Token>.append(&mut tokens, move value)
    } else {
      break
    }
  }
  return move tokens
}

impl SourceUnit {
  /// Parses and lowers one complete source capture without resolving any import or type.
  ///
  /// # Details
  ///
  /// Syntax recovery remains in the returned tree and HIR. The source bytes remain in the tree
  /// and do not depend on a later provider read.
  pub effect fn parse(id: &ModuleId, revision: usize, source: Bytes) -> SourceUnit
  ! OutOfMemoryError
  ? &mut Allocator {
    // A file no load parsed ahead is parsed where the first query reads it.
    let _traced = Trace.span("parse.file")
    if Tracing.on() {
      let path = run ModuleId.copyPackagePath(id)
      Trace.set("module", &Tracing.label(Bytes.asSlice(&path)))
      Trace.set("bytes", &Bytes.length(&source))
    }
    return run SourceUnit.assemble(id, revision, run SourceUnit.parseSyntax(move source))
  }
  /// Lexes and parses `source` into a complete [`SyntaxTree`] retaining its tokens and nodes.
  pub effect fn parseTree(source: Bytes) -> SyntaxTree ! OutOfMemoryError ? &mut Allocator {
    let mut lexer = Lexer.make(Bytes.asSlice(&source))
    let tokens = run lex(&mut lexer, Bytes.length(&source))
    return run Parser.parse(move source, move tokens)
  }
  /// The source bytes, HIR, and significant-token locations of `source`, which hold nothing
  /// shared, so another thread can parse them for [`assemble`].
  pub effect fn parseSyntax(source: Bytes) -> Parsed ! OutOfMemoryError ? &mut Allocator {
    let mut syntax = run SourceUnit.parseTree(move source)
    let authored = run Lower.lower(&syntax)
    drop Intrinsic.replace(syntax.nodes, List<Node>.make())
    drop Intrinsic.replace(syntax.elements, List<Element>.make())
    let locations = run SourceLocations.make(&syntax.tokens, Bytes.asSlice(&syntax.source))
    let SyntaxTree {source: bytes, ..} = move syntax
    return Parsed {source: move bytes, authored: move authored, locations: move locations}
  }

  /// Parses this unit's bytes again into a complete tree with tokens and nodes, for readers such
  /// as folding and documentation attachment.
  pub effect fn syntaxTree(self: &Self) -> SyntaxTree ! OutOfMemoryError ? &mut Allocator {
    return run SourceUnit.parseTree(run Bytes.copy(Bytes.asSlice(&self.source)))
  }
  /// Lexes this unit's bytes again for a reader that needs the full token stream.
  pub effect fn tokens(self: &Self) -> ColumnList<Token> ! OutOfMemoryError ? &mut Allocator {
    let source = Bytes.asSlice(&self.source)
    let mut lexer = Lexer.make(source)
    return run lex(&mut lexer, source.length)
  }

  /// The unit of module `id` whose bytes [`parseSyntax`] parsed into `parsed`.
  pub effect fn assemble(id: &ModuleId, revision: usize, parsed: Parsed) -> SourceUnit ! OutOfMemoryError ? &mut Allocator {
    let Parsed {source, authored, locations} = move parsed
    return SourceUnit {
      id: ModuleId.copy(id),
      revision: revision,
      source: move source,
      authored: move authored,
      locations: run Shared<SourceLocations>.make(move locations),
    }
  }
  /// Borrows the exact bytes that were parsed and lowered for this unit.
  pub fn bytes(self: &Self) -> &[u8] {
    return Bytes.asSlice(&self.source)
  }
  /// Returns one frontend diagnostic with a span into this unit's retained bytes.
  ///
  /// # Gotchas
  ///
  /// `index` must be less than [`diagnosticCount`]. Otherwise, the program traps.
  pub fn diagnostic(self: &Self, index: usize) -> Diagnostic {
    return List<Diagnostic>.get(&self.authored.diagnostics, index)
  }
  /// Returns the number of frontend diagnostics in this unit.
  pub fn diagnosticCount(self: &Self) -> usize {
    return List<Diagnostic>.length(&self.authored.diagnostics)
  }
}
