//! Incremental cache publication preserves exact owners across real segment boundaries.

import semantic.CacheImage as Image {Root as ImageRoot}
import semantic.CacheSegmentBuild as Build {Built, ExternalNode, RootMapping, RootPacks, Target}
import semantic.CacheSegments as Segments {Edge, Node, Observation, Reference}
import semantic.ContentHash {ContentHash}
import semantic.RuntimeEncoding
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.frozen {Frozen}
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.testing.testing {AssertionError, Testing}

fn hash(value: usize) -> ContentHash { return ContentHash {high: 0, low: usize.toU64(value)} }
fn same(left: &[u8], right: &[u8]) -> bool { return RuntimeEncoding.equals(left, right) }
fn sameTarget(left: Target, right: Target) -> bool {
  return ContentHash.equals(left.segment, right.segment) && left.index == right.index
}
fn resolve(owner: &Segments.SealedSegment, reference: Reference) -> Target {
  let digest = if reference.segment == usize.ZERO { Segments.descriptor(owner).digest }
    else { Segments.imports(owner)[reference.segment - usize.ONE].digest }
  return Target {segment: digest, index: reference.index}
}
fn ownerFor<'a>(owners: &'a [Frozen<Segments.SealedSegment>], target: Target) -> Option<&'a Segments.SealedSegment> {
  let mut at = usize.ZERO
  while at < owners.length {
    let owner = Frozen<Segments.SealedSegment>.get(&owners[at])
    if ContentHash.equals(Segments.descriptor(owner).digest, target.segment) {
      return Option<&Segments.SealedSegment>.some(owner)
    }
    at = at + usize.ONE
  }
  return Option<&Segments.SealedSegment>.none()
}
effect fn parent(serial: u64) -> Frozen<Segments.SealedSegment>
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut segment = run Segments.make(serial, b"segment-build-test")
  run List<Observation>.append(&mut segment.leaves, Observation {key: run Bytes.copy(b"old/file"),
    digest: hash(10), text: hash(0), position: usize.MAX, file: Option<Reference>.none(), selector: u32.MAX, input: false})
  let mut edges = List<Edge>.make()
  run List<Edge>.append(&mut edges, Edge {node: false, target: Reference {segment: 0, index: 0}})
  run List<Node>.append(&mut segment.nodes, Node {edges: move edges})
  let sealed = match move run Segments.seal(move segment, &[]) {
    Option<Segments.SealedSegment>.Some {value} => move value
    _ => { run Testing.expect(false, "the prior immutable owner seals") return absurd<Frozen<Segments.SealedSegment>>() }
  }
  return run Frozen<Segments.SealedSegment>.make(move sealed)
}
effect fn tinyImage(duplicate: bool, nonempty: bool) -> Image.Image ! OutOfMemoryError ? &mut Allocator {
  let mut image = Image.make()
  let file = run Image.addLeaf(&mut image, false, run Bytes.copy(b"fresh/file"), hash(20), usize.MAX, usize.MAX, hash(0))
  let node = if nonempty { run Image.addNode(&mut image, &[Image.leafEdge(file)]) }
    else { run Image.addNode(&mut image, &[]) }
  run List<ImageRoot>.append(&mut image.roots, ImageRoot {key: run Bytes.copy(b"fresh/root"), node: node, answer: run Bytes.copy(b"first")})
  if duplicate {
    run List<ImageRoot>.append(&mut image.roots, ImageRoot {key: run Bytes.copy(b"fresh/root"), node: node, answer: run Bytes.copy(b"second")})
  }
  return move image
}
effect fn refused(result: Option<Built>, message: string<'static>) -> () ! AssertionError<'static> {
  match move result {
    Option<Built>.None => {}
    Option<Built>.Some {..} => { run Testing.expect(false, message) }
  }
}

effect fn identityClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut parents = List<Frozen<Segments.SealedSegment>>.make()
  run List<Frozen<Segments.SealedSegment>>.append(&mut parents, run parent(11))
  run List<Frozen<Segments.SealedSegment>>.append(&mut parents, run parent(7))
  let prior = Frozen<Segments.SealedSegment>.get(&List<Frozen<Segments.SealedSegment>>.asSlice(&parents)[1])
  let before = ContentHash.of(Segments.encoded(prior))
  let inherited = Target {segment: Segments.descriptor(prior).digest, index: 0}
  let mut image = Image.make()
  // The source input deliberately precedes its whole-file anchor in the incoming image.
  let input = run Image.addLeaf(&mut image, true, run Bytes.copy(b"fresh/input"), hash(21), 9, 1, hash(22))
  let file = run Image.addLeaf(&mut image, false, run Bytes.copy(b"fresh/file"), hash(20), usize.MAX, usize.MAX, hash(0))
  let external = run Image.addNode(&mut image, &[])
  let node = run Image.addNode(&mut image, &[Image.nodeEdge(external), Image.leafEdge(input)])
  run List<ImageRoot>.append(&mut image.roots, ImageRoot {key: run Bytes.copy(b"fresh/root"), node: node, answer: run Bytes.copy(b"fresh-answer")})
  let mut packIds = List<ContentHash>.make()
  run List<ContentHash>.append(&mut packIds, hash(31))
  run List<ContentHash>.append(&mut packIds, hash(32))
  let packs = [RootPacks {root: 0, packs: move packIds}]
  let built = match move run Build.build(b"segment-build-test", move image,
    &[ExternalNode {node: external, target: inherited}], &packs, List<Frozen<Segments.SealedSegment>>.asSlice(&parents)) {
    Option<Built>.Some {value} => move value
    _ => { run Testing.expect(false, "fresh guards and authenticated external nodes publish") return () }
  }
  let owners = List<Frozen<Segments.SealedSegment>>.asSlice(&built.owners)
  let mappings = List<RootMapping>.asSlice(&built.roots)
  run Testing.expect(owners.length == usize.ONE && mappings.length == usize.ONE && mappings[0].source == usize.ZERO,
    "publication returns only new owners and an exact original-root mapping")
  let owner = Frozen<Segments.SealedSegment>.get(&owners[0])
  let description = Segments.descriptor(owner)
  run Testing.expect(description.serial == 12 && description.nodes == usize.ONE && Segments.imports(owner).length == usize.ONE,
    "the prior graph remains imported rather than copied into fresh nodes")
  run Testing.expect(Segments.authenticateImports(owner, List<Frozen<Segments.SealedSegment>>.asSlice(&parents)),
    "fresh import descriptors are backed by the actual immutable parent")
  run Testing.expect(ContentHash.equals(mappings[0].target.segment, description.digest), "root mapping names its actual new owner")
  let rootNode = match move Segments.rootNode(owner, mappings[0].target.index) {
    Option<Reference>.Some {value} => value
    _ => { run Testing.expect(false, "published root has its dependency node") return () }
  }
  let first = match move Segments.edge(owner, rootNode.index, 0) {
    Option<Edge>.Some {value} => value
    _ => { run Testing.expect(false, "fresh dependency retains the external edge") return () }
  }
  run Testing.expect(first.node && sameTarget(resolve(owner, first.target), inherited),
    "external placeholders become the exact prior node without identity rebinding")
  let leaves = List<Target>.asSlice(&built.leaves)
  run Testing.expect(leaves.length == 2, "every original fresh leaf has one published identity")
  let observation = match move Segments.observation(owner, leaves[input].index) {
    Option<Segments.ObservationView>.Some {value} => move value
    _ => { run Testing.expect(false, "the original input mapping finds its exact observation") return () }
  }
  run Testing.expect(observation.input && observation.position == 9 && ContentHash.equals(observation.digest, hash(21))
    && ContentHash.equals(observation.text, hash(22)) && same(observation.key, b"fresh/input"),
    "input fingerprints and original placement evidence survive the files-first pass")
  let source = match move observation.file {
    Option<Reference>.Some {value} => value
    _ => { run Testing.expect(false, "the input retains its file snapshot") return () }
  }
  run Testing.expect(sameTarget(resolve(owner, source), leaves[file]), "a forward file link maps to the original whole-file snapshot")
  run Testing.expect(Segments.rootPackCount(owner, mappings[0].target.index) == 2, "root pack ownership is preserved")
  let one = Segments.rootPack(owner, mappings[0].target.index, 0)
  let two = Segments.rootPack(owner, mappings[0].target.index, 1)
  run Testing.expect(match move one { Option<ContentHash>.Some {value} => ContentHash.equals(value, hash(31)) _ => false }
    && match move two { Option<ContentHash>.Some {value} => ContentHash.equals(value, hash(32)) _ => false },
    "pack identities retain their supplied order")
  run Testing.expect(ContentHash.equals(before, ContentHash.of(Segments.encoded(prior))),
    "publishing a child does not rewrite its parent")
}

effect fn partitionClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut image = Image.make()
  let file = run Image.addLeaf(&mut image, false, run Bytes.copy(b"partition/file"), hash(40), usize.MAX, usize.MAX, hash(0))
  let node = run Image.addNode(&mut image, &[Image.leafEdge(file)])
  // Two individually admissible answers exceed the real segment limit together, including
  // framing. This exercises production partitioning without a lowered test-only threshold.
  let mut first = run Bytes.zeroed(Segments.BYTE_LIMIT / 2)
  Bytes.asMutSlice(&mut first)[0] = 17
  let mut second = run Bytes.zeroed(Segments.BYTE_LIMIT / 2)
  Bytes.asMutSlice(&mut second)[0] = 29
  let expected = [ContentHash.of(Bytes.asSlice(&first)), ContentHash.of(Bytes.asSlice(&second))]
  run List<ImageRoot>.append(&mut image.roots, ImageRoot {key: run Bytes.copy(b"first"), node: node, answer: move first})
  run List<ImageRoot>.append(&mut image.roots, ImageRoot {key: run Bytes.copy(b"second"), node: node, answer: move second})
  let built = match move run Build.build(b"segment-build-test", move image, &[], &[], &[]) {
    Option<Built>.Some {value} => move value
    _ => { run Testing.expect(false, "large valid answers partition into authenticated owners") return () }
  }
  let owners = List<Frozen<Segments.SealedSegment>>.asSlice(&built.owners)
  let mappings = List<RootMapping>.asSlice(&built.roots)
  run Testing.expect(owners.length > usize.ONE && mappings.length == 2,
    "the real production boundary produces multiple owners while preserving both roots")
  let mut admitted = List<Frozen<Segments.SealedSegment>>.make()
  let mut at = usize.ZERO
  while at < owners.length {
    let owner = Frozen<Segments.SealedSegment>.get(&owners[at])
    run Testing.expect(Segments.authenticateImports(owner, List<Frozen<Segments.SealedSegment>>.asSlice(&admitted)),
      "each partition references only already authenticated predecessors")
    run List<Frozen<Segments.SealedSegment>>.append(&mut admitted, Frozen<Segments.SealedSegment>.clone(&owners[at]))
    at = at + usize.ONE
  }
  let mut commonNode = Option<Target>.none()
  at = usize.ZERO
  while at < mappings.length {
    let mapping = &mappings[at]
    let owner = match move ownerFor(owners, mapping.target) {
      Option<&Segments.SealedSegment>.Some {value} => value
      _ => { run Testing.expect(false, "every root mapping identifies a returned owner") return () }
    }
    let answer = match move Segments.rootAnswer(owner, mapping.target.index) {
      Option<&[u8]>.Some {value} => value
      _ => { run Testing.expect(false, "each partition retains its whole answer") return () }
    }
    run Testing.expect(mapping.source < 2 && ContentHash.equals(ContentHash.of(answer), expected[mapping.source]),
      "partitioning neither truncates nor swaps answer payloads")
    let reference = match move Segments.rootNode(owner, mapping.target.index) {
      Option<Reference>.Some {value} => value
      _ => { run Testing.expect(false, "each partitioned root has its guard") return () }
    }
    let target = resolve(owner, reference)
    if let Option<Target>.Some {value: prior} = &commonNode {
      run Testing.expect(sameTarget(target, prior), "roots in separate segments share the exact original dependency node")
    } else { commonNode = Option<Target>.some(target) }
    at = at + usize.ONE
  }
}

effect fn refusalClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let parents = [run parent(1)]
  let descriptor = Segments.descriptor(Frozen<Segments.SealedSegment>.get(&parents[0]))
  let target = Target {segment: descriptor.digest, index: 0}
  run refused(run Build.build(b"segment-build-test", run tinyImage(true, false), &[], &[], &[]),
    "duplicate fresh root keys are refused rather than arbitrarily choosing an answer")
  run refused(run Build.build(b"segment-build-test", run tinyImage(false, false),
    &[ExternalNode {node: 0, target: target}, ExternalNode {node: 0, target: target}], &[], &parents),
    "duplicate external-node mappings are refused")
  run refused(run Build.build(b"segment-build-test", run tinyImage(false, true),
    &[ExternalNode {node: 0, target: target}], &[], &parents), "a nonempty node cannot masquerade as an external placeholder")
  run refused(run Build.build(b"segment-build-test", run tinyImage(false, false),
    &[ExternalNode {node: 0, target: target}], &[], &[]), "a target without an authenticated parent is refused")
  run refused(run Build.build(b"segment-build-test", run tinyImage(false, false),
    &[ExternalNode {node: 0, target: Target {segment: descriptor.digest, index: descriptor.nodes}}], &[], &parents),
    "an out-of-range parent node cannot become an imported guard")
  let exhausted = [run parent(u64.MAX)]
  run refused(run Build.build(b"segment-build-test", run tinyImage(false, false), &[], &[], &exhausted),
    "serial exhaustion refuses instead of wrapping before its parents")
}

effect fn oversizedClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut image = Image.make()
  let node = run Image.addNode(&mut image, &[])
  run List<ImageRoot>.append(&mut image.roots, ImageRoot {key: run Bytes.copy(b"oversized"), node: node,
    answer: run Bytes.zeroed(Segments.BYTE_LIMIT + usize.ONE)})
  run refused(run Build.build(b"segment-build-test", move image, &[], &[], &[]),
    "one unpartitionable oversized answer explicitly refuses publication")
}

test effect fn cacheSegmentBuildPreservesForwardFilesExternalGuardsAndPacks() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run identityClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
test effect fn cacheSegmentBuildPartitionsAtTheRealBoundaryWithoutRebinding() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run partitionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
test effect fn cacheSegmentBuildRefusesAmbiguousOrUnauthenticatedOwners() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run refusalClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
test effect fn cacheSegmentBuildRefusesOneOversizedAnswer() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run oversizedClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
