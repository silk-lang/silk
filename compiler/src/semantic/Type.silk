//! Semantic identity for written types, lifetime relationships, and generic applications.
//!
//! # When to use
//! Use [`Type`] in signatures and typed bodies. Use [`equalsShared`] to compare type handles from
//! different queries or source revisions without comparing allocation positions. Use [`Row`] for
//! the normalized requirement channel of an Effect contract.

import hir.Hir {Access, CallableMode, Multiplicity, OwnerKind}
import semantic.Intrinsic as CheckedIntrinsic
import semantic.ForeignContract {ForeignContract}
import semantic.DeclarationId {
  DeclarationId,
  Part as DeclarationPart,
  Projection as DeclarationProjection,
  OwnerStep,
}
import semantic.InternIndex {InternIndex}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.Specialization {Application, ScopeBinding, StaticSlot, Target as ApplicationTarget}
import semantic.RuntimeEncoding
import semantic.StaticValue
import semantic.RuntimeEncoding {Coordinates}
import semantic.CallableSchema
import semantic.Subtraction
import semantic.Subtraction {Fate, Relation}
import semantic.CallableWitness
import semantic.CallableWitness {CallableWitness as WitnessRecipe, OperandLoan as WitnessLoan}
import semantic.CallableSchema {CallableSchema as SectionSchema}
import semantic.Lifetime {CanonicalizationFailure, Intersection, Lifetime, Member, Numbering}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.hash {Hash}
import silk.result {Result}
import silk.option {Option}
import silk.pointer {Pointer}
import silk.shared {Shared}
import silk.u8
import silk.u64
import silk.usize
import silk.vector {Vector}

/// One fixed array's element identity and canonical logical length.
pub struct ArrayShape {
  pub element: Shared<Type>
  pub length: usize
}

/// The literal that generates one anonymous aggregate type. It has no source name and cannot be
/// imported or exported; a separate same-shaped literal is a different type.
pub struct AnonymousOccurrence {
  /// The declaration whose body contains the literal.
  pub declaration: Shared<DeclarationId>
  /// The literal's authored syntax index in that declaration's module.
  pub syntax: usize
  /// Whether members are positions (`(a, b)`) rather than labeled fields (`.{a: x}`).
  pub positional: bool
  /// Field labels in written order; empty for a positional aggregate.
  pub labels: Vector<Bytes>
}

/// The decomposed parts of one anonymous aggregate type.
pub struct AnonymousParts {
  pub occurrence: Shared<AnonymousOccurrence>
  pub members: Vector<Shared<Type>>
}

impl AnonymousOccurrence {
  /// Whether the literal is positional.
  pub fn isPositional(value: &Shared<AnonymousOccurrence>) -> bool {
    return Shared.with<AnonymousOccurrence, bool>(value, fn(found: &AnonymousOccurrence) -> bool { return found.positional })
  }
  /// The written position of one field label; `usize.MAX` when the literal has no such label.
  pub fn labelIndex(value: &Shared<AnonymousOccurrence>, name: &[u8]) -> usize {
    return Shared.with<AnonymousOccurrence, usize>(
      value,
      fn(found: &AnonymousOccurrence) -> usize {
        let labels = Vector.asSlice<Bytes>(&found.labels)
        let mut at = usize.ZERO
        while at < labels.length {
          if sameBytes(Bytes.asSlice(&labels[at]), name) { return at }
          at = at + usize.ONE
        }
        return usize.MAX
      },
    )
  }
  /// Whether two handles name the same generating literal.
  pub fn equalsShared(left: &Shared<AnonymousOccurrence>, right: &Shared<AnonymousOccurrence>) -> bool {
    // Copied types share one occurrence allocation; nested exclusive access to it would conflict.
    if Shared.with<AnonymousOccurrence, usize>(left, occurrenceAddress) == Shared.with<AnonymousOccurrence, usize>(right, occurrenceAddress) {
      return true
    }
    return Shared.with<AnonymousOccurrence, bool>(
      left,
      fn(first: &AnonymousOccurrence) -> bool {
        return occurrenceWith(first, right)
      },
    )
  }
}

fn occurrenceAddress(value: &AnonymousOccurrence) -> usize {
  return Pointer.address<AnonymousOccurrence>(Pointer.fromRef<AnonymousOccurrence>(value))
}

fn occurrenceWith(first: &AnonymousOccurrence, right: &Shared<AnonymousOccurrence>) -> bool {
  return Shared.with<AnonymousOccurrence, bool>(
    right,
    fn(second: &AnonymousOccurrence) -> bool {
      return first.syntax == second.syntax && first.positional == second.positional && sameDeclaration(&first.declaration, &second.declaration)
    },
  )
}

/// A canonical type resolved from a written declaration or type application.
pub union Type {
  /// One validated foundational type identified by its exact spelling.
  Primitive {
    /// The validated primitive spelling, independent of a source string table.
    pub name: Bytes,
  },
  /// The unit type.
  Unit,
  /// One canonical nominal declaration and its ordered type and lifetime arguments.
  Nominal {
    /// The complete canonical identity of the nominal declaration.
    pub declaration: DeclarationId,
    /// Whether the declaration is public; visibility does not change type identity.
    pub isPublic: bool,
    /// The ordered arguments of this nominal application; empty for a nongeneric declaration.
    pub arguments: Vector<Argument>,
  },
  /// One producer-owned opaque representation family, specialized over its declaration binders.
  /// Its callable or Effect contract describes use and retained environment, not exact identity.
  OpaqueRepresentation {
    /// The complete producer application, including enclosing scopes and hidden representations.
    pub application: Shared<Application>,
    pub contract: Shared<Type>,
    pub detached: bool,
    pub nonParking: bool,
  },
  /// One ordinary type parameter owned by a declaration, independent of its spelling.
  Parameter {
    /// The declaration that binds the parameter.
    pub declaration: DeclarationId,
    /// The parameter's position in its owner's complete binder list.
    pub ordinal: usize,
  },
  /// A UTF-8 view whose validity follows one lifetime.
  String {
    /// The validity relationship carried by this view.
    pub lifetime: Shared<Lifetime>,
  },
  /// A borrowed view of one referent with the written access mode.
  Reference {
    /// The referent's resolved type.
    pub referent: Shared<Type>,
    /// Shared or exclusive access.
    pub access: Access,
    /// The validity relationship of the borrow.
    pub lifetime: Shared<Lifetime>,
  },
  /// A borrowed runtime-length view of contiguous elements.
  Slice {
    /// The element's resolved type.
    pub element: Shared<Type>,
    /// Shared or exclusive access.
    pub access: Access,
    /// The validity relationship of the view.
    pub lifetime: Shared<Lifetime>,
  },
  /// A raw address with no loan or ownership claim.
  Pointer {
    /// The invariant pointee type.
    pub pointee: Shared<Type>,
    /// Whether the address permits writes.
    pub access: Access,
    /// Whether the address may be null.
    pub nullable: bool,
    /// Whether it addresses one value or a run.
    pub multiplicity: Multiplicity,
    /// Written minimum alignment; absence retains the semantic natural-alignment requirement.
    pub alignment: Option<u64>,
  },
  /// One non-null C function address with a checked scalar signature and behavioral identity.
  ForeignFunction {pub signature: Shared<Type>, pub behavior: ForeignContract},
  /// An authored fixed array with an exact, target-independent decimal extent.
  Array {pub element: Shared<Type>, pub extent: Bytes},
  /// One occurrence-generated anonymous tuple or record (RECORD-002). The generating occurrence
  /// is its nominal identity; members are that occurrence's element types in written order.
  Anonymous {pub occurrence: Shared<AnonymousOccurrence>, pub members: Vector<Shared<Type>>},
  /// The sealed phase-only `Intrinsic.Type<Owner>` descriptor of one aggregate type. It exists
  /// only during static evaluation and has no runtime representation.
  TypeDescriptor {
    /// The described aggregate type.
    pub owner: Shared<Type>,
  },
  /// A structural union: an unordered, duplicate-free set of two or more ordinary value types.
  ///
  /// The empty member set is `never`. A one-member union is represented by that member.
  Union {pub members: Vector<Shared<Type>>},
  /// One `Without<source, removed>` failure term (FAIL-005) whose result still depends on a
  /// parameter. [`Type.without`] decides every other member; substitution re-normalizes the term.
  Without {
    /// The undecided failure members the removed members are taken from.
    pub source: Shared<Type>,
    /// The removed failure members that can still match part of `source`.
    pub removed: Shared<Type>,
  },
  /// One exact callable environment. The body is an ordinary function application; the value
  /// stores only captures. An unstaged anonymous target receives the whole environment at zero;
  /// a section's field inputs describe the original environment and stored target arguments.
  CallableValue {
    /// Whether the target may be named by a public exact type. Visibility does not change identity.
    pub isPublic: bool,
    pub application: Shared<Application>,
    pub contract: Shared<Type>,
    pub captures: Vector<Shared<Type>>,
    pub fieldInputs: Vector<CallableFieldInput>,
    runtime: Shared<Bytes>,
  },
  /// One generic named section's exact capture record and immutable bound blueprint. Each use
  /// opens its deferred binders independently before publishing an ordinary function instance.
  CallableSchema {
    pub schema: Shared<SectionSchema>,
    pub captures: Vector<Shared<Type>>,
    pub fieldInputs: Vector<CallableFieldInput>,
    runtime: Shared<Bytes>,
  },
  /// A source staging recipe whose exact base representation is still abstract. Substitution
  /// resolves it to the original function application and capture record before runtime use.
  CallableStage {
    pub base: Shared<Type>,
    pub contract: Shared<Type>,
    pub captures: Vector<Shared<Type>>,
    pub remaining: usize,
    pub suffixMode: CallableMode,
  },
  /// Checked provenance of a callable-producing invocation whose target is still abstract.
  /// Arguments are selection evidence, not captures or physical environment fields. The resolver
  /// replaces a closed recipe with its original returned environment before runtime admission.
  CallableResult {
    pub producer: Shared<Type>,
    pub contract: Shared<Type>,
    pub arguments: Vector<Shared<Type>>,
    pub selected: Vector<Argument>,
    pub selectedOrdinals: Vector<usize>,
  },
  /// A checked ordinary producer edge retained while a finite return-origin graph is collected.
  /// This is source evidence only; its complete original application must resolve before layout.
  CallableOrigin {pub application: Shared<Application>, pub contract: Shared<Type>},
  /// A declared-bound operation selector whose original returned environment awaits a witness.
  CallableWitnessResult {pub witness: Shared<WitnessRecipe>},
  /// A proved public callable use contract over its original exact environment. The producer
  /// is not part of this identity; equal origins and equal contracts have the same view.
  CallableView {pub representation: Shared<Type>, pub contract: Shared<Type>},
  /// A callable contract. Parameter order is identity; the environment is the captures' validity.
  Callable {
    /// Shared, exclusive, or consuming access to the captured environment.
    pub mode: CallableMode,
    /// Whether the final invocation requires an `unsafe` acknowledgement.
    pub isUnsafe: bool,
    /// The validity of the retained environment.
    pub environment: Shared<Intersection>,
    /// The number of written and elided `for<...>` invocation binders.
    pub invocationBinders: usize,
    /// The canonical ordinal of the `for<use 'call>` binder, or `usize.MAX` when none is marked.
    /// Every supplied input remains valid for that binder's invocation extent (LIFE-004).
    pub invocationUse: usize,
    /// The `'longer: 'shorter` bounds written on the invocation binders, in written order.
    pub invocationBounds: Vector<Outlives>,
    /// The parameter types in written order.
    pub parameters: Vector<Shared<Type>>,
    /// The result type.
    pub result: Shared<Type>,
  },
  /// The exact Effect built by one sealed composition intrinsic (Effect note D1). Its environment
  /// is `parts` in written order; `selector` is the caught failure subset, or a row carrier holding
  /// the bound requirement; `contract` is the Effect it satisfies. A run site expands it (D4).
  EffectComposite {
    pub operation: Composition,
    pub selector: Shared<Type>,
    pub parts: Vector<Shared<Type>>,
    pub contract: Shared<Type>,
  },
  /// A finite join of exact Effects from distinct construction sites behind one `contract`
  /// (EFF-013). One alternative is stored as itself; several are stored as their structural union,
  /// and a run dispatches on its tag to the selected alternative's runner (Effect note D1).
  /// Alternatives are distinct exact Effects in first-seen order, never another join.
  EffectJoin {pub contract: Shared<Type>, pub alternatives: Vector<Shared<Type>>},
  /// A deferred computation with independent success, failure, and requirement channels.
  Effect {
    /// Shared, exclusive, or consuming run access.
    pub mode: CallableMode,
    /// The validity of the retained environment.
    pub environment: Shared<Intersection>,
    /// The value produced on success.
    pub success: Shared<Type>,
    /// The ordinary typed-failure type; `never` when omitted.
    pub failure: Shared<Type>,
    /// The normalized requirement row; empty when omitted.
    pub requirements: Shared<Row>,
  },
}

/// The sealed composition intrinsic that built an exact Effect.
pub enum Composition {
  CatchFailure,
  BindShared,
  BindExclusive,
  BindOwned,
  Finalize,
  FinalizeNonParking,
  UseRelease,
  /// `observeDiagnostics(state, callback, body)`: runs `body` under a lexical diagnostic observer.
  Observe,
  /// `suspendEffect(deferred)`: transfers execution to the deferred child at an explicit
  /// stack-safety boundary and resumes with its outcome (SUSP-001, SUSP-002).
  Suspend,
}

/// How one captured field supplies the original callable target, without an adapter.
pub union CallableFieldInput {
  /// The original anonymous environment, passed to its unchanged hidden body parameter.
  Environment,
  /// A supplied argument at its original parameter ordinal, independent of capture order.
  Argument {pub parameter: usize},
  /// A supplied argument whose type equals the application's type evidence at `slot`, as an
  /// exact representation binder does. Identity, equality and substitution read that type from
  /// the application, so a nested Effect value is walked once per level, not twice.
  Represented {pub parameter: usize, pub slot: usize},
}

impl Copy for CallableFieldInput {}

impl CallableFieldInput {
  /// Whether both inputs describe the same field source.
  pub fn equals(self: &Self, other: &CallableFieldInput) -> bool {
    return match &self.* {
      CallableFieldInput.Environment => match &other.* { CallableFieldInput.Environment => true _ => false }
      CallableFieldInput.Argument {parameter} => match &other.* {
        CallableFieldInput.Argument {parameter: compared} => parameter == compared _ => false }
      CallableFieldInput.Represented {parameter, slot} => match &other.* {
        CallableFieldInput.Represented {parameter: compared, slot: selected} => parameter == compared && slot == selected
        _ => false }
    }
  }

  /// Whether two field-input lists describe the same sources in the same capture order.
  pub fn allEqual(left: &[CallableFieldInput], right: &[CallableFieldInput]) -> bool {
    if left.length != right.length { return false }
    let mut at = usize.ZERO
    while at < left.length {
      if !CallableFieldInput.equals(&left[at], &right[at]) { return false }
      at = at + usize.ONE
    }
    return true
  }

  /// The original parameter ordinal a supplied argument fills; the environment has none.
  pub fn parameter(self: &Self) -> Option<usize> {
    return match &self.* {
      CallableFieldInput.Environment => Option.none<usize>()
      CallableFieldInput.Argument {parameter} => Option.some<usize>(parameter)
      CallableFieldInput.Represented {parameter, ..} => Option.some<usize>(parameter)
    }
  }
}

/// One requirement-row entry, keyed by a service application and a nominal role.
pub struct Requirement {
  /// The service application the Effect needs when it runs.
  pub capability: Shared<Type>
  /// The nominal role declaration's type; absent selects the implicit default role.
  pub roleType: Option<Shared<Type>>
  /// The strongest access required for this key; not part of the key.
  pub access: Access
}

/// A written `'longer: 'shorter` relationship.
pub struct Outlives {
  /// The lifetime that must cover the other.
  pub longer: Shared<Lifetime>
  /// The lifetime that is covered.
  pub shorter: Shared<Lifetime>
}

/// An exact value occupying an opaque slot of its producer's declared result.
/// Contract proof belongs to the semantic return boundary; neither type is rewritten here.
pub struct OpaqueEvidence {
  pub family: Shared<Type>
  pub actual: Shared<Type>
}

/// One declaration-owned `?R` requirement-row parameter, independent of its spelling.
pub struct RowParameter {
  /// The declaration that binds the parameter; shared so a row can be copied without allocation.
  pub declaration: Shared<DeclarationId>
  /// The parameter's position in its owner's complete binder list.
  pub ordinal: usize
}

/// A normalized requirement row. Entry order and repetition do not affect identity.
pub struct Row {
  /// Distinct service-role keys, each with its strongest required access.
  pub entries: Vector<Requirement>
  /// Distinct row parameters whose rows this row includes.
  pub parameters: Vector<RowParameter>
  /// Distinct `Without<source, removed>` terms that cannot normalize until a parameter is known.
  pub subtractions: Vector<RowSubtraction>
}

/// One `Without<source, removed>` term (SERV-008) whose result still depends on a row or type
/// parameter. Once both rows are concrete, [`Row.subtract`] replaces it with plain entries.
pub struct RowSubtraction {
  /// The undecided part of the row the keys are removed from.
  pub source: Shared<Row>
  /// The removed service-role keys; entry access does not participate in matching.
  pub removed: Shared<Row>
}

/// One canonical generic argument, with its type or lifetime kind retained.
pub union Argument {
  /// An ordinary type argument.
  Type {
    /// The resolved type supplied at this binder position.
    pub value: Shared<Type>,
  },
  /// A validity lifetime argument.
  Lifetime {
    /// The resolved lifetime supplied at this binder position.
    pub value: Shared<Lifetime>,
  },
  /// A complete requirement row supplied to a `?R` binder by the `? Row` suffix.
  Row {
    /// The normalized row supplied at this binder position.
    pub value: Shared<Row>,
  },
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn addressOf(value: &Type) -> usize {
  return Pointer.address<Type>(Pointer.fromRef<Type>(value))
}

fn invocationCount(value: &Type) -> usize {
  return match & value.* {
    Type.Callable {invocationBinders, ..} => invocationBinders
    _ => usize.ZERO
  }
}

// An alpha map begins with [sentinel, binder count, binder images...]. A quantified callable may
// append its own invocation-binder images. The two maps never share an ordinal namespace.
fn alphaMap(map: &[usize]) -> bool {
  return map.length >= 2 && map[usize.ZERO] == usize.MAX - usize.ONE
}

fn alphaPrefix(map: &[usize]) -> usize {
  if alphaMap(map) {
    return 2 + map[usize.ONE]
  }
  return usize.ZERO
}

fn isAssignedBetween(map: &[usize], start: usize, end: usize, target: usize) -> bool {
  let mut at = start
  while at < end {
    if map[at] == target {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn binderCompatible(map: &[usize], left: usize, right: usize) -> bool {
  if !alphaMap(map) {
    return left == right
  }
  let count = map[usize.ONE]
  if left >= count || right >= count {
    return false
  }
  let image = map[2 + left]
  if image == usize.MAX {
    return !isAssignedBetween(map, 2, 2 + count, right)
  }
  return image == right
}

fn projectionMap(map: &[usize]) -> bool {
  return map.length > usize.ZERO && map[usize.ZERO] == usize.MAX - 2
}

fn alphaLifetimeWith(first: &Lifetime, right: &Shared<Lifetime>, map: &[usize]) -> bool {
  return Shared.with<Lifetime, bool>(right, fn(second: &Lifetime) -> bool {
    if let Lifetime.Parameter {ordinal, ..} = &first.* {
      if let Lifetime.Parameter {ordinal: compared, ..} = &second.* {
        return binderCompatible(map, ordinal, compared)
      }
    }
    return false
  })
}

fn lifetimeIsParameter(value: &Lifetime) -> bool {
  return match & value.* {
    Lifetime.Parameter {..} => true
    _ => false
  }
}

fn lifetimeAddress(value: &Lifetime) -> usize {
  return Pointer.address<Lifetime>(Pointer.fromRef<Lifetime>(value))
}

fn sameAlphaLifetime(left: &Shared<Lifetime>, right: &Shared<Lifetime>, map: &[usize]) -> bool {
  if Shared.with<Lifetime, bool>(left, lifetimeIsParameter) {
    if Shared.with<Lifetime, usize>(left, lifetimeAddress) == Shared.with<Lifetime, usize>(right, lifetimeAddress) {
      return Shared.with<Lifetime, bool>(left, fn(value: &Lifetime) -> bool {
        if let Lifetime.Parameter {ordinal, ..} = &value.* {
          return binderCompatible(map, ordinal, ordinal)
        }
        return false
      })
    }
    return Shared.with<Lifetime, bool>(left, fn(first: &Lifetime) -> bool {
      return alphaLifetimeWith(first, right, map)
    })
  }
  return Lifetime.equalsShared(left, right)
}

effect fn sameShared(left: &Shared<Type>, right: &Shared<Type>) -> bool
! OutOfMemoryError
? &mut Allocator {
  let none = Vector.make<usize>()
  return run sameUnder(left, right, Vector.asSlice<usize>(&none))
}

// Both parts of a head must agree under the same binder map.
effect fn sameHeadUnder(
  leftContract: &Shared<Type>,
  leftProvider: &Shared<Type>,
  rightContract: &Shared<Type>,
  rightProvider: &Shared<Type>,
  map: &[usize],
) -> bool ! OutOfMemoryError ? &mut Allocator {
  if !run sameUnder(leftContract, rightContract, map) {
    return false
  }
  return run sameUnder(leftProvider, rightProvider, map)
}

// Binds `position` to `target` and searches the remaining binders. The slot stays assigned only
// when the whole search succeeds.
effect fn tryAssignHead(
  leftContract: &Shared<Type>,
  leftProvider: &Shared<Type>,
  rightContract: &Shared<Type>,
  rightProvider: &Shared<Type>,
  map: &mut Vector<usize>,
  position: usize,
  target: usize,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let slots = Vector.asMutSlice<usize>(&mut map.*)
  slots[2 + position] = target
  let mut assigned = run sameHeadUnder(leftContract, leftProvider, rightContract, rightProvider, Vector.asSlice<usize>(&map.*))
  if assigned {
    assigned = run assignHead(leftContract, leftProvider, rightContract, rightProvider, &mut map.*, position + usize.ONE)
  }
  if assigned {
    return true
  }
  let reset = Vector.asMutSlice<usize>(&mut map.*)
  reset[2 + position] = usize.MAX
  return false
}

// Search finite binder bijections against both parts of a head. A partial map can admit extra
// set pairings, but every completed map must satisfy all positions together.
effect fn assignHead(
  leftContract: &Shared<Type>,
  leftProvider: &Shared<Type>,
  rightContract: &Shared<Type>,
  rightProvider: &Shared<Type>,
  map: &mut Vector<usize>,
  position: usize,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let count = Vector.asSlice<usize>(&map.*)[usize.ONE]
  if position == count {
    return run sameHeadUnder(leftContract, leftProvider, rightContract, rightProvider, Vector.asSlice<usize>(&map.*))
  }
  let mut target = usize.ZERO
  while target < count {
    let taken = isAssignedBetween(Vector.asSlice<usize>(&map.*), 2, 2 + count, target)
    if !taken && run tryAssignHead(leftContract, leftProvider, rightContract, rightProvider, &mut map.*, position, target) {
      return true
    }
    target = target + usize.ONE
  }
  return false
}

// Two callable contracts are equal when some bijection between their invocation binders makes them
// equal. The search assigns binders in order and checks the partial renaming at each step, with
// unassigned binders matching any unused binder, so a structural mismatch prunes at once. The
// first check leaves every binder unassigned and rejects anything that differs apart from
// binders. With first-use numbering the identity is tried first. Exact symmetries can still make
// the search combinatorial.
effect fn sameUpToRenaming(left: &Shared<Type>, right: &Shared<Type>, count: usize, outer: &[usize]) -> bool
! OutOfMemoryError
? &mut Allocator {
  let mut map = Vector.make<usize>()
  let mut at = usize.ZERO
  while at < outer.length {
    run Vector.append<usize>(&mut map, outer[at])
    at = at + usize.ONE
  }
  let start = Vector.length<usize>(&map)
  at = usize.ZERO
  while at < count {
    run Vector.append<usize>(&mut map, usize.MAX)
    at = at + usize.ONE
  }
  if !run sameUnder(left, right, Vector.asSlice<usize>(&map)) {
    return false
  }
  return run assignFrom(left, right, &mut map, start)
}

effect fn assignFrom(
  left: &Shared<Type>,
  right: &Shared<Type>,
  map: &mut Vector<usize>,
  position: usize,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let count = Vector.length<usize>(&map.*)
  if position == count {
    return true
  }
  let start = alphaPrefix(Vector.asSlice<usize>(&map.*))
  let mut target = usize.ZERO
  while target < count - start {
    if !isAssignedBetween(Vector.asSlice<usize>(&map.*), start, count, target) {
      let slots = Vector.asMutSlice<usize>(&mut map.*)
      slots[position] = target
      if run sameUnder(left, right, Vector.asSlice<usize>(&map.*)) {
        if run assignFrom(left, right, &mut map.*, position + usize.ONE) {
          return true
        }
      }
      let reset = Vector.asMutSlice<usize>(&mut map.*)
      reset[position] = usize.MAX
    }
    target = target + usize.ONE
  }
  return false
}

// Structural comparison never holds a type while entering one of its children. Substitution can
// place one handle both as a node on one side and as a descendant on the other, as in
// `T | Box<T>` applied to `Box<i32>`, so each level compares its header under short borrows and
// recurses only after releasing them.
//
//
// `map` is empty for ordinary exact identity, a finite invocation-binder mapping for a quantified
// callable, or an impl-binder mapping with a separate invocation suffix for alpha identity.
// `usize.MAX` marks an unassigned binder. Quantifiers do not nest.
effect fn sameUnder(left: &Shared<Type>, right: &Shared<Type>, map: &[usize]) -> bool
! OutOfMemoryError
? &mut Allocator {
  if map.length == usize.ZERO || (alphaMap(map) && map.length == alphaPrefix(map)) {
    if map.length == usize.ZERO && Shared.with<Type, usize>(left, addressOf) == Shared.with<Type, usize>(right, addressOf) {
      return true
    }
    let binders = Shared.with<Type, usize>(left, invocationCount)
    if binders > usize.ZERO && binders == Shared.with<Type, usize>(right, invocationCount) {
      return run sameUpToRenaming(left, right, binders, map)
    }
  }
  let aliased = Shared.with<Type, usize>(left, addressOf) == Shared.with<Type, usize>(right, addressOf)
  let mut headers = false
  if aliased {
    headers = Shared.with<Type, bool>(left, fn(value: &Type) -> bool {
      return sameHead(value, value, map)
    })
  } else {
    headers = Shared.with<Type, bool>(left, fn(first: &Type) -> bool {
      return headWith(first, right, map)
    })
  }
  if !headers {
    return false
  }
  if !run sameApplicationStatics(left, right) { return false }
  let firstSchema = Shared.with<Type, Option<Shared<SectionSchema>>>(left, callableSchemaOf)
  if let Option<Shared<SectionSchema>>.Some {value: first} = move firstSchema {
    let secondSchema = Shared.with<Type, Option<Shared<SectionSchema>>>(right, callableSchemaOf)
    if let Option<Shared<SectionSchema>>.Some {value: second} = move secondSchema {
      if !run sameSchemaEvidence(&first, &second, map) { return false }
    } else { return false }
  }

  let count = Shared.with<Type, usize>(left, childCount)
  let mut at = usize.ZERO
  while at < count {
    let first = Shared.with<Type, Option<Shared<Type>>>(
      left,
      fn(value: &Type) -> Option<Shared<Type>> {
        return childAt(value, at)
      },
    )
    let second = Shared.with<Type, Option<Shared<Type>>>(
      right,
      fn(value: &Type) -> Option<Shared<Type>> {
        return childAt(value, at)
      },
    )
    if !run sameChild(&first, &second, map) {
      return false
    }
    at = at + usize.ONE
  }
  if !run sameArgumentRows(left, right, count, map) {
    return false
  }
  let members = Shared.with<Type, usize>(left, unionLength)
  if members != usize.MAX {
    if !run sameUnionMembers(left, right, members, map) {
      return false
    }
  }
  let firstRow = Shared.with<Type, Option<Shared<Row>>>(left, rowOf)
  let secondRow = Shared.with<Type, Option<Shared<Row>>>(right, rowOf)
  if let Option<Shared<Row>>.Some {value: fromRow} = move firstRow {
    if let Option<Shared<Row>>.Some {value: toRow} = move secondRow {
      return run sameRows(&fromRow, &toRow, map)
    }
    return false
  }
  return true
}

effect fn sameChild(left: &Option<Shared<Type>>, right: &Option<Shared<Type>>, map: &[usize]) -> bool
! OutOfMemoryError
? &mut Allocator {
  if let Option<Shared<Type>>.Some {value} = &left.* {
    if let Option<Shared<Type>>.Some {value: compared} = &right.* {
      return run sameUnder(&value, &compared, map)
    }
    return false
  }
  if let Option<Shared<Type>>.Some {value: _} = &right.* {
    return false
  }
  return true
}

fn memberOf(members: &Shared<Type>, at: usize) -> Option<Shared<Type>> {
  return Shared.with<Type, Option<Shared<Type>>>(
    members,
    fn(value: &Type) -> Option<Shared<Type>> {
      return unionMemberAt(value, at)
    },
  )
}

// Headers already matched the member counts; duplicate-free sets are equal by inclusion.
effect fn sameUnionMembers(left: &Shared<Type>, right: &Shared<Type>, count: usize, map: &[usize]) -> bool
! OutOfMemoryError
? &mut Allocator {
  let mut at = usize.ZERO
  while at < count {
    let member = memberOf(left, at)
    let mut found = false
    let mut other = usize.ZERO
    while !found && other < count {
      let candidate = memberOf(right, other)
      found = run sameChild(&member, &candidate, map)
      other = other + usize.ONE
    }
    if !found {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn headWith(first: &Type, right: &Shared<Type>, map: &[usize]) -> bool {
  return Shared.with<Type, bool>(
    right,
    fn(second: &Type) -> bool {
      return sameHead(first, second, map)
    },
  )
}

// The number of ordered child types compared by position: type arguments (a lifetime argument
// position has none), a borrow or array element, callable parameters then result, or an Effect's
// success then failure. Union members and Effect rows are compared separately as sets.
fn childCount(value: &Type) -> usize {
  return match & value.* {
    Type.Nominal {arguments, ..} => Vector.length<Argument>(&arguments)
    Type.OpaqueRepresentation {application, ..} => Shared.with<Application, usize>(&application, Application.typeCount) + usize.ONE
    Type.CallableWitnessResult {witness} => Shared.with<WitnessRecipe, usize>(&witness, CallableWitness.childCount)
    Type.CallableOrigin {application, ..} => Shared.with<Application, usize>(&application, Application.typeCount) + usize.ONE
    Type.Reference {..} => usize.ONE
    Type.Slice {..} => usize.ONE
    Type.ForeignFunction {..} => usize.ONE
    Type.Pointer {..} => usize.ONE
    Type.Array {..} => usize.ONE
    Type.Anonymous {members, ..} => Vector.length<Shared<Type>>(&members)
    Type.CallableValue {application, captures, ..} => Shared.with<Application, usize>(&application, Application.typeCount) + Vector.length<Shared<Type>>(&captures) + usize.ONE
    Type.CallableSchema {schema, captures, ..} => Shared.with<SectionSchema, usize>(&schema, CallableSchema.argumentCount) + Vector.length<Shared<Type>>(&captures)
    Type.CallableStage {captures, ..} => Vector.length<Shared<Type>>(&captures) + 2
    Type.CallableResult {arguments, selected, ..} => Vector.length<Shared<Type>>(&arguments) + Vector.length<Argument>(&selected) + 2
    Type.CallableView {..} => 2
    Type.EffectComposite {parts, ..} => Vector.length<Shared<Type>>(&parts) + 2
    Type.EffectJoin {alternatives, ..} => Vector.length<Shared<Type>>(&alternatives) + usize.ONE
    Type.Callable {parameters, ..} => Vector.length<Shared<Type>>(&parameters) + usize.ONE
    Type.Effect {..} => 2
    Type.TypeDescriptor {..} => usize.ONE
    Type.Without {..} => 2
    _ => usize.ZERO
  }
}

fn childAt(value: &Type, at: usize) -> Option<Shared<Type>> {
  return match & value.* {
    Type.CallableWitnessResult {witness} => Shared.with<WitnessRecipe, Option<Shared<Type>>>(&witness,
      fn(recipe: &WitnessRecipe) -> Option<Shared<Type>> { return CallableWitness.childAt(recipe, at) })
    Type.CallableResult {producer, contract, arguments, selected, ..} => {
      if at == usize.ZERO { return Option.some<Shared<Type>>(Shared.clone<Type>(&producer)) }
      if at == usize.ONE { return Option.some<Shared<Type>>(Shared.clone<Type>(&contract)) }
      let listed = Vector.asSlice<Shared<Type>>(&arguments)
      let index = at - 2
      if index < listed.length { return Option.some<Shared<Type>>(Shared.clone<Type>(&listed[index])) }
      let choices = Vector.asSlice<Argument>(&selected)
      return match &choices[index - listed.length] { Argument.Type {value: ty} => Option.some<Shared<Type>>(Shared.clone<Type>(&ty)) _ => Option.none<Shared<Type>>() }
    }
    Type.CallableView {representation, contract} => {
      if at == usize.ZERO { return Option.some<Shared<Type>>(Shared.clone<Type>(&representation)) }
      return Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
    }
    Type.Nominal {arguments, ..} => {
      let values = Vector.asSlice<Argument>(&arguments)
      return match & values[at] {
        Argument.Type {value: argument} => Option.some<Shared<Type>>(Shared.clone<Type>(&argument))
        _ => Option.none<Shared<Type>>()
      }
    }
    Type.CallableOrigin {application, contract} => {
      let count = Shared.with<Application, usize>(&application, Application.typeCount)
      if at == count { return Option.some<Shared<Type>>(Shared.clone<Type>(&contract)) }
      return Shared.with<Application, Option<Shared<Type>>>(&application,
        fn(value: &Application) -> Option<Shared<Type>> { return Application.typeAt(value, at) })
    }
    Type.OpaqueRepresentation {application, contract, ..} => {
      let count = Shared.with<Application, usize>(&application, Application.typeCount)
      if at == count { return Option.some<Shared<Type>>(Shared.clone<Type>(&contract)) }
      return Shared.with<Application, Option<Shared<Type>>>(&application,
        fn(value: &Application) -> Option<Shared<Type>> { return Application.typeAt(value, at) })
    }
    Type.Reference {referent, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&referent))
    Type.Slice {element, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&element))
    Type.ForeignFunction {signature, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&signature))
    Type.Pointer {pointee, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&pointee))
    Type.Array {element, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&element))
    Type.Anonymous {members, ..} => {
      let values = Vector.asSlice<Shared<Type>>(&members)
      return Option.some<Shared<Type>>(Shared.clone<Type>(&values[at]))
    }
    Type.CallableValue {application, captures, contract, fieldInputs, ..} => {
      let count = Shared.with<Application, usize>(&application, Application.typeCount)
      if at < count {
        return Shared.with<Application, Option<Shared<Type>>>(&application,
          fn(selected: &Application) -> Option<Shared<Type>> { return Application.typeAt(selected, at) })
      }
      if at == count { return Option.some<Shared<Type>>(Shared.clone<Type>(&contract)) }
      let field = at - count - usize.ONE
      // A represented capture is its application slot, already visited above.
      if representedCapture(Vector.asSlice<CallableFieldInput>(&fieldInputs), field) { return Option.none<Shared<Type>>() }
      let fields = Vector.asSlice<Shared<Type>>(&captures)
      return Option.some<Shared<Type>>(Shared.clone<Type>(&fields[field]))
    }
    Type.CallableSchema {schema, captures, ..} => {
      let count = Shared.with<SectionSchema, usize>(&schema, CallableSchema.argumentCount)
      if at < count {
        return match move schemaArgument(&schema, at) {
          Argument.Type {value: argument} => Option.some<Shared<Type>>(move argument)
          _ => Option.none<Shared<Type>>()
        }
      }
      let fields = Vector.asSlice<Shared<Type>>(&captures)
      return Option.some<Shared<Type>>(Shared.clone<Type>(&fields[at - count]))
    }
    Type.CallableStage {base, contract, captures, ..} => {
      if at == usize.ZERO { return Option.some<Shared<Type>>(Shared.clone<Type>(&base)) }
      if at == usize.ONE { return Option.some<Shared<Type>>(Shared.clone<Type>(&contract)) }
      let fields = Vector.asSlice<Shared<Type>>(&captures)
      return Option.some<Shared<Type>>(Shared.clone<Type>(&fields[at - 2]))
    }
    Type.EffectComposite {selector, contract, parts, ..} => {
      if at == usize.ZERO { return Option.some<Shared<Type>>(Shared.clone<Type>(&selector)) }
      if at == usize.ONE { return Option.some<Shared<Type>>(Shared.clone<Type>(&contract)) }
      let fields = Vector.asSlice<Shared<Type>>(&parts)
      return Option.some<Shared<Type>>(Shared.clone<Type>(&fields[at - 2]))
    }
    Type.EffectJoin {contract, alternatives} => {
      if at == usize.ZERO { return Option.some<Shared<Type>>(Shared.clone<Type>(&contract)) }
      let listed = Vector.asSlice<Shared<Type>>(&alternatives)
      return Option.some<Shared<Type>>(Shared.clone<Type>(&listed[at - usize.ONE]))
    }
    Type.Callable {parameters, result, ..} => {
      let values = Vector.asSlice<Shared<Type>>(&parameters)
      if at < values.length {
        return Option.some<Shared<Type>>(Shared.clone<Type>(&values[at]))
      }
      return Option.some<Shared<Type>>(Shared.clone<Type>(&result))
    }
    Type.Effect {success, failure, ..} => {
      if at == usize.ZERO {
        return Option.some<Shared<Type>>(Shared.clone<Type>(&success))
      }
      return Option.some<Shared<Type>>(Shared.clone<Type>(&failure))
    }
    Type.TypeDescriptor {owner} => Option.some<Shared<Type>>(Shared.clone<Type>(&owner))
    Type.Without {source, removed} => {
      if at == usize.ZERO { return Option.some<Shared<Type>>(Shared.clone<Type>(&source)) }
      return Option.some<Shared<Type>>(Shared.clone<Type>(&removed))
    }
    _ => Option.none<Shared<Type>>()
  }
}

fn rowOf(value: &Type) -> Option<Shared<Row>> {
  return match & value.* {
    Type.Effect {requirements, ..} => Option.some<Shared<Row>>(Shared.clone<Row>(&requirements))
    _ => Option.none<Shared<Row>>()
  }
}

fn sameArgumentHead(left: &Argument, right: &Argument, map: &[usize]) -> bool {
  return match & left.* {
    Argument.Type {..} => match & right.* {
      Argument.Type {..} => true
      _ => false
    }
    Argument.Lifetime {value} => match & right.* {
      Argument.Lifetime {value: compared} => sameLifetime(&value, &compared, map)
      _ => false
    }
    Argument.Row {..} => match & right.* {
      Argument.Row {..} => true
      _ => false
    }
  }
}

fn applicationArgument(value: &Shared<Application>, at: usize) -> Option<Argument> {
  return Shared.with<Application, Option<Argument>>(value, fn(selected: &Application) -> Option<Argument> {
    return Application.argumentAt(selected, at)
  })
}

// The application slot whose type a represented capture is; fieldless inputs have none.
fn representedSlot(inputs: &[CallableFieldInput], at: usize) -> Option<usize> {
  if at >= inputs.length { return Option.none<usize>() }
  return match &inputs[at] {
    CallableFieldInput.Represented {slot, ..} => Option.some<usize>(slot)
    _ => Option.none<usize>()
  }
}

fn representedCapture(inputs: &[CallableFieldInput], at: usize) -> bool {
  return match move representedSlot(inputs, at) { Option<usize>.Some {..} => true _ => false }
}

fn applicationAddress(value: &Application) -> usize {
  return Pointer.address<Application>(Pointer.fromRef<Application>(value))
}


fn applicationHeadValues(left: &Application, right: &Application, map: &[usize]) -> bool {
  if !Application.sameShape(left, right) { return false }
  let count = Application.argumentCount(left)
  let mut at = usize.ZERO
  while at < count {
    let first = Application.argumentAt(left, at)
    let second = Application.argumentAt(right, at)
    if let Option<Argument>.Some {value: argument} = &first {
      if let Option<Argument>.Some {value: compared} = &second {
        if !sameArgumentHead(&argument, &compared, map) { return false }
      } else { return false }
    } else { return false }
    at = at + usize.ONE
  }
  return true
}

fn applicationHeadWith(left: &Application, right: &Shared<Application>, map: &[usize]) -> bool {
  return Shared.with<Application, bool>(right, fn(other: &Application) -> bool {
    return applicationHeadValues(left, other, map)
  })
}

fn applicationHead(left: &Shared<Application>, right: &Shared<Application>, map: &[usize]) -> bool {
  let first = Shared.with<Application, usize>(left, applicationAddress)
  let second = Shared.with<Application, usize>(right, applicationAddress)
  if first == second {
    return Shared.with<Application, bool>(left, fn(value: &Application) -> bool {
      return applicationHeadValues(value, value, map)
    })
  }
  return Shared.with<Application, bool>(left, fn(value: &Application) -> bool {
    return applicationHeadWith(value, right, map)
  })
}

// Static payloads are semantic evidence too, compared after outer type borrows are released.
effect fn sameApplicationStatics(left: &Shared<Type>, right: &Shared<Type>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let first = Shared.with<Type, Option<Shared<Application>>>(left, proofApplication)
  if let Option<Shared<Application>>.Some {value: selected} = move first {
    let second = Shared.with<Type, Option<Shared<Application>>>(right, proofApplication)
    if let Option<Shared<Application>>.Some {value: compared} = move second {
      let firstValue = run Application.copyShared(&selected)
      let secondValue = run Application.copyShared(&compared)
      return run Application.staticEquals(&firstValue, &secondValue)
    }
    return false
  }
  return true
}

fn schemaArgument(value: &Shared<SectionSchema>, at: usize) -> Argument {
  return Shared.with<SectionSchema, Argument>(value, fn(schema: &SectionSchema) -> Argument {
    return CallableSchema.argumentAt(schema, at)
  })
}

fn schemaContract(value: &Shared<SectionSchema>) -> Shared<Type> {
  return Shared.with<SectionSchema, Shared<Type>>(value, fn(schema: &SectionSchema) -> Shared<Type> {
    return Shared.clone<Type>(&schema.contract)
  })
}

fn callableSchemaOf(value: &Type) -> Option<Shared<SectionSchema>> {
  return match &value.* {
    Type.CallableSchema {schema, ..} => Option.some<Shared<SectionSchema>>(Shared.clone<SectionSchema>(&schema))
    _ => Option.none<Shared<SectionSchema>>()
  }
}

// The cached schema bytes are only a runtime projection. Selected lifetimes and the bound
// contract's free validity still participate in exact semantic equality. Fetch each argument
// and contract under separate short borrows: copied types may share the same schema allocation.
effect fn sameSchemaEvidence(left: &Shared<SectionSchema>, right: &Shared<SectionSchema>, map: &[usize]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<SectionSchema, usize>(left, CallableSchema.argumentCount)
  if count != Shared.with<SectionSchema, usize>(right, CallableSchema.argumentCount) { return false }
  let mut at = usize.ZERO
  while at < count {
    let first = schemaArgument(left, at)
    let second = schemaArgument(right, at)
    if !sameArgumentHead(&first, &second, map) { return false }
    at = at + usize.ONE
  }
  let firstContract = schemaContract(left)
  let secondContract = schemaContract(right)
  return run sameSchemaContract(&firstContract, &secondContract, map)
}

// As in rewriteSchemaEnvironment, only the outer environment is free caller evidence. The
// remaining signature and invocation bounds are a bound target blueprint: a caller's impl
// alpha map must not rename its deferred target variables. Neutralize the already-compared
// outer environment, then use ordinary exact (or runtime-projection) contract comparison.
effect fn sameSchemaContract(left: &Shared<Type>, right: &Shared<Type>, map: &[usize]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let first = run nodeCopy(left)
  let second = run nodeCopy(right)
  if let Type.Callable {mode, isUnsafe, environment, invocationBinders, invocationUse, invocationBounds, parameters, result} = move first {
    if let Type.Callable {mode: otherMode, isUnsafe: otherUnsafe, environment: otherEnvironment,
      invocationBinders: otherBinders, invocationUse: otherUse, invocationBounds: otherBounds, parameters: otherParameters, result: otherResult} = move second {
      if !projectionMap(map) && !sameEnvironment(&environment, &otherEnvironment, map) { return false }
      let normalizedFirst = run Shared.make<Type>(Type.Callable {mode: mode, isUnsafe: isUnsafe,
        environment: Shared.clone<Intersection>(&otherEnvironment), invocationBinders: invocationBinders, invocationUse: invocationUse,
        invocationBounds: move invocationBounds, parameters: move parameters, result: move result})
      let normalizedSecond = run Shared.make<Type>(Type.Callable {mode: otherMode, isUnsafe: otherUnsafe,
        environment: move otherEnvironment, invocationBinders: otherBinders, invocationUse: otherUse,
        invocationBounds: move otherBounds, parameters: move otherParameters, result: move otherResult})
      let mut boundMap = Vector.make<usize>()
      if projectionMap(map) { run Vector.append<usize>(&mut boundMap, usize.MAX - 2) }
      return run sameUnder(&normalizedFirst, &normalizedSecond, Vector.asSlice<usize>(&boundMap))
    }
  }
  return false
}

fn argumentRowAt(value: &Type, at: usize) -> Option<Shared<Row>> {
  if let Type.CallableResult {..} = &value.* {
    if let Option<Argument>.Some {value: Argument.Row {value: row}} = move nodeArgument(value, at) { return Option.some<Shared<Row>>(move row) }
  }
  if let Type.CallableWitnessResult {..} = &value.* {
    if let Option<Argument>.Some {value: Argument.Row {value: row}} = move nodeArgument(value, at) { return Option.some<Shared<Row>>(move row) }
  }
  if let Type.CallableSchema {schema, ..} = &value.* {
    let count = Shared.with<SectionSchema, usize>(&schema, CallableSchema.argumentCount)
    if at < count {
      if let Argument.Row {value: argument} = move schemaArgument(&schema, at) { return Option.some<Shared<Row>>(move argument) }
    }
  }
  if let Type.CallableValue {application, ..} = &value.* {
    let selected = applicationArgument(&application, at)
    if let Option<Argument>.Some {value: Argument.Row {value: row}} = move selected {
      return Option.some<Shared<Row>>(move row)
    }
  }
  if let Type.Nominal {arguments, ..} = &value.* {
    let values = Vector.asSlice<Argument>(&arguments)
    if let Argument.Row {value: row} = &values[at] {
      return Option.some<Shared<Row>>(Shared.clone<Row>(&row))
    }
  }
  if let Type.CallableOrigin {application, ..} = &value.* {
    if let Option<Argument>.Some {value: Argument.Row {value: row}} = move applicationArgument(&application, at) {
      return Option.some<Shared<Row>>(move row)
    }
  }
  if let Type.OpaqueRepresentation {application, ..} = &value.* {
    if let Option<Argument>.Some {value: Argument.Row {value: row}} = move applicationArgument(&application, at) {
      return Option.some<Shared<Row>>(move row)
    }
  }
  return Option.none<Shared<Row>>()
}

fn argumentRowOf(value: &Shared<Type>, at: usize) -> Option<Shared<Row>> {
  return Shared.with<Type, Option<Shared<Row>>>(
    value,
    fn(found: &Type) -> Option<Shared<Row>> {
      return argumentRowAt(found, at)
    },
  )
}

// Row arguments are compared after the type borrows are released, like child types.
effect fn sameArgumentRows(left: &Shared<Type>, right: &Shared<Type>, count: usize, map: &[usize]) -> bool
! OutOfMemoryError
? &mut Allocator {
  let mut at = usize.ZERO
  while at < count {
    let first = argumentRowOf(left, at)
    if let Option<Shared<Row>>.Some {value: fromRow} = move first {
      let second = argumentRowOf(right, at)
      if let Option<Shared<Row>>.Some {value: toRow} = move second {
        if !run sameRows(&fromRow, &toRow, map) {
          return false
        }
      }
    }
    at = at + usize.ONE
  }
  return true
}

// Under a map, an assigned invocation binder on the left matches its image on the right, and an
// unassigned one matches any right binder that is not yet an image.
fn sameLifetime(left: &Shared<Lifetime>, right: &Shared<Lifetime>, map: &[usize]) -> bool {
  if projectionMap(map) { return true }
  let atomCount = Lifetime.atomCount(left)
  if atomCount > usize.ONE || Lifetime.atomCount(right) > usize.ONE {
    if atomCount != Lifetime.atomCount(right) { return false }
    let mut atomAt = usize.ZERO
    while atomAt < atomCount {
      let firstAtom = Lifetime.atomAt(left, atomAt)
      let mut found = false
      let mut comparedAt = usize.ZERO
      while !found && comparedAt < atomCount {
        let comparedAtom = Lifetime.atomAt(right, comparedAt)
        found = sameLifetime(&firstAtom, &comparedAtom, map)
        comparedAt = comparedAt + usize.ONE
      }
      if !found { return false }
      atomAt = atomAt + usize.ONE
    }
    return true
  }
  if map.length == usize.ZERO {
    return Lifetime.equalsShared(left, right)
  }
  let alpha = alphaMap(map)
  let ordinal = Shared.with<Lifetime, usize>(left, invocationOrdinal)
  let other = Shared.with<Lifetime, usize>(right, invocationOrdinal)
  if ordinal == usize.MAX {
    if other != usize.MAX {
      return false
    }
    if alpha {
      return sameAlphaLifetime(left, right, map)
    }
    return Lifetime.equalsShared(left, right)
  }
  if other == usize.MAX {
    return false
  }
  // Every invocation lifetime belongs to the one quantified contract whose map is active.
  let offset = alphaPrefix(map)
  if ordinal >= map.length - offset {
    return ordinal == other
  }
  if map[ordinal + offset] == usize.MAX {
    return !isAssignedBetween(map, offset, map.length, other)
  }
  return map[ordinal + offset] == other
}

fn hasMember(environment: &Shared<Intersection>, candidate: &Shared<Lifetime>, map: &[usize]) -> bool {
  let count = environmentSize(environment)
  let mut at = usize.ZERO
  while at < count {
    let member = environmentMember(environment, at)
    if let Option<Shared<Lifetime>>.Some {value} = move member {
      if sameLifetime(candidate, &value, map) {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Environments are sets of lifetimes. Members are fetched as handles, so no environment borrow is
// held while comparing them; lifetimes contain no types, so this is safe under type borrows.
fn sameEnvironment(left: &Shared<Intersection>, right: &Shared<Intersection>, map: &[usize]) -> bool {
  let count = environmentSize(left)
  if count != environmentSize(right) {
    return false
  }
  let mut at = usize.ZERO
  while at < count {
    let member = environmentMember(left, at)
    if let Option<Shared<Lifetime>>.Some {value} = move member {
      if !hasMember(right, &value, map) {
        return false
      }
    }
    at = at + usize.ONE
  }
  return true
}

fn sameBound(left: &Outlives, right: &Outlives, map: &[usize]) -> bool {
  return sameLifetime(&left.longer, &right.longer, map) && sameLifetime(
    &left.shorter,
    &right.shorter,
    map,
  )
}

// The marked `for<use ...>` binders of two contracts correspond under the active binder map,
// exactly as their invocation lifetimes would.
fn sameUse(left: usize, right: usize, map: &[usize]) -> bool {
  if left == usize.MAX || right == usize.MAX || map.length == usize.ZERO {
    return left == right
  }
  let offset = alphaPrefix(map)
  if left >= map.length - offset {
    return left == right
  }
  if map[left + offset] == usize.MAX {
    return !isAssignedBetween(map, offset, map.length, right)
  }
  return map[left + offset] == right
}

// Invocation bounds are a set. Lifetimes contain no types, so comparing them under type borrows
// cannot re-enter a type.
fn sameOutlives(left: &Vector<Outlives>, right: &Vector<Outlives>, map: &[usize]) -> bool {
  let first = Vector.asSlice<Outlives>(left)
  let second = Vector.asSlice<Outlives>(right)
  if first.length != second.length {
    return false
  }
  let mut at = usize.ZERO
  while at < first.length {
    let mut forward = false
    let mut backward = false
    let mut other = usize.ZERO
    while other < first.length {
      forward = forward || sameBound(&first[at], &second[other], map)
      backward = backward || sameBound(&first[other], &second[at], map)
      other = other + usize.ONE
    }
    if !forward || !backward {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameAlignment(left: &Option<u64>, right: &Option<u64>) -> bool {
  return match & left.* {
    Option<u64>.Some {value} => match & right.* {
      Option<u64>.Some {value: compared} => value == compared
      Option<u64>.None => false
    }
    Option<u64>.None => match & right.* {
      Option<u64>.Some {value: _} => false
      Option<u64>.None => true
    }
  }
}

fn hashTag(tag: u64) -> u64 {
  return Hash.mix(&Hash.seed(0), tag)
}

fn hashCount(hashed: u64, count: usize) -> u64 {
  return Hash.combine(hashed, usize.toU64(count))
}

fn hashFlag(hashed: u64, flag: bool) -> u64 {
  if flag {
    return Hash.combine(hashed, 1)
  }
  return Hash.combine(hashed, 0)
}

fn hashAccess(hashed: u64, access: Access) -> u64 {
  return match access {
    Access.Shared => Hash.combine(hashed, 0)
    Access.Mutable => Hash.combine(hashed, 1)
  }
}

fn hashArgumentKinds(hashed: u64, arguments: &Vector<Argument>) -> u64 {
  let listed = Vector.asSlice<Argument>(arguments)
  let mut folded = hashCount(hashed, listed.length)
  let mut at = usize.ZERO
  while at < listed.length {
    folded = hashCount(folded, argumentKind(&listed[at]))
    at = at + usize.ONE
  }
  return folded
}

// One level of the evidence `sameHead` compares under every binder map that reaches it.
fn hashHead(value: &Type) -> u64 {
  return match & value.* {
    Type.Primitive {name} => InternIndex.hashBytes(hashTag(1), Bytes.asSlice(&name))
    Type.ForeignFunction {behavior, ..} => Hash.combine(hashTag(26), ForeignContract.code(behavior))
    Type.Unit => hashTag(2)
    Type.Nominal {declaration, arguments, ..} => hashArgumentKinds(Hash.combine(hashTag(3), DeclarationId.hash(&declaration)), &arguments)
    Type.OpaqueRepresentation {detached, nonParking, ..} => hashFlag(hashFlag(hashTag(4), detached), nonParking)
    Type.Parameter {declaration, ordinal} => hashCount(Hash.combine(hashTag(5), DeclarationId.hash(&declaration)), ordinal)
    Type.String {..} => hashTag(6)
    Type.Reference {access, ..} => hashAccess(hashTag(7), access)
    Type.Slice {access, ..} => hashAccess(hashTag(8), access)
    Type.Pointer {access, nullable, ..} => hashFlag(hashAccess(hashTag(9), access), nullable)
    Type.Array {extent, ..} => InternIndex.hashBytes(hashTag(10), Bytes.asSlice(&extent))
    Type.Anonymous {members, ..} => hashCount(hashTag(11), Vector.length<Shared<Type>>(&members))
    Type.TypeDescriptor {..} => hashTag(12)
    Type.Union {members} => hashCount(hashTag(13), Vector.length<Shared<Type>>(&members))
    Type.CallableValue {captures, ..} => hashCount(hashTag(14), Vector.length<Shared<Type>>(&captures))
    Type.CallableSchema {captures, ..} => hashCount(hashTag(15), Vector.length<Shared<Type>>(&captures))
    Type.CallableStage {captures, remaining, ..} => hashCount(hashCount(hashTag(16), remaining), Vector.length<Shared<Type>>(&captures))
    Type.CallableResult {arguments, ..} => hashCount(hashTag(17), Vector.length<Shared<Type>>(&arguments))
    Type.CallableOrigin {..} => hashTag(18)
    Type.CallableWitnessResult {..} => hashTag(19)
    Type.CallableView {..} => hashTag(20)
    Type.Callable {isUnsafe, parameters, ..} => hashCount(hashFlag(hashTag(21), isUnsafe), Vector.length<Shared<Type>>(&parameters))
    Type.EffectComposite {parts, ..} => hashCount(hashTag(22), Vector.length<Shared<Type>>(&parts))
    Type.EffectJoin {alternatives, ..} => hashCount(hashTag(23), Vector.length<Shared<Type>>(&alternatives))
    Type.Effect {..} => hashTag(24)
    Type.Without {..} => hashTag(25)
  }
}

// The ordered children `sameUnder` compares under the caller's own binder map. A callable's
// children can compare under an invocation-binder renaming, so callables stop the descent.
fn hashedChildCount(value: &Type) -> usize {
  return match & value.* {
    Type.Nominal {arguments, ..} => Vector.length<Argument>(&arguments)
    Type.Reference {..} => usize.ONE
    Type.Slice {..} => usize.ONE
    Type.ForeignFunction {..} => usize.ONE
    Type.Pointer {..} => usize.ONE
    Type.Array {..} => usize.ONE
    Type.Anonymous {members, ..} => Vector.length<Shared<Type>>(&members)
    Type.TypeDescriptor {..} => usize.ONE
    Type.Without {..} => 2
    _ => usize.ZERO
  }
}

// Reads one level under a short borrow and enters each child only after releasing it.
fn hashUnder(value: &Shared<Type>, depth: usize) -> u64 {
  let mut hashed = Shared.with<Type, u64>(value, hashHead)
  if depth == usize.ZERO {
    return hashed
  }
  let count = Shared.with<Type, usize>(value, hashedChildCount)
  let mut at = usize.ZERO
  while at < count {
    let child = Shared.with<Type, Option<Shared<Type>>>(
      value,
      fn(node: &Type) -> Option<Shared<Type>> {
        return childAt(node, at)
      },
    )
    if let Option<Shared<Type>>.Some {value: nested} = move child {
      hashed = Hash.combine(hashed, hashUnder(&nested, depth - usize.ONE))
    }
    at = at + usize.ONE
  }
  return hashed
}

fn sameAccess(left: Access, right: Access) -> bool {
  return match left {
    Access.Shared => match right {
      Access.Shared => true
      Access.Mutable => false
    }
    Access.Mutable => match right {
      Access.Shared => false
      Access.Mutable => true
    }
  }
}

fn sameMode(left: CallableMode, right: CallableMode) -> bool {
  return match left {
    CallableMode.Shared => match right {
      CallableMode.Shared => true
      _ => false
    }
    CallableMode.Mutable => match right {
      CallableMode.Mutable => true
      _ => false
    }
    CallableMode.Once => match right {
      CallableMode.Once => true
      _ => false
    }
  }
}

fn sameMultiplicity(left: Multiplicity, right: Multiplicity) -> bool {
  return match left {
    Multiplicity.Single => match right {
      Multiplicity.Single => true
      Multiplicity.Many => false
    }
    Multiplicity.Many => match right {
      Multiplicity.Single => false
      Multiplicity.Many => true
    }
  }
}

fn unionLength(value: &Type) -> usize {
  return match & value.* {
    Type.Union {members} => Vector.length<Shared<Type>>(&members)
    _ => usize.MAX
  }
}

fn unionMemberAt(value: &Type, at: usize) -> Option<Shared<Type>> {
  if let Type.Union {members} = &value.* {
    let values = Vector.asSlice<Shared<Type>>(&members)
    return Option.some<Shared<Type>>(Shared.clone<Type>(&values[at]))
  }
  return Option.none<Shared<Type>>()
}

effect fn containsType(members: &[Shared<Type>], candidate: &Shared<Type>) -> bool
! OutOfMemoryError
? &mut Allocator {
  let mut at = usize.ZERO
  while at < members.length {
    if run sameShared(&members[at], candidate) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

effect fn sameRole(left: &Option<Shared<Type>>, right: &Option<Shared<Type>>, map: &[usize]) -> bool
! OutOfMemoryError
? &mut Allocator {
  return run sameChild(left, right, map)
}

effect fn sameKey(left: &Requirement, right: &Requirement, map: &[usize]) -> bool
! OutOfMemoryError
? &mut Allocator {
  if !run sameRole(&left.roleType, &right.roleType, map) {
    return false
  }
  return run sameUnder(&left.capability, &right.capability, map)
}

effect fn keyAt(entries: &[Requirement], candidate: &Requirement) -> usize
! OutOfMemoryError
? &mut Allocator {
  let none = Vector.make<usize>()
  let mut at = usize.ZERO
  while at < entries.length {
    if run sameKey(&entries[at], candidate, Vector.asSlice<usize>(&none)) {
      return at
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn declarationAddress(value: &DeclarationId) -> usize {
  return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(value))
}

fn declarationWith(first: &DeclarationId, right: &Shared<DeclarationId>) -> bool {
  return Shared.with<DeclarationId, bool>(
    right,
    fn(second: &DeclarationId) -> bool {
      return DeclarationId.equals(first, second)
    },
  )
}

fn sameDeclaration(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  if Shared.with<DeclarationId, usize>(left, declarationAddress) == Shared.with<
    DeclarationId,
    usize,
  >(right, declarationAddress) {
    return true
  }
  return Shared.with<DeclarationId, bool>(
    left,
    fn(first: &DeclarationId) -> bool {
      return declarationWith(first, right)
    },
  )
}

fn hasParameter(parameters: &[RowParameter], candidate: &RowParameter, map: &[usize]) -> bool {
  let mut at = usize.ZERO
  while at < parameters.length {
    let mut same = false
    if alphaMap(map) {
      same = binderCompatible(map, candidate.ordinal, parameters[at].ordinal)
    } else {
      same = parameters[at].ordinal == candidate.ordinal && sameDeclaration(&parameters[at].declaration, &candidate.declaration)
    }
    if same {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn rowHasParameter(row: &Row, candidate: &RowParameter) -> bool {
  let none = Vector.make<usize>()
  return hasParameter(Vector.asSlice<RowParameter>(&row.parameters), candidate, Vector.asSlice<usize>(&none))
}

fn sharedRowHasParameter(row: &Shared<Row>, candidate: &RowParameter) -> bool {
  return Shared.with<Row, bool>(
    row,
    fn(value: &Row) -> bool { return rowHasParameter(value, candidate) },
  )
}

fn rowAddress(value: &Row) -> usize {
  return Pointer.address<Row>(Pointer.fromRef<Row>(value))
}

fn rowHeadWith(first: &Row, right: &Shared<Row>, map: &[usize]) -> bool {
  return Shared.with<Row, bool>(
    right,
    fn(second: &Row) -> bool {
      return sameRowHead(first, second, map)
    },
  )
}

// Entry counts and row parameters; parameters hold no types, so they compare under the borrows.
fn sameRowHead(first: &Row, second: &Row, map: &[usize]) -> bool {
  let firstParameters = Vector.asSlice<RowParameter>(&first.parameters)
  let secondParameters = Vector.asSlice<RowParameter>(&second.parameters)
  if Vector.length<Requirement>(&first.entries) != Vector.length<Requirement>(&second.entries) || firstParameters.length != secondParameters.length || rowSubtractionCount(first) != rowSubtractionCount(second) {
    return false
  }
  let mut at = usize.ZERO
  while at < firstParameters.length {
    if !hasParameter(secondParameters, &firstParameters[at], map) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn entryCapability(row: &Row, at: usize) -> Shared<Type> {
  let entries = Vector.asSlice<Requirement>(&row.entries)
  return Shared.clone<Type>(&entries[at].capability)
}

fn entryRole(row: &Row, at: usize) -> Option<Shared<Type>> {
  let entries = Vector.asSlice<Requirement>(&row.entries)
  return match & entries[at].roleType {
    Option<Shared<Type>>.Some {value} => Option.some<Shared<Type>>(Shared.clone<Type>(&value))
    Option<Shared<Type>>.None => Option.none<Shared<Type>>()
  }
}

fn entryAccess(row: &Row, at: usize) -> Access {
  let entries = Vector.asSlice<Requirement>(&row.entries)
  return entries[at].access
}

fn entryAt(row: &Shared<Row>, at: usize) -> Requirement {
  return Requirement {
    capability: Shared.with<Row, Shared<Type>>(
      row,
      fn(value: &Row) -> Shared<Type> {
        return entryCapability(value, at)
      },
    ),
    roleType: Shared.with<Row, Option<Shared<Type>>>(
      row,
      fn(value: &Row) -> Option<Shared<Type>> {
        return entryRole(value, at)
      },
    ),
    access: Shared.with<Row, Access>(
      row,
      fn(value: &Row) -> Access {
        return entryAccess(value, at)
      },
    ),
  }
}

// Rows compare as sets of keys with equal access. Entry types are compared only after the row
// borrows are released, for the same reason as `sameShared`. A partial alpha map may let several
// candidates match one key; the completed binder bijection is checked again by `assignHead`,
// where normalized keys are distinct. No comparison here mutates a binder map or unifier binding.
effect fn sameRows(left: &Shared<Row>, right: &Shared<Row>, map: &[usize]) -> bool
! OutOfMemoryError
? &mut Allocator {
  if map.length == usize.ZERO && Shared.with<Row, usize>(left, rowAddress) == Shared.with<
    Row,
    usize,
  >(right, rowAddress) {
    return true
  }
  let aliased = Shared.with<Row, usize>(left, rowAddress) == Shared.with<Row, usize>(right, rowAddress)
  let mut headers = false
  if aliased {
    headers = Shared.with<Row, bool>(left, fn(value: &Row) -> bool {
      return sameRowHead(value, value, map)
    })
  } else {
    headers = Shared.with<Row, bool>(left, fn(first: &Row) -> bool {
      return rowHeadWith(first, right, map)
    })
  }
  if !headers {
    return false
  }
  let count = Shared.with<Row, usize>(
    left,
    fn(value: &Row) -> usize {
      return Vector.length<Requirement>(&value.entries)
    },
  )
  let mut at = usize.ZERO
  while at < count {
    let entry = entryAt(left, at)
    let mut matched = false
    let mut other = usize.ZERO
    while !matched && other < count {
      let candidate = entryAt(right, other)
      if sameAccess(entry.access, candidate.access) && run sameKey(&entry, &candidate, map) {
        matched = true
      }
      other = other + usize.ONE
    }
    if !matched {
      return false
    }
    at = at + usize.ONE
  }
  let terms = subtractionCount(left)
  at = usize.ZERO
  while at < terms {
    let term = subtractionAt(left, at)
    if !run hasSubtraction(right, &term, map) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn collectRow(row: &Shared<Row>, order: &mut Vector<usize>) -> ()
! OutOfMemoryError
? &mut Allocator {
  let entries = Shared.with<Row, usize>(
    row,
    fn(value: &Row) -> usize {
      return Vector.length<Requirement>(&value.entries)
    },
  )
  let mut at = usize.ZERO
  while at < entries {
    let entry = entryAt(row, at)
    run Type.collectInvocations(&entry.capability, &mut order.*)
    at = at + usize.ONE
  }
  let terms = subtractionCount(row)
  at = usize.ZERO
  while at < terms {
    let term = subtractionAt(row, at)
    run collectRow(&term.source, &mut order.*)
    run collectRow(&term.removed, &mut order.*)
    at = at + usize.ONE
  }
  return ()
}

impl Requirement {
  /// Copies one entry, sharing its key types.
  pub fn copy(entry: &Requirement) -> Requirement {
    let mut roleType = Option.none<Shared<Type>>()
    if let Option<Shared<Type>>.Some {value: named} = &entry.roleType {
      roleType = Option.some<Shared<Type>>(Shared.clone<Type>(&named))
    }
    return Requirement {
      capability: Shared.clone<Type>(&entry.capability),
      roleType: move roleType,
      access: entry.access,
    }
  }
  /// Whether two entries name one service-role key; access is not part of the key (SERV-004).
  pub effect fn keyEquals(left: &Requirement, right: &Requirement) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    let none = Vector.make<usize>()
    return run sameKey(left, right, Vector.asSlice<usize>(&none))
  }
}

impl Row {
  /// Copies the row's entries in normalized order; row parameters and subtractions are omitted.
  pub effect fn entryList(value: &Shared<Row>) -> Vector<Requirement>
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut entries = Vector.make<Requirement>()
    let count = Shared.with<Row, usize>(value, rowEntryCount)
    let mut at = usize.ZERO
    while at < count {
      run Vector.append<Requirement>(&mut entries, entryAt(value, at))
      at = at + usize.ONE
    }
    return move entries
  }
  /// Whether a row still contains a type or requirement-row parameter after lifetime erasure.
  pub fn hasOpenRuntimeParameters(value: &Shared<Row>) -> bool {
    return openRow(value, true)
  }
  /// Creates the empty row written by omitting `? R` or writing `? never`.
  pub fn empty() -> Row {
    return Row {
      entries: Vector.make<Requirement>(),
      parameters: Vector.make<RowParameter>(),
      subtractions: Vector.make<RowSubtraction>(),
    }
  }
  /// Adds one entry, keeping the strongest access when its service-role key is already present.
  pub effect fn require(self: &mut Self, requirement: Requirement) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let found = run keyAt(Vector.asSlice<Requirement>(&self.entries), &requirement)
    if found == usize.MAX {
      run Vector.append<Requirement>(&mut self.entries, move requirement)
      return ()
    }
    // Exclusive access is the stronger requirement for one key.
    if !sameAccess(requirement.access, Access.Shared) {
      let entries = Vector.asMutSlice<Requirement>(&mut self.entries)
      entries[found].access = Access.Mutable
    }
    return ()
  }
  /// Adds one row parameter unless the row already includes it.
  pub effect fn include(self: &mut Self, parameter: RowParameter) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let map = Vector.make<usize>()
    if !hasParameter(Vector.asSlice<RowParameter>(&self.parameters), &parameter, Vector.asSlice<usize>(&map)) {
      run Vector.append<RowParameter>(&mut self.parameters, move parameter)
    }
    return ()
  }
  /// Adds every entry and row parameter of `other`, as when a bound `?R` is substituted.
  pub effect fn merge(self: &mut Self, other: &Shared<Row>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let entries = Shared.with<Row, usize>(
      other,
      fn(value: &Row) -> usize {
        return Vector.length<Requirement>(&value.entries)
      },
    )
    let mut at = usize.ZERO
    while at < entries {
      run Row.require(&mut self.*, entryAt(other, at))
      at = at + usize.ONE
    }
    let parameters = Shared.with<Row, usize>(
      other,
      fn(value: &Row) -> usize {
        return Vector.length<RowParameter>(&value.parameters)
      },
    )
    at = usize.ZERO
    while at < parameters {
      let parameter = Shared.with<Row, RowParameter>(
        other,
        fn(value: &Row) -> RowParameter {
          let values = Vector.asSlice<RowParameter>(&value.parameters)
          return RowParameter {
            declaration: Shared.clone<DeclarationId>(&values[at].declaration),
            ordinal: values[at].ordinal,
          }
        },
      )
      run Row.include(&mut self.*, move parameter)
      at = at + usize.ONE
    }
    let terms = subtractionCount(other)
    at = usize.ZERO
    while at < terms {
      run appendSubtraction(&mut self.*, subtractionAt(other, at))
      at = at + usize.ONE
    }
    return ()
  }
  /// Adds `source` with every entry whose service-role key `removed` names taken out (SERV-008).
  ///
  /// # Details
  ///
  /// Matching ignores access, so the complete entry is removed, and an absent key is a no-op.
  /// Entries whose removal is already decided normalize immediately. What still depends on a row
  /// or type parameter is kept as one [`RowSubtraction`] term; a nested term folds its removed keys
  /// into the outer ones. Substitution through [`Row.applyBindings`] re-normalizes each term.
  pub effect fn subtract(self: &mut Self, source: &Shared<Row>, removed: &Shared<Row>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let keyCount = Shared.with<Row, usize>(removed, rowEntryCount)
    let keysOpen = Shared.with<Row, usize>(removed, rowParameterCount) != usize.ZERO || subtractionCount(removed) != usize.ZERO
    if keyCount == usize.ZERO && !keysOpen {
      run Row.merge(&mut self.*, source)
      return ()
    }
    let none = Vector.make<usize>()
    if run sameRows(source, removed, Vector.asSlice<usize>(&none)) {
      return ()
    }
    let mut residual = Row.empty()
    let entries = Shared.with<Row, usize>(source, rowEntryCount)
    let mut at = usize.ZERO
    while at < entries {
      let entry = entryAt(source, at)
      let mut fate = Subtraction.start(keysOpen)
      let mut key = usize.ZERO
      while fate != Fate.Removed && key < keyCount {
        let candidate = entryAt(removed, key)
        fate = Subtraction.decide(fate, run keyRelation(&entry, &candidate))
        key = key + usize.ONE
      }
      if fate == Fate.Deferred {
        run Row.require(&mut residual, move entry)
      } else if fate == Fate.Kept {
        run Row.require(&mut self.*, move entry)
      }
      at = at + usize.ONE
    }
    let parameters = Shared.with<Row, usize>(source, rowParameterCount)
    at = usize.ZERO
    while at < parameters {
      let parameter = Shared.with<Row, RowParameter>(
        source,
        fn(value: &Row) -> RowParameter {
          return rowParameterAt(value, at)
        },
      )
      run Row.include(&mut residual, move parameter)
      at = at + usize.ONE
    }
    let terms = subtractionCount(source)
    at = usize.ZERO
    while at < terms {
      let term = subtractionAt(source, at)
      let mut keys = Row.empty()
      run Row.merge(&mut keys, &term.removed)
      run Row.merge(&mut keys, removed)
      let combined = run Shared.make<Row>(move keys)
      run Row.subtract(&mut self.*, &term.source, &combined)
      at = at + usize.ONE
    }
    if Vector.length<Requirement>(&residual.entries) != usize.ZERO || Vector.length<RowParameter>(&residual.parameters) != usize.ZERO {
      let keys = run termKeys(removed, &residual)
      let undecided = run Shared.make<Row>(move residual)
      run appendSubtraction(&mut self.*, RowSubtraction {source: move undecided, removed: move keys})
    }
    return ()
  }
  /// Reports whether two shared rows have the same keys, accesses, and row parameters.
  pub effect fn equalsShared(left: &Shared<Row>, right: &Shared<Row>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    let none = Vector.make<usize>()
    return run sameRows(left, right, Vector.asSlice<usize>(&none))
  }
  /// Compares normalized rows after erasing lifetimes inside their service-role keys.
  pub effect fn runtimeEqualsShared(left: &Shared<Row>, right: &Shared<Row>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut projection = Vector.make<usize>()
    run Vector.append<usize>(&mut projection, usize.MAX - 2)
    return run sameRows(left, right, Vector.asSlice<usize>(&projection))
  }
  /// Reports how a narrower `witness` row fits within a `promised` upper bound, first by entry and
  /// then by row parameter.
  ///
  /// # Details
  ///
  /// Each witness entry needs a promised entry with the same service-role key whose access is at
  /// least as strong, and each witness row parameter must itself be promised. Nothing is solved: a
  /// promised row parameter is an unknown row, so it covers no entry the witness names.
  pub effect fn covers(promised: &Shared<Row>, witness: &Shared<Row>) -> RowCoverage
  ! OutOfMemoryError
  ? &mut Allocator {
    let none = Vector.make<usize>()
    let map = Vector.asSlice<usize>(&none)
    let entries = Shared.with<Row, usize>(
      witness,
      fn(value: &Row) -> usize {
        return Vector.length<Requirement>(&value.entries)
      },
    )
    let available = Shared.with<Row, usize>(
      promised,
      fn(value: &Row) -> usize {
        return Vector.length<Requirement>(&value.entries)
      },
    )
    let mut at = usize.ZERO
    while at < entries {
      let entry = entryAt(witness, at)
      let mut other = usize.ZERO
      let mut found = false
      while !found && other < available {
        let candidate = entryAt(promised, other)
        if run sameKey(&entry, &candidate, map) {
          if !sameAccess(entry.access, Access.Shared) && sameAccess(candidate.access, Access.Shared) {
            return RowCoverage.Access
          }
          found = true
        }
        other = other + usize.ONE
      }
      if !found {
        return RowCoverage.Entry
      }
      at = at + usize.ONE
    }
    let parameters = Shared.with<Row, usize>(
      witness,
      fn(value: &Row) -> usize {
        return Vector.length<RowParameter>(&value.parameters)
      },
    )
    at = usize.ZERO
    while at < parameters {
      let promisedParameter = Shared.with<Row, bool>(
        witness,
        fn(value: &Row) -> bool {
          let values = Vector.asSlice<RowParameter>(&value.parameters)
          return sharedRowHasParameter(promised, &values[at])
        },
      )
      if !promisedParameter {
        return RowCoverage.Parameter
      }
      at = at + usize.ONE
    }
    // A subtraction only removes keys: an equal promised term or its source bounds it.
    let terms = subtractionCount(witness)
    at = usize.ZERO
    while at < terms {
      let term = subtractionAt(witness, at)
      if !run hasSubtraction(promised, &term, map) {
        let bound = run Row.covers(promised, &term.source)
        if bound != RowCoverage.Covered {
          return RowCoverage.Parameter
        }
      }
      at = at + usize.ONE
    }
    return RowCoverage.Covered
  }
}

/// How a narrower requirement row fits within a promised upper bound.
pub enum RowCoverage {
  /// Every entry and row parameter is promised with sufficient access.
  Covered,
  /// An entry's service-role key is not promised.
  Entry,
  /// An entry requires exclusive access where the promised entry grants only shared access.
  Access,
  /// A row parameter or an unresolved subtraction term is not promised.
  Parameter,
}

// A failure type's members: a structural union's members, none for `never`, otherwise itself.
fn failureCount(value: &Type) -> usize {
  let members = unionLength(value)
  if members == usize.MAX {
    return usize.ONE
  }
  return members
}

struct WithoutParts {
  source: Shared<Type>
  removed: Shared<Type>
}

fn withoutParts(value: &Type) -> Option<WithoutParts> {
  return match & value.* {
    Type.Without {source, removed} => Option.some<WithoutParts>(
      WithoutParts {source: Shared.clone<Type>(&source), removed: Shared.clone<Type>(&removed)})
    _ => Option.none<WithoutParts>()
  }
}

// The canonical union of already joined members: `never` when empty, the member when single.
effect fn joinedMembers(members: Vector<Shared<Type>>) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  if Vector.length<Shared<Type>>(&members) == usize.ONE {
    let single = Vector.asSlice<Shared<Type>>(&members)
    return Shared.clone<Type>(&single[usize.ZERO])
  }
  return run Shared.make<Type>(Type.Union {members: move members})
}

fn failureMember(value: &Shared<Type>, at: usize) -> Shared<Type> {
  let member = memberOf(value, at)
  if let Option<Shared<Type>>.Some {value: found} = move member {
    return move found
  }
  return Shared.clone<Type>(value)
}

// `usize.MAX` for unknown stored contents, `usize.ONE` when child types are stored contents, and
// zero when only the node's own lifetimes are retained.
fn retentionKind(value: &Type) -> usize {
  return match & value.* {
    Type.Parameter {..} => usize.MAX
    Type.Nominal {..} => usize.ONE
    Type.Array {..} => usize.ONE
    Type.Anonymous {..} => usize.ONE
    _ => usize.ZERO
  }
}

fn isStaticLifetime(value: &Lifetime) -> bool {
  return match & value.* {
    Lifetime.Static => true
    _ => false
  }
}

effect fn appendOrdinal(order: &mut Vector<usize>, ordinal: usize) -> ()
! OutOfMemoryError
? &mut Allocator {
  let seen = Vector.asSlice<usize>(&order.*)
  let mut at = usize.ZERO
  while at < seen.length {
    if seen[at] == ordinal {
      return ()
    }
    at = at + usize.ONE
  }
  run Vector.append<usize>(&mut order.*, ordinal)
  return ()
}

fn ownedLifetimeOrdinal(value: &Lifetime, owner: &DeclarationId) -> usize {
  if let Lifetime.Parameter {declaration, ordinal} = &value.* {
    if DeclarationId.equals(&declaration, owner) {
      return ordinal
    }
  }
  return usize.MAX
}

fn ownedRowOrdinal(row: &Row, at: usize, owner: &DeclarationId) -> usize {
  let parameters = Vector.asSlice<RowParameter>(&row.parameters)
  if Shared.with<DeclarationId, bool>(
    &parameters[at].declaration,
    fn(declaration: &DeclarationId) -> bool {
      return DeclarationId.equals(declaration, owner)
    },
  ) {
    return parameters[at].ordinal
  }
  return usize.MAX
}

fn invocationOrdinal(value: &Lifetime) -> usize {
  return match & value.* {
    Lifetime.Invocation {ordinal} => ordinal
    _ => usize.MAX
  }
}

fn environmentMember(environment: &Shared<Intersection>, at: usize) -> Option<Shared<Lifetime>> {
  return Shared.with<Intersection, Option<Shared<Lifetime>>>(
    environment,
    fn(found: &Intersection) -> Option<Shared<Lifetime>> {
      let members = Vector.asSlice<Member>(&found.members)
      if at < members.length {
        return Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&members[at].region))
      }
      return Option.none<Shared<Lifetime>>()
    },
  )
}

fn environmentSize(environment: &Shared<Intersection>) -> usize {
  return Shared.with<Intersection, usize>(
    environment,
    fn(found: &Intersection) -> usize {
      return Vector.length<Member>(&found.members)
    },
  )
}

// The lifetimes written directly on one node, in structural order.
fn ownLifetimeCount(value: &Type) -> usize {
  return match & value.* {
    Type.String {..} => usize.ONE
    Type.Reference {..} => usize.ONE
    Type.Slice {..} => usize.ONE
    Type.Nominal {arguments, ..} => Vector.length<Argument>(&arguments)
    Type.OpaqueRepresentation {application, ..} => Shared.with<Application, usize>(&application, Application.argumentCount)
    Type.CallableOrigin {application, ..} => Shared.with<Application, usize>(&application, Application.argumentCount)
    Type.CallableValue {application, ..} => Shared.with<Application, usize>(&application, Application.argumentCount)
    Type.CallableSchema {schema, ..} => Shared.with<SectionSchema, usize>(&schema, CallableSchema.argumentCount)
      + Shared.with<Type, usize>(&schemaContract(&schema), ownLifetimeCount)
    Type.CallableWitnessResult {witness} => Shared.with<WitnessRecipe, usize>(&witness,
      fn(recipe: &WitnessRecipe) -> usize { return CallableWitness.bindingCount(recipe) + CallableWitness.loanCount(recipe) })
    Type.CallableResult {selected, ..} => Vector.length<Argument>(&selected)
    Type.Callable {environment, ..} => environmentSize(&environment)
    Type.Effect {environment, ..} => environmentSize(&environment)
    _ => usize.ZERO
  }
}

fn ownLifetimeAt(value: &Type, at: usize) -> Option<Shared<Lifetime>> {
  return match & value.* {
    Type.String {lifetime} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
    Type.Reference {lifetime, ..} => Option.some<Shared<Lifetime>>(
      Shared.clone<Lifetime>(&lifetime),
    )
    Type.Slice {lifetime, ..} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
    Type.Nominal {arguments, ..} => {
      let values = Vector.asSlice<Argument>(&arguments)
      return match & values[at] {
        Argument.Lifetime {value: lifetime} => Option.some<Shared<Lifetime>>(
          Shared.clone<Lifetime>(&lifetime),
        )
        _ => Option.none<Shared<Lifetime>>()
      }
    }
    Type.CallableOrigin {application, ..} => {
      if let Option<Argument>.Some {value: Argument.Lifetime {value: lifetime}} = move applicationArgument(&application, at) {
        return Option.some<Shared<Lifetime>>(move lifetime)
      }
      return Option.none<Shared<Lifetime>>()
    }
    Type.OpaqueRepresentation {application, ..} => {
      if let Option<Argument>.Some {value: Argument.Lifetime {value: lifetime}} = move applicationArgument(&application, at) {
        return Option.some<Shared<Lifetime>>(move lifetime)
      }
      return Option.none<Shared<Lifetime>>()
    }
    Type.CallableValue {application, ..} => {
      let selected = applicationArgument(&application, at)
      if let Option<Argument>.Some {value: Argument.Lifetime {value: lifetime}} = move selected {
        return Option.some<Shared<Lifetime>>(move lifetime)
      }
      return Option.none<Shared<Lifetime>>()
    }
    Type.CallableSchema {schema, ..} => {
      let count = Shared.with<SectionSchema, usize>(&schema, CallableSchema.argumentCount)
      if at < count {
        return match move schemaArgument(&schema, at) {
          Argument.Lifetime {value: argument} => Option.some<Shared<Lifetime>>(move argument)
          _ => Option.none<Shared<Lifetime>>()
        }
      }
      return Shared.with<Type, Option<Shared<Lifetime>>>(&schemaContract(&schema),
        fn(contract: &Type) -> Option<Shared<Lifetime>> { return ownLifetimeAt(contract, at - count) })
    }
    Type.CallableWitnessResult {witness} => {
      let recipe = Shared.with<WitnessRecipe, WitnessRecipe>(&witness, CallableWitness.copy)
      let count = CallableWitness.bindingCount(&recipe)
      if at < count {
        let choice = CallableWitness.bindingAt(&recipe, at)
        if let Argument.Lifetime {value: region} = move choice.value { return Option.some<Shared<Lifetime>>(move region) }
        return Option.none<Shared<Lifetime>>()
      }
      return CallableWitness.loanAt(&recipe, at - count)
    }
    Type.CallableResult {selected, ..} => {
      let values = Vector.asSlice<Argument>(&selected)
      return match &values[at] {
        Argument.Lifetime {value: lifetime} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
        _ => Option.none<Shared<Lifetime>>()
      }
    }
    Type.Callable {environment, ..} => environmentMember(&environment, at)
    Type.Effect {environment, ..} => environmentMember(&environment, at)
    _ => Option.none<Shared<Lifetime>>()
  }
}

// Callable outlives bounds are part of semantic comparison, but they are not captured by a
// callable value. Keep them separate from `ownLifetimeCount/At`, which retention also uses.
fn boundLifetimeCount(value: &Type) -> usize {
  return match & value.* {
    Type.Callable {invocationBounds, ..} => Vector.length<Outlives>(&invocationBounds) + Vector.length<Outlives>(&invocationBounds)
    _ => usize.ZERO
  }
}

fn boundLifetimeAt(value: &Type, at: usize) -> Option<Shared<Lifetime>> {
  return match & value.* {
    Type.Callable {invocationBounds, ..} => {
      let bounds = Vector.asSlice<Outlives>(&invocationBounds)
      let mut index = usize.ZERO
      let mut bound = usize.ZERO
      while bound < bounds.length {
        if at == index {
          return Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&bounds[bound].longer))
        }
        index = index + usize.ONE
        if at == index {
          return Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&bounds[bound].shorter))
        }
        index = index + usize.ONE
        bound = bound + usize.ONE
      }
      return Option.none<Shared<Lifetime>>()
    }
    _ => Option.none<Shared<Lifetime>>()
  }
}

fn comparedLifetimeCount(value: &Type) -> usize {
  return ownLifetimeCount(value) + boundLifetimeCount(value)
}

fn comparedLifetimeAt(value: &Type, at: usize) -> Option<Shared<Lifetime>> {
  let own = ownLifetimeCount(value)
  if at < own {
    return ownLifetimeAt(value, at)
  }
  return boundLifetimeAt(value, at - own)
}

fn openLifetime(value: &Lifetime) -> bool {
  return match & value.* {
    Lifetime.Parameter {..} => true
    _ => false
  }
}

fn openRow(value: &Shared<Row>, runtime: bool) -> bool {
  let parameters = Shared.with<Row, usize>(value, fn(row: &Row) -> usize {
    return Vector.length<RowParameter>(&row.parameters)
  })
  // An unresolved subtraction always still depends on a parameter.
  if parameters != usize.ZERO || subtractionCount(value) != usize.ZERO {
    return true
  }
  let entries = Shared.with<Row, usize>(value, fn(row: &Row) -> usize {
    return Vector.length<Requirement>(&row.entries)
  })
  let mut at = usize.ZERO
  while at < entries {
    let capability = Shared.with<Row, Shared<Type>>(value, fn(row: &Row) -> Shared<Type> {
      let listed = Vector.asSlice<Requirement>(&row.entries)
      return Shared.clone<Type>(&listed[at].capability)
    })
    if openType(&capability, runtime) {
      return true
    }
    let roleType = Shared.with<Row, Option<Shared<Type>>>(value, fn(row: &Row) -> Option<Shared<Type>> {
      let listed = Vector.asSlice<Requirement>(&row.entries)
      if let Option<Shared<Type>>.Some {value: named} = &listed[at].roleType {
        return Option.some<Shared<Type>>(Shared.clone<Type>(&named))
      }
      return Option.none<Shared<Type>>()
    })
    if let Option<Shared<Type>>.Some {value: named} = move roleType {
      if openType(&named, runtime) {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

impl Row {
  /// Whether a requirement capability, role or retained subtraction mentions a phase-only type.
  pub fn mentionsPhaseOnly(value: &Shared<Row>) -> bool {
    let entries = Shared.with<Row, usize>(value, fn(row: &Row) -> usize {
      return Vector.length<Requirement>(&row.entries)
    })
    let mut at = usize.ZERO
    while at < entries {
      let capability = Shared.with<Row, Shared<Type>>(value, fn(row: &Row) -> Shared<Type> {
        let listed = Vector.asSlice<Requirement>(&row.entries)
        return Shared.clone<Type>(&listed[at].capability)
      })
      if Type.mentionsPhaseOnly(&capability) { return true }
      let namedRole = Shared.with<Row, Option<Shared<Type>>>(value, fn(row: &Row) -> Option<Shared<Type>> {
        let listed = Vector.asSlice<Requirement>(&row.entries)
        if let Option<Shared<Type>>.Some {value: named} = &listed[at].roleType {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&named))
        }
        return Option.none<Shared<Type>>()
      })
      if let Option<Shared<Type>>.Some {value: named} = move namedRole {
        if Type.mentionsPhaseOnly(&named) { return true }
      }
      at = at + usize.ONE
    }
    let subtractions = Shared.with<Row, usize>(value, fn(row: &Row) -> usize {
      return Vector.length<RowSubtraction>(&row.subtractions)
    })
    at = usize.ZERO
    while at < subtractions {
      let source = Shared.with<Row, Shared<Row>>(value, fn(row: &Row) -> Shared<Row> {
        let listed = Vector.asSlice<RowSubtraction>(&row.subtractions)
        return Shared.clone<Row>(&listed[at].source)
      })
      let removed = Shared.with<Row, Shared<Row>>(value, fn(row: &Row) -> Shared<Row> {
        let listed = Vector.asSlice<RowSubtraction>(&row.subtractions)
        return Shared.clone<Row>(&listed[at].removed)
      })
      if Row.mentionsPhaseOnly(&source) || Row.mentionsPhaseOnly(&removed) { return true }
      at = at + usize.ONE
    }
    return false
  }
}

fn openType(value: &Shared<Type>, runtime: bool) -> bool {
  let direct = Shared.with<Type, bool>(value, fn(node: &Type) -> bool {
    return match & node.* {
      Type.Parameter {..} => true
      _ => false
    }
  })
  if direct {
    return true
  }
  let target = Shared.with<Type, Option<Shared<Application>>>(value, proofApplication)
  if let Option<Shared<Application>>.Some {value: application} = move target {
    if !Shared.with<Application, bool>(&application, Application.isRuntimeClosed) { return true }
  }
  let mut lifetimes = usize.ZERO
  if !runtime {
    lifetimes = Shared.with<Type, usize>(value, comparedLifetimeCount)
  }
  let mut at = usize.ZERO
  while at < lifetimes {
    let found = Shared.with<Type, Option<Shared<Lifetime>>>(value, fn(node: &Type) -> Option<Shared<Lifetime>> {
      return comparedLifetimeAt(node, at)
    })
    if let Option<Shared<Lifetime>>.Some {value: region} = move found {
      if Lifetime.anyAtom(&region, openLifetime) {
        return true
      }
    }
    at = at + usize.ONE
  }
  let children = Shared.with<Type, usize>(value, childCount)
  at = usize.ZERO
  while at < children {
    let found = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
      return childAt(node, at)
    })
    if let Option<Shared<Type>>.Some {value: nested} = move found {
      if openType(&nested, runtime) {
        return true
      }
    }
    let row = argumentRowOf(value, at)
    if let Option<Shared<Row>>.Some {value: supplied} = move row {
      if openRow(&supplied, runtime) {
        return true
      }
    }
    at = at + usize.ONE
  }
  let members = Shared.with<Type, usize>(value, unionLength)
  if members != usize.MAX {
    at = usize.ZERO
    while at < members {
      let found = memberOf(value, at)
      if let Option<Shared<Type>>.Some {value: nested} = move found {
        if openType(&nested, runtime) {
          return true
        }
      }
      at = at + usize.ONE
    }
  }
  let requirements = Shared.with<Type, Option<Shared<Row>>>(value, rowOf)
  if let Option<Shared<Row>>.Some {value: row} = move requirements {
    return openRow(&row, runtime)
  }
  return false
}

// The single fallibility test both ABI sides use: a union whose members are all uninhabited.
fn uninhabited(value: &Type) -> bool {
  if let Type.Union {members} = &value.* {
    let listed = Vector.asSlice<Shared<Type>>(&members)
    let mut at = usize.ZERO
    while at < listed.length {
      if !Shared.with<Type, bool>(&listed[at], uninhabited) { return false }
      at = at + usize.ONE
    }
    return true
  }
  return false
}

impl Type {
  /// Whether no value inhabits the type: `never`, or a union of only uninhabited members. A
  /// failure type is fallible exactly when it is not uninhabited (Effect note D3).
  pub fn isNever(value: &Type) -> bool {
    return uninhabited(value)
  }
  /// Reads the canonical decimal extent without truncating an unrepresentable length.
  pub fn extentValue(digits: &[u8]) -> Option<usize> {
    if digits.length == usize.ZERO { return Option.none<usize>() }
    let mut length = usize.ZERO
    let mut at = usize.ZERO
    while at < digits.length {
      if digits[at] < 48 || digits[at] > 57 { return Option.none<usize>() }
      let digit = u8.toUsize(digits[at]) - 48
      if length > (usize.MAX - digit) / 10 { return Option.none<usize>() }
      length = length * 10 + digit
      at = at + usize.ONE
    }
    return Option.some<usize>(length)
  }

  /// Writes the canonical decimal extent for a closed logical length.
  pub effect fn extentText(count: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut reversed = Bytes.make()
    let mut remaining = count
    if remaining == usize.ZERO { return run Bytes.copy(b"0") }
    while remaining > usize.ZERO {
      let digit = [usize.toU8(48 + usize.remainder(remaining, 10))]
      run Bytes.append(&mut reversed, &digit)
      remaining = remaining / 10
    }
    let digits = Bytes.asSlice(&reversed)
    let mut extent = Bytes.make()
    let mut at = digits.length
    while at > usize.ZERO {
      at = at - usize.ONE
      run Bytes.append(&mut extent, &[digits[at]])
    }
    return move extent
  }

  /// Reads one fixed array's element and representable logical length.
  pub fn arrayShape(ty: &Shared<Type>) -> Option<ArrayShape> {
    return Shared.with<Type, Option<ArrayShape>>(ty, fn(value: &Type) -> Option<ArrayShape> {
      if let Type.Array {element, extent} = &value.* {
        if let Option<usize>.Some {value: length} = move Type.extentValue(Bytes.asSlice(&extent)) {
          return Option.some<ArrayShape>(ArrayShape {element: Shared.clone<Type>(&element), length: length})
        }
      }
      return Option.none<ArrayShape>()
    })
  }


  /// The original declaration anchoring cleanup identity. Union children select the least
  /// declaration record, independent of region names and runtime member traversal order.
  /// A bounded caller shares its complete record-production/comparison transaction here.
  pub effect fn glueOwner(value: &Shared<Type>, coordinates: &mut Coordinates) -> Option<DeclarationId> ! OutOfMemoryError ? &mut Allocator {
    if coordinates.exceeded { return Option.none<DeclarationId>() }
    let affordable = Shared.with<Type, bool>(value, fn(node: &Type) -> bool {
      return RuntimeEncoding.recordPayload(&mut coordinates.*, nodePayload(node))
    })
    if !affordable { return Option.none<DeclarationId>() }
    let node = run nodeCopy(value)
    return match &node {
      Type.Nominal {declaration, ..} => Option.some<DeclarationId>(run DeclarationId.copy(&declaration))
      Type.Anonymous {occurrence, ..} => {
        let declaration = Shared.with<AnonymousOccurrence, Shared<DeclarationId>>(&occurrence, fn(site: &AnonymousOccurrence) -> Shared<DeclarationId> {
          return Shared.clone<DeclarationId>(&site.declaration)
        })
        let affordableOwner = Shared.with<DeclarationId, bool>(&declaration,
          fn(identity: &DeclarationId) -> bool { return RuntimeEncoding.recordPayload(&mut coordinates.*, RuntimeEncoding.declarationPayload(identity)) })
        if !affordableOwner { return Option.none<DeclarationId>() }
        return Option.some<DeclarationId>(run DeclarationId.copyShared(&declaration))
      }
      Type.CallableSchema {schema, ..} => {
        let target = Shared.with<SectionSchema, Shared<DeclarationId>>(&schema,
          fn(value: &SectionSchema) -> Shared<DeclarationId> { return Shared.clone<DeclarationId>(&value.target) })
        let affordableOwner = Shared.with<DeclarationId, bool>(&target,
          fn(identity: &DeclarationId) -> bool { return RuntimeEncoding.recordPayload(&mut coordinates.*, RuntimeEncoding.declarationPayload(identity)) })
        if !affordableOwner { return Option.none<DeclarationId>() }
        return Option.some<DeclarationId>(run DeclarationId.copyShared(&target))
      }
      Type.CallableValue {application, ..} => {
        let affordableOwner = Shared.with<Application, bool>(&application,
          fn(selected: &Application) -> bool { return RuntimeEncoding.recordPayload(&mut coordinates.*,
            RuntimeEncoding.declarationPayload(Application.bodyDeclaration(selected))) })
        if !affordableOwner { return Option.none<DeclarationId>() }
        let declaration = run Application.copyBodyDeclaration(&application)
        return Option.some<DeclarationId>(move declaration)
      }
      Type.CallableView {representation, ..} => run Type.glueOwner(&representation, &mut coordinates.*)
      // A composition's runtime identity is anchored by the Effect it protects.
      Type.EffectComposite {parts, ..} => {
        let stored = Vector.asSlice<Shared<Type>>(&parts)
        return run Type.glueOwner(&stored[usize.ZERO], &mut coordinates.*)
      }
      Type.Array {element, ..} => run Type.glueOwner(&element, &mut coordinates.*)
      Type.Union {members} => {
        let listed = Vector.asSlice<Shared<Type>>(&members)
        let mut best = Option.none<DeclarationId>()
        let mut bestRecord = Bytes.make()
        let mut at = usize.ZERO
        while at < listed.length {
          let candidate = run Type.glueOwner(&listed[at], &mut coordinates.*)
          if let Option<DeclarationId>.Some {value: found} = move candidate {
            let mut record = Bytes.make()
            run RuntimeEncoding.recordDeclaration(&mut record, &found, &mut coordinates.*)
            if coordinates.exceeded { return Option.none<DeclarationId>() }
            let mut choose = true
            if let Option<DeclarationId>.Some {..} = &best {
              let equal = RuntimeEncoding.recordEqual(Bytes.asSlice(&record), Bytes.asSlice(&bestRecord), &mut coordinates.*)
              if coordinates.exceeded { return Option.none<DeclarationId>() }
              if equal { choose = false } else {
                choose = RuntimeEncoding.less(Bytes.asSlice(&record), Bytes.asSlice(&bestRecord))
              }
            }
            if choose { best = Option.some<DeclarationId>(move found)
              bestRecord = move record }
          }
          if coordinates.exceeded { return Option.none<DeclarationId>() }
          at = at + usize.ONE
        }
        return move best
      }
      _ => Option.none<DeclarationId>()
    }
  }

  /// Reads a borrowed slice's element identity without erasing access or validity in its type.
  pub fn sliceElement(ty: &Shared<Type>) -> Option<Shared<Type>> {
    return Shared.with<Type, Option<Shared<Type>>>(ty, fn(value: &Type) -> Option<Shared<Type>> {
      if let Type.Slice {element, ..} = &value.* {
        return Option.some<Shared<Type>>(Shared.clone<Type>(&element))
      }
      return Option.none<Shared<Type>>()
    })
  }

  /// Whether a type, including nested lifetimes and requirement rows, contains a declaration-owned
  /// generic parameter. Only such open goals may use a caller's declared abstract bounds as proof.
  pub fn hasOpenParameters(value: &Shared<Type>) -> bool {
    return openType(value, false)
  }
  /// Whether a type mentions a sealed descriptor or StaticSequence at any depth; neither has a runtime layout.
  pub fn mentionsPhaseOnly(value: &Shared<Type>) -> bool {
    if Shared.with<Type, bool>(value, fn(node: &Type) -> bool {
      if let Option<Shared<Type>>.Some {..} = move CheckedIntrinsic.staticSequenceElement(node) { return true }
      return match & node.* { Type.TypeDescriptor {..} => true _ => false }
    }) { return true }
    let children = Shared.with<Type, usize>(value, childCount)
    let mut at = usize.ZERO
    while at < children {
      let found = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
        return childAt(node, at)
      })
      if let Option<Shared<Type>>.Some {value: nested} = move found {
        if Type.mentionsPhaseOnly(&nested) { return true }
      }
      let supplied = argumentRowOf(value, at)
      if let Option<Shared<Row>>.Some {value: row} = move supplied {
        if Row.mentionsPhaseOnly(&row) { return true }
      }
      at = at + usize.ONE
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        let found = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
          return unionMemberAt(node, at)
        })
        if let Option<Shared<Type>>.Some {value: nested} = move found {
          if Type.mentionsPhaseOnly(&nested) { return true }
        }
        at = at + usize.ONE
      }
    }
    let requirements = Shared.with<Type, Option<Shared<Row>>>(value, rowOf)
    if let Option<Shared<Row>>.Some {value: row} = move requirements {
      return Row.mentionsPhaseOnly(&row)
    }
    return false
  }
  /// Whether any subterm binds its own invocation lifetimes, including an unused quantifier.
  /// Opening an outer promise must not later close its rigids beneath an independent binder.
  pub fn containsInvocationQuantifier(value: &Shared<Type>) -> bool {
    if Shared.with<Type, usize>(value, invocationCount) != usize.ZERO { return true }
    let schema = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
      return match &node.* {
        Type.CallableSchema {schema, ..} => Option.some<Shared<Type>>(schemaContract(&schema))
        _ => Option.none<Shared<Type>>()
      }
    })
    if let Option<Shared<Type>>.Some {value: contract} = move schema {
      if Type.containsInvocationQuantifier(&contract) { return true }
    }
    let children = Shared.with<Type, usize>(value, childCount)
    let mut at = usize.ZERO
    while at < children {
      let found = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
        return childAt(node, at)
      })
      if let Option<Shared<Type>>.Some {value: nested} = move found {
        if Type.containsInvocationQuantifier(&nested) { return true }
      }
      if let Option<Shared<Row>>.Some {value: row} = move argumentRowOf(value, at) {
        if rowContainsInvocationQuantifier(&row) { return true }
      }
      at = at + usize.ONE
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        if let Option<Shared<Type>>.Some {value: nested} = move memberOf(value, at) {
          if Type.containsInvocationQuantifier(&nested) { return true }
        }
        at = at + usize.ONE
      }
    }
    let row = Shared.with<Type, Option<Shared<Row>>>(value, fn(node: &Type) -> Option<Shared<Row>> {
      return match &node.* {
        Type.Effect {requirements, ..} => Option.some<Shared<Row>>(Shared.clone<Row>(&requirements))
        _ => Option.none<Shared<Row>>()
      }
    })
    if let Option<Shared<Row>>.Some {value: requirements} = move row { return rowContainsInvocationQuantifier(&requirements) }
    return false
  }
  /// Whether runtime projection must unwrap a callable use view or an Effect join at any depth.
  pub fn containsStorageView(value: &Shared<Type>) -> bool {
    if Shared.with<Type, bool>(value, fn(node: &Type) -> bool {
      return match &node.* { Type.CallableView {..} => true Type.EffectJoin {..} => true _ => false }
    }) { return true }
    let children = Shared.with<Type, usize>(value, childCount)
    let mut at = usize.ZERO
    while at < children {
      let nested = Shared.with<Type, Option<Shared<Type>>>(value,
        fn(node: &Type) -> Option<Shared<Type>> { return childAt(node, at) })
      if let Option<Shared<Type>>.Some {value: child} = move nested {
        if Type.containsStorageView(&child) { return true }
      }
      at = at + usize.ONE
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        if let Option<Shared<Type>>.Some {value: child} = move memberOf(value, at) {
          if Type.containsStorageView(&child) { return true }
        }
        at = at + usize.ONE
      }
    }
    return false
  }
  /// Whether a runtime specialization still contains a type or requirement-row parameter.
  /// Validity lifetimes remain in the semantic type but do not make runtime code generic.
  pub fn hasOpenRuntimeParameters(value: &Shared<Type>) -> bool {
    return openType(value, true)
  }
  /// Reports whether a value type applies an interface or service anywhere outside a requirement
  /// row. Interfaces and services are compile-time contracts, not storable existential values.
  pub fn mentionsContract(value: &Type) -> bool {
    return match & value.* {
      Type.Nominal {declaration, arguments, ..} => {
        let kind = DeclarationId.kind(&declaration)
        if kind == OwnerKind.Interface || kind == OwnerKind.Service {
          return true
        }
        let supplied = Vector.asSlice<Argument>(&arguments)
        let mut at = usize.ZERO
        while at < supplied.length {
          if let Argument.Type {value: argument} = &supplied[at] {
            if Shared.with<Type, bool>(&argument, Type.mentionsContract) {
              return true
            }
          }
          at = at + usize.ONE
        }
        return false
      }
      Type.CallableWitnessResult {witness} => {
        let count = Shared.with<WitnessRecipe, usize>(&witness, CallableWitness.childCount)
        let mut at = usize.ONE
        while at < count {
          let child = Shared.with<WitnessRecipe, Option<Shared<Type>>>(&witness,
            fn(recipe: &WitnessRecipe) -> Option<Shared<Type>> { return CallableWitness.childAt(recipe, at) })
          if let Option<Shared<Type>>.Some {value: nested} = move child {
            if Shared.with<Type, bool>(&nested, Type.mentionsContract) { return true }
          }
          at = at + usize.ONE
        }
        return false
      }
      Type.CallableOrigin {application, contract} =>
        Shared.with<Type, bool>(&contract, Type.mentionsContract) || Shared.with<Application, bool>(&application, applicationMentionsContract)
      Type.OpaqueRepresentation {application, contract, ..} =>
        Shared.with<Type, bool>(&contract, Type.mentionsContract) || Shared.with<Application, bool>(&application, applicationMentionsContract)
      Type.Reference {referent, ..} => Shared.with<Type, bool>(&referent, Type.mentionsContract)
      Type.Slice {element, ..} => Shared.with<Type, bool>(&element, Type.mentionsContract)
      Type.Pointer {pointee, ..} => Shared.with<Type, bool>(&pointee, Type.mentionsContract)
      Type.Array {element, ..} => Shared.with<Type, bool>(&element, Type.mentionsContract)
      Type.Anonymous {members, ..} => Type.anyMentionsContract(Vector.asSlice<Shared<Type>>(&members))
      Type.CallableSchema {captures, ..} => Type.anyMentionsContract(Vector.asSlice<Shared<Type>>(&captures))
      Type.CallableValue {contract, captures, ..} => Shared.with<Type, bool>(&contract, Type.mentionsContract) || Type.anyMentionsContract(Vector.asSlice<Shared<Type>>(&captures))
      Type.EffectComposite {contract, parts, ..} => Shared.with<Type, bool>(&contract, Type.mentionsContract) || Type.anyMentionsContract(Vector.asSlice<Shared<Type>>(&parts))
      Type.EffectJoin {contract, alternatives} => Shared.with<Type, bool>(&contract, Type.mentionsContract) || Type.anyMentionsContract(Vector.asSlice<Shared<Type>>(&alternatives))
      Type.CallableStage {base, contract, captures, ..} => Shared.with<Type, bool>(&base, Type.mentionsContract)
        || Shared.with<Type, bool>(&contract, Type.mentionsContract) || Type.anyMentionsContract(Vector.asSlice<Shared<Type>>(&captures))
      Type.CallableResult {producer, contract, arguments, ..} => Shared.with<Type, bool>(&producer, Type.mentionsContract)
        || Shared.with<Type, bool>(&contract, Type.mentionsContract) || Type.anyMentionsContract(Vector.asSlice<Shared<Type>>(&arguments))
      Type.CallableView {representation, contract} => Shared.with<Type, bool>(&representation, Type.mentionsContract)
        || Shared.with<Type, bool>(&contract, Type.mentionsContract)
      Type.Union {members} => Type.anyMentionsContract(Vector.asSlice<Shared<Type>>(&members))
      Type.Callable {parameters, result, ..} => Type.anyMentionsContract(
        Vector.asSlice<Shared<Type>>(&parameters),
      ) || Shared.with<Type, bool>(&result, Type.mentionsContract)
      Type.Effect {success, failure, ..} => Shared.with<Type, bool>(&success, Type.mentionsContract) || Shared.with<
        Type,
        bool,
      >(&failure, Type.mentionsContract)
      _ => false
    }
  }
  /// Reports whether any listed type mentions an interface or service.
  pub fn anyMentionsContract(values: &[Shared<Type>]) -> bool {
    let mut at = usize.ZERO
    while at < values.length {
      if Shared.with<Type, bool>(&values[at], Type.mentionsContract) {
        return true
      }
      at = at + usize.ONE
    }
    return false
  }
  /// The binder ordinal of a type parameter bound by `owner`, or `usize.MAX` for any other type.
  pub fn parameterOrdinalOf(value: &Type, owner: &DeclarationId) -> usize {
    if let Type.Parameter {declaration, ordinal} = &value.* {
      if DeclarationId.equals(&declaration, owner) {
        return ordinal
      }
    }
    return usize.MAX
  }
  /// Appends each invocation binder ordinal the first time it occurs in `value`.
  ///
  /// # Details
  ///
  /// The walk visits a node's own lifetimes, then its ordered child types, union members, and
  /// requirement-row capabilities. It numbers the binders a contract actually uses, so an unused
  /// binder drops out; equality does not depend on this order.
  pub effect fn collectInvocations(value: &Shared<Type>, order: &mut Vector<usize>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let lifetimes = Shared.with<Type, usize>(value, comparedLifetimeCount)
    let mut at = usize.ZERO
    while at < lifetimes {
      let found = Shared.with<Type, Option<Shared<Lifetime>>>(
        value,
        fn(node: &Type) -> Option<Shared<Lifetime>> {
          return comparedLifetimeAt(node, at)
        },
      )
      if let Option<Shared<Lifetime>>.Some {value: lifetime} = move found {
        run Type.collectLifetime(&lifetime, &mut order.*)
      }
      at = at + usize.ONE
    }
    let count = Shared.with<Type, usize>(value, childCount)
    at = usize.ZERO
    while at < count {
      let child = Shared.with<Type, Option<Shared<Type>>>(
        value,
        fn(node: &Type) -> Option<Shared<Type>> {
          return childAt(node, at)
        },
      )
      if let Option<Shared<Type>>.Some {value: nested} = move child {
        run Type.collectInvocations(&nested, &mut order.*)
      }
      let row = argumentRowOf(value, at)
      if let Option<Shared<Row>>.Some {value: supplied} = move row {
        run collectRow(&supplied, &mut order.*)
      }
      at = at + usize.ONE
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        let member = memberOf(value, at)
        if let Option<Shared<Type>>.Some {value: nested} = move member {
          run Type.collectInvocations(&nested, &mut order.*)
        }
        at = at + usize.ONE
      }
    }
    let effectRow = Shared.with<Type, Option<Shared<Row>>>(value, rowOf)
    if let Option<Shared<Row>>.Some {value: requirements} = move effectRow {
      run collectRow(&requirements, &mut order.*)
    }
    return ()
  }
  /// Appends the ordinal of every type, lifetime, or row parameter owned by `owner` that `value`
  /// mentions, each kind to its own list and each ordinal once, including inside requirement rows.
  pub effect fn collectOwned(
    value: &Shared<Type>,
    owner: &DeclarationId,
    types: &mut Vector<usize>,
    lifetimes: &mut Vector<usize>,
    rows: &mut Vector<usize>,
  ) -> () ! OutOfMemoryError ? &mut Allocator {
    let direct = Shared.with<Type, usize>(
      value,
      fn(node: &Type) -> usize {
        return Type.parameterOrdinalOf(node, owner)
      },
    )
    if direct != usize.MAX {
      return run appendOrdinal(&mut types.*, direct)
    }
    let contract = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
      if let Type.OpaqueRepresentation {contract, ..} = &node.* { return Option.some<Shared<Type>>(Shared.clone<Type>(&contract)) }
      return Option.none<Shared<Type>>()
    })
    if let Option<Shared<Type>>.Some {value: nested} = move contract {
      run Type.collectOwned(&nested, owner, &mut types.*, &mut lifetimes.*, &mut rows.*)
    }
    let regions = Shared.with<Type, usize>(value, comparedLifetimeCount)
    let mut at = usize.ZERO
    while at < regions {
      let found = Shared.with<Type, Option<Shared<Lifetime>>>(
        value,
        fn(node: &Type) -> Option<Shared<Lifetime>> {
          return comparedLifetimeAt(node, at)
        },
      )
      if let Option<Shared<Lifetime>>.Some {value: lifetime} = move found {
        run Type.collectOwnedLifetime(&lifetime, owner, &mut lifetimes.*)
      }
      at = at + usize.ONE
    }
    let count = Shared.with<Type, usize>(value, childCount)
    at = usize.ZERO
    while at < count {
      let child = Shared.with<Type, Option<Shared<Type>>>(
        value,
        fn(node: &Type) -> Option<Shared<Type>> {
          return childAt(node, at)
        },
      )
      if let Option<Shared<Type>>.Some {value: nested} = move child {
        run Type.collectOwned(&nested, owner, &mut types.*, &mut lifetimes.*, &mut rows.*)
      }
      let row = argumentRowOf(value, at)
      if let Option<Shared<Row>>.Some {value: supplied} = move row {
        run Type.collectOwnedRow(&supplied, owner, &mut types.*, &mut lifetimes.*, &mut rows.*)
      }
      at = at + usize.ONE
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        let member = memberOf(value, at)
        if let Option<Shared<Type>>.Some {value: nested} = move member {
          run Type.collectOwned(&nested, owner, &mut types.*, &mut lifetimes.*, &mut rows.*)
        }
        at = at + usize.ONE
      }
    }
    let effectRow = Shared.with<Type, Option<Shared<Row>>>(value, rowOf)
    if let Option<Shared<Row>>.Some {value: requirements} = move effectRow {
      run Type.collectOwnedRow(&requirements, owner, &mut types.*, &mut lifetimes.*, &mut rows.*)
    }
    return ()
  }
  /// Appends a lifetime parameter's ordinal when `owner` binds it.
  pub effect fn collectOwnedLifetime(
    lifetime: &Shared<Lifetime>,
    owner: &DeclarationId,
    lifetimes: &mut Vector<usize>,
  ) -> () ! OutOfMemoryError ? &mut Allocator {
    let count = Lifetime.atomCount(lifetime)
    let mut atomAt = usize.ZERO
    while atomAt < count {
      let atom = Lifetime.atomAt(lifetime, atomAt)
      let ordinal = Shared.with<Lifetime, usize>(&atom, fn(region: &Lifetime) -> usize {
        return ownedLifetimeOrdinal(region, owner)
      })
      if ordinal != usize.MAX { run appendOrdinal(&mut lifetimes.*, ordinal) }
      atomAt = atomAt + usize.ONE
    }
    return ()
  }
  /// Appends the owned parameters a requirement row mentions through its capabilities and `?R`
  /// parameters.
  /// Appends every region atom `value` mentions, one entry per occurrence and in walk order.
  pub effect fn regionAtoms(value: &Shared<Type>, atoms: &mut Vector<Shared<Lifetime>>) -> () ! OutOfMemoryError ? &mut Allocator {
    let contract = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
      if let Type.OpaqueRepresentation {contract, ..} = &node.* { return Option.some<Shared<Type>>(Shared.clone<Type>(&contract)) }
      return Option.none<Shared<Type>>()
    })
    if let Option<Shared<Type>>.Some {value: nested} = move contract {
      run Type.regionAtoms(&nested, &mut atoms.*)
    }
    let regions = Shared.with<Type, usize>(value, comparedLifetimeCount)
    let mut at = usize.ZERO
    while at < regions {
      let found = Shared.with<Type, Option<Shared<Lifetime>>>(value, fn(node: &Type) -> Option<Shared<Lifetime>> {
        return comparedLifetimeAt(node, at)
      })
      if let Option<Shared<Lifetime>>.Some {value: lifetime} = move found {
        let count = Lifetime.atomCount(&lifetime)
        let mut atom = usize.ZERO
        while atom < count {
          run Vector.append<Shared<Lifetime>>(&mut atoms.*, Lifetime.atomAt(&lifetime, atom))
          atom = atom + usize.ONE
        }
      }
      at = at + usize.ONE
    }
    let count = Shared.with<Type, usize>(value, childCount)
    at = usize.ZERO
    while at < count {
      let child = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
        return childAt(node, at)
      })
      if let Option<Shared<Type>>.Some {value: nested} = move child {
        run Type.regionAtoms(&nested, &mut atoms.*)
      }
      let row = argumentRowOf(value, at)
      if let Option<Shared<Row>>.Some {value: supplied} = move row {
        run Type.rowRegionAtoms(&supplied, &mut atoms.*)
      }
      at = at + usize.ONE
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        let member = memberOf(value, at)
        if let Option<Shared<Type>>.Some {value: nested} = move member {
          run Type.regionAtoms(&nested, &mut atoms.*)
        }
        at = at + usize.ONE
      }
    }
    let effectRow = Shared.with<Type, Option<Shared<Row>>>(value, rowOf)
    if let Option<Shared<Row>>.Some {value: requirements} = move effectRow {
      run Type.rowRegionAtoms(&requirements, &mut atoms.*)
    }
    return ()
  }
  /// Appends every region atom a row's requirements mention.
  pub effect fn rowRegionAtoms(row: &Shared<Row>, atoms: &mut Vector<Shared<Lifetime>>) -> () ! OutOfMemoryError ? &mut Allocator {
    let entries = Shared.with<Row, usize>(row, fn(value: &Row) -> usize { return Vector.length<Requirement>(&value.entries) })
    let mut at = usize.ZERO
    while at < entries {
      let entry = entryAt(row, at)
      run Type.regionAtoms(&entry.capability, &mut atoms.*)
      if let Option<Shared<Type>>.Some {value: roleValue} = &entry.roleType {
        run Type.regionAtoms(&roleValue, &mut atoms.*)
      }
      at = at + usize.ONE
    }
    return ()
  }
  pub effect fn collectOwnedRow(
    row: &Shared<Row>,
    owner: &DeclarationId,
    types: &mut Vector<usize>,
    lifetimes: &mut Vector<usize>,
    rows: &mut Vector<usize>,
  ) -> () ! OutOfMemoryError ? &mut Allocator {
    let entries = Shared.with<Row, usize>(
      row,
      fn(value: &Row) -> usize {
        return Vector.length<Requirement>(&value.entries)
      },
    )
    let mut at = usize.ZERO
    while at < entries {
      let entry = entryAt(row, at)
      run Type.collectOwned(&entry.capability, owner, &mut types.*, &mut lifetimes.*, &mut rows.*)
      if let Option<Shared<Type>>.Some {value: roleValue} = &entry.roleType {
        run Type.collectOwned(&roleValue, owner, &mut types.*, &mut lifetimes.*, &mut rows.*)
      }
      at = at + usize.ONE
    }
    let parameters = Shared.with<Row, usize>(
      row,
      fn(value: &Row) -> usize {
        return Vector.length<RowParameter>(&value.parameters)
      },
    )
    at = usize.ZERO
    while at < parameters {
      let ordinal = Shared.with<Row, usize>(
        row,
        fn(value: &Row) -> usize {
          return ownedRowOrdinal(value, at, owner)
        },
      )
      if ordinal != usize.MAX {
        run appendOrdinal(&mut rows.*, ordinal)
      }
      at = at + usize.ONE
    }
    let terms = subtractionCount(row)
    at = usize.ZERO
    while at < terms {
      let term = subtractionAt(row, at)
      run Type.collectOwnedRow(&term.source, owner, &mut types.*, &mut lifetimes.*, &mut rows.*)
      run Type.collectOwnedRow(&term.removed, owner, &mut types.*, &mut lifetimes.*, &mut rows.*)
      at = at + usize.ONE
    }
    return ()
  }
  /// Whether any semantic subterm is a reference, slice, or borrowed string view.
  /// Copy views retain a loan when captured; Copy ownership alone does not authorize a snapshot.
  pub fn containsViewBorrow(value: &Shared<Type>) -> bool {
    if Shared.with<Type, bool>(value, viewBorrow) { return true }
    let storage = Shared.with<Type, Option<Shared<Type>>>(value, callableViewReference)
    if let Option<Shared<Type>>.Some {value: loan} = move storage {
      if Type.containsViewBorrow(&loan) { return true }
    }
    let visible = Shared.with<Type, Option<Shared<Type>>>(value,
      fn(node: &Type) -> Option<Shared<Type>> {
        return match &node.* {
          Type.CallableValue {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
          Type.CallableSchema {schema, ..} => Option.some<Shared<Type>>(schemaContract(&schema))
          Type.CallableResult {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
    Type.CallableWitnessResult {witness} => Option.some<Shared<Type>>(Shared.with<WitnessRecipe, Shared<Type>>(&witness,
      CallableWitness.resultType))
    Type.CallableOrigin {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
          Type.CallableStage {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
          Type.CallableView {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
          Type.EffectComposite {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
          Type.EffectJoin {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
          _ => Option.none<Shared<Type>>()
        }
      })
    if let Option<Shared<Type>>.Some {value: contract} = move visible { return Type.containsViewBorrow(&contract) }
    let count = Shared.with<Type, usize>(value, childCount)
    let mut at = usize.ZERO
    while at < count {
      let child = Shared.with<Type, Option<Shared<Type>>>(value,
        fn(node: &Type) -> Option<Shared<Type>> { return childAt(node, at) })
      if let Option<Shared<Type>>.Some {value: nested} = move child {
        if Type.containsViewBorrow(&nested) { return true }
      }
      at = at + usize.ONE
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        if let Option<Shared<Type>>.Some {value: member} = move memberOf(value, at) {
          if Type.containsViewBorrow(&member) { return true }
        }
        at = at + usize.ONE
      }
    }
    return false
  }
  /// Appends an invocation binder ordinal unless it is already present.
  pub effect fn collectLifetime(lifetime: &Shared<Lifetime>, order: &mut Vector<usize>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let count = Lifetime.atomCount(lifetime)
    let mut atomAt = usize.ZERO
    while atomAt < count {
      let atom = Lifetime.atomAt(lifetime, atomAt)
      let ordinal = Shared.with<Lifetime, usize>(&atom, invocationOrdinal)
      if ordinal != usize.MAX { run appendOrdinal(&mut order.*, ordinal) }
      atomAt = atomAt + usize.ONE
    }
    return ()
  }
  /// Appends the non-static regions a value of this type retains when an Effect captures it, and
  /// reports whether every retained region is known.
  ///
  /// # Details
  ///
  /// - A borrow retains its own region, which also bounds its referent.
  /// - A nominal value retains its lifetime arguments and whatever its type arguments retain.
  /// - A callable or Effect retains only its environment; its parameter, success, and failure
  ///   types describe calls and outcomes, not stored captures.
  /// - A raw pointer claims no loan.
  /// - A representation parameter, bound by `F: fn(A) -> B` or `F: Effect<A>`, retains what its
  ///   contract retains. `representations` holds that contract at the binder ordinal of a
  ///   parameter owned by `owner`; an enclosing declaration's parameter never reads that table.
  /// - Any other type parameter's stored contents are unknown, so the answer is `false`.
  pub effect fn retainedRegions(
    value: &Shared<Type>,
    owner: &DeclarationId,
    representations: &[Option<Shared<Type>>],
    regions: &mut Vector<Shared<Lifetime>>,
  ) -> bool ! OutOfMemoryError ? &mut Allocator {
    let detached = Shared.with<Type, bool>(
      value,
      fn(node: &Type) -> bool {
        return match & node.* {
          Type.OpaqueRepresentation {detached, ..} => detached
          _ => false
        }
      },
    )
    if detached {
      return true
    }
    // A use view's environment promise describes captures. A reference-backed view additionally
    // retains the temporary loan of its original storage, even when its captures are static.
    let storage = Shared.with<Type, Option<Shared<Type>>>(value, callableViewReference)
    if let Option<Shared<Type>>.Some {value: loan} = move storage {
      if !run Type.retainedRegions(&loan, owner, representations, &mut regions.*) { return false }
    }
    let opaqueContract = Shared.with<Type, Option<Shared<Type>>>(
      value,
      fn(node: &Type) -> Option<Shared<Type>> {
        return match & node.* {
          Type.OpaqueRepresentation {contract, ..} => Option.some<Shared<Type>>(
            Shared.clone<Type>(&contract),
          )
          Type.CallableValue {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
          Type.CallableSchema {schema, ..} => Option.some<Shared<Type>>(schemaContract(&schema))
          Type.CallableResult {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
    Type.CallableWitnessResult {witness} => Option.some<Shared<Type>>(Shared.with<WitnessRecipe, Shared<Type>>(&witness,
      CallableWitness.resultType))
    Type.CallableOrigin {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
          Type.CallableStage {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
          Type.CallableView {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
          Type.EffectComposite {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
          Type.EffectJoin {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
          _ => Option.none<Shared<Type>>()
        }
      },
    )
    if let Option<Shared<Type>>.Some {value: contract} = move opaqueContract {
      return run Type.retainedRegions(&contract, owner, representations, &mut regions.*)
    }
    let kind = Shared.with<Type, usize>(value, retentionKind)
    if kind == usize.MAX {
      let ordinal = Shared.with<Type, usize>(
        value,
        fn(node: &Type) -> usize {
          return Type.parameterOrdinalOf(node, owner)
        },
      )
      if ordinal < representations.length {
        if let Option<Shared<Type>>.Some {value: contract} = &representations[ordinal] {
          return run Type.retainedRegions(&contract, owner, representations, &mut regions.*)
        }
      }
      return false
    }
    let lifetimes = Shared.with<Type, usize>(value, ownLifetimeCount)
    let mut at = usize.ZERO
    while at < lifetimes {
      let found = Shared.with<Type, Option<Shared<Lifetime>>>(
        value,
        fn(node: &Type) -> Option<Shared<Lifetime>> {
          return ownLifetimeAt(node, at)
        },
      )
      if let Option<Shared<Lifetime>>.Some {value: lifetime} = move found {
        if !Shared.with<Lifetime, bool>(&lifetime, isStaticLifetime) {
          run Vector.append<Shared<Lifetime>>(&mut regions.*, move lifetime)
        }
      }
      at = at + usize.ONE
    }
    let mut known = true
    // Keep visiting after an unknown parameter: later fields can retain concrete loans.
    // Only nominal arguments, array elements, and union members are stored contents.
    if kind == usize.ONE {
      let count = Shared.with<Type, usize>(value, childCount)
      at = usize.ZERO
      while at < count {
        let child = Shared.with<Type, Option<Shared<Type>>>(
          value,
          fn(node: &Type) -> Option<Shared<Type>> {
            return childAt(node, at)
          },
        )
        if let Option<Shared<Type>>.Some {value: nested} = move child {
          if !run Type.retainedRegions(&nested, owner, representations, &mut regions.*) {
            known = false
          }
        }
        at = at + usize.ONE
      }
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        let member = memberOf(value, at)
        if let Option<Shared<Type>>.Some {value: nested} = move member {
          if !run Type.retainedRegions(&nested, owner, representations, &mut regions.*) {
            known = false
          }
        }
        at = at + usize.ONE
      }
    }
    return known
  }
  /// Collects symbolic stored contents, stopping at a borrow's region and a callable's
  /// environment. Signature inputs and results are not stored values.
  pub effect fn storedParameters(value: &Shared<Type>, parameters: &mut Vector<Shared<Type>>) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let kind = Shared.with<Type, usize>(value, retentionKind)
    if kind == usize.MAX {
      run Vector.append<Shared<Type>>(&mut parameters.*, Shared.clone<Type>(value))
      return ()
    }
    if kind == usize.ONE {
      let count = Shared.with<Type, usize>(value, childCount)
      let mut at = usize.ZERO
      while at < count {
        let child = Shared.with<Type, Option<Shared<Type>>>(value,
          fn(node: &Type) -> Option<Shared<Type>> { return childAt(node, at) })
        if let Option<Shared<Type>>.Some {value: nested} = move child {
          run Type.storedParameters(&nested, &mut parameters.*)
        }
        at = at + usize.ONE
      }
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      let mut at = usize.ZERO
      while at < members {
        if let Option<Shared<Type>>.Some {value: member} = move memberOf(value, at) {
          run Type.storedParameters(&member, &mut parameters.*)
        }
        at = at + usize.ONE
      }
    }
    return ()
  }
  /// Appends immediate stored type components of an aggregate. Borrows, pointers and callable
  /// signatures have no stored child here; an exact callable's environment is inspected separately.
  pub effect fn storedComponents(value: &Shared<Type>, components: &mut Vector<Shared<Type>>) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    if Shared.with<Type, usize>(value, retentionKind) == usize.ONE {
      let count = Shared.with<Type, usize>(value, childCount)
      let mut at = usize.ZERO
      while at < count {
        let child = Shared.with<Type, Option<Shared<Type>>>(value,
          fn(node: &Type) -> Option<Shared<Type>> { return childAt(node, at) })
        if let Option<Shared<Type>>.Some {value: nested} = move child {
          run Vector.append<Shared<Type>>(&mut components.*, move nested)
        }
        at = at + usize.ONE
      }
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      let mut at = usize.ZERO
      while at < members {
        if let Option<Shared<Type>>.Some {value: member} = move memberOf(value, at) {
          run Vector.append<Shared<Type>>(&mut components.*, move member)
        }
        at = at + usize.ONE
      }
    }
    return ()
  }
  /// Adds one union member, flattening a nested union and dropping a repeated member.
  pub effect fn joinMember(members: &mut Vector<Shared<Type>>, member: &Shared<Type>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let count = Shared.with<Type, usize>(member, unionLength)
    if count != usize.MAX {
      let mut at = usize.ZERO
      while at < count {
        let part = Shared.with<Type, Option<Shared<Type>>>(
          member,
          fn(value: &Type) -> Option<Shared<Type>> {
            return unionMemberAt(value, at)
          },
        )
        if let Option<Shared<Type>>.Some {value: nested} = move part {
          let present = run containsType(Vector.asSlice<Shared<Type>>(&members.*), &nested)
          if !present {
            run Vector.append<Shared<Type>>(&mut members.*, move nested)
          }
        }
        at = at + usize.ONE
      }
      return ()
    }
    let present = run containsType(Vector.asSlice<Shared<Type>>(&members.*), member)
    if !present {
      run Vector.append<Shared<Type>>(&mut members.*, Shared.clone<Type>(member))
    }
    return ()
  }
  /// Whether a callable member has exact finite storage and owner-independent runtime identity.
  /// Public headers and unresolved staging recipes are not union storage.
  pub fn closedCallableStorage(value: &Shared<Type>) -> bool {
    if Type.hasOpenRuntimeParameters(value) { return false }
    return Shared.with<Type, bool>(value, fn(node: &Type) -> bool {
      return match &node.* {
        Type.CallableValue {..} => true
        Type.CallableSchema {..} => true
        Type.EffectComposite {..} => true
        Type.CallableView {representation, ..} => Type.closedCallableStorage(&representation)
        _ => false
      }
    })
  }
  /// A closed structural union's members in canonical runtime-encoding order, the order union
  /// identity already uses. Primitive, fixed array, closed nominal application and exact closed callable
  /// members need no enclosing owner. Absent otherwise or when two members share one runtime
  /// identity.
  pub effect fn canonicalUnionMembers(value: &Shared<Type>) -> Option<Vector<Shared<Type>>>
  ! OutOfMemoryError
  ? &mut Allocator {
    let count = Shared.with<Type, usize>(value, unionLength)
    if count == usize.MAX { return Option.none<Vector<Shared<Type>>>() }
    let mut members = Vector.make<Shared<Type>>()
    let mut encodings = Vector.make<Bytes>()
    let mut at = usize.ZERO
    while at < count {
      let part = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
        return unionMemberAt(node, at)
      })
      let member = match move part {
        Option<Shared<Type>>.Some {value: selected} => move selected
        Option<Shared<Type>>.None => { return Option.none<Vector<Shared<Type>>>() }
      }
      let primitive = run Type.primitiveEncoding(&member)
      if let Option<Bytes>.Some {value: encoded} = move primitive {
        run Vector.append<Bytes>(&mut encodings, move encoded)
      } else {
        // A nominal application is closed once no runtime parameter remains in its arguments;
        // its erased runtime encoding then needs no enclosing owner.
        let nominal = Shared.with<Type, bool>(&member, fn(node: &Type) -> bool {
          return match &node.* { Type.Nominal {..} => true Type.Array {..} => true _ => false }
        })
        let closed = nominal && !Type.hasOpenRuntimeParameters(&member)
        let callable = Type.closedCallableStorage(&member)
        if !closed && !callable { return Option.none<Vector<Shared<Type>>>() }
        let mut anchor = Option.none<DeclarationId>()
        if callable || Shared.with<Type, bool>(&member, fn(node: &Type) -> bool {
          return match &node.* { Type.Array {..} => true _ => false }
        }) {
          let mut coordinates = RuntimeEncoding.coordinates()
          anchor = run Type.glueOwner(&member, &mut coordinates)
        } else { anchor = run copyNodeDeclaration(&member) }
        let own = match move anchor {
          Option<DeclarationId>.Some {value: declaration} => move declaration
          Option<DeclarationId>.None => { return Option.none<Vector<Shared<Type>>>() }
        }
        run Vector.append<Bytes>(&mut encodings, run Type.runtimeEncoding(&member, &own))
      }
      run Vector.append<Shared<Type>>(&mut members, move member)
      at = at + usize.ONE
    }
    let ranked = run RuntimeEncoding.order(&encodings)
    let positions = Vector.asSlice<usize>(&ranked)
    let listed = Vector.asSlice<Shared<Type>>(&members)
    let written = Vector.asSlice<Bytes>(&encodings)
    let mut canonical = Vector.make<Shared<Type>>()
    at = usize.ZERO
    while at < positions.length {
      if at > usize.ZERO && sameBytes(Bytes.asSlice(&written[positions[at]]), Bytes.asSlice(&written[positions[at - usize.ONE]])) {
        return Option.none<Vector<Shared<Type>>>()
      }
      run Vector.append<Shared<Type>>(&mut canonical, Shared.clone<Type>(&listed[positions[at]]))
      at = at + usize.ONE
    }
    return Option.some<Vector<Shared<Type>>>(move canonical)
  }
  /// A primitive's or text view's runtime encoding, which needs no owner: the same bytes
  /// runtimeEncoding gives it. A text view's lifetime is not part of its runtime identity.
  effect fn primitiveEncoding(value: &Shared<Type>) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
    let node = run nodeCopy(value)
    if let Type.Primitive {name} = &node {
      let mut output = Bytes.make()
      run RuntimeEncoding.word(&mut output, usize.toU64(nodeKind(&node)))
      run RuntimeEncoding.field(&mut output, Bytes.asSlice(&name))
      return Option.some<Bytes>(move output)
    }
    if let Type.String {..} = &node {
      let mut output = Bytes.make()
      run RuntimeEncoding.word(&mut output, usize.toU64(nodeKind(&node)))
      return Option.some<Bytes>(move output)
    }
    if let Type.Array {element, extent} = &node {
      let child = match move run Type.primitiveEncoding(&element) {
        Option<Bytes>.Some {value: encodedChild} => move encodedChild
        Option<Bytes>.None => { return Option.none<Bytes>() }
      }
      let mut output = Bytes.make()
      run RuntimeEncoding.word(&mut output, usize.toU64(nodeKind(&node)))
      run RuntimeEncoding.field(&mut output, Bytes.asSlice(&extent))
      run RuntimeEncoding.field(&mut output, Bytes.asSlice(&child))
      return Option.some<Bytes>(move output)
    }
    return Option.none<Bytes>()
  }
  /// Whether a complete result mentions the opaque family owned by `producer`.
  pub effect fn containsOpaque(value: &Shared<Type>, producer: &DeclarationId) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    let here = Shared.with<Type, bool>(
      value,
      fn(node: &Type) -> bool {
        return match & node.* {
          Type.OpaqueRepresentation {..} => opaqueProducedBy(node, producer)
          _ => false
        }
      },
    )
    if here {
      return true
    }
    let count = Shared.with<Type, usize>(value, childCount)
    let mut at = usize.ZERO
    while at < count {
      let child = Shared.with<Type, Option<Shared<Type>>>(
        value,
        fn(node: &Type) -> Option<Shared<Type>> { return childAt(node, at) },
      )
      if let Option<Shared<Type>>.Some {value: nested} = move child {
        if run Type.containsOpaque(&nested, producer) {
          return true
        }
      }
      at = at + usize.ONE
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        let member = memberOf(value, at)
        if let Option<Shared<Type>>.Some {value: nested} = move member {
          if run Type.containsOpaque(&nested, producer) {
            return true
          }
        }
        at = at + usize.ONE
      }
    }
    return false
  }
  /// Reports whether two shared types have the same semantic identity.
  ///
  /// # Details
  ///
  /// Allocation addresses are only a shortcut, never identity. Primitive names differ by spelling.
  /// A nominal application compares the kinds and values of its ordered arguments. Parameters
  /// compare declaration and ordinal; borrowed views compare their lifetime, access, and element
  /// type. Raw pointers compare their written qualifiers. Callables compare mode, safety,
  /// environment, and ordered signature; Effects compare run mode, environment, and channels.
  /// Unions and requirement rows compare as sets. Visibility does not change identity.
  ///
  /// # Gotchas
  ///
  /// Compare handles rather than borrowed values: after substitution one handle can occur at
  /// different depths on the two sides, and a held borrow cannot be entered again.
  pub effect fn equalsShared(left: &Shared<Type>, right: &Shared<Type>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    return run sameShared(left, right)
  }
  /// Matches a returned type to its producer's result while retaining every own opaque slot.
  /// All other type, lifetime, row and declaration evidence remains exact.
  pub effect fn opaqueEvidence(source: &Shared<Type>, target: &Shared<Type>, producer: &DeclarationId)
    -> Option<Vector<OpaqueEvidence>> ! OutOfMemoryError ? &mut Allocator {
    let mut evidence = Vector.make<OpaqueEvidence>()
    if !run collectOpaqueEvidence(source, target, producer, &mut evidence, true) {
      return Option.none<Vector<OpaqueEvidence>>()
    }
    return Option.some<Vector<OpaqueEvidence>>(move evidence)
  }
  /// Compares runtime representation identities after erasing validity lifetimes only.
  /// Type arguments, requirement rows, and exact representation declarations remain distinct.
  pub effect fn runtimeEqualsShared(left: &Shared<Type>, right: &Shared<Type>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut projection = Vector.make<usize>()
    run Vector.append<usize>(&mut projection, usize.MAX - 2)
    return run sameUnder(left, right, Vector.asSlice<usize>(&projection))
  }
  /// Returns a hash that two types share whenever [`equalsShared`] or [`runtimeEqualsShared`]
  /// reports them equal.
  ///
  /// # Details
  ///
  /// The hash reads only evidence that both identities compare exactly: the variant, primitive
  /// spellings, nominal and parameter declarations, argument kinds, parameter ordinals, access
  /// and pointer qualifiers, array extents, and member counts. It descends a bounded depth through
  /// children both identities compare in order: nominal type arguments, borrow and pointer
  /// referents, array elements, and anonymous members. Lifetimes, unordered sets, callables, whose
  /// binders compare up to renaming, and application evidence contribute only their head.
  pub fn hash(value: &Shared<Type>) -> u64 {
    return hashUnder(value, 6)
  }
  /// The number of type nodes in `value`, counted through the same children as
  /// [`strictRuntimeSubterm`]. A strict subterm is always smaller.
  pub fn runtimeSize(value: &Shared<Type>) -> usize {
    let mut size = usize.ONE
    let count = Shared.with<Type, usize>(value, childCount)
    let mut at = usize.ZERO
    while at < count {
      let child = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
        return childAt(node, at)
      })
      if let Option<Shared<Type>>.Some {value: nested} = move child { size = size + Type.runtimeSize(&nested) }
      at = at + usize.ONE
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        let member = memberOf(value, at)
        if let Option<Shared<Type>>.Some {value: nested} = move member { size = size + Type.runtimeSize(&nested) }
        at = at + usize.ONE
      }
    }
    return size
  }
  /// Whether `part` is strictly nested in `whole` by a concrete type argument, field-like
  /// element, or union member. This is the structural descent accepted for witness recursion.
  pub effect fn strictRuntimeSubterm(part: &Shared<Type>, whole: &Shared<Type>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    let count = Shared.with<Type, usize>(whole, childCount)
    let mut at = usize.ZERO
    while at < count {
      let child = Shared.with<Type, Option<Shared<Type>>>(whole, fn(value: &Type) -> Option<Shared<Type>> {
        return childAt(value, at)
      })
      if let Option<Shared<Type>>.Some {value: nested} = move child {
        if run Type.runtimeEqualsShared(part, &nested) {
          return true
        }
        if run Type.strictRuntimeSubterm(part, &nested) {
          return true
        }
      }
      at = at + usize.ONE
    }
    let members = Shared.with<Type, usize>(whole, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        let child = memberOf(whole, at)
        if let Option<Shared<Type>>.Some {value: nested} = move child {
          if run Type.runtimeEqualsShared(part, &nested) {
            return true
          }
          if run Type.strictRuntimeSubterm(part, &nested) {
            return true
          }
        }
        at = at + usize.ONE
      }
    }
    return false
  }
  /// Reports whether every member of a narrower `witness` failure type is a member of `promised`.
  ///
  /// # Details
  ///
  /// A structural union contributes its members, `never` none, and any other type itself. Members
  /// compare by exact identity, so a failure parameter covers only that parameter.
  pub effect fn coversFailure(promised: &Shared<Type>, witness: &Shared<Type>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    let uncovered = run Type.uncoveredFailures(promised, witness)
    return Vector.length<Shared<Type>>(&uncovered) == usize.ZERO
  }
  /// The members of `witness` that `promised` does not cover by exact identity, in order.
  pub effect fn uncoveredFailures(promised: &Shared<Type>, witness: &Shared<Type>) -> Vector<Shared<Type>>
  ! OutOfMemoryError
  ? &mut Allocator {
    let count = Shared.with<Type, usize>(witness, failureCount)
    let available = Shared.with<Type, usize>(promised, failureCount)
    let mut uncovered = Vector.make<Shared<Type>>()
    let mut at = usize.ZERO
    while at < count {
      let member = failureMember(witness, at)
      let mut found = false
      let mut other = usize.ZERO
      while !found && other < available {
        let candidate = failureMember(promised, other)
        found = run sameShared(&candidate, &member)
        other = other + usize.ONE
      }
      if !found { run Vector.append<Shared<Type>>(&mut uncovered, move member) }
      at = at + usize.ONE
    }
    return move uncovered
  }
  /// The failure members a type contributes: a structural union's members, none for `never`, and
  /// any other type itself.
  pub effect fn failureMembers(value: &Shared<Type>) -> Vector<Shared<Type>>
  ! OutOfMemoryError
  ? &mut Allocator {
    let count = Shared.with<Type, usize>(value, failureCount)
    let mut members = Vector.make<Shared<Type>>()
    let mut at = usize.ZERO
    while at < count {
      run Vector.append<Shared<Type>>(&mut members, failureMember(value, at))
      at = at + usize.ONE
    }
    return move members
  }
  /// Builds the failure type `Without<source, removed>` (FAIL-005).
  ///
  /// # Details
  ///
  /// Every source member a removed member names is dropped, and a member decided distinct from
  /// every removed member is kept. What still depends on a parameter stays as one
  /// [`Type.Without`] term carrying only the removed members that can still match it; a nested
  /// term folds its removed members into the outer ones. Substitution re-normalizes each term.
  pub effect fn without(source: &Shared<Type>, removed: &Shared<Type>) -> Shared<Type>
  ! OutOfMemoryError
  ? &mut Allocator {
    let keys = Shared.with<Type, usize>(removed, failureCount)
    if keys == usize.ZERO {
      return Shared.clone<Type>(source)
    }
    let mut kept = Vector.make<Shared<Type>>()
    if run sameShared(source, removed) {
      return run Shared.make<Type>(Type.Union {members: move kept})
    }
    let mut deferred = Vector.make<Shared<Type>>()
    let members = Shared.with<Type, usize>(source, failureCount)
    let mut at = usize.ZERO
    while at < members {
      let member = failureMember(source, at)
      let nested = Shared.with<Type, Option<WithoutParts>>(&member, withoutParts)
      if let Option<WithoutParts>.Some {value: term} = move nested {
        let mut combined = Vector.make<Shared<Type>>()
        run Type.joinMember(&mut combined, &term.removed)
        run Type.joinMember(&mut combined, removed)
        let keysFolded = run joinedMembers(move combined)
        let folded = run Type.without(&term.source, &keysFolded)
        run Type.joinMember(&mut kept, &folded)
      } else {
        let mut fate = Subtraction.start(false)
        let mut key = usize.ZERO
        while fate != Fate.Removed && key < keys {
          let candidate = failureMember(removed, key)
          let mut relation = Relation.Same
          if !run sameShared(&member, &candidate) { relation = memberRelation(&member, &candidate) }
          fate = Subtraction.decide(fate, relation)
          key = key + usize.ONE
        }
        if fate == Fate.Deferred {
          run Type.joinMember(&mut deferred, &member)
        } else if fate == Fate.Kept {
          run Type.joinMember(&mut kept, &member)
        }
      }
      at = at + usize.ONE
    }
    if Vector.length<Shared<Type>>(&deferred) != usize.ZERO {
      // Keep only the removed members that can still name an undecided member, so equal terms
      // compare equal however they were built.
      let undecided = Vector.asSlice<Shared<Type>>(&deferred)
      let mut needed = Vector.make<Shared<Type>>()
      let mut key = usize.ZERO
      while key < keys {
        let candidate = failureMember(removed, key)
        let mut open = false
        let mut entry = usize.ZERO
        while !open && entry < undecided.length {
          open = memberRelation(&undecided[entry], &candidate) == Relation.Open
          entry = entry + usize.ONE
        }
        if open { run Type.joinMember(&mut needed, &candidate) }
        key = key + usize.ONE
      }
      let term = run Shared.make<Type>(Type.Without {source: run joinedMembers(move deferred),
        removed: run joinedMembers(move needed)})
      run Type.joinMember(&mut kept, &term)
    }
    return run joinedMembers(move kept)
  }
  /// Compares two complete implementation heads up to binder spelling and owner identity.
  /// The caller supplies heads whose free parameters are owned by their respective impls and
  /// checks that both binder lists have the same shape. Unlike unification, this is an identity
  /// comparison: unions and rows are unordered sets, and callable binders are compared by bijection.
  pub effect fn alphaEquivalent(
    leftContract: &Shared<Type>,
    leftProvider: &Shared<Type>,
    rightContract: &Shared<Type>,
    rightProvider: &Shared<Type>,
    binderCount: usize,
  ) -> bool ! OutOfMemoryError ? &mut Allocator {
    let mut map = Vector.make<usize>()
    run Vector.append<usize>(&mut map, usize.MAX - usize.ONE)
    run Vector.append<usize>(&mut map, binderCount)
    let mut at = usize.ZERO
    while at < binderCount {
      run Vector.append<usize>(&mut map, usize.MAX)
      at = at + usize.ONE
    }
    return run assignHead(leftContract, leftProvider, rightContract, rightProvider, &mut map, usize.ZERO)
  }
  /// Compares the lifetime-erased shape of two ground subterms inside a coherence set.
  /// Callers establish that neither subterm contains a bindable parameter.
  pub effect fn projectEquals(left: &Shared<Type>, right: &Shared<Type>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut map = Vector.make<usize>()
    run Vector.append<usize>(&mut map, usize.MAX - 2)
    return run sameUnder(left, right, Vector.asSlice<usize>(&map))
  }
  /// Asks whether some assignment to the parameters owned by `variables` makes each left type equal
  /// to the right type at the same position, under one shared set of bindings.
  ///
  /// # Details
  ///
  /// A type, lifetime, or `?R` parameter is a variable exactly when its declaration is listed; any
  /// other parameter is rigid and equals only itself. `Distinct` at any position decides the whole
  /// answer; otherwise `Undetermined` at any position leaves it undecided. A variable binds only
  /// after an occurs check, so the bindings stay acyclic.
  ///
  /// `Projection` answers whether two conformance heads could name one goal: lifetimes are erased
  /// and unions and rows are decided on their containment fragment. It is never evidence that one
  /// type matches another. `Exact` compares lifetimes, binds variable lifetimes and rows, and
  /// matches a union only when equal or as one variable's whole value.
  ///
  /// # Gotchas
  ///
  /// The bindings grow only on `Unified`. Any other answer restores them to their length on entry,
  /// so a failed alternative leaves no partial assignment. Under `Projection`, set-absorbed
  /// variables receive no binding; the bindings then describe only the first-order part.
  pub effect fn unifyAll(
    left: &[Shared<Type>],
    right: &[Shared<Type>],
    variables: &[Shared<DeclarationId>],
    comparison: Comparison,
    bindings: &mut Vector<Binding>,
  ) -> Unification ! OutOfMemoryError ? &mut Allocator {
    if left.length != right.length {
      return Unification.Distinct
    }
    let mark = Vector.length<Binding>(&bindings.*)
    let mut absorbed = Vector.make<UnifySlot>()
    let mut result = Unification.Unified
    let mut at = usize.ZERO
    while at < left.length && !isDistinct(&result) {
      let compared = run unifyTerms(&left[at], &right[at], variables, comparison, &mut bindings.*, &mut absorbed)
      result = worse(&result, &compared)
      at = at + usize.ONE
    }
    if !isUnified(&result) {
      Vector.truncate<Binding>(&mut bindings.*, mark)
    }
    return move result
  }
  /// Asks [`Type.unifyAll`] about one pair of types.
  pub effect fn unify(
    left: &Shared<Type>,
    right: &Shared<Type>,
    variables: &[Shared<DeclarationId>],
    comparison: Comparison,
    bindings: &mut Vector<Binding>,
  ) -> Unification ! OutOfMemoryError ? &mut Allocator {
    let mut lefts = Vector.make<Shared<Type>>()
    run Vector.append<Shared<Type>>(&mut lefts, Shared.clone<Type>(left))
    let mut rights = Vector.make<Shared<Type>>()
    run Vector.append<Shared<Type>>(&mut rights, Shared.clone<Type>(right))
    return run Type.unifyAll(
      Vector.asSlice<Shared<Type>>(&lefts),
      Vector.asSlice<Shared<Type>>(&rights),
      variables,
      comparison,
      &mut bindings.*,
    )
  }
  /// Binds one still-open witness row to the promised operation's rigid row parameters.
  ///
  /// # Details
  ///
  /// Both inputs are Effect row carriers. Every fixed witness requirement must already be covered
  /// by a fixed promised requirement, including access. No fixed-key subtraction is inferred: the
  /// witness row receives exactly the promised row parameters, and the caller checks full row
  /// coverage after resolving that binding. This does not relax [`Type.unify`] Exact equality.
  pub effect fn bindWitnessResidual(
    promised: &Shared<Type>,
    witness: &Shared<Type>,
    variables: &[Shared<DeclarationId>],
    bindings: &mut Vector<Binding>,
  ) -> Unification ! OutOfMemoryError ? &mut Allocator {
    let promisedValue = Shared.with<Type, Option<Shared<Row>>>(promised, rowOf)
    let witnessValue = Shared.with<Type, Option<Shared<Row>>>(witness, rowOf)
    if let Option<Shared<Row>>.Some {value: promisedRow} = &promisedValue {
      if let Option<Shared<Row>>.Some {value: witnessRow} = &witnessValue {
        let mut promisedParts = UnifyRowParts {row: Row.empty(), open: Vector.make<UnifySlot>()}
        run flattenRow(
          &promisedRow,
          variables,
          Vector.asSlice<Binding>(&bindings.*),
          &mut promisedParts,
        )
        let mut witnessParts = UnifyRowParts {row: Row.empty(), open: Vector.make<UnifySlot>()}
        run flattenRow(
          &witnessRow,
          variables,
          Vector.asSlice<Binding>(&bindings.*),
          &mut witnessParts,
        )
        if Vector.length<UnifySlot>(&promisedParts.open) != usize.ZERO || Vector.length<UnifySlot>(
          &witnessParts.open,
        ) != usize.ONE || Vector.length<RowParameter>(&witnessParts.row.parameters) != usize.ZERO || rowSubtractionCount(
          &promisedParts.row,
        ) != usize.ZERO || rowSubtractionCount(&witnessParts.row) != usize.ZERO {
          return undetermined(witness)
        }
        let fixedPromised = run Shared.make<Row>(move promisedParts.row)
        let fixedWitness = run Shared.make<Row>(move witnessParts.row)
        if entriesOpen(
          &fixedPromised,
          variables,
          Vector.asSlice<Binding>(&bindings.*),
          Comparison.Exact,
        ) || entriesOpen(&fixedWitness, variables, Vector.asSlice<Binding>(&bindings.*), Comparison.Exact) {
          return undetermined(witness)
        }
        let covered = run entriesCovered(&fixedWitness, &fixedPromised, false, Comparison.Exact)
        if !isUnified(&covered) {
          return move covered
        }
        let mut residual = Row.empty()
        let parameters = Shared.with<Row, usize>(&fixedPromised, rowParameterCount)
        let mut at = usize.ZERO
        while at < parameters {
          let parameter = Shared.with<Row, RowParameter>(
            &fixedPromised,
            fn(value: &Row) -> RowParameter {
              return rowParameterAt(value, at)
            },
          )
          run Row.include(&mut residual, move parameter)
          at = at + usize.ONE
        }
        let open = Vector.asSlice<UnifySlot>(&witnessParts.open)
        let supplied = run Shared.make<Row>(move residual)
        run bindVariable(
          &open[usize.ZERO],
          Argument.Row {value: move supplied},
          variables,
          &mut bindings.*,
        )
        return Unification.Unified
      }
    }
    return undetermined(witness)
  }
  /// Reports whether `required` rewrites an argument that `declared` fixes: at some position both
  /// applications of the same nominal declaration write a type or row argument, the declared one
  /// mentions no type or `?R` parameter of `owner`, and the two differ once lifetimes are erased.
  pub effect fn changesFixedArgument(
    declared: &Shared<Type>,
    required: &Shared<Type>,
    owner: &DeclarationId,
  ) -> bool ! OutOfMemoryError ? &mut Allocator {
    let count = Shared.with<Type, usize>(declared, childCount)
    let none = Vector.make<Shared<DeclarationId>>()
    let mut at = usize.ZERO
    while at < count {
      let written = Shared.with<Type, Option<Shared<Type>>>(
        declared,
        fn(value: &Type) -> Option<Shared<Type>> {
          return childAt(value, at)
        },
      )
      let supplied = Shared.with<Type, Option<Shared<Type>>>(
        required,
        fn(value: &Type) -> Option<Shared<Type>> {
          return childAt(value, at)
        },
      )
      if let Option<Shared<Type>>.Some {value: fixed} = move written {
        if let Option<Shared<Type>>.Some {value: rewritten} = move supplied {
          if Type.occurrences(&fixed, owner, usize.MAX) == usize.ZERO {
            let mut bindings = Vector.make<Binding>()
            let same = run Type.unify(
              &fixed,
              &rewritten,
              Vector.asSlice<Shared<DeclarationId>>(&none),
              Comparison.Projection,
              &mut bindings,
            )
            if !isUnified(&same) {
              return true
            }
          }
        }
      }
      if let Option<Shared<Row>>.Some {value: fixedRow} = move argumentRowOf(declared, at) {
        if let Option<Shared<Row>>.Some {value: rewrittenRow} = move argumentRowOf(required, at) {
          if rowOccurrences(&fixedRow, owner, usize.MAX) == usize.ZERO && !run Row.equalsShared(
            &fixedRow,
            &rewrittenRow,
          ) {
            return true
          }
        }
      }
      at = at + usize.ONE
    }
    return false
  }
  /// Counts the occurrences of one type or `?R` parameter of `owner` in `value`, or of every such
  /// parameter when `ordinal` is `usize.MAX`, including inside union members and requirement rows.
  /// Lifetimes are not counted.
  pub fn occurrences(value: &Shared<Type>, owner: &DeclarationId, ordinal: usize) -> usize {
    let own = Shared.with<Type, usize>(
      value,
      fn(node: &Type) -> usize {
        return Type.parameterOrdinalOf(node, owner)
      },
    )
    if own != usize.MAX {
      if ordinal == usize.MAX || own == ordinal {
        return usize.ONE
      }
      return usize.ZERO
    }
    let mut count = usize.ZERO
    let children = Shared.with<Type, usize>(value, childCount)
    let mut at = usize.ZERO
    while at < children {
      let child = Shared.with<Type, Option<Shared<Type>>>(
        value,
        fn(node: &Type) -> Option<Shared<Type>> {
          return childAt(node, at)
        },
      )
      if let Option<Shared<Type>>.Some {value: nested} = move child {
        count = count + Type.occurrences(&nested, owner, ordinal)
      }
      if let Option<Shared<Row>>.Some {value: supplied} = move argumentRowOf(value, at) {
        count = count + rowOccurrences(&supplied, owner, ordinal)
      }
      at = at + usize.ONE
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        if let Option<Shared<Type>>.Some {value: member} = move unionMember(value, at) {
          count = count + Type.occurrences(&member, owner, ordinal)
        }
        at = at + usize.ONE
      }
    }
    let requirementsFound = Shared.with<Type, Option<Shared<Row>>>(value, rowOf)
    if let Option<Shared<Row>>.Some {value: requirements} = move requirementsFound {
      count = count + rowOccurrences(&requirements, owner, ordinal)
    }
    return count
  }
}

fn rowContainsInvocationQuantifier(row: &Shared<Row>) -> bool {
  let count = Shared.with<Row, usize>(row, rowEntryCount)
  let mut at = usize.ZERO
  while at < count {
    let entry = entryAt(row, at)
    if Type.containsInvocationQuantifier(&entry.capability) { return true }
    if let Option<Shared<Type>>.Some {value} = &entry.roleType {
      if Type.containsInvocationQuantifier(&value) { return true }
    }
    at = at + usize.ONE
  }
  let terms = Shared.with<Row, usize>(row, fn(value: &Row) -> usize { return Vector.length(&value.subtractions) })
  at = usize.ZERO
  while at < terms {
    let term = subtractionAt(row, at)
    if rowContainsInvocationQuantifier(&term.source) || rowContainsInvocationQuantifier(&term.removed) { return true }
    at = at + usize.ONE
  }
  return false
}

fn sameArgumentsHead(first: &Vector<Argument>, second: &Vector<Argument>, map: &[usize]) -> bool {
  let firstArguments = Vector.asSlice<Argument>(first)
  let secondArguments = Vector.asSlice<Argument>(second)
  if firstArguments.length != secondArguments.length {
    return false
  }
  let mut at = usize.ZERO
  while at < firstArguments.length {
    if !sameArgumentHead(&firstArguments[at], &secondArguments[at], map) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Compares one level: the variant, spellings, declarations, ordinals, access, qualifiers, modes,
// lifetimes, extents, and child counts. Child types and rows are compared by the caller.
fn sameResultOrdinals(left: &Vector<usize>, right: &Vector<usize>) -> bool {
  let first = Vector.asSlice<usize>(left)
  let second = Vector.asSlice<usize>(right)
  if first.length != second.length { return false }
  let mut at = usize.ZERO
  while at < first.length { if first[at] != second[at] { return false } at = at + usize.ONE }
  return true
}

fn witnessHead(left: &Shared<WitnessRecipe>, right: &Shared<WitnessRecipe>, map: &[usize], shape: bool) -> bool {
  let first = Shared.with<WitnessRecipe, WitnessRecipe>(left, CallableWitness.copy)
  let second = Shared.with<WitnessRecipe, WitnessRecipe>(right, CallableWitness.copy)
  if !sameDeclaration(&first.operation, &second.operation)
    || CallableWitness.argumentCount(&first) != CallableWitness.argumentCount(&second)
    || CallableWitness.bindingCount(&first) != CallableWitness.bindingCount(&second)
    || CallableWitness.loanCount(&first) != CallableWitness.loanCount(&second) { return false }
  let mut at = usize.ZERO
  while at < CallableWitness.bindingCount(&first) {
    let chosen = CallableWitness.bindingAt(&first, at)
    let compared = CallableWitness.bindingAt(&second, at)
    if chosen.ordinal != compared.ordinal || !sameDeclaration(&chosen.declaration, &compared.declaration) { return false }
    if shape {
      if argumentKind(&chosen.value) != argumentKind(&compared.value) { return false }
    } else { if !sameArgumentHead(&chosen.value, &compared.value, map) { return false } }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < CallableWitness.loanCount(&first) {
    let original = CallableWitness.loanAt(&first, at)
    let selected = CallableWitness.loanAt(&second, at)
    if let Option<Shared<Lifetime>>.Some {value: region} = move original {
      if let Option<Shared<Lifetime>>.Some {value: compared} = move selected {
        if !shape && !sameLifetime(&region, &compared, map) { return false }
      } else { return false }
    } else { if let Option<Shared<Lifetime>>.Some {..} = move selected { return false } }
    at = at + usize.ONE
  }
  return true
}

fn sameHead(first: &Type, second: &Type, map: &[usize]) -> bool {
  return match & first.* {
    Type.CallableResult {arguments, selected, selectedOrdinals, ..} => match &second.* {
      Type.CallableResult {arguments: other, selected: choices, selectedOrdinals: ordinals, ..} => Vector.length<Shared<Type>>(&arguments) == Vector.length<Shared<Type>>(&other)
        && sameArgumentsHead(&selected, &choices, map) && sameResultOrdinals(&selectedOrdinals, &ordinals)
      _ => false
    }
    Type.CallableWitnessResult {witness} => match &second.* {
      Type.CallableWitnessResult {witness: compared} => witnessHead(&witness, &compared, map, false)
      _ => false
    }
    Type.CallableOrigin {application, ..} => match &second.* {
      Type.CallableOrigin {application: compared, ..} => applicationHead(&application, &compared, map)
      _ => false
    }
    Type.CallableView {..} => match &second.* { Type.CallableView {..} => true _ => false }
    Type.Primitive {name} => match & second.* {
      Type.Primitive {name: compared} => sameBytes(Bytes.asSlice(&name), Bytes.asSlice(&compared))
      _ => false
    }
    Type.Unit => match & second.* {
      Type.Unit => true
      _ => false
    }
    Type.CallableValue {application, captures, fieldInputs, ..} => match &second.* {
      Type.CallableValue {application: compared, captures: otherCaptures, fieldInputs: otherInputs, ..} =>
        Vector.length<Shared<Type>>(&captures) == Vector.length<Shared<Type>>(&otherCaptures)
          && CallableFieldInput.allEqual(Vector.asSlice<CallableFieldInput>(&fieldInputs), Vector.asSlice<CallableFieldInput>(&otherInputs))
          && applicationHead(&application, &compared, map)
      _ => false
    }
    Type.CallableSchema {runtime, captures, ..} => match &second.* {
      Type.CallableSchema {runtime: other, captures: otherCaptures, ..} => callableRuntimeEquals(&runtime, &other)
        && Vector.length<Shared<Type>>(&captures) == Vector.length<Shared<Type>>(&otherCaptures)
      _ => false
    }
    Type.EffectComposite {operation, parts, ..} => match &second.* {
      Type.EffectComposite {operation: other, parts: otherParts, ..} => operation == other && Vector.length<Shared<Type>>(&parts) == Vector.length<Shared<Type>>(&otherParts)
      _ => false
    }
    Type.EffectJoin {alternatives, ..} => match &second.* {
      Type.EffectJoin {alternatives: other, ..} => Vector.length<Shared<Type>>(&alternatives) == Vector.length<Shared<Type>>(&other)
      _ => false
    }
    Type.CallableStage {captures, remaining, suffixMode, ..} => match &second.* {
      Type.CallableStage {captures: other, remaining: otherRemaining, suffixMode: otherMode, ..} =>
        remaining == otherRemaining && suffixMode == otherMode && Vector.length<Shared<Type>>(&captures) == Vector.length<Shared<Type>>(&other)
      _ => false
    }
    Type.Nominal {declaration, arguments, ..} => match & second.* {
      Type.Nominal {declaration: compared, arguments: otherArguments, ..} => DeclarationId.equals(&declaration, &compared) && sameArgumentsHead(
        &arguments,
        &otherArguments,
        map,
      )
      _ => false
    }
    Type.OpaqueRepresentation {application, detached, nonParking, ..} => match &second.* {
      Type.OpaqueRepresentation {application: compared, detached: otherDetached, nonParking: otherNonParking, ..} =>
        detached == otherDetached && nonParking == otherNonParking && applicationHead(&application, &compared, map)
      _ => false
    }
    Type.Parameter {declaration, ordinal} => match & second.* {
      Type.Parameter {declaration: compared, ordinal: otherOrdinal} => {
        if alphaMap(map) {
          return binderCompatible(map, ordinal, otherOrdinal)
        }
        return DeclarationId.equals(&declaration, &compared) && ordinal == otherOrdinal
      }
      _ => false
    }
    Type.String {lifetime} => match & second.* {
      Type.String {lifetime: compared} => sameLifetime(&lifetime, &compared, map)
      _ => false
    }
    Type.Reference {access, lifetime, ..} => match & second.* {
      Type.Reference {access: otherAccess, lifetime: otherLifetime, ..} => sameAccess(
        access,
        otherAccess,
      ) && sameLifetime(&lifetime, &otherLifetime, map)
      _ => false
    }
    Type.Slice {access, lifetime, ..} => match & second.* {
      Type.Slice {access: otherAccess, lifetime: otherLifetime, ..} => sameAccess(
        access,
        otherAccess,
      ) && sameLifetime(&lifetime, &otherLifetime, map)
      _ => false
    }
    Type.Pointer {access, nullable, multiplicity, alignment, ..} => match & second.* {
      Type.Pointer {
        access: otherAccess,
        nullable: otherNullable,
        multiplicity: otherMultiplicity,
        alignment: otherAlignment,
        ..,
      } => sameAccess(access, otherAccess) && nullable == otherNullable && sameMultiplicity(
        multiplicity,
        otherMultiplicity,
      ) && sameAlignment(&alignment, &otherAlignment)
      _ => false
    }
    Type.Array {extent, ..} => match & second.* {
      Type.Array {extent: otherExtent, ..} => sameBytes(
        Bytes.asSlice(&extent),
        Bytes.asSlice(&otherExtent),
      )
      _ => false
    }
    Type.Union {members} => match & second.* {
      Type.Union {members: compared} => Vector.length<Shared<Type>>(&members) == Vector.length<Shared<Type>>(&compared)
      _ => false
    }
    Type.Callable {mode, isUnsafe, environment, invocationBinders, invocationUse, invocationBounds, parameters, ..} => match & second.* {
      Type.Callable {
        mode: otherMode,
        isUnsafe: otherUnsafe,
        environment: otherEnvironment,
        invocationBinders: otherBinders,
        invocationUse: otherUse,
        invocationBounds: otherBounds,
        parameters: otherParameters,
        ..,
      } => sameMode(mode, otherMode) && isUnsafe == otherUnsafe && (projectionMap(map) || (invocationBinders == otherBinders && sameUse(
        invocationUse,
        otherUse,
        map,
      ) && sameEnvironment(
        &environment,
        &otherEnvironment,
        map,
      ) && sameOutlives(&invocationBounds, &otherBounds, map))) && Vector.length<Shared<Type>>(
        &parameters,
      ) == Vector.length<Shared<Type>>(&otherParameters)
      _ => false
    }
    Type.Effect {mode, environment, ..} => match & second.* {
      Type.Effect {mode: otherMode, environment: otherEnvironment, ..} => sameMode(mode, otherMode) && (projectionMap(map) || sameEnvironment(
        &environment,
        &otherEnvironment,
        map,
      ))
      _ => false
    }
    Type.ForeignFunction {behavior, ..} => match &second.* {
      Type.ForeignFunction {behavior: compared, ..} => ForeignContract.same(behavior, compared)
      _ => false
    }
    Type.TypeDescriptor {..} => match & second.* {
      Type.TypeDescriptor {..} => true
      _ => false
    }
    Type.Without {..} => match & second.* {
      Type.Without {..} => true
      _ => false
    }
    Type.Anonymous {occurrence, members} => match & second.* {
      Type.Anonymous {occurrence: compared, members: otherMembers} => Vector.length<Shared<Type>>(&members) == Vector.length<Shared<Type>>(&otherMembers) && AnonymousOccurrence.equalsShared(&occurrence, &compared)
      _ => false
    }
  }
}

/// How [`Type.unify`] treats lifetimes and structural sets.
pub enum Comparison {
  /// The lifetime-erased projection used only to ask whether two conformance heads could name one
  /// goal. Lifetimes, callable environments, and invocation binders are skipped and never bound; an
  /// open union or row is decided only on its containment fragment. Never evidence for selection.
  Projection,
  /// Exact evidence. A variable lifetime or `?R` binds; any other lifetime or closed row must be
  /// equal; a union matches only when equal or as the whole value of one variable.
  Exact,
}

/// The answer of one [`Type.unify`].
pub union Unification {
  /// Some assignment to the variables makes both sides equal; the bindings record one such.
  Unified,
  /// No assignment to the variables makes both sides equal.
  Distinct,
  /// The question is outside what this comparison decides; `at` is the undecided subterm.
  Undetermined {pub at: Shared<Type>},
}

/// One variable assignment recorded by [`Type.unify`].
pub struct Binding {
  /// The declaration that binds the variable.
  pub declaration: Shared<DeclarationId>
  /// The variable's position in its owner's complete binder list.
  pub ordinal: usize
  /// The assigned type, lifetime, or requirement row.
  pub value: Argument
}

// One variable, as its owner's index in the variable list and its binder ordinal; `owner` is
// `usize.MAX` for anything that is not a variable.
struct UnifySlot {
  owner: usize
  ordinal: usize
}

impl Copy for UnifySlot {}

fn noSlot() -> UnifySlot {
  return UnifySlot {owner: usize.MAX, ordinal: usize.MAX}
}

fn sameSlot(left: &UnifySlot, right: &UnifySlot) -> bool {
  return left.owner == right.owner && left.ordinal == right.ordinal
}

fn slotOf(declaration: &DeclarationId, ordinal: usize, variables: &[Shared<DeclarationId>]) -> UnifySlot {
  let mut at = usize.ZERO
  while at < variables.length {
    if declarationWith(declaration, &variables[at]) {
      return UnifySlot {owner: at, ordinal: ordinal}
    }
    at = at + usize.ONE
  }
  return noSlot()
}

fn typeSlot(value: &Type, variables: &[Shared<DeclarationId>]) -> UnifySlot {
  if let Type.Parameter {declaration, ordinal} = &value.* {
    return slotOf(&declaration, ordinal, variables)
  }
  return noSlot()
}

fn lifetimeSlot(value: &Lifetime, variables: &[Shared<DeclarationId>]) -> UnifySlot {
  if let Lifetime.Parameter {declaration, ordinal} = &value.* {
    return slotOf(&declaration, ordinal, variables)
  }
  return noSlot()
}

// Row parameters hold shared declarations, which may be the very handles listed as variables, so
// they are compared with the address-first `sameDeclaration`.
fn rowParameterSlot(row: &Row, at: usize, variables: &[Shared<DeclarationId>]) -> UnifySlot {
  let parameters = Vector.asSlice<RowParameter>(&row.parameters)
  let mut owner = usize.ZERO
  while owner < variables.length {
    if sameDeclaration(&parameters[at].declaration, &variables[owner]) {
      return UnifySlot {owner: owner, ordinal: parameters[at].ordinal}
    }
    owner = owner + usize.ONE
  }
  return noSlot()
}

fn rowParameterAt(row: &Row, at: usize) -> RowParameter {
  let parameters = Vector.asSlice<RowParameter>(&row.parameters)
  return RowParameter {
    declaration: Shared.clone<DeclarationId>(&parameters[at].declaration),
    ordinal: parameters[at].ordinal,
  }
}

fn rowParameterCount(row: &Row) -> usize {
  return Vector.length<RowParameter>(&row.parameters)
}

fn rowEntryCount(row: &Row) -> usize {
  return Vector.length<Requirement>(&row.entries)
}

fn rowSubtractionCount(row: &Row) -> usize {
  return Vector.length<RowSubtraction>(&row.subtractions)
}

fn rowSubtractionAt(row: &Row, at: usize) -> RowSubtraction {
  let terms = Vector.asSlice<RowSubtraction>(&row.subtractions)
  return RowSubtraction {
    source: Shared.clone<Row>(&terms[at].source),
    removed: Shared.clone<Row>(&terms[at].removed),
  }
}

fn subtractionCount(row: &Shared<Row>) -> usize {
  return Shared.with<Row, usize>(row, rowSubtractionCount)
}

fn subtractionAt(row: &Shared<Row>, at: usize) -> RowSubtraction {
  return Shared.with<Row, RowSubtraction>(
    row,
    fn(value: &Row) -> RowSubtraction {
      return rowSubtractionAt(value, at)
    },
  )
}

// The removed keys a retained term keeps, so equal terms compare equal however they were built:
// every key at the shared placeholder access, minus keys already decided for every residual entry.
// While the residual still has a row parameter, any key may matter to it.
effect fn termKeys(removed: &Shared<Row>, residual: &Row) -> Shared<Row>
! OutOfMemoryError
? &mut Allocator {
  let mut keys = Row.empty()
  let open = Vector.length<RowParameter>(&residual.parameters) != usize.ZERO || rowSubtractionCount(residual) != usize.ZERO
  let remaining = Vector.asSlice<Requirement>(&residual.entries)
  let count = Shared.with<Row, usize>(removed, rowEntryCount)
  let mut at = usize.ZERO
  while at < count {
    let key = entryAt(removed, at)
    let mut needed = open
    let mut entry = usize.ZERO
    while !needed && entry < remaining.length {
      let relation = run keyRelation(&remaining[entry], &key)
      if relation == Relation.Open {
        needed = true
      }
      entry = entry + usize.ONE
    }
    if needed {
      run Row.require(
        &mut keys,
        Requirement {capability: move key.capability, roleType: move key.roleType, access: Access.Shared},
      )
    }
    at = at + usize.ONE
  }
  let parameters = Shared.with<Row, usize>(removed, rowParameterCount)
  at = usize.ZERO
  while at < parameters {
    let parameter = Shared.with<Row, RowParameter>(
      removed,
      fn(value: &Row) -> RowParameter {
        return rowParameterAt(value, at)
      },
    )
    run Row.include(&mut keys, move parameter)
    at = at + usize.ONE
  }
  let terms = subtractionCount(removed)
  at = usize.ZERO
  while at < terms {
    run appendSubtraction(&mut keys, subtractionAt(removed, at))
    at = at + usize.ONE
  }
  return run Shared.make<Row>(move keys)
}

// Adds one subtraction term unless an equal term is already present.
effect fn appendSubtraction(row: &mut Row, term: RowSubtraction) -> ()
! OutOfMemoryError
? &mut Allocator {
  let none = Vector.make<usize>()
  let count = Vector.length<RowSubtraction>(&row.subtractions)
  let mut at = usize.ZERO
  while at < count {
    let existing = rowSubtractionAt(&row.*, at)
    if run sameRows(&existing.source, &term.source, Vector.asSlice<usize>(&none)) {
      if run sameRows(&existing.removed, &term.removed, Vector.asSlice<usize>(&none)) {
        return ()
      }
    }
    at = at + usize.ONE
  }
  run Vector.append<RowSubtraction>(&mut row.subtractions, move term)
  return ()
}

// Whether `left` has a subtraction term equal to `term` under `map`.
effect fn hasSubtraction(left: &Shared<Row>, term: &RowSubtraction, map: &[usize]) -> bool
! OutOfMemoryError
? &mut Allocator {
  let count = subtractionCount(left)
  let mut at = usize.ZERO
  while at < count {
    let candidate = subtractionAt(left, at)
    if run sameRows(&candidate.source, &term.source, map) {
      if run sameRows(&candidate.removed, &term.removed, map) {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn nominalHeadWith(first: &Type, right: &Shared<Type>) -> bool {
  return Shared.with<Type, bool>(
    right,
    fn(second: &Type) -> bool {
      if let Type.Nominal {declaration: left, ..} = &first.* {
        if let Type.Nominal {declaration: other, ..} = &second.* {
          return DeclarationId.equals(&left, &other)
        }
      }
      return true
    },
  )
}

// Whether two capabilities apply the same service declaration, or are not both nominal.
fn sameNominalHead(left: &Shared<Type>, right: &Shared<Type>) -> bool {
  if Shared.with<Type, usize>(left, addressOf) == Shared.with<Type, usize>(right, addressOf) {
    return true
  }
  return Shared.with<Type, bool>(
    left,
    fn(first: &Type) -> bool {
      return nominalHeadWith(first, right)
    },
  )
}

// How a source entry relates to one removed key, independent of access.
effect fn keyRelation(entry: &Requirement, key: &Requirement) -> Relation
! OutOfMemoryError
? &mut Allocator {
  let none = Vector.make<usize>()
  if run sameKey(entry, key, Vector.asSlice<usize>(&none)) {
    return Relation.Same
  }
  // Roles are parameter-free nominal declarations, so distinct roles stay distinct.
  if !run sameRole(&entry.roleType, &key.roleType, Vector.asSlice<usize>(&none)) {
    return Relation.Distinct
  }
  return memberRelation(&entry.capability, &key.capability)
}

// How two unequal members relate: distinct when their nominal heads differ or neither mentions a
// parameter, otherwise open.
fn memberRelation(member: &Shared<Type>, removed: &Shared<Type>) -> Relation {
  if !sameNominalHead(member, removed) {
    return Relation.Distinct
  }
  if !openType(member, false) && !openType(removed, false) {
    return Relation.Distinct
  }
  return Relation.Open
}

fn bindingAt(bindings: &[Binding], variables: &[Shared<DeclarationId>], slot: &UnifySlot) -> usize {
  let mut at = usize.ZERO
  while at < bindings.length {
    if bindings[at].ordinal == slot.ordinal && sameDeclaration(
      &bindings[at].declaration,
      &variables[slot.owner],
    ) {
      return at
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn hasSlot(slots: &[UnifySlot], slot: &UnifySlot) -> bool {
  let mut at = usize.ZERO
  while at < slots.length {
    if sameSlot(&slots[at], slot) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn larger(left: usize, right: usize) -> usize {
  if right > left {
    return right
  }
  return left
}

fn rank(value: &Unification) -> usize {
  return match & value.* {
    Unification.Unified => usize.ZERO
    Unification.Undetermined {..} => usize.ONE
    Unification.Distinct => 2
  }
}

fn isUnified(value: &Unification) -> bool {
  return rank(value) == usize.ZERO
}

fn isDistinct(value: &Unification) -> bool {
  return rank(value) == 2
}

// A definite mismatch anywhere decides the whole comparison: further constraints only remove
// solutions. Otherwise an undecided position keeps the whole comparison undecided.
fn copyUnification(value: &Unification) -> Unification {
  return match & value.* {
    Unification.Unified => Unification.Unified
    Unification.Distinct => Unification.Distinct
    Unification.Undetermined {at} => undetermined(&at)
  }
}

fn worse(current: &Unification, next: &Unification) -> Unification {
  if rank(next) > rank(current) {
    return copyUnification(next)
  }
  return copyUnification(current)
}

fn undetermined(at: &Shared<Type>) -> Unification {
  return Unification.Undetermined {at: Shared.clone<Type>(at)}
}

// Follows type bindings until the term is not a bound variable. Bindings are acyclic because each
// is made only after an occurs check.
fn resolvedType(term: &Shared<Type>, variables: &[Shared<DeclarationId>], bindings: &[Binding]) -> Shared<Type> {
  let mut current = Shared.clone<Type>(term)
  while true {
    let slot = Shared.with<Type, UnifySlot>(
      &current,
      fn(value: &Type) -> UnifySlot {
        return typeSlot(value, variables)
      },
    )
    if slot.owner == usize.MAX {
      return move current
    }
    let at = bindingAt(bindings, variables, &slot)
    if at == usize.MAX {
      return move current
    }
    let next = match & bindings[at].value {
      Argument.Type {value} => Shared.clone<Type>(&value)
      _ => {
        return move current
      }
    }
    current = move next
  }
  return move current
}

fn resolvedLifetime(
  term: &Shared<Lifetime>,
  variables: &[Shared<DeclarationId>],
  bindings: &[Binding],
) -> Shared<Lifetime> {
  let mut current = Shared.clone<Lifetime>(term)
  let mut followed = usize.ZERO
  while followed <= bindings.length {
    followed = followed + usize.ONE
    let slot = Shared.with<Lifetime, UnifySlot>(
      &current,
      fn(value: &Lifetime) -> UnifySlot {
        return lifetimeSlot(value, variables)
      },
    )
    if slot.owner == usize.MAX {
      return move current
    }
    let at = bindingAt(bindings, variables, &slot)
    if at == usize.MAX {
      return move current
    }
    let next = match & bindings[at].value {
      Argument.Lifetime {value} => Shared.clone<Lifetime>(&value)
      _ => {
        return move current
      }
    }
    current = move next
  }
  return move current
}

// Resolve only permitted inference owners, retaining the active original slot path. Seeded cycles
// yield no evidence; general applyBindings remains simultaneous and never calls this resolver.
effect fn resolvedLifetimeMeet(term: &Shared<Lifetime>, variables: &[Shared<DeclarationId>], bindings: &[Binding],
  active: &mut Vector<UnifySlot>) -> Option<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  let slot = Shared.with<Lifetime, UnifySlot>(term, fn(region: &Lifetime) -> UnifySlot {
    return lifetimeSlot(region, variables)
  })
  if slot.owner != usize.MAX {
    let supplied = bindingAt(bindings, variables, &slot)
    if supplied != usize.MAX {
      if hasSlot(Vector.asSlice<UnifySlot>(&active.*), &slot) { return Option.none<Shared<Lifetime>>() }
      if let Argument.Lifetime {value: selected} = &bindings[supplied].value {
        let mark = Vector.length<UnifySlot>(&active.*)
        run Vector.append<UnifySlot>(&mut active.*, UnifySlot {owner: slot.owner, ordinal: slot.ordinal})
        let result = run resolvedLifetimeMeet(&selected, variables, bindings, &mut active.*)
        Vector.truncate<UnifySlot>(&mut active.*, mark)
        return move result
      }
      return Option.none<Shared<Lifetime>>()
    }
  }
  let count = Lifetime.atomCount(term)
  if count == usize.ONE { return Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(term)) }
  let mut normalized = Vector.make<Shared<Lifetime>>()
  let mut at = usize.ZERO
  while at < count {
    let atom = Lifetime.atomAt(term, at)
    let resolved = run resolvedLifetimeMeet(&atom, variables, bindings, &mut active.*)
    let closed = match move resolved {
      Option<Shared<Lifetime>>.Some {value: resolvedAtom} => move resolvedAtom
      _ => { return Option.none<Shared<Lifetime>>() }
    }
    run Vector.append<Shared<Lifetime>>(&mut normalized, move closed)
    at = at + usize.ONE
  }
  return Option.some<Shared<Lifetime>>(run Lifetime.meet(Vector.asSlice<Shared<Lifetime>>(&normalized)))
}

fn lifetimeContainsSlot(term: &Shared<Lifetime>, slot: &UnifySlot, variables: &[Shared<DeclarationId>]) -> bool {
  let count = Lifetime.atomCount(term)
  let mut at = usize.ZERO
  while at < count {
    let atom = Lifetime.atomAt(term, at)
    let here = Shared.with<Lifetime, UnifySlot>(&atom, fn(region: &Lifetime) -> UnifySlot {
      return lifetimeSlot(region, variables)
    })
    if sameSlot(slot, &here) { return true }
    at = at + usize.ONE
  }
  return false
}

fn unionMember(value: &Shared<Type>, at: usize) -> Option<Shared<Type>> {
  return memberOf(value, at)
}

// How `slot` occurs in `term` once bindings are followed: zero when absent, one when only as a
// structural part, two when inside a union member or requirement row, where a set could absorb it.
fn occurrence(term: &Shared<Type>, slot: &UnifySlot, variables: &[Shared<DeclarationId>], bindings: &[Binding]) -> usize {
  let current = resolvedType(term, variables, bindings)
  let here = Shared.with<Type, UnifySlot>(
    &current,
    fn(value: &Type) -> UnifySlot {
      return typeSlot(value, variables)
    },
  )
  if sameSlot(&here, slot) {
    return usize.ONE
  }
  let mut found = usize.ZERO
  let count = Shared.with<Type, usize>(&current, childCount)
  let mut at = usize.ZERO
  while at < count {
    let child = Shared.with<Type, Option<Shared<Type>>>(
      &current,
      fn(value: &Type) -> Option<Shared<Type>> {
        return childAt(value, at)
      },
    )
    if let Option<Shared<Type>>.Some {value: nested} = move child {
      found = larger(found, occurrence(&nested, slot, variables, bindings))
    }
    if let Option<Shared<Row>>.Some {value: supplied} = move argumentRowOf(&current, at) {
      if rowMentions(&supplied, slot, variables, bindings) {
        found = 2
      }
    }
    at = at + usize.ONE
  }
  let members = Shared.with<Type, usize>(&current, unionLength)
  if members != usize.MAX {
    at = usize.ZERO
    while at < members {
      if let Option<Shared<Type>>.Some {value: member} = move unionMember(&current, at) {
        if occurrence(&member, slot, variables, bindings) > usize.ZERO {
          found = 2
        }
      }
      at = at + usize.ONE
    }
  }
  let requirementsFound = Shared.with<Type, Option<Shared<Row>>>(&current, rowOf)
  if let Option<Shared<Row>>.Some {value: requirements} = move requirementsFound {
    if rowMentions(&requirements, slot, variables, bindings) {
      found = 2
    }
  }
  return found
}

// Whether a row mentions `slot` as a row parameter or inside an entry, following bound rows.
fn rowMentions(row: &Shared<Row>, slot: &UnifySlot, variables: &[Shared<DeclarationId>], bindings: &[Binding]) -> bool {
  let entries = Shared.with<Row, usize>(row, rowEntryCount)
  let mut at = usize.ZERO
  while at < entries {
    let entry = entryAt(row, at)
    if occurrence(&entry.capability, slot, variables, bindings) > usize.ZERO {
      return true
    }
    if let Option<Shared<Type>>.Some {value: roleValue} = &entry.roleType {
      if occurrence(&roleValue, slot, variables, bindings) > usize.ZERO {
        return true
      }
    }
    at = at + usize.ONE
  }
  let parameters = Shared.with<Row, usize>(row, rowParameterCount)
  at = usize.ZERO
  while at < parameters {
    let here = Shared.with<Row, UnifySlot>(
      row,
      fn(value: &Row) -> UnifySlot {
        return rowParameterSlot(value, at, variables)
      },
    )
    if sameSlot(&here, slot) {
      return true
    }
    if here.owner != usize.MAX {
      let bound = bindingAt(bindings, variables, &here)
      if bound != usize.MAX {
        if let Argument.Row {value: supplied} = &bindings[bound].value {
          if rowMentions(&supplied, slot, variables, bindings) {
            return true
          }
        }
      }
    }
    at = at + usize.ONE
  }
  let terms = subtractionCount(row)
  at = usize.ZERO
  while at < terms {
    let term = subtractionAt(row, at)
    if rowMentions(&term.source, slot, variables, bindings) || rowMentions(&term.removed, slot, variables, bindings) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Whether a term still mentions an unbound variable once bindings are followed. Exact comparison
// also counts variable lifetimes, which the projection never binds.
// A seeded lifetime may resolve to a full meet. Inspect every actual atom without treating a
// rigid foreign meet as an inference variable; seeded cycles remain conservatively open.
fn lifetimeHasVariable(term: &Shared<Lifetime>, variables: &[Shared<DeclarationId>], bindings: &[Binding], remaining: usize) -> bool {
  let slot = Shared.with<Lifetime, UnifySlot>(term,
    fn(region: &Lifetime) -> UnifySlot { return lifetimeSlot(region, variables) })
  if slot.owner != usize.MAX {
    let supplied = bindingAt(bindings, variables, &slot)
    if supplied == usize.MAX || remaining == usize.ZERO { return true }
    if let Argument.Lifetime {value: selected} = &bindings[supplied].value {
      return lifetimeHasVariable(&selected, variables, bindings, remaining - usize.ONE)
    }
    return true
  }
  let count = Lifetime.atomCount(term)
  if count == usize.ONE { return false }
  let mut at = usize.ZERO
  while at < count {
    let atom = Lifetime.atomAt(term, at)
    if lifetimeHasVariable(&atom, variables, bindings, remaining) { return true }
    at = at + usize.ONE
  }
  return false
}

fn hasVariable(
  term: &Shared<Type>,
  variables: &[Shared<DeclarationId>],
  bindings: &[Binding],
  comparison: Comparison,
) -> bool {
  let current = resolvedType(term, variables, bindings)
  let here = Shared.with<Type, UnifySlot>(
    &current,
    fn(value: &Type) -> UnifySlot {
      return typeSlot(value, variables)
    },
  )
  if here.owner != usize.MAX {
    return true
  }
  if comparison == Comparison.Exact {
    let regions = Shared.with<Type, usize>(&current, comparedLifetimeCount)
    let mut region = usize.ZERO
    while region < regions {
      let found = Shared.with<Type, Option<Shared<Lifetime>>>(
        &current,
        fn(value: &Type) -> Option<Shared<Lifetime>> {
          return comparedLifetimeAt(value, region)
        },
      )
      if let Option<Shared<Lifetime>>.Some {value: lifetime} = move found {
        if lifetimeHasVariable(&lifetime, variables, bindings, bindings.length + usize.ONE) { return true }
      }
      region = region + usize.ONE
    }
    // Matching invocation binders is a later exact-matching step. Keep a quantified
    // callable undecided in a set or row even when none of its lifetimes is an impl variable.
    let quantified = Shared.with<Type, bool>(
      &current,
      fn(value: &Type) -> bool {
        return match & value.* {
          Type.Callable {invocationBinders, ..} => invocationBinders > usize.ZERO
          _ => false
        }
      },
    )
    if quantified {
      return true
    }
  }
  let count = Shared.with<Type, usize>(&current, childCount)
  let mut at = usize.ZERO
  while at < count {
    let child = Shared.with<Type, Option<Shared<Type>>>(
      &current,
      fn(value: &Type) -> Option<Shared<Type>> {
        return childAt(value, at)
      },
    )
    if let Option<Shared<Type>>.Some {value: nested} = move child {
      if hasVariable(&nested, variables, bindings, comparison) {
        return true
      }
    }
    if let Option<Shared<Row>>.Some {value: supplied} = move argumentRowOf(&current, at) {
      if rowHasVariable(&supplied, variables, bindings, comparison) {
        return true
      }
    }
    at = at + usize.ONE
  }
  let members = Shared.with<Type, usize>(&current, unionLength)
  if members != usize.MAX {
    at = usize.ZERO
    while at < members {
      if let Option<Shared<Type>>.Some {value: member} = move unionMember(&current, at) {
        if hasVariable(&member, variables, bindings, comparison) {
          return true
        }
      }
      at = at + usize.ONE
    }
  }
  let requirementsFound = Shared.with<Type, Option<Shared<Row>>>(&current, rowOf)
  if let Option<Shared<Row>>.Some {value: requirements} = move requirementsFound {
    return rowHasVariable(&requirements, variables, bindings, comparison)
  }
  return false
}

fn rowHasVariable(
  row: &Shared<Row>,
  variables: &[Shared<DeclarationId>],
  bindings: &[Binding],
  comparison: Comparison,
) -> bool {
  let entries = Shared.with<Row, usize>(row, rowEntryCount)
  let mut at = usize.ZERO
  while at < entries {
    let entry = entryAt(row, at)
    if hasVariable(&entry.capability, variables, bindings, comparison) {
      return true
    }
    if let Option<Shared<Type>>.Some {value: roleValue} = &entry.roleType {
      if hasVariable(&roleValue, variables, bindings, comparison) {
        return true
      }
    }
    at = at + usize.ONE
  }
  let parameters = Shared.with<Row, usize>(row, rowParameterCount)
  at = usize.ZERO
  while at < parameters {
    let here = Shared.with<Row, UnifySlot>(
      row,
      fn(value: &Row) -> UnifySlot {
        return rowParameterSlot(value, at, variables)
      },
    )
    if here.owner != usize.MAX {
      let bound = bindingAt(bindings, variables, &here)
      if bound == usize.MAX {
        return true
      }
      if let Argument.Row {value: supplied} = &bindings[bound].value {
        if rowHasVariable(&supplied, variables, bindings, comparison) {
          return true
        }
      }
    }
    at = at + usize.ONE
  }
  let terms = subtractionCount(row)
  at = usize.ZERO
  while at < terms {
    let term = subtractionAt(row, at)
    if rowHasVariable(&term.source, variables, bindings, comparison) || rowHasVariable(&term.removed, variables, bindings, comparison) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn sameArgumentKinds(first: &Vector<Argument>, second: &Vector<Argument>) -> bool {
  let firstArguments = Vector.asSlice<Argument>(first)
  let secondArguments = Vector.asSlice<Argument>(second)
  if firstArguments.length != secondArguments.length {
    return false
  }
  let mut at = usize.ZERO
  while at < firstArguments.length {
    if argumentKind(&firstArguments[at]) != argumentKind(&secondArguments[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Compares one level without any lifetime: the variant, spellings, declarations, argument kinds,
// accesses, qualifiers, modes, extents, and child counts.
fn sameCallableValueShape(first: &Type, second: &Type) -> bool {
  return match &first.* {
    Type.CallableValue {application, captures, fieldInputs, ..} => match &second.* {
      Type.CallableValue {application: other, captures: fields, fieldInputs: inputs, ..} =>
        Vector.length<Shared<Type>>(&captures) == Vector.length<Shared<Type>>(&fields)
          && CallableFieldInput.allEqual(Vector.asSlice<CallableFieldInput>(&fieldInputs), Vector.asSlice<CallableFieldInput>(&inputs))
          && applicationShape(&application, &other)
      _ => false }
    _ => false }
}

fn applicationShapeWith(first: &Application, right: &Shared<Application>) -> bool {
  return Shared.with<Application, bool>(right, fn(second: &Application) -> bool {
    return Application.sameShape(first, second)
  })
}

fn applicationShape(left: &Shared<Application>, right: &Shared<Application>) -> bool {
  if Shared.with<Application, usize>(left, applicationAddress) == Shared.with<Application, usize>(right, applicationAddress) { return true }
  return Shared.with<Application, bool>(left, fn(first: &Application) -> bool {
    return applicationShapeWith(first, right)
  })
}

fn sameShape(first: &Type, second: &Type) -> bool {
  return match & first.* {
    Type.Nominal {declaration, arguments, ..} => match & second.* {
      Type.Nominal {declaration: compared, arguments: otherArguments, ..} => DeclarationId.equals(&declaration, &compared) && sameArgumentKinds(
        &arguments,
        &otherArguments,
      )
      _ => false
    }
    Type.String {..} => match & second.* {
      Type.String {..} => true
      _ => false
    }
    Type.Reference {access, ..} => match & second.* {
      Type.Reference {access: otherAccess, ..} => sameAccess(access, otherAccess)
      _ => false
    }
    Type.Slice {access, ..} => match & second.* {
      Type.Slice {access: otherAccess, ..} => sameAccess(access, otherAccess)
      _ => false
    }
    Type.CallableResult {arguments, selected, selectedOrdinals, ..} => match &second.* {
      Type.CallableResult {arguments: otherArguments, selected: otherSelected, selectedOrdinals: otherOrdinals, ..} =>
        Vector.length<Shared<Type>>(&arguments) == Vector.length<Shared<Type>>(&otherArguments)
          && sameArgumentKinds(&selected, &otherSelected) && sameResultOrdinals(&selectedOrdinals, &otherOrdinals)
      _ => false
    }
    Type.CallableWitnessResult {witness} => match &second.* {
      Type.CallableWitnessResult {witness: compared} => {
        let map = Vector.make<usize>()
        return witnessHead(&witness, &compared, Vector.asSlice<usize>(&map), true)
      }
      _ => false
    }
    Type.CallableOrigin {application, ..} => match &second.* {
      Type.CallableOrigin {application: compared, ..} => applicationShape(&application, &compared)
      _ => false
    }
    Type.CallableValue {..} => {
      // Argument kinds/slots are fixed; their evidence unifies below, including lifetimes.
      return sameCallableValueShape(first, second)
    }
    Type.OpaqueRepresentation {application, detached, nonParking, ..} => match &second.* {
      Type.OpaqueRepresentation {application: compared, detached: otherDetached, nonParking: otherNonParking, ..} =>
        detached == otherDetached && nonParking == otherNonParking && applicationShape(&application, &compared)
      _ => false
    }
    Type.Callable {mode, isUnsafe, parameters, ..} => match & second.* {
      Type.Callable {mode: otherMode, isUnsafe: otherUnsafe, parameters: otherParameters, ..} => sameMode(
        mode,
        otherMode,
      ) && isUnsafe == otherUnsafe && Vector.length<Shared<Type>>(&parameters) == Vector.length<Shared<Type>>(&otherParameters)
      _ => false
    }
    Type.Effect {mode, ..} => match & second.* {
      Type.Effect {mode: otherMode, ..} => sameMode(mode, otherMode)
      _ => false
    }
    _ => {
      let none = Vector.make<usize>()
      return sameHead(first, second, Vector.asSlice<usize>(&none))
    }
  }
}

fn argumentKind(value: &Argument) -> usize {
  return match & value.* {
    Argument.Type {..} => usize.ZERO
    Argument.Lifetime {..} => usize.ONE
    Argument.Row {..} => 2
  }
}

fn shapeWith(first: &Type, right: &Shared<Type>) -> bool {
  return Shared.with<Type, bool>(
    right,
    fn(second: &Type) -> bool {
      return sameShape(first, second)
    },
  )
}

fn isExecutable(value: &Type) -> bool {
  return match & value.* {
    Type.Callable {..} => true
    Type.Effect {..} => true
    _ => false
  }
}

// Exact comparison of an executable's invocation binders, outlives bounds, and environment.
// Invocation ordinals are canonical first-occurrence positions, so equal ordinals are the
// binder bijection for two otherwise equal executable contracts.
fn plainExecutable(first: &Type, second: &Type) -> bool {
  let none = Vector.make<usize>()
  let map = Vector.asSlice<usize>(&none)
  return match & first.* {
    Type.Callable {invocationBinders, invocationUse, invocationBounds, environment, ..} => match & second.* {
      Type.Callable {
        invocationBinders: otherBinders,
        invocationUse: otherUse,
        invocationBounds: otherBounds,
        environment: otherEnvironment,
        ..,
      } => invocationBinders == otherBinders && invocationUse == otherUse && sameOutlives(
        &invocationBounds,
        &otherBounds,
        map,
      ) && sameEnvironment(&environment, &otherEnvironment, map)
      _ => false
    }
    Type.Effect {environment, ..} => match & second.* {
      Type.Effect {environment: otherEnvironment, ..} => sameEnvironment(
        &environment,
        &otherEnvironment,
        map,
      )
      _ => false
    }
    _ => true
  }
}

fn plainExecutableWith(first: &Type, right: &Shared<Type>) -> bool {
  return Shared.with<Type, bool>(right, fn(second: &Type) -> bool {
    return plainExecutable(first, second)
  })
}

// Invocation quantifiers are fixed parts of a callable contract. Environment inference must not
// turn a different binder count or outlives relation into a compatible callable.
fn sameExecutableInvocation(first: &Type, second: &Type) -> bool {
  let none = Vector.make<usize>()
  let map = Vector.asSlice<usize>(&none)
  return match & first.* {
    Type.Callable {invocationBinders, invocationUse, invocationBounds, ..} => match & second.* {
      Type.Callable {invocationBinders: otherBinders, invocationUse: otherUse, invocationBounds: otherBounds, ..} =>
        invocationBinders == otherBinders && invocationUse == otherUse && sameOutlives(&invocationBounds, &otherBounds, map)
      _ => false
    }
    Type.Effect {..} => match & second.* { Type.Effect {..} => true _ => false }
    _ => true
  }
}

fn sameExecutableInvocationWith(first: &Type, second: &Shared<Type>) -> bool {
  return Shared.with<Type, bool>(second, fn(value: &Type) -> bool {
    return sameExecutableInvocation(first, value)
  })
}

fn executableEnvironment(value: &Type) -> Option<Shared<Intersection>> {
  return match & value.* {
    Type.Callable {environment, ..} => Option.some<Shared<Intersection>>(Shared.clone<Intersection>(&environment))
    Type.Effect {environment, ..} => Option.some<Shared<Intersection>>(Shared.clone<Intersection>(&environment))
    _ => Option.none<Shared<Intersection>>()
  }
}

// Resolving before canonicalization is significant: a binding may turn a member into `'static`
// or make two formerly distinct members equal.
effect fn resolvedEnvironment(
  environment: &Shared<Intersection>,
  variables: &[Shared<DeclarationId>],
  bindings: &[Binding],
) -> Option<Shared<Intersection>> ! OutOfMemoryError ? &mut Allocator {
  let mut regions = Vector.make<Shared<Lifetime>>()
  let mut active = Vector.make<UnifySlot>()
  let count = environmentSize(environment)
  let mut at = usize.ZERO
  while at < count {
    let member = environmentMember(environment, at)
    if let Option<Shared<Lifetime>>.Some {value} = move member {
      let selected = run resolvedLifetimeMeet(&value, variables, bindings, &mut active)
      let resolved = match move selected {
        Option<Shared<Lifetime>>.Some {value: normalized} => move normalized
        _ => { return Option.none<Shared<Intersection>>() }
      }
      run Vector.append<Shared<Lifetime>>(&mut regions, move resolved)
    }
    at = at + usize.ONE
  }
  return Option.some<Shared<Intersection>>(run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions))))
}

fn environmentContains(environment: &Shared<Intersection>, candidate: &Shared<Lifetime>) -> bool {
  let count = environmentSize(environment)
  let mut at = usize.ZERO
  while at < count {
    let member = environmentMember(environment, at)
    if let Option<Shared<Lifetime>>.Some {value} = move member {
      if Lifetime.equalsShared(&value, candidate) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

fn environmentEquals(left: &Shared<Intersection>, right: &Shared<Intersection>) -> bool {
  if environmentSize(left) != environmentSize(right) { return false }
  let count = environmentSize(left)
  let mut at = usize.ZERO
  while at < count {
    let member = environmentMember(left, at)
    if let Option<Shared<Lifetime>>.Some {value} = move member {
      if !environmentContains(right, &value) { return false }
    }
    at = at + usize.ONE
  }
  return true
}

fn environmentOnSide<'a>(
  firstSide: bool,
  first: &'a Shared<Intersection>,
  second: &'a Shared<Intersection>,
) -> &'a Shared<Intersection> {
  if firstSide { return first }
  return second
}

fn environmentHasSlot(
  environment: &Shared<Intersection>,
  slot: &UnifySlot,
  variables: &[Shared<DeclarationId>],
) -> bool {
  let count = environmentSize(environment)
  let mut at = usize.ZERO
  while at < count {
    let member = environmentMember(environment, at)
    if let Option<Shared<Lifetime>>.Some {value} = move member {
      let here = Shared.with<Lifetime, UnifySlot>(&value, fn(region: &Lifetime) -> UnifySlot {
        return lifetimeSlot(region, variables)
      })
      if sameSlot(&here, slot) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

// Finds the sole declaration-owned, explicitly bindable member across both normalized sets.
// Multiple open members describe an ambiguous set equation and are deliberately left undecided.
fn soleEnvironmentSlot(
  left: &Shared<Intersection>,
  right: &Shared<Intersection>,
  variables: &[Shared<DeclarationId>],
) -> UnifySlot {
  let mut found = UnifySlot {owner: usize.MAX, ordinal: usize.MAX}
  let mut seen = usize.ZERO
  let mut side = usize.ZERO
  while side < 2 {
    let environment = environmentOnSide(side == usize.ZERO, left, right)
    let count = environmentSize(environment)
    let mut at = usize.ZERO
    while at < count {
      let member = environmentMember(environment, at)
      if let Option<Shared<Lifetime>>.Some {value} = move member {
        let slot = Shared.with<Lifetime, UnifySlot>(&value, fn(region: &Lifetime) -> UnifySlot {
          return lifetimeSlot(region, variables)
        })
        if slot.owner != usize.MAX {
          found = slot
          seen = seen + usize.ONE
        }
      }
      at = at + usize.ONE
    }
    side = side + usize.ONE
  }
  if seen != usize.ONE { return UnifySlot {owner: usize.MAX, ordinal: usize.MAX} }
  return found
}

fn environmentWithoutSlotCovered(
  variableSide: &Shared<Intersection>,
  fixedSide: &Shared<Intersection>,
  slot: &UnifySlot,
  variables: &[Shared<DeclarationId>],
) -> bool {
  let count = environmentSize(variableSide)
  let mut at = usize.ZERO
  while at < count {
    let member = environmentMember(variableSide, at)
    if let Option<Shared<Lifetime>>.Some {value} = move member {
      let here = Shared.with<Lifetime, UnifySlot>(&value, fn(region: &Lifetime) -> UnifySlot {
        return lifetimeSlot(region, variables)
      })
      if !sameSlot(&here, slot) && !environmentContains(fixedSide, &value) { return false }
    }
    at = at + usize.ONE
  }
  return true
}

effect fn unmatchedEnvironmentMeet(fixedSide: &Shared<Intersection>, variableSide: &Shared<Intersection>)
  -> Shared<Lifetime> ! OutOfMemoryError ? &mut Allocator {
  let mut residual = Vector.make<Shared<Lifetime>>()
  let count = environmentSize(fixedSide)
  let mut at = usize.ZERO
  while at < count {
    if let Option<Shared<Lifetime>>.Some {value: member} = move environmentMember(fixedSide, at) {
      if !environmentContains(variableSide, &member) { run Vector.append<Shared<Lifetime>>(&mut residual, move member) }
    }
    at = at + usize.ONE
  }
  return run Lifetime.meet(Vector.asSlice<Shared<Lifetime>>(&residual))
}

impl Type {
  /// The environment a callable or Effect type retains; None for every other type.
  pub fn retainedEnvironment(value: &Type) -> Option<Shared<Intersection>> {
    return executableEnvironment(value)
  }
  /// Solves an exact canonical environment equation transactionally. One permitted unknown may
  /// acquire the entire unmatched meet; several unknown members never choose a partition.
  pub effect fn unifyEnvironments(leftRaw: &Shared<Intersection>, rightRaw: &Shared<Intersection>,
    at: &Shared<Type>, variables: &[Shared<DeclarationId>], bindings: &mut Vector<Binding>)
    -> Unification ! OutOfMemoryError ? &mut Allocator {
    let left = match move run resolvedEnvironment(leftRaw, variables, Vector.asSlice<Binding>(&bindings.*)) {
      Option<Shared<Intersection>>.Some {value: normalizedLeft} => move normalizedLeft
      _ => { return undetermined(at) }
    }
    let right = match move run resolvedEnvironment(rightRaw, variables, Vector.asSlice<Binding>(&bindings.*)) {
      Option<Shared<Intersection>>.Some {value: normalizedRight} => move normalizedRight
      _ => { return undetermined(at) }
    }
    if environmentEquals(&left, &right) { return Unification.Unified }
    let slot = soleEnvironmentSlot(&left, &right, variables)
    if slot.owner == usize.MAX { return undetermined(at) }
    let leftHas = environmentHasSlot(&left, &slot, variables)
    let variableSide = environmentOnSide(leftHas, &left, &right)
    let fixedSide = environmentOnSide(!leftHas, &left, &right)
    if !environmentWithoutSlotCovered(variableSide, fixedSide, &slot, variables) { return undetermined(at) }
    let candidate = run unmatchedEnvironmentMeet(fixedSide, variableSide)
    if lifetimeContainsSlot(&candidate, &slot, variables) { return undetermined(at) }
    let mark = Vector.length<Binding>(&bindings.*)
    run bindVariable(&slot, Argument.Lifetime {value: move candidate}, variables, &mut bindings.*)
    let provedLeft = run resolvedEnvironment(leftRaw, variables, Vector.asSlice<Binding>(&bindings.*))
    let provedRight = run resolvedEnvironment(rightRaw, variables, Vector.asSlice<Binding>(&bindings.*))
    if let Option<Shared<Intersection>>.Some {value: completedLeft} = move provedLeft {
      if let Option<Shared<Intersection>>.Some {value: completedRight} = move provedRight {
        if environmentEquals(&completedLeft, &completedRight) { return Unification.Unified }
      }
    }
    Vector.truncate<Binding>(&mut bindings.*, mark)
    return undetermined(at)
  }
}

effect fn unifyExecutableEnvironment(first: &Shared<Type>, second: &Shared<Type>,
  variables: &[Shared<DeclarationId>], bindings: &mut Vector<Binding>) -> Unification
! OutOfMemoryError ? &mut Allocator {
  let leftFound = Shared.with<Type, Option<Shared<Intersection>>>(first, executableEnvironment)
  let rightFound = Shared.with<Type, Option<Shared<Intersection>>>(second, executableEnvironment)
  if let Option<Shared<Intersection>>.Some {value: leftRaw} = move leftFound {
    if let Option<Shared<Intersection>>.Some {value: rightRaw} = move rightFound {
      return run Type.unifyEnvironments(&leftRaw, &rightRaw, first, variables, &mut bindings.*)
    }
  }
  return Unification.Distinct
}

effect fn bindVariable(
  slot: &UnifySlot,
  value: Argument,
  variables: &[Shared<DeclarationId>],
  bindings: &mut Vector<Binding>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  run Vector.append<Binding>(
    &mut bindings.*,
    Binding {
      declaration: Shared.clone<DeclarationId>(&variables[slot.owner]),
      ordinal: slot.ordinal,
      value: move value,
    },
  )
  return ()
}

// Binds a type variable after the occurs check. An occurrence only as a structural part has no
// finite solution; one inside a union or row could be absorbed by that set, so it is undecided.
effect fn bindType(
  slot: &UnifySlot,
  term: &Shared<Type>,
  variables: &[Shared<DeclarationId>],
  bindings: &mut Vector<Binding>,
  absorbed: &[UnifySlot],
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  if hasSlot(absorbed, slot) {
    return undetermined(term)
  }
  let occurs = occurrence(term, slot, variables, Vector.asSlice<Binding>(&bindings.*))
  if occurs == usize.ONE {
    return Unification.Distinct
  }
  if occurs == 2 {
    return undetermined(term)
  }
  run bindVariable(slot, Argument.Type {value: Shared.clone<Type>(term)}, variables, &mut bindings.*)
  return Unification.Unified
}

effect fn unifyLifetimes(
  left: &Shared<Lifetime>,
  right: &Shared<Lifetime>,
  at: &Shared<Type>,
  variables: &[Shared<DeclarationId>],
  bindings: &mut Vector<Binding>,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let mut active = Vector.make<UnifySlot>()
  let first = match move run resolvedLifetimeMeet(left, variables, Vector.asSlice<Binding>(&bindings.*), &mut active) {
    Option<Shared<Lifetime>>.Some {value: resolvedLeft} => move resolvedLeft
    _ => { return undetermined(at) }
  }
  let second = match move run resolvedLifetimeMeet(right, variables, Vector.asSlice<Binding>(&bindings.*), &mut active) {
    Option<Shared<Lifetime>>.Some {value: resolvedRight} => move resolvedRight
    _ => { return undetermined(at) }
  }
  let firstSlot = Shared.with<Lifetime, UnifySlot>(
    &first,
    fn(value: &Lifetime) -> UnifySlot {
      return lifetimeSlot(value, variables)
    },
  )
  let secondSlot = Shared.with<Lifetime, UnifySlot>(
    &second,
    fn(value: &Lifetime) -> UnifySlot {
      return lifetimeSlot(value, variables)
    },
  )
  if firstSlot.owner != usize.MAX {
    if !sameSlot(&firstSlot, &secondSlot) {
      if lifetimeContainsSlot(&second, &firstSlot, variables) { return undetermined(at) }
      run bindVariable(&firstSlot, Argument.Lifetime {value: move second}, variables, &mut bindings.*)
    }
    return Unification.Unified
  }
  if secondSlot.owner != usize.MAX {
    if lifetimeContainsSlot(&first, &secondSlot, variables) { return undetermined(at) }
    run bindVariable(&secondSlot, Argument.Lifetime {value: move first}, variables, &mut bindings.*)
    return Unification.Unified
  }
  let firstInvocation = Shared.with<Lifetime, usize>(&first, invocationOrdinal)
  let secondInvocation = Shared.with<Lifetime, usize>(&second, invocationOrdinal)
  if firstInvocation != usize.MAX || secondInvocation != usize.MAX {
    if firstInvocation == secondInvocation {
      return Unification.Unified
    }
    return Unification.Distinct
  }
  if Lifetime.equalsShared(&first, &second) { return Unification.Unified }
  if Lifetime.atomCount(&first) > usize.ONE || Lifetime.atomCount(&second) > usize.ONE {
    let mut open = false
    let mut side = usize.ZERO
    while side < 2 {
      let selected = environmentLifetimeOnSide(side == usize.ZERO, &first, &second)
      let atoms = Lifetime.atomCount(selected)
      let mut atomAt = usize.ZERO
      while atomAt < atoms {
        let atom = Lifetime.atomAt(selected, atomAt)
        let slot = Shared.with<Lifetime, UnifySlot>(&atom, fn(region: &Lifetime) -> UnifySlot {
          return lifetimeSlot(region, variables)
        })
        open = open || slot.owner != usize.MAX
        atomAt = atomAt + usize.ONE
      }
      side = side + usize.ONE
    }
    if open {
      let mut one = Vector.make<Shared<Lifetime>>()
      run Vector.append<Shared<Lifetime>>(&mut one, Shared.clone<Lifetime>(&first))
      let leftSet = run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&one)))
      Vector.clear<Shared<Lifetime>>(&mut one)
      run Vector.append<Shared<Lifetime>>(&mut one, Shared.clone<Lifetime>(&second))
      let rightSet = run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&one)))
      return run Type.unifyEnvironments(&leftSet, &rightSet, at, variables, &mut bindings.*)
    }
  }
  return Unification.Distinct
}

fn environmentLifetimeOnSide<'a>(firstSide: bool, first: &'a Shared<Lifetime>, second: &'a Shared<Lifetime>) -> &'a Shared<Lifetime> {
  if firstSide { return first }
  return second
}

// A union or single type as a list of set members.
effect fn setMembers(value: &Shared<Type>) -> Vector<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  let members = Shared.with<Type, usize>(value, unionLength)
  let mut listed = Vector.make<Shared<Type>>()
  if members == usize.MAX {
    run Vector.append<Shared<Type>>(&mut listed, Shared.clone<Type>(value))
    return move listed
  }
  let mut at = usize.ZERO
  while at < members {
    if let Option<Shared<Type>>.Some {value: member} = move unionMember(value, at) {
      run Vector.append<Shared<Type>>(&mut listed, move member)
    }
    at = at + usize.ONE
  }
  return move listed
}

// Only established assignments of this comparison's variable owners may rewrite its terms.
effect fn comparisonBindings(variables: &[Shared<DeclarationId>], bindings: &[Binding])
  -> Vector<Binding> ! OutOfMemoryError ? &mut Allocator {
  let mut established = Vector.make<Binding>()
  let mut at = usize.ZERO
  while at < bindings.length {
    // Binding owners can be the very shared handles in variables; compare address-first rather
    // than nesting a borrow of the same declaration through slotOf.
    let mut owner = usize.ZERO
    while owner < variables.length && !sameDeclaration(&bindings[at].declaration, &variables[owner]) {
      owner = owner + usize.ONE
    }
    if owner < variables.length {
      run Vector.append<Binding>(&mut established, Binding {
        declaration: Shared.clone<DeclarationId>(&bindings[at].declaration), ordinal: bindings[at].ordinal,
        value: Argument.copy(&bindings[at].value)})
    }
    at = at + usize.ONE
  }
  return move established
}

// Follow the acyclic established assignment graph without changing simultaneous substitution.
effect fn comparisonType(value: &Shared<Type>, established: &[Binding]) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let mut current = Shared.clone<Type>(value)
  let mut pass = usize.ZERO
  while pass < established.length {
    current = run Type.applyBindings(&current, established, true)
    pass = pass + usize.ONE
  }
  return move current
}

// A private comparison view of fixed members under the unifier's established bindings. General
// substitution is simultaneous, so follow at most one edge per pass for each binding in the
// acyclic assignment graph. Restrict substitution to the same owner whitelist as resolvedType;
// foreign seeds remain rigid. Reuse the substitution walker for nested types, lifetimes, rows and
// quantified barriers, then flatten and deduplicate the resulting set. No inference state changes.
effect fn fixedSetMembers(
  members: &[Shared<Type>],
  variables: &[Shared<DeclarationId>],
  bindings: &[Binding],
) -> Vector<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  let established = run comparisonBindings(variables, bindings)
  let selected = Vector.asSlice<Binding>(&established)
  let mut result = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < members.length {
    let current = run comparisonType(&members[at], selected)
    run Type.joinMember(&mut result, &current)
    at = at + usize.ONE
  }
  return move result
}

// Every member of `members` equals some member of `candidates`. Both sides are free of unbound
// variables, so no comparison binds.
effect fn setIncluded(
  members: &[Shared<Type>],
  candidates: &[Shared<Type>],
  comparison: Comparison,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let mut result = Unification.Unified
  let mut at = usize.ZERO
  while at < members.length {
    let mut found = Unification.Distinct
    let mut other = usize.ZERO
    while !isUnified(&found) && other < candidates.length {
      let mut equal = false
      if comparison == Comparison.Projection {
        equal = run Type.projectEquals(&members[at], &candidates[other])
      } else {
        equal = run Type.equalsShared(&members[at], &candidates[other])
      }
      if equal {
        found = Unification.Unified
      }
      other = other + usize.ONE
    }
    result = worse(&result, &found)
    if isDistinct(&result) {
      return move result
    }
    at = at + usize.ONE
  }
  return move result
}

// A set member can contain a bindable parameter. Try source-independent pairings under one shared
// assignment, restoring both bindings and absorbed-set marks after every failed alternative.
// A successful pairing proves overlap or exact equality; callers retain Undetermined for a failed
// search because later substitution can collapse distinct written members into one set member.
effect fn matchSetPermutation(
  left: &[Shared<Type>],
  right: &[Shared<Type>],
  variables: &[Shared<DeclarationId>],
  comparison: Comparison,
  bindings: &mut Vector<Binding>,
  absorbed: &mut Vector<UnifySlot>,
  used: &mut Vector<bool>,
  at: usize,
  site: &Shared<Type>,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  if at == left.length {
    return Unification.Unified
  }
  let mut uncertain = false
  let mut candidate = usize.ZERO
  while candidate < right.length {
    if !Vector.asSlice<bool>(&used.*)[candidate] {
      let bindingMark = Vector.length<Binding>(&bindings.*)
      let absorbedMark = Vector.length<UnifySlot>(&absorbed.*)
      let compared = run unifyTerms(
        &left[at],
        &right[candidate],
        variables,
        comparison,
        &mut bindings.*,
        &mut absorbed.*,
      )
      if isUnified(&compared) {
        Vector.set<bool>(&mut used.*, candidate, true)
        let matched = run matchSetPermutation(
          left,
          right,
          variables,
          comparison,
          &mut bindings.*,
          &mut absorbed.*,
          &mut used.*,
          at + usize.ONE,
          site,
        )
        Vector.set<bool>(&mut used.*, candidate, false)
        if isUnified(&matched) {
          return move matched
        }
        if !isDistinct(&matched) {
          uncertain = true
        }
      } else if !isDistinct(&compared) {
        uncertain = true
      }
      Vector.truncate<Binding>(&mut bindings.*, bindingMark)
      Vector.truncate<UnifySlot>(&mut absorbed.*, absorbedMark)
    }
    candidate = candidate + usize.ONE
  }
  if uncertain {
    return undetermined(site)
  }
  return Unification.Distinct
}

fn hasBareSetVariable(
  members: &[Shared<Type>],
  variables: &[Shared<DeclarationId>],
  bindings: &[Binding],
) -> bool {
  let mut at = usize.ZERO
  while at < members.length {
    let member = resolvedType(&members[at], variables, bindings)
    let slot = Shared.with<Type, UnifySlot>(
      &member,
      fn(value: &Type) -> UnifySlot {
        return typeSlot(value, variables)
      },
    )
    if slot.owner != usize.MAX {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

effect fn setMayCollapse(
  members: &[Shared<Type>],
  variables: &[Shared<DeclarationId>],
  bindings: &mut Vector<Binding>,
  absorbed: &mut Vector<UnifySlot>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < members.length {
    let mut other = at + usize.ONE
    while other < members.length {
      let bindingMark = Vector.length<Binding>(&bindings.*)
      let absorbedMark = Vector.length<UnifySlot>(&absorbed.*)
      let compared = run unifyTerms(
        &members[at],
        &members[other],
        variables,
        Comparison.Projection,
        &mut bindings.*,
        &mut absorbed.*,
      )
      Vector.truncate<Binding>(&mut bindings.*, bindingMark)
      Vector.truncate<UnifySlot>(&mut absorbed.*, absorbedMark)
      if !isDistinct(&compared) {
        return true
      }
      other = other + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

// Unions compare as sets. Equal closed sets are decided exactly. The projection also decides the
// containment fragment: every member is either free of variables or a bare, still unbound variable
// seen by no other position. Such a side covers exactly the sets containing its fixed members, so
// one open side matches a closed set iff its fixed members are all in that set, and two open sides
// always match. The variables are then absorbed and may not be bound later. Nested variables can
// also prove a same-size pairing under one assignment. An unsuccessful pairing remains undecided
// because substitution can change the normalized set size; every other open set under exact
// comparison is likewise undecided.
effect fn unifySets(
  first: &Shared<Type>,
  second: &Shared<Type>,
  variables: &[Shared<DeclarationId>],
  comparison: Comparison,
  bindings: &mut Vector<Binding>,
  absorbed: &mut Vector<UnifySlot>,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let firstMembers = run setMembers(first)
  let secondMembers = run setMembers(second)
  let mut firstFixed = Vector.make<Shared<Type>>()
  let mut secondFixed = Vector.make<Shared<Type>>()
  let mut firstOpen = Vector.make<UnifySlot>()
  let mut secondOpen = Vector.make<UnifySlot>()
  let firstSplit = run splitSet(
    Vector.asSlice<Shared<Type>>(&firstMembers),
    variables,
    comparison,
    Vector.asSlice<Binding>(&bindings.*),
    Vector.asSlice<UnifySlot>(&absorbed.*),
    &mut firstFixed,
    &mut firstOpen,
  )
  let secondSplit = run splitSet(
    Vector.asSlice<Shared<Type>>(&secondMembers),
    variables,
    comparison,
    Vector.asSlice<Binding>(&bindings.*),
    Vector.asSlice<UnifySlot>(&absorbed.*),
    &mut secondFixed,
    &mut secondOpen,
  )
  if !firstSplit || !secondSplit {
    let bareOpen = hasBareSetVariable(
      Vector.asSlice<Shared<Type>>(&firstMembers),
      variables,
      Vector.asSlice<Binding>(&bindings.*),
    ) || hasBareSetVariable(
      Vector.asSlice<Shared<Type>>(&secondMembers),
      variables,
      Vector.asSlice<Binding>(&bindings.*),
    )
    if (comparison != Comparison.Exact || !bareOpen) && Vector.length<Shared<Type>>(&firstMembers) == Vector.length<Shared<Type>>(&secondMembers) {
      let mut used = Vector.make<bool>()
      let mut at = usize.ZERO
      while at < Vector.length<Shared<Type>>(&secondMembers) {
        run Vector.append<bool>(&mut used, false)
        at = at + usize.ONE
      }
      let paired = run matchSetPermutation(
        Vector.asSlice<Shared<Type>>(&firstMembers),
        Vector.asSlice<Shared<Type>>(&secondMembers),
        variables,
        comparison,
        &mut bindings.*,
        &mut absorbed.*,
        &mut used,
        usize.ZERO,
        first,
      )
      if isUnified(&paired) {
        return move paired
      }
      if isDistinct(&paired) && !bareOpen {
        let firstMayCollapse = run setMayCollapse(
          Vector.asSlice<Shared<Type>>(&firstMembers),
          variables,
          &mut bindings.*,
          &mut absorbed.*,
        )
        let secondMayCollapse = run setMayCollapse(
          Vector.asSlice<Shared<Type>>(&secondMembers),
          variables,
          &mut bindings.*,
          &mut absorbed.*,
        )
        if !firstMayCollapse && !secondMayCollapse {
          return Unification.Distinct
        }
      }
    }
    return undetermined(first)
  }
  // splitSet proves there are no unresolved nested variables in these fixed members; the
  // stored syntax can still contain bound ones. Compare normalized views in both directions.
  if Vector.length<Binding>(&bindings.*) > usize.ZERO {
    firstFixed = run fixedSetMembers(Vector.asSlice<Shared<Type>>(&firstFixed), variables,
      Vector.asSlice<Binding>(&bindings.*))
    secondFixed = run fixedSetMembers(Vector.asSlice<Shared<Type>>(&secondFixed), variables,
      Vector.asSlice<Binding>(&bindings.*))
  }
  let firstVariables = Vector.length<UnifySlot>(&firstOpen)
  let secondVariables = Vector.length<UnifySlot>(&secondOpen)
  if firstVariables == usize.ZERO && secondVariables == usize.ZERO {
    let forward = run setIncluded(
      Vector.asSlice<Shared<Type>>(&firstFixed),
      Vector.asSlice<Shared<Type>>(&secondFixed),
      comparison,
    )
    if isDistinct(&forward) {
      return move forward
    }
    let backward = run setIncluded(
      Vector.asSlice<Shared<Type>>(&secondFixed),
      Vector.asSlice<Shared<Type>>(&firstFixed),
      comparison,
    )
    return worse(&forward, &backward)
  }
  if comparison == Comparison.Exact {
    return undetermined(first)
  }
  let mut result = Unification.Unified
  if secondVariables == usize.ZERO {
    result = run setIncluded(
      Vector.asSlice<Shared<Type>>(&firstFixed),
      Vector.asSlice<Shared<Type>>(&secondFixed),
      comparison,
    )
  }
  if firstVariables == usize.ZERO {
    result = run setIncluded(
      Vector.asSlice<Shared<Type>>(&secondFixed),
      Vector.asSlice<Shared<Type>>(&firstFixed),
      comparison,
    )
  }
  if !isUnified(&result) {
    return move result
  }
  run absorb(Vector.asSlice<UnifySlot>(&firstOpen), &mut absorbed.*)
  run absorb(Vector.asSlice<UnifySlot>(&secondOpen), &mut absorbed.*)
  return Unification.Unified
}

effect fn absorb(slots: &[UnifySlot], absorbed: &mut Vector<UnifySlot>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < slots.length {
    run Vector.append<UnifySlot>(&mut absorbed.*, slots[at])
    at = at + usize.ONE
  }
  return ()
}

// Splits set members into fixed members and bare unbound variables; false when a member mentions a
// variable in any other way or a variable repeats or was already absorbed by another set, which
// leaves the set outside the fragment.
effect fn splitSet(
  members: &[Shared<Type>],
  variables: &[Shared<DeclarationId>],
  comparison: Comparison,
  bindings: &[Binding],
  absorbed: &[UnifySlot],
  fixed: &mut Vector<Shared<Type>>,
  open: &mut Vector<UnifySlot>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < members.length {
    let member = resolvedType(&members[at], variables, bindings)
    let slot = Shared.with<Type, UnifySlot>(
      &member,
      fn(value: &Type) -> UnifySlot {
        return typeSlot(value, variables)
      },
    )
    if slot.owner != usize.MAX {
      if hasSlot(Vector.asSlice<UnifySlot>(&open.*), &slot) || hasSlot(absorbed, &slot) {
        return false
      }
      run Vector.append<UnifySlot>(&mut open.*, slot)
    } else {
      if hasVariable(&member, variables, bindings, comparison) {
        return false
      }
      run Vector.append<Shared<Type>>(&mut fixed.*, move member)
    }
    at = at + usize.ONE
  }
  return true
}

// A requirement row with bound variable rows merged in: its entries and rigid row parameters, and
// the unbound variable row parameters it still includes.
struct UnifyRowParts {
  row: Row
  open: Vector<UnifySlot>
}

effect fn flattenRow(
  row: &Shared<Row>,
  variables: &[Shared<DeclarationId>],
  bindings: &[Binding],
  into: &mut UnifyRowParts,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let established = run comparisonBindings(variables, bindings)
  let selected = Vector.asSlice<Binding>(&established)
  let entries = Shared.with<Row, usize>(row, rowEntryCount)
  let mut at = usize.ZERO
  while at < entries {
    let entry = entryAt(row, at)
    let normalizedRole = match &entry.roleType {
      Option<Shared<Type>>.Some {value} => Option.some<Shared<Type>>(run comparisonType(&value, selected))
      Option<Shared<Type>>.None => Option.none<Shared<Type>>()
    }
    // Closed key comparison must see the same established substitutions as entriesOpen.
    run Row.require(&mut into.row, Requirement {
      capability: run comparisonType(&entry.capability, selected), roleType: move normalizedRole, access: entry.access,
    })
    at = at + usize.ONE
  }
  let parameters = Shared.with<Row, usize>(row, rowParameterCount)
  at = usize.ZERO
  while at < parameters {
    let slot = Shared.with<Row, UnifySlot>(
      row,
      fn(value: &Row) -> UnifySlot {
        return rowParameterSlot(value, at, variables)
      },
    )
    if slot.owner == usize.MAX {
      let parameter = Shared.with<Row, RowParameter>(
        row,
        fn(value: &Row) -> RowParameter {
          return rowParameterAt(value, at)
        },
      )
      run Row.include(&mut into.row, move parameter)
    } else {
      let bound = bindingAt(bindings, variables, &slot)
      if bound == usize.MAX {
        if !hasSlot(Vector.asSlice<UnifySlot>(&into.open), &slot) {
          run Vector.append<UnifySlot>(&mut into.open, slot)
        }
      } else {
        if let Argument.Row {value: supplied} = &bindings[bound].value {
          run flattenRow(&supplied, variables, bindings, &mut into.*)
        }
      }
    }
    at = at + usize.ONE
  }
  let terms = subtractionCount(row)
  at = usize.ZERO
  while at < terms {
    run appendSubtraction(&mut into.row, subtractionAt(row, at))
    at = at + usize.ONE
  }
  return ()
}

// Whether some entry of a flattened row still mentions an unbound variable.
fn entriesOpen(row: &Shared<Row>, variables: &[Shared<DeclarationId>], bindings: &[Binding], comparison: Comparison) -> bool {
  let entries = Shared.with<Row, usize>(row, rowEntryCount)
  let mut at = usize.ZERO
  while at < entries {
    let entry = entryAt(row, at)
    if hasVariable(&entry.capability, variables, bindings, comparison) {
      return true
    }
    if let Option<Shared<Type>>.Some {value: roleValue} = &entry.roleType {
      if hasVariable(&roleValue, variables, bindings, comparison) {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Whether two entries name one service-role key.
effect fn sameEntryKey(
  first: &Requirement,
  second: &Requirement,
  comparison: Comparison,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let mut map = Vector.make<usize>()
  if comparison == Comparison.Projection {
    run Vector.append<usize>(&mut map, usize.MAX - 2)
  }
  if !run sameUnder(&first.capability, &second.capability, Vector.asSlice<usize>(&map)) {
    return Unification.Distinct
  }
  if let Option<Shared<Type>>.Some {value: roleValue} = &first.roleType {
    if let Option<Shared<Type>>.Some {value: otherRole} = &second.roleType {
      if run sameUnder(&roleValue, &otherRole, Vector.asSlice<usize>(&map)) {
        return Unification.Unified
      }
      return Unification.Distinct
    }
    return Unification.Distinct
  }
  if let Option<Shared<Type>>.Some {value: _} = &second.roleType {
    return Unification.Distinct
  }
  return Unification.Unified
}

// The strongest key match for one required entry among the first `candidates` available entries.
effect fn bestEntryMatch(
  entry: &Requirement,
  available: &Shared<Row>,
  candidates: usize,
  exact: bool,
  comparison: Comparison,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let mut found = Unification.Distinct
  let mut other = usize.ZERO
  while !isUnified(&found) && other < candidates {
    let candidate = entryAt(available, other)
    // A provisional key match under Projection can name several entries. Access must
    // qualify the candidate before it can decide this required entry.
    let covers = sameAccess(entry.access, candidate.access) || (!exact && !sameAccess(
      candidate.access,
      Access.Shared,
    ))
    if covers {
      let key = run sameEntryKey(entry, &candidate, comparison)
      if isUnified(&key) {
        found = move key
      } else if !isDistinct(&key) && isDistinct(&found) {
        found = move key
      }
    }
    other = other + usize.ONE
  }
  return move found
}

// Every entry of `required` has the same key in `available` with at least its access, or, when
// `exact`, with the same access.
effect fn entriesCovered(
  required: &Shared<Row>,
  available: &Shared<Row>,
  exact: bool,
  comparison: Comparison,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let entries = Shared.with<Row, usize>(required, rowEntryCount)
  let candidates = Shared.with<Row, usize>(available, rowEntryCount)
  let mut result = Unification.Unified
  let mut at = usize.ZERO
  while at < entries {
    let entry = entryAt(required, at)
    let found = run bestEntryMatch(&entry, available, candidates, exact, comparison)
    result = worse(&result, &found)
    if isDistinct(&result) {
      return move result
    }
    at = at + usize.ONE
  }
  return move result
}

// Whether an earlier required entry already chose this candidate.
fn choiceUsed(choices: &Vector<usize>, at: usize, candidate: usize) -> bool {
  let chosen = Vector.asSlice<usize>(choices)
  let mut earlier = usize.ZERO
  while earlier < at {
    if chosen[earlier] == candidate {
      return true
    }
    earlier = earlier + usize.ONE
  }
  return false
}

// The search backed out of the first entry: no pairing exists, but a skipped or collided key under
// a partial projection leaves the question undecided.
fn noClosedPairing(site: &Shared<Type>, comparison: Comparison, uncertain: bool, collision: bool) -> Unification {
  if uncertain || (comparison == Comparison.Projection && collision) {
    return undetermined(site)
  }
  return Unification.Distinct
}

// Closed rows need a distinct candidate for each entry. A partial lifetime projection can make
// several keys look alike, so try alternate candidates rather than choosing source order. If
// projected keys collide and no full pairing exists, keep that case undecided. This search does
// not bind variables; the caller's `unifyAll` transaction still owns all bindings.
effect fn closedEntriesMatch(
  left: &Shared<Row>,
  right: &Shared<Row>,
  site: &Shared<Type>,
  comparison: Comparison,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Row, usize>(left, rowEntryCount)
  let mut choices = Vector.make<usize>()
  let mut initialized = usize.ZERO
  while initialized < count {
    run Vector.append<usize>(&mut choices, usize.MAX)
    initialized = initialized + usize.ONE
  }
  let mut at = usize.ZERO
  let mut collision = false
  let mut uncertain = false
  while true {
    if at == count {
      return Unification.Unified
    }
    let chosen = Vector.asSlice<usize>(&choices)[at]
    let mut candidate = usize.ZERO
    if chosen != usize.MAX {
      candidate = chosen + usize.ONE
    }
    let required = entryAt(left, at)
    let mut found = false
    while candidate < count && !found {
      let available = entryAt(right, candidate)
      if sameAccess(required.access, available.access) {
        let key = run sameEntryKey(&required, &available, comparison)
        if isUnified(&key) {
          if choiceUsed(&choices, at, candidate) {
            collision = true
          } else {
            found = true
          }
        } else if !isDistinct(&key) {
          uncertain = true
        }
      }
      if !found {
        candidate = candidate + usize.ONE
      }
    }
    if found {
      let slots = Vector.asMutSlice<usize>(&mut choices)
      slots[at] = candidate
      if at + usize.ONE < count {
        slots[at + usize.ONE] = usize.MAX
      }
      at = at + usize.ONE
    } else {
      let slots = Vector.asMutSlice<usize>(&mut choices)
      slots[at] = usize.MAX
      if at == usize.ZERO {
        return noClosedPairing(site, comparison, uncertain, collision)
      }
      at = at - usize.ONE
    }
  }
  return Unification.Distinct
}

effect fn unifyEntryKeys(
  first: &Requirement,
  second: &Requirement,
  variables: &[Shared<DeclarationId>],
  comparison: Comparison,
  bindings: &mut Vector<Binding>,
  absorbed: &mut Vector<UnifySlot>,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  if !sameAccess(first.access, second.access) {
    return Unification.Distinct
  }
  let capability = run unifyTerms(
    &first.capability,
    &second.capability,
    variables,
    comparison,
    &mut bindings.*,
    &mut absorbed.*,
  )
  if isDistinct(&capability) {
    return move capability
  }
  if let Option<Shared<Type>>.Some {value: firstRole} = &first.roleType {
    if let Option<Shared<Type>>.Some {value: secondRole} = &second.roleType {
      let roleComparison = run unifyTerms(
        &firstRole,
        &secondRole,
        variables,
        comparison,
        &mut bindings.*,
        &mut absorbed.*,
      )
      return worse(&capability, &roleComparison)
    }
    return Unification.Distinct
  }
  if let Option<Shared<Type>>.Some {value: _} = &second.roleType {
    return Unification.Distinct
  }
  return move capability
}

// Parameterized service-role keys may match only under one shared assignment. Search alternate
// pairings rather than committing to written order; callers retain Undetermined on a failed search
// because normalization after substitution may still collapse keys.
effect fn matchRowPermutation(
  left: &Shared<Row>,
  right: &Shared<Row>,
  variables: &[Shared<DeclarationId>],
  comparison: Comparison,
  bindings: &mut Vector<Binding>,
  absorbed: &mut Vector<UnifySlot>,
  used: &mut Vector<bool>,
  at: usize,
  site: &Shared<Type>,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Row, usize>(left, rowEntryCount)
  if at == count {
    return Unification.Unified
  }
  let entry = entryAt(left, at)
  let mut uncertain = false
  let mut candidate = usize.ZERO
  while candidate < count {
    if !Vector.asSlice<bool>(&used.*)[candidate] {
      let bindingMark = Vector.length<Binding>(&bindings.*)
      let absorbedMark = Vector.length<UnifySlot>(&absorbed.*)
      let other = entryAt(right, candidate)
      let compared = run unifyEntryKeys(
        &entry,
        &other,
        variables,
        comparison,
        &mut bindings.*,
        &mut absorbed.*,
      )
      if isUnified(&compared) {
        Vector.set<bool>(&mut used.*, candidate, true)
        let matched = run matchRowPermutation(
          left,
          right,
          variables,
          comparison,
          &mut bindings.*,
          &mut absorbed.*,
          &mut used.*,
          at + usize.ONE,
          site,
        )
        Vector.set<bool>(&mut used.*, candidate, false)
        if isUnified(&matched) {
          return move matched
        }
        if !isDistinct(&matched) {
          uncertain = true
        }
      } else if !isDistinct(&compared) {
        uncertain = true
      }
      Vector.truncate<Binding>(&mut bindings.*, bindingMark)
      Vector.truncate<UnifySlot>(&mut absorbed.*, absorbedMark)
    }
    candidate = candidate + usize.ONE
  }
  if uncertain {
    return undetermined(site)
  }
  return Unification.Distinct
}

// Two distinct exact keys can become one after lifetime projection. Only such a collision can
// make different closed-row entry counts compatible with a later lifetime substitution.
effect fn projectedKeyCollision(row: &Shared<Row>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Row, usize>(row, rowEntryCount)
  let mut at = usize.ZERO
  while at < count {
    let first = entryAt(row, at)
    let mut other = at + usize.ONE
    while other < count {
      let second = entryAt(row, other)
      let key = run sameEntryKey(&first, &second, Comparison.Projection)
      if !isDistinct(&key) {
        return true
      }
      other = other + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

effect fn projectedEntryAt(entries: &[Requirement], wanted: &Requirement) -> usize
! OutOfMemoryError
? &mut Allocator {
  let mut at = usize.ZERO
  while at < entries.length {
    let matched = run sameEntryKey(&entries[at], wanted, Comparison.Projection)
    if isUnified(&matched) {
      return at
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// Coherence erases lifetimes before comparing heads. Keys that differ only by those lifetimes may
// then collapse; their strongest access is the row entry that survives substitution.
effect fn projectedRow(row: &Shared<Row>) -> Shared<Row> ! OutOfMemoryError ? &mut Allocator {
  let mut projected = Row.empty()
  let count = Shared.with<Row, usize>(row, rowEntryCount)
  let mut at = usize.ZERO
  while at < count {
    let entry = entryAt(row, at)
    let existing = run projectedEntryAt(Vector.asSlice<Requirement>(&projected.entries), &entry)
    if existing == usize.MAX {
      run Vector.append<Requirement>(&mut projected.entries, move entry)
    } else if !sameAccess(entry.access, Access.Shared) {
      let entries = Vector.asMutSlice<Requirement>(&mut projected.entries)
      entries[existing].access = Access.Mutable
    }
    at = at + usize.ONE
  }
  let parameters = Shared.with<Row, usize>(row, rowParameterCount)
  at = usize.ZERO
  while at < parameters {
    run Row.include(&mut projected, Shared.with<Row, RowParameter>(
      row,
      fn(value: &Row) -> RowParameter {
        return rowParameterAt(value, at)
      },
    ))
    at = at + usize.ONE
  }
  let terms = subtractionCount(row)
  at = usize.ZERO
  while at < terms {
    run appendSubtraction(&mut projected, subtractionAt(row, at))
    at = at + usize.ONE
  }
  return run Shared.make<Row>(move projected)
}

fn sameRigidParameters(first: &Row, second: &Shared<Row>) -> bool {
  return Shared.with<Row, bool>(
    second,
    fn(other: &Row) -> bool {
      let firstParameters = Vector.asSlice<RowParameter>(&first.parameters)
      let secondParameters = Vector.asSlice<RowParameter>(&other.parameters)
      if firstParameters.length != secondParameters.length {
        return false
      }
      let mut at = usize.ZERO
      let map = Vector.make<usize>()
      while at < firstParameters.length {
        if !hasParameter(secondParameters, &firstParameters[at], Vector.asSlice<usize>(&map)) {
          return false
        }
        at = at + usize.ONE
      }
      return true
    },
  )
}

// Requirement rows compare as sets of service-role keys, each at its strongest access, plus row
// parameters. Closed rows compare exactly. Under exact comparison one variable row parameter
// standing alone binds the whole other row. The projection also decides the open fragment: a row
// with unbound variable parameters matches a closed row iff each of its own keys is there with at
// least its access, since a variable can add keys and strengthen access but never remove or weaken
// them; two open rows always match. Those variables are then absorbed. An entry that mentions a
// variable, or a rigid parameter beside a variable, is undecided.
effect fn unifyRows(
  left: &Shared<Row>,
  right: &Shared<Row>,
  at: &Shared<Type>,
  variables: &[Shared<DeclarationId>],
  comparison: Comparison,
  bindings: &mut Vector<Binding>,
  absorbed: &mut Vector<UnifySlot>,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let mut first = UnifyRowParts {row: Row.empty(), open: Vector.make<UnifySlot>()}
  run flattenRow(left, variables, Vector.asSlice<Binding>(&bindings.*), &mut first)
  let mut second = UnifyRowParts {row: Row.empty(), open: Vector.make<UnifySlot>()}
  run flattenRow(right, variables, Vector.asSlice<Binding>(&bindings.*), &mut second)
  let UnifyRowParts {row: firstValue, open: firstOpen} = move first
  let UnifyRowParts {row: secondValue, open: secondOpen} = move second
  let firstRow = run Shared.make<Row>(move firstValue)
  let secondRow = run Shared.make<Row>(move secondValue)
  // An unresolved subtraction is rigid: it matches only an equal row, and never binds a variable.
  if subtractionCount(&firstRow) != usize.ZERO || subtractionCount(&secondRow) != usize.ZERO {
    if Vector.length<UnifySlot>(&firstOpen) == usize.ZERO && Vector.length<UnifySlot>(&secondOpen) == usize.ZERO {
      let none = Vector.make<usize>()
      if run sameRows(&firstRow, &secondRow, Vector.asSlice<usize>(&none)) {
        return Unification.Unified
      }
    }
    return undetermined(at)
  }
  let firstEntriesOpen = entriesOpen(&firstRow, variables, Vector.asSlice<Binding>(&bindings.*), comparison)
  let secondEntriesOpen = entriesOpen(
    &secondRow,
    variables,
    Vector.asSlice<Binding>(&bindings.*),
    comparison,
  )
  if firstEntriesOpen || secondEntriesOpen {
    let rigid = Shared.with<Row, bool>(
      &firstRow,
      fn(value: &Row) -> bool {
        return sameRigidParameters(value, &secondRow)
      },
    )
    if rigid && Vector.length<UnifySlot>(&firstOpen) == usize.ZERO && Vector.length<UnifySlot>(&secondOpen) == usize.ZERO && Shared.with<Row, usize>(
      &firstRow,
      rowEntryCount,
    ) == Shared.with<Row, usize>(&secondRow, rowEntryCount) {
      let mut used = Vector.make<bool>()
      let count = Shared.with<Row, usize>(&secondRow, rowEntryCount)
      let mut entryAtIndex = usize.ZERO
      while entryAtIndex < count {
        run Vector.append<bool>(&mut used, false)
        entryAtIndex = entryAtIndex + usize.ONE
      }
      let paired = run matchRowPermutation(
        &firstRow,
        &secondRow,
        variables,
        comparison,
        &mut bindings.*,
        &mut absorbed.*,
        &mut used,
        usize.ZERO,
        at,
      )
      if isUnified(&paired) {
        return move paired
      }
      if isDistinct(&paired) && count == usize.ONE && Shared.with<Row, usize>(
        &firstRow,
        rowParameterCount,
      ) == usize.ZERO {
        return Unification.Distinct
      }
    }
    return undetermined(at)
  }
  let firstVariables = Vector.length<UnifySlot>(&firstOpen)
  let secondVariables = Vector.length<UnifySlot>(&secondOpen)
  if firstVariables == usize.ZERO && secondVariables == usize.ZERO {
    let mut comparedFirst = Shared.clone<Row>(&firstRow)
    let mut comparedSecond = Shared.clone<Row>(&secondRow)
    if comparison == Comparison.Projection {
      comparedFirst = run projectedRow(&firstRow)
      comparedSecond = run projectedRow(&secondRow)
    }
    let rigid = Shared.with<Row, bool>(
      &comparedFirst,
      fn(value: &Row) -> bool {
        return sameRigidParameters(value, &comparedSecond)
      },
    )
    if !rigid {
      return Unification.Distinct
    }
    if Shared.with<Row, usize>(&comparedFirst, rowEntryCount) != Shared.with<Row, usize>(
      &comparedSecond,
      rowEntryCount,
    ) {
      // Distinct lifetime-bearing keys may normalize to one key after substitution.
      if comparison == Comparison.Projection {
        if run projectedKeyCollision(&comparedFirst) {
          return undetermined(at)
        }
        if run projectedKeyCollision(&comparedSecond) {
          return undetermined(at)
        }
      }
      return Unification.Distinct
    }
    return run closedEntriesMatch(&comparedFirst, &comparedSecond, at, comparison)
  }
  let firstBare = Shared.with<Row, bool>(&firstRow, bareRow)
  let secondBare = Shared.with<Row, bool>(&secondRow, bareRow)
  if comparison == Comparison.Exact {
    if firstVariables == usize.ONE && firstBare && secondVariables == usize.ZERO {
      let slots = Vector.asSlice<UnifySlot>(&firstOpen)
      run bindVariable(&slots[usize.ZERO], Argument.Row {value: move secondRow}, variables, &mut bindings.*)
      return Unification.Unified
    }
    if secondVariables == usize.ONE && secondBare && firstVariables == usize.ZERO {
      let slots = Vector.asSlice<UnifySlot>(&secondOpen)
      run bindVariable(&slots[usize.ZERO], Argument.Row {value: move firstRow}, variables, &mut bindings.*)
      return Unification.Unified
    }
    return undetermined(at)
  }
  if anyAbsorbed(Vector.asSlice<UnifySlot>(&firstOpen), Vector.asSlice<UnifySlot>(&absorbed.*)) || anyAbsorbed(
    Vector.asSlice<UnifySlot>(&secondOpen),
    Vector.asSlice<UnifySlot>(&absorbed.*),
  ) {
    return undetermined(at)
  }
  let firstRigid = Shared.with<Row, usize>(&firstRow, rowParameterCount)
  let secondRigid = Shared.with<Row, usize>(&secondRow, rowParameterCount)
  if (firstVariables > usize.ZERO && firstRigid > usize.ZERO) || (secondVariables > usize.ZERO && secondRigid > usize.ZERO) {
    return undetermined(at)
  }
  let mut result = Unification.Unified
  if secondVariables == usize.ZERO {
    result = run entriesCovered(&firstRow, &secondRow, false, comparison)
  }
  if firstVariables == usize.ZERO {
    result = run entriesCovered(&secondRow, &firstRow, false, comparison)
  }
  if !isUnified(&result) {
    return move result
  }
  run absorb(Vector.asSlice<UnifySlot>(&firstOpen), &mut absorbed.*)
  run absorb(Vector.asSlice<UnifySlot>(&secondOpen), &mut absorbed.*)
  return Unification.Unified
}

fn bareRow(value: &Row) -> bool {
  return Vector.length<Requirement>(&value.entries) == usize.ZERO && Vector.length<RowParameter>(
    &value.parameters,
  ) == usize.ZERO && rowSubtractionCount(value) == usize.ZERO
}

fn anyAbsorbed(slots: &[UnifySlot], absorbed: &[UnifySlot]) -> bool {
  let mut at = usize.ZERO
  while at < slots.length {
    if hasSlot(absorbed, &slots[at]) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// The unifier's recursive step. A variable binds after the occurs check; unions and rows use the
// set rules; any other pair must agree in shape and then position by position, with lifetimes
// compared only under exact comparison. Bindings are never undone here: `Type.unifyAll` owns the
// transaction.
effect fn unifyTerms(
  left: &Shared<Type>,
  right: &Shared<Type>,
  variables: &[Shared<DeclarationId>],
  comparison: Comparison,
  bindings: &mut Vector<Binding>,
  absorbed: &mut Vector<UnifySlot>,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let first = resolvedType(left, variables, Vector.asSlice<Binding>(&bindings.*))
  let second = resolvedType(right, variables, Vector.asSlice<Binding>(&bindings.*))
  let firstSlot = Shared.with<Type, UnifySlot>(
    &first,
    fn(value: &Type) -> UnifySlot {
      return typeSlot(value, variables)
    },
  )
  let secondSlot = Shared.with<Type, UnifySlot>(
    &second,
    fn(value: &Type) -> UnifySlot {
      return typeSlot(value, variables)
    },
  )
  if firstSlot.owner != usize.MAX {
    if sameSlot(&firstSlot, &secondSlot) {
      return Unification.Unified
    }
    return run bindType(&firstSlot, &second, variables, &mut bindings.*, Vector.asSlice<UnifySlot>(&absorbed.*))
  }
  if secondSlot.owner != usize.MAX {
    return run bindType(&secondSlot, &first, variables, &mut bindings.*, Vector.asSlice<UnifySlot>(&absorbed.*))
  }
  if Shared.with<Type, usize>(&first, unionLength) != usize.MAX || Shared.with<Type, usize>(
    &second,
    unionLength,
  ) != usize.MAX {
    return run unifySets(&first, &second, variables, comparison, &mut bindings.*, &mut absorbed.*)
  }
  let aliased = Shared.with<Type, usize>(&first, addressOf) == Shared.with<Type, usize>(&second, addressOf)
  let mut shaped = false
  if aliased {
    shaped = Shared.with<Type, bool>(&first, fn(value: &Type) -> bool {
      return sameShape(value, value)
    })
  } else {
    shaped = Shared.with<Type, bool>(&first, fn(value: &Type) -> bool {
      return shapeWith(value, &second)
    })
  }
  if !shaped || !run sameApplicationStatics(&first, &second) {
    return Unification.Distinct
  }
  let executable = Shared.with<Type, bool>(&first, isExecutable)
  let mut result = Unification.Unified
  if comparison == Comparison.Exact {
    if executable {
      let mut plain = false
      if aliased {
        plain = Shared.with<Type, bool>(&first, fn(value: &Type) -> bool {
          return plainExecutable(value, value)
        })
      } else {
        plain = Shared.with<Type, bool>(&first, fn(value: &Type) -> bool {
          return plainExecutableWith(value, &second)
        })
      }
      if !plain {
        let invocation = Shared.with<Type, bool>(&first, fn(value: &Type) -> bool {
          return sameExecutableInvocationWith(value, &second)
        })
        if !invocation { return undetermined(&first) }
        result = run unifyExecutableEnvironment(&first, &second, variables, &mut bindings.*)
      }
    } else {
      let regions = Shared.with<Type, usize>(&first, ownLifetimeCount)
      let mut region = usize.ZERO
      while region < regions {
        let firstRegion = Shared.with<Type, Option<Shared<Lifetime>>>(
          &first,
          fn(value: &Type) -> Option<Shared<Lifetime>> {
            return ownLifetimeAt(value, region)
          },
        )
        let secondRegion = Shared.with<Type, Option<Shared<Lifetime>>>(
          &second,
          fn(value: &Type) -> Option<Shared<Lifetime>> {
            return ownLifetimeAt(value, region)
          },
        )
        if let Option<Shared<Lifetime>>.Some {value: firstLifetime} = move firstRegion {
          if let Option<Shared<Lifetime>>.Some {value: secondLifetime} = move secondRegion {
            let compared = run unifyLifetimes(&firstLifetime, &secondLifetime, &first, variables, &mut bindings.*)
            result = worse(&result, &compared)
            if isDistinct(&result) {
              return move result
            }
          }
        }
        region = region + usize.ONE
      }
    }
  }
  let count = Shared.with<Type, usize>(&first, childCount)
  let mut at = usize.ZERO
  while at < count {
    let firstChild = Shared.with<Type, Option<Shared<Type>>>(
      &first,
      fn(value: &Type) -> Option<Shared<Type>> {
        return childAt(value, at)
      },
    )
    let secondChild = Shared.with<Type, Option<Shared<Type>>>(
      &second,
      fn(value: &Type) -> Option<Shared<Type>> {
        return childAt(value, at)
      },
    )
    if let Option<Shared<Type>>.Some {value: firstNested} = move firstChild {
      if let Option<Shared<Type>>.Some {value: secondNested} = move secondChild {
        let compared = run unifyTerms(&firstNested, &secondNested, variables, comparison, &mut bindings.*, &mut absorbed.*)
        result = worse(&result, &compared)
        if isDistinct(&result) {
          return move result
        }
      }
    }
    let firstRow = argumentRowOf(&first, at)
    let secondRow = argumentRowOf(&second, at)
    if let Option<Shared<Row>>.Some {value: firstSupplied} = move firstRow {
      if let Option<Shared<Row>>.Some {value: secondSupplied} = move secondRow {
        let compared = run unifyRows(&firstSupplied, &secondSupplied, &first, variables, comparison, &mut bindings.*, &mut absorbed.*)
        result = worse(&result, &compared)
        if isDistinct(&result) {
          return move result
        }
      }
    }
    at = at + usize.ONE
  }
  let firstRequirements = Shared.with<Type, Option<Shared<Row>>>(&first, rowOf)
  let secondRequirements = Shared.with<Type, Option<Shared<Row>>>(&second, rowOf)
  if let Option<Shared<Row>>.Some {value: firstChannel} = move firstRequirements {
    if let Option<Shared<Row>>.Some {value: secondChannel} = move secondRequirements {
      let compared = run unifyRows(&firstChannel, &secondChannel, &first, variables, comparison, &mut bindings.*, &mut absorbed.*)
      result = worse(&result, &compared)
    }
  }
  return move result
}

fn rowOccurrences(row: &Shared<Row>, owner: &DeclarationId, ordinal: usize) -> usize {
  let mut count = usize.ZERO
  let entries = Shared.with<Row, usize>(row, rowEntryCount)
  let mut at = usize.ZERO
  while at < entries {
    let entry = entryAt(row, at)
    count = count + Type.occurrences(&entry.capability, owner, ordinal)
    if let Option<Shared<Type>>.Some {value: roleValue} = &entry.roleType {
      count = count + Type.occurrences(&roleValue, owner, ordinal)
    }
    at = at + usize.ONE
  }
  let parameters = Shared.with<Row, usize>(row, rowParameterCount)
  at = usize.ZERO
  while at < parameters {
    let owned = Shared.with<Row, usize>(
      row,
      fn(value: &Row) -> usize {
        return ownedRowOrdinal(value, at, owner)
      },
    )
    if owned != usize.MAX && (ordinal == usize.MAX || owned == ordinal) {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  let terms = subtractionCount(row)
  at = usize.ZERO
  while at < terms {
    let term = subtractionAt(row, at)
    count = count + rowOccurrences(&term.source, owner, ordinal) + rowOccurrences(&term.removed, owner, ordinal)
    at = at + usize.ONE
  }
  return count
}

// Copy only the current node; release its shared borrow before traversing any child.
fn nodeKind(value: &Type) -> usize {
  return match & value.* {
    Type.Primitive {..} => 0
    Type.Unit => 1
    Type.Nominal {..} => 2
    Type.OpaqueRepresentation {..} => 4
    Type.Parameter {..} => 5
    Type.String {..} => 6
    Type.Reference {..} => 7
    Type.Slice {..} => 8
    Type.Pointer {..} => 9
    Type.Array {..} => 10
    Type.Union {..} => 11
    Type.ForeignFunction {..} => 26
    Type.Callable {..} => 12
    Type.Effect {..} => 13
    Type.TypeDescriptor {..} => 14
    Type.Anonymous {..} => 15
    Type.CallableValue {..} => 16
    Type.CallableStage {..} => 17
    Type.CallableSchema {..} => 18
    Type.CallableResult {..} => 20
    Type.CallableWitnessResult {..} => 22
    Type.CallableOrigin {..} => 21
    Type.CallableView {..} => 19
    Type.EffectComposite {..} => 23
    Type.EffectJoin {..} => 24
    Type.Without {..} => 25
  }
}

fn nodeArgument(value: &Type, at: usize) -> Option<Argument> {
  return match & value.* {
    Type.CallableWitnessResult {witness} => {
      let recipe = Shared.with<WitnessRecipe, WitnessRecipe>(&witness, CallableWitness.copy)
      let first = 3 + CallableWitness.argumentCount(&recipe)
      if at < first { return Option.none<Argument>() }
      let selected = CallableWitness.bindingAt(&recipe, at - first)
      return Option.some<Argument>(move selected.value)
    }
    Type.CallableResult {arguments, selected, ..} => {
      let first = Vector.length<Shared<Type>>(&arguments) + 2
      if at < first { return Option.none<Argument>() }
      return Option.some<Argument>(nodeArgumentIn(&selected, at - first))
    }
    Type.Nominal {arguments, ..} => Option.some<Argument>(nodeArgumentIn(&arguments, at))
    Type.OpaqueRepresentation {application, ..} => applicationArgument(&application, at)
    Type.CallableOrigin {application, ..} => applicationArgument(&application, at)
    _ => Option.none<Argument>()
  }
}

fn copyNodeArgument(value: &Argument) -> Argument {
  return match & value.* {
    Argument.Type {value: ty} => Argument.Type {value: Shared.clone<Type>(&ty)}
    Argument.Lifetime {value: region} => Argument.Lifetime {value: Shared.clone<Lifetime>(&region)}
    Argument.Row {value: row} => Argument.Row {value: Shared.clone<Row>(&row)}
  }
}

effect fn nodeArguments(value: &Shared<Type>) -> Vector<Argument>
! OutOfMemoryError
? &mut Allocator {
  let count = Shared.with<Type, usize>(value, childCount)
  let mut arguments = Vector.make<Argument>()
  let mut at = usize.ZERO
  while at < count {
    let found = Shared.with<Type, Option<Argument>>(
      value,
      fn(node: &Type) -> Option<Argument> {
        return nodeArgument(node, at)
      },
    )
    if let Option<Argument>.Some {value: argument} = move found {
      run Vector.append<Argument>(&mut arguments, move argument)
    }
    at = at + usize.ONE
  }
  return move arguments
}

effect fn nodeText(value: &Shared<Type>) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let length = Shared.with<Type, usize>(
    value,
    fn(node: &Type) -> usize {
      return match & node.* {
        Type.Primitive {name} => Bytes.asSlice(&name).length
        Type.Array {extent, ..} => Bytes.asSlice(&extent).length
        _ => usize.ZERO
      }
    },
  )
  let mut output = run Bytes.zeroed(length)
  let copied = Shared.with<Type, bool>(
    value,
    fn(node: &Type) -> bool {
      return match & node.* {
        Type.Primitive {name} => fillNodeText(&name, &mut output)
        Type.Array {extent, ..} => fillNodeText(&extent, &mut output)
        _ => false
      }
    },
  )
  return move output
}

effect fn nodeCopy(value: &Shared<Type>) -> Type
! OutOfMemoryError
? &mut Allocator {
  let kind = Shared.with<Type, usize>(value, nodeKind)
  if kind == usize.ZERO {
    return Type.Primitive {name: run nodeText(value)}
  }
  if kind == 2 || kind == 5 {
    let selectedDeclaration = run copyNodeDeclaration(value)
    let declaration = match move selectedDeclaration {
      Option<DeclarationId>.Some {value: id} => move id
      Option<DeclarationId>.None => {
        return absurd<Type>()
      }
    }
    if kind == 5 {
      let ordinal = Shared.with<Type, usize>(
        value,
        fn(node: &Type) -> usize {
          return match & node.* {
            Type.Parameter {ordinal, ..} => ordinal
            _ => usize.ZERO
          }
        },
      )
      return Type.Parameter {declaration: move declaration, ordinal: ordinal}
    }
    let arguments = run nodeArguments(value)
    let visibility = Shared.with<Type, bool>(
      value,
      fn(node: &Type) -> bool {
        return match & node.* {
          Type.Nominal {isPublic, ..} => isPublic
          _ => false
        }
      },
    )
    if kind == 2 {
      return Type.Nominal {
        declaration: move declaration,
        isPublic: visibility,
        arguments: move arguments,
      }
    }
    return absurd<Type>()
  }
  if kind == 4 {
    let copied = Shared.with<Type, Option<OpaqueNode>>(value, fn(node: &Type) -> Option<OpaqueNode> {
      return match &node.* {
        Type.OpaqueRepresentation {application, contract, detached, nonParking} => Option.some<OpaqueNode>(OpaqueNode {
          application: Shared.clone<Application>(&application), contract: Shared.clone<Type>(&contract),
          detached: detached, nonParking: nonParking})
        _ => Option.none<OpaqueNode>()
      }
    })
    if let Option<OpaqueNode>.Some {value: node} = move copied {
      return Type.OpaqueRepresentation {application: move node.application,
        contract: move node.contract, detached: node.detached, nonParking: node.nonParking}
    }
    return absurd<Type>()
  }
  if kind == 10 {
    let element = Shared.with<Type, Option<Shared<Type>>>(
      value,
      fn(node: &Type) -> Option<Shared<Type>> {
        return childAt(node, usize.ZERO)
      },
    )
    if let Option<Shared<Type>>.Some {value: child} = move element {
      return Type.Array {element: move child, extent: run nodeText(value)}
    }
    return absurd<Type>()
  }
  if kind == 15 {
    let occurrence = Shared.with<Type, Option<Shared<AnonymousOccurrence>>>(
      value,
      fn(node: &Type) -> Option<Shared<AnonymousOccurrence>> {
        return match & node.* {
          Type.Anonymous {occurrence, ..} => Option.some<Shared<AnonymousOccurrence>>(Shared.clone<AnonymousOccurrence>(&occurrence))
          _ => Option.none<Shared<AnonymousOccurrence>>()
        }
      },
    )
    let count = Shared.with<Type, usize>(value, childCount)
    let mut members = Vector.make<Shared<Type>>()
    let mut at = usize.ZERO
    while at < count {
      let found = Shared.with<Type, Option<Shared<Type>>>(
        value,
        fn(node: &Type) -> Option<Shared<Type>> {
          return childAt(node, at)
        },
      )
      if let Option<Shared<Type>>.Some {value: member} = move found {
        run Vector.append<Shared<Type>>(&mut members, move member)
      }
      at = at + usize.ONE
    }
    if let Option<Shared<AnonymousOccurrence>>.Some {value: selected} = move occurrence {
      return Type.Anonymous {occurrence: move selected, members: move members}
    }
    return absurd<Type>()
  }
  if kind == 16 {
    let mut copied = Shared.with<Type, Type>(value, fn(node: &Type) -> Type {
      return match &node.* {
        Type.CallableValue {isPublic, application, contract, runtime, ..} => Type.CallableValue {
          isPublic: isPublic,
          application: Shared.clone<Application>(&application), contract: Shared.clone<Type>(&contract),
          runtime: Shared.clone<Bytes>(&runtime), captures: Vector.make<Shared<Type>>(), fieldInputs: Vector.make<CallableFieldInput>(),
        }
        _ => absurd<Type>()
      }
    })
    if let Type.CallableValue {captures, fieldInputs, ..} = &mut copied {
      let count = Shared.with<Type, usize>(value, callableCaptureCount)
      let mut at = usize.ZERO
      while at < count {
        let capture = Shared.with<Type, Shared<Type>>(value, fn(node: &Type) -> Shared<Type> { return callableCaptureAt(node, at) })
        run Vector.append<Shared<Type>>(&mut captures, move capture)
        at = at + usize.ONE
      }
      let ordinals = Shared.with<Type, usize>(value, callableInputCount)
      at = usize.ZERO
      while at < ordinals {
        let input = Shared.with<Type, CallableFieldInput>(value, fn(node: &Type) -> CallableFieldInput { return callableInputAt(node, at) })
        run Vector.append<CallableFieldInput>(&mut fieldInputs, input)
        at = at + usize.ONE
      }
    }
    return move copied
  }
  if kind == 18 {
    let mut copied = Shared.with<Type, Type>(value, fn(node: &Type) -> Type {
      return match &node.* {
        Type.CallableSchema {schema, runtime, ..} => Type.CallableSchema {
          schema: Shared.clone<SectionSchema>(&schema), runtime: Shared.clone<Bytes>(&runtime),
          captures: Vector.make<Shared<Type>>(), fieldInputs: Vector.make<CallableFieldInput>(),
        }
        _ => absurd<Type>()
      }
    })
    if let Type.CallableSchema {schema, captures, fieldInputs, ..} = &mut copied {
      let first = Shared.with<SectionSchema, usize>(&schema, CallableSchema.argumentCount)
      let count = Shared.with<Type, usize>(value, childCount)
      let mut at = first
      while at < count {
        let child = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> { return childAt(node, at) })
        if let Option<Shared<Type>>.Some {value: capture} = move child { run Vector.append<Shared<Type>>(&mut captures, move capture) }
        at = at + usize.ONE
      }
      run copyCallableInputs(value, &mut fieldInputs)
    }
    return move copied
  }
  if kind == 22 {
    return Shared.with<Type, Type>(value, fn(node: &Type) -> Type {
      return match &node.* {
        Type.CallableWitnessResult {witness} => Type.CallableWitnessResult {witness: Shared.clone<WitnessRecipe>(&witness)}
        _ => absurd<Type>()
      }
    })
  }
  if kind == 21 {
    return Shared.with<Type, Type>(value, fn(node: &Type) -> Type {
      return match &node.* {
        Type.CallableOrigin {application, contract} => Type.CallableOrigin {
          application: Shared.clone<Application>(&application), contract: Shared.clone<Type>(&contract)}
        _ => absurd<Type>()
      }
    })
  }
  if kind == 20 {
    let mut copied = Shared.with<Type, Type>(value, fn(node: &Type) -> Type {
      return match &node.* {
        Type.CallableResult {producer, contract, ..} => Type.CallableResult {
          producer: Shared.clone<Type>(&producer), contract: Shared.clone<Type>(&contract), arguments: Vector.make<Shared<Type>>(),
          selected: Vector.make<Argument>(), selectedOrdinals: Vector.make<usize>()}
        _ => absurd<Type>()
      }
    })
    if let Type.CallableResult {arguments, selectedOrdinals, ..} = &mut copied {
      let count = Shared.with<Type, usize>(value, fn(node: &Type) -> usize {
        return match &node.* { Type.CallableResult {arguments: supplied, ..} => Vector.length<Shared<Type>>(&supplied) + 2 _ => usize.ZERO }
      })
      let choices = Shared.with<Type, usize>(value, fn(node: &Type) -> usize {
        return match &node.* { Type.CallableResult {selectedOrdinals: slots, ..} => Vector.length<usize>(&slots) _ => usize.ZERO }
      })
      let mut index = usize.ZERO
      while index < choices {
        let ordinal = Shared.with<Type, usize>(value, fn(node: &Type) -> usize {
          return match &node.* { Type.CallableResult {selectedOrdinals: slots, ..} => Vector.get<usize>(&slots, index) _ => usize.ZERO }
        })
        run Vector.append<usize>(&mut selectedOrdinals, ordinal)
        index = index + usize.ONE
      }
      let mut at = usize.ONE + usize.ONE
      while at < count {
        let child = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> { return childAt(node, at) })
        if let Option<Shared<Type>>.Some {value: argument} = move child { run Vector.append<Shared<Type>>(&mut arguments, move argument) }
        at = at + usize.ONE
      }
    }
    return match move copied {
      Type.CallableResult {producer, contract, arguments, selectedOrdinals, ..} => Type.CallableResult {
        producer: move producer, contract: move contract, arguments: move arguments,
        selected: run nodeArguments(value), selectedOrdinals: move selectedOrdinals}
      _ => absurd<Type>()
    }
  }
  if kind == 19 {
    return Shared.with<Type, Type>(value, fn(node: &Type) -> Type {
      return match &node.* {
        Type.CallableView {representation, contract} => Type.CallableView {
          representation: Shared.clone<Type>(&representation), contract: Shared.clone<Type>(&contract)}
        _ => absurd<Type>()
      }
    })
  }
  if kind == 17 {
    let mut copied = Shared.with<Type, Type>(value, fn(node: &Type) -> Type {
      return match &node.* {
        Type.CallableStage {base, contract, remaining, suffixMode, ..} => Type.CallableStage {
          base: Shared.clone<Type>(&base), contract: Shared.clone<Type>(&contract),
          remaining: remaining, suffixMode: suffixMode, captures: Vector.make<Shared<Type>>(),
        }
        _ => absurd<Type>()
      }
    })
    if let Type.CallableStage {captures, ..} = &mut copied {
      let count = Shared.with<Type, usize>(value, childCount)
      let mut at = usize.ONE + usize.ONE
      while at < count {
        let child = Shared.with<Type, Option<Shared<Type>>>(value,
          fn(node: &Type) -> Option<Shared<Type>> { return childAt(node, at) })
        if let Option<Shared<Type>>.Some {value: capture} = move child { run Vector.append<Shared<Type>>(&mut captures, move capture) }
        at = at + usize.ONE
      }
    }
    return move copied
  }
  if kind == 23 {
    let mut copied = Shared.with<Type, Type>(value, fn(node: &Type) -> Type {
      return match &node.* {
        Type.EffectComposite {operation, selector, contract, ..} => Type.EffectComposite {
          operation: operation, selector: Shared.clone<Type>(&selector), contract: Shared.clone<Type>(&contract),
          parts: Vector.make<Shared<Type>>(),
        }
        _ => absurd<Type>()
      }
    })
    if let Type.EffectComposite {parts, ..} = &mut copied {
      let count = Shared.with<Type, usize>(value, childCount)
      let mut at = usize.ONE + usize.ONE
      while at < count {
        let child = Shared.with<Type, Option<Shared<Type>>>(value,
          fn(node: &Type) -> Option<Shared<Type>> { return childAt(node, at) })
        if let Option<Shared<Type>>.Some {value: part} = move child { run Vector.append<Shared<Type>>(&mut parts, move part) }
        at = at + usize.ONE
      }
    }
    return move copied
  }
  if kind == 24 {
    let mut copied = Shared.with<Type, Type>(value, fn(node: &Type) -> Type {
      return match &node.* {
        Type.EffectJoin {contract, ..} => Type.EffectJoin {contract: Shared.clone<Type>(&contract), alternatives: Vector.make<Shared<Type>>()}
        _ => absurd<Type>()
      }
    })
    if let Type.EffectJoin {alternatives, ..} = &mut copied {
      let count = Shared.with<Type, usize>(value, childCount)
      let mut at = usize.ONE
      while at < count {
        let child = Shared.with<Type, Option<Shared<Type>>>(value,
          fn(node: &Type) -> Option<Shared<Type>> { return childAt(node, at) })
        if let Option<Shared<Type>>.Some {value: alternative} = move child { run Vector.append<Shared<Type>>(&mut alternatives, move alternative) }
        at = at + usize.ONE
      }
    }
    return move copied
  }
  if kind == 11 {
    let count = Shared.with<Type, usize>(value, unionLength)
    let mut members = Vector.make<Shared<Type>>()
    let mut at = usize.ZERO
    while at < count {
      if let Option<Shared<Type>>.Some {value: member} = move memberOf(value, at) {
        run Vector.append<Shared<Type>>(&mut members, move member)
      }
      at = at + usize.ONE
    }
    return Type.Union {members: move members}
  }
  if kind == 12 {
    let mut copied = Shared.with<Type, Type>(
      value,
      fn(node: &Type) -> Type {
        return match & node.* {
          Type.Callable {mode, isUnsafe, environment, invocationBinders, invocationUse, result, ..} => Type.Callable {
            mode: mode,
            isUnsafe: isUnsafe,
            environment: Shared.clone<Intersection>(&environment),
            invocationBinders: invocationBinders, invocationUse: invocationUse,
            invocationBounds: Vector.make<Outlives>(),
            parameters: Vector.make<Shared<Type>>(),
            result: Shared.clone<Type>(&result),
          }
          _ => absurd<Type>()
        }
      },
    )
    if let Type.Callable {parameters, invocationBounds: copiedBounds, ..} = &mut copied {
      let count = Shared.with<Type, usize>(value, childCount) - usize.ONE
      let mut at = usize.ZERO
      while at < count {
        let found = Shared.with<Type, Option<Shared<Type>>>(
          value,
          fn(node: &Type) -> Option<Shared<Type>> {
            return childAt(node, at)
          },
        )
        if let Option<Shared<Type>>.Some {value: child} = move found {
          run Vector.append<Shared<Type>>(&mut parameters, move child)
        }
        at = at + usize.ONE
      }
      let bounds = Shared.with<Type, usize>(
        value,
        fn(node: &Type) -> usize {
          return match & node.* {
            Type.Callable {invocationBounds, ..} => Vector.length<Outlives>(&invocationBounds)
            _ => usize.ZERO
          }
        },
      )
      at = usize.ZERO
      while at < bounds {
        let found = Shared.with<Type, Option<Outlives>>(
          value,
          fn(node: &Type) -> Option<Outlives> {
            if let Type.Callable {invocationBounds, ..} = &node.* {
              let entries = Vector.asSlice<Outlives>(&invocationBounds)
              return Option.some<Outlives>(
                Outlives {
                  longer: Shared.clone<Lifetime>(&entries[at].longer),
                  shorter: Shared.clone<Lifetime>(&entries[at].shorter),
                },
              )
            }
            return Option.none<Outlives>()
          },
        )
        if let Option<Outlives>.Some {value: bound} = move found {
          run Vector.append<Outlives>(&mut copiedBounds, move bound)
        }
        at = at + usize.ONE
      }
    }
    return move copied
  }
  return Shared.with<Type, Type>(
    value,
    fn(node: &Type) -> Type {
      return match & node.* {
        Type.ForeignFunction {signature, behavior} => Type.ForeignFunction {
          signature: Shared.clone<Type>(&signature), behavior: behavior,
        }
        Type.String {lifetime} => Type.String {lifetime: Shared.clone<Lifetime>(&lifetime)}
        Type.TypeDescriptor {owner} => Type.TypeDescriptor {owner: Shared.clone<Type>(&owner)}
        Type.Without {source, removed} => Type.Without {source: Shared.clone<Type>(&source), removed: Shared.clone<Type>(&removed)}
        Type.Reference {referent, access, lifetime} => Type.Reference {
          referent: Shared.clone<Type>(&referent),
          access: access,
          lifetime: Shared.clone<Lifetime>(&lifetime),
        }
        Type.Slice {element, access, lifetime} => Type.Slice {
          element: Shared.clone<Type>(&element),
          access: access,
          lifetime: Shared.clone<Lifetime>(&lifetime),
        }
        Type.Pointer {pointee, access, nullable, multiplicity, alignment} => {
          let copied = match & alignment {
            Option<u64>.Some {value: aligned} => Option.some<u64>(aligned)
            Option<u64>.None => Option.none<u64>()
          }
          return Type.Pointer {
            pointee: Shared.clone<Type>(&pointee),
            access: access,
            nullable: nullable,
            multiplicity: multiplicity,
            alignment: move copied,
          }
        }
        Type.Effect {mode, environment, success, failure, requirements} => Type.Effect {
          mode: mode,
          environment: Shared.clone<Intersection>(&environment),
          success: Shared.clone<Type>(&success),
          failure: Shared.clone<Type>(&failure),
          requirements: Shared.clone<Row>(&requirements),
        }
        Type.Unit => Type.Unit
        _ => absurd<Type>()
      }
    },
  )
}

struct OpaqueNode {
  application: Shared<Application>
  contract: Shared<Type>
  detached: bool
  nonParking: bool
}

impl Type {
  /// Applies owner-qualified lifetime assignments to one validity region.
  pub effect fn applyLifetimeBindings(value: &Shared<Lifetime>, bindings: &[Binding]) -> Shared<Lifetime>
  ! OutOfMemoryError ? &mut Allocator {
    if bindings.length == usize.ZERO { return Shared.clone<Lifetime>(value) }
    let owner = run DeclarationId.copyShared(&bindings[0].declaration)
    let arguments = Vector.make<Argument>()
    let mut numbering = Numbering.inactive()
    return run rewriteLifetime(value, &owner, Vector.asSlice<Argument>(&arguments), &Option.none<DeclarationId>(), true, bindings, &Option.none<DeclarationId>(), &mut numbering)
  }
}

impl Row {
  /// Applies exact declaration-owned bindings simultaneously at every depth.
  /// Replacement values are retained as evidence; they are never recursively rebound.
  pub effect fn applyBindings(value: &Shared<Row>, bindings: &[Binding], instantiate: bool) -> Shared<Row>
  ! OutOfMemoryError ? &mut Allocator {
    if bindings.length == usize.ZERO { return Shared.clone<Row>(value) }
    let owner = run DeclarationId.copyShared(&bindings[0].declaration)
    let arguments = Vector.make<Argument>()
    let mut numbering = Numbering.inactive()
    return run rewriteRow(value, &owner, Vector.asSlice<Argument>(&arguments), &Option.none<DeclarationId>(), instantiate, bindings, &Option.none<DeclarationId>(), &Option.none<Application>(), &mut numbering)
  }
}

impl Argument {
  /// Applies exact declaration-owned bindings simultaneously at every depth.
  /// Replacement values are retained as evidence; they are never recursively rebound.
  pub effect fn applyBindings(value: &Argument, bindings: &[Binding], instantiate: bool) -> Argument
  ! OutOfMemoryError ? &mut Allocator {
    if bindings.length == usize.ZERO { return Argument.copy(value) }
    let owner = run DeclarationId.copyShared(&bindings[0].declaration)
    let arguments = Vector.make<Argument>()
    let mut numbering = Numbering.inactive()
    return run rewriteArgument(value, &owner, Vector.asSlice<Argument>(&arguments), &Option.none<DeclarationId>(), instantiate, bindings, &Option.none<DeclarationId>(), &Option.none<Application>(), &mut numbering)
  }
}

impl Type {
  /// Applies exact declaration-owned bindings simultaneously at every depth.
  /// Replacement values are retained as evidence; they are never recursively rebound.
  pub effect fn applyBindings(value: &Shared<Type>, bindings: &[Binding], instantiate: bool) -> Shared<Type>
  ! OutOfMemoryError ? &mut Allocator {
    if bindings.length == usize.ZERO { return Shared.clone<Type>(value) }
    let owner = run DeclarationId.copyShared(&bindings[0].declaration)
    let arguments = Vector.make<Argument>()
    let mut numbering = Numbering.inactive()
    return run rewriteType(value, &owner, Vector.asSlice<Argument>(&arguments), &Option.none<DeclarationId>(), instantiate, bindings, &Option.none<DeclarationId>(), &Option.none<Application>(), &mut numbering)
  }
}

fn exactArgument(bindings: &[Binding], owner: &DeclarationId, ordinal: usize) -> Option<Argument> {
  let mut at = usize.ZERO
  while at < bindings.length {
    if bindings[at].ordinal == ordinal && declarationWith(owner, &bindings[at].declaration) {
      return Option.some<Argument>(Argument.copy(&bindings[at].value))
    }
    at = at + usize.ONE
  }
  return Option.none<Argument>()
}

// Row parameters can share their owner handle with a seed. Compare handles before opening either
// declaration, retaining the same first matching binding and simultaneous replacement semantics.
fn exactSharedArgument(bindings: &[Binding], owner: &Shared<DeclarationId>, ordinal: usize) -> Option<Argument> {
  let mut at = usize.ZERO
  while at < bindings.length {
    if bindings[at].ordinal == ordinal && sameDeclaration(owner, &bindings[at].declaration) {
      return Option.some<Argument>(Argument.copy(&bindings[at].value))
    }
    at = at + usize.ONE
  }
  return Option.none<Argument>()
}

impl Type {
  /// Substitutes type and row binders owned by `owner` at every depth. Lifetime arguments and
  /// validity relationships remain symbolic. The checked source node is never changed.
  pub effect fn substitute(value: &Shared<Type>, owner: &DeclarationId, arguments: &[Argument]) -> Shared<Type>
  ! OutOfMemoryError ? &mut Allocator {
    let bindings = Vector.make<Binding>()
    let mut numbering = Numbering.inactive()
    return run rewriteType(value, owner, arguments, &Option.none<DeclarationId>(), false, Vector.asSlice<Binding>(&bindings), &Option.none<DeclarationId>(), &Option.none<Application>(), &mut numbering)
  }
  /// Opens the surrounding invocation's lifetime ordinals as fresh inference parameters.
  /// Nested callable contracts keep their own quantifiers; ordinary substitution never opens them.
  pub effect fn openInvocation(value: &Shared<Type>, caller: &DeclarationId) -> Shared<Type>
  ! OutOfMemoryError ? &mut Allocator {
    let arguments = Vector.make<Argument>()
    let bindings = Vector.make<Binding>()
    let mut numbering = Numbering.inactive()
    return run rewriteType(value, caller, Vector.asSlice<Argument>(&arguments), &Option.none<DeclarationId>(), true,
      Vector.asSlice<Binding>(&bindings), &Option.some<DeclarationId>(run DeclarationId.copy(caller)), &Option.none<Application>(), &mut numbering)
  }
  /// Opens one lifetime in the surrounding invocation, including an outlives constraint.
  pub effect fn openInvocationLifetime(value: &Shared<Lifetime>, caller: &DeclarationId) -> Shared<Lifetime>
  ! OutOfMemoryError ? &mut Allocator {
    let arguments = Vector.make<Argument>()
    let bindings = Vector.make<Binding>()
    let mut numbering = Numbering.inactive()
    return run rewriteLifetime(value, caller, Vector.asSlice<Argument>(&arguments), &Option.none<DeclarationId>(), true,
      Vector.asSlice<Binding>(&bindings), &Option.some<DeclarationId>(run DeclarationId.copy(caller)), &mut numbering)
  }
  /// Copies one type node into owned storage, retaining shared child handles.
  pub effect fn copy(value: &Shared<Type>) -> Type ! OutOfMemoryError ? &mut Allocator {
    return run nodeCopy(value)
  }
  /// Instantiates every owned binder, including validity regions, in a contextual type copy.
  /// Unresolved binders remain visible so the caller can reject an open context before publication.
  pub effect fn instantiate(value: &Shared<Type>, owner: &DeclarationId, arguments: &[Argument]) -> Shared<Type>
  ! OutOfMemoryError ? &mut Allocator {
    let bindings = Vector.make<Binding>()
    let mut numbering = Numbering.inactive()
    return run rewriteType(value, owner, arguments, &Option.none<DeclarationId>(), true, Vector.asSlice<Binding>(&bindings), &Option.none<DeclarationId>(), &Option.none<Application>(), &mut numbering)
  }
  /// Renames declaration-owned parameters at every depth for an isolated inference transaction.
  /// Nominal declarations, local regions and invocation quantifiers keep their identities.
  pub effect fn renameParameters(value: &Shared<Type>, owner: &DeclarationId, replacement: &DeclarationId) -> Shared<Type>
  ! OutOfMemoryError ? &mut Allocator {
    let arguments = Vector.make<Argument>()
    let bindings = Vector.make<Binding>()
    let mut numbering = Numbering.inactive()
    return run rewriteType(value, owner, Vector.asSlice<Argument>(&arguments), &Option.some<DeclarationId>(run DeclarationId.copy(replacement)), false, Vector.asSlice<Binding>(&bindings), &Option.none<DeclarationId>(), &Option.none<Application>(), &mut numbering)
  }
}

impl Type {
  /// Renames each caller region in `value` to its canonical instance identity in `numbering`.
  ///
  /// # Details
  ///
  /// The walk visits every free region a substitution would visit, including callable
  /// environments, invocation bounds and nested applications, in one deterministic order. Invocation
  /// binders, declaration-owned parameters and `'static` are kept. `owner` supplies the declaration
  /// context for walking shared nodes.
  pub effect fn numberRegions(value: &Shared<Type>, owner: &DeclarationId, numbering: &mut Numbering) -> Shared<Type>
  ! OutOfMemoryError ? &mut Allocator {
    let arguments = Vector.make<Argument>()
    let bindings = Vector.make<Binding>()
    return run rewriteType(value, owner, Vector.asSlice<Argument>(&arguments), &Option.none<DeclarationId>(), false,
      Vector.asSlice<Binding>(&bindings), &Option.none<DeclarationId>(), &Option.none<Application>(), &mut numbering.*)
  }
}

impl Argument {
  /// Renames each caller region in one argument to its canonical instance identity in `numbering`.
  pub effect fn numberRegions(value: &Argument, owner: &DeclarationId, numbering: &mut Numbering) -> Argument
  ! OutOfMemoryError ? &mut Allocator {
    let arguments = Vector.make<Argument>()
    let bindings = Vector.make<Binding>()
    return run rewriteArgument(value, owner, Vector.asSlice<Argument>(&arguments), &Option.none<DeclarationId>(), false,
      Vector.asSlice<Binding>(&bindings), &Option.none<DeclarationId>(), &Option.none<Application>(), &mut numbering.*)
  }
}

fn observingOrFailed(numbering: &Numbering) -> bool {
  if Numbering.isCollecting(numbering) { return true }
  return match move Numbering.failure(numbering) { Option<CanonicalizationFailure>.Some {..} => true _ => false }
}

// Only owned scalar payloads are copied by nodeCopy; retained graph handles remain shared.
fn nodePayload(value: &Type) -> usize {
  return match &value.* {
    Type.Primitive {name} => Bytes.length(&name)
    Type.Nominal {declaration, ..} => RuntimeEncoding.declarationPayload(&declaration)
    Type.Parameter {declaration, ..} => RuntimeEncoding.declarationPayload(&declaration)
    Type.Array {extent, ..} => Bytes.length(&extent)
    _ => usize.ZERO
  }
}
fn numberingDeclarationCost(value: &DeclarationId, numbering: &mut Numbering) -> bool {
  if !Numbering.units(&mut numbering.*, DeclarationId.ownerCount(value)) { return false }
  return Numbering.bytes(&mut numbering.*, RuntimeEncoding.declarationPayload(value))
}
fn numberingSchemaCost(value: &SectionSchema, numbering: &mut Numbering) -> bool {
  if !Numbering.units(&mut numbering.*, Vector.length<Binding>(&value.selected)) { return false }
  if !Numbering.units(&mut numbering.*, Vector.length<usize>(&value.deferred)) { return false }
  return Shared.with<DeclarationId, bool>(&value.target,
    fn(identity: &DeclarationId) -> bool { return numberingDeclarationCost(identity, &mut numbering.*) })
}
fn numberingWitnessCost(value: &WitnessRecipe, numbering: &mut Numbering) -> bool {
  if !Numbering.units(&mut numbering.*, CallableWitness.bindingCount(value)) { return false }
  if !Numbering.units(&mut numbering.*, CallableWitness.argumentCount(value)) { return false }
  if !Numbering.units(&mut numbering.*, CallableWitness.loanCount(value)) { return false }
  return Shared.with<DeclarationId, bool>(&value.operation,
    fn(identity: &DeclarationId) -> bool { return numberingDeclarationCost(identity, &mut numbering.*) })
}
fn numberingNodeCost(value: &Type, numbering: &mut Numbering) -> bool {
  if !Numbering.isActive(&numbering.*) { return true }
  if !Numbering.bytes(&mut numbering.*, nodePayload(value)) { return false }
  // Count local vector elements before their metadata is copied. Structural children themselves
  // are also charged by enter/rewriteArgument; this never relies on runtime traversal order.
  return match &value.* {
    Type.Nominal {declaration, arguments, ..} => {
      if !Numbering.units(&mut numbering.*, DeclarationId.ownerCount(&declaration)) { return false }
      return Numbering.units(&mut numbering.*, Vector.length<Argument>(&arguments))
    }
    Type.Parameter {declaration, ..} => Numbering.units(&mut numbering.*, DeclarationId.ownerCount(&declaration))
    Type.CallableOrigin {application, ..} => Shared.with<Application, bool>(&application,
      fn(selected: &Application) -> bool { return Application.numberingCost(selected, &mut numbering.*) })
    Type.OpaqueRepresentation {application, ..} => Shared.with<Application, bool>(&application,
      fn(selected: &Application) -> bool { return Application.numberingCost(selected, &mut numbering.*) })
    Type.CallableWitnessResult {witness} => Shared.with<WitnessRecipe, bool>(&witness,
      fn(recipe: &WitnessRecipe) -> bool { return numberingWitnessCost(recipe, &mut numbering.*) })
    Type.Anonymous {occurrence, members} => {
      if !Numbering.units(&mut numbering.*, Vector.length<Shared<Type>>(&members)) { return false }
      let generator = Shared.with<AnonymousOccurrence, Shared<DeclarationId>>(&occurrence,
        fn(site: &AnonymousOccurrence) -> Shared<DeclarationId> { return Shared.clone<DeclarationId>(&site.declaration) })
      return Shared.with<DeclarationId, bool>(&generator,
        fn(identity: &DeclarationId) -> bool { return numberingDeclarationCost(identity, &mut numbering.*) })
    }
    Type.Union {members} => Numbering.units(&mut numbering.*, Vector.length<Shared<Type>>(&members))
    Type.Callable {parameters, invocationBounds, ..} => {
      if !Numbering.units(&mut numbering.*, Vector.length<Shared<Type>>(&parameters)) { return false }
      return Numbering.units(&mut numbering.*, Vector.length<Outlives>(&invocationBounds))
    }
    Type.CallableValue {application, captures, fieldInputs, ..} => {
      let affordable = Shared.with<Application, bool>(&application,
        fn(selected: &Application) -> bool { return Application.numberingCost(selected, &mut numbering.*) })
      if !affordable { return false }
      if !Numbering.units(&mut numbering.*, Vector.length<Shared<Type>>(&captures)) { return false }
      return Numbering.units(&mut numbering.*, Vector.length<CallableFieldInput>(&fieldInputs))
    }
    Type.CallableSchema {schema, captures, fieldInputs, ..} => {
      let affordable = Shared.with<SectionSchema, bool>(&schema,
        fn(selected: &SectionSchema) -> bool { return numberingSchemaCost(selected, &mut numbering.*) })
      if !affordable { return false }
      if !Numbering.units(&mut numbering.*, Vector.length<Shared<Type>>(&captures)) { return false }
      return Numbering.units(&mut numbering.*, Vector.length<CallableFieldInput>(&fieldInputs))
    }
    Type.CallableStage {captures, ..} => Numbering.units(&mut numbering.*, Vector.length<Shared<Type>>(&captures))
    Type.CallableResult {arguments, selected, selectedOrdinals, ..} => {
      if !Numbering.units(&mut numbering.*, Vector.length<Shared<Type>>(&arguments)) { return false }
      if !Numbering.units(&mut numbering.*, Vector.length<Argument>(&selected)) { return false }
      return Numbering.units(&mut numbering.*, Vector.length<usize>(&selectedOrdinals))
    }
    Type.EffectComposite {parts, ..} => Numbering.units(&mut numbering.*, Vector.length<Shared<Type>>(&parts))
    Type.EffectJoin {alternatives, ..} => Numbering.units(&mut numbering.*, Vector.length<Shared<Type>>(&alternatives))
    _ => true
  }
}

effect fn rewriteType(value: &Shared<Type>, owner: &DeclarationId, arguments: &[Argument], fresh: &Option<DeclarationId>, instantiate: bool, bindings: &[Binding], invocation: &Option<DeclarationId>, opaque: &Option<Application>, numbering: &mut Numbering) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let address = Shared.with<Type, usize>(value, fn(held: &Type) -> usize {
    return Pointer.address<Type>(Pointer.fromRef<Type>(held))
  })
  let entered = run Numbering.enter(&mut numbering.*, address, 0)
  if !entered { return Shared.clone<Type>(value) }
  let affordable = Shared.with<Type, bool>(value,
    fn(node: &Type) -> bool { return numberingNodeCost(node, &mut numbering.*) })
  if !affordable {
    Numbering.leave(&mut numbering.*)
    return Shared.clone<Type>(value)
  }
  let rewritten = run rewriteTypeInside(value, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
  Numbering.leave(&mut numbering.*)
  return move rewritten
}

// Leaves that substitution leaves as they are once no binding or argument replaced them.
fn rewritesToItself(value: &Type) -> bool {
  return match & value.* {
    Type.Primitive {..} => true
    Type.Unit => true
    Type.Parameter {..} => true
    _ => false
  }
}

fn sameTypeHandle(left: &Shared<Type>, right: &Shared<Type>) -> bool {
  return Shared.with<Type, usize>(left, addressOf) == Shared.with<Type, usize>(right, addressOf)
}

fn sameTypeHandles(left: &[Shared<Type>], right: &[Shared<Type>]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if !sameTypeHandle(&left[at], &right[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

fn sameLifetimeHandle(left: &Shared<Lifetime>, right: &Shared<Lifetime>) -> bool {
  return Shared.with<Lifetime, usize>(left, lifetimeAddress) == Shared.with<Lifetime, usize>(right, lifetimeAddress)
}

// Whether each rewritten argument is the original handle; rows are always rebuilt.
fn sameArgumentHandles(left: &Vector<Argument>, right: &Vector<Argument>) -> bool {
  let before = Vector.asSlice<Argument>(left)
  let after = Vector.asSlice<Argument>(right)
  if before.length != after.length { return false }
  let mut at = usize.ZERO
  while at < before.length {
    let same = match & before[at] {
      Argument.Type {value: original} => match & after[at] {
        Argument.Type {value: rewritten} => sameTypeHandle(&original, &rewritten)
        _ => false
      }
      Argument.Lifetime {value: original} => match & after[at] {
        Argument.Lifetime {value: rewritten} => sameLifetimeHandle(&original, &rewritten)
        _ => false
      }
      Argument.Row {..} => false
    }
    if !same { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn rewriteTypeInside(value: &Shared<Type>, owner: &DeclarationId, arguments: &[Argument], fresh: &Option<DeclarationId>, instantiate: bool, bindings: &[Binding], invocation: &Option<DeclarationId>, opaque: &Option<Application>, numbering: &mut Numbering) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
    let exactSupplied = Shared.with<Type, Option<Argument>>(value, fn(node: &Type) -> Option<Argument> {
      if let Type.Parameter {declaration, ordinal} = &node.* {
        return exactArgument(bindings, &declaration, ordinal)
      }
      return Option.none<Argument>()
    })
    if let Option<Argument>.Some {value: Argument.Type {value: bound}} = move exactSupplied {
      return move bound
    }
    let ordinal = Shared.with<Type, usize>(
      value,
      fn(node: &Type) -> usize {
        return Type.parameterOrdinalOf(node, owner)
      },
    )
    if ordinal != usize.MAX {
      if let Option<DeclarationId>.Some {value: replacement} = &fresh.* {
        return run Shared.make<Type>(Type.Parameter {
          declaration: run DeclarationId.copy(&replacement), ordinal: ordinal,
        })
      }
    }
    if ordinal < arguments.length {
      if let Argument.Type {value: supplied} = &arguments[ordinal] {
        return Shared.clone<Type>(&supplied)
      }
    }
    // A leaf the substitution above did not replace is unchanged, and so is a node whose rewritten
    // children are the same handles: the original handle is returned instead of an equal copy.
    if Shared.with<Type, bool>(value, rewritesToItself) { return Shared.clone<Type>(value) }
    let node = run nodeCopy(value)
    let replaced = match move node {
      Type.Nominal {declaration, isPublic, arguments: supplied} => {
        let rewritten = run rewrittenArguments(&supplied, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        if sameArgumentHandles(&supplied, &rewritten) { return Shared.clone<Type>(value) }
        return run Shared.make<Type>(Type.Nominal {declaration: move declaration, isPublic: isPublic, arguments: move rewritten})
      }
      Type.CallableWitnessResult {witness} => {
        let recipe = Shared.with<WitnessRecipe, WitnessRecipe>(&witness, CallableWitness.copy)
        let mut chosen = Vector.make<Binding>()
        let mut at = usize.ZERO
        while at < CallableWitness.bindingCount(&recipe) {
          let binding = CallableWitness.bindingAt(&recipe, at)
          run Vector.append<Binding>(&mut chosen, Binding {declaration: move binding.declaration, ordinal: binding.ordinal,
            value: run rewriteArgument(&binding.value, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)})
          at = at + usize.ONE
        }
        let mut supplied = Vector.make<Shared<Type>>()
        at = usize.ZERO
        while at < CallableWitness.argumentCount(&recipe) {
          let argument = CallableWitness.argumentAt(&recipe, at)
          run Vector.append<Shared<Type>>(&mut supplied, run rewriteType(&argument, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*))
          at = at + usize.ONE
        }
        let mut regions = Vector.make<WitnessLoan>()
        at = usize.ZERO
        while at < CallableWitness.loanCount(&recipe) {
          let region = CallableWitness.loanAt(&recipe, at)
          let rewritten = match move region {
            Option<Shared<Lifetime>>.Some {value: transported} => Option.some<Shared<Lifetime>>(run rewriteLifetime(&transported, owner, arguments, fresh, instantiate, bindings, invocation, &mut numbering.*))
            _ => Option.none<Shared<Lifetime>>()
          }
          run Vector.append<WitnessLoan>(&mut regions, WitnessLoan {region: move rewritten})
          at = at + usize.ONE
        }
        // One exclusive numbering loan per statement keeps the walk order explicit.
        let recipeContract = run rewriteType(&recipe.contract, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        let recipeProvider = run rewriteType(&recipe.provider, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        let recipeResult = run rewriteType(&recipe.result, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        return run Shared.make<Type>(Type.CallableWitnessResult {witness: run Shared.make<WitnessRecipe>(WitnessRecipe {
          operation: move recipe.operation,
          contract: move recipeContract,
          provider: move recipeProvider,
          result: move recipeResult,
          bindings: run Shared.make<Vector<Binding>>(move chosen), arguments: run Shared.make<Vector<Shared<Type>>>(move supplied),
          loans: run Shared.make<Vector<WitnessLoan>>(move regions), constructs: recipe.constructs})})
      }
      Type.CallableOrigin {application, contract} => {
        let selected = run rewriteCallableApplication(&application, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        return run Shared.make<Type>(Type.CallableOrigin {application: run Shared.make<Application>(move selected),
          contract: run rewriteType(&contract, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)})
      }
      Type.OpaqueRepresentation {application, contract, detached, nonParking} => {
        let selected = run rewriteOpaqueApplication(&application, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        return run Shared.make<Type>(Type.OpaqueRepresentation {application: run Shared.make<Application>(move selected),
          contract: run rewriteType(&contract, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*),
          detached: detached, nonParking: nonParking})
      }
      Type.Reference {referent, access, lifetime} => {
        let target = run rewriteType(&referent, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        let region = run rewriteLifetime(&lifetime, owner, arguments, fresh, instantiate, bindings, invocation, &mut numbering.*)
        if sameTypeHandle(&referent, &target) && sameLifetimeHandle(&lifetime, &region) { return Shared.clone<Type>(value) }
        return run Shared.make<Type>(Type.Reference {referent: move target, access: access, lifetime: move region})
      }
      Type.Slice {element, access, lifetime} => {
        let item = run rewriteType(&element, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        let region = run rewriteLifetime(&lifetime, owner, arguments, fresh, instantiate, bindings, invocation, &mut numbering.*)
        if sameTypeHandle(&element, &item) && sameLifetimeHandle(&lifetime, &region) { return Shared.clone<Type>(value) }
        return run Shared.make<Type>(Type.Slice {element: move item, access: access, lifetime: move region})
      }
      Type.Pointer {pointee, access, nullable, multiplicity, alignment} => {
        let target = run rewriteType(&pointee, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        if sameTypeHandle(&pointee, &target) { return Shared.clone<Type>(value) }
        return run Shared.make<Type>(Type.Pointer {pointee: move target, access: access, nullable: nullable,
          multiplicity: multiplicity, alignment: move alignment})
      }
      Type.Array {element, extent} => {
        let item = run rewriteType(&element, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        if sameTypeHandle(&element, &item) { return Shared.clone<Type>(value) }
        return run Shared.make<Type>(Type.Array {element: move item, extent: move extent})
      }
      Type.TypeDescriptor {owner: described} => {
        let rebound = run rewriteType(&described, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        if sameTypeHandle(&described, &rebound) { return Shared.clone<Type>(value) }
        return run Shared.make<Type>(Type.TypeDescriptor {owner: move rebound})
      }
      Type.Without {source, removed} => {
        let from = run rewriteType(&source, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        let keys = run rewriteType(&removed, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        if observingOrFailed(&numbering.*) { return Shared.clone<Type>(value) }
        if sameTypeHandle(&source, &from) && sameTypeHandle(&removed, &keys) { return Shared.clone<Type>(value) }
        if Numbering.isActive(&numbering.*) { return run Shared.make<Type>(Type.Without {source: move from, removed: move keys}) }
        return run Type.without(&from, &keys)
      }
      Type.Anonymous {occurrence, members} => {
        let listed = Vector.asSlice<Shared<Type>>(&members)
        let mut substituted = Vector.make<Shared<Type>>()
        let mut at = usize.ZERO
        while at < listed.length {
          run Vector.append<Shared<Type>>(&mut substituted, run rewriteType(&listed[at], owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*))
          at = at + usize.ONE
        }
        if sameTypeHandles(listed, Vector.asSlice<Shared<Type>>(&substituted)) { return Shared.clone<Type>(value) }
        return run Shared.make<Type>(Type.Anonymous {occurrence: move occurrence, members: move substituted})
      }
      Type.Union {members} => {
        let listed = Vector.asSlice<Shared<Type>>(&members)
        let mark = Numbering.occurrenceMark(&numbering.*)
        let mut normalized = Vector.make<Shared<Type>>()
        let mut at = usize.ZERO
        while at < listed.length {
          let replaced = run rewriteType(&listed[at], owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
          if Numbering.isActive(&numbering.*) {
            run Vector.append<Shared<Type>>(&mut normalized, move replaced)
          } else { run Type.joinMember(&mut normalized, &replaced) }
          at = at + usize.ONE
        }
        if listed.length > usize.ONE { Numbering.unorderedSince(&mut numbering.*, mark) }
        if observingOrFailed(&numbering.*) { return Shared.clone<Type>(value) }
        if Vector.length<Shared<Type>>(&normalized) == usize.ONE {
          return firstNormalized(&normalized)
        }
        return run Shared.make<Type>(Type.Union {members: move normalized})
      }
      Type.CallableValue {isPublic, application, contract, captures, fieldInputs, runtime} => {
        let rewritten = run rewriteCallableApplication(&application, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        let mut fields = Vector.make<Shared<Type>>()
        let previous = Vector.asSlice<Shared<Type>>(&captures)
        let inputs = Vector.asSlice<CallableFieldInput>(&fieldInputs)
        let mut at = usize.ZERO
        while at < previous.length {
          // A represented capture shares its rewritten slot instead of being rewritten again.
          let field = match move representedSlot(inputs, at) {
            Option<usize>.Some {value: slot} => match move Application.typeAt(&rewritten, slot) {
              Option<Shared<Type>>.Some {value: shared} => move shared
              Option<Shared<Type>>.None => absurd<Shared<Type>>()
            }
            Option<usize>.None => run rewriteType(&previous[at], owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
          }
          run Vector.append<Shared<Type>>(&mut fields, move field)
          at = at + usize.ONE
        }
        let reboundContract = run rewriteType(&contract, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        if observingOrFailed(&numbering.*) { return Shared.clone<Type>(value) }
        if Numbering.isActive(&numbering.*) {
          return run Shared.make<Type>(Type.CallableValue {isPublic: isPublic,
            application: run Shared.make<Application>(move rewritten), contract: move reboundContract,
            captures: move fields, fieldInputs: move fieldInputs, runtime: move runtime})
        }
        return run Type.callableValue(isPublic, run Shared.make<Application>(move rewritten),
          move reboundContract, move fields, move fieldInputs)
      }
      Type.CallableSchema {schema, captures, fieldInputs, runtime} => {
        let mut copied = run CallableSchema.copy(&schema)
        let values = Vector.asMutSlice<Binding>(&mut copied.selected)
        let mut at = usize.ZERO
        while at < values.length {
          values[at].value = run rewriteArgument(&values[at].value, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
          at = at + usize.ONE
        }
        // The raw parameter/result blueprint binds its target variables. Only its environment
        // is free caller validity and follows owner substitution.
        copied.contract = run rewriteSchemaEnvironment(&copied.contract, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        let mut fields = Vector.make<Shared<Type>>()
        let previous = Vector.asSlice<Shared<Type>>(&captures)
        at = usize.ZERO
        while at < previous.length {
          run Vector.append<Shared<Type>>(&mut fields, run rewriteType(&previous[at], owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*))
          at = at + usize.ONE
        }
        if observingOrFailed(&numbering.*) { return Shared.clone<Type>(value) }
        if Numbering.isActive(&numbering.*) {
          return run Shared.make<Type>(Type.CallableSchema {schema: run Shared.make<SectionSchema>(move copied),
            captures: move fields, fieldInputs: move fieldInputs, runtime: move runtime})
        }
        return run Type.callableSchema(run Shared.make<SectionSchema>(move copied), move fields, move fieldInputs)
      }
      Type.CallableResult {producer, contract, arguments: supplied, selected, selectedOrdinals} => {
        let mut reboundInputs = Vector.make<Shared<Type>>()
        let listed = Vector.asSlice<Shared<Type>>(&supplied)
        let mut at = usize.ZERO
        while at < listed.length {
          run Vector.append<Shared<Type>>(&mut reboundInputs, run rewriteType(&listed[at], owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*))
          at = at + usize.ONE
        }
        let reboundProducer = run rewriteType(&producer, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        let reboundContract = run rewriteType(&contract, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        let reboundSelected = run rewrittenArguments(&selected, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        return run Shared.make<Type>(Type.CallableResult {producer: move reboundProducer, contract: move reboundContract,
          arguments: move reboundInputs, selected: move reboundSelected, selectedOrdinals: move selectedOrdinals})
      }
      Type.EffectComposite {operation, selector, contract, parts} => {
        let mut fields = Vector.make<Shared<Type>>()
        let previous = Vector.asSlice<Shared<Type>>(&parts)
        let mut at = usize.ZERO
        while at < previous.length {
          run Vector.append<Shared<Type>>(&mut fields,
            run rewriteType(&previous[at], owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*))
          at = at + usize.ONE
        }
        let reboundSelector = run rewriteType(&selector, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        let reboundContract = run rewriteType(&contract, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        return run Shared.make<Type>(Type.EffectComposite {operation: operation, selector: move reboundSelector,
          contract: move reboundContract, parts: move fields})
      }
      Type.EffectJoin {contract, alternatives} => {
        // Positional: substitution never merges alternatives, so each node's tag stays valid;
        // storage projection detects a collapsed representation (UnionProjection.map).
        let mut joined = Vector.make<Shared<Type>>()
        let previous = Vector.asSlice<Shared<Type>>(&alternatives)
        let mut at = usize.ZERO
        while at < previous.length {
          run Vector.append<Shared<Type>>(&mut joined,
            run rewriteType(&previous[at], owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*))
          at = at + usize.ONE
        }
        return run Shared.make<Type>(Type.EffectJoin {
          contract: run rewriteType(&contract, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*),
          alternatives: move joined})
      }
      Type.CallableView {representation, contract} => {
        let reboundRepresentation = run rewriteType(&representation, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        let reboundContract = run rewriteType(&contract, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        if observingOrFailed(&numbering.*) { return Shared.clone<Type>(value) }
        if Numbering.isActive(&numbering.*) {
          // Identity keeps the authored view but collapses a reborrowed lender, as `callableView` does.
          let mut stored = move reboundRepresentation
          if let Option<Shared<Type>>.Some {value: lender} = move reborrowedLender(&stored) { stored = move lender }
          return run Shared.make<Type>(Type.CallableView {representation: move stored, contract: move reboundContract})
        }
        return run Type.callableView(move reboundRepresentation, move reboundContract)
      }
      Type.CallableStage {base, contract, captures, remaining, suffixMode} => {
        let mut fields = Vector.make<Shared<Type>>()
        let previous = Vector.asSlice<Shared<Type>>(&captures)
        let mut at = usize.ZERO
        while at < previous.length {
          run Vector.append<Shared<Type>>(&mut fields,
            run rewriteType(&previous[at], owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*))
          at = at + usize.ONE
        }
        let reboundBase = run rewriteType(&base, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        let reboundContract = run rewriteType(&contract, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        if observingOrFailed(&numbering.*) { return Shared.clone<Type>(value) }
        if Numbering.isActive(&numbering.*) {
          return run Shared.make<Type>(Type.CallableStage {base: move reboundBase, contract: move reboundContract,
            captures: move fields, remaining: remaining, suffixMode: suffixMode})
        }
        return run Type.stagedCallable(move reboundBase, move reboundContract, move fields, remaining, suffixMode, owner)
      }
      Type.Callable {
        mode,
        isUnsafe,
        environment,
        invocationBinders,
        invocationUse,
        invocationBounds,
        parameters,
        result,
      } => {
        let mut nestedInvocation = Option.none<DeclarationId>()
        if invocationBinders == usize.ZERO {
          if let Option<DeclarationId>.Some {value: outer} = &invocation.* {
            nestedInvocation = Option.some<DeclarationId>(run DeclarationId.copy(&outer))
          }
        }
        let listed = Vector.asSlice<Shared<Type>>(&parameters)
        let mut substituted = Vector.make<Shared<Type>>()
        let mut at = usize.ZERO
        while at < listed.length {
          run Vector.append<Shared<Type>>(
            &mut substituted,
            run rewriteType(&listed[at], owner, arguments, fresh, instantiate, bindings, &nestedInvocation, opaque, &mut numbering.*),
          )
          at = at + usize.ONE
        }
        let reboundEnvironment = run rewriteEnvironment(&environment, owner, arguments, fresh, instantiate, bindings, &nestedInvocation, &mut numbering.*)
        let boundsMark = Numbering.occurrenceMark(&numbering.*)
        let reboundBounds = run rewriteOutlives(&invocationBounds, owner, arguments, fresh, instantiate, bindings, &nestedInvocation, &mut numbering.*)
        if Vector.length<Outlives>(&invocationBounds) > usize.ONE { Numbering.unorderedSince(&mut numbering.*, boundsMark) }
        let reboundResult = run rewriteType(&result, owner, arguments, fresh, instantiate, bindings, &nestedInvocation, opaque, &mut numbering.*)
        return run Shared.make<Type>(
          Type.Callable {
            mode: mode,
            isUnsafe: isUnsafe,
            environment: move reboundEnvironment,
            invocationBinders: invocationBinders, invocationUse: invocationUse,
            invocationBounds: move reboundBounds,
            parameters: move substituted,
            result: move reboundResult,
          },
        )
      }
      Type.ForeignFunction {signature, behavior} => {
        let rebound = run rewriteType(&signature, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        return run Shared.make<Type>(Type.ForeignFunction {signature: move rebound, behavior: behavior})
      }
      Type.Effect {mode, environment, success, failure, requirements} => {
        let reboundEnvironment = run rewriteEnvironment(&environment, owner, arguments, fresh, instantiate, bindings, invocation, &mut numbering.*)
        let reboundSuccess = run rewriteType(&success, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        let reboundFailure = run rewriteType(&failure, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        let reboundRequirements = run rewriteRow(&requirements, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
        return run Shared.make<Type>(Type.Effect {mode: mode, environment: move reboundEnvironment, success: move reboundSuccess,
          failure: move reboundFailure, requirements: move reboundRequirements})
      }
      Type.Primitive {..} => absurd<Type>()
      Type.Unit => absurd<Type>()
      Type.Parameter {..} => absurd<Type>()
      Type.String {lifetime} => {
        let region = run rewriteLifetime(&lifetime, owner, arguments, fresh, instantiate, bindings, invocation, &mut numbering.*)
        if sameLifetimeHandle(&lifetime, &region) { return Shared.clone<Type>(value) }
        return run Shared.make<Type>(Type.String {lifetime: move region})
      }
    }
    return run Shared.make<Type>(move replaced)
}

effect fn rewrittenArguments(
  values: &Vector<Argument>,
  owner: &DeclarationId,
  arguments: &[Argument],
  fresh: &Option<DeclarationId>,
  instantiate: bool,
  bindings: &[Binding],
  invocation: &Option<DeclarationId>,
 opaque: &Option<Application>, numbering: &mut Numbering) -> Vector<Argument> ! OutOfMemoryError ? &mut Allocator {
  let listed = Vector.asSlice<Argument>(values)
  let mut output = Vector.make<Argument>()
  let mut at = usize.ZERO
  while at < listed.length {
    run Vector.append<Argument>(&mut output, run rewriteArgument(&listed[at], owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*))
    at = at + usize.ONE
  }
  return move output
}
effect fn rewriteArgument(value: &Argument, owner: &DeclarationId, arguments: &[Argument], fresh: &Option<DeclarationId>, instantiate: bool, bindings: &[Binding], invocation: &Option<DeclarationId>, opaque: &Option<Application>, numbering: &mut Numbering) -> Argument
! OutOfMemoryError ? &mut Allocator {
  if !Numbering.units(&mut numbering.*, 2) { return Argument.copy(value) }
  return match &value.* {
    Argument.Type {value: ty} => Argument.Type {value: run rewriteType(&ty, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)}
    Argument.Row {value: row} => Argument.Row {value: run rewriteRow(&row, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)}
    Argument.Lifetime {value: region} => Argument.Lifetime {value: run rewriteLifetime(&region, owner, arguments, fresh, instantiate, bindings, invocation, &mut numbering.*)}
  }
}

impl Argument {
  /// Substitutes a generic argument's types and rows while retaining symbolic lifetimes.
  pub effect fn substitute(value: &Argument, owner: &DeclarationId, arguments: &[Argument]) -> Argument
  ! OutOfMemoryError ? &mut Allocator {
    let bindings = Vector.make<Binding>()
    let mut numbering = Numbering.inactive()
    return run rewriteArgument(value, owner, arguments, &Option.none<DeclarationId>(), false, Vector.asSlice<Binding>(&bindings), &Option.none<DeclarationId>(), &Option.none<Application>(), &mut numbering)
  }
}

impl Row {
  /// Substitutes service-role key types and expands rows supplied for this declaration's binders.
  pub effect fn substitute(value: &Shared<Row>, owner: &DeclarationId, arguments: &[Argument]) -> Shared<Row>
  ! OutOfMemoryError ? &mut Allocator {
    let bindings = Vector.make<Binding>()
    let mut numbering = Numbering.inactive()
    return run rewriteRow(value, owner, arguments, &Option.none<DeclarationId>(), false, Vector.asSlice<Binding>(&bindings), &Option.none<DeclarationId>(), &Option.none<Application>(), &mut numbering)
  }
  /// Renames every owned type, lifetime and row parameter without changing normalized keys.
  pub effect fn renameParameters(value: &Shared<Row>, owner: &DeclarationId, replacement: &DeclarationId) -> Shared<Row>
  ! OutOfMemoryError ? &mut Allocator {
    let arguments = Vector.make<Argument>()
    let bindings = Vector.make<Binding>()
    let mut numbering = Numbering.inactive()
    return run rewriteRow(value, owner, Vector.asSlice<Argument>(&arguments), &Option.some<DeclarationId>(run DeclarationId.copy(replacement)), false, Vector.asSlice<Binding>(&bindings), &Option.none<DeclarationId>(), &Option.none<Application>(), &mut numbering)
  }
}

effect fn rewriteRow(value: &Shared<Row>, owner: &DeclarationId, arguments: &[Argument], fresh: &Option<DeclarationId>, instantiate: bool, bindings: &[Binding], invocation: &Option<DeclarationId>, opaque: &Option<Application>, numbering: &mut Numbering) -> Shared<Row>
! OutOfMemoryError ? &mut Allocator {
  let address = Shared.with<Row, usize>(value, fn(held: &Row) -> usize {
    return Pointer.address<Row>(Pointer.fromRef<Row>(held))
  })
  let entered = run Numbering.enter(&mut numbering.*, address, 1)
  if !entered { return Shared.clone<Row>(value) }
  let affordable = Shared.with<Row, bool>(value, fn(held: &Row) -> bool {
    if !Numbering.units(&mut numbering.*, Vector.length<Requirement>(&held.entries)) { return false }
    if !Numbering.units(&mut numbering.*, Vector.length<RowParameter>(&held.parameters)) { return false }
    return Numbering.units(&mut numbering.*, Vector.length<RowSubtraction>(&held.subtractions))
  })
  if !affordable { Numbering.leave(&mut numbering.*)
    return Shared.clone<Row>(value) }
  let rewritten = run rewriteRowInside(value, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
  Numbering.leave(&mut numbering.*)
  return move rewritten
}

effect fn rewriteRowInside(value: &Shared<Row>, owner: &DeclarationId, arguments: &[Argument], fresh: &Option<DeclarationId>, instantiate: bool, bindings: &[Binding], invocation: &Option<DeclarationId>, opaque: &Option<Application>, numbering: &mut Numbering) -> Shared<Row>
! OutOfMemoryError ? &mut Allocator {
    let mut result = Row.empty()
    let count = Shared.with<Row, usize>(value, rowEntryCount)
    let entriesMark = Numbering.occurrenceMark(&numbering.*)
    let mut at = usize.ZERO
    while at < count {
      let entry = entryAt(value, at)
      let roleValue = match move entry.roleType {
        Option<Shared<Type>>.Some {value: ty} => Option.some<Shared<Type>>(
          run rewriteType(&ty, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*),
        )
        Option<Shared<Type>>.None => Option.none<Shared<Type>>()
      }
      let capability = run rewriteType(&entry.capability, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
      if !observingOrFailed(&numbering.*) {
        let rewritten = Requirement {capability: move capability, roleType: move roleValue, access: entry.access}
        if Numbering.isActive(&numbering.*) {
          // Injective alpha renaming preserves the authenticated normalized row keys and access.
          // Re-running semantic factories would do unnecessary, unmetered equality/inference.
          run Vector.append<Requirement>(&mut result.entries, move rewritten)
        } else {
          run Row.require(&mut result, move rewritten)
        }
      }
      at = at + usize.ONE
    }
    if count > usize.ONE { Numbering.unorderedSince(&mut numbering.*, entriesMark) }
    let parameterCount = Shared.with<Row, usize>(value, rowParameterCount)
    at = usize.ZERO
    while at < parameterCount {
      let mut parameter = Shared.with<Row, RowParameter>(
        value,
        fn(row: &Row) -> RowParameter {
          return rowParameterAt(row, at)
        },
      )
      if Numbering.isActive(&numbering.*) {
        if !observingOrFailed(&numbering.*) {
          run Vector.append<RowParameter>(&mut result.parameters, move parameter)
        }
        at = at + usize.ONE
        continue
      }
      let exactSupplied = exactSharedArgument(bindings, &parameter.declaration, parameter.ordinal)
      if let Option<Argument>.Some {value: Argument.Row {value: bound}} = move exactSupplied {
        run Row.merge(&mut result, &bound)
        at = at + usize.ONE
        continue
      }
      if declarationWith(owner, &parameter.declaration) && parameter.ordinal < arguments.length {
        if let Argument.Row {value: supplied} = &arguments[parameter.ordinal] {
          run Row.merge(&mut result, &supplied)
          at = at + usize.ONE
          continue
        }
      }
      if declarationWith(owner, &parameter.declaration) {
        if let Option<DeclarationId>.Some {value: replacement} = &fresh.* {
          parameter.declaration = run Shared.make<DeclarationId>(run DeclarationId.copy(&replacement))
        }
      }
      run Row.include(&mut result, move parameter)
      at = at + usize.ONE
    }
    // A substituted term normalizes as soon as its rows no longer depend on a parameter.
    let terms = subtractionCount(value)
    let termsMark = Numbering.occurrenceMark(&numbering.*)
    at = usize.ZERO
    while at < terms {
      let term = subtractionAt(value, at)
      let source = run rewriteRow(&term.source, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
      let removed = run rewriteRow(&term.removed, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
      if !observingOrFailed(&numbering.*) {
        if Numbering.isActive(&numbering.*) {
          run Vector.append<RowSubtraction>(&mut result.subtractions, RowSubtraction {source: move source, removed: move removed})
        } else {
          run Row.subtract(&mut result, &source, &removed)
        }
      }
      at = at + usize.ONE
    }
    if terms > usize.ONE { Numbering.unorderedSince(&mut numbering.*, termsMark) }
    if observingOrFailed(&numbering.*) { return Shared.clone<Row>(value) }
    return run Shared.make<Row>(move result)
}

impl Type {
  /// Renames one owned lifetime parameter; local regions and quantified invocation binders stay rigid.
  pub effect fn renameLifetime(value: &Shared<Lifetime>, owner: &DeclarationId, replacement: &DeclarationId) -> Shared<Lifetime>
  ! OutOfMemoryError ? &mut Allocator {
    let arguments = Vector.make<Argument>()
    let bindings = Vector.make<Binding>()
    let mut numbering = Numbering.inactive()
    return run rewriteLifetime(value, owner, Vector.asSlice<Argument>(&arguments), &Option.some<DeclarationId>(run DeclarationId.copy(replacement)), false, Vector.asSlice<Binding>(&bindings), &Option.none<DeclarationId>(), &mut numbering)
  }
}

// Substitutes one region, then gives a caller region its canonical instance identity when
// `numbering` is active.
effect fn rewriteLifetime(value: &Shared<Lifetime>, owner: &DeclarationId, arguments: &[Argument], fresh: &Option<DeclarationId>, instantiate: bool, bindings: &[Binding], invocation: &Option<DeclarationId>, numbering: &mut Numbering) -> Shared<Lifetime>
! OutOfMemoryError ? &mut Allocator {
  if Numbering.isActive(&numbering.*) { return run Numbering.region(&mut numbering.*, value) }
  return run substitutedLifetime(value, owner, arguments, fresh, instantiate, bindings, invocation)
}

effect fn substitutedLifetime(value: &Shared<Lifetime>, owner: &DeclarationId, arguments: &[Argument], fresh: &Option<DeclarationId>, instantiate: bool, bindings: &[Binding], invocation: &Option<DeclarationId>) -> Shared<Lifetime>
! OutOfMemoryError ? &mut Allocator {
  let atoms = Lifetime.atomCount(value)
  if atoms > usize.ONE {
    let mut rewrittenAtoms = Vector.make<Shared<Lifetime>>()
    let mut atomAt = usize.ZERO
    while atomAt < atoms {
      let atom = Lifetime.atomAt(value, atomAt)
      let rewritten = run substitutedLifetime(&atom, owner, arguments, fresh, instantiate, bindings, invocation)
      run Vector.append<Shared<Lifetime>>(&mut rewrittenAtoms, move rewritten)
      atomAt = atomAt + usize.ONE
    }
    return run Lifetime.meet(Vector.asSlice<Shared<Lifetime>>(&rewrittenAtoms))
  }
  if let Option<DeclarationId>.Some {value: caller} = &invocation.* {
    let ordinal = Shared.with<Lifetime, usize>(value, fn(region: &Lifetime) -> usize {
      return match &region.* { Lifetime.Invocation {ordinal} => ordinal _ => usize.MAX }
    })
    if ordinal != usize.MAX {
      return run Shared.make<Lifetime>(Lifetime.Parameter {declaration: run DeclarationId.copy(&caller), ordinal: ordinal})
    }
  }
  if instantiate {
    let exactSupplied = Shared.with<Lifetime, Option<Argument>>(value,
      fn(region: &Lifetime) -> Option<Argument> {
        if let Lifetime.Parameter {declaration, ordinal} = &region.* {
          return exactArgument(bindings, &declaration, ordinal)
        }
        return Option.none<Argument>()
      })
    if let Option<Argument>.Some {value: Argument.Lifetime {value: bound}} = move exactSupplied {
      return move bound
    }
    let ordinal = Shared.with<Lifetime, usize>(value, fn(region: &Lifetime) -> usize {
      return ownedLifetimeOrdinal(region, owner)
    })
    if ordinal < arguments.length {
      if let Argument.Lifetime {value: supplied} = &arguments[ordinal] {
        return Shared.clone<Lifetime>(&supplied)
      }
    }
  }
  if let Option<DeclarationId>.Some {value: replacement} = &fresh.* {
    let ordinal = Shared.with<Lifetime, usize>(value, fn(region: &Lifetime) -> usize {
      return ownedLifetimeOrdinal(region, owner)
    })
    if ordinal != usize.MAX {
      return run Shared.make<Lifetime>(Lifetime.Parameter {declaration: run DeclarationId.copy(&replacement), ordinal: ordinal})
    }
  }
  return Shared.clone<Lifetime>(value)
}

effect fn rewriteEnvironment(value: &Shared<Intersection>, owner: &DeclarationId, arguments: &[Argument], fresh: &Option<DeclarationId>, instantiate: bool, bindings: &[Binding], invocation: &Option<DeclarationId>, numbering: &mut Numbering) -> Shared<Intersection>
! OutOfMemoryError ? &mut Allocator {
  if Numbering.isActive(&numbering.*) {
    return run Numbering.environment(&mut numbering.*, value)
  }
  if !instantiate && !Numbering.isActive(&numbering.*) {
    if let Option<DeclarationId>.None = &fresh.* { return Shared.clone<Intersection>(value) }
  }
  let mut regions = Vector.make<Shared<Lifetime>>()
  let count = environmentSize(value)
  if !Numbering.units(&mut numbering.*, count) { return Shared.clone<Intersection>(value) }
  let mut at = usize.ZERO
  while at < count {
    if let Option<Shared<Lifetime>>.Some {value: region} = move environmentMember(value, at) {
      run Vector.append<Shared<Lifetime>>(&mut regions, run substitutedLifetime(&region, owner, arguments, fresh, instantiate, bindings, invocation))
    }
    at = at + usize.ONE
  }
  let whole = run Lifetime.meet(Vector.asSlice<Shared<Lifetime>>(&regions))
  let rewritten = run Numbering.region(&mut numbering.*, &whole)
  Vector.clear<Shared<Lifetime>>(&mut regions)
  run Vector.append<Shared<Lifetime>>(&mut regions, move rewritten)
  return run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions)))
}

effect fn rewriteOutlives(value: &Vector<Outlives>, owner: &DeclarationId, arguments: &[Argument], fresh: &Option<DeclarationId>, instantiate: bool, bindings: &[Binding], invocation: &Option<DeclarationId>, numbering: &mut Numbering) -> Vector<Outlives>
! OutOfMemoryError ? &mut Allocator {
  let mut result = Vector.make<Outlives>()
  let listed = Vector.asSlice<Outlives>(value)
  let mut at = usize.ZERO
  while at < listed.length {
    let longer = run rewriteLifetime(&listed[at].longer, owner, arguments, fresh, instantiate, bindings, invocation, &mut numbering.*)
    let shorter = run rewriteLifetime(&listed[at].shorter, owner, arguments, fresh, instantiate, bindings, invocation, &mut numbering.*)
    run Vector.append<Outlives>(&mut result, Outlives {longer: move longer, shorter: move shorter})
    at = at + usize.ONE
  }
  return move result
}

fn accessCode(value: Access) -> u64 {
  return match value {
    Access.Shared => 0
    Access.Mutable => 1
  }
}

fn modeCode(value: CallableMode) -> u64 {
  return match value {
    CallableMode.Shared => 0
    CallableMode.Mutable => 1
    CallableMode.Once => 2
  }
}

impl Type {
  /// The ordered fields of a structural record or exact callable environment; absent otherwise.
  /// Callable fields are captures in CAPTURE-001 order, including stored section arguments.
  pub effect fn recordFields(value: &Shared<Type>) -> Option<Vector<Shared<Type>>> ! OutOfMemoryError ? &mut Allocator {
    return match move run nodeCopy(value) {
      Type.Anonymous {members, ..} => Option.some<Vector<Shared<Type>>>(move members)
      Type.CallableValue {captures, ..} => Option.some<Vector<Shared<Type>>>(move captures)
      Type.CallableSchema {captures, ..} => Option.some<Vector<Shared<Type>>>(move captures)
      Type.EffectComposite {parts, ..} => Option.some<Vector<Shared<Type>>>(move parts)
      _ => Option.none<Vector<Shared<Type>>>()
    }
  }
  /// The generating occurrence and member types of an anonymous aggregate; absent otherwise.
  pub effect fn anonymousParts(value: &Shared<Type>) -> Option<AnonymousParts> ! OutOfMemoryError ? &mut Allocator {
    let occurrence = Shared.with<Type, Option<Shared<AnonymousOccurrence>>>(
      value,
      fn(node: &Type) -> Option<Shared<AnonymousOccurrence>> {
        return match & node.* {
          Type.Anonymous {occurrence, ..} => Option.some<Shared<AnonymousOccurrence>>(Shared.clone<AnonymousOccurrence>(&occurrence))
          _ => Option.none<Shared<AnonymousOccurrence>>()
        }
      },
    )
    let selected = match move occurrence {
      Option<Shared<AnonymousOccurrence>>.Some {value: found} => move found
      Option<Shared<AnonymousOccurrence>>.None => { return Option.none<AnonymousParts>() }
    }
    let node = run nodeCopy(value)
    if let Type.Anonymous {members, ..} = move node {
      return Option.some<AnonymousParts>(AnonymousParts {occurrence: move selected, members: move members})
    }
    return Option.none<AnonymousParts>()
  }
  /// Encodes runtime identity with erased lifetimes, canonical unions and canonical rows.
  /// `owner` supplies the declaration context for walking shared nodes; it is not encoded.
  pub effect fn runtimeEncoding(value: &Shared<Type>, owner: &DeclarationId) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut coordinates = RuntimeEncoding.coordinates()
    return run Type.encoding(value, owner, false, &mut coordinates)
  }
  pub effect fn encoding(
    value: &Shared<Type>,
    owner: &DeclarationId,
    exact: bool,
    coordinates: &mut Coordinates,
  ) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    if coordinates.exceeded { return Bytes.make() }
    let affordable = Shared.with<Type, bool>(value, fn(node: &Type) -> bool {
      return RuntimeEncoding.recordPayload(&mut coordinates.*, nodePayload(node))
    })
    if !affordable { return Bytes.make() }
    let node = run nodeCopy(value)
    if !exact {
      if let Type.CallableView {representation, ..} = &node {
        return run Type.encoding(&representation, owner, exact, &mut coordinates.*)
    }
    }
    let mut output = Bytes.make()
    let kind = nodeKind(&node)
    run RuntimeEncoding.recordWord(&mut output, usize.toU64(kind), &mut coordinates.*)
    if exact {
      let mut regions = Vector.make<Bytes>()
      let count = ownLifetimeCount(&node)
      let mut at = usize.ZERO
      while at < count {
        let mut encoded = Bytes.make()
        if let Option<Shared<Lifetime>>.Some {value: region} = move ownLifetimeAt(&node, at) {
          run RuntimeEncoding.lifetime(&mut encoded, &region, &mut coordinates.*)
        }
        run Vector.append<Bytes>(&mut regions, move encoded)
        at = at + usize.ONE
      }
      // Ordered argument lifetimes are encoded below. Only environments are unordered here.
      match & node {
        Type.String {..} => {
          run RuntimeEncoding.recordSet(&mut output, &regions, &mut coordinates.*)
        }
        Type.Reference {..} => {
          run RuntimeEncoding.recordSet(&mut output, &regions, &mut coordinates.*)
        }
        Type.Slice {..} => {
          run RuntimeEncoding.recordSet(&mut output, &regions, &mut coordinates.*)
        }
        Type.Callable {invocationBinders, invocationUse, invocationBounds, ..} => {
          run RuntimeEncoding.recordSet(&mut output, &regions, &mut coordinates.*)
          run RuntimeEncoding.recordWord(&mut output, usize.toU64(invocationBinders), &mut coordinates.*)
          run RuntimeEncoding.recordWord(&mut output, usize.toU64(invocationUse), &mut coordinates.*)
          let bounds = Vector.asSlice<Outlives>(&invocationBounds)
          let mut encodedBounds = Vector.make<Bytes>()
          at = usize.ZERO
          while at < bounds.length {
            let mut bound = Bytes.make()
            run RuntimeEncoding.lifetime(&mut bound, &bounds[at].longer, &mut coordinates.*)
            run RuntimeEncoding.lifetime(&mut bound, &bounds[at].shorter, &mut coordinates.*)
            run Vector.append<Bytes>(&mut encodedBounds, move bound)
            at = at + usize.ONE
          }
          run RuntimeEncoding.recordSet(&mut output, &encodedBounds, &mut coordinates.*)
        }
        Type.Effect {..} => {
          run RuntimeEncoding.recordSet(&mut output, &regions, &mut coordinates.*)
        }
        _ => {}
      }
    }
    match & node {
      Type.Primitive {name} => {
        run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&name), &mut coordinates.*)
      }
      Type.Nominal {declaration, arguments, ..} => {
        run RuntimeEncoding.recordDeclaration(&mut output, &declaration, &mut coordinates.*)
        run encodeIdentityArguments(
          &mut output,
          Vector.asSlice<Argument>(&arguments),
          owner,
          exact,
          &mut coordinates.*,
        )
      }
      Type.CallableWitnessResult {witness} => {
        let recipe = Shared.with<WitnessRecipe, WitnessRecipe>(&witness, CallableWitness.copy)
        let affordableOwner = Shared.with<DeclarationId, bool>(&recipe.operation,
          fn(identity: &DeclarationId) -> bool { return RuntimeEncoding.recordPayload(&mut coordinates.*, RuntimeEncoding.declarationPayload(identity)) })
        if !affordableOwner { return Bytes.make() }
        let operation = run DeclarationId.copyShared(&recipe.operation)
        run RuntimeEncoding.recordDeclaration(&mut output, &operation, &mut coordinates.*)
        run encodeIdentityChild(&mut output, &recipe.contract, owner, exact, &mut coordinates.*)
        run encodeIdentityChild(&mut output, &recipe.provider, owner, exact, &mut coordinates.*)
        run encodeIdentityChild(&mut output, &recipe.result, owner, exact, &mut coordinates.*)
        let count = CallableWitness.bindingCount(&recipe)
        run RuntimeEncoding.recordWord(&mut output, usize.toU64(count), &mut coordinates.*)
        let mut at = usize.ZERO
        while at < count {
          let binding = CallableWitness.bindingAt(&recipe, at)
          let affordableOwner = Shared.with<DeclarationId, bool>(&binding.declaration,
          fn(identity: &DeclarationId) -> bool { return RuntimeEncoding.recordPayload(&mut coordinates.*, RuntimeEncoding.declarationPayload(identity)) })
        if !affordableOwner { return Bytes.make() }
        let declaration = run DeclarationId.copyShared(&binding.declaration)
          run RuntimeEncoding.recordDeclaration(&mut output, &declaration, &mut coordinates.*)
          run RuntimeEncoding.recordWord(&mut output, usize.toU64(binding.ordinal), &mut coordinates.*)
          let mut selected = Vector.make<Argument>()
          run Vector.append<Argument>(&mut selected, move binding.value)
          run encodeIdentityArguments(
            &mut output,
            Vector.asSlice<Argument>(&selected),
            owner,
            exact,
            &mut coordinates.*,
          )
          at = at + usize.ONE
        }
        let supplied = CallableWitness.argumentCount(&recipe)
        run RuntimeEncoding.recordWord(&mut output, usize.toU64(supplied), &mut coordinates.*)
        at = usize.ZERO
        while at < supplied {
          run encodeIdentityChild(
            &mut output,
            &CallableWitness.argumentAt(&recipe, at),
            owner,
            exact,
            &mut coordinates.*,
          )
          at = at + usize.ONE
        }
        run RuntimeEncoding.recordWord(&mut output, usize.toU64(CallableWitness.loanCount(&recipe)), &mut coordinates.*)
        at = usize.ZERO
        while at < CallableWitness.loanCount(&recipe) {
          let selected = CallableWitness.loanAt(&recipe, at)
          match move selected {
            Option<Shared<Lifetime>>.Some {value: region} => {
              run RuntimeEncoding.recordWord(&mut output, 1, &mut coordinates.*)
              if exact {
                run RuntimeEncoding.lifetime(&mut output, &region, &mut coordinates.*)
              }
            }
            _ => {
              run RuntimeEncoding.recordWord(&mut output, 0, &mut coordinates.*)
            }
          }
          at = at + usize.ONE
        }
      }
      Type.CallableOrigin {application, contract} => {
        let affordableApplication = Shared.with<Application, bool>(&application,
          fn(selected: &Application) -> bool { return Application.copiedPayloadFits(selected, &mut coordinates.*) })
        if !affordableApplication { return Bytes.make() }
        let selected = run Application.copyShared(&application)
        let encoding = run Application.encoding(&selected, exact, &mut coordinates.*)
        run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&encoding), &mut coordinates.*)
        run encodeIdentityChild(&mut output, &contract, owner, exact, &mut coordinates.*)
      }
      Type.OpaqueRepresentation {application, ..} => {
        let affordableApplication = Shared.with<Application, bool>(&application,
          fn(selected: &Application) -> bool { return Application.copiedPayloadFits(selected, &mut coordinates.*) })
        if !affordableApplication { return Bytes.make() }
        let selected = run Application.copyShared(&application)
        let encoding = run Application.encoding(&selected, exact, &mut coordinates.*)
        run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&encoding), &mut coordinates.*)
      }
      Type.Parameter {declaration, ordinal} => {
        run RuntimeEncoding.recordDeclaration(&mut output, &declaration, &mut coordinates.*)
        run RuntimeEncoding.recordWord(&mut output, usize.toU64(ordinal), &mut coordinates.*)
      }
      Type.Reference {referent, access, ..} => {
        run RuntimeEncoding.recordWord(&mut output, accessCode(access), &mut coordinates.*)
        run encodeIdentityChild(&mut output, &referent, owner, exact, &mut coordinates.*)
      }
      Type.Slice {element, access, ..} => {
        run RuntimeEncoding.recordWord(&mut output, accessCode(access), &mut coordinates.*)
        run encodeIdentityChild(&mut output, &element, owner, exact, &mut coordinates.*)
      }
      Type.Pointer {pointee, access, nullable, multiplicity, alignment} => {
        run RuntimeEncoding.recordWord(&mut output, accessCode(access), &mut coordinates.*)
        run RuntimeEncoding.recordWord(&mut output, boolCode(nullable), &mut coordinates.*)
        run RuntimeEncoding.recordWord(
          &mut output,
          match multiplicity {
            Multiplicity.Single => 0
            Multiplicity.Many => 1
          }, &mut coordinates.*)
        match & alignment {
          Option<u64>.Some {value: aligned} => {
            run RuntimeEncoding.recordWord(&mut output, 1, &mut coordinates.*)
            run RuntimeEncoding.recordWord(&mut output, aligned, &mut coordinates.*)
          }
          Option<u64>.None => {
            run RuntimeEncoding.recordWord(&mut output, 0, &mut coordinates.*)
          }
        }
        run encodeIdentityChild(&mut output, &pointee, owner, exact, &mut coordinates.*)
      }
      Type.ForeignFunction {signature, behavior} => {
        run RuntimeEncoding.recordWord(&mut output, ForeignContract.code(behavior), &mut coordinates.*)
        run encodeIdentityChild(&mut output, &signature, owner, exact, &mut coordinates.*)
      }
      Type.Array {element, extent} => {
        run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&extent), &mut coordinates.*)
        run encodeIdentityChild(&mut output, &element, owner, exact, &mut coordinates.*)
      }
      Type.Union {members} => {
        let mut encodings = Vector.make<Bytes>()
        let listed = Vector.asSlice<Shared<Type>>(&members)
        let mut at = usize.ZERO
        while at < listed.length {
          run Vector.append<Bytes>(
            &mut encodings,
            run Type.encoding(&listed[at], owner, exact, &mut coordinates.*),
          )
          at = at + usize.ONE
        }
        run RuntimeEncoding.recordSet(&mut output, &encodings, &mut coordinates.*)
      }
      Type.CallableValue {runtime, application, contract, captures, fieldInputs, ..} => {
        let count = Shared.with<Bytes, usize>(&runtime, Bytes.length)
        if !RuntimeEncoding.recordPayload(&mut coordinates.*, count) { return move output }
        let key = run copyCallableBytes(&runtime)
        run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&key), &mut coordinates.*)
        if exact {
          let affordableApplication = Shared.with<Application, bool>(&application,
            fn(selected: &Application) -> bool { return Application.copiedPayloadFits(selected, &mut coordinates.*) })
          if !affordableApplication { return Bytes.make() }
          let selected = run Application.copyShared(&application)
          let identity = run Application.encoding(&selected, true, &mut coordinates.*)
          run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&identity), &mut coordinates.*)
        }
        run encodeIdentityChild(&mut output, &contract, owner, exact, &mut coordinates.*)
        let fields = Vector.asSlice<Shared<Type>>(&captures)
        let inputs = Vector.asSlice<CallableFieldInput>(&fieldInputs)
        run RuntimeEncoding.recordWord(&mut output, usize.toU64(fields.length), &mut coordinates.*)
        let mut at = usize.ZERO
        while at < fields.length {
          // The runtime key's inputs name a represented capture's slot, encoded with the application.
          if !representedCapture(inputs, at) {
            run encodeIdentityChild(&mut output, &fields[at], owner, exact, &mut coordinates.*)
          }
          at = at + usize.ONE
        }
      }
      Type.CallableSchema {runtime, schema, captures, ..} => {
        let count = Shared.with<Bytes, usize>(&runtime, Bytes.length)
        if !RuntimeEncoding.recordPayload(&mut coordinates.*, count) { return move output }
        let key = run copyCallableBytes(&runtime)
        run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&key), &mut coordinates.*)
        if exact {
          let selected = run CallableSchema.copy(&schema)
          let identity = run CallableSchema.encoding(&selected, true, &mut coordinates.*)
          run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&identity), &mut coordinates.*)
        }
        let fields = Vector.asSlice<Shared<Type>>(&captures)
        run RuntimeEncoding.recordWord(&mut output, usize.toU64(fields.length), &mut coordinates.*)
        let mut at = usize.ZERO
        while at < fields.length {
          run encodeIdentityChild(&mut output, &fields[at], owner, exact, &mut coordinates.*)
          at = at + usize.ONE
        }
      }
      Type.CallableResult {producer, contract, arguments, selected, selectedOrdinals} => {
        run encodeIdentityArguments(
          &mut output,
          Vector.asSlice<Argument>(&selected),
          owner,
          exact,
          &mut coordinates.*,
        )
        let ordinals = Vector.asSlice<usize>(&selectedOrdinals)
        let mut ordinalAt = usize.ZERO
        while ordinalAt < ordinals.length { run RuntimeEncoding.recordWord(&mut output, usize.toU64(ordinals[ordinalAt]), &mut coordinates.*) ordinalAt = ordinalAt + usize.ONE }
        run encodeIdentityChild(&mut output, &producer, owner, exact, &mut coordinates.*)
        run encodeIdentityChild(&mut output, &contract, owner, exact, &mut coordinates.*)
        let listed = Vector.asSlice<Shared<Type>>(&arguments)
        run RuntimeEncoding.recordWord(&mut output, usize.toU64(listed.length), &mut coordinates.*)
        let mut at = usize.ZERO
        while at < listed.length {
          run encodeIdentityChild(&mut output, &listed[at], owner, exact, &mut coordinates.*)
          at = at + usize.ONE
        }
      }
      Type.EffectComposite {operation, selector, contract, parts} => {
        run RuntimeEncoding.recordWord(&mut output, compositionCode(operation), &mut coordinates.*)
        run encodeIdentityChild(&mut output, &selector, owner, exact, &mut coordinates.*)
        run encodeIdentityChild(&mut output, &contract, owner, exact, &mut coordinates.*)
        let fields = Vector.asSlice<Shared<Type>>(&parts)
        run RuntimeEncoding.recordWord(&mut output, usize.toU64(fields.length), &mut coordinates.*)
        let mut at = usize.ZERO
        while at < fields.length {
          run encodeIdentityChild(&mut output, &fields[at], owner, exact, &mut coordinates.*)
          at = at + usize.ONE
        }
      }
      Type.EffectJoin {contract, alternatives} => {
        run encodeIdentityChild(&mut output, &contract, owner, exact, &mut coordinates.*)
        let listed = Vector.asSlice<Shared<Type>>(&alternatives)
        run RuntimeEncoding.recordWord(&mut output, usize.toU64(listed.length), &mut coordinates.*)
        let mut at = usize.ZERO
        while at < listed.length {
          run encodeIdentityChild(&mut output, &listed[at], owner, exact, &mut coordinates.*)
          at = at + usize.ONE
        }
      }
      Type.CallableStage {base, contract, captures, remaining, suffixMode} => {
        run RuntimeEncoding.recordWord(&mut output, usize.toU64(remaining), &mut coordinates.*)
        run RuntimeEncoding.recordWord(&mut output, modeCode(suffixMode), &mut coordinates.*)
        run encodeIdentityChild(&mut output, &base, owner, exact, &mut coordinates.*)
        run encodeIdentityChild(&mut output, &contract, owner, exact, &mut coordinates.*)
        let fields = Vector.asSlice<Shared<Type>>(&captures)
        run RuntimeEncoding.recordWord(&mut output, usize.toU64(fields.length), &mut coordinates.*)
        let mut at = usize.ZERO
        while at < fields.length {
          run encodeIdentityChild(&mut output, &fields[at], owner, exact, &mut coordinates.*)
          at = at + usize.ONE
        }
      }
      Type.Callable {mode, isUnsafe, parameters, result, ..} => {
        run RuntimeEncoding.recordWord(&mut output, modeCode(mode), &mut coordinates.*)
        run RuntimeEncoding.recordWord(&mut output, boolCode(isUnsafe), &mut coordinates.*)
        let listed = Vector.asSlice<Shared<Type>>(&parameters)
        run RuntimeEncoding.recordWord(&mut output, usize.toU64(listed.length), &mut coordinates.*)
        let mut at = usize.ZERO
        while at < listed.length {
          run encodeIdentityChild(&mut output, &listed[at], owner, exact, &mut coordinates.*)
          at = at + usize.ONE
        }
        run encodeIdentityChild(&mut output, &result, owner, exact, &mut coordinates.*)
      }
      Type.Effect {mode, success, failure, requirements, ..} => {
        run RuntimeEncoding.recordWord(&mut output, modeCode(mode), &mut coordinates.*)
        run encodeIdentityChild(&mut output, &success, owner, exact, &mut coordinates.*)
        run encodeIdentityChild(&mut output, &failure, owner, exact, &mut coordinates.*)
        let row = run Row.encoding(&requirements, owner, exact, &mut coordinates.*)
        run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&row), &mut coordinates.*)
      }
      Type.CallableView {representation, contract} => {
        run encodeIdentityChild(&mut output, &representation, owner, exact, &mut coordinates.*)
        run encodeIdentityChild(&mut output, &contract, owner, exact, &mut coordinates.*)
      }
      Type.TypeDescriptor {owner: described} => run encodeIdentityChild(
        &mut output,
        &described,
        owner,
        exact,
        &mut coordinates.*,
      )
      Type.Without {source, removed} => {
        run encodeIdentityChild(&mut output, &source, owner, exact, &mut coordinates.*)
        run encodeIdentityChild(&mut output, &removed, owner, exact, &mut coordinates.*)
      }
      Type.Anonymous {occurrence, members} => {
        let syntax = Shared.with<AnonymousOccurrence, usize>(&occurrence, fn(value: &AnonymousOccurrence) -> usize { return value.syntax })
        let generator = Shared.with<AnonymousOccurrence, Shared<DeclarationId>>(&occurrence, fn(value: &AnonymousOccurrence) -> Shared<DeclarationId> {
          return Shared.clone<DeclarationId>(&value.declaration)
        })
        let affordableOwner = Shared.with<DeclarationId, bool>(&generator,
          fn(identity: &DeclarationId) -> bool { return RuntimeEncoding.recordPayload(&mut coordinates.*, RuntimeEncoding.declarationPayload(identity)) })
        if !affordableOwner { return Bytes.make() }
        let declaration = run DeclarationId.copyShared(&generator)
        run RuntimeEncoding.recordDeclaration(&mut output, &declaration, &mut coordinates.*)
        let listed = Vector.asSlice<Shared<Type>>(&members)
        run RuntimeEncoding.recordWord(&mut output, usize.toU64(syntax), &mut coordinates.*)
        run RuntimeEncoding.recordWord(&mut output, usize.toU64(listed.length), &mut coordinates.*)
        let mut at = usize.ZERO
        while at < listed.length {
          run encodeIdentityChild(&mut output, &listed[at], owner, exact, &mut coordinates.*)
          at = at + usize.ONE
        }
      }
      _ => {}
    }
    return move output
  }
}

effect fn encodeIdentityChild(
  output: &mut Bytes,
  value: &Shared<Type>,
  owner: &DeclarationId,
  exact: bool,
  coordinates: &mut Coordinates,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let encoding = run Type.encoding(value, owner, exact, &mut coordinates.*)
  return run RuntimeEncoding.recordField(&mut output.*, Bytes.asSlice(&encoding), &mut coordinates.*)
}

effect fn encodeIdentityArguments(
  output: &mut Bytes,
  values: &[Argument],
  owner: &DeclarationId,
  exact: bool,
  coordinates: &mut Coordinates,
) -> () ! OutOfMemoryError ? &mut Allocator {
  run RuntimeEncoding.recordWord(&mut output.*, usize.toU64(values.length), &mut coordinates.*)
  let mut at = usize.ZERO
  while at < values.length {
    let encoding = run Argument.encoding(&values[at], owner, exact, &mut coordinates.*)
    run RuntimeEncoding.recordField(&mut output.*, Bytes.asSlice(&encoding), &mut coordinates.*)
    at = at + usize.ONE
  }
  return ()
}

impl Argument {
  /// The canonical runtime projection of one ordered binder argument.
  pub effect fn runtimeEncoding(value: &Argument, owner: &DeclarationId) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut coordinates = RuntimeEncoding.coordinates()
    return run Argument.encoding(value, owner, false, &mut coordinates)
  }
  pub effect fn encoding(
    value: &Argument,
    owner: &DeclarationId,
    exact: bool,
    coordinates: &mut Coordinates,
  ) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut output = Bytes.make()
    match & value.* {
      Argument.Type {value: ty} => {
        run RuntimeEncoding.recordWord(&mut output, 0, &mut coordinates.*)
        run encodeIdentityChild(&mut output, &ty, owner, exact, &mut coordinates.*)
      }
      Argument.Lifetime {value: region} => {
        run RuntimeEncoding.recordWord(&mut output, 1, &mut coordinates.*)
        if exact {
          run RuntimeEncoding.lifetime(&mut output, &region, &mut coordinates.*)
        }
      }
      Argument.Row {value: row} => {
        run RuntimeEncoding.recordWord(&mut output, 2, &mut coordinates.*)
        let encoding = run Row.encoding(&row, owner, exact, &mut coordinates.*)
        run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&encoding), &mut coordinates.*)
      }
    }
    return move output
  }
}

struct EncodedRequirement {
  key: Bytes
  access: Access
}

impl Row {
  /// Encodes sorted service-role keys, merging lifetime-erased duplicates at strongest access.
  pub effect fn runtimeEncoding(value: &Shared<Row>, owner: &DeclarationId) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut coordinates = RuntimeEncoding.coordinates()
    return run Row.encoding(value, owner, false, &mut coordinates)
  }
  pub effect fn encoding(
    value: &Shared<Row>,
    owner: &DeclarationId,
    exact: bool,
    coordinates: &mut Coordinates,
  ) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    if coordinates.exceeded { return Bytes.make() }
    let mut entries = Vector.make<EncodedRequirement>()
    let count = Shared.with<Row, usize>(value, rowEntryCount)
    let mut at = usize.ZERO
    while at < count {
      let entry = entryAt(value, at)
      let mut key = run Type.encoding(&entry.capability, owner, exact, &mut coordinates.*)
      match & entry.roleType {
        Option<Shared<Type>>.Some {value: roleValue} => {
          run RuntimeEncoding.recordWord(&mut key, 1, &mut coordinates.*)
          run encodeIdentityChild(&mut key, &roleValue, owner, exact, &mut coordinates.*)
        }
        Option<Shared<Type>>.None => {
          run RuntimeEncoding.recordWord(&mut key, 0, &mut coordinates.*)
        }
      }
      let known = Vector.asMutSlice<EncodedRequirement>(&mut entries)
      let mut found = false
      let mut check = usize.ZERO
      while check < known.length {
        if RuntimeEncoding.recordEqual(Bytes.asSlice(&known[check].key), Bytes.asSlice(&key), &mut coordinates.*) {
          found = true
          if entry.access == Access.Mutable {
            known[check].access = Access.Mutable
          }
          break
        }
        if coordinates.exceeded { return Bytes.make() }
        check = check + usize.ONE
      }
      if !found {
        run Vector.append<EncodedRequirement>(
          &mut entries,
          EncodedRequirement {key: move key, access: entry.access},
        )
      }
      at = at + usize.ONE
    }
    let mut encoded = Vector.make<Bytes>()
    let listed = Vector.asSlice<EncodedRequirement>(&entries)
    at = usize.ZERO
    while at < listed.length {
      let mut entry = run RuntimeEncoding.recordCopy(Bytes.asSlice(&listed[at].key), &mut coordinates.*)
      run RuntimeEncoding.recordWord(&mut entry, accessCode(listed[at].access), &mut coordinates.*)
      run Vector.append<Bytes>(&mut encoded, move entry)
      at = at + usize.ONE
    }
    let mut output = Bytes.make()
    run RuntimeEncoding.recordSet(&mut output, &encoded, &mut coordinates.*)
    let mut parameters = Vector.make<Bytes>()
    let parameterCount = Shared.with<Row, usize>(value, rowParameterCount)
    at = usize.ZERO
    while at < parameterCount {
      let parameter = Shared.with<Row, RowParameter>(
        value,
        fn(row: &Row) -> RowParameter {
          return rowParameterAt(row, at)
        },
      )
      let affordableOwner = Shared.with<DeclarationId, bool>(&parameter.declaration,
        fn(identity: &DeclarationId) -> bool { return RuntimeEncoding.recordPayload(&mut coordinates.*, RuntimeEncoding.declarationPayload(identity)) })
      if !affordableOwner { return Bytes.make() }
      let selected = Option.some<DeclarationId>(
        run DeclarationId.copyShared(&parameter.declaration),
      )
      let declaration = match move selected {
        Option<DeclarationId>.Some {value: id} => move id
        Option<DeclarationId>.None => {
          at = at + usize.ONE
          continue
        }
      }
      let mut encoding = Bytes.make()
      run RuntimeEncoding.recordDeclaration(&mut encoding, &declaration, &mut coordinates.*)
      run RuntimeEncoding.recordWord(&mut encoding, usize.toU64(parameter.ordinal), &mut coordinates.*)
      run Vector.append<Bytes>(&mut parameters, move encoding)
      at = at + usize.ONE
    }
    run RuntimeEncoding.recordSet(&mut output, &parameters, &mut coordinates.*)
    let mut subtractions = Vector.make<Bytes>()
    let terms = subtractionCount(value)
    at = usize.ZERO
    while at < terms {
      let term = subtractionAt(value, at)
      let source = run Row.encoding(&term.source, owner, exact, &mut coordinates.*)
      let removed = run Row.encoding(&term.removed, owner, exact, &mut coordinates.*)
      let mut encoding = Bytes.make()
      run RuntimeEncoding.recordField(&mut encoding, Bytes.asSlice(&source), &mut coordinates.*)
      run RuntimeEncoding.recordField(&mut encoding, Bytes.asSlice(&removed), &mut coordinates.*)
      run Vector.append<Bytes>(&mut subtractions, move encoding)
      at = at + usize.ONE
    }
    run RuntimeEncoding.recordSet(&mut output, &subtractions, &mut coordinates.*)
    return move output
  }
}

fn fillNodeText(input: &Bytes, output: &mut Bytes) -> bool {
  let bytes = Bytes.asSlice(input)
  let target = Bytes.asMutSlice(&mut output.*)
  let mut at = usize.ZERO
  while at < bytes.length {
    target[at] = bytes[at]
    at = at + usize.ONE
  }
  return true
}

fn boolCode(value: bool) -> u64 {
  if value {
    return 1
  }
  return 0
}

fn firstNormalized(value: &Vector<Shared<Type>>) -> Shared<Type> {
  let listed = Vector.asSlice<Shared<Type>>(value)
  return Shared.clone<Type>(&listed[usize.ZERO])
}

fn nodeArgumentIn(arguments: &Vector<Argument>, at: usize) -> Argument {
  let listed = Vector.asSlice<Argument>(arguments)
  return Argument.copy(&listed[at])
}

impl Argument {
  /// Copies an argument handle without entering its shared type, row or lifetime.
  pub fn copy(value: &Argument) -> Argument {
    return copyNodeArgument(value)
  }
}

fn nodeProjection(node: &Type, part: DeclarationPart, owner: usize, offset: usize) -> Option<
  DeclarationProjection,
> {
  return match & node.* {
    Type.Nominal {declaration, ..} => Option.some<DeclarationProjection>(
      DeclarationId.project(&declaration, part, owner, offset),
    )
    Type.OpaqueRepresentation {application, ..} => Shared.with<Application, Option<DeclarationProjection>>(&application,
      fn(value: &Application) -> Option<DeclarationProjection> {
        return Option.some<DeclarationProjection>(DeclarationId.project(Application.bodyDeclaration(value), part, owner, offset))
      })
    Type.Parameter {declaration, ..} => Option.some<DeclarationProjection>(
      DeclarationId.project(&declaration, part, owner, offset),
    )
    _ => Option.none<DeclarationProjection>()
  }
}

fn projectedField(
  source: &Shared<Type>,
  part: DeclarationPart,
  owner: usize,
  offset: usize,
) -> Option<DeclarationProjection> {
  return Shared.with<Type, Option<DeclarationProjection>>(
    source,
    fn(value: &Type) -> Option<DeclarationProjection> {
      return nodeProjection(value, part, owner, offset)
    },
  )
}

// Copies the `count` bytes of one selected declaration component or owner name.
effect fn projectedBytes(source: &Shared<Type>, part: DeclarationPart, owner: usize, count: usize) -> Bytes
! OutOfMemoryError
? &mut Allocator {
  let mut bytes = run Bytes.zeroed(count)
  let target = Bytes.asMutSlice(&mut bytes)
  let mut offset = usize.ZERO
  while offset < count {
    let selected = projectedField(source, part, owner, offset)
    match move selected {
      Option<DeclarationProjection>.Some {value: field} => {
        target[offset] = field.byte
      }
      Option<DeclarationProjection>.None => {
        return absurd<Bytes>()
      }
    }
    offset = offset + usize.ONE
  }
  return move bytes
}

effect fn copyNodeDeclaration(source: &Shared<Type>) -> Option<DeclarationId>
! OutOfMemoryError
? &mut Allocator {
  let mut components = Vector.make<Bytes>()
  let mut section = usize.ZERO
  while section < 3 {
    let mut part = DeclarationPart.Path
    if section == usize.ZERO {
      part = DeclarationPart.Origin
    }
    if section == usize.ONE {
      part = DeclarationPart.Package
    }
    let measured = projectedField(source, part, usize.MAX, usize.MAX)
    let count = match move measured {
      Option<DeclarationProjection>.Some {value: field} => field.length
      Option<DeclarationProjection>.None => {
        return Option.none<DeclarationId>()
      }
    }
    let bytes = run projectedBytes(source, part, usize.MAX, count)
    run Vector.append<Bytes>(&mut components, move bytes)
    section = section + usize.ONE
  }
  let measured = projectedField(source, DeclarationPart.Owners, usize.MAX, usize.MAX)
  let count = match move measured {
    Option<DeclarationProjection>.Some {value: field} => field.length
    Option<DeclarationProjection>.None => {
      return absurd<Option<DeclarationId>>()
    }
  }
  let mut owners = Vector.make<OwnerStep>()
  let mut at = usize.ZERO
  while at < count {
    let selected = projectedField(source, DeclarationPart.Owners, at, usize.MAX)
    let step = match move selected {
      Option<DeclarationProjection>.Some {value: field} => field
      Option<DeclarationProjection>.None => {
        return absurd<Option<DeclarationId>>()
      }
    }
    let mut name = Option.none<Bytes>()
    if step.named {
      let bytes = run projectedBytes(source, DeclarationPart.Owners, at, step.length)
      name = Option.some<Bytes>(move bytes)
    }
    run Vector.append<OwnerStep>(
      &mut owners,
      OwnerStep {kind: step.kind, occurrence: step.occurrence, name: move name},
    )
    at = at + usize.ONE
  }
  let path = match move Vector.pop<Bytes>(&mut components) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => {
      return absurd<Option<DeclarationId>>()
    }
  }
  let package = match move Vector.pop<Bytes>(&mut components) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => {
      return absurd<Option<DeclarationId>>()
    }
  }
  let origin = match move Vector.pop<Bytes>(&mut components) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => {
      return absurd<Option<DeclarationId>>()
    }
  }
  let assembled = run Effect.result(ModuleId.fromParts(move origin, move package, move path))
  let module = match move assembled {
    Result<ModuleId, InvalidModulePath>.Success {value} => move value
    Result<ModuleId, InvalidModulePath>.Failure {error: _} => { return absurd<Option<DeclarationId>>() }
  }
  return Option.some<DeclarationId>(run DeclarationId.fromParts(move module, move owners))
}

// A missing field after selecting a concrete node kind is an implementation defect.
fn absurd<T>() -> T {
  let boom = 1 / 0
  return absurd<T>()
}

fn callableRuntimeEquals(left: &Shared<Bytes>, right: &Shared<Bytes>) -> bool {
  // Copies of an exact callable retain the same immutable runtime key. Shared.with takes an
  // exclusive interior loan, so compare aliased handles before borrowing both buffers.
  if Shared.with<Bytes, usize>(left, callableBytesAddress) == Shared.with<Bytes, usize>(right, callableBytesAddress) { return true }
  return Shared.with<Bytes, bool>(left, fn(first: &Bytes) -> bool { return callableRuntimeWith(first, right) })
}

fn callableBytesAddress(value: &Bytes) -> usize {
  return Pointer.address<Bytes>(Pointer.fromRef<Bytes>(value))
}

fn callableRuntimeWith(first: &Bytes, right: &Shared<Bytes>) -> bool {
  return Shared.with<Bytes, bool>(right, fn(second: &Bytes) -> bool { return RuntimeEncoding.equals(Bytes.asSlice(first), Bytes.asSlice(second)) })
}

fn callableInputCount(node: &Type) -> usize {
  return match &node.* {
    Type.CallableValue {fieldInputs, ..} => Vector.length<CallableFieldInput>(&fieldInputs)
    Type.CallableSchema {fieldInputs, ..} => Vector.length<CallableFieldInput>(&fieldInputs)
    _ => usize.ZERO
  }
}

fn callableInputAt(node: &Type, at: usize) -> CallableFieldInput {
  return match &node.* {
    Type.CallableValue {fieldInputs, ..} => Vector.get<CallableFieldInput>(&fieldInputs, at)
    Type.CallableSchema {fieldInputs, ..} => Vector.get<CallableFieldInput>(&fieldInputs, at)
    _ => absurd<CallableFieldInput>()
  }
}

effect fn copyCallableBytes(value: &Shared<Bytes>) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let length = Shared.with<Bytes, usize>(value, fn(bytes: &Bytes) -> usize { return Bytes.asSlice(bytes).length })
  let mut copied = run Bytes.zeroed(length)
  Shared.with<Bytes, ()>(value, fn(bytes: &Bytes) -> () {
    let source = Bytes.asSlice(bytes)
    let target = Bytes.asMutSlice(&mut copied)
    let mut at = usize.ZERO
    while at < source.length {
      target[at] = source[at]
      at = at + usize.ONE
    }
    return ()
  })
  return move copied
}

impl Type {
  /// Retains a source staging recipe until the base representation is exact, then builds its
  /// capture record for the original target. Supplied fields stay in capture order; their input
  /// ordinals retain the target's argument order across repeated staging.
  pub effect fn stagedCallable(base: Shared<Type>, contract: Shared<Type>, captures: Vector<Shared<Type>>,
    remaining: usize, suffixMode: CallableMode, owner: &DeclarationId) -> Shared<Type>
  ! OutOfMemoryError ? &mut Allocator {
    let copied = run Type.copy(&base)
    if let Type.CallableView {representation, ..} = &copied {
      let staged = run Type.stagedCallable(Shared.clone<Type>(&representation), Shared.clone<Type>(&contract),
        move captures, remaining, suffixMode, owner)
      return run Type.callableView(move staged, move contract)
    }
    if let Type.CallableValue {isPublic, application, contract: originalContract, captures: originalCaptures, fieldInputs, ..} = move copied {
      let mut fields = Vector.make<Shared<Type>>()
      let mut inputs = Vector.make<CallableFieldInput>()
      let previousInputs = Vector.asSlice<CallableFieldInput>(&fieldInputs)
      let nested = previousInputs.length == usize.ZERO && Shared.with<Application, bool>(&application, anonymousCallableTarget)
      if nested {
        run Vector.append<Shared<Type>>(&mut fields, Shared.clone<Type>(&base))
        run Vector.append<CallableFieldInput>(&mut inputs, CallableFieldInput.Environment)
      } else {
        let previous = Vector.asSlice<Shared<Type>>(&originalCaptures)
        let mut at = usize.ZERO
        while at < previousInputs.length {
          run Vector.append<Shared<Type>>(&mut fields, Shared.clone<Type>(&previous[at]))
          run Vector.append<CallableFieldInput>(&mut inputs, previousInputs[at])
          at = at + usize.ONE
        }
      }
      let supplied = Vector.asSlice<Shared<Type>>(&captures)
      let mut at = usize.ZERO
      while at < supplied.length {
        run Vector.append<Shared<Type>>(&mut fields, Shared.clone<Type>(&supplied[at]))
        run Vector.append<CallableFieldInput>(&mut inputs, CallableFieldInput.Argument {parameter: remaining + at})
        at = at + usize.ONE
      }
      let mut mode = Shared.with<Type, CallableMode>(&originalContract, callableMode)
      if suffixMode == CallableMode.Once { mode = CallableMode.Once }
      if suffixMode == CallableMode.Mutable && mode == CallableMode.Shared { mode = CallableMode.Mutable }
      let normalized = match move run Type.copy(&contract) {
        Type.Callable {isUnsafe, environment, invocationBinders, invocationUse, invocationBounds, parameters, result, ..} => Type.Callable {
          mode: mode, isUnsafe: isUnsafe, environment: move environment, invocationBinders: invocationBinders, invocationUse: invocationUse,
          invocationBounds: move invocationBounds, parameters: move parameters, result: move result,
        }
        _ => absurd<Type>()
      }
      return run Type.callableValue(isPublic, move application, run Shared.make<Type>(move normalized), move fields, move inputs)
    }
    let mut retained = Vector.make<Shared<Type>>()
    run Vector.append<Shared<Type>>(&mut retained, Shared.clone<Type>(&base))
    let supplied = Vector.asSlice<Shared<Type>>(&captures)
    let mut at = usize.ZERO
    while at < supplied.length {
      run Vector.append<Shared<Type>>(&mut retained, Shared.clone<Type>(&supplied[at]))
      at = at + usize.ONE
    }
    let contract = run retainedCaptureContract(&contract, owner, Vector.asSlice<Shared<Type>>(&retained))
    return run Shared.make<Type>(Type.CallableStage {base: move base, contract: move contract,
      captures: move captures, remaining: remaining, suffixMode: suffixMode})
  }

  /// Creates an exact generic named-section environment without selecting an executable target.
  pub effect fn callableSchema(schema: Shared<SectionSchema>, captures: Vector<Shared<Type>>, fieldInputs: Vector<CallableFieldInput>) -> Shared<Type>
  ! OutOfMemoryError ? &mut Allocator {
    let mut copied = run CallableSchema.copy(&schema)
    let owner = run DeclarationId.copyShared(&copied.target)
    copied.contract = run retainedCaptureContract(&copied.contract, &owner, Vector.asSlice<Shared<Type>>(&captures))
    let mut encoding = run CallableSchema.runtime(&copied)
    run encodeCallableInputs(&mut encoding, Vector.asSlice<CallableFieldInput>(&fieldInputs))
    return run Shared.make<Type>(Type.CallableSchema {schema: run Shared.make<SectionSchema>(move copied), captures: move captures,
      fieldInputs: move fieldInputs, runtime: run Shared.make<Bytes>(move encoding)})
  }

  /// Creates an exact callable environment with a canonical ordinary-function target identity.
  ///
  /// `contract` is the remaining use contract. Field inputs keep capture order independent of
  /// target argument order, and may retain an anonymous target's original environment.
  pub effect fn callableValue(isPublic: bool, application: Shared<Application>, contract: Shared<Type>, captures: Vector<Shared<Type>>, fieldInputs: Vector<CallableFieldInput>) -> Shared<Type>
  ! OutOfMemoryError ? &mut Allocator {
    let target = run Application.copyShared(&application)
    let contract = run retainedCaptureContract(&contract, Application.bodyDeclaration(&target), Vector.asSlice<Shared<Type>>(&captures))
    let inputs = run representedInputs(&target, Vector.asSlice<Shared<Type>>(&captures), Vector.asSlice<CallableFieldInput>(&fieldInputs))
    let mut encoding = run Application.runtime(&target)
    run encodeCallableInputs(&mut encoding, Vector.asSlice<CallableFieldInput>(&inputs))
    return run Shared.make<Type>(Type.CallableValue {isPublic: isPublic, application: move application, contract: move contract, captures: move captures, fieldInputs: move inputs, runtime: run Shared.make<Bytes>(move encoding)})
  }
}

// Substitution can reveal stored loans hidden behind a captured type parameter. Rebuild at the
// canonical constructors so every rewrite path retains those loans and the original local-only
// restriction. A local marker is an outstanding contents obligation, never a static proof.
effect fn retainedCaptureContract(contract: &Shared<Type>, owner: &DeclarationId, captures: &[Shared<Type>]) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(contract)
  if let Type.Callable {mode, isUnsafe, environment, invocationBinders, invocationUse, invocationBounds, parameters, result} = move copied {
    let mut regions = Vector.make<Shared<Lifetime>>()
    let count = Shared.with<Intersection, usize>(&environment,
      fn(value: &Intersection) -> usize { return Vector.length<Member>(&value.members) })
    let mut at = usize.ZERO
    while at < count {
      run Vector.append<Shared<Lifetime>>(&mut regions, Shared.with<Intersection, Shared<Lifetime>>(&environment,
        fn(value: &Intersection) -> Shared<Lifetime> {
          let members = Vector.asSlice<Member>(&value.members)
          return Shared.clone<Lifetime>(&members[at].region)
        }))
      at = at + usize.ONE
    }
    let representations = Vector.make<Option<Shared<Type>>>()
    at = usize.ZERO
    while at < captures.length {
      let known = run Type.retainedRegions(&captures[at], owner, Vector.asSlice<Option<Shared<Type>>>(&representations), &mut regions)
      at = at + usize.ONE
    }
    return run Shared.make<Type>(Type.Callable {mode: mode, isUnsafe: isUnsafe,
      environment: run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions))),
      invocationBinders: invocationBinders, invocationUse: invocationUse, invocationBounds: move invocationBounds,
      parameters: move parameters, result: move result})
  }
  return Shared.clone<Type>(contract)
}

fn anonymousCallableTarget(value: &Application) -> bool {
  return DeclarationId.kind(Application.bodyDeclaration(value)) == OwnerKind.Anonymous
}

fn compositionCode(operation: Composition) -> u64 {
  return match operation {
    Composition.CatchFailure => 0
    Composition.BindShared => 1
    Composition.BindExclusive => 2
    Composition.BindOwned => 3
    Composition.Finalize => 4
    Composition.FinalizeNonParking => 5
    Composition.UseRelease => 6
    Composition.Observe => 7
    Composition.Suspend => 8
  }
}

fn callableMode(value: &Type) -> CallableMode {
  return match &value.* {
    Type.Callable {mode, ..} => mode
    _ => CallableMode.Once
  }
}

// Marks each supplied exact callable or Effect argument that equals an application type argument,
// as a representation binder's evidence does, so its identity is read from the application once.
effect fn representedInputs(application: &Application, captures: &[Shared<Type>], inputs: &[CallableFieldInput])
  -> Vector<CallableFieldInput> ! OutOfMemoryError ? &mut Allocator {
  let mut marked = Vector.make<CallableFieldInput>()
  let count = Application.typeCount(application)
  let mut at = usize.ZERO
  while at < inputs.length {
    let mut input = inputs[at]
    if let CallableFieldInput.Argument {parameter} = inputs[at] {
      if at < captures.length && Shared.with<Type, bool>(&captures[at], exactRepresentation) {
        let mut slot = usize.ZERO
        let mut found = false
        while !found && slot < count {
          if let Option<Shared<Type>>.Some {value} = move Application.typeAt(application, slot) {
            if run Type.equalsShared(&value, &captures[at]) {
              input = CallableFieldInput.Represented {parameter: parameter, slot: slot}
              found = true
            }
          }
          slot = slot + usize.ONE
        }
      }
    }
    run Vector.append<CallableFieldInput>(&mut marked, input)
    at = at + usize.ONE
  }
  return move marked
}

fn exactRepresentation(value: &Type) -> bool {
  return match &value.* {
    Type.CallableValue {..} => true
    Type.CallableSchema {..} => true
    Type.EffectComposite {..} => true
    Type.EffectJoin {..} => true
    _ => false
  }
}

effect fn rewriteCallableApplication(value: &Shared<Application>, owner: &DeclarationId, arguments: &[Argument], fresh: &Option<DeclarationId>, instantiate: bool, bindings: &[Binding], invocation: &Option<DeclarationId>, opaque: &Option<Application>, numbering: &mut Numbering) -> Application
! OutOfMemoryError ? &mut Allocator {
  let copied = run Application.copyShared(value)
  let mut target = ApplicationTarget.Named {declaration: run DeclarationId.copy(Application.bodyDeclaration(&copied))}
  if let ApplicationTarget.Operation {contract, provider, operation, implementation} = &copied.target {
    let reboundContract = run rewriteType(&contract, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
    let reboundProvider = run rewriteType(&provider, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
    target = ApplicationTarget.Operation {contract: move reboundContract, provider: move reboundProvider,
      operation: run DeclarationId.copy(&operation), implementation: run DeclarationId.copy(&implementation)}
  }
  let own = run rewrittenArguments(&copied.arguments, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
  let mut scopes = Vector.make<ScopeBinding>()
  let before = Vector.asSlice<ScopeBinding>(&copied.scopes)
  let mut at = usize.ZERO
  while at < before.length {
    let scope = &before[at]
    let mut ordinals = Vector.make<usize>()
    let indices = Vector.asSlice<usize>(&scope.argumentOrdinals)
    let mut index = usize.ZERO
    while index < indices.length {
      run Vector.append<usize>(&mut ordinals, indices[index])
      index = index + usize.ONE
    }
    run Vector.append<ScopeBinding>(&mut scopes, ScopeBinding {owner: Shared.clone<DeclarationId>(&scope.owner),
      arguments: run rewrittenArguments(&scope.arguments, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*), argumentOrdinals: move ordinals})
    at = at + usize.ONE
  }
  let Application {argumentOrdinals, statics: oldStatics, ..} = move copied
  let mut statics = Vector.make<StaticSlot>()
  let suppliedStatics = Vector.asSlice<StaticSlot>(&oldStatics)
  at = usize.ZERO
  while at < suppliedStatics.length {
    run Vector.append<StaticSlot>(&mut statics, StaticSlot {ordinal: suppliedStatics[at].ordinal,
      value: run StaticValue.numberRegions(&suppliedStatics[at].value, owner, &mut numbering.*)})
    at = at + usize.ONE
  }
  return Application {target: move target, arguments: move own, argumentOrdinals: move argumentOrdinals, scopes: move scopes, statics: move statics}
}

fn callableCaptureCount(node: &Type) -> usize {
  return match &node.* { Type.CallableValue {captures, ..} => Vector.length<Shared<Type>>(&captures) _ => usize.ZERO }
}
fn callableCaptureAt(node: &Type, at: usize) -> Shared<Type> {
  if let Type.CallableValue {captures, ..} = &node.* {
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    return Shared.clone<Type>(&fields[at])
  }
  return absurd<Shared<Type>>()
}

fn proofApplication(node: &Type) -> Option<Shared<Application>> {
  return match &node.* {
    Type.CallableValue {application, ..} => Option.some<Shared<Application>>(Shared.clone<Application>(&application))
    Type.CallableOrigin {application, ..} => Option.some<Shared<Application>>(Shared.clone<Application>(&application))
    Type.OpaqueRepresentation {application, ..} => Option.some<Shared<Application>>(Shared.clone<Application>(&application))
    _ => Option.none<Shared<Application>>()
  }
}

fn viewBorrow(value: &Type) -> bool {
  return match &value.* { Type.Reference {..} => true Type.Slice {..} => true Type.String {..} => true _ => false }
}


effect fn copyCallableInputs(value: &Shared<Type>, output: &mut Vector<CallableFieldInput>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Type, usize>(value, callableInputCount)
  let mut at = usize.ZERO
  while at < count {
    let input = Shared.with<Type, CallableFieldInput>(value,
      fn(node: &Type) -> CallableFieldInput { return callableInputAt(node, at) })
    run Vector.append<CallableFieldInput>(&mut output.*, input)
    at = at + usize.ONE
  }
  return ()
}

effect fn encodeCallableInputs(output: &mut Bytes, inputs: &[CallableFieldInput]) -> ()
! OutOfMemoryError ? &mut Allocator {
  run RuntimeEncoding.word(&mut output.*, usize.toU64(inputs.length))
  let mut at = usize.ZERO
  while at < inputs.length {
    match &inputs[at] {
      CallableFieldInput.Environment => { run RuntimeEncoding.word(&mut output.*, 0) }
      CallableFieldInput.Argument {parameter} => {
        run RuntimeEncoding.word(&mut output.*, 1)
        run RuntimeEncoding.word(&mut output.*, usize.toU64(parameter))
      }
      CallableFieldInput.Represented {parameter, slot} => {
        run RuntimeEncoding.word(&mut output.*, 2)
        run RuntimeEncoding.word(&mut output.*, usize.toU64(parameter))
        run RuntimeEncoding.word(&mut output.*, usize.toU64(slot))
      }
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn rewriteSchemaEnvironment(value: &Shared<Type>, owner: &DeclarationId, arguments: &[Argument],
  fresh: &Option<DeclarationId>, instantiate: bool, bindings: &[Binding], invocation: &Option<DeclarationId>, opaque: &Option<Application>, numbering: &mut Numbering) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  // Region numbering is an injective rename of free Local/Supplied atoms, not substitution
  // through the target binders. It therefore visits the complete blueprint with all original
  // Parameter/Invocation owners retained. Real substitution keeps the existing bound barrier.
  if Numbering.isActive(&numbering.*) {
    return run rewriteType(value, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
  }
  let node = run nodeCopy(value)
  if let Type.Callable {mode, isUnsafe, environment, invocationBinders, invocationUse, invocationBounds, parameters, result} = move node {
    return run Shared.make<Type>(Type.Callable {mode: mode, isUnsafe: isUnsafe,
      environment: run rewriteEnvironment(&environment, owner, arguments, fresh, instantiate, bindings, invocation, &mut numbering.*),
      invocationBinders: invocationBinders, invocationUse: invocationUse, invocationBounds: move invocationBounds,
      parameters: move parameters, result: move result})
  }
  return absurd<Shared<Type>>()
}

// The lender reference an exclusive reborrow of an exclusive view or lender reference holds.
fn reborrowedLender(value: &Shared<Type>) -> Option<Shared<Type>> {
  let referent = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
    return match &node.* {
      Type.Reference {referent, access, ..} => {
        if access != Access.Mutable { return Option.none<Shared<Type>>() }
        return Option.some<Shared<Type>>(Shared.clone<Type>(&referent))
      }
      _ => Option.none<Shared<Type>>()
    }
  })
  if let Option<Shared<Type>>.Some {value: inner} = move referent { return lentReference(&inner) }
  return Option.none<Shared<Type>>()
}

// The exclusive lender reference a lent view stores, or the lender reference itself.
fn lentReference(value: &Shared<Type>) -> Option<Shared<Type>> {
  let representation = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
    return match &node.* {
      Type.CallableView {representation, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&representation))
      Type.Reference {..} => Option.some<Shared<Type>>(Shared.clone<Type>(value))
      _ => Option.none<Shared<Type>>()
    }
  })
  if let Option<Shared<Type>>.Some {value: lender} = move representation {
    if Shared.with<Type, bool>(&lender, exclusiveReference) { return Option.some<Shared<Type>>(move lender) }
  }
  return Option.none<Shared<Type>>()
}

fn exclusiveReference(value: &Type) -> bool {
  return match &value.* { Type.Reference {access, ..} => access == Access.Mutable _ => false }
}

fn applicationMentionsContract(value: &Application) -> bool {
  let count = Application.typeCount(value)
  let mut at = usize.ZERO
  while at < count {
    if let Option<Shared<Type>>.Some {value: ty} = move Application.typeAt(value, at) {
      if Shared.with<Type, bool>(&ty, Type.mentionsContract) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

impl Type {
  /// Keeps a proved authored callable contract over its exact original environment. The caller
  /// must prove compatibility against the incoming public contract before weakening the view.
  /// Redundant and nested views normalize without changing the original invocation ABI.
  pub effect fn callableView(representation: Shared<Type>, contract: Shared<Type>) -> Shared<Type>
  ! OutOfMemoryError ? &mut Allocator {
    // An exclusive reborrow of an exclusive view reborrows its lender: `&mut View{&mut F}` is
    // `View{&mut F}`, so recursive lending keeps one instance instead of nesting references.
    if let Option<Shared<Type>>.Some {value: lender} = move reborrowedLender(&representation) {
      return run Type.callableView(move lender, move contract)
    }
    let copied = run Type.copy(&representation)
    let original = match move copied {
      Type.CallableView {representation: base, ..} => move base
      _ => Shared.clone<Type>(&representation)
    }
    let exposed = Shared.with<Type, Option<Shared<Type>>>(&original, callableViewContract)
    if let Option<Shared<Type>>.Some {value} = move exposed {
      if run Type.equalsShared(&value, &contract) { return move original }
    }
    return run Shared.make<Type>(Type.CallableView {representation: move original, contract: move contract})
  }
  /// Finishes every occurrence of the producer's result family after its complete header schema
  /// is known. The application includes generated representations and retained outer scopes;
  /// already published source types are never mutated.
  pub effect fn finishOpaqueApplication(value: &Shared<Type>, application: &Application) -> Shared<Type>
  ! OutOfMemoryError ? &mut Allocator {
    let arguments = Vector.make<Argument>()
    let bindings = Vector.make<Binding>()
    let completed = Option.some<Application>(run Application.copy(application))
    let mut numbering = Numbering.inactive()
    return run rewriteType(value, Application.bodyDeclaration(application), Vector.asSlice<Argument>(&arguments),
      &Option.none<DeclarationId>(), false, Vector.asSlice<Binding>(&bindings), &Option.none<DeclarationId>(), &completed, &mut numbering)
  }
}

// The success an exact Effect or Effect contract produces when run.
fn effectSuccess(value: &Type) -> Option<Shared<Type>> {
  return match &value.* {
    Type.Effect {success, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&success))
    Type.CallableValue {contract, ..} => Shared.with<Type, Option<Shared<Type>>>(&contract, effectSuccess)
    Type.EffectComposite {contract, ..} => Shared.with<Type, Option<Shared<Type>>>(&contract, effectSuccess)
    Type.EffectJoin {contract, ..} => Shared.with<Type, Option<Shared<Type>>>(&contract, effectSuccess)
    Type.OpaqueRepresentation {contract, ..} => Shared.with<Type, Option<Shared<Type>>>(&contract, effectSuccess)
    _ => Option.none<Shared<Type>>()
  }
}

fn opaqueProducedBy(node: &Type, producer: &DeclarationId) -> bool {
  if let Type.OpaqueRepresentation {application, ..} = &node.* {
    return Shared.with<Application, bool>(&application, fn(value: &Application) -> bool {
      return DeclarationId.equals(Application.bodyDeclaration(value), producer)
    })
  }
  return false
}

fn callableViewReference(node: &Type) -> Option<Shared<Type>> {
  if let Type.CallableView {representation, ..} = &node.* {
    if Shared.with<Type, bool>(&representation, fn(storage: &Type) -> bool {
      return match &storage.* { Type.Reference {..} => true _ => false }
    }) { return Option.some<Shared<Type>>(Shared.clone<Type>(&representation)) }
  }
  return Option.none<Shared<Type>>()
}

fn callableViewContract(node: &Type) -> Option<Shared<Type>> {
  return match &node.* {
    Type.CallableValue {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
    Type.CallableResult {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
    Type.CallableWitnessResult {witness} => Option.some<Shared<Type>>(Shared.with<WitnessRecipe, Shared<Type>>(&witness,
      CallableWitness.resultType))
    Type.CallableOrigin {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
    Type.CallableStage {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
    Type.CallableView {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
    Type.CallableSchema {schema, ..} => Option.some<Shared<Type>>(schemaContract(&schema))
    Type.OpaqueRepresentation {contract, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
    _ => Option.none<Shared<Type>>()
  }
}

effect fn collectOpaqueEvidence(source: &Shared<Type>, target: &Shared<Type>, producer: &DeclarationId,
  evidence: &mut Vector<OpaqueEvidence>, rootInjection: bool) -> bool ! OutOfMemoryError ? &mut Allocator {
  let own = Shared.with<Type, bool>(target, fn(value: &Type) -> bool { return opaqueProducedBy(value, producer) })
  if own {
    run Vector.append<OpaqueEvidence>(&mut evidence.*, OpaqueEvidence {
      family: Shared.clone<Type>(target), actual: Shared.clone<Type>(source)})
    // A family whose Effect contract holds a nested family realizes it from the success of the
    // same returned Effect.
    let nested = Shared.with<Type, Option<Shared<Type>>>(target, fn(value: &Type) -> Option<Shared<Type>> {
      return match &value.* { Type.OpaqueRepresentation {contract, ..} => Shared.with<Type, Option<Shared<Type>>>(&contract, effectSuccess)
        _ => Option.none<Shared<Type>>() }
    })
    if let Option<Shared<Type>>.Some {value: promised} = move nested {
      if run Type.containsOpaque(&promised, producer) {
        // A joined return realizes the nested family from each alternative's success.
        let joined = run Type.copy(source)
        if let Type.EffectJoin {alternatives, ..} = move joined {
          let listed = Vector.asSlice<Shared<Type>>(&alternatives)
          let mut at = usize.ZERO
          while at < listed.length {
            let actual = Shared.with<Type, Option<Shared<Type>>>(&listed[at], effectSuccess)
            if let Option<Shared<Type>>.Some {value: success} = move actual {
              if !run collectOpaqueEvidence(&success, &promised, producer, &mut evidence.*, false) { return false }
            } else { return false }
            at = at + usize.ONE
          }
          return true
        }
        let actual = Shared.with<Type, Option<Shared<Type>>>(source, effectSuccess)
        if let Option<Shared<Type>>.Some {value: success} = move actual {
          return run collectOpaqueEvidence(&success, &promised, producer, &mut evidence.*, false)
        }
        return false
      }
    }
    return true
  }
  if !run Type.containsOpaque(target, producer) { return run Type.equalsShared(source, target) }
  let members = Shared.with<Type, usize>(target, unionLength)
  if members != usize.MAX {
    let sourceMembers = Shared.with<Type, usize>(source, unionLength)
    if sourceMembers == usize.MAX {
      if !rootInjection { return false }
      return match move run opaqueUnionEvidence(source, target, producer, &mut evidence.*) {
        Option<usize>.Some {..} => true _ => false
      }
    }
    if sourceMembers != members { return false }
    let mut selected = Vector.make<usize>()
    let mut at = usize.ZERO
    while at < sourceMembers {
      let actual = match move memberOf(source, at) { Option<Shared<Type>>.Some {value} => move value _ => { return false } }
      let tag = match move run opaqueUnionEvidence(&actual, target, producer, &mut evidence.*) {
        Option<usize>.Some {value} => value _ => { return false }
      }
      let earlier = Vector.asSlice<usize>(&selected)
      let mut scan = usize.ZERO
      while scan < earlier.length {
        if earlier[scan] == tag { return false }
        scan = scan + usize.ONE
      }
      run Vector.append<usize>(&mut selected, tag)
      at = at + usize.ONE
    }
    return true
  }
  let first = run Type.copy(source)
  let none = Vector.make<usize>()
  let map = Vector.asSlice<usize>(&none)
  if !headWith(&first, target, map) { return false }
  if !run sameApplicationStatics(source, target) { return false }
  let firstSchema = callableSchemaOf(&first)
  if let Option<Shared<SectionSchema>>.Some {value: actual} = move firstSchema {
    let secondSchema = Shared.with<Type, Option<Shared<SectionSchema>>>(target, callableSchemaOf)
    if let Option<Shared<SectionSchema>>.Some {value: expected} = move secondSchema {
      if !run sameSchemaEvidence(&actual, &expected, map) { return false }
    } else { return false }
  }
  let count = childCount(&first)
  let mut at = usize.ZERO
  while at < count {
    let actual = childAt(&first, at)
    let promised = Shared.with<Type, Option<Shared<Type>>>(target,
      fn(value: &Type) -> Option<Shared<Type>> { return childAt(value, at) })
    if let Option<Shared<Type>>.Some {value: child} = move actual {
      if let Option<Shared<Type>>.Some {value: expected} = move promised {
        if !run collectOpaqueEvidence(&child, &expected, producer, &mut evidence.*, false) { return false }
      } else { return false }
    } else {
      if let Option<Shared<Type>>.Some {..} = move promised { return false }
    }
    at = at + usize.ONE
  }
  if !run sameArgumentRows(source, target, count, map) { return false }
  let firstRow = rowOf(&first)
  let secondRow = Shared.with<Type, Option<Shared<Row>>>(target, rowOf)
  if let Option<Shared<Row>>.Some {value: actual} = move firstRow {
    if let Option<Shared<Row>>.Some {value: expected} = move secondRow { return run Row.equalsShared(&actual, &expected) }
    return false
  }
  return true
}

// Ordinary alternatives win before an opaque slot. Failed candidates roll back every collected
// leaf, so a family never acquires evidence from an unselected structural-union alternative.
effect fn opaqueUnionEvidence(source: &Shared<Type>, target: &Shared<Type>, producer: &DeclarationId,
  evidence: &mut Vector<OpaqueEvidence>) -> Option<usize> ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Type, usize>(target, unionLength)
  let mut at = usize.ZERO
  while at < count {
    let selected = memberOf(target, at)
    if let Option<Shared<Type>>.Some {value} = move selected {
      if !run Type.containsOpaque(&value, producer) {
        if run Type.equalsShared(source, &value) { return Option.some<usize>(at) }
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < count {
    let selected = memberOf(target, at)
    if let Option<Shared<Type>>.Some {value} = move selected {
      let mark = Vector.length<OpaqueEvidence>(&evidence.*)
      if run collectOpaqueEvidence(source, &value, producer, &mut evidence.*, false) { return Option.some<usize>(at) }
      Vector.truncate<OpaqueEvidence>(&mut evidence.*, mark)
    }
    at = at + usize.ONE
  }
  return Option.none<usize>()
}

effect fn rewriteOpaqueApplication(value: &Shared<Application>, owner: &DeclarationId, arguments: &[Argument],
  fresh: &Option<DeclarationId>, instantiate: bool, bindings: &[Binding], invocation: &Option<DeclarationId>,
  opaque: &Option<Application>, numbering: &mut Numbering) -> Application ! OutOfMemoryError ? &mut Allocator {
  if let Option<Application>.Some {value: completed} = &opaque.* {
    let matches = Shared.with<Application, bool>(value, fn(application: &Application) -> bool {
      return DeclarationId.equals(Application.bodyDeclaration(application), owner)
    })
    if matches { return run Application.copy(&completed) }
  }
  return run rewriteCallableApplication(value, owner, arguments, fresh, instantiate, bindings, invocation, opaque, &mut numbering.*)
}

impl Type {
  /// The immutable producer application of an opaque family, before runtime realization.
  pub fn opaqueApplication(value: &Shared<Type>) -> Option<Shared<Application>> {
    return Shared.with<Type, Option<Shared<Application>>>(value, fn(node: &Type) -> Option<Shared<Application>> {
      return match &node.* {
        Type.OpaqueRepresentation {application, ..} => Option.some<Shared<Application>>(Shared.clone<Application>(&application))
        _ => Option.none<Shared<Application>>()
      }
    })
  }
}


// Unions keep canonical member handling outside the ordinary structural child API.
fn normalizationHasStatics(value: &Application) -> bool {
  return Vector.length<StaticSlot>(&value.statics) != usize.ZERO
}

fn originChildCount(value: &Type) -> usize {
  let members = unionLength(value)
  if members != usize.MAX { return members }
  return childCount(value)
}
fn originChildAt(value: &Type, at: usize) -> Option<Shared<Type>> {
  if unionLength(value) != usize.MAX { return unionMemberAt(value, at) }
  return childAt(value, at)
}

impl Type {
  /// Whether free source evidence can change during callable normalization. Open recipes count;
  /// selected schema arguments and captures are free, while its target blueprint remains bound.
  pub fn needsCallableNormalization(value: &Shared<Type>) -> bool {
    let changes = Shared.with<Type, bool>(value, fn(node: &Type) -> bool {
      return match &node.* {
        Type.CallableOrigin {..} => true
        Type.CallableResult {..} => true
        Type.CallableWitnessResult {..} => true
        Type.CallableStage {..} => true
        Type.CallableView {..} => true
        // Union normalization also flattens/deduplicates members, independently of recipes.
        Type.Union {..} => true
        Type.Without {..} => true
        Type.CallableValue {application, ..} => Shared.with<Application, bool>(&application, normalizationHasStatics)
        Type.OpaqueRepresentation {application, ..} => Shared.with<Application, bool>(&application, normalizationHasStatics)
        _ => false
      }
    })
    if changes { return true }
    let count = Shared.with<Type, usize>(value, originChildCount)
    let mut at = usize.ZERO
    while at < count {
      let child = Shared.with<Type, Option<Shared<Type>>>(value,
        fn(node: &Type) -> Option<Shared<Type>> { return originChildAt(node, at) })
      if let Option<Shared<Type>>.Some {value: nested} = move child {
        if Type.needsCallableNormalization(&nested) { return true }
      }
      at = at + usize.ONE
    }
    return false
  }

  /// Whether source evidence still depends on a finite ordinary producer-origin solution.
  pub fn containsCallableOrigin(value: &Shared<Type>) -> bool {
    if Shared.with<Type, bool>(value, fn(node: &Type) -> bool { return match &node.* { Type.CallableOrigin {..} => true _ => false } }) { return true }
    let count = Shared.with<Type, usize>(value, originChildCount)
    let mut at = usize.ZERO
    while at < count {
      let child = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> { return originChildAt(node, at) })
      if let Option<Shared<Type>>.Some {value: nested} = move child { if Type.containsCallableOrigin(&nested) { return true } }
      at = at + usize.ONE
    }
    return false
  }
}


impl Type {
  /// Complete checked ordinary producer edges in free source evidence, including captures and
  /// original application channels. This follows no physical layout edge or bound declaration.
  pub effect fn callableOriginApplications(value: &Shared<Type>) -> Vector<Shared<Application>>
  ! OutOfMemoryError ? &mut Allocator {
    let mut found = Vector.make<Shared<Application>>()
    let selected = Shared.with<Type, Option<Shared<Application>>>(value, fn(node: &Type) -> Option<Shared<Application>> {
      return match &node.* {
        Type.CallableOrigin {application, ..} => Option.some<Shared<Application>>(Shared.clone<Application>(&application))
        _ => Option.none<Shared<Application>>()
      }
    })
    if let Option<Shared<Application>>.Some {value: application} = move selected {
      run Vector.append<Shared<Application>>(&mut found, move application)
    }
    let count = Shared.with<Type, usize>(value, originChildCount)
    let mut at = usize.ZERO
    while at < count {
      let child = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> { return originChildAt(node, at) })
      if let Option<Shared<Type>>.Some {value: nested} = move child {
        let mut edges = run Type.callableOriginApplications(&nested)
        let length = Vector.length<Shared<Application>>(&edges)
        let mut item = usize.ZERO
        while item < length {
          run Vector.append<Shared<Application>>(&mut found, Vector.remove<Shared<Application>>(&mut edges, usize.ZERO))
          item = item + usize.ONE
        }
      }
      at = at + usize.ONE
    }
    return move found
  }
}


impl Type {
  /// Closed invocation recipes require resolver selection; an open recipe remains exact symbolic
  /// source evidence until its owning application supplies the deferred arguments.
  pub fn containsClosedCallableRecipe(value: &Shared<Type>) -> bool {
    let recipe = Shared.with<Type, bool>(value, fn(node: &Type) -> bool {
      return match &node.* { Type.CallableResult {..} => true Type.CallableStage {..} => true Type.CallableWitnessResult {..} => true _ => false }
    })
    if recipe && !Type.hasOpenRuntimeParameters(value) { return true }
    let count = Shared.with<Type, usize>(value, originChildCount)
    let mut at = usize.ZERO
    while at < count {
      let child = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> { return originChildAt(node, at) })
      if let Option<Shared<Type>>.Some {value: nested} = move child { if Type.containsClosedCallableRecipe(&nested) { return true } }
      at = at + usize.ONE
    }
    return false
  }
}

/// One invariant structural child pair in an origin-dependent source comparison.
pub struct ComparisonChild {
  pub left: Shared<Type>
  pub right: Shared<Type>
}
impl Type {
  /// Checks exact structural headers before deferring only dependent children. Declaration,
  /// lifetime, static and qualifier evidence stays invariant; this is not runtime comparison.
  pub effect fn comparisonChildren(first: &Shared<Type>, second: &Shared<Type>) -> Option<Vector<ComparisonChild>>
  ! OutOfMemoryError ? &mut Allocator {
    let left = run Type.copy(first)
    let right = run Type.copy(second)
    let map = Vector.make<usize>()
    if !sameHead(&left, &right, Vector.asSlice<usize>(&map)) { return Option.none<Vector<ComparisonChild>>() }
    if !run sameApplicationStatics(first, second) { return Option.none<Vector<ComparisonChild>>() }
    let firstSchema = callableSchemaOf(&left)
    if let Option<Shared<SectionSchema>>.Some {value: original} = move firstSchema {
      let secondSchema = callableSchemaOf(&right)
      if let Option<Shared<SectionSchema>>.Some {value: selected} = move secondSchema {
        if !run sameSchemaEvidence(&original, &selected, Vector.asSlice<usize>(&map)) { return Option.none<Vector<ComparisonChild>>() }
      } else { return Option.none<Vector<ComparisonChild>>() }
    }
    let firstRow = rowOf(&left)
    let secondRow = rowOf(&right)
    if let Option<Shared<Row>>.Some {value: original} = move firstRow {
      if let Option<Shared<Row>>.Some {value: selected} = move secondRow {
        if !run Row.equalsShared(&original, &selected) { return Option.none<Vector<ComparisonChild>>() }
      } else { return Option.none<Vector<ComparisonChild>>() }
    } else { if let Option<Shared<Row>>.Some {..} = move secondRow { return Option.none<Vector<ComparisonChild>>() } }
    let ordinaryCount = childCount(&left)
    if !run sameArgumentRows(first, second, ordinaryCount, Vector.asSlice<usize>(&map)) { return Option.none<Vector<ComparisonChild>>() }
    let count = originChildCount(&left)
    if count != originChildCount(&right) || count == usize.ZERO { return Option.none<Vector<ComparisonChild>>() }
    let mut children = Vector.make<ComparisonChild>()
    let mut at = usize.ZERO
    while at < count {
      let firstChild = originChildAt(&left, at)
      let secondChild = originChildAt(&right, at)
      if let Option<Shared<Type>>.Some {value: source} = move firstChild {
        if let Option<Shared<Type>>.Some {value: target} = move secondChild {
          run Vector.append<ComparisonChild>(&mut children, ComparisonChild {left: move source, right: move target})
        } else { return Option.none<Vector<ComparisonChild>>() }
      } else {
        if let Option<Shared<Type>>.Some {..} = &secondChild { return Option.none<Vector<ComparisonChild>>() }
      }
      at = at + usize.ONE
    }
    return Option.some<Vector<ComparisonChild>>(move children)
  }
}

impl Type {
  /// Whether a source value still retains an operation's deferred conformance selection.
  pub fn containsCallableWitness(value: &Shared<Type>) -> bool {
    if Shared.with<Type, bool>(value, fn(node: &Type) -> bool {
      return match &node.* { Type.CallableWitnessResult {..} => true _ => false }
    }) { return true }
    let count = Shared.with<Type, usize>(value, originChildCount)
    let mut at = usize.ZERO
    while at < count {
      let child = Shared.with<Type, Option<Shared<Type>>>(value,
        fn(node: &Type) -> Option<Shared<Type>> { return originChildAt(node, at) })
      if let Option<Shared<Type>>.Some {value: nested} = move child {
        if Type.containsCallableWitness(&nested) { return true }
      }
      at = at + usize.ONE
    }
    return false
  }
}
