//! Semantic identity for written types and explicit generic applications.
//!
//! # When to use
//! Use [`Type`] in signatures and typed bodies. Use [`equals`] to compare types from different
//! queries or source revisions without comparing allocation positions.

import semantic.DeclarationId {DeclarationId}
import silk.bytes {Bytes}
import silk.pointer {Pointer}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// A canonical type resolved from a written declaration or type application.
pub union Type {
  /// One validated foundational type identified by its exact spelling.
  Primitive {
    /// The validated primitive spelling, independent of a source string table.
    pub name: Bytes,
  },
  /// The unit type.
  Unit,
  /// One canonical nominal declaration and its ordered explicit arguments.
  Nominal {
    /// The complete canonical identity of the nominal declaration.
    pub declaration: DeclarationId,
    /// Whether the declaration is public; visibility does not change type identity.
    pub isPublic: bool,
    /// The ordered arguments of this nominal application; empty for a nongeneric declaration.
    pub arguments: Vector<Shared<Type>>,
  },
  /// One ordinary type parameter owned by a declaration, independent of its spelling.
  Parameter {
    /// The declaration that binds the parameter.
    pub declaration: DeclarationId,
    /// The parameter's position in its owner's complete binder list.
    pub ordinal: usize,
  },
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameWith(first: &Type, right: &Shared<Type>) -> bool {
  return Shared.with<Type, bool>(
    right,
    fn(second: &Type) -> bool {
      return Type.equals(first, second)
    },
  )
}

fn addressOf(value: &Type) -> usize {
  return Pointer.address<Type>(Pointer.fromRef<Type>(value))
}

fn sameShared(left: &Shared<Type>, right: &Shared<Type>) -> bool {
  // A repeated argument can use the same Shared payload on both sides. Avoid reentrant access.
  if Shared.with<Type, usize>(left, addressOf) == Shared.with<Type, usize>(right, addressOf) {
    return true
  }
  return Shared.with<Type, bool>(
    left,
    fn(first: &Type) -> bool {
      return sameWith(first, right)
    },
  )
}

impl Type {
  /// Reports whether two resolved types have the same semantic identity.
  ///
  /// # Details
  ///
  /// Primitive names differ by spelling. A nominal application also compares its ordered
  /// arguments. A parameter compares its declaration and ordinal. Visibility does not change identity.
  pub fn equals(self: &Self, other: &Type) -> bool {
    return match & self.* {
      Type.Primitive {name} => match & other.* {
        Type.Primitive {name: compared} => sameBytes(Bytes.asSlice(&name), Bytes.asSlice(&compared))
        _ => false
      }
      Type.Unit => match & other.* {
        Type.Unit => true
        _ => false
      }
      Type.Nominal {declaration, arguments, ..} => match & other.* {
        Type.Nominal {declaration: compared, arguments: otherArguments, ..} => {
          if !DeclarationId.equals(&declaration, &compared) {
            return false
          }
          let first = Vector.asSlice<Shared<Type>>(&arguments)
          let second = Vector.asSlice<Shared<Type>>(&otherArguments)
          if first.length != second.length {
            return false
          }
          let mut at = usize.ZERO
          while at < first.length {
            if !sameShared(&first[at], &second[at]) {
              return false
            }
            at = at + usize.ONE
          }
          return true
        }
        _ => false
      }
      Type.Parameter {declaration, ordinal} => match & other.* {
        Type.Parameter {declaration: compared, ordinal: otherOrdinal} => DeclarationId.equals(
          &declaration,
          &compared,
        ) && ordinal == otherOrdinal
        _ => false
      }
    }
  }
}
