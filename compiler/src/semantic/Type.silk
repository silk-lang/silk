//! Semantic identity for written types, lifetime relationships, and generic applications.
//!
//! # When to use
//! Use [`Type`] in signatures and typed bodies. Use [`equalsShared`] to compare type handles from
//! different queries or source revisions without comparing allocation positions. Use [`Row`] for
//! the normalized requirement channel of an Effect contract.

import hir.Hir {Access, CallableMode, Multiplicity, OwnerKind}
import semantic.DeclarationId {
  DeclarationId,
  Part as DeclarationPart,
  Projection as DeclarationProjection,
  OwnerStep,
}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.RuntimeEncoding
import semantic.Lifetime {Intersection, Lifetime, Member}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.result {Result}
import silk.option {Option}
import silk.pointer {Pointer}
import silk.shared {Shared}
import silk.u8
import silk.u64
import silk.usize
import silk.vector {Vector}

/// One fixed array's element identity and canonical logical length.
pub struct ArrayShape {
  pub element: Shared<Type>
  pub length: usize
}

/// The literal that generates one anonymous aggregate type. It has no source name and cannot be
/// imported or exported; a separate same-shaped literal is a different type.
pub struct AnonymousOccurrence {
  /// The declaration whose body contains the literal.
  pub declaration: Shared<DeclarationId>
  /// The literal's authored syntax index in that declaration's module.
  pub syntax: usize
  /// Whether members are positions (`(a, b)`) rather than labeled fields (`.{a: x}`).
  pub positional: bool
  /// Field labels in written order; empty for a positional aggregate.
  pub labels: Vector<Bytes>
}

/// The decomposed parts of one anonymous aggregate type.
pub struct AnonymousParts {
  pub occurrence: Shared<AnonymousOccurrence>
  pub members: Vector<Shared<Type>>
}

impl AnonymousOccurrence {
  /// Whether the literal is positional.
  pub fn isPositional(value: &Shared<AnonymousOccurrence>) -> bool {
    return Shared.with<AnonymousOccurrence, bool>(value, fn(found: &AnonymousOccurrence) -> bool { return found.positional })
  }
  /// The written position of one field label; `usize.MAX` when the literal has no such label.
  pub fn labelIndex(value: &Shared<AnonymousOccurrence>, name: &[u8]) -> usize {
    return Shared.with<AnonymousOccurrence, usize>(
      value,
      fn(found: &AnonymousOccurrence) -> usize {
        let labels = Vector.asSlice<Bytes>(&found.labels)
        let mut at = usize.ZERO
        while at < labels.length {
          if sameBytes(Bytes.asSlice(&labels[at]), name) { return at }
          at = at + usize.ONE
        }
        return usize.MAX
      },
    )
  }
  /// Whether two handles name the same generating literal.
  pub fn equalsShared(left: &Shared<AnonymousOccurrence>, right: &Shared<AnonymousOccurrence>) -> bool {
    // Copied types share one occurrence allocation; nested exclusive access to it would conflict.
    if Shared.with<AnonymousOccurrence, usize>(left, occurrenceAddress) == Shared.with<AnonymousOccurrence, usize>(right, occurrenceAddress) {
      return true
    }
    return Shared.with<AnonymousOccurrence, bool>(
      left,
      fn(first: &AnonymousOccurrence) -> bool {
        return occurrenceWith(first, right)
      },
    )
  }
}

fn occurrenceAddress(value: &AnonymousOccurrence) -> usize {
  return Pointer.address<AnonymousOccurrence>(Pointer.fromRef<AnonymousOccurrence>(value))
}

fn occurrenceWith(first: &AnonymousOccurrence, right: &Shared<AnonymousOccurrence>) -> bool {
  return Shared.with<AnonymousOccurrence, bool>(
    right,
    fn(second: &AnonymousOccurrence) -> bool {
      return first.syntax == second.syntax && first.positional == second.positional && sameDeclaration(&first.declaration, &second.declaration)
    },
  )
}

/// A canonical type resolved from a written declaration or type application.
pub union Type {
  /// One validated foundational type identified by its exact spelling.
  Primitive {
    /// The validated primitive spelling, independent of a source string table.
    pub name: Bytes,
  },
  /// The unit type.
  Unit,
  /// One canonical nominal declaration and its ordered type and lifetime arguments.
  Nominal {
    /// The complete canonical identity of the nominal declaration.
    pub declaration: DeclarationId,
    /// Whether the declaration is public; visibility does not change type identity.
    pub isPublic: bool,
    /// The ordered arguments of this nominal application; empty for a nongeneric declaration.
    pub arguments: Vector<Argument>,
  },
  /// The exact representation of one fully specialized named callable item. A matching callable
  /// use contract does not make a different named item the same type.
  NamedRepresentation {
    pub declaration: DeclarationId,
    pub isPublic: bool,
    pub arguments: Vector<Argument>,
  },
  /// One producer-owned opaque representation family, specialized over its declaration binders.
  /// Its callable or Effect contract describes use and retained environment, not exact identity.
  OpaqueRepresentation {
    pub producer: DeclarationId,
    pub arguments: Vector<Argument>,
    pub contract: Shared<Type>,
    pub detached: bool,
    pub nonParking: bool,
  },
  /// One ordinary type parameter owned by a declaration, independent of its spelling.
  Parameter {
    /// The declaration that binds the parameter.
    pub declaration: DeclarationId,
    /// The parameter's position in its owner's complete binder list.
    pub ordinal: usize,
  },
  /// A UTF-8 view whose validity follows one lifetime.
  String {
    /// The validity relationship carried by this view.
    pub lifetime: Shared<Lifetime>,
  },
  /// A borrowed view of one referent with the written access mode.
  Reference {
    /// The referent's resolved type.
    pub referent: Shared<Type>,
    /// Shared or exclusive access.
    pub access: Access,
    /// The validity relationship of the borrow.
    pub lifetime: Shared<Lifetime>,
  },
  /// A borrowed runtime-length view of contiguous elements.
  Slice {
    /// The element's resolved type.
    pub element: Shared<Type>,
    /// Shared or exclusive access.
    pub access: Access,
    /// The validity relationship of the view.
    pub lifetime: Shared<Lifetime>,
  },
  /// A raw address with no loan or ownership claim.
  Pointer {
    /// The invariant pointee type.
    pub pointee: Shared<Type>,
    /// Whether the address permits writes.
    pub access: Access,
    /// Whether the address may be null.
    pub nullable: bool,
    /// Whether it addresses one value or a run.
    pub multiplicity: Multiplicity,
    /// Written minimum alignment; absence retains the semantic natural-alignment requirement.
    pub alignment: Option<u64>,
  },
  /// An authored fixed array with an exact, target-independent decimal extent.
  Array {pub element: Shared<Type>, pub extent: Bytes},
  /// One occurrence-generated anonymous tuple or record (RECORD-002). The generating occurrence
  /// is its nominal identity; members are that occurrence's element types in written order.
  Anonymous {pub occurrence: Shared<AnonymousOccurrence>, pub members: Vector<Shared<Type>>},
  /// The sealed phase-only `Intrinsic.Type<Owner>` descriptor of one aggregate type. It exists
  /// only during static evaluation and has no runtime representation.
  TypeDescriptor {
    /// The described aggregate type.
    pub owner: Shared<Type>,
  },
  /// A structural union: an unordered, duplicate-free set of two or more ordinary value types.
  ///
  /// The empty member set is `never`. A one-member union is represented by that member.
  Union {pub members: Vector<Shared<Type>>},
  /// A callable contract. Parameter order is identity; the environment is the captures' validity.
  Callable {
    /// Shared, exclusive, or consuming access to the captured environment.
    pub mode: CallableMode,
    /// Whether the final invocation requires an `unsafe` acknowledgement.
    pub isUnsafe: bool,
    /// The validity of the retained environment.
    pub environment: Shared<Intersection>,
    /// The number of written and elided `for<...>` invocation binders.
    pub invocationBinders: usize,
    /// The `'longer: 'shorter` bounds written on the invocation binders, in written order.
    pub invocationBounds: Vector<Outlives>,
    /// The parameter types in written order.
    pub parameters: Vector<Shared<Type>>,
    /// The result type.
    pub result: Shared<Type>,
  },
  /// A deferred computation with independent success, failure, and requirement channels.
  Effect {
    /// Shared, exclusive, or consuming run access.
    pub mode: CallableMode,
    /// The validity of the retained environment.
    pub environment: Shared<Intersection>,
    /// The value produced on success.
    pub success: Shared<Type>,
    /// The ordinary typed-failure type; `never` when omitted.
    pub failure: Shared<Type>,
    /// The normalized requirement row; empty when omitted.
    pub requirements: Shared<Row>,
  },
}

/// One requirement-row entry, keyed by a service application and a nominal role.
pub struct Requirement {
  /// The service application the Effect needs when it runs.
  pub capability: Shared<Type>
  /// The nominal role declaration's type; absent selects the implicit default role.
  pub roleType: Option<Shared<Type>>
  /// The strongest access required for this key; not part of the key.
  pub access: Access
}

/// A written `'longer: 'shorter` relationship.
pub struct Outlives {
  /// The lifetime that must cover the other.
  pub longer: Shared<Lifetime>
  /// The lifetime that is covered.
  pub shorter: Shared<Lifetime>
}

/// One declaration-owned `?R` requirement-row parameter, independent of its spelling.
pub struct RowParameter {
  /// The declaration that binds the parameter; shared so a row can be copied without allocation.
  pub declaration: Shared<DeclarationId>
  /// The parameter's position in its owner's complete binder list.
  pub ordinal: usize
}

/// A normalized requirement row. Entry order and repetition do not affect identity.
pub struct Row {
  /// Distinct service-role keys, each with its strongest required access.
  pub entries: Vector<Requirement>
  /// Distinct row parameters whose rows this row includes.
  pub parameters: Vector<RowParameter>
}

/// One canonical generic argument, with its type or lifetime kind retained.
pub union Argument {
  /// An ordinary type argument.
  Type {
    /// The resolved type supplied at this binder position.
    pub value: Shared<Type>,
  },
  /// A validity lifetime argument.
  Lifetime {
    /// The resolved lifetime supplied at this binder position.
    pub value: Shared<Lifetime>,
  },
  /// A complete requirement row supplied to a `?R` binder by the `? Row` suffix.
  Row {
    /// The normalized row supplied at this binder position.
    pub value: Shared<Row>,
  },
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn addressOf(value: &Type) -> usize {
  return Pointer.address<Type>(Pointer.fromRef<Type>(value))
}

fn invocationCount(value: &Type) -> usize {
  return match & value.* {
    Type.Callable {invocationBinders, ..} => invocationBinders
    _ => usize.ZERO
  }
}

// An alpha map begins with [sentinel, binder count, binder images...]. A quantified callable may
// append its own invocation-binder images. The two maps never share an ordinal namespace.
fn alphaMap(map: &[usize]) -> bool {
  return map.length >= 2 && map[usize.ZERO] == usize.MAX - usize.ONE
}

fn alphaPrefix(map: &[usize]) -> usize {
  if alphaMap(map) {
    return 2 + map[usize.ONE]
  }
  return usize.ZERO
}

fn isAssignedBetween(map: &[usize], start: usize, end: usize, target: usize) -> bool {
  let mut at = start
  while at < end {
    if map[at] == target {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn binderCompatible(map: &[usize], left: usize, right: usize) -> bool {
  if !alphaMap(map) {
    return left == right
  }
  let count = map[usize.ONE]
  if left >= count || right >= count {
    return false
  }
  let image = map[2 + left]
  if image == usize.MAX {
    return !isAssignedBetween(map, 2, 2 + count, right)
  }
  return image == right
}

fn projectionMap(map: &[usize]) -> bool {
  return map.length > usize.ZERO && map[usize.ZERO] == usize.MAX - 2
}

fn alphaLifetimeWith(first: &Lifetime, right: &Shared<Lifetime>, map: &[usize]) -> bool {
  return Shared.with<Lifetime, bool>(right, fn(second: &Lifetime) -> bool {
    if let Lifetime.Parameter {ordinal, ..} = &first.* {
      if let Lifetime.Parameter {ordinal: compared, ..} = &second.* {
        return binderCompatible(map, ordinal, compared)
      }
    }
    return false
  })
}

fn lifetimeIsParameter(value: &Lifetime) -> bool {
  return match & value.* {
    Lifetime.Parameter {..} => true
    _ => false
  }
}

fn lifetimeAddress(value: &Lifetime) -> usize {
  return Pointer.address<Lifetime>(Pointer.fromRef<Lifetime>(value))
}

fn sameAlphaLifetime(left: &Shared<Lifetime>, right: &Shared<Lifetime>, map: &[usize]) -> bool {
  if Shared.with<Lifetime, bool>(left, lifetimeIsParameter) {
    if Shared.with<Lifetime, usize>(left, lifetimeAddress) == Shared.with<Lifetime, usize>(right, lifetimeAddress) {
      return Shared.with<Lifetime, bool>(left, fn(value: &Lifetime) -> bool {
        if let Lifetime.Parameter {ordinal, ..} = &value.* {
          return binderCompatible(map, ordinal, ordinal)
        }
        return false
      })
    }
    return Shared.with<Lifetime, bool>(left, fn(first: &Lifetime) -> bool {
      return alphaLifetimeWith(first, right, map)
    })
  }
  return Lifetime.equalsShared(left, right)
}

effect fn sameShared(left: &Shared<Type>, right: &Shared<Type>) -> bool
! OutOfMemoryError
? &mut Allocator {
  let none = Vector.make<usize>()
  return run sameUnder(left, right, Vector.asSlice<usize>(&none))
}

// Search finite binder bijections against both parts of a head. A partial map can admit extra
// set pairings, but every completed map must satisfy all positions together.
effect fn assignHead(
  leftContract: &Shared<Type>,
  leftProvider: &Shared<Type>,
  rightContract: &Shared<Type>,
  rightProvider: &Shared<Type>,
  map: &mut Vector<usize>,
  position: usize,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let count = Vector.asSlice<usize>(&map.*)[usize.ONE]
  if position == count {
    if !run sameUnder(leftContract, rightContract, Vector.asSlice<usize>(&map.*)) {
      return false
    }
    return run sameUnder(
      leftProvider,
      rightProvider,
      Vector.asSlice<usize>(&map.*),
    )
  }
  let mut target = usize.ZERO
  while target < count {
    if !isAssignedBetween(Vector.asSlice<usize>(&map.*), 2, 2 + count, target) {
      let slots = Vector.asMutSlice<usize>(&mut map.*)
      slots[2 + position] = target
      if run sameUnder(leftContract, rightContract, Vector.asSlice<usize>(&map.*)) {
        if run sameUnder(leftProvider, rightProvider, Vector.asSlice<usize>(&map.*)) {
          if run assignHead(leftContract, leftProvider, rightContract, rightProvider, &mut map.*, position + usize.ONE) {
            return true
          }
        }
      }
      let reset = Vector.asMutSlice<usize>(&mut map.*)
      reset[2 + position] = usize.MAX
    }
    target = target + usize.ONE
  }
  return false
}

// Two callable contracts are equal when some bijection between their invocation binders makes them
// equal. The search assigns binders in order and checks the partial renaming at each step, with
// unassigned binders matching any unused binder, so a structural mismatch prunes at once. The
// first check leaves every binder unassigned and rejects anything that differs apart from
// binders. With first-use numbering the identity is tried first. Exact symmetries can still make
// the search combinatorial.
effect fn sameUpToRenaming(left: &Shared<Type>, right: &Shared<Type>, count: usize, outer: &[usize]) -> bool
! OutOfMemoryError
? &mut Allocator {
  let mut map = Vector.make<usize>()
  let mut at = usize.ZERO
  while at < outer.length {
    run Vector.append<usize>(&mut map, outer[at])
    at = at + usize.ONE
  }
  let start = Vector.length<usize>(&map)
  at = usize.ZERO
  while at < count {
    run Vector.append<usize>(&mut map, usize.MAX)
    at = at + usize.ONE
  }
  if !run sameUnder(left, right, Vector.asSlice<usize>(&map)) {
    return false
  }
  return run assignFrom(left, right, &mut map, start)
}

effect fn assignFrom(
  left: &Shared<Type>,
  right: &Shared<Type>,
  map: &mut Vector<usize>,
  position: usize,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let count = Vector.length<usize>(&map.*)
  if position == count {
    return true
  }
  let start = alphaPrefix(Vector.asSlice<usize>(&map.*))
  let mut target = usize.ZERO
  while target < count - start {
    if !isAssignedBetween(Vector.asSlice<usize>(&map.*), start, count, target) {
      let slots = Vector.asMutSlice<usize>(&mut map.*)
      slots[position] = target
      if run sameUnder(left, right, Vector.asSlice<usize>(&map.*)) {
        if run assignFrom(left, right, &mut map.*, position + usize.ONE) {
          return true
        }
      }
      let reset = Vector.asMutSlice<usize>(&mut map.*)
      reset[position] = usize.MAX
    }
    target = target + usize.ONE
  }
  return false
}

// Structural comparison never holds a type while entering one of its children. Substitution can
// place one handle both as a node on one side and as a descendant on the other, as in
// `T | Box<T>` applied to `Box<i32>`, so each level compares its header under short borrows and
// recurses only after releasing them.
//
//
// `map` is empty for ordinary exact identity, a finite invocation-binder mapping for a quantified
// callable, or an impl-binder mapping with a separate invocation suffix for alpha identity.
// `usize.MAX` marks an unassigned binder. Quantifiers do not nest.
effect fn sameUnder(left: &Shared<Type>, right: &Shared<Type>, map: &[usize]) -> bool
! OutOfMemoryError
? &mut Allocator {
  if map.length == usize.ZERO || (alphaMap(map) && map.length == alphaPrefix(map)) {
    if map.length == usize.ZERO && Shared.with<Type, usize>(left, addressOf) == Shared.with<Type, usize>(right, addressOf) {
      return true
    }
    let binders = Shared.with<Type, usize>(left, invocationCount)
    if binders > usize.ZERO && binders == Shared.with<Type, usize>(right, invocationCount) {
      return run sameUpToRenaming(left, right, binders, map)
    }
  }
  let aliased = Shared.with<Type, usize>(left, addressOf) == Shared.with<Type, usize>(right, addressOf)
  let mut headers = false
  if aliased {
    headers = Shared.with<Type, bool>(left, fn(value: &Type) -> bool {
      return sameHead(value, value, map)
    })
  } else {
    headers = Shared.with<Type, bool>(left, fn(first: &Type) -> bool {
      return headWith(first, right, map)
    })
  }
  if !headers {
    return false
  }
  let count = Shared.with<Type, usize>(left, childCount)
  let mut at = usize.ZERO
  while at < count {
    let first = Shared.with<Type, Option<Shared<Type>>>(
      left,
      fn(value: &Type) -> Option<Shared<Type>> {
        return childAt(value, at)
      },
    )
    let second = Shared.with<Type, Option<Shared<Type>>>(
      right,
      fn(value: &Type) -> Option<Shared<Type>> {
        return childAt(value, at)
      },
    )
    if !run sameChild(&first, &second, map) {
      return false
    }
    at = at + usize.ONE
  }
  if !run sameArgumentRows(left, right, count, map) {
    return false
  }
  let members = Shared.with<Type, usize>(left, unionLength)
  if members != usize.MAX {
    if !run sameUnionMembers(left, right, members, map) {
      return false
    }
  }
  let firstRow = Shared.with<Type, Option<Shared<Row>>>(left, rowOf)
  let secondRow = Shared.with<Type, Option<Shared<Row>>>(right, rowOf)
  if let Option<Shared<Row>>.Some {value: fromRow} = move firstRow {
    if let Option<Shared<Row>>.Some {value: toRow} = move secondRow {
      return run sameRows(&fromRow, &toRow, map)
    }
    return false
  }
  return true
}

effect fn sameChild(left: &Option<Shared<Type>>, right: &Option<Shared<Type>>, map: &[usize]) -> bool
! OutOfMemoryError
? &mut Allocator {
  if let Option<Shared<Type>>.Some {value} = &left.* {
    if let Option<Shared<Type>>.Some {value: compared} = &right.* {
      return run sameUnder(&value, &compared, map)
    }
    return false
  }
  if let Option<Shared<Type>>.Some {value: _} = &right.* {
    return false
  }
  return true
}

fn memberOf(members: &Shared<Type>, at: usize) -> Option<Shared<Type>> {
  return Shared.with<Type, Option<Shared<Type>>>(
    members,
    fn(value: &Type) -> Option<Shared<Type>> {
      return unionMemberAt(value, at)
    },
  )
}

// Headers already matched the member counts; duplicate-free sets are equal by inclusion.
effect fn sameUnionMembers(left: &Shared<Type>, right: &Shared<Type>, count: usize, map: &[usize]) -> bool
! OutOfMemoryError
? &mut Allocator {
  let mut at = usize.ZERO
  while at < count {
    let member = memberOf(left, at)
    let mut found = false
    let mut other = usize.ZERO
    while !found && other < count {
      let candidate = memberOf(right, other)
      found = run sameChild(&member, &candidate, map)
      other = other + usize.ONE
    }
    if !found {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn headWith(first: &Type, right: &Shared<Type>, map: &[usize]) -> bool {
  return Shared.with<Type, bool>(
    right,
    fn(second: &Type) -> bool {
      return sameHead(first, second, map)
    },
  )
}

// The number of ordered child types compared by position: type arguments (a lifetime argument
// position has none), a borrow or array element, callable parameters then result, or an Effect's
// success then failure. Union members and Effect rows are compared separately as sets.
fn childCount(value: &Type) -> usize {
  return match & value.* {
    Type.Nominal {arguments, ..} => Vector.length<Argument>(&arguments)
    Type.NamedRepresentation {arguments, ..} => Vector.length<Argument>(&arguments)
    Type.OpaqueRepresentation {arguments, ..} => Vector.length<Argument>(&arguments)
    Type.Reference {..} => usize.ONE
    Type.Slice {..} => usize.ONE
    Type.Pointer {..} => usize.ONE
    Type.Array {..} => usize.ONE
    Type.Anonymous {members, ..} => Vector.length<Shared<Type>>(&members)
    Type.Callable {parameters, ..} => Vector.length<Shared<Type>>(&parameters) + usize.ONE
    Type.Effect {..} => 2
    Type.TypeDescriptor {..} => usize.ONE
    _ => usize.ZERO
  }
}

fn childAt(value: &Type, at: usize) -> Option<Shared<Type>> {
  return match & value.* {
    Type.Nominal {arguments, ..} => {
      let values = Vector.asSlice<Argument>(&arguments)
      return match & values[at] {
        Argument.Type {value: argument} => Option.some<Shared<Type>>(Shared.clone<Type>(&argument))
        _ => Option.none<Shared<Type>>()
      }
    }
    Type.NamedRepresentation {arguments, ..} => {
      let values = Vector.asSlice<Argument>(&arguments)
      return match & values[at] {
        Argument.Type {value: argument} => Option.some<Shared<Type>>(Shared.clone<Type>(&argument))
        _ => Option.none<Shared<Type>>()
      }
    }
    Type.OpaqueRepresentation {arguments, ..} => {
      let values = Vector.asSlice<Argument>(&arguments)
      return match & values[at] {
        Argument.Type {value: argument} => Option.some<Shared<Type>>(Shared.clone<Type>(&argument))
        _ => Option.none<Shared<Type>>()
      }
    }
    Type.Reference {referent, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&referent))
    Type.Slice {element, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&element))
    Type.Pointer {pointee, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&pointee))
    Type.Array {element, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&element))
    Type.Anonymous {members, ..} => {
      let values = Vector.asSlice<Shared<Type>>(&members)
      return Option.some<Shared<Type>>(Shared.clone<Type>(&values[at]))
    }
    Type.Callable {parameters, result, ..} => {
      let values = Vector.asSlice<Shared<Type>>(&parameters)
      if at < values.length {
        return Option.some<Shared<Type>>(Shared.clone<Type>(&values[at]))
      }
      return Option.some<Shared<Type>>(Shared.clone<Type>(&result))
    }
    Type.Effect {success, failure, ..} => {
      if at == usize.ZERO {
        return Option.some<Shared<Type>>(Shared.clone<Type>(&success))
      }
      return Option.some<Shared<Type>>(Shared.clone<Type>(&failure))
    }
    Type.TypeDescriptor {owner} => Option.some<Shared<Type>>(Shared.clone<Type>(&owner))
    _ => Option.none<Shared<Type>>()
  }
}

fn rowOf(value: &Type) -> Option<Shared<Row>> {
  return match & value.* {
    Type.Effect {requirements, ..} => Option.some<Shared<Row>>(Shared.clone<Row>(&requirements))
    _ => Option.none<Shared<Row>>()
  }
}

fn sameArgumentHead(left: &Argument, right: &Argument, map: &[usize]) -> bool {
  return match & left.* {
    Argument.Type {..} => match & right.* {
      Argument.Type {..} => true
      _ => false
    }
    Argument.Lifetime {value} => match & right.* {
      Argument.Lifetime {value: compared} => sameLifetime(&value, &compared, map)
      _ => false
    }
    Argument.Row {..} => match & right.* {
      Argument.Row {..} => true
      _ => false
    }
  }
}

fn argumentRowAt(value: &Type, at: usize) -> Option<Shared<Row>> {
  if let Type.Nominal {arguments, ..} = &value.* {
    let values = Vector.asSlice<Argument>(&arguments)
    if let Argument.Row {value: row} = &values[at] {
      return Option.some<Shared<Row>>(Shared.clone<Row>(&row))
    }
  }
  if let Type.NamedRepresentation {arguments, ..} = &value.* {
    let values = Vector.asSlice<Argument>(&arguments)
    if let Argument.Row {value: row} = &values[at] {
      return Option.some<Shared<Row>>(Shared.clone<Row>(&row))
    }
  }
  if let Type.OpaqueRepresentation {arguments, ..} = &value.* {
    let values = Vector.asSlice<Argument>(&arguments)
    if let Argument.Row {value: row} = &values[at] {
      return Option.some<Shared<Row>>(Shared.clone<Row>(&row))
    }
  }
  return Option.none<Shared<Row>>()
}

fn argumentRowOf(value: &Shared<Type>, at: usize) -> Option<Shared<Row>> {
  return Shared.with<Type, Option<Shared<Row>>>(
    value,
    fn(found: &Type) -> Option<Shared<Row>> {
      return argumentRowAt(found, at)
    },
  )
}

// Row arguments are compared after the type borrows are released, like child types.
effect fn sameArgumentRows(left: &Shared<Type>, right: &Shared<Type>, count: usize, map: &[usize]) -> bool
! OutOfMemoryError
? &mut Allocator {
  let mut at = usize.ZERO
  while at < count {
    let first = argumentRowOf(left, at)
    if let Option<Shared<Row>>.Some {value: fromRow} = move first {
      let second = argumentRowOf(right, at)
      if let Option<Shared<Row>>.Some {value: toRow} = move second {
        if !run sameRows(&fromRow, &toRow, map) {
          return false
        }
      }
    }
    at = at + usize.ONE
  }
  return true
}

// Under a map, an assigned invocation binder on the left matches its image on the right, and an
// unassigned one matches any right binder that is not yet an image.
fn sameLifetime(left: &Shared<Lifetime>, right: &Shared<Lifetime>, map: &[usize]) -> bool {
  if projectionMap(map) {
    return true
  }
  if map.length == usize.ZERO {
    return Lifetime.equalsShared(left, right)
  }
  let alpha = alphaMap(map)
  let ordinal = Shared.with<Lifetime, usize>(left, invocationOrdinal)
  let other = Shared.with<Lifetime, usize>(right, invocationOrdinal)
  if ordinal == usize.MAX {
    if other != usize.MAX {
      return false
    }
    if alpha {
      return sameAlphaLifetime(left, right, map)
    }
    return Lifetime.equalsShared(left, right)
  }
  if other == usize.MAX {
    return false
  }
  // Every invocation lifetime belongs to the one quantified contract whose map is active.
  let offset = alphaPrefix(map)
  if ordinal >= map.length - offset {
    return ordinal == other
  }
  if map[ordinal + offset] == usize.MAX {
    return !isAssignedBetween(map, offset, map.length, other)
  }
  return map[ordinal + offset] == other
}

fn hasMember(environment: &Shared<Intersection>, candidate: &Shared<Lifetime>, map: &[usize]) -> bool {
  let count = environmentSize(environment)
  let mut at = usize.ZERO
  while at < count {
    let member = environmentMember(environment, at)
    if let Option<Shared<Lifetime>>.Some {value} = move member {
      if sameLifetime(candidate, &value, map) {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Environments are sets of lifetimes. Members are fetched as handles, so no environment borrow is
// held while comparing them; lifetimes contain no types, so this is safe under type borrows.
fn sameEnvironment(left: &Shared<Intersection>, right: &Shared<Intersection>, map: &[usize]) -> bool {
  let count = environmentSize(left)
  if count != environmentSize(right) {
    return false
  }
  let mut at = usize.ZERO
  while at < count {
    let member = environmentMember(left, at)
    if let Option<Shared<Lifetime>>.Some {value} = move member {
      if !hasMember(right, &value, map) {
        return false
      }
    }
    at = at + usize.ONE
  }
  return true
}

fn sameBound(left: &Outlives, right: &Outlives, map: &[usize]) -> bool {
  return sameLifetime(&left.longer, &right.longer, map) && sameLifetime(
    &left.shorter,
    &right.shorter,
    map,
  )
}

// Invocation bounds are a set. Lifetimes contain no types, so comparing them under type borrows
// cannot re-enter a type.
fn sameOutlives(left: &Vector<Outlives>, right: &Vector<Outlives>, map: &[usize]) -> bool {
  let first = Vector.asSlice<Outlives>(left)
  let second = Vector.asSlice<Outlives>(right)
  if first.length != second.length {
    return false
  }
  let mut at = usize.ZERO
  while at < first.length {
    let mut forward = false
    let mut backward = false
    let mut other = usize.ZERO
    while other < first.length {
      forward = forward || sameBound(&first[at], &second[other], map)
      backward = backward || sameBound(&first[other], &second[at], map)
      other = other + usize.ONE
    }
    if !forward || !backward {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameAlignment(left: &Option<u64>, right: &Option<u64>) -> bool {
  return match & left.* {
    Option<u64>.Some {value} => match & right.* {
      Option<u64>.Some {value: compared} => value == compared
      Option<u64>.None => false
    }
    Option<u64>.None => match & right.* {
      Option<u64>.Some {value: _} => false
      Option<u64>.None => true
    }
  }
}

fn sameAccess(left: Access, right: Access) -> bool {
  return match left {
    Access.Shared => match right {
      Access.Shared => true
      Access.Mutable => false
    }
    Access.Mutable => match right {
      Access.Shared => false
      Access.Mutable => true
    }
  }
}

fn sameMode(left: CallableMode, right: CallableMode) -> bool {
  return match left {
    CallableMode.Shared => match right {
      CallableMode.Shared => true
      _ => false
    }
    CallableMode.Mutable => match right {
      CallableMode.Mutable => true
      _ => false
    }
    CallableMode.Once => match right {
      CallableMode.Once => true
      _ => false
    }
  }
}

fn sameMultiplicity(left: Multiplicity, right: Multiplicity) -> bool {
  return match left {
    Multiplicity.Single => match right {
      Multiplicity.Single => true
      Multiplicity.Many => false
    }
    Multiplicity.Many => match right {
      Multiplicity.Single => false
      Multiplicity.Many => true
    }
  }
}

fn unionLength(value: &Type) -> usize {
  return match & value.* {
    Type.Union {members} => Vector.length<Shared<Type>>(&members)
    _ => usize.MAX
  }
}

fn unionMemberAt(value: &Type, at: usize) -> Option<Shared<Type>> {
  if let Type.Union {members} = &value.* {
    let values = Vector.asSlice<Shared<Type>>(&members)
    return Option.some<Shared<Type>>(Shared.clone<Type>(&values[at]))
  }
  return Option.none<Shared<Type>>()
}

effect fn containsType(members: &[Shared<Type>], candidate: &Shared<Type>) -> bool
! OutOfMemoryError
? &mut Allocator {
  let mut at = usize.ZERO
  while at < members.length {
    if run sameShared(&members[at], candidate) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

effect fn sameRole(left: &Option<Shared<Type>>, right: &Option<Shared<Type>>, map: &[usize]) -> bool
! OutOfMemoryError
? &mut Allocator {
  return run sameChild(left, right, map)
}

effect fn sameKey(left: &Requirement, right: &Requirement, map: &[usize]) -> bool
! OutOfMemoryError
? &mut Allocator {
  if !run sameRole(&left.roleType, &right.roleType, map) {
    return false
  }
  return run sameUnder(&left.capability, &right.capability, map)
}

effect fn keyAt(entries: &[Requirement], candidate: &Requirement) -> usize
! OutOfMemoryError
? &mut Allocator {
  let none = Vector.make<usize>()
  let mut at = usize.ZERO
  while at < entries.length {
    if run sameKey(&entries[at], candidate, Vector.asSlice<usize>(&none)) {
      return at
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn declarationAddress(value: &DeclarationId) -> usize {
  return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(value))
}

fn declarationWith(first: &DeclarationId, right: &Shared<DeclarationId>) -> bool {
  return Shared.with<DeclarationId, bool>(
    right,
    fn(second: &DeclarationId) -> bool {
      return DeclarationId.equals(first, second)
    },
  )
}

fn sameDeclaration(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  if Shared.with<DeclarationId, usize>(left, declarationAddress) == Shared.with<
    DeclarationId,
    usize,
  >(right, declarationAddress) {
    return true
  }
  return Shared.with<DeclarationId, bool>(
    left,
    fn(first: &DeclarationId) -> bool {
      return declarationWith(first, right)
    },
  )
}

fn hasParameter(parameters: &[RowParameter], candidate: &RowParameter, map: &[usize]) -> bool {
  let mut at = usize.ZERO
  while at < parameters.length {
    let mut same = false
    if alphaMap(map) {
      same = binderCompatible(map, candidate.ordinal, parameters[at].ordinal)
    } else {
      same = parameters[at].ordinal == candidate.ordinal && sameDeclaration(&parameters[at].declaration, &candidate.declaration)
    }
    if same {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn rowHasParameter(row: &Row, candidate: &RowParameter) -> bool {
  let none = Vector.make<usize>()
  return hasParameter(Vector.asSlice<RowParameter>(&row.parameters), candidate, Vector.asSlice<usize>(&none))
}

fn sharedRowHasParameter(row: &Shared<Row>, candidate: &RowParameter) -> bool {
  return Shared.with<Row, bool>(
    row,
    fn(value: &Row) -> bool { return rowHasParameter(value, candidate) },
  )
}

fn rowAddress(value: &Row) -> usize {
  return Pointer.address<Row>(Pointer.fromRef<Row>(value))
}

fn rowHeadWith(first: &Row, right: &Shared<Row>, map: &[usize]) -> bool {
  return Shared.with<Row, bool>(
    right,
    fn(second: &Row) -> bool {
      return sameRowHead(first, second, map)
    },
  )
}

// Entry counts and row parameters; parameters hold no types, so they compare under the borrows.
fn sameRowHead(first: &Row, second: &Row, map: &[usize]) -> bool {
  let firstParameters = Vector.asSlice<RowParameter>(&first.parameters)
  let secondParameters = Vector.asSlice<RowParameter>(&second.parameters)
  if Vector.length<Requirement>(&first.entries) != Vector.length<Requirement>(&second.entries) || firstParameters.length != secondParameters.length {
    return false
  }
  let mut at = usize.ZERO
  while at < firstParameters.length {
    if !hasParameter(secondParameters, &firstParameters[at], map) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn entryCapability(row: &Row, at: usize) -> Shared<Type> {
  let entries = Vector.asSlice<Requirement>(&row.entries)
  return Shared.clone<Type>(&entries[at].capability)
}

fn entryRole(row: &Row, at: usize) -> Option<Shared<Type>> {
  let entries = Vector.asSlice<Requirement>(&row.entries)
  return match & entries[at].roleType {
    Option<Shared<Type>>.Some {value} => Option.some<Shared<Type>>(Shared.clone<Type>(&value))
    Option<Shared<Type>>.None => Option.none<Shared<Type>>()
  }
}

fn entryAccess(row: &Row, at: usize) -> Access {
  let entries = Vector.asSlice<Requirement>(&row.entries)
  return entries[at].access
}

fn entryAt(row: &Shared<Row>, at: usize) -> Requirement {
  return Requirement {
    capability: Shared.with<Row, Shared<Type>>(
      row,
      fn(value: &Row) -> Shared<Type> {
        return entryCapability(value, at)
      },
    ),
    roleType: Shared.with<Row, Option<Shared<Type>>>(
      row,
      fn(value: &Row) -> Option<Shared<Type>> {
        return entryRole(value, at)
      },
    ),
    access: Shared.with<Row, Access>(
      row,
      fn(value: &Row) -> Access {
        return entryAccess(value, at)
      },
    ),
  }
}

// Rows compare as sets of keys with equal access. Entry types are compared only after the row
// borrows are released, for the same reason as `sameShared`. A partial alpha map may let several
// candidates match one key; the completed binder bijection is checked again by `assignHead`,
// where normalized keys are distinct. No comparison here mutates a binder map or unifier binding.
effect fn sameRows(left: &Shared<Row>, right: &Shared<Row>, map: &[usize]) -> bool
! OutOfMemoryError
? &mut Allocator {
  if map.length == usize.ZERO && Shared.with<Row, usize>(left, rowAddress) == Shared.with<
    Row,
    usize,
  >(right, rowAddress) {
    return true
  }
  let aliased = Shared.with<Row, usize>(left, rowAddress) == Shared.with<Row, usize>(right, rowAddress)
  let mut headers = false
  if aliased {
    headers = Shared.with<Row, bool>(left, fn(value: &Row) -> bool {
      return sameRowHead(value, value, map)
    })
  } else {
    headers = Shared.with<Row, bool>(left, fn(first: &Row) -> bool {
      return rowHeadWith(first, right, map)
    })
  }
  if !headers {
    return false
  }
  let count = Shared.with<Row, usize>(
    left,
    fn(value: &Row) -> usize {
      return Vector.length<Requirement>(&value.entries)
    },
  )
  let mut at = usize.ZERO
  while at < count {
    let entry = entryAt(left, at)
    let mut matched = false
    let mut other = usize.ZERO
    while !matched && other < count {
      let candidate = entryAt(right, other)
      if sameAccess(entry.access, candidate.access) && run sameKey(&entry, &candidate, map) {
        matched = true
      }
      other = other + usize.ONE
    }
    if !matched {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn collectRow(row: &Shared<Row>, order: &mut Vector<usize>) -> ()
! OutOfMemoryError
? &mut Allocator {
  let entries = Shared.with<Row, usize>(
    row,
    fn(value: &Row) -> usize {
      return Vector.length<Requirement>(&value.entries)
    },
  )
  let mut at = usize.ZERO
  while at < entries {
    let entry = entryAt(row, at)
    run Type.collectInvocations(&entry.capability, &mut order.*)
    at = at + usize.ONE
  }
  return ()
}

impl Row {
  /// Whether a row still contains a type or requirement-row parameter after lifetime erasure.
  pub fn hasOpenRuntimeParameters(value: &Shared<Row>) -> bool {
    return openRow(value, true)
  }
  /// Creates the empty row written by omitting `? R` or writing `? never`.
  pub fn empty() -> Row {
    return Row {entries: Vector.make<Requirement>(), parameters: Vector.make<RowParameter>()}
  }
  /// Adds one entry, keeping the strongest access when its service-role key is already present.
  pub effect fn require(self: &mut Self, requirement: Requirement) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let found = run keyAt(Vector.asSlice<Requirement>(&self.entries), &requirement)
    if found == usize.MAX {
      run Vector.append<Requirement>(&mut self.entries, move requirement)
      return ()
    }
    // Exclusive access is the stronger requirement for one key.
    if !sameAccess(requirement.access, Access.Shared) {
      let entries = Vector.asMutSlice<Requirement>(&mut self.entries)
      entries[found].access = Access.Mutable
    }
    return ()
  }
  /// Adds one row parameter unless the row already includes it.
  pub effect fn include(self: &mut Self, parameter: RowParameter) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let map = Vector.make<usize>()
    if !hasParameter(Vector.asSlice<RowParameter>(&self.parameters), &parameter, Vector.asSlice<usize>(&map)) {
      run Vector.append<RowParameter>(&mut self.parameters, move parameter)
    }
    return ()
  }
  /// Adds every entry and row parameter of `other`, as when a bound `?R` is substituted.
  pub effect fn merge(self: &mut Self, other: &Shared<Row>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let entries = Shared.with<Row, usize>(
      other,
      fn(value: &Row) -> usize {
        return Vector.length<Requirement>(&value.entries)
      },
    )
    let mut at = usize.ZERO
    while at < entries {
      run Row.require(&mut self.*, entryAt(other, at))
      at = at + usize.ONE
    }
    let parameters = Shared.with<Row, usize>(
      other,
      fn(value: &Row) -> usize {
        return Vector.length<RowParameter>(&value.parameters)
      },
    )
    at = usize.ZERO
    while at < parameters {
      let parameter = Shared.with<Row, RowParameter>(
        other,
        fn(value: &Row) -> RowParameter {
          let values = Vector.asSlice<RowParameter>(&value.parameters)
          return RowParameter {
            declaration: Shared.clone<DeclarationId>(&values[at].declaration),
            ordinal: values[at].ordinal,
          }
        },
      )
      run Row.include(&mut self.*, move parameter)
      at = at + usize.ONE
    }
    return ()
  }
  /// Reports whether two shared rows have the same keys, accesses, and row parameters.
  pub effect fn equalsShared(left: &Shared<Row>, right: &Shared<Row>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    let none = Vector.make<usize>()
    return run sameRows(left, right, Vector.asSlice<usize>(&none))
  }
  /// Compares normalized rows after erasing lifetimes inside their service-role keys.
  pub effect fn runtimeEqualsShared(left: &Shared<Row>, right: &Shared<Row>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut projection = Vector.make<usize>()
    run Vector.append<usize>(&mut projection, usize.MAX - 2)
    return run sameRows(left, right, Vector.asSlice<usize>(&projection))
  }
  /// Reports how a narrower `witness` row fits within a `promised` upper bound, first by entry and
  /// then by row parameter.
  ///
  /// # Details
  ///
  /// Each witness entry needs a promised entry with the same service-role key whose access is at
  /// least as strong, and each witness row parameter must itself be promised. Nothing is solved: a
  /// promised row parameter is an unknown row, so it covers no entry the witness names.
  pub effect fn covers(promised: &Shared<Row>, witness: &Shared<Row>) -> RowCoverage
  ! OutOfMemoryError
  ? &mut Allocator {
    let none = Vector.make<usize>()
    let map = Vector.asSlice<usize>(&none)
    let entries = Shared.with<Row, usize>(
      witness,
      fn(value: &Row) -> usize {
        return Vector.length<Requirement>(&value.entries)
      },
    )
    let available = Shared.with<Row, usize>(
      promised,
      fn(value: &Row) -> usize {
        return Vector.length<Requirement>(&value.entries)
      },
    )
    let mut at = usize.ZERO
    while at < entries {
      let entry = entryAt(witness, at)
      let mut other = usize.ZERO
      let mut found = false
      while !found && other < available {
        let candidate = entryAt(promised, other)
        if run sameKey(&entry, &candidate, map) {
          if !sameAccess(entry.access, Access.Shared) && sameAccess(candidate.access, Access.Shared) {
            return RowCoverage.Access
          }
          found = true
        }
        other = other + usize.ONE
      }
      if !found {
        return RowCoverage.Entry
      }
      at = at + usize.ONE
    }
    let parameters = Shared.with<Row, usize>(
      witness,
      fn(value: &Row) -> usize {
        return Vector.length<RowParameter>(&value.parameters)
      },
    )
    at = usize.ZERO
    while at < parameters {
      let promisedParameter = Shared.with<Row, bool>(
        witness,
        fn(value: &Row) -> bool {
          let values = Vector.asSlice<RowParameter>(&value.parameters)
          return sharedRowHasParameter(promised, &values[at])
        },
      )
      if !promisedParameter {
        return RowCoverage.Parameter
      }
      at = at + usize.ONE
    }
    return RowCoverage.Covered
  }
}

/// How a narrower requirement row fits within a promised upper bound.
pub enum RowCoverage {
  /// Every entry and row parameter is promised with sufficient access.
  Covered,
  /// An entry's service-role key is not promised.
  Entry,
  /// An entry requires exclusive access where the promised entry grants only shared access.
  Access,
  /// A row parameter is not promised.
  Parameter,
}

// A failure type's members: a structural union's members, none for `never`, otherwise itself.
fn failureCount(value: &Type) -> usize {
  let members = unionLength(value)
  if members == usize.MAX {
    return usize.ONE
  }
  return members
}

fn failureMember(value: &Shared<Type>, at: usize) -> Shared<Type> {
  let member = memberOf(value, at)
  if let Option<Shared<Type>>.Some {value: found} = move member {
    return move found
  }
  return Shared.clone<Type>(value)
}

// `usize.MAX` for unknown stored contents, `usize.ONE` when child types are stored contents, and
// zero when only the node's own lifetimes are retained.
fn retentionKind(value: &Type) -> usize {
  return match & value.* {
    Type.Parameter {..} => usize.MAX
    Type.Nominal {..} => usize.ONE
    Type.Array {..} => usize.ONE
    Type.Anonymous {..} => usize.ONE
    _ => usize.ZERO
  }
}

fn isStaticLifetime(value: &Lifetime) -> bool {
  return match & value.* {
    Lifetime.Static => true
    _ => false
  }
}

effect fn appendOrdinal(order: &mut Vector<usize>, ordinal: usize) -> ()
! OutOfMemoryError
? &mut Allocator {
  let seen = Vector.asSlice<usize>(&order.*)
  let mut at = usize.ZERO
  while at < seen.length {
    if seen[at] == ordinal {
      return ()
    }
    at = at + usize.ONE
  }
  run Vector.append<usize>(&mut order.*, ordinal)
  return ()
}

fn ownedLifetimeOrdinal(value: &Lifetime, owner: &DeclarationId) -> usize {
  if let Lifetime.Parameter {declaration, ordinal} = &value.* {
    if DeclarationId.equals(&declaration, owner) {
      return ordinal
    }
  }
  return usize.MAX
}

fn ownedRowOrdinal(row: &Row, at: usize, owner: &DeclarationId) -> usize {
  let parameters = Vector.asSlice<RowParameter>(&row.parameters)
  if Shared.with<DeclarationId, bool>(
    &parameters[at].declaration,
    fn(declaration: &DeclarationId) -> bool {
      return DeclarationId.equals(declaration, owner)
    },
  ) {
    return parameters[at].ordinal
  }
  return usize.MAX
}

fn invocationOrdinal(value: &Lifetime) -> usize {
  return match & value.* {
    Lifetime.Invocation {ordinal} => ordinal
    _ => usize.MAX
  }
}

fn environmentMember(environment: &Shared<Intersection>, at: usize) -> Option<Shared<Lifetime>> {
  return Shared.with<Intersection, Option<Shared<Lifetime>>>(
    environment,
    fn(found: &Intersection) -> Option<Shared<Lifetime>> {
      let members = Vector.asSlice<Member>(&found.members)
      if at < members.length {
        return Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&members[at].region))
      }
      return Option.none<Shared<Lifetime>>()
    },
  )
}

fn environmentSize(environment: &Shared<Intersection>) -> usize {
  return Shared.with<Intersection, usize>(
    environment,
    fn(found: &Intersection) -> usize {
      return Vector.length<Member>(&found.members)
    },
  )
}

// The lifetimes written directly on one node, in structural order.
fn ownLifetimeCount(value: &Type) -> usize {
  return match & value.* {
    Type.String {..} => usize.ONE
    Type.Reference {..} => usize.ONE
    Type.Slice {..} => usize.ONE
    Type.Nominal {arguments, ..} => Vector.length<Argument>(&arguments)
    Type.NamedRepresentation {arguments, ..} => Vector.length<Argument>(&arguments)
    Type.OpaqueRepresentation {arguments, ..} => Vector.length<Argument>(&arguments)
    Type.Callable {environment, ..} => environmentSize(&environment)
    Type.Effect {environment, ..} => environmentSize(&environment)
    _ => usize.ZERO
  }
}

fn ownLifetimeAt(value: &Type, at: usize) -> Option<Shared<Lifetime>> {
  return match & value.* {
    Type.String {lifetime} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
    Type.Reference {lifetime, ..} => Option.some<Shared<Lifetime>>(
      Shared.clone<Lifetime>(&lifetime),
    )
    Type.Slice {lifetime, ..} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
    Type.Nominal {arguments, ..} => {
      let values = Vector.asSlice<Argument>(&arguments)
      return match & values[at] {
        Argument.Lifetime {value: lifetime} => Option.some<Shared<Lifetime>>(
          Shared.clone<Lifetime>(&lifetime),
        )
        _ => Option.none<Shared<Lifetime>>()
      }
    }
    Type.NamedRepresentation {arguments, ..} => {
      let values = Vector.asSlice<Argument>(&arguments)
      return match &values[at] {
        Argument.Lifetime {value: lifetime} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
        _ => Option.none<Shared<Lifetime>>()
      }
    }
    Type.OpaqueRepresentation {arguments, ..} => {
      let values = Vector.asSlice<Argument>(&arguments)
      return match &values[at] {
        Argument.Lifetime {value: lifetime} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
        _ => Option.none<Shared<Lifetime>>()
      }
    }
    Type.Callable {environment, ..} => environmentMember(&environment, at)
    Type.Effect {environment, ..} => environmentMember(&environment, at)
    _ => Option.none<Shared<Lifetime>>()
  }
}

// Callable outlives bounds are part of semantic comparison, but they are not captured by a
// callable value. Keep them separate from `ownLifetimeCount/At`, which retention also uses.
fn boundLifetimeCount(value: &Type) -> usize {
  return match & value.* {
    Type.Callable {invocationBounds, ..} => Vector.length<Outlives>(&invocationBounds) + Vector.length<Outlives>(&invocationBounds)
    _ => usize.ZERO
  }
}

fn boundLifetimeAt(value: &Type, at: usize) -> Option<Shared<Lifetime>> {
  return match & value.* {
    Type.Callable {invocationBounds, ..} => {
      let bounds = Vector.asSlice<Outlives>(&invocationBounds)
      let mut index = usize.ZERO
      let mut bound = usize.ZERO
      while bound < bounds.length {
        if at == index {
          return Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&bounds[bound].longer))
        }
        index = index + usize.ONE
        if at == index {
          return Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&bounds[bound].shorter))
        }
        index = index + usize.ONE
        bound = bound + usize.ONE
      }
      return Option.none<Shared<Lifetime>>()
    }
    _ => Option.none<Shared<Lifetime>>()
  }
}

fn comparedLifetimeCount(value: &Type) -> usize {
  return ownLifetimeCount(value) + boundLifetimeCount(value)
}

fn comparedLifetimeAt(value: &Type, at: usize) -> Option<Shared<Lifetime>> {
  let own = ownLifetimeCount(value)
  if at < own {
    return ownLifetimeAt(value, at)
  }
  return boundLifetimeAt(value, at - own)
}

fn openLifetime(value: &Lifetime) -> bool {
  return match & value.* {
    Lifetime.Parameter {..} => true
    _ => false
  }
}

fn openRow(value: &Shared<Row>, runtime: bool) -> bool {
  let parameters = Shared.with<Row, usize>(value, fn(row: &Row) -> usize {
    return Vector.length<RowParameter>(&row.parameters)
  })
  if parameters != usize.ZERO {
    return true
  }
  let entries = Shared.with<Row, usize>(value, fn(row: &Row) -> usize {
    return Vector.length<Requirement>(&row.entries)
  })
  let mut at = usize.ZERO
  while at < entries {
    let capability = Shared.with<Row, Shared<Type>>(value, fn(row: &Row) -> Shared<Type> {
      let listed = Vector.asSlice<Requirement>(&row.entries)
      return Shared.clone<Type>(&listed[at].capability)
    })
    if openType(&capability, runtime) {
      return true
    }
    let roleType = Shared.with<Row, Option<Shared<Type>>>(value, fn(row: &Row) -> Option<Shared<Type>> {
      let listed = Vector.asSlice<Requirement>(&row.entries)
      if let Option<Shared<Type>>.Some {value: named} = &listed[at].roleType {
        return Option.some<Shared<Type>>(Shared.clone<Type>(&named))
      }
      return Option.none<Shared<Type>>()
    })
    if let Option<Shared<Type>>.Some {value: named} = move roleType {
      if openType(&named, runtime) {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn openType(value: &Shared<Type>, runtime: bool) -> bool {
  let direct = Shared.with<Type, bool>(value, fn(node: &Type) -> bool {
    return match & node.* {
      Type.Parameter {..} => true
      _ => false
    }
  })
  if direct {
    return true
  }
  let mut lifetimes = usize.ZERO
  if !runtime {
    lifetimes = Shared.with<Type, usize>(value, comparedLifetimeCount)
  }
  let mut at = usize.ZERO
  while at < lifetimes {
    let found = Shared.with<Type, Option<Shared<Lifetime>>>(value, fn(node: &Type) -> Option<Shared<Lifetime>> {
      return comparedLifetimeAt(node, at)
    })
    if let Option<Shared<Lifetime>>.Some {value: region} = move found {
      if Shared.with<Lifetime, bool>(&region, openLifetime) {
        return true
      }
    }
    at = at + usize.ONE
  }
  let children = Shared.with<Type, usize>(value, childCount)
  at = usize.ZERO
  while at < children {
    let found = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
      return childAt(node, at)
    })
    if let Option<Shared<Type>>.Some {value: nested} = move found {
      if openType(&nested, runtime) {
        return true
      }
    }
    let row = argumentRowOf(value, at)
    if let Option<Shared<Row>>.Some {value: supplied} = move row {
      if openRow(&supplied, runtime) {
        return true
      }
    }
    at = at + usize.ONE
  }
  let members = Shared.with<Type, usize>(value, unionLength)
  if members != usize.MAX {
    at = usize.ZERO
    while at < members {
      let found = memberOf(value, at)
      if let Option<Shared<Type>>.Some {value: nested} = move found {
        if openType(&nested, runtime) {
          return true
        }
      }
      at = at + usize.ONE
    }
  }
  let requirements = Shared.with<Type, Option<Shared<Row>>>(value, rowOf)
  if let Option<Shared<Row>>.Some {value: row} = move requirements {
    return openRow(&row, runtime)
  }
  return false
}

impl Type {
  /// Reads the canonical decimal extent without truncating an unrepresentable length.
  pub fn extentValue(digits: &[u8]) -> Option<usize> {
    if digits.length == usize.ZERO { return Option.none<usize>() }
    let mut length = usize.ZERO
    let mut at = usize.ZERO
    while at < digits.length {
      if digits[at] < 48 || digits[at] > 57 { return Option.none<usize>() }
      let digit = u8.toUsize(digits[at]) - 48
      if length > (usize.MAX - digit) / 10 { return Option.none<usize>() }
      length = length * 10 + digit
      at = at + usize.ONE
    }
    return Option.some<usize>(length)
  }

  /// Writes the canonical decimal extent for a closed logical length.
  pub effect fn extentText(count: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut reversed = Bytes.make()
    let mut remaining = count
    if remaining == usize.ZERO { return run Bytes.copy(b"0") }
    while remaining > usize.ZERO {
      let digit = [usize.toU8(48 + usize.remainder(remaining, 10))]
      run Bytes.append(&mut reversed, &digit)
      remaining = remaining / 10
    }
    let digits = Bytes.asSlice(&reversed)
    let mut extent = Bytes.make()
    let mut at = digits.length
    while at > usize.ZERO {
      at = at - usize.ONE
      run Bytes.append(&mut extent, &[digits[at]])
    }
    return move extent
  }

  /// Reads one fixed array's element and representable logical length.
  pub fn arrayShape(ty: &Shared<Type>) -> Option<ArrayShape> {
    return Shared.with<Type, Option<ArrayShape>>(ty, fn(value: &Type) -> Option<ArrayShape> {
      if let Type.Array {element, extent} = &value.* {
        if let Option<usize>.Some {value: length} = move Type.extentValue(Bytes.asSlice(&extent)) {
          return Option.some<ArrayShape>(ArrayShape {element: Shared.clone<Type>(&element), length: length})
        }
      }
      return Option.none<ArrayShape>()
    })
  }


  /// The first nominal or anonymous-occurrence declaration a value type mentions, searching array
  /// elements and union members in canonical order. Drop glue for the type is attributed to it; a
  /// type that mentions none owns no aggregate that could need cleanup.
  pub effect fn glueOwner(value: &Shared<Type>) -> Option<DeclarationId> ! OutOfMemoryError ? &mut Allocator {
    let node = run nodeCopy(value)
    return match &node {
      Type.Nominal {declaration, ..} => Option.some<DeclarationId>(run DeclarationId.copy(&declaration))
      Type.Anonymous {occurrence, ..} => {
        let declaration = Shared.with<AnonymousOccurrence, Shared<DeclarationId>>(&occurrence, fn(site: &AnonymousOccurrence) -> Shared<DeclarationId> {
          return Shared.clone<DeclarationId>(&site.declaration)
        })
        return Option.some<DeclarationId>(run DeclarationId.copyShared(&declaration))
      }
      Type.Array {element, ..} => run Type.glueOwner(&element)
      Type.Union {..} => {
        let members = match move run Type.canonicalUnionMembers(value) {
          Option<Vector<Shared<Type>>>.Some {value: ordered} => ordered
          Option<Vector<Shared<Type>>>.None => { return Option.none<DeclarationId>() }
        }
        let listed = Vector.asSlice<Shared<Type>>(&members)
        let mut at = usize.ZERO
        while at < listed.length {
          let candidate = run Type.glueOwner(&listed[at])
          if let Option<DeclarationId>.Some {value: found} = move candidate { return Option.some<DeclarationId>(move found) }
          at = at + usize.ONE
        }
        return Option.none<DeclarationId>()
      }
      _ => Option.none<DeclarationId>()
    }
  }

  /// Reads a borrowed slice's element identity without erasing access or validity in its type.
  pub fn sliceElement(ty: &Shared<Type>) -> Option<Shared<Type>> {
    return Shared.with<Type, Option<Shared<Type>>>(ty, fn(value: &Type) -> Option<Shared<Type>> {
      if let Type.Slice {element, ..} = &value.* {
        return Option.some<Shared<Type>>(Shared.clone<Type>(&element))
      }
      return Option.none<Shared<Type>>()
    })
  }

  /// Whether a type, including nested lifetimes and requirement rows, contains a declaration-owned
  /// generic parameter. Only such open goals may use a caller's declared abstract bounds as proof.
  pub fn hasOpenParameters(value: &Shared<Type>) -> bool {
    return openType(value, false)
  }
  /// Whether a type mentions the phase-only `Intrinsic.Type<Owner>` descriptor at any depth.
  pub fn mentionsDescriptor(value: &Shared<Type>) -> bool {
    if Shared.with<Type, bool>(value, fn(node: &Type) -> bool {
      return match & node.* {
        Type.TypeDescriptor {..} => true
        _ => false
      }
    }) { return true }
    let children = Shared.with<Type, usize>(value, childCount)
    let mut at = usize.ZERO
    while at < children {
      let found = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
        return childAt(node, at)
      })
      if let Option<Shared<Type>>.Some {value: nested} = move found {
        if Type.mentionsDescriptor(&nested) { return true }
      }
      at = at + usize.ONE
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        let found = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
          return unionMemberAt(node, at)
        })
        if let Option<Shared<Type>>.Some {value: nested} = move found {
          if Type.mentionsDescriptor(&nested) { return true }
        }
        at = at + usize.ONE
      }
    }
    return false
  }
  /// Whether a runtime specialization still contains a type or requirement-row parameter.
  /// Validity lifetimes remain in the semantic type but do not make runtime code generic.
  pub fn hasOpenRuntimeParameters(value: &Shared<Type>) -> bool {
    return openType(value, true)
  }
  /// Reports whether a value type applies an interface or service anywhere outside a requirement
  /// row. Interfaces and services are compile-time contracts, not storable existential values.
  pub fn mentionsContract(value: &Type) -> bool {
    return match & value.* {
      Type.Nominal {declaration, arguments, ..} => {
        let kind = DeclarationId.kind(&declaration)
        if kind == OwnerKind.Interface || kind == OwnerKind.Service {
          return true
        }
        let supplied = Vector.asSlice<Argument>(&arguments)
        let mut at = usize.ZERO
        while at < supplied.length {
          if let Argument.Type {value: argument} = &supplied[at] {
            if Shared.with<Type, bool>(&argument, Type.mentionsContract) {
              return true
            }
          }
          at = at + usize.ONE
        }
        return false
      }
      Type.NamedRepresentation {arguments, ..} => {
        let supplied = Vector.asSlice<Argument>(&arguments)
        let mut at = usize.ZERO
        while at < supplied.length {
          if let Argument.Type {value: argument} = &supplied[at] {
            if Shared.with<Type, bool>(&argument, Type.mentionsContract) {
              return true
            }
          }
          at = at + usize.ONE
        }
        return false
      }
      Type.OpaqueRepresentation {arguments, contract, ..} => {
        if Shared.with<Type, bool>(&contract, Type.mentionsContract) {
          return true
        }
        let supplied = Vector.asSlice<Argument>(&arguments)
        let mut at = usize.ZERO
        while at < supplied.length {
          if let Argument.Type {value: argument} = &supplied[at] {
            if Shared.with<Type, bool>(&argument, Type.mentionsContract) {
              return true
            }
          }
          at = at + usize.ONE
        }
        return false
      }
      Type.Reference {referent, ..} => Shared.with<Type, bool>(&referent, Type.mentionsContract)
      Type.Slice {element, ..} => Shared.with<Type, bool>(&element, Type.mentionsContract)
      Type.Pointer {pointee, ..} => Shared.with<Type, bool>(&pointee, Type.mentionsContract)
      Type.Array {element, ..} => Shared.with<Type, bool>(&element, Type.mentionsContract)
      Type.Anonymous {members, ..} => Type.anyMentionsContract(Vector.asSlice<Shared<Type>>(&members))
      Type.Union {members} => Type.anyMentionsContract(Vector.asSlice<Shared<Type>>(&members))
      Type.Callable {parameters, result, ..} => Type.anyMentionsContract(
        Vector.asSlice<Shared<Type>>(&parameters),
      ) || Shared.with<Type, bool>(&result, Type.mentionsContract)
      Type.Effect {success, failure, ..} => Shared.with<Type, bool>(&success, Type.mentionsContract) || Shared.with<
        Type,
        bool,
      >(&failure, Type.mentionsContract)
      _ => false
    }
  }
  /// Reports whether any listed type mentions an interface or service.
  pub fn anyMentionsContract(values: &[Shared<Type>]) -> bool {
    let mut at = usize.ZERO
    while at < values.length {
      if Shared.with<Type, bool>(&values[at], Type.mentionsContract) {
        return true
      }
      at = at + usize.ONE
    }
    return false
  }
  /// The binder ordinal of a type parameter bound by `owner`, or `usize.MAX` for any other type.
  pub fn parameterOrdinalOf(value: &Type, owner: &DeclarationId) -> usize {
    if let Type.Parameter {declaration, ordinal} = &value.* {
      if DeclarationId.equals(&declaration, owner) {
        return ordinal
      }
    }
    return usize.MAX
  }
  /// Appends each invocation binder ordinal the first time it occurs in `value`.
  ///
  /// # Details
  ///
  /// The walk visits a node's own lifetimes, then its ordered child types, union members, and
  /// requirement-row capabilities. It numbers the binders a contract actually uses, so an unused
  /// binder drops out; equality does not depend on this order.
  pub effect fn collectInvocations(value: &Shared<Type>, order: &mut Vector<usize>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let lifetimes = Shared.with<Type, usize>(value, comparedLifetimeCount)
    let mut at = usize.ZERO
    while at < lifetimes {
      let found = Shared.with<Type, Option<Shared<Lifetime>>>(
        value,
        fn(node: &Type) -> Option<Shared<Lifetime>> {
          return comparedLifetimeAt(node, at)
        },
      )
      if let Option<Shared<Lifetime>>.Some {value: lifetime} = move found {
        run Type.collectLifetime(&lifetime, &mut order.*)
      }
      at = at + usize.ONE
    }
    let count = Shared.with<Type, usize>(value, childCount)
    at = usize.ZERO
    while at < count {
      let child = Shared.with<Type, Option<Shared<Type>>>(
        value,
        fn(node: &Type) -> Option<Shared<Type>> {
          return childAt(node, at)
        },
      )
      if let Option<Shared<Type>>.Some {value: nested} = move child {
        run Type.collectInvocations(&nested, &mut order.*)
      }
      let row = argumentRowOf(value, at)
      if let Option<Shared<Row>>.Some {value: supplied} = move row {
        run collectRow(&supplied, &mut order.*)
      }
      at = at + usize.ONE
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        let member = memberOf(value, at)
        if let Option<Shared<Type>>.Some {value: nested} = move member {
          run Type.collectInvocations(&nested, &mut order.*)
        }
        at = at + usize.ONE
      }
    }
    let effectRow = Shared.with<Type, Option<Shared<Row>>>(value, rowOf)
    if let Option<Shared<Row>>.Some {value: requirements} = move effectRow {
      run collectRow(&requirements, &mut order.*)
    }
    return ()
  }
  /// Appends the ordinal of every type, lifetime, or row parameter owned by `owner` that `value`
  /// mentions, each kind to its own list and each ordinal once, including inside requirement rows.
  pub effect fn collectOwned(
    value: &Shared<Type>,
    owner: &DeclarationId,
    types: &mut Vector<usize>,
    lifetimes: &mut Vector<usize>,
    rows: &mut Vector<usize>,
  ) -> () ! OutOfMemoryError ? &mut Allocator {
    let direct = Shared.with<Type, usize>(
      value,
      fn(node: &Type) -> usize {
        return Type.parameterOrdinalOf(node, owner)
      },
    )
    if direct != usize.MAX {
      return run appendOrdinal(&mut types.*, direct)
    }
    let contract = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
      if let Type.OpaqueRepresentation {contract, ..} = &node.* { return Option.some<Shared<Type>>(Shared.clone<Type>(&contract)) }
      return Option.none<Shared<Type>>()
    })
    if let Option<Shared<Type>>.Some {value: nested} = move contract {
      run Type.collectOwned(&nested, owner, &mut types.*, &mut lifetimes.*, &mut rows.*)
    }
    let regions = Shared.with<Type, usize>(value, comparedLifetimeCount)
    let mut at = usize.ZERO
    while at < regions {
      let found = Shared.with<Type, Option<Shared<Lifetime>>>(
        value,
        fn(node: &Type) -> Option<Shared<Lifetime>> {
          return comparedLifetimeAt(node, at)
        },
      )
      if let Option<Shared<Lifetime>>.Some {value: lifetime} = move found {
        run Type.collectOwnedLifetime(&lifetime, owner, &mut lifetimes.*)
      }
      at = at + usize.ONE
    }
    let count = Shared.with<Type, usize>(value, childCount)
    at = usize.ZERO
    while at < count {
      let child = Shared.with<Type, Option<Shared<Type>>>(
        value,
        fn(node: &Type) -> Option<Shared<Type>> {
          return childAt(node, at)
        },
      )
      if let Option<Shared<Type>>.Some {value: nested} = move child {
        run Type.collectOwned(&nested, owner, &mut types.*, &mut lifetimes.*, &mut rows.*)
      }
      let row = argumentRowOf(value, at)
      if let Option<Shared<Row>>.Some {value: supplied} = move row {
        run Type.collectOwnedRow(&supplied, owner, &mut types.*, &mut lifetimes.*, &mut rows.*)
      }
      at = at + usize.ONE
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        let member = memberOf(value, at)
        if let Option<Shared<Type>>.Some {value: nested} = move member {
          run Type.collectOwned(&nested, owner, &mut types.*, &mut lifetimes.*, &mut rows.*)
        }
        at = at + usize.ONE
      }
    }
    let effectRow = Shared.with<Type, Option<Shared<Row>>>(value, rowOf)
    if let Option<Shared<Row>>.Some {value: requirements} = move effectRow {
      run Type.collectOwnedRow(&requirements, owner, &mut types.*, &mut lifetimes.*, &mut rows.*)
    }
    return ()
  }
  /// Appends a lifetime parameter's ordinal when `owner` binds it.
  pub effect fn collectOwnedLifetime(
    lifetime: &Shared<Lifetime>,
    owner: &DeclarationId,
    lifetimes: &mut Vector<usize>,
  ) -> () ! OutOfMemoryError ? &mut Allocator {
    let ordinal = Shared.with<Lifetime, usize>(
      lifetime,
      fn(region: &Lifetime) -> usize {
        return ownedLifetimeOrdinal(region, owner)
      },
    )
    if ordinal == usize.MAX {
      return ()
    }
    return run appendOrdinal(&mut lifetimes.*, ordinal)
  }
  /// Appends the owned parameters a requirement row mentions through its capabilities and `?R`
  /// parameters.
  pub effect fn collectOwnedRow(
    row: &Shared<Row>,
    owner: &DeclarationId,
    types: &mut Vector<usize>,
    lifetimes: &mut Vector<usize>,
    rows: &mut Vector<usize>,
  ) -> () ! OutOfMemoryError ? &mut Allocator {
    let entries = Shared.with<Row, usize>(
      row,
      fn(value: &Row) -> usize {
        return Vector.length<Requirement>(&value.entries)
      },
    )
    let mut at = usize.ZERO
    while at < entries {
      let entry = entryAt(row, at)
      run Type.collectOwned(&entry.capability, owner, &mut types.*, &mut lifetimes.*, &mut rows.*)
      if let Option<Shared<Type>>.Some {value: roleValue} = &entry.roleType {
        run Type.collectOwned(&roleValue, owner, &mut types.*, &mut lifetimes.*, &mut rows.*)
      }
      at = at + usize.ONE
    }
    let parameters = Shared.with<Row, usize>(
      row,
      fn(value: &Row) -> usize {
        return Vector.length<RowParameter>(&value.parameters)
      },
    )
    at = usize.ZERO
    while at < parameters {
      let ordinal = Shared.with<Row, usize>(
        row,
        fn(value: &Row) -> usize {
          return ownedRowOrdinal(value, at, owner)
        },
      )
      if ordinal != usize.MAX {
        run appendOrdinal(&mut rows.*, ordinal)
      }
      at = at + usize.ONE
    }
    return ()
  }
  /// Appends an invocation binder ordinal unless it is already present.
  pub effect fn collectLifetime(lifetime: &Shared<Lifetime>, order: &mut Vector<usize>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let ordinal = Shared.with<Lifetime, usize>(lifetime, invocationOrdinal)
    if ordinal == usize.MAX {
      return ()
    }
    return run appendOrdinal(&mut order.*, ordinal)
  }
  /// Appends the non-static regions a value of this type retains when an Effect captures it, and
  /// reports whether every retained region is known.
  ///
  /// # Details
  ///
  /// - A borrow retains its own region, which also bounds its referent.
  /// - A nominal value retains its lifetime arguments and whatever its type arguments retain.
  /// - A callable or Effect retains only its environment; its parameter, success, and failure
  ///   types describe calls and outcomes, not stored captures.
  /// - A raw pointer claims no loan.
  /// - A representation parameter, bound by `F: fn(A) -> B` or `F: Effect<A>`, retains what its
  ///   contract retains. `representations` holds that contract at the binder ordinal of a
  ///   parameter owned by `owner`; an enclosing declaration's parameter never reads that table.
  /// - Any other type parameter's stored contents are unknown, so the answer is `false`.
  pub effect fn retainedRegions(
    value: &Shared<Type>,
    owner: &DeclarationId,
    representations: &[Option<Shared<Type>>],
    regions: &mut Vector<Shared<Lifetime>>,
  ) -> bool ! OutOfMemoryError ? &mut Allocator {
    let detached = Shared.with<Type, bool>(
      value,
      fn(node: &Type) -> bool {
        return match & node.* {
          Type.OpaqueRepresentation {detached, ..} => detached
          _ => false
        }
      },
    )
    if detached {
      return true
    }
    let opaqueContract = Shared.with<Type, Option<Shared<Type>>>(
      value,
      fn(node: &Type) -> Option<Shared<Type>> {
        return match & node.* {
          Type.OpaqueRepresentation {contract, ..} => Option.some<Shared<Type>>(
            Shared.clone<Type>(&contract),
          )
          _ => Option.none<Shared<Type>>()
        }
      },
    )
    if let Option<Shared<Type>>.Some {value: contract} = move opaqueContract {
      return run Type.retainedRegions(&contract, owner, representations, &mut regions.*)
    }
    let kind = Shared.with<Type, usize>(value, retentionKind)
    if kind == usize.MAX {
      let ordinal = Shared.with<Type, usize>(
        value,
        fn(node: &Type) -> usize {
          return Type.parameterOrdinalOf(node, owner)
        },
      )
      if ordinal < representations.length {
        if let Option<Shared<Type>>.Some {value: contract} = &representations[ordinal] {
          return run Type.retainedRegions(&contract, owner, representations, &mut regions.*)
        }
      }
      return false
    }
    let lifetimes = Shared.with<Type, usize>(value, ownLifetimeCount)
    let mut at = usize.ZERO
    while at < lifetimes {
      let found = Shared.with<Type, Option<Shared<Lifetime>>>(
        value,
        fn(node: &Type) -> Option<Shared<Lifetime>> {
          return ownLifetimeAt(node, at)
        },
      )
      if let Option<Shared<Lifetime>>.Some {value: lifetime} = move found {
        if !Shared.with<Lifetime, bool>(&lifetime, isStaticLifetime) {
          run Vector.append<Shared<Lifetime>>(&mut regions.*, move lifetime)
        }
      }
      at = at + usize.ONE
    }
    // Only nominal arguments, array elements, and union members are stored contents.
    if kind == usize.ONE {
      let count = Shared.with<Type, usize>(value, childCount)
      at = usize.ZERO
      while at < count {
        let child = Shared.with<Type, Option<Shared<Type>>>(
          value,
          fn(node: &Type) -> Option<Shared<Type>> {
            return childAt(node, at)
          },
        )
        if let Option<Shared<Type>>.Some {value: nested} = move child {
          if !run Type.retainedRegions(&nested, owner, representations, &mut regions.*) {
            return false
          }
        }
        at = at + usize.ONE
      }
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        let member = memberOf(value, at)
        if let Option<Shared<Type>>.Some {value: nested} = move member {
          if !run Type.retainedRegions(&nested, owner, representations, &mut regions.*) {
            return false
          }
        }
        at = at + usize.ONE
      }
    }
    return true
  }
  /// Adds one union member, flattening a nested union and dropping a repeated member.
  pub effect fn joinMember(members: &mut Vector<Shared<Type>>, member: &Shared<Type>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let count = Shared.with<Type, usize>(member, unionLength)
    if count != usize.MAX {
      let mut at = usize.ZERO
      while at < count {
        let part = Shared.with<Type, Option<Shared<Type>>>(
          member,
          fn(value: &Type) -> Option<Shared<Type>> {
            return unionMemberAt(value, at)
          },
        )
        if let Option<Shared<Type>>.Some {value: nested} = move part {
          let present = run containsType(Vector.asSlice<Shared<Type>>(&members.*), &nested)
          if !present {
            run Vector.append<Shared<Type>>(&mut members.*, move nested)
          }
        }
        at = at + usize.ONE
      }
      return ()
    }
    let present = run containsType(Vector.asSlice<Shared<Type>>(&members.*), member)
    if !present {
      run Vector.append<Shared<Type>>(&mut members.*, Shared.clone<Type>(member))
    }
    return ()
  }
  /// A closed structural union's members in canonical runtime-encoding order, the order union
  /// identity already uses. Every member must be an argument-free nominal or a primitive, whose
  /// encodings need no enclosing owner; absent otherwise or when two members share one runtime
  /// identity.
  pub effect fn canonicalUnionMembers(value: &Shared<Type>) -> Option<Vector<Shared<Type>>>
  ! OutOfMemoryError
  ? &mut Allocator {
    let count = Shared.with<Type, usize>(value, unionLength)
    if count == usize.MAX { return Option.none<Vector<Shared<Type>>>() }
    let mut members = Vector.make<Shared<Type>>()
    let mut encodings = Vector.make<Bytes>()
    let mut at = usize.ZERO
    while at < count {
      let part = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
        return unionMemberAt(node, at)
      })
      let member = match move part {
        Option<Shared<Type>>.Some {value: selected} => selected
        Option<Shared<Type>>.None => { return Option.none<Vector<Shared<Type>>>() }
      }
      let primitive = run Type.primitiveEncoding(&member)
      if let Option<Bytes>.Some {value: encoded} = move primitive {
        run Vector.append<Bytes>(&mut encodings, move encoded)
      } else {
        let closed = Shared.with<Type, bool>(&member, fn(node: &Type) -> bool {
          return match &node.* {
            Type.Nominal {arguments, ..} => Vector.length<Argument>(&arguments) == usize.ZERO
            _ => false
          }
        })
        if !closed { return Option.none<Vector<Shared<Type>>>() }
        let own = match move run copyNodeDeclaration(&member) {
          Option<DeclarationId>.Some {value: declaration} => declaration
          Option<DeclarationId>.None => { return Option.none<Vector<Shared<Type>>>() }
        }
        run Vector.append<Bytes>(&mut encodings, run Type.runtimeEncoding(&member, &own))
      }
      run Vector.append<Shared<Type>>(&mut members, move member)
      at = at + usize.ONE
    }
    let ranked = run RuntimeEncoding.order(&encodings)
    let positions = Vector.asSlice<usize>(&ranked)
    let listed = Vector.asSlice<Shared<Type>>(&members)
    let written = Vector.asSlice<Bytes>(&encodings)
    let mut canonical = Vector.make<Shared<Type>>()
    at = usize.ZERO
    while at < positions.length {
      if at > usize.ZERO && sameBytes(Bytes.asSlice(&written[positions[at]]), Bytes.asSlice(&written[positions[at - usize.ONE]])) {
        return Option.none<Vector<Shared<Type>>>()
      }
      run Vector.append<Shared<Type>>(&mut canonical, Shared.clone<Type>(&listed[positions[at]]))
      at = at + usize.ONE
    }
    return Option.some<Vector<Shared<Type>>>(move canonical)
  }
  /// A primitive's runtime encoding, which needs no owner: the same bytes runtimeEncoding gives it.
  effect fn primitiveEncoding(value: &Shared<Type>) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
    let node = run nodeCopy(value)
    if let Type.Primitive {name} = &node {
      let mut output = Bytes.make()
      run RuntimeEncoding.word(&mut output, usize.toU64(nodeKind(&node)))
      run RuntimeEncoding.field(&mut output, Bytes.asSlice(&name))
      return Option.some<Bytes>(move output)
    }
    return Option.none<Bytes>()
  }
  /// Whether a complete result mentions the opaque family owned by `producer`.
  pub effect fn containsOpaque(value: &Shared<Type>, producer: &DeclarationId) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    let here = Shared.with<Type, bool>(
      value,
      fn(node: &Type) -> bool {
        return match & node.* {
          Type.OpaqueRepresentation {producer: owner, ..} => DeclarationId.equals(&owner, producer)
          _ => false
        }
      },
    )
    if here {
      return true
    }
    let count = Shared.with<Type, usize>(value, childCount)
    let mut at = usize.ZERO
    while at < count {
      let child = Shared.with<Type, Option<Shared<Type>>>(
        value,
        fn(node: &Type) -> Option<Shared<Type>> { return childAt(node, at) },
      )
      if let Option<Shared<Type>>.Some {value: nested} = move child {
        if run Type.containsOpaque(&nested, producer) {
          return true
        }
      }
      at = at + usize.ONE
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        let member = memberOf(value, at)
        if let Option<Shared<Type>>.Some {value: nested} = move member {
          if run Type.containsOpaque(&nested, producer) {
            return true
          }
        }
        at = at + usize.ONE
      }
    }
    return false
  }
  /// Reports whether two shared types have the same semantic identity.
  ///
  /// # Details
  ///
  /// Allocation addresses are only a shortcut, never identity. Primitive names differ by spelling.
  /// A nominal application compares the kinds and values of its ordered arguments. Parameters
  /// compare declaration and ordinal; borrowed views compare their lifetime, access, and element
  /// type. Raw pointers compare their written qualifiers. Callables compare mode, safety,
  /// environment, and ordered signature; Effects compare run mode, environment, and channels.
  /// Unions and requirement rows compare as sets. Visibility does not change identity.
  ///
  /// # Gotchas
  ///
  /// Compare handles rather than borrowed values: after substitution one handle can occur at
  /// different depths on the two sides, and a held borrow cannot be entered again.
  pub effect fn equalsShared(left: &Shared<Type>, right: &Shared<Type>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    return run sameShared(left, right)
  }
  /// Compares runtime representation identities after erasing validity lifetimes only.
  /// Type arguments, requirement rows, and exact representation declarations remain distinct.
  pub effect fn runtimeEqualsShared(left: &Shared<Type>, right: &Shared<Type>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut projection = Vector.make<usize>()
    run Vector.append<usize>(&mut projection, usize.MAX - 2)
    return run sameUnder(left, right, Vector.asSlice<usize>(&projection))
  }
  /// Whether `part` is strictly nested in `whole` by a concrete type argument, field-like
  /// element, or union member. This is the structural descent accepted for witness recursion.
  pub effect fn strictRuntimeSubterm(part: &Shared<Type>, whole: &Shared<Type>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    let count = Shared.with<Type, usize>(whole, childCount)
    let mut at = usize.ZERO
    while at < count {
      let child = Shared.with<Type, Option<Shared<Type>>>(whole, fn(value: &Type) -> Option<Shared<Type>> {
        return childAt(value, at)
      })
      if let Option<Shared<Type>>.Some {value: nested} = move child {
        if run Type.runtimeEqualsShared(part, &nested) {
          return true
        }
        if run Type.strictRuntimeSubterm(part, &nested) {
          return true
        }
      }
      at = at + usize.ONE
    }
    let members = Shared.with<Type, usize>(whole, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        let child = memberOf(whole, at)
        if let Option<Shared<Type>>.Some {value: nested} = move child {
          if run Type.runtimeEqualsShared(part, &nested) {
            return true
          }
          if run Type.strictRuntimeSubterm(part, &nested) {
            return true
          }
        }
        at = at + usize.ONE
      }
    }
    return false
  }
  /// Reports whether every member of a narrower `witness` failure type is a member of `promised`.
  ///
  /// # Details
  ///
  /// A structural union contributes its members, `never` none, and any other type itself. Members
  /// compare by exact identity, so a failure parameter covers only that parameter.
  pub effect fn coversFailure(promised: &Shared<Type>, witness: &Shared<Type>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    let count = Shared.with<Type, usize>(witness, failureCount)
    let available = Shared.with<Type, usize>(promised, failureCount)
    let mut at = usize.ZERO
    while at < count {
      let member = failureMember(witness, at)
      let mut found = false
      let mut other = usize.ZERO
      while !found && other < available {
        let candidate = failureMember(promised, other)
        found = run sameShared(&candidate, &member)
        other = other + usize.ONE
      }
      if !found {
        return false
      }
      at = at + usize.ONE
    }
    return true
  }
  /// Compares two complete implementation heads up to binder spelling and owner identity.
  /// The caller supplies heads whose free parameters are owned by their respective impls and
  /// checks that both binder lists have the same shape. Unlike unification, this is an identity
  /// comparison: unions and rows are unordered sets, and callable binders are compared by bijection.
  pub effect fn alphaEquivalent(
    leftContract: &Shared<Type>,
    leftProvider: &Shared<Type>,
    rightContract: &Shared<Type>,
    rightProvider: &Shared<Type>,
    binderCount: usize,
  ) -> bool ! OutOfMemoryError ? &mut Allocator {
    let mut map = Vector.make<usize>()
    run Vector.append<usize>(&mut map, usize.MAX - usize.ONE)
    run Vector.append<usize>(&mut map, binderCount)
    let mut at = usize.ZERO
    while at < binderCount {
      run Vector.append<usize>(&mut map, usize.MAX)
      at = at + usize.ONE
    }
    return run assignHead(leftContract, leftProvider, rightContract, rightProvider, &mut map, usize.ZERO)
  }
  /// Compares the lifetime-erased shape of two ground subterms inside a coherence set.
  /// Callers establish that neither subterm contains a bindable parameter.
  pub effect fn projectEquals(left: &Shared<Type>, right: &Shared<Type>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut map = Vector.make<usize>()
    run Vector.append<usize>(&mut map, usize.MAX - 2)
    return run sameUnder(left, right, Vector.asSlice<usize>(&map))
  }
  /// Asks whether some assignment to the parameters owned by `variables` makes each left type equal
  /// to the right type at the same position, under one shared set of bindings.
  ///
  /// # Details
  ///
  /// A type, lifetime, or `?R` parameter is a variable exactly when its declaration is listed; any
  /// other parameter is rigid and equals only itself. `Distinct` at any position decides the whole
  /// answer; otherwise `Undetermined` at any position leaves it undecided. A variable binds only
  /// after an occurs check, so the bindings stay acyclic.
  ///
  /// `Projection` answers whether two conformance heads could name one goal: lifetimes are erased
  /// and unions and rows are decided on their containment fragment. It is never evidence that one
  /// type matches another. `Exact` compares lifetimes, binds variable lifetimes and rows, and
  /// matches a union only when equal or as one variable's whole value.
  ///
  /// # Gotchas
  ///
  /// The bindings grow only on `Unified`. Any other answer restores them to their length on entry,
  /// so a failed alternative leaves no partial assignment. Under `Projection`, set-absorbed
  /// variables receive no binding; the bindings then describe only the first-order part.
  pub effect fn unifyAll(
    left: &[Shared<Type>],
    right: &[Shared<Type>],
    variables: &[Shared<DeclarationId>],
    comparison: Comparison,
    bindings: &mut Vector<Binding>,
  ) -> Unification ! OutOfMemoryError ? &mut Allocator {
    if left.length != right.length {
      return Unification.Distinct
    }
    let mark = Vector.length<Binding>(&bindings.*)
    let mut absorbed = Vector.make<UnifySlot>()
    let mut result = Unification.Unified
    let mut at = usize.ZERO
    while at < left.length && !isDistinct(&result) {
      let compared = run unifyTerms(&left[at], &right[at], variables, comparison, &mut bindings.*, &mut absorbed)
      result = worse(&result, &compared)
      at = at + usize.ONE
    }
    if !isUnified(&result) {
      Vector.truncate<Binding>(&mut bindings.*, mark)
    }
    return move result
  }
  /// Asks [`Type.unifyAll`] about one pair of types.
  pub effect fn unify(
    left: &Shared<Type>,
    right: &Shared<Type>,
    variables: &[Shared<DeclarationId>],
    comparison: Comparison,
    bindings: &mut Vector<Binding>,
  ) -> Unification ! OutOfMemoryError ? &mut Allocator {
    let mut lefts = Vector.make<Shared<Type>>()
    run Vector.append<Shared<Type>>(&mut lefts, Shared.clone<Type>(left))
    let mut rights = Vector.make<Shared<Type>>()
    run Vector.append<Shared<Type>>(&mut rights, Shared.clone<Type>(right))
    return run Type.unifyAll(
      Vector.asSlice<Shared<Type>>(&lefts),
      Vector.asSlice<Shared<Type>>(&rights),
      variables,
      comparison,
      &mut bindings.*,
    )
  }
  /// Binds one still-open witness row to the promised operation's rigid row parameters.
  ///
  /// # Details
  ///
  /// Both inputs are Effect row carriers. Every fixed witness requirement must already be covered
  /// by a fixed promised requirement, including access. No fixed-key subtraction is inferred: the
  /// witness row receives exactly the promised row parameters, and the caller checks full row
  /// coverage after resolving that binding. This does not relax [`Type.unify`] Exact equality.
  pub effect fn bindWitnessResidual(
    promised: &Shared<Type>,
    witness: &Shared<Type>,
    variables: &[Shared<DeclarationId>],
    bindings: &mut Vector<Binding>,
  ) -> Unification ! OutOfMemoryError ? &mut Allocator {
    let promisedValue = Shared.with<Type, Option<Shared<Row>>>(promised, rowOf)
    let witnessValue = Shared.with<Type, Option<Shared<Row>>>(witness, rowOf)
    if let Option<Shared<Row>>.Some {value: promisedRow} = &promisedValue {
      if let Option<Shared<Row>>.Some {value: witnessRow} = &witnessValue {
        let mut promisedParts = UnifyRowParts {row: Row.empty(), open: Vector.make<UnifySlot>()}
        run flattenRow(
          &promisedRow,
          variables,
          Vector.asSlice<Binding>(&bindings.*),
          &mut promisedParts,
        )
        let mut witnessParts = UnifyRowParts {row: Row.empty(), open: Vector.make<UnifySlot>()}
        run flattenRow(
          &witnessRow,
          variables,
          Vector.asSlice<Binding>(&bindings.*),
          &mut witnessParts,
        )
        if Vector.length<UnifySlot>(&promisedParts.open) != usize.ZERO || Vector.length<UnifySlot>(
          &witnessParts.open,
        ) != usize.ONE || Vector.length<RowParameter>(&witnessParts.row.parameters) != usize.ZERO {
          return undetermined(witness)
        }
        let fixedPromised = run Shared.make<Row>(move promisedParts.row)
        let fixedWitness = run Shared.make<Row>(move witnessParts.row)
        if entriesOpen(
          &fixedPromised,
          variables,
          Vector.asSlice<Binding>(&bindings.*),
          Comparison.Exact,
        ) || entriesOpen(&fixedWitness, variables, Vector.asSlice<Binding>(&bindings.*), Comparison.Exact) {
          return undetermined(witness)
        }
        let covered = run entriesCovered(&fixedWitness, &fixedPromised, false, Comparison.Exact)
        if !isUnified(&covered) {
          return move covered
        }
        let mut residual = Row.empty()
        let parameters = Shared.with<Row, usize>(&fixedPromised, rowParameterCount)
        let mut at = usize.ZERO
        while at < parameters {
          let parameter = Shared.with<Row, RowParameter>(
            &fixedPromised,
            fn(value: &Row) -> RowParameter {
              return rowParameterAt(value, at)
            },
          )
          run Row.include(&mut residual, move parameter)
          at = at + usize.ONE
        }
        let open = Vector.asSlice<UnifySlot>(&witnessParts.open)
        let supplied = run Shared.make<Row>(move residual)
        run bindVariable(
          &open[usize.ZERO],
          Argument.Row {value: move supplied},
          variables,
          &mut bindings.*,
        )
        return Unification.Unified
      }
    }
    return undetermined(witness)
  }
  /// Reports whether `required` rewrites an argument that `declared` fixes: at some position both
  /// applications of the same nominal declaration write a type or row argument, the declared one
  /// mentions no type or `?R` parameter of `owner`, and the two differ once lifetimes are erased.
  pub effect fn changesFixedArgument(
    declared: &Shared<Type>,
    required: &Shared<Type>,
    owner: &DeclarationId,
  ) -> bool ! OutOfMemoryError ? &mut Allocator {
    let count = Shared.with<Type, usize>(declared, childCount)
    let none = Vector.make<Shared<DeclarationId>>()
    let mut at = usize.ZERO
    while at < count {
      let written = Shared.with<Type, Option<Shared<Type>>>(
        declared,
        fn(value: &Type) -> Option<Shared<Type>> {
          return childAt(value, at)
        },
      )
      let supplied = Shared.with<Type, Option<Shared<Type>>>(
        required,
        fn(value: &Type) -> Option<Shared<Type>> {
          return childAt(value, at)
        },
      )
      if let Option<Shared<Type>>.Some {value: fixed} = move written {
        if let Option<Shared<Type>>.Some {value: rewritten} = move supplied {
          if Type.occurrences(&fixed, owner, usize.MAX) == usize.ZERO {
            let mut bindings = Vector.make<Binding>()
            let same = run Type.unify(
              &fixed,
              &rewritten,
              Vector.asSlice<Shared<DeclarationId>>(&none),
              Comparison.Projection,
              &mut bindings,
            )
            if !isUnified(&same) {
              return true
            }
          }
        }
      }
      if let Option<Shared<Row>>.Some {value: fixedRow} = move argumentRowOf(declared, at) {
        if let Option<Shared<Row>>.Some {value: rewrittenRow} = move argumentRowOf(required, at) {
          if rowOccurrences(&fixedRow, owner, usize.MAX) == usize.ZERO && !run Row.equalsShared(
            &fixedRow,
            &rewrittenRow,
          ) {
            return true
          }
        }
      }
      at = at + usize.ONE
    }
    return false
  }
  /// Counts the occurrences of one type or `?R` parameter of `owner` in `value`, or of every such
  /// parameter when `ordinal` is `usize.MAX`, including inside union members and requirement rows.
  /// Lifetimes are not counted.
  pub fn occurrences(value: &Shared<Type>, owner: &DeclarationId, ordinal: usize) -> usize {
    let own = Shared.with<Type, usize>(
      value,
      fn(node: &Type) -> usize {
        return Type.parameterOrdinalOf(node, owner)
      },
    )
    if own != usize.MAX {
      if ordinal == usize.MAX || own == ordinal {
        return usize.ONE
      }
      return usize.ZERO
    }
    let mut count = usize.ZERO
    let children = Shared.with<Type, usize>(value, childCount)
    let mut at = usize.ZERO
    while at < children {
      let child = Shared.with<Type, Option<Shared<Type>>>(
        value,
        fn(node: &Type) -> Option<Shared<Type>> {
          return childAt(node, at)
        },
      )
      if let Option<Shared<Type>>.Some {value: nested} = move child {
        count = count + Type.occurrences(&nested, owner, ordinal)
      }
      if let Option<Shared<Row>>.Some {value: supplied} = move argumentRowOf(value, at) {
        count = count + rowOccurrences(&supplied, owner, ordinal)
      }
      at = at + usize.ONE
    }
    let members = Shared.with<Type, usize>(value, unionLength)
    if members != usize.MAX {
      at = usize.ZERO
      while at < members {
        if let Option<Shared<Type>>.Some {value: member} = move unionMember(value, at) {
          count = count + Type.occurrences(&member, owner, ordinal)
        }
        at = at + usize.ONE
      }
    }
    let requirementsFound = Shared.with<Type, Option<Shared<Row>>>(value, rowOf)
    if let Option<Shared<Row>>.Some {value: requirements} = move requirementsFound {
      count = count + rowOccurrences(&requirements, owner, ordinal)
    }
    return count
  }
}

// Compares one level: the variant, spellings, declarations, ordinals, access, qualifiers, modes,
// lifetimes, extents, and child counts. Child types and rows are compared by the caller.
fn sameHead(first: &Type, second: &Type, map: &[usize]) -> bool {
  return match & first.* {
    Type.Primitive {name} => match & second.* {
      Type.Primitive {name: compared} => sameBytes(Bytes.asSlice(&name), Bytes.asSlice(&compared))
      _ => false
    }
    Type.Unit => match & second.* {
      Type.Unit => true
      _ => false
    }
    Type.Nominal {declaration, arguments, ..} => match & second.* {
      Type.Nominal {declaration: compared, arguments: otherArguments, ..} => {
        if !DeclarationId.equals(&declaration, &compared) {
          return false
        }
        let firstArguments = Vector.asSlice<Argument>(&arguments)
        let secondArguments = Vector.asSlice<Argument>(&otherArguments)
        if firstArguments.length != secondArguments.length {
          return false
        }
        let mut at = usize.ZERO
        while at < firstArguments.length {
          if !sameArgumentHead(&firstArguments[at], &secondArguments[at], map) {
            return false
          }
          at = at + usize.ONE
        }
        return true
      }
      _ => false
    }
    Type.NamedRepresentation {declaration, arguments, ..} => match & second.* {
      Type.NamedRepresentation {declaration: compared, arguments: otherArguments, ..} => {
        if !DeclarationId.equals(&declaration, &compared) {
          return false
        }
        let firstArguments = Vector.asSlice<Argument>(&arguments)
        let secondArguments = Vector.asSlice<Argument>(&otherArguments)
        if firstArguments.length != secondArguments.length {
          return false
        }
        let mut at = usize.ZERO
        while at < firstArguments.length {
          if !sameArgumentHead(&firstArguments[at], &secondArguments[at], map) {
            return false
          }
          at = at + usize.ONE
        }
        return true
      }
      _ => false
    }
    Type.OpaqueRepresentation {producer, arguments, ..} => match & second.* {
      Type.OpaqueRepresentation {producer: compared, arguments: otherArguments, ..} => {
        if !DeclarationId.equals(&producer, &compared) {
          return false
        }
        let firstArguments = Vector.asSlice<Argument>(&arguments)
        let secondArguments = Vector.asSlice<Argument>(&otherArguments)
        if firstArguments.length != secondArguments.length {
          return false
        }
        let mut at = usize.ZERO
        while at < firstArguments.length {
          if !sameArgumentHead(&firstArguments[at], &secondArguments[at], map) {
            return false
          }
          at = at + usize.ONE
        }
        return true
      }
      _ => false
    }
    Type.Parameter {declaration, ordinal} => match & second.* {
      Type.Parameter {declaration: compared, ordinal: otherOrdinal} => {
        if alphaMap(map) {
          return binderCompatible(map, ordinal, otherOrdinal)
        }
        return DeclarationId.equals(&declaration, &compared) && ordinal == otherOrdinal
      }
      _ => false
    }
    Type.String {lifetime} => match & second.* {
      Type.String {lifetime: compared} => sameLifetime(&lifetime, &compared, map)
      _ => false
    }
    Type.Reference {access, lifetime, ..} => match & second.* {
      Type.Reference {access: otherAccess, lifetime: otherLifetime, ..} => sameAccess(
        access,
        otherAccess,
      ) && sameLifetime(&lifetime, &otherLifetime, map)
      _ => false
    }
    Type.Slice {access, lifetime, ..} => match & second.* {
      Type.Slice {access: otherAccess, lifetime: otherLifetime, ..} => sameAccess(
        access,
        otherAccess,
      ) && sameLifetime(&lifetime, &otherLifetime, map)
      _ => false
    }
    Type.Pointer {access, nullable, multiplicity, alignment, ..} => match & second.* {
      Type.Pointer {
        access: otherAccess,
        nullable: otherNullable,
        multiplicity: otherMultiplicity,
        alignment: otherAlignment,
        ..,
      } => sameAccess(access, otherAccess) && nullable == otherNullable && sameMultiplicity(
        multiplicity,
        otherMultiplicity,
      ) && sameAlignment(&alignment, &otherAlignment)
      _ => false
    }
    Type.Array {extent, ..} => match & second.* {
      Type.Array {extent: otherExtent, ..} => sameBytes(
        Bytes.asSlice(&extent),
        Bytes.asSlice(&otherExtent),
      )
      _ => false
    }
    Type.Union {members} => match & second.* {
      Type.Union {members: compared} => Vector.length<Shared<Type>>(&members) == Vector.length<Shared<Type>>(&compared)
      _ => false
    }
    Type.Callable {mode, isUnsafe, environment, invocationBinders, invocationBounds, parameters, ..} => match & second.* {
      Type.Callable {
        mode: otherMode,
        isUnsafe: otherUnsafe,
        environment: otherEnvironment,
        invocationBinders: otherBinders,
        invocationBounds: otherBounds,
        parameters: otherParameters,
        ..,
      } => sameMode(mode, otherMode) && isUnsafe == otherUnsafe && (projectionMap(map) || (invocationBinders == otherBinders && sameEnvironment(
        &environment,
        &otherEnvironment,
        map,
      ) && sameOutlives(&invocationBounds, &otherBounds, map))) && Vector.length<Shared<Type>>(
        &parameters,
      ) == Vector.length<Shared<Type>>(&otherParameters)
      _ => false
    }
    Type.Effect {mode, environment, ..} => match & second.* {
      Type.Effect {mode: otherMode, environment: otherEnvironment, ..} => sameMode(mode, otherMode) && (projectionMap(map) || sameEnvironment(
        &environment,
        &otherEnvironment,
        map,
      ))
      _ => false
    }
    Type.TypeDescriptor {..} => match & second.* {
      Type.TypeDescriptor {..} => true
      _ => false
    }
    Type.Anonymous {occurrence, members} => match & second.* {
      Type.Anonymous {occurrence: compared, members: otherMembers} => Vector.length<Shared<Type>>(&members) == Vector.length<Shared<Type>>(&otherMembers) && AnonymousOccurrence.equalsShared(&occurrence, &compared)
      _ => false
    }
  }
}

/// How [`Type.unify`] treats lifetimes and structural sets.
pub enum Comparison {
  /// The lifetime-erased projection used only to ask whether two conformance heads could name one
  /// goal. Lifetimes, callable environments, and invocation binders are skipped and never bound; an
  /// open union or row is decided only on its containment fragment. Never evidence for selection.
  Projection,
  /// Exact evidence. A variable lifetime or `?R` binds; any other lifetime or closed row must be
  /// equal; a union matches only when equal or as the whole value of one variable.
  Exact,
}

/// The answer of one [`Type.unify`].
pub union Unification {
  /// Some assignment to the variables makes both sides equal; the bindings record one such.
  Unified,
  /// No assignment to the variables makes both sides equal.
  Distinct,
  /// The question is outside what this comparison decides; `at` is the undecided subterm.
  Undetermined {pub at: Shared<Type>},
}

/// One variable assignment recorded by [`Type.unify`].
pub struct Binding {
  /// The declaration that binds the variable.
  pub declaration: Shared<DeclarationId>
  /// The variable's position in its owner's complete binder list.
  pub ordinal: usize
  /// The assigned type, lifetime, or requirement row.
  pub value: Argument
}

// One variable, as its owner's index in the variable list and its binder ordinal; `owner` is
// `usize.MAX` for anything that is not a variable.
struct UnifySlot {
  owner: usize
  ordinal: usize
}

impl Copy for UnifySlot {}

fn noSlot() -> UnifySlot {
  return UnifySlot {owner: usize.MAX, ordinal: usize.MAX}
}

fn sameSlot(left: &UnifySlot, right: &UnifySlot) -> bool {
  return left.owner == right.owner && left.ordinal == right.ordinal
}

fn slotOf(declaration: &DeclarationId, ordinal: usize, variables: &[Shared<DeclarationId>]) -> UnifySlot {
  let mut at = usize.ZERO
  while at < variables.length {
    if declarationWith(declaration, &variables[at]) {
      return UnifySlot {owner: at, ordinal: ordinal}
    }
    at = at + usize.ONE
  }
  return noSlot()
}

fn typeSlot(value: &Type, variables: &[Shared<DeclarationId>]) -> UnifySlot {
  if let Type.Parameter {declaration, ordinal} = &value.* {
    return slotOf(&declaration, ordinal, variables)
  }
  return noSlot()
}

fn lifetimeSlot(value: &Lifetime, variables: &[Shared<DeclarationId>]) -> UnifySlot {
  if let Lifetime.Parameter {declaration, ordinal} = &value.* {
    return slotOf(&declaration, ordinal, variables)
  }
  return noSlot()
}

// Row parameters hold shared declarations, which may be the very handles listed as variables, so
// they are compared with the address-first `sameDeclaration`.
fn rowParameterSlot(row: &Row, at: usize, variables: &[Shared<DeclarationId>]) -> UnifySlot {
  let parameters = Vector.asSlice<RowParameter>(&row.parameters)
  let mut owner = usize.ZERO
  while owner < variables.length {
    if sameDeclaration(&parameters[at].declaration, &variables[owner]) {
      return UnifySlot {owner: owner, ordinal: parameters[at].ordinal}
    }
    owner = owner + usize.ONE
  }
  return noSlot()
}

fn rowParameterAt(row: &Row, at: usize) -> RowParameter {
  let parameters = Vector.asSlice<RowParameter>(&row.parameters)
  return RowParameter {
    declaration: Shared.clone<DeclarationId>(&parameters[at].declaration),
    ordinal: parameters[at].ordinal,
  }
}

fn rowParameterCount(row: &Row) -> usize {
  return Vector.length<RowParameter>(&row.parameters)
}

fn rowEntryCount(row: &Row) -> usize {
  return Vector.length<Requirement>(&row.entries)
}

fn bindingAt(bindings: &[Binding], variables: &[Shared<DeclarationId>], slot: &UnifySlot) -> usize {
  let mut at = usize.ZERO
  while at < bindings.length {
    if bindings[at].ordinal == slot.ordinal && sameDeclaration(
      &bindings[at].declaration,
      &variables[slot.owner],
    ) {
      return at
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn hasSlot(slots: &[UnifySlot], slot: &UnifySlot) -> bool {
  let mut at = usize.ZERO
  while at < slots.length {
    if sameSlot(&slots[at], slot) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn larger(left: usize, right: usize) -> usize {
  if right > left {
    return right
  }
  return left
}

fn rank(value: &Unification) -> usize {
  return match & value.* {
    Unification.Unified => usize.ZERO
    Unification.Undetermined {..} => usize.ONE
    Unification.Distinct => 2
  }
}

fn isUnified(value: &Unification) -> bool {
  return rank(value) == usize.ZERO
}

fn isDistinct(value: &Unification) -> bool {
  return rank(value) == 2
}

// A definite mismatch anywhere decides the whole comparison: further constraints only remove
// solutions. Otherwise an undecided position keeps the whole comparison undecided.
fn copyUnification(value: &Unification) -> Unification {
  return match & value.* {
    Unification.Unified => Unification.Unified
    Unification.Distinct => Unification.Distinct
    Unification.Undetermined {at} => undetermined(&at)
  }
}

fn worse(current: &Unification, next: &Unification) -> Unification {
  if rank(next) > rank(current) {
    return copyUnification(next)
  }
  return copyUnification(current)
}

fn undetermined(at: &Shared<Type>) -> Unification {
  return Unification.Undetermined {at: Shared.clone<Type>(at)}
}

// Follows type bindings until the term is not a bound variable. Bindings are acyclic because each
// is made only after an occurs check.
fn resolvedType(term: &Shared<Type>, variables: &[Shared<DeclarationId>], bindings: &[Binding]) -> Shared<Type> {
  let mut current = Shared.clone<Type>(term)
  while true {
    let slot = Shared.with<Type, UnifySlot>(
      &current,
      fn(value: &Type) -> UnifySlot {
        return typeSlot(value, variables)
      },
    )
    if slot.owner == usize.MAX {
      return move current
    }
    let at = bindingAt(bindings, variables, &slot)
    if at == usize.MAX {
      return move current
    }
    let next = match & bindings[at].value {
      Argument.Type {value} => Shared.clone<Type>(&value)
      _ => {
        return move current
      }
    }
    current = move next
  }
  return move current
}

fn resolvedLifetime(
  term: &Shared<Lifetime>,
  variables: &[Shared<DeclarationId>],
  bindings: &[Binding],
) -> Shared<Lifetime> {
  let mut current = Shared.clone<Lifetime>(term)
  while true {
    let slot = Shared.with<Lifetime, UnifySlot>(
      &current,
      fn(value: &Lifetime) -> UnifySlot {
        return lifetimeSlot(value, variables)
      },
    )
    if slot.owner == usize.MAX {
      return move current
    }
    let at = bindingAt(bindings, variables, &slot)
    if at == usize.MAX {
      return move current
    }
    let next = match & bindings[at].value {
      Argument.Lifetime {value} => Shared.clone<Lifetime>(&value)
      _ => {
        return move current
      }
    }
    current = move next
  }
  return move current
}

fn unionMember(value: &Shared<Type>, at: usize) -> Option<Shared<Type>> {
  return memberOf(value, at)
}

// How `slot` occurs in `term` once bindings are followed: zero when absent, one when only as a
// structural part, two when inside a union member or requirement row, where a set could absorb it.
fn occurrence(term: &Shared<Type>, slot: &UnifySlot, variables: &[Shared<DeclarationId>], bindings: &[Binding]) -> usize {
  let current = resolvedType(term, variables, bindings)
  let here = Shared.with<Type, UnifySlot>(
    &current,
    fn(value: &Type) -> UnifySlot {
      return typeSlot(value, variables)
    },
  )
  if sameSlot(&here, slot) {
    return usize.ONE
  }
  let mut found = usize.ZERO
  let count = Shared.with<Type, usize>(&current, childCount)
  let mut at = usize.ZERO
  while at < count {
    let child = Shared.with<Type, Option<Shared<Type>>>(
      &current,
      fn(value: &Type) -> Option<Shared<Type>> {
        return childAt(value, at)
      },
    )
    if let Option<Shared<Type>>.Some {value: nested} = move child {
      found = larger(found, occurrence(&nested, slot, variables, bindings))
    }
    if let Option<Shared<Row>>.Some {value: supplied} = move argumentRowOf(&current, at) {
      if rowMentions(&supplied, slot, variables, bindings) {
        found = 2
      }
    }
    at = at + usize.ONE
  }
  let members = Shared.with<Type, usize>(&current, unionLength)
  if members != usize.MAX {
    at = usize.ZERO
    while at < members {
      if let Option<Shared<Type>>.Some {value: member} = move unionMember(&current, at) {
        if occurrence(&member, slot, variables, bindings) > usize.ZERO {
          found = 2
        }
      }
      at = at + usize.ONE
    }
  }
  let requirementsFound = Shared.with<Type, Option<Shared<Row>>>(&current, rowOf)
  if let Option<Shared<Row>>.Some {value: requirements} = move requirementsFound {
    if rowMentions(&requirements, slot, variables, bindings) {
      found = 2
    }
  }
  return found
}

// Whether a row mentions `slot` as a row parameter or inside an entry, following bound rows.
fn rowMentions(row: &Shared<Row>, slot: &UnifySlot, variables: &[Shared<DeclarationId>], bindings: &[Binding]) -> bool {
  let entries = Shared.with<Row, usize>(row, rowEntryCount)
  let mut at = usize.ZERO
  while at < entries {
    let entry = entryAt(row, at)
    if occurrence(&entry.capability, slot, variables, bindings) > usize.ZERO {
      return true
    }
    if let Option<Shared<Type>>.Some {value: roleValue} = &entry.roleType {
      if occurrence(&roleValue, slot, variables, bindings) > usize.ZERO {
        return true
      }
    }
    at = at + usize.ONE
  }
  let parameters = Shared.with<Row, usize>(row, rowParameterCount)
  at = usize.ZERO
  while at < parameters {
    let here = Shared.with<Row, UnifySlot>(
      row,
      fn(value: &Row) -> UnifySlot {
        return rowParameterSlot(value, at, variables)
      },
    )
    if sameSlot(&here, slot) {
      return true
    }
    if here.owner != usize.MAX {
      let bound = bindingAt(bindings, variables, &here)
      if bound != usize.MAX {
        if let Argument.Row {value: supplied} = &bindings[bound].value {
          if rowMentions(&supplied, slot, variables, bindings) {
            return true
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Whether a term still mentions an unbound variable once bindings are followed. Exact comparison
// also counts variable lifetimes, which the projection never binds.
fn hasVariable(
  term: &Shared<Type>,
  variables: &[Shared<DeclarationId>],
  bindings: &[Binding],
  comparison: Comparison,
) -> bool {
  let current = resolvedType(term, variables, bindings)
  let here = Shared.with<Type, UnifySlot>(
    &current,
    fn(value: &Type) -> UnifySlot {
      return typeSlot(value, variables)
    },
  )
  if here.owner != usize.MAX {
    return true
  }
  if comparison == Comparison.Exact {
    let regions = Shared.with<Type, usize>(&current, comparedLifetimeCount)
    let mut region = usize.ZERO
    while region < regions {
      let found = Shared.with<Type, Option<Shared<Lifetime>>>(
        &current,
        fn(value: &Type) -> Option<Shared<Lifetime>> {
          return comparedLifetimeAt(value, region)
        },
      )
      if let Option<Shared<Lifetime>>.Some {value: lifetime} = move found {
        let resolved = resolvedLifetime(&lifetime, variables, bindings)
        let slot = Shared.with<Lifetime, UnifySlot>(
          &resolved,
          fn(value: &Lifetime) -> UnifySlot {
            return lifetimeSlot(value, variables)
          },
        )
        if slot.owner != usize.MAX {
          return true
        }
      }
      region = region + usize.ONE
    }
    // Matching invocation binders is a later exact-matching step. Keep a quantified
    // callable undecided in a set or row even when none of its lifetimes is an impl variable.
    let quantified = Shared.with<Type, bool>(
      &current,
      fn(value: &Type) -> bool {
        return match & value.* {
          Type.Callable {invocationBinders, ..} => invocationBinders > usize.ZERO
          _ => false
        }
      },
    )
    if quantified {
      return true
    }
  }
  let count = Shared.with<Type, usize>(&current, childCount)
  let mut at = usize.ZERO
  while at < count {
    let child = Shared.with<Type, Option<Shared<Type>>>(
      &current,
      fn(value: &Type) -> Option<Shared<Type>> {
        return childAt(value, at)
      },
    )
    if let Option<Shared<Type>>.Some {value: nested} = move child {
      if hasVariable(&nested, variables, bindings, comparison) {
        return true
      }
    }
    if let Option<Shared<Row>>.Some {value: supplied} = move argumentRowOf(&current, at) {
      if rowHasVariable(&supplied, variables, bindings, comparison) {
        return true
      }
    }
    at = at + usize.ONE
  }
  let members = Shared.with<Type, usize>(&current, unionLength)
  if members != usize.MAX {
    at = usize.ZERO
    while at < members {
      if let Option<Shared<Type>>.Some {value: member} = move unionMember(&current, at) {
        if hasVariable(&member, variables, bindings, comparison) {
          return true
        }
      }
      at = at + usize.ONE
    }
  }
  let requirementsFound = Shared.with<Type, Option<Shared<Row>>>(&current, rowOf)
  if let Option<Shared<Row>>.Some {value: requirements} = move requirementsFound {
    return rowHasVariable(&requirements, variables, bindings, comparison)
  }
  return false
}

fn rowHasVariable(
  row: &Shared<Row>,
  variables: &[Shared<DeclarationId>],
  bindings: &[Binding],
  comparison: Comparison,
) -> bool {
  let entries = Shared.with<Row, usize>(row, rowEntryCount)
  let mut at = usize.ZERO
  while at < entries {
    let entry = entryAt(row, at)
    if hasVariable(&entry.capability, variables, bindings, comparison) {
      return true
    }
    if let Option<Shared<Type>>.Some {value: roleValue} = &entry.roleType {
      if hasVariable(&roleValue, variables, bindings, comparison) {
        return true
      }
    }
    at = at + usize.ONE
  }
  let parameters = Shared.with<Row, usize>(row, rowParameterCount)
  at = usize.ZERO
  while at < parameters {
    let here = Shared.with<Row, UnifySlot>(
      row,
      fn(value: &Row) -> UnifySlot {
        return rowParameterSlot(value, at, variables)
      },
    )
    if here.owner != usize.MAX {
      let bound = bindingAt(bindings, variables, &here)
      if bound == usize.MAX {
        return true
      }
      if let Argument.Row {value: supplied} = &bindings[bound].value {
        if rowHasVariable(&supplied, variables, bindings, comparison) {
          return true
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Compares one level without any lifetime: the variant, spellings, declarations, argument kinds,
// accesses, qualifiers, modes, extents, and child counts.
fn sameShape(first: &Type, second: &Type) -> bool {
  return match & first.* {
    Type.Nominal {declaration, arguments, ..} => match & second.* {
      Type.Nominal {declaration: compared, arguments: otherArguments, ..} => {
        if !DeclarationId.equals(&declaration, &compared) {
          return false
        }
        let firstArguments = Vector.asSlice<Argument>(&arguments)
        let secondArguments = Vector.asSlice<Argument>(&otherArguments)
        if firstArguments.length != secondArguments.length {
          return false
        }
        let mut at = usize.ZERO
        while at < firstArguments.length {
          if argumentKind(&firstArguments[at]) != argumentKind(&secondArguments[at]) {
            return false
          }
          at = at + usize.ONE
        }
        return true
      }
      _ => false
    }
    Type.String {..} => match & second.* {
      Type.String {..} => true
      _ => false
    }
    Type.Reference {access, ..} => match & second.* {
      Type.Reference {access: otherAccess, ..} => sameAccess(access, otherAccess)
      _ => false
    }
    Type.Slice {access, ..} => match & second.* {
      Type.Slice {access: otherAccess, ..} => sameAccess(access, otherAccess)
      _ => false
    }
    Type.Callable {mode, isUnsafe, parameters, ..} => match & second.* {
      Type.Callable {mode: otherMode, isUnsafe: otherUnsafe, parameters: otherParameters, ..} => sameMode(
        mode,
        otherMode,
      ) && isUnsafe == otherUnsafe && Vector.length<Shared<Type>>(&parameters) == Vector.length<Shared<Type>>(&otherParameters)
      _ => false
    }
    Type.Effect {mode, ..} => match & second.* {
      Type.Effect {mode: otherMode, ..} => sameMode(mode, otherMode)
      _ => false
    }
    _ => {
      let none = Vector.make<usize>()
      return sameHead(first, second, Vector.asSlice<usize>(&none))
    }
  }
}

fn argumentKind(value: &Argument) -> usize {
  return match & value.* {
    Argument.Type {..} => usize.ZERO
    Argument.Lifetime {..} => usize.ONE
    Argument.Row {..} => 2
  }
}

fn shapeWith(first: &Type, right: &Shared<Type>) -> bool {
  return Shared.with<Type, bool>(
    right,
    fn(second: &Type) -> bool {
      return sameShape(first, second)
    },
  )
}

fn isExecutable(value: &Type) -> bool {
  return match & value.* {
    Type.Callable {..} => true
    Type.Effect {..} => true
    _ => false
  }
}

// Exact comparison of an executable's invocation binders, outlives bounds, and environment.
// Invocation ordinals are canonical first-occurrence positions, so equal ordinals are the
// binder bijection for two otherwise equal executable contracts.
fn plainExecutable(first: &Type, second: &Type) -> bool {
  let none = Vector.make<usize>()
  let map = Vector.asSlice<usize>(&none)
  return match & first.* {
    Type.Callable {invocationBinders, invocationBounds, environment, ..} => match & second.* {
      Type.Callable {
        invocationBinders: otherBinders,
        invocationBounds: otherBounds,
        environment: otherEnvironment,
        ..,
      } => invocationBinders == otherBinders && sameOutlives(
        &invocationBounds,
        &otherBounds,
        map,
      ) && sameEnvironment(&environment, &otherEnvironment, map)
      _ => false
    }
    Type.Effect {environment, ..} => match & second.* {
      Type.Effect {environment: otherEnvironment, ..} => sameEnvironment(
        &environment,
        &otherEnvironment,
        map,
      )
      _ => false
    }
    _ => true
  }
}

fn plainExecutableWith(first: &Type, right: &Shared<Type>) -> bool {
  return Shared.with<Type, bool>(right, fn(second: &Type) -> bool {
    return plainExecutable(first, second)
  })
}

effect fn bindVariable(
  slot: &UnifySlot,
  value: Argument,
  variables: &[Shared<DeclarationId>],
  bindings: &mut Vector<Binding>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  run Vector.append<Binding>(
    &mut bindings.*,
    Binding {
      declaration: Shared.clone<DeclarationId>(&variables[slot.owner]),
      ordinal: slot.ordinal,
      value: move value,
    },
  )
  return ()
}

// Binds a type variable after the occurs check. An occurrence only as a structural part has no
// finite solution; one inside a union or row could be absorbed by that set, so it is undecided.
effect fn bindType(
  slot: &UnifySlot,
  term: &Shared<Type>,
  variables: &[Shared<DeclarationId>],
  bindings: &mut Vector<Binding>,
  absorbed: &[UnifySlot],
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  if hasSlot(absorbed, slot) {
    return undetermined(term)
  }
  let occurs = occurrence(term, slot, variables, Vector.asSlice<Binding>(&bindings.*))
  if occurs == usize.ONE {
    return Unification.Distinct
  }
  if occurs == 2 {
    return undetermined(term)
  }
  run bindVariable(slot, Argument.Type {value: Shared.clone<Type>(term)}, variables, &mut bindings.*)
  return Unification.Unified
}

effect fn unifyLifetimes(
  left: &Shared<Lifetime>,
  right: &Shared<Lifetime>,
  at: &Shared<Type>,
  variables: &[Shared<DeclarationId>],
  bindings: &mut Vector<Binding>,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let first = resolvedLifetime(left, variables, Vector.asSlice<Binding>(&bindings.*))
  let second = resolvedLifetime(right, variables, Vector.asSlice<Binding>(&bindings.*))
  let firstSlot = Shared.with<Lifetime, UnifySlot>(
    &first,
    fn(value: &Lifetime) -> UnifySlot {
      return lifetimeSlot(value, variables)
    },
  )
  let secondSlot = Shared.with<Lifetime, UnifySlot>(
    &second,
    fn(value: &Lifetime) -> UnifySlot {
      return lifetimeSlot(value, variables)
    },
  )
  if firstSlot.owner != usize.MAX {
    if !sameSlot(&firstSlot, &secondSlot) {
      run bindVariable(&firstSlot, Argument.Lifetime {value: move second}, variables, &mut bindings.*)
    }
    return Unification.Unified
  }
  if secondSlot.owner != usize.MAX {
    run bindVariable(&secondSlot, Argument.Lifetime {value: move first}, variables, &mut bindings.*)
    return Unification.Unified
  }
  let firstInvocation = Shared.with<Lifetime, usize>(&first, invocationOrdinal)
  let secondInvocation = Shared.with<Lifetime, usize>(&second, invocationOrdinal)
  if firstInvocation != usize.MAX || secondInvocation != usize.MAX {
    if firstInvocation == secondInvocation {
      return Unification.Unified
    }
    return Unification.Distinct
  }
  if Lifetime.equalsShared(&first, &second) {
    return Unification.Unified
  }
  return Unification.Distinct
}

// A union or single type as a list of set members.
effect fn setMembers(value: &Shared<Type>) -> Vector<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  let members = Shared.with<Type, usize>(value, unionLength)
  let mut listed = Vector.make<Shared<Type>>()
  if members == usize.MAX {
    run Vector.append<Shared<Type>>(&mut listed, Shared.clone<Type>(value))
    return move listed
  }
  let mut at = usize.ZERO
  while at < members {
    if let Option<Shared<Type>>.Some {value: member} = move unionMember(value, at) {
      run Vector.append<Shared<Type>>(&mut listed, move member)
    }
    at = at + usize.ONE
  }
  return move listed
}

// Every member of `members` equals some member of `candidates`. Both sides are free of unbound
// variables, so no comparison binds.
effect fn setIncluded(
  members: &[Shared<Type>],
  candidates: &[Shared<Type>],
  comparison: Comparison,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let mut result = Unification.Unified
  let mut at = usize.ZERO
  while at < members.length {
    let mut found = Unification.Distinct
    let mut other = usize.ZERO
    while !isUnified(&found) && other < candidates.length {
      let mut equal = false
      if comparison == Comparison.Projection {
        equal = run Type.projectEquals(&members[at], &candidates[other])
      } else {
        equal = run Type.equalsShared(&members[at], &candidates[other])
      }
      if equal {
        found = Unification.Unified
      }
      other = other + usize.ONE
    }
    result = worse(&result, &found)
    if isDistinct(&result) {
      return move result
    }
    at = at + usize.ONE
  }
  return move result
}

// A set member can contain a bindable parameter. Try source-independent pairings under one shared
// assignment, restoring both bindings and absorbed-set marks after every failed alternative.
// A successful pairing proves overlap or exact equality; callers retain Undetermined for a failed
// search because later substitution can collapse distinct written members into one set member.
effect fn matchSetPermutation(
  left: &[Shared<Type>],
  right: &[Shared<Type>],
  variables: &[Shared<DeclarationId>],
  comparison: Comparison,
  bindings: &mut Vector<Binding>,
  absorbed: &mut Vector<UnifySlot>,
  used: &mut Vector<bool>,
  at: usize,
  site: &Shared<Type>,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  if at == left.length {
    return Unification.Unified
  }
  let mut uncertain = false
  let mut candidate = usize.ZERO
  while candidate < right.length {
    if !Vector.asSlice<bool>(&used.*)[candidate] {
      let bindingMark = Vector.length<Binding>(&bindings.*)
      let absorbedMark = Vector.length<UnifySlot>(&absorbed.*)
      let compared = run unifyTerms(
        &left[at],
        &right[candidate],
        variables,
        comparison,
        &mut bindings.*,
        &mut absorbed.*,
      )
      if isUnified(&compared) {
        Vector.set<bool>(&mut used.*, candidate, true)
        let matched = run matchSetPermutation(
          left,
          right,
          variables,
          comparison,
          &mut bindings.*,
          &mut absorbed.*,
          &mut used.*,
          at + usize.ONE,
          site,
        )
        Vector.set<bool>(&mut used.*, candidate, false)
        if isUnified(&matched) {
          return move matched
        }
        if !isDistinct(&matched) {
          uncertain = true
        }
      } else if !isDistinct(&compared) {
        uncertain = true
      }
      Vector.truncate<Binding>(&mut bindings.*, bindingMark)
      Vector.truncate<UnifySlot>(&mut absorbed.*, absorbedMark)
    }
    candidate = candidate + usize.ONE
  }
  if uncertain {
    return undetermined(site)
  }
  return Unification.Distinct
}

fn hasBareSetVariable(
  members: &[Shared<Type>],
  variables: &[Shared<DeclarationId>],
  bindings: &[Binding],
) -> bool {
  let mut at = usize.ZERO
  while at < members.length {
    let member = resolvedType(&members[at], variables, bindings)
    let slot = Shared.with<Type, UnifySlot>(
      &member,
      fn(value: &Type) -> UnifySlot {
        return typeSlot(value, variables)
      },
    )
    if slot.owner != usize.MAX {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

effect fn setMayCollapse(
  members: &[Shared<Type>],
  variables: &[Shared<DeclarationId>],
  bindings: &mut Vector<Binding>,
  absorbed: &mut Vector<UnifySlot>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < members.length {
    let mut other = at + usize.ONE
    while other < members.length {
      let bindingMark = Vector.length<Binding>(&bindings.*)
      let absorbedMark = Vector.length<UnifySlot>(&absorbed.*)
      let compared = run unifyTerms(
        &members[at],
        &members[other],
        variables,
        Comparison.Projection,
        &mut bindings.*,
        &mut absorbed.*,
      )
      Vector.truncate<Binding>(&mut bindings.*, bindingMark)
      Vector.truncate<UnifySlot>(&mut absorbed.*, absorbedMark)
      if !isDistinct(&compared) {
        return true
      }
      other = other + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

// Unions compare as sets. Equal closed sets are decided exactly. The projection also decides the
// containment fragment: every member is either free of variables or a bare, still unbound variable
// seen by no other position. Such a side covers exactly the sets containing its fixed members, so
// one open side matches a closed set iff its fixed members are all in that set, and two open sides
// always match. The variables are then absorbed and may not be bound later. Nested variables can
// also prove a same-size pairing under one assignment. An unsuccessful pairing remains undecided
// because substitution can change the normalized set size; every other open set under exact
// comparison is likewise undecided.
effect fn unifySets(
  first: &Shared<Type>,
  second: &Shared<Type>,
  variables: &[Shared<DeclarationId>],
  comparison: Comparison,
  bindings: &mut Vector<Binding>,
  absorbed: &mut Vector<UnifySlot>,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let firstMembers = run setMembers(first)
  let secondMembers = run setMembers(second)
  let mut firstFixed = Vector.make<Shared<Type>>()
  let mut secondFixed = Vector.make<Shared<Type>>()
  let mut firstOpen = Vector.make<UnifySlot>()
  let mut secondOpen = Vector.make<UnifySlot>()
  let firstSplit = run splitSet(
    Vector.asSlice<Shared<Type>>(&firstMembers),
    variables,
    comparison,
    Vector.asSlice<Binding>(&bindings.*),
    Vector.asSlice<UnifySlot>(&absorbed.*),
    &mut firstFixed,
    &mut firstOpen,
  )
  let secondSplit = run splitSet(
    Vector.asSlice<Shared<Type>>(&secondMembers),
    variables,
    comparison,
    Vector.asSlice<Binding>(&bindings.*),
    Vector.asSlice<UnifySlot>(&absorbed.*),
    &mut secondFixed,
    &mut secondOpen,
  )
  if !firstSplit || !secondSplit {
    let bareOpen = hasBareSetVariable(
      Vector.asSlice<Shared<Type>>(&firstMembers),
      variables,
      Vector.asSlice<Binding>(&bindings.*),
    ) || hasBareSetVariable(
      Vector.asSlice<Shared<Type>>(&secondMembers),
      variables,
      Vector.asSlice<Binding>(&bindings.*),
    )
    if (comparison != Comparison.Exact || !bareOpen) && Vector.length<Shared<Type>>(&firstMembers) == Vector.length<Shared<Type>>(&secondMembers) {
      let mut used = Vector.make<bool>()
      let mut at = usize.ZERO
      while at < Vector.length<Shared<Type>>(&secondMembers) {
        run Vector.append<bool>(&mut used, false)
        at = at + usize.ONE
      }
      let paired = run matchSetPermutation(
        Vector.asSlice<Shared<Type>>(&firstMembers),
        Vector.asSlice<Shared<Type>>(&secondMembers),
        variables,
        comparison,
        &mut bindings.*,
        &mut absorbed.*,
        &mut used,
        usize.ZERO,
        first,
      )
      if isUnified(&paired) {
        return move paired
      }
      if isDistinct(&paired) && !bareOpen {
        let firstMayCollapse = run setMayCollapse(
          Vector.asSlice<Shared<Type>>(&firstMembers),
          variables,
          &mut bindings.*,
          &mut absorbed.*,
        )
        let secondMayCollapse = run setMayCollapse(
          Vector.asSlice<Shared<Type>>(&secondMembers),
          variables,
          &mut bindings.*,
          &mut absorbed.*,
        )
        if !firstMayCollapse && !secondMayCollapse {
          return Unification.Distinct
        }
      }
    }
    return undetermined(first)
  }
  let firstVariables = Vector.length<UnifySlot>(&firstOpen)
  let secondVariables = Vector.length<UnifySlot>(&secondOpen)
  if firstVariables == usize.ZERO && secondVariables == usize.ZERO {
    let forward = run setIncluded(
      Vector.asSlice<Shared<Type>>(&firstFixed),
      Vector.asSlice<Shared<Type>>(&secondFixed),
      comparison,
    )
    if isDistinct(&forward) {
      return move forward
    }
    let backward = run setIncluded(
      Vector.asSlice<Shared<Type>>(&secondFixed),
      Vector.asSlice<Shared<Type>>(&firstFixed),
      comparison,
    )
    return worse(&forward, &backward)
  }
  if comparison == Comparison.Exact {
    return undetermined(first)
  }
  let mut result = Unification.Unified
  if secondVariables == usize.ZERO {
    result = run setIncluded(
      Vector.asSlice<Shared<Type>>(&firstFixed),
      Vector.asSlice<Shared<Type>>(&secondFixed),
      comparison,
    )
  }
  if firstVariables == usize.ZERO {
    result = run setIncluded(
      Vector.asSlice<Shared<Type>>(&secondFixed),
      Vector.asSlice<Shared<Type>>(&firstFixed),
      comparison,
    )
  }
  if !isUnified(&result) {
    return move result
  }
  run absorb(Vector.asSlice<UnifySlot>(&firstOpen), &mut absorbed.*)
  run absorb(Vector.asSlice<UnifySlot>(&secondOpen), &mut absorbed.*)
  return Unification.Unified
}

effect fn absorb(slots: &[UnifySlot], absorbed: &mut Vector<UnifySlot>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < slots.length {
    run Vector.append<UnifySlot>(&mut absorbed.*, slots[at])
    at = at + usize.ONE
  }
  return ()
}

// Splits set members into fixed members and bare unbound variables; false when a member mentions a
// variable in any other way or a variable repeats or was already absorbed by another set, which
// leaves the set outside the fragment.
effect fn splitSet(
  members: &[Shared<Type>],
  variables: &[Shared<DeclarationId>],
  comparison: Comparison,
  bindings: &[Binding],
  absorbed: &[UnifySlot],
  fixed: &mut Vector<Shared<Type>>,
  open: &mut Vector<UnifySlot>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < members.length {
    let member = resolvedType(&members[at], variables, bindings)
    let slot = Shared.with<Type, UnifySlot>(
      &member,
      fn(value: &Type) -> UnifySlot {
        return typeSlot(value, variables)
      },
    )
    if slot.owner != usize.MAX {
      if hasSlot(Vector.asSlice<UnifySlot>(&open.*), &slot) || hasSlot(absorbed, &slot) {
        return false
      }
      run Vector.append<UnifySlot>(&mut open.*, slot)
    } else {
      if hasVariable(&member, variables, bindings, comparison) {
        return false
      }
      run Vector.append<Shared<Type>>(&mut fixed.*, move member)
    }
    at = at + usize.ONE
  }
  return true
}

// A requirement row with bound variable rows merged in: its entries and rigid row parameters, and
// the unbound variable row parameters it still includes.
struct UnifyRowParts {
  row: Row
  open: Vector<UnifySlot>
}

effect fn flattenRow(
  row: &Shared<Row>,
  variables: &[Shared<DeclarationId>],
  bindings: &[Binding],
  into: &mut UnifyRowParts,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let entries = Shared.with<Row, usize>(row, rowEntryCount)
  let mut at = usize.ZERO
  while at < entries {
    run Row.require(&mut into.row, entryAt(row, at))
    at = at + usize.ONE
  }
  let parameters = Shared.with<Row, usize>(row, rowParameterCount)
  at = usize.ZERO
  while at < parameters {
    let slot = Shared.with<Row, UnifySlot>(
      row,
      fn(value: &Row) -> UnifySlot {
        return rowParameterSlot(value, at, variables)
      },
    )
    if slot.owner == usize.MAX {
      let parameter = Shared.with<Row, RowParameter>(
        row,
        fn(value: &Row) -> RowParameter {
          return rowParameterAt(value, at)
        },
      )
      run Row.include(&mut into.row, move parameter)
    } else {
      let bound = bindingAt(bindings, variables, &slot)
      if bound == usize.MAX {
        if !hasSlot(Vector.asSlice<UnifySlot>(&into.open), &slot) {
          run Vector.append<UnifySlot>(&mut into.open, slot)
        }
      } else {
        if let Argument.Row {value: supplied} = &bindings[bound].value {
          run flattenRow(&supplied, variables, bindings, &mut into.*)
        }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// Whether some entry of a flattened row still mentions an unbound variable.
fn entriesOpen(row: &Shared<Row>, variables: &[Shared<DeclarationId>], bindings: &[Binding], comparison: Comparison) -> bool {
  let entries = Shared.with<Row, usize>(row, rowEntryCount)
  let mut at = usize.ZERO
  while at < entries {
    let entry = entryAt(row, at)
    if hasVariable(&entry.capability, variables, bindings, comparison) {
      return true
    }
    if let Option<Shared<Type>>.Some {value: roleValue} = &entry.roleType {
      if hasVariable(&roleValue, variables, bindings, comparison) {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Whether two entries name one service-role key.
effect fn sameEntryKey(
  first: &Requirement,
  second: &Requirement,
  comparison: Comparison,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let mut map = Vector.make<usize>()
  if comparison == Comparison.Projection {
    run Vector.append<usize>(&mut map, usize.MAX - 2)
  }
  if !run sameUnder(&first.capability, &second.capability, Vector.asSlice<usize>(&map)) {
    return Unification.Distinct
  }
  if let Option<Shared<Type>>.Some {value: roleValue} = &first.roleType {
    if let Option<Shared<Type>>.Some {value: otherRole} = &second.roleType {
      if run sameUnder(&roleValue, &otherRole, Vector.asSlice<usize>(&map)) {
        return Unification.Unified
      }
      return Unification.Distinct
    }
    return Unification.Distinct
  }
  if let Option<Shared<Type>>.Some {value: _} = &second.roleType {
    return Unification.Distinct
  }
  return Unification.Unified
}

// Every entry of `required` has the same key in `available` with at least its access, or, when
// `exact`, with the same access.
effect fn entriesCovered(
  required: &Shared<Row>,
  available: &Shared<Row>,
  exact: bool,
  comparison: Comparison,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let entries = Shared.with<Row, usize>(required, rowEntryCount)
  let candidates = Shared.with<Row, usize>(available, rowEntryCount)
  let mut result = Unification.Unified
  let mut at = usize.ZERO
  while at < entries {
    let entry = entryAt(required, at)
    let mut found = Unification.Distinct
    let mut other = usize.ZERO
    while !isUnified(&found) && other < candidates {
      let candidate = entryAt(available, other)
      // A provisional key match under Projection can name several entries. Access must
      // qualify the candidate before it can decide this required entry.
      let covers = sameAccess(entry.access, candidate.access) || (!exact && !sameAccess(
        candidate.access,
        Access.Shared,
      ))
      if covers {
        let key = run sameEntryKey(&entry, &candidate, comparison)
        if isUnified(&key) {
          found = move key
        } else {
          if !isDistinct(&key) && isDistinct(&found) {
            found = move key
          }
        }
      }
      other = other + usize.ONE
    }
    result = worse(&result, &found)
    if isDistinct(&result) {
      return move result
    }
    at = at + usize.ONE
  }
  return move result
}

// Closed rows need a distinct candidate for each entry. A partial lifetime projection can make
// several keys look alike, so try alternate candidates rather than choosing source order. If
// projected keys collide and no full pairing exists, keep that case undecided. This search does
// not bind variables; the caller's `unifyAll` transaction still owns all bindings.
effect fn closedEntriesMatch(
  left: &Shared<Row>,
  right: &Shared<Row>,
  site: &Shared<Type>,
  comparison: Comparison,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Row, usize>(left, rowEntryCount)
  let mut choices = Vector.make<usize>()
  let mut initialized = usize.ZERO
  while initialized < count {
    run Vector.append<usize>(&mut choices, usize.MAX)
    initialized = initialized + usize.ONE
  }
  let mut at = usize.ZERO
  let mut collision = false
  let mut uncertain = false
  while true {
    if at == count {
      return Unification.Unified
    }
    let chosen = Vector.asSlice<usize>(&choices)[at]
    let mut candidate = usize.ZERO
    if chosen != usize.MAX {
      candidate = chosen + usize.ONE
    }
    let required = entryAt(left, at)
    let mut found = false
    while candidate < count && !found {
      let available = entryAt(right, candidate)
      if sameAccess(required.access, available.access) {
        let key = run sameEntryKey(&required, &available, comparison)
        if isUnified(&key) {
          let mut used = false
          let mut earlier = usize.ZERO
          while earlier < at {
            if Vector.asSlice<usize>(&choices)[earlier] == candidate {
              used = true
            }
            earlier = earlier + usize.ONE
          }
          if used {
            collision = true
          } else {
            found = true
          }
        } else {
          if !isDistinct(&key) {
            uncertain = true
          }
        }
      }
      if !found {
        candidate = candidate + usize.ONE
      }
    }
    if found {
      let slots = Vector.asMutSlice<usize>(&mut choices)
      slots[at] = candidate
      if at + usize.ONE < count {
        slots[at + usize.ONE] = usize.MAX
      }
      at = at + usize.ONE
    } else {
      let slots = Vector.asMutSlice<usize>(&mut choices)
      slots[at] = usize.MAX
      if at == usize.ZERO {
        if uncertain || (comparison == Comparison.Projection && collision) {
          return undetermined(site)
        }
        return Unification.Distinct
      }
      at = at - usize.ONE
    }
  }
  return Unification.Distinct
}

effect fn unifyEntryKeys(
  first: &Requirement,
  second: &Requirement,
  variables: &[Shared<DeclarationId>],
  comparison: Comparison,
  bindings: &mut Vector<Binding>,
  absorbed: &mut Vector<UnifySlot>,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  if !sameAccess(first.access, second.access) {
    return Unification.Distinct
  }
  let capability = run unifyTerms(
    &first.capability,
    &second.capability,
    variables,
    comparison,
    &mut bindings.*,
    &mut absorbed.*,
  )
  if isDistinct(&capability) {
    return move capability
  }
  if let Option<Shared<Type>>.Some {value: firstRole} = &first.roleType {
    if let Option<Shared<Type>>.Some {value: secondRole} = &second.roleType {
      let roleComparison = run unifyTerms(
        &firstRole,
        &secondRole,
        variables,
        comparison,
        &mut bindings.*,
        &mut absorbed.*,
      )
      return worse(&capability, &roleComparison)
    }
    return Unification.Distinct
  }
  if let Option<Shared<Type>>.Some {value: _} = &second.roleType {
    return Unification.Distinct
  }
  return move capability
}

// Parameterized service-role keys may match only under one shared assignment. Search alternate
// pairings rather than committing to written order; callers retain Undetermined on a failed search
// because normalization after substitution may still collapse keys.
effect fn matchRowPermutation(
  left: &Shared<Row>,
  right: &Shared<Row>,
  variables: &[Shared<DeclarationId>],
  comparison: Comparison,
  bindings: &mut Vector<Binding>,
  absorbed: &mut Vector<UnifySlot>,
  used: &mut Vector<bool>,
  at: usize,
  site: &Shared<Type>,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Row, usize>(left, rowEntryCount)
  if at == count {
    return Unification.Unified
  }
  let entry = entryAt(left, at)
  let mut uncertain = false
  let mut candidate = usize.ZERO
  while candidate < count {
    if !Vector.asSlice<bool>(&used.*)[candidate] {
      let bindingMark = Vector.length<Binding>(&bindings.*)
      let absorbedMark = Vector.length<UnifySlot>(&absorbed.*)
      let other = entryAt(right, candidate)
      let compared = run unifyEntryKeys(
        &entry,
        &other,
        variables,
        comparison,
        &mut bindings.*,
        &mut absorbed.*,
      )
      if isUnified(&compared) {
        Vector.set<bool>(&mut used.*, candidate, true)
        let matched = run matchRowPermutation(
          left,
          right,
          variables,
          comparison,
          &mut bindings.*,
          &mut absorbed.*,
          &mut used.*,
          at + usize.ONE,
          site,
        )
        Vector.set<bool>(&mut used.*, candidate, false)
        if isUnified(&matched) {
          return move matched
        }
        if !isDistinct(&matched) {
          uncertain = true
        }
      } else if !isDistinct(&compared) {
        uncertain = true
      }
      Vector.truncate<Binding>(&mut bindings.*, bindingMark)
      Vector.truncate<UnifySlot>(&mut absorbed.*, absorbedMark)
    }
    candidate = candidate + usize.ONE
  }
  if uncertain {
    return undetermined(site)
  }
  return Unification.Distinct
}

// Two distinct exact keys can become one after lifetime projection. Only such a collision can
// make different closed-row entry counts compatible with a later lifetime substitution.
effect fn projectedKeyCollision(row: &Shared<Row>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Row, usize>(row, rowEntryCount)
  let mut at = usize.ZERO
  while at < count {
    let first = entryAt(row, at)
    let mut other = at + usize.ONE
    while other < count {
      let second = entryAt(row, other)
      let key = run sameEntryKey(&first, &second, Comparison.Projection)
      if !isDistinct(&key) {
        return true
      }
      other = other + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

effect fn projectedEntryAt(entries: &[Requirement], wanted: &Requirement) -> usize
! OutOfMemoryError
? &mut Allocator {
  let mut at = usize.ZERO
  while at < entries.length {
    let matched = run sameEntryKey(&entries[at], wanted, Comparison.Projection)
    if isUnified(&matched) {
      return at
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// Coherence erases lifetimes before comparing heads. Keys that differ only by those lifetimes may
// then collapse; their strongest access is the row entry that survives substitution.
effect fn projectedRow(row: &Shared<Row>) -> Shared<Row> ! OutOfMemoryError ? &mut Allocator {
  let mut projected = Row.empty()
  let count = Shared.with<Row, usize>(row, rowEntryCount)
  let mut at = usize.ZERO
  while at < count {
    let entry = entryAt(row, at)
    let existing = run projectedEntryAt(Vector.asSlice<Requirement>(&projected.entries), &entry)
    if existing == usize.MAX {
      run Vector.append<Requirement>(&mut projected.entries, move entry)
    } else if !sameAccess(entry.access, Access.Shared) {
      let entries = Vector.asMutSlice<Requirement>(&mut projected.entries)
      entries[existing].access = Access.Mutable
    }
    at = at + usize.ONE
  }
  let parameters = Shared.with<Row, usize>(row, rowParameterCount)
  at = usize.ZERO
  while at < parameters {
    run Row.include(&mut projected, Shared.with<Row, RowParameter>(
      row,
      fn(value: &Row) -> RowParameter {
        return rowParameterAt(value, at)
      },
    ))
    at = at + usize.ONE
  }
  return run Shared.make<Row>(move projected)
}

fn sameRigidParameters(first: &Row, second: &Shared<Row>) -> bool {
  return Shared.with<Row, bool>(
    second,
    fn(other: &Row) -> bool {
      let firstParameters = Vector.asSlice<RowParameter>(&first.parameters)
      let secondParameters = Vector.asSlice<RowParameter>(&other.parameters)
      if firstParameters.length != secondParameters.length {
        return false
      }
      let mut at = usize.ZERO
      let map = Vector.make<usize>()
      while at < firstParameters.length {
        if !hasParameter(secondParameters, &firstParameters[at], Vector.asSlice<usize>(&map)) {
          return false
        }
        at = at + usize.ONE
      }
      return true
    },
  )
}

// Requirement rows compare as sets of service-role keys, each at its strongest access, plus row
// parameters. Closed rows compare exactly. Under exact comparison one variable row parameter
// standing alone binds the whole other row. The projection also decides the open fragment: a row
// with unbound variable parameters matches a closed row iff each of its own keys is there with at
// least its access, since a variable can add keys and strengthen access but never remove or weaken
// them; two open rows always match. Those variables are then absorbed. An entry that mentions a
// variable, or a rigid parameter beside a variable, is undecided.
effect fn unifyRows(
  left: &Shared<Row>,
  right: &Shared<Row>,
  at: &Shared<Type>,
  variables: &[Shared<DeclarationId>],
  comparison: Comparison,
  bindings: &mut Vector<Binding>,
  absorbed: &mut Vector<UnifySlot>,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let mut first = UnifyRowParts {row: Row.empty(), open: Vector.make<UnifySlot>()}
  run flattenRow(left, variables, Vector.asSlice<Binding>(&bindings.*), &mut first)
  let mut second = UnifyRowParts {row: Row.empty(), open: Vector.make<UnifySlot>()}
  run flattenRow(right, variables, Vector.asSlice<Binding>(&bindings.*), &mut second)
  let UnifyRowParts {row: firstValue, open: firstOpen} = move first
  let UnifyRowParts {row: secondValue, open: secondOpen} = move second
  let firstRow = run Shared.make<Row>(move firstValue)
  let secondRow = run Shared.make<Row>(move secondValue)
  let firstEntriesOpen = entriesOpen(&firstRow, variables, Vector.asSlice<Binding>(&bindings.*), comparison)
  let secondEntriesOpen = entriesOpen(
    &secondRow,
    variables,
    Vector.asSlice<Binding>(&bindings.*),
    comparison,
  )
  if firstEntriesOpen || secondEntriesOpen {
    let rigid = Shared.with<Row, bool>(
      &firstRow,
      fn(value: &Row) -> bool {
        return sameRigidParameters(value, &secondRow)
      },
    )
    if rigid && Vector.length<UnifySlot>(&firstOpen) == usize.ZERO && Vector.length<UnifySlot>(&secondOpen) == usize.ZERO && Shared.with<Row, usize>(
      &firstRow,
      rowEntryCount,
    ) == Shared.with<Row, usize>(&secondRow, rowEntryCount) {
      let mut used = Vector.make<bool>()
      let count = Shared.with<Row, usize>(&secondRow, rowEntryCount)
      let mut entryAtIndex = usize.ZERO
      while entryAtIndex < count {
        run Vector.append<bool>(&mut used, false)
        entryAtIndex = entryAtIndex + usize.ONE
      }
      let paired = run matchRowPermutation(
        &firstRow,
        &secondRow,
        variables,
        comparison,
        &mut bindings.*,
        &mut absorbed.*,
        &mut used,
        usize.ZERO,
        at,
      )
      if isUnified(&paired) {
        return move paired
      }
      if isDistinct(&paired) && count == usize.ONE && Shared.with<Row, usize>(
        &firstRow,
        rowParameterCount,
      ) == usize.ZERO {
        return Unification.Distinct
      }
    }
    return undetermined(at)
  }
  let firstVariables = Vector.length<UnifySlot>(&firstOpen)
  let secondVariables = Vector.length<UnifySlot>(&secondOpen)
  if firstVariables == usize.ZERO && secondVariables == usize.ZERO {
    let mut comparedFirst = Shared.clone<Row>(&firstRow)
    let mut comparedSecond = Shared.clone<Row>(&secondRow)
    if comparison == Comparison.Projection {
      comparedFirst = run projectedRow(&firstRow)
      comparedSecond = run projectedRow(&secondRow)
    }
    let rigid = Shared.with<Row, bool>(
      &comparedFirst,
      fn(value: &Row) -> bool {
        return sameRigidParameters(value, &comparedSecond)
      },
    )
    if !rigid {
      return Unification.Distinct
    }
    if Shared.with<Row, usize>(&comparedFirst, rowEntryCount) != Shared.with<Row, usize>(
      &comparedSecond,
      rowEntryCount,
    ) {
      // Distinct lifetime-bearing keys may normalize to one key after substitution.
      if comparison == Comparison.Projection {
        if run projectedKeyCollision(&comparedFirst) {
          return undetermined(at)
        }
        if run projectedKeyCollision(&comparedSecond) {
          return undetermined(at)
        }
      }
      return Unification.Distinct
    }
    return run closedEntriesMatch(&comparedFirst, &comparedSecond, at, comparison)
  }
  let firstBare = Shared.with<Row, bool>(&firstRow, bareRow)
  let secondBare = Shared.with<Row, bool>(&secondRow, bareRow)
  if comparison == Comparison.Exact {
    if firstVariables == usize.ONE && firstBare && secondVariables == usize.ZERO {
      let slots = Vector.asSlice<UnifySlot>(&firstOpen)
      run bindVariable(&slots[usize.ZERO], Argument.Row {value: move secondRow}, variables, &mut bindings.*)
      return Unification.Unified
    }
    if secondVariables == usize.ONE && secondBare && firstVariables == usize.ZERO {
      let slots = Vector.asSlice<UnifySlot>(&secondOpen)
      run bindVariable(&slots[usize.ZERO], Argument.Row {value: move firstRow}, variables, &mut bindings.*)
      return Unification.Unified
    }
    return undetermined(at)
  }
  if anyAbsorbed(Vector.asSlice<UnifySlot>(&firstOpen), Vector.asSlice<UnifySlot>(&absorbed.*)) || anyAbsorbed(
    Vector.asSlice<UnifySlot>(&secondOpen),
    Vector.asSlice<UnifySlot>(&absorbed.*),
  ) {
    return undetermined(at)
  }
  let firstRigid = Shared.with<Row, usize>(&firstRow, rowParameterCount)
  let secondRigid = Shared.with<Row, usize>(&secondRow, rowParameterCount)
  if (firstVariables > usize.ZERO && firstRigid > usize.ZERO) || (secondVariables > usize.ZERO && secondRigid > usize.ZERO) {
    return undetermined(at)
  }
  let mut result = Unification.Unified
  if secondVariables == usize.ZERO {
    result = run entriesCovered(&firstRow, &secondRow, false, comparison)
  }
  if firstVariables == usize.ZERO {
    result = run entriesCovered(&secondRow, &firstRow, false, comparison)
  }
  if !isUnified(&result) {
    return move result
  }
  run absorb(Vector.asSlice<UnifySlot>(&firstOpen), &mut absorbed.*)
  run absorb(Vector.asSlice<UnifySlot>(&secondOpen), &mut absorbed.*)
  return Unification.Unified
}

fn bareRow(value: &Row) -> bool {
  return Vector.length<Requirement>(&value.entries) == usize.ZERO && Vector.length<RowParameter>(
    &value.parameters,
  ) == usize.ZERO
}

fn anyAbsorbed(slots: &[UnifySlot], absorbed: &[UnifySlot]) -> bool {
  let mut at = usize.ZERO
  while at < slots.length {
    if hasSlot(absorbed, &slots[at]) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// The unifier's recursive step. A variable binds after the occurs check; unions and rows use the
// set rules; any other pair must agree in shape and then position by position, with lifetimes
// compared only under exact comparison. Bindings are never undone here: `Type.unifyAll` owns the
// transaction.
effect fn unifyTerms(
  left: &Shared<Type>,
  right: &Shared<Type>,
  variables: &[Shared<DeclarationId>],
  comparison: Comparison,
  bindings: &mut Vector<Binding>,
  absorbed: &mut Vector<UnifySlot>,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let first = resolvedType(left, variables, Vector.asSlice<Binding>(&bindings.*))
  let second = resolvedType(right, variables, Vector.asSlice<Binding>(&bindings.*))
  let firstSlot = Shared.with<Type, UnifySlot>(
    &first,
    fn(value: &Type) -> UnifySlot {
      return typeSlot(value, variables)
    },
  )
  let secondSlot = Shared.with<Type, UnifySlot>(
    &second,
    fn(value: &Type) -> UnifySlot {
      return typeSlot(value, variables)
    },
  )
  if firstSlot.owner != usize.MAX {
    if sameSlot(&firstSlot, &secondSlot) {
      return Unification.Unified
    }
    return run bindType(&firstSlot, &second, variables, &mut bindings.*, Vector.asSlice<UnifySlot>(&absorbed.*))
  }
  if secondSlot.owner != usize.MAX {
    return run bindType(&secondSlot, &first, variables, &mut bindings.*, Vector.asSlice<UnifySlot>(&absorbed.*))
  }
  if Shared.with<Type, usize>(&first, unionLength) != usize.MAX || Shared.with<Type, usize>(
    &second,
    unionLength,
  ) != usize.MAX {
    return run unifySets(&first, &second, variables, comparison, &mut bindings.*, &mut absorbed.*)
  }
  let aliased = Shared.with<Type, usize>(&first, addressOf) == Shared.with<Type, usize>(&second, addressOf)
  let mut shaped = false
  if aliased {
    shaped = Shared.with<Type, bool>(&first, fn(value: &Type) -> bool {
      return sameShape(value, value)
    })
  } else {
    shaped = Shared.with<Type, bool>(&first, fn(value: &Type) -> bool {
      return shapeWith(value, &second)
    })
  }
  if !shaped {
    return Unification.Distinct
  }
  let executable = Shared.with<Type, bool>(&first, isExecutable)
  let mut result = Unification.Unified
  if comparison == Comparison.Exact {
    if executable {
      let mut plain = false
      if aliased {
        plain = Shared.with<Type, bool>(&first, fn(value: &Type) -> bool {
          return plainExecutable(value, value)
        })
      } else {
        plain = Shared.with<Type, bool>(&first, fn(value: &Type) -> bool {
          return plainExecutableWith(value, &second)
        })
      }
      if !plain {
        result = undetermined(&first)
      }
    } else {
      let regions = Shared.with<Type, usize>(&first, ownLifetimeCount)
      let mut region = usize.ZERO
      while region < regions {
        let firstRegion = Shared.with<Type, Option<Shared<Lifetime>>>(
          &first,
          fn(value: &Type) -> Option<Shared<Lifetime>> {
            return ownLifetimeAt(value, region)
          },
        )
        let secondRegion = Shared.with<Type, Option<Shared<Lifetime>>>(
          &second,
          fn(value: &Type) -> Option<Shared<Lifetime>> {
            return ownLifetimeAt(value, region)
          },
        )
        if let Option<Shared<Lifetime>>.Some {value: firstLifetime} = move firstRegion {
          if let Option<Shared<Lifetime>>.Some {value: secondLifetime} = move secondRegion {
            let compared = run unifyLifetimes(&firstLifetime, &secondLifetime, &first, variables, &mut bindings.*)
            result = worse(&result, &compared)
            if isDistinct(&result) {
              return move result
            }
          }
        }
        region = region + usize.ONE
      }
    }
  }
  let count = Shared.with<Type, usize>(&first, childCount)
  let mut at = usize.ZERO
  while at < count {
    let firstChild = Shared.with<Type, Option<Shared<Type>>>(
      &first,
      fn(value: &Type) -> Option<Shared<Type>> {
        return childAt(value, at)
      },
    )
    let secondChild = Shared.with<Type, Option<Shared<Type>>>(
      &second,
      fn(value: &Type) -> Option<Shared<Type>> {
        return childAt(value, at)
      },
    )
    if let Option<Shared<Type>>.Some {value: firstNested} = move firstChild {
      if let Option<Shared<Type>>.Some {value: secondNested} = move secondChild {
        let compared = run unifyTerms(&firstNested, &secondNested, variables, comparison, &mut bindings.*, &mut absorbed.*)
        result = worse(&result, &compared)
        if isDistinct(&result) {
          return move result
        }
      }
    }
    let firstRow = argumentRowOf(&first, at)
    let secondRow = argumentRowOf(&second, at)
    if let Option<Shared<Row>>.Some {value: firstSupplied} = move firstRow {
      if let Option<Shared<Row>>.Some {value: secondSupplied} = move secondRow {
        let compared = run unifyRows(&firstSupplied, &secondSupplied, &first, variables, comparison, &mut bindings.*, &mut absorbed.*)
        result = worse(&result, &compared)
        if isDistinct(&result) {
          return move result
        }
      }
    }
    at = at + usize.ONE
  }
  let firstRequirements = Shared.with<Type, Option<Shared<Row>>>(&first, rowOf)
  let secondRequirements = Shared.with<Type, Option<Shared<Row>>>(&second, rowOf)
  if let Option<Shared<Row>>.Some {value: firstChannel} = move firstRequirements {
    if let Option<Shared<Row>>.Some {value: secondChannel} = move secondRequirements {
      let compared = run unifyRows(&firstChannel, &secondChannel, &first, variables, comparison, &mut bindings.*, &mut absorbed.*)
      result = worse(&result, &compared)
    }
  }
  return move result
}

fn rowOccurrences(row: &Shared<Row>, owner: &DeclarationId, ordinal: usize) -> usize {
  let mut count = usize.ZERO
  let entries = Shared.with<Row, usize>(row, rowEntryCount)
  let mut at = usize.ZERO
  while at < entries {
    let entry = entryAt(row, at)
    count = count + Type.occurrences(&entry.capability, owner, ordinal)
    if let Option<Shared<Type>>.Some {value: roleValue} = &entry.roleType {
      count = count + Type.occurrences(&roleValue, owner, ordinal)
    }
    at = at + usize.ONE
  }
  let parameters = Shared.with<Row, usize>(row, rowParameterCount)
  at = usize.ZERO
  while at < parameters {
    let owned = Shared.with<Row, usize>(
      row,
      fn(value: &Row) -> usize {
        return ownedRowOrdinal(value, at, owner)
      },
    )
    if owned != usize.MAX && (ordinal == usize.MAX || owned == ordinal) {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

// Copy only the current node; release its shared borrow before traversing any child.
fn nodeKind(value: &Type) -> usize {
  return match & value.* {
    Type.Primitive {..} => 0
    Type.Unit => 1
    Type.Nominal {..} => 2
    Type.NamedRepresentation {..} => 3
    Type.OpaqueRepresentation {..} => 4
    Type.Parameter {..} => 5
    Type.String {..} => 6
    Type.Reference {..} => 7
    Type.Slice {..} => 8
    Type.Pointer {..} => 9
    Type.Array {..} => 10
    Type.Union {..} => 11
    Type.Callable {..} => 12
    Type.Effect {..} => 13
    Type.TypeDescriptor {..} => 14
    Type.Anonymous {..} => 15
  }
}

fn nodeArgument(value: &Type, at: usize) -> Option<Argument> {
  return match & value.* {
    Type.Nominal {arguments, ..} => Option.some<Argument>(nodeArgumentIn(&arguments, at))
    Type.NamedRepresentation {arguments, ..} => Option.some<Argument>(
      nodeArgumentIn(&arguments, at),
    )
    Type.OpaqueRepresentation {arguments, ..} => Option.some<Argument>(
      nodeArgumentIn(&arguments, at),
    )
    _ => Option.none<Argument>()
  }
}

fn copyNodeArgument(value: &Argument) -> Argument {
  return match & value.* {
    Argument.Type {value: ty} => Argument.Type {value: Shared.clone<Type>(&ty)}
    Argument.Lifetime {value: region} => Argument.Lifetime {value: Shared.clone<Lifetime>(&region)}
    Argument.Row {value: row} => Argument.Row {value: Shared.clone<Row>(&row)}
  }
}

effect fn nodeArguments(value: &Shared<Type>) -> Vector<Argument>
! OutOfMemoryError
? &mut Allocator {
  let count = Shared.with<Type, usize>(value, childCount)
  let mut arguments = Vector.make<Argument>()
  let mut at = usize.ZERO
  while at < count {
    let found = Shared.with<Type, Option<Argument>>(
      value,
      fn(node: &Type) -> Option<Argument> {
        return nodeArgument(node, at)
      },
    )
    if let Option<Argument>.Some {value: argument} = move found {
      run Vector.append<Argument>(&mut arguments, move argument)
    }
    at = at + usize.ONE
  }
  return move arguments
}

effect fn nodeText(value: &Shared<Type>) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let length = Shared.with<Type, usize>(
    value,
    fn(node: &Type) -> usize {
      return match & node.* {
        Type.Primitive {name} => Bytes.asSlice(&name).length
        Type.Array {extent, ..} => Bytes.asSlice(&extent).length
        _ => usize.ZERO
      }
    },
  )
  let mut output = run Bytes.zeroed(length)
  let copied = Shared.with<Type, bool>(
    value,
    fn(node: &Type) -> bool {
      return match & node.* {
        Type.Primitive {name} => fillNodeText(&name, &mut output)
        Type.Array {extent, ..} => fillNodeText(&extent, &mut output)
        _ => false
      }
    },
  )
  return move output
}

effect fn nodeCopy(value: &Shared<Type>) -> Type
! OutOfMemoryError
? &mut Allocator {
  let kind = Shared.with<Type, usize>(value, nodeKind)
  if kind == usize.ZERO {
    return Type.Primitive {name: run nodeText(value)}
  }
  if kind >= 2 && kind <= 5 {
    let selectedDeclaration = run copyNodeDeclaration(value)
    let declaration = match move selectedDeclaration {
      Option<DeclarationId>.Some {value: id} => move id
      Option<DeclarationId>.None => {
        return absurd<Type>()
      }
    }
    if kind == 5 {
      let ordinal = Shared.with<Type, usize>(
        value,
        fn(node: &Type) -> usize {
          return match & node.* {
            Type.Parameter {ordinal, ..} => ordinal
            _ => usize.ZERO
          }
        },
      )
      return Type.Parameter {declaration: move declaration, ordinal: ordinal}
    }
    let arguments = run nodeArguments(value)
    let visibility = Shared.with<Type, bool>(
      value,
      fn(node: &Type) -> bool {
        return match & node.* {
          Type.Nominal {isPublic, ..} => isPublic
          Type.NamedRepresentation {isPublic, ..} => isPublic
          _ => false
        }
      },
    )
    if kind == 2 {
      return Type.Nominal {
        declaration: move declaration,
        isPublic: visibility,
        arguments: move arguments,
      }
    }
    if kind == 3 {
      return Type.NamedRepresentation {
        declaration: move declaration,
        isPublic: visibility,
        arguments: move arguments,
      }
    }
    let flags = Shared.with<Type, OpaqueFlags>(
      value,
      fn(node: &Type) -> OpaqueFlags {
        return match & node.* {
          Type.OpaqueRepresentation {contract, detached, nonParking, ..} => OpaqueFlags {
            contract: Option.some<Shared<Type>>(Shared.clone<Type>(&contract)),
            detached: detached,
            nonParking: nonParking,
          }
          _ => OpaqueFlags {
            contract: Option.none<Shared<Type>>(),
            detached: false,
            nonParking: false,
          }
        }
      },
    )
    if let Option<Shared<Type>>.Some {value: contract} = move flags.contract {
      return Type.OpaqueRepresentation {
        producer: move declaration,
        arguments: move arguments,
        contract: move contract,
        detached: flags.detached,
        nonParking: flags.nonParking,
      }
    }
    return absurd<Type>()
  }
  if kind == 10 {
    let element = Shared.with<Type, Option<Shared<Type>>>(
      value,
      fn(node: &Type) -> Option<Shared<Type>> {
        return childAt(node, usize.ZERO)
      },
    )
    if let Option<Shared<Type>>.Some {value: child} = move element {
      return Type.Array {element: move child, extent: run nodeText(value)}
    }
    return absurd<Type>()
  }
  if kind == 15 {
    let occurrence = Shared.with<Type, Option<Shared<AnonymousOccurrence>>>(
      value,
      fn(node: &Type) -> Option<Shared<AnonymousOccurrence>> {
        return match & node.* {
          Type.Anonymous {occurrence, ..} => Option.some<Shared<AnonymousOccurrence>>(Shared.clone<AnonymousOccurrence>(&occurrence))
          _ => Option.none<Shared<AnonymousOccurrence>>()
        }
      },
    )
    let count = Shared.with<Type, usize>(value, childCount)
    let mut members = Vector.make<Shared<Type>>()
    let mut at = usize.ZERO
    while at < count {
      let found = Shared.with<Type, Option<Shared<Type>>>(
        value,
        fn(node: &Type) -> Option<Shared<Type>> {
          return childAt(node, at)
        },
      )
      if let Option<Shared<Type>>.Some {value: member} = move found {
        run Vector.append<Shared<Type>>(&mut members, move member)
      }
      at = at + usize.ONE
    }
    if let Option<Shared<AnonymousOccurrence>>.Some {value: selected} = move occurrence {
      return Type.Anonymous {occurrence: move selected, members: move members}
    }
    return absurd<Type>()
  }
  if kind == 11 {
    let count = Shared.with<Type, usize>(value, unionLength)
    let mut members = Vector.make<Shared<Type>>()
    let mut at = usize.ZERO
    while at < count {
      if let Option<Shared<Type>>.Some {value: member} = move memberOf(value, at) {
        run Vector.append<Shared<Type>>(&mut members, move member)
      }
      at = at + usize.ONE
    }
    return Type.Union {members: move members}
  }
  if kind == 12 {
    let mut copied = Shared.with<Type, Type>(
      value,
      fn(node: &Type) -> Type {
        return match & node.* {
          Type.Callable {mode, isUnsafe, environment, invocationBinders, result, ..} => Type.Callable {
            mode: mode,
            isUnsafe: isUnsafe,
            environment: Shared.clone<Intersection>(&environment),
            invocationBinders: invocationBinders,
            invocationBounds: Vector.make<Outlives>(),
            parameters: Vector.make<Shared<Type>>(),
            result: Shared.clone<Type>(&result),
          }
          _ => absurd<Type>()
        }
      },
    )
    if let Type.Callable {parameters, invocationBounds: copiedBounds, ..} = &mut copied {
      let count = Shared.with<Type, usize>(value, childCount) - usize.ONE
      let mut at = usize.ZERO
      while at < count {
        let found = Shared.with<Type, Option<Shared<Type>>>(
          value,
          fn(node: &Type) -> Option<Shared<Type>> {
            return childAt(node, at)
          },
        )
        if let Option<Shared<Type>>.Some {value: child} = move found {
          run Vector.append<Shared<Type>>(&mut parameters, move child)
        }
        at = at + usize.ONE
      }
      let bounds = Shared.with<Type, usize>(
        value,
        fn(node: &Type) -> usize {
          return match & node.* {
            Type.Callable {invocationBounds, ..} => Vector.length<Outlives>(&invocationBounds)
            _ => usize.ZERO
          }
        },
      )
      at = usize.ZERO
      while at < bounds {
        let found = Shared.with<Type, Option<Outlives>>(
          value,
          fn(node: &Type) -> Option<Outlives> {
            if let Type.Callable {invocationBounds, ..} = &node.* {
              let entries = Vector.asSlice<Outlives>(&invocationBounds)
              return Option.some<Outlives>(
                Outlives {
                  longer: Shared.clone<Lifetime>(&entries[at].longer),
                  shorter: Shared.clone<Lifetime>(&entries[at].shorter),
                },
              )
            }
            return Option.none<Outlives>()
          },
        )
        if let Option<Outlives>.Some {value: bound} = move found {
          run Vector.append<Outlives>(&mut copiedBounds, move bound)
        }
        at = at + usize.ONE
      }
    }
    return move copied
  }
  return Shared.with<Type, Type>(
    value,
    fn(node: &Type) -> Type {
      return match & node.* {
        Type.String {lifetime} => Type.String {lifetime: Shared.clone<Lifetime>(&lifetime)}
        Type.TypeDescriptor {owner} => Type.TypeDescriptor {owner: Shared.clone<Type>(&owner)}
        Type.Reference {referent, access, lifetime} => Type.Reference {
          referent: Shared.clone<Type>(&referent),
          access: access,
          lifetime: Shared.clone<Lifetime>(&lifetime),
        }
        Type.Slice {element, access, lifetime} => Type.Slice {
          element: Shared.clone<Type>(&element),
          access: access,
          lifetime: Shared.clone<Lifetime>(&lifetime),
        }
        Type.Pointer {pointee, access, nullable, multiplicity, alignment} => {
          let copied = match & alignment {
            Option<u64>.Some {value: aligned} => Option.some<u64>(aligned)
            Option<u64>.None => Option.none<u64>()
          }
          return Type.Pointer {
            pointee: Shared.clone<Type>(&pointee),
            access: access,
            nullable: nullable,
            multiplicity: multiplicity,
            alignment: move copied,
          }
        }
        Type.Effect {mode, environment, success, failure, requirements} => Type.Effect {
          mode: mode,
          environment: Shared.clone<Intersection>(&environment),
          success: Shared.clone<Type>(&success),
          failure: Shared.clone<Type>(&failure),
          requirements: Shared.clone<Row>(&requirements),
        }
        Type.Unit => Type.Unit
        _ => absurd<Type>()
      }
    },
  )
}

struct OpaqueFlags {
  contract: Option<Shared<Type>>
  detached: bool
  nonParking: bool
}

impl Type {
  /// Applies owner-qualified lifetime assignments to one validity region.
  pub effect fn applyLifetimeBindings(value: &Shared<Lifetime>, bindings: &[Binding]) -> Shared<Lifetime>
  ! OutOfMemoryError ? &mut Allocator {
    if bindings.length == usize.ZERO { return Shared.clone<Lifetime>(value) }
    let owner = run DeclarationId.copyShared(&bindings[0].declaration)
    let arguments = Vector.make<Argument>()
    return run rewriteLifetime(value, &owner, Vector.asSlice<Argument>(&arguments), &Option.none<DeclarationId>(), true, bindings)
  }
}

impl Row {
  /// Applies exact declaration-owned bindings simultaneously at every depth.
  /// Replacement values are retained as evidence; they are never recursively rebound.
  pub effect fn applyBindings(value: &Shared<Row>, bindings: &[Binding], instantiate: bool) -> Shared<Row>
  ! OutOfMemoryError ? &mut Allocator {
    if bindings.length == usize.ZERO { return Shared.clone<Row>(value) }
    let owner = run DeclarationId.copyShared(&bindings[0].declaration)
    let arguments = Vector.make<Argument>()
    return run rewriteRow(value, &owner, Vector.asSlice<Argument>(&arguments), &Option.none<DeclarationId>(), instantiate, bindings)
  }
}

impl Argument {
  /// Applies exact declaration-owned bindings simultaneously at every depth.
  /// Replacement values are retained as evidence; they are never recursively rebound.
  pub effect fn applyBindings(value: &Argument, bindings: &[Binding], instantiate: bool) -> Argument
  ! OutOfMemoryError ? &mut Allocator {
    if bindings.length == usize.ZERO { return Argument.copy(value) }
    let owner = run DeclarationId.copyShared(&bindings[0].declaration)
    let arguments = Vector.make<Argument>()
    return run rewriteArgument(value, &owner, Vector.asSlice<Argument>(&arguments), &Option.none<DeclarationId>(), instantiate, bindings)
  }
}

impl Type {
  /// Applies exact declaration-owned bindings simultaneously at every depth.
  /// Replacement values are retained as evidence; they are never recursively rebound.
  pub effect fn applyBindings(value: &Shared<Type>, bindings: &[Binding], instantiate: bool) -> Shared<Type>
  ! OutOfMemoryError ? &mut Allocator {
    if bindings.length == usize.ZERO { return Shared.clone<Type>(value) }
    let owner = run DeclarationId.copyShared(&bindings[0].declaration)
    let arguments = Vector.make<Argument>()
    return run rewriteType(value, &owner, Vector.asSlice<Argument>(&arguments), &Option.none<DeclarationId>(), instantiate, bindings)
  }
}

fn exactArgument(bindings: &[Binding], owner: &DeclarationId, ordinal: usize) -> Option<Argument> {
  let mut at = usize.ZERO
  while at < bindings.length {
    if bindings[at].ordinal == ordinal && declarationWith(owner, &bindings[at].declaration) {
      return Option.some<Argument>(Argument.copy(&bindings[at].value))
    }
    at = at + usize.ONE
  }
  return Option.none<Argument>()
}

impl Type {
  /// Substitutes type and row binders owned by `owner` at every depth. Lifetime arguments and
  /// validity relationships remain symbolic. The checked source node is never changed.
  pub effect fn substitute(value: &Shared<Type>, owner: &DeclarationId, arguments: &[Argument]) -> Shared<Type>
  ! OutOfMemoryError ? &mut Allocator {
    let bindings = Vector.make<Binding>()
    return run rewriteType(value, owner, arguments, &Option.none<DeclarationId>(), false, Vector.asSlice<Binding>(&bindings))
  }
  /// Copies one type node into owned storage, retaining shared child handles.
  pub effect fn copy(value: &Shared<Type>) -> Type ! OutOfMemoryError ? &mut Allocator {
    return run nodeCopy(value)
  }
  /// Instantiates every owned binder, including validity regions, in a contextual type copy.
  /// Unresolved binders remain visible so the caller can reject an open context before publication.
  pub effect fn instantiate(value: &Shared<Type>, owner: &DeclarationId, arguments: &[Argument]) -> Shared<Type>
  ! OutOfMemoryError ? &mut Allocator {
    let bindings = Vector.make<Binding>()
    return run rewriteType(value, owner, arguments, &Option.none<DeclarationId>(), true, Vector.asSlice<Binding>(&bindings))
  }
  /// Renames declaration-owned parameters at every depth for an isolated inference transaction.
  /// Nominal declarations, local regions and invocation quantifiers keep their identities.
  pub effect fn renameParameters(value: &Shared<Type>, owner: &DeclarationId, replacement: &DeclarationId) -> Shared<Type>
  ! OutOfMemoryError ? &mut Allocator {
    let arguments = Vector.make<Argument>()
    let bindings = Vector.make<Binding>()
    return run rewriteType(value, owner, Vector.asSlice<Argument>(&arguments), &Option.some<DeclarationId>(run DeclarationId.copy(replacement)), false, Vector.asSlice<Binding>(&bindings))
  }
}

effect fn rewriteType(value: &Shared<Type>, owner: &DeclarationId, arguments: &[Argument], fresh: &Option<DeclarationId>, instantiate: bool, bindings: &[Binding]) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
    let exactSupplied = Shared.with<Type, Option<Argument>>(value, fn(node: &Type) -> Option<Argument> {
      if let Type.Parameter {declaration, ordinal} = &node.* {
        return exactArgument(bindings, &declaration, ordinal)
      }
      return Option.none<Argument>()
    })
    if let Option<Argument>.Some {value: Argument.Type {value: bound}} = move exactSupplied {
      return move bound
    }
    let ordinal = Shared.with<Type, usize>(
      value,
      fn(node: &Type) -> usize {
        return Type.parameterOrdinalOf(node, owner)
      },
    )
    if ordinal != usize.MAX {
      if let Option<DeclarationId>.Some {value: replacement} = &fresh.* {
        return run Shared.make<Type>(Type.Parameter {
          declaration: run DeclarationId.copy(&replacement), ordinal: ordinal,
        })
      }
    }
    if ordinal < arguments.length {
      if let Argument.Type {value: supplied} = &arguments[ordinal] {
        return Shared.clone<Type>(&supplied)
      }
    }
    let node = run nodeCopy(value)
    let replaced = match move node {
      Type.Nominal {declaration, isPublic, arguments: supplied} => Type.Nominal {
        declaration: move declaration,
        isPublic: isPublic,
        arguments: run rewrittenArguments(&supplied, owner, arguments, fresh, instantiate, bindings),
      }
      Type.NamedRepresentation {declaration, isPublic, arguments: supplied} => Type.NamedRepresentation {
        declaration: move declaration,
        isPublic: isPublic,
        arguments: run rewrittenArguments(&supplied, owner, arguments, fresh, instantiate, bindings),
      }
      Type.OpaqueRepresentation {producer, arguments: supplied, contract, detached, nonParking} => Type.OpaqueRepresentation {
        producer: move producer,
        arguments: run rewrittenArguments(&supplied, owner, arguments, fresh, instantiate, bindings),
        contract: run rewriteType(&contract, owner, arguments, fresh, instantiate, bindings),
        detached: detached,
        nonParking: nonParking,
      }
      Type.Reference {referent, access, lifetime} => Type.Reference {
        referent: run rewriteType(&referent, owner, arguments, fresh, instantiate, bindings),
        access: access,
        lifetime: run rewriteLifetime(&lifetime, owner, arguments, fresh, instantiate, bindings),
      }
      Type.Slice {element, access, lifetime} => Type.Slice {
        element: run rewriteType(&element, owner, arguments, fresh, instantiate, bindings),
        access: access,
        lifetime: run rewriteLifetime(&lifetime, owner, arguments, fresh, instantiate, bindings),
      }
      Type.Pointer {pointee, access, nullable, multiplicity, alignment} => Type.Pointer {
        pointee: run rewriteType(&pointee, owner, arguments, fresh, instantiate, bindings),
        access: access,
        nullable: nullable,
        multiplicity: multiplicity,
        alignment: move alignment,
      }
      Type.Array {element, extent} => Type.Array {
        element: run rewriteType(&element, owner, arguments, fresh, instantiate, bindings),
        extent: move extent,
      }
      Type.TypeDescriptor {owner: described} => Type.TypeDescriptor {
        owner: run rewriteType(&described, owner, arguments, fresh, instantiate, bindings),
      }
      Type.Anonymous {occurrence, members} => {
        let listed = Vector.asSlice<Shared<Type>>(&members)
        let mut substituted = Vector.make<Shared<Type>>()
        let mut at = usize.ZERO
        while at < listed.length {
          run Vector.append<Shared<Type>>(&mut substituted, run rewriteType(&listed[at], owner, arguments, fresh, instantiate, bindings))
          at = at + usize.ONE
        }
        return run Shared.make<Type>(Type.Anonymous {occurrence: move occurrence, members: move substituted})
      }
      Type.Union {members} => {
        let listed = Vector.asSlice<Shared<Type>>(&members)
        let mut normalized = Vector.make<Shared<Type>>()
        let mut at = usize.ZERO
        while at < listed.length {
          let replaced = run rewriteType(&listed[at], owner, arguments, fresh, instantiate, bindings)
          run Type.joinMember(&mut normalized, &replaced)
          at = at + usize.ONE
        }
        if Vector.length<Shared<Type>>(&normalized) == usize.ONE {
          return firstNormalized(&normalized)
        }
        return run Shared.make<Type>(Type.Union {members: move normalized})
      }
      Type.Callable {
        mode,
        isUnsafe,
        environment,
        invocationBinders,
        invocationBounds,
        parameters,
        result,
      } => {
        let listed = Vector.asSlice<Shared<Type>>(&parameters)
        let mut substituted = Vector.make<Shared<Type>>()
        let mut at = usize.ZERO
        while at < listed.length {
          run Vector.append<Shared<Type>>(
            &mut substituted,
            run rewriteType(&listed[at], owner, arguments, fresh, instantiate, bindings),
          )
          at = at + usize.ONE
        }
        return run Shared.make<Type>(
          Type.Callable {
            mode: mode,
            isUnsafe: isUnsafe,
            environment: run rewriteEnvironment(&environment, owner, arguments, fresh, instantiate, bindings),
            invocationBinders: invocationBinders,
            invocationBounds: run rewriteOutlives(&invocationBounds, owner, arguments, fresh, instantiate, bindings),
            parameters: move substituted,
            result: run rewriteType(&result, owner, arguments, fresh, instantiate, bindings),
          },
        )
      }
      Type.Effect {mode, environment, success, failure, requirements} => Type.Effect {
        mode: mode,
        environment: run rewriteEnvironment(&environment, owner, arguments, fresh, instantiate, bindings),
        success: run rewriteType(&success, owner, arguments, fresh, instantiate, bindings),
        failure: run rewriteType(&failure, owner, arguments, fresh, instantiate, bindings),
        requirements: run rewriteRow(&requirements, owner, arguments, fresh, instantiate, bindings),
      }
      Type.Primitive {name} => Type.Primitive {name: move name}
      Type.Unit => Type.Unit
      Type.Parameter {declaration, ordinal: remainingOrdinal} => Type.Parameter {
        declaration: move declaration,
        ordinal: remainingOrdinal,
      }
      Type.String {lifetime} => Type.String {lifetime: run rewriteLifetime(&lifetime, owner, arguments, fresh, instantiate, bindings)}
    }
    return run Shared.make<Type>(move replaced)
}

effect fn rewrittenArguments(
  values: &Vector<Argument>,
  owner: &DeclarationId,
  arguments: &[Argument],
  fresh: &Option<DeclarationId>,
  instantiate: bool,
  bindings: &[Binding],
) -> Vector<Argument> ! OutOfMemoryError ? &mut Allocator {
  let listed = Vector.asSlice<Argument>(values)
  let mut output = Vector.make<Argument>()
  let mut at = usize.ZERO
  while at < listed.length {
    run Vector.append<Argument>(&mut output, run rewriteArgument(&listed[at], owner, arguments, fresh, instantiate, bindings))
    at = at + usize.ONE
  }
  return move output
}
effect fn rewriteArgument(value: &Argument, owner: &DeclarationId, arguments: &[Argument], fresh: &Option<DeclarationId>, instantiate: bool, bindings: &[Binding]) -> Argument
! OutOfMemoryError ? &mut Allocator {
  return match &value.* {
    Argument.Type {value: ty} => Argument.Type {value: run rewriteType(&ty, owner, arguments, fresh, instantiate, bindings)}
    Argument.Row {value: row} => Argument.Row {value: run rewriteRow(&row, owner, arguments, fresh, instantiate, bindings)}
    Argument.Lifetime {value: region} => Argument.Lifetime {value: run rewriteLifetime(&region, owner, arguments, fresh, instantiate, bindings)}
  }
}

impl Argument {
  /// Substitutes a generic argument's types and rows while retaining symbolic lifetimes.
  pub effect fn substitute(value: &Argument, owner: &DeclarationId, arguments: &[Argument]) -> Argument
  ! OutOfMemoryError ? &mut Allocator {
    let bindings = Vector.make<Binding>()
    return run rewriteArgument(value, owner, arguments, &Option.none<DeclarationId>(), false, Vector.asSlice<Binding>(&bindings))
  }
}

impl Row {
  /// Substitutes service-role key types and expands rows supplied for this declaration's binders.
  pub effect fn substitute(value: &Shared<Row>, owner: &DeclarationId, arguments: &[Argument]) -> Shared<Row>
  ! OutOfMemoryError ? &mut Allocator {
    let bindings = Vector.make<Binding>()
    return run rewriteRow(value, owner, arguments, &Option.none<DeclarationId>(), false, Vector.asSlice<Binding>(&bindings))
  }
  /// Renames every owned type, lifetime and row parameter without changing normalized keys.
  pub effect fn renameParameters(value: &Shared<Row>, owner: &DeclarationId, replacement: &DeclarationId) -> Shared<Row>
  ! OutOfMemoryError ? &mut Allocator {
    let arguments = Vector.make<Argument>()
    let bindings = Vector.make<Binding>()
    return run rewriteRow(value, owner, Vector.asSlice<Argument>(&arguments), &Option.some<DeclarationId>(run DeclarationId.copy(replacement)), false, Vector.asSlice<Binding>(&bindings))
  }
}

effect fn rewriteRow(value: &Shared<Row>, owner: &DeclarationId, arguments: &[Argument], fresh: &Option<DeclarationId>, instantiate: bool, bindings: &[Binding]) -> Shared<Row>
! OutOfMemoryError ? &mut Allocator {
    let mut result = Row.empty()
    let count = Shared.with<Row, usize>(value, rowEntryCount)
    let mut at = usize.ZERO
    while at < count {
      let entry = entryAt(value, at)
      let roleValue = match move entry.roleType {
        Option<Shared<Type>>.Some {value: ty} => Option.some<Shared<Type>>(
          run rewriteType(&ty, owner, arguments, fresh, instantiate, bindings),
        )
        Option<Shared<Type>>.None => Option.none<Shared<Type>>()
      }
      run Row.require(
        &mut result,
        Requirement {
          capability: run rewriteType(&entry.capability, owner, arguments, fresh, instantiate, bindings),
          roleType: move roleValue,
          access: entry.access,
        },
      )
      at = at + usize.ONE
    }
    let parameterCount = Shared.with<Row, usize>(value, rowParameterCount)
    at = usize.ZERO
    while at < parameterCount {
      let mut parameter = Shared.with<Row, RowParameter>(
        value,
        fn(row: &Row) -> RowParameter {
          return rowParameterAt(row, at)
        },
      )
      let exactSupplied = Shared.with<DeclarationId, Option<Argument>>(&parameter.declaration,
        fn(declaration: &DeclarationId) -> Option<Argument> {
          return exactArgument(bindings, declaration, parameter.ordinal)
        })
      if let Option<Argument>.Some {value: Argument.Row {value: bound}} = move exactSupplied {
        run Row.merge(&mut result, &bound)
        at = at + usize.ONE
        continue
      }
      if declarationWith(owner, &parameter.declaration) && parameter.ordinal < arguments.length {
        if let Argument.Row {value: supplied} = &arguments[parameter.ordinal] {
          run Row.merge(&mut result, &supplied)
          at = at + usize.ONE
          continue
        }
      }
      if declarationWith(owner, &parameter.declaration) {
        if let Option<DeclarationId>.Some {value: replacement} = &fresh.* {
          parameter.declaration = run Shared.make<DeclarationId>(run DeclarationId.copy(&replacement))
        }
      }
      run Row.include(&mut result, move parameter)
      at = at + usize.ONE
    }
    return run Shared.make<Row>(move result)
}

impl Type {
  /// Renames one owned lifetime parameter; local regions and quantified invocation binders stay rigid.
  pub effect fn renameLifetime(value: &Shared<Lifetime>, owner: &DeclarationId, replacement: &DeclarationId) -> Shared<Lifetime>
  ! OutOfMemoryError ? &mut Allocator {
    let arguments = Vector.make<Argument>()
    let bindings = Vector.make<Binding>()
    return run rewriteLifetime(value, owner, Vector.asSlice<Argument>(&arguments), &Option.some<DeclarationId>(run DeclarationId.copy(replacement)), false, Vector.asSlice<Binding>(&bindings))
  }
}

effect fn rewriteLifetime(value: &Shared<Lifetime>, owner: &DeclarationId, arguments: &[Argument], fresh: &Option<DeclarationId>, instantiate: bool, bindings: &[Binding]) -> Shared<Lifetime>
! OutOfMemoryError ? &mut Allocator {
  if instantiate {
    let exactSupplied = Shared.with<Lifetime, Option<Argument>>(value,
      fn(region: &Lifetime) -> Option<Argument> {
        if let Lifetime.Parameter {declaration, ordinal} = &region.* {
          return exactArgument(bindings, &declaration, ordinal)
        }
        return Option.none<Argument>()
      })
    if let Option<Argument>.Some {value: Argument.Lifetime {value: bound}} = move exactSupplied {
      return move bound
    }
    let ordinal = Shared.with<Lifetime, usize>(value, fn(region: &Lifetime) -> usize {
      return ownedLifetimeOrdinal(region, owner)
    })
    if ordinal < arguments.length {
      if let Argument.Lifetime {value: supplied} = &arguments[ordinal] {
        return Shared.clone<Lifetime>(&supplied)
      }
    }
  }
  if let Option<DeclarationId>.Some {value: replacement} = &fresh.* {
    let ordinal = Shared.with<Lifetime, usize>(value, fn(region: &Lifetime) -> usize {
      return ownedLifetimeOrdinal(region, owner)
    })
    if ordinal != usize.MAX {
      return run Shared.make<Lifetime>(Lifetime.Parameter {declaration: run DeclarationId.copy(&replacement), ordinal: ordinal})
    }
  }
  return Shared.clone<Lifetime>(value)
}

effect fn rewriteEnvironment(value: &Shared<Intersection>, owner: &DeclarationId, arguments: &[Argument], fresh: &Option<DeclarationId>, instantiate: bool, bindings: &[Binding]) -> Shared<Intersection>
! OutOfMemoryError ? &mut Allocator {
  if !instantiate {
    if let Option<DeclarationId>.None = &fresh.* { return Shared.clone<Intersection>(value) }
  }
  let mut regions = Vector.make<Shared<Lifetime>>()
  let count = environmentSize(value)
  let mut at = usize.ZERO
  while at < count {
    if let Option<Shared<Lifetime>>.Some {value: region} = move environmentMember(value, at) {
      run Vector.append<Shared<Lifetime>>(&mut regions, run rewriteLifetime(&region, owner, arguments, fresh, instantiate, bindings))
    }
    at = at + usize.ONE
  }
  return run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions)))
}

effect fn rewriteOutlives(value: &Vector<Outlives>, owner: &DeclarationId, arguments: &[Argument], fresh: &Option<DeclarationId>, instantiate: bool, bindings: &[Binding]) -> Vector<Outlives>
! OutOfMemoryError ? &mut Allocator {
  let mut result = Vector.make<Outlives>()
  let listed = Vector.asSlice<Outlives>(value)
  let mut at = usize.ZERO
  while at < listed.length {
    run Vector.append<Outlives>(&mut result, Outlives {
      longer: run rewriteLifetime(&listed[at].longer, owner, arguments, fresh, instantiate, bindings),
      shorter: run rewriteLifetime(&listed[at].shorter, owner, arguments, fresh, instantiate, bindings),
    })
    at = at + usize.ONE
  }
  return move result
}

fn accessCode(value: Access) -> u64 {
  return match value {
    Access.Shared => 0
    Access.Mutable => 1
  }
}

fn modeCode(value: CallableMode) -> u64 {
  return match value {
    CallableMode.Shared => 0
    CallableMode.Mutable => 1
    CallableMode.Once => 2
  }
}

impl Type {
  /// The generating occurrence and member types of an anonymous aggregate; absent otherwise.
  pub effect fn anonymousParts(value: &Shared<Type>) -> Option<AnonymousParts> ! OutOfMemoryError ? &mut Allocator {
    let occurrence = Shared.with<Type, Option<Shared<AnonymousOccurrence>>>(
      value,
      fn(node: &Type) -> Option<Shared<AnonymousOccurrence>> {
        return match & node.* {
          Type.Anonymous {occurrence, ..} => Option.some<Shared<AnonymousOccurrence>>(Shared.clone<AnonymousOccurrence>(&occurrence))
          _ => Option.none<Shared<AnonymousOccurrence>>()
        }
      },
    )
    let selected = match move occurrence {
      Option<Shared<AnonymousOccurrence>>.Some {value: found} => move found
      Option<Shared<AnonymousOccurrence>>.None => { return Option.none<AnonymousParts>() }
    }
    let node = run nodeCopy(value)
    if let Type.Anonymous {members, ..} = move node {
      return Option.some<AnonymousParts>(AnonymousParts {occurrence: move selected, members: move members})
    }
    return Option.none<AnonymousParts>()
  }
  /// Encodes runtime identity with erased lifetimes, canonical unions and canonical rows.
  /// `owner` supplies the declaration context for walking shared nodes; it is not encoded.
  pub effect fn runtimeEncoding(value: &Shared<Type>, owner: &DeclarationId) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
    let node = run nodeCopy(value)
    let mut output = Bytes.make()
    let kind = nodeKind(&node)
    run RuntimeEncoding.word(&mut output, usize.toU64(kind))
    match & node {
      Type.Primitive {name} => {
        run RuntimeEncoding.field(&mut output, Bytes.asSlice(&name))
      }
      Type.Nominal {declaration, arguments, ..} => {
        run RuntimeEncoding.declaration(&mut output, &declaration)
        run encodeArguments(&mut output, Vector.asSlice<Argument>(&arguments), owner)
      }
      Type.NamedRepresentation {declaration, arguments, ..} => {
        run RuntimeEncoding.declaration(&mut output, &declaration)
        run encodeArguments(&mut output, Vector.asSlice<Argument>(&arguments), owner)
      }
      Type.OpaqueRepresentation {producer, arguments, ..} => {
        run RuntimeEncoding.declaration(&mut output, &producer)
        run encodeArguments(&mut output, Vector.asSlice<Argument>(&arguments), owner)
      }
      Type.Parameter {declaration, ordinal} => {
        run RuntimeEncoding.declaration(&mut output, &declaration)
        run RuntimeEncoding.word(&mut output, usize.toU64(ordinal))
      }
      Type.Reference {referent, access, ..} => {
        run RuntimeEncoding.word(&mut output, accessCode(access))
        run encodeChild(&mut output, &referent, owner)
      }
      Type.Slice {element, access, ..} => {
        run RuntimeEncoding.word(&mut output, accessCode(access))
        run encodeChild(&mut output, &element, owner)
      }
      Type.Pointer {pointee, access, nullable, multiplicity, alignment} => {
        run RuntimeEncoding.word(&mut output, accessCode(access))
        run RuntimeEncoding.word(&mut output, boolCode(nullable))
        run RuntimeEncoding.word(
          &mut output,
          match multiplicity {
            Multiplicity.Single => 0
            Multiplicity.Many => 1
          },
        )
        match & alignment {
          Option<u64>.Some {value: aligned} => {
            run RuntimeEncoding.word(&mut output, 1)
            run RuntimeEncoding.word(&mut output, aligned)
          }
          Option<u64>.None => {
            run RuntimeEncoding.word(&mut output, 0)
          }
        }
        run encodeChild(&mut output, &pointee, owner)
      }
      Type.Array {element, extent} => {
        run RuntimeEncoding.field(&mut output, Bytes.asSlice(&extent))
        run encodeChild(&mut output, &element, owner)
      }
      Type.Union {members} => {
        let mut encodings = Vector.make<Bytes>()
        let listed = Vector.asSlice<Shared<Type>>(&members)
        let mut at = usize.ZERO
        while at < listed.length {
          run Vector.append<Bytes>(&mut encodings, run Type.runtimeEncoding(&listed[at], owner))
          at = at + usize.ONE
        }
        run RuntimeEncoding.set(&mut output, &encodings)
      }
      Type.Callable {mode, isUnsafe, parameters, result, ..} => {
        run RuntimeEncoding.word(&mut output, modeCode(mode))
        run RuntimeEncoding.word(&mut output, boolCode(isUnsafe))
        let listed = Vector.asSlice<Shared<Type>>(&parameters)
        run RuntimeEncoding.word(&mut output, usize.toU64(listed.length))
        let mut at = usize.ZERO
        while at < listed.length {
          run encodeChild(&mut output, &listed[at], owner)
          at = at + usize.ONE
        }
        run encodeChild(&mut output, &result, owner)
      }
      Type.Effect {mode, success, failure, requirements, ..} => {
        run RuntimeEncoding.word(&mut output, modeCode(mode))
        run encodeChild(&mut output, &success, owner)
        run encodeChild(&mut output, &failure, owner)
        let row = run Row.runtimeEncoding(&requirements, owner)
        run RuntimeEncoding.field(&mut output, Bytes.asSlice(&row))
      }
      Type.TypeDescriptor {owner: described} => run encodeChild(&mut output, &described, owner)
      Type.Anonymous {occurrence, members} => {
        let syntax = Shared.with<AnonymousOccurrence, usize>(&occurrence, fn(value: &AnonymousOccurrence) -> usize { return value.syntax })
        let generator = Shared.with<AnonymousOccurrence, Shared<DeclarationId>>(&occurrence, fn(value: &AnonymousOccurrence) -> Shared<DeclarationId> {
          return Shared.clone<DeclarationId>(&value.declaration)
        })
        let declaration = run DeclarationId.copyShared(&generator)
        run RuntimeEncoding.declaration(&mut output, &declaration)
        let listed = Vector.asSlice<Shared<Type>>(&members)
        run RuntimeEncoding.word(&mut output, usize.toU64(syntax))
        run RuntimeEncoding.word(&mut output, usize.toU64(listed.length))
        let mut at = usize.ZERO
        while at < listed.length {
          run encodeChild(&mut output, &listed[at], owner)
          at = at + usize.ONE
        }
      }
      _ => {}
    }
    return move output
  }
}

effect fn encodeChild(output: &mut Bytes, value: &Shared<Type>, owner: &DeclarationId) -> ()
! OutOfMemoryError
? &mut Allocator {
  let encoding = run Type.runtimeEncoding(value, owner)
  return run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&encoding))
}

effect fn encodeArguments(output: &mut Bytes, values: &[Argument], owner: &DeclarationId) -> ()
! OutOfMemoryError
? &mut Allocator {
  run RuntimeEncoding.word(&mut output.*, usize.toU64(values.length))
  let mut at = usize.ZERO
  while at < values.length {
    let encoding = run Argument.runtimeEncoding(&values[at], owner)
    run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&encoding))
    at = at + usize.ONE
  }
  return ()
}

impl Argument {
  /// The canonical runtime projection of one ordered binder argument.
  pub effect fn runtimeEncoding(value: &Argument, owner: &DeclarationId) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut output = Bytes.make()
    match & value.* {
      Argument.Type {value: ty} => {
        run RuntimeEncoding.word(&mut output, 0)
        run encodeChild(&mut output, &ty, owner)
      }
      Argument.Lifetime {..} => {
        run RuntimeEncoding.word(&mut output, 1)
      }
      Argument.Row {value: row} => {
        run RuntimeEncoding.word(&mut output, 2)
        let encoding = run Row.runtimeEncoding(&row, owner)
        run RuntimeEncoding.field(&mut output, Bytes.asSlice(&encoding))
      }
    }
    return move output
  }
}

struct EncodedRequirement {
  key: Bytes
  access: Access
}

impl Row {
  /// Encodes sorted service-role keys, merging lifetime-erased duplicates at strongest access.
  pub effect fn runtimeEncoding(value: &Shared<Row>, owner: &DeclarationId) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut entries = Vector.make<EncodedRequirement>()
    let count = Shared.with<Row, usize>(value, rowEntryCount)
    let mut at = usize.ZERO
    while at < count {
      let entry = entryAt(value, at)
      let mut key = run Type.runtimeEncoding(&entry.capability, owner)
      match & entry.roleType {
        Option<Shared<Type>>.Some {value: roleValue} => {
          run RuntimeEncoding.word(&mut key, 1)
          run encodeChild(&mut key, &roleValue, owner)
        }
        Option<Shared<Type>>.None => {
          run RuntimeEncoding.word(&mut key, 0)
        }
      }
      let known = Vector.asMutSlice<EncodedRequirement>(&mut entries)
      let mut found = false
      let mut check = usize.ZERO
      while check < known.length {
        if RuntimeEncoding.equals(Bytes.asSlice(&known[check].key), Bytes.asSlice(&key)) {
          found = true
          if entry.access == Access.Mutable {
            known[check].access = Access.Mutable
          }
          break
        }
        check = check + usize.ONE
      }
      if !found {
        run Vector.append<EncodedRequirement>(
          &mut entries,
          EncodedRequirement {key: move key, access: entry.access},
        )
      }
      at = at + usize.ONE
    }
    let mut encoded = Vector.make<Bytes>()
    let listed = Vector.asSlice<EncodedRequirement>(&entries)
    at = usize.ZERO
    while at < listed.length {
      let mut entry = run Bytes.copy(Bytes.asSlice(&listed[at].key))
      run RuntimeEncoding.word(&mut entry, accessCode(listed[at].access))
      run Vector.append<Bytes>(&mut encoded, move entry)
      at = at + usize.ONE
    }
    let mut output = Bytes.make()
    run RuntimeEncoding.set(&mut output, &encoded)
    let mut parameters = Vector.make<Bytes>()
    let parameterCount = Shared.with<Row, usize>(value, rowParameterCount)
    at = usize.ZERO
    while at < parameterCount {
      let parameter = Shared.with<Row, RowParameter>(
        value,
        fn(row: &Row) -> RowParameter {
          return rowParameterAt(row, at)
        },
      )
      let selected = Option.some<DeclarationId>(
        run DeclarationId.copyShared(&parameter.declaration),
      )
      let declaration = match move selected {
        Option<DeclarationId>.Some {value: id} => move id
        Option<DeclarationId>.None => {
          at = at + usize.ONE
          continue
        }
      }
      let mut encoding = Bytes.make()
      run RuntimeEncoding.declaration(&mut encoding, &declaration)
      run RuntimeEncoding.word(&mut encoding, usize.toU64(parameter.ordinal))
      run Vector.append<Bytes>(&mut parameters, move encoding)
      at = at + usize.ONE
    }
    run RuntimeEncoding.set(&mut output, &parameters)
    return move output
  }
}

fn fillNodeText(input: &Bytes, output: &mut Bytes) -> bool {
  let bytes = Bytes.asSlice(input)
  let target = Bytes.asMutSlice(&mut output.*)
  let mut at = usize.ZERO
  while at < bytes.length {
    target[at] = bytes[at]
    at = at + usize.ONE
  }
  return true
}

fn boolCode(value: bool) -> u64 {
  if value {
    return 1
  }
  return 0
}

fn firstNormalized(value: &Vector<Shared<Type>>) -> Shared<Type> {
  let listed = Vector.asSlice<Shared<Type>>(value)
  return Shared.clone<Type>(&listed[usize.ZERO])
}

fn nodeArgumentIn(arguments: &Vector<Argument>, at: usize) -> Argument {
  let listed = Vector.asSlice<Argument>(arguments)
  return Argument.copy(&listed[at])
}

impl Argument {
  /// Copies an argument handle without entering its shared type, row or lifetime.
  pub fn copy(value: &Argument) -> Argument {
    return copyNodeArgument(value)
  }
}

fn nodeProjection(node: &Type, part: DeclarationPart, owner: usize, offset: usize) -> Option<
  DeclarationProjection,
> {
  return match & node.* {
    Type.Nominal {declaration, ..} => Option.some<DeclarationProjection>(
      DeclarationId.project(&declaration, part, owner, offset),
    )
    Type.NamedRepresentation {declaration, ..} => Option.some<DeclarationProjection>(
      DeclarationId.project(&declaration, part, owner, offset),
    )
    Type.OpaqueRepresentation {producer, ..} => Option.some<DeclarationProjection>(
      DeclarationId.project(&producer, part, owner, offset),
    )
    Type.Parameter {declaration, ..} => Option.some<DeclarationProjection>(
      DeclarationId.project(&declaration, part, owner, offset),
    )
    _ => Option.none<DeclarationProjection>()
  }
}

effect fn copyNodeDeclaration(source: &Shared<Type>) -> Option<DeclarationId>
! OutOfMemoryError
? &mut Allocator {
  let mut components = Vector.make<Bytes>()
  let mut section = usize.ZERO
  while section < 3 {
    let mut part = DeclarationPart.Path
    if section == usize.ZERO {
      part = DeclarationPart.Origin
    }
    if section == usize.ONE {
      part = DeclarationPart.Package
    }
    let measured = Shared.with<Type, Option<DeclarationProjection>>(
      source,
      fn(value: &Type) -> Option<DeclarationProjection> {
        return nodeProjection(value, part, usize.MAX, usize.MAX)
      },
    )
    let count = match move measured {
      Option<DeclarationProjection>.Some {value: field} => field.length
      Option<DeclarationProjection>.None => {
        return Option.none<DeclarationId>()
      }
    }
    let mut bytes = run Bytes.zeroed(count)
    let target = Bytes.asMutSlice(&mut bytes)
    let mut offset = usize.ZERO
    while offset < count {
      let selected = Shared.with<Type, Option<DeclarationProjection>>(
        source,
        fn(value: &Type) -> Option<DeclarationProjection> {
          return nodeProjection(value, part, usize.MAX, offset)
        },
      )
      match move selected {
        Option<DeclarationProjection>.Some {value: field} => {
          target[offset] = field.byte
        }
        Option<DeclarationProjection>.None => {
          return absurd<Option<DeclarationId>>()
        }
      }
      offset = offset + usize.ONE
    }
    run Vector.append<Bytes>(&mut components, move bytes)
    section = section + usize.ONE
  }
  let measured = Shared.with<Type, Option<DeclarationProjection>>(
    source,
    fn(value: &Type) -> Option<DeclarationProjection> {
      return nodeProjection(value, DeclarationPart.Owners, usize.MAX, usize.MAX)
    },
  )
  let count = match move measured {
    Option<DeclarationProjection>.Some {value: field} => field.length
    Option<DeclarationProjection>.None => {
      return absurd<Option<DeclarationId>>()
    }
  }
  let mut owners = Vector.make<OwnerStep>()
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared.with<Type, Option<DeclarationProjection>>(
      source,
      fn(value: &Type) -> Option<DeclarationProjection> {
        return nodeProjection(value, DeclarationPart.Owners, at, usize.MAX)
      },
    )
    let step = match move selected {
      Option<DeclarationProjection>.Some {value: field} => field
      Option<DeclarationProjection>.None => {
        return absurd<Option<DeclarationId>>()
      }
    }
    let mut name = Option.none<Bytes>()
    if step.named {
      let mut bytes = run Bytes.zeroed(step.length)
      let target = Bytes.asMutSlice(&mut bytes)
      let mut offset = usize.ZERO
      while offset < step.length {
        let selected = Shared.with<Type, Option<DeclarationProjection>>(
          source,
          fn(value: &Type) -> Option<DeclarationProjection> {
            return nodeProjection(value, DeclarationPart.Owners, at, offset)
          },
        )
        match move selected {
          Option<DeclarationProjection>.Some {value: field} => {
            target[offset] = field.byte
          }
          Option<DeclarationProjection>.None => {
            return absurd<Option<DeclarationId>>()
          }
        }
        offset = offset + usize.ONE
      }
      name = Option.some<Bytes>(move bytes)
    }
    run Vector.append<OwnerStep>(
      &mut owners,
      OwnerStep {kind: step.kind, occurrence: step.occurrence, name: move name},
    )
    at = at + usize.ONE
  }
  let path = match move Vector.pop<Bytes>(&mut components) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => {
      return absurd<Option<DeclarationId>>()
    }
  }
  let package = match move Vector.pop<Bytes>(&mut components) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => {
      return absurd<Option<DeclarationId>>()
    }
  }
  let origin = match move Vector.pop<Bytes>(&mut components) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => {
      return absurd<Option<DeclarationId>>()
    }
  }
  let assembled = run Effect.result(ModuleId.fromParts(move origin, move package, move path))
  let module = match move assembled {
    Result<ModuleId, InvalidModulePath>.Success {value} => move value
    Result<ModuleId, InvalidModulePath>.Failure {error: _} => { return absurd<Option<DeclarationId>>() }
  }
  return Option.some<DeclarationId>(DeclarationId.fromParts(move module, move owners))
}

// A missing field after selecting a concrete node kind is an implementation defect.
fn absurd<T>() -> T {
  let boom = 1 / 0
  return absurd<T>()
}
