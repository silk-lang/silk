//! Semantic identity for written types, lifetime relationships, and generic applications.
//!
//! # When to use
//! Use [`Type`] in signatures and typed bodies. Use [`equals`] to compare types from different
//! queries or source revisions without comparing allocation positions. Use [`Row`] for the
//! normalized requirement channel of an Effect contract.

import hir.Hir {Access, CallableMode, Multiplicity}
import semantic.DeclarationId {DeclarationId}
import semantic.Lifetime {Lifetime}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.pointer {Pointer}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// A canonical type resolved from a written declaration or type application.
pub union Type {
  /// One validated foundational type identified by its exact spelling.
  Primitive {
    /// The validated primitive spelling, independent of a source string table.
    pub name: Bytes,
  },
  /// The unit type.
  Unit,
  /// One canonical nominal declaration and its ordered type and lifetime arguments.
  Nominal {
    /// The complete canonical identity of the nominal declaration.
    pub declaration: DeclarationId,
    /// Whether the declaration is public; visibility does not change type identity.
    pub isPublic: bool,
    /// The ordered arguments of this nominal application; empty for a nongeneric declaration.
    pub arguments: Vector<Argument>,
  },
  /// One ordinary type parameter owned by a declaration, independent of its spelling.
  Parameter {
    /// The declaration that binds the parameter.
    pub declaration: DeclarationId,
    /// The parameter's position in its owner's complete binder list.
    pub ordinal: usize,
  },
  /// A UTF-8 view whose validity follows one lifetime.
  String {
    /// The validity relationship carried by this view.
    pub lifetime: Shared<Lifetime>,
  },
  /// A borrowed view of one referent with the written access mode.
  Reference {
    /// The referent's resolved type.
    pub referent: Shared<Type>,
    /// Shared or exclusive access.
    pub access: Access,
    /// The validity relationship of the borrow.
    pub lifetime: Shared<Lifetime>,
  },
  /// A borrowed runtime-length view of contiguous elements.
  Slice {
    /// The element's resolved type.
    pub element: Shared<Type>,
    /// Shared or exclusive access.
    pub access: Access,
    /// The validity relationship of the view.
    pub lifetime: Shared<Lifetime>,
  },
  /// A raw address with no loan or ownership claim.
  Pointer {
    /// The invariant pointee type.
    pub pointee: Shared<Type>,
    /// Whether the address permits writes.
    pub access: Access,
    /// Whether the address may be null.
    pub nullable: bool,
    /// Whether it addresses one value or a run.
    pub multiplicity: Multiplicity,
    /// Written minimum alignment; absence retains the semantic natural-alignment requirement.
    pub alignment: Option<u64>,
  },
  /// An authored fixed array with an exact, target-independent decimal extent.
  Array {pub element: Shared<Type>, pub extent: Bytes},
  /// A structural union: an unordered, duplicate-free set of two or more ordinary value types.
  ///
  /// The empty member set is `never`. A one-member union is represented by that member.
  Union {pub members: Vector<Shared<Type>>},
  /// A callable contract. Parameter order is identity; the environment is the captures' validity.
  Callable {
    /// Shared, exclusive, or consuming access to the captured environment.
    pub mode: CallableMode,
    /// Whether the final invocation requires an `unsafe` acknowledgement.
    pub isUnsafe: bool,
    /// The validity of the retained environment.
    pub environment: Shared<Lifetime>,
    /// The parameter types in written order.
    pub parameters: Vector<Shared<Type>>,
    /// The result type.
    pub result: Shared<Type>,
  },
  /// A deferred computation with independent success, failure, and requirement channels.
  Effect {
    /// Shared, exclusive, or consuming run access.
    pub mode: CallableMode,
    /// The validity of the retained environment.
    pub environment: Shared<Lifetime>,
    /// The value produced on success.
    pub success: Shared<Type>,
    /// The ordinary typed-failure type; `never` when omitted.
    pub failure: Shared<Type>,
    /// The normalized requirement row; empty when omitted.
    pub requirements: Shared<Row>,
  },
}

/// One requirement-row entry, keyed by a service application and a nominal role.
pub struct Requirement {
  /// The service application the Effect needs when it runs.
  pub capability: Shared<Type>
  /// The nominal role declaration's type; absent selects the implicit default role.
  pub roleType: Option<Shared<Type>>
  /// The strongest access required for this key; not part of the key.
  pub access: Access
}

/// One declaration-owned `?R` requirement-row parameter, independent of its spelling.
pub struct RowParameter {
  /// The declaration that binds the parameter.
  pub declaration: DeclarationId
  /// The parameter's position in its owner's complete binder list.
  pub ordinal: usize
}

/// A normalized requirement row. Entry order and repetition do not affect identity.
pub struct Row {
  /// Distinct service-role keys, each with its strongest required access.
  pub entries: Vector<Requirement>
  /// Distinct row parameters whose rows this row includes.
  pub parameters: Vector<RowParameter>
}

/// One canonical generic argument, with its type or lifetime kind retained.
pub union Argument {
  /// An ordinary type argument.
  Type {
    /// The resolved type supplied at this binder position.
    pub value: Shared<Type>,
  },
  /// A validity lifetime argument.
  Lifetime {
    /// The resolved lifetime supplied at this binder position.
    pub value: Shared<Lifetime>,
  },
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn addressOf(value: &Type) -> usize {
  return Pointer.address<Type>(Pointer.fromRef<Type>(value))
}

// Structural comparison never holds a type while entering one of its children. Substitution can
// place one handle both as a node on one side and as a descendant on the other, as in
// `T | Box<T>` applied to `Box<i32>`, so each level compares its header under short borrows and
// recurses only after releasing them.
fn sameShared(left: &Shared<Type>, right: &Shared<Type>) -> bool {
  if Shared.with<Type, usize>(left, addressOf) == Shared.with<Type, usize>(right, addressOf) {
    return true
  }
  let headers = Shared.with<Type, bool>(
    left,
    fn(first: &Type) -> bool {
      return headWith(first, right)
    },
  )
  if !headers {
    return false
  }
  let count = Shared.with<Type, usize>(left, childCount)
  let mut at = usize.ZERO
  while at < count {
    let first = Shared.with<Type, Option<Shared<Type>>>(
      left,
      fn(value: &Type) -> Option<Shared<Type>> {
        return childAt(value, at)
      },
    )
    let second = Shared.with<Type, Option<Shared<Type>>>(
      right,
      fn(value: &Type) -> Option<Shared<Type>> {
        return childAt(value, at)
      },
    )
    if !sameChild(&first, &second) {
      return false
    }
    at = at + usize.ONE
  }
  let members = Shared.with<Type, usize>(left, unionLength)
  if members != usize.MAX && !sameUnionMembers(left, right, members) {
    return false
  }
  let firstRow = Shared.with<Type, Option<Shared<Row>>>(left, rowOf)
  let secondRow = Shared.with<Type, Option<Shared<Row>>>(right, rowOf)
  if let Option<Shared<Row>>.Some {value: fromRow} = move firstRow {
    if let Option<Shared<Row>>.Some {value: toRow} = move secondRow {
      return sameRows(&fromRow, &toRow)
    }
    return false
  }
  return true
}

fn sameChild(left: &Option<Shared<Type>>, right: &Option<Shared<Type>>) -> bool {
  return match & left.* {
    Option<Shared<Type>>.Some {value} => match & right.* {
      Option<Shared<Type>>.Some {value: compared} => sameShared(&value, &compared)
      Option<Shared<Type>>.None => false
    }
    Option<Shared<Type>>.None => match & right.* {
      Option<Shared<Type>>.Some {value: _} => false
      Option<Shared<Type>>.None => true
    }
  }
}

fn memberOf(members: &Shared<Type>, at: usize) -> Option<Shared<Type>> {
  return Shared.with<Type, Option<Shared<Type>>>(
    members,
    fn(value: &Type) -> Option<Shared<Type>> {
      return unionMemberAt(value, at)
    },
  )
}

// Headers already matched the member counts; duplicate-free sets are equal by inclusion.
fn sameUnionMembers(left: &Shared<Type>, right: &Shared<Type>, count: usize) -> bool {
  let mut at = usize.ZERO
  while at < count {
    let member = memberOf(left, at)
    let mut found = false
    let mut other = usize.ZERO
    while !found && other < count {
      found = sameChild(&member, &memberOf(right, other))
      other = other + usize.ONE
    }
    if !found {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn headWith(first: &Type, right: &Shared<Type>) -> bool {
  return Shared.with<Type, bool>(
    right,
    fn(second: &Type) -> bool {
      return sameHead(first, second)
    },
  )
}

// The number of ordered child types compared by position: type arguments (a lifetime argument
// position has none), a borrow or array element, callable parameters then result, or an Effect's
// success then failure. Union members and Effect rows are compared separately as sets.
fn childCount(value: &Type) -> usize {
  return match & value.* {
    Type.Nominal {arguments, ..} => Vector.length<Argument>(&arguments)
    Type.Reference {..} => usize.ONE
    Type.Slice {..} => usize.ONE
    Type.Pointer {..} => usize.ONE
    Type.Array {..} => usize.ONE
    Type.Callable {parameters, ..} => Vector.length<Shared<Type>>(&parameters) + usize.ONE
    Type.Effect {..} => 2
    _ => usize.ZERO
  }
}

fn childAt(value: &Type, at: usize) -> Option<Shared<Type>> {
  return match & value.* {
    Type.Nominal {arguments, ..} => {
      let values = Vector.asSlice<Argument>(&arguments)
      return match & values[at] {
        Argument.Type {value: argument} => Option.some<Shared<Type>>(Shared.clone<Type>(&argument))
        Argument.Lifetime {..} => Option.none<Shared<Type>>()
      }
    }
    Type.Reference {referent, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&referent))
    Type.Slice {element, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&element))
    Type.Pointer {pointee, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&pointee))
    Type.Array {element, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&element))
    Type.Callable {parameters, result, ..} => {
      let values = Vector.asSlice<Shared<Type>>(&parameters)
      if at < values.length {
        return Option.some<Shared<Type>>(Shared.clone<Type>(&values[at]))
      }
      return Option.some<Shared<Type>>(Shared.clone<Type>(&result))
    }
    Type.Effect {success, failure, ..} => {
      if at == usize.ZERO {
        return Option.some<Shared<Type>>(Shared.clone<Type>(&success))
      }
      return Option.some<Shared<Type>>(Shared.clone<Type>(&failure))
    }
    _ => Option.none<Shared<Type>>()
  }
}

fn rowOf(value: &Type) -> Option<Shared<Row>> {
  return match & value.* {
    Type.Effect {requirements, ..} => Option.some<Shared<Row>>(Shared.clone<Row>(&requirements))
    _ => Option.none<Shared<Row>>()
  }
}

fn sameArgumentHead(left: &Argument, right: &Argument) -> bool {
  return match & left.* {
    Argument.Type {..} => match & right.* {
      Argument.Type {..} => true
      _ => false
    }
    Argument.Lifetime {value} => match & right.* {
      Argument.Lifetime {value: compared} => sameLifetime(&value, &compared)
      _ => false
    }
  }
}

fn sameLifetime(left: &Shared<Lifetime>, right: &Shared<Lifetime>) -> bool {
  if Shared.with<Lifetime, usize>(left, lifetimeAddress) == Shared.with<Lifetime, usize>(
    right,
    lifetimeAddress,
  ) {
    return true
  }
  return Shared.with<Lifetime, bool>(
    left,
    fn(first: &Lifetime) -> bool {
      return sameLifetimeWith(first, right)
    },
  )
}

fn sameLifetimeWith(first: &Lifetime, right: &Shared<Lifetime>) -> bool {
  return Shared.with<Lifetime, bool>(
    right,
    fn(second: &Lifetime) -> bool {
      return Lifetime.equals(first, second)
    },
  )
}

fn lifetimeAddress(value: &Lifetime) -> usize {
  return Pointer.address<Lifetime>(Pointer.fromRef<Lifetime>(value))
}

fn sameAlignment(left: &Option<u64>, right: &Option<u64>) -> bool {
  return match & left.* {
    Option<u64>.Some {value} => match & right.* {
      Option<u64>.Some {value: compared} => value == compared
      Option<u64>.None => false
    }
    Option<u64>.None => match & right.* {
      Option<u64>.Some {value: _} => false
      Option<u64>.None => true
    }
  }
}

fn sameAccess(left: Access, right: Access) -> bool {
  return match left {
    Access.Shared => match right {
      Access.Shared => true
      Access.Mutable => false
    }
    Access.Mutable => match right {
      Access.Shared => false
      Access.Mutable => true
    }
  }
}

fn sameMode(left: CallableMode, right: CallableMode) -> bool {
  return match left {
    CallableMode.Shared => match right {
      CallableMode.Shared => true
      _ => false
    }
    CallableMode.Mutable => match right {
      CallableMode.Mutable => true
      _ => false
    }
    CallableMode.Once => match right {
      CallableMode.Once => true
      _ => false
    }
  }
}

fn sameMultiplicity(left: Multiplicity, right: Multiplicity) -> bool {
  return match left {
    Multiplicity.Single => match right {
      Multiplicity.Single => true
      Multiplicity.Many => false
    }
    Multiplicity.Many => match right {
      Multiplicity.Single => false
      Multiplicity.Many => true
    }
  }
}

fn unionLength(value: &Type) -> usize {
  return match & value.* {
    Type.Union {members} => Vector.length<Shared<Type>>(&members)
    _ => usize.MAX
  }
}

fn unionMemberAt(value: &Type, at: usize) -> Option<Shared<Type>> {
  if let Type.Union {members} = &value.* {
    let values = Vector.asSlice<Shared<Type>>(&members)
    return Option.some<Shared<Type>>(Shared.clone<Type>(&values[at]))
  }
  return Option.none<Shared<Type>>()
}

fn containsType(members: &[Shared<Type>], candidate: &Shared<Type>) -> bool {
  let mut at = usize.ZERO
  while at < members.length {
    if sameShared(&members[at], candidate) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn sameRole(left: &Option<Shared<Type>>, right: &Option<Shared<Type>>) -> bool {
  return match & left.* {
    Option<Shared<Type>>.Some {value} => match & right.* {
      Option<Shared<Type>>.Some {value: compared} => sameShared(&value, &compared)
      Option<Shared<Type>>.None => false
    }
    Option<Shared<Type>>.None => match & right.* {
      Option<Shared<Type>>.Some {value: _} => false
      Option<Shared<Type>>.None => true
    }
  }
}

fn sameKey(left: &Requirement, right: &Requirement) -> bool {
  return sameRole(&left.roleType, &right.roleType) && sameShared(
    &left.capability,
    &right.capability,
  )
}

fn keyAt(entries: &[Requirement], candidate: &Requirement) -> usize {
  let mut at = usize.ZERO
  while at < entries.length {
    if sameKey(&entries[at], candidate) {
      return at
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn hasParameter(parameters: &[RowParameter], candidate: &RowParameter) -> bool {
  let mut at = usize.ZERO
  while at < parameters.length {
    if parameters[at].ordinal == candidate.ordinal && DeclarationId.equals(
      &parameters[at].declaration,
      &candidate.declaration,
    ) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn rowAddress(value: &Row) -> usize {
  return Pointer.address<Row>(Pointer.fromRef<Row>(value))
}

fn rowHeadWith(first: &Row, right: &Shared<Row>) -> bool {
  return Shared.with<Row, bool>(
    right,
    fn(second: &Row) -> bool {
      return sameRowHead(first, second)
    },
  )
}

// Entry counts and row parameters; parameters hold no types, so they compare under the borrows.
fn sameRowHead(first: &Row, second: &Row) -> bool {
  let firstParameters = Vector.asSlice<RowParameter>(&first.parameters)
  let secondParameters = Vector.asSlice<RowParameter>(&second.parameters)
  if Vector.length<Requirement>(&first.entries) != Vector.length<Requirement>(&second.entries) || firstParameters.length != secondParameters.length {
    return false
  }
  let mut at = usize.ZERO
  while at < firstParameters.length {
    if !hasParameter(secondParameters, &firstParameters[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn entryCapability(row: &Row, at: usize) -> Shared<Type> {
  let entries = Vector.asSlice<Requirement>(&row.entries)
  return Shared.clone<Type>(&entries[at].capability)
}

fn entryRole(row: &Row, at: usize) -> Option<Shared<Type>> {
  let entries = Vector.asSlice<Requirement>(&row.entries)
  return match & entries[at].roleType {
    Option<Shared<Type>>.Some {value} => Option.some<Shared<Type>>(Shared.clone<Type>(&value))
    Option<Shared<Type>>.None => Option.none<Shared<Type>>()
  }
}

fn entryAccess(row: &Row, at: usize) -> Access {
  let entries = Vector.asSlice<Requirement>(&row.entries)
  return entries[at].access
}

fn entryAt(row: &Shared<Row>, at: usize) -> Requirement {
  return Requirement {
    capability: Shared.with<Row, Shared<Type>>(
      row,
      fn(value: &Row) -> Shared<Type> {
        return entryCapability(value, at)
      },
    ),
    roleType: Shared.with<Row, Option<Shared<Type>>>(
      row,
      fn(value: &Row) -> Option<Shared<Type>> {
        return entryRole(value, at)
      },
    ),
    access: Shared.with<Row, Access>(
      row,
      fn(value: &Row) -> Access {
        return entryAccess(value, at)
      },
    ),
  }
}

// Rows compare as sets of keys with equal access. Entry types are compared only after the row
// borrows are released, for the same reason as `sameShared`.
fn sameRows(left: &Shared<Row>, right: &Shared<Row>) -> bool {
  if Shared.with<Row, usize>(left, rowAddress) == Shared.with<Row, usize>(right, rowAddress) {
    return true
  }
  let headers = Shared.with<Row, bool>(
    left,
    fn(first: &Row) -> bool {
      return rowHeadWith(first, right)
    },
  )
  if !headers {
    return false
  }
  let count = Shared.with<Row, usize>(
    left,
    fn(value: &Row) -> usize {
      return Vector.length<Requirement>(&value.entries)
    },
  )
  let mut at = usize.ZERO
  while at < count {
    let entry = entryAt(left, at)
    let mut matched = false
    let mut other = usize.ZERO
    while !matched && other < count {
      let candidate = entryAt(right, other)
      if sameKey(&entry, &candidate) {
        if !sameAccess(entry.access, candidate.access) {
          return false
        }
        matched = true
      }
      other = other + usize.ONE
    }
    if !matched {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

impl Row {
  /// Creates the empty row written by omitting `? R` or writing `? never`.
  pub fn empty() -> Row {
    return Row {entries: Vector.make<Requirement>(), parameters: Vector.make<RowParameter>()}
  }
  /// Adds one entry, keeping the strongest access when its service-role key is already present.
  pub effect fn require(self: &mut Self, requirement: Requirement) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let found = keyAt(Vector.asSlice<Requirement>(&self.entries), &requirement)
    if found == usize.MAX {
      run Vector.append<Requirement>(&mut self.entries, move requirement)
      return ()
    }
    // Exclusive access is the stronger requirement for one key.
    if !sameAccess(requirement.access, Access.Shared) {
      let entries = Vector.asMutSlice<Requirement>(&mut self.entries)
      entries[found].access = Access.Mutable
    }
    return ()
  }
  /// Adds one row parameter unless the row already includes it.
  pub effect fn include(self: &mut Self, parameter: RowParameter) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    if !hasParameter(Vector.asSlice<RowParameter>(&self.parameters), &parameter) {
      run Vector.append<RowParameter>(&mut self.parameters, move parameter)
    }
    return ()
  }
  /// Reports whether two shared rows have the same keys, accesses, and row parameters.
  pub fn equalsShared(left: &Shared<Row>, right: &Shared<Row>) -> bool {
    return sameRows(left, right)
  }
}

impl Type {
  /// Adds one union member, flattening a nested union and dropping a repeated member.
  pub effect fn joinMember(members: &mut Vector<Shared<Type>>, member: &Shared<Type>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let count = Shared.with<Type, usize>(member, unionLength)
    if count != usize.MAX {
      let mut at = usize.ZERO
      while at < count {
        let part = Shared.with<Type, Option<Shared<Type>>>(
          member,
          fn(value: &Type) -> Option<Shared<Type>> {
            return unionMemberAt(value, at)
          },
        )
        if let Option<Shared<Type>>.Some {value: nested} = move part {
          if !containsType(Vector.asSlice<Shared<Type>>(&members.*), &nested) {
            run Vector.append<Shared<Type>>(&mut members.*, move nested)
          }
        }
        at = at + usize.ONE
      }
      return ()
    }
    if !containsType(Vector.asSlice<Shared<Type>>(&members.*), member) {
      run Vector.append<Shared<Type>>(&mut members.*, Shared.clone<Type>(member))
    }
    return ()
  }
  /// Reports whether two shared types have the same semantic identity.
  ///
  /// # Details
  ///
  /// Allocation addresses are only a shortcut, never identity. Primitive names differ by spelling.
  /// A nominal application compares the kinds and values of its ordered arguments. Parameters
  /// compare declaration and ordinal; borrowed views compare their lifetime, access, and element
  /// type. Raw pointers compare their written qualifiers. Callables compare mode, safety,
  /// environment, and ordered signature; Effects compare run mode, environment, and channels.
  /// Unions and requirement rows compare as sets. Visibility does not change identity.
  ///
  /// # Gotchas
  ///
  /// Compare handles rather than borrowed values: after substitution one handle can occur at
  /// different depths on the two sides, and a held borrow cannot be entered again.
  pub fn equalsShared(left: &Shared<Type>, right: &Shared<Type>) -> bool {
    return sameShared(left, right)
  }
}

// Compares one level: the variant, spellings, declarations, ordinals, access, qualifiers, modes,
// lifetimes, extents, and child counts. Child types and rows are compared by the caller.
fn sameHead(first: &Type, second: &Type) -> bool {
  return match & first.* {
    Type.Primitive {name} => match & second.* {
      Type.Primitive {name: compared} => sameBytes(Bytes.asSlice(&name), Bytes.asSlice(&compared))
      _ => false
    }
    Type.Unit => match & second.* {
      Type.Unit => true
      _ => false
    }
    Type.Nominal {declaration, arguments, ..} => match & second.* {
      Type.Nominal {declaration: compared, arguments: otherArguments, ..} => {
        if !DeclarationId.equals(&declaration, &compared) {
          return false
        }
        let firstArguments = Vector.asSlice<Argument>(&arguments)
        let secondArguments = Vector.asSlice<Argument>(&otherArguments)
        if firstArguments.length != secondArguments.length {
          return false
        }
        let mut at = usize.ZERO
        while at < firstArguments.length {
          if !sameArgumentHead(&firstArguments[at], &secondArguments[at]) {
            return false
          }
          at = at + usize.ONE
        }
        return true
      }
      _ => false
    }
    Type.Parameter {declaration, ordinal} => match & second.* {
      Type.Parameter {declaration: compared, ordinal: otherOrdinal} => DeclarationId.equals(
        &declaration,
        &compared,
      ) && ordinal == otherOrdinal
      _ => false
    }
    Type.String {lifetime} => match & second.* {
      Type.String {lifetime: compared} => sameLifetime(&lifetime, &compared)
      _ => false
    }
    Type.Reference {access, lifetime, ..} => match & second.* {
      Type.Reference {access: otherAccess, lifetime: otherLifetime, ..} => sameAccess(
        access,
        otherAccess,
      ) && sameLifetime(&lifetime, &otherLifetime)
      _ => false
    }
    Type.Slice {access, lifetime, ..} => match & second.* {
      Type.Slice {access: otherAccess, lifetime: otherLifetime, ..} => sameAccess(
        access,
        otherAccess,
      ) && sameLifetime(&lifetime, &otherLifetime)
      _ => false
    }
    Type.Pointer {access, nullable, multiplicity, alignment, ..} => match & second.* {
      Type.Pointer {
        access: otherAccess,
        nullable: otherNullable,
        multiplicity: otherMultiplicity,
        alignment: otherAlignment,
        ..,
      } => sameAccess(access, otherAccess) && nullable == otherNullable && sameMultiplicity(
        multiplicity,
        otherMultiplicity,
      ) && sameAlignment(&alignment, &otherAlignment)
      _ => false
    }
    Type.Array {extent, ..} => match & second.* {
      Type.Array {extent: otherExtent, ..} => sameBytes(
        Bytes.asSlice(&extent),
        Bytes.asSlice(&otherExtent),
      )
      _ => false
    }
    Type.Union {members} => match & second.* {
      Type.Union {members: compared} => Vector.length<Shared<Type>>(&members) == Vector.length<
        Shared<Type>,
      >(&compared)
      _ => false
    }
    Type.Callable {mode, isUnsafe, environment, parameters, ..} => match & second.* {
      Type.Callable {
        mode: otherMode,
        isUnsafe: otherUnsafe,
        environment: otherEnvironment,
        parameters: otherParameters,
        ..,
      } => sameMode(mode, otherMode) && isUnsafe == otherUnsafe && sameLifetime(
        &environment,
        &otherEnvironment,
      ) && Vector.length<Shared<Type>>(&parameters) == Vector.length<Shared<Type>>(&otherParameters)
      _ => false
    }
    Type.Effect {mode, environment, ..} => match & second.* {
      Type.Effect {mode: otherMode, environment: otherEnvironment, ..} => sameMode(mode, otherMode) && sameLifetime(
        &environment,
        &otherEnvironment,
      )
      _ => false
    }
  }
}
