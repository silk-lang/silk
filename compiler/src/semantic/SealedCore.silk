//! Compiler-authenticated identities of sealed core owners.
//!
//! # When to use
//! Use this actor when a semantic rule must recognize a compiler-owned type rather than a
//! same-spelled source declaration. These identities never identify an indexed source module.

import hir.Hir {OwnerKind}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.Type {Argument, Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// The exact owner identity of canonical Allocation, including its reserved non-source origin.
pub fn allocationDeclaration(value: &DeclarationId) -> bool {
  let module = DeclarationId.moduleId(value)
  if !same(ModuleId.sourceOrigin(module), b"compiler-sealed-core") || !same(
    ModuleId.packageIdentity(module),
    b"silk",
  ) || !same(ModuleId.logicalPath(module), b"silk/core") {
    return false
  }
  let owners = DeclarationId.ownerSteps(value)
  if owners.length != usize.ONE {
    return false
  }
  if owners[usize.ZERO].kind != OwnerKind.Struct || owners[usize.ZERO].occurrence != usize.ZERO {
    return false
  }
  return match & owners[usize.ZERO].name {
    Option<Bytes>.Some {value: name} => same(Bytes.asSlice(&name), b"Allocation")
    _ => false
  }
}

/// Recognizes the sealed Allocation owner; malformed arguments cannot grant it source ownership.
pub fn allocationType(value: &Type) -> bool {
  return match & value.* {
    Type.Nominal {declaration, ..} => allocationDeclaration(&declaration)
    _ => false
  }
}

/// Mints the zero-argument Allocation type without admitting construction, layout or release.
pub effect fn allocation() -> Shared<Type> ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let module = run ModuleId.make(b"compiler-sealed-core", b"silk", b"silk/core")
  let mut owners = Vector.make<OwnerStep>()
  run Vector.append<OwnerStep>(
    &mut owners,
    OwnerStep {
      kind: OwnerKind.Struct,
      name: Option.some<Bytes>(run Bytes.copy(b"Allocation")),
      occurrence: usize.ZERO,
    },
  )
  return run Shared.make<Type>(
    Type.Nominal {
      declaration: DeclarationId.fromParts(move module, move owners),
      isPublic: true,
      arguments: Vector.make<Argument>(),
    },
  )
}
