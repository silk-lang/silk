//! Host operations for parallel compiler workers.
//!
//! Worker processes currently use GNU Linux on x86_64 or aarch64. Other compiler hosts expose
//! unavailable operations and no experiment environment variables, so checking remains serial.

import CompilerBug
import silk.mem.pointer {Pointer}

pub struct FrontierHost {}

static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "x86_64" || Intrinsic.targetArchitecture() == "aarch64") {
  unsafe extern "C" fn nativeFork() -> i32 as "fork"
  unsafe extern "C" fn nativeExit(status: i32) -> () as "_exit"
  @foreign(noCapture: .("status"))
  unsafe extern "C" fn nativeWaitpid(pid: i32, status: *mut i32, options: i32) -> i32 as "waitpid"
  unsafe extern "C" fn nativeTmpfile() -> ?*mut u8 as "tmpfile"
  unsafe extern "C" fn nativeFileno(stream: ?*mut u8) -> i32 as "fileno"
  unsafe extern "C" fn nativeFclose(stream: ?*mut u8) -> i32 as "fclose"
  @foreign(noCapture: .("name", "mode"))
  unsafe extern "C" fn nativeFopen(name: ?[*]const u8, mode: ?[*]const u8) -> ?*mut u8 as "fopen"
  unsafe extern "C" fn nativeLseek(fd: i32, offset: i64, whence: i32) -> i64 as "lseek"
  @foreign(noCapture: .("buffer"))
  unsafe extern "C" fn nativeRead(fd: i32, buffer: ?[*]mut u8, count: usize) -> isize as "read"
  @foreign(noCapture: .("buffer"))
  unsafe extern "C" fn nativeWrite(fd: i32, buffer: ?[*]const u8, count: usize) -> isize as "write"
  @foreign(noCapture: .("name"))
  unsafe extern "C" fn nativeGetenv(name: ?[*]const u8) -> ?[*]const u8 as "getenv"

  unsafe extern "C" fn nativeMmap(address: ?*mut u8, length: usize, protection: i32, flags: i32, fd: i32, offset: i64) -> ?[*]mut u64 as "mmap"
  unsafe extern "C" fn nativeMunmap(address: ?[*]mut u64, length: usize) -> i32 as "munmap"

  @foreign(noCapture: .("sockets"))
  unsafe extern "C" fn nativeSocketpair(domain: i32, kind: i32, protocol: i32, sockets: ?[*]mut i32) -> i32 as "socketpair"
  @foreign(noCapture: .("buffer"))
  unsafe extern "C" fn nativeSend(fd: i32, buffer: ?[*]const u8, length: usize, flags: i32) -> isize as "send"
  unsafe extern "C" fn nativeClose(fd: i32) -> i32 as "close"
  unsafe extern "C" fn nativeUsleep(microseconds: u32) -> i32 as "usleep"
  unsafe extern "C" fn nativeError() -> *mut i32 as "__errno_location"

  impl FrontierHost {
    pub fn available() -> bool { return true }
    pub fn yieldWorker() -> () { drop unsafe nativeUsleep(1000) }
    pub unsafe fn fork() -> i32 { return unsafe nativeFork() }
    pub unsafe fn exit(status: i32) -> () { return unsafe nativeExit(status) }
    pub unsafe fn wait(pid: i32, status: *mut i32, options: i32) -> i32 {
      while true {
        let result = unsafe nativeWaitpid(pid, status, options)
        if result >= 0 || unsafe Pointer.read<i32>(unsafe nativeError()) != 4 { return result }
      }
    }
    pub unsafe fn temporaryFile() -> ?*mut u8 { return unsafe nativeTmpfile() }
    pub unsafe fn descriptor(stream: ?*mut u8) -> i32 { return unsafe nativeFileno(stream) }
    pub unsafe fn closeFile(stream: ?*mut u8) -> i32 { return unsafe nativeFclose(stream) }
    pub unsafe fn openFile(name: ?[*]const u8, mode: ?[*]const u8) -> ?*mut u8 { return unsafe nativeFopen(name, mode) }
    pub unsafe fn seek(fd: i32, offset: i64, whence: i32) -> i64 { return unsafe nativeLseek(fd, offset, whence) }
    pub unsafe fn read(fd: i32, buffer: ?[*]mut u8, count: usize) -> isize { return unsafe nativeRead(fd, buffer, count) }
    pub unsafe fn write(fd: i32, buffer: ?[*]const u8, count: usize) -> isize { return unsafe nativeWrite(fd, buffer, count) }
    pub unsafe fn environment(name: ?[*]const u8) -> ?[*]const u8 { return unsafe nativeGetenv(name) }
    pub unsafe fn mapShared(length: usize) -> ?[*]mut u64 { return unsafe nativeMmap(Pointer.null<u8>(), length, 3, 33, -1, 0) }
    pub unsafe fn unmapShared(address: ?[*]mut u64, length: usize) -> i32 { return unsafe nativeMunmap(address, length) }
    pub unsafe fn socketPair(sockets: ?[*]mut i32) -> i32 { return unsafe nativeSocketpair(1, 1, 0, sockets) }
    pub unsafe fn send(fd: i32, buffer: ?[*]const u8, length: usize) -> isize { return unsafe nativeSend(fd, buffer, length, 16384) }
    pub unsafe fn close(fd: i32) -> i32 { return unsafe nativeClose(fd) }
  }
} else {
  impl FrontierHost {
    pub fn available() -> bool { return false }
    pub fn yieldWorker() -> () {}
    pub unsafe fn fork() -> i32 { return -1 }
    pub unsafe fn exit(status: i32) -> () { return CompilerBug.panic(b"parallel host unavailable") }
    pub unsafe fn wait(pid: i32, status: *mut i32, options: i32) -> i32 { return -1 }
    pub unsafe fn temporaryFile() -> ?*mut u8 { return Pointer.null<u8>() }
    pub unsafe fn descriptor(stream: ?*mut u8) -> i32 { return -1 }
    pub unsafe fn closeFile(stream: ?*mut u8) -> i32 { return -1 }
    pub unsafe fn openFile(name: ?[*]const u8, mode: ?[*]const u8) -> ?*mut u8 { return Pointer.null<u8>() }
    pub unsafe fn seek(fd: i32, offset: i64, whence: i32) -> i64 { return -1 }
    pub unsafe fn read(fd: i32, buffer: ?[*]mut u8, count: usize) -> isize { return -1 }
    pub unsafe fn write(fd: i32, buffer: ?[*]const u8, count: usize) -> isize { return -1 }
    pub unsafe fn environment(name: ?[*]const u8) -> ?[*]const u8 { return unsafe Pointer.bytes<u8>(Pointer.null<u8>()) }
    pub unsafe fn mapShared(length: usize) -> ?[*]mut u64 { return unsafe Intrinsic.pointerRequalify<?*mut u64, ?[*]mut u64>(Pointer.null<u64>()) }
    pub unsafe fn unmapShared(address: ?[*]mut u64, length: usize) -> i32 { return -1 }
    pub unsafe fn socketPair(sockets: ?[*]mut i32) -> i32 { return -1 }
    pub unsafe fn send(fd: i32, buffer: ?[*]const u8, length: usize) -> isize { return -1 }
    pub unsafe fn close(fd: i32) -> i32 { return -1 }
  }
}
