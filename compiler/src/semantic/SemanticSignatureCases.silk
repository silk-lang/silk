effect fn nameBucketRevisionClaims(stop: usize) -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("entry.silk")
  let original = run present("type Keeper = i32\n")
  let held = run Revision.publish(&Revision.make(), &entry, &original)
  let mut semantic = makeSemantic(run Revision.copy(&held))
  let mut request = Request.make()
  let absent = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Missing")
  run Testing.expect(!succeeded(&absent) && Semantic.requestDiscovered(&mut semantic, &request, &entry),
    "present negative name lookup rejects and reports its discovery")
  let bucketKey = firstNameStartKey(Semantic.eventLog(&semantic))
  run Testing.expect(bucketKey != usize.MAX && startsForKey(Semantic.eventLog(&semantic), bucketKey) == usize.ONE,
    "negative name bucket has one producer start")
  if stop == usize.ONE { return () }

  let unrelated = run present("type Keeper = i32\ntype Other = bool\n")
  let unrelatedRevision = run Revision.publish(&held, &entry, &unrelated)
  run Semantic.update(&mut semantic, run Revision.copy(&unrelatedRevision))
  let mut unchangedRequest = Request.make()
  let unchanged = run Semantic.demandAlias(&mut semantic, &mut unchangedRequest, &entry, b"Missing")
  let mut freshUnrelated = makeSemantic(run Revision.copy(&unrelatedRevision))
  let mut freshUnrelatedRequest = Request.make()
  let coldUnchanged = run Semantic.demandAlias(&mut freshUnrelated, &mut freshUnrelatedRequest, &entry, b"Missing")
  run Testing.expect(startsForKey(Semantic.eventLog(&semantic), bucketKey) == usize.ONE
      && agreesWithFresh(&unchanged, &coldUnchanged),
    "an unrelated new name keeps the negative bucket and its exact rejection")
  if stop == 2 { return () }

  let added = run present("type Keeper = i32\ntype Other = bool\ntype Missing = i32\n")
  let addedRevision = run Revision.publish(&unrelatedRevision, &entry, &added)
  run Semantic.update(&mut semantic, run Revision.copy(&addedRevision))
  let mut addedRequest = Request.make()
  let found = run Semantic.demandAlias(&mut semantic, &mut addedRequest, &entry, b"Missing")
  let mut freshAdded = makeSemantic(run Revision.copy(&addedRevision))
  let mut freshAddedRequest = Request.make()
  let coldFound = run Semantic.demandAlias(&mut freshAdded, &mut freshAddedRequest, &entry, b"Missing")
  run Testing.expect(startsForKey(Semantic.eventLog(&semantic), bucketKey) == 2,
    "a new matching name reruns the bucket")
  run Testing.expect(succeeded(&found), "a newly present alias succeeds")
  run Testing.expect(agreesWithFresh(&found, &coldFound), "newly present alias agrees with fresh")
  run Testing.expect(Semantic.answerRead(&mut semantic, &found, &entry)
      && Semantic.sourcesRead(&mut semantic, &found) == usize.ONE,
    "a named answer reports its module source read")
  if stop == 3 { return () }

  let conflicting = run present("type Keeper = i32\ntype Other = bool\ntype Missing = i32\ntype Missing = bool\n")
  let conflictingRevision = run Revision.publish(&addedRevision, &entry, &conflicting)
  run Semantic.update(&mut semantic, run Revision.copy(&conflictingRevision))
  let mut conflictRequest = Request.make()
  let collision = run Semantic.demandAlias(&mut semantic, &mut conflictRequest, &entry, b"Missing")
  let mut freshConflict = makeSemantic(run Revision.copy(&conflictingRevision))
  let mut freshConflictRequest = Request.make()
  let coldCollision = run Semantic.demandAlias(&mut freshConflict, &mut freshConflictRequest, &entry, b"Missing")
  run Testing.expect(startsForKey(Semantic.eventLog(&semantic), bucketKey) == 3
      && !succeeded(&collision) && agreesWithFresh(&collision, &coldCollision),
    "a second matching name reruns the complete bucket with the fresh collision")
  if stop == 4 { return () }

  let restored = run Revision.publish(&conflictingRevision, &entry, &original)
  run Semantic.update(&mut semantic, run Revision.copy(&restored))
  let mut removedRequest = Request.make()
  let removed = run Semantic.demandAlias(&mut semantic, &mut removedRequest, &entry, b"Missing")
  let mut freshRemoved = makeSemantic(move restored)
  let mut freshRemovedRequest = Request.make()
  let coldRemoved = run Semantic.demandAlias(&mut freshRemoved, &mut freshRemovedRequest, &entry, b"Missing")
  run Testing.expect(startsForKey(Semantic.eventLog(&semantic), bucketKey) == 4
      && !succeeded(&removed) && agreesWithFresh(&removed, &coldRemoved),
    "removing a name restores the negative bucket and exact fresh rejection")
  return ()
}

effect fn runNameBucketStage(stop: usize) -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run nameBucketRevisionClaims(stop)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

