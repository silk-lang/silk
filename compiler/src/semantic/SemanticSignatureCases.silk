effect fn nestedFailureRetryClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> ? &mut Types {
  let mut system = Allocator.systemAllocatorProvider()
  let entry = run module("entry.silk")
    |> Effect.provideMut<Allocator>(&mut system)
  let library = run module("library.silk")
    |> Effect.provideMut<Allocator>(&mut system)
  let entrySource = run present("import library { Alias }\nfn entry() -> Alias { return () }\n")
    |> Effect.provideMut<Allocator>(&mut system)
  let libraryText = "pub type Alias = bool\n// This unique source allocation is rejected inside the nested import.\n"
  let librarySource = run present(libraryText)
    |> Effect.provideMut<Allocator>(&mut system)
  let first = run Revision.publish(&Revision.make(), &entry, &entrySource)
    |> Effect.provideMut<Allocator>(&mut system)
  let revision = run Revision.publish(&first, &library, &librarySource)
    |> Effect.provideMut<Allocator>(&mut system)
  let mut semantic = makeSemantic(move revision)
  let mut failedRequest = Request.make()
  let mut fault = NestedFailureAllocator {
    targetBytes: String.utf8Bytes(libraryText).length,
    rejected: false,
  }
  let attempted = run Effect.result(
    Semantic.demandSignature(&mut semantic, &mut failedRequest, &entry, b"entry"),
  )
    |> Effect.provideMut<Allocator>(&mut fault)
  let failed = match move attempted {
    Result<
      Shared<Result<Answer, NoRejection>>,
      Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError,
    >.Failure {error} => match move error {
      OutOfMemoryError {} => true
      _ => false
    }
    Result<
      Shared<Result<Answer, NoRejection>>,
      Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError,
    >.Success {value: ignored} => false
  }
  run Testing.expect(
    failed && fault.rejected && Request.rootCount(&failedRequest) == 0 && starts(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == 1 && starts(Semantic.eventLog(&semantic), Family.Import) > 0,
    "nested imported-signature provider failure publishes no root",
  )
  let mut retriedRequest = Request.make()
  let retried = run Semantic.demandSignature(&mut semantic, &mut retriedRequest, &entry, b"entry")
    |> Effect.provideMut<Allocator>(&mut system)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&retried, inspect).success && Request.rootCount(
      &retriedRequest,
    ) == 1 && Semantic.requestDiscovered(&mut semantic, &retriedRequest, &library) && starts(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == 2,
    "retry recomputes the same signature and publishes complete imported evidence",
  )
  return ()
}

test effect fn retriesNestedImportedSignatureAfterTypedFailure() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut typeTable = TypeTable.make()
  return run nestedFailureRetryClaims() |> Effect.provideMut<Types>(&mut typeTable)
}

test effect fn canonicalTypeIdentityKeepsNominalOwners() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let left = run module("left.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let right = run module("right.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let leftSource = run present(
    "struct Item {}\ntype Alias = Item\nfn original() -> Item { return () }\nfn aliased() -> Alias { return () }\nfn count() -> i32 { return 1 }\nfn flag() -> bool { return true }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rightSource = run present("struct Item {}\nfn original() -> Item { return () }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &left, &leftSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let held = run Revision.publish(&first, &right, &rightSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move held)
  let mut request = Request.make()
  let original = run Semantic.demandSignature(&mut semantic, &mut request, &left, b"original")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let aliased = run Semantic.demandSignature(&mut semantic, &mut request, &left, b"aliased")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let other = run Semantic.demandSignature(&mut semantic, &mut request, &right, b"original")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let count = run Semantic.demandSignature(&mut semantic, &mut request, &left, b"count")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let flag = run Semantic.demandSignature(&mut semantic, &mut request, &left, b"flag")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    signatureOwnedBy(&original, &left) && signatureOwnedBy(&aliased, &left) && !signatureOwnedBy(
      &other,
      &left,
    ) && signatureOwnedBy(&other, &right) && signatureIsI32(&count) && signatureIsBool(&flag),
    "source signatures keep nominal module owners and distinct scalar kinds",
  )
  return ()
}

fn requirementsOf(answer: &Result<Answer, NoRejection>) -> Option<Shared<Row>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Option<Shared<Row>>.some(
        Shared<Row>.clone(&signature.requirements),
      )
      _ => Option<Shared<Row>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<Row>>.none()
  }
}

effect fn sameChannels(
  first: &Shared<Result<Answer, NoRejection>>,
  second: &Shared<Result<Answer, NoRejection>>,
) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run channelsEqual(
    Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(first, failureOf),
    Shared<Result<Answer, NoRejection>>.with<Option<Shared<Row>>>(first, requirementsOf),
    Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(second, failureOf),
    Shared<Result<Answer, NoRejection>>.with<Option<Shared<Row>>>(second, requirementsOf),
  )
}

// A written `Effect<...>` parameter has the channels of the declared effect function.
effect fn pendingMatches(
  pending: &Shared<Result<Answer, NoRejection>>,
  declared: &Shared<Result<Answer, NoRejection>>,
) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let parameter = contractSlotOf(pending, usize.ZERO)
  if let Option<Shared<Type>>.Some {value} = move parameter {
    return run channelsEqual(
      Shared<Type>.with<Option<Shared<Type>>>(&value, effectFailure),
      Shared<Type>.with<Option<Shared<Row>>>(&value, effectRequirements),
      Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(declared, failureOf),
      Shared<Result<Answer, NoRejection>>.with<Option<Shared<Row>>>(declared, requirementsOf),
    )
  }
  return false
}

fn firstModeIs(answer: &Result<Answer, NoRejection>, expected: usize) -> bool {
  return onSignature(
    answer,
    fn(signature: &Signature) -> bool {
      return firstParameterMode(signature) == expected
    },
  )
}

fn firstParameterOf(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let parameters = Vector<Shared<Type>>.asSlice(&signature.parameters)
        return Option<Shared<Type>>.some(Shared<Type>.clone(&parameters[usize.ZERO]))
      }
      _ => Option<Shared<Type>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<Type>>.none()
  }
}

// An Effect parameter is an exact representation slot; its bound keeps the written contract.
fn firstContractOf(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome { return parameterContractAt(&signature, usize.ZERO) }
  }
  return Option<Shared<Type>>.none()
}

fn unionSize(value: &Type) -> usize {
  return match & value.* {
    Type.Union {members} => Vector<Shared<Type>>.length(&members)
    _ => usize.ZERO
  }
}

fn effectRowSize(value: &Type) -> usize {
  return match & value.* {
    Type.Effect {requirements, ..} => rowSize(&requirements)
    _ => usize.ZERO
  }
}

// `Pair<Box<i32>>` places one `Box<i32>` handle both as a union member and inside `Box<Box<i32>>`;
// `Stored` does the same inside two generic service keys.
effect fn substitutedShapes(
  control: &Shared<Result<Answer, NoRejection>>,
  nested: &Shared<Result<Answer, NoRejection>>,
  again: &Shared<Result<Answer, NoRejection>>,
  stored: &Shared<Result<Answer, NoRejection>>,
) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let first = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    control,
    firstParameterOf,
  )
  let second = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    nested,
    firstParameterOf,
  )
  let third = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    again,
    firstParameterOf,
  )
  let fourth = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    stored,
    firstContractOf,
  )
  if let Option<Shared<Type>>.Some {value: plain} = move first {
    if let Option<Shared<Type>>.Some {value: boxed} = move second {
      if let Option<Shared<Type>>.Some {value: repeated} = move third {
        if let Option<Shared<Type>>.Some {value: effectType} = move fourth {
          let distinct = !run Type.equalsShared(&plain, &boxed)
          let same = run Type.equalsShared(&boxed, &repeated)
          return Shared<Type>.with<usize>(&plain, unionSize) == 2 && Shared<Type>.with<usize>(
            &boxed,
            unionSize,
          ) == 2 && distinct && same && Shared<Type>.with<usize>(&effectType, effectRowSize) == 2
        }
      }
    }
  }
  return false
}

// Elided and spelled invocation binders give the same callable contract across declarations.
effect fn sameFirstParameters(
  left: &Shared<Result<Answer, NoRejection>>,
  right: &Shared<Result<Answer, NoRejection>>,
) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run typesEqual(contractSlotOf(left, usize.ZERO), contractSlotOf(right, usize.ZERO)
)
}

// `'a & 'b` equals `'b & 'static & 'a`; `'a & 'a` equals `'a` and differs from the pair.
effect fn environmentsNormalize(answer: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError
? &mut Allocator | &mut Types {
  if Shared<Result<Answer, NoRejection>>.with<usize>(answer, parameterCountOf) != 4 {
    return false
  }
  let pair = run slotsEqual(answer, usize.ZERO, usize.ONE)
  let single = run slotsEqual(answer, 2, 3)
  let different = !run slotsEqual(answer, usize.ZERO, 3)
  return pair && single && different
}

fn writtenEnvironment(signature: &Signature) -> bool {
  let declared = Vector<Constraint>.asSlice(&signature.constraints)
  let contents = declared.length == usize.ONE && match & declared[usize.ZERO] {
    Constraint.Contents {..} => true
    _ => false
  }
  return contents && match & signature.environment {
    Option<Intersection>.Some {value} => Vector.length(&value.members) == usize.ONE
    Option<Intersection>.None => false
  }
}

fn retainsEnvironment(answer: &Result<Answer, NoRejection>) -> bool {
  return onSignature(answer, writtenEnvironment)
}

fn representationBound(signature: &Signature) -> bool {
  let declared = Vector<Constraint>.asSlice(&signature.constraints)
  return declared.length == usize.ONE && match & declared[usize.ZERO] {
    Constraint.Represents {contract, ..} => Shared<Type>.with<usize>(&contract, modeOf) == usize.ONE
    _ => false
  }
}

fn representsCallable(answer: &Result<Answer, NoRejection>) -> bool {
  return onSignature(answer, representationBound)
}

fn onContract(answer: &Result<Answer, NoRejection>, check: fn(&Contract) -> bool) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Contract {contract}} => check(&contract)
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn conformsOnly(contract: &Contract) -> bool {
  let declared = Vector<Constraint>.asSlice(&contract.constraints)
  return Vector.length(&contract.typeParameters) == usize.ONE && declared.length == usize.ONE && match & declared[usize.ZERO] {
    Constraint.Conforms {..} => true
    _ => false
  }
}

fn sortedContract(answer: &Result<Answer, NoRejection>) -> bool {
  return onContract(answer, conformsOnly)
}

fn generatedBoundLifetime(contract: &Contract) -> bool {
  let constraints = Vector<Constraint>.asSlice(&contract.constraints)
  return Vector<Shared<Type>>.length(&contract.typeParameters) == usize.ONE && Vector<Shared<Lifetime>>.length(
    &contract.lifetimeParameters,
  ) == usize.ONE && constraints.length == usize.ONE && match & constraints[usize.ZERO] {
    Constraint.Conforms {..} => true
    _ => false
  }
}

fn datedBoxContract(answer: &Result<Answer, NoRejection>) -> bool {
  return onContract(answer, generatedBoundLifetime)
}

fn rowBinderOnly(contract: &Contract) -> bool {
  return Vector.length(&contract.rowParameters) == usize.ONE && Vector.length(
    &contract.typeParameters,
  ) == usize.ONE && Vector.length(&contract.constraints) == usize.ZERO
}

fn loadContract(answer: &Result<Answer, NoRejection>) -> bool {
  return onContract(answer, rowBinderOnly)
}

fn representationOnly(contract: &Contract) -> bool {
  let declared = Vector<Constraint>.asSlice(&contract.constraints)
  return declared.length == usize.ONE && match & declared[usize.ZERO] {
    Constraint.Represents {..} => true
    _ => false
  }
}

fn parserContract(answer: &Result<Answer, NoRejection>) -> bool {
  return onContract(answer, representationOnly)
}

// `Loaded<? &Clock>` splices the supplied row beside the alias's own `&Logger` entry.
effect fn sameResults(
  left: &Shared<Result<Answer, NoRejection>>,
  right: &Shared<Result<Answer, NoRejection>>,
) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run answersEqual(left, right, usize.MAX)
}

fn environmentSizeOf(signature: &Signature) -> usize {
  return match & signature.environment {
    Option<Intersection>.Some {value} => Vector.length(&value.members)
    Option<Intersection>.None => usize.MAX
  }
}

fn environmentMembers(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => environmentSizeOf(&signature)
      _ => usize.MAX - usize.ONE
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX - usize.ONE
  }
}

fn contentsOnly(contract: &Contract) -> bool {
  let declared = Vector<Constraint>.asSlice(&contract.constraints)
  return declared.length == usize.ONE && match & declared[usize.ZERO] {
    Constraint.Contents {..} => true
    _ => false
  }
}

fn lifetimeBoundOnly(answer: &Result<Answer, NoRejection>) -> bool {
  return onContract(answer, contentsOnly)
}

fn constraintCount(contract: &Contract) -> usize {
  return Vector.length(&contract.constraints)
}

fn contractConstraints(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Contract {contract}} => constraintCount(&contract)
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

fn declaredEffect(answer: &Result<Answer, NoRejection>) -> bool {
  return hasTypeLookup(answer, Family.Identity) && onSignature(
    answer,
    fn(signature: &Signature) -> bool {
      return signature.isEffect && rowSize(&signature.requirements) == usize.ONE && Shared<
        Type,
      >.with<
        bool,
      >(&signature.failure, isNominal)
    },
  )
}

fn unsafeOrdinary(answer: &Result<Answer, NoRejection>) -> bool {
  return onSignature(
    answer,
    fn(signature: &Signature) -> bool {
      return signature.isUnsafe && !signature.isEffect
    },
  )
}

fn constraintOrder(signature: &Signature) -> bool {
  let declared = Vector<Constraint>.asSlice(&signature.constraints)
  if declared.length != 4 {
    return false
  }
  let outlives = match & declared[usize.ZERO] {
    Constraint.Outlives {..} => true
    _ => false
  }
  let hash = match & declared[usize.ONE] {
    Constraint.Conforms {contract, ..} => Shared<Type>.with<bool>(&contract, isNominal)
    _ => false
  }
  let logger = match & declared[2] {
    Constraint.Conforms {..} => true
    _ => false
  }
  let contents = match & declared[3] {
    Constraint.Contents {..} => true
    _ => false
  }
  return outlives && hash && logger && contents
}

// Give each independent contract claim only the declarations it needs to resolve.
fn contractFixture(part: usize) -> string<'static> {
  if part == 0 {
    return "import services { Clock }\nservice Logger {}\ninterface Hash {}\nstruct Problem {}\nstruct Other {}\nrole Primary\nfn apply(transform: fn(i32) -> i32, value: i32) -> i32 { return value }\nfn consume(transform: once fn(i32) -> i32) -> i32 { return 0 }\neffect fn load(id: i32) -> i32 ! Problem ? &Clock { return id }\neffect fn both() -> i32 ! Problem | Other ? &Logger | &Clock at Primary | &mut Clock at Primary | &Clock { return 0 }\neffect fn swapped() -> i32 ! Other | Problem | Other ? &mut Clock at Primary | &Clock | &Logger { return 0 }\neffect fn closed() -> i32 { return 0 }\neffect fn spelled() -> i32 ! never ? never { return 0 }\nfn pending(value: Effect<i32 ! Problem ? &Clock>) -> i32 { return 0 }\nfn preserve<'env, A, ?R>(pending: once Effect<'env; A ? R>) -> Effect<'env; A ? R> { return move pending }\nfn bounded<'long: 'short, 'short, T: Hash + Logger + 'short>(value: &'long T) -> &'short i32 { return () }\nunsafe fn risky() -> i32 { return 1 }\nstruct Box<T> { value: T }\nfn control(value: i32 | Box<i32>) -> i32 { return 0 }\nfn nested(value: Box<i32> | Box<Box<i32>>) -> i32 { return 0 }\nfn again(value: Box<i32> | Box<Box<i32>>) -> i32 { return 0 }\nservice Store<T> {}\nfn stored<'a>(value: Effect<'a; i32 ? &Store<Box<i32>> | &Store<Box<Box<i32>>>>) -> i32 { return 0 }\ntest effect fn checked() -> () ! Problem ? &Clock { return () }\ntest fn parameterized(count: u8) {}\ntest fn generic<Item>() {}\ntest fn valued() -> u16 { return 1 }\ntest unsafe fn unchecked() {}\ntest static fn phased() {}\n"
  }
  if part == 1 {
    return "import services { Clock }\nservice Logger {}\ninterface Hash {}\nstruct Plain {}\nstruct Problem {}\nstruct Other {}\nrole Primary\ntype Borrowed = &'static i32\neffect fn notService() -> i32 ? &Plain { return 0 }\neffect fn interfaceRow() -> i32 ? &Hash { return 0 }\neffect fn badRole() -> i32 ? &Clock at Plain { return 0 }\nfn notBound<T: Plain>() -> i32 { return 0 }\nfn repeated<T: Hash + Hash>() -> i32 { return 0 }\nfn ordinaryFailure() -> i32 ! Problem { return 0 }\nfn rowAsType<?R>(value: R) -> i32 { return 0 }\nfn borrowedUnion() -> Borrowed | i32 { return 0 }\nfn ambiguousCallable(transform: fn<'static>(&i32, &i32) -> &i32) -> i32 { return 0 }\nfn nestedQuantifier(transform: for<'a> fn<'static>(for<'b> fn<'static>(&'b i32) -> i32) -> i32) -> i32 { return 0 }\nfn twoUses(transform: for<use 'a, use 'b> fn<'static>(&'a i32, &'b i32) -> i32) -> i32 { return 0 }\nfn boundedUse(transform: for<use 'a: 'static> fn<'static>(&'a i32) -> i32) -> i32 { return 0 }\nfn ordinaryRow() -> i32 ? &Clock { return 0 }\npub fn exposedCallable(transform: fn(Plain) -> i32) -> i32 { return 0 }\npub effect fn exposedRow() -> i32 ? &Logger { return 0 }\nfn first<A, B>(value: A) -> A | B { return move value }\nfn borrowedSecond() -> i32 { let chosen = first<&'static [u8], &'static [u8]>(b\"x\") return 0 }\n"
  }
  if part == 2 {
    return "fn closedEffect() -> Effect<i32> { return () }\nfn explicitStatic() -> Effect<'static; i32> { return () }\nfn inputEffect(value: i32) -> Effect<i32> { return () }\neffect fn closedDeferred() -> i32 { return 0 }\neffect fn inputDeferred(value: i32) -> i32 { return value }\neffect fn sameRegion<'a>(left: &'a i32, right: &'a i32, count: i32) -> i32 { return count }\neffect fn heldDeferred<'a>(value: Held<'a, i32>) -> i32 { return 0 }\nfn genericEffect<T>(value: T) -> Effect<i32> { return () }\nfn twoBorrowEffect(left: &i32, right: &i32) -> Effect<i32> { return () }\nfn heldEffect(value: Held<'static, i32>, count: i32) -> Effect<i32> { return () }\nstruct Held<'a, T: 'a> { value: &'a T }\n"
  }
  if part == 3 {
    return "interface Hash {}\neffect fn sameRegion<'a>(left: &'a i32, right: &'a i32, count: i32) -> i32 { return count }\neffect fn heldDeferred<'a>(value: Held<'a, i32>) -> i32 { return 0 }\neffect fn runPending<A, E>(pending: once Effect<'static; A ! E>) -> i32 { return 0 }\neffect fn callbackDeferred<A>(callback: fn<'static>(A) -> A) -> i32 { return 0 }\neffect fn keepPending<A>(pending: once Effect<A>) -> i32 { return 0 }\nfn heldOpenEffect<'a>(value: Held<'a, i32>) -> Effect<i32> { return () }\nfn nestedStatic() -> Effect<'static; Effect<i32>> { return () }\neffect fn representedBorrowed<'a, F: fn<'a>(i32) -> i32>(callback: F) -> i32 { return 0 }\neffect fn representedStatic<A, F: once Effect<'static; A>>(pending: F) -> i32 { return 0 }\neffect fn conformedStored<T: Hash>(value: T) -> i32 { return 0 }\neffect fn effectSuccess() -> Effect<i32> { return () }\neffect fn effectSuccessStatic() -> Effect<'static; i32> { return () }\neffect fn borrowedDeferred(value: &i32, count: i32) -> i32 { return count }\neffect fn twoBorrowed(left: &i32, right: &i32) -> i32 { return 0 }\neffect fn genericDeferred<Kept>(value: &i32, stored: Kept) -> i32 { return 0 }\nstruct Held<'a, T: 'a> { value: &'a T }\n"
  }
  if part == 4 {
    return "fn orderedA(transform: for<'a, 'b> fn<'static>(Effect<'a & 'b; i32>, &'a i32) -> i32) -> i32 { return 0 }\nfn orderedB(transform: for<'a, 'b> fn<'static>(Effect<'b & 'a; i32>, &'a i32) -> i32) -> i32 { return 0 }\nstruct HolderA<'x> { v: &'x i32 }\nstruct HolderB<'x> { v: &'x i32 }\nfn unionAB(transform: for<'a, 'b> fn<'static>(HolderA<'a> | HolderB<'b>) -> i32) -> i32 { return 0 }\nfn unionBA(transform: for<'a, 'b> fn<'static>(HolderB<'b> | HolderA<'a>) -> i32) -> i32 { return 0 }\nfn unionShared(transform: for<'a> fn<'static>(HolderA<'a> | HolderB<'a>) -> i32) -> i32 { return 0 }\nservice SA<'x> {}\nservice SB<'x> {}\nfn rowAB(transform: for<'a, 'b> fn<'static>(Effect<'static; i32 ? &SA<'a> | &SB<'b>>) -> i32) -> i32 { return 0 }\nfn rowBA(transform: for<'a, 'b> fn<'static>(Effect<'static; i32 ? &SB<'b> | &SA<'a>>) -> i32) -> i32 { return 0 }\nfn overlapAB(transform: for<'a, 'b, 'c> fn<'static>(Effect<'a & 'b; i32>, Effect<'a & 'c; i32>) -> i32) -> i32 { return 0 }\nfn overlapBA(transform: for<'a, 'b, 'c> fn<'static>(Effect<'b & 'a; i32>, Effect<'a & 'c; i32>) -> i32) -> i32 { return 0 }\nfn overlapApart(transform: for<'a, 'b, 'c> fn<'static>(Effect<'a & 'b; i32>, Effect<'c; i32>) -> i32) -> i32 { return 0 }\nfn orderedSingle(transform: for<'a> fn<'static>(Effect<'a; i32>, &'a i32) -> i32) -> i32 { return 0 }\n"
  }
  if part == 5 {
    return "fn nestedRef(transform: for<'a> fn<'static>(fn<'static>(&'a i32) -> i32) -> i32) -> i32 { return 0 }\nfn nestedRefAgain(transform: for<'z> fn<'static>(fn<'static>(&'z i32) -> i32) -> i32) -> i32 { return 0 }\nfn nestedFirst(transform: for<'a, 'b> fn<'static>(fn<'static>(&'a i32) -> i32, &'a i32, &'b i32) -> i32) -> i32 { return 0 }\nfn nestedFirstRenamed(transform: for<'x, 'y> fn<'static>(fn<'static>(&'x i32) -> i32, &'x i32, &'y i32) -> i32) -> i32 { return 0 }\nfn nestedSecond(transform: for<'a, 'b> fn<'static>(fn<'static>(&'b i32) -> i32, &'a i32, &'b i32) -> i32) -> i32 { return 0 }\nfn nestedUnion(transform: for<'a, 'b> fn<'static>(Box<fn<'static>(&'b i32) -> i32> | Box<fn<'static>(&'a i32) -> i32>, &'a i32) -> i32) -> i32 { return 0 }\nfn nestedUnionSwapped(transform: for<'a, 'b> fn<'static>(Box<fn<'static>(&'a i32) -> i32> | Box<fn<'static>(&'b i32) -> i32>, &'a i32) -> i32) -> i32 { return 0 }\nfn nestedUnionOne(transform: for<'a> fn<'static>(Box<fn<'static>(&'a i32) -> i32> | Box<fn<'static>(&'a i32, &'a i32) -> i32>, &'a i32) -> i32) -> i32 { return 0 }\nfn mixedBinders(transform: for<'a> fn<'static>(&i32, &'a i32) -> i32) -> i32 { return 0 }\nfn elidedBinders(transform: fn<'static>(&i32, &i32) -> i32) -> i32 { return 0 }\nfn permutedBinders(transform: for<'b, 'a> fn<'static>(&'a i32, &'b i32) -> i32) -> i32 { return 0 }\nfn unusedBinder(transform: for<'a> fn<'static>(i32) -> i32) -> i32 { return 0 }\nfn plainCallable(transform: fn<'static>(i32) -> i32) -> i32 { return 0 }\nfn boundedBinders(transform: for<'a: 'b, 'b> fn<'static>(&'a i32, &'b i32) -> i32) -> i32 { return 0 }\nfn swappedBound(transform: for<'y, 'x: 'y> fn<'static>(&'x i32, &'y i32) -> i32) -> i32 { return 0 }\nfn markedUse(transform: for<'a, use 'call> fn<'static>(&'a i32, &'call i32) -> i32) -> i32 { return 0 }\nfn markedRenamed(transform: for<'b, use 'z> fn<'static>(&'b i32, &'z i32) -> i32) -> i32 { return 0 }\nfn markedOther(transform: for<use 'a, 'call> fn<'static>(&'a i32, &'call i32) -> i32) -> i32 { return 0 }\nfn unusedUse(transform: for<use 'call> fn<'static>(i32) -> i32) -> i32 { return 0 }\nstruct Box<T> { value: T }\n"
  }
  if part == 6 {
    return "import services { Clock }\nservice Logger {}\ninterface Hash {}\nstruct Problem {}\nfn quantified(transform: fn<'static>(&i32) -> &i32) -> i32 { return 0 }\nfn spelledQuantifier(transform: for<'call> fn<'static>(&'call i32) -> &'call i32) -> i32 { return 0 }\nfn environments<'a, 'b>(first: Effect<'a & 'b; i32>, second: Effect<'b & 'static & 'a; i32>, third: Effect<'a & 'a; i32>, fourth: Effect<'a; i32>) -> i32 { return 0 }\neffect<'env> fn retain<T: 'env, 'env>(value: T) -> i32 { return 0 }\nfn parse<F: fn(i32) -> i32>(parser: F) -> i32 { return 0 }\nstruct Sorted<T: Hash> { value: T }\ninterface Dated<'a> {}\nstruct DatedBox<T: Dated> { value: T }\nfn useSorted(value: Sorted<i32>) -> i32 { return 0 }\ninterface Load<E, ?R> {}\nfn loadable<T: Load<Problem ? &Clock>>(source: &T) -> i32 { return 0 }\nfn wrongRow<T: Load<Problem>>(source: &T) -> i32 { return 0 }\nstruct Parser<F: fn<'static>(i32) -> i32> { parse: F }\n"
  }
  if part == 7 {
    return "import services { Clock }\ninterface Hash {}\nstruct Problem {}\neffect fn load(id: i32) -> i32 ! Problem ? &Clock { return id }\nstruct Held<'a, T: 'a> { value: &'a T }\nfn held(value: Held<'static, i32>) -> i32 { return 0 }\n"
  }
  if part == 8 {
    return "fn manyA(transform: for<'b0, 'b1, 'b2, 'b3, 'b4, 'b5, 'b6, 'b7, 'b8, 'b9, 'b10, 'b11, 'b12, 'b13, 'b14, 'b15, 'b16, 'b17, 'b18, 'b19, 'b20> fn<'static>(&'b0 i32, &'b1 i32, &'b2 i32, &'b3 i32, &'b4 i32, &'b5 i32, &'b6 i32, &'b7 i32, &'b8 i32, &'b9 i32, &'b10 i32, &'b11 i32, &'b12 i32, &'b13 i32, &'b14 i32, &'b15 i32, &'b16 i32, &'b17 i32, &'b18 i32, &'b19 i32, &'b20 i32) -> &'b0 i32) -> i32 { return 0 }\nfn manyB(transform: for<'b20, 'b19, 'b18, 'b17, 'b16, 'b15, 'b14, 'b13, 'b12, 'b11, 'b10, 'b9, 'b8, 'b7, 'b6, 'b5, 'b4, 'b3, 'b2, 'b1, 'b0> fn<'static>(&'b0 i32, &'b1 i32, &'b2 i32, &'b3 i32, &'b4 i32, &'b5 i32, &'b6 i32, &'b7 i32, &'b8 i32, &'b9 i32, &'b10 i32, &'b11 i32, &'b12 i32, &'b13 i32, &'b14 i32, &'b15 i32, &'b16 i32, &'b17 i32, &'b18 i32, &'b19 i32, &'b20 i32) -> &'b0 i32) -> i32 { return 0 }\nfn manyC(transform: for<'b0, 'b1, 'b2, 'b3, 'b4, 'b5, 'b6, 'b7, 'b8, 'b9, 'b10, 'b11, 'b12, 'b13, 'b14, 'b15, 'b16, 'b17, 'b18, 'b19, 'b20> fn<'static>(&'b0 i32, &'b1 i32, &'b2 i32, &'b3 i32, &'b4 i32, &'b5 i32, &'b6 i32, &'b7 i32, &'b8 i32, &'b9 i32, &'b10 i32, &'b11 i32, &'b12 i32, &'b13 i32, &'b14 i32, &'b15 i32, &'b16 i32, &'b17 i32, &'b18 i32, &'b19 i32, &'b20 i32) -> &'b1 i32) -> i32 { return 0 }\nfn manyD(transform: for<'b0, 'b1, 'b2, 'b3, 'b4, 'b5, 'b6, 'b7, 'b8, 'b9, 'b10, 'b11, 'b12, 'b13, 'b14, 'b15, 'b16, 'b17, 'b18, 'b19, 'b20> fn<'static>(&'b0 i32, &'b1 i32, &'b2 i32, &'b3 i32, &'b4 i32, &'b5 mut i32, &'b6 i32, &'b7 i32, &'b8 i32, &'b9 i32, &'b10 i32, &'b11 i32, &'b12 i32, &'b13 i32, &'b14 i32, &'b15 i32, &'b16 i32, &'b17 i32, &'b18 i32, &'b19 i32, &'b20 i32) -> &'b0 i32) -> i32 { return 0 }\n"
  }
  return ""
}

effect fn contractClaims(part: usize) -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("contracts.silk")
  let services = run module("services.silk")
  let text = contractFixture(part)
  let source = run present(text)
  let clock = run present("pub service Clock {}\n")
  let bounds = run module("bounds.silk")
  let ranked = run present(
    "interface Hash {}\ninterface Show {}\nstruct Ranked<T: Hash> { value: T }\nfn wrongRanked(value: Ranked<'static>) -> i32 { return 0 }\n",
  )
  let first = run Revision.publish(&Revision.make(), &entry, &source)
  let seeded = run Revision.publish(&first, &services, &clock)
  let held = run Revision.publish(&seeded, &bounds, &ranked)
  let mut semantic = makeSemantic(run Revision.copy(&held))
  let mut request = Request.make()
  if part == 0 {
    let apply = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"apply")
    let consume = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"consume")
    run Testing.expect(
      Shared<Result<Answer, NoRejection>>.with<bool>(
        &apply,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return firstModeIs(answer, usize.ONE)
        },
      ) && Shared<Result<Answer, NoRejection>>.with<bool>(
        &consume,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return firstModeIs(answer, 3)
        },
      ),
      "callable parameters keep shared and consuming invocation modes",
    )
    let load = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"load")
    let pending = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"pending")
    run Testing.expect(
      Shared<Result<Answer, NoRejection>>.with<bool>(&load, declaredEffect) && (run pendingMatches(
        &pending,
        &load,
      )),
      "an effect declaration and a written Effect type resolve the same channels",
    )
    let both = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"both")
    let swapped = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"swapped")
    let closed = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"closed")
    let spelled = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"spelled")
    run Testing.expect(
      (run sameChannels(&both, &swapped)) && !(run sameChannels(&both, &load)) && Shared<
        Result<Answer, NoRejection>,
      >.with<
        bool,
      >(
        &both,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return rowCountIs(answer, 3)
        },
      ) && (run sameChannels(&closed, &spelled)) && !(run sameChannels(&closed, &load)),
      "failure unions and requirement rows normalize; omitted channels equal never and empty",
    )
    let preserve = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"preserve")
    let bounded = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"bounded")
    let risky = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"risky")
    run Testing.expect(
      (run preserved(&preserve)) && Shared<Result<Answer, NoRejection>>.with<bool>(
        &bounded,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return onSignature(answer, constraintOrder)
        },
      ) && Shared<Result<Answer, NoRejection>>.with<bool>(&risky, unsafeOrdinary),
      "row binders, run modes, ordered bounds and unsafe contracts are retained",
    )
    let control = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"control")
    let nested = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"nested")
    let again = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"again")
    let stored = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"stored")
    run Testing.expect(
      (run substitutedShapes(&control, &nested, &again, &stored)),
      "written unions and requirement rows compare a type shared at different depths",
    )
    let loadBody = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"load")
    run Testing.expect(succeeded(&loadBody), "an effect body is typed against its declared success type")
    let checked = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"checked")
    let checkedBody = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"checked")
    run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&checked, declaredEffect) && succeeded(&checkedBody),
      "a valid test entry is analyzed like any other function")
    // TEST-001: an invalid entry is rejected at its conflicting parameter, binder, success type or qualifier.
    let parameterized = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"parameterized")
    let generic = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"generic")
    let valued = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"valued")
    let unchecked = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"unchecked")
    let phased = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"phased")
    let invalid = RejectionCode.InvalidTestDeclaration
    run Testing.expect(rejectsAtOffset(&parameterized, invalid, offsetOf(text, "count: u8", usize.ZERO))
      && rejectsAtOffset(&generic, invalid, offsetOf(text, "Item>", usize.ZERO))
      && rejectsAtOffset(&valued, invalid, offsetOf(text, "u16 {", usize.ZERO))
      && rejectsAtOffset(&unchecked, invalid, offsetOf(text, "unsafe fn unchecked", usize.ZERO))
      && rejectsAtOffset(&phased, invalid, offsetOf(text, "static fn phased", usize.ZERO)),
      "an invalid test entry is rejected at its first conflict")
  }
  if part == 1 {
    let notService = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"notService")
    let interfaceRow = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"interfaceRow",
    )
    let badRole = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"badRole")
    let notBound = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"notBound")
    let repeated = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"repeated")
    let ordinaryFailure = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"ordinaryFailure",
    )
    let rowAsType = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"rowAsType")
    let borrowedUnion = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"borrowedUnion",
    )
    let ambiguousCallable = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"ambiguousCallable",
    )
    let nestedQuantifier = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"nestedQuantifier",
    )
    let ordinaryRow = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"ordinaryRow",
    )
    let twoUses = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"twoUses")
    let boundedUse = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"boundedUse")
    let exposedCallable = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"exposedCallable",
    )
    let exposedRow = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"exposedRow")
    run Testing.expect(
      rejectsAt(&notService, RejectionCode.InvalidRequirement) && rejectsAt(
        &interfaceRow,
        RejectionCode.InvalidRequirement,
      ) && rejectsAt(&badRole, RejectionCode.InvalidRequirement) && rejectsAt(
        &notBound,
        RejectionCode.InvalidBound,
      ) && rejectsAt(&repeated, RejectionCode.DuplicateBound) && rejectsAt(
        &ordinaryFailure,
        RejectionCode.EffectChannelOnOrdinary,
      ) && rejectsAt(&ordinaryRow, RejectionCode.EffectChannelOnOrdinary) && rejectsAt(
        &rowAsType,
        RejectionCode.TypeArgumentKind,
      ) && rejectsAt(&borrowedUnion, RejectionCode.InvalidUnionMember) && rejectsAt(
        &ambiguousCallable,
        RejectionCode.AmbiguousLifetime,
      ) && rejectsAt(&nestedQuantifier, RejectionCode.NestedQuantifier) && rejectsAt(
        &twoUses,
        RejectionCode.InvalidLifetime,
      ) && rejectsAt(&boundedUse, RejectionCode.InvalidLifetime) && rejectsAt(
        &exposedCallable,
        RejectionCode.PrivateTypeExposure,
      ) && rejectsAt(&exposedRow, RejectionCode.PrivateTypeExposure),
      "invalid contracts reject at their spans",
    )
    let borrowedSecond = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"borrowedSecond")
    run Testing.expect(succeeded(&borrowedSecond),
      "a written type parameter member admits a substituted reference; only a written borrow is refused")
  }
  if part == 2 {
    let closedEffect = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"closedEffect")
    let explicitStatic = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"explicitStatic",
    )
    let inputEffect = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"inputEffect",
    )
    let closedDeferred = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"closedDeferred",
    )
    let inputDeferred = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"inputDeferred",
    )
    let genericEffect = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"genericEffect",
    )
    let twoBorrowEffect = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"twoBorrowEffect",
    )
    let heldEffect = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"heldEffect")
    let staticClosed = run sameResults(&closedEffect, &explicitStatic)
    let staticOwned = run sameResults(&inputEffect, &explicitStatic)
    let staticHeld = run sameResults(&heldEffect, &explicitStatic)
    run Testing.expect(
      staticClosed && staticOwned && staticHeld && rejectsAt(
        &genericEffect,
        RejectionCode.AmbiguousLifetime,
      ) && rejectsAt(&twoBorrowEffect, RejectionCode.AmbiguousLifetime) && Shared<
        Result<Answer, NoRejection>,
      >.with<
        bool,
      >(&closedDeferred, staticEnvironment) && Shared<Result<Answer, NoRejection>>.with<bool>(
        &inputDeferred,
        staticEnvironment,
      ),
      "inputs free of borrowed data give an omitted Effect environment 'static",
    )
  }
  if part == 3 {
    let nestedStatic = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"nestedStatic",
    )
    let borrowedDeferred = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"borrowedDeferred",
    )
    let twoBorrowed = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"twoBorrowed",
    )
    let genericDeferred = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"genericDeferred",
    )
    let sameRegion = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"sameRegion")
    let heldDeferred = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"heldDeferred",
    )
    let runPending = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"runPending")
    let callbackDeferred = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"callbackDeferred",
    )
    let keepPending = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"keepPending",
    )
    let heldOpenEffect = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"heldOpenEffect",
    )
    let representedBorrowed = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"representedBorrowed",
    )
    let representedStatic = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"representedStatic",
    )
    let conformedStored = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"conformedStored",
    )
    run Testing.expect(
      Shared<Result<Answer, NoRejection>>.with<usize>(&representedBorrowed, environmentMembers) == usize.ONE && Shared<
        Result<Answer, NoRejection>,
      >.with<
        usize,
      >(&representedStatic, environmentMembers) == usize.ZERO && rejectsAt(
        &conformedStored,
        RejectionCode.AmbiguousLifetime,
      ),
      "a representation parameter retains its contract environment; other stored parameters are unknown",
    )
    let effectSuccess = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"effectSuccess",
    )
    let effectSuccessStatic = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"effectSuccessStatic",
    )
    run Testing.expect(
      rejectsAt(&effectSuccess, RejectionCode.AmbiguousLifetime) && Shared<
        Result<Answer, NoRejection>,
      >.with<
        usize,
      >(&effectSuccessStatic, environmentMembers) == usize.ZERO,
      "an effect fn success Effect gets no environment default; its capture environment stays 'static",
    )
    run Testing.expect(
      rejectsAt(&nestedStatic, RejectionCode.AmbiguousLifetime) && Shared<
        Result<Answer, NoRejection>,
      >.with<
        usize,
      >(&borrowedDeferred, environmentMembers) == usize.ONE && Shared<
        Result<Answer, NoRejection>,
      >.with<
        usize,
      >(&twoBorrowed, environmentMembers) == 2 && Shared<Result<Answer, NoRejection>>.with<usize>(
        &sameRegion,
        environmentMembers,
      ) == usize.ONE && rejectsAt(&genericDeferred, RejectionCode.AmbiguousLifetime) && Shared<
        Result<Answer, NoRejection>,
      >.with<
        usize,
      >(&heldDeferred, environmentMembers) == usize.ONE && Shared<
        Result<Answer, NoRejection>,
      >.with<
        usize,
      >(&runPending, environmentMembers) == usize.ZERO && Shared<
        Result<Answer, NoRejection>,
      >.with<
        usize,
      >(&callbackDeferred, environmentMembers) == usize.ZERO && Shared<
        Result<Answer, NoRejection>,
      >.with<
        usize,
      >(&keepPending, environmentMembers) == usize.ONE && Shared<
        Result<Answer, NoRejection>,
      >.with<
        bool,
      >(
        &genericDeferred,
        fn(value: &Result<Answer, NoRejection>) -> bool {
          return rejectionSpells(
            value,
            RejectionCode.AmbiguousLifetime,
            String.utf8Bytes(text),
            b"Kept",
          )
        },
      ) && Shared<Result<Answer, NoRejection>>.with<bool>(
        &heldOpenEffect,
        fn(value: &Result<Answer, NoRejection>) -> bool {
          return rejectionSpells(
            value,
            RejectionCode.AmbiguousLifetime,
            String.utf8Bytes(text),
            b"Effect<i32>",
          )
        },
      ),
      "an effect fn intersects retained regions; stored generic contents need an environment",
    )
  }
  if part == 4 {
    let orderedA = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"orderedA")
    let orderedB = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"orderedB")
    let orderedSingle = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"orderedSingle",
    )
    run Testing.expect(
      (run sameFirstParameters(&orderedA, &orderedB)) && !(run sameFirstParameters(
        &orderedA,
        &orderedSingle,
      )),
      "intersection member order does not number invocation binders",
    )
    let unionAB = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"unionAB")
    let unionBA = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"unionBA")
    let unionShared = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"unionShared",
    )
    let rowAB = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"rowAB")
    let rowBA = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"rowBA")
    let overlapAB = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"overlapAB")
    let overlapBA = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"overlapBA")
    let overlapApart = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"overlapApart",
    )
    run Testing.expect(
      (run sameFirstParameters(&unionAB, &unionBA)) && (run sameFirstParameters(&rowAB, &rowBA)) && (run sameFirstParameters(
        &overlapAB,
        &overlapBA,
      )) && !(run sameFirstParameters(&unionAB, &unionShared)) && !(run sameFirstParameters(
        &overlapAB,
        &overlapApart,
      )),
      "callables equal up to a renaming of invocation binders across unions, rows and environments",
    )
  }
  if part == 5 {
    let nestedRef = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"nestedRef")
    let nestedRefAgain = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"nestedRefAgain",
    )
    let nestedFirst = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"nestedFirst",
    )
    let nestedFirstRenamed = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"nestedFirstRenamed",
    )
    let nestedSecond = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"nestedSecond",
    )
    let nestedUnion = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"nestedUnion",
    )
    let nestedUnionSwapped = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"nestedUnionSwapped",
    )
    let nestedUnionOne = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"nestedUnionOne",
    )
    let refSame = run sameFirstParameters(&nestedRef, &nestedRefAgain)
    let firstSame = run sameFirstParameters(&nestedFirst, &nestedFirstRenamed)
    let firstSecond = run sameFirstParameters(&nestedFirst, &nestedSecond)
    let unionSame = run sameFirstParameters(&nestedUnion, &nestedUnionSwapped)
    let unionOne = run sameFirstParameters(&nestedUnion, &nestedUnionOne)
    run Testing.expect(
      refSame && firstSame && !firstSecond && unionSame && !unionOne,
      "an unquantified inner callable refers to its enclosing contract's invocation binders",
    )
    let mixedBinders = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"mixedBinders",
    )
    let elidedBinders = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"elidedBinders",
    )
    let permutedBinders = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"permutedBinders",
    )
    let unusedBinder = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"unusedBinder",
    )
    let plainCallable = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"plainCallable",
    )
    let boundedBinders = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"boundedBinders",
    )
    let swappedBound = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"swappedBound",
    )
    run Testing.expect(
      (run sameFirstParameters(&mixedBinders, &elidedBinders)) && (run sameFirstParameters(
        &permutedBinders,
        &elidedBinders,
      )) && (run sameFirstParameters(&unusedBinder, &plainCallable)) && !(run sameFirstParameters(
        &boundedBinders,
        &elidedBinders,
      )) && (run sameFirstParameters(&boundedBinders, &swappedBound)),
      "invocation binders number by first use; unused names vanish and bounds stay meaningful",
    )
    let markedUse = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"markedUse")
    let markedRenamed = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"markedRenamed")
    let markedOther = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"markedOther")
    let unusedUse = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"unusedUse")
    run Testing.expect(
      (run sameFirstParameters(&markedUse, &markedRenamed)) && !(run sameFirstParameters(&markedUse, &mixedBinders))
        && !(run sameFirstParameters(&markedUse, &markedOther))
        && (run sameFirstParameters(&unusedUse, &plainCallable)),
      "a `for<use 'call>` marker is contract identity at its binder; an unused marker vanishes",
    )
  }
  if part == 6 {
    let quantified = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"quantified")
    let spelledQuantifier = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"spelledQuantifier",
    )
    let environments = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"environments",
    )
    let retain = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"retain")
    let parse = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"parse")
    run Testing.expect(
      (run sameFirstParameters(&quantified, &spelledQuantifier)) && (run environmentsNormalize(
        &environments,
      )) && Shared<Result<Answer, NoRejection>>.with<bool>(&retain, retainsEnvironment) && Shared<
        Result<Answer, NoRejection>,
      >.with<
        bool,
      >(&parse, representsCallable),
      "invocation binders, environment intersections and representation bounds are canonical",
    )
    let sorted = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Sorted")
    let datedBox = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"DatedBox")
    let loadInterface = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Load")
    let parser = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Parser")
    let useSorted = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"useSorted")
    let loadable = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"loadable")
    let wrongRow = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"wrongRow")
    run Testing.expect(
      Shared<Result<Answer, NoRejection>>.with<bool>(&sorted, sortedContract) && Shared<
        Result<Answer, NoRejection>,
      >.with<
        bool,
      >(&datedBox, datedBoxContract) && Shared<
        Result<Answer, NoRejection>,
      >.with<
        bool,
      >(&loadInterface, loadContract) && Shared<Result<Answer, NoRejection>>.with<bool>(
        &parser,
        parserContract,
      ),
      "declaration contracts record bounds, row binders and representation parameters",
    )
    run Testing.expect(
      rejectsFrom(&useSorted, RejectionCode.MissingConformance, offsetOf(text, "Sorted<i32>", usize.ZERO)),
      "a bounded application rejects at its written use when Hash is unproved",
    )
    run Testing.expect(
      Shared<Result<Answer, NoRejection>>.with<bool>(&loadable, signatureSucceeded) && rejectsAt(
        &wrongRow,
        RejectionCode.TypeArgumentKind,
      ),
      "a row argument binds to its declared row binder",
    )
  }
  if part == 7 {
    let heldAnswer = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"held")
    let heldContract = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Held")
    run Testing.expect(
      Shared<Result<Answer, NoRejection>>.with<bool>(&heldAnswer, signatureSucceeded) && Shared<
        Result<Answer, NoRejection>,
      >.with<
        bool,
      >(&heldContract, lifetimeBoundOnly),
      "a lifetime-only bound is recorded and does not block applications",
    )
    let rankedMembers = run Semantic.demandMembers(&mut semantic, &mut request, &bounds, b"Ranked")
    let rankedContract = run Semantic.demandContract(&mut semantic, &mut request, &bounds, b"Ranked")
    let wrongRanked = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &bounds,
      b"wrongRanked",
    )
    run Testing.expect(
      !Shared<Result<Answer, NoRejection>>.with<bool>(
        &rankedMembers,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return hasTypeLookup(answer, Family.Contract)
        },
      ) && Shared<Result<Answer, NoRejection>>.with<usize>(&rankedContract, contractConstraints) == usize.ONE && rejectsAt(
        &wrongRanked,
        RejectionCode.TypeArgumentKind,
      ),
      "bounded applications check arguments before proof, without affecting declaration identity",
    )
    let changed = run present("pub interface Clock {}\n")
    let servicesRevision = run Revision.publish(&held, &services, &changed)
    run Semantic.update(&mut semantic, run Revision.copy(&servicesRevision))
    let mut revised = Request.make()
    let reloaded = run Semantic.demandSignature(&mut semantic, &mut revised, &entry, b"load")
    run Testing.expect(
      Shared<Result<Answer, NoRejection>>.with<bool>(
        &reloaded,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return rejectedTypeApplication(answer, RejectionCode.InvalidRequirement)
        },
      ),
      "an imported service becoming an interface invalidates its requirement use",
    )
    let mut freshServices = makeSemantic(move servicesRevision)
    let mut freshServicesRequest = Request.make()
    let freshReloaded = run Semantic.demandSignature(&mut freshServices, &mut freshServicesRequest, &entry, b"load")
    run Testing.expect(agreesWithFresh(&reloaded, &freshReloaded), "the reloaded requirement use agrees with a fresh store of the same revision")
    let reranked = run present(
      "interface Hash {}\ninterface Show {}\nstruct Ranked<T: Hash + Show> { value: T }\n",
    )
    let boundsRevision = run Revision.publish(&held, &bounds, &reranked)
    run Semantic.update(&mut semantic, run Revision.copy(&boundsRevision))
    let mut edited = Request.make()
    let editedContract = run Semantic.demandContract(&mut semantic, &mut edited, &bounds, b"Ranked")
    run Testing.expect(
      Shared<Result<Answer, NoRejection>>.with<usize>(&editedContract, contractConstraints) == 2,
      "editing only a bound yields the new contract",
    )
    let mut freshBounds = makeSemantic(move boundsRevision)
    let mut freshBoundsRequest = Request.make()
    let freshContract = run Semantic.demandContract(&mut freshBounds, &mut freshBoundsRequest, &bounds, b"Ranked")
    run Testing.expect(agreesWithFresh(&editedContract, &freshContract), "the edited bound contract agrees with a fresh store of the same revision")
  }
  if part == 8 {
    let manyA = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"manyA")
    let manyB = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"manyB")
    let manyC = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"manyC")
    let manyD = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"manyD")
    let manySame = run sameFirstParameters(&manyA, &manyB)
    let manyResult = run sameFirstParameters(&manyA, &manyC)
    let manyAccess = run sameFirstParameters(&manyA, &manyD)
    run Testing.expect(
      manySame && !manyResult && !manyAccess,
      "contracts with many invocation binders compare without enumerating permutations",
    )
  }
  return ()
}

