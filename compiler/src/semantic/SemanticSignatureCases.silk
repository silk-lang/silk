! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run memberKindRevisionClaims()
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn genericTypeBindersAndExplicitApplications() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("generic.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(
    "struct Pair<A, B> {}\nstruct Plain {}\ntype Same = Pair\nfn left<T>(value: T) -> T { return move value }\nfn right<T>(value: T) -> T { return move value }\nfn generic<T>() -> i32 { return 1 }\nfn duplicate<T, T>(value: T) -> T { return move value }\nfn one() -> Pair<i32, bool> { return () }\nfn two() -> Pair<i32, bool> { return () }\nfn swapped() -> Pair<bool, i32> { return () }\nfn alias() -> Same<bool, bool> { return () }\nfn direct() -> Pair<bool, bool> { return () }\nfn arity() -> Pair<i32> { return () }\nfn omitted() -> Pair { return () }\nfn excess() -> Plain<i32> { return () }\nfn kind() -> Pair<'x, bool> { return () }\nfn missing() -> Pair<Unknown, bool> { return () }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let left = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"left")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let right = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"right")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&left, signatureHasOrdinaryBinder) && Shared<
      Result<Answer, NoRejection>,
    >.with<
      bool,
    >(&right, signatureHasOrdinaryBinder) && !(run resultEquals(&left, &right)
      |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)),
    "each function owns a distinct ordinary T binder reused in its signature",
  )
  let one = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"one")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let two = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"two")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let swapped = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"swapped")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let alias = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"alias")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let direct = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"direct")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    (run resultEquals(&one, &two)
      |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)) && !(run resultEquals(&one, &swapped)
      |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)) && (run resultEquals(&alias, &direct)
      |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)),
    "ordered nominal arguments are canonical and an unapplied alias applies its target",
  )
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(
      &alias,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return hasTypeLookup(answer, Family.Alias) && hasTypeLookup(answer, Family.Identity)
      },
    ),
    "an applied alias retains alias and nominal identity dependencies",
  )
  let arity = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"arity")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let omitted = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"omitted")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let excess = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"excess")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let duplicate = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"duplicate")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let kind = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"kind")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let missing = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"missing")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&arity, wrongTypeArity) && Shared<
      Result<Answer, NoRejection>,
    >.with<
      bool,
    >(&kind, wrongTypeKind) && Shared<Result<Answer, NoRejection>>.with<bool>(
      &missing,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.UnknownType) && hasTypeLookup(
          answer,
          Family.Name,
        )
      },
    ),
    "wrong arity, wrong kind and absent argument names reject with anchored evidence",
  )
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(
      &omitted,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.TypeArity)
      },
    ) && Shared<Result<Answer, NoRejection>>.with<bool>(
      &excess,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.TypeArity)
      },
    ) && Shared<Result<Answer, NoRejection>>.with<bool>(
      &duplicate,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.DuplicateTypeParameter)
      },
    ),
    "omitted, excess and duplicate generic declarations reject at source positions",
  )
  let genericBody = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"generic")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&genericBody, bodyAnswerIsTyped),
    "a generic declaration with a scalar body is contract typed, not fully checked",
  )
  return ()
}

test effect fn abstractBodiesTypeForwardingAndBothRuntimeBranches() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("abstract-bodies.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "struct Document { value: i32 }\nfn forward<T>(value: T) -> T { return move value }\nfn invoke<T>(value: T) -> T { return forward(move value) }\nfn writtenOnly<T>(value: T) -> T { return 0 }\nfn callWritten<T>(value: T) -> T { return writtenOnly(move value) }\nfn choose<T>(condition: bool, left: T, right: T) -> T { if condition { return move left } else { return move right } }\nfn wrongElse<T>(condition: bool, left: T, right: i32) -> T { if condition { return move left } else { return right } }\nfn unboundedOperator<T>(value: T) -> T { return value + value }\nfn lifetimeOnly<'a>(value: i32) -> i32 { return value }\nfn nominal(value: Document) -> Document { return move value }\nfn charPass(value: char) -> char { return value }\nfn floatPass(value: f64) -> f64 { return value }\nfn stringPass(value: string) -> string { return move value }\nfn scalar(value: i32) -> i32 { return value }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let forwarded = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"forward")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let forwarding = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(
    &forwarded,
    checkedBody,
  )
  let signature = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"forward")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let binder = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &signature,
    ownBinder,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move forwarding {
    let types = Shared<TypedBody>.with<Option<ForwardedTypes>>(&value, forwardedTypes)
    if let Option<ForwardedTypes>.Some {value: found} = move types {
      if let Option<Shared<Type>>.Some {value: parameter} = move binder {
        let localMatches = run Type.equalsShared(&parameter, &found.local)
          |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
        let movedMatches = run Type.equalsShared(&parameter, &found.moved)
          |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
        run Testing.expect(
          localMatches && movedMatches && found.checked,
          "whole-value T forwarding keeps its declaration-owned identity, and the borrow stage proves its move",
        )
      } else {
        run Testing.expect(false, "the forwarded body has a declared type binder")
      }
    } else {
      run Testing.expect(false, "whole-value T forwarding retains a typed move")
    }
  } else {
    run Testing.expect(false, "whole-value T forwarding has a typed body")
  }
  let invoked = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"invoke")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let writtenCaller = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"callWritten")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let writtenBody = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"writtenOnly")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&invoked, bodyAnswerIsTyped) && Shared<Result<Answer, NoRejection>>.with<bool>(&writtenCaller, bodyAnswerIsTyped) && Shared<Result<Answer, NoRejection>>.with<bool>(&writtenBody, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.ReturnTypeMismatch)
    }),
    "written generic signatures type calls without requiring valid callee bodies",
  )
  let callerSignature = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"invoke")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let callerBinder = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &callerSignature,
    ownBinder,
  )
  let calledBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(
    &invoked,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value: body} = move calledBody {
    let callType = Shared<TypedBody>.with<Option<Shared<Type>>>(&body, directCallType)
    let specialized = Shared<TypedBody>.with<bool>(&body, fn(value: &TypedBody) -> bool {
      return bodyCallGenericCount(value, usize.ONE)
    })
    if let Option<Shared<Type>>.Some {value: inferred} = move callType {
      if let Option<Shared<Type>>.Some {value: parameter} = move callerBinder {
        let sameResult = run Type.equalsShared(&parameter, &inferred)
          |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
        run Testing.expect(specialized && sameResult, "generic call result retains the caller's declaration-owned T")
      } else {
        run Testing.expect(false, "the generic caller has its own type binder")
      }
    } else {
      run Testing.expect(false, "the generic caller retains a typed direct call")
    }
  } else {
    run Testing.expect(false, "the generic caller has a contract-typed body")
  }
  let choose = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"choose")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongElse = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"wrongElse")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unboundedOperator = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unboundedOperator")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&choose, bodyAnswerIsTyped) && Shared<Result<Answer, NoRejection>>.with<bool>(
      &wrongElse,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.ReturnTypeMismatch)
      },
    ),
    "both runtime branches are typed and a mismatched else return rejects",
  )
  run Testing.expect(
    rejectsFrom(&unboundedOperator, RejectionCode.MissingOperator, offsetOf(text, "+", usize.ZERO)),
    "an unbounded operator rejects at the operator",
  )
  let lifetimeOnly = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"lifetimeOnly")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&lifetimeOnly, bodyAnswerIsTyped),
    "a lifetime-only generic body is typed",
  )
  let nominal = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"nominal")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let character = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"charPass")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let floating = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"floatPass")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let stringBody = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"stringPass")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&nominal, bodyAnswerIsTyped) && Shared<Result<Answer, NoRejection>>.with<bool>(&character, bodyAnswerIsTyped) && Shared<Result<Answer, NoRejection>>.with<bool>(&floating, bodyAnswerIsTyped) && Shared<Result<Answer, NoRejection>>.with<bool>(&stringBody, bodyAnswerIsTyped),
    "concrete nominal and non-scalar value bodies are typed",
  )
  let scalar = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"scalar")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let scalarBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(
    &scalar,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move scalarBody {
    run Testing.expect(
      Shared<TypedBody>.with<bool>(&value, bodyIsFullyChecked),
      "existing scalar bodies retain a fully checked result",
    )
  } else {
    run Testing.expect(false, "the scalar body remains valid")
  }
  return ()
}

test effect fn qualifiedBoundCallsUseDeclaredContracts() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("qualified-bound-body.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "interface Read { fn read(value: Self) -> i32 }\ninterface Write { fn write(value: Self) -> i32 }\nstruct Item {}\nimpl Read for Item { fn read(value: Self) -> i32 { return 1 } }\nfn bounded<T: Read>(value: T) -> i32 { return Read.read(move value) }\nfn without<T>(value: T) -> i32 { return Read.read(move value) }\nfn foreign<T: Read>(value: T) -> i32 { return Read.write(move value) }\nfn concrete(value: Item) -> i32 { return without(move value) }\nstruct Scanner<'input> { input: &'input [u8] }\ninterface Make { fn make(scanner: &mut Scanner) -> Self }\nfn made<T: Make>(scanner: &mut Scanner) -> T { return Make.make(&mut scanner.*) }\ninterface Peek { fn peek(self: &Self, scanner: &mut Scanner) -> i32 }\nimpl Peek for Item { fn peek(self: &Item, scanner: &mut Scanner) -> i32 { return 1 } }\nfn peeked(item: &Item, scanner: &mut Scanner) -> i32 { return item.peek(&mut scanner.*) }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let bounded = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bounded")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let without = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"without")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let foreign = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"foreign")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let concrete = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"concrete")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&bounded, bodyAnswerIsTyped),
    "the written Read bound types the qualified operation against symbolic T",
  )
  run Testing.expect(
    rejectsFrom(&without, RejectionCode.MissingConformance, offsetOf(text, "Read.read(move value)", usize.ONE)) && succeeded(&concrete),
    "removing the declared bound rejects the body even when a concrete caller is valid",
  )
  run Testing.expect(
    rejectsFrom(&foreign, RejectionCode.UnknownOperation, offsetOf(text, "write", usize.ONE)),
    "a same-module operation from another interface is unknown at the qualified call",
  )
  let made = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"made")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let peeked = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"peeked")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&made, bodyAnswerIsTyped) && succeeded(&peeked),
    "a reborrowed operand infers an operation's elided regions inside an invariant referent",
  )
  return ()
}

test effect fn receiverCallsShareQualifiedContractsAndWitnesses() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("receiver-interface-calls.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "interface Printable { fn print(value: &Self) -> i32 }\nstruct Document {}\nimpl Printable for Document { fn print(value: &Self) -> i32 { return 42 } }\nfn generic<T: Printable>(value: &T) -> i32 { let qualified = Printable.print(value) return value.print() }\nfn concrete(value: &Document) -> i32 { let qualified = Printable.print(value) return value.print() }\nfn concreteValue(value: Document) -> i32 { return value.print() }\nfn methodValue<T: Printable>(value: &T) -> i32 { let selected = value.print return 0 }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let generic = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"generic")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let concrete = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"concrete")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let concreteValue = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"concreteValue")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let methodValue = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"methodValue")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let genericPair = Shared<Result<Answer, NoRejection>>.with<Option<InterfaceCallPair>>(
    &generic, answerInterfaceCallPair,
  )
  let mut genericSelected = false
  if let Option<InterfaceCallPair>.Some {value} = move genericPair {
    let sameContract = run Type.equalsShared(&value.firstContract, &value.secondContract)
      |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
    let sameProvider = run Type.equalsShared(&value.firstProvider, &value.secondProvider)
      |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
    genericSelected = sameContract && sameProvider && value.sameOperation && value.sameWitness
      && !value.hasWitness && value.oneReceiverPerCall && value.qualifiedThenReceiver
  }
  let concretePair = Shared<Result<Answer, NoRejection>>.with<Option<InterfaceCallPair>>(
    &concrete, answerInterfaceCallPair,
  )
  let mut concreteSelected = false
  if let Option<InterfaceCallPair>.Some {value} = move concretePair {
    let sameContract = run Type.equalsShared(&value.firstContract, &value.secondContract)
      |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
    let sameProvider = run Type.equalsShared(&value.firstProvider, &value.secondProvider)
      |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
    concreteSelected = sameContract && sameProvider && value.sameOperation && value.sameWitness
      && value.hasWitness && value.oneReceiverPerCall && value.qualifiedThenReceiver
  }
  run Testing.expect(
    genericSelected && concreteSelected && Shared<Result<Answer, NoRejection>>.with<bool>(
      &generic, bodyAnswerIsTyped,
    ) && Shared<Result<Answer, NoRejection>>.with<bool>(
      &concreteValue, bodyAnswerIsTyped,
    ),
    "receiver and qualified calls select the same bound or concrete contract and witness",
  )
  run Testing.expect(
    rejectsFrom(&methodValue, RejectionCode.Unsupported, offsetOf(text, "value.print return", usize.ZERO)),
    "a bound interface method cannot be captured as a value in M2.3",
  )
  return ()
}

test effect fn receiverCallsBindTheMemberOwnBinders() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("receiver-member-binders.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
interface Printable { fn print(value: &Self) -> i32 }
struct Document {}
impl Printable for Document { fn print(value: &Self) -> i32 { return 1 } }
struct Holder<T> { item: T }
impl<T> Holder<T> {
  fn pair<U>(self: &Self, other: U) -> U { return move other }
  fn show<U: Printable>(self: &Self, item: &U) -> i32 { return Printable.print(item) }
}
fn explicit(boxed: Holder<u8>) -> i32 { return boxed.pair<i32>(7) }
fn inferred(boxed: Holder<u8>) -> bool { return boxed.pair(true) }
fn bounded(boxed: Holder<u8>, document: Document) -> i32 { return boxed.show(&document) }
fn arity(boxed: Holder<u8>) -> i32 { return boxed.pair<i32, bool>(7) }
fn unsatisfied(boxed: Holder<u8>, value: i32) -> i32 { return boxed.show(&value) }
"""
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let explicit = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"explicit")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let inferred = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"inferred")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let bounded = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bounded")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let arity = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"arity")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unsatisfied = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unsatisfied")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&explicit,
      fn(answer: &Result<Answer, NoRejection>) -> bool { return receiverMemberArgumentIs(answer, false) })
      && Shared<Result<Answer, NoRejection>>.with<bool>(&inferred,
      fn(answer: &Result<Answer, NoRejection>) -> bool { return receiverMemberArgumentIs(answer, true) })
      && Shared<Result<Answer, NoRejection>>.with<bool>(&bounded, bodyAnswerIsTyped),
    "a receiver call binds its member's own binders from a written list or its operands beside the receiver's",
  )
  run Testing.expect(
    rejectsFrom(&arity, RejectionCode.TypeArity, offsetOf(text, "boxed.pair<i32, bool>", usize.ZERO))
      && rejectsFrom(&unsatisfied, RejectionCode.MissingConformance, offsetOf(text, "boxed.show(&value)", usize.ZERO)),
    "a written list longer than the member's own binders and an unproven member bound reject the call",
  )
  return ()
}

// Inside a generic impl, a sibling member called on `self` or spelled `Owner<'owner>.member` has
// its scope applied with the caller's own impl binder, a lifetime or a type. That binder stays rigid: only the member's
// own binders are inferred, so the call's one scope binding holds the caller's parameter.
test effect fn siblingCallsKeepTheCallerImplBinders() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run siblingCallClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn siblingCallClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> ? &mut Allocator | &mut Types {
  let entry = run module("sibling-member-binders.silk")
  let text = """
pub struct Trailers<'owner> { pub base: &'owner usize pub count: usize }
impl<'owner> Trailers<'owner> {
  pub fn required(self: &Self) -> usize { return self.count + self.base.* }
  pub fn received(self: &'owner Self) -> usize { return self.required() }
  pub fn qualified(self: &'owner Self) -> usize { return Trailers<'owner>.required(self) }
}
pub struct Holder<T> { pub value: T pub count: usize }
impl<T> Holder<T> {
  pub fn counted(self: &Self) -> usize { return self.count }
  pub fn forwarded(self: &Self) -> usize { return self.counted() }
}
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut index = SourceIndex.make(move revision)
  let mut request = Request.make()
  let receivedId = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Function, b"received", usize.ZERO)
  let qualifiedId = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Function, b"qualified", usize.ZERO)
  let forwardedId = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Function, b"forwarded", usize.ZERO)
  let received = run Semantic.demandBodyOf(&mut semantic, &mut request, &receivedId)
  let qualified = run Semantic.demandBodyOf(&mut semantic, &mut request, &qualifiedId)
  let forwarded = run Semantic.demandBodyOf(&mut semantic, &mut request, &forwardedId)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&received, siblingScopeIsCallerBinder)
      && Shared<Result<Answer, NoRejection>>.with<bool>(&qualified, siblingScopeIsCallerBinder)
      && Shared<Result<Answer, NoRejection>>.with<bool>(&forwarded, siblingScopeIsCallerBinder),
    "a sibling member call inside a generic impl applies its scope with the caller's own binder",
  )
  return ()
}

// The body's one direct call applies one scope whose single argument is a declaration parameter.
fn siblingScopeIsCallerBinder(answer: &Result<Answer, NoRejection>) -> bool {
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedBody(answer) {
    return Shared<TypedBody>.with<bool>(&body, siblingCallScope)
  }
  return false
}

fn siblingCallScope(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut calls = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {application, ..}, ..} = &nodes[at].kind {
      if !Shared<SpecializationApplication>.with<bool>(&application, scopeHoldsParameter) { return false }
      calls = calls + usize.ONE
    }
    at = at + usize.ONE
  }
  return calls == usize.ONE
}

fn scopeHoldsParameter(applied: &SpecializationApplication) -> bool {
  let scopes = Vector<ScopeBinding>.asSlice(&applied.scopes)
  if scopes.length != usize.ONE { return false }
  let arguments = Vector<Argument>.asSlice(&scopes[usize.ZERO].arguments)
  if arguments.length != usize.ONE { return false }
  return match &arguments[usize.ZERO] {
    Argument.Lifetime {value} => Shared<Lifetime>.with<bool>(&value,
      fn(region: &Lifetime) -> bool { return match &region.* { Lifetime.Parameter {..} => true _ => false } })
    Argument.Type {value} => Shared<Type>.with<bool>(&value,
      fn(written: &Type) -> bool { return match &written.* { Type.Parameter {..} => true _ => false } })
    _ => false
  }
}

// The receiver call's one direct application binds the member's own binder to i32 or bool, and
// its owner's binder through one scope.
fn receiverMemberArgumentIs(answer: &Result<Answer, NoRejection>, boolean: bool) -> bool {
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedBody(answer) {
    return Shared<TypedBody>.with<bool>(&body, fn(value: &TypedBody) -> bool { return receiverCallBinds(value, boolean) })
  }
  return false
}

fn receiverCallBinds(body: &TypedBody, boolean: bool) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut calls = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {application, receiverPass, ..}, ..} = &nodes[at].kind {
      match &receiverPass {
        Option<BodyReceiverPass>.Some {..} => ()
        Option<BodyReceiverPass>.None => { return false }
      }
      if !Shared<SpecializationApplication>.with<bool>(&application,
        fn(applied: &SpecializationApplication) -> bool { return memberApplicationBinds(applied, boolean) }) {
        return false
      }
      calls = calls + usize.ONE
    }
    at = at + usize.ONE
  }
  return calls == usize.ONE
}

// The member's own arguments hold its one type binder beside the receiver loan's region.
fn memberApplicationBinds(applied: &SpecializationApplication, boolean: bool) -> bool {
  if Vector<ScopeBinding>.length(&applied.scopes) != usize.ONE { return false }
  let arguments = Vector<Argument>.asSlice(&applied.arguments)
  let mut types = usize.ZERO
  let mut matched = false
  let mut at = usize.ZERO
  while at < arguments.length {
    if let Argument.Type {value: written} = &arguments[at] {
      types = types + usize.ONE
      matched = Shared<Type>.with<bool>(&written, fn(selected: &Type) -> bool {
        if boolean { return isBool(selected) }
        return isI32(selected)
      })
    }
    at = at + usize.ONE
  }
  return types == usize.ONE && matched
}

test effect fn receiverSuppliersTieBeforeArgumentsOrResult() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("receiver-ties.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "interface First { fn choose(value: Self, item: i32) -> i32 }\ninterface Second { fn choose(value: Self) -> bool }\nstruct Choice {}\nimpl First for Choice { fn choose(value: Self, item: i32) -> i32 { return item } }\nimpl Second for Choice { fn choose(value: Self) -> bool { return true } }\nfn bounded<T: First + Second>(value: T) -> i32 { return value.choose(7) }\nfn concrete(value: Choice) -> i32 { return value.choose(7) }\nfn unbounded<T>(value: T) -> i32 { return value.choose(7) }\ninterface Third { fn third(value: Self) -> i32 }\nstruct Holder<T> { inner: T }\nimpl<T: First> Third for Holder<T> { fn third(value: Self) -> i32 { return value.inner.choose(7) } }\ninterface Fourth { fn fourth(value: Self) -> i32 }\nimpl<T: First> Fourth for Holder<T> { fn fourth(value: Self) -> i32 { return First.choose(move value.inner, 8) } }\ninterface Fifth { fn fifth(value: Self) -> i32 }\nimpl<T> Fifth for Holder<T> { fn fifth(value: Self) -> i32 { return value.inner.choose(9) } }\nservice Ranked { fn rank(value: &Self) -> i32 }\nfn served<T: Ranked>(value: &T) -> i32 { return Ranked.rank(value) }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut index = SourceIndex.make(run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator))
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let bounded = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bounded")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let concrete = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"concrete")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unbounded = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unbounded")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&bounded, RejectionCode.AmbiguousBoundMethod, offsetOf(text, "choose(7)", usize.ZERO))
      && rejectsFrom(&concrete, RejectionCode.AmbiguousConformanceMethod, offsetOf(text, "choose(7)", usize.ONE))
      && rejectsFrom(&unbounded, RejectionCode.UnknownOperation, offsetOf(text, "choose(7)", 2)),
    "method arguments and expected results cannot break bound or concrete supplier ties",
  )
  let thirdIdentity = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Function, b"third", usize.ONE)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let held = run Semantic.demandBodyOf(&mut semantic, &mut request, &thirdIdentity)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let fourthIdentity = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Function, b"fourth", usize.ONE)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let qualified = run Semantic.demandBodyOf(&mut semantic, &mut request, &fourthIdentity)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let fifthIdentity = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Function, b"fifth", usize.ONE)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unboundedMember = run Semantic.demandBodyOf(&mut semantic, &mut request, &fifthIdentity)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&held, bodyAnswerIsTyped)
      && Shared<Result<Answer, NoRejection>>.with<bool>(&qualified, bodyAnswerIsTyped)
      && rejectsFrom(&unboundedMember, RejectionCode.UnknownOperation, offsetOf(text, "choose(9)", usize.ZERO)),
    "a member body receives its implementation's head bounds; an unbounded implementation parameter has no supplier")
  let served = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"served")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&served, bodyAnswerIsTyped),
    "a service operation taking its Self as an operand dispatches on the operand's conformance (SERV-003)")
  return ()
}

test effect fn ownerClaimsDoNotFallThroughToInterfaceMethods() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("claimed-receiver-methods.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
interface Rescue { fn call(value: Self) -> i32 }
struct FieldOwner { call: fn<'static>() -> i32 }
impl Rescue for FieldOwner { fn call(value: Self) -> i32 { return 1 } }
fn field(value: FieldOwner) -> i32 { return value.call() }
struct ElidedFieldOwner { call: fn() -> i32 }
impl Rescue for ElidedFieldOwner { fn call(value: Self) -> i32 { return 5 } }
fn elided(value: ElidedFieldOwner) -> i32 { return value.call() }
struct Repeated {}
impl Rescue for Repeated { fn call(value: Self) -> i32 { return 2 } }
impl Repeated { fn call(self: Self) -> i32 { return 3 } }
impl Repeated { fn call(self: Self) -> i32 { return 4 } }
fn duplicate(value: Repeated) -> i32 { return value.call() }
"""
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let field = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"field")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let elided = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"elided")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let duplicate = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"duplicate")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&field, claimedCallableFieldFacts)
      && rejectsAt(&duplicate, RejectionCode.DuplicateInherentMember),
    "a callable field invokes its original projected value, and a duplicate inherent name keeps its collision instead of selecting a conformance",
  )
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&elided, claimedCallableFieldFacts),
    "an omitted callable field environment invokes its original projected value without selecting a conformance",
  )
  return ()
}

fn claimedCallableFieldFacts(answer: &Result<Answer, NoRejection>) -> bool {
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedBody(answer) {
    return Shared<TypedBody>.with<bool>(&body, fn(value: &TypedBody) -> bool {
      let nodes = TypedBody.nodeSlice(value)
      let mut calls = usize.ZERO
      let mut at = usize.ZERO
      while at < nodes.length {
        match &nodes[at].kind {
          BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {..}, ..} => { return false }
          BodyNodeKind.Expression {form: BodyExpression.DirectCall {..}, ..} => { return false }
          BodyNodeKind.Expression {form: BodyExpression.CallableCall {callee, mode, arguments, pipeline, ..}, ..} => {
            if mode != CallableMode.Shared || pipeline || Vector<BodyNodeId>.length(&arguments) != usize.ZERO
              || callee.index >= nodes.length { return false }
            if let BodyNodeKind.Expression {form: BodyExpression.Field {value: receiver, index}, ..} = &nodes[callee.index].kind {
              if index != usize.ZERO || receiver.index >= nodes.length { return false }
              if let BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} = &nodes[receiver.index].kind {
                if local.index != usize.ZERO { return false }
              } else { return false }
            } else { return false }
            calls = calls + usize.ONE
          }
          _ => ()
        }
        at = at + usize.ONE
      }
      return calls == usize.ONE
    })
  }
  return false
}

test effect fn privateInherentReceiverNameBlocksConformanceFallback() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let library = run module("library.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let client = run module("method-client.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let libraryText = "pub interface Rescue { fn call(value: Self) -> i32 }\npub struct Hidden {}\nimpl Rescue for Hidden { fn call(value: Self) -> i32 { return 1 } }\nimpl Hidden { fn call(self: Self) -> i32 { return 2 } }\n"
  let clientText = "import library { Hidden, Rescue }\nfn outside(value: Hidden) -> i32 { return value.call() }\n"
  let librarySource = run present(libraryText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let clientSource = run present(clientText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &library, &librarySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&first, &client, &clientSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let outside = run Semantic.demandBody(&mut semantic, &mut request, &client, b"outside")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&outside, RejectionCode.PrivateMember, offsetOf(clientText, "call()", usize.ZERO)),
    "a private inherent name keeps its access error even when a public interface supplies it",
  )
  return ()
}

fn lastDeclarationUnit(semantic: &Semantic, family: Family) -> usize {
  let events = Semantic.eventLog(semantic)
  let mut unit = usize.MAX
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].family == family {
      unit = events[at].key
    }
    at = at + usize.ONE
  }
  return unit
}

// The same semantic unit must be found through the revised declaration's current source position.
effect fn stableDeclarationUnitClaims() -> ()
  ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let entry = run module("stable-units.silk")
  let source = run present("fn leaf() -> i32 { return 1 }\nfn entry() -> i32 { return leaf() }\n")
  let initial = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(run Revision.copy(&initial))
  let mut firstRequest = Request.make()
  let first = run Semantic.demandBody(&mut semantic, &mut firstRequest, &entry, b"entry")
  let unit = lastDeclarationUnit(&semantic, Family.Body)
  run Testing.expect(
    unit != usize.MAX && Shared<Result<Answer, NoRejection>>.with<bool>(&first, bodyAnswerIsTyped),
    "initial declaration body has a concrete semantic unit"
  )
  let firstMir = run Semantic.demandMir(&mut semantic, &mut firstRequest, &entry, b"entry")
  let mirUnit = lastDeclarationUnit(&semantic, Family.Mir)
  run Testing.expect(
    mirUnit != usize.MAX
      && Shared<Result<Answer, NoRejection>>.with<AnswerView>(&firstMir, inspect).success,
    "initial lowering has a concrete declaration unit"
  )
  let inserted = run present(
    "fn prefix() -> bool { return true }\nfn leaf() -> i32 { return 2 }\nfn entry() -> i32 { return leaf() }\n"
  )
  let revised = run Revision.publish(&initial, &entry, &inserted)
  run Semantic.update(&mut semantic, run Revision.copy(&revised))
  let mut nextRequest = Request.make()
  let next = run Semantic.demandBody(&mut semantic, &mut nextRequest, &entry, b"entry")
  run Testing.expect(
    lastDeclarationUnit(&semantic, Family.Body) == unit
      && Shared<Result<Answer, NoRejection>>.with<bool>(&next, bodyAnswerIsTyped),
    "insertion and reordering select the same body unit with current declaration projections"
  )
  let nextMir = run Semantic.demandMir(&mut semantic, &mut nextRequest, &entry, b"entry")
  run Testing.expect(
    lastDeclarationUnit(&semantic, Family.Mir) == mirUnit
      && Shared<Result<Answer, NoRejection>>.with<AnswerView>(&nextMir, inspect).success,
    "insertion and reordering retain the lowering unit"
  )
  let mut fresh = makeSemantic(move revised)
  let mut freshRequest = Request.make()
  let expected = run Semantic.demandBody(&mut fresh, &mut freshRequest, &entry, b"entry")
  run Testing.expect(
    agreesWithFresh(&next, &expected),
    "retargeted body and selected callee agree with fresh analysis"
  )
  let deletedText = "fn leaf() -> i32 { return 2 }\n// unique changed-source parse failure\n"
  let deletedSource = run present(deletedText)
  let deleted = run Revision.publish(&initial, &entry, &deletedSource)
  let mut fault = NestedFailureAllocator {
    targetBytes: String.utf8Bytes(deletedText).length,
    rejected: false,
  }
  let failedUpdate = run Effect.result(Semantic.update(&mut semantic, run Revision.copy(&deleted)))
    |> Effect.provideMut<Allocator>(&mut fault)
  let parseFailed = match move failedUpdate {
    Result<(), Cycle | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => true
      Cycle {} => false
    }
    Result<(), Cycle | OutOfMemoryError>.Success {value: ignored} => false
  }
  run Testing.expect(parseFailed && fault.rejected,
    "failed eager changed-source parse is reported before semantic state advances")
  run Semantic.update(&mut semantic, move deleted)

  // The intermediate deletion is never demanded, but still ends the old handle's lifetime.
  let restored = run Revision.publish(&initial, &entry, &inserted)
  run Semantic.update(&mut semantic, move restored)
  let mut restoredRequest = Request.make()
  let reintroduced = run Semantic.demandBody(&mut semantic, &mut restoredRequest, &entry, b"entry")
  run Testing.expect(
    lastDeclarationUnit(&semantic, Family.Body) != unit
      && Shared<Result<Answer, NoRejection>>.with<bool>(&reintroduced, bodyAnswerIsTyped),
    "undemanded deletion and reintroduction create a new body unit instead of reviving the old handle"
  )
  let reintroducedMir = run Semantic.demandMir(
    &mut semantic,
    &mut restoredRequest,
    &entry,
    b"entry"
  )
  run Testing.expect(
    lastDeclarationUnit(&semantic, Family.Mir) != mirUnit
      && Shared<Result<Answer, NoRejection>>.with<AnswerView>(&reintroducedMir, inspect).success,
    "the old backend unit cannot revive through its unchanged emitted name"
  )
  let mut freshRestored = makeSemantic(run Revision.publish(&initial, &entry, &inserted))
  let mut freshRestoredRequest = Request.make()
  let freshBody = run Semantic.demandBody(&mut freshRestored, &mut freshRestoredRequest, &entry, b"entry")
  let freshMir = run Semantic.demandMir(&mut freshRestored, &mut freshRestoredRequest, &entry, b"entry")
  run Testing.expect(agreesWithFresh(&reintroduced, &freshBody)
      && agreesWithFresh(&reintroducedMir, &freshMir),
    "after failed update and retry, restored body and MIR agree with a fresh store")
  return ()
}

test effect fn preservesDeclarationUnitThroughInsertionAndReordering() -> ()
  ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run stableDeclarationUnitClaims() |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// Fails the last allocation of an update. With a loaded body and MIR, this is the dependency
// graph's first traversal-queue reservation, after the source and declaration refresh.
struct UpdateAllocationProbe {
  failAt: usize
  allocations: usize
  lastAlignment: usize
  rejected: bool
}

impl UpdateAllocationProbe {
  effect fn allocate(self: &mut Self, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
    if self.allocations == self.failAt {
      self.rejected = true
      fail OutOfMemoryError {}
    }
    self.allocations = self.allocations + usize.ONE
    self.lastAlignment = layout.alignment
    let mut system = Allocator.systemAllocatorProvider()
    return run Allocator.allocate(move layout)
      |> Effect.provideMut<Allocator>(&mut system)
  }
}

impl Allocator for UpdateAllocationProbe {
  allocate: UpdateAllocationProbe.allocate
}

effect fn loadedForUpdateRecovery(revision: Revision, entry: &ModuleId) -> Semantic
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch
? &mut Allocator | &mut Types {
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  drop run Semantic.demandBody(&mut semantic, &mut request, entry, b"entry")
  drop run Semantic.demandMir(&mut semantic, &mut request, entry, b"entry")
  drop run Semantic.demandBody(&mut semantic, &mut request, entry, b"entry")
  drop run Semantic.demandMir(&mut semantic, &mut request, entry, b"entry")
  return move semantic
}

effect fn postCommitFailureClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("update-recovery.silk")
  let original = run present("fn leaf() -> i32 { return 1 }\nfn entry() -> i32 { return leaf() }\n")
  let initial = run Revision.publish(&Revision.make(), &entry, &original)
  let deleted = run present("fn leaf() -> i32 { return 2 }\n")
  let revised = run Revision.publish(&initial, &entry, &deleted)
  let mut measured = run loadedForUpdateRecovery(run Revision.copy(&initial), &entry)
  let mut count = UpdateAllocationProbe {
    failAt: usize.MAX, allocations: usize.ZERO, lastAlignment: usize.ZERO, rejected: false,
  }
  let measuredRevision = run Revision.copy(&revised)
  run Semantic.update(&mut measured, move measuredRevision)
    |> Effect.provideMut<Allocator>(&mut count)
  run Testing.expect(count.allocations > usize.ZERO && count.lastAlignment == Layout.of<u32>().alignment,
    "the final update allocation is the graph's u32 traversal queue")

  let mut warm = run loadedForUpdateRecovery(run Revision.copy(&initial), &entry)
  let oldBodyUnit = lastDeclarationUnit(&warm, Family.Body)
  let oldMirUnit = lastDeclarationUnit(&warm, Family.Mir)
  let mut fault = UpdateAllocationProbe {
    failAt: count.allocations - usize.ONE,
    allocations: usize.ZERO,
    lastAlignment: usize.ZERO,
    rejected: false,
  }
  let attemptedRevision = run Revision.copy(&revised)
  let attempt = run Effect.result(Semantic.update(&mut warm, move attemptedRevision))
    |> Effect.provideMut<Allocator>(&mut fault)
  let failed = match move attempt {
    Result<(), Cycle | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => true
      Cycle {} => false
    }
    Result<(), Cycle | OutOfMemoryError>.Success {value: ignored} => false
  }
  let sourceEvents = Semantic.sourceEvents(&warm)
  run Testing.expect(failed && fault.rejected && sourceEvents.length == 3
      && sourceEvents[1].revision == Revision.revisionNumber(&revised),
    "graph queue failure occurs after source revision commits")

  // A demand immediately after failure must finish publication before it can reuse a cached body.
  let mut failedRequest = Request.make()
  let missing = run Semantic.demandBody(&mut warm, &mut failedRequest, &entry, b"entry")
  let mut freshDeleted = makeSemantic(run Revision.copy(&revised))
  let mut freshDeletedRequest = Request.make()
  let freshMissing = run Semantic.demandBody(&mut freshDeleted, &mut freshDeletedRequest, &entry, b"entry")
  run Testing.expect(agreesWithFresh(&missing, &freshMissing) && !succeeded(&missing),
    "a demand after graph-stage failure settles pending invalidation before cache reuse")
  run Semantic.update(&mut warm, run Revision.copy(&revised))

  let restored = run Revision.publish(&revised, &entry, &original)
  run Semantic.update(&mut warm, run Revision.copy(&restored))
  let mut restoredRequest = Request.make()
  let body = run Semantic.demandBody(&mut warm, &mut restoredRequest, &entry, b"entry")
  let mir = run Semantic.demandMir(&mut warm, &mut restoredRequest, &entry, b"entry")
  let mut freshRestored = makeSemantic(move restored)
  let mut freshRestoredRequest = Request.make()
  let freshBody = run Semantic.demandBody(&mut freshRestored, &mut freshRestoredRequest, &entry, b"entry")
  let freshMir = run Semantic.demandMir(&mut freshRestored, &mut freshRestoredRequest, &entry, b"entry")
  run Testing.expect(lastDeclarationUnit(&warm, Family.Body) != oldBodyUnit
      && lastDeclarationUnit(&warm, Family.Mir) != oldMirUnit
      && agreesWithFresh(&body, &freshBody) && agreesWithFresh(&mir, &freshMir),
    "same-revision retry and reintroduction never revive lost body or MIR handles")
  return ()
}

test effect fn graphStageFailureReplaysBeforeDemandAndSameRevisionRetry() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run postCommitFailureClaims() |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
