struct InterfaceCallPair {
  firstContract: Shared<Type>
  secondContract: Shared<Type>
  firstProvider: Shared<Type>
  secondProvider: Shared<Type>
  sameOperation: bool
  sameWitness: bool
  hasWitness: bool
  oneReceiverPerCall: bool
  qualifiedThenReceiver: bool
}

struct ForwardedTypes {
  local: Shared<Type>
  moved: Shared<Type>
  checked: bool
}

fn forwardedTypes(body: &TypedBody) -> Option<ForwardedTypes> {
  let locals = TypedBody.localSlice(body)
  let nodes = TypedBody.nodeSlice(body)
  if locals.length != usize.ONE || nodes.length != 4 {
    return Option<ForwardedTypes>.none()
  }
  if let BodyNodeKind.Expression {ty, form: BodyExpression.Move {..}} = &nodes[usize.ONE].kind {
    return Option<ForwardedTypes>.some(ForwardedTypes {
      local: Shared<Type>.clone(&locals[usize.ZERO].ty),
      moved: Shared<Type>.clone(&ty),
      checked: bodyIsFullyChecked(body),
    })
  }
  return Option<ForwardedTypes>.none()
}

fn sameWitness(
  left: &Option<Shared<DeclarationId>>,
  right: &Option<Shared<DeclarationId>>,
) -> bool {
  return match &left.* {
    Option<Shared<DeclarationId>>.None => match &right.* {
      Option<Shared<DeclarationId>>.None => true
      _ => false
    }
    Option<Shared<DeclarationId>>.Some {value: first} => match &right.* {
      Option<Shared<DeclarationId>>.Some {value: second} => sameStep(&first, &second)
      _ => false
    }
  }
}

fn interfaceCallPair(body: &TypedBody) -> Option<InterfaceCallPair> {
  let nodes = TypedBody.nodeSlice(body)
  let mut first = usize.MAX
  let mut second = usize.MAX
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {..}, ..} = &nodes[at].kind {
      if first == usize.MAX {
        first = at
      } else if second == usize.MAX {
        second = at
      }
    }
    at = at + usize.ONE
  }
  if first == usize.MAX || second == usize.MAX {
    return Option<InterfaceCallPair>.none()
  }
  if let BodyNodeKind.Expression {
    form: BodyExpression.InterfaceCall {
      contract: firstContract,
      provider: firstProvider,
      operation: firstOperation,
      implementation: firstWitness,
      receiverPass: firstPass,
      arguments: firstArguments,
      ..
    }, ..
  } = &nodes[first].kind {
    if let BodyNodeKind.Expression {
      form: BodyExpression.InterfaceCall {
        contract: secondContract,
        provider: secondProvider,
        operation: secondOperation,
        implementation: secondWitness,
        receiverPass: secondPass,
        arguments: secondArguments,
        ..
      }, ..
    } = &nodes[second].kind {
      let hasWitness = match &firstWitness {
        Option<Shared<DeclarationId>>.Some {..} => true
        _ => false
      }
      let firstExplicit = match &firstPass {
        Option<BodyReceiverPass>.None => true
        _ => false
      }
      let secondMethod = match &secondPass {
        Option<BodyReceiverPass>.Some {..} => true
        _ => false
      }
      return Option<InterfaceCallPair>.some(InterfaceCallPair {
        firstContract: Shared<Type>.clone(&firstContract),
        secondContract: Shared<Type>.clone(&secondContract),
        firstProvider: Shared<Type>.clone(&firstProvider),
        secondProvider: Shared<Type>.clone(&secondProvider),
        sameOperation: DeclarationId.equals(&firstOperation, &secondOperation),
        sameWitness: sameWitness(&firstWitness, &secondWitness),
        hasWitness: hasWitness,
        oneReceiverPerCall: Vector<BodyNodeId>.length(&firstArguments) == usize.ONE && Vector<BodyNodeId>.length(&secondArguments) == usize.ONE,
        qualifiedThenReceiver: firstExplicit && secondMethod,
      })
    }
  }
  return Option<InterfaceCallPair>.none()
}

fn answerInterfaceCallPair(answer: &Result<Answer, NoRejection>) -> Option<InterfaceCallPair> {
  let body = checkedBody(answer)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared<TypedBody>.with<Option<InterfaceCallPair>>(&value, interfaceCallPair)
  }
  return Option<InterfaceCallPair>.none()
}

fn isUnknownType(value: &Rejection) -> bool {
  return value.code == RejectionCode.UnknownType
}

fn isUnknownImportedMember(value: &Rejection) -> bool {
  return value.code == RejectionCode.UnknownImportedMember
}

fn isMissingModule(value: &Rejection) -> bool {
  return value.code == RejectionCode.MissingModule && value.span.end > value.span.start
}

fn isPrivateExposure(value: &Rejection) -> bool {
  return value.code == RejectionCode.PrivateTypeExposure && value.span.end > value.span.start
}

fn isCollision(value: &Rejection) -> bool {
  return value.code == RejectionCode.Collision
}

fn cycleAnchoredAt(answer: &Result<Answer, NoRejection>, start: usize) -> bool {
  let found = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared<Rejection>.with<bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == RejectionCode.CyclicTypeAlias && diagnostic.span.start == start && diagnostic.span.end == start + usize.ONE
      },
    )
  }
  return false
}

fn importCycleAnchor(value: &Rejection) -> bool {
  return value.span.end > value.span.start
}

fn memberNames(answer: &Result<Answer, NoRejection>, first: &[u8], second: &[u8]) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Members {members, ..}} => {
        let entries = Vector.asSlice(&members)
        if entries.length != 2 {
          return false
        }
        return match & entries[0].name {
          Option<Bytes>.Some {value: left} => match & entries[1].name {
            Option<Bytes>.Some {value: right} => sameBytes(Bytes.asSlice(&left), first) && sameBytes(
              Bytes.asSlice(&right),
              second,
            )
            _ => false
          }
          _ => false
        }
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn memberSingleName(answer: &Result<Answer, NoRejection>, expected: &[u8]) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Members {members, ..}} => {
        let entries = Vector<Member>.asSlice(&members)
        if entries.length != 1 {
          return false
        }
        return match & entries[0].name {
          Option<Bytes>.Some {value: name} => sameBytes(Bytes.asSlice(&name), expected)
          Option<Bytes>.None => false
        }
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn shapeCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.MemberShape {types}} => Vector<Shared<Type>>.length(&types)
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

fn shapeFirstIsBool(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.MemberShape {types}} => {
        let values = Vector<Shared<Type>>.asSlice(&types)
        return values.length == 1 && Shared<Type>.with<bool>(&values[0], isBool)
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn shapeFirstIsI32(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.MemberShape {types}} => {
        let values = Vector<Shared<Type>>.asSlice(&types)
        return values.length == 1 && Shared<Type>.with<bool>(&values[0], isI32)
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn shapeFirstIsNominal(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.MemberShape {types}} => {
        let values = Vector<Shared<Type>>.asSlice(&types)
        return values.length == 1 && Shared<Type>.with<bool>(&values[0], isNominal)
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn zeroArrayOfNominal(value: &Type) -> bool {
  return match & value.* {
    Type.Array {element, extent} => sameBytes(Bytes.asSlice(&extent), b"0") && Shared<
      Type,
    >.with<
      bool,
    >(&element, isNominal)
    _ => false
  }
}

fn signatureIsZeroNominalArray(answer: &Result<Answer, NoRejection>) -> bool {
  let result = signatureResult(answer)
  if let Option<Shared<Type>>.Some {value: ty} = move result {
    return Shared<Type>.with<bool>(&ty, zeroArrayOfNominal)
  }
  return false
}

// Demands one fixed set of member facts and their consumers. Warm and fresh stores must agree at
// each stage: 0 is the initial source, 1 changes the field type, and 2 renames the fields, makes
// the second member present, and writes an unknown first field type.
effect fn memberFacts(
  semantic: &mut Semantic,
  geometry: &ModuleId,
  consumer: &ModuleId,
  point: &Shared<Type>,
  text: &[u8],
  stage: usize,
) -> bool ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch ? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let identity = run Semantic.demandIdentity(&mut semantic.*, &mut request, geometry, b"Point")
  let names = run Semantic.demandMembers(&mut semantic.*, &mut request, geometry, b"Point")
  let first = run Semantic.demandMemberShape(
    &mut semantic.*,
    &mut request,
    geometry,
    b"Point",
    0,
    point,
  )
  let second = run Semantic.demandMemberShape(
    &mut semantic.*,
    &mut request,
    geometry,
    b"Point",
    1,
    point,
  )
  let origin = run Semantic.demandSignature(&mut semantic.*, &mut request, consumer, b"origin")
  let caller = run Semantic.demandBody(&mut semantic.*, &mut request, consumer, b"caller")
  let sameIdentity = run typesEqual(
    Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&identity, nominalResult),
    Option<Shared<Type>>.some(Shared<Type>.clone(point)),
  )
  let sameParameter = run typesEqual(
    slotOf(&origin, usize.ZERO),
    Option<Shared<Type>>.some(Shared<Type>.clone(point)),
  )
  let callerBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(
    &caller,
    checkedBody,
  )
  let mut callsLeaf = false
  if let Option<Shared<TypedBody>>.Some {value} = move callerBody {
    callsLeaf = Shared<TypedBody>.with<bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return bodyCalls(body, geometry, usize.ZERO)
      },
    )
  }
  let consumers = sameIdentity && sameParameter && callsLeaf && Semantic.requestDiscovered(
    &mut semantic.*, &request,
    geometry,
  )
  if stage == 2 {
    return consumers && Shared<Result<Answer, NoRejection>>.with<bool>(
      &names,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return memberNames(answer, b"height", b"depth")
      },
    ) && Shared<Result<Answer, NoRejection>>.with<bool>(
      &first,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.UnknownLifetime, text, b"'undeclared")
      },
    ) && Shared<Result<Answer, NoRejection>>.with<bool>(&second, shapeFirstIsI32)
  }
  let widthOnly = Shared<Result<Answer, NoRejection>>.with<bool>(
    &names,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return memberSingleName(answer, b"width")
    },
  )
  let absent = Shared<Result<Answer, NoRejection>>.with<bool>(
    &second,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectedTypeApplication(answer, RejectionCode.IdentityUnavailable)
    },
  )
  if stage == usize.ONE {
    return consumers && widthOnly && absent && Shared<Result<Answer, NoRejection>>.with<bool>(
      &first,
      shapeFirstIsBool,
    )
  }
  return consumers && widthOnly && absent && Shared<Result<Answer, NoRejection>>.with<bool>(
    &first,
    shapeFirstIsI32,
  )
}

effect fn memberRevisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let geometry = run module("geometry.silk")
  let consumer = run module("consumer.silk")
  let consumerSource = run present(
    "import geometry as Geometry\nfn origin(at: Geometry.Point) -> () { return () }\nfn caller() -> i32 { return Geometry.leaf() }\nfn unrelated() -> i32 { return 2 }\n",
  )
  let initialText = "type Element = i32\npub struct Point { width: Element }\npub fn leaf() -> i32 { return 1 }\n"
  let initialSource = run present(initialText)
  let base = run Revision.publish(&Revision.make(), &consumer, &consumerSource)
  let held = run Revision.publish(&base, &geometry, &initialSource)
  let mut semantic = makeSemantic(run Revision.copy(&held))
  let mut original = Request.make()
  let identity = run Semantic.demandIdentity(&mut semantic, &mut original, &geometry, b"Point")
  let nominal = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &identity,
    nominalResult,
  )
  let point = match move nominal {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      run Testing.expect(false, "the nominal identity resolves")
      return ()
    }
  }
  let initial = run memberFacts(
    &mut semantic,
    &geometry,
    &consumer,
    &point,
    String.utf8Bytes(initialText),
    usize.ZERO,
  )
  let unrelated = run Semantic.demandBody(&mut semantic, &mut original, &consumer, b"unrelated")
  run Testing.expect(
    initial && Shared<Result<Answer, NoRejection>>.with<AnswerView>(&unrelated, inspect).success && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 2,
    "names, one field type, an absent member, and their consumers are separate facts",
  )
  let typeText = "type Element = bool\npub struct Point { width: Element }\npub fn leaf() -> i32 { return 1 }\n"
  let typeSource = run present(typeText)
  let typeRevision = run Revision.publish(&held, &geometry, &typeSource)
  run Semantic.update(&mut semantic, run Revision.copy(&typeRevision))
  let warmType = run memberFacts(
    &mut semantic,
    &geometry,
    &consumer,
    &point,
    String.utf8Bytes(typeText),
    usize.ONE,
  )
  let mut unrelatedRequest = Request.make()
  let kept = run Semantic.demandBody(&mut semantic, &mut unrelatedRequest, &consumer, b"unrelated")
  let mut freshType = makeSemantic(run Revision.copy(&typeRevision))
  let coldType = run memberFacts(
    &mut freshType,
    &geometry,
    &consumer,
    &point,
    String.utf8Bytes(typeText),
    usize.ONE,
  )
  run Testing.expect(
    warmType && coldType && Shared<Result<Answer, NoRejection>>.with<AnswerView>(&kept, inspect).success && starts(Semantic.eventLog(&semantic), Family.Body) == 2 && hits(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 2 && starts(Semantic.eventLog(&freshType), Family.Body) == 1,
    "a field type edit keeps both unrelated body providers cached while warm and fresh member facts agree",
  )
  let renamedText = "type Element = bool\npub struct Point {\n height: &'undeclared i32\n depth: i32\n}\npub fn leaf() -> i32 { return 1 }\n"
  let renamedSource = run present(renamedText)
  let renamedRevision = run Revision.publish(&typeRevision, &geometry, &renamedSource)
  run Semantic.update(&mut semantic, run Revision.copy(&renamedRevision))
  let warmRenamed = run memberFacts(
    &mut semantic,
    &geometry,
    &consumer,
    &point,
    String.utf8Bytes(renamedText),
    2,
  )
  let mut freshRenamed = makeSemantic(run Revision.copy(&renamedRevision))
  let coldRenamed = run memberFacts(
    &mut freshRenamed,
    &geometry,
    &consumer,
    &point,
    String.utf8Bytes(renamedText),
    2,
  )
  run Testing.expect(
    warmRenamed && coldRenamed && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 2,
    "renamed names, a newly present member, and a current field diagnostic reach their consumers without restarting unrelated bodies",
  )
  let faultText = "type Element = bool\npub struct Point {\n height: bool\n depth: i32\n}\npub fn leaf() -> i32 { return 1 }\n"
  let faultSource = run present(faultText)
  let faultModule = run module("faultsource.silk")
  let nestedText = "pub fn leaf() -> i32 { return 3 }\n// This new module is first loaded while the caller revalidates.\n"
  let nestedSource = run present(nestedText)
  let revisedConsumer = run present(
    "import geometry as Geometry\nimport faultsource as Fault\nfn origin(at: Geometry.Point) -> () { return () }\nfn caller() -> i32 { return Fault.leaf() }\nfn unrelated() -> i32 { return 2 }\n",
  )
  let fixedGeometry = run Revision.publish(&renamedRevision, &geometry, &faultSource)
  let addedModule = run Revision.publish(&fixedGeometry, &faultModule, &nestedSource)
  let faultRevision = run Revision.publish(&addedModule, &consumer, &revisedConsumer)
  run Semantic.update(&mut semantic, run Revision.copy(&faultRevision))
  let mut fault = NestedFailureAllocator {
    targetBytes: String.utf8Bytes(nestedText).length,
    rejected: false,
  }
  let mut failedRequest = Request.make()
  let attempted = run Effect.result(
    Semantic.demandBody(&mut semantic, &mut failedRequest, &consumer, b"caller"),
  )
    |> Effect.provideMut<Allocator>(&mut fault)
  let failed = match move attempted {
    Result<
      Shared<Result<Answer, NoRejection>>,
      Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError,
    >.Failure {error} => match move error {
      OutOfMemoryError {} => true
      _ => false
    }
    Result<
      Shared<Result<Answer, NoRejection>>,
      Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError,
    >.Success {value: ignored} => false
  }
  let mut retriedRequest = Request.make()
  let retried = run Semantic.demandBody(&mut semantic, &mut retriedRequest, &consumer, b"caller")
  run Testing.expect(
    failed && fault.rejected && Request.rootCount(&failedRequest) == 0 && Shared<
      Result<Answer, NoRejection>,
    >.with<
      AnswerView,
    >(&retried, inspect).success && Semantic.requestDiscovered(&mut semantic, &retriedRequest, &faultModule) && starts(Semantic.eventLog(&semantic), Family.Body) == 4,
    "a newly imported source failure publishes nothing, and retry checks the current caller",
  )
  let mut freshFault = makeSemantic(move faultRevision)
  let mut freshFaultRequest = Request.make()
  let freshRetried = run Semantic.demandBody(&mut freshFault, &mut freshFaultRequest, &consumer, b"caller")
  run Testing.expect(agreesWithFresh(&retried, &freshRetried), "the retried caller agrees with a fresh store of the same revision")
  return ()
}

fn staleMemberKindRejected(answer: &Result<Answer, NoRejection>) -> bool {
  let diagnostic = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    return Shared<Rejection>.with<bool>(
      &value,
      fn(found: &Rejection) -> bool {
        return found.code == RejectionCode.TypeArgumentKind && found.span.end > found.span.start && Bytes.asSlice(
          &found.parameterName,
        ).length > usize.ZERO && found.expectedKind == GenericKind.Lifetime && found.suppliedKind == GenericKind.Type
      },
    )
  }
  return false
}

effect fn memberKindRevisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("member-kind-edits.silk")
  let source = run present("struct Box<T> { value: T }\nfn applied() -> Box<bool> { return () }\n")
  let held = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(run Revision.copy(&held))
  let mut original = Request.make()
  let signature = run Semantic.demandSignature(&mut semantic, &mut original, &entry, b"applied")
  let applied = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value: application} = move applied {
    let changed = run present("struct Box<'life> { value: bool }\n")
    let revision = run Revision.publish(&held, &entry, &changed)
    run Semantic.update(&mut semantic, run Revision.copy(&revision))
    let mut request = Request.make()
    let shape = run Semantic.demandMemberShape(
      &mut semantic,
      &mut request,
      &entry,
      b"Box",
      0,
      &application,
    )
    run Testing.expect(
      Shared<Result<Answer, NoRejection>>.with<bool>(&shape, staleMemberKindRejected),
      "a stale application reports the changed generic argument kind at a source span",
    )
    let mut freshChanged = makeSemantic(move revision)
    let mut freshChangedRequest = Request.make()
    let freshShape = run Semantic.demandMemberShape(
      &mut freshChanged,
      &mut freshChangedRequest,
      &entry,
      b"Box",
      0,
      &application,
    )
    run Testing.expect(agreesWithFresh(&shape, &freshShape), "the stale application shape agrees with a fresh store of the same revision")
  } else {
    run Testing.expect(false, "the original generic application resolves")
  }
  return ()
}

fn nameIsA(value: &Bytes) -> bool {
  let name = Bytes.asSlice(value)
  return name.length == 1 && name[usize.ZERO] == 65
}

fn isWrongTypeKind(found: &Rejection) -> bool {
  if found.code != RejectionCode.TypeArgumentKind || found.span.end <= found.span.start {
    return false
  }
  return nameIsA(&found.parameterName) && found.expectedKind == GenericKind.Type && found.suppliedKind == GenericKind.Lifetime
}

fn wrongTypeKind(answer: &Result<Answer, NoRejection>) -> bool {
  let diagnostic = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    return Shared<Rejection>.with<bool>(&value, isWrongTypeKind)
  }
  return false
}

fn nominalOwnedBy(resolved: &Type, module: &ModuleId) -> bool {
  return match & resolved.* {
    Type.Nominal {declaration, ..} => ModuleId.equals(DeclarationId.moduleId(&declaration), module)
    _ => false
  }
}

fn signatureOwnedBy(answer: &Shared<Result<Answer, NoRejection>>, module: &ModuleId) -> bool {
  let result = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    answer,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    return Shared<Type>.with<bool>(
      &value,
      fn(resolved: &Type) -> bool {
        return nominalOwnedBy(resolved, module)
      },
    )
  }
  return false
}

fn signatureIsBool(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let result = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    answer,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    return Shared<Type>.with<bool>(&value, isBool)
  }
  return false
}

fn importedSignatureHasDependencies(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let dependencies = Vector<Dependency>.asSlice(&value.dependencies)
      let mut selected = false
      let mut namespace = false
      let mut publicName = false
      let mut alias = false
      let mut identity = false
      let mut at = usize.ZERO
      while at < dependencies.length {
        let item = &dependencies[at]
        if item.family == Family.Import {
          match move Dependency.member(item) {
            Option<usize>.Some {value: ordinal} => {
              if ordinal == usize.ZERO {
                selected = true
              }
            }
            Option<usize>.None => {
              namespace = true
            }
          }
        }
        if item.family == Family.Name && item.external {
          publicName = true
        }
        if item.family == Family.Alias {
          alias = true
        }
        if item.family == Family.Identity {
          identity = true
        }
        at = at + usize.ONE
      }
      return selected && namespace && publicName && alias && identity
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

effect fn lazyClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("entry.silk")
  let missing = run module("missing.silk")
  let source = run present(
    "import missing as Ghost\ntype Broken = Unknown\nfn entry() -> i32 { return unknown() }\nfn missing(value: Ghost.Thing) -> i32 { return 0 }\n",
  )
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let signature = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let first = Shared<Result<Answer, NoRejection>>.with<AnswerView>(&signature, inspect)
  run Testing.expect(
    first.success && Semantic.sourcesRead(&mut semantic, &signature) == 1,
    "written signature needs entry source only",
  )
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &entry) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &missing,
    ) == 0,
    "unused import target stays unread",
  )
  run Testing.expect(
    starts(Semantic.eventLog(&semantic), Family.Import) == 0 && starts(
      Semantic.eventLog(&semantic),
      Family.Alias,
    ) == 0,
    "unused import and bad alias stay undemanded",
  )
  let broken = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Broken")
  let rejected = Shared<Result<Answer, NoRejection>>.with<AnswerView>(&broken, inspect)
  let diagnostic = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &broken,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      !rejected.success && Shared<Rejection>.with<bool>(&value, isUnknownType) && rejected.dependencies > 0 && Semantic.sourcesRead(&mut semantic, &broken) == 1,
      "demanded bad alias records negative name dependency",
    )
  } else {
    run Testing.expect(false, "demanded bad alias has a typed rejection")
  }
  let again = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let hit = Shared<Result<Answer, NoRejection>>.with<AnswerView>(&again, inspect)
  run Testing.expect(
    hit.success && Semantic.sourcesRead(&mut semantic, &again) == 1 && reads(Semantic.sourceEvents(&semantic), &entry) == 1,
    "memo hit retains evidence without another source read",
  )
  let demanded = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"missing")
  let missingDiagnostic = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &demanded,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move missingDiagnostic {
    run Testing.expect(
      Shared<Rejection>.with<bool>(&value, isMissingModule),
      "demanded import target absence is anchored",
    )
  } else {
    run Testing.expect(false, "demanded missing import has a typed rejection")
  }
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &missing) == 1,
    "missing target is read only on demand",
  )
  return ()
}

test effect fn defersUnusedDeclarationsAndReusesWrittenSignature() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run lazyClaims()
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn importClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("entry.silk")
  let library = run module("library.silk")
  let librarySource = run present(
    "pub struct Thing { field: &'undeclared i32 }\npub type PublicAlias = Thing\n",
  )
  let first = run Revision.publish(&Revision.make(), &library, &librarySource)
  let entrySource = run present(
    "import library as Library { PublicAlias as Alias }\nfn entry(value: Alias) -> Library.Thing { return move value }\n",
  )
  let revision = run Revision.publish(&first, &entry, &entrySource)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let signature = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let result = Shared<Result<Answer, NoRejection>>.with<AnswerView>(&signature, inspect)
  run Testing.expect(result.success, "imported alias resolves from written signature")
  run Testing.expect(result.dependencies > 0, "imported alias records nested demands")
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&signature, importedSignatureHasDependencies),
    "signature keeps selected import ordinal, namespace, public name, alias, and identity edges",
  )
  run Testing.expect(Semantic.sourcesRead(&mut semantic, &signature) == 2, "signature reads each directly inspected source")
  let writtenResult = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move writtenResult {
    run Testing.expect(
      Shared<Type>.with<bool>(&value, isNominal),
      "alias result retains nominal identity",
    )
  } else {
    run Testing.expect(false, "signature has a written result")
  }
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &entry) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &library,
    ) == 1,
    "import target is read only when alias is used",
  )
  run Testing.expect(
    starts(Semantic.eventLog(&semantic), Family.Import) == 2 && starts(
      Semantic.eventLog(&semantic),
      Family.Alias,
    ) == 1 && starts(Semantic.eventLog(&semantic), Family.Identity) == 1,
    "hybrid namespace and selected alias share nominal identity",
  )
  let again = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let cached = Shared<Result<Answer, NoRejection>>.with<AnswerView>(&again, inspect)
  run Testing.expect(
    cached.success && cached.dependencies == result.dependencies && Semantic.sourcesRead(&mut semantic, &again) == 2,
    "imported signature memo hit keeps fact and dependency evidence",
  )
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &entry) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &library,
    ) == 1,
    "imported signature memo hit does not reread sources",
  )
  let priorSignatureStarts = starts(Semantic.eventLog(&semantic), Family.Signature)
  let priorSignatureHits = hits(Semantic.eventLog(&semantic), Family.Signature)
  let mut fresh = Request.make()
  run Testing.expect(
    Request.rootCount(&fresh) == 0 && !Semantic.requestDiscovered(&mut semantic, &fresh, &library),
    "fresh request has no inherited roots or discoveries",
  )
  let replayed = run Semantic.demandSignature(&mut semantic, &mut fresh, &entry, b"entry")
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&replayed, inspect).success && Request.rootCount(
      &fresh,
    ) == 1 && Request.hasRoot(&fresh, Family.Signature, &entry, b"entry") && Semantic.requestDiscovered(
      &mut semantic, &fresh,
      &entry,
    ) && Semantic.requestDiscovered(&mut semantic, &fresh, &library) && Semantic.requestDemanded(
      &mut semantic, &fresh,
      Family.Alias,
      &library,
    ) && Semantic.requestDemanded(&mut semantic, &fresh, Family.Identity, &library),
    "fresh request replays imported discovery and nested demand evidence",
  )
  run Testing.expect(
    priorSignatureStarts == starts(Semantic.eventLog(&semantic), Family.Signature) && hits(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == priorSignatureHits + 1 && reads(Semantic.sourceEvents(&semantic), &library) == 1,
    "replay emits only the actual root hit and no new provider read",
  )
  return ()
}

test effect fn resolvesImportedAliasWithoutFieldsOrBodies() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run importClaims()
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// MODULE-STATIC-001/002: selected arm members belong to the module namespace, inactive ones are
// absent, and a failed condition admits neither arm.
effect fn moduleSelectionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("entry.silk")
  let library = run module("library.silk")
  let helper = run module("helper.silk")
  let missing = run module("missing.silk")
  let libraryText = """
static if true && true {
  import helper { Helped }
  pub fn helped(value: Helped) -> i32 { return 0 }
  pub param gated: bool
  pub struct Chosen {}
  impl Chosen {
    pub fn make() -> Chosen { return Chosen {} }
  }
  static if false {
    pub fn pick() -> bool { return true }
  } else {
    pub fn pick() -> i32 { return 1 }
  }
} else {
  import missing { Gone }
  pub struct Chosen {}
  pub struct Hidden {}
}
static if false {
  import helper { Helped as Twin }
} else {
  import helper { Helped as Twin }
}
pub fn twin(value: Twin) -> i32 { return 0 }
static if 7 {
  pub fn broken() -> i32 { return 0 }
}
static if cyclic() {
  pub static fn cyclic() -> bool { return true }
}
static if false {
  pub param hiddenParameter: bool
}
static if 7 {
  pub param brokenParameter: bool
}
"""
  let entryText = "import library { Chosen, Hidden }\nfn entry(value: Chosen) -> i32 { return 0 }\nfn hiddenUse(value: Hidden) -> i32 { return 0 }\n"
  let librarySource = run present(libraryText)
  let entrySource = run present(entryText)
  let helperSource = run present("pub struct Helped {}\n")
  let first = run Revision.publish(&Revision.make(), &library, &librarySource)
  let second = run Revision.publish(&first, &helper, &helperSource)
  let revision = run Revision.publish(&second, &entry, &entrySource)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  run Request.registerSchemaModule(&mut request, &library)
  let chosen = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let helped = run Semantic.demandSignature(&mut semantic, &mut request, &library, b"helped")
  let twin = run Semantic.demandSignature(&mut semantic, &mut request, &library, b"twin")
  let cyclic = run Semantic.demandSignature(&mut semantic, &mut request, &library, b"cyclic")
  let gated = run Semantic.demandParameterSchema(&mut semantic, &mut request, &library, b"gated")
  let hiddenParameter = run Semantic.demandParameterSchema(&mut semantic, &mut request, &library, b"hiddenParameter")
  let brokenParameter = run Semantic.demandParameterSchema(&mut semantic, &mut request, &library, b"brokenParameter")
  let hidden = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"hiddenUse")
  let pick = run Semantic.demandSignature(&mut semantic, &mut request, &library, b"pick")
  let make = run Semantic.demandInherentMember(&mut semantic, &mut request, &library, b"Chosen", b"make")
  let broken = run Semantic.demandSignature(&mut semantic, &mut request, &library, b"broken")
  let picked = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&pick, signatureResult)
  let pickIsI32 = match &picked {
    Option<Shared<Type>>.Some {value} => Shared<Type>.with<bool>(&value, isI32)
    Option<Shared<Type>>.None => false
  }
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&chosen, inspect).success && pickIsI32,
    "an importer and the module see only the selected arm, including a nested else arm",
  )
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&make, inspect).success,
    "an impl in a selected arm publishes inherent members",
  )
  run Testing.expect(
    rejectsSpan(&hidden, RejectionCode.UnknownImportedMember, entryText, "Hidden", usize.ZERO),
    "an inactive-only declaration is absent at its import",
  )
  run Testing.expect(
    rejectsSpan(&broken, RejectionCode.ConditionNotBool, libraryText, "7", usize.ZERO),
    "a non-bool condition admits neither arm and keeps its anchored rejection",
  )
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&helped, inspect).success && reads(
      Semantic.sourceEvents(&semantic),
      &missing,
    ) == 0,
    "a selected arm's import resolves while an inactive arm's import is never read",
  )
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&twin, inspect).success,
    "the same import in both arms survives through whichever arm is selected",
  )
  run Testing.expect(
    rejectsSpan(&cyclic, RejectionCode.Cycle, libraryText, "cyclic", usize.ONE) &&
      rejectsFrom(&gated, RejectionCode.ConditionalParameter, offsetOf(libraryText, "pub param gated", usize.ZERO)) &&
      rejectsFrom(&hiddenParameter, RejectionCode.ConditionalParameter, offsetOf(libraryText, "pub param hiddenParameter", usize.ZERO)) &&
      rejectsFrom(&brokenParameter, RejectionCode.ConditionalParameter, offsetOf(libraryText, "pub param brokenParameter", usize.ZERO)),
    "a condition using its own arm is a cycle, and any conditional package parameter is rejected before selection",
  )
  return ()
}

test effect fn moduleArmsSelectNativeDeclarations() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run moduleSelectionClaims()
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// Answers for one condition's helpers must not depend on which demand reaches them first. Each
// order uses a fresh store.
effect fn conditionOrderClaims(conditionFirst: bool) -> bool
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch
? &mut Allocator | &mut Types {
  let library = run module("ordered.silk")
  let fast = run module("fast.silk")
  let librarySource = run present("""
static fn enabled() -> bool { return 1 == 1 }
static if enabled() {
  import fast { Engine }
  pub fn engine(value: Engine) -> i32 { return 0 }
}
""")
  let fastSource = run present("pub struct Engine {}\n")
  let first = run Revision.publish(&Revision.make(), &library, &librarySource)
  let revision = run Revision.publish(&first, &fast, &fastSource)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  if conditionFirst {
    let armFirst = run Semantic.demandSignature(&mut semantic, &mut request, &library, b"engine")
    let helperLater = run Semantic.demandBody(&mut semantic, &mut request, &library, b"enabled")
    return Shared<Result<Answer, NoRejection>>.with<AnswerView>(&armFirst, inspect).success &&
      Shared<Result<Answer, NoRejection>>.with<AnswerView>(&helperLater, inspect).success
  }
  let enabled = run Semantic.demandBody(&mut semantic, &mut request, &library, b"enabled")
  let engine = run Semantic.demandSignature(&mut semantic, &mut request, &library, b"engine")
  return Shared<Result<Answer, NoRejection>>.with<AnswerView>(&engine, inspect).success &&
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&enabled, inspect).success
}

test effect fn conditionOrderSelectNativeAnswers() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let conditionFirst = run conditionOrderClaims(true) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let helperFirst = run conditionOrderClaims(false) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    conditionFirst && helperFirst,
    "a condition's helper and its arm answer the same whichever is demanded first",
  )
  return ()
}

effect fn cycleClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("entry.silk")
  let source = run present(
    "type A = B\ntype B = A\nfn f() -> i32 { return g() }\nfn g() -> i32 { return f() }\n",
  )
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let function = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"f")
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&function, inspect).success && starts(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == 1,
    "recursive bodies do not demand another signature",
  )
  let alias = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"A")
  let diagnostic = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &alias,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared<Rejection>.with<bool>(&value, fn(diagnostic: &Rejection) -> bool { return diagnostic.code == RejectionCode.CyclicTypeAlias }),
      "alias cycle has its prescribed type-alias reason",
    )
    run Testing.expect(
      Shared<Rejection>.with<usize>(&value, cyclePathLength) == 3,
      "alias cycle has a declaration path",
    )
  } else {
    run Testing.expect(false, "alias cycle has a typed rejection")
  }
  let other = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"B")
  let mut reversed = makeSemantic(move revision)
  let mut reversedRequest = Request.make()
  let reversedOther = run Semantic.demandAlias(&mut reversed, &mut reversedRequest, &entry, b"B")
  let reversedAlias = run Semantic.demandAlias(&mut reversed, &mut reversedRequest, &entry, b"A")
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(
      &alias,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return cycleAnchoredAt(answer, 9)
      },
    ) && Shared<Result<Answer, NoRejection>>.with<bool>(
      &other,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return cycleAnchoredAt(answer, 20)
      },
    ) && rotatedPair(&alias, &other) && sameCycleAnswers(&alias, &reversedAlias) && sameCycleAnswers(
      &other,
      &reversedOther,
    ),
    "each alias cycle member rejects at its own reference in either demand order",
  )
  return ()
}

test effect fn separatesSignatureRecursionFromAliasCycles() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run cycleClaims()
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn memberTypeArgumentPlacementMatchesOwnerArity() -> ()
  ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("member-type-argument-placement.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Maybe<T> { Some { value: T }, None }
impl<T> Maybe<T> {
  fn some(value: T) -> Maybe<T> { return Maybe<T>.Some { value: move value } }
  fn pair<U>(value: T, other: U) -> Maybe<U> { drop value return Maybe<U>.some(move other) }
  fn keep<U>(value: U) -> U { return move value }
}
struct Pair<A, B> { first: A second: B }
impl<A, B> Pair<A, B> {
  fn make(first: A, second: B) -> Pair<A, B> { return Pair { first: move first, second: move second } }
}
fn prefixed() -> i32 { let value = Maybe.some<i32>(1) return 0 }
fn listed() -> i32 { let value = Maybe.pair<bool>(1, true) return 0 }
fn partial() -> i32 { let value = Pair<i32>.make(1, true) return 0 }
fn controls() -> i32 {
  let some = Maybe<i32>.some(1)
  let pair = Maybe<i32>.pair<bool>(1, true)
  let own = Maybe.keep<i32>(1)
  let inferred = Maybe.some(1)
  return own
}
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let prefixed = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"prefixed")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let listed = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"listed")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let partial = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"partial")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let controls = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"controls")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&prefixed, RejectionCode.OwnerArgumentPlacement, text, "<i32>", usize.ZERO),
    "GEN-008 rejects an owner's argument on the member list"
  )
  run Testing.expect(
    rejectsSpan(&listed, RejectionCode.OwnerArgumentPlacement, text, "<bool>", usize.ZERO),
    "GEN-008 requires a written owner even when the list names only the member's own argument"
  )
  run Testing.expect(
    rejectsSpan(&partial, RejectionCode.TypeArity, text, "<i32>", usize.ONE),
    "GEN-002 reports incomplete owner arity at the owner's argument list"
  )
  run Testing.expect(
    succeeded(&controls),
    "written owners, owner-independent generic members and fully inferred owner calls remain valid"
  )
  return ()
}

effect fn aliasClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("entry.silk")
  let text = """interface Combine<Right, Output> { fn combine(left: Self, right: Right) -> Output }
interface Label { fn label(value: &Self) -> i32 }
type Labeled = Label
type Combining = Combine
type CombineTag = Combine<i32, i32>
pub struct Point<T> { x: T y: T }
type Pointed = Point
type Twice = Pointed
type PointI32 = Point<i32>
struct Hidden<T> { value: T }
pub type Leaked = Hidden
pub struct Tag { value: i32 }
impl Tag {
  pub fn make() -> Tag { return Tag { value: 40 } }
  fn tagLabel(value: &Tag) -> i32 { return value.value }
  fn tagCombine(left: Tag, right: i32) -> i32 { return left.value + right }
}
impl Labeled for Tag { label: Tag.tagLabel }
impl Combining<i32, i32> for Tag { combine: Tag.tagCombine }
type Item = Tag
enum Level { Low, High }
type Tier = Level
fn pickTier(flag: bool) -> Tier {
  if flag { return Tier.High }
  return Tier.Low
}
fn rankTier(tier: Tier) -> i32 {
  return match tier {
    Tier.Low => 1
    Tier.High => 2
  }
}
fn direct(point: Point<i32>) -> i32 { return point.x }
fn twice(point: Twice<i32>) -> i32 { return point.x }
fn bare(point: Pointed) -> i32 { return 0 }
fn extra(point: Pointed<i32, i32>) -> i32 { return 0 }
fn fixedExtra(point: PointI32<i32>) -> i32 { return 0 }
fn leaked(value: Leaked<i32>) -> i32 { return 0 }
fn bounded<T: Combining<i32, i32>>(value: T) -> i32 { return Combining<i32, i32>.combine(move value, 1) }
fn caller() -> i32 {
  let tag = Item.make()
  return Labeled.label(&tag) + CombineTag.combine(Tag { value: 2 }, 3) + bounded(Tag { value: 1 })
}
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let direct = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"direct")
  let twice = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"twice")
  let same = run typesEqual(
    Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&direct, fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return typeAt(answer, usize.ZERO) }),
    Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&twice, fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return typeAt(answer, usize.ZERO) }),
  )
  run Testing.expect(same, "an unapplied alias, even through another alias, applies its target to the use's arguments")
  let bare = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"bare")
  let extra = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"extra")
  let fixedExtra = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"fixedExtra")
  run Testing.expect(
    rejectsSpan(&bare, RejectionCode.TypeArity, text, "Pointed", 2)
      && rejectsSpan(&extra, RejectionCode.TypeArity, text, "<i32, i32>", 2)
      && rejectsSpan(&fixedExtra, RejectionCode.TypeArity, text, "<i32>", 3),
    "an unapplied alias takes its target's arity at each use, and a fixed alias accepts no arguments",
  )
  let leaked = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"leaked")
  run Testing.expect(
    rejectsSpan(&leaked, RejectionCode.PrivateTypeExposure, text, "Hidden", usize.ONE),
    "a public alias cannot name a private declaration",
  )
  let caller = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"caller")
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&caller, inspect).success,
    "alias qualifiers name static members and interface operations, keeping fixed arguments",
  )
  let pickTier = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"pickTier")
  let rankTier = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"rankTier")
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&pickTier, inspect).success
      && Shared<Result<Answer, NoRejection>>.with<AnswerView>(&rankTier, inspect).success,
    "an alias qualifies its target enum's members in expressions and patterns",
  )
  return ()
}

test effect fn resolvesTransparentAliases() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run aliasClaims()
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn parameterType(semantic: &mut Semantic, request: &mut Request, entry: &ModuleId, name: string) -> Option<Shared<Type>>
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch ? &mut Allocator | &mut Types {
  let answer = run Semantic.demandSignature(&mut semantic.*, &mut request.*, entry, String.utf8Bytes(name))
  return Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&answer, fn(found: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return typeAt(found, usize.ZERO) })
}

effect fn genericAliasClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("entry.silk")
  let text = """pub struct Pair<A, B> { first: A second: B }
pub struct IoError {}
pub struct Left {}
pub struct Right {}
interface Marker {}
interface Combine<Right, Output> { fn combine(left: Self, right: Right) -> Output }
type IntPair<V> = Pair<i32, V>
type Fallible<T> = T | IoError
type Ref<'a, T> = &'a T
type Same<T> = Combine<T, T>
type Bounded<T: Marker> = Pair<T, T>
type Rowed<?R> = Pair<i32, i32>
type Unused<Phantom> = i32
type Elided = &i32
type ElidedGeneric<T> = &T
pub struct Tag { value: i32 }
impl Tag { fn tagCombine(left: Tag, right: i32) -> i32 { return left.value + right } }
impl Same<i32> for Tag { combine: Tag.tagCombine }
fn pair(value: IntPair<bool>) -> i32 { return 0 }
fn pairPlain(value: Pair<i32, bool>) -> i32 { return 0 }
fn collapsed(value: Fallible<IoError>) -> i32 { return 0 }
fn collapsedPlain(value: IoError) -> i32 { return 0 }
fn widened(value: Fallible<Left | Right>) -> i32 { return 0 }
fn widenedPlain(value: Right | IoError | Left) -> i32 { return 0 }
fn nested(value: Fallible<Fallible<Left>>) -> i32 { return 0 }
fn nestedPlain(value: Left | IoError) -> i32 { return 0 }
fn borrowed<'a>(value: Ref<'a, i32>) -> &'a i32 { return value }
fn bounded(value: Bounded<i32>) -> i32 { return 0 }
fn rowed(value: Rowed) -> i32 { return 0 }
fn unused(value: Unused<bool>) -> i32 { return 0 }
fn elided(value: Elided) -> i32 { return 0 }
fn elidedGeneric(value: ElidedGeneric<i32>) -> i32 { return 0 }
fn bare(value: Fallible) -> i32 { return 0 }
fn extra(value: Fallible<Left, Left>) -> i32 { return 0 }
fn take<T>(value: Fallible<T>) -> i32 { return 0 }
fn sameBound<T: Same<i32>>(value: T) -> i32 { return Same<i32>.combine(move value, 1) }
fn explicit() -> i32 { return take<Left>(Left {}) + sameBound(Tag { value: 1 }) }
fn inferred() -> i32 { return take(Left {}) }
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let mut expanded = true
  expanded = expanded && run typesEqual(run parameterType(&mut semantic, &mut request, &entry, "pair"), run parameterType(&mut semantic, &mut request, &entry, "pairPlain"))
  expanded = expanded && run typesEqual(run parameterType(&mut semantic, &mut request, &entry, "collapsed"), run parameterType(&mut semantic, &mut request, &entry, "collapsedPlain"))
  expanded = expanded && run typesEqual(run parameterType(&mut semantic, &mut request, &entry, "widened"), run parameterType(&mut semantic, &mut request, &entry, "widenedPlain"))
  expanded = expanded && run typesEqual(run parameterType(&mut semantic, &mut request, &entry, "nested"), run parameterType(&mut semantic, &mut request, &entry, "nestedPlain"))
  run Testing.expect(expanded, "a generic alias substitutes its arguments and renormalizes a union target")
  let borrowed = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"borrowed")
  let explicit = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"explicit")
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&borrowed, inspect).success
      && Shared<Result<Answer, NoRejection>>.with<AnswerView>(&explicit, inspect).success,
    "a generic alias takes lifetime arguments and names an interface application in bounds, heads and qualifiers",
  )
  let bounded = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"bounded")
  let rowed = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"rowed")
  let unused = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"unused")
  run Testing.expect(
    rejectsSpan(&bounded, RejectionCode.AliasParameters, text, "T: Marker", usize.ZERO)
      && rejectsSpan(&rowed, RejectionCode.AliasParameters, text, "?R", usize.ZERO)
      && rejectsSpan(&unused, RejectionCode.AliasParameters, text, "Phantom", usize.ZERO),
    "a generic alias parameter is unbounded, a type or lifetime, and used in the target",
  )
  let elided = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"elided")
  let elidedGeneric = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"elidedGeneric")
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&elided, inspect).success
      && Shared<Result<Answer, NoRejection>>.with<AnswerView>(&elidedGeneric, inspect).success,
    "a lifetime an alias target omits is elided at each use, as written there",
  )
  let bare = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"bare")
  let extra = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"extra")
  let inferred = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"inferred")
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&bare, fn(found: &Result<Answer, NoRejection>) -> bool { return rejectionCode(found, RejectionCode.TypeArity) })
      && Shared<Result<Answer, NoRejection>>.with<bool>(&extra, fn(found: &Result<Answer, NoRejection>) -> bool { return rejectionCode(found, RejectionCode.TypeArity) })
      && !Shared<Result<Answer, NoRejection>>.with<AnswerView>(&inferred, inspect).success,
    "every generic alias argument is written at the use and none is inferred",
  )
  return ()
}

test effect fn expandsGenericAliases() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run genericAliasClaims()
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn visibilityClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("entry.silk")
  let text = """struct Hidden { field: i32 }
pub fn reveal() -> Hidden { return () }
type Clash = i32
struct Clash {}
pub type HiddenExact = typeof(reveal)
pub fn identity<T>(value: T) -> T { return move value }
fn caller() -> i32 {
  let hidden = Hidden { field: 42 }
  let copied = identity(move hidden)
  return copied.field
}
pub struct Box<T> { value: T }
impl<T> Box<T> {
  pub fn withMut<F: once fn(&mut T) -> ()>(self: &mut Self, use: F) -> () {
    use(&mut self.value)
    return ()
  }
}
fn touch(value: &mut Hidden) -> () { value.field = value.field + 1 return () }
fn privateBoundCaller() -> i32 {
  let mut boxed = Box<Hidden> { value: Hidden { field: 42 } }
  Box.withMut(&mut boxed, touch)
  return boxed.value.field
}
pub fn authoredPrivateCallback<F: once fn(&mut Hidden) -> ()>(use: F) -> () { drop use return () }
interface PrivateWitness { fn mark(self: &Self) -> () }
pub fn authoredPrivateInterface<T: PrivateWitness>(value: T) -> () { drop value return () }
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let revealed = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"reveal")
  let privateType = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &revealed,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move privateType {
    run Testing.expect(
      Shared<Rejection>.with<bool>(&value, isPrivateExposure),
      "public written signature rejects private nominal type at its use",
    )
  } else {
    run Testing.expect(false, "private type exposure has a typed rejection")
  }
  let clash = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Clash")
  let collision = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &clash,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move collision {
    run Testing.expect(
      Shared<Rejection>.with<bool>(&value, isCollision),
      "complete name bucket rejects collision without winner",
    )
  } else {
    run Testing.expect(false, "colliding name has a typed rejection")
  }
  let hiddenExact = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"HiddenExact")
  let diagnostic = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &hiddenExact,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared<Rejection>.with<bool>(&value, isPrivateExposure),
      "exact representations cannot bypass a rejected public callable signature",
    )
  } else {
    run Testing.expect(false, "exact representation has a typed rejection")
  }
  let caller = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"caller")
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&caller, inspect).success,
    "a public generic instantiated with a caller-private record does not publish that record",
  )
  let boundCaller = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"privateBoundCaller")
  let selected = run directApplicationAt(&boundCaller, usize.ZERO)
  let mut privateBound = false
  if let Option<SpecializationApplication>.Some {value: application} = move selected {
    let start = offsetOf(text, "Box.withMut(&mut boxed, touch)", usize.ZERO)
    let site = b"Box.withMut(&mut boxed, touch)"
    let signature = run Semantic.specializeSignature(&mut semantic, &mut request, &application, &entry,
      Span.make(start, start + site.length))
    privateBound = privateCallbackScope(&application)
      && Shared<Result<Answer, NoRejection>>.with<bool>(&signature, privateCallbackBound)
  }
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&boundCaller, privateCallbackBodyPresent) && privateBound,
    "a public generic member's selected callback bound retains the caller-private type in its distinct impl scope and types the source call")
  let callback = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"authoredPrivateCallback")
  let interfaceBound = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"authoredPrivateInterface")
  run Testing.expect(rejectsSpan(&callback, RejectionCode.PrivateTypeExposure, text, "once fn(&mut Hidden) -> ()", usize.ZERO)
    && rejectsSpan(&interfaceBound, RejectionCode.PrivateTypeExposure, text, "PrivateWitness", usize.ONE),
    "authored public callback and interface bounds still reject their explicit private types at the exact bound syntax")
  return ()
}

fn privateCallbackBodyPresent(answer: &Result<Answer, NoRejection>) -> bool {
  return match move checkedBody(answer) { Option<Shared<TypedBody>>.Some {..} => true _ => false }
}

fn privateCallbackScope(value: &SpecializationApplication) -> bool {
  let member = SpecializationApplication.bodyDeclaration(value)
  if !DeclarationId.named(member, b"withMut") { return false }
  let scopes = Vector<ScopeBinding>.asSlice(&value.scopes)
  if scopes.length != usize.ONE || Shared<DeclarationId>.with<bool>(&scopes[usize.ZERO].owner,
    fn(owner: &DeclarationId) -> bool { return DeclarationId.equals(owner, member) }) { return false }
  let arguments = Vector<Argument>.asSlice(&scopes[usize.ZERO].arguments)
  let ordinals = Vector<usize>.asSlice(&scopes[usize.ZERO].argumentOrdinals)
  if arguments.length != usize.ONE || ordinals.length != usize.ONE || ordinals[usize.ZERO] != usize.ZERO { return false }
  let privateScope = match &arguments[usize.ZERO] {
    Argument.Type {value: ty} => Shared<Type>.with<bool>(&ty, privateHidden) _ => false }
  let own = Vector<Argument>.asSlice(&value.arguments)
  let ownOrdinals = Vector<usize>.asSlice(&value.argumentOrdinals)
  if !privateScope || own.length != ownOrdinals.length { return false }
  let mut at = usize.ZERO
  while at < own.length {
    if ownOrdinals[at] == usize.ZERO {
      return match &own[at] { Argument.Type {..} => true _ => false }
    }
    at = at + usize.ONE
  }
  return false
}

fn privateHidden(value: &Type) -> bool {
  return match &value.* { Type.Nominal {declaration, isPublic, arguments, ..} => !isPublic
    && DeclarationId.named(&declaration, b"Hidden") && Vector<Argument>.length(&arguments) == usize.ZERO _ => false }
}

fn privateMutableHiddenReference(value: &Type) -> bool {
  return match &value.* { Type.Reference {access, referent, ..} => access == Access.Mutable
    && Shared<Type>.with<bool>(&referent, privateHidden) _ => false }
}

fn privateOnceHiddenContract(value: &Type) -> bool {
  if let Type.Callable {mode, parameters, ..} = &value.* {
    let inputs = Vector<Shared<Type>>.asSlice(&parameters)
    return mode == CallableMode.Once && inputs.length == usize.ONE
      && Shared<Type>.with<bool>(&inputs[usize.ZERO], privateMutableHiddenReference)
  }
  return false
}

fn privateCallbackBound(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let bounds = Vector<Constraint>.asSlice(&signature.constraints)
      let mut at = usize.ZERO
      while at < bounds.length {
        if let Constraint.Represents {contract, ..} = &bounds[at] {
          let found = Shared<Type>.with<bool>(&contract, privateOnceHiddenContract)
          if found { return true }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

test effect fn rejectsPrivateExposureAndCollisions() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run visibilityClaims()
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn namedCallableRepresentationsKeepExactIdentity() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("named-representations.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "fn first(value: i32) -> i32 { return value }\nfn second(value: i32) -> i32 { return value }\ntype First = typeof(first)\ntype FirstAgain = typeof(first)\ntype Second = typeof(second)\ntype Use = fn(i32) -> i32\npub type Leaked = typeof(first)\nfn generic<T>(value: T) -> T { return move value }\ntype Open = typeof(generic)\ntype Closed = typeof(generic<i32>)\nfn scoped<T>() -> typeof(generic<T>) { return () }\nservice Clock {}\nfn rowItem<?R>(value: i32) -> i32 { return value }\ntype RowOnce = typeof(rowItem<&Clock>)\ntype RowRepeated = typeof(rowItem<&Clock | &Clock>)\ntype MissingItem = typeof(absentItem)\ntype InvalidItem = typeof(Use)\nfn repeated() {}\nfn repeated(value: i32) {}\ntype AmbiguousItem = typeof(repeated)\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let first = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"First")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let again = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"FirstAgain")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Second")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let useContract = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Use")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let closed = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Closed")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let scoped = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"scoped")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let open = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Open")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let leaked = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Leaked")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let rowOnce = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"RowOnce")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let rowRepeated = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"RowRepeated")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let missingItem = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"MissingItem")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidItem = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"InvalidItem")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let ambiguousItem = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"AmbiguousItem")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&missingItem, RejectionCode.UnresolvedExactRepresentation, text, "typeof(absentItem)", usize.ZERO)
      && rejectsSpan(&invalidItem, RejectionCode.InvalidExactRepresentation, text, "typeof(Use)", usize.ZERO)
      && rejectsSpan(&ambiguousItem, RejectionCode.AmbiguousExactRepresentation, text, "typeof(repeated)", usize.ZERO),
    "typeof distinguishes absent, non-callable, and ambiguous item identities at the written type",
  )
  let firstType = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &first,
    nominalResult,
  )
  let againType = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &again,
    nominalResult,
  )
  let secondType = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &second,
    nominalResult,
  )
  let useType = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &useContract,
    nominalResult,
  )
  if let Option<Shared<Type>>.Some {value: firstValue} = move firstType {
    if let Option<Shared<Type>>.Some {value: againValue} = move againType {
      if let Option<Shared<Type>>.Some {value: secondValue} = move secondType {
        let repeated = run Type.equalsShared(&firstValue, &againValue)
          |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
        let distinct = run Type.equalsShared(&firstValue, &secondValue)
          |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
        let mut separateUse = false
        if let Option<Shared<Type>>.Some {value: callableUse} = move useType {
          let sameUse = run Type.equalsShared(&firstValue, &callableUse)
            |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
          separateUse = !sameUse
        }
        run Testing.expect(Shared<Type>.with<bool>(&firstValue, StaticValue.intrinsicallyForbidden),
          "canonical named callable values remain forbidden as source static data")
        run Testing.expect(
          repeated && !distinct && separateUse,
          "named items retain distinct exact identities despite identical callable signatures",
        )
      } else {
        run Testing.expect(false, "second item has an exact representation")
      }
    } else {
      run Testing.expect(false, "repeated item has an exact representation")
    }
  } else {
    run Testing.expect(false, "first item has an exact representation")
  }
  let normalizedRows = run typesEqual(
    Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&rowOnce, nominalResult),
    Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
      &rowRepeated,
      nominalResult,
    ),
  )
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    normalizedRows && Shared<Result<Answer, NoRejection>>.with<AnswerView>(&closed, inspect).success
      && rejectsSpan(&scoped, RejectionCode.OpenExactRepresentation,
        text,
        "typeof(generic<T>)", usize.ZERO) && Shared<
      Result<Answer, NoRejection>,
    >.with<
      bool,
    >(
      &open,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.OpenExactRepresentation)
      },
    ) && Shared<Result<Answer, NoRejection>>.with<bool>(
      &leaked,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.PrivateExactRepresentationLeak)
      },
    ),
    "typeof normalizes row arguments, requires full specialization, and keeps private item identity inside its module",
  )
  return ()
}

test effect fn opaqueResultContractsKeepProducerFamiliesDistinct() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("opaque-results.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(
    "fn make() -> some<F: fn<'static>(i32) -> i32> F { return () }\nfn other() -> some<F: fn<'static>(i32) -> i32> F { return () }\nfn nested() -> some<F: fn<'static>(i32) -> i32> Effect<'static; F> { return () }\nfn unused() -> some<F: fn<'static>(i32) -> i32> i32 { return 0 }\ninterface Maker { fn absent() -> some<F: fn<'static>(i32) -> i32> F }\nstruct Hidden {}\npub fn leak() -> some<F: fn<'static>(Hidden) -> i32> F { return () }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let made = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"make")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let other = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"other")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nested = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"nested")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unused = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"unused")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let bodyless = run Semantic.demandOperation(&mut semantic, &mut request, &entry, b"Maker", b"absent")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let leak = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"leak")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let firstType = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &made,
    signatureResult,
  )
  let otherType = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &other,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value: firstResult} = move firstType {
    if let Option<Shared<Type>>.Some {value: otherResult} = move otherType {
      let exact = Shared<Type>.with<bool>(
        &firstResult,
        fn(ty: &Type) -> bool {
          return match & ty.* {
            Type.OpaqueRepresentation {..} => true
            _ => false
          }
        },
      )
      let sameFamily = run Type.equalsShared(&firstResult, &otherResult)
        |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
      run Testing.expect(exact && !sameFamily, "each opaque producer owns a distinct representation")
    } else {
      run Testing.expect(false, "other producer has an opaque result contract")
    }
  } else {
    run Testing.expect(false, "first producer has an opaque result contract")
  }
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&nested, inspect).success && Shared<
      Result<Answer, NoRejection>,
    >.with<
      bool,
    >(
      &unused,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.InvalidOpaqueResult)
      },
    ) && Shared<Result<Answer, NoRejection>>.with<bool>(
      &bodyless,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.BodylessOpaqueResult)
      },
    ),
    "an opaque binder may appear inside the result, but cannot be unused or bodyless",
  )
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(
      &leak,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.PrivateTypeExposure)
      },
    ),
    "an opaque result cannot hide a private type in its public use contract",
  )
  return ()
}

// Hidden representation inputs and retained outer owners are part of the opaque family key.
test effect fn opaqueProducerApplicationsRetainCompleteHeaderEvidence() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run opaqueApplicationClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn opaqueApplicationClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("opaque-applications.silk")
  let text = """
fn positive(value: i32) -> i32 { return value + 1 }
fn negative(value: i32) -> i32 { return value - 1 }
type Positive = typeof(positive)
type Negative = typeof(negative)
fn keep(callback: fn<'static>(i32) -> i32) -> some<F: fn<'static>(i32) -> i32> F { return positive }
fn phantom<'a>() -> some<F: fn<'static>(i32) -> i32> F { return positive }
struct Box<T> { value: T }
impl<T> Box<T> {
  fn wrap(callback: fn<'static>(T) -> T) -> some<F: fn<'static>(T) -> T> F { return fn(value: T) -> T { return move value } }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let keep = run Semantic.demandSignature(&mut store, &mut request, &id, b"keep")
  let phantom = run Semantic.demandSignature(&mut store, &mut request, &id, b"phantom")
  let scoped = run Semantic.demandInherentMember(&mut store, &mut request, &id, b"Box", b"wrap")
  let positive = run Semantic.demandAlias(&mut store, &mut request, &id, b"Positive")
  let negative = run Semantic.demandAlias(&mut store, &mut request, &id, b"Negative")
  let family = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&keep, signatureResult)
  let first = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&positive, nominalResult)
  let second = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&negative, nominalResult)
  if let Option<Shared<Type>>.Some {value: source} = move family {
    if let Option<Shared<Type>>.Some {value: increment} = move first {
      if let Option<Shared<Type>>.Some {value: decrement} = move second {
        let firstFamily = run bindOpaqueArgument(&source, Argument.Type {value: move increment})
        let secondFamily = run bindOpaqueArgument(&source, Argument.Type {value: move decrement})
        let copy = run Types.intern(run Type.copy(&firstFamily))
        let copied = run Type.equalsShared(&copy, &firstFamily)
        let sameFamily = run Type.equalsShared(&firstFamily, &secondFamily)
        let distinctRuntime = run opaqueRuntimeDiffers(&firstFamily, &secondFamily)
        run Testing.expect(copied && !sameFamily && distinctRuntime,
          "opaque hidden representations distinguish equal-contract targets in semantic and runtime identity")
        run Testing.expect(run opaqueFormalOwnSlot(&source), "binding copies preserve the producer's symbolic hidden slot")
      } else { run Testing.expect(false, "the second exact target is available") }
    } else { run Testing.expect(false, "the first exact target is available") }
  } else { run Testing.expect(false, "the producer publishes its opaque family") }
  let lifetimeFamily = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&phantom, signatureResult)
  if let Option<Shared<Type>>.Some {value: source} = move lifetimeFamily {
    let app = match move Type.opaqueApplication(&source) {
      Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
      _ => { run Testing.expect(false, "the phantom lifetime retains an application") return () }
    }
    let local = run Shared<Lifetime>.make(Lifetime.Local {
      declaration: DeclarationId.copy(SpecializationApplication.bodyDeclaration(&app)), ordinal: 7})
    let fixed = run bindOpaqueArgument(&source, Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Static)})
    let borrowed = run bindOpaqueArgument(&source, Argument.Lifetime {value: move local})
    let sameFamily = run Type.equalsShared(&fixed, &borrowed)
    let distinctRuntime = run opaqueRuntimeDiffers(&fixed, &borrowed)
    run Testing.expect(!sameFamily && !distinctRuntime,
      "selected lifetimes distinguish semantic families while the runtime projection erases only validity")
  } else { run Testing.expect(false, "the unused written lifetime retains its producer schema") }
  let scopedFamily = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&scoped, signatureResult)
  if let Option<Shared<Type>>.Some {value: source} = move scopedFamily {
    run Testing.expect(run opaqueScopedSlots(&source),
      "the hidden own representation and retained impl T keep independent original owner slots")
  } else { run Testing.expect(false, "the inherent producer publishes its scoped family") }
}

effect fn opaqueRuntimeDiffers(first: &Shared<Type>, second: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let app = match move Type.opaqueApplication(first) {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  let owner = SpecializationApplication.bodyDeclaration(&app)
  let one = run Type.runtimeEncoding(first, owner)
  let two = run Type.runtimeEncoding(second, owner)
  return !sameBytes(Bytes.asSlice(&one), Bytes.asSlice(&two))
}

effect fn bindOpaqueArgument(source: &Shared<Type>, value: Argument) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let app = match move Type.opaqueApplication(source) {
    Option<Shared<SpecializationApplication>>.Some {value: selected} => run SpecializationApplication.copyShared(&selected)
    _ => { return Shared<Type>.clone(source) }
  }
  let indices = Vector<usize>.asSlice(&app.argumentOrdinals)
  if indices.length != usize.ONE { return Shared<Type>.clone(source) }
  let mut bindings = Vector<Binding>.make()
  run Vector<Binding>.append(&mut bindings, Binding {
    declaration: run Shared<DeclarationId>.make(DeclarationId.copy(SpecializationApplication.bodyDeclaration(&app))),
    ordinal: indices[usize.ZERO], value: move value})
  return run Type.applyBindings(source, Vector<Binding>.asSlice(&bindings), true)
}

effect fn opaqueFormalOwnSlot(source: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let app = match move Type.opaqueApplication(source) {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  let values = Vector<Argument>.asSlice(&app.arguments)
  let ordinals = Vector<usize>.asSlice(&app.argumentOrdinals)
  if values.length != usize.ONE || ordinals.length != usize.ONE || ordinals[usize.ZERO] != usize.ZERO { return false }
  if let Argument.Type {value} = &values[usize.ZERO] {
    return Shared<Type>.with<usize>(&value, fn(ty: &Type) -> usize {
      return Type.parameterOrdinalOf(ty, SpecializationApplication.bodyDeclaration(&app))
    }) == usize.ZERO
  }
  return false
}

effect fn opaqueScopedSlots(source: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator {
  if !run opaqueFormalOwnSlot(source) { return false }
  let app = match move Type.opaqueApplication(source) {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  let scopes = Vector<ScopeBinding>.asSlice(&app.scopes)
  if scopes.length != usize.ONE { return false }
  let scopeOwner = DeclarationId.copyShared(&scopes[usize.ZERO].owner)
  let values = Vector<Argument>.asSlice(&scopes[usize.ZERO].arguments)
  let ordinals = Vector<usize>.asSlice(&scopes[usize.ZERO].argumentOrdinals)
  if values.length != usize.ONE || ordinals.length != usize.ONE || ordinals[usize.ZERO] != usize.ZERO
    || DeclarationId.equals(&scopeOwner, SpecializationApplication.bodyDeclaration(&app)) { return false }
  if let Argument.Type {value} = &values[usize.ZERO] {
    return Shared<Type>.with<usize>(&value, fn(ty: &Type) -> usize {
      return Type.parameterOrdinalOf(ty, &scopeOwner)
    }) == usize.ZERO
  }
  return false
}

effect fn importCycleClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("entry.silk")
  let firstModule = run module("first.silk")
  let secondModule = run module("second.silk")
  let firstSource = run present("pub import second { Alias }\n")
  let first = run Revision.publish(&Revision.make(), &firstModule, &firstSource)
  let secondSource = run present("pub import first { Alias }\n")
  let second = run Revision.publish(&first, &secondModule, &secondSource)
  let entrySource = run present("import first { Alias }\nfn entry() -> Alias { return () }\n")
  let entered = run Revision.publish(&second, &entry, &entrySource)
  let otherModule = run module("other.silk")
  let otherSource = run present("import second { Alias }\nfn other() -> Alias { return () }\n")
  let revision = run Revision.publish(&entered, &otherModule, &otherSource)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let signature = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let diagnostic = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &signature,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared<Rejection>.with<bool>(&value, isCycle),
      "public import-name cycle has a typed code",
    )
    run Testing.expect(
      Shared<Rejection>.with<usize>(&value, cyclePathLength) == 3,
      "public import-name cycle has a declaration path",
    )
    run Testing.expect(
      Shared<Rejection>.with<bool>(&value, importCycleAnchor),
      "public import-name cycle is anchored",
    )
  } else {
    run Testing.expect(false, "public import-name cycle has a typed rejection")
  }
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &firstModule) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &secondModule,
    ) == 1,
    "import-name cycle opens each target once",
  )
  let other = run Semantic.demandSignature(&mut semantic, &mut request, &otherModule, b"other")
  let mut reversed = makeSemantic(move revision)
  let mut reversedRequest = Request.make()
  let reversedOther = run Semantic.demandSignature(
    &mut reversed,
    &mut reversedRequest,
    &otherModule,
    b"other",
  )
  let reversedEntry = run Semantic.demandSignature(
    &mut reversed,
    &mut reversedRequest,
    &entry,
    b"entry",
  )
  run Testing.expect(
    rotatedPair(&signature, &other) && sameCycleAnswers(&signature, &reversedEntry) && sameCycleAnswers(
      &other,
      &reversedOther,
    ),
    "consumers entering an import-name cycle at either member agree in either demand order",
  )
  return ()
}

test effect fn rejectsPublicImportNameCycle() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run importCycleClaims()
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn revisionReuseClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("entry.silk")
  let library = run module("library.silk")
  let unrelated = run module("unrelated.silk")
  let a = run present("import library { Alias }\nfn entry() -> Alias { return () }\n")
  let b = run present("pub type Alias = i32\n")
  let first = run Revision.publish(&Revision.make(), &entry, &a)
  let held = run Revision.publish(&first, &library, &b)
  let mut semantic = makeSemantic(run Revision.copy(&held))
  let mut coldRequest = Request.make()
  let cold = run Semantic.demandSignature(&mut semantic, &mut coldRequest, &entry, b"entry")
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&cold, inspect).success && Semantic.requestDiscovered(
      &mut semantic, &coldRequest,
      &library,
    ),
    "cold signature discovers its imported alias source",
  )
  let startsBefore = starts(Semantic.eventLog(&semantic), Family.Signature)
  let c = run present("fn changed() -> i32 { return 3 }\n")
  let irrelevant = run Revision.publish(&held, &unrelated, &c)
  run Semantic.update(&mut semantic, run Revision.copy(&irrelevant))
  let mut fresh = Request.make()
  let warm = run Semantic.demandSignature(&mut semantic, &mut fresh, &entry, b"entry")
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&warm, inspect).success && Semantic.requestDiscovered(
      &mut semantic, &fresh,
      &library,
    ) && !Semantic.requestDiscovered(&mut semantic, &fresh, &unrelated) && starts(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == startsBefore && hits(Semantic.eventLog(&semantic), Family.Signature) == 1,
    "unrelated revision keeps the completed signature and replays only its discoveries",
  )
  let mut freshIrrelevant = makeSemantic(move irrelevant)
  let mut freshIrrelevantRequest = Request.make()
  let freshWarm = run Semantic.demandSignature(&mut freshIrrelevant, &mut freshIrrelevantRequest, &entry, b"entry")
  run Testing.expect(agreesWithFresh(&warm, &freshWarm), "the signature after an unrelated edit agrees with a fresh store of the same revision")
  let changed = run present("pub type Alias = bool\n")
  let relevant = run Revision.publish(&held, &library, &changed)
  run Semantic.update(&mut semantic, run Revision.copy(&relevant))
  let mut revised = Request.make()
  let updated = run Semantic.demandSignature(&mut semantic, &mut revised, &entry, b"entry")
  let result = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &updated,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    run Testing.expect(
      Shared<Type>.with<bool>(&value, isBool) && starts(
        Semantic.eventLog(&semantic),
        Family.Signature,
      ) == startsBefore + 1,
      "changed imported alias header recomputes the transitive signature",
    )
  } else {
    run Testing.expect(false, "recomputed signature has a written result")
  }
  let mut freshRelevant = makeSemantic(move relevant)
  let mut freshRelevantRequest = Request.make()
  let freshUpdated = run Semantic.demandSignature(&mut freshRelevant, &mut freshRelevantRequest, &entry, b"entry")
  run Testing.expect(agreesWithFresh(&updated, &freshUpdated), "the recomputed signature agrees with a fresh store of the same revision")
  return ()
}

test effect fn reusesUnrelatedRevisionAndInvalidatesImportedHeader() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run revisionReuseClaims()
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn firstNameStartKey(events: &[Event]) -> usize {
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.Start && events[at].family == Family.Name {
      return events[at].key
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn startsForKey(events: &[Event], key: usize) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.Start && events[at].key == key {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

effect fn selectionIndex(id: &ModuleId, text: string) -> ModuleIndex
! OutOfMemoryError ? &mut Allocator {
  let source = run SourceUnit.parse(id, usize.ONE, run Bytes.copy(String.utf8Bytes(text)))
  return run ModuleIndex.build(&source, true)
}

fn declarationNamed(index: &ModuleIndex, name: &[u8]) -> usize {
  let declarations = ModuleIndex.listDeclarations(index)
  let mut at = usize.ZERO
  while at < declarations.length {
    if DeclarationId.named(&declarations[at].identity, name) { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

// Two identical selected aliases initially select one binding. Retargeting one member keeps its
// import owner path, member ordinal, alias, and written Bar bucket but changes selection.
effect fn identicalImportAliasRevisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("entry.silk")
  let a = run module("a.silk")
  let firstText = "import a { Foo as Bar }\nimport a { Foo as Bar }\nfn use(value: Bar) -> i32 { return 0 }\n"
  let changedText = "import a { Foo as Bar }\nimport a { Other as Bar }\nfn use(value: Bar) -> i32 { return 0 }\n"
  let firstIndex = run selectionIndex(&entry, firstText)
  let changedIndex = run selectionIndex(&entry, changedText)
  run Testing.expect(ModuleIndex.matchesName(&firstIndex, &changedIndex, b"Bar")
    && ModuleIndex.matchesIdentity(&firstIndex, usize.ZERO, &changedIndex, usize.ZERO)
    && ModuleIndex.matchesIdentity(&firstIndex, usize.ONE, &changedIndex, usize.ONE),
    "retargeting one selected member keeps both import handles and Bar's written bucket equal")
  let item = run present("pub struct Foo {}\npub struct Other {}\n")
  let withA = run Revision.publish(&Revision.make(), &a, &item)
  let firstSource = run present(firstText)
  let first = run Revision.publish(&withA, &entry, &firstSource)
  let mut warm = makeSemantic(run Revision.copy(&first))
  let mut initialRequest = Request.make()
  let initial = run Semantic.demandSignature(&mut warm, &mut initialRequest, &entry, b"use")
  run Testing.expect(succeeded(&initial), "identical imports select one namespace binding")

  let changedSource = run present(changedText)
  let changed = run Revision.publish(&first, &entry, &changedSource)
  run Semantic.update(&mut warm, run Revision.copy(&changed))
  let mut changedRequest = Request.make()
  let collision = run Semantic.demandSignature(&mut warm, &mut changedRequest, &entry, b"use")
  let mut freshChanged = makeSemantic(run Revision.copy(&changed))
  let mut freshChangedRequest = Request.make()
  let expected = run Semantic.demandSignature(&mut freshChanged, &mut freshChangedRequest, &entry, b"use")
  run Testing.expect(rejectsSpan(&collision, RejectionCode.Collision, changedText, "Bar", 2)
    && agreesWithFresh(&collision, &expected),
    "retargeted alias rejects at the use with the same code and span as fresh selection")

  let restored = run Revision.publish(&changed, &entry, &firstSource)
  run Semantic.update(&mut warm, run Revision.copy(&restored))
  let mut restoredRequest = Request.make()
  let again = run Semantic.demandSignature(&mut warm, &mut restoredRequest, &entry, b"use")
  let mut freshRestored = makeSemantic(move restored)
  let mut freshRestoredRequest = Request.make()
  let freshAgain = run Semantic.demandSignature(&mut freshRestored, &mut freshRestoredRequest, &entry, b"use")
  run Testing.expect(succeeded(&again) && agreesWithFresh(&again, &freshAgain)
    && run answersEqual(&again, &freshAgain, usize.ZERO),
    "restoring the identical aliases restores the current selected type")
  return ()
}

test effect fn selectionGuardRetargetedDuplicateImportAlias() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run identicalImportAliasRevisionClaims()
    |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

// An unrelated selected import changes the same-key count of imports from one path. The old import
// handle ends even though the written Bar candidate has not changed.
effect fn samePathImportRevisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("entry.silk")
  let a = run module("a.silk")
  let firstText = "import a { Foo as Bar }\nfn use(value: Bar) -> i32 { return 0 }\n"
  let addedText = "import a { Foo as Bar }\nimport a { Other }\nfn use(value: Bar) -> i32 { return 0 }\n"
  let firstIndex = run selectionIndex(&entry, firstText)
  let addedIndex = run selectionIndex(&entry, addedText)
  run Testing.expect(ModuleIndex.matchesName(&firstIndex, &addedIndex, b"Bar")
    && !ModuleIndex.matchesIdentity(&firstIndex, usize.ZERO, &addedIndex, usize.ZERO),
    "adding another same-path import keeps Bar's bucket but retires the first import identity")
  let aSource = run present("pub struct Foo {}\npub struct Other {}\n")
  let withA = run Revision.publish(&Revision.make(), &a, &aSource)
  let firstSource = run present(firstText)
  let first = run Revision.publish(&withA, &entry, &firstSource)
  let mut warm = makeSemantic(run Revision.copy(&first))
  let mut firstRequest = Request.make()
  let original = run Semantic.demandSignature(&mut warm, &mut firstRequest, &entry, b"use")
  run Testing.expect(succeeded(&original), "the first selected import names Bar")

  let addedSource = run present(addedText)
  let added = run Revision.publish(&first, &entry, &addedSource)
  run Semantic.update(&mut warm, run Revision.copy(&added))
  let mut revisedRequest = Request.make()
  let revised = run Semantic.demandSignature(&mut warm, &mut revisedRequest, &entry, b"use")
  let mut fresh = makeSemantic(move added)
  let mut freshRequest = Request.make()
  let expected = run Semantic.demandSignature(&mut fresh, &mut freshRequest, &entry, b"use")
  run Testing.expect(succeeded(&revised) && agreesWithFresh(&revised, &expected)
    && run answersEqual(&revised, &expected, usize.ZERO),
    "the retired same-path import handle resolves Bar through the current source")
  return ()
}

test effect fn selectionGuardUnrelatedImportRetiresOwner() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run samePathImportRevisionClaims()
    |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

// A later conditional changes the anonymous owner sibling count while the Foo bucket stays
// written exactly as before. Editing Foo's governing condition then changes its availability.
effect fn staticOwnerRevisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("entry.silk")
  let firstText = "static if true { pub struct Foo {} }\nfn use(value: Foo) -> i32 { return 0 }\n"
  let addedText = "static if true { pub struct Foo {} }\nstatic if false { pub struct Other {} }\nfn use(value: Foo) -> i32 { return 0 }\n"
  let changedText = "static if false { pub struct Foo {} }\nstatic if false { pub struct Other {} }\nfn use(value: Foo) -> i32 { return 0 }\n"
  let firstIndex = run selectionIndex(&entry, firstText)
  let addedIndex = run selectionIndex(&entry, addedText)
  let changedIndex = run selectionIndex(&entry, changedText)
  let firstFoo = declarationNamed(&firstIndex, b"Foo")
  let addedFoo = declarationNamed(&addedIndex, b"Foo")
  run Testing.expect(firstFoo != usize.MAX && addedFoo != usize.MAX
    && ModuleIndex.matchesName(&firstIndex, &addedIndex, b"Foo")
    && ModuleIndex.matchesIdentity(&firstIndex, firstFoo, &addedIndex, addedFoo)
    && !ModuleIndex.matchesIdentity(&firstIndex, usize.ZERO, &addedIndex, usize.ZERO)
    && ModuleIndex.matchesName(&addedIndex, &changedIndex, b"Foo"),
    "Foo's written bucket survives a new conditional and a governing condition edit")
  let firstSource = run present(firstText)
  let first = run Revision.publish(&Revision.make(), &entry, &firstSource)
  let mut warm = makeSemantic(run Revision.copy(&first))
  let mut firstRequest = Request.make()
  let original = run Semantic.demandSignature(&mut warm, &mut firstRequest, &entry, b"use")
  run Testing.expect(succeeded(&original), "selected Foo is available before revision")

  let addedSource = run present(addedText)
  let added = run Revision.publish(&first, &entry, &addedSource)
  run Semantic.update(&mut warm, run Revision.copy(&added))
  let mut addedRequest = Request.make()
  let retained = run Semantic.demandSignature(&mut warm, &mut addedRequest, &entry, b"use")
  let mut freshAdded = makeSemantic(run Revision.copy(&added))
  let mut freshAddedRequest = Request.make()
  let freshRetained = run Semantic.demandSignature(&mut freshAdded, &mut freshAddedRequest, &entry, b"use")
  run Testing.expect(succeeded(&retained) && agreesWithFresh(&retained, &freshRetained)
    && run answersEqual(&retained, &freshRetained, usize.ZERO),
    "ancestor sibling-count change still selects Foo from the current declaration")

  let changedSource = run present(changedText)
  let changed = run Revision.publish(&added, &entry, &changedSource)
  run Semantic.update(&mut warm, run Revision.copy(&changed))
  let mut changedRequest = Request.make()
  let hidden = run Semantic.demandSignature(&mut warm, &mut changedRequest, &entry, b"use")
  let mut freshChanged = makeSemantic(move changed)
  let mut freshChangedRequest = Request.make()
  let expected = run Semantic.demandSignature(&mut freshChanged, &mut freshChangedRequest, &entry, b"use")
  run Testing.expect(rejectsSpan(&hidden, RejectionCode.UnknownType, changedText, "Foo", usize.ONE)
    && agreesWithFresh(&hidden, &expected),
    "changed governing condition removes Foo with the current exact diagnostic")
  return ()
}

test effect fn selectionGuardStaticOwnerAndConditionEdits() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run staticOwnerRevisionClaims()
    |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

// A callable body is outside its prototype. The completed signature stays cached across an
// authored body edit, while the answer remains identical to a fresh store at the new revision.
effect fn syntaxReaderBodyCutoffClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("syntax-reader-body.silk")
  let first = run present("fn chosen(value: i32) -> i32 { return 1 }\n")
  let initial = run Revision.publish(&Revision.make(), &entry, &first)
  let mut warm = makeSemantic(run Revision.copy(&initial))
  let mut request = Request.make()
  let original = run Semantic.demandSignature(&mut warm, &mut request, &entry, b"chosen")
  run Testing.expect(succeeded(&original), "the initial callable signature is checked")
  let before = starts(Semantic.eventLog(&warm), Family.Signature)

  let changed = run present("fn chosen(value: i32) -> i32 { return 2 }\n")
  let revised = run Revision.publish(&initial, &entry, &changed)
  run Semantic.update(&mut warm, run Revision.copy(&revised))
  let mut warmRequest = Request.make()
  let held = run Semantic.demandSignature(&mut warm, &mut warmRequest, &entry, b"chosen")
  let mut fresh = makeSemantic(move revised)
  let mut freshRequest = Request.make()
  let expected = run Semantic.demandSignature(&mut fresh, &mut freshRequest, &entry, b"chosen")
  run Testing.expect(succeeded(&held) && agreesWithFresh(&held, &expected)
    && starts(Semantic.eventLog(&warm), Family.Signature) == before,
    "a body-only edit reuses the signature provider and agrees with fresh analysis")
  return ()
}

test effect fn syntaxReaderBodyEditKeepsCleanSignature() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run syntaxReaderBodyCutoffClaims()
    |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn rawPrototypeMatches(first: &ModuleIndex, old: usize, second: &ModuleIndex, revised: usize) -> bool {
  let before = ModuleIndex.listDeclarations(first)
  let after = ModuleIndex.listDeclarations(second)
  if old >= before.length || revised >= after.length { return false }
  if let Option<Fingerprints>.Some {value: left} = &before[old].fingerprints {
    if let Option<Fingerprints>.Some {value: right} = &after[revised].fingerprints {
      return ContentHash.equals(left.prototype, right.prototype)
    }
  }
  return false
}

// Moving an unconditional declaration into a new inactive arm leaves its written prototype
// unchanged. The old selection has no governing Condition dependency, so its name input must
// notice that the declaration acquired a conditional owner.
effect fn staticArmMoveRevisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("static-arm-move.silk")
  let firstText = "fn target() -> i32 { return 1 }\nfn use() -> i32 { return target() }\n"
  let movedText = "static if false { fn target() -> i32 { return 1 } }\nfn use() -> i32 { return target() }\n"
  let firstIndex = run selectionIndex(&entry, firstText)
  let movedIndex = run selectionIndex(&entry, movedText)
  let oldTarget = declarationNamed(&firstIndex, b"target")
  let movedTarget = declarationNamed(&movedIndex, b"target")
  run Testing.expect(oldTarget != usize.MAX && movedTarget != usize.MAX
    && !ModuleIndex.matchesIdentity(&firstIndex, oldTarget, &movedIndex, movedTarget),
    "a newly conditional declaration gains a distinct owner identity")
  run Testing.expect(rawPrototypeMatches(&firstIndex, oldTarget, &movedIndex, movedTarget),
    "wrapping the declaration leaves its written prototype equal")
  run Testing.expect(!ModuleIndex.matchesName(&firstIndex, &movedIndex, b"target")
    && !ModuleIndex.matchesPrototype(&firstIndex, oldTarget, &movedIndex, movedTarget),
    "new conditional ownership changes name and declaration inputs")
  let firstSource = run present(firstText)
  let first = run Revision.publish(&Revision.make(), &entry, &firstSource)
  let mut warm = makeSemantic(run Revision.copy(&first))
  let mut firstRequest = Request.make()
  let selected = run Semantic.demandBody(&mut warm, &mut firstRequest, &entry, b"use")
  run Testing.expect(succeeded(&selected), "the selected arm's target is callable")
  let bodyStarts = starts(Semantic.eventLog(&warm), Family.Body)
  let movedSource = run present(movedText)
  let revised = run Revision.publish(&first, &entry, &movedSource)
  run Semantic.update(&mut warm, run Revision.copy(&revised))
  let mut revisedRequest = Request.make()
  let hidden = run Semantic.demandBody(&mut warm, &mut revisedRequest, &entry, b"use")
  let mut fresh = makeSemantic(move revised)
  let mut freshRequest = Request.make()
  let expected = run Semantic.demandBody(&mut fresh, &mut freshRequest, &entry, b"use")
  run Testing.expect(rejectsSpan(&hidden, RejectionCode.UnknownFunction, movedText, "target", usize.ONE)
    && agreesWithFresh(&hidden, &expected)
    && starts(Semantic.eventLog(&warm), Family.Body) > bodyStarts,
    "moving target into a new inactive arm invalidates the warm selected body at its current call")
  return ()
}

