effect fn negativeRevisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("entry.silk")
  let library = run module("library.silk")
  let a = run present("import library { Alias }\nfn entry() -> Alias { return () }\n")
  let held = run Revision.publish(&Revision.make(), &entry, &a)
  let mut semantic = makeSemantic(run Revision.copy(&held))
  let mut firstRequest = Request.make()
  let missing = run Semantic.demandSignature(&mut semantic, &mut firstRequest, &entry, b"entry")
  let diagnostic = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &missing,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared<Rejection>.with<bool>(&value, isMissingModule) && !Semantic.requestDiscovered(
        &mut semantic, &firstRequest,
        &library,
      ),
      "absent imported path records a typed rejection without a present discovery",
    )
  } else {
    run Testing.expect(false, "absent imported path rejects")
  }
  let b = run present("pub type Other = i32\n")
  let appeared = run Revision.publish(&held, &library, &b)
  run Semantic.update(&mut semantic, run Revision.copy(&appeared))
  let mut secondRequest = Request.make()
  let missingName = run Semantic.demandSignature(
    &mut semantic,
    &mut secondRequest,
    &entry,
    b"entry",
  )
  let nameDiagnostic = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &missingName,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move nameDiagnostic {
    run Testing.expect(
      Shared<Rejection>.with<bool>(&value, isUnknownImportedMember) && Semantic.requestDiscovered(
        &mut semantic, &secondRequest,
        &library,
      ),
      "formerly absent path is discovered and its absent-name bucket rejects",
    )
  } else {
    run Testing.expect(false, "present imported module with absent name rejects")
  }
  let mut freshAppeared = makeSemantic(move appeared)
  let mut freshAppearedRequest = Request.make()
  let freshMissingName = run Semantic.demandSignature(&mut freshAppeared, &mut freshAppearedRequest, &entry, b"entry")
  run Testing.expect(agreesWithFresh(&missingName, &freshMissingName), "the absent-name signature agrees with a fresh store of the same revision")
  let named = run present("pub type Other = i32\npub type Alias = bool\n")
  let namedRevision = run Revision.publish(&held, &library, &named)
  run Semantic.update(&mut semantic, run Revision.copy(&namedRevision))
  let mut namedRequest = Request.make()
  let resolved = run Semantic.demandSignature(&mut semantic, &mut namedRequest, &entry, b"entry")
  let result = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &resolved,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    run Testing.expect(
      Shared<Type>.with<bool>(&value, isBool) && Semantic.requestDiscovered(&mut semantic, &namedRequest, &library),
      "new imported name invalidates the transitive negative bucket",
    )
  } else {
    run Testing.expect(false, "new imported name resolves")
  }
  let mut freshNamed = makeSemantic(move namedRevision)
  let mut freshNamedRequest = Request.make()
  let freshResolved = run Semantic.demandSignature(&mut freshNamed, &mut freshNamedRequest, &entry, b"entry")
  run Testing.expect(agreesWithFresh(&resolved, &freshResolved), "the newly named signature agrees with a fresh store of the same revision")
  let shifted = run present(
    "// prefix\nimport library { Alias }\nfn entry() -> Alias { return () }\n",
  )
  let absentAgain = run Revision.publish(&held, &entry, &shifted)
  run Semantic.update(&mut semantic, run Revision.copy(&absentAgain))
  let mut shiftedRequest = Request.make()
  let newFailure = run Semantic.demandSignature(
    &mut semantic,
    &mut shiftedRequest,
    &entry,
    b"entry",
  )
  let anchored = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &newFailure,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move anchored {
    let offset = Shared<Rejection>.with<usize>(&value, spanStart)
    run Testing.expect(
      Shared<Rejection>.with<bool>(&value, isMissingModule) && offset == 17 && String.utf8Bytes(
        "// prefix\nimport library { Alias }\nfn entry() -> Alias { return () }\n",
      )[offset] == 108,
      "recomputed rejection span points into exact changed entry bytes",
    )
  } else {
    run Testing.expect(false, "changed entry bytes produce a new anchored rejection")
  }
  let mut freshShifted = makeSemantic(move absentAgain)
  let mut freshShiftedRequest = Request.make()
  let freshNewFailure = run Semantic.demandSignature(&mut freshShifted, &mut freshShiftedRequest, &entry, b"entry")
  run Testing.expect(agreesWithFresh(&newFailure, &freshNewFailure), "the reanchored rejection agrees with a fresh store of the same revision")
  return ()
}

