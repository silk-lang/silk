! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run staticArmMoveRevisionClaims()
    |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

// An operation's own contract is unchanged, but public exposure comes from its interface header.
effect fn syntaxReaderParentPrototypeClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("syntax-reader-parent.silk")
  let firstText = "struct Private {}\ninterface Gate { fn accept(value: Private) -> i32 }\n"
  let changedText = "struct Private {}\npub interface Gate { fn accept(value: Private) -> i32 }\n"
  let first = run present(firstText)
  let initial = run Revision.publish(&Revision.make(), &entry, &first)
  let mut warm = makeSemantic(run Revision.copy(&initial))
  let mut request = Request.make()
  let original = run Semantic.demandOperation(&mut warm, &mut request, &entry, b"Gate", b"accept")
  run Testing.expect(succeeded(&original), "private interface operation may name a private type")
  let before = starts(Semantic.eventLog(&warm), Family.Signature)

  let changed = run present(changedText)
  let revised = run Revision.publish(&initial, &entry, &changed)
  run Semantic.update(&mut warm, run Revision.copy(&revised))
  let mut warmRequest = Request.make()
  let exposed = run Semantic.demandOperation(&mut warm, &mut warmRequest, &entry, b"Gate", b"accept")
  let mut fresh = makeSemantic(move revised)
  let mut freshRequest = Request.make()
  let expected = run Semantic.demandOperation(&mut fresh, &mut freshRequest, &entry, b"Gate", b"accept")
  run Testing.expect(rejectsSpan(&exposed, RejectionCode.PrivateTypeExposure, changedText, "Private", usize.ONE)
    && agreesWithFresh(&exposed, &expected)
    && starts(Semantic.eventLog(&warm), Family.Signature) > before,
    "the parent visibility edit recomputes the operation and its exact exposure rejection")
  return ()
}

