// A variadic foreign import's written contract stays fixed, while adding a body changes whether
// the C boundary is admitted. This is a whole-declaration read of the foreign header classifier.
effect fn syntaxReaderForeignBodyClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("syntax-reader-foreign.silk")
  let firstText = "unsafe extern \"C\" fn receive(tag: i32, ...) -> i32\n"
  let changedText = "unsafe extern \"C\" fn receive(tag: i32, ...) -> i32 { return tag }\n"
  let first = run present(firstText)
  let initial = run Revision.publish(&Revision.make(), &entry, &first)
  let mut warm = makeSemantic(run Revision.copy(&initial))
  let mut request = Request.make()
  let original = run Semantic.demandMir(&mut warm, &mut request, &entry, b"receive")
  run Testing.expect(backendGapAt(&original, GapCode.ForeignContract, firstText,
    "unsafe extern \"C\" fn receive(tag: i32, ...) -> i32", usize.ZERO),
    "a bodyless variadic foreign import reaches the normal foreign boundary")
  let before = starts(Semantic.eventLog(&warm), Family.Mir)

  let changed = run present(changedText)
  let revised = run Revision.publish(&initial, &entry, &changed)
  run Semantic.update(&mut warm, run Revision.copy(&revised))
  let mut warmRequest = Request.make()
  let revisedAnswer = run Semantic.demandMir(&mut warm, &mut warmRequest, &entry, b"receive")
  let mut fresh = makeSemantic(move revised)
  let mut freshRequest = Request.make()
  let expected = run Semantic.demandMir(&mut fresh, &mut freshRequest, &entry, b"receive")
  run Testing.expect(backendGapAt(&revisedAnswer, GapCode.CAbiVariadic, changedText,
      "unsafe extern \"C\" fn receive(tag: i32, ...) -> i32 { return tag }", usize.ZERO)
    && backendGapAt(&expected, GapCode.CAbiVariadic, changedText,
      "unsafe extern \"C\" fn receive(tag: i32, ...) -> i32 { return tag }", usize.ZERO)
    && starts(Semantic.eventLog(&warm), Family.Mir) > before,
    "a variadic foreign body edit changes the warm and fresh gap at the exact declaration span")
  return ()
}

