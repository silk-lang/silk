//! Current byte projections for stable significant-token boundaries.

import silk.core.option {Option}
import lexer.Span {Span}
import lexer.Token {Token, TokenKind, kind as tokenKind, span as tokenSpan}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.ownership {Copy}
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.collections.list {List}
import silk.collections.column_list {ColumnList}

/// Two significant-token boundaries, relative to a declaration's first token.
/// Even coordinates select token starts; odd coordinates select token ends.
pub struct Location {
  pub start: usize,
  pub end: usize,
}

impl Copy for Location {}

impl Location {
  /// No authored location, for compiler-generated operations such as drop glue.
  pub fn generated() -> Self {
    return Location {start: usize.MAX, end: usize.MAX}
  }
  pub fn isAuthored(self: Self) -> bool {
    return self.start != usize.MAX
  }
  pub fn make(start: usize, end: usize) -> Self {
    return Location {start: start, end: end}
  }
}

/// A 1-based line and column, the column counted in bytes.
pub struct LineColumn {
  pub line: usize,
  pub column: usize,
}

impl Copy for LineColumn {}

// The bits of a place that hold its column.
const COLUMN_MASK: u64 = 16777215

/// `line << 24 | column`, the form a debug build's markers and tables hold a place in. A column
/// past 24 bits, on a line over 16 MB, keeps the line and says column 0.
pub fn place(at: LineColumn) -> u64 {
  let mut column = usize.toU64(at.column)
  if column > COLUMN_MASK { column = 0 }
  return u64.bitOr(u64.shiftLeft(usize.toU64(at.line), 24), column)
}

/// The line of a place.
pub fn placeLine(place: u64) -> u64 { return u64.shiftRight(place, 24) }

/// The column of a place, zero when it has none.
pub fn placeColumn(place: u64) -> u64 { return u64.bitAnd(place, COLUMN_MASK) }

/// The place of `at` counted from `origin`, the place of its declaration's first token: its line
/// counted from the origin's line as line 1, and on that line its column counted from the
/// origin's column as column 1. Lines below keep their own column. A declaration that moves
/// without changing keeps every relative place, and [`absolutePlace`] gives the place back from
/// where the declaration starts now. Zero, no place, for a position before the origin.
pub fn relativePlace(origin: LineColumn, at: LineColumn) -> u64 {
  if at.line < origin.line { return 0 }
  let line = at.line - origin.line + usize.ONE
  let mut column = at.column
  if line == usize.ONE {
    if at.column < origin.column { return 0 }
    column = at.column - origin.column + usize.ONE
  }
  return place(LineColumn {line: line, column: column})
}

/// The place in the source of `relative` ([`relativePlace`]) in a declaration whose first token is
/// at the place `origin`. An origin of zero, an unknown one, reads as line 1, column 1. Zero stays
/// zero.
pub fn absolutePlace(origin: u64, relative: u64) -> u64 {
  if relative == 0 || origin == 0 { return relative }
  let line = u64.shiftRight(origin, 24) + u64.shiftRight(relative, 24) - 1
  let mut column = u64.bitAnd(relative, COLUMN_MASK)
  if u64.shiftRight(relative, 24) == 1 && column != 0 {
    column = u64.bitAnd(origin, COLUMN_MASK) + column - 1
    if column > COLUMN_MASK { column = 0 }
  }
  return u64.bitOr(u64.shiftLeft(line, 24), column)
}

/// The source revision's significant-token spans, including its end-of-file token, and the byte
/// offset where each of its lines starts.
pub struct SourceLocations {
  spans: List<Edges>,
  lines: List<usize>,
}

// One significant token's byte span in two 32-bit halves: a package holds one per token.
struct Edges {
  start: u32,
  end: u32,
}

impl Copy for Edges {}

fn spanAt(spans: &List<Edges>, at: usize) -> Span {
  let edges = List<Edges>.get(spans, at)
  return Span.make(u32.toUsize(edges.start), u32.toUsize(edges.end))
}

fn significant(token: Token) -> bool {
  return match tokenKind(token) {
    TokenKind.Whitespace => false
    TokenKind.LineComment => false
    TokenKind.DocComment => false
    TokenKind.ModuleDocComment => false
    _ => true
  }
}

impl SourceLocations {
  pub effect fn make(tokens: &ColumnList<Token>, source: &[u8]) -> Self ! OutOfMemoryError ? &mut Allocator {
    let mut spans = List<Edges>.make()
    let mut at = usize.ZERO
    while at < ColumnList<Token>.length(tokens) {
      if significant(ColumnList<Token>.get(tokens, at)) {
        let span = tokenSpan(ColumnList<Token>.get(tokens, at))
        run List<Edges>.append(&mut spans, Edges {start: usize.toU32(span.start), end: usize.toU32(span.end)})
      }
      at = at + usize.ONE
    }
    let mut lines = List<usize>.make()
    run List<usize>.append(&mut lines, usize.ZERO)
    at = usize.ZERO
    while at < source.length {
      if source[at] == 10 { run List<usize>.append(&mut lines, at + usize.ONE) }
      at = at + usize.ONE
    }
    return SourceLocations {spans: move spans, lines: move lines}
  }
  /// The line and column of byte offset `byte`.
  pub fn lineColumn(self: &Self, byte: usize) -> LineColumn {
    let starts = List<usize>.asSlice(&self.lines)
    // The last line start at or before `byte`; the first line starts at zero.
    let mut low = usize.ONE
    let mut high = starts.length
    while low < high {
      let middle = low + (high - low) / 2
      if starts[middle] <= byte {
        low = middle + usize.ONE
      } else {
        high = middle
      }
    }
    return LineColumn {line: low, column: byte - starts[low - usize.ONE] + usize.ONE}
  }
  /// Finds a token boundary without trapping on parser/recovery diagnostic positions.
  pub fn findBoundary(self: &Self, byte: usize, end: bool) -> Option<usize> {
    let spans = List<Edges>.asSlice(&self.spans)
    let mut low = usize.ZERO
    let mut high = spans.length
    while low < high {
      let middle = low + (high - low) / 2
      let mut value = u32.toUsize(spans[middle].start)
      if end {
        value = u32.toUsize(spans[middle].end)
      }
      if value < byte {
        low = middle + usize.ONE
      } else {
        high = middle
      }
    }
    if low >= spans.length { return Option<usize>.none() }
    let span = spanAt(&self.spans, low)
    if end && span.end == byte {
      return Option<usize>.some(low * 2 + usize.ONE)
    }
    if !end && span.start == byte {
      return Option<usize>.some(low * 2)
    }
    // Zero-width spans may use either edge of a significant token.
    if span.start == byte {
      return Option<usize>.some(low * 2)
    }
    if low > usize.ZERO {
      let previous = spanAt(&self.spans, low - usize.ONE)
      if previous.end == byte {
        return Option<usize>.some((low - usize.ONE) * 2 + usize.ONE)
      }
    }
    return Option<usize>.none()
  }
  /// Captures an exact authored boundary; unsupported positions violate this caller contract.
  pub fn boundary(self: &Self, byte: usize, end: bool) -> usize {
    if let Option<usize>.Some {value} = move SourceLocations.findBoundary(self, byte, end) { return value }
    return spanAt(&self.spans, usize.MAX).start
  }
  /// A retained token coordinate may disappear after a source edit.
  pub fn hasBoundary(self: &Self, boundary: usize) -> bool {
    return boundary / 2 < List<Edges>.length(&self.spans)
  }
  pub fn byte(self: &Self, boundary: usize) -> usize {
    let span = spanAt(&self.spans, boundary / 2)
    if boundary % 2 == usize.ZERO {
      return span.start
    }
    return span.end
  }
}
