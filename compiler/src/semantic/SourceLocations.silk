//! Current byte projections for stable significant-token boundaries.

import lexer.Span {Span}
import lexer.Token {Token, TokenKind, kind as tokenKind, span as tokenSpan}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.ownership {Copy}
import silk.usize
import silk.vector {Vector}

/// Two significant-token boundaries, relative to a declaration's first token.
/// Even coordinates select token starts; odd coordinates select token ends.
pub struct Location {
  pub start: usize
  pub end: usize
}

impl Copy for Location {}

impl Location {
  /// No authored location, for compiler-generated operations such as drop glue.
  pub fn generated() -> Self {
    return Location {start: usize.MAX, end: usize.MAX}
  }
  pub fn isAuthored(self: Self) -> bool {
    return self.start != usize.MAX
  }
  pub fn make(start: usize, end: usize) -> Self {
    return Location {start: start, end: end}
  }
}

/// The source revision's significant-token spans, including its end-of-file token.
pub struct SourceLocations {
  spans: Vector<Span>
}

fn significant(token: Token) -> bool {
  return match tokenKind(token) {
    TokenKind.Whitespace => false
    TokenKind.LineComment => false
    TokenKind.DocComment => false
    TokenKind.ModuleDocComment => false
    _ => true
  }
}

impl SourceLocations {
  pub effect fn make(tokens: &[Token]) -> Self ! OutOfMemoryError ? &mut Allocator {
    let mut spans = Vector<Span>.make()
    let mut at = usize.ZERO
    while at < tokens.length {
      if significant(tokens[at]) {
        run Vector<Span>.append(&mut spans, tokenSpan(tokens[at]))
      }
      at = at + usize.ONE
    }
    return SourceLocations {spans: move spans}
  }
  /// Captures an exact token start or end. A non-token boundary violates the caller's invariant.
  pub fn boundary(self: &Self, byte: usize, end: bool) -> usize {
    let spans = Vector<Span>.asSlice(&self.spans)
    let mut low = usize.ZERO
    let mut high = spans.length
    while low < high {
      let middle = low + (high - low) / 2
      let mut value = spans[middle].start
      if end {
        value = spans[middle].end
      }
      if value < byte {
        low = middle + usize.ONE
      } else {
        high = middle
      }
    }
    let span = Vector<Span>.get(&self.spans, low)
    if end && span.end == byte {
      return low * 2 + usize.ONE
    }
    if !end && span.start == byte {
      return low * 2
    }
    // Zero-width spans may use either edge of a significant token.
    if span.start == byte {
      return low * 2
    }
    if low > usize.ZERO {
      let previous = Vector<Span>.get(&self.spans, low - usize.ONE)
      if previous.end == byte {
        return (low - usize.ONE) * 2 + usize.ONE
      }
    }
    // Use the same bounds-checked failure as any invalid source-local identity.
    return Vector<Span>.get(&self.spans, usize.MAX).start
  }
  pub fn byte(self: &Self, boundary: usize) -> usize {
    let span = Vector<Span>.get(&self.spans, boundary / 2)
    if boundary % 2 == usize.ZERO {
      return span.start
    }
    return span.end
  }
}
