//! Current byte projections for stable significant-token boundaries.

import lexer.Span {Span}
import lexer.Token {Token, TokenKind, kind as tokenKind, span as tokenSpan}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.ownership {Copy}
import silk.usize
import silk.vector {Vector}

/// Two significant-token boundaries, relative to a declaration's first token.
/// Even coordinates select token starts; odd coordinates select token ends.
pub struct Location {
  pub start: usize
  pub end: usize
}

impl Copy for Location {}

impl Location {
  /// No authored location, for compiler-generated operations such as drop glue.
  pub fn generated() -> Self {
    return Location {start: usize.MAX, end: usize.MAX}
  }
  pub fn isAuthored(self: Self) -> bool {
    return self.start != usize.MAX
  }
  pub fn make(start: usize, end: usize) -> Self {
    return Location {start: start, end: end}
  }
}

/// The source revision's significant-token spans, including its end-of-file token.
pub struct SourceLocations {
  spans: Vector<Span>
}

/// Newline positions for one source capture, built only when an incremental location comparison
/// is requested. The first line starts at byte zero; columns count bytes, like runtime site labels.
pub struct LineMap {
  starts: Vector<usize>
}

struct LinePosition {
  line: usize
  start: usize
}

impl LineMap {
  pub effect fn make(source: &[u8]) -> Self ! OutOfMemoryError ? &mut Allocator {
    let mut starts = Vector<usize>.make()
    run Vector<usize>.append(&mut starts, usize.ZERO)
    let mut at = usize.ZERO
    while at < source.length {
      if source[at] == 10 { run Vector<usize>.append(&mut starts, at + usize.ONE) }
      at = at + usize.ONE
    }
    return LineMap {starts: move starts}
  }

  fn position(self: &Self, byte: usize) -> LinePosition {
    let starts = Vector<usize>.asSlice(&self.starts)
    let mut low = usize.ZERO
    let mut high = starts.length
    while low < high {
      let middle = low + (high - low) / 2
      if starts[middle] <= byte { low = middle + usize.ONE } else { high = middle }
    }
    return LinePosition {line: low, start: starts[low - usize.ONE]}
  }

  pub fn sameAt(self: &Self, other: &LineMap, byte: usize) -> bool {
    let first = LineMap.position(self, byte)
    let second = LineMap.position(other, byte)
    return first.line == second.line && first.start == second.start
  }
}

fn firstTokenAt(spans: &[Span], byte: usize) -> usize {
  let mut low = usize.ZERO
  let mut high = spans.length
  while low < high {
    let middle = low + (high - low) / 2
    if spans[middle].start < byte { low = middle + usize.ONE } else { high = middle }
  }
  return low
}

fn significant(token: Token) -> bool {
  return match tokenKind(token) {
    TokenKind.Whitespace => false
    TokenKind.LineComment => false
    TokenKind.DocComment => false
    TokenKind.ModuleDocComment => false
    _ => true
  }
}

impl SourceLocations {
  pub effect fn make(tokens: &[Token]) -> Self ! OutOfMemoryError ? &mut Allocator {
    let mut spans = Vector<Span>.make()
    let mut at = usize.ZERO
    while at < tokens.length {
      if significant(tokens[at]) {
        run Vector<Span>.append(&mut spans, tokenSpan(tokens[at]))
      }
      at = at + usize.ONE
    }
    return SourceLocations {spans: move spans}
  }
  /// Captures an exact token start or end. A non-token boundary violates the caller's invariant.
  pub fn boundary(self: &Self, byte: usize, end: bool) -> usize {
    let spans = Vector<Span>.asSlice(&self.spans)
    let mut low = usize.ZERO
    let mut high = spans.length
    while low < high {
      let middle = low + (high - low) / 2
      let mut value = spans[middle].start
      if end {
        value = spans[middle].end
      }
      if value < byte {
        low = middle + usize.ONE
      } else {
        high = middle
      }
    }
    let span = Vector<Span>.get(&self.spans, low)
    if end && span.end == byte {
      return low * 2 + usize.ONE
    }
    if !end && span.start == byte {
      return low * 2
    }
    // Zero-width spans may use either edge of a significant token.
    if span.start == byte {
      return low * 2
    }
    if low > usize.ZERO {
      let previous = Vector<Span>.get(&self.spans, low - usize.ONE)
      if previous.end == byte {
        return (low - usize.ONE) * 2 + usize.ONE
      }
    }
    // Use the same bounds-checked failure as any invalid source-local identity.
    return Vector<Span>.get(&self.spans, usize.MAX).start
  }
  pub fn byte(self: &Self, boundary: usize) -> usize {
    let span = Vector<Span>.get(&self.spans, boundary / 2)
    if boundary % 2 == usize.ZERO {
      return span.start
    }
    return span.end
  }

  /// All significant-token byte and line/column projections within one retained declaration.
  /// Token text may change at identical positions without changing its location property.
  pub fn matchesRange(self: &Self, other: &SourceLocations, before: Span, after: Span,
    beforeLines: &LineMap, afterLines: &LineMap) -> bool {
    if before.start != after.start || before.end != after.end
      || !LineMap.sameAt(beforeLines, afterLines, before.start)
      || !LineMap.sameAt(beforeLines, afterLines, before.end) { return false }
    let old = Vector<Span>.asSlice(&self.spans)
    let current = Vector<Span>.asSlice(&other.spans)
    let mut oldAt = firstTokenAt(old, before.start)
    let mut newAt = firstTokenAt(current, after.start)
    while oldAt < old.length && old[oldAt].start < before.end {
      if newAt >= current.length || current[newAt].start >= after.end
        || old[oldAt].start != current[newAt].start || old[oldAt].end != current[newAt].end
        || !LineMap.sameAt(beforeLines, afterLines, old[oldAt].start)
        || !LineMap.sameAt(beforeLines, afterLines, old[oldAt].end) { return false }
      oldAt = oldAt + usize.ONE
      newAt = newAt + usize.ONE
    }
    return newAt >= current.length || current[newAt].start >= after.end
  }
}
