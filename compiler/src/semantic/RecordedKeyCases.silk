//! Persisted instance shapes rebuild exact generic applications without a parent MIR, and refuse
//! unsupported or malformed shapes instead of substituting a different application.

import backend.InstanceKey {InstanceKey, ProviderEntry}
import hir.Hir {Access, OwnerKind}
import semantic.ContentHash {ContentHash}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.Lifetime {CanonicalizationFailure}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.RecordedKey
import semantic.RuntimeEncoding
import semantic.Specialization {Application, ScopeBinding, StaticSlot, Target}
import semantic.StableKey
import semantic.StaticValue {Value, IntegerType, Sign}
import semantic.Type {Argument, Requirement, Type}
import semantic.Types {TypeTable, Types}
import silk.text.string {String}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.interned {Interned}
import silk.testing.testing {AssertionError, Testing}
import silk.num.usize

// Each case falsifies a different omission in the shape codec: the own type argument, recursive
// nominal arguments, or the scope/provider/static channels. The last has no reversible shape.
test effect fn recordedKeysRetainTheirCompleteSupportedShape() -> ()
  ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run shapeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn shapeClaims() -> () ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut first = TypeTable.make()
  let mut second = TypeTable.make()
  let mut kind = usize.ZERO
  while kind < 4 {
    let original = run caseKey(kind) |> Effect.provideMut<Types>(&mut first)
    let mut bytes = Bytes.make()
    run StableKey.declaration(&mut bytes, &DeclarationId.copyShared(&InstanceKey.identity(&original)))
    let prefix = Bytes.length(&bytes)
    let declarationOnly = run Bytes.copy(Bytes.asSlice(&bytes))
    run RecordedKey.appendShape(&mut bytes, &original)
    let read = run RecordedKey.read(Bytes.asSlice(&bytes)) |> Effect.provideMut<Types>(&mut second)
    let mut exact = false
    if let Option<InstanceKey>.Some {value} = &read {
      exact = ContentHash.equals(run InstanceKey.identityDigest(&original), run InstanceKey.identityDigest(&value))
    }
    if kind == 3 {
      run Testing.expect(sameBytes(Bytes.asSlice(&bytes), Bytes.asSlice(&declarationOnly)) && !exact, "an unsupported descriptor argument writes no shape and cannot match the recorded key")
    } else {
      run Testing.expect(exact, "the supported key rebuilds with its exact identity in another type table")
      let truncated = run RecordedKey.read(Slice.view<u8>(Bytes.asSlice(&bytes), usize.ZERO, Bytes.length(&bytes) - usize.ONE))
        |> Effect.provideMut<Types>(&mut second)
      run Testing.expect(Option<InstanceKey>.isNone(&truncated), "a partial shape must not rebuild a key")
      if kind == usize.ZERO {
        let mut unknown = run Bytes.copy(Bytes.asSlice(&bytes))
        let mut tagged = Bytes.asMutSlice(&mut unknown)
        tagged[prefix + 16] = 255
        let refused = run RecordedKey.read(Bytes.asSlice(&unknown)) |> Effect.provideMut<Types>(&mut second)
        run Testing.expect(Option<InstanceKey>.isNone(&refused), "an unknown argument tag must not rebuild a key")
      }
      run RuntimeEncoding.word(&mut bytes, 99)
      let padded = run RecordedKey.read(Bytes.asSlice(&bytes)) |> Effect.provideMut<Types>(&mut second)
      run Testing.expect(Option<InstanceKey>.isNone(&padded), "trailing unknown shape data must not rebuild a key")
    }
    kind = kind + usize.ONE
  }
}

effect fn named(name: string<'static>, kind: OwnerKind) -> DeclarationId ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners, OwnerStep {kind: kind, name: Option<Bytes>.some(run Bytes.copy(String.utf8Bytes(name))), occurrence: usize.ZERO})
  return run DeclarationId.fromParts(run ModuleId.make(b"memory", b"example", b"recorded.silk"), move owners)
}

effect fn boxType(value: Interned<Type>) -> Interned<Type> ! InvalidModulePath | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut arguments = List<Argument>.make()
  run List<Argument>.append(&mut arguments, Argument.Type {value: move value})
  return run Types.intern(Type.Nominal {declaration: run named("Box", OwnerKind.Struct), isPublic: true, arguments: move arguments})
}

effect fn staticSlots(ordinal: usize) -> List<StaticSlot> ! OutOfMemoryError ? &mut Allocator {
  let mut slots = List<StaticSlot>.make()
  run List<StaticSlot>.append(&mut slots, StaticSlot {ordinal: ordinal,
    value: run Interned<Value>.make(Value.Integer {ty: IntegerType.I32, sign: Sign.Negative, magnitude: 7})})
  return move slots
}

effect fn caseKey(kind: usize) -> InstanceKey ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let declaration = run named("callee", OwnerKind.Function)
  let mut value = run Types.intern(Type.Primitive {name: run Bytes.copy(String.utf8Bytes("i32"))})
  if kind == 1 || kind == 2 {
    let current = move value
    value = run boxType(run boxType(move current))
  }
  if kind == 3 {
    let current = move value
    value = run Types.intern(Type.TypeDescriptor {owner: move current})
  }
  let mut arguments = List<Argument>.make()
  let mut ordinals = List<usize>.make()
  run List<Argument>.append(&mut arguments, Argument.Type {value: Interned<Type>.clone(&value)})
  run List<usize>.append(&mut ordinals, 2)
  let mut scopes = List<ScopeBinding>.make()
  let mut providers = List<ProviderEntry>.make()
  let mut statics = List<StaticSlot>.make()
  if kind == 2 {
    let mut supplied = List<Argument>.make()
    let mut positions = List<usize>.make()
    run List<Argument>.append(&mut supplied, Argument.Type {value: Interned<Type>.clone(&value)})
    run List<usize>.append(&mut positions, 4)
    run List<ScopeBinding>.append(&mut scopes, ScopeBinding {owner: run Types.internDeclaration(run named("scope", OwnerKind.Implementation)),
      arguments: move supplied, argumentOrdinals: move positions, statics: run staticSlots(8)})
    statics = run staticSlots(9)
    run List<ProviderEntry>.append(&mut providers, ProviderEntry {key: Requirement {capability: Interned<Type>.clone(&value),
      roleType: Option<Interned<Type>>.some(Interned<Type>.clone(&value)), access: Access.Mutable}, provider: Interned<Type>.clone(&value)})
  }
  let application = Application {target: Target.Named {declaration: move declaration}, arguments: move arguments,
    argumentOrdinals: move ordinals, scopes: move scopes, statics: move statics}
  return match move run InstanceKey.canonical(move application, move providers) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value: key} => move key
    Result<InstanceKey, CanonicalizationFailure>.Failure {..} => {
      run Testing.expect(false, "the fixture must construct a canonical key")
      return run InstanceKey.named(&run Types.internDeclaration(run named("failed", OwnerKind.Function)))
    }
  }
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}
