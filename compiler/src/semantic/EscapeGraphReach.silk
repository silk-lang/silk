//! Views a shared escape graph through one module's roots without copying entry payloads.
import semantic.BuildRecord
import semantic.ContentHash {ContentHash}
import semantic.InternIndex {InternIndex}
import semantic.WalkFragments
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize
import silk.testing.testing {AssertionError, Testing}

// Lookup positions are positions in `ordered`, so the result doubles as the visited set.
// Memory is proportional to the selected closure, not the entire shared graph.
fn visited(ordered: &[usize], lookup: &InternIndex, entry: usize) -> bool {
  let mut at = InternIndex.first(lookup, usize.toU64(entry))
  while at != usize.MAX {
    if ordered[at] == entry { return true }
    at = InternIndex.after(lookup, at)
  }
  return false
}

/// Returns distinct original entry indices in exactly `WalkFragments.rooted` visitation order:
/// roots are pushed in their supplied order and popped last-first; references are visited in
/// their listed order. Root identities must exist and agree with the indexed record. Every
/// reached reference must be in bounds. Unreached entries are not inspected or copied.
/// This is a reference-closure view, not an escape/admission/NonParking proof. The caller owns
/// the decoded immutable graph, its matching index, and all boundary or proof decisions.
pub effect fn reachable(record: &BuildRecord.Record, index: &WalkFragments.GraphIndex,
  roots: &[ContentHash]) -> Option<List<usize>> ! OutOfMemoryError ? &mut Allocator {
  let entries = List<BuildRecord.Entry>.asSlice(&record.entries)
  let mut pending = List<usize>.make()
  let mut at = usize.ZERO
  while at < roots.length {
    let entry = WalkFragments.graphEntry(index, roots[at])
    if entry >= entries.length || !ContentHash.equals(entries[entry].exact, roots[at]) {
      return Option<List<usize>>.none()
    }
    run List<usize>.append(&mut pending, entry)
    at = at + usize.ONE
  }
  let mut ordered = List<usize>.make()
  let mut lookup = InternIndex.make()
  while let Option<usize>.Some {value: entry} = move List<usize>.pop(&mut pending) {
    if entry >= entries.length { return Option<List<usize>>.none() }
    if visited(List<usize>.asSlice(&ordered), &lookup, entry) { continue }
    run List<usize>.append(&mut ordered, entry)
    run InternIndex.record(&mut lookup, usize.toU64(entry))
    let references = List<BuildRecord.Reference>.asSlice(&entries[entry].references)
    at = references.length
    while at > usize.ZERO {
      at = at - usize.ONE
      let target = references[at].target
      if target >= entries.length { return Option<List<usize>>.none() }
      if !visited(List<usize>.asSlice(&ordered), &lookup, target) {
        run List<usize>.append(&mut pending, target)
      }
    }
  }
  return Option<List<usize>>.some(move ordered)
}

fn key(value: u64) -> ContentHash { return ContentHash {high: 0, low: value} }
effect fn example(id: u64, references: &[usize]) -> BuildRecord.Entry ! OutOfMemoryError ? &mut Allocator {
  let mut edges = List<BuildRecord.Reference>.make()
  let mut at = usize.ZERO
  while at < references.length {
    run List<BuildRecord.Reference>.append(&mut edges, BuildRecord.Reference {target: references[at], edge: key(0)})
    at = at + usize.ONE
  }
  return BuildRecord.Entry {exact: key(id), hash: id, family: 0, declaration: Bytes.make(),
    parent: usize.MAX, position: usize.ZERO, requested: false, alias: usize.MAX, leaf: 0,
    references: move edges, summary: key(id), facts: BuildRecord.unknownFacts()}
}

fn absent(value: &Option<List<usize>>) -> bool {
  return match &value.* { Option<List<usize>>.Some {..} => false _ => true }
}

test effect fn escapeGraphReachMatchesRootedOrderAndKeepsCyclesDistinct() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run orderClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn orderClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut graph = BuildRecord.make(false, false)
  run List<BuildRecord.Entry>.append(&mut graph.entries, run example(1, &[1, 2, 1]))
  run List<BuildRecord.Entry>.append(&mut graph.entries, run example(2, &[0]))
  run List<BuildRecord.Entry>.append(&mut graph.entries, run example(3, &[1]))
  run List<BuildRecord.Entry>.append(&mut graph.entries, run example(4, &[]))
  // This unrelated malformed entry must not force validation or payload copying.
  run List<BuildRecord.Entry>.append(&mut graph.entries, run example(5, &[usize.MAX]))
  let index = run WalkFragments.indexGraph(&graph)
  let roots = [key(1), key(4)]
  let selected = match move run reachable(&graph, &index, &roots) {
    Option<List<usize>>.Some {value} => move value
    _ => { run Testing.expect(false, "valid selected closure accepts") return () }
  }
  let order = List<usize>.asSlice(&selected)
  run Testing.expect(order.length == 4 && order[0] == 3 && order[1] == 0 && order[2] == 1 && order[3] == 2,
    "last root first and forward reference DFS match rooted, despite duplicate edges and cycles")
  let materialized = match move run WalkFragments.rooted(&graph, &index, &roots) {
    Option<BuildRecord.Record>.Some {value} => move value
    _ => { run Testing.expect(false, "existing rooted accepts the same selected closure") return () }
  }
  let original = List<BuildRecord.Entry>.asSlice(&graph.entries)
  let copied = List<BuildRecord.Entry>.asSlice(&materialized.entries)
  run Testing.expect(copied.length == order.length, "view and materialized closure have equal sizes")
  let mut at = usize.ZERO
  while at < order.length {
    run Testing.expect(ContentHash.equals(original[order[at]].exact, copied[at].exact),
      "each view position names exactly the old rooted traversal's entry")
    at = at + usize.ONE
  }
  let repeated = match move run reachable(&graph, &index, &[key(1), key(1)]) {
    Option<List<usize>>.Some {value} => move value
    _ => { run Testing.expect(false, "duplicate roots are permitted") return () }
  }
  run Testing.expect(List<usize>.length(&repeated) == 3, "duplicate roots do not duplicate reached entries")
  return ()
}

test effect fn escapeGraphReachRejectsMissingRootsAndReachedBounds() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run refusalClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn refusalClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut graph = BuildRecord.make(false, false)
  run List<BuildRecord.Entry>.append(&mut graph.entries, run example(1, &[1]))
  run List<BuildRecord.Entry>.append(&mut graph.entries, run example(2, &[2]))
  let index = run WalkFragments.indexGraph(&graph)
  let missing = run reachable(&graph, &index, &[key(9)])
  run Testing.expect(absent(&missing), "a descriptor cannot silently lose an absent root")
  let bounds = run reachable(&graph, &index, &[key(1)])
  run Testing.expect(absent(&bounds), "invalid reachable references refuse without indexing out of bounds")
  let empty = match move run reachable(&graph, &index, &[]) {
    Option<List<usize>>.Some {value} => move value
    _ => { run Testing.expect(false, "no roots selects no entries") return () }
  }
  run Testing.expect(List<usize>.length(&empty) == 0, "empty selection does not inspect unrelated malformed entries")
  let mut unrelated = BuildRecord.make(false, false)
  run List<BuildRecord.Entry>.append(&mut unrelated.entries, run example(9, &[]))
  run List<BuildRecord.Entry>.append(&mut unrelated.entries, run example(1, &[]))
  let wrongIndex = run WalkFragments.indexGraph(&unrelated)
  let mismatch = run reachable(&graph, &wrongIndex, &[key(1)])
  run Testing.expect(absent(&mismatch), "an index must identify the requested root in this record")
  return ()
}
