  return Intrinsic.sharedWithMut<i32, StoredSharedView<'a>>(core, storeSharedView, sharedConflict)
}
fn nestedSharedAccess(core: &Intrinsic.SharedCore<i32>) -> i32 {
  return Intrinsic.sharedWithMut<i32, i32>(core, fn(value: &mut i32) -> i32 {
    let nested = Intrinsic.sharedWithMut<i32, i32>(core,
