  let d1 = run Semantic.demandBody(&mut store, &mut request, &id, b"d1")
  let n24 = run Semantic.demandBody(&mut store, &mut request, &id, b"n24")
  let d2 = run Semantic.demandBody(&mut store, &mut request, &id, b"d2")
  let d3 = run Semantic.demandBody(&mut store, &mut request, &id, b"d3")
