// The instance key of the first call in a MIR function, absent without one.
fn firstCallTarget(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> Option<Shared<DeclarationId>> {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = List<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &blocks[at].terminator {
          return Option<Shared<DeclarationId>>.some(InstanceKey.identity(&key))
        }
        at = at + usize.ONE
      }
    }
  }
  return Option<Shared<DeclarationId>>.none()
}

// Whether any call in a MIR function targets an instance of a declaration named `name`.
fn callsTarget(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, name: string) -> bool {
  return callCount(store, answer, name) > usize.ZERO
}

// How many calls in a MIR function target an instance of a declaration named `name`.
fn callCount(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, name: string) -> usize {
  let mut count = usize.ZERO
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = List<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          if Shared<DeclarationId>.with<bool>(&identity, fn(value: &DeclarationId) -> bool {
            return DeclarationId.named(value, String.utf8Bytes(name))
          }) { count = count + usize.ONE }
        }
        at = at + usize.ONE
      }
    }
  }
  return count
}

fn callsNamed(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, name: string) -> bool {
  let target = firstCallTarget(store, answer)
  if let Option<Shared<DeclarationId>>.Some {value} = move target {
    return Shared<DeclarationId>.with<bool>(&value, fn(identity: &DeclarationId) -> bool {
      return DeclarationId.named(identity, String.utf8Bytes(name))
    })
  }
  return false
}

test effect fn storedEffectsRunThroughTheirConstructionRunner() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("stored-effects.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Problem { code: i32 }
effect fn add(a: i32, b: i32) -> i32 { return a + b }
effect fn check(value: i32) -> i32 ! Problem {
  if value > 100 { fail Problem { code: value } }
  return value
}
effect fn runner<A, E>(self: once Effect<A ! E>) -> A ! E { return run move self }
fn stored() -> i32 {
  let pending = add(40, 2)
  return run pending
}
fn generic() -> i32 { return run runner(add(1, 2)) }
effect fn forwarded(value: i32) -> i32 ! Problem { return run runner(check(value)) }
fn plus(value: i32) -> i32 { return value + 1 }
fn apply(f: fn(i32) -> i32, value: i32) -> i32 { return f(value) }
fn named() -> i32 { return apply(plus, 1) }
fn foreign() -> i32 { return apply(abs, 1) }
unsafe extern "C" fn abs(value: i32) -> i32
fn pass<T>(value: T) -> T { return value }
fn passed() -> i32 { return run pass(add(1, 2)) }
fn invoked() -> i32 {
  let f = add
  return run f(1, 2)
}
struct Token { value: i32 }
effect fn bump(count: &mut i32) -> i32 { return 1 }
fn exclusive() -> i32 {
  let mut count = 1
  let pendingBump = bump(&mut count)
  return run pendingBump
}
effect fn spend(token: Token) -> i32 { return token.value }
effect fn shared(self: Effect<i32>) -> i32 { return run self }
fn incompatible() -> i32 { return run shared(spend(Token { value: 1 })) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let stored = run Semantic.demandMir(&mut store, &mut request, &id, b"stored") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let generic = run Semantic.demandMir(&mut store, &mut request, &id, b"generic") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let forwarded = run Semantic.demandMir(&mut store, &mut request, &id, b"forwarded") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(callsNamed(&store, &stored, "add") && failureFact(&store, &stored, 2) == usize.ZERO,
    "a stored construction runs as a direct call of its effect fn with its stored arguments")
  run Testing.expect(callsNamed(&store, &generic, "runner") && callsNamed(&store, &forwarded, "runner") &&
    failureFact(&store, &forwarded, 2) == usize.ONE,
    "an Effect parameter specializes to the argument's exact representation and keeps its failure edge")
  let named = run Semantic.demandMir(&mut store, &mut request, &id, b"named") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let foreign = run Semantic.demandBody(&mut store, &mut request, &id, b"foreign") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(callsNamed(&store, &named, "apply") && rejectsSpan(&foreign, RejectionCode.ForeignFunctionNotFirstClass, text, "abs", 0),
    "a named function value is a capture-free exact callable, and a C function has none")
  let passed = run Semantic.demandMir(&mut store, &mut request, &id, b"passed") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let invoked = run Semantic.demandMir(&mut store, &mut request, &id, b"invoked") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(callsTarget(&store, &passed, "pass") && callsTarget(&store, &passed, "add"),
    "an ordinary call returning an Effect is not the run: its result runs through the construction's runner")
  run Testing.expect(callsTarget(&store, &invoked, "add"), "running an invoked effect fn value calls the target instance")
  let exclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusive") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let incompatible = run Semantic.demandBody(&mut store, &mut request, &id, b"incompatible") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&exclusive, RejectionCode.InvalidCallableInvocationAccess, text, "pendingBump", 1),
    "an exclusive Effect runs only from a mutable place")
  run Testing.expect(rejectsSpan(&incompatible, RejectionCode.IncompatibleCallableSignature, text, "spend(Token { value: 1 })", 0),
    "a once Effect does not satisfy a shared Effect parameter; SEM0076 names both modes at the argument")
  return ()
}

test effect fn catchFailureExpandsAtItsRunSite() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("catch-failure.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Selected { code: i32 }
struct Residual { code: i32 }
effect fn risky(mode: i32) -> i32 ! Selected | Residual {
  if mode == 0 { return 10 }
  if mode == 1 { fail Selected { code: 10 } }
  fail Residual { code: 16 }
}
effect fn recoverSelected(problem: Selected) -> i32 { return problem.code + 4 }
effect fn selective(mode: i32) -> i32 ! Residual { return run Intrinsic.catchFailure<Selected>(risky(mode), recoverSelected) }
effect fn wrongHandler(mode: i32) -> i32 ! Residual { return run Intrinsic.catchFailure<Residual>(risky(mode), recoverSelected) }
effect fn recoverAny(problem: Selected | Residual) -> i32 { return 0 }
effect fn whole(mode: i32) -> i32 { return run Intrinsic.catchFailure<Selected | Residual>(risky(mode), recoverAny) }
effect fn lone() -> i32 ! Selected { fail Selected { code: 1 } }
effect fn recoverWide(problem: Selected) -> i64 { return 2 }
effect fn widened() -> i32 | i64 { return run Intrinsic.catchFailure<Selected>(lone(), recoverWide) }
effect fn escalate(problem: Selected) -> i32 ! Residual { fail Residual { code: problem.code } }
effect fn rethrows() -> i32 ! Residual { return run Intrinsic.catchFailure<Selected>(lone(), escalate) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let selective = run Semantic.demandMir(&mut store, &mut request, &id, b"selective") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(callsTarget(&store, &selective, "risky") && callsTarget(&store, &selective, "recoverSelected") &&
    switchCount(&store, &selective) == usize.ONE && failureFact(&store, &selective, 2) == usize.ONE &&
    failureFact(&store, &selective, usize.ONE) == usize.ONE,
    "catchFailure runs the protected call with a failure edge, switches on the caught tag, calls the handler and fails the residual")
  let whole = run Semantic.demandMir(&mut store, &mut request, &id, b"whole") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let widened = run Semantic.demandMir(&mut store, &mut request, &id, b"widened") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let rethrows = run Semantic.demandMir(&mut store, &mut request, &id, b"rethrows") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(callsTarget(&store, &whole, "recoverAny") && switchCount(&store, &whole) == usize.ZERO &&
    callsTarget(&store, &widened, "recoverWide") && switchCount(&store, &widened) == usize.ZERO &&
    callsTarget(&store, &rethrows, "escalate") && failureFact(&store, &rethrows, 2) == 2,
    "selecting the whole or a single failure needs no switch; a wider handler success joins the result; the handler's own failure propagates")
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongHandler") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.InvalidEffectHandler, text, "recoverSelected", 2),
    "a handler that does not accept the selected failures is rejected at the handler")
  return ()
}

// `catch<S>` written in source (FAIL-005): `where S in E` is a premise inside the body and an
// obligation at each call, and `Without<E, S>` stays one term until the call names both types.
test effect fn selectiveCatchSubtractsItsSelection() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("selective-catch.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Selected { code: i32 }
struct Residual { code: i32 }
struct Absent {}
effect fn caught<'env, S, A, B, E, F, ?R, ?Q>(
  self: once Effect<'env; A ! E ? R>,
  onFailure: for<use 'call> once fn<'env>(S) -> once Effect<'call & 'env; B ! F ? Q>
) -> A | B ! Without<E, S> | F ? R | Q
where S in E {
  return run Intrinsic.catchFailure<S>(move self, move onFailure)
}
effect fn unproved<'env, S, A, E>(self: once Effect<'env; A ! E>, onFailure: once fn<'env>(S) -> once Effect<'env; A>) -> A ! Without<E, S> {
  return run Intrinsic.catchFailure<S>(move self, move onFailure)
}
effect fn forwarded<'env, S, A, E>(self: once Effect<'env; A ! E>, onFailure: once fn<'env>(S) -> once Effect<'env; A>) -> A ! Without<E, S>
where S in E {
  return run caught<S>(move self, move onFailure)
}
effect fn risky(mode: i32) -> i32 ! Selected | Residual {
  if mode == 0 { return 10 }
  if mode == 1 { fail Selected { code: 10 } }
  fail Residual { code: 16 }
}
effect fn recoverSelected(problem: Selected) -> i32 { return problem.code + 4 }
effect fn recoverAbsent(problem: Absent) -> i32 { return 0 }
effect fn selective(mode: i32) -> i32 ! Residual { return run caught<Selected>(risky(mode), recoverSelected) }
effect fn leaks(mode: i32) -> i32 { return run caught<Selected>(risky(mode), recoverSelected) }
effect fn absent(mode: i32) -> i32 ! Selected | Residual { return run caught<Absent>(risky(mode), recoverAbsent) }
effect fn twice(mode: i32) -> i32 ! Residual { return run forwarded<Selected>(risky(mode), recoverSelected) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let generic = run Semantic.demandBody(&mut store, &mut request, &id, b"caught") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let forwarded = run Semantic.demandBody(&mut store, &mut request, &id, b"forwarded") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&generic) && succeeded(&forwarded),
    "the declared S in E covers the generic selection and the residual is the declared Without<E, S> term")
  let unproved = run Semantic.demandBody(&mut store, &mut request, &id, b"unproved") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&unproved, RejectionCode.InvalidEffectHandler, text, "move onFailure", usize.ONE),
    "without the premise a generic selection is not known to be part of the protected failure")
  let selective = run Semantic.demandBody(&mut store, &mut request, &id, b"selective") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let twice = run Semantic.demandBody(&mut store, &mut request, &id, b"twice") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&selective) && succeeded(&twice),
    "a call that names both failure types proves S in E and normalizes Without<E, S> to the unselected members")
  let leaks = run Semantic.demandBody(&mut store, &mut request, &id, b"leaks") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(!succeeded(&leaks), "the unselected member still propagates")
  let absent = run Semantic.demandBody(&mut store, &mut request, &id, b"absent") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&absent, RejectionCode.InvalidEffectHandler, text, "caught<Absent>(risky(mode), recoverAbsent)", usize.ZERO),
    "a selection absent from the protected failure fails S in E at the call")
  return ()
}

// `where ?S in R` over requirement rows (SERV-008): the premise is assumed inside the body and
// proved at each call once the call names the row; a caller's own premise implies a relayed one.
// A generic handler passed by name is selected by the failure it is invoked with (FAIL-005).
test effect fn genericCatchHandlerIsSelectedByItsFailure() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("generic-catch-handler.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Selected { code: i32 }
struct Residual { code: i32 }
struct Caught<E> { error: E }
effect fn caught<E>(error: E) -> Caught<E> { return Caught<E> { error: move error } }
effect fn risky(mode: i32) -> i32 ! Selected | Residual {
  if mode == 0 { return 10 }
  if mode == 1 { fail Selected { code: 10 } }
  fail Residual { code: 16 }
}
effect fn both(mode: i32) -> i32 | Caught<Selected | Residual> { return run Intrinsic.catchFailure<Selected | Residual>(risky(mode), caught) }
effect fn one(mode: i32) -> i32 | Caught<Selected> ! Residual { return run Intrinsic.catchFailure<Selected>(risky(mode), caught) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let both = run Semantic.demandMir(&mut store, &mut request, &id, b"both") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let one = run Semantic.demandMir(&mut store, &mut request, &id, b"one") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(callsTarget(&store, &both, "caught") && callsTarget(&store, &one, "caught") && switchCount(&store, &one) == usize.ONE,
    "the selected failure type instantiates the generic handler for the whole or a partial selection")
  return ()
}

test effect fn requirementRowMembershipIsAPremiseAndACallObligation() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("requirement-membership.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
service Clock {}
service Logger {}
effect fn guarded<'env, A, ?R>(work: once Effect<'env; A ? R>) -> A ? R
where R in Without<R, Logger> {
  return run move work
}
effect fn relayed<'env, A, ?R>(work: once Effect<'env; A ? R>) -> A ? R
where R in Without<R, Logger> {
  return run guarded(move work)
}
effect fn unrelayed<'env, A, ?R>(work: once Effect<'env; A ? R>) -> A ? R {
  return run guarded(move work)
}
effect fn clocked() -> i32 ? &Clock { return 1 }
effect fn logged() -> i32 ? &Logger { return 2 }
effect fn accepted() -> i32 ? &Clock { return run guarded(clocked()) }
effect fn refused() -> i32 ? &Logger { return run guarded(logged()) }
effect fn forwarded() -> i32 ? &Clock { return run relayed(clocked()) }
effect fn premised<?R, ?S>(work: once Effect<i32 ? S>) -> i32 ? R
where S in R {
  return run move work
}
effect fn mismatched() -> i32 ? &Clock { return run premised<&Clock, &Logger>(logged()) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let guarded = run Semantic.demandBody(&mut store, &mut request, &id, b"guarded") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let relayed = run Semantic.demandBody(&mut store, &mut request, &id, b"relayed") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&guarded) && succeeded(&relayed),
    "a requirement-row membership premise checks its body, and the caller's own premise implies the relayed one")
  let unrelayed = run Semantic.demandBody(&mut store, &mut request, &id, b"unrelayed") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&unrelayed, RejectionCode.UnprovedRequirementPremise, text, "guarded(move work)", usize.ONE),
    "an open row without the premise is not known to exclude the removed key")
  let accepted = run Semantic.demandBody(&mut store, &mut request, &id, b"accepted") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let forwarded = run Semantic.demandBody(&mut store, &mut request, &id, b"forwarded") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&accepted) && succeeded(&forwarded),
    "a call whose row lacks the removed key proves the premise, directly and through a relay")
  let refused = run Semantic.demandBody(&mut store, &mut request, &id, b"refused") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&refused, RejectionCode.UnprovedRequirementPremise, text, "guarded(logged())", usize.ZERO),
    "a call whose row contains the removed key fails the premise at the call")
  let mismatched = run Semantic.demandBody(&mut store, &mut request, &id, b"mismatched") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&mismatched, RejectionCode.UnprovedRequirementPremise, text, "premised<&Clock, &Logger>(logged())", usize.ZERO)
      && answerCarries(&mismatched, b"selected", b"&requirement-membership.Logger")
      && answerCarries(&mismatched, b"source", b"&requirement-membership.Clock"),
    "an unproved premise over concrete rows names both rows")
  return ()
}

// A known nominal provider can infer rigid caller arguments through its conditional head.
test effect fn knownNominalProviderInfersRigidCallerArguments() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("known-nominal-conformance.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
interface Marker<A> {}
interface Source<A> {}
struct Wrapper<A, H> {}
struct Unfixed {}
impl<A> Marker<A> for Unfixed {}
impl<A, H: Source<A>> Marker<A> for Wrapper<A, H> {}
fn consume<A, C: Marker<A>>(value: C) { drop value }
fn fixed<A, C: Marker<A>>(first: A, value: C) { drop first drop value }
fn accepted<A, H: Source<A>>(value: Wrapper<A, H>) { consume(move value) }
fn refused<A, B, H: Source<A>>(first: B, value: Wrapper<A, H>) { fixed(move first, move value) }
fn unresolved() { consume(Unfixed {}) }
"""
  let mut semantic = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let accepted = run Semantic.demandBody(&mut semantic, &mut request, &id, b"accepted")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let refused = run Semantic.demandBody(&mut semantic, &mut request, &id, b"refused")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unresolved = run Semantic.demandBody(&mut semantic, &mut request, &id, b"unresolved")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&accepted), "a nominal constructor infers its rigid caller argument and proves the conditional head from a declared premise")
  run Testing.expect(rejectsSpan(&refused, RejectionCode.MissingConformance, text, "fixed(move first, move value)", usize.ZERO),
    "head inference cannot equate distinct rigid caller arguments fixed by an earlier operand")
  run Testing.expect(rejectsSpan(&unresolved, RejectionCode.Unsupported, text, "consume(Unfixed {})", usize.ZERO),
    "a selected implementation binder the provider did not determine remains unresolved")
  return ()
}

// A selected implementation's Detached premise is proved from the caller's own bound.
// Omitting that bound must fail at the call, including when a nested conformance selects it.
test effect fn selectedHeadProvesDetachedPropertyFromCaller() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("selected-head-detached.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
interface Destination<E> {}
interface Handler<E> {}
struct SinkDestination<E> {}
struct Operation<E, D> { destination: D }
impl<E: Intrinsic.Detached> Destination<E> for SinkDestination<E> {}
impl<E, D: Destination<E>> Handler<E> for Operation<E, D> {}
fn consume<E, H: Handler<E>>(operation: H) { drop operation }
fn accepted<E: Intrinsic.Detached>(operation: Operation<E, SinkDestination<E>>) {
  consume(move operation)
}
fn refused<E>(operation: Operation<E, SinkDestination<E>>) {
  consume(move operation)
}
"""
  let mut semantic = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let accepted = run Semantic.demandBody(&mut semantic, &mut request, &id, b"accepted")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let refused = run Semantic.demandBody(&mut semantic, &mut request, &id, b"refused")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&accepted),
    "nested selected-head Detached premise is satisfied by the caller's declared bound")
  run Testing.expect(rejectsSpan(&refused, RejectionCode.UnsatisfiedExecutableProperty, text,
    "consume(move operation)", usize.ONE),
    "nested selected-head Detached premise without a caller bound is rejected at the call")
  return ()
}

// A provider-selected head substitutes established arguments inside requirement keys before
// deciding closed equality; established access and role identity remain exact.
test effect fn knownHeadNormalizesEstablishedRequirementKeys() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("known-head-requirement-keys.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
enum Acquisition {Rejected}
service Selected<P, ?R> {}
service Clock {}
interface Client<E, ?R> {}
struct Provider<P, ?R> {}
impl<P, ?R> Client<Acquisition, R | &mut Selected<P, R> | &mut Clock> for Provider<P, R> {}
fn consume<E, C: Client<E, &mut Selected<never, never> | &mut Clock>>(client: C) { drop client }
fn shared<E, C: Client<E, &Selected<never, never> | &mut Clock>>(client: C) { drop client }
fn accepted() { consume(Provider<never, never> {}) }
fn refused() { shared(Provider<never, never> {}) }
"""
  let mut semantic = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let accepted = run Semantic.demandBody(&mut semantic, &mut request, &id, b"accepted")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let refused = run Semantic.demandBody(&mut semantic, &mut request, &id, b"refused")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&accepted), "closed service keys use the selected head's established type and row arguments")
  run Testing.expect(rejectsSpan(&refused, RejectionCode.UninferredParameter, text, "shared(Provider<never, never> {})", usize.ZERO),
    "normalizing a requirement key does not change its access")
  return ()
}

// An unfixed outer reference region follows the invariant local referent's region. Evidence from
// an earlier operand remains fixed and cannot be replaced by that later referent.
test effect fn unfixedReferenceRegionFollowsItsInvariantReferent() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("reference-region-referent.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Session<'a> {value: &'a mut i32}
fn callback<'c>(session: &'c mut Session<'c>) -> i32 { return 0 }
fn both<'c>(first: &'c i32, session: &'c mut Session<'c>) -> i32 { return 0 }
fn accepted() -> i32 {
  let mut value = 42
  let mut session = Session {value: &mut value}
  return callback(&mut session)
}
fn refused<'a, 'b>(first: &'a i32, value: Session<'b>) -> i32 {
  let mut session = move value
  return both(first, &mut session)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let accepted = run Semantic.demandBody(&mut store, &mut request, &id, b"accepted") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let refused = run Semantic.demandBody(&mut store, &mut request, &id, b"refused") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&accepted) && hasBorrowStatus(&accepted, BodyBorrowStatus.Checked),
    "an unfixed reference binder takes the invariant referent's region, and the borrow check proves the loan relation")
  run Testing.expect(rejectsSpan(&refused, RejectionCode.TypeMismatch, text, "both(first, &mut session)", usize.ZERO),
    "an earlier operand's fixed binder cannot be replaced by a different invariant referent region")
  return ()
}

// Arithmetic over bare literals takes its type from the other operand on either side, as a bare
// literal does.
test effect fn literalArithmeticOperandAdoptsTheOtherOperandType() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("literal-arithmetic-operand.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
fn leftSum(x: i64) -> bool { return (1 + 2) == x }
fn leftNegated(x: i64) -> bool { return -(2 * 3) < x }
fn rightSum(x: i64) -> bool { return x == (1 + 2) }
fn bothComputed(x: i64) -> bool { return (1 + 2) != x + 1 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let leftSum = run Semantic.demandBody(&mut store, &mut request, &id, b"leftSum") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let leftNegated = run Semantic.demandBody(&mut store, &mut request, &id, b"leftNegated") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let rightSum = run Semantic.demandBody(&mut store, &mut request, &id, b"rightSum") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let bothComputed = run Semantic.demandBody(&mut store, &mut request, &id, b"bothComputed") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&leftSum) && succeeded(&leftNegated),
    "literal arithmetic on the left of a comparison takes the right operand's i64")
  run Testing.expect(succeeded(&rightSum) && succeeded(&bothComputed),
    "literal arithmetic on the right, or beside a computed operand, still checks")
  return ()
}

// A callback environment stores an inferred region covariantly, so independent borrowed
// operands may meet there without changing the callback's invariant input regions.
test effect fn callbackEnvironmentAdmitsIndependentOperandRegions() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("callback-environment-meet.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
service Clock {}
struct Session<'a, P> {value: &'a mut P}
effect<'source & 'destination> fn abandon<'source, 'destination, SP, DP>(
  source: &'source mut Session<'source, SP>, destination: &'destination mut Session<'destination, DP>,
) -> i32 ? &mut Clock { return 42 }
effect fn apply<'env>(source: &'env mut i32, destination: &'env mut i32,
  callback: for<'s, 'd> once fn<'env>(&'s mut Session<'s, i32>, &'d mut Session<'d, i32>)
    -> once Effect<'s & 'd; i32 ? &mut Clock>,
) -> i32 ? &mut Clock { drop source drop destination drop callback return 42 }
effect fn accepted(source: &mut i32, destination: &mut i32) -> i32 ? &mut Clock {
  return run apply(move source, move destination, abandon)
}
effect fn refused<'a, 'b>(source: &'a mut i32, destination: &'b mut i32) -> i32 ? &mut Clock {
  return run apply<'a>(move source, move destination, abandon)
}
"""
  let mut semantic = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let accepted = run Semantic.demandBody(&mut semantic, &mut request, &id, b"accepted")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let refused = run Semantic.demandBody(&mut semantic, &mut request, &id, b"refused")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&accepted), "an inferred region meets independent operands when the callback stores it only in its environment")
  run Testing.expect(rejectsSpan(&refused, RejectionCode.TypeMismatch, text, "apply<'a>(move source, move destination, abandon)", usize.ZERO),
    "an explicit callback environment region remains fixed")
  return ()
}

// Reborrowing a descriptor creates a fresh loan; its source still must outlive that loan.
// The local lifetime inferred for a constructed session can then serve a quantified callback.
test effect fn genericEffectCallbackUsesAFreshDescriptorReborrow() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("generic-descriptor-reborrow.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Session<'a, P> {value: &'a mut P}
effect fn accepted<'env, 'a, P>(value: &'a mut P,
  callback: for<'c> once fn<'env>(&'c mut Session<'c, P>) -> once Effect<'c & 'env; i32>) -> i32 {
  let mut session = Session {value: &mut value.*}
  return run callback(&mut session)
}
fn escaped<'a>(value: &'a mut i32) -> &'static mut i32 { return &mut value.* }
fn strengthened<'a>(value: &'a i32) -> &'a mut i32 { return &mut value.* }
"""
  let mut semantic = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let accepted = run Semantic.demandBody(&mut semantic, &mut request, &id, b"accepted")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let escaped = run Semantic.demandBody(&mut semantic, &mut request, &id, b"escaped")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let strengthened = run Semantic.demandBody(&mut semantic, &mut request, &id, b"strengthened")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&accepted) && hasBorrowStatus(&accepted, BodyBorrowStatus.Checked),
    "a generic effect callback accepts the freshly reborrowed session, and the borrow check proves its descriptor source relation")
  run Testing.expect(rejectsSpan(&escaped, RejectionCode.UnsatisfiedLifetimeBound, text, "&mut value.*", usize.ONE),
    "the fresh loan cannot widen its descriptor's source lifetime to static")
  run Testing.expect(rejectsSpan(&strengthened, RejectionCode.InvalidReborrow, text, "&mut value.*", 2),
    "a fresh reborrow cannot strengthen shared access to mutable access")
  return ()
}

// A generic function value passed to a callable parameter is instantiated by its use: the
// parameters the call already determined select its binders, and its result then infers the rest.
// A selection those parameters reject fails the call rather than leaving its result uninferred.
test effect fn genericFunctionValuesInstantiateFromTheirUse() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("generic-function-values.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Problem { code: i32 }
effect fn guarded<'env, A, B, E, F, ?R, ?S>(self: once Effect<'env; A ! E ? R>, onFailure: once fn<'env>(E) -> once Effect<'env; B ! F ? S>) -> A | B ! F ? R | S {
  return run Intrinsic.catchFailure<E>(move self, move onFailure)
}
effect fn risky(mode: i32) -> i32 ! Problem {
  if mode == 0 { return 10 }
  fail Problem { code: 2 }
}
effect<'env> fn failed<E: 'env, 'env>(error: E) -> i32 {
  drop error
  return 1
}
fn apply<A, B>(value: A, transform: once fn(A) -> B) -> B { return transform(move value) }
fn same<T>(value: T) -> T { return move value }
fn widen<T>(value: T) -> i64 { drop value return 2 }
interface Marker {}
fn marked<T: Marker>(value: T) -> i64 { drop value return 2 }
pub fn main() -> i32 { return run guarded(risky(1), failed) }
fn mapped() -> i32 { return apply(41, same) }
fn widened() -> i64 { return apply(true, widen) }
fn unmarked() -> i64 { return apply(true, marked) }
"""
  let mut store = run applicationSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let handled = run Semantic.demandBody(&mut store, &mut request, &id, b"main") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mapped = run Semantic.demandBody(&mut store, &mut request, &id, b"mapped") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let widened = run Semantic.demandBody(&mut store, &mut request, &id, b"widened") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unmarked = run Semantic.demandBody(&mut store, &mut request, &id, b"unmarked") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&handled) && succeeded(&mapped) && succeeded(&widened),
    "a generic `effect fn` handler and generic plain functions are selected by the parameters their use determined, and their results infer the call")
  run Testing.expect(rejectsSpan(&unmarked, RejectionCode.MissingConformance, text, "marked", 2),
    "a selection whose bound the determined parameter fails rejects the call instead of leaving its result uninferred")
  let mut buildStore = run applicationSemantic(&id, """
struct Problem { code: i32 }
effect fn guarded<'env, A, B, E, F, ?R, ?S>(self: once Effect<'env; A ! E ? R>, onFailure: once fn<'env>(E) -> once Effect<'env; B ! F ? S>) -> A | B ! F ? R | S {
  return run Intrinsic.catchFailure<E>(move self, move onFailure)
}
effect fn risky(mode: i32) -> i32 ! Problem {
  if mode == 0 { return 10 }
  fail Problem { code: 2 }
}
effect<'env> fn failed<E: 'env, 'env>(error: E) -> i32 { drop error return 1 }
pub fn main() -> i32 { return run guarded(risky(1), failed) }
""", MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut buildRequest = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut buildStore, &mut buildRequest, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let emitted = match &built { BackendBuild.Module {..} => true _ => false }
  run Testing.expect(emitted, "the generic handler runs as the instance its use selected")
  return ()
}

// A named Effect callback takes result-only type evidence from the promised success channel,
// while the complete contract still checks failures and absent context supplies no evidence.
test effect fn namedEffectCallbacksInferResultOnlyTypesFromPromisedChannels() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("named-effect-result-inference.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Completed<A, E> { Success { value: A }, Failure { error: E } }
struct Problem { code: i32 }
effect<'env> fn failed<A, E: 'env, 'env>(error: E) -> Completed<A, E> {
  return Completed<A, E>.Failure { error: move error }
}
effect<'env> fn failedWithProblem<A, E: 'env, 'env>(error: E) -> Completed<A, E> ! Problem {
  drop error
  fail Problem { code: 1 }
}
fn consume(handler: once fn<'static>(i32) -> once Effect<'static; Completed<u8, i32>>) -> () {
  drop handler
}
fn accepted() -> () { consume(failed) }
fn wrongFailure() -> () { consume(failedWithProblem) }
fn contextFree() -> () { let callback = failed drop callback }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let accepted = run Semantic.demandBody(&mut store, &mut request, &id, b"accepted") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared<Result<Answer, NoRejection>>.with<bool>(&accepted,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      if let Option<Shared<TypedBody>>.Some {value: body} = move checkedBody(answer) {
        return Shared<TypedBody>.with<bool>(&body, namedEffectCallbackResultEvidence)
      }
      return false
    })
  run Testing.expect(succeeded(&accepted) && selected,
    "the named target selects A=u8 only from promised Effect success and E=i32 from the promised callback input")
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongFailure") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.IncompatibleCallableSignature, text, "failedWithProblem", usize.ONE),
    "learning result-only types does not admit a callback whose failure channel exceeds the promised never")
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"contextFree") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&missing, RejectionCode.SectionResultInferenceUnavailable, text, "failed", 4),
    "a named callback with no promised contract retains the result-only inference gap")
  return ()
}

// A consumer's inferred requirement row cannot discard its determined callback channels.
// Exact wrapper and callback MIR prove that the selected evidence survives realization.
test effect fn namedEffectCallbacksUseKnownChannelsWhileConsumerRowsAreInferred() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("partial-callback-evidence.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = partialCallbackEvidenceFixture()
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let closed = run Semantic.demandBody(&mut store, &mut request, &id, b"closedAccepted") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&closed), "a fully determined callback contract remains admitted")
  let wrapper = run Semantic.demandBody(&mut store, &mut request, &id, b"wrap") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&wrapper),
    "an inferred callback requirement row preserves determined success and input evidence")
  let first = run Semantic.demandMir(&mut store, &mut request, &id, b"accepted8") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Semantic.demandMir(&mut store, &mut request, &id, b"accepted16") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let firstSelected = run partialCallbackMirChain(&mut store, &mut request, &first, b"u8") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let secondSelected = run partialCallbackMirChain(&mut store, &mut request, &second, b"u16") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&first) && succeeded(&second) && firstSelected && secondSelected,
    "independent wrapper instances retain original callback A=u8/u16 and E=i32, infer S empty, and demand their concrete callback MIR")
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongFailure") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.EffectFormUnavailable, text, "dispatch<u8>(1, failedWithProblem)", usize.ZERO),
    "partial callback evidence preserves the open-row refusal for a failure channel exceeding the consumer's never")
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"contextFree") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unresolved = run Semantic.demandBody(&mut store, &mut request, &id, b"unresolvedSuccess") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&missing, RejectionCode.SectionResultInferenceUnavailable, text, "failed", 5)
    && rejectsSpan(&unresolved, RejectionCode.SectionResultInferenceUnavailable, text, "failed", 6),
    "absent context and an unresolved consumer success cannot select the callback's result-only type")
  let required = run Semantic.demandBody(&mut store, &mut request, &id, b"required") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let application = run directApplicationAt(&required, usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedClock = match &application {
    Option<SpecializationApplication>.Some {value} => partialCallbackClockRow(&value)
    _ => false
  }
  run Testing.expect(succeeded(&required) && selectedClock,
    "the actual callback's shared Clock requirement infers consumer S instead of defaulting it to empty")
  let closedRow = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongRequirements") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&closedRow, RejectionCode.IncompatibleCallableSignature, text, "needsClock", 2),
    "a fixed empty consumer row still rejects the callback's actual Clock requirement")
  let quantified = run Semantic.demandBody(&mut store, &mut request, &id, b"quantifiedAccepted") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&quantified),
    "a binder-free callback infers the channels of a promise quantified over its invocation")
  let invoked = run Semantic.demandBody(&mut store, &mut request, &id, b"invokeQuantified") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let invokedConcrete = run Semantic.demandBody(&mut store, &mut request, &id, b"invokedQuantified") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&invoked) && succeeded(&invokedConcrete),
    "an invocation whose inputs carry no region supplies its own extent for the marked binder")
  return ()
}

fn partialCallbackEvidenceFixture() -> string<'static> {
  return """
union Completed<A, E> { Success { value: A }, Failure { error: E } }
struct Problem { code: i32 }
service Clock {}
effect<'env> fn failed<A, E: 'env, 'env>(error: E) -> Completed<A, E> {
  return Completed<A, E>.Failure { error: move error }
}
effect<'env> fn failedWithProblem<A, E: 'env, 'env>(error: E) -> Completed<A, E> ! Problem {
  drop error
  fail Problem { code: 1 }
}
effect<'env> fn needsClock<A, E: 'env, 'env>(error: E) -> Completed<A, E> ? &Clock {
  return Completed<A, E>.Failure { error: move error }
}
effect fn dispatch<A, ?S>(error: i32,
  handler: once fn<'static>(i32) -> once Effect<'static; Completed<A, i32> ? S>) -> Completed<A, i32> ? S {
  return run handler(error)
}
effect fn wrap<A>(error: i32) -> Completed<A, i32> {
  return run dispatch<A>(error, failed)
}
fn closed(handler: once fn<'static>(i32) -> once Effect<'static; Completed<u8, i32>>) -> () { drop handler }
fn closedAccepted() -> () { closed(failed) }
fn accepted8() -> Completed<u8, i32> { return run wrap<u8>(1) }
fn accepted16() -> Completed<u16, i32> { return run wrap<u16>(2) }
fn wrongFailure() -> () { let pending = dispatch<u8>(1, failedWithProblem) drop pending }
fn contextFree() -> () { let callback = failed drop callback }
fn unresolvedSuccess() -> () { let pending = dispatch(1, failed) drop pending }
effect fn required() -> Completed<u8, i32> ? &Clock { return run dispatch<u8>(1, needsClock) }
fn wrongRequirements() -> () { closed(needsClock) }
fn quantified<B, ?S>(handler: for<use 'call> once fn<'static>(i32) -> once Effect<'call; B ? S>) -> () { drop handler }
effect fn concrete(error: i32) -> u8 { return 1 }
fn quantifiedAccepted() -> () { quantified(concrete) }
effect fn invokeQuantified<B, ?S>(handler: for<use 'call> once fn<'static>(i32) -> once Effect<'call; B ? S>) -> B ? S {
  return run handler(1)
}
fn invokedQuantified() -> u8 { return run invokeQuantified(concrete) }
"""
}

effect fn partialCallbackMirChain(store: &mut Semantic, request: &mut Request,
  caller: &Shared<Result<Answer, NoRejection>>, primitive: &[u8]) -> bool
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let wrapper = match move namedMirApplication(&store.*, caller, b"wrap") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  if !partialCallbackApplication(&wrapper, b"wrap", primitive, false, false) { return false }
  let wrapped = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &wrapper)
  if !partialCallbackConcreteMir(&store.*, &wrapped, primitive) { return false }
  let consumer = match move namedMirApplication(&store.*, &wrapped, b"dispatch") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  if !partialCallbackApplication(&consumer, b"dispatch", primitive, true, false) { return false }
  let consumed = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &consumer)
  if !partialCallbackConcreteMir(&store.*, &consumed, primitive) { return false }
  let callback = match move namedMirApplication(&store.*, &consumed, b"failed") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  if !partialCallbackApplication(&callback, b"failed", primitive, false, true) { return false }
  let invoked = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &callback)
  return partialCallbackConcreteMir(&store.*, &invoked, primitive)
}

fn partialCallbackApplication(value: &SpecializationApplication, target: &[u8], primitive: &[u8],
  consumer: bool, callback: bool) -> bool {
  if !DeclarationId.named(SpecializationApplication.bodyDeclaration(value), target) { return false }
  let arguments = List<Argument>.asSlice(&value.arguments)
  let ordinals = List<usize>.asSlice(&value.argumentOrdinals)
  if arguments.length != ordinals.length { return false }
  let mut result = false
  let mut other = !consumer && !callback
  let mut at = usize.ZERO
  while at < arguments.length {
    if ordinals[at] == usize.ZERO { result = genericSectionArgument(&arguments[at], primitive) }
    if ordinals[at] == usize.ONE {
      if callback { other = genericSectionArgument(&arguments[at], b"i32") }
      if consumer {
        if let Argument.Row {value: row} = &arguments[at] {
          other = Shared<Row>.with<bool>(&row, fn(value: &Row) -> bool {
            return List<Requirement>.length(&value.entries) == usize.ZERO && List.length(&value.parameters) == usize.ZERO
              && List.length(&value.subtractions) == usize.ZERO
          })
        }
      }
    }
    at = at + usize.ONE
  }
  return result && other
}

fn partialCallbackConcreteMir(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, primitive: &[u8]) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let providers = match move InstanceKey.providers(&function.key) {
        Option<Shared<List<ProviderEntry>>>.Some {value} => Shared<List<ProviderEntry>>.with<usize>(&value,
          fn(entries: &List<ProviderEntry>) -> usize { return List<ProviderEntry>.length(entries) })
        _ => usize.MAX
      }
      if providers != usize.ZERO { return false }
      return Shared<Type>.with<bool>(&function.result, fn(value: &Type) -> bool {
        if let Type.Nominal {declaration, arguments, ..} = &value.* {
          let supplied = List<Argument>.asSlice(&arguments)
          return DeclarationId.named(&declaration, b"Completed") && supplied.length == 2
            && genericSectionArgument(&supplied[usize.ZERO], primitive) && genericSectionArgument(&supplied[usize.ONE], b"i32")
        }
        return false
      })
    }
  }
  return false
}

fn partialCallbackClockRow(value: &SpecializationApplication) -> bool {
  if !DeclarationId.named(SpecializationApplication.bodyDeclaration(value), b"dispatch") { return false }
  let arguments = List<Argument>.asSlice(&value.arguments)
  let ordinals = List<usize>.asSlice(&value.argumentOrdinals)
  if arguments.length != ordinals.length { return false }
  let mut at = usize.ZERO
  while at < arguments.length {
    if ordinals[at] == usize.ONE {
      if let Argument.Row {value: row} = &arguments[at] {
        return Shared<Row>.with<bool>(&row, fn(value: &Row) -> bool {
          let entries = List<Requirement>.asSlice(&value.entries)
          if entries.length != usize.ONE || List.length(&value.parameters) != usize.ZERO
            || List.length(&value.subtractions) != usize.ZERO || entries[usize.ZERO].access != Access.Shared { return false }
          if let Option<Shared<Type>>.Some {..} = &entries[usize.ZERO].roleType { return false }
          return Shared<Type>.with<bool>(&entries[usize.ZERO].capability, partialCallbackClockCapability)
        })
      }
      return false
    }
    at = at + usize.ONE
  }
  return false
}

fn partialCallbackClockCapability(capability: &Type) -> bool {
  return match &capability.* {
    Type.Nominal {declaration, arguments, ..} => DeclarationId.named(&declaration, b"Clock") && List<Argument>.length(&arguments) == usize.ZERO
    _ => false
  }
}

fn namedEffectCallbackResultEvidence(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, ..} = &nodes[at].kind {
      let selected = Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool {
        if let Type.CallableValue {application, ..} = &value.* {
          return Shared<SpecializationApplication>.with<bool>(&application, namedEffectCallbackResultArguments)
        }
        return false
      })
      if selected { return true }
    }
    at = at + usize.ONE
  }
  return false
}

fn namedEffectCallbackResultArguments(value: &SpecializationApplication) -> bool {
  if !DeclarationId.named(SpecializationApplication.bodyDeclaration(value), b"failed") { return false }
  let arguments = List<Argument>.asSlice(&value.arguments)
  let ordinals = List<usize>.asSlice(&value.argumentOrdinals)
  if arguments.length != ordinals.length { return false }
  let mut result = false
  let mut input = false
  let mut at = usize.ZERO
  while at < arguments.length {
    if ordinals[at] == usize.ZERO { result = genericSectionArgument(&arguments[at], b"u8") }
    if ordinals[at] == usize.ONE { input = genericSectionArgument(&arguments[at], b"i32") }
    at = at + usize.ONE
  }
  return result && input
}

// A lifetime binder only the result mentions is chosen by the call's use: the expected result fixes
// it, and without one the result is valid for 'static, which then infers the enclosing call.
test effect fn resultOnlyLifetimeBindersFollowTheirUse() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("result-only-lifetimes.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Policy<'names> { Default, Explicit { names: &'names [i32] } }
impl<'names> Intrinsic.Copy for Policy<'names> {}
impl<'names> Policy<'names> {
  fn defaultPolicy() -> Policy<'names> { return Policy<'names>.Default }
}
struct Context<'names> { policy: Policy<'names> }
impl<'names> Context<'names> {
  fn make(policy: Policy<'names>) -> Context<'names> { return Context<'names> {policy: policy} }
}
fn nested() -> i32 {
  let context = Context.make(Policy.defaultPolicy())
  drop context
  return 0
}
fn expected<'a>(names: &'a [i32]) -> Policy<'a> { return Policy.defaultPolicy() }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let expected = run Semantic.demandBody(&mut store, &mut request, &id, b"expected") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let defaulted = run directApplicationAt(&nested, usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let contextual = run directApplicationAt(&expected, usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&nested) && scopeLifetimeIs(&defaulted, false),
    "without an expected result, a result-only lifetime binder is 'static and the enclosing call infers from it")
  run Testing.expect(succeeded(&expected) && scopeLifetimeIs(&contextual, true),
    "the expected result fixes a result-only lifetime binder")
  return ()
}

// Whether a direct call's single scope argument is 'static, or else a declared lifetime parameter.
fn scopeLifetimeIs(application: &Option<SpecializationApplication>, parameter: bool) -> bool {
  if let Option<SpecializationApplication>.Some {value} = &application.* {
    let scopes = List<ScopeBinding>.asSlice(&value.scopes)
    if scopes.length == usize.ONE {
      let arguments = List<Argument>.asSlice(&scopes[usize.ZERO].arguments)
      if arguments.length == usize.ONE {
        if let Argument.Lifetime {value: region} = &arguments[usize.ZERO] {
          return Shared<Lifetime>.with<bool>(&region, fn(lifetime: &Lifetime) -> bool {
            return match &lifetime.* {
              Lifetime.Static => !parameter
              Lifetime.Parameter {..} => parameter
              _ => false
            }
          })
        }
      }
    }
  }
  return false
}

// Providers (Effect note D2): an instance receives its row's providers in canonical key order, a
// binding serves its key to the enclosed run only, and a service operation calls the witness for
// the serving provider's type with that provider's address as its receiver.
test effect fn providersServeRowsInKeyOrder() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("providers.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
role Left
role Right
service Values {
  effect fn left() -> i32 ? &Values at Left
  effect fn right() -> i32 ? &Values at Right
}
struct Fixed { value: i32 }
effect fn left(self: &Fixed) -> i32 { return self.value }
effect fn right(self: &Fixed) -> i32 { return self.value }
impl Values for Fixed { left: Fixed.left right: Fixed.right }
effect fn total() -> i32 ? &Values at Right | &Values at Left {
  let leftValue = run Values.left()
  let pending = Values.right()
  let rightValue = run pending
  return leftValue * 10 + rightValue
}
fn both() -> i32 {
  let leftProvider = Fixed { value: 4 }
  let rightProvider = Fixed { value: 2 }
  return run Intrinsic.bindRequirement<Values at Right>(Intrinsic.bindRequirement<Values at Left>(total(), &leftProvider), &rightProvider)
}
fn partial() -> i32 {
  let provider = Fixed { value: 1 }
  return run Intrinsic.bindRequirement<Values at Left>(total(), &provider)
}
fn wrongShape() -> i32 {
  let shapeProvider = Fixed { value: 1 }
  return run Intrinsic.bindRequirementMut<Values at Left>(total(), &shapeProvider)
}
interface Present { effect fn present(value: &Self) -> i32 }
impl Present for i32 { effect fn present(value: &Self) -> i32 { return 1 } }
effect fn presented(value: &i32) -> i32 { return run Present.present(value) }
effect fn pendingPresent(value: &i32) -> i32 {
  let pending = Present.present(value)
  return run pending
}
struct Held<A> { count: i32 }
service Store { effect fn hold<A>() -> Held<A> ? &Store }
struct Keeper { count: i32 }
effect fn keep<A>(self: &Keeper) -> Held<A> { return Held<A> { count: self.count } }
impl Store for Keeper { hold: Keeper.keep }
effect fn held() -> i32 ? &Store {
  let slot = run Store.hold<bool>()
  return slot.count
}
fn kept() -> i32 {
  let keeper = Keeper { count: 3 }
  return run Intrinsic.bindRequirement<Store>(held(), &keeper)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let both = run Semantic.demandMir(&mut store, &mut request, &id, b"both") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let called = providedCallee(&store, &both, "total")
  run Testing.expect(boundProvidersByDepth(&store, &both),
    "each binding serves its key to the enclosed run, the inner binding from deeper in the stored composite, in callee key order")
  if let Option<InstanceKey>.Some {value: key} = move called {
    let total = run sourceCallMir(&mut store, &mut request, &both, &key, usize.ZERO, false) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(dispatchesOwnProvider(&store, &total, &key, "left", "Left") && dispatchesOwnProvider(&store, &total, &key, "right", "Right"),
      "a service operation, run directly or stored first, calls its witness with the provider local of its own key as the receiver")
  } else {
    run Testing.expect(false, "running the bound composite calls total with its providers in its key")
  }
  let partial = run Semantic.demandBody(&mut store, &mut request, &id, b"partial") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&partial, RejectionCode.UnhandledRequirement, text,
    "run Intrinsic.bindRequirement<Values at Left>(total(), &provider)", 0),
    "a binding removes only its selected key; the rest of the row must still be covered")
  let wrongShape = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongShape") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&wrongShape, RejectionCode.TypeMismatch, text, "&shapeProvider", 0),
    "an exclusive binding takes an exclusive provider loan")
  let presented = run Semantic.demandMir(&mut store, &mut request, &id, b"presented") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let pendingPresent = run Semantic.demandMir(&mut store, &mut request, &id, b"pendingPresent") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let presentedWitness = mirWitnessReference(&store, Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&presented, selectedMirIndex))
  let ranWitness = match &presentedWitness { Option<InstanceKey>.Some {..} => true Option<InstanceKey>.None => false }
  run Testing.expect(ranWitness && succeeded(&pendingPresent),
    "running an effect fn through an interface calls its witness in place; a stored construction runs through the witness's Effect")
  let kept = run Semantic.demandMir(&mut store, &mut request, &id, b"kept") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut closedWitness = false
  if let Option<InstanceKey>.Some {value: heldKey} = move providedCallee(&store, &kept, "held") {
    let held = run sourceCallMir(&mut store, &mut request, &kept, &heldKey, usize.ZERO, false) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
    if let Option<InstanceKey>.Some {value: witnessKey} = move providedCallee(&store, &held, "keep") {
      let application = run InstanceKey.selected(&witnessKey) |> Effect.provideMut<Allocator>(&mut allocator)
      // The receiver loan adds a lifetime argument; the one type argument is the call's.
      let arguments = List<Argument>.asSlice(&application.arguments)
      let mut witnessTypes = usize.ZERO
      let mut witnessClosed = true
      let mut argumentAt = usize.ZERO
      while argumentAt < arguments.length {
        if let Argument.Type {value} = &arguments[argumentAt] {
          witnessTypes = witnessTypes + usize.ONE
          witnessClosed = witnessClosed && Shared<Type>.with<bool>(&value, isBool)
        }
        argumentAt = argumentAt + usize.ONE
      }
      closedWitness = witnessClosed && witnessTypes == usize.ONE
    }
  }
  run Testing.expect(closedWitness,
    "a generic service operation's witness takes the call's type arguments, not the operation's own binders")
  return ()
}

// INTF-006 with INTF-005: an unapplied qualified call takes the one application its provider's
// conformances supply, including an `effect fn` operation's failure and row binders, and a `run`
// executes it as one call of the selected witness.
test effect fn qualifiedEffectCallsInferTheirApplication() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run qualifiedEffectCallClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn qualifiedEffectCallClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("qualified-effect-calls.silk")
  let text = """
interface Source<A, E, ?R> { effect fn take(self: &mut Self) -> A ! E ? R }
struct Counter { count: i32 }
impl Source<i32, never ? never> for Counter {
  effect fn take(self: &mut Self) -> i32 {
    self.count = self.count - 1
    return self.count
  }
}
struct Twice {}
impl Source<i32, never ? never> for Twice { effect fn take(self: &mut Self) -> i32 { return 1 } }
impl Source<bool, never ? never> for Twice { effect fn take(self: &mut Self) -> bool { return true } }
struct Empty {}
effect fn drain(counter: &mut Counter) -> i32 { return run Source.take(&mut counter) }
effect fn ambiguous(twice: &mut Twice) -> i32 { return run Source.take(&mut twice) }
effect fn missing(empty: &mut Empty) -> i32 { return run Source.take(&mut empty) }
effect fn stored(counter: &mut Counter) -> i32 {
  let pending = Source.take(&mut counter)
  return 0
}
interface Reader<A, E, ?R> { effect fn read(self: &Self) -> A ! E ? R }
impl Reader<i32, never ? never> for Counter { effect fn read(self: &Self) -> i32 { return self.count } }
fn handed(counter: &Counter) -> Effect<i32> { return Reader.read(counter) }
fn deferred<T: Reader<i32, never ? never>>(source: &T) -> Effect<i32> { return Reader.read(source) }
effect fn later(counter: &Counter) -> i32 { return run deferred<Counter>(counter) }
struct Problem { code: i32 }
struct Faulty { count: i32 }
impl Source<i32, Problem ? never> for Faulty {
  effect fn take(self: &mut Self) -> i32 ! Problem {
    if self.count == 0 { fail Problem { code: 1 } }
    return self.count
  }
}
struct Calm {}
impl Source<i32, Problem ? never> for Calm { effect fn take(self: &mut Self) -> i32 { return 0 } }
effect fn propagated(faulty: &mut Faulty) -> i32 ! Problem { return run Source.take(&mut faulty) }
effect fn unhandled(loose: &mut Faulty) -> i32 { return run Source.take(&mut loose) }
effect fn narrower(calm: &mut Calm) -> i32 ! Problem { return run Source.take(&mut calm) }
union Maybe<T> { None, Some { value: T } }
interface Stream<A, E, ?R> { effect fn next(self: &mut Self) -> Maybe<A> ! E ? R }
struct Tally { count: i32 }
impl Tally { effect fn bump(self: &mut Self) -> i32 { self.count = self.count + 1 return self.count } }
effect fn bumped(tally: &mut Tally) -> i32 { return run tally.bump() }
effect fn received(counter: &mut Counter) -> i32 { return run counter.take() }
struct Countdown<A> { value: A, remaining: usize }
impl<A: Intrinsic.Copy> Stream<A, never ? never> for Countdown<A> {
  effect fn next(self: &mut Self) -> Maybe<A> {
    if self.remaining == 0 { return Maybe<A>.None }
    self.remaining = self.remaining - 1
    return Maybe<A>.Some { value: self.value }
  }
}
effect fn counted(stream: &mut Countdown<i32>) -> i32 {
  let taken = run stream.next()
  return match move taken { Maybe<i32>.Some { value } => value Maybe<i32>.None => 0 }
}
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let mut store = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.make()
  let sourceId = run requireIndexedIdentity(&mut index, &id, OwnerKind.Interface, b"Source", usize.ZERO)
  let operation = run signatureNamed(&mut store, &mut request, &mut index, &id, b"take", usize.ZERO)
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&operation, failureOf)
  let requirements = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Row>>>(&operation, signatureRequirements)
  let errorParameter = run specializationParameter(&sourceId, usize.ONE)
  let mut rowParameter = Row.empty()
  run Row.include(&mut rowParameter, RowParameter {declaration: run Shared<DeclarationId>.make(DeclarationId.copy(&sourceId)), ordinal: 2})
  let expectedRow = run Shared<Row>.make(move rowParameter)
  let mut binders = false
  if let Option<Shared<Type>>.Some {value: declaredFailure} = move failure {
    if let Option<Shared<Row>>.Some {value: declaredRow} = move requirements {
      let failureMatches = run Type.equalsShared(&declaredFailure, &errorParameter)
      let rowMatches = run Row.equalsShared(&declaredRow, &expectedRow)
      binders = failureMatches && rowMatches
    }
  }
  run Testing.expect(binders, "an interface operation's signature fails with its interface's E and requires its ?R row")
  let next = run signatureNamed(&mut store, &mut request, &mut index, &id, b"next", usize.ZERO)
  run Testing.expect(succeeded(&next), "an operation returning a generic union of its interface's binder resolves (the Stream.take shape)")
  let heads = run Semantic.demandImplementations(&mut store, &mut request, &id)
  let drained = run Semantic.demandBody(&mut store, &mut request, &id, b"drain")
  let mut selected = false
  let called = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&drained, effectWitnessContract)
  let written = contractOf(&headAt(&heads, usize.ZERO))
  if let Option<Shared<Type>>.Some {value: inferred} = move called {
    if let Option<Shared<Type>>.Some {value: declared} = move written {
      selected = run Type.equalsShared(&inferred, &declared)
    }
  }
  run Testing.expect(selected, "the provider's one conformance supplies the application and selects its witness")
  let lowered = run Semantic.demandMir(&mut store, &mut request, &id, b"drain")
  let mut witnessed = false
  let reference = mirWitnessReference(&store, Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&lowered, selectedMirIndex))
  if let Option<InstanceKey>.Some {value: key} = move reference {
    let application = run InstanceKey.selected(&key)
    witnessed = DeclarationId.named(SpecializationApplication.bodyDeclaration(&application), b"take")
  }
  run Testing.expect(witnessed, "running the operation calls the selected witness in place")
  let ambiguous = run Semantic.demandBody(&mut store, &mut request, &id, b"ambiguous")
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missing")
  let stored = run Semantic.demandBody(&mut store, &mut request, &id, b"stored")
  let handed = run Semantic.demandBody(&mut store, &mut request, &id, b"handed")
  run Testing.expect(rejectsSpan(&ambiguous, RejectionCode.AmbiguousSuppliedOperation, text, "Source.take(&mut twice)", 0)
    && rejectsSpan(&missing, RejectionCode.MissingConformance, text, "Source.take(&mut empty)", 0),
    "several applications are ambiguous and none is missing")
  run Testing.expect(succeeded(&stored), "a bound construction that no run executes in place is the selected witness's Effect")
  let bumped = run Semantic.demandBody(&mut store, &mut request, &id, b"bumped")
  let receivedBody = run Semantic.demandBody(&mut store, &mut request, &id, b"received")
  let received = run Semantic.demandMir(&mut store, &mut request, &id, b"received")
  let counted = run Semantic.demandMir(&mut store, &mut request, &id, b"counted")
  let mut sameWitness = false
  let receivedContract = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&receivedBody, effectWitnessContract)
  let drainedContract = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&drained, effectWitnessContract)
  if let Option<Shared<Type>>.Some {value: receiverSide} = move receivedContract {
    if let Option<Shared<Type>>.Some {value: qualifiedSide} = move drainedContract {
      sameWitness = run Type.equalsShared(&receiverSide, &qualifiedSide)
    }
  }
  let receivedWitness = run witnessCalled(&store, &received, b"take")
  let countedWitness = run witnessCalled(&store, &counted, b"next")
  run Testing.expect(succeeded(&bumped) && sameWitness && receivedWitness && countedWitness,
    "an interface effect operation called on its receiver constructs the qualified call's witness Effect, through a Copy-bounded generic implementation too")
  let deferred = run Semantic.demandBody(&mut store, &mut request, &id, b"deferred")
  let later = run Semantic.demandMir(&mut store, &mut request, &id, b"later")
  run Testing.expect(succeeded(&handed) && succeeded(&deferred) && succeeded(&later),
    "a returned construction realizes its Effect family, through a generic bound once the provider is concrete")
  let propagated = run Semantic.demandMir(&mut store, &mut request, &id, b"propagated")
  let unhandled = run Semantic.demandBody(&mut store, &mut request, &id, b"unhandled")
  run Testing.expect(failureFact(&store, &propagated, 2) == usize.ONE
    && rejectsSpan(&unhandled, RejectionCode.UnhandledFailure, text, "run Source.take(&mut loose)", 0),
    "the interface's failure reaches the caller: the witness call has a failure edge and an uncovered run is unhandled")
  let narrower = run Semantic.demandMir(&mut store, &mut request, &id, b"narrower")
  run Testing.expect(succeeded(&narrower) && callFailureEdge(&store, &narrower, "take") == usize.ZERO,
    "a witness declaring a smaller failure than the promised one is called with its own: never has no failure edge")
  return ()
}

// Running the lowered body's interface Effect calls the named witness in place.
effect fn witnessCalled(store: &Semantic, lowered: &Shared<Result<Answer, NoRejection>>, name: &[u8]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(lowered, selectedMirIndex)
  if let Option<usize>.Some {value: at} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, at) {
      let references = List<MirReference>.asSlice(&function.references)
      let mut index = usize.ZERO
      while index < references.length {
        let witness = match &references[index].edge { SpecializationEdge.Witness => true _ => false }
        if witness {
          let application = run InstanceKey.selected(&references[index].key)
          if DeclarationId.named(SpecializationApplication.bodyDeclaration(&application), name) { return true }
        }
        index = index + usize.ONE
      }
    }
  }
  return false
}

// The application of the first `effect fn` interface call in a checked body with a selected witness.
fn effectWitnessContract(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedBody(answer) {
    return Shared<TypedBody>.with<Option<Shared<Type>>>(&body, fn(typed: &TypedBody) -> Option<Shared<Type>> {
      let nodes = TypedBody.nodeSlice(typed)
      let mut at = usize.ZERO
      while at < nodes.length {
        if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {contract, implementation, isEffect, ..}, ..} = &nodes[at].kind {
          let witnessed = match &implementation { Option<Shared<DeclarationId>>.Some {..} => true Option<Shared<DeclarationId>>.None => false }
          if isEffect && witnessed { return Option<Shared<Type>>.some(Shared<Type>.clone(&contract)) }
        }
        at = at + usize.ONE
      }
      return Option<Shared<Type>>.none()
    })
  }
  return Option<Shared<Type>>.none()
}

// REP-001: an Effect argument is both a stored field and its callee's exact representation
// binder. The field reads its identity from that binder, so nested Effect values grow linearly.
test effect fn nestedEffectArgumentsShareTheirRepresentation() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run nestedEffectArgumentClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nestedEffectArgumentClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("nested-effect-arguments.silk")
  let text = """
effect fn wrap<'env, A, ?R>(inner: once Effect<'env; A ? R>) -> A ? R { return run move inner }
effect fn leaf() -> i32 { return 1 }
pub fn deep() -> i32 {
  return run wrap(wrap(wrap(wrap(wrap(wrap(wrap(wrap(wrap(wrap(wrap(wrap(leaf()))))))))))))
}
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut store = Semantic.make(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.make()
  let typed = run Semantic.demandBody(&mut store, &mut request, &id, b"deep")
  let mut represented = false
  let checked = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&typed, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: body} = move checked {
    represented = Shared<TypedBody>.with<bool>(&body, storesRepresentedEffect)
  }
  run Testing.expect(represented, "a stored Effect argument is marked as its callee's representation slot")
  let lowered = run Semantic.demandMir(&mut store, &mut request, &id, b"deep")
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&lowered, selectedMirIndex)
  let prepared = match move selected {
    Option<usize>.Some {..} => true
    Option<usize>.None => false
  }
  run Testing.expect(prepared, "twelve nested Effect values keep a canonical instance key and prepare MIR")
  return ()
}

