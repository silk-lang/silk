effect fn enclosingRegionRelationClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("enclosing-region-relations.silk")
  let text = """
fn inspect(value: &i32) -> i32 { return value.* }
fn apply(use: fn() -> i32) -> i32 { return use() }
struct Holder<'a> { value: &'a i32 }
impl<'a> Holder<'a> {
  fn read(self: &Self) -> i32 { return inspect(&self.value.*) }
}
service Reader { effect fn load() -> i32 ? &Reader }
impl<'a> Reader for Holder<'a> {
  effect fn load(self: &Self) -> i32 { return inspect(&self.value.*) }
}
fn bound<'a, 'b: 'a>(value: &'b i32) -> &'a i32 { return value }
fn stored<'a, 'b: 'a>(anchor: &'a i32, value: &'b i32) -> i32 {
  let read = fn() -> i32 { return inspect(&value.*) + bound<'a, 'b>(value).* }
  return read() + anchor.*
}
fn inline<'a>(value: &'a i32) -> i32 {
  return apply(fn() -> i32 { return inspect(&value.*) })
}
effect fn effectful<'a>(value: &'a i32) -> i32 {
  let read = effect fn() -> i32 { return inspect(&value.*) }
  return run read()
}
effect fn block<'a>(value: &'a i32) -> i32 {
  return run effect { return inspect(&value.*) }
}
fn unrelated<'a, 'b>(anchor: &'a i32, value: &'b i32) -> i32 {
  let read = fn() -> &'a i32 { return value }
  return read().* + anchor.*
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let source = run present(text)
  let mut index = SourceIndex.make(run Revision.publish(&Revision.make(), &id, &source))
  let readId = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"read", usize.ZERO)
  let method = run Semantic.demandBodyOf(&mut store, &mut request, &readId)
  let loadId = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"load", usize.ONE)
  let provider = run Semantic.demandBodyOf(&mut store, &mut request, &loadId)
  let stored = run Semantic.demandBody(&mut store, &mut request, &id, b"stored")
  let inline = run Semantic.demandBody(&mut store, &mut request, &id, b"inline")
  let effectful = run Semantic.demandBody(&mut store, &mut request, &id, b"effectful")
  let block = run Semantic.demandBody(&mut store, &mut request, &id, b"block")
  let unrelated = run Semantic.demandBody(&mut store, &mut request, &id, b"unrelated")
  run Testing.expect(hasBorrowStatus(&method, BodyBorrowStatus.Checked),
    "an impl parameter bounds a method's loan under the impl's declared premises")
  run Testing.expect(hasBorrowStatus(&provider, BodyBorrowStatus.Checked),
    "a provider body proves its loans under the implementation's lifetime premises")
  run Testing.expect(anonymousStatus(&stored, BodyBorrowStatus.Checked),
    "a stored anonymous callable retains its enclosing lifetime atoms and declared relation")
  run Testing.expect(anonymousStatus(&inline, BodyBorrowStatus.Checked),
    "an inline anonymous callable uses the same enclosing universal domain")
  run Testing.expect(anonymousStatus(&effectful, BodyBorrowStatus.Checked),
    "an effectful anonymous callable proves its local loans under enclosing premises")
  run Testing.expect(anonymousStatus(&block, BodyBorrowStatus.Checked),
    "an Effect block proves its local loans under enclosing premises")
  run Testing.expect(!hasBorrowStatus(&unrelated, BodyBorrowStatus.Checked),
    "enclosing lifetime atoms remain distinct without a declared relation")
  return ()
}

