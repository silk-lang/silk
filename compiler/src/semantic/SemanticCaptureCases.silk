effect fn sharedLoanRegionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("shared-loan-regions.silk")
  let text = """
struct Token {
  value: i32
}
fn put(buffer: &mut i32, cursor: &mut i32, value: i32) -> () { buffer.* = value cursor.* = cursor.* + 1 }
fn putTwo(buffer: &mut i32, cursor: &mut i32) -> () {
  put(&mut buffer.*, &mut cursor.*, 1)
  put(&mut buffer.*, &mut cursor.*, 2)
}
fn pick<'x>(left: &'x i32, right: &'x i32) -> i32 { return left.* + right.* }
fn sharedLocal(source: &i32) -> i32 { let local = 1 return pick(&source.*, &local) }
fn heldAcrossBackEdge(count: i32) -> i32 {
  let first = 1
  let second = 2
  let view = &first
  let mut at = 0
  let mut sum = 0
  while at < count {
    sum = sum + pick(&view.*, &second)
    at = at + 1
  }
  return sum
}
fn constrain<'a, 'x: 'a>(anchor: &'a i32, left: &'x i32, right: &'x i32) -> i32 { return anchor.* }
fn outlived<'a>(source: &'a i32) -> i32 { let local = 1 return constrain(source, &source.*, &local) }
fn innerWritten() -> i32 {
  let mut a = 1
  let view = &a
  let first = &view
  let second = &view
  a = 2
  return first.*.* + second.*.*
}
fn innerMoved() -> i32 {
  let token = Token {value: 1}
  let view = &token
  let first = &view
  let second = &view
  let taken = move token
  return first.*.value + second.*.value + taken.value
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let putTwo = run Semantic.demandBody(&mut store, &mut request, &id, b"putTwo")
  let sharedLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedLocal")
  let heldAcrossBackEdge = run Semantic.demandBody(&mut store, &mut request, &id, b"heldAcrossBackEdge")
  let outlived = run Semantic.demandBody(&mut store, &mut request, &id, b"outlived")
  let innerWritten = run Semantic.demandBody(&mut store, &mut request, &id, b"innerWritten")
  let innerMoved = run Semantic.demandBody(&mut store, &mut request, &id, b"innerMoved")
  run Testing.expect(hasBorrowStatus(&putTwo, BodyBorrowStatus.Checked),
    "one call's argument reborrows share its region; each parameter outlives their united requirement")
  run Testing.expect(hasBorrowStatus(&sharedLocal, BodyBorrowStatus.Checked),
    "a call region shared by a parameter reborrow and a local borrow is required only where its loans are")
  run Testing.expect(hasBorrowStatus(&heldAcrossBackEdge, BodyBorrowStatus.Checked),
    "a holder live across a back edge can supply repeated shared-region calls while its local storage remains available")
  run Testing.expect(hasBorrowStatus(&outlived, BodyBorrowStatus.Regions),
    "a shared region bound to outlive a parameter is available only where every loan of it is, so a local's loan keeps it pending")
  run Testing.expect(rejectsSpan(&innerWritten, RejectionCode.AccessDuringLoan, text, "a", 25),
    "two loans whose inner regions share an atom still conflict with a write of the borrowed place (OWN0011)")
  run Testing.expect(rejectsSpan(&innerMoved, RejectionCode.AccessDuringLoan, text, "token", 2),
    "two loans whose inner regions share an atom still conflict with a move of the borrowed place (OWN0011)")
  return ()
}

