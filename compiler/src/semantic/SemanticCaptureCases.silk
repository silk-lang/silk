impl<T> Box<T> {
  fn or(self: Self, other: T) -> T { return move self.value }
}
fn boxed<'a>(doc: &'a Doc) -> Box<string<'a>> { return Box<string<'a>> {value: doc.text} }
pub fn piped() -> i32 {
  let document = Doc {text: "x"}
  let name = boxed(&document) |> Box<string>.or("")
  if name != "x" { return 1 }
  return 0
}
"""
