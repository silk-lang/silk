    |> Effect.provideMut<Allocator>(&mut allocator)
}

// ASSIGN-002 observes the old value after evaluating the replacement and before killing its
// holder definition. A plain view has no such observation; an observing value may be replaced
// while its referent is still alive.
effect fn displacedCleanupClaims() -> ()
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let id = run module("displaced-cleanup.silk")
  let text = """
struct Observed<'a> { value: &'a i32 }
impl<'a> Intrinsic.Drop for Observed<'a> {
  fn drop(self: &mut Observed<'a>) -> () { let read = self.value.* return () }
}
struct View<'a> { value: &'a i32 }
fn displaced(flag: bool) -> () {
  let outer = 1
  let mut held = Observed {value: &outer}
  if flag { let inner = 2 held = Observed {value: &inner} }
  held = Observed {value: &outer}
}
fn unobserved(flag: bool) -> () {
  let outer = 1
  let mut held = View {value: &outer}
  if flag { let inner = 2 held = View {value: &inner} }
  held = View {value: &outer}
}
fn replacedAlive(flag: bool) -> () {
  let outer = 1
  let mut held = Observed {value: &outer}
  if flag {
    let inner = 2
    held = Observed {value: &inner}
    held = Observed {value: &outer}
  }
}
fn loopCleanup(flag: bool) -> () {
  let outer = 1
  let mut held = Observed {value: &outer}
  while flag {
    held = Observed {value: &outer}
    let inner = 2
    held = Observed {value: &inner}
  }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let displaced = run Semantic.demandBody(&mut store, &mut request, &id, b"displaced")
  let unobserved = run Semantic.demandBody(&mut store, &mut request, &id, b"unobserved")
  let alive = run Semantic.demandBody(&mut store, &mut request, &id, b"replacedAlive")
  let looped = run Semantic.demandBody(&mut store, &mut request, &id, b"loopCleanup")
  run Testing.expect(
    rejectsSpan(
      &displaced,
      RejectionCode.ExpiredLifetime,
      text,
      "{ let inner = 2 held = Observed {value: &inner} }",
      usize.ZERO
    ),
    "displaced cleanup cannot observe a loan after its source scope ends"
  )
  run Testing.expect(
    hasBorrowStatus(&unobserved, BodyBorrowStatus.Checked),
    "replacing a plain view does not observe its displaced loan"
  )
  run Testing.expect(
    hasBorrowStatus(&alive, BodyBorrowStatus.Checked),
    "displaced cleanup may observe a loan while its source is alive"
  )
  run Testing.expect(
    hasBorrowStatus(&looped, BodyBorrowStatus.StoredLoans),
    "loop cleanup stays unchecked when later definitions need observations on a back edge"
  )
}

