effect fn plainCallableParameterDiagnosticClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("plain-callable-parameter-rejections.silk")
  let text = """
fn accepts(callback: fn<'static>(i32) -> i32) -> () { return () }
fn generic<T>(value: T, callback: fn<'static>(i32) -> i32) -> () { return () }
fn borrowedGeneric<T>(value: &T, callback: fn<'static>(i32) -> i32) -> () { return () }
fn wrongPlain() -> () {
  let booleanResult = fn(value: i32) -> bool { return true }
  accepts(booleanResult)
}
fn wrongInferred() -> () {
  let inferredResult = fn(value: i32) -> bool { return true }
  generic(1, inferredResult)
}
fn wrongFixed() -> () {
  let fixedResult = fn(value: i32) -> bool { return true }
  generic<i32>(1, fixedResult)
}
fn wrongFixedBorrow() -> () {
  let number = 1
  let borrowedResult = fn(value: i32) -> bool { return true }
  borrowedGeneric<i32>(&number, borrowedResult)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let plain = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongPlain")
  let inferred = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongInferred")
  let fixed = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongFixed")
  let borrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongFixedBorrow")
  run Testing.expect(
    rejectsSpan(
      &plain,
      RejectionCode.IncompatibleCallableSignature,
      text,
      "booleanResult",
      usize.ONE,
    ),
    "a nongeneric plain callable mismatch uses SEM0076 on the argument",
  )
  run Testing.expect(
    rejectsSpan(
      &inferred,
      RejectionCode.TypeArgumentInference,
      text,
      "generic(1, inferredResult)",
      usize.ZERO,
    ),
    "a plain callable mismatch during authored generic inference uses SEM0052 on the call",
  )
  run Testing.expect(
    rejectsSpan(&fixed, RejectionCode.IncompatibleCallableSignature, text, "fixedResult", usize.ONE),
    "explicitly fixed authored binders retain SEM0076 argument diagnostics",
  )
  run Testing.expect(
    rejectsSpan(
      &borrowed,
      RejectionCode.IncompatibleCallableSignature,
      text,
      "borrowedResult",
      usize.ONE,
    ),
    "an automatically selected lifetime does not make an explicitly specialized call an inference failure",
  )
}

test effect fn plainCallableParameterLifetimeInferenceUsesCallSpan() -> ()
! CanonicalizationFailure | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run plainCallableLifetimeInferenceClaims()
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

struct OrdinaryMeetSource {
  application: Shared<SpecializationApplication>
  anonymous: Shared<SpecializationApplication>
  representation: Shared<Type>
  contract: Shared<Type>
}

fn ordinaryMeetAtom(region: &Lifetime, caller: &DeclarationId, loan: usize) -> usize {
  return match &region.* {
    Lifetime.Parameter {declaration, ordinal} => {
      if DeclarationId.equals(&declaration, caller) && ordinal < 2 { return ordinal }
      return usize.MAX
    }
    Lifetime.Local {declaration, ordinal} => {
      if DeclarationId.equals(&declaration, caller) && ordinal == loan { return 2 }
      return usize.MAX
    }
    _ => usize.MAX
  }
}

fn ordinaryMeetRegion(region: &Shared<Lifetime>, caller: &DeclarationId, loan: usize) -> bool {
  if Lifetime.atomCount(region) != 3 { return false }
  let mut first = false
  let mut second = false
  let mut local = false
  let mut at = usize.ZERO
  while at < 3 {
    let atom = Lifetime.atomAt(region, at)
    let selected = Shared<Lifetime>.with<usize>(&atom,
      fn(value: &Lifetime) -> usize { return ordinaryMeetAtom(value, caller, loan) })
    if selected == usize.ZERO { if first { return false } first = true }
    else if selected == usize.ONE { if second { return false } second = true }
    else if selected == 2 { if local { return false } local = true }
    else { return false }
    at = at + usize.ONE
  }
  return first && second && local
}

fn ordinaryMeetReference(ty: &Type, caller: &DeclarationId, loan: usize, expected: usize) -> bool {
  if let Type.Reference {access, referent, lifetime} = &ty.* {
    return access == Access.Shared && Shared<Type>.with<bool>(&referent, isI32)
      && Shared<Lifetime>.with<usize>(&lifetime,
        fn(value: &Lifetime) -> usize { return ordinaryMeetAtom(value, caller, loan) }) == expected
  }
  return false
}

fn ordinaryMeetEnvironment(environment: &Intersection, caller: &DeclarationId, loan: usize) -> bool {
  let members = Vector<LifetimeMember>.asSlice(&environment.members)
  if members.length != 3 { return false }
  let mut first = false
  let mut second = false
  let mut local = false
  let mut at = usize.ZERO
  while at < members.length {
    let selected = Shared<Lifetime>.with<usize>(&members[at].region,
      fn(value: &Lifetime) -> usize { return ordinaryMeetAtom(value, caller, loan) })
    if selected == usize.ZERO { if first { return false } first = true }
    else if selected == usize.ONE { if second { return false } second = true }
    else if selected == 2 { if local { return false } local = true }
    else { return false }
    at = at + usize.ONE
  }
  return first && second && local
}

fn ordinaryMeetInvocationReference(ty: &Type) -> bool {
  if let Type.Reference {access, referent, lifetime} = &ty.* {
    return access == Access.Shared && Shared<Type>.with<bool>(&referent, isI32)
      && Shared<Lifetime>.with<bool>(&lifetime, fn(value: &Lifetime) -> bool {
        return match &value.* { Lifetime.Invocation {ordinal} => ordinal == usize.ZERO _ => false }
      })
  }
  return false
}

fn ordinaryMeetContract(ty: &Type, caller: &DeclarationId, loan: usize) -> bool {
  if let Type.Callable {mode, isUnsafe, environment, invocationBinders, invocationBounds, parameters, result, ..} = &ty.* {
    let inputs = Vector<Shared<Type>>.asSlice(&parameters)
    return mode == CallableMode.Shared && !isUnsafe && invocationBinders == usize.ONE
      && Vector<Outlives>.length(&invocationBounds) == usize.ZERO && inputs.length == usize.ONE
      && Shared<Type>.with<bool>(&inputs[usize.ZERO], ordinaryMeetInvocationReference)
      && Shared<Type>.with<bool>(&result, isI32)
      && Shared<Intersection>.with<bool>(&environment,
        fn(value: &Intersection) -> bool { return ordinaryMeetEnvironment(value, caller, loan) })
  }
  return false
}

fn ordinaryMeetRepresentation(ty: &Type, caller: &DeclarationId, loan: usize,
  child: &DeclarationId) -> Option<Shared<Type>> {
  if let Type.CallableValue {application, contract, captures, fieldInputs, ..} = &ty.* {
    let fields = Vector<Shared<Type>>.asSlice(&captures)
    let inputs = Vector<CallableFieldInput>.asSlice(&fieldInputs)
    if fields.length != 3 || inputs.length != usize.ZERO
      || !Shared<SpecializationApplication>.with<bool>(&application,
        fn(value: &SpecializationApplication) -> bool {
          return DeclarationId.equals(SpecializationApplication.bodyDeclaration(value), child)
            && DeclarationId.kind(child) == OwnerKind.Anonymous
        }) { return Option<Shared<Type>>.none() }
    let mut at = usize.ZERO
    while at < fields.length {
      if !Shared<Type>.with<bool>(&fields[at],
        fn(value: &Type) -> bool { return ordinaryMeetReference(value, caller, loan, at) }) {
        return Option<Shared<Type>>.none()
      }
      at = at + usize.ONE
    }
    if Shared<Type>.with<bool>(&contract,
      fn(value: &Type) -> bool { return ordinaryMeetContract(value, caller, loan) }) {
      return Option<Shared<Type>>.some(Shared<Type>.clone(&contract))
    }
  }
  return Option<Shared<Type>>.none()
}

fn ordinaryMeetCallableApplication(ty: &Type) -> Option<Shared<SpecializationApplication>> {
  return match &ty.* {
    Type.CallableValue {application, ..} => Option<Shared<SpecializationApplication>>.some(
      Shared<SpecializationApplication>.clone(&application))
    _ => Option<Shared<SpecializationApplication>>.none()
  }
}

fn ordinaryMeetChildContract(child: &TypedBody, representation: &Shared<Type>, caller: &DeclarationId,
  loan: usize) -> Option<Shared<Type>> {
  return Shared<Type>.with<Option<Shared<Type>>>(representation,
    fn(value: &Type) -> Option<Shared<Type>> {
      return ordinaryMeetRepresentation(value, caller, loan, TypedBody.declarationId(child))
    })
}

fn ordinaryMeetSource(body: &TypedBody, text: string, anchor: &Anchor) -> Option<OrdinaryMeetSource> {
  let nodes = TypedBody.nodeSlice(body)
  let locals = TypedBody.localSlice(body)
  let caller = TypedBody.declarationId(body)
  // Inspect current authored byte projections.
  let loanStart = offsetOf(text, "&number", usize.ONE)
  let callbackStart = offsetOf(text, "fn(value: &i32)", usize.ZERO)
  let callStart = offsetOf(text, "acceptMeet(read)", usize.ZERO)
  let mut loan = usize.MAX
  let mut callback = usize.MAX
  let mut call = usize.MAX
  let mut at = usize.ZERO
  while at < nodes.length {
    if Anchor.span(anchor, nodes[at].origin.location).start == loanStart && Anchor.span(anchor, nodes[at].origin.location).end == loanStart + 7 {
      if loan != usize.MAX { return Option<OrdinaryMeetSource>.none() }
      loan = at
    }
    if Anchor.span(anchor, nodes[at].origin.location).start == callbackStart {
      if let BodyNodeKind.Expression {form: BodyExpression.Callable {..}, ..} = &nodes[at].kind {
        if callback != usize.MAX { return Option<OrdinaryMeetSource>.none() }
        callback = at
      }
    }
    if Anchor.span(anchor, nodes[at].origin.location).start == callStart && Anchor.span(anchor, nodes[at].origin.location).end == callStart + 16 {
      if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {..}, ..} = &nodes[at].kind {
        if call != usize.MAX { return Option<OrdinaryMeetSource>.none() }
        call = at
      }
    }
    at = at + usize.ONE
  }
  if loan >= nodes.length || callback >= nodes.length || call >= nodes.length { return Option<OrdinaryMeetSource>.none() }
  let loanOrdinal = nodes[loan].origin.node
  if let BodyNodeKind.Expression {ty, form: BodyExpression.Borrow {access, value}} = &nodes[loan].kind {
    if access != Access.Shared || value.index >= nodes.length
      || !Shared<Type>.with<bool>(&ty,
        fn(value: &Type) -> bool { return ordinaryMeetReference(value, caller, loanOrdinal, 2) }) {
      return Option<OrdinaryMeetSource>.none()
    }
    if let BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} = &nodes[value.index].kind {
      let written = offsetOf(text, "let number = 40", usize.ZERO)
      if local.index >= locals.length || locals[local.index].mutable
        || Anchor.span(anchor, locals[local.index].origin.location).start != written + 4
        || Anchor.span(anchor, locals[local.index].origin.location).end != written + 10
        || !Shared<Type>.with<bool>(&locals[local.index].ty, isI32) { return Option<OrdinaryMeetSource>.none() }
    } else { return Option<OrdinaryMeetSource>.none() }
  } else { return Option<OrdinaryMeetSource>.none() }
  if let BodyNodeKind.Expression {ty: representation, form: BodyExpression.Callable {fields, body: child, ..}} = &nodes[callback].kind {
    let captures = Vector<BodyAggregateField>.asSlice(&fields)
    if captures.length != 3 { return Option<OrdinaryMeetSource>.none() }
    let mut localLoan = usize.MAX
    let mut definitions = usize.ZERO
    at = usize.ZERO
    while at < nodes.length {
      if let BodyNodeKind.LocalBinding {local, initializer} = &nodes[at].kind {
        if initializer.index == loan { localLoan = local.index definitions = definitions + usize.ONE }
      }
      at = at + usize.ONE
    }
    if definitions != usize.ONE { return Option<OrdinaryMeetSource>.none() }
    at = usize.ZERO
    while at < captures.length {
      if captures[at].index != at || captures[at].value.index >= nodes.length { return Option<OrdinaryMeetSource>.none() }
      if let BodyNodeKind.Expression {ty: captureType, form: BodyExpression.Local {local}} = &nodes[captures[at].value.index].kind {
        let mut expected = at
        if at == 2 { expected = localLoan }
        if local.index != expected || !Shared<Type>.with<bool>(&captureType,
          fn(value: &Type) -> bool { return ordinaryMeetReference(value, caller, loanOrdinal, at) }) {
          return Option<OrdinaryMeetSource>.none()
        }
      } else { return Option<OrdinaryMeetSource>.none() }
      at = at + usize.ONE
    }
    let contract = Shared<TypedBody>.with<Option<Shared<Type>>>(&child,
      fn(value: &TypedBody) -> Option<Shared<Type>> {
        return ordinaryMeetChildContract(value, &representation, caller, loanOrdinal)
      })
    let original = Shared<Type>.with<Option<Shared<SpecializationApplication>>>(&representation, ordinaryMeetCallableApplication)
    if let Option<Shared<Type>>.Some {value: promised} = move contract {
      if let Option<Shared<SpecializationApplication>>.Some {value: anonymous} = move original {
        if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration, application, arguments, ..}, ..} = &nodes[call].kind {
          let supplied = Vector<BodyNodeId>.asSlice(&arguments)
          if supplied.length != usize.ONE || supplied[usize.ZERO].index >= nodes.length
            || !DeclarationId.named(&declaration, b"acceptMeet") { return Option<OrdinaryMeetSource>.none() }
          if let BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} = &nodes[supplied[usize.ZERO].index].kind {
            let mut bound = usize.ZERO
            at = usize.ZERO
            while at < nodes.length {
              if let BodyNodeKind.LocalBinding {local: destination, initializer} = &nodes[at].kind {
                if destination.index == local.index && initializer.index == callback { bound = bound + usize.ONE }
              }
              at = at + usize.ONE
            }
            let selected = Shared<SpecializationApplication>.with<bool>(&application,
              fn(value: &SpecializationApplication) -> bool {
                let given = Vector<Argument>.asSlice(&value.arguments)
                let ordinals = Vector<usize>.asSlice(&value.argumentOrdinals)
                if !DeclarationId.equals(SpecializationApplication.bodyDeclaration(value), &declaration)
                  || given.length != 2 || ordinals.length != 2 || ordinals[usize.ZERO] != usize.ZERO
                  || ordinals[usize.ONE] != usize.ONE || Vector<ScopeBinding>.length(&value.scopes) != usize.ZERO { return false }
                return match &given[usize.ZERO] {
                  Argument.Lifetime {value: region} => ordinaryMeetRegion(&region, caller, loanOrdinal)
                  _ => false
                }
              })
            if bound == usize.ONE && selected {
              return Option<OrdinaryMeetSource>.some(OrdinaryMeetSource {application: Shared<SpecializationApplication>.clone(&application),
                anonymous: move anonymous, representation: Shared<Type>.clone(&representation), contract: move promised})
            }
          }
        }
      }
    }
  }
  return Option<OrdinaryMeetSource>.none()
}

fn ordinaryMeetSignatureContract(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        if signature.isEffect || signature.isUnsafe || signature.isVariadic
          || signature.callableParameterStart != usize.ONE
          || Vector<Shared<Lifetime>>.length(&signature.lifetimeParameters) != usize.ONE
          || Vector<Shared<Type>>.length(&signature.typeParameters) != usize.ONE
          || Vector<Shared<Type>>.length(&signature.parameters) != usize.ONE
          || !Shared<Type>.with<bool>(&signature.result, isI32) { return Option<Shared<Type>>.none() }
        return parameterContractAt(&signature, usize.ZERO)
      }
      _ => Option<Shared<Type>>.none()
    }
    _ => Option<Shared<Type>>.none()
  }
}

effect fn ordinaryMeetSelectedContract(store: &mut Semantic, request: &mut Request,
  source: &OrdinaryMeetSource) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let application = run SpecializationApplication.copyShared(&source.application)
  let signature = run Semantic.demandSignatureOf(&mut store.*, &mut request.*,
    SpecializationApplication.bodyDeclaration(&application))
  let rawContract = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&signature, ordinaryMeetSignatureContract)
  if let Option<Shared<Type>>.Some {value} = move rawContract {
    let bindings = run SpecializationApplication.bindings(&application)
    let given = Vector<Argument>.asSlice(&application.arguments)
    if given.length != 2 { return false }
    if let Argument.Type {value: representation} = &given[usize.ONE] {
      let selected = run Type.applyBindings(&value, Vector<Binding>.asSlice(&bindings), true)
      return (run Type.equalsShared(&selected, &source.contract))
        && (run Type.equalsShared(&representation, &source.representation))
    }
  }
  return false
}

fn ordinaryMeetMirRoot(function: &MirFunction, start: usize, root: usize) -> bool {
  let locals = Vector<MirLocal>.asSlice(&function.locals)
  let blocks = Vector<MirBlock>.asSlice(&function.blocks)
  let mut local = start
  let mut steps = usize.ZERO
  while local < locals.length && steps < locals.length {
    let mut writers = usize.ZERO
    let mut source = usize.MAX
    let mut at = usize.ZERO
    while at < blocks.length {
      let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
      let mut item = usize.ZERO
      while item < statements.length {
        if variadicStatementLocal(&statements[item]) == local {
          writers = writers + usize.ONE
          if local != root {
            if let MirStatement.Assign {destination, value: MirRvalue.Use {value}, ..} = &statements[item] {
              if Vector<MirProjection>.length(&destination.projections) != usize.ZERO { return false }
              source = variadicOperandLocal(&value)
            } else { return false }
          }
        }
        item = item + usize.ONE
      }
      if let MirTerminator.Call {destination, failure, ..} = &blocks[at].terminator {
        if destination.local == local { return false }
        if let Option<MirFailureEdge>.Some {value} = &failure { if value.destination.local == local { return false } }
      }
      at = at + usize.ONE
    }
    if writers != usize.ONE { return false }
    if local == root { return true }
    local = source
    steps = steps + usize.ONE
  }
  return false
}

fn ordinaryMeetMirInteger(function: &MirFunction, local: usize, text: string, anchor: &Anchor) -> bool {
  let locals = Vector<MirLocal>.asSlice(&function.locals)
  let blocks = Vector<MirBlock>.asSlice(&function.blocks)
  // Inspect current authored byte projections.
  let written = offsetOf(text, "let number = 40", usize.ZERO)
  if local >= locals.length || !Shared<Type>.with<bool>(&locals[local].ty, isI32) { return false }
  let mut definitions = usize.ZERO
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
    let mut item = usize.ZERO
    while item < statements.length {
      if variadicStatementLocal(&statements[item]) == local {
        if let MirStatement.Assign {destination, value: MirRvalue.Use {value: MirOperand.Integer {decimal, negative, ..}}, origin} = &statements[item] {
          if Vector<MirProjection>.length(&destination.projections) != usize.ZERO || negative
            || !sameBytes(Bytes.asSlice(&decimal), b"40") || Anchor.span(anchor, origin.location).start != written
            || Anchor.span(anchor, origin.location).end != written + 15 { return false }
          definitions = definitions + usize.ONE
        } else { return false }
      }
      item = item + usize.ONE
    }
    if let MirTerminator.Call {destination, failure, ..} = &blocks[at].terminator {
      if destination.local == local { return false }
      if let Option<MirFailureEdge>.Some {value} = &failure { if value.destination.local == local { return false } }
    }
    at = at + usize.ONE
  }
  return definitions == usize.ONE
}

fn ordinaryMeetMirLoan(function: &MirFunction, start: usize, text: string, anchor: &Anchor) -> bool {
  let locals = Vector<MirLocal>.asSlice(&function.locals)
  let blocks = Vector<MirBlock>.asSlice(&function.blocks)
  // Inspect current authored byte projections.
  let written = offsetOf(text, "&number", usize.ONE)
  let mut local = start
  let mut steps = usize.ZERO
  while local < locals.length && steps < locals.length {
    let mut writers = usize.ZERO
    let mut source = usize.MAX
    let mut borrowed = usize.MAX
    let mut at = usize.ZERO
    while at < blocks.length {
      let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
      let mut item = usize.ZERO
      while item < statements.length {
        if variadicStatementLocal(&statements[item]) == local {
          writers = writers + usize.ONE
          if let MirStatement.Assign {destination, value, origin} = &statements[item] {
            if Vector<MirProjection>.length(&destination.projections) != usize.ZERO { return false }
            match &value {
              MirRvalue.Use {value: operand} => { source = variadicOperandLocal(&operand) }
              MirRvalue.Ref {access, place} => {
                if access != Access.Shared || Vector<MirProjection>.length(&place.projections) != usize.ZERO
                  || Anchor.span(anchor, origin.location).start != written || Anchor.span(anchor, origin.location).end != written + 7 { return false }
                borrowed = place.local
              }
              _ => { return false }
            }
          } else { return false }
        }
        item = item + usize.ONE
      }
      if let MirTerminator.Call {destination, failure, ..} = &blocks[at].terminator {
        if destination.local == local { return false }
        if let Option<MirFailureEdge>.Some {value} = &failure { if value.destination.local == local { return false } }
      }
      at = at + usize.ONE
    }
    if writers != usize.ONE { return false }
    if borrowed != usize.MAX { return ordinaryMeetMirInteger(function, borrowed, text, anchor) }
    local = source
    steps = steps + usize.ONE
  }
  return false
}

fn ordinaryMeetMirCaptures(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, text: string, anchor: &Anchor) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      // Inspect current authored byte projections.
          let written = offsetOf(text, "fn(value: &i32)", usize.ZERO)
      let callStart = offsetOf(text, "acceptMeet(read)", usize.ZERO)
      let mut environment = usize.MAX
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
        let mut item = usize.ZERO
        while item < statements.length {
          if let MirStatement.Assign {destination, value: MirRvalue.Aggregate {fields}, origin} = &statements[item] {
            if Anchor.span(anchor, origin.location).start == written {
              let captures = Vector<MirAggregateField>.asSlice(&fields)
              if environment != usize.MAX || Vector<MirProjection>.length(&destination.projections) != usize.ZERO
                || captures.length != 3 { return false }
              let mut field = usize.ZERO
              while field < captures.length {
                let local = variadicOperandLocal(&captures[field].value)
                if captures[field].index != field { return false }
                if field < 2 {
                  if !variadicParameter(function, local, field) { return false }
                } else if !ordinaryMeetMirLoan(function, local, text, anchor) { return false }
                field = field + usize.ONE
              }
              environment = destination.local
            }
          }
          item = item + usize.ONE
        }
        at = at + usize.ONE
      }
      if environment == usize.MAX { return false }
      let mut calls = usize.ZERO
      at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, origin, ..} = &blocks[at].terminator {
          if Anchor.span(anchor, origin.location).start == callStart && Anchor.span(anchor, origin.location).end == callStart + 16 {
            let supplied = Vector<MirOperand>.asSlice(&arguments)
            if !keyNamed(&key, "acceptMeet") || supplied.length != usize.ONE
              || !ordinaryMeetMirRoot(function, variadicOperandLocal(&supplied[usize.ZERO]), environment) { return false }
            calls = calls + usize.ONE
          }
        }
        at = at + usize.ONE
      }
      return calls == usize.ONE
    }
  }
  return false
}

// This fixture has only straight-line normal control flow. Authenticate every dependency on
// that reached path, rather than treating a unique writer in an arbitrary block as available.
fn ordinaryMeetReadyOperand(operand: &MirOperand, initialized: &[bool]) -> bool {
  return match &operand.* {
    MirOperand.Copy {place} => Vector<MirProjection>.length(&place.projections) == usize.ZERO
      && place.local < initialized.length && initialized[place.local]
    MirOperand.Move {place} => Vector<MirProjection>.length(&place.projections) == usize.ZERO
      && place.local < initialized.length && initialized[place.local]
    MirOperand.Integer {..} => true
    MirOperand.Unit => true
    _ => false
  }
}

fn ordinaryMeetReadyValue(value: &MirRvalue, initialized: &[bool]) -> bool {
  return match &value.* {
    MirRvalue.Use {value: operand} => ordinaryMeetReadyOperand(&operand, initialized)
    MirRvalue.Ref {place, ..} => Vector<MirProjection>.length(&place.projections) == usize.ZERO
      && place.local < initialized.length && initialized[place.local]
    MirRvalue.Aggregate {fields} => {
      let supplied = Vector<MirAggregateField>.asSlice(&fields)
      let mut at = usize.ZERO
      while at < supplied.length {
        if !ordinaryMeetReadyOperand(&supplied[at].value, initialized) { return false }
        at = at + usize.ONE
      }
      return true
    }
    _ => false
  }
}

// Keep this slice indexing in its own function. The pinned bootstrap otherwise reuses the
// first loop's conditional slice spill in the later Return loop, violating LLVM dominance.
fn ordinaryMeetParameterLocal(locals: &[MirLocal], at: usize) -> bool {
  return match &locals[at].kind { MirLocalKind.Parameter {..} => true _ => false }
}

effect fn ordinaryMeetReachedCallee(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  wanted: &DeclarationId, anchor: &Anchor) -> Option<SourceInstanceRequest>
! OutOfMemoryError ? &mut Allocator {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let source = match move mirSourceApplication(function) {
        Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
        _ => { return Option<SourceInstanceRequest>.none() }
      }
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut initialized = Vector<bool>.make()
      let mut local = usize.ZERO
      while local < locals.length {
        let parameter = ordinaryMeetParameterLocal(locals, local)
        run Vector<bool>.append(&mut initialized, parameter)
        local = local + usize.ONE
      }
      let mut block = usize.ZERO
      let mut steps = usize.ZERO
      let mut found = Option<SourceInstanceRequest>.none()
      while block < blocks.length && steps < blocks.length {
        let statements = Vector<MirStatement>.asSlice(&blocks[block].statements)
        let mut at = usize.ZERO
        while at < statements.length {
          if let MirStatement.Assign {destination, value, ..} = &statements[at] {
            if destination.local >= locals.length
              || Vector<MirProjection>.length(&destination.projections) != usize.ZERO
              || !ordinaryMeetReadyValue(&value, Vector<bool>.asSlice(&initialized)) {
              return Option<SourceInstanceRequest>.none()
            }
            let mut ready = Vector<bool>.asMutSlice(&mut initialized)
            ready[destination.local] = true
          } else { return Option<SourceInstanceRequest>.none() }
          at = at + usize.ONE
        }
        match &blocks[block].terminator {
          MirTerminator.Goto {target, ..} => { block = target }
          MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, providers, diagnostics,
            destination, normal, failure, origin} => {
            if let Option<SourceInstanceRequest>.Some {..} = &found { return Option<SourceInstanceRequest>.none() }
            if let Option<MirFailureEdge>.Some {..} = &failure { return Option<SourceInstanceRequest>.none() }
            if let Option<MirDiagnostics>.Some {..} = &diagnostics { return Option<SourceInstanceRequest>.none() }
            let identity = InstanceKey.identity(&key)
            if !Shared<DeclarationId>.with<bool>(&identity,
              fn(declaration: &DeclarationId) -> bool { return DeclarationId.equals(declaration, wanted) })
              || Vector<MirOperand>.length(&providers) != usize.ZERO
              || destination.local >= locals.length
              || Vector<MirProjection>.length(&destination.projections) != usize.ZERO {
              return Option<SourceInstanceRequest>.none()
            }
            let supplied = Vector<MirOperand>.asSlice(&arguments)
            at = usize.ZERO
            while at < supplied.length {
              if !ordinaryMeetReadyOperand(&supplied[at], Vector<bool>.asSlice(&initialized)) {
                return Option<SourceInstanceRequest>.none()
              }
              at = at + usize.ONE
            }
            found = Option<SourceInstanceRequest>.some(SourceInstanceRequest {key: InstanceKey.copy(&key),
              sourceOwner: DeclarationId.copy(SpecializationApplication.bodyDeclaration(&source)), span: Anchor.span(anchor, origin.location)})
            let mut ready = Vector<bool>.asMutSlice(&mut initialized)
            ready[destination.local] = true
            block = normal
          }
          MirTerminator.Return {..} => {
            let ready = Vector<bool>.asSlice(&initialized)
            let mut returns = usize.ZERO
            local = usize.ZERO
            while local < locals.length {
              let returning = match &locals[local].kind { MirLocalKind.Return => true _ => false }
              if returning {
                if !ready[local] { return Option<SourceInstanceRequest>.none() }
                returns = returns + usize.ONE
              }
              local = local + usize.ONE
            }
            if returns == usize.ONE { return move found }
            return Option<SourceInstanceRequest>.none()
          }
          _ => { return Option<SourceInstanceRequest>.none() }
        }
        steps = steps + usize.ONE
      }
    }
  }
  return Option<SourceInstanceRequest>.none()
}

fn ordinaryMeetMirInput(ty: &Type) -> bool {
  if let Type.Reference {access, referent, ..} = &ty.* {
    return access == Access.Shared && Shared<Type>.with<bool>(&referent, isI32)
  }
  return false
}

fn ordinaryMeetAnonymousAbi(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  if !anonymousTargetParameter(store, answer, CallableMode.Shared, 2) { return false }
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let parameters = Vector<Shared<Type>>.asSlice(&function.parameters)
      return parameters.length == 2 && Shared<Type>.with<bool>(&parameters[usize.ONE], ordinaryMeetMirInput)
        && Shared<Type>.with<bool>(&function.result, isI32)
    }
  }
  return false
}

effect fn ordinaryMeetRuntimeClaims(store: &mut Semantic, request: &mut Request, id: &ModuleId,
  source: &OrdinaryMeetSource, text: string) -> bool
! CanonicalizationFailure | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let expected = run requiredCanonicalKey(run InstanceKey.function(run SpecializationApplication.copyShared(&source.application)))
  let originalConsumer = run SpecializationApplication.copyShared(&source.application)
  let originalCallback = run SpecializationApplication.copyShared(&source.anonymous)
  let caller = run Semantic.demandMir(&mut store.*, &mut request.*, id, b"captured")
  let callerAnchor = match move run answerMirAnchor(&mut store.*, &caller) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => {return false}
  }
  if !ordinaryMeetMirCaptures(&store.*, &caller, text, &callerAnchor) { return false }
  let actual = run ordinaryMeetReachedCallee(&store.*, &caller, SpecializationApplication.bodyDeclaration(&originalConsumer), &callerAnchor)
  if let Option<SourceInstanceRequest>.Some {value: selected} = move actual {
    if !(run InstanceKey.sameApplication(&expected, &selected.key)) { return false }
    let consumer = run Semantic.demandInstanceMir(&mut store.*, &mut request.*, &selected.key, &selected.sourceOwner, selected.span, false)
    let consumerAnchor = match move run answerMirAnchor(&mut store.*, &consumer) {
      Option<Anchor>.Some {value} => move value
      Option<Anchor>.None => {return false}
    }
    let invoked = run ordinaryMeetReachedCallee(&store.*, &consumer, SpecializationApplication.bodyDeclaration(&originalCallback), &consumerAnchor)
    if let Option<SourceInstanceRequest>.Some {value: callback} = move invoked {
      let application = run InstanceKey.selected(&callback.key)
      if !DeclarationId.equals(SpecializationApplication.bodyDeclaration(&application), SpecializationApplication.bodyDeclaration(&originalCallback)) {
        return false
      }
      let body = run Semantic.demandInstanceMir(&mut store.*, &mut request.*, &callback.key, &callback.sourceOwner, callback.span, false)
      return ordinaryMeetAnonymousAbi(&store.*, &body)
    }
  }
  return false
}

effect fn plainCallableLifetimeInferenceClaims() -> ()
! CanonicalizationFailure | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("plain-callable-lifetime-inference.silk")
  let text = """
fn invoke<'a>(value: &'a i32, callback: fn<'static>(i32) -> i32) -> () { return () }
fn main() -> () {
  let number = 1
  let badResult = fn(value: i32) -> bool { return true }
  invoke(&number, badResult)
}
fn acceptMeet<'env>(callback: for<'call> fn<'env>(&'call i32) -> i32) -> i32 {
  let input = 0
  return callback(&input)
}
fn captured<'left, 'right>(left: &'left i32, right: &'right i32) -> i32 {
  let number = 40
  let localLoan = &number
  let read = fn(value: &i32) -> i32 { return value.* + left.* + right.* + localLoan.* }
  return acceptMeet(read)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let result = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
  run Testing.expect(
    rejectsSpan(
      &result,
      RejectionCode.TypeArgumentInference,
      text,
      "invoke(&number, badResult)",
      usize.ZERO,
    ),
    "implicit lifetime-only inference uses SEM0052 on the call",
  )
  let captured = run Semantic.demandBody(&mut store, &mut request, &id, b"captured")
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&captured, checkedBody)
  let mut preserved = false
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    let anchor = match move run Semantic.bodyAnchor(&mut store, &value) {
      Option<Anchor>.Some {value: currentAnchor} => move currentAnchor
      Option<Anchor>.None => {return run Testing.expect(false, "captured body has a current source anchor")}
    }
    let observed = Shared<TypedBody>.with<Option<OrdinaryMeetSource>>(&value,
      fn(typed: &TypedBody) -> Option<OrdinaryMeetSource> { return ordinaryMeetSource(typed, text, &anchor) })
    if let Option<OrdinaryMeetSource>.Some {value: source} = move observed {
      preserved = (run ordinaryMeetSelectedContract(&mut store, &mut request, &source))
        && (run ordinaryMeetRuntimeClaims(&mut store, &mut request, &id, &source, text))
    }
  }
  run Testing.expect(preserved,
    "ordinary callback inference publishes both original caller parameter regions and the actual local capture loan in one selected argument")
}

struct PairedApplications {
  revision: Revision
  shared: SpecializationApplication
  distinct: SpecializationApplication
}

// `target` applied once with one region for both lifetime parameters and once with two distinct
// regions of `site`, followed by `Maker` when `provider`.
effect fn pairedApplications(source: string, id: &ModuleId, target: &[u8], provider: bool) -> PairedApplications
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let caller = run requireIndexedIdentity(&mut index, id, OwnerKind.Function, target, usize.ZERO)
  let site = run requireIndexedIdentity(&mut index, id, OwnerKind.Function, b"site", usize.ZERO)
  let left = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&site), ordinal: usize.ZERO})
  let right = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&site), ordinal: usize.ONE})
  let mut sharedArguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut sharedArguments, Argument.Lifetime {value: Shared<Lifetime>.clone(&left)})
  run Vector<Argument>.append(&mut sharedArguments, Argument.Lifetime {value: Shared<Lifetime>.clone(&left)})
  let mut distinctArguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut distinctArguments, Argument.Lifetime {value: move left})
  run Vector<Argument>.append(&mut distinctArguments, Argument.Lifetime {value: move right})
  if provider {
    let maker = run requireIndexedIdentity(&mut index, id, OwnerKind.Struct, b"Maker", usize.ZERO)
    let made = run Types.intern(Type.Nominal {declaration: move maker, isPublic: false, arguments: Vector<Argument>.make()})
    run Vector<Argument>.append(&mut sharedArguments, Argument.Type {value: Shared<Type>.clone(&made)})
    run Vector<Argument>.append(&mut distinctArguments, Argument.Type {value: move made})
  }
  return PairedApplications {
    revision: move revision,
    shared: run specializationWithArguments(&caller, move sharedArguments),
    distinct: run specializationWithArguments(&caller, move distinctArguments),
  }
}

fn selectedIndex(answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  return match move Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex) {
    Option<usize>.Some {value} => value
    _ => usize.MAX
  }
}

test effect fn regionPatternsShareOneLoweredBody() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run regionSharingClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn regionSharingClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("region-sharing.silk")
  let source = """
interface Paired<'a, 'b> { fn read(value: Self) -> i32 }
struct Maker {}
impl<'x> Paired<'x, 'x> for Maker { fn read(value: Self) -> i32 { return 1 } }
fn through<'a, 'b, P: Paired<'a, 'b>>(maker: P) -> i32 { return Paired<'a, 'b>.read(move maker) }
fn leaf<'a, 'b>(left: &'a i32, right: &'b i32) -> i32 { return 0 }
fn site(left: &i32, right: &i32) -> i32 { return 0 }
"""
  let plain = run pairedApplications(source, &id, b"leaf", false)
  let mut store = makeSemantic(run Revision.copy(&plain.revision))
  let mut distinctRequest = Request.make()
  let distinct = run Semantic.demandApplicationMir(&mut store, &mut distinctRequest, &plain.distinct)
  let mut sharedRequest = Request.make()
  let shared = run Semantic.demandApplicationMir(&mut store, &mut sharedRequest, &plain.shared)
  run Testing.expect(selectedIndex(&distinct) != usize.MAX && selectedIndex(&distinct) == selectedIndex(&shared)
    && starts(Semantic.eventLog(&store), Family.Mir) == usize.ONE,
    "region patterns of one application share one lowered body")
  // A conformance head may repeat a region; the caller's typing proves it, and lowering the
  // pattern the caller reached proves it again under that pattern.
  let paired = run pairedApplications(source, &id, b"through", true)
  let mut forward = makeSemantic(run Revision.copy(&paired.revision))
  let mut acceptedRequest = Request.make()
  let accepted = run Semantic.demandApplicationMir(&mut forward, &mut acceptedRequest, &paired.shared)
  run Testing.expect(selectedIndex(&accepted) != usize.MAX, "a region-repeating conformance head proves the pattern it accepts")
  return ()
}

test effect fn storedLoansS2DisplacedCleanup() -> ()
  ! AssertionError<'static> | OutOfMemoryError | Cycle | InvalidModulePath | RevisionMismatch {
  let mut allocator = Allocator.systemAllocatorProvider()
