effect fn closedRegionAtomClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("closed-region-atoms.silk")
  let text = """
struct Holder<'a> {
  value: &'a i32
}
fn put<'b>(slot: &mut Holder<'b>, value: &'b i32) -> () { slot.value = value }
impl<'a> Holder<'a> {
  fn get(self: &Self) -> &'a i32 { return self.value }
  fn leak(self: &Self) -> &'a i32 { let inner = 7 return &inner }
  fn set(self: &mut Self) -> () { let inner = 7 put(&mut self.*, &inner) }
}
struct Pair<'a, 'b> {
  first: &'a i32
  second: &'b i32
}
fn choose<'x>(left: &'x i32, right: &'x i32) -> &'x i32 { return left }
impl<'a, 'b> Pair<'a, 'b> {
  fn mixed(self: &Self) -> &'a i32 { return choose(self.first, self.second) }
}
fn captured<'a>(value: &'a i32) -> i32 {
  let read = fn() -> i32 { return value.* }
  return read()
}
fn borrowedLocal() -> i32 {
  let x = 5
  let view = &x
  let read = fn() -> i32 { return view.* }
  return read()
}
fn invoked() -> i32 {
  let increment = fn(value: &i32) -> i32 { return value.* + 1 }
  let x = 1
  return increment(&x)
}
fn stored<'a>(holder: &mut Holder<'a>) -> () {
  let write = fn(slot: &mut Holder<'a>) -> () { let inner = 7 put(&mut slot.*, &inner) }
  write(&mut holder.*)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let source = run present(text)
  let mut index = SourceIndex.make(run Revision.publish(&Revision.make(), &id, &source))
  let getId = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"get", usize.ZERO)
  let leakId = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"leak", usize.ZERO)
  let setId = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"set", usize.ZERO)
  let get = run Semantic.demandBodyOf(&mut store, &mut request, &getId)
  let leak = run Semantic.demandBodyOf(&mut store, &mut request, &leakId)
  let set = run Semantic.demandBodyOf(&mut store, &mut request, &setId)
  let mixedId = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"mixed", usize.ZERO)
  let mixed = run Semantic.demandBodyOf(&mut store, &mut request, &mixedId)
  let captured = run Semantic.demandBody(&mut store, &mut request, &id, b"captured")
  let borrowedLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowedLocal")
  let invoked = run Semantic.demandBody(&mut store, &mut request, &id, b"invoked")
  let stored = run Semantic.demandBody(&mut store, &mut request, &id, b"stored")
  run Testing.expect(hasBorrowStatus(&get, BodyBorrowStatus.Checked), "an impl's lifetime parameter is universal in its method")
  run Testing.expect(rejectsSpan(&leak, RejectionCode.ExpiredLifetime, text, "&inner", usize.ZERO),
    "a method local cannot gain its impl's lifetime (OWN0019)")
  run Testing.expect(hasBorrowStatus(&set, BodyBorrowStatus.Regions), "a local required to outlive an impl parameter stays pending")
  run Testing.expect(!hasBorrowStatus(&mixed, BodyBorrowStatus.Checked),
    "enclosing parameters are universal but unrelated: 'b : 'a has no premise, so the method is never Checked")
  run Testing.expect(hasBorrowStatus(&captured, BodyBorrowStatus.Checked) && anonymousStatus(&captured, BodyBorrowStatus.Checked),
    "an enclosing function's lifetime parameter is universal in its anonymous body")
  run Testing.expect(hasBorrowStatus(&borrowedLocal, BodyBorrowStatus.Checked) && anonymousStatus(&borrowedLocal, BodyBorrowStatus.Checked),
    "an enclosing local's loan region is a capture dependency the enclosing body bounds")
  run Testing.expect(hasBorrowStatus(&invoked, BodyBorrowStatus.Checked) && anonymousStatus(&invoked, BodyBorrowStatus.Checked),
    "a callable value's contract binders name no held region, and a literal's invocation binders are universal in it")
  run Testing.expect(hasBorrowStatus(&stored, BodyBorrowStatus.Checked) && anonymousStatus(&stored, BodyBorrowStatus.Regions),
    "a nested local required to outlive an enclosing parameter stays pending without blocking the enclosing body")
  return ()
}

