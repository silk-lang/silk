effect fn innerResultRetentionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("inner-result-retention.silk")
  let text = """
struct Token { value: i32 }
struct Shelf<'b> {
  inner: &'b Token
  count: i32
}
fn inner<'a, 'b>(outer: &'a Shelf<'b>) -> &'b Token { return outer.inner }
fn outer<'a, 'b>(shelf: &'a Shelf<'b>) -> &'a Shelf<'b> { return shelf }
fn outerAsInner<'a: 'b, 'b>(shelf: &'a Shelf<'b>) -> &'b i32 { return &shelf.count }
fn moveDescriptor() -> i32 {
  let held = Token {value: 1}
  let shelf = Shelf {inner: &held, count: 0}
  let view = inner(&shelf)
  let moved = move shelf
  drop move moved
  return view.value
}
fn writeInner() -> i32 {
  let mut held = Token {value: 1}
  let shelf = Shelf {inner: &held, count: 0}
  let view = inner(&shelf)
  held = Token {value: 2}
  return view.value
}
fn moveInner() -> i32 {
  let held = Token {value: 1}
  let shelf = Shelf {inner: &held, count: 0}
  let view = inner(&shelf)
  let consumed = move held
  return view.value + consumed.value
}
fn retainedOuter() -> i32 {
  let held = Token {value: 1}
  let shelf = Shelf {inner: &held, count: 0}
  let view = outer(&shelf)
  let consumed = move shelf
  return view.count + consumed.count
}
fn requiredOuter() -> i32 {
  let held = Token {value: 1}
  let mut shelf = Shelf {inner: &held, count: 1}
  let view = outerAsInner(&shelf)
  shelf = Shelf {inner: &held, count: 2}
  return view.*
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"moveDescriptor")
  run Testing.expect(hasBorrowStatus(&moved, BodyBorrowStatus.Checked), "the returned inner view does not borrow the local descriptor's storage")
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"writeInner")
  run Testing.expect(rejectsSpan(&written, RejectionCode.AccessDuringLoan, text, "held", 4),
    "releasing the descriptor keeps the actual inner owner borrowed")
  let consumed = run Semantic.demandBody(&mut store, &mut request, &id, b"moveInner")
  run Testing.expect(rejectsSpan(&consumed, RejectionCode.AccessDuringLoan, text, "held", 7),
    "moving the actual inner owner while its result is live remains OWN0011")
  let retained = run Semantic.demandBody(&mut store, &mut request, &id, b"retainedOuter")
  run Testing.expect(rejectsSpan(&retained, RejectionCode.AccessDuringLoan, text, "shelf", 13),
    "a returned outer reference still borrows descriptor storage")
  let required = run Semantic.demandBody(&mut store, &mut request, &id, b"requiredOuter")
  run Testing.expect(rejectsSpan(&required, RejectionCode.AccessDuringLoan, text, "shelf", 16),
    "an outer-to-inner bound can retain outer storage despite the inner-labelled result")
  return ()
}


test effect fn declaredCallSourcesKeepConflictsExact() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
