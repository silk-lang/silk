}
fn peek<'a>(holder: &Holder<'a>) -> &'a Token { return holder.value }
fn throughField() -> i32 {
  let mut mine = Token {value: 1}
  let holder = Holder {value: &mine}
  let view = peek(&holder)
  mine = Token {value: 7}
  return view.value
}
fn pullTwice() -> i32 {
  let first = Token {value: 1}
  let mut holder = Holder {value: &first}
