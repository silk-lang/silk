effect fn mutableSectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("mutable-section.silk")
  let text = """
fn edit(amount: i32, counter: &mut i32) -> i32 { counter.* = counter.* + amount return counter.* }
fn main() -> i32 {
  let mut counter = 0
  let mut editStep = edit(&mut counter)
  let first = editStep(1)
  return first + editStep(2)
}
fn immutableUse() -> i32 { let mut counter = 0 let readOnlyStep = edit(&mut counter) return readOnlyStep(1) }
fn movedExclusive<'a>(value: &'a mut i32) -> i32 { let ownedStep = edit(move value) return ownedStep(1) }
fn repeatedExclusive<'a>(value: &'a mut i32) -> i32 {
  let movedStep = edit(move value)
  let first = movedStep(1)
  return first + movedStep(2)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let rejected = run Semantic.demandBody(&mut store, &mut request, &id, b"immutableUse")
  let owned = run Semantic.demandMir(&mut store, &mut request, &id, b"movedExclusive")
  let repeated = run Semantic.demandBody(&mut store, &mut request, &id, b"repeatedExclusive")
  run Testing.expect(succeeded(&answer) && sectionInvocationCount(&store, &answer, b"edit", false) == 2,
    "mutable sections repeatedly pass their stored exclusive descriptor to the original target")
  run Testing.expect(rejectsSpan(&rejected, RejectionCode.InvalidCallableInvocationAccess,
    text, "readOnlyStep", usize.ONE), "a mutable section requires a writable callable binding (SEM0077)")
  run Testing.expect(succeeded(&owned) && sectionInvocationCount(&store, &owned, b"edit", true) == usize.ONE,
    "moving an exclusive view makes its section once and permits an immutable callable binding")
  run Testing.expect(rejectsSpan(&repeated, RejectionCode.UseAfterMove, text, "movedStep", 2),
    "a second invocation of a moved-exclusive section rejects its consumed callee (OWN0001)")
}

test effect fn namedOnceSectionsTransferAndCleanOwnedCaptures() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run onceSectionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn sectionEnvironmentCleanupOnExit(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Return {..} = &blocks[at].terminator {
          if sectionExitDrops(Vector.asSlice<MirStatement>(&blocks[at].statements), Vector.asSlice<MirLocal>(&function.locals)) { return true }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn sectionExitDrops(statements: &[MirStatement], locals: &[MirLocal]) -> bool {
  let mut returnsNine = false
  let mut dropsEnvironment = false
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Assign {destination, value: MirRvalue.Use {value: MirOperand.Integer {decimal, negative, ..}}, ..} = &statements[at] {
      let digits = Bytes.asSlice(&decimal)
      if destination.local == usize.ZERO && Vector.length<MirProjection>(&destination.projections) == usize.ZERO
        && !negative && digits.length == usize.ONE && digits[usize.ZERO] == 57 { returnsNine = true }
    }
    if let MirStatement.Drop {destination, ..} = &statements[at] {
      if Vector.length<MirProjection>(&destination.projections) == usize.ZERO {
        if Shared.with<Type, bool>(&locals[destination.local].ty, fn(value: &Type) -> bool {
          return match &value.* { Type.CallableValue {..} => true _ => false }
        }) { dropsEnvironment = true }
      }
    }
    at = at + usize.ONE
  }
  return returnsNine && dropsEnvironment
}

effect fn onceSectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("once-section.silk")
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn take(amount: i32, token: Token) -> i32 { return amount + token.value }
fn main(token: Token, choice: i32) -> i32 {
  let takeStep = take(move token)
  return takeStep(match choice { 0 => { return 9 } _ => 2 })
}
fn repeated(token: Token) -> i32 {
  let singleStep = take(move token)
  let first = singleStep(1)
  return first + singleStep(2)
}
fn constructionOnly(spentToken: Token) -> () { let removed = move spentToken let invalid = take(move spentToken) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let target = run Semantic.demandMir(&mut store, &mut request, &id, b"take")
  let repeated = run Semantic.demandBody(&mut store, &mut request, &id, b"repeated")
  let construction = run Semantic.demandBody(&mut store, &mut request, &id, b"constructionOnly")
  run Testing.expect(succeeded(&caller) && succeeded(&target)
    && sectionInvocationCount(&store, &caller, b"take", true) == usize.ONE
    && glueFact(&store, &caller, usize.ZERO) == usize.ONE && sectionEnvironmentCleanupOnExit(&store, &caller)
    && glueFact(&store, &target, usize.ZERO) == usize.ONE,
    "once sections transfer their field on the call edge and drop their pending environment only on argument exit")
  run Testing.expect(rejectsSpan(&repeated, RejectionCode.UseAfterMove, text, "singleStep", 2),
    "a second once-section call rejects its consumed callee (OWN0001)")
  run Testing.expect(rejectsSpan(&construction, RejectionCode.UseAfterMove, text, "move spentToken", usize.ONE),
    "a construction-only section rejects an already moved argument (OWN0001)")
}

fn stagedNamedArguments(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          let original = Shared.with<DeclarationId, bool>(&identity,
            fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"combine") })
          let operands = Vector.asSlice<MirOperand>(&arguments)
          if original && operands.length == 3 {
            return sectionStoredField(&operands[usize.ONE], usize.ONE)
              && sectionStoredField(&operands[2], usize.ZERO)
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

