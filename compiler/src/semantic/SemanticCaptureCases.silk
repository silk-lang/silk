  let o2CallResult = run Semantic.demandBody(&mut store, &mut request, &id, b"o2CallResult")
  let o2CallValue = run Semantic.demandBody(&mut store, &mut request, &id, b"o2CallValue")
  let o2Literal = run Semantic.demandBody(&mut store, &mut request, &id, b"o2Literal")
  run Testing.expect(rejectsSpan(&o2CallResult, RejectionCode.AccessDuringLoan, text, "src.t", 92)
