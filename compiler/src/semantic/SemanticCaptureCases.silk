effect fn callableParameterRejectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("callable-parameter-rejection.silk")
  let text = """
fn accepts<F: fn<'static>(i32) -> i32>(callback: F) -> () { return () }
fn wrongResult() -> () {
  let booleanResult = fn(value: i32) -> bool { return true }
  accepts(booleanResult)
}
fn wrongMode(token: i32) -> () {
  let mut counter = token
  let mutableArgument = fn(value: i32) -> i32 { counter = value return counter }
  accepts(mutableArgument)
}
fn wrongArity() -> () {
  let twoInputs = fn(first: i32, last: i32) -> i32 { return first + last }
  accepts(twoInputs)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let result = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongResult")
  let mode = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongMode")
  let arity = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongArity")
  run Testing.expect(rejectsSpan(&result, RejectionCode.TypeArgumentInference, text, "accepts(booleanResult)", usize.ZERO),
    "an incompatible callable result prevents specialization (SEM0052 on the whole call)")
  run Testing.expect(rejectsSpan(&mode, RejectionCode.TypeArgumentInference, text, "accepts(mutableArgument)", usize.ZERO),
    "an incompatible invocation mode prevents specialization at the call span")
  run Testing.expect(rejectsSpan(&arity, RejectionCode.TypeArgumentInference, text, "accepts(twoInputs)", usize.ZERO),
    "an incompatible callable arity prevents specialization at the call span")
}

test effect fn callableParameterKeepsInvocationRigidsAndBorrowedOwnersOutOfInference() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run callableParameterBoundaryClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn callableParameterBoundaryClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("callable-parameter-boundaries.silk")
  let text = """
fn acceptAny<T, F: for<'a> fn<'static>(&'a i32) -> T>(callback: F) -> () { return () }
fn escapingResult() -> () {
  let quantifiedIdentity = fn(value: &i32) -> &i32 { return value }
  acceptAny(quantifiedIdentity)
}
fn namedIdentity<'a>(value: &'a i32) -> &'a i32 { return value }
fn namedEscaping() -> () { acceptAny(namedIdentity) }
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn acceptOwned<G: once fn<'static>() -> i32>(callback: G) -> () { return () }
fn borrowedOwner(token: Token) -> () {
  let ownedCallback = fn() -> i32 { let selected = move token return selected.value }
  acceptOwned(&ownedCallback)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let escaping = run Semantic.demandBody(&mut store, &mut request, &id, b"escapingResult")
  let borrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowedOwner")
  let named = run Semantic.demandBody(&mut store, &mut request, &id, b"namedEscaping")
  run Testing.expect(rejectsSpan(&named, RejectionCode.TypeArgumentInference, text, "acceptAny(namedIdentity)", usize.ZERO),
    "a named schema's comparison-local invocation result never becomes an outer selected type argument")
  run Testing.expect(rejectsSpan(&escaping, RejectionCode.TypeArgumentInference, text, "acceptAny(quantifiedIdentity)", usize.ZERO),
    "comparison-local invocation binders never escape into an outer generic argument")
  run Testing.expect(rejectsSpan(&borrowed, RejectionCode.TypeArgumentInference, text, "acceptOwned(&ownedCallback)", usize.ZERO),
    "a shared reference cannot become an owned once-callable representation")
  let protectedUnused = run quantifiedUnusedNestedMetadata()
  run Testing.expect(protectedUnused,
    "an independently bound nested metadata contract remains a quantifier barrier even when its binder has no occurrences")
}

effect fn quantifiedUnusedNestedMetadata() -> bool ! OutOfMemoryError ? &mut Allocator {
  // Source normalization erases unused authored binders. Proof metadata still permits an
  // independently bound contract whose count is nonzero and has no lifetime occurrences.
  let scalar = run specializationPrimitive(b"i32")
  let empty = run Shared.make<Intersection>(Intersection {members: Vector.make<LifetimeMember>()})
  let inner = run Shared.make<Type>(Type.Callable {mode: CallableMode.Shared, isUnsafe: false,
    environment: Shared.clone<Intersection>(&empty), invocationBinders: usize.ONE, invocationUse: usize.MAX,
    invocationBounds: Vector.make<Outlives>(), parameters: Vector.make<Shared<Type>>(), result: Shared.clone<Type>(&scalar)})
  let mut parameters = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut parameters, move inner)
  let outer = run Shared.make<Type>(Type.Callable {mode: CallableMode.Shared, isUnsafe: false,
    environment: move empty, invocationBinders: usize.ZERO, invocationUse: usize.MAX, invocationBounds: Vector.make<Outlives>(),
    parameters: move parameters, result: move scalar})
  return Type.containsInvocationQuantifier(&outer)
}

