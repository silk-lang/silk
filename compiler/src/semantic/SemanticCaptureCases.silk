effect fn localMeetSourceClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("local-meet-sources.silk")
  let text = """
struct Token { value: i32 }
fn read<'a>(value: &'a Token) -> i32 { return value.value }
fn selected(flag: bool) -> i32 {
  let left = Token {value: 1}
  let right = Token {value: 2}
  let mut held = &left
  if flag { held = &right }
  return read(held)
}
fn expired(flag: bool) -> i32 {
  let left = Token {value: 1}
  let mut held = &left
  if flag {
    let right = Token {value: 2}
    held = &right
  }
  return read(held)
}
fn written(flag: bool) -> i32 {
  let left = Token {value: 1}
  let mut right = Token {value: 2}
  let mut held = &left
  if flag { held = &right }
  right = Token {value: 3}
  return read(held)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let selected = run Semantic.demandBody(&mut store, &mut request, &id, b"selected")
  run Testing.expect(hasBorrowStatus(&selected, BodyBorrowStatus.Checked),
    "a later consumer is covered by both live sources of the selected reference")
  let expired = run Semantic.demandBody(&mut store, &mut request, &id, b"expired")
  run Testing.expect(rejectsSpan(&expired, RejectionCode.ExpiredLifetime, text, "held", 5),
    "one ended source still rejects use of the selected reference")
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"written")
  run Testing.expect(rejectsSpan(&written, RejectionCode.AccessDuringLoan, text, "right", 6),
    "a write to either possible source conflicts with a later read")
  return ()
}


test effect fn emptyPrefixChoicesKeepLaterBorrowConstraints() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run emptyPrefixChoiceClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn emptyPrefixChoiceClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("empty-prefix-choice.silk")
  let text = """
struct Token { value: i32 }
union Maybe<T> { Empty, Held {value: T} }
fn fresh<T>() -> Maybe<T> { return Maybe<T>.Empty }
effect fn consume<'a>(value: &'a Token, optional: Maybe<&'a Token>) -> i32 {
  return match move optional { Maybe<&'a Token>.Empty => value.value Maybe<&'a Token>.Held {value: held} => held.value }
}
fn empty() -> i32 {
  let local = Token {value: 1}
  return run consume(&local, fresh<&Token>())
}
fn populated() -> i32 {
  let local = Token {value: 1}
  let mut slot = fresh<&Token>()
  slot = Maybe<&Token>.Held {value: &local}
  return run consume(&local, move slot)
}
fn expired() -> i32 {
  let outer = Token {value: 1}
  let mut slot = fresh<&Token>()
  if true {
    let inner = Token {value: 2}
    slot = Maybe<&Token>.Held {value: &inner}
  }
  return run consume(&outer, move slot)
}
fn written() -> i32 {
  let outer = Token {value: 1}
  let mut inner = Token {value: 2}
  let mut slot = fresh<&Token>()
  slot = Maybe<&Token>.Held {value: &inner}
  inner = Token {value: 3}
  return run consume(&outer, move slot)
}
fn escaped() -> Maybe<&'static Token> {
  let inner = Token {value: 2}
  let mut slot = fresh<&Token>()
  slot = Maybe<&Token>.Held {value: &inner}
  return move slot
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let empty = run Semantic.demandBody(&mut store, &mut request, &id, b"empty")
  let populated = run Semantic.demandBody(&mut store, &mut request, &id, b"populated")
  let expired = run Semantic.demandBody(&mut store, &mut request, &id, b"expired")
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"written")
  let escaped = run Semantic.demandBody(&mut store, &mut request, &id, b"escaped")
  run Testing.expect(hasBorrowStatus(&empty, BodyBorrowStatus.Checked),
    "an empty generic result's body-scoped lifetime choice can be constrained by its consumer")
  run Testing.expect(hasBorrowStatus(&populated, BodyBorrowStatus.Checked),
    "filling the result with a live reference retains its actual source constraint")
  run Testing.expect(rejectsSpan(&expired, RejectionCode.ExpiredLifetime, text, "move slot", 1),
    "a choice cannot keep an inserted reference alive beyond its owner")
  run Testing.expect(rejectsSpan(&written, RejectionCode.AccessDuringLoan, text, "inner", 4),
    "a choice cannot hide a later conflicting write to the inserted source")
  run Testing.expect(rejectsSpan(&escaped, RejectionCode.ReturnTypeMismatch, text, "move slot", 3),
    "a body-scoped choice cannot extend a local source to static")
  return ()
}

test effect fn finiteSourcesKeepRealStorageEnds() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run finiteSourceClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn finiteSourceClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("finite-source-availability.silk")
  let text = """
struct Token { value: i32 }
fn view<'a>(value: &'a Token) -> &'a Token { return value }
fn choose<'a>(flag: bool, left: &'a Token, right: &'a Token) -> &'a Token {
  if flag { return left }
  return right
}
fn combine<'a, 'b: 'a>(left: &'a Token, right: &'b Token) -> i32 { return left.value + right.value }
fn descriptorEnds(flag: bool) -> i32 {
  let owner = Token {value: 1}
  let mut held = &owner
  if flag {
    let descriptor = &owner
    held = view(descriptor)
  }
  return held.value
}
fn alternatives(flag: bool) -> i32 {
  let first = Token {value: 1}
  let second = Token {value: 2}
  let third = Token {value: 3}
  return combine(&first, choose(flag, &second, &third))
}
fn expired(flag: bool) -> i32 {
  let outer = Token {value: 1}
  let mut held = &outer
  if flag {
    let inner = Token {value: 2}
    let descriptor = &inner
    held = view(descriptor)
  }
  return held.value
}
fn written(flag: bool) -> i32 {
  let left = Token {value: 1}
  let mut right = Token {value: 2}
  let held = choose(flag, &left, &right)
  right = Token {value: 3}
  return held.value
}
fn moved(flag: bool) -> i32 {
  let left = Token {value: 1}
  let right = Token {value: 2}
  let held = choose(flag, &left, &right)
  let taken = move right
  return held.value + taken.value
}
fn escaped<'a>() -> &'a Token {
  let local = Token {value: 1}
  let descriptor = &local
  return view(descriptor)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let descriptor = run Semantic.demandBody(&mut store, &mut request, &id, b"descriptorEnds")
  let alternatives = run Semantic.demandBody(&mut store, &mut request, &id, b"alternatives")
  let expired = run Semantic.demandBody(&mut store, &mut request, &id, b"expired")
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"written")
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"moved")
  let escaped = run Semantic.demandBody(&mut store, &mut request, &id, b"escaped")
  run Testing.expect(hasBorrowStatus(&descriptor, BodyBorrowStatus.Checked),
    "ending a temporary reference descriptor retains the still-live owned source")
  run Testing.expect(hasBorrowStatus(&alternatives, BodyBorrowStatus.Checked),
    "all known initialized alternatives cover the earlier call argument")
  run Testing.expect(rejectsSpan(&expired, RejectionCode.ExpiredLifetime, text, "held.value", 1),
    "ending actual owned storage still rejects a later use through a temporary descriptor")
  run Testing.expect(rejectsSpan(&written, RejectionCode.AccessDuringLoan, text, "right", 6),
    "every alternative stays borrowed until the selected result's last use")
  run Testing.expect(rejectsSpan(&moved, RejectionCode.AccessDuringLoan, text, "right", 9),
    "moving an alternative before the selected result's last use remains rejected")
  run Testing.expect(hasBorrowStatus(&escaped, BodyBorrowStatus.Regions),
    "finite owned provenance cannot prove an outward universal lifetime")
  return ()
}

test effect fn reborrowSourcesMustAllReachTheirTarget() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run reborrowSourceClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn reborrowSourceClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("reborrow-sources.silk")
  let text = """
struct Token { value: i32 }
impl Token { fn either<'a>(self: &'a Self, other: &'a Token) -> &'a Token { return other } }
struct Holder<'b> { r: &'b mut i32 }
struct SharedHolder<'b> { r: &'b i32 }
struct Owned { value: i32 }
struct OwnedHolder<'b> { r: &'b mut Owned }
struct Shelf<'b> { inner: &'b Token }
struct Loose<'a, 'b> { first: &'a i32  second: &'b i32 }
impl<'a, 'b: 'a> Loose<'a, 'b> {
  fn get(self: &Self) -> &'a i32 { return self.second }
  fn reborrowed(self: &Self) -> &'a i32 { let r = &self.second.* return r }
}
fn pick<'a>(left: &'a i32, right: &'a i32) -> &'a i32 { return right }
fn pickMut<'a>(left: &'a mut i32, right: &'a mut i32) -> &'a mut i32 { return move right }
fn second<T>(x: T, y: T) -> T { return move y }
fn pickMixed<'p, 'q>(x: &'p i32, y: &'q i32) -> &'p i32 { let r = pick(&x.*, y) return r }
fn pickReborrowed<'p, 'q>(x: &'p i32, y: &'q i32) -> &'p i32 { let r = pick(&x.*, y) let s = &r.* return s }
fn pickMutMixed<'p, 'q>(x: &'p mut i32, y: &'q mut i32) -> &'p mut i32 { let r = pickMut(&mut x.*, move y) return move r }
fn methodMixed<'p, 'q>(x: &'p Token, y: &'q Token) -> &'p Token { let r = x.either(y) return r }
fn genericMixed<'p, 'q>(x: &'p i32, y: &'q i32) -> &'p i32 { let r = second(&x.*, y) return move r }
effect fn effectMixed<'p, 'q>(x: &'p i32, y: &'q i32) -> &'p i32 { let r = pick(&x.*, y) return r }
fn pickBounded<'p, 'q: 'p>(x: &'p i32, y: &'q i32) -> &'p i32 { let r = pick(&x.*, y) return r }
fn mutField<'a, 'b>(h: &'a mut Holder<'b>) -> &'b mut i32 { let r = &mut h.r.* return move r }
fn mutFieldDirect<'a, 'b>(h: &'a mut Holder<'b>) -> &'b mut i32 { return &mut h.r.* }
fn ownedField<'a, 'b>(h: &'a mut OwnedHolder<'b>) -> &'b mut Owned { let r = &mut h.r.* return move r }
fn sharedOfMut<'a, 'b>(h: &'a Holder<'b>) -> &'b i32 { let r = &h.r.* return r }
fn sharedOutOfMut<'a, 'b>(h: &'a mut Holder<'b>) -> &'b i32 { let r = &h.r.* return r }
fn sharedField<'a, 'b>(h: &'a SharedHolder<'b>) -> &'b i32 { let r = &h.r.* return r }
fn mutFieldShorter<'a, 'b>(h: &'a mut Holder<'b>) -> &'a mut i32 { let r = &mut h.r.* return move r }
fn shelfInner<'a, 'b>(outer: &'a Shelf<'b>) -> &'a Token { let r = &outer.inner.* return r }
fn closureReborrow() -> i32 {
  let f = fn(x: &i32) -> &i32 { let r = &x.* return r }
  let v = 5
  return f(&v).*
}
effect fn effectCrossing<'a, 'b>(x: &'a i32, y: &'b i32) -> &'b i32 { let r = &y.* return r }
fn pick2<'a, 'b: 'a>(left: &'a i32, right: &'b i32) -> &'a i32 { return right }
fn pickMut2<'a, 'b: 'a>(left: &'a mut i32, right: &'b mut i32) -> &'a mut i32 { return move right }
struct Pair<'a, 'b: 'a> { first: &'a i32  second: &'b i32 }
fn secondOf<'a, 'b>(p: &Pair<'a, 'b>) -> &'a i32 { return p.second }
fn boundMixed<'p, 'q>(x: &'p i32, y: &'q i32) -> &'p i32 { let r = pick2(&x.*, y) return r }
fn boundMutMixed<'p, 'q>(x: &'p mut i32, y: &'q mut i32) -> &'p mut i32 { let r = pickMut2(&mut x.*, move y) return move r }
fn boundCovered<'p, 'q: 'p>(x: &'p i32, y: &'q i32) -> &'p i32 { let r = pick2(&x.*, y) return r }
fn pairMixed<'p, 'q>(x: &'p i32, y: &'q i32) -> &'p i32 { let pair = Pair {first: &x.*, second: y} let r = secondOf(&pair) return r }
fn pairUnbounded<'p, 'q>(x: &'p i32, y: &'q i32) -> &'p i32 { let pair = Pair {first: x, second: y} return secondOf(&pair) }
fn pairBounded<'p, 'q: 'p>(x: &'p i32, y: &'q i32) -> &'p i32 { let pair = Pair {first: x, second: y} return secondOf(&pair) }
struct Hold<'a, T: 'a> { r: &'a i32  t: T }
fn keepT<'a, T: 'a>(left: &'a i32, right: T) -> Hold<'a, T> { return Hold {r: left, t: move right} }
fn holdBare<'p, T>(x: &'p i32, y: T) -> Hold<'p, T> { let h = keepT(&x.*, move y) return move h }
fn holdCovered<'p, 'q, T: 'q>(x: &'p i32, y: T) -> Hold<'p, T> { let h = keepT(&x.*, move y) return move h }
fn holdLiteral<'p, T>(x: &'p i32, y: T) -> Hold<'p, T> { let h = Hold {r: &x.*, t: move y} return move h }
fn holdDeclared<'p, T: 'p>(x: &'p i32, y: T) -> Hold<'p, T> { let h = keepT(&x.*, move y) return move h }
fn holdLocals() -> i32 { let a = 1 let b = 2 let h = Hold {r: &a, t: &b} return h.r.* + h.t.* }
fn holdLocalAndParam<'p>(x: &'p i32) -> i32 { let b = 2 let h = Hold {r: x, t: &b} return h.t.* }
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let mut store = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.make()
  // A value entering a call region without a loan must reach the target too (review a1, x1,
  // a12, a17, a18, e1, d7).
  let pickMixed = run Semantic.demandBody(&mut store, &mut request, &id, b"pickMixed")
  run Testing.expect(!hasBorrowStatus(&pickMixed, BodyBorrowStatus.Checked),
    "a passed reference sharing a call region with a fresh borrow does not prove the fresh borrow's target")
  let pickReborrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"pickReborrowed")
  run Testing.expect(!hasBorrowStatus(&pickReborrowed, BodyBorrowStatus.Checked),
    "a reborrow of the mixed call result inherits the unproved source")
  let pickMutMixed = run Semantic.demandBody(&mut store, &mut request, &id, b"pickMutMixed")
  run Testing.expect(!hasBorrowStatus(&pickMutMixed, BodyBorrowStatus.Checked),
    "a forwarded exclusive reference sharing the call region is not proved for the other target")
  let methodMixed = run Semantic.demandBody(&mut store, &mut request, &id, b"methodMixed")
  run Testing.expect(!hasBorrowStatus(&methodMixed, BodyBorrowStatus.Checked),
    "a receiver auto-borrow does not prove an argument sharing its region")
  let genericMixed = run Semantic.demandBody(&mut store, &mut request, &id, b"genericMixed")
  run Testing.expect(!hasBorrowStatus(&genericMixed, BodyBorrowStatus.Checked),
    "a type parameter instantiated with both references does not prove either target")
  let effectMixed = run Semantic.demandBody(&mut store, &mut request, &id, b"effectMixed")
  run Testing.expect(!hasBorrowStatus(&effectMixed, BodyBorrowStatus.Checked),
    "an Effect body proves the mixed call region no more than a function")
  let pickBounded = run Semantic.demandBody(&mut store, &mut request, &id, b"pickBounded")
  run Testing.expect(hasBorrowStatus(&pickBounded, BodyBorrowStatus.Checked),
    "a declared bound proves the passed reference's region for the target")
  // A reborrow through several descriptors is bounded by each of them (review c6, c6b, c6c,
  // c6d, x2, x3, x4).
  let mutField = run Semantic.demandBody(&mut store, &mut request, &id, b"mutField")
  run Testing.expect(!hasBorrowStatus(&mutField, BodyBorrowStatus.Checked),
    "an exclusive reborrow through a shorter exclusive reference cannot have the inner lifetime")
  let mutFieldDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"mutFieldDirect")
  run Testing.expect(!hasBorrowStatus(&mutFieldDirect, BodyBorrowStatus.Checked),
    "a directly returned exclusive reborrow is bounded by the outer reference")
  let ownedField = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedField")
  run Testing.expect(!hasBorrowStatus(&ownedField, BodyBorrowStatus.Checked),
    "an exclusive reborrow of an owning referent is bounded by the outer reference")
  let sharedOfMut = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedOfMut")
  run Testing.expect(!hasBorrowStatus(&sharedOfMut, BodyBorrowStatus.Checked),
    "a shared reborrow of an exclusive referent behind a shared reference has the outer lifetime")
  let sharedOutOfMut = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedOutOfMut")
  run Testing.expect(!hasBorrowStatus(&sharedOutOfMut, BodyBorrowStatus.Checked),
    "a shared reborrow through an exclusive chain has the outer lifetime")
  let sharedField = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedField")
  run Testing.expect(hasBorrowStatus(&sharedField, BodyBorrowStatus.Checked),
    "a shared reborrow of a shared descriptor keeps its own lifetime")
  let mutFieldShorter = run Semantic.demandBody(&mut store, &mut request, &id, b"mutFieldShorter")
  run Testing.expect(hasBorrowStatus(&mutFieldShorter, BodyBorrowStatus.Checked),
    "an exclusive reborrow is proved for the outer reference's lifetime")
  let shelfInner = run Semantic.demandBody(&mut store, &mut request, &id, b"shelfInner")
  run Testing.expect(hasBorrowStatus(&shelfInner, BodyBorrowStatus.Checked),
    "a shared reborrow through shared references is proved for the outer lifetime")
  let closureReborrow = run Semantic.demandBody(&mut store, &mut request, &id, b"closureReborrow")
  run Testing.expect(hasBorrowStatus(&closureReborrow, BodyBorrowStatus.Checked),
    "a closure's parameter reborrow stays proved")
  let effectCrossing = run Semantic.demandBody(&mut store, &mut request, &id, b"effectCrossing")
  run Testing.expect(hasBorrowStatus(&effectCrossing, BodyBorrowStatus.Checked),
    "an Effect body's reborrow of its own parameter stays proved")
  // No member call proves an inherent implementation's bound yet (review b1, b2v).
  let get = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"get", usize.ZERO)
  let getBody = run Semantic.demandBodyOf(&mut store, &mut request, &get)
  run Testing.expect(loansProved(&getBody) && !hasBorrowStatus(&getBody, BodyBorrowStatus.Checked),
    "a conversion only an inherent implementation's bound implies leaves the member unproved")
  let reborrowed = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"reborrowed", usize.ZERO)
  let reborrowedBody = run Semantic.demandBodyOf(&mut store, &mut request, &reborrowed)
  run Testing.expect(loansProved(&reborrowedBody) && !hasBorrowStatus(&reborrowedBody, BodyBorrowStatus.Checked),
    "an inherent implementation's bound is not a premise of a member's reborrow proof")
  // A callee or struct bound proved only because a caller region encloses a fresh loan still
  // makes its longer side a source of that loan's region (review y1, y2, y5).
  let boundMixed = run Semantic.demandBody(&mut store, &mut request, &id, b"boundMixed")
  run Testing.expect(!hasBorrowStatus(&boundMixed, BodyBorrowStatus.Checked),
    "a callee bound into a fresh borrow's call region does not prove that borrow's target")
  let boundMutMixed = run Semantic.demandBody(&mut store, &mut request, &id, b"boundMutMixed")
  run Testing.expect(!hasBorrowStatus(&boundMutMixed, BodyBorrowStatus.Checked),
    "an exclusive reference forwarded through a callee bound is not proved for the other target")
  let boundCovered = run Semantic.demandBody(&mut store, &mut request, &id, b"boundCovered")
  run Testing.expect(hasBorrowStatus(&boundCovered, BodyBorrowStatus.Checked),
    "a declared bound proves the callee bound's source for the target")
  let pairMixed = run Semantic.demandBody(&mut store, &mut request, &id, b"pairMixed")
  run Testing.expect(!hasBorrowStatus(&pairMixed, BodyBorrowStatus.Checked),
    "a struct bound into a fresh borrow's region does not prove that borrow's target")
  // Construction proves a struct's declared region bounds, which its readers assume (review y3).
  let pairUnbounded = run Semantic.demandBody(&mut store, &mut request, &id, b"pairUnbounded")
  run Testing.expect(rejectsSpan(&pairUnbounded, RejectionCode.UnsatisfiedLifetimeBound, text, "Pair {first: x, second: y}", usize.ZERO),
    "building a struct whose declared region bound does not hold reports SEM0212 at the aggregate")
  let pairBounded = run Semantic.demandBody(&mut store, &mut request, &id, b"pairBounded")
  let secondOf = run Semantic.demandBody(&mut store, &mut request, &id, b"secondOf")
  run Testing.expect(hasBorrowStatus(&pairBounded, BodyBorrowStatus.Checked) && hasBorrowStatus(&secondOf, BodyBorrowStatus.Checked),
    "a declared bound proves the struct's bound at construction, and a reader assumes it")
  // A contents bound on a type parameter with no premise names no source region, so a fresh
  // loan's region it reaches stays open; a covering premise is that region's source (review h1,
  // h2, h5).
  let holdBare = run Semantic.demandBody(&mut store, &mut request, &id, b"holdBare")
  run Testing.expect(!hasBorrowStatus(&holdBare, BodyBorrowStatus.Checked),
    "a bare type parameter's contents bound into a fresh loan's region does not prove that region's target")
  let holdCovered = run Semantic.demandBody(&mut store, &mut request, &id, b"holdCovered")
  run Testing.expect(!hasBorrowStatus(&holdCovered, BodyBorrowStatus.Checked),
    "a caller premise covering a fresh loan's region is a source that must reach its target")
  let holdLiteral = run Semantic.demandBody(&mut store, &mut request, &id, b"holdLiteral")
  run Testing.expect(!hasBorrowStatus(&holdLiteral, BodyBorrowStatus.Checked),
    "a struct contents bound on a bare type parameter at a fresh loan stays open")
  let holdDeclared = run Semantic.demandBody(&mut store, &mut request, &id, b"holdDeclared")
  run Testing.expect(hasBorrowStatus(&holdDeclared, BodyBorrowStatus.Checked),
    "a premise for the target itself proves the contents bound's source")
  // Contents between body loans are chosen by the borrow checker (review h10v, h11v, h13v).
  let holdLocals = run Semantic.demandBody(&mut store, &mut request, &id, b"holdLocals")
  run Testing.expect(hasBorrowStatus(&holdLocals, BodyBorrowStatus.Checked),
    "a contents bound between two body loans is proved by the borrow checker")
  let holdLocalAndParam = run Semantic.demandBody(&mut store, &mut request, &id, b"holdLocalAndParam")
  run Testing.expect(hasBorrowStatus(&holdLocalAndParam, BodyBorrowStatus.Regions),
    "a body loan's contents bound against a parameter region is left to the borrow checker, not rejected")
  return ()
}
