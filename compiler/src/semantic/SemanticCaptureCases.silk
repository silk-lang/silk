effect fn anonymousBodyStoreClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("anonymous-body-stores.silk")
  let text = """
union Maybe<T> { Some {value: T}, None }
struct Token { value: i32 }
struct HeldSlot<'a> { view: Maybe<&'a i32> }
service Keeper<'k> { effect fn put(v: &'k Token) -> () ? &mut Keeper<'k> }
service Bin<T> { effect<'env> fn put<'env>(v: T) -> () ? &mut Bin<T> }
effect fn closure<'b>() -> () ? &mut Keeper<'b> {
  let local = Token { value: 1 }
  let mut f = effect fn() -> () ? &mut Keeper<'b> {
    let uv = 1
    let mut us = HeldSlot {view: Maybe<&i32>.Some {value: &uv}}
    let uo = Intrinsic.replace(us.view, Maybe<&i32>.None)
    run Keeper<'b>.put(&local)
  }
  run f()
  return ()
}
effect fn block<'b>() -> () ? &mut Keeper<'b> {
  let local = Token { value: 1 }
  let e = effect {
    let uv = 1
    let mut us = HeldSlot {view: Maybe<&i32>.Some {value: &uv}}
    let uo = Intrinsic.replace(us.view, Maybe<&i32>.None)
    run Keeper<'b>.put(&local)
  }
  run e
  return ()
}
effect fn closureBlock<'b>() -> () ? &mut Keeper<'b> {
  let local = Token { value: 1 }
  let mut f = effect fn() -> () ? &mut Keeper<'b> {
    let e = effect {
      let uv = 1
      let mut us = HeldSlot {view: Maybe<&i32>.Some {value: &uv}}
      let uo = Intrinsic.replace(us.view, Maybe<&i32>.None)
      run Keeper<'b>.put(&local)
    }
    run e
  }
  run f()
  return ()
}
effect fn closureClosure<'b>() -> () ? &mut Keeper<'b> {
  let local = Token { value: 1 }
  let mut f = effect fn() -> () ? &mut Keeper<'b> {
    let mut g = effect fn() -> () ? &mut Keeper<'b> {
      let uv = 1
      let mut us = HeldSlot {view: Maybe<&i32>.Some {value: &uv}}
      let uo = Intrinsic.replace(us.view, Maybe<&i32>.None)
      run Keeper<'b>.put(&local)
    }
    run g()
  }
  run f()
  return ()
}
effect fn rowParameter<'b, ?R>() -> () ? R | &mut Keeper<'b> {
  let local = Token { value: 1 }
  let mut f = effect fn() -> () ? R | &mut Keeper<'b> {
    let uv = 1
    let mut us = HeldSlot {view: Maybe<&i32>.Some {value: &uv}}
    let uo = Intrinsic.replace(us.view, Maybe<&i32>.None)
    run Keeper<'b>.put(&local)
  }
  run f()
  return ()
}
effect fn typeParameter<'b>() -> () ? &mut Bin<&'b Token> {
  let local = Token { value: 1 }
  let mut f = effect fn() -> () ? &mut Bin<&'b Token> {
    let uv = 1
    let mut us = HeldSlot {view: Maybe<&i32>.Some {value: &uv}}
    let uo = Intrinsic.replace(us.view, Maybe<&i32>.None)
    run Bin<&'b Token>.put(&local)
  }
  run f()
  return ()
}
effect fn provided<'b, P>(provider: &mut P) -> () where &mut P provides &mut Keeper<'b> from &mut Keeper<'b> {
  let local = Token { value: 1 }
  let mut f = effect fn() -> () ? &mut Keeper<'b> {
    let uv = 1
    let mut us = HeldSlot {view: Maybe<&i32>.Some {value: &uv}}
    let uo = Intrinsic.replace(us.view, Maybe<&i32>.None)
    run Keeper<'b>.put(&local)
  }
  run Intrinsic.bindRequirementMut<Keeper<'b>>(f(), &mut provider.*)
  return ()
}
effect fn ownStorage<'b>() -> () ? &mut Keeper<'b> {
  let local = Token { value: 1 }
  let f = effect fn() -> () ? &mut Keeper<'b> {
    let uv = 1
    let mut us = HeldSlot {view: Maybe<&i32>.Some {value: &uv}}
    let uo = Intrinsic.replace(us.view, Maybe<&i32>.None)
    let owned = move local
    run Keeper<'b>.put(&owned)
  }
  run f()
  return ()
}
struct Kept<'h> { view: &'h Token }
fn put<'k>(slot: &mut Kept<'k>, v: &'k Token) -> () {
  slot.view = v
  return ()
}
effect fn closureLocal<'b>(out: &mut Kept<'b>) -> i32 {
  let mut f = effect fn() -> i32 {
    let uv = 1
    let mut us = HeldSlot {view: Maybe<&i32>.Some {value: &uv}}
    let uo = Intrinsic.replace(us.view, Maybe<&i32>.None)
    let mine = Token { value: 2 }
    put(&mut out.*, &mine)
    return 0
  }
  return run f()
}
effect fn movedCapture<'b>(out: &mut Kept<'b>) -> i32 {
  let local = Token { value: 1 }
  let mut f = effect fn() -> i32 {
    let uv = 1
    let mut us = HeldSlot {view: Maybe<&i32>.Some {value: &uv}}
    let uo = Intrinsic.replace(us.view, Maybe<&i32>.None)
    let owned = move local
    put(&mut out.*, &owned)
    return 0
  }
  return run f()
}
effect fn checkedClosure<'b>(kept: &'b Token) -> () ? &mut Keeper<'b> {
  let local = Token { value: 1 }
  let mut f = effect fn() -> () ? &mut Keeper<'b> {
    let n = local.value
    run Keeper<'b>.put(kept)
  }
  run f()
  return ()
}
effect fn noRow() -> i32 {
  let local = Token { value: 1 }
  let mut f = effect fn() -> i32 {
    let uv = 1
    let mut us = HeldSlot {view: Maybe<&i32>.Some {value: &uv}}
    let uo = Intrinsic.replace(us.view, Maybe<&i32>.None)
    return local.value
  }
  return run f()
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let closure = run Semantic.demandBody(&mut store, &mut request, &id, b"closure")
  let block = run Semantic.demandBody(&mut store, &mut request, &id, b"block")
  let closureBlock = run Semantic.demandBody(&mut store, &mut request, &id, b"closureBlock")
  let closureClosure = run Semantic.demandBody(&mut store, &mut request, &id, b"closureClosure")
  let rowParameter = run Semantic.demandBody(&mut store, &mut request, &id, b"rowParameter")
  let typeParameter = run Semantic.demandBody(&mut store, &mut request, &id, b"typeParameter")
  let provided = run Semantic.demandBody(&mut store, &mut request, &id, b"provided")
  let noRow = run Semantic.demandBody(&mut store, &mut request, &id, b"noRow")
  let ownStorage = run Semantic.demandBody(&mut store, &mut request, &id, b"ownStorage")
  let closureLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"closureLocal")
  let movedCapture = run Semantic.demandBody(&mut store, &mut request, &id, b"movedCapture")
  let checkedClosure = run Semantic.demandBody(&mut store, &mut request, &id, b"checkedClosure")
  run Testing.expect(rejectsSpan(&closure, RejectionCode.UnsatisfiedLifetimeBound, text, "local", 1)
      && rejectsSpan(&block, RejectionCode.UnsatisfiedLifetimeBound, text, "local", 3),
    "an effect closure or block storing a captured local in a service its row names at a caller lifetime is refused at the capture (SEM0212)")
  run Testing.expect(rejectsSpan(&closureBlock, RejectionCode.UnsatisfiedLifetimeBound, text, "local", 5)
      && rejectsSpan(&closureClosure, RejectionCode.UnsatisfiedLifetimeBound, text, "local", 7),
    "a closure holding such a block or closure carries the same requirement to its creator (SEM0212)")
  run Testing.expect(rejectsSpan(&rowParameter, RejectionCode.UnsatisfiedLifetimeBound, text, "local", 9)
      && rejectsSpan(&typeParameter, RejectionCode.UnsatisfiedLifetimeBound, text, "local", 11)
      && rejectsSpan(&provided, RejectionCode.UnsatisfiedLifetimeBound, text, "local", 13),
    "a row with a row parameter, a service over a reference type, or a row a provider discharges still owes the service's lifetime (SEM0212)")
  run Testing.expect(rejectsSpan(&ownStorage, RejectionCode.UnsatisfiedLifetimeBound, text, "&owned", 0),
    "a closure storing its own local in a service at a caller lifetime refuses the borrow (SEM0212)")
  run Testing.expect(rejectsSpan(&closureLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&mine", 0) && rejectsSpan(&movedCapture, RejectionCode.UnsatisfiedLifetimeBound, text, "&owned", 1),
    "a closure storing its own local or a moved capture into a holder at the caller's lifetime refuses the borrow (SEM0212)")
  run Testing.expect(hasBorrowStatus(&noRow, BodyBorrowStatus.Checked),
    "a closure whose row stores nothing leaves the body checked")
  run Testing.expect(hasBorrowStatus(&checkedClosure, BodyBorrowStatus.Checked),
    "a closure the borrow check closed keeps its body checked")
  return ()
}

test effect fn innerResultsReleaseOnlyProvedDescriptorBorrows() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run innerResultRetentionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn innerResultRetentionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("inner-result-retention.silk")
  let text = """
struct Token { value: i32 }
struct Shelf<'b> {
  inner: &'b Token,
  count: i32,
}
fn inner<'a, 'b>(outer: &'a Shelf<'b>) -> &'b Token { return outer.inner }
fn outer<'a, 'b>(shelf: &'a Shelf<'b>) -> &'a Shelf<'b> { return shelf }
fn outerAsInner<'a: 'b, 'b>(shelf: &'a Shelf<'b>) -> &'b i32 { return &shelf.count }
fn moveDescriptor() -> i32 {
  let held = Token {value: 1}
  let shelf = Shelf {inner: &held, count: 0}
  let view = inner(&shelf)
  let moved = move shelf
  drop move moved
  return view.value
}
fn writeInner() -> i32 {
  let mut held = Token {value: 1}
  let shelf = Shelf {inner: &held, count: 0}
  let view = inner(&shelf)
  held = Token {value: 2}
  return view.value
}
fn moveInner() -> i32 {
  let held = Token {value: 1}
  let shelf = Shelf {inner: &held, count: 0}
  let view = inner(&shelf)
  let consumed = move held
  return view.value + consumed.value
}
fn retainedOuter() -> i32 {
  let held = Token {value: 1}
  let shelf = Shelf {inner: &held, count: 0}
  let view = outer(&shelf)
  let consumed = move shelf
  return view.count + consumed.count
}
fn requiredOuter() -> i32 {
  let held = Token {value: 1}
  let mut shelf = Shelf {inner: &held, count: 1}
  let view = outerAsInner(&shelf)
  shelf = Shelf {inner: &held, count: 2}
  return view.*
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"moveDescriptor")
  run Testing.expect(hasBorrowStatus(&moved, BodyBorrowStatus.Checked), "the returned inner view does not borrow the local descriptor's storage")
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"writeInner")
  run Testing.expect(rejectsSpan(&written, RejectionCode.AccessDuringLoan, text, "held", 4),
    "releasing the descriptor keeps the actual inner owner borrowed")
  let consumed = run Semantic.demandBody(&mut store, &mut request, &id, b"moveInner")
  run Testing.expect(rejectsSpan(&consumed, RejectionCode.AccessDuringLoan, text, "held", 7),
    "moving the actual inner owner while its result is live remains OWN0011")
  let retained = run Semantic.demandBody(&mut store, &mut request, &id, b"retainedOuter")
  run Testing.expect(rejectsSpan(&retained, RejectionCode.AccessDuringLoan, text, "shelf", 13),
    "a returned outer reference still borrows descriptor storage")
  let required = run Semantic.demandBody(&mut store, &mut request, &id, b"requiredOuter")
  run Testing.expect(rejectsSpan(&required, RejectionCode.AccessDuringLoan, text, "shelf", 16),
    "an outer-to-inner bound can retain outer storage despite the inner-labelled result")
  return ()
}


test effect fn declaredCallSourcesKeepConflictsExact() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run declaredCallSourceClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn declaredCallSourceClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("declared-call-sources.silk")
  let text = """
struct Token { value: i32 }
fn first<'a, 'b>(left: &'a Token, right: &'b Token) -> &'a Token { return left }
fn pick<'a>(left: &'a Token, right: &'a Token, chooseLeft: bool) -> &'a Token {
  if chooseLeft { return left }
  return right
}
fn identity<'a>(value: &'a Token) -> &'a Token { return value }
fn firstWrite() -> i32 {
  let mut left = Token {value: 1}
  let right = Token {value: 2}
  let view = first(&left, &right)
  left = Token {value: 3}
  return view.value
}
fn pickWrite(chooseLeft: bool) -> i32 {
  let left = Token {value: 1}
  let mut right = Token {value: 2}
  let view = pick(&left, &right, chooseLeft)
  right = Token {value: 4}
  return view.value
}
fn pickMove(chooseLeft: bool) -> i32 {
  let left = Token {value: 1}
  let right = Token {value: 2}
  let view = pick(&left, &right, chooseLeft)
  let moved = move left
  return view.value + moved.value
}
fn pickDrop(chooseLeft: bool) -> i32 {
  let left = Token {value: 1}
  let right = Token {value: 2}
  let view = pick(&left, &right, chooseLeft)
  drop right
  return view.value
}
fn pickExclusive(chooseLeft: bool) -> i32 {
  let mut left = Token {value: 1}
  let right = Token {value: 2}
  let view = pick(&left, &right, chooseLeft)
  let exclusive = &mut left
  return view.value + exclusive.value
}
fn forwarded(chooseLeft: bool) -> i32 {
  let mut left = Token {value: 1}
  let right = Token {value: 2}
  let selected = pick(&left, &right, chooseLeft)
  let view = identity(selected)
  left = Token {value: 5}
  return view.value
}
fn released(chooseLeft: bool) -> i32 {
  let mut left = Token {value: 1}
  let mut right = Token {value: 2}
  let view = pick(&left, &right, chooseLeft)
  let previous = view.value
  left = Token {value: 6}
  right = Token {value: 7}
  return previous + left.value + right.value
}
fn unrelated() -> i32 {
  let left = Token {value: 1}
  let mut right = Token {value: 2}
  let view = first(&left, &right)
  right = Token {value: 8}
  return view.value + right.value
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let first = run Semantic.demandBody(&mut store, &mut request, &id, b"firstWrite")
  run Testing.expect(rejectsSpan(&first, RejectionCode.AccessDuringLoan, text, "left", 6),
    "a distinct declared lifetime identifies the first argument's source despite shared call inference")
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"pickWrite")
  run Testing.expect(rejectsSpan(&written, RejectionCode.AccessDuringLoan, text, "right", 7),
    "either declared source of a shared-lifetime result must stay unmodified (OWN0011)")
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"pickMove")
  run Testing.expect(rejectsSpan(&moved, RejectionCode.AccessDuringLoan, text, "left", 11),
    "moving a declared result source before the result's last use is OWN0011")
  let dropped = run Semantic.demandBody(&mut store, &mut request, &id, b"pickDrop")
  run Testing.expect(rejectsSpan(&dropped, RejectionCode.AccessDuringLoan, text, "drop right", usize.ZERO),
    "dropping another declared result source before the result's last use is OWN0011")
  let exclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"pickExclusive")
  run Testing.expect(rejectsSpan(&exclusive, RejectionCode.LoanConflict, text, "&mut left", usize.ZERO),
    "a live declared shared result source cannot be borrowed exclusively (OWN0010)")
  let forwarded = run Semantic.demandBody(&mut store, &mut request, &id, b"forwarded")
  run Testing.expect(rejectsSpan(&forwarded, RejectionCode.AccessDuringLoan, text, "left", 19),
    "passing the selected result through identity keeps its source loans")
  let released = run Semantic.demandBody(&mut store, &mut request, &id, b"released")
  run Testing.expect(hasBorrowStatus(&released, BodyBorrowStatus.Checked),
    "every declared result source is released after the result's last use")
  let unrelated = run Semantic.demandBody(&mut store, &mut request, &id, b"unrelated")
  run Testing.expect(hasBorrowStatus(&unrelated, BodyBorrowStatus.Checked),
    "coalesced inference cannot promote the unrelated second argument to retention: the declared signature releases it")
  return ()
}

test effect fn finiteOwnedReborrowsKeepEverySourceAlive() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run finiteOwnedReborrowClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn finiteOwnedReborrowClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("finite-owned-reborrows.silk")
  let text = """
struct Token { value: i32 }
fn view<'a>(token: &'a Token) -> &'a Token { return token }
fn finite() -> i32 {
  let held = Token {value: 1}
  let first = view(&held)
  let mut second = view(&first.*)
  let third = view(&second.*)
  return third.value
}
fn writeOwner() -> i32 {
  let mut held = Token {value: 1}
  let first = view(&held)
  let mut second = view(&first.*)
  held = Token {value: 2}
  return second.value
}
fn moveOwner() -> i32 {
  let held = Token {value: 1}
  let first = view(&held)
  let mut second = view(&first.*)
  let consumed = move held
  return second.value + consumed.value
}
fn dropOwner() -> i32 {
  let held = Token {value: 1}
  let first = view(&held)
  let mut second = view(&first.*)
  drop move held
  return second.value
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let finite = run Semantic.demandBody(&mut store, &mut request, &id, b"finite")
  run Testing.expect(hasBorrowStatus(&finite, BodyBorrowStatus.Checked),
    "finite parent point requirements prove nested local reborrows without a universal root")
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"writeOwner")
  run Testing.expect(rejectsSpan(&written, RejectionCode.AccessDuringLoan, text, "held", 4),
    "a finite proof cannot permit replacing the original owner through a retained descendant")
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"moveOwner")
  run Testing.expect(rejectsSpan(&moved, RejectionCode.AccessDuringLoan, text, "held", 7),
    "a retained descendant still prevents moving its original owner")
  let dropped = run Semantic.demandBody(&mut store, &mut request, &id, b"dropOwner")
  run Testing.expect(rejectsSpan(&dropped, RejectionCode.AccessDuringLoan, text, "held", 10),
    "a retained descendant still prevents dropping its original owner")
  return ()
}


test effect fn completeResultSourcesReleaseUnrelatedOwnedInputs() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run unrelatedOwnedInputClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn unrelatedOwnedInputClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("unrelated-owned-inputs.silk")
  let text = """
struct Token { value: i32 }
fn lookup<'a, 'b>(source: &'a Token, key: &'b Token) -> &'a Token { return source }
fn lookupRequired<'a, 'b: 'a>(source: &'a Token, key: &'b Token) -> &'a Token { return key }
fn replaceKey() -> i32 {
  let source = Token {value: 1}
  let mut key = Token {value: 2}
  let held = &source
  let view = lookup(held, &key)
  key = Token {value: 3}
  return view.value + key.value
}
fn moveKey() -> i32 {
  let source = Token {value: 1}
  let key = Token {value: 2}
  let held = &source
  let view = lookup(held, &key)
  let moved = move key
  return view.value + moved.value
}
fn replaceSource() -> i32 {
  let mut source = Token {value: 1}
  let key = Token {value: 2}
  let held = &source
  let view = lookup(held, &key)
  source = Token {value: 4}
  return view.value
}
fn requiredKey() -> i32 {
  let source = Token {value: 1}
  let mut key = Token {value: 2}
  let held = &source
  let view = lookupRequired(held, &key)
  key = Token {value: 5}
  return view.value
}
fn externalKey(key: &mut Token) -> i32 {
  let source = Token {value: 1}
  let held = &source
  let view = lookup(held, &key.*)
  key.value = 7
  return view.value
}
fn sharedInference() -> i32 {
  let source = Token {value: 1}
  let mut key = Token {value: 2}
  let view = lookup(&source, &key)
  key = Token {value: 6}
  return view.value
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let replaced = run Semantic.demandBody(&mut store, &mut request, &id, b"replaceKey")
  run Testing.expect(hasBorrowStatus(&replaced, BodyBorrowStatus.Checked),
    "a complete result with a distinct source atom releases its unrelated owned lookup key")
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"moveKey")
  run Testing.expect(hasBorrowStatus(&moved, BodyBorrowStatus.Checked),
    "moving the unrelated key does not invalidate the retained source")
  let source = run Semantic.demandBody(&mut store, &mut request, &id, b"replaceSource")
  run Testing.expect(rejectsSpan(&source, RejectionCode.AccessDuringLoan, text, "source", 9),
    "releasing the key never releases the actual result source (OWN0011)")
  let required = run Semantic.demandBody(&mut store, &mut request, &id, b"requiredKey")
  run Testing.expect(rejectsSpan(&required, RejectionCode.AccessDuringLoan, text, "key", 14),
    "a callee bound retains a required key even when its atom differs from the result (OWN0011)")
  let external = run Semantic.demandBody(&mut store, &mut request, &id, b"externalKey")
  run Testing.expect(hasBorrowStatus(&external, BodyBorrowStatus.Checked),
    "the closed result contract excludes the unrelated external key while retaining the actual source")
  let shared = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedInference")
  run Testing.expect(hasBorrowStatus(&shared, BodyBorrowStatus.Checked),
    "coalesced fresh call atoms do not make the key a source: the declared signature releases it, so replacing it is accepted")
  return ()
}

test effect fn implicitReceiverBorrowsRetainStoredSources() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run receiverContentsClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn receiverContentsClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("receiver-contents.silk")
  let text = """
struct Token { value: i32 }
struct Shelf<'a> { inner: &'a Token }
impl<'a> Shelf<'a> {
  fn view<'b>(self: &'b Shelf<'a>) -> &'b Token { return self.inner }
  fn label(self: &Shelf<'a>) -> string<'static> { return "shelf" }
}
fn written() -> i32 {
  let mut held = Token {value: 1}
  let shelf = Shelf {inner: &held}
  let view = shelf.view()
  held = Token {value: 2}
  return view.value
}
fn moved() -> i32 {
  let held = Token {value: 1}
  let shelf = Shelf {inner: &held}
  let view = shelf.view()
  let taken = move held
  return view.value + taken.value
}
fn released() -> i32 {
  let mut held = Token {value: 1}
  let shelf = Shelf {inner: &held}
  let view = shelf.view()
  let seen = view.value
  held = Token {value: 3}
  return seen + held.value
}
fn unrelated() -> string<'static> {
  let mut held = Token {value: 1}
  let shelf = Shelf {inner: &held}
  let result = shelf.label()
  held = Token {value: 4}
  return result
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"written")
  run Testing.expect(rejectsSpan(&written, RejectionCode.AccessDuringLoan, text, "held", 2),
    "an implicit receiver's result retains the stored referent and rejects its conflicting write")
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"moved")
  run Testing.expect(rejectsSpan(&moved, RejectionCode.AccessDuringLoan, text, "held", 5),
    "the same receiver contract prevents moving the stored referent before its last use")
  let released = run Semantic.demandBody(&mut store, &mut request, &id, b"released")
  run Testing.expect(hasBorrowStatus(&released, BodyBorrowStatus.Checked),
    "the implicit receiver's source loan still ends after the result's last use")
  let unrelated = run Semantic.demandBody(&mut store, &mut request, &id, b"unrelated")
  run Testing.expect(hasBorrowStatus(&unrelated, BodyBorrowStatus.Checked),
    "an unrelated static result does not retain the receiver's stored referent")
  return ()
}

test effect fn argumentIntervalsExcludeAbandonedReturnPaths() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run argumentIntervalClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn argumentIntervalClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("argument-interval-paths.silk")
  let text = """
struct Token { value: i32 }
fn readAfter<'a: 'b, 'b>(left: &'a Token, right: &'b Token) -> i32 { return left.value }
fn readAfterWrite<'a: 'b, 'b>(left: &'a Token, ready: (), right: &'b Token) -> i32 { return left.value }
fn earlyReturn<'input>(input: &'input Token, stop: bool) -> i32 {
  let source = Token {value: 1}
  let held = &source
  return readAfter(held, match stop {
    _ if stop => { return 0 }
    _ => &input.*
  })
}
fn writeThenUse<'input>(input: &'input Token, change: bool) -> i32 {
  let mut source = Token {value: 1}
  let held = &source
  return readAfterWrite(held, match change {
    _ if change => { source = Token {value: 2} }
    _ => ()
  }, &input.*)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let early = run Semantic.demandBody(&mut store, &mut request, &id, b"earlyReturn")
  run Testing.expect(hasBorrowStatus(&early, BodyBorrowStatus.Checked),
    "an abandoned call does not require its first operand's loan after the early return cleans its owner")
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"writeThenUse")
  run Testing.expect(rejectsSpan(&written, RejectionCode.AccessDuringLoan, text, "source", 4),
    "a branch reaching the call still rejects a conflicting write before the first operand's consumption")
  return ()
}


test effect fn initializedStorageCoversEarlierCallArguments() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run initializedStorageClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn initializedStorageClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("initialized-storage.silk")
  let text = """
struct Token { value: i32 }
fn view<'a>(value: &'a Token) -> &'a Token { return value }
fn combine<'a, 'b: 'a>(left: &'a Token, right: &'b Token) -> i32 {
  return left.value + right.value
}
fn earlierArgument() -> i32 {
  let left = Token {value: 1}
  let right = Token {value: 2}
  return combine(&left, view(&right))
}
fn expired(flag: bool) -> i32 {
  let left = Token {value: 1}
  let mut held = &left
  if flag {
    let right = Token {value: 2}
    held = view(&right)
  }
  return combine(&left, held)
}
fn writeThenUse() -> i32 {
  let left = Token {value: 1}
  let mut right = Token {value: 2}
  let held = view(&right)
  right = Token {value: 3}
  return combine(&left, held)
}
fn escape<'a>() -> &'a Token {
  let local = Token {value: 1}
  return view(&local)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let earlier = run Semantic.demandBody(&mut store, &mut request, &id, b"earlierArgument")
  run Testing.expect(hasBorrowStatus(&earlier, BodyBorrowStatus.Checked),
    "an owned value initialized before argument evaluation covers the earlier argument's finite use")
  let expired = run Semantic.demandBody(&mut store, &mut request, &id, b"expired")
  run Testing.expect(rejectsSpan(&expired, RejectionCode.ExpiredLifetime, text, "held", 2),
    "storage initialization never permits a view after its inner owner has ended")
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"writeThenUse")
  run Testing.expect(rejectsSpan(&written, RejectionCode.AccessDuringLoan, text, "right", 8),
    "a real write while the view is live still rejects OWN0011")
  let escaped = run Semantic.demandBody(&mut store, &mut request, &id, b"escape")
  run Testing.expect(rejectsSpan(&escaped, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", usize.ZERO),
    "finite initialized storage cannot justify an outward caller lifetime, which the returned result refutes (SEM0212)")
  return ()
}


test effect fn localMeetSourcesCoverConsumption() -> ()
