  let leakedArrayLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"leakArrayLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let keptInitializer = run Semantic.demandBody(&mut store, &mut request, &id, b"initSameRegion") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let distinctRegions = run Semantic.demandBody(&mut store, &mut request, &id, b"distinctRegions") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongRegionElement = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongRegionElement") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let fixedRegions = run Semantic.demandBody(&mut store, &mut request, &id, b"fixedRegions") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let temporary = run Semantic.demandBody(&mut store, &mut request, &id, b"temporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mutableTemporary = run Semantic.demandBody(&mut store, &mut request, &id, b"mutableTemporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let narrowTemporary = run Semantic.demandBody(&mut store, &mut request, &id, b"narrowTemporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
