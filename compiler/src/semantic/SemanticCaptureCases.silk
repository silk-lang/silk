effect fn stagedExitClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("staged-exit.silk")
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn main(base: Token, suffix: Token, choice: i32) -> i32 {
  let original = fn(first: i32, middle: Token, last: i32) -> i32 {
    let captured = move base
    return captured.value + middle.value + first + last
  }
  let next = original(move suffix, match choice { 0 => { return 9 } _ => 2 })
  return next(1)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller) && stagedExitOwners(&store, &caller)
    && glueFact(&store, &caller, usize.ZERO) == 2,
    "an exiting later suffix drops the transferred base and earlier owned suffix exactly on the exit edge")
  let selected = anonymousMirApplication(&store, &caller)
  if let Option<Shared<SpecializationApplication>>.Some {value} = move selected {
    let application = run SpecializationApplication.copyShared(&value)
    let target = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&target) && glueFact(&store, &target, usize.ZERO) == 2,
      "on the ordinary call edge the target owns both captures and the caller retains neither cleanup owner")
    return ()
  }
  run Testing.expect(false, "staged invocation keeps its original anonymous target")
}

