  run Testing.expect(rejectsSpan(&rowReturnsUniversal, RejectionCode.AccessDuringLoan, text, "srcR2.t", 1),
    "a universal view a closure's returned Effect can give a service its row names outlives the body (OWN0011)")
  run Testing.expect(hasBorrowStatus(&rowRunsBefore, BodyBorrowStatus.Checked),
