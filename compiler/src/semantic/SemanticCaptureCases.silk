}

effect fn unrelatedOwnedInputClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("unrelated-owned-inputs.silk")
  let text = """
struct Token { value: i32 }
fn lookup<'a, 'b>(source: &'a Token, key: &'b Token) -> &'a Token { return source }
fn lookupRequired<'a, 'b: 'a>(source: &'a Token, key: &'b Token) -> &'a Token { return key }
fn replaceKey() -> i32 {
  let source = Token {value: 1}
  let mut key = Token {value: 2}
  let held = &source
  let view = lookup(held, &key)
  key = Token {value: 3}
  return view.value + key.value
}
fn moveKey() -> i32 {
  let source = Token {value: 1}
  let key = Token {value: 2}
  let held = &source
  let view = lookup(held, &key)
  let moved = move key
  return view.value + moved.value
}
fn replaceSource() -> i32 {
  let mut source = Token {value: 1}
  let key = Token {value: 2}
  let held = &source
  let view = lookup(held, &key)
  source = Token {value: 4}
  return view.value
}
fn requiredKey() -> i32 {
  let source = Token {value: 1}
  let mut key = Token {value: 2}
  let held = &source
  let view = lookupRequired(held, &key)
  key = Token {value: 5}
  return view.value
}
fn externalKey(key: &mut Token) -> i32 {
  let source = Token {value: 1}
  let held = &source
  let view = lookup(held, &key.*)
  key.value = 7
  return view.value
}
fn sharedInference() -> i32 {
  let source = Token {value: 1}
  let mut key = Token {value: 2}
  let view = lookup(&source, &key)
  key = Token {value: 6}
  return view.value
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let replaced = run Semantic.demandBody(&mut store, &mut request, &id, b"replaceKey")
  run Testing.expect(hasBorrowStatus(&replaced, BodyBorrowStatus.Checked),
    "a complete result with a distinct source atom releases its unrelated owned lookup key")
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"moveKey")
  run Testing.expect(hasBorrowStatus(&moved, BodyBorrowStatus.Checked),
    "moving the unrelated key does not invalidate the retained source")
  let source = run Semantic.demandBody(&mut store, &mut request, &id, b"replaceSource")
  run Testing.expect(rejectsSpan(&source, RejectionCode.AccessDuringLoan, text, "source", 9),
    "releasing the key never releases the actual result source (OWN0011)")
  let required = run Semantic.demandBody(&mut store, &mut request, &id, b"requiredKey")
  run Testing.expect(hasBorrowStatus(&required, BodyBorrowStatus.Imprecise),
    "a callee bound retains a required key even when its atom differs from the result")
  let external = run Semantic.demandBody(&mut store, &mut request, &id, b"externalKey")
  run Testing.expect(hasBorrowStatus(&external, BodyBorrowStatus.Checked),
    "the closed result contract excludes the unrelated external key while retaining the actual source")
  let shared = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedInference")
  run Testing.expect(hasBorrowStatus(&shared, BodyBorrowStatus.Imprecise),
    "coalesced fresh call atoms do not establish a unique source or an unrelated key")
  return ()
}

test effect fn implicitReceiverBorrowsRetainStoredSources() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
