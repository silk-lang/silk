fn rotate<T: Intrinsic.Copy>(values: &mut [T]) -> T {
  let head = first(&values)
  values[0] = head
  return head
}
struct Cell<T> {
  value: T
}
fn read<T: Intrinsic.Copy>(cell: &mut Cell<T>) -> T { return cell.value }
fn readTwice<T: Intrinsic.Copy>(cell: &mut Cell<T>) -> T {
  let first = read(&mut cell.*)
  let second = read(&mut cell.*)
