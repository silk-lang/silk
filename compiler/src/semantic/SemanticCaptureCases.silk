  let keepPayload = run Semantic.demandBody(&mut store, &mut request, &id, b"keepPayload") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let keepCount = run Semantic.demandBody(&mut store, &mut request, &id, b"keepCount") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let keepOtherField = run Semantic.demandBody(&mut store, &mut request, &id, b"keepOtherField") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
