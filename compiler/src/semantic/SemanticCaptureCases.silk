  let typedFieldEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"typedFieldEscape") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let referentFieldEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"referentFieldEscape") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
