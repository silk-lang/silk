}

effect fn capturedFiniteClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("captured-finite-uses.silk")
  let text = """
fn inspect(value: &i32) -> i32 { return value.* }
fn apply(use: fn() -> i32) -> i32 { return use() }
effect fn applyEffect<'callback>(use: once fn<'callback>() -> once Effect<'callback; i32>) -> i32 { return run move use() }
fn stored() -> i32 {
  let values = [1, 2]
  let view: &[i32] = &values
  let read = fn() -> i32 { return inspect(&view[0]) }
  return read()
}
fn inline() -> i32 {
  let values = [1, 2]
  let view: &[i32] = &values
  return apply(fn() -> i32 { return inspect(&view[0]) })
}
effect fn effectful() -> i32 {
  let values = [1, 2]
  let view: &[i32] = &values
  let read = effect fn() -> i32 { return inspect(&view[0]) }
  return run read()
}
effect fn effectInline() -> i32 {
  let values = [1, 2]
  let view: &[i32] = &values
  return run applyEffect(effect fn() -> i32 { return inspect(&view[0]) })
}
effect fn block() -> i32 {
  let values = [1, 2]
  let view: &[i32] = &values
  return run effect { return inspect(&view[0]) }
}
service Reader { effect fn load() -> i32 ? &Reader }
struct Provider {}
impl Reader for Provider {
  effect fn load(self: &Self) -> i32 {
    let values = [1, 2]
    let view: &[i32] = &values
    return run effect { return inspect(&view[0]) }
  }
}
fn conflict() -> i32 {
  let mut values = [1, 2]
  let view: &[i32] = &values
  let read = fn() -> i32 { return inspect(&view[0]) }
  values[0] = 3
  return read()
}
fn escape() -> some<F: fn<'static>() -> i32> F {
  let values = [1, 2]
  let escapingView: &[i32] = &values
  let escaping = fn() -> i32 { return inspect(&escapingView[0]) }
  return escaping
}
struct Holder<'a> { value: &'a i32 }
fn put<'a>(slot: &mut Holder<'a>, value: &'a i32) -> () { slot.value = value }
fn strengthen<'a>(holder: &mut Holder<'a>) -> () {
  let values = [1, 2]
  let view: &[i32] = &values
  let write = fn(slot: &mut Holder<'a>) -> () { put(&mut slot.*, &view[0]) }
  write(&mut holder.*)
}
fn strengthenStatic(holder: &mut Holder<'static>) -> () {
  let values = [1, 2]
  let view: &[i32] = &values
  let write = fn(slot: &mut Holder<'static>) -> () { put(&mut slot.*, &view[0]) }
  write(&mut holder.*)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let stored = run Semantic.demandBody(&mut store, &mut request, &id, b"stored")
  let inline = run Semantic.demandBody(&mut store, &mut request, &id, b"inline")
  let effectful = run Semantic.demandBody(&mut store, &mut request, &id, b"effectful")
  let effectInline = run Semantic.demandBody(&mut store, &mut request, &id, b"effectInline")
  let block = run Semantic.demandBody(&mut store, &mut request, &id, b"block")
  let conflict = run Semantic.demandBody(&mut store, &mut request, &id, b"conflict")
  let escape = run Semantic.demandBody(&mut store, &mut request, &id, b"escape")
  let strengthen = run Semantic.demandBody(&mut store, &mut request, &id, b"strengthen")
  let strengthenStatic = run Semantic.demandBody(&mut store, &mut request, &id, b"strengthenStatic")
  let source = run present(text)
  let mut index = SourceIndex.make(run Revision.publish(&Revision.make(), &id, &source))
  let loadId = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"load", usize.ONE)
  let provider = run Semantic.demandBodyOf(&mut store, &mut request, &loadId)
  run Testing.expect(allAnonymousStatuses(&stored, usize.ONE, BodyBorrowStatus.Checked),
    "a stored callable uses a captured outer slice only during its finite invocation")
  run Testing.expect(allAnonymousStatuses(&inline, usize.ONE, BodyBorrowStatus.Checked),
    "an inline callable has the same captured-source validity as a stored callable")
  run Testing.expect(allAnonymousStatuses(&effectful, usize.ONE, BodyBorrowStatus.Checked),
    "a stored effectful callable authenticates the directly enclosing source")
  run Testing.expect(allAnonymousStatuses(&effectInline, usize.ONE, BodyBorrowStatus.Checked),
    "an inline effectful callable authenticates the directly enclosing source")
  run Testing.expect(allAnonymousStatuses(&block, usize.ONE, BodyBorrowStatus.Checked),
    "an Effect block retains the enclosing source's exact identity")
  run Testing.expect(allAnonymousStatuses(&provider, usize.ONE, BodyBorrowStatus.Checked),
    "an Effect block in a provider body retains the enclosing source's exact identity")
  run Testing.expect(rejectsSpan(&conflict, RejectionCode.AccessDuringLoan, text, "values[0]", usize.ZERO),
    "finite nested coverage keeps the enclosing captured loan's conflicting write")
  run Testing.expect(rejectsSpan(&escape, RejectionCode.ExecutableBorrowEscape, text, "escapingView", usize.ONE),
    "a callable borrowing outer owned storage cannot escape to a static environment")
  run Testing.expect(allAnonymousStatuses(&strengthen, usize.ONE, BodyBorrowStatus.Regions)
    && allAnonymousStatuses(&strengthenStatic, usize.ONE, BodyBorrowStatus.Regions),
    "an enclosing local cannot gain an enclosing parameter or static lifetime from finite coverage")
  return ()
}


test effect fn callableSelectionAtomsNeverHideStoredRegions() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
