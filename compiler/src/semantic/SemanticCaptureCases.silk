}

effect fn r3ShelfGuardClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("r3-shelf-guard.silk")
  let text = """
struct Token { value: i32 }
struct Shelf<'b> { inner: &'b Token }
fn unshelve<'a, 'b>(outer: &'a Shelf<'b>) -> &'a Token { return outer.inner }
fn unshelveThenReplace() -> i32 {
  let mut held = Token {value: 1}
  let shelf = Shelf {inner: &held}
  let view = unshelve(&shelf)
  held = Token {value: 2}
  return view.value
}
fn unshelveThenMove() -> i32 {
  let held = Token {value: 1}
  let shelf = Shelf {inner: &held}
  let view = unshelve(&shelf)
  let moved = move held
  return view.value + moved.value
}
fn releasedBeforeReplace() -> i32 {
  let mut held = Token {value: 1}
  let shelf = Shelf {inner: &held}
  let view = unshelve(&shelf)
  let previous = view.value
  held = Token {value: 2}
  return previous + held.value
}
fn unrelated<'a, 'b>(outer: &'a Shelf<'b>) -> &'static [u8] { return b"ok" }
fn staticResultBeforeReplace() -> i32 {
  let mut held = Token {value: 1}
  let shelf = Shelf {inner: &held}
  let independent = unrelated(&shelf)
  held = Token {value: 2}
  if independent.length == 2 { return held.value }
  return 0
}
fn fromTwo<'r, 'a, 'b>(first: &'r Shelf<'a>, second: &'r Shelf<'b>) -> &'r Token { return first.inner }
fn twoRequiredSafe() -> i32 {
  let first = Token {value: 1}
  let second = Token {value: 2}
  let firstShelf = Shelf {inner: &first}
  let secondShelf = Shelf {inner: &second}
  let view = fromTwo(&firstShelf, &secondShelf)
  return view.value
}
fn twoRequiredConflict() -> i32 {
  let mut first = Token {value: 1}
  let second = Token {value: 2}
  let firstShelf = Shelf {inner: &first}
  let secondShelf = Shelf {inner: &second}
  let view = fromTwo(&firstShelf, &secondShelf)
  first = Token {value: 3}
  return view.value
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandBody(&mut store, &mut request, &id, b"unshelveThenReplace")
  run Testing.expect(rejectsSpan(&caller, RejectionCode.AccessDuringLoan, text, "held", 2),
    "Shelf's caller-side well-formedness requirement keeps the inner source loan live through the view")
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"unshelveThenMove")
  run Testing.expect(rejectsSpan(&moved, RejectionCode.AccessDuringLoan, text, "held", 5),
    "moving the required inner source while the result is live is OWN0011")
  let released = run Semantic.demandBody(&mut store, &mut request, &id, b"releasedBeforeReplace")
  run Testing.expect(hasBorrowStatus(&released, BodyBorrowStatus.Checked), "the required inner loan ends after the last view use")
  let independent = run Semantic.demandBody(&mut store, &mut request, &id, b"staticResultBeforeReplace")
  run Testing.expect(hasBorrowStatus(&independent, BodyBorrowStatus.Checked), "an unrelated static result does not extend the input's required loans")
  let several = run Semantic.demandBody(&mut store, &mut request, &id, b"twoRequiredSafe")
  run Testing.expect(hasBorrowStatus(&several, BodyBorrowStatus.Checked), "every required source is retained and proved for a shared call region")
  let ambiguous = run Semantic.demandBody(&mut store, &mut request, &id, b"twoRequiredConflict")
  run Testing.expect(rejectsSpan(&ambiguous, RejectionCode.AccessDuringLoan, text, "first", 10),
    "a result region shared by several inputs keeps every input's inner loan live, so replacing either source is OWN0011")
  return ()
}

test effect fn r3GuardLoopCarriedIntervals() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run r3LoopGuardClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn r3LoopGuardClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("r3-loop-guards.silk")
  let text = """
fn expired(count: i32) -> i32 {
  let outer = 1
  let mut view = &outer
  let mut at = 0
  let mut sum = 0
  while at < count {
    sum = sum + view.*
    let inner = at
    view = &inner
    at = at + 1
  }
  return sum
}
fn carried<'a>(source: &'a i32, count: i32) -> i32 {
  let mut view = &source.*
  let mut at = 0
  let mut sum = 0
  while at < count {
    sum = sum + view.*
    view = &source.*
    at = at + 1
  }
  return sum
}
fn local(count: i32) -> i32 {
  let first = 1
  let second = 2
  let mut view = &first
  let mut at = 0
  let mut sum = 0
  while at < count {
    sum = sum + view.*
    view = &second
    at = at + 1
  }
  return sum
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let expired = run Semantic.demandBody(&mut store, &mut request, &id, b"expired")
  let carried = run Semantic.demandBody(&mut store, &mut request, &id, b"carried")
  let local = run Semantic.demandBody(&mut store, &mut request, &id, b"local")
  run Testing.expect(rejectsSpan(&expired, RejectionCode.ExpiredLifetime, text, "view.*", usize.ZERO),
    "a loop-carried holder cannot use a borrow after the preceding iteration ended its storage (OWN0019), reported at the read the back edge reaches")
  run Testing.expect(hasBorrowStatus(&carried, BodyBorrowStatus.Checked),
    "a parameter reborrow remains valid across the loop back edge")
  run Testing.expect(hasBorrowStatus(&local, BodyBorrowStatus.Checked),
    "reassigned local reborrows preserve their source proof across the back edge")
  return ()
}

test effect fn retaggedBorrowRegionsKeepTheirSourceBounds() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run retaggedBorrowRegionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn retaggedBorrowRegionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("retagged-borrow-regions.silk")
  let text = """
struct Pair { value: i32 }
fn read(value: &i32) -> i32 { return value.* }
fn generic<T: Intrinsic.Copy>(value: &T) -> T { return value.* }
fn genericProjection(source: &Pair) -> i32 { return generic(&source.value) }
fn increment(value: &mut i32) -> () { value.* = value.* + 1 }
fn projected(source: &Pair) -> i32 { return read(&source.value) }
fn descriptor(source: &mut i32) -> i32 { increment(&mut source) return source.* }
interface Step { fn step(self: &mut Self) -> i32 }
impl Step for Pair { fn step(self: &mut Self) -> i32 { self.value = self.value + 1 return self.value } }
fn qualified<T: Step>(source: &mut T) -> i32 { return Step.step(&mut source) }
fn constrain<'a, 'x: 'a>(anchor: &'a i32, value: &'x i32) -> i32 { return anchor.* + value.* }
fn outlived<'a>(anchor: &'a i32) -> i32 {
  let local = Pair {value: 1}
  return constrain(anchor, &local.value)
}
fn same<'a>(value: &'a i32) -> &'a i32 { return value }
fn retained() -> i32 {
  let mut pair = Pair {value: 1}
  let view = same(&pair.value)
  pair.value = 2
  return view.*
}
fn constrainHeld<'a, 'x: 'a>(anchor: &'a mut &'a i32, value: &'x i32) -> i32 { return anchor.*.* + value.* }
fn outlivedHeld<'a>(anchor: &'a mut &'a i32) -> i32 {
  let local = Pair {value: 1}
  return constrainHeld(move anchor, &local.value)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let genericProjection = run Semantic.demandBody(&mut store, &mut request, &id, b"genericProjection")
  let projected = run Semantic.demandBody(&mut store, &mut request, &id, b"projected")
  let descriptor = run Semantic.demandBody(&mut store, &mut request, &id, b"descriptor")
  let qualified = run Semantic.demandBody(&mut store, &mut request, &id, b"qualified")
  let outlived = run Semantic.demandBody(&mut store, &mut request, &id, b"outlived")
  let outlivedHeld = run Semantic.demandBody(&mut store, &mut request, &id, b"outlivedHeld")
  let retained = run Semantic.demandBody(&mut store, &mut request, &id, b"retained")
  run Testing.expect(hasBorrowStatus(&genericProjection, BodyBorrowStatus.Checked),
    "generic argument inference keeps a projected borrow attached to its source-validity goal")
  run Testing.expect(hasBorrowStatus(&projected, BodyBorrowStatus.Checked),
    "a projected argument's source-validity goal follows its fresh loan into the call region")
  run Testing.expect(hasBorrowStatus(&descriptor, BodyBorrowStatus.Checked),
    "a contextual descriptor reborrow keeps its source-validity goal attached to the retagged loan")
  run Testing.expect(hasBorrowStatus(&qualified, BodyBorrowStatus.Checked),
    "a qualified interface argument uses the same retagged loan identity")
  run Testing.expect(hasBorrowStatus(&outlived, BodyBorrowStatus.Checked),
    "a binder the parameter fixed shortens to the local loan its bound names")
  run Testing.expect(rejectsSpan(&outlivedHeld, RejectionCode.UnsatisfiedLifetimeBound, text, "&local.value", usize.ONE),
    "an invariant binder fixed to a universal parameter makes local storage outlive it: SEM0212 at the borrow")
  run Testing.expect(rejectsSpan(&retained, RejectionCode.AccessDuringLoan, text, "pair.value", usize.ONE),
    "retagging keeps the source loan of a returned view alive across a conflicting write (OWN0011)")
  return ()
}

test effect fn aggregateBorrowRetaggingKeepsSourceBounds() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
