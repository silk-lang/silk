}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let after = run Semantic.demandBody(&mut store, &mut request, &id, b"viewAfterLastUse")
  let live = run Semantic.demandBody(&mut store, &mut request, &id, b"viewWhileLive")
  let unrelated = run Semantic.demandBody(&mut store, &mut request, &id, b"unrelatedArgument")
  let bounded = run Semantic.demandBody(&mut store, &mut request, &id, b"outlivesBound")
  let generic = run Semantic.demandBody(&mut store, &mut request, &id, b"typeParameter")
  let caller = run Semantic.demandBody(&mut store, &mut request, &id, b"callerRegion")
  let pulledTwice = run Semantic.demandBody(&mut store, &mut request, &id, b"pullTwice")
  let pulledReplaced = run Semantic.demandBody(&mut store, &mut request, &id, b"pullThenReplace")
  let unshelved = run Semantic.demandBody(&mut store, &mut request, &id, b"unshelveThenReplace")
  let shelvedReceiver = run Semantic.demandBody(&mut store, &mut request, &id, b"shelvedThenReplace")
  let loanAcross = run Semantic.demandBody(&mut store, &mut request, &id, b"loanAcrossSuspension")
  let loanBefore = run Semantic.demandBody(&mut store, &mut request, &id, b"loanBeforeSuspension")
  let movedAcross = run Semantic.demandBody(&mut store, &mut request, &id, b"movedAcrossSuspension")
  let partialAcross = run Semantic.demandBody(&mut store, &mut request, &id, b"partialAcrossSuspension")
  let heldFresh = run Semantic.demandBody(&mut store, &mut request, &id, b"heldThenFresh")
  let freshHeld = run Semantic.demandBody(&mut store, &mut request, &id, b"freshThenHeld")
  let lasting = run Semantic.demandBody(&mut store, &mut request, &id, b"staticResult")
  let field = run Semantic.demandBody(&mut store, &mut request, &id, b"throughField")
  let escaping = run Semantic.demandBody(&mut store, &mut request, &id, b"falseObligation")
  let rotated = run Semantic.demandBody(&mut store, &mut request, &id, b"rotate")
  let twice = run Semantic.demandBody(&mut store, &mut request, &id, b"readTwice")
  let leaked = run Semantic.demandBody(&mut store, &mut request, &id, b"leakLocal")
  let kept = run Semantic.demandBody(&mut store, &mut request, &id, b"keepThrough")
  let paired = run Semantic.demandBody(&mut store, &mut request, &id, b"rotatePair")
  let wrapped = run Semantic.demandBody(&mut store, &mut request, &id, b"leakWrapped")
  let peeked = run Semantic.demandBody(&mut store, &mut request, &id, b"viaInterface")
  let optional = run Semantic.demandBody(&mut store, &mut request, &id, b"leakOption")
  let indexed = run Semantic.demandBody(&mut store, &mut request, &id, b"indexWhileWritten")
  let early = run Semantic.demandBody(&mut store, &mut request, &id, b"indexBeforeWritten")
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"writeThroughAfterRead")
  let element = run Semantic.demandBody(&mut store, &mut request, &id, b"elementThenWrite")
  let filled = run Semantic.demandBody(&mut store, &mut request, &id, b"viewWhileFilled")
  let viewed = run Semantic.demandBody(&mut store, &mut request, &id, b"viewBeforeFill")
  let slotted = run Semantic.demandBody(&mut store, &mut request, &id, b"countWhileSlotted")
  let addressed = run Semantic.demandBody(&mut store, &mut request, &id, b"addressed")
  let notified = run Semantic.demandBody(&mut store, &mut request, &id, b"notifies")
  let replacedLive = run Semantic.demandBody(&mut store, &mut request, &id, b"replaceWhileBorrowed")
  let replacedLater = run Semantic.demandBody(&mut store, &mut request, &id, b"replaceAfterUse")
  let replacedThrough = run Semantic.demandBody(&mut store, &mut request, &id, b"replaceThrough")
  let signalled = run Semantic.demandBody(&mut store, &mut request, &id, b"signalInside")
  let disarmed = run Semantic.demandBody(&mut store, &mut request, &id, b"disarmInside")
  let ownedFilled = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedViewWhileFilled")
  let ownedSlotted = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedSlotWhileCounted")
  let accessed = run Semantic.demandBody(&mut store, &mut request, &id, b"accessShared")
  let reused = run Semantic.demandBody(&mut store, &mut request, &id, b"reuseCallback")
  let captured = run Semantic.demandBody(&mut store, &mut request, &id, b"captureWhileExclusive")
  let clearAccess = run Semantic.demandBody(&mut store, &mut request, &id, b"clearSharedAccess")
  let escapingView = run Semantic.demandBody(
    &mut store,
    &mut request,
    &id,
    b"viewAcrossSharedAccess"
  )
  let storedReference = run Semantic.demandBody(
    &mut store,
    &mut request,
    &id,
    b"storeSharedReference"
  )
  let nestedAccess = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedSharedAccess")
  run Testing.expect(loansProved(&after),
    "a returned view holds its source loan only through its last use (VIEW-002)")
  run Testing.expect(rejectsRelated(&live, RejectionCode.AccessDuringLoan, offsetOf(text, "held = Token {value: 3}", usize.ONE),
      offsetOf(text, "&held", usize.ONE)),
    "a view whose region only its one argument names holds that loan, so replacing the source while it lives is OWN0011")
  run Testing.expect(rejectsRelated(&generic, RejectionCode.AccessDuringLoan, offsetOf(text, "held = Token {value: 5}", usize.ZERO),
      offsetOf(text, "&held", 3)),
    "a type parameter instantiated with a reference carries that reference's region into the result")
  run Testing.expect(rejectsWith(&bounded, RejectionCode.UnsatisfiedLifetimeBound),
    "an outlives bound that would let the loan reach the result is enforced by typing, so the body is never accepted")
  run Testing.expect(hasBorrowStatus(&pulledTwice, BodyBorrowStatus.Checked),
    "a result naming only the holder's contents region holds no fresh loan of the holder, so it may be borrowed again")
  run Testing.expect(rejectsRelated(&pulledReplaced, RejectionCode.AccessDuringLoan, offsetOf(text, "first = Token {value: 4}", usize.ZERO),
      offsetOf(text, "&first", usize.ONE)),
    "the holder's contents loan that the result names stays live, so replacing its source is OWN0011")
  // The release rule reads argument types, not the callee's instantiated parameter types. It relies
  // on typing relating a held loan's region to a parameter region only by equality, a meet or an
  // open relation; either order of a held view and a fresh borrow at one binder keeps the held loan.
  run Testing.expect(!succeeded(&heldFresh) && !hasBorrowStatus(&freshHeld, BodyBorrowStatus.Checked)
    && !hasBorrowStatus(&freshHeld, BodyBorrowStatus.Regions),
    "a held view passed beside a fresh borrow at one binder keeps its loan in the result")
  // Explicit and implicit receiver borrows both retain the local stored-source requirement.
  run Testing.expect(rejectsSpan(&unshelved, RejectionCode.AccessDuringLoan, text, "held", 20),
    "a direct Shelf result retains its stored referent and rejects replacing it")
  run Testing.expect(rejectsSpan(&shelvedReceiver, RejectionCode.AccessDuringLoan, text, "held", 23),
    "an implicit receiver result retains the same stored referent and rejects replacing it")

  // SUSP-011: loans and partial owners continue across suspension and report the ordinary codes,
  // as the bootstrap reports them for the same programs.
  run Testing.expect(rejectsFrom(&loanAcross, RejectionCode.AccessDuringLoan, offsetOf(text, "cell = Token {value: next}\n  return view", usize.ZERO)),
    "a loan live across a suspension still conflicts with a later write (OWN0011)")
  run Testing.expect(loansProved(&loanBefore),
    "a loan whose last use precedes the suspension leaves the owner free after it")
  run Testing.expect(rejectsFrom(&movedAcross, RejectionCode.UseAfterMove, offsetOf(text, "owned.left.value + next", usize.ZERO)),
    "a part moved before a suspension stays moved after it (OWN0001)")
  run Testing.expect(loansProved(&partialAcross),
    "the unmoved remainder of a partial owner stays usable after a suspension")
  run Testing.expect(loansProved(&caller),
    "a result in the caller's own lifetime parameter holds no loan of a body local, so the holder is free to change")
  run Testing.expect(hasBorrowStatus(&unrelated, BodyBorrowStatus.Imprecise),
    "two fresh borrows share the call's region, so which one a view retains stays imprecise, never accepted or rejected")
  run Testing.expect(loansProved(&lasting),
    "a 'static result retains no body loan")
  run Testing.expect(rejectsRelated(&field, RejectionCode.AccessDuringLoan, offsetOf(text, "mine = Token {value: 7}", usize.ZERO),
      offsetOf(text, "&mine", usize.ZERO)),
    "a result region reached only through a nominal's lifetime argument still retains the loan behind it")
  run Testing.expect(rejectsFrom(&escaping, RejectionCode.ExpiredLifetime, offsetOf(text, "&mine", usize.ONE)),
    "retaining a body-local borrow under a caller lifetime promise reports OWN0019")
  run Testing.expect(loansProved(&rotated),
    "a result of the checked declaration's own type parameter holds no body loan, since its callers choose that type")
  run Testing.expect(loansProved(&twice),
    "a reborrow through a parameter has the call's body region, so a type-parameter result does not hold it either")
  run Testing.expect(rejectsFrom(&leaked, RejectionCode.ReturnTypeMismatch, offsetOf(text, "escaped\n}", usize.ZERO)),
    "a body-local borrow is never typed as the caller's type parameter, so a T result cannot carry one")
  run Testing.expect(rejectsRelated(&kept, RejectionCode.AccessDuringLoan, offsetOf(text, "cell.*.value = 3", usize.ZERO),
      offsetOf(text, "&mut cell.*", 2)),
    "a reborrow returned under a parameter region stays live until the return, so a write through the parameter before it is OWN0011")
  run Testing.expect(rejectsRelated(&indexed, RejectionCode.AccessDuringLoan, offsetOf(text, "cell.value = 4", usize.ZERO),
      offsetOf(text, "&cell)\n  cell.value = 4", usize.ZERO)),
    "indexing a slice reads through it, so a slice local keeps its loan live until its last indexed read")
  run Testing.expect(loansProved(&early),
    "a slice indexed before the write holds no conflicting loan")
  run Testing.expect(rejectsRelated(&written, RejectionCode.AccessDuringLoan, offsetOf(text, "cell.value\n  view[0] = 1", usize.ZERO),
      offsetOf(text, "&mut cell)\n  let seen", usize.ZERO)),
    "a write through a mutable slice uses the slice, so its exclusive loan is live across an earlier read of the source")
  run Testing.expect(rejectsSpan(&element, RejectionCode.AccessDuringLoan, text, "view[0]", 4),
    "a borrowed slice element and a write through the slice may be one element, so the write conflicts with the loan (OWN0011)")
  run Testing.expect(loansProved(&paired),
    "a result built from the checked declaration's own type parameters holds no body loan")
  run Testing.expect(rejectsWith(&wrapped, RejectionCode.StructFieldTypeMismatch),
    "a body-local borrow is never typed as a caller's type parameter inside a nominal either")
  run Testing.expect(rejectsWith(&optional, RejectionCode.StructFieldTypeMismatch),
    "nor inside a union payload")
  run Testing.expect(rejectsRelated(&peeked, RejectionCode.AccessDuringLoan, offsetOf(text, "local = move other", usize.ZERO),
      offsetOf(text, "local.peek()", usize.ZERO)),
    "an interface operation's result names its argument's region, which erasing the type parameter keeps")
  run Testing.expect(rejectsRelated(&filled, RejectionCode.LoanConflict,
      offsetOf(text, "&mut buffer.*, 0, 1, 7)\n    return view", usize.ZERO), offsetOf(text, "&buffer.*, 0, 1)\n    Intrinsic.rawBufferFill", usize.ZERO)),
    "a raw-buffer view holds its buffer's loan inside `unsafe`, so an exclusive borrow of the buffer while the view lives conflicts")
  run Testing.expect(loansProved(&viewed),
    "a raw-buffer view used before the buffer is filled holds no conflicting loan")
  run Testing.expect(rejectsRelated(&slotted, RejectionCode.LoanConflict,
      offsetOf(text, "&buffer.*)\n    Intrinsic.slotWrite", usize.ZERO), offsetOf(text, "&mut buffer.*, 0)\n    let count", usize.ZERO)),
    "a slot holds its buffer's exclusive loan until it is written")
  run Testing.expect(hasBorrowStatus(&addressed, BodyBorrowStatus.Checked),
    "a slot address consumes its slot and holds no loan, so the buffer may be selected again while it lives")
  run Testing.expect(hasBorrowStatus(&notified, BodyBorrowStatus.Checked),
    "notification checks its shared-reference contract; reached local-shared callbacks still have the independent OWN0016 gate")
  run Testing.expect(rejectsRelated(&replacedLive, RejectionCode.AccessDuringLoan, offsetOf(text, "cell.value, 3)\n  return view", usize.ZERO),
      offsetOf(text, "&cell.value\n  let old", usize.ZERO)),
    "replace writes its place, so a loan of that place that is still live conflicts")
  run Testing.expect(loansProved(&replacedLater),
    "replace after the loan's last use holds no conflict")
  run Testing.expect(loansProved(&replacedThrough),
    "replace through a parameter reference is a write behind it")
  run Testing.expect(hasBorrowStatus(&signalled, BodyBorrowStatus.Checked),
    "readiness after replace checks every local loan; buildFrom still rejects notification under local-shared access")
  run Testing.expect(loansProved(&disarmed),
    "the same replace without the readiness signal is checked")
  run Testing.expect(rejectsRelated(&ownedFilled, RejectionCode.LoanConflict, offsetOf(text, "&mut owned, 0, 1, 7)", usize.ZERO),
      offsetOf(text, "&owned, 0, 1)\n    Intrinsic.rawBufferFill", usize.ZERO)),
    "a region-closed body that fills an owned buffer while its view lives is rejected, not cleared")
  run Testing.expect(rejectsRelated(&ownedSlotted, RejectionCode.LoanConflict, offsetOf(text, "&owned)\n    Intrinsic.slotWrite", usize.ZERO),
      offsetOf(text, "&mut owned, 0)\n    let count", usize.ZERO)),
    "a region-closed body that reads an owned buffer while a slot of it lives is rejected, not cleared")
  run Testing.expect(hasBorrowStatus(&accessed, BodyBorrowStatus.Checked),
    "an access wrapper's own lifetime parameters are closed under R2, and its call consumes both callbacks")
  run Testing.expect(rejectsWith(&reused, RejectionCode.UseAfterMove),
    "an access consumes its take-once callback, so passing it again is a use after move")
  run Testing.expect(rejectsWith(&captured, RejectionCode.LoanConflict),
    "a callback's capture loan begins at its construction, so it conflicts with a live exclusive loan")
  run Testing.expect(hasBorrowStatus(&clearAccess, BodyBorrowStatus.Checked),
    "a region-closed access returning owned data becomes Checked; reached callbacks still pass the build-time OWN0016 gate")
  run Testing.expect(rejectsSpan(&escapingView, RejectionCode.IncompatibleCallableSignature, text,
    "keepSharedView", usize.ONE),
    "a callback cannot lend a view of its shared value across another access (SHARED-003)")
  run Testing.expect(rejectsSpan(&storedReference, RejectionCode.IncompatibleCallableSignature, text,
    "storeSharedView", usize.ONE),
    "storing the access reference in an aggregate cannot satisfy the callback contract (SHARED-003)")
  run Testing.expect(hasBorrowStatus(&nestedAccess, BodyBorrowStatus.Checked),
    "a nested access's callbacks name only their own contract binders; same-core reentry traps before callback entry (SHARED-004)")
}

test effect fn reborrowsLendTheirReferent() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run reborrowClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn reborrowClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("reborrows.silk")
  let text = """
struct Pair {
  left: i32
  right: i32
}
fn reborrowEnds(pair: &mut Pair) -> i32 {
  let inner = &mut pair.*
  inner.*.left = 2
  return pair.*.left
}
fn parentDuringExclusive(pair: &mut Pair) -> i32 {
  let inner = &mut pair.*
  pair.*.left = 3
  inner.*.left = 4
  return 0
}
fn readDuringShared(pair: &mut Pair) -> i32 {
  let inner = &pair.*
  let seen = pair.*.left
  return seen + inner.*.left
}
fn writeDuringShared(pair: &mut Pair) -> i32 {
  let viewed = &pair.*
  pair.*.left = 5
  return viewed.*.left
}
fn disjointFields(pair: &mut Pair) -> i32 {
  let first = &mut pair.*.left
  let second = &mut pair.*.right
  first.* = 1
  second.* = 2
  return 0
}
fn ownerDuringReborrow() -> i32 {
  let mut owned = Pair {left: 1, right: 2}
  let outer = &mut owned
  let nested = &mut outer.*
  owned.left = 6
  nested.*.left = 1
  return 0
}
fn ownerAfterReborrow() -> i32 {
  let mut kept = Pair {left: 1, right: 2}
  let outer = &mut kept
  let nested = &mut outer.*
  nested.*.left = 1
  kept.left = 7
  return kept.left
}
fn readParentDuringExclusive(pair: &mut Pair) -> i32 {
  let whole = &mut pair.*
  let seen = pair.*.right
  whole.*.left = 4
  return seen
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let ends = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrowEnds")
  let exclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"parentDuringExclusive")
  let read = run Semantic.demandBody(&mut store, &mut request, &id, b"readDuringShared")
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"writeDuringShared")
  let disjoint = run Semantic.demandBody(&mut store, &mut request, &id, b"disjointFields")
  let during = run Semantic.demandBody(&mut store, &mut request, &id, b"ownerDuringReborrow")
  let after = run Semantic.demandBody(&mut store, &mut request, &id, b"ownerAfterReborrow")
  let parent = run Semantic.demandBody(&mut store, &mut request, &id, b"readParentDuringExclusive")
  run Testing.expect(loansProved(&ends) && loansProved(&read)
      && loansProved(&after),
    "a reborrow suspends its parent only until its last use, and a shared reborrow leaves reads through the parent valid (BORROW-005)")
  run Testing.expect(loansProved(&disjoint),
    "reborrows of disjoint fields behind one reference do not overlap")
  run Testing.expect(rejectsRelated(&exclusive, RejectionCode.AccessDuringLoan, offsetOf(text, "pair.*.left = 3", usize.ZERO),
      offsetOf(text, "&mut pair.*", usize.ONE)),
    "writing through a parent during its exclusive reborrow is OWN0011, as in the bootstrap")
  run Testing.expect(rejectsRelated(&written, RejectionCode.AccessDuringLoan, offsetOf(text, "pair.*.left = 5", usize.ZERO),
      offsetOf(text, "&pair.*", usize.ONE)),
    "writing through a parent during its shared reborrow is OWN0011, as in the bootstrap")
  run Testing.expect(rejectsRelated(&parent, RejectionCode.AccessDuringLoan, offsetOf(text, "pair.*.right", usize.ONE),
      offsetOf(text, "whole = &mut pair", usize.ZERO) + 8),
    "reading through a parent during its exclusive reborrow is OWN0011, as in the bootstrap")
  run Testing.expect(rejectsRelated(&during, RejectionCode.AccessDuringLoan, offsetOf(text, "owned.left = 6", usize.ZERO),
      offsetOf(text, "&mut owned", usize.ZERO)),
    "a reborrow keeps its parent's loan live, so writing the owner during it is OWN0011, as in the bootstrap")
}

test effect fn movedPlacesInPlainBodies() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run movedPlaceClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn movedPlaceClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("moved-places.silk")
  let text = """
struct Token {
  value: i32
}
struct Pair {
  left: Token
  right: Token
}
fn take(token: Token) -> i32 { return token.value }
fn first(pair: Pair) -> Token { return move pair.left }
effect fn inspect(token: Token) -> i32 { return token.value }
fn runTwice() -> i32 {
  let recipe = inspect(Token {value: 21})
  let ran = run recipe
  return ran + run recipe
}
fn moveTwice(twice: Token) -> i32 {
  let first = take(move twice)
  return first + take(move twice)
}
fn readAfterMove() -> i32 {
  let read = Token {value: 1}
  let first = take(move read)
  return first + read.value
}
fn branchMove(flag: bool, branched: Token) -> i32 {
  let mut total = 0
  if flag {
    total = take(move branched)
  }
  return total + take(move branched)
}
fn viewMoved<'a>(view: &'a mut i32) -> i32 {
  let other = move view
  return view.*
}
fn loopMove(looped: Token) -> i32 {
  let mut total = 0
  while total < 2 {
    total = total + take(move looped)
  }
  return total
}
fn loopReinit(token: Token) -> i32 {
  let mut owned = move token
  let mut total = take(move owned)
  while total < 2 {
    owned = Token {value: 1}
    total = total + 1
  }
  return total
}
fn replaceWhole(token: Token) -> i32 {
  let mut held = move token
  held = move held
  return held.value
}
fn replaceField(pair: Pair) -> i32 {
  let mut kept = move pair
  kept.left = first(move kept)
  return kept.left.value
}
fn partialDrop(pair: Pair) -> i32 {
  let first = move pair.left
  drop pair
  return first.value
}
fn accepted(flag: bool, pair: Pair) -> i32 {
  let mut owned = move pair
  let mut total = take(move owned.left) + owned.right.value
  owned.left = Token {value: 2}
  while total < 4 {
    let fresh = Token {value: total}
    total = total + 1 + take(move fresh) + take(move owned.left)
    owned.left = Token {value: 3}
    if flag {
      total = total + take(move owned.right)
      break
    }
  }
  return total + owned.left.value
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let twice = run Semantic.demandBody(&mut store, &mut request, &id, b"moveTwice")
  let read = run Semantic.demandBody(&mut store, &mut request, &id, b"readAfterMove")
  let branched = run Semantic.demandBody(&mut store, &mut request, &id, b"branchMove")
  let viewed = run Semantic.demandBody(&mut store, &mut request, &id, b"viewMoved")
  let looped = run Semantic.demandBody(&mut store, &mut request, &id, b"loopMove")
  let reinitialized = run Semantic.demandBody(&mut store, &mut request, &id, b"loopReinit")
  let replacedWhole = run Semantic.demandBody(&mut store, &mut request, &id, b"replaceWhole")
  let replacedField = run Semantic.demandBody(&mut store, &mut request, &id, b"replaceField")
  let partial = run Semantic.demandBody(&mut store, &mut request, &id, b"partialDrop")
  let ranTwice = run Semantic.demandBody(&mut store, &mut request, &id, b"runTwice")
  let accepted = run Semantic.demandBody(&mut store, &mut request, &id, b"accepted")
  run Testing.expect(rejectsRelated(&twice, RejectionCode.UseAfterMove, offsetOf(text, "move twice", usize.ONE), offsetOf(text, "move twice", usize.ZERO))
    && rejectsRelated(&read, RejectionCode.UseAfterMove, offsetOf(text, "read.value", usize.ZERO), offsetOf(text, "move read", usize.ZERO)),
    "a second move or a read of a moved local is OWN0001 at the use, related to the move")
  run Testing.expect(rejectsRelated(&ranTwice, RejectionCode.UseAfterMove, offsetOf(text, "run recipe", usize.ONE), offsetOf(text, "run recipe", usize.ZERO)),
    "running a take-once Effect consumes it, so a second run is OWN0001 at that whole run (EFFECT-OWN-002)")
  run Testing.expect(rejectsRelated(&branched, RejectionCode.UseAfterMove, offsetOf(text, "move branched", usize.ONE), offsetOf(text, "move branched", usize.ZERO))
    && rejectsRelated(&viewed, RejectionCode.UseAfterMove, offsetOf(text, "view.*", usize.ZERO), offsetOf(text, "move view", usize.ZERO)),
    "a move on one branch, or of a reference local, makes a later use OWN0001")
  run Testing.expect(rejectsAtOffset(&looped, RejectionCode.IncompatibleLoopHeader, offsetOf(text, "while total < 2", usize.ZERO))
    && rejectsAtOffset(&reinitialized, RejectionCode.IncompatibleLoopHeader, offsetOf(text, "while total < 2", usize.ONE)),
    "a loop that repeats with a different moved place than it entered with is OWN0005 at the loop")
  run Testing.expect(rejectsSpan(&replacedWhole, RejectionCode.OverlappingAssignment, text, "held = move held", usize.ZERO)
    && rejectsSpan(&replacedField, RejectionCode.OverlappingAssignment, text, "kept.left = first(move kept)", usize.ZERO),
    "a replacement whose right-hand side moves out of its target is OWN0004 on the assignment")
  run Testing.expect(succeeded(&accepted) && succeeded(&partial),
    "rebinding, replacement, disjoint fields, a move before break and a drop of the remaining parts keep every use owned")
}

test effect fn referenceReceiversReborrowForParameterZero() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run referenceReceiverClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn referenceReceiverClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("reference-receivers.silk")
  let text = """
struct Counter { value: i32 }
impl Counter {
  fn read(self: &Self) -> i32 { return self.value }
  fn bump(self: &mut Self) -> () { self.value = self.value + 1 }
  fn take(self: Self) -> i32 { return self.value }
  fn add(self: &mut Self, other: &mut Self) -> () { self.value = other.value }
}
struct Pair { value: i32 }
impl Intrinsic.Copy for Pair {}
impl Pair { fn take(self: Self) -> i32 { return self.value } }
fn exclusive(counter: &mut Counter) -> i32 {
  counter.bump()
  counter.bump()
  return counter.read()
}
fn shared(counter: &Counter) -> i32 { return counter.read() + counter.read() }
fn copied(pair: &Pair) -> i32 { return pair.take() + pair.take() }
fn bound(counter: &Counter) -> i32 {
  let read = counter.read
  return read()
}
fn strengthened(viewed: &Counter) -> () { viewed.bump() }
fn strengthenedExplicit(sighted: &Counter) -> () { Counter.bump(&mut sighted) }
fn clear(values: &mut [i32]) -> () { return () }
fn strengthenedSlice(listed: &[i32]) -> () { clear(&mut listed) }
fn moved(owned: &mut Counter) -> i32 { return owned.take() }
fn conflicting(lent: &mut Counter) -> i32 {
  let held = &lent.value
  lent.bump()
  return held.*
}
fn forwarded(counter: &mut Counter, spare: &mut Counter) -> () { counter.add(spare) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let exclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusive")
  let shared = run Semantic.demandBody(&mut store, &mut request, &id, b"shared")
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copied")
  let bound = run Semantic.demandBody(&mut store, &mut request, &id, b"bound")
  let strengthened = run Semantic.demandBody(&mut store, &mut request, &id, b"strengthened")
  let strengthenedExplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"strengthenedExplicit")
  let strengthenedSlice = run Semantic.demandBody(&mut store, &mut request, &id, b"strengthenedSlice")
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"moved")
  let conflicting = run Semantic.demandBody(&mut store, &mut request, &id, b"conflicting")
  let forwarded = run Semantic.demandBody(&mut store, &mut request, &id, b"forwarded")
  run Testing.expect(succeeded(&exclusive) && succeeded(&shared) && succeeded(&bound),
    "a reference receiver is reborrowed for each call under the declared access, so it stays usable (CALL-003)")
  run Testing.expect(succeeded(&copied), "a by-value receiver through a reference copies a Copy referent")
  run Testing.expect(rejectsSpan(&strengthened, RejectionCode.InvalidReborrow, text, "viewed", usize.ONE)
    && rejectsSpan(&strengthenedExplicit, RejectionCode.InvalidReborrow, text, "&mut sighted", usize.ZERO)
    && rejectsSpan(&strengthenedSlice, RejectionCode.InvalidReborrow, text, "&mut listed", usize.ZERO),
    "an exclusive reborrow of a shared reference or slice is SEM0058, through a receiver or an explicit &mut")
  run Testing.expect(rejectsSpan(&moved, RejectionCode.BorrowedExtraction, text, "owned", usize.ONE),
    "a by-value receiver cannot move an affine referent out of a borrow (OWN0012)")
  run Testing.expect(rejectsSpan(&conflicting, RejectionCode.LoanConflict, text, "lent.bump()", usize.ZERO),
    "the receiver reborrow conflicts with a live loan of the referent (OWN0010)")
  run Testing.expect(rejectsSpan(&forwarded, RejectionCode.ExplicitMoveRequired, text, "spare", usize.ONE),
    "only the receiver is reborrowed; a bare exclusive argument still needs &mut (OWN0003)")
}

test effect fn copiedSharedViewProjectionsCannotStrengthenAccess() -> ()
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
