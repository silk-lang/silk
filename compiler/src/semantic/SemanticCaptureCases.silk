struct PhantomCounter<'d> { count: &'d mut i32 }
struct PhantomGuard<'s, 'd> { counter: PhantomCounter<'d> }
fn eatPhantom<'d>(guard: PhantomGuard<'static, 'd>) -> () {
  drop guard
  return ()
}
fn keptPhantom() -> i32 {
  let mut count = 0
