    "a method call owes the environment its exclusive slot input too, which a shorter reborrow does not outlive (SEM0212)")
  run Testing.expect(rejectsSpan(&sectionCapturesLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 1)
      && rejectsSpan(&sectionBindsBoth, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 2)
      && rejectsSpan(&sectionWrapsLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 3)
      && rejectsSpan(&sectionInClosure, RejectionCode.UnsatisfiedLifetimeBound, text, "c", 31)
      && rejectsSpan(&methodValue, RejectionCode.UnsatisfiedLifetimeBound, text, "&mut slot.*", 5),
    "a local given to a written environment through a section, a closure or a method value does not outlive it (SEM0212 at the borrow or capture)")
  run Testing.expect(rejectsSpan(&sectionCapturesShorterSlot, RejectionCode.UnsatisfiedLifetimeBound, text, "&mut slot.*", 7),
    "an input shorter than the written environment does not outlive it, even where no loan dangles (SEM0212)")
  run Testing.expect(rejectsSpan(&sectionIntoLocalSlot, RejectionCode.AccessDuringLoan, text, "loc.r.*", 0),
    "a section owing its environment a local slot's exclusive loan keeps that loan while the slot is read (OWN0011)")
  run Testing.expect(rejectsSpan(&serviceCall, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 6),
    "a local given to a service operation's written environment does not outlive it (SEM0212 at the borrow)")
  run Testing.expect(rejectsSpan(&serviceSection, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 7)
      && rejectsSpan(&keptSection, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 0)
      && rejectsSpan(&keptCall, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 1),
    "a service operation's section, and a callee keeping a local in the caller's service, owe the environment the local (SEM0212)")
  run Testing.expect(hasBorrowStatus(&outlivesDirect, BodyBorrowStatus.Checked) && hasBorrowStatus(&outlivesSection, BodyBorrowStatus.Checked),
    "inputs that outlive the written environment keep the call and the section Checked")
  // An environment only the environment names is the call's to choose; a call its `run` consumes in
  // place chooses its own extent, so a local input owes it nothing. An Effect that leaves the call
  // keeps the region the call chose.
  run Testing.expect(hasBorrowStatus(&chosenInPlace, BodyBorrowStatus.Checked) && hasBorrowStatus(&chosenForService, BodyBorrowStatus.Checked),
    "a call run in place owes nothing to an environment it chooses")
  run Testing.expect(rejectsSpan(&chosenReturned, RejectionCode.ExecutableBorrowEscape, text, "&c", 9)
      && rejectsSpan(&chosenKept, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 10),
    "an Effect that outlives its call keeps owing the environment it was given (OWN0018 returned, SEM0212 kept)")
  // A declared bound that only bounds the chosen environment (`H: 'e`) leaves it the call's to
  // choose; one it must outlive (`'e: 'x`) pins it.
  run Testing.expect(hasBorrowStatus(&chosenUnderBound, BodyBorrowStatus.Checked) && rejectsSpan(&pinnedLonger, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 12)
      && rejectsSpan(&boundEscapes, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 13),
    "an environment bounded only from above stays the call's to choose; one a bound pins does not")
  // A partial invocation of a callable value is a section: it owes what a named section owes.
  run Testing.expect(hasBorrowStatus(&valueSection, BodyBorrowStatus.Checked)
      && rejectsSpan(&valueSectionCapturesLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 14),
    "a section of a callable value defers its environment as a named section does")
  // A borrowed first input is not covered by the written environment: a witness's provider, whatever
  // it is named, is a borrow the provision supplies, which no call relates to the operation's
  // environment.
  run Testing.expect(rejectsSpan(&witnessOwn, RejectionCode.UnsatisfiedLifetimeBound, text, "&self.v", 0) && rejectsSpan(&witnessShared, RejectionCode.UnsatisfiedLifetimeBound, text, "&self.v", 1)
      && rejectsSpan(&providerOwn, RejectionCode.UnsatisfiedLifetimeBound, text, "&p.v", 0) && rejectsSpan(&providerShared, RejectionCode.UnsatisfiedLifetimeBound, text, "&p.v", 1)
      && hasBorrowStatus(&witnessAnchor, BodyBorrowStatus.Checked) && hasBorrowStatus(&providerAnchor, BodyBorrowStatus.Checked),
    "a witness never assumes its provider outlives the operation's environment")
  // The borrow is read from the resolved type, so an alias of a reference does not hide it.
  run Testing.expect(rejectsSpan(&providerAliased, RejectionCode.UnsatisfiedLifetimeBound, text, "&aliased.v", 0)
      && rejectsSpan(&providerApplied, RejectionCode.UnsatisfiedLifetimeBound, text, "&applied.v", 0),
    "a provider written through a reference alias is still not covered by the environment")
  // The cost: a function returning a view of its borrowed first input at the environment writes the
  // relation in that input's type.
  run Testing.expect(rejectsSpan(&peekFirst, RejectionCode.UnsatisfiedLifetimeBound, text, "&cell.v", 0) && hasBorrowStatus(&peekWritten, BodyBorrowStatus.Checked),
    "a borrowed first input outlives the written environment only where its type says so")
  // A callable's parameter types imply the bounds they need, as rustc assumes for a higher-ranked
  // callable's argument: a section's bound on the contents they store holds whatever the contents
  // hold, a local loan included.
  run Testing.expect(hasBorrowStatus(&drainsPlain, BodyBorrowStatus.Checked) && hasBorrowStatus(&drainsWrappedPlain, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&drainsHoldsLocal, BodyBorrowStatus.Checked),
    "a section's bound on stored contents holds where the callable's parameter types imply it")
  // A callable-representation parameter outlives its contract's environment: every call proves it
  // of the callable it supplies, whether a closure, a section or a generic instantiation.
  run Testing.expect(hasBorrowStatus(&forwardsCallback, BodyBorrowStatus.Checked) && hasBorrowStatus(&drivesSection, BodyBorrowStatus.Checked),
    "a callback parameter outlives the environment its contract names")
  run Testing.expect(rejectsSpan(&closureTooShort, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 18)
      && rejectsSpan(&sectionTooShort, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 19)
      && rejectsSpan(&genericTooShort, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 20),
    "a callable holding a region shorter than the pinned environment does not satisfy the contract")
  // A call owes exactly what the answering body assumes: no call owes a borrowed first input the body
  // does not assume, whether direct, through a section or through a function value; an owned first
  // input, an input a section or method value shifts off position zero, and a service operation's
  // first input (its witness's second) are still owed.
  run Testing.expect(hasBorrowStatus(&exemptDirect, BodyBorrowStatus.Checked) && hasBorrowStatus(&exemptSection, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&exemptValue, BodyBorrowStatus.Checked),
    "a borrowed first input is owed to no written environment")
  run Testing.expect(rejectsSpan(&ownedFirstOwed, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 21) && rejectsSpan(&operationFirstOwed, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 25),
    "an owned first input and a service operation's first input stay owed to the written environment (SEM0212 at the borrow)")
  run Testing.expect(rejectsSpan(&sectionSecondOwed, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 22)
      && rejectsSpan(&valueSecondOwed, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 23)
      && rejectsSpan(&methodValueSecondOwed, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 24),
    "an input a section, function value or method value shifts off position zero stays owed to the written environment (SEM0212)")
  // The exemption follows the written first parameter, not its instantiation: a generic first input
  // applied to a borrow is still assumed by the body, so the call still owes it. Run in place, the call
  // chooses an environment the local outlives; an Effect the caller returns pins it at the caller's.
  run Testing.expect(hasBorrowStatus(&genericFirstOwed, BodyBorrowStatus.Checked) && hasBorrowStatus(&ownerGenericFirstOwed, BodyBorrowStatus.Checked),
    "a generic first input instantiated as a borrow is owed only the environment a call run in place chooses")
  run Testing.expect(rejectsSpan(&genericFirstEscapes, RejectionCode.UnsatisfiedLifetimeBound, text, "&c", 56),
    "a generic first input owed to an environment the returned Effect pins at the caller's lifetime does not outlive it (SEM0212)")
  // An environment an invariant operand fixes at a declared caller lifetime outlives the whole body,
  // so a local's loan given to it is refused at the loan, through an interface operation (qualified,
  // receiver, generic, un-run, in an effect fn) as through a direct call.
  run Testing.expect(rejectsSpan(&refuseQualified, RejectionCode.UnsatisfiedLifetimeBound, text, "&c1", 0)
      && rejectsSpan(&refuseReceiver, RejectionCode.UnsatisfiedLifetimeBound, text, "&c2", 0)
      && rejectsSpan(&refuseLetRun, RejectionCode.UnsatisfiedLifetimeBound, text, "&c3", 0)
      && rejectsSpan(&refuseGeneric, RejectionCode.UnsatisfiedLifetimeBound, text, "&c4", 0)
      && rejectsSpan(&refuseGenericReceiver, RejectionCode.UnsatisfiedLifetimeBound, text, "&c5", 0)
      && rejectsSpan(&refuseInEffect, RejectionCode.UnsatisfiedLifetimeBound, text, "&c6", 0)
      && rejectsSpan(&refuseDirect, RejectionCode.UnsatisfiedLifetimeBound, text, "&c7", 0)
      && rejectsSpan(&refuseThroughLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&c8", 0),
    "a local's loan never outlives an environment fixed at a caller lifetime")
  run Testing.expect(rejectsSpan(&acceptOperand, RejectionCode.UnsatisfiedLifetimeBound, text, "&mut slot.*", 31)
      && rejectsSpan(&acceptOperandDirect, RejectionCode.UnsatisfiedLifetimeBound, text, "&mut slot.*", 32),
    "an operand at the caller's lifetime covers that environment, but the slot's shorter exclusive reborrow, also owed, does not (SEM0212)")
  // A reborrow through a reference only a local's loan lends is that loan, inline or through a
  // field; a 'static environment outlives the body as a declared lifetime does.
  run Testing.expect(rejectsSpan(&refuseReborrow, RejectionCode.UnsatisfiedLifetimeBound, text, "&c9", 0)
      && rejectsSpan(&refuseFieldReborrow, RejectionCode.UnsatisfiedLifetimeBound, text, "&c10", 0)
      && rejectsSpan(&refuseReborrowField, RejectionCode.UnsatisfiedLifetimeBound, text, "&c11", 0)
      && rejectsSpan(&refuseReborrowLetRun, RejectionCode.UnsatisfiedLifetimeBound, text, "&c12", 0)
      && rejectsSpan(&refuseReborrowGeneric, RejectionCode.UnsatisfiedLifetimeBound, text, "&c13", 0)
      && rejectsSpan(&refuseReborrowInEffect, RejectionCode.UnsatisfiedLifetimeBound, text, "&c14", 0)
      && rejectsSpan(&refuseReborrowSecond, RejectionCode.UnsatisfiedLifetimeBound, text, "&c15", 0)
      && rejectsSpan(&refuseStatic, RejectionCode.UnsatisfiedLifetimeBound, text, "&c16", 0)
      && rejectsSpan(&refuseStaticReceiver, RejectionCode.UnsatisfiedLifetimeBound, text, "&c17", 0)
      && rejectsSpan(&refuseStaticThroughLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&c18", 0),
    "a reborrow of a local's loan never outlives an environment fixed at a caller or 'static lifetime")
  run Testing.expect(rejectsSpan(&acceptReborrowParam, RejectionCode.UnsatisfiedLifetimeBound, text, "&mut slot.*", 44)
      && rejectsSpan(&acceptStatic, RejectionCode.UnsatisfiedLifetimeBound, text, "run StashyEnv.stashIt(&z, &mut slot.*, x)", 2),
    "beside a reborrow of the caller's own view or a 'static operand, the slot's shorter exclusive reborrow is still owed (SEM0212; at the call where the environment is 'static, as rustc blames an argument)")
  run Testing.expect(rejectsSpan(&acceptLocalSlot, RejectionCode.AccessDuringLoan, text, "s19.r.*", 0),
    "a local slot lent exclusively for the environment it holds stays lent while the slot is read (OWN0011)")
  // A reference reassigned on one path to another local reborrow still holds only the local's loan,
  // through a ladder of reborrows (`localLoanAtoms`).
  run Testing.expect(rejectsSpan(&refuseLadderOne, RejectionCode.UnsatisfiedLifetimeBound, text, "&nc", 0)
      && rejectsSpan(&refuseLadder12, RejectionCode.UnsatisfiedLifetimeBound, text, "&mc", 0),
    "a conditionally reassigned reborrow ladder over a local's loan never covers a caller environment")
  // An environment no argument chose shortens to the owned loans its owing inputs hold, so an Effect
  // left un-run, bound and run later, or run in place under a row bound naming no region is Checked.
  // A callable parameter is a representation `S: fn<'env>`: its storage keeps the argument's type.
  run Testing.expect(hasBorrowStatus(&routedUnrun, BodyBorrowStatus.Checked) && hasBorrowStatus(&routedLetRun, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&routedRow, BodyBorrowStatus.Checked) && hasBorrowStatus(&routedKept, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&routedRepresented, BodyBorrowStatus.Checked),
    "an environment no argument chose holds for the owned loans its inputs hold")
  // That storage holds only the argument's own callable type: a callee cannot store through it a
  // callable that captures what the shorter environment covers.
  run Testing.expect(rejectsSpan(&envSmuggle, RejectionCode.AssignmentTypeMismatch, text, "smuggled", 1),
    "a callable capturing the environment's region is never stored through a represented slot")
  // The shortened environment bounds its result, so storing it past the loan is refused; a binder a
  // declared bound names on its longer side or storage holds invariantly keeps 'static and leaves its
  // input owed. A shared input's contents are covariant, so the binder they name shortens.
  run Testing.expect(rejectsSpan(&routedStored, RejectionCode.UnsatisfiedLifetimeBound, text, "&stored", 0)
      && rejectsSpan(&routedPinned, RejectionCode.UnsatisfiedLifetimeBound, text, "&config", 5) && rejectsSpan(&routedInvariant, RejectionCode.UnsatisfiedLifetimeBound, text, "&config", 6),
    "a shortened environment never outlives its loans, and one an invariant input holds does not shorten")
  run Testing.expect(hasBorrowStatus(&routedShared, BodyBorrowStatus.Checked),
    "an environment a shared input's covariant contents name shortens with them, as rustc infers it")
  return ()
}

test effect fn impliedBoundsUnderExclusiveViews() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("implied-bounds-exclusive.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Key { value: i32 }
struct KPair<'b, 'a: 'b> { short: &'b Key, long: &'a Key }
struct Slot<'s> { k: &'s Key }
union UK<'b, 'a: 'b> { Both { short: &'b Key, long: &'a Key }, Neither }
fn get<'a, 'b>(p: &mut KPair<'b, 'a>) -> &'b Key { return p.long }
fn getU<'a, 'b>(u: &mut UK<'b, 'a>, d: &'b Key) -> &'b Key { return match &u.* { UK<'b, 'a>.Both {long, ..} => long.* UK<'b, 'a>.Neither => d } }
fn returned<'s>(x: &'s Key) -> &'s Key { let local = Key {value: 5} let mut p = KPair {short: x, long: &local} return get(&mut p) }
fn stored<'s>(x: &'s Key, slot: &mut Slot<'s>) -> () { let local = Key {value: 5} let mut p = KPair {short: x, long: &local} slot.k = get(&mut p) }
fn throughUnion<'s>(x: &'s Key) -> &'s Key { let local = Key {value: 5} let mut u = UK.Both {short: x, long: &local} return getU(&mut u, x) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let returned = run Semantic.demandBody(&mut store, &mut request, &id, b"returned") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let stored = run Semantic.demandBody(&mut store, &mut request, &id, b"stored") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let throughUnion = run Semantic.demandBody(&mut store, &mut request, &id, b"throughUnion") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&returned, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 0)
      && rejectsSpan(&stored, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 1)
      && rejectsSpan(&throughUnion, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 2),
    "a nominal's declared bound under an exclusive view is still owed, so a local its literal lends cannot reach the caller")
  return ()
}

test effect fn fieldStoredLoansJoinRegionProofs() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("field-stored-loans.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct View<'a> { oid: &'a i32 }
struct Two<'a, 'b> {
  first: &'a i32,
  inner: View<'b>,
}
struct Slot<'a> { oid: &'a mut i32 }
struct Shelf<'s> { held: View<'s> }
fn read(v: &View) -> i32 { return v.oid.* }
fn keep(v: View<'static>) -> i32 { return v.oid.* }
fn put<'s>(shelf: &mut Shelf<'s>, v: View<'s>) -> () { shelf.held = move v  return () }
fn restored() -> i32 { let x = 1  let mut v = View {oid: &x}  let first = read(&v)  let y = 2  v.oid = &y  return first + read(&v) }
fn scopeEnd() -> i32 { let x = 1  let mut v = View {oid: &x}  if x == 1 { let y = 2  v.oid = &y }  return v.oid.* }
fn loopStore() -> i32 { let x = 1  let mut v = View {oid: &x}  let mut i = 0  while i < 3 { let y = i  v.oid = &y  i = i + 1 }  return v.oid.* }
fn loopCarried() -> i32 { let x = 1  let mut v = View {oid: &x}  let mut i = 0  let mut total = 0  while i < 3 { total = total + v.oid.*  let y = i  v.oid = &y  i = i + 1 }  return total }
fn escape<'a>(x: &'a i32) -> View<'a> { let mut v = View<'a> {oid: x}  let y = 2  v.oid = &y  return move v }
fn projection() -> i32 { let x = 1  let z = 4  let mut t = Two {first: &x, inner: View {oid: &z}}  if x == 1 { let y = 2  t.inner.oid = &y }  return t.inner.oid.* + t.first.* }
fn writeReferent() -> i32 { let x = 1  let mut v = View {oid: &x}  let mut y = 2  v.oid = &y  y = 3  return v.oid.* }
fn aliasStore() -> i32 { let x = 1  let mut v = View {oid: &x}  if x == 1 { let y = 2  let h = &mut v  h.oid = &y }  return v.oid.* }
fn exclusiveStore() -> i32 { let mut x = 1  let mut y = 2  let mut v = Slot {oid: &mut x}  v.oid = &mut y  let read = y  return read + v.oid.* }
fn keptStatic() -> i32 { let x = 1  let mut v = View {oid: &x}  let y = 2  v.oid = &y  return keep(move v) }
fn keptParameter<'s>(shelf: &mut Shelf<'s>) -> () { let x = 1  let mut v = View {oid: &x}  let y = 2  v.oid = &y  put(&mut shelf.*, move v)  return () }
fn closureStore() -> i32 { let x = 1  let mut v = View {oid: &x}  if x == 1 { let y = 2  let set = fn() -> () { v.oid = &y  return () }  set() }  return v.oid.* }
struct Couple<'a, 'b> {
  left: &'a i32,
  right: &'b i32,
}
struct GPair<T> {
  left: T,
  right: i32,
}
fn pair<'a, 'b>(left: &'a i32, right: &'b i32) -> Couple<'a, 'b> { return Couple {left: left, right: right} }
fn same<'a>(left: &'a i32, right: &'a i32) -> Couple<'a, 'a> { return Couple {left: right, right: left} }
fn gpair<T>(left: T, right: i32) -> GPair<T> { return GPair<T> {left: move left, right: right} }
fn resultSibling(x: &i32) -> i32 { let mut owner = 3  let r = pair(&owner, x).right  owner = 1  return r.* + owner }
fn resultField(x: &i32) -> i32 { let mut owner = 3  let r = pair(&owner, x).left  owner = 1  return r.* }
fn resultShared(x: &i32) -> i32 { let mut owner = 3  let r = same(&owner, x).right  owner = 1  return r.* }
fn resultGeneric() -> i32 { let mut owner = 3  let r = gpair(&owner, 1).left  owner = 1  return r.* }
struct Hooked<'a, 'b> {
  left: &'a i32,
  right: &'b i32,
}
impl<'a, 'b> Intrinsic.Drop for Hooked<'a, 'b> { fn drop(self: &mut Hooked<'a, 'b>) -> () { let seen = self.left.*  return () } }
struct Plain<'a, 'b> {
  left: &'a i32,
  right: &'b i32,
}
struct Guarded<'a, 'b> {
  hooked: Hooked<'a, 'b>,
  right: &'b i32,
}
fn hooked<'a, 'b>(left: &'a i32, right: &'b i32) -> Hooked<'a, 'b> { return Hooked {left: left, right: right} }
fn plain<'a, 'b>(left: &'a i32, right: &'b i32) -> Plain<'a, 'b> { return Plain {left: left, right: right} }
fn guarded<'a, 'b>(left: &'a i32, right: &'b i32) -> Guarded<'a, 'b> { return Guarded {hooked: Hooked {left: left, right: right}, right: right} }
fn viewOf<'a>(v: &'a i32) -> &'a i32 { return v }
fn spend(v: i32) -> i32 { return v }
fn hookedRead(x: &i32) -> i32 { let mut owner = 3  let r = hooked(&owner, x).right  let s = r.*  owner = 1  return s + owner }
fn hookedMove(x: &i32) -> i32 { let mut owner = 3  let r = hooked(&owner, x).right  let s = r.*  let n = spend(move owner)  return s + n }
fn hookedField(x: &i32) -> i32 { let mut owner = 3  let r = guarded(&owner, x).right  let s = r.*  owner = 1  return s + owner }
fn hookedArgument(x: &i32) -> i32 { let mut owner = 3  let r = viewOf(hooked(&owner, x).right)  let s = r.*  owner = 1  return s + owner }
fn hookedStatement(x: &i32) -> i32 { let mut owner = 3  let s = hooked(&owner, x).right.*  owner = 1  return s + owner }
fn hookedScoped(x: &i32) -> i32 { let mut owner = 3  let mut s = 0  if s == 0 { let r = hooked(&owner, x).right  s = r.* }  owner = 1  return s + owner }
fn plainRead(x: &i32) -> i32 { let mut owner = 3  let r = plain(&owner, x).right  let s = r.*  owner = 1  return s + owner }
fn pairSum(a: i32, b: i32) -> i32 { return a + b }
fn hookedOperand(x: &i32) -> i32 { let owner = 3  let s = pairSum(hooked(&owner, x).left.*, spend(move owner))  return s }
fn hookedCondition(x: &i32) -> i32 { let owner = 3  if hooked(&owner, x).right.* > spend(move owner) { return 1 }  return 0 }
fn hookedNext(x: &i32) -> i32 { let owner = 3  let s = pairSum(hooked(&owner, x).left.*, 1)  let n = spend(move owner)  return s + n }
struct AnyHooked<'a, 'b, T> {
  left: &'a i32,
  right: &'b i32,
  extra: T,
}
impl<'a, 'b, T> Intrinsic.Drop for AnyHooked<'a, 'b, T> { fn drop(self: &mut AnyHooked<'a, 'b, T>) -> () { let seen = self.left.*  return () } }
fn anyHooked<'a, 'b, T>(left: &'a i32, right: &'b i32, extra: T) -> AnyHooked<'a, 'b, T> { return AnyHooked {left: left, right: right, extra: move extra} }
fn hookedGeneric<T>(x: &i32, extra: T) -> i32 { let mut owner = 3  let r = anyHooked<T>(&owner, x, move extra).right  let s = r.*  owner = 1  return s }
fn hookedLater(x: &i32) -> i32 { let mut owner = 3  let r = hooked(&owner, x).right  owner = 1  return r.* }
fn hookedLaterMove(x: &i32) -> i32 { let mut owner = 3  let r = hooked(&owner, x).right  let n = spend(move owner)  return r.* + n }
struct RefOfRef<'a, 'b> { b: &'b &'a i32 }
struct NestedRefOfRef<'a, 'b> {
  inner: RefOfRef<'a, 'b>,
  n: i32,
}
fn coupleThrough<'a, 'b>(left: &'a i32, both: RefOfRef<'a, 'b>) -> Couple<'a, 'b> { return Couple {left: left, right: left} }
fn coupleNested<'a, 'b>(left: &'a i32, outer: NestedRefOfRef<'a, 'b>) -> Couple<'a, 'b> { return Couple {left: left, right: left} }
fn assumedThrough(x: &i32, s: & &i32) -> i32 { let mut owner = 3  let r = coupleThrough(&owner, RefOfRef {b: s}).right  owner = 1  return r.* }
fn assumedNested(x: &i32, s: & &i32) -> i32 { let mut owner = 3  let r = coupleNested(&owner, NestedRefOfRef {inner: RefOfRef {b: s}, n: 0}).right  owner = 1  return r.* }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let restored = run Semantic.demandBody(&mut store, &mut request, &id, b"restored") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hasBorrowStatus(&restored, BodyBorrowStatus.Checked),
    "a loan a field store gives a local holder is proved by typing's relation into the field, valid wherever the holder is used")
  let scopeEnd = run Semantic.demandBody(&mut store, &mut request, &id, b"scopeEnd") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let loopStore = run Semantic.demandBody(&mut store, &mut request, &id, b"loopStore") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let loopCarried = run Semantic.demandBody(&mut store, &mut request, &id, b"loopCarried") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let escape = run Semantic.demandBody(&mut store, &mut request, &id, b"escape") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let projection = run Semantic.demandBody(&mut store, &mut request, &id, b"projection") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&scopeEnd, RejectionCode.ExpiredLifetime, text, "v.oid.*", 2)
    && rejectsSpan(&loopStore, RejectionCode.ExpiredLifetime, text, "v.oid.*", 3)
    && rejectsSpan(&loopCarried, RejectionCode.ExpiredLifetime, text, "v.oid.*", 4),
    "a stored loan of storage that ends before the holder's use, after a scope or across a loop, is OWN0019")
  run Testing.expect(rejectsSpan(&escape, RejectionCode.UnsatisfiedLifetimeBound, text, "&y", 4)
    && rejectsSpan(&projection, RejectionCode.ExpiredLifetime, text, "t.inner.oid.*", 0),
    "a stored body loan cannot leave in a returned holder (SEM0212 at its borrow), nor outlive its storage through a nested field (OWN0019)")
  let writeReferent = run Semantic.demandBody(&mut store, &mut request, &id, b"writeReferent") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let aliasStore = run Semantic.demandBody(&mut store, &mut request, &id, b"aliasStore") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let exclusiveStore = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusiveStore") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let keptStatic = run Semantic.demandBody(&mut store, &mut request, &id, b"keptStatic") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let keptParameter = run Semantic.demandBody(&mut store, &mut request, &id, b"keptParameter") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let closureStore = run Semantic.demandBody(&mut store, &mut request, &id, b"closureStore") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(!hasBorrowStatus(&writeReferent, BodyBorrowStatus.Checked) && !hasBorrowStatus(&aliasStore, BodyBorrowStatus.Checked)
    && !hasBorrowStatus(&exclusiveStore, BodyBorrowStatus.Checked),
    "a stored loan's referent written while the holder is live, a store through an exclusive alias of the holder, and a stored exclusive loan read around are never proved")
  run Testing.expect(!hasBorrowStatus(&keptStatic, BodyBorrowStatus.Checked) && !hasBorrowStatus(&keptParameter, BodyBorrowStatus.Checked)
    && !hasBorrowStatus(&closureStore, BodyBorrowStatus.Checked),
    "a holder carrying a stored body loan, moved to a callee keeping it at a universal region or stored in a closure, is never proved")
  let resultSibling = run Semantic.demandBody(&mut store, &mut request, &id, b"resultSibling") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let resultField = run Semantic.demandBody(&mut store, &mut request, &id, b"resultField") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let resultShared = run Semantic.demandBody(&mut store, &mut request, &id, b"resultShared") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let resultGeneric = run Semantic.demandBody(&mut store, &mut request, &id, b"resultGeneric") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hasBorrowStatus(&resultSibling, BodyBorrowStatus.Checked),
    "a field read of a call's result holds no loan its signature types only at a sibling field's own region")
  run Testing.expect(rejectsSpan(&resultField, RejectionCode.AccessDuringLoan, text, "owner", 6)
    && rejectsSpan(&resultShared, RejectionCode.AccessDuringLoan, text, "owner", 9)
    && rejectsSpan(&resultGeneric, RejectionCode.AccessDuringLoan, text, "owner", 12),
    "the field that names the loan's region, a sibling sharing it, and a generic field that may hold it keep the loan (OWN0011)")
  let hookedRead = run Semantic.demandBody(&mut store, &mut request, &id, b"hookedRead") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let hookedMove = run Semantic.demandBody(&mut store, &mut request, &id, b"hookedMove") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let hookedField = run Semantic.demandBody(&mut store, &mut request, &id, b"hookedField") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let hookedArgument = run Semantic.demandBody(&mut store, &mut request, &id, b"hookedArgument") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let hookedStatement = run Semantic.demandBody(&mut store, &mut request, &id, b"hookedStatement") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let hookedScoped = run Semantic.demandBody(&mut store, &mut request, &id, b"hookedScoped") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let plainRead = run Semantic.demandBody(&mut store, &mut request, &id, b"plainRead") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&hookedRead, RejectionCode.AccessDuringLoan, text, "owner", 15)
    && rejectsSpan(&hookedMove, RejectionCode.AccessDuringLoan, text, "owner", 19)
    && rejectsSpan(&hookedField, RejectionCode.AccessDuringLoan, text, "owner", 22)
    && rejectsSpan(&hookedArgument, RejectionCode.AccessDuringLoan, text, "owner", 26),
    "a projection out of a binding initializer's temporary keeps that temporary to the binding's scope, so its Drop hook, even a field's, observes its loans there (OWN0011)")
  run Testing.expect(hasBorrowStatus(&hookedStatement, BodyBorrowStatus.Checked) && hasBorrowStatus(&hookedScoped, BodyBorrowStatus.Checked)
    && hasBorrowStatus(&plainRead, BodyBorrowStatus.Checked),
    "a temporary that ends with its statement or with an inner scope before the write, or that runs no hook, leaves the write checked")
  let hookedOperand = run Semantic.demandBody(&mut store, &mut request, &id, b"hookedOperand") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let hookedCondition = run Semantic.demandBody(&mut store, &mut request, &id, b"hookedCondition") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let hookedNext = run Semantic.demandBody(&mut store, &mut request, &id, b"hookedNext") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&hookedOperand, RejectionCode.AccessDuringLoan, text, "owner", 42)
    && rejectsSpan(&hookedCondition, RejectionCode.AccessDuringLoan, text, "owner", 45),
    "a projection out of a statement's temporary keeps that temporary to the statement's end, so a later operand cannot move what its hook observes (OWN0011)")
  run Testing.expect(hasBorrowStatus(&hookedNext, BodyBorrowStatus.Checked),
    "a move in the next statement follows the statement temporary's cleanup")
  let hookedGeneric = run Semantic.demandBody(&mut store, &mut request, &id, b"hookedGeneric") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&hookedGeneric, RejectionCode.AccessDuringLoan, text, "owner", 51),
    "a temporary's hook whose observed regions a type parameter leaves unknown observes every loan the temporary holds (OWN0011)")
  let hookedLater = run Semantic.demandBody(&mut store, &mut request, &id, b"hookedLater") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let hookedLaterMove = run Semantic.demandBody(&mut store, &mut request, &id, b"hookedLaterMove") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let assumedThrough = run Semantic.demandBody(&mut store, &mut request, &id, b"assumedThrough") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let assumedNested = run Semantic.demandBody(&mut store, &mut request, &id, b"assumedNested") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&hookedLater, RejectionCode.AccessDuringLoan, text, "owner", 54)
    && rejectsSpan(&hookedLaterMove, RejectionCode.AccessDuringLoan, text, "owner", 57),
    "a sibling projection out of a hooked temporary keeps none of the hook's loans for itself, but the temporary keeps them to its cleanup (OWN0011)")
  run Testing.expect(rejectsSpan(&assumedThrough, RejectionCode.AccessDuringLoan, text, "owner", 60)
    && rejectsSpan(&assumedNested, RejectionCode.AccessDuringLoan, text, "owner", 63),
    "a sibling projection keeps a loan its callee may put there by a bound its signature implies, nested in an argument's type (OWN0011)")
  return ()
}

test effect fn lentReceiversMeetTheirExplicitLoan() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run lentReceiverClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// Each implicit receiver loan against the explicit `Owner.member(&place)` call it stands for.
effect fn lentReceiverClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("lent-receivers.silk")
  let text = """
struct Trailers<'owner> { bytes: &'owner [u8], count: usize }
impl<'owner> Trailers<'owner> {
  fn fields(self: &'owner Self) -> Iter<'owner> { return Iter<'owner> {bytes: self.bytes, index: 0} }
  fn consume(self: Self) -> usize { return self.count }
}
struct Iter<'owner> { bytes: &'owner [u8], index: usize }
struct Reader<'r> { data: &'r [u8] }
impl<'r> Reader<'r> { fn trailers<'own>(self: &'own Self) -> Trailers<'own> { return Trailers<'own> {bytes: self.data, count: 1} } }
struct Cell<'o, T> { item: &'o T }
impl<'o, T> Cell<'o, T> {
  fn get(self: &'o Self) -> &'o T { return self.item }
  fn convert<U>(self: &'o Self, value: U) -> U { return move value }
}
struct Pair<'o, A, B> { first: &'o A, second: B }
impl<'o, A, B> Pair<'o, A, B> { fn tail<U>(self: &'o Self, value: U) -> &'o B { drop value  return &self.second } }
struct Holder<'owner> { view: &'owner i32 }
impl<'owner> Holder<'owner> { fn touch(self: &'owner mut Self) -> i32 { return self.view.* } }
fn make<'m>(src: &'m [u8]) -> Trailers<'m> { return Trailers {bytes: src, count: 1} }
fn covImplicit<'c, 'r: 'c>(reader: &'c Reader<'r>) -> usize { let t = Reader.trailers(reader)  let f = t.fields()  return f.index }
fn covExplicit<'c, 'r: 'c>(reader: &'c Reader<'r>) -> usize { let t = Reader.trailers(reader)  let f = Trailers.fields(&t)  return f.index }
fn genericImplicit<'a>(x: &'a u64) -> u64 { let c = Cell {item: x}  return c.get().* }
fn genericExplicit<'a>(x: &'a u64) -> u64 { let c = Cell {item: x}  return Cell.get(&c).* }
fn escapeImplicit<'r>(src: &'r [u8]) -> Iter<'r> { let t = Trailers {bytes: src, count: 1}  return t.fields() }
fn escapeExplicit<'r>(src: &'r [u8]) -> Iter<'r> { let t = Trailers {bytes: src, count: 1}  return Trailers.fields(&t) }
fn writeImplicit<'r>(src: &'r [u8]) -> usize { let mut t = Trailers {bytes: src, count: 1}  let f = t.fields()  t.count = 2  return f.index }
fn writeExplicit<'r>(src: &'r [u8]) -> usize { let mut t = Trailers {bytes: src, count: 1}  let f = Trailers.fields(&t)  t.count = 2  return f.index }
fn tempImplicit<'r>(src: &'r [u8]) -> usize { let f = make(src).fields()  return f.index }
fn tempExplicit<'r>(src: &'r [u8]) -> usize { let f = Trailers.fields(&make(src))  return f.index }
fn tempBorrowImplicit<'r>(src: &'r [u8]) -> u8 { let f = make(src).fields()  return f.bytes[0] }
fn tempBorrowExplicit<'r>(src: &'r [u8]) -> u8 { let f = Trailers.fields(&make(src))  return f.bytes[0] }
fn exclusiveImplicit<'a>(x: &'a i32) -> i32 { let mut h = Holder {view: x}  return h.touch() }
fn exclusiveExplicit<'a>(x: &'a i32) -> i32 { let mut h = Holder {view: x}  return Holder.touch(&mut h) }
fn derefImplicit<'c, 'r>(t: &'c Trailers<'r>) -> usize { let f = t.*.fields()  return f.index }
fn derefExplicit<'c, 'r>(t: &'c Trailers<'r>) -> usize { let f = Trailers.fields(&t.*)  return f.index }
fn reborrowImplicit<'c, 'a>(h: &'c mut Holder<'a>) -> i32 { return h.*.touch() }
fn reborrowExplicit<'c, 'a>(h: &'c mut Holder<'a>) -> i32 { return Holder.touch(&mut h.*) }
fn writtenList<'a>(x: &'a u64) -> u8 { let c = Cell {item: x}  return c.convert<u8>(3) }
fn writtenListMismatch<'a>(x: &'a u64) -> u8 { let c = Cell {item: x}  return c.convert<u8>(true) }
fn writtenOwnerSlot<'a>(x: &'a u64) -> bool { let p = Pair {first: x, second: true}  let b: bool = p.tail<u8>(3).*  return b }
fn writtenOwnerSlotMismatch<'a>(x: &'a u64) -> u8 { let p = Pair {first: x, second: true}  let b: u8 = p.tail<u8>(3).*  return b }
fn byValue<'r>(src: &'r [u8]) -> usize { let t = Trailers {bytes: src, count: 1}  return t.consume() }
fn borrowed<'c, 'r>(t: &'c Trailers<'r>) -> usize { let f = t.fields()  return f.index }
struct Wrap<T> { value: T }
impl<T> Wrap<T> { fn mix(self: &Wrap<u8>, other: T) -> u8 { drop other  return self.value } }
fn mixImplicit() -> u8 { let wrapped = Wrap<u8> {value: 3}  return wrapped.mix(true) }
fn mixExplicit() -> u8 { let wrapped = Wrap<u8> {value: 3}  return (&wrapped).mix(true) }
struct Builder<'c> { base: string<'c> }
impl<'c> Builder<'c> {
  fn make() -> Builder<'c> { return Builder<'c> {base: ""} }
  fn baseUrl(self: Self, url: string<'c>) -> Builder<'c> { return Builder<'c> {base: url} }
}
fn chainImplicit(url: string) -> i32 { let b = Builder.make().baseUrl(url).baseUrl("fixed")  return 0 }
fn chainExplicit(url: string) -> i32 { let b = Builder.baseUrl(Builder.baseUrl(Builder.make(), url), "fixed")  return 0 }
fn heldImplicit(url: string) -> i32 { let made = Builder.make()  let b = made.baseUrl(url)  return 0 }
fn keptImplicit<'k>(url: string<'k>) -> Builder<'k> { return Builder.make().baseUrl(url) }
fn escapeTaken(url: string) -> Builder<'static> { return Builder.make().baseUrl(url) }
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut store = makeSemantic(move revision)
  let mut request = Request.make()
  let covImplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"covImplicit")
  let covExplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"covExplicit")
  let genericImplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"genericImplicit")
  let genericExplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"genericExplicit")
  let derefImplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"derefImplicit")
  let derefExplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"derefExplicit")
  run Testing.expect(hasBorrowStatus(&covImplicit, BodyBorrowStatus.Checked) && hasBorrowStatus(&covExplicit, BodyBorrowStatus.Checked)
    && hasBorrowStatus(&genericImplicit, BodyBorrowStatus.Checked) && hasBorrowStatus(&genericExplicit, BodyBorrowStatus.Checked)
    && hasBorrowStatus(&derefImplicit, BodyBorrowStatus.Checked) && hasBorrowStatus(&derefExplicit, BodyBorrowStatus.Checked),
    "a lent receiver infers its owner's binders from the loan's referent, so a covariant owner's region meets the loan as `&place` does")
  let escapeImplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"escapeImplicit")
  let escapeExplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"escapeExplicit")
  run Testing.expect(rejectsSpan(&escapeImplicit, RejectionCode.UnsatisfiedLifetimeBound, text, "t.fields()", usize.ONE)
    && rejectsSpan(&escapeExplicit, RejectionCode.UnsatisfiedLifetimeBound, text, "&t", usize.ONE),
    "a lent receiver's result cannot outlive the local it borrows")
  let writeImplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"writeImplicit")
  let writeExplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"writeExplicit")
  run Testing.expect(rejectsSpan(&writeImplicit, RejectionCode.AccessDuringLoan, text, "t.count", usize.ZERO)
    && rejectsSpan(&writeExplicit, RejectionCode.AccessDuringLoan, text, "t.count", usize.ONE),
    "the lent receiver's loan stays live while its result does, so a write to the place conflicts")
  let tempImplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"tempImplicit")
  let tempExplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"tempExplicit")
  run Testing.expect(rejectsSpan(&tempImplicit, RejectionCode.ExpiredLifetime, text, "f.index", 4)
    && rejectsSpan(&tempExplicit, RejectionCode.ExpiredLifetime, text, "f.index", 5),
    "liveness is per local, so reading only a result's scalar sibling still retains the temporary receiver's loan (OWN0019)")
  let tempBorrowImplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"tempBorrowImplicit")
  let tempBorrowExplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"tempBorrowExplicit")
  run Testing.expect(rejectsSpan(&tempBorrowImplicit, RejectionCode.ExpiredLifetime, text, "f.bytes[0]", usize.ZERO)
    && rejectsSpan(&tempBorrowExplicit, RejectionCode.ExpiredLifetime, text, "f.bytes[0]", usize.ONE),
    "reading the retained field still outlives the temporary receiver, implicit or explicit (OWN0019)")
  let exclusiveImplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusiveImplicit")
  let exclusiveExplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusiveExplicit")
  let reborrowImplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrowImplicit")
  let reborrowExplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrowExplicit")
  run Testing.expect(rejectsSpan(&exclusiveImplicit, RejectionCode.TypeMismatch, text, "touch", usize.ONE)
    && rejectsSpan(&exclusiveExplicit, RejectionCode.TypeMismatch, text, "Holder.touch(&mut h)", usize.ZERO)
    && rejectsSpan(&reborrowImplicit, RejectionCode.TypeMismatch, text, "touch", 3)
    && rejectsSpan(&reborrowExplicit, RejectionCode.TypeMismatch, text, "Holder.touch(&mut h.*)", usize.ZERO),
    "an exclusive loan of a local or of a shorter reborrow cannot last as long as the invariant owner region it must equal")
  let writtenList = run Semantic.demandBody(&mut store, &mut request, &id, b"writtenList")
  let writtenListMismatch = run Semantic.demandBody(&mut store, &mut request, &id, b"writtenListMismatch")
  let writtenOwnerSlot = run Semantic.demandBody(&mut store, &mut request, &id, b"writtenOwnerSlot")
  let writtenOwnerSlotMismatch = run Semantic.demandBody(&mut store, &mut request, &id, b"writtenOwnerSlotMismatch")
  run Testing.expect(hasBorrowStatus(&writtenList, BodyBorrowStatus.Checked)
    && rejectsSpan(&writtenListMismatch, RejectionCode.TypeMismatch, text, "true", usize.ZERO)
    && hasBorrowStatus(&writtenOwnerSlot, BodyBorrowStatus.Checked)
    && rejectsSpan(&writtenOwnerSlotMismatch, RejectionCode.AssignmentTypeMismatch, text, "p.tail<u8>(3).*", usize.ONE),
    "a written list on a lent receiver binds the member's own binders after the owner's, which the receiver supplies (GEN-008)")
  let mixImplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"mixImplicit")
  let mixExplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"mixExplicit")
  run Testing.expect(rejectsSpan(&mixImplicit, RejectionCode.TypeMismatch, text, "true", 3)
    && rejectsSpan(&mixExplicit, RejectionCode.TypeMismatch, text, "true", 4),
    "a receiver of a fixed instance keeps the owner its type fixes, lent or not")
  let byValue = run Semantic.demandBody(&mut store, &mut request, &id, b"byValue")
  let borrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowed")
  run Testing.expect(hasBorrowStatus(&byValue, BodyBorrowStatus.Checked) && succeeded(&borrowed),
    "a by-value receiver and a receiver that is already a reference lend nothing")
  let chainImplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"chainImplicit")
  let chainExplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"chainExplicit")
  let heldImplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"heldImplicit")
  let keptImplicit = run Semantic.demandBody(&mut store, &mut request, &id, b"keptImplicit")
  run Testing.expect(hasBorrowStatus(&chainImplicit, BodyBorrowStatus.Checked) && hasBorrowStatus(&chainExplicit, BodyBorrowStatus.Checked)
    && hasBorrowStatus(&heldImplicit, BodyBorrowStatus.Checked) && hasBorrowStatus(&keptImplicit, BodyBorrowStatus.Checked),
    "a by-value receiver infers its owner's binders as the explicit moved operand does, so a later runtime operand meets the 'static a constructor chose")
  let escapeTaken = run Semantic.demandBody(&mut store, &mut request, &id, b"escapeTaken")
  run Testing.expect(rejectsSpan(&escapeTaken, RejectionCode.ReturnTypeMismatch, text, "Builder.make().baseUrl(url)", 2),
    "a by-value receiver's met region never escapes as 'static")
  return ()
}

test effect fn laterLocalOperandsMeetFixedCallerLifetimes() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run laterLocalOperandClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn laterLocalOperandClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("later-local-operands.silk")
  let text = """
struct Tok<'t> { b: &'t [u8] }
struct Holder<'h> { b: &'h [u8] }
service Keeper<'k> { effect fn put(v: &'k [u8]) -> () ? &mut Keeper<'k> }
fn pair<'x>(a: &'x [u8], b: &'x [u8]) -> usize { return a.length + b.length }
fn pick<'x>(a: &'x [u8], b: &'x [u8]) -> &'x [u8] { return a }
fn wrap<'x>(a: Tok<'x>, b: Tok<'x>) -> usize { return a.b.length + b.b.length }
fn triple<'x>(r: &'x [u8], e: &'x [Tok<'x>], n: usize) -> usize { return r.length + e.length + n }
fn holdMut<'x>(h: &mut Holder<'x>, a: &'x [u8], b: &'x [u8]) -> () { h.b = b return () }
effect fn keepBoth<'x>(a: &'x [u8], b: &'x [u8]) -> () ? &mut Keeper<'x> { run Keeper<'x>.put(b) }
fn apply<'x>(a: &'x [u8], b: &'x [u8], f: fn(&'x [u8]) -> usize) -> usize { return f(a) }
fn bounded<'w, 'x: 'w>(a: &'x [u8], b: &'x [u8], w: &'w [u8]) -> usize { return a.length + w.length }
effect<'x> fn envBoth<'x>(a: &'x [u8], b: &'x [u8]) -> usize { return a.length + b.length }
effect<'x> fn envPick<'x>(a: &'x [u8], b: &'x [u8]) -> &'x [u8] { return a }
effect<'x> fn envKeep<'x>(a: &'x [u8], b: &'x [u8]) -> () ? &mut Keeper<'x> { run Keeper<'x>.put(b) }
fn universalFirst<'v>(p: &'v [u8]) -> usize { let l1: [u8; 4] = [0, 0, 0, 0] return pair(p, &l1) }
fn localFirst<'v>(p: &'v [u8]) -> usize { let l2: [u8; 4] = [0, 0, 0, 0] return pair(&l2, p) }
fn explicitMeet<'v>(p: &'v [u8]) -> usize { let l3: [u8; 4] = [0, 0, 0, 0] let view: &[u8] = &l3 return pair(p, view) }
fn structFirst<'v>(p: Tok<'v>) -> usize { let l4: [u8; 4] = [0, 0, 0, 0] return wrap(move p, Tok { b: &l4 }) }
fn tripleFirst<'v>(r: &'v [u8]) -> usize {
  let l5: [u8; 4] = [0, 0, 0, 0]
  let entries = [Tok { b: &l5 }]
  return triple(r, &entries, 1)
}
effect fn envRun<'v>(p: &'v [u8]) -> usize { let l6: [u8; 4] = [0, 0, 0, 0] return run envBoth(p, &l6) }
fn returned<'v>(p: &'v [u8]) -> &'v [u8] {
  let r1: [u8; 4] = [0, 0, 0, 0]
  return pick(p, &r1)
}
fn invariantMut<'v>(h: &mut Holder<'v>, p: &'v [u8]) -> () {
  let r2: [u8; 4] = [0, 0, 0, 0]
  holdMut(&mut h.*, p, &r2)
}
effect fn serviceRow<'v>(p: &'v [u8]) -> () ? &mut Keeper<'v> {
  let r3: [u8; 4] = [0, 0, 0, 0]
  run keepBoth(p, &r3)
}
fn contravariant<'v>(p: &'v [u8]) -> usize {
  let r4: [u8; 4] = [0, 0, 0, 0]
  let f = fn(x: &'v [u8]) -> usize { return x.length }
  return apply(p, &r4, f)
}
fn written<'v>(p: &'v [u8]) -> usize { let r5: [u8; 4] = [0, 0, 0, 0] return pair<'v>(p, &r5) }
fn boundBlocks<'v>(p: &'v [u8]) -> usize { let r6: [u8; 4] = [0, 0, 0, 0] return bounded(p, &r6, p) }
fn escapeEffect<'v>(p: &'v [u8]) -> Effect<'v; usize> {
  let r7: [u8; 4] = [0, 0, 0, 0]
  return envBoth(p, &r7)
}
effect fn escapeResult<'v>(p: &'v [u8]) -> &'v [u8] {
  let r8: [u8; 4] = [0, 0, 0, 0]
  return run envPick(p, &r8)
}
effect fn envRow<'v>(p: &'v [u8]) -> () ? &mut Keeper<'v> {
  let r9: [u8; 4] = [0, 0, 0, 0]
  run envKeep(p, &r9)
}
struct Two<'p, 'q: 'p> { p: &'p i32, q: &'q i32 }
struct Src { t: i32, u: i32 }
fn takeTwo<'z, 'w, 'v: 'w>(x: Two<'z, 'w>, head: &'v i32) -> &'z i32 { return head }
fn choose<'x>(a: &'x i32, b: &'x i32, first: bool) -> &'x i32 { if first { return a } return b }
fn impliedBound<'v>(h: Two<'v, 'v>) -> &'v i32 { let r10 = 5 return takeTwo(move h, &r10) }
fn placeBorrow<'v>(fallback: &'v i32, src: &'v Src, first: bool) -> &'v i32 { return choose(fallback, &src.u, first) }
struct Duo<'a, 'b> { a: &'a i32, b: &'b i32 }
struct Pocket<'s> { r: &'s i32 }
fn split<'x, 'y>(p: &'x i32, q: &'y i32, l: &'y i32) -> &'x i32 { return p }
fn splitDuo<'x, 'y>(p: &'x i32, q: &'y i32, l: &'y i32) -> Duo<'x, 'y> { return Duo {a: p, b: l} }
fn sharedBinders<'v>(p: &'v i32) -> &'v i32 { let s1 = 5 return split(p, p, &s1) }
fn distinctBinders<'v, 'u>(p: &'v i32, q: &'u i32) -> &'v i32 { let s2 = 5 return split(p, q, &s2) }
fn sharedDuo<'v>(p: &'v i32) -> &'v i32 { let s3 = 5 let t = splitDuo(p, p, &s3) return t.a }
fn sharedDuoB<'v>(p: &'v i32) -> &'v i32 { let s5 = 5 let t = splitDuo(p, p, &s5) return t.b }
fn sharedDuoRead<'v>(p: &'v i32) -> &'v i32 { let s6 = 5 let t = splitDuo(p, p, &s6) let heldDuo = t.b return heldDuo }
fn sharedStored<'v>(p: &'v i32, c: &mut Pocket<'v>) -> () { let s4 = 5 c.r = split(p, p, &s4) }
fn tkRef<'z, 'w>(x: &'z &'w i32, l: &'w i32, out: &mut Pocket<'z>) -> () { out.r = l }
fn tkRefCount<'z, 'w>(x: &'z &'w i32, l: &'w i32, out: &mut Pocket<'z>) -> i32 { out.r = l return 1 }
fn tkPocket<'z, 'w>(x: &'z Pocket<'w>, l: &'w i32, out: &mut Pocket<'z>) -> i32 { out.r = l return 1 }
fn tkSlice<'z, 'w>(x: &'z [&'w i32], l: &'w i32, out: &mut Pocket<'z>) -> i32 { out.r = l return 1 }
fn impliedRef<'v>(x: &'v &'v i32, out: &mut Pocket<'v>) -> () { let i1 = 5 tkRef(x, &i1, &mut out.*) }
fn impliedRefCount<'v>(x: &'v &'v i32, out: &mut Pocket<'v>) -> i32 { let i2 = 5 return tkRefCount(x, &i2, &mut out.*) }
fn impliedPocket<'v>(x: &'v Pocket<'v>, out: &mut Pocket<'v>) -> i32 { let i3 = 5 return tkPocket(x, &i3, &mut out.*) }
fn impliedSlice<'v>(x: &'v [&'v i32], out: &mut Pocket<'v>) -> i32 { let i4 = 5 return tkSlice(x, &i4, &mut out.*) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let universalFirst = run Semantic.demandBody(&mut store, &mut request, &id, b"universalFirst")
  let localFirst = run Semantic.demandBody(&mut store, &mut request, &id, b"localFirst")
  let explicitMeet = run Semantic.demandBody(&mut store, &mut request, &id, b"explicitMeet")
  let structFirst = run Semantic.demandBody(&mut store, &mut request, &id, b"structFirst")
  let tripleFirst = run Semantic.demandBody(&mut store, &mut request, &id, b"tripleFirst")
  let envRun = run Semantic.demandBody(&mut store, &mut request, &id, b"envRun")
  run Testing.expect(hasBorrowStatus(&universalFirst, BodyBorrowStatus.Checked) && hasBorrowStatus(&localFirst, BodyBorrowStatus.Checked),
    "a later local operand meets a call lifetime an earlier operand fixed to the caller's, in either order")
  run Testing.expect(hasBorrowStatus(&explicitMeet, BodyBorrowStatus.Checked) && hasBorrowStatus(&structFirst, BodyBorrowStatus.Checked),
    "the operand's region may come from a local view or a struct literal")
  run Testing.expect(hasBorrowStatus(&tripleFirst, BodyBorrowStatus.Checked),
    "a binder the parameter names more than once meets every region the operand offers there")
  run Testing.expect(hasBorrowStatus(&envRun, BodyBorrowStatus.Checked),
    "an Effect environment the binder names shortens with it when the Effect runs in the body")
  let returned = run Semantic.demandBody(&mut store, &mut request, &id, b"returned")
  let invariantMut = run Semantic.demandBody(&mut store, &mut request, &id, b"invariantMut")
  let serviceRow = run Semantic.demandBody(&mut store, &mut request, &id, b"serviceRow")
  let contravariant = run Semantic.demandBody(&mut store, &mut request, &id, b"contravariant")
  let escapeEffect = run Semantic.demandBody(&mut store, &mut request, &id, b"escapeEffect")
  let escapeResult = run Semantic.demandBody(&mut store, &mut request, &id, b"escapeResult")
  let envRow = run Semantic.demandBody(&mut store, &mut request, &id, b"envRow")
  run Testing.expect(rejectsSpan(&returned, RejectionCode.UnsatisfiedLifetimeBound, text, "&r1", 0)
      && rejectsSpan(&escapeResult, RejectionCode.UnsatisfiedLifetimeBound, text, "&r8", 0),
    "a shortened result still cannot carry the local out at the caller's lifetime (SEM0212 at the borrow)")
  run Testing.expect(rejectsSpan(&escapeEffect, RejectionCode.UnsatisfiedLifetimeBound, text, "&r7", 0),
    "an Effect whose environment holds the local cannot escape the frame: the borrow must outlive the caller's lifetime (SEM0212)")
  run Testing.expect(rejectsSpan(&invariantMut, RejectionCode.UnsatisfiedLifetimeBound, text, "&r2", 0)
      && rejectsSpan(&contravariant, RejectionCode.UnsatisfiedLifetimeBound, text, "&r4", 0),
    "an exclusive or contravariant use of the binder never shortens it, so the local borrow must outlive the caller's lifetime (SEM0212)")
  run Testing.expect(rejectsSpan(&serviceRow, RejectionCode.UnsatisfiedLifetimeBound, text, "&r3", 0)
      && rejectsSpan(&envRow, RejectionCode.UnsatisfiedLifetimeBound, text, "&r9", 0),
    "a requirement row naming the binder never shortens it, with or without a written environment, so the local borrow must outlive the caller's lifetime (SEM0212)")
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"written")
  let boundBlocks = run Semantic.demandBody(&mut store, &mut request, &id, b"boundBlocks")
  // A written lifetime argument fixes its binder, so only the local loan could meet it: the call refuses
  // it there. Unwritten binders are fresh per call, so a bound between them holds at the local's region.
  run Testing.expect(rejectsSpan(&written, RejectionCode.UnsatisfiedLifetimeBound, text, "&r5", 0)
      && hasBorrowStatus(&boundBlocks, BodyBorrowStatus.Checked),
    "a written lifetime argument refuses a local loan offered to it, while fresh call binders related by a bound both shorten to the local")
  let impliedBound = run Semantic.demandBody(&mut store, &mut request, &id, b"impliedBound")
  let placeBorrow = run Semantic.demandBody(&mut store, &mut request, &id, b"placeBorrow")
  run Testing.expect(rejectsSpan(&impliedBound, RejectionCode.UnsatisfiedLifetimeBound, text, "&r10", 0),
    "a binder that is the longer side of a nominal's implied bound never shortens (SEM0212)")
  run Testing.expect(hasBorrowStatus(&placeBorrow, BodyBorrowStatus.Checked),
    "a borrow of a parameter's place lives as long as its referent, so the binder keeps the caller's lifetime")
  let sharedBinders = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedBinders")
  let distinctBinders = run Semantic.demandBody(&mut store, &mut request, &id, b"distinctBinders")
  let sharedDuo = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedDuo")
  let sharedStored = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedStored")
  let sharedDuoB = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedDuoB")
  let sharedDuoRead = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedDuoRead")
  run Testing.expect(hasBorrowStatus(&sharedBinders, BodyBorrowStatus.Checked) && hasBorrowStatus(&sharedDuo, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&sharedStored, BodyBorrowStatus.Checked) && hasBorrowStatus(&distinctBinders, BodyBorrowStatus.Checked),
    "a binder the operand's parameter alone names shortens, though another binder holds the same region")
  run Testing.expect(rejectsSpan(&sharedDuoB, RejectionCode.UnsatisfiedLifetimeBound, text, "&s5", 0)
      && rejectsSpan(&sharedDuoRead, RejectionCode.UnsatisfiedLifetimeBound, text, "&s6", 0),
    "the field that holds the shortened binder cannot carry the local out: the borrow must outlive the caller's lifetime (SEM0212), as rustc reports a local held before it is returned")
  let impliedRef = run Semantic.demandBody(&mut store, &mut request, &id, b"impliedRef")
  let impliedRefCount = run Semantic.demandBody(&mut store, &mut request, &id, b"impliedRefCount")
  let impliedPocket = run Semantic.demandBody(&mut store, &mut request, &id, b"impliedPocket")
  let impliedSlice = run Semantic.demandBody(&mut store, &mut request, &id, b"impliedSlice")
  run Testing.expect(rejectsSpan(&impliedRef, RejectionCode.UnsatisfiedLifetimeBound, text, "&i1", 0)
      && rejectsSpan(&impliedRefCount, RejectionCode.UnsatisfiedLifetimeBound, text, "&i2", 0)
      && rejectsSpan(&impliedPocket, RejectionCode.UnsatisfiedLifetimeBound, text, "&i3", 0)
      && rejectsSpan(&impliedSlice, RejectionCode.UnsatisfiedLifetimeBound, text, "&i4", 0),
    "a binder on the longer side of a bound a parameter type implies never shortens, so the local borrow must outlive the caller's lifetime (SEM0212)")
  return ()
}

test effect fn carriedLoansAreKeptWhereTheyLie() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run keptSlotClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// A reborrow a callback's argument carries into a quantified contract lies in the slot whose region
// typing shortened it to, never in a universal slot it cannot hold. Where the contract's own bounds
// or a stored field's bound tie that slot to an enclosing universal, the reborrow is refused.
effect fn keptSlotClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("kept-slots.silk")
  let text = """
struct Token { value: i32 }
struct Chan<'t> {
  count: i32,
  view: &'t Token,
}
struct Lease<'c, 't> { channel: &'c mut Chan<'t> }
struct Sock<'c, 't> { channel: &'c mut Chan<'t> }
struct Anchored<'c: 'e, 't, 'e> {
  channel: &'c mut Chan<'t>,
  anchor: &'e Token,
}
struct Pinned<'c, 't> {
  channel: &'c mut Chan<'t>,
  pinned: &'t Token,
}
struct Mixed<'c, 't> {
  seen: &'c Chan<'t>,
  spare: &'t mut Chan<'t>,
}
fn lent<'cb, 'c, 't: 'c>(channel: &'c mut Chan<'t>, use: for<'call, 'cv: 'call, 'tv: 'cv> once fn<'cb>(&'call mut Sock<'cv, 'tv>) -> i32) -> i32 {
  let mut lease = Lease<'c, 't> { channel: move channel }
  let mut useLease = fn(owned: &mut Lease<'c, 't>) -> i32 {
    let inner = &mut owned.channel.*
    let mut socket = Sock { channel: move inner }
    return use(&mut socket)
  }
  return useLease(&mut lease)
}
fn mixed<'cb, 'c, 't: 'c>(channel: &'c mut Chan<'t>, spare: &'t mut Chan<'t>, use: for<'call, 'cv: 'call, 'tv: 'cv> once fn<'cb>(&'call mut Mixed<'cv, 'tv>) -> i32) -> i32 {
  let mut lease = Lease<'c, 't> { channel: move channel }
  let mut useLease = fn(owned: &mut Lease<'c, 't>) -> i32 {
    let seen = &owned.channel.*
    let mut both = Mixed { seen: seen, spare: move spare }
    return use(&mut both)
  }
  return useLease(&mut lease)
}
fn viewed<'cb, 'c, 't: 'c>(channel: &'c mut Chan<'t>, use: for<'call, 'cv: 'call, 'tv: 'cv> once fn<'cb>(&'call mut Sock<'cv, 'tv>) -> &'cv Token) -> i32 {
  let mut lease = Lease<'c, 't> { channel: move channel }
  let mut useLease = fn(owned: &mut Lease<'c, 't>) -> i32 {
    let inner = &mut owned.channel.*
    let mut socket = Sock { channel: move inner }
    return use(&mut socket).value
  }
  return useLease(&mut lease)
}
fn environment<'cb, 'c, 't: 'c>(channel: &'c mut Chan<'t>, use: for<'call, 'cv: 'call + 'cb, 'tv: 'cv> once fn<'cb>(&'call mut Sock<'cv, 'tv>) -> i32) -> i32 {
  let mut lease = Lease<'c, 't> { channel: move channel }
  let mut useLease = fn(owned: &mut Lease<'c, 't>) -> i32 {
    let inner = &mut owned.channel.*
    let mut socket = Sock { channel: move inner }
    return use(&mut socket)
  }
  return useLease(&mut lease)
}
fn anchored<'cb, 'c, 't: 'c>(channel: &'c mut Chan<'t>, anchor: &'cb Token, use: for<'call, 'cv: 'call, 'tv: 'cv> once fn<'cb>(&'call mut Anchored<'cv, 'tv, 'cb>) -> i32) -> i32 {
  let mut lease = Lease<'c, 't> { channel: move channel }
  let mut useLease = fn(owned: &mut Lease<'c, 't>) -> i32 {
    let inner = &mut owned.channel.*
    let mut socket = Anchored { channel: move inner, anchor: anchor }
    return use(&mut socket)
  }
  return useLease(&mut lease)
}
fn returned<'cb, 'c, 't: 'c>(channel: &'c mut Chan<'t>, use: for<'call, 'cv: 'call, 'tv: 'cv> once fn<'cb>(&'call mut Sock<'cv, 'tv>) -> &'cv Token) -> i32 {
  let mut lease = Lease<'c, 't> { channel: move channel }
  let mut useLease = fn(owned: &mut Lease<'c, 't>) -> &'c Token {
    let inner = &mut owned.channel.*
    let mut socket = Sock { channel: move inner }
    return use(&mut socket)
  }
  return useLease(&mut lease).value
}
fn pinned<'cb, 'c, 't: 'c>(channel: &'c mut Chan<'t>, use: for<'call, 'cv: 'call, 'tv: 'cv> once fn<'cb>(&'call mut Pinned<'cv, 'tv>) -> i32) -> i32 {
  let mut lease = Lease<'c, 't> { channel: move channel }
  let mut useLease = fn(owned: &mut Lease<'c, 't>) -> i32 {
    let inner = &mut owned.channel.*
    let token = Token { value: 2 }
    let mut socket = Pinned { channel: move inner, pinned: &token }
    return use(&mut socket)
  }
  return useLease(&mut lease)
}
struct Duplex<'t, P> {
  transport: &'t mut P,
  count: i32,
}
struct GenericLease<'c, 't, P> { channel: &'c mut Duplex<'t, P> }
struct GenericSock<'c, 't, P> { channel: &'c mut Duplex<'t, P> }
struct Pair<'c, 't, P> {
  near: &'c mut P,
  far: &'t mut P,
}
fn generic<'cb, 'c, 't: 'c, P>(channel: &'c mut Duplex<'t, P>, use: for<'call, 'cv: 'call, 'tv: 'cv> once fn<'cb>(&'call mut GenericSock<'cv, 'tv, P>) -> i32) -> i32 {
  let mut lease = GenericLease<'c, 't, P> { channel: move channel }
  let mut useLease = fn(owned: &mut GenericLease<'c, 't, P>) -> i32 {
    let inner = &mut owned.channel.*
    let mut socket = GenericSock { channel: move inner }
    return use(&mut socket)
  }
  return useLease(&mut lease)
}
fn paired<'cb, 'c, 't: 'c, P>(channel: &'c mut Duplex<'t, P>, spare: &'t mut P, use: for<'call, 'cv: 'call, 'tv: 'cv> once fn<'cb>(&'call mut Pair<'cv, 'tv, P>) -> i32) -> i32 {
  let mut lease = GenericLease<'c, 't, P> { channel: move channel }
  let mut useLease = fn(owned: &mut GenericLease<'c, 't, P>) -> i32 {
    let near = &mut owned.channel.transport.*
    let mut pair = Pair { near: move near, far: move spare }
    return use(&mut pair)
  }
  return useLease(&mut lease)
}
struct Cell {
  count: i32,
  tok: Token,
}
struct Two<'a, 'b> {
  c: &'a Cell,
  t: &'b Token,
}
struct Bare<'a, 'b> {
  c: &'a i32,
  t: &'b Token,
}
struct TwoMut<'a, 'b> {
  c: &'a mut Cell,
  t: &'b mut Token,
}
struct Shelf<'s> { held: &'s Token }
struct ShelfMut<'s> { held: &'s mut Token }
fn put<'a, 's>(shelf: &mut Shelf<'s>, two: Two<'a, 's>) -> () { shelf.held = two.t  return () }
fn putBare<'a, 's>(shelf: &mut Shelf<'s>, two: Bare<'a, 's>) -> () { shelf.held = two.t  return () }
fn putMut<'a, 's>(shelf: &mut ShelfMut<'s>, two: TwoMut<'a, 's>) -> () { let TwoMut {c: other, t: taken} = move two  drop other  shelf.held = move taken  return () }
fn tokOf<'x>(cell: &'x Cell) -> &'x Token { return &cell.tok }
fn projected<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, c: &Cell) -> i32 {
  let mut two = Two { c: c, t: k }
  let r = &cell.*
  two.t = &r.*.tok
  put(&mut shelf.*, move two)
  cell.tok.value = 9
  return shelf.held.value
}
fn projectedInline<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, c: &Cell) -> i32 {
  let mut two = Two { c: c, t: k }
  two.t = &(&cell.*).*.tok
  put(&mut shelf.*, move two)
  cell.tok.value = 9
  return shelf.held.value
}
fn projectedExclusive<'u>(cell: &'u mut Cell, shelf: &mut ShelfMut<'u>, k: &'u mut Token, c: &mut Cell) -> i32 {
  let mut two = TwoMut { c: move c, t: move k }
  two.t = &mut (&mut cell.*).*.tok
  putMut(&mut shelf.*, move two)
  cell.tok.value = 9
  return shelf.held.value
}
fn projectedResult<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, c: &Cell) -> i32 {
  let mut two = Two { c: c, t: k }
  let r = &cell.*
  two.t = tokOf(r)
  put(&mut shelf.*, move two)
  cell.tok.value = 9
  return shelf.held.value
}
fn undecoyed<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, c: &i32) -> i32 {
  let mut two = Bare { c: c, t: k }
  let r = &cell.*
  two.t = &r.*.tok
  putBare(&mut shelf.*, move two)
  cell.tok.value = 9
  return shelf.held.value
}
service Keeper<'k> { effect fn put(c: &'k Cell) -> () ? &mut Keeper<'k> }
service Maker<'k, T> { effect fn make(c: &'k Cell) -> T ? &mut Maker<'k, T> }
effect fn keep<'a, 'b>(two: Two<'a, 'b>) -> () ? &mut Keeper<'a> { run Keeper<'a>.put(two.c)  return () }
effect fn made<'w, 'a, 'b, T>(req: &'w mut T, two: Two<'a, 'b>) -> () ? &mut Maker<'a, T> { req.* = run Maker<'a, T>.make(two.c)  return () }
effect fn servedView<'u>(cell: &'u mut Cell, k: &'u Token, other: &'u Cell) -> i32 ? &mut Keeper<'u> {
  let mut two = Two { c: other, t: k }
  let r = &cell.*
  two.c = r
  run keep(move two)
  cell.tok.value = 9
  return 0
}
effect fn servedInto<'u>(cell: &'u mut Cell, out: &mut &'u Cell, k: &'u Token, other: &'u Cell) -> i32 ? &mut Maker<'u, &'u Cell> {
  let mut two = Two { c: other, t: k }
  let r = &cell.*
  two.c = r
  run made(&mut out.*, move two)
  cell.tok.value = 9
  return 0
}
effect fn servedMoved<'u>(cell: &'u mut Cell, out: &mut &'u Cell, k: &'u Token, other: &'u Cell) -> i32 ? &mut Maker<'u, &'u Cell> {
  let mut two = Two { c: other, t: k }
  let r = &cell.*
  two.c = r
  run made(move out, move two)
  cell.tok.value = 9
  return 0
}
fn projectedValid<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, c: &Cell) -> i32 {
  let mut two = Two { c: c, t: k }
  let r = &cell.*
  two.t = &r.*.tok
  put(&mut shelf.*, move two)
  return shelf.held.value
}
fn projectedInlineValid<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, c: &Cell) -> i32 {
  let mut two = Two { c: c, t: k }
  two.t = &(&cell.*).*.tok
  put(&mut shelf.*, move two)
  return shelf.held.value
}
fn projectedExclusiveValid<'u>(cell: &'u mut Cell, shelf: &mut ShelfMut<'u>, k: &'u mut Token, c: &mut Cell) -> i32 {
  let mut two = TwoMut { c: move c, t: move k }
  two.t = &mut (&mut cell.*).*.tok
  putMut(&mut shelf.*, move two)
  return shelf.held.value
}
fn projectedResultValid<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, c: &Cell) -> i32 {
  let mut two = Two { c: c, t: k }
  let r = &cell.*
  two.t = tokOf(r)
  put(&mut shelf.*, move two)
  return shelf.held.value
}
fn undecoyedValid<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, c: &i32) -> i32 {
  let mut two = Bare { c: c, t: k }
  let r = &cell.*
  two.t = &r.*.tok
  putBare(&mut shelf.*, move two)
  return shelf.held.value
}
effect fn servedViewValid<'u>(cell: &'u mut Cell, k: &'u Token, other: &'u Cell) -> i32 ? &mut Keeper<'u> {
  let mut two = Two { c: other, t: k }
  let r = &cell.*
  two.c = r
  run keep(move two)
  return 0
}
effect fn servedIntoValid<'u>(cell: &'u mut Cell, out: &mut &'u Cell, k: &'u Token, other: &'u Cell) -> i32 ? &mut Maker<'u, &'u Cell> {
  let mut two = Two { c: other, t: k }
  let r = &cell.*
  two.c = r
  run made(&mut out.*, move two)
  return 0
}
effect fn servedMovedValid<'u>(cell: &'u mut Cell, out: &mut &'u Cell, k: &'u Token, other: &'u Cell) -> i32 ? &mut Maker<'u, &'u Cell> {
  let mut two = Two { c: other, t: k }
  let r = &cell.*
  two.c = r
  run made(move out, move two)
  return 0
}
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut store = makeSemantic(move revision)
  let mut request = Request.make()
  let lent = run Semantic.demandBody(&mut store, &mut request, &id, b"lent")
  let viewed = run Semantic.demandBody(&mut store, &mut request, &id, b"viewed")
  run Testing.expect(hasBorrowStatus(&lent, BodyBorrowStatus.Checked) && hasBorrowStatus(&viewed, BodyBorrowStatus.Checked),
    "a reborrow typed at the closure's invocation lies only in the slot it was shortened to, which keeps it locally")
  let mixed = run Semantic.demandBody(&mut store, &mut request, &id, b"mixed")
  run Testing.expect(hasBorrowStatus(&mixed, BodyBorrowStatus.Checked),
    "a shared loan never lies in an exclusive view, which no coercion makes of it")
  let environment = run Semantic.demandBody(&mut store, &mut request, &id, b"environment")
  let anchored = run Semantic.demandBody(&mut store, &mut request, &id, b"anchored")
  let returned = run Semantic.demandBody(&mut store, &mut request, &id, b"returned")
  // The contract's bounds and a stored field's bound are the callee's premises: without them the
  // loan would be judged local here and left to region inference.
  run Testing.expect(rejectsSpan(&environment, RejectionCode.UnsatisfiedLifetimeBound, text, "use(&mut socket)", 2)
      && rejectsSpan(&anchored, RejectionCode.UnsatisfiedLifetimeBound, text, "use(&mut socket)", 3),
    "a reborrow through the closure's own parameter cannot fill a slot the contract's bound or a stored field's bound ties to an enclosing universal (SEM0212)")
  run Testing.expect(rejectsSpan(&returned, RejectionCode.UnsatisfiedLifetimeBound, text, "use(&mut socket)", 4),
    "a callback result in the reborrow's region cannot be returned in the enclosing parameter's longer region (SEM0212)")
  let pinned = run Semantic.demandBody(&mut store, &mut request, &id, b"pinned")
  run Testing.expect(rejectsWith(&pinned, RejectionCode.StructFieldTypeMismatch),
    "a body local cannot be stored in the slot the caller's region fixes")
  let generic = run Semantic.demandBody(&mut store, &mut request, &id, b"generic")
  let paired = run Semantic.demandBody(&mut store, &mut request, &id, b"paired")
  run Testing.expect(anonymousStatus(&generic, BodyBorrowStatus.Checked) && anonymousStatus(&paired, BodyBorrowStatus.Checked),
    "a type parameter's slot may hold a loan of the parameter itself, and a reborrow of its value fits a slot the callback bounds by it")
  let projected = run Semantic.demandBody(&mut store, &mut request, &id, b"projected")
  let projectedInline = run Semantic.demandBody(&mut store, &mut request, &id, b"projectedInline")
  let projectedExclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"projectedExclusive")
  let projectedResult = run Semantic.demandBody(&mut store, &mut request, &id, b"projectedResult")
  let undecoyed = run Semantic.demandBody(&mut store, &mut request, &id, b"undecoyed")
  run Testing.expect(rejectsSpan(&projected, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 0),
    "projected retains the actual source through its selected caller slot (OWN0011)")
  run Testing.expect(rejectsSpan(&projectedInline, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 1),
    "projectedInline retains the actual source through its selected caller slot (OWN0011)")
  run Testing.expect(rejectsSpan(&projectedExclusive, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 2),
    "projectedExclusive retains the actual source through its selected caller slot (OWN0011)")
  run Testing.expect(rejectsSpan(&projectedResult, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 3),
    "projectedResult retains the actual source through its selected caller slot (OWN0011)")
  run Testing.expect(rejectsSpan(&undecoyed, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 4),
    "undecoyed retains the actual source through its selected caller slot (OWN0011)")
  let servedView = run Semantic.demandBody(&mut store, &mut request, &id, b"servedView")
  let servedInto = run Semantic.demandBody(&mut store, &mut request, &id, b"servedInto")
  let servedMoved = run Semantic.demandBody(&mut store, &mut request, &id, b"servedMoved")
  run Testing.expect(rejectsSpan(&servedView, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 5),
    "servedView retains the actual source through its selected caller slot (OWN0011)")
  run Testing.expect(rejectsSpan(&servedInto, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 6),
    "servedInto retains the actual source through its selected caller slot (OWN0011)")
  run Testing.expect(rejectsSpan(&servedMoved, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 7),
    "servedMoved retains the actual source through its selected caller slot (OWN0011)")
  let projectedValid = run Semantic.demandBody(&mut store, &mut request, &id, b"projectedValid")
  run Testing.expect(hasBorrowStatus(&projectedValid, BodyBorrowStatus.Checked),
    "projected: retaining the same source without the conflicting write is Checked")
  let projectedInlineValid = run Semantic.demandBody(&mut store, &mut request, &id, b"projectedInlineValid")
  run Testing.expect(hasBorrowStatus(&projectedInlineValid, BodyBorrowStatus.Checked),
    "projectedInline: retaining the same source without the conflicting write is Checked")
  let projectedExclusiveValid = run Semantic.demandBody(&mut store, &mut request, &id, b"projectedExclusiveValid")
  run Testing.expect(hasBorrowStatus(&projectedExclusiveValid, BodyBorrowStatus.Checked),
    "projectedExclusive: retaining the same source without the conflicting write is Checked")
  let projectedResultValid = run Semantic.demandBody(&mut store, &mut request, &id, b"projectedResultValid")
  run Testing.expect(hasBorrowStatus(&projectedResultValid, BodyBorrowStatus.Checked),
    "projectedResult: retaining the same source without the conflicting write is Checked")
  let undecoyedValid = run Semantic.demandBody(&mut store, &mut request, &id, b"undecoyedValid")
  run Testing.expect(hasBorrowStatus(&undecoyedValid, BodyBorrowStatus.Checked),
    "undecoyed: retaining the same source without the conflicting write is Checked")
  let servedViewValid = run Semantic.demandBody(&mut store, &mut request, &id, b"servedViewValid")
  run Testing.expect(hasBorrowStatus(&servedViewValid, BodyBorrowStatus.Checked),
    "servedView: retaining the same source without the conflicting write is Checked")
  let servedIntoValid = run Semantic.demandBody(&mut store, &mut request, &id, b"servedIntoValid")
  run Testing.expect(hasBorrowStatus(&servedIntoValid, BodyBorrowStatus.Checked),
    "servedInto: retaining the same source without the conflicting write is Checked")
  let servedMovedValid = run Semantic.demandBody(&mut store, &mut request, &id, b"servedMovedValid")
  run Testing.expect(hasBorrowStatus(&servedMovedValid, BodyBorrowStatus.Checked),
    "servedMoved: retaining the same source without the conflicting write is Checked")
  return ()
}

// A written environment permits either input to supply its result; each real owner stays borrowed.
test effect fn finiteSourcesWrittenEnvironment() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run retainedResultWrittenEnvironmentClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn retainedResultWrittenEnvironmentClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("retained-result-WrittenEnvironment.silk")
  let text = """
struct EnvCfg { v: i32 }
struct EnvRoute<'c> { cfg: &'c EnvCfg }
union Maybe<T> { None, Some { value: T } }
fn envSelect<'c>(cfg: &'c EnvCfg) -> EnvRoute<'c> { return EnvRoute {cfg: cfg} }
effect<'env> fn two<'c, 'd, 'env>(a: EnvRoute<'c>, b: EnvRoute<'d>) -> &'env i32 { return &b.cfg.v }
effect<'env> fn un<'c, 'd, 'env>(a: EnvRoute<'c>, b: Maybe<EnvRoute<'d>>) -> &'env i32 { return &a.cfg.v }
fn q01() -> i32 {
  let config = EnvCfg {v: 3}
  let mut config2 = EnvCfg {v: 4}
  let r2 = &config2
  let a = envSelect(&config)
  let b = envSelect(&r2.*)
  let r = run two(move a, move b)
  config2.v = 9
  return r.*
}
fn q02() -> i32 {
  let config = EnvCfg {v: 3}
  let configMove = EnvCfg {v: 4}
  let r2 = &configMove
  let a = envSelect(&config)
  let b = envSelect(&r2.*)
  let r = run two(move a, move b)
  let gone = move configMove
  drop gone
  return r.*
}
fn q03() -> i32 {
  let config = EnvCfg {v: 3}
  let mut config2 = EnvCfg {v: 4}
  let a = envSelect(&config)
  let b = envSelect(&config2)
  let r = run two(move a, move b)
  config2.v = 9
  return r.*
}
fn q05() -> i32 {
  let config = EnvCfg {v: 3}
  let mut config2 = EnvCfg {v: 4}
  let a = envSelect(&config2)
  let b = Maybe<EnvRoute>.Some {value: envSelect(&config)}
  let r = run un(move a, move b)
  config2.v = 9
  return r.*
}
fn q01v() -> i32 {
  let config = EnvCfg {v: 3}
  let mut config2 = EnvCfg {v: 4}
  let r2 = &config2
  let a = envSelect(&config)
  let b = envSelect(&r2.*)
  let r = run two(move a, move b)
  return r.*
}
fn q03v() -> i32 {
  let config = EnvCfg {v: 3}
  let mut config2 = EnvCfg {v: 4}
  let a = envSelect(&config)
  let b = envSelect(&config2)
  let r = run two(move a, move b)
  return r.*
}
fn q05v() -> i32 {
  let config = EnvCfg {v: 3}
  let config2 = EnvCfg {v: 4}
  let a = envSelect(&config2)
  let b = Maybe<EnvRoute>.Some {value: envSelect(&config)}
  let r = run un(move a, move b)
  return r.*
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let q01 = run Semantic.demandBody(&mut store, &mut request, &id, b"q01")
  run Testing.expect(rejectsSpan(&q01, RejectionCode.AccessDuringLoan, text, "config2.v", 0),
    "a reborrowed second input stays borrowed across run")
  let q02 = run Semantic.demandBody(&mut store, &mut request, &id, b"q02")
  run Testing.expect(rejectsSpan(&q02, RejectionCode.AccessDuringLoan, text, "configMove", 2),
    "moving a retained reborrow ancestor conflicts")
  let q03 = run Semantic.demandBody(&mut store, &mut request, &id, b"q03")
  run Testing.expect(rejectsSpan(&q03, RejectionCode.AccessDuringLoan, text, "config2.v", 1),
    "an owned second input stays borrowed across run")
  let q05 = run Semantic.demandBody(&mut store, &mut request, &id, b"q05")
  run Testing.expect(rejectsSpan(&q05, RejectionCode.AccessDuringLoan, text, "config2.v", 2),
    "a union second input cannot hide the retained first input")
  let q01v = run Semantic.demandBody(&mut store, &mut request, &id, b"q01v")
  run Testing.expect(hasBorrowStatus(&q01v, BodyBorrowStatus.Checked),
    "the reborrowed input remains Checked without a conflict")
  let q03v = run Semantic.demandBody(&mut store, &mut request, &id, b"q03v")
  run Testing.expect(hasBorrowStatus(&q03v, BodyBorrowStatus.Checked),
    "both owned inputs remain Checked without a conflict")
  let q05v = run Semantic.demandBody(&mut store, &mut request, &id, b"q05v")
  run Testing.expect(hasBorrowStatus(&q05v, BodyBorrowStatus.Checked),
    "the union-input twin remains Checked with no conflicting source write")
  return ()
}

// Impl bounds preserve the source loan without extending assignment-temporary storage.
test effect fn finiteSourcesImplBoundTemporary() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run retainedResultImplBoundTemporaryClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn retainedResultImplBoundTemporaryClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("retained-result-ImplBoundTemporary.silk")
  let text = """
struct Res {
  value: i32,
}

impl Intrinsic.Drop for Res {
  fn drop(self: &mut Res) -> () {
    return ()
  }
}

fn make(value: i32) -> Res {
  return Res { value: value }
}

fn read(res: &[Res]) -> i32 {
  return res[0].value
}

struct Pick<'a, 'b> {
  long: &'a [Res],
  short: &'b [Res],
}

// The impl bound lets `pick` return its first argument at the second argument's region.
impl<'a: 'b, 'b> Pick<'a, 'b> {
  fn pick(first: &'a [Res], second: &'b [Res]) -> &'b [Res] {
    return first
  }
}

fn expired() -> i32 {
  let kept = [make(5)]
  let mut view: &[Res] = &kept
  // The temporary array ends with this statement while `view` still refers to it.
  view = Pick.pick(&[make(4)], &kept)
  return read(view) - 4
}
fn valid() -> i32 {
  let kept = [make(5)]
  let mut view: &[Res] = &kept
  view = Pick.pick(&kept, &kept)
  return read(view) - 5
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let expired = run Semantic.demandBody(&mut store, &mut request, &id, b"expired")
  run Testing.expect(rejectsSpan(&expired, RejectionCode.ExpiredLifetime, text, "view", 3),
    "an assignment temporary expires at the later read, before MIR verification")
  let valid = run Semantic.demandBody(&mut store, &mut request, &id, b"valid")
  run Testing.expect(hasBorrowStatus(&valid, BodyBorrowStatus.Checked),
    "the no-temporary impl-bound twin is fully Checked")
  return ()
}

// Declared output fields keep distinct sources even after inference coalesces their region arguments.
test effect fn finiteSourcesProjectedField() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run retainedResultProjectedFieldClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn retainedResultProjectedFieldClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("retained-result-ProjectedField.silk")
  let text = """
struct Duo<'a, 'b> { a: &'a i32, b: &'b i32 }
fn splitDuo<'x, 'y>(p: &'x i32, q: &'y i32, l: &'y i32) -> Duo<'x, 'y> { return Duo {a: p, b: l} }
fn choose<'x>(p: &'x i32, q: &'x i32) -> &'x i32 { return q }
fn esc(c: bool) -> i32 {
  let o = 3
  let mut keep = &o
  if c {
    let s = 5
    let t = splitDuo(&o, &o, &s)
    keep = t.b
  }
  return keep.*
}
fn sibling(c: bool) -> i32 {
  let o = 3
  let mut keep = &o
  if c {
    let s = 5
    let t = splitDuo(&o, &o, &s)
    keep = t.a
  }
  return keep.*
}
fn localUse() -> i32 {
  let o = 3
  let s = 5
  let t = splitDuo(&o, &o, &s)
  return t.b.*
}
fn outerOwner(c: bool) -> i32 {
  let o = 3
  let s = 5
  let mut keep = &o
  if c {
    let t = splitDuo(&o, &o, &s)
    keep = t.b
  }
  return keep.*
}
fn literal(c: bool) -> i32 {
  let o = 3
  let mut keep = &o
  if c {
    let s = 5
    let t = Duo {a: &o, b: &s}
    keep = t.b
  }
  return keep.*
}
fn scalar(c: bool) -> i32 {
  let o = 3
  let mut keep = &o
  if c {
    let s = 5
    keep = choose(&o, &s)
  }
  return keep.*
}
fn directEsc(c: bool) -> i32 {
  let o = 3
  let mut keep = &o
  if c {
    let s = 5
    keep = splitDuo(&o, &o, &s).b
  }
  return keep.*
}
fn directSibling(c: bool) -> i32 {
  let o = 3
  let mut keep = &o
  if c {
    let s = 5
    keep = splitDuo(&o, &o, &s).a
  }
  return keep.*
}
effect fn splitEffect<'x, 'y>(p: &'x i32, q: &'y i32, l: &'y i32) -> Duo<'x, 'y> {
  return Duo {a: p, b: l}
}
fn runEsc(c: bool) -> i32 {
  let o = 3
  let mut keep = &o
  if c {
    let s = 5
    let t = run splitEffect(&o, &o, &s)
    keep = t.b
  }
  return keep.*
}
fn runSibling(c: bool) -> i32 {
  let o = 3
  let mut keep = &o
  if c {
    let s = 5
    let t = run splitEffect(&o, &o, &s)
    keep = t.a
  }
  return keep.*
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let esc = run Semantic.demandBody(&mut store, &mut request, &id, b"esc")
  run Testing.expect(rejectsSpan(&esc, RejectionCode.ExpiredLifetime, text, "keep.*", 0),
    "a branch-local source cannot escape through a call result field")
  let sibling = run Semantic.demandBody(&mut store, &mut request, &id, b"sibling")
  run Testing.expect(hasBorrowStatus(&sibling, BodyBorrowStatus.Checked),
    "the unrelated projected sibling keeps only its outer source")
  let localUse = run Semantic.demandBody(&mut store, &mut request, &id, b"localUse")
  run Testing.expect(hasBorrowStatus(&localUse, BodyBorrowStatus.Checked),
    "using the selected field inside its source scope is Checked")
  let outerOwner = run Semantic.demandBody(&mut store, &mut request, &id, b"outerOwner")
  run Testing.expect(hasBorrowStatus(&outerOwner, BodyBorrowStatus.Checked),
    "a selected field whose source lives outside the branch is Checked")
  let literal = run Semantic.demandBody(&mut store, &mut request, &id, b"literal")
  run Testing.expect(rejectsSpan(&literal, RejectionCode.ExpiredLifetime, text, "keep.*", 3),
    "an aggregate literal still rejects its escaping source")
  let scalar = run Semantic.demandBody(&mut store, &mut request, &id, b"scalar")
  run Testing.expect(rejectsSpan(&scalar, RejectionCode.ExpiredLifetime, text, "keep.*", 4),
    "a scalar call result still rejects its escaping source")
  let directEsc = run Semantic.demandBody(&mut store, &mut request, &id, b"directEsc")
  let directSibling = run Semantic.demandBody(&mut store, &mut request, &id, b"directSibling")
  run Testing.expect(rejectsSpan(&directEsc, RejectionCode.ExpiredLifetime, text, "keep.*", 5),
    "projecting directly from a call result retains the same local source")
  run Testing.expect(hasBorrowStatus(&directSibling, BodyBorrowStatus.Checked),
    "a direct call-result sibling remains independent after inferred regions coalesce")
  let runEsc = run Semantic.demandBody(&mut store, &mut request, &id, b"runEsc")
  let runSibling = run Semantic.demandBody(&mut store, &mut request, &id, b"runSibling")
  run Testing.expect(rejectsSpan(&runEsc, RejectionCode.ExpiredLifetime, text, "keep.*", 7),
    "an immediate Effect result keeps the selected field's local source")
  run Testing.expect(hasBorrowStatus(&runSibling, BodyBorrowStatus.Checked),
    "an immediate Effect result excludes the unrelated sibling source")
  return ()
}

// An unknown generic referent does not erase the caller's authenticated outer reference loan.
test effect fn finiteSourcesGenericOuterReference() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run genericOuterReferenceClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn genericOuterReferenceClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("generic-outer-reference.silk")
  let text = """
fn choose<'a, T>(left: &'a T, right: &'a T) -> &'a T { return right }
fn bad() -> i32 {
  let left = 1
  let mut right = 2
  let view = choose(&left, &right)
  right = 3
  return view.*
}
fn good() -> i32 {
  let left = 1
  let mut right = 2
  let view = choose(&left, &right)
  return view.*
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let bad = run Semantic.demandBody(&mut store, &mut request, &id, b"bad")
  run Testing.expect(rejectsSpan(&bad, RejectionCode.AccessDuringLoan, text, "right", 4),
    "the generic result retains the exact outer loan at the conflicting mutation (OWN0011)")
  let good = run Semantic.demandBody(&mut store, &mut request, &id, b"good")
  run Testing.expect(hasBorrowStatus(&good, BodyBorrowStatus.Checked),
    "the generic reference call without a conflicting mutation is fully checked")
  return ()
}

// Two result fields under one owned wrapper keep distinct authored source relationships.
test effect fn finiteSourcesNestedResultFields() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run nestedResultFieldClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nestedResultFieldClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("nested-result-fields.silk")
  let text = """
struct Duo<'a, 'b> { a: &'a i32, b: &'b i32 }
struct Nest<'a, 'b> { inside: Duo<'a, 'b> }
fn split<'x, 'y>(p: &'x i32, q: &'y i32, l: &'y i32) -> Duo<'x, 'y> { return Duo {a: p, b: l} }
fn nest<'x, 'y>(p: &'x i32, q: &'y i32, l: &'y i32) -> Nest<'x, 'y> { return Nest {inside: split(p, q, l)} }
effect fn nestEffect<'x, 'y>(p: &'x i32, q: &'y i32, l: &'y i32) -> Nest<'x, 'y> { return nest(p, q, l) }
fn nestedEscape(c: bool) -> i32 {
  let o = 3
  let mut keep = &o
  if c {
    let s = 5
    keep = nest(&o, &o, &s).inside.b
  }
  return keep.*
}
fn nestedSibling(c: bool) -> i32 {
  let o = 3
  let mut keep = &o
  if c {
    let s = 5
    keep = nest(&o, &o, &s).inside.a
  }
  return keep.*
}
fn namedEscape(c: bool) -> i32 {
  let o = 3
  let mut keep = &o
  if c {
    let s = 5
    let result = nest(&o, &o, &s)
    keep = result.inside.b
  }
  return keep.*
}
fn namedSibling(c: bool) -> i32 {
  let o = 3
  let mut keep = &o
  if c {
    let s = 5
    let result = nest(&o, &o, &s)
    keep = result.inside.a
  }
  return keep.*
}
fn effectEscape(c: bool) -> i32 {
  let o = 3
  let mut keep = &o
  if c {
    let s = 5
    keep = (run nestEffect(&o, &o, &s)).inside.b
  }
  return keep.*
}
fn effectSibling(c: bool) -> i32 {
  let o = 3
  let mut keep = &o
  if c {
    let s = 5
    keep = (run nestEffect(&o, &o, &s)).inside.a
  }
  return keep.*
}
fn choose<'a, T>(left: &'a T, right: &'a T) -> &'a T { return right }
fn genericInner() -> i32 {
  let left = 1
  let mut right = 2
  let l = Duo {a: &left, b: &left}
  let r = Duo {a: &left, b: &right}
  let view = choose(&l, &r)
  right = 3
  return view.b.*
}
fn referenceBoundary(c: bool) -> i32 {
  let o = 3
  let mut keep = &o
  if c {
    let s = 5
    let pair = Duo {a: &o, b: &s}
    let outer = choose(&pair, &pair)
    keep = outer.b
  }
  return keep.*
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let nestedEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedEscape")
  let nestedSibling = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedSibling")
  run Testing.expect(rejectsSpan(&nestedEscape, RejectionCode.ExpiredLifetime, text, "keep.*", 0),
    "a direct nested result projection retains its actual local source (OWN0019)")
  run Testing.expect(hasBorrowStatus(&nestedSibling, BodyBorrowStatus.Checked),
    "a nested sibling excludes the unrelated source after authored binders coalesce")
  let namedEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"namedEscape")
  let namedSibling = run Semantic.demandBody(&mut store, &mut request, &id, b"namedSibling")
  run Testing.expect(rejectsSpan(&namedEscape, RejectionCode.ExpiredLifetime, text, "keep.*", 2),
    "a named result preserves the complete source field path (OWN0019)")
  run Testing.expect(hasBorrowStatus(&namedSibling, BodyBorrowStatus.Checked),
    "a named nested sibling keeps only its own source")
  let effectEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"effectEscape")
  let effectSibling = run Semantic.demandBody(&mut store, &mut request, &id, b"effectSibling")
  run Testing.expect(rejectsSpan(&effectEscape, RejectionCode.ExpiredLifetime, text, "keep.*", 4),
    "an immediate Effect result retains the selected nested source (OWN0019)")
  run Testing.expect(hasBorrowStatus(&effectSibling, BodyBorrowStatus.Checked),
    "successive projections from an immediate run preserve nested sibling separation")
  let genericInner = run Semantic.demandBody(&mut store, &mut request, &id, b"genericInner")
  let referenceBoundary = run Semantic.demandBody(&mut store, &mut request, &id, b"referenceBoundary")
  run Testing.expect(rejectsSpan(&genericInner, RejectionCode.AccessDuringLoan, text, "right", 4),
    "a field of a generic referent read through an outer reference keeps every source the referent's region holds (OWN0011)")
  run Testing.expect(rejectsSpan(&referenceBoundary, RejectionCode.ExpiredLifetime, text, "keep.*", 6),
    "a field read through an outer reference to a local aggregate keeps the aggregate's local source (OWN0019)")
  return ()
}

// A result inferred from local operands keeps their regions through every later
// consumer. A static literal used as covariant evidence is not a static demand.
test effect fn retainedResultsKeepRealStaticDemands() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run retainedStaticDemandClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn retainedStaticDemandClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("retained-static-demands.silk")
  let text = """
fn two<'a: 'b, 'b>(recv: i32, ka: string<'a>, kb: string<'b>, x: &'b i32, y: &'a i32) -> &'a i32 { return y }
effect fn twoE<'a: 'b, 'b>(recv: i32, ka: string<'a>, kb: string<'b>, x: &'b i32, y: &'a i32) -> &'a i32 { return y }
fn sink(r: &'static i32) -> i32 { return r.* }
fn idR<'r>(x: &'r i32) -> &'r i32 { return x }
fn sinkL<'q>(k: string<'q>, r: &'q i32) -> i32 { return r.* }
fn sinkT<T: 'static>(t: T) -> i32 { return 0 }
struct Slot<'k> { r: &'k i32 }
fn p01() -> i32 { let h1 = 5  let h2 = 6  let saved1 = 1 |> two("x", "y", &h1, &h2)  let q: &'static i32 = saved1  return q.* }
fn p03(slot: &'static mut Slot<'static>) -> () { let h3 = 5  let h4 = 6  let saved3 = 1 |> two("x", "y", &h3, &h4)  slot.r = saved3  return () }
fn p04() -> i32 { let h5 = 5  let h6 = 6  return sink(idR(1 |> two("x", "y", &h5, &h6))) }
effect fn p06c() -> i32 { let h7 = 5  let h8 = 6  return sink(run twoE(1, "x", "y", &h7, &h8)) }
fn p20() -> i32 { let h9 = 5  let h10 = 6  return sinkT(1 |> two("x", "y", &h9, &h10)) }
fn alias() -> i32 { let h11 = 5  let h12 = 6  let r = 1 |> two("x", "y", &h11, &h12)  let aliasForStatic = r  return sink(aliasForStatic) }
fn p19() -> i32 { let h13 = 5  let h14 = 6  return sinkL("z", 1 |> two("x", "y", &h13, &h14)) }
fn reduced() -> i32 { let h15 = 5  return sinkL("z", &h15) }
fn localUse() -> i32 { let h16 = 5  let h17 = 6  let r = 1 |> two("x", "y", &h16, &h17)  return r.* }
fn staticOperands(x: &'static i32, y: &'static i32) -> i32 { return sinkT(1 |> two("x", "y", x, y)) }
fn sibling<'p>(x: &'p i32, y: &'p i32) -> &'p i32 { return 1 |> two("x", "y", x, y) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let p01 = run Semantic.demandBody(&mut store, &mut request, &id, b"p01")
  run Testing.expect(rejectsSpan(&p01, RejectionCode.UnsatisfiedLifetimeBound, text, "&h2", 0),
    "p01: a real static consumer rejects the borrow its retained result holds (SEM0212)")
  let p03 = run Semantic.demandBody(&mut store, &mut request, &id, b"p03")
  run Testing.expect(rejectsSpan(&p03, RejectionCode.UnsatisfiedLifetimeBound, text, "&h4", 0),
    "p03: a real static consumer rejects the borrow its retained result holds (SEM0212)")
  let p04 = run Semantic.demandBody(&mut store, &mut request, &id, b"p04")
  run Testing.expect(rejectsSpan(&p04, RejectionCode.UnsatisfiedLifetimeBound, text, "&h6", 0), "p04: a real static consumer rejects retained local storage")
  let p06c = run Semantic.demandBody(&mut store, &mut request, &id, b"p06c")
  run Testing.expect(rejectsSpan(&p06c, RejectionCode.UnsatisfiedLifetimeBound, text, "&h8", 0), "p06c: a real static consumer rejects retained local storage")
  let p20 = run Semantic.demandBody(&mut store, &mut request, &id, b"p20")
  run Testing.expect(rejectsSpan(&p20, RejectionCode.UnsatisfiedLifetimeBound, text, "&h10", 0), "p20: a real static consumer rejects retained local storage")
  let alias = run Semantic.demandBody(&mut store, &mut request, &id, b"alias")
  run Testing.expect(rejectsSpan(&alias, RejectionCode.UnsatisfiedLifetimeBound, text, "&h12", 0), "alias: a real static consumer rejects retained local storage")
  let p19 = run Semantic.demandBody(&mut store, &mut request, &id, b"p19")
  run Testing.expect(hasBorrowStatus(&p19, BodyBorrowStatus.Checked), "p19: covariant evidence and valid contents stay Checked")
  let reduced = run Semantic.demandBody(&mut store, &mut request, &id, b"reduced")
  run Testing.expect(hasBorrowStatus(&reduced, BodyBorrowStatus.Checked), "reduced: covariant evidence and valid contents stay Checked")
  let localUse = run Semantic.demandBody(&mut store, &mut request, &id, b"localUse")
  run Testing.expect(hasBorrowStatus(&localUse, BodyBorrowStatus.Checked), "localUse: covariant evidence and valid contents stay Checked")
  let staticOperands = run Semantic.demandBody(&mut store, &mut request, &id, b"staticOperands")
  run Testing.expect(hasBorrowStatus(&staticOperands, BodyBorrowStatus.Checked), "staticOperands: covariant evidence and valid contents stay Checked")
  let sibling = run Semantic.demandBody(&mut store, &mut request, &id, b"sibling")
  run Testing.expect(hasBorrowStatus(&sibling, BodyBorrowStatus.Checked), "sibling: covariant evidence and valid contents stay Checked")
  return ()
}

// Callable-value dispatch must retain ordinary arguments as well as captured loans.
test effect fn holderTransferCallableOperands() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run holderTransferCallableOperandsClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn holderTransferCallableOperandsClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("holderTransferCallableOperands.silk")
  let text = """
struct Holder { n: i32, m: i32 }
fn make() -> Holder { return Holder {n: 1, m: 2} }
fn spent(h: Holder) -> i32 { return h.n }
struct Slot<'a> { r: &'a Holder }
fn put<'a>(s: &mut Slot<'a>, r: &'a Holder) -> () { s.r = r  return () }
fn bad(st: for<'a> fn(&mut Slot<'a>, &'a Holder) -> ()) -> i32 {
  let other = make()
  let mut s = Slot {r: &other}
  let badOwner = make()
  st(&mut s, &badOwner)
  let n = spent(move badOwner)
  return s.r.n + n
}
fn before(st: for<'a> fn(&mut Slot<'a>, &'a Holder) -> ()) -> i32 {
  let other = make()
  let mut s = Slot {r: &other}
  let h = make()
  st(&mut s, &h)
  let n = s.r.n
  return spent(move h) + n
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let bad = run Semantic.demandBody(&mut store, &mut request, &id, b"bad")
  run Testing.expect(rejectsSpan(&bad, RejectionCode.AccessDuringLoan, text, "badOwner", 2), "a callable value retains the ordinary operand in its writable holder (OWN0011)")
  let before = run Semantic.demandBody(&mut store, &mut request, &id, b"before")
  run Testing.expect(hasBorrowStatus(&before, BodyBorrowStatus.Checked), "the callable operand loan ends after the holder last use")
  return ()
}

// A declared outlives edge permits transfer only to its shorter destination.
test effect fn holderTransferDirectedBounds() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run holderTransferDirectedBoundsClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn holderTransferDirectedBoundsClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("holderTransferDirectedBounds.silk")
  let text = """
struct Holder { n: i32, m: i32 }
fn make() -> Holder { return Holder {n: 1, m: 2} }
fn spent(h: Holder) -> i32 { return h.n }
struct Slot<'a> { r: &'a Holder }
fn put<'a>(s: &mut Slot<'a>, r: &'a Holder) -> () { s.r = r  return () }
fn tie<'a, 'b: 'a>(s: &mut Slot<'a>, r: &'b Holder) -> () { s.r = r  return () }
fn reverse<'a: 'b, 'b>(s: &mut Slot<'a>, r: &'b Holder) -> () { return () }
fn unrelated<'a, 'b, 'c: 'b>(s: &mut Slot<'a>, r: &'c Holder, other: &'b Holder) -> () { return () }
fn bad() -> i32 {
  let other = make()
  let mut s = Slot {r: &other}
  let boundedOwner = make()
  tie(&mut s, &boundedOwner)
  let n = spent(move boundedOwner)
  return s.r.n + n
}
fn before() -> i32 {
  let other = make()
  let mut s = Slot {r: &other}
  let h = make()
  tie(&mut s, &h)
  let n = s.r.n
  return spent(move h) + n
}
fn reversed() -> i32 {
  let other = make()
  let mut s = Slot {r: &other}
  let h = make()
  reverse(&mut s, &h)
  let n = spent(move h)
  return s.r.n + n
}
fn separate() -> i32 {
  let other = make()
  let mut s = Slot {r: &other}
  let h = make()
  unrelated(&mut s, &h, &other)
  let n = spent(move h)
  return s.r.n + n
}
fn oneDestination<'a, 'b>(first: &mut Slot<'a>, second: &mut Slot<'b>, r: &'a Holder) -> () { first.r = r  return () }
fn otherDestination() -> i32 {
  let firstOwner = make()
  let secondOwner = make()
  let h = make()
  let mut first = Slot {r: &firstOwner}
  let mut second = Slot {r: &secondOwner}
  oneDestination(&mut first, &mut second, &h)
  drop first
  let n = spent(move h)
  return second.r.n + n
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let bad = run Semantic.demandBody(&mut store, &mut request, &id, b"bad")
  run Testing.expect(rejectsSpan(&bad, RejectionCode.AccessDuringLoan, text, "boundedOwner", 2), "a longer source is retained in the shorter destination (OWN0011)")
  let before = run Semantic.demandBody(&mut store, &mut request, &id, b"before")
  run Testing.expect(hasBorrowStatus(&before, BodyBorrowStatus.Checked), "a bounded transfer ends at the holder last use")
  let reversed = run Semantic.demandBody(&mut store, &mut request, &id, b"reversed")
  run Testing.expect(hasBorrowStatus(&reversed, BodyBorrowStatus.Checked), "a reverse bound cannot store the shorter source in the longer holder")
  let separate = run Semantic.demandBody(&mut store, &mut request, &id, b"separate")
  run Testing.expect(hasBorrowStatus(&separate, BodyBorrowStatus.Checked), "a bound on another argument does not retain this operand")
  let otherDestination = run Semantic.demandBody(&mut store, &mut request, &id, b"otherDestination")
  run Testing.expect(hasBorrowStatus(&otherDestination, BodyBorrowStatus.Checked), "only the destination named by the source contract retains the loan")
  return ()
}

// Replacing or dropping the source holder cannot end a loan the destination still retains.
test effect fn holderTransferFieldLoans() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run holderTransferFieldLoansClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn holderTransferFieldLoansClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("holderTransferFieldLoans.silk")
  let text = """
struct Holder { n: i32, m: i32 }
fn make() -> Holder { return Holder {n: 1, m: 2} }
fn spent(h: Holder) -> i32 { return h.n }
struct Slot<'a> { r: &'a Holder }
fn put<'a>(s: &mut Slot<'a>, r: &'a Holder) -> () { s.r = r  return () }
fn bad(fb: &i32) -> i32 {
  let o = make()
  let mut x = Slot {r: &o}
  let mut y = Slot {r: &o}
  if fb.* > 0 {
    let h = make()
    put(&mut x, &h)
    put(&mut y, x.r)
    x.r = &o
  }
  return y.r.n
}
fn outer(fb: &i32) -> i32 {
  let o = make()
  let h = make()
  let mut x = Slot {r: &o}
  let mut y = Slot {r: &o}
  if fb.* > 0 {
    put(&mut x, &h)
    put(&mut y, x.r)
    x.r = &o
  }
  return y.r.n
}
fn sourceDropped() -> i32 {
  let o = make()
  let h = make()
  let mut x = Slot {r: &o}
  let mut y = Slot {r: &o}
  put(&mut x, &h)
  put(&mut y, x.r)
  drop x
  return y.r.n
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let bad = run Semantic.demandBody(&mut store, &mut request, &id, b"bad")
  run Testing.expect(rejectsSpan(&bad, RejectionCode.ExpiredLifetime, text, "y.r.n", 0), "overwriting the source field does not release the destination loan (OWN0019)")
  let outer = run Semantic.demandBody(&mut store, &mut request, &id, b"outer")
  run Testing.expect(hasBorrowStatus(&outer, BodyBorrowStatus.Checked), "the transferred referent remains valid outside the branch")
  let sourceDropped = run Semantic.demandBody(&mut store, &mut request, &id, b"sourceDropped")
  run Testing.expect(hasBorrowStatus(&sourceDropped, BodyBorrowStatus.Checked), "dropping the source holder leaves the external referent live")
  return ()
}

// A slice element carries its referent loan independently of the source container.
test effect fn holderTransferSliceLoans() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run holderTransferSliceLoansClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn holderTransferSliceLoansClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("holderTransferSliceLoans.silk")
  let text = """
struct Holder { n: i32, m: i32 }
fn make() -> Holder { return Holder {n: 1, m: 2} }
fn spent(h: Holder) -> i32 { return h.n }
struct Slot<'a> { r: &'a Holder }
fn put<'a>(s: &mut Slot<'a>, r: &'a Holder) -> () { s.r = r  return () }
struct Items<'a> { values: [&'a Holder; 1] }
fn append<'a>(items: &mut Items<'a>, value: &'a Holder) -> () { items.values[0] = value  return () }
fn asSlice<'s, 'a>(items: &'s Items<'a>) -> &'s [&'a Holder] { return &items.values }
fn bad() -> i32 {
  let o = make()
  let mut v = Items {values: [&o]}
  let mut w = Items {values: [&o]}
  let sliceOwner = make()
  append(&mut v, &sliceOwner)
  append(&mut w, asSlice(&v)[0])
  drop v
  drop sliceOwner
  return asSlice(&w)[0].n
}
fn sourceDropped() -> i32 {
  let o = make()
  let mut v = Items {values: [&o]}
  let mut w = Items {values: [&o]}
  let h = make()
  append(&mut v, &h)
  append(&mut w, asSlice(&v)[0])
  drop v
  return asSlice(&w)[0].n
}
fn before() -> i32 {
  let o = make()
  let mut v = Items {values: [&o]}
  let mut w = Items {values: [&o]}
  let h = make()
  append(&mut v, &h)
  append(&mut w, asSlice(&v)[0])
  drop v
  let n = asSlice(&w)[0].n
  drop h
  return n
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let bad = run Semantic.demandBody(&mut store, &mut request, &id, b"bad")
  run Testing.expect(rejectsSpan(&bad, RejectionCode.AccessDuringLoan, text, "drop sliceOwner", 0), "a slice element transfers its referent loan into the destination (OWN0011)")
  let sourceDropped = run Semantic.demandBody(&mut store, &mut request, &id, b"sourceDropped")
  run Testing.expect(hasBorrowStatus(&sourceDropped, BodyBorrowStatus.Checked), "slice element transfer does not retain the source container")
  let before = run Semantic.demandBody(&mut store, &mut request, &id, b"before")
  run Testing.expect(hasBorrowStatus(&before, BodyBorrowStatus.Checked), "a transferred slice element loan ends at its last use")
  return ()
}

// Equal referent types do not identify which source field may reach the destination.
test effect fn holderTransferSameTypeSiblings() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run holderTransferSameTypeSiblingsClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn holderTransferSameTypeSiblingsClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("holderTransferSameTypeSiblings.silk")
  let text = """
struct Holder { n: i32, m: i32 }
fn make() -> Holder { return Holder {n: 1, m: 2} }
fn spent(h: Holder) -> i32 { return h.n }
struct Slot<'a> { r: &'a Holder }
fn put<'a>(s: &mut Slot<'a>, r: &'a Holder) -> () { s.r = r  return () }
struct Pair<'a, 'b> { first: &'a i32, second: &'b i32 }
struct IntSlot<'a> { r: &'a i32 }
fn takeFirst<'a, 'b>(slot: &mut IntSlot<'a>, pair: Pair<'a, 'b>) -> () { slot.r = pair.first  return () }
fn sibling() -> i32 {
  let a = 1
  let mut b = 2
  let zero = 0
  let pair = Pair {first: &a, second: &b}
  let mut slot = IntSlot {r: &zero}
  takeFirst(&mut slot, move pair)
  b = 3
  return slot.r.* + b
}
fn selected() -> i32 {
  let mut selectedOwner = 1
  let b = 2
  let zero = 0
  let pair = Pair {first: &selectedOwner, second: &b}
  let mut slot = IntSlot {r: &zero}
  takeFirst(&mut slot, move pair)
  selectedOwner = 3
  return slot.r.* + b
}
fn projectedSibling() -> i32 {
  let a = 1
  let mut b = 2
  let zero = 0
  let pair = Pair {first: &a, second: &b}
  let mut slot = IntSlot {r: &zero}
  putInt(&mut slot, pair.first)
  b = 3
  return slot.r.* + b
}
fn putInt<'a>(slot: &mut IntSlot<'a>, r: &'a i32) -> () { slot.r = r  return () }
struct SlicePair<'a, 'b> { first: &'a [i32], second: &'b [i32] }
struct SliceSlot<'a> { r: &'a [i32] }
fn takeSliceFirst<'a, 'b>(slot: &mut SliceSlot<'a>, pair: SlicePair<'a, 'b>) -> () { slot.r = pair.first  return () }
fn sliceSibling() -> i32 {
  let a = [1]
  let mut b = [2]
  let zero = [0]
  let pair = SlicePair {first: &a, second: &b}
  let mut slot = SliceSlot {r: &zero}
  takeSliceFirst(&mut slot, move pair)
  b[0] = 3
  return slot.r[0] + b[0]
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let sibling = run Semantic.demandBody(&mut store, &mut request, &id, b"sibling")
  run Testing.expect(hasBorrowStatus(&sibling, BodyBorrowStatus.Checked), "same-type sibling loans follow their own source slot, not any compatible slot")
  let projectedSibling = run Semantic.demandBody(&mut store, &mut request, &id, b"projectedSibling")
  run Testing.expect(hasBorrowStatus(&projectedSibling, BodyBorrowStatus.Checked), "a field read does not transfer its equal-type sibling loan")
  let sliceSibling = run Semantic.demandBody(&mut store, &mut request, &id, b"sliceSibling")
  run Testing.expect(hasBorrowStatus(&sliceSibling, BodyBorrowStatus.Checked), "slice loans without a reference referent still follow their own source slots")
  let selected = run Semantic.demandBody(&mut store, &mut request, &id, b"selected")
  run Testing.expect(rejectsSpan(&selected, RejectionCode.AccessDuringLoan, text, "selectedOwner", 2), "the selected same-type slot still retains its actual source (OWN0011)")
  return ()
}

// Repeated nominal applications and reference boundaries preserve every concrete transferred loan.
test effect fn holderTransferReviewBoundaries() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run holderTransferReviewBoundariesClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn holderTransferReviewBoundariesClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("holderTransferReviewBoundaries.silk")
  let text = """
struct Cell<'a> { r: &'a i32 }
struct Pair<'a> { first: Cell<'a>, second: Cell<'a> }
fn take<'a>(out: &mut Cell<'a>, pair: Pair<'a>) -> () { out.r = pair.first.r  return () }
fn read<'a>(out: &mut Cell<'a>, pair: &Pair<'a>) -> () { out.r = pair.first.r  return () }
fn repeated() -> i32 {
  let mut repeatedOwner = 1
  let b = 2
  let zero = 0
  let pair = Pair {first: Cell {r: &repeatedOwner}, second: Cell {r: &b}}
  let mut out = Cell {r: &zero}
  take(&mut out, move pair)
  repeatedOwner = 3
  return out.r.*
}
fn reference() -> i32 {
  let mut referenceOwner = 1
  let b = 2
  let zero = 0
  let pair = Pair {first: Cell {r: &referenceOwner}, second: Cell {r: &b}}
  let mut out = Cell {r: &zero}
  read(&mut out, &pair)
  drop pair
  referenceOwner = 3
  return out.r.*
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let repeated = run Semantic.demandBody(&mut store, &mut request, &id, b"repeated")
  run Testing.expect(rejectsSpan(&repeated, RejectionCode.AccessDuringLoan, text, "repeatedOwner", 2), "the first of repeated nominal applications retains its loan")
  let reference = run Semantic.demandBody(&mut store, &mut request, &id, b"reference")
  run Testing.expect(rejectsSpan(&reference, RejectionCode.AccessDuringLoan, text, "referenceOwner", 2), "a reference boundary cannot discard the transferred referent")
  return ()
}

// A region shared by inference does not let a policy-only client retain a scratch slice.
test effect fn holderTransferDestinationSlots() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run holderTransferDestinationSlotsClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn holderTransferDestinationSlotsClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("holderTransferDestinationSlots.silk")
  let text = """
struct Policy { n: i32 }
struct Client<'p> { policy: &'p Policy }
effect fn touch<'p, 's>(client: &mut Client<'p>, policy: &'p Policy, scratch: &'s mut [u8]) -> () {
  scratch[0] = 1
  return ()
}
fn repeated() -> i32 {
  let policy = Policy {n: 4}
  let mut client = Client {policy: &policy}
  let mut scratch: [u8; 1] = [0]
  run touch(&mut client, &policy, &mut scratch)
  run touch(&mut client, &policy, &mut scratch)
  return client.policy.n
}
struct Buffer<'s> { scratch: &'s mut [u8] }
effect fn keep<'s>(buffer: &mut Buffer<'s>, scratch: &'s mut [u8]) -> () {
  buffer.scratch = move scratch
  return ()
}
fn retained() -> u8 {
  let mut original: [u8; 1] = [0]
  let mut buffer = Buffer {scratch: &mut original}
  let mut retainedScratch: [u8; 1] = [0]
  run keep(&mut buffer, &mut retainedScratch)
  run keep(&mut buffer, &mut retainedScratch)
  return buffer.scratch[0]
}
fn aliased() -> u8 {
  let mut original: [u8; 1] = [0]
  let mut buffer = Buffer {scratch: &mut original}
  let mut aliasScratch: [u8; 1] = [0]
  let destination = &mut buffer
  run keep(move destination, &mut aliasScratch)
  aliasScratch[0] = 2
  return buffer.scratch[0]
}

"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let repeated = run Semantic.demandBody(&mut store, &mut request, &id, b"repeated")
  run Testing.expect(hasBorrowStatus(&repeated, BodyBorrowStatus.Checked), "a policy-only holder cannot retain a scratch slice merely because inferred regions coincide")
  let retained = run Semantic.demandBody(&mut store, &mut request, &id, b"retained")
  run Testing.expect(rejectsSpan(&retained, RejectionCode.LoanConflict, text, "&mut retainedScratch", 1), "a holder with a compatible slice slot still retains the exclusive loan (OWN0010)")
  let aliased = run Semantic.demandBody(&mut store, &mut request, &id, b"aliased")
  run Testing.expect(rejectsSpan(&aliased, RejectionCode.AccessDuringLoan, text, "aliasScratch[0]", 0), "an aliased exclusive destination still retains its compatible source (OWN0011)")
  return ()
}

test effect fn holderTransferFieldRelease() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run holderTransferFieldReleaseClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn holderTransferFieldReleaseClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("precise-holder-release.silk")
  let text = """
struct Holder { n: i32, m: i32 }
fn make() -> Holder { return Holder {n: 1, m: 2} }
struct Slot<'a> { r: &'a Holder }
fn put<'a>(s: &mut Slot<'a>, r: &'a Holder) -> () { s.r = r  return () }
fn callReset(fb: &i32) -> i32 {
  let other = make()
  let mut s = Slot {r: &other}
  let mut k = 0
  if fb.* > 0 {
    let local = make()
    put(&mut s, &local)
    k = s.r.n
    s.r = &other
  }
  return s.r.n + k
}
fn directReset(fb: &i32) -> i32 {
  let other = make()
  let mut s = Slot {r: &other}
  let mut k = 0
  if fb.* > 0 {
    let local = make()
    s.r = &local
    k = s.r.n
    s.r = &other
  }
  return s.r.n + k
}
struct Pair<'a> { first: &'a Holder, second: &'a Holder }
fn putPair<'a>(s: &mut Pair<'a>, r: &'a Holder) -> () { s.first = r  return () }
fn allReset(fb: &i32) -> i32 {
  let other = make()
  let mut s = Pair {first: &other, second: &other}
  if fb.* > 0 {
    let local = make()
    putPair(&mut s, &local)
    s.first = &other
    s.second = &other
  }
  return s.second.n
}
fn siblingReset(fb: &i32) -> i32 {
  let other = make()
  let mut s = Pair {first: &other, second: &other}
  if fb.* > 0 {
    let local = make()
    putPair(&mut s, &local)
    s.second = &other
  }
  return s.first.n
}
fn oneRemains(fb: &i32) -> i32 {
  let other = make()
  let mut s = Pair {first: &other, second: &other}
  if fb.* > 0 {
    let local = make()
    putPair(&mut s, &local)
    s.first = &other
  }
  return s.second.n
}
struct Nested<'a> { inner: Slot<'a> }
fn nestedReset(fb: &i32) -> i32 {
  let other = make()
  let mut s = Nested {inner: Slot {r: &other}}
  if fb.* > 0 {
    let local = make()
    put(&mut s.inner, &local)
    s.inner.r = &other
  }
  return s.inner.r.n
}
fn callableReset(st: for<'a> fn(&mut Slot<'a>, &'a Holder) -> (), fb: &i32) -> i32 {
  let other = make()
  let mut s = Slot {r: &other}
  if fb.* > 0 {
    let local = make()
    st(&mut s, &local)
    s.r = &other
  }
  return s.r.n
}
fn writeRemaining() -> i32 {
  let other = make()
  let mut conflictOwner = make()
  let mut s = Pair {first: &other, second: &other}
  putPair(&mut s, &conflictOwner)
  s.first = &other
  conflictOwner.n = 9
  return s.second.n
}
fn clear<'a>(s: &mut Slot<'a>) -> () { return () }
fn opaqueClear(fb: &i32) -> i32 {
  let other = make()
  let mut s = Slot {r: &other}
  if fb.* > 0 {
    let local = make()
    put(&mut s, &local)
    clear(&mut s)
  }
  return s.r.n
}

"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let callReset = run Semantic.demandBody(&mut store, &mut request, &id, b"callReset")
  let directReset = run Semantic.demandBody(&mut store, &mut request, &id, b"directReset")
  let allReset = run Semantic.demandBody(&mut store, &mut request, &id, b"allReset")
  let siblingReset = run Semantic.demandBody(&mut store, &mut request, &id, b"siblingReset")
  let oneRemains = run Semantic.demandBody(&mut store, &mut request, &id, b"oneRemains")
  let nestedReset = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedReset")
  let callableReset = run Semantic.demandBody(&mut store, &mut request, &id, b"callableReset")
  let writeRemaining = run Semantic.demandBody(&mut store, &mut request, &id, b"writeRemaining")
  let opaqueClear = run Semantic.demandBody(&mut store, &mut request, &id, b"opaqueClear")
  run Testing.expect(rejectsSpan(&siblingReset, RejectionCode.ExpiredLifetime, text, "s.first.n", 0), "resetting a sibling cannot release the source (OWN0019)")
  run Testing.expect(rejectsSpan(&oneRemains, RejectionCode.ExpiredLifetime, text, "s.second.n", 1), "a second eligible destination keeps the loan even if the visible callee writes only first (OWN0019)")
  run Testing.expect(rejectsSpan(&writeRemaining, RejectionCode.AccessDuringLoan, text, "conflictOwner.n", 0), "the surviving destination also rejects a conflicting write (OWN0011)")
  run Testing.expect(rejectsSpan(&opaqueClear, RejectionCode.ExpiredLifetime, text, "s.r.n", 5), "an opaque clear signature grants no overwrite effect (OWN0019)")
  run Testing.expect(rejectsSpan(&callReset, RejectionCode.ExpiredLifetime, text, "s.r.n", 1),
    "a call that stores a local loan in the holder keeps it in the holder's region past a field reset (OWN0019, #2022)")
  run Testing.expect(rejectsSpan(&directReset, RejectionCode.ExpiredLifetime, text, "s.r.n", 3),
    "a direct field store of a local loan keeps it in the holder's region past a field reset (OWN0019, #2022)")
  run Testing.expect(rejectsSpan(&allReset, RejectionCode.ExpiredLifetime, text, "s.second.n", 0),
    "resetting every field the callee may write still leaves the local loan in the holder's region (OWN0019, #2022)")
  run Testing.expect(rejectsSpan(&nestedReset, RejectionCode.ExpiredLifetime, text, "s.inner.r.n", 0),
    "a loan stored through a lent projection lies in the outer holder's region past a nested reset (OWN0019, #2022)")
  run Testing.expect(rejectsSpan(&callableReset, RejectionCode.ExpiredLifetime, text, "s.r.n", 4),
    "a callable value's contract stores the local loan in the holder's region past a field reset (OWN0019, #2022)")
  return ()
}

test effect fn holderTransferReleaseFlow() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run holderTransferReleaseFlowClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn holderTransferReleaseFlowClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("holder-release-flow.silk")
  let text = """
struct Item { value: i32 }
struct Slot<'a> { r: &'a Item }
fn put<'a>(out: &mut Slot<'a>, value: &'a Item) -> () { out.r = value return () }
fn aliasReleased(flag: bool) -> i32 {
  let outer = Item {value: 0}
  let mut out = Slot {r: &outer}
  let mut alias = &outer
  if flag {
    let local = Item {value: 1}
    put(&mut out, &local)
    alias = out.r
    out.r = &outer
    alias = &outer
  }
  return alias.value + out.r.value
}
fn aliasSurvives(flag: bool) -> i32 {
  let outer = Item {value: 0}
  let mut out = Slot {r: &outer}
  let mut alias = &outer
  if flag {
    let local = Item {value: 1}
    put(&mut out, &local)
    alias = out.r
    out.r = &outer
  }
  return alias.value
}
fn branchRetains(enter: bool, reset: bool) -> i32 {
  let outer = Item {value: 0}
  let mut out = Slot {r: &outer}
  if enter {
    let local = Item {value: 1}
    put(&mut out, &local)
    if reset { out.r = &outer }
  }
  return out.r.value
}
fn loopReleased(count: i32) -> i32 {
  let outer = Item {value: 0}
  let mut out = Slot {r: &outer}
  let mut i = 0
  while i < count {
    let local = Item {value: 1}
    put(&mut out, &local)
    let n = out.r.value
    out.r = &outer
    i = i + n
  }
  return out.r.value
}
fn loopRetains(count: i32, reset: bool) -> i32 {
  let outer = Item {value: 0}
  let mut out = Slot {r: &outer}
  let mut i = 0
  while i < count {
    let local = Item {value: 1}
    put(&mut out, &local)
    let n = out.r.value
    if reset { out.r = &outer }
    i = i + n
  }
  return out.r.value
}
fn childSurvives(flag: bool) -> i32 {
  let outer = Item {value: 0}
  let mut out = Slot {r: &outer}
  let mut child = &outer.value
  if flag {
    let local = Item {value: 1}
    put(&mut out, &local)
    child = &out.r.value
    out.r = &outer
  }
  return child.*
}
fn reintroduced(flag: bool) -> i32 {
  let outer = Item {value: 0}
  let mut out = Slot {r: &outer}
  if flag {
    let local = Item {value: 1}
    let source = &local
    put(&mut out, source)
    out.r = &outer
    put(&mut out, source)
  }
  return out.r.value
}
fn reintroducedReset(flag: bool) -> i32 {
  let outer = Item {value: 0}
  let mut out = Slot {r: &outer}
  if flag {
    let local = Item {value: 1}
    let source = &local
    put(&mut out, source)
    out.r = &outer
    put(&mut out, source)
    out.r = &outer
  }
  return out.r.value
}
fn reintroducedConditional(enter: bool, again: bool) -> i32 {
  let outer = Item {value: 0}
  let mut out = Slot {r: &outer}
  if enter {
    let local = Item {value: 1}
    let source = &local
    put(&mut out, source)
    out.r = &outer
    if again { put(&mut out, source) }
  }
  return out.r.value
}
fn reintroducedBranchReset(enter: bool, again: bool) -> i32 {
  let outer = Item {value: 0}
  let mut out = Slot {r: &outer}
  if enter {
    let local = Item {value: 1}
    let source = &local
    put(&mut out, source)
    out.r = &outer
    if again {
      put(&mut out, source)
      out.r = &outer
    }
  }
  return out.r.value
}
fn loopReintroduced(count: i32, reset: bool) -> i32 {
  let outer = Item {value: 0}
  let mut out = Slot {r: &outer}
  let mut i = 0
  while i < count {
    let local = Item {value: 1}
    let source = &local
    put(&mut out, source)
    out.r = &outer
    put(&mut out, source)
    if reset { out.r = &outer }
    i = i + 1
  }
  return out.r.value
}
fn aliasReplacedWithLocal(flag: bool) -> i32 {
  let outer = Item {value: 0}
  let mut out = Slot {r: &outer}
  let mut alias = &outer
  if flag {
    let local = Item {value: 1}
    put(&mut out, &local)
    alias = out.r
    out.r = &outer
    alias = &local
  }
  return alias.value + out.r.value
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let aliasSurvives = run Semantic.demandBody(&mut store, &mut request, &id, b"aliasSurvives")
  run Testing.expect(rejectsSpan(&aliasSurvives, RejectionCode.ExpiredLifetime, text, "alias.value", 1), "aliasSurvives: every surviving source remains retained (OWN0019)")
  let branchRetains = run Semantic.demandBody(&mut store, &mut request, &id, b"branchRetains")
  run Testing.expect(rejectsSpan(&branchRetains, RejectionCode.ExpiredLifetime, text, "out.r.value", 1), "branchRetains: every surviving source remains retained (OWN0019)")
  let loopReleased = run Semantic.demandBody(&mut store, &mut request, &id, b"loopReleased")
  run Testing.expect(rejectsSpan(&loopReleased, RejectionCode.ExpiredLifetime, text, "out.r.value", 3),
    "loopReleased: a reset inside the loop leaves each local loan in the holder's region (OWN0019, #2022)")
  let loopRetains = run Semantic.demandBody(&mut store, &mut request, &id, b"loopRetains")
  run Testing.expect(rejectsSpan(&loopRetains, RejectionCode.ExpiredLifetime, text, "out.r.value", 5), "loopRetains: every surviving source remains retained (OWN0019)")
  let childSurvives = run Semantic.demandBody(&mut store, &mut request, &id, b"childSurvives")
  run Testing.expect(rejectsSpan(&childSurvives, RejectionCode.ExpiredLifetime, text, "child.*", 0), "childSurvives: every surviving source remains retained (OWN0019)")
  let reintroduced = run Semantic.demandBody(&mut store, &mut request, &id, b"reintroduced")
  run Testing.expect(rejectsSpan(&reintroduced, RejectionCode.ExpiredLifetime, text, "out.r.value", 7), "reintroduced: every surviving source remains retained (OWN0019)")
  let reintroducedReset = run Semantic.demandBody(&mut store, &mut request, &id, b"reintroducedReset")
  run Testing.expect(rejectsSpan(&reintroducedReset, RejectionCode.ExpiredLifetime, text, "out.r.value", 8),
    "reintroducedReset: resetting after a reintroduced loan leaves it in the holder's region (OWN0019, #2022)")
  let reintroducedConditional = run Semantic.demandBody(&mut store, &mut request, &id, b"reintroducedConditional")
  run Testing.expect(rejectsSpan(&reintroducedConditional, RejectionCode.ExpiredLifetime, text, "out.r.value", 9), "reintroducedConditional: every surviving source remains retained (OWN0019)")
  let reintroducedBranchReset = run Semantic.demandBody(&mut store, &mut request, &id, b"reintroducedBranchReset")
  run Testing.expect(rejectsSpan(&reintroducedBranchReset, RejectionCode.ExpiredLifetime, text, "out.r.value", 10),
    "reintroducedBranchReset: a reset on every branch leaves the loan in the holder's region (OWN0019, #2022)")
  let loopReintroduced = run Semantic.demandBody(&mut store, &mut request, &id, b"loopReintroduced")
  run Testing.expect(rejectsSpan(&loopReintroduced, RejectionCode.ExpiredLifetime, text, "out.r.value", 11), "loopReintroduced: every surviving source remains retained (OWN0019)")
  let aliasReleased = run Semantic.demandBody(&mut store, &mut request, &id, b"aliasReleased")
  run Testing.expect(rejectsSpan(&aliasReleased, RejectionCode.ExpiredLifetime, text, "alias.value", 0),
    "aliasReleased: resetting the alias and the holder leaves the loan in the alias's region (OWN0019, #2022)")
  let aliasReplacedWithLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"aliasReplacedWithLocal")
  run Testing.expect(rejectsSpan(&aliasReplacedWithLocal, RejectionCode.ExpiredLifetime, text, "alias.value", 2), "aliasReplacedWithLocal: every surviving source remains retained (OWN0019)")
  return ()
}

// A selected caller slot authenticates a concrete reaching source, not every historical
// definition of its holder. Last uses and replacement end that source; a copied alias can keep it.
test effect fn callerSlotSourcesFollowLiveDefinitions() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run callerSlotSourceClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn callerSlotSourceClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("caller-slot-source-flow.silk")
  let text = """
struct Token { value: i32 }
struct Cell { tok: Token }
struct Two<'a, 'b> { c: &'a Cell, t: &'b Token }
struct Shelf<'s> { held: &'s Token }
fn put<'a, 's>(shelf: &mut Shelf<'s>, two: Two<'a, 's>) -> () { shelf.held = two.t return () }
fn lastUse<'u>(cell: &'u mut Cell, k: &'u Token, other: &Cell) -> i32 {
  let mut two = Two {c: other, t: k}
  two.t = &cell.tok
  let value = two.t.value
  cell.tok.value = 9
  return value
}
fn resetBeforeCall<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, other: &Cell) -> i32 {
  let mut two = Two {c: other, t: k}
  two.t = &cell.tok
  two.t = k
  put(&mut shelf.*, move two)
  cell.tok.value = 9
  return shelf.held.value
}
fn aliasReleased<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, other: &Cell) -> i32 {
  let mut two = Two {c: other, t: k}
  two.t = &cell.tok
  let alias = two.t
  let value = alias.value
  two.t = k
  put(&mut shelf.*, move two)
  cell.tok.value = 9
  return value + shelf.held.value
}
fn aliasRetained<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, other: &Cell) -> i32 {
  let mut two = Two {c: other, t: k}
  two.t = &cell.tok
  let alias = two.t
  two.t = k
  let selected = Two {c: other, t: alias}
  put(&mut shelf.*, move selected)
  cell.tok.value = 9
  return shelf.held.value
}
fn nonretainingSibling<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token) -> i32 {
  let two = Two {c: &cell.*, t: k}
  put(&mut shelf.*, move two)
  cell.tok.value = 9
  return shelf.held.value
}
fn conditionalRetained<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, other: &Cell, reset: bool) -> i32 {
  let mut two = Two {c: other, t: k}
  two.t = &cell.tok
  if reset { two.t = k }
  put(&mut shelf.*, move two)
  cell.tok.value = 9
  return shelf.held.value
}
fn conditionalReset<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, other: &Cell, choose: bool) -> i32 {
  let mut two = Two {c: other, t: k}
  two.t = &cell.tok
  if choose { two.t = k } else { two.t = k }
  put(&mut shelf.*, move two)
  cell.tok.value = 9
  return shelf.held.value
}
fn aliasReadAfterReset<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, other: &Cell) -> i32 {
  let mut two = Two {c: other, t: k}
  two.t = &cell.tok
  two.t = k
  let alias = two.t
  let selected = Two {c: other, t: alias}
  put(&mut shelf.*, move selected)
  cell.tok.value = 9
  return shelf.held.value
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let lastUse = run Semantic.demandBody(&mut store, &mut request, &id, b"lastUse")
  run Testing.expect(hasBorrowStatus(&lastUse, BodyBorrowStatus.Checked),
    "a stored field source ends at its last scalar use")
  let resetBeforeCall = run Semantic.demandBody(&mut store, &mut request, &id, b"resetBeforeCall")
  run Testing.expect(rejectsSpan(&resetBeforeCall, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 1),
    "replacing the slot before the call does not release its earlier loan: the holder's region keeps every loan stored in it (OWN0011; location-sensitive regions are #2022)")
  let aliasReleased = run Semantic.demandBody(&mut store, &mut request, &id, b"aliasReleased")
  run Testing.expect(rejectsSpan(&aliasReleased, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 2),
    "a copied alias's earlier last use does not release the loan the holder's region still carries into the caller slot (OWN0011; #2022)")
  let nonretainingSibling = run Semantic.demandBody(&mut store, &mut request, &id, b"nonretainingSibling")
  run Testing.expect(hasBorrowStatus(&nonretainingSibling, BodyBorrowStatus.Checked),
    "an unrelated sibling carries no loan into the selected retaining slot")
  let aliasRetained = run Semantic.demandBody(&mut store, &mut request, &id, b"aliasRetained")
  run Testing.expect(rejectsSpan(&aliasRetained, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 3),
    "resetting one holder does not release the alias stored into the caller slot (OWN0011)")
  let conditionalRetained = run Semantic.demandBody(&mut store, &mut request, &id, b"conditionalRetained")
  run Testing.expect(rejectsSpan(&conditionalRetained, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 5),
    "a still-reaching actual source on one branch remains retained by the caller (OWN0011)")
  let conditionalReset = run Semantic.demandBody(&mut store, &mut request, &id, b"conditionalReset")
  run Testing.expect(rejectsSpan(&conditionalReset, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 6),
    "replacing the slot on every branch does not release the loan the holder's region already carries (OWN0011; #2022)")
  let aliasReadAfterReset = run Semantic.demandBody(&mut store, &mut request, &id, b"aliasReadAfterReset")
  run Testing.expect(rejectsSpan(&aliasReadAfterReset, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 7),
    "a copy read after the reset shares the holder's region, which still carries the earlier loan (OWN0011; #2022)")
  return ()
}

// Retention starts on the actual caller path; ordinary uses before the call still keep the loan.
test effect fn callerRetentionFollowsControlFlow() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run callerRetentionPathClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn callerRetentionPathClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("caller-retention-paths.silk")
  let text = """
struct Token { value: i32 }
struct Cell { tok: Token }
struct Two<'a, 'b> { c: &'a Cell, t: &'b Token }
struct Shelf<'s> { held: &'s Token }
fn put<'a, 's>(shelf: &mut Shelf<'s>, two: Two<'a, 's>) -> () { shelf.held = two.t return () }
fn siblingFresh<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, other: &Cell, retain: bool) -> i32 {
  let two = Two {c: other, t: &cell.tok}
  if retain { put(&mut shelf.*, move two) } else { cell.tok.value = 9 }
  return 0
}
fn siblingStored<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, other: &Cell, retain: bool) -> i32 {
  let mut two = Two {c: other, t: k}
  two.t = &cell.tok
  if retain { put(&mut shelf.*, move two) } else { cell.tok.value = 9 }
  return 0
}
fn earlyReturn<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, other: &Cell, retain: bool) -> i32 {
  let two = Two {c: other, t: &cell.tok}
  if retain { put(&mut shelf.*, move two) return 0 }
  cell.tok.value = 9
  return 0
}
fn loopMaybeReset<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, other: &Cell, reset: bool) -> i32 {
  let mut two = Two {c: other, t: k}
  two.t = &cell.tok
  while reset { two.t = k break }
  put(&mut shelf.*, move two)
  cell.tok.value = 9
  return shelf.held.value
}
fn longCopiedSource<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, other: &Cell) -> i32 {
  let mut two = Two {c: other, t: k}
  two.t = &cell.tok
  let first = two.t
  two.t = k
  let mut middle = Two {c: other, t: first}
  let second = middle.t
  middle.t = k
  let third = second
  let selected = Two {c: other, t: third}
  put(&mut shelf.*, move selected)
  cell.tok.value = 9
  return shelf.held.value
}
fn branchCopiedSource<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, other: &Cell, choose: bool) -> i32 {
  let mut two = Two {c: other, t: k}
  two.t = &cell.tok
  let real = two.t
  two.t = k
  let mut selected = Two {c: other, t: k}
  if choose { selected.t = real } else { selected.t = two.t }
  let value = selected.t
  selected.t = k
  let finalHolder = Two {c: other, t: value}
  put(&mut shelf.*, move finalHolder)
  cell.tok.value = 9
  return shelf.held.value
}
fn beforeRetainingCall<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, other: &Cell) -> i32 {
  let two = Two {c: other, t: &cell.tok}
  cell.tok.value = 9
  put(&mut shelf.*, move two)
  return 0
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let siblingFresh = run Semantic.demandBody(&mut store, &mut request, &id, b"siblingFresh")
  run Testing.expect(rejectsSpan(&siblingFresh, RejectionCode.AccessDuringLoan, text, "cell.tok.value", usize.ZERO),
    "siblingFresh: a loan stored at a caller lifetime on one path is live on every path (OWN0011; #2022)")
  let siblingStored = run Semantic.demandBody(&mut store, &mut request, &id, b"siblingStored")
  run Testing.expect(rejectsSpan(&siblingStored, RejectionCode.AccessDuringLoan, text, "cell.tok.value", usize.ONE),
    "siblingStored: a loan stored at a caller lifetime on one path is live on every path (OWN0011; #2022)")
  let earlyReturn = run Semantic.demandBody(&mut store, &mut request, &id, b"earlyReturn")
  run Testing.expect(rejectsSpan(&earlyReturn, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 2),
    "earlyReturn: a loan stored at a caller lifetime before a return is live on the path that continues (OWN0011; #2022)")
  let loopMaybeReset = run Semantic.demandBody(&mut store, &mut request, &id, b"loopMaybeReset")
  run Testing.expect(rejectsSpan(&loopMaybeReset, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 3),
    "loopMaybeReset: the actual source remains live on a conflicting path (OWN0011)")
  let longCopiedSource = run Semantic.demandBody(&mut store, &mut request, &id, b"longCopiedSource")
  run Testing.expect(rejectsSpan(&longCopiedSource, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 4),
    "longCopiedSource: the actual source remains live on a conflicting path (OWN0011)")
  let branchCopiedSource = run Semantic.demandBody(&mut store, &mut request, &id, b"branchCopiedSource")
  run Testing.expect(rejectsSpan(&branchCopiedSource, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 5),
    "branchCopiedSource: the actual source remains live on a conflicting path (OWN0011)")
  let beforeRetainingCall = run Semantic.demandBody(&mut store, &mut request, &id, b"beforeRetainingCall")
  run Testing.expect(rejectsSpan(&beforeRetainingCall, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 6),
    "beforeRetainingCall: the actual source remains live on a conflicting path (OWN0011)")
  return ()
}

test effect fn callerRetentionSurvivesJoinsAndBackedges() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run callerRetentionJoinClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn callerRetentionJoinClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("callerRetentionSurvivesJoinsAndBackedges.silk")
  let text = """
struct Token { value: i32 }
struct Cell { tok: Token }
struct Two<'a, 'b> { c: &'a Cell, t: &'b Token }
struct Shelf<'s> { held: &'s Token }
fn put<'a, 's>(shelf: &mut Shelf<'s>, two: Two<'a, 's>) -> () { shelf.held = two.t return () }
fn joinFresh<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, other: &Cell, retain: bool) -> i32 {
  let two = Two {c: other, t: &cell.tok}
  if retain { put(&mut shelf.*, move two) }
  cell.tok.value = 9
  return 0
}
fn joinStored<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, other: &Cell, retain: bool) -> i32 {
  let mut two = Two {c: other, t: k}
  two.t = &cell.tok
  if retain { put(&mut shelf.*, move two) }
  cell.tok.value = 9
  return 0
}
fn backedgeRetained<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, other: &Cell, again: bool) -> i32 {
  let mut first = true
  while again {
    if first {
      put(&mut shelf.*, Two {c: other, t: &cell.tok})
      first = false
      continue
    }
    cell.tok.value = 9
    break
  }
  return 0
}
fn loopReturningArm<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, other: &Cell, again: bool, retain: bool) -> i32 {
  while again {
    let two = Two {c: other, t: &cell.tok}
    if retain { put(&mut shelf.*, move two) return 0 }
    cell.tok.value = 9
    break
  }
  return 0
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let joinFresh = run Semantic.demandBody(&mut store, &mut request, &id, b"joinFresh")
  let joinStored = run Semantic.demandBody(&mut store, &mut request, &id, b"joinStored")
  let backedgeRetained = run Semantic.demandBody(&mut store, &mut request, &id, b"backedgeRetained")
  let loopReturningArm = run Semantic.demandBody(&mut store, &mut request, &id, b"loopReturningArm")
  run Testing.expect(rejectsSpan(&joinFresh, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 0), "joinFresh: independent source and path contract")
  run Testing.expect(rejectsSpan(&joinStored, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 1), "joinStored: independent source and path contract")
  run Testing.expect(rejectsSpan(&backedgeRetained, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 2), "backedgeRetained: independent source and path contract")
  run Testing.expect(rejectsSpan(&loopReturningArm, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 3),
    "loopReturningArm: a loan stored at a caller lifetime in a returning arm is live on the path that continues (OWN0011; #2022)")
  return ()
}

test effect fn callerRetentionUsesFeasibleLiteralLoops() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run literalLoopRetentionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn literalLoopRetentionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("literal-loop-retention.silk")
  let text = """
struct Token { value: i32 }
struct Cell { tok: Token }
struct Two<'a, 'b> { c: &'a Cell, t: &'b Token }
struct Shelf<'s> { held: &'s Token }
fn put<'a, 's>(shelf: &mut Shelf<'s>, two: Two<'a, 's>) -> () { shelf.held = two.t return () }
fn loopMustReset<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, other: &Cell) -> i32 {
  let mut two = Two {c: other, t: k}
  two.t = &cell.tok
  while true { two.t = k break }
  put(&mut shelf.*, move two)
  cell.tok.value = 9
  return shelf.held.value
}
fn falseReset<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, other: &Cell) -> i32 {
  let mut two = Two {c: other, t: k}
  two.t = &cell.tok
  while false { two.t = k break }
  put(&mut shelf.*, move two)
  cell.tok.value = 9
  return shelf.held.value
}
fn falseBorrow<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, other: &Cell) -> i32 {
  let mut two = Two {c: other, t: k}
  while false { two.t = &cell.tok }
  put(&mut shelf.*, move two)
  cell.tok.value = 9
  return shelf.held.value
}
fn nestedReset<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, other: &Cell) -> i32 {
  let mut two = Two {c: other, t: k}
  two.t = &cell.tok
  while true { while true { two.t = k break } break }
  put(&mut shelf.*, move two)
  cell.tok.value = 9
  return shelf.held.value
}
fn continueReset<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, k: &'u Token, other: &Cell, again: bool) -> i32 {
  let mut two = Two {c: other, t: k}
  two.t = &cell.tok
  while true { two.t = k if again { continue } break }
  put(&mut shelf.*, move two)
  cell.tok.value = 9
  return shelf.held.value
}
fn returningLoop<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, other: &Cell) -> i32 {
  let two = Two {c: other, t: &cell.tok}
  while true { return 0 }
  put(&mut shelf.*, move two)
  cell.tok.value = 9
  return shelf.held.value
}
fn nestedOnlyBreak<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, other: &Cell) -> i32 {
  let two = Two {c: other, t: &cell.tok}
  while true { while true { break } }
  put(&mut shelf.*, move two)
  cell.tok.value = 9
  return shelf.held.value
}
fn retainCondition<'a, 's>(shelf: &mut Shelf<'s>, two: Two<'a, 's>) -> bool {
  put(&mut shelf.*, move two)
  return false
}
fn conditionRetains<'u>(cell: &'u mut Cell, shelf: &mut Shelf<'u>, other: &Cell) -> i32 {
  let two = Two {c: other, t: &cell.tok}
  while retainCondition(&mut shelf.*, move two) { break }
  cell.tok.value = 9
  return shelf.held.value
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let loopMustReset = run Semantic.demandBody(&mut store, &mut request, &id, b"loopMustReset")
  run Testing.expect(rejectsSpan(&loopMustReset, RejectionCode.AccessDuringLoan, text, "cell.tok.value", usize.ZERO),
    "replacing the field inside a literal-true loop does not release the loan the holder's region carries (OWN0011; #2022)")
  let falseReset = run Semantic.demandBody(&mut store, &mut request, &id, b"falseReset")
  run Testing.expect(rejectsSpan(&falseReset, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 1),
    "a skipped replacement cannot discharge the actual pre-loop loan")
  let falseBorrow = run Semantic.demandBody(&mut store, &mut request, &id, b"falseBorrow")
  run Testing.expect(hasBorrowStatus(&falseBorrow, BodyBorrowStatus.Checked),
    "a skipped body does not introduce a retaining source")
  let nestedReset = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedReset")
  run Testing.expect(rejectsSpan(&nestedReset, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 3),
    "a replacement in nested literal-true loops does not release the loan the holder's region carries (OWN0011; #2022)")
  let continueReset = run Semantic.demandBody(&mut store, &mut request, &id, b"continueReset")
  run Testing.expect(rejectsSpan(&continueReset, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 4),
    "a replacement repeated through continue does not release the loan the holder's region carries (OWN0011; #2022)")
  let returningLoop = run Semantic.demandBody(&mut store, &mut request, &id, b"returningLoop")
  run Testing.expect(hasBorrowStatus(&returningLoop, BodyBorrowStatus.Checked),
    "a literal-true returning body cannot fall through to a retaining call")
  let nestedOnlyBreak = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedOnlyBreak")
  run Testing.expect(hasBorrowStatus(&nestedOnlyBreak, BodyBorrowStatus.Checked),
    "an inner break cannot make an endless outer loop fall through")
  let conditionRetains = run Semantic.demandBody(&mut store, &mut request, &id, b"conditionRetains")
  run Testing.expect(rejectsSpan(&conditionRetains, RejectionCode.AccessDuringLoan, text, "cell.tok.value", 7),
    "the condition is evaluated and retains its source even when it returns false")
  return ()
}

// A selected section contract can prove a capture non-storing while its real reborrow still
// lives in the environment. Construction alone does not perform the target's possible writes.
test effect fn selectedSectionCapturesKeepTheirActualLoans() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run selectedSectionCaptureClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn selectedSectionCaptureClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("selected-section-captures.silk")
  let text = """
struct Token { value: i32 }
struct Tunnel<'t> { view: &'t Token, count: i32 }
fn bump<'t>(by: i32, tunnel: &mut Tunnel<'t>) -> () {
  tunnel.count = tunnel.count + by
  return ()
}
fn namedSection<'t>(tunnel: &mut Tunnel<'t>) -> () {
  let mut step = bump<'t>(&mut tunnel.*)
  step(1)
  return ()
}
fn closureSection<'t>(tunnel: &mut Tunnel<'t>) -> () {
  let mut use = fn(owned: &mut Tunnel<'t>) -> () {
    let mut step = bump<'t>(&mut owned.*)
    step(1)
  }
  use(&mut tunnel.*)
  return ()
}
fn movedLastUse<'t>(p: &mut Tunnel<'t>) -> i32 {
 let stage = bump<'t>(&mut p.*)
 let mut moved = move stage
 moved(1)
 p.count = 2
 return p.count
}
fn parentBefore<'t>(p: &mut Tunnel<'t>) -> () {
 let mut stage = bump<'t>(&mut p.*)
 p.count = 2
 stage(1)
 return ()
}
fn droppedNonstoring<'t>(p: &mut Tunnel<'t>) -> () {
 let stage = bump<'t>(&mut p.*)
 drop stage
 p.count = 2
 return ()
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let named = run Semantic.demandBody(&mut store, &mut request, &id, b"namedSection")
  let closure = run Semantic.demandBody(&mut store, &mut request, &id, b"closureSection")
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"movedLastUse")
  let parent = run Semantic.demandBody(&mut store, &mut request, &id, b"parentBefore")
  let dropped = run Semantic.demandBody(&mut store, &mut request, &id, b"droppedNonstoring")
  run Testing.expect(hasBorrowStatus(&named, BodyBorrowStatus.Checked) && hasBorrowStatus(&closure, BodyBorrowStatus.Checked),
    "complete named and anonymous sections release a non-storing reborrow of a mutable parameter")
  run Testing.expect(hasBorrowStatus(&moved, BodyBorrowStatus.Checked) && hasBorrowStatus(&dropped, BodyBorrowStatus.Checked),
    "moving or dropping a non-storing section preserves the actual capture's last use")
  run Testing.expect(rejectsSpan(&parent, RejectionCode.AccessDuringLoan, text, "p.count", 2),
    "a selected non-storing target still holds its reborrow until its actual invocation (OWN0011)")
  return ()
}

test effect fn sliceReborrowsRelateTheirElements() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run sliceReborrowElementClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

// A slice borrow of a slice reborrows its elements (rustc's `&mut *storage`): the view's element type
// relates to the borrowed slice's own element type.
effect fn sliceReborrowElementClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("slice-reborrow-elements.silk")
  let text = """
struct Holder<'c> { bytes: &'c u8 }
fn takes<'a>(value: &'a u8, storage: &mut [Holder<'a>]) -> () {
  storage[0] = Holder<'a> {bytes: value}
  return ()
}
fn reborrows<'a>(value: &'a u8, storage: &mut [Holder<'a>]) -> () { return takes(value, &mut storage) }
fn storesLocal<'a>(storage: &mut [Holder<'a>]) -> () {
  let local: u8 = 1
  let view = &mut storage
  view[0] = Holder {bytes: &local}
  return ()
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let reborrows = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrows")
  let storesLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"storesLocal")
  run Testing.expect(hasBorrowStatus(&reborrows, BodyBorrowStatus.Checked),
    "a reborrowed slice of nominal elements keeps their lifetime, not the slice's own (rustc accepts)")
  run Testing.expect(rejectsSpan(&storesLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", usize.ZERO),
    "a store through a slice reborrow must outlive the borrowed elements' lifetime: SEM0212 at the borrow (rustc E0597)")
  return ()
}

test effect fn genericWitnessEffectsKeepTheirContract() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run genericWitnessEffectClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

// An interface `effect fn` called through a type parameter's conformance is typed as its unselected
// witness's result, which stands for the applied contract's Effect: its environment and success
// keep their own regions.
effect fn genericWitnessEffectClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("generic-witness-effects.silk")
  let text = """
struct Step<'p> {
  value: &'p u8,
}
service Probe {
  effect fn probe() -> u8 ? &mut Probe
}
interface Plan<'q> {
  effect<'env> fn select<'env>(plan: &mut Self) -> Step<'q> ? &mut Probe
}
fn impossible<T>() -> T {
  return impossible<T>()
}
effect fn handled<'env, A>(program: once Effect<'env; A ? &mut Probe>, provider: &'env mut u8) -> A {
  drop program
  return impossible<A>()
}
fn keeps<'k, A>(program: once Effect<'k; A ? &mut Probe>) -> A {
  drop program
  return impossible<A>()
}
fn provides<'policy, 'client, P: Plan<'policy>>(slot: &'client mut u8, plan: P) -> Step<'policy> {
  let mut selected = move plan
  let outcome = run Plan<'policy>.select(&mut selected) |> handled(&mut slot.*)
  return move outcome
}
fn leaks<'policy, P: Plan<'policy>>(plan: P) -> Step<'policy> {
  let mut selected = move plan
  let pending = Plan<'policy>.select(&mut selected)
  return keeps<'policy, Step<'policy>>(move pending)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let provides = run Semantic.demandBody(&mut store, &mut request, &id, b"provides")
  let leaks = run Semantic.demandBody(&mut store, &mut request, &id, b"leaks")
  run Testing.expect(hasBorrowStatus(&provides, BodyBorrowStatus.Checked),
    "a provider lent to a generic witness's Effect outlives only that Effect's environment, not its success's lifetime (rustc accepts)")
  run Testing.expect(rejectsSpan(&leaks, RejectionCode.UnsatisfiedLifetimeBound, text, "&mut selected", usize.ONE),
    "a generic witness's Effect holds its operands' loans: a local borrow cannot outlive `'policy`: SEM0212 at the borrow (rustc E0597)")
  return ()
}

test effect fn effectParametersOutliveTheirEnvironment() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run effectParameterClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

// A parameter of Effect type represents `F: once Effect<'e; ..>`, which holds `F: 'e` as a callable
// representation does (rustc's `impl Future + 'e`).
effect fn effectParameterClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("effect-parameter-environments.silk")
  let text = """
fn keepsStatic<F: 'static>(value: F) -> () {
  drop value
  return ()
}
fn effectIsStatic(program: once Effect<'static; u64>) -> () {
  keepsStatic(move program)
  return ()
}
fn effectIsShort<'a>(program: once Effect<'a; u64>) -> () {
  keepsStatic(move program)
  return ()
}
effect<'static> fn stored<A: 'static>(body: once Effect<'static; A>) -> () {
  drop body
  return ()
}
fn storesStatic<A: 'static>(program: once Effect<'static; A>) -> () {
  let built = stored<A>(move program)
  drop built
  return ()
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let isStatic = run Semantic.demandBody(&mut store, &mut request, &id, b"effectIsStatic")
  let isShort = run Semantic.demandBody(&mut store, &mut request, &id, b"effectIsShort")
  let storesStatic = run Semantic.demandBody(&mut store, &mut request, &id, b"storesStatic")
  run Testing.expect(hasBorrowStatus(&isStatic, BodyBorrowStatus.Checked) && hasBorrowStatus(&storesStatic, BodyBorrowStatus.Checked),
    "an Effect parameter outlives its environment, as a `'static` bound or a `'static` Effect storing it needs (rustc accepts)")
  run Testing.expect(rejectsSpan(&isShort, RejectionCode.UnsatisfiedLifetimeBound, text, "keepsStatic(move program)", usize.ONE),
    "an Effect parameter with a shorter environment does not outlive `'static`: SEM0212 at the call (rustc E0310)")
  return ()
}
