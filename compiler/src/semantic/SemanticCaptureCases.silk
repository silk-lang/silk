effect fn captureMatchSpanClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("capture-match-spans.silk")
  let text = """
struct Token { value: i32 }
fn endedMoveMatch(spent: Token) -> () {
  drop spent
  match move spent { Token { value } => { let closure = fn() -> i32 { return value } } }
}
fn endedPlaceMatch(inspected: Token) -> () {
  drop inspected
  match place inspected { Token { value } => { let closure = fn() -> i32 { return value } } }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"endedMoveMatch")
  let inspected = run Semantic.demandBody(&mut store, &mut request, &id, b"endedPlaceMatch")
  run Testing.expect(rejectsSpan(&moved, RejectionCode.UseAfterMove, text,
    "match move spent { Token { value } => { let closure = fn() -> i32 { return value } } }", usize.ZERO) &&
    rejectsSpan(&inspected, RejectionCode.UseAfterMove, text,
    "match place inspected { Token { value } => { let closure = fn() -> i32 { return value } } }", usize.ZERO),
    "owned inspection or consumption of unavailable storage names the complete match")
}

fn nestedAnonymousCaptureFacts(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Callable {body: outer, ..}, ..} = &nodes[at].kind {
      return Shared<TypedBody>.with<bool>(&outer, fn(value: &TypedBody) -> bool {
        return anonymousCaptureFacts(value, CallableMode.Shared, usize.ZERO, usize.MAX, usize.ONE, false)
      })
    }
    at = at + usize.ONE
  }
  return false
}

fn nestedAnonymousBodyFacts(answer: &Result<Answer, NoRejection>) -> bool {
  if let Option<Shared<TypedBody>>.Some {value} = move checkedBody(answer) {
    return Shared<TypedBody>.with<bool>(&value, nestedAnonymousCaptureFacts)
  }
  return false
}

test effect fn anonymousNestedBodiesRetainTheirOwnCaptures() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
