effect fn finalInferenceSourceClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("final-inference-goals.silk")
  let text = """
fn choose<'a>(first: &'a [u8], second: &'a [u8]) -> &'a [u8] { return second }
fn forward<'a>(value: &'a [u8]) -> &'a [u8] { return choose(b"first", value) }
fn reversed<'a>(value: &'a [u8]) -> &'a [u8] { return choose(value, b"second") }
fn fixedSection<'a>(value: &'a [u8]) -> &'a [u8] { let next = choose(b"second") return next(value) }
fn callable<'a>(callback: for<'call> fn<'static>(&'call [u8], &'call [u8]) -> &'call [u8], value: &'a [u8]) -> &'a [u8] {
  return callback(b"first", value)
}
struct Pair<'a, 'b> { first: &'a [u8], second: &'b [u8] }
fn chooseTwo<'a, 'b>(a: &'a [u8], b: &'a [u8], c: &'b [u8], d: &'b [u8]) -> Pair<'a, 'b> {
  return Pair<'a, 'b> {first: b, second: d}
}
fn independent<'a, 'b>(a: &'a [u8], b: &'b [u8]) -> Pair<'a, 'b> {
  return chooseTwo(b"first", a, b"second", b)
}
fn escape<'a>(value: &'a [u8]) -> &'static [u8] { return choose(b"first", value) }
fn explicit<'a>(value: &'a [u8]) -> &'static [u8] { return choose<'static>(b"first", value) }
struct Holder<'a> { value: &'a [u8] }
fn put<'a>(target: &mut Holder<'a>, value: &'a [u8]) -> () { target.value = value }
fn invariant<'a>(target: &mut Holder<'static>, value: &'a [u8]) -> () { put(&mut target.*, value) }
fn owned() -> &'static [u8] { let data: [u8; 1] = [1] let view: &[u8] = &data return choose(b"first", view) }
fn captured<'a>(value: &'a [u8]) -> fn<'static>() -> u8 {
  let picked = choose(b"first", value)
  return fn() -> u8 { return picked[0] }
}
struct Obj { n: i32 }
interface Show { fn show(self: &Self) -> i32 }
impl Show for i32 { fn show(self: &Self) -> i32 { return self.* } }
effect fn begin(options: &i32) -> Obj { return Obj {n: options.*} }
effect fn field<'env, T: Show, E, ?R>(self: once Effect<'env; Obj ! E ? R>, key: string<'env>, value: &'env T) -> Obj ! E ? R {
  let state = run move self
  return move state
}
effect fn keep<'env, E, ?R>(self: once Effect<'env; Obj ! E ? R>, key: string<'env>, a: &'env i32, b: &'env i32) -> &'env i32 ! E ? R {
  let state = run move self
  return b
}
effect fn fieldMut<'env, E, ?R>(self: once Effect<'env; Obj ! E ? R>, key: &mut string<'env>, value: &'env i32) -> Obj ! E ? R {
  let state = run move self
  return move state
}
effect fn fieldStatic<'env: 'static, E, ?R>(self: once Effect<'env; Obj ! E ? R>, key: string<'env>, value: &'env i32) -> Obj ! E ? R {
  let state = run move self
  return move state
}
effect fn piped(value: &i32, options: &i32) -> i32 {
  let o = run begin(options) |> field("x", value)
  return o.n
}
effect fn pipedKept<'s>(x: &'s i32, options: &'s i32) -> &'s i32 { return run begin(options) |> keep("x", x, x) }
effect fn pipedLocal<'s>(x: &'s i32, options: &'s i32) -> &'s i32 {
  let held = 5
  return run begin(options) |> keep("x", x, &held)
}
effect fn pipedInvariant(value: &i32, options: &i32) -> i32 {
  let mut key: string<'static> = "x"
  let o = run begin(options) |> fieldMut(&mut key, value)
  return o.n
}
effect fn pipedStatic(value: &i32, options: &i32) -> i32 {
  let o = run begin(options) |> fieldStatic("x", value)
  return o.n
}
fn parsedToTheEnd() -> i32 { return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let forward = run Semantic.demandBody(&mut store, &mut request, &id, b"forward")
  let reversed = run Semantic.demandBody(&mut store, &mut request, &id, b"reversed")
  let callable = run Semantic.demandBody(&mut store, &mut request, &id, b"callable")
  let fixedSection = run Semantic.demandBody(&mut store, &mut request, &id, b"fixedSection")
  let independent = run Semantic.demandBody(&mut store, &mut request, &id, b"independent")
  let escape = run Semantic.demandBody(&mut store, &mut request, &id, b"escape")
  let explicit = run Semantic.demandBody(&mut store, &mut request, &id, b"explicit")
  let invariant = run Semantic.demandBody(&mut store, &mut request, &id, b"invariant")
  let owned = run Semantic.demandBody(&mut store, &mut request, &id, b"owned")
  let captured = run Semantic.demandBody(&mut store, &mut request, &id, b"captured")
  let piped = run Semantic.demandBody(&mut store, &mut request, &id, b"piped")
  let pipedKept = run Semantic.demandBody(&mut store, &mut request, &id, b"pipedKept")
  let pipedLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"pipedLocal")
  let pipedInvariant = run Semantic.demandBody(&mut store, &mut request, &id, b"pipedInvariant")
  let pipedStatic = run Semantic.demandBody(&mut store, &mut request, &id, b"pipedStatic")
  let parsedToTheEnd = run Semantic.demandBody(&mut store, &mut request, &id, b"parsedToTheEnd")
  run Testing.expect(hasBorrowStatus(&forward, BodyBorrowStatus.Checked), "an inferred static-first operand shortens to the actual caller lifetime")
  run Testing.expect(hasBorrowStatus(&reversed, BodyBorrowStatus.Checked), "reversing operands preserves the same lifetime validity")
  run Testing.expect(hasBorrowStatus(&callable, BodyBorrowStatus.Checked), "a quantified callable invocation finalizes only its own inferred region goals")
  run Testing.expect(hasBorrowStatus(&independent, BodyBorrowStatus.Checked), "two inferred binders at one call keep their distinct final caller regions")
  run Testing.expect(rejectsSpan(&fixedSection, RejectionCode.UnsatisfiedLifetimeBound, text, "next(value)", 0), "a section with an already fixed static contract does not reopen its binder")
  run Testing.expect(rejectsSpan(&escape, RejectionCode.UnsatisfiedLifetimeBound, text, "choose(b\"first\", value)", 1), "inference cannot extend a caller lifetime to static")
  run Testing.expect(rejectsSpan(&explicit, RejectionCode.UnsatisfiedLifetimeBound, text, "choose<'static>(b\"first\", value)", 0), "an explicit static application is not inferred evidence")
  run Testing.expect(rejectsSpan(&invariant, RejectionCode.UnsatisfiedLifetimeBound, text, "put(&mut target.*, value)", 0),
    "invariant stored lifetime evidence cannot shorten, so the call needs the caller lifetime to outlive 'static (SEM0212)")
  run Testing.expect(rejectsSpan(&owned, RejectionCode.UnsatisfiedLifetimeBound, text, "&data", 0), "body-owned storage cannot escape as static (SEM0212 at the borrow)")
  run Testing.expect(rejectsSpan(&captured, RejectionCode.UnsatisfiedLifetimeBound, text, "fn() -> u8 { return picked[0] }", 0), "an inferred result cannot escape through a static capture environment")
  // A section piped an Effect receives its operands before the receiver, so the static key fixes
  // the binder first; the shortened binder settles the operand's relation at once.
  run Testing.expect(hasBorrowStatus(&piped, BodyBorrowStatus.Checked) && hasBorrowStatus(&pipedKept, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&parsedToTheEnd, BodyBorrowStatus.Checked),
    "a piped section whose static key fixed its binder shortens to the later operand, under a conformance bound too")
  run Testing.expect(rejectsSpan(&pipedLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&held", 0),
    "a later local operand still cannot escape through the shortened result (SEM0212 at the borrow)")
  run Testing.expect(rejectsSpan(&pipedInvariant, RejectionCode.UnsatisfiedLifetimeBound, text, "begin(options) |> fieldMut(&mut key, value)", 0)
      && rejectsSpan(&pipedStatic, RejectionCode.UnsatisfiedLifetimeBound, text, "begin(options) |> fieldStatic(\"x\", value)", 0),
    "invariant static evidence and a 'static bound on the binder never shorten")
  return ()
}

// A borrow of a body local offered to a binder the call leaves at 'static never holds when a
// parameter, or a callable contract one names, stores that binder other than covariantly: its
// 'static is then forced by the argument there. Such a call is refused at the borrow (SEM0212), as
// the bootstrap refuses it, instead of leaving the body unchecked. A reborrow through a rigid
// static view keeps its open relation. Covariant inferred regions now shorten together while
// preserving either outlives direction.
test effect fn forcedStaticBindersRefuseLocalLoans() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run forcedStaticClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn forcedStaticClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("forced-static-binders.silk")
  let text = """
