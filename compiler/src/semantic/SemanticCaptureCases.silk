effect fn returnedExecutableBorrowClaims() -> ()
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let id = run module("returned-executable-borrows.silk")
  let text = """
struct Token { value: i32 }
effect fn inspect(values: &[i32]) -> i32 { return values[0] }
fn identity(values: &[i32]) -> &[i32] { return values }
fn read(amount: i32, values: &mut [i32]) -> i32 { return amount + values[0] }
fn directEffect() -> Effect<'static; i32> { let directValues = [21] return inspect(&directValues) }
fn boundEffect() -> Effect<'static; i32> { let boundValues = [21] let pending = inspect(&boundValues) return pending }
fn temporaryEffect() -> Effect<'static; i32> { let temporaryView = identity(&[1, 2]) return effect { return temporaryView[0] } }
fn localCallable() -> mut fn<'static>() -> i32 { let mut cell = 40 return fn() -> i32 { cell = cell + 1 return cell } }
fn localSection() -> mut fn<'static>(i32) -> i32 { let mut sectionValues = [0] return read(&mut sectionValues) }
fn callerEffect<'a>(values: &'a [i32]) -> Effect<'a; i32> { return inspect(values) }
fn callerSection<'a>(values: &'a mut [i32]) -> once fn<'a>(i32) -> i32 { return read(move values) }
fn ownedCallable() -> once fn<'static>() -> i32 {
  let token = Token { value: 42 }
  return fn() -> i32 { let owned = move token return owned.value }
}
fn ownedEffect() -> once Effect<'static; i32> {
  let token = Token { value: 42 }
  return effect { let owned = move token return owned.value }
}
fn externalMismatch<'a>(values: &'a [i32]) -> Effect<'static; i32> { return inspect(values) }
fn second<'a, 'b>(first: &'a [i32], kept: &'b [i32]) -> Effect<'b; i32> {
  drop first
  return inspect(kept)
}
fn keepsStatic(staticKept: &'static [i32]) -> Effect<'static; i32> {
  let localFirst = [1]
  return second(&localFirst, staticKept)
}
fn keepsSecondLocal() -> Effect<'static; i32> {
  let localFirst = [1]
  let localKept = [2]
  return second(&localFirst, &localKept)
}
fn both<'a, 'b>(first: &'a [i32], kept: &'b [i32]) -> Effect<'a & 'b; i32> {
  return effect { return first[0] + kept[0] }
}
fn keepsFirstLocal(staticKept: &'static [i32]) -> Effect<'static; i32> {
  let firstValues = [1]
  return both(&firstValues, staticKept)
}
fn keepsLastLocal(staticFirst: &'static [i32]) -> Effect<'static; i32> {
  let keptValues = [2]
  return both(staticFirst, &keptValues)
}
fn keepsBothLocal() -> Effect<'static; i32> {
  let firstBoth = [1]
  let keptBoth = [2]
  return both(&firstBoth, &keptBoth)
}
fn shortenedFirst<'a: 'b, 'b>(first: &'a [i32], kept: &'b [i32]) -> Effect<'b; i32> {
  drop kept
  return inspect(first)
}
fn keepsBoundFirst() -> Effect<'static; i32> {
  let firstBound = [1]
  let keptBound = [2]
  return shortenedFirst(&firstBound, &keptBound)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let directEffect = run Semantic.demandBody(&mut store, &mut request, &id, b"directEffect")
  let boundEffect = run Semantic.demandBody(&mut store, &mut request, &id, b"boundEffect")
  let temporaryEffect = run Semantic.demandBody(&mut store, &mut request, &id, b"temporaryEffect")
  let localCallable = run Semantic.demandBody(&mut store, &mut request, &id, b"localCallable")
  let localSection = run Semantic.demandBody(&mut store, &mut request, &id, b"localSection")
  let callerEffect = run Semantic.demandBody(&mut store, &mut request, &id, b"callerEffect")
  let callerSection = run Semantic.demandBody(&mut store, &mut request, &id, b"callerSection")
  let ownedCallable = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedCallable")
  let ownedEffect = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedEffect")
  let externalMismatch = run Semantic.demandBody(&mut store, &mut request, &id, b"externalMismatch")
  let staticKept = run Semantic.demandBody(&mut store, &mut request, &id, b"keepsStatic")
  let secondLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"keepsSecondLocal")
  let firstLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"keepsFirstLocal")
  let lastLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"keepsLastLocal")
  let bothLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"keepsBothLocal")
  let boundFirst = run Semantic.demandBody(&mut store, &mut request, &id, b"keepsBoundFirst")
  run Testing.expect(
    rejectsSpan(
      &directEffect,
      RejectionCode.ExecutableBorrowEscape,
      text,
      "&directValues",
      usize.ZERO
    )
      && rejectsSpan(
      &boundEffect,
      RejectionCode.ExecutableBorrowEscape,
      text,
      "&boundValues",
      usize.ZERO
    )
      && rejectsSpan(
      &temporaryEffect,
      RejectionCode.ExecutableBorrowEscape,
      text,
      "temporaryView",
      usize.ONE
    ),
    "OWN0018 reports direct, bound and temporary-view Effect captures at their borrowed source"
  )
  run Testing.expect(
    rejectsSpan(&localCallable, RejectionCode.ExecutableBorrowEscape, text, "cell", usize.ONE)
      && rejectsSpan(
      &localSection,
      RejectionCode.ExecutableBorrowEscape,
      text,
      "&mut sectionValues",
      usize.ZERO
    ),
    "OWN0018 reports anonymous callable and named-section captures at their local borrow"
  )
  run Testing.expect(
    succeeded(&callerEffect) && succeeded(&callerSection) && succeeded(&ownedCallable)
      && succeeded(&ownedEffect),
    "caller-owned loans and moved owned captures may outlive the creating invocation"
  )
  run Testing.expect(
    rejectsSpan(
      &externalMismatch,
      RejectionCode.ReturnTypeMismatch,
      text,
      "inspect(values)",
      usize.ONE
    ),
    "a caller lifetime that does not meet a static promise is not a borrow of function-owned storage"
  )
  run Testing.expect(
    succeeded(&staticKept),
    "an unretained local input does not escape through a helper's returned Effect (LIFE-004)"
  )
  run Testing.expect(
    rejectsSpan(&secondLocal, RejectionCode.ExecutableBorrowEscape, text, "&localKept", usize.ZERO),
    "OWN0018 identifies only the local argument retained by the helper's instantiated result"
  )
  run Testing.expect(
    rejectsSpan(&firstLocal, RejectionCode.ExecutableBorrowEscape, text, "&firstValues", usize.ZERO)
      && rejectsSpan(
      &lastLocal,
      RejectionCode.ExecutableBorrowEscape,
      text,
      "&keptValues",
      usize.ZERO
    )
      && rejectsSpan(
      &bothLocal,
      RejectionCode.ExecutableBorrowEscape,
      text,
      "&firstBoth",
      usize.ZERO
    ),
    "a result retaining both inputs rejects each local independently and reports the first primary when both are local"
  )
  run Testing.expect(
    rejectsSpan(&boundFirst, RejectionCode.ExecutableBorrowEscape, text, "&firstBound", usize.ZERO),
    "a declared outlives bound permits retaining the first input through the result's named second region"
  )
  return ()
}

test effect fn storedCallableAccessFollowsItsHolder() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run storedCallableAccessClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// The bootstrap's OWN0014 and OWN0015 (invoking a stored callable or running a stored Effect with
// more access than its holder grants) and OWN0018 (an executable value escaping a local borrow) map
// to these native rejections.
effect fn storedCallableAccessClaims() -> ()
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let id = run module("stored-callable-access.silk")
  let text = """
struct Stepper<'env, F: mut fn<'env>(i32) -> i32> { step: F }
struct Once<'env, F: once fn<'env>(i32) -> i32> { step: F }
struct Boxed<'env, F: once fn<'env>(i32) -> i32> { inner: Once<'env, F> }
struct Running<'env, F: mut Effect<'env; i32>> { operation: F }
struct Finishing<'env, F: once Effect<'env; i32>> { operation: F }
fn advance<'env, F: mut fn<'env>(i32) -> i32>(stepper: &Stepper<'env, F>) -> i32 { return stepper.step(1) }
fn takeShared<'env, F: once fn<'env>(i32) -> i32>(value: &Once<'env, F>) -> i32 { return value.step(1) }
fn takeNested<'env, F: once fn<'env>(i32) -> i32>(value: &Boxed<'env, F>) -> i32 { return value.inner.step(1) }
fn takeMatched<'env, F: once fn<'env>(i32) -> i32>(value: Boxed<'env, F>) -> i32 {
  return match &value { Boxed<'env, F> { inner } => inner.step(1) }
}
fn takeExclusive<'env, F: once fn<'env>(i32) -> i32>(exclusiveValue: &mut Once<'env, F>) -> i32 { return exclusiveValue.step(2) }
fn takeSlice<'env, F: once fn<'env>(i32) -> i32>(sliceValue: &[Once<'env, F>]) -> i32 { return sliceValue[0].step(3) }
fn takePattern<'env, F: once fn<'env>(i32) -> i32>(patternValue: Once<'env, F>) -> i32 {
  return match &patternValue { Once<'env, F> { step: patternStep } => patternStep(4) }
}
struct BareStored { step: once fn(i32) -> i32 }
fn takeBare(bareValue: &BareStored) -> i32 { return bareValue.step(5) }
fn ownedCallable<'env, F: once fn<'env>(i32) -> i32>(ownedValue: Once<'env, F>) -> i32 { return ownedValue.step(6) }
fn exclusiveCallable<'env, F: mut fn<'env>(i32) -> i32>(mutableValue: &mut Stepper<'env, F>) -> i32 { return mutableValue.step(7) }
fn directMutable<'env, F: mut fn<'env>(i32) -> i32>(directStep: F) -> i32 { return directStep(8) }
fn extractCallable<'env, F: once fn<'env>(i32) -> i32>(extractValue: &Once<'env, F>) -> F { return move extractValue.step }
fn ownedEffect<'env, F: once Effect<'env; i32>>(ownedRecipe: Finishing<'env, F>) -> i32 { return run ownedRecipe.operation }
fn exclusiveEffect<'env, F: mut Effect<'env; i32>>(mutableRecipe: &mut Running<'env, F>) -> i32 { return run mutableRecipe.operation }
fn runShared<'env, F: mut Effect<'env; i32>>(value: &Running<'env, F>) -> i32 { return run value.operation }
fn finishShared<'env, F: once Effect<'env; i32>>(value: &Finishing<'env, F>) -> i32 { return run value.operation }
fn finishExclusive<'env, F: once Effect<'env; i32>>(value: &mut Finishing<'env, F>) -> i32 { return run value.operation }
fn leak() -> mut fn<'static>() -> i32 {
  let mut cell = 40
  return fn() -> i32 {
    cell = cell + 1
    return cell
  }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let advance = run Semantic.demandBody(&mut store, &mut request, &id, b"advance")
  let takeShared = run Semantic.demandBody(&mut store, &mut request, &id, b"takeShared")
  let takeNested = run Semantic.demandBody(&mut store, &mut request, &id, b"takeNested")
  let takeMatched = run Semantic.demandBody(&mut store, &mut request, &id, b"takeMatched")
  run Testing.expect(
    rejectsSpan(
      &advance,
      RejectionCode.StoredCallableInvocationAccess,
      text,
      "stepper.step(1)",
      usize.ZERO
    )
      && rejectsSpan(
      &takeShared,
      RejectionCode.StoredCallableInvocationAccess,
      text,
      "value.step(1)",
      usize.ZERO
    )
      && rejectsSpan(
      &takeNested,
      RejectionCode.StoredCallableInvocationAccess,
      text,
      "value.inner.step(1)",
      usize.ZERO
    )
      && rejectsSpan(
      &takeMatched,
      RejectionCode.StoredCallableInvocationAccess,
      text,
      "inner.step(1)",
      usize.ONE
    ),
    "a stored callable is invoked only with the access its holder grants (bootstrap OWN0014)"
  )
  let runShared = run Semantic.demandBody(&mut store, &mut request, &id, b"runShared")
  let finishShared = run Semantic.demandBody(&mut store, &mut request, &id, b"finishShared")
  let finishExclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"finishExclusive")
  run Testing.expect(
    rejectsSpan(
      &runShared,
      RejectionCode.StoredEffectRunAccess,
      text,
      "run value.operation",
      usize.ZERO
    )
      && rejectsSpan(
      &finishShared,
      RejectionCode.StoredEffectRunAccess,
      text,
      "run value.operation",
      usize.ONE
    )
      && rejectsSpan(
      &finishExclusive,
      RejectionCode.StoredEffectRunAccess,
      text,
      "run value.operation",
      2
    ),
    "a stored Effect runs only with the access its holder grants (bootstrap OWN0015)"
  )
  let takeExclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"takeExclusive")
  let takeSlice = run Semantic.demandBody(&mut store, &mut request, &id, b"takeSlice")
  let takePattern = run Semantic.demandBody(&mut store, &mut request, &id, b"takePattern")
  let takeBare = run Semantic.demandBody(&mut store, &mut request, &id, b"takeBare")
  let ownedCallable = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedCallable")
  let exclusiveCallable = run Semantic.demandBody(
    &mut store,
    &mut request,
    &id,
    b"exclusiveCallable"
  )
  let directMutable = run Semantic.demandBody(&mut store, &mut request, &id, b"directMutable")
  let extractCallable = run Semantic.demandBody(&mut store, &mut request, &id, b"extractCallable")
  let ownedEffect = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedEffect")
  let exclusiveEffect = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusiveEffect")
  run Testing.expect(
    rejectsSpan(
      &takeExclusive,
      RejectionCode.StoredCallableInvocationAccess,
      text,
      "exclusiveValue.step(2)",
      usize.ZERO
    )
      && rejectsSpan(
      &takeSlice,
      RejectionCode.StoredCallableInvocationAccess,
      text,
      "sliceValue[0].step(3)",
      usize.ZERO
    )
      && rejectsSpan(
      &takePattern,
      RejectionCode.StoredCallableInvocationAccess,
      text,
      "patternStep(4)",
      usize.ZERO
    )
      && rejectsSpan(
      &takeBare,
      RejectionCode.StoredCallableInvocationAccess,
      text,
      "bareValue.step(5)",
      usize.ZERO
    ),
    "OWN0014 keeps aggregate access through exclusive borrows, slices, direct pattern fields and bare contracts"
  )
  run Testing.expect(
    succeeded(&ownedCallable) && succeeded(&exclusiveCallable) && succeeded(&ownedEffect)
      && succeeded(&exclusiveEffect),
    "whole-owner and exclusive aggregate receivers retain their legal callable and Effect access"
  )
  run Testing.expect(
    rejectsSpan(
      &directMutable,
      RejectionCode.InvalidCallableInvocationAccess,
      text,
      "directStep",
      usize.ONE
    ),
    "direct callable bindings keep their SEM0077 access diagnostic"
  )
  run Testing.expect(
    rejectsSpan(
      &extractCallable,
      RejectionCode.ExtractionBoundary,
      text,
      "move extractValue.step",
      usize.ZERO
    ),
    "explicit extraction keeps OWN0002 independently of stored invocation access"
  )
  let leak = run Semantic.demandBody(&mut store, &mut request, &id, b"leak")
  run Testing.expect(
    rejectsSpan(&leak, RejectionCode.ExecutableBorrowEscape, text, "cell", usize.ONE),
    "an executable value cannot outlive the local it borrows (bootstrap OWN0018)"
  )
}

test effect fn namedOnceSectionsTransferAndCleanOwnedCaptures() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run onceSectionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn sectionEnvironmentCleanupOnExit(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Return {..} = &blocks[at].terminator {
          if sectionExitDrops(Vector<MirStatement>.asSlice(&blocks[at].statements), Vector<MirLocal>.asSlice(&function.locals)) { return true }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn sectionExitDrops(statements: &[MirStatement], locals: &[MirLocal]) -> bool {
  let mut returnsNine = false
  let mut dropsEnvironment = false
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Assign {destination, value: MirRvalue.Use {value: MirOperand.Integer {decimal, negative, ..}}, ..} = &statements[at] {
      let digits = Bytes.asSlice(&decimal)
      if destination.local == usize.ZERO && Vector<MirProjection>.length(&destination.projections) == usize.ZERO
        && !negative && digits.length == usize.ONE && digits[usize.ZERO] == 57 { returnsNine = true }
    }
    if let MirStatement.Drop {destination, ..} = &statements[at] {
      if Vector<MirProjection>.length(&destination.projections) == usize.ZERO {
        if Shared<Type>.with<bool>(&locals[destination.local].ty, fn(value: &Type) -> bool {
          return match &value.* { Type.CallableValue {..} => true _ => false }
        }) { dropsEnvironment = true }
      }
    }
    at = at + usize.ONE
  }
  return returnsNine && dropsEnvironment
}

effect fn onceSectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("once-section.silk")
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn take(amount: i32, token: Token) -> i32 { return amount + token.value }
fn main(token: Token, choice: i32) -> i32 {
  let takeStep = take(move token)
  return takeStep(match choice { 0 => { return 9 } _ => 2 })
}
fn repeated(token: Token) -> i32 {
  let singleStep = take(move token)
  let first = singleStep(1)
  return first + singleStep(2)
}
fn constructionOnly(spentToken: Token) -> () { let removed = move spentToken let invalid = take(move spentToken) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let target = run Semantic.demandMir(&mut store, &mut request, &id, b"take")
  let repeated = run Semantic.demandBody(&mut store, &mut request, &id, b"repeated")
  let construction = run Semantic.demandBody(&mut store, &mut request, &id, b"constructionOnly")
  run Testing.expect(succeeded(&caller) && succeeded(&target)
    && sectionInvocationCount(&store, &caller, b"take", true) == usize.ONE
    && glueFact(&store, &caller, usize.ZERO) == usize.ONE && sectionEnvironmentCleanupOnExit(&store, &caller)
    && glueFact(&store, &target, usize.ZERO) == usize.ONE,
    "once sections transfer their field on the call edge and drop their pending environment only on argument exit")
  run Testing.expect(rejectsSpan(&repeated, RejectionCode.UseAfterMove, text, "singleStep", 2),
    "a second once-section call rejects its consumed callee (OWN0001)")
  run Testing.expect(rejectsSpan(&construction, RejectionCode.UseAfterMove, text, "move spentToken", usize.ONE),
    "a construction-only section rejects an already moved argument (OWN0001)")
}

fn stagedNamedArguments(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          let original = Shared<DeclarationId>.with<bool>(&identity,
            fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"combine") })
          let operands = Vector<MirOperand>.asSlice(&arguments)
          if original && operands.length == 3 {
            return sectionStoredField(&operands[usize.ONE], usize.ONE)
              && sectionStoredField(&operands[2], usize.ZERO)
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

test effect fn stagedNamedSectionsFlattenCaptureOrder() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run stagedNamedClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn stagedNamedClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("staged-named-section.silk")
  let text = """
fn combine(first: i32, second: i32, third: i32) -> i32 { return first * 100 + second * 10 + third }
fn main() -> i32 { let firstStage = combine(3) let secondStage = firstStage(2) return secondStage(1) }
fn nestedApplication() -> i32 { return combine(3)(2)(1) }
fn emptyApplication() -> () { let emptyStep = combine(3) let invalid = emptyStep() }
fn excessiveApplication() -> () { let excessStep = combine(3) let invalid = excessStep(1, 2, 3) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let nested = run Semantic.demandMir(&mut store, &mut request, &id, b"nestedApplication")
  let empty = run Semantic.demandBody(&mut store, &mut request, &id, b"emptyApplication")
  let excess = run Semantic.demandBody(&mut store, &mut request, &id, b"excessiveApplication")
  run Testing.expect(succeeded(&answer) && stagedNamedArguments(&store, &answer),
    "staged fields retain capture order while the original direct call appends them in parameter order")
  run Testing.expect(succeeded(&nested) && stagedNamedArguments(&store, &nested),
    "nested callable expressions retain inner target discovery and lower the same direct original call with ordered suffix fields")
  run Testing.expect(rejectsSpan(&empty, RejectionCode.CallArity, text, "emptyStep()", usize.ZERO)
    && rejectsSpan(&excess, RejectionCode.CallArity, text, "excessStep(1, 2, 3)", usize.ZERO),
    "empty and excessive applications reject the full callable application (SEM0007)")
}

test effect fn enclosingOwnerSectionsRetainTheirClosedParameterTypes() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run enclosingOwnerSectionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn enclosingOwnerSectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("enclosing-owner-section.silk")
  let text = """
struct Box<T> { value: T }
impl<T> Box<T> {
  fn select(self: Self, fallback: T) -> T { drop fallback return move self.value }
  fn pick<T: Intrinsic.Copy>(self: &Self, index: usize) -> T { return self.value }
}
union Choice<T> { Present { value: T }, Absent }
impl<T> Choice<T> {
  fn present(value: T) -> Choice<T> { return Choice<T>.Present { value: move value } }
  fn absent() -> Choice<T> { return Choice<T>.Absent }
}
fn checked<R>(value: u8, present: once fn(u8) -> R, absent: once fn() -> R) -> R { drop absent return present(value) }
fn stored() -> i32 { let selected = Box.select(0) return selected(Box {value: 42}) }
fn piped() -> i32 { return Box {value: 42} |> Box.select(0) }
fn borrowed() -> i32 { let boxed = Box {value: 42} return &boxed |> Box<i32>.pick(1) }
fn carriers() -> Choice<u8> { return checked<Choice<u8>>(7, Choice.present, Choice.absent) }
fn unapplied() -> () { let bare = Choice.present }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let stored = run Semantic.demandMir(&mut store, &mut request, &id, b"stored")
  let piped = run Semantic.demandMir(&mut store, &mut request, &id, b"piped")
  run Testing.expect(succeeded(&stored) && sectionInvocationCount(&store, &stored, b"select", false) == usize.ONE,
    "a closed section substitutes enclosing impl evidence into its stored leading parameter and calls the original target")
  run Testing.expect(succeeded(&piped) && sectionInvocationCount(&store, &piped, b"select", false) == usize.ONE,
    "pipeline application uses the same closed leading parameter without retaining a raw enclosing owner binder")
  let borrowed = run Semantic.demandMir(&mut store, &mut request, &id, b"borrowed")
  let picked = match move namedMirApplication(&store, &borrowed, b"pick") {
    Option<Shared<SpecializationApplication>>.Some {value} => Shared<SpecializationApplication>.with<bool>(&value,
      fn(application: &SpecializationApplication) -> bool { return implScopeApplication(application, b"i32") })
    Option<Shared<SpecializationApplication>>.None => false
  }
  run Testing.expect(succeeded(&borrowed) && sectionInvocationCount(&store, &borrowed, b"pick", false) == usize.ONE && picked,
    "a deferred section over an impl member keeps the written impl argument as selected evidence and lets the piped borrow supply its own lifetime")
  let carriers = run Semantic.demandBody(&mut store, &mut request, &id, b"carriers")
  run Testing.expect(succeeded(&carriers) && implScopedValues(&carriers, b"u8") == 3,
    "generic impl members used as values take their impl binder from the promised parameter and result of the callable contract")
  let unapplied = run Semantic.demandBody(&mut store, &mut request, &id, b"unapplied")
  run Testing.expect(rejectsSpan(&unapplied, RejectionCode.Unsupported, text, "Choice.present", usize.ONE),
    "without a contract an impl member value would defer its impl binder, which a section schema does not represent")
}

// Whether an application binds exactly one enclosing impl slot, to the named primitive.
fn implScopeApplication(value: &SpecializationApplication, primitive: &[u8]) -> bool {
  let scopes = Vector<ScopeBinding>.asSlice(&value.scopes)
  if scopes.length != usize.ONE { return false }
  let arguments = Vector<Argument>.asSlice(&scopes[usize.ZERO].arguments)
  return arguments.length == usize.ONE && applicationArgumentIs(&arguments[usize.ZERO], primitive)
}

// The closed `present` (1) and `absent` (2) callable values whose own application is empty and
// whose one impl slot is the primitive, as a set of flags.
fn implScopedValues(answer: &Shared<Result<Answer, NoRejection>>, primitive: &[u8]) -> usize {
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared<TypedBody>.with<usize>(&value, fn(checked: &TypedBody) -> usize {
      return implScopedFlags(TypedBody.nodeSlice(checked), primitive)
    })
  }
  return usize.ZERO
}

fn implScopedFlags(nodes: &[BodyNode], primitive: &[u8]) -> usize {
  let mut present = false
  let mut absent = false
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, ..} = &nodes[at].kind {
      if Shared<Type>.with<bool>(&ty, fn(found: &Type) -> bool { return implScopedValue(found, b"present", primitive) }) {
        present = true
      }
      if Shared<Type>.with<bool>(&ty, fn(found: &Type) -> bool { return implScopedValue(found, b"absent", primitive) }) {
        absent = true
      }
    }
    at = at + usize.ONE
  }
  let mut flags = usize.ZERO
  if present { flags = flags + usize.ONE }
  if absent { flags = flags + 2 }
  return flags
}

fn implScopedValue(value: &Type, target: &[u8], primitive: &[u8]) -> bool {
  if let Type.CallableValue {application, ..} = &value.* {
    return Shared<SpecializationApplication>.with<bool>(&application, fn(selected: &SpecializationApplication) -> bool {
      return DeclarationId.named(SpecializationApplication.bodyDeclaration(selected), target)
        && Vector<Argument>.length(&selected.arguments) == usize.ZERO && implScopeApplication(selected, primitive)
    })
  }
  return false
}

fn stagedMutableStorage(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let mut at = usize.ZERO
      while at < blocks.length {
        if stagedMutableRef(Vector<MirStatement>.asSlice(&blocks[at].statements), locals) { return true }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn stagedMutableRef(statements: &[MirStatement], locals: &[MirLocal]) -> bool {
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Assign {value: MirRvalue.Ref {access, place}, ..} = &statements[at] {
      if access == Access.Mutable && Vector<MirProjection>.length(&place.projections) == usize.ONE {
        if let MirProjection.Field {index} = &Vector<MirProjection>.asSlice(&place.projections)[usize.ZERO] {
          if let MirLocalKind.User {index: original} = &locals[place.local].kind {
            if index == usize.ZERO && original == 2 { return true }
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn stagedSharedSectionsLendOriginalEnvironment() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
