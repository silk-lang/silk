effect fn sourceAvailabilityClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("source-availability.silk")
  let text = """
fn identity<'a>(value: &'a i32) -> &'a i32 { return value }
fn scoped<'a>(value: &'a i32, branch: bool) -> &'a i32 {
  if branch {
    let descriptor = value
    return identity(&descriptor.*)
  }
  return identity(&value.*)
}
fn descriptorDrop<'a>(value: &'a mut i32) -> &'a i32 {
  let descriptor = &mut value.*
  let view = identity(&descriptor.*)
  drop descriptor
  return view
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let scoped = run Semantic.demandBody(&mut store, &mut request, &id, b"scoped")
  let dropped = run Semantic.demandBody(&mut store, &mut request, &id, b"descriptorDrop")
  run Testing.expect(hasBorrowStatus(&scoped, BodyBorrowStatus.Checked),
    "ending a branch-local descriptor does not end the caller-owned storage it referenced")
  run Testing.expect(hasBorrowStatus(&dropped, BodyBorrowStatus.Imprecise),
    "a source-validity witness does not bypass the Walker's unresolved descriptor-drop conflict")
  return ()
}


