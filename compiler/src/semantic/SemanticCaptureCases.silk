fn accessShared<T, A>(core: &Intrinsic.SharedCore<T>, use: once fn(&mut T) -> A, conflict: once fn() -> A) -> A {
  return Intrinsic.sharedWithMut<T, A>(core, move use, move conflict)
}
fn reuseCallback(core: &Intrinsic.SharedCore<i32>, use: once fn(&mut i32) -> i32, conflict: once fn() -> i32,
  again: once fn() -> i32) -> i32 {
