  let rowRunsUniversal = run Semantic.demandBody(&mut store, &mut request, &id, b"rowRunsUniversal")
  let rowReturnsUniversal = run Semantic.demandBody(&mut store, &mut request, &id, b"rowReturnsUniversal")
  let rowRunsBefore = run Semantic.demandBody(&mut store, &mut request, &id, b"rowRunsBefore")
  run Testing.expect(rejectsSpan(&rowRunsUniversal, RejectionCode.AccessDuringLoan, text, "srcR1.t", 1),
