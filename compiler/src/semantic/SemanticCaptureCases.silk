}

effect fn anonymousViewClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("capture-views.silk")
  let text = """
fn readView<'a>(view: &'a i32) -> () {
  let closure = fn() -> i32 { return view.* }
}
fn moveView<'a>(view: &'a i32) -> () {
  let closure = fn() -> &'a i32 { return move view }
}
fn dropView<'a>(view: &'a i32) -> () {
  let closure = fn() -> () { drop view }
}
fn invoke(value: i32) -> i32 {
  let closure = fn(addend: i32) -> i32 { return value + addend }
  return closure(2)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let readView = run Semantic.demandBody(&mut store, &mut request, &id, b"readView")
  let moveView = run Semantic.demandBody(&mut store, &mut request, &id, b"moveView")
  let dropView = run Semantic.demandBody(&mut store, &mut request, &id, b"dropView")
  let invoked = run Semantic.demandBody(&mut store, &mut request, &id, b"invoke")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&readView, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Shared, usize.ZERO, usize.MAX, usize.ONE, false)
  }) && Shared.with<Result<Answer, NoRejection>, bool>(&moveView, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Once, usize.ZERO, usize.MAX, usize.ONE, false)
  }) && Shared.with<Result<Answer, NoRejection>, bool>(&dropView, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Shared, usize.ZERO, usize.MAX, usize.ONE, false)
  }), "view descriptors retain source validity while explicit move alone requires once invocation")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&readView,
    fn(answer: &Result<Answer, NoRejection>) -> bool { return anonymousRegionFacts(answer, usize.ONE) }) &&
    Shared.with<Result<Answer, NoRejection>, bool>(&dropView,
    fn(answer: &Result<Answer, NoRejection>) -> bool { return anonymousRegionFacts(answer, usize.ONE) }),
    "capture fields and the callable environment both retain the source parameter lifetime")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&invoked, anonymousInvocationFacts),
    "a stored closure call retains its exact receiver and invocation mode")
}

