effect fn crossedUniversalReborrowClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("crossed-universal-reborrows.silk")
  let text = """
fn direct<'a>(value: &'a i32) -> &'a i32 { return &value.* }
fn held<'a>(value: &'a i32) -> &'a i32 {
  let view: &'a i32 = &value.*
  return view
}
fn mutable<'a>(value: &'a mut i32) -> &'a mut i32 { return &mut value.* }
fn slice<'a>(values: &'a [i32]) -> &'a [i32] { return &values }
fn joined<'a>(left: &'a i32, right: &'a i32, first: bool) -> &'a i32 {
  if first { return &left.* }
  return &right.*
}
struct Pair { left: i32, right: i32 }
fn projected<'a>(value: &'a Pair) -> &'a i32 { return &value.left }
struct Referenced<'a> { value: &'a i32 }
fn inner<'outer, 'inner>(holder: &'outer Referenced<'inner>) -> &'inner i32 {
  return &holder.value.*
}
fn different<'outer, 'inner>(holder: &'outer Referenced<'inner>) -> &'outer i32 {
  return &holder.value.*
}
fn forward<'a>(value: &'a i32) -> &'a i32 { return value }
fn unrelatedInner<'outer, 'inner, 'target>(holder: &'outer Referenced<'inner>) -> &'target i32 {
  let view = &holder.value.*
  return forward<'target>(&view.*)
}
fn shorten<'a, 'b: 'a>(value: &'b i32) -> &'a i32 { return &value.* }
fn widen<'a, 'b>(unrelated: &'b i32) -> &'a i32 { return &unrelated.* }
fn owned<'a>() -> &'a i32 { let local = 1 return &local }
fn slot<'a>(descriptor: &'a i32) -> &'a &'a i32 { return &descriptor }
fn conflict<'a>(exclusive: &'a mut i32) -> &'a i32 {
  let view: &'a i32 = &exclusive.*
  exclusive.* = 1
  return view
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let direct = run Semantic.demandBody(&mut store, &mut request, &id, b"direct")
  let held = run Semantic.demandBody(&mut store, &mut request, &id, b"held")
  let mutable = run Semantic.demandBody(&mut store, &mut request, &id, b"mutable")
  let slice = run Semantic.demandBody(&mut store, &mut request, &id, b"slice")
  let joined = run Semantic.demandBody(&mut store, &mut request, &id, b"joined")
  let projected = run Semantic.demandBody(&mut store, &mut request, &id, b"projected")
  let inner = run Semantic.demandBody(&mut store, &mut request, &id, b"inner")
  let different = run Semantic.demandBody(&mut store, &mut request, &id, b"different")
  let unrelatedInner = run Semantic.demandBody(&mut store, &mut request, &id, b"unrelatedInner")
  let shorten = run Semantic.demandBody(&mut store, &mut request, &id, b"shorten")
  let widen = run Semantic.demandBody(&mut store, &mut request, &id, b"widen")
  let owned = run Semantic.demandBody(&mut store, &mut request, &id, b"owned")
  let slot = run Semantic.demandBody(&mut store, &mut request, &id, b"slot")
  let conflict = run Semantic.demandBody(&mut store, &mut request, &id, b"conflict")
  run Testing.expect(hasBorrowStatus(&direct, BodyBorrowStatus.Checked),
    "a returned reborrow keeps the exact universal lifetime of its parent descriptor")
  run Testing.expect(hasBorrowStatus(&held, BodyBorrowStatus.Checked),
    "storing the reborrow in a local keeps its authenticated parent lifetime")
  run Testing.expect(hasBorrowStatus(&mutable, BodyBorrowStatus.Checked),
    "an exclusive reborrow keeps its parent lifetime without extending validity")
  run Testing.expect(hasBorrowStatus(&slice, BodyBorrowStatus.Checked),
    "a slice reborrow borrows backing storage under its descriptor's same lifetime")
  run Testing.expect(hasBorrowStatus(&joined, BodyBorrowStatus.Checked),
    "each returning branch authenticates its own parent reference")
  run Testing.expect(hasBorrowStatus(&projected, BodyBorrowStatus.Checked),
    "a projected field uses the reference that reaches its storage")
  run Testing.expect(hasBorrowStatus(&inner, BodyBorrowStatus.Checked),
    "a nested dereference uses the inner descriptor's lifetime rather than the outer holder's")
  run Testing.expect(hasBorrowStatus(&different, BodyBorrowStatus.Checked),
    "the input's implied well-formedness premise bounds its inner reference by the outer lifetime")
  run Testing.expect(hasBorrowStatus(&unrelatedInner, BodyBorrowStatus.Regions),
    "an input's implied inner-to-outer bound does not relate a third universal lifetime")
  run Testing.expect(hasBorrowStatus(&shorten, BodyBorrowStatus.Checked),
    "the declared parent bound proves a direct reborrow shortened to another universal")
  run Testing.expect(rejectsSpan(&widen, RejectionCode.UnsatisfiedLifetimeBound, text, "&unrelated.*", usize.ZERO),
    "a parent lifetime cannot be widened to an unrelated universal")
  run Testing.expect(rejectsSpan(&owned, RejectionCode.ExpiredLifetime, text, "&local", usize.ZERO),
    "body-owned storage cannot supply a universal return lifetime (OWN0019)")
  run Testing.expect(rejectsSpan(&slot, RejectionCode.ReturnTypeMismatch, text, "&descriptor", usize.ZERO),
    "a reference to the descriptor slot borrows local storage despite its inner universal lifetime")
  run Testing.expect(rejectsSpan(&conflict, RejectionCode.AccessDuringLoan, text, "exclusive", 2),
    "the boundary proof does not bypass a live-loan write conflict (OWN0011)")
  return ()
}

