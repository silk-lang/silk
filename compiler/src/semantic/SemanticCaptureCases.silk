effect fn finiteCapturedContentsClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("finite-captured-contents.silk")
  let text = """
fn local<T>(value: T) -> i32 {
  let take = fn() -> i32 { drop move value return 1 }
  return take()
}
fn invoke(take: once fn() -> i32) -> i32 { return take() }
fn inline<T>(value: T) -> i32 {
  return invoke(fn() -> i32 { drop move value return 2 })
}
fn effectful<T>(value: T) -> i32 {
  let take = effect fn() -> i32 { drop move value return 3 }
  drop move take
  return 4
}
fn promised<T: 'static>(value: T) -> once fn<'static>() -> T {
  return fn() -> T { return move value }
}
fn requireStatic<T: 'static>(value: T) -> i32 { drop move value return 5 }
fn unbounded<T>(value: T) -> i32 {
  let take = fn() -> i32 { return requireStatic<T>(move value) }
  return take()
}
fn conflict<T>(value: T) -> i32 {
  let mut owner = 1
  let view = &owner
  let take = fn() -> i32 { drop move value return view.* }
  owner = 2
  return take()
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let local = run Semantic.demandBody(&mut store, &mut request, &id, b"local")
  run Testing.expect(hasBorrowStatus(&local, BodyBorrowStatus.Checked), "a let-bound generic callable retains its owned value only for finite use")
  let inline = run Semantic.demandBody(&mut store, &mut request, &id, b"inline")
  run Testing.expect(hasBorrowStatus(&inline, BodyBorrowStatus.Checked), "an inline generic callable has the same finite contents rule")
  let effectful = run Semantic.demandBody(&mut store, &mut request, &id, b"effectful")
  run Testing.expect(hasBorrowStatus(&effectful, BodyBorrowStatus.Checked), "a generic effectful callable keeps finite captured contents")
  let promised = run Semantic.demandBody(&mut store, &mut request, &id, b"promised")
  run Testing.expect(hasBorrowStatus(&promised, BodyBorrowStatus.Checked), "an explicit T:static premise still permits the static environment")
  let unbounded = run Semantic.demandBody(&mut store, &mut request, &id, b"unbounded")
  run Testing.expect(rejectsSpan(&unbounded, RejectionCode.Unsupported, text, "requireStatic<T>(move value)", usize.ZERO),
    "finite capture contents cannot justify a T:static requirement")
  let conflict = run Semantic.demandBody(&mut store, &mut request, &id, b"conflict")
  run Testing.expect(rejectsSpan(&conflict, RejectionCode.AccessDuringLoan, text, "owner", 2),
    "proving generic contents cannot release a concrete captured alias loan")
  return ()
}

test effect fn innerResultsReleaseOnlyProvedDescriptorBorrows() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
