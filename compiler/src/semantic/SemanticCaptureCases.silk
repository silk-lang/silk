effect fn stagedAnonymousClaims(text: string, mode: CallableMode) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("staged-anonymous.silk")
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller) && stagedAnonymousArguments(&store, &caller, mode),
    "the staged direct literal call keeps its original environment mode and appends its suffix field")
  if mode == CallableMode.Mutable {
    let reused = run Semantic.demandBody(&mut store, &mut request, &id, b"reusedMutable")
    run Testing.expect(stagedMutableStorage(&store, &caller), "mutable staging borrows the stored nested environment rather than a copied snapshot")
    run Testing.expect(rejectsSpan(&reused, RejectionCode.UseAfterMove, text, "transferred", 2),
      "staging transfers an exclusive old callable even when the new callable remains exclusive (OWN0001)")
  }
  if mode == CallableMode.Once {
    run Testing.expect(glueFact(&store, &caller, usize.ZERO) == usize.ZERO,
      "once staging transfers its nested environment without retaining caller cleanup")
  }
}

fn stagedExitOwners(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Return {..} = &blocks[at].terminator {
          let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
          if sectionExitDrops(statements, locals) && stagedExitDropCount(statements) == 2 { return true }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn stagedExitDropCount(statements: &[MirStatement]) -> usize {
  let mut count = usize.ZERO
  let mut first = usize.MAX
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Drop {destination, ..} = &statements[at] {
      if Vector<MirProjection>.length(&destination.projections) == usize.ZERO && destination.local != first {
        if first == usize.MAX { first = destination.local }
        count = count + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return count
}

