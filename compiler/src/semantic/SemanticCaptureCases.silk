// The instance key of the first call in a MIR function, absent without one.
fn firstCallTarget(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> Option<Shared<DeclarationId>> {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &blocks[at].terminator {
          return Option.some<Shared<DeclarationId>>(InstanceKey.identity(&key))
        }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<Shared<DeclarationId>>()
}

// Whether any call in a MIR function targets an instance of a declaration named `name`.
fn callsTarget(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, name: string) -> bool {
  return callCount(store, answer, name) > usize.ZERO
}

// How many calls in a MIR function target an instance of a declaration named `name`.
fn callCount(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, name: string) -> usize {
  let mut count = usize.ZERO
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          if Shared.with<DeclarationId, bool>(&identity, fn(value: &DeclarationId) -> bool {
            return DeclarationId.named(value, String.utf8Bytes(name))
          }) { count = count + usize.ONE }
        }
        at = at + usize.ONE
      }
    }
  }
  return count
}

fn callsNamed(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, name: string) -> bool {
  let target = firstCallTarget(store, answer)
  if let Option<Shared<DeclarationId>>.Some {value} = move target {
    return Shared.with<DeclarationId, bool>(&value, fn(identity: &DeclarationId) -> bool {
      return DeclarationId.named(identity, String.utf8Bytes(name))
    })
  }
  return false
}

test effect fn storedEffectsRunThroughTheirConstructionRunner() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("stored-effects.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Problem { code: i32 }
effect fn add(a: i32, b: i32) -> i32 { return a + b }
effect fn check(value: i32) -> i32 ! Problem {
  if value > 100 { fail Problem { code: value } }
  return value
}
effect fn runner<A, E>(self: once Effect<A ! E>) -> A ! E { return run move self }
fn stored() -> i32 {
  let pending = add(40, 2)
  return run pending
}
fn generic() -> i32 { return run runner(add(1, 2)) }
effect fn forwarded(value: i32) -> i32 ! Problem { return run runner(check(value)) }
fn plus(value: i32) -> i32 { return value + 1 }
fn apply(f: fn(i32) -> i32, value: i32) -> i32 { return f(value) }
fn named() -> i32 { return apply(plus, 1) }
fn foreign() -> i32 { return apply(abs, 1) }
extern "C" fn abs(value: i32) -> i32
fn pass<T>(value: T) -> T { return value }
fn passed() -> i32 { return run pass(add(1, 2)) }
fn invoked() -> i32 {
  let f = add
  return run f(1, 2)
}
struct Token { value: i32 }
effect fn bump(count: &mut i32) -> i32 { return 1 }
fn exclusive() -> i32 {
  let mut count = 1
  let pendingBump = bump(&mut count)
  return run pendingBump
}
effect fn spend(token: Token) -> i32 { return token.value }
effect fn shared(self: Effect<i32>) -> i32 { return run self }
fn incompatible() -> i32 { return run shared(spend(Token { value: 1 })) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let stored = run Semantic.demandMir(&mut store, &mut request, &id, b"stored") |> Effect.provideMut<Allocator>(&mut allocator)
  let generic = run Semantic.demandMir(&mut store, &mut request, &id, b"generic") |> Effect.provideMut<Allocator>(&mut allocator)
  let forwarded = run Semantic.demandMir(&mut store, &mut request, &id, b"forwarded") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(callsNamed(&store, &stored, "add") && failureFact(&store, &stored, 2) == usize.ZERO,
    "a stored construction runs as a direct call of its effect fn with its stored arguments")
  run Testing.expect(callsNamed(&store, &generic, "runner") && callsNamed(&store, &forwarded, "runner") &&
    failureFact(&store, &forwarded, 2) == usize.ONE,
    "an Effect parameter specializes to the argument's exact representation and keeps its failure edge")
  let named = run Semantic.demandMir(&mut store, &mut request, &id, b"named") |> Effect.provideMut<Allocator>(&mut allocator)
  let foreign = run Semantic.demandBody(&mut store, &mut request, &id, b"foreign") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(callsNamed(&store, &named, "apply") && rejectsSpan(&foreign, RejectionCode.ForeignFunctionNotFirstClass, text, "abs", 0),
    "a named function value is a capture-free exact callable, and a C function has none")
  let passed = run Semantic.demandMir(&mut store, &mut request, &id, b"passed") |> Effect.provideMut<Allocator>(&mut allocator)
  let invoked = run Semantic.demandMir(&mut store, &mut request, &id, b"invoked") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(callsTarget(&store, &passed, "pass") && callsTarget(&store, &passed, "add"),
    "an ordinary call returning an Effect is not the run: its result runs through the construction's runner")
  run Testing.expect(callsTarget(&store, &invoked, "add"), "running an invoked effect fn value calls the target instance")
  let exclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusive") |> Effect.provideMut<Allocator>(&mut allocator)
  let incompatible = run Semantic.demandBody(&mut store, &mut request, &id, b"incompatible") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&exclusive, RejectionCode.InvalidCallableInvocationAccess, text, "pendingBump", 1),
    "an exclusive Effect runs only from a mutable place")
  run Testing.expect(rejectsSpan(&incompatible, RejectionCode.TypeArgumentInference, text, "shared(spend(Token { value: 1 }))", 0),
    "a once Effect does not satisfy a shared Effect parameter")
  return ()
}

test effect fn catchFailureExpandsAtItsRunSite() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("catch-failure.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Selected { code: i32 }
struct Residual { code: i32 }
effect fn risky(mode: i32) -> i32 ! Selected | Residual {
  if mode == 0 { return 10 }
  if mode == 1 { fail Selected { code: 10 } }
  fail Residual { code: 16 }
}
effect fn recoverSelected(problem: Selected) -> i32 { return problem.code + 4 }
effect fn selective(mode: i32) -> i32 ! Residual { return run Intrinsic.catchFailure<Selected>(risky(mode), recoverSelected) }
effect fn wrongHandler(mode: i32) -> i32 ! Residual { return run Intrinsic.catchFailure<Residual>(risky(mode), recoverSelected) }
effect fn recoverAny(problem: Selected | Residual) -> i32 { return 0 }
effect fn whole(mode: i32) -> i32 { return run Intrinsic.catchFailure<Selected | Residual>(risky(mode), recoverAny) }
effect fn lone() -> i32 ! Selected { fail Selected { code: 1 } }
effect fn recoverWide(problem: Selected) -> i64 { return 2 }
effect fn widened() -> i32 | i64 { return run Intrinsic.catchFailure<Selected>(lone(), recoverWide) }
effect fn escalate(problem: Selected) -> i32 ! Residual { fail Residual { code: problem.code } }
effect fn rethrows() -> i32 ! Residual { return run Intrinsic.catchFailure<Selected>(lone(), escalate) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let selective = run Semantic.demandMir(&mut store, &mut request, &id, b"selective") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(callsTarget(&store, &selective, "risky") && callsTarget(&store, &selective, "recoverSelected") &&
    switchCount(&store, &selective) == usize.ONE && failureFact(&store, &selective, 2) == usize.ONE &&
    failureFact(&store, &selective, usize.ONE) == usize.ONE,
    "catchFailure runs the protected call with a failure edge, switches on the caught tag, calls the handler and fails the residual")
  let whole = run Semantic.demandMir(&mut store, &mut request, &id, b"whole") |> Effect.provideMut<Allocator>(&mut allocator)
  let widened = run Semantic.demandMir(&mut store, &mut request, &id, b"widened") |> Effect.provideMut<Allocator>(&mut allocator)
  let rethrows = run Semantic.demandMir(&mut store, &mut request, &id, b"rethrows") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(callsTarget(&store, &whole, "recoverAny") && switchCount(&store, &whole) == usize.ZERO &&
    callsTarget(&store, &widened, "recoverWide") && switchCount(&store, &widened) == usize.ZERO &&
    callsTarget(&store, &rethrows, "escalate") && failureFact(&store, &rethrows, 2) == 2,
    "selecting the whole or a single failure needs no switch; a wider handler success joins the result; the handler's own failure propagates")
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongHandler") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.InvalidEffectHandler, text, "recoverSelected", 2),
    "a handler that does not accept the selected failures is rejected at the handler")
  return ()
}

// A generic function value passed to a callable parameter is instantiated by its use: the
// parameters the call already determined select its binders, and its result then infers the rest.
// A selection those parameters reject fails the call rather than leaving its result uninferred.
test effect fn genericFunctionValuesInstantiateFromTheirUse() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("generic-function-values.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Problem { code: i32 }
effect fn guarded<'env, A, B, E, F, ?R, ?S>(self: once Effect<'env; A ! E ? R>, onFailure: once fn<'env>(E) -> once Effect<'env; B ! F ? S>) -> A | B ! F ? R | S {
  return run Intrinsic.catchFailure<E>(move self, move onFailure)
}
effect fn risky(mode: i32) -> i32 ! Problem {
  if mode == 0 { return 10 }
  fail Problem { code: 2 }
}
effect<'env> fn failed<E: 'env, 'env>(error: E) -> i32 {
  drop error
  return 1
}
fn apply<A, B>(value: A, transform: once fn(A) -> B) -> B { return transform(move value) }
fn same<T>(value: T) -> T { return move value }
fn widen<T>(value: T) -> i64 { drop value return 2 }
interface Marker {}
fn marked<T: Marker>(value: T) -> i64 { drop value return 2 }
pub fn main() -> i32 { return run guarded(risky(1), failed) }
fn mapped() -> i32 { return apply(41, same) }
fn widened() -> i64 { return apply(true, widen) }
fn unmarked() -> i64 { return apply(true, marked) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let handled = run Semantic.demandBody(&mut store, &mut request, &id, b"main") |> Effect.provideMut<Allocator>(&mut allocator)
  let mapped = run Semantic.demandBody(&mut store, &mut request, &id, b"mapped") |> Effect.provideMut<Allocator>(&mut allocator)
  let widened = run Semantic.demandBody(&mut store, &mut request, &id, b"widened") |> Effect.provideMut<Allocator>(&mut allocator)
  let unmarked = run Semantic.demandBody(&mut store, &mut request, &id, b"unmarked") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&handled) && succeeded(&mapped) && succeeded(&widened),
    "a generic `effect fn` handler and generic plain functions are selected by the parameters their use determined, and their results infer the call")
  run Testing.expect(rejectsSpan(&unmarked, RejectionCode.MissingConformance, text, "marked", 2),
    "a selection whose bound the determined parameter fails rejects the call instead of leaving its result uninferred")
  let built = run Semantic.buildMain(&mut store, &mut request, &id, staticClosureNodes) |> Effect.provideMut<Allocator>(&mut allocator)
  let emitted = match &built { BackendBuild.Module {..} => true _ => false }
  run Testing.expect(emitted, "the generic handler runs as the instance its use selected")
  return ()
}

// A named Effect callback takes result-only type evidence from the promised success channel,
// while the complete contract still checks failures and absent context supplies no evidence.
test effect fn namedEffectCallbacksInferResultOnlyTypesFromPromisedChannels() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("named-effect-result-inference.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Completed<A, E> { Success { value: A }, Failure { error: E } }
struct Problem { code: i32 }
effect<'env> fn failed<A, E: 'env, 'env>(error: E) -> Completed<A, E> {
  return Completed<A, E>.Failure { error: move error }
}
effect<'env> fn failedWithProblem<A, E: 'env, 'env>(error: E) -> Completed<A, E> ! Problem {
  drop error
  fail Problem { code: 1 }
}
fn consume(handler: once fn<'static>(i32) -> once Effect<'static; Completed<u8, i32>>) -> () {
  drop handler
}
fn accepted() -> () { consume(failed) }
fn wrongFailure() -> () { consume(failedWithProblem) }
fn contextFree() -> () { let callback = failed drop callback }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let accepted = run Semantic.demandBody(&mut store, &mut request, &id, b"accepted") |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared.with<Result<Answer, NoRejection>, bool>(&accepted,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      if let Option<Shared<TypedBody>>.Some {value: body} = move checkedBody(answer) {
        return Shared.with<TypedBody, bool>(&body, namedEffectCallbackResultEvidence)
      }
      return false
    })
  run Testing.expect(succeeded(&accepted) && selected,
    "the named target selects A=u8 only from promised Effect success and E=i32 from the promised callback input")
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongFailure") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.IncompatibleCallableSignature, text, "failedWithProblem", usize.ONE),
    "learning result-only types does not admit a callback whose failure channel exceeds the promised never")
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"contextFree") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&missing, RejectionCode.SectionResultInferenceUnavailable, text, "failed", 4),
    "a named callback with no promised contract retains the result-only inference gap")
  return ()
}

// A consumer's inferred requirement row cannot discard its determined callback channels.
// Exact wrapper and callback MIR prove that the selected evidence survives realization.
test effect fn namedEffectCallbacksUseKnownChannelsWhileConsumerRowsAreInferred() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("partial-callback-evidence.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = partialCallbackEvidenceFixture()
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let closed = run Semantic.demandBody(&mut store, &mut request, &id, b"closedAccepted") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&closed), "a fully determined callback contract remains admitted")
  let wrapper = run Semantic.demandBody(&mut store, &mut request, &id, b"wrap") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&wrapper),
    "an inferred callback requirement row preserves determined success and input evidence")
  let first = run Semantic.demandMir(&mut store, &mut request, &id, b"accepted8") |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Semantic.demandMir(&mut store, &mut request, &id, b"accepted16") |> Effect.provideMut<Allocator>(&mut allocator)
  let firstSelected = run partialCallbackMirChain(&mut store, &mut request, &first, b"u8") |> Effect.provideMut<Allocator>(&mut allocator)
  let secondSelected = run partialCallbackMirChain(&mut store, &mut request, &second, b"u16") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&first) && succeeded(&second) && firstSelected && secondSelected,
    "independent wrapper instances retain original callback A=u8/u16 and E=i32, infer S empty, and demand their concrete callback MIR")
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongFailure") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.EffectFormUnavailable, text, "dispatch<u8>(1, failedWithProblem)", usize.ZERO),
    "partial callback evidence preserves the open-row refusal for a failure channel exceeding the consumer's never")
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"contextFree") |> Effect.provideMut<Allocator>(&mut allocator)
  let unresolved = run Semantic.demandBody(&mut store, &mut request, &id, b"unresolvedSuccess") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&missing, RejectionCode.SectionResultInferenceUnavailable, text, "failed", 5)
    && rejectsSpan(&unresolved, RejectionCode.SectionResultInferenceUnavailable, text, "failed", 6),
    "absent context and an unresolved consumer success cannot select the callback's result-only type")
  let required = run Semantic.demandBody(&mut store, &mut request, &id, b"required") |> Effect.provideMut<Allocator>(&mut allocator)
  let application = run directApplicationAt(&required, usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedClock = match &application {
    Option<SpecializationApplication>.Some {value} => partialCallbackClockRow(&value)
    _ => false
  }
  run Testing.expect(succeeded(&required) && selectedClock,
    "the actual callback's shared Clock requirement infers consumer S instead of defaulting it to empty")
  let closedRow = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongRequirements") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&closedRow, RejectionCode.IncompatibleCallableSignature, text, "needsClock", 2),
    "a fixed empty consumer row still rejects the callback's actual Clock requirement")
  let quantified = run Semantic.demandBody(&mut store, &mut request, &id, b"quantifiedAccepted") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&quantified),
    "a binder-free callback infers the channels of a promise quantified over its invocation")
  let invoked = run Semantic.demandBody(&mut store, &mut request, &id, b"invokeQuantified") |> Effect.provideMut<Allocator>(&mut allocator)
  let invokedConcrete = run Semantic.demandBody(&mut store, &mut request, &id, b"invokedQuantified") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&invoked) && succeeded(&invokedConcrete),
    "an invocation whose inputs carry no region supplies its own extent for the marked binder")
  return ()
}

fn partialCallbackEvidenceFixture() -> string<'static> {
  return """
union Completed<A, E> { Success { value: A }, Failure { error: E } }
struct Problem { code: i32 }
service Clock {}
effect<'env> fn failed<A, E: 'env, 'env>(error: E) -> Completed<A, E> {
  return Completed<A, E>.Failure { error: move error }
}
effect<'env> fn failedWithProblem<A, E: 'env, 'env>(error: E) -> Completed<A, E> ! Problem {
  drop error
  fail Problem { code: 1 }
}
effect<'env> fn needsClock<A, E: 'env, 'env>(error: E) -> Completed<A, E> ? &Clock {
  return Completed<A, E>.Failure { error: move error }
}
effect fn dispatch<A, ?S>(error: i32,
  handler: once fn<'static>(i32) -> once Effect<'static; Completed<A, i32> ? S>) -> Completed<A, i32> ? S {
  return run handler(error)
}
effect fn wrap<A>(error: i32) -> Completed<A, i32> {
  return run dispatch<A>(error, failed)
}
fn closed(handler: once fn<'static>(i32) -> once Effect<'static; Completed<u8, i32>>) -> () { drop handler }
fn closedAccepted() -> () { closed(failed) }
fn accepted8() -> Completed<u8, i32> { return run wrap<u8>(1) }
fn accepted16() -> Completed<u16, i32> { return run wrap<u16>(2) }
fn wrongFailure() -> () { let pending = dispatch<u8>(1, failedWithProblem) drop pending }
fn contextFree() -> () { let callback = failed drop callback }
fn unresolvedSuccess() -> () { let pending = dispatch(1, failed) drop pending }
effect fn required() -> Completed<u8, i32> ? &Clock { return run dispatch<u8>(1, needsClock) }
fn wrongRequirements() -> () { closed(needsClock) }
fn quantified<B, ?S>(handler: for<use 'call> once fn<'static>(i32) -> once Effect<'call; B ? S>) -> () { drop handler }
effect fn concrete(error: i32) -> u8 { return 1 }
fn quantifiedAccepted() -> () { quantified(concrete) }
effect fn invokeQuantified<B, ?S>(handler: for<use 'call> once fn<'static>(i32) -> once Effect<'call; B ? S>) -> B ? S {
  return run handler(1)
}
fn invokedQuantified() -> u8 { return run invokeQuantified(concrete) }
"""
}

effect fn partialCallbackMirChain(store: &mut Semantic, request: &mut Request,
  caller: &Shared<Result<Answer, NoRejection>>, primitive: &[u8]) -> bool
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let wrapper = match move namedMirApplication(&store.*, caller, b"wrap") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  if !partialCallbackApplication(&wrapper, b"wrap", primitive, false, false) { return false }
  let wrapped = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &wrapper)
  if !partialCallbackConcreteMir(&store.*, &wrapped, primitive) { return false }
  let consumer = match move namedMirApplication(&store.*, &wrapped, b"dispatch") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  if !partialCallbackApplication(&consumer, b"dispatch", primitive, true, false) { return false }
  let consumed = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &consumer)
  if !partialCallbackConcreteMir(&store.*, &consumed, primitive) { return false }
  let callback = match move namedMirApplication(&store.*, &consumed, b"failed") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  if !partialCallbackApplication(&callback, b"failed", primitive, false, true) { return false }
  let invoked = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &callback)
  return partialCallbackConcreteMir(&store.*, &invoked, primitive)
}

fn partialCallbackApplication(value: &SpecializationApplication, target: &[u8], primitive: &[u8],
  consumer: bool, callback: bool) -> bool {
  if !DeclarationId.named(SpecializationApplication.bodyDeclaration(value), target) { return false }
  let arguments = Vector.asSlice<Argument>(&value.arguments)
  let ordinals = Vector.asSlice<usize>(&value.argumentOrdinals)
  if arguments.length != ordinals.length { return false }
  let mut result = false
  let mut other = !consumer && !callback
  let mut at = usize.ZERO
  while at < arguments.length {
    if ordinals[at] == usize.ZERO { result = genericSectionArgument(&arguments[at], primitive) }
    if ordinals[at] == usize.ONE {
      if callback { other = genericSectionArgument(&arguments[at], b"i32") }
      if consumer {
        if let Argument.Row {value: row} = &arguments[at] {
          other = Shared.with<Row, bool>(&row, fn(value: &Row) -> bool {
            return Vector.length<Requirement>(&value.entries) == usize.ZERO && Vector.length(&value.parameters) == usize.ZERO
              && Vector.length(&value.subtractions) == usize.ZERO
          })
        }
      }
    }
    at = at + usize.ONE
  }
  return result && other
}

fn partialCallbackConcreteMir(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, primitive: &[u8]) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let providers = match move InstanceKey.providers(&function.key) {
        Option<Shared<Vector<ProviderEntry>>>.Some {value} => Shared.with<Vector<ProviderEntry>, usize>(&value,
          fn(entries: &Vector<ProviderEntry>) -> usize { return Vector.length<ProviderEntry>(entries) })
        _ => usize.MAX
      }
      if providers != usize.ZERO { return false }
      return Shared.with<Type, bool>(&function.result, fn(value: &Type) -> bool {
        if let Type.Nominal {declaration, arguments, ..} = &value.* {
          let supplied = Vector.asSlice<Argument>(&arguments)
          return DeclarationId.named(&declaration, b"Completed") && supplied.length == 2
            && genericSectionArgument(&supplied[usize.ZERO], primitive) && genericSectionArgument(&supplied[usize.ONE], b"i32")
        }
        return false
      })
    }
  }
  return false
}

fn partialCallbackClockRow(value: &SpecializationApplication) -> bool {
  if !DeclarationId.named(SpecializationApplication.bodyDeclaration(value), b"dispatch") { return false }
  let arguments = Vector.asSlice<Argument>(&value.arguments)
  let ordinals = Vector.asSlice<usize>(&value.argumentOrdinals)
  if arguments.length != ordinals.length { return false }
  let mut at = usize.ZERO
  while at < arguments.length {
    if ordinals[at] == usize.ONE {
      if let Argument.Row {value: row} = &arguments[at] {
        return Shared.with<Row, bool>(&row, fn(value: &Row) -> bool {
          let entries = Vector.asSlice<Requirement>(&value.entries)
          if entries.length != usize.ONE || Vector.length(&value.parameters) != usize.ZERO
            || Vector.length(&value.subtractions) != usize.ZERO || entries[usize.ZERO].access != Access.Shared { return false }
          if let Option<Shared<Type>>.Some {..} = &entries[usize.ZERO].roleType { return false }
          return Shared.with<Type, bool>(&entries[usize.ZERO].capability, partialCallbackClockCapability)
        })
      }
      return false
    }
    at = at + usize.ONE
  }
  return false
}

fn partialCallbackClockCapability(capability: &Type) -> bool {
  return match &capability.* {
    Type.Nominal {declaration, arguments, ..} => DeclarationId.named(&declaration, b"Clock") && Vector.length<Argument>(&arguments) == usize.ZERO
    _ => false
  }
}

fn namedEffectCallbackResultEvidence(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, ..} = &nodes[at].kind {
      let selected = Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool {
        if let Type.CallableValue {application, ..} = &value.* {
          return Shared.with<SpecializationApplication, bool>(&application, namedEffectCallbackResultArguments)
        }
        return false
      })
      if selected { return true }
    }
    at = at + usize.ONE
  }
  return false
}

fn namedEffectCallbackResultArguments(value: &SpecializationApplication) -> bool {
  if !DeclarationId.named(SpecializationApplication.bodyDeclaration(value), b"failed") { return false }
  let arguments = Vector.asSlice<Argument>(&value.arguments)
  let ordinals = Vector.asSlice<usize>(&value.argumentOrdinals)
  if arguments.length != ordinals.length { return false }
  let mut result = false
  let mut input = false
  let mut at = usize.ZERO
  while at < arguments.length {
    if ordinals[at] == usize.ZERO { result = genericSectionArgument(&arguments[at], b"u8") }
    if ordinals[at] == usize.ONE { input = genericSectionArgument(&arguments[at], b"i32") }
    at = at + usize.ONE
  }
  return result && input
}

// A lifetime binder only the result mentions is chosen by the call's use: the expected result fixes
// it, and without one the result is valid for 'static, which then infers the enclosing call.
test effect fn resultOnlyLifetimeBindersFollowTheirUse() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("result-only-lifetimes.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Policy<'names> { Default, Explicit { names: &'names [i32] } }
impl<'names> Copy for Policy<'names> {}
impl<'names> Policy<'names> {
  fn defaultPolicy() -> Policy<'names> { return Policy<'names>.Default }
}
struct Context<'names> { policy: Policy<'names> }
impl<'names> Context<'names> {
  fn make(policy: Policy<'names>) -> Context<'names> { return Context<'names> {policy: policy} }
}
fn nested() -> i32 {
  let context = Context.make(Policy.defaultPolicy())
  drop context
  return 0
}
fn expected<'a>(names: &'a [i32]) -> Policy<'a> { return Policy.defaultPolicy() }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested") |> Effect.provideMut<Allocator>(&mut allocator)
  let expected = run Semantic.demandBody(&mut store, &mut request, &id, b"expected") |> Effect.provideMut<Allocator>(&mut allocator)
  let defaulted = run directApplicationAt(&nested, usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let contextual = run directApplicationAt(&expected, usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&nested) && scopeLifetimeIs(&defaulted, false),
    "without an expected result, a result-only lifetime binder is 'static and the enclosing call infers from it")
  run Testing.expect(succeeded(&expected) && scopeLifetimeIs(&contextual, true),
    "the expected result fixes a result-only lifetime binder")
  return ()
}

// Whether a direct call's single scope argument is 'static, or else a declared lifetime parameter.
fn scopeLifetimeIs(application: &Option<SpecializationApplication>, parameter: bool) -> bool {
  if let Option<SpecializationApplication>.Some {value} = &application.* {
    let scopes = Vector.asSlice<ScopeBinding>(&value.scopes)
    if scopes.length == usize.ONE {
      let arguments = Vector.asSlice<Argument>(&scopes[usize.ZERO].arguments)
      if arguments.length == usize.ONE {
        if let Argument.Lifetime {value: region} = &arguments[usize.ZERO] {
          return Shared.with<Lifetime, bool>(&region, fn(lifetime: &Lifetime) -> bool {
            return match &lifetime.* {
              Lifetime.Static => !parameter
              Lifetime.Parameter {..} => parameter
              _ => false
            }
          })
        }
      }
    }
  }
  return false
}

// Providers (Effect note D2): an instance receives its row's providers in canonical key order, a
// binding serves its key to the enclosed run only, and a service operation calls the witness for
// the serving provider's type with that provider's address as its receiver.
test effect fn providersServeRowsInKeyOrder() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("providers.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
role Left
role Right
service Values {
  effect fn left() -> i32 ? &Values at Left
  effect fn right() -> i32 ? &Values at Right
}
struct Fixed { value: i32 }
effect fn left(self: &Fixed) -> i32 { return self.value }
effect fn right(self: &Fixed) -> i32 { return self.value }
impl Values for Fixed { left: Fixed.left right: Fixed.right }
effect fn total() -> i32 ? &Values at Right | &Values at Left {
  let leftValue = run Values.left()
  let pending = Values.right()
  let rightValue = run pending
  return leftValue * 10 + rightValue
}
fn both() -> i32 {
  let leftProvider = Fixed { value: 4 }
  let rightProvider = Fixed { value: 2 }
  return run Intrinsic.bindRequirement<Values at Right>(Intrinsic.bindRequirement<Values at Left>(total(), &leftProvider), &rightProvider)
}
fn partial() -> i32 {
  let provider = Fixed { value: 1 }
  return run Intrinsic.bindRequirement<Values at Left>(total(), &provider)
}
fn wrongShape() -> i32 {
  let shapeProvider = Fixed { value: 1 }
  return run Intrinsic.bindRequirementMut<Values at Left>(total(), &shapeProvider)
}
interface Present { effect fn present(value: &Self) -> i32 }
impl Present for i32 { effect fn present(value: &Self) -> i32 { return 1 } }
effect fn presented(value: &i32) -> i32 { return run Present.present(value) }
effect fn pendingPresent(value: &i32) -> i32 {
  let pending = Present.present(value)
  return 0
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let both = run Semantic.demandMir(&mut store, &mut request, &id, b"both") |> Effect.provideMut<Allocator>(&mut allocator)
  let called = providedCallee(&store, &both, "total")
  run Testing.expect(boundProvidersByDepth(&store, &both),
    "each binding serves its key to the enclosed run, the inner binding from deeper in the stored composite, in callee key order")
  if let Option<InstanceKey>.Some {value: key} = move called {
    let total = run sourceCallMir(&mut store, &mut request, &both, &key, usize.ZERO, false) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(dispatchesOwnProvider(&store, &total, &key, "left", "Left") && dispatchesOwnProvider(&store, &total, &key, "right", "Right"),
      "a service operation, run directly or stored first, calls its witness with the provider local of its own key as the receiver")
  } else {
    run Testing.expect(false, "running the bound composite calls total with its providers in its key")
  }
  let partial = run Semantic.demandBody(&mut store, &mut request, &id, b"partial") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&partial, RejectionCode.UnhandledRequirement, text,
    "run Intrinsic.bindRequirement<Values at Left>(total(), &provider)", 0),
    "a binding removes only its selected key; the rest of the row must still be covered")
  let wrongShape = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongShape") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&wrongShape, RejectionCode.TypeMismatch, text, "&shapeProvider", 0),
    "an exclusive binding takes an exclusive provider loan")
  let presented = run Semantic.demandMir(&mut store, &mut request, &id, b"presented") |> Effect.provideMut<Allocator>(&mut allocator)
  let pendingPresent = run Semantic.demandMir(&mut store, &mut request, &id, b"pendingPresent") |> Effect.provideMut<Allocator>(&mut allocator)
  let presentedWitness = mirWitnessReference(&store, Shared.with<Result<Answer, NoRejection>, Option<usize>>(&presented, selectedMirIndex))
  let ranWitness = match &presentedWitness { Option<InstanceKey>.Some {..} => true Option<InstanceKey>.None => false }
  run Testing.expect(ranWitness && backendGapAt(&pendingPresent, GapCode.InterfaceEffectWitness, text, "Present.present(value)", 1),
    "running an effect fn through an interface calls its witness in place; a construction no run executes stops before lowering")
  return ()
}

// INTF-006 with INTF-005: an unapplied qualified call takes the one application its provider's
// conformances supply, including an `effect fn` operation's failure and row binders, and a `run`
// executes it as one call of the selected witness.
test effect fn qualifiedEffectCallsInferTheirApplication() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run qualifiedEffectCallClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn qualifiedEffectCallClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("qualified-effect-calls.silk")
  let text = """
interface Source<A, E, ?R> { effect fn take(self: &mut Self) -> A ! E ? R }
struct Counter { count: i32 }
impl Source<i32, never ? never> for Counter {
  effect fn take(self: &mut Self) -> i32 {
    self.count = self.count - 1
    return self.count
  }
}
struct Twice {}
impl Source<i32, never ? never> for Twice { effect fn take(self: &mut Self) -> i32 { return 1 } }
impl Source<bool, never ? never> for Twice { effect fn take(self: &mut Self) -> bool { return true } }
struct Empty {}
effect fn drain(counter: &mut Counter) -> i32 { return run Source.take(counter) }
effect fn ambiguous(twice: &mut Twice) -> i32 { return run Source.take(twice) }
effect fn missing(empty: &mut Empty) -> i32 { return run Source.take(empty) }
effect fn stored(counter: &mut Counter) -> i32 {
  let pending = Source.take(counter)
  return 0
}
fn handed(counter: &mut Counter) -> Effect<i32> { return Source.take(counter) }
struct Problem { code: i32 }
struct Faulty { count: i32 }
impl Source<i32, Problem ? never> for Faulty {
  effect fn take(self: &mut Self) -> i32 ! Problem {
    if self.count == 0 { fail Problem { code: 1 } }
    return self.count
  }
}
struct Calm {}
impl Source<i32, Problem ? never> for Calm { effect fn take(self: &mut Self) -> i32 { return 0 } }
effect fn propagated(faulty: &mut Faulty) -> i32 ! Problem { return run Source.take(faulty) }
effect fn unhandled(loose: &mut Faulty) -> i32 { return run Source.take(loose) }
effect fn narrower(calm: &mut Calm) -> i32 ! Problem { return run Source.take(calm) }
union Maybe<T> { None, Some { value: T } }
interface Stream<A, E, ?R> { effect fn next(self: &mut Self) -> Maybe<A> ! E ? R }
struct Tally { count: i32 }
impl Tally { effect fn bump(self: &mut Self) -> i32 { self.count = self.count + 1 return self.count } }
effect fn bumped(tally: &mut Tally) -> i32 { return run tally.bump() }
effect fn received(counter: &mut Counter) -> i32 { return run counter.take() }
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let mut store = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let mut request = Request.make()
  let sourceId = run requireIndexedIdentity(&mut index, &id, OwnerKind.Interface, b"Source", usize.ZERO)
  let operation = run signatureNamed(&mut store, &mut request, &mut index, &id, b"take", usize.ZERO)
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&operation, failureOf)
  let requirements = Shared.with<Result<Answer, NoRejection>, Option<Shared<Row>>>(&operation, signatureRequirements)
  let errorParameter = run specializationParameter(&sourceId, usize.ONE)
  let mut rowParameter = Row.empty()
  run Row.include(&mut rowParameter, RowParameter {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&sourceId)), ordinal: 2})
  let expectedRow = run Shared.make<Row>(move rowParameter)
  let mut binders = false
  if let Option<Shared<Type>>.Some {value: declaredFailure} = move failure {
    if let Option<Shared<Row>>.Some {value: declaredRow} = move requirements {
      let failureMatches = run Type.equalsShared(&declaredFailure, &errorParameter)
      let rowMatches = run Row.equalsShared(&declaredRow, &expectedRow)
      binders = failureMatches && rowMatches
    }
  }
  run Testing.expect(binders, "an interface operation's signature fails with its interface's E and requires its ?R row")
  let next = run signatureNamed(&mut store, &mut request, &mut index, &id, b"next", usize.ZERO)
  run Testing.expect(succeeded(&next), "an operation returning a generic union of its interface's binder resolves (the Stream.take shape)")
  let heads = run Semantic.demandImplementations(&mut store, &mut request, &id)
  let drained = run Semantic.demandBody(&mut store, &mut request, &id, b"drain")
  let mut selected = false
  let called = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&drained, effectWitnessContract)
  let written = contractOf(&headAt(&heads, usize.ZERO))
  if let Option<Shared<Type>>.Some {value: inferred} = move called {
    if let Option<Shared<Type>>.Some {value: declared} = move written {
      selected = run Type.equalsShared(&inferred, &declared)
    }
  }
  run Testing.expect(selected, "the provider's one conformance supplies the application and selects its witness")
  let lowered = run Semantic.demandMir(&mut store, &mut request, &id, b"drain")
  let mut witnessed = false
  let reference = mirWitnessReference(&store, Shared.with<Result<Answer, NoRejection>, Option<usize>>(&lowered, selectedMirIndex))
  if let Option<InstanceKey>.Some {value: key} = move reference {
    let application = run InstanceKey.selected(&key)
    witnessed = DeclarationId.named(SpecializationApplication.bodyDeclaration(&application), b"take")
  }
  run Testing.expect(witnessed, "running the operation calls the selected witness in place")
  let ambiguous = run Semantic.demandBody(&mut store, &mut request, &id, b"ambiguous")
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missing")
  let stored = run Semantic.demandBody(&mut store, &mut request, &id, b"stored")
  let handed = run Semantic.demandBody(&mut store, &mut request, &id, b"handed")
  run Testing.expect(rejectsSpan(&ambiguous, RejectionCode.AmbiguousConformanceMethod, text, "Source.take(twice)", 0)
    && rejectsSpan(&missing, RejectionCode.MissingConformance, text, "Source.take(empty)", 0),
    "several applications are ambiguous and none is missing")
  run Testing.expect(rejectsSpan(&stored, RejectionCode.InterfaceEffectUnavailable, text, "Source.take(counter)", 1),
    "a bound construction that no run executes in place keeps its named gap")
  let bumped = run Semantic.demandBody(&mut store, &mut request, &id, b"bumped")
  let received = run Semantic.demandBody(&mut store, &mut request, &id, b"received")
  run Testing.expect(succeeded(&bumped) && rejectsSpan(&received, RejectionCode.InterfaceEffectUnavailable, text, "counter.take()", 0),
    "an inherent effect method called on its receiver constructs its Effect; an interface operation keeps the named gap")
  run Testing.expect(rejectsSpan(&handed, RejectionCode.InterfaceEffectUnavailable, text, "Source.take(counter)", 2),
    "a returned construction keeps the same named gap rather than becoming an opaque Effect family")
  let propagated = run Semantic.demandMir(&mut store, &mut request, &id, b"propagated")
  let unhandled = run Semantic.demandBody(&mut store, &mut request, &id, b"unhandled")
  run Testing.expect(failureFact(&store, &propagated, 2) == usize.ONE
    && rejectsSpan(&unhandled, RejectionCode.UnhandledFailure, text, "run Source.take(loose)", 0),
    "the interface's failure reaches the caller: the witness call has a failure edge and an uncovered run is unhandled")
  let narrower = run Semantic.demandMir(&mut store, &mut request, &id, b"narrower")
  run Testing.expect(succeeded(&narrower) && callFailureEdge(&store, &narrower, "take") == usize.ZERO,
    "a witness declaring a smaller failure than the promised one is called with its own: never has no failure edge")
  return ()
}

// The application of the first `effect fn` interface call in a checked body with a selected witness.
fn effectWitnessContract(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedBody(answer) {
    return Shared.with<TypedBody, Option<Shared<Type>>>(&body, fn(typed: &TypedBody) -> Option<Shared<Type>> {
      let nodes = TypedBody.nodeSlice(typed)
      let mut at = usize.ZERO
      while at < nodes.length {
        if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {contract, implementation, isEffect, ..}, ..} = &nodes[at].kind {
          let witnessed = match &implementation { Option<Shared<DeclarationId>>.Some {..} => true Option<Shared<DeclarationId>>.None => false }
          if isEffect && witnessed { return Option.some<Shared<Type>>(Shared.clone<Type>(&contract)) }
        }
        at = at + usize.ONE
      }
      return Option.none<Shared<Type>>()
    })
  }
  return Option.none<Shared<Type>>()
}

fn backendGapAt(answer: &Shared<Result<Answer, NoRejection>>, code: GapCode, text: string, spelling: string,
  occurrence: usize) -> bool {
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<BackendGap>>>(answer, selectedBackendGap)
  if let Option<Shared<BackendGap>>.Some {value} = move found {
    let start = offsetOf(text, spelling, occurrence)
    return Shared.with<BackendGap, bool>(&value, fn(gap: &BackendGap) -> bool {
      let site = BackendGap.span(gap)
      return gap.code == code && site.start == start && site.end == start + String.utf8Bytes(spelling).length
    })
  }
  return false
}

// D2 rule 2: a binding replaces an instance's own provider for the run it encloses only; a
// handler outside that binding is served by the instance's own provider of the same key.
test effect fn bindingsShadowOwnProvidersForTheirRunOnly() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("provider-scopes.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
role Left
role Right
service Values {
  effect fn left() -> i32 ? &Values at Left
  effect fn right() -> i32 ? &Values at Right
}
struct Fixed { value: i32 }
effect fn left(self: &Fixed) -> i32 { return self.value }
effect fn right(self: &Fixed) -> i32 { return self.value }
impl Values for Fixed { left: Fixed.left right: Fixed.right }
struct Problem { code: i32 }
effect fn risky() -> i32 ! Problem ? &Values at Left | &Values at Right {
  let leftValue = run Values.left()
  let rightValue = run Values.right()
  if leftValue > rightValue { fail Problem { code: leftValue } }
  return rightValue
}
effect fn recover(problem: Problem) -> i32 ? &Values at Left { return run Values.left() }
effect fn shadowing() -> i32 ? &Values at Left | &Values at Right {
  let inner = Fixed { value: 7 }
  return run Intrinsic.catchFailure<Problem>(Intrinsic.bindRequirement<Values at Left>(risky(), &inner), recover)
}
fn outer() -> i32 {
  let leftProvider = Fixed { value: 4 }
  let rightProvider = Fixed { value: 2 }
  return run Intrinsic.bindRequirement<Values at Right>(Intrinsic.bindRequirement<Values at Left>(shadowing(), &leftProvider), &rightProvider)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let outer = run Semantic.demandMir(&mut store, &mut request, &id, b"outer") |> Effect.provideMut<Allocator>(&mut allocator)
  if let Option<InstanceKey>.Some {value: key} = move providedCallee(&store, &outer, "shadowing") {
    let shadowing = run sourceCallMir(&mut store, &mut request, &outer, &key, usize.ZERO, false) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(providerOrigin(&store, &shadowing, "risky", "Left") == usize.ONE
      && providerOrigin(&store, &shadowing, "risky", "Right") == usize.ZERO,
      "inside the binding its key comes from the stored provider and every other key from the instance's own")
    run Testing.expect(providerOrigin(&store, &shadowing, "recover", "Left") == usize.ZERO,
      "the handler outside the binding sees the instance's own provider of the same key")
    return ()
  }
  run Testing.expect(false, "the outer binding runs shadowing with its providers in its key")
}

// Where the provider of `roleName` passed to the call of `name` comes from: 0 for this
// instance's own Provider local, 1 for a binding's stored provider, usize.MAX otherwise.
fn providerOrigin(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, name: string, roleName: string) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, providers, ..} = &blocks[at].terminator {
          if keyNamed(&key, name) {
            let entries = match move InstanceKey.providers(&key) {
              Option<Shared<Vector<ProviderEntry>>>.Some {value} => value
              Option<Shared<Vector<ProviderEntry>>>.None => { return usize.MAX }
            }
            let slot = Shared.with<Vector<ProviderEntry>, usize>(&entries, fn(values: &Vector<ProviderEntry>) -> usize {
              let listed = Vector.asSlice<ProviderEntry>(values)
              let mut entry = usize.ZERO
              while entry < listed.length && !roleNamed(&listed[entry], roleName) { entry = entry + usize.ONE }
              return entry
            })
            let operands = Vector.asSlice<MirOperand>(&providers)
            if slot >= operands.length { return usize.MAX }
            let projected = copiedProjections(&operands[slot])
            if projected == usize.MAX { return usize.MAX }
            if projected > usize.ZERO { return usize.ONE }
            let local = copiedLocal(&operands[slot])
            if local >= locals.length { return usize.MAX }
            return match &locals[local].kind { MirLocalKind.Provider {..} => usize.ZERO _ => usize.MAX }
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return usize.MAX
}

fn roleNamed(entry: &ProviderEntry, name: string) -> bool {
  return match &entry.key.roleType {
    Option<Shared<Type>>.Some {value} => Shared.with<Type, bool>(&value, fn(ty: &Type) -> bool {
      return match &ty.* { Type.Nominal {declaration, ..} => DeclarationId.named(&declaration, String.utf8Bytes(name)) _ => false }
    })
    Option<Shared<Type>>.None => false
  }
}

// The call to `total` passes two stored provider loans in its key order: the outer binding's part
// 1 (Right) and the inner binding's, one part deeper (Left).
fn boundProvidersByDepth(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, providers, ..} = &blocks[at].terminator {
          if keyNamed(&key, "total") {
            let entries = match move InstanceKey.providers(&key) {
              Option<Shared<Vector<ProviderEntry>>>.Some {value} => value
              Option<Shared<Vector<ProviderEntry>>>.None => { return false }
            }
            let operands = Vector.asSlice<MirOperand>(&providers)
            if operands.length != 2 { return false }
            let firstLeft = Shared.with<Vector<ProviderEntry>, bool>(&entries, fn(values: &Vector<ProviderEntry>) -> bool {
              let listed = Vector.asSlice<ProviderEntry>(values)
              return roleNamed(&listed[usize.ZERO], "Left")
            })
            let first = copiedProjections(&operands[usize.ZERO])
            let second = copiedProjections(&operands[usize.ONE])
            if first == usize.MAX || second == usize.MAX { return false }
            if firstLeft { return first == second + usize.ONE }
            return second == first + usize.ONE
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

// The call to witness `name` receives, first, the provider local whose key entry has role `role`.
fn dispatchesOwnProvider(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, instance: &InstanceKey, name: string,
  roleName: string) -> bool {
  let entries = match move InstanceKey.providers(instance) {
    Option<Shared<Vector<ProviderEntry>>>.Some {value} => value
    Option<Shared<Vector<ProviderEntry>>>.None => { return false }
  }
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          if keyNamed(&key, name) {
            let passed = Vector.asSlice<MirOperand>(&arguments)
            if passed.length == usize.ZERO || copiedProjections(&passed[usize.ZERO]) != usize.ZERO { return false }
            let local = copiedLocal(&passed[usize.ZERO])
            if local >= locals.length { return false }
            return match &locals[local].kind {
              MirLocalKind.Provider {index: provider} => Shared.with<Vector<ProviderEntry>, bool>(&entries, fn(values: &Vector<ProviderEntry>) -> bool {
                let listed = Vector.asSlice<ProviderEntry>(values)
                return provider < listed.length && roleNamed(&listed[provider], roleName)
              })
              _ => false
            }
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

// Local closures are part of their owner's declaration graph: re-entering the owner through one
// is polymorphic recursion, and a closure identity that carries the growing owner grows with it.
test effect fn localClosureReentryIsDeclarationRecursion() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("closure-recursion.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
fn nest(g: fn() -> i32) -> i32 { return nest(fn() -> i32 { return g() }) }
pub fn growing() -> i32 { return nest(fn() -> i32 { return 1 }) }
fn local<T>(value: T) -> i32 {
  let again = fn() -> i32 { return local<u8>(0) }
  return again()
}
pub fn polymorphic() -> i32 { return local<i32>(1) }
union Maybe<T> { Nothing, Just { value: T } }
fn apply(f: fn() -> i32) -> i32 { return f() }
fn go<T>(value: T) -> i32 { return apply(fn() -> i32 { return go<Maybe<T>>(Maybe<T>.Nothing) }) }
pub fn unbounded() -> i32 { return go<i32>(1) }
struct Lens<T> {}
impl<T> Lens<T> {
  fn withMut<A>(core: &Intrinsic.SharedCore<T>, use: once fn(&mut T) -> A) -> A {
    return Intrinsic.sharedWithMut<T, A>(core, move use, conflict)
  }
  fn with<A>(core: &Intrinsic.SharedCore<T>, use: once fn(&T) -> A) -> A {
    return Lens.withMut<T, A>(core, inspect<T, A>(move use))
  }
}
fn conflict() -> never { return conflict() }
fn inspect<T, A>(value: &mut T, use: once fn(&T) -> A) -> A { return use(&value.*) }
pub fn finite(left: &Intrinsic.SharedCore<i32>, right: &Intrinsic.SharedCore<i32>) -> bool {
  return Lens.with<i32, bool>(left, fn(first: &i32) -> bool {
    return Lens.with<i32, bool>(right, fn(second: &i32) -> bool { return first.* == second.* })
  })
}
pub fn finiteRoot(left: &'static Intrinsic.SharedCore<i32>, right: &'static Intrinsic.SharedCore<i32>) -> bool {
  return finite(left, right)
}
fn relay(token: &i32, g: fn(&i32) -> i32) -> i32 { return g(token) }
fn wrapLoop(g: fn(&i32) -> i32) -> i32 { return wrapLoop(relay(g)) }
pub fn growingSections() -> i32 { return wrapLoop(fn(token: &i32) -> i32 { return token.* }) }
pub struct Left {}
pub struct Right {}
effect fn firstOpaque() -> i32 { return 41 }
effect fn secondOpaque() -> i32 { return 42 }
fn chooseOpaque(flag: bool) -> Effect<'static; i32> {
  if flag { return firstOpaque() }
  return secondOpaque()
}
effect fn executeOpaque<'env, P>(inner: once Effect<'env; i32>, marker: &'env P) -> i32 {
  return run inner
}
pub fn finiteOpaque(left: &'static Left, right: &'static Right) -> i32 {
  return run executeOpaque(executeOpaque(chooseOpaque(false), left), right)
}
pub struct Middle {}
pub fn nestedOpaque(left: &'static Left, middle: &'static Middle, right: &'static Right) -> i32 {
  return run executeOpaque(executeOpaque(executeOpaque(chooseOpaque(true), left), middle), right)
}
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &id, &source) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut index = SourceIndex.make(run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator))
  let growingRoot = run selectedApplicationOf(&mut index, &id, b"growing") |> Effect.provideMut<Allocator>(&mut allocator)
  let polymorphicRoot = run selectedApplicationOf(&mut index, &id, b"polymorphic") |> Effect.provideMut<Allocator>(&mut allocator)
  let unboundedRoot = run selectedApplicationOf(&mut index, &id, b"unbounded") |> Effect.provideMut<Allocator>(&mut allocator)
  let finiteRoot = run selectedApplicationOf(&mut index, &id, b"finiteRoot") |> Effect.provideMut<Allocator>(&mut allocator)
  let sectionRoot = run selectedApplicationOf(&mut index, &id, b"growingSections") |> Effect.provideMut<Allocator>(&mut allocator)
  let opaqueRoot = run selectedApplicationOf(&mut index, &id, b"finiteOpaque") |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedRoot = run selectedApplicationOf(&mut index, &id, b"nestedOpaque") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = makeSemantic(move revision)
  let mut request = Request.make()
  let growing = run Semantic.closeStaticChain(&mut store, &mut request, &growingRoot, 16)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let polymorphic = run Semantic.closeStaticChain(&mut store, &mut request, &polymorphicRoot, 16)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unbounded = run Semantic.closeStaticChain(&mut store, &mut request, &unboundedRoot, 16)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(closureRefused(&growing, RejectionCode.ExpandingSpecialization, usize.ZERO) &&
    closureRefused(&polymorphic, RejectionCode.ExpandingSpecialization, usize.ZERO) &&
    closureRefused(&unbounded, RejectionCode.ExpandingSpecialization, usize.ZERO),
    "a closure whose identity carries the growing owner, and a local closure re-entering its generic owner directly or through a received callable, are declaration recursion")
  let finite = run Semantic.closeStaticChain(&mut store, &mut request, &finiteRoot, 24)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(finiteContinuationClosure(&finite, &id),
    "two scoped adapters keep T=i32 and A=bool while their original outer and nested callbacks form a real finite MIR closure")
  let sections = run Semantic.closeStaticChain(&mut store, &mut request, &sectionRoot, 16)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let sectionStart = offsetOf(text, "wrapLoop(relay(g))", usize.ZERO)
  let sectionSpan = Span {start: sectionStart, end: sectionStart + String.utf8Bytes("wrapLoop(relay(g))").length}
  run Testing.expect(closureRefused(&sections, RejectionCode.ExpandingSpecialization, usize.ZERO) &&
    (run growingSectionPath(&sections, &id, sectionSpan) |> Effect.provideMut<Allocator>(&mut allocator)),
    "repeated named-section wrapping still rejects growth after its original relay and callback target set has stabilized")
  let opaque = run Semantic.closeStaticChain(&mut store, &mut request, &opaqueRoot, 24)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(finiteOpaqueClosure(&opaque, &id),
    "two ordinary executors close a real MIR chain through the original opaque producer, retaining their distinct selected markers and inner capture")
  let nested = run Semantic.closeStaticChain(&mut store, &mut request, &nestedRoot, 24)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(nestedOpaqueExecutors(&nested, &id) == 3,
    "an executor running a received Effect enters the producer its argument type names, so three nested executors with distinct markers close")
  return ()
}

// The executeOpaque instances a certified closure reached, or `usize.MAX` when it did not close.
fn nestedOpaqueExecutors(closure: &StaticClosure, id: &ModuleId) -> usize {
  if let StaticClosure.Certified {evidence} = &closure.* {
    let nodes = Vector.asSlice<SpecializationApplication>(&evidence.nodes)
    let mut count = usize.ZERO
    let mut at = usize.ZERO
    while at < nodes.length {
      if finiteOpaqueFunction(SpecializationApplication.bodyDeclaration(&nodes[at]), id, b"executeOpaque") { count = count + usize.ONE }
      at = at + usize.ONE
    }
    return count
  }
  return usize.MAX
}

fn finiteOpaqueClosure(closure: &StaticClosure, id: &ModuleId) -> bool {
  if let StaticClosure.Certified {evidence} = &closure.* {
    let nodes = Vector.asSlice<SpecializationApplication>(&evidence.nodes)
    let mut outer = usize.ZERO
    let mut inner = usize.ZERO
    let mut producer = usize.ZERO
    let mut first = usize.ZERO
    let mut second = usize.ZERO
    let mut at = usize.ZERO
    while at < nodes.length {
      let body = SpecializationApplication.bodyDeclaration(&nodes[at])
      if !ModuleId.equals(DeclarationId.moduleId(body), id) { return false }
      if finiteOpaqueFunction(body, id, b"executeOpaque") {
        let depth = finiteOpaqueExecutor(&nodes[at], id)
        if depth == usize.ONE { inner = inner + usize.ONE }
        else if depth == usize.ONE + usize.ONE { outer = outer + usize.ONE }
        else { return false }
      }
      if finiteOpaqueFunction(body, id, b"chooseOpaque") {
        if !finiteOpaqueProducerApplication(&nodes[at], id) { return false }
        producer = producer + usize.ONE
      }
      if finiteOpaqueFunction(body, id, b"firstOpaque") { first = first + usize.ONE }
      if finiteOpaqueFunction(body, id, b"secondOpaque") { second = second + usize.ONE }
      at = at + usize.ONE
    }
    return outer == usize.ONE && inner == usize.ONE && producer == usize.ONE
      && first == usize.ONE && second == usize.ONE
  }
  return false
}

fn finiteOpaqueFunction(value: &DeclarationId, id: &ModuleId, name: &[u8]) -> bool {
  return ModuleId.equals(DeclarationId.moduleId(value), id) && DeclarationId.ownerCount(value) == usize.ONE
    && DeclarationId.ownerKind(value, usize.ZERO) == OwnerKind.Function && DeclarationId.named(value, name)
}

fn finiteOpaqueProducerApplication(value: &SpecializationApplication, id: &ModuleId) -> bool {
  return finiteOpaqueFunction(SpecializationApplication.bodyDeclaration(value), id, b"chooseOpaque")
    && Vector.length<Argument>(&value.arguments) == usize.ZERO
    && Vector.length<usize>(&value.argumentOrdinals) == usize.ZERO
    && Vector.length<ScopeBinding>(&value.scopes) == usize.ZERO
    && Vector.length<StaticSlot>(&value.statics) == usize.ZERO
}

fn finiteOpaqueProducer(value: &Type, id: &ModuleId) -> bool {
  if let Type.OpaqueRepresentation {application, ..} = &value.* {
    return Shared.with<SpecializationApplication, bool>(&application, fn(selected: &SpecializationApplication) -> bool {
      return finiteOpaqueProducerApplication(selected, id)
    })
  }
  return false
}

fn finiteOpaqueExecutor(value: &SpecializationApplication, id: &ModuleId) -> usize {
  if !finiteOpaqueFunction(SpecializationApplication.bodyDeclaration(value), id, b"executeOpaque")
    || Vector.length<ScopeBinding>(&value.scopes) != usize.ZERO
    || Vector.length<StaticSlot>(&value.statics) != usize.ZERO { return usize.MAX }
  let arguments = Vector.asSlice<Argument>(&value.arguments)
  let ordinals = Vector.asSlice<usize>(&value.argumentOrdinals)
  if arguments.length != 3 || ordinals.length != 3 || ordinals[usize.ZERO] != usize.ZERO
    || ordinals[usize.ONE] != usize.ONE || ordinals[2] != 2 { return usize.MAX }
  if let Argument.Lifetime {value: region} = &arguments[usize.ZERO] {
    if !Shared.with<Lifetime, bool>(&region, validityIsStatic) { return usize.MAX }
  } else { return usize.MAX }
  if let Argument.Type {value: marker} = &arguments[usize.ONE] {
    let left = Shared.with<Type, bool>(&marker, fn(ty: &Type) -> bool { return finiteOpaqueMarker(ty, id, b"Left") })
    let right = Shared.with<Type, bool>(&marker, fn(ty: &Type) -> bool { return finiteOpaqueMarker(ty, id, b"Right") })
    if let Argument.Type {value: representation} = &arguments[2] {
      if left && Shared.with<Type, bool>(&representation, fn(ty: &Type) -> bool { return finiteOpaqueProducer(ty, id) }) { return usize.ONE }
      if right && Shared.with<Type, bool>(&representation, fn(ty: &Type) -> bool { return finiteOpaqueStoredExecutor(ty, id) }) { return usize.ONE + usize.ONE }
    }
  }
  return usize.MAX
}

fn finiteOpaqueMarker(value: &Type, id: &ModuleId, name: &[u8]) -> bool {
  if let Type.Nominal {declaration, arguments, ..} = &value.* {
    return ModuleId.equals(DeclarationId.moduleId(&declaration), id) && DeclarationId.ownerCount(&declaration) == usize.ONE
      && DeclarationId.ownerKind(&declaration, usize.ZERO) == OwnerKind.Struct && DeclarationId.named(&declaration, name)
      && Vector.length<Argument>(&arguments) == usize.ZERO
  }
  return false
}

fn finiteOpaqueStoredExecutor(value: &Type, id: &ModuleId) -> bool {
  if let Type.CallableValue {application, captures, fieldInputs, ..} = &value.* {
    if Shared.with<SpecializationApplication, usize>(&application, fn(selected: &SpecializationApplication) -> usize {
      return finiteOpaqueExecutor(selected, id)
    }) != usize.ONE { return false }
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    let inputs = Vector.asSlice<CallableFieldInput>(&fieldInputs)
    if fields.length != 2 || inputs.length != 2 { return false }
    let mut at = usize.ZERO
    while at < inputs.length {
      if let CallableFieldInput.Argument {parameter} = &inputs[at] {
        if parameter != at { return false }
      } else { return false }
      at = at + usize.ONE
    }
    if !Shared.with<Type, bool>(&fields[usize.ZERO], fn(ty: &Type) -> bool { return finiteOpaqueProducer(ty, id) }) { return false }
    return Shared.with<Type, bool>(&fields[usize.ONE], fn(ty: &Type) -> bool { return finiteOpaqueMarkerReference(ty, id) })
  }
  return false
}

fn finiteOpaqueMarkerReference(value: &Type, id: &ModuleId) -> bool {
  if let Type.Reference {referent, access, lifetime} = &value.* {
    return access == Access.Shared && Shared.with<Lifetime, bool>(&lifetime, validityIsStatic)
      && Shared.with<Type, bool>(&referent, fn(ty: &Type) -> bool { return finiteOpaqueMarker(ty, id, b"Left") })
  }
  return false
}

// A source-originated complete MIR closure is the admission oracle; its applications retain
// the exact scope/own binding coordinates and captures that made the two adapters distinct.
fn finiteContinuationClosure(closure: &StaticClosure, id: &ModuleId) -> bool {
  if let StaticClosure.Certified {evidence} = &closure.* {
    let nodes = Vector.asSlice<SpecializationApplication>(&evidence.nodes)
    let mut outer = usize.ZERO
    let mut inner = usize.ZERO
    let mut inspectOuter = usize.ZERO
    let mut inspectInner = usize.ZERO
    let mut callbackOuter = usize.ZERO
    let mut callbackInner = usize.ZERO
    let mut at = usize.ZERO
    while at < nodes.length {
      let body = SpecializationApplication.bodyDeclaration(&nodes[at])
      if !ModuleId.equals(DeclarationId.moduleId(body), id) { return false }
      if DeclarationId.named(body, b"withMut") {
        let depth = finiteAdapterApplication(&nodes[at], id)
        if depth == usize.ONE { outer = outer + usize.ONE }
        else if depth == 2 { inner = inner + usize.ONE }
        else { return false }
      }
      if DeclarationId.named(body, b"inspect") {
        let depth = finiteInspectApplication(&nodes[at], id)
        if depth == usize.ONE { inspectOuter = inspectOuter + usize.ONE }
        else if depth == 2 { inspectInner = inspectInner + usize.ONE }
        else { return false }
      }
      if finiteAnonymous(body, id, b"finite", usize.ONE) { callbackOuter = callbackOuter + usize.ONE }
      if finiteAnonymous(body, id, b"finite", 2) { callbackInner = callbackInner + usize.ONE }
      at = at + usize.ONE
    }
    return outer == usize.ONE && inner == usize.ONE && inspectOuter == usize.ONE && inspectInner == usize.ONE && callbackOuter == usize.ONE && callbackInner == usize.ONE
  }
  return false
}

fn finiteAnonymous(value: &DeclarationId, id: &ModuleId, root: &[u8], depth: usize) -> bool {
  if !ModuleId.equals(DeclarationId.moduleId(value), id) { return false }
  let steps = DeclarationId.ownerCount(value)
  if steps != depth + usize.ONE || DeclarationId.ownerKind(value, usize.ZERO) != OwnerKind.Function { return false }
  if !DeclarationId.ownerNamed(value, usize.ZERO) || !sameBytes(DeclarationId.ownerName(value, usize.ZERO), root) { return false }
  let mut at = usize.ONE
  while at < steps {
    if DeclarationId.ownerKind(value, at) != OwnerKind.Anonymous || DeclarationId.ownerOccurrence(value, at) != usize.ZERO { return false }
    at = at + usize.ONE
  }
  return true
}

fn finiteParent(scope: &DeclarationId, child: &DeclarationId) -> bool {
  return DeclarationId.ownerCount(scope) + usize.ONE == DeclarationId.ownerCount(child) && DeclarationId.isPrefixOf(scope, child)
}

fn finiteAdapterApplication(value: &SpecializationApplication, id: &ModuleId) -> usize {
  let body = SpecializationApplication.bodyDeclaration(value)
  let arguments = Vector.asSlice<Argument>(&value.arguments)
  let ordinals = Vector.asSlice<usize>(&value.argumentOrdinals)
  let scopes = Vector.asSlice<ScopeBinding>(&value.scopes)
  if arguments.length != ordinals.length || scopes.length != usize.ONE { return usize.MAX }
  let scoped = Vector.asSlice<Argument>(&scopes[usize.ZERO].arguments)
  let slots = Vector.asSlice<usize>(&scopes[usize.ZERO].argumentOrdinals)
  if scoped.length != usize.ONE || slots.length != usize.ONE || slots[usize.ZERO] != usize.ZERO
    || !genericSectionArgument(&scoped[usize.ZERO], b"i32")
    || !Shared.with<DeclarationId, bool>(&scopes[usize.ZERO].owner, fn(owner: &DeclarationId) -> bool { return finiteParent(owner, body) }) { return usize.MAX }
  let mut result = usize.ZERO
  let mut depth = usize.MAX
  let mut at = usize.ZERO
  while at < arguments.length {
    if ordinals[at] == usize.ZERO {
      if !genericSectionArgument(&arguments[at], b"bool") { return usize.MAX }
      result = result + usize.ONE
    }
    if let Argument.Type {value: ty} = &arguments[at] {
      if ordinals[at] == 3 {
        depth = Shared.with<Type, usize>(&ty, fn(capture: &Type) -> usize { return finiteAdapterSection(capture, id) })
      } else if ordinals[at] != usize.ZERO { return usize.MAX }
    }
    at = at + usize.ONE
  }
  if result != usize.ONE { return usize.MAX }
  return depth
}

fn finiteAdapterSection(value: &Type, id: &ModuleId) -> usize {
  if let Type.CallableSchema {schema, captures, fieldInputs, ..} = &value.* {
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    let inputs = Vector.asSlice<CallableFieldInput>(&fieldInputs)
    if fields.length != usize.ONE || inputs.length != usize.ONE { return usize.MAX }
    if let CallableFieldInput.Argument {parameter} = &inputs[usize.ZERO] {
      if parameter != usize.ONE { return usize.MAX }
    } else { return usize.MAX }
    if !Shared.with<SectionSchema, bool>(&schema, fn(recipe: &SectionSchema) -> bool {
      return sharedCallbackSchemaSelected(recipe, id, b"bool")
    }) { return usize.MAX }
    return Shared.with<Type, usize>(&fields[usize.ZERO], fn(capture: &Type) -> usize { return finiteCapturedCallback(capture, id) })
  }
  return usize.MAX
}

fn finiteInspectApplication(value: &SpecializationApplication, id: &ModuleId) -> usize {
  let arguments = Vector.asSlice<Argument>(&value.arguments)
  let ordinals = Vector.asSlice<usize>(&value.argumentOrdinals)
  if arguments.length != ordinals.length { return usize.MAX }
  let mut element = usize.ZERO
  let mut result = usize.ZERO
  let mut depth = usize.MAX
  let mut at = usize.ZERO
  while at < arguments.length {
    if ordinals[at] == usize.ZERO {
      if !genericSectionArgument(&arguments[at], b"i32") { return usize.MAX }
      element = element + usize.ONE
    }
    if ordinals[at] == usize.ONE {
      if !genericSectionArgument(&arguments[at], b"bool") { return usize.MAX }
      result = result + usize.ONE
    }
    if let Argument.Type {value: ty} = &arguments[at] {
      if ordinals[at] == 4 {
        depth = Shared.with<Type, usize>(&ty, fn(capture: &Type) -> usize { return finiteCapturedCallback(capture, id) })
      } else if ordinals[at] > usize.ONE { return usize.MAX }
    }
    at = at + usize.ONE
  }
  if element != usize.ONE || result != usize.ONE { return usize.MAX }
  return depth
}

fn finiteCapturedCallback(value: &Type, id: &ModuleId) -> usize {
  if let Type.CallableValue {application, captures, fieldInputs, ..} = &value.* {
    let depth = Shared.with<SpecializationApplication, usize>(&application, fn(call: &SpecializationApplication) -> usize {
      let body = SpecializationApplication.bodyDeclaration(call)
      if finiteAnonymous(body, id, b"finite", usize.ONE) { return usize.ONE }
      if finiteAnonymous(body, id, b"finite", 2) { return 2 }
      return usize.MAX
    })
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    let inputs = Vector.asSlice<CallableFieldInput>(&fieldInputs)
    // An unstaged anonymous body receives the whole environment at zero; explicit field inputs
    // belong to staged sections. Keep its actual single retained reference distinct below.
    if depth == usize.MAX || fields.length != usize.ONE || inputs.length != usize.ZERO { return usize.MAX }
    let retained = Shared.with<Type, bool>(&fields[usize.ZERO], fn(capture: &Type) -> bool {
      return finiteCaptureReference(capture, depth)
    })
    if !retained { return usize.MAX }
    return depth
  }
  return usize.MAX
}

fn finiteCaptureReference(value: &Type, depth: usize) -> bool {
  if let Type.Reference {access, referent, lifetime} = &value.* {
    if access != Access.Shared { return false }
    let isStatic = Shared.with<Lifetime, bool>(&lifetime, validityIsStatic)
    if depth == usize.ONE && !isStatic { return false }
    if depth == 2 && isStatic { return false }
    return Shared.with<Type, bool>(&referent, fn(element: &Type) -> bool {
      if depth == 2 { return witnessPrimitive(element, b"i32") }
      if let Type.Nominal {declaration, arguments, ..} = &element.* {
        let given = Vector.asSlice<Argument>(&arguments)
        return DeclarationId.named(&declaration, b"SharedCore") && given.length == usize.ONE && genericSectionArgument(&given[usize.ZERO], b"i32")
      }
      return false
    })
  }
  return false
}

struct GrowingSectionSelection { value: Shared<Type> ordinal: usize }

struct GrowingSectionPair { first: GrowingSectionSelection last: GrowingSectionSelection }

effect fn growingSectionPath(closure: &StaticClosure, id: &ModuleId, span: Span) -> bool ! OutOfMemoryError ? &mut Allocator {
  if let StaticClosure.Rejected {diagnostic} = &closure.* {
    let selected = Shared.with<Rejection, Option<GrowingSectionPair>>(&diagnostic, fn(found: &Rejection) -> Option<GrowingSectionPair> {
      let path = Vector.asSlice<SpecializationApplication>(&found.specialization)
      if found.code != RejectionCode.ExpandingSpecialization || found.span.start != span.start || found.span.end != span.end
        || path.length < 2 { return Option.none<GrowingSectionPair>() }
      let first = &path[usize.ZERO]
      let last = &path[path.length - usize.ONE]
      if !sharedCallbackTarget(SpecializationApplication.bodyDeclaration(first), id, b"wrapLoop")
        || !DeclarationId.equals(SpecializationApplication.bodyDeclaration(first), SpecializationApplication.bodyDeclaration(last)) { return Option.none<GrowingSectionPair>() }
      let one = match move growingRelayArgument(first, id) { Option<GrowingSectionSelection>.Some {value} => move value _ => { return Option.none<GrowingSectionPair>() } }
      let two = match move growingRelayArgument(last, id) { Option<GrowingSectionSelection>.Some {value} => move value _ => { return Option.none<GrowingSectionPair>() } }
      return Option.some<GrowingSectionPair>(GrowingSectionPair {first: move one, last: move two})
    })
    if let Option<GrowingSectionPair>.Some {value: pair} = move selected {
      let first = run growingRelayDepth(&pair.first.value, id)
      let last = run growingRelayDepth(&pair.last.value, id)
      return pair.first.ordinal == pair.last.ordinal && first > usize.ZERO && first < usize.MAX && last == first + usize.ONE
    }
  }
  return false
}

fn growingRelayArgument(value: &SpecializationApplication, id: &ModuleId) -> Option<GrowingSectionSelection> {
  let arguments = Vector.asSlice<Argument>(&value.arguments)
  let ordinals = Vector.asSlice<usize>(&value.argumentOrdinals)
  if arguments.length != ordinals.length { return Option.none<GrowingSectionSelection>() }
  let mut found = Option.none<GrowingSectionSelection>()
  let mut at = usize.ZERO
  while at < arguments.length {
    if let Argument.Type {value: ty} = &arguments[at] {
      if Shared.with<Type, bool>(&ty, fn(capture: &Type) -> bool { return growingRelaySection(capture, id) }) {
        if let Option<GrowingSectionSelection>.Some {..} = &found { return Option.none<GrowingSectionSelection>() }
        found = Option.some<GrowingSectionSelection>(GrowingSectionSelection {value: Shared.clone<Type>(&ty), ordinal: ordinals[at]})
      }
    }
    at = at + usize.ONE
  }
  return move found
}

fn growingRelaySection(value: &Type, id: &ModuleId) -> bool {
  if let Type.CallableSchema {schema, captures, fieldInputs, ..} = &value.* {
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    let inputs = Vector.asSlice<CallableFieldInput>(&fieldInputs)
    if fields.length != usize.ONE || inputs.length != usize.ONE { return false }
    if let CallableFieldInput.Argument {parameter} = &inputs[usize.ZERO] {
      if parameter != usize.ONE { return false }
    } else { return false }
    return Shared.with<SectionSchema, bool>(&schema, fn(recipe: &SectionSchema) -> bool {
      return sharedCallbackSchemaTarget(recipe, id, b"relay")
    })
  }
  return false
}

fn growingRelayLeaf(value: &Type, id: &ModuleId) -> bool {
  if let Type.CallableValue {application, captures, ..} = &value.* {
    return Vector.length<Shared<Type>>(&captures) == usize.ZERO && Shared.with<SpecializationApplication, bool>(&application,
      fn(call: &SpecializationApplication) -> bool { return finiteAnonymous(SpecializationApplication.bodyDeclaration(call), id, b"growingSections", usize.ONE) })
  }
  return false
}

// Clone one shallow capture while borrowed; inspect its next layer only after releasing that loan.
effect fn growingRelayDepth(value: &Shared<Type>, id: &ModuleId) -> usize ! OutOfMemoryError ? &mut Allocator {
  let mut current = Shared.clone<Type>(value)
  let mut depth = usize.ZERO
  while depth < 8 {
    let leaf = Shared.with<Type, bool>(&current, fn(capture: &Type) -> bool {
      return growingRelayLeaf(capture, id)
    })
    if leaf { return depth }
    let next = Shared.with<Type, Option<Shared<Type>>>(&current, fn(capture: &Type) -> Option<Shared<Type>> {
      if !growingRelaySection(capture, id) { return Option.none<Shared<Type>>() }
      if let Type.CallableSchema {captures, ..} = &capture.* {
        let fields = Vector.asSlice<Shared<Type>>(&captures)
        return Option.some<Shared<Type>>(Shared.clone<Type>(&fields[usize.ZERO]))
      }
      return Option.none<Shared<Type>>()
    })
    current = match move next { Option<Shared<Type>>.Some {value: nested} => move nested _ => { return usize.MAX } }
    depth = depth + usize.ONE
  }
  return usize.MAX
}

// Re-entry compares recursion families: a declaration with its received callable targets
// (bootstrap `recursionFamily`). Nested catchFailure wrappers with distinct handlers are separate
// families, even when an inner failure type contains the outer one.
test effect fn genericReentryThroughRepresentationsIsAdmitted() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let nestedId = run module("catch-failure-nested.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedText = """
struct Selected { code: i32 }
struct Residual { code: i32 }
effect fn guarded<'env, A, B, E, F, ?R, ?S>(self: once Effect<'env; A ! E ? R>, onFailure: once fn<'env>(E) -> once Effect<'env; B ! F ? S>) -> A | B ! F ? R | S {
  return run Intrinsic.catchFailure<E>(move self, move onFailure)
}
effect fn inner() -> i32 ! Selected { return 1 }
effect fn innerRecovered(problem: Selected) -> i32 { return 7 }
effect fn outer() -> i32 ! Selected { return run guarded(inner(), innerRecovered) }
effect fn recoverSelected(problem: Selected) -> i32 { return 3 }
pub fn main() -> i32 { return run guarded(outer(), recoverSelected) }
effect fn residual() -> i32 ! Residual { return run guarded(inner(), innerRecovered) }
effect fn recoverResidual(problem: Residual) -> i32 { return 3 }
pub fn changing() -> i32 { return run guarded(residual(), recoverResidual) }
"""
  let nestedSource = run present(nestedText) |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedRevision = run Revision.publish(&Revision.make(), &nestedId, &nestedSource) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut nestedIndex = SourceIndex.make(run Revision.copy(&nestedRevision) |> Effect.provideMut<Allocator>(&mut allocator))
  let root = run selectedApplicationOf(&mut nestedIndex, &nestedId, b"main") |> Effect.provideMut<Allocator>(&mut allocator)
  let changingRoot = run selectedApplicationOf(&mut nestedIndex, &nestedId, b"changing") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut nestedStore = makeSemantic(move nestedRevision)
  let mut nestedRequest = Request.make()
  let nested = run Semantic.closeStaticChain(&mut nestedStore, &mut nestedRequest, &root, 16)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let changing = run Semantic.closeStaticChain(&mut nestedStore, &mut nestedRequest, &changingRoot, 16)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let admitted = match &nested { StaticClosure.Certified {..} => true _ => false }
  let separate = match &changing { StaticClosure.Certified {..} => true _ => false }
  run Testing.expect(admitted && separate,
    "nested handlers with distinct targets are separate recursion families and are admitted")
  return ()
}

test effect fn finalizersRunOnEveryExit() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("finalizers.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Problem { code: i32 }
effect fn work(mode: i32) -> i32 ! Problem {
  if mode == 0 { return 1 }
  fail Problem { code: 2 }
}
effect fn tidy() -> () { return () }
effect fn finalized(mode: i32) -> i32 ! Problem { return run Intrinsic.finalizeEffect(work(mode), tidy()) }
effect fn stubborn() -> () ! Problem { fail Problem { code: 3 } }
effect fn fallible() -> i32 ! Problem { return run Intrinsic.finalizeEffect(work(0), stubborn()) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let finalized = run Semantic.demandMir(&mut store, &mut request, &id, b"finalized") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(callCount(&store, &finalized, "work") == usize.ONE && callCount(&store, &finalized, "tidy") == 2 &&
    failureFact(&store, &finalized, 2) == usize.ONE && failureFact(&store, &finalized, usize.ONE) == usize.ONE,
    "the finalizer runs on the success and the failure exit, then the held failure is raised")
  let fallible = run Semantic.demandBody(&mut store, &mut request, &id, b"fallible") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&fallible, RejectionCode.TypeMismatch, text, "stubborn()", usize.ONE),
    "a finalizer that can fail is rejected at the finalizer")
  return ()
}

test effect fn nonParkingFinalizersAreAdmitted() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("nonparking-finalizers.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Problem { code: i32 }
effect fn work() -> i32 ! Problem { fail Problem { code: 2 } }
effect fn tidy() -> () { return () }
effect fn stall() -> () { return run Intrinsic.park() }
effect<'env> fn scoped<'env, Resource: 'env, A, E, ?R, ?S,
  Release: for<'scope> once fn<'env>(&'scope mut Resource) -> once Effect<'scope & 'env; () ! never ? S> + Intrinsic.NonParking>(
  resource: Resource, use: for<'scope> once fn<'env>(&'scope mut Resource) -> once Effect<'scope & 'env; A ! E ? R>,
  release: Release) -> A ! E ? R | S {
  return run Intrinsic.useReleaseNonParking<Resource, A, E, R, S>(move resource, move use, move release)
}
effect fn guarded<'env, A, E, ?R, ?S, F: once Effect<'env; () ! never ? S> + Intrinsic.NonParking>(
  self: once Effect<'env; A ! E ? R>, finalizer: F) -> A ! E ? R | S {
  return run Intrinsic.finalizeEffectNonParking<A, E, R, S>(move self, move finalizer)
}
effect fn guardedWork() -> i32 ! Problem { return run guarded(work(), tidy()) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let scoped = run Semantic.demandBody(&mut store, &mut request, &id, b"scoped") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&scoped), "useReleaseNonParking lends the resource to both bounded callables")
  let guarded = run Semantic.demandMir(&mut store, &mut request, &id, b"guardedWork") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lowered = false
  if let Option<InstanceKey>.Some {value: key} = move soleReference(&store, &guarded) {
    let selected = run InstanceKey.selected(&key) |> Effect.provideMut<Allocator>(&mut allocator)
    let instance = run Semantic.demandApplicationMir(&mut store, &mut request, &selected)
      |> Effect.provideMut<Allocator>(&mut allocator)
    lowered = callCount(&store, &instance, "tidy") == 2 && failureFact(&store, &instance, usize.ONE) == usize.ONE
  }
  run Testing.expect(lowered, "a NonParking bound is admitted at its call and its instance finalizes both exits")
  let stall = run Semantic.demandMir(&mut store, &mut request, &id, b"stall") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(suspensionGapAt(&stall, offsetOf(text, "park()", usize.ZERO)),
    "a parking finalizer still reports the suspension gap at its park")
  return ()
}

test effect fn reentryWithContainedFailureIsASeparateFamily() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("catch-failure-contained.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Selected { code: i32 }
struct Wrapped<T> { value: T }
effect fn guarded<'env, A, B, E, F, ?R, ?S>(self: once Effect<'env; A ! E ? R>, onFailure: once fn<'env>(E) -> once Effect<'env; B ! F ? S>) -> A | B ! F ? R | S {
  return run Intrinsic.catchFailure<E>(move self, move onFailure)
}
effect fn recoverSelected(problem: Selected) -> i32 { return 3 }
effect fn wrapped() -> i32 ! Wrapped<Selected> { return 1 }
effect fn unwrapFailure(problem: Wrapped<Selected>) -> i32 ! Selected { return 2 }
pub fn widening() -> i32 { return run guarded(guarded(wrapped(), unwrapFailure), recoverSelected) }
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &id, &source) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut index = SourceIndex.make(run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator))
  let root = run selectedApplicationOf(&mut index, &id, b"widening") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = makeSemantic(move revision)
  let mut request = Request.make()
  let closure = run Semantic.closeStaticChain(&mut store, &mut request, &root, 16) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(match &closure { StaticClosure.Certified {..} => true _ => false },
    "an inner failure containing the outer one re-enters through a distinct handler, a separate recursion family")
  return ()
}

test effect fn reentryWithTheSameCallableDescends() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("same-step-repeated.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
effect fn passing<'env, A, E, ?R>(self: once Effect<'env; A ! E ? R>, step: fn(i32) -> i32) -> A ! E ? R { return run move self }
effect fn base() -> i32 { return 4 }
fn inc(value: i32) -> i32 { return value + 1 }
pub fn repeated() -> i32 { return run passing(passing(passing(base(), inc), inc), inc) }
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &id, &source) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut index = SourceIndex.make(run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator))
  let root = run selectedApplicationOf(&mut index, &id, b"repeated") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = makeSemantic(move revision)
  let mut request = Request.make()
  let closure = run Semantic.closeStaticChain(&mut store, &mut request, &root, 16) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(match &closure { StaticClosure.Certified {..} => true _ => false },
    "re-entry with the same callable descends into the wrapped Effect and is admitted")
  return ()
}

test effect fn partialMovesDropTheRemainingChildren() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("partial-moves.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn consume(token: Token) -> i32 { return token.value }
struct Pair { first: Token count: i32 second: Token }
struct Guard { token: Token }
impl Drop for Guard { fn drop(self: &mut Guard) -> () { return () } }
union Cell { Vacant, Held { token: Token, code: i32 } }
fn partial() -> i32 {
  let pair = Pair { first: Token { value: 1 }, count: 2, second: Token { value: 3 } }
  let used = consume(move pair.first)
  return 0
}
fn refilled() -> i32 {
  let mut pair = Pair { first: Token { value: 1 }, count: 2, second: Token { value: 3 } }
  let used = consume(move pair.first)
  pair.first = Token { value: 4 }
  return 0
}
fn bound(slot: Cell) -> i32 {
  return match move slot {
    Cell.Held {token, ..} => consume(move token)
    Cell.Vacant => 0
  }
}
fn guarded(guard: Guard) -> i32 { return consume(move guard.token) }
struct Coded { code: i32 }
impl Drop for Coded { fn drop(self: &mut Coded) -> () { return () } }
fn make() -> Token { return Token { value: 1 } }
fn droppedCode(coded: Coded) -> i32 {
  drop coded.code
  return 0
}
fn matchedCode(coded: Coded) -> i32 { return match move coded.code { _ => 0 } }
fn diverged(flag: bool, pair: Pair) -> i32 {
  if flag { let used = consume(move pair.first) }
  let kept = pair.count
  return kept
}
fn consumePair(pair: Pair) -> i32 { return pair.count }
fn conditional(flag: bool, pair: Pair) -> i32 {
  if flag { let used = consumePair(Pair { first: move pair.first, count: pair.count, second: move pair.second }) }
  let kept = pair.count
  return kept
}
fn conditionalRefilled(flag: bool, pair: Pair) -> i32 {
  let mut owned = move pair
  if flag { let used = consumePair(Pair { first: move owned.first, count: owned.count, second: move owned.second }) }
  let kept = owned.count
  owned.first = Token { value: 4 }
  return kept
}
fn mirrored(flag: bool, pair: Pair) -> i32 {
  if flag { let used = consumePair(Pair { first: move pair.first, count: pair.count, second: move pair.second }) }
  else { let used = consumePair(Pair { second: move pair.second, count: pair.count, first: move pair.first }) }
  let kept = pair.count
  return kept
}
fn indexed(at: usize) -> i32 {
  let mut tokens = [Token { value: 1 }, Token { value: 2 }]
  let used = consume(move tokens[0])
  tokens[at] = make()
  return 0
}
struct Empty {}
struct Mailbox { held: Token | Empty }
fn stored(mailbox: &mut Mailbox, token: Token) -> i32 {
  mailbox.held = move token
  return 0
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let stored = run Semantic.demandMir(&mut store, &mut request, &id, b"stored") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &stored, usize.ZERO) == usize.ONE,
    "a place moved into a union slot leaves its owner; only the displaced value is dropped")
  let partial = run Semantic.demandMir(&mut store, &mut request, &id, b"partial") |> Effect.provideMut<Allocator>(&mut allocator)
  let refilled = run Semantic.demandMir(&mut store, &mut request, &id, b"refilled") |> Effect.provideMut<Allocator>(&mut allocator)
  let bound = run Semantic.demandMir(&mut store, &mut request, &id, b"bound") |> Effect.provideMut<Allocator>(&mut allocator)
  let guarded = run Semantic.demandBody(&mut store, &mut request, &id, b"guarded") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &partial, usize.ZERO) == usize.ONE && glueFact(&store, &partial, 3) == 2,
    "a partly moved owner drops only its remaining droppable field, never the whole value")
  run Testing.expect(glueFact(&store, &refilled, usize.ZERO) == usize.ONE && glueFact(&store, &refilled, 3) == usize.MAX,
    "writing the moved field back makes the owner whole again without a replacement drop")
  run Testing.expect(glueFact(&store, &bound, usize.ZERO) == usize.ONE && glueFact(&store, &bound, 3) == usize.MAX &&
    cleanupFact(&store, &bound, usize.ZERO) == usize.ZERO,
    "a match binding moved out of the consumed subject leaves nothing for its arm to drop; the other arm drops the whole subject")
  run Testing.expect(rejectsSpan(&guarded, RejectionCode.ExtractionBoundary, text, "move guard.token", 0),
    "a hole beneath a Drop-hooked ancestor is rejected (OWN0002)")
  let droppedCode = run Semantic.demandBody(&mut store, &mut request, &id, b"droppedCode") |> Effect.provideMut<Allocator>(&mut allocator)
  let matchedCode = run Semantic.demandBody(&mut store, &mut request, &id, b"matchedCode") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&droppedCode, RejectionCode.ExtractionBoundary, text, "drop coded.code", 0) &&
    rejectsSpan(&matchedCode, RejectionCode.ExtractionBoundary, text, "match move coded.code { _ => 0 }", 0),
    "dropping or consuming a Copy field of a Drop-hooked owner is rejected at the statement or the whole match (OWN0002)")
  let diverged = run Semantic.demandMir(&mut store, &mut request, &id, b"diverged") |> Effect.provideMut<Allocator>(&mut allocator)
  let indexed = run Semantic.demandMir(&mut store, &mut request, &id, b"indexed") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(cleanupGapAt(&indexed, text, "tokens[at] = make()", 0),
    "a runtime-index write beside a moved element remains the exact cleanup gap")
  let tokenSignature = run Semantic.demandSignature(&mut store, &mut request, &id, b"consume") |> Effect.provideMut<Allocator>(&mut allocator)
  let token = match move allocationSignatureParameter(&tokenSignature, usize.ZERO) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { run Testing.expect(false, "the original consumer has its Token parameter") return () }
  }
  run Testing.expect(Shared.with<Type, bool>(&token, fn(ty: &Type) -> bool { return componentNominal(ty, &id, b"Token") }),
    "the independently queried original consumer parameter is this module's exact Token")
  let tokenOwner = run glueNamedSourceOwner(&mut store, &id, b"consume") |> Effect.provideMut<Allocator>(&mut allocator)
  let keyedTokenGlue = run InstanceKey.dropGlue(&token, &tokenOwner) |> Effect.provideMut<Allocator>(&mut allocator)
  let tokenGlue = match move run requiredCanonicalGlue(move keyedTokenGlue) {
    Option<InstanceKey>.Some {value} => move value
    Option<InstanceKey>.None => { run Testing.expect(false, "Token has authentic exact glue") return () }
  }
  let glue = run Semantic.demandGlueMir(&mut store, &mut request, &token, &tokenOwner) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&glue) && glueFact(&store, &glue, usize.ONE) == usize.ONE,
    "the independently demanded Token glue actually invokes its Drop hook")
  let consumePair = run Semantic.demandMir(&mut store, &mut request, &id, b"consumePair") |> Effect.provideMut<Allocator>(&mut allocator)
  let receivedPair = match move (run componentConsumerParameter(&store, &consumePair, &id) |> Effect.provideMut<Allocator>(&mut allocator)) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { run Testing.expect(false, "the receiving function owns and cleans its one actual Pair parameter") return () }
  }
  let pairOwner = run glueSourceOwner(&mut store, &consumePair) |> Effect.provideMut<Allocator>(&mut allocator)
  let pairGlue = run Semantic.demandGlueMir(&mut store, &mut request, &receivedPair, &pairOwner) |> Effect.provideMut<Allocator>(&mut allocator)
  let orderedGlue = run componentPairGlue(&store, &pairGlue, &receivedPair, &tokenGlue) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(orderedGlue, "the receiving Pair's independently demanded glue drops first then second with exact Token glue")
  let conditional = run Semantic.demandMir(&mut store, &mut request, &id, b"conditional") |> Effect.provideMut<Allocator>(&mut allocator)
  let conditionalRefilled = run Semantic.demandMir(&mut store, &mut request, &id, b"conditionalRefilled") |> Effect.provideMut<Allocator>(&mut allocator)
  let mirrored = run Semantic.demandMir(&mut store, &mut request, &id, b"mirrored") |> Effect.provideMut<Allocator>(&mut allocator)
  let transferProof = run componentCleanupClaims(&store, &conditional, &id, text, &tokenGlue, usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let refillProof = run componentCleanupClaims(&store, &conditionalRefilled, &id, text, &tokenGlue, usize.ONE) |> Effect.provideMut<Allocator>(&mut allocator)
  let mirrorProof = run componentCleanupClaims(&store, &mirrored, &id, text, &tokenGlue, 2) |> Effect.provideMut<Allocator>(&mut allocator)
  let tailProof = run componentCleanupClaims(&store, &diverged, &id, text, &tokenGlue, 3) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(transferProof,
    "conditional transfer passes one real Pair made from original fields 0 and 2; only the retained edge drops them, in field order at the exit")
  run Testing.expect(refillProof,
    "refilling first cleans its conditional old value and drops its replacement on both paths; second keeps its independent flag and field order")
  run Testing.expect(mirrorProof,
    "opposite authored move order and distinct source sites join by canonical field paths without leaking or double-dropping the transferred Pair")
  run Testing.expect(tailProof,
    "moving only first conditionally preserves unconditional second cleanup and the disjoint count read")
  return ()
}

// The destination owns one authentic Pair parameter and invokes its complete exact glue.
effect fn componentConsumerParameter(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  id: &ModuleId) -> Option<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: selectedIndex} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, selectedIndex) {
      if !componentCallee(&function.key, id, b"consumePair") { return Option.none<Shared<Type>>() }
      let parameters = Vector.asSlice<Shared<Type>>(&function.parameters)
      if parameters.length != usize.ONE { return Option.none<Shared<Type>>() }
      if !Shared.with<Type, bool>(&parameters[usize.ZERO], fn(ty: &Type) -> bool { return componentNominal(ty, id, b"Pair") }) { return Option.none<Shared<Type>>() }
      let local = componentParameter(Vector.asSlice<MirLocal>(&function.locals), usize.ZERO)
      if local == usize.MAX || !componentNoWriters(function, local) { return Option.none<Shared<Type>>() }
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      if blocks.length != usize.ONE { return Option.none<Shared<Type>>() }
      if let MirTerminator.Return {..} = &blocks[usize.ZERO].terminator {} else { return Option.none<Shared<Type>>() }
      let mut readCount = false
      let mut drops = usize.ZERO
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut position = usize.ZERO
        while position < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Use {value: input}, ..} = &statements[position] {
            if componentOperandField(&input, local, usize.ONE, false) { readCount = true }
          }
          if let MirStatement.Drop {destination, glue, ..} = &statements[position] {
            if !readCount { return Option.none<Shared<Type>>() }
            if destination.local != local || Vector.length<MirProjection>(&destination.projections) != usize.ZERO { return Option.none<Shared<Type>>() }
            let cleaned = match move InstanceKey.glueType(&glue) {
              Option<Shared<Type>>.Some {value} => move value
              Option<Shared<Type>>.None => { return Option.none<Shared<Type>>() }
            }
            if !run Type.equalsShared(&cleaned, &parameters[usize.ZERO]) { return Option.none<Shared<Type>>() }
            drops = drops + usize.ONE
          }
          position = position + usize.ONE
        }
        at = at + usize.ONE
      }
      if readCount && drops == usize.ONE { return Option.some<Shared<Type>>(Shared.clone<Type>(&parameters[usize.ZERO])) }
    }
  }
  return Option.none<Shared<Type>>()
}

effect fn componentPairGlue(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, pair: &Shared<Type>, tokenGlue: &InstanceKey) -> bool
! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: selectedIndex} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, selectedIndex) {
      let actualPair = match move InstanceKey.glueType(&function.key) {
        Option<Shared<Type>>.Some {value} => move value
        Option<Shared<Type>>.None => { return false }
      }
      if !run Type.equalsShared(&actualPair, pair) { return false }
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      if blocks.length != usize.ONE { return false }
      let statements = Vector.asSlice<MirStatement>(&blocks[usize.ZERO].statements)
      let root = componentParameter(Vector.asSlice<MirLocal>(&function.locals), usize.ZERO)
      let mut drops = usize.ZERO
      let mut at = usize.ZERO
      while at < statements.length {
        if let MirStatement.Drop {destination, glue, ..} = &statements[at] {
          let path = Vector.asSlice<MirProjection>(&destination.projections)
          if root == usize.MAX || destination.local != root || path.length != 2 { return false }
          if !componentDereference(&path[usize.ZERO]) { return false }
          let mut field = usize.ZERO
          if drops == usize.ONE { field = 2 }
          if let MirProjection.Field {index} = &path[usize.ONE] {
            if index != field { return false }
          } else { return false }
          if !run InstanceKey.sameApplication(&glue, tokenGlue) { return false }
          drops = drops + usize.ONE
        } else { return false }
        at = at + usize.ONE
      }
      if let MirTerminator.Return {..} = &blocks[usize.ZERO].terminator { return drops == 2 }
    }
  }
  return false
}

// This oracle follows the actual closed fixture CFG with each authored flag value. It does not
// inspect Builder cleanup nodes, Remainder indexes or the production join algorithm.
effect fn componentCleanupClaims(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  id: &ModuleId, text: string, tokenGlue: &InstanceKey, mode: usize) -> bool
! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: selectedIndex} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, selectedIndex) {
      let mut name = b"conditional"
      if mode == usize.ONE { name = b"conditionalRefilled" }
      if mode == 2 { name = b"mirrored" }
      if mode == 3 { name = b"diverged" }
      if !componentCallee(&function.key, id, name) || Vector.length<Shared<Type>>(&function.parameters) != 2 { return false }
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let flag = componentParameter(locals, usize.ZERO)
      let parameter = componentParameter(locals, usize.ONE)
      if flag == usize.MAX || parameter == usize.MAX { return false }
      if !Shared.with<Type, bool>(&locals[flag].ty, fn(ty: &Type) -> bool { return witnessPrimitive(ty, b"bool") }) { return false }
      if !Shared.with<Type, bool>(&locals[parameter].ty, fn(ty: &Type) -> bool { return componentNominal(ty, id, b"Pair") }) { return false }
      if !componentNoWriters(function, flag) || !componentNoWriters(function, parameter) { return false }
      let mut occurrence = usize.ONE
      if mode == 2 { occurrence = 2 }
      if mode == 3 { occurrence = usize.ZERO }
      let mut spelling = "let kept = pair.count"
      if mode == usize.ONE { spelling = "let kept = owned.count" occurrence = usize.ZERO }
      let checkpointStart = offsetOf(text, spelling, occurrence)
      if checkpointStart == usize.MAX { return false }
      let checkpoint = Span.make(checkpointStart + 11, checkpointStart + String.utf8Bytes(spelling).length)
      let mut root = parameter
      if mode == usize.ONE {
        root = componentTransferredRoot(function, parameter)
        if root == usize.MAX { return false }
        if !Shared.with<Type, bool>(&locals[root].ty, fn(ty: &Type) -> bool { return componentNominal(ty, id, b"Pair") }) { return false }
      }
      let mut firstFlag = usize.MAX
      let mut secondFlag = usize.MAX
      let mut at = usize.ZERO
      while at < locals.length {
        if let MirLocalKind.DropFlag {local, path} = &locals[at].kind {
          if local != root { return false }
          let field = componentPath(&path)
          if field == usize.ZERO {
            if firstFlag != usize.MAX { return false }
            firstFlag = at
          } else if field == 2 {
            if secondFlag != usize.MAX { return false }
            secondFlag = at
          } else { return false }
        }
        at = at + usize.ONE
      }
      if mode == 2 {
        if firstFlag != usize.MAX || secondFlag != usize.MAX { return false }
      } else {
        if firstFlag == usize.MAX { return false }
        if mode == 3 {
          if secondFlag != usize.MAX { return false }
        } else if secondFlag == usize.MAX || firstFlag == secondFlag { return false }
      }
      let retained = run componentCleanupPath(function, id, tokenGlue, flag, parameter, root, checkpoint, mode, false)
      let transferred = run componentCleanupPath(function, id, tokenGlue, flag, parameter, root, checkpoint, mode, true)
      return retained && transferred
    }
  }
  return false
}

fn componentTemporary(kind: &MirLocalKind) -> bool {
  return match &kind.* { MirLocalKind.Temp => true _ => false }
}

fn componentDereference(projection: &MirProjection) -> bool {
  return match &projection.* { MirProjection.Deref => true _ => false }
}

fn componentSetNumber(values: &mut Vector<usize>, index: usize, value: usize) -> () {
  let mut slots = Vector.asMutSlice<usize>(&mut values.*)
  slots[index] = value
  return ()
}

fn componentSetReached(values: &mut Vector<bool>, index: usize, value: bool) -> () {
  let mut slots = Vector.asMutSlice<bool>(&mut values.*)
  slots[index] = value
  return ()
}

fn componentParameter(locals: &[MirLocal], index: usize) -> usize {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < locals.length {
    if let MirLocalKind.Parameter {index: ordinal} = &locals[at].kind {
      if ordinal == index {
        if found != usize.MAX { return usize.MAX }
        found = at
      }
    }
    at = at + usize.ONE
  }
  return found
}

fn componentNominal(value: &Type, id: &ModuleId, name: &[u8]) -> bool {
  if let Type.Nominal {declaration, arguments, ..} = &value.* {
    return ModuleId.equals(DeclarationId.moduleId(&declaration), id) && DeclarationId.ownerCount(&declaration) == usize.ONE
      && DeclarationId.ownerKind(&declaration, usize.ZERO) == OwnerKind.Struct && DeclarationId.named(&declaration, name)
      && Vector.length<Argument>(&arguments) == usize.ZERO
  }
  return false
}

fn componentPath(path: &Vector<MirProjection>) -> usize {
  let steps = Vector.asSlice<MirProjection>(path)
  if steps.length != usize.ONE { return usize.MAX }
  return match &steps[usize.ZERO] { MirProjection.Field {index} => index _ => usize.MAX }
}

fn componentOperandField(value: &MirOperand, root: usize, field: usize, moves: bool) -> bool {
  return match &value.* {
    MirOperand.Move {place} => moves && place.local == root && componentPath(&place.projections) == field
    MirOperand.Copy {place} => !moves && place.local == root && componentPath(&place.projections) == field
    _ => false
  }
}

fn componentPlainOperand(value: &MirOperand, moves: bool) -> usize {
  return match &value.* {
    MirOperand.Move {place} => {
      if moves && Vector.length<MirProjection>(&place.projections) == usize.ZERO { return place.local }
      return usize.MAX
    }
    MirOperand.Copy {place} => {
      if !moves && Vector.length<MirProjection>(&place.projections) == usize.ZERO { return place.local }
      return usize.MAX
    }
    _ => usize.MAX
  }
}

// Every intermediate is defined once by a whole assignment; no call or companion writer can
// replace it. The only permitted projected writer is the authored root's later first refill.
fn componentOnlyWriter(function: &MirFunction, local: usize, block: usize, position: usize, refill: bool) -> bool {
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut writes = usize.ZERO
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut index = usize.ZERO
    while index < statements.length {
      if let MirStatement.Assign {destination, ..} = &statements[index] {
        if destination.local == local {
          if Vector.length<MirProjection>(&destination.projections) != usize.ZERO {
            if !refill || componentPath(&destination.projections) != usize.ZERO { return false }
          } else {
            if at != block || index != position { return false }
            writes = writes + usize.ONE
          }
        }
      }
      if let MirStatement.FailureContext {destination, ..} = &statements[index] {
        if destination.local == local { return false }
      }
      index = index + usize.ONE
    }
    if let MirTerminator.Call {destination, failure, ..} = &blocks[at].terminator {
      if destination.local == local { return false }
      if let Option<MirFailureEdge>.Some {value: edge} = &failure {
        if edge.destination.local == local { return false }
      }
    }
    at = at + usize.ONE
  }
  return writes == usize.ONE
}

fn componentNoWriters(function: &MirFunction, local: usize) -> bool {
  return componentWriterAbsent(function, local)
}

fn componentWriterAbsent(function: &MirFunction, local: usize) -> bool {
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut index = usize.ZERO
    while index < statements.length {
      if let MirStatement.Assign {destination, ..} = &statements[index] {
        if destination.local == local { return false }
      }
      if let MirStatement.FailureContext {destination, ..} = &statements[index] {
        if destination.local == local { return false }
      }
      index = index + usize.ONE
    }
    if let MirTerminator.Call {destination, failure, ..} = &blocks[at].terminator {
      if destination.local == local { return false }
      if let Option<MirFailureEdge>.Some {value: edge} = &failure {
        if edge.destination.local == local { return false }
      }
    }
    at = at + usize.ONE
  }
  return true
}

// A Move wrapper may load its source through Copy temporaries. Authenticate the whole unique
// Use chain, require a Move for an ownership transfer, and require every definition to have
// executed on this CFG path. An empty reached slice is used only for static root discovery.
fn componentFrom(function: &MirFunction, operand: &MirOperand, root: usize, field: usize,
  moves: bool, reached: &[bool]) -> bool {
  return componentTrace(function, operand, root, field, moves, reached, usize.ZERO, false)
}

fn componentTrace(function: &MirFunction, operand: &MirOperand, root: usize, field: usize,
  moves: bool, reached: &[bool], depth: usize, moved: bool) -> bool {
  return match &operand.* {
    MirOperand.Copy {place} => componentTracePlace(function, &place, root, field, moves, reached, depth, moved)
    MirOperand.Move {place} => componentTracePlace(function, &place, root, field, moves, reached, depth, true)
    _ => false
  }
}

fn componentTracePlace(function: &MirFunction, source: &MirPlace, root: usize, field: usize,
  moves: bool, reached: &[bool], depth: usize, moved: bool) -> bool {
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  if depth > locals.length || source.local >= locals.length || (!moves && moved) { return false }
  if reached.length != usize.ZERO && !reached[source.local] { return false }
  if source.local == root {
    if field == usize.MAX { return moved == moves && Vector.length<MirProjection>(&source.projections) == usize.ZERO }
    return moved == moves && componentPath(&source.projections) == field
  }
  if Vector.length<MirProjection>(&source.projections) != usize.ZERO { return false }
  if !componentTemporary(&locals[source.local].kind) { return false }
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Use {value: input}, ..} = &statements[position] {
        if destination.local == source.local {
          if !componentOnlyWriter(function, source.local, at, position, false) { return false }
          return componentTrace(function, &input, root, field, moves, reached, depth + usize.ONE, moved)
        }
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

// The refilled source has one authentic whole Move of its original parameter into its user
// local. Its projected first-field refill does not authorize another whole initializer.
fn componentTransferredRoot(function: &MirFunction, parameter: usize) -> usize {
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let mut root = usize.MAX
  let unreached = Vector.make<bool>()
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Use {value: input}, ..} = &statements[position] {
        if destination.local < locals.length && Vector.length<MirProjection>(&destination.projections) == usize.ZERO {
          if let MirLocalKind.User {..} = &locals[destination.local].kind {
            if componentFrom(function, &input, parameter, usize.MAX, true, Vector.asSlice<bool>(&unreached)) {
              if root != usize.MAX || !componentOnlyWriter(function, destination.local, at, position, true) { return usize.MAX }
              root = destination.local
            }
          }
        }
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return root
}

fn componentCallee(value: &InstanceKey, id: &ModuleId, name: &[u8]) -> bool {
  let application = InstanceKey.application(value)
  if let Option<Shared<SpecializationApplication>>.Some {value: selected} = move application {
    return Shared.with<SpecializationApplication, bool>(&selected, fn(actual: &SpecializationApplication) -> bool {
      let declaration = SpecializationApplication.bodyDeclaration(actual)
      return ModuleId.equals(DeclarationId.moduleId(declaration), id) && DeclarationId.ownerCount(declaration) == usize.ONE
        && DeclarationId.ownerKind(declaration, usize.ZERO) == OwnerKind.Function && DeclarationId.named(declaration, name)
        && Vector.length<Argument>(&actual.arguments) == usize.ZERO
        && Vector.length<usize>(&actual.argumentOrdinals) == usize.ZERO
        && Vector.length<ScopeBinding>(&actual.scopes) == usize.ZERO
        && Vector.length<StaticSlot>(&actual.statics) == usize.ZERO
    })
  }
  return false
}

// Resolve an ownership-transferred aggregate through unique, already executed Use staging.
fn componentAggregateSlot(function: &MirFunction, operand: &MirOperand, reached: &[bool], depth: usize, moved: bool) -> usize {
  let mut local = componentPlainOperand(operand, true)
  let mut transferred = moved
  if local != usize.MAX { transferred = true }
  else { local = componentPlainOperand(operand, false) }
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  if local >= locals.length || depth > locals.length || !reached[local] { return usize.MAX }
  if !componentTemporary(&locals[local].kind) { return usize.MAX }
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Assign {destination, value, ..} = &statements[position] {
        if destination.local == local {
          if !componentOnlyWriter(function, local, at, position, false) { return usize.MAX }
          if let MirRvalue.Aggregate {..} = &value {
            if transferred { return local }
            return usize.MAX
          }
          if let MirRvalue.Use {value: input} = &value {
            return componentAggregateSlot(function, &input, reached, depth + usize.ONE, transferred)
          }
          return usize.MAX
        }
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// The one actual call argument owns an exact Pair, made from original source fields in the
// authored order. Its constituents' producer chains must dominate the receiving call too.
fn componentAggregate(function: &MirFunction, id: &ModuleId, argument: &MirOperand, root: usize,
  reverse: bool, reached: &[bool]) -> bool {
  let aggregate = componentAggregateSlot(function, argument, reached, usize.ZERO, false)
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  if aggregate >= locals.length { return false }
  if !Shared.with<Type, bool>(&locals[aggregate].ty, fn(ty: &Type) -> bool { return componentNominal(ty, id, b"Pair") }) { return false }
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Aggregate {fields}, ..} = &statements[position] {
        if destination.local == aggregate {
          let listed = Vector.asSlice<MirAggregateField>(&fields)
          if listed.length != 3 { return false }
          let mut first = usize.ZERO
          let mut second: usize = 2
          if reverse { first = 2 second = usize.ZERO }
          return listed[usize.ZERO].index == first && componentFrom(function, &listed[usize.ZERO].value, root, first, true, reached)
            && listed[usize.ONE].index == usize.ONE && componentFrom(function, &listed[usize.ONE].value, root, usize.ONE, false, reached)
            && listed[2].index == second && componentFrom(function, &listed[2].value, root, second, true, reached)
        }
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

fn componentReplacement(function: &MirFunction, id: &ModuleId, operand: &MirOperand, reached: &[bool]) -> bool {
  let installed = componentAggregateSlot(function, operand, reached, usize.ZERO, false)
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  if installed >= locals.length { return false }
  if !Shared.with<Type, bool>(&locals[installed].ty, fn(ty: &Type) -> bool { return componentNominal(ty, id, b"Token") }) { return false }
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Aggregate {fields}, ..} = &statements[position] {
        if destination.local == installed {
          let listed = Vector.asSlice<MirAggregateField>(&fields)
          if listed.length != usize.ONE || listed[usize.ZERO].index != usize.ZERO { return false }
          if let MirOperand.Integer {decimal, negative, ty} = &listed[usize.ZERO].value {
            return !negative && sameBytes(Bytes.asSlice(&decimal), b"4")
              && Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool { return witnessPrimitive(value, b"i32") })
          }
          return false
        }
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

fn componentOperandReady(operand: &MirOperand, reached: &[bool]) -> bool {
  return match &operand.* {
    MirOperand.Copy {place} => place.local < reached.length && reached[place.local]
    MirOperand.Move {place} => place.local < reached.length && reached[place.local]
    _ => true
  }
}

fn componentOperandTouches(operand: &MirOperand, root: usize) -> bool {
  return match &operand.* {
    MirOperand.Copy {place} => place.local == root
    MirOperand.Move {place} => place.local == root
    _ => false
  }
}

// The fixture has only bool parameter/flag branches, one source read after the join and
// independently specified field-drop sequences. Unknown instructions/conditions refuse proof.
effect fn componentCleanupPath(function: &MirFunction, id: &ModuleId, tokenGlue: &InstanceKey,
  flag: usize, parameter: usize, root: usize, checkpoint: Span, mode: usize, taken: bool) -> bool
! OutOfMemoryError ? &mut Allocator {
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut values = Vector.make<usize>()
  let mut assigned = Vector.make<bool>()
  let mut at = usize.ZERO
  while at < locals.length {
    run Vector.append<usize>(&mut values, usize.MAX)
    run Vector.append<bool>(&mut assigned, false)
    at = at + usize.ONE
  }
  componentSetNumber(&mut values, flag, countIf(taken))
  componentSetReached(&mut assigned, flag, true)
  componentSetReached(&mut assigned, parameter, true)
  let mut current = usize.ZERO
  let mut steps = usize.ZERO
  let mut calls = usize.ZERO
  let mut drops = usize.ZERO
  let mut readCount = false
  let mut refilled = false
  let mut rootInitialized = mode != usize.ONE
  let mut sourceBranches = usize.ZERO
  let mut guardedField = usize.MAX
  while current < blocks.length && steps <= blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[current].statements)
    at = usize.ZERO
    while at < statements.length {
      match &statements[at] {
        MirStatement.Assign {destination, value, origin} => {
          if destination.local >= locals.length { return false }
          if let MirRvalue.Use {value: input} = &value {
            if !componentOperandReady(&input, Vector.asSlice<bool>(&assigned)) { return false }
            if !rootInitialized && componentOperandTouches(&input, root) { return false }
          } else if let MirRvalue.Aggregate {fields} = &value {
            let inputs = Vector.asSlice<MirAggregateField>(&fields)
            let mut inputAt = usize.ZERO
            while inputAt < inputs.length {
              if !componentOperandReady(&inputs[inputAt].value, Vector.asSlice<bool>(&assigned)) { return false }
              if !rootInitialized && componentOperandTouches(&inputs[inputAt].value, root) { return false }
              inputAt = inputAt + usize.ONE
            }
          } else { return false }
          if destination.local == root {
            if Vector.length<MirProjection>(&destination.projections) != usize.ZERO {
              if mode != usize.ONE || !readCount || refilled || componentPath(&destination.projections) != usize.ZERO { return false }
              if let MirRvalue.Use {value: replacement} = &value {
                if !componentReplacement(function, id, &replacement, Vector.asSlice<bool>(&assigned)) { return false }
              } else { return false }
              refilled = true
            } else {
              if mode != usize.ONE || rootInitialized { return false }
              if let MirRvalue.Use {value: original} = &value {
                if !componentFrom(function, &original, parameter, usize.MAX, true, Vector.asSlice<bool>(&assigned)) { return false }
              } else { return false }
              if !componentOnlyWriter(function, root, current, at, true) { return false }
              rootInitialized = true
            }
          }
          if let MirRvalue.Use {value: input} = &value {
            if origin.span.start == checkpoint.start && origin.span.end == checkpoint.end
              && componentOperandField(&input, root, usize.ONE, false) {
              if readCount || !rootInitialized { return false }
              readCount = true
            }
          }
          if Vector.length<MirProjection>(&destination.projections) == usize.ZERO {
            let mut scalar = usize.MAX
            if let MirRvalue.Use {value: input} = &value {
              if let MirOperand.Boolean {value: boolean} = &input { scalar = countIf(boolean) }
              let copied = componentPlainOperand(&input, false)
              if copied < locals.length { scalar = Vector.asSlice<usize>(&values)[copied] }
            }
            componentSetNumber(&mut values, destination.local, scalar)
            componentSetReached(&mut assigned, destination.local, true)
          }
        }
        MirStatement.Drop {destination, glue, ..} => {
          if !readCount || destination.local != root { return false }
          if !run InstanceKey.sameApplication(&glue, tokenGlue) { return false }
          let field = componentPath(&destination.projections)
          let mut needsGuard = mode == usize.ZERO || (mode == 3 && field == usize.ZERO)
          if mode == usize.ONE { needsGuard = (!taken && drops == usize.ZERO) || field == 2 }
          if needsGuard && guardedField != field { return false }
          if !needsGuard && guardedField != usize.MAX { return false }
          guardedField = usize.MAX
          let mut expected = usize.ZERO
          if mode == usize.ONE {
            if !taken && drops == usize.ZERO {
              if refilled { return false }
            } else {
              if !refilled { return false }
              if !taken && drops == 2 { expected = 2 }
            }
          } else if mode == 3 {
            if taken || drops == usize.ONE { expected = 2 }
          } else if drops == usize.ONE { expected = 2 }
          if field != expected { return false }
          drops = drops + usize.ONE
        }
        _ => { return false }
      }
      at = at + usize.ONE
    }
    if let MirTerminator.Goto {target, ..} = &blocks[current].terminator { current = target }
    else if let MirTerminator.Branch {condition, thenBlock, elseBlock, ..} = &blocks[current].terminator {
        let source = componentPlainOperand(&condition, false)
        if source >= locals.length { return false }
        if guardedField != usize.MAX { return false }
        let choice = Vector.asSlice<usize>(&values)[source]
        if componentFrom(function, &condition, flag, usize.MAX, false, Vector.asSlice<bool>(&assigned)) {
          sourceBranches = sourceBranches + usize.ONE
        } else {
          if let MirLocalKind.DropFlag {local, path} = &locals[source].kind {
            if local != root { return false }
            if choice == usize.ONE { guardedField = componentPath(&path) }
          } else { return false }
        }
        if choice == usize.ZERO { current = elseBlock }
        else if choice == usize.ONE { current = thenBlock }
        else { return false }
    }
    else if let MirTerminator.Call {callee, arguments, providers, diagnostics, failure, destination, normal, ..} = &blocks[current].terminator {
        if readCount || !rootInitialized || Vector.length<MirOperand>(&providers) != usize.ZERO { return false }
        if let Option<MirDiagnostics>.Some {..} = &diagnostics { return false }
        if let Option<MirFailureEdge>.Some {..} = &failure { return false }
        let passed = Vector.asSlice<MirOperand>(&arguments)
        if passed.length != usize.ONE { return false }
        if let MirCallee.Instance {key} = &callee {
          if mode == 3 {
            if !componentCallee(&key, id, b"consume") || !componentFrom(function, &passed[usize.ZERO], root, usize.ZERO, true, Vector.asSlice<bool>(&assigned)) { return false }
          } else {
            if !componentCallee(&key, id, b"consumePair") || !componentAggregate(function, id, &passed[usize.ZERO], root, mode == 2 && !taken, Vector.asSlice<bool>(&assigned)) { return false }
          }
        } else { return false }
        if destination.local >= locals.length || Vector.length<MirProjection>(&destination.projections) != usize.ZERO { return false }
        if !componentTemporary(&locals[destination.local].kind) { return false }
        componentSetReached(&mut assigned, destination.local, true)
        componentSetNumber(&mut values, destination.local, usize.MAX)
        calls = calls + usize.ONE
        current = normal
    }
    else if let MirTerminator.Return {..} = &blocks[current].terminator {
        let mut expectedCalls = countIf(taken)
        let mut expectedDrops: usize = 2
        if taken { expectedDrops = usize.ZERO }
        if mode == usize.ONE { expectedDrops = 3
          if taken { expectedDrops = usize.ONE } }
        if mode == 2 { expectedCalls = usize.ONE expectedDrops = usize.ZERO }
        if mode == 3 && taken { expectedDrops = usize.ONE }
        return readCount && sourceBranches == usize.ONE && guardedField == usize.MAX
          && rootInitialized && calls == expectedCalls && drops == expectedDrops
          && (mode != usize.ONE || refilled)
    } else { return false }
    steps = steps + usize.ONE
  }
  return false
}

// A by-value binding of a consumed subject owns its part (MATCH-002): `drop`, `move`, `match move`
// and partial moves of it, and moves that differ per path or per arm, are lowered with the ordinary
// owner states and flags, so every Note is dropped exactly once on every path.
test effect fn consumedBindingsOwnTheirParts() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("binding-owners.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Note { value: i32 }
impl Drop for Note { fn drop(self: &mut Note) -> () { return () } }
fn consume(note: Note) -> i32 { return note.value }
struct Pair { left: Note right: Note }
union Kind { Plain, Tagged { note: Note }, Hidden }
struct Wrapped { first: Note kind: Kind }
struct Holder { pair: Pair code: i32 }
fn make() -> Pair { return Pair { left: Note { value: 1 }, right: Note { value: 2 } } }
fn finish(pair: Pair) -> i32 {
  let Pair { left, right } = move pair
  drop right
  let kept = move left
  return kept.value
}
fn admit(wrapped: Wrapped) -> i32 {
  let Wrapped { first, kind } = move wrapped
  return match move kind {
    Kind.Plain => first.value
    Kind.Tagged { note } => note.value + first.value
    Kind.Hidden => 0
  }
}
fn omitted(pair: Pair) -> i32 {
  let Pair { left, .. } = move pair
  return consume(move left)
}
fn either(pair: Pair, flag: bool) -> i32 {
  let Pair { left, right } = move pair
  if flag { drop left }
  return right.value
}
fn perArm(wrapped: Wrapped) -> i32 {
  let Wrapped { first, kind } = move wrapped
  return match move kind {
    Kind.Tagged { note } => consume(move first) + consume(move note)
    _ => 0
  }
}
fn nested(holder: Holder) -> i32 {
  let Holder { pair, code } = move holder
  let used = consume(move pair.left)
  return code
}
fn looped(limit: i32) -> i32 {
  let mut n = limit
  let mut total = 0
  while n > 0 {
    let Pair { left, right } = move make()
    total = total + consume(move left)
    n = n - 1
  }
  return total
}
fn conditional(input: Pair | Note) -> i32 {
  if let Pair { left, .. } = move input { return consume(move left) }
  return 0
}
fn guarded(kind: Kind) -> i32 {
  return match move kind {
    Kind.Tagged { note } if consume(move note) > 0 => 1
    _ => 0
  }
}
fn escaped(kind: Kind) -> Note {
  return match move kind {
    Kind.Tagged { note } => note
    _ => Note { value: 0 }
  }
}
fn handed(kind: Kind) -> Note {
  return match move kind {
    Kind.Tagged { note } => move note
    _ => Note { value: 0 }
  }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let finish = run Semantic.demandMir(&mut store, &mut request, &id, b"finish") |> Effect.provideMut<Allocator>(&mut allocator)
  let admit = run Semantic.demandMir(&mut store, &mut request, &id, b"admit") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &finish, usize.ZERO) == 2 && cleanupFact(&store, &finish, usize.ZERO) == usize.ZERO,
    "a destructured binding is dropped or moved on its own, and the subject drops nothing its bindings took")
  run Testing.expect(glueFact(&store, &admit, usize.ZERO) == 4 && glueFact(&store, &admit, 3) == usize.MAX &&
    glueFact(&store, &admit, 4) == 3010 && cleanupFact(&store, &admit, usize.ZERO) == usize.ZERO,
    "match move of a let binding consumes that binding; each arm drops its own binding, then the subject's remainder")
  let omitted = run Semantic.demandMir(&mut store, &mut request, &id, b"omitted") |> Effect.provideMut<Allocator>(&mut allocator)
  let either = run Semantic.demandMir(&mut store, &mut request, &id, b"either") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &omitted, usize.ZERO) == usize.ONE && glueFact(&store, &omitted, 3) == usize.ONE &&
    glueFact(&store, &omitted, 7) == usize.ZERO,
    "a field omitted with `..` is dropped when the let binds, before the later call")
  run Testing.expect(glueFact(&store, &either, usize.ZERO) == 3 && glueFact(&store, &either, 4) == usize.ONE &&
    cleanupFact(&store, &either, usize.ZERO) == usize.ONE && cleanupFact(&store, &either, usize.ONE) == 2,
    "a binding dropped on one path only is dropped at scope end under its flag")
  let perArm = run Semantic.demandMir(&mut store, &mut request, &id, b"perArm") |> Effect.provideMut<Allocator>(&mut allocator)
  let nested = run Semantic.demandMir(&mut store, &mut request, &id, b"nested") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &perArm, usize.ZERO) == 2 && cleanupFact(&store, &perArm, usize.ZERO) == usize.ONE &&
    cleanupFact(&store, &perArm, usize.ONE) == 2,
    "a binding moved by one arm only is tracked by a flag written on each arm's edge")
  run Testing.expect(glueFact(&store, &nested, usize.ZERO) == usize.ONE && glueFact(&store, &nested, 3) == usize.ONE &&
    cleanupFact(&store, &nested, usize.ZERO) == usize.ZERO,
    "a partial move out of a binding leaves a hole in the binding's owner only")
  let looped = run Semantic.demandMir(&mut store, &mut request, &id, b"looped") |> Effect.provideMut<Allocator>(&mut allocator)
  let conditional = run Semantic.demandMir(&mut store, &mut request, &id, b"conditional") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &looped, usize.ZERO) == usize.ONE && glueFact(&store, &looped, 3) == usize.ONE &&
    cleanupFact(&store, &looped, usize.ZERO) == usize.ZERO,
    "let bindings in a loop body end with each iteration")
  run Testing.expect(glueFact(&store, &conditional, usize.ZERO) == 2 && glueFact(&store, &conditional, 3) == usize.MAX &&
    glueFact(&store, &conditional, 4) == usize.ONE && glueFact(&store, &conditional, 7) == usize.ONE,
    "if let drops the whole unmatched subject, and the omitted field only when the taken body exits after its call")
  let guarded = run Semantic.demandMir(&mut store, &mut request, &id, b"guarded") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(cleanupGapAt(&guarded, text, "move note", usize.ONE),
    "a guard that consumes a binding of its provisional arm stays the cleanup gap")
  let escaped = run Semantic.demandMir(&mut store, &mut request, &id, b"escaped") |> Effect.provideMut<Allocator>(&mut allocator)
  let handed = run Semantic.demandMir(&mut store, &mut request, &id, b"handed") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut sameDrops = glueFact(&store, &handed, usize.ZERO) != usize.MAX
  let mut fact = usize.ZERO
  while fact < 9 {
    sameDrops = sameDrops && glueFact(&store, &escaped, fact) == glueFact(&store, &handed, fact)
    fact = fact + usize.ONE
  }
  run Testing.expect(sameDrops && cleanupFact(&store, &escaped, usize.ZERO) == cleanupFact(&store, &handed, usize.ZERO),
    "a consuming arm's binding read by value transfers like `move`: its owner no longer drops it at arm exit")
  return ()
}

test effect fn cleanupFollowsLoopsAndConditionalPaths() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("cleanup-paths.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn make() -> Token { return Token { value: 1 } }
fn consume(token: Token) -> i32 { return token.value }
fn reinit(limit: i32) -> i32 {
  let mut current = make()
  let used = consume(move current)
  let mut remaining = limit
  while remaining > 0 {
    current = make()
    remaining = remaining - 1
  }
  return 0
}
fn lazy(ok: bool) -> i32 {
  if ok && make().value > 0 { return 1 }
  return 0
}
fn armed(code: i32) -> i32 {
  let n = match code { 1 => make().value _ => 0 }
  return n
}
fn breaking(code: i32) -> i32 {
  match make().value {
    1 => { while true { break } }
    _ => {}
  }
  return 0
}
fn diverging(code: i32) -> i32 {
  let token = make()
  return match code {
    1 => { return 1 }
    _ => { return 2 }
  }
}
fn guardTemporary(code: i32) -> i32 { return match code { 1 if make().value > 0 => 1 _ => 0 } }
fn guardMoves(code: i32) -> i32 {
  let token = make()
  return match code { 1 if consume(move token) > 0 => 1 _ => 0 }
}
fn looped(limit: i32) -> i32 {
  let token = make()
  let mut n = limit
  while n > 0 { let used = consume(move token) n = n - 1 }
  return 0
}
union Held { Empty, Pair {kept: Token, rest: Token} }
union Cell { Missing, Present {token: Token} }
fn cell(at: i32) -> Cell {
  if at == 1 { return Cell.Missing }
  return Cell.Present {token: make()}
}
fn selectedFallthrough(held: Held, limit: i32) -> i32 {
  let mut total = 0
  if let Held.Pair {kept, ..} = move held {
    let mut n = 0
    while n < limit {
      let child = cell(n)
      if let Cell.Present {token} = move child { total = total + token.value }
      n = n + 1
    }
    total = total + kept.value
  }
  return total
}
fn selectedBreak(held: Held, limit: i32) -> i32 {
  if let Held.Pair {kept, ..} = move held {
    let mut n = limit
    while n > 0 {
      if n == 3 { break }
      n = n - 1
    }
    return kept.value + n
  }
  return 0
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let reinit = run Semantic.demandMir(&mut store, &mut request, &id, b"reinit") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(cleanupFact(&store, &reinit, usize.ZERO) == usize.ONE && cleanupFact(&store, &reinit, usize.ONE) == 2 &&
    glueFact(&store, &reinit, usize.ZERO) == 2,
    "an owner moved before a loop is tracked by a flag that each iteration's re-initialization sets")
  let lazy = run Semantic.demandMir(&mut store, &mut request, &id, b"lazy") |> Effect.provideMut<Allocator>(&mut allocator)
  let armed = run Semantic.demandMir(&mut store, &mut request, &id, b"armed") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &lazy, usize.ZERO) == usize.ONE && cleanupFact(&store, &lazy, 4) == usize.ONE &&
    glueFact(&store, &armed, usize.ZERO) == usize.ONE && cleanupFact(&store, &armed, 4) == usize.ONE,
    "a temporary of a short-circuit operand or a match arm is dropped on its own path, not at the join")
  let breaking = run Semantic.demandMir(&mut store, &mut request, &id, b"breaking") |> Effect.provideMut<Allocator>(&mut allocator)
  let diverging = run Semantic.demandMir(&mut store, &mut request, &id, b"diverging") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &breaking, usize.ZERO) == usize.ONE && glueFact(&store, &diverging, usize.ZERO) == 2,
    "break leaves the temporaries of statements outside its loop, and a diverged operand adds no drops")
  let guardTemporary = run Semantic.demandMir(&mut store, &mut request, &id, b"guardTemporary") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &guardTemporary, usize.ZERO) == usize.ONE && cleanupFact(&store, &guardTemporary, 4) == usize.ONE,
    "a guard's temporary is dropped before the guard selects its arm or resumes dispatch")
  let guardMoves = run Semantic.demandMir(&mut store, &mut request, &id, b"guardMoves") |> Effect.provideMut<Allocator>(&mut allocator)
  let looped = run Semantic.demandMir(&mut store, &mut request, &id, b"looped") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(cleanupGapAt(&guardMoves, text, "consume(move token) > 0", 0) &&
    cleanupGapAt(&looped, text, "while n > 0 { let used = consume(move token) n = n - 1 }", 0),
    "a guard that moves an owner and a loop iteration that leaves one moved stay the cleanup gap")
  let selectedBreak = run Semantic.demandMir(&mut store, &mut request, &id, b"selectedBreak") |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedFallthrough = run Semantic.demandMir(&mut store, &mut request, &id, b"selectedFallthrough") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&selectedBreak) && cleanupFact(&store, &selectedBreak, usize.ZERO) != usize.ZERO
    && succeeded(&selectedFallthrough) && cleanupFact(&store, &selectedFallthrough, usize.ZERO) != usize.ZERO,
    "joins after a loop inside if let keep the ended union subject one compact component under its loop flag")
  return ()
}

// `if let` and destructuring `let` check as statement-position matches: the initializer's syntax
// chooses access (PATT-002), then-bindings stay out of `else` (PATT-005), a redundant `if let` is
// valid (PATT-010), and `let` must be irrefutable (PATT-006).
test effect fn patternConditionalsAndDestructuringLetsCheckAsMatches() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("if-let.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Left { value: i32 }
struct Right {}
struct Point {
  x: i32
  y: i32
}
struct Wide { amount: i32 }
union Shape { Circle { radius: i32 }, Empty }
struct Holder { shape: Shape }
fn shared(input: Left | Right) -> i32 { if let Left { value } = &input { return value } else { return 0 } }
fn moved(input: Left | Right) -> i32 { if let Left held = move input { return held.value } return 1 }
fn chained(input: Left | Right, flag: bool) -> i32 {
  if let Left { value } = &input { return value } else if flag { return 2 } else if let Right {} = &input { return 3 }
  return 4
}
fn exclusive(input: Left | Right) -> i32 {
  let mut held = move input
  if let Left { value } = &mut held { return value }
  return 0
}
fn redundant(point: Point) -> i32 { if let Point { x, y } = move point { return x + y } return 0 }
fn destructured(point: Point) -> i32 {
  let Point { x, y } = move point
  return x + y
}
fn variant(shape: Shape) -> i32 { if let Shape.Circle { radius } = &shape { return radius } return 0 }
fn elseBinding(input: Wide | Right) -> i32 { if let Wide { amount } = &input { return amount } else { return amount } }
fn refutable(input: Left | Right) -> i32 {
  let Right {} = move input
  return 0
}
fn nestedRefutable(holder: Holder) -> i32 {
  let Holder { shape: Shape.Circle { radius } } = move holder
  return radius
}
fn discard(input: i32) -> i32 {
  let _ = input
  return 0
}
fn bareAffine(input: Left | Right) -> i32 { if let Left { value } = input { return value } return 0 }
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &id, &source) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = Semantic.traced(run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator),
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let mut request = Request.make()
  let shared = run Semantic.demandBody(&mut store, &mut request, &id, b"shared") |> Effect.provideMut<Allocator>(&mut allocator)
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"moved") |> Effect.provideMut<Allocator>(&mut allocator)
  let exclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusive") |> Effect.provideMut<Allocator>(&mut allocator)
  let redundant = run Semantic.demandBody(&mut store, &mut request, &id, b"redundant") |> Effect.provideMut<Allocator>(&mut allocator)
  let variant = run Semantic.demandBody(&mut store, &mut request, &id, b"variant") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(patternAccess(&shared) == usize.ONE && patternAccess(&moved) == usize.ZERO &&
    patternAccess(&exclusive) == 3 && patternAccess(&variant) == usize.ONE,
    "& and &mut match the subject place, exclusively only for &mut; move reads one value")
  run Testing.expect(succeeded(&redundant), "an irrefutable if let is valid")
  let chained = run Semantic.demandBody(&mut store, &mut request, &id, b"chained") |> Effect.provideMut<Allocator>(&mut allocator)
  let destructured = run Semantic.demandBody(&mut store, &mut request, &id, b"destructured") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&chained) && patternAccess(&destructured) == usize.ZERO,
    "an else-if chain mixes if and if let, and a moved let binding reaches later statements")
  let elseBinding = run Semantic.demandBody(&mut store, &mut request, &id, b"elseBinding") |> Effect.provideMut<Allocator>(&mut allocator)
  let refutable = run Semantic.demandBody(&mut store, &mut request, &id, b"refutable") |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedRefutable = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedRefutable") |> Effect.provideMut<Allocator>(&mut allocator)
  let discard = run Semantic.demandBody(&mut store, &mut request, &id, b"discard") |> Effect.provideMut<Allocator>(&mut allocator)
  let bareAffine = run Semantic.demandBody(&mut store, &mut request, &id, b"bareAffine") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&elseBinding, RejectionCode.UnknownName, text, "amount", 3) &&
    rejectsSpan(&refutable, RejectionCode.RefutableBinding, text, "Right {}", 2) &&
    rejectsSpan(&nestedRefutable, RejectionCode.RefutableBinding, text, "Holder { shape: Shape.Circle { radius } }", 0) &&
    rejectsSpan(&discard, RejectionCode.ExplicitDiscard, text, "_", 0) &&
    rejectsSpan(&bareAffine, RejectionCode.ExplicitMoveRequired, text, "if let Left { value } = input { return value }", 0),
    "an else use of a then-binding, a refutable let (also through a nested variant), let _ and a bare affine subject report precise spans",
  )
  return ()
}

// 1 when the first match addresses its subject place, plus 2 when a pattern binding is exclusive.
fn patternAccess(answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let checked = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked {
    return Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize {
      let mut fact = usize.ZERO
      if matchAddressesPlace(body) { fact = usize.ONE }
      let nodes = TypedBody.nodeSlice(body)
      let mut at = usize.ZERO
      while at < nodes.length {
        if let BodyNodeKind.Expression {form: BodyExpression.PatternBinding {access, ..}, ..} = &nodes[at].kind {
          if access == BodyBindingAccess.Exclusive { return fact + 2 }
        }
        at = at + usize.ONE
      }
      return fact
    })
  }
  return usize.MAX
}

// Counts the first switch's cases and all switches, plus exclusive references to projected places.
fn mirSwitchesCasesAndProjectedMutableRefs(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, fact: usize) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut switches = usize.ZERO
      let mut cases = usize.ZERO
      let mut refs = usize.ZERO
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Switch {cases: listed, ..} = &blocks[at].terminator {
          switches = switches + usize.ONE
          cases = cases + Vector.length<MirSwitchCase>(&listed)
        }
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut step = usize.ZERO
        while step < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Ref {access, place}, ..} = &statements[step] {
            if access == Access.Mutable && Vector.length<MirProjection>(&place.projections) != usize.ZERO { refs = refs + usize.ONE }
          }
          step = step + usize.ONE
        }
        at = at + usize.ONE
      }
      if fact == usize.ZERO { return switches }
      if fact == usize.ONE { return cases }
      return refs
    }
  }
  return usize.MAX
}

// Counts the first match's integer literal arms.
fn integerArmCount(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[at].kind {
      let written = Vector.asSlice<BodyMatchArm>(&arms)
      let mut found = usize.ZERO
      let mut arm = usize.ZERO
      while arm < written.length {
        if let BodyPattern.Integer {..} = &written[arm].pattern { found = found + usize.ONE }
        arm = arm + usize.ONE
      }
      return found
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// Pattern bindings are places: a `match &mut` binding borrows its payload exclusively, a shared binding
// only shares it, and integer literals select values of an integer scrutinee.
test effect fn patternBindingBorrowsAndIntegerPatterns() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("binding-borrows.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Narrow { first: i32 second: i32 }
struct Wide { first: i64 }
union Choice { Left { value: Narrow }, Right { value: Wide } }
enum Status { Ready, Done }
fn increment(value: &mut Narrow) -> () { value.first = value.first + 1 }
fn read(value: &Narrow) -> i32 { return value.first }
fn mutated(combined: Choice) -> i32 {
  let mut held = move combined
  match &mut held { Choice.Left {value} => { increment(&mut value) } Choice.Right {..} => {} }
  return match &held { Choice.Left {value} => read(&value) Choice.Right {..} => 0 }
}
fn sharedOnly(combined: &Choice) -> i32 {
  match &combined.* { Choice.Left {value} => { increment(&mut value) } Choice.Right {..} => {} }
  return 0
}
fn code(value: i32) -> i32 { return match value { -5 => 20 0 => 10 7 if value > 100 => 30 7 => 40 _ => 50 } }
fn incomplete(value: i32) -> i32 { return match value { 0 => 1 1 => 2 } }
fn repeated(value: i32) -> i32 { return match value { 11 => 1 11 => 2 _ => 3 } }
fn outOfRange(value: u8) -> i32 { return match value { 300 => 1 _ => 0 } }
fn enumInteger(status: Status) -> i32 { return match status { 77 => 1 _ => 0 } }
fn boolInteger(flag: bool) -> i32 { return match flag { 88 => 1 _ => 0 } }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let mutated = run Semantic.demandBody(&mut store, &mut request, &id, b"mutated") |> Effect.provideMut<Allocator>(&mut allocator)
  let code = run Semantic.demandBody(&mut store, &mut request, &id, b"code") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&mutated), "a match &mut binding borrows its payload exclusively and a shared binding shares it")
  let mutatedMir = run Semantic.demandMir(&mut store, &mut request, &id, b"mutated") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(mirSwitchesCasesAndProjectedMutableRefs(&store, &mutatedMir, 2) == usize.ONE,
    "the exclusive binding borrow references the projected payload place")
  let codeBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&code, checkedBody)
  let mut integers = usize.MAX
  if let Option<Shared<TypedBody>>.Some {value} = move codeBody { integers = Shared.with<TypedBody, usize>(&value, integerArmCount) }
  run Testing.expect(integers == 4, "each integer arm keeps its literal pattern")
  let codeMir = run Semantic.demandMir(&mut store, &mut request, &id, b"code") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(mirSwitchesCasesAndProjectedMutableRefs(&store, &codeMir, usize.ZERO) == 2
      && mirSwitchesCasesAndProjectedMutableRefs(&store, &codeMir, usize.ONE) == 4,
    "one switch routes each value to its first arm, and a false guard resumes with the repeated value")
  let sharedOnly = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedOnly") |> Effect.provideMut<Allocator>(&mut allocator)
  let incomplete = run Semantic.demandBody(&mut store, &mut request, &id, b"incomplete") |> Effect.provideMut<Allocator>(&mut allocator)
  let repeated = run Semantic.demandBody(&mut store, &mut request, &id, b"repeated") |> Effect.provideMut<Allocator>(&mut allocator)
  let outOfRange = run Semantic.demandBody(&mut store, &mut request, &id, b"outOfRange") |> Effect.provideMut<Allocator>(&mut allocator)
  let enumInteger = run Semantic.demandBody(&mut store, &mut request, &id, b"enumInteger") |> Effect.provideMut<Allocator>(&mut allocator)
  let boolInteger = run Semantic.demandBody(&mut store, &mut request, &id, b"boolInteger") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&sharedOnly, RejectionCode.ExclusiveBorrowRequiresMutable, text, "&mut value", 1) &&
    rejectsSpan(&incomplete, RejectionCode.IncompleteMatch, text, "match value { 0 => 1 1 => 2 }", 0) &&
    rejectsSpan(&repeated, RejectionCode.DuplicateMatchPattern, text, "11", 1) &&
    rejectsSpan(&outOfRange, RejectionCode.IntegerOutOfRange, text, "300", 0) &&
    rejectsSpan(&enumInteger, RejectionCode.IntegerPatternOnEnum, text, "77", 0) &&
    rejectsSpan(&boolInteger, RejectionCode.UnreachableMatchArm, text, "88", 0),
    "a shared binding's exclusive borrow, an incomplete integer match, a repeated value, an out-of-range value, an enum and a bool scrutinee report precise spans",
  )
  return ()
}

// The longest projection path of any pattern binding in a checked body.
fn deepestBindingPath(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut deepest = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.PatternBinding {path, ..}, ..} = &nodes[at].kind {
      let length = Vector.length<BodyPlaceStep>(&path)
      if length > deepest { deepest = length }
    }
    at = at + usize.ONE
  }
  return deepest
}

// A nested union subpattern adds a tag test below the arm's member: bindings project through the full
// path, coverage subtracts only the tested values, and a failed test resumes dispatch at the next arm.
test effect fn nestedRefutablePatterns() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("nested-patterns.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Narrow { first: i32 }
struct Wide { first: i64 }
union Inner { Small { value: Narrow }, Empty }
union Outer { Wrap { inner: Inner }, Plain }
struct Boxed { item: Narrow | Wide }
fn routed(outer: Outer) -> i32 {
  return match move outer {
    Outer.Wrap { inner: Inner.Small { value } } if value.first > 0 => value.first
    Outer.Wrap { inner: Inner.Small {..} } => 1
    Outer.Wrap { inner: Inner.Empty {} } => 2
    Outer.Plain => 3
  }
}
fn structural(boxed: Boxed) -> i32 { return match move boxed { Boxed { item: Narrow { first } } => first Boxed { item: Wide {..} } => 0 } }
fn guardedOnly(outer: Outer) -> i32 {
  return match move outer { Outer.Wrap { inner: Inner.Small {..} } if true => 0 Outer.Wrap { inner: Inner.Empty {} } => 1 Outer.Plain => 2 }
}
fn unreachable(outer: Outer) -> i32 {
  return match move outer { Outer.Wrap { inner: Inner.Empty {} } => 0 Outer.Wrap { inner: Inner.Empty {} } => 1 _ => 2 }
}
union Maybe<T> { Some { value: T }, None }
struct Holder { slot: Maybe<Narrow> }
fn applied(holder: Holder) -> i32 {
  return match move holder {
    Holder { slot: Maybe<Narrow>.Some { value } } => value.first
    Holder { slot: Maybe<Narrow>.None } => 1
  }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let routed = run Semantic.demandBody(&mut store, &mut request, &id, b"routed") |> Effect.provideMut<Allocator>(&mut allocator)
  let structural = run Semantic.demandBody(&mut store, &mut request, &id, b"structural") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&routed) && succeeded(&structural), "nested variant and member subpatterns check")
  let routedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&routed, checkedBody)
  let structuralBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&structural, checkedBody)
  let mut depths = usize.ZERO
  if let Option<Shared<TypedBody>>.Some {value} = move routedBody { depths = Shared.with<TypedBody, usize>(&value, deepestBindingPath) }
  if let Option<Shared<TypedBody>>.Some {value} = move structuralBody { depths = depths * 10 + Shared.with<TypedBody, usize>(&value, deepestBindingPath) }
  run Testing.expect(depths == 23, "a nested binding projects through the variant fields, or the field, member and field")
  // One top switch; each nested test switches on its tag and, failing, re-dispatches the later arms.
  let routedMir = run Semantic.demandMir(&mut store, &mut request, &id, b"routed") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(mirSwitchesCasesAndProjectedMutableRefs(&store, &routedMir, usize.ZERO) == 7
      && mirSwitchesCasesAndProjectedMutableRefs(&store, &routedMir, usize.ONE) == 10,
    "a failed nested test or guard resumes dispatch at the next arm")
  let guardedOnly = run Semantic.demandBody(&mut store, &mut request, &id, b"guardedOnly") |> Effect.provideMut<Allocator>(&mut allocator)
  let unreachable = run Semantic.demandBody(&mut store, &mut request, &id, b"unreachable") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&guardedOnly, RejectionCode.MissingUnionMember, text, "match move outer { Outer.Wrap { inner: Inner.Small {..} } if true => 0 Outer.Wrap { inner: Inner.Empty {} } => 1 Outer.Plain => 2 }", 0) &&
    rejectsSpan(&unreachable, RejectionCode.UnreachableMatchArm, text, "Outer.Wrap { inner: Inner.Empty {} }", 3),
    "a guarded nested arm covers nothing and a nested arm with no uncovered value is unreachable",
  )
  let applied = run Semantic.demandMir(&mut store, &mut request, &id, b"applied") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&applied), "applied variant subpatterns test a generic nominal union field and cover it")
  return ()
}

test effect fn multiFileBuildRetainsOnlyReachedSources() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("main.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("library.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let unused = run module("unused.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let entrySource = run present("""
    import library {answer}
    import unused {neverReached}
    pub fn main() -> i32 { return answer() }
    """) |> Effect.provideMut<Allocator>(&mut allocator)
  let librarySource = run present("""
    pub fn answer() -> i32 { return 42 }
    """) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &entrySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let held = run Revision.publish(&first, &library, &librarySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = makeSemantic(run Revision.copy(&held) |> Effect.provideMut<Allocator>(&mut allocator))
  let mut request = Request.make()
  let built = run Semantic.buildMain(&mut store, &mut request, &entry, staticClosureNodes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  match move built {
    BackendBuild.Module {text, ..} => {
      run Testing.expect(
        containsIr(Bytes.asSlice(&text), b"call i32 @silk_"),
        "the emitted entry calls an imported scalar instance",
      )
    }
    BackendBuild.Rejected {..} => {
      run Testing.expect(false, "the authored multi-file scalar program is valid")
    }
    BackendBuild.Unsupported {gaps: _} => {
      run Testing.expect(false, "the imported scalar program has no backend coverage gap")
    }
  }
  run Testing.expect(
    reads(Semantic.sourceEvents(&store), &library) == usize.ONE,
    "the reached library source is read once",
  )
  run Testing.expect(
    reads(Semantic.sourceEvents(&store), &unused) == usize.ZERO,
    "an unused module remains unread",
  )
  let unrelated = run present("""
    pub fn neverReached() -> bool { return true }
    """) |> Effect.provideMut<Allocator>(&mut allocator)
  let revised = run Revision.publish(&held, &unused, &unrelated)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let hitsBefore = hits(Semantic.eventLog(&store), Family.Body)
  let startsBefore = starts(Semantic.eventLog(&store), Family.Body)
  Semantic.revise(&mut store, move revised)
  let mut warmRequest = Request.make()
  let warm = run Semantic.demandBody(&mut store, &mut warmRequest, &entry, b"main")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&warm, inspect).success &&
      hits(Semantic.eventLog(&store), Family.Body) == hitsBefore + usize.ONE &&
      starts(Semantic.eventLog(&store), Family.Body) == startsBefore &&
      Request.hasDiscovered(&warmRequest, &library) && !Request.hasDiscovered(&warmRequest, &unused),
    "publishing one unrelated file reuses the checked body and replays only its source dependencies",
  )
  return ()
}

test effect fn genericReferenceArgumentsInferFromCheckedOperands() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("reference-inference.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
fn accept<T>(first: &mut T, second: T) -> () { return () }
pub fn main() -> i32 {
  let mut number: i32 = 42
  accept(&mut number, 42)
  return number
}
fn wrong() -> i32 {
  let mut number: i32 = 0
  accept(&mut number, true)
  return number
}
"""
  let mut store = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let checked = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, AnswerView>(&checked, inspect).success,
    "generic reference template infers its referent from the checked borrow")
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.TypeMismatch, source, "true", usize.ZERO),
    "a conflicting later argument remains a type mismatch at its authored span")
  return ()
}

test effect fn foreignStaticReadsCopyThroughTheirCSymbol() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("foreign-static.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
unsafe extern "C" static foreignValue: *const i32 as "silk_foreign_value"
unsafe extern "C" static flag: bool
fn accept(value: *const i32) -> i32 { return 42 }
pub fn main() -> i32 { unsafe { return accept(foreignValue) } }
fn wrong() -> i32 { return foreignValue() }
fn unacknowledged() -> *const i32 { return foreignValue }
fn inadmissible() -> bool { unsafe { return flag } }
"""
  let mut store = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let checked = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unacknowledged = run Semantic.demandBody(&mut store, &mut request, &id, b"unacknowledged")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let inadmissible = run Semantic.demandBody(&mut store, &mut request, &id, b"inadmissible")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&checked) && rejectsSpan(&wrong, RejectionCode.NotCallable, source, "foreignValue", 2)
      && rejectsSpan(&unacknowledged, RejectionCode.UnsafeAcknowledgement, source, "foreignValue", 3)
      && rejectsSpan(&inadmissible, RejectionCode.ForeignType, source, "flag", usize.ONE),
    "an unsafe read of foreign storage is a value of its declared C type; calls, unacknowledged reads and non-C types are refused at the use")
  let built = run Semantic.buildMain(&mut store, &mut request, &id, staticClosureNodes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut loaded = false
  if let BackendBuild.Module {text, ..} = &built {
    let ir = Bytes.asSlice(&text)
    loaded = containsIr(ir, b"@\"silk_foreign_value\" = external global ptr\n")
      && containsIr(ir, b" = load ptr, ptr @\"silk_foreign_value\"")
  }
  run Testing.expect(loaded, "a foreign static read loads the external C object named by its linkage symbol")
  return ()
}

test effect fn scalarIntrinsicsRetainCheckedArithmeticAndBitcasts() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("scalar-intrinsics.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
pub fn main() -> i32 {
  let left: i32 = 40
  let right: i32 = 2
  let sum = Intrinsic.i32Add(left, right)
  let index = Intrinsic.usizeAdd(20, 22)
  if index != 42 { return 3 }
  let difference = Intrinsic.i32Subtract(sum, right)
  let narrow = Intrinsic.f32FromBits(2147483648)
  let narrowBits = Intrinsic.f32ToBits(narrow)
  let wide = Intrinsic.f64FromBits(9223372036854775808)
  let wideBits = Intrinsic.f64ToBits(wide)
  if Intrinsic.boolNot(Intrinsic.i32Equals(difference, left)) { return 1 }
  if Intrinsic.i32LessThan(&left, &right) { return 2 }
  return sum
}
fn wrongArgument() -> i32 { return Intrinsic.i32Add(true, 2) }
fn wrongArity() -> i32 { return Intrinsic.i32Add(42) }
static fn wrongPhase() -> i32 { return Intrinsic.i32Add(40, 2) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let argument = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongArgument")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let arity = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongArity")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let phase = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongPhase")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&argument, RejectionCode.TypeMismatch, text, "true", 0) &&
      rejectsSpan(&arity, RejectionCode.CallArity, text, "Intrinsic.i32Add(42)", 0) &&
      rejectsSpan(&phase, RejectionCode.StaticPhaseViolation, text, "Intrinsic.i32Add(40, 2)", 0),
    "closed scalar contracts preserve authored argument, arity and phase diagnostics",
  )
  let built = run Semantic.buildMain(&mut store, &mut request, &id, staticClosureNodes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut sizeArithmetic = false
  let mut arithmetic = false
  let mut bits = false
  let mut predicates = false
  match move built {
    BackendBuild.Module {text: irText, ..} => {
      let ir = Bytes.asSlice(&irText)
      sizeArithmetic = containsIr(ir, b"call { i64, i1 } @llvm.uadd.with.overflow.i64") &&
        containsIr(ir, b"call void @llvm.trap()")
      arithmetic = containsIr(ir, b"@llvm.sadd.with.overflow.i32") &&
        containsIr(ir, b"@llvm.ssub.with.overflow.i32") && containsIr(ir, b"call void @llvm.trap()")
      bits = containsIr(ir, b" = bitcast i32 ") && containsIr(ir, b" to float") &&
        containsIr(ir, b" = bitcast float ") && containsIr(ir, b" to i32") &&
        containsIr(ir, b" = bitcast i64 ") && containsIr(ir, b" to double") &&
        containsIr(ir, b" = bitcast double ") && containsIr(ir, b" to i64")
      predicates = containsIr(ir, b" = xor i1 ") && containsIr(ir, b" = icmp eq i32 ") &&
        containsIr(ir, b" = icmp slt i32 ") && containsIr(ir, b"load ptr, ptr")
    }
    _ => {}
  }
  run Testing.expect(sizeArithmetic, "usizeAdd reuses checked target-width unsigned addition")
  run Testing.expect(arithmetic, "integer primitives retain checked arithmetic and traps")
  run Testing.expect(bits, "floating bit conversions reinterpret both widths without numeric conversion")
  run Testing.expect(predicates, "boolean and borrowed comparison primitives retain their scalar contracts")
  return ()
}

test effect fn sequenceBoundsPrecedeReplacementCalls() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("sequence-lowering.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = run staticSemantic(&id, """
tuple Pair(i32, i32)
fn create() -> Pair { return (20, 22) }
fn sum(pair: Pair) -> i32 { return pair.0 + pair.1 }
type Values = [i32; 2]
fn replace(values: &mut Values, index: usize) -> i32 {
  values[index] = sum(create())
  return values[index]
}
pub fn main() -> i32 {
  let mut values = [1, 2]
  return replace(&mut values, values.length - 1)
}
""", MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"replace")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&answer, selectedMirIndex)
  let mut boundsBeforeCall = false
  let mut indexedWrite = false
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut blockAt = usize.ZERO
      while blockAt < blocks.length {
        if let MirTerminator.Branch {thenBlock, elseBlock, ..} = &blocks[blockAt].terminator {
          if let MirTerminator.Trap {..} = &blocks[elseBlock].terminator {
            if let MirTerminator.Call {..} = &blocks[thenBlock].terminator { boundsBeforeCall = true }
          }
        }
        let statements = Vector.asSlice<MirStatement>(&blocks[blockAt].statements)
        let mut at = usize.ZERO
        while at < statements.length {
          if let MirStatement.Assign {destination, ..} = &statements[at] {
            let projections = Vector.asSlice<MirProjection>(&destination.projections)
            if projections.length == 2 {
              if mirProjectionIsDeref(&projections[usize.ZERO]) {
                if let MirProjection.Index {..} = &projections[usize.ONE] { indexedWrite = true }
              }
            }
          }
          at = at + usize.ONE
        }
        blockAt = blockAt + usize.ONE
      }
    }
  }
  run Testing.expect(boundsBeforeCall, "the replacement call is reached only through the bounds-success block")
  run Testing.expect(indexedWrite, "indexed replacement retains reference dereference and captured index")
  let built = run Semantic.buildMain(&mut store, &mut request, &id, staticClosureNodes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut storage = false
  match move built {
    BackendBuild.Module {text, ..} => {
      let ir = Bytes.asSlice(&text)
      storage = containsIrLine(ir, b"call void @llvm.memmove.p0.p0.i64(", b" %l1, ptr %p0, i64 8, i1 false)")
        && containsIr(ir, b"icmp ult i64") && containsIrLine(ir, b" = mul i64", b", 4")
        && containsIr(ir, b"call void @llvm.trap()")
    }
    _ => ()
  }
  run Testing.expect(storage, "tuple copies and array indexing use demanded aggregate bytes and element stride")
  return ()
}

fn arrayLiteralType(body: &TypedBody) -> Option<Shared<Type>> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Aggregate {..}} = &nodes[at].kind {
      return Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Type>>()
}

fn arraySliceType(body: &TypedBody) -> Option<Shared<Type>> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.ArraySlice {..}} = &nodes[at].kind {
      return Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Type>>()
}

fn arrayLayoutIndex(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Layout {index}} = &value.outcome { return Option.some<usize>(index) }
  }
  return Option.none<usize>()
}

// Require the fixed-array referent and its checked reborrow chain, rather than only a stage.
fn bodyRetainsArrayReferenceConversion(body: &TypedBody, expectedAccess: Access) -> bool {
  let locals = TypedBody.localSlice(body)
  if locals.length != usize.ONE { return false }
  let length = Shared.with<Type, usize>(&locals[usize.ZERO].ty, fn(parameter: &Type) -> usize {
    if let Type.Reference {referent, access, ..} = &parameter.* {
      if access != expectedAccess { return usize.MAX }
      if let Option<ArrayShape>.Some {value: shape} = move Type.arrayShape(&referent) { return shape.length }
    }
    return usize.MAX
  })
  if length != 2 { return false }
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.ArraySlice {value: loan, count}, ..} = &nodes[at].kind {
      if count == 2 && loan.index < nodes.length {
        if let BodyNodeKind.Expression {form: BodyExpression.Borrow {value: place, access: loanAccess}, ..} = &nodes[loan.index].kind {
          if loanAccess == expectedAccess && place.index < nodes.length {
            if let BodyNodeKind.Expression {form: BodyExpression.Dereference {value: source}, ..} = &nodes[place.index].kind {
              if source.index < nodes.length {
                if let BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} = &nodes[source.index].kind {
                  if local.index == usize.ZERO { return true }
                }
              }
            }
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn answerRetainsArrayReferenceConversion(answer: &Result<Answer, NoRejection>, expectedAccess: Access) -> bool {
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedBody(answer) {
    return Shared.with<TypedBody, bool>(&body, fn(checked: &TypedBody) -> bool { return bodyRetainsArrayReferenceConversion(checked, expectedAccess) })
  }
  return false
}

// A borrowed array literal is its own hidden owner: the slice converts a caller-local loan whose
// operand is the evaluated two-element aggregate, not a named place.
fn bodyBorrowsArrayTemporary(body: &TypedBody, expectedAccess: Access) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.ArraySlice {value: loan, count}, ..} = &nodes[at].kind {
      if count == 2 {
        if let BodyNodeKind.Expression {ty: loanType, form: BodyExpression.Borrow {value: owner, access}} = &nodes[loan.index].kind {
          let local = Shared.with<Type, bool>(&loanType, localLoan)
          if let BodyNodeKind.Expression {ty, form: BodyExpression.Aggregate {..}} = &nodes[owner.index].kind {
            if let Option<ArrayShape>.Some {value: shape} = move Type.arrayShape(&ty) {
              if access == expectedAccess && local && shape.length == 2 { return true }
            }
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn localLoan(value: &Type) -> bool {
  if let Type.Reference {lifetime, ..} = &value.* { return Shared.with<Lifetime, bool>(&lifetime, localRegion) }
  return false
}

fn answerBorrowsArrayTemporary(answer: &Result<Answer, NoRejection>, expectedAccess: Access) -> bool {
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedBody(answer) {
    return Shared.with<TypedBody, bool>(&body, fn(checked: &TypedBody) -> bool { return bodyBorrowsArrayTemporary(checked, expectedAccess) })
  }
  return false
}

// MIR materializes the temporary into a compiler temporary local, then loans that whole local. The
// temporary holds an evaluated aggregate, or else an immediate integer that has no storage of its own.
fn mirLoansTemporary(function: &MirFunction, aggregate: bool) -> bool {
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let mut owner = usize.MAX
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut blockAt = usize.ZERO
  while blockAt < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[blockAt].statements)
    let mut statementAt = usize.ZERO
    while statementAt < statements.length {
      if let MirStatement.Assign {destination, value, ..} = &statements[statementAt] {
        let produced = match &value {
          MirRvalue.Aggregate {..} => aggregate
          MirRvalue.Use {value: MirOperand.Integer {..}} => !aggregate
          _ => false
        }
        if produced && Vector.length<MirProjection>(&destination.projections) == usize.ZERO {
          let compilerTemporary = match &locals[destination.local].kind { MirLocalKind.Temp => true
            _ => false }
          if compilerTemporary { owner = destination.local }
        }
        if let MirRvalue.Ref {place, ..} = &value {
          if owner != usize.MAX && place.local == owner && Vector.length<MirProjection>(&place.projections) == usize.ZERO { return true }
        }
      }
      statementAt = statementAt + usize.ONE
    }
    blockAt = blockAt + usize.ONE
  }
  return false
}

test effect fn arrayLiteralsRetainImmediateContextAndDiagnostics() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("array-context.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
fn empty() -> [i32; 0] { return [] }
fn narrow() -> [u8; 2] { return [20, 22] }
fn missing() -> i32 { let values = [] return 42 }
fn mixed() -> i32 { let values = [20, true] return 42 }
fn length() -> [i32; 2] { return [20] }
fn outside(values: [i32; 2]) -> i32 { return values[2] }
fn invalidIndex(values: [i32; 2], index: i32) -> i32 { return values[index] }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let empty = run Semantic.demandBody(&mut store, &mut request, &id, b"empty") |> Effect.provideMut<Allocator>(&mut allocator)
  let narrow = run Semantic.demandBody(&mut store, &mut request, &id, b"narrow") |> Effect.provideMut<Allocator>(&mut allocator)
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missing") |> Effect.provideMut<Allocator>(&mut allocator)
  let mixed = run Semantic.demandBody(&mut store, &mut request, &id, b"mixed") |> Effect.provideMut<Allocator>(&mut allocator)
  let length = run Semantic.demandBody(&mut store, &mut request, &id, b"length") |> Effect.provideMut<Allocator>(&mut allocator)
  let outside = run Semantic.demandBody(&mut store, &mut request, &id, b"outside") |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidIndex = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidIndex") |> Effect.provideMut<Allocator>(&mut allocator)
  let emptyBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&empty, checkedBody)
  let mut emptyLayout = false
  if let Option<Shared<TypedBody>>.Some {value} = move emptyBody {
    let selected = Shared.with<TypedBody, Option<Shared<Type>>>(&value, arrayLiteralType)
    if let Option<Shared<Type>>.Some {value: array} = move selected {
      let layoutAnswer = run Semantic.demandLayout(&mut store, &mut request, &id, &array) |> Effect.provideMut<Allocator>(&mut allocator)
      let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&layoutAnswer, selectedLayoutIndex)
      if let Option<usize>.Some {value: ordinal} = move index {
        if let Option<Shared<BackendLayout>>.Some {value: layout} = move Semantic.layoutAt(&store, ordinal) {
          emptyLayout = Shared.with<BackendLayout, bool>(&layout, fn(facts: &BackendLayout) -> bool {
            if let LayoutStorage.Sequence {count, stride, ..} = &facts.storage {
              return facts.size == usize.ZERO && facts.alignment == 4 && count == usize.ZERO && stride == 4 && BackendLayout.childCount(facts) == usize.ONE
            }
            return false
          })
        }
      }
    }
  }
  run Testing.expect(emptyLayout, "an empty array retains its element layout and logical zero count without expanded fields")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&empty, bodyAnswerIsContractTyped)
    && Shared.with<Result<Answer, NoRejection>, bool>(&narrow, bodyAnswerIsContractTyped), "empty and narrow array literals inherit immediate element context")
  run Testing.expect(rejectsSpan(&missing, RejectionCode.UninferredArrayElement, text, "[]", 1)
    && rejectsSpan(&mixed, RejectionCode.ArrayElementMismatch, text, "true", 0)
    && rejectsSpan(&length, RejectionCode.ArrayLengthMismatch, text, "[20]", 0), "array element inference and declared length retain distinct diagnostics")
  let outsideStart = offsetOf(text, "values[2]", usize.ZERO) + 7
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&outside, rejection)
  let mut boundsRejected = false
  if let Option<Shared<Rejection>>.Some {value} = move found {
    boundsRejected = Shared.with<Rejection, bool>(&value, fn(diagnostic: &Rejection) -> bool {
      return diagnostic.code == RejectionCode.IndexOutOfRange && diagnostic.span.start == outsideStart && diagnostic.span.end == outsideStart + usize.ONE
    })
  }
  run Testing.expect(boundsRejected
    && rejectsSpan(&invalidIndex, RejectionCode.InvalidIndexType, text, "index", 1), "known bounds and non-usize indices reject at their index spans")
  return ()
}

fn checkedDirectCalls(answer: &Result<Answer, NoRejection>) -> usize {
  if let Option<Shared<TypedBody>>.Some {value} = move checkedBody(answer) {
    return Shared.with<TypedBody, usize>(&value, directCalls)
  }
  return usize.MAX
}

// Typing reads call targets only from the body's discovered call table, so a call nested in an
// array element, a field initializer's array or a compileError message must be discovered too.
test effect fn nestedExpressionCallsResolveTheirTargets() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("nested-calls.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Pair { values: [i32; 2] }
fn twice(value: i32) -> i32 { return value * 2 }
fn elements() -> i32 {
  let values = [twice(20), 2]
  return values[0] + values[1]
}
fn nested() -> i32 {
  let pair = Pair { values: [twice(10), 1] }
  let grid = [[twice(1)], [twice(2)]]
  return pair.values[0] + grid[1][0]
}
static fn label() -> string<'static> { return "computed failure" }
static fn computed(value: u32) -> u32 { compileError(label()) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let elements = run Semantic.demandBody(&mut store, &mut request, &id, b"elements") |> Effect.provideMut<Allocator>(&mut allocator)
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested") |> Effect.provideMut<Allocator>(&mut allocator)
  let computed = run Semantic.demandBody(&mut store, &mut request, &id, b"computed") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, usize>(&elements, checkedDirectCalls) == usize.ONE
    && Shared.with<Result<Answer, NoRejection>, usize>(&nested, checkedDirectCalls) == 3,
    "array elements, nested arrays and arrays in field initializers keep their resolved calls")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, usize>(&computed, checkedDirectCalls) != usize.MAX,
    "a static body checks once its compileError message call resolves")
  return ()
}

test effect fn sliceConversionsRetainRegionAccessAndDiagnostics() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("slice-regions.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
fn shared(values: &[i32]) -> i32 { return values[0] }
fn exclusive(values: &mut [i32]) -> i32 { return shared(&values) }
fn wrongSliceElement() -> i32 { let flags = [true] return shared(&flags) }
fn wrongSliceAccess() -> i32 { let values = [20] return exclusive(&values) }
fn permanent(values: &'static [i32]) -> i32 { return 42 }
fn wrongSliceLifetime() -> i32 { let values = [20] return permanent(&values) }
fn widen(view: &[i32]) -> &'static [i32] { return &view }
fn leakArray() -> &'static [i32] { let local = [42] return &local }
fn sameRegion<'a>(kept: &'a [i32]) -> &'a [i32] { return &kept }
fn arraySameRegion<'a>(source: &'a ([i32; 2])) -> &'a [i32] { return &source }
fn staticSameRegion(permanentView: &'static [i32]) -> &'static [i32] { return &permanentView }
fn validStaticCall(permanentView: &'static [i32]) -> i32 { return permanent(&permanentView) }
fn arrayStaticCall(source: &'static ([i32; 2])) -> i32 { return permanent(&source) }
fn arrayMutableCall(source: &mut ([i32; 2])) -> i32 { return exclusive(&mut source) }
fn wrongArrayReborrow(source: &([i32; 2])) -> i32 { return exclusive(&mut source) }
fn widenLocal(viewLocal: &[i32]) -> i32 { let extended: &'static [i32] = &viewLocal return 42 }
fn leakArrayLocal() -> i32 { let localArray = [42] let extended: &'static [i32] = &localArray return 42 }
fn initSameRegion<'a>(same: &'a [i32]) -> &'a [i32] { let held: &'a [i32] = &same return held }
fn pairViews<'a>(first: &'a [i32], second: &'a [i32]) -> i32 { return 42 }
fn holdView<T>(source: &[T]) -> &[T] { return source }
fn distinctRegions() -> i32 { let first = [20] let second = [22] let held = holdView(&first) return pairViews(&second, held) }
fn wrongRegionElement() -> i32 { let first = [true] let second = [22] let held = holdView(&first) return pairViews(&second, held) }
fn fixedRegions<'a, 'b>(first: &'a [i32], second: &'b [i32]) -> i32 { return pairViews(first, second) }
fn narrowBytes(bytes: &[u8]) -> u8 { return bytes[0] }
fn readScalar(value: &i32) -> i32 { return 0 }
fn temporary() -> i32 { return shared(&[40, 2]) }
fn mutableTemporary() -> i32 { return exclusive(&mut [40, 2]) }
fn narrowTemporary() -> u8 { return narrowBytes(&[1, 2]) }
fn localTemporary() -> i32 { let view = &[40, 2] return view[0] + view[1] }
fn leakTemporary() -> &'static [i32] { return &[42] }
fn scalarTemporary() -> i32 { return readScalar(&5) }
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn tokens(values: &[Token]) -> i32 { return 0 }
fn droppedTemporary() -> i32 { return tokens(&[Token { value: 1 }]) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let sliceElement = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongSliceElement") |> Effect.provideMut<Allocator>(&mut allocator)
  let sliceAccess = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongSliceAccess") |> Effect.provideMut<Allocator>(&mut allocator)
  let sliceLifetime = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongSliceLifetime") |> Effect.provideMut<Allocator>(&mut allocator)
  let widened = run Semantic.demandBody(&mut store, &mut request, &id, b"widen") |> Effect.provideMut<Allocator>(&mut allocator)
  let leakedArray = run Semantic.demandBody(&mut store, &mut request, &id, b"leakArray") |> Effect.provideMut<Allocator>(&mut allocator)
  let keptSlice = run Semantic.demandBody(&mut store, &mut request, &id, b"sameRegion") |> Effect.provideMut<Allocator>(&mut allocator)
  let keptArray = run Semantic.demandBody(&mut store, &mut request, &id, b"arraySameRegion") |> Effect.provideMut<Allocator>(&mut allocator)
  let keptStatic = run Semantic.demandBody(&mut store, &mut request, &id, b"staticSameRegion") |> Effect.provideMut<Allocator>(&mut allocator)
  let keptStaticCall = run Semantic.demandBody(&mut store, &mut request, &id, b"validStaticCall") |> Effect.provideMut<Allocator>(&mut allocator)
  let keptArrayCall = run Semantic.demandBody(&mut store, &mut request, &id, b"arrayStaticCall") |> Effect.provideMut<Allocator>(&mut allocator)
  let mutableArrayCall = run Semantic.demandBody(&mut store, &mut request, &id, b"arrayMutableCall") |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidArrayReborrow = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongArrayReborrow") |> Effect.provideMut<Allocator>(&mut allocator)
  let widenedLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"widenLocal") |> Effect.provideMut<Allocator>(&mut allocator)
  let leakedArrayLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"leakArrayLocal") |> Effect.provideMut<Allocator>(&mut allocator)
  let keptInitializer = run Semantic.demandBody(&mut store, &mut request, &id, b"initSameRegion") |> Effect.provideMut<Allocator>(&mut allocator)
  let distinctRegions = run Semantic.demandBody(&mut store, &mut request, &id, b"distinctRegions") |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongRegionElement = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongRegionElement") |> Effect.provideMut<Allocator>(&mut allocator)
  let fixedRegions = run Semantic.demandBody(&mut store, &mut request, &id, b"fixedRegions") |> Effect.provideMut<Allocator>(&mut allocator)
  let temporary = run Semantic.demandBody(&mut store, &mut request, &id, b"temporary") |> Effect.provideMut<Allocator>(&mut allocator)
  let mutableTemporary = run Semantic.demandBody(&mut store, &mut request, &id, b"mutableTemporary") |> Effect.provideMut<Allocator>(&mut allocator)
  let narrowTemporary = run Semantic.demandBody(&mut store, &mut request, &id, b"narrowTemporary") |> Effect.provideMut<Allocator>(&mut allocator)
  let localTemporary = run Semantic.demandBody(&mut store, &mut request, &id, b"localTemporary") |> Effect.provideMut<Allocator>(&mut allocator)
  let leakTemporary = run Semantic.demandBody(&mut store, &mut request, &id, b"leakTemporary") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&temporary, fn(answer: &Result<Answer, NoRejection>) -> bool { return answerBorrowsArrayTemporary(answer, Access.Shared) }),
    "a borrowed array literal is a caller-local hidden owner")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&mutableTemporary, fn(answer: &Result<Answer, NoRejection>) -> bool { return answerBorrowsArrayTemporary(answer, Access.Mutable) }),
    "a mutable loan of a borrowed array literal needs no named mutable owner")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&narrowTemporary, bodyAnswerIsContractTyped),
    "a borrowed array literal infers its elements from the slice parameter")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&localTemporary, bodyAnswerIsContractTyped),
    "a local view keeps its borrowed array literal owner")
  run Testing.expect(rejectsSpan(&leakTemporary, RejectionCode.TypeMismatch, text, "&[42]", usize.ZERO),
    "a temporary-derived view cannot escape its owner")
  let temporaryMirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"temporary") |> Effect.provideMut<Allocator>(&mut allocator)
  let temporaryMirIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&temporaryMirAnswer, selectedMirIndex)
  let mut temporaryPlace = false
  if let Option<usize>.Some {value: index} = move temporaryMirIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) { temporaryPlace = mirLoansTemporary(function, true) }
  }
  let scalarMirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"scalarTemporary") |> Effect.provideMut<Allocator>(&mut allocator)
  let scalarMirIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&scalarMirAnswer, selectedMirIndex)
  let mut scalarPlace = false
  if let Option<usize>.Some {value: index} = move scalarMirIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) { scalarPlace = mirLoansTemporary(function, false) }
  }
  run Testing.expect(temporaryPlace && scalarPlace,
    "MIR loans the whole compiler temporary holding the evaluated array literal or the materialized scalar literal")
  let droppedMirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"droppedTemporary") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &droppedMirAnswer, usize.ZERO) == usize.ONE && glueFact(&store, &droppedMirAnswer, 7) == usize.ONE,
    "a borrowed array literal whose elements need cleanup is dropped once, after the call that borrows it")
  run Testing.expect(retainsRegionRelation(&distinctRegions, text, "pairViews(&second, held)", usize.ZERO)
    && rejectsSpan(&wrongRegionElement, RejectionCode.TypeMismatch, text, "pairViews(&second, held)", usize.ONE),
    "a repeated shared-slice binder with distinct actual caller-local regions relates them as an open obligation")
  run Testing.expect(succeeded(&fixedRegions) && regionRelationCount(&fixedRegions) == usize.ZERO,
    "two declared regions meet a repeated shared-slice binder at their complete meet, with no open relation")
  run Testing.expect(rejectsSpan(&widened, RejectionCode.TypeMismatch, text, "&view", usize.ZERO)
    && rejectsSpan(&leakedArray, RejectionCode.TypeMismatch, text, "&local", usize.ZERO)
    && rejectsSpan(&widenedLocal, RejectionCode.TypeMismatch, text, "&viewLocal", usize.ZERO)
    && rejectsSpan(&leakedArrayLocal, RejectionCode.TypeMismatch, text, "&localArray", usize.ZERO),
    "fixed static return and initializer contexts cannot widen slice reborrows or owned array loans")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&keptSlice, bodyAnswerIsContractTyped)
    && Shared.with<Result<Answer, NoRejection>, bool>(&keptArray, bodyAnswerIsContractTyped)
    && Shared.with<Result<Answer, NoRejection>, bool>(&keptStatic, bodyAnswerIsContractTyped)
    && Shared.with<Result<Answer, NoRejection>, bool>(&keptStaticCall, bodyAnswerIsContractTyped)
    && Shared.with<Result<Answer, NoRejection>, bool>(&keptArrayCall, bodyAnswerIsContractTyped)
    && Shared.with<Result<Answer, NoRejection>, bool>(&mutableArrayCall, bodyAnswerIsContractTyped)
    && Shared.with<Result<Answer, NoRejection>, bool>(&keptInitializer, bodyAnswerIsContractTyped),
    "slice reborrows and array-reference conversion retain the actual same-region evidence")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&keptArray, fn(answer: &Result<Answer, NoRejection>) -> bool { return answerRetainsArrayReferenceConversion(answer, Access.Shared) })
    && Shared.with<Result<Answer, NoRejection>, bool>(&keptArrayCall, fn(answer: &Result<Answer, NoRejection>) -> bool { return answerRetainsArrayReferenceConversion(answer, Access.Shared) })
    && Shared.with<Result<Answer, NoRejection>, bool>(&mutableArrayCall, fn(answer: &Result<Answer, NoRejection>) -> bool { return answerRetainsArrayReferenceConversion(answer, Access.Mutable) }),
    "array-reference returns and calls convert a fixed referent through its checked dereference and loan")
  run Testing.expect(rejectsSpan(&invalidArrayReborrow, RejectionCode.ExclusiveBorrowRequiresMutable, text, "&mut source", usize.ONE),
    "slice shape hints cannot strengthen shared array-reference access")
  run Testing.expect(rejectsSpan(&sliceElement, RejectionCode.TypeMismatch, text, "shared(&flags)", 0) &&
    rejectsSpan(&sliceAccess, RejectionCode.TypeMismatch, text, "exclusive(&values)", 0) &&
    rejectsSpan(&sliceLifetime, RejectionCode.TypeMismatch, text, "permanent(&values)", 0),
    "slice conversion preserves incompatible element, access and lifetime diagnostics")
  return ()
}

test effect fn sliceDescriptorsRetainLayoutBoundsAndAbi() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("slice-descriptors.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
fn shared(values: &[i32]) -> i32 { return values[0] }
fn exclusive(values: &mut [i32]) -> i32 { return shared(&values) }
fn replacement() -> i32 { return 20 }
fn forward(values: &mut [i32], index: usize) -> i32 {
  values[index] = replacement()
  if values.length == 2 { return exclusive(&mut values) + values[1] }
  return 0
}
pub fn main() -> i32 { let mut values = [0, 22] return forward(&mut values, 0) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let mainBody = run Semantic.demandBody(&mut store, &mut request, &id, b"main") |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&mainBody, checkedBody)
  let mut descriptorLayout = false
  if let Option<Shared<TypedBody>>.Some {value: body} = move selectedBody {
    let descriptor = Shared.with<TypedBody, Option<Shared<Type>>>(&body, arraySliceType)
    if let Option<Shared<Type>>.Some {value: ty} = move descriptor {
      let demanded = run Semantic.demandLayout(&mut store, &mut request, &id, &ty) |> Effect.provideMut<Allocator>(&mut allocator)
      let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&demanded, arrayLayoutIndex)
      if let Option<usize>.Some {value: index} = move selected {
        if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
          descriptorLayout = Shared.with<BackendLayout, bool>(&facts, fn(layout: &BackendLayout) -> bool {
            if let LayoutStorage.Slice {stride, lengthOffset, ..} = &layout.storage {
              return layout.size == 16 && layout.alignment == 8 && layout.abi == LayoutAbi.Indirect
                && stride == 4 && lengthOffset == 8 && BackendLayout.childCount(layout) == usize.ONE
                && BackendLayout.fieldCount(layout) == usize.ZERO
            }
            return false
          })
        }
      }
    }
  }
  run Testing.expect(descriptorLayout, "runtime slices demand two neutral words and one borrowed element layout")
  let sliceMirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"forward") |> Effect.provideMut<Allocator>(&mut allocator)
  let sliceMirIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&sliceMirAnswer, selectedMirIndex)
  let mut runtimeBounds = false
  let mut boundsBeforeReplacement = false
  if let Option<usize>.Some {value: index} = move sliceMirIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut blockAt = usize.ZERO
      while blockAt < blocks.length {
        if let MirTerminator.Branch {thenBlock, elseBlock, ..} = &blocks[blockAt].terminator {
          if let MirTerminator.Trap {..} = &blocks[elseBlock].terminator {
            if let MirTerminator.Call {..} = &blocks[thenBlock].terminator { boundsBeforeReplacement = true }
            let statements = Vector.asSlice<MirStatement>(&blocks[blockAt].statements)
            let mut statementAt = usize.ZERO
            while statementAt < statements.length {
              if let MirStatement.Assign {value: MirRvalue.SliceLength {..}, ..} = &statements[statementAt] { runtimeBounds = true }
              statementAt = statementAt + usize.ONE
            }
          }
        }
        blockAt = blockAt + usize.ONE
      }
    }
  }
  run Testing.expect(runtimeBounds && boundsBeforeReplacement,
    "slice bounds read runtime length before the replacement call can run")
  let unitElement = run Shared.make<Type>(Type.Unit) |> Effect.provideMut<Allocator>(&mut allocator)
  let staticRegion = run Shared.make<Lifetime>(Lifetime.Static) |> Effect.provideMut<Allocator>(&mut allocator)
  let emptySliceType = run Shared.make<Type>(Type.Slice {
    element: move unitElement, access: Access.Shared, lifetime: move staticRegion,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let zeroLayoutAnswer = run Semantic.demandLayout(&mut store, &mut request, &id, &emptySliceType) |> Effect.provideMut<Allocator>(&mut allocator)
  let zeroLayoutIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&zeroLayoutAnswer, arrayLayoutIndex)
  let mut zeroStride = false
  if let Option<usize>.Some {value: index} = move zeroLayoutIndex {
    if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
      zeroStride = Shared.with<BackendLayout, bool>(&facts, fn(layout: &BackendLayout) -> bool {
        if let LayoutStorage.Slice {stride, lengthOffset, ..} = &layout.storage {
          return layout.size == 16 && stride == usize.ZERO && lengthOffset == 8
        }
        return false
      })
    }
  }
  run Testing.expect(zeroStride, "zero-size elements retain a runtime logical length independently of their zero stride")
  let sliceBuild = run Semantic.buildMain(&mut store, &mut request, &id, staticClosureNodes) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut descriptorAbi = false
  if let BackendBuild.Module {text: llvm, ..} = &sliceBuild {
    let ir = Bytes.asSlice(&llvm)
    descriptorAbi = containsIrLine(ir, b"call void @llvm.memmove.p0.p0.i64(", b" %l1, ptr %p0, i64 16, i1 false)")
      && containsIrLine(ir, b"getelementptr i8", b", i64 8")
      && containsIr(ir, b"store i64 2") && containsIr(ir, b"icmp ult i64")
      && containsIr(ir, b"call void @llvm.trap()")
  }
  run Testing.expect(descriptorAbi, "array conversion, forwarding and shared reborrow use owned descriptor slots and runtime bounds")
  return ()
}

// Whether MIR builds one descriptor from static storage holding exactly `bytes`.
fn buildsStaticDescriptor(function: &MirFunction, bytes: &[u8]) -> bool {
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut blockAt = usize.ZERO
  while blockAt < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[blockAt].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Assign {value: MirRvalue.Slice {data: MirOperand.StaticBytes {bytes: stored}, count}, ..} = &statements[at] {
        if let MirOperand.Integer {decimal, negative, ty} = &count {
          if !negative && Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool { return witnessPrimitive(value, b"usize") })
            && decimalEqualsUsize(Bytes.asSlice(&decimal), bytes.length) && sameBytes(Bytes.asSlice(&stored), bytes) { return true }
        }
      }
      at = at + usize.ONE
    }
    blockAt = blockAt + usize.ONE
  }
  return false
}

effect fn conversionControl(key: &InstanceKey, value: MirOperand, target: &Shared<Type>, parameters: Vector<Shared<Type>>) -> MirFunction
! OutOfMemoryError ? &mut Allocator {
  let empty = Vector.make<InstanceKey>()
  let mut function = run recipeControlMir(key, Vector.asSlice<InstanceKey>(&empty), Option.none<bool>(), true)
  let integer = run specializationPrimitive(b"i32")
  let origin = BodyOrigin {syntax: HirId {index: usize.ZERO}, span: Span.make(usize.ZERO, usize.ONE)}
  function.result = Shared.clone<Type>(&integer)
  function.locals = Vector.make<MirLocal>()
  run Vector.append<MirLocal>(&mut function.locals, MirLocal {ty: move integer, kind: MirLocalKind.Return, origin: origin})
  let listed = Vector.asSlice<Shared<Type>>(&parameters)
  let mut at = usize.ZERO
  while at < listed.length {
    run Vector.append<MirLocal>(&mut function.locals, MirLocal {ty: Shared.clone<Type>(&listed[at]), kind: MirLocalKind.Parameter {index: at}, origin: origin})
    at = at + usize.ONE
  }
  function.parameters = move parameters
  let mut statements = Vector.make<MirStatement>()
  run Vector.append<MirStatement>(&mut statements, MirStatement.Assign {
    destination: MirPlace {local: usize.ZERO, projections: Vector.make<MirProjection>()},
    value: MirRvalue.Convert {value: move value, ty: Shared.clone<Type>(target)}, origin: origin})
  function.blocks = Vector.make<MirBlock>()
  run Vector.append<MirBlock>(&mut function.blocks, MirBlock {statements: move statements, terminator: MirTerminator.Return {origin: origin}})
  return move function
}

effect fn conversionRejects(key: &InstanceKey, source: MirOperand, target: &Shared<Type>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let function = run conversionControl(key, move source, target, Vector.make<Shared<Type>>())
  let machine = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let layouts = run scalarControlLayouts(&function, &machine)
  let foreign = Vector.make<CAbi.Signature>()
  let result = run Effect.result(emitClosedMir(&function, &machine, Vector.asSlice<TypeLayout>(&layouts), Vector.asSlice<CAbi.Signature>(&foreign)))
  return match &result {
    Result<Bytes, BackendGap | OutOfMemoryError>.Failure {error} => match &error {
      BackendGap {code, source: gapSource, ..} => code == GapCode.TypedForm && match &gapSource {
        GapSource.Declaration {span, ..} => span.start == usize.ZERO && span.end == usize.ONE
        _ => false
      }
      _ => false
    }
    _ => false
  }
}

test effect fn numericConversionValidatesCategoriesAndRanges() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run numericConversionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn numericConversionClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("numeric-conversion.silk")
  let key = run recipeControlKey(&id, b"convert", false)
  let machine = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let integer = run specializationPrimitive(b"i32")
  let unsigned = run specializationPrimitive(b"u32")
  let byte = run specializationPrimitive(b"u8")
  let function = run conversionControl(&key, run typedInteger(b"u8", b"255"), &integer, Vector.make<Shared<Type>>())
  let other = run conversionControl(&key, run typedInteger(b"u8", b"255"), &unsigned, Vector.make<Shared<Type>>())
  let lower = run conversionControl(&key, run typedInteger(b"u8", b"5"), &integer, Vector.make<Shared<Type>>())
  let firstRecipe = run InstanceRecipe.make(&function)
  let otherRecipe = run InstanceRecipe.make(&other)
  let lowerRecipe = run InstanceRecipe.make(&lower)
  run Testing.expect(!sameBytes(Bytes.asSlice(&firstRecipe.shape), Bytes.asSlice(&otherRecipe.shape))
    && !sameBytes(Bytes.asSlice(&firstRecipe.shape), Bytes.asSlice(&lowerRecipe.shape)),
    "conversion recipes retain both the operand identity and the destination type")
  let foreign = Vector.make<CAbi.Signature>()
  let mut cases = Vector.make<MirOperand>()
  let mut targets = Vector.make<Shared<Type>>()
  let mut expected = Vector.make<Bytes>()
  run Vector.append<MirOperand>(&mut cases, run typedInteger(b"u8", b"255"))
  run Vector.append<Shared<Type>>(&mut targets, Shared.clone<Type>(&integer))
  run Vector.append<Bytes>(&mut expected, run Bytes.copy(b" = zext i8 255 to i32\n"))
  run Vector.append<MirOperand>(&mut cases, run typedInteger(b"i8", b"1"))
  run Vector.append<Shared<Type>>(&mut targets, Shared.clone<Type>(&integer))
  run Vector.append<Bytes>(&mut expected, run Bytes.copy(b" = sext i8 1 to i32\n"))
  run Vector.append<MirOperand>(&mut cases, run typedInteger(b"u16", b"300"))
  run Vector.append<Shared<Type>>(&mut targets, Shared.clone<Type>(&byte))
  run Vector.append<Bytes>(&mut expected, run Bytes.copy(b" = icmp ugt i16 300, 255\n"))
  run Vector.append<MirOperand>(&mut cases, run typedInteger(b"i32", b"7"))
  run Vector.append<Shared<Type>>(&mut targets, Shared.clone<Type>(&unsigned))
  run Vector.append<Bytes>(&mut expected, run Bytes.copy(b" = icmp slt i32 7, 0\n"))
  // 2.5 as f64; the low bound is -(2^31 + 1) and the high bound 2^31, both exact.
  run Vector.append<MirOperand>(&mut cases, MirOperand.Float {bits: 4612811918334230528, ty: run specializationPrimitive(b"f64")})
  run Vector.append<Shared<Type>>(&mut targets, Shared.clone<Type>(&integer))
  run Vector.append<Bytes>(&mut expected, run Bytes.copy(b" = fcmp ule double 0x4004000000000000, 0xC1E0000000200000\n"))
  let destinations = Vector.asSlice<Shared<Type>>(&targets)
  let fragments = Vector.asSlice<Bytes>(&expected)
  let mut at = usize.ZERO
  while Vector.length<MirOperand>(&cases) != usize.ZERO {
    let selected = Vector.remove<MirOperand>(&mut cases, usize.ZERO)
    let control = run conversionControl(&key, move selected, &destinations[at], Vector.make<Shared<Type>>())
    let layouts = run scalarControlLayouts(&control, &machine)
    let llvm = run emitClosedMir(&control, &machine, Vector.asSlice<TypeLayout>(&layouts), Vector.asSlice<CAbi.Signature>(&foreign))
    let ir = Bytes.asSlice(&llvm)
    let guarded = containsIr(ir, b"call void @llvm.trap()")
    run Testing.expect(containsIr(ir, Bytes.asSlice(&fragments[at])) && guarded == (at >= 2) && !containsIr(ir, b"nneg"),
      "exact widenings extend without a range check; narrowing, sign-changing and floating sources trap outside the destination range")
    at = at + usize.ONE
  }
  let mut invalid = Vector.make<MirOperand>()
  run Vector.append<MirOperand>(&mut invalid, MirOperand.Boolean {value: true})
  let pointer = run Shared.make<Type>(Type.Pointer {pointee: Shared.clone<Type>(&byte), access: Access.Shared,
    nullable: true, multiplicity: Multiplicity.Many, alignment: Option.none<u64>()})
  run Vector.append<MirOperand>(&mut invalid, MirOperand.Null {ty: Shared.clone<Type>(&pointer)})
  run Vector.append<MirOperand>(&mut invalid, MirOperand.Unit)
  while Vector.length<MirOperand>(&invalid) != usize.ZERO {
    let selected = Vector.remove<MirOperand>(&mut invalid, usize.ZERO)
    run Testing.expect(run conversionRejects(&key, move selected, &integer),
      "bool, pointer and unit source categories reject with the structured typed-form gap")
  }
  let mut invalidTargets = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut invalidTargets, run specializationPrimitive(b"bool"))
  run Vector.append<Shared<Type>>(&mut invalidTargets, move pointer)
  run Vector.append<Shared<Type>>(&mut invalidTargets, run Shared.make<Type>(Type.Unit))
  let rejected = Vector.asSlice<Shared<Type>>(&invalidTargets)
  at = usize.ZERO
  while at < rejected.length {
    run Testing.expect(run conversionRejects(&key, run typedInteger(b"u8", b"1"), &rejected[at]),
      "numeric conversion also rejects non-numeric destinations")
    at = at + usize.ONE
  }
  return ()
}

// A referenced record demands its own layout before loading the unsigned field.
effect fn projectedConversionControl(key: &InstanceKey, record: &Shared<Type>, moves: bool, projected: bool) -> MirFunction
! OutOfMemoryError ? &mut Allocator {
  let reference = run Shared.make<Type>(Type.Reference {referent: Shared.clone<Type>(record), access: Access.Shared,
    lifetime: run Shared.make<Lifetime>(Lifetime.Static)})
  let mut parameters = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut parameters, move reference)
  run Vector.append<Shared<Type>>(&mut parameters, run specializationPrimitive(b"u8"))
  let mut place = MirPlace {local: 2, projections: Vector.make<MirProjection>()}
  if projected {
    place.local = usize.ONE
    run Vector.append<MirProjection>(&mut place.projections, MirProjection.Deref)
    run Vector.append<MirProjection>(&mut place.projections, MirProjection.Field {index: usize.ZERO})
  }
  let operand = runtimeSliceOperand(move place, moves)
  let integer = run specializationPrimitive(b"i32")
  return run conversionControl(key, move operand, &integer, move parameters)
}

test effect fn numericConversionRetainsProjectedLayoutsAndOperands() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run projectedConversionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn projectedConversionClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("unsigned-projected-widening.silk")
  let key = run recipeControlKey(&id, b"widen", false)
  let mut owners = Vector.make<OwnerStep>()
  run Vector.append<OwnerStep>(&mut owners, OwnerStep {kind: OwnerKind.Struct,
    name: Option.some<Bytes>(run Bytes.copy(b"ByteBox")), occurrence: usize.ZERO})
  let declaration = run DeclarationId.fromParts(run ModuleId.copy(&id), move owners)
  let record = run specializationNominal(&declaration, Vector.make<Argument>())
  let machine = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let mut mode = usize.ZERO
  while mode < 2 {
    let function = run projectedConversionControl(&key, &record, mode == usize.ONE, true)
    let ordinary = run projectedConversionControl(&key, &record, mode == usize.ONE, false)
    let recipe = run InstanceRecipe.make(&function)
    let unprojected = run InstanceRecipe.make(&ordinary)
    run Testing.expect(!sameBytes(Bytes.asSlice(&recipe.shape), Bytes.asSlice(&unprojected.shape)),
      "projected Copy and Move operands retain their complete place dependencies in recipes")
    let demands = run mirLayoutDemands(&function)
    let needed = Vector.asSlice<LayoutDemand>(&demands)
    let mut projected = false
    if needed.length == 4 {
      projected = Shared.with<Type, bool>(&needed[3].ty, fn(value: &Type) -> bool {
        return match &value.* { Type.Nominal {declaration: nominalId, ..} => DeclarationId.named(&nominalId, b"ByteBox") _ => false }
      })
    }
    run Testing.expect(projected, "a conversion demands the referenced record's layout through its projected operand")
    let layouts = run scalarControlLayouts(&function, &machine)
    let foreign = Vector.make<CAbi.Signature>()
    let llvm = run emitClosedMir(&function, &machine, Vector.asSlice<TypeLayout>(&layouts), Vector.asSlice<CAbi.Signature>(&foreign))
    run Testing.expect(conversionUsesProjectedLoad(Bytes.asSlice(&llvm)),
      "the exact byte loaded from the referenced record feeds the conversion with complete demanded layout facts")
    mode = mode + usize.ONE
  }
  return ()
}

// Constructed ordinary MIR isolates descriptor mechanics from the later storage intrinsics.
effect fn runtimeSliceControl(key: &InstanceKey, dataMoves: bool, countMoves: bool, countLocal: usize) -> MirFunction
! OutOfMemoryError ? &mut Allocator {
  let empty = Vector.make<InstanceKey>()
  let mut function = run recipeControlMir(key, Vector.asSlice<InstanceKey>(&empty), Option.none<bool>(), true)
  let word = run specializationPrimitive(b"usize")
  let byte = run specializationPrimitive(b"u8")
  let lifetime = run Shared.make<Lifetime>(Lifetime.Static)
  let pointer = run Shared.make<Type>(Type.Pointer {pointee: Shared.clone<Type>(&byte), access: Access.Shared,
    nullable: true, multiplicity: Multiplicity.Many, alignment: Option.none<u64>()})
  let dataRef = run Shared.make<Type>(Type.Reference {referent: move pointer, access: Access.Shared,
    lifetime: Shared.clone<Lifetime>(&lifetime)})
  let countRef = run Shared.make<Type>(Type.Reference {referent: Shared.clone<Type>(&word), access: Access.Shared,
    lifetime: Shared.clone<Lifetime>(&lifetime)})
  let descriptor = run Shared.make<Type>(Type.Slice {element: move byte, access: Access.Shared, lifetime: move lifetime})
  let origin = BodyOrigin {syntax: HirId {index: usize.ZERO}, span: Span.make(usize.ZERO, usize.ONE)}
  function.result = Shared.clone<Type>(&word)
  function.locals = Vector.make<MirLocal>()
  run Vector.append<MirLocal>(&mut function.locals, MirLocal {ty: move word, kind: MirLocalKind.Return, origin: origin})
  run Vector.append<MirLocal>(&mut function.locals, MirLocal {ty: Shared.clone<Type>(&dataRef), kind: MirLocalKind.Parameter {index: usize.ZERO}, origin: origin})
  run Vector.append<MirLocal>(&mut function.locals, MirLocal {ty: Shared.clone<Type>(&countRef), kind: MirLocalKind.Parameter {index: usize.ONE}, origin: origin})
  run Vector.append<MirLocal>(&mut function.locals, MirLocal {ty: Shared.clone<Type>(&countRef), kind: MirLocalKind.Parameter {index: 2}, origin: origin})
  run Vector.append<MirLocal>(&mut function.locals, MirLocal {ty: move descriptor, kind: MirLocalKind.Temp, origin: origin})
  run Vector.append<Shared<Type>>(&mut function.parameters, move dataRef)
  run Vector.append<Shared<Type>>(&mut function.parameters, Shared.clone<Type>(&countRef))
  run Vector.append<Shared<Type>>(&mut function.parameters, move countRef)
  let mut dataPlace = MirPlace {local: usize.ONE, projections: Vector.make<MirProjection>()}
  let mut countPlace = MirPlace {local: countLocal, projections: Vector.make<MirProjection>()}
  run Vector.append<MirProjection>(&mut dataPlace.projections, MirProjection.Deref)
  run Vector.append<MirProjection>(&mut countPlace.projections, MirProjection.Deref)
  let data = runtimeSliceOperand(move dataPlace, dataMoves)
  let count = runtimeSliceOperand(move countPlace, countMoves)
  let mut statements = Vector.make<MirStatement>()
  run Vector.append<MirStatement>(&mut statements, MirStatement.Assign {
    destination: MirPlace {local: 4, projections: Vector.make<MirProjection>()},
    value: MirRvalue.Slice {data: move data, count: move count}, origin: origin})
  run Vector.append<MirStatement>(&mut statements, MirStatement.Assign {
    destination: MirPlace {local: usize.ZERO, projections: Vector.make<MirProjection>()},
    value: MirRvalue.SliceLength {place: MirPlace {local: 4, projections: Vector.make<MirProjection>()}}, origin: origin})
  function.blocks = Vector.make<MirBlock>()
  run Vector.append<MirBlock>(&mut function.blocks, MirBlock {statements: move statements, terminator: MirTerminator.Return {origin: origin}})
  return move function
}

// The projected count's load result must feed the length store before SliceLength reads it.
fn runtimeSliceStoresProjectedCount(ir: &[u8]) -> bool {
  let mut start = usize.ZERO
  while start < ir.length {
    let mut end = start
    while end < ir.length && ir[end] != 10 { end = end + usize.ONE }
    let line = Slice.view<u8>(ir, start, end - start)
    if containsIr(line, b" = load i64, ptr ") {
      let mut nameLength = usize.ZERO
      while nameLength < line.length && line[nameLength] != 32 { nameLength = nameLength + usize.ONE }
      let name = Slice.view<u8>(ir, start, nameLength)
      let mut following = end + usize.ONE
      while following < ir.length {
        let mut next = following
        while next < ir.length && ir[next] != 10 { next = next + usize.ONE }
        let stored = Slice.view<u8>(ir, following, next - following)
        if containsIr(stored, b" = load i64, ptr ") { return false }
        if startsAt(stored, usize.ZERO, b"store i64 ") && startsAt(stored, 10, name)
          && stored.length > 10 + name.length && stored[10 + name.length] == 44 { return true }
        following = next + usize.ONE
      }
      return false
    }
    start = end + usize.ONE
  }
  return false
}

test effect fn runtimeSliceCountOperandsKeepProjectedDemandsAndRecipes() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run runtimeSliceCountClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn runtimeSliceCountClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("runtime-slice-count.silk")
  let key = run recipeControlKey(&id, b"descriptor", false)
  let target = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let mut mode = usize.ZERO
  while mode < 4 {
    let function = run runtimeSliceControl(&key, mode >= 2, usize.remainder(mode, 2) == usize.ONE, 2)
    let other = run runtimeSliceControl(&key, mode >= 2, usize.remainder(mode, 2) == usize.ONE, 3)
    let first = run InstanceRecipe.make(&function)
    let second = run InstanceRecipe.make(&other)
    run Testing.expect(!sameBytes(Bytes.asSlice(&first.shape), Bytes.asSlice(&second.shape)),
      "runtime count dependencies are part of the complete descriptor recipe")
    let demands = run mirLayoutDemands(&function)
    let needed = Vector.asSlice<LayoutDemand>(&demands)
    let mut complete = false
    if needed.length == 7 {
      complete = Shared.with<Type, bool>(&needed[5].ty, fn(value: &Type) -> bool {
        return match &value.* { Type.Pointer {..} => true _ => false }
      }) && Shared.with<Type, bool>(&needed[6].ty, fn(value: &Type) -> bool {
        return witnessPrimitive(value, b"usize")
      })
    }
    run Testing.expect(complete, "both Copy and Move data/count operands demand their distinct dereferenced referent layouts")
    let mut layouts = Vector.make<TypeLayout>()
    let mut at = usize.ZERO
    while at < needed.length {
      let ty = &needed[at].ty
      let mut layout = BackendLayout.scalar(ty, &target)
      let slice = Shared.with<Type, Option<Shared<Type>>>(ty, fn(value: &Type) -> Option<Shared<Type>> {
        return match &value.* { Type.Slice {element, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&element)) _ => Option.none<Shared<Type>>() }
      })
      if let Option<Shared<Type>>.Some {value: element} = move slice {
        layout = BackendLayout.slice(&element, LayoutMetrics {size: usize.ONE, alignment: usize.ONE, abi: LayoutAbi.Integer}, &target)
      }
      if let Option<BackendLayout>.Some {value} = move layout {
        run Vector.append<TypeLayout>(&mut layouts, TypeLayout {ty: Shared.clone<Type>(ty), layout: run Shared.make<BackendLayout>(move value)})
      }
      at = at + usize.ONE
    }
    let foreign = Vector.make<CAbi.Signature>()
    let llvm = run emitClosedMir(&function, &target, Vector.asSlice<TypeLayout>(&layouts), Vector.asSlice<CAbi.Signature>(&foreign))
    let ir = Bytes.asSlice(&llvm)
    run Testing.expect(containsIr(ir, b"load ptr, ptr") && containsIr(ir, b"load i64, ptr")
      && runtimeSliceStoresProjectedCount(ir) && containsIr(ir, b"ret i64 %"),
      "the count loaded through &usize is stored as runtime descriptor length and read back through SliceLength")
    mode = mode + usize.ONE
  }
  return ()
}

test effect fn runtimeTextLiteralsBecomePrivateConstantDescriptors() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("runtime-text-literals.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Note { message: string<'static> }
impl Copy for Note {}
fn note() -> Note { return Note { message: "hi\\t" } }
fn count(buffer: &[u8]) -> usize { return buffer.length }
fn pass(value: string<'static>) -> string<'static> { return value }
fn same(left: string<'static>, right: string<'static>) -> bool { return left == right }
fn different(left: string<'static>, right: string<'static>) -> bool { return left != right }
fn leftText() -> string<'static> { return "a" }
fn rightText() -> string<'static> { return "b" }
fn orderedText() -> bool { return leftText() == rightText() }
fn noTextOrder(left: string<'static>, right: string<'static>) -> bool { return left <= right }
fn noSliceEquality(left: &[u8], right: &[u8]) -> bool { return left == right }
pub fn main() -> i32 {
  let marks = "\\"\\\\\\0"
  let word = "olá"
  let none = b""
  let held = note()
  let kept = pass(held.message)
  let bytes = b"ab\\n"
  if count(bytes) == 3 && bytes[count(b"ab")] == 10 { return 0 }
  return 1
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let noteMir = run Semantic.demandMir(&mut store, &mut request, &id, b"note") |> Effect.provideMut<Allocator>(&mut allocator)
  let mainMir = run Semantic.demandMir(&mut store, &mut request, &id, b"main") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut textDescriptor = false
  let noteIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&noteMir, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move noteIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      textDescriptor = buildsStaticDescriptor(function, b"hi\t")
    }
  }
  let mut bytesDescriptor = false
  let mainIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mainMir, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move mainIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      bytesDescriptor = buildsStaticDescriptor(function, b"ab\n") && buildsStaticDescriptor(function, b"\"\\\0")
        && buildsStaticDescriptor(function, b"ol\xC3\xA1") && buildsStaticDescriptor(function, b"")
    }
  }
  run Testing.expect(textDescriptor && bytesDescriptor,
    "text and byte-string literals build descriptors over their exact decoded UTF-8 bytes and byte length")
  let sameMir = run Semantic.demandMir(&mut store, &mut request, &id, b"same") |> Effect.provideMut<Allocator>(&mut allocator)
  let differentMir = run Semantic.demandMir(&mut store, &mut request, &id, b"different") |> Effect.provideMut<Allocator>(&mut allocator)
  let orderedMir = run Semantic.demandMir(&mut store, &mut request, &id, b"orderedText") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(textComparisonAnswer(&store, &sameMir, &id, true, false)
      && textComparisonAnswer(&store, &differentMir, &id, false, false)
      && textComparisonAnswer(&store, &orderedMir, &id, true, true),
    "string comparisons retain ordered operands, equal lengths and a bounded shared byte index, with first-difference exits and complementary results")
  let nativeText = run textComparisonEmission(&store, &sameMir, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), b"i64")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmText = run textComparisonEmission(&store, &differentMir, MachineTarget.forId(TargetId.Wasm32UnknownUnknown), b"i32")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(nativeText && wasmText,
    "the same source-derived MIR uses target-word lengths and indexes with byte loads on 64-bit and 32-bit targets")
  let noOrder = run Semantic.demandBody(&mut store, &mut request, &id, b"noTextOrder") |> Effect.provideMut<Allocator>(&mut allocator)
  let noSlice = run Semantic.demandBody(&mut store, &mut request, &id, b"noSliceEquality") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&noOrder, RejectionCode.MissingOperator, text, "<=", usize.ZERO)
      && rejectsSpan(&noSlice, RejectionCode.MissingOperator, text, "==", 2),
    "string equality does not add text ordering or equality for a borrowed byte descriptor")
  let built = run Semantic.buildMain(&mut store, &mut request, &id, staticClosureNodes) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut emitted = false
  if let BackendBuild.Module {text: llvm, ..} = &built {
    let ir = Bytes.asSlice(&llvm)
    emitted = containsIr(ir, b".bytes.") && containsIr(ir, b" = private unnamed_addr constant [3 x i8] c\"hi\\09\"")
      && containsIr(ir, b" = private unnamed_addr constant [3 x i8] c\"ab\\0A\"")
      && containsIr(ir, b" = private unnamed_addr constant [3 x i8] c\"\\22\\5C\\00\"")
      && containsIr(ir, b" = private unnamed_addr constant [4 x i8] c\"ol\\C3\\A1\"")
      && containsIr(ir, b" = private unnamed_addr constant [0 x i8] c\"\"")
  }
  run Testing.expect(emitted, "literal bytes are private constants addressed by a two-word descriptor")
  return ()
}

// Dataflow evidence, found in the actual selected MIR rather than made from the lowering helper.
struct TextBinaryEvidence { block: usize statement: usize local: usize left: usize right: usize }

struct TextDescriptorEvidence { block: usize statement: usize source: usize }

struct TextBranchEvidence { yes: usize no: usize }

fn textOperandLocal(value: &MirOperand) -> usize {
  return match &value.* {
    MirOperand.Copy {place} => { if Vector.length<MirProjection>(&place.projections) == usize.ZERO { return place.local } return usize.MAX }
    MirOperand.Move {place} => { if Vector.length<MirProjection>(&place.projections) == usize.ZERO { return place.local } return usize.MAX }
    _ => usize.MAX
  }
}

// Only the authenticated assignments may define a value used by the proof.
fn textWritesAt(function: &MirFunction, local: usize, firstBlock: usize, firstAt: usize, secondBlock: usize, secondAt: usize) -> bool {
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut first = false
  let mut second = false
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Assign {destination, ..} = &statements[at] {
        if destination.local == local {
          if Vector.length<MirProjection>(&destination.projections) != usize.ZERO { return false }
          if block == firstBlock && at == firstAt { first = true }
          else if block == secondBlock && at == secondAt { second = true }
          else { return false }
        }
      }
      at = at + usize.ONE
    }
    if let MirTerminator.Call {destination, failure, ..} = &blocks[block].terminator {
      if destination.local == local { return false }
      if let Option<MirFailureEdge>.Some {value} = &failure {
        if value.destination.local == local { return false }
      }
    }
    block = block + usize.ONE
  }
  return first && (secondBlock == usize.MAX || second)
}

// An original parameter or authenticated call result has no replacement assignments.
fn textHasNoAssignments(function: &MirFunction, local: usize) -> bool {
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Assign {destination, ..} = &statements[at] {
        if destination.local == local { return false }
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  return true
}

fn textLocalType(function: &MirFunction, local: usize, name: &[u8]) -> bool {
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  return local < locals.length && Shared.with<Type, bool>(&locals[local].ty, fn(value: &Type) -> bool { return witnessPrimitive(value, name) })
}

fn textIndexConstant(value: &MirOperand, decimal: &[u8]) -> bool {
  return match &value.* { MirOperand.Integer {decimal: bytes, negative, ty} => !negative
    && sameBytes(Bytes.asSlice(&bytes), decimal) && Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool { return witnessPrimitive(value, b"usize") })
    _ => false }
}

fn textBinary(function: &MirFunction, operation: InfixOperator, primitive: &[u8]) -> Option<TextBinaryEvidence> {
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut found = Option.none<TextBinaryEvidence>()
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Binary {operation: selected, left, right}, ..} = &statements[at] {
        let first = textOperandLocal(&left)
        let second = textOperandLocal(&right)
        let mut rhs = textLocalType(function, second, primitive)
        if operation == InfixOperator.Add { rhs = textIndexConstant(&right, b"1") }
        if selected == operation && textLocalType(function, first, primitive) && rhs {
          if let Option<TextBinaryEvidence>.Some {..} = &found { return Option.none<TextBinaryEvidence>() }
          if Vector.length<MirProjection>(&destination.projections) != usize.ZERO { return Option.none<TextBinaryEvidence>() }
          found = Option.some<TextBinaryEvidence>(TextBinaryEvidence {block: block, statement: at, local: destination.local, left: first, right: second})
        }
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  return move found
}

fn textBranch(function: &MirFunction, binary: &TextBinaryEvidence) -> Option<TextBranchEvidence> {
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  if binary.block < blocks.length && textWritesAt(function, binary.local, binary.block, binary.statement, usize.MAX, usize.MAX) {
    if let MirTerminator.Branch {condition, thenBlock, elseBlock, ..} = &blocks[binary.block].terminator {
      if textOperandLocal(&condition) == binary.local && thenBlock < blocks.length && elseBlock < blocks.length && thenBlock != elseBlock {
        return Option.some<TextBranchEvidence>(TextBranchEvidence {yes: thenBlock, no: elseBlock})
      }
    }
  }
  return Option.none<TextBranchEvidence>()
}

fn textDescriptor(function: &MirFunction, local: usize, data: bool) -> Option<TextDescriptorEvidence> {
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut found = Option.none<TextDescriptorEvidence>()
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Assign {destination, value, ..} = &statements[at] {
        if destination.local == local {
          if let Option<TextDescriptorEvidence>.Some {..} = &found { return Option.none<TextDescriptorEvidence>() }
          let mut source = usize.MAX
          match &value {
            MirRvalue.SliceLength {place} => { if !data && Vector.length<MirProjection>(&place.projections) == usize.ZERO { source = place.local } }
            MirRvalue.SliceData {place} => { if data && Vector.length<MirProjection>(&place.projections) == usize.ZERO { source = place.local } }
            _ => ()
          }
          if source == usize.MAX || Vector.length<MirProjection>(&destination.projections) != usize.ZERO { return Option.none<TextDescriptorEvidence>() }
          found = Option.some<TextDescriptorEvidence>(TextDescriptorEvidence {block: block, statement: at, source: source})
        }
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  if let Option<TextDescriptorEvidence>.Some {value} = &found {
    if !textWritesAt(function, local, value.block, value.statement, usize.MAX, usize.MAX) { return Option.none<TextDescriptorEvidence>() }
  }
  return move found
}

// A descriptor snapshot must trace through unique whole-value assignments to its actual source.
fn textCopiesFrom(function: &MirFunction, local: usize, root: usize) -> bool {
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut current = local
  let mut steps = Vector.length<MirLocal>(&function.locals)
  while steps > usize.ZERO {
    if current == root { return true }
    let mut source = usize.MAX
    let mut writtenBlock = usize.MAX
    let mut writtenAt = usize.MAX
    let mut block = usize.ZERO
    while block < blocks.length {
      let statements = Vector.asSlice<MirStatement>(&blocks[block].statements)
      let mut at = usize.ZERO
      while at < statements.length {
        if let MirStatement.Assign {destination, value, ..} = &statements[at] {
          if destination.local == current {
            if source != usize.MAX || Vector.length<MirProjection>(&destination.projections) != usize.ZERO { return false }
            source = match &value { MirRvalue.Use {value: operand} => textOperandLocal(&operand) _ => usize.MAX }
            writtenBlock = block
            writtenAt = at
            if source == usize.MAX { return false }
          }
        }
        at = at + usize.ONE
      }
      block = block + usize.ONE
    }
    if source == usize.MAX || !textWritesAt(function, current, writtenBlock, writtenAt, usize.MAX, usize.MAX) { return false }
    current = source
    steps = steps - usize.ONE
  }
  return false
}

// Both loads must use a pointer advanced by the same bounded induction local from the correct descriptor.
fn textByteSource(function: &MirFunction, byte: usize, index: usize, reading: usize, compared: usize) -> Option<TextDescriptorEvidence> {
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  if reading >= blocks.length { return Option.none<TextDescriptorEvidence>() }
  let statements = Vector.asSlice<MirStatement>(&blocks[reading].statements)
  let mut pointer = usize.MAX
  let mut loaded = usize.MAX
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Assign {destination, value: MirRvalue.Use {value: MirOperand.Copy {place}}, ..} = &statements[at] {
      if destination.local == byte {
        let projections = Vector.asSlice<MirProjection>(&place.projections)
        if pointer != usize.MAX || at >= compared || projections.length != usize.ONE || !mirProjectionIsDeref(&projections[usize.ZERO]) { return Option.none<TextDescriptorEvidence>() }
        pointer = place.local
        loaded = at
      }
    }
    at = at + usize.ONE
  }
  if pointer == usize.MAX || !textWritesAt(function, byte, reading, loaded, usize.MAX, usize.MAX) { return Option.none<TextDescriptorEvidence>() }
  at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Assign {destination, value: MirRvalue.PointerOffset {pointer: base, index: selected, element}, ..} = &statements[at] {
      if destination.local == pointer && at < loaded && Vector.length<MirProjection>(&destination.projections) == usize.ZERO
        && textOperandLocal(&selected) == index && textWritesAt(function, pointer, reading, at, usize.MAX, usize.MAX)
        && Shared.with<Type, bool>(&element, fn(value: &Type) -> bool { return witnessPrimitive(value, b"u8") }) {
        return textDescriptor(function, textOperandLocal(&base), true)
      }
    }
    at = at + usize.ONE
  }
  return Option.none<TextDescriptorEvidence>()
}

fn textGoto(function: &MirFunction, from: usize, to: usize) -> bool {
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  return from < blocks.length && match &blocks[from].terminator { MirTerminator.Goto {target, ..} => target == to _ => false }
}

fn textUnprojectedOperand(value: &MirOperand) -> bool {
  return match &value.* {
    MirOperand.Copy {place} => Vector.length<MirProjection>(&place.projections) == usize.ZERO
    MirOperand.Move {place} => Vector.length<MirProjection>(&place.projections) == usize.ZERO
    _ => true
  }
}

// Extra byte reads anywhere outside the proven bounded body would invalidate the safety claim.
fn textOnlyBoundedBytes(function: &MirFunction, reading: usize, left: usize, right: usize) -> bool {
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Assign {destination, value, ..} = &statements[at] {
        match &value {
          MirRvalue.Use {value: operand} => {
            if !textUnprojectedOperand(&operand) && (block != reading || (destination.local != left && destination.local != right)) { return false }
          }
          MirRvalue.Binary {left: first, right: second, ..} => {
            if !textUnprojectedOperand(&first) || !textUnprojectedOperand(&second) { return false }
          }
          MirRvalue.SliceLength {place} => { if Vector.length<MirProjection>(&place.projections) != usize.ZERO { return false } }
          MirRvalue.SliceData {place} => { if Vector.length<MirProjection>(&place.projections) != usize.ZERO { return false } }
          MirRvalue.PointerOffset {pointer, index, ..} => {
            if !textUnprojectedOperand(&pointer) || !textUnprojectedOperand(&index) { return false }
          }
          _ => { return false }
        }
      } else { return false }
      at = at + usize.ONE
    }
    if let MirTerminator.Call {arguments, providers, ..} = &blocks[block].terminator {
      let args = Vector.asSlice<MirOperand>(&arguments)
      let supplied = Vector.asSlice<MirOperand>(&providers)
      at = usize.ZERO
      while at < args.length {
        if !textUnprojectedOperand(&args[at]) { return false }
        at = at + usize.ONE
      }
      at = usize.ZERO
      while at < supplied.length {
        if !textUnprojectedOperand(&supplied[at]) { return false }
        at = at + usize.ONE
      }
    }
    if let MirTerminator.Branch {condition, ..} = &blocks[block].terminator {
      if !textUnprojectedOperand(&condition) { return false }
    }
    if let MirTerminator.Switch {value, ..} = &blocks[block].terminator {
      if !textUnprojectedOperand(&value) { return false }
    }
    block = block + usize.ONE
  }
  return true
}

fn textDefinitionBlock(function: &MirFunction, local: usize) -> usize {
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut found = usize.MAX
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Assign {destination, ..} = &statements[at] {
        if destination.local == local {
          if found != usize.MAX { return usize.MAX }
          found = block
        }
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  return found
}

fn textComparisonFlow(function: &MirFunction, equal: bool, left: usize, right: usize, leftEntry: usize, entry: usize) -> bool {
  let lengths = match move textBinary(function, InfixOperator.Equals, b"usize") { Option<TextBinaryEvidence>.Some {value} => move value _ => { return false } }
  let bound = match move textBinary(function, InfixOperator.LessThan, b"usize") { Option<TextBinaryEvidence>.Some {value} => move value _ => { return false } }
  let bytes = match move textBinary(function, InfixOperator.Equals, b"u8") { Option<TextBinaryEvidence>.Some {value} => move value _ => { return false } }
  let advance = match move textBinary(function, InfixOperator.Add, b"usize") { Option<TextBinaryEvidence>.Some {value} => move value _ => { return false } }
  let lengthEdges = match move textBranch(function, &lengths) { Option<TextBranchEvidence>.Some {value} => move value _ => { return false } }
  let boundEdges = match move textBranch(function, &bound) { Option<TextBranchEvidence>.Some {value} => move value _ => { return false } }
  let byteEdges = match move textBranch(function, &bytes) { Option<TextBranchEvidence>.Some {value} => move value _ => { return false } }
  let leftLength = match move textDescriptor(function, lengths.left, false) { Option<TextDescriptorEvidence>.Some {value} => move value _ => { return false } }
  let rightLength = match move textDescriptor(function, lengths.right, false) { Option<TextDescriptorEvidence>.Some {value} => move value _ => { return false } }
  let leftByte = match move textByteSource(function, bytes.left, bound.left, bytes.block, bytes.statement) { Option<TextDescriptorEvidence>.Some {value} => move value _ => { return false } }
  let rightByte = match move textByteSource(function, bytes.right, bound.left, bytes.block, bytes.statement) { Option<TextDescriptorEvidence>.Some {value} => move value _ => { return false } }
  if !textCopiesFrom(function, leftLength.source, left) || !textCopiesFrom(function, rightLength.source, right)
    || leftLength.source != leftByte.source || rightLength.source != rightByte.source || left == right
    || textDefinitionBlock(function, leftLength.source) != leftEntry || textDefinitionBlock(function, rightLength.source) != entry { return false }
  if lengths.block != entry || leftLength.block != lengths.block || rightLength.block != lengths.block
    || leftLength.statement >= lengths.statement || rightLength.statement >= lengths.statement || bound.right != lengths.left
    || lengthEdges.yes != leftByte.block || leftByte.block != rightByte.block || !textGoto(function, leftByte.block, bound.block)
    || boundEdges.yes != bytes.block || byteEdges.no != lengthEdges.no || byteEdges.yes != advance.block
    || advance.local != bound.left || advance.left != bound.left || !textGoto(function, advance.block, bound.block) { return false }
  let matched = match move textResult(function, boundEdges.no, equal) { Option<TextResultEvidence>.Some {value} => move value _ => { return false } }
  let unmatched = match move textResult(function, lengthEdges.no, !equal) { Option<TextResultEvidence>.Some {value} => move value _ => { return false } }
  if matched.local != unmatched.local || matched.join != unmatched.join || !textCopiesFrom(function, usize.ZERO, matched.local)
    || !textWritesAt(function, matched.local, boundEdges.no, usize.ZERO, lengthEdges.no, usize.ZERO)
    || !textOnlyBoundedBytes(function, bytes.block, bytes.left, bytes.right) { return false }
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut initialized = false
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Assign {destination, value, ..} = &statements[at] {
        if destination.local == bound.left {
          if Vector.length<MirProjection>(&destination.projections) != usize.ZERO { return false }
          match &value {
            MirRvalue.Use {value: initial} => {
              if initialized || block != lengths.block || !textIndexConstant(&initial, b"0") { return false }
              initialized = true
            }
            MirRvalue.Binary {operation, left: previous, right: increment} => {
              if block != advance.block || operation != InfixOperator.Add || textOperandLocal(&previous) != bound.left || !textIndexConstant(&increment, b"1") { return false }
            }
            _ => { return false }
          }
        }
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  return initialized && matched.join < blocks.length && match &blocks[matched.join].terminator { MirTerminator.Return {..} => true _ => false }
}

fn textComparisonAnswer(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, id: &ModuleId, equal: bool, calls: bool) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut left = usize.MAX
      let mut right = usize.MAX
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut first = usize.MAX
      let mut second = usize.MAX
      let mut entry = usize.ZERO
      let mut at = usize.ZERO
      if calls {
        while at < blocks.length {
          if let MirTerminator.Call {callee, destination, normal, failure, diagnostics, ..} = &blocks[at].terminator {
            let key = match &callee { MirCallee.Instance {key} => &key _ => { return false } }
            if Vector.length<MirProjection>(&destination.projections) != usize.ZERO { return false }
            if let Option<MirDiagnostics>.Some {..} = &diagnostics { return false }
            if let Option<MirFailureEdge>.Some {..} = &failure { return false }
            let identity = InstanceKey.identity(&key)
            let side = Shared.with<DeclarationId, usize>(&identity, fn(value: &DeclarationId) -> usize {
              if !ModuleId.equals(DeclarationId.moduleId(value), id) { return usize.MAX }
              if DeclarationId.named(value, b"leftText") { return usize.ZERO }
              if DeclarationId.named(value, b"rightText") { return usize.ONE }
              return usize.MAX
            })
            if side == usize.ZERO && left == usize.MAX && at == usize.ZERO {
              left = destination.local
              first = normal
            } else if side == usize.ONE && right == usize.MAX {
              right = destination.local
              second = at
              entry = normal
            }
            else { return false }
          }
          at = at + usize.ONE
        }
        if first != second { return false }
      } else {
        let mut block = usize.ZERO
        while block < blocks.length {
          if let MirTerminator.Call {..} = &blocks[block].terminator { return false }
          block = block + usize.ONE
        }
        while at < locals.length {
          if let MirLocalKind.Parameter {index: parameter} = &locals[at].kind {
            if parameter == usize.ZERO { left = at }
            if parameter == usize.ONE { right = at }
          }
          at = at + usize.ONE
        }
      }
      let mut leftEntry = usize.ZERO
      if calls { leftEntry = first }
      return left != usize.MAX && right != usize.MAX
        && textHasNoAssignments(function, left) && textHasNoAssignments(function, right)
        && textComparisonFlow(function, equal, left, right, leftEntry, entry)
    }
  }
  return false
}

effect fn textComparisonEmission(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, target: MachineTarget, expectedWord: &[u8]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut layouts = Vector.make<TypeLayout>()
      let mut at = usize.ZERO
      while at < locals.length {
        let mut shape = BackendLayout.scalar(&locals[at].ty, &target)
        if Shared.with<Type, bool>(&locals[at].ty, fn(value: &Type) -> bool { return match &value.* { Type.String {..} => true _ => false } }) {
          shape = run BackendLayout.text(&target)
        }
        if let Option<BackendLayout>.Some {value} = move shape {
          run Vector.append<TypeLayout>(&mut layouts, TypeLayout {ty: Shared.clone<Type>(&locals[at].ty), layout: run Shared.make<BackendLayout>(move value)})
        } else { return false }
        at = at + usize.ONE
      }
      let foreign = Vector.make<CAbi.Signature>()
      let emitted = run Effect.result(emitClosedMir(function, &target, Vector.asSlice<TypeLayout>(&layouts), Vector.asSlice<CAbi.Signature>(&foreign)))
      if let Result<Bytes, BackendGap | OutOfMemoryError>.Success {value} = move emitted {
        let ir = Bytes.asSlice(&value)
        let mut words = false
        if sameBytes(expectedWord, b"i64") { words = containsIr(ir, b" = load i64,") && containsIr(ir, b" = icmp ult i64 ") }
        if sameBytes(expectedWord, b"i32") { words = containsIr(ir, b" = load i32,") && containsIr(ir, b" = icmp ult i32 ") }
        return words && containsIr(ir, b" = load i8,") && containsIr(ir, b" = icmp eq i8 ") && containsIr(ir, b"br i1 ")
          && !containsIr(ir, b"@memcmp") && !containsIr(ir, b"@strcmp")
      }
    }
  }
  return false
}

// B12 slice 1: exact MIR keys and completed emitted identities are proven structurally here.
// Runtime behavior stays in the shared native corpus.
test effect fn genericCallersShareOneClosedMirKey() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | BackendGap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("b12-shared-instance.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
fn identity<T>(value: T) -> T { return move value }
fn first() -> i32 { return identity<i32>(20) }
fn second() -> i32 { return identity<i32>(22) }
pub fn main() -> i32 { return first() + second() }
"""
  let mut store = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let first = run Semantic.demandMir(&mut store, &mut request, &id, b"first") |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Semantic.demandMir(&mut store, &mut request, &id, b"second") |> Effect.provideMut<Allocator>(&mut allocator)
  let firstIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&first, selectedMirIndex)
  let secondIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&second, selectedMirIndex)
  let firstKey = mirSingleReference(&store, move firstIndex)
  let secondKey = mirSingleReference(&store, move secondIndex)
  let mut shared = false
  if let Option<InstanceKey>.Some {value: firstInstance} = move firstKey {
    if let Option<InstanceKey>.Some {value: secondInstance} = move secondKey {
      shared = run InstanceKey.sameApplication(&firstInstance, &secondInstance) |> Effect.provideMut<Allocator>(&mut allocator)
      let selected = run InstanceKey.selected(&firstInstance) |> Effect.provideMut<Allocator>(&mut allocator)
      let arguments = Vector.asSlice<Argument>(&selected.arguments)
      shared = shared && arguments.length == usize.ONE
      if arguments.length == usize.ONE {
        shared = shared && match & arguments[usize.ZERO] {
          Argument.Type {value: ty} => Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool { return b12IntegerType(value) })
          _ => false
        }
      }
      let built = run Semantic.buildMain(&mut store, &mut request, &id, staticClosureNodes)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let mut emittedOnce = false
      if let BackendBuild.Module {text: ir, plan, ..} = &built {
        let firstSymbol = run EmissionPlan.symbol(&plan, &firstInstance) |> Effect.provideMut<Allocator>(&mut allocator)
        let secondSymbol = run EmissionPlan.symbol(&plan, &secondInstance) |> Effect.provideMut<Allocator>(&mut allocator)
        let firstIdentity = run recipeIdentityAt(&plan, &firstInstance) |> Effect.provideMut<Allocator>(&mut allocator)
        let secondIdentity = run recipeIdentityAt(&plan, &secondInstance) |> Effect.provideMut<Allocator>(&mut allocator)
        emittedOnce = firstIdentity == secondIdentity && sameBytes(Bytes.asSlice(&firstSymbol), Bytes.asSlice(&secondSymbol))
          && genericUniqueSymbolDefinition(Bytes.asSlice(&ir), Bytes.asSlice(&firstSymbol))
      }
      shared = shared && emittedOnce
    }
  }
  run Testing.expect(shared, "two callers retain one exact identity<i32> key, interned selected identity and emitted definition")
  return ()
}

fn mirSingleReference(store: &Semantic, index: Option<usize>) -> Option<InstanceKey> {
  if let Option<usize>.Some {value: at} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, at) {
      let references = Vector.asSlice<MirReference>(&function.references)
      if references.length == usize.ONE {
        return match &references[usize.ZERO].edge {
          SpecializationEdge.Direct => Option.some<InstanceKey>(InstanceKey.copy(&references[usize.ZERO].key),
          )
          _ => Option.none<InstanceKey>() }
      }
    }
  }
  return Option.none<InstanceKey>()
}

test effect fn witnessMirSharesDirectTargetWithoutBodyDemand() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run witnessMirSharingClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn witnessMirSharingClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("b12-witness-mir.silk")
  let source = """
interface Make<A, B> { fn make(value: Self, left: A, right: B) -> B }
struct Maker {}
fn target<Y, X>(value: Maker, left: X, right: Y) -> Y { return missing }
impl<A, B> Make<A, B> for Maker { make: target }
fn direct() -> i32 { return target<i32, bool>(Maker {}, true, 42) }
fn witnessed() -> i32 { return Make<bool, i32>.make(Maker {}, true, 42) }
"""
  let mut store = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let direct = run Semantic.demandMir(&mut store, &mut request, &id, b"direct")
  let witnessed = run Semantic.demandMir(&mut store, &mut request, &id, b"witnessed")
  let directKey = mirSingleReference(&store, Shared.with<Result<Answer, NoRejection>, Option<usize>>(&direct, selectedMirIndex))
  let witnessedKey = mirWitnessReference(&store, Shared.with<Result<Answer, NoRejection>, Option<usize>>(&witnessed, selectedMirIndex))
  let mut same = false
  if let Option<InstanceKey>.Some {value: left} = move directKey {
    if let Option<InstanceKey>.Some {value: right} = move witnessedKey {
      let first = run InstanceKey.runtimeName(&left)
      let second = run InstanceKey.runtimeName(&right)
      let application = run InstanceKey.selected(&right)
      let arguments = Vector.asSlice<Argument>(&application.arguments)
      same = InstanceKey.sameRuntimeBase(&left, &right) && sameBytes(Bytes.asSlice(&first), Bytes.asSlice(&second))
        && DeclarationId.named(SpecializationApplication.bodyDeclaration(&application), b"target")
        && arguments.length == 2 && Vector.length<ScopeBinding>(&application.scopes) == usize.ZERO
      if arguments.length == 2 {
        if let Argument.Type {value: firstType} = &arguments[usize.ZERO] {
          if let Argument.Type {value: secondType} = &arguments[usize.ONE] {
            same = same && Shared.with<Type, bool>(&firstType, b12IntegerType)
              && Shared.with<Type, bool>(&secondType, isBool)
          } else { same = false }
        } else { same = false }
      }
    }
  }
  run Testing.expect(same, "production witness MIR retains reversed target binder order and shares the direct erased family key and name without reading the target body")
  let bodies = starts(Semantic.eventLog(&store), Family.Body)
  let witnesses = starts(Semantic.eventLog(&store), Family.Witnesses)
  let mut warm = Request.make()
  let retained = run Semantic.demandMir(&mut store, &mut warm, &id, b"witnessed")
  run Testing.expect(succeeded(&retained) && bodies == 2 && witnesses > usize.ZERO
    && starts(Semantic.eventLog(&store), Family.Body) == bodies
    && starts(Semantic.eventLog(&store), Family.Witnesses) == witnesses
    && Request.hasDemand(&warm, Family.Witnesses, &id)
    && Request.hasDemand(&warm, Family.ConformanceHeads, &id),
    "cached witness MIR retains proof dependencies without demanding the deliberately invalid target body")
  return ()
}

fn mirWitnessReference(store: &Semantic, index: Option<usize>) -> Option<InstanceKey> {
  if let Option<usize>.Some {value: at} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, at) {
      let references = Vector.asSlice<MirReference>(&function.references)
      if references.length == usize.ONE {
        return match &references[usize.ZERO].edge {
          SpecializationEdge.Witness => Option.some<InstanceKey>(InstanceKey.copy(&references[usize.ZERO].key),
          )
          _ => Option.none<InstanceKey>() }
      }
    }
  }
  return Option.none<InstanceKey>()
}

test effect fn witnessMirClosesCapturedScopeThroughNestedCallers() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run witnessMirCapturedScopeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn witnessMirCapturedScopeClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("b12-captured-scope-mir.silk")
  let source = """
interface Make<T> { fn make(value: &Self, item: T) -> Box<T> }
struct Maker {}
struct Box<T> { value: T }
impl<T> Make<T> for Maker {
  fn make(value: &Self, item: T) -> Box<T> {
    let retained: T = move item
    return Box<T> { value: move retained }
  }
}
fn through<P: Make<i32>>(maker: &P, item: i32) -> Box<i32> { return Make<i32>.make(maker, item) }
fn relay<P: Make<i32>>(maker: &P, item: i32) -> Box<i32> { return through(maker, item) }
pub fn main() -> i32 {
  let maker = Maker {}
  let result = relay(&maker, 42)
  return result.value
}
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let implOwner = run requireIndexedIdentity(&mut index, &id, OwnerKind.Implementation, b"", usize.ZERO)
  let mut store = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let mut request = Request.make()
  let checked = run Semantic.demandBody(&mut store, &mut request, &id, b"through")
  let inputs = Shared.with<Result<Answer, NoRejection>, Option<WitnessCallInputs>>(&checked, witnessCallInputs)
  let retainedBound = match &inputs {
    Option<WitnessCallInputs>.Some {value} => !value.selected
    _ => false
  }
  run Testing.expect(succeeded(&checked) && retainedBound && starts(Semantic.eventLog(&store), Family.Body) == usize.ONE,
    "applied interface qualifier preserves the full declared bound without selecting a target body")
  let built = run Semantic.buildMain(&mut store, &mut request, &id, staticClosureNodes)
  let emitted = match &built { BackendBuild.Module {..} => true _ => false }
  let mut closed = true
  let mut captured = false
  let mut regions = false
  let mut at = usize.ZERO
  while true {
    let selected = Semantic.mirAt(&store, at)
    let function = match move selected { Option<&MirFunction>.Some {value} => value _ => { break } }
    closed = closed && !Type.hasOpenRuntimeParameters(&function.result)
    let locals = Vector.asSlice<MirLocal>(&function.locals)
    let mut localAt = usize.ZERO
    while localAt < locals.length {
      closed = closed && !Type.hasOpenRuntimeParameters(&locals[localAt].ty)
      localAt = localAt + usize.ONE
    }
    let key = mirWitnessReference(&store, Option.some<usize>(at))
    if let Option<InstanceKey>.Some {value} = move key {
      let parameters = Vector.asSlice<Shared<Type>>(&function.parameters)
      let mut callerRegion = Option.none<Shared<Lifetime>>()
      if parameters.length > usize.ZERO { callerRegion = Shared.with<Type, Option<Shared<Lifetime>>>(&parameters[usize.ZERO], witnessMirReferenceRegion) }
      let application = run InstanceKey.selected(&value)
      let own = Vector.asSlice<Argument>(&application.arguments)
      let ownSlots = Vector.asSlice<usize>(&application.argumentOrdinals)
      if own.length == usize.ONE && ownSlots.length == usize.ONE && ownSlots[usize.ZERO] == usize.ZERO {
        if let Argument.Lifetime {value: actual} = &own[usize.ZERO] {
          if let Option<Shared<Lifetime>>.Some {value: expected} = move callerRegion {
            regions = Lifetime.equalsShared(&actual, &expected) && Shared.with<Lifetime, bool>(&actual, witnessMirCallerRegion)
          }
        }
      }
      let scopes = Vector.asSlice<ScopeBinding>(&application.scopes)
      if scopes.length == usize.ONE {
        let arguments = Vector.asSlice<Argument>(&scopes[usize.ZERO].arguments)
        let slots = Vector.asSlice<usize>(&scopes[usize.ZERO].argumentOrdinals)
        captured = Shared.with<DeclarationId, bool>(&scopes[usize.ZERO].owner, fn(value: &DeclarationId) -> bool { return DeclarationId.equals(value, &implOwner) })
          && arguments.length == usize.ONE && slots.length == usize.ONE && slots[usize.ZERO] == usize.ZERO
        if arguments.length == usize.ONE {
          captured = captured && match &arguments[usize.ZERO] {
            Argument.Type {value: ty} => Shared.with<Type, bool>(&ty, b12IntegerType)
            _ => false
          }
        }
      }
    }
    at = at + usize.ONE
  }
  run Testing.expect(emitted && closed && captured && regions,
    "nested witness specialization closes the actual impl-owned binder through body locals, node types and aggregate layouts")
  return ()
}

fn witnessMirReferenceRegion(value: &Type) -> Option<Shared<Lifetime>> {
  return match &value.* {
    Type.Reference {lifetime, ..} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
    _ => Option.none<Shared<Lifetime>>()
  }
}

// Main's loan reaches each nested instance as its first canonical caller region.
fn witnessMirCallerRegion(value: &Lifetime) -> bool {
  return match &value.* {
    Lifetime.Supplied {ordinal} => ordinal == usize.ZERO
    _ => false
  }
}

test effect fn witnessMirValidatesLifetimeDistinctRuntimeEqualApplications() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run witnessMirSemanticCacheClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn witnessMirSemanticCacheClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("b12-semantic-cache.silk")
  let source = """
interface Regional<'a> { fn read(value: Self) -> i32 }
struct Maker {}
impl Regional<'static> for Maker { fn read(value: Self) -> i32 { return missing } }
fn through<'a, P: Regional<'a>>(maker: P) -> i32 { return Regional<'a>.read(move maker) }
fn site(value: &i32) -> i32 { return 0 }
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let caller = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"through", usize.ZERO)
  let site = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"site", usize.ZERO)
  let maker = run requireIndexedIdentity(&mut index, &id, OwnerKind.Struct, b"Maker", usize.ZERO)
  let provider = run Shared.make<Type>(Type.Nominal {declaration: move maker, isPublic: false, arguments: Vector.make<Argument>()})
  let mut firstArguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut firstArguments, Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Static)})
  run Vector.append<Argument>(&mut firstArguments, Argument.Type {value: Shared.clone<Type>(&provider)})
  let first = run specializationWithArguments(&caller, move firstArguments)
  let mut secondArguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut secondArguments, Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Parameter {
    declaration: move site, ordinal: usize.ZERO,
  })})
  run Vector.append<Argument>(&mut secondArguments, Argument.Type {value: move provider})
  let second = run specializationWithArguments(&caller, move secondArguments)
  let firstKey = run requiredCanonicalKey(run InstanceKey.function(run SpecializationApplication.copy(&first)))
  let secondKey = run requiredCanonicalKey(run InstanceKey.function(run SpecializationApplication.copy(&second)))
  run Testing.expect(InstanceKey.sameRuntimeBase(&firstKey, &secondKey) && !run SpecializationApplication.equals(&first, &second),
    "actual source-owned lifetime environments differ while their provisional erased runtime family is shared")
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let successful = run Semantic.demandApplicationMir(&mut store, &mut request, &first)
  let firstIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&successful, selectedMirIndex)
  let hasMir = match &firstIndex { Option<usize>.Some {..} => true _ => false }
  let mut secondRequest = Request.make()
  let rejected = run Semantic.demandApplicationMir(&mut store, &mut secondRequest, &second)
  let start = offsetOf(source, "Regional<'a>.read(move maker)", 0)
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&rejected, rejection)
  let rejectedAtCall = match move diagnostic {
    Option<Shared<Rejection>>.Some {value} => Shared.with<Rejection, bool>(&value,
      fn(value: &Rejection) -> bool {
        return value.code == RejectionCode.MissingConformance && ModuleId.equals(&value.module, &id)
          && value.span.start == start && value.span.end == start + 29
      })
    _ => false
  }
  run Testing.expect(hasMir && rejectedAtCall && starts(Semantic.eventLog(&store), Family.Mir) == 2
    && starts(Semantic.eventLog(&store), Family.Body) == usize.ONE
    && Request.hasDemand(&request, Family.Witnesses, &id)
    && Request.hasDemand(&secondRequest, Family.ConformanceHeads, &id),
    "a second lifetime-distinct semantic query rejects its actual proof before runtime reuse and never reads the invalid witness body")
  return ()
}

test effect fn witnessMirLendsFreshOperandsInWrittenOrder() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run witnessMirLendingClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn witnessMirLendingClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("b12-witness-lending.silk")
  let source = """
interface Read { fn read(value: Self, left: i32, right: i32) -> i32 }
struct Maker {}
impl Read for Maker { fn read(value: &Self, left: &i32, right: &mut i32) -> i32 { return missing } }
fn first() -> i32 { return missing }
fn second() -> i32 { return missing }
fn caller() -> i32 { return Read.read(Maker {}, first(), second()) }
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut sourceIndex = SourceIndex.make(run Revision.copy(&revision))
  let caller = run requireIndexedIdentity(&mut sourceIndex, &id, OwnerKind.Function, b"caller", usize.ZERO)
  let mut store = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let mut request = Request.make()
  let checked = run Semantic.demandBody(&mut store, &mut request, &id, b"caller")
  let mut written = Vector.make<BodyCallArgument>()
  let checkedTypedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&checked, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedTypedBody {
    let lendingCallNode = Shared.with<TypedBody, Option<BodyNodeId>>(&body, witnessMirLendingNode)
    if let Option<BodyNodeId>.Some {value: node} = move lendingCallNode {
      let mut at = usize.ZERO
      while at < 3 {
        if let Option<BodyCallArgument>.Some {value} = move TypedBody.callArgument(&body, node, at) {
          run Vector.append<BodyCallArgument>(&mut written, move value)
        }
        at = at + usize.ONE
      }
    }
  }
  let expectedArguments = Vector.asSlice<BodyCallArgument>(&written)
  let mut writtenSites = expectedArguments.length == 3
  if writtenSites {
    let makerStart = offsetOf(source, "Read.read(Maker {}, first(), second())", 0) + 10
    let firstStart = offsetOf(source, "first()", 1)
    let secondStart = offsetOf(source, "second()", 1)
    writtenSites = expectedArguments[usize.ZERO].origin.span.start == makerStart
      && expectedArguments[usize.ZERO].origin.span.end == makerStart + 8
      && expectedArguments[usize.ONE].origin.span.start == firstStart
      && expectedArguments[usize.ONE].origin.span.end == firstStart + 7
      && expectedArguments[2].origin.span.start == secondStart
      && expectedArguments[2].origin.span.end == secondStart + 8
  }
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"caller")
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&answer, selectedMirIndex)
  let mut order = false
  let mut operands = false
  let mut loanTypes = Vector.make<Shared<Type>>()
  let mut selected = Option.none<InstanceKey>()
  if let Option<usize>.Some {value: at} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, at) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut maker = usize.MAX
      let mut makerCount = usize.ZERO
      if writtenSites {
        let mut blockAt = usize.ZERO
        while blockAt < blocks.length {
          let statements = Vector.asSlice<MirStatement>(&blocks[blockAt].statements)
          let mut statementAt = usize.ZERO
          while statementAt < statements.length {
            if let MirStatement.Assign {destination, value: MirRvalue.Aggregate {fields}, origin} = &statements[statementAt] {
              if origin.syntax.index == expectedArguments[usize.ZERO].origin.syntax.index {
                makerCount = makerCount + usize.ONE
                maker = destination.local
                writtenSites = writtenSites && Vector.length<MirAggregateField>(&fields) == usize.ZERO
                  && Vector.length<MirProjection>(&destination.projections) == usize.ZERO
                  && maker < locals.length
                if maker < locals.length { writtenSites = writtenSites && run Type.equalsShared(&locals[maker].ty, &expectedArguments[usize.ZERO].ty) }
              }
            }
            statementAt = statementAt + usize.ONE
          }
          blockAt = blockAt + usize.ONE
        }
      }
      let mut first = usize.MAX
      let mut second = usize.MAX
      let mut firstBlock = usize.MAX
      let mut firstNormal = usize.MAX
      let mut secondNormal = usize.MAX
      let mut witness = false
      let mut unique = true
      let mut blockAt = usize.ZERO
      while blockAt < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, destination, normal, origin, ..} = &blocks[blockAt].terminator {
          let identity = InstanceKey.identity(&key)
          if Shared.with<DeclarationId, bool>(&identity, witnessMirFirst) {
            unique = unique && first == usize.MAX && second == usize.MAX && !witness
              && Vector.length<MirProjection>(&destination.projections) == usize.ZERO
            first = destination.local
            firstBlock = blockAt
            firstNormal = normal
            if writtenSites { unique = unique && origin.syntax.index == expectedArguments[usize.ONE].origin.syntax.index }
          } else if Shared.with<DeclarationId, bool>(&identity, witnessMirSecond) {
            unique = unique && first != usize.MAX && second == usize.MAX && !witness && blockAt == firstNormal
              && Vector.length<MirProjection>(&destination.projections) == usize.ZERO
            second = destination.local
            secondNormal = normal
            if writtenSites { unique = unique && origin.syntax.index == expectedArguments[2].origin.syntax.index }
          } else if Shared.with<DeclarationId, bool>(&identity, witnessMirRead) {
            unique = unique && first != usize.MAX && second != usize.MAX && !witness && blockAt == secondNormal
            witness = true
            selected = Option.some<InstanceKey>(InstanceKey.copy(&key))
            let values = Vector.asSlice<MirOperand>(&arguments)
            operands = writtenSites && makerCount == usize.ONE && values.length == 3
              && maker != first && maker != second && first != second
            let mut captures = Vector.make<usize>()
            let mut references = Vector.make<usize>()
            let mut at = usize.ZERO
            while operands && at < values.length {
              if let MirOperand.Copy {place} = &values[at] {
                let mut producer = maker
                let mut definitionBlock = firstBlock
                if at == usize.ONE {
                  producer = first
                  definitionBlock = firstNormal
                }
                if at == 2 {
                  producer = second
                  definitionBlock = secondNormal
                }
                let captured = run witnessMirLentCapture(function, place.local, producer, definitionBlock,
                  &expectedArguments[at], &caller, witnessMirLentAccess(at))
                if let Option<usize>.Some {value} = move captured {
                  operands = Vector.length<MirProjection>(&place.projections) == usize.ZERO
                    && value != maker && value != first && value != second
                  let previous = Vector.asSlice<usize>(&captures)
                  let previousReferences = Vector.asSlice<usize>(&references)
                  let mut prior = usize.ZERO
                  while prior < previous.length {
                    operands = operands && previous[prior] != value && previousReferences[prior] != place.local
                    prior = prior + usize.ONE
                  }
                  run Vector.append<usize>(&mut captures, value)
                  run Vector.append<usize>(&mut references, place.local)
                  run Vector.append<Shared<Type>>(&mut loanTypes, Shared.clone<Type>(&locals[place.local].ty))
                } else { operands = false }
              } else { operands = false }
              at = at + usize.ONE
            }
          } else { unique = false }
        }
        blockAt = blockAt + usize.ONE
      }
      order = unique && first != usize.MAX && second != usize.MAX && witness
    }
  }
  let mut signatureMatches = false
  if let Option<InstanceKey>.Some {value} = move selected {
    let application = run InstanceKey.selected(&value)
    let signature = run Semantic.specializeSignature(&mut store, &mut request, &application, &id, Span.make(usize.ZERO, usize.ZERO))
    // Freeze the complete ordered loan domain before rewriting; no streaming map remains.
    let mut expectedArguments = Vector.make<Argument>()
    let lent = Vector.asSlice<Shared<Type>>(&loanTypes)
    let mut lentAt = usize.ZERO
    while lentAt < lent.length {
      run Vector.append<Argument>(&mut expectedArguments, Argument.Type {value: Shared.clone<Type>(&lent[lentAt])})
      lentAt = lentAt + usize.ONE
    }
    let expectedKey = run requiredCanonicalKey(run InstanceKey.function(run specializationWithArguments(&caller, move expectedArguments)))
    let expectedApplication = run InstanceKey.selected(&expectedKey)
    let given = Vector.asSlice<Argument>(&expectedApplication.arguments)
    let mut numbered = Vector.make<Shared<Type>>()
    let mut typedArguments = true
    lentAt = usize.ZERO
    while lentAt < given.length {
      if let Argument.Type {value: expectedType} = &given[lentAt] { run Vector.append<Shared<Type>>(&mut numbered, Shared.clone<Type>(&expectedType)) }
      else { typedArguments = false }
      lentAt = lentAt + usize.ONE
    }
    signatureMatches = typedArguments && (run witnessMirLendingSignature(&signature, Vector.asSlice<Shared<Type>>(&numbered)))
  }
  run Testing.expect(order && operands && signatureMatches && starts(Semantic.eventLog(&store), Family.Body) == usize.ONE,
    "validated shared and exclusive witness loans capture each owned rvalue once in written order with actual caller regions, numbered in the witness instance's matching parameter ABI")
  return ()
}

fn witnessMirLendingNode(value: &TypedBody) -> Option<BodyNodeId> {
  let nodes = TypedBody.nodeSlice(value)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {..}, ..} = &nodes[at].kind {
      return Option.some<BodyNodeId>(BodyNodeId {index: at})
    }
    at = at + usize.ONE
  }
  return Option.none<BodyNodeId>()
}

fn witnessMirFirst(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"first") }

fn witnessMirSecond(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"second") }

fn witnessMirRead(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"read") }

fn witnessMirLentAccess(at: usize) -> Access {
  if at == 2 { return Access.Mutable }
  return Access.Shared
}

effect fn witnessMirLentCapture(function: &MirFunction, reference: usize, producer: usize, definitionBlock: usize,
  argument: &BodyCallArgument, caller: &DeclarationId, expected: Access) -> Option<usize>
! OutOfMemoryError
? &mut Allocator {
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  if reference >= locals.length || producer >= locals.length || definitionBlock >= blocks.length { return Option.none<usize>() }
  if !run Type.equalsShared(&locals[producer].ty, &argument.ty) { return Option.none<usize>() }
  let exactType = run witnessMirLentType(&locals[reference].ty, argument, caller, expected)
  if !exactType { return Option.none<usize>() }
  let mut captured = usize.MAX
  let mut refAt = usize.MAX
  let mut refCount = usize.ZERO
  let mut blockAt = usize.ZERO
  while blockAt < blocks.length {
    let definitions = Vector.asSlice<MirStatement>(&blocks[blockAt].statements)
    let mut at = usize.ZERO
    while at < definitions.length {
      if let MirStatement.Assign {destination, value, ..} = &definitions[at] {
        if destination.local == reference {
          refCount = refCount + usize.ONE
          if blockAt != definitionBlock || Vector.length<MirProjection>(&destination.projections) != usize.ZERO { return Option.none<usize>() }
          if let MirRvalue.Ref {access, place} = &value {
            if access != expected || Vector.length<MirProjection>(&place.projections) != usize.ZERO { return Option.none<usize>() }
            captured = place.local
            refAt = at
          } else { return Option.none<usize>() }
        }
      }
      at = at + usize.ONE
    }
    blockAt = blockAt + usize.ONE
  }
  if refCount != usize.ONE || captured >= locals.length || captured == reference || captured == producer { return Option.none<usize>() }
  if !run Type.equalsShared(&locals[captured].ty, &argument.ty) { return Option.none<usize>() }
  let mut captureCount = usize.ZERO
  blockAt = usize.ZERO
  while blockAt < blocks.length {
    let definitions = Vector.asSlice<MirStatement>(&blocks[blockAt].statements)
    let mut at = usize.ZERO
    while at < definitions.length {
      if let MirStatement.Assign {destination, value, ..} = &definitions[at] {
        if destination.local == captured {
          captureCount = captureCount + usize.ONE
          if blockAt != definitionBlock || at >= refAt || Vector.length<MirProjection>(&destination.projections) != usize.ZERO { return Option.none<usize>() }
          if let MirRvalue.Use {value: source} = &value {
            if !witnessMirLentSource(&source, producer) { return Option.none<usize>() }
          } else { return Option.none<usize>() }
        }
      }
      at = at + usize.ONE
    }
    blockAt = blockAt + usize.ONE
  }
  if captureCount != usize.ONE { return Option.none<usize>() }
  return Option.some<usize>(captured)
}

fn witnessMirLentSource(value: &MirOperand, producer: usize) -> bool {
  if let MirOperand.Copy {place} = &value.* {
    return place.local == producer && Vector.length<MirProjection>(&place.projections) == usize.ZERO
  }
  if let MirOperand.Move {place} = &value.* {
    return place.local == producer && Vector.length<MirProjection>(&place.projections) == usize.ZERO
  }
  return false
}

struct WitnessMirLoanHeader {
  referent: Shared<Type>
  lifetime: Shared<Lifetime>
  access: Access
}

fn witnessMirLoanHeader(value: &Type) -> Option<WitnessMirLoanHeader> {
  if let Type.Reference {referent, access, lifetime} = &value.* {
    return Option.some<WitnessMirLoanHeader>(WitnessMirLoanHeader {
      referent: Shared.clone<Type>(&referent), lifetime: Shared.clone<Lifetime>(&lifetime), access: access,
    })
  }
  return Option.none<WitnessMirLoanHeader>()
}

effect fn witnessMirLentType(value: &Shared<Type>, argument: &BodyCallArgument, caller: &DeclarationId, expected: Access) -> bool
! OutOfMemoryError
? &mut Allocator {
  let selected = Shared.with<Type, Option<WitnessMirLoanHeader>>(value, witnessMirLoanHeader)
  if let Option<WitnessMirLoanHeader>.Some {value: header} = move selected {
    let exactRegion = Shared.with<Lifetime, bool>(&header.lifetime, fn(value: &Lifetime) -> bool {
      if let Lifetime.Local {declaration, ordinal} = &value.* {
        return DeclarationId.equals(&declaration, caller) && ordinal == argument.origin.syntax.index
      }
      return false
    })
    return header.access == expected && exactRegion && run Type.equalsShared(&header.referent, &argument.ty)
  }
  return false
}

fn witnessMirLendingParameterCount(value: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value: found} = &value.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &found.outcome {
      return Vector.length<Shared<Type>>(&signature.parameters)
    }
  }
  return usize.ZERO
}

fn witnessMirLendingParameter(value: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<Type>> {
  if let Result<Answer, NoRejection>.Success {value: found} = &value.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &found.outcome {
      let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
      if at < parameters.length { return Option.some<Shared<Type>>(Shared.clone<Type>(&parameters[at])) }
    }
  }
  return Option.none<Shared<Type>>()
}

effect fn witnessMirLendingSignature(value: &Shared<Result<Answer, NoRejection>>, loans: &[Shared<Type>]) -> bool
! OutOfMemoryError
? &mut Allocator {
  if loans.length != 3 || Shared.with<Result<Answer, NoRejection>, usize>(value, witnessMirLendingParameterCount) != 3 { return false }
  let mut at = usize.ZERO
  while at < loans.length {
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(value,
      fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return witnessMirLendingParameter(value, at) })
    if let Option<Shared<Type>>.Some {value: parameter} = move selected {
      if !run Type.equalsShared(&parameter, &loans[at]) { return false }
    } else { return false }
    at = at + usize.ONE
  }
  return true
}

test effect fn witnessMirNamesMissingOperationInputs() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("b12-operation-input-gap.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
interface Extra { fn use<U>(value: Self, item: U) -> i32 }
struct Maker {}
impl Extra for Maker { fn use<T>(value: Self, item: T) -> i32 { return missing } }
fn caller() -> i32 { return Extra.use(Maker {}, 42) }
"""
  let mut store = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"caller") |> Effect.provideMut<Allocator>(&mut allocator)
  let gap = Shared.with<Result<Answer, NoRejection>, Option<Shared<BackendGap>>>(&answer, selectedBackendGap)
  let start = offsetOf(source, "Extra.use(Maker {}, 42)", 0)
  let named = match move gap {
    Option<Shared<BackendGap>>.Some {value} => Shared.with<BackendGap, bool>(&value, fn(value: &BackendGap) -> bool {
      let span = BackendGap.span(value)
      return value.code == GapCode.GenericOperation && span.start == start && span.end == start + 23
        && Shared.with<DeclarationId, bool>(&value.owner, operationGapCaller)
    })
    _ => false
  }
  run Testing.expect(named && starts(Semantic.eventLog(&store), Family.Body) == usize.ONE,
    "unrecorded operation-owned inputs remain a named caller-owned gap at the exact call without reading the witness body")
  return ()
}

fn operationGapCaller(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"caller") }

test effect fn genericPolymorphicRecursionBuildRetainsRejectedApplicationPath() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("b12main.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("b12library.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
struct Box<T> { value: T }
pub fn expand<T>(value: T) -> i32 { return expand<Box<T>>(Box<T> { value: move value }) }
"""
  let entrySource = run present("""
import b12library {expand}
pub fn main() -> i32 { return expand<i32>(1) }
""") |> Effect.provideMut<Allocator>(&mut allocator)
  let librarySource = run present(source) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &entrySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let held = run Revision.publish(&first, &library, &librarySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = makeSemantic(run Revision.copy(&held) |> Effect.provideMut<Allocator>(&mut allocator))
  let mut request = Request.make()
  let built = run Semantic.buildMain(&mut store, &mut request, &entry, staticClosureNodes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rejected = match & built {
    BackendBuild.Rejected {first: diagnostic, ..} => Shared.with<Rejection, bool>(&diagnostic, fn(value: &Rejection) -> bool {
      if value.code != RejectionCode.ExpandingSpecialization || !ModuleId.equals(&value.module, &library) { return false }
      let spelling = "expand<Box<T>>(Box<T> { value: move value })"
      let start = offsetOf(source, spelling, usize.ZERO)
      if value.span.start != start || value.span.end != start + String.utf8Bytes(spelling).length { return false }
      let path = Vector.asSlice<SpecializationApplication>(&value.specialization)
      if path.length != 2 { return false }
      let original = SpecializationApplication.bodyDeclaration(&path[usize.ZERO])
      let recursive = SpecializationApplication.bodyDeclaration(&path[usize.ONE])
      if !DeclarationId.equals(original, recursive) || !DeclarationId.named(original, b"expand") { return false }
      let scalar = match move b12SingleArgumentType(&path[usize.ZERO].arguments) {
        Option<Shared<Type>>.Some {value: ty} => Shared.with<Type, bool>(&ty, b12IntegerType)
        Option<Shared<Type>>.None => false
      }
      let boxed = match move b12SingleArgumentType(&path[usize.ONE].arguments) {
        Option<Shared<Type>>.Some {value: ty} => Shared.with<Type, bool>(&ty, b12BoxIntegerType)
        Option<Shared<Type>>.None => false
      }
      return scalar && boxed
    })
    _ => false
  }
  run Testing.expect(rejected, "expanding direct recursion retains i32 to Box<i32> and the imported caller span")
  return ()
}

// A Drop hook's cleanup may reach the same hook at a smaller type argument owned by the value it
// started from (GEN-006): `Bag<Wrap>` drops a `Wrap` that owns a `Bag<u8>`. Growth beyond that
// owned structure inside the cleanup keeps the ordinary recursion guard.
test effect fn cleanupReentryStaysWithinItsOwnedRoot() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run cleanupReentryClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn cleanupReentryClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let owned = run module("cleanup-owned-reentry.silk")
  let ownedText = """
struct Wrap { inner: Bag<u8> }
struct Bag<T> { buffer: RawBuffer<T> }
impl<T> Drop for Bag<T> {
  fn drop(self: &mut Bag<T>) -> () { return release<T>(&mut self.buffer) }
}
fn release<T>(buffer: &mut RawBuffer<T>) -> () {
  unsafe {
    let slot = Intrinsic.rawBufferSlot<T>(buffer, 0)
    return Intrinsic.slotDrop<T>(move slot)
  }
}
fn absurd<T>() -> T { return absurd<T>() }
pub fn main() -> i32 {
  let nested = absurd<Bag<Wrap>>()
  return 0
}
"""
  let mut ownedStore = run staticSemantic(&owned, ownedText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut ownedRequest = Request.make()
  let descended = run Semantic.buildMain(&mut ownedStore, &mut ownedRequest, &owned, staticClosureNodes)
  run Testing.expect(match &descended { BackendBuild.Module {..} => true _ => false },
    "a hook's cleanup re-enters the hook and its helpers at a type argument its root owns")
  let growing = run module("cleanup-growing-reentry.silk")
  let growingText = """
struct Grow<T> { buffer: RawBuffer<T> }
impl<T> Drop for Grow<T> {
  fn drop(self: &mut Grow<T>) -> () {
    let bigger = absurd<Grow<Grow<T>>>()
    return ()
  }
}
fn absurd<T>() -> T { return absurd<T>() }
pub fn main() -> i32 {
  let grown = absurd<Grow<i32>>()
  return 0
}
"""
  let mut growingStore = run staticSemantic(&growing, growingText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut growingRequest = Request.make()
  let grew = run Semantic.buildMain(&mut growingStore, &mut growingRequest, &growing, staticClosureNodes)
  let refused = match &grew {
    BackendBuild.Rejected {first: diagnostic, ..} => Shared.with<Rejection, bool>(&diagnostic, fn(value: &Rejection) -> bool {
      let path = Vector.asSlice<SpecializationApplication>(&value.specialization)
      return value.code == RejectionCode.ExpandingSpecialization && path.length > usize.ONE
        && DeclarationId.named(SpecializationApplication.bodyDeclaration(&path[usize.ZERO]), b"drop")
        && DeclarationId.named(SpecializationApplication.bodyDeclaration(&path[path.length - usize.ONE]), b"drop")
    })
    _ => false
  }
  run Testing.expect(refused, "a hook whose cleanup drops a value outside its root's owned structure still grows")
  let independent = run module("independent-refusals.silk")
  let independentText = """
struct Box<T> { value: T }
fn left<T>(value: T) -> i32 { return left<Box<T>>(Box<T> { value: move value }) }
fn right<T>(value: T) -> i32 { return right<Box<T>>(Box<T> { value: move value }) }
pub fn main() -> i32 { return left<i32>(1) + right<i32>(2) }
"""
  let mut independentStore = run staticSemantic(&independent, independentText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut independentRequest = Request.make()
  let refusedBoth = run Semantic.buildMain(&mut independentStore, &mut independentRequest, &independent, staticClosureNodes)
  let leftStart = offsetOf(independentText, "left<Box<T>>(Box<T> { value: move value })", usize.ZERO)
  let rightStart = offsetOf(independentText, "right<Box<T>>(Box<T> { value: move value })", usize.ZERO)
  let mut starts = Vector.make<usize>()
  let mut reportedBoth = false
  if let BackendBuild.Rejected {first, further, ..} = &refusedBoth {
    run Vector.append<usize>(&mut starts, expandingStart(&first))
    let others = Vector.asSlice<Shared<Rejection>>(&further)
    if others.length == usize.ONE { run Vector.append<usize>(&mut starts, expandingStart(&others[usize.ZERO])) }
    let found = Vector.asSlice<usize>(&starts)
    reportedBoth = found.length == 2 && ((found[usize.ZERO] == leftStart && found[usize.ONE] == rightStart)
      || (found[usize.ZERO] == rightStart && found[usize.ONE] == leftStart))
  }
  run Testing.expect(reportedBoth, "a build walks past a refused instance and reports each independent refusal once")
  let delegating = run module("witness-nongrowing.silk")
  let delegatingText = """
interface Decode { effect fn decode(input: &i32) -> Self }
effect fn decodeOne<T: Decode>(input: &i32) -> T { return run Decode.decode(input) }
impl Decode for i32 { effect fn decode(input: &i32) -> Self { return input.* } }
struct Point { x: i32 y: i32 }
impl Decode for Point {
  effect fn decode(input: &i32) -> Self {
    let x = run decodeOne<i32>(input)
    return Point { x: x, y: x }
  }
}
pub fn main() -> i32 {
  let seed: i32 = 20
  let point = run decodeOne<Point>(&seed)
  return point.x + point.y
}
"""
  let mut delegatingStore = run staticSemantic(&delegating, delegatingText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut delegatingRequest = Request.make()
  let delegated = run Semantic.buildMain(&mut delegatingStore, &mut delegatingRequest, &delegating, staticClosureNodes)
  run Testing.expect(match &delegated { BackendBuild.Module {..} => true _ => false },
    "a witness delegates through a helper to a concrete application whose type arguments do not grow (GEN-006)")
  return ()
}

// The start of an expanding-specialization refusal, or `usize.MAX` for any other diagnostic.
fn expandingStart(diagnostic: &Shared<Rejection>) -> usize {
  return Shared.with<Rejection, usize>(diagnostic, fn(value: &Rejection) -> usize {
    if value.code != RejectionCode.ExpandingSpecialization { return usize.MAX }
    return value.span.start
  })
}

fn b12IntegerType(value: &Type) -> bool {
  return match & value.* { Type.Primitive {name} => sameBytes(Bytes.asSlice(&name), b"i32")
    _ => false
  }
}

fn b12BoxIntegerType(value: &Type) -> bool {
  return match &value.* {
    Type.Nominal {declaration, arguments, ..} => {
      if !DeclarationId.named(&declaration, b"Box") { return false }
      let listed = Vector.asSlice<Argument>(&arguments)
      if listed.length != usize.ONE { return false }
      return match &listed[usize.ZERO] {
        Argument.Type {value: ty} => Shared.with<Type, bool>(&ty, b12IntegerType)
        _ => false
      }
    }
    _ => false
  }
}

fn b12SingleArgumentType(arguments: &Vector<Argument>) -> Option<Shared<Type>> {
  let listed = Vector.asSlice<Argument>(arguments)
  if listed.length != usize.ONE { return Option.none<Shared<Type>>() }
  return match & listed[usize.ZERO] {
    Argument.Type {value: ty} => Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
    _ => Option.none<Shared<Type>>()
  }
}

test effect fn genericRecursiveResultKeepsCallerParameter() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("b12-recursive-result.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
struct Box<T> { value: T }
fn repeat<T>(value: T, count: i32) -> T {
  if count == 0 { return move value }
  return repeat<T>(move value, count - 1)
}
fn wrong<T>(argument: T) -> i32 { return wrong<Box<T>>(move argument) }
pub fn main() -> i32 { return repeat<i32>(42, 1) }
"""
  let mut store = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let repeat = run Semantic.demandBody(&mut store, &mut request, &id, b"repeat") |> Effect.provideMut<Allocator>(&mut allocator)
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&repeat, checkedBody)
  let canonical = match move body {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, bool>(&value, b12RepeatHasCanonicalCallerResult)
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(canonical && Shared.with<Result<Answer, NoRejection>, bool>(&repeat, bodyAnswerIsContractTyped),
    "recursive result and completed type argument retain the authored caller T")
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.TypeMismatch, source, "move argument", usize.ZERO),
    "fresh callee binders do not admit a caller T where Box<T> is required")
  return ()
}

fn b12RepeatHasCanonicalCallerResult(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.DirectCall {declaration, application, ..}} = &nodes[at].kind {
      if DeclarationId.named(&declaration, b"repeat") {
        let resultIsCaller = Shared.with<Type, usize>(&ty, fn(value: &Type) -> usize {
          return Type.parameterOrdinalOf(value, &declaration)
        }) == usize.ZERO
        let argumentIsCaller = Shared.with<SpecializationApplication, bool>(&application, fn(value: &SpecializationApplication) -> bool {
          return b12ArgumentIsCaller(&value.arguments, &declaration)
        })
        return resultIsCaller && argumentIsCaller
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn b12ArgumentIsCaller(arguments: &Vector<Argument>, declaration: &DeclarationId) -> bool {
  let single = b12SingleArgumentType(arguments)
  if let Option<Shared<Type>>.Some {value} = move single {
    return Shared.with<Type, usize>(&value, fn(argument: &Type) -> usize {
      return Type.parameterOrdinalOf(argument, declaration)
    }) == usize.ZERO
  }
  return false
}

test effect fn genericAggregateBorrowContextKeepsCallerRegions() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("genericAggregateBorrowContextKeepsCallerRegions.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
tuple Witness<'a>(&'a i32)
fn consume<'a>(values: [&'a i32; 1], witness: &'a i32) -> i32 { return 42 }
fn consumeTuple<'a>(values: Witness<'a>, witness: &'a i32) -> i32 { return 42 }
fn arrayCall() -> i32 { let value = 42 return consume([&value], &value) }
fn tupleCall() -> i32 { let value = 42 return consumeTuple((&value,), &value) }
fn permanent() -> i32 { let value = 42 return consume<'static>([&value], &value) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let array = run Semantic.demandBody(&mut store, &mut request, &id, b"arrayCall") |> Effect.provideMut<Allocator>(&mut allocator)
  let tupleAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"tupleCall") |> Effect.provideMut<Allocator>(&mut allocator)
  let arrayBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&array, checkedBody)
  let tupleBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&tupleAnswer, checkedBody)
  let arrayCanonical = match move arrayBody {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, bool>(&value, b12AggregateRegionsAreCanonical)
    Option<Shared<TypedBody>>.None => false
  }
  let tupleCanonical = match move tupleBody {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, bool>(&value, b12AggregateRegionsAreCanonical)
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(arrayCanonical && tupleCanonical
    && Shared.with<Result<Answer, NoRejection>, bool>(&array, bodyAnswerIsContractTyped)
    && Shared.with<Result<Answer, NoRejection>, bool>(&tupleAnswer, bodyAnswerIsContractTyped),
    "nested array and nominal tuple operands plus completed call arguments retain only caller regions")
  let permanent = run Semantic.demandBody(&mut store, &mut request, &id, b"permanent") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&permanent, RejectionCode.TypeMismatch, text, "consume<'static>([&value], &value)", usize.ZERO),
    "explicit static arguments cannot manufacture static evidence for a written aggregate borrow")
  return ()
}

test effect fn genericAggregateForwardingKeepsCallerRegions() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("genericAggregateForwardingKeepsCallerRegions.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
tuple Witness<'a>(&'a i32)
fn consume<'a>(values: [&'a i32; 1], witness: &'a i32) -> i32 { return 42 }
fn consumeTuple<'a>(values: Witness<'a>, witness: &'a i32) -> i32 { return 42 }
fn forwardArray<'b>(reference: &'b i32) -> i32 { return consume([reference], reference) }
fn forwardTuple<'b>(reference: &'b i32) -> i32 { return consumeTuple((reference,), reference) }
fn relay<'a>(value: Witness<'a>) -> Witness<'a> { return move value }
fn forwardValues<'b>(values: [&'b i32; 1], pair: Witness<'b>, reference: &'b i32) -> i32 {
  let first = consume(move values, reference)
  return first + consumeTuple(relay<'b>(move pair), reference)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let forwardedArray = run Semantic.demandBody(&mut store, &mut request, &id, b"forwardArray") |> Effect.provideMut<Allocator>(&mut allocator)
  let forwardedTuple = run Semantic.demandBody(&mut store, &mut request, &id, b"forwardTuple") |> Effect.provideMut<Allocator>(&mut allocator)
  let forwardedArrayBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&forwardedArray, checkedBody)
  let forwardedTupleBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&forwardedTuple, checkedBody)
  let arrayForwarding = match move forwardedArrayBody {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, bool>(&value, b12ForwardRegionsAreCanonical)
    Option<Shared<TypedBody>>.None => false
  }
  let tupleForwarding = match move forwardedTupleBody {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, bool>(&value, b12ForwardRegionsAreCanonical)
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(arrayForwarding && tupleForwarding
    && Shared.with<Result<Answer, NoRejection>, bool>(&forwardedArray, bodyAnswerIsContractTyped)
    && Shared.with<Result<Answer, NoRejection>, bool>(&forwardedTuple, bodyAnswerIsContractTyped),
    "existing references retain the caller lifetime parameter through operands, parent aggregates and call arguments")
  let forwardedValues = run Semantic.demandBody(&mut store, &mut request, &id, b"forwardValues") |> Effect.provideMut<Allocator>(&mut allocator)
  let valueBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&forwardedValues, checkedBody)
  let valueCanonical = match move valueBody {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, bool>(&value, b12ValueRegionsAreCanonical)
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(valueCanonical && Shared.with<Result<Answer, NoRejection>, bool>(&forwardedValues, bodyAnswerIsContractTyped),
    "existing arrays, moved nominal values and relay results retain the authored caller lifetime in all operands and calls")
  return ()
}

test effect fn genericAggregateMixedBindersKeepCallerRegions() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("genericAggregateMixedBindersKeepCallerRegions.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
fn consumeMixed<'a, T>(values: [&'a T; 1], witness: &'a T, scalar: T) -> i32 { return 42 }
fn mixedForward<'b>(reference: &'b u8) -> i32 { return consumeMixed([reference], reference, 42) }
fn mixedBorrow(value: u8) -> i32 { return consumeMixed([&value], &value, 42) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let mixed = run Semantic.demandBody(&mut store, &mut request, &id, b"mixedForward") |> Effect.provideMut<Allocator>(&mut allocator)
  let mixedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&mixed, checkedBody)
  let mixedCanonical = match move mixedBody {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, bool>(&value, b12MixedRegionsAreCanonical)
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(mixedCanonical && Shared.with<Result<Answer, NoRejection>, bool>(&mixed, bodyAnswerIsContractTyped),
    "lifetime-first type-second binders retain their written slots, narrow literal context and canonical caller evidence")
  let mixedBorrow = run Semantic.demandBody(&mut store, &mut request, &id, b"mixedBorrow") |> Effect.provideMut<Allocator>(&mut allocator)
  let mixedBorrowBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&mixedBorrow, checkedBody)
  let mixedBorrowCanonical = match move mixedBorrowBody {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, bool>(&value, b12MixedBorrowRegionsAreCanonical)
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(mixedBorrowCanonical && Shared.with<Result<Answer, NoRejection>, bool>(&mixedBorrow, bodyAnswerIsContractTyped),
    "mixed-order written borrows infer u8 before the final scalar literal receives its narrow type context")
  return ()
}

fn b12CallerRegion(region: &Lifetime, caller: &DeclarationId, ordinal: usize, parameterRegion: bool) -> bool {
  return match &region.* {
    Lifetime.Local {declaration, ordinal: found} => !parameterRegion && found == ordinal && DeclarationId.equals(&declaration, caller)
    Lifetime.Parameter {declaration, ordinal: found} => parameterRegion && found == usize.ZERO && DeclarationId.equals(&declaration, caller)
    _ => false
  }
}

fn b12ContextTypeIsCanonical(value: &Type, caller: &DeclarationId, ordinal: usize, parameterRegion: bool) -> bool {
  return match &value.* {
    Type.Primitive {..} => true
    Type.Unit => true
    Type.Reference {referent, lifetime, ..} => Shared.with<Lifetime, bool>(&lifetime,
      fn(region: &Lifetime) -> bool { return b12CallerRegion(region, caller, ordinal, parameterRegion) })
      && Shared.with<Type, bool>(&referent, fn(nested: &Type) -> bool { return b12ContextTypeIsCanonical(nested, caller, ordinal, parameterRegion) })
    Type.Array {element, ..} => Shared.with<Type, bool>(&element,
      fn(nested: &Type) -> bool { return b12ContextTypeIsCanonical(nested, caller, ordinal, parameterRegion) })
    Type.Nominal {arguments, ..} => {
      let listed = Vector.asSlice<Argument>(&arguments)
      if listed.length != usize.ONE { return false }
      return match &listed[usize.ZERO] {
        Argument.Lifetime {value: region} => Shared.with<Lifetime, bool>(&region,
          fn(lifetime: &Lifetime) -> bool { return b12CallerRegion(lifetime, caller, ordinal, parameterRegion) })
        _ => false
      }
    }
    _ => false
  }
}

fn b12AggregateRegionsAreCanonical(body: &TypedBody) -> bool {
  return b12AggregateRegionEvidence(body, false, false)
}

fn b12ForwardRegionsAreCanonical(body: &TypedBody) -> bool {
  return b12AggregateRegionEvidence(body, true, false)
}

fn b12MixedRegionsAreCanonical(body: &TypedBody) -> bool {
  return b12AggregateRegionEvidence(body, true, true)
}

fn b12MixedBorrowRegionsAreCanonical(body: &TypedBody) -> bool {
  return b12AggregateRegionEvidence(body, false, true)
}

fn b12AggregateRegionEvidence(body: &TypedBody, parameterRegion: bool, mixed: bool) -> bool {
  let caller = TypedBody.declarationId(body)
  let nodes = TypedBody.nodeSlice(body)
  let mut callOrdinal = usize.MAX
  let mut calls = usize.ZERO
  let mut borrows = usize.ZERO
  let mut aggregates = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {application, ..}, ..} = &nodes[at].kind {
      callOrdinal = nodes[at].origin.syntax.index
      if !Shared.with<SpecializationApplication, bool>(&application, fn(value: &SpecializationApplication) -> bool {
        return b12ArgumentsLifetimeCanonical(&value.arguments, caller, callOrdinal, parameterRegion, mixed)
      }) { return false }
      calls = calls + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form} = &nodes[at].kind {
      if !Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool { return b12ContextTypeIsCanonical(value, caller, callOrdinal, parameterRegion) }) { return false }
      if let BodyExpression.Borrow {..} = &form { borrows = borrows + usize.ONE }
      if let BodyExpression.Aggregate {..} = &form { aggregates = aggregates + usize.ONE }
    }
    at = at + usize.ONE
  }
  return calls == usize.ONE && aggregates == usize.ONE && ((parameterRegion && borrows == usize.ZERO) || (!parameterRegion && borrows == 2))
}

fn b12ArgumentsLifetimeCanonical(arguments: &Vector<Argument>, caller: &DeclarationId, ordinal: usize, parameterRegion: bool, mixed: bool) -> bool {
  let supplied = Vector.asSlice<Argument>(arguments)
  let mut count = usize.ONE
  if mixed { count = 2 }
  if supplied.length != count { return false }
  if mixed {
    let scalar = match &supplied[usize.ONE] {
      Argument.Type {value} => Shared.with<Type, bool>(&value, fn(ty: &Type) -> bool {
        return match &ty.* { Type.Primitive {name} => sameBytes(Bytes.asSlice(&name), b"u8") _ => false }
      })
      _ => false
    }
    if !scalar { return false }
  }
  if let Argument.Lifetime {value} = &supplied[usize.ZERO] {
    return Shared.with<Lifetime, bool>(&value,
      fn(lifetime: &Lifetime) -> bool { return b12CallerRegion(lifetime, caller, ordinal, parameterRegion) })
  }
  return false
}

fn b12ValueRegionsAreCanonical(body: &TypedBody) -> bool {
  let caller = TypedBody.declarationId(body)
  let nodes = TypedBody.nodeSlice(body)
  let mut calls = usize.ZERO
  let mut relay = false
  let mut array = false
  let mut tupleValue = false
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form} = &nodes[at].kind {
      if !Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool {
        return b12ContextTypeIsCanonical(value, caller, usize.MAX, true)
      }) { return false }
      array = array || Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool {
        return match &value.* { Type.Array {..} => true _ => false }
      })
      tupleValue = tupleValue || Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool {
        return match &value.* { Type.Nominal {declaration, ..} => DeclarationId.named(&declaration, b"Witness") _ => false }
      })
      if let BodyExpression.DirectCall {declaration, application, ..} = &form {
        if !Shared.with<SpecializationApplication, bool>(&application, fn(value: &SpecializationApplication) -> bool {
        return b12ArgumentsLifetimeCanonical(&value.arguments, caller, usize.MAX, true, false)
      }) { return false }
        relay = relay || DeclarationId.named(&declaration, b"relay")
        calls = calls + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return calls == 3 && relay && array && tupleValue
}

fn anonymousTargetSpecializationApplication(target: &SpecializationApplication) -> bool {
  return DeclarationId.kind(SpecializationApplication.bodyDeclaration(target)) == OwnerKind.Anonymous
}

fn captureContractMode(ty: &Type) -> CallableMode {
  return match &ty.* {
    Type.Callable {mode, ..} => mode
    _ => CallableMode.Once
  }
}

fn anonymousCaptureFacts(body: &TypedBody, mode: CallableMode, first: usize, second: usize, count: usize, borrowed: bool) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Callable {body: anonymous, fields}} = &nodes[at].kind {
      if Vector.length<BodyAggregateField>(&fields) != count { return false }
      let selected = Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool {
        if let Type.CallableValue {contract, captures, application, ..} = &value.* {
          if Vector.length<Shared<Type>>(&captures) != count || Shared.with<Type, CallableMode>(&contract, captureContractMode) != mode { return false }
          return Shared.with<SpecializationApplication, bool>(&application, anonymousTargetSpecializationApplication)
        }
        return false
      })
      if !selected { return false }
      return Shared.with<TypedBody, bool>(&anonymous, fn(checked: &TypedBody) -> bool {
        let available = TypedBody.environmentOf(checked)
        if let Option<BodyEnvironment>.Some {value: environment} = &available.* {
          let captures = Vector.asSlice<BodyEnvironmentCapture>(&environment.captures)
          if captures.length != count { return false }
          if count > usize.ZERO && (captures[usize.ZERO].local.index != first || captures[usize.ZERO].dereference != borrowed) { return false }
          if count > usize.ONE && captures[usize.ONE].local.index != second { return false }
          return true
        }
        return false
      })
    }
    at = at + usize.ONE
  }
  return false
}

fn captureBodyMatches(answer: &Result<Answer, NoRejection>, mode: CallableMode, first: usize, second: usize, count: usize, borrowed: bool) -> bool {
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedBody(answer) {
    return Shared.with<TypedBody, bool>(&body, fn(value: &TypedBody) -> bool {
      return anonymousCaptureFacts(value, mode, first, second, count, borrowed)
    })
  }
  return false
}

// Independent capture policy: first lexical use owns the field order, Copy is a snapshot,
// an affine read retains a loan, assignment upgrades access, and affine move consumes once.
// Before Step 8b every literal rejected at its written expression; no earlier source claim
// reached capture types or hidden bodies. This uses existing semantic demands and production data.
test effect fn anonymousBodiesRetainOrderedCaptureModes() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run anonymousCaptureClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn anonymousCaptureClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("captures.silk")
  let text = """
struct Token { value: i32 }
fn copied(first: i32, second: i32) -> () {
  let closure = fn() -> i32 { return second + first + second }
}
fn borrowed(token: Token) -> () {
  let closure = fn() -> i32 { return token.value }
}
fn mutated() -> () {
  let mut counter = 1
  let closure = fn() -> () { counter = 2 }
}
fn consumed(token: Token) -> () {
  let closure = fn() -> Token { return move token }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copied")
  let borrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowed")
  let mutated = run Semantic.demandBody(&mut store, &mut request, &id, b"mutated")
  let consumed = run Semantic.demandBody(&mut store, &mut request, &id, b"consumed")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&copied, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Shared, usize.ONE, usize.ZERO, 2, false)
  }), "Copy captures follow first use and retain one field per binding")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&borrowed, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Shared, usize.ZERO, usize.MAX, usize.ONE, true)
  }), "reading an affine owner retains a shared capture loan")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&mutated, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Mutable, usize.ZERO, usize.MAX, usize.ONE, true)
  }), "an assignment-only capture retains an exclusive loan and requires mutable invocation")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&consumed, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Once, usize.ZERO, usize.MAX, usize.ONE, false)
  }), "an affine move transfers its owner into a once environment")
}

test effect fn anonymousViewsRetainSourceValidityAndInvocation() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
