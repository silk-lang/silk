  let o2CallPartial = run Semantic.demandBody(&mut store, &mut request, &id, b"o2CallPartial")
  let o2LiteralPartial = run Semantic.demandBody(&mut store, &mut request, &id, b"o2LiteralPartial")
  run Testing.expect(rejectsSpan(&o2CallPartial, RejectionCode.AccessDuringLoan, text, "src.t", 102)
