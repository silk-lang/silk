// Storage ends are validity boundaries, including selected arm subjects and propagated failure
// cleanup. Ordinary views still end their loans at the last use (BORROW-008, LIFE-001, LIFE-005).
effect fn storedLoanScopeClaims(which: usize) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("stored-loan-scopes.silk")
  let text = """
struct View<T> { value: T }
union Choice { Value { value: i32 } }
enum Side { Left, Right }
enum Failure { Failed }
struct Observed<'a> { value: &'a i32 }
impl<'a> Intrinsic.Drop for Observed<'a> {
  fn drop(self: &mut Observed<'a>) -> () { let read = self.value.* return () }
}
effect fn attempt() -> () ! Failure { fail Failure.Failed }
fn returned<'a>(input: &'a i32) -> &'a i32 {
  let local = 1
  return &local
}
fn outerHolder(flag: bool) -> i32 {
  let outer = 1
  let mut held = &outer
  if flag {
    let inner = 2
    held = &inner
  }
  return held.*
}
fn armEscape(choice: Choice) -> i32 {
  let held = match move choice { Choice.Value { value: inner } => &inner }
  return held.*
}
fn branchEscape<'a>(side: Side, input: &'a i32) -> &'a i32 {
  return match side {
    Side.Left => { let inner = 2 return &inner }
    Side.Right => input
  }
}
fn copiedSubject(flag: bool) -> i32 {
  let outer = 1
  let mut held = &outer
  if flag {
    let inner = 2
    let wrapped = View {value: &inner}
    held = match move wrapped { View<&i32> {value: selected} => selected }
  }
  return held.*
}
effect fn failureCleanup(flag: bool) -> () ! Failure {
  let outer = 1
  let mut held = Observed {value: &outer}
  if flag {
    let inner = 2
    held = Observed {value: &inner}
    run attempt()
    held = Observed {value: &outer}
  }
}
effect fn explicitFailure(flag: bool) -> () ! Failure {
  let outer = 1
  let mut held = Observed {value: &outer}
  if flag {
    let inner = 2
    held = Observed {value: &inner}
    fail Failure.Failed
  }
}
fn mutableLocal() -> i32 {
  let value = 1
  let mut held = &value
  return held.*
}
fn subjectLocal() -> i32 {
  let value = 2
  let wrapped = View {value: &value}
  return match move wrapped { View<&i32> {value: selected} => selected.* }
}
fn reassigned() -> i32 {
  let mut first = 1
  let second = 2
  let mut held = &first
  held = &second
  first = 3
  return held.* + first
}
effect fn orderedFailure() -> () ! Failure {
  let value = 1
  let held = Observed {value: &value}
  run attempt()
}
fn letSubject() -> i32 {
  let value = 2
  let wrapped = View {value: &value}
  let View<&i32> {value: selected} = move wrapped
  return selected.*
}
fn letEscape(flag: bool) -> i32 {
  let outer = 1
  let mut heldLet = &outer
  if flag {
    let inner = 2
    let wrapped = View {value: &inner}
    let View<&i32> {value: selected} = move wrapped
    heldLet = selected
  }
  return heldLet.*
}
fn ifLetEscape(choice: Choice) -> i32 {
  let outer = 1
  let mut heldIf = &outer
  if let Choice.Value {value: inner} = move choice { heldIf = &inner }
  return heldIf.*
}
fn breakEscape(flag: bool) -> i32 {
  let outer = 1
  let mut heldBreak = &outer
  while flag {
    let inner = 2
    heldBreak = &inner
    break
  }
  return heldBreak.*
}
fn continueEscape(flag: bool) -> i32 {
  let outer = 1
  let mut heldContinue = &outer
  while flag {
    let inner = 2
    heldContinue = &inner
    continue
  }
  return heldContinue.*
}
fn loopReset(flag: bool) -> i32 {
  let outer = 1
  let mut heldReset = &outer
  while flag {
    let inner = 2
    heldReset = &inner
    let seen = heldReset.*
    heldReset = &outer
    break
  }
  return heldReset.*
}
struct Tick {}
impl Intrinsic.Drop for Tick { fn drop(self: &mut Tick) -> () { return () } }
struct Bundle<T> { view: T tick: Tick }
fn unrelatedCleanup(flag: bool) -> i32 {
  let outer = 1
  let mut held = Bundle {view: &outer, tick: Tick {}}
  if flag {
    let inner = 2
    held = Bundle {view: &inner, tick: Tick {}}
    let seen = held.view.*
  }
  return 0
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let returned = run Semantic.demandBody(&mut store, &mut request, &id, b"returned")
  let holder = run Semantic.demandBody(&mut store, &mut request, &id, b"outerHolder")
  let arm = run Semantic.demandBody(&mut store, &mut request, &id, b"armEscape")
  let branch = run Semantic.demandBody(&mut store, &mut request, &id, b"branchEscape")
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copiedSubject")
  let failed = run Semantic.demandBody(&mut store, &mut request, &id, b"failureCleanup")
  let explicit = run Semantic.demandBody(&mut store, &mut request, &id, b"explicitFailure")
  let mutable = run Semantic.demandBody(&mut store, &mut request, &id, b"mutableLocal")
  let subject = run Semantic.demandBody(&mut store, &mut request, &id, b"subjectLocal")
  let replaced = run Semantic.demandBody(&mut store, &mut request, &id, b"reassigned")
  let ordered = run Semantic.demandBody(&mut store, &mut request, &id, b"orderedFailure")
  let letSubject = run Semantic.demandBody(&mut store, &mut request, &id, b"letSubject")
  let letEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"letEscape")
  let ifLetEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"ifLetEscape")
  let breakEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"breakEscape")
  let continueEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"continueEscape")
  let loopReset = run Semantic.demandBody(&mut store, &mut request, &id, b"loopReset")
  let unrelatedCleanup = run Semantic.demandBody(&mut store, &mut request, &id, b"unrelatedCleanup")
  if which == 0 {
    run Testing.expect(rejectsSpan(&returned, RejectionCode.ExpiredLifetime, text, "&local", usize.ZERO),
    "a local returned beyond body storage reports OWN0019 at the returned value")
  }
  if which == 1 {
    run Testing.expect(rejectsSpan(&holder, RejectionCode.ExpiredLifetime, text, "held.*", usize.ZERO),
    "an outer holder keeps an inner scope's loan until the first required use")
  }
  if which == 2 {
    run Testing.expect(rejectsSpan(&arm, RejectionCode.ExpiredLifetime, text,
      "match move choice { Choice.Value { value: inner } => &inner }", usize.ZERO),
    "an owned arm binding ends before the match result can retain its loan")
  }
  if which == 3 {
    run Testing.expect(rejectsSpan(&branch, RejectionCode.ExpiredLifetime, text, "&inner", 2),
    "loans of arm-local declarations cannot cross the arm join")
  }
  if which == 4 {
    run Testing.expect(rejectsSpan(&copied, RejectionCode.ExpiredLifetime, text, "held.*", 2),
    "copying a pattern view carries the subject's loans to the outer holder")
  }
  if which == 5 {
    run Testing.expect(rejectsSpan(&failed, RejectionCode.ExpiredLifetime, text, "run attempt()", usize.ZERO),
    "failure cleanup observes an outer holder after its inner referent has ended")
  }
  if which == 6 {
    run Testing.expect(rejectsSpan(&explicit, RejectionCode.ExpiredLifetime, text, "fail Failure.Failed", usize.ONE),
    "an explicit failure replays the same reverse-order storage releases")
  }
  if which == 7 {
    run Testing.expect(hasBorrowStatus(&mutable, BodyBorrowStatus.Checked),
    "local mutable holders and loan-carrying match subjects become Checked with modeled ends")
  }
  if which == 8 {
    run Testing.expect(hasBorrowStatus(&subject, BodyBorrowStatus.Checked),
    "local mutable holders and loan-carrying match subjects become Checked with modeled ends")
  }
  if which == 9 {
    run Testing.expect(hasBorrowStatus(&replaced, BodyBorrowStatus.Checked),
    "a whole replacement releases the overwritten holder's definition before later access")
  }
  if which == 10 {
    run Testing.expect(hasBorrowStatus(&ordered, BodyBorrowStatus.Checked),
    "normal and failure edges release a later observing holder before its referent")
  }
  if which == 11 { run Testing.expect(hasBorrowStatus(&letSubject, BodyBorrowStatus.Checked),
    "destructuring let keeps its subject loans through the enclosing block") }
  if which == 12 { run Testing.expect(rejectsSpan(&letEscape, RejectionCode.ExpiredLifetime, text, "heldLet.*", usize.ZERO),
    "a copied destructuring binding cannot detach the subject loan from inner storage") }
  if which == 13 { run Testing.expect(rejectsSpan(&ifLetEscape, RejectionCode.ExpiredLifetime, text, "heldIf.*", usize.ZERO),
    "if-let ownership ends with the selected arm") }
  if which == 14 { run Testing.expect(rejectsSpan(&breakEscape, RejectionCode.ExpiredLifetime, text, "heldBreak.*", usize.ZERO),
    "break ends each exited scope before an outer holder can use its loan") }
  if which == 15 { run Testing.expect(rejectsSpan(&continueEscape, RejectionCode.ExpiredLifetime, text, "heldContinue.*", usize.ZERO),
    "continue ends the iteration's storage before an outer holder can use its loan") }
  if which == 16 { run Testing.expect(hasBorrowStatus(&loopReset, BodyBorrowStatus.Regions)
      && regionRelationCount(&loopReset) > usize.ZERO,
    "loop-depth assignments release old definitions while their open region relation stays explicit for R3") }
  if which == 17 { run Testing.expect(hasBorrowStatus(&unrelatedCleanup, BodyBorrowStatus.Checked),
    "a hook in an unrelated field observes none of a plain view field's borrowed contents") }
}

// St4: the catalog call consumes all visible loans; opaque retained captures never become Checked.
// Regressions: dropping operands from the walk, treating counted authority as Copy, or admitting
// a delayed drive's unrepresented environment. The wrapper exercises ordinary argument-loan timing.
test effect fn storageSt4ExecutionContracts() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run storageSt4Claims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn storageSt4Claims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("storage-st4.silk")
  let text = """
fn complete(state: i32, value: i32) -> () { return () }
fn suspend(state: i32, execution: Intrinsic.Execution<i32>) -> () { drop execution return () }
fn ready(state: i32) -> () { return () }
effect fn body() -> i32 { return 1 }
fn drive<C: once fn<'static>(i32, i32) -> () + Intrinsic.NonParking,
  S: once fn<'static>(i32, Intrinsic.Execution<i32>) -> () + Intrinsic.NonParking
>(execution: Intrinsic.Execution<i32>, complete: C, suspend: S) -> () {
  run Intrinsic.executionDrive<i32, i32, C, S>(move execution, 1, move complete, move suspend)
}
fn driveMoved<C: once fn<'static>(i32, i32) -> () + Intrinsic.NonParking,
  S: once fn<'static>(i32, Intrinsic.Execution<i32>) -> () + Intrinsic.NonParking
>(execution: Intrinsic.Execution<i32>, complete: C, suspend: S) -> () {
  run Intrinsic.executionDrive<i32, i32, C, S>(move execution, 1, move complete, move suspend)
  drop execution
}
fn driveCallbackMoved<C: once fn<'static>(i32, i32) -> () + Intrinsic.NonParking,
  S: once fn<'static>(i32, Intrinsic.Execution<i32>) -> () + Intrinsic.NonParking
>(execution: Intrinsic.Execution<i32>, complete: C, suspend: S) -> () {
  run Intrinsic.executionDrive<i32, i32, C, S>(move execution, 1, move complete, move suspend)
  drop complete
}
fn driveDelayed<C: once fn<'static>(i32, i32) -> () + Intrinsic.NonParking,
  S: once fn<'static>(i32, Intrinsic.Execution<i32>) -> () + Intrinsic.NonParking
>(execution: Intrinsic.Execution<i32>, complete: C, suspend: S) -> () {
  let delayed = Intrinsic.executionDrive<i32, i32, C, S>(move execution, 1, move complete, move suspend)
  run move delayed
}
fn packaged<F: once Effect<'static; i32> + Intrinsic.Detached,
  R: for<'a> fn<'static>(&'a i32) -> () + Intrinsic.Detached + Intrinsic.NonParking
>(allocation: Intrinsic.Allocation, body: F, ready: R) -> () {
  unsafe { let execution = Intrinsic.executionFromAllocation<i32, F, i32, R>(move allocation, move body, 1, move ready) drop execution }
}
fn packagedMoved<F: once Effect<'static; i32> + Intrinsic.Detached,
  R: for<'a> fn<'static>(&'a i32) -> () + Intrinsic.Detached + Intrinsic.NonParking
>(allocation: Intrinsic.Allocation, body: F, ready: R) -> () {
  unsafe { let execution = Intrinsic.executionFromAllocation<i32, F, i32, R>(move allocation, move body, 1, move ready) drop execution }
  drop body
}
effect fn reads<'x>(value: &'x i32) -> i32 { return value.* }
fn falselyDetached<'x>(value: &'x i32) -> some<F: once Effect<'x; i32> + Intrinsic.Detached> F { return reads(value) }
fn packagedPremise<'x, F: once Effect<'x; i32> + Intrinsic.Detached,
  R: for<'a> fn<'static>(&'a i32) -> () + Intrinsic.Detached + Intrinsic.NonParking
>(allocation: Intrinsic.Allocation, body: F, ready: R) -> () {
  unsafe { let execution = Intrinsic.executionFromAllocation<i32, F, i32, R>(move allocation, move body, 1, move ready) drop execution }
}
fn packagedLoan<'x, F: once Effect<'static; i32> + Intrinsic.Detached,
  R: for<'a> fn<'static>(&'a &'x i32) -> () + Intrinsic.Detached + Intrinsic.NonParking
>(allocation: Intrinsic.Allocation, body: F, state: &'x i32, ready: R) -> () {
  unsafe { let execution = Intrinsic.executionFromAllocation<i32, F, &'x i32, R>(move allocation, move body, state, move ready) drop execution }
}
fn notifyMoved(reference: Intrinsic.ExecutionRef) -> () {
  drop reference
  Intrinsic.executionNotify(&reference)
}
fn current() -> () { let reference = run Intrinsic.executionCurrent() Intrinsic.executionNotify(&reference) }
fn currentMoved() -> () {
  let reference = run Intrinsic.executionCurrent()
  drop reference
  Intrinsic.executionNotify(&reference)
}
fn relinquish() -> () { run Intrinsic.relinquish() }
fn relinquishMoved() -> () {
  let pause = Intrinsic.relinquish()
  run move pause
  run move pause
}
fn notifyLive(input: Intrinsic.ExecutionRef) -> () {
  let mut reference = move input
  let exclusive = &mut reference
  Intrinsic.executionNotify(&reference)
  drop exclusive
}
fn notifyEnded(flag: bool) -> () {
  let outer = run Intrinsic.executionCurrent()
  let mut held = &outer
  if flag {
    let reference = run Intrinsic.executionCurrent()
    held = &reference
  }
  Intrinsic.executionNotify(held)
}
fn completeRef(state: &mut i32, value: i32) -> () { state.* = value }
fn suspendRef(state: &mut i32, execution: Intrinsic.Execution<i32>) -> () { drop execution }
effect fn driveWith<'state, C: once fn(&'state mut i32, i32) -> (),
  S: once fn(&'state mut i32, Intrinsic.Execution<i32>) -> ()>(
  execution: Intrinsic.Execution<i32>, state: &'state mut i32, complete: C, suspend: S
) -> () {
  return run Intrinsic.executionDrive<i32, &'state mut i32, C, S>(move execution, move state, move complete, move suspend)
}
fn choose<C: once fn(&mut i32, i32) -> ()>(seen: i32, callback: C) -> C { return move callback }
effect fn driveLoan(execution: Intrinsic.Execution<i32>, branch: &mut i32) -> () {
  return run driveWith(move execution, &mut branch.*, choose(branch.*, completeRef), suspendRef)
}
effect fn driveLoanEnded(execution: Intrinsic.Execution<i32>, branch: &mut i32) -> i32 {
  run driveWith(move execution, &mut branch.*, completeRef, suspendRef)
  branch.* = 2
  return branch.*
}
fn driveLocalRef<C: once fn<'static>(&mut i32, i32) -> () + Intrinsic.NonParking,
  S: once fn<'static>(&mut i32, Intrinsic.Execution<i32>) -> () + Intrinsic.NonParking
>(execution: Intrinsic.Execution<i32>, complete: C, suspend: S) -> () {
  let mut value = 1
  run Intrinsic.executionDrive<i32, &mut i32, C, S>(move execution, &mut value, move complete, move suspend)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let drive = run Semantic.demandBody(&mut store, &mut request, &id, b"drive")
  let driveMoved = run Semantic.demandBody(&mut store, &mut request, &id, b"driveMoved")
  let driveCallbackMoved = run Semantic.demandBody(&mut store, &mut request, &id, b"driveCallbackMoved")
  let driveDelayed = run Semantic.demandBody(&mut store, &mut request, &id, b"driveDelayed")
  let packaged = run Semantic.demandBody(&mut store, &mut request, &id, b"packaged")
  let packagedMoved = run Semantic.demandBody(&mut store, &mut request, &id, b"packagedMoved")
  let packagedLoan = run Semantic.demandBody(&mut store, &mut request, &id, b"packagedLoan")
  let falselyDetached = run Semantic.demandBody(&mut store, &mut request, &id, b"falselyDetached")
  let packagedPremise = run Semantic.demandBody(&mut store, &mut request, &id, b"packagedPremise")
  let notifyMoved = run Semantic.demandBody(&mut store, &mut request, &id, b"notifyMoved")
  let current = run Semantic.demandBody(&mut store, &mut request, &id, b"current")
  let currentMoved = run Semantic.demandBody(&mut store, &mut request, &id, b"currentMoved")
  let relinquish = run Semantic.demandBody(&mut store, &mut request, &id, b"relinquish")
  let relinquishMoved = run Semantic.demandBody(&mut store, &mut request, &id, b"relinquishMoved")
  let notifyLive = run Semantic.demandBody(&mut store, &mut request, &id, b"notifyLive")
  let notifyEnded = run Semantic.demandBody(&mut store, &mut request, &id, b"notifyEnded")
  let driveWith = run Semantic.demandBody(&mut store, &mut request, &id, b"driveWith")
  let driveLoan = run Semantic.demandBody(&mut store, &mut request, &id, b"driveLoan")
  let driveLoanEnded = run Semantic.demandBody(&mut store, &mut request, &id, b"driveLoanEnded")
  let driveLocalRef = run Semantic.demandBody(&mut store, &mut request, &id, b"driveLocalRef")
  run Testing.expect(hasBorrowStatus(&drive, BodyBorrowStatus.Checked),
    "an immediate drive checks its catalog call")
  run Testing.expect(rejectsSpan(&driveMoved, RejectionCode.UseAfterMove, text, "drop execution", usize.ONE),
    "drive consumes its Execution (bootstrap OWN0001)")
  run Testing.expect(rejectsSpan(&driveCallbackMoved, RejectionCode.UseAfterMove, text, "drop complete", usize.ZERO),
    "drive consumes its completion callback (bootstrap OWN0001)")
  run Testing.expect(hasBorrowStatus(&driveDelayed, BodyBorrowStatus.StoredLoans),
    "a stored drive stays unchecked even when later run: its capture environment is unrepresented")
  run Testing.expect(!hasBorrowStatus(&packaged, BodyBorrowStatus.StoredLoans) && succeeded(&packaged),
    "a package consumes its detached inputs and retains no loan of its constructor (EXEC-004)")
  run Testing.expect(rejectsSpan(&packagedMoved, RejectionCode.UseAfterMove, text, "drop body", usize.ZERO),
    "a package consumes its body (bootstrap OWN0001)")
  run Testing.expect(rejectsWith(&packagedLoan, RejectionCode.UnsatisfiedExecutableProperty),
    "a package's readiness state must be detached, even at the unsafe intrinsic (EXEC-004, SEM0139)")
  run Testing.expect(rejectsWith(&falselyDetached, RejectionCode.UnsatisfiedExecutableProperty) && succeeded(&packagedPremise),
    "an opaque Effect proves its Detached promise where it is produced, and a Detached premise holds whatever its bound's environment")
  run Testing.expect(rejectsSpan(&notifyMoved, RejectionCode.UseAfterMove, text, "&reference", usize.ZERO),
    "notification cannot borrow moved counted authority (bootstrap OWN0001)")
  run Testing.expect(hasBorrowStatus(&current, BodyBorrowStatus.Checked),
    "current creates counted authority without caller capture loans")
  run Testing.expect(rejectsSpan(&currentMoved, RejectionCode.UseAfterMove, text, "&reference", 2),
    "current authority stays affine (bootstrap OWN0001)")
  run Testing.expect(hasBorrowStatus(&relinquish, BodyBorrowStatus.Checked),
    "an immediate relinquish creates no operand loan")
  run Testing.expect(rejectsSpan(&relinquishMoved, RejectionCode.UseAfterMove, text, "move pause", usize.ONE),
    "relinquish is a take-once Effect (bootstrap OWN0001)")
  run Testing.expect(rejectsSpan(&notifyLive, RejectionCode.LoanConflict, text, "&reference", 3),
    "notify holds its shared operand loan against a live exclusive loan (bootstrap OWN0010)")
  run Testing.expect(rejectsSpan(&notifyEnded, RejectionCode.ExpiredLifetime, text, "held", 2),
    "notify cannot use an authority view after local storage ends (bootstrap OWN0019)")
  run Testing.expect(hasBorrowStatus(&driveWith, BodyBorrowStatus.Checked),
    "a direct immediate drive with a named reference state checks its catalog contract")
  run Testing.expect(rejectsSpan(&driveLoan, RejectionCode.AccessDuringLoan, text, "branch.*", usize.ONE),
    "the wrapper call holds its branch-state loan through later argument evaluation")
  run Testing.expect(hasBorrowStatus(&driveLoanEnded, BodyBorrowStatus.Checked)
      && regionRelationCount(&driveLoanEnded) == usize.ZERO,
    "the wrapper call's parameter reborrow is proved and released before later replacement")
  run Testing.expect(rejectsWith(&driveLocalRef, RejectionCode.BodyLifetimeElisionUnavailable),
    "a local reference state cannot yet reach direct drive borrow analysis without a named lifetime")
}


test effect fn declaredRegionBoundsAndStaticInference() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run declaredRegionBoundaryClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn declaredRegionBoundaryClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("declared-region-boundaries.silk")
  let text = """
fn needs<'a: 'b, 'b>(first: &'a i32, second: &'b i32) -> i32 { return first.* + second.* }
fn transitive<'a: 'b, 'b: 'c, 'c>(first: &'a i32, second: &'c i32) -> i32 { return needs<'a, 'c>(first, second) }
fn unrelated<'a, 'b>(first: &'a i32, second: &'b i32) -> i32 { return needs<'a, 'b>(first, second) }
fn needsStatic<'a: 'static>(value: &'a i32) -> i32 { return value.* }
fn staticPremise<'a: 'static>(value: &'a i32) -> i32 { return needsStatic<'a>(value) }
fn missingStatic<'a>(value: &'a i32) -> i32 { return needsStatic<'a>(value) }
fn pickString<'a>(first: string<'a>, second: string<'a>) -> string<'a> { return second }
fn inferredString<'a>(value: string<'a>) -> string<'a> { return pickString("static", value) }
fn pick<'a>(first: string<'a>, second: &'a [u8]) -> &'a [u8] { return second }
fn inferred<'a>(value: &'a [u8]) -> &'a [u8] { let selected = pick("static", value) return selected }
effect fn initial() -> i32 { return 1 }
effect fn field<'env, T, E, ?R>(self: once Effect<'env; i32 ! E ? R>, key: string<'env>, value: &'env T) -> i32 ! E ? R {
  return run move self
}
effect fn chained<'a>(value: &'a i32) -> i32 {
  return run initial() |> field("first", value) |> field("second", value)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let transitive = run Semantic.demandBody(&mut store, &mut request, &id, b"transitive")
  let unrelated = run Semantic.demandBody(&mut store, &mut request, &id, b"unrelated")
  let staticPremise = run Semantic.demandBody(&mut store, &mut request, &id, b"staticPremise")
  let missingStatic = run Semantic.demandBody(&mut store, &mut request, &id, b"missingStatic")
  let inferredString = run Semantic.demandBody(&mut store, &mut request, &id, b"inferredString")
  let inferred = run Semantic.demandBody(&mut store, &mut request, &id, b"inferred")
  let chained = run Semantic.demandBody(&mut store, &mut request, &id, b"chained")
  run Testing.expect(succeeded(&transitive), "declared outlives bounds compose transitively")
  run Testing.expect(rejectsSpan(&unrelated, RejectionCode.UnsatisfiedLifetimeBound, text, "needs<'a, 'b>(first, second)", usize.ZERO),
    "unrelated declared lifetimes fail SEM0212 at the call")
  run Testing.expect(succeeded(&staticPremise), "a declared static bound supplies the required premise")
  run Testing.expect(rejectsSpan(&missingStatic, RejectionCode.UnsatisfiedLifetimeBound, text, "needsStatic<'a>(value)", usize.ONE),
    "missing static premises fail SEM0212 at the call")
  run Testing.expect(succeeded(&inferredString), "string inference continues to shorten covariantly")
  run Testing.expect(hasBorrowStatus(&inferred, BodyBorrowStatus.Checked),
    "inferred static evidence shortens to the caller region and its finalized goal is proved")
  run Testing.expect(succeeded(&chained), "staged Effect inference preserves its valid caller-region evidence")
  return ()
}

test effect fn localRegionWorklistChecksParameterReborrows() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run localRegionWorklistClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn localRegionWorklistClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("local-region-worklist.silk")
  let text = """
fn read<'a>(value: &'a i32) -> i32 { return value.* }
fn needs<'a: 'b, 'b>(first: &'a i32, second: &'b i32) -> i32 { return first.* + second.* }
fn bounded() -> i32 {
  let first = 1
  let view = &first
  let second = 2
  return needs(view, &second)
}
fn increment<'a>(value: &'a mut i32) -> () { value.* = value.* + 1 }
fn shared<'a>(source: &'a i32) -> i32 { return read(&source.*) }
fn exclusive<'a>(source: &'a mut i32) -> i32 { increment(&mut source.*) return source.* }
fn arms<'a>(source: &'a i32, left: bool) -> i32 {
  if left { return read(&source.*) }
  return read(&source.*)
}
fn repeated<'a>(source: &'a mut i32, count: i32) -> i32 {
  let mut at = 0
  while at < count { increment(&mut source.*) at = at + 1 }
  return source.*
}
fn choose<'a>(left: &'a i32, right: &'a i32) -> &'a i32 { return left }
fn approximate<'a>(source: &'a i32) -> i32 {
  let local = 1
  return choose(&source.*, &local).*
}
fn crossed<'a>(source: &'a i32) -> &'a i32 { return &source.* }
fn expired<'a>(source: &'a i32) -> &'a i32 { let inner = 1 return &inner }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let shared = run Semantic.demandBody(&mut store, &mut request, &id, b"shared")
  let exclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusive")
  let arms = run Semantic.demandBody(&mut store, &mut request, &id, b"arms")
  let repeated = run Semantic.demandBody(&mut store, &mut request, &id, b"repeated")
  let approximate = run Semantic.demandBody(&mut store, &mut request, &id, b"approximate")
  let crossed = run Semantic.demandBody(&mut store, &mut request, &id, b"crossed")
  let expired = run Semantic.demandBody(&mut store, &mut request, &id, b"expired")
  let bounded = run Semantic.demandBody(&mut store, &mut request, &id, b"bounded")
  let boundedMir = run Semantic.demandMir(&mut store, &mut request, &id, b"bounded")
  run Testing.expect(hasBorrowStatus(&bounded, BodyBorrowStatus.Checked) && succeeded(&boundedMir),
    "a proved local outlives requirement still satisfies the callee's declared bound at lowering")
  run Testing.expect(hasBorrowStatus(&shared, BodyBorrowStatus.Checked), "a shared parameter covers its authenticated local reborrow points")
  run Testing.expect(hasBorrowStatus(&exclusive, BodyBorrowStatus.Checked), "an exclusive parameter covers its local call reborrow")
  run Testing.expect(hasBorrowStatus(&arms, BodyBorrowStatus.Checked), "sibling arms use their actual Walker edges")
  run Testing.expect(hasBorrowStatus(&repeated, BodyBorrowStatus.Checked), "the loop's reborrow is recreated on its back edge")
  run Testing.expect(hasBorrowStatus(&approximate, BodyBorrowStatus.Checked), "every possible source covers this finite use before the local storage ends")
  run Testing.expect(hasBorrowStatus(&crossed, BodyBorrowStatus.Checked), "a crossed reborrow retaining its exact parent lifetime has a closed boundary proof")
  run Testing.expect(rejectsSpan(&expired, RejectionCode.ExpiredLifetime, text, "&inner", usize.ZERO),
    "a local cannot gain its caller's lifetime through the new proof (OWN0019)")
  return ()
}

test effect fn closedRegionAtomsAcceptEnclosingUniversals() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
