  let c13 = run Semantic.demandBody(&mut store, &mut request, &id, b"c13")
  let c17 = run Semantic.demandBody(&mut store, &mut request, &id, b"c17")
  let c12b = run Semantic.demandBody(&mut store, &mut request, &id, b"c12b")
  run Testing.expect(rejectsSpan(&c04, RejectionCode.AccessDuringLoan, text, "src.t", 33)
