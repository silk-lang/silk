  let elementBothKeep = run Semantic.demandBody(&mut store, &mut request, &id, b"elementBothKeep") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let projectedTemporaryEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"projectedTemporaryEscape") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let projectedRegionsEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"projectedRegionsEscape") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let projectedOwnTemporary = run Semantic.demandBody(&mut store, &mut request, &id, b"projectedOwnTemporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let projectedOwnReferenceTemporary = run Semantic.demandBody(&mut store, &mut request, &id, b"projectedOwnReferenceTemporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let callPayloadEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"callPayloadEscape") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let callFieldEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"callFieldEscape") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let callFieldKeep = run Semantic.demandBody(&mut store, &mut request, &id, b"callFieldKeep") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&temporary, fn(answer: &Result<Answer, NoRejection>) -> bool { return answerBorrowsArrayTemporary(answer, Access.Shared) }),
    "a borrowed array literal is a caller-local hidden owner")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&mutableTemporary, fn(answer: &Result<Answer, NoRejection>) -> bool { return answerBorrowsArrayTemporary(answer, Access.Mutable) }),
    "a mutable loan of a borrowed array literal needs no named mutable owner")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&narrowTemporary, bodyAnswerIsTyped),
    "a borrowed array literal infers its elements from the slice parameter")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&localTemporary, bodyAnswerIsTyped),
    "a local view keeps its borrowed array literal owner")
  run Testing.expect(rejectsSpan(&leakTemporary, RejectionCode.UnsatisfiedLifetimeBound, text, "&[42]", usize.ZERO),
    "a temporary-derived view cannot escape its owner: SEM0212 at the borrow, as for a returned local")
  run Testing.expect(rejectsSpan(&escapeRecord, RejectionCode.UnsatisfiedLifetimeBound, text, "&escaping", usize.ZERO)
      && rejectsSpan(&escapeBound, RejectionCode.UnsatisfiedLifetimeBound, text, "&bound", usize.ZERO)
      && rejectsSpan(&escapeNested, RejectionCode.UnsatisfiedLifetimeBound, text, "&nestedOwner", usize.ZERO)
      && rejectsSpan(&escapeParameter, RejectionCode.UnsatisfiedLifetimeBound, text, "&owned", usize.ZERO),
    "a loan of body storage in a struct literal typed with caller regions cannot outlive them (SEM0212 at the borrow)")
  run Testing.expect(rejectsSpan(&storeRecord, RejectionCode.UnsatisfiedLifetimeBound, text, "&storedOwner", usize.ZERO)
      && rejectsSpan(&storeBound, RejectionCode.UnsatisfiedLifetimeBound, text, "&boundOwner", usize.ZERO),
    "a loan of body storage stored behind a reference typed at a caller region cannot outlive it (SEM0212 at the borrow)")
  run Testing.expect(hasBorrowStatus(&keepRead, BodyBorrowStatus.Checked) && hasBorrowStatus(&keepField, BodyBorrowStatus.Checked) && hasBorrowStatus(&keepElement, BodyBorrowStatus.Checked) && hasBorrowStatus(&keepCouple, BodyBorrowStatus.Checked) && hasBorrowStatus(&keepReplaced, BodyBorrowStatus.Checked),
    "a value read out through a borrow of a local holds what it read, never the borrow of the local, so these stay Checked")
  run Testing.expect(rejectsSpan(&fieldEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&fieldOwner", 0)
      && rejectsSpan(&typedFieldEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&typedOwner", 0)
      && rejectsSpan(&referentFieldEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&referentOwner", 0)
      && rejectsSpan(&borrowedFieldEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&borrowedOwner", 0)
      && rejectsSpan(&doubleEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&doubleOwner", 0)
      && rejectsSpan(&nestedFieldEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&nestedFieldOwner", 0)
      && rejectsSpan(&payloadEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&payloadOwner", 0),
    "a value read where a loan of body storage is held, directly, through a reference to its holder or out of a union-typed field, carries that loan to the caller region it is returned at (SEM0212 at the borrow)")
  run Testing.expect(hasBorrowStatus(&keepPayload, BodyBorrowStatus.Checked) && hasBorrowStatus(&keepCount, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&keepOtherField, BodyBorrowStatus.Checked),
    "a read of a field that holds no loan of body storage, even beside one that does or through a reference, stays Checked")
  run Testing.expect(rejectsSpan(&storedFieldEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&storedFieldOwner", 0),
    "a loan of body storage stored into a field of a local returned at a caller region cannot outlive it (SEM0212 at the borrow)")
  run Testing.expect(rejectsSpan(&restoredField, RejectionCode.ExpiredLifetime, text, "restoredOut.left.value", 0)
      && rejectsSpan(&restoredLoop, RejectionCode.ExpiredLifetime, text, "loopOut.left.value", 1)
      && rejectsSpan(&otherFieldRead, RejectionCode.ExpiredLifetime, text, "countOut.count", 0)
      && rejectsSpan(&replacedOtherField, RejectionCode.ExpiredLifetime, text, "wholeOut.count", 0)
      && rejectsSpan(&throughOtherField, RejectionCode.ExpiredLifetime, text, "pairOut.l.value", 0),
    "a holder's one region keeps every loan a field held, overwritten or not, while any field is read later (OWN0019, #2022)")
  run Testing.expect(rejectsSpan(&storedFieldExpires, RejectionCode.ExpiredLifetime, text, "expiresOut.left.value", 0)
      && rejectsSpan(&throughFieldExpires, RejectionCode.ExpiredLifetime, text, "crossOut.r.value", 0)
      && rejectsSpan(&loopFieldExpires, RejectionCode.ExpiredLifetime, text, "earlierOut.left.value", 0),
    "a field still holding a loan of expired storage is reported at its first read, around a loop's back edge too (OWN0019)")
  run Testing.expect(rejectsSpan(&copiedFieldExpires, RejectionCode.ExpiredLifetime, text, "copiedOut.left", 2)
      && rejectsSpan(&overwrittenFieldEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&overwrittenOwner", 0),
    "a value read from an overwritten field still carries every loan the field held: it expires at the read (OWN0019) or cannot outlive the caller region it is returned at (SEM0212)")
  run Testing.expect(hasBorrowStatus(&reboundEachIteration, BodyBorrowStatus.Checked)
      && Shared<Result<Answer, NoRejection>>.with<bool>(&matchedEachIteration, bodyAnswerIsTyped),
    "a holder bound again each iteration holds no loan of storage that has ended")
  run Testing.expect(rejectsSpan(&copiedAfterRestore, RejectionCode.ExpiredLifetime, text, "restoreCopy.value", 0)
      && rejectsSpan(&rebuiltAfterRestore, RejectionCode.ExpiredLifetime, text, "rebuilt.left.value", 0)
      && rejectsSpan(&storedEachIteration, RejectionCode.ExpiredLifetime, text, "storedOut.left.value", 2)
      && rejectsSpan(&matchedStoredEachIteration, RejectionCode.ExpiredLifetime, text, "matchedStoreOut.left.value", 1),
    "a copy taken after an overwrite, or a holder stored into again each iteration, still carries its one region's earlier loans (OWN0019, #2022)")
  run Testing.expect(rejectsSpan(&ifLetPayloadEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&ifLetOwner", 0)
      && rejectsSpan(&matchPayloadEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&matchOwner", 0)
      && rejectsSpan(&destructureEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&splitOwner", 0),
    "a binding of a moved subject holds the loan its payload or field holds, which cannot outlive the caller region it is returned at (SEM0212 at the borrow)")
  run Testing.expect(hasBorrowStatus(&ifLetPayloadKeep, BodyBorrowStatus.Checked) && hasBorrowStatus(&destructureKeep, BodyBorrowStatus.Checked),
    "a binding of a payload or field that holds no loan of body storage, even beside one that does, stays Checked")
  run Testing.expect(rejectsSpan(&elementOtherEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&elementOwner", usize.ZERO)
      && hasBorrowStatus(&elementBothKeep, BodyBorrowStatus.Checked),
    "an aggregate of several loans of body storage holds each in its element region: a returned element still holding one cannot outlive the caller (SEM0212), and reading both in the body stays Checked")
  run Testing.expect(rejectsSpan(&projectedTemporaryEscape, RejectionCode.ExpiredLifetime, text, "projected.value", usize.ZERO),
    "a literal whose fields share one declared region keeps a sibling temporary's loan in the selected field (OWN0019, #2022)")
  run Testing.expect(hasBorrowStatus(&projectedRegionsEscape, BodyBorrowStatus.Checked),
    "a literal's selected field excludes a sibling temporary when its fields name distinct regions")
  run Testing.expect(rejectsSpan(&projectedOwnReferenceTemporary, RejectionCode.ExpiredLifetime, text, "ownRef.value", usize.ZERO),
    "selecting the reference field that actually borrows the temporary still expires (OWN0019)")
  run Testing.expect(rejectsSpan(&projectedOwnTemporary, RejectionCode.ExpiredLifetime, text, "own[0]", usize.ZERO),
    "a projected field that borrows a temporary array expires before its later use (OWN0019)")
  run Testing.expect(rejectsSpan(&callPayloadEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&callOwner", usize.ZERO)
      && rejectsSpan(&callFieldEscape, RejectionCode.UnsatisfiedLifetimeBound, text, "&callFieldOwner", usize.ZERO)
      && hasBorrowStatus(&callFieldKeep, BodyBorrowStatus.Checked),
    "a returned payload or result field holding a loan of body storage is refuted at its borrow (SEM0212), and the unrelated sibling stays Checked")
  run Testing.expect(hasBorrowStatus(&forwardRecord, BodyBorrowStatus.Checked) && hasBorrowStatus(&readTwice, BodyBorrowStatus.Checked),
    "a literal of caller loans, and a call result in a caller region, hold no loan of the body storage lent to the call")
  let temporaryMirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"temporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let temporaryMirIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&temporaryMirAnswer, selectedMirIndex)
  let mut temporaryPlace = false
  if let Option<usize>.Some {value: index} = move temporaryMirIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) { temporaryPlace = mirLoansTemporary(function, true) }
  }
  let scalarMirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"scalarTemporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let scalarMirIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&scalarMirAnswer, selectedMirIndex)
  let mut scalarPlace = false
  if let Option<usize>.Some {value: index} = move scalarMirIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) { scalarPlace = mirLoansTemporary(function, false) }
  }
  run Testing.expect(temporaryPlace && scalarPlace,
    "MIR loans the whole compiler temporary holding the evaluated array literal or the materialized scalar literal")
  let droppedMirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"droppedTemporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(glueFact(&store, &droppedMirAnswer, usize.ZERO) == usize.ONE && glueFact(&store, &droppedMirAnswer, 7) == usize.ONE,
    "a borrowed array literal whose elements need cleanup is dropped once, after the call that borrows it")
  run Testing.expect(hasBorrowStatus(&distinctRegions, BodyBorrowStatus.Checked)
    && rejectsSpan(&wrongRegionElement, RejectionCode.TypeMismatch, text, "pairViews(&second, held)", usize.ONE),
    "the worklist proves distinct caller-local slice regions while incompatible elements keep their diagnostic")
  let distinctMir = run Semantic.demandMir(&mut store, &mut request, &id, b"distinctRegions")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&distinctMir),
    "a proved caller-local slice relation remains valid when its call is lowered")
  run Testing.expect(hasBorrowStatus(&fixedRegions, BodyBorrowStatus.Checked),
    "two declared regions meet a repeated shared-slice binder at their complete meet, which the region check proves")
  run Testing.expect(rejectsSpan(&widened, RejectionCode.UnsatisfiedLifetimeBound, text, "&view", usize.ZERO)
    && rejectsSpan(&leakedArray, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", usize.ZERO)
    && rejectsSpan(&widenedLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&viewLocal", usize.ZERO)
    && rejectsSpan(&leakedArrayLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&localArray", usize.ZERO),
    "fixed static return and initializer contexts cannot widen slice reborrows or owned array loans: SEM0212 at the borrow")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&keptSlice, bodyAnswerIsTyped)
    && Shared<Result<Answer, NoRejection>>.with<bool>(&keptArray, bodyAnswerIsTyped)
    && Shared<Result<Answer, NoRejection>>.with<bool>(&keptStatic, bodyAnswerIsTyped)
    && Shared<Result<Answer, NoRejection>>.with<bool>(&keptStaticCall, bodyAnswerIsTyped)
    && Shared<Result<Answer, NoRejection>>.with<bool>(&keptArrayCall, bodyAnswerIsTyped)
    && Shared<Result<Answer, NoRejection>>.with<bool>(&mutableArrayCall, bodyAnswerIsTyped)
    && Shared<Result<Answer, NoRejection>>.with<bool>(&keptInitializer, bodyAnswerIsTyped),
    "slice reborrows and array-reference conversion retain the actual same-region evidence")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&keptArray, fn(answer: &Result<Answer, NoRejection>) -> bool { return answerRetainsArrayReferenceConversion(answer, Access.Shared) })
    && Shared<Result<Answer, NoRejection>>.with<bool>(&keptArrayCall, fn(answer: &Result<Answer, NoRejection>) -> bool { return answerRetainsArrayReferenceConversion(answer, Access.Shared) })
    && Shared<Result<Answer, NoRejection>>.with<bool>(&mutableArrayCall, fn(answer: &Result<Answer, NoRejection>) -> bool { return answerRetainsArrayReferenceConversion(answer, Access.Mutable) }),
    "array-reference returns and calls convert a fixed referent through its checked dereference and loan")
  run Testing.expect(rejectsSpan(&invalidArrayReborrow, RejectionCode.InvalidReborrow, text, "&mut source", usize.ONE),
    "slice shape hints cannot strengthen shared array-reference access (SEM0058)")
  run Testing.expect(rejectsSpan(&sliceElement, RejectionCode.TypeMismatch, text, "shared(&flags)", 0) &&
    rejectsSpan(&sliceAccess, RejectionCode.TypeMismatch, text, "exclusive(&values)", 0) &&
    rejectsSpan(&sliceLifetime, RejectionCode.UnsatisfiedLifetimeBound, text, "&values", 2),
    "slice conversion separates element/access mismatches from a fixed lifetime requirement at its operand")
  // A rigid static reference demand is diagnosed at the supplied source after inference
  // and subtyping have exhausted their valid shorter alternatives.
  run Testing.expect(rejectsSpan(&referenceLifetime, RejectionCode.UnsatisfiedLifetimeBound, text, "&held", usize.ZERO),
    "a reference argument must prove its fixed lifetime requirement at the operand")
  // The bootstrap reports the two SEM0212 returns at the function header.
  run Testing.expect(rejectsWith(&parameterViews, RejectionCode.UnsatisfiedLifetimeBound)
    && rejectsWith(&mixedViews, RejectionCode.UnsatisfiedLifetimeBound),
    "a returned call view whose region an external referent shares is an unproven relation (SEM0212), even beside a local loan")
  run Testing.expect(rejectsSpan(&ownedViews, RejectionCode.UnsatisfiedLifetimeBound, text, "&one", usize.ZERO),
    "a returned call view whose sources are all owned locals cannot outlive them: SEM0212 at the first borrow")
  return ()
}

test effect fn sliceDescriptorsRetainLayoutBoundsAndAbi() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("slice-descriptors.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
fn shared(values: &[i32]) -> i32 { return values[0] }
fn exclusive(values: &mut [i32]) -> i32 { return shared(&values) }
fn replacement() -> i32 { return 20 }
fn forward(values: &mut [i32], index: usize) -> i32 {
  values[index] = replacement()
  if values.length == 2 { return exclusive(&mut values) + values[1] }
  return 0
}
pub fn main() -> i32 { let mut values = [0, 22] return forward(&mut values, 0) }
"""
  let mut store = run applicationSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let mainBody = run Semantic.demandBody(&mut store, &mut request, &id, b"main") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&mainBody, checkedBody)
  let mut descriptorLayout = false
  if let Option<Shared<TypedBody>>.Some {value: body} = move selectedBody {
    let descriptor = Shared<TypedBody>.with<Option<Shared<Type>>>(&body, arraySliceType)
    if let Option<Shared<Type>>.Some {value: ty} = move descriptor {
      let demanded = run Semantic.demandLayout(&mut store, &mut request, &id, &ty) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
      let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&demanded, arrayLayoutIndex)
      if let Option<usize>.Some {value: index} = move selected {
        if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
          descriptorLayout = Shared<BackendLayout>.with<bool>(&facts, fn(layout: &BackendLayout) -> bool {
            if let LayoutStorage.Slice {stride, lengthOffset, ..} = &layout.storage {
              return layout.size == 16 && layout.alignment == 8 && layout.abi == LayoutAbi.Indirect
                && stride == 4 && lengthOffset == 8 && BackendLayout.childCount(layout) == usize.ONE
                && BackendLayout.fieldCount(layout) == usize.ZERO
            }
            return false
          })
        }
      }
    }
  }
  run Testing.expect(descriptorLayout, "runtime slices demand two neutral words and one borrowed element layout")
  let sliceMirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"forward") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let sliceMirIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&sliceMirAnswer, selectedMirIndex)
  let mut runtimeBounds = false
  let mut boundsBeforeReplacement = false
  if let Option<usize>.Some {value: index} = move sliceMirIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = List<MirBlock>.asSlice(&function.blocks)
      let mut blockAt = usize.ZERO
      while blockAt < blocks.length {
        if let MirTerminator.Branch {thenBlock, elseBlock, ..} = &blocks[blockAt].terminator {
          if let MirTerminator.Trap {..} = &blocks[elseBlock].terminator {
            if let MirTerminator.Call {..} = &blocks[thenBlock].terminator { boundsBeforeReplacement = true }
            let statements = List<MirStatement>.asSlice(&blocks[blockAt].statements)
            let mut statementAt = usize.ZERO
            while statementAt < statements.length {
              if let MirStatement.Assign {value: MirRvalue.SliceLength {..}, ..} = &statements[statementAt] { runtimeBounds = true }
              statementAt = statementAt + usize.ONE
            }
          }
        }
        blockAt = blockAt + usize.ONE
      }
    }
  }
  run Testing.expect(runtimeBounds && boundsBeforeReplacement,
    "slice bounds read runtime length before the replacement call can run")
  let unitElement = run Types.intern(Type.Unit) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let staticRegion = run Shared<Lifetime>.make(Lifetime.Static) |> Effect.provideMut<Allocator>(&mut allocator)
  let emptySliceType = run Types.intern(Type.Slice {
    element: move unitElement, access: Access.Shared, lifetime: move staticRegion,
  }) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let zeroLayoutAnswer = run Semantic.demandLayout(&mut store, &mut request, &id, &emptySliceType) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let zeroLayoutIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&zeroLayoutAnswer, arrayLayoutIndex)
  let mut zeroStride = false
  if let Option<usize>.Some {value: index} = move zeroLayoutIndex {
    if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
      zeroStride = Shared<BackendLayout>.with<bool>(&facts, fn(layout: &BackendLayout) -> bool {
        if let LayoutStorage.Slice {stride, lengthOffset, ..} = &layout.storage {
          return layout.size == 16 && stride == usize.ZERO && lengthOffset == 8
        }
        return false
      })
    }
  }
  run Testing.expect(zeroStride, "zero-size elements retain a runtime logical length independently of their zero stride")
  let sliceBuild = run buildApplication(&mut store, &mut request, staticClosureNodes) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut descriptorAbi = false
  if let BackendBuild.Module {text: llvm, ..} = &sliceBuild {
    let ir = Bytes.asSlice(&llvm)
    descriptorAbi = containsIr(ir, b"ptr noalias %p0") && !containsIr(ir, b"%l1, ptr %p0, i64 16, i1 false)")
      && containsIrLine(ir, b"getelementptr i8", b", i64 8")
      && containsIr(ir, b"store i64 2") && containsIr(ir, b"icmp ult i64")
      && containsIr(ir, b"call void @llvm.trap()")
  }
  run Testing.expect(descriptorAbi, "array conversion, forwarding and shared reborrow use owned descriptor slots and runtime bounds")
  return ()
}

// Whether MIR builds one descriptor from static storage holding exactly `bytes`.
fn buildsStaticDescriptor(function: &MirFunction, bytes: &[u8]) -> bool {
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  let mut blockAt = usize.ZERO
  while blockAt < blocks.length {
    let statements = List<MirStatement>.asSlice(&blocks[blockAt].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Assign {value: MirRvalue.Slice {data: MirOperand.StaticBytes {bytes: stored}, count}, ..} = &statements[at] {
        if let MirOperand.Integer {decimal, negative, ty} = &count {
          if !negative && Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool { return witnessPrimitive(value, b"usize") })
            && decimalEqualsUsize(Bytes.asSlice(&decimal), bytes.length) && sameBytes(Bytes.asSlice(&stored), bytes) { return true }
        }
      }
      at = at + usize.ONE
    }
    blockAt = blockAt + usize.ONE
  }
  return false
}

effect fn conversionControl(key: &InstanceKey, value: MirOperand, target: &Shared<Type>, parameters: List<Shared<Type>>) -> MirFunction
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let empty = List<InstanceKey>.make()
  let mut function = run recipeControlMir(key, List<InstanceKey>.asSlice(&empty), Option<bool>.none(), true)
  let integer = run specializationPrimitive(b"i32")
  let origin = BodyOrigin {node: usize.ZERO, location: Location.make(usize.ZERO, usize.ONE)}
  function.result = Shared<Type>.clone(&integer)
  function.locals = List<MirLocal>.make()
  run List<MirLocal>.append(&mut function.locals, MirLocal {ty: move integer, kind: MirLocalKind.Return, origin: origin})
  let listed = List<Shared<Type>>.asSlice(&parameters)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<MirLocal>.append(&mut function.locals, MirLocal {ty: Shared<Type>.clone(&listed[at]), kind: MirLocalKind.Parameter {index: at}, origin: origin})
    at = at + usize.ONE
  }
  function.parameters = move parameters
  let mut statements = List<MirStatement>.make()
  run List<MirStatement>.append(&mut statements, MirStatement.Assign {
    destination: MirPlace {local: usize.ZERO, projections: List<MirProjection>.make()},
    value: MirRvalue.Convert {value: move value, ty: Shared<Type>.clone(target)}, origin: origin})
  function.blocks = List<MirBlock>.make()
  run List<MirBlock>.append(&mut function.blocks, MirBlock {statements: move statements, terminator: MirTerminator.Return {origin: origin}})
  return move function
}

effect fn conversionRejects(key: &InstanceKey, source: MirOperand, target: &Shared<Type>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let function = run conversionControl(key, move source, target, List<Shared<Type>>.make())
  let machine = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let layouts = run scalarControlLayouts(&function, &machine)
  let foreign = List<CAbi.Signature>.make()
  let result = run Effect.result(emitClosedMir(&function, &machine, List<TypeLayout>.asSlice(&layouts), List<CAbi.Signature>.asSlice(&foreign)))
  return match &result {
    Result<Bytes, BackendGap | OutOfMemoryError>.Failure {error} => match &error {
      BackendGap {code, source: gapSource, ..} => code == GapCode.TypedForm && match &gapSource {
        GapSource.Relative {location, ..} => location.start == usize.ZERO && location.end == usize.ONE
        _ => false
      }
      _ => false
    }
    _ => false
  }
}

test effect fn numericConversionValidatesCategoriesAndRanges() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run numericConversionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn numericConversionClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("numeric-conversion.silk")
  let key = run recipeControlKey(&id, b"convert", false)
  let machine = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let integer = run specializationPrimitive(b"i32")
  let unsigned = run specializationPrimitive(b"u32")
  let byte = run specializationPrimitive(b"u8")
  let function = run conversionControl(&key, run typedInteger(b"u8", b"255"), &integer, List<Shared<Type>>.make())
  let other = run conversionControl(&key, run typedInteger(b"u8", b"255"), &unsigned, List<Shared<Type>>.make())
  let lower = run conversionControl(&key, run typedInteger(b"u8", b"5"), &integer, List<Shared<Type>>.make())
  let firstRecipe = run InstanceRecipe.make(&function)
  let otherRecipe = run InstanceRecipe.make(&other)
  let lowerRecipe = run InstanceRecipe.make(&lower)
  run Testing.expect(!sameBytes(Bytes.asSlice(&firstRecipe.shape), Bytes.asSlice(&otherRecipe.shape))
    && !sameBytes(Bytes.asSlice(&firstRecipe.shape), Bytes.asSlice(&lowerRecipe.shape)),
    "conversion recipes retain both the operand identity and the destination type")
  let foreign = List<CAbi.Signature>.make()
  let mut cases = List<MirOperand>.make()
  let mut targets = List<Shared<Type>>.make()
  let mut expected = List<Bytes>.make()
  run List<MirOperand>.append(&mut cases, run typedInteger(b"u8", b"255"))
  run List<Shared<Type>>.append(&mut targets, Shared<Type>.clone(&integer))
  run List<Bytes>.append(&mut expected, run Bytes.copy(b" = zext i8 -1 to i32\n"))
  run List<MirOperand>.append(&mut cases, run typedInteger(b"i8", b"1"))
  run List<Shared<Type>>.append(&mut targets, Shared<Type>.clone(&integer))
  run List<Bytes>.append(&mut expected, run Bytes.copy(b" = sext i8 1 to i32\n"))
  run List<MirOperand>.append(&mut cases, run typedInteger(b"u16", b"300"))
  run List<Shared<Type>>.append(&mut targets, Shared<Type>.clone(&byte))
  run List<Bytes>.append(&mut expected, run Bytes.copy(b" = icmp ugt i16 300, 255\n"))
  run List<MirOperand>.append(&mut cases, run typedInteger(b"i32", b"7"))
  run List<Shared<Type>>.append(&mut targets, Shared<Type>.clone(&unsigned))
  run List<Bytes>.append(&mut expected, run Bytes.copy(b" = icmp slt i32 7, 0\n"))
  // 2.5 as f64; the low bound is -(2^31 + 1) and the high bound 2^31, both exact.
  run List<MirOperand>.append(&mut cases, MirOperand.Float {bits: 4612811918334230528, ty: run specializationPrimitive(b"f64")})
  run List<Shared<Type>>.append(&mut targets, Shared<Type>.clone(&integer))
  run List<Bytes>.append(&mut expected, run Bytes.copy(b" = fcmp ule double 0x4004000000000000, 0xC1E0000000200000\n"))
  let destinations = List<Shared<Type>>.asSlice(&targets)
  let fragments = List<Bytes>.asSlice(&expected)
  let mut at = usize.ZERO
  while List<MirOperand>.length(&cases) != usize.ZERO {
    let selected = List<MirOperand>.remove(&mut cases, usize.ZERO)
    let control = run conversionControl(&key, move selected, &destinations[at], List<Shared<Type>>.make())
    let layouts = run scalarControlLayouts(&control, &machine)
    let llvm = run emitClosedMir(&control, &machine, List<TypeLayout>.asSlice(&layouts), List<CAbi.Signature>.asSlice(&foreign))
    let ir = Bytes.asSlice(&llvm)
    let guarded = containsIr(ir, b"call void @llvm.trap()")
    run Testing.expect(containsIr(ir, Bytes.asSlice(&fragments[at])) && guarded == (at >= 2) && !containsIr(ir, b"nneg"),
      "exact widenings extend without a range check; narrowing, sign-changing and floating sources trap outside the destination range")
    at = at + usize.ONE
  }
  let mut invalid = List<MirOperand>.make()
  run List<MirOperand>.append(&mut invalid, MirOperand.Boolean {value: true})
  let pointer = run Types.intern(Type.Pointer {pointee: Shared<Type>.clone(&byte), access: Access.Shared,
    nullable: true, multiplicity: Multiplicity.Many, alignment: Option<u64>.none()})
  run List<MirOperand>.append(&mut invalid, MirOperand.Null {ty: Shared<Type>.clone(&pointer)})
  run List<MirOperand>.append(&mut invalid, MirOperand.Unit)
  while List<MirOperand>.length(&invalid) != usize.ZERO {
    let selected = List<MirOperand>.remove(&mut invalid, usize.ZERO)
    run Testing.expect(run conversionRejects(&key, move selected, &integer),
      "bool, pointer and unit source categories reject with the structured typed-form gap")
  }
  let mut invalidTargets = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut invalidTargets, run specializationPrimitive(b"bool"))
  run List<Shared<Type>>.append(&mut invalidTargets, move pointer)
  run List<Shared<Type>>.append(&mut invalidTargets, run Types.intern(Type.Unit))
  let rejected = List<Shared<Type>>.asSlice(&invalidTargets)
  at = usize.ZERO
  while at < rejected.length {
    run Testing.expect(run conversionRejects(&key, run typedInteger(b"u8", b"1"), &rejected[at]),
      "numeric conversion also rejects non-numeric destinations")
    at = at + usize.ONE
  }
  return ()
}

// A referenced record demands its own layout before loading the unsigned field.
effect fn projectedConversionControl(key: &InstanceKey, record: &Shared<Type>, moves: bool, projected: bool) -> MirFunction
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let reference = run Types.intern(Type.Reference {referent: Shared<Type>.clone(record), access: Access.Shared,
    lifetime: run Shared<Lifetime>.make(Lifetime.Static)})
  let mut parameters = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut parameters, move reference)
  run List<Shared<Type>>.append(&mut parameters, run specializationPrimitive(b"u8"))
  let mut place = MirPlace {local: 2, projections: List<MirProjection>.make()}
  if projected {
    place.local = usize.ONE
    run List<MirProjection>.append(&mut place.projections, MirProjection.Deref)
    run List<MirProjection>.append(&mut place.projections, MirProjection.Field {index: usize.ZERO})
  }
  let operand = runtimeSliceOperand(move place, moves)
  let integer = run specializationPrimitive(b"i32")
  return run conversionControl(key, move operand, &integer, move parameters)
}

test effect fn numericConversionRetainsProjectedLayoutsAndOperands() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run projectedConversionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn projectedConversionClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("unsigned-projected-widening.silk")
  let key = run recipeControlKey(&id, b"widen", false)
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Struct,
    name: Option<Bytes>.some(run Bytes.copy(b"ByteBox")), occurrence: usize.ZERO})
  let declaration = run DeclarationId.fromParts(ModuleId.copy(&id), move owners)
  let record = run specializationNominal(&declaration, List<Argument>.make())
  let machine = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let mut mode = usize.ZERO
  while mode < 2 {
    let function = run projectedConversionControl(&key, &record, mode == usize.ONE, true)
    let ordinary = run projectedConversionControl(&key, &record, mode == usize.ONE, false)
    let recipe = run InstanceRecipe.make(&function)
    let unprojected = run InstanceRecipe.make(&ordinary)
    run Testing.expect(!sameBytes(Bytes.asSlice(&recipe.shape), Bytes.asSlice(&unprojected.shape)),
      "projected Copy and Move operands retain their complete place dependencies in recipes")
    let demands = run mirLayoutDemands(&function, &Option<Anchor>.none())
    let needed = List<LayoutDemand>.asSlice(&demands)
    let mut projected = false
    if needed.length == 4 {
      projected = Shared<Type>.with<bool>(&needed[3].ty, fn(value: &Type) -> bool {
        return match &value.* { Type.Nominal {declaration: nominalId, ..} => DeclarationId.named(&nominalId, b"ByteBox") _ => false }
      })
    }
    run Testing.expect(projected, "a conversion demands the referenced record's layout through its projected operand")
    let layouts = run scalarControlLayouts(&function, &machine)
    let foreign = List<CAbi.Signature>.make()
    let llvm = run emitClosedMir(&function, &machine, List<TypeLayout>.asSlice(&layouts), List<CAbi.Signature>.asSlice(&foreign))
    run Testing.expect(conversionUsesProjectedLoad(Bytes.asSlice(&llvm)),
      "the exact byte loaded from the referenced record feeds the conversion with complete demanded layout facts")
    mode = mode + usize.ONE
  }
  return ()
}

// Constructed ordinary MIR isolates descriptor mechanics from the later storage intrinsics.
effect fn runtimeSliceControl(key: &InstanceKey, dataMoves: bool, countMoves: bool, countLocal: usize) -> MirFunction
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let empty = List<InstanceKey>.make()
  let mut function = run recipeControlMir(key, List<InstanceKey>.asSlice(&empty), Option<bool>.none(), true)
  let word = run specializationPrimitive(b"usize")
  let byte = run specializationPrimitive(b"u8")
  let lifetime = run Shared<Lifetime>.make(Lifetime.Static)
  let pointer = run Types.intern(Type.Pointer {pointee: Shared<Type>.clone(&byte), access: Access.Shared,
    nullable: true, multiplicity: Multiplicity.Many, alignment: Option<u64>.none()})
  let dataRef = run Types.intern(Type.Reference {referent: move pointer, access: Access.Shared,
    lifetime: Shared<Lifetime>.clone(&lifetime)})
  let countRef = run Types.intern(Type.Reference {referent: Shared<Type>.clone(&word), access: Access.Shared,
    lifetime: Shared<Lifetime>.clone(&lifetime)})
  let descriptor = run Types.intern(Type.Slice {element: move byte, access: Access.Shared, lifetime: move lifetime})
  let origin = BodyOrigin {node: usize.ZERO, location: Location.make(usize.ZERO, usize.ONE)}
  function.result = Shared<Type>.clone(&word)
  function.locals = List<MirLocal>.make()
  run List<MirLocal>.append(&mut function.locals, MirLocal {ty: move word, kind: MirLocalKind.Return, origin: origin})
  run List<MirLocal>.append(&mut function.locals, MirLocal {ty: Shared<Type>.clone(&dataRef), kind: MirLocalKind.Parameter {index: usize.ZERO}, origin: origin})
  run List<MirLocal>.append(&mut function.locals, MirLocal {ty: Shared<Type>.clone(&countRef), kind: MirLocalKind.Parameter {index: usize.ONE}, origin: origin})
  run List<MirLocal>.append(&mut function.locals, MirLocal {ty: Shared<Type>.clone(&countRef), kind: MirLocalKind.Parameter {index: 2}, origin: origin})
  run List<MirLocal>.append(&mut function.locals, MirLocal {ty: move descriptor, kind: MirLocalKind.Temp, origin: origin})
  run List<Shared<Type>>.append(&mut function.parameters, move dataRef)
  run List<Shared<Type>>.append(&mut function.parameters, Shared<Type>.clone(&countRef))
  run List<Shared<Type>>.append(&mut function.parameters, move countRef)
  let mut dataPlace = MirPlace {local: usize.ONE, projections: List<MirProjection>.make()}
  let mut countPlace = MirPlace {local: countLocal, projections: List<MirProjection>.make()}
  run List<MirProjection>.append(&mut dataPlace.projections, MirProjection.Deref)
  run List<MirProjection>.append(&mut countPlace.projections, MirProjection.Deref)
  let data = runtimeSliceOperand(move dataPlace, dataMoves)
  let count = runtimeSliceOperand(move countPlace, countMoves)
  let mut statements = List<MirStatement>.make()
  run List<MirStatement>.append(&mut statements, MirStatement.Assign {
    destination: MirPlace {local: 4, projections: List<MirProjection>.make()},
    value: MirRvalue.Slice {data: move data, count: move count}, origin: origin})
  run List<MirStatement>.append(&mut statements, MirStatement.Assign {
    destination: MirPlace {local: usize.ZERO, projections: List<MirProjection>.make()},
    value: MirRvalue.SliceLength {place: MirPlace {local: 4, projections: List<MirProjection>.make()}}, origin: origin})
  function.blocks = List<MirBlock>.make()
  run List<MirBlock>.append(&mut function.blocks, MirBlock {statements: move statements, terminator: MirTerminator.Return {origin: origin}})
  return move function
}

// The projected count's load result must feed the length store before SliceLength reads it.
fn runtimeSliceStoresProjectedCount(ir: &[u8]) -> bool {
  let mut start = usize.ZERO
  while start < ir.length {
    let mut end = start
    while end < ir.length && ir[end] != 10 { end = end + usize.ONE }
    let line = Slice.view<u8>(ir, start, end - start)
    if containsIr(line, b" = load i64, ptr ") {
      let mut nameLength = usize.ZERO
      while nameLength < line.length && line[nameLength] != 32 { nameLength = nameLength + usize.ONE }
      let name = Slice.view<u8>(ir, start, nameLength)
      let mut following = end + usize.ONE
      while following < ir.length {
        let mut next = following
        while next < ir.length && ir[next] != 10 { next = next + usize.ONE }
        let stored = Slice.view<u8>(ir, following, next - following)
        if containsIr(stored, b" = load i64, ptr ") { return false }
        if startsAt(stored, usize.ZERO, b"store i64 ") && startsAt(stored, 10, name)
          && stored.length > 10 + name.length && stored[10 + name.length] == 44 { return true }
        following = next + usize.ONE
      }
      return false
    }
    start = end + usize.ONE
  }
  return false
}

test effect fn runtimeSliceCountOperandsKeepProjectedDemandsAndRecipes() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run runtimeSliceCountClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn runtimeSliceCountClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | BackendGap | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("runtime-slice-count.silk")
  let key = run recipeControlKey(&id, b"descriptor", false)
  let target = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let mut mode = usize.ZERO
  while mode < 4 {
    let function = run runtimeSliceControl(&key, mode >= 2, usize.remainder(mode, 2) == usize.ONE, 2)
    let other = run runtimeSliceControl(&key, mode >= 2, usize.remainder(mode, 2) == usize.ONE, 3)
    let first = run InstanceRecipe.make(&function)
    let second = run InstanceRecipe.make(&other)
    run Testing.expect(!sameBytes(Bytes.asSlice(&first.shape), Bytes.asSlice(&second.shape)),
      "runtime count dependencies are part of the complete descriptor recipe")
    let demands = run mirLayoutDemands(&function, &Option<Anchor>.none())
    let needed = List<LayoutDemand>.asSlice(&demands)
    let mut complete = false
    if needed.length == 7 {
      complete = Shared<Type>.with<bool>(&needed[5].ty, fn(value: &Type) -> bool {
        return match &value.* { Type.Pointer {..} => true _ => false }
      }) && Shared<Type>.with<bool>(&needed[6].ty, fn(value: &Type) -> bool {
        return witnessPrimitive(value, b"usize")
      })
    }
    run Testing.expect(complete, "both Copy and Move data/count operands demand their distinct dereferenced referent layouts")
    let mut layouts = List<TypeLayout>.make()
    let mut at = usize.ZERO
    while at < needed.length {
      let ty = &needed[at].ty
      let mut layout = BackendLayout.scalar(ty, &target)
      let slice = Shared<Type>.with<Option<Shared<Type>>>(ty, fn(value: &Type) -> Option<Shared<Type>> {
        return match &value.* { Type.Slice {element, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&element)) _ => Option<Shared<Type>>.none() }
      })
      if let Option<Shared<Type>>.Some {value: element} = move slice {
        layout = BackendLayout.slice(&element, LayoutMetrics {size: usize.ONE, alignment: usize.ONE, abi: LayoutAbi.Integer,
          tagged: false}, &target)
      }
      if let Option<BackendLayout>.Some {value} = move layout {
        run List<TypeLayout>.append(&mut layouts, TypeLayout {ty: Shared<Type>.clone(ty), layout: run Shared<BackendLayout>.make(move value)})
      }
      at = at + usize.ONE
    }
    let foreign = List<CAbi.Signature>.make()
    let llvm = run emitClosedMir(&function, &target, List<TypeLayout>.asSlice(&layouts), List<CAbi.Signature>.asSlice(&foreign))
    let ir = Bytes.asSlice(&llvm)
    run Testing.expect(containsIr(ir, b"load ptr, ptr") && containsIr(ir, b"load i64, ptr")
      && runtimeSliceStoresProjectedCount(ir) && containsIr(ir, b"ret i64 %"),
      "the count loaded through &usize is stored as runtime descriptor length and read back through SliceLength")
    mode = mode + usize.ONE
  }
  return ()
}

test effect fn runtimeTextLiteralsBecomePrivateConstantDescriptors() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("runtime-text-literals.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Note { message: string<'static> }
impl Intrinsic.Copy for Note {}
fn note() -> Note { return Note { message: "hi\\t" } }
fn count(buffer: &[u8]) -> usize { return buffer.length }
fn pass(value: string<'static>) -> string<'static> { return value }
fn same(left: string<'static>, right: string<'static>) -> bool { return left == right }
fn different(left: string<'static>, right: string<'static>) -> bool { return left != right }
fn leftText() -> string<'static> { return "a" }
fn rightText() -> string<'static> { return "b" }
fn orderedText() -> bool { return leftText() == rightText() }
fn noTextOrder(left: string<'static>, right: string<'static>) -> bool { return left <= right }
fn noSliceEquality(left: &[u8], right: &[u8]) -> bool { return left == right }
pub fn main() -> i32 {
  let marks = "\\"\\\\\\0"
  let word = "olá"
  let none = b""
  let held = note()
  let kept = pass(held.message)
  let bytes = b"ab\\n"
  if count(bytes) == 3 && bytes[count(b"ab")] == 10 { return 0 }
  return 1
}
"""
  let mut store = run applicationSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let noteMir = run Semantic.demandMir(&mut store, &mut request, &id, b"note") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mainMir = run Semantic.demandMir(&mut store, &mut request, &id, b"main") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut textDescriptor = false
  let noteIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&noteMir, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move noteIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      textDescriptor = buildsStaticDescriptor(function, b"hi\t")
    }
  }
  let mut bytesDescriptor = false
  let mainIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&mainMir, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move mainIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      bytesDescriptor = buildsStaticDescriptor(function, b"ab\n") && buildsStaticDescriptor(function, b"\"\\\0")
        && buildsStaticDescriptor(function, b"ol\xC3\xA1") && buildsStaticDescriptor(function, b"")
    }
  }
  run Testing.expect(textDescriptor && bytesDescriptor,
    "text and byte-string literals build descriptors over their exact decoded UTF-8 bytes and byte length")
  let sameMir = run Semantic.demandMir(&mut store, &mut request, &id, b"same") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let differentMir = run Semantic.demandMir(&mut store, &mut request, &id, b"different") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let orderedMir = run Semantic.demandMir(&mut store, &mut request, &id, b"orderedText") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(textComparisonAnswer(&store, &sameMir, &id, true, false)
      && textComparisonAnswer(&store, &differentMir, &id, false, false)
      && textComparisonAnswer(&store, &orderedMir, &id, true, true),
    "string comparisons retain ordered operands, equal lengths and a bounded shared byte index, with first-difference exits and complementary results")
  let nativeText = run textComparisonEmission(&store, &sameMir, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), b"i64")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmText = run textComparisonEmission(&store, &differentMir, MachineTarget.forId(TargetId.Wasm32UnknownUnknown), b"i32")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(nativeText && wasmText,
    "the same source-derived MIR uses target-word lengths and indexes with byte loads on 64-bit and 32-bit targets")
  let noOrder = run Semantic.demandBody(&mut store, &mut request, &id, b"noTextOrder") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let noSlice = run Semantic.demandBody(&mut store, &mut request, &id, b"noSliceEquality") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&noOrder, RejectionCode.MissingOperator, text, "<=", usize.ZERO)
      && rejectsSpan(&noSlice, RejectionCode.MissingOperator, text, "==", 2),
    "string equality does not add text ordering or equality for a borrowed byte descriptor")
  let mut buildStore = run applicationSemantic(&id, """
struct Note { message: string<'static> }
impl Intrinsic.Copy for Note {}
fn note() -> Note { return Note { message: "hi\\t" } }
fn count(buffer: &[u8]) -> usize { return buffer.length }
fn pass(value: string<'static>) -> string<'static> { return value }
fn same(left: string<'static>, right: string<'static>) -> bool { return left == right }
fn different(left: string<'static>, right: string<'static>) -> bool { return left != right }
fn leftText() -> string<'static> { return "a" }
fn rightText() -> string<'static> { return "b" }
fn orderedText() -> bool { return leftText() == rightText() }
pub fn main() -> i32 {
  let marks = "\\"\\\\\\0"
  let word = "olá"
  let none = b""
  let held = note()
  let kept = pass(held.message)
  let bytes = b"ab\\n"
  if count(bytes) == 3 && bytes[count(b"ab")] == 10 { return 0 }
  return 1
}
""", MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut buildRequest = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut buildStore, &mut buildRequest, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut emitted = false
  if let BackendBuild.Module {text: llvm, ..} = &built {
    let ir = Bytes.asSlice(&llvm)
    emitted = containsIr(ir, b".bytes.") && containsIr(ir, b" = private unnamed_addr constant [3 x i8] c\"hi\\09\"")
      && containsIr(ir, b" = private unnamed_addr constant [3 x i8] c\"ab\\0A\"")
      && containsIr(ir, b" = private unnamed_addr constant [3 x i8] c\"\\22\\5C\\00\"")
      && containsIr(ir, b" = private unnamed_addr constant [4 x i8] c\"ol\\C3\\A1\"")
      && containsIr(ir, b" = private unnamed_addr constant [0 x i8] zeroinitializer")
  }
  run Testing.expect(emitted, "literal bytes are private constants addressed by a two-word descriptor")
  return ()
}

// Dataflow evidence, found in the actual selected MIR rather than made from the lowering helper.
struct TextBinaryEvidence { block: usize, statement: usize, local: usize, left: usize, right: usize }

struct TextDescriptorEvidence { block: usize, statement: usize, source: usize }

struct TextBranchEvidence { yes: usize, no: usize }

fn textOperandLocal(value: &MirOperand) -> usize {
  return match &value.* {
    MirOperand.Copy {place} => { if List<MirProjection>.length(&place.projections) == usize.ZERO { return place.local } return usize.MAX }
    MirOperand.Move {place} => { if List<MirProjection>.length(&place.projections) == usize.ZERO { return place.local } return usize.MAX }
    _ => usize.MAX
  }
}

// Only the authenticated assignments may define a value used by the proof.
fn textWritesAt(function: &MirFunction, local: usize, firstBlock: usize, firstAt: usize, secondBlock: usize, secondAt: usize) -> bool {
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  let mut first = false
  let mut second = false
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = List<MirStatement>.asSlice(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Assign {destination, ..} = &statements[at] {
        if destination.local == local {
          if List<MirProjection>.length(&destination.projections) != usize.ZERO { return false }
          if block == firstBlock && at == firstAt { first = true }
          else if block == secondBlock && at == secondAt { second = true }
          else { return false }
        }
      }
      at = at + usize.ONE
    }
    if let MirTerminator.Call {destination, failure, ..} = &blocks[block].terminator {
      if destination.local == local { return false }
      if let Option<MirFailureEdge>.Some {value} = &failure {
        if value.destination.local == local { return false }
      }
    }
    block = block + usize.ONE
  }
  return first && (secondBlock == usize.MAX || second)
}

// An original parameter or authenticated call result has no replacement assignments.
fn textHasNoAssignments(function: &MirFunction, local: usize) -> bool {
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = List<MirStatement>.asSlice(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Assign {destination, ..} = &statements[at] {
        if destination.local == local { return false }
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  return true
}

fn textLocalType(function: &MirFunction, local: usize, name: &[u8]) -> bool {
  let locals = List<MirLocal>.asSlice(&function.locals)
  return local < locals.length && Shared<Type>.with<bool>(&locals[local].ty, fn(value: &Type) -> bool { return witnessPrimitive(value, name) })
}

fn textIndexConstant(value: &MirOperand, decimal: &[u8]) -> bool {
  return match &value.* { MirOperand.Integer {decimal: bytes, negative, ty} => !negative
    && sameBytes(Bytes.asSlice(&bytes), decimal) && Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool { return witnessPrimitive(value, b"usize") })
    _ => false }
}

fn textBinary(function: &MirFunction, operation: InfixOperator, primitive: &[u8]) -> Option<TextBinaryEvidence> {
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  let mut found = Option<TextBinaryEvidence>.none()
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = List<MirStatement>.asSlice(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Binary {operation: selected, left, right}, ..} = &statements[at] {
        let first = textOperandLocal(&left)
        let second = textOperandLocal(&right)
        let mut rhs = textLocalType(function, second, primitive)
        if operation == InfixOperator.Add { rhs = textIndexConstant(&right, b"1") }
        if selected == operation && textLocalType(function, first, primitive) && rhs {
          if let Option<TextBinaryEvidence>.Some {..} = &found { return Option<TextBinaryEvidence>.none() }
          if List<MirProjection>.length(&destination.projections) != usize.ZERO { return Option<TextBinaryEvidence>.none() }
          found = Option<TextBinaryEvidence>.some(TextBinaryEvidence {block: block, statement: at, local: destination.local, left: first, right: second})
        }
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  return move found
}

fn textBranch(function: &MirFunction, binary: &TextBinaryEvidence) -> Option<TextBranchEvidence> {
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  if binary.block < blocks.length && textWritesAt(function, binary.local, binary.block, binary.statement, usize.MAX, usize.MAX) {
    if let MirTerminator.Branch {condition, thenBlock, elseBlock, ..} = &blocks[binary.block].terminator {
      if textOperandLocal(&condition) == binary.local && thenBlock < blocks.length && elseBlock < blocks.length && thenBlock != elseBlock {
        return Option<TextBranchEvidence>.some(TextBranchEvidence {yes: thenBlock, no: elseBlock})
      }
    }
  }
  return Option<TextBranchEvidence>.none()
}

fn textDescriptor(function: &MirFunction, local: usize, data: bool) -> Option<TextDescriptorEvidence> {
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  let mut found = Option<TextDescriptorEvidence>.none()
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = List<MirStatement>.asSlice(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Assign {destination, value, ..} = &statements[at] {
        if destination.local == local {
          if let Option<TextDescriptorEvidence>.Some {..} = &found { return Option<TextDescriptorEvidence>.none() }
          let mut source = usize.MAX
          match &value {
            MirRvalue.SliceLength {place} => { if !data && List<MirProjection>.length(&place.projections) == usize.ZERO { source = place.local } }
            MirRvalue.SliceData {place} => { if data && List<MirProjection>.length(&place.projections) == usize.ZERO { source = place.local } }
            _ => ()
          }
          if source == usize.MAX || List<MirProjection>.length(&destination.projections) != usize.ZERO { return Option<TextDescriptorEvidence>.none() }
          found = Option<TextDescriptorEvidence>.some(TextDescriptorEvidence {block: block, statement: at, source: source})
        }
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  if let Option<TextDescriptorEvidence>.Some {value} = &found {
    if !textWritesAt(function, local, value.block, value.statement, usize.MAX, usize.MAX) { return Option<TextDescriptorEvidence>.none() }
  }
  return move found
}

// A descriptor snapshot must trace through unique whole-value assignments to its actual source.
fn textCopiesFrom(function: &MirFunction, local: usize, root: usize) -> bool {
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  let mut current = local
  let mut steps = List<MirLocal>.length(&function.locals)
  while steps > usize.ZERO {
    if current == root { return true }
    let mut source = usize.MAX
    let mut writtenBlock = usize.MAX
    let mut writtenAt = usize.MAX
    let mut block = usize.ZERO
    while block < blocks.length {
      let statements = List<MirStatement>.asSlice(&blocks[block].statements)
      let mut at = usize.ZERO
      while at < statements.length {
        if let MirStatement.Assign {destination, value, ..} = &statements[at] {
          if destination.local == current {
            if source != usize.MAX || List<MirProjection>.length(&destination.projections) != usize.ZERO { return false }
            source = match &value { MirRvalue.Use {value: operand} => textOperandLocal(&operand) _ => usize.MAX }
            writtenBlock = block
            writtenAt = at
            if source == usize.MAX { return false }
          }
        }
        at = at + usize.ONE
      }
      block = block + usize.ONE
    }
    if source == usize.MAX || !textWritesAt(function, current, writtenBlock, writtenAt, usize.MAX, usize.MAX) { return false }
    current = source
    steps = steps - usize.ONE
  }
  return false
}

// Both loads must use a pointer advanced by the same bounded induction local from the correct descriptor.
fn textByteSource(function: &MirFunction, byte: usize, index: usize, reading: usize, compared: usize) -> Option<TextDescriptorEvidence> {
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  if reading >= blocks.length { return Option<TextDescriptorEvidence>.none() }
  let statements = List<MirStatement>.asSlice(&blocks[reading].statements)
  let mut pointer = usize.MAX
  let mut loaded = usize.MAX
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Assign {destination, value: MirRvalue.Use {value: MirOperand.Copy {place}}, ..} = &statements[at] {
      if destination.local == byte {
        let projections = List<MirProjection>.asSlice(&place.projections)
        if pointer != usize.MAX || at >= compared || projections.length != usize.ONE || !mirProjectionIsDeref(&projections[usize.ZERO]) { return Option<TextDescriptorEvidence>.none() }
        pointer = place.local
        loaded = at
      }
    }
    at = at + usize.ONE
  }
  if pointer == usize.MAX || !textWritesAt(function, byte, reading, loaded, usize.MAX, usize.MAX) { return Option<TextDescriptorEvidence>.none() }
  at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Assign {destination, value: MirRvalue.PointerOffset {pointer: base, index: selected, element}, ..} = &statements[at] {
      if destination.local == pointer && at < loaded && List<MirProjection>.length(&destination.projections) == usize.ZERO
        && textOperandLocal(&selected) == index && textWritesAt(function, pointer, reading, at, usize.MAX, usize.MAX)
        && Shared<Type>.with<bool>(&element, fn(value: &Type) -> bool { return witnessPrimitive(value, b"u8") }) {
        return textDescriptor(function, textOperandLocal(&base), true)
      }
    }
    at = at + usize.ONE
  }
  return Option<TextDescriptorEvidence>.none()
}

fn textGoto(function: &MirFunction, from: usize, to: usize) -> bool {
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  return from < blocks.length && match &blocks[from].terminator { MirTerminator.Goto {target, ..} => target == to _ => false }
}

fn textUnprojectedOperand(value: &MirOperand) -> bool {
  return match &value.* {
    MirOperand.Copy {place} => List<MirProjection>.length(&place.projections) == usize.ZERO
    MirOperand.Move {place} => List<MirProjection>.length(&place.projections) == usize.ZERO
    _ => true
  }
}

// Extra byte reads anywhere outside the proven bounded body would invalidate the safety claim.
fn textOnlyBoundedBytes(function: &MirFunction, reading: usize, left: usize, right: usize) -> bool {
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = List<MirStatement>.asSlice(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Assign {destination, value, ..} = &statements[at] {
        match &value {
          MirRvalue.Use {value: operand} => {
            if !textUnprojectedOperand(&operand) && (block != reading || (destination.local != left && destination.local != right)) { return false }
          }
          MirRvalue.Binary {left: first, right: second, ..} => {
            if !textUnprojectedOperand(&first) || !textUnprojectedOperand(&second) { return false }
          }
          MirRvalue.SliceLength {place} => { if List<MirProjection>.length(&place.projections) != usize.ZERO { return false } }
          MirRvalue.SliceData {place} => { if List<MirProjection>.length(&place.projections) != usize.ZERO { return false } }
          MirRvalue.PointerOffset {pointer, index, ..} => {
            if !textUnprojectedOperand(&pointer) || !textUnprojectedOperand(&index) { return false }
          }
          _ => { return false }
        }
      } else { return false }
      at = at + usize.ONE
    }
    if let MirTerminator.Call {arguments, providers, ..} = &blocks[block].terminator {
      let args = List<MirOperand>.asSlice(&arguments)
      let supplied = List<MirOperand>.asSlice(&providers)
      at = usize.ZERO
      while at < args.length {
        if !textUnprojectedOperand(&args[at]) { return false }
        at = at + usize.ONE
      }
      at = usize.ZERO
      while at < supplied.length {
        if !textUnprojectedOperand(&supplied[at]) { return false }
        at = at + usize.ONE
      }
    }
    if let MirTerminator.Branch {condition, ..} = &blocks[block].terminator {
      if !textUnprojectedOperand(&condition) { return false }
    }
    if let MirTerminator.Switch {value, ..} = &blocks[block].terminator {
      if !textUnprojectedOperand(&value) { return false }
    }
    block = block + usize.ONE
  }
  return true
}

fn textDefinitionBlock(function: &MirFunction, local: usize) -> usize {
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  let mut found = usize.MAX
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = List<MirStatement>.asSlice(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Assign {destination, ..} = &statements[at] {
        if destination.local == local {
          if found != usize.MAX { return usize.MAX }
          found = block
        }
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  return found
}

fn textComparisonFlow(function: &MirFunction, equal: bool, left: usize, right: usize, leftEntry: usize, entry: usize) -> bool {
  let lengths = match move textBinary(function, InfixOperator.Equals, b"usize") { Option<TextBinaryEvidence>.Some {value} => move value _ => { return false } }
  let bound = match move textBinary(function, InfixOperator.LessThan, b"usize") { Option<TextBinaryEvidence>.Some {value} => move value _ => { return false } }
  let bytes = match move textBinary(function, InfixOperator.Equals, b"u8") { Option<TextBinaryEvidence>.Some {value} => move value _ => { return false } }
  let advance = match move textBinary(function, InfixOperator.Add, b"usize") { Option<TextBinaryEvidence>.Some {value} => move value _ => { return false } }
  let lengthEdges = match move textBranch(function, &lengths) { Option<TextBranchEvidence>.Some {value} => move value _ => { return false } }
  let boundEdges = match move textBranch(function, &bound) { Option<TextBranchEvidence>.Some {value} => move value _ => { return false } }
  let byteEdges = match move textBranch(function, &bytes) { Option<TextBranchEvidence>.Some {value} => move value _ => { return false } }
  let leftLength = match move textDescriptor(function, lengths.left, false) { Option<TextDescriptorEvidence>.Some {value} => move value _ => { return false } }
  let rightLength = match move textDescriptor(function, lengths.right, false) { Option<TextDescriptorEvidence>.Some {value} => move value _ => { return false } }
  let leftByte = match move textByteSource(function, bytes.left, bound.left, bytes.block, bytes.statement) { Option<TextDescriptorEvidence>.Some {value} => move value _ => { return false } }
  let rightByte = match move textByteSource(function, bytes.right, bound.left, bytes.block, bytes.statement) { Option<TextDescriptorEvidence>.Some {value} => move value _ => { return false } }
  if !textCopiesFrom(function, leftLength.source, left) || !textCopiesFrom(function, rightLength.source, right)
    || leftLength.source != leftByte.source || rightLength.source != rightByte.source || left == right
    || textDefinitionBlock(function, leftLength.source) != leftEntry || textDefinitionBlock(function, rightLength.source) != entry { return false }
  if lengths.block != entry || leftLength.block != lengths.block || rightLength.block != lengths.block
    || leftLength.statement >= lengths.statement || rightLength.statement >= lengths.statement || bound.right != lengths.left
    || lengthEdges.yes != leftByte.block || leftByte.block != rightByte.block || !textGoto(function, leftByte.block, bound.block)
    || boundEdges.yes != bytes.block || byteEdges.no != lengthEdges.no || byteEdges.yes != advance.block
    || advance.local != bound.left || advance.left != bound.left || !textGoto(function, advance.block, bound.block) { return false }
  let matched = match move textResult(function, boundEdges.no, equal) { Option<TextResultEvidence>.Some {value} => move value _ => { return false } }
  let unmatched = match move textResult(function, lengthEdges.no, !equal) { Option<TextResultEvidence>.Some {value} => move value _ => { return false } }
  if matched.local != unmatched.local || matched.join != unmatched.join || !textCopiesFrom(function, usize.ZERO, matched.local)
    || !textWritesAt(function, matched.local, boundEdges.no, usize.ZERO, lengthEdges.no, usize.ZERO)
    || !textOnlyBoundedBytes(function, bytes.block, bytes.left, bytes.right) { return false }
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  let mut initialized = false
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = List<MirStatement>.asSlice(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if let MirStatement.Assign {destination, value, ..} = &statements[at] {
        if destination.local == bound.left {
          if List<MirProjection>.length(&destination.projections) != usize.ZERO { return false }
          match &value {
            MirRvalue.Use {value: initial} => {
              if initialized || block != lengths.block || !textIndexConstant(&initial, b"0") { return false }
              initialized = true
            }
            MirRvalue.Binary {operation, left: previous, right: increment} => {
              if block != advance.block || operation != InfixOperator.Add || textOperandLocal(&previous) != bound.left || !textIndexConstant(&increment, b"1") { return false }
            }
            _ => { return false }
          }
        }
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  return initialized && matched.join < blocks.length && match &blocks[matched.join].terminator { MirTerminator.Return {..} => true _ => false }
}

fn textComparisonAnswer(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, id: &ModuleId, equal: bool, calls: bool) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = List<MirLocal>.asSlice(&function.locals)
      let mut left = usize.MAX
      let mut right = usize.MAX
      let blocks = List<MirBlock>.asSlice(&function.blocks)
      let mut first = usize.MAX
      let mut second = usize.MAX
      let mut entry = usize.ZERO
      let mut at = usize.ZERO
      if calls {
        while at < blocks.length {
          if let MirTerminator.Call {callee, destination, normal, failure, diagnostics, ..} = &blocks[at].terminator {
            let key = match &callee { MirCallee.Instance {key} => &key _ => { return false } }
            if List<MirProjection>.length(&destination.projections) != usize.ZERO { return false }
            if let Option<MirDiagnostics>.Some {..} = &diagnostics { return false }
            if let Option<MirFailureEdge>.Some {..} = &failure { return false }
            let identity = InstanceKey.identity(&key)
            let side = Shared<DeclarationId>.with<usize>(&identity, fn(value: &DeclarationId) -> usize {
              if !ModuleId.equals(DeclarationId.moduleId(value), id) { return usize.MAX }
              if DeclarationId.named(value, b"leftText") { return usize.ZERO }
              if DeclarationId.named(value, b"rightText") { return usize.ONE }
              return usize.MAX
            })
            if side == usize.ZERO && left == usize.MAX && at == usize.ZERO {
              left = destination.local
              first = normal
            } else if side == usize.ONE && right == usize.MAX {
              right = destination.local
              second = at
              entry = normal
            }
            else { return false }
          }
          at = at + usize.ONE
        }
        if first != second { return false }
      } else {
        let mut block = usize.ZERO
        while block < blocks.length {
          if let MirTerminator.Call {..} = &blocks[block].terminator { return false }
          block = block + usize.ONE
        }
        while at < locals.length {
          if let MirLocalKind.Parameter {index: parameter} = &locals[at].kind {
            if parameter == usize.ZERO { left = at }
            if parameter == usize.ONE { right = at }
          }
          at = at + usize.ONE
        }
      }
      let mut leftEntry = usize.ZERO
      if calls { leftEntry = first }
      return left != usize.MAX && right != usize.MAX
        && textHasNoAssignments(function, left) && textHasNoAssignments(function, right)
        && textComparisonFlow(function, equal, left, right, leftEntry, entry)
    }
  }
  return false
}

effect fn textComparisonEmission(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, target: MachineTarget, expectedWord: &[u8]) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = List<MirLocal>.asSlice(&function.locals)
      let mut layouts = List<TypeLayout>.make()
      let mut at = usize.ZERO
      while at < locals.length {
        let mut shape = BackendLayout.scalar(&locals[at].ty, &target)
        if Shared<Type>.with<bool>(&locals[at].ty, fn(value: &Type) -> bool { return match &value.* { Type.String {..} => true _ => false } }) {
          shape = run BackendLayout.text(&target)
        }
        if let Option<BackendLayout>.Some {value} = move shape {
          run List<TypeLayout>.append(&mut layouts, TypeLayout {ty: Shared<Type>.clone(&locals[at].ty), layout: run Shared<BackendLayout>.make(move value)})
        } else { return false }
        at = at + usize.ONE
      }
      let foreign = List<CAbi.Signature>.make()
      let emitted = run Effect.result(emitClosedMir(function, &target, List<TypeLayout>.asSlice(&layouts), List<CAbi.Signature>.asSlice(&foreign)))
      if let Result<Bytes, BackendGap | OutOfMemoryError>.Success {value} = move emitted {
        let ir = Bytes.asSlice(&value)
        let mut words = false
        if sameBytes(expectedWord, b"i64") { words = containsIr(ir, b" = load i64,") && containsIr(ir, b" = icmp ult i64 ") }
        if sameBytes(expectedWord, b"i32") { words = containsIr(ir, b" = load i32,") && containsIr(ir, b" = icmp ult i32 ") }
        return words && containsIr(ir, b" = load i8,") && containsIr(ir, b" = icmp eq i8 ") && containsIr(ir, b"br i1 ")
          && !containsIr(ir, b"@memcmp") && !containsIr(ir, b"@strcmp")
      }
    }
  }
  return false
}

// B12 slice 1: exact MIR keys and completed emitted identities are proven structurally here.
// Runtime behavior stays in the shared native corpus.
test effect fn genericCallersShareOneClosedMirKey() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | BackendGap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("b12-shared-instance.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
fn identity<T>(value: T) -> T { return move value }
fn first() -> i32 { return identity<i32>(20) }
fn second() -> i32 { return identity<i32>(22) }
pub fn main() -> i32 { return first() + second() }
"""
  let mut store = run applicationSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let first = run Semantic.demandMir(&mut store, &mut request, &id, b"first") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Semantic.demandMir(&mut store, &mut request, &id, b"second") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let firstIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&first, selectedMirIndex)
  let secondIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&second, selectedMirIndex)
  let firstKey = mirSingleReference(&store, move firstIndex)
  let secondKey = mirSingleReference(&store, move secondIndex)
  let mut shared = false
  if let Option<InstanceKey>.Some {value: firstInstance} = move firstKey {
    if let Option<InstanceKey>.Some {value: secondInstance} = move secondKey {
      shared = run InstanceKey.sameApplication(&firstInstance, &secondInstance) |> Effect.provideMut<Allocator>(&mut allocator)
      let selected = run InstanceKey.selected(&firstInstance) |> Effect.provideMut<Allocator>(&mut allocator)
      let arguments = List<Argument>.asSlice(&selected.arguments)
      shared = shared && arguments.length == usize.ONE
      if arguments.length == usize.ONE {
        shared = shared && match & arguments[usize.ZERO] {
          Argument.Type {value: ty} => Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool { return b12IntegerType(value) })
          _ => false
        }
      }
      let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
        |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
      let mut emittedOnce = false
      if let BackendBuild.Module {text: ir, plan, ..} = &built {
        let firstSymbol = run EmissionPlan.symbol(&plan, &firstInstance) |> Effect.provideMut<Allocator>(&mut allocator)
        let secondSymbol = run EmissionPlan.symbol(&plan, &secondInstance) |> Effect.provideMut<Allocator>(&mut allocator)
        let firstIdentity = run recipeIdentityAt(&plan, &firstInstance) |> Effect.provideMut<Allocator>(&mut allocator)
        let secondIdentity = run recipeIdentityAt(&plan, &secondInstance) |> Effect.provideMut<Allocator>(&mut allocator)
        emittedOnce = firstIdentity == secondIdentity && sameBytes(Bytes.asSlice(&firstSymbol), Bytes.asSlice(&secondSymbol))
          && genericUniqueSymbolDefinition(Bytes.asSlice(&ir), Bytes.asSlice(&firstSymbol))
      }
      shared = shared && emittedOnce
    }
  }
  run Testing.expect(shared, "two callers retain one exact identity<i32> key, interned selected identity and emitted definition")
  return ()
}

fn mirSingleReference(store: &Semantic, index: Option<usize>) -> Option<InstanceKey> {
  if let Option<usize>.Some {value: at} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, at) {
      let references = List<MirReference>.asSlice(&function.references)
      if references.length == usize.ONE {
        return match &references[usize.ZERO].edge {
          SpecializationEdge.Direct => Option<InstanceKey>.some(InstanceKey.copy(&references[usize.ZERO].key),
          )
          _ => Option<InstanceKey>.none() }
      }
    }
  }
  return Option<InstanceKey>.none()
}

test effect fn witnessMirSharesDirectTargetWithoutBodyDemand() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run witnessMirSharingClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn witnessMirSharingClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("b12-witness-mir.silk")
  let source = """
interface Make<A, B> { fn make(value: Self, left: A, right: B) -> B }
struct Maker {}
fn target<Y, X>(value: Maker, left: X, right: Y) -> Y { return missing }
impl<A, B> Make<A, B> for Maker { make: target }
fn direct() -> i32 { return target<i32, bool>(Maker {}, true, 42) }
fn witnessed() -> i32 { return Make<bool, i32>.make(Maker {}, true, 42) }
"""
  let mut store = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let direct = run Semantic.demandMir(&mut store, &mut request, &id, b"direct")
  let witnessed = run Semantic.demandMir(&mut store, &mut request, &id, b"witnessed")
  let directKey = mirSingleReference(&store, Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&direct, selectedMirIndex))
  let witnessedKey = mirWitnessReference(&store, Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&witnessed, selectedMirIndex))
  let mut same = false
  if let Option<InstanceKey>.Some {value: left} = move directKey {
    if let Option<InstanceKey>.Some {value: right} = move witnessedKey {
      let first = run InstanceKey.runtimeName(&left)
      let second = run InstanceKey.runtimeName(&right)
      let application = run InstanceKey.selected(&right)
      let arguments = List<Argument>.asSlice(&application.arguments)
      same = InstanceKey.sameRuntimeBase(&left, &right) && sameBytes(Bytes.asSlice(&first), Bytes.asSlice(&second))
        && DeclarationId.named(SpecializationApplication.bodyDeclaration(&application), b"target")
        && arguments.length == 2 && List<ScopeBinding>.length(&application.scopes) == usize.ZERO
      if arguments.length == 2 {
        if let Argument.Type {value: firstType} = &arguments[usize.ZERO] {
          if let Argument.Type {value: secondType} = &arguments[usize.ONE] {
            same = same && Shared<Type>.with<bool>(&firstType, b12IntegerType)
              && Shared<Type>.with<bool>(&secondType, isBool)
          } else { same = false }
        } else { same = false }
      }
    }
  }
  run Testing.expect(same, "production witness MIR retains reversed target binder order and shares the direct erased family key and name without reading the target body")
  let bodies = starts(Semantic.eventLog(&store), Family.Body)
  let witnesses = starts(Semantic.eventLog(&store), Family.Witnesses)
  let mut warm = Request.make()
  let retained = run Semantic.demandMir(&mut store, &mut warm, &id, b"witnessed")
  run Testing.expect(succeeded(&retained) && bodies == 2 && witnesses > usize.ZERO
    && starts(Semantic.eventLog(&store), Family.Body) == bodies
    && starts(Semantic.eventLog(&store), Family.Witnesses) == witnesses
    && Semantic.requestDemanded(&mut store, &warm, Family.Witnesses, &id)
    && Semantic.requestDemanded(&mut store, &warm, Family.ConformanceHeads, &id),
    "cached witness MIR retains proof dependencies without demanding the deliberately invalid target body")
  return ()
}

fn mirWitnessReference(store: &Semantic, index: Option<usize>) -> Option<InstanceKey> {
  if let Option<usize>.Some {value: at} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, at) {
      let references = List<MirReference>.asSlice(&function.references)
      if references.length == usize.ONE {
        return match &references[usize.ZERO].edge {
          SpecializationEdge.Witness => Option<InstanceKey>.some(InstanceKey.copy(&references[usize.ZERO].key),
          )
          _ => Option<InstanceKey>.none() }
      }
    }
  }
  return Option<InstanceKey>.none()
}

test effect fn witnessMirClosesCapturedScopeThroughNestedCallers() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run witnessMirCapturedScopeClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn witnessMirCapturedScopeClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("b12-captured-scope-mir.silk")
  let source = """
interface Make<T> { fn make(value: &Self, item: T) -> Box<T> }
struct Maker {}
struct Box<T> { value: T }
impl<T> Make<T> for Maker {
  fn make(value: &Self, item: T) -> Box<T> {
    let retained: T = move item
    return Box<T> { value: move retained }
  }
}
fn through<P: Make<i32>>(maker: &P, item: i32) -> Box<i32> { return Make<i32>.make(maker, item) }
fn relay<P: Make<i32>>(maker: &P, item: i32) -> Box<i32> { return through(maker, item) }
pub fn main() -> i32 {
  let maker = Maker {}
  let result = relay(&maker, 42)
  return result.value
}
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let implOwner = run requireIndexedIdentity(&mut index, &id, OwnerKind.Implementation, b"", usize.ZERO)
  let mut store = Semantic.traced(run withEntryRuntime(&revision), MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let checked = run Semantic.demandBody(&mut store, &mut request, &id, b"through")
  let inputs = Shared<Result<Answer, NoRejection>>.with<Option<WitnessCallInputs>>(&checked, witnessCallInputs)
  let retainedBound = match &inputs {
    Option<WitnessCallInputs>.Some {value} => !value.selected
    _ => false
  }
  run Testing.expect(succeeded(&checked) && retainedBound && starts(Semantic.eventLog(&store), Family.Body) == usize.ONE,
    "applied interface qualifier preserves the full declared bound without selecting a target body")
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
  let emitted = match &built { BackendBuild.Module {..} => true _ => false }
  let mut closed = true
  let mut captured = false
  let mut regions = false
  let mut at = usize.ZERO
  while true {
    let selected = Semantic.mirAt(&store, at)
    let function = match move selected { Option<&MirFunction>.Some {value} => value _ => { break } }
    closed = closed && !Type.hasOpenRuntimeParameters(&function.result)
    let locals = List<MirLocal>.asSlice(&function.locals)
    let mut localAt = usize.ZERO
    while localAt < locals.length {
      closed = closed && !Type.hasOpenRuntimeParameters(&locals[localAt].ty)
      localAt = localAt + usize.ONE
    }
    let key = mirWitnessReference(&store, Option<usize>.some(at))
    if let Option<InstanceKey>.Some {value} = move key {
      let parameters = List<Shared<Type>>.asSlice(&function.parameters)
      let mut callerRegion = Option<Shared<Lifetime>>.none()
      if parameters.length > usize.ZERO { callerRegion = Shared<Type>.with<Option<Shared<Lifetime>>>(&parameters[usize.ZERO], witnessMirReferenceRegion) }
      let application = run InstanceKey.selected(&value)
      let own = List<Argument>.asSlice(&application.arguments)
      let ownSlots = List<usize>.asSlice(&application.argumentOrdinals)
      if own.length == usize.ONE && ownSlots.length == usize.ONE && ownSlots[usize.ZERO] == usize.ZERO {
        if let Argument.Lifetime {value: actual} = &own[usize.ZERO] {
          if let Option<Shared<Lifetime>>.Some {value: expected} = move callerRegion {
            regions = Lifetime.equalsShared(&actual, &expected) && Shared<Lifetime>.with<bool>(&actual, witnessMirCallerRegion)
          }
        }
      }
      let scopes = List<ScopeBinding>.asSlice(&application.scopes)
      if scopes.length == usize.ONE {
        let arguments = List<Argument>.asSlice(&scopes[usize.ZERO].arguments)
        let slots = List<usize>.asSlice(&scopes[usize.ZERO].argumentOrdinals)
        captured = Shared<DeclarationId>.with<bool>(&scopes[usize.ZERO].owner, fn(value: &DeclarationId) -> bool { return DeclarationId.equals(value, &implOwner) })
          && arguments.length == usize.ONE && slots.length == usize.ONE && slots[usize.ZERO] == usize.ZERO
        if arguments.length == usize.ONE {
          captured = captured && match &arguments[usize.ZERO] {
            Argument.Type {value: ty} => Shared<Type>.with<bool>(&ty, b12IntegerType)
            _ => false
          }
        }
      }
    }
    at = at + usize.ONE
  }
  run Testing.expect(emitted && closed && captured && regions,
    "nested witness specialization closes the actual impl-owned binder through body locals, node types and aggregate layouts")
  return ()
}

fn witnessMirReferenceRegion(value: &Type) -> Option<Shared<Lifetime>> {
  return match &value.* {
    Type.Reference {lifetime, ..} => Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&lifetime))
    _ => Option<Shared<Lifetime>>.none()
  }
}

// Main's loan reaches each nested instance as its first canonical caller region.
fn witnessMirCallerRegion(value: &Lifetime) -> bool {
  return match &value.* {
    Lifetime.Supplied {ordinal} => ordinal == usize.ZERO
    _ => false
  }
}

test effect fn witnessMirValidatesLifetimeDistinctRuntimeEqualApplications() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run witnessMirSemanticCacheClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn witnessMirSemanticCacheClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("b12-semantic-cache.silk")
  let source = """
interface Regional<'a> { fn read(value: Self) -> i32 }
struct Maker {}
impl Regional<'static> for Maker { fn read(value: Self) -> i32 { return missing } }
fn through<'a, P: Regional<'a>>(maker: P) -> i32 { return Regional<'a>.read(move maker) }
fn site(value: &i32) -> i32 { return 0 }
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let caller = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"through", usize.ZERO)
  let site = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"site", usize.ZERO)
  let maker = run requireIndexedIdentity(&mut index, &id, OwnerKind.Struct, b"Maker", usize.ZERO)
  let provider = run Types.intern(Type.Nominal {declaration: move maker, isPublic: false, arguments: List<Argument>.make()})
  let mut firstArguments = List<Argument>.make()
  run List<Argument>.append(&mut firstArguments, Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Static)})
  run List<Argument>.append(&mut firstArguments, Argument.Type {value: Shared<Type>.clone(&provider)})
  let first = run specializationWithArguments(&caller, move firstArguments)
  let mut secondArguments = List<Argument>.make()
  run List<Argument>.append(&mut secondArguments, Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Parameter {
    declaration: move site, ordinal: usize.ZERO,
  })})
  run List<Argument>.append(&mut secondArguments, Argument.Type {value: move provider})
  let second = run specializationWithArguments(&caller, move secondArguments)
  let firstKey = run requiredCanonicalKey(run InstanceKey.function(run SpecializationApplication.copy(&first)))
  let secondKey = run requiredCanonicalKey(run InstanceKey.function(run SpecializationApplication.copy(&second)))
  run Testing.expect(InstanceKey.sameRuntimeBase(&firstKey, &secondKey) && !run SpecializationApplication.equals(&first, &second),
    "actual source-owned lifetime environments differ while their provisional erased runtime family is shared")
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let successful = run Semantic.demandApplicationMir(&mut store, &mut request, &first)
  let firstIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&successful, selectedMirIndex)
  let hasMir = match &firstIndex { Option<usize>.Some {..} => true _ => false }
  let mut secondRequest = Request.make()
  let rejected = run Semantic.demandApplicationMir(&mut store, &mut secondRequest, &second)
  let diagnostic = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&rejected, rejection)
  let refusedBound = match move diagnostic {
    Option<Shared<Rejection>>.Some {value} => Shared<Rejection>.with<bool>(&value,
      fn(value: &Rejection) -> bool {
        return value.code == RejectionCode.MissingConformance && ModuleId.equals(&value.module, &id)
      })
    _ => false
  }
  run Testing.expect(hasMir && refusedBound && starts(Semantic.eventLog(&store), Family.Mir) == usize.ONE
    && starts(Semantic.eventLog(&store), Family.Body) == usize.ONE
    && Semantic.requestDemanded(&mut store, &request, Family.Witnesses, &id),
    "a second lifetime-distinct root proves its own conformance bound before runtime reuse and never reads the invalid witness body")
  return ()
}

test effect fn witnessMirLendsFreshOperandsInWrittenOrder() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run witnessMirLendingClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn witnessMirLendingClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("b12-witness-lending.silk")
  let source = """
interface Read { fn read(value: Self, left: i32, right: i32) -> i32 }
struct Maker {}
impl Read for Maker { fn read(value: &Self, left: &i32, right: &mut i32) -> i32 { return missing } }
fn first() -> i32 { return missing }
fn second() -> i32 { return missing }
fn caller() -> i32 { return Read.read(Maker {}, first(), second()) }
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut sourceIndex = SourceIndex.make(run Revision.copy(&revision))
  let caller = run requireIndexedIdentity(&mut sourceIndex, &id, OwnerKind.Function, b"caller", usize.ZERO)
  let mut store = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.make()
  let checked = run Semantic.demandBody(&mut store, &mut request, &id, b"caller")
  let mut written = List<BodyCallArgument>.make()
  let checkedTypedBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&checked, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedTypedBody {
    let lendingCallNode = Shared<TypedBody>.with<Option<BodyNodeId>>(&body, witnessMirLendingNode)
    if let Option<BodyNodeId>.Some {value: node} = move lendingCallNode {
      let mut at = usize.ZERO
      while at < 3 {
        if let Option<BodyCallArgument>.Some {value} = move TypedBody.callArgument(&body, node, at) {
          run List<BodyCallArgument>.append(&mut written, move value)
        }
        at = at + usize.ONE
      }
    }
  }
  let expectedArguments = List<BodyCallArgument>.asSlice(&written)
  let mut writtenSites = expectedArguments.length == 3
  if writtenSites {
    let makerStart = offsetOf(source, "Read.read(Maker {}, first(), second())", 0) + 10
    let firstStart = offsetOf(source, "first()", 1)
    let secondStart = offsetOf(source, "second()", 1)
    let anchor = match move run answerAnchor(&mut store, &checked) {
      Option<Anchor>.Some {value} => move value
      Option<Anchor>.None => {return run Testing.expect(false, "witness caller has a current source anchor")}
    }
    writtenSites = Anchor.span(&anchor, expectedArguments[usize.ZERO].origin.location).start == makerStart
      && Anchor.span(&anchor, expectedArguments[usize.ZERO].origin.location).end == makerStart + 8
      && Anchor.span(&anchor, expectedArguments[usize.ONE].origin.location).start == firstStart
      && Anchor.span(&anchor, expectedArguments[usize.ONE].origin.location).end == firstStart + 7
      && Anchor.span(&anchor, expectedArguments[2].origin.location).start == secondStart
      && Anchor.span(&anchor, expectedArguments[2].origin.location).end == secondStart + 8
  }
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"caller")
  let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, selectedMirIndex)
  let mut order = false
  let mut operands = false
  let mut loanTypes = List<Shared<Type>>.make()
  let mut selected = Option<InstanceKey>.none()
  if let Option<usize>.Some {value: at} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, at) {
      let blocks = List<MirBlock>.asSlice(&function.blocks)
      let locals = List<MirLocal>.asSlice(&function.locals)
      let mut maker = usize.MAX
      let mut makerCount = usize.ZERO
      if writtenSites {
        let mut blockAt = usize.ZERO
        while blockAt < blocks.length {
          let statements = List<MirStatement>.asSlice(&blocks[blockAt].statements)
          let mut statementAt = usize.ZERO
          while statementAt < statements.length {
            if let MirStatement.Assign {destination, value: MirRvalue.Aggregate {fields}, origin} = &statements[statementAt] {
              if origin.node == expectedArguments[usize.ZERO].origin.node {
                makerCount = makerCount + usize.ONE
                maker = destination.local
                writtenSites = writtenSites && List<MirAggregateField>.length(&fields) == usize.ZERO
                  && List<MirProjection>.length(&destination.projections) == usize.ZERO
                  && maker < locals.length
                if maker < locals.length { writtenSites = writtenSites && run Type.equalsShared(&locals[maker].ty, &expectedArguments[usize.ZERO].ty) }
              }
            }
            statementAt = statementAt + usize.ONE
          }
          blockAt = blockAt + usize.ONE
        }
      }
      let mut first = usize.MAX
      let mut second = usize.MAX
      let mut firstBlock = usize.MAX
      let mut firstNormal = usize.MAX
      let mut secondNormal = usize.MAX
      let mut witness = false
      let mut unique = true
      let mut blockAt = usize.ZERO
      while blockAt < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, destination, normal, origin, ..} = &blocks[blockAt].terminator {
          let identity = InstanceKey.identity(&key)
          if Shared<DeclarationId>.with<bool>(&identity, witnessMirFirst) {
            unique = unique && first == usize.MAX && second == usize.MAX && !witness
              && List<MirProjection>.length(&destination.projections) == usize.ZERO
            first = destination.local
            firstBlock = blockAt
            firstNormal = normal
            if writtenSites { unique = unique && origin.node == expectedArguments[usize.ONE].origin.node }
          } else if Shared<DeclarationId>.with<bool>(&identity, witnessMirSecond) {
            unique = unique && first != usize.MAX && second == usize.MAX && !witness && blockAt == firstNormal
              && List<MirProjection>.length(&destination.projections) == usize.ZERO
            second = destination.local
            secondNormal = normal
            if writtenSites { unique = unique && origin.node == expectedArguments[2].origin.node }
          } else if Shared<DeclarationId>.with<bool>(&identity, witnessMirRead) {
            unique = unique && first != usize.MAX && second != usize.MAX && !witness && blockAt == secondNormal
            witness = true
            selected = Option<InstanceKey>.some(InstanceKey.copy(&key))
            let values = List<MirOperand>.asSlice(&arguments)
            operands = writtenSites && makerCount == usize.ONE && values.length == 3
              && maker != first && maker != second && first != second
            let mut captures = List<usize>.make()
            let mut references = List<usize>.make()
            let mut at = usize.ZERO
            while operands && at < values.length {
              if let MirOperand.Copy {place} = &values[at] {
                let mut producer = maker
                let mut definitionBlock = firstBlock
                if at == usize.ONE {
                  producer = first
                  definitionBlock = firstNormal
                }
                if at == 2 {
                  producer = second
                  definitionBlock = secondNormal
                }
                let captured = run witnessMirLentCapture(function, place.local, producer, definitionBlock,
                  &expectedArguments[at], &caller, witnessMirLentAccess(at))
                if let Option<usize>.Some {value} = move captured {
                  operands = List<MirProjection>.length(&place.projections) == usize.ZERO
                    && value != maker && value != first && value != second
                  let previous = List<usize>.asSlice(&captures)
                  let previousReferences = List<usize>.asSlice(&references)
                  let mut prior = usize.ZERO
                  while prior < previous.length {
                    operands = operands && previous[prior] != value && previousReferences[prior] != place.local
                    prior = prior + usize.ONE
                  }
                  run List<usize>.append(&mut captures, value)
                  run List<usize>.append(&mut references, place.local)
                  run List<Shared<Type>>.append(&mut loanTypes, Shared<Type>.clone(&locals[place.local].ty))
                } else { operands = false }
              } else { operands = false }
              at = at + usize.ONE
            }
          } else { unique = false }
        }
        blockAt = blockAt + usize.ONE
      }
      order = unique && first != usize.MAX && second != usize.MAX && witness
    }
  }
  let mut signatureMatches = false
  if let Option<InstanceKey>.Some {value} = move selected {
    let application = run InstanceKey.selected(&value)
    let signature = run Semantic.specializeSignature(&mut store, &mut request, &application, &id, Span.make(usize.ZERO, usize.ZERO))
    // Freeze the complete ordered loan domain before rewriting; no streaming map remains.
    let mut expectedArguments = List<Argument>.make()
    let lent = List<Shared<Type>>.asSlice(&loanTypes)
    let mut lentAt = usize.ZERO
    while lentAt < lent.length {
      run List<Argument>.append(&mut expectedArguments, Argument.Type {value: Shared<Type>.clone(&lent[lentAt])})
      lentAt = lentAt + usize.ONE
    }
    let expectedKey = run requiredCanonicalKey(run InstanceKey.function(run specializationWithArguments(&caller, move expectedArguments)))
    let expectedApplication = run InstanceKey.selected(&expectedKey)
    let given = List<Argument>.asSlice(&expectedApplication.arguments)
    let mut numbered = List<Shared<Type>>.make()
    let mut typedArguments = true
    lentAt = usize.ZERO
    while lentAt < given.length {
      if let Argument.Type {value: expectedType} = &given[lentAt] { run List<Shared<Type>>.append(&mut numbered, Shared<Type>.clone(&expectedType)) }
      else { typedArguments = false }
      lentAt = lentAt + usize.ONE
    }
    signatureMatches = typedArguments && (run witnessMirLendingSignature(&signature, List<Shared<Type>>.asSlice(&numbered)))
  }
  run Testing.expect(order && operands && signatureMatches && starts(Semantic.eventLog(&store), Family.Body) == usize.ONE,
    "validated shared and exclusive witness loans capture each owned rvalue once in written order with actual caller regions, numbered in the witness instance's matching parameter ABI")
  return ()
}

fn witnessMirLendingNode(value: &TypedBody) -> Option<BodyNodeId> {
  let nodes = TypedBody.nodeSlice(value)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {..}, ..} = &nodes[at].kind {
      return Option<BodyNodeId>.some(BodyNodeId {index: at})
    }
    at = at + usize.ONE
  }
  return Option<BodyNodeId>.none()
}

fn witnessMirFirst(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"first") }

fn witnessMirSecond(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"second") }

fn witnessMirRead(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"read") }

fn witnessMirLentAccess(at: usize) -> Access {
  if at == 2 { return Access.Mutable }
  return Access.Shared
}

effect fn witnessMirLentCapture(function: &MirFunction, reference: usize, producer: usize, definitionBlock: usize,
  argument: &BodyCallArgument, caller: &DeclarationId, expected: Access) -> Option<usize>
! OutOfMemoryError
? &mut Allocator | &mut Types {
  let locals = List<MirLocal>.asSlice(&function.locals)
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  if reference >= locals.length || producer >= locals.length || definitionBlock >= blocks.length { return Option<usize>.none() }
  if !run Type.equalsShared(&locals[producer].ty, &argument.ty) { return Option<usize>.none() }
  let exactType = run witnessMirLentType(&locals[reference].ty, argument, caller, expected)
  if !exactType { return Option<usize>.none() }
  let mut captured = usize.MAX
  let mut refAt = usize.MAX
  let mut refCount = usize.ZERO
  let mut blockAt = usize.ZERO
  while blockAt < blocks.length {
    let definitions = List<MirStatement>.asSlice(&blocks[blockAt].statements)
    let mut at = usize.ZERO
    while at < definitions.length {
      if let MirStatement.Assign {destination, value, ..} = &definitions[at] {
        if destination.local == reference {
          refCount = refCount + usize.ONE
          if blockAt != definitionBlock || List<MirProjection>.length(&destination.projections) != usize.ZERO { return Option<usize>.none() }
          if let MirRvalue.Ref {access, place} = &value {
            if access != expected || List<MirProjection>.length(&place.projections) != usize.ZERO { return Option<usize>.none() }
            captured = place.local
            refAt = at
          } else { return Option<usize>.none() }
        }
      }
      at = at + usize.ONE
    }
    blockAt = blockAt + usize.ONE
  }
  if refCount != usize.ONE || captured >= locals.length || captured == reference || captured == producer { return Option<usize>.none() }
  if !run Type.equalsShared(&locals[captured].ty, &argument.ty) { return Option<usize>.none() }
  let mut captureCount = usize.ZERO
  blockAt = usize.ZERO
  while blockAt < blocks.length {
    let definitions = List<MirStatement>.asSlice(&blocks[blockAt].statements)
    let mut at = usize.ZERO
    while at < definitions.length {
      if let MirStatement.Assign {destination, value, ..} = &definitions[at] {
        if destination.local == captured {
          captureCount = captureCount + usize.ONE
          if blockAt != definitionBlock || at >= refAt || List<MirProjection>.length(&destination.projections) != usize.ZERO { return Option<usize>.none() }
          if let MirRvalue.Use {value: source} = &value {
            if !witnessMirLentSource(&source, producer) { return Option<usize>.none() }
          } else { return Option<usize>.none() }
        }
      }
      at = at + usize.ONE
    }
    blockAt = blockAt + usize.ONE
  }
  if captureCount != usize.ONE { return Option<usize>.none() }
  return Option<usize>.some(captured)
}

fn witnessMirLentSource(value: &MirOperand, producer: usize) -> bool {
  if let MirOperand.Copy {place} = &value.* {
    return place.local == producer && List<MirProjection>.length(&place.projections) == usize.ZERO
  }
  if let MirOperand.Move {place} = &value.* {
    return place.local == producer && List<MirProjection>.length(&place.projections) == usize.ZERO
  }
  return false
}

struct WitnessMirLoanHeader {
  referent: Shared<Type>,
  lifetime: Shared<Lifetime>,
  access: Access,
}

fn witnessMirLoanHeader(value: &Type) -> Option<WitnessMirLoanHeader> {
  if let Type.Reference {referent, access, lifetime} = &value.* {
    return Option<WitnessMirLoanHeader>.some(WitnessMirLoanHeader {
      referent: Shared<Type>.clone(&referent), lifetime: Shared<Lifetime>.clone(&lifetime), access: access,
    })
  }
  return Option<WitnessMirLoanHeader>.none()
}

effect fn witnessMirLentType(value: &Shared<Type>, argument: &BodyCallArgument, caller: &DeclarationId, expected: Access) -> bool
! OutOfMemoryError
? &mut Allocator | &mut Types {
  let selected = Shared<Type>.with<Option<WitnessMirLoanHeader>>(value, witnessMirLoanHeader)
  if let Option<WitnessMirLoanHeader>.Some {value: header} = move selected {
    let exactRegion = Shared<Lifetime>.with<bool>(&header.lifetime, fn(value: &Lifetime) -> bool {
      if let Lifetime.Local {declaration, ordinal, ..} = &value.* {
        return DeclarationId.equals(&declaration, caller) && ordinal == argument.origin.node
      }
      return false
    })
    return header.access == expected && exactRegion && run Type.equalsShared(&header.referent, &argument.ty)
  }
  return false
}

fn witnessMirLendingParameterCount(value: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value: found} = &value.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &found.outcome {
      return List<Shared<Type>>.length(&signature.parameters)
    }
  }
  return usize.ZERO
}

fn witnessMirLendingParameter(value: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<Type>> {
  if let Result<Answer, NoRejection>.Success {value: found} = &value.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &found.outcome {
      let parameters = List<Shared<Type>>.asSlice(&signature.parameters)
      if at < parameters.length { return Option<Shared<Type>>.some(Shared<Type>.clone(&parameters[at])) }
    }
  }
  return Option<Shared<Type>>.none()
}

effect fn witnessMirLendingSignature(value: &Shared<Result<Answer, NoRejection>>, loans: &[Shared<Type>]) -> bool
! OutOfMemoryError
? &mut Allocator | &mut Types {
  if loans.length != 3 || Shared<Result<Answer, NoRejection>>.with<usize>(value, witnessMirLendingParameterCount) != 3 { return false }
  let mut at = usize.ZERO
  while at < loans.length {
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(value,
      fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return witnessMirLendingParameter(value, at) })
    if let Option<Shared<Type>>.Some {value: parameter} = move selected {
      if !run Type.equalsShared(&parameter, &loans[at]) { return false }
    } else { return false }
    at = at + usize.ONE
  }
  return true
}

// An interface operation's own type arguments are recorded at its call, so the call lowers to its
// specialized witness without a gap and without reading the witness body.
test effect fn witnessMirRecordsOperationInputs() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("b12-operation-input-gap.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
interface Extra { fn use<U>(value: Self, item: U) -> i32 }
struct Maker {}
impl Extra for Maker { fn use<T>(value: Self, item: T) -> i32 { return missing } }
fn caller() -> i32 { return Extra.use(Maker {}, 42) }
"""
  let mut store = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"caller") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let gap = Shared<Result<Answer, NoRejection>>.with<Option<Shared<BackendGap>>>(&answer, selectedBackendGap)
  let lowered = match move gap {
    Option<Shared<BackendGap>>.Some {..} => false
    _ => succeeded(&answer)
  }
  run Testing.expect(lowered && starts(Semantic.eventLog(&store), Family.Body) == usize.ONE,
    "a call fixing an operation's own type argument lowers without a gap and without reading the witness body")
  return ()
}


test effect fn genericPolymorphicRecursionBuildRetainsRejectedApplicationPath() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("b12main.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("b12library.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
struct Box<T> { value: T }
pub fn expand<T>(value: T) -> i32 { return expand<Box<T>>(Box<T> { value: move value }) }
"""
  let entrySource = run present("""
import b12library {expand}
pub fn main() -> i32 { return expand<i32>(1) }
""") |> Effect.provideMut<Allocator>(&mut allocator)
  let librarySource = run present(source) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &entrySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let held = run Revision.publish(&first, &library, &librarySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = makeSemantic(run withEntryRuntime(&held) |> Effect.provideMut<Allocator>(&mut allocator))
  let mut request = Request.forApplication(ModuleId.copy(&entry))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let rejected = match & built {
    BackendBuild.Rejected {first: diagnostic, ..} => Shared<Rejection>.with<bool>(&diagnostic, fn(value: &Rejection) -> bool {
      if value.code != RejectionCode.ExpandingSpecialization || !ModuleId.equals(&value.module, &library) { return false }
      // The whole declaration whose call grows the specialization (SEM0053).
      let spelling = "pub fn expand<T>(value: T) -> i32 { return expand<Box<T>>(Box<T> { value: move value }) }"
      let start = offsetOf(source, spelling, usize.ZERO)
      if value.span.start != start || value.span.end != start + String.utf8Bytes(spelling).length { return false }
      let path = List<SpecializationApplication>.asSlice(&value.specialization)
      if path.length != 2 { return false }
      let original = SpecializationApplication.bodyDeclaration(&path[usize.ZERO])
      let recursive = SpecializationApplication.bodyDeclaration(&path[usize.ONE])
      if !DeclarationId.equals(original, recursive) || !DeclarationId.named(original, b"expand") { return false }
      let scalar = match move b12SingleArgumentType(&path[usize.ZERO].arguments) {
        Option<Shared<Type>>.Some {value: ty} => Shared<Type>.with<bool>(&ty, b12IntegerType)
        Option<Shared<Type>>.None => false
      }
      let boxed = match move b12SingleArgumentType(&path[usize.ONE].arguments) {
        Option<Shared<Type>>.Some {value: ty} => Shared<Type>.with<bool>(&ty, b12BoxIntegerType)
        Option<Shared<Type>>.None => false
      }
      return scalar && boxed
    })
    _ => false
  }
  run Testing.expect(rejected, "expanding direct recursion retains i32 to Box<i32> and the imported caller's declaration")
  return ()
}

// Plain generic recursion may move a type argument into the owned structure of the earlier one
// (GEN-006): `visit<Outer>` reaching `visit<Inner>` builds, because `Inner` is a field type of
// `Outer`. Moving the other way, out of the owned structure, stays SEM0053.
test effect fn genericRecursionIntoOwnedFieldBuilds() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("b13main.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("b13library.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let librarySource = run present("""
pub struct Inner { value: i32 }
pub struct Outer { inner: Inner }
pub fn visit<T>(depth: i32) -> i32 {
  if depth == 0 { return 0 }
  return visit<Inner>(depth - 1)
}
pub fn escape<T>(depth: i32) -> i32 {
  if depth == 0 { return 0 }
  return escape<Outer>(depth - 1)
}
""") |> Effect.provideMut<Allocator>(&mut allocator)
  let descending = run b13Build(&entry, &library, &librarySource, "import b13library {Outer, visit}\npub fn main() -> i32 { return visit<Outer>(2) }\n")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let built = match & descending { BackendBuild.Module {..} => true _ => false }
  run Testing.expect(built, "recursion from visit<Outer> into its field type Inner builds")
  let escaping = run b13Build(&entry, &library, &librarySource, "import b13library {Inner, escape}\npub fn main() -> i32 { return escape<Inner>(2) }\n")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let refused = match & escaping {
    BackendBuild.Rejected {first: diagnostic, ..} => Shared<Rejection>.with<bool>(&diagnostic, fn(value: &Rejection) -> bool {
      return value.code == RejectionCode.ExpandingSpecialization
    })
    _ => false
  }
  run Testing.expect(refused, "recursion from escape<Inner> to Outer, outside Inner's owned structure, stays SEM0053")
  return ()
}

effect fn b13Build(entry: &ModuleId, library: &ModuleId, librarySource: &Option<Bytes>, entryText: string) -> BackendBuild
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let entrySource = run present(entryText)
  let first = run Revision.publish(&Revision.make(), entry, &entrySource)
  let held = run Revision.publish(&first, library, librarySource)
  let mut store = makeSemantic(run withEntryRuntime(&held))
  let mut request = Request.forApplication(ModuleId.copy(entry))
  return run buildApplication(&mut store, &mut request, staticClosureNodes)
}

// A Drop hook's cleanup may reach the same hook at a smaller type argument owned by the value it
// started from (GEN-006): `Bag<Wrap>` drops a `Wrap` that owns a `Bag<u8>`. Growth beyond that
// owned structure inside the cleanup keeps the ordinary recursion guard.
test effect fn cleanupReentryStaysWithinItsOwnedRoot() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run cleanupReentryClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn cleanupReentryClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let owned = run module("cleanup-owned-reentry.silk")
  let ownedText = """
struct Wrap { inner: Bag<u8> }
struct Bag<T> { buffer: Intrinsic.RawBuffer<T> }
impl<T> Intrinsic.Drop for Bag<T> {
  fn drop(self: &mut Bag<T>) -> () { return release<T>(&mut self.buffer) }
}
fn release<T>(buffer: &mut Intrinsic.RawBuffer<T>) -> () {
  unsafe {
    let slot = Intrinsic.rawBufferSlot<T>(buffer, 0)
    return Intrinsic.slotDrop<T>(move slot)
  }
}
fn absurd<T>() -> T { return absurd<T>() }
pub fn main() -> i32 {
  let nested = absurd<Bag<Wrap>>()
  return 0
}
"""
  let mut ownedStore = run applicationSemantic(&owned, ownedText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut ownedRequest = Request.forApplication(ModuleId.copy(&owned))
  let descended = run buildApplication(&mut ownedStore, &mut ownedRequest, staticClosureNodes)
  run Testing.expect(match &descended { BackendBuild.Module {..} => true _ => false },
    "a hook's cleanup re-enters the hook and its helpers at a type argument its root owns")
  let growing = run module("cleanup-growing-reentry.silk")
  let growingText = """
struct Grow<T> { buffer: Intrinsic.RawBuffer<T> }
impl<T> Intrinsic.Drop for Grow<T> {
  fn drop(self: &mut Grow<T>) -> () {
    let bigger = absurd<Grow<Grow<T>>>()
    return ()
  }
}
fn absurd<T>() -> T { return absurd<T>() }
pub fn main() -> i32 {
  let grown = absurd<Grow<i32>>()
  return 0
}
"""
  let mut growingStore = run applicationSemantic(&growing, growingText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut growingRequest = Request.forApplication(ModuleId.copy(&growing))
  let grew = run buildApplication(&mut growingStore, &mut growingRequest, staticClosureNodes)
  let refused = match &grew {
    BackendBuild.Rejected {first: diagnostic, ..} => Shared<Rejection>.with<bool>(&diagnostic, fn(value: &Rejection) -> bool {
      let path = List<SpecializationApplication>.asSlice(&value.specialization)
      return value.code == RejectionCode.ExpandingSpecialization && path.length > usize.ONE
        && DeclarationId.named(SpecializationApplication.bodyDeclaration(&path[usize.ZERO]), b"drop")
        && DeclarationId.named(SpecializationApplication.bodyDeclaration(&path[path.length - usize.ONE]), b"drop")
    })
    _ => false
  }
  run Testing.expect(refused, "a hook whose cleanup drops a value outside its root's owned structure still grows")
  let independent = run module("independent-refusals.silk")
  let independentText = """
struct Box<T> { value: T }
fn left<T>(value: T) -> i32 { return left<Box<T>>(Box<T> { value: move value }) }
fn right<T>(value: T) -> i32 { return right<Box<T>>(Box<T> { value: move value }) }
pub fn main() -> i32 { return left<i32>(1) + right<i32>(2) }
"""
  let mut independentStore = run applicationSemantic(&independent, independentText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut independentRequest = Request.forApplication(ModuleId.copy(&independent))
  let refusedBoth = run buildApplication(&mut independentStore, &mut independentRequest, staticClosureNodes)
  let leftStart = offsetOf(independentText, "fn left<T>", usize.ZERO)
  let rightStart = offsetOf(independentText, "fn right<T>", usize.ZERO)
  let mut starts = List<usize>.make()
  let mut reportedBoth = false
  if let BackendBuild.Rejected {first, further, ..} = &refusedBoth {
    run List<usize>.append(&mut starts, expandingStart(&first))
    let others = List<Shared<Rejection>>.asSlice(&further)
    if others.length == usize.ONE { run List<usize>.append(&mut starts, expandingStart(&others[usize.ZERO])) }
    let found = List<usize>.asSlice(&starts)
    reportedBoth = found.length == 2 && ((found[usize.ZERO] == leftStart && found[usize.ONE] == rightStart)
      || (found[usize.ZERO] == rightStart && found[usize.ONE] == leftStart))
  }
  run Testing.expect(reportedBoth, "a build walks past a refused instance and reports each independent refusal once")
  let delegating = run module("witness-nongrowing.silk")
  let delegatingText = """
interface Decode { effect fn decode(input: &i32) -> Self }
effect fn decodeOne<T: Decode>(input: &i32) -> T { return run Decode.decode(input) }
impl Decode for i32 { effect fn decode(input: &i32) -> Self { return input.* } }
struct Point { x: i32, y: i32 }
impl Decode for Point {
  effect fn decode(input: &i32) -> Self {
    let x = run decodeOne<i32>(input)
    return Point { x: x, y: x }
  }
}
pub fn main() -> i32 {
  let seed: i32 = 20
  let point = run decodeOne<Point>(&seed)
  return point.x + point.y
}
"""
  let mut delegatingStore = run applicationSemantic(&delegating, delegatingText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut delegatingRequest = Request.forApplication(ModuleId.copy(&delegating))
  let delegated = run buildApplication(&mut delegatingStore, &mut delegatingRequest, staticClosureNodes)
  run Testing.expect(match &delegated { BackendBuild.Module {..} => true _ => false },
    "a witness delegates through a helper to a concrete application whose type arguments do not grow (GEN-006)")
  return ()
}

// The start of an expanding-specialization refusal, or `usize.MAX` for any other diagnostic.
fn expandingStart(diagnostic: &Shared<Rejection>) -> usize {
  return Shared<Rejection>.with<usize>(diagnostic, fn(value: &Rejection) -> usize {
    if value.code != RejectionCode.ExpandingSpecialization { return usize.MAX }
    return value.span.start
  })
}

fn b12IntegerType(value: &Type) -> bool {
  return match & value.* { Type.Primitive {name} => sameBytes(Bytes.asSlice(&name), b"i32")
    _ => false
  }
}

fn b12BoxIntegerType(value: &Type) -> bool {
  return match &value.* {
    Type.Nominal {declaration, arguments, ..} => {
      if !DeclarationId.named(&declaration, b"Box") { return false }
      let listed = List<Argument>.asSlice(&arguments)
      if listed.length != usize.ONE { return false }
      return match &listed[usize.ZERO] {
        Argument.Type {value: ty} => Shared<Type>.with<bool>(&ty, b12IntegerType)
        _ => false
      }
    }
    _ => false
  }
}

fn b12SingleArgumentType(arguments: &List<Argument>) -> Option<Shared<Type>> {
  let listed = List<Argument>.asSlice(arguments)
  if listed.length != usize.ONE { return Option<Shared<Type>>.none() }
  return match & listed[usize.ZERO] {
    Argument.Type {value: ty} => Option<Shared<Type>>.some(Shared<Type>.clone(&ty))
    _ => Option<Shared<Type>>.none()
  }
}

test effect fn genericRecursiveResultKeepsCallerParameter() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("b12-recursive-result.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
struct Box<T> { value: T }
fn repeat<T>(value: T, count: i32) -> T {
  if count == 0 { return move value }
  return repeat<T>(move value, count - 1)
}
fn wrong<T>(argument: T) -> i32 { return wrong<Box<T>>(move argument) }
pub fn main() -> i32 { return repeat<i32>(42, 1) }
"""
  let mut store = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let repeat = run Semantic.demandBody(&mut store, &mut request, &id, b"repeat") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&repeat, checkedBody)
  let canonical = match move body {
    Option<Shared<TypedBody>>.Some {value} => Shared<TypedBody>.with<bool>(&value, b12RepeatHasCanonicalCallerResult)
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(canonical && Shared<Result<Answer, NoRejection>>.with<bool>(&repeat, bodyAnswerIsTyped),
    "recursive result and completed type argument retain the authored caller T")
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.TypeMismatch, source, "move argument", usize.ZERO),
    "fresh callee binders do not admit a caller T where Box<T> is required")
  return ()
}

fn b12RepeatHasCanonicalCallerResult(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.DirectCall {declaration, application, ..}} = &nodes[at].kind {
      if DeclarationId.named(&declaration, b"repeat") {
        let resultIsCaller = Shared<Type>.with<usize>(&ty, fn(value: &Type) -> usize {
          return Type.parameterOrdinalOf(value, &declaration)
        }) == usize.ZERO
        let argumentIsCaller = Shared<SpecializationApplication>.with<bool>(&application, fn(value: &SpecializationApplication) -> bool {
          return b12ArgumentIsCaller(&value.arguments, &declaration)
        })
        return resultIsCaller && argumentIsCaller
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn b12ArgumentIsCaller(arguments: &List<Argument>, declaration: &DeclarationId) -> bool {
  let single = b12SingleArgumentType(arguments)
  if let Option<Shared<Type>>.Some {value} = move single {
    return Shared<Type>.with<usize>(&value, fn(argument: &Type) -> usize {
      return Type.parameterOrdinalOf(argument, declaration)
    }) == usize.ZERO
  }
  return false
}

test effect fn genericAggregateBorrowContextKeepsCallerRegions() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("genericAggregateBorrowContextKeepsCallerRegions.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
tuple Witness<'a>(&'a i32)
fn consume<'a>(values: [&'a i32; 1], witness: &'a i32) -> i32 { return 42 }
fn consumeTuple<'a>(values: Witness<'a>, witness: &'a i32) -> i32 { return 42 }
fn arrayCall() -> i32 { let value = 42 return consume([&value], &value) }
fn tupleCall() -> i32 { let value = 42 return consumeTuple((&value,), &value) }
fn permanent() -> i32 { let value = 42 return consume<'static>([&value], &value) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let array = run Semantic.demandBody(&mut store, &mut request, &id, b"arrayCall") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let tupleAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"tupleCall") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let arrayBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&array, checkedBody)
  let tupleBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&tupleAnswer, checkedBody)
  let arrayCanonical = match move arrayBody {
    Option<Shared<TypedBody>>.Some {value} => Shared<TypedBody>.with<bool>(&value, b12AggregateRegionsAreCanonical)
    Option<Shared<TypedBody>>.None => false
  }
  let tupleCanonical = match move tupleBody {
    Option<Shared<TypedBody>>.Some {value} => Shared<TypedBody>.with<bool>(&value, b12AggregateRegionsAreCanonical)
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(arrayCanonical && tupleCanonical
    && Shared<Result<Answer, NoRejection>>.with<bool>(&array, bodyAnswerIsTyped)
    && Shared<Result<Answer, NoRejection>>.with<bool>(&tupleAnswer, bodyAnswerIsTyped),
    "nested array and nominal tuple operands plus completed call arguments retain only caller regions")
  let permanent = run Semantic.demandBody(&mut store, &mut request, &id, b"permanent") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&permanent, RejectionCode.UnsatisfiedLifetimeBound, text, "&value", 4),
    "explicit static arguments cannot manufacture static evidence for a written aggregate borrow")
  return ()
}

test effect fn genericAggregateForwardingKeepsCallerRegions() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("genericAggregateForwardingKeepsCallerRegions.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
tuple Witness<'a>(&'a i32)
fn consume<'a>(values: [&'a i32; 1], witness: &'a i32) -> i32 { return 42 }
fn consumeTuple<'a>(values: Witness<'a>, witness: &'a i32) -> i32 { return 42 }
fn forwardArray<'b>(reference: &'b i32) -> i32 { return consume([reference], reference) }
fn forwardTuple<'b>(reference: &'b i32) -> i32 { return consumeTuple((reference,), reference) }
fn relay<'a>(value: Witness<'a>) -> Witness<'a> { return move value }
fn forwardValues<'b>(values: [&'b i32; 1], pair: Witness<'b>, reference: &'b i32) -> i32 {
  let first = consume(move values, reference)
  return first + consumeTuple(relay<'b>(move pair), reference)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let forwardedArray = run Semantic.demandBody(&mut store, &mut request, &id, b"forwardArray") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let forwardedTuple = run Semantic.demandBody(&mut store, &mut request, &id, b"forwardTuple") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let forwardedArrayBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&forwardedArray, checkedBody)
  let forwardedTupleBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&forwardedTuple, checkedBody)
  let arrayForwarding = match move forwardedArrayBody {
    Option<Shared<TypedBody>>.Some {value} => Shared<TypedBody>.with<bool>(&value, b12ForwardRegionsAreCanonical)
    Option<Shared<TypedBody>>.None => false
  }
  let tupleForwarding = match move forwardedTupleBody {
    Option<Shared<TypedBody>>.Some {value} => Shared<TypedBody>.with<bool>(&value, b12ForwardRegionsAreCanonical)
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(arrayForwarding && tupleForwarding
    && Shared<Result<Answer, NoRejection>>.with<bool>(&forwardedArray, bodyAnswerIsTyped)
    && Shared<Result<Answer, NoRejection>>.with<bool>(&forwardedTuple, bodyAnswerIsTyped),
    "existing references retain the caller lifetime parameter through operands, parent aggregates and call arguments")
  let forwardedValues = run Semantic.demandBody(&mut store, &mut request, &id, b"forwardValues") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let valueBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&forwardedValues, checkedBody)
  let valueCanonical = match move valueBody {
    Option<Shared<TypedBody>>.Some {value} => Shared<TypedBody>.with<bool>(&value, b12ValueRegionsAreCanonical)
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(valueCanonical && Shared<Result<Answer, NoRejection>>.with<bool>(&forwardedValues, bodyAnswerIsTyped),
    "existing arrays, moved nominal values and relay results retain the authored caller lifetime in all operands and calls")
  return ()
}

test effect fn genericAggregateMixedBindersKeepCallerRegions() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("genericAggregateMixedBindersKeepCallerRegions.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
fn consumeMixed<'a, T>(values: [&'a T; 1], witness: &'a T, scalar: T) -> i32 { return 42 }
fn mixedForward<'b>(reference: &'b u8) -> i32 { return consumeMixed([reference], reference, 42) }
fn mixedBorrow(value: u8) -> i32 { return consumeMixed([&value], &value, 42) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let mixed = run Semantic.demandBody(&mut store, &mut request, &id, b"mixedForward") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mixedBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&mixed, checkedBody)
  let mixedCanonical = match move mixedBody {
    Option<Shared<TypedBody>>.Some {value} => Shared<TypedBody>.with<bool>(&value, b12MixedRegionsAreCanonical)
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(mixedCanonical && Shared<Result<Answer, NoRejection>>.with<bool>(&mixed, bodyAnswerIsTyped),
    "lifetime-first type-second binders retain their written slots, narrow literal context and canonical caller evidence")
  let mixedBorrow = run Semantic.demandBody(&mut store, &mut request, &id, b"mixedBorrow") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mixedBorrowBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&mixedBorrow, checkedBody)
  let mixedBorrowCanonical = match move mixedBorrowBody {
    Option<Shared<TypedBody>>.Some {value} => Shared<TypedBody>.with<bool>(&value, b12MixedBorrowRegionsAreCanonical)
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(mixedBorrowCanonical && Shared<Result<Answer, NoRejection>>.with<bool>(&mixedBorrow, bodyAnswerIsTyped),
    "mixed-order written borrows infer u8 before the final scalar literal receives its narrow type context")
  return ()
}

fn b12CallerRegion(region: &Lifetime, caller: &DeclarationId, ordinal: usize, parameterRegion: bool) -> bool {
  return match &region.* {
    Lifetime.Local {declaration, ordinal: found, ..} => !parameterRegion && found == ordinal && DeclarationId.equals(&declaration, caller)
    Lifetime.Parameter {declaration, ordinal: found} => parameterRegion && found == usize.ZERO && DeclarationId.equals(&declaration, caller)
    _ => false
  }
}

fn b12ContextTypeIsCanonical(value: &Type, caller: &DeclarationId, ordinal: usize, parameterRegion: bool) -> bool {
  return match &value.* {
    Type.Primitive {..} => true
    Type.Unit => true
    Type.Reference {referent, lifetime, ..} => Shared<Lifetime>.with<bool>(&lifetime,
      fn(region: &Lifetime) -> bool { return b12CallerRegion(region, caller, ordinal, parameterRegion) })
      && Shared<Type>.with<bool>(&referent, fn(nested: &Type) -> bool { return b12ContextTypeIsCanonical(nested, caller, ordinal, parameterRegion) })
    Type.Array {element, ..} => Shared<Type>.with<bool>(&element,
      fn(nested: &Type) -> bool { return b12ContextTypeIsCanonical(nested, caller, ordinal, parameterRegion) })
    Type.Nominal {arguments, ..} => {
      let listed = List<Argument>.asSlice(&arguments)
      if listed.length != usize.ONE { return false }
      return match &listed[usize.ZERO] {
        Argument.Lifetime {value: region} => Shared<Lifetime>.with<bool>(&region,
          fn(lifetime: &Lifetime) -> bool { return b12CallerRegion(lifetime, caller, ordinal, parameterRegion) })
        _ => false
      }
    }
    _ => false
  }
}

fn b12AggregateRegionsAreCanonical(body: &TypedBody) -> bool {
  return b12AggregateRegionEvidence(body, false, false)
}

fn b12ForwardRegionsAreCanonical(body: &TypedBody) -> bool {
  return b12AggregateRegionEvidence(body, true, false)
}

fn b12MixedRegionsAreCanonical(body: &TypedBody) -> bool {
  return b12AggregateRegionEvidence(body, true, true)
}

fn b12MixedBorrowRegionsAreCanonical(body: &TypedBody) -> bool {
  return b12AggregateRegionEvidence(body, false, true)
}

fn b12AggregateRegionEvidence(body: &TypedBody, parameterRegion: bool, mixed: bool) -> bool {
  let caller = TypedBody.declarationId(body)
  let nodes = TypedBody.nodeSlice(body)
  let mut callOrdinal = usize.MAX
  let mut calls = usize.ZERO
  let mut borrows = usize.ZERO
  let mut aggregates = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {application, ..}, ..} = &nodes[at].kind {
      callOrdinal = nodes[at].origin.node
      if !Shared<SpecializationApplication>.with<bool>(&application, fn(value: &SpecializationApplication) -> bool {
        return b12ArgumentsLifetimeCanonical(&value.arguments, caller, callOrdinal, parameterRegion, mixed)
      }) { return false }
      calls = calls + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form} = &nodes[at].kind {
      if !Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool { return b12ContextTypeIsCanonical(value, caller, callOrdinal, parameterRegion) }) { return false }
      if let BodyExpression.Borrow {..} = &form { borrows = borrows + usize.ONE }
      if let BodyExpression.Aggregate {..} = &form { aggregates = aggregates + usize.ONE }
    }
    at = at + usize.ONE
  }
  return calls == usize.ONE && aggregates == usize.ONE && ((parameterRegion && borrows == usize.ZERO) || (!parameterRegion && borrows == 2))
}

fn b12ArgumentsLifetimeCanonical(arguments: &List<Argument>, caller: &DeclarationId, ordinal: usize, parameterRegion: bool, mixed: bool) -> bool {
  let supplied = List<Argument>.asSlice(arguments)
  let mut count = usize.ONE
  if mixed { count = 2 }
  if supplied.length != count { return false }
  if mixed {
    let scalar = match &supplied[usize.ONE] {
      Argument.Type {value} => Shared<Type>.with<bool>(&value, fn(ty: &Type) -> bool {
        return match &ty.* { Type.Primitive {name} => sameBytes(Bytes.asSlice(&name), b"u8") _ => false }
      })
      _ => false
    }
    if !scalar { return false }
  }
  if let Argument.Lifetime {value} = &supplied[usize.ZERO] {
    return Shared<Lifetime>.with<bool>(&value,
      fn(lifetime: &Lifetime) -> bool { return b12CallerRegion(lifetime, caller, ordinal, parameterRegion) })
  }
  return false
}

fn b12ValueRegionsAreCanonical(body: &TypedBody) -> bool {
  let caller = TypedBody.declarationId(body)
  let nodes = TypedBody.nodeSlice(body)
  let mut calls = usize.ZERO
  let mut relay = false
  let mut array = false
  let mut tupleValue = false
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form} = &nodes[at].kind {
      if !Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool {
        return b12ContextTypeIsCanonical(value, caller, usize.MAX, true)
      }) { return false }
      array = array || Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool {
        return match &value.* { Type.Array {..} => true _ => false }
      })
      tupleValue = tupleValue || Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool {
        return match &value.* { Type.Nominal {declaration, ..} => DeclarationId.named(&declaration, b"Witness") _ => false }
      })
      if let BodyExpression.DirectCall {declaration, application, ..} = &form {
        if !Shared<SpecializationApplication>.with<bool>(&application, fn(value: &SpecializationApplication) -> bool {
        return b12ArgumentsLifetimeCanonical(&value.arguments, caller, usize.MAX, true, false)
      }) { return false }
        relay = relay || DeclarationId.named(&declaration, b"relay")
        calls = calls + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return calls == 3 && relay && array && tupleValue
}

fn anonymousTargetSpecializationApplication(target: &SpecializationApplication) -> bool {
  return DeclarationId.kind(SpecializationApplication.bodyDeclaration(target)) == OwnerKind.Anonymous
}

fn captureContractMode(ty: &Type) -> CallableMode {
  return match &ty.* {
    Type.Callable {mode, ..} => mode
    _ => CallableMode.Once
  }
}

fn anonymousCaptureFacts(body: &TypedBody, mode: CallableMode, first: usize, second: usize, count: usize, borrowed: bool) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Callable {body: anonymous, fields, ..}} = &nodes[at].kind {
      if List<BodyAggregateField>.length(&fields) != count { return false }
      let selected = Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool {
        if let Type.CallableValue {contract, captures, application, ..} = &value.* {
          if List<Shared<Type>>.length(&captures) != count || Shared<Type>.with<CallableMode>(&contract, captureContractMode) != mode { return false }
          return Shared<SpecializationApplication>.with<bool>(&application, anonymousTargetSpecializationApplication)
        }
        return false
      })
      if !selected { return false }
      return Shared<TypedBody>.with<bool>(&anonymous, fn(checked: &TypedBody) -> bool {
        let available = TypedBody.environmentOf(checked)
        if let Option<BodyEnvironment>.Some {value: environment} = &available.* {
          let captures = List<BodyEnvironmentCapture>.asSlice(&environment.captures)
          if captures.length != count { return false }
          if count > usize.ZERO && (captures[usize.ZERO].local.index != first || captures[usize.ZERO].dereference != borrowed) { return false }
          if count > usize.ONE && captures[usize.ONE].local.index != second { return false }
          return true
        }
        return false
      })
    }
    at = at + usize.ONE
  }
  return false
}

fn captureBodyMatches(answer: &Result<Answer, NoRejection>, mode: CallableMode, first: usize, second: usize, count: usize, borrowed: bool) -> bool {
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedBody(answer) {
    return Shared<TypedBody>.with<bool>(&body, fn(value: &TypedBody) -> bool {
      return anonymousCaptureFacts(value, mode, first, second, count, borrowed)
    })
  }
  return false
}

// Independent capture policy: first lexical use owns the field order, Copy is a snapshot,
// an affine read retains a loan, assignment upgrades access, and affine move consumes once.
// Before Step 8b every literal rejected at its written expression; no earlier source claim
// reached capture types or hidden bodies. This uses existing semantic demands and production data.
test effect fn anonymousBodiesRetainOrderedCaptureModes() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run anonymousCaptureClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn anonymousCaptureClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("captures.silk")
  let text = """
struct Token { value: i32 }
fn copied(first: i32, second: i32) -> () {
  let closure = fn() -> i32 { return second + first + second }
}
fn borrowed(token: Token) -> () {
  let closure = fn() -> i32 { return token.value }
}
fn mutated() -> () {
  let mut counter = 1
  let closure = fn() -> () { counter = 2 }
}
fn consumed(token: Token) -> () {
  let closure = fn() -> Token { return move token }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copied")
  let borrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowed")
  let mutated = run Semantic.demandBody(&mut store, &mut request, &id, b"mutated")
  let consumed = run Semantic.demandBody(&mut store, &mut request, &id, b"consumed")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&copied, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Shared, usize.ONE, usize.ZERO, 2, false)
  }), "Copy captures follow first use and retain one field per binding")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&borrowed, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Shared, usize.ZERO, usize.MAX, usize.ONE, true)
  }), "reading an affine owner retains a shared capture loan")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&mutated, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Mutable, usize.ZERO, usize.MAX, usize.ONE, true)
  }), "an assignment-only capture retains an exclusive loan and requires mutable invocation")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&consumed, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Once, usize.ZERO, usize.MAX, usize.ONE, false)
  }), "an affine move transfers its owner into a once environment")
}

test effect fn anonymousViewsRetainSourceValidityAndInvocation() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run anonymousViewClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn anonymousViewClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("capture-views.silk")
  let text = """
fn readView<'a>(view: &'a i32) -> () {
  let closure = fn() -> i32 { return view.* }
}
fn moveView<'a>(view: &'a i32) -> () {
  let closure = fn() -> &'a i32 { return move view }
}
fn dropView<'a>(view: &'a i32) -> () {
  let closure = fn() -> () { drop view }
}
fn invoke(value: i32) -> i32 {
  let closure = fn(addend: i32) -> i32 { return value + addend }
  return closure(2)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let readView = run Semantic.demandBody(&mut store, &mut request, &id, b"readView")
  let moveView = run Semantic.demandBody(&mut store, &mut request, &id, b"moveView")
  let dropView = run Semantic.demandBody(&mut store, &mut request, &id, b"dropView")
  let invoked = run Semantic.demandBody(&mut store, &mut request, &id, b"invoke")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&readView, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Shared, usize.ZERO, usize.MAX, usize.ONE, false)
  }) && Shared<Result<Answer, NoRejection>>.with<bool>(&moveView, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Once, usize.ZERO, usize.MAX, usize.ONE, false)
  }) && Shared<Result<Answer, NoRejection>>.with<bool>(&dropView, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Shared, usize.ZERO, usize.MAX, usize.ONE, false)
  }), "view descriptors retain source validity while explicit move alone requires once invocation")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&readView,
    fn(answer: &Result<Answer, NoRejection>) -> bool { return anonymousRegionFacts(answer, usize.ONE) }) &&
    Shared<Result<Answer, NoRejection>>.with<bool>(&dropView,
    fn(answer: &Result<Answer, NoRejection>) -> bool { return anonymousRegionFacts(answer, usize.ONE) }),
    "capture fields and the callable environment both retain the source parameter lifetime")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&invoked, anonymousInvocationFacts),
    "a stored closure call retains its exact receiver and invocation mode")
}

test effect fn anonymousPatternsRetainParentPlaces() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run anonymousPatternClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn anonymousPatternClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("capture-patterns.silk")
  let text = """
struct Token { value: i32 }
struct Envelope { token: Token }
fn patternCapture(token: Token) -> () {
  match &token { Token { value: patternValue } => {
    let closure = fn() -> i32 { return patternValue }
  } }
}
fn borrowedPatternCapture(envelope: Envelope) -> () {
  match &envelope { Envelope { token: patternToken } => {
    let closure = fn() -> i32 { return patternToken.value }
  } }
}
fn movedPatternCapture(envelope: Envelope) -> () {
  match move envelope { Envelope { token: ownedToken } => {
    let closure = fn() -> Token { return move ownedToken }
  } }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let pattern = run Semantic.demandBody(&mut store, &mut request, &id, b"patternCapture")
  let borrowedPattern = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowedPatternCapture")
  let movedPattern = run Semantic.demandBody(&mut store, &mut request, &id, b"movedPatternCapture")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&pattern, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Shared, usize.ONE, usize.MAX, usize.ONE, false)
  }) && Shared<Result<Answer, NoRejection>>.with<bool>(&borrowedPattern, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Shared, usize.ONE, usize.MAX, usize.ONE, true)
  }) && Shared<Result<Answer, NoRejection>>.with<bool>(&movedPattern, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Once, usize.ONE, usize.MAX, usize.ONE, false)
  }), "pattern captures retain their parent Copy, borrowed, or moved place")
}

test effect fn anonymousCapturesKeepOwnershipAndUnsafeSpans() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run anonymousCaptureRejections() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn anonymousCaptureRejections() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("capture-rejections.silk")
  let text = """
struct Token { value: i32 }
struct Envelope { token: Token }
fn invalidMutation() -> () {
  let mut counter = 0
  let blocked = fn() -> () { counter = 1 }
  blocked()
}
fn invalidPatternCapture(envelope: Envelope) -> () {
  match &envelope { Envelope { token: loanedToken } => {
    let closure = fn() -> Token { let earlier = loanedToken.value return move loanedToken }
  } }
}
unsafe fn guarded(value: i32) -> i32 { return value }
fn delayedUnsafe() -> () {
  unsafe { let closure = fn() -> i32 { return guarded(42) } }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let invalidMutation = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidMutation")
  let invalidPattern = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidPatternCapture")
  let delayedUnsafe = run Semantic.demandBody(&mut store, &mut request, &id, b"delayedUnsafe")
  run Testing.expect(rejectsSpan(&invalidMutation, RejectionCode.InvalidCallableInvocationAccess, text, "blocked", usize.ONE),
    "mutable callable invocation requires a mutable binding at the callee span")
  run Testing.expect(rejectsSpan(&invalidPattern, RejectionCode.MatchBorrowEscape, text, "move loanedToken", usize.ZERO),
    "borrowed pattern capture ownership diagnostics name the requesting operation")
  run Testing.expect(rejectsSpan(&delayedUnsafe, RejectionCode.UnsafeAcknowledgement, text, "guarded(42)", usize.ZERO),
    "permission at construction does not authorize an unsafe delayed body")
}

fn anonymousInvocationFacts(answer: &Result<Answer, NoRejection>) -> bool {
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedBody(answer) {
    return Shared<TypedBody>.with<bool>(&body, fn(value: &TypedBody) -> bool {
      let nodes = TypedBody.nodeSlice(value)
      let mut at = usize.ZERO
      while at < nodes.length {
        if let BodyNodeKind.Expression {form: BodyExpression.CallableCall {callee, mode, arguments, pipeline, ..}, ..} = &nodes[at].kind {
          if mode != CallableMode.Shared || pipeline || List<BodyNodeId>.length(&arguments) != usize.ONE { return false }
          if let BodyNodeKind.Expression {ty, ..} = &nodes[callee.index].kind {
            return Shared<Type>.with<bool>(&ty, exactCallableValue)
          }
        }
        at = at + usize.ONE
      }
      return false
    })
  }
  return false
}

test effect fn anonymousCapturesRejectUnavailableOwners() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run unavailableCaptureClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn unavailableCaptureClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("unavailable-captures.silk")
  let text = """
struct Token { value: i32 }
fn ended(gone: Token) -> () { drop gone let closure = fn() -> i32 { return gone.value } }
fn copiedEnded(copiedSource: i32) -> () { drop copiedSource let closure = fn() -> i32 { return copiedSource } }
fn branchEnded(branchSource: Token, flag: bool) -> () {
  if flag { drop branchSource }
  let closure = fn() -> i32 { return branchSource.value }
}
fn onceEnded(onceSource: Token) -> () {
  let first = fn() -> Token { return move onceSource }
  let second = fn() -> i32 { return onceSource.value }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let ended = run Semantic.demandBody(&mut store, &mut request, &id, b"ended")
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copiedEnded")
  let branched = run Semantic.demandBody(&mut store, &mut request, &id, b"branchEnded")
  let transferred = run Semantic.demandBody(&mut store, &mut request, &id, b"onceEnded")
  run Testing.expect(rejectsSpan(&ended, RejectionCode.UseAfterMove, text, "gone", 2) &&
    rejectsSpan(&copied, RejectionCode.UseAfterMove, text, "copiedSource", 2),
    "captures cannot acquire consumed affine or cleanup-free Copy storage")
  run Testing.expect(rejectsSpan(&branched, RejectionCode.UseAfterMove, text, "branchSource", 2) &&
    rejectsSpan(&transferred, RejectionCode.UseAfterMove, text, "onceSource", 2),
    "any completing consumed path prevents a later capture, including a once environment transfer")
}

test effect fn anonymousCapturesRespectRepairAndTerminatedEdges() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run captureRepairClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn captureRepairClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("capture-repairs.silk")
  let text = """
struct Token { value: i32 }
struct Pair { left: Token, right: Token }
fn repaired(value: i32) -> () {
  let mut rebuilt = value drop rebuilt rebuilt = 9
  let closure = fn() -> i32 { return rebuilt }
}
fn repairedField(value: Pair) -> () {
  let mut pair = move value drop pair.left pair.left = Token { value: 7 }
  let closure = fn() -> i32 { return pair.right.value }
}
fn terminated(source: Token, flag: bool) -> () {
  if flag { drop source return }
  let closure = fn() -> i32 { return source.value }
}
fn missingField(value: Pair) -> () {
  let mut incomplete = move value drop incomplete.left
  let closure = fn() -> i32 { return incomplete.right.value }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let repaired = run Semantic.demandBody(&mut store, &mut request, &id, b"repaired")
  let field = run Semantic.demandBody(&mut store, &mut request, &id, b"repairedField")
  let terminated = run Semantic.demandBody(&mut store, &mut request, &id, b"terminated")
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missingField")
  run Testing.expect(succeeded(&repaired) && succeeded(&field) && succeeded(&terminated),
    "complete replacement and exact field repair restore capture availability; returns do not join fallthrough")
  run Testing.expect(rejectsSpan(&missing, RejectionCode.UseAfterMove, text, "incomplete", 2),
    "a loan of a complete environment owner cannot retain a remaining partial hole")
}

fn retainedCaptureLoop(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut loopFound = false
  let mut continueFound = false
  let mut captureFound = false
  let mut at = usize.ZERO
  while at < nodes.length {
    match &nodes[at].kind {
      BodyNodeKind.While {..} => { loopFound = true }
      BodyNodeKind.Continue => { continueFound = true }
      BodyNodeKind.Expression {form: BodyExpression.Callable {..}, ..} => { captureFound = true }
      _ => {}
    }
    at = at + usize.ONE
  }
  return loopFound && continueFound && captureFound
}

fn captureLoopBody(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared<TypedBody>.with<bool>(&value, retainedCaptureLoop)
  }
  return false
}

fn captureIndexedLocal(node: &BodyNode, index: usize) -> bool {
  return match &node.kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} => local.index == index
    _ => false
  }
}

fn captureIndexedPlace(nodes: &[BodyNode], node: &BodyNode) -> bool {
  if let BodyNodeKind.Expression {form: BodyExpression.Index {value, index, ..}, ..} = &node.kind {
    return value.index < nodes.length && index.index < nodes.length &&
      captureIndexedLocal(&nodes[value.index], usize.ZERO) && captureIndexedLocal(&nodes[index.index], usize.ONE)
  }
  return false
}

fn captureIndexedIteration(nodes: &[BodyNode], node: &BodyNode) -> bool {
  if let BodyNodeKind.Block {statements, ..} = &node.kind {
    let written = List<BodyNodeId>.asSlice(&statements)
    let mut assigned = false
    let mut repeated = false
    let mut at = usize.ZERO
    while at < written.length {
      let id = written[at]
      if id.index >= nodes.length { return false }
      if let BodyNodeKind.PlaceAssignment {target, ..} = &nodes[id.index].kind {
        if target.index >= nodes.length { return false }
        if captureIndexedPlace(nodes, &nodes[target.index]) { assigned = true }
        else if !captureIndexedLocal(&nodes[target.index], usize.ONE) { return false }
      }
      match &nodes[id.index].kind { BodyNodeKind.Continue => { repeated = true } _ => () }
      at = at + usize.ONE
    }
    return assigned && repeated
  }
  return false
}

fn initializedIndexedCaptureLoop(body: &TypedBody) -> bool {
  if !retainedCaptureLoop(body) { return false }
  let nodes = TypedBody.nodeSlice(body)
  let mut assignment = false
  let mut capture = false
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.While {body: iteration, ..} = &nodes[at].kind {
      if iteration.index >= nodes.length || !captureIndexedIteration(nodes, &nodes[iteration.index]) { return false }
      assignment = true
    }
    if let BodyNodeKind.Expression {form: BodyExpression.Callable {fields, ..}, ..} = &nodes[at].kind {
      let captured = List<BodyAggregateField>.asSlice(&fields)
      if captured.length != usize.ONE || captured[usize.ZERO].value.index >= nodes.length { return false }
      if !captureIndexedLocal(&nodes[captured[usize.ZERO].value.index], 2) { return false }
      capture = true
    }
    at = at + usize.ONE
  }
  return assignment && capture
}

fn initializedIndexedBody(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared<TypedBody>.with<bool>(&value, initializedIndexedCaptureLoop)
  }
  return false
}

