}

effect fn declaredCallSourceClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("declared-call-sources.silk")
  let text = """
struct Token { value: i32 }
fn first<'a, 'b>(left: &'a Token, right: &'b Token) -> &'a Token { return left }
fn pick<'a>(left: &'a Token, right: &'a Token, chooseLeft: bool) -> &'a Token {
  if chooseLeft { return left }
  return right
}
fn identity<'a>(value: &'a Token) -> &'a Token { return value }
fn firstWrite() -> i32 {
  let mut left = Token {value: 1}
  let right = Token {value: 2}
  let view = first(&left, &right)
  left = Token {value: 3}
  return view.value
}
fn pickWrite(chooseLeft: bool) -> i32 {
  let left = Token {value: 1}
  let mut right = Token {value: 2}
  let view = pick(&left, &right, chooseLeft)
  right = Token {value: 4}
  return view.value
}
fn pickMove(chooseLeft: bool) -> i32 {
  let left = Token {value: 1}
  let right = Token {value: 2}
  let view = pick(&left, &right, chooseLeft)
  let moved = move left
  return view.value + moved.value
}
fn pickDrop(chooseLeft: bool) -> i32 {
  let left = Token {value: 1}
  let right = Token {value: 2}
  let view = pick(&left, &right, chooseLeft)
  drop right
  return view.value
}
fn pickExclusive(chooseLeft: bool) -> i32 {
  let mut left = Token {value: 1}
  let right = Token {value: 2}
  let view = pick(&left, &right, chooseLeft)
  let exclusive = &mut left
  return view.value + exclusive.value
}
fn forwarded(chooseLeft: bool) -> i32 {
  let mut left = Token {value: 1}
  let right = Token {value: 2}
  let selected = pick(&left, &right, chooseLeft)
  let view = identity(selected)
  left = Token {value: 5}
  return view.value
}
fn released(chooseLeft: bool) -> i32 {
  let mut left = Token {value: 1}
  let mut right = Token {value: 2}
  let view = pick(&left, &right, chooseLeft)
  let previous = view.value
  left = Token {value: 6}
  right = Token {value: 7}
  return previous + left.value + right.value
}
fn unrelated() -> i32 {
  let left = Token {value: 1}
  let mut right = Token {value: 2}
  let view = first(&left, &right)
  right = Token {value: 8}
  return view.value + right.value
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let first = run Semantic.demandBody(&mut store, &mut request, &id, b"firstWrite")
  run Testing.expect(rejectsSpan(&first, RejectionCode.AccessDuringLoan, text, "left", 6),
    "a distinct declared lifetime identifies the first argument's source despite shared call inference")
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"pickWrite")
  run Testing.expect(rejectsSpan(&written, RejectionCode.AccessDuringLoan, text, "right", 7),
    "either declared source of a shared-lifetime result must stay unmodified (OWN0011)")
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"pickMove")
  run Testing.expect(rejectsSpan(&moved, RejectionCode.AccessDuringLoan, text, "left", 11),
    "moving a declared result source before the result's last use is OWN0011")
  let dropped = run Semantic.demandBody(&mut store, &mut request, &id, b"pickDrop")
  run Testing.expect(rejectsSpan(&dropped, RejectionCode.AccessDuringLoan, text, "drop right", usize.ZERO),
    "dropping another declared result source before the result's last use is OWN0011")
  let exclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"pickExclusive")
  run Testing.expect(rejectsSpan(&exclusive, RejectionCode.LoanConflict, text, "&mut left", usize.ZERO),
    "a live declared shared result source cannot be borrowed exclusively (OWN0010)")
  let forwarded = run Semantic.demandBody(&mut store, &mut request, &id, b"forwarded")
  run Testing.expect(rejectsSpan(&forwarded, RejectionCode.AccessDuringLoan, text, "left", 19),
    "passing the selected result through identity keeps its source loans")
  let released = run Semantic.demandBody(&mut store, &mut request, &id, b"released")
  run Testing.expect(hasBorrowStatus(&released, BodyBorrowStatus.Checked),
    "every declared result source is released after the result's last use")
  let unrelated = run Semantic.demandBody(&mut store, &mut request, &id, b"unrelated")
  run Testing.expect(hasBorrowStatus(&unrelated, BodyBorrowStatus.Imprecise),
    "coalesced inference alone cannot promote the unrelated second argument to exact retention")
  return ()
}

