}

effect fn symbolicParentClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("symbolic-reborrow-parents.silk")
  let text = """
fn identity<'a>(value: &'a i32) -> &'a i32 { return value }
fn choose<'a>(left: &'a i32, right: &'a i32, first: bool) -> &'a i32 {
  if first { return left }
  return right
}
fn chain<'a>(value: &'a i32) -> &'a i32 {
  let first = &value.*
  let second = &first.*
  return identity<'a>(&second.*)
}
fn shortened<'a, 'b: 'a>(value: &'b i32) -> &'a i32 {
  let view = &value.*
  return identity<'a>(&view.*)
}
fn transitive<'a, 'b: 'a, 'c: 'b>(value: &'c i32) -> &'a i32 {
  let view = &value.*
  return identity<'a>(&view.*)
}
fn twoSame<'a>(left: &'a i32, right: &'a i32, first: bool) -> &'a i32 {
  let view = choose(&left.*, &right.*, first)
  return identity<'a>(&view.*)
}
fn possibleConflict(left: &mut i32, right: &i32, first: bool) -> i32 {
  let view = choose(&left.*, &right.*, first)
  left.* = 2
  return view.*
}
fn possibleOwned<'a>(left: &'a i32, first: bool) -> &'a i32 {
  let local = 2
  let view = choose(&left.*, &local, first)
  return identity<'a>(&view.*)
}
fn discardSource<'a, X, A>(source: &'a mut X, value: A) -> A { return value }
fn unrelatedOperand(left: &mut i32, right: &i32) -> i32 {
  let view = discardSource(&mut left.*, &right.*)
  left.* = 3
  return view.*
}
fn twoUnrelated<'a, 'b>(left: &'a i32, right: &'b i32, first: bool) -> &'a i32 {
  let view = choose(&left.*, &right.*, first)
  return identity<'a>(&view.*)
}
fn unrelated<'a, 'b>(anchor: &'a i32, value: &'b i32) -> &'a i32 {
  let first = &value.*
  let second = &first.*
  return identity<'a>(&second.*)
}
fn nested<'a>(value: &'a i32) -> i32 {
  let read = fn() -> &'a i32 {
    let view = &value.*
    return identity<'a>(&view.*)
  }
  return read().*
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let chain = run Semantic.demandBody(&mut store, &mut request, &id, b"chain")
  let shortened = run Semantic.demandBody(&mut store, &mut request, &id, b"shortened")
  let transitive = run Semantic.demandBody(&mut store, &mut request, &id, b"transitive")
  let twoSame = run Semantic.demandBody(&mut store, &mut request, &id, b"twoSame")
  let possibleConflict = run Semantic.demandBody(&mut store, &mut request, &id, b"possibleConflict")
  let possibleOwned = run Semantic.demandBody(&mut store, &mut request, &id, b"possibleOwned")
  let unrelatedOperand = run Semantic.demandBody(&mut store, &mut request, &id, b"unrelatedOperand")
  let twoUnrelated = run Semantic.demandBody(&mut store, &mut request, &id, b"twoUnrelated")
  let unrelated = run Semantic.demandBody(&mut store, &mut request, &id, b"unrelated")
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested")
  run Testing.expect(hasBorrowStatus(&chain, BodyBorrowStatus.Checked),
    "a reborrow chain reaches the actual universal storage parent")
  run Testing.expect(hasBorrowStatus(&shortened, BodyBorrowStatus.Checked),
    "a declared parent bound justifies shortening through a local inference atom")
  run Testing.expect(hasBorrowStatus(&transitive, BodyBorrowStatus.Checked),
    "only declared transitive bounds connect distinct universal parents")
  run Testing.expect(hasBorrowStatus(&twoSame, BodyBorrowStatus.Checked),
    "a complete set of possible sources proves the result only when every parent is sufficient")
  run Testing.expect(rejectsSpan(&possibleConflict, RejectionCode.AccessDuringLoan, text, "left", 6),
    "each source named by the declared reference-result lifetime remains an exact live loan")
  run Testing.expect(hasBorrowStatus(&possibleOwned, BodyBorrowStatus.Regions),
    "one caller-owned alternative cannot make another owned local outlive the body")
  run Testing.expect(hasBorrowStatus(&unrelatedOperand, BodyBorrowStatus.Imprecise),
    "a shared inference atom does not prove that a generic result retains every operand")
  run Testing.expect(hasBorrowStatus(&twoUnrelated, BodyBorrowStatus.Regions),
    "one sufficient parent cannot hide another unrelated parent of a shared region")
  run Testing.expect(hasBorrowStatus(&unrelated, BodyBorrowStatus.Regions),
    "several inferred reborrows do not relate unrelated universal lifetimes")
  run Testing.expect(anonymousStatus(&nested, BodyBorrowStatus.Checked),
    "an anonymous body traces local inference back to its enclosing function's lifetime")
  return ()
}

test effect fn sourceValidityOutlivesItsReferenceDescriptor() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
