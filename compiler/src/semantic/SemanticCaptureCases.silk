effect fn siblingCallableBinderClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("sibling-callable-binders.silk")
  let text = """
fn apply(value: &i32, use: fn(&i32) -> i32) -> i32 { return use(value) }
fn plain(value: &i32) -> i32 {
  let first = fn(input: &i32) -> i32 { return input.* }
  return apply(value, first) + apply(value, fn(input: &i32) -> i32 { return input.* })
}
effect fn effectful(value: &i32) -> i32 {
  let first = effect fn(input: &i32) -> i32 { return input.* }
  let second = effect fn(input: &i32) -> i32 { return input.* }
  let firstValue = run first(value)
  let secondValue = run second(value)
  return firstValue + secondValue
}
fn escape<'a>(value: &'a i32) -> &'static i32 {
  let first = fn(input: &i32) -> i32 { return input.* }
  let second = fn(escaping: &i32) -> &'static i32 { return escaping }
  drop first(value)
  return second(value)
}
fn captured(value: &mut i32) -> i32 {
  let first = fn() -> i32 { return value.* }
  let second = fn(input: &i32) -> i32 { return input.* }
  value.* = 2
  return first() + second(&value.*)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let plain = run Semantic.demandBody(&mut store, &mut request, &id, b"plain")
  let effectful = run Semantic.demandBody(&mut store, &mut request, &id, b"effectful")
  let escape = run Semantic.demandBody(&mut store, &mut request, &id, b"escape")
  let captured = run Semantic.demandBody(&mut store, &mut request, &id, b"captured")
  run Testing.expect(allAnonymousStatuses(&plain, 2, BodyBorrowStatus.Checked),
    "both stored and inline sibling bodies authenticate the other callable's own contract binders")
  run Testing.expect(allAnonymousStatuses(&effectful, 2, BodyBorrowStatus.Checked),
    "effectful sibling callable contracts bind their own parameters independently")
  run Testing.expect(rejectsSpan(&escape, RejectionCode.ReturnTypeMismatch, text, "escaping", usize.ONE),
    "recognizing a sibling's contract binders does not prove an input outlives static")
  run Testing.expect(rejectsSpan(&captured, RejectionCode.AccessDuringLoan, text, "value", 13),
    "a sibling contract does not erase the first callable's actual captured loan")
  return ()
}


test effect fn capturedOuterLocalsCoverOnlyFiniteNestedUses() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
