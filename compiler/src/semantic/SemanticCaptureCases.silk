effect fn captureRepairClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("capture-repairs.silk")
  let text = """
struct Token { value: i32 }
struct Pair { left: Token right: Token }
fn repaired(value: i32) -> () {
  let mut rebuilt = value drop rebuilt rebuilt = 9
  let closure = fn() -> i32 { return rebuilt }
}
fn repairedField(value: Pair) -> () {
  let mut pair = move value drop pair.left pair.left = Token { value: 7 }
  let closure = fn() -> i32 { return pair.right.value }
}
fn terminated(source: Token, flag: bool) -> () {
  if flag { drop source return }
  let closure = fn() -> i32 { return source.value }
}
fn missingField(value: Pair) -> () {
  let mut incomplete = move value drop incomplete.left
  let closure = fn() -> i32 { return incomplete.right.value }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let repaired = run Semantic.demandBody(&mut store, &mut request, &id, b"repaired")
  let field = run Semantic.demandBody(&mut store, &mut request, &id, b"repairedField")
  let terminated = run Semantic.demandBody(&mut store, &mut request, &id, b"terminated")
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missingField")
  run Testing.expect(succeeded(&repaired) && succeeded(&field) && succeeded(&terminated),
    "complete replacement and exact field repair restore capture availability; returns do not join fallthrough")
  run Testing.expect(rejectsSpan(&missing, RejectionCode.UseAfterMove, text, "incomplete", 2),
    "a loan of a complete environment owner cannot retain a remaining partial hole")
}

fn retainedCaptureLoop(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut loopFound = false
  let mut continueFound = false
  let mut captureFound = false
  let mut at = usize.ZERO
  while at < nodes.length {
    match &nodes[at].kind {
      BodyNodeKind.While {..} => { loopFound = true }
      BodyNodeKind.Continue => { continueFound = true }
      BodyNodeKind.Expression {form: BodyExpression.Callable {..}, ..} => { captureFound = true }
      _ => {}
    }
    at = at + usize.ONE
  }
  return loopFound && continueFound && captureFound
}

fn captureLoopBody(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared<TypedBody>.with<bool>(&value, retainedCaptureLoop)
  }
  return false
}

fn captureIndexedLocal(node: &BodyNode, index: usize) -> bool {
  return match &node.kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} => local.index == index
    _ => false
  }
}

fn captureIndexedPlace(nodes: &[BodyNode], node: &BodyNode) -> bool {
  if let BodyNodeKind.Expression {form: BodyExpression.Index {value, index, ..}, ..} = &node.kind {
    return value.index < nodes.length && index.index < nodes.length &&
      captureIndexedLocal(&nodes[value.index], usize.ZERO) && captureIndexedLocal(&nodes[index.index], usize.ONE)
  }
  return false
}

fn captureIndexedIteration(nodes: &[BodyNode], node: &BodyNode) -> bool {
  if let BodyNodeKind.Block {statements, ..} = &node.kind {
    let written = Vector<BodyNodeId>.asSlice(&statements)
    let mut assigned = false
    let mut repeated = false
    let mut at = usize.ZERO
    while at < written.length {
      let id = written[at]
      if id.index >= nodes.length { return false }
      if let BodyNodeKind.PlaceAssignment {target, ..} = &nodes[id.index].kind {
        if target.index >= nodes.length { return false }
        if captureIndexedPlace(nodes, &nodes[target.index]) { assigned = true }
        else if !captureIndexedLocal(&nodes[target.index], usize.ONE) { return false }
      }
      match &nodes[id.index].kind { BodyNodeKind.Continue => { repeated = true } _ => () }
      at = at + usize.ONE
    }
    return assigned && repeated
  }
  return false
}

fn initializedIndexedCaptureLoop(body: &TypedBody) -> bool {
  if !retainedCaptureLoop(body) { return false }
  let nodes = TypedBody.nodeSlice(body)
  let mut assignment = false
  let mut capture = false
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.While {body: iteration, ..} = &nodes[at].kind {
      if iteration.index >= nodes.length || !captureIndexedIteration(nodes, &nodes[iteration.index]) { return false }
      assignment = true
    }
    if let BodyNodeKind.Expression {form: BodyExpression.Callable {fields, ..}, ..} = &nodes[at].kind {
      let captured = Vector<BodyAggregateField>.asSlice(&fields)
      if captured.length != usize.ONE || captured[usize.ZERO].value.index >= nodes.length { return false }
      if !captureIndexedLocal(&nodes[captured[usize.ZERO].value.index], 2) { return false }
      capture = true
    }
    at = at + usize.ONE
  }
  return assignment && capture
}

fn initializedIndexedBody(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared<TypedBody>.with<bool>(&value, initializedIndexedCaptureLoop)
  }
  return false
}

test effect fn anonymousCapturesKeepLoopAndIndexedProofs() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run captureLoopClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn captureLoopClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("capture-loop-paths.silk")
  let text = """
struct Token { value: i32 }
struct Pair { left: Token right: Token }
fn changedLoop(value: Pair, again: bool, repair: bool) -> () {
  let mut pair = move value drop pair.left
  while again { if repair { pair.left = Token { value: 1 } } continue }
  pair.left = Token { value: 2 }
  let closure = fn() -> i32 { return pair.right.value }
}
fn stableLoop(source: Token, again: bool) -> () {
  while again { let closure = fn() -> i32 { return source.value } continue }
}
fn destructured(value: Pair, again: bool) -> () {
  let Pair {left: first, right} = move value
  let mut token = move first
  while again { if again { token = Token { value: 1 } } }
  let closure = fn() -> i32 { return token.value }
}
fn indexed(value: [Token; 2]) -> () {
  let mut items = move value drop items[0]
  match &items[0] { Token { value: capturedIndexValue } => {
    let closure = fn() -> i32 { return capturedIndexValue }
  } }
}
fn unchanged(value: Pair, takeLeft: bool, again: bool) -> () {
  let pair = move value
  if takeLeft { drop pair.left }
  while again { let marker = 42 let closure = fn() -> i32 { return marker } continue }
}
fn absentAfter(value: Pair, takeLeft: bool, again: bool) -> () {
  let pair = move value
  if takeLeft { drop pair.left }
  while again { let marker = 42 let closure = fn() -> i32 { return marker } continue }
  let closure = fn() -> i32 { return pair.left.value }
}
fn consume(value: Token) -> i32 { return value.value }
fn restored(source: Token, again: bool) -> () {
  let mut current = move source
  while again {
    let consumed = consume(move current)
    current = Token { value: consumed }
    let marker = 42 let closure = fn() -> i32 { return marker }
    continue
  }
}
fn unknownRepair(value: [Token; 2], index: usize, again: bool) -> () {
  let mut items = move value drop items[0]
  while again { items[index] = Token { value: 1 } let marker = 42 let closure = fn() -> i32 { return marker } continue }
}
fn consumeCondition(value: Token) -> bool { return value.value == 0 }
fn falseExit(source: Token) -> () {
  let token = move source
  while consumeCondition(move token) { return () }
  let closure = fn() -> i32 { return token.value }
}
fn initializedIndexed() -> i32 {
  let mut bytes: [u8; 2] = [0, 0]
  let mut index: usize = 0
  let marker = 1
  let keep = fn() -> i32 { return marker }
  while index < 2 { bytes[index] = 0 index = index + 1 continue }
  return keep()
}
fn indexedTransfer(value: [Token; 2], index: usize, again: bool) -> () {
  let mut items = move value
  while again { items[index] = move items[0] let marker = 42 let closure = fn() -> i32 { return marker } continue }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let changed = run Semantic.demandBody(&mut store, &mut request, &id, b"changedLoop")
  let stable = run Semantic.demandBody(&mut store, &mut request, &id, b"stableLoop")
  let indexed = run Semantic.demandBody(&mut store, &mut request, &id, b"indexed")
  let destructured = run Semantic.demandBody(&mut store, &mut request, &id, b"destructured")
  let unchanged = run Semantic.demandBody(&mut store, &mut request, &id, b"unchanged")
  let absent = run Semantic.demandBody(&mut store, &mut request, &id, b"absentAfter")
  let restored = run Semantic.demandBody(&mut store, &mut request, &id, b"restored")
  let uncertain = run Semantic.demandBody(&mut store, &mut request, &id, b"unknownRepair")
  let condition = run Semantic.demandBody(&mut store, &mut request, &id, b"falseExit")
  let initialized = run Semantic.demandBody(&mut store, &mut request, &id, b"initializedIndexed")
  let transferred = run Semantic.demandBody(&mut store, &mut request, &id, b"indexedTransfer")
  run Testing.expect(initializedIndexedBody(&initialized),
    "a live owned array keeps its actual runtime-index assignment and scalar capture across a checked loop; borrowing remains NotChecked")
  run Testing.expect(rejectsSpan(&transferred, RejectionCode.CaptureAvailabilityUnavailable, text,
    "while again { items[index] = move items[0] let marker = 42 let closure = fn() -> i32 { return marker } continue }", usize.ZERO),
    "an unknown target cannot cleanse a missing component transferred by its own assignment RHS")
  run Testing.expect(captureLoopBody(&unchanged) && captureLoopBody(&restored),
    "an unchanged inexact header and consume/refill/continue retain checked loops and actual scalar captures")
  run Testing.expect(rejectsSpan(&absent, RejectionCode.UseAfterMove, text, "pair", 11),
    "preserving an inexact header never makes its maybe-missing field available to an environment")
  run Testing.expect(rejectsSpan(&uncertain, RejectionCode.CaptureAvailabilityUnavailable, text,
    "while again { items[index] = Token { value: 1 } let marker = 42 let closure = fn() -> i32 { return marker } continue }", usize.ZERO),
    "a newly uncertain indexed repair cannot preserve the loop header")
  run Testing.expect(rejectsSpan(&condition, RejectionCode.UseAfterMove, text, "token", 5),
    "even a false consuming condition leaves its outer owner unavailable after the loop")
  run Testing.expect(rejectsSpan(&changed, RejectionCode.IncompatibleLoopHeader, text,
    "while again { if repair { pair.left = Token { value: 1 } } continue }", usize.ZERO),
    "joining repair and unchanged continue paths cannot hide an incompatible loop header")
  run Testing.expect(succeeded(&stable), "a shared environment leaves every repeating ownership edge unchanged")
  run Testing.expect(succeeded(&destructured),
    "a destructuring let's subject root outlives the let, so a hole moved from its binding is unchanged by a loop")
  run Testing.expect(rejectsSpan(&indexed, RejectionCode.UseAfterMove, text, "items[0]", usize.ONE),
    "a pattern capture resolves its literal indexed parent place before checking missing elements")
}

fn capturedParameterRegion(value: &Lifetime, owner: &DeclarationId) -> bool {
  return match &value.* {
    Lifetime.Parameter {declaration, ordinal} => ordinal == usize.ZERO && DeclarationId.equals(&declaration, owner)
    _ => false
  }
}

fn oneCapturedParameter(environment: &Intersection, owner: &DeclarationId) -> bool {
  let members = Vector<LifetimeMember>.asSlice(&environment.members)
  return members.length == usize.ONE && Shared<Lifetime>.with<bool>(&members[usize.ZERO].region,
    fn(value: &Lifetime) -> bool { return capturedParameterRegion(value, owner) })
}

fn capturedContractRegion(contract: &Type, owner: &DeclarationId) -> bool {
  if let Type.Callable {mode, environment, ..} = &contract.* {
    return mode == CallableMode.Shared && Shared<Intersection>.with<bool>(&environment,
      fn(value: &Intersection) -> bool { return oneCapturedParameter(value, owner) })
  }
  return false
}

fn capturedFieldRegion(field: &Type, owner: &DeclarationId) -> bool {
  return match &field.* {
    Type.Reference {lifetime, ..} => Shared<Lifetime>.with<bool>(&lifetime,
      fn(value: &Lifetime) -> bool { return capturedParameterRegion(value, owner) })
    Type.CallableValue {contract, ..} => Shared<Type>.with<bool>(&contract,
      fn(value: &Type) -> bool { return capturedContractRegion(value, owner) })
    _ => false
  }
}

fn exactCapturedRegion(ty: &Type, owner: &DeclarationId) -> bool {
  if let Type.CallableValue {contract, captures, ..} = &ty.* {
    let fields = Vector<Shared<Type>>.asSlice(&captures)
    return fields.length == usize.ONE && Shared<Type>.with<bool>(&contract,
      fn(value: &Type) -> bool { return capturedContractRegion(value, owner) }) &&
      Shared<Type>.with<bool>(&fields[usize.ZERO], fn(value: &Type) -> bool { return capturedFieldRegion(value, owner) })
  }
  return false
}

fn everyAnonymousRetainsSourceRegion(body: &TypedBody, expected: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let owner = TypedBody.declarationId(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Callable {..}} = &nodes[at].kind {
      if !Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool { return exactCapturedRegion(value, owner) }) { return false }
      found = found + usize.ONE
    }
    at = at + usize.ONE
  }
  return found == expected
}

fn anonymousRegionFacts(answer: &Result<Answer, NoRejection>, expected: usize) -> bool {
  if let Option<Shared<TypedBody>>.Some {value} = move checkedBody(answer) {
    return Shared<TypedBody>.with<bool>(&value, fn(body: &TypedBody) -> bool { return everyAnonymousRetainsSourceRegion(body, expected) })
  }
  return false
}

test effect fn anonymousCallableDescriptorsKeepOriginalRegions() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run descriptorCaptureClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn descriptorCaptureClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("capture-descriptors.silk")
  let text = """
fn twice<'a>(view: &'a mut i32) -> () {
  let first = fn() -> i32 { return view.* }
  let second = fn() -> i32 { let copied = move first return copied() }
}
fn boundFailure(f: for<'x: 'static> fn<'static>(&'x i32) -> i32) -> i32 {
  let local = 1
  return f(&local)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let twice = run Semantic.demandBody(&mut store, &mut request, &id, b"twice")
  let invalid = run Semantic.demandBody(&mut store, &mut request, &id, b"boundFailure")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&twice,
    fn(answer: &Result<Answer, NoRejection>) -> bool { return anonymousRegionFacts(answer, 2) }),
    "copying a shared callable descriptor retains its source parameter region and Shared invocation even with an exclusive view capture")
  run Testing.expect(rejectsSpan(&invalid, RejectionCode.UnsatisfiedLifetimeBound, text, "f(&local)", usize.ZERO),
    "an invocation-local loan cannot prove a static bound, diagnosed at the complete call")
}

test effect fn anonymousCapturesCannotLaunderEndedStorage() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run captureReconstructionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn captureReconstructionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("capture-reconstruction.silk")
  let text = """
struct Token { value: i32 }
fn movedView<'a>(view: &'a mut i32) -> () {
  let moved = move view
  view.* = 1
  let closure = fn() -> i32 { return view.* }
}
fn copiedEnded(old: i32) -> () {
  drop old let fresh = old
  let closure = fn() -> i32 { return fresh }
}
fn movedEnded(token: Token) -> () {
  let mut owner = move token drop owner owner = move owner
  let closure = fn() -> i32 { return owner.value }
}
fn overlapping(token: Token) -> () {
  let mut held = move token held = move held
  let closure = fn() -> i32 { return held.value }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let view = run Semantic.demandBody(&mut store, &mut request, &id, b"movedView")
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copiedEnded")
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"movedEnded")
  let overlap = run Semantic.demandBody(&mut store, &mut request, &id, b"overlapping")
  run Testing.expect(rejectsSpan(&view, RejectionCode.UseAfterMove, text, "view", 2),
    "a referent write validates its descriptor and cannot revive moved view storage")
  run Testing.expect(rejectsSpan(&copied, RejectionCode.UseAfterMove, text, "old", 2) &&
    rejectsSpan(&moved, RejectionCode.UseAfterMove, text, "move owner", usize.ZERO),
    "a replacement or fresh binding cannot acquire a value from ended Copy or affine storage")
  run Testing.expect(rejectsSpan(&overlap, RejectionCode.OverlappingAssignment, text, "held = move held", usize.ZERO),
    "replacement cannot consume its own target, diagnosed on the assignment (OWN0004)")
}

test effect fn holderProjectionsKeepTheirLoans() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run holderProjectionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn holderProjectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("holder-projections.silk")
  let text = """
struct Holder<'a> {
  first: &'a i32
  count: i32
}
struct Outer<'a> {
  inner: Holder<'a>
}
tuple Pair<'a>(&'a i32, i32)
union Slot<'a> {
  Empty,
  Full {view: &'a i32},
}
fn read<'a>(value: &'a i32) -> i32 { return value.* }
fn nestedAfterWrite() -> i32 {
  let mut u = 1
  let outer = Outer {inner: Holder {first: &u, count: 2}}
  u = 5
  return outer.inner.count
}
fn nestedBeforeWrite() -> i32 {
  let mut v = 1
  let outer = Outer {inner: Holder {first: &v, count: 2}}
  let n = outer.inner.count
  v = 5
  return n
}
fn pack<'a>(value: &'a i32) -> Pair<'a> { return Pair(value, 2) }
fn tupleAfterWrite() -> i32 {
  let mut w = 1
  let pair = pack(&w)
  w = 5
  return pair.1
}
fn matchedAfterWrite() -> i32 {
  let mut m = 1
  let slot = Slot.Full {view: &m}
  m = 5
  return match move slot {
    Slot.Full {view} => read(view)
    Slot.Empty => 0
  }
}
fn countAfterWrite() -> i32 {
  let mut x = 1
  let pair = Holder {first: &x, count: 2}
  x = 5
  return pair.count
}
fn countBeforeWrite() -> i32 {
  let mut y = 1
  let pair = Holder {first: &y, count: 2}
  let n = pair.count
  y = 5
  return n
}
fn referenceField() -> i32 {
  let mut z = 1
  let pair = Holder {first: &z, count: 2}
  let r = pair.first
  z = 5
  return read(r)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let after = run Semantic.demandBody(&mut store, &mut request, &id, b"countAfterWrite")
  let before = run Semantic.demandBody(&mut store, &mut request, &id, b"countBeforeWrite")
  let reference = run Semantic.demandBody(&mut store, &mut request, &id, b"referenceField")
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedAfterWrite")
  let nestedBefore = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedBeforeWrite")
  let tupled = run Semantic.demandBody(&mut store, &mut request, &id, b"tupleAfterWrite")
  let matched = run Semantic.demandBody(&mut store, &mut request, &id, b"matchedAfterWrite")
  run Testing.expect(rejectsRelated(&after, RejectionCode.AccessDuringLoan, offsetOf(text, "x = 5", usize.ZERO),
    offsetOf(text, "&x", usize.ZERO)), "a field read keeps its holder live, so an earlier write of the borrowed owner is OWN0011")
  run Testing.expect(loansProved(&before),
    "a holder whose last use precedes the write lends nothing to it")
  run Testing.expect(rejectsRelated(&reference, RejectionCode.AccessDuringLoan, offsetOf(text, "z = 5", usize.ZERO),
      offsetOf(text, "&z", usize.ZERO)),
    "a reference copied out of a holder retains its source loan across a later write (OWN0011)")
  run Testing.expect(rejectsRelated(&nested, RejectionCode.AccessDuringLoan, offsetOf(text, "u = 5", usize.ZERO),
      offsetOf(text, "&u", usize.ZERO))
    && loansProved(&nestedBefore)
    && rejectsRelated(&tupled, RejectionCode.AccessDuringLoan, offsetOf(text, "w = 5", usize.ZERO), offsetOf(text, "&w", usize.ZERO)),
    "a nested field or tuple position read keeps the outer holder live, so an earlier write is OWN0011")
  run Testing.expect(rejectsRelated(&matched, RejectionCode.AccessDuringLoan, offsetOf(text, "m = 5", usize.ZERO),
      offsetOf(text, "&m", usize.ZERO)),
    "a match subject retains its holder's loan, so an earlier write reports OWN0011")
}

test effect fn borrowedMatchArmsLendTheirSubject() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run borrowedMatchArmClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// A borrowed match arm's bindings are projections of its subject place (MATCH-002): the place stays
// lent to them through their last use, and accesses through them never conflict with that loan.
effect fn borrowedMatchArmClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("borrowed-match-arms.silk")
  let text = """
struct Token {
  kind: i32
}
union Slot {
  Held {value: Token},
  Vacant,
}
struct Shelf {
  slot: Slot
  count: i32
}
struct Pair {
  first: Token
  second: Token
}
struct Box1 {
  item: Token
}
struct Empty {}
struct Rack {
  lanes: [Slot; 2]
  count: i32
}
fn bump(token: &mut Token) -> () {
  token.kind = token.kind + 1
  return ()
}
fn reset(input: Slot) -> i32 {
  let mut slot = move input
  return match &slot {
    Slot.Held {value} => {
      slot = Slot.Vacant
      return value.kind
    }
    Slot.Vacant => 0
  }
}
fn looped(input: Slot) -> i32 {
  let mut slot = move input
  let mut total = 0
  match &slot {
    Slot.Held {value} => {
      let mut round = 0
      while round < 2 {
        total = total + value.kind
        slot = Slot.Vacant
        round = round + 1
      }
    }
    Slot.Vacant => {}
  }
  return total
}
fn released(input: Slot) -> i32 {
  let mut slot = move input
  return match &slot {
    Slot.Held {value} if value.kind > 0 => {
      slot = Slot.Vacant
      return 1
    }
    Slot.Held {value} => {
      let kind = value.kind
      slot = Slot.Vacant
      return kind
    }
    Slot.Vacant => 0
  }
}
fn through(input: Shelf) -> i32 {
  let mut shelf = move input
  match &mut shelf.slot {
    Slot.Held {value} => {
      bump(&mut value)
      let view = &mut value
      bump(move view)
      shelf.count = value.kind
    }
    Slot.Vacant => {}
  }
  return shelf.count
}
fn unbound(input: Slot) -> i32 {
  let mut slot = move input
  match &slot {
    Slot.Held {..} => { slot = Slot.Vacant }
    Slot.Vacant => {}
  }
  return 0
}
fn fieldPlace(input: Shelf) -> i32 {
  let mut shelf = move input
  return match &shelf.slot {
    Slot.Held {value} => {
      shelf.slot = Slot.Vacant
      return value.kind
    }
    Slot.Vacant => 0
  }
}
fn fieldOwner(input: Shelf) -> i32 {
  let mut shelf = move input
  return match &shelf.slot {
    Slot.Held {value} => {
      shelf = Shelf {slot: Slot.Vacant, count: 0}
      return value.kind
    }
    Slot.Vacant => 0
  }
}
fn structural(input: Box1 | Empty) -> i32 {
  let mut held = move input
  return match &held {
    Box1 {item} => {
      held = Empty {}
      return item.kind
    }
    Empty vacant => 0
  }
}
fn exclusive(input: Slot) -> i32 {
  let mut slot = move input
  return match &mut slot {
    Slot.Held {value} => {
      slot = Slot.Vacant
      bump(&mut value)
      return value.kind
    }
    Slot.Vacant => 0
  }
}
fn destructured(input: Pair) -> i32 {
  let mut pair = move input
  let Pair {first, ..} = &pair
  pair = Pair {first: Token {kind: 1}, second: Token {kind: 2}}
  return first.kind
}
fn inspect(shelf: &Shelf) -> i32 { return shelf.count }
fn clearSlot(slot: &mut Slot) -> i32 { return 0 }
fn ifLetAfterUse(input: Slot) -> i32 {
  let mut kept = move input
  let mut out = 0
  if let Slot.Held {value} = &kept {
    out = value.kind
    kept = Slot.Vacant
  }
  return out
}
fn ifLetUnbound(input: Slot) -> i32 {
  let mut cleared = move input
  if let Slot.Held {..} = &cleared { cleared = Slot.Vacant }
  return 0
}
fn letAfterUse(input: Pair) -> i32 {
  let mut owned = move input
  let Pair {first, ..} = &owned
  let out = first.kind
  owned = Pair {first: Token {kind: 1}, second: Token {kind: 2}}
  return out
}
fn letScoped(input: Pair) -> i32 {
  let mut scoped = move input
  let mut out = 0
  if true {
    let Pair {first, ..} = &scoped
    out = first.kind
  }
  scoped = Pair {first: Token {kind: 1}, second: Token {kind: 2}}
  return out
}
fn nestedBinding(input: Shelf) -> i32 {
  let mut outer = move input
  let mut out = 0
  match &outer {
    Shelf {slot, ..} => match &slot {
      Slot.Held {value} => {
        outer = Shelf {slot: Slot.Vacant, count: 1}
        out = value.kind
      }
      Slot.Vacant => {}
    }
  }
  return out
}
fn outerExclusive(input: Shelf) -> i32 {
  let mut both = move input
  let mut out = 0
  match &mut both {
    Shelf {slot: lent, ..} => match &both.slot {
      Slot.Held {value} => {
        let cleared = clearSlot(&mut lent)
        out = value.kind
      }
      Slot.Vacant => {}
    }
  }
  return out
}
fn ifLetReplaced(input: Slot) -> i32 {
  let mut replaced = move input
  if let Slot.Held {value} = &replaced {
    replaced = Slot.Vacant
    return value.kind
  }
  return 0
}
fn ifLetElement() -> i32 {
  let mut cells = [Slot.Held {value: Token {kind: 1}}, Slot.Vacant]
  if let Slot.Held {value} = &cells[0] {
    cells[0] = Slot.Vacant
    return value.kind
  }
  return 0
}
fn ifLetIndexed(at: usize) -> i32 {
  let mut lots = [Slot.Held {value: Token {kind: 1}}, Slot.Vacant]
  if let Slot.Held {value} = &lots[0] {
    lots[at] = Slot.Vacant
    return value.kind
  }
  return 0
}
fn armIndexed(at: usize) -> i32 {
  let mut lanes = [Slot.Held {value: Token {kind: 1}}, Slot.Vacant]
  return match &lanes[0] {
    Slot.Held {value} => {
      lanes[at] = Slot.Vacant
      return value.kind
    }
    Slot.Vacant => 0
  }
}
fn heldCount(slot: &Slot) -> i32 { return 0 }
fn exclusiveIndexedRead(at: usize) -> i32 {
  let mut rows = [Slot.Held {value: Token {kind: 1}}, Slot.Vacant]
  return match &mut rows[0] {
    Slot.Held {value} => {
      let seen = heldCount(&rows[at])
      return value.kind + seen
    }
    Slot.Vacant => 0
  }
}
fn innerInspect(input: Slot) -> i32 {
  let mut probed = move input
  return match &probed {
    Slot.Held {value: seen} => {
      match place probed {
        Slot.Held {..} => {}
        Slot.Vacant => {}
      }
      return seen.kind
    }
    Slot.Vacant => 0
  }
}
fn sameSlot<'a>(slot: &'a Slot) -> &'a Slot { return slot }
fn slotOf<'a>(shelf: &'a Shelf) -> &'a Slot { return &shelf.slot }
fn returnedView(input: Slot) -> i32 {
  let mut through = move input
  return match &sameSlot(&through).* {
    Slot.Held {value} => {
      through = Slot.Vacant
      return value.kind
    }
    Slot.Vacant => 0
  }
}
fn returnedIfLet(input: Slot) -> i32 {
  let mut iffed = move input
  if let Slot.Held {value} = &sameSlot(&iffed).* {
    iffed = Slot.Vacant
    return value.kind
  }
  return 0
}
fn returnedField(input: Shelf) -> i32 {
  let mut fielded = move input
  return match &slotOf(&fielded).* {
    Slot.Held {value} => {
      fielded = Shelf {slot: Slot.Vacant, count: 0}
      return value.kind
    }
    Slot.Vacant => 0
  }
}
fn nestedReturned(input: Shelf) -> i32 {
  let mut nesting = move input
  let mut out = 0
  match &nesting {
    Shelf {slot, ..} => match &sameSlot(&slot).* {
      Slot.Held {value} => {
        nesting = Shelf {slot: Slot.Vacant, count: 1}
        out = value.kind
      }
      Slot.Vacant => {}
    }
  }
  return out
}
fn laneSet<'a>(lanes: &'a [Slot; 2]) -> &'a [Slot; 2] { return lanes }
fn laneSlice<'a>(lanes: &'a [Slot]) -> &'a [Slot] { return lanes }
fn returnedIndexed() -> i32 {
  let mut grid = [Slot.Held {value: Token {kind: 1}}, Slot.Vacant]
  return match &laneSet(&grid).*[0] {
    Slot.Held {value} => {
      grid = [Slot.Vacant, Slot.Vacant]
      return value.kind
    }
    Slot.Vacant => 0
  }
}
fn returnedSliceIndexed() -> i32 {
  let mut strip = [Slot.Held {value: Token {kind: 1}}, Slot.Vacant]
  return match &laneSlice(&strip)[0] {
    Slot.Held {value} => {
      strip = [Slot.Vacant, Slot.Vacant]
      return value.kind
    }
    Slot.Vacant => 0
  }
}
fn returnedRuntimeIndexed(at: usize) -> i32 {
  let mut row = [Slot.Held {value: Token {kind: 1}}, Slot.Vacant]
  return match &laneSet(&row).*[at] {
    Slot.Held {value} => {
      row = [Slot.Vacant, Slot.Vacant]
      return value.kind
    }
    Slot.Vacant => 0
  }
}
fn rackOf<'a>(rack: &'a Rack) -> &'a Rack { return rack }
fn returnedFieldIndexed(input: Rack) -> i32 {
  let mut stand = move input
  return match &rackOf(&stand).*.lanes[0] {
    Slot.Held {value} => {
      stand = Rack {lanes: [Slot.Vacant, Slot.Vacant], count: 0}
      return value.kind
    }
    Slot.Vacant => 0
  }
}
fn returnedIndexedAfter(at: usize) -> i32 {
  let mut tail = [Slot.Held {value: Token {kind: 1}}, Slot.Vacant]
  let mut out = 0
  match &laneSet(&tail).*[at] {
    Slot.Held {value} => { out = value.kind }
    Slot.Vacant => {}
  }
  tail = [Slot.Vacant, Slot.Vacant]
  return out
}
fn refilledFromBinding(input: Slot) -> i32 {
  let mut refill = move input
  match &refill {
    Slot.Held {value} => { refill = Slot.Held {value: Token {kind: value.kind}} }
    Slot.Vacant => {}
  }
  return 0
}
fn writtenThrough(cursor: &mut Slot) -> i32 {
  let view = &cursor.*
  cursor.* = Slot.Vacant
  return heldCount(view)
}
fn viewLocal(input: Shelf) -> i32 {
  let mut viewed = move input
  let mut out = 0
  let r = &mut viewed
  match &r.slot {
    Slot.Held {value} => {
      r.slot = Slot.Vacant
      out = value.kind
    }
    Slot.Vacant => {}
  }
  return out
}
fn idle(input: Shelf) -> i32 {
  let mut shelf = move input
  let mut seen = 0
  match &mut shelf.slot {
    Slot.Held {value} => {
      seen = inspect(&shelf)
      bump(&mut value)
    }
    Slot.Vacant => {}
  }
  return seen
}
fn nested(input: Shelf) -> i32 {
  let mut shelf = move input
  match &mut shelf {
    Shelf {slot, ..} => match &mut slot {
      Slot.Held {value} => { bump(&mut value) }
      Slot.Vacant => {}
    }
  }
  return shelf.count
}
fn nestedRewrite(input: Shelf) -> i32 {
  let mut ring = move input
  let mut out = 0
  match &mut ring {
    Shelf {slot: lane, ..} => match &mut lane {
      Slot.Held {value} => {
        lane = Slot.Vacant
        out = value.kind
      }
      Slot.Vacant => {}
    }
  }
  return out
}
fn exclusiveUnderShared(input: Slot) -> i32 {
  let mut watched = move input
  let mut out = 0
  match &watched {
    Slot.Held {value: seen} => {
      match &mut watched {
        Slot.Held {value} => { bump(&mut value) }
        Slot.Vacant => {}
      }
      out = seen.kind
    }
    Slot.Vacant => {}
  }
  return out
}
fn nestedThenOuter(input: Shelf) -> i32 {
  let mut ringed = move input
  let mut out = 0
  match &mut ringed {
    Shelf {slot: track, count} => {
      match &mut track {
        Slot.Held {value} => {
          bump(&mut value)
          out = value.kind
        }
        Slot.Vacant => {}
      }
      track = Slot.Vacant
      count = 0
    }
  }
  return out
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let reset = run Semantic.demandBody(&mut store, &mut request, &id, b"reset")
  let looped = run Semantic.demandBody(&mut store, &mut request, &id, b"looped")
  let released = run Semantic.demandBody(&mut store, &mut request, &id, b"released")
  let through = run Semantic.demandBody(&mut store, &mut request, &id, b"through")
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested")
  let idle = run Semantic.demandBody(&mut store, &mut request, &id, b"idle")
  let unbound = run Semantic.demandBody(&mut store, &mut request, &id, b"unbound")
  let fieldPlace = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldPlace")
  let fieldOwner = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldOwner")
  let structural = run Semantic.demandBody(&mut store, &mut request, &id, b"structural")
  let exclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusive")
  let destructured = run Semantic.demandBody(&mut store, &mut request, &id, b"destructured")
  let ifLetAfterUse = run Semantic.demandBody(&mut store, &mut request, &id, b"ifLetAfterUse")
  let ifLetUnbound = run Semantic.demandBody(&mut store, &mut request, &id, b"ifLetUnbound")
  let letAfterUse = run Semantic.demandBody(&mut store, &mut request, &id, b"letAfterUse")
  let letScoped = run Semantic.demandBody(&mut store, &mut request, &id, b"letScoped")
  let nestedBinding = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedBinding")
  let outerExclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"outerExclusive")
  let viewLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"viewLocal")
  let ifLetReplaced = run Semantic.demandBody(&mut store, &mut request, &id, b"ifLetReplaced")
  let ifLetElement = run Semantic.demandBody(&mut store, &mut request, &id, b"ifLetElement")
  let ifLetIndexed = run Semantic.demandBody(&mut store, &mut request, &id, b"ifLetIndexed")
  let armIndexed = run Semantic.demandBody(&mut store, &mut request, &id, b"armIndexed")
  let exclusiveIndexedRead = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusiveIndexedRead")
  let innerInspect = run Semantic.demandBody(&mut store, &mut request, &id, b"innerInspect")
  let returnedView = run Semantic.demandBody(&mut store, &mut request, &id, b"returnedView")
  let returnedIfLet = run Semantic.demandBody(&mut store, &mut request, &id, b"returnedIfLet")
  let returnedField = run Semantic.demandBody(&mut store, &mut request, &id, b"returnedField")
  let nestedReturned = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedReturned")
  let refilledFromBinding = run Semantic.demandBody(&mut store, &mut request, &id, b"refilledFromBinding")
  let returnedIndexed = run Semantic.demandBody(&mut store, &mut request, &id, b"returnedIndexed")
  let returnedSliceIndexed = run Semantic.demandBody(&mut store, &mut request, &id, b"returnedSliceIndexed")
  let returnedIndexedAfter = run Semantic.demandBody(&mut store, &mut request, &id, b"returnedIndexedAfter")
  let returnedRuntimeIndexed = run Semantic.demandBody(&mut store, &mut request, &id, b"returnedRuntimeIndexed")
  let returnedFieldIndexed = run Semantic.demandBody(&mut store, &mut request, &id, b"returnedFieldIndexed")
  let writtenThrough = run Semantic.demandBody(&mut store, &mut request, &id, b"writtenThrough")
  let nestedRewrite = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedRewrite")
  let exclusiveUnderShared = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusiveUnderShared")
  let nestedThenOuter = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedThenOuter")
  run Testing.expect(rejectsRelated(&reset, RejectionCode.AccessDuringLoan, offsetOf(text, "slot = Slot.Vacant", usize.ZERO),
      offsetOf(text, "slot {", usize.ZERO)),
    "writing a borrowed match's subject before a later use of its binding is OWN0011")
  run Testing.expect(rejectsRelated(&looped, RejectionCode.AccessDuringLoan, offsetOf(text, "slot = Slot.Vacant", 1),
      offsetOf(text, "slot {", 1)),
    "a binding used again on the next iteration keeps the subject lent across the loop's write")
  run Testing.expect(hasBorrowStatus(&released, BodyBorrowStatus.Checked),
    "a guard-only use or a write after the binding's last use leaves the subject free")
  run Testing.expect(hasBorrowStatus(&through, BodyBorrowStatus.Checked) && hasBorrowStatus(&nested, BodyBorrowStatus.Checked),
    "reborrows, nested matches, and a disjoint field write go through the bindings without conflicting")
  run Testing.expect(hasBorrowStatus(&idle, BodyBorrowStatus.Checked),
    "reading the owner while an exclusive binding is idle invalidates nothing the binding names")
  // A whole-arm loan (MATCH-001 read literally) would reject `released` and `unbound` as well, and
  // an exclusive one `idle`.
  run Testing.expect(hasBorrowStatus(&unbound, BodyBorrowStatus.Checked),
    "an arm that binds nothing lends nothing, so it may replace the subject")
  run Testing.expect(rejectsSpan(&reset, RejectionCode.AccessDuringLoan, text, "slot", 3)
      && rejectsRelated(&fieldPlace, RejectionCode.AccessDuringLoan, offsetOf(text, "shelf.slot = Slot.Vacant", usize.ZERO),
        offsetOf(text, "shelf.slot {", 1))
      && rejectsRelated(&fieldOwner, RejectionCode.AccessDuringLoan, offsetOf(text, "shelf = Shelf {slot", usize.ZERO),
        offsetOf(text, "shelf.slot {", 2))
      && rejectsRelated(&structural, RejectionCode.AccessDuringLoan, offsetOf(text, "held = Empty", usize.ZERO),
        offsetOf(text, "held {", usize.ZERO))
      && rejectsRelated(&exclusive, RejectionCode.AccessDuringLoan, offsetOf(text, "slot = Slot.Vacant\n      bump", usize.ZERO),
        offsetOf(text, "slot {\n    Slot.Held {value} => {\n      slot = Slot.Vacant\n      bump", usize.ZERO))
      && rejectsRelated(&destructured, RejectionCode.AccessDuringLoan, offsetOf(text, "pair = Pair", usize.ZERO),
        offsetOf(text, "pair\n", usize.ZERO)),
    "writing the subject, a subject field's owner, or a borrowed `let` subject before a later binding use is OWN0011 at the written binding")
  // An `if let` lends through its taken body when it binds, and a destructuring `let` until its
  // bindings' scope ends, whatever the match loan's extent (PATT-009).
  run Testing.expect(rejectsRelated(&ifLetAfterUse, RejectionCode.AccessDuringLoan, offsetOf(text, "kept = Slot.Vacant", usize.ZERO),
        offsetOf(text, "kept {", usize.ZERO))
      && hasBorrowStatus(&ifLetUnbound, BodyBorrowStatus.Checked)
      && rejectsRelated(&letAfterUse, RejectionCode.AccessDuringLoan, offsetOf(text, "owned = Pair", usize.ZERO),
        offsetOf(text, "owned\n", usize.ZERO))
      && hasBorrowStatus(&letScoped, BodyBorrowStatus.Checked),
    "a borrowed `if let` body or destructuring `let` scope keeps its subject lent after the bindings' last use")
  run Testing.expect(rejectsRelated(&nestedBinding, RejectionCode.AccessDuringLoan, offsetOf(text, "outer = Shelf", usize.ZERO),
        offsetOf(text, "outer {", usize.ZERO))
      && rejectsWith(&outerExclusive, RejectionCode.LoanConflict)
      && rejectsRelated(&viewLocal, RejectionCode.AccessDuringLoan, offsetOf(text, "r.slot = Slot.Vacant", usize.ZERO),
        offsetOf(text, "r.slot {", usize.ZERO)),
    "a nested match's binding, an outer exclusive binding, and a view of the owner each keep the arm's subject lent")
  run Testing.expect(rejectsRelated(&ifLetReplaced, RejectionCode.AccessDuringLoan, offsetOf(text, "replaced = Slot.Vacant", usize.ZERO),
        offsetOf(text, "replaced {", usize.ZERO))
      && rejectsRelated(&ifLetElement, RejectionCode.AccessDuringLoan, offsetOf(text, "cells[0] = Slot.Vacant", usize.ZERO),
        offsetOf(text, "cells[0] {", usize.ZERO))
      && rejectsRelated(&ifLetIndexed, RejectionCode.AccessDuringLoan, offsetOf(text, "lots[at] = Slot.Vacant", usize.ZERO),
        offsetOf(text, "lots[0] {", usize.ZERO))
      && rejectsRelated(&armIndexed, RejectionCode.AccessDuringLoan, offsetOf(text, "lanes[at] = Slot.Vacant", usize.ZERO),
        offsetOf(text, "lanes[0] {", usize.ZERO))
      && rejectsRelated(&innerInspect, RejectionCode.AccessDuringLoan, offsetOf(text, "probed {\n        Slot.Held", usize.ZERO),
        offsetOf(text, "probed {\n    Slot.Held", usize.ZERO)),
    "replacing or inspecting the lent subject, or writing an element a runtime index may name, before a later binding use is OWN0011")
  run Testing.expect(hasBorrowStatus(&exclusiveIndexedRead, BodyBorrowStatus.Checked),
    "reading an element beside an idle exclusive binding of another element invalidates nothing")
  run Testing.expect(rejectsRelated(&returnedView, RejectionCode.AccessDuringLoan, offsetOf(text, "through = Slot.Vacant", usize.ZERO),
        offsetOf(text, "&through", usize.ZERO))
      && rejectsWith(&returnedIfLet, RejectionCode.AccessDuringLoan)
      && rejectsWith(&returnedField, RejectionCode.AccessDuringLoan)
      && rejectsWith(&nestedReturned, RejectionCode.AccessDuringLoan),
    "a reference a call returns lends the storage it borrows to the bindings of a match or `if let` on it")
  run Testing.expect(rejectsRelated(&returnedIndexed, RejectionCode.AccessDuringLoan, offsetOf(text, "grid = [Slot.Vacant", usize.ZERO),
        offsetOf(text, "&grid", usize.ZERO))
      && rejectsWith(&returnedSliceIndexed, RejectionCode.AccessDuringLoan)
      && rejectsWith(&returnedRuntimeIndexed, RejectionCode.AccessDuringLoan)
      && rejectsWith(&returnedFieldIndexed, RejectionCode.AccessDuringLoan)
      && hasBorrowStatus(&returnedIndexedAfter, BodyBorrowStatus.Checked),
    "an element indexed through a returned reference or slice keeps the call's argument lent to the bindings")
  run Testing.expect(hasBorrowStatus(&refilledFromBinding, BodyBorrowStatus.Checked)
      && rejectsSpan(&writtenThrough, RejectionCode.AccessDuringLoan, text, "cursor", 2),
    "a write whose value reads a binding completes after that read; a write through a reference is reported at it")
  run Testing.expect(rejectsRelated(&nestedRewrite, RejectionCode.AccessDuringLoan, offsetOf(text, "lane = Slot.Vacant", usize.ZERO),
        offsetOf(text, "lane {", usize.ZERO))
      && rejectsRelated(&exclusiveUnderShared, RejectionCode.AccessDuringLoan, offsetOf(text, "watched {", 1),
        offsetOf(text, "watched {", usize.ZERO))
      && hasBorrowStatus(&nestedThenOuter, BodyBorrowStatus.Checked),
    "an exclusive arm binding rewritten under its own nested match, or a subject borrowed exclusively under a live shared binding, is OWN0011; writes after the nested match are free")
}

test effect fn capturedReferenceParametersLendTheirReferents() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run capturedReferentClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn capturedReferentClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("captured-referents.silk")
  let text = """
struct Counter {
  value: i32
}
fn paramRead(counter: &mut Counter) -> i32 {
  let read = fn() -> i32 { return counter.value }
  counter.value = 5
  return read()
}
fn paramWrite(counter: &mut Counter) -> i32 {
  let mut bump = fn() -> i32 { counter.value = counter.value + 1 return counter.value }
  counter.value = 5
  return bump()
}
fn paramWriteRead(counter: &mut Counter) -> i32 {
  let mut bump = fn() -> i32 { counter.value = counter.value + 1 return counter.value }
  let seen = counter.value
  return bump() + seen
}
fn paramReadRead(counter: &mut Counter) -> i32 {
  let read = fn() -> i32 { return counter.value }
  let seen = counter.value
  return read() + seen
}
fn paramWriteAfterLastUse(counter: &mut Counter) -> i32 {
  let mut bump = fn() -> i32 { counter.value = counter.value + 1 return counter.value }
  let bumped = bump()
  counter.value = 5
  return bumped
}
fn sliceWrite(values: &mut [i32]) -> i32 {
  let mut bump = fn() -> i32 { values[0] = values[0] + 1 return values[0] }
  values[0] = 5
  return bump()
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let read = run Semantic.demandBody(&mut store, &mut request, &id, b"paramRead")
  let write = run Semantic.demandBody(&mut store, &mut request, &id, b"paramWrite")
  let writeRead = run Semantic.demandBody(&mut store, &mut request, &id, b"paramWriteRead")
  let readRead = run Semantic.demandBody(&mut store, &mut request, &id, b"paramReadRead")
  let afterLastUse = run Semantic.demandBody(&mut store, &mut request, &id, b"paramWriteAfterLastUse")
  let slice = run Semantic.demandBody(&mut store, &mut request, &id, b"sliceWrite")
  run Testing.expect(rejectsRelated(&read, RejectionCode.AccessDuringLoan, offsetOf(text, "counter.value = 5", usize.ZERO),
    offsetOf(text, "counter.value }", usize.ZERO)), "a closure reading through a captured `&mut` parameter lends its referent, so a write through the parameter while the closure lives is OWN0011")
  run Testing.expect(rejectsRelated(&write, RejectionCode.AccessDuringLoan, offsetOf(text, "counter.value = 5", usize.ONE),
    offsetOf(text, "counter.value = counter.value + 1", usize.ZERO)), "a closure writing through a captured `&mut` parameter reborrows its referent exclusively")
  run Testing.expect(rejectsRelated(&writeRead, RejectionCode.AccessDuringLoan, offsetOf(text, "counter.value\n  return bump() + seen", usize.ZERO),
    offsetOf(text, "counter.value = counter.value + 1", usize.ONE)), "even a read through the parameter conflicts with the closure's exclusive reborrow")
  run Testing.expect(hasBorrowStatus(&readRead, BodyBorrowStatus.Checked),
    "a shared capture leaves reads through the parameter available")
  run Testing.expect(hasBorrowStatus(&afterLastUse, BodyBorrowStatus.Checked),
    "the reborrow ends at the closure's last use")
  run Testing.expect(rejectsRelated(&slice, RejectionCode.AccessDuringLoan, offsetOf(text, "values[0] = 5", usize.ZERO),
    offsetOf(text, "values[0] = values[0] + 1", usize.ZERO)), "a captured `&mut` slice lends its referent, whose elements an index reaches")
}

test effect fn referentLoansCrossJoinsHoldersAndReturns() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run referentCrossingClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn referentCrossingClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("referent-crossings.silk")
  let text = """
struct Pair {
  a: i32
  b: i32
}
enum Side {
  Left,
  Right,
}
fn armsThenRead(p: &mut Pair, side: Side) -> i32 {
  let view = match side {
    Side.Left => &p.a
    Side.Right => &p.b
  }
  let seen = p.a
  return view.* + seen
}
fn leftArmThenWritten(p: &mut Pair, side: Side) -> i32 {
  let view = match side {
    Side.Left => &p.a
    Side.Right => &p.b
  }
  p.a = 5
  return view.*
}
fn armsThenWritten(p: &mut Pair, side: Side) -> i32 {
  let view = match side {
    Side.Left => &p.a
    Side.Right => &p.b
  }
  p.b = 5
  return view.*
}
fn cursorAfterLastUse(p: &mut Pair) -> i32 {
  let mut cursor = &p.a
  let seen = cursor.*
  p.a = 5
  return seen
}
fn cursorWhileLive(p: &mut Pair) -> i32 {
  let mut cursor = &p.a
  p.a = 5
  return cursor.*
}
fn cursorReplaced(p: &mut Pair) -> i32 {
  let mut cursor = &p.a
  cursor = &p.b
  p.a = 5
  return cursor.*
}
fn returnedField<'a>(p: &'a Pair) -> &'a i32 {
  return &p.a
}
fn joinedLocals(side: Side) -> i32 {
  let x = 1
  let y = 2
  let view = match side {
    Side.Left => &x
    Side.Right => &y
  }
  return view.*
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let armsRead = run Semantic.demandBody(&mut store, &mut request, &id, b"armsThenRead")
  let leftWrite = run Semantic.demandBody(&mut store, &mut request, &id, b"leftArmThenWritten")
  let armsWrite = run Semantic.demandBody(&mut store, &mut request, &id, b"armsThenWritten")
  let afterLastUse = run Semantic.demandBody(&mut store, &mut request, &id, b"cursorAfterLastUse")
  let whileLive = run Semantic.demandBody(&mut store, &mut request, &id, b"cursorWhileLive")
  let replaced = run Semantic.demandBody(&mut store, &mut request, &id, b"cursorReplaced")
  let returned = run Semantic.demandBody(&mut store, &mut request, &id, b"returnedField")
  let locals = run Semantic.demandBody(&mut store, &mut request, &id, b"joinedLocals")
  run Testing.expect(hasBorrowStatus(&armsRead, BodyBorrowStatus.Checked),
    "a view joined from two arms lends shared referents, which a read leaves available")
  run Testing.expect(rejectsRelated(&leftWrite, RejectionCode.AccessDuringLoan, offsetOf(text, "p.a = 5", usize.ZERO),
    offsetOf(text, "&p.a", usize.ONE)), "an arm-joined view keeps the loan of each arm, so writing either referent is OWN0011")
  run Testing.expect(rejectsRelated(&armsWrite, RejectionCode.AccessDuringLoan, offsetOf(text, "p.b = 5", usize.ZERO),
    offsetOf(text, "&p.b", 2)), "a match result keeps the loan of every arm that yields it")
  run Testing.expect(hasBorrowStatus(&afterLastUse, BodyBorrowStatus.Checked),
    "a `let mut` holder of a referent loan releases it after its last use")
  run Testing.expect(rejectsRelated(&whileLive, RejectionCode.AccessDuringLoan, offsetOf(text, "p.a = 5", 2),
    offsetOf(text, "&p.a", 4)), "a `let mut` holder's current loan conflicts while the holder is live")
  run Testing.expect(hasBorrowStatus(&replaced, BodyBorrowStatus.Regions),
    "a whole replacement releases its previous referent loan before the old referent is written")
  run Testing.expect(hasBorrowStatus(&returned, BodyBorrowStatus.Checked),
    "a returned field view keeps the universal lifetime of the reference reaching its storage")
  run Testing.expect(hasBorrowStatus(&locals, BodyBorrowStatus.Checked),
    "a joined loan of a body local stays within modeled storage and is checked")
}

test effect fn enclosingTypeParametersRetainNothing() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run enclosingParameterClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// The borrow status of the first anonymous body an answer's checked body constructs.
fn anonymousStatus(answer: &Shared<Result<Answer, NoRejection>>, status: BodyBorrowStatus) -> bool {
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: typed} = move body {
    return Shared<TypedBody>.with<bool>(&typed, fn(value: &TypedBody) -> bool {
      let nodes = TypedBody.nodeSlice(value)
      let mut at = usize.ZERO
      while at < nodes.length {
        if let BodyNodeKind.Expression {form: BodyExpression.Callable {body: anonymous, ..}, ..} = &nodes[at].kind {
          return Shared<TypedBody>.with<BodyBorrowStatus>(&anonymous, TypedBody.borrowStatus) == status
        }
        at = at + usize.ONE
      }
      return false
    })
  }
  return false
}

effect fn enclosingParameterClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("enclosing-parameters.silk")
  let text = """
struct Cell {
  value: i32
  done: bool
}
struct Held<'c, A> {
  view: &'c i32
  value: A
}
fn produce<'c, X, A>(source: &'c mut X, value: A) -> A { return value }
fn hold<'c, A>(cell: &'c mut Cell, value: A) -> Held<'c, A> { return Held {view: &cell.value, value: value} }
fn closureInGeneric<A: Intrinsic.Copy>(cell: &mut Cell, seed: A) -> A {
  let use = fn(owned: &mut Cell) -> A {
    let value = produce(&mut owned.*, seed)
    owned.done = true
    return value
  }
  return use(&mut cell.*)
}
fn closureKeepsRegion<A: Intrinsic.Copy>(cell: &mut Cell, seed: A) -> i32 {
  let use = fn(owned: &mut Cell) -> i32 {
    let held = hold(&mut owned.*, seed)
    owned.done = true
    return held.view.*
  }
  return use(&mut cell.*)
}
struct Holder<T> {
  item: T
  count: i32
}
impl<T> Holder<T> {
  fn take(self: &mut Self, value: T) -> T {
    let item = produce(&mut self.*, move value)
    self.count = 1
    return move item
  }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let generic = run Semantic.demandBody(&mut store, &mut request, &id, b"closureInGeneric")
  let kept = run Semantic.demandBody(&mut store, &mut request, &id, b"closureKeepsRegion")
  let source = run present(text)
  let mut index = SourceIndex.make(run Revision.publish(&Revision.make(), &id, &source))
  let takeId = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"take", usize.ZERO)
  let method = run Semantic.demandBodyOf(&mut store, &mut request, &takeId)
  run Testing.expect(anonymousStatus(&generic, BodyBorrowStatus.Checked),
    "the closure proves its own parameter bound and its enclosing type parameter retains no body loan")
  run Testing.expect(rejectsRelated(&kept, RejectionCode.AccessDuringLoan, offsetOf(text, "owned.done = true", usize.ONE),
      offsetOf(text, "&mut owned.*", usize.ONE)),
    "erasing an enclosing type parameter keeps a region the result's signature names, so that loan still conflicts")
  run Testing.expect(hasBorrowStatus(&method, BodyBorrowStatus.Checked),
    "a method's generic result holds no body loan, and its retagged argument's source bound is proved")
}

test effect fn loanConflictsInPlainBodies() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run loanConflictClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn loanConflictClaims() -> ()
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let id = run module("loan-conflicts.silk")
  let text = """
struct Pair {
  left: i32
  right: i32
}
struct Source { value: i32 }
struct Resolver { source: Source }
effect fn bodyArgument(source: &Source) -> i32 { return source.value }
effect fn checkNamedValue(resolver: &mut Resolver, argument: i32) -> i32 {
  resolver.source.value = argument
  return argument
}
effect fn unhoisted(resolver: &mut Resolver) -> i32 {
  return run checkNamedValue(&mut resolver.*, run bodyArgument(&resolver.source))
}
effect fn hoisted(resolver: &mut Resolver) -> i32 {
  let argument = run bodyArgument(&resolver.source)
  return run checkNamedValue(&mut resolver.*, argument)
}
fn read<'a>(value: &'a i32) -> i32 { return value.* }
fn write<'a>(value: &'a mut i32) -> () { value.* = 1 }
fn both<'a, 'b>(left: &'a mut i32, right: &'b i32) -> () { left.* = right.* }
fn heldRead() -> i32 {
  let mut value = 1
  let view = &mut value
  let copy = value
  write(move view)
  return copy
}
fn heldWrite() -> i32 {
  let mut value = 1
  let view = &value
  value = 2
  return read(view)
}
fn argumentLoans() -> () {
  let mut value = 1
  both(&mut value, &value)
}
fn disjointFields() -> i32 {
  let mut pair = Pair {left: 1, right: 2}
  let left = &mut pair.left
  let right = &pair.right
  write(move left)
  return read(right)
}
fn endedLoan() -> i32 {
  let mut value = 1
  let view = &mut value
  write(move view)
  return value
}
type Values = [i32; 2]
fn store(values: &mut Values, index: usize) -> i32 {
  values[index] = 7
  return values[index]
}
fn lengthDuringLoan() -> i32 {
  let mut values = [1, 2]
  return store(&mut values, values.length - 1)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let heldRead = run Semantic.demandBody(&mut store, &mut request, &id, b"heldRead")
  let heldWrite = run Semantic.demandBody(&mut store, &mut request, &id, b"heldWrite")
  let argumentLoans = run Semantic.demandBody(&mut store, &mut request, &id, b"argumentLoans")
  let disjoint = run Semantic.demandBody(&mut store, &mut request, &id, b"disjointFields")
  let ended = run Semantic.demandBody(&mut store, &mut request, &id, b"endedLoan")
  let length = run Semantic.demandBody(&mut store, &mut request, &id, b"lengthDuringLoan")
  let unhoisted = run Semantic.demandBody(&mut store, &mut request, &id, b"unhoisted")
  let hoisted = run Semantic.demandBody(&mut store, &mut request, &id, b"hoisted")
  run Testing.expect(
    rejectsSpan(&unhoisted, RejectionCode.LoanConflict, text, "&resolver.source", usize.ZERO)
      && rejectsRelated(
      &unhoisted,
      RejectionCode.LoanConflict,
      offsetOf(text, "&resolver.source", usize.ZERO),
      offsetOf(text, "&mut resolver.*", usize.ZERO)
    ),
    "the pre-hoist compiler call rejects the later source borrow while its first exclusive argument is live (OWN0010)",
  )
  run Testing.expect(
    loansProved(&hoisted),
    "hoisting bodyArgument ends the source loan before the resolver's exclusive call argument"
  )
  let readAt = offsetOf(text, "let copy = value", usize.ZERO) + 11
  run Testing.expect(
    rejectsRelated(
      &heldRead,
      RejectionCode.AccessDuringLoan,
      readAt,
      offsetOf(text, "&mut value", usize.ZERO)
    ),
    "reading an owner while a held exclusive loan is still used later is OWN0011 at the read"
  )
  run Testing.expect(
    rejectsRelated(
      &heldWrite,
      RejectionCode.AccessDuringLoan,
      offsetOf(text, "value = 2", usize.ZERO),
      offsetOf(text, "&value", usize.ZERO)
    ),
    "writing an owner while a held shared loan is still used later is OWN0011"
  )
  run Testing.expect(
    rejectsSpan(&argumentLoans, RejectionCode.LoanConflict, text, "&value", usize.ONE)
      && rejectsRelated(
      &argumentLoans,
      RejectionCode.LoanConflict,
      offsetOf(text, "&value)", usize.ZERO),
      offsetOf(text, "both(&mut value", usize.ZERO) + 5
    ),
    "a later argument cannot borrow an owner an earlier argument borrowed exclusively (BORROW-004, OWN0010)"
  )
  run Testing.expect(
    succeeded(&disjoint) && succeeded(&ended),
    "disjoint fields do not conflict, and a loan ends at its holder's last use"
  )
  run Testing.expect(
    rejectsRelated(
      &length,
      RejectionCode.AccessDuringLoan,
      offsetOf(text, "values.length", usize.ZERO),
      offsetOf(text, "&mut values", usize.ZERO)
    ),
    "reading even a fixed array's length during a later argument's exclusive loan is OWN0011 (BORROW-004)"
  )
}

// BORROW-006 temporaries end where lowering ends them. Regressions: observing a viewing binding's
// retained temporary's cleanup at its statement (a use after drop), or keeping a condition's,
// guard's or short-circuit operand's temporary past the operand (a false OWN0011).
test effect fn temporaryCleanupFollowsLowering() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run temporaryCleanupClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn temporaryCleanupClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("temporary-cleanup.silk")
  let text = """
struct D { value: i32 }
impl Intrinsic.Drop for D { fn drop(self: &mut D) -> () { self.value = 0 return () } }
struct Guard<'a> { target: &'a D }
impl<'a> Intrinsic.Drop for Guard<'a> { fn drop(self: &mut Guard<'a>) -> () { let seen = self.target.value return () } }
fn check(guard: &Guard) -> bool { return guard.target.value > 0 }
enum Side { Left, Right }
fn retained() -> i32 {
  let x = D {value: 7}
  let view = &Guard {target: &x}
  drop x
  return 0
}
fn condition() -> i32 {
  let mut x = D {value: 7}
  if check(&Guard {target: &x}) { x.value = 3 }
  return x.value
}
fn repeated() -> i32 {
  let mut x = D {value: 7}
  while check(&Guard {target: &x}) { x.value = 0 }
  return x.value
}
fn guarded(side: Side) -> i32 {
  let mut x = D {value: 7}
  match side {
    Side.Left if check(&Guard {target: &x}) => { x.value = 3 }
    _ => {}
  }
  return x.value
}
fn shortCircuit(flag: bool) -> i32 {
  let mut x = D {value: 7}
  if flag && check(&Guard {target: &x}) { x.value = 3 }
  return x.value
}
struct Pair { first: i32 second: i32 }
fn pairOf(guard: &Guard) -> Pair { return Pair {first: 1, second: 2} }
fn destructured() -> i32 {
  let x = D {value: 7}
  let Pair {first, second} = &pairOf(&Guard {target: &x})
  drop x
  return 0
}
fn keep<T>(value: T, guard: &Guard) -> T { return move value }
fn generic<T>(value: T) -> T {
  let x = D {value: 7}
  let kept = keep<T>(move value, &Guard {target: &x})
  drop x
  return move kept
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let retained = run Semantic.demandBody(&mut store, &mut request, &id, b"retained")
  let condition = run Semantic.demandBody(&mut store, &mut request, &id, b"condition")
  let repeated = run Semantic.demandBody(&mut store, &mut request, &id, b"repeated")
  let guarded = run Semantic.demandBody(&mut store, &mut request, &id, b"guarded")
  let shortCircuit = run Semantic.demandBody(&mut store, &mut request, &id, b"shortCircuit")
  let destructured = run Semantic.demandBody(&mut store, &mut request, &id, b"destructured")
  let generic = run Semantic.demandBody(&mut store, &mut request, &id, b"generic")
  run Testing.expect(rejectsWith(&retained, RejectionCode.AccessDuringLoan),
    "a viewing binding keeps its initializer's temporaries, whose cleanup observes their loans at scope exit")
  run Testing.expect(rejectsWith(&destructured, RejectionCode.AccessDuringLoan) && rejectsWith(&generic, RejectionCode.AccessDuringLoan),
    "a borrowing destructuring let, or a binding whose type parameter may view, keeps its temporaries likewise")
  run Testing.expect(succeeded(&condition) && succeeded(&repeated) && succeeded(&guarded) && succeeded(&shortCircuit),
    "a condition's, guard's or short-circuit operand's temporaries end with that operand")
}

// A displaced value that retains a region carries what its place held. Regressions: dropping the
// loans a reference reaches when its referent's view is displaced (a dangling view), or admitting a
// loan stored behind a reference or moved out of a local holder without modeling it.
test effect fn retainedDisplacementsCarryTheirPlace() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run retainedDisplacementClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn retainedDisplacementClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("retained-displacement.silk")
  let text = """
union Maybe<T> { None, Some { value: T } }
struct Slot<'a> { view: Maybe<&'a i32> }
fn take<'a>(slot: &mut Slot<'a>) -> Maybe<&'a i32> {
  return Intrinsic.replace(slot.view, Maybe<&'a i32>.None)
}
fn stored<'a>(slot: &mut Slot<'a>, other: &'a i32) -> i32 {
  let old = Intrinsic.replace(slot.view, Maybe<&'a i32>.Some {value: &other.*})
  return 0
}
fn holder() -> i32 {
  let value = 1
  let mut slot = Slot {view: Maybe<&i32>.Some {value: &value}}
  let old = Intrinsic.replace(slot.view, Maybe<&i32>.None)
  return 0
}
fn carried() -> i32 {
  let mut value = 1
  let mut slot = Slot {view: Maybe<&i32>.Some {value: &value}}
  let reference = &mut slot
  let old = Intrinsic.replace(reference.view, Maybe<&i32>.None)
  value = 2
  drop old
  return 0
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let take = run Semantic.demandBody(&mut store, &mut request, &id, b"take")
  let stored = run Semantic.demandBody(&mut store, &mut request, &id, b"stored")
  let holder = run Semantic.demandBody(&mut store, &mut request, &id, b"holder")
  let carried = run Semantic.demandBody(&mut store, &mut request, &id, b"carried")
  run Testing.expect(succeeded(&take) && !hasBorrowStatus(&take, BodyBorrowStatus.StoredLoans),
    "displacing a retaining value behind a reference parameter carries only what the reference reaches")
  run Testing.expect(hasBorrowStatus(&stored, BodyBorrowStatus.StoredLoans) && hasBorrowStatus(&holder, BodyBorrowStatus.StoredLoans),
    "a loan stored behind a reference, or a retaining value displaced out of a local holder, stays unchecked")
  run Testing.expect(rejectsFrom(&carried, RejectionCode.AccessDuringLoan, offsetOf(text, "value = 2", usize.ZERO)),
    "a displaced view keeps the loans its reference reaches live (OWN0011)")
}

test effect fn borrowStatusNamesWhatRemains() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run borrowStatusClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn borrowStatusClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("borrow-status.silk")
  let text = """
struct Pair { first: i32 second: i32 }
impl Pair {
  fn left(self: &Self) -> &i32 { return &self.first }
}
fn make() -> Pair { return Pair {first: 1, second: 2} }
fn scalar(value: i32) -> i32 { return value + 1 }
fn clear() -> i32 {
  let mut value = 1
  let view = &mut value
  view.* = 2
  return value
}
fn captured() -> i32 {
  let value = 1
  let read = fn() -> i32 { return value }
  return read()
}
fn parameterized(source: &i32) -> i32 {
  let value = source.*
  let view = &value
  return view.* + source.*
}
fn invoked(read: fn(&i32) -> i32) -> i32 {
  let value = 1
  return read(&value)
}
fn pick<'a>(first: &'a i32, second: &'a i32) -> &'a i32 { return first }
fn picked<'x>(outer: &'x i32) -> i32 {
  let value = 1
  let chosen = pick(outer, &value)
  return chosen.*
}
struct Store { values: [i32; 2] count: usize }
union Holder { Empty { anchor: [i32; 0] }, Full { store: Store } }
fn passThrough(anchor: &[i32]) -> &[i32] {
  return anchor
}
fn view(self: &Holder) -> &[i32] {
  return match &self.* {
    Holder.Empty {anchor} => passThrough(&anchor)
    Holder.Full {store} => passThrough(&store.values)
  }
}
fn bump(amount: i32, target: &mut i32) -> i32 {
  target.* = target.* + amount
  return target.*
}
fn forwarded() -> i32 {
  let mut value = 1
  let first = &mut value
  let mut next = bump(first)
  return next(2)
}
fn temporary() -> i32 {
  let whole = &make()
  return whole.first
}
fn temporaryReceiver() -> i32 {
  let left = make().left()
  return left.*
}
fn read(value: &i32) -> i32 { return value.* }
fn statementReceiver() -> i32 {
  let value = make().left().*
  return read(make().left()) + value
}
fn identity(values: &[i32]) -> &[i32] { return values }
fn arrayTemporary() -> i32 {
  let view = identity(&[1, 2])
  return view[0]
}
fn stored() -> i32 {
  let value = 1
  let mut view = &value
  return view.*
}
fn indexed(at: usize) -> i32 {
  let mut values = [1, 2]
  let first = &mut values[at]
  let second = values[0]
  first.* = second
  return values[1]
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let scalar = run Semantic.demandBody(&mut store, &mut request, &id, b"scalar")
  let clear = run Semantic.demandBody(&mut store, &mut request, &id, b"clear")
  let captured = run Semantic.demandBody(&mut store, &mut request, &id, b"captured")
  let parameterized = run Semantic.demandBody(&mut store, &mut request, &id, b"parameterized")
  let invoked = run Semantic.demandBody(&mut store, &mut request, &id, b"invoked")
  let passed = run Semantic.demandBody(&mut store, &mut request, &id, b"passThrough")
  let viewed = run Semantic.demandBody(&mut store, &mut request, &id, b"view")
  let picked = run Semantic.demandBody(&mut store, &mut request, &id, b"picked")
  let forwarded = run Semantic.demandBody(&mut store, &mut request, &id, b"forwarded")
  let temporary = run Semantic.demandBody(&mut store, &mut request, &id, b"temporary")
  let temporaryReceiver = run Semantic.demandBody(&mut store, &mut request, &id, b"temporaryReceiver")
  let statementReceiver = run Semantic.demandBody(&mut store, &mut request, &id, b"statementReceiver")
  let arrayTemporary = run Semantic.demandBody(&mut store, &mut request, &id, b"arrayTemporary")
  let stored = run Semantic.demandBody(&mut store, &mut request, &id, b"stored")
  let indexed = run Semantic.demandBody(&mut store, &mut request, &id, b"indexed")
  run Testing.expect(hasBorrowStatus(&scalar, BodyBorrowStatus.Checked) && hasBorrowStatus(&clear, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&captured, BodyBorrowStatus.Checked),
    "a body whose loans and moves are proved and whose regions are all its own loans is checked")
  run Testing.expect(hasBorrowStatus(&parameterized, BodyBorrowStatus.Checked) && hasBorrowStatus(&passed, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&invoked, BodyBorrowStatus.Checked),
    "a proved body whose regions are its own loans, its lifetime parameters and a callable's local invocation regions is checked")
  run Testing.expect(hasBorrowStatus(&picked, BodyBorrowStatus.Regions),
    "a loan of a local related to a lifetime parameter is a pending region obligation")
  run Testing.expect(hasBorrowStatus(&viewed, BodyBorrowStatus.Checked),
    "the body proves each crossed reborrow from its parent descriptor, independently of callee verdicts")
  run Testing.expect(rejectsFrom(&forwarded, RejectionCode.ExplicitMoveRequired, offsetOf(text, "first)", usize.ZERO)),
    "staging an exclusive view into a named function's section without `move` is OWN0003")
  run Testing.expect(rejectsSpan(&temporary, RejectionCode.ExpiredLifetime, text, "whole.first", usize.ZERO)
      && rejectsSpan(&temporaryReceiver, RejectionCode.ExpiredLifetime, text, "left.*", usize.ZERO),
    "a view of a temporary, written or a borrowed receiver, used past its statement is OWN0019 at the use (BORROW-006, CALL-003)")
  run Testing.expect(hasBorrowStatus(&statementReceiver, BodyBorrowStatus.Checked),
    "a temporary receiver's view used within its statement is checked")
  run Testing.expect(hasBorrowStatus(&arrayTemporary, BodyBorrowStatus.Checked),
    "a borrowed array temporary in a viewing binding's initializer lives for the binding's scope (BORROW-006)")
  run Testing.expect(hasBorrowStatus(&stored, BodyBorrowStatus.Checked),
    "an unchecked body names the first form outside the checked slices")
  run Testing.expect(rejectsSpan(&indexed, RejectionCode.AccessDuringLoan, text, "values[0]", 0),
    "a read a runtime index may route to the exclusively lent element conflicts with the loan (OWN0011)")
}

test effect fn matchAccessesAreChecked() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run matchAccessClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// A match accesses its subject once as its form declares (MATCH-001); its arms are separate paths that
// join after it, and its bindings are places of the subject (MATCH-002).
effect fn matchAccessClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("match-access.silk")
  let text = """
struct Narrow { first: i32 second: i32 }
union Choice { Left { value: Narrow }, Right { code: i32 } }
enum Flag { On, Off }
fn read(value: &Narrow) -> i32 { return value.first }
fn take(value: Narrow) -> i32 { return value.first }
fn increment(value: &mut Narrow) -> () { value.first = value.first + 1 }
fn inspect(choice: &Choice) -> i32 { return 0 }
fn shared(choice: Choice) -> i32 {
  let held = move choice
  let view = &held
  let code = match &held { Choice.Left {value} => read(&value) Choice.Right {code} => code }
  return code + match &view.* { Choice.Left {..} => 1 Choice.Right {..} => 2 }
}
fn exclusiveDuringView(choice: Choice) -> i32 {
  let mut held = move choice
  let view = &held
  match &mut held { Choice.Left {value} => { increment(&mut value) } Choice.Right {..} => {} }
  return match &view.* { Choice.Left {..} => 1 Choice.Right {..} => 2 }
}
fn bindingDuringLoan(choice: Choice) -> i32 {
  let mut held = move choice
  let mut seen = 0
  match &mut held {
    Choice.Left {value} => {
      let other = &held
      increment(&mut value)
      seen = inspect(other)
    }
    Choice.Right {..} => {}
  }
  return seen
}
fn movedSubject(choice: Choice) -> i32 {
  let code = match move choice { Choice.Left {value} => take(move value) Choice.Right {code} => code }
  return code + match &choice { Choice.Left {..} => 1 Choice.Right {..} => 2 }
}
fn movedBinding(choice: Choice) -> i32 {
  let mut total = 0
  match move choice {
    Choice.Left {value} => {
      let first = take(move value)
      total = first + take(move value)
    }
    Choice.Right {code} => { total = code }
  }
  return total
}
fn eachArmMoves(flag: Flag, value: Narrow) -> i32 {
  return match flag { Flag.On => take(move value) Flag.Off => take(move value) + 1 }
}
fn afterEveryArm(flag: Flag, value: Narrow) -> i32 {
  let code = match flag { Flag.On => take(move value) Flag.Off => 0 }
  return code + take(move value)
}
fn guarded(flag: Flag, value: Narrow) -> i32 {
  return match flag { Flag.On if read(&value) > 0 => take(move value) _ => read(&value) }
}
union Slot { Vacant, Filled { item: Narrow, spare: Narrow } }
struct Shelf {
  slot: Slot
  count: i32
}
fn filled() -> Slot { return Slot.Filled { item: Narrow { first: 1, second: 2 }, spare: Narrow { first: 3, second: 4 } } }
fn placeWriteThenUse() -> i32 {
  let mut slot = filled()
  let mut out = 0
  match place slot {
    Slot.Filled { item: stale, .. } => {
      slot = Slot.Vacant
      out = stale.first
    }
    Slot.Vacant => {}
  }
  return out
}
fn placeUseThenWrite() -> i32 {
  let mut slot = filled()
  let mut out = 0
  match place slot {
    Slot.Filled { item: fresh, .. } => {
      out = fresh.first
      slot = Slot.Vacant
    }
    Slot.Vacant => {}
  }
  return out
}
fn placeSameVariant() -> i32 {
  let mut slot = filled()
  let mut out = 0
  match place slot {
    Slot.Filled { item: renewed, .. } => {
      slot = filled()
      out = renewed.first
    }
    Slot.Vacant => {}
  }
  return out
}
fn placeOwnerPrefix() -> i32 {
  let mut shelf = Shelf { slot: filled(), count: 0 }
  let mut out = 0
  match place shelf.slot {
    Slot.Filled { item: boxed, .. } => {
      shelf = Shelf { slot: Slot.Vacant, count: 1 }
      out = boxed.first
    }
    Slot.Vacant => {}
  }
  return out
}
fn placeSibling() -> i32 {
  let mut shelf = Shelf { slot: filled(), count: 0 }
  let mut out = 0
  match place shelf.slot {
    Slot.Filled { item: kept, .. } => {
      shelf.count = 5
      out = kept.first
    }
    Slot.Vacant => {}
  }
  return out
}
fn placeArmLoop() -> i32 {
  let mut slot = filled()
  let mut out = 0
  match place slot {
    Slot.Filled { item: looped, .. } => {
      let mut lap = 0
      while lap < 2 {
        out = out + looped.first
        slot = Slot.Vacant
        lap = lap + 1
      }
    }
    Slot.Vacant => {}
  }
  return out
}
fn placeRetested() -> i32 {
  let mut slot = filled()
  let mut out = 0
  let mut lap = 0
  while lap < 2 {
    match place slot {
      Slot.Filled { item: again, .. } => {
        out = out + again.first
        slot = filled()
      }
      Slot.Vacant => {}
    }
    lap = lap + 1
  }
  return out
}
fn clearSlot(slot: &mut Slot) -> () {
  slot.* = Slot.Vacant
  return ()
}
impl Slot {
  fn empty(self: &mut Self) -> () {
    self.* = Slot.Vacant
    return ()
  }
}
fn clearShelf(shelf: &mut Shelf) -> () {
  shelf.slot = Slot.Vacant
  return ()
}
fn bumpCount(count: &mut i32) -> () {
  count.* = count.* + 1
  return ()
}
fn placeLentCall() -> i32 {
  let mut slot = filled()
  let mut out = 0
  match place slot {
    Slot.Filled { item: lentCall, .. } => {
      clearSlot(&mut slot)
      out = lentCall.first
    }
    Slot.Vacant => {}
  }
  return out
}
fn placeLentMethod() -> i32 {
  let mut slot = filled()
  let mut out = 0
  match place slot {
    Slot.Filled { item: lentMethod, .. } => {
      slot.empty()
      out = lentMethod.first
    }
    Slot.Vacant => {}
  }
  return out
}
fn placeLentOwner() -> i32 {
  let mut shelf = Shelf { slot: filled(), count: 0 }
  let mut out = 0
  match place shelf.slot {
    Slot.Filled { item: lentOwner, .. } => {
      clearShelf(&mut shelf)
      out = lentOwner.first
    }
    Slot.Vacant => {}
  }
  return out
}
fn placeIndexWrite(at: usize) -> i32 {
  let mut slots = [filled(), filled()]
  let mut out = 0
  match place slots[0] {
    Slot.Filled { item: indexed, .. } => {
      slots[at] = Slot.Vacant
      out = indexed.first
    }
    Slot.Vacant => {}
  }
  return out
}
fn placeLentSibling() -> i32 {
  let mut shelf = Shelf { slot: filled(), count: 0 }
  let mut out = 0
  match place shelf.slot {
    Slot.Filled { item: besideCount, .. } => {
      bumpCount(&mut shelf.count)
      out = besideCount.first
    }
    Slot.Vacant => {}
  }
  return out
}
fn placeLentAfterUse(at: usize) -> i32 {
  let mut slots = [filled(), filled()]
  let mut out = 0
  match place slots[0] {
    Slot.Filled { item: usedFirst, .. } => {
      out = usedFirst.first
      slots[at] = Slot.Vacant
      clearSlot(&mut slots[1])
    }
    Slot.Vacant => {}
  }
  return out
}
fn placeRuntimeSubject(at: usize) -> i32 {
  let mut slots = [filled(), filled()]
  return match place slots[at] { Slot.Filled { item: runtime, .. } => runtime.first Slot.Vacant => 0 }
}
fn placeReferentSubject(slot: &mut Slot) -> i32 {
  return match place slot.* { Slot.Filled { item: referent, .. } => referent.first Slot.Vacant => 0 }
}
effect fn placeEffectWrite() -> i32 {
  let mut slot = filled()
  let mut out = 0
  match place slot {
    Slot.Filled { item: capturedWrite, .. } => {
      run effect {
        slot = Slot.Vacant
        return ()
      }
      out = capturedWrite.first
    }
    Slot.Vacant => {}
  }
  return out
}
effect fn placeEffectBorrow() -> i32 {
  let mut slot = filled()
  let mut out = 0
  match place slot {
    Slot.Filled { item: capturedBorrow, .. } => {
      run effect {
        clearSlot(&mut slot)
        return ()
      }
      out = capturedBorrow.first
    }
    Slot.Vacant => {}
  }
  return out
}
effect fn placeEffectAfterUse() -> i32 {
  let mut slot = filled()
  let mut out = 0
  match place slot {
    Slot.Filled { item: beforeEffect, .. } => {
      out = beforeEffect.first
      run effect {
        slot = Slot.Vacant
        return ()
      }
    }
    Slot.Vacant => {}
  }
  return out
}
fn placeBindingWrite() -> i32 {
  let mut slot = filled()
  let mut out = 0
  match place slot {
    Slot.Filled { item: written, .. } => {
      written.first = 5
      out = written.first
    }
    Slot.Vacant => {}
  }
  return out
}
fn placeBindingReplace() -> i32 {
  let mut shelf = Shelf { slot: filled(), count: 0 }
  let mut out = 0
  match place shelf.slot {
    Slot.Filled { item: replaced, .. } => {
      replaced = Narrow { first: 7, second: 8 }
      let displaced = Intrinsic.replace(replaced, Narrow { first: 9, second: 10 })
      out = replaced.first + displaced.second
    }
    Slot.Vacant => {}
  }
  return out
}
fn placeBindingImmutable() -> i32 {
  let slot = filled()
  return match place slot {
    Slot.Filled { item: frozen, .. } => {
      frozen.first = 5
      frozen.first
    }
    Slot.Vacant => 0
  }
}
fn placeBindingLent() -> i32 {
  let mut slot = filled()
  return match place slot {
    Slot.Filled { item: lentItem, .. } => {
      let view = &mut lentItem
      view.first
    }
    Slot.Vacant => 0
  }
}
fn placeBindingIndexLoan(at: usize) -> i32 {
  let mut shelves = [Shelf { slot: filled(), count: 1 }, Shelf { slot: filled(), count: 2 }]
  let viewed = &shelves[at]
  let mut out = 0
  match place shelves[0].slot {
    Slot.Filled { item: loanedItem, .. } => {
      loanedItem.first = 5
      out = loanedItem.first
    }
    Slot.Vacant => {}
  }
  return out + viewed.count
}
fn exclusiveBindingWrites() -> i32 {
  let mut slot = filled()
  let mut seen = 0
  match &mut slot {
    Slot.Filled { item: swapped, spare: edited } => {
      swapped = Narrow { first: 7, second: 8 }
      edited.first = 5
      let previous = Intrinsic.replace(swapped, Narrow { first: 9, second: 10 })
      seen = previous.first + edited.first
    }
    Slot.Vacant => {}
  }
  return seen
}
union Rack { Empty, Stocked { shelf: Shelf } }
fn placeBindingLentRoot() -> i32 {
  let mut rack = Rack.Stocked { shelf: Shelf { slot: filled(), count: 0 } }
  return match &mut rack {
    Rack.Stocked { shelf: lentShelf } => match place lentShelf.slot {
      Slot.Filled { item: borrowedItem, .. } => {
        borrowedItem.first = 5
        borrowedItem.first
      }
      Slot.Vacant => 0
    }
    Rack.Empty => 0
  }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let shared = run Semantic.demandBody(&mut store, &mut request, &id, b"shared")
  let exclusiveDuringView = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusiveDuringView")
  let bindingDuringLoan = run Semantic.demandBody(&mut store, &mut request, &id, b"bindingDuringLoan")
  let movedSubject = run Semantic.demandBody(&mut store, &mut request, &id, b"movedSubject")
  let movedBinding = run Semantic.demandBody(&mut store, &mut request, &id, b"movedBinding")
  let eachArmMoves = run Semantic.demandBody(&mut store, &mut request, &id, b"eachArmMoves")
  let afterEveryArm = run Semantic.demandBody(&mut store, &mut request, &id, b"afterEveryArm")
  let guarded = run Semantic.demandBody(&mut store, &mut request, &id, b"guarded")
  run Testing.expect(loansProved(&shared) && loansProved(&eachArmMoves)
      && loansProved(&guarded),
    "a shared match beside a shared loan, a move on each separate arm, and a guard that reads before its arm moves are proved")
  run Testing.expect(rejectsRelated(&exclusiveDuringView, RejectionCode.AccessDuringLoan, offsetOf(text, "held {", 1),
      offsetOf(text, "&held", 2)),
    "a match &mut while a shared loan of its subject is still used later is OWN0011 at the subject")
  run Testing.expect(rejectsRelated(&bindingDuringLoan, RejectionCode.LoanConflict, offsetOf(text, "&mut value)", 1),
      offsetOf(text, "&held", 3)),
    "an exclusive binding is the subject's payload, so borrowing it conflicts with a live loan of the subject (MATCH-002, BORROW-001, OWN0010)")
  run Testing.expect(rejectsRelated(&movedSubject, RejectionCode.UseAfterMove, offsetOf(text, "choice {", 1),
      offsetOf(text, "choice {", usize.ZERO)),
    "a subject consumed by match move is moved after the match (OWN0001)")
  run Testing.expect(rejectsSpan(&movedBinding, RejectionCode.UseAfterMove, text, "move value", 2),
    "a binding of a consuming match is an arm-local owner that moves once (OWN0001)")
  run Testing.expect(rejectsSpan(&afterEveryArm, RejectionCode.UseAfterMove, text, "move value", 6),
    "a move on one arm reaches the join after the match (FLOW-001)")
  let placeWriteThenUse = run Semantic.demandBody(&mut store, &mut request, &id, b"placeWriteThenUse")
  let placeSameVariant = run Semantic.demandBody(&mut store, &mut request, &id, b"placeSameVariant")
  let placeOwnerPrefix = run Semantic.demandBody(&mut store, &mut request, &id, b"placeOwnerPrefix")
  run Testing.expect(rejectsRelated(&placeWriteThenUse, RejectionCode.ExtractionBoundary, offsetOf(text, "stale.first", usize.ZERO),
      offsetOf(text, "slot = Slot.Vacant", usize.ZERO))
      && rejectsSpan(&placeSameVariant, RejectionCode.ExtractionBoundary, text, "renewed.first", usize.ZERO)
      && rejectsSpan(&placeOwnerPrefix, RejectionCode.ExtractionBoundary, text, "boxed.first", usize.ZERO),
    "a match place binding names the payload its match selected, so using it after the subject or its owner is replaced is OWN0002 at the use")
  let placeArmLoop = run Semantic.demandBody(&mut store, &mut request, &id, b"placeArmLoop")
  run Testing.expect(rejectsFrom(&placeArmLoop, RejectionCode.IncompatibleLoopHeader, offsetOf(text, "while lap < 2 {\n        out = out + looped", usize.ZERO)),
    "a loop in the arm that replaces the subject before its next iteration uses a binding repeats incompatibly (OWN0005)")
  let placeUseThenWrite = run Semantic.demandBody(&mut store, &mut request, &id, b"placeUseThenWrite")
  let placeSibling = run Semantic.demandBody(&mut store, &mut request, &id, b"placeSibling")
  let placeRetested = run Semantic.demandBody(&mut store, &mut request, &id, b"placeRetested")
  run Testing.expect(loansProved(&placeUseThenWrite) && loansProved(&placeSibling) && loansProved(&placeRetested),
    "a use before the replacement, a write to a sibling field of the owner, and a loop that selects again each iteration are proved")
  let placeLentCall = run Semantic.demandBody(&mut store, &mut request, &id, b"placeLentCall")
  let placeLentMethod = run Semantic.demandBody(&mut store, &mut request, &id, b"placeLentMethod")
  let placeLentOwner = run Semantic.demandBody(&mut store, &mut request, &id, b"placeLentOwner")
  let placeIndexWrite = run Semantic.demandBody(&mut store, &mut request, &id, b"placeIndexWrite")
  run Testing.expect(rejectsRelated(&placeLentCall, RejectionCode.ExtractionBoundary, offsetOf(text, "lentCall.first", usize.ZERO),
      offsetOf(text, "&mut slot)\n      out = lentCall", usize.ZERO))
      && rejectsSpan(&placeLentMethod, RejectionCode.ExtractionBoundary, text, "lentMethod.first", usize.ZERO)
      && rejectsSpan(&placeLentOwner, RejectionCode.ExtractionBoundary, text, "lentOwner.first", usize.ZERO)
      && rejectsSpan(&placeIndexWrite, RejectionCode.ExtractionBoundary, text, "indexed.first", usize.ZERO),
    "an exclusive borrow of the subject or its owner, or a write an unknown index may route to the subject, replaces it, so a later binding use is OWN0002")
  let placeLentSibling = run Semantic.demandBody(&mut store, &mut request, &id, b"placeLentSibling")
  let placeLentAfterUse = run Semantic.demandBody(&mut store, &mut request, &id, b"placeLentAfterUse")
  run Testing.expect(loansProved(&placeLentSibling) && loansProved(&placeLentAfterUse),
    "an exclusive borrow of a sibling field, and index writes or borrows after the binding's last use, keep the refinement")
  let placeRuntimeSubject = run Semantic.demandBody(&mut store, &mut request, &id, b"placeRuntimeSubject")
  let placeReferentSubject = run Semantic.demandBody(&mut store, &mut request, &id, b"placeReferentSubject")
  run Testing.expect(rejectsFrom(&placeRuntimeSubject, RejectionCode.InvalidMatchScrutineePlace, offsetOf(text, "match place slots[at]", usize.ZERO))
      && rejectsFrom(&placeReferentSubject, RejectionCode.InvalidMatchScrutineePlace, offsetOf(text, "match place slot.*", usize.ZERO)),
    "a place match subject reached through a runtime index or a referent is not a complete binding place (OWN0009)")
  let placeEffectWrite = run Semantic.demandBody(&mut store, &mut request, &id, b"placeEffectWrite")
  let placeEffectBorrow = run Semantic.demandBody(&mut store, &mut request, &id, b"placeEffectBorrow")
  let placeEffectAfterUse = run Semantic.demandBody(&mut store, &mut request, &id, b"placeEffectAfterUse")
  run Testing.expect(rejectsSpan(&placeEffectWrite, RejectionCode.ExtractionBoundary, text, "capturedWrite.first", usize.ZERO)
      && rejectsSpan(&placeEffectBorrow, RejectionCode.ExtractionBoundary, text, "capturedBorrow.first", usize.ZERO)
      && loansProved(&placeEffectAfterUse),
    "an Effect built in the arm that writes or exclusively borrows the subject replaces it from its construction, unless the binding is no longer used (CAPTURE-001)")
  let placeBindingWrite = run Semantic.demandBody(&mut store, &mut request, &id, b"placeBindingWrite")
  let placeBindingReplace = run Semantic.demandBody(&mut store, &mut request, &id, b"placeBindingReplace")
  run Testing.expect(loansProved(&placeBindingWrite) && loansProved(&placeBindingReplace),
    "a match place binding names the subject's own storage, so a mutably owned subject's binding takes field writes and replacement")
  let placeBindingLent = run Semantic.demandBody(&mut store, &mut request, &id, b"placeBindingLent")
  run Testing.expect(rejectsSpan(&placeBindingLent, RejectionCode.ExclusiveBorrowRequiresMutable, text, "lentItem", usize.ONE),
    "an exclusive borrow of a match place binding still needs a mutable binding, as the bootstrap checks it (SEM0057)")
  let placeBindingIndexLoan = run Semantic.demandBody(&mut store, &mut request, &id, b"placeBindingIndexLoan")
  run Testing.expect(rejectsRelated(&placeBindingIndexLoan, RejectionCode.AccessDuringLoan, offsetOf(text, "shelves[0].slot", usize.ZERO),
      offsetOf(text, "&shelves[at]", usize.ZERO)),
    "a place match whose binding writes the subject conflicts with a live loan a runtime index may name (OWN0011)")
  let exclusiveBindingWrites = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusiveBindingWrites")
  run Testing.expect(loansProved(&exclusiveBindingWrites),
    "an exclusive binding mutates the selected payload: a whole replacement, a field write and Intrinsic.replace through it are proved (MATCH-002)")
  let placeBindingImmutable = run Semantic.demandBody(&mut store, &mut request, &id, b"placeBindingImmutable")
  let placeBindingLentRoot = run Semantic.demandBody(&mut store, &mut request, &id, b"placeBindingLentRoot")
  run Testing.expect(rejectsSpan(&placeBindingImmutable, RejectionCode.ImmutableAssignment, text, "frozen.first", usize.ZERO)
      && rejectsSpan(&placeBindingLentRoot, RejectionCode.ImmutableAssignment, text, "borrowedItem.first", usize.ZERO),
    "a binding of an immutable subject, or of a subject a match &mut binding lends rather than owns, is not owned mutable storage (SEM0035)")
}

test effect fn immediateRunsAreCheckedAsCalls() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run immediateRunClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// `run f(..)` of an `effect fn` call executes that one call (EFF-003): its operands are borrowed or
// moved for the call as an ordinary call's arguments are (EFFECT-OWN-001, BORROW-004).
effect fn immediateRunClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("immediate-run.silk")
  let text = """
struct Narrow { first: i32 second: i32 }
effect fn bump(value: &mut i32) -> () { value.* = value.* + 1 }
effect fn peek(value: &i32) -> i32 { return value.* }
effect fn both(left: &mut i32, right: &i32) -> () { left.* = right.* }
effect fn take(value: Narrow) -> i32 { return value.first }
effect fn sequenced() -> i32 {
  let mut value = 1
  run bump(&mut value)
  let view = &value
  return run peek(view)
}
effect fn runArguments() -> () {
  let mut value = 1
  run both(&mut value, &value)
}
effect fn heldAcrossRun() -> i32 {
  let mut value = 1
  let view = &value
  run bump(&mut value)
  return view.*
}
effect fn movedByRun(value: Narrow) -> i32 {
  let first = run take(move value)
  return first + value.second
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let sequenced = run Semantic.demandBody(&mut store, &mut request, &id, b"sequenced")
  let runArguments = run Semantic.demandBody(&mut store, &mut request, &id, b"runArguments")
  let heldAcrossRun = run Semantic.demandBody(&mut store, &mut request, &id, b"heldAcrossRun")
  let movedByRun = run Semantic.demandBody(&mut store, &mut request, &id, b"movedByRun")
  run Testing.expect(loansProved(&sequenced),
    "loans that end before the next immediate run are proved, leaving only regions")
  run Testing.expect(rejectsRelated(&runArguments, RejectionCode.LoanConflict, offsetOf(text, "&value)", usize.ZERO),
      offsetOf(text, "&mut value, &value", usize.ZERO)),
    "a later run argument cannot borrow an owner an earlier one borrowed exclusively (BORROW-004, OWN0010)")
  run Testing.expect(rejectsRelated(&heldAcrossRun, RejectionCode.LoanConflict, offsetOf(text, "&mut value)", 1),
      offsetOf(text, "&value", 2)),
    "a run argument cannot borrow exclusively an owner a held shared loan still uses later (OWN0010)")
  run Testing.expect(rejectsRelated(&movedByRun, RejectionCode.UseAfterMove, offsetOf(text, "value.second", usize.ZERO),
      offsetOf(text, "move value", usize.ZERO)),
    "an operand a run moves is moved after the run (OWN0001)")
}

test effect fn effectValuesAreCheckedAsCallables() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run effectValueClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// Running an `effect fn` value's invocation invokes it (CALLABLE-002). Invoking it without `run`
// constructs an Effect that owns a `once fn` callee and holds a loan of any other, with the callee's
// own loans, until the Effect's last run or drop (EFF-001, EFFECT-OWN-001).
effect fn effectValueClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("effect-value.silk")
  let text = """
struct Token { value: i32 }
struct Narrow { first: i32 second: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn spend(token: Token) -> i32 { return token.value }
effect fn invoked() -> i32 {
  let mut count = 0
  let mut counting = effect fn(extra: i32) -> i32 {
    count = count + extra
    return count
  }
  let first = run counting(1)
  return first + run counting(2)
}
effect fn heldExclusive() -> i32 {
  let mut count = 0
  let mut counting = effect fn(extra: i32) -> i32 {
    count = count + extra
    return count
  }
  let pending = counting(1)
  let direct = run counting(2)
  drop pending
  return direct
}
effect fn heldShared() -> i32 {
  let mut held = Narrow {first: 1, second: 2}
  let shared = effect fn(extra: i32) -> i32 { return held.first + extra }
  let pending = shared(1)
  held = Narrow {first: 3, second: 4}
  drop pending
  return held.second
}
effect fn ownedOnce(token: Token) -> i32 {
  let consumed = effect fn(extra: i32) -> i32 { return spend(move token) + extra }
  let first = consumed(1)
  let second = consumed(2)
  drop first
  drop second
  return 0
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let invoked = run Semantic.demandBody(&mut store, &mut request, &id, b"invoked")
  let heldExclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"heldExclusive")
  let heldShared = run Semantic.demandBody(&mut store, &mut request, &id, b"heldShared")
  let ownedOnce = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedOnce")
  run Testing.expect(loansProved(&invoked),
    "running an exclusive effect fn value twice in sequence is proved, leaving only regions")
  run Testing.expect(rejectsRelated(&heldExclusive, RejectionCode.LoanConflict, offsetOf(text, "counting(2)", 1),
      offsetOf(text, "counting(1)", 1)),
    "invoking an exclusive effect fn value while an Effect constructed from it is still live is OWN0010")
  run Testing.expect(rejectsRelated(&heldShared, RejectionCode.AccessDuringLoan, offsetOf(text, "held = Narrow", 1),
      offsetOf(text, "held.first", usize.ZERO)),
    "replacing a value a constructed Effect reaches through its callee's capture is OWN0011")
  run Testing.expect(rejectsSpan(&ownedOnce, RejectionCode.UseAfterMove, text, "consumed", 2),
    "a constructed Effect owns a once fn callee, so constructing another from it is OWN0001")
}

test effect fn storedRunsAreCheckedAsInvocations() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run storedRunClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// A run of a stored Effect invokes it with the access its contract grants, so the loans its
// environment holds stay live until its last run (EFFECT-OWN-001, EFFECT-OWN-002).
effect fn storedRunClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("stored-run.silk")
  let text = """
struct Narrow { first: i32 second: i32 }
effect fn peek(value: &i32) -> i32 { return value.* }
effect fn bump(value: &mut i32) -> i32 {
  value.* = value.* + 1
  return value.*
}
effect fn take(value: Narrow) -> i32 { return value.first }
effect fn ranFirst() -> i32 {
  let mut value = 1
  let pending = peek(&value)
  let seen = run pending
  value = 2
  return seen + value
}
effect fn heldUntilRun() -> i32 {
  let mut value = 1
  let pending = peek(&value)
  value = 2
  return run pending
}
effect fn exclusiveRuns() -> i32 {
  let mut value = 1
  let mut pending = bump(&mut value)
  let first = run pending
  return first + run pending
}
effect fn readDuringExclusive() -> i32 {
  let mut value = 1
  let mut pending = bump(&mut value)
  let seen = value
  return seen + run pending
}
effect fn onceTwice(value: Narrow) -> i32 {
  let pending = take(move value)
  let first = run pending
  return first + run pending
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let ranFirst = run Semantic.demandBody(&mut store, &mut request, &id, b"ranFirst")
  let heldUntilRun = run Semantic.demandBody(&mut store, &mut request, &id, b"heldUntilRun")
  let exclusiveRuns = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusiveRuns")
  let readDuringExclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"readDuringExclusive")
  let onceTwice = run Semantic.demandBody(&mut store, &mut request, &id, b"onceTwice")
  run Testing.expect(loansProved(&ranFirst) && loansProved(&exclusiveRuns),
    "a loan an Effect holds ends at its last run, and a mut Effect runs repeatedly in sequence")
  run Testing.expect(rejectsRelated(&heldUntilRun, RejectionCode.AccessDuringLoan, offsetOf(text, "value = 2", 1),
      offsetOf(text, "&value", 1)),
    "writing a root while a stored Effect that borrows it may still run is OWN0011")
  run Testing.expect(rejectsRelated(&readDuringExclusive, RejectionCode.AccessDuringLoan, offsetOf(text, "seen = value", usize.ZERO) + 7,
      offsetOf(text, "&mut value", 1)),
    "reading a root a stored Effect borrows exclusively before its run is OWN0011")
  run Testing.expect(rejectsRelated(&onceTwice, RejectionCode.UseAfterMove, offsetOf(text, "run pending", 6),
      offsetOf(text, "run pending", 5)),
    "a run consumes a once Effect, so a second run is a use after move (OWN0001)")
}

test effect fn callableInvocationsAreCheckedAsCalls() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run callableInvocationClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn callableInvocationClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("callable-invocation.silk")
  let text = """
fn sharedInvoke(apply: fn<'static>(i32) -> i32) -> i32 {
  let mut value = 1
  let view = &mut value
  view.* = apply(2)
  return value
}
fn pipedInvoke(apply: fn<'static>(i32) -> i32) -> i32 {
  let mut value = 1
  let view = &mut value
  view.* = 2 |> apply
  return value
}
fn mutInvoke(mut step: mut fn<'static>() -> i32) -> i32 {
  let first = step()
  return first + step()
}
fn onceTwice(produce: once fn<'static>() -> i32) -> i32 {
  let first = produce()
  return first + produce()
}
fn mutDuringLoan(mut tick: mut fn<'static>() -> i32) -> i32 {
  let held = &tick
  let ticked = tick()
  let again = held
  return ticked
}
fn readDuringLoan(mut read: fn<'static>() -> i32) -> i32 {
  let held = &mut read
  let value = read()
  let again = move held
  return value
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let shared = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedInvoke")
  let piped = run Semantic.demandBody(&mut store, &mut request, &id, b"pipedInvoke")
  let stepped = run Semantic.demandBody(&mut store, &mut request, &id, b"mutInvoke")
  let twice = run Semantic.demandBody(&mut store, &mut request, &id, b"onceTwice")
  let ticked = run Semantic.demandBody(&mut store, &mut request, &id, b"mutDuringLoan")
  let read = run Semantic.demandBody(&mut store, &mut request, &id, b"readDuringLoan")
  run Testing.expect(loansProved(&shared) && loansProved(&piped)
    && loansProved(&stepped),
    "invoking a shared, piped or repeatable mutable callable is checked as a call, leaving only regions")
  run Testing.expect(rejectsRelated(&twice, RejectionCode.UseAfterMove, offsetOf(text, "produce()", usize.ONE), offsetOf(text, "produce()", usize.ZERO)),
    "a once callable is consumed by its invocation, so a second invocation is OWN0001 related to the first (CALLABLE-002)")
  run Testing.expect(rejectsRelated(&ticked, RejectionCode.LoanConflict, offsetOf(text, "tick()", usize.ZERO), offsetOf(text, "&tick", usize.ZERO)),
    "a mutable invocation borrows its callee exclusively, so a live shared loan of it conflicts (OWN0010)")
  run Testing.expect(rejectsRelated(&read, RejectionCode.AccessDuringLoan, offsetOf(text, "read()", usize.ZERO), offsetOf(text, "&mut read", usize.ZERO)),
    "a shared invocation reads its callee, so a live exclusive loan of it rejects the read (OWN0011)")
}

test effect fn callableConstructionRetainsCaptureLoans() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run callableConstructionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn callableConstructionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("callable-construction.silk")
  let text = """
struct Token { value: i32 }
fn read(value: i32, token: &mut Token) -> i32 { return value + token.value }
fn consume(value: i32, token: Token) -> i32 { return value + token.value }
fn sectionBlocked() -> i32 {
  let mut values = Token {value: 1}
  let mut callback = read(&mut values)
  values.value = 2
  return callback(42)
}
fn sectionDropped() -> i32 {
  let mut values = Token {value: 1}
  let mut callback = read(&mut values)
  drop callback
  values.value = 2
  return values.value
}
fn sectionLastUse() -> i32 {
  let mut values = Token {value: 1}
  let mut callback = read(&mut values)
  let result = callback(41)
  values.value = 1
  return result
}
fn sectionMoved() -> i32 {
  let token = Token {value: 1}
  let callback = consume(move token)
  return callback(20) + token.value
}
fn anonymousBlocked() -> i32 {
  let mut held = Token {value: 1}
  let inspect = fn() -> i32 { return held.value }
  held = Token {value: 2}
  return inspect()
}
fn anonymousReleased() -> i32 {
  let mut held = Token {value: 1}
  let inspect = fn() -> i32 { return held.value }
  let seen = inspect()
  held = Token {value: 2}
  return seen + held.value
}
fn anonymousInside() -> i32 {
  let mut count = 1
  let bump = fn() -> i32 {
    let view = &mut count
    let other = &count
    view.* = 2
    return other.*
  }
  return bump()
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let blocked = run Semantic.demandBody(&mut store, &mut request, &id, b"sectionBlocked")
  let dropped = run Semantic.demandBody(&mut store, &mut request, &id, b"sectionDropped")
  let lastUse = run Semantic.demandBody(&mut store, &mut request, &id, b"sectionLastUse")
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"sectionMoved")
  let anonymous = run Semantic.demandBody(&mut store, &mut request, &id, b"anonymousBlocked")
  let released = run Semantic.demandBody(&mut store, &mut request, &id, b"anonymousReleased")
  let inside = run Semantic.demandBody(&mut store, &mut request, &id, b"anonymousInside")
  run Testing.expect(rejectsRelated(&blocked, RejectionCode.AccessDuringLoan, offsetOf(text, "values.value = 2", usize.ZERO),
    offsetOf(text, "&mut values", usize.ZERO)),
    "a section retains its exclusive capture loan while it can still be invoked (CALLABLE-003, OWN0011)")
  run Testing.expect(loansProved(&dropped) && loansProved(&lastUse),
    "dropping the section or its last invocation ends the capture loan")
  run Testing.expect(rejectsRelated(&moved, RejectionCode.UseAfterMove, offsetOf(text, "token.value", 2), offsetOf(text, "move token", usize.ZERO)),
    "a moved capture leaves its place at construction, so a later read is OWN0001 (CAPTURE-001)")
  run Testing.expect(rejectsFrom(&anonymous, RejectionCode.AccessDuringLoan, offsetOf(text, "held = Token {value: 2}", usize.ZERO)),
    "an anonymous function's borrowed capture keeps its root restricted while the function can be invoked")
  run Testing.expect(loansProved(&released),
    "the anonymous capture loan ends at the function's last invocation")
  run Testing.expect(rejectsRelated(&inside, RejectionCode.LoanConflict, offsetOf(text, "&count", usize.ZERO), offsetOf(text, "&mut count", usize.ZERO)),
    "an anonymous body is borrow-checked where it is built, so its own conflicting loans are OWN0010")
}

// The bootstrap's callable ownership programs (Ownership.test.ts, StoredCallableOwnership.test.ts):
// each body is rejected exactly when the bootstrap rejects it. Its two Copy-realization programs are
// left out: native typing does not yet infer `'env` in their generic `Copy` impls.
test effect fn callableOwnershipMatchesTheBootstrap() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run callableParityClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn callableParityClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("callable-parity.silk")
  let text = """
struct Token { value: i32 }
fn takeValue(value: i32, token: Token) -> i32 { return value }
fn takeReuse() -> i32 {
  let token = Token { value: 1 }
  let callback = takeValue(move token)
  let first = callback(20)
  let second = callback(22)
  return first + second
}
fn readSlot(value: i32, values: &mut [i32]) -> i32 { return value }
fn borrowedCallable() -> i32 {
  let mut values = [1]
  let callback = readSlot(&mut values)
  values[0] = 2
  return callback(42)
}
fn droppedBorrowedCallable() -> i32 {
  let mut values = [1]
  let callback = readSlot(&mut values)
  drop callback
  values[0] = 2
  return values[0]
}
fn consumeToken(token: Token, adjustment: i32) -> i32 { return token.value + adjustment }
fn affinePipeline() -> i32 {
  let token = Token { value: 40 }
  let result = move token |> consumeToken(2)
  drop token
  return result
}
struct Parser<'env, F: fn<'env>(i32) -> i32> { parse: F }
struct Stepper<'env, F: mut fn<'env>(i32) -> i32> { step: F }
struct Once<'env, F: once fn<'env>(i32) -> i32> { step: F }
struct Boxed<'env, F: once fn<'env>(i32) -> i32> { inner: Once<'env, F> }
fn parseTwice<'env, F: fn<'env>(i32) -> i32>(parser: &Parser<'env, F>) -> i32 {
  return parser.parse(1) + parser.parse(2)
}
fn takeThroughShared<'env, F: once fn<'env>(i32) -> i32>(value: &Once<'env, F>) -> i32 { return value.step(1) }
fn exclusiveThroughShared<'env, F: mut fn<'env>(i32) -> i32>(stepper: &Stepper<'env, F>) -> i32 { return stepper.step(1) }
fn exclusiveThroughExclusive<'env, F: mut fn<'env>(i32) -> i32>(stepper: &mut Stepper<'env, F>) -> i32 { return stepper.step(1) }
fn consumeTwice<'env, F: once fn<'env>(i32) -> i32>(value: Once<'env, F>) -> i32 {
  let first = value.step(1)
  let second = value.step(2)
  return first + second
}
fn consumeOnce<'env, F: once fn<'env>(i32) -> i32>(value: Once<'env, F>) -> i32 { return value.step(1) }
fn nestedShared<'env, F: once fn<'env>(i32) -> i32>(value: &Boxed<'env, F>) -> i32 { return value.inner.step(1) }
fn nestedOwned<'env, F: once fn<'env>(i32) -> i32>(value: Boxed<'env, F>) -> i32 { return value.inner.step(1) }
fn directOnce(step: once fn(i32) -> i32) -> i32 {
  let first = step(1)
  let second = step(2)
  return first + second
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let takeReuse = run Semantic.demandBody(&mut store, &mut request, &id, b"takeReuse")
  let borrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowedCallable")
  let dropped = run Semantic.demandBody(&mut store, &mut request, &id, b"droppedBorrowedCallable")
  let pipeline = run Semantic.demandBody(&mut store, &mut request, &id, b"affinePipeline")
  let parseTwice = run Semantic.demandBody(&mut store, &mut request, &id, b"parseTwice")
  let takeShared = run Semantic.demandBody(&mut store, &mut request, &id, b"takeThroughShared")
  let exclusiveShared = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusiveThroughShared")
  let exclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusiveThroughExclusive")
  let consumeTwice = run Semantic.demandBody(&mut store, &mut request, &id, b"consumeTwice")
  let consumeOnce = run Semantic.demandBody(&mut store, &mut request, &id, b"consumeOnce")
  let nestedShared = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedShared")
  let nestedOwned = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedOwned")
  let directOnce = run Semantic.demandBody(&mut store, &mut request, &id, b"directOnce")
  run Testing.expect(rejectsWith(&takeReuse, RejectionCode.UseAfterMove) && rejectsWith(&pipeline, RejectionCode.UseAfterMove)
    && rejectsWith(&consumeTwice, RejectionCode.UseAfterMove) && rejectsWith(&directOnce, RejectionCode.UseAfterMove),
    "every bootstrap OWN0001 callable program is a native use after move")
  run Testing.expect(!succeeded(&borrowed) && !succeeded(&takeShared) && !succeeded(&exclusiveShared) && !succeeded(&nestedShared),
    "every other program the bootstrap rejects is rejected natively")
  run Testing.expect(succeeded(&dropped) && succeeded(&parseTwice) && succeeded(&exclusive) && succeeded(&consumeOnce)
    && succeeded(&nestedOwned),
    "every program the bootstrap accepts is accepted natively")
}

test effect fn returnedViewsKeepTheirSourceLoans() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
