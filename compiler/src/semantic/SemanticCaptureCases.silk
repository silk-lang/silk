fn firstAnonymousBody(body: &TypedBody) -> Option<Shared<TypedBody>> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Callable {body: child, ..}, ..} = &nodes[at].kind {
      return Option<Shared<TypedBody>>.some(Shared<TypedBody>.clone(&child))
    }
    at = at + usize.ONE
  }
  return Option<Shared<TypedBody>>.none()
}

fn checkedAnonymousBody(answer: &Result<Answer, NoRejection>) -> Option<Shared<TypedBody>> {
  let checked = checkedBody(answer)
  if let Option<Shared<TypedBody>>.Some {value} = move checked {
    return Shared<TypedBody>.with<Option<Shared<TypedBody>>>(&value, firstAnonymousBody)
  }
  return Option<Shared<TypedBody>>.none()
}

fn consumedFieldStep(step: &BodyPlaceStep, field: usize) -> bool {
  return match &step.* { BodyPlaceStep.Field {index} => index == field _ => false }
}

fn consumedEnvironmentField(consumed: &Option<BodyConsumedPlace>, field: usize) -> bool {
  if let Option<BodyConsumedPlace>.Some {value} = &consumed.* {
    if let BodyPlaceRoot.Local {local} = &value.root {
      let steps = Vector<BodyPlaceStep>.asSlice(&value.steps)
      if local.index == usize.ZERO && steps.length == usize.ONE {
        return consumedFieldStep(&steps[0], field)
      }
    }
  }
  return false
}

fn anonymousConsumedFields(body: &TypedBody) -> bool {
  if TypedBody.localSlice(body).length != usize.ONE { return false }
  let nodes = TypedBody.nodeSlice(body)
  let mut dropped = false
  let mut moved = false
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Drop {consumed, ..} = &nodes[at].kind { dropped = consumedEnvironmentField(&consumed, usize.ZERO) }
    if let BodyNodeKind.Expression {form: BodyExpression.Move {consumed, ..}, ..} = &nodes[at].kind { moved = consumedEnvironmentField(&consumed, usize.ONE) }
    at = at + usize.ONE
  }
  return dropped && moved
}

test effect fn anonymousConsumedCapturesBelongToEnvironmentOwner() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run anonymousConsumedFieldClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn anonymousConsumedFieldClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("consumed-environment.silk")
  let text = """
struct Token { value: i32 }
fn proof(first: Token, second: Token) -> () {
  let closure = fn() -> Token { drop first return move second }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandBody(&mut store, &mut request, &id, b"proof")
  let anonymous = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&answer, checkedAnonymousBody)
  let mut remapped = false
  if let Option<Shared<TypedBody>>.Some {value} = move anonymous {
    remapped = Shared<TypedBody>.with<bool>(&value, anonymousConsumedFields)
  }
  run Testing.expect(remapped, "both capture consumptions name environment zero and its exact fields, with no lexical ghost locals")
}

fn sectionSnapshot(statements: &[MirStatement], locals: &[MirLocal]) -> usize {
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Assign {destination, value: MirRvalue.Use {value: MirOperand.Copy {place}}, ..} = &statements[at] {
      if Vector<MirProjection>.length(&place.projections) == usize.ZERO
        && Vector<MirProjection>.length(&destination.projections) == usize.ZERO {
        if Shared<Type>.with<bool>(&locals[destination.local].ty, fn(value: &Type) -> bool {
          return match &value.* { Type.CallableValue {..} => true _ => false }
        }) { return destination.local }
      }
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn sectionFieldFrom(operand: &MirOperand, field: usize, snapshot: usize) -> bool {
  if let MirOperand.Copy {place} = &operand.* {
    return place.local == snapshot && sectionStoredField(operand, field)
  }
  return false
}

fn namedSectionArguments(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut snapshot = usize.MAX
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          let named = Shared<DeclarationId>.with<bool>(&identity,
            fn(declaration: &DeclarationId) -> bool { return DeclarationId.named(declaration, b"combine") })
          let written = Shared<DeclarationId>.with<bool>(&identity,
            fn(declaration: &DeclarationId) -> bool { return DeclarationId.named(declaration, b"written") })
          if written { snapshot = sectionSnapshot(Vector<MirStatement>.asSlice(&blocks[at].statements), Vector<MirLocal>.asSlice(&function.locals)) }
          let operands = Vector<MirOperand>.asSlice(&arguments)
          if named && operands.length == 3 && snapshot != usize.MAX {
            if let MirOperand.Copy {place} = &operands[usize.ZERO] {
              return Vector<MirProjection>.length(&place.projections) == usize.ZERO
                && sectionFieldFrom(&operands[usize.ONE], usize.ZERO, snapshot)
                && sectionFieldFrom(&operands[2], usize.ONE, snapshot)
            }
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

test effect fn namedSectionsAppendStoredArgumentsDirectly() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run namedSectionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn namedSectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("named-section.silk")
  let text = """
fn combine(first: i32, second: i32, third: i32) -> i32 { return first * 100 + second * 10 + third }
fn written() -> i32 { return 2 }
fn main() -> i32 { let section = combine(4, 3) return section(written()) }
unsafe extern "C" fn foreignProbe(left: i32, right: i32) -> i32
fn invalidForeignSection() -> () { let invalid = foreignProbe(40) }
fn select<T>(first: T, last: i32) -> T { return move first }
fn deferredSection() -> () { let unapplied = select(3) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let foreign = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidForeignSection")
  let deferred = run Semantic.demandBody(&mut store, &mut request, &id, b"deferredSection")
  run Testing.expect(succeeded(&answer) && namedSectionArguments(&store, &answer),
    "a section snapshots its fields before written arguments and appends them to its original direct target")
  run Testing.expect(rejectsSpan(&foreign, RejectionCode.ForeignFunctionNotFirstClass,
    text, "foreignProbe(40)", usize.ZERO), "foreign functions reject sections at construction (SEM0189)")
  run Testing.expect(succeeded(&deferred),
    "a section may retain its leading generic binder for later invocation without selecting a runtime instance")
}

test effect fn namedMutableSectionsRetainExclusiveReferents() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run mutableSectionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn mutableSectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("mutable-section.silk")
  let text = """
fn edit(amount: i32, counter: &mut i32) -> i32 { counter.* = counter.* + amount return counter.* }
fn main() -> i32 {
  let mut counter = 0
  let mut editStep = edit(&mut counter)
  let first = editStep(1)
  return first + editStep(2)
}
fn immutableUse() -> i32 { let mut counter = 0 let readOnlyStep = edit(&mut counter) return readOnlyStep(1) }
fn movedExclusive<'a>(value: &'a mut i32) -> i32 { let ownedStep = edit(move value) return ownedStep(1) }
fn repeatedExclusive<'a>(value: &'a mut i32) -> i32 {
  let movedStep = edit(move value)
  let first = movedStep(1)
  return first + movedStep(2)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let rejected = run Semantic.demandBody(&mut store, &mut request, &id, b"immutableUse")
  let owned = run Semantic.demandMir(&mut store, &mut request, &id, b"movedExclusive")
  let repeated = run Semantic.demandBody(&mut store, &mut request, &id, b"repeatedExclusive")
  run Testing.expect(succeeded(&answer) && sectionInvocationCount(&store, &answer, b"edit", false) == 2,
    "mutable sections repeatedly pass their stored exclusive descriptor to the original target")
  run Testing.expect(rejectsSpan(&rejected, RejectionCode.InvalidCallableInvocationAccess,
    text, "readOnlyStep", usize.ONE), "a mutable section requires a writable callable binding (SEM0077)")
  run Testing.expect(succeeded(&owned) && sectionInvocationCount(&store, &owned, b"edit", true) == usize.ONE,
    "moving an exclusive view makes its section once and permits an immutable callable binding")
  run Testing.expect(rejectsSpan(&repeated, RejectionCode.UseAfterMove, text, "movedStep", 2),
    "a second invocation of a moved-exclusive section rejects its consumed callee (OWN0001)")
}

