fn keepSharedView<'a>(value: &'a mut i32) -> &'a i32 { return &value.* }
fn sharedConflict() -> never { return sharedConflict() }
fn viewAcrossSharedAccess<'a>(core: &'a Intrinsic.SharedCore<i32>) -> i32 {
  let view = Intrinsic.sharedWithMut<i32, &'a i32>(core, keepSharedView, sharedConflict)
