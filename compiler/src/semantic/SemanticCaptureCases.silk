    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn copiedSharedProjectionClaims() -> ()
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let id = run module("copied-shared-projections.silk")
  let text = """
struct Counter { value: i32 }
struct Outer { inner: Counter }
fn inc(value: &mut i32) -> () { value.* = value.* + 1 }
fn bump(counter: &mut Counter) -> () { counter.value = counter.value + 1 }
fn field(counter: &Counter) -> () {
  let mut held = counter
  inc(&mut held.value)
}
fn element(counters: &[Counter]) -> () {
  let mut held = counters
  bump(&mut held[0])
}
fn elementField(counters: &[Counter]) -> () {
  let mut held = counters
  inc(&mut held[0].value)
}
fn nested(outer: &Outer) -> () {
  let mut held = outer
  inc(&mut held.inner.value)
}
fn immutable() -> () {
  let fixed = Counter { value: 0 }
  inc(&mut fixed.value)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let field = run Semantic.demandBody(&mut store, &mut request, &id, b"field")
  let element = run Semantic.demandBody(&mut store, &mut request, &id, b"element")
  let elementField = run Semantic.demandBody(&mut store, &mut request, &id, b"elementField")
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested")
  let immutable = run Semantic.demandBody(&mut store, &mut request, &id, b"immutable")
  run Testing.expect(
    rejectsSpan(&field, RejectionCode.InvalidReborrow, text, "&mut held.value", usize.ZERO),
    "copying a shared reference into a mutable binding cannot strengthen a field borrow (BORROW-005, SEM0058)"
  )
  run Testing.expect(
    rejectsSpan(&element, RejectionCode.InvalidReborrow, text, "&mut held[0]", usize.ZERO),
    "copying a shared slice into a mutable binding cannot strengthen an element borrow (BORROW-005, SEM0058)"
  )
  run Testing.expect(
    rejectsSpan(
      &elementField,
      RejectionCode.InvalidReborrow,
      text,
      "&mut held[0].value",
      usize.ZERO
    ),
    "a field projected from a shared slice element keeps shared access (BORROW-005, SEM0058)"
  )
  run Testing.expect(
    rejectsSpan(&nested, RejectionCode.InvalidReborrow, text, "&mut held.inner.value", usize.ZERO),
    "nested fields projected through a copied shared reference keep shared access (BORROW-005, SEM0058)"
  )
  run Testing.expect(
    rejectsSpan(
      &immutable,
      RejectionCode.ExclusiveBorrowRequiresMutable,
      text,
      "fixed.value",
      usize.ZERO
    ),
    "an immutable owned binding still requires mut for an exclusive borrow (BORROW-006, SEM0057)"
  )
}

test effect fn affinePlacesTakenByValueSayMove() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run explicitMoveClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn explicitMoveClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("explicit-moves.silk")
  let text = """
pub struct Token { pub value: i32 }
struct Pair {
  left: Token
  right: Token
}
union Held { Empty, One { kept: Token } }
impl Token {
  pub fn finish(self: Token) -> i32 { return self.value }
}
fn consume(token: Token) -> i32 { return token.value }
fn make() -> Token { return Token { value: 1 } }
fn argument(argued: Token) -> i32 { return consume(argued) }
fn returned(given: Token) -> Token { return given }
fn bound(initial: Token) -> i32 {
  let other = initial
  return other.value
}
fn assigned(source: Token) -> i32 {
  let mut target = make()
  target = source
  return target.value
}
fn field(fielded: Token) -> i32 {
  let pair = Pair { left: fielded, right: make() }
  return pair.left.value
}
fn element(listed: Token) -> i32 {
  let all = [listed, make()]
  return all[0].value
}
fn variant(wrapped: Token) -> i32 {
  let held = Held.One { kept: wrapped }
  return 0
}
fn projected(whole: Pair) -> i32 {
  let part = whole.left
  return part.value
}
fn generic<T>(item: T) -> T { return item }
fn edit(values: &mut [i32]) -> i32 { return values[0] }
fn bump(token: &mut Token) -> i32 { return token.value }
fn forwardedSlice(views: &mut [i32]) -> i32 { return edit(views) }
fn forwardedReference(cell: &mut Token) -> i32 { return bump(cell) }
fn reborrowed(views: &mut [i32], cell: &mut Token) -> i32 { return edit(&mut views) + bump(&mut cell) }
fn raise(by: i32, total: &mut i32) -> i32 {
  total.* = total.* + by
  return total.*
}
fn staging(tally: &mut i32) -> i32 {
  let mut next = raise(tally)
  return next(1)
}
fn lending(count: &mut i32) -> i32 {
  let mut next = raise(&mut count)
  return next(1)
}
fn armed(held: Held) -> Token {
  return match move held {
    Held.One {kept: chosen} => chosen
    _ => make()
  }
}
fn accepted(token: Token, pair: Pair) -> i32 {
  let kind = token.value + pair.left.value
  let pair2 = Pair { left: move token, right: make() }
  return kind + consume(move pair2.left) + pair.right.value + make().finish()
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let argument = run Semantic.demandBody(&mut store, &mut request, &id, b"argument")
  let returned = run Semantic.demandBody(&mut store, &mut request, &id, b"returned")
  let bound = run Semantic.demandBody(&mut store, &mut request, &id, b"bound")
  let assigned = run Semantic.demandBody(&mut store, &mut request, &id, b"assigned")
  let field = run Semantic.demandBody(&mut store, &mut request, &id, b"field")
  let element = run Semantic.demandBody(&mut store, &mut request, &id, b"element")
  let variant = run Semantic.demandBody(&mut store, &mut request, &id, b"variant")
  let projected = run Semantic.demandBody(&mut store, &mut request, &id, b"projected")
  let generic = run Semantic.demandBody(&mut store, &mut request, &id, b"generic")
  let armed = run Semantic.demandBody(&mut store, &mut request, &id, b"armed")
  let forwardedSlice = run Semantic.demandBody(&mut store, &mut request, &id, b"forwardedSlice")
  let forwardedReference = run Semantic.demandBody(&mut store, &mut request, &id, b"forwardedReference")
  let reborrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrowed")
  let staging = run Semantic.demandBody(&mut store, &mut request, &id, b"staging")
  let lending = run Semantic.demandBody(&mut store, &mut request, &id, b"lending")
  let accepted = run Semantic.demandBody(&mut store, &mut request, &id, b"accepted")
  run Testing.expect(rejectsSpan(&argument, RejectionCode.ExplicitMoveRequired, text, "argued", usize.ONE)
    && rejectsSpan(&returned, RejectionCode.ExplicitMoveRequired, text, "given", usize.ONE)
    && rejectsSpan(&bound, RejectionCode.ExplicitMoveRequired, text, "initial", usize.ONE),
    "an affine argument, return or binding initializer without move is OWN0003 at the operand")
  run Testing.expect(rejectsSpan(&assigned, RejectionCode.ExplicitMoveRequired, text, "source", usize.ONE)
    && rejectsSpan(&field, RejectionCode.ExplicitMoveRequired, text, "fielded", usize.ONE)
    && rejectsSpan(&element, RejectionCode.ExplicitMoveRequired, text, "listed", usize.ONE),
    "an assigned value, a struct field and an array element taken by value must say move")
  run Testing.expect(rejectsSpan(&variant, RejectionCode.ExplicitMoveRequired, text, "wrapped", usize.ONE)
    && rejectsSpan(&projected, RejectionCode.ExplicitMoveRequired, text, "whole.left", usize.ZERO)
    && rejectsSpan(&generic, RejectionCode.ExplicitMoveRequired, text, "item", usize.ONE),
    "a variant field, an affine field projection and an unconstrained type parameter must say move (GENERIC-001)")
  run Testing.expect(rejectsSpan(&armed, RejectionCode.ExplicitMoveRequired, text, "chosen", usize.ONE),
    "an expression match arm yields its affine binding by value, so it must say move")
  run Testing.expect(rejectsSpan(&forwardedSlice, RejectionCode.ExplicitMoveRequired, text, "views", usize.ONE)
    && rejectsSpan(&forwardedReference, RejectionCode.ExplicitMoveRequired, text, "cell", usize.ONE)
    && succeeded(&reborrowed),
    "an exclusive slice or reference forwarded by value is OWN0003; forwarding is written &mut values (BORROW-005)")
  run Testing.expect(rejectsSpan(&staging, RejectionCode.ExplicitMoveRequired, text, "tally", usize.ONE) && succeeded(&lending),
    "a staged argument is captured by value, so staging an exclusive view is OWN0003 unless written &mut (CALLABLE-002)")
  run Testing.expect(succeeded(&accepted),
    "Copy leaf reads, explicit moves and a by-value method receiver need no move")
}

