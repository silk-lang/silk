effect fn wrap<'env, A, ?R>(inner: once Effect<'env; A ? R>) -> A ? R { return run move inner }
effect fn tagged(static tag: string<'static>, value: i32) -> i32 { return value }
pub fn wrapped() -> i32 { return run wrap(tagged("s", 7)) }
"""
