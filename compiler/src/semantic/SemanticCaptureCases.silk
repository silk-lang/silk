effect fn receiverContentsClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("receiver-contents.silk")
  let text = """
struct Token { value: i32 }
struct Shelf<'a> { inner: &'a Token }
impl<'a> Shelf<'a> {
  fn view<'b>(self: &'b Shelf<'a>) -> &'b Token { return self.inner }
  fn label(self: &Shelf<'a>) -> string<'static> { return "shelf" }
}
fn written() -> i32 {
  let mut held = Token {value: 1}
  let shelf = Shelf {inner: &held}
  let view = shelf.view()
  held = Token {value: 2}
  return view.value
}
fn moved() -> i32 {
  let held = Token {value: 1}
  let shelf = Shelf {inner: &held}
  let view = shelf.view()
  let taken = move held
  return view.value + taken.value
}
fn released() -> i32 {
  let mut held = Token {value: 1}
  let shelf = Shelf {inner: &held}
  let view = shelf.view()
  let seen = view.value
  held = Token {value: 3}
  return seen + held.value
}
fn unrelated() -> string<'static> {
  let mut held = Token {value: 1}
  let shelf = Shelf {inner: &held}
  let result = shelf.label()
  held = Token {value: 4}
  return result
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"written")
  run Testing.expect(rejectsSpan(&written, RejectionCode.AccessDuringLoan, text, "held", 2),
    "an implicit receiver's result retains the stored referent and rejects its conflicting write")
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"moved")
  run Testing.expect(rejectsSpan(&moved, RejectionCode.AccessDuringLoan, text, "held", 5),
    "the same receiver contract prevents moving the stored referent before its last use")
  let released = run Semantic.demandBody(&mut store, &mut request, &id, b"released")
  run Testing.expect(hasBorrowStatus(&released, BodyBorrowStatus.Checked),
    "the implicit receiver's source loan still ends after the result's last use")
  let unrelated = run Semantic.demandBody(&mut store, &mut request, &id, b"unrelated")
  run Testing.expect(hasBorrowStatus(&unrelated, BodyBorrowStatus.Checked),
    "an unrelated static result does not retain the receiver's stored referent")
  return ()
}

test effect fn argumentIntervalsExcludeAbandonedReturnPaths() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run argumentIntervalClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn argumentIntervalClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("argument-interval-paths.silk")
  let text = """
struct Token { value: i32 }
fn readAfter<'a: 'b, 'b>(left: &'a Token, right: &'b Token) -> i32 { return left.value }
fn readAfterWrite<'a: 'b, 'b>(left: &'a Token, ready: (), right: &'b Token) -> i32 { return left.value }
fn earlyReturn<'input>(input: &'input Token, stop: bool) -> i32 {
  let source = Token {value: 1}
  let held = &source
  return readAfter(held, match stop {
    _ if stop => { return 0 }
    _ => &input.*
  })
}
fn writeThenUse<'input>(input: &'input Token, change: bool) -> i32 {
  let mut source = Token {value: 1}
  let held = &source
  return readAfterWrite(held, match change {
    _ if change => { source = Token {value: 2} }
    _ => ()
  }, &input.*)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let early = run Semantic.demandBody(&mut store, &mut request, &id, b"earlyReturn")
  run Testing.expect(hasBorrowStatus(&early, BodyBorrowStatus.Checked),
    "an abandoned call does not require its first operand's loan after the early return cleans its owner")
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"writeThenUse")
  run Testing.expect(rejectsSpan(&written, RejectionCode.AccessDuringLoan, text, "source", 4),
    "a branch reaching the call still rejects a conflicting write before the first operand's consumption")
  return ()
}


test effect fn initializedStorageCoversEarlierCallArguments() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run initializedStorageClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn initializedStorageClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("initialized-storage.silk")
  let text = """
struct Token { value: i32 }
fn view<'a>(value: &'a Token) -> &'a Token { return value }
fn combine<'a, 'b: 'a>(left: &'a Token, right: &'b Token) -> i32 {
  return left.value + right.value
}
fn earlierArgument() -> i32 {
  let left = Token {value: 1}
  let right = Token {value: 2}
  return combine(&left, view(&right))
}
fn expired(flag: bool) -> i32 {
  let left = Token {value: 1}
  let mut held = &left
  if flag {
    let right = Token {value: 2}
    held = view(&right)
  }
  return combine(&left, held)
}
fn writeThenUse() -> i32 {
  let left = Token {value: 1}
  let mut right = Token {value: 2}
  let held = view(&right)
  right = Token {value: 3}
  return combine(&left, held)
}
fn escape<'a>() -> &'a Token {
  let local = Token {value: 1}
  return view(&local)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let earlier = run Semantic.demandBody(&mut store, &mut request, &id, b"earlierArgument")
  run Testing.expect(hasBorrowStatus(&earlier, BodyBorrowStatus.Checked),
    "an owned value initialized before argument evaluation covers the earlier argument's finite use")
  let expired = run Semantic.demandBody(&mut store, &mut request, &id, b"expired")
  run Testing.expect(rejectsSpan(&expired, RejectionCode.ExpiredLifetime, text, "held", 2),
    "storage initialization never permits a view after its inner owner has ended")
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"writeThenUse")
  run Testing.expect(rejectsSpan(&written, RejectionCode.AccessDuringLoan, text, "right", 8),
    "a real write while the view is live still rejects OWN0011")
  let escaped = run Semantic.demandBody(&mut store, &mut request, &id, b"escape")
  run Testing.expect(hasBorrowStatus(&escaped, BodyBorrowStatus.Regions),
    "finite initialized storage cannot justify an outward caller lifetime")
  return ()
}


test effect fn localMeetSourcesCoverConsumption() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
