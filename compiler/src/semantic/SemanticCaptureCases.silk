effect fn d8<'k>(src: &'k mut Box1) -> () ? &KeeperS<'k> {
  let f = effect fn() -> () ? &KeeperS<'k> { run KeeperS<'k>.put(&src.t) }
  run f()
  src.t = Token { value: 9 }
  return ()
}
effect fn blockBlock<'b>(seed: &'b Token) -> () ? &mut Keeper<'b> {
  let e = effect {
    let inner = effect {
      run Keeper<'b>.put(seed)
    }
    run inner
  }
  run e
  return ()
}
effect fn blockBlockBlock<'b>(seed: &'b Token) -> () ? &mut Keeper<'b> {
  let e = effect {
    let middle = effect {
      let inner = effect {
        run Keeper<'b>.put(seed)
      }
      run inner
    }
    run middle
  }
  run e
  return ()
}
effect fn blockBlockLocal<'b>(seed: &'b Token) -> () ? &mut Keeper<'b> {
  let local = Token { value: 1 }
  let e = effect {
    let inner = effect {
      run Keeper<'b>.put(&local)
    }
    run inner
  }
  run e
  return ()
}
effect fn blockBlockUnchecked<'b>(seed: &'b Token) -> () ? &mut Keeper<'b> {
  let local = Token { value: 1 }
  let e = effect {
    let inner = effect {
      let uv = 1
      let mut us = HeldSlot {view: Maybe<&i32>.Some {value: &uv}}
      let uo = Intrinsic.replace(us.view, Maybe<&i32>.None)
      run Keeper<'b>.put(&local)
    }
    run inner
  }
  run e
  return ()
}
effect fn blockBlockTyped<T>() -> () {
  let e = effect {
    let inner = effect {
      let absent = Maybe<T>.None
      drop absent
    }
    run inner
  }
  run e
  return ()
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let stash = run Semantic.demandBody(&mut store, &mut request, &id, b"stash")
  let stashExclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"stashExclusive")
  let stashReturned = run Semantic.demandBody(&mut store, &mut request, &id, b"stashReturned")
  let stashJoined = run Semantic.demandBody(&mut store, &mut request, &id, b"stashJoined")
  let stashLooped = run Semantic.demandBody(&mut store, &mut request, &id, b"stashLooped")
  // Each body writes `src.t` once, after borrowing it once, so a body's write is the odd occurrence.
  run Testing.expect(rejectsSpan(&stash, RejectionCode.AccessDuringLoan, text, "src.t", 1),
    "a view typed at the parent's universal region outlives the body, so writing its place after the view escapes is OWN0011")
  run Testing.expect(rejectsSpan(&stashExclusive, RejectionCode.AccessDuringLoan, text, "src.t", 3),
    "an exclusive reborrow typed at the parent's universal region outlives the body (OWN0011)")
  run Testing.expect(rejectsSpan(&stashJoined, RejectionCode.AccessDuringLoan, text, "src.t", 7)
      && rejectsSpan(&stashLooped, RejectionCode.AccessDuringLoan, text, "src.t", 9),
    "a universal view that escapes through a join or a loop still outlives the body (OWN0011)")
  run Testing.expect(rejectsSpan(&stashReturned, RejectionCode.AccessDuringLoan, text, "src.t", 5),
    "a universal view that escapes through a returned reborrow still outlives the body (OWN0011)")
  // A call result naming only caller regions drops the reborrow it was given, but the reborrow's
  // written universal region still keeps the loan through the body, so a later write conflicts.
  let stashReturnedPair = run Semantic.demandBody(&mut store, &mut request, &id, b"stashReturnedPair")
  let stashReturnedInline = run Semantic.demandBody(&mut store, &mut request, &id, b"stashReturnedInline")
  let stashReturnedOther = run Semantic.demandBody(&mut store, &mut request, &id, b"stashReturnedOther")
  run Testing.expect(rejectsSpan(&stashReturnedPair, RejectionCode.AccessDuringLoan, text, "src.t", 73)
    && rejectsSpan(&stashReturnedInline, RejectionCode.AccessDuringLoan, text, "src.t", 75),
    "a returned reborrow stored past the body and then overwritten is a write during its loan (OWN0011)")
  run Testing.expect(hasBorrowStatus(&stashReturnedOther, BodyBorrowStatus.Checked),
    "a write to a disjoint field leaves a returned reborrow stored past the body proved")
  // The dropped loan may reborrow a local view: the view's own loan lives as long as the reborrow,
  // so a write or a second exclusive borrow after the drop conflicts with it too.
  let stashViewReborrow = run Semantic.demandBody(&mut store, &mut request, &id, b"stashViewReborrow")
  let stashViewExclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"stashViewExclusive")
  let stashViewKept = run Semantic.demandBody(&mut store, &mut request, &id, b"stashViewKept")
  let stashViewInferred = run Semantic.demandBody(&mut store, &mut request, &id, b"stashViewInferred")
  let stashViewWrapped = run Semantic.demandBody(&mut store, &mut request, &id, b"stashViewWrapped")
  let stashViewOther = run Semantic.demandBody(&mut store, &mut request, &id, b"stashViewOther")
  run Testing.expect(rejectsSpan(&stashViewReborrow, RejectionCode.AccessDuringLoan, text, "src.t", 78)
    && rejectsSpan(&stashViewKept, RejectionCode.AccessDuringLoan, text, "src.t.value", 0)
    && rejectsSpan(&stashViewInferred, RejectionCode.AccessDuringLoan, text, "src.t", 84)
    && rejectsSpan(&stashViewWrapped, RejectionCode.AccessDuringLoan, text, "src.t", 86),
    "a reborrow of a local view stored past the body, then its place overwritten or read, conflicts with the view's loan (OWN0011)")
  run Testing.expect(rejectsSpan(&stashViewExclusive, RejectionCode.LoanConflict, text, "&mut src.t", 2),
    "lending the place exclusively again while that loan lives is a second exclusive borrow (OWN0010)")
  run Testing.expect(hasBorrowStatus(&stashViewOther, BodyBorrowStatus.Checked),
    "a write to a disjoint field leaves a reborrow of a local view stored past the body proved")
  let stashSwapped = run Semantic.demandBody(&mut store, &mut request, &id, b"stashSwapped")
  let stashMethod = run Semantic.demandBody(&mut store, &mut request, &id, b"stashMethod")
  let stashGeneric = run Semantic.demandBody(&mut store, &mut request, &id, b"stashGeneric")
  let stashClosure = run Semantic.demandBody(&mut store, &mut request, &id, b"stashClosure")
  let stashEffect = run Semantic.demandBody(&mut store, &mut request, &id, b"stashEffect")
  run Testing.expect(rejectsSpan(&stashSwapped, RejectionCode.AccessDuringLoan, text, "src.t", 11)
      && rejectsSpan(&stashMethod, RejectionCode.AccessDuringLoan, text, "src.t", 13)
      && rejectsSpan(&stashGeneric, RejectionCode.AccessDuringLoan, text, "src.t", 15)
      && rejectsSpan(&stashClosure, RejectionCode.AccessDuringLoan, text, "src.t", 17)
      && rejectsSpan(&stashEffect, RejectionCode.AccessDuringLoan, text, "src.t", 19),
    "a universal view passed second, as a receiver call's argument, as a generic argument, in a closure or into an Effect escapes (OWN0011)")
  let stashInterface = run Semantic.demandBody(&mut store, &mut request, &id, b"stashInterface")
  let stashRun = run Semantic.demandBody(&mut store, &mut request, &id, b"stashRun")
