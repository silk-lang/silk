effect fn stagedAnonymousClaims(text: string, mode: CallableMode) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("staged-anonymous.silk")
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller) && stagedAnonymousArguments(&store, &caller, mode),
    "the staged direct literal call keeps its original environment mode and appends its suffix field")
  if mode == CallableMode.Mutable {
    let reused = run Semantic.demandBody(&mut store, &mut request, &id, b"reusedMutable")
    run Testing.expect(stagedMutableStorage(&store, &caller), "mutable staging borrows the stored nested environment rather than a copied snapshot")
    run Testing.expect(rejectsSpan(&reused, RejectionCode.UseAfterMove, text, "transferred", 2),
      "staging transfers an exclusive old callable even when the new callable remains exclusive (OWN0001)")
  }
  if mode == CallableMode.Once {
    run Testing.expect(glueFact(&store, &caller, usize.ZERO) == usize.ZERO,
      "once staging transfers its nested environment without retaining caller cleanup")
  }
}

fn stagedExitOwners(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Return {..} = &blocks[at].terminator {
          let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
          if sectionExitDrops(statements, locals) && stagedExitDropCount(statements) == 2 { return true }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn stagedExitDropCount(statements: &[MirStatement]) -> usize {
  let mut count = usize.ZERO
  let mut first = usize.MAX
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Drop {destination, ..} = &statements[at] {
      if Vector.length<MirProjection>(&destination.projections) == usize.ZERO && destination.local != first {
        if first == usize.MAX { first = destination.local }
        count = count + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return count
}

test effect fn stagedConstructionCleansPendingOwnersOnExit() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run stagedExitClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn stagedExitClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("staged-exit.silk")
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn main(base: Token, suffix: Token, choice: i32) -> i32 {
  let original = fn(first: i32, middle: Token, last: i32) -> i32 {
    let captured = move base
    return captured.value + middle.value + first + last
  }
  let next = original(move suffix, match choice { 0 => { return 9 } _ => 2 })
  return next(1)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller) && stagedExitOwners(&store, &caller)
    && glueFact(&store, &caller, usize.ZERO) == 2,
    "an exiting later suffix drops the transferred base and earlier owned suffix exactly on the exit edge")
  let selected = anonymousMirApplication(&store, &caller)
  if let Option<Shared<SpecializationApplication>>.Some {value} = move selected {
    let application = run SpecializationApplication.copyShared(&value)
    let target = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&target) && glueFact(&store, &target, usize.ZERO) == 2,
      "on the ordinary call edge the target owns both captures and the caller retains neither cleanup owner")
    return ()
  }
  run Testing.expect(false, "staged invocation keeps its original anonymous target")
}

