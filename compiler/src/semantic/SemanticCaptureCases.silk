}

effect fn anonymousParameterRegionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("anonymous-parameter-regions.silk")
  let text = """
fn inspect(value: &i32) -> i32 { return value.* }
fn apply(value: &i32, use: fn(&i32) -> i32) -> i32 { return use(value) }
fn stored(value: &i32) -> i32 {
  let read = fn(input: &i32) -> i32 { return inspect(&input.*) }
  return read(value)
}
fn inline(value: &i32) -> i32 {
  return apply(value, fn(input: &i32) -> i32 { return inspect(&input.*) })
}
effect fn effectful(value: &i32) -> i32 {
  let read = effect fn(input: &i32) -> i32 { return inspect(&input.*) }
  return run read(value)
}
fn unrelated<'a>(anchor: &'a i32) -> i32 {
  let read = fn(input: &i32) -> &'a i32 { return input }
  return read(anchor).*
}
effect<'use> fn coupled<'capture: 'use, 'use>(value: &'use mut i32, captured: &'capture i32) -> i32 {
  return value.* + captured.*
}
effect fn direct<'a>(value: &mut i32, captured: &'a i32) -> i32 {
  let read = effect fn(input: &mut i32) -> i32 { return run coupled(move input, captured) }
  return run read(&mut value.*)
}
effect fn reborrow<'a>(value: &mut i32, captured: &'a i32) -> i32 {
  let read = effect fn(input: &mut i32) -> i32 { return run coupled(&mut input.*, captured) }
  return run read(&mut value.*)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let stored = run Semantic.demandBody(&mut store, &mut request, &id, b"stored")
  let inline = run Semantic.demandBody(&mut store, &mut request, &id, b"inline")
  let effectful = run Semantic.demandBody(&mut store, &mut request, &id, b"effectful")
  let unrelated = run Semantic.demandBody(&mut store, &mut request, &id, b"unrelated")
  let direct = run Semantic.demandBody(&mut store, &mut request, &id, b"direct")
  let reborrow = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrow")
  run Testing.expect(anonymousStatus(&stored, BodyBorrowStatus.Checked),
    "a stored anonymous body's own elided parameter bounds its local reborrow")
  run Testing.expect(anonymousStatus(&inline, BodyBorrowStatus.Checked),
    "an inline anonymous body authenticates the same own-parameter domain")
  run Testing.expect(anonymousStatus(&effectful, BodyBorrowStatus.Checked),
    "an effectful anonymous body's parameter is universal within that invocation")
  run Testing.expect(!hasBorrowStatus(&unrelated, BodyBorrowStatus.Checked),
    "an invocation parameter cannot acquire an unrelated enclosing lifetime")
  run Testing.expect(rejectsSpan(&direct, RejectionCode.UnsatisfiedLifetimeBound, text,
    "coupled(move input, captured)", usize.ZERO),
    "an enclosing capture does not outlive the anonymous input's full universal lifetime (SEM0212)")
  run Testing.expect(anonymousStatus(&reborrow, BodyBorrowStatus.Checked),
    "a fresh reborrow chooses a finite invocation use that both the input and enclosing capture cover")
  return ()
}


test effect fn staticRegionsRetainAliasRestrictions() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
