effect fn retaggedBorrowRegionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("retagged-borrow-regions.silk")
  let text = """
struct Pair { value: i32 }
fn read(value: &i32) -> i32 { return value.* }
fn generic<T: Intrinsic.Copy>(value: &T) -> T { return value.* }
fn genericProjection(source: &Pair) -> i32 { return generic(&source.value) }
fn increment(value: &mut i32) -> () { value.* = value.* + 1 }
fn projected(source: &Pair) -> i32 { return read(&source.value) }
fn descriptor(source: &mut i32) -> i32 { increment(&mut source) return source.* }
interface Step { fn step(self: &mut Self) -> i32 }
impl Step for Pair { fn step(self: &mut Self) -> i32 { self.value = self.value + 1 return self.value } }
fn qualified<T: Step>(source: &mut T) -> i32 { return Step.step(&mut source) }
fn constrain<'a, 'x: 'a>(anchor: &'a i32, value: &'x i32) -> i32 { return anchor.* + value.* }
fn outlived<'a>(anchor: &'a i32) -> i32 {
  let local = Pair {value: 1}
  return constrain(anchor, &local.value)
}
fn same<'a>(value: &'a i32) -> &'a i32 { return value }
fn retained() -> i32 {
  let mut pair = Pair {value: 1}
  let view = same(&pair.value)
  pair.value = 2
  return view.*
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let genericProjection = run Semantic.demandBody(&mut store, &mut request, &id, b"genericProjection")
  let projected = run Semantic.demandBody(&mut store, &mut request, &id, b"projected")
  let descriptor = run Semantic.demandBody(&mut store, &mut request, &id, b"descriptor")
  let qualified = run Semantic.demandBody(&mut store, &mut request, &id, b"qualified")
  let outlived = run Semantic.demandBody(&mut store, &mut request, &id, b"outlived")
  let retained = run Semantic.demandBody(&mut store, &mut request, &id, b"retained")
  run Testing.expect(hasBorrowStatus(&genericProjection, BodyBorrowStatus.Checked),
    "generic argument inference keeps a projected borrow attached to its source-validity goal")
  run Testing.expect(hasBorrowStatus(&projected, BodyBorrowStatus.Checked),
    "a projected argument's source-validity goal follows its fresh loan into the call region")
  run Testing.expect(hasBorrowStatus(&descriptor, BodyBorrowStatus.Checked),
    "a contextual descriptor reborrow keeps its source-validity goal attached to the retagged loan")
  run Testing.expect(hasBorrowStatus(&qualified, BodyBorrowStatus.Checked),
    "a qualified interface argument uses the same retagged loan identity")
  run Testing.expect(hasBorrowStatus(&outlived, BodyBorrowStatus.Regions),
    "retagging a fresh borrow cannot make local storage outlive a universal parameter")
  run Testing.expect(rejectsSpan(&retained, RejectionCode.AccessDuringLoan, text, "pair.value", usize.ONE),
    "retagging keeps the source loan of a returned view alive across a conflicting write (OWN0011)")
  return ()
}

test effect fn aggregateBorrowRetaggingKeepsSourceBounds() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
