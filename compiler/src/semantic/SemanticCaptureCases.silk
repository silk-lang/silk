effect fn namedSectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("named-section.silk")
  let text = """
fn combine(first: i32, second: i32, third: i32) -> i32 { return first * 100 + second * 10 + third }
fn written() -> i32 { return 2 }
fn main() -> i32 { let section = combine(4, 3) return section(written()) }
unsafe extern "C" fn foreignProbe(left: i32, right: i32) -> i32
fn invalidForeignSection() -> () { let invalid = foreignProbe(40) }
fn select<T>(first: T, last: i32) -> T { return move first }
fn deferredSection() -> () { let unapplied = select(3) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let foreign = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidForeignSection")
  let deferred = run Semantic.demandBody(&mut store, &mut request, &id, b"deferredSection")
  run Testing.expect(succeeded(&answer) && namedSectionArguments(&store, &answer),
    "a section snapshots its fields before written arguments and appends them to its original direct target")
  run Testing.expect(rejectsSpan(&foreign, RejectionCode.ForeignFunctionNotFirstClass,
    text, "foreignProbe(40)", usize.ZERO), "foreign functions reject sections at construction (SEM0189)")
  run Testing.expect(succeeded(&deferred),
    "a section may retain its leading generic binder for later invocation without selecting a runtime instance")
}

test effect fn namedMutableSectionsRetainExclusiveReferents() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
