effect fn r3ObligationGuardClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("r3-obligation-guards.silk")
  let text = """
struct Counter { value: i32 }
impl Counter { fn bump(self: &mut Self) -> () { self.value = self.value + 1 } }
fn receiver(lent: &mut Counter) -> i32 {
  let held = &lent.value
  lent.bump()
  return held.*
}
fn callable() -> i32 {
  let mut count = 0
  let mut tick = fn() -> i32 { count = count + 1 return count }
  let held = &tick
  let result = tick()
  let again = held
  return result
}
fn captured() -> i32 {
  let mut count = 0
  let mut tick = fn() -> i32 { count = count + 1 return count }
  let held = &count
  let result = tick()
  return result + held.*
}
fn constrain<'a, 'x: 'a>(anchor: &'a i32, left: &'x i32, right: &'x i32) -> i32 { return anchor.* }
fn invocation<'a>(source: &'a i32) -> i32 {
  let local = 1
  return constrain(source, &source.*, &local)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let receiver = run Semantic.demandBody(&mut store, &mut request, &id, b"receiver")
  let callable = run Semantic.demandBody(&mut store, &mut request, &id, b"callable")
  let captured = run Semantic.demandBody(&mut store, &mut request, &id, b"captured")
  let invocation = run Semantic.demandBody(&mut store, &mut request, &id, b"invocation")
  run Testing.expect(rejectsSpan(&receiver, RejectionCode.LoanConflict, text, "lent.bump()", usize.ZERO),
    "ReceiverPass preserves the live receiver loan (OWN0010)")
  run Testing.expect(rejectsSpan(&callable, RejectionCode.LoanConflict, text, "tick", 2),
    "CallableInvocation cannot exclusively invoke a borrowed capture environment (OWN0010)")
  run Testing.expect(rejectsSpan(&captured, RejectionCode.LoanConflict, text, "&count", usize.ZERO),
    "WholeValue capture retention prevents borrowing a capture while its exclusive callable remains live")
  run Testing.expect(hasBorrowStatus(&invocation, BodyBorrowStatus.Regions),
    "Invocation markers cannot discharge an argument region's unproved callee bound")
  return ()
}

