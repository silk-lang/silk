fn passM<'p>(v: &'p mut Token) -> &'p mut Token { return move v }
fn wrap<'w>(v: &'w Token) -> Holder<'w> { return Holder { view: v } }
fn stashViewReborrow<'a: 'b, 'b>(src: &'a mut Box1, out: &mut Holder<'b>) -> () {
