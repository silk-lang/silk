  return run callableStorageAtomClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn callableStorageValue(owner: &DeclarationId, environment: &Shared<Lifetime>, capture: &Shared<Type>, represented: bool, schema: bool) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut arguments = Vector<Argument>.make()
  let mut ordinals = Vector<usize>.make()
  run Vector<Argument>.append(&mut arguments, Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Supplied {ordinal: 0})})
  run Vector<usize>.append(&mut ordinals, 0)
  if represented {
    run Vector<Argument>.append(&mut arguments, Argument.Type {value: Shared<Type>.clone(capture)})
    run Vector<usize>.append(&mut ordinals, 1)
  }
  let application = run Shared<SpecializationApplication>.make(SpecializationApplication {
    target: SpecializationTarget.Named {declaration: DeclarationId.copy(owner)}, arguments: move arguments,
    argumentOrdinals: move ordinals, scopes: Vector<ScopeBinding>.make(), statics: Vector<StaticSlot>.make()})
  let mut regions = Vector<Shared<Lifetime>>.make()
  run Vector<Shared<Lifetime>>.append(&mut regions, Shared<Lifetime>.clone(environment))
  let contract = run Types.intern(Type.Callable {mode: CallableMode.Shared, isUnsafe: false,
    environment: run Shared<Intersection>.make(run Intersection.of(Vector<Shared<Lifetime>>.asSlice(&regions))),
    invocationBinders: 0, invocationUse: usize.MAX, invocationBounds: Vector<Outlives>.make(),
    parameters: Vector<Shared<Type>>.make(), result: run Types.intern(Type.Unit)})
  let mut captures = Vector<Shared<Type>>.make()
  run Vector<Shared<Type>>.append(&mut captures, Shared<Type>.clone(capture))
  let mut inputs = Vector<CallableFieldInput>.make()
  run Vector<CallableFieldInput>.append(&mut inputs, CallableFieldInput.Argument {parameter: 0})
  if schema {
    let mut selected = Vector<Binding>.make()
    run Vector<Binding>.append(&mut selected, Binding {
      declaration: run Shared<DeclarationId>.make(DeclarationId.copy(owner)), ordinal: 0,
      value: Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Supplied {ordinal: 0})}})
    let mut deferred = Vector<usize>.make()
    run Vector<usize>.append(&mut deferred, 1)
    return run Type.callableSchema(run Shared<SectionSchema>.make(SectionSchema {
      target: run Shared<DeclarationId>.make(DeclarationId.copy(owner)), contract: move contract,
      selected: move selected, deferred: move deferred}), move captures, move inputs)
  }
  return run Type.callableValue(false, move application, move contract, move captures, move inputs)
}

effect fn callableStorageAtomClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("callable-storage-atoms.silk")
  let mut steps = Vector<OwnerStep>.make()
  run Vector<OwnerStep>.append(&mut steps, OwnerStep {kind: OwnerKind.Function,
    name: Option<Bytes>.some(run Bytes.copy(b"owner")), occurrence: 0})
  let owner = run DeclarationId.fromParts(move id, move steps)
  let own = run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: 0})
  let supplied = run Shared<Lifetime>.make(Lifetime.Supplied {ordinal: 0})
  let unit = run Types.intern(Type.Unit)
  let held = run Types.intern(Type.Reference {referent: Shared<Type>.clone(&unit), access: Access.Shared,
    lifetime: Shared<Lifetime>.clone(&own)})
  let actual = run Types.intern(Type.Reference {referent: Shared<Type>.clone(&unit), access: Access.Shared,
    lifetime: Shared<Lifetime>.clone(&supplied)})
  let nested = run Types.intern(Type.Reference {referent: Shared<Type>.clone(&actual), access: Access.Shared,
    lifetime: Shared<Lifetime>.clone(&own)})
  let mut locals = Vector<BodyLocal>.make()
  run Vector<BodyLocal>.append(&mut locals, BodyLocal {
    origin: BodyOrigin {node: 0, location: Location.make(0, 1)}, mutable: false, meetDepth: Option<usize>.none(),
    ty: run callableStorageValue(&owner, &own, &held, false, false)})
  let nodes = Vector<BodyNode>.make()
  run Testing.expect(run BorrowCheck.regionClosed(&owner, Vector<BodyLocal>.asSlice(&locals), Vector<BodyNode>.asSlice(&nodes)),
    "canonical application lifetime arguments do not replace the actual callable environment and capture regions")
  let mut direct = Vector<BodyLocal>.asMutSlice(&mut locals)
  direct[0].ty = Shared<Type>.clone(&actual)
  run Testing.expect(!run BorrowCheck.regionClosed(&owner, Vector<BodyLocal>.asSlice(&locals), Vector<BodyNode>.asSlice(&nodes)),
    "a supplied atom on an actual reference result remains open (reflection boundary)")
  let deep = run callableStorageValue(&owner, &own, &nested, false, false)
  let mut captured = Vector<BodyLocal>.asMutSlice(&mut locals)
  captured[0].ty = move deep
  run Testing.expect(!run BorrowCheck.regionClosed(&owner, Vector<BodyLocal>.asSlice(&locals), Vector<BodyNode>.asSlice(&nodes)),
    "a closed outer capture region cannot hide an unresolved inner referent region (Shelf boundary)")
  let inner = run callableStorageValue(&owner, &own, &nested, false, false)
  let represented = run callableStorageValue(&owner, &own, &inner, true, false)
  let marked = Shared<Type>.with<bool>(&represented, fn(value: &Type) -> bool {
    if let Type.CallableValue {fieldInputs, ..} = &value.* {
      let inputs = Vector<CallableFieldInput>.asSlice(&fieldInputs)
      if inputs.length == usize.ONE {
        return match &inputs[0] { CallableFieldInput.Represented {..} => true _ => false }
      }
    }
    return false
  })
  run Testing.expect(marked, "the nested executable capture is stored through its application type evidence")
  let mut evidence = Vector<BodyLocal>.asMutSlice(&mut locals)
  evidence[0].ty = move represented
  run Testing.expect(!run BorrowCheck.regionClosed(&owner, Vector<BodyLocal>.asSlice(&locals), Vector<BodyNode>.asSlice(&nodes)),
    "application type evidence for a represented capture must retain its unresolved stored regions")
  let promised = run callableStorageValue(&owner, &supplied, &unit, false, false)
  let mut environment = Vector<BodyLocal>.asMutSlice(&mut locals)
  environment[0].ty = move promised
  run Testing.expect(!run BorrowCheck.regionClosed(&owner, Vector<BodyLocal>.asSlice(&locals), Vector<BodyNode>.asSlice(&nodes)),
    "an unresolved retained environment remains open even when its stored value has no region")
  let closedSchema = run callableStorageValue(&owner, &own, &held, false, true)
  let mut schema = Vector<BodyLocal>.asMutSlice(&mut locals)
  schema[0].ty = move closedSchema
  run Testing.expect(run BorrowCheck.regionClosed(&owner, Vector<BodyLocal>.asSlice(&locals), Vector<BodyNode>.asSlice(&nodes)),
    "a generic schema keeps selection metadata separate from its closed stored regions")
  let openSchema = run callableStorageValue(&owner, &own, &nested, false, true)
  let mut schemaCapture = Vector<BodyLocal>.asMutSlice(&mut locals)
  schemaCapture[0].ty = move openSchema
  run Testing.expect(!run BorrowCheck.regionClosed(&owner, Vector<BodyLocal>.asSlice(&locals), Vector<BodyNode>.asSlice(&nodes)),
    "generic schemas still check every captured referent region")
  let promisedSchema = run callableStorageValue(&owner, &supplied, &unit, false, true)
  let mut schemaEnvironment = Vector<BodyLocal>.asMutSlice(&mut locals)
  schemaEnvironment[0].ty = move promisedSchema
  run Testing.expect(!run BorrowCheck.regionClosed(&owner, Vector<BodyLocal>.asSlice(&locals), Vector<BodyNode>.asSlice(&nodes)),
    "generic schemas retain their environment obligation independently of capture contents")
  return ()
}

