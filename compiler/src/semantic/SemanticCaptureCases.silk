effect fn finiteOwnedReborrowClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("finite-owned-reborrows.silk")
  let text = """
struct Token { value: i32 }
fn view<'a>(token: &'a Token) -> &'a Token { return token }
fn finite() -> i32 {
  let held = Token {value: 1}
  let first = view(&held)
  let mut second = view(&first.*)
  let third = view(&second.*)
  return third.value
}
fn writeOwner() -> i32 {
  let mut held = Token {value: 1}
  let first = view(&held)
  let mut second = view(&first.*)
  held = Token {value: 2}
  return second.value
}
fn moveOwner() -> i32 {
  let held = Token {value: 1}
  let first = view(&held)
  let mut second = view(&first.*)
  let consumed = move held
  return second.value + consumed.value
}
fn dropOwner() -> i32 {
  let held = Token {value: 1}
  let first = view(&held)
  let mut second = view(&first.*)
  drop move held
  return second.value
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let finite = run Semantic.demandBody(&mut store, &mut request, &id, b"finite")
  run Testing.expect(hasBorrowStatus(&finite, BodyBorrowStatus.Checked),
    "finite parent point requirements prove nested local reborrows without a universal root")
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"writeOwner")
  run Testing.expect(rejectsSpan(&written, RejectionCode.AccessDuringLoan, text, "held", 4),
    "a finite proof cannot permit replacing the original owner through a retained descendant")
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"moveOwner")
  run Testing.expect(rejectsSpan(&moved, RejectionCode.AccessDuringLoan, text, "held", 7),
    "a retained descendant still prevents moving its original owner")
  let dropped = run Semantic.demandBody(&mut store, &mut request, &id, b"dropOwner")
  run Testing.expect(rejectsSpan(&dropped, RejectionCode.AccessDuringLoan, text, "held", 10),
    "a retained descendant still prevents dropping its original owner")
  return ()
}


test effect fn completeResultSourcesReleaseUnrelatedOwnedInputs() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
