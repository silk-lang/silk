effect fn crossedBodyLocalClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("crossed-body-local-reborrows.silk")
  let text = """
fn local<'a>(source: &'a i32) -> i32 {
  let mut view = &source.*
  return view.*
}
fn identity<'a>(source: &'a i32) -> &'a i32 { return source }
fn same<'a>(source: &'a i32) -> &'a i32 {
  let mut view = &source.*
  return identity<'a>(&view.*)
}
fn unrelated<'a, 'b>(anchor: &'a i32, source: &'b i32) -> &'a i32 {
  let mut view = &source.*
  return identity<'a>(&view.*)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let local = run Semantic.demandBody(&mut store, &mut request, &id, b"local")
  let same = run Semantic.demandBody(&mut store, &mut request, &id, b"same")
  let unrelated = run Semantic.demandBody(&mut store, &mut request, &id, b"unrelated")
  run Testing.expect(hasBorrowStatus(&local, BodyBorrowStatus.Checked),
    "a universal parent covers a mutable holder's body-local reborrow points")
  run Testing.expect(hasBorrowStatus(&same, BodyBorrowStatus.Checked),
    "a local-to-universal goal follows the reborrow chain to the matching universal parent")
  run Testing.expect(hasBorrowStatus(&unrelated, BodyBorrowStatus.Regions),
    "a universal parent does not justify an inferred local atom outliving an unrelated universal")
  return ()
}

