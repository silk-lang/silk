"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let invariantSlot = run Semantic.demandBody(&mut store, &mut request, &id, b"invariantSlot")
  let pipedCallable = run Semantic.demandBody(&mut store, &mut request, &id, b"pipedCallable")
  let pipedCallableLast = run Semantic.demandBody(&mut store, &mut request, &id, b"pipedCallableLast")
  let directCallable = run Semantic.demandBody(&mut store, &mut request, &id, b"directCallable")
  let pipedFunction = run Semantic.demandBody(&mut store, &mut request, &id, b"pipedFunction")
  let pipedEffect = run Semantic.demandBody(&mut store, &mut request, &id, b"pipedEffect")
  let methodCallable = run Semantic.demandBody(&mut store, &mut request, &id, b"methodCallable")
  let resultForced = run Semantic.demandBody(&mut store, &mut request, &id, b"resultForced")
  let valueCall = run Semantic.demandBody(&mut store, &mut request, &id, b"valueCall")
  let reborrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrowed")
  let staticOperand = run Semantic.demandBody(&mut store, &mut request, &id, b"staticOperand")
  let pipedStatic = run Semantic.demandBody(&mut store, &mut request, &id, b"pipedStatic")
  let twoValid = run Semantic.demandBody(&mut store, &mut request, &id, b"twoValid")
  let covariantLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"covariantLocal")
  let flipped = run Semantic.demandBody(&mut store, &mut request, &id, b"flipped")
  let genericCallable = run Semantic.demandBody(&mut store, &mut request, &id, b"genericCallable")
  let genericInvariant = run Semantic.demandBody(&mut store, &mut request, &id, b"genericInvariant")
  let callerCallable = run Semantic.demandBody(&mut store, &mut request, &id, b"callerCallable")
  let mixedForced = run Semantic.demandBody(&mut store, &mut request, &id, b"mixedForced")
  let lentSlot = run Semantic.demandBody(&mut store, &mut request, &id, b"lentSlot")
  let mixedOpen = run Semantic.demandBody(&mut store, &mut request, &id, b"mixedOpen")
  let mixedOpaque = run Semantic.demandBody(&mut store, &mut request, &id, b"mixedOpaque")
  let genericPinned = run Semantic.demandBody(&mut store, &mut request, &id, b"genericPinned")
  let genericKept = run Semantic.demandBody(&mut store, &mut request, &id, b"genericKept")
  let arrayForced = run Semantic.demandBody(&mut store, &mut request, &id, b"arrayForced")
  let unionForced = run Semantic.demandBody(&mut store, &mut request, &id, b"unionForced")
  let effectForced = run Semantic.demandBody(&mut store, &mut request, &id, b"effectForced")
  let envForced = run Semantic.demandBody(&mut store, &mut request, &id, b"envForced")
  let rowForced = run Semantic.demandBody(&mut store, &mut request, &id, b"rowForced")
  let rowCallbackForced = run Semantic.demandBody(&mut store, &mut request, &id, b"rowCallbackForced")
  let arrayOpen = run Semantic.demandBody(&mut store, &mut request, &id, b"arrayOpen")
  let unionOpen = run Semantic.demandBody(&mut store, &mut request, &id, b"unionOpen")
  let effectOpen = run Semantic.demandBody(&mut store, &mut request, &id, b"effectOpen")
  let envOpen = run Semantic.demandBody(&mut store, &mut request, &id, b"envOpen")
  let nominalMembersForced = run Semantic.demandBody(&mut store, &mut request, &id, b"nominalMembersForced")
  let nominalMembersMutForced = run Semantic.demandBody(&mut store, &mut request, &id, b"nominalMembersMutForced")
  let arrayMembersForced = run Semantic.demandBody(&mut store, &mut request, &id, b"arrayMembersForced")
  let nominalMembersOpen = run Semantic.demandBody(&mut store, &mut request, &id, b"nominalMembersOpen")
  let arrayMembersOpen = run Semantic.demandBody(&mut store, &mut request, &id, b"arrayMembersOpen")
  let constResult = run Semantic.demandBody(&mut store, &mut request, &id, b"constResult")
  let oneStaticInput = run Semantic.demandBody(&mut store, &mut request, &id, b"oneStaticInput")
  let slotPinned = run Semantic.demandBody(&mut store, &mut request, &id, b"slotPinned")
  let wrapPinned = run Semantic.demandBody(&mut store, &mut request, &id, b"wrapPinned")
  let stringPinned = run Semantic.demandBody(&mut store, &mut request, &id, b"stringPinned")
  let callbackPinned = run Semantic.demandBody(&mut store, &mut request, &id, b"callbackPinned")
  let doubleContravariant = run Semantic.demandBody(&mut store, &mut request, &id, b"doubleContravariant")
  let letDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"letDirect")
  let letPiped = run Semantic.demandBody(&mut store, &mut request, &id, b"letPiped")
  let argDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"argDirect")
  let argPiped = run Semantic.demandBody(&mut store, &mut request, &id, b"argPiped")
  let slotPiped = run Semantic.demandBody(&mut store, &mut request, &id, b"slotPiped")
  let valueLet = run Semantic.demandBody(&mut store, &mut request, &id, b"valueLet")
  let slotValue = run Semantic.demandBody(&mut store, &mut request, &id, b"slotValue")
  let outValue = run Semantic.demandBody(&mut store, &mut request, &id, b"outValue")
  let argOpen = run Semantic.demandBody(&mut store, &mut request, &id, b"argOpen")
  let letPipedValid = run Semantic.demandBody(&mut store, &mut request, &id, b"letPipedValid")
  let argPipedValid = run Semantic.demandBody(&mut store, &mut request, &id, b"argPipedValid")
  let slotPipedValid = run Semantic.demandBody(&mut store, &mut request, &id, b"slotPipedValid")
  let valueLetValid = run Semantic.demandBody(&mut store, &mut request, &id, b"valueLetValid")
  let outValueValid = run Semantic.demandBody(&mut store, &mut request, &id, b"outValueValid")
  let parsedToTheEnd = run Semantic.demandBody(&mut store, &mut request, &id, b"parsedToTheEnd")
  run Testing.expect(rejectsSpan(&invariantSlot, RejectionCode.UnsatisfiedLifetimeBound, text, "&held1", 0)
      && rejectsSpan(&pipedCallable, RejectionCode.UnsatisfiedLifetimeBound, text, "&held2", 0)
      && rejectsSpan(&pipedCallableLast, RejectionCode.UnsatisfiedLifetimeBound, text, "&held3", 0)
      && rejectsSpan(&directCallable, RejectionCode.UnsatisfiedLifetimeBound, text, "&held4", 0)
      && rejectsSpan(&pipedFunction, RejectionCode.UnsatisfiedLifetimeBound, text, "&held5", 0)
      && rejectsSpan(&methodCallable, RejectionCode.UnsatisfiedLifetimeBound, text, "&held9", 0),
    "a local borrow offered to a binder an invariant or contravariant argument forces to 'static is refused at the borrow")
  run Testing.expect(rejectsSpan(&pipedEffect, RejectionCode.ReturnTypeMismatch, text, "begin(options) |> launderE(\"x\", giveId, &held6)", 0),
    "a piped Effect returned as a reference keeps its return refusal")
  run Testing.expect(rejectsSpan(&resultForced, RejectionCode.UnsatisfiedLifetimeBound, text, "&held8", 0)
      && rejectsSpan(&letDirect, RejectionCode.UnsatisfiedLifetimeBound, text, "&held61", 0)
      && rejectsSpan(&letPiped, RejectionCode.UnsatisfiedLifetimeBound, text, "&held63", 0)
      && rejectsSpan(&slotPiped, RejectionCode.UnsatisfiedLifetimeBound, text, "&held69", 0),
    "a 'static result, annotation or slot the call's result is written to forces the binder, through a pipeline too")
  run Testing.expect(rejectsSpan(&argDirect, RejectionCode.UnsatisfiedLifetimeBound, text, "&held65", 0)
      && rejectsSpan(&argPiped, RejectionCode.UnsatisfiedLifetimeBound, text, "&held67", 0),
    "a 'static parameter the call's result is passed to forces the binder")
  run Testing.expect(rejectsSpan(&valueCall, RejectionCode.UnsatisfiedLifetimeBound, text, "&held10", 0)
      && rejectsSpan(&valueLet, RejectionCode.UnsatisfiedLifetimeBound, text, "&held70", 0)
      && rejectsSpan(&slotValue, RejectionCode.UnsatisfiedLifetimeBound, text, "&held71", 0)
      && rejectsSpan(&outValue, RejectionCode.UnsatisfiedLifetimeBound, text, "&held72", 0),
    "a callable value's invocation refuses the local its argument forces to 'static, wherever the result goes")
  run Testing.expect(hasBorrowStatus(&argOpen, BodyBorrowStatus.Checked),
    "a covariant parameter can shorten with the local result it receives")
  run Testing.expect(hasBorrowStatus(&letPipedValid, BodyBorrowStatus.Checked) && hasBorrowStatus(&argPipedValid, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&slotPipedValid, BodyBorrowStatus.Checked) && hasBorrowStatus(&valueLetValid, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&outValueValid, BodyBorrowStatus.Checked),
    "a 'static operand at the forced binder stays Checked")
  run Testing.expect(hasBorrowStatus(&reborrowed, BodyBorrowStatus.Checked),
    "a reborrow through a rigid static view forces no 'static on the local, so the body is Checked")
  run Testing.expect(hasBorrowStatus(&flipped, BodyBorrowStatus.Checked),
    "joint shortening preserves the reversed declared outlives direction")
  run Testing.expect(hasBorrowStatus(&genericCallable, BodyBorrowStatus.Checked) && hasBorrowStatus(&genericInvariant, BodyBorrowStatus.Checked),
    "a lifetime-generic callable could take the local's region, so it never forces the binder's 'static and the body is Checked")
  run Testing.expect(rejectsSpan(&callerCallable, RejectionCode.UnsatisfiedLifetimeBound, text, "&held17", 0)
      && rejectsSpan(&mixedForced, RejectionCode.UnsatisfiedLifetimeBound, text, "&held18", 0)
      && rejectsSpan(&lentSlot, RejectionCode.UnsatisfiedLifetimeBound, text, "&held19", 0),
    "an operand holding 'static at the binder's own position forces it, whatever its other regions")
  // The stage's captures are typed only at body regions, so they stay in its environment. A stage
  // whose operands name the caller's type parameter may still store them through an instantiation.
  run Testing.expect(hasBorrowStatus(&mixedOpen, BodyBorrowStatus.Checked) && hasBorrowStatus(&mixedOpaque, BodyBorrowStatus.Checked),
    "a 'static region away from the binder's position forces nothing, so both bodies are Checked")
  run Testing.expect(rejectsSpan(&genericPinned, RejectionCode.UnsatisfiedLifetimeBound, text, "&held21", 0),
    "a generic callable whose signature fixes 'static at the binder's position forces it")
  run Testing.expect(hasBorrowStatus(&genericKept, BodyBorrowStatus.Checked),
    "a generic callable's own binder at that position can take the local's region, so the body is Checked")
  run Testing.expect(rejectsSpan(&arrayForced, RejectionCode.UnsatisfiedLifetimeBound, text, "&held40", 0)
      && rejectsSpan(&unionForced, RejectionCode.UnsatisfiedLifetimeBound, text, "&held41", 0)
      && rejectsSpan(&effectForced, RejectionCode.UnsatisfiedLifetimeBound, text, "&held42", 0)
      && rejectsSpan(&envForced, RejectionCode.UnsatisfiedLifetimeBound, text, "&held43", 0)
      && rejectsSpan(&rowForced, RejectionCode.UnsatisfiedLifetimeBound, text, "&held44", 0)
      && rejectsSpan(&rowCallbackForced, RejectionCode.UnsatisfiedLifetimeBound, text, "&held45", 0),
    "a generic callable fixing 'static in an array element, a union member, an environment or a requirement forces the binder")
  run Testing.expect(hasBorrowStatus(&arrayOpen, BodyBorrowStatus.Checked) && hasBorrowStatus(&unionOpen, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&effectOpen, BodyBorrowStatus.Checked) && hasBorrowStatus(&envOpen, BodyBorrowStatus.Checked),
    "a generic callable's own binder in those positions can take the local's region, so the bodies are Checked")
  run Testing.expect(rejectsSpan(&nominalMembersForced, RejectionCode.UnsatisfiedLifetimeBound, text, "&held50", 0)
      && rejectsSpan(&nominalMembersMutForced, RejectionCode.UnsatisfiedLifetimeBound, text, "&held51", 0)
      && rejectsSpan(&arrayMembersForced, RejectionCode.UnsatisfiedLifetimeBound, text, "&held52", 0),
    "a union member that shares its shape with another is paired by its lifetime-erased type")
  run Testing.expect(hasBorrowStatus(&nominalMembersOpen, BodyBorrowStatus.Checked) && hasBorrowStatus(&arrayMembersOpen, BodyBorrowStatus.Checked),
    "a generic callable's own binder in a same-shape union member can take the local's region, so the bodies are Checked")
  run Testing.expect(rejectsSpan(&oneStaticInput, RejectionCode.UnsatisfiedLifetimeBound, text, "&held24", 0),
    "a generic callable fixing 'static at one contravariant position of the binder forces it")
  run Testing.expect(hasBorrowStatus(&constResult, BodyBorrowStatus.Checked),
    "a generic callable's 'static result coerces to the binder, so it forces nothing and the body is Checked")
  run Testing.expect(rejectsSpan(&slotPinned, RejectionCode.UnsatisfiedLifetimeBound, text, "&held25", 0)
      && rejectsSpan(&wrapPinned, RejectionCode.UnsatisfiedLifetimeBound, text, "&held26", 0)
      && rejectsSpan(&stringPinned, RejectionCode.UnsatisfiedLifetimeBound, text, "&held27", 0)
      && rejectsSpan(&callbackPinned, RejectionCode.UnsatisfiedLifetimeBound, text, "&held28", 0),
    "a generic callable's 'static forces the binder through a nominal, a string view and a callable parameter")
  run Testing.expect(hasBorrowStatus(&doubleContravariant, BodyBorrowStatus.Checked),
    "a 'static at a doubly contravariant position is covariant and forces nothing, so the body is Checked")
  run Testing.expect(hasBorrowStatus(&staticOperand, BodyBorrowStatus.Checked) && hasBorrowStatus(&pipedStatic, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&twoValid, BodyBorrowStatus.Checked) && hasBorrowStatus(&covariantLocal, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&parsedToTheEnd, BodyBorrowStatus.Checked),
    "a 'static operand, and a local offered to a binder every parameter stores covariantly, stay Checked")
  return ()
}

// A section or closure that captures a loan of storage the body owns, typed only at body regions,
// keeps it in the regions its type names: that storage ends within the body, so no slot naming only
// universal regions admits it. A pipeline stage capturing a local is therefore Checked, while a stage
// that stores the local into a caller slot keeps its unproved relation. A reborrow through a
// parameter may be proved to outlive the parameter's region, so a stage capturing one stays
// unchecked: one storing it into a caller slot before the place is written must never be Checked.
test effect fn locallyTypedCapturesStayInTheirRegions() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run locallyTypedCaptureClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn locallyTypedCaptureClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("locally-typed-captures.silk")
  let text = """
struct Obj { n: i32 }
struct Slot<'s> { r: &'s i32 }
effect fn begin(options: &i32) -> Obj { return Obj {n: options.*} }
effect fn field<'env, E, ?R>(self: once Effect<'env; Obj ! E ? R>, key: string<'env>, value: &'env i32) -> Obj ! E ? R {
  let mut o = run move self
  o.n = o.n + value.*
  return move o
}
effect fn keepAny<'env, 's, E, ?R>(self: once Effect<'env; Obj ! E ? R>, slot: &'env mut Slot<'s>, value: &'s i32) -> Obj ! E ? R {
  let o = run move self
  slot.r = value
  return move o
}
effect fn pipedLocal(options: &i32) -> Obj { let local = 5  return run begin(options) |> field("x", &local) }
effect fn pipedPlace(p: &Obj, options: &i32) -> Obj { return run begin(options) |> field("x", &p.n) |> field("y", &p.n) }
effect fn storesLocal<'p, 'q>(slot: &'p mut Slot<'q>, options: &i32) -> Obj { let local = 5  return run begin(options) |> keepAny(move slot, &local) }
fn putS3<'e, 's>(recv: i32, s: &'e mut Slot<'s>, a: &'s i32) -> () { s.r = a  return () }
fn placeStored<'p, 'q>(p: &'q mut Obj, slot: &'p mut Slot<'q>) -> i32 { 1 |> putS3(move slot, &p.n)  p.n = 9  return 0 }
fn placeStoredDirect<'p, 'q>(pd: &'q mut Obj, slot: &'p mut Slot<'q>) -> i32 { putS3(1, move slot, &pd.n)  pd.n = 9  return 0 }
effect fn placeStoredEffect<'p, 'q>(p: &'q mut Obj, slot: &'p mut Slot<'q>, o: &i32) -> Obj { let r = run begin(o) |> keepAny(move slot, &p.n)  p.n = 3  return move r }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let pipedLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"pipedLocal")
  let pipedPlace = run Semantic.demandBody(&mut store, &mut request, &id, b"pipedPlace")
  let storesLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"storesLocal")
  let placeStored = run Semantic.demandBody(&mut store, &mut request, &id, b"placeStored")
  let placeStoredDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"placeStoredDirect")
  let placeStoredEffect = run Semantic.demandBody(&mut store, &mut request, &id, b"placeStoredEffect")
  run Testing.expect(hasBorrowStatus(&pipedLocal, BodyBorrowStatus.Checked),
    "a pipeline stage capturing a loan of an owned local keeps it in its own regions")
  run Testing.expect(rejectsSpan(&storesLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 1),
    "a stage storing a local into a caller slot needs the local to outlive the slot's lifetime (SEM0212 at the borrow)")
  run Testing.expect(hasBorrowStatus(&pipedPlace, BodyBorrowStatus.Checked),
    "stages capturing reborrows through parameters meet a fresh environment region, so the body is Checked")
  run Testing.expect(rejectsSpan(&placeStored, RejectionCode.AccessDuringLoan, text, "p.n", 3)
      && rejectsSpan(&placeStoredEffect, RejectionCode.AccessDuringLoan, text, "p.n", 5),
    "a stage storing a reborrow into a caller slot keeps its loan for the slot's whole lifetime, so a later write is OWN0011")
  run Testing.expect(rejectsSpan(&placeStoredDirect, RejectionCode.AccessDuringLoan, text, "pd.n", 1),
    "the direct call storing the reborrow refuses the later write")
  return ()
}

// A callable value an Effect application carries, as an observer `observeDiagnostics` stores,
// still describes future calls: its own parameters and invocation binders are closed wherever the
// carrying type is held. A capture of a local loan, or a loan stored through the callback's
// state, stays refused.
test effect fn nestedCallableBindersAreClosed() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run nestedCallableBinderClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nestedCallableBinderClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("nested-callable-binders.silk")
  let text = """
struct Box<'k> { r: &'k i32 }
fn observing<'env, S: 'env, A, ?R, F: fn<'static>(&mut S, u8, usize, usize, string<'static>, string<'static>) -> usize + Intrinsic.NonParking>(state: S, observer: F, body: once Effect<'env; A ? R>) -> once Effect<'env; A ? R> {
  return Intrinsic.observeDiagnostics<S, A, R, F>(move state, move observer, move body)
}
effect fn body() -> i32 { return 7 }
effect fn captured() -> i32 {
  let weight = 3
  let weighed = fn(state: &mut i32, event: u8, first: usize, second: usize, identity: string<'static>, origin: string<'static>) -> usize { state.* = state.* + weight  return 0 }
  return run observing(0, weighed, body())
}
effect fn direct() -> i32 {
  let weight = 3
  return run Intrinsic.observeDiagnostics(0, fn(state: &mut i32, event: u8, first: usize, second: usize, identity: string<'static>, origin: string<'static>) -> usize { state.* = state.* + weight  return 0 }, body())
}
effect fn byReference() -> i32 {
  let weight = 3
  let w = &weight
  let weighed = fn(state: &mut i32, event: u8, first: usize, second: usize, identity: string<'static>, origin: string<'static>) -> usize { state.* = state.* + w.*  return 0 }
  return run observing(0, weighed, body())
}
effect fn storesLocal() -> i32 {
  let local = 3
  let weighed = fn(state: &mut Box<'static>, event: u8, first: usize, second: usize, identity: string<'static>, origin: string<'static>) -> usize { state.r = &local  return 0 }
  return run observing(Box {r: &local}, weighed, body())
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let captured = run Semantic.demandBody(&mut store, &mut request, &id, b"captured")
  let direct = run Semantic.demandBody(&mut store, &mut request, &id, b"direct")
  let byReference = run Semantic.demandBody(&mut store, &mut request, &id, b"byReference")
  let storesLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"storesLocal")
  run Testing.expect(hasBorrowStatus(&captured, BodyBorrowStatus.Checked) && hasBorrowStatus(&direct, BodyBorrowStatus.Checked),
    "an observer an Effect carries keeps its own binders closed, through a generic wrapper or directly")
  run Testing.expect(rejectsSpan(&byReference, RejectionCode.UnsatisfiedLifetimeBound, text, "&weight", 0),
    "an observer capturing a local loan stays refused")
  run Testing.expect(rejectsSpan(&storesLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "local", 1),
    "an observer storing a local loan through its 'static state stays refused: SEM0212 at the borrow")
  return ()
}

test effect fn callableFutureSignatureDoesNotImplyStoredOutlives() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run callableContentsGuardClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn callableContentsGuardClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("callable-contents-guard.silk")
  let text = """
fn require<'a, 'b: 'a>(value: &'b i32) -> i32 { return value.* }
fn boundOnly<'a, 'b>(callable: &'a fn(&'b i32) -> i32, value: &'b i32) -> i32 { return require<'a, 'b>(value) }
fn staged<'a, 'b>(callable: &'a fn(&'b i32) -> i32, value: &'b i32) -> &'a i32 {
  let view = &value.*
  return view
}
fn extend<'a, 'b: 'a>(value: &'b i32) -> &'a i32 { return value }
fn control<'a, 'b>(callable: &'a fn(&'b i32) -> i32, value: &'b i32) -> i32 { return value.* }
fn wrong<'a, 'b>(callable: &'a fn(&'b i32) -> i32, value: &'b i32) -> &'a i32 {
  return extend<'a, 'b>(value)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let control = run Semantic.demandBody(&mut store, &mut request, &id, b"control")
  let helper = run Semantic.demandBody(&mut store, &mut request, &id, b"extend")
  run Testing.expect(hasBorrowStatus(&control, BodyBorrowStatus.Checked), "callable guard syntax and ordinary borrowed use are checked")
  run Testing.expect(hasBorrowStatus(&helper, BodyBorrowStatus.Checked), "an explicit declared outlives premise remains valid")
  let caller = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong")
  run Testing.expect(rejectsSpan(&caller, RejectionCode.UnsatisfiedLifetimeBound, text, "extend<'a, 'b>(value)", 0),
    "borrowing a callable cannot imply outlives from its future parameter types")
  let scalar = run Semantic.demandBody(&mut store, &mut request, &id, b"boundOnly")
  run Testing.expect(rejectsSpan(&scalar, RejectionCode.UnsatisfiedLifetimeBound, text, "require<'a, 'b>(value)", 0),
    "an independent result does not authorize a future callable parameter to prove a call bound")
  let staged = run Semantic.demandBody(&mut store, &mut request, &id, b"staged")
  run Testing.expect(!hasBorrowStatus(&staged, BodyBorrowStatus.Checked),
    "a staged local reborrow cannot use a future callable parameter as a declared escape premise")
  return ()
}

test effect fn genericCapturedContentsCoverOnlyFiniteUses() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run finiteCapturedContentsClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn finiteCapturedContentsClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("finite-captured-contents.silk")
  let text = """
fn local<T>(value: T) -> i32 {
  let take = fn() -> i32 { drop move value return 1 }
  return take()
}
fn invoke(take: once fn() -> i32) -> i32 { return take() }
fn inline<T>(value: T) -> i32 {
  return invoke(fn() -> i32 { drop move value return 2 })
}
fn effectful<T>(value: T) -> i32 {
  let take = effect fn() -> i32 { drop move value return 3 }
  drop move take
  return 4
}
fn promised<T: 'static>(value: T) -> once fn<'static>() -> T {
  return fn() -> T { return move value }
}
fn requireStatic<T: 'static>(value: T) -> i32 { drop move value return 5 }
fn unbounded<T>(value: T) -> i32 {
  let take = fn() -> i32 { return requireStatic<T>(move value) }
  return take()
}
fn conflict<T>(value: T) -> i32 {
  let mut owner = 1
  let view = &owner
  let take = fn() -> i32 { drop move value return view.* }
  owner = 2
  return take()
}
fn released<T>(value: T) -> i32 {
  let mut owner = 1
  let view = &owner
  let take = fn() -> i32 { drop move value return view.* }
  let first = take()
  owner = 2
  return first + owner
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let local = run Semantic.demandBody(&mut store, &mut request, &id, b"local")
  run Testing.expect(hasBorrowStatus(&local, BodyBorrowStatus.Checked), "a let-bound generic callable retains its owned value only for finite use")
  let inline = run Semantic.demandBody(&mut store, &mut request, &id, b"inline")
  run Testing.expect(hasBorrowStatus(&inline, BodyBorrowStatus.Checked), "an inline generic callable has the same finite contents rule")
  let effectful = run Semantic.demandBody(&mut store, &mut request, &id, b"effectful")
  run Testing.expect(hasBorrowStatus(&effectful, BodyBorrowStatus.Checked), "a generic effectful callable keeps finite captured contents")
  let promised = run Semantic.demandBody(&mut store, &mut request, &id, b"promised")
  run Testing.expect(hasBorrowStatus(&promised, BodyBorrowStatus.Checked), "an explicit T:static premise still permits the static environment")
  let unbounded = run Semantic.demandBody(&mut store, &mut request, &id, b"unbounded")
  run Testing.expect(rejectsSpan(&unbounded, RejectionCode.UnsatisfiedLifetimeBound, text, "requireStatic<T>(move value)", usize.ZERO),
    "finite capture contents cannot justify a T:static requirement")
  let conflict = run Semantic.demandBody(&mut store, &mut request, &id, b"conflict")
  run Testing.expect(rejectsSpan(&conflict, RejectionCode.AccessDuringLoan, text, "owner", 2),
    "proving generic contents cannot release a concrete captured alias loan")
  // A capture naming a type parameter its callers choose names no body region, so the body-local
  // alias the callable captures stays with it: used before its source changes, it is proved.
  let released = run Semantic.demandBody(&mut store, &mut request, &id, b"released")
  run Testing.expect(succeeded(&released) && hasBorrowStatus(&released, BodyBorrowStatus.Checked),
    "a generic captured alias used before its source changes is checked")
  return ()
}

// CAPTURE-002 / ANON-OWN-001: an invoked closure may store one captured loan in a holder it reaches
// through another capture. Regressions: accepting a holder read after the stored loan's owner ended
// or was written, through an invocation or a call that may invoke the closure, whether it receives
// the closure by value, by reference, or in a holder's field; checking a holder reached through a
// reference to body storage; and retaining a loan a closure only reads.
test effect fn invokedClosuresStoreCapturedLoans() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run invokedClosureStoreClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn invokedClosureStoreClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("invoked-closure-store.silk")
  let text = """
union Maybe<T> { None, Some { value: T } }
struct Slot<'a> {
  view: Maybe<&'a i32>,
  tally: i32,
}
fn read<'a>(slot: &Slot<'a>) -> i32 {
  if let Maybe<&'a i32>.Some {value} = &slot.view { return value.* }
  return 0
}
fn some<'a>(value: &'a i32) -> Maybe<&'a i32> {
  return Maybe<&'a i32>.Some {value: value}
}
fn apply(f: once fn() -> ()) -> () {
  f()
  return ()
}
fn dangle() -> i32 {
  let zero = 0
  let mut slot = Slot {view: some(&zero), tally: 0}
  if true {
    let count = 41
    let mut f = fn() -> () { slot.view = some(&count) }
    f()
  }
  return read(&slot)
}
fn alias() -> i32 {
  let zero = 0
  let mut count = 1
  let mut slot = Slot {view: some(&zero), tally: 0}
  let mut f = fn() -> () { slot.view = some(&count) }
  f()
  count = 2
  return read(&slot)
}
fn passed() -> i32 {
  let zero = 0
  let mut slot = Slot {view: some(&zero), tally: 0}
  if true {
    let count = 41
    apply(fn() -> () { slot.view = some(&count) })
  }
  return read(&slot)
}
fn throughReference() -> i32 {
  let zero = 0
  let mut slot = Slot {view: some(&zero), tally: 0}
  if true {
    let count = 41
    let target = &mut slot
    let mut f = fn() -> () { target.view = some(&count) }
    f()
  }
  return read(&slot)
}
fn insideBlock() -> i32 {
  let zero = 0
  let mut total = 0
  if true {
    let count = 41
    let mut slot = Slot {view: some(&zero), tally: 0}
    let mut f = fn() -> () { slot.view = some(&count) }
    f()
    total = read(&slot)
  }
  return total
}
fn onlyReads() -> i32 {
  let mut count = 1
  let mut seen = 0
  let mut f = fn() -> () { seen = count }
  f()
  count = 2
  return seen + count
}
fn writesValue() -> i32 {
  let zero = 0
  let mut count = 1
  let mut slot = Slot {view: some(&zero), tally: 0}
  let mut f = fn() -> () {
    let probe = count
    slot.tally = probe
  }
  f()
  count = 2
  return read(&slot) + count
}
struct Runner<'r, F> {
  task: &'r mut F,
}
fn applyMut(f: &mut mut fn() -> ()) -> () {
  f.*()
  return ()
}
fn forward(f: &mut mut fn() -> ()) -> () {
  applyMut(&mut f.*)
  return ()
}
fn byReference() -> i32 {
  let zero = 0
  let mut slot = Slot {view: some(&zero), tally: 0}
  if true {
    let count = 41
    let mut f = fn() -> () { slot.view = some(&count) }
    applyMut(&mut f)
  }
  return read(&slot)
}
fn byReferenceAlias() -> i32 {
  let zero = 0
  let mut count = 1
  let mut slot = Slot {view: some(&zero), tally: 0}
  let mut f = fn() -> () { slot.view = some(&count) }
  applyMut(&mut f)
  count = 2
  return read(&slot)
}
fn forwardedDirect() -> i32 {
  let zero = 0
  let mut slot = Slot {view: some(&zero), tally: 0}
  if true {
    let count = 41
    let mut f = fn() -> () { slot.view = some(&count) }
    forward(&mut f)
  }
  return read(&slot)
}
fn forwarded() -> i32 {
  let zero = 0
  let mut slot = Slot {view: some(&zero), tally: 0}
  if true {
    let count = 41
    let mut f = fn() -> () { slot.view = some(&count) }
    let r = &mut f
    forward(&mut r.*)
  }
  return read(&slot)
}
fn throughField() -> i32 {
  let zero = 0
  let mut slot = Slot {view: some(&zero), tally: 0}
  if true {
    let count = 41
    let mut f = fn() -> () { slot.view = some(&count) }
    let mut runner = Runner {task: &mut f}
    applyMut(&mut runner.task.*)
  }
  return read(&slot)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let dangle = run Semantic.demandBody(&mut store, &mut request, &id, b"dangle")
  let alias = run Semantic.demandBody(&mut store, &mut request, &id, b"alias")
  let passed = run Semantic.demandBody(&mut store, &mut request, &id, b"passed")
  let throughReference = run Semantic.demandBody(&mut store, &mut request, &id, b"throughReference")
  run Testing.expect(rejectsFrom(&dangle, RejectionCode.ExpiredLifetime, offsetOf(text, "&slot)\n}\nfn alias", usize.ZERO)),
    "a holder read after the local an invoked closure stored in it ended is OWN0019")
  run Testing.expect(rejectsFrom(&alias, RejectionCode.AccessDuringLoan, offsetOf(text, "count = 2", usize.ZERO)),
    "writing a local an invoked closure stored in a still-used holder is OWN0011")
  run Testing.expect(rejectsFrom(&passed, RejectionCode.ExpiredLifetime, offsetOf(text, "&slot)\n}\nfn throughReference", usize.ZERO)),
    "a call that can invoke its closure argument stores as an invocation does")
  run Testing.expect(rejectsFrom(&throughReference, RejectionCode.ExpiredLifetime, offsetOf(text, "&slot)\n}\nfn insideBlock", usize.ZERO)),
    "a store through a reference to body storage keeps the holder's loan of the ended local, so the later read is OWN0019")
  let byReference = run Semantic.demandBody(&mut store, &mut request, &id, b"byReference")
  let byReferenceAlias = run Semantic.demandBody(&mut store, &mut request, &id, b"byReferenceAlias")
  let forwardedDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"forwardedDirect")
  let forwarded = run Semantic.demandBody(&mut store, &mut request, &id, b"forwarded")
  let throughField = run Semantic.demandBody(&mut store, &mut request, &id, b"throughField")
  run Testing.expect(rejectsFrom(&byReference, RejectionCode.ExpiredLifetime, offsetOf(text, "&slot)\n}\nfn byReferenceAlias", usize.ZERO))
      && rejectsFrom(&byReferenceAlias, RejectionCode.AccessDuringLoan, offsetOf(text, "count = 2\n  return read(&slot)\n}\nfn forwardedDirect", usize.ZERO)),
    "a closure lent to a call that may invoke it stores as an invocation does (OWN0019, OWN0011)")
  run Testing.expect(rejectsFrom(&forwardedDirect, RejectionCode.ExpiredLifetime, offsetOf(text, "&slot)\n}\nfn forwarded()", usize.ZERO))
      && rejectsFrom(&throughField, RejectionCode.ExpiredLifetime, offsetOf(text, "&slot)\n}\n", 8)),
    "a closure lent onward by the callee, or reached through a holder's field, stores the same way (OWN0019)")
  run Testing.expect(rejectsFrom(&forwarded, RejectionCode.ExpiredLifetime, offsetOf(text, "&slot)\n}\nfn throughField", usize.ZERO)),
    "a closure lent through a local reference stores as an invocation does (OWN0019)")
  let insideBlock = run Semantic.demandBody(&mut store, &mut request, &id, b"insideBlock")
  let onlyReads = run Semantic.demandBody(&mut store, &mut request, &id, b"onlyReads")
  let writesValue = run Semantic.demandBody(&mut store, &mut request, &id, b"writesValue")
  run Testing.expect(hasBorrowStatus(&insideBlock, BodyBorrowStatus.Checked),
    "a closure storing one capture's loan in another owes that relation to its creator, where a holder that ends first proves it, so the body is Checked")
  run Testing.expect(hasBorrowStatus(&onlyReads, BodyBorrowStatus.Checked) && hasBorrowStatus(&writesValue, BodyBorrowStatus.Checked),
    "a closure that stores no loan stays checked")
  return ()
}

// A callable whose contract or captures name a type parameter its callers choose cannot store a loan
// typed only at body regions through it. Regressions: leaving the borrow check unfinished for such
// a section or closure, accepting a store of a captured loan where another capture reaches, or
// keeping a universal loan stored through a conformance from escaping.
// Two body-local regions in an invariant position, as a `Plan<'a>` holding a collection of
// `Name<'a>` values appended to a let-bound collection of plans, meet by relating both ways; the
// region check still rejects a plan whose loan ends before the collection is used again (#2425).
test effect fn invariantLocalRegionsMeetAndStayChecked() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run invariantLocalRegionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn invariantLocalRegionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("invariant-local-regions.silk")
  let text = """
struct Name<'a> { text: &'a i32 }
struct Cell<T> { value: [*]mut T }
struct Plan<'a> { name: Name<'a>, names: Cell<Name<'a>> }
fn empty<T>() -> Cell<T> { return missing }
fn put<T>(cell: &mut Cell<T>, value: T) -> () { return () }
fn plan<'a>(text: &'a i32) -> Plan<'a> { return Plan { name: Name { text: text }, names: empty<Name<'a>>() } }
fn kept() -> () {
  let value = 1
  let mut plans = empty<Plan>()
  let made = plan(&value)
  put<Plan>(&mut plans, move made)
}
fn dangling() -> () {
  let mut plans = empty<Plan>()
  if true {
    let value = 1
    let made = plan(&value)
    put<Plan>(&mut plans, move made)
  }
  put<Plan>(&mut plans, plan(&2))
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let kept = run Semantic.demandBody(&mut store, &mut request, &id, b"kept")
  run Testing.expect(hasBorrowStatus(&kept, BodyBorrowStatus.Checked),
    "a plan of a body loan appended to a let-bound collection of plans checks")
  let dangling = run Semantic.demandBody(&mut store, &mut request, &id, b"dangling")
  run Testing.expect(rejectsSpan(&dangling, RejectionCode.ExpiredLifetime, text, "&mut plans", 2),
    "the collection is still rejected when the plan's loan ends before its next use")
  return ()
}

test effect fn genericCapturesStoreOnlyAtNamedRegions() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run genericCaptureStoreClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn genericCaptureStoreClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("generic-capture-store.silk")
  let text = """
union Maybe<T> { None, Some { value: T } }
struct Slot<'a> {
  view: Maybe<&'a i32>,
}
struct Token { value: i32 }
struct Box1 { t: Token }
struct Limits { most: usize }
interface Store<U> { fn put(slot: &mut Self, v: U) -> () }
fn some<'a>(value: &'a i32) -> Maybe<&'a i32> {
  return Maybe<&'a i32>.Some {value: value}
}
fn read<'a>(slot: &Slot<'a>) -> i32 {
  if let Maybe<&'a i32>.Some {value} = &slot.view { return value.* }
  return 0
}
fn within(limits: &Limits, count: usize) -> bool {
  return count <= limits.most
}
fn touch<T>(source: &mut T, target: &mut usize) -> () {
  target.* = target.* + 1
  return ()
}
fn apply<T>(value: &mut T, use: once fn(&mut T) -> ()) -> () {
  use(&mut value.*)
  return ()
}
fn keepG<H: Store<U>, U>(slot: &mut H, v: U) -> () {
  Store<U>.put(&mut slot.*, move v)
  return ()
}
fn sectionGeneric<T>(value: &mut T) -> usize {
  let mut count: usize = 0
  apply<T>(&mut value.*, touch<T>(&mut count))
  return count
}
fn closureGeneric<T>(value: &mut T) -> bool {
  let limits = Limits {most: 4}
  let check = fn(held: &mut T) -> bool { return within(&limits, 3) }
  return check(&mut value.*)
}
fn dangleGeneric<T>(marker: &T) -> i32 {
  let zero = 0
  let mut slot = Slot {view: some(&zero)}
  if true {
    let count = 41
    let mut f = fn(seen: &T) -> () { slot.view = some(&count) }
    f(marker)
  }
  return read(&slot)
}
fn escapeGeneric<'a: 'b, 'b, H: Store<&'b Token>>(src: &'a mut Box1, out: &mut H) -> () {
  let view: &'a Token = &src.t
  let f = fn(target: &mut H) -> () { keepG<H, &'b Token>(&mut target.*, view) }
  f(&mut out.*)
  src.t = Token { value: 9 }
  return ()
}
struct Pair<A, B> {
  first: Maybe<A>,
  second: Maybe<B>,
}
interface Keep<'k> { fn keep(self: &mut Self, v: &'k i32) -> () }
fn putSecond<A, B>(pair: &mut Pair<A, B>, value: B) -> () {
  pair.second = Maybe<B>.Some {value: move value}
  return ()
}
fn readSecond<A>(pair: &Pair<A, &i32>) -> i32 {
  if let Maybe<&i32>.Some {value} = &pair.second { return value.* }
  return 0
}
fn innerClosure<T>(seed: T) -> i32 {
  let zero = 0
  let mut pair = Pair<T, &i32> {first: Maybe<T>.Some {value: move seed}, second: Maybe<&i32>.Some {value: &zero}}
  if true {
    let count = 41
    let store = fn(p: &mut Pair<T, &i32>) -> () { putSecond<T, &i32>(&mut p.*, &count) }
    store(&mut pair)
  }
  return readSecond<T>(&pair)
}
fn innerSection<T>(seed: T) -> i32 {
  let zero = 0
  let mut pair = Pair<T, &i32> {first: Maybe<T>.Some {value: move seed}, second: Maybe<&i32>.Some {value: &zero}}
  if true {
    let count = 41
    let store = putSecond<T, &i32>(&count)
    store(&mut pair)
  }
  return readSecond<T>(&pair)
}
fn conformance<'k, T: Keep<'k>>(target: &mut T) -> () {
  let count = 41
  let f = fn(t: &mut T) -> () { t.keep(&count) }
  f(&mut target.*)
  return ()
}fn nested<T>(marker: &T) -> i32 {
  let zero = 0
  let mut slot = Slot {view: some(&zero)}
  if true {
    let count = 41
    let mut f = fn(seen: &T) -> () { slot.view = some(&count) }
    let mut g = fn(seen: &T) -> () { f(seen) }
    g(marker)
  }
  return read(&slot)
}
fn nestedAlias<T>(marker: &T) -> i32 {
  let zero = 0
  let mut count = 1
  let mut slot = Slot {view: some(&zero)}
  let mut f = fn(seen: &T) -> () { slot.view = some(&count) }
  let mut g = fn(seen: &T) -> () { f(seen) }
  g(marker)
  count = 2
  return read(&slot)
}
fn concrete(marker: &i32) -> i32 {
  let zero = 0
  let mut slot = Slot {view: some(&zero)}
  if true {
    let count = 41
    let mut f = fn() -> () { slot.view = some(&count) }
    let mut g = fn() -> () { let seen = marker.*  f() }
    g()
  }
  return read(&slot)
}
fn concreteAlias(marker: &i32) -> i32 {
  let zero = 0
  let mut count = 1
  let mut slot = Slot {view: some(&zero)}
  let mut f = fn() -> () { slot.view = some(&count) }
  let mut g = fn() -> () { let seen = marker.*  f() }
  g()
  count = 2
  return read(&slot)
}
struct Kept<'h> {
  view: &'h Token,
}
interface Keeps<'k> { fn put(slot: &mut Self, v: &'k Token) -> () }
impl<'k> Keeps<'k> for Kept<'k> {
  fn put(slot: &mut Self, v: &'k Token) -> () {
    slot.view = v
    return ()
  }
}
fn conformLocal<'b, H: Keeps<'b>>(out: &mut H) -> () {
  let local = Token { value: 1 }
  let mut f = fn() -> () { Keeps<'b>.put(&mut out.*, &local) }
  f()
  return ()
}
interface KeepsShared<'k> { fn put(slot: &Self, v: &'k Token) -> () }
impl<'k> KeepsShared<'k> for Kept<'k> {
  fn put(slot: &Self, v: &'k Token) -> () {
    return ()
  }
}
fn sharedLocal<'b, H: KeepsShared<'b>>(out: &H) -> () {
  let local = Token { value: 1 }
  let f = fn() -> () { KeepsShared<'b>.put(out, &local) }
  f()
  return ()
}
fn conformUniversal<'b, H: Keeps<'b>>(out: &mut H, kept: &'b Token) -> () {
  let mut f = fn() -> () { Keeps<'b>.put(&mut out.*, kept) }
  f()
  return ()
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let sectionGeneric = run Semantic.demandBody(&mut store, &mut request, &id, b"sectionGeneric")
  let closureGeneric = run Semantic.demandBody(&mut store, &mut request, &id, b"closureGeneric")
  run Testing.expect(hasBorrowStatus(&sectionGeneric, BodyBorrowStatus.Checked) && hasBorrowStatus(&closureGeneric, BodyBorrowStatus.Checked),
    "a generic section or closure capturing a body-local loan is checked")
  let dangleGeneric = run Semantic.demandBody(&mut store, &mut request, &id, b"dangleGeneric")
  run Testing.expect(rejectsSpan(&dangleGeneric, RejectionCode.ExpiredLifetime, text, "&slot", 1),
    "a generic closure storing a captured loan where another capture reaches still rejects (OWN0019)")
  let escapeGeneric = run Semantic.demandBody(&mut store, &mut request, &id, b"escapeGeneric")
  run Testing.expect(rejectsSpan(&escapeGeneric, RejectionCode.AccessDuringLoan, text, "src.t", 1),
    "a universal loan a generic closure can store through a conformance escapes (OWN0011)")
  // A body-local loan reaches no storage through a caller's type parameter: instantiating a generic
  // callee at a body reference type, or a conformance method on the parameter, needs a relation
  // between a body region and one the type names, which the closure body or typing refuses.
  let innerClosure = run Semantic.demandBody(&mut store, &mut request, &id, b"innerClosure")
  let innerSection = run Semantic.demandBody(&mut store, &mut request, &id, b"innerSection")
  let conformance = run Semantic.demandBody(&mut store, &mut request, &id, b"conformance")
  run Testing.expect(rejectsSpan(&innerClosure, RejectionCode.UnsatisfiedLifetimeBound, text, "&mut p.*", usize.ZERO)
      && rejectsSpan(&innerSection, RejectionCode.TypeMismatch, text, "&mut pair", 1)
      && rejectsSpan(&conformance, RejectionCode.TypeMismatch, text, "t.keep(&count)", usize.ZERO),
    "a generic callee instantiated at a body reference type, or a conformance on the parameter, cannot keep a body loan")
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested")
  let nestedAlias = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedAlias")
  run Testing.expect(rejectsFrom(&nested, RejectionCode.ExpiredLifetime, offsetOf(text, "&slot)\n}\nfn nestedAlias", usize.ZERO))
      && rejectsFrom(&nestedAlias, RejectionCode.AccessDuringLoan, offsetOf(text, "count = 2\n  return read(&slot)\n}\n", usize.ZERO)),
    "a generic closure that captures a storing closure keeps walking, so the stored loan still conflicts (OWN0019, OWN0011)")
  let concrete = run Semantic.demandBody(&mut store, &mut request, &id, b"concrete")
  let concreteAlias = run Semantic.demandBody(&mut store, &mut request, &id, b"concreteAlias")
  run Testing.expect(rejectsFrom(&concrete, RejectionCode.ExpiredLifetime, offsetOf(text, "&slot)\n}\nfn concreteAlias", usize.ZERO))
      && rejectsFrom(&concreteAlias, RejectionCode.AccessDuringLoan, offsetOf(text, "count = 2\n  return read(&slot)\n}\n", usize.ONE)),
    "a closure that captures a universal view and a storing closure keeps walking too (OWN0019, OWN0011)")
  let conformLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"conformLocal")
  let conformUniversal = run Semantic.demandBody(&mut store, &mut request, &id, b"conformUniversal")
  let sharedLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedLocal")
  run Testing.expect(rejectsSpan(&conformLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "local", 1)
      && rejectsSpan(&sharedLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "local", 3)
      && hasBorrowStatus(&conformUniversal, BodyBorrowStatus.Checked),
    "a closure passing a body loan to a conformance written at the caller's lifetime owes that lifetime at its capture (SEM0212); a caller's own view is Checked")
  return ()
}

test effect fn nestedLiteralsCloseOverTheirEnclosingLiteral() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run nestedLiteralClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nestedLiteralClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("nested-literal.silk")
  let text = """
struct Token { value: i32 }
struct Kept<'h> { view: &'h Token }
fn put<'k>(slot: &mut Kept<'k>, v: &'k Token) -> () {
  slot.view = v
  return ()
}
fn apply<'a>(slot: &mut Kept<'a>, f: for<'s> fn(&'s mut Kept<'a>) -> ()) -> () {
  f(&mut slot.*)
  return ()
}
fn nestedOk<'a>(slot: &mut Kept<'a>) -> () {
  apply<'a>(&mut slot.*, fn(held: &mut Kept<'a>) -> () {
    let look = fn(other: &mut i32) -> i32 { return other.* }
    let mut n = 1
    let x = look(&mut n)
  })
  return ()
}
fn nestedStoresLocal<'a>(slot: &mut Kept<'a>) -> () {
  apply<'a>(&mut slot.*, fn(held: &mut Kept<'a>) -> () {
    let mut inner = fn() -> () {
      let local = Token { value: 1 }
      put<'a>(&mut held.*, &local)
    }
    inner()
  })
  return ()
}
fn nestedStoresField<'a>(slot: &mut Kept<'a>) -> () {
  apply<'a>(&mut slot.*, fn(held: &mut Kept<'a>) -> () {
    let mut inner = fn() -> () {
      let local = Token { value: 1 }
      held.view = &local
    }
    inner()
  })
  return ()
}
fn applyAny(seed: &Token, f: for<'s, 'k> fn(&'s mut Kept<'k>) -> ()) -> () {
  let mut slot = Kept { view: seed }
  f(&mut slot)
  return ()
}
fn elidedEncloser<'a>(seed: &'a Token) -> () {
  applyAny(seed, fn(held: &mut Kept) -> () {
    let mut inner = fn() -> () {
      let local = Token { value: 1 }
      put(&mut held.*, &local)
    }
    inner()
  })
  return ()
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let nestedOk = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedOk")
  run Testing.expect(hasBorrowStatus(&nestedOk, BodyBorrowStatus.Checked),
    "a literal nested in another closes over the enclosing literal's lifetime parameters, as over a named body's")
  let nestedStoresLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedStoresLocal")
  let nestedStoresField = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedStoresField")
  run Testing.expect(rejectsSpan(&nestedStoresLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", usize.ZERO)
      && rejectsSpan(&nestedStoresField, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", usize.ONE),
    "a nested literal storing its own local where the enclosing literal's parameter reaches needs it to outlive that lifetime (SEM0212 at the borrow)")
  let elidedEncloser = run Semantic.demandBody(&mut store, &mut request, &id, b"elidedEncloser")
  run Testing.expect(rejectsSpan(&elidedEncloser, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 2),
    "an anonymous encloser's elided parameter lifetime is universal in its nested literal, so storing a local there is SEM0212 at the borrow")
  return ()
}

test effect fn anonymousBodyStoresOweTheirServiceLifetimes() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
