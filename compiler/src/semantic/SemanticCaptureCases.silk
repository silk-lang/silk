// A call's operands are its runtime arguments, so its region contract has no parameter for a
// static one: each operand meets its own parameter rather than every region of the call.
test effect fn staticArgumentsHaveNoContractParameter() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run staticArgumentContractClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn staticArgumentContractClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("static-argument-contracts.silk")
  let text = """
fn take<A>(static template: string<'static>, args: &A) -> () { return () }
pub fn temporary() -> () {
  take("t", &.{n: "lit"})
  return ()
}
fn pick<'a>(first: &'a i32, static at: i32, second: &i32) -> &'a i32 { return first }
pub fn picked() -> i32 {
  let kept = 2
  let mut local = 1
  let held = pick(&kept, 0, &local)
  local = 3
  return held.* + local
}
fn pickSecond<'a>(first: &i32, static at: i32, second: &'a i32) -> &'a i32 { return second }
pub fn escaped() -> i32 {
  let other = 2
  let mut spare = 1
  let held = pickSecond(&other, 0, &spare)
  spare = 3
  return held.* + spare
}
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let mut store = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.make()
  // The caller's selection supplies a static argument, so each caller is checked as selected.
  let temporaryRoot = run selectedApplicationOf(&mut index, &id, b"temporary")
  let temporary = run Semantic.demandSelectedBody(&mut store, &mut request, &temporaryRoot)
  run Testing.expect(hasBorrowStatus(&temporary, BodyBorrowStatus.Checked),
    "a borrowed temporary holding a 'static string beside a static argument need not be 'static")
  let pickedRoot = run selectedApplicationOf(&mut index, &id, b"picked")
  let picked = run Semantic.demandSelectedBody(&mut store, &mut request, &pickedRoot)
  run Testing.expect(hasBorrowStatus(&picked, BodyBorrowStatus.Checked),
    "an operand after a static argument meets its own parameter, which the result does not name")
  let escapedRoot = run selectedApplicationOf(&mut index, &id, b"escaped")
  let escaped = run Semantic.demandSelectedBody(&mut store, &mut request, &escapedRoot)
  run Testing.expect(rejectsSpan(&escaped, RejectionCode.AccessDuringLoan, text, "spare", 2),
    "an operand after a static argument whose parameter the result names stays lent while the result lives (OWN0011)")
  return ()
}

