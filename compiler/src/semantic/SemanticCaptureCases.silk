  let text = """
fn main() -> i32 {
  let base = 10
  let original = fn(first: i32, last: i32) -> i32 { return base + first + last }
  let next = original(2)
  return next(1)
}
"""
  return run stagedAnonymousClaims(text, CallableMode.Shared) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

