effect fn aggregateBorrowRegionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("aggregate-borrow-regions.silk")
  let text = """
struct Pair { left: i32, right: i32 }
struct View<'a, T> { value: &'a T }
struct Views<'a> { left: &'a i32, right: &'a i32 }
fn projected<'a>(source: &'a Pair) -> i32 {
  let view = View {value: &source.left}
  return view.value.*
}
fn generic<'a, T: Intrinsic.Copy>(source: &'a T) -> T {
  let view = View {value: &source.*}
  return view.value.*
}
fn combined<'a, 'b>(left: &'a i32, right: &'b i32) -> i32 {
  let view = Views {left: &left.*, right: &right.*}
  return view.left.* + view.right.*
}
fn requires<'a, 'b: 'a>(anchor: &'a i32, view: View<'b, i32>) -> i32 {
  return anchor.* + view.value.*
}
fn outlived<'a, 'b>(anchor: &'a i32, source: &'b Pair) -> i32 {
  let view = View {value: &source.left}
  return requires(anchor, move view)
}
fn conflict(source: &mut Pair) -> i32 {
  let view = View {value: &source.left}
  source.left = 2
  return view.value.*
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let projected = run Semantic.demandBody(&mut store, &mut request, &id, b"projected")
  let generic = run Semantic.demandBody(&mut store, &mut request, &id, b"generic")
  let combined = run Semantic.demandBody(&mut store, &mut request, &id, b"combined")
  let outlived = run Semantic.demandBody(&mut store, &mut request, &id, b"outlived")
  let conflict = run Semantic.demandBody(&mut store, &mut request, &id, b"conflict")
  run Testing.expect(hasBorrowStatus(&projected, BodyBorrowStatus.Checked),
    "aggregate inference keeps a projected borrow attached to its source-validity goal")
  run Testing.expect(hasBorrowStatus(&generic, BodyBorrowStatus.Checked),
    "inferring the aggregate referent type preserves the fresh borrow's source bound")
  run Testing.expect(hasBorrowStatus(&combined, BodyBorrowStatus.Checked),
    "the aggregate's complete set of retained sources satisfies every region requirement")
  run Testing.expect(hasBorrowStatus(&outlived, BodyBorrowStatus.Regions),
    "retagging an aggregate field cannot relate its parent to an unrelated universal")
  run Testing.expect(rejectsSpan(&conflict, RejectionCode.AccessDuringLoan, text, "source.left", 3),
    "an aggregate's retained source loan still rejects a conflicting write (OWN0011)")
  return ()
}

