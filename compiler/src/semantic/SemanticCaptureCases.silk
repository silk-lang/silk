}

effect fn staticAliasClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("static-loan-retention.silk")
  let text = """
struct View<'a> { item: &'a i32 }
fn identity(value: &'static i32) -> &'static i32 { return value }
fn independent(value: &i32) -> string<'static> { return "fixed" }
fn consume(value: string) -> i32 { return 1 }
fn direct(value: &'static mut i32) -> i32 {
  let view: &'static i32 = &value.*
  value.* = 2
  return view.*
}
fn called(input: &'static mut i32) -> i32 {
  let source: &'static i32 = &input.*
  let view = identity(source)
  input.* = 3
  return view.*
}
fn aggregate(source: &'static mut i32) -> i32 {
  let view = View<'static> { item: &source.* }
  source.* = 4
  return view.item.*
}
fn afterUse(value: &'static mut i32) -> i32 {
  let view: &'static i32 = &value.*
  let previous = view.*
  value.* = 5
  return previous
}
fn unrelated() -> i32 {
  let mut local = 1
  let text = independent(&local)
  local = 2
  return local + consume(text)
}
fn escapes() -> &'static i32 {
  let owned = 1
  return &owned
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let direct = run Semantic.demandBody(&mut store, &mut request, &id, b"direct")
  let called = run Semantic.demandBody(&mut store, &mut request, &id, b"called")
  let aggregate = run Semantic.demandBody(&mut store, &mut request, &id, b"aggregate")
  let afterUse = run Semantic.demandBody(&mut store, &mut request, &id, b"afterUse")
  let unrelated = run Semantic.demandBody(&mut store, &mut request, &id, b"unrelated")
  let escapes = run Semantic.demandBody(&mut store, &mut request, &id, b"escapes")
  run Testing.expect(rejectsSpan(&direct, RejectionCode.AccessDuringLoan, text, "value", 6),
    "static storage validity does not erase the shared loan's write restriction (OWN0011)")
  run Testing.expect(rejectsSpan(&called, RejectionCode.AccessDuringLoan, text, "input", 2),
    "a static-returning call preserves the source loan's restriction (OWN0011)")
  run Testing.expect(rejectsSpan(&aggregate, RejectionCode.AccessDuringLoan, text, "source", 4),
    "a static aggregate retains the loan of its shared field (OWN0011)")
  run Testing.expect(hasBorrowStatus(&afterUse, BodyBorrowStatus.Checked),
    "static validity does not extend a loan beyond the holder's final use")
  run Testing.expect(hasBorrowStatus(&unrelated, BodyBorrowStatus.Checked),
    "an independent static result cannot retain a loan of body-owned storage")
  run Testing.expect(rejectsSpan(&escapes, RejectionCode.ExpiredLifetime, text, "&owned", usize.ZERO),
    "tracking static aliases does not grant owned storage a static lifetime (OWN0019)")
  return ()
}


test effect fn reborrowResultsRetainTheirActualAncestors() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run parentRetentionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn parentRetentionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("parent-retention.silk")
  let text = """
struct Box { item: i32 }
fn container<'a>(value: &'a Box) -> &'a Box { return value }
fn item<'a>(value: &'a i32) -> &'a i32 { return value }
fn chain(value: &Box) -> i32 {
  let first = container(&value.*)
  let second = item(&first.item)
  return second.*
}
fn owned() -> i32 {
  let value = Box { item: 1 }
  let first = container(&value)
  let second = item(&first.item)
  return second.*
}
fn conflict(source: &mut Box) -> i32 {
  let first = container(&source.*)
  let second = item(&first.item)
  source.item = 2
  return second.*
}
fn afterUse(value: &mut Box) -> i32 {
  let first = container(&value.*)
  let second = item(&first.item)
  let old = second.*
  value.item = 3
  return old
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let chain = run Semantic.demandBody(&mut store, &mut request, &id, b"chain")
  let owned = run Semantic.demandBody(&mut store, &mut request, &id, b"owned")
  let conflict = run Semantic.demandBody(&mut store, &mut request, &id, b"conflict")
  let afterUse = run Semantic.demandBody(&mut store, &mut request, &id, b"afterUse")
  run Testing.expect(hasBorrowStatus(&chain, BodyBorrowStatus.Checked),
    "a returned child reborrow retains its actual ancestor without inventing unknown provenance")
  run Testing.expect(hasBorrowStatus(&owned, BodyBorrowStatus.Checked),
    "an owned ancestor remains bounded by its real finite storage lifetime")
  run Testing.expect(rejectsSpan(&conflict, RejectionCode.AccessDuringLoan, text, "source.item", usize.ZERO)
    || hasBorrowStatus(&conflict, BodyBorrowStatus.Imprecise),
    "a write conflicting with a possible retained ancestor cannot become Checked")
  run Testing.expect(hasBorrowStatus(&afterUse, BodyBorrowStatus.Checked),
    "retaining an ancestor does not extend it beyond the child's final use")
  return ()
}


test effect fn universalRegionsCoverFiniteFallibleOperands() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run universalFiniteClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn universalFiniteClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("universal-finite-goals.silk")
  let text = """
enum Trouble { Failed }
effect fn read(values: &[i32]) -> i32 ! Trouble { return values[0] }
effect fn consume(source: &mut i32, value: &i32, extra: i32) -> i32 ! Trouble {
  source.* = extra
  return value.*
}
effect fn nested(source: &mut i32) -> i32 ! Trouble {
  let word = 1
  return run consume(&mut source.*, &word, run read(&[2, 3]))
}
effect fn conflict(source: &mut i32) -> i32 ! Trouble {
  let word = 1
  let view = &source.*
  drop run consume(&mut source.*, &word, run read(&[2, 3]))
  return view.*
}
effect fn escapes(source: &mut i32) -> &'static i32 ! Trouble {
  let local = 1
  drop run consume(&mut source.*, &local, run read(&[2, 3]))
  return &local
}
fn unrelated<'a, 'b>(first: &'a i32, second: &'b i32) -> &'a i32 { return second }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested")
  let conflict = run Semantic.demandBody(&mut store, &mut request, &id, b"conflict")
  let escapes = run Semantic.demandBody(&mut store, &mut request, &id, b"escapes")
  let unrelated = run Semantic.demandBody(&mut store, &mut request, &id, b"unrelated")
  run Testing.expect(hasBorrowStatus(&nested, BodyBorrowStatus.Checked),
    "a universal source covers a finite call region despite sibling failure cleanup in its conservative intervals")
  run Testing.expect(rejectsSpan(&conflict, RejectionCode.LoanConflict, text, "&mut source.*", usize.ONE),
    "a universal-to-finite goal does not bypass the live shared loan's exclusive-borrow conflict")
  run Testing.expect(rejectsSpan(&escapes, RejectionCode.ExpiredLifetime, text, "&local", usize.ONE),
    "finite coverage does not extend owned storage to static")
  run Testing.expect(rejectsSpan(&unrelated, RejectionCode.ReturnTypeMismatch, text, "second", usize.ONE),
    "distinct universal regions still require a declared outlives premise")
  return ()
}


// Require every direct anonymous body, including the second sibling, to have the requested status.
fn allAnonymousStatuses(answer: &Shared<Result<Answer, NoRejection>>, expected: usize, status: BodyBorrowStatus) -> bool {
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: typed} = move body {
    return Shared<TypedBody>.with<bool>(&typed, fn(value: &TypedBody) -> bool {
      let nodes = TypedBody.nodeSlice(value)
      let mut at = usize.ZERO
      let mut count = usize.ZERO
      while at < nodes.length {
        if let BodyNodeKind.Expression {form: BodyExpression.Callable {body: anonymous, ..}, ..} = &nodes[at].kind {
          if Shared<TypedBody>.with<BodyBorrowStatus>(&anonymous, TypedBody.borrowStatus) != status { return false }
          count = count + usize.ONE
        }
        at = at + usize.ONE
      }
      return count == expected
    })
  }
  return false
}

test effect fn siblingCallableBindersNameOnlyTheirOwnContracts() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
