effect fn callableParameterInferenceClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("callable-parameter.silk")
  let text = """
fn apply<T, F: fn<'static>(T) -> T>(callback: F, value: T) -> T { return callback(move value) }
fn main() -> i32 {
  let base = 40
  let add = fn(value: i32) -> i32 { return base + value }
  return apply(add, 2)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller), "a callable argument infers its exact representation and signature type parameter")
  let selected = namedMirApplication(&store, &caller, b"apply")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move selected {
    let application = run SpecializationApplication.copyShared(&value)
    let target = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&target),
      "the monomorphized callable-valued parameter calls the original anonymous body directly")
    let nested = anonymousMirApplication(&store, &target)
    if let Option<Shared<SpecializationApplication>>.Some {value: original} = move nested {
      let literal = run SpecializationApplication.copyShared(&original)
      let implementation = run Semantic.demandApplicationMir(&mut store, &mut request, &literal)
      run Testing.expect(anonymousTargetParameter(&store, &implementation, CallableMode.Shared, 2),
        "the selected anonymous body keeps its exact environment and shared hidden parameter")
    } else { run Testing.expect(false, "the callable parameter retains a direct anonymous Function instance") }
    return ()
  }
  run Testing.expect(false, "the named caller retains the exact generic application")
}

