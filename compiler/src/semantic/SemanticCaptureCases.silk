effect fn r3ShelfGuardClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("r3-shelf-guard.silk")
  let text = """
struct Token { value: i32 }
struct Shelf<'b> { inner: &'b Token }
fn unshelve<'a, 'b>(outer: &'a Shelf<'b>) -> &'a Token { return outer.inner }
fn unshelveThenReplace() -> i32 {
  let mut held = Token {value: 1}
  let shelf = Shelf {inner: &held}
  let view = unshelve(&shelf)
  held = Token {value: 2}
  return view.value
}
fn unshelveThenMove() -> i32 {
  let held = Token {value: 1}
  let shelf = Shelf {inner: &held}
  let view = unshelve(&shelf)
  let moved = move held
  return view.value + moved.value
}
fn releasedBeforeReplace() -> i32 {
  let mut held = Token {value: 1}
  let shelf = Shelf {inner: &held}
  let view = unshelve(&shelf)
  let previous = view.value
  held = Token {value: 2}
  return previous + held.value
}
fn unrelated<'a, 'b>(outer: &'a Shelf<'b>) -> &'static [u8] { return b"ok" }
fn staticResultBeforeReplace() -> i32 {
  let mut held = Token {value: 1}
  let shelf = Shelf {inner: &held}
  let independent = unrelated(&shelf)
  held = Token {value: 2}
  if independent.length == 2 { return held.value }
  return 0
}
fn fromTwo<'r, 'a, 'b>(first: &'r Shelf<'a>, second: &'r Shelf<'b>) -> &'r Token { return first.inner }
fn twoRequiredSafe() -> i32 {
  let first = Token {value: 1}
  let second = Token {value: 2}
  let firstShelf = Shelf {inner: &first}
  let secondShelf = Shelf {inner: &second}
  let view = fromTwo(&firstShelf, &secondShelf)
  return view.value
}
fn twoRequiredConflict() -> i32 {
  let mut first = Token {value: 1}
  let second = Token {value: 2}
  let firstShelf = Shelf {inner: &first}
  let secondShelf = Shelf {inner: &second}
  let view = fromTwo(&firstShelf, &secondShelf)
  first = Token {value: 3}
  return view.value
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandBody(&mut store, &mut request, &id, b"unshelveThenReplace")
  run Testing.expect(rejectsSpan(&caller, RejectionCode.AccessDuringLoan, text, "held", 2),
    "Shelf's caller-side well-formedness requirement keeps the inner source loan live through the view")
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"unshelveThenMove")
  run Testing.expect(rejectsSpan(&moved, RejectionCode.AccessDuringLoan, text, "held", 5),
    "moving the required inner source while the result is live is OWN0011")
  let released = run Semantic.demandBody(&mut store, &mut request, &id, b"releasedBeforeReplace")
  run Testing.expect(hasBorrowStatus(&released, BodyBorrowStatus.Checked), "the required inner loan ends after the last view use")
  let independent = run Semantic.demandBody(&mut store, &mut request, &id, b"staticResultBeforeReplace")
  run Testing.expect(hasBorrowStatus(&independent, BodyBorrowStatus.Checked), "an unrelated static result does not extend the input's required loans")
  let several = run Semantic.demandBody(&mut store, &mut request, &id, b"twoRequiredSafe")
  run Testing.expect(hasBorrowStatus(&several, BodyBorrowStatus.Checked), "every required source is retained and proved for a shared call region")
  let ambiguous = run Semantic.demandBody(&mut store, &mut request, &id, b"twoRequiredConflict")
  run Testing.expect(hasBorrowStatus(&ambiguous, BodyBorrowStatus.Imprecise), "multiple possible input sources keep conflicts imprecise, never Checked")
  return ()
}

