! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run captureRepairClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn captureRepairClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("capture-repairs.silk")
  let text = """
struct Token { value: i32 }
struct Pair { left: Token right: Token }
fn repaired(value: i32) -> () {
  let mut rebuilt = value drop rebuilt rebuilt = 9
  let closure = fn() -> i32 { return rebuilt }
}
fn repairedField(value: Pair) -> () {
  let mut pair = move value drop pair.left pair.left = Token { value: 7 }
  let closure = fn() -> i32 { return pair.right.value }
}
fn terminated(source: Token, flag: bool) -> () {
  if flag { drop source return }
  let closure = fn() -> i32 { return source.value }
}
fn missingField(value: Pair) -> () {
  let mut incomplete = move value drop incomplete.left
  let closure = fn() -> i32 { return incomplete.right.value }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let repaired = run Semantic.demandBody(&mut store, &mut request, &id, b"repaired")
  let field = run Semantic.demandBody(&mut store, &mut request, &id, b"repairedField")
  let terminated = run Semantic.demandBody(&mut store, &mut request, &id, b"terminated")
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missingField")
  run Testing.expect(succeeded(&repaired) && succeeded(&field) && succeeded(&terminated),
    "complete replacement and exact field repair restore capture availability; returns do not join fallthrough")
  run Testing.expect(rejectsSpan(&missing, RejectionCode.UseAfterMove, text, "incomplete", 2),
    "a loan of a complete environment owner cannot retain a remaining partial hole")
}

fn retainedCaptureLoop(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut loopFound = false
  let mut continueFound = false
  let mut captureFound = false
  let mut at = usize.ZERO
  while at < nodes.length {
    match &nodes[at].kind {
      BodyNodeKind.While {..} => { loopFound = true }
      BodyNodeKind.Continue => { continueFound = true }
      BodyNodeKind.Expression {form: BodyExpression.Callable {..}, ..} => { captureFound = true }
      _ => {}
    }
    at = at + usize.ONE
  }
  return loopFound && continueFound && captureFound
}

fn captureLoopBody(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, bool>(&value, retainedCaptureLoop)
  }
  return false
}

fn captureIndexedLocal(node: &BodyNode, index: usize) -> bool {
  return match &node.kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} => local.index == index
    _ => false
  }
}

fn captureIndexedPlace(nodes: &[BodyNode], node: &BodyNode) -> bool {
  if let BodyNodeKind.Expression {form: BodyExpression.Index {value, index}, ..} = &node.kind {
    return value.index < nodes.length && index.index < nodes.length &&
      captureIndexedLocal(&nodes[value.index], usize.ZERO) && captureIndexedLocal(&nodes[index.index], usize.ONE)
  }
  return false
}

fn captureIndexedIteration(nodes: &[BodyNode], node: &BodyNode) -> bool {
  if let BodyNodeKind.Block {statements, ..} = &node.kind {
    let written = Vector.asSlice<BodyNodeId>(&statements)
    let mut assigned = false
    let mut repeated = false
    let mut at = usize.ZERO
    while at < written.length {
      let id = written[at]
      if id.index >= nodes.length { return false }
      if let BodyNodeKind.PlaceAssignment {target, ..} = &nodes[id.index].kind {
        if target.index >= nodes.length { return false }
        if captureIndexedPlace(nodes, &nodes[target.index]) { assigned = true }
        else if !captureIndexedLocal(&nodes[target.index], usize.ONE) { return false }
      }
      match &nodes[id.index].kind { BodyNodeKind.Continue => { repeated = true } _ => () }
      at = at + usize.ONE
    }
    return assigned && repeated
  }
  return false
}

fn initializedIndexedCaptureLoop(body: &TypedBody) -> bool {
  if !retainedCaptureLoop(body) || !borrowNotChecked(body) { return false }
  let nodes = TypedBody.nodeSlice(body)
  let mut assignment = false
  let mut capture = false
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.While {body: iteration, ..} = &nodes[at].kind {
      if iteration.index >= nodes.length || !captureIndexedIteration(nodes, &nodes[iteration.index]) { return false }
      assignment = true
    }
    if let BodyNodeKind.Expression {form: BodyExpression.Callable {fields, ..}, ..} = &nodes[at].kind {
      let captured = Vector.asSlice<BodyAggregateField>(&fields)
      if captured.length != usize.ONE || captured[usize.ZERO].value.index >= nodes.length { return false }
      if !captureIndexedLocal(&nodes[captured[usize.ZERO].value.index], 2) { return false }
      capture = true
    }
    at = at + usize.ONE
  }
  return assignment && capture
}

fn initializedIndexedBody(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, bool>(&value, initializedIndexedCaptureLoop)
  }
  return false
}

test effect fn anonymousCapturesKeepLoopAndIndexedProofs() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run captureLoopClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn captureLoopClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("capture-loop-paths.silk")
  let text = """
struct Token { value: i32 }
struct Pair { left: Token right: Token }
fn changedLoop(value: Pair, again: bool, repair: bool) -> () {
  let mut pair = move value drop pair.left
  while again { if repair { pair.left = Token { value: 1 } } continue }
  pair.left = Token { value: 2 }
  let closure = fn() -> i32 { return pair.right.value }
}
fn stableLoop(source: Token, again: bool) -> () {
  while again { let closure = fn() -> i32 { return source.value } continue }
}
fn destructured(value: Pair, again: bool) -> () {
  let Pair {left: first, right} = move value
  let mut token = move first
  while again { if again { token = Token { value: 1 } } }
  let closure = fn() -> i32 { return token.value }
}
fn indexed(value: [Token; 2]) -> () {
  let mut items = move value drop items[0]
  match &items[0] { Token { value: capturedIndexValue } => {
    let closure = fn() -> i32 { return capturedIndexValue }
  } }
}
fn unchanged(value: Pair, takeLeft: bool, again: bool) -> () {
  let pair = move value
  if takeLeft { drop pair.left }
  while again { let marker = 42 let closure = fn() -> i32 { return marker } continue }
}
fn absentAfter(value: Pair, takeLeft: bool, again: bool) -> () {
  let pair = move value
  if takeLeft { drop pair.left }
  while again { let marker = 42 let closure = fn() -> i32 { return marker } continue }
  let closure = fn() -> i32 { return pair.left.value }
}
fn consume(value: Token) -> i32 { return value.value }
fn restored(source: Token, again: bool) -> () {
  let mut current = move source
  while again {
    let consumed = consume(move current)
    current = Token { value: consumed }
    let marker = 42 let closure = fn() -> i32 { return marker }
    continue
  }
}
fn unknownRepair(value: [Token; 2], index: usize, again: bool) -> () {
  let mut items = move value drop items[0]
  while again { items[index] = Token { value: 1 } let marker = 42 let closure = fn() -> i32 { return marker } continue }
}
fn consumeCondition(value: Token) -> bool { return value.value == 0 }
fn falseExit(source: Token) -> () {
  let token = move source
  while consumeCondition(move token) { return () }
  let closure = fn() -> i32 { return token.value }
}
fn initializedIndexed() -> i32 {
  let mut bytes: [u8; 2] = [0, 0]
  let mut index: usize = 0
  let marker = 1
  let keep = fn() -> i32 { return marker }
  while index < 2 { bytes[index] = 0 index = index + 1 continue }
  return keep()
}
fn indexedTransfer(value: [Token; 2], index: usize, again: bool) -> () {
  let mut items = move value
  while again { items[index] = move items[0] let marker = 42 let closure = fn() -> i32 { return marker } continue }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let changed = run Semantic.demandBody(&mut store, &mut request, &id, b"changedLoop")
  let stable = run Semantic.demandBody(&mut store, &mut request, &id, b"stableLoop")
  let indexed = run Semantic.demandBody(&mut store, &mut request, &id, b"indexed")
  let destructured = run Semantic.demandBody(&mut store, &mut request, &id, b"destructured")
  let unchanged = run Semantic.demandBody(&mut store, &mut request, &id, b"unchanged")
  let absent = run Semantic.demandBody(&mut store, &mut request, &id, b"absentAfter")
  let restored = run Semantic.demandBody(&mut store, &mut request, &id, b"restored")
  let uncertain = run Semantic.demandBody(&mut store, &mut request, &id, b"unknownRepair")
  let condition = run Semantic.demandBody(&mut store, &mut request, &id, b"falseExit")
  let initialized = run Semantic.demandBody(&mut store, &mut request, &id, b"initializedIndexed")
  let transferred = run Semantic.demandBody(&mut store, &mut request, &id, b"indexedTransfer")
  run Testing.expect(initializedIndexedBody(&initialized),
    "a live owned array keeps its actual runtime-index assignment and scalar capture across a checked loop; borrowing remains NotChecked")
  run Testing.expect(rejectsSpan(&transferred, RejectionCode.CaptureAvailabilityUnavailable, text,
    "while again { items[index] = move items[0] let marker = 42 let closure = fn() -> i32 { return marker } continue }", usize.ZERO),
    "an unknown target cannot cleanse a missing component transferred by its own assignment RHS")
  run Testing.expect(captureLoopBody(&unchanged) && captureLoopBody(&restored),
    "an unchanged inexact header and consume/refill/continue retain checked loops and actual scalar captures")
  run Testing.expect(rejectsSpan(&absent, RejectionCode.UseAfterMove, text, "pair", 11),
    "preserving an inexact header never makes its maybe-missing field available to an environment")
  run Testing.expect(rejectsSpan(&uncertain, RejectionCode.CaptureAvailabilityUnavailable, text,
    "while again { items[index] = Token { value: 1 } let marker = 42 let closure = fn() -> i32 { return marker } continue }", usize.ZERO),
    "a newly uncertain indexed repair cannot preserve the loop header")
  run Testing.expect(rejectsSpan(&condition, RejectionCode.UseAfterMove, text, "token", 5),
    "even a false consuming condition leaves its outer owner unavailable after the loop")
  run Testing.expect(rejectsSpan(&changed, RejectionCode.IncompatibleLoopHeader, text,
    "while again { if repair { pair.left = Token { value: 1 } } continue }", usize.ZERO),
    "joining repair and unchanged continue paths cannot hide an incompatible loop header")
  run Testing.expect(succeeded(&stable), "a shared environment leaves every repeating ownership edge unchanged")
  run Testing.expect(succeeded(&destructured),
    "a destructuring let's subject root outlives the let, so a hole moved from its binding is unchanged by a loop")
  run Testing.expect(rejectsSpan(&indexed, RejectionCode.UseAfterMove, text, "items[0]", usize.ONE),
    "a pattern capture resolves its literal indexed parent place before checking missing elements")
}

fn capturedParameterRegion(value: &Lifetime, owner: &DeclarationId) -> bool {
  return match &value.* {
    Lifetime.Parameter {declaration, ordinal} => ordinal == usize.ZERO && DeclarationId.equals(&declaration, owner)
    _ => false
  }
}

fn oneCapturedParameter(environment: &Intersection, owner: &DeclarationId) -> bool {
  let members = Vector.asSlice<LifetimeMember>(&environment.members)
  return members.length == usize.ONE && Shared.with<Lifetime, bool>(&members[usize.ZERO].region,
    fn(value: &Lifetime) -> bool { return capturedParameterRegion(value, owner) })
}

fn capturedContractRegion(contract: &Type, owner: &DeclarationId) -> bool {
  if let Type.Callable {mode, environment, ..} = &contract.* {
    return mode == CallableMode.Shared && Shared.with<Intersection, bool>(&environment,
      fn(value: &Intersection) -> bool { return oneCapturedParameter(value, owner) })
  }
  return false
}

fn capturedFieldRegion(field: &Type, owner: &DeclarationId) -> bool {
  return match &field.* {
    Type.Reference {lifetime, ..} => Shared.with<Lifetime, bool>(&lifetime,
      fn(value: &Lifetime) -> bool { return capturedParameterRegion(value, owner) })
    Type.CallableValue {contract, ..} => Shared.with<Type, bool>(&contract,
      fn(value: &Type) -> bool { return capturedContractRegion(value, owner) })
    _ => false
  }
}

fn exactCapturedRegion(ty: &Type, owner: &DeclarationId) -> bool {
  if let Type.CallableValue {contract, captures, ..} = &ty.* {
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    return fields.length == usize.ONE && Shared.with<Type, bool>(&contract,
      fn(value: &Type) -> bool { return capturedContractRegion(value, owner) }) &&
      Shared.with<Type, bool>(&fields[usize.ZERO], fn(value: &Type) -> bool { return capturedFieldRegion(value, owner) })
  }
  return false
}

fn everyAnonymousRetainsSourceRegion(body: &TypedBody, expected: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let owner = TypedBody.declarationId(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Callable {..}} = &nodes[at].kind {
      if !Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool { return exactCapturedRegion(value, owner) }) { return false }
      found = found + usize.ONE
    }
    at = at + usize.ONE
  }
  return found == expected
}

fn anonymousRegionFacts(answer: &Result<Answer, NoRejection>, expected: usize) -> bool {
  if let Option<Shared<TypedBody>>.Some {value} = move checkedBody(answer) {
    return Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool { return everyAnonymousRetainsSourceRegion(body, expected) })
  }
  return false
}

test effect fn anonymousCallableDescriptorsKeepOriginalRegions() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run descriptorCaptureClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn descriptorCaptureClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("capture-descriptors.silk")
  let text = """
fn twice<'a>(view: &'a mut i32) -> () {
  let first = fn() -> i32 { return view.* }
  let second = fn() -> i32 { let copied = move first return copied() }
}
fn boundFailure(f: for<'x: 'static> fn<'static>(&'x i32) -> i32) -> i32 {
  let local = 1
  return f(&local)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let twice = run Semantic.demandBody(&mut store, &mut request, &id, b"twice")
  let invalid = run Semantic.demandBody(&mut store, &mut request, &id, b"boundFailure")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&twice,
    fn(answer: &Result<Answer, NoRejection>) -> bool { return anonymousRegionFacts(answer, 2) }),
    "copying a shared callable descriptor retains its source parameter region and Shared invocation even with an exclusive view capture")
  run Testing.expect(rejectsSpan(&invalid, RejectionCode.UnsatisfiedLifetimeBound, text, "f(&local)", usize.ZERO),
    "an invocation-local loan cannot prove a static bound, diagnosed at the complete call")
}

test effect fn anonymousCapturesCannotLaunderEndedStorage() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run captureReconstructionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn captureReconstructionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("capture-reconstruction.silk")
  let text = """
struct Token { value: i32 }
fn movedView<'a>(view: &'a mut i32) -> () {
  let moved = move view
  view.* = 1
  let closure = fn() -> i32 { return view.* }
}
fn copiedEnded(old: i32) -> () {
  drop old let fresh = old
  let closure = fn() -> i32 { return fresh }
}
fn movedEnded(token: Token) -> () {
  let mut owner = move token drop owner owner = move owner
  let closure = fn() -> i32 { return owner.value }
}
fn overlapping(token: Token) -> () {
  let mut held = move token held = move held
  let closure = fn() -> i32 { return held.value }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let view = run Semantic.demandBody(&mut store, &mut request, &id, b"movedView")
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copiedEnded")
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"movedEnded")
  let overlap = run Semantic.demandBody(&mut store, &mut request, &id, b"overlapping")
  run Testing.expect(rejectsSpan(&view, RejectionCode.UseAfterMove, text, "view", 2),
    "a referent write validates its descriptor and cannot revive moved view storage")
  run Testing.expect(rejectsSpan(&copied, RejectionCode.UseAfterMove, text, "old", 2) &&
    rejectsSpan(&moved, RejectionCode.UseAfterMove, text, "move owner", usize.ZERO),
    "a replacement or fresh binding cannot acquire a value from ended Copy or affine storage")
  run Testing.expect(rejectsSpan(&overlap, RejectionCode.OverlappingAssignment, text, "held = move held", usize.ZERO),
    "replacement cannot consume its own target, diagnosed on the assignment (OWN0004)")
}

test effect fn anonymousCaptureProofKeepsDropAndBorrowSpans() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run captureTerminationSpanClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn captureTerminationSpanClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("capture-termination-spans.silk")
  let text = """
struct Token { value: i32 }
fn repeatedDrop(endedToken: Token) -> () {
  drop endedToken drop endedToken
  let closure = fn() -> i32 { return endedToken.value }
}
fn endedBorrow(endedValue: i32) -> () {
  drop endedValue let fresh = &endedValue
  let closure = fn() -> i32 { return fresh.* }
}
fn endedViewBorrow<'a>(sourceView: &'a mut i32) -> () {
  let moved = move sourceView let fresh = &sourceView.*
  let closure = fn() -> i32 { return fresh.* }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let dropped = run Semantic.demandBody(&mut store, &mut request, &id, b"repeatedDrop")
  let borrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"endedBorrow")
  let viewed = run Semantic.demandBody(&mut store, &mut request, &id, b"endedViewBorrow")
  run Testing.expect(rejectsSpan(&dropped, RejectionCode.UseAfterMove, text, "drop endedToken", usize.ONE),
    "an ordinary repeated drop names the complete termination statement")
  run Testing.expect(rejectsSpan(&borrowed, RejectionCode.UseAfterMove, text, "&endedValue", usize.ZERO) &&
    rejectsSpan(&viewed, RejectionCode.UseAfterMove, text, "&sourceView.*", usize.ZERO),
    "a borrow reports the complete authored borrow, including a borrow through an ended descriptor")
}

test effect fn anonymousCaptureProofKeepsOwnedMatchSpans() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run captureMatchSpanClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn captureMatchSpanClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("capture-match-spans.silk")
  let text = """
struct Token { value: i32 }
fn endedMoveMatch(spent: Token) -> () {
  drop spent
  match move spent { Token { value } => { let closure = fn() -> i32 { return value } } }
}
fn endedPlaceMatch(inspected: Token) -> () {
  drop inspected
  match place inspected { Token { value } => { let closure = fn() -> i32 { return value } } }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let moved = run Semantic.demandBody(&mut store, &mut request, &id, b"endedMoveMatch")
  let inspected = run Semantic.demandBody(&mut store, &mut request, &id, b"endedPlaceMatch")
  run Testing.expect(rejectsSpan(&moved, RejectionCode.UseAfterMove, text,
    "match move spent { Token { value } => { let closure = fn() -> i32 { return value } } }", usize.ZERO) &&
    rejectsSpan(&inspected, RejectionCode.UseAfterMove, text,
    "match place inspected { Token { value } => { let closure = fn() -> i32 { return value } } }", usize.ZERO),
    "owned inspection or consumption of unavailable storage names the complete match")
}

fn nestedAnonymousCaptureFacts(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Callable {body: outer, ..}, ..} = &nodes[at].kind {
      return Shared.with<TypedBody, bool>(&outer, fn(value: &TypedBody) -> bool {
        return anonymousCaptureFacts(value, CallableMode.Shared, usize.ZERO, usize.MAX, usize.ONE, false)
      })
    }
    at = at + usize.ONE
  }
  return false
}

fn nestedAnonymousBodyFacts(answer: &Result<Answer, NoRejection>) -> bool {
  if let Option<Shared<TypedBody>>.Some {value} = move checkedBody(answer) {
    return Shared.with<TypedBody, bool>(&value, nestedAnonymousCaptureFacts)
  }
  return false
}

test effect fn anonymousNestedBodiesRetainTheirOwnCaptures() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run nestedAnonymousClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nestedAnonymousClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("nested-captures.silk")
  let text = "fn nested(seed: i32) -> () { let outer = fn() -> () { let inner = fn() -> i32 { return seed } } }"
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&nested, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Shared, usize.ZERO, usize.MAX, usize.ONE, false)
  }) && Shared.with<Result<Answer, NoRejection>, bool>(&nested, nestedAnonymousBodyFacts),
    "both ordinary anonymous bodies retain their own exact Copy capture of the lexical seed")
}

test effect fn anonymousBorrowedCallableCapturesRetainOneCleanupOwner() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run borrowedCallableCaptureClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn borrowedCallableCaptureClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("borrowed-callable-capture.silk")
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn take(token: Token) -> i32 { return token.value }
fn peek(callback: &once fn<'static>() -> i32) -> i32 { return 42 }
fn main() -> i32 {
  let token = Token { value: 40 }
  let inner = fn() -> i32 { return take(move token) }
  let outer = fn() -> i32 { return peek(&inner) }
  return outer()
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let source = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&source, checkedBody)
  let environment = match move selected {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, Option<Shared<Type>>>(&value, borrowedCallableCaptureBody)
    _ => Option.none<Shared<Type>>()
  }
  run Testing.expect(match &environment { Option<Shared<Type>>.Some {..} => true _ => false },
    "shared capture of an owned callable stores a loan and dereferences its environment alias")
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller) && borrowedCallableCaptureMir(&store, &caller)
    && glueFact(&store, &caller, usize.ZERO) == usize.ONE,
    "construction borrows the original callable place and leaves one environment cleanup owner")
  if let Option<Shared<Type>>.Some {value} = move environment {
  let sourceOwner = run glueSourceOwner(&mut store, &caller)
    let glue = run Semantic.demandGlueMir(&mut store, &mut request, &value, &sourceOwner)
    run Testing.expect(succeeded(&glue) && glueFact(&store, &glue, usize.ZERO) == usize.ZERO,
      "dropping the borrowing outer environment cannot drop the owned inner captures")
  }
}

fn ownedInnerCallable(value: &Type) -> bool {
  if let Type.CallableValue {contract, captures, ..} = &value.* {
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    return Shared.with<Type, CallableMode>(&contract, captureContractMode) == CallableMode.Once
      && fields.length == usize.ONE && Shared.with<Type, bool>(&fields[usize.ZERO], ownedCaptureToken)
  }
  return false
}

fn sharedInnerCallableLoan(value: &Type) -> bool {
  if let Type.Reference {access, referent, ..} = &value.* {
    return access == Access.Shared && Shared.with<Type, bool>(&referent, ownedInnerCallable)
  }
  return false
}

fn ownedCaptureToken(value: &Type) -> bool {
  return match &value.* {
    Type.Nominal {declaration, arguments, ..} => DeclarationId.named(&declaration, b"Token")
      && Vector.length<Argument>(&arguments) == usize.ZERO
    _ => false
  }
}

fn borrowedOuterCallable(value: &Type) -> bool {
  if let Type.CallableValue {contract, captures, ..} = &value.* {
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    return Shared.with<Type, CallableMode>(&contract, captureContractMode) == CallableMode.Shared
      && fields.length == usize.ONE && Shared.with<Type, bool>(&fields[usize.ZERO], sharedInnerCallableLoan)
  }
  return false
}

fn borrowedCallableAlias(body: &TypedBody) -> bool {
  let available = TypedBody.environmentOf(body)
  if let Option<BodyEnvironment>.Some {value} = &available.* {
    let fields = Vector.asSlice<BodyEnvironmentCapture>(&value.captures)
    return fields.length == usize.ONE && fields[usize.ZERO].dereference
  }
  return false
}

fn borrowedCallableCaptureBody(body: &TypedBody) -> Option<Shared<Type>> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Callable {fields, body: anonymous}} = &nodes[at].kind {
      if Shared.with<Type, bool>(&ty, borrowedOuterCallable) {
        let captured = Vector.asSlice<BodyAggregateField>(&fields)
        if captured.length != usize.ONE || !Shared.with<TypedBody, bool>(&anonymous, borrowedCallableAlias) {
          return Option.none<Shared<Type>>()
        }
        if let BodyNodeKind.Expression {ty: loan, form: BodyExpression.Borrow {access, value}} = &nodes[captured[usize.ZERO].value.index].kind {
          if access == Access.Shared && Shared.with<Type, bool>(&loan, sharedInnerCallableLoan) {
            if let BodyNodeKind.Expression {ty: owner, form: BodyExpression.Local {..}} = &nodes[value.index].kind {
              if Shared.with<Type, bool>(&owner, ownedInnerCallable) { return Option.some<Shared<Type>>(Shared.clone<Type>(&ty)) }
            }
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Type>>()
}

fn borrowedCallableCaptureMir(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      return borrowedCallableAggregate(function)
    }
  }
  return false
}

fn borrowedCallableAggregate(function: &MirFunction) -> bool {
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut statement = usize.ZERO
    while statement < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Aggregate {fields}, ..} = &statements[statement] {
        if Shared.with<Type, bool>(&locals[destination.local].ty, borrowedOuterCallable) {
          let captured = Vector.asSlice<MirAggregateField>(&fields)
          if captured.length != usize.ONE { return false }
          let source = borrowedCallableFieldLocal(&captured[usize.ZERO].value)
          return source != usize.MAX && Shared.with<Type, bool>(&locals[source].ty, sharedInnerCallableLoan)
            && borrowedCallableReference(function, source)
        }
      }
      statement = statement + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

fn borrowedCallableReference(function: &MirFunction, local: usize) -> bool {
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut statement = usize.ZERO
    while statement < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Ref {access, place}, ..} = &statements[statement] {
        if destination.local == local && access == Access.Shared && Vector.length<MirProjection>(&place.projections) == usize.ZERO {
          return borrowedCallableOriginalOwner(&locals[place.local])
        }
      }
      statement = statement + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

fn borrowedCallableOriginalOwner(local: &MirLocal) -> bool {
  if let MirLocalKind.User {index} = &local.kind {
    return index == usize.ONE && Shared.with<Type, bool>(&local.ty, ownedInnerCallable)
  }
  return false
}

fn firstCallableEnvironment(body: &TypedBody) -> Option<Shared<Type>> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Callable {..}} = &nodes[at].kind {
      return Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Type>>()
}

fn callableEnvironment(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match move checkedBody(answer) {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, Option<Shared<Type>>>(&value, firstCallableEnvironment)
    Option<Shared<TypedBody>>.None => Option.none<Shared<Type>>()
  }
}

fn paddedEnvironmentSmall(ty: &Type) -> bool { return witnessPrimitive(ty, b"u8") }

fn paddedEnvironmentWide(ty: &Type) -> bool { return witnessPrimitive(ty, b"i64") }

fn paddedEnvironmentRecord(record: &BackendLayout) -> bool {
  if let LayoutStorage.Record {fields} = &record.storage {
    let stored = Vector.asSlice<LayoutField>(&fields)
    return stored.length == 2 && stored[0].offset == usize.ZERO && stored[1].offset == 8
      && record.size == 16 && record.alignment == 8 && record.abi == LayoutAbi.Indirect
      && Shared.with<Type, bool>(&stored[0].ty, paddedEnvironmentSmall)
      && Shared.with<Type, bool>(&stored[1].ty, paddedEnvironmentWide)
  }
  return false
}

// Production layout demands must retain capture order and padding; a code/environment pointer
// pair, sorted capture fields, or a missing empty environment would fail these record claims.
test effect fn anonymousEnvironmentsUseCaptureOrderedRecords() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run anonymousEnvironmentLayoutClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn anonymousEnvironmentLayoutClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("environment-layout.silk")
  let text = """
fn padded(small: u8, wide: i64) -> () {
  let callable = fn() -> i64 { let observed = small return wide }
}
fn empty() -> () { let callable = fn() -> i32 { return 1 } }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let padded = run Semantic.demandBody(&mut store, &mut request, &id, b"padded")
  let empty = run Semantic.demandBody(&mut store, &mut request, &id, b"empty")
  let paddedType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&padded, callableEnvironment)
  let emptyType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&empty, callableEnvironment)
  let mut paddedRecord = false
  if let Option<Shared<Type>>.Some {value: ty} = move paddedType {
    // LLVM layout lookup compares exact environment handles, including a copy that shares the
    // cached runtime key. These comparisons must not take two loans of that shared buffer.
    let copied = run Shared.make<Type>(run Type.copy(&ty))
    let sameRuntime = run Type.runtimeEqualsShared(&ty, &ty)
    let copiedRuntime = run Type.runtimeEqualsShared(&ty, &copied)
    let copiedIdentity = run Type.equalsShared(&ty, &copied)
    run Testing.expect(sameRuntime && copiedRuntime && copiedIdentity, "closure identity comparison accepts aliased runtime keys")
    let demanded = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
    let selectedIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&demanded, selectedLayoutIndex)
    if let Option<usize>.Some {value: index} = move selectedIndex {
      if let Option<Shared<BackendLayout>>.Some {value: layout} = move Semantic.layoutAt(&store, index) {
        paddedRecord = Shared.with<BackendLayout, bool>(&layout, paddedEnvironmentRecord)
      }
    }
  }
  let mut emptyRecord = false
  if let Option<Shared<Type>>.Some {value: ty} = move emptyType {
    let demanded = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
    let selectedIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&demanded, selectedLayoutIndex)
    if let Option<usize>.Some {value: index} = move selectedIndex {
      if let Option<Shared<BackendLayout>>.Some {value: layout} = move Semantic.layoutAt(&store, index) {
        emptyRecord = Shared.with<BackendLayout, bool>(&layout, fn(record: &BackendLayout) -> bool {
          return match &record.storage {
            LayoutStorage.Record {fields} => Vector.length<LayoutField>(&fields) == usize.ZERO
              && record.size == usize.ZERO && record.alignment == usize.ONE && record.abi == LayoutAbi.Indirect
            _ => false
          }
        })
      }
    }
  }
  run Testing.expect(paddedRecord && emptyRecord, "exact environments are capture-ordered records, including an empty record")
  return ()
}

// Layout alone cannot prove ownership: environment glue must clean an owned field exactly once
// while a retained reference field never drops its referent.
test effect fn anonymousEnvironmentGlueCleansOwnedCaptures() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run anonymousEnvironmentGlueClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn anonymousEnvironmentGlueClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("environment-glue.silk")
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn owned(token: Token) -> () { let callable = fn() -> () { drop token } }
fn borrowed(token: Token) -> () { let callable = fn() -> i32 { return token.value } }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let owned = run Semantic.demandBody(&mut store, &mut request, &id, b"owned")
  let borrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowed")
  let ownedType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&owned, callableEnvironment)
  let borrowedType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&borrowed, callableEnvironment)
  let ownedOwner = run glueSourceOwner(&mut store, &owned)
  let borrowedOwner = run glueSourceOwner(&mut store, &borrowed)
  let mut ownedFields = false
  if let Option<Shared<Type>>.Some {value: ty} = move ownedType {
    let glue = run Semantic.demandGlueMir(&mut store, &mut request, &ty, &ownedOwner)
    ownedFields = glueFact(&store, &glue, usize.ZERO) == usize.ONE && glueFact(&store, &glue, 3) == usize.ZERO
      && glueFact(&store, &glue, usize.ONE) == usize.ZERO && glueFact(&store, &glue, 6) == usize.ONE
  }
  let mut borrowedFields = false
  if let Option<Shared<Type>>.Some {value: ty} = move borrowedType {
    let glue = run Semantic.demandGlueMir(&mut store, &mut request, &ty, &borrowedOwner)
    borrowedFields = succeeded(&glue) && glueFact(&store, &glue, usize.ZERO) == usize.ZERO
      && glueFact(&store, &glue, 6) == usize.ZERO
  }
  run Testing.expect(ownedFields && borrowedFields, "environment glue cleans each owned capture field and leaves borrowed referents live")
  return ()
}

fn anonymousMutableReceiverIsStored(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, value) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut statementAt = usize.ZERO
        while statementAt < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Ref {access: selected, place}, ..} = &statements[statementAt] {
            if selected == Access.Mutable && place.local == 2 && Vector.length<MirProjection>(&place.projections) == usize.ZERO { return true }
          }
          statementAt = statementAt + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

// These use production MIR demands and follow the retained ordinary Function reference. They
// distinguish each environment ABI mode without fresh native compilations or adapter fixtures.
effect fn anonymousDirectModeClaims(text: string, mode: CallableMode, count: usize) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("direct-closure.silk")
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let application = anonymousMirApplication(&store, &caller)
  run Testing.expect(succeeded(&caller), "closure construction and invocation lower to MIR")
  if mode == CallableMode.Mutable {
    run Testing.expect(anonymousMutableReceiverIsStored(&store, &caller), "mutable invocation borrows the original stored environment")
  }
  if mode == CallableMode.Once {
    run Testing.expect(glueFact(&store, &caller, usize.ZERO) == usize.ZERO,
      "once invocation transfers the environment and returned owner without caller cleanup")
  }
  if let Option<Shared<SpecializationApplication>>.Some {value} = move application {
    let exact = run SpecializationApplication.copyShared(&value)
    let target = run Semantic.demandApplicationMir(&mut store, &mut request, &exact)
    run Testing.expect(anonymousTargetParameter(&store, &target, mode, count),
      "the ordinary anonymous function receives its exact environment at parameter zero")
    if mode == CallableMode.Once {
      run Testing.expect(glueFact(&store, &target, usize.ZERO) == 2
        && glueFact(&store, &target, 3) == 2 && glueFact(&store, &target, 4) == usize.ONE,
        "each returning branch drops only the other owned capture and skips its moved capture")
    }
    return ()
  }
  run Testing.expect(false, "direct invocation retains an ordinary anonymous Function instance")
}

