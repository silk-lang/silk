effect fn reborrowSourceClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("reborrow-sources.silk")
  let text = """
struct Token { value: i32 }
impl Token { fn either<'a>(self: &'a Self, other: &'a Token) -> &'a Token { return other } }
struct Holder<'b> { r: &'b mut i32 }
struct SharedHolder<'b> { r: &'b i32 }
struct Owned { value: i32 }
struct OwnedHolder<'b> { r: &'b mut Owned }
struct Shelf<'b> { inner: &'b Token }
struct Loose<'a, 'b> { first: &'a i32, second: &'b i32 }
impl<'a, 'b: 'a> Loose<'a, 'b> {
  fn get(self: &Self) -> &'a i32 { return self.second }
  fn reborrowed(self: &Self) -> &'a i32 { let r = &self.second.* return r }
}
fn pick<'a>(left: &'a i32, right: &'a i32) -> &'a i32 { return right }
fn pickMut<'a>(left: &'a mut i32, right: &'a mut i32) -> &'a mut i32 { return move right }
fn second<T>(x: T, y: T) -> T { return move y }
fn pickMixed<'p, 'q>(x: &'p i32, y: &'q i32) -> &'p i32 { let r = pick(&x.*, y) return r }
fn pickReborrowed<'p, 'q>(x: &'p i32, y: &'q i32) -> &'p i32 { let r = pick(&x.*, y) let s = &r.* return s }
fn pickMutMixed<'p, 'q>(x: &'p mut i32, y: &'q mut i32) -> &'p mut i32 { let r = pickMut(&mut x.*, move y) return move r }
fn methodMixed<'p, 'q>(x: &'p Token, y: &'q Token) -> &'p Token { let r = x.either(y) return r }
fn genericMixed<'p, 'q>(x: &'p i32, y: &'q i32) -> &'p i32 { let r = second(&x.*, y) return move r }
effect fn effectMixed<'p, 'q>(x: &'p i32, y: &'q i32) -> &'p i32 { let r = pick(&x.*, y) return r }
fn pickBounded<'p, 'q: 'p>(x: &'p i32, y: &'q i32) -> &'p i32 { let r = pick(&x.*, y) return r }
fn mutField<'a, 'b>(h: &'a mut Holder<'b>) -> &'b mut i32 { let r = &mut h.r.* return move r }
fn mutFieldDirect<'a, 'b>(h: &'a mut Holder<'b>) -> &'b mut i32 { return &mut h.r.* }
fn ownedField<'a, 'b>(h: &'a mut OwnedHolder<'b>) -> &'b mut Owned { let r = &mut h.r.* return move r }
fn sharedOfMut<'a, 'b>(h: &'a Holder<'b>) -> &'b i32 { let r = &h.r.* return r }
fn sharedOutOfMut<'a, 'b>(h: &'a mut Holder<'b>) -> &'b i32 { let r = &h.r.* return r }
fn sharedField<'a, 'b>(h: &'a SharedHolder<'b>) -> &'b i32 { let r = &h.r.* return r }
fn mutFieldShorter<'a, 'b>(h: &'a mut Holder<'b>) -> &'a mut i32 { let r = &mut h.r.* return move r }
fn shelfInner<'a, 'b>(outer: &'a Shelf<'b>) -> &'a Token { let r = &outer.inner.* return r }
fn closureReborrow() -> i32 {
  let f = fn(x: &i32) -> &i32 { let r = &x.* return r }
  let v = 5
  return f(&v).*
}
effect fn effectCrossing<'a, 'b>(x: &'a i32, y: &'b i32) -> &'b i32 { let r = &y.* return r }
fn pick2<'a, 'b: 'a>(left: &'a i32, right: &'b i32) -> &'a i32 { return right }
fn pickMut2<'a, 'b: 'a>(left: &'a mut i32, right: &'b mut i32) -> &'a mut i32 { return move right }
struct Pair<'a, 'b: 'a> { first: &'a i32, second: &'b i32 }
fn secondOf<'a, 'b>(p: &Pair<'a, 'b>) -> &'a i32 { return p.second }
fn boundMixed<'p, 'q>(x: &'p i32, y: &'q i32) -> &'p i32 { let r = pick2(&x.*, y) return r }
fn boundMutMixed<'p, 'q>(x: &'p mut i32, y: &'q mut i32) -> &'p mut i32 { let r = pickMut2(&mut x.*, move y) return move r }
fn boundCovered<'p, 'q: 'p>(x: &'p i32, y: &'q i32) -> &'p i32 { let r = pick2(&x.*, y) return r }
fn pairMixed<'p, 'q>(x: &'p i32, y: &'q i32) -> &'p i32 { let pair = Pair {first: &x.*, second: y} let r = secondOf(&pair) return r }
fn pairUnbounded<'p, 'q>(x: &'p i32, y: &'q i32) -> &'p i32 { let pair = Pair {first: x, second: y} return secondOf(&pair) }
fn pairBounded<'p, 'q: 'p>(x: &'p i32, y: &'q i32) -> &'p i32 { let pair = Pair {first: x, second: y} return secondOf(&pair) }
struct Hold<'a, T: 'a> { r: &'a i32, t: T }
fn keepT<'a, T: 'a>(left: &'a i32, right: T) -> Hold<'a, T> { return Hold {r: left, t: move right} }
fn holdBare<'p, T>(x: &'p i32, y: T) -> Hold<'p, T> { let h = keepT(&x.*, move y) return move h }
fn holdCovered<'p, 'q, T: 'q>(x: &'p i32, y: T) -> Hold<'p, T> { let h = keepT(&x.*, move y) return move h }
fn holdLiteral<'p, T>(x: &'p i32, y: T) -> Hold<'p, T> { let h = Hold {r: &x.*, t: move y} return move h }
fn holdDeclared<'p, T: 'p>(x: &'p i32, y: T) -> Hold<'p, T> { let h = keepT(&x.*, move y) return move h }
fn holdLocals() -> i32 { let a = 1 let b = 2 let h = Hold {r: &a, t: &b} return h.r.* + h.t.* }
fn holdLocalAndParam<'p>(x: &'p i32) -> i32 { let b = 2 let h = Hold {r: x, t: &b} return h.t.* }
struct FieldView<'a> { left: &'a Token }
struct FieldPair<'a> { items: [&'a Token; 2] }
fn widenView<'a, 'b: 'a>(value: &'b Token) -> &'a Token { return value }
fn sameView<'a>(value: &'a Token) -> &'a Token { return value }
fn wrapView<'a>(value: &'a Token) -> FieldView<'a> { return FieldView { left: value } }
fn storeWidened<'s>(out: &mut FieldView<'s>) -> () { let owned = Token { value: 3 } out.left = widenView(&owned) }
fn storeSame<'s>(out: &mut FieldView<'s>) -> () { let owned = Token { value: 3 } out.left = sameView(&owned) }
fn storeBound<'s>(out: &mut FieldView<'s>) -> () { let owned = Token { value: 3 } let held = sameView(&owned) out.left = held }
fn storeWrapped<'s>(out: &mut FieldView<'s>) -> () { let owned = Token { value: 3 } out.* = wrapView(&owned) }
fn storeIndexed<'s>(out: &mut FieldPair<'s>) -> () { let owned = Token { value: 3 } out.items[0] = sameView(&owned) }
fn storeParam<'s>(out: &mut FieldView<'s>, given: &'s Token) -> () { out.left = sameView(given) }
fn keepLocalView() -> i32 { let owned = Token { value: 3 } let held = sameView(&owned) let view = FieldView { left: held } return view.left.value }
fn storeExplicitRecord<'s>(out: &mut FieldView<'s>) -> () { let owned = Token { value: 3 } out.* = FieldView<'s> { left: widenView<'s>(&owned) } }
fn storeExplicitField<'s>(out: &mut FieldView<'s>) -> () { let owned = Token { value: 3 } out.left = widenView<'s>(&owned) }
fn storeLiteral<'s>(out: &mut FieldView<'s>) -> () { let owned = Token { value: 3 } out.* = FieldView { left: &owned } }
fn storeInferredRecord<'s>(out: &mut FieldView<'s>) -> () { let owned = Token { value: 3 } out.* = FieldView { left: sameView(&owned) } }
fn makeOwned() -> Token { return Token { value: 3 } }
fn storeTemporaryCall<'s>(out: &mut FieldView<'s>) -> () { out.left = sameView(&makeOwned()) }
fn storeTemporaryLiteral<'s>(out: &mut FieldView<'s>) -> () { out.left = widenView(&Token { value: 7 }) }
fn storeOverwrittenHolder<'s>(out: &mut FieldView<'s>, given: &'s Token) -> () { let owned = Token { value: 3 } let mut held = FieldView { left: given } held.left = sameView(&owned) let n = held.left.value held = FieldView { left: given } out.* = move held }
fn holderStaysLocal<'s>(out: &mut FieldView<'s>, given: &'s Token) -> i32 { let owned = Token { value: 3 } let mut held = FieldView { left: given } held.left = sameView(&owned) return held.left.value }
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let mut store = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.make()
  // A value entering a call region without a loan must reach the target too (review a1, x1,
  // a12, a17, a18, e1, d7).
  let pickMixed = run Semantic.demandBody(&mut store, &mut request, &id, b"pickMixed")
  run Testing.expect(rejectsFrom(&pickMixed, RejectionCode.UnsatisfiedLifetimeBound, offsetOf(text, "r }\nfn pickReborrowed", usize.ZERO)),
    "a passed reference sharing a call region with a fresh borrow does not prove the fresh borrow's target")
  let pickReborrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"pickReborrowed")
  run Testing.expect(rejectsFrom(&pickReborrowed, RejectionCode.UnsatisfiedLifetimeBound, offsetOf(text, "s }\nfn pickMutMixed", usize.ZERO)),
    "a reborrow of the mixed call result inherits the unproved source")
  let pickMutMixed = run Semantic.demandBody(&mut store, &mut request, &id, b"pickMutMixed")
  run Testing.expect(rejectsFrom(&pickMutMixed, RejectionCode.UnsatisfiedLifetimeBound, offsetOf(text, "move r }\nfn methodMixed", usize.ZERO)),
    "a forwarded exclusive reference sharing the call region is not proved for the other target")
  let methodMixed = run Semantic.demandBody(&mut store, &mut request, &id, b"methodMixed")
  run Testing.expect(rejectsFrom(&methodMixed, RejectionCode.UnsatisfiedLifetimeBound, offsetOf(text, "r }\nfn genericMixed", usize.ZERO)),
    "a receiver auto-borrow does not prove an argument sharing its region")
  let genericMixed = run Semantic.demandBody(&mut store, &mut request, &id, b"genericMixed")
  run Testing.expect(rejectsFrom(&genericMixed, RejectionCode.UnsatisfiedLifetimeBound, offsetOf(text, "move r }\neffect fn effectMixed", usize.ZERO)),
    "a type parameter instantiated with both references does not prove either target")
  let effectMixed = run Semantic.demandBody(&mut store, &mut request, &id, b"effectMixed")
  run Testing.expect(rejectsFrom(&effectMixed, RejectionCode.UnsatisfiedLifetimeBound, offsetOf(text, "r }\nfn pickBounded", usize.ZERO)),
    "an Effect body proves the mixed call region no more than a function")
  let pickBounded = run Semantic.demandBody(&mut store, &mut request, &id, b"pickBounded")
  run Testing.expect(hasBorrowStatus(&pickBounded, BodyBorrowStatus.Checked),
    "a declared bound proves the passed reference's region for the target")
  // A reborrow through several descriptors is bounded by each of them (review c6, c6b, c6c,
  // c6d, x2, x3, x4).
  let mutField = run Semantic.demandBody(&mut store, &mut request, &id, b"mutField")
  run Testing.expect(rejectsFrom(&mutField, RejectionCode.UnsatisfiedLifetimeBound, offsetOf(text, "move r }\nfn mutFieldDirect", usize.ZERO)),
    "an exclusive reborrow through a shorter exclusive reference cannot have the inner lifetime")
  let mutFieldDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"mutFieldDirect")
  run Testing.expect(rejectsSpan(&mutFieldDirect, RejectionCode.UnsatisfiedLifetimeBound, text, "&mut h.r.*", usize.ONE),
    "a directly returned exclusive reborrow is bounded by the outer reference")
  let ownedField = run Semantic.demandBody(&mut store, &mut request, &id, b"ownedField")
  run Testing.expect(rejectsFrom(&ownedField, RejectionCode.UnsatisfiedLifetimeBound, offsetOf(text, "move r }\nfn sharedOfMut", usize.ZERO)),
    "an exclusive reborrow of an owning referent is bounded by the outer reference")
  let sharedOfMut = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedOfMut")
  run Testing.expect(rejectsFrom(&sharedOfMut, RejectionCode.UnsatisfiedLifetimeBound, offsetOf(text, "r }\nfn sharedOutOfMut", usize.ZERO)),
    "a shared reborrow of an exclusive referent behind a shared reference has the outer lifetime")
  let sharedOutOfMut = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedOutOfMut")
  run Testing.expect(rejectsFrom(&sharedOutOfMut, RejectionCode.UnsatisfiedLifetimeBound, offsetOf(text, "r }\nfn sharedField", usize.ZERO)),
    "a shared reborrow through an exclusive chain has the outer lifetime")
  let sharedField = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedField")
  run Testing.expect(hasBorrowStatus(&sharedField, BodyBorrowStatus.Checked),
    "a shared reborrow of a shared descriptor keeps its own lifetime")
  let mutFieldShorter = run Semantic.demandBody(&mut store, &mut request, &id, b"mutFieldShorter")
  run Testing.expect(hasBorrowStatus(&mutFieldShorter, BodyBorrowStatus.Checked),
    "an exclusive reborrow is proved for the outer reference's lifetime")
  let shelfInner = run Semantic.demandBody(&mut store, &mut request, &id, b"shelfInner")
  run Testing.expect(hasBorrowStatus(&shelfInner, BodyBorrowStatus.Checked),
    "a shared reborrow through shared references is proved for the outer lifetime")
  let closureReborrow = run Semantic.demandBody(&mut store, &mut request, &id, b"closureReborrow")
  run Testing.expect(hasBorrowStatus(&closureReborrow, BodyBorrowStatus.Checked),
    "a closure's parameter reborrow stays proved")
  let effectCrossing = run Semantic.demandBody(&mut store, &mut request, &id, b"effectCrossing")
  run Testing.expect(hasBorrowStatus(&effectCrossing, BodyBorrowStatus.Checked),
    "an Effect body's reborrow of its own parameter stays proved")
  // Every member call proves an inherent implementation's bound (`inherentImplBoundsAreProvedAtEachCall`),
  // so the bound is a premise of each member's region and reborrow proofs (review b1, b2v).
  let get = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"get", usize.ZERO)
  let getBody = run Semantic.demandBodyOf(&mut store, &mut request, &get)
  run Testing.expect(hasBorrowStatus(&getBody, BodyBorrowStatus.Checked),
    "a conversion an inherent implementation's bound implies is proved from that bound, which every caller proves")
  let reborrowed = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"reborrowed", usize.ZERO)
  let reborrowedBody = run Semantic.demandBodyOf(&mut store, &mut request, &reborrowed)
  run Testing.expect(hasBorrowStatus(&reborrowedBody, BodyBorrowStatus.Checked),
    "an inherent implementation's bound is a premise of a member's reborrow proof")
  // A callee or struct bound proved only because a caller region encloses a fresh loan still
  // makes its longer side a source of that loan's region (review y1, y2, y5).
  let boundMixed = run Semantic.demandBody(&mut store, &mut request, &id, b"boundMixed")
  run Testing.expect(rejectsFrom(&boundMixed, RejectionCode.UnsatisfiedLifetimeBound, offsetOf(text, "r }\nfn boundMutMixed", usize.ZERO)),
    "a callee bound into a fresh borrow's call region does not prove that borrow's target")
  let boundMutMixed = run Semantic.demandBody(&mut store, &mut request, &id, b"boundMutMixed")
  run Testing.expect(rejectsFrom(&boundMutMixed, RejectionCode.UnsatisfiedLifetimeBound, offsetOf(text, "move r }\nfn boundCovered", usize.ZERO)),
    "an exclusive reference forwarded through a callee bound is not proved for the other target")
  let boundCovered = run Semantic.demandBody(&mut store, &mut request, &id, b"boundCovered")
  run Testing.expect(hasBorrowStatus(&boundCovered, BodyBorrowStatus.Checked),
    "a declared bound proves the callee bound's source for the target")
  let pairMixed = run Semantic.demandBody(&mut store, &mut request, &id, b"pairMixed")
  run Testing.expect(rejectsFrom(&pairMixed, RejectionCode.UnsatisfiedLifetimeBound, offsetOf(text, "r }\nfn pairUnbounded", usize.ZERO)),
    "a struct bound into a fresh borrow's region does not prove that borrow's target")
  // Construction holds a struct's declared region bounds, which its readers assume (review y3): the
  // read that needs the caller's regions related reports what they do not prove, as rustc does.
  let pairUnbounded = run Semantic.demandBody(&mut store, &mut request, &id, b"pairUnbounded")
  run Testing.expect(rejectsSpan(&pairUnbounded, RejectionCode.UnsatisfiedLifetimeBound, text, "secondOf(&pair)", usize.ONE),
    "building a struct whose declared region bound does not hold reports SEM0212 at the aggregate")
  let pairBounded = run Semantic.demandBody(&mut store, &mut request, &id, b"pairBounded")
  let secondOf = run Semantic.demandBody(&mut store, &mut request, &id, b"secondOf")
  run Testing.expect(hasBorrowStatus(&pairBounded, BodyBorrowStatus.Checked) && hasBorrowStatus(&secondOf, BodyBorrowStatus.Checked),
    "a declared bound proves the struct's bound at construction, and a reader assumes it")
  // A contents bound the result type `Hold<'p, T>` implies (`T: 'p`) is a premise of the body, so a
  // callee or literal bound on a fresh loan's region holds (review h1, h2, h5).
  let holdBare = run Semantic.demandBody(&mut store, &mut request, &id, b"holdBare")
  run Testing.expect(hasBorrowStatus(&holdBare, BodyBorrowStatus.Checked),
    "a type parameter's contents bound the result type implies is a premise, so the callee's bound holds at the call")
  let holdCovered = run Semantic.demandBody(&mut store, &mut request, &id, b"holdCovered")
  run Testing.expect(hasBorrowStatus(&holdCovered, BodyBorrowStatus.Checked),
    "an unrelated declared contents bound does not hide the one the result type implies")
  let holdLiteral = run Semantic.demandBody(&mut store, &mut request, &id, b"holdLiteral")
  run Testing.expect(hasBorrowStatus(&holdLiteral, BodyBorrowStatus.Checked),
    "a struct literal's contents bound on a type parameter holds by the bound the result type implies")
  let holdDeclared = run Semantic.demandBody(&mut store, &mut request, &id, b"holdDeclared")
  run Testing.expect(hasBorrowStatus(&holdDeclared, BodyBorrowStatus.Checked),
    "a premise for the target itself proves the contents bound's source")
  // Contents between body loans are chosen by the borrow checker (review h10v, h11v, h13v).
  let holdLocals = run Semantic.demandBody(&mut store, &mut request, &id, b"holdLocals")
  run Testing.expect(hasBorrowStatus(&holdLocals, BodyBorrowStatus.Checked),
    "a contents bound between two body loans is proved by the borrow checker")
  let holdLocalAndParam = run Semantic.demandBody(&mut store, &mut request, &id, b"holdLocalAndParam")
  run Testing.expect(hasBorrowStatus(&holdLocalAndParam, BodyBorrowStatus.Checked),
    "a body loan's contents bound against a parameter region holds at the literal's fresh region")
  // A call result written into caller storage carries its argument's loan: a loan of storage the
  // body owns whose region must outlive the caller's region is SEM0212 at the borrow (#1831).
  let storeWidened = run Semantic.demandBody(&mut store, &mut request, &id, b"storeWidened")
  let storeSame = run Semantic.demandBody(&mut store, &mut request, &id, b"storeSame")
  let storeBound = run Semantic.demandBody(&mut store, &mut request, &id, b"storeBound")
  let storeWrapped = run Semantic.demandBody(&mut store, &mut request, &id, b"storeWrapped")
  let storeIndexed = run Semantic.demandBody(&mut store, &mut request, &id, b"storeIndexed")
  run Testing.expect(rejectsSpan(&storeWidened, RejectionCode.UnsatisfiedLifetimeBound, text, "&owned", 0)
      && rejectsSpan(&storeSame, RejectionCode.UnsatisfiedLifetimeBound, text, "&owned", 1)
      && rejectsSpan(&storeBound, RejectionCode.UnsatisfiedLifetimeBound, text, "&owned", 2)
      && rejectsSpan(&storeWrapped, RejectionCode.UnsatisfiedLifetimeBound, text, "&owned", 3)
      && rejectsSpan(&storeIndexed, RejectionCode.UnsatisfiedLifetimeBound, text, "&owned", 4),
    "a body loan a widening, identity, let-bound, wrapping or indexed call result stores in caller storage is SEM0212")
  let storeParam = run Semantic.demandBody(&mut store, &mut request, &id, b"storeParam")
  let keepLocalView = run Semantic.demandBody(&mut store, &mut request, &id, b"keepLocalView")
  run Testing.expect(succeeded(&storeParam) && succeeded(&keepLocalView),
    "a caller view stored through a call, and a body loan that stays in body storage, are accepted")
  let storeExplicitRecord = run Semantic.demandBody(&mut store, &mut request, &id, b"storeExplicitRecord")
  let storeExplicitField = run Semantic.demandBody(&mut store, &mut request, &id, b"storeExplicitField")
  let storeLiteral = run Semantic.demandBody(&mut store, &mut request, &id, b"storeLiteral")
  let storeInferredRecord = run Semantic.demandBody(&mut store, &mut request, &id, b"storeInferredRecord")
  run Testing.expect(rejectsSpan(&storeExplicitRecord, RejectionCode.UnsatisfiedLifetimeBound, text, "&owned", 6)
      && rejectsSpan(&storeExplicitField, RejectionCode.UnsatisfiedLifetimeBound, text, "&owned", 7)
      && rejectsSpan(&storeLiteral, RejectionCode.UnsatisfiedLifetimeBound, text, "&owned", 8)
      && rejectsSpan(&storeInferredRecord, RejectionCode.UnsatisfiedLifetimeBound, text, "&owned", 9),
    "a body loan stored in caller storage through an explicitly instantiated call, a literal, or an inferred literal of a call is SEM0212")
  // A temporary ends with its statement, and a local has one region, so a borrow of a temporary, or
  // a borrow written into a local whose value caller storage receives, cannot outlive the caller's
  // region either (review b12, b48, d04).
  let storeTemporaryCall = run Semantic.demandBody(&mut store, &mut request, &id, b"storeTemporaryCall")
  let storeTemporaryLiteral = run Semantic.demandBody(&mut store, &mut request, &id, b"storeTemporaryLiteral")
  let storeOverwrittenHolder = run Semantic.demandBody(&mut store, &mut request, &id, b"storeOverwrittenHolder")
  run Testing.expect(rejectsSpan(&storeTemporaryCall, RejectionCode.UnsatisfiedLifetimeBound, text, "&makeOwned()", 0)
      && rejectsSpan(&storeTemporaryLiteral, RejectionCode.UnsatisfiedLifetimeBound, text, "&Token { value: 7 }", 0)
      && rejectsSpan(&storeOverwrittenHolder, RejectionCode.UnsatisfiedLifetimeBound, text, "&owned", 10),
    "a borrowed temporary, or a borrow written into a local that caller storage later receives, stored at a caller region is SEM0212")
  let holderStaysLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"holderStaysLocal")
  run Testing.expect(succeeded(&holderStaysLocal),
    "a borrow written into a local that never reaches caller storage is accepted")
  return ()
}

// An inherent member of a generic owner, such as `Option.some`, is typed against its owner's type
// arguments, so the caller's own lifetimes reach its signature; they are not lifetimes the
// implementation declares, and a borrow through a parameter it returns stays Checked. A borrow of a
// local stored where its instantiation reaches is rejected: returned, put through an inherent
// `&mut Self` member or an interface operation, or carried in an instantiation `Holder<'c>`. A
// returned value reaches the caller typed at its lifetime parameters, so a local borrow that typing
// requires to outlive one of them inside a returned call is SEM0212 at the borrow; one passed only
// to an inner call whose result retains no region never reaches the returned value.
test effect fn keptInstantiationsOfCallerLifetimes() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("kept-instantiations.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Maybe<T> { Empty, Some { value: T } }
impl<T> Maybe<T> {
  fn some(value: T) -> Maybe<T> { return Maybe.Some { value: move value } }
}
struct Pair {
  x: i32,
  y: i32,
}
union Kind { A { pair: Pair }, B }
struct Cell<T> { held: T }
impl<T> Cell<T> {
  fn put(self: &mut Self, v: T) -> () {
    self.held = move v
    return ()
  }
}
interface Store<U> { fn store(slot: &mut Self, v: U) -> () }
impl<T> Store<T> for Cell<T> {
  fn store(slot: &mut Self, v: T) -> () {
    slot.held = move v
    return ()
  }
}
struct Holder<'c> { view: &'c i32 }
impl<'x> Holder<'x> {
  fn keep(self: &mut Self, v: &'x i32) -> () {
    self.view = v
    return ()
  }
  fn make(v: &'x i32) -> Holder<'x> { return Holder<'x> { view: v } }
}
fn wrap<T>(value: T) -> Maybe<T> { return Maybe<T>.Some { value: move value } }
fn ident<'x>(v: &'x i32) -> &'x i32 { return v }
fn first<'x>(v: &'x i32, other: &i32) -> &'x i32 { return v }
fn former<'x, 'y>(v: &'x i32, other: &'y i32) -> &'x i32 { return v }
fn lengthOf<'y>(v: &'y i32) -> i32 { return v.* }
fn either<'x>(v: &'x i32, other: &'x i32) -> &'x i32 { return v }
fn counted<'x>(v: &'x i32, n: i32) -> &'x i32 { return v }
fn someParameter<'a>(v: &'a Pair) -> Maybe<&'a i32> { return Maybe<&'a i32>.some(&v.x) }
fn someMatched<'a>(k: &'a Kind) -> Maybe<&'a i32> {
  return match &k.* {
    Kind.A { pair } => Maybe<&'a i32>.some(&pair.x)
    Kind.B => Maybe<&'a i32>.Empty
  }
}
fn someLocal<'a>(v: &'a Pair) -> Maybe<&'a i32> { let local = 3  return Maybe<&'a i32>.some(&local) }
fn putLocal<'a>(cell: &mut Cell<&'a i32>) -> () { let local = 3  Cell<&'a i32>.put(&mut cell.*, &local)  return () }
fn storeLocal<'a>(cell: &mut Cell<&'a i32>) -> () { let local = 3  Store<&'a i32>.store(&mut cell.*, &local)  return () }
fn keepLocal<'c>(holder: &mut Holder<'c>) -> () { let local = 3  Holder<'c>.keep(&mut holder.*, &local)  return () }
fn putHolder<'c>(cell: &mut Cell<Holder<'c>>) -> () { let local = 3  Cell<Holder<'c>>.put(&mut cell.*, Holder<'c> { view: &local })  return () }
fn holderLocal<'c>(h: &'c i32) -> Holder<'c> { let local = 3  return Holder<'c>.make(&local) }
fn wrapLocal<'a>(v: &'a i32) -> Maybe<&'a i32> { let local = 3  return wrap<&'a i32>(&local) }
fn identLocal<'a>(v: &'a i32) -> &'a i32 { let local = 3  return ident(&local) }
fn holderParameter<'c>(h: &'c i32) -> Holder<'c> { return Holder<'c>.make(h) }
fn identParameter<'a>(v: &'a i32) -> &'a i32 { return ident(v) }
fn firstLocal<'a>(v: &'a i32) -> &'a i32 { let local = 3  return first(v, &local) }
fn formerLocal<'a>(v: &'a i32) -> &'a i32 { let local = 3  return former(v, &local) }
fn nestedLocal<'a>(v: &'a i32) -> &'a i32 { let local = 3  return counted(v, lengthOf(either(v, &local))) }
fn matchLocal<'a>(v: &'a i32, k: &'a Kind) -> &'a i32 { let local = 3  return match &k.* { Kind.A {..} => ident(&local) Kind.B => v } }
fn argumentLocal<'a>(v: &'a i32) -> &'a i32 { let local = 3  return counted(ident(&local), 0) }
fn stash<'x>(out: &mut Cell<&'x i32>, v: &'x i32) -> i32 { out.held = v  return 0 }
fn stashedLocal<'a>(v: &'a i32, out: &mut Cell<&'a i32>) -> &'a i32 { let local = 3  return counted(v, stash(&mut out.*, &local)) }
fn countOf<T>(value: T) -> i32 { return 0 }
fn plus(left: i32, right: i32) -> i32 { return left + right }
fn innerMatch<'a>(v: &'a i32, k: &'a Kind) -> &'a i32 { let local = 3  return counted(v, lengthOf(match &k.* { Kind.A {..} => v Kind.B => { return ident(&local) } })) }
fn innerBranch<'a>(v: &'a i32, k: &'a Kind, c: bool) -> &'a i32 { let local = 3  return counted(v, lengthOf(match &k.* { Kind.A {..} => v Kind.B => { if c { return ident(&local) } else { return v } } })) }
fn innerGeneric<'a>(v: &'a i32, k: &'a Kind) -> &'a i32 { let local = 3  return counted(v, countOf(match &k.* { Kind.A {..} => v Kind.B => { return ident(&local) } })) }
fn innerNested<'a>(v: &'a i32, k: &'a Kind) -> &'a i32 { let local = 3  return counted(v, plus(lengthOf(match &k.* { Kind.A {..} => v Kind.B => { return ident(&local) } }), 1)) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let someParameter = run Semantic.demandBody(&mut store, &mut request, &id, b"someParameter") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let someMatched = run Semantic.demandBody(&mut store, &mut request, &id, b"someMatched") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let someLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"someLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let putLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"putLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let storeLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"storeLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let keepLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"keepLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let putHolder = run Semantic.demandBody(&mut store, &mut request, &id, b"putHolder") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let holderLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"holderLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let wrapLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"wrapLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let identLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"identLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let holderParameter = run Semantic.demandBody(&mut store, &mut request, &id, b"holderParameter") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let identParameter = run Semantic.demandBody(&mut store, &mut request, &id, b"identParameter") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let firstLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"firstLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let formerLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"formerLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let stashedLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"stashedLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let innerMatch = run Semantic.demandBody(&mut store, &mut request, &id, b"innerMatch") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let innerBranch = run Semantic.demandBody(&mut store, &mut request, &id, b"innerBranch") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let innerGeneric = run Semantic.demandBody(&mut store, &mut request, &id, b"innerGeneric") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let innerNested = run Semantic.demandBody(&mut store, &mut request, &id, b"innerNested") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let matchLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"matchLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let argumentLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"argumentLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hasBorrowStatus(&someParameter, BodyBorrowStatus.Checked) && hasBorrowStatus(&someMatched, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&holderParameter, BodyBorrowStatus.Checked) && hasBorrowStatus(&identParameter, BodyBorrowStatus.Checked),
    "a call typed with the caller's lifetimes keeps a parameter borrow it returns Checked")
  run Testing.expect(rejectsSpan(&someLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 0)
      && rejectsSpan(&holderLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 5)
      && rejectsSpan(&wrapLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 6)
      && rejectsSpan(&identLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 7)
      && rejectsSpan(&matchLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 11)
      && rejectsSpan(&argumentLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 12),
    "a local borrow a returned call result holds at a caller region, from a match arm or as an argument of the returned call, is SEM0212 at the borrow")
  run Testing.expect(rejectsSpan(&stashedLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 13),
    "a local borrow a call inside the returned value stores through a caller reference must outlive the caller's lifetime: SEM0212 at the borrow")
  run Testing.expect(rejectsSpan(&innerMatch, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 14)
      && rejectsSpan(&innerBranch, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 15)
      && rejectsSpan(&innerGeneric, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 16)
      && rejectsSpan(&innerNested, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 17),
    "a `return` nested in a sealed call's operand returns its own value, so its local borrow is SEM0212 at the borrow")
  run Testing.expect(hasBorrowStatus(&firstLocal, BodyBorrowStatus.Checked) && hasBorrowStatus(&formerLocal, BodyBorrowStatus.Checked)
      && succeeded(&nestedLocal),
    "a local borrow passed only to a call inside the returned value whose result retains no region is never refused")
  run Testing.expect(rejectsSpan(&putLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 1)
      && rejectsSpan(&storeLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 2)
      && rejectsSpan(&keepLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 3)
      && rejectsSpan(&putHolder, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 4),
    "a local borrow stored through an inherent, interface or impl-lifetime member, or inside Holder<'c>, must outlive the caller's lifetime: SEM0212 at the borrow")
  return ()
}

// A struct literal whose fields have different lifetimes infers their meet, in any field order: a
// parameter outlives every region local to the body, so mixing parameters and local borrows leaves
// the local region. The literal still cannot outlive that local: returning it, storing it through a
// `&mut` into a caller region or assigning it to a binding read after the local ends is rejected. A
// bracket's environment binder drops a parameter that outlives a local environment of the other
// closure, so `use` may read a parameter while `release` reads a local; a release over a dropped
// local, or a `use` that stores its resource or a local beyond the bracket, is never Checked. A
// binder written on the literal never shortens.
test effect fn binderMeetsKeepBodyLocalRegions() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("binder-meets.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Res { v: i32 }
struct Trio<'a> {
  e: &'a i32,
  f: &'a i32,
  g: &'a i32,
}
struct Slot<'s> { view: &'s Res }
fn localParameterLocal(p: &i32) -> i32 { let one = 1  let s = Trio { e: &one, f: p, g: &one }  return s.g.* }
fn localParameterOther(p: &i32) -> i32 { let one = 1  let two = 2  let s = Trio { e: &one, f: p, g: &two }  return s.g.* }
fn localsThenParameter(p: &i32) -> i32 { let one = 1  let two = 2  let s = Trio { e: &one, f: &two, g: p }  return s.e.* }
fn parameterFirst(p: &i32) -> i32 { let one = 1  let two = 2  let s = Trio { e: p, f: &one, g: &two }  return s.f.* }
fn parametersThenLocal(p: &i32, q: &i32) -> i32 { let one = 1  let s = Trio { e: p, f: q, g: &one }  return s.g.* }
fn returnsLiteral<'p>(p: &'p i32) -> Trio<'p> { let one = 1  return Trio { e: p, f: &one, g: p } }
fn storesLiteral<'p>(slot: &mut Trio<'p>, p: &'p i32) -> () { let one = 1  slot.* = Trio { e: p, f: &one, g: p }  return () }
fn storesLocalFirst<'p>(slot: &mut Trio<'p>, p: &'p i32) -> () { let one = 1  slot.* = Trio { e: &one, f: p, g: p }  return () }
fn writtenBinder<'p>(p: &'p i32) -> i32 { let one = 1  let s = Trio<'p> { e: p, f: &one, g: p }  return s.e.* }
fn outlivesLocal(p: &i32, flag: bool) -> i32 {
  let mut kept = Trio { e: p, f: p, g: p }
  if flag { let one = 1  kept = Trio { e: p, f: &one, g: p } }
  return kept.f.*
}
effect<'env> fn bracket<'env, Resource: 'env, A, E, ?R, ?S, Release: for<'scope> once fn<'env>(&'scope mut Resource) -> once Effect<'scope & 'env; () ! never ? S> + Intrinsic.NonParking>(resource: Resource, use: for<'scope> once fn<'env>(&'scope mut Resource) -> once Effect<'scope & 'env; A ! E ? R>, release: Release) -> A ! E ? R | S {
  return run Intrinsic.useReleaseNonParking<Resource, A, E, R, S>(move resource, move use, move release)
}
effect fn parameterUseLocalRelease(data: &Res) -> i32 {
  let member = Res {v: 3}
  let use = effect fn(resource: &mut Res) -> i32 { return resource.v + data.v }
  let release = effect fn(resource: &mut Res) -> () { let n = member.v  return () }
  return run bracket(Res {v: 1}, move use, move release)
}
effect fn parametersUseLocalRelease(data: &Res, other: &Res) -> i32 {
  let member = Res {v: 3}
  let use = effect fn(resource: &mut Res) -> i32 { return resource.v + data.v + other.v }
  let release = effect fn(resource: &mut Res) -> () { let n = member.v  return () }
  return run bracket(Res {v: 1}, move use, move release)
}
effect fn parameterAndLocalsUseLocalRelease(data: &Res) -> i32 {
  let first = Res {v: 3}
  let second = Res {v: 4}
  let member = Res {v: 5}
  let use = effect fn(resource: &mut Res) -> i32 { return resource.v + data.v + first.v + second.v }
  let release = effect fn(resource: &mut Res) -> () { let n = member.v  return () }
  return run bracket(Res {v: 1}, move use, move release)
}
effect fn releaseAfterDrop(data: &Res) -> i32 {
  let member = Res {v: 3}
  let use = effect fn(resource: &mut Res) -> i32 { return resource.v + data.v }
  let release = effect fn(resource: &mut Res) -> () { let n = member.v  return () }
  drop member
  return run bracket(Res {v: 1}, move use, move release)
}
effect fn useStoresResource<'s>(slot: &mut Slot<'s>, data: &'s Res) -> i32 {
  let member = Res {v: 3}
  let use = effect fn(resource: &mut Res) -> i32 { slot.view = &resource.*  return data.v }
  let release = effect fn(resource: &mut Res) -> () { let n = member.v  return () }
  return run bracket(Res {v: 1}, move use, move release)
}
effect fn useStoresLocal<'s>(slot: &mut Slot<'s>, data: &'s Res) -> i32 {
  let member = Res {v: 3}
  let use = effect fn(resource: &mut Res) -> i32 { slot.view = &member  return data.v }
  let release = effect fn(resource: &mut Res) -> () { let n = member.v  return () }
  return run bracket(Res {v: 1}, move use, move release)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let localParameterLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"localParameterLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let localParameterOther = run Semantic.demandBody(&mut store, &mut request, &id, b"localParameterOther") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let localsThenParameter = run Semantic.demandBody(&mut store, &mut request, &id, b"localsThenParameter") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let parameterFirst = run Semantic.demandBody(&mut store, &mut request, &id, b"parameterFirst") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let parametersThenLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"parametersThenLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let returnsLiteral = run Semantic.demandBody(&mut store, &mut request, &id, b"returnsLiteral") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let storesLiteral = run Semantic.demandBody(&mut store, &mut request, &id, b"storesLiteral") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let storesLocalFirst = run Semantic.demandBody(&mut store, &mut request, &id, b"storesLocalFirst") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let writtenBinder = run Semantic.demandBody(&mut store, &mut request, &id, b"writtenBinder") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let outlivesLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"outlivesLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let parameterUseLocalRelease = run Semantic.demandBody(&mut store, &mut request, &id, b"parameterUseLocalRelease") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let parametersUseLocalRelease = run Semantic.demandBody(&mut store, &mut request, &id, b"parametersUseLocalRelease") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let parameterAndLocalsUseLocalRelease = run Semantic.demandBody(&mut store, &mut request, &id, b"parameterAndLocalsUseLocalRelease") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let releaseAfterDrop = run Semantic.demandBody(&mut store, &mut request, &id, b"releaseAfterDrop") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let useStoresResource = run Semantic.demandBody(&mut store, &mut request, &id, b"useStoresResource") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let useStoresLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"useStoresLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hasBorrowStatus(&localParameterLocal, BodyBorrowStatus.Checked) && hasBorrowStatus(&localParameterOther, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&localsThenParameter, BodyBorrowStatus.Checked) && hasBorrowStatus(&parameterFirst, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&parametersThenLocal, BodyBorrowStatus.Checked),
    "a literal mixing a parameter with local borrows infers the local meet in any field order")
  run Testing.expect(rejectsSpan(&returnsLiteral, RejectionCode.ReturnTypeMismatch, text, "Trio { e: p, f: &one, g: p }", 0)
      && rejectsSpan(&outlivesLocal, RejectionCode.ExpiredLifetime, text, "kept.f.*", usize.ZERO)
      && rejectsSpan(&writtenBinder, RejectionCode.UnsatisfiedLifetimeBound, text, "&one", 9),
    "a literal holding a local borrow cannot be returned, read after the local ends or written with a caller region")
  run Testing.expect(rejectsSpan(&storesLiteral, RejectionCode.AssignmentTypeMismatch, text, "Trio { e: p, f: &one, g: p }", 1)
      && rejectsSpan(&storesLocalFirst, RejectionCode.AssignmentTypeMismatch, text, "Trio { e: &one, f: p, g: p }", 0),
    "a literal holding a local borrow stored through a reference into a caller region is rejected in either field order")
  run Testing.expect(hasBorrowStatus(&parameterUseLocalRelease, BodyBorrowStatus.Checked) && hasBorrowStatus(&parametersUseLocalRelease, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&parameterAndLocalsUseLocalRelease, BodyBorrowStatus.Checked),
    "a bracket whose use reads a parameter and whose release reads a local is Checked")
  run Testing.expect(rejectsSpan(&releaseAfterDrop, RejectionCode.AccessDuringLoan, text, "drop member", usize.ZERO)
      && rejectsSpan(&useStoresResource, RejectionCode.UnsatisfiedLifetimeBound, text, "slot.view = &resource.*", usize.ZERO)
      && rejectsSpan(&useStoresLocal, RejectionCode.UnsatisfiedLifetimeBound, text, "member", 12),
    "a release over a dropped local, or a use storing its resource or a local beyond the bracket, is never Checked; a captured local is reported at its capture")
  return ()
}

// The meet a literal infers keeps every region it meets: a field of the literal read as a longer
// region, or a literal whose expectation fixes the caller's region, is rejected as before; a region
// inside a written type argument never shortens.
test effect fn binderMeetsNeverWidenFixedRegions() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("binder-fixed.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Trio<'a> {
  e: &'a i32,
  f: &'a i32,
  g: &'a i32,
}
struct Two<'a> {
  a: &'a i32,
  b: &'a i32,
}
struct W<T> { value: T }
fn hold<T>(t: T) -> W<T> { return W<T> { value: move t } }
union Maybe<T> { Empty, Some { value: T } }
impl<T> Maybe<T> {
  fn some(value: T) -> Maybe<T> { return Maybe.Some { value: move value } }
}
struct Pair<T> {
  first: T,
  second: T,
}
struct Token { value: i32 }
fn mixedParameters<'p, 'q>(x: &'p i32, y: &'q i32) -> &'p i32 { let two = Two {a: &x.*, b: y}  return two.b }
fn heldField<'p>(p: &'p i32) -> &'p i32 { let one = 1  let w = hold(Trio { e: p, f: &one, g: p })  return w.value.f }
fn heldWritten<'p>(p: &'p i32) -> i32 { let one = 1  let w = hold<Trio<'p>>(Trio { e: p, f: &one, g: p })  return 0 }
fn annotatedBinding<'p>(p: &'p i32) -> i32 { let one = 1  let s: Trio<'p> = Trio { e: p, f: &one, g: p }  return 0 }
fn someWritten<'p>(p: &'p i32) -> i32 { let one = 1  let m = Maybe<Trio<'p>>.some(Trio { e: p, f: &one, g: p })  return 0 }
fn elidedArgument(p: &i32) -> i32 { let one = 1  let t = Pair<&i32> { first: p, second: &one }  return t.second.* }
fn localVariant() -> i32 { let local = Token { value: 1 }  let o = Maybe<&Token>.Some { value: &local }  return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let mixedParameters = run Semantic.demandBody(&mut store, &mut request, &id, b"mixedParameters") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let heldField = run Semantic.demandBody(&mut store, &mut request, &id, b"heldField") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let heldWritten = run Semantic.demandBody(&mut store, &mut request, &id, b"heldWritten") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let annotatedBinding = run Semantic.demandBody(&mut store, &mut request, &id, b"annotatedBinding") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let someWritten = run Semantic.demandBody(&mut store, &mut request, &id, b"someWritten") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let elidedArgument = run Semantic.demandBody(&mut store, &mut request, &id, b"elidedArgument") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let localVariant = run Semantic.demandBody(&mut store, &mut request, &id, b"localVariant") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&mixedParameters, RejectionCode.UnsatisfiedLifetimeBound, text, "two.b", 0)
      && rejectsSpan(&heldField, RejectionCode.UnsatisfiedLifetimeBound, text, "&one", 0)
      && rejectsSpan(&heldWritten, RejectionCode.TypeMismatch, text, "Trio { e: p, f: &one, g: p }", 1)
      && rejectsSpan(&annotatedBinding, RejectionCode.AssignmentTypeMismatch, text, "Trio { e: p, f: &one, g: p }", 2)
      && rejectsSpan(&someWritten, RejectionCode.TypeMismatch, text, "Trio { e: p, f: &one, g: p }", 3),
    "a field read as a longer region, or a local borrow returned in the caller's region, fails at its source (SEM0212); an expectation that fixes the caller's region is still rejected")
  run Testing.expect(hasBorrowStatus(&elidedArgument, BodyBorrowStatus.Checked) && hasBorrowStatus(&localVariant, BodyBorrowStatus.Checked),
    "a region elided in a written type argument is inferred like a variant's, so a local borrow used locally is Checked")
  return ()
}

// A callee's body assumes the bounds its parameter and result types imply by being well formed: a
// nominal's declared bounds of its arguments, such as `Pair<'b, 'a: 'b>`'s `'a: 'b`, and a view's
// referent outliving the view. `viaPair` returns its `&'a Key` as `&'b Key` on that bound alone, so
// a call proves it like a declared bound (LIFE-002), and the result keeps the key's loan: a write to
// the key while the result lives is never Checked, through a direct, member or callable call, a section
// invoked later, or with a drop-carrying key. A write after the result's last use, or none, stays
// Checked, and so does a caller that forwards its own parameters: it assumes the bounds its own
// signature implies.
test effect fn impliedSignatureBoundsHoldAtTheCall() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("implied-signature-bounds.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Key { value: i32 }
struct Pair<'b, 'a: 'b> { short: &'b i32, long: &'a i32 }
struct Holder<'a> { key: &'a Key }
struct Owned { value: i32 }
impl Intrinsic.Drop for Owned { fn drop(self: &mut Owned) -> () { return () } }
struct OwnedPair<'b, 'a: 'b> { short: &'b i32, long: &'a i32 }
fn viaPair<'a, 'b>(x: &'a Key, p: Pair<'b, 'a>) -> &'b Key { return x }
fn nest<'a, 'b>(x: &'a Key, y: &'b Holder<'a>) -> &'b Key { return x }
fn viaOwned<'a, 'b>(x: &'a Owned, p: OwnedPair<'b, 'a>) -> &'b Owned { return x }
fn probe() -> i32 {
  let mut k = Key {value: 1}
  let v = 3
  let w = 4
  let r = viaPair(&k, Pair {short: &v, long: &w})
  k = Key {value: 9}
  return r.value
}
fn nested() -> i32 {
  let mut k = Key {value: 1}
  let other = Key {value: 2}
  let holder = Holder {key: &other}
  let r = nest(&k, &holder)
  k = Key {value: 9}
  return r.value
}
fn dropped() -> i32 {
  let mut k = Owned {value: 1}
  let v = 3
  let w = 4
  let r = viaOwned(&k, OwnedPair {short: &v, long: &w})
  k = Owned {value: 9}
  return r.value
}
fn probeClean() -> i32 {
  let k = Key {value: 1}
  let v = 3
  let w = 4
  let r = viaPair(&k, Pair {short: &v, long: &w})
  return r.value
}
fn nestedClean() -> i32 {
  let k = Key {value: 1}
  let other = Key {value: 2}
  let holder = Holder {key: &other}
  let r = nest(&k, &holder)
  return r.value
}
fn writeAfter() -> i32 {
  let mut k = Key {value: 1}
  let v = 3
  let w = 4
  let r = viaPair(&k, Pair {short: &v, long: &w})
  let n = r.value
  k = Key {value: 9}
  return n + k.value
}
impl Key { fn viaPairMember<'a, 'b>(self: &'a Key, p: Pair<'b, 'a>) -> &'b Key { return self } }
fn memberQualified() -> i32 {
  let mut k = Key {value: 1}
  let v = 3
  let w = 4
  let r = Key.viaPairMember(&k, Pair {short: &v, long: &w})
  k = Key {value: 9}
  return r.value
}
fn memberReceiver() -> i32 {
  let mut k = Key {value: 1}
  let v = 3
  let w = 4
  let r = k.viaPairMember(Pair {short: &v, long: &w})
  k = Key {value: 9}
  return r.value
}
fn callableValue() -> i32 {
  let mut k = Key {value: 1}
  let v = 3
  let w = 4
  let f = viaPair
  let r = f(&k, Pair {short: &v, long: &w})
  k = Key {value: 9}
  return r.value
}
fn sectioned() -> i32 {
  let mut k = Key {value: 1}
  let v = 3
  let w = 4
  let f = viaPair(Pair {short: &v, long: &w})
  let r = f(&k)
  k = Key {value: 9}
  return r.value
}
fn forwarded<'a, 'b>(x: &'a Key, p: Pair<'b, 'a>) -> &'b Key { return viaPair(x, move p) }
fn nestForwarded<'a, 'b>(x: &'a Key, y: &'b Holder<'a>) -> &'b Key { return nest(x, y) }
effect fn viaEffect<'a, 'b>(x: &'a Key, p: Pair<'b, 'a>) -> &'b Key { return x }
effect fn effectValue() -> i32 {
  let mut kept = Key {value: 1}
  let v = 3
  let w = 4
  let e = viaEffect(&kept, Pair {short: &v, long: &w})
  let got = run e
  kept = Key {value: 9}
  return got.value
}
fn parsedToTheEnd() -> i32 { return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let probe = run Semantic.demandBody(&mut store, &mut request, &id, b"probe") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let dropped = run Semantic.demandBody(&mut store, &mut request, &id, b"dropped") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let memberQualified = run Semantic.demandBody(&mut store, &mut request, &id, b"memberQualified") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let memberReceiver = run Semantic.demandBody(&mut store, &mut request, &id, b"memberReceiver") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let callableValue = run Semantic.demandBody(&mut store, &mut request, &id, b"callableValue") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let probeClean = run Semantic.demandBody(&mut store, &mut request, &id, b"probeClean") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedClean = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedClean") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let writeAfter = run Semantic.demandBody(&mut store, &mut request, &id, b"writeAfter") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let sectioned = run Semantic.demandBody(&mut store, &mut request, &id, b"sectioned") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let forwarded = run Semantic.demandBody(&mut store, &mut request, &id, b"forwarded") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nestForwarded = run Semantic.demandBody(&mut store, &mut request, &id, b"nestForwarded") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let effectValue = run Semantic.demandBody(&mut store, &mut request, &id, b"effectValue") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let parsedToTheEnd = run Semantic.demandBody(&mut store, &mut request, &id, b"parsedToTheEnd") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hasBorrowStatus(&parsedToTheEnd, BodyBorrowStatus.Checked),
    "the whole program parses and checks, so no expectation below holds only because a body failed to parse")
  run Testing.expect(rejectsSpan(&probe, RejectionCode.AccessDuringLoan, text, "k", 3)
      && rejectsSpan(&nested, RejectionCode.AccessDuringLoan, text, "k", 7)
      && rejectsSpan(&dropped, RejectionCode.AccessDuringLoan, text, "k", 10),
    "a write to a key a call's implied bound lets its result keep, while that result lives, is rejected at the write")
  run Testing.expect(rejectsSpan(&memberQualified, RejectionCode.AccessDuringLoan, text, "k", 22)
      && rejectsSpan(&memberReceiver, RejectionCode.AccessDuringLoan, text, "k", 25)
      && rejectsSpan(&callableValue, RejectionCode.AccessDuringLoan, text, "k", 28),
    "a member or callable call keeps its signature's implied bounds as a direct call does")
  run Testing.expect(hasBorrowStatus(&probeClean, BodyBorrowStatus.Checked) && hasBorrowStatus(&nestedClean, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&writeAfter, BodyBorrowStatus.Checked),
    "a call whose implied bounds hold, with no write while its result lives, stays Checked")
  run Testing.expect(rejectsSpan(&sectioned, RejectionCode.AccessDuringLoan, text, "k", 31),
    "a section invoked later keeps its signature's implied bounds as a direct call does")
  run Testing.expect(hasBorrowStatus(&forwarded, BodyBorrowStatus.Checked) && hasBorrowStatus(&nestForwarded, BodyBorrowStatus.Checked),
    "a caller assumes the bounds its own signature implies, so forwarding its parameters stays Checked")
  run Testing.expect(ownDiagnosticCount(&effectValue) == 2
      && reportsSpanAt(&effectValue, usize.ZERO, RejectionCode.AccessDuringLoan, text, "kept", 2)
      && reportsSpanAt(&effectValue, usize.ONE, RejectionCode.ExpiredLifetime, text, "got.value", 0),
    "an Effect value run under its implied bound keeps the key's loan: the write while its result lives is rejected")
  return ()
}

// A literal's declared bound whose longer side holds only borrows of storage the body owns (a local, a
// field of one, a temporary) and whose shorter side only declared lifetime parameters never holds:
// each such loan ends within the body, which every such parameter outlives. A struct or union literal
// is refused at the borrow, as the bootstrap refuses it, instead of leaving the body unchecked. Two loans of the body, `'static` or a parameter on the longer side
// hold and stay Checked, as does a reborrow through a reference, which is a body loan that may live
// as long as its referent.
test effect fn literalBoundsOverCallerRegions() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("literal-bounds.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Key { value: i32 }
struct KPair<'b, 'a: 'b> { short: &'b Key, long: &'a Key }
union UK<'b, 'a: 'b> { Both { short: &'b Key, long: &'a Key }, Neither }
fn localLonger<'s>(x: &'s Key) -> i32 { let local = Key {value: 5} let p = KPair {short: x, long: &local} return p.short.value }
fn twoLocals() -> i32 { let a = Key {value: 1} let local = Key {value: 5} let p = KPair {short: &a, long: &local} return p.long.value }
fn oneLocal() -> i32 { let local = Key {value: 5} let p = KPair {short: &local, long: &local} return p.long.value }
fn staticLonger<'s>(x: &'s Key, g: &'static Key) -> i32 { let p = KPair {short: x, long: g} return p.long.value }
fn parameterLonger<'s>(x: &'s Key) -> i32 { let local = Key {value: 5} let p = KPair {short: &local, long: x} return p.long.value }
fn fieldReborrow<'s>(x: &'s KPair<'s, 's>) -> i32 { let p = KPair {short: x.short, long: &x.long.*} return p.long.value }
fn derefReborrow<'s>(x: &'s Key, y: &'s Key) -> i32 { let p = KPair {short: y, long: &x.*} return p.long.value }
fn variantLonger<'s>(x: &'s Key) -> i32 { let held = Key {value: 5} let u = UK.Both {short: x, long: &held} return 0 }
fn temporaryLonger<'s>(x: &'s Key) -> i32 { let p = KPair {short: x, long: &Key {value: 6}} return p.short.value }
struct GP<'b, 'a: 'b, T> { short: &'b Key, long: &'a T }
struct RefHolder<'r> { value: &'r Key }
fn id<'i>(r: &'i Key) -> &'i Key { return r }
fn referenceBorrow<'s>(x: &'s Key) -> i32 { let p = GP {short: x, long: &x} return p.short.value }
fn referenceField<'s>(x: &'s Key, b: RefHolder<'s>) -> i32 { let p = GP {short: x, long: &b.value} return p.short.value }
fn referenceTemporary<'s>(x: &'s Key) -> i32 { let p = GP {short: x, long: &id(x)} return p.short.value }
fn genericOwned<'s, T>(x: &'s Key, t: T) -> i32 { let p = GP {short: x, long: &t} return p.short.value }
fn parsedToTheEnd() -> i32 { return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let localLonger = run Semantic.demandBody(&mut store, &mut request, &id, b"localLonger") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let twoLocals = run Semantic.demandBody(&mut store, &mut request, &id, b"twoLocals") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let oneLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"oneLocal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let staticLonger = run Semantic.demandBody(&mut store, &mut request, &id, b"staticLonger") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let parameterLonger = run Semantic.demandBody(&mut store, &mut request, &id, b"parameterLonger") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let fieldReborrow = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldReborrow") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let derefReborrow = run Semantic.demandBody(&mut store, &mut request, &id, b"derefReborrow") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let variantLonger = run Semantic.demandBody(&mut store, &mut request, &id, b"variantLonger") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let temporaryLonger = run Semantic.demandBody(&mut store, &mut request, &id, b"temporaryLonger") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let referenceBorrow = run Semantic.demandBody(&mut store, &mut request, &id, b"referenceBorrow") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let referenceField = run Semantic.demandBody(&mut store, &mut request, &id, b"referenceField") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let referenceTemporary = run Semantic.demandBody(&mut store, &mut request, &id, b"referenceTemporary") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let genericOwned = run Semantic.demandBody(&mut store, &mut request, &id, b"genericOwned") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let parsedToTheEnd = run Semantic.demandBody(&mut store, &mut request, &id, b"parsedToTheEnd") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hasBorrowStatus(&localLonger, BodyBorrowStatus.Checked),
    "a literal whose bound puts a body loan on the longer side takes a fresh shorter region, which need not reach the caller's, so it stays Checked")
  run Testing.expect(hasBorrowStatus(&variantLonger, BodyBorrowStatus.Checked)
      && rejectsSpan(&temporaryLonger, RejectionCode.ExpiredLifetime, text, "p.short.value", 1),
    "a union payload stays Checked the same way, while a borrowed temporary ends with its statement before the shorter field is read (OWN0019)")
  run Testing.expect(hasBorrowStatus(&twoLocals, BodyBorrowStatus.Checked) && hasBorrowStatus(&oneLocal, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&staticLonger, BodyBorrowStatus.Checked) && hasBorrowStatus(&parameterLonger, BodyBorrowStatus.Checked),
    "a literal whose bound relates two body loans, or puts 'static or a parameter on the longer side, stays Checked")
  run Testing.expect(hasBorrowStatus(&fieldReborrow, BodyBorrowStatus.Checked) && hasBorrowStatus(&derefReborrow, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&parsedToTheEnd, BodyBorrowStatus.Checked),
    "a reborrow through a reference may live as long as its referent, so its literal stays Checked")
  run Testing.expect(hasBorrowStatus(&referenceBorrow, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&referenceField, BodyBorrowStatus.Checked)
      && rejectsSpan(&referenceTemporary, RejectionCode.ExpiredLifetime, text, "p.short.value", 4),
    "a borrow of a place that is itself a reference is Checked, but a borrowed call result is a temporary that ends before the shorter field is read (OWN0019)")
  run Testing.expect(hasBorrowStatus(&genericOwned, BodyBorrowStatus.Checked),
    "a by-value generic parameter's loan on the longer side meets a fresh shorter region, whatever T is, so it stays Checked")
  return ()
}

// A callee's body also assumes what its inputs' stored data implies (`appendStoredFieldPremises`):
// `Outer<'a, 'b>`'s field `Pair<'a, 'b: 'a>` gives `stash` the `'b: 'a` it stores `other` under. So a
// call owes the bounds of every field, element and variant payload, at any depth, as it owes the
// parameter types' own: a caller whose `other` is a local never reaches the caller's slot Checked.
test effect fn impliedFieldBoundsHoldAtTheCall() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("implied-field-bounds.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Pair<'a, 'b: 'a> { short: &'a i32, long: &'b i32 }
struct Outer<'a, 'b> { inner: Pair<'a, 'b> }
union Either<'a, 'b> { Paired { inner: Pair<'a, 'b> }, Empty }
struct Slot<'a> { r: &'a i32 }
fn stash<'a, 'b>(other: &'b i32, slot: &mut Slot<'a>, o: Outer<'a, 'b>) -> () { slot.r = other  return () }
fn stashEither<'a, 'b>(other: &'b i32, slot: &mut Slot<'a>, e: Either<'a, 'b>) -> () { slot.r = other  return () }
fn throughField<'s>(slot: &mut Slot<'s>, x: &'s i32) -> () { let local = 3  let o = Outer {inner: Pair {short: x, long: x}}  return stash(&local, &mut slot.*, move o) }
fn throughPayload<'s>(slot: &mut Slot<'s>, x: &'s i32) -> () { let local = 3  let e = Either.Paired {inner: Pair {short: x, long: x}}  return stashEither(&local, &mut slot.*, move e) }
fn fieldHolds<'s>(slot: &mut Slot<'s>, x: &'s i32, y: &'s i32) -> () { let o = Outer {inner: Pair {short: x, long: x}}  return stash(y, &mut slot.*, move o) }
struct Inner<'v> { e: &'v [i32] }
union Store<'v> { Entries { entries: &'v [Inner<'v>] }, Bytes { bytes: &'v [u8] } }
struct Fields<'v> { store: Store<'v> }
struct Target<'v> { x: &'v i32 }
fn combine<'v>(t: Target<'v>, f: Fields<'v>) -> i32 { return 0 }
fn meetHolds<'a, 'b>(t: Target<'a>, f: Fields<'b>) -> i32 { return combine(move t, move f) }
fn parsedToTheEnd() -> i32 { return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let throughField = run Semantic.demandBody(&mut store, &mut request, &id, b"throughField") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let throughPayload = run Semantic.demandBody(&mut store, &mut request, &id, b"throughPayload") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let fieldHolds = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldHolds") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let meetHolds = run Semantic.demandBody(&mut store, &mut request, &id, b"meetHolds") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let parsedToTheEnd = run Semantic.demandBody(&mut store, &mut request, &id, b"parsedToTheEnd") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hasBorrowStatus(&parsedToTheEnd, BodyBorrowStatus.Checked), "the whole program parses and checks")
  run Testing.expect(rejectsSpan(&throughField, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 0)
      && rejectsSpan(&throughPayload, RejectionCode.UnsatisfiedLifetimeBound, text, "&local", 1),
    "a call owes the bounds its parameters' fields and variant payloads imply, so a local stored under one fails at its borrow (SEM0212)")
  run Testing.expect(hasBorrowStatus(&fieldHolds, BodyBorrowStatus.Checked) && hasBorrowStatus(&meetHolds, BodyBorrowStatus.Checked),
    "a call whose field-implied bounds hold stays Checked, and a view under a meet binding is bounded by the meet, not by each constituent")
  // The review's probes, with the outer value first: a nested field and a contents bound on a field.
  let nested = run module("implied-field-bounds-nested.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedText = """
struct Pair<'a, 'b: 'a> { first: &'a i32, second: &'b i32 }
struct Slot<'a> { r: &'a i32 }
struct Outer<'a, 'b> { inner: Pair<'a, 'b> }
fn stash<'a, 'b>(o: Outer<'a, 'b>, slot: &mut Slot<'a>, other: &'b i32) -> () { slot.r = other return () }
fn probe<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () {
  let o = Outer {inner: Pair {first: x, second: x}}
  let c = 5
  stash(move o, &mut slot.*, &c)
  return ()
}
fn parsedToTheEnd() -> i32 { return 0 }
"""
  let mut nestedStore = run staticSemantic(&nested, nestedText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedProbe = run Semantic.demandBody(&mut nestedStore, &mut request, &nested, b"probe") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedEnd = run Semantic.demandBody(&mut nestedStore, &mut request, &nested, b"parsedToTheEnd") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let contents = run module("implied-field-contents.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let contentsText = """
struct Slot<'a> { r: &'a i32 }
struct Hold<'a, T: 'a> { r: &'a i32, t: T }
struct Outer<'a, 'b> { h: Hold<'a, &'b i32> }
fn stash<'a, 'b>(o: Outer<'a, 'b>, slot: &mut Slot<'a>, other: &'b i32) -> () { slot.r = other return () }
fn probe<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () {
  let o = Outer {h: Hold {r: x, t: x}}
  let c = 5
  stash(move o, &mut slot.*, &c)
  return ()
}
fn parsedToTheEnd() -> i32 { return 0 }
"""
  let mut contentsStore = run staticSemantic(&contents, contentsText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let contentsProbe = run Semantic.demandBody(&mut contentsStore, &mut request, &contents, b"probe") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let contentsEnd = run Semantic.demandBody(&mut contentsStore, &mut request, &contents, b"parsedToTheEnd") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hasBorrowStatus(&nestedEnd, BodyBorrowStatus.Checked) && hasBorrowStatus(&contentsEnd, BodyBorrowStatus.Checked)
      && rejectsSpan(&nestedProbe, RejectionCode.UnsatisfiedLifetimeBound, nestedText, "&c", 0)
      && rejectsSpan(&contentsProbe, RejectionCode.UnsatisfiedLifetimeBound, contentsText, "&c", 0),
    "a local reaching the caller's slot under a field's declared or contents bound fails at its borrow (SEM0212)")
  // The #1900 review's section probes (z18, z29, z32), with their `probe`s renamed: a section binding
  // the local, alone or with the slot, owes the callee's field-implied bounds as a direct call does.
  let sectioned = run module("implied-field-bounds-section.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let sectionedText = """
struct Pair<'a, 'b: 'a> { first: &'a i32, second: &'b i32 }
struct Slot<'a> { r: &'a i32 }
struct Outer<'a, 'b> { inner: Pair<'a, 'b> }
struct Hold<'a, T: 'a> { r: &'a i32, t: T }
struct OuterF<'a, 'b> { h: Hold<'a, &'b i32> }
fn stash<'a, 'b>(o: Outer<'a, 'b>, slot: &mut Slot<'a>, other: &'b i32) -> () { slot.r = other return () }
fn stashF<'a, 'b>(o: OuterF<'a, 'b>, slot: &mut Slot<'a>, other: &'b i32) -> () { slot.r = other return () }
fn slotAndOther<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let o = Outer {inner: Pair {first: x, second: x}}  let c = 5  let mut s = stash(&mut slot.*, &c)  s(move o)  return () }
fn otherOnly<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let o = Outer {inner: Pair {first: x, second: x}}  let c = 5  let mut s = stash(&c)  s(move o, &mut slot.*)  return () }
fn otherOnlyContents<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let o = OuterF {h: Hold {r: x, t: x}}  let c = 5  let mut s = stashF(&c)  s(move o, &mut slot.*)  return () }
fn parsedToTheEnd() -> i32 { return 0 }
"""
  let mut sectionedStore = run staticSemantic(&sectioned, sectionedText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let slotAndOther = run Semantic.demandBody(&mut sectionedStore, &mut request, &sectioned, b"slotAndOther") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let otherOnly = run Semantic.demandBody(&mut sectionedStore, &mut request, &sectioned, b"otherOnly") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let otherOnlyContents = run Semantic.demandBody(&mut sectionedStore, &mut request, &sectioned, b"otherOnlyContents") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let sectionedEnd = run Semantic.demandBody(&mut sectionedStore, &mut request, &sectioned, b"parsedToTheEnd") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hasBorrowStatus(&sectionedEnd, BodyBorrowStatus.Checked)
      && rejectsSpan(&slotAndOther, RejectionCode.UnsatisfiedLifetimeBound, sectionedText, "&c", 0)
      && rejectsSpan(&otherOnly, RejectionCode.UnsatisfiedLifetimeBound, sectionedText, "&c", 1)
      && rejectsSpan(&otherOnlyContents, RejectionCode.UnsatisfiedLifetimeBound, sectionedText, "&c", 2),
    "a section binding the local owes its callee's field-implied bounds, so it fails at the local's borrow (SEM0212)")
  // An exclusive view a value need not hold, in a union payload, a phantom argument or a variant's
  // field, still owes its referent's bound: the callee assumes it, and no view vouches for it.
  let unheld = run module("implied-bounds-unheld-views.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let unheldText = """
union Maybe<T> { Some { value: T }, None }
struct Ph<T> { n: i32 }
union MU<'a, 'b> { Has { r: &'a mut &'b i32 }, Not }
struct Slot<'a> { r: &'a i32 }
fn none<'a, 'b>(r: &'b i32) -> Maybe<&'a mut &'b i32> { return Maybe<&'a mut &'b i32>.None }
fn phantom<'a, 'b>(r: &'b i32) -> Ph<&'a mut &'b i32> { return Ph<&'a mut &'b i32> {n: 0} }
fn not<'a, 'b>(r: &'b i32) -> MU<'a, 'b> { return MU<'a, 'b>.Not }
fn stash<'a, 'b>(other: &'b i32, slot: &mut Slot<'a>, o: Maybe<&'a mut &'b i32>) -> () { slot.r = other  return () }
fn stashPhantom<'a, 'b>(other: &'b i32, slot: &mut Slot<'a>, o: Ph<&'a mut &'b i32>) -> () { slot.r = other  return () }
fn stashVariant<'a, 'b>(other: &'b i32, slot: &mut Slot<'a>, o: MU<'a, 'b>) -> () { slot.r = other  return () }
fn throughPayload<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let c = 5  let r = &c  let o = none(r)  stash(r, &mut slot.*, move o)  return () }
fn throughPhantom<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let c = 5  let r = &c  let o = phantom(r)  stashPhantom(r, &mut slot.*, move o)  return () }
fn throughVariant<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let c = 5  let r = &c  let o = not(r)  stashVariant(r, &mut slot.*, move o)  return () }
fn parsedToTheEnd() -> i32 { return 0 }
"""
  let mut unheldStore = run staticSemantic(&unheld, unheldText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let unheldPayload = run Semantic.demandBody(&mut unheldStore, &mut request, &unheld, b"throughPayload") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unheldPhantom = run Semantic.demandBody(&mut unheldStore, &mut request, &unheld, b"throughPhantom") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unheldVariant = run Semantic.demandBody(&mut unheldStore, &mut request, &unheld, b"throughVariant") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unheldEnd = run Semantic.demandBody(&mut unheldStore, &mut request, &unheld, b"parsedToTheEnd") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hasBorrowStatus(&unheldEnd, BodyBorrowStatus.Checked)
      && rejectsSpan(&unheldPayload, RejectionCode.UnsatisfiedLifetimeBound, unheldText, "&c", 0)
      && rejectsSpan(&unheldPhantom, RejectionCode.UnsatisfiedLifetimeBound, unheldText, "&c", 1)
      && rejectsSpan(&unheldVariant, RejectionCode.UnsatisfiedLifetimeBound, unheldText, "&c", 2),
    "an exclusive view in a union payload, a phantom argument or a variant's field owes its bounds, so the local's borrow fails (SEM0212)")
  // A parameter's own exclusive view owes no bound of its own, but what its referent's type arguments
  // and array elements imply is still owed; and two applications of one stored shape with their
  // regions swapped imply opposite bounds, so each is owed.
  let referent = run module("implied-bounds-exclusive-referent.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let referentText = """
struct Slot<'a> { r: &'a i32 }
struct Ph<T> { n: i32 }
union Mb<T> { Has { v: T }, Not }
fn stash<'x, 'a, 'b>(other: &'b i32, slot: &mut Slot<'a>, o: &'x mut Ph<&'a &'b i32>) -> () { slot.r = other  return () }
fn throughPhantom<'p, 'q>(x: &'q i32, slot: &mut Slot<'p>) -> () {
  let mut o = Ph<&'p &'q i32> {n: 0}  stash(x, &mut slot.*, &mut o)
  return ()
}
fn stashArray<'x, 'a, 'b>(other: &'b i32, slot: &mut Slot<'a>, o: &'x mut [&'a &'b i32; 0]) -> () { slot.r = other  return () }
fn throughArray<'p, 'q>(x: &'q i32, slot: &mut Slot<'p>) -> () {
  let mut arr: [&'p &'q i32; 0] = []  stashArray(x, &mut slot.*, &mut arr)
  return ()
}
fn stashOrdered<'x, 'a, 'b>(other: &'a i32, slot: &mut Slot<'b>, o2: &'x mut Mb<&'b &'a i32>, o1: Mb<&'a &'b i32>) -> () { slot.r = other  return () }
fn throughOrder<'p: 'q, 'q>(x: &'q i32, slot: &mut Slot<'p>) -> () {
  let o1 = Mb<&'q &'p i32>.Not  let mut o2 = Mb<&'p &'q i32>.Not  stashOrdered(x, &mut slot.*, &mut o2, move o1)
  return ()
}
fn sameRegion<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () {
  let mut o = Ph<&'p &'p i32> {n: 0}  stash(x, &mut slot.*, &mut o)
  return ()
}
fn parsedToTheEnd() -> i32 { return 0 }
"""
  let mut referentStore = run staticSemantic(&referent, referentText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let referentPhantom = run Semantic.demandBody(&mut referentStore, &mut request, &referent, b"throughPhantom") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let referentArray = run Semantic.demandBody(&mut referentStore, &mut request, &referent, b"throughArray") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let referentOrder = run Semantic.demandBody(&mut referentStore, &mut request, &referent, b"throughOrder") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let referentSame = run Semantic.demandBody(&mut referentStore, &mut request, &referent, b"sameRegion") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let referentEnd = run Semantic.demandBody(&mut referentStore, &mut request, &referent, b"parsedToTheEnd") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(hasBorrowStatus(&referentEnd, BodyBorrowStatus.Checked)
      && rejectsSpan(&referentPhantom, RejectionCode.UnsatisfiedLifetimeBound, referentText, "&mut slot.*", 0)
      && rejectsSpan(&referentArray, RejectionCode.UnsatisfiedLifetimeBound, referentText, "&mut arr", 0)
      && rejectsSpan(&referentOrder, RejectionCode.UnsatisfiedLifetimeBound, referentText, "&mut slot.*", 2),
    "what an exclusive view's referent implies below a type argument or array element is owed, in either region order (SEM0212)")
  run Testing.expect(hasBorrowStatus(&referentSame, BodyBorrowStatus.Checked),
    "a referent whose implied bound the caller's own regions satisfy stays Checked")
  return ()
}

// An exclusive view's referent is invariant, so a call owes none of its view bounds, but the declared
// bounds of a nominal inside it are still owed: a literal never proves its own, so a `KPair` whose
// `'a: 'b` is false reaches the callee only through such a call. Each one keeps its refusal at the
// local the literal lends.
test effect fn writtenEnvironmentsAreOwedAtTheCall() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("written-environment-owed.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  // The #1900 review's G-env probes, renamed: an `effect<'a> fn` assumes every input outlives `'a`
  // (LIFE-004), so each call, section, method value and service operation owes that.
  let text = """
struct Slot<'a> { r: &'a i32 }
struct Pk<T> { t: T }
struct Tok { v: i32 }
struct SlotT<'a> { r: &'a Tok }
struct Token { value: i32 }
effect<'a> fn stash<'a, 'b>(n: i32, slot: &mut Slot<'a>, other: &'b i32) -> () { slot.r = other  return () }
effect<'a> fn stashTwo<'a, 'b>(slot: &mut Slot<'a>, other: &'b i32) -> () { slot.r = other  return () }
effect<'a> fn stashWrapped<'a, 'b>(n: i32, slot: &mut Slot<'a>, other: Pk<&'b i32>) -> () { slot.r = other.t  return () }
impl Tok { effect<'a> fn give<'a, 'b>(self: &'b Tok, slot: &mut SlotT<'a>) -> () { slot.r = self  return () } }
service Stasher { effect<'a> fn stash<'a, 'b>(n: i32, slot: &mut Slot<'a>, other: &'b i32) -> () ? &mut Stasher }
service Keeper<'k> { effect fn keep(v: &'k Token) -> () ? &mut Keeper<'k> }
effect<'k> fn putK<'k, 'v>(n: i32, v: &'v Token) -> () ? &mut Keeper<'k> { return run Keeper<'k>.keep(v) }
effect<'a> fn note<'a, 'b: 'a>(n: i32, v: &'b i32) -> i32 { return v.* + n }
fn directCall<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let c = 5  run stash(1, &mut slot.*, &c)  return () }
fn sectionCapturesLocal<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let c = 5  let mut s = stashTwo(&c)  run s(&mut slot.*)  return () }
fn sectionBindsBoth<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let c = 5  let mut s = stash(&mut slot.*, &c)  run s(1)  return () }
fn sectionWrapsLocal<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let c = 5  let mut s = stashWrapped(&mut slot.*, Pk {t: &c})  run s(1)  return () }
fn sectionInClosure<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let c = 5  let mut f = fn() -> () { let mut s = stash(&mut slot.*, &c)  run s(1)  return () }  f()  return () }
fn methodValue<'p>(x: &'p Tok, slot: &mut SlotT<'p>) -> () { let c = Tok {v: 5}  let m = c.give  run m(&mut slot.*)  return () }
fn methodCall<'p>(x: &'p Tok, slot: &mut SlotT<'p>) -> () { let c = Tok {v: 5}  run c.give(&mut slot.*)  return () }
fn sectionCapturesShorterSlot<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let mut s = stash(&mut slot.*, x)  run s(1)  return () }
fn sectionIntoLocalSlot<'p>(x: &'p i32) -> i32 { let c = 5  let mut loc = Slot {r: x}  let mut s = stash(&mut loc, &c)  run s(1)  return loc.r.* }
effect fn serviceCall<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () ? &mut Stasher { let c = 5  run Stasher.stash(1, &mut slot.*, &c)  return () }
effect fn serviceSection<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () ? &mut Stasher { let c = 5  let mut s = Stasher.stash(&mut slot.*, &c)  run s(1)  return () }
effect fn keptSection<'b>() -> () ? &mut Keeper<'b> { let local = Token { value: 1 }  let s = putK<'b>(&local)  run s(1)  return () }
effect fn keptCall<'b>() -> () ? &mut Keeper<'b> { let local = Token { value: 1 }  run putK<'b>(1, &local)  return () }
fn outlivesDirect<'p>(x: &'p i32) -> i32 { return run note(1, x) }
fn outlivesSection<'p>(x: &'p i32) -> i32 { let s = note(x)  return run s(1) }
effect<'e> fn readPk<'e, 'b>(v: Pk<&'b i32>) -> i32 { return v.t.* }
service Store<T> { effect<'e> fn put<'e>(value: T) -> i32 ? &mut Store<T> }
fn keepStatic<T: 'static>(v: T) -> () { drop v  return () }
fn chosenInPlace<'p>(x: &'p i32) -> i32 { let c = 5  return run readPk(Pk {t: &c}) }
effect<'e> fn chosenForService<'e, T>(first: T) -> i32 ? &mut Store<T> { return run Store<T>.put(move first) }
fn chosenReturned<'p>(x: &'p i32) -> Effect<'static; i32> { let c = 5  let e = readPk(Pk {t: &c})  return move e }
fn chosenKept<'p>(x: &'p i32) -> () { let c = 5  let e = readPk(Pk {t: &c})  keepStatic(move e)  return () }
struct Final {}
effect<'e> fn readBounded<'e, 'b, H: 'e>(v: Pk<&'b i32>, h: H) -> i32 { drop h  return v.t.* }
effect<'e> fn readLonger<'e: 'x, 'x, 'b>(v: Pk<&'b i32>, slot: &mut Slot<'x>) -> i32 { return v.t.* }
fn chosenUnderBound<'p>(x: &'p i32) -> i32 { let c = 5  return run readBounded(Pk {t: &c}, Final {}) }
fn pinnedLonger<'p>(x: &'p i32, slot: &mut Slot<'p>) -> i32 { let c = 5  return run readLonger(Pk {t: &c}, &mut slot.*) }
fn boundEscapes<'p>(x: &'p i32) -> () { let c = 5  let e = readBounded(Pk {t: &c}, Final {})  keepStatic(move e)  return () }
effect<'h> fn recovered<'d: 'h, 'h>(v: &'d i32, guard: Tok) -> i32 { return v.* + guard.v }
fn valueSection() -> () { let base = recovered  let handler = base(Tok {v: 2})  drop handler  return () }
fn valueSectionCapturesLocal<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let c = 5  let b = stashTwo  let mut s = b(&c)  run s(&mut slot.*)  return () }
service Getter { effect<'e> fn get<'e>(anchor: &'e i32) -> &'e i32 ? &mut Getter }
service SharedGetter { effect<'e> fn get<'e>(anchor: &'e i32) -> &'e i32 ? &SharedGetter }
service ValidGetter { effect<'e> fn get<'e>(anchor: &'e i32) -> &'e i32 ? &mut ValidGetter }
struct ImplG { v: i32 }
effect<'e> fn witnessOwn<'e>(self: &mut ImplG, anchor: &'e i32) -> &'e i32 { return &self.v }
effect<'e> fn witnessShared<'e>(self: &ImplG, anchor: &'e i32) -> &'e i32 { return &self.v }
effect<'e> fn witnessAnchor<'e>(self: &mut ImplG, anchor: &'e i32) -> &'e i32 { return anchor }
impl Getter for ImplG { get: ImplG.witnessOwn }
impl SharedGetter for ImplG { get: ImplG.witnessShared }
impl ValidGetter for ImplG { get: ImplG.witnessAnchor }
service ParamGetter { effect<'e> fn get<'e>(anchor: &'e i32) -> &'e i32 ? &mut ParamGetter }
service SharedParamGetter { effect<'e> fn get<'e>(anchor: &'e i32) -> &'e i32 ? &SharedParamGetter }
service ValidParamGetter { effect<'e> fn get<'e>(anchor: &'e i32) -> &'e i32 ? &mut ValidParamGetter }
struct ImplP { v: i32 }
effect<'e> fn providerOwn<'e>(p: &mut ImplP, anchor: &'e i32) -> &'e i32 { return &p.v }
effect<'e> fn providerShared<'e>(p: &ImplP, anchor: &'e i32) -> &'e i32 { return &p.v }
effect<'e> fn providerAnchor<'e>(p: &mut ImplP, anchor: &'e i32) -> &'e i32 { return anchor }
impl ParamGetter for ImplP { get: providerOwn }
impl SharedParamGetter for ImplP { get: providerShared }
impl ValidParamGetter for ImplP { get: ImplP.providerAnchor }
service AliasGetter { effect<'e> fn get<'e>(anchor: &'e i32) -> &'e i32 ? &mut AliasGetter }
service AppliedGetter { effect<'e> fn get<'e>(anchor: &'e i32) -> &'e i32 ? &mut AppliedGetter }
type Prov = &mut ImplP
type Mut<T> = &mut T
effect<'e> fn providerAliased<'e>(aliased: Prov, anchor: &'e i32) -> &'e i32 { return &aliased.v }
effect<'e> fn providerApplied<'e>(applied: Mut<ImplP>, anchor: &'e i32) -> &'e i32 { return &applied.v }
impl AliasGetter for ImplP { get: providerAliased }
impl AppliedGetter for ImplP { get: providerApplied }
struct Cell { v: i32 }
effect<'e> fn peekFirst<'e>(cell: &Cell, anchor: &'e i32) -> &'e i32 { return &cell.v }
effect<'e> fn peekWritten<'e>(cell: &'e Cell, anchor: &'e i32) -> &'e i32 { return &cell.v }
struct Plain { n: i32 }
struct HoldsLocal<'h> { r: &'h i32 }
struct Wrapped<T> { t: T }
struct RBuf<'s, P> { inner: &'s mut P }
effect<'s> fn drain<'s, P>(b: &'s mut RBuf<'s, P>) -> i32 { return 0 }
fn useDrain<P>(seed: &mut P, f: for<'x> once fn(&'x mut RBuf<'x, P>) -> once Effect<'x; i32>) -> i32 { let mut b = RBuf<P> {inner: &mut seed.*}  return run f(&mut b) }
fn drainsPlain<'p>(x: &'p i32) -> i32 { let mut v = Plain {n: 1}  return useDrain(&mut v, drain) }
fn drainsWrappedPlain<'p>(x: &'p i32) -> i32 { let mut v = Wrapped {t: Plain {n: 1}}  return useDrain(&mut v, drain) }
fn drainsHoldsLocal<'p>(x: &'p i32) -> i32 { let c = 5  let mut v = HoldsLocal {r: &c}  return useDrain(&mut v, drain) }
effect<'env> fn callBack<'env, D: 'env, S: once fn<'env>(D) -> ()>(d: D, s: S) -> () { s(move d)  return () }
fn countInto(state: &mut i32, tag: Tok) -> () { state.* = tag.v  return () }
effect fn forwardsCallback<'env, 'state, S: once fn<'env>(&'state mut i32) -> ()>(state: &'state mut i32, s: S) -> () { return run callBack(move state, move s) }
effect fn drivesSection() -> i32 { let onDone = countInto(Tok {v: 2})  let mut state = 1  run forwardsCallback(&mut state, move onDone)  return state }
fn addTo(n: i32, v: &i32) -> i32 { return v.* + n }
fn ignoreFirst<T>(n: i32, t: T) -> i32 { drop t  return n }
fn pinnedCallback<'env, S: once fn<'env>(i32) -> i32>(slot: &mut Slot<'env>, s: S) -> i32 { return s(slot.r.*) }
fn closureTooShort<'p>(x: &'p i32, slot: &mut Slot<'p>) -> i32 { let c = 5  let r = &c  let f = fn(n: i32) -> i32 { return n + r.* }  return pinnedCallback(&mut slot.*, f) }
fn sectionTooShort<'p>(x: &'p i32, slot: &mut Slot<'p>) -> i32 { let c = 5  let s = addTo(&c)  return pinnedCallback(&mut slot.*, s) }
fn genericTooShort<'p>(x: &'p i32, slot: &mut Slot<'p>) -> i32 { let c = 5  let s = ignoreFirst<&i32>(&c)  return pinnedCallback(&mut slot.*, s) }
effect<'a> fn takeStruct<'a, T>(slot: &mut Slot<'a>, v: T) -> () { drop v  return () }
effect<'a> fn takeOwned<'a, 'h>(v: HoldsLocal<'h>, slot: &mut Slot<'a>) -> () { slot.r = v.r  return () }
impl Tok { effect<'a> fn giveOther<'a, 'b>(self: &Tok, slot: &mut SlotT<'a>, other: &'b Tok) -> () { slot.r = other  return () } }
service Keep2 { effect<'a> fn put<'a, 'b>(other: &'b i32, slot: &mut Slot<'a>) -> () ? &mut Keep2 }
struct KImpl { n: i32 }
effect<'a> fn putW<'a, 'b>(self: &mut KImpl, other: &'b i32, slot: &mut Slot<'a>) -> () { slot.r = other  return () }
impl Keep2 for KImpl { put: KImpl.putW }
fn exemptDirect<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { run takeStruct(&mut slot.*, Plain {n: 1})  return () }
fn exemptSection<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let s = takeStruct(Plain {n: 1})  run s(&mut slot.*)  return () }
fn exemptValue<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let b = takeStruct  run b(&mut slot.*, Plain {n: 1})  return () }
fn ownedFirstOwed<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let c = 5  run takeOwned(HoldsLocal {r: &c}, &mut slot.*)  return () }
fn sectionSecondOwed<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let c = 5  let s = stashTwo(&c)  run s(&mut slot.*)  return () }
fn valueSecondOwed<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let c = 5  let b = stashTwo  run b(&mut slot.*, &c)  return () }
fn methodValueSecondOwed<'p>(x: &'p Tok, slot: &mut SlotT<'p>) -> () { let t = Tok {v: 1}  let c = Tok {v: 2}  let m = t.giveOther  run m(&mut slot.*, &c)  return () }
effect fn operationFirstOwed<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () ? &mut Keep2 { let c = 5  run Keep2.put(&c, &mut slot.*)  return () }
effect<'e> fn putGeneric<'e, T>(t: T, anchor: &'e i32) -> i32 { drop t  return 0 }
struct OwnerW<T> { n: i32 }
impl<T> OwnerW<T> { effect<'e> fn put<'e>(t: T, anchor: &'e i32) -> i32 { drop t  return 0 } }
effect<'e> fn readT<'e, T>(t: T, rd: fn<'static>(T) -> i32, anchor: &'e i32) -> i32 { return rd(move t) }
effect<'e> fn hideT<'e, T>(t: T, rd: fn<'static>(T) -> i32, anchor: &'e i32) -> once Effect<'e; i32> { return readT(move t, rd, anchor) }
fn rdCell(c: &Cell) -> i32 { return c.v }
fn genericFirstOwed<'p>(x: &'p i32) -> i32 { let c = 5  return run putGeneric(&c, x) }
interface StashyEnv { effect<'a> fn stashIt<'a, 'b>(self: &Self, slot: &mut Slot<'a>, other: &'b i32) -> () }
struct ZEnv {}
impl StashyEnv for ZEnv { effect<'a> fn stashIt<'a, 'b>(self: &Self, slot: &mut Slot<'a>, other: &'b i32) -> () { slot.r = other  return () } }
effect<'a> fn stashDirect<'a, 'b>(self: &ZEnv, slot: &mut Slot<'a>, other: &'b i32) -> () { slot.r = other  return () }
fn refuseQualified<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let z = ZEnv {}  let c1 = 5  run StashyEnv.stashIt(&z, &mut slot.*, &c1)  return () }
fn refuseReceiver<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let z = ZEnv {}  let c2 = 5  run z.stashIt(&mut slot.*, &c2)  return () }
fn refuseLetRun<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let z = ZEnv {}  let c3 = 5  let e = StashyEnv.stashIt(&z, &mut slot.*, &c3)  run move e  return () }
fn refuseGeneric<'p, T: StashyEnv>(t: &T, slot: &mut Slot<'p>) -> () { let c4 = 5  run StashyEnv.stashIt(t, &mut slot.*, &c4)  return () }
fn refuseGenericReceiver<'p, T: StashyEnv>(t: &T, slot: &mut Slot<'p>) -> () { let c5 = 5  run t.stashIt(&mut slot.*, &c5)  return () }
effect fn refuseInEffect<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let z = ZEnv {}  let c6 = 5  run StashyEnv.stashIt(&z, &mut slot.*, &c6)  return () }
fn refuseDirect<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let z = ZEnv {}  let c7 = 5  run stashDirect(&z, &mut slot.*, &c7)  return () }
fn refuseThroughLocal<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let z = ZEnv {}  let c8 = 5  let r = &c8  run stashDirect(&z, &mut slot.*, r)  return () }
fn acceptOperand<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let z = ZEnv {}  run StashyEnv.stashIt(&z, &mut slot.*, x)  return () }
fn acceptOperandDirect<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let z = ZEnv {}  run stashDirect(&z, &mut slot.*, x)  return () }
struct EnvW<'w> { r: &'w i32 }
struct EnvCellV { v: i32 }
fn refuseReborrow<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let z = ZEnv {}  let c9 = 5  let r9 = &c9  run StashyEnv.stashIt(&z, &mut slot.*, &r9.*)  return () }
fn refuseFieldReborrow<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let z = ZEnv {}  let c10 = 5  let w10 = EnvW {r: &c10}  run StashyEnv.stashIt(&z, &mut slot.*, &w10.r.*)  return () }
fn refuseReborrowField<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let z = ZEnv {}  let c11 = EnvCellV {v: 5}  let r11 = &c11  run StashyEnv.stashIt(&z, &mut slot.*, &r11.v)  return () }
fn refuseReborrowLetRun<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let z = ZEnv {}  let c12 = 5  let r12 = &c12  let e = StashyEnv.stashIt(&z, &mut slot.*, &r12.*)  run move e  return () }
fn refuseReborrowGeneric<'p, T: StashyEnv>(t: &T, slot: &mut Slot<'p>) -> () { let c13 = 5  let r13 = &c13  run t.stashIt(&mut slot.*, &r13.*)  return () }
effect fn refuseReborrowInEffect<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let z = ZEnv {}  let c14 = 5  let r14 = &c14  run z.stashIt(&mut slot.*, &r14.*)  return () }
fn refuseReborrowSecond<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let z = ZEnv {}  let c15 = 5  run StashyEnv.stashIt(&z, &mut slot.*, x)  let r15 = &c15  run StashyEnv.stashIt(&z, &mut slot.*, &r15.*)  return () }
fn refuseStatic(x: &'static i32, slot: &mut Slot<'static>) -> () { let z = ZEnv {}  let c16 = 5  run StashyEnv.stashIt(&z, &mut slot.*, &c16)  return () }
fn refuseStaticReceiver(slot: &mut Slot<'static>) -> () { let z = ZEnv {}  let c17 = 5  run z.stashIt(&mut slot.*, &c17)  return () }
fn refuseStaticThroughLocal(x: &'static i32, slot: &mut Slot<'static>) -> () { let z = ZEnv {}  let c18 = 5  let r18 = &c18  run StashyEnv.stashIt(&z, &mut slot.*, r18)  return () }
fn acceptReborrowParam<'p>(x: &'p i32, slot: &mut Slot<'p>) -> () { let z = ZEnv {}  run StashyEnv.stashIt(&z, &mut slot.*, &x.*)  return () }
fn acceptStatic(x: &'static i32, slot: &mut Slot<'static>) -> () { let z = ZEnv {}  run StashyEnv.stashIt(&z, &mut slot.*, x)  return () }
fn acceptLocalSlot() -> i32 { let z = ZEnv {}  let c19 = 5  let d19 = 6  let mut s19 = Slot {r: &d19}  let r19 = &c19  run StashyEnv.stashIt(&z, &mut s19, &r19.*)  return s19.r.* }
fn refuseLadderOne<'p>(x: &'p i32, slot: &mut Slot<'p>, f: bool) -> () { let z = ZEnv {}  let nc = 5  let mut n0 = &nc  let mut n1 = &nc  let mut n2 = &n1.*  if f { n2 = &n0.* }  run StashyEnv.stashIt(&z, &mut slot.*, &n2.*)  return () }
fn refuseLadder12<'p>(x: &'p i32, slot: &mut Slot<'p>, f: bool) -> () { let z = ZEnv {}  let mc = 5  let mut m0 = &mc  let mut m1 = &mc  let mut m2 = &m1.*  if f { m2 = &m0.* }  let mut m3 = &m2.*  if f { m3 = &m1.* }  let mut m4 = &m3.*  if f { m4 = &m2.* }  let mut m5 = &m4.*  if f { m5 = &m3.* }  let mut m6 = &m5.*  if f { m6 = &m4.* }  let mut m7 = &m6.*  if f { m7 = &m5.* }  let mut m8 = &m7.*  if f { m8 = &m6.* }  let mut m9 = &m8.*  if f { m9 = &m7.* }  let mut m10 = &m9.*  if f { m10 = &m8.* }  let mut m11 = &m10.*  if f { m11 = &m9.* }  let mut m12 = &m11.*  if f { m12 = &m10.* }  run StashyEnv.stashIt(&z, &mut slot.*, &m12.*)  return () }
struct EnvCfg { v: i32 }
struct EnvRoute<'c> { cfg: &'c EnvCfg }
struct EnvCell<T> { v: T }
service EnvSvc {}
fn envSelect<'c>(cfg: &'c EnvCfg) -> EnvRoute<'c> { return EnvRoute {cfg: cfg} }
fn envRun<'x, A>(e: once Effect<'x; A>) -> A { return run e }
fn envPlain() -> i32 { return 1 }
effect<'env> fn envRouted<'c, H: 'env, 'env>(route: EnvRoute<'c>, handler: H) -> i32 { drop handler  return route.cfg.v }
effect<'env> fn envRoutedRow<'c, ?R, 'env>(route: EnvRoute<'c>) -> i32 ? R where R in Without<R, EnvSvc> { return route.cfg.v }
effect<'env> fn envPick<'c, 'env>(route: EnvRoute<'c>) -> &'env i32 { return &route.cfg.v }
effect<'env> fn envPinned<'c, 'x, 'env: 'x>(route: EnvRoute<'c>, slot: &mut Slot<'x>) -> i32 { return route.cfg.v }
effect<'env> fn envInvariant<'c, 'env>(route: EnvRoute<'c>, cell: &mut EnvCell<string<'env>>) -> i32 { return route.cfg.v }
effect<'env> fn envShared<'c, 'env>(route: EnvRoute<'c>, cell: &EnvCell<string<'env>>) -> i32 { return route.cfg.v }
effect<'env> fn envRepresented<'c, 'env>(route: EnvRoute<'c>, cb: &mut fn<'env>() -> i32) -> i32 { return route.cfg.v }
fn envReadCfg(x: i32, r: &EnvCfg) -> i32 { return r.v + x }
effect<'env> fn envSmuggle<'c, 'env>(route: EnvRoute<'c>, cb: &mut fn<'env>(i32) -> i32) -> i32 { let smuggled = envReadCfg(&route.cfg.*)  cb.* = smuggled  return 0 }
fn routedUnrun() -> i32 { let config = EnvCfg {v: 3}  let route = envSelect(&config)  return envRun(envRouted(move route, Tok {v: 1})) }
fn routedLetRun() -> i32 { let config = EnvCfg {v: 3}  let route = envSelect(&config)  let e = envRouted(move route, Tok {v: 1})  return run e }
fn routedRow() -> i32 { let config = EnvCfg {v: 3}  let route = envSelect(&config)  return envRun(envRoutedRow<never>(move route)) }
fn routedKept() -> i32 { let config = EnvCfg {v: 3}  let route = envSelect(&config)  let r = run envPick(move route)  return r.* }
fn routedRepresented() -> i32 { let config = EnvCfg {v: 3}  let route = envSelect(&config)  let mut f = envPlain  return envRun(envRepresented(move route, &mut f)) }
fn routedStored<'p>(slot: &mut Slot<'p>) -> () { let stored = EnvCfg {v: 3}  let route = envSelect(&stored)  slot.r = run envPick(move route)  return () }
fn routedPinned<'p>(slot: &mut Slot<'p>) -> i32 { let config = EnvCfg {v: 3}  let route = envSelect(&config)  return envRun(envPinned(move route, &mut slot.*)) }
fn routedInvariant() -> i32 { let config = EnvCfg {v: 3}  let route = envSelect(&config)  let mut c: EnvCell<string<'static>> = EnvCell<string<'static>> {v: "lit"}  return envRun(envInvariant(move route, &mut c)) }
fn routedShared() -> i32 { let config = EnvCfg {v: 3}  let route = envSelect(&config)  let c = EnvCell<string<'static>> {v: "lit"}  return envRun(envShared(move route, &c)) }
fn ownerGenericFirstOwed<'p>(x: &'p i32) -> i32 { let c = 5  return run OwnerW<&i32>.put(&c, x) }
fn genericFirstEscapes<'p>(x: &'p i32) -> once Effect<'p; i32> { let c = Cell {v: 7}  return run hideT(&c, rdCell, x) }
