fn identity(token: &Token) -> &Token { return token }
fn pick<'a>(left: &'a Token, right: &Token) -> &'a Token { return left }
fn shorten<'long: 'short, 'short>(token: &'long Token) -> &'short Token { return token }
fn same<T>(value: T) -> T { return move value }
fn pull<'a>(holder: &mut Holder<'a>) -> &'a Token { return holder.value }
fn label(token: &Token) -> string<'static> { return "label" }
fn size(text: string) -> i32 { return 1 }
fn viewAfterLastUse() -> i32 {
