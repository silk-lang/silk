effect fn finalInferenceSourceClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("final-inference-goals.silk")
  let text = """
fn choose<'a>(first: &'a [u8], second: &'a [u8]) -> &'a [u8] { return second }
fn forward<'a>(value: &'a [u8]) -> &'a [u8] { return choose(b"first", value) }
fn reversed<'a>(value: &'a [u8]) -> &'a [u8] { return choose(value, b"second") }
fn fixedSection<'a>(value: &'a [u8]) -> &'a [u8] { let next = choose(b"second") return next(value) }
fn callable<'a>(callback: for<'call> fn<'static>(&'call [u8], &'call [u8]) -> &'call [u8], value: &'a [u8]) -> &'a [u8] {
  return callback(b"first", value)
}
struct Pair<'a, 'b> { first: &'a [u8] second: &'b [u8] }
fn chooseTwo<'a, 'b>(a: &'a [u8], b: &'a [u8], c: &'b [u8], d: &'b [u8]) -> Pair<'a, 'b> {
  return Pair<'a, 'b> {first: b, second: d}
}
fn independent<'a, 'b>(a: &'a [u8], b: &'b [u8]) -> Pair<'a, 'b> {
  return chooseTwo(b"first", a, b"second", b)
}
fn escape<'a>(value: &'a [u8]) -> &'static [u8] { return choose(b"first", value) }
fn explicit<'a>(value: &'a [u8]) -> &'static [u8] { return choose<'static>(b"first", value) }
struct Holder<'a> { value: &'a [u8] }
fn put<'a>(target: &mut Holder<'a>, value: &'a [u8]) -> () { target.value = value }
fn invariant<'a>(target: &mut Holder<'static>, value: &'a [u8]) -> () { put(&mut target.*, value) }
fn owned() -> &'static [u8] { let data: [u8; 1] = [1] let view: &[u8] = &data return choose(b"first", view) }
fn captured<'a>(value: &'a [u8]) -> fn<'static>() -> u8 {
  let picked = choose(b"first", value)
  return fn() -> u8 { return picked[0] }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let forward = run Semantic.demandBody(&mut store, &mut request, &id, b"forward")
  let reversed = run Semantic.demandBody(&mut store, &mut request, &id, b"reversed")
  let callable = run Semantic.demandBody(&mut store, &mut request, &id, b"callable")
  let fixedSection = run Semantic.demandBody(&mut store, &mut request, &id, b"fixedSection")
  let independent = run Semantic.demandBody(&mut store, &mut request, &id, b"independent")
  let escape = run Semantic.demandBody(&mut store, &mut request, &id, b"escape")
  let explicit = run Semantic.demandBody(&mut store, &mut request, &id, b"explicit")
  let invariant = run Semantic.demandBody(&mut store, &mut request, &id, b"invariant")
  let owned = run Semantic.demandBody(&mut store, &mut request, &id, b"owned")
  let captured = run Semantic.demandBody(&mut store, &mut request, &id, b"captured")
  run Testing.expect(hasBorrowStatus(&forward, BodyBorrowStatus.Checked), "an inferred static-first operand shortens to the actual caller lifetime")
  run Testing.expect(hasBorrowStatus(&reversed, BodyBorrowStatus.Checked), "reversing operands preserves the same lifetime validity")
  run Testing.expect(hasBorrowStatus(&callable, BodyBorrowStatus.Checked), "a quantified callable invocation finalizes only its own inferred region goals")
  run Testing.expect(hasBorrowStatus(&independent, BodyBorrowStatus.Checked), "two inferred binders at one call keep their distinct final caller regions")
  run Testing.expect(rejectsSpan(&fixedSection, RejectionCode.UnsatisfiedLifetimeBound, text, "value", 5), "a section with an already fixed static contract does not reopen its binder")
  run Testing.expect(rejectsSpan(&escape, RejectionCode.UnsatisfiedLifetimeBound, text, "choose(b\"first\", value)", 1), "inference cannot extend a caller lifetime to static")
  run Testing.expect(rejectsSpan(&explicit, RejectionCode.UnsatisfiedLifetimeBound, text, "value", 11), "an explicit static application is not inferred evidence")
  run Testing.expect(hasBorrowStatus(&invariant, BodyBorrowStatus.Regions), "invariant stored lifetime evidence cannot shorten")
  run Testing.expect(rejectsSpan(&owned, RejectionCode.ExpiredLifetime, text, "choose(b\"first\", view)", 0), "body-owned storage cannot escape as static")
  run Testing.expect(rejectsSpan(&captured, RejectionCode.UnsatisfiedLifetimeBound, text, "fn() -> u8 { return picked[0] }", 0), "an inferred result cannot escape through a static capture environment")
  return ()
}

test effect fn callableFutureSignatureDoesNotImplyStoredOutlives() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run callableContentsGuardClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn callableContentsGuardClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("callable-contents-guard.silk")
  let text = """
fn require<'a, 'b: 'a>(value: &'b i32) -> i32 { return value.* }
fn boundOnly<'a, 'b>(callable: &'a fn(&'b i32) -> i32, value: &'b i32) -> i32 { return require<'a, 'b>(value) }
fn staged<'a, 'b>(callable: &'a fn(&'b i32) -> i32, value: &'b i32) -> &'a i32 {
  let view = &value.*
  return view
}
fn extend<'a, 'b: 'a>(value: &'b i32) -> &'a i32 { return value }
fn control<'a, 'b>(callable: &'a fn(&'b i32) -> i32, value: &'b i32) -> i32 { return value.* }
fn wrong<'a, 'b>(callable: &'a fn(&'b i32) -> i32, value: &'b i32) -> &'a i32 {
  return extend<'a, 'b>(value)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let control = run Semantic.demandBody(&mut store, &mut request, &id, b"control")
  let helper = run Semantic.demandBody(&mut store, &mut request, &id, b"extend")
  run Testing.expect(hasBorrowStatus(&control, BodyBorrowStatus.Checked), "callable guard syntax and ordinary borrowed use are checked")
  run Testing.expect(hasBorrowStatus(&helper, BodyBorrowStatus.Checked), "an explicit declared outlives premise remains valid")
  let caller = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong")
  run Testing.expect(rejectsSpan(&caller, RejectionCode.UnsatisfiedLifetimeBound, text, "extend<'a, 'b>(value)", 0),
    "borrowing a callable cannot imply outlives from its future parameter types")
  let scalar = run Semantic.demandBody(&mut store, &mut request, &id, b"boundOnly")
  run Testing.expect(rejectsSpan(&scalar, RejectionCode.UnsatisfiedLifetimeBound, text, "require<'a, 'b>(value)", 0),
    "an independent result does not authorize a future callable parameter to prove a call bound")
  let staged = run Semantic.demandBody(&mut store, &mut request, &id, b"staged")
  run Testing.expect(!hasBorrowStatus(&staged, BodyBorrowStatus.Checked),
    "a staged local reborrow cannot use a future callable parameter as a declared escape premise")
  return ()
}

test effect fn genericCapturedContentsCoverOnlyFiniteUses() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
