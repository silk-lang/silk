      && rejectsSpan(&c22, RejectionCode.AccessDuringLoan, text, "src.t", 51)
      && rejectsSpan(&c21, RejectionCode.AccessDuringLoan, text, "src.t", 53)
      && rejectsSpan(&c25, RejectionCode.AccessDuringLoan, text, "src.t", 55)
      && rejectsSpan(&c28, RejectionCode.AccessDuringLoan, text, "src.t", 57),
