  run Testing.expect(hasBorrowStatus(&keepTwice, BodyBorrowStatus.Checked) && hasBorrowStatus(&unitsTwice, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&selectTwice, BodyBorrowStatus.Checked),
    "reborrows a call keeps only for the call stay checked: a second store into the same holder, and repeated parameter reborrows")
  let viewOnly = run Semantic.demandBody(&mut store, &mut request, &id, b"viewOnly")
  let localView = run Semantic.demandBody(&mut store, &mut request, &id, b"localView")
  run Testing.expect(succeeded(&viewOnly) && succeeded(&localView) && hasBorrowStatus(&localView, BodyBorrowStatus.Checked),
    "a universal view that nothing writes over, and a local view dead before the write, stay accepted")
  // A closure handed a holder of caller storage keeps a capture only when a slot it can write holds
  // the capture's referents: a captured struct the frame cannot hold leaves the body checked.
  let readCaptured = run Semantic.demandBody(&mut store, &mut request, &id, b"readCaptured")
  run Testing.expect(hasBorrowStatus(&readCaptured, BodyBorrowStatus.Checked),
    "a capture no slot reachable from the closure's environment, parameters or requirements can hold leaves the body checked")
  let readBuffered = run Semantic.demandBody(&mut store, &mut request, &id, b"readBuffered")
  run Testing.expect(hasBorrowStatus(&readBuffered, BodyBorrowStatus.Checked),
    "a sealed storage core holds only its runtime fields and its elements, so a captured struct owning one stays checked")
  let shelveField = run Semantic.demandBody(&mut store, &mut request, &id, b"shelveField")
  let shelveUnion = run Semantic.demandBody(&mut store, &mut request, &id, b"shelveUnion")
  let shelveGeneric = run Semantic.demandBody(&mut store, &mut request, &id, b"shelveGeneric")
  let shelveClosure = run Semantic.demandBody(&mut store, &mut request, &id, b"shelveClosure")
  run Testing.expect(rejectsSpan(&shelveField, RejectionCode.AccessDuringLoan, text, "srcH1.t", 1)
      && rejectsSpan(&shelveUnion, RejectionCode.AccessDuringLoan, text, "srcH2.t", 1)
      && rejectsSpan(&shelveGeneric, RejectionCode.AccessDuringLoan, text, "srcH3.t", 1)
      && rejectsSpan(&shelveClosure, RejectionCode.AccessDuringLoan, text, "srcH4.t", 1),
    "a captured universal view a closure can store in a reference field, a union payload, a generic holder or a nested closure's environment escapes (OWN0011)")
  // A body loan can be given only to a slot whose region a body region can outlive. A closure body
  // stores a captured local only where its own statements store it, so a captured local whose only
  // reachable slots name universal regions stays in the closure's environment, generic or not; only a
  // store the closure body makes is rejected.
  let localBesideUniversal = run Semantic.demandBody(&mut store, &mut request, &id, b"localBesideUniversal")
  let localByMutCallable = run Semantic.demandBody(&mut store, &mut request, &id, b"localByMutCallable")
  run Testing.expect(hasBorrowStatus(&localBesideUniversal, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&localByMutCallable, BodyBorrowStatus.Checked),
    "a captured local whose only reachable slots name universal regions stays in a checked closure's environment")
  let localGeneric = run Semantic.demandBody(&mut store, &mut request, &id, b"localGeneric")
  let localBesideUncheckedBody = run Semantic.demandBody(&mut store, &mut request, &id, b"localBesideUncheckedBody")
  run Testing.expect(hasBorrowStatus(&localGeneric, BodyBorrowStatus.Checked)
      && hasBorrowStatus(&localBesideUncheckedBody, BodyBorrowStatus.Checked),
    "a generic closure, or a closure that stores a loan only in its own local slot, stores no captured local, so the body is checked")
  let localStoredUniversal = run Semantic.demandBody(&mut store, &mut request, &id, b"localStoredUniversal")
  let localNestedStore = run Semantic.demandBody(&mut store, &mut request, &id, b"localNestedStore")
  let localByMutCallableStore = run Semantic.demandBody(&mut store, &mut request, &id, b"localByMutCallableStore")
  run Testing.expect(rejectsSpan(&localStoredUniversal, RejectionCode.UnsatisfiedLifetimeBound, text, "kept1", usize.ONE)
      && rejectsSpan(&localNestedStore, RejectionCode.UnsatisfiedLifetimeBound, text, "kept2", usize.ONE),
    "a closure body storing a captured local into a universal slot, directly or through a nested closure, is rejected at its capture (SEM0212)")
  run Testing.expect(hasBorrowStatus(&localByMutCallableStore, BodyBorrowStatus.Checked),
    "a closure behind `&mut F` storing a captured local into a body slot it outlives is checked")
  // A slot of a type parameter the body's callers choose holds a value of that type, which names no
  // body region: a captured local stays in a checked closure's environment beside one, while a
  // universal view stored through a conformance still escapes and a body loan written into erased
  // storage is still refuted.
  let localBesideParameter = run Semantic.demandBody(&mut store, &mut request, &id, b"localBesideParameter")
  run Testing.expect(hasBorrowStatus(&localBesideParameter, BodyBorrowStatus.Checked),
    "a captured local beside a slot of a caller-chosen type parameter stays in a checked closure's environment")
  let localBesideParameterLocalSlot = run Semantic.demandBody(&mut store, &mut request, &id, b"localBesideParameterLocalSlot")
  run Testing.expect(hasBorrowStatus(&localBesideParameterLocalSlot, BodyBorrowStatus.Checked),
    "a closure that writes only a scalar field of a body-region slot beside a caller-chosen type parameter stores no captured local")
  let mrConformUniversal = run Semantic.demandBody(&mut store, &mut request, &id, b"mrConformUniversal")
  let mrErased = run Semantic.demandBody(&mut store, &mut request, &id, b"mrErased")
  run Testing.expect(rejectsSpan(&mrConformUniversal, RejectionCode.AccessDuringLoan, text, "srcM1.t", usize.ONE)
      && rejectsSpan(&mrErased, RejectionCode.UnsatisfiedLifetimeBound, text, "localM4", usize.ONE),
    "a universal view stored through a caller-chosen conformance escapes (OWN0011), and a body loan written into erased storage is refuted (SEM0212)")
  return ()
}

test effect fn closedRegionAtomsAcceptEnclosingUniversals() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run closedRegionAtomClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn closedRegionAtomClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("closed-region-atoms.silk")
  let text = """
struct Holder<'a> {
  value: &'a i32,
}
fn put<'b>(slot: &mut Holder<'b>, value: &'b i32) -> () { slot.value = value }
impl<'a> Holder<'a> {
  fn get(self: &Self) -> &'a i32 { return self.value }
  fn leak(self: &Self) -> &'a i32 { let inner = 7 return &inner }
  fn set(self: &mut Self) -> () { let inner = 7 put(&mut self.*, &inner) }
}
struct Pair<'a, 'b> {
  first: &'a i32,
  second: &'b i32,
}
fn choose<'x>(left: &'x i32, right: &'x i32) -> &'x i32 { return left }
impl<'a, 'b> Pair<'a, 'b> {
  fn mixed(self: &Self) -> &'a i32 { return choose(self.first, self.second) }
}
fn captured<'a>(value: &'a i32) -> i32 {
  let read = fn() -> i32 { return value.* }
  return read()
}
fn borrowedLocal() -> i32 {
  let x = 5
  let view = &x
  let read = fn() -> i32 { return view.* }
  return read()
}
fn invoked() -> i32 {
  let increment = fn(value: &i32) -> i32 { return value.* + 1 }
  let x = 1
  return increment(&x)
}
fn stored<'a>(holder: &mut Holder<'a>) -> () {
  let write = fn(slot: &mut Holder<'a>) -> () { let inner = 7 put(&mut slot.*, &inner) }
  write(&mut holder.*)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let source = run present(text)
  let mut index = SourceIndex.make(run Revision.publish(&Revision.make(), &id, &source))
  let getId = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"get", usize.ZERO)
  let leakId = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"leak", usize.ZERO)
  let setId = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"set", usize.ZERO)
  let get = run Semantic.demandBodyOf(&mut store, &mut request, &getId)
  let leak = run Semantic.demandBodyOf(&mut store, &mut request, &leakId)
  let set = run Semantic.demandBodyOf(&mut store, &mut request, &setId)
  let mixedId = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"mixed", usize.ZERO)
  let mixed = run Semantic.demandBodyOf(&mut store, &mut request, &mixedId)
  let captured = run Semantic.demandBody(&mut store, &mut request, &id, b"captured")
  let borrowedLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowedLocal")
  let invoked = run Semantic.demandBody(&mut store, &mut request, &id, b"invoked")
  let stored = run Semantic.demandBody(&mut store, &mut request, &id, b"stored")
  run Testing.expect(hasBorrowStatus(&get, BodyBorrowStatus.Checked), "an impl's lifetime parameter is universal in its method")
  run Testing.expect(rejectsSpan(&leak, RejectionCode.UnsatisfiedLifetimeBound, text, "&inner", usize.ZERO),
    "a method local cannot gain its impl's lifetime (SEM0212 at the borrow)")
  run Testing.expect(rejectsSpan(&set, RejectionCode.UnsatisfiedLifetimeBound, text, "&inner", 1),
    "a borrow of a method local that a call keeps in its impl's lifetime cannot outlive it (SEM0212)")
  run Testing.expect(rejectsSpan(&mixed, RejectionCode.UnsatisfiedLifetimeBound, text, "choose(self.first, self.second)", 0),
    "enclosing parameters are universal but unrelated: 'b : 'a has no premise, so the result is not in 'a (SEM0212)")
  run Testing.expect(hasBorrowStatus(&captured, BodyBorrowStatus.Checked) && anonymousStatus(&captured, BodyBorrowStatus.Checked),
    "an enclosing function's lifetime parameter is universal in its anonymous body")
  run Testing.expect(hasBorrowStatus(&borrowedLocal, BodyBorrowStatus.Checked) && anonymousStatus(&borrowedLocal, BodyBorrowStatus.Checked),
    "an enclosing local's loan region is a capture dependency the enclosing body bounds")
  run Testing.expect(hasBorrowStatus(&invoked, BodyBorrowStatus.Checked) && anonymousStatus(&invoked, BodyBorrowStatus.Checked),
    "a callable value's contract binders name no held region, and a literal's invocation binders are universal in it")
  run Testing.expect(rejectsSpan(&stored, RejectionCode.UnsatisfiedLifetimeBound, text, "&inner", 2),
    "a borrow of a nested local that a call keeps in an enclosing lifetime parameter cannot outlive it (SEM0212)")
  return ()
}

test effect fn sharedLoanRegionsUniteRequirements() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
