effect fn anonymousPatternClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("capture-patterns.silk")
  let text = """
struct Token { value: i32 }
struct Envelope { token: Token }
fn patternCapture(token: Token) -> () {
  match &token { Token { value: patternValue } => {
    let closure = fn() -> i32 { return patternValue }
  } }
}
fn borrowedPatternCapture(envelope: Envelope) -> () {
  match &envelope { Envelope { token: patternToken } => {
    let closure = fn() -> i32 { return patternToken.value }
  } }
}
fn movedPatternCapture(envelope: Envelope) -> () {
  match move envelope { Envelope { token: ownedToken } => {
    let closure = fn() -> Token { return move ownedToken }
  } }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let pattern = run Semantic.demandBody(&mut store, &mut request, &id, b"patternCapture")
  let borrowedPattern = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowedPatternCapture")
  let movedPattern = run Semantic.demandBody(&mut store, &mut request, &id, b"movedPatternCapture")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&pattern, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Shared, usize.ONE, usize.MAX, usize.ONE, false)
  }) && Shared.with<Result<Answer, NoRejection>, bool>(&borrowedPattern, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Shared, usize.ONE, usize.MAX, usize.ONE, true)
  }) && Shared.with<Result<Answer, NoRejection>, bool>(&movedPattern, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return captureBodyMatches(answer, CallableMode.Once, usize.ONE, usize.MAX, usize.ONE, false)
  }), "pattern captures retain their parent Copy, borrowed, or moved place")
}

test effect fn anonymousCapturesKeepOwnershipAndUnsafeSpans() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run anonymousCaptureRejections() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn anonymousCaptureRejections() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("capture-rejections.silk")
  let text = """
struct Token { value: i32 }
struct Envelope { token: Token }
fn invalidMutation() -> () {
  let mut counter = 0
  let blocked = fn() -> () { counter = 1 }
  blocked()
}
fn invalidPatternCapture(envelope: Envelope) -> () {
  match &envelope { Envelope { token: loanedToken } => {
    let closure = fn() -> Token { let earlier = loanedToken.value return move loanedToken }
  } }
}
unsafe fn guarded(value: i32) -> i32 { return value }
fn delayedUnsafe() -> () {
  unsafe { let closure = fn() -> i32 { return guarded(42) } }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let invalidMutation = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidMutation")
  let invalidPattern = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidPatternCapture")
  let delayedUnsafe = run Semantic.demandBody(&mut store, &mut request, &id, b"delayedUnsafe")
  run Testing.expect(rejectsSpan(&invalidMutation, RejectionCode.InvalidCallableInvocationAccess, text, "blocked", usize.ONE),
    "mutable callable invocation requires a mutable binding at the callee span")
  run Testing.expect(rejectsSpan(&invalidPattern, RejectionCode.MatchBorrowEscape, text, "move loanedToken", usize.ZERO),
    "borrowed pattern capture ownership diagnostics name the requesting operation")
  run Testing.expect(rejectsSpan(&delayedUnsafe, RejectionCode.UnsafeAcknowledgement, text, "guarded(42)", usize.ZERO),
    "permission at construction does not authorize an unsafe delayed body")
}

fn anonymousInvocationFacts(answer: &Result<Answer, NoRejection>) -> bool {
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedBody(answer) {
    return Shared.with<TypedBody, bool>(&body, fn(value: &TypedBody) -> bool {
      let nodes = TypedBody.nodeSlice(value)
      let mut at = usize.ZERO
      while at < nodes.length {
        if let BodyNodeKind.Expression {form: BodyExpression.CallableCall {callee, mode, arguments, pipeline, ..}, ..} = &nodes[at].kind {
          if mode != CallableMode.Shared || pipeline || Vector.length<BodyNodeId>(&arguments) != usize.ONE { return false }
          if let BodyNodeKind.Expression {ty, ..} = &nodes[callee.index].kind {
            return Shared.with<Type, bool>(&ty, exactCallableValue)
          }
        }
        at = at + usize.ONE
      }
      return false
    })
  }
  return false
}

