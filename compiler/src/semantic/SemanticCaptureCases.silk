effect fn r3LoopGuardClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("r3-loop-guards.silk")
  let text = """
fn expired(count: i32) -> i32 {
  let outer = 1
  let mut view = &outer
  let mut at = 0
  let mut sum = 0
  while at < count {
    sum = sum + view.*
    let inner = at
    view = &inner
    at = at + 1
  }
  return sum
}
fn carried<'a>(source: &'a i32, count: i32) -> i32 {
  let mut view = &source.*
  let mut at = 0
  let mut sum = 0
  while at < count {
    sum = sum + view.*
    view = &source.*
    at = at + 1
  }
  return sum
}
fn local(count: i32) -> i32 {
  let first = 1
  let second = 2
  let mut view = &first
  let mut at = 0
  let mut sum = 0
  while at < count {
    sum = sum + view.*
    view = &second
    at = at + 1
  }
  return sum
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let expired = run Semantic.demandBody(&mut store, &mut request, &id, b"expired")
  let carried = run Semantic.demandBody(&mut store, &mut request, &id, b"carried")
  let local = run Semantic.demandBody(&mut store, &mut request, &id, b"local")
  run Testing.expect(rejectsSpan(&expired, RejectionCode.ExpiredLifetime, text,
    "{\n    sum = sum + view.*\n    let inner = at\n    view = &inner\n    at = at + 1\n  }", usize.ZERO),
    "a loop-carried holder cannot use a borrow after the preceding iteration ended its storage (OWN0019)")
  run Testing.expect(hasBorrowStatus(&carried, BodyBorrowStatus.Regions),
    "a parameter reborrow carried over a back edge retains its crossed-region obligation")
  run Testing.expect(hasBorrowStatus(&local, BodyBorrowStatus.Regions),
    "a reassigned local holder's unmapped region stays pending across a back edge")
  return ()
}

