  let mut second = Token {value: 2}
  let held = &second
  let view = pickFirst(&first, held)
  second = Token {value: 3}
  return view.value
}
struct Shelf<'b> {
  inner: &'b Token
}
fn unshelve<'a, 'b>(outer: &'a Shelf<'b>) -> &'a Token { return outer.inner }
impl<'b> Shelf<'b> {
  fn shelved<'a>(self: &'a Shelf<'b>) -> &'a Token { return self.inner }
}
fn unshelveThenReplace() -> i32 {
  let mut held = Token {value: 1}
  let shelf = Shelf {inner: &held}
  let view = unshelve(&shelf)
  held = Token {value: 2}
  return view.value
}
struct Couple {
  left: Token
  right: Token
}
effect fn loanAcrossSuspension() -> i32 {
  let mut cell = Token {value: 1}
  let view = &cell
  let next = run Intrinsic.suspendEffect(effect { return 2 })
  cell = Token {value: next}
  return view.value
}
effect fn loanBeforeSuspension() -> i32 {
  let mut cell = Token {value: 1}
  let view = &cell
  let seen = view.value
  let next = run Intrinsic.suspendEffect(effect { return 2 })
  cell = Token {value: next}
  return seen + cell.value
}
effect fn movedAcrossSuspension(owned: Couple) -> i32 {
