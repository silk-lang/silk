effect fn enclosingOwnerSectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("enclosing-owner-section.silk")
  let text = """
struct Box<T> { value: T }
impl<T> Box<T> {
  fn select(self: Self, fallback: T) -> T { drop fallback return move self.value }
  fn pick<T: Copy>(self: &Self, index: usize) -> T { return self.value }
}
union Choice<T> { Present { value: T }, Absent }
impl<T> Choice<T> {
  fn present(value: T) -> Choice<T> { return Choice<T>.Present { value: move value } }
  fn absent() -> Choice<T> { return Choice<T>.Absent }
}
fn checked<R>(value: u8, present: once fn(u8) -> R, absent: once fn() -> R) -> R { drop absent return present(value) }
fn stored() -> i32 { let selected = Box.select(0) return selected(Box {value: 42}) }
fn piped() -> i32 { return Box {value: 42} |> Box.select(0) }
fn borrowed() -> i32 { let boxed = Box {value: 42} return &boxed |> Box.pick<i32>(1) }
fn carriers() -> Choice<u8> { return checked<Choice<u8>>(7, Choice.present, Choice.absent) }
fn unapplied() -> () { let bare = Choice.present }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let stored = run Semantic.demandMir(&mut store, &mut request, &id, b"stored")
  let piped = run Semantic.demandMir(&mut store, &mut request, &id, b"piped")
  run Testing.expect(succeeded(&stored) && sectionInvocationCount(&store, &stored, b"select", false) == usize.ONE,
    "a closed section substitutes enclosing impl evidence into its stored leading parameter and calls the original target")
  run Testing.expect(succeeded(&piped) && sectionInvocationCount(&store, &piped, b"select", false) == usize.ONE,
    "pipeline application uses the same closed leading parameter without retaining a raw enclosing owner binder")
  let borrowed = run Semantic.demandMir(&mut store, &mut request, &id, b"borrowed")
  let picked = match move namedMirApplication(&store, &borrowed, b"pick") {
    Option<Shared<SpecializationApplication>>.Some {value} => Shared.with<SpecializationApplication, bool>(&value,
      fn(application: &SpecializationApplication) -> bool { return implScopeApplication(application, b"i32") })
    Option<Shared<SpecializationApplication>>.None => false
  }
  run Testing.expect(succeeded(&borrowed) && sectionInvocationCount(&store, &borrowed, b"pick", false) == usize.ONE && picked,
    "a deferred section over an impl member keeps the written impl argument as selected evidence and lets the piped borrow supply its own lifetime")
  let carriers = run Semantic.demandBody(&mut store, &mut request, &id, b"carriers")
  run Testing.expect(succeeded(&carriers) && implScopedValues(&carriers, b"u8") == 3,
    "generic impl members used as values take their impl binder from the promised parameter and result of the callable contract")
  let unapplied = run Semantic.demandBody(&mut store, &mut request, &id, b"unapplied")
  run Testing.expect(rejectsSpan(&unapplied, RejectionCode.Unsupported, text, "Choice.present", usize.ONE),
    "without a contract an impl member value would defer its impl binder, which a section schema does not represent")
}

// Whether an application binds exactly one enclosing impl slot, to the named primitive.
fn implScopeApplication(value: &SpecializationApplication, primitive: &[u8]) -> bool {
  let scopes = Vector.asSlice<ScopeBinding>(&value.scopes)
  if scopes.length != usize.ONE { return false }
  let arguments = Vector.asSlice<Argument>(&scopes[usize.ZERO].arguments)
  return arguments.length == usize.ONE && applicationArgumentIs(&arguments[usize.ZERO], primitive)
}

// The closed `present` (1) and `absent` (2) callable values whose own application is empty and
// whose one impl slot is the primitive, as a set of flags.
fn implScopedValues(answer: &Shared<Result<Answer, NoRejection>>, primitive: &[u8]) -> usize {
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, usize>(&value, fn(checked: &TypedBody) -> usize {
      return implScopedFlags(TypedBody.nodeSlice(checked), primitive)
    })
  }
  return usize.ZERO
}

fn implScopedFlags(nodes: &[BodyNode], primitive: &[u8]) -> usize {
  let mut present = false
  let mut absent = false
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, ..} = &nodes[at].kind {
      if Shared.with<Type, bool>(&ty, fn(found: &Type) -> bool { return implScopedValue(found, b"present", primitive) }) {
        present = true
      }
      if Shared.with<Type, bool>(&ty, fn(found: &Type) -> bool { return implScopedValue(found, b"absent", primitive) }) {
        absent = true
      }
    }
    at = at + usize.ONE
  }
  let mut flags = usize.ZERO
  if present { flags = flags + usize.ONE }
  if absent { flags = flags + 2 }
  return flags
}

fn implScopedValue(value: &Type, target: &[u8], primitive: &[u8]) -> bool {
  if let Type.CallableValue {application, ..} = &value.* {
    return Shared.with<SpecializationApplication, bool>(&application, fn(selected: &SpecializationApplication) -> bool {
      return DeclarationId.named(SpecializationApplication.bodyDeclaration(selected), target)
        && Vector.length<Argument>(&selected.arguments) == usize.ZERO && implScopeApplication(selected, primitive)
    })
  }
  return false
}

fn stagedMutableStorage(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut at = usize.ZERO
      while at < blocks.length {
        if stagedMutableRef(Vector.asSlice<MirStatement>(&blocks[at].statements), locals) { return true }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn stagedMutableRef(statements: &[MirStatement], locals: &[MirLocal]) -> bool {
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Assign {value: MirRvalue.Ref {access, place}, ..} = &statements[at] {
      if access == Access.Mutable && Vector.length<MirProjection>(&place.projections) == usize.ONE {
        if let MirProjection.Field {index} = &Vector.asSlice<MirProjection>(&place.projections)[usize.ZERO] {
          if let MirLocalKind.User {index: original} = &locals[place.local].kind {
            if index == usize.ZERO && original == 2 { return true }
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn stagedSharedSectionsLendOriginalEnvironment() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let text = """
fn main() -> i32 {
  let base = 10
  let original = fn(first: i32, last: i32) -> i32 { return base + first + last }
  let next = original(2)
  return next(1)
}
"""
  return run stagedAnonymousClaims(text, CallableMode.Shared) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn stagedMutableSectionsTransferAndBorrowOriginalStorage() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let text = """
fn main() -> i32 {
  let mut counter = 0
  let mut original = fn(first: i32, last: i32) -> i32 { counter = counter + first + last return counter }
  let mut next = original(2)
  let first = next(1)
  return first + next(3)
}
fn reusedMutable() -> i32 {
  let mut counter = 0
  let mut transferred = fn(first: i32, last: i32) -> i32 { counter = counter + first + last return counter }
  let mut next = transferred(2)
  return transferred(1, 3)
}
"""
  return run stagedAnonymousClaims(text, CallableMode.Mutable) |> Effect.provideMut<Allocator>(&mut allocator)
}

