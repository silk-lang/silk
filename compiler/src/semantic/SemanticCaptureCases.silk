effect fn unavailableCaptureClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("unavailable-captures.silk")
  let text = """
struct Token { value: i32 }
fn ended(gone: Token) -> () { drop gone let closure = fn() -> i32 { return gone.value } }
fn copiedEnded(copiedSource: i32) -> () { drop copiedSource let closure = fn() -> i32 { return copiedSource } }
fn branchEnded(branchSource: Token, flag: bool) -> () {
  if flag { drop branchSource }
  let closure = fn() -> i32 { return branchSource.value }
}
fn onceEnded(onceSource: Token) -> () {
  let first = fn() -> Token { return move onceSource }
  let second = fn() -> i32 { return onceSource.value }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let ended = run Semantic.demandBody(&mut store, &mut request, &id, b"ended")
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copiedEnded")
  let branched = run Semantic.demandBody(&mut store, &mut request, &id, b"branchEnded")
  let transferred = run Semantic.demandBody(&mut store, &mut request, &id, b"onceEnded")
  run Testing.expect(rejectsSpan(&ended, RejectionCode.UseAfterMove, text, "gone", 2) &&
    rejectsSpan(&copied, RejectionCode.UseAfterMove, text, "copiedSource", 2),
    "captures cannot acquire consumed affine or cleanup-free Copy storage")
  run Testing.expect(rejectsSpan(&branched, RejectionCode.UseAfterMove, text, "branchSource", 2) &&
    rejectsSpan(&transferred, RejectionCode.UseAfterMove, text, "onceSource", 2),
    "any completing consumed path prevents a later capture, including a once environment transfer")
}

