  let ifLetPayloadKeep = run Semantic.demandBody(&mut store, &mut request, &id, b"ifLetPayloadKeep") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let destructureKeep = run Semantic.demandBody(&mut store, &mut request, &id, b"destructureKeep") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
