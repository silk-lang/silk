  let o3Through = run Semantic.demandBody(&mut store, &mut request, &id, b"o3Through")
  let o3ThroughMut = run Semantic.demandBody(&mut store, &mut request, &id, b"o3ThroughMut")
  let o3Method = run Semantic.demandBody(&mut store, &mut request, &id, b"o3Method")
