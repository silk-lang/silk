//! The declared header of one package parameter, independent of default evaluation.

import semantic.DeclarationId {DeclarationId}
import semantic.SourceLocations {Location}
import semantic.Type {Type}
import silk.shared {Shared}

/// One authored package parameter's resolved header.
pub struct ParameterSchema {
  /// Alias-independent declaration identity.
  pub declaration: DeclarationId
  /// The written, resolved type.
  pub ty: Shared<Type>
  /// Only public parameters can receive an external binding.
  pub isPublic: bool
  /// Whether an initializer is written; a private parameter must have one.
  pub hasDefault: bool
  /// Whether final-profile validation is written.
  pub hasValidation: bool
  /// The header's significant-token boundaries relative to this declaration.
  pub location: Location
}
