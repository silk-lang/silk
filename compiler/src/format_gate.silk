//! Entry point for the repository-wide native formatter safety gate.

import format.Gate as Gate {GateFailure}
import silk.allocator {OutOfMemoryError}
import silk.filesystem {FileError}
import silk.host_input {HostInput, HostInputError}
import silk.writer {WriterError}

pub effect fn main() -> i32
! GateFailure | OutOfMemoryError | WriterError | FileError | HostInputError ? &mut HostInput {
  return run Gate.main()
}
