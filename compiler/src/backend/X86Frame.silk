//! Stack frame layout and interval-colored slot allocation for x86-64 functions.
//!
//! # When to use
//! Call [`X86Frame.plan`] on a finished [`SsaFunction`] before emitting machine code in
//! `X86Emit`. The returned [`FramePlan`] assigns every MIR stack slot and every non-constant SSA
//! value a negative `rbp`-relative byte offset, reserves the 176-byte SysV variadic register-save
//! area when `Operation.VaStart` is present, and computes the exact 16-byte-aligned stack
//! subtraction size and callee-saved register mask.
//!
//! # Details
//! - MIR stack slots marked by `StackLifetimes` (`SlotStart`/`SlotEnd`) share frame storage when
//!   their live intervals (extended over any overlapping CFG back-edges) do not overlap.
//! - Non-constant SSA values share 8-byte and 16-byte home slots via linear live-interval
//!   coloring, keeping stack frames small in deeply recursive compiler functions.
//! - Because `push rbp; mov rbp, rsp` aligns `rsp` to 16 bytes on entry, `8 * savedCount +
//!   localBytes` is rounded up to a multiple of 16 so every outgoing `call` sees a 16-byte-aligned
//!   stack pointer.

import backend.SsaFunction {Binary, Cast, Definition, Edge, Exit, InlineAsm, Kind, Operation, SsaFunction, none}
import backend.X86Asm
import backend.X86Asm {Constraint, ConstraintKind}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.ownership {Copy}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.i32
import silk.num.i64
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// Sentinel register index indicating an SSA value is homed in memory (or is a constant/unit).
pub fn regNone() -> u8 { return 255 }

/// Complete stack frame layout and register assignment for one compiled x86-64 function.
pub struct FramePlan {
  /// Negative `rbp`-relative byte offset of each MIR stack slot `0 .. slotCount - 1`.
  pub slotOffsets: List<i32>,
  /// Negative `rbp`-relative byte offset of each SSA value `0 .. valueCount - 1` (0 for constants,
  /// unit values, rematerialized slot addresses, and values homed in GPR or XMM registers).
  pub valueOffsets: List<i32>,
  /// Allocated byte size of each SSA value's home slot (0, 8, 16, or rounded multiple of 16).
  pub valueSizes: List<usize>,
  /// Assigned GPR (`rbx=3, r12..r15`, or caller-saved `rsi=6, rdi=7, r8=8, r9=9`) for each SSA
  /// value `0 .. valueCount - 1`, or [`regNone`] (`255`) when not homed in a GPR.
  pub valueRegs: List<u8>,
  /// Assigned caller-saved XMM register (`xmm4..xmm15`) for scalar float or 128-bit SSE2 vector
  /// SSA values `0 .. valueCount - 1`, or [`regNone`] (`255`) when homed in `valueOffsets`.
  pub valueXmms: List<u8>,
  /// Emission order of basic blocks: reachable non-trap blocks in RPO, then cold `Exit.Trap`
  /// blocks, then unreachable blocks.
  pub blockOrder: List<usize>,
  /// Negative `rbp`-relative byte offset for SSA values known to equal `rbp + disp` (from
  /// `SlotAddress` and constant `Offset`/`Index` chains), or 0 otherwise.
  pub valueSlotBase: List<i32>,
  /// Total non-removed use count of each SSA value `0 .. valueCount - 1`.
  pub valueUses: List<usize>,
  /// True when the function contains `Operation.VaStart`.
  pub hasVaStart: bool,
  /// Negative `rbp`-relative offset of the 176-byte SysV variadic register-save area when
  /// `hasVaStart` is true, else 0.
  pub regSaveOffset: i32,
  /// Bitmask of callee-saved GPRs (`rbx=3, r12=12, r13=13, r14=14, r15=15`) that prologue must
  /// push and epilogue must pop.
  pub savedCalleeMask: u64,
  /// Number of callee-saved GPRs in `savedCalleeMask`.
  pub savedCount: usize,
  /// Byte count subtracted from `rsp` after pushing callee-saved GPRs (`8 * savedCount +
  /// subRspBytes` is always a multiple of 16).
  pub subRspBytes: u64,
  /// True when the function contains `Operation.DynamicSlot` (so `rsp` may move below the fixed
  /// frame during execution).
  pub hasDynamicSlot: bool,
  /// True when the function contains any non-removed `Operation.InlineAsm`.
  pub hasInlineAsm: bool,
}

struct Interval {
  start: usize,
  end: usize,
  hasStart: bool,
  hasEnd: bool,
  unmarked: bool,
}

impl Copy for Interval {}

struct Range {
  start: usize,
  end: usize,
}

impl Copy for Range {}

struct BackEdge {
  headerPoint: usize,
  latchPoint: usize,
}

impl Copy for BackEdge {}

struct ReusableSlot {
  rbpOffset: i32,
  size: u64,
  align: u64,
  freeAfter: usize,
}

impl Copy for ReusableSlot {}

/// Byte size of the home slot for a value of `kind` (`0` for unit, `8` for scalar <= 64-bit, `16`
/// for `i128` or <= 16-byte vector, or 16-byte-rounded `storeSize` for wider vectors).
pub fn valueSlotBytes(kind: Kind) -> usize {
  if kind.isUnit() { return usize.ZERO }
  if !kind.isVector() {
    if kind.bits > 64 { return 16 }
    return 8
  }
  let sz = kind.storeSize()
  if sz <= 16 { return 16 }
  return ((sz + 15) / 16) * 16
}

/// Computes the stack frame plan for `function`.
pub effect fn plan(function: &SsaFunction) -> FramePlan ! OutOfMemoryError ? &mut Allocator {
  let blockCount = function.blockCount()
  let slotCount = function.slotCount()
  let valueCount = function.valueCount()

  // Compute Reverse Post-Order (RPO) over reachable blocks so dominators always precede dominated
  // blocks and `rpoRank[target] <= rpoRank[source]` characterizes every CFG back-edge even when
  // optimization passes (such as inlining) leave raw block indices out of RPO order.
  let mut visited = run List<u8>.makeWithCapacity(blockCount)
  let mut rpoOrder = run List<usize>.makeWithCapacity(blockCount)
  let mut rpoRank = run List<usize>.makeWithCapacity(blockCount)
  let mut blockStart = run List<usize>.makeWithCapacity(blockCount)
  let mut blockExit = run List<usize>.makeWithCapacity(blockCount)
  let mut b = usize.ZERO
  while b < blockCount {
    run List<u8>.append(&mut visited, 0)
    run List<usize>.append(&mut rpoRank, usize.ZERO)
    run List<usize>.append(&mut blockStart, usize.ZERO)
    run List<usize>.append(&mut blockExit, usize.ZERO)
    b = b + usize.ONE
  }
  if blockCount > usize.ZERO {
    let mut dfsBlocks = List<usize>.make()
    let mut dfsEdges = List<usize>.make()
    let mut postOrder = run List<usize>.makeWithCapacity(blockCount)
    let visitedMut = List<u8>.asMutSlice(&mut visited)
    visitedMut[usize.ZERO] = 1
    run List<usize>.append(&mut dfsBlocks, usize.ZERO)
    run List<usize>.append(&mut dfsEdges, usize.ZERO)
    while List<usize>.length(&dfsBlocks) > usize.ZERO {
      let top = List<usize>.length(&dfsBlocks) - usize.ONE
      let u = List<usize>.asSlice(&dfsBlocks)[top]
      let nextEdge = List<usize>.asSlice(&dfsEdges)[top]
      let edges = List<Edge>.asSlice(&function.block(u).edges)
      if nextEdge < edges.length {
        let edgesMut = List<usize>.asMutSlice(&mut dfsEdges)
        edgesMut[top] = nextEdge + usize.ONE
        let target = edges[nextEdge].block
        if target < blockCount && visitedMut[target] == 0 {
          visitedMut[target] = 1
          run List<usize>.append(&mut dfsBlocks, target)
          run List<usize>.append(&mut dfsEdges, usize.ZERO)
        }
      } else {
        drop List<usize>.remove(&mut dfsBlocks, top)
        drop List<usize>.remove(&mut dfsEdges, top)
        run List<usize>.append(&mut postOrder, u)
      }
    }
    let post = List<usize>.asSlice(&postOrder)
    // Emit reachable non-trap blocks in RPO first, then sink cold `Exit.Trap` blocks (which have
    // no outgoing edges) after all hot blocks. This preserves RPO dominance while keeping hot loops
    // dense and within rel8 branch range.
    let mut pIdx = post.length
    while pIdx > usize.ZERO {
      pIdx = pIdx - usize.ONE
      let blkId = post[pIdx]
      if blkId == usize.ZERO || function.block(blkId).exit != Exit.Trap {
        run List<usize>.append(&mut rpoOrder, blkId)
      }
    }
    pIdx = post.length
    while pIdx > usize.ZERO {
      pIdx = pIdx - usize.ONE
      let blkId = post[pIdx]
      if blkId != usize.ZERO && function.block(blkId).exit == Exit.Trap {
        run List<usize>.append(&mut rpoOrder, blkId)
      }
    }
  }
  // Place any unreachable blocks after all reachable blocks so every block has valid points.
  b = usize.ZERO
  while b < blockCount {
    if List<u8>.asSlice(&visited)[b] == 0 {
      run List<usize>.append(&mut rpoOrder, b)
    }
    b = b + usize.ONE
  }

  // Assign a linear program point to each block entry, instruction, and block exit in emission RPO.
  let orderSlice = List<usize>.asSlice(&rpoOrder)
  let rankMut = List<usize>.asMutSlice(&mut rpoRank)
  let startMut = List<usize>.asMutSlice(&mut blockStart)
  let exitMut = List<usize>.asMutSlice(&mut blockExit)
  let mut totalPoints = usize.ONE // point 0 is function entry (arguments live here)
  let mut rank = usize.ZERO
  while rank < orderSlice.length {
    let blkIdx = orderSlice[rank]
    rankMut[blkIdx] = rank
    startMut[blkIdx] = totalPoints
    let blk = function.block(blkIdx)
    let insts = List<usize>.asSlice(&blk.instructions)
    totalPoints = totalPoints + insts.length + usize.ONE
    exitMut[blkIdx] = totalPoints - usize.ONE
    rank = rank + usize.ONE
  }

  let visitedSlice = List<u8>.asSlice(&visited)
  let rankSlice = List<usize>.asSlice(&rpoRank)
  let bStart = List<usize>.asSlice(&blockStart)
  let bExit = List<usize>.asSlice(&blockExit)

  // Collect CFG back-edges (`rpoRank[target] <= rpoRank[source]`) among reachable blocks so live
  // intervals spanning a loop stay live across the entire loop body.
  let mut backEdges = List<BackEdge>.make()
  b = usize.ZERO
  while b < blockCount {
    if visitedSlice[b] != 0 {
      let blk = function.block(b)
      let edges = List<Edge>.asSlice(&blk.edges)
      let mut e = usize.ZERO
      while e < edges.length {
        let target = edges[e].block
        if target < blockCount && rankSlice[target] <= rankSlice[b] {
          run List<BackEdge>.append(&mut backEdges, BackEdge {headerPoint: bStart[target], latchPoint: bExit[b]})
        }
        e = e + usize.ONE
      }
    }
    b = b + usize.ONE
  }
  let loops = List<BackEdge>.asSlice(&backEdges)

  // Mark which blocks fall inside any CFG loop body so loop definitions and uses receive higher
  // register-allocation priority.
  let mut inLoopBlock = run List<u8>.makeWithCapacity(blockCount)
  b = usize.ZERO
  while b < blockCount {
    let mut inLp: u8 = 0
    let mut lIdx = usize.ZERO
    while lIdx < loops.length {
      if bStart[b] >= loops[lIdx].headerPoint && bStart[b] <= loops[lIdx].latchPoint {
        inLp = 1
        break
      }
      lIdx = lIdx + usize.ONE
    }
    run List<u8>.append(&mut inLoopBlock, inLp)
    b = b + usize.ONE
  }
  let inLoop = List<u8>.asSlice(&inLoopBlock)

  // Initialize MIR stack slot intervals and SSA value intervals, use counts, and weights.
  let mut slotIv = run List<Interval>.makeWithCapacity(slotCount)
  let mut s = usize.ZERO
  while s < slotCount {
    run List<Interval>.append(&mut slotIv, Interval {start: totalPoints, end: usize.ZERO, hasStart: false, hasEnd: false, unmarked: false})
    s = s + usize.ONE
  }

  let mut valIv = run List<Interval>.makeWithCapacity(valueCount)
  let mut valSizes = run List<usize>.makeWithCapacity(valueCount)
  let mut valUses = run List<usize>.makeWithCapacity(valueCount)
  let mut valWeights = run List<u64>.makeWithCapacity(valueCount)
  let mut valNoReg = run List<u8>.makeWithCapacity(valueCount)
  let mut valNoXmm = run List<u8>.makeWithCapacity(valueCount)
  let mut valSlotIdx = run List<usize>.makeWithCapacity(valueCount)
  let mut valSlotDisp = run List<i64>.makeWithCapacity(valueCount)
  let mut v = usize.ZERO
  while v < valueCount {
    let info = function.value(usize.toU64(v))
    let sz = if info.definition == Definition.Constant { usize.ZERO } else { valueSlotBytes(info.kind) }
    run List<usize>.append(&mut valSizes, sz)
    run List<usize>.append(&mut valUses, usize.ZERO)
    let mut start = totalPoints
    let mut end = usize.ZERO
    let mut initW: u64 = 0
    if info.definition == Definition.Argument && sz > usize.ZERO {
      start = usize.ZERO
      end = usize.ZERO
      initW = 1
    }
    run List<u64>.append(&mut valWeights, initW)
    run List<u8>.append(&mut valNoReg, 0)
    run List<u8>.append(&mut valNoXmm, 0)
    run List<usize>.append(&mut valSlotIdx, usize.MAX)
    run List<i64>.append(&mut valSlotDisp, 0)
    run List<Interval>.append(&mut valIv, Interval {start: start, end: end, hasStart: false, hasEnd: false, unmarked: false})
    v = v + usize.ONE
  }

  let mut hasVaStart = false
  let mut hasDynamicSlot = false
  let mut hasInlineAsm = false
  let mut reservedCalleeMask: u64 = 0
  let calleeBits: u64 = u64.shiftLeft(1, 3) | u64.shiftLeft(1, 12) | u64.shiftLeft(1, 13) | u64.shiftLeft(1, 14) | u64.shiftLeft(1, 15)
  let mut clobberGpPoints = List<usize>.make()
  let mut clobberXmmPoints = List<usize>.make()

  // Walk every block in emission RPO order to populate live ranges, use counts, SlotAddress/Offset
  // chains, clobber points, and special frame needs.
  let slotIvMut = List<Interval>.asMutSlice(&mut slotIv)
  let slotIdxMut = List<usize>.asMutSlice(&mut valSlotIdx)
  let slotDispMut = List<i64>.asMutSlice(&mut valSlotDisp)
  let mut rpoIdx = usize.ZERO
  while rpoIdx < orderSlice.length {
    b = orderSlice[rpoIdx]
    let blk = function.block(b)
    let entryPt = bStart[b]
    let isCold = b != usize.ZERO && blk.exit == Exit.Trap
    // Cold trap blocks (`Exit.Trap`) receive 0 weight so diagnostic observer/cause arguments never
    // steal registers from hot loops.
    let blkWeight: u64 = if isCold { 0 } else if inLoop[b] != 0 { 16 } else { 1 }
    let paramWeight: u64 = if isCold { 0 } else if inLoop[b] != 0 { 32 } else { 2 }
    let params = List<u64>.asSlice(&blk.parameters)
    let mut p = usize.ZERO
    while p < params.length {
      recordValDef(&mut valIv, &mut valWeights, params[p], entryPt, paramWeight)
      p = p + usize.ONE
    }
    let insts = List<usize>.asSlice(&blk.instructions)
    let mut i = usize.ZERO
    while i < insts.length {
      let pt = entryPt + i
      let inst = function.instruction(insts[i])
      if !inst.removed {
        // Record result definitions.
        let rc = inst.resultCount()
        if rc >= usize.ONE && inst.result != none() {
          recordValDef(&mut valIv, &mut valWeights, inst.result, pt, blkWeight)
        }
        if rc >= 2 && inst.result != none() {
          recordValDef(&mut valIv, &mut valWeights, inst.result + 1, pt, blkWeight)
        }
        // Record operand uses.
        let ops = function.operandsOf(insts[i])
        let mut opIdx = usize.ZERO
        while opIdx < ops.length {
          recordValUse(&mut valIv, &mut valUses, &mut valWeights, ops[opIdx], pt, blkWeight)
          opIdx = opIdx + usize.ONE
        }
        // Track caller-saved GPR and XMM clobber points.
        if instClobbersCallerGp(function, insts[i]) {
          run List<usize>.append(&mut clobberGpPoints, pt)
        }
        if instClobbersCallerXmm(function, insts[i]) {
          run List<usize>.append(&mut clobberXmmPoints, pt)
        }
        // Any 128-bit vector touched by a non-SSE2-native instruction stays on the stack so
        // `vectorAddr` always has a valid frame offset.
        if !instSupportsXmmVec(function, insts[i]) {
          let noXmmMut = List<u8>.asMutSlice(&mut valNoXmm)
          if inst.result != none() && inst.kind.isVector() {
            let rIdx = u64.toUsize(inst.result)
            if rIdx < noXmmMut.length { noXmmMut[rIdx] = 1 }
          }
          opIdx = usize.ZERO
          while opIdx < ops.length {
            let ov = ops[opIdx]
            if ov != none() && function.value(ov).kind.isVector() {
              let oIdx = u64.toUsize(ov)
              if oIdx < noXmmMut.length { noXmmMut[oIdx] = 1 }
            }
            opIdx = opIdx + usize.ONE
          }
        }
        // Inspect slot lifetime markers & special operations.
        match inst.operation {
          Operation.SlotStart {slot} => {
            if slot < slotCount {
              slotIvMut[slot].hasStart = true
              if pt < slotIvMut[slot].start { slotIvMut[slot].start = pt }
              if pt > slotIvMut[slot].end { slotIvMut[slot].end = pt }
            }
          }
          Operation.SlotEnd {slot} => {
            if slot < slotCount {
              slotIvMut[slot].hasEnd = true
              if pt < slotIvMut[slot].start { slotIvMut[slot].start = pt }
              if pt > slotIvMut[slot].end { slotIvMut[slot].end = pt }
            }
          }
          Operation.SlotAddress {slot} => {
            if slot < slotCount {
              if pt < slotIvMut[slot].start { slotIvMut[slot].start = pt }
              if pt > slotIvMut[slot].end { slotIvMut[slot].end = pt }
              if inst.result != none() {
                let rIdx = u64.toUsize(inst.result)
                if rIdx < valueCount {
                  slotIdxMut[rIdx] = slot
                  slotDispMut[rIdx] = 0
                  let noRegMut = List<u8>.asMutSlice(&mut valNoReg)
                  noRegMut[rIdx] = 1
                }
              }
            }
          }
          Operation.Offset {offset} => {
            if ops.length >= usize.ONE && inst.result != none() {
              let baseIdx = u64.toUsize(ops[0])
              let rIdx = u64.toUsize(inst.result)
              if baseIdx < valueCount && rIdx < valueCount && slotIdxMut[baseIdx] != usize.MAX {
                let d = slotDispMut[baseIdx] + u64.wrappingToI64(offset)
                if d >= -1073741824 && d <= 1073741824 {
                  slotIdxMut[rIdx] = slotIdxMut[baseIdx]
                  slotDispMut[rIdx] = d
                  let noRegMut = List<u8>.asMutSlice(&mut valNoReg)
                  noRegMut[rIdx] = 1
                }
              }
            }
          }
          Operation.Index => {
            if ops.length >= 2 && inst.result != none() && function.isBits(ops[1]) {
              let idxKind = function.value(ops[1]).kind
              if !idxKind.isVector() && idxKind.bits == 64 {
                let baseIdx = u64.toUsize(ops[0])
                let rIdx = u64.toUsize(inst.result)
                if baseIdx < valueCount && rIdx < valueCount && slotIdxMut[baseIdx] != usize.MAX {
                  let d = slotDispMut[baseIdx] + u64.wrappingToI64(function.constantOf(ops[1]).low)
                  if d >= -1073741824 && d <= 1073741824 {
                    slotIdxMut[rIdx] = slotIdxMut[baseIdx]
                    slotDispMut[rIdx] = d
                    let noRegMut = List<u8>.asMutSlice(&mut valNoReg)
                    noRegMut[rIdx] = 1
                  }
                }
              }
            }
          }
          Operation.Cast {operation} => {
            // Vector-to-scalar or non-128-bit bitcast copies bytes into `result`'s memory slot.
            if operation == Cast.Bitcast && ops.length >= usize.ONE && inst.result != none() {
              if function.value(ops[0]).kind.isVector() && !instSupportsXmmVec(function, insts[i]) {
                let noRegMut = List<u8>.asMutSlice(&mut valNoReg)
                let noXmmMut = List<u8>.asMutSlice(&mut valNoXmm)
                let rIdx = u64.toUsize(inst.result)
                if rIdx < noRegMut.length { noRegMut[rIdx] = 1 }
                if rIdx < noXmmMut.length { noXmmMut[rIdx] = 1 }
              }
            }
          }
          Operation.VaStart => { hasVaStart = true }
          Operation.DynamicSlot {..} => { hasDynamicSlot = true }
          Operation.CompareExchange => {
            if inst.kind.bits > 64 {
              // `lock cmpxchg16b` uses `rbx` for the low 64 bits of the replacement value.
              reservedCalleeMask = reservedCalleeMask | u64.shiftLeft(1, 3)
            }
          }
          Operation.InlineAsm {index, ..} => {
            hasInlineAsm = true
            let asm: &InlineAsm = function.asm(index)
            let clob = X86Asm.parseClobberMask(Bytes.asSlice(&asm.clobbers))
            reservedCalleeMask = reservedCalleeMask | (clob & calleeBits)
            let hasOut = !inst.kind.isUnit()
            let parsed = run X86Asm.parseConstraints(Bytes.asSlice(&asm.constraints), hasOut)
            let cs = List<Constraint>.asSlice(&parsed)
            let mut c = usize.ZERO
            while c < cs.length {
              if cs[c].kind == ConstraintKind.FixedReg && cs[c].reg < 16 {
                reservedCalleeMask = reservedCalleeMask | (u64.shiftLeft(1, u8.toU64(cs[c].reg)) & calleeBits)
              }
              c = c + usize.ONE
            }
            // Any float/vector operand or result of inline asm stays in memory.
            let noXmmMut = List<u8>.asMutSlice(&mut valNoXmm)
            if inst.result != none() {
              let rIdx = u64.toUsize(inst.result)
              if rIdx < noXmmMut.length { noXmmMut[rIdx] = 1 }
            }
            opIdx = usize.ZERO
            while opIdx < ops.length {
              if ops[opIdx] != none() {
                let oIdx = u64.toUsize(ops[opIdx])
                if oIdx < noXmmMut.length { noXmmMut[oIdx] = 1 }
              }
              opIdx = opIdx + usize.ONE
            }
          }
          _ => {}
        }
      }
      i = i + usize.ONE
    }
    // Block exit values & outgoing edge arguments (also extend target block parameters to this edge).
    let exitPt = bExit[b]
    let mut exitClobbersGp = blk.exit == Exit.Switch
    if blk.value != none() {
      recordValUse(&mut valIv, &mut valUses, &mut valWeights, blk.value, exitPt, blkWeight)
      if function.value(blk.value).kind.isVector() {
        let noXmmMut = List<u8>.asMutSlice(&mut valNoXmm)
        let vi = u64.toUsize(blk.value)
        if vi < noXmmMut.length { noXmmMut[vi] = 1 }
      }
    }
    if blk.secondValue != none() {
      recordValUse(&mut valIv, &mut valUses, &mut valWeights, blk.secondValue, exitPt, blkWeight)
      if function.value(blk.secondValue).kind.isVector() {
        let noXmmMut = List<u8>.asMutSlice(&mut valNoXmm)
        let vi = u64.toUsize(blk.secondValue)
        if vi < noXmmMut.length { noXmmMut[vi] = 1 }
      }
    }
    let edges = List<Edge>.asSlice(&blk.edges)
    let mut e = usize.ZERO
    while e < edges.length {
      let edgeArgs = List<u64>.asSlice(&edges[e].arguments)
      let targetParams = List<u64>.asSlice(&function.block(edges[e].block).parameters)
      let mut a = usize.ZERO
      while a < edgeArgs.length {
        recordValUse(&mut valIv, &mut valUses, &mut valWeights, edgeArgs[a], exitPt, blkWeight)
        if a < targetParams.length {
          recordValDef(&mut valIv, &mut valWeights, targetParams[a], exitPt, blkWeight)
          let pk = function.value(targetParams[a]).kind
          if !pk.isUnit() && valueSlotBytes(pk) > 16 {
            exitClobbersGp = true
          }
        }
        a = a + usize.ONE
      }
      e = e + usize.ONE
    }
    if exitClobbersGp {
      run List<usize>.append(&mut clobberGpPoints, exitPt)
    }
    rpoIdx = rpoIdx + usize.ONE
  }

  // Extend all intervals across overlapping CFG back-edges to fixpoint.
  let valIvMut = List<Interval>.asMutSlice(&mut valIv)
  let mut changed = true
  while changed {
    changed = false
    s = usize.ZERO
    while s < slotCount {
      if slotIvMut[s].hasStart && slotIvMut[s].hasEnd && !slotIvMut[s].unmarked {
        if extendForLoops(&mut slotIvMut[s], loops) { changed = true }
      }
      s = s + usize.ONE
    }
    v = usize.ZERO
    while v < valueCount {
      if valIvMut[v].start <= valIvMut[v].end {
        if extendForLoops(&mut valIvMut[v], loops) { changed = true }
      }
      v = v + usize.ONE
    }
  }

  // Priority-weighted linear-scan register allocation onto the 5 callee-saved GPRs
  // (`rbx=3, r12=12, r13=13, r14=14, r15=15`), excluding any registers reserved by `InlineAsm`
  // or 128-bit `CompareExchange`.
  let mut valueRegs = run List<u8>.makeWithCapacity(valueCount)
  v = usize.ZERO
  while v < valueCount {
    run List<u8>.append(&mut valueRegs, regNone())
    v = v + usize.ONE
  }
  let valIvSlice = List<Interval>.asSlice(&valIv)
  let valSizeSlice = List<usize>.asSlice(&valSizes)
  let valUsesSlice = List<usize>.asSlice(&valUses)
  let valWeightSlice = List<u64>.asSlice(&valWeights)

  // Do not waste a callee-saved register on a single-use scalar integer compare immediately
  // consumed by its block's `Exit.Branch`, since `X86Emit` fuses it into `cmp + jcc`.
  b = usize.ZERO
  while b < blockCount {
    let blk = function.block(b)
    if blk.exit == Exit.Branch && blk.value != none() {
      let condIdx = u64.toUsize(blk.value)
      if condIdx < valueCount && valUsesSlice[condIdx] == usize.ONE {
        let insts = List<usize>.asSlice(&blk.instructions)
        let mut last = insts.length
        while last > usize.ZERO {
          last = last - usize.ONE
          let inst = function.instruction(insts[last])
          if !inst.removed {
            if inst.result == blk.value {
              if let Operation.Compare {..} = inst.operation {
                let ops = function.operandsOf(insts[last])
                if ops.length >= 2 {
                  let opKind = function.value(ops[0]).kind
                  if !opKind.isVector() && !opKind.isFloat() && opKind.bits <= 64 {
                    let noRegMut = List<u8>.asMutSlice(&mut valNoReg)
                    noRegMut[condIdx] = 1
                  }
                }
              }
            }
            break
          }
        }
      }
    }
    b = b + usize.ONE
  }

  let valNoRegSlice = List<u8>.asSlice(&valNoReg)
  let valNoXmmSlice = List<u8>.asSlice(&valNoXmm)
  let clobGpSlice = List<usize>.asSlice(&clobberGpPoints)
  let clobXmmSlice = List<usize>.asSlice(&clobberXmmPoints)

  let mut regCands = List<usize>.make()
  v = usize.ZERO
  while v < valueCount {
    if valSizeSlice[v] == 8 && valNoRegSlice[v] == 0 && valUsesSlice[v] > usize.ZERO && valWeightSlice[v] >= 1 && valIvSlice[v].start <= valIvSlice[v].end {
      let kind = function.value(usize.toU64(v)).kind
      if !kind.isFloat() && !kind.isVector() && !kind.isUnit() && kind.bits <= 64 {
        run List<usize>.append(&mut regCands, v)
      }
    }
    v = v + usize.ONE
  }
  heapSortCandidates(&mut regCands, valWeightSlice, List<Interval>.asSlice(&valIv))
  let candMut = List<usize>.asSlice(&regCands)

  // Caller-saved GPR pool (zero prologue save/restore cost): r8=8, r9=9, rsi=6, rdi=7.
  let mut callerRanges0 = List<Range>.make()
  let mut callerRanges1 = List<Range>.make()
  let mut callerRanges2 = List<Range>.make()
  let mut callerRanges3 = List<Range>.make()

  // Callee-saved GPR pool: rbx=3, r12=12, r13=13, r14=14, r15=15.
  let poolRegs: [u8; 5] = [3, 12, 13, 14, 15]
  let mut ranges0 = List<Range>.make()
  let mut ranges1 = List<Range>.make()
  let mut ranges2 = List<Range>.make()
  let mut ranges3 = List<Range>.make()
  let mut ranges4 = List<Range>.make()
  let mut slotWeights: [u64; 5] = [0, 0, 0, 0, 0]
  let mut slotCountAssigned: [usize; 5] = [0, 0, 0, 0, 0]
  let valRegsMut = List<u8>.asMutSlice(&mut valueRegs)

  let mut cIdx = usize.ZERO
  while cIdx < candMut.length {
    let idx = candMut[cIdx]
    let iv = valIvSlice[idx]
    let mut assigned = false
    let canCaller = iv.start > usize.ZERO && !hasPointInRange(clobGpSlice, iv.start, iv.end)
    if canCaller {
      if !assigned && run tryAssignReg(&mut callerRanges0, iv.start, iv.end) {
        valRegsMut[idx] = 8
        assigned = true
      }
      if !assigned && run tryAssignReg(&mut callerRanges1, iv.start, iv.end) {
        valRegsMut[idx] = 9
        assigned = true
      }
      if !assigned && run tryAssignReg(&mut callerRanges2, iv.start, iv.end) {
        valRegsMut[idx] = 6
        assigned = true
      }
      if !assigned && run tryAssignReg(&mut callerRanges3, iv.start, iv.end) {
        valRegsMut[idx] = 7
        assigned = true
      }
    }
    if !assigned && valWeightSlice[idx] >= 2 {
      if !assigned && (reservedCalleeMask & u64.shiftLeft(1, 3)) == 0 {
        if run tryAssignReg(&mut ranges0, iv.start, iv.end) {
          valRegsMut[idx] = poolRegs[0]
          slotWeights[0] = slotWeights[0] + valWeightSlice[idx]
          slotCountAssigned[0] = slotCountAssigned[0] + usize.ONE
          assigned = true
        }
      }
      if !assigned && (reservedCalleeMask & u64.shiftLeft(1, 12)) == 0 {
        if run tryAssignReg(&mut ranges1, iv.start, iv.end) {
          valRegsMut[idx] = poolRegs[1]
          slotWeights[1] = slotWeights[1] + valWeightSlice[idx]
          slotCountAssigned[1] = slotCountAssigned[1] + usize.ONE
          assigned = true
        }
      }
      if !assigned && (reservedCalleeMask & u64.shiftLeft(1, 13)) == 0 {
        if run tryAssignReg(&mut ranges2, iv.start, iv.end) {
          valRegsMut[idx] = poolRegs[2]
          slotWeights[2] = slotWeights[2] + valWeightSlice[idx]
          slotCountAssigned[2] = slotCountAssigned[2] + usize.ONE
          assigned = true
        }
      }
      if !assigned && (reservedCalleeMask & u64.shiftLeft(1, 14)) == 0 {
        if run tryAssignReg(&mut ranges3, iv.start, iv.end) {
          valRegsMut[idx] = poolRegs[3]
          slotWeights[3] = slotWeights[3] + valWeightSlice[idx]
          slotCountAssigned[3] = slotCountAssigned[3] + usize.ONE
          assigned = true
        }
      }
      if !assigned && (reservedCalleeMask & u64.shiftLeft(1, 15)) == 0 {
        if run tryAssignReg(&mut ranges4, iv.start, iv.end) {
          valRegsMut[idx] = poolRegs[4]
          slotWeights[4] = slotWeights[4] + valWeightSlice[idx]
          slotCountAssigned[4] = slotCountAssigned[4] + usize.ONE
          assigned = true
        }
      }
    }
    cIdx = cIdx + usize.ONE
  }

  // Profitability gate: only commit a callee-saved register when its total weighted benefit pays
  // for the prologue push and epilogue pop (avoiding bloat in tiny leaf functions).
  let mut calleeMask: u64 = reservedCalleeMask
  let mut anySaved = reservedCalleeMask != 0
  let mut rejectMask: u64 = 0
  let mut regSlot = usize.ZERO
  while regSlot < 5 {
    if slotCountAssigned[regSlot] > usize.ZERO {
      let minW: u64 = if anySaved { 3 } else if regSlot == usize.ZERO { 4 } else { 5 }
      if slotWeights[regSlot] >= minW {
        calleeMask = calleeMask | u64.shiftLeft(1, u8.toU64(poolRegs[regSlot]))
        anySaved = true
      } else {
        rejectMask = rejectMask | u64.shiftLeft(1, u8.toU64(poolRegs[regSlot]))
      }
    }
    regSlot = regSlot + usize.ONE
  }
  if rejectMask != 0 {
    v = usize.ZERO
    while v < valueCount {
      let reg = valRegsMut[v]
      if reg != regNone() && (rejectMask & u64.shiftLeft(1, u8.toU64(reg))) != 0 {
        valRegsMut[v] = regNone()
      }
      v = v + usize.ONE
    }
  }

  // Linear-scan allocation onto caller-saved XMM registers (`xmm4..xmm15`, 12 registers) for
  // scalar floats and 128-bit SSE2 vectors whose live ranges cross no XMM-clobbering calls.
  let mut valueXmms = run List<u8>.makeWithCapacity(valueCount)
  v = usize.ZERO
  while v < valueCount {
    run List<u8>.append(&mut valueXmms, regNone())
    v = v + usize.ONE
  }
  let mut xmmCands = List<usize>.make()
  v = usize.ZERO
  while v < valueCount {
    let iv = valIvSlice[v]
    if valNoXmmSlice[v] == 0 && valUsesSlice[v] > usize.ZERO && valWeightSlice[v] >= 1 && iv.start > usize.ZERO && iv.start <= iv.end {
      let kind = function.value(usize.toU64(v)).kind
      let isScalarFloat = kind.isFloat() && !kind.isVector()
      let isVec128 = kind.isVector() && valSizeSlice[v] == 16 && kind.isInteger() && (kind.bits == 8 || kind.bits == 16 || kind.bits == 32 || kind.bits == 64)
      if (isScalarFloat || isVec128) && !hasPointInRange(clobXmmSlice, iv.start, iv.end) {
        run List<usize>.append(&mut xmmCands, v)
      }
    }
    v = v + usize.ONE
  }
  heapSortCandidates(&mut xmmCands, valWeightSlice, List<Interval>.asSlice(&valIv))
  let xmmCandSlice = List<usize>.asSlice(&xmmCands)
  let mut xR4 = List<Range>.make()
  let mut xR5 = List<Range>.make()
  let mut xR6 = List<Range>.make()
  let mut xR7 = List<Range>.make()
  let mut xR8 = List<Range>.make()
  let mut xR9 = List<Range>.make()
  let mut xR10 = List<Range>.make()
  let mut xR11 = List<Range>.make()
  let mut xR12 = List<Range>.make()
  let mut xR13 = List<Range>.make()
  let mut xR14 = List<Range>.make()
  let mut xR15 = List<Range>.make()
  let valXmmsMut = List<u8>.asMutSlice(&mut valueXmms)
  cIdx = usize.ZERO
  while cIdx < xmmCandSlice.length {
    let idx = xmmCandSlice[cIdx]
    let iv = valIvSlice[idx]
    let mut assigned = false
    if !assigned && run tryAssignReg(&mut xR4, iv.start, iv.end) { valXmmsMut[idx] = 4 assigned = true }
    if !assigned && run tryAssignReg(&mut xR5, iv.start, iv.end) { valXmmsMut[idx] = 5 assigned = true }
    if !assigned && run tryAssignReg(&mut xR6, iv.start, iv.end) { valXmmsMut[idx] = 6 assigned = true }
    if !assigned && run tryAssignReg(&mut xR7, iv.start, iv.end) { valXmmsMut[idx] = 7 assigned = true }
    if !assigned && run tryAssignReg(&mut xR8, iv.start, iv.end) { valXmmsMut[idx] = 8 assigned = true }
    if !assigned && run tryAssignReg(&mut xR9, iv.start, iv.end) { valXmmsMut[idx] = 9 assigned = true }
    if !assigned && run tryAssignReg(&mut xR10, iv.start, iv.end) { valXmmsMut[idx] = 10 assigned = true }
    if !assigned && run tryAssignReg(&mut xR11, iv.start, iv.end) { valXmmsMut[idx] = 11 assigned = true }
    if !assigned && run tryAssignReg(&mut xR12, iv.start, iv.end) { valXmmsMut[idx] = 12 assigned = true }
    if !assigned && run tryAssignReg(&mut xR13, iv.start, iv.end) { valXmmsMut[idx] = 13 assigned = true }
    if !assigned && run tryAssignReg(&mut xR14, iv.start, iv.end) { valXmmsMut[idx] = 14 assigned = true }
    if !assigned && run tryAssignReg(&mut xR15, iv.start, iv.end) { valXmmsMut[idx] = 15 assigned = true }
    cIdx = cIdx + usize.ONE
  }

  // Count callee-saved GPRs and start allocating negative `rbp`-relative frame bytes below them.
  let mut savedCount = usize.ZERO
  let mut r: u8 = 0
  while r < 16 {
    if (calleeMask & u64.shiftLeft(1, u8.toU64(r))) != 0 {
      savedCount = savedCount + usize.ONE
    }
    r = r + 1
  }
  let savedBytes = usize.toU64(savedCount * 8)
  let mut usedBytes: u64 = savedBytes

  // 1. Reserve 176-byte SysV variadic register-save area if needed (16-byte aligned).
  let mut regSaveOffset: i32 = 0
  if hasVaStart {
    usedBytes = alignUp(usedBytes + 176, 16)
    regSaveOffset = 0 - u64.wrappingToI32(usedBytes)
  }

  // 2. Allocate MIR stack slots with greedy interval coloring for lifetime-marked slots.
  let mut slotOffsets = run List<i32>.makeWithCapacity(slotCount)
  s = usize.ZERO
  while s < slotCount {
    run List<i32>.append(&mut slotOffsets, 0)
    s = s + usize.ONE
  }
  let slotOffMut = List<i32>.asMutSlice(&mut slotOffsets)

  // Order slots: unmarked (whole-function) first, then marked slots sorted by start point.
  let mut markedOrder = List<usize>.make()
  s = usize.ZERO
  while s < slotCount {
    let slot = function.slot(s)
    let sz = if slot.size == 0 { 8 } else { slot.size }
    let align = maxU64(8, slot.alignment)
    if !slotIvMut[s].hasStart || !slotIvMut[s].hasEnd || slotIvMut[s].start > slotIvMut[s].end {
      usedBytes = alignUp(usedBytes + sz, align)
      slotOffMut[s] = 0 - u64.wrappingToI32(usedBytes)
    } else {
      run List<usize>.append(&mut markedOrder, s)
    }
    s = s + usize.ONE
  }
  // Insertion-sort marked slots by start point (typically small, O(N) when already in order).
  let orderMut = List<usize>.asMutSlice(&mut markedOrder)
  let mut k = usize.ONE
  while k < orderMut.length {
    let key = orderMut[k]
    let keyStart = slotIvMut[key].start
    let mut j = k
    while j > usize.ZERO && slotIvMut[orderMut[j - usize.ONE]].start > keyStart {
      orderMut[j] = orderMut[j - usize.ONE]
      j = j - usize.ONE
    }
    orderMut[j] = key
    k = k + usize.ONE
  }
  let mut slotPool = List<ReusableSlot>.make()
  k = usize.ZERO
  while k < orderMut.length {
    let idx = orderMut[k]
    let slot = function.slot(idx)
    let sz = if slot.size == 0 { 8 } else { slot.size }
    let align = maxU64(8, slot.alignment)
    let iv = slotIvMut[idx]
    let pool = List<ReusableSlot>.asMutSlice(&mut slotPool)
    let mut best = usize.MAX
    let mut bestSize = u64.MAX
    let mut pIdx = usize.ZERO
    while pIdx < pool.length {
      if pool[pIdx].freeAfter < iv.start && pool[pIdx].size >= sz && pool[pIdx].align >= align && pool[pIdx].size < bestSize {
        best = pIdx
        bestSize = pool[pIdx].size
      }
      pIdx = pIdx + usize.ONE
    }
    if best != usize.MAX {
      slotOffMut[idx] = pool[best].rbpOffset
      pool[best].freeAfter = iv.end
    } else {
      usedBytes = alignUp(usedBytes + sz, align)
      let off = 0 - u64.wrappingToI32(usedBytes)
      slotOffMut[idx] = off
      run List<ReusableSlot>.append(&mut slotPool, ReusableSlot {rbpOffset: off, size: sz, align: align, freeAfter: iv.end})
    }
    k = k + usize.ONE
  }

  // Resolve folded `rbp`-relative offsets for `SlotAddress` and constant `Offset` chains.
  let mut valueSlotBase = run List<i32>.makeWithCapacity(valueCount)
  v = usize.ZERO
  while v < valueCount {
    let mut sb: i32 = 0
    let si = slotIdxMut[v]
    if si != usize.MAX && si < slotCount && slotOffMut[si] < 0 {
      let total = i32.toI64(slotOffMut[si]) + slotDispMut[v]
      if total < 0 && total >= -2147483648 {
        sb = i64.wrappingToI32(total)
      }
    }
    run List<i32>.append(&mut valueSlotBase, sb)
    v = v + usize.ONE
  }
  let valSlotBaseSlice = List<i32>.asSlice(&valueSlotBase)

  // 3. Allocate stack home slots only for live SSA values that were neither assigned a callee-saved
  //    GPR nor folded into a constant `rbp`-relative slot base.
  let mut valueOffsets = run List<i32>.makeWithCapacity(valueCount)
  v = usize.ZERO
  while v < valueCount {
    run List<i32>.append(&mut valueOffsets, 0)
    v = v + usize.ONE
  }
  let valOffMut = List<i32>.asMutSlice(&mut valueOffsets)

  let mut liveVals = List<usize>.make()
  v = usize.ZERO
  while v < valueCount {
    if valSizeSlice[v] > usize.ZERO && valRegsMut[v] == regNone() && valXmmsMut[v] == regNone() && valSlotBaseSlice[v] == 0 && valIvSlice[v].start <= valIvSlice[v].end {
      run List<usize>.append(&mut liveVals, v)
    }
    v = v + usize.ONE
  }
  // Sort non-constant spilled values by interval start point.
  let lvMut = List<usize>.asMutSlice(&mut liveVals)
  k = usize.ONE
  while k < lvMut.length {
    let key = lvMut[k]
    let keyStart = valIvSlice[key].start
    let mut j = k
    while j > usize.ZERO && valIvSlice[lvMut[j - usize.ONE]].start > keyStart {
      lvMut[j] = lvMut[j - usize.ONE]
      j = j - usize.ONE
    }
    lvMut[j] = key
    k = k + usize.ONE
  }
  let mut valPool = List<ReusableSlot>.make()
  k = usize.ZERO
  while k < lvMut.length {
    let idx = lvMut[k]
    let sz = usize.toU64(valSizeSlice[idx])
    let align: u64 = if sz >= 16 { 16 } else { 8 }
    let iv = valIvSlice[idx]
    let pool = List<ReusableSlot>.asMutSlice(&mut valPool)
    let mut reused = usize.MAX
    let mut pIdx = usize.ZERO
    while pIdx < pool.length {
      if pool[pIdx].freeAfter < iv.start && pool[pIdx].size == sz && pool[pIdx].align >= align {
        reused = pIdx
        break
      }
      pIdx = pIdx + usize.ONE
    }
    if reused != usize.MAX {
      valOffMut[idx] = pool[reused].rbpOffset
      pool[reused].freeAfter = iv.end
    } else {
      usedBytes = alignUp(usedBytes + sz, align)
      let off = 0 - u64.wrappingToI32(usedBytes)
      valOffMut[idx] = off
      run List<ReusableSlot>.append(&mut valPool, ReusableSlot {rbpOffset: off, size: sz, align: align, freeAfter: iv.end})
    }
    k = k + usize.ONE
  }

  // Round total frame below saved `rbp` up to a multiple of 16 bytes.
  let totalAligned = alignUp(usedBytes, 16)
  let subRspBytes = totalAligned - savedBytes

  return FramePlan {
    slotOffsets: move slotOffsets,
    valueOffsets: move valueOffsets,
    valueSizes: move valSizes,
    valueRegs: move valueRegs,
    valueXmms: move valueXmms,
    blockOrder: move rpoOrder,
    valueSlotBase: move valueSlotBase,
    valueUses: move valUses,
    hasVaStart: hasVaStart,
    regSaveOffset: regSaveOffset,
    savedCalleeMask: calleeMask,
    savedCount: savedCount,
    subRspBytes: subRspBytes,
    hasDynamicSlot: hasDynamicSlot,
    hasInlineAsm: hasInlineAsm,
  }
}

// Binary search returning true when sorted `pts` contains any point `p` with `lo <= p <= hi`.
fn hasPointInRange(pts: &[usize], lo: usize, hi: usize) -> bool {
  if pts.length == usize.ZERO || lo > hi { return false }
  let mut left = usize.ZERO
  let mut right = pts.length
  while left < right {
    let mid = left + (right - left) / 2
    if pts[mid] < lo { left = mid + usize.ONE } else { right = mid }
  }
  return left < pts.length && pts[left] <= hi
}

// Conservative check: returns false ONLY for instructions guaranteed never to clobber caller-saved
// GPRs (`r8`, `r9`, `rsi`, `rdi`) in `X86Emit`.
fn instClobbersCallerGp(function: &SsaFunction, instId: usize) -> bool {
  if instSupportsXmmVec(function, instId) { return false }
  let inst = function.instruction(instId)
  let kind = inst.kind
  let ops = function.operandsOf(instId)
  return match inst.operation {
    Operation.SlotStart {..} => false
    Operation.SlotEnd {..} => false
    Operation.SlotAddress {..} => false
    Operation.Offset {..} => false
    Operation.Index => false
    Operation.Binary {operation} => {
      if kind.isVector() || kind.isFloat() || kind.bits > 64 { return true }
      return operation == Binary.SDiv || operation == Binary.SRem || operation == Binary.UDiv || operation == Binary.URem
    }
    Operation.Negate => kind.isVector() || kind.isFloat() || kind.bits > 64
    Operation.Rotate {..} => kind.isVector() || kind.bits > 64
    Operation.Compare {..} => {
      if ops.length < 2 { return true }
      let ok = function.value(ops[0]).kind
      return ok.isVector() || ok.isFloat() || ok.bits > 64
    }
    Operation.Select => kind.isVector() || kind.isFloat() || kind.bits > 64
    Operation.Load {..} => kind.isVector() || kind.isFloat() || kind.bits > 64
    Operation.Store {..} => {
      if ops.length < 2 { return true }
      let vk = function.value(ops[0]).kind
      return vk.isVector() || vk.isFloat() || vk.bits > 64
    }
    Operation.Cast {operation} => {
      if operation == Cast.Bitcast || kind.isVector() || kind.isFloat() || kind.bits > 64 { return true }
      if ops.length < usize.ONE { return true }
      let sk = function.value(ops[0]).kind
      return sk.isVector() || sk.isFloat() || sk.bits > 64
    }
    _ => true
  }
}

// Returns true when `instId` may clobber caller-saved XMM registers `xmm4..xmm15` (i.e. makes a
// function call, runs inline asm, or calls a 128-bit division/memmove runtime helper).
fn instClobbersCallerXmm(function: &SsaFunction, instId: usize) -> bool {
  let inst = function.instruction(instId)
  return match inst.operation {
    Operation.Call {..} => true
    Operation.CallIndirect {..} => true
    Operation.InlineAsm {..} => true
    Operation.VaStart => true
    Operation.CopyBytes {size} => size != 0 && size != 8 && size != 16 && size != 32 && size != 64
    Operation.CopyCounted => true
    Operation.FillCounted => true
    Operation.Binary {operation} => {
      if !inst.kind.isVector() && inst.kind.bits > 64 {
        return operation == Binary.UDiv || operation == Binary.SDiv || operation == Binary.URem || operation == Binary.SRem
      }
      return false
    }
    _ => false
  }
}

/// Returns the uniform shift/rotate lane constant (`0..63`) when `value` is a vector constant or
/// a `Splat` of a scalar constant, else `u64.MAX`.
pub fn uniformVecConst(function: &SsaFunction, value: u64) -> u64 {
  if value == none() { return u64.MAX }
  let info = function.value(value)
  if info.definition == Definition.Constant {
    let c = function.constantOf(value)
    if c.low < 64 { return c.low }
    return u64.MAX
  }
  let prod = function.producerOf(value)
  if prod != usize.MAX {
    if let Operation.Splat {..} = function.instruction(prod).operation {
      let ops = function.operandsOf(prod)
      if ops.length >= usize.ONE && function.isBits(ops[0]) {
        let v = function.constantOf(ops[0]).low
        if v < 64 { return v }
      }
    }
  }
  return u64.MAX
}

// Returns true when `instId` natively handles 128-bit integer vectors in `xmm4..xmm15` without
// taking a stack frame address via `vectorAddr`.
fn instSupportsXmmVec(function: &SsaFunction, instId: usize) -> bool {
  let inst = function.instruction(instId)
  let ops = function.operandsOf(instId)
  return match inst.operation {
    Operation.Load {..} => inst.kind.isVector() && inst.kind.storeSize() == 16
    Operation.Store {..} => ops.length >= 2 && function.value(ops[0]).kind.isVector() && function.value(ops[0]).kind.storeSize() == 16
    Operation.Splat {..} => inst.kind.isVector() && inst.kind.storeSize() == 16 && inst.kind.isInteger() && (inst.kind.bits == 8 || inst.kind.bits == 16 || inst.kind.bits == 32 || inst.kind.bits == 64)
    Operation.Binary {operation} => {
      if !inst.kind.isVector() || inst.kind.storeSize() != 16 || !inst.kind.isInteger() { return false }
      let b = inst.kind.bits
      if b != 8 && b != 16 && b != 32 && b != 64 { return false }
      if operation == Binary.Add || operation == Binary.Sub || operation == Binary.And || operation == Binary.Or || operation == Binary.Xor { return true }
      if ops.length >= 2 && uniformVecConst(function, ops[1]) < usize.toU64(b) {
        if (operation == Binary.Shl || operation == Binary.LShr) && (b == 16 || b == 32 || b == 64) { return true }
        if operation == Binary.AShr && (b == 16 || b == 32) { return true }
      }
      return false
    }
    Operation.Rotate {..} => {
      if !inst.kind.isVector() || inst.kind.storeSize() != 16 || !inst.kind.isInteger() { return false }
      let b = inst.kind.bits
      if b != 16 && b != 32 && b != 64 { return false }
      return ops.length >= 2 && uniformVecConst(function, ops[1]) < 64
    }
    Operation.Compare {..} => {
      if ops.length < 2 { return false }
      let ok = function.value(ops[0]).kind
      return ok.isVector() && ok.storeSize() == 16 && ok.isInteger() && (ok.bits == 8 || ok.bits == 16 || ok.bits == 32)
    }
    Operation.Select => {
      if !inst.kind.isVector() || inst.kind.storeSize() != 16 || !inst.kind.isInteger() || ops.length < 3 { return false }
      let b = inst.kind.bits
      if b != 8 && b != 16 && b != 32 && b != 64 { return false }
      let ck = function.value(ops[0]).kind
      return !ck.isVector() || (ck.bits == 1 && ck.elements == inst.kind.elements)
    }
    Operation.Cast {operation} => {
      return operation == Cast.Bitcast
        && inst.kind.isVector() && inst.kind.storeSize() == 16
        && ops.length >= 1
        && function.value(ops[0]).kind.isVector() && function.value(ops[0]).kind.storeSize() == 16
    }
    Operation.Shuffle {start, count} => {
      if !inst.kind.isVector() || inst.kind.storeSize() != 16 || ops.length < 2 { return false }
      let srcKind = function.value(ops[0]).kind
      if !srcKind.isVector() || srcKind.storeSize() != 16 { return false }
      if inst.kind.bits == 8 && srcKind.bits == 8 && count == 16 { return true }
      if inst.kind.bits == 32 && srcKind.bits == 32 && count == 4 {
        let mask = function.immediatesAt(start, count)
        return mask[0] < 4 && mask[1] < 4 && mask[2] < 4 && mask[3] < 4
      }
      return false
    }
    _ => false
  }
}

fn recordValDef(list: &mut List<Interval>, weights: &mut List<u64>, value: u64, pt: usize, weight: u64) -> () {
  if value == none() { return () }
  let ivs = List<Interval>.asMutSlice(&mut list.*)
  let ws = List<u64>.asMutSlice(&mut weights.*)
  let idx = u64.toUsize(value)
  if idx >= ivs.length { return () }
  if pt < ivs[idx].start { ivs[idx].start = pt }
  if pt > ivs[idx].end { ivs[idx].end = pt }
  ws[idx] = ws[idx] + weight
}

fn recordValUse(
  list: &mut List<Interval>,
  uses: &mut List<usize>,
  weights: &mut List<u64>,
  value: u64,
  pt: usize,
  weight: u64,
) -> () {
  if value == none() { return () }
  let ivs = List<Interval>.asMutSlice(&mut list.*)
  let us = List<usize>.asMutSlice(&mut uses.*)
  let ws = List<u64>.asMutSlice(&mut weights.*)
  let idx = u64.toUsize(value)
  if idx >= ivs.length { return () }
  if pt < ivs[idx].start { ivs[idx].start = pt }
  if pt > ivs[idx].end { ivs[idx].end = pt }
  us[idx] = us[idx] + usize.ONE
  ws[idx] = ws[idx] + weight
}

// Returns true when candidate `a` has strictly lower priority than candidate `b` (for max-heap
// extraction that produces descending-priority order).
fn candLess(a: usize, b: usize, weights: &[u64], ivs: &[Interval]) -> bool {
  if weights[a] != weights[b] { return weights[a] < weights[b] }
  let spanA = ivs[a].end - ivs[a].start
  let spanB = ivs[b].end - ivs[b].start
  if spanA != spanB { return spanA > spanB }
  return a > b
}

// In-place O(N log N) heapsort placing highest-priority candidates first.
fn heapSortCandidates(list: &mut List<usize>, weights: &[u64], ivs: &[Interval]) -> () {
  let n = List<usize>.length(&list.*)
  if n < 2 { return () }
  // Build min-heap (smallest priority at root) so popping into the back leaves highest priority first.
  let mut start = n / 2
  while start > usize.ZERO {
    start = start - usize.ONE
    siftDownMin(&mut list.*, start, n, weights, ivs)
  }
  let mut end = n
  while end > usize.ONE {
    end = end - usize.ONE
    let cands = List<usize>.asMutSlice(&mut list.*)
    let tmp = cands[usize.ZERO]
    cands[usize.ZERO] = cands[end]
    cands[end] = tmp
    siftDownMin(&mut list.*, usize.ZERO, end, weights, ivs)
  }
}

fn siftDownMin(list: &mut List<usize>, rootStart: usize, end: usize, weights: &[u64], ivs: &[Interval]) -> () {
  let cands = List<usize>.asMutSlice(&mut list.*)
  let mut root = rootStart
  while root * 2 + usize.ONE < end {
    let left = root * 2 + usize.ONE
    let right = left + usize.ONE
    let mut smallest = root
    if candLess(cands[left], cands[smallest], weights, ivs) {
      smallest = left
    }
    if right < end && candLess(cands[right], cands[smallest], weights, ivs) {
      smallest = right
    }
    if smallest == root { return () }
    let tmp = cands[root]
    cands[root] = cands[smallest]
    cands[smallest] = tmp
    root = smallest
  }
}

effect fn tryAssignReg(ranges: &mut List<Range>, start: usize, end: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
  let slice = List<Range>.asSlice(&ranges.*)
  let mut lo = usize.ZERO
  let mut hi = slice.length
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if slice[mid].end < start {
      lo = mid + usize.ONE
    } else {
      hi = mid
    }
  }
  if lo < slice.length && slice[lo].start <= end {
    return false
  }
  let insertAt = lo
  run List<Range>.append(&mut ranges.*, Range {start: start, end: end})
  let mutSlice = List<Range>.asMutSlice(&mut ranges.*)
  let mut k = mutSlice.length - usize.ONE
  while k > insertAt {
    mutSlice[k] = mutSlice[k - usize.ONE]
    k = k - usize.ONE
  }
  mutSlice[insertAt] = Range {start: start, end: end}
  return true
}

fn extendForLoops(iv: &mut Interval, loops: &[BackEdge]) -> bool {
  let mut changed = false
  let mut at = usize.ZERO
  while at < loops.length {
    let lp = loops[at]
    // If interval starts at or before loop latch AND ends at or after loop header, extend across
    // the entire loop body when it crosses the header or latch.
    if iv.start <= lp.headerPoint && iv.end >= lp.headerPoint && iv.end < lp.latchPoint {
      iv.end = lp.latchPoint
      changed = true
    }
    if iv.start > lp.headerPoint && iv.start <= lp.latchPoint && iv.end > lp.latchPoint {
      iv.start = lp.headerPoint
      changed = true
    }
    at = at + usize.ONE
  }
  return changed
}

fn alignUp(value: u64, align: u64) -> u64 {
  if align <= 1 { return value }
  let rem = value % align
  if rem == 0 { return value }
  return value + (align - rem)
}

fn maxU64(a: u64, b: u64) -> u64 {
  if a >= b { return a }
  return b
}
