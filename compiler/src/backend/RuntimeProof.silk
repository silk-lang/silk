//! Concrete runtime obligations independent of executable storage and instructions.
//!
//! Origins stay relative to their declaration. A consumer anchors them for its own traversal;
//! this value carries neither a caller's diagnostic span nor a module walk's boundary decision.

import backend.InstanceKey {HelperRole, InstanceKey}
import semantic.DeclarationId {DeclarationId}
import semantic.Specialization {Edge}
import semantic.Type {Type}
import semantic.Types {Types}
import semantic.TypedBody {BorrowStatus, Origin}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.mem.interned {Interned}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize

/// A reached specialization, preserving its admission edge and authored origin.
pub struct Reference {
  pub key: InstanceKey,
  pub edge: Edge,
  pub origin: Origin,
}

/// An exact callable and the declaration-relative site that invokes or forms it.
pub struct Site {
  pub key: InstanceKey,
  pub origin: Origin,
}

/// A nonparking obligation whose targets are checked against the complete runtime graph.
pub struct Obligation {
  pub callees: List<InstanceKey>,
  pub glues: List<Interned<Type>>,
  pub declarations: List<Interned<DeclarationId>>,
  pub exact: bool,
  /// Absent for an entry obligation, which is reported at the caller that enters the body.
  pub origin: Option<Origin>,
}

/// A way execution can leave or re-enter a held local-shared access.
pub enum EscapeKind { Suspension, Callback }

/// One escape operation, before a traversal assigns a diagnostic location.
pub struct EscapeSite {
  pub kind: EscapeKind,
  pub origin: Origin,
}

/// A statement whose exact target contributes to runtime closure.
pub enum EventKind { Address, Drop }

/// A proof-relevant statement, in the order the lowering decision engine appends it.
pub struct ControlEvent {
  pub kind: EventKind,
  pub key: InstanceKey,
  pub origin: Origin,
}

/// The target-bearing operations of one logical block, without executable operands or storage.
pub struct ControlBlock {
  pub call: Option<Site>,
  pub events: List<ControlEvent>,
}

/// Logical block ordering retained by a proof-only lowering sink.
/// Its block ordinals follow the ordinary lowering engine, including cleanup and cancel exits.
pub struct Control { pub blocks: List<ControlBlock> }

impl Control {
  pub fn make() -> Control { return Control {blocks: List<ControlBlock>.make()} }

  /// Adds one logical block and returns its stable ordinal.
  pub effect fn block(self: &mut Self) -> usize ! OutOfMemoryError ? &mut Allocator {
    let ordinal = List<ControlBlock>.length(&self.blocks)
    run List<ControlBlock>.append(&mut self.blocks,
      ControlBlock {call: Option<Site>.none(), events: List<ControlEvent>.make()})
    return ordinal
  }

  /// Replaces a block's terminator projection. A non-instance-call terminator supplies `None`.
  pub fn terminate(self: &mut Self, block: usize, call: Option<Site>) -> () {
    let blocks = List<ControlBlock>.asMutSlice(&mut self.blocks)
    blocks[block].call = move call
  }

  /// Appends a target-bearing statement to its logical block.
  pub effect fn append(self: &mut Self, block: usize, event: ControlEvent) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let blocks = List<ControlBlock>.asMutSlice(&mut self.blocks)
    return run List<ControlEvent>.append(&mut blocks[block].events, move event)
  }
}

/// The complete concrete obligations of one successfully planned runtime instance.
/// This is not a global safety verdict: consumers still close references, discharge callbacks
/// and nonparking obligations, and account for every definition and reference in their budget.
pub struct RuntimeProof {
  pub key: InstanceKey,
  /// Planning never turns a contract-typed body into a borrow-checked body.
  pub borrow: BorrowStatus,
  /// The original ordered multiset, including repeated references and cleanup provenance.
  pub references: List<Reference>,
  /// Direct calls in logical block order, retaining their individual source sites.
  pub callees: List<Site>,
  pub callbacks: List<Site>,
  /// Formed callable addresses and drop glue, excluding an Execution start helper.
  pub indirect: List<InstanceKey>,
  pub packages: List<InstanceKey>,
  pub suspension: Option<Origin>,
  pub parks: Option<Origin>,
  pub observes: bool,
  pub releasesPackages: bool,
  pub nonParking: List<Obligation>,
  pub accesses: List<Site>,
  pub escapes: List<EscapeSite>,
}

impl RuntimeProof {
  /// Starts the obligations for `key` without claiming that its concrete plan is complete.
  /// The planner publishes this value only after every operation and generated helper succeeds.
  pub fn make(key: InstanceKey, borrow: BorrowStatus) -> RuntimeProof {
    return RuntimeProof {key: move key, borrow: borrow,
      references: List<Reference>.make(), callees: List<Site>.make(), callbacks: List<Site>.make(),
      indirect: List<InstanceKey>.make(), packages: List<InstanceKey>.make(),
      suspension: Option<Origin>.none(), parks: Option<Origin>.none(), observes: false,
      releasesPackages: false, nonParking: List<Obligation>.make(), accesses: List<Site>.make(),
      escapes: List<EscapeSite>.make()}
  }

  /// Replaces control-derived targets from the finalized logical blocks. Direct calls precede
  /// the ordered address/drop statements of each block, matching the executable projection.
  pub effect fn projectControl(self: &mut Self, control: &Control) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    self.callees = List<Site>.make()
    self.callbacks = List<Site>.make()
    self.indirect = List<InstanceKey>.make()
    self.packages = List<InstanceKey>.make()
    let blocks = List<ControlBlock>.asSlice(&control.blocks)
    let mut block = usize.ZERO
    while block < blocks.length {
      if let Option<Site>.Some {value: call} = &blocks[block].call {
        run List<Site>.append(&mut self.callees,
          Site {key: InstanceKey.copy(&call.key), origin: call.origin})
      }
      let events = List<ControlEvent>.asSlice(&blocks[block].events)
      let mut at = usize.ZERO
      while at < events.length {
        let event = &events[at]
        if event.kind == EventKind.Drop {
          run List<InstanceKey>.append(&mut self.indirect, InstanceKey.copy(&event.key))
        } else {
          if InstanceKey.fixedLinkage(&event.key) {
            run List<Site>.append(&mut self.callbacks,
              Site {key: InstanceKey.copy(&event.key), origin: event.origin})
          }
          let start = match &event.key { InstanceKey.Helper {purpose, ..} => purpose == HelperRole.Start _ => false }
          if !start { run List<InstanceKey>.append(&mut self.indirect, InstanceKey.copy(&event.key)) }
          if let Option<Interned<Type>>.Some {..} = move InstanceKey.glueType(&event.key) {
            run List<InstanceKey>.append(&mut self.packages, InstanceKey.copy(&event.key))
          }
        }
        at = at + usize.ONE
      }
      block = block + usize.ONE
    }
    return ()
  }

  /// Compares the complete concrete proof, including ordered repeated edges, pending obligations
  /// and every declaration-relative diagnostic origin. Used to validate producer transformations.
  pub effect fn equivalent(self: &Self, other: &Self) -> bool
  ! OutOfMemoryError ? &mut Allocator | &mut Types {
    if self.borrow != other.borrow || self.observes != other.observes
      || self.releasesPackages != other.releasesPackages
      || !sameOptionalOrigin(&self.suspension, &other.suspension)
      || !sameOptionalOrigin(&self.parks, &other.parks) { return false }
    if !run InstanceKey.sameApplication(&self.key, &other.key) { return false }
    if !run sameSites(&self.callees, &other.callees) { return false }
    if !run sameSites(&self.callbacks, &other.callbacks) { return false }
    if !run sameSites(&self.accesses, &other.accesses) { return false }
    if !run sameKeys(&self.indirect, &other.indirect) { return false }
    if !run sameKeys(&self.packages, &other.packages) { return false }
    let leftRefs = List<Reference>.asSlice(&self.references)
    let rightRefs = List<Reference>.asSlice(&other.references)
    if leftRefs.length != rightRefs.length { return false }
    let mut at = usize.ZERO
    while at < leftRefs.length {
      if !sameOrigin(leftRefs[at].origin, rightRefs[at].origin) { return false }
      if !run InstanceKey.sameApplication(&leftRefs[at].key, &rightRefs[at].key) { return false }
      if !run sameEdge(&leftRefs[at].edge, &rightRefs[at].edge) { return false }
      at = at + usize.ONE
    }
    let leftEscapes = List<EscapeSite>.asSlice(&self.escapes)
    let rightEscapes = List<EscapeSite>.asSlice(&other.escapes)
    if leftEscapes.length != rightEscapes.length { return false }
    at = usize.ZERO
    while at < leftEscapes.length {
      if leftEscapes[at].kind != rightEscapes[at].kind
        || !sameOrigin(leftEscapes[at].origin, rightEscapes[at].origin) { return false }
      at = at + usize.ONE
    }
    let leftOwed = List<Obligation>.asSlice(&self.nonParking)
    let rightOwed = List<Obligation>.asSlice(&other.nonParking)
    if leftOwed.length != rightOwed.length { return false }
    at = usize.ZERO
    while at < leftOwed.length {
      if leftOwed[at].exact != rightOwed[at].exact
        || !sameOptionalOrigin(&leftOwed[at].origin, &rightOwed[at].origin) { return false }
      if !run sameKeys(&leftOwed[at].callees, &rightOwed[at].callees) { return false }
      let leftTypes = List<Interned<Type>>.asSlice(&leftOwed[at].glues)
      let rightTypes = List<Interned<Type>>.asSlice(&rightOwed[at].glues)
      if leftTypes.length != rightTypes.length { return false }
      let mut each = usize.ZERO
      while each < leftTypes.length {
        if !run Type.equalsShared(&leftTypes[each], &rightTypes[each]) { return false }
        each = each + usize.ONE
      }
      let leftNames = List<Interned<DeclarationId>>.asSlice(&leftOwed[at].declarations)
      let rightNames = List<Interned<DeclarationId>>.asSlice(&rightOwed[at].declarations)
      if leftNames.length != rightNames.length { return false }
      each = usize.ZERO
      while each < leftNames.length {
        let left = DeclarationId.copyShared(&leftNames[each])
        let right = DeclarationId.copyShared(&rightNames[each])
        if !DeclarationId.equals(&left, &right) { return false }
        each = each + usize.ONE
      }
      at = at + usize.ONE
    }
    return true
  }
}

fn sameOrigin(left: Origin, right: Origin) -> bool {
  return left.node == right.node && left.location.start == right.location.start && left.location.end == right.location.end
}

fn sameOptionalOrigin(left: &Option<Origin>, right: &Option<Origin>) -> bool {
  return match &left.* {
    Option<Origin>.None => match &right.* { Option<Origin>.None => true _ => false }
    Option<Origin>.Some {value} => match &right.* {
      Option<Origin>.Some {value: other} => sameOrigin(value, other)
      _ => false
    }
  }
}

effect fn sameKeys(left: &List<InstanceKey>, right: &List<InstanceKey>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let a = List<InstanceKey>.asSlice(left)
  let b = List<InstanceKey>.asSlice(right)
  if a.length != b.length { return false }
  let mut at = usize.ZERO
  while at < a.length {
    if !run InstanceKey.sameApplication(&a[at], &b[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn sameSites(left: &List<Site>, right: &List<Site>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let a = List<Site>.asSlice(left)
  let b = List<Site>.asSlice(right)
  if a.length != b.length { return false }
  let mut at = usize.ZERO
  while at < a.length {
    if !sameOrigin(a[at].origin, b[at].origin) { return false }
    if !run InstanceKey.sameApplication(&a[at].key, &b[at].key) { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn sameEdge(left: &Edge, right: &Edge) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  return match &left.* {
    Edge.Direct => match &right.* { Edge.Direct => true _ => false }
    Edge.Witness => match &right.* { Edge.Witness => true _ => false }
    Edge.Cleanup {owner} => match &right.* {
      Edge.Cleanup {owner: other} => run Type.equalsShared(&owner, &other)
      _ => false
    }
  }
}
