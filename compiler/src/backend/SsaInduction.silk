//! Counted induction variables whose initial value, upper bound and unit increment are known.
import backend.SsaFunction {Binary, Definition, Edge, Exit, Kind, Operation, Predicate, SsaFunction, masked, none}
import backend.SsaGraph {SsaGraph}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.u64
import silk.num.usize

/// A header parameter that takes every value from its initial constant up to its limit.
pub struct Counter {
  pub value: u64,
  pub initial: u64,
  pub limit: u64,
  pub entry: usize,
  pub next: u64,
  pub step: u64,
  pub latch: usize,
  pub arm: usize,
}

impl Copy for Counter {}

/// Finds a constant entry and a positive step that reaches the limit exactly, from the arm where the
/// counter is below its limit. The upper bound includes the final visit to the header.
pub fn find(function: &SsaFunction, graph: &SsaGraph, block: usize) -> Option<Counter> {
  let head = function.block(block)
  if head.exit != Exit.Branch || List<u64>.length(&head.parameters) == usize.ZERO { return Option<Counter>.None }
  let before = graph.predecessorsOf(block)
  if block == usize.ZERO || before.length != 2 || before[usize.ZERO] == before[usize.ONE] { return Option<Counter>.None }
  let test = function.producerOf(head.value)
  if test == usize.MAX { return Option<Counter>.None }
  let predicate = match function.instruction(test).operation {
    Operation.Compare {predicate: found} => found
    _ => { return Option<Counter>.None }
  }
  let args = function.operandsOf(test)
  let mut counter = args[usize.ZERO]
  let mut limit = args[usize.ONE]
  let mut reversed = false
  if function.isBits(counter) { counter = args[usize.ONE] limit = args[usize.ZERO] reversed = true }
  if !function.isBits(limit) { return Option<Counter>.None }
  let kind = function.kindOf(counter)
  if !kind.isInteger() || kind.isVector() || kind.bits > 64 { return Option<Counter>.None }
  let mut arm = usize.ZERO
  if reversed {
    if predicate == Predicate.Ule { arm = usize.ONE } else if predicate != Predicate.Ugt { return Option<Counter>.None }
  } else if predicate == Predicate.Uge { arm = usize.ONE } else if predicate != Predicate.Ult { return Option<Counter>.None }
  if !graph.reaches(before[usize.ZERO]) || !graph.reaches(before[usize.ONE]) { return Option<Counter>.None }
  let body = List<Edge>.asSlice(&head.edges)[arm].block
  if body == usize.ZERO || body == block || graph.predecessorsOf(body).length != usize.ONE { return Option<Counter>.None }
  let mut latch = before[usize.ZERO]
  let mut entry = before[usize.ONE]
  if !graph.dominates(body, latch) { latch = before[usize.ONE] entry = before[usize.ZERO] }
  if !graph.dominates(body, latch) || graph.dominates(block, entry) { return Option<Counter>.None }
  let parameters = List<u64>.asSlice(&head.parameters)
  let mut index = usize.ZERO
  while index < parameters.length && parameters[index] != counter { index = index + usize.ONE }
  if index == parameters.length { return Option<Counter>.None }
  let startEdge = function.block(entry).edgeTo(block)
  let stepEdge = function.block(latch).edgeTo(block)
  let initial = List<u64>.get(&List<Edge>.asSlice(&function.block(entry).edges)[startEdge].arguments, index)
  if !function.isBits(initial) || function.constantOf(initial).low > function.constantOf(limit).low { return Option<Counter>.None }
  let next = List<u64>.get(&List<Edge>.asSlice(&function.block(latch).edges)[stepEdge].arguments, index)
  let producer = function.producerOf(next)
  if producer == usize.MAX { return Option<Counter>.None }
  if let Operation.Binary {operation: Binary.Add} = function.instruction(producer).operation {} else { return Option<Counter>.None }
  let sum = function.operandsOf(producer)
  let mut stride = sum[usize.ONE]
  if sum[usize.ZERO] != counter {
    if sum[usize.ONE] != counter { return Option<Counter>.None }
    stride = sum[usize.ZERO]
  }
  if !function.isBits(stride) { return Option<Counter>.None }
  let step = function.constantOf(stride).low
  if step == 0 || (function.constantOf(limit).low - function.constantOf(initial).low) % step != 0 { return Option<Counter>.None }
  return Option<Counter>.Some {value: Counter {value: counter, initial: initial, limit: limit, entry: entry, next: next, step: step, latch: latch, arm: arm}}
}

/// The value `value` is one more than, when `value` is the sum of a value and the constant one;
/// else `none()`, which no operand is.
pub fn incrementOf(function: &SsaFunction, value: u64) -> u64 {
  let producer = function.producerOf(value)
  if producer == usize.MAX { return none() }
  if let Operation.Binary {operation: Binary.Add} = function.instruction(producer).operation {
    let operands = function.operandsOf(producer)
    if function.isBits(operands[usize.ONE]) && function.constantOf(operands[usize.ONE]).low == 1 && !function.isConstant(operands[usize.ZERO]) {
      return operands[usize.ZERO]
    }
    if function.isBits(operands[usize.ZERO]) && function.constantOf(operands[usize.ZERO]).low == 1 && !function.isConstant(operands[usize.ONE]) {
      return operands[usize.ONE]
    }
  }
  return none()
}

/// Counts in bytes when multiplying by the same scale is the only use of the
/// counter apart from its test and increment. Both scaled endpoints must fit.
pub effect fn scaleCounters(function: &mut SsaFunction, graph: &SsaGraph) -> bool ! OutOfMemoryError ? &mut Allocator {
  let uses = run function.useCounts()
  let mut replacements = List<u64>.make()
  run List<u64>.appendRepeated(&mut replacements, none(), function.valueCount())
  let mut products = List<usize>.make()
  let mut changed = false
  let order = graph.reversePostorder()
  let mut at = usize.ZERO
  while at < order.length {
    let header = order[at]
    at = at + usize.ONE
    let counter = match find(&function.*, graph, header) {
      Option<Counter>.Some {value} => value
      Option<Counter>.None => { continue }
    }
    if counter.step != 1 || List<usize>.get(&uses, u64.toUsize(counter.next)) != usize.ONE { continue }
    let needed = List<usize>.get(&uses, u64.toUsize(counter.value))
    if needed <= 2 { continue }
    let mut scale = none()
    List<usize>.truncate(&mut products, usize.ZERO)
    let mut id = usize.ZERO
    while id < function.instructionCount() {
      let found = function.instruction(id)
      id = id + usize.ONE
      if found.removed { continue }
      if let Operation.Binary {operation: Binary.Mul} = found.operation {
        let args = function.operandsOf(id - usize.ONE)
        let mut fixed = args[usize.ONE]
        if args[usize.ZERO] != counter.value {
          if args[usize.ONE] != counter.value { continue }
          fixed = args[usize.ZERO]
        }
        if !function.isBits(fixed) || (scale != none() && scale != fixed) { break }
        scale = fixed
        run List<usize>.append(&mut products, id - usize.ONE)
      }
    }
    if scale == none() || List<usize>.length(&products) + 2 != needed { continue }
    let width = function.constantOf(scale).low
    let kind = function.kindOf(counter.value)
    let limit = function.constantOf(counter.limit).low
    if width < 2 || limit > masked(u64.MAX, kind.bits) / width { continue }
    let initial = function.constantOf(counter.initial).low
    let start = run function.integer(kind.bits, initial * width)
    let end = run function.integer(kind.bits, limit * width)
    let edge = function.block(counter.entry).edgeTo(header)
    let parameter = function.value(counter.value).index
    function.setArgument(counter.entry, edge, parameter, start)
    let test = function.producerOf(function.block(header).value)
    let step = function.producerOf(counter.next)
    let mut operand = usize.ZERO
    if function.operandsOf(test)[usize.ZERO] == counter.value { operand = usize.ONE }
    function.setOperand(test, operand, end)
    operand = usize.ZERO
    if function.operandsOf(step)[usize.ZERO] == counter.value { operand = usize.ONE }
    function.setOperand(step, operand, scale)
    let mut i = usize.ZERO
    while i < List<usize>.length(&products) {
      let product = List<usize>.get(&products, i)
      let value = function.instruction(product).result
      List<u64>.set(&mut replacements, u64.toUsize(value), counter.value)
      function.remove(product)
      i = i + usize.ONE
    }
    changed = true
  }
  if changed { function.substitute(&mut replacements) function.sweep() }
  return changed
}

// Whether `value` is defined before `block` (constant, argument, or in a block dominating `block`).
fn availableAt(function: &SsaFunction, graph: &SsaGraph, value: u64, block: usize) -> bool {
  let info = function.value(value)
  if info.definition == Definition.Constant || info.definition == Definition.Argument { return true }
  if info.definition == Definition.Parameter { return graph.dominates(info.owner, block) }
  let prod = function.producerOf(value)
  if prod == usize.MAX { return true }
  return graph.dominates(function.instruction(prod).block, block)
}

// Finds a unit-step induction variable `counter < limit` where `limit` may be a runtime loop-invariant
// value dominating the entry block.
fn findDynamic(function: &SsaFunction, graph: &SsaGraph, block: usize) -> Option<Counter> {
  let head = function.block(block)
  if head.exit != Exit.Branch || List<u64>.length(&head.parameters) == usize.ZERO { return Option<Counter>.None }
  let before = graph.predecessorsOf(block)
  if block == usize.ZERO || before.length != 2 || before[usize.ZERO] == before[usize.ONE] { return Option<Counter>.None }
  let test = function.producerOf(head.value)
  if test == usize.MAX { return Option<Counter>.None }
  let predicate = match function.instruction(test).operation {
    Operation.Compare {predicate: found} => found
    _ => { return Option<Counter>.None }
  }
  let args = function.operandsOf(test)
  let parameters = List<u64>.asSlice(&head.parameters)
  let mut side = usize.ZERO
  while side < 2 {
    let counter = args[side]
    let limit = args[usize.ONE - side]
    let kind = function.kindOf(counter)
    if kind.isInteger() && !kind.isVector() && kind.bits <= 64 {
      let mut index = usize.ZERO
      while index < parameters.length && parameters[index] != counter { index = index + usize.ONE }
      if index < parameters.length {
        let mut arm = usize.MAX
        if side == usize.ZERO {
          if predicate == Predicate.Ult { arm = usize.ZERO } else if predicate == Predicate.Uge { arm = usize.ONE }
        } else {
          if predicate == Predicate.Ugt { arm = usize.ZERO } else if predicate == Predicate.Ule { arm = usize.ONE }
        }
        if arm != usize.MAX && graph.reaches(before[usize.ZERO]) && graph.reaches(before[usize.ONE]) {
          let body = List<Edge>.asSlice(&head.edges)[arm].block
          if body != usize.ZERO && body != block && graph.predecessorsOf(body).length == usize.ONE {
            let mut latch = before[usize.ZERO]
            let mut entry = before[usize.ONE]
            if !graph.dominates(body, latch) { latch = before[usize.ONE] entry = before[usize.ZERO] }
            if graph.dominates(body, latch) && !graph.dominates(block, entry) && availableAt(function, graph, limit, entry) {
              let startEdge = function.block(entry).edgeTo(block)
              let stepEdge = function.block(latch).edgeTo(block)
              let initial = List<u64>.get(&List<Edge>.asSlice(&function.block(entry).edges)[startEdge].arguments, index)
              let next = List<u64>.get(&List<Edge>.asSlice(&function.block(latch).edges)[stepEdge].arguments, index)
              let producer = function.producerOf(next)
              if producer != usize.MAX && availableAt(function, graph, initial, entry) {
                let isUnitAdd = match function.instruction(producer).operation {
                  Operation.Binary {operation: Binary.Add} => {
                    let sum = function.operandsOf(producer)
                    let leftStep = sum[usize.ZERO] == counter && function.isBits(sum[usize.ONE]) && function.constantOf(sum[usize.ONE]).low == 1
                    let rightStep = sum[usize.ONE] == counter && function.isBits(sum[usize.ZERO]) && function.constantOf(sum[usize.ZERO]).low == 1
                    leftStep || rightStep
                  }
                  _ => false
                }
                if isUnitAdd {
                  return Option<Counter>.Some {value: Counter {value: counter, initial: initial, limit: limit, entry: entry, next: next, step: 1, latch: latch, arm: arm}}
                }
              }
            }
          }
        }
      }
    }
    side = side + usize.ONE
  }
  return Option<Counter>.None
}

// Scans blocks outside `{header} ∪ dom(body)` for uses of `flag` or `values`.
// Sets `liveInExit[k]` when `values[k]` is used in a block dominated by `exit`.
// Returns `false` if rotation is blocked (`flag` is live outside, or a `values[k]` is live outside
// `dom(exit)`, or live in `dom(exit)` when `exit` has other predecessors).
fn scanExitUses(function: &SsaFunction, graph: &SsaGraph, header: usize, body: usize, exit: usize, values: &[u64], flag: u64,
  liveInExit: &mut [bool]) -> bool {
  let singleExitPred = graph.predecessorsOf(exit).length == usize.ONE
  let order = graph.reversePostorder()
  let mut b = usize.ZERO
  while b < order.length {
    let block = order[b]
    b = b + usize.ONE
    if block == header || graph.dominates(body, block) { continue }
    let inExit = graph.dominates(exit, block)
    let found = function.block(block)
    if found.value == flag || found.secondValue == flag || found.thirdValue == flag || found.fourthValue == flag { return false }
    let mut v = usize.ZERO
    while v < values.length {
      let val = values[v]
      if found.value == val || found.secondValue == val || found.thirdValue == val || found.fourthValue == val {
        if !inExit || !singleExitPred { return false }
        liveInExit[v] = true
      }
      v = v + usize.ONE
    }
    let listed = List<usize>.asSlice(&found.instructions)
    let mut i = usize.ZERO
    while i < listed.length {
      let operands = function.operandsOf(listed[i])
      let mut j = usize.ZERO
      while j < operands.length {
        if operands[j] == flag { return false }
        v = usize.ZERO
        while v < values.length {
          if operands[j] == values[v] {
            if !inExit || !singleExitPred { return false }
            liveInExit[v] = true
          }
          v = v + usize.ONE
        }
        j = j + usize.ONE
      }
      i = i + usize.ONE
    }
    let edges = List<Edge>.asSlice(&found.edges)
    i = usize.ZERO
    while i < edges.length {
      let args = List<u64>.asSlice(&edges[i].arguments)
      let mut j = usize.ZERO
      while j < args.length {
        if args[j] == flag { return false }
        v = usize.ZERO
        while v < values.length {
          if args[j] == values[v] {
            if !inExit || !singleExitPred { return false }
            liveInExit[v] = true
          }
          v = v + usize.ONE
        }
        j = j + usize.ONE
      }
      i = i + usize.ONE
    }
  }
  return true
}

// Maps each argument in `raw` that matches `headerParams[k]` to `replacement[k]`.
effect fn mapEdgeArgs(raw: &[u64], headerParams: &[u64], replacement: &[u64]) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  let mut out = run List<u64>.makeWithCapacity(raw.length)
  let mut i = usize.ZERO
  while i < raw.length {
    let mut val = raw[i]
    let mut k = usize.ZERO
    while k < headerParams.length {
      if headerParams[k] == val { val = replacement[k] }
      k = k + usize.ONE
    }
    run List<u64>.append(&mut out, val)
    i = i + usize.ONE
  }
  return move out
}

/// Moves the guard of a counted loop (constant or dynamic invariant bound, single or multiple
/// header parameters) to its back edge, promoting header parameters live in a single-predecessor
/// exit region into exit block parameters. Dynamic-limit loops receive a preheader entry guard so
/// the loop runs zero times when empty.
pub effect fn rotate(function: &mut SsaFunction, graph: &mut SsaGraph) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut headers = List<usize>.make()
  run List<usize>.appendSlice(&mut headers, graph.reversePostorder())
  let mut changed = false
  while let Option<usize>.Some {value: header} = List<usize>.pop(&mut headers) {
    let head = function.block(header)
    if List<u64>.length(&head.parameters) == usize.ZERO || List<usize>.length(&head.instructions) != usize.ONE { continue }
    let mut knownNonEmpty = false
    let c = match find(&function.*, &graph.*, header) {
      Option<Counter>.Some {value} => {
        if function.constantOf(value.initial).low >= function.constantOf(value.limit).low { continue }
        knownNonEmpty = true
        value
      }
      Option<Counter>.None => match findDynamic(&function.*, &graph.*, header) {
        Option<Counter>.Some {value} => {
          if function.isBits(value.initial) && function.isBits(value.limit) {
            if function.constantOf(value.initial).low >= function.constantOf(value.limit).low { continue }
            knownNonEmpty = true
          }
          value
        }
        Option<Counter>.None => { continue }
      }
    }
    if function.block(c.latch).exit != Exit.Jump { continue }
    let test = function.producerOf(head.value)
    if test != List<usize>.get(&head.instructions, usize.ZERO) { continue }
    let edges = List<Edge>.asSlice(&head.edges)
    let body = edges[c.arm].block
    let exit = edges[usize.ONE - c.arm].block
    if exit == header || exit == c.entry || c.entry == header { continue }
    if !knownNonEmpty && function.block(c.entry).exit != Exit.Jump { continue }
    let mut exitUsesFlag = false
    let rawExit = List<u64>.asSlice(&edges[usize.ONE - c.arm].arguments)
    let mut ei = usize.ZERO
    while ei < rawExit.length {
      if rawExit[ei] == head.value { exitUsesFlag = true }
      ei = ei + usize.ONE
    }
    if exitUsesFlag { continue }
    let headerParams = List<u64>.asSlice(&head.parameters)
    let mut liveInExit = run List<bool>.makeWithCapacity(headerParams.length)
    run List<bool>.appendRepeated(&mut liveInExit, false, headerParams.length)
    if !scanExitUses(&function.*, &graph.*, header, body, exit, headerParams, head.value, List<bool>.asMutSlice(&mut liveInExit)) { continue }
    let mut bodyArgs = List<u64>.make()
    run List<u64>.appendSlice(&mut bodyArgs, List<u64>.asSlice(&edges[c.arm].arguments))
    let mut exitArgsCopy = List<u64>.make()
    run List<u64>.appendSlice(&mut exitArgsCopy, rawExit)
    let mut paramsCopy = List<u64>.make()
    run List<u64>.appendSlice(&mut paramsCopy, headerParams)
    let stepEdge = function.block(c.latch).edgeTo(header)
    let mut backArgs = List<u64>.make()
    run List<u64>.appendSlice(&mut backArgs, List<u64>.asSlice(&List<Edge>.asSlice(&function.block(c.latch).edges)[stepEdge].arguments))
    let mut latchExitArgs = run mapEdgeArgs(List<u64>.asSlice(&exitArgsCopy), List<u64>.asSlice(&paramsCopy), List<u64>.asSlice(&backArgs))
    let mut entryArgs = List<u64>.make()
    let mut entryExitArgs = List<u64>.make()
    if !knownNonEmpty {
      let startEdge = function.block(c.entry).edgeTo(header)
      run List<u64>.appendSlice(&mut entryArgs, List<u64>.asSlice(&List<Edge>.asSlice(&function.block(c.entry).edges)[startEdge].arguments))
      entryExitArgs = run mapEdgeArgs(List<u64>.asSlice(&exitArgsCopy), List<u64>.asSlice(&paramsCopy), List<u64>.asSlice(&entryArgs))
    }
    let place = head.place
    // Promote any header parameters live in `dom(exit)` into LCSSA block parameters on `exit`.
    let mut pk = usize.ZERO
    while pk < List<u64>.length(&paramsCopy) {
      if List<bool>.get(&liveInExit, pk) {
        let oldParam = List<u64>.get(&paramsCopy, pk)
        let paramKind = function.kindOf(oldParam)
        let exitParam = run function.addParameter(exit, paramKind)
        run List<u64>.append(&mut latchExitArgs, List<u64>.get(&backArgs, pk))
        if !knownNonEmpty { run List<u64>.append(&mut entryExitArgs, List<u64>.get(&entryArgs, pk)) }
        let order = graph.reversePostorder()
        let mut bi = usize.ZERO
        while bi < order.length {
          if graph.dominates(exit, order[bi]) { function.replaceInBlock(order[bi], oldParam, exitParam) }
          bi = bi + usize.ONE
        }
      }
      pk = pk + usize.ONE
    }
    if !knownNonEmpty {
      let entryAt = List<usize>.length(&function.block(c.entry).instructions)
      let enter = run function.insertInstruction(c.entry, entryAt, Operation.Compare {predicate: Predicate.Ult}, Kind.flag(), &[c.initial, c.limit], place)
      run function.setBranch(c.entry, enter, header, List<u64>.asSlice(&entryArgs), exit, List<u64>.asSlice(&entryExitArgs))
    }
    let at = List<usize>.length(&function.block(c.latch).instructions)
    let again = run function.insertInstruction(c.latch, at, Operation.Compare {predicate: Predicate.Ult}, Kind.flag(), &[c.next, c.limit], place)
    run function.setBranch(c.latch, again, header, List<u64>.asSlice(&backArgs), exit, List<u64>.asSlice(&latchExitArgs))
    run function.setJump(header, body, List<u64>.asSlice(&bodyArgs))
    changed = true
    graph.* = run SsaGraph.of(&function.*)
  }
  return changed
}
