//! Exact semantic keys and canonical erased runtime families for selected instances.
//!
//! A key is canonical by construction: its application and provider types number their caller
//! regions across the complete closed input domain ([`Numbering`]), so call sites that lend different caller-local
//! regions in the same pattern share one instance.

import semantic.Types {Types}
import hir.Hir {OwnerKind}
import semantic.DeclarationId {DeclarationId}
import semantic.InternIndex {InternIndex}
import semantic.Lifetime {Numbering, CanonicalizationFailure}
import semantic.Specialization {Application, ScopeBinding, StaticSlot, Target}
import semantic.Type {Argument, Requirement, Type}
import semantic.RuntimeEncoding
import semantic.RuntimeEncoding {Coordinates}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.hash {Hash}
import silk.option {Option}
import silk.result {Result}
import silk.pointer {Pointer}
import silk.shared {Shared}
import silk.u64
import silk.usize
import silk.vector {Vector}

/// One canonical selected application, one C export shim, one type's drop glue, or one erased
/// helper of an execution package. Cached projections are derived once. Caller regions are numbered canonically;
/// `'static`, region sharing and every type, row, static and provider input remain exact.
pub union InstanceKey {
  Function {
    pub application: Shared<Application>,
    identity: Shared<DeclarationId>,
    runtime: Shared<Bytes>,
    /// One provider per entry of the substituted requirement row, in canonical key order (D2).
    providers: Shared<Vector<ProviderEntry>>,
  },
  /// The C ABI definition of `export "C" fn function(...) as "symbol"`: it forwards its C lanes to
  /// the ordinary Silk instance of `function`. Its linkage name is exactly `symbol`.
  Export {pub function: Shared<DeclarationId>, pub symbol: Shared<Bytes>},
  /// Cleans one complete value of `ty` through `&mut ty`: its Drop hook, then its children. The
  /// exact `ty` is its semantic identity; the runtime family erases lifetimes. Definitions use exact body-independent identity. `owner` attributes cleanup.
  DropGlue {pub ty: Shared<Type>, owner: Shared<DeclarationId>, runtime: Shared<Bytes>},
  /// One erased helper that `creator` prepares at its body node `node`, called only through its
  /// address. Its MIR is prepared and lowered with the creator's. `ordinal` tells apart the
  /// helpers of one role at one node: the step of an observation, `0` for a package helper.
  Helper {pub creator: Shared<InstanceKey>, pub node: usize, pub ordinal: usize, pub purpose: HelperRole},
}

/// What an erased helper does.
pub enum HelperRole {
  /// Runs an execution package's body into its result slot, given the package's address.
  Start,
  /// Invokes an execution package's readiness endpoint with its readiness state.
  Notify,
  /// Adapts an observer callback to the uniform event call `(environment, state, event, first,
  /// second, identity, origin) -> usize` that every observer record holds (failure observer note N1).
  Observe,
}

fn roleWord(purpose: HelperRole) -> u64 {
  return match purpose {
    HelperRole.Start => 0
    HelperRole.Notify => 1
    HelperRole.Observe => 2
  }
}

/// One requirement entry of an instance and the provider type that serves it (Effect note D2).
/// The provider's concrete type is part of the instance identity, like a generic argument.
pub struct ProviderEntry {
  pub key: Requirement
  pub provider: Shared<Type>
}

impl ProviderEntry {
  /// A handle copy; the types are shared.
  pub fn copy(self: &Self) -> ProviderEntry {
    return ProviderEntry {key: Requirement.copy(&self.key), provider: Shared<Type>.clone(&self.provider)}
  }
}

fn address(value: &Shared<DeclarationId>) -> usize {
  return Shared<DeclarationId>.with<usize>(
    value,
    fn(id: &DeclarationId) -> usize {
      return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(id))
    },
  )
}

fn same(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  if address(left) == address(right) {
    return true
  }
  return Shared<DeclarationId>.with<bool>(
    left,
    fn(a: &DeclarationId) -> bool {
      return sameRight(a, right)
    },
  )
}

fn sameRight(left: &DeclarationId, right: &Shared<DeclarationId>) -> bool {
  return Shared<DeclarationId>.with<bool>(
    right,
    fn(compared: &DeclarationId) -> bool {
      return DeclarationId.equals(left, compared)
    },
  )
}

fn hexDigit(value: u64) -> u8 {
  let digits = b"0123456789abcdef"
  return digits[u64.toUsize(value)]
}

effect fn appendHex(output: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut shift: u64 = 60
  let mut digit = Vector<u8>.make()
  while true {
    run Vector<u8>.append(&mut digit, hexDigit(u64.bitAnd(u64.shiftRight(value, shift), 15)))
    run Bytes.append(&mut output.*, Vector<u8>.asSlice(&digit))
    Vector<u8>.clear(&mut digit)
    if shift == 0 {
      break
    }
    shift = shift - 4
  }
  return ()
}

impl InstanceKey {
  /// Copies this function's canonical semantic application for path admission and lowering.
  pub effect fn selected(self: &Self) -> Application ! OutOfMemoryError ? &mut Allocator {
    if let Option<Shared<Application>>.Some {value} = move InstanceKey.application(self) {
      return run Application.copyShared(&value)
    }
    let identity = InstanceKey.identity(self)
    return Application {target: Target.Named {declaration: DeclarationId.copyShared(&identity)},
      arguments: Vector<Argument>.make(), argumentOrdinals: Vector<usize>.make(), scopes: Vector<ScopeBinding>.make(),
      statics: Vector<StaticSlot>.make()}
  }
  /// Constructs the canonical key of a call edge's actual application; all cached fields are
  /// derived here.
  pub effect fn function(application: Application) -> Result<InstanceKey, CanonicalizationFailure>
  ! OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run InstanceKey.withProviders(move application, Vector<ProviderEntry>.make())
  }
  /// Constructs a key whose requirement row is served by `providers`, in canonical key order.
  ///
  /// # Details
  ///
  /// `actual` and `served` carry the call edge's actual regions. One numbering renames the caller
  /// regions of both, application first, so a region shared between an argument and a provider
  /// stays shared.
  pub effect fn withProviders(actual: Application, served: Vector<ProviderEntry>) -> Result<InstanceKey, CanonicalizationFailure>
  ! OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let mut numbering = Numbering.collecting()
    // This privately owned draft only records complete free region occurrences. It is discarded
    // before freeze; no call/query can observe it.
    let observed = run Application.numberRegions(&actual, &mut numbering)
    match move observed {
      Result<Application, CanonicalizationFailure>.Success {value: draft} => { drop draft }
      Result<Application, CanonicalizationFailure>.Failure {error: reason} => {
        return Result<InstanceKey, CanonicalizationFailure>.failResult(reason)
      }
    }
    if !Numbering.units(&mut numbering, Vector<ProviderEntry>.length(&served)) { return failedKey(&numbering) }
    let observedProviders = Vector<ProviderEntry>.asSlice(&served)
    let observedOwner = Application.bodyDeclaration(&actual)
    let mut observedAt = usize.ZERO
    while observedAt < observedProviders.length {
      if let Option<Shared<Type>>.Some {value: namedRole} = &observedProviders[observedAt].key.roleType {
        let observedRole = run Type.numberRegions(&namedRole, observedOwner, &mut numbering)
        drop observedRole
      }
      let observedCapability = run Type.numberRegions(&observedProviders[observedAt].key.capability, observedOwner, &mut numbering)
      drop observedCapability
      let observedProvider = run Type.numberRegions(&observedProviders[observedAt].provider, observedOwner, &mut numbering)
      drop observedProvider
      observedAt = observedAt + usize.ONE
    }
    let search = match move run Numbering.freeze(&mut numbering) {
      Result<bool, CanonicalizationFailure>.Success {value: required} => required
      Result<bool, CanonicalizationFailure>.Failure {error: reason} => {
        return Result<InstanceKey, CanonicalizationFailure>.failResult(reason)
      }
    }
    let mut best = Option<InstanceKey>.none()
    let mut bestRecord = Bytes.make()
    while true {
      if !Numbering.attempt(&mut numbering) { return failedKey(&numbering) }
      let candidate = match move run InstanceKey.numberedFunction(&actual, &served, &mut numbering) {
        Result<InstanceKey, CanonicalizationFailure>.Success {value: numbered} => move numbered
        Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
          return Result<InstanceKey, CanonicalizationFailure>.failResult(reason)
        }
      }
      if let Option<CanonicalizationFailure>.Some {value: reason} = move Numbering.failure(&numbering) {
        return Result<InstanceKey, CanonicalizationFailure>.failResult(reason)
      }
      let available = Numbering.remainingBytes(&numbering)
      let mut coordinates = RuntimeEncoding.limitedCoordinates(available)
      let record = run InstanceKey.encodingAt(&candidate, &mut coordinates)
      if !Numbering.bytes(&mut numbering, available - coordinates.remainingBytes) { return failedKey(&numbering) }
      if coordinates.exceeded { return Result<InstanceKey, CanonicalizationFailure>.failResult(CanonicalizationFailure.Resource) }
      let mut selected = true
      if let Option<InstanceKey>.Some {..} = &best {
        if !Numbering.bytes(&mut numbering, Bytes.asSlice(&record).length)
          || !Numbering.bytes(&mut numbering, Bytes.asSlice(&bestRecord).length) { return failedKey(&numbering) }
        selected = RuntimeEncoding.less(Bytes.asSlice(&record), Bytes.asSlice(&bestRecord))
      }
      if selected {
        best = Option<InstanceKey>.some(move candidate)
        bestRecord = move record
      }
      if !search || !Numbering.next(&mut numbering) { break }
    }
    return match move best {
      Option<InstanceKey>.Some {value: canonical} => Result<InstanceKey, CanonicalizationFailure>.succeed(move canonical)
      _ => Result<InstanceKey, CanonicalizationFailure>.failResult(CanonicalizationFailure.UncollectedAtom)
    }
  }
  effect fn numberedFunction(actual: &Application, served: &Vector<ProviderEntry>, numbering: &mut Numbering)
    -> Result<InstanceKey, CanonicalizationFailure> ! OutOfMemoryError ? &mut Allocator | &mut Types {
    let application = match move run Application.numberRegions(actual, &mut numbering.*) {
      Result<Application, CanonicalizationFailure>.Success {value: renamed} => move renamed
      Result<Application, CanonicalizationFailure>.Failure {error: reason} => {
        return Result<InstanceKey, CanonicalizationFailure>.failResult(reason)
      }
    }
    if !Numbering.bytes(&mut numbering.*, RuntimeEncoding.declarationPayload(Application.bodyDeclaration(&application))) {
      return failedKey(&numbering.*)
    }
    let owner = DeclarationId.copy(Application.bodyDeclaration(&application))
    let mut providers = Vector<ProviderEntry>.make()
    let entries = Vector<ProviderEntry>.asSlice(served)
    let mut entryAt = usize.ZERO
    while entryAt < entries.length {
      let mut roleType = Option<Shared<Type>>.none()
      if let Option<Shared<Type>>.Some {value: written} = &entries[entryAt].key.roleType {
        roleType = Option<Shared<Type>>.some(run Type.numberRegions(&written, &owner, &mut numbering.*))
      }
      let capability = run Type.numberRegions(&entries[entryAt].key.capability, &owner, &mut numbering.*)
      let provider = run Type.numberRegions(&entries[entryAt].provider, &owner, &mut numbering.*)
      run Vector<ProviderEntry>.append(&mut providers, ProviderEntry {
        key: Requirement {capability: move capability, roleType: move roleType, access: entries[entryAt].key.access},
        provider: move provider,
      })
      entryAt = entryAt + usize.ONE
    }
    if let Option<CanonicalizationFailure>.Some {value: reason} = move Numbering.failure(&numbering.*) {
      return Result<InstanceKey, CanonicalizationFailure>.failResult(reason)
    }
    let available = Numbering.remainingBytes(&numbering.*)
    let mut coordinates = RuntimeEncoding.limitedCoordinates(available)
    let candidateResult = run InstanceKey.fromCanonical(move application, move providers, &mut coordinates)
    let consumed = available - coordinates.remainingBytes
    if !Numbering.bytes(&mut numbering.*, consumed) { return failedKey(&numbering.*) }
    if coordinates.exceeded { return Result<InstanceKey, CanonicalizationFailure>.failResult(CanonicalizationFailure.Resource) }
    return move candidateResult
  }
  // Only a proved complete renamed domain, or an empty named domain, reaches this assembler.
  effect fn fromCanonical(application: Application, providers: Vector<ProviderEntry>, coordinates: &mut Coordinates) -> Result<InstanceKey, CanonicalizationFailure>
  ! OutOfMemoryError ? &mut Allocator {
    let owner = Application.bodyDeclaration(&application)
    let mut runtime = run Application.encoding(&application, false, &mut coordinates.*)
    let listed = Vector<ProviderEntry>.asSlice(&providers)
    if listed.length > usize.ZERO {
      run RuntimeEncoding.recordWord(&mut runtime, 4, &mut coordinates.*)
      run RuntimeEncoding.recordWord(&mut runtime, usize.toU64(listed.length), &mut coordinates.*)
      let mut at = usize.ZERO
      while at < listed.length {
        let capability = run Type.encoding(&listed[at].key.capability, owner, false, &mut coordinates.*)
        run RuntimeEncoding.recordField(&mut runtime, Bytes.asSlice(&capability), &mut coordinates.*)
        if let Option<Shared<Type>>.Some {value: roleValue} = &listed[at].key.roleType {
          let encodedRole = run Type.encoding(&roleValue, owner, false, &mut coordinates.*)
          run RuntimeEncoding.recordWord(&mut runtime, 1, &mut coordinates.*)
          run RuntimeEncoding.recordField(&mut runtime, Bytes.asSlice(&encodedRole), &mut coordinates.*)
        } else { run RuntimeEncoding.recordWord(&mut runtime, 0, &mut coordinates.*) }
        let provider = run Type.encoding(&listed[at].provider, owner, false, &mut coordinates.*)
        run RuntimeEncoding.recordField(&mut runtime, Bytes.asSlice(&provider), &mut coordinates.*)
        at = at + usize.ONE
      }
    }
    if coordinates.exceeded { return Result<InstanceKey, CanonicalizationFailure>.failResult(CanonicalizationFailure.Resource) }
    if !RuntimeEncoding.recordPayload(&mut coordinates.*, RuntimeEncoding.declarationPayload(owner)) {
      return Result<InstanceKey, CanonicalizationFailure>.failResult(CanonicalizationFailure.Resource)
    }
    let identity = run Shared<DeclarationId>.make(DeclarationId.copy(owner))
    return Result<InstanceKey, CanonicalizationFailure>.succeed(InstanceKey.Function {
      application: run Shared<Application>.make(move application),
      identity: move identity,
      runtime: run Shared<Bytes>.make(move runtime),
      providers: run Shared<Vector<ProviderEntry>>.make(move providers),
    })
  }
  /// The providers serving this instance's requirement row; none for other keys.
  pub fn providers(self: &Self) -> Option<Shared<Vector<ProviderEntry>>> {
    return match &self.* {
      InstanceKey.Function {providers, ..} => Option<Shared<Vector<ProviderEntry>>>.some(Shared<Vector<ProviderEntry>>.clone(&providers))
      _ => Option<Shared<Vector<ProviderEntry>>>.none()
    }
  }
  /// The drop glue of `ty`, or absence when the type mentions no declaration that could own cleanup.
  /// The glue's type numbers its caller regions canonically, like a function application.
  pub effect fn dropGlue(actual: &Shared<Type>, sourceOwner: &DeclarationId) -> Result<Option<InstanceKey>, CanonicalizationFailure> ! OutOfMemoryError ? &mut Allocator | &mut Types {
    // Source context permits bounded observation before recursive glue-owner discovery.
    // It is not part of the resulting glue identity.
    let mut numbering = Numbering.collecting()
    let observed = run Type.numberRegions(actual, sourceOwner, &mut numbering)
    drop observed
    if let Option<CanonicalizationFailure>.Some {value: reason} = move Numbering.failure(&numbering) {
      return Result<Option<InstanceKey>, CanonicalizationFailure>.failResult(reason)
    }
    let ownerAvailable = Numbering.remainingBytes(&numbering)
    let mut ownerCoordinates = RuntimeEncoding.limitedCoordinates(ownerAvailable)
    let ownerCandidate = run Type.glueOwner(actual, &mut ownerCoordinates)
    if !Numbering.bytes(&mut numbering, ownerAvailable - ownerCoordinates.remainingBytes) { return failedGlue(&numbering) }
    if ownerCoordinates.exceeded {
      return Result<Option<InstanceKey>, CanonicalizationFailure>.failResult(CanonicalizationFailure.Resource)
    }
    let owner = match move ownerCandidate {
      Option<DeclarationId>.Some {value: originalOwner} => move originalOwner
      _ => { return Result<Option<InstanceKey>, CanonicalizationFailure>.succeed(Option<InstanceKey>.none()) }
    }
    let search = match move run Numbering.freeze(&mut numbering) {
      Result<bool, CanonicalizationFailure>.Success {value: required} => required
      Result<bool, CanonicalizationFailure>.Failure {error: reason} => {
        return Result<Option<InstanceKey>, CanonicalizationFailure>.failResult(reason)
      }
    }
    let mut best = Option<InstanceKey>.none()
    let mut bestRecord = Bytes.make()
    while true {
      if !Numbering.attempt(&mut numbering) { return failedGlue(&numbering) }
      let ty = run Type.numberRegions(actual, &owner, &mut numbering)
      if let Option<CanonicalizationFailure>.Some {value: reason} = move Numbering.failure(&numbering) {
        return Result<Option<InstanceKey>, CanonicalizationFailure>.failResult(reason)
      }
      let runtimeAvailable = Numbering.remainingBytes(&numbering)
      let mut runtimeCoordinates = RuntimeEncoding.limitedCoordinates(runtimeAvailable)
      let encoded = run Type.encoding(&ty, &owner, false, &mut runtimeCoordinates)
      let mut runtime = Bytes.make()
      run RuntimeEncoding.recordWord(&mut runtime, 2, &mut runtimeCoordinates)
      run RuntimeEncoding.recordField(&mut runtime, Bytes.asSlice(&encoded), &mut runtimeCoordinates)
      let runtimeConsumed = runtimeAvailable - runtimeCoordinates.remainingBytes
      if !Numbering.bytes(&mut numbering, runtimeConsumed) { return failedGlue(&numbering) }
      if runtimeCoordinates.exceeded {
        return Result<Option<InstanceKey>, CanonicalizationFailure>.failResult(CanonicalizationFailure.Resource)
      }
      if !Numbering.bytes(&mut numbering, RuntimeEncoding.declarationPayload(&owner)) { return failedGlue(&numbering) }
      let candidate = InstanceKey.DropGlue {ty: move ty,
        owner: run Shared<DeclarationId>.make(DeclarationId.copy(&owner)), runtime: run Shared<Bytes>.make(move runtime)}
      let available = Numbering.remainingBytes(&numbering)
      let mut coordinates = RuntimeEncoding.limitedCoordinates(available)
      let record = run InstanceKey.encodingAt(&candidate, &mut coordinates)
      if !Numbering.bytes(&mut numbering, available - coordinates.remainingBytes) { return failedGlue(&numbering) }
      if coordinates.exceeded { return Result<Option<InstanceKey>, CanonicalizationFailure>.failResult(CanonicalizationFailure.Resource) }
      let mut selected = true
      if let Option<InstanceKey>.Some {..} = &best {
        if !Numbering.bytes(&mut numbering, Bytes.asSlice(&record).length)
          || !Numbering.bytes(&mut numbering, Bytes.asSlice(&bestRecord).length) { return failedGlue(&numbering) }
        selected = RuntimeEncoding.less(Bytes.asSlice(&record), Bytes.asSlice(&bestRecord))
      }
      if selected { best = Option<InstanceKey>.some(move candidate)
        bestRecord = move record }
      if !search || !Numbering.next(&mut numbering) { break }
    }
    return Result<Option<InstanceKey>, CanonicalizationFailure>.succeed(move best)
  }
  /// Constructs the application of a declaration with no generic arguments.
  pub effect fn named(declaration: &Shared<DeclarationId>) -> InstanceKey
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut coordinates = RuntimeEncoding.coordinates()
    let named = run InstanceKey.fromCanonical(
      Application {
        target: Target.Named {declaration: DeclarationId.copyShared(declaration)},
        arguments: Vector<Argument>.make(),
        argumentOrdinals: Vector<usize>.make(),
        scopes: Vector<ScopeBinding>.make(),
        statics: Vector<StaticSlot>.make(),
      }, Vector<ProviderEntry>.make(), &mut coordinates,
    )
    // Unbounded empty-domain construction has no canonicalization resource/cycle refusal.
    return match move named {
      Result<InstanceKey, CanonicalizationFailure>.Success {value: canonical} => move canonical
      Result<InstanceKey, CanonicalizationFailure>.Failure {..} => absurd<InstanceKey>()
    }
  }
  /// Returns the selected semantic application; an export shim or drop glue has none.
  pub fn application(self: &Self) -> Option<Shared<Application>> {
    return match & self.* {
      InstanceKey.Function {application, ..} => Option<Shared<Application>>.some(
        Shared<Application>.clone(&application),
      )
      InstanceKey.Export {..} => Option<Shared<Application>>.none()
      InstanceKey.DropGlue {..} => Option<Shared<Application>>.none()
      InstanceKey.Helper {..} => Option<Shared<Application>>.none()
    }
  }
  pub fn copy(self: &Self) -> InstanceKey {
    return match & self.* {
      InstanceKey.Function {application, identity, runtime, providers} => InstanceKey.Function {
        application: Shared<Application>.clone(&application),
        identity: Shared<DeclarationId>.clone(&identity),
        runtime: Shared<Bytes>.clone(&runtime),
        providers: Shared<Vector<ProviderEntry>>.clone(&providers),
      }
      InstanceKey.Export {function, symbol} => InstanceKey.Export {
        function: Shared<DeclarationId>.clone(&function), symbol: Shared<Bytes>.clone(&symbol),
      }
      InstanceKey.DropGlue {ty, owner, runtime} => InstanceKey.DropGlue {
        ty: Shared<Type>.clone(&ty), owner: Shared<DeclarationId>.clone(&owner), runtime: Shared<Bytes>.clone(&runtime),
      }
      InstanceKey.Helper {creator, node, ordinal, purpose} => InstanceKey.Helper {
        creator: Shared<InstanceKey>.clone(&creator), node: node, ordinal: ordinal, purpose: purpose,
      }
    }
  }
  pub fn identity(self: &Self) -> Shared<DeclarationId> {
    return match & self.* {
      InstanceKey.Function {identity, ..} => Shared<DeclarationId>.clone(&identity)
      InstanceKey.Export {function, ..} => Shared<DeclarationId>.clone(&function)
      InstanceKey.DropGlue {owner, ..} => Shared<DeclarationId>.clone(&owner)
      InstanceKey.Helper {creator, ..} => Shared<InstanceKey>.with<Shared<DeclarationId>>(&creator, InstanceKey.identity)
    }
  }
  /// Whether this definition has a fixed C linkage name rather than a content-derived symbol.
  pub fn fixedLinkage(self: &Self) -> bool {
    return match & self.* {
      InstanceKey.Export {..} => true
      _ => false
    }
  }
  /// The exact linkage name of a C export shim; every other key derives its symbol from content.
  pub fn exportSymbol(self: &Self) -> Option<Shared<Bytes>> {
    return match & self.* {
      InstanceKey.Export {symbol, ..} => Option<Shared<Bytes>>.some(Shared<Bytes>.clone(&symbol))
      _ => Option<Shared<Bytes>>.none()
    }
  }
  /// The cleaned type of a drop glue instance.
  pub fn glueType(self: &Self) -> Option<Shared<Type>> {
    return match & self.* {
      InstanceKey.DropGlue {ty, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&ty))
      _ => Option<Shared<Type>>.none()
    }
  }
  /// Exact semantic environment equality for proof-bearing backend query inputs.
  /// This equality never substitutes erased-family equality for semantic proof inputs.
  pub effect fn sameApplication(self: &Self, other: &InstanceKey) -> bool
  ! OutOfMemoryError ? &mut Allocator {
    if !InstanceKey.sameRuntimeBase(self, other) { return false }
    // Backend identity is this complete canonical content. Use the same equality at query
    // interning, discovery and references so equivalent keys always name the same definition.
    let first = run InstanceKey.encoding(self)
    let second = run InstanceKey.encoding(other)
    return RuntimeEncoding.equals(Bytes.asSlice(&first), Bytes.asSlice(&second))
  }
  /// Backend identity: one definition, body and symbol for every region pattern of an
  /// application. Sealed heads cannot select by region (IMPL-007), so lifetimes never decide
  /// which code runs.
  pub effect fn sameInstance(self: &Self, other: &InstanceKey) -> bool
  ! OutOfMemoryError ? &mut Allocator {
    if !InstanceKey.sameRuntimeBase(self, other) { return false }
    let mut firstCoordinates = RuntimeEncoding.codeCoordinates()
    let first = run InstanceKey.encodingAt(self, &mut firstCoordinates)
    let mut secondCoordinates = RuntimeEncoding.codeCoordinates()
    let second = run InstanceKey.encodingAt(other, &mut secondCoordinates)
    return RuntimeEncoding.equals(Bytes.asSlice(&first), Bytes.asSlice(&second))
  }
  /// Returns a hash that two keys share whenever [`sameRuntimeBase`], [`sameInstance`] or
  /// [`sameApplication`] reports them equal: the erased family's cached bytes or an export's symbol.
  pub fn runtimeHash(self: &Self) -> u64 {
    return match & self.* {
      InstanceKey.Function {runtime, ..} => Shared<Bytes>.with<u64>(&runtime, familyHash)
      InstanceKey.Export {symbol, ..} => Shared<Bytes>.with<u64>(&symbol, familyHash)
      InstanceKey.DropGlue {runtime, ..} => Shared<Bytes>.with<u64>(&runtime, familyHash)
      InstanceKey.Helper {creator, node, ordinal, purpose} => Hash.mix(&Hash.seed(Hash.mix(&Hash.seed(Hash.mix(&Hash.seed(
        Shared<InstanceKey>.with<u64>(&creator, InstanceKey.runtimeHash)), usize.toU64(node))), usize.toU64(ordinal))),
        roleWord(purpose))
    }
  }
  /// Erased application family equality, not complete selected-code equality.
  pub fn sameRuntimeBase(self: &Self, other: &InstanceKey) -> bool {
    return match & self.* {
      InstanceKey.Function {runtime, ..} => match & other.* {
        InstanceKey.Function {runtime: compared, ..} => sameRuntime(&runtime, &compared)
        _ => false
      }
      InstanceKey.Export {function, symbol} => match & other.* {
        InstanceKey.Export {function: compared, symbol: name} => same(&function, &compared) && sameRuntime(&symbol, &name)
        _ => false
      }
      InstanceKey.DropGlue {runtime, ..} => match & other.* {
        InstanceKey.DropGlue {runtime: compared, ..} => sameRuntime(&runtime, &compared)
        _ => false
      }
      InstanceKey.Helper {creator, node, ordinal, purpose} => match & other.* {
        InstanceKey.Helper {creator: compared, node: site, ordinal: position, purpose: selected} => node == site
          && ordinal == position && purpose == selected && sameCreator(&creator, &compared)
        _ => false
      }
    }
  }
  fn runtimeBytes(self: &Self) -> Option<Shared<Bytes>> {
    return match & self.* {
      InstanceKey.Function {runtime, ..} => Option<Shared<Bytes>>.some(
        Shared<Bytes>.clone(&runtime),
      )
      InstanceKey.Export {..} => Option<Shared<Bytes>>.none()
      InstanceKey.DropGlue {runtime, ..} => Option<Shared<Bytes>>.some(Shared<Bytes>.clone(&runtime))
      InstanceKey.Helper {..} => Option<Shared<Bytes>>.none()
    }
  }
  /// Canonical erased family bytes. Complete code identity additionally includes selected MIR.
  pub effect fn runtimeEncoding(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    if let InstanceKey.Export {function, symbol} = &self.* {
      // Tag 5 keeps export shims disjoint from named (0), operation (1) and glue (2) families and
      // from the provider marker (4).
      let declaration = DeclarationId.copyShared(&function)
      let mut encoded = Bytes.make()
      run RuntimeEncoding.word(&mut encoded, 5)
      run RuntimeEncoding.declaration(&mut encoded, &declaration)
      run appendShared(&mut encoded, &symbol)
      return move encoded
    }
    if let InstanceKey.Helper {creator, node, ordinal, purpose} = &self.* {
      // Tag 6 keeps helpers disjoint from every other family and from each other by their creating
      // site, ordinal and role.
      let mut encoded = Bytes.make()
      run RuntimeEncoding.word(&mut encoded, 6)
      let created = Shared<InstanceKey>.with<InstanceKey>(&creator, InstanceKey.copy)
      let base = run InstanceKey.runtimeEncoding(&created)
      run RuntimeEncoding.field(&mut encoded, Bytes.asSlice(&base))
      run RuntimeEncoding.word(&mut encoded, usize.toU64(node))
      run RuntimeEncoding.word(&mut encoded, usize.toU64(ordinal))
      run RuntimeEncoding.word(&mut encoded, roleWord(purpose))
      return move encoded
    }
    let runtime = match move InstanceKey.runtimeBytes(self) {
      Option<Shared<Bytes>>.Some {value} => move value
      Option<Shared<Bytes>>.None => { return absurd<Bytes>() }
    }
    return run copyShared(&runtime)
  }
  /// Linkage content retains exact application evidence. It contains no selected body or callee body.
  pub effect fn encoding(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut coordinates = RuntimeEncoding.coordinates()
    return run InstanceKey.encodingAt(self, &mut coordinates)
  }
  /// Exact linkage content, with local regions expressed within their declaration.
  pub effect fn encodingAt(self: &Self, coordinates: &mut Coordinates) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
    if coordinates.exceeded { return Bytes.make() }
    let mut output = Bytes.make()
    run RuntimeEncoding.recordField(&mut output, b"silk.instance.v3", &mut coordinates.*)
    match & self.* {
      InstanceKey.Function {application, providers, ..} => {
        run RuntimeEncoding.recordWord(&mut output, 0, &mut coordinates.*)
        let affordable = Shared<Application>.with<bool>(&application,
          fn(value: &Application) -> bool { return Application.copiedPayloadFits(value, &mut coordinates.*) })
        if !affordable { return Bytes.make() }
        let selected = run Application.copyShared(&application)
        let identity = run Application.encoding(&selected, true, &mut coordinates.*)
        run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&identity), &mut coordinates.*)
        let count = Shared<Vector<ProviderEntry>>.with<usize>(
          &providers,
          fn(entries: &Vector<ProviderEntry>) -> usize {
            return Vector<ProviderEntry>.length(entries)
          },
        )
        run RuntimeEncoding.recordWord(&mut output, usize.toU64(count), &mut coordinates.*)
        let mut at = usize.ZERO
        while at < count {
          let entry = Shared<Vector<ProviderEntry>>.with<ProviderEntry>(
            &providers,
            fn(entries: &Vector<ProviderEntry>) -> ProviderEntry {
              let listed = Vector<ProviderEntry>.asSlice(entries)
              return ProviderEntry.copy(&listed[at])
            },
          )
          let capability = run Type.encoding(
            &entry.key.capability,
            Application.bodyDeclaration(&selected),
            true,
            &mut coordinates.*,
          )
          run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&capability), &mut coordinates.*)
          if let Option<Shared<Type>>.Some {value: roleValue} = &entry.key.roleType {
            run RuntimeEncoding.recordWord(&mut output, 1, &mut coordinates.*)
            let encodedRole = run Type.encoding(
              &roleValue,
              Application.bodyDeclaration(&selected),
              true,
              &mut coordinates.*,
            )
            run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&encodedRole), &mut coordinates.*)
          } else {
            run RuntimeEncoding.recordWord(&mut output, 0, &mut coordinates.*)
          }
          let provider = run Type.encoding(
            &entry.provider,
            Application.bodyDeclaration(&selected),
            true,
            &mut coordinates.*,
          )
          run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&provider), &mut coordinates.*)
          at = at + usize.ONE
        }
      }
      InstanceKey.Export {function, symbol} => {
        run RuntimeEncoding.recordWord(&mut output, 3, &mut coordinates.*)
        if !RuntimeEncoding.declarationFits(&function, &mut coordinates.*) { return Bytes.make() }
        let declaration = DeclarationId.copyShared(&function)
        run RuntimeEncoding.recordDeclaration(&mut output, &declaration, &mut coordinates.*)
        let count = Shared<Bytes>.with<usize>(&symbol, Bytes.length)
        if !RuntimeEncoding.recordPayload(&mut coordinates.*, count) { return Bytes.make() }
        let symbolBytes = run copyShared(&symbol)
        run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&symbolBytes), &mut coordinates.*)
      }
      InstanceKey.DropGlue {ty, owner, ..} => {
        run RuntimeEncoding.recordWord(&mut output, 2, &mut coordinates.*)
        if !RuntimeEncoding.declarationFits(&owner, &mut coordinates.*) { return Bytes.make() }
        let declaration = DeclarationId.copyShared(&owner)
        let identity = run Type.encoding(&ty, &declaration, true, &mut coordinates.*)
        run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&identity), &mut coordinates.*)
      }
      InstanceKey.Helper {creator, node, ordinal, purpose} => {
        run RuntimeEncoding.recordWord(&mut output, 4, &mut coordinates.*)
        let creating = Shared<InstanceKey>.with<InstanceKey>(&creator, InstanceKey.copy)
        let created = run InstanceKey.encodingAt(&creating, &mut coordinates.*)
        if coordinates.exceeded { return Bytes.make() }
        run RuntimeEncoding.recordField(&mut output, Bytes.asSlice(&created), &mut coordinates.*)
        run RuntimeEncoding.recordWord(&mut output, usize.toU64(node), &mut coordinates.*)
        run RuntimeEncoding.recordWord(&mut output, usize.toU64(ordinal), &mut coordinates.*)
        run RuntimeEncoding.recordWord(&mut output, roleWord(purpose), &mut coordinates.*)
      }
    }
    return move output
  }
  /// Definitions and references use the same body-independent linkage symbol, even in cycles.
  pub effect fn symbol(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    if let Option<Shared<Bytes>>.Some {value} = move InstanceKey.exportSymbol(self) {
      return run copyShared(&value)
    }
    let identity = run InstanceKey.encoding(self)
    return run InstanceKey.contentName(Bytes.asSlice(&identity))
  }
  /// A stable family label for worklist ordering and diagnostics, never an emitted symbol.
  pub effect fn runtimeName(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    if let Option<Shared<Bytes>>.Some {value} = move InstanceKey.exportSymbol(self) {
      return run copyShared(&value)
    }
    let runtime = run InstanceKey.runtimeEncoding(self)
    return run InstanceKey.contentName(Bytes.asSlice(&runtime))
  }
  /// Fixed-width digest of canonical content. Interning and equality compare full bytes.
  pub effect fn contentName(bytes: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let first = InternIndex.hashBytes(Hash.mix(&Hash.seed(0), 0), bytes)
    let second = InternIndex.hashBytes(Hash.mix(&Hash.seed(1), 0), bytes)
    let mut result = run Bytes.copy(b"silk_")
    run appendHex(&mut result, first)
    run appendHex(&mut result, second)
    return move result
  }
}

// Whether two package helpers' creators share one erased family.
fn sameCreator(left: &Shared<InstanceKey>, right: &Shared<InstanceKey>) -> bool {
  let first = Shared<InstanceKey>.with<InstanceKey>(left, InstanceKey.copy)
  let second = Shared<InstanceKey>.with<InstanceKey>(right, InstanceKey.copy)
  return InstanceKey.sameRuntimeBase(&first, &second)
}

fn familyHash(runtime: &Bytes) -> u64 {
  return InternIndex.hashBytes(Hash.mix(&Hash.seed(0), 0), Bytes.asSlice(runtime))
}

// Copies shared bytes without letting a borrow escape the handle.
effect fn copyShared(value: &Shared<Bytes>) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let count = Shared<Bytes>.with<usize>(value,
    fn(bytes: &Bytes) -> usize { return Bytes.asSlice(bytes).length })
  let mut copied = run Bytes.zeroed(count)
  let target = Bytes.asMutSlice(&mut copied)
  let mut at = usize.ZERO
  while at < count {
    target[at] = Shared<Bytes>.with<u8>(value,
      fn(bytes: &Bytes) -> u8 { return Bytes.asSlice(bytes)[at] })
    at = at + usize.ONE
  }
  return move copied
}

effect fn appendShared(output: &mut Bytes, value: &Shared<Bytes>) -> () ! OutOfMemoryError ? &mut Allocator {
  let copied = run copyShared(value)
  return run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&copied))
}

fn sameRuntime(left: &Shared<Bytes>, right: &Shared<Bytes>) -> bool {
  let firstAddress = Shared<Bytes>.with<usize>(
    left,
    fn(value: &Bytes) -> usize {
      return Pointer.address<Bytes>(Pointer.fromRef<Bytes>(value))
    },
  )
  let secondAddress = Shared<Bytes>.with<usize>(
    right,
    fn(value: &Bytes) -> usize {
      return Pointer.address<Bytes>(Pointer.fromRef<Bytes>(value))
    },
  )
  if firstAddress == secondAddress {
    return true
  }
  return Shared<Bytes>.with<bool>(
    left,
    fn(first: &Bytes) -> bool {
      return sameRuntimeRight(first, right)
    },
  )
}

fn sameRuntimeRight(first: &Bytes, right: &Shared<Bytes>) -> bool {
  return Shared<Bytes>.with<bool>(
    right,
    fn(second: &Bytes) -> bool {
      return RuntimeEncoding.equals(Bytes.asSlice(first), Bytes.asSlice(second))
    },
  )
}


fn absurd<T>() -> T {
  let boom = 1 / 0
  return absurd<T>()
}

fn failedKey(numbering: &Numbering) -> Result<InstanceKey, CanonicalizationFailure> {
  let reason = match move Numbering.failure(numbering) {
    Option<CanonicalizationFailure>.Some {value: recorded} => recorded
    _ => CanonicalizationFailure.UncollectedAtom
  }
  return Result<InstanceKey, CanonicalizationFailure>.failResult(reason)
}
fn failedGlue(numbering: &Numbering) -> Result<Option<InstanceKey>, CanonicalizationFailure> {
  let reason = match move Numbering.failure(numbering) {
    Option<CanonicalizationFailure>.Some {value: recorded} => recorded
    _ => CanonicalizationFailure.UncollectedAtom
  }
  return Result<Option<InstanceKey>, CanonicalizationFailure>.failResult(reason)
}

