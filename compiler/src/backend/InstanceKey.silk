//! Exact semantic keys and canonical erased runtime families for selected instances.

import hir.Hir {OwnerKind}
import semantic.DeclarationId {DeclarationId}
import semantic.Specialization {Application, ScopeBinding, StaticSlot, Target}
import semantic.Type {Argument, Requirement, Type}
import semantic.RuntimeEncoding
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.hash {Hash}
import silk.option {Option}
import silk.pointer {Pointer}
import silk.shared {Shared}
import silk.u8
import silk.u64
import silk.usize
import silk.vector {Vector}

/// One canonical selected application, the C entry shim, or one type's drop glue. Cached
/// projections are derived once.
pub union InstanceKey {
  Function {
    pub application: Shared<Application>,
    identity: Shared<DeclarationId>,
    runtime: Shared<Bytes>,
    /// One provider per entry of the substituted requirement row, in canonical key order (D2).
    providers: Shared<Vector<ProviderEntry>>,
  },
  Entry {pub main: Shared<DeclarationId>},
  /// Cleans one complete value of `ty` through `&mut ty`: its Drop hook, then its children. The
  /// exact `ty` is its semantic identity; the runtime family erases lifetimes. The completed
  /// emission plan resolves selected recipes before sharing code. `owner` attributes cleanup.
  DropGlue {pub ty: Shared<Type>, owner: Shared<DeclarationId>, runtime: Shared<Bytes>},
}

/// One requirement entry of an instance and the provider type that serves it (Effect note D2).
/// The provider's concrete type is part of the instance identity, like a generic argument.
pub struct ProviderEntry {
  pub key: Requirement
  pub provider: Shared<Type>
}

impl ProviderEntry {
  /// A handle copy; the types are shared.
  pub fn copy(self: &Self) -> ProviderEntry {
    return ProviderEntry {key: Requirement.copy(&self.key), provider: Shared.clone<Type>(&self.provider)}
  }
}

fn foldBytes(start: u64, bytes: &[u8]) -> u64 {
  let mut hash = Hash.combine(start, usize.toU64(bytes.length))
  let mut at = usize.ZERO
  while at < bytes.length {
    hash = Hash.combine(hash, u8.toU64(bytes[at]))
    at = at + usize.ONE
  }
  return hash
}

fn address(value: &Shared<DeclarationId>) -> usize {
  return Shared.with<DeclarationId, usize>(
    value,
    fn(id: &DeclarationId) -> usize {
      return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(id))
    },
  )
}

fn applicationAddress(value: &Shared<Application>) -> usize {
  return Shared.with<Application, usize>(value,
    fn(application: &Application) -> usize {
      return Pointer.address<Application>(Pointer.fromRef<Application>(application))
    })
}

fn same(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  if address(left) == address(right) {
    return true
  }
  return Shared.with<DeclarationId, bool>(
    left,
    fn(a: &DeclarationId) -> bool {
      return sameRight(a, right)
    },
  )
}

fn sameRight(left: &DeclarationId, right: &Shared<DeclarationId>) -> bool {
  return Shared.with<DeclarationId, bool>(
    right,
    fn(compared: &DeclarationId) -> bool {
      return DeclarationId.equals(left, compared)
    },
  )
}

fn hexDigit(value: u64) -> u8 {
  let digits = b"0123456789abcdef"
  return digits[u64.toUsize(value)]
}

effect fn appendHex(output: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut shift: u64 = 60
  let mut digit = Vector.make<u8>()
  while true {
    run Vector.append<u8>(&mut digit, hexDigit(u64.bitAnd(u64.shiftRight(value, shift), 15)))
    run Bytes.append(&mut output.*, Vector.asSlice<u8>(&digit))
    Vector.clear<u8>(&mut digit)
    if shift == 0 {
      break
    }
    shift = shift - 4
  }
  return ()
}

impl InstanceKey {
  /// Copies this function's semantic application for path admission.
  pub effect fn selected(self: &Self) -> Application ! OutOfMemoryError ? &mut Allocator {
    if let Option<Shared<Application>>.Some {value} = move InstanceKey.application(self) {
      return run Application.copyShared(&value)
    }
    let identity = InstanceKey.identity(self)
    return Application {target: Target.Named {declaration: run DeclarationId.copyShared(&identity)},
      arguments: Vector.make<Argument>(), argumentOrdinals: Vector.make<usize>(), scopes: Vector.make<ScopeBinding>(),
      statics: Vector.make<StaticSlot>()}
  }
  /// Constructs a key from its canonical application; all cached fields are derived here.
  pub effect fn function(application: Application) -> InstanceKey
  ! OutOfMemoryError
  ? &mut Allocator {
    return run InstanceKey.withProviders(move application, Vector.make<ProviderEntry>())
  }
  /// Constructs a key whose requirement row is served by `providers`, in canonical key order.
  pub effect fn withProviders(application: Application, providers: Vector<ProviderEntry>) -> InstanceKey
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut runtime = run Application.runtime(&application)
    let owner = run DeclarationId.copy(Application.bodyDeclaration(&application))
    let listed = Vector.asSlice<ProviderEntry>(&providers)
    if listed.length > usize.ZERO {
      run RuntimeEncoding.word(&mut runtime, 4)
      run RuntimeEncoding.word(&mut runtime, usize.toU64(listed.length))
      let mut at = usize.ZERO
      while at < listed.length {
        let capability = run Type.runtimeEncoding(&listed[at].key.capability, &owner)
        run RuntimeEncoding.field(&mut runtime, Bytes.asSlice(&capability))
        if let Option<Shared<Type>>.Some {value: roleValue} = &listed[at].key.roleType {
          let encodedRole = run Type.runtimeEncoding(&roleValue, &owner)
          run RuntimeEncoding.word(&mut runtime, 1)
          run RuntimeEncoding.field(&mut runtime, Bytes.asSlice(&encodedRole))
        } else { run RuntimeEncoding.word(&mut runtime, 0) }
        let provider = run Type.runtimeEncoding(&listed[at].provider, &owner)
        run RuntimeEncoding.field(&mut runtime, Bytes.asSlice(&provider))
        at = at + usize.ONE
      }
    }
    let identity = run Shared.make<DeclarationId>(move owner)
    return InstanceKey.Function {
      application: run Shared.make<Application>(move application),
      identity: move identity,
      runtime: run Shared.make<Bytes>(move runtime),
      providers: run Shared.make<Vector<ProviderEntry>>(move providers),
    }
  }
  /// The providers serving this instance's requirement row; none for other keys.
  pub fn providers(self: &Self) -> Option<Shared<Vector<ProviderEntry>>> {
    return match &self.* {
      InstanceKey.Function {providers, ..} => Option.some<Shared<Vector<ProviderEntry>>>(Shared.clone<Vector<ProviderEntry>>(&providers))
      _ => Option.none<Shared<Vector<ProviderEntry>>>()
    }
  }
  /// The drop glue of `ty`, or absence when the type mentions no declaration that could own cleanup.
  pub effect fn dropGlue(ty: &Shared<Type>) -> Option<InstanceKey> ! OutOfMemoryError ? &mut Allocator {
    let owner = match move run Type.glueOwner(ty) {
      Option<DeclarationId>.Some {value} => value
      Option<DeclarationId>.None => { return Option.none<InstanceKey>() }
    }
    let encoded = run Type.runtimeEncoding(ty, &owner)
    let mut runtime = Bytes.make()
    // Tag 2 keeps glue identities disjoint from named (0) and operation (1) applications.
    run RuntimeEncoding.word(&mut runtime, 2)
    run RuntimeEncoding.field(&mut runtime, Bytes.asSlice(&encoded))
    return Option.some<InstanceKey>(InstanceKey.DropGlue {
      ty: Shared.clone<Type>(ty), owner: run Shared.make<DeclarationId>(move owner), runtime: run Shared.make<Bytes>(move runtime),
    })
  }
  /// Constructs the application of a declaration with no generic arguments.
  pub effect fn named(declaration: &Shared<DeclarationId>) -> InstanceKey
  ! OutOfMemoryError
  ? &mut Allocator {
    return run InstanceKey.function(
      Application {
        target: Target.Named {declaration: run DeclarationId.copyShared(declaration)},
        arguments: Vector.make<Argument>(),
        argumentOrdinals: Vector.make<usize>(),
        scopes: Vector.make<ScopeBinding>(),
        statics: Vector.make<StaticSlot>(),
      },
    )
  }
  /// Returns the selected semantic application; an entry shim has no generic contract.
  pub fn application(self: &Self) -> Option<Shared<Application>> {
    return match & self.* {
      InstanceKey.Function {application, ..} => Option.some<Shared<Application>>(
        Shared.clone<Application>(&application),
      )
      InstanceKey.Entry {..} => Option.none<Shared<Application>>()
      InstanceKey.DropGlue {..} => Option.none<Shared<Application>>()
    }
  }
  pub fn copy(self: &Self) -> InstanceKey {
    return match & self.* {
      InstanceKey.Function {application, identity, runtime, providers} => InstanceKey.Function {
        application: Shared.clone<Application>(&application),
        identity: Shared.clone<DeclarationId>(&identity),
        runtime: Shared.clone<Bytes>(&runtime),
        providers: Shared.clone<Vector<ProviderEntry>>(&providers),
      }
      InstanceKey.Entry {main} => InstanceKey.Entry {main: Shared.clone<DeclarationId>(&main)}
      InstanceKey.DropGlue {ty, owner, runtime} => InstanceKey.DropGlue {
        ty: Shared.clone<Type>(&ty), owner: Shared.clone<DeclarationId>(&owner), runtime: Shared.clone<Bytes>(&runtime),
      }
    }
  }
  pub fn identity(self: &Self) -> Shared<DeclarationId> {
    return match & self.* {
      InstanceKey.Function {identity, ..} => Shared.clone<DeclarationId>(&identity)
      InstanceKey.Entry {main} => Shared.clone<DeclarationId>(&main)
      InstanceKey.DropGlue {owner, ..} => Shared.clone<DeclarationId>(&owner)
    }
  }
  pub fn isEntry(self: &Self) -> bool {
    return match & self.* {
      InstanceKey.Entry {main: _} => true
      _ => false
    }
  }
  /// The cleaned type of a drop glue instance.
  pub fn glueType(self: &Self) -> Option<Shared<Type>> {
    return match & self.* {
      InstanceKey.DropGlue {ty, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
      _ => Option.none<Shared<Type>>()
    }
  }
  /// Exact semantic environment equality for proof-bearing backend query inputs.
  /// This equality never substitutes erased-family equality for semantic proof inputs.
  pub effect fn sameApplication(self: &Self, other: &InstanceKey) -> bool
  ! OutOfMemoryError ? &mut Allocator {
    // Exact equality implies equal canonical erased families. Reject unrelated graph nodes before
    // copying their proof-bearing applications; family equality alone never admits sharing.
    if !InstanceKey.sameRuntimeBase(self, other) { return false }
    if let InstanceKey.Function {application: first, ..} = &self.* {
      if let InstanceKey.Function {application: second, ..} = &other.* {
        if applicationAddress(&first) == applicationAddress(&second) { return true }
        let left = run Application.copyShared(&first)
        let right = run Application.copyShared(&second)
        return run Application.equals(&left, &right)
      }
      return false
    }
    if let InstanceKey.DropGlue {ty: first, ..} = &self.* {
      if let InstanceKey.DropGlue {ty: second, ..} = &other.* {
        return run Type.equalsShared(&first, &second)
      }
      return false
    }
    return InstanceKey.sameRuntimeBase(self, other)
  }
  /// Erased application family equality, not complete selected-code equality.
  pub fn sameRuntimeBase(self: &Self, other: &InstanceKey) -> bool {
    return match & self.* {
      InstanceKey.Function {runtime, ..} => match & other.* {
        InstanceKey.Function {runtime: compared, ..} => sameRuntime(&runtime, &compared)
        _ => false
      }
      InstanceKey.Entry {main} => match & other.* {
        InstanceKey.Entry {main: compared} => same(&main, &compared)
        _ => false
      }
      InstanceKey.DropGlue {runtime, ..} => match & other.* {
        InstanceKey.DropGlue {runtime: compared, ..} => sameRuntime(&runtime, &compared)
        _ => false
      }
    }
  }
  fn runtimeBytes(self: &Self) -> Option<Shared<Bytes>> {
    return match & self.* {
      InstanceKey.Function {runtime, ..} => Option.some<Shared<Bytes>>(
        Shared.clone<Bytes>(&runtime),
      )
      InstanceKey.Entry {..} => Option.none<Shared<Bytes>>()
      InstanceKey.DropGlue {runtime, ..} => Option.some<Shared<Bytes>>(Shared.clone<Bytes>(&runtime))
    }
  }
  /// Canonical erased family bytes. Complete code identity additionally includes selected MIR.
  pub effect fn runtimeEncoding(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    if let InstanceKey.Entry {main} = &self.* {
      let declaration = run DeclarationId.copyShared(&main)
      let mut encoded = Bytes.make()
      run RuntimeEncoding.word(&mut encoded, 3)
      run RuntimeEncoding.declaration(&mut encoded, &declaration)
      return move encoded
    }
    let runtime = match move InstanceKey.runtimeBytes(self) {
      Option<Shared<Bytes>>.Some {value} => move value
      Option<Shared<Bytes>>.None => { return absurd<Bytes>() }
    }
    let count = Shared.with<Bytes, usize>(&runtime,
      fn(bytes: &Bytes) -> usize { return Bytes.asSlice(bytes).length })
    let mut copied = run Bytes.zeroed(count)
    let target = Bytes.asMutSlice(&mut copied)
    let mut at = usize.ZERO
    while at < count {
      target[at] = Shared.with<Bytes, u8>(&runtime,
        fn(bytes: &Bytes) -> u8 { return Bytes.asSlice(bytes)[at] })
      at = at + usize.ONE
    }
    return move copied
  }
  /// A stable family label for worklist ordering and diagnostics, never an emitted symbol.
  pub effect fn runtimeName(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    if InstanceKey.isEntry(self) {
      return run Bytes.copy(b"main")
    }
    let runtime = run InstanceKey.runtimeEncoding(self)
    return run InstanceKey.contentName(Bytes.asSlice(&runtime))
  }
  /// Fixed-width digest of canonical content. Interning and equality compare full bytes.
  pub effect fn contentName(bytes: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let first = foldBytes(Hash.mix(&Hash.seed(0), 0), bytes)
    let second = foldBytes(Hash.mix(&Hash.seed(1), 0), bytes)
    let mut result = run Bytes.copy(b"silk_")
    run appendHex(&mut result, first)
    run appendHex(&mut result, second)
    return move result
  }
}

fn sameRuntime(left: &Shared<Bytes>, right: &Shared<Bytes>) -> bool {
  let firstAddress = Shared.with<Bytes, usize>(
    left,
    fn(value: &Bytes) -> usize {
      return Pointer.address<Bytes>(Pointer.fromRef<Bytes>(value))
    },
  )
  let secondAddress = Shared.with<Bytes, usize>(
    right,
    fn(value: &Bytes) -> usize {
      return Pointer.address<Bytes>(Pointer.fromRef<Bytes>(value))
    },
  )
  if firstAddress == secondAddress {
    return true
  }
  return Shared.with<Bytes, bool>(
    left,
    fn(first: &Bytes) -> bool {
      return sameRuntimeRight(first, right)
    },
  )
}

fn sameRuntimeRight(first: &Bytes, right: &Shared<Bytes>) -> bool {
  return Shared.with<Bytes, bool>(
    right,
    fn(second: &Bytes) -> bool {
      return RuntimeEncoding.equals(Bytes.asSlice(first), Bytes.asSlice(second))
    },
  )
}


fn absurd<T>() -> T {
  let boom = 1 / 0
  return absurd<T>()
}
