//! Content-based identities and deterministic names for emitted instances.

import hir.Hir {OwnerKind}
import semantic.DeclarationId {DeclarationId}
import semantic.ModuleId {ModuleId}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.hash {Hash}
import silk.option {Option}
import silk.pointer {Pointer}
import silk.shared {Shared}
import silk.u8
import silk.u64
import silk.usize

/// The scalar backend emits an unspecialized function and a C entry shim.
pub union InstanceKey {
  Function {pub declaration: Shared<DeclarationId>},
  Entry {pub main: Shared<DeclarationId>},
}

fn kindCode(kind: OwnerKind) -> u64 {
  return match kind {
    OwnerKind.Import => 1
    OwnerKind.Conditional => 2
    OwnerKind.ModuleProperty => 3
    OwnerKind.Implementation => 4
    OwnerKind.Function => 5
    OwnerKind.Struct => 6
    OwnerKind.Tuple => 7
    OwnerKind.Enumeration => 8
    OwnerKind.Union => 9
    OwnerKind.Service => 10
    OwnerKind.Interface => 11
    OwnerKind.Role => 12
    OwnerKind.Constant => 13
    OwnerKind.PackageParameter => 14
    OwnerKind.Alias => 15
    OwnerKind.Static => 16
    OwnerKind.Damaged => 17
  }
}

fn foldBytes(start: u64, bytes: &[u8]) -> u64 {
  let mut hash = Hash.combine(start, usize.toU64(bytes.length))
  let mut at = usize.ZERO
  while at < bytes.length {
    hash = Hash.combine(hash, u8.toU64(bytes[at]))
    at = at + usize.ONE
  }
  return hash
}

fn fingerprint(declaration: &DeclarationId, seed: u64) -> u64 {
  let module = DeclarationId.moduleId(declaration)
  let mut hash = foldBytes(Hash.mix(&Hash.seed(seed), 1), ModuleId.sourceOrigin(module))
  hash = foldBytes(hash, ModuleId.packageIdentity(module))
  hash = foldBytes(hash, ModuleId.logicalPath(module))
  let owners = DeclarationId.ownerSteps(declaration)
  hash = Hash.combine(hash, usize.toU64(owners.length))
  let mut at = usize.ZERO
  while at < owners.length {
    let step = &owners[at]
    hash = Hash.combine(hash, kindCode(step.kind))
    hash = match & step.name {
      Option<Bytes>.Some {value} => foldBytes(Hash.combine(hash, 1), Bytes.asSlice(&value))
      Option<Bytes>.None => Hash.combine(hash, 0)
    }
    hash = Hash.combine(hash, usize.toU64(step.occurrence))
    at = at + usize.ONE
  }
  return hash
}

fn address(value: &Shared<DeclarationId>) -> usize {
  return Shared.with<DeclarationId, usize>(
    value,
    fn(id: &DeclarationId) -> usize {
      return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(id))
    },
  )
}

fn same(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  if address(left) == address(right) {
    return true
  }
  return Shared.with<DeclarationId, bool>(
    left,
    fn(a: &DeclarationId) -> bool {
      return Shared.with<DeclarationId, bool>(
        right,
        fn(b: &DeclarationId) -> bool {
          return DeclarationId.equals(a, b)
        },
      )
    },
  )
}

fn hexDigit(value: u64) -> u8 {
  let digits = b"0123456789abcdef"
  return digits[u64.toUsize(value)]
}

effect fn appendHex(output: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut shift = 60
  while true {
    let digit = [hexDigit(u64.bitAnd(u64.shiftRight(value, shift), 15))]
    run Bytes.append(&mut output.*, &digit)
    if shift == 0 {
      break
    }
    shift = shift - 4
  }
  return ()
}

impl InstanceKey {
  pub fn copy(self: &Self) -> InstanceKey {
    return match & self.* {
      InstanceKey.Function {declaration} => InstanceKey.Function {
        declaration: Shared.clone<DeclarationId>(&declaration),
      }
      InstanceKey.Entry {main} => InstanceKey.Entry {main: Shared.clone<DeclarationId>(&main)}
    }
  }
  pub fn identity(self: &Self) -> Shared<DeclarationId> {
    return match & self.* {
      InstanceKey.Function {declaration} => Shared.clone<DeclarationId>(&declaration)
      InstanceKey.Entry {main} => Shared.clone<DeclarationId>(&main)
    }
  }
  pub fn isEntry(self: &Self) -> bool {
    return match & self.* {
      InstanceKey.Entry {main: _} => true
      InstanceKey.Function {declaration: _} => false
    }
  }
  pub fn equals(self: &Self, other: &InstanceKey) -> bool {
    return match & self.* {
      InstanceKey.Function {declaration} => match & other.* {
        InstanceKey.Function {declaration: compared} => same(&declaration, &compared)
        _ => false
      }
      InstanceKey.Entry {main} => match & other.* {
        InstanceKey.Entry {main: compared} => same(&main, &compared)
        _ => false
      }
    }
  }
  /// A readable prefix and fixed-width content digest independent of query intern ordinals.
  pub effect fn symbol(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    if InstanceKey.isEntry(self) {
      return run Bytes.copy(b"main")
    }
    let identity = InstanceKey.identity(self)
    let first = Shared.with<DeclarationId, u64>(
      &identity,
      fn(id: &DeclarationId) -> u64 {
        return fingerprint(id, 0)
      },
    )
    let second = Shared.with<DeclarationId, u64>(
      &identity,
      fn(id: &DeclarationId) -> u64 {
        return fingerprint(id, 1)
      },
    )
    let mut result = run Bytes.copy(b"silk_")
    run appendHex(&mut result, first)
    run appendHex(&mut result, second)
    return move result
  }
}
