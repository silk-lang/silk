//! Backend-only overrides owned by defining packages, independent of source-visible profiles.

import silk.collections.bytes { Bytes }
import silk.core.option { Option }

/// Code generation selected for one package identity.
pub struct PackageSettings {
  /// The defining package's canonical identity.
  pub identity: Bytes,
  /// Its optimization override, absent to use the compilation default.
  pub optimization: Option<Bytes>,
  /// Its debug-information override, absent to use the compilation default.
  pub debug: Option<bool>,
}

/// Optimization policy used while lowering a function, without adding source facts.
pub enum Mode { Default, None, Speed, Size }
