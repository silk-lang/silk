//! Explicit backend coverage failures for reached programs.

import lexer.Span {Span}
import CompilerBug
import semantic.Anchor {Anchor}
import semantic.SourceLocations {Location}
import semantic.DeclarationId {DeclarationId}
import semantic.ModuleId {ModuleId}
import semantic.Rejection {Rejection, RejectionCode}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.mem.shared {Shared}
import silk.mem.frozen {Frozen}
import silk.num.usize

/// One stable reason code for a reached but unimplemented backend form.
///
/// No code names a C ABI rule: `check` classifies every reached C signature and reports its
/// refusals as coded diagnostics, so emission meeting one is a compiler bug.
pub enum Code {
  ScalarLayout,
  IntegerLiteral,
  FloatLiteral,
  MissingCallArgument,
  TypedForm,
  IntrinsicMember,
  ExpectedExpression,
  ExpectedPlace,
  PlaceProjection,
  FieldProjection,
  IndexProjection,
  SliceLayout,
  BreakOutsideLoop,
  ContinueOutsideLoop,
  MissingBlockStatement,
  SignatureForm,
  StaticResidualization,
  ArithmeticTrap,
  CalleeModule,
  OpenInstance,
  EffectForm,
  /// A failure type the origin-only report cannot name yet (failure observer note §4).
  FailureIdentity,
  /// An observer callback that is not a direct function (failure observer note N1).
  CoreType,
  IntrinsicWitness,
  CallTargetDiscovery,
  MutableParameter,
  GenericOperation,
  WitnessOperand,
  Cleanup,
  OwnedBindingRead,
}

/// Exact source evidence, independent of the reached instance that reports it.
pub union Source {
  Declaration {pub declaration: Frozen<DeclarationId>, pub span: Span},
  Generated {pub declaration: Frozen<DeclarationId>},
  Relative {pub declaration: Frozen<DeclarationId>, pub location: Location},
  Diagnostic {pub diagnostic: Shared<Rejection>},
}

impl Source {
  pub fn copy(self: &Self) -> Self {
    return match &self.* {
      Source.Declaration {declaration, span} => Source.Declaration {declaration: Frozen<DeclarationId>.clone(&declaration), span: span}
      Source.Generated {declaration} => Source.Generated {declaration: Frozen<DeclarationId>.clone(&declaration)}
      Source.Relative {declaration, location} => Source.Relative {declaration: Frozen<DeclarationId>.clone(&declaration), location: location}
      Source.Diagnostic {diagnostic} => Source.Diagnostic {diagnostic: Shared<Rejection>.clone(&diagnostic)}
    }
  }
}

/// A reached form that the current backend cannot compile.
pub struct Gap {
  pub code: Code,
  pub owner: Frozen<DeclarationId>,
  pub source: Source,
}

impl Gap {
  pub fn make(code: Code, owner: &Frozen<DeclarationId>, span: Span) -> Gap {
    return Gap {code: code, owner: Frozen<DeclarationId>.clone(owner),
      source: Source.Declaration {declaration: Frozen<DeclarationId>.clone(owner), span: span}}
  }
  pub fn fromSource(code: Code, owner: &Frozen<DeclarationId>, source: &Source) -> Gap {
    return Gap {code: code, owner: Frozen<DeclarationId>.clone(owner), source: Source.copy(source)}
  }
  /// A backend failure retains stable token boundaries until the source-facing report is placed.
  pub fn relative(code: Code, owner: &Frozen<DeclarationId>, location: Location) -> Gap {
    if !Location.isAuthored(location) {
      return Gap {code: code, owner: Frozen<DeclarationId>.clone(owner),
        source: Source.Generated {declaration: Frozen<DeclarationId>.clone(owner)}}
    }
    return Gap {code: code, owner: Frozen<DeclarationId>.clone(owner),
      source: Source.Relative {declaration: Frozen<DeclarationId>.clone(owner), location: location}}
  }
  pub fn anchored(self: Self, anchor: &Anchor) -> Self {
    let Gap {code, owner, source} = move self
    let placed = match move source {
      Source.Relative {declaration, location} => Source.Declaration {declaration: move declaration,
        span: Anchor.span(anchor, location)}
      Source.Generated {declaration} => Source.Generated {declaration: move declaration}
      Source.Declaration {declaration, span} => Source.Declaration {declaration: move declaration, span: span}
      Source.Diagnostic {diagnostic} => Source.Diagnostic {diagnostic: move diagnostic}
    }
    return Gap {code: code, owner: move owner, source: move placed}
  }
  /// Retains a propagated rejection's module and span without attributing them to its caller.
  pub fn fromRejection(code: Code, owner: &Frozen<DeclarationId>, diagnostic: &Shared<Rejection>) -> Gap {
    return Gap {code: code, owner: Frozen<DeclarationId>.clone(owner),
      source: Source.Diagnostic {diagnostic: Shared<Rejection>.clone(diagnostic)}}
  }
  pub fn copy(self: &Self) -> Gap {
    return Gap {code: self.code, owner: Frozen<DeclarationId>.clone(&self.owner), source: Source.copy(&self.source)}
  }
  pub fn span(self: &Self) -> Span {
    return match &self.source {
      Source.Generated {..} => Span.make(usize.ZERO, usize.ZERO)
      Source.Relative {..} => CompilerBug.panic(b"MissingRetainedFact: unplaced backend gap")
      Source.Declaration {span, ..} => span
      Source.Diagnostic {diagnostic} => Shared<Rejection>.with<Span>(&diagnostic,
        fn(value: &Rejection) -> Span { return value.span })
    }
  }
  pub fn moduleMatches(self: &Self, module: &ModuleId) -> bool {
    return match &self.source {
      Source.Declaration {declaration, ..} => Frozen<DeclarationId>.with<bool>(&declaration,
        fn(value: &DeclarationId) -> bool { return ModuleId.equals(DeclarationId.moduleId(value), module) })
      Source.Relative {declaration, ..} => Frozen<DeclarationId>.with<bool>(&declaration,
        fn(value: &DeclarationId) -> bool { return ModuleId.equals(DeclarationId.moduleId(value), module) })
      Source.Generated {declaration} => Frozen<DeclarationId>.with<bool>(&declaration,
        fn(value: &DeclarationId) -> bool { return ModuleId.equals(DeclarationId.moduleId(value), module) })
      Source.Diagnostic {diagnostic} => Shared<Rejection>.with<bool>(&diagnostic,
        fn(value: &Rejection) -> bool { return ModuleId.equals(&value.module, module) })
    }
  }
  /// Copies the authored logical path for machine-readable reporting; no borrow escapes Shared.
  pub effect fn sourcePath(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    match &self.source {
      Source.Declaration {declaration, ..} => {
        let module = Frozen<DeclarationId>.with<ModuleId>(&declaration, fn(value: &DeclarationId) -> ModuleId {
          return ModuleId.copy(DeclarationId.moduleId(value))
        })
        return run ModuleId.copyPath(&module)
      }
      Source.Relative {declaration, ..} => {
        let module = Frozen<DeclarationId>.with<ModuleId>(&declaration, fn(value: &DeclarationId) -> ModuleId {
          return ModuleId.copy(DeclarationId.moduleId(value))
        })
        return run ModuleId.copyPath(&module)
      }
      Source.Generated {declaration} => {
        let module = Frozen<DeclarationId>.with<ModuleId>(&declaration, fn(value: &DeclarationId) -> ModuleId {
          return ModuleId.copy(DeclarationId.moduleId(value))
        })
        return run ModuleId.copyPath(&module)
      }
      Source.Diagnostic {diagnostic} => {
        let module = Shared<Rejection>.with<ModuleId>(&diagnostic, fn(value: &Rejection) -> ModuleId {
          return ModuleId.copy(&value.module)
        })
        return run ModuleId.copyPath(&module)
      }
    }
  }
  pub fn name(code: Code) -> &'static [u8] {
    return match code {
      Code.ScalarLayout => b"scalar-layout"
      Code.FloatLiteral => b"float-literal"
      Code.IntegerLiteral => b"integer-literal"
      Code.MissingCallArgument => b"missing-call-argument"
      Code.TypedForm => b"typed-form"
      Code.IntrinsicMember => b"intrinsic-member"
      Code.ExpectedExpression => b"expected-expression"
      Code.ExpectedPlace => b"expected-place"
      Code.PlaceProjection => b"place-projection"
      Code.FieldProjection => b"field-projection"
      Code.IndexProjection => b"index-projection"
      Code.SliceLayout => b"slice-layout"
      Code.BreakOutsideLoop => b"break-outside-loop"
      Code.ContinueOutsideLoop => b"continue-outside-loop"
      Code.MissingBlockStatement => b"missing-block-statement"
      Code.SignatureForm => b"signature-form"
      Code.StaticResidualization => b"static-residualization"
      Code.ArithmeticTrap => b"arithmetic-trap"
      Code.CalleeModule => b"callee-module"
      Code.OpenInstance => b"open-instance"
      Code.EffectForm => b"effect-form"
      Code.FailureIdentity => b"failure-identity"
      Code.CoreType => b"core-type"
      Code.IntrinsicWitness => b"intrinsic-witness"
      Code.CallTargetDiscovery => b"call-target-discovery"
      Code.MutableParameter => b"mutable-parameter-binding"
      Code.GenericOperation => b"generic-operation"
      Code.WitnessOperand => b"witness-operand"
      Code.Cleanup => b"cleanup"
      Code.OwnedBindingRead => b"owned-binding-read"
    }
  }
  /// Whether `code` guards an invariant an earlier phase establishes, so reaching it means the
  /// compiler produced malformed input: it reports an internal compiler error, never a missing
  /// language feature.
  pub fn internal(code: Code) -> bool {
    return match code {
      Code.TypedForm => true
      Code.MissingCallArgument => true
      Code.IntrinsicMember => true
      Code.ExpectedPlace => true
      Code.ScalarLayout => true
      Code.IndexProjection => true
      Code.SliceLayout => true
      Code.FieldProjection => true
      Code.PlaceProjection => true
      Code.BreakOutsideLoop => true
      Code.ContinueOutsideLoop => true
      Code.MissingBlockStatement => true
      Code.ExpectedExpression => true
      Code.IntegerLiteral => true
      Code.FloatLiteral => true
      Code.CoreType => true
      _ => false
    }
  }
  /// Classifies a precise semantic deferral without replacing its authored source evidence.
  pub fn forRejection(code: RejectionCode) -> Option<Code> {
    return match code {
      RejectionCode.IntrinsicWitnessUnavailable => Option<Code>.some(Code.IntrinsicWitness)
      RejectionCode.CallTargetUnavailable => Option<Code>.some(Code.CallTargetDiscovery)
      RejectionCode.MutableParameterUnavailable => Option<Code>.some(Code.MutableParameter)
      _ => Option<Code>.none()
    }
  }
}
