//! Explicit backend coverage failures for reached programs.

import lexer.Span {Span}
import semantic.Anchor {Anchor}
import semantic.SourceLocations {Location}
import semantic.DeclarationId {DeclarationId}
import semantic.ModuleId {ModuleId}
import semantic.Rejection {Rejection, RejectionCode}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.shared {Shared}
import silk.usize

/// One stable reason code for a reached but unimplemented backend form.
pub enum Code {
  ScalarLayout,
  CAbiTarget,
  CAbiAggregate,
  CAbiCallback,
  CAbiVariadic,
  ForeignContract,
  ForeignExport,
  ForeignAbi,
  ForeignStatic,
  IntegerLiteral,
  FloatLiteral,
  MissingCallArgument,
  TypedForm,
  UnionForm,
  IntrinsicMember,
  ProfileInput,
  ExpectedExpression,
  ExpectedPlace,
  PlaceProjection,
  FieldProjection,
  IndexProjection,
  SliceLayout,
  BreakOutsideLoop,
  ContinueOutsideLoop,
  MissingBlockStatement,
  SignatureForm,
  StaticResidualization,
  ArithmeticTrap,
  UnitParameter,
  CalleeModule,
  OpenInstance,
  EffectForm,
  NestedEffectJoin,
  InterfaceEffectWitness,
  /// A failure type the origin-only report cannot name yet (failure observer note §4).
  FailureIdentity,
  /// An observer callback that is not a direct function (failure observer note N1).
  ObserverCallback,
  CoreType,
  BodyLifetimeElision,
  IntrinsicWitness,
  CallTargetDiscovery,
  ProviderSection,
  SectionResultInference,
  MutableParameter,
  InlineStorage,
  GenericOperation,
  WitnessOperand,
  Cleanup,
  OwnedBindingRead,
}

/// Exact source evidence, independent of the reached instance that reports it.
pub union Source {
  Declaration {pub declaration: Shared<DeclarationId>, pub span: Span},
  Generated {pub declaration: Shared<DeclarationId>},
  Relative {pub declaration: Shared<DeclarationId>, pub location: Location},
  Diagnostic {pub diagnostic: Shared<Rejection>},
}

impl Source {
  pub fn copy(self: &Self) -> Self {
    return match &self.* {
      Source.Declaration {declaration, span} => Source.Declaration {declaration: Shared<DeclarationId>.clone(&declaration), span: span}
      Source.Generated {declaration} => Source.Generated {declaration: Shared<DeclarationId>.clone(&declaration)}
      Source.Relative {declaration, location} => Source.Relative {declaration: Shared<DeclarationId>.clone(&declaration), location: location}
      Source.Diagnostic {diagnostic} => Source.Diagnostic {diagnostic: Shared<Rejection>.clone(&diagnostic)}
    }
  }
}

/// A reached form that the current backend cannot compile.
pub struct Gap {
  pub code: Code
  pub owner: Shared<DeclarationId>
  pub source: Source
}

impl Gap {
  pub fn make(code: Code, owner: &Shared<DeclarationId>, span: Span) -> Gap {
    return Gap {code: code, owner: Shared<DeclarationId>.clone(owner),
      source: Source.Declaration {declaration: Shared<DeclarationId>.clone(owner), span: span}}
  }
  pub fn fromSource(code: Code, owner: &Shared<DeclarationId>, source: &Source) -> Gap {
    return Gap {code: code, owner: Shared<DeclarationId>.clone(owner), source: Source.copy(source)}
  }
  /// A backend failure retains stable token boundaries until the source-facing report is placed.
  pub fn relative(code: Code, owner: &Shared<DeclarationId>, location: Location) -> Gap {
    if !Location.isAuthored(location) {
      return Gap {code: code, owner: Shared<DeclarationId>.clone(owner),
        source: Source.Generated {declaration: Shared<DeclarationId>.clone(owner)}}
    }
    return Gap {code: code, owner: Shared<DeclarationId>.clone(owner),
      source: Source.Relative {declaration: Shared<DeclarationId>.clone(owner), location: location}}
  }
  pub fn anchored(self: Self, anchor: &Anchor) -> Self {
    let Gap {code, owner, source} = move self
    let placed = match move source {
      Source.Relative {declaration, location} => Source.Declaration {declaration: move declaration,
        span: Anchor.span(anchor, location)}
      Source.Generated {declaration} => Source.Generated {declaration: move declaration}
      Source.Declaration {declaration, span} => Source.Declaration {declaration: move declaration, span: span}
      Source.Diagnostic {diagnostic} => Source.Diagnostic {diagnostic: move diagnostic}
    }
    return Gap {code: code, owner: move owner, source: move placed}
  }
  /// Retains a propagated rejection's module and span without attributing them to its caller.
  pub fn fromRejection(code: Code, owner: &Shared<DeclarationId>, diagnostic: &Shared<Rejection>) -> Gap {
    return Gap {code: code, owner: Shared<DeclarationId>.clone(owner),
      source: Source.Diagnostic {diagnostic: Shared<Rejection>.clone(diagnostic)}}
  }
  pub fn copy(self: &Self) -> Gap {
    return Gap {code: self.code, owner: Shared<DeclarationId>.clone(&self.owner), source: Source.copy(&self.source)}
  }
  pub fn span(self: &Self) -> Span {
    return match &self.source {
      Source.Generated {..} => Span.make(usize.ZERO, usize.ZERO)
      Source.Relative {..} => {
        let boom = 1 / 0
        return Span.make(usize.ZERO, usize.ZERO)
      }
      Source.Declaration {span, ..} => span
      Source.Diagnostic {diagnostic} => Shared<Rejection>.with<Span>(&diagnostic,
        fn(value: &Rejection) -> Span { return value.span })
    }
  }
  pub fn moduleMatches(self: &Self, module: &ModuleId) -> bool {
    return match &self.source {
      Source.Declaration {declaration, ..} => Shared<DeclarationId>.with<bool>(&declaration,
        fn(value: &DeclarationId) -> bool { return ModuleId.equals(DeclarationId.moduleId(value), module) })
      Source.Relative {declaration, ..} => Shared<DeclarationId>.with<bool>(&declaration,
        fn(value: &DeclarationId) -> bool { return ModuleId.equals(DeclarationId.moduleId(value), module) })
      Source.Generated {declaration} => Shared<DeclarationId>.with<bool>(&declaration,
        fn(value: &DeclarationId) -> bool { return ModuleId.equals(DeclarationId.moduleId(value), module) })
      Source.Diagnostic {diagnostic} => Shared<Rejection>.with<bool>(&diagnostic,
        fn(value: &Rejection) -> bool { return ModuleId.equals(&value.module, module) })
    }
  }
  /// Copies the authored logical path for machine-readable reporting; no borrow escapes Shared.
  pub effect fn sourcePath(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    match &self.source {
      Source.Declaration {declaration, ..} => {
        let module = Shared<DeclarationId>.with<ModuleId>(&declaration, fn(value: &DeclarationId) -> ModuleId {
          return ModuleId.copy(DeclarationId.moduleId(value))
        })
        return run ModuleId.copyPath(&module)
      }
      Source.Relative {declaration, ..} => {
        let module = Shared<DeclarationId>.with<ModuleId>(&declaration, fn(value: &DeclarationId) -> ModuleId {
          return ModuleId.copy(DeclarationId.moduleId(value))
        })
        return run ModuleId.copyPath(&module)
      }
      Source.Generated {declaration} => {
        let module = Shared<DeclarationId>.with<ModuleId>(&declaration, fn(value: &DeclarationId) -> ModuleId {
          return ModuleId.copy(DeclarationId.moduleId(value))
        })
        return run ModuleId.copyPath(&module)
      }
      Source.Diagnostic {diagnostic} => {
        let module = Shared<Rejection>.with<ModuleId>(&diagnostic, fn(value: &Rejection) -> ModuleId {
          return ModuleId.copy(&value.module)
        })
        return run ModuleId.copyPath(&module)
      }
    }
  }
  pub fn name(code: Code) -> &'static [u8] {
    return match code {
      Code.CAbiTarget => b"c-abi-target"
      Code.CAbiAggregate => b"c-abi-aggregate"
      Code.CAbiCallback => b"c-abi-callback"
      Code.CAbiVariadic => b"c-abi-variadic"
      Code.ForeignContract => b"foreign-contract"
      Code.ForeignExport => b"foreign-export"
      Code.ForeignAbi => b"foreign-abi"
      Code.ForeignStatic => b"foreign-static"
      Code.ScalarLayout => b"scalar-layout"
      Code.FloatLiteral => b"float-literal"
      Code.IntegerLiteral => b"integer-literal"
      Code.MissingCallArgument => b"missing-call-argument"
      Code.TypedForm => b"typed-form"
      Code.UnionForm => b"union-form"
      Code.IntrinsicMember => b"intrinsic-member"
      Code.ProfileInput => b"profile-input"
      Code.ExpectedExpression => b"expected-expression"
      Code.ExpectedPlace => b"expected-place"
      Code.PlaceProjection => b"place-projection"
      Code.FieldProjection => b"field-projection"
      Code.IndexProjection => b"index-projection"
      Code.SliceLayout => b"slice-layout"
      Code.BreakOutsideLoop => b"break-outside-loop"
      Code.ContinueOutsideLoop => b"continue-outside-loop"
      Code.MissingBlockStatement => b"missing-block-statement"
      Code.SignatureForm => b"signature-form"
      Code.StaticResidualization => b"static-residualization"
      Code.ArithmeticTrap => b"arithmetic-trap"
      Code.UnitParameter => b"unit-parameter"
      Code.CalleeModule => b"callee-module"
      Code.OpenInstance => b"open-instance"
      Code.EffectForm => b"effect-form"
      Code.NestedEffectJoin => b"nested-effect-join"
      Code.InterfaceEffectWitness => b"interface-effect-witness"
      Code.FailureIdentity => b"failure-identity"
      Code.ObserverCallback => b"observer-callback"
      Code.CoreType => b"core-type"
      Code.BodyLifetimeElision => b"body-lifetime-elision"
      Code.IntrinsicWitness => b"intrinsic-witness"
      Code.CallTargetDiscovery => b"call-target-discovery"
      Code.ProviderSection => b"provider-section"
      Code.SectionResultInference => b"section-result-inference"
      Code.MutableParameter => b"mutable-parameter-binding"
      Code.InlineStorage => b"inline-storage-recursion"
      Code.GenericOperation => b"generic-operation"
      Code.WitnessOperand => b"witness-operand"
      Code.Cleanup => b"cleanup"
      Code.OwnedBindingRead => b"owned-binding-read"
    }
  }
  /// Classifies a precise semantic deferral without replacing its authored source evidence.
  pub fn forRejection(code: RejectionCode) -> Option<Code> {
    return match code {
      RejectionCode.UnionFormUnavailable => Option<Code>.some(Code.UnionForm)
      RejectionCode.EffectFormUnavailable => Option<Code>.some(Code.EffectForm)
      RejectionCode.NestedEffectJoinUnavailable => Option<Code>.some(Code.NestedEffectJoin)
      RejectionCode.InterfaceEffectUnavailable => Option<Code>.some(Code.InterfaceEffectWitness)
      RejectionCode.CaptureAvailabilityUnavailable => Option<Code>.some(Code.Cleanup)
      RejectionCode.IntrinsicUnavailable => Option<Code>.some(Code.IntrinsicMember)
      RejectionCode.ProfileInputUnavailable => Option<Code>.some(Code.ProfileInput)
      RejectionCode.ForeignStaticUnavailable => Option<Code>.some(Code.ForeignStatic)
      RejectionCode.ForeignAggregate => Option<Code>.some(Code.CAbiAggregate)
      RejectionCode.ForeignCallback => Option<Code>.some(Code.CAbiCallback)
      RejectionCode.ForeignVariadic => Option<Code>.some(Code.CAbiVariadic)
      RejectionCode.BodyLifetimeElisionUnavailable => Option<Code>.some(Code.BodyLifetimeElision)
      RejectionCode.IntrinsicWitnessUnavailable => Option<Code>.some(Code.IntrinsicWitness)
      RejectionCode.CallTargetUnavailable => Option<Code>.some(Code.CallTargetDiscovery)
      RejectionCode.ProviderSectionUnavailable => Option<Code>.some(Code.ProviderSection)
      RejectionCode.SectionResultInferenceUnavailable => Option<Code>.some(Code.SectionResultInference)
      RejectionCode.MutableParameterUnavailable => Option<Code>.some(Code.MutableParameter)
      RejectionCode.InlineStorageUnavailable => Option<Code>.some(Code.InlineStorage)
      _ => Option<Code>.none()
    }
  }
}
