//! Which values of one typed body need cleanup under its instance's bindings.
//!
//! # When to use
//! Semantic analysis answers the Drop-aware question once per lowered body, with the `impl Drop`
//! implementation query, and MIR lowering reads the answers by typed-body index. Lowering never
//! decides cleanup from a type's spelling.

import silk.usize
import silk.vector {Vector}

/// One verdict per typed-body local and per node value: whether dropping it runs cleanup because
/// its owned structure carries `impl Drop`.
pub struct CleanupNeeds {
  pub locals: Vector<bool>
  pub nodes: Vector<bool>
}

impl CleanupNeeds {
  /// Whether typed-body local `index` needs cleanup.
  pub fn local(self: &CleanupNeeds, index: usize) -> bool {
    let listed = Vector.asSlice<bool>(&self.locals)
    return index < listed.length && listed[index]
  }

  /// Whether the value of typed-body node `index` needs cleanup.
  pub fn node(self: &CleanupNeeds, index: usize) -> bool {
    let listed = Vector.asSlice<bool>(&self.nodes)
    return index < listed.length && listed[index]
  }

  /// Whether any local or node value of the body needs cleanup.
  pub fn any(self: &CleanupNeeds) -> bool {
    return anyTrue(Vector.asSlice<bool>(&self.locals)) || anyTrue(Vector.asSlice<bool>(&self.nodes))
  }
}

fn anyTrue(values: &[bool]) -> bool {
  let mut at = usize.ZERO
  while at < values.length {
    if values[at] { return true }
    at = at + usize.ONE
  }
  return false
}
