//! Complete equality of the MIR fields consumed by emission, closure discovery and reporting.

import backend.InstanceRecipe {InstanceRecipe}
import backend.InstanceKey {InstanceKey}
import backend.Mir {MirFunction, Local, Block, Statement, Terminator, Reference, ContextText, TrapSite}
import semantic.DeclarationId {DeclarationId}
import semantic.Type {Type}
import semantic.TypedBody {Origin}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.pointer {Pointer}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn sameOrigin(first: Origin, second: Origin) -> bool {
  return first.syntax.index == second.syntax.index && first.span.start == second.span.start && first.span.end == second.span.end
}

fn statementOrigin(value: &Statement) -> Origin {
  return match &value.* {
    Statement.Assign {origin, ..} => origin
    Statement.Drop {origin, ..} => origin
    Statement.FailureContext {origin, ..} => origin
    Statement.SetContextHandle {origin, ..} => origin
  }
}

fn terminatorOrigin(value: &Terminator) -> Origin {
  return match &value.* {
    Terminator.Goto {origin, ..} => origin Terminator.Branch {origin, ..} => origin
    Terminator.Return {origin} => origin Terminator.Call {origin, ..} => origin
    Terminator.Fail {origin} => origin Terminator.Trap {origin} => origin
    Terminator.Unreachable {origin} => origin Terminator.Switch {origin, ..} => origin
    Terminator.Relinquish {origin, ..} => origin Terminator.Abandon {origin} => origin
  }
}

fn declarationAddress(value: &DeclarationId) -> usize {
  return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(value))
}

fn sameDeclarationWith(first: &DeclarationId, right: &Shared<DeclarationId>) -> bool {
  return Shared.with<DeclarationId, bool>(right, fn(second: &DeclarationId) -> bool { return DeclarationId.equals(first, second) })
}

fn sameDeclaration(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  if Shared.with<DeclarationId, usize>(left, declarationAddress) == Shared.with<DeclarationId, usize>(right, declarationAddress) { return true }
  return Shared.with<DeclarationId, bool>(left, fn(first: &DeclarationId) -> bool { return sameDeclarationWith(first, right) })
}

/// Runtime instruction equality also retains exact type/instance identity and all authored origins.
/// Region-selection sensitivity is compared by the semantic store alongside this immutable graph.
pub effect fn same(left: &MirFunction, right: &MirFunction) -> bool
! OutOfMemoryError ? &mut Allocator {
  if left.safetyChecked != right.safetyChecked || left.observes != right.observes
    || !run InstanceKey.sameInstance(&left.key, &right.key, true)
    || !run Type.equalsShared(&left.result, &right.result) { return false }
  let first = run InstanceRecipe.make(left)
  let second = run InstanceRecipe.make(right)
  if !sameBytes(Bytes.asSlice(&first.shape), Bytes.asSlice(&second.shape)) { return false }
  let callees = Vector.asSlice<InstanceKey>(&first.callees)
  let otherCallees = Vector.asSlice<InstanceKey>(&second.callees)
  if callees.length != otherCallees.length { return false }
  let mut at = usize.ZERO
  while at < callees.length {
    if !run InstanceKey.sameInstance(&callees[at], &otherCallees[at], true) { return false }
    at = at + usize.ONE
  }
  let parameters = Vector.asSlice<Shared<Type>>(&left.parameters)
  let otherParameters = Vector.asSlice<Shared<Type>>(&right.parameters)
  if parameters.length != otherParameters.length { return false }
  at = usize.ZERO
  while at < parameters.length {
    if !run Type.equalsShared(&parameters[at], &otherParameters[at]) { return false }
    at = at + usize.ONE
  }
  let locals = Vector.asSlice<Local>(&left.locals)
  let otherLocals = Vector.asSlice<Local>(&right.locals)
  if locals.length != otherLocals.length { return false }
  at = usize.ZERO
  while at < locals.length {
    if !sameOrigin(locals[at].origin, otherLocals[at].origin)
      || !run Type.equalsShared(&locals[at].ty, &otherLocals[at].ty) { return false }
    at = at + usize.ONE
  }
  let blocks = Vector.asSlice<Block>(&left.blocks)
  let otherBlocks = Vector.asSlice<Block>(&right.blocks)
  if blocks.length != otherBlocks.length { return false }
  at = usize.ZERO
  while at < blocks.length {
    if !sameOrigin(terminatorOrigin(&blocks[at].terminator), terminatorOrigin(&otherBlocks[at].terminator)) { return false }
    let statements = Vector.asSlice<Statement>(&blocks[at].statements)
    let otherStatements = Vector.asSlice<Statement>(&otherBlocks[at].statements)
    if statements.length != otherStatements.length { return false }
    let mut statement = usize.ZERO
    while statement < statements.length {
      if !sameOrigin(statementOrigin(&statements[statement]), statementOrigin(&otherStatements[statement])) { return false }
      statement = statement + usize.ONE
    }
    at = at + usize.ONE
  }
  let references = Vector.asSlice<Reference>(&left.references)
  let otherReferences = Vector.asSlice<Reference>(&right.references)
  if references.length != otherReferences.length { return false }
  at = usize.ZERO
  while at < references.length {
    if references[at].edge != otherReferences[at].edge || !sameOrigin(references[at].origin, otherReferences[at].origin)
      || !run InstanceKey.sameInstance(&references[at].key, &otherReferences[at].key, true) { return false }
    at = at + usize.ONE
  }
  let externs = Vector.asSlice<Shared<DeclarationId>>(&left.externs)
  let otherExterns = Vector.asSlice<Shared<DeclarationId>>(&right.externs)
  if externs.length != otherExterns.length { return false }
  at = usize.ZERO
  while at < externs.length {
    if !sameDeclaration(&externs[at], &otherExterns[at]) { return false }
    at = at + usize.ONE
  }
  let contexts = Vector.asSlice<ContextText>(&left.contexts)
  let otherContexts = Vector.asSlice<ContextText>(&right.contexts)
  if contexts.length != otherContexts.length { return false }
  at = usize.ZERO
  while at < contexts.length {
    if !sameOrigin(contexts[at].origin, otherContexts[at].origin) { return false }
    at = at + usize.ONE
  }
  let traps = Vector.asSlice<TrapSite>(&left.traps)
  let otherTraps = Vector.asSlice<TrapSite>(&right.traps)
  if traps.length != otherTraps.length { return false }
  at = usize.ZERO
  while at < traps.length {
    if !sameOrigin(traps[at].origin, otherTraps[at].origin) { return false }
    at = at + usize.ONE
  }
  return match &left.suspension {
    Option<Origin>.Some {value} => match &right.suspension { Option<Origin>.Some {value: other} => sameOrigin(value, other) _ => false }
    _ => match &right.suspension { Option<Origin>.None => true _ => false }
  }
}
