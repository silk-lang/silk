//! Complete equality of the MIR fields consumed by emission, closure discovery and reporting.

import backend.InstanceRecipe {InstanceRecipe}
import backend.InstanceKey {InstanceKey}
import backend.Mir {
  MirFunction,
  Local,
  LocalKind,
  Projection,
  Block,
  Statement,
  Terminator,
  Reference,
  ContextText,
  TrapSite,
}
import semantic.DeclarationId {DeclarationId}
import semantic.Specialization {Edge}
import semantic.Type {Type}
import semantic.TypedBody {Origin}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.pointer {Pointer}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn sameProjection(first: &Projection, second: &Projection) -> bool
! OutOfMemoryError
? &mut Allocator {
  return match & first.* {
    Projection.Field {index} => match & second.* {
      Projection.Field {index: other} => index == other
      _ => false
    }
    Projection.Payload {index, ty} => match & second.* {
      Projection.Payload {index: other, ty: otherType} => index == other && (run Type.equalsShared(
        &ty,
        &otherType,
      ))
      _ => false
    }
    Projection.VariantField {variant, field} => match & second.* {
      Projection.VariantField {variant: other, field: otherField} => variant == other && field == otherField
      _ => false
    }
    Projection.Index {local} => match & second.* {
      Projection.Index {local: other} => local == other
      _ => false
    }
    Projection.ConstIndex {index} => match & second.* {
      Projection.ConstIndex {index: other} => index == other
      _ => false
    }
    Projection.Deref => match & second.* {
      Projection.Deref => true
      _ => false
    }
  }
}

effect fn sameProjections(first: &[Projection], second: &[Projection]) -> bool
! OutOfMemoryError
? &mut Allocator {
  if first.length != second.length {
    return false
  }
  let mut at = usize.ZERO
  while at < first.length {
    if !(run sameProjection(&first[at], &second[at])) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn sameLocalKind(first: &LocalKind, second: &LocalKind) -> bool
! OutOfMemoryError
? &mut Allocator {
  return match & first.* {
    LocalKind.Return => match & second.* {
      LocalKind.Return => true
      _ => false
    }
    LocalKind.Parameter {index} => match & second.* {
      LocalKind.Parameter {index: other} => index == other
      _ => false
    }
    LocalKind.User {index} => match & second.* {
      LocalKind.User {index: other} => index == other
      _ => false
    }
    LocalKind.Temp => match & second.* {
      LocalKind.Temp => true
      _ => false
    }
    LocalKind.Failure => match & second.* {
      LocalKind.Failure => true
      _ => false
    }
    LocalKind.Provider {index} => match & second.* {
      LocalKind.Provider {index: other} => index == other
      _ => false
    }
    LocalKind.Observer => match & second.* {
      LocalKind.Observer => true
      _ => false
    }
    LocalKind.Cause => match & second.* {
      LocalKind.Cause => true
      _ => false
    }
    LocalKind.DropFlag {local, path} => match & second.* {
      LocalKind.DropFlag {local: other, path: otherPath} => local == other && (run sameProjections(
        Vector.asSlice<Projection>(&path),
        Vector.asSlice<Projection>(&otherPath),
      ))
      _ => false
    }
  }
}

fn sameOrigin(first: Origin, second: Origin) -> bool {
  return first.syntax.index == second.syntax.index && first.span.start == second.span.start && first.span.end == second.span.end
}

fn statementOrigin(value: &Statement) -> Origin {
  return match & value.* {
    Statement.Assign {origin, ..} => origin
    Statement.Drop {origin, ..} => origin
    Statement.FailureContext {origin, ..} => origin
    Statement.SetContextHandle {origin, ..} => origin
  }
}

fn terminatorOrigin(value: &Terminator) -> Origin {
  return match & value.* {
    Terminator.Goto {origin, ..} => origin
    Terminator.Branch {origin, ..} => origin
    Terminator.Return {origin} => origin
    Terminator.Call {origin, ..} => origin
    Terminator.Fail {origin} => origin
    Terminator.Trap {origin} => origin
    Terminator.Unreachable {origin} => origin
    Terminator.Switch {origin, ..} => origin
    Terminator.Relinquish {origin, ..} => origin
    Terminator.Abandon {origin} => origin
  }
}

fn declarationAddress(value: &DeclarationId) -> usize {
  return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(value))
}

fn sameDeclarationWith(first: &DeclarationId, right: &Shared<DeclarationId>) -> bool {
  return Shared.with<DeclarationId, bool>(
    right,
    fn(second: &DeclarationId) -> bool {
      return DeclarationId.equals(first, second)
    },
  )
}

fn sameDeclaration(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  if Shared.with<DeclarationId, usize>(left, declarationAddress) == Shared.with<
    DeclarationId,
    usize,
  >(right, declarationAddress) {
    return true
  }
  return Shared.with<DeclarationId, bool>(
    left,
    fn(first: &DeclarationId) -> bool {
      return sameDeclarationWith(first, right)
    },
  )
}

/// Runtime instruction equality also retains exact type/instance identity and all authored origins.
/// Region-selection sensitivity is compared by the semantic store alongside this immutable graph.
pub effect fn same(left: &MirFunction, right: &MirFunction) -> bool
! OutOfMemoryError
? &mut Allocator {
  if left.safetyChecked != right.safetyChecked || left.observes != right.observes || !(run InstanceKey.sameInstance(
    &left.key,
    &right.key,
    true,
  )) || !run Type.equalsShared(&left.result, &right.result) {
    return false
  }
  let first = run InstanceRecipe.exact(left)
  let second = run InstanceRecipe.exact(right)
  if !sameBytes(Bytes.asSlice(&first.shape), Bytes.asSlice(&second.shape)) {
    return false
  }
  let callees = Vector.asSlice<InstanceKey>(&first.callees)
  let otherCallees = Vector.asSlice<InstanceKey>(&second.callees)
  if callees.length != otherCallees.length {
    return false
  }
  let mut at = usize.ZERO
  while at < callees.length {
    if !run InstanceKey.sameInstance(&callees[at], &otherCallees[at], true) {
      return false
    }
    at = at + usize.ONE
  }
  let parameters = Vector.asSlice<Shared<Type>>(&left.parameters)
  let otherParameters = Vector.asSlice<Shared<Type>>(&right.parameters)
  if parameters.length != otherParameters.length {
    return false
  }
  at = usize.ZERO
  while at < parameters.length {
    if !run Type.equalsShared(&parameters[at], &otherParameters[at]) {
      return false
    }
    at = at + usize.ONE
  }
  let locals = Vector.asSlice<Local>(&left.locals)
  let otherLocals = Vector.asSlice<Local>(&right.locals)
  if locals.length != otherLocals.length {
    return false
  }
  at = usize.ZERO
  while at < locals.length {
    if !(run sameLocalKind(&locals[at].kind, &otherLocals[at].kind)) || !sameOrigin(
      locals[at].origin,
      otherLocals[at].origin,
    ) || !run Type.equalsShared(&locals[at].ty, &otherLocals[at].ty) {
      return false
    }
    at = at + usize.ONE
  }
  let blocks = Vector.asSlice<Block>(&left.blocks)
  let otherBlocks = Vector.asSlice<Block>(&right.blocks)
  if blocks.length != otherBlocks.length {
    return false
  }
  at = usize.ZERO
  while at < blocks.length {
    if !sameOrigin(
      terminatorOrigin(&blocks[at].terminator),
      terminatorOrigin(&otherBlocks[at].terminator),
    ) {
      return false
    }
    let statements = Vector.asSlice<Statement>(&blocks[at].statements)
    let otherStatements = Vector.asSlice<Statement>(&otherBlocks[at].statements)
    if statements.length != otherStatements.length {
      return false
    }
    let mut statement = usize.ZERO
    while statement < statements.length {
      if !sameOrigin(
        statementOrigin(&statements[statement]),
        statementOrigin(&otherStatements[statement]),
      ) {
        return false
      }
      statement = statement + usize.ONE
    }
    at = at + usize.ONE
  }
  let references = Vector.asSlice<Reference>(&left.references)
  let otherReferences = Vector.asSlice<Reference>(&right.references)
  if references.length != otherReferences.length {
    return false
  }
  at = usize.ZERO
  while at < references.length {
    if !(run Edge.equals(&references[at].edge, &otherReferences[at].edge)) || !sameOrigin(
      references[at].origin,
      otherReferences[at].origin,
    ) || !run InstanceKey.sameInstance(&references[at].key, &otherReferences[at].key, true) {
      return false
    }
    at = at + usize.ONE
  }
  let externs = Vector.asSlice<Shared<DeclarationId>>(&left.externs)
  let otherExterns = Vector.asSlice<Shared<DeclarationId>>(&right.externs)
  if externs.length != otherExterns.length {
    return false
  }
  at = usize.ZERO
  while at < externs.length {
    if !sameDeclaration(&externs[at], &otherExterns[at]) {
      return false
    }
    at = at + usize.ONE
  }
  let contexts = Vector.asSlice<ContextText>(&left.contexts)
  let otherContexts = Vector.asSlice<ContextText>(&right.contexts)
  if contexts.length != otherContexts.length {
    return false
  }
  at = usize.ZERO
  while at < contexts.length {
    if !sameOrigin(contexts[at].origin, otherContexts[at].origin) {
      return false
    }
    at = at + usize.ONE
  }
  let traps = Vector.asSlice<TrapSite>(&left.traps)
  let otherTraps = Vector.asSlice<TrapSite>(&right.traps)
  if traps.length != otherTraps.length {
    return false
  }
  at = usize.ZERO
  while at < traps.length {
    if !sameOrigin(traps[at].origin, otherTraps[at].origin) {
      return false
    }
    at = at + usize.ONE
  }
  return match & left.suspension {
    Option<Origin>.Some {value} => match & right.suspension {
      Option<Origin>.Some {value: other} => sameOrigin(value, other)
      _ => false
    }
    _ => match & right.suspension {
      Option<Origin>.None => true
      _ => false
    }
  }
}
