//! The private coroutine of one suspendable instance (SUSP private lowering model).
//!
//! # Details
//!
//! Eligible forwarding calls are first inlined into their caller's MIR, including their cleanup
//! exits. Each remaining instance is suspendable when it runs a boundary or calls a suspendable instance
//! directly; every such call is a suspension point. Its ordinary symbol drives a transfer record:
//! `$enter` pushes the instance's frame from the selected execution storage, and the driver runs the
//! `$step` of the frame on top until no frame remains. A step returns 0 when its frame completed and
//! was released, 1 when a frame above its own waits for the driver, and 2 when it relinquished its
//! execution package: its frames stay in the package's own transfer record and the package's start
//! continues them at the next drive.
//!
//! A point whose callee can call back into the caller, a recursive cycle of suspendable instances,
//! pushes its callee's frame, saves its state and returns 1, so every recursive cycle gives the
//! machine stack back to the driver once per turn (SUSP-003). Every other point pushes the callee's
//! frame and runs its step directly, as an ordinary call: when that step completes, the caller
//! continues in place with its locals where they were, and only a step that returns 1 or 2 makes
//! the caller save its state and return the same code. Machine stack then grows with the longest
//! chain of suspendable calls that repeats no instance, as it does for ordinary calls.
//!
//! Dropping a relinquished package cancels its frames top-down. A step that finds its package
//! destroyed restores its point's state and runs that point's cancel exit, which drops every owner
//! live there and abandons the frame: the frame is released and its caller's frame cancels next.
//!
//! A frame never moves. Locals whose address can escape, and the places a suspended callee writes,
//! stay in the frame for their whole lifetime. Every other local that lives across a point is saved
//! into that point's resume state, and the states of different points share storage.
//! Resident temporaries and bindings whose address nothing takes share storage with each other
//! when no block holds two of them at once, and so do the context companions they own.

import backend.Mir {MirDraft}
import backend.InstanceKey {InstanceKey}
import backend.LoweringPlan {failureLocal}
import backend.Mir {
  AggregateField,
  AssemblyFragment,
  Block,
  Callee,
  Cancel,
  Diagnostics,
  FailureEdge,
  Local,
  LocalKind,
  MirView,
  Operand,
  Place,
  Projection,
  Rvalue,
  Statement,
  Terminator,
}
import CompilerBug
import semantic.Type {Type}
import silk.mem.box {Box}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.mem.interned {Interned}
import silk.num.u64
import silk.num.usize
import silk.collections.list {List}

/// The emission facts of one suspendable instance.
pub struct Facts {
  /// Its suspendable callees, including those reached through selected inlining candidates.
  pub callees: List<InstanceKey>,
  /// Per callee, whether it can call back into this instance: a recursive cycle of suspendable
  /// instances, whose calls transfer through the driver (SUSP-003).
  pub cyclic: List<bool>,
  /// Acyclic forwarding callees whose checked MIR may be spliced into this frame.
  pub inline: List<InstanceKey>,
  /// The C symbols of the selected execution-storage operations.
  pub create: Bytes,
  pub acquire: Bytes,
  pub release: Bytes,
  pub destroy: Bytes,
}

/// The size and alignment of one local's storage.
pub struct Extent {
  pub size: usize,
  pub alignment: usize,
}

impl Copy for Extent {}

/// One local's storage at a fixed frame offset.
pub struct FrameSlot {
  pub local: usize,
  pub offset: usize,
  pub size: usize,
}

impl Copy for FrameSlot {}

/// The locals one resume state restores.
pub struct State {
  pub slots: List<FrameSlot>,
}

/// The frame of one suspendable instance.
pub struct Coroutine {
  pub size: usize,
  pub alignment: usize,
  /// Locals that live in the frame for their whole lifetime.
  pub resident: List<FrameSlot>,
  /// The context companions of failure slots, named by the slot's local; always frame-resident.
  pub companions: List<FrameSlot>,
  /// State 0 starts the body with its parameters; state `k + 1` resumes after point `k`.
  pub states: List<State>,
  /// The block whose terminator is point `k`.
  pub points: List<usize>,
}

impl Facts {
  pub effect fn copy(self: &Self) -> Facts ! OutOfMemoryError ? &mut Allocator {
    let mut cyclic = List<bool>.make()
    run List<bool>.appendSlice(&mut cyclic, List<bool>.asSlice(&self.cyclic))
    let mut callees = List<InstanceKey>.make()
    let listed = List<InstanceKey>.asSlice(&self.callees)
    let mut at = usize.ZERO
    while at < listed.length {
      run List<InstanceKey>.append(&mut callees, InstanceKey.copy(&listed[at]))
      at = at + usize.ONE
    }
    let mut inline = List<InstanceKey>.make()
    let expanded = List<InstanceKey>.asSlice(&self.inline)
    at = usize.ZERO
    while at < expanded.length {
      run List<InstanceKey>.append(&mut inline, InstanceKey.copy(&expanded[at]))
      at = at + usize.ONE
    }
    return Facts {
      inline: move inline,
      callees: move callees,
      cyclic: move cyclic,
      create: run Bytes.copy(Bytes.asSlice(&self.create)),
      acquire: run Bytes.copy(Bytes.asSlice(&self.acquire)),
      release: run Bytes.copy(Bytes.asSlice(&self.release)),
      destroy: run Bytes.copy(Bytes.asSlice(&self.destroy)),
    }
  }

  /// Whether a call to `key` is a suspension point whose callee's frame transfers through the
  /// driver because the callee can call back into this instance.
  pub effect fn transfers(self: &Self, key: &InstanceKey) -> bool ! OutOfMemoryError ? &mut Allocator {
    let listed = List<InstanceKey>.asSlice(&self.callees)
    let cyclic = List<bool>.asSlice(&self.cyclic)
    let mut at = usize.ZERO
    while at < listed.length {
      if run InstanceKey.sameApplication(&listed[at], key) { return at < cyclic.length && cyclic[at] }
      at = at + usize.ONE
    }
    return false
  }

  /// Whether a call to `key` is a suspension point.
  pub effect fn suspends(self: &Self, key: &InstanceKey) -> bool ! OutOfMemoryError ? &mut Allocator {
    let listed = List<InstanceKey>.asSlice(&self.callees)
    let mut at = usize.ZERO
    while at < listed.length {
      if run InstanceKey.sameApplication(&listed[at], key) { return true }
      at = at + usize.ONE
    }
    return false
  }

  pub effect fn equals(self: &Self, other: &Facts) -> bool ! OutOfMemoryError ? &mut Allocator {
    let expanded = List<InstanceKey>.asSlice(&self.inline)
    let otherExpanded = List<InstanceKey>.asSlice(&other.inline)
    if expanded.length != otherExpanded.length { return false }
    let mut next = usize.ZERO
    while next < expanded.length {
      if !run InstanceKey.sameApplication(&expanded[next], &otherExpanded[next]) { return false }
      next = next + usize.ONE
    }
    let left = List<InstanceKey>.asSlice(&self.callees)
    let right = List<InstanceKey>.asSlice(&other.callees)
    if left.length != right.length { return false }
    let leftCyclic = List<bool>.asSlice(&self.cyclic)
    let rightCyclic = List<bool>.asSlice(&other.cyclic)
    if leftCyclic.length != rightCyclic.length { return false }
    let mut at = usize.ZERO
    while at < left.length {
      if !run InstanceKey.sameApplication(&left[at], &right[at]) { return false }
      at = at + usize.ONE
    }
    at = usize.ZERO
    while at < leftCyclic.length {
      if leftCyclic[at] != rightCyclic[at] { return false }
      at = at + usize.ONE
    }
    return same(Bytes.asSlice(&self.create), Bytes.asSlice(&other.create))
      && same(Bytes.asSlice(&self.acquire), Bytes.asSlice(&other.acquire))
      && same(Bytes.asSlice(&self.release), Bytes.asSlice(&other.release))
      && same(Bytes.asSlice(&self.destroy), Bytes.asSlice(&other.destroy))
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn alignUp(value: usize, alignment: usize) -> usize {
  if alignment <= usize.ONE { return value }
  return (value + alignment - usize.ONE) / alignment * alignment
}

// One bit per local, `words` words per set, sets stored back to back.
fn bitWord(local: usize) -> usize { return local / 64 }

fn bitMask(local: usize) -> u64 { return u64.shiftLeft(1, usize.toU64(local - local / 64 * 64)) }

fn isSet(sets: &[u64], base: usize, local: usize) -> bool {
  return u64.bitAnd(sets[base + bitWord(local)], bitMask(local)) != 0
}

fn mark(sets: &mut [u64], base: usize, local: usize) -> () {
  let at = base + bitWord(local)
  sets[at] = u64.bitOr(sets[at], bitMask(local))
}

effect fn zeros(count: usize) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<u64>.make()
  let mut at = usize.ZERO
  while at < count {
    run List<u64>.append(&mut result, 0)
    at = at + usize.ONE
  }
  return move result
}

// The locals one block reads before writing them whole, and the locals it writes whole.
struct Effects {
  uses: List<u64>,
  defs: List<u64>,
}

fn useLocal(effects: &mut Effects, local: usize) -> () {
  if !isSet(List<u64>.asSlice(&effects.defs), usize.ZERO, local) {
    mark(List<u64>.asMutSlice(&mut effects.uses), usize.ZERO, local)
  }
}

fn usePlace(effects: &mut Effects, place: &Place) -> () {
  useLocal(&mut effects.*, place.local)
  let steps = List<Projection>.asSlice(&place.projections)
  let mut at = usize.ZERO
  while at < steps.length {
    if let Projection.Index {local} = &steps[at] { useLocal(&mut effects.*, local) }
    at = at + usize.ONE
  }
}

fn useOperand(effects: &mut Effects, operand: &Operand) -> () {
  match &operand.* {
    Operand.Copy {place} => usePlace(&mut effects.*, &place)
    Operand.Move {place} => usePlace(&mut effects.*, &place)
    _ => {}
  }
}

fn useFields(effects: &mut Effects, fields: &List<AggregateField>) -> () {
  let listed = List<AggregateField>.asSlice(fields)
  let mut at = usize.ZERO
  while at < listed.length {
    useOperand(&mut effects.*, &listed[at].value)
    at = at + usize.ONE
  }
}

fn useOperands(effects: &mut Effects, operands: &List<Operand>) -> () {
  let listed = List<Operand>.asSlice(operands)
  let mut at = usize.ZERO
  while at < listed.length {
    useOperand(&mut effects.*, &listed[at])
    at = at + usize.ONE
  }
}

fn useRvalue(effects: &mut Effects, value: &Rvalue) -> () {
  match &value.* {
    Rvalue.Aggregate {fields} => useFields(&mut effects.*, &fields)
    Rvalue.Slice {data, count} => {
      useOperand(&mut effects.*, &data)
      useOperand(&mut effects.*, &count)
    }
    Rvalue.SliceLength {place} => usePlace(&mut effects.*, &place)
    Rvalue.SliceData {place} => usePlace(&mut effects.*, &place)
    Rvalue.PointerOffset {pointer, index, ..} => {
      useOperand(&mut effects.*, &pointer)
      useOperand(&mut effects.*, &index)
    }
    Rvalue.Use {value: used} => useOperand(&mut effects.*, &used)
    Rvalue.Ref {place, ..} => usePlace(&mut effects.*, &place)
    Rvalue.AddressOf {place, ..} => usePlace(&mut effects.*, &place)
    Rvalue.Unary {value: used, ..} => useOperand(&mut effects.*, &used)
    Rvalue.Binary {left, right, ..} => {
      useOperand(&mut effects.*, &left)
      useOperand(&mut effects.*, &right)
    }
    Rvalue.ScalarBinary {left, right, ..} => {
      useOperand(&mut effects.*, &left)
      useOperand(&mut effects.*, &right)
    }
    Rvalue.ScalarUnary {value: used, ..} => useOperand(&mut effects.*, &used)
    Rvalue.Convert {value: used, ..} => useOperand(&mut effects.*, &used)
    Rvalue.Fits {value: used, ..} => useOperand(&mut effects.*, &used)
    Rvalue.AddressIntegerConversion {operand, ..} => useOperand(&mut effects.*, &operand)
    Rvalue.Bitcast {value: used, ..} => useOperand(&mut effects.*, &used)
    Rvalue.Discriminant {place} => usePlace(&mut effects.*, &place)
    Rvalue.Inject {value: used, ..} => useOperand(&mut effects.*, &used)
    Rvalue.Variant {fields, ..} => useFields(&mut effects.*, &fields)
    Rvalue.FunctionAddress {..} => {}
    Rvalue.ContextOf {place} => usePlace(&mut effects.*, &place)
    Rvalue.ContextHandle {address} => useOperand(&mut effects.*, &address)
    Rvalue.ForeignStatic {..} => {}
    Rvalue.RunningPackage => {}
    Rvalue.FrameAddress => {}
    Rvalue.ProcessWord => {}
    Rvalue.Fill {..} => {}
    Rvalue.StackAllocate {count, ..} => useOperand(&mut effects.*, &count)
    Rvalue.Wasm {operands, ..} => useOperands(&mut effects.*, &operands)
    Rvalue.Assembly {fragment} => useOperands(&mut effects.*, &Box<AssemblyFragment>.get(&fragment)[0].inputs)
    Rvalue.Atomic {operands, ..} => useOperands(&mut effects.*, &operands)
    Rvalue.Vector {operands, ..} => useOperands(&mut effects.*, &operands)
  }
}

fn useDiagnostics(effects: &mut Effects, diagnostics: &Option<Diagnostics>) -> () {
  if let Option<Diagnostics>.Some {value} = &diagnostics.* {
    useOperand(&mut effects.*, Diagnostics.observer(&value))
    useOperand(&mut effects.*, Diagnostics.cause(&value))
    useOperand(&mut effects.*, Diagnostics.site(&value))
  }
}

// With `callDefs`, a call writes a destination without projections whole after it reads its
// operands; otherwise the destination counts as read.
fn writeCall(effects: &mut Effects, destination: &Place, callDefs: bool) -> () {
  if callDefs && List<Projection>.length(&destination.projections) == usize.ZERO {
    mark(List<u64>.asMutSlice(&mut effects.defs), usize.ZERO, destination.local)
  } else {
    usePlace(&mut effects.*, destination)
  }
}

// An aggregate or variant store may write only some fields of a whole local, so it keeps the rest
// live; every other whole-local store replaces it.
fn replacesWhole(value: &Rvalue) -> bool {
  return match &value.* {
    Rvalue.Aggregate {..} => false
    Rvalue.Variant {..} => false
    _ => true
  }
}

// With `callDefs`, a call writes a destination without projections whole after it reads its
// operands; without, the destination counts as read, as a resume state needs it.
effect fn blockEffects(function: &MirView, block: &Block, words: usize, callDefs: bool) -> Effects
! OutOfMemoryError ? &mut Allocator {
  let mut effects = Effects {uses: run zeros(words), defs: run zeros(words)}
  let statements = List<Statement>.asSlice(&block.statements)
  let mut at = usize.ZERO
  while at < statements.length {
    match &statements[at] {
      Statement.Assign {destination, value, ..} => {
        useRvalue(&mut effects, &value)
        if List<Projection>.length(&destination.projections) == usize.ZERO && replacesWhole(&value) {
          mark(List<u64>.asMutSlice(&mut effects.defs), usize.ZERO, destination.local)
        } else {
          usePlace(&mut effects, &destination)
        }
      }
      Statement.Drop {destination, diagnostics, ..} => {
        usePlace(&mut effects, &destination)
        useDiagnostics(&mut effects, &diagnostics)
      }
      Statement.FailureContext {destination, source, ..} => {
        usePlace(&mut effects, &destination)
        if let Option<Place>.Some {value: from} = &source { usePlace(&mut effects, &from) }
      }
      Statement.SetContextHandle {address, value, ..} => {
        useOperand(&mut effects, &address)
        useOperand(&mut effects, &value)
      }
    }
    at = at + usize.ONE
  }
  match &block.terminator {
    Terminator.Branch {condition, ..} => useOperand(&mut effects, &condition)
    Terminator.Return {..} => useLocal(&mut effects, usize.ZERO)
    Terminator.Call {callee, arguments, providers, diagnostics, destination, failure, ..} => {
      if let Callee.Indirect {address} = &callee { useOperand(&mut effects, &address) }
      if let Callee.NativeIndirect {address, ..} = &callee { useOperand(&mut effects, &address) }
      useOperands(&mut effects, &arguments)
      useOperands(&mut effects, &providers)
      useDiagnostics(&mut effects, &diagnostics)
      writeCall(&mut effects, &destination, callDefs)
      if let Option<FailureEdge>.Some {value: edge} = &failure { writeCall(&mut effects, &edge.destination, callDefs) }
    }
    Terminator.Fail {..} => {
      let failed = failureLocal(function)
      if failed != usize.MAX { useLocal(&mut effects, failed) }
    }
    Terminator.Switch {value, ..} => useOperand(&mut effects, &value)
    Terminator.TrapText {reason, ..} => useOperand(&mut effects, &reason)
    _ => {}
  }
  return move effects
}

effect fn appendAll(sets: &mut List<u64>, values: &[u64]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < values.length {
    run List<u64>.append(&mut sets.*, values[at])
    at = at + usize.ONE
  }
}

// The locals live on entry to each block, `words` words per block.
effect fn liveness(function: &MirView, words: usize, callDefs: bool) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  let blocks = List<Block>.asSlice(&function.body.blocks)
  let mut uses = List<u64>.make()
  let mut defs = List<u64>.make()
  let mut edges = List<List<usize>>.make()
  let mut at = usize.ZERO
  while at < blocks.length {
    let effects = run blockEffects(function, &blocks[at], words, callDefs)
    run appendAll(&mut uses, List<u64>.asSlice(&effects.uses))
    run appendAll(&mut defs, List<u64>.asSlice(&effects.defs))
    run List<List<usize>>.append(&mut edges, run MirDraft.successors(function, at))
    at = at + usize.ONE
  }
  let mut live = run zeros(blocks.length * words)
  let used = List<u64>.asSlice(&uses)
  let written = List<u64>.asSlice(&defs)
  let following = List<List<usize>>.asSlice(&edges)
  let mut changed = true
  while changed {
    changed = false
    let mut block = blocks.length
    while block > usize.ZERO {
      block = block - usize.ONE
      let targets = List<usize>.asSlice(&following[block])
      let mut index = usize.ZERO
      while index < words {
        let mut out: u64 = 0
        let mut edge = usize.ZERO
        while edge < targets.length {
          out = u64.bitOr(out, List<u64>.asSlice(&live)[targets[edge] * words + index])
          edge = edge + usize.ONE
        }
        let at = block * words + index
        let entry = u64.bitOr(used[at], u64.bitAnd(out, u64.bitNot(written[at])))
        let current = List<u64>.asMutSlice(&mut live)
        if current[at] != entry {
          current[at] = entry
          changed = true
        }
        index = index + usize.ONE
      }
    }
  }
  return move live
}

// Whether a store to `place` writes storage of its root local, rather than storage its root
// addresses.
fn writesRoot(place: &Place) -> bool {
  let steps = List<Projection>.asSlice(&place.projections)
  if steps.length == usize.ZERO { return true }
  return match &steps[usize.ZERO] { Projection.Deref => false _ => true }
}

fn markWritten(sets: &mut List<u64>, base: usize, place: &Place) -> () {
  if writesRoot(place) { mark(List<u64>.asMutSlice(&mut sets.*), base, place.local) }
}

// The locals some path has written by the end of each block, `words` words per block: a local no
// path has written holds nothing a resume state needs. The parameters, provider addresses and
// diagnostic addresses hold their values from entry.
effect fn assigned(function: &MirView, words: usize) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  let blocks = List<Block>.asSlice(&function.body.blocks)
  let locals = List<Local>.asSlice(&function.body.locals)
  let mut writes = run zeros(blocks.length * words)
  let mut edges = List<List<usize>>.make()
  let mut block = usize.ZERO
  while block < blocks.length {
    let base = block * words
    let statements = List<Statement>.asSlice(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      match &statements[at] {
        Statement.Assign {destination, ..} => markWritten(&mut writes, base, &destination)
        Statement.FailureContext {destination, ..} => markWritten(&mut writes, base, &destination)
        _ => {}
      }
      at = at + usize.ONE
    }
    if let Terminator.Call {destination, failure, ..} = &blocks[block].terminator {
      markWritten(&mut writes, base, &destination)
      if let Option<FailureEdge>.Some {value: edge} = &failure { markWritten(&mut writes, base, &edge.destination) }
    }
    run List<List<usize>>.append(&mut edges, run MirDraft.successors(function, block))
    block = block + usize.ONE
  }
  let mut entry = run zeros(words)
  let mut local = usize.ZERO
  while local < locals.length {
    let initial = match &locals[local].kind {
      LocalKind.Parameter {..} => true
      LocalKind.Provider {..} => true
      LocalKind.Observer => true
      LocalKind.Cause => true
      LocalKind.Site => true
      _ => false
    }
    if initial { mark(List<u64>.asMutSlice(&mut entry), usize.ZERO, local) }
    local = local + usize.ONE
  }
  // Forward union to a fixed point: a block's entry set gains each predecessor's exit set.
  let mut entries = run zeros(blocks.length * words)
  let mut index = usize.ZERO
  while index < words && blocks.length > usize.ZERO {
    let seeded = List<u64>.asMutSlice(&mut entries)
    seeded[index] = List<u64>.asSlice(&entry)[index]
    index = index + usize.ONE
  }
  let mut exits = run zeros(blocks.length * words)
  let following = List<List<usize>>.asSlice(&edges)
  let mut changed = true
  while changed {
    changed = false
    block = usize.ZERO
    while block < blocks.length {
      index = usize.ZERO
      while index < words {
        let at = block * words + index
        let out = u64.bitOr(List<u64>.asSlice(&entries)[at], List<u64>.asSlice(&writes)[at])
        if List<u64>.asSlice(&exits)[at] != out {
          let leaving = List<u64>.asMutSlice(&mut exits)
          leaving[at] = out
          changed = true
        }
        let targets = List<usize>.asSlice(&following[block])
        let mut edge = usize.ZERO
        while edge < targets.length {
          let to = targets[edge] * words + index
          let merged = u64.bitOr(List<u64>.asSlice(&entries)[to], out)
          if List<u64>.asSlice(&entries)[to] != merged {
            let entering = List<u64>.asMutSlice(&mut entries)
            entering[to] = merged
            changed = true
          }
          edge = edge + usize.ONE
        }
        index = index + usize.ONE
      }
      block = block + usize.ONE
    }
  }
  return move exits
}

// Locals whose address a reference or raw pointer can carry, and the places the callee of a point
// writes after its caller's step returned.
effect fn residentLocals(function: &MirView, points: &[bool], words: usize) -> List<u64>
! OutOfMemoryError ? &mut Allocator {
  let mut resident = run zeros(words)
  let blocks = List<Block>.asSlice(&function.body.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = List<Statement>.asSlice(&blocks[at].statements)
    let mut statementAt = usize.ZERO
    while statementAt < statements.length {
      if let Statement.Assign {value, ..} = &statements[statementAt] {
        match &value {
          Rvalue.Ref {place, ..} => mark(List<u64>.asMutSlice(&mut resident), usize.ZERO, place.local)
          Rvalue.AddressOf {place, ..} => mark(List<u64>.asMutSlice(&mut resident), usize.ZERO, place.local)
          _ => {}
        }
      }
      statementAt = statementAt + usize.ONE
    }
    if points[at] {
      if let Terminator.Call {destination, failure, ..} = &blocks[at].terminator {
        mark(List<u64>.asMutSlice(&mut resident), usize.ZERO, destination.local)
        if let Option<FailureEdge>.Some {value: edge} = &failure {
          mark(List<u64>.asMutSlice(&mut resident), usize.ZERO, edge.destination.local)
        }
      }
    }
    at = at + usize.ONE
  }
  return move resident
}

// Resident locals whose storage can be shared with others whose lives never meet: temporaries and
// named bindings whose address nothing takes. Their lives are
// then exact: a block holds such a local's value only where the local is live on entry or exit,
// or where the block names it, so two of them that no block holds together never need storage at
// the same time. A call writes its destination whole, so its life starts at the call; a local
// that a path other than the call's normal edge still reads keeps its own slot, because that path
// sees the value from before the call.
effect fn shareableLocals(function: &MirView, extents: &[Extent], resident: &[u64], entries: &[u64], words: usize)
-> List<u64> ! OutOfMemoryError ? &mut Allocator {
  let mut shareable = run zeros(words)
  let locals = List<Local>.asSlice(&function.body.locals)
  let mut local = usize.ZERO
  while local < extents.length && local < locals.length {
    let kind = match &locals[local].kind {
      LocalKind.Temp => true
      LocalKind.User {..} => true
      _ => false
    }
    if kind && isSet(resident, usize.ZERO, local) && extents[local].size > usize.ZERO {
      mark(List<u64>.asMutSlice(&mut shareable), usize.ZERO, local)
    }
    local = local + usize.ONE
  }
  let blocks = List<Block>.asSlice(&function.body.blocks)
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = List<Statement>.asSlice(&blocks[block].statements)
    let mut statementAt = usize.ZERO
    while statementAt < statements.length {
      if let Statement.Assign {value, ..} = &statements[statementAt] {
        match &value {
          Rvalue.Ref {place, ..} => clear(List<u64>.asMutSlice(&mut shareable), place.local)
          Rvalue.AddressOf {place, ..} => clear(List<u64>.asMutSlice(&mut shareable), place.local)
          _ => {}
        }
      }
      statementAt = statementAt + usize.ONE
    }
    if let Terminator.Call {destination, normal, failure, ..} = &blocks[block].terminator {
      let targets = run MirDraft.successors(function, block)
      let listed = List<usize>.asSlice(&targets)
      let mut failedTarget = usize.MAX
      if let Option<FailureEdge>.Some {value: failed} = &failure {
        failedTarget = failed.target
        run keepWritten(&mut shareable, &failed.destination, failed.target, normal, listed, entries, words)
      }
      run keepWritten(&mut shareable, &destination, normal, failedTarget, listed, entries, words)
    }
    block = block + usize.ONE
  }
  return move shareable
}

// A call writes `destination` only on the edge to `written`. Any other successor that reads it
// would see its value from before the call, so it then keeps its own slot; so does a destination
// whose edge shares its target with the call's other edge (`other`).
effect fn keepWritten(shareable: &mut List<u64>, destination: &Place, written: usize, other: usize,
  targets: &[usize], entries: &[u64], words: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if List<Projection>.length(&destination.projections) != usize.ZERO { return () }
  if written == other {
    clear(List<u64>.asMutSlice(&mut shareable.*), destination.local)
    return ()
  }
  let mut edge = usize.ZERO
  while edge < targets.length {
    if targets[edge] != written && isSet(entries, targets[edge] * words, destination.local) {
      clear(List<u64>.asMutSlice(&mut shareable.*), destination.local)
    }
    edge = edge + usize.ONE
  }
  return ()
}

fn clear(sets: &mut [u64], local: usize) -> () {
  let at = bitWord(local)
  sets[at] = u64.bitAnd(sets[at], u64.bitNot(bitMask(local)))
}

// One local or context companion to place in the shared region.
struct Item {
  local: usize,
  size: usize,
  alignment: usize,
  companion: bool,
}

impl Copy for Item {}

// Places the shareable locals from `start`, with the context companions they own, the widest
// first, each at the lowest offset that overlaps no placed item held in a common block. A
// companion lives as long as its owner. Returns the end of the shared region.
effect fn packShared(function: &MirView, extents: &[Extent], shareable: &[u64], entries: &[u64], companions: &[usize],
  word: usize, words: usize, start: usize, slots: &mut List<FrameSlot>, companionSlots: &mut List<FrameSlot>) -> usize
! OutOfMemoryError ? &mut Allocator {
  let mut order = List<Item>.make()
  let mut local = usize.ZERO
  while local < extents.length {
    if isSet(shareable, usize.ZERO, local) {
      let mut aligned = extents[local].alignment
      if aligned == usize.ZERO { aligned = usize.ONE }
      run List<Item>.append(&mut order, Item {local: local, size: extents[local].size, alignment: aligned, companion: false})
    }
    local = local + usize.ONE
  }
  let mut companionAt = usize.ZERO
  while companionAt < companions.length {
    if isSet(shareable, usize.ZERO, companions[companionAt]) {
      run List<Item>.append(&mut order, Item {local: companions[companionAt], size: word * 5, alignment: word, companion: true})
    }
    companionAt = companionAt + usize.ONE
  }
  let count = List<Item>.length(&order)
  if count == usize.ZERO { return start }
  // Widest first; ties keep their order, so the layout is deterministic.
  let sorted = List<Item>.asMutSlice(&mut order)
  let mut at = usize.ONE
  while at < count {
    let value = sorted[at]
    let mut hole = at
    while hole > usize.ZERO && sorted[hole - usize.ONE].size < value.size {
      sorted[hole] = sorted[hole - usize.ONE]
      hole = hole - usize.ONE
    }
    sorted[hole] = value
    at = at + usize.ONE
  }
  // The blocks that hold each item: live on entry or exit, or named there.
  let blocks = List<Block>.asSlice(&function.body.blocks)
  let blockWords = blocks.length / 64 + usize.ONE
  let mut named = List<u64>.make()
  let mut block = usize.ZERO
  while block < blocks.length {
    let effects = run blockEffects(function, &blocks[block], words, false)
    let mut index = usize.ZERO
    while index < words {
      run List<u64>.append(&mut named, u64.bitOr(List<u64>.asSlice(&effects.uses)[index], List<u64>.asSlice(&effects.defs)[index]))
      index = index + usize.ONE
    }
    block = block + usize.ONE
  }
  let mut held = run zeros(count * blockWords)
  block = usize.ZERO
  while block < blocks.length {
    let targets = run MirDraft.successors(function, block)
    let listed = List<usize>.asSlice(&targets)
    let mut position = usize.ZERO
    while position < count {
      let owner = List<Item>.asSlice(&order)[position].local
      let mut holds = isSet(entries, block * words, owner) || isSet(List<u64>.asSlice(&named), block * words, owner)
      let mut edge = usize.ZERO
      while !holds && edge < listed.length {
        holds = isSet(entries, listed[edge] * words, owner)
        edge = edge + usize.ONE
      }
      if holds { mark(List<u64>.asMutSlice(&mut held), position * blockWords, block) }
      position = position + usize.ONE
    }
    block = block + usize.ONE
  }
  let mut placed = List<FrameSlot>.make()
  let mut end = start
  let mut position = usize.ZERO
  while position < count {
    let item = List<Item>.asSlice(&order)[position]
    let mut offset = alignUp(start, item.alignment)
    let mut moved = true
    while moved {
      moved = false
      let slotsSoFar = List<FrameSlot>.asSlice(&placed)
      let mut other = usize.ZERO
      while other < slotsSoFar.length {
        let slot = slotsSoFar[other]
        if offset < slot.offset + slot.size && slot.offset < offset + item.size && meets(List<u64>.asSlice(&held), position, other, blockWords) {
          offset = alignUp(slot.offset + slot.size, item.alignment)
          moved = true
        }
        other = other + usize.ONE
      }
    }
    let slot = FrameSlot {local: item.local, offset: offset, size: item.size}
    run List<FrameSlot>.append(&mut placed, slot)
    if item.companion {
      run List<FrameSlot>.append(&mut companionSlots.*, slot)
    } else {
      run List<FrameSlot>.append(&mut slots.*, slot)
    }
    if offset + item.size > end { end = offset + item.size }
    position = position + usize.ONE
  }
  return end
}

// Whether the locals at positions `left` and `right` of the packing order share a block.
fn meets(held: &[u64], left: usize, right: usize, blockWords: usize) -> bool {
  let mut index = usize.ZERO
  while index < blockWords {
    if u64.bitAnd(held[left * blockWords + index], held[right * blockWords + index]) != 0 { return true }
    index = index + usize.ONE
  }
  return false
}

// A drop flag live after a suspension point decides which owners its resume and cancel exits
// drop (SUSP-011, SUSP-013), so it must be resident or saved in the point's state. One without
// storage would drop an owner twice or never: that is a compiler bug, never a user diagnostic,
// so it aborts here before any code is emitted.
effect fn requireFlagStorage(function: &MirView, extents: &[Extent], live: &[u64], resident: &[u64]) -> ()
! OutOfMemoryError ? &mut Allocator {
  let locals = List<Local>.asSlice(&function.body.locals)
  let mut local = usize.ZERO
  while local < extents.length && local < locals.length {
    let flag = match &locals[local].kind {
      LocalKind.DropFlag {..} => true
      _ => false
    }
    if flag && isSet(live, usize.ZERO, local) && !isSet(resident, usize.ZERO, local) && extents[local].size == usize.ZERO {
      let mut reason = run Bytes.copy(b"SuspensionOwnership: drop flag local ")
      run appendNumber(&mut reason, usize.toU64(local))
      run Bytes.append(&mut reason, b" of instance ")
      run appendNumber(&mut reason, InstanceKey.runtimeHash(function.key))
      run Bytes.append(&mut reason, b" has no frame storage at a suspension point")
      return CompilerBug.panic(Bytes.asSlice(&reason))
    }
    local = local + usize.ONE
  }
  return ()
}

effect fn appendNumber(target: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 { run appendNumber(&mut target.*, u64.divide(value, 10)) }
  let digit = [u64.toU8(48 + u64.remainder(value, 10))]
  return run Bytes.append(&mut target.*, &digit)
}

/// The first block whose terminator suspends (`suspending`) without a cancel exit in `cancels`,
/// or `usize.MAX`. A frame dropped while suspended there would abandon its owners. Only a call a
/// cancel landing runs to completion through an ordinary driver may lack one; a landing never
/// relinquishes.
pub effect fn unexitedPoint(function: &MirView, cancels: &[Cancel], suspending: &[bool]) -> usize
! OutOfMemoryError ? &mut Allocator {
  let blocks = List<Block>.asSlice(&function.body.blocks)
  let mut landing = run List<bool>.makeWithCapacity(blocks.length)
  let mut at = usize.ZERO
  while at < blocks.length {
    run List<bool>.append(&mut landing, false)
    at = at + usize.ONE
  }
  let mut pending = run List<usize>.makeWithCapacity(cancels.length)
  at = usize.ZERO
  while at < cancels.length {
    run List<usize>.append(&mut pending, cancels[at].entry)
    at = at + usize.ONE
  }
  while List<usize>.length(&pending) != usize.ZERO {
    let block = List<usize>.asSlice(&pending)[List<usize>.length(&pending) - usize.ONE]
    drop List<usize>.pop(&mut pending)
    if List<bool>.asSlice(&landing)[block] { continue }
    let marks = List<bool>.asMutSlice(&mut landing)
    marks[block] = true
    let next = run MirDraft.successors(function, block)
    run appendAllBlocks(&mut pending, List<usize>.asSlice(&next))
  }
  at = usize.ZERO
  while at < blocks.length && at < suspending.length {
    if suspending[at] && !hasCancel(cancels, at) {
      let relinquishes = match &blocks[at].terminator { Terminator.Relinquish {..} => true _ => false }
      if relinquishes || !List<bool>.asSlice(&landing)[at] { return at }
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

effect fn appendAllBlocks(target: &mut List<usize>, values: &[usize]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < values.length {
    run List<usize>.append(&mut target.*, values[at])
    at = at + usize.ONE
  }
}

fn hasCancel(cancels: &[Cancel], block: usize) -> bool {
  let mut at = usize.ZERO
  while at < cancels.length {
    if cancels[at].point == block { return true }
    at = at + usize.ONE
  }
  return false
}

/// The first drop flag set in `live`, one bit per local, or `usize.MAX`. A flag live on entry to
/// a body is read before any edge writes it, so its resume and cancel exits would decide cleanup
/// from undefined storage.
pub fn liveFlag(locals: &[Local], live: &[u64]) -> usize {
  let mut local = usize.ZERO
  while local < locals.length && bitWord(local) < live.length {
    let flag = match &locals[local].kind { LocalKind.DropFlag {..} => true _ => false }
    if flag && isSet(live, usize.ZERO, local) { return local }
    local = local + usize.ONE
  }
  return usize.MAX
}

/// The locals live on entry to `function`'s first block, one bit per local.
pub effect fn entryLive(function: &MirView) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  let words = List<Local>.length(&function.body.locals) / 64 + usize.ONE
  let live = run liveness(function, words, false)
  let mut entry = List<u64>.make()
  let listed = List<u64>.asSlice(&live)
  let mut at = usize.ZERO
  while at < words && at < listed.length {
    run List<u64>.append(&mut entry, listed[at])
    at = at + usize.ONE
  }
  return move entry
}

/// Aborts when a suspension point of `function` has no cancel exit (see [`unexitedPoint`]).
pub effect fn requireCancelExits(function: &MirView, suspending: &[bool]) -> () ! OutOfMemoryError ? &mut Allocator {
  let unexited = run unexitedPoint(function, List<Cancel>.asSlice(&function.body.cancels), suspending)
  if unexited != usize.MAX {
    return run panicAt(b"SuspensionOwnership: suspension point block ", function, unexited, b" has no cancel exit")
  }
  return ()
}

effect fn panicAt(prefix: &[u8], function: &MirView, index: usize, suffix: &[u8]) -> never
! OutOfMemoryError ? &mut Allocator {
  let mut reason = run Bytes.copy(prefix)
  run appendNumber(&mut reason, usize.toU64(index))
  run Bytes.append(&mut reason, b" of instance ")
  run appendNumber(&mut reason, InstanceKey.runtimeHash(function.key))
  run Bytes.append(&mut reason, suffix)
  return CompilerBug.panic(Bytes.asSlice(&reason))
}

// The locals the point ending `block` saves: live on entry to a successor and written on some
// path to the point. A local no path has written yet holds nothing to restore.
effect fn savedAfter(function: &MirView, block: usize, entries: &[u64], exits: &[u64], words: usize) -> List<u64>
! OutOfMemoryError ? &mut Allocator {
  let mut after = run zeros(words)
  let targets = run MirDraft.successors(function, block)
  let listed = List<usize>.asSlice(&targets)
  let merged = List<u64>.asMutSlice(&mut after)
  let mut target = usize.ZERO
  while target < listed.length {
    let mut index = usize.ZERO
    while index < words {
      merged[index] = u64.bitOr(merged[index], entries[listed[target] * words + index])
      index = index + usize.ONE
    }
    target = target + usize.ONE
  }
  let mut index = usize.ZERO
  while index < words {
    merged[index] = u64.bitAnd(merged[index], exits[block * words + index])
    index = index + usize.ONE
  }
  return move after
}

// Packs the saved locals of one state from `base`; returns the state and its end offset.
struct Packed {
  state: State,
  end: usize,
}

effect fn pack(extents: &[Extent], live: &[u64], resident: &[u64], base: usize) -> Packed
! OutOfMemoryError ? &mut Allocator {
  let mut slots = List<FrameSlot>.make()
  let mut offset = base
  let mut local = usize.ZERO
  while local < extents.length {
    if isSet(live, usize.ZERO, local) && !isSet(resident, usize.ZERO, local) && extents[local].size > usize.ZERO {
      offset = alignUp(offset, extents[local].alignment)
      run List<FrameSlot>.append(&mut slots, FrameSlot {local: local, offset: offset, size: extents[local].size})
      offset = offset + extents[local].size
    }
    local = local + usize.ONE
  }
  return Packed {state: State {slots: move slots}, end: offset}
}

impl Coroutine {
  /// The frame header: its parent frame at offset 0, its step function and resume state, then the
  /// caller's result, failure and context addresses, the observer, cause and entry site, whether
  /// the frame was carved inline, and one address per provider.
  pub fn resumeOffset(word: usize) -> usize { return word }
  pub fn stateOffset(word: usize) -> usize { return word * 2 }
  pub fn outOffset(word: usize) -> usize { return word * 3 }
  pub fn failOffset(word: usize) -> usize { return word * 4 }
  pub fn contextOffset(word: usize) -> usize { return word * 5 }
  pub fn observerOffset(word: usize) -> usize { return word * 6 }
  pub fn causeOffset(word: usize) -> usize { return word * 7 }
  pub fn siteOffset(word: usize) -> usize { return word * 8 }
  /// Whether the frame was carved from its storage state's window, which its release restores, or
  /// was acquired from the state: non-null for a carved frame.
  pub fn carvedOffset(word: usize) -> usize { return word * 9 }
  pub fn providerOffset(word: usize, index: usize) -> usize { return word * (10 + index) }

  /// The four-word transfer record: the lazily created storage state at offset 0, the top frame,
  /// whether the frame that completed last failed, and the execution package that owns the record,
  /// null for a record on a driver's stack. A package's record begins its header.
  pub fn transferTop(word: usize) -> usize { return word }
  pub fn transferFailed(word: usize) -> usize { return word * 2 }
  pub fn transferPackage(word: usize) -> usize { return word * 3 }
  /// A package's header continues its transfer record with its activation word.
  pub fn packageActivation(word: usize) -> usize { return word * 4 }

  /// Plans the frame of `function`. `extents` sizes each local, `points` marks each block whose
  /// terminator is a suspension point, and `companions` lists the failure slots that own a context
  /// companion of five words.
  pub effect fn plan(function: &MirView, extents: &[Extent], points: &[bool], providers: usize,
    companions: &[usize], word: usize) -> Coroutine ! OutOfMemoryError ? &mut Allocator {
    let count = extents.length
    let words = count / 64 + usize.ONE
    let mut resident = run residentLocals(function, points, words)
    let live = run liveness(function, words, false)
    let entries = List<u64>.asSlice(&live)
    let written = run assigned(function, words)
    let exits = List<u64>.asSlice(&written)
    let blocks = List<Block>.asSlice(&function.body.blocks)
    // A saved local wider than two words lives in the frame instead: it already lives in memory,
    // so a save and a restore at every point would only copy it twice.
    let mut block = usize.ZERO
    while block < blocks.length {
      if points[block] {
        let after = run savedAfter(function, block, entries, exits, words)
        let mut local = usize.ZERO
        while local < count {
          if isSet(List<u64>.asSlice(&after), usize.ZERO, local) && extents[local].size > word * 2 {
            mark(List<u64>.asMutSlice(&mut resident), usize.ZERO, local)
          }
          local = local + usize.ONE
        }
      }
      block = block + usize.ONE
    }
    // So does a parameter wider than two words: `$enter` already writes it into the frame, and a
    // restore into the step's own stack would only copy it again before the body reads it, often
    // to move it on into a callee's frame.
    let parameterCount = List<Interned<Type>>.length(&function.body.parameters)
    let mut parameter = usize.ONE
    while parameter <= parameterCount && parameter < count {
      if extents[parameter].size > word * 2 {
        mark(List<u64>.asMutSlice(&mut resident), usize.ZERO, parameter)
      }
      parameter = parameter + usize.ONE
    }
    let resided = List<u64>.asSlice(&resident)
    // Lives in which a call writes its destination, for the locals that can share storage.
    let exact = run liveness(function, words, true)
    let shareable = run shareableLocals(function, extents, resided, List<u64>.asSlice(&exact), words)
    let mut alignment = word
    let mut offset = Coroutine.providerOffset(word, providers)
    let mut residentSlots = List<FrameSlot>.make()
    let mut local = usize.ZERO
    while local < count {
      if isSet(resided, usize.ZERO, local) && !isSet(List<u64>.asSlice(&shareable), usize.ZERO, local) {
        let mut size = extents[local].size
        if size == usize.ZERO { size = usize.ONE }
        let mut aligned = extents[local].alignment
        if aligned == usize.ZERO { aligned = usize.ONE }
        if aligned > alignment { alignment = aligned }
        offset = alignUp(offset, aligned)
        run List<FrameSlot>.append(&mut residentSlots, FrameSlot {local: local, offset: offset, size: size})
        offset = offset + size
      }
      local = local + usize.ONE
    }
    let mut companionSlots = List<FrameSlot>.make()
    let mut companionAt = usize.ZERO
    while companionAt < companions.length {
      if isSet(List<u64>.asSlice(&shareable), usize.ZERO, companions[companionAt]) {
        companionAt = companionAt + usize.ONE
        continue
      }
      offset = alignUp(offset, word)
      let size = word * 5
      run List<FrameSlot>.append(&mut companionSlots, FrameSlot {local: companions[companionAt], offset: offset, size: size})
      offset = offset + size
      companionAt = companionAt + usize.ONE
    }
    offset = run packShared(function, extents, List<u64>.asSlice(&shareable), List<u64>.asSlice(&exact), companions, word, words, offset, &mut residentSlots,
      &mut companionSlots)
    local = usize.ZERO
    while local < count {
      if isSet(List<u64>.asSlice(&shareable), usize.ZERO, local) && extents[local].alignment > alignment {
        alignment = extents[local].alignment
      }
      local = local + usize.ONE
    }
    let base = offset
    let mut end = base
    let mut states = List<State>.make()
    let mut parameterSet = run zeros(words)
    local = usize.ONE
    while local <= parameterCount {
      mark(List<u64>.asMutSlice(&mut parameterSet), usize.ZERO, local)
      local = local + usize.ONE
    }
    let start = run pack(extents, List<u64>.asSlice(&parameterSet), resided, base)
    let Packed {state: initial, end: initialEnd} = move start
    if initialEnd > end { end = initialEnd }
    run List<State>.append(&mut states, move initial)
    let unassigned = liveFlag(List<Local>.asSlice(&function.body.locals), entries)
    if unassigned != usize.MAX {
      return run panicAt(b"SuspensionOwnership: drop flag local ", function, unassigned, b" is read before it is assigned")
    }
    let mut pointBlocks = List<usize>.make()
    block = usize.ZERO
    while block < blocks.length {
      if points[block] {
        let after = run savedAfter(function, block, entries, exits, words)
        run requireFlagStorage(function, extents, List<u64>.asSlice(&after), resided)
        let resumed = run pack(extents, List<u64>.asSlice(&after), resided, base)
        let Packed {state: saved, end: savedEnd} = move resumed
        if savedEnd > end { end = savedEnd }
        run List<State>.append(&mut states, move saved)
        run List<usize>.append(&mut pointBlocks, block)
      }
      block = block + usize.ONE
    }
    local = usize.ZERO
    while local < count {
      if extents[local].alignment > alignment { alignment = extents[local].alignment }
      local = local + usize.ONE
    }
    return Coroutine {
      size: alignUp(end, alignment),
      alignment: alignment,
      resident: move residentSlots,
      companions: move companionSlots,
      states: move states,
      points: move pointBlocks,
    }
  }

  /// The frame offset of a resident local or companion owner, if any.
  pub fn residentAt(self: &Self, local: usize) -> usize {
    return slotAt(List<FrameSlot>.asSlice(&self.resident), local)
  }

  pub fn companionAt(self: &Self, local: usize) -> usize {
    return slotAt(List<FrameSlot>.asSlice(&self.companions), local)
  }

  /// Where `$enter` stores parameter `local`: its resident slot, or its slot in state 0.
  pub fn parameterAt(self: &Self, local: usize) -> usize {
    let resident = Coroutine.residentAt(self, local)
    if resident != usize.MAX { return resident }
    let states = List<State>.asSlice(&self.states)
    return slotAt(List<FrameSlot>.asSlice(&states[usize.ZERO].slots), local)
  }

  /// The cancel exit of the point ending `block`, or `usize.MAX` when it has none.
  pub fn cancelAfter(function: &MirView, block: usize) -> usize {
    let cancels = List<Cancel>.asSlice(&function.body.cancels)
    let mut at = usize.ZERO
    while at < cancels.length {
      if cancels[at].point == block { return cancels[at].entry }
      at = at + usize.ONE
    }
    return usize.MAX
  }

  /// The resume state that follows the point ending `block`, or `usize.MAX` for another block.
  pub fn stateAfter(self: &Self, block: usize) -> usize {
    let listed = List<usize>.asSlice(&self.points)
    let mut at = usize.ZERO
    while at < listed.length {
      if listed[at] == block { return at + usize.ONE }
      at = at + usize.ONE
    }
    return usize.MAX
  }
}

fn slotAt(slots: &[FrameSlot], local: usize) -> usize {
  let mut at = usize.ZERO
  while at < slots.length {
    if slots[at].local == local { return slots[at].offset }
    at = at + usize.ONE
  }
  return usize.MAX
}
