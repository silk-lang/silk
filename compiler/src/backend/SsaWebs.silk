//! Parameter webs of one finished SSA function: the block parameters that can share one storage
//! location, so an emitter copies nothing where one is passed on as another.
//!
//! # When to use
//! Call [`of`] before emitting a function whose block parameters each get a location, such as a
//! wasm local. Give every parameter of a web its leader's location and skip the copy when an edge
//! passes one for another.
//!
//! # Details
//! A value that stays the same across a join is passed along as the next block's parameter, and
//! in a long loop one value can pass through many joins each time round. Two parameters may share
//! a location when neither is live where the other is defined, which for parameters is the entry
//! of the other's block (Budimlić et al.: two SSA values interfere exactly when one is live at
//! the other's definition). Parameters of one block are defined together and never share.
//!
//! The pass looks only at parameters an edge passes for a parameter of the same kind. It marks
//! the blocks each is live into by walking up from its uses, an edge's argument being a use at
//! the end of the edge's block, and joins two webs when no member of one interferes with a member
//! of the other. A web holds at most [`webLimit`] parameters, and a function whose liveness would
//! take more than a fixed amount of memory gets no webs. Edges are visited in reverse postorder,
//! so the webs depend only on the function.
//!
//! A location is written only where an edge assigns a parameter of its web. An emitter must read
//! every argument of an edge before it writes any parameter, as a parallel copy does.

import backend.SsaFunction {Definition, Edge, Exit, SsaFunction, none}
import backend.SsaGraph {SsaGraph}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.u64
import silk.num.usize

/// The most parameters one web holds.
pub fn webLimit() -> usize { return 16 }

// The most 64-bit words of liveness a function may take.
fn budget() -> usize { return 2097152 }

// Whether `value` is a block parameter a web can hold: a scalar of at most 64 bits.
fn held(function: &SsaFunction, value: u64) -> bool {
  if value == none() || function.value(value).definition != Definition.Parameter { return false }
  let kind = function.kindOf(value)
  return !kind.isVector() && !kind.isUnit() && kind.bits <= 64
}

// Gives `value` the next ordinal unless it has one.
effect fn note(ordinals: &mut List<usize>, values: &mut List<u64>, value: u64) -> usize ! OutOfMemoryError ? &mut Allocator {
  let known = List<usize>.get(&ordinals.*, u64.toUsize(value))
  if known != usize.MAX { return known }
  let ordinal = List<u64>.length(&values.*)
  run List<u64>.append(&mut values.*, value)
  List<usize>.set(&mut ordinals.*, u64.toUsize(value), ordinal)
  return ordinal
}

// Marks the parameter of ordinal `ordinal`, defined at the entry of `home`, live into `block` and
// into every block a path leads from to it without passing `home`'s entry.
effect fn markLive(graph: &SsaGraph, live: &mut List<u64>, words: usize, ordinal: usize, home: usize, block: usize, work: &mut List<usize>) -> ()
! OutOfMemoryError ? &mut Allocator {
  run List<usize>.append(&mut work.*, block)
  while let Option<usize>.Some {value: next} = List<usize>.pop(&mut work.*) {
    if next == home { continue }
    let at = ordinal * words + next / 64
    let bit = u64.shiftLeft(1, usize.toU64(next % 64))
    let word = List<u64>.get(&live.*, at)
    if u64.bitAnd(word, bit) != 0 { continue }
    List<u64>.set(&mut live.*, at, u64.bitOr(word, bit))
    let incoming = graph.predecessorsOf(next)
    let mut each = usize.ZERO
    while each < incoming.length {
      run List<usize>.append(&mut work.*, incoming[each])
      each = each + usize.ONE
    }
  }
  return ()
}

fn liveInto(live: &List<u64>, words: usize, ordinal: usize, block: usize) -> bool {
  let word = List<u64>.get(live, ordinal * words + block / 64)
  return u64.bitAnd(word, u64.shiftLeft(1, usize.toU64(block % 64))) != 0
}

// The web `ordinal` belongs to: the end of its chain of leaders.
fn leaderOf(leaders: &List<usize>, ordinal: usize) -> usize {
  let mut at = ordinal
  while List<usize>.get(leaders, at) != at { at = List<usize>.get(leaders, at) }
  return at
}

/// For each value of `function`, the block parameter whose location it shares, a web's first
/// parameter standing for itself, or `none()` for a value in no web. `graph` is the function's.
pub effect fn of(function: &SsaFunction, graph: &SsaGraph) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  let valueCount = function.valueCount()
  let mut shared = run List<u64>.makeWithCapacity(valueCount)
  run List<u64>.appendRepeated(&mut shared, none(), valueCount)
  // The parameters an edge passes for a parameter, and each such pair, in reverse postorder.
  let mut ordinals = run List<usize>.makeWithCapacity(valueCount)
  run List<usize>.appendRepeated(&mut ordinals, usize.MAX, valueCount)
  let mut values = List<u64>.make()
  let mut pairs = List<usize>.make()
  let sequence = graph.reversePostorder()
  let mut step = usize.ZERO
  while step < sequence.length {
    let edges = List<Edge>.asSlice(&function.block(sequence[step]).edges)
    let mut edge = usize.ZERO
    while edge < edges.length {
      let arguments = List<u64>.asSlice(&edges[edge].arguments)
      let parameters = List<u64>.asSlice(&function.block(edges[edge].block).parameters)
      let mut at = usize.ZERO
      while at < arguments.length {
        if arguments[at] != parameters[at] && held(function, arguments[at]) && held(function, parameters[at])
          && function.kindOf(arguments[at]).equals(function.kindOf(parameters[at])) {
          let from = run note(&mut ordinals, &mut values, arguments[at])
          let into = run note(&mut ordinals, &mut values, parameters[at])
          run List<usize>.append(&mut pairs, from)
          run List<usize>.append(&mut pairs, into)
        }
        at = at + usize.ONE
      }
      edge = edge + usize.ONE
    }
    step = step + usize.ONE
  }
  let count = List<u64>.length(&values)
  let blocks = function.blockCount()
  let words = (blocks + 63) / 64
  if count == usize.ZERO || count * words > budget() { return move shared }
  // Where each is live, from its uses: an instruction's operand, an exit's value, and an edge's
  // argument at the end of the edge's block.
  let mut live = run List<u64>.makeWithCapacity(count * words)
  run List<u64>.appendRepeated(&mut live, 0, count * words)
  let mut work = List<usize>.make()
  step = usize.ZERO
  while step < sequence.length {
    let block = sequence[step]
    let found = function.block(block)
    let listed = List<usize>.asSlice(&found.instructions)
    let mut at = usize.ZERO
    while at < listed.length {
      let operands = function.operandsOf(listed[at])
      let mut operand = usize.ZERO
      while operand < operands.length {
        if operands[operand] != none() {
          let ordinal = List<usize>.get(&ordinals, u64.toUsize(operands[operand]))
          if ordinal != usize.MAX { run markLive(graph, &mut live, words, ordinal, function.value(operands[operand]).owner, block, &mut work) }
        }
        operand = operand + usize.ONE
      }
      at = at + usize.ONE
    }
    if found.value != none() && (found.exit == Exit.Branch || found.exit == Exit.Switch || found.exit == Exit.Return) {
      let ordinal = List<usize>.get(&ordinals, u64.toUsize(found.value))
      if ordinal != usize.MAX { run markLive(graph, &mut live, words, ordinal, function.value(found.value).owner, block, &mut work) }
    }
    if found.secondValue != none() && found.exit == Exit.Return {
      let ordinal = List<usize>.get(&ordinals, u64.toUsize(found.secondValue))
      if ordinal != usize.MAX { run markLive(graph, &mut live, words, ordinal, function.value(found.secondValue).owner, block, &mut work) }
    }
    let edges = List<Edge>.asSlice(&found.edges)
    let mut edge = usize.ZERO
    while edge < edges.length {
      let arguments = List<u64>.asSlice(&edges[edge].arguments)
      at = usize.ZERO
      while at < arguments.length {
        if arguments[at] != none() {
          let ordinal = List<usize>.get(&ordinals, u64.toUsize(arguments[at]))
          if ordinal != usize.MAX { run markLive(graph, &mut live, words, ordinal, function.value(arguments[at]).owner, block, &mut work) }
        }
        at = at + usize.ONE
      }
      edge = edge + usize.ONE
    }
    step = step + usize.ONE
  }
  // Webs: each parameter starts alone, and a pair's webs join when no two members interfere.
  let mut leaders = run List<usize>.makeWithCapacity(count)
  let mut members = run List<List<usize>>.makeWithCapacity(count)
  let mut ordinal = usize.ZERO
  while ordinal < count {
    run List<usize>.append(&mut leaders, ordinal)
    let mut alone = List<usize>.make()
    run List<usize>.append(&mut alone, ordinal)
    run List<List<usize>>.append(&mut members, move alone)
    ordinal = ordinal + usize.ONE
  }
  let paired = List<usize>.asSlice(&pairs)
  let mut pair = usize.ZERO
  while pair + usize.ONE < paired.length {
    let mut first = leaderOf(&leaders, paired[pair])
    let mut second = leaderOf(&leaders, paired[pair + usize.ONE])
    pair = pair + 2
    if first == second { continue }
    // The web that started first leads.
    if second < first {
      let swapped = first
      first = second
      second = swapped
    }
    let ours = List<usize>.asSlice(&List<List<usize>>.asSlice(&members)[first])
    let theirs = List<usize>.asSlice(&List<List<usize>>.asSlice(&members)[second])
    if ours.length + theirs.length > webLimit() { continue }
    let mut apart = true
    let mut mine = usize.ZERO
    while mine < ours.length && apart {
      let home = function.value(List<u64>.get(&values, ours[mine])).owner
      let mut other = usize.ZERO
      while other < theirs.length && apart {
        let away = function.value(List<u64>.get(&values, theirs[other])).owner
        if home == away || liveInto(&live, words, ours[mine], away) || liveInto(&live, words, theirs[other], home) { apart = false }
        other = other + usize.ONE
      }
      mine = mine + usize.ONE
    }
    if !apart { continue }
    let mut moved = List<usize>.make()
    run List<usize>.appendSlice(&mut moved, theirs)
    let joining = List<usize>.asSlice(&moved)
    let mut each = usize.ZERO
    while each < joining.length {
      run List<usize>.append(&mut List<List<usize>>.asMutSlice(&mut members)[first], joining[each])
      each = each + usize.ONE
    }
    List<usize>.set(&mut leaders, second, first)
  }
  ordinal = usize.ZERO
  while ordinal < count {
    let leader = leaderOf(&leaders, ordinal)
    if List<usize>.length(&List<List<usize>>.asSlice(&members)[leader]) > usize.ONE {
      List<u64>.set(&mut shared, u64.toUsize(List<u64>.get(&values, ordinal)), List<u64>.get(&values, leader))
    }
    ordinal = ordinal + usize.ONE
  }
  return move shared
}
