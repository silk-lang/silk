//! Dominator-based value numbering of one SSA function: folding, common subexpressions, and the
//! checks an earlier branch already decided.
//!
//! # When to use
//! Run [`number`] in an optimized build after promotion and after each pass that exposes new
//! equalities, such as forwarding loads. It leaves branches on constants for the control flow
//! pass to fold.
//!
//! # Details
//! A walk of the dominator tree in preorder visits each instruction once, with its operands
//! already replaced by the values they equal:
//!
//! - `SsaFolding.simplify` folds it or rewrites it into a simpler instruction.
//! - A pure instruction (no side effect, no state read: `Operation.isPure`) equal to one in a
//!   dominating position, by operation, immediates, kind and operands, is replaced by it. A pure
//!   division can trap, but an equal one already ran without trapping, so the later one cannot
//!   trap either. Loads, calls and every other instruction that reads or changes state are never
//!   merged here; `SsaMemory` forwards loads.
//! - Commutative integer operations and integer comparisons put their operands in value order
//!   first, a comparison swapping its predicate, so `a < b` and `b > a` are one value.
//! - A block whose only predecessor ends in a branch knows the branch's condition: true along the
//!   first edge, false along the second, everywhere the block dominates; a condition that is
//!   another flag negated makes that flag known too. A switch case's block
//!   knows the switch value equals the case. The known value replaces each use there, and when
//!   the condition is an integer comparison, another comparison of the same operands that it
//!   implies or refutes folds too (`i < n` decides a later `i >= n`), and so does the test that
//!   an unsigned `i + 1` wrapped, which `i < n` refutes. An unsigned comparison also folds when
//!   the ranges of its operands decide it: a range comes from the operation (a mask, a narrower
//!   source, a shift, a remainder, a constant added or subtracted without wrapping) and from the
//!   known comparisons of the value with constants, so `i < 256` decides a later `i < 258`, and
//!   the range check of a conversion of `x & 255` to a byte never fails. A signed comparison
//!   folds the same way from signed ranges, so below `v < 0` the overflow checks of `-(v + 1)`
//!   are decided. So a check dominated by an
//!   identical check that passed is decided, and its trap path becomes unreachable once the
//!   control flow pass folds the branch.
//!
//! A replaced instruction is removed; nothing is moved. Numbering is the function's own: the
//! walk's order, and so every constant it makes, depends only on the function.

import backend.SsaFolding
import backend.SsaFolding {isIntegerPredicate}
import backend.SsaFunction {
  Binary,
  Cast,
  Edge,
  Exit,
  Operation,
  Predicate,
  SsaFunction,
  masked,
  none,
}
import backend.SsaGraph {SsaGraph}
import backend.SsaInduction
import backend.SsaInduction {Counter, incrementOf}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.i64
import silk.num.u64
import silk.num.usize

// One entry of the table of available instructions: the instruction, the bucket it hangs in, and
// the entry below it in that bucket.
struct Entry {
  instruction: usize,
  bucket: usize,
  next: usize,
}

impl Copy for Entry {}

// A comparison known to hold or not where the walk stands.
struct Fact {
  predicate: Predicate,
  left: u64,
  right: u64,
  truth: bool,
}

impl Copy for Fact {}

// A value known to equal another where the walk stands, and what it was known as before.
struct Known {
  value: u64,
  previous: u64,
}

impl Copy for Known {}

// How many of the newest facts a comparison is checked against.
fn factWindow() -> usize { return 64 }

struct Numbering {
  // The value each value was replaced by for good, by value, or `none()`.
  substitution: List<u64>,
  // The value each value equals in the blocks the walk is in, by value, or `none()`.
  known: List<u64>,
  knownLog: List<Known>,
  facts: List<Fact>,
  buckets: List<usize>,
  entries: List<Entry>,
  trueFlag: u64,
  falseFlag: u64,
  changed: bool,
}

/// Numbers the values of `function`: folds, merges equal pure instructions and decides the
/// comparisons a dominating branch decided; answers whether it changed anything.
pub effect fn number(function: &mut SsaFunction) -> bool ! OutOfMemoryError ? &mut Allocator {
  let graph = run SsaGraph.of(&function.*)
  let mut size: usize = 16
  while size < function.instructionCount() * 2 { size = size * 2 }
  let mut state = Numbering {substitution: List<u64>.make(), known: List<u64>.make(), knownLog: List<Known>.make(), facts: List<Fact>.make(),
    buckets: List<usize>.make(), entries: List<Entry>.make(), trueFlag: none(), falseFlag: none(), changed: false}
  run List<usize>.appendRepeated(&mut state.buckets, usize.MAX, size)
  run List<u64>.appendRepeated(&mut state.substitution, none(), function.valueCount())
  run List<u64>.appendRepeated(&mut state.known, none(), function.valueCount())
  // Entries: a block to enter, or `usize.MAX - n` to leave the n-th mark.
  let mut marks = List<usize>.make()
  let mut walk = List<usize>.make()
  run List<usize>.append(&mut walk, usize.ZERO)
  let blocks = function.blockCount()
  while let Option<usize>.Some {value: next} = List<usize>.pop(&mut walk) {
    if next > blocks {
      let mark = usize.MAX - next
      leave(&mut state, List<usize>.asSlice(&marks), mark)
      List<usize>.truncate(&mut marks, mark)
      continue
    }
    let block = next
    let mark = List<usize>.length(&marks)
    run List<usize>.append(&mut marks, List<Entry>.length(&state.entries))
    run List<usize>.append(&mut marks, List<Known>.length(&state.knownLog))
    run List<usize>.append(&mut marks, List<Fact>.length(&state.facts))
    run List<usize>.append(&mut walk, usize.MAX - mark)
    if let Option<Counter>.Some {value: counter} = SsaInduction.find(&function.*, &graph, block) {
      run List<Fact>.append(&mut state.facts, Fact {predicate: Predicate.Uge, left: counter.value, right: counter.initial, truth: true})
      run List<Fact>.append(&mut state.facts, Fact {predicate: Predicate.Ule, left: counter.value, right: counter.limit, truth: true})
    }
    run learnFromPredecessor(&mut state, &mut function.*, &graph, block)
    run visitBlock(&mut state, &mut function.*, block)
    run hoistShared(&mut state, &mut function.*, &graph, block)
    let children = graph.childrenOf(block)
    let mut child = children.length
    while child > usize.ZERO {
      child = child - usize.ONE
      run List<usize>.append(&mut walk, children[child])
    }
  }
  function.sweep()
  return state.changed
}

// Moves to the end of `block`, which the walk has just numbered, the instructions of the two
// blocks its branch leads to, when `block` is the only way into either, they hold the same pure
// instructions in the same order, and both jump on to one block with the same values: one of
// each pair moves and is numbered here, and the other becomes it. Whichever way the branch went
// ran them first, so each runs as often as before, and a trap one raises is raised before
// anything that follows. The arms are left empty and alike, so the branch between them goes. A
// conversion written as a branch on the sign, each side of which turns out to keep the same
// bits, becomes that one computation. Arms that share less keep their instructions, since each
// moved one would need a local to cross the branch.
effect fn hoistShared(state: &mut Numbering, function: &mut SsaFunction, graph: &SsaGraph, block: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if function.block(block).exit != Exit.Branch { return () }
  let first = List<Edge>.asSlice(&function.block(block).edges)[usize.ZERO].block
  let second = List<Edge>.asSlice(&function.block(block).edges)[usize.ONE].block
  if first == second || first == block || second == block { return () }
  if graph.predecessorsOf(first).length != usize.ONE || graph.predecessorsOf(second).length != usize.ONE { return () }
  if List<u64>.length(&function.block(first).parameters) != usize.ZERO || List<u64>.length(&function.block(second).parameters) != usize.ZERO { return () }
  let ours = List<usize>.length(&function.block(first).instructions)
  let theirs = List<usize>.length(&function.block(second).instructions)
  let shared = ours
  if shared == usize.ZERO || theirs != shared { return () }
  // Each pair's results, the second arm's then the first's: a later pair may read them.
  let mut pairs = List<u64>.make()
  let mut at = usize.ZERO
  while at < shared {
    let moved = List<usize>.get(&function.block(first).instructions, at)
    let other = List<usize>.get(&function.block(second).instructions, at)
    let found = function.instruction(moved)
    let twin = function.instruction(other)
    if found.removed || twin.removed || found.result == none() || !found.operation.isPure() || found.operation.hasSideEffects() { return () }
    if !found.kind.equals(twin.kind) || !sameOperation(found.operation, twin.operation) { return () }
    let operands = function.operandsOf(moved).length
    if function.operandsOf(other).length != operands { return () }
    let mut operand = usize.ZERO
    while operand < operands {
      let mut theirOperand = resolve(&state.*, function.operandsOf(other)[operand])
      let known = List<u64>.asSlice(&pairs)
      let mut pair = usize.ZERO
      while pair < known.length {
        if known[pair] == theirOperand { theirOperand = known[pair + usize.ONE] }
        pair = pair + 2
      }
      if resolve(&state.*, function.operandsOf(moved)[operand]) != theirOperand { return () }
      operand = operand + usize.ONE
    }
    let results = found.operation.resultCount(found.kind)
    let mut result = usize.ZERO
    while result < results {
      run List<u64>.append(&mut pairs, twin.result + usize.toU64(result))
      run List<u64>.append(&mut pairs, found.result + usize.toU64(result))
      result = result + usize.ONE
    }
    at = at + usize.ONE
  }
  // Both arms jump on to one block with the same values.
  if function.block(first).exit != Exit.Jump || function.block(second).exit != Exit.Jump { return () }
  let onward = &List<Edge>.asSlice(&function.block(first).edges)[usize.ZERO]
  let twinOnward = &List<Edge>.asSlice(&function.block(second).edges)[usize.ZERO]
  if onward.block != twinOnward.block || List<u64>.length(&onward.arguments) != List<u64>.length(&twinOnward.arguments) { return () }
  let mut argument = usize.ZERO
  while argument < List<u64>.length(&onward.arguments) {
    let mut theirArgument = resolve(&state.*, List<u64>.get(&twinOnward.arguments, argument))
    let known = List<u64>.asSlice(&pairs)
    let mut pair = usize.ZERO
    while pair < known.length {
      if known[pair] == theirArgument { theirArgument = known[pair + usize.ONE] }
      pair = pair + 2
    }
    if resolve(&state.*, List<u64>.get(&onward.arguments, argument)) != theirArgument { return () }
    argument = argument + usize.ONE
  }
  // The first arm's instructions leave it one by one; the second's stay listed until the sweep.
  at = usize.ZERO
  while at < shared {
    let moved = List<usize>.get(&function.block(first).instructions, usize.ZERO)
    let other = List<usize>.get(&function.block(second).instructions, at)
    let found = function.instruction(moved)
    let twin = function.instruction(other)
    let end = List<usize>.length(&function.block(block).instructions)
    run function.moveInstruction(moved, block, end)
    run visitInstruction(&mut state.*, &mut function.*, moved)
    let standing = resolve(&state.*, found.result)
    run replace(&mut state.*, twin.result, standing)
    if found.operation.resultCount(found.kind) == 2 {
      let next = resolve(&state.*, found.result + 1)
      run replace(&mut state.*, twin.result + 1, next)
    }
    function.remove(other)
    at = at + usize.ONE
  }
  state.changed = true
  return ()
}

// Undoes what the walk learned since mark `mark`: the entries, the known values and the facts.
fn leave(state: &mut Numbering, marks: &[usize], mark: usize) -> () {
  let entries = marks[mark]
  while List<Entry>.length(&state.entries) > entries {
    let last = List<Entry>.length(&state.entries) - usize.ONE
    let entry = List<Entry>.get(&state.entries, last)
    List<usize>.set(&mut state.buckets, entry.bucket, entry.next)
    List<Entry>.truncate(&mut state.entries, last)
  }
  let known = marks[mark + usize.ONE]
  while List<Known>.length(&state.knownLog) > known {
    let last = List<Known>.length(&state.knownLog) - usize.ONE
    let undone = List<Known>.get(&state.knownLog, last)
    List<u64>.set(&mut state.known, u64.toUsize(undone.value), undone.previous)
    List<Known>.truncate(&mut state.knownLog, last)
  }
  List<Fact>.truncate(&mut state.facts, marks[mark + 2])
  return ()
}

// What a block learns from its only predecessor's branch or switch.
effect fn learnFromPredecessor(state: &mut Numbering, function: &mut SsaFunction, graph: &SsaGraph, block: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let incoming = graph.predecessorsOf(block)
  if incoming.length != usize.ONE { return () }
  let from = function.block(incoming[usize.ZERO])
  let edges = List<Edge>.asSlice(&from.edges)
  let mut taken = usize.MAX
  let mut at = usize.ZERO
  while at < edges.length {
    if edges[at].block == block { taken = at }
    at = at + usize.ONE
  }
  if taken == usize.MAX { return () }
  let condition = resolve(&state.*, from.value)
  if from.exit == Exit.Branch {
    if function.isConstant(condition) { return () }
    let mut truth = taken == usize.ZERO
    let flag = run flagOf(&mut state.*, &mut function.*, truth)
    run learn(&mut state.*, condition, flag)
    let mut producer = function.producerOf(condition)
    // A flag exclusive-ored with one is the negation of the other operand, which is then known
    // too, with the opposite truth.
    let mut steps = usize.ZERO
    while producer != usize.MAX && steps < 4 {
      let mut inner = none()
      if let Operation.Binary {operation: Binary.Xor} = function.instruction(producer).operation {
        let operands = function.operandsOf(producer)
        if function.kindOf(operands[usize.ZERO]).bits == usize.ONE && !function.kindOf(operands[usize.ZERO]).isVector() {
          if function.isBits(operands[usize.ONE]) && function.constantOf(operands[usize.ONE]).low == 1 { inner = operands[usize.ZERO] }
          if function.isBits(operands[usize.ZERO]) && function.constantOf(operands[usize.ZERO]).low == 1 { inner = operands[usize.ONE] }
        }
      }
      if inner == none() || function.isConstant(inner) { break }
      truth = !truth
      let known = run flagOf(&mut state.*, &mut function.*, truth)
      run learn(&mut state.*, inner, known)
      producer = function.producerOf(inner)
      steps = steps + usize.ONE
    }
    if producer != usize.MAX {
      if let Operation.Compare {predicate} = function.instruction(producer).operation {
        let operands = function.operandsOf(producer)
        if isIntegerPredicate(predicate) {
          run List<Fact>.append(&mut state.facts, Fact {predicate: predicate, left: operands[usize.ZERO], right: operands[usize.ONE], truth: truth})
        }
      }
    }
  } else if from.exit == Exit.Switch && taken != usize.ZERO {
    // A case's block, unless the default reaches it too, knows the value is the case's bits:
    // the only predecessor counted each edge, so one edge leads here.
    if function.isConstant(condition) { return () }
    let bits = List<u64>.get(&from.cases, taken - usize.ONE)
    let kind = function.kindOf(condition)
    let equal = run function.constant(kind, bits)
    run learn(&mut state.*, condition, equal)
  }
  return ()
}

// The flag constant `truth`, made once per walk.
effect fn flagOf(state: &mut Numbering, function: &mut SsaFunction, truth: bool) -> u64 ! OutOfMemoryError ? &mut Allocator {
  if truth {
    if state.trueFlag == none() { state.trueFlag = run function.flag(true) }
    return state.trueFlag
  }
  if state.falseFlag == none() { state.falseFlag = run function.flag(false) }
  return state.falseFlag
}

effect fn learn(state: &mut Numbering, value: u64, equal: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  if equal == none() { return () }
  run grow(&mut state.*, value)
  let previous = List<u64>.get(&state.known, u64.toUsize(value))
  run List<Known>.append(&mut state.knownLog, Known {value: value, previous: previous})
  List<u64>.set(&mut state.known, u64.toUsize(value), equal)
  return ()
}

effect fn grow(state: &mut Numbering, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let wanted = u64.toUsize(value) + usize.ONE
  let substituted = List<u64>.length(&state.substitution)
  if substituted < wanted { run List<u64>.appendRepeated(&mut state.substitution, none(), wanted - substituted) }
  let known = List<u64>.length(&state.known)
  if known < wanted { run List<u64>.appendRepeated(&mut state.known, none(), wanted - known) }
  return ()
}

// The value `value` stands for where the walk is: its replacement, then what it is known as.
fn resolve(state: &Numbering, value: u64) -> u64 {
  let mut at = value
  let mut steps = usize.ZERO
  while at != none() && steps < 64 {
    let index = u64.toUsize(at)
    let mut next = none()
    if index < List<u64>.length(&state.substitution) { next = List<u64>.get(&state.substitution, index) }
    if next == none() && index < List<u64>.length(&state.known) { next = List<u64>.get(&state.known, index) }
    if next == none() { return at }
    at = next
    steps = steps + usize.ONE
  }
  return at
}

effect fn replace(state: &mut Numbering, value: u64, by: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  run grow(&mut state.*, value)
  List<u64>.set(&mut state.substitution, u64.toUsize(value), by)
  state.changed = true
  return ()
}

effect fn visitBlock(state: &mut Numbering, function: &mut SsaFunction, block: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut count = List<usize>.length(&function.block(block).instructions)
  let mut at = usize.ZERO
  while at < count {
    let instruction = List<usize>.get(&function.block(block).instructions, at)
    // Instructions a truncation is rewritten into go before it and are numbered next time.
    let mut added = run narrowThrough(&mut state.*, &mut function.*, block, at, instruction)
    added = added + run uncheck(&mut state.*, &mut function.*, block, at + added, instruction)
    added = added + run foldIndexedAccess(&mut state.*, &mut function.*, block, at + added, instruction)
    at = at + added
    count = count + added
    run visitInstruction(&mut state.*, &mut function.*, instruction)
    at = at + usize.ONE
  }
  // The exit's value and arguments.
  let value = function.block(block).value
  if value != none() {
    let resolved = resolve(&state.*, value)
    if resolved != value {
      function.setExitValue(block, resolved)
      state.changed = true
    }
  }
  let edges = List<Edge>.length(&function.block(block).edges)
  let mut edge = usize.ZERO
  while edge < edges {
    let arguments = List<u64>.length(&List<Edge>.asSlice(&function.block(block).edges)[edge].arguments)
    let mut argument = usize.ZERO
    while argument < arguments {
      let passed = List<u64>.get(&List<Edge>.asSlice(&function.block(block).edges)[edge].arguments, argument)
      let resolved = resolve(&state.*, passed)
      if resolved != passed {
        function.setArgument(block, edge, argument, resolved)
        state.changed = true
      }
      argument = argument + usize.ONE
    }
    edge = edge + usize.ONE
  }
  return ()
}

// Fold a fixed neighbor displacement into the Wasm memory immediate when the full
// access is proven to stay in a stack slot. The immediate adds without wrapping.
// For negative displacements, subtract the index's lower bound from the shared
// address so neighboring accesses can use positive immediates from that address.
effect fn foldIndexedAccess(state: &mut Numbering, function: &mut SsaFunction, block: usize, position: usize, instruction: usize) -> usize
! OutOfMemoryError ? &mut Allocator {
  let found = function.instruction(instruction)
  let mut operand = usize.ZERO
  let mut size = usize.toU64(found.kind.storeSize())
  let alignment = match found.operation {
    Operation.Load {offset, alignment: aligned} => { if offset != 0 { return usize.ZERO } aligned }
    Operation.Store {offset, alignment: aligned} => {
      if offset != 0 { return usize.ZERO }
      operand = usize.ONE
      size = usize.toU64(function.kindOf(function.operandsOf(instruction)[usize.ZERO]).storeSize())
      aligned
    }
    _ => { return usize.ZERO }
  }
  let pointer = function.operandsOf(instruction)[operand]
  let moved = function.producerOf(pointer)
  if moved == usize.MAX { return usize.ZERO }
  let delta = match function.instruction(moved).operation { Operation.Offset {offset} => offset _ => { return usize.ZERO } }
  let base = function.operandsOf(moved)[usize.ZERO]
  let index = function.producerOf(base)
  if index == usize.MAX { return usize.ZERO }
  if let Operation.Index = function.instruction(index).operation {} else { return usize.ZERO }
  let args = function.operandsOf(index)
  let stack = function.producerOf(args[usize.ZERO])
  if stack == usize.MAX { return usize.ZERO }
  let slot = match function.instruction(stack).operation { Operation.SlotAddress {slot: which} => which _ => { return usize.ZERO } }
  if function.kindOf(args[usize.ONE]).bits != function.addressBits { return usize.ZERO }
  let bounds = rangeOf(&state.*, &function.*, args[usize.ONE], rangeDepth())
  let bytes = function.slot(slot).size
  if bounds.high > bytes { return usize.ZERO }
  let low = masked(u64.wrappingAdd(bounds.low, delta), function.addressBits)
  let span = bounds.high - bounds.low
  if low > bytes || span > bytes - low || size > bytes - low - span { return usize.ZERO }
  let mut added = usize.ZERO
  let mut address = base
  let mut immediate = delta
  if delta > low {
    if low == 0 { return usize.ZERO }
    let back = masked(u64.wrappingSubtract(0, bounds.low), function.addressBits)
    let pointerKind = function.kindOf(base)
    address = run function.insertInstruction(block, position, Operation.Offset {offset: back}, pointerKind, &[base], found.place)
    added = usize.ONE
    immediate = low
  }
  function.setOperand(instruction, operand, address)
  if operand == usize.ZERO { function.setOperation(instruction, Operation.Load {offset: immediate, alignment: alignment}) }
  else { function.setOperation(instruction, Operation.Store {offset: immediate, alignment: alignment}) }
  state.changed = true
  return added
}

// Truncates before a difference from a constant instead of after it: `trunc(c - y)` is
// `trunc(c) - trunc(y)`, since its low bits depend only on the operands' low bits, and the narrow
// difference is where the folds of that width apply, such as `-1 - x`. A mask that keeps every
// bit the truncation does just goes. Answers how many instructions it put before `instruction`, at `position` of `block`,
// which it then removed.
effect fn narrowThrough(state: &mut Numbering, function: &mut SsaFunction, block: usize, position: usize, instruction: usize) -> usize
! OutOfMemoryError ? &mut Allocator {
  let found = function.instruction(instruction)
  let truncating = match found.operation {
    Operation.Cast {operation} => operation == Cast.Trunc
    _ => false
  }
  let kind = found.kind
  if !truncating || !kind.isInteger() || kind.isVector() || found.removed { return usize.ZERO }
  let source = resolve(&state.*, function.operandsOf(instruction)[usize.ZERO])
  let wide = function.kindOf(source)
  let producer = function.producerOf(source)
  if producer == usize.MAX || !wide.isInteger() || wide.isVector() || wide.bits > 64 || wide.bits <= kind.bits { return usize.ZERO }
  let operation = match function.instruction(producer).operation {
    Operation.Binary {operation: wrapped} => wrapped
    _ => { return usize.ZERO }
  }
  if operation != Binary.Add && operation != Binary.Sub && operation != Binary.Mul && operation != Binary.And && operation != Binary.Or
    && operation != Binary.Xor { return usize.ZERO }
  let left = resolve(&state.*, function.operandsOf(producer)[usize.ZERO])
  let right = resolve(&state.*, function.operandsOf(producer)[usize.ONE])
  let leftConstant = function.isBits(left)
  let rightConstant = function.isBits(right)
  if leftConstant == rightConstant { return usize.ZERO }
  let mut constant = right
  let mut other = left
  if leftConstant {
    constant = left
    other = right
  }
  let low = masked(function.constantOf(constant).low, kind.bits)
  if operation == Binary.And && low == masked(u64.MAX, kind.bits) {
    function.setOperand(instruction, usize.ZERO, other)
    state.changed = true
    return usize.ZERO
  }
  // Only a constant less a value moves: the narrow difference is where `-1 - x` folds. Moving
  // a sum or a product would leave the wide one in place for its other uses and add to them.
  if operation != Binary.Sub || !leftConstant { return usize.ZERO }
  let narrow = run function.insertInstruction(block, position, Operation.Cast {operation: Cast.Trunc}, kind, &[other], found.place)
  let folded = run function.constant(kind, low)
  let mut first = narrow
  let mut second = folded
  if leftConstant {
    first = folded
    second = narrow
  }
  let result = run function.insertInstruction(block, position + usize.ONE, Operation.Binary {operation: operation}, kind, &[first, second],
    found.place)
  run replace(&mut state.*, found.result, result)
  function.remove(instruction)
  return 2
}

// Replaces an overflow-checked sum, difference or product whose operands' ranges show it cannot
// overflow by the wrapping operation and a clear flag, so its trap path folds away: an exponent
// of a few thousand times a constant needs no check. Answers how many instructions it put before
// `instruction`, at `position` of `block`, which it then removed.
effect fn uncheck(state: &mut Numbering, function: &mut SsaFunction, block: usize, position: usize, instruction: usize) -> usize
! OutOfMemoryError ? &mut Allocator {
  let found = function.instruction(instruction)
  if found.removed { return usize.ZERO }
  let kind = found.kind
  if !kind.isInteger() || kind.isVector() || kind.bits > 64 || kind.bits < 2 { return usize.ZERO }
  if let Operation.Overflow {operation, signed} = found.operation {
    if operation != Binary.Add && operation != Binary.Sub && operation != Binary.Mul { return usize.ZERO }
    let left = resolve(&state.*, function.operandsOf(instruction)[usize.ZERO])
    let right = resolve(&state.*, function.operandsOf(instruction)[usize.ONE])
    let mut fits = false
    if signed {
      let first = signedRangeOf(&state.*, &function.*, left, rangeDepth())
      let second = signedRangeOf(&state.*, &function.*, right, rangeDepth())
      let mut full = SignedRange {low: i64.MIN, high: i64.MAX}
      if kind.bits < 64 {
        let most = u64.wrappingToI64(u64.shiftLeft(1, usize.toU64(kind.bits - usize.ONE))) - 1
        full = SignedRange {low: 0 - most - 1, high: most}
      }
      // A range that is the whole kind's says nothing; a narrower result does not overflow.
      let mut result = full
      let mut bounded = false
      if operation == Binary.Add {
        if let Option<i64>.Some {value: least} = i64.checkedAdd(first.low, second.low) {
          if let Option<i64>.Some {value: most} = i64.checkedAdd(first.high, second.high) {
            result = SignedRange {low: least, high: most}
            bounded = true
          }
        }
      }
      if operation == Binary.Sub {
        if let Option<i64>.Some {value: least} = i64.checkedSubtract(first.low, second.high) {
          if let Option<i64>.Some {value: most} = i64.checkedSubtract(first.high, second.low) {
            result = SignedRange {low: least, high: most}
            bounded = true
          }
        }
      }
      if operation == Binary.Mul {
        let corners = [i64.checkedMultiply(first.low, second.low), i64.checkedMultiply(first.low, second.high),
          i64.checkedMultiply(first.high, second.low), i64.checkedMultiply(first.high, second.high)]
        bounded = true
        let mut least = i64.MAX
        let mut most = i64.MIN
        let mut at = usize.ZERO
        while at < 4 {
          if let Option<i64>.Some {value: corner} = corners[at] {
            if corner < least { least = corner }
            if corner > most { most = corner }
          } else { bounded = false }
          at = at + usize.ONE
        }
        result = SignedRange {low: least, high: most}
      }
      fits = bounded && first.low <= first.high && second.low <= second.high && result.low >= full.low && result.high <= full.high
    } else {
      let first = rangeOf(&state.*, &function.*, left, rangeDepth())
      let second = rangeOf(&state.*, &function.*, right, rangeDepth())
      let most = masked(u64.MAX, kind.bits)
      if first.low <= first.high && second.low <= second.high {
        if operation == Binary.Add { fits = first.high <= most - second.high }
        if operation == Binary.Sub { fits = first.low >= second.high }
        if operation == Binary.Mul { fits = first.high == 0 || second.high <= most / first.high }
      }
    }
    if !fits { return usize.ZERO }
    let plain = run function.insertInstruction(block, position, Operation.Binary {operation: operation}, kind, &[left, right], found.place)
    let clear = run flagOf(&mut state.*, &mut function.*, false)
    run replace(&mut state.*, found.result, plain)
    run replace(&mut state.*, found.result + 1, clear)
    function.remove(instruction)
    return usize.ONE
  }
  return usize.ZERO
}

effect fn visitInstruction(state: &mut Numbering, function: &mut SsaFunction, instruction: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let operandCount = function.operandsOf(instruction).length
  let mut at = usize.ZERO
  while at < operandCount {
    let used = function.operandsOf(instruction)[at]
    let resolved = resolve(&state.*, used)
    if resolved != used {
      function.setOperand(instruction, at, resolved)
      state.changed = true
    }
    at = at + usize.ONE
  }
  let found = function.instruction(instruction)
  if !found.operation.isPure() || found.result == none() || found.removed { return () }
  let two = found.operation.resultCount(found.kind) == 2
  let folded = run SsaFolding.simplify(&mut function.*, instruction)
  if folded.value != none() && (!two || folded.second != none()) {
    run replace(&mut state.*, found.result, folded.value)
    if two { run replace(&mut state.*, found.result + 1, folded.second) }
    function.remove(instruction)
    return ()
  }
  normalize(&mut function.*, instruction)
  // A comparison a known fact decides.
  let decided = decidedByFacts(&state.*, &function.*, instruction)
  if decided != usize.MAX {
    let flag = run flagOf(&mut state.*, &mut function.*, decided == usize.ONE)
    run replace(&mut state.*, found.result, flag)
    function.remove(instruction)
    return ()
  }
  // An equal instruction in a dominating position.
  let hash = hashOf(&function.*, instruction)
  let bucket = u64.toUsize(u64.bitAnd(hash, usize.toU64(List<usize>.length(&state.buckets) - usize.ONE)))
  let mut entry = List<usize>.get(&state.buckets, bucket)
  while entry != usize.MAX {
    let listed = List<Entry>.get(&state.entries, entry)
    if equal(&function.*, listed.instruction, instruction) {
      let earlier = function.instruction(listed.instruction)
      run replace(&mut state.*, found.result, earlier.result)
      if two { run replace(&mut state.*, found.result + 1, earlier.result + 1) }
      function.remove(instruction)
      return ()
    }
    entry = listed.next
  }
  let head = List<usize>.get(&state.buckets, bucket)
  List<usize>.set(&mut state.buckets, bucket, List<Entry>.length(&state.entries))
  run List<Entry>.append(&mut state.entries, Entry {instruction: instruction, bucket: bucket, next: head})
  return ()
}

// Puts the operands of a commutative integer operation, or of an integer comparison, in value
// order.
fn normalize(function: &mut SsaFunction, instruction: usize) -> () {
  let found = function.instruction(instruction)
  let operands = function.operandsOf(instruction)
  if operands.length != 2 { return () }
  let left = operands[usize.ZERO]
  let right = operands[usize.ONE]
  if left <= right || !function.kindOf(left).isInteger() && !function.kindOf(left).isAddress() { return () }
  match found.operation {
    Operation.Binary {operation} => {
      if operation != Binary.Add && operation != Binary.Mul && operation != Binary.And && operation != Binary.Or && operation != Binary.Xor { return () }
      if !function.kindOf(left).isInteger() { return () }
    }
    Operation.Compare {predicate} => {
      if !isIntegerPredicate(predicate) { return () }
      function.setOperation(instruction, Operation.Compare {predicate: swapped(predicate)})
    }
    _ => { return () }
  }
  function.setOperand(instruction, usize.ZERO, right)
  function.setOperand(instruction, usize.ONE, left)
  return ()
}

/// The predicate that holds of `b, a` when `predicate` holds of `a, b`.
pub fn swapped(predicate: Predicate) -> Predicate {
  return match predicate {
    Predicate.Ugt => Predicate.Ult
    Predicate.Uge => Predicate.Ule
    Predicate.Ult => Predicate.Ugt
    Predicate.Ule => Predicate.Uge
    Predicate.Sgt => Predicate.Slt
    Predicate.Sge => Predicate.Sle
    Predicate.Slt => Predicate.Sgt
    Predicate.Sle => Predicate.Sge
    _ => predicate
  }
}

/// The integer predicate that holds exactly when `predicate` does not.
pub fn inverse(predicate: Predicate) -> Predicate {
  return match predicate {
    Predicate.Eq => Predicate.Ne
    Predicate.Ne => Predicate.Eq
    Predicate.Ugt => Predicate.Ule
    Predicate.Uge => Predicate.Ult
    Predicate.Ult => Predicate.Uge
    Predicate.Ule => Predicate.Ugt
    Predicate.Sgt => Predicate.Sle
    Predicate.Sge => Predicate.Slt
    Predicate.Slt => Predicate.Sge
    Predicate.Sle => Predicate.Sgt
    _ => predicate
  }
}

/// Whether integer predicate `known` holding of two operands implies `asked` holds of them.
pub fn implies(known: Predicate, asked: Predicate) -> bool {
  if known == asked { return true }
  return match known {
    Predicate.Eq => asked == Predicate.Ule || asked == Predicate.Uge || asked == Predicate.Sle || asked == Predicate.Sge
    Predicate.Ult => asked == Predicate.Ule || asked == Predicate.Ne
    Predicate.Ugt => asked == Predicate.Uge || asked == Predicate.Ne
    Predicate.Slt => asked == Predicate.Sle || asked == Predicate.Ne
    Predicate.Sgt => asked == Predicate.Sge || asked == Predicate.Ne
    _ => false
  }
}

// Whether `value` is an unsigned scalar remainder by `divisor`. If it produced a value,
// the divisor was nonzero and the result is strictly below it.
fn remainderBy(function: &SsaFunction, value: u64, divisor: u64) -> bool {
  let producer = function.producerOf(value)
  if producer == usize.MAX { return false }
  if let Operation.Binary {operation: Binary.URem} = function.instruction(producer).operation {
    let kind = function.kindOf(value)
    return kind.isInteger() && !kind.isVector() && function.operandsOf(producer)[usize.ONE] == divisor
  }
  return false
}

// 1 when a known fact proves comparison `instruction` holds, 0 when it proves it does not, else
// `usize.MAX`.
fn decidedByFacts(state: &Numbering, function: &SsaFunction, instruction: usize) -> usize {
  let asked = match function.instruction(instruction).operation {
    Operation.Compare {predicate} => predicate
    _ => { return usize.MAX }
  }
  if !isIntegerPredicate(asked) { return usize.MAX }
  let operands = function.operandsOf(instruction)
  let left = operands[usize.ZERO]
  let right = operands[usize.ONE]
  let leftIsRemainder = remainderBy(function, left, right)
  if leftIsRemainder || remainderBy(function, right, left) {
    let mut known = Predicate.Ugt
    if leftIsRemainder { known = Predicate.Ult }
    if implies(known, asked) { return usize.ONE }
    if implies(known, inverse(asked)) { return usize.ZERO }
  }
  let facts = List<Fact>.asSlice(&state.facts)
  let mut at = facts.length
  let mut seen = usize.ZERO
  // `a + 1 < a`, the test that an unsigned increment wrapped, is false wherever `a` is known to
  // be below some value, since `a` is then not the greatest one.
  let mut bumped = none()
  if asked == Predicate.Ult && incrementOf(function, left) == right { bumped = right }
  if asked == Predicate.Ugt && incrementOf(function, right) == left { bumped = left }
  while bumped != none() && at > usize.ZERO && seen < factWindow() {
    at = at - usize.ONE
    seen = seen + usize.ONE
    let fact = facts[at]
    let mut holding = fact.predicate
    if !fact.truth { holding = inverse(fact.predicate) }
    if resolve(&state.*, fact.left) == bumped && holding == Predicate.Ult { return usize.ZERO }
    if resolve(&state.*, fact.right) == bumped && holding == Predicate.Ugt { return usize.ZERO }
  }
  at = facts.length
  seen = usize.ZERO
  while at > usize.ZERO && seen < factWindow() {
    at = at - usize.ONE
    seen = seen + usize.ONE
    let fact = facts[at]
    let mut holding = fact.predicate
    if !fact.truth { holding = inverse(fact.predicate) }
    let mut matched = false
    if resolve(&state.*, fact.left) == left && resolve(&state.*, fact.right) == right { matched = true }
    else if resolve(&state.*, fact.left) == right && resolve(&state.*, fact.right) == left {
      holding = swapped(holding)
      matched = true
    }
    if matched {
      if implies(holding, asked) { return usize.ONE }
      if implies(holding, inverse(asked)) { return usize.ZERO }
    }
  }
  return decidedByRanges(state, function, asked, left, right)
}

// The unsigned values a value can have where the walk stands, from `low` to `high`.
struct Range {
  low: u64,
  high: u64,
}

impl Copy for Range {}

// How far `rangeOf` and `signedRangeOf` look through a value's operands: each cast or operation
// with a constant operand takes one of this budget, and an operation on two other values takes
// three, since it looks through both.
fn rangeDepth() -> usize { return 9 }

// What looking through instruction `producer` takes of the depth budget.
fn rangeCost(function: &SsaFunction, producer: usize) -> usize {
  let operands = function.operandsOf(producer)
  if operands.length < 2 || function.isBits(operands[usize.ZERO]) || function.isBits(operands[usize.ONE]) { return usize.ONE }
  return 3
}

// The unsigned range of `value`, an integer or address of at most 64 bits, where the walk
// stands: what its operation bounds it to, such as a mask, a narrower source or a shift, then
// what the known facts that compare it with a constant leave of that. `depth` is how many
// operands deep it may still look.
fn rangeOf(state: &Numbering, function: &SsaFunction, value: u64, depth: usize) -> Range {
  let kind = function.kindOf(value)
  let most = masked(u64.MAX, kind.bits)
  let mut range = Range {low: 0, high: most}
  if function.isBits(value) {
    let bits = masked(function.constantOf(value).low, kind.bits)
    return Range {low: bits, high: bits}
  }
  let producer = function.producerOf(value)
  let mut cost = usize.MAX
  if producer != usize.MAX { cost = rangeCost(function, producer) }
  if producer != usize.MAX && depth >= cost {
    let operands = function.operandsOf(producer)
    // An overflow-checked operation's value is the wrapping one's.
    let mut made = function.instruction(producer).operation
    if let Operation.Overflow {operation: checked, ..} = made {
      if function.value(value).index == usize.ZERO { made = Operation.Binary {operation: checked} }
    }
    match made {
      Operation.Binary {operation} => {
        let first = rangeOf(state, function, operands[usize.ZERO], depth - cost)
        let second = rangeOf(state, function, operands[usize.ONE], depth - cost)
        if operation == Binary.And {
          range.high = first.high
          if second.high < range.high { range.high = second.high }
        }
        // A product or a left shift that cannot pass the kind's greatest value.
        if operation == Binary.Mul && (first.high == 0 || second.high <= most / first.high) {
          range = Range {low: first.low * second.low, high: first.high * second.high}
        }
        if operation == Binary.Shl && second.low == second.high && second.low < 64 && first.high <= u64.shiftRight(most, second.low) {
          range = Range {low: u64.shiftLeft(first.low, second.low), high: u64.shiftLeft(first.high, second.low)}
        }
        if operation == Binary.LShr && second.low == second.high && second.low < 64 {
          range = Range {low: u64.shiftRight(first.low, second.low), high: u64.shiftRight(first.high, second.low)}
        }
        if operation == Binary.URem && second.low > 0 { range.high = second.high - 1 }
        // When every endpoint stays in the kind, addition and subtraction are monotone
        // in each operand. This also bounds row * stride + column for two bounded indices.
        if operation == Binary.Add && first.high <= most - second.high {
          range = Range {low: first.low + second.low, high: first.high + second.high}
        }
        if operation == Binary.Sub && first.low >= second.high {
          range = Range {low: first.low - second.high, high: first.high - second.low}
        }
      }
      Operation.Cast {operation} => {
        let from = function.kindOf(operands[usize.ZERO])
        if (from.isInteger() || from.isAddress()) && !from.isVector() && from.bits <= 64 {
          let source = rangeOf(state, function, operands[usize.ZERO], depth - cost)
          if operation == Cast.ZExt || operation == Cast.PtrToInt || operation == Cast.IntToPtr || operation == Cast.Trunc {
            // A truncation keeps a value that already fits.
            if source.high <= most { range = source }
          }
        }
      }
      Operation.Compare {..} => { range.high = 1 }
      _ => {}
    }
  }
  // The facts that compare the value with a constant, or that compare with one the wider value
  // it is the truncation of, masked to the truncation's bits: the two have the same value.
  let wider = truncated(function, value)
  let facts = List<Fact>.asSlice(&state.facts)
  let mut at = facts.length
  let mut seen = usize.ZERO
  while at > usize.ZERO && seen < factWindow() {
    at = at - usize.ONE
    seen = seen + usize.ONE
    let fact = facts[at]
    let mut holding = fact.predicate
    if !fact.truth { holding = inverse(fact.predicate) }
    let mut bound = none()
    let left = resolve(state, fact.left)
    let right = resolve(state, fact.right)
    if function.isBits(fact.right) && (left == value || (wider != none() && maskOf(state, function, left, most) == wider)) { bound = fact.right }
    else if function.isBits(fact.left) && (right == value || (wider != none() && maskOf(state, function, right, most) == wider)) {
      bound = fact.left
      holding = swapped(holding)
    }
    if bound == none() || function.kindOf(bound).bits > 64 { continue }
    let limit = masked(function.constantOf(bound).low, function.kindOf(bound).bits)
    if holding == Predicate.Ult && limit > 0 && limit - 1 < range.high { range.high = limit - 1 }
    if holding == Predicate.Ule && limit < range.high { range.high = limit }
    if holding == Predicate.Ugt && limit < most && limit + 1 > range.low { range.low = limit + 1 }
    if holding == Predicate.Uge && limit <= most && limit > range.low { range.low = limit }
    if holding == Predicate.Eq && limit <= most { range = Range {low: limit, high: limit} }
  }
  // Contradictory path facts describe an unreachable block. Keep the endpoints ordered
  // before a caller uses them in checked host arithmetic.
  if range.low > range.high { return Range {low: 0, high: most} }
  return range
}

// The wider scalar integer `value` is the truncation of, or `none()`.
fn truncated(function: &SsaFunction, value: u64) -> u64 {
  let producer = function.producerOf(value)
  if producer == usize.MAX { return none() }
  if let Operation.Cast {operation: Cast.Trunc} = function.instruction(producer).operation {
    let source = function.operandsOf(producer)[usize.ZERO]
    let from = function.kindOf(source)
    if from.isInteger() && !from.isVector() && from.bits <= 64 { return source }
  }
  return none()
}

// The value `value` is the low bits `mask` of, when it is that value and the constant `mask`
// combined by `And`; else `none()`.
fn maskOf(state: &Numbering, function: &SsaFunction, value: u64, mask: u64) -> u64 {
  let producer = function.producerOf(value)
  if producer == usize.MAX { return none() }
  if let Operation.Binary {operation: Binary.And} = function.instruction(producer).operation {
    let operands = function.operandsOf(producer)
    let first = operands[usize.ZERO]
    let second = operands[usize.ONE]
    if function.kindOf(value).isVector() || function.kindOf(value).bits > 64 { return none() }
    if function.isBits(second) && function.constantOf(second).low == mask { return resolve(state, first) }
    if function.isBits(first) && function.constantOf(first).low == mask { return resolve(state, second) }
  }
  return none()
}

// The signed values a value can have where the walk stands, from `low` to `high`.
struct SignedRange {
  low: i64,
  high: i64,
}

impl Copy for SignedRange {}

// `bits`, an integer `width` bits wide, read as signed.
fn signedOf(bits: u64, width: usize) -> i64 { return u64.wrappingToI64(SsaFolding.signExtended(masked(bits, width), width)) }

// The range `low` to `high` when both are there and lie within `full`, else `full`: a sum or
// difference that could leave the kind's range bounds nothing.
fn withinOr(low: Option<i64>, high: Option<i64>, full: SignedRange) -> SignedRange {
  if let Option<i64>.Some {value: least} = low {
    if let Option<i64>.Some {value: most} = high {
      if least >= full.low && most <= full.high && least <= most { return SignedRange {low: least, high: most} }
    }
  }
  return full
}

// `value` shifted right by `by` bits, under 64, with its sign kept.
fn signedShift(value: i64, by: u64) -> i64 {
  if value >= 0 { return u64.wrappingToI64(u64.shiftRight(i64.wrappingToU64(value), by)) }
  // Below zero, shifting the flipped bits and flipping back rounds toward the least value.
  return -1 - u64.wrappingToI64(u64.shiftRight(i64.wrappingToU64(-1 - value), by))
}

// The range of a product of values in `first` and `second`: its corners' least and greatest,
// or `full` when one of them leaves it.
fn productRange(first: SignedRange, second: SignedRange, full: SignedRange) -> SignedRange {
  let corners = [i64.checkedMultiply(first.low, second.low), i64.checkedMultiply(first.low, second.high),
    i64.checkedMultiply(first.high, second.low), i64.checkedMultiply(first.high, second.high)]
  let mut least = i64.MAX
  let mut most = i64.MIN
  let mut at = usize.ZERO
  while at < 4 {
    if let Option<i64>.Some {value: corner} = corners[at] {
      if corner < full.low || corner > full.high { return full }
      if corner < least { least = corner }
      if corner > most { most = corner }
    } else { return full }
    at = at + usize.ONE
  }
  return SignedRange {low: least, high: most}
}

// The signed range of `value`, an integer of 2 to 64 bits, where the walk stands: what its
// operation bounds it to (a constant added or subtracted without leaving the kind's range, a
// difference from a constant, a mask, an extension), then what the known signed comparisons of it
// with constants leave of that. `depth` is how many operands deep it may still look.
fn signedRangeOf(state: &Numbering, function: &SsaFunction, value: u64, depth: usize) -> SignedRange {
  let kind = function.kindOf(value)
  let mut full = SignedRange {low: i64.MIN, high: i64.MAX}
  if kind.bits < 64 {
    let most = u64.wrappingToI64(u64.shiftLeft(1, usize.toU64(kind.bits - usize.ONE))) - 1
    full = SignedRange {low: 0 - most - 1, high: most}
  }
  if function.isBits(value) {
    let exact = signedOf(function.constantOf(value).low, kind.bits)
    return SignedRange {low: exact, high: exact}
  }
  let mut range = full
  let producer = function.producerOf(value)
  let mut cost = usize.MAX
  if producer != usize.MAX { cost = rangeCost(function, producer) }
  if producer != usize.MAX && depth >= cost {
    let operands = function.operandsOf(producer)
    // An overflow-checked operation's value is the wrapping one's.
    let mut made = function.instruction(producer).operation
    if let Operation.Overflow {operation: checked, ..} = made {
      if function.value(value).index == usize.ZERO { made = Operation.Binary {operation: checked} }
    }
    match made {
      Operation.Binary {operation} => {
        let first = signedRangeOf(state, function, operands[usize.ZERO], depth - cost)
        let second = signedRangeOf(state, function, operands[usize.ONE], depth - cost)
        if operation == Binary.Mul { range = productRange(first, second, full) }
        // A shift right that keeps the sign moves both ends.
        if operation == Binary.AShr && second.low == second.high && second.low >= 0 && second.low < 64 {
          let by = i64.wrappingToU64(second.low)
          range = SignedRange {low: signedShift(first.low, by), high: signedShift(first.high, by)}
        }
        if operation == Binary.Add {
          range = withinOr(i64.checkedAdd(first.low, second.low), i64.checkedAdd(first.high, second.high), full)
        }
        if operation == Binary.Sub {
          range = withinOr(i64.checkedSubtract(first.low, second.high), i64.checkedSubtract(first.high, second.low), full)
        }
        if operation == Binary.And {
          // A mask that is not negative leaves a value from zero to the mask.
          if second.low == second.high && second.low >= 0 { range = SignedRange {low: 0, high: second.low} }
          if first.low == first.high && first.low >= 0 { range = SignedRange {low: 0, high: first.low} }
        }
        // Every bit flipped is `-1 - x`, which never leaves the kind's range.
        if operation == Binary.Xor && second.low == second.high && second.low == -1 {
          range = SignedRange {low: -1 - first.high, high: -1 - first.low}
        }
        if operation == Binary.Xor && first.low == first.high && first.low == -1 {
          range = SignedRange {low: -1 - second.high, high: -1 - second.low}
        }
      }
      Operation.Cast {operation} => {
        let from = function.kindOf(operands[usize.ZERO])
        if from.isInteger() && !from.isVector() && from.bits >= 2 && from.bits <= 64 {
          if operation == Cast.SExt { range = signedRangeOf(state, function, operands[usize.ZERO], depth - cost) }
          if operation == Cast.Trunc {
            let source = signedRangeOf(state, function, operands[usize.ZERO], depth - cost)
            if source.low >= full.low && source.high <= full.high { range = source }
          }
          if operation == Cast.ZExt && from.bits < kind.bits {
            let source = rangeOf(state, function, operands[usize.ZERO], depth - cost)
            range = SignedRange {low: u64.wrappingToI64(source.low), high: u64.wrappingToI64(source.high)}
          }
        }
      }
      _ => {}
    }
  }
  let facts = List<Fact>.asSlice(&state.facts)
  let mut at = facts.length
  let mut seen = usize.ZERO
  while at > usize.ZERO && seen < factWindow() {
    at = at - usize.ONE
    seen = seen + usize.ONE
    let fact = facts[at]
    let mut holding = fact.predicate
    if !fact.truth { holding = inverse(fact.predicate) }
    let mut bound = none()
    if resolve(state, fact.left) == value && function.isBits(fact.right) { bound = fact.right }
    else if resolve(state, fact.right) == value && function.isBits(fact.left) {
      bound = fact.left
      holding = swapped(holding)
    }
    if bound == none() || function.kindOf(bound).bits > 64 || function.kindOf(bound).bits < 2 { continue }
    let limit = signedOf(function.constantOf(bound).low, function.kindOf(bound).bits)
    if holding == Predicate.Slt && limit > full.low && limit - 1 < range.high { range.high = limit - 1 }
    if holding == Predicate.Sle && limit < range.high { range.high = limit }
    if holding == Predicate.Sgt && limit < full.high && limit + 1 > range.low { range.low = limit + 1 }
    if holding == Predicate.Sge && limit > range.low { range.low = limit }
    if holding == Predicate.Eq { range = SignedRange {low: limit, high: limit} }
  }
  // A value whose unsigned range stays below the sign bit is not negative, and its signed range
  // is no wider than that. One whose unsigned range starts at the sign bit or above is negative:
  // each end is 2 to the kind's bits less.
  let unsigned = rangeOf(state, function, value, depth)
  if unsigned.low <= unsigned.high && unsigned.high <= i64.wrappingToU64(full.high) {
    let least = u64.wrappingToI64(unsigned.low)
    let most = u64.wrappingToI64(unsigned.high)
    if least > range.low { range.low = least }
    if most < range.high { range.high = most }
  }
  if unsigned.low <= unsigned.high && unsigned.low > i64.wrappingToU64(full.high) {
    let least = signedOf(unsigned.low, kind.bits)
    let most = signedOf(unsigned.high, kind.bits)
    if least > range.low { range.low = least }
    if most < range.high { range.high = most }
  }
  return range
}

// An unsigned sum is smaller than either addend exactly when the addition wraps.
fn carryOf(state: &Numbering, function: &SsaFunction, sum: u64, addend: u64, bounds: Range) -> usize {
  let producer = function.producerOf(sum)
  if producer == usize.MAX { return usize.MAX }
  if let Operation.Binary {operation: Binary.Add} = function.instruction(producer).operation {
    let args = function.operandsOf(producer)
    let mut other = args[usize.ONE]
    if args[usize.ZERO] != addend {
      if args[usize.ONE] != addend { return usize.MAX }
      other = args[usize.ZERO]
    }
    let rest = rangeOf(state, function, other, rangeDepth())
    let most = masked(u64.MAX, function.kindOf(sum).bits)
    if rest.high <= most - bounds.high { return usize.ZERO }
    if rest.low > most - bounds.low { return usize.ONE }
  }
  return usize.MAX
}

// 1 when the unsigned ranges of `left` and `right` prove `left asked right`, 0 when they prove it
// does not hold, else `usize.MAX`: a bounds check against a constant that an earlier, tighter
// check or a mask already answers, and the range check of a conversion whose source fits.
fn decidedByRanges(state: &Numbering, function: &SsaFunction, asked: Predicate, left: u64, right: u64) -> usize {
  let kind = function.kindOf(left)
  if kind.isVector() || kind.bits > 64 || !(kind.isInteger() || kind.isAddress()) { return usize.MAX }
  if asked == Predicate.Slt || asked == Predicate.Sle || asked == Predicate.Sgt || asked == Predicate.Sge {
    if !kind.isInteger() || kind.bits < 2 { return usize.MAX }
    let lower = signedRangeOf(state, function, left, rangeDepth())
    let upper = signedRangeOf(state, function, right, rangeDepth())
    if lower.low > lower.high || upper.low > upper.high { return usize.MAX }
    if asked == Predicate.Slt {
      if lower.high < upper.low { return usize.ONE }
      if lower.low >= upper.high { return usize.ZERO }
    }
    if asked == Predicate.Sle {
      if lower.high <= upper.low { return usize.ONE }
      if lower.low > upper.high { return usize.ZERO }
    }
    if asked == Predicate.Sgt {
      if lower.low > upper.high { return usize.ONE }
      if lower.high <= upper.low { return usize.ZERO }
    }
    if asked == Predicate.Sge {
      if lower.low >= upper.high { return usize.ONE }
      if lower.high < upper.low { return usize.ZERO }
    }
    return usize.MAX
  }
  if asked != Predicate.Ult && asked != Predicate.Ule && asked != Predicate.Ugt && asked != Predicate.Uge && asked != Predicate.Eq
    && asked != Predicate.Ne { return usize.MAX }
  let first = rangeOf(state, function, left, rangeDepth())
  let second = rangeOf(state, function, right, rangeDepth())
  // An empty range comes of facts that contradict: the code is unreachable, and nothing is decided.
  if first.low > first.high || second.low > second.high { return usize.MAX }
  if asked == Predicate.Ult {
    if first.high < second.low { return usize.ONE }
    if first.low >= second.high { return usize.ZERO }
    return carryOf(state, function, left, right, second)
  }
  if asked == Predicate.Ule {
    if first.high <= second.low { return usize.ONE }
    if first.low > second.high { return usize.ZERO }
  }
  if asked == Predicate.Ugt {
    if first.low > second.high { return usize.ONE }
    if first.high <= second.low { return usize.ZERO }
    return carryOf(state, function, right, left, first)
  }
  if asked == Predicate.Uge {
    if first.low >= second.high { return usize.ONE }
    if first.high < second.low { return usize.ZERO }
  }
  let apart = first.high < second.low || second.high < first.low
  if asked == Predicate.Eq && apart { return usize.ZERO }
  if asked == Predicate.Ne && apart { return usize.ONE }
  return usize.MAX
}

// A tag per operation variant and its immediates, for the hash.
fn tagOf(operation: Operation) -> u64 {
  return match operation {
    Operation.Binary {..} => 1
    Operation.Negate => 2
    Operation.Compare {..} => 3
    Operation.Select => 4
    Operation.Cast {..} => 5
    Operation.Offset {offset} => u64.wrappingAdd(6, u64.wrappingMultiply(offset, 1099511628211))
    Operation.Index => 7
    Operation.SlotAddress {slot} => u64.wrappingAdd(8, u64.wrappingMultiply(usize.toU64(slot), 1099511628211))
    Operation.FrameAddress => 9
    Operation.Overflow {..} => 10
    Operation.Saturate {..} => 11
    Operation.Rotate {..} => 12
    Operation.Count {..} => 13
    Operation.Extreme {..} => 14
    Operation.FusedMultiplyAdd => 15
    Operation.SquareRoot => 16
    Operation.Reduce {..} => 17
    Operation.Shuffle {..} => 18
    Operation.Extract => 19
    Operation.Insert => 20
    Operation.Splat {..} => 21
    _ => 22
  }
}

fn hashOf(function: &SsaFunction, instruction: usize) -> u64 {
  let found = function.instruction(instruction)
  let mut hash = u64.wrappingMultiply(tagOf(found.operation), 11400714819323198485)
  hash = u64.wrappingMultiply(u64.bitXor(hash, usize.toU64(found.kind.bits * 131 + found.kind.elements)), 1099511628211)
  let operands = function.operandsOf(instruction)
  let mut at = usize.ZERO
  while at < operands.length {
    hash = u64.wrappingMultiply(u64.bitXor(hash, operands[at]), 11400714819323198485)
    at = at + usize.ONE
  }
  return u64.bitXor(hash, u64.shiftRight(hash, 29))
}

// Whether two pure instructions compute the same results: one operation with the same
// immediates, one kind, and the same operands.
fn equal(function: &SsaFunction, first: usize, second: usize) -> bool {
  let a = function.instruction(first)
  let b = function.instruction(second)
  if !a.kind.equals(b.kind) || !sameOperation(a.operation, b.operation) { return false }
  let left = function.operandsOf(first)
  let right = function.operandsOf(second)
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn sameOperation(first: Operation, second: Operation) -> bool {
  match first {
    Operation.Binary {operation} => { if let Operation.Binary {operation: other} = second { return operation == other } }
    Operation.Negate => { if let Operation.Negate = second { return true } }
    Operation.Compare {predicate} => { if let Operation.Compare {predicate: other} = second { return predicate == other } }
    Operation.Select => { if let Operation.Select = second { return true } }
    Operation.Cast {operation} => { if let Operation.Cast {operation: other} = second { return operation == other } }
    Operation.Offset {offset} => { if let Operation.Offset {offset: other} = second { return offset == other } }
    Operation.Index => { if let Operation.Index = second { return true } }
    Operation.SlotAddress {slot} => { if let Operation.SlotAddress {slot: other} = second { return slot == other } }
    Operation.FrameAddress => { if let Operation.FrameAddress = second { return true } }
    Operation.Overflow {operation, signed} => { if let Operation.Overflow {operation: other, signed: otherSigned} = second { return operation == other && signed == otherSigned } }
    Operation.Saturate {operation, signed} => { if let Operation.Saturate {operation: other, signed: otherSigned} = second { return operation == other && signed == otherSigned } }
    Operation.Rotate {left} => { if let Operation.Rotate {left: other} = second { return left == other } }
    Operation.Count {which} => { if let Operation.Count {which: other} = second { return which == other } }
    Operation.Extreme {which} => { if let Operation.Extreme {which: other} = second { return which == other } }
    Operation.FusedMultiplyAdd => { if let Operation.FusedMultiplyAdd = second { return true } }
    Operation.SquareRoot => { if let Operation.SquareRoot = second { return true } }
    Operation.Reduce {which} => { if let Operation.Reduce {which: other} = second { return which == other } }
    Operation.Shuffle {start, count} => { if let Operation.Shuffle {start: otherStart, count: otherCount} = second { return start == otherStart && count == otherCount } }
    Operation.Extract => { if let Operation.Extract = second { return true } }
    Operation.Insert => { if let Operation.Insert = second { return true } }
    Operation.Splat {count} => { if let Operation.Splat {count: other} = second { return count == other } }
    _ => {}
  }
  return false
}
