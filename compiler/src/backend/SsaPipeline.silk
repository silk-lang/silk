//! The order the direct backends run their SSA passes in, from a lowered function to one ready
//! to emit.
//!
//! # When to use
//! Call [`prepare`] once on each finished `SsaFunction` a direct backend lowered, before its
//! emitter reads it.
//!
//! # Details
//! An unoptimized build ([`Level.None`]) promotes the builder's variables and non-escaping
//! unmarked whole-slot scalar and vector stack slots (`SsaPromotion.promoteScalars`), packing
//! sparse functions afterward, without running dead code elimination or scalar optimization
//! rounds, so its code follows the lowering. An optimized build runs:
//!
//! 1. `SsaMemory.expandCopies`: small fixed-size copies and fills become loads and stores, field
//!    by field where a slot's other accesses name the fields, so the next step can promote the
//!    slots they touch.
//! 2. `SsaPromotion.promote` of every slot only loaded and stored.
//! 3. Up to [`rounds`] rounds, until one changes nothing, of: control flow simplification
//!    (`SsaControlFlow`), which merges the blocks the lowering split at every call and check;
//!    jump threading (`SsaThreading`), which sends each path that knows what a joined test will
//!    find straight to that side; store-to-load forwarding and dead store removal (`SsaMemory`); value numbering with folding
//!    and check elimination (`SsaValueNumbering`); and dead code elimination (`SsaDeadCode`).
//!    Forwarding comes before numbering so a reloaded length or bound becomes the value a check
//!    compares; numbering comes before the next round's control flow pass, which folds the
//!    branches it decided and so drops their trap paths. A round starts by renumbering the
//!    function densely (`SsaFunction.pack`) when most of its instruction numbers name nothing
//!    any more, as after promotion, so each pass costs what the function still holds.
//! 4. Step 2 again, and step 3 after it when it promoted anything: a slot whose address was
//!    itself held in a slot, as the `self` of a spliced method is, is promotable only once the
//!    rounds have turned that held address into a value.
//! 5. Loop idiom recognition (`SsaIdioms`): a loop that sets or copies one byte each time round
//!    becomes one fill, or gets one copy put before it; followed by step 3 again when it changed
//!    anything.
//! 6. At [`Level.Speed`], unrolling of loops that run a small known number of times
//!    (`SsaUnroll`) and loop-invariant code motion (`SsaLoops`), each followed by step 3 again
//!    when it changed anything. Unrolling is first followed by step 2 again: an array a loop
//!    indexed is indexed by constants once the loop is unrolled. Unrolling repeats within one
//!    per-function loop budget while folding exposes further constant bounds. When `packBytes`
//!    is true (targets without native 128-bit SIMD such as WebAssembly), `SsaPackedBytes.lower`
//!    also lowers closed 16-byte vector byte-classification graphs into 64-bit scalar SWAR ops.
//!
//! [`Level.Size`] differs from `Speed` in two ways, both code size against time: copies are
//! expanded only up to 8 bytes, where a load and a store are no bigger than a `memory.copy`, and
//! loops get no preheaders or hoisting. Every pass is a function of the one function it reads, so
//! the result depends only on that function. With `verify`, the function is checked after every
//! pass (`SsaVerification.verify`) and the report names the pass.

import backend.SsaControlFlow
import backend.SsaDeadCode
import backend.SsaFunction {SsaFunction}
import backend.SsaIdioms
import backend.SsaInduction
import backend.SsaLoops
import backend.SsaUnroll
import backend.SsaMemory
import backend.SsaPromotion
import backend.SsaPackedBytes
import backend.SsaThreading
import backend.SsaValueNumbering
import backend.SsaVerification
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize

/// How hard a build optimizes.
pub enum Level {
  /// No optimization: promotes builder variables and non-escaping unmarked whole-slot scalar and vector stack slots without running optimization rounds.
  None,
  /// For speed: every pass, with copies expanded up to 64 bytes and loop-invariant code motion.
  Speed,
  /// For size: every pass that does not grow code.
  Size,
}

/// The most rounds of the scalar passes one [`prepare`] runs.
pub fn rounds() -> usize { return 4 }

/// The largest copy or fill, in bytes, a build at `level` turns into loads and stores.
pub fn copyLimit(level: Level) -> u64 {
  if level == Level.Speed { return 64 }
  return 8
}

/// Runs the SSA optimization passes of `level` on `function`, which `SsaFunction.finish`
/// finished, verifying the function after each pass when `verify` is true.
///
/// # Details
///
/// When `level == Level.Speed` and `packBytes` is true (targets without native 128-bit SIMD
/// such as WebAssembly), runs `SsaPackedBytes.lower` to replace closed 16-byte vector
/// byte-classification expressions with 64-bit scalar SWAR operations. When `packBytes` is
/// false (native x86-64 SSE2 and AArch64 NEON targets), skips `SsaPackedBytes.lower` so
/// 16-byte vector operations stay intact for hardware SIMD emission.
pub effect fn prepare(function: &mut SsaFunction, level: Level, packBytes: bool, verify: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  if level == Level.None {
    run SsaPromotion.promoteScalars(&mut function.*)
    if verify { run SsaVerification.verify(&function.*, b"promotion") }
    if sparse(&function.*) {
      run function.pack()
      if verify { run SsaVerification.verify(&function.*, b"packing") }
    }
    return ()
  }
  drop run SsaMemory.expandCopies(&mut function.*, copyLimit(level))
  if verify { run SsaVerification.verify(&function.*, b"copy expansion") }
  run SsaPromotion.promote(&mut function.*, true)
  if verify { run SsaVerification.verify(&function.*, b"promotion") }
  run scalarRounds(&mut function.*, verify)
  // A slot whose address was itself held in a slot, as a spliced method's `self` is, looked
  // stored the first time; the rounds have put the address where each access reads it.
  let held = function.heldCount()
  run SsaPromotion.promote(&mut function.*, true)
  if verify { run SsaVerification.verify(&function.*, b"second promotion") }
  if function.heldCount() != held { run scalarRounds(&mut function.*, verify) }
  if run SsaIdioms.recognize(&mut function.*) {
    if verify { run SsaVerification.verify(&function.*, b"loop idiom recognition") }
    run scalarRounds(&mut function.*, verify)
  }
  if level == Level.Speed {
    let mut budget = SsaUnroll.loops()
    while budget > usize.ZERO {
      let unrolled = run SsaUnroll.unroll(&mut function.*, budget)
      if unrolled == usize.ZERO { break }
      budget = budget - unrolled
      if verify { run SsaVerification.verify(&function.*, b"loop unrolling") }
      // The copies have constant indices. Folding can also expose a constant bound for
      // a nested loop, which the next batch can unroll within the same budget.
      run SsaPromotion.promote(&mut function.*, true)
      if verify { run SsaVerification.verify(&function.*, b"promotion after unrolling") }
      run scalarRounds(&mut function.*, verify)
    }
    if run SsaLoops.hoist(&mut function.*) {
      if verify { run SsaVerification.verify(&function.*, b"loop-invariant code motion") }
      run scalarRounds(&mut function.*, verify)
    }
    if run SsaMemory.shareIndices(&mut function.*) {
      if verify { run SsaVerification.verify(&function.*, b"indexed address sharing") }
      run scalarRounds(&mut function.*, verify)
    }
    if run SsaLoops.factorIndices(&mut function.*) {
      if verify { run SsaVerification.verify(&function.*, b"loop address factoring") }
      run scalarRounds(&mut function.*, verify)
    }
    if run SsaInduction.scaleCounters(&mut function.*) {
      if verify { run SsaVerification.verify(&function.*, b"scaled loop counters") }
    }
    if packBytes && run SsaPackedBytes.lower(&mut function.*) {
      if verify { run SsaVerification.verify(&function.*, b"packed byte masks") }
      run scalarRounds(&mut function.*, verify)
    }
    if run SsaUnroll.pairIterations(&mut function.*) {
      if verify { run SsaVerification.verify(&function.*, b"paired loop iterations") }
      run scalarRounds(&mut function.*, verify)
    }
    if run SsaInduction.rotate(&mut function.*) {
      if verify { run SsaVerification.verify(&function.*, b"counted loop rotation") }
      run scalarRounds(&mut function.*, verify)
    }
  }
  if run SsaMemory.packStores(&mut function.*) {
    drop run SsaDeadCode.eliminate(&mut function.*)
    if verify { run SsaVerification.verify(&function.*, b"packed constant stores") }
  }
  return ()
}

// Whether most of `function`'s instruction numbers name nothing its blocks hold, so that the
// passes' tables, sized by those numbers, are mostly waste (`SsaFunction.pack`).
fn sparse(function: &SsaFunction) -> bool {
  return function.instructionCount() > function.heldCount() * 2 + 256
}

effect fn scalarRounds(function: &mut SsaFunction, verify: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut round = usize.ZERO
  let mut settled = false
  while round < rounds() {
    if sparse(&function.*) {
      run function.pack()
      if verify { run SsaVerification.verify(&function.*, b"packing") }
    }
    let mut changed = run SsaControlFlow.simplify(&mut function.*)
    if verify { run SsaVerification.verify(&function.*, b"control flow simplification") }
    if run SsaThreading.thread(&mut function.*) { changed = true }
    if verify { run SsaVerification.verify(&function.*, b"jump threading") }
    if run SsaMemory.forward(&mut function.*) { changed = true }
    if verify { run SsaVerification.verify(&function.*, b"load forwarding") }
    if run SsaValueNumbering.number(&mut function.*) { changed = true }
    if verify { run SsaVerification.verify(&function.*, b"value numbering") }
    if run SsaDeadCode.eliminate(&mut function.*) { changed = true }
    if verify { run SsaVerification.verify(&function.*, b"dead code elimination") }
    if !changed {
      settled = true
      break
    }
    round = round + usize.ONE
  }
  // A round that changed nothing left nothing to simplify.
  if settled { return () }
  // The branches the last numbering decided.
  drop run SsaControlFlow.simplify(&mut function.*)
  if verify { run SsaVerification.verify(&function.*, b"control flow simplification") }
  return ()
}
