//! The order the direct backends run their SSA passes in, from a lowered function to one ready
//! to emit.
//!
//! # When to use
//! Call [`prepare`] once on each finished `SsaFunction` a direct backend lowered, before its
//! emitter reads it.
//!
//! # Details
//! An unoptimized build ([`Level.None`]) only promotes the builder's variables
//! (`SsaPromotion.promote`), so its code follows the lowering. An optimized build runs:
//!
//! 1. `SsaMemory.expandCopies`: small fixed-size copies and fills become loads and stores, field
//!    by field where a slot's other accesses name the fields, so the next step can promote the
//!    slots they touch.
//! 2. `SsaPromotion.promote` of every slot only loaded and stored.
//! 3. Up to [`rounds`] rounds, until one changes nothing, of: control flow simplification
//!    (`SsaControlFlow`), which merges the blocks the lowering split at every call and check;
//!    store-to-load forwarding and dead store removal (`SsaMemory`); value numbering with folding
//!    and check elimination (`SsaValueNumbering`); and dead code elimination (`SsaDeadCode`).
//!    Forwarding comes before numbering so a reloaded length or bound becomes the value a check
//!    compares; numbering comes before the next round's control flow pass, which folds the
//!    branches it decided and so drops their trap paths.
//! 4. At [`Level.Speed`], loop-invariant code motion (`SsaLoops`), then one more round of step 3.
//!
//! [`Level.Size`] differs from `Speed` in two ways, both code size against time: copies are
//! expanded only up to 8 bytes, where a load and a store are no bigger than a `memory.copy`, and
//! loops get no preheaders or hoisting. Every pass is a function of the one function it reads, so
//! the result depends only on that function. With `verify`, the function is checked after every
//! pass (`SsaVerification.verify`) and the report names the pass.

import backend.SsaControlFlow
import backend.SsaDeadCode
import backend.SsaFunction {SsaFunction}
import backend.SsaLoops
import backend.SsaMemory
import backend.SsaPromotion
import backend.SsaValueNumbering
import backend.SsaVerification
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize

/// How hard a build optimizes.
pub enum Level {
  /// No optimization: only the builder's variables become values.
  None,
  /// For speed: every pass, with copies expanded up to 64 bytes and loop-invariant code motion.
  Speed,
  /// For size: every pass that does not grow code.
  Size,
}

/// The most rounds of the scalar passes one [`prepare`] runs.
pub fn rounds() -> usize { return 4 }

/// The largest copy or fill, in bytes, a build at `level` turns into loads and stores.
pub fn copyLimit(level: Level) -> u64 {
  if level == Level.Speed { return 64 }
  return 8
}

/// Runs the passes of `level` on `function`, which `SsaFunction.finish` finished, checking it
/// after each when `verify`.
pub effect fn prepare(function: &mut SsaFunction, level: Level, verify: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  if level == Level.None {
    run SsaPromotion.promote(&mut function.*, false)
    if verify { run SsaVerification.verify(&function.*, b"promotion") }
    return ()
  }
  drop run SsaMemory.expandCopies(&mut function.*, copyLimit(level))
  if verify { run SsaVerification.verify(&function.*, b"copy expansion") }
  run SsaPromotion.promote(&mut function.*, true)
  if verify { run SsaVerification.verify(&function.*, b"promotion") }
  run scalarRounds(&mut function.*, verify)
  if level == Level.Speed {
    if run SsaLoops.hoist(&mut function.*) {
      if verify { run SsaVerification.verify(&function.*, b"loop-invariant code motion") }
      run scalarRounds(&mut function.*, verify)
    }
  }
  return ()
}

effect fn scalarRounds(function: &mut SsaFunction, verify: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut round = usize.ZERO
  while round < rounds() {
    let mut changed = run SsaControlFlow.simplify(&mut function.*)
    if verify { run SsaVerification.verify(&function.*, b"control flow simplification") }
    if run SsaMemory.forward(&mut function.*) { changed = true }
    if verify { run SsaVerification.verify(&function.*, b"load forwarding") }
    if run SsaValueNumbering.number(&mut function.*) { changed = true }
    if verify { run SsaVerification.verify(&function.*, b"value numbering") }
    if run SsaDeadCode.eliminate(&mut function.*) { changed = true }
    if verify { run SsaVerification.verify(&function.*, b"dead code elimination") }
    if !changed { break }
    round = round + usize.ONE
  }
  // The branches the last numbering decided.
  drop run SsaControlFlow.simplify(&mut function.*)
  if verify { run SsaVerification.verify(&function.*, b"control flow simplification") }
  return ()
}
