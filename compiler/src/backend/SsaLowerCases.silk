//! Target-neutral MIR to SSA lowering checks on `x86_64-unknown-linux-gnu`,
//! `aarch64-apple-darwin`, `aarch64-unknown-linux-gnu`, and `wasm32-unknown-unknown`: native
//! 2-register C returns and calls, Darwin ARM64 ABI (`AbiExtension`, HFA/HVA `groupRemaining`
//! and `stackAlignment`, `sret`, variadics), validated native inline assembly, x86-64 and
//! AArch64 architecture intrinsics, `StackLifetimes` slot markers, and ELF/Mach-O frame helpers.

import backend.CAbi
import backend.CAbi {Extension as CExtension, Lane as CLane, Passing as CPassing, Piece as CPiece, Signature as CSignature, VariadicArgument}
import backend.Coroutine {Facts}
import backend.Gap {Gap, Source as GapSource}
import backend.InstanceIdentity {InstanceIdentity}
import backend.InstanceKey {InstanceKey}
import backend.Layout {Abi, Field as LayoutField, Layout, Metrics, Storage, TypeLayout}
import backend.Mir {
  AssemblyFragment,
  Block,
  Callee,
  Cancel,
  ContextText,
  Diagnostics,
  ErasureFact,
  EscapeSite,
  FailureEdge,
  Inlining,
  Local,
  LocalKind,
  MirFunction,
  NonParkingRun,
  Operand,
  Place,
  Projection,
  Reference,
  Rvalue,
  SharedAccess,
  Statement,
  Terminator,
  TrapSite,
  Variable,
 CallTerminator, CallBox}
import backend.SsaFunction {
  AbiExtension,
  ArchOperation,
  CallingConvention,
  Cast,
  Kind,
  Operation,
  SsaFunction,
  none,
}
import backend.SsaLower
import backend.SsaLower {Lowered, LoweredFunction, Unsupported}
import backend.SsaPipeline {Level}
import backend.SsaVerification
import backend.SsaVerification {Violation}
import backend.TypeLayouts {TypeLayouts}
import hir.Hir {Access, Multiplicity, OwnerKind}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.ForeignContract {ForeignContract}
import semantic.Intrinsic {Primitive as IntrinsicPrimitive}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.NativeAssembly {Memory as AssemblyMemory}
import semantic.SourceLocations {Location}
import semantic.Target {Id as TargetId, Target}
import semantic.Type {Argument, Type}
import semantic.TypedBody {BorrowStatus, Origin}
import semantic.Types {TypeTable, Types}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.box {Box}
import silk.mem.interned {Interned}
import silk.concurrency.sync {Arc}
import silk.num.usize
import silk.testing.testing {AssertionError, Testing}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn origin0() -> Origin {
  return Origin {node: usize.ZERO, location: Location.make(usize.ZERO, usize.ZERO)}
}

fn placeOf(local: usize) -> Place {
  return Place {local: local, projections: List<Projection>.make()}
}

effect fn declId(name: &[u8]) -> Interned<DeclarationId> ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let module = run ModuleId.make(b"test", b"test", b"test")
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Function, name: Option<Bytes>.some(run Bytes.copy(name)), occurrence: usize.ZERO})
  let id = run DeclarationId.fromParts(move module, move owners)
  return run Interned<DeclarationId>.make(move id)
}

effect fn structDeclId(name: &[u8]) -> DeclarationId ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let module = run ModuleId.make(b"test", b"test", b"test")
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Struct, name: Option<Bytes>.some(run Bytes.copy(name)), occurrence: usize.ZERO})
  return run DeclarationId.fromParts(move module, move owners)
}

effect fn primitiveType(name: &[u8]) -> Interned<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run Types.intern(Type.Primitive {name: run Bytes.copy(name)})
}

effect fn vectorType(element: &[u8], lanes: usize) -> Interned<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let elem = run primitiveType(element)
  return run Types.intern(Type.Vector {element: move elem, lanes: run Type.extentText(lanes)})
}

effect fn pointerType(pointee: &Interned<Type>) -> Interned<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run Types.intern(Type.Pointer {
    pointee: Interned<Type>.clone(pointee),
    access: Access.Mutable,
    nullable: true,
    multiplicity: Multiplicity.Single,
    alignment: Option<u64>.none(),
  })
}

effect fn scalarLayout(ty: &Interned<Type>, size: usize, alignment: usize, abi: Abi) -> TypeLayout ! OutOfMemoryError ? &mut Allocator {
  return TypeLayout {
    ty: Interned<Type>.clone(ty),
    layout: run Interned<Layout>.make(Layout {size: size, alignment: alignment, abi: abi, storage: Storage.Scalar, head: usize.ZERO}),
  }
}

effect fn pair16TypeAndLayouts() -> PairSetup ! InvalidModulePath | OutOfMemoryError ? &mut Allocator | &mut Types {
  let i64Ty = run primitiveType(b"i64")
  let f64Ty = run primitiveType(b"f64")
  let id = run structDeclId(b"Pair16")
  let pairTy = run Types.intern(Type.Nominal {declaration: move id, isPublic: true, arguments: List<Argument>.make()})
  let mut fields = List<LayoutField>.make()
  run List<LayoutField>.append(&mut fields, LayoutField {ty: Interned<Type>.clone(&i64Ty), offset: usize.ZERO})
  run List<LayoutField>.append(&mut fields, LayoutField {ty: Interned<Type>.clone(&f64Ty), offset: 8})
  let mut layouts = List<TypeLayout>.make()
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&i64Ty, 8, 8, Abi.Integer))
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&f64Ty, 8, 8, Abi.Floating))
  run List<TypeLayout>.append(
    &mut layouts,
    TypeLayout {
      ty: Interned<Type>.clone(&pairTy),
      layout: run Interned<Layout>.make(Layout {
        size: 16,
        alignment: 8,
        abi: Abi.Indirect,
        storage: Storage.Record {fields: move fields},
        head: usize.ZERO,
      }),
    },
  )
  return PairSetup {i64Ty: move i64Ty, f64Ty: move f64Ty, pairTy: move pairTy, layouts: move layouts}
}

struct PairSetup {
  i64Ty: Interned<Type>,
  f64Ty: Interned<Type>,
  pairTy: Interned<Type>,
  layouts: List<TypeLayout>,
}

effect fn makeMir(
  key: InstanceKey,
  result: Interned<Type>,
  parameters: List<Interned<Type>>,
  locals: List<Local>,
  blocks: List<Block>,
  variadic: bool,
) -> MirFunction ! OutOfMemoryError ? &mut Allocator {
  return MirFunction {
    key: move key,
    borrow: BorrowStatus.Checked,
    result: move result,
    parameters: move parameters,
    locals: move locals,
    blocks: move blocks,
    references: List<Reference>.make(),
    externs: List<Interned<DeclarationId>>.make(),
    observes: false,
    contexts: List<ContextText>.make(),
    traps: List<TrapSite>.make(),
    suspension: Option<Origin>.none(),
    parks: Option<Origin>.none(),
    releasesPackages: false,
    nonParking: List<NonParkingRun>.make(),
    cancels: List<Cancel>.make(),
    accesses: List<SharedAccess>.make(),
    escapes: List<EscapeSite>.make(),
    erasures: List<ErasureFact>.make(),
    features: Bytes.make(),
    pureCallBlocks: List<usize>.make(),
    inlining: Inlining.Default,
    optimizeSize: false,
    variadic: variadic,
    frame: Bytes.make(),
    lines: List<u64>.make(),
    variables: List<Variable>.make(),
    inlined: List<InstanceKey>.make(),
    quiet: List<InstanceKey>.make(),
  }
}

fn findFunction(lowered: &Lowered, name: &[u8]) -> usize {
  let listed = List<LoweredFunction>.asSlice(&lowered.functions)
  let mut at = usize.ZERO
  while at < listed.length {
    if same(listed[at].function.name(), name) { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn callsSymbol(function: &SsaFunction, symbol: &[u8]) -> bool {
  let mut block = usize.ZERO
  while block < function.blockCount() {
    let listed = List<usize>.asSlice(&function.block(block).instructions)
    let mut at = usize.ZERO
    while at < listed.length {
      let inst = function.instruction(listed[at])
      if let Operation.Call {symbol: sym, ..} = inst.operation {
        if same(function.symbolName(sym), symbol) { return true }
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  return false
}

fn hasSymbol(function: &SsaFunction, symbol: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < function.symbolCount() {
    if same(function.symbolName(at), symbol) { return true }
    at = at + usize.ONE
  }
  return false
}

fn hasWeakObject(lowered: &Lowered, symbol: &[u8]) -> bool {
  let weak = List<Bytes>.asSlice(&lowered.weakObjects)
  let mut at = usize.ZERO
  while at < weak.length {
    if same(Bytes.asSlice(&weak[at]), symbol) { return true }
    at = at + usize.ONE
  }
  return false
}

fn countOperationKind(function: &SsaFunction, tag: usize) -> usize {
  let mut total = usize.ZERO
  let mut block = usize.ZERO
  while block < function.blockCount() {
    let listed = List<usize>.asSlice(&function.block(block).instructions)
    let mut at = usize.ZERO
    while at < listed.length {
      let inst = function.instruction(listed[at])
      let hit = match inst.operation {
        Operation.InlineAsm {..} => tag == 1
        Operation.ArchIntrinsic {..} => tag == 2
        Operation.VaStart => tag == 3
        Operation.VaEnd => tag == 4
        Operation.SlotStart {..} => tag == 5
        Operation.SlotEnd {..} => tag == 6
        Operation.Call {..} => tag == 7 && !inst.secondKind.isUnit()
        _ => false
      }
      if hit { total = total + usize.ONE }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  return total
}

test effect fn declarationsEmitsNativeUnwindAndWasmStepWalk() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run declarationsClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn declarationsClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let x86 = Target.forId(TargetId.X8664UnknownLinuxGnu)
  let wasm = Target.forId(TargetId.Wasm32UnknownUnknown)
  let nativeLowered = match move run Effect.result(SsaLower.declarations(&x86, false, true, true)) {
    Result<Lowered, Unsupported | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => {
        run Testing.expect(false, "native x86-64 declarations should not fail")
        return ()
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let fatalIdx = findFunction(&nativeLowered, b"silk.diagnostic.fatal")
  let frameIdx = findFunction(&nativeLowered, b"silk.diagnostic.frame")
  let reclaimIdx = findFunction(&nativeLowered, b"__silk_guarded_reclaim")
  run Testing.expect(fatalIdx != usize.MAX, "native declarations define silk.diagnostic.fatal")
  run Testing.expect(frameIdx != usize.MAX, "native declarations define silk.diagnostic.frame")
  run Testing.expect(reclaimIdx != usize.MAX, "native declarations define __silk_guarded_reclaim")
  let listed = List<LoweredFunction>.asSlice(&nativeLowered.functions)
  let fatalFn = &listed[fatalIdx].function
  let frameFn = &listed[frameIdx].function
  let x86NameIdx = findFunction(&nativeLowered, b"silk.diagnostic.name")
  run Testing.expect(x86NameIdx != usize.MAX, "native declarations define silk.diagnostic.name")
  let x86NameFn = &listed[x86NameIdx].function
  run Testing.expect(hasSymbol(x86NameFn, b"__start_silk_frames") && hasSymbol(x86NameFn, b"__stop_silk_frames"),
    "ELF declarations reference __start_silk_frames and __stop_silk_frames")
  run Testing.expect(callsSymbol(fatalFn, b"_Unwind_Backtrace"), "native fatal dispatch calls _Unwind_Backtrace")
  run Testing.expect(frameFn.callingConvention == CallingConvention.C, "silk.diagnostic.frame uses C calling convention")
  run Testing.expect(callsSymbol(frameFn, b"_Unwind_GetRegionStart"), "silk.diagnostic.frame calls _Unwind_GetRegionStart")
  run Testing.expect(!Option<Violation>.isSome(&(run SsaVerification.check(fatalFn))), "native fatal dispatch verifies")
  run Testing.expect(!Option<Violation>.isSome(&(run SsaVerification.check(frameFn))), "native frame callback verifies")

  let darwin = Target.forId(TargetId.Aarch64AppleDarwin)
  let darwinLowered = match move run Effect.result(SsaLower.declarations(&darwin, false, true, true)) {
    Result<Lowered, Unsupported | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => {
        run Testing.expect(false, "darwin arm64 declarations should not fail")
        return ()
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let darwinNameIdx = findFunction(&darwinLowered, b"silk.diagnostic.name")
  run Testing.expect(darwinNameIdx != usize.MAX, "darwin declarations define silk.diagnostic.name")
  let darwinNameFn = &List<LoweredFunction>.asSlice(&darwinLowered.functions)[darwinNameIdx].function
  run Testing.expect(
    hasWeakObject(&darwinLowered, b"\x01section$start$__DATA$__silk_frames")
      && hasWeakObject(&darwinLowered, b"\x01section$end$__DATA$__silk_frames"),
    "Mach-O declarations mark section$start/end$__DATA$__silk_frames as weak objects")
  run Testing.expect(
    hasSymbol(darwinNameFn, b"\x01section$start$__DATA$__silk_frames")
      && hasSymbol(darwinNameFn, b"\x01section$end$__DATA$__silk_frames"),
    "Mach-O silk.diagnostic.name references \\x01section$start/end$__DATA$__silk_frames")
  run Testing.expect(!Option<Violation>.isSome(&(run SsaVerification.check(darwinNameFn))), "darwin frame lookup verifies")

  let wasmLowered = match move run Effect.result(SsaLower.declarations(&wasm, false, true, true)) {
    Result<Lowered, Unsupported | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => {
        run Testing.expect(false, "wasm declarations should not fail")
        return ()
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let wasmFatalIdx = findFunction(&wasmLowered, b"silk.diagnostic.fatal")
  run Testing.expect(wasmFatalIdx != usize.MAX, "wasm declarations define silk.diagnostic.fatal")
  run Testing.expect(findFunction(&wasmLowered, b"silk.diagnostic.frame") == usize.MAX, "wasm declarations omit native silk.diagnostic.frame")
  let wasmListed = List<LoweredFunction>.asSlice(&wasmLowered.functions)
  run Testing.expect(!callsSymbol(&wasmListed[wasmFatalIdx].function, b"_Unwind_Backtrace"), "wasm fatal dispatch walks step records without _Unwind_Backtrace")
}

test effect fn lowersTwoRegisterSysvCExportAndCCall() -> () ! InvalidModulePath | Gap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run sysvPairClaims()
    |> Effect.provideMut<Types>(&mut types)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sysvPairClaims() -> () ! InvalidModulePath | Gap | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let x86 = Target.forId(TargetId.X8664UnknownLinuxGnu)
  let wasm = Target.forId(TargetId.Wasm32UnknownUnknown)
  let setup = run pair16TypeAndLayouts()

  // Part A: C export returning 16-byte struct { i64, f64 } in two SysV registers (rax + xmm0).
  let exportId = run declId(b"make_pair_export")
  let exportKey = InstanceKey.Export {function: Interned<DeclarationId>.clone(&exportId), symbol: run Arc<Bytes>.make(run Bytes.copy(b"make_pair_export"))}
  let mut params = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut params, Interned<Type>.clone(&setup.i64Ty))
  run List<Interned<Type>>.append(&mut params, Interned<Type>.clone(&setup.f64Ty))
  let mut locals = List<Local>.make()
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&setup.pairTy), kind: LocalKind.Return, origin: origin0()})
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&setup.i64Ty), kind: LocalKind.Parameter {index: 0}, origin: origin0()})
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&setup.f64Ty), kind: LocalKind.Parameter {index: 1}, origin: origin0()})
  let mut f0Projs = List<Projection>.make()
  run List<Projection>.append(&mut f0Projs, Projection.Field {index: 0})
  let mut f1Projs = List<Projection>.make()
  run List<Projection>.append(&mut f1Projs, Projection.Field {index: 1})
  let mut stmts = List<Statement>.make()
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: Place {local: 0, projections: move f0Projs},
    value: Rvalue.Use {value: Operand.Copy {place: placeOf(1)}},
    origin: origin0(),
  })
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: Place {local: 0, projections: move f1Projs},
    value: Rvalue.Use {value: Operand.Copy {place: placeOf(2)}},
    origin: origin0(),
  })
  let mut blocks = List<Block>.make()
  run List<Block>.append(&mut blocks, Block {suspends: false, statements: move stmts, terminator: Terminator.Return {origin: origin0()}})
  let exportMir = run makeMir(InstanceKey.copy(&exportKey), Interned<Type>.clone(&setup.pairTy), move params, move locals, move blocks, false)
  let mut identities = List<InstanceIdentity>.make()
  run List<InstanceIdentity>.append(&mut identities, InstanceIdentity {key: InstanceKey.copy(&exportKey), symbol: run Bytes.copy(b"make_pair_export")})
  let noSuspension = Option<Facts>.none()

  let lowered = match move run Effect.result(SsaLower.lower(
    &exportMir, &x86, List<TypeLayout>.asSlice(&setup.layouts), &[], List<InstanceIdentity>.asSlice(&identities),
    &noSuspension, false, true, Level.Speed, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => {
        run Testing.expect(false, "x86-64 lowering of 2-register C struct export should succeed")
        return ()
      }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(List<LoweredFunction>.length(&lowered.functions) == usize.ONE, "one lowered C export function")
  let f = &List<LoweredFunction>.asSlice(&lowered.functions)[usize.ZERO].function
  run Testing.expect(f.callingConvention == CallingConvention.C, "C export records CallingConvention.C")
  run Testing.expect(f.result.equals(Kind.integer(64)) && f.secondResultKind.equals(Kind.float(64)),
    "16-byte { i64, f64 } SysV C export lowers to (i64, f64) pair return")
  run Testing.expect(f.block(usize.ZERO).value != none() && f.block(usize.ZERO).secondValue != none(),
    "C export returns both register lanes via retPair")

  // Verify Wasm still refuses a 2-register C struct return if classified as 2 coerced pieces,
  // or uses Indirect on Wasm (on wasm32 a 2-field struct is Indirect, so check cResultKinds refusal directly).
  let mut twoPieces = List<CPiece>.make()
  run List<CPiece>.append(&mut twoPieces, CPiece {offset: 0, abi: Abi.Integer, bits: 64, lanes: 0})
  run List<CPiece>.append(&mut twoPieces, CPiece {offset: 8, abi: Abi.Floating, bits: 64, lanes: 0})
  let coercedPairLane = CLane {
    ty: Interned<Type>.clone(&setup.pairTy),
    layout: Metrics {size: 16, alignment: 8, abi: Abi.Indirect, tagged: false, head: 0},
    extension: CExtension.None,
    passing: CPassing.Coerce,
    pieces: move twoPieces,
    grouped: false,
    byval: false,
    stackAlignment: 0,
  }
  let wasmRefused = match move run Effect.result(SsaLower.cResultKinds(&coercedPairLane, 32, false, b"pair")) {
    Result<SsaLower.ResultKinds, Unsupported | OutOfMemoryError>.Success {..} => false
    Result<SsaLower.ResultKinds, Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => true
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(wasmRefused, "Wasm target still refuses 2-register coerced C results")

  // Part B: Calling an extern "C" function returning 16-byte { i64, f64 } in two SysV registers.
  let externId = run declId(b"c_make_pair")
  let callerId = run declId(b"call_pair")
  let callerKey = run InstanceKey.named(&callerId)
  let mut extPieces = List<CPiece>.make()
  run List<CPiece>.append(&mut extPieces, CPiece {offset: 0, abi: Abi.Integer, bits: 64, lanes: 0})
  run List<CPiece>.append(&mut extPieces, CPiece {offset: 8, abi: Abi.Floating, bits: 64, lanes: 0})
  let mut extParams = List<CLane>.make()
  run List<CLane>.append(&mut extParams, CLane {
    ty: Interned<Type>.clone(&setup.i64Ty),
    layout: Metrics {size: 8, alignment: 8, abi: Abi.Integer, tagged: false, head: 0},
    extension: CExtension.None,
    passing: CPassing.Direct,
    pieces: List<CPiece>.make(),
    grouped: false,
    byval: false,
    stackAlignment: 0,
  })
  let extSig = CSignature {
    behavior: ForeignContract.conservative(),
    callbackContracts: Bytes.make(),
    declaration: Interned<DeclarationId>.clone(&externId),
    symbol: run Bytes.copy(b"c_make_pair"),
    importModule: Bytes.make(),
    importName: Bytes.make(),
    source: GapSource.Generated {declaration: Interned<DeclarationId>.clone(&externId)},
    result: CLane {
      ty: Interned<Type>.clone(&setup.pairTy),
      layout: Metrics {size: 16, alignment: 8, abi: Abi.Indirect, tagged: false, head: 0},
      extension: CExtension.None,
      passing: CPassing.Coerce,
      pieces: move extPieces,
      grouped: false,
      byval: false,
      stackAlignment: 0,
    },
    parameters: move extParams,
    variadic: false,
    global: false,
  }
  let mut foreign = List<CSignature>.make()
  run List<CSignature>.append(&mut foreign, move extSig)

  let mut callParams = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut callParams, Interned<Type>.clone(&setup.i64Ty))
  let mut callLocals = List<Local>.make()
  run List<Local>.append(&mut callLocals, Local {ty: Interned<Type>.clone(&setup.i64Ty), kind: LocalKind.Return, origin: origin0()})
  run List<Local>.append(&mut callLocals, Local {ty: Interned<Type>.clone(&setup.i64Ty), kind: LocalKind.Parameter {index: 0}, origin: origin0()})
  run List<Local>.append(&mut callLocals, Local {ty: Interned<Type>.clone(&setup.pairTy), kind: LocalKind.Temp, origin: origin0()})
  let mut callArgs = List<Operand>.make()
  run List<Operand>.append(&mut callArgs, Operand.Copy {place: placeOf(1)})
  let mut callBlocks = List<Block>.make()
  run List<Block>.append(&mut callBlocks, Block {
    suspends: false,
    statements: List<Statement>.make(),
    terminator: Terminator.Call {call: run CallBox.make(CallTerminator {
      callee: Callee.Extern {declaration: Interned<DeclarationId>.clone(&externId), variadicArguments: List<VariadicArgument>.make()},
      arguments: move callArgs,
      providers: List<Operand>.make(),
      diagnostics: Option<Diagnostics>.none(),
      destination: placeOf(2),
      normal: 1,
      failure: Option<FailureEdge>.none(),
      origin: origin0(),
    })},
  })
  let mut readF0 = List<Projection>.make()
  run List<Projection>.append(&mut readF0, Projection.Field {index: 0})
  let mut b1Stmts = List<Statement>.make()
  run List<Statement>.append(&mut b1Stmts, Statement.Assign {
    destination: placeOf(0),
    value: Rvalue.Use {value: Operand.Copy {place: Place {local: 2, projections: move readF0}}},
    origin: origin0(),
  })
  run List<Block>.append(&mut callBlocks, Block {suspends: false, statements: move b1Stmts, terminator: Terminator.Return {origin: origin0()}})
  let callMir = run makeMir(InstanceKey.copy(&callerKey), Interned<Type>.clone(&setup.i64Ty), move callParams, move callLocals, move callBlocks, false)
  let mut callIds = List<InstanceIdentity>.make()
  run List<InstanceIdentity>.append(&mut callIds, InstanceIdentity {key: InstanceKey.copy(&callerKey), symbol: run Bytes.copy(b"call_pair")})

  let callLowered = match move run Effect.result(SsaLower.lower(
    &callMir, &x86, List<TypeLayout>.asSlice(&setup.layouts), List<CSignature>.asSlice(&foreign),
    List<InstanceIdentity>.asSlice(&callIds), &noSuspension, false, false, Level.Speed, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => {
        run Testing.expect(false, "x86-64 lowering of 2-register C call should succeed")
        return ()
      }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let cf = &List<LoweredFunction>.asSlice(&callLowered.functions)[usize.ZERO].function
  run Testing.expect(countOperationKind(cf, 7) == usize.ONE, "extern C call returning 16-byte struct emits a 2-result Call instruction")
  run Testing.expect(cf.callAbiCount() == usize.ONE && cf.callAbi(0).callingConvention == CallingConvention.C,
    "extern C call attaches a CallingConvention.C CallAbi descriptor")
  // Also confirm Wasm target refuses lowering the 2-register coerced C call.
  let wasmCallRefused = match move run Effect.result(SsaLower.lower(
    &callMir, &wasm, List<TypeLayout>.asSlice(&setup.layouts), List<CSignature>.asSlice(&foreign),
    List<InstanceIdentity>.asSlice(&callIds), &noSuspension, false, false, Level.None, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {..} => false
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => true
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(wasmCallRefused, "Wasm lowering still refuses a 2-register coerced C call")
}

test effect fn lowersNativeInlineAsmAndX86ArchIntrinsics() -> () ! InvalidModulePath | Gap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run nativeAsmAndArchClaims()
    |> Effect.provideMut<Types>(&mut types)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nativeAsmAndArchClaims() -> () ! InvalidModulePath | Gap | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let x86 = Target.forId(TargetId.X8664UnknownLinuxGnu)
  let wasm = Target.forId(TargetId.Wasm32UnknownUnknown)
  let u64Ty = run primitiveType(b"u64")
  let v2u64 = run vectorType(b"u64", 2)
  let v4u32 = run vectorType(b"u32", 4)
  let mut layouts = List<TypeLayout>.make()
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&u64Ty, 8, 8, Abi.Integer))
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&v2u64, 16, 16, Abi.Vector))
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&v4u32, 16, 16, Abi.Vector))

  let fnId = run declId(b"native_asm_and_crypto")
  let fnKey = run InstanceKey.named(&fnId)
  let mut params = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut params, Interned<Type>.clone(&u64Ty))
  run List<Interned<Type>>.append(&mut params, Interned<Type>.clone(&v2u64))
  run List<Interned<Type>>.append(&mut params, Interned<Type>.clone(&v4u32))
  let mut locals = List<Local>.make()
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&u64Ty), kind: LocalKind.Return, origin: origin0()})
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&u64Ty), kind: LocalKind.Parameter {index: 0}, origin: origin0()})
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&v2u64), kind: LocalKind.Parameter {index: 1}, origin: origin0()})
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&v4u32), kind: LocalKind.Parameter {index: 2}, origin: origin0()})
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&v2u64), kind: LocalKind.Temp, origin: origin0()})
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&v4u32), kind: LocalKind.Temp, origin: origin0()})

  let mut aesArgs = List<Operand>.make()
  run List<Operand>.append(&mut aesArgs, Operand.Copy {place: placeOf(2)})
  run List<Operand>.append(&mut aesArgs, Operand.Copy {place: placeOf(2)})
  let mut shaArgs = List<Operand>.make()
  run List<Operand>.append(&mut shaArgs, Operand.Copy {place: placeOf(3)})
  run List<Operand>.append(&mut shaArgs, Operand.Copy {place: placeOf(3)})
  let mut asmInputs = List<Operand>.make()
  run List<Operand>.append(&mut asmInputs, Operand.Copy {place: placeOf(1)})
  let asmFrag = AssemblyFragment {
    template: run Bytes.copy(b"inc $0"),
    constraints: run Bytes.copy(b"=r,0"),
    clobbers: run Bytes.copy(b"flags"),
    memory: AssemblyMemory.None,
    sideEffects: true,
    noReturn: false,
    inputs: move asmInputs,
    ty: Interned<Type>.clone(&u64Ty),
  }

  let mut stmts = List<Statement>.make()
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(4),
    value: Rvalue.Vector {primitive: IntrinsicPrimitive.X86AesEncrypt, operands: move aesArgs, ty: Interned<Type>.clone(&v2u64)},
    origin: origin0(),
  })
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(5),
    value: Rvalue.Vector {primitive: IntrinsicPrimitive.X86Sha1Rounds4Stage2, operands: move shaArgs, ty: Interned<Type>.clone(&v4u32)},
    origin: origin0(),
  })
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(0),
    value: Rvalue.Assembly {fragment: run Box<AssemblyFragment>.make(move asmFrag)},
    origin: origin0(),
  })
  let mut blocks = List<Block>.make()
  run List<Block>.append(&mut blocks, Block {suspends: false, statements: move stmts, terminator: Terminator.Return {origin: origin0()}})
  let mir = run makeMir(InstanceKey.copy(&fnKey), Interned<Type>.clone(&u64Ty), move params, move locals, move blocks, false)
  let mut identities = List<InstanceIdentity>.make()
  run List<InstanceIdentity>.append(&mut identities, InstanceIdentity {key: InstanceKey.copy(&fnKey), symbol: run Bytes.copy(b"native_asm_and_crypto")})
  let noSuspension = Option<Facts>.none()

  // Lower at Level.None so unused AES/SHA results stay visible and verified.
  let lowered = match move run Effect.result(SsaLower.lower(
    &mir, &x86, List<TypeLayout>.asSlice(&layouts), &[], List<InstanceIdentity>.asSlice(&identities),
    &noSuspension, false, false, Level.None, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => {
        run Testing.expect(false, "x86-64 lowering of native inline asm + arch intrinsics should succeed")
        return ()
      }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let f = &List<LoweredFunction>.asSlice(&lowered.functions)[usize.ZERO].function
  run Testing.expect(countOperationKind(f, 1) == usize.ONE && f.asmCount() == usize.ONE,
    "native inline assembly lowers to one Operation.InlineAsm entry")
  run Testing.expect(same(Bytes.asSlice(&f.asm(0).template), b"inc $0"), "inline assembly template is preserved")
  run Testing.expect(countOperationKind(f, 2) == 2, "both x86 arch intrinsics lower to Operation.ArchIntrinsic")

  let mut sawShaStage2 = false
  let mut sawAes = false
  let listed = List<usize>.asSlice(&f.block(usize.ZERO).instructions)
  let mut at = usize.ZERO
  while at < listed.length {
    if let Operation.ArchIntrinsic {operation, immediate} = f.instruction(listed[at]).operation {
      if operation == ArchOperation.X86AesEncrypt { sawAes = true }
      if operation == ArchOperation.X86Sha1Rounds4 && immediate == 2 { sawShaStage2 = true }
    }
    at = at + usize.ONE
  }
  run Testing.expect(sawAes && sawShaStage2, "AES-NI and SHA1 stage-2 immediate are preserved accurately")

  let wasmRefused = match move run Effect.result(SsaLower.lower(
    &mir, &wasm, List<TypeLayout>.asSlice(&layouts), &[], List<InstanceIdentity>.asSlice(&identities),
    &noSuspension, false, false, Level.None, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {..} => false
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => true
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(wasmRefused, "Wasm lowering still refuses x86 arch intrinsics and result-bearing inline asm")
}

test effect fn lowersVariadicCExportAndVaListBody() -> () ! InvalidModulePath | Gap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run variadicClaims()
    |> Effect.provideMut<Types>(&mut types)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn variadicClaims() -> () ! InvalidModulePath | Gap | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let x86 = Target.forId(TargetId.X8664UnknownLinuxGnu)
  let wasm = Target.forId(TargetId.Wasm32UnknownUnknown)
  let i64Ty = run primitiveType(b"i64")
  let u8Ty = run primitiveType(b"u8")
  let ptrTy = run pointerType(&u8Ty)
  let mut layouts = List<TypeLayout>.make()
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&i64Ty, 8, 8, Abi.Integer))
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&u8Ty, 1, 1, Abi.Integer))
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&ptrTy, 8, 8, Abi.Pointer))

  let bodyId = run declId(b"varargs_body")
  let bodyKey = run InstanceKey.named(&bodyId)
  let entryKey = InstanceKey.Export {function: Interned<DeclarationId>.clone(&bodyId), symbol: run Arc<Bytes>.make(run Bytes.copy(b"varargs_c_entry"))}
  let mut identities = List<InstanceIdentity>.make()
  run List<InstanceIdentity>.append(&mut identities, InstanceIdentity {key: InstanceKey.copy(&bodyKey), symbol: run Bytes.copy(b"varargs_body")})
  run List<InstanceIdentity>.append(&mut identities, InstanceIdentity {key: InstanceKey.copy(&entryKey), symbol: run Bytes.copy(b"varargs_c_entry")})
  let noSuspension = Option<Facts>.none()

  // Variadic C entry: calls body (forwarding va_list) and returns i64.
  let mut entryParams = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut entryParams, Interned<Type>.clone(&i64Ty))
  let mut entryLocals = List<Local>.make()
  run List<Local>.append(&mut entryLocals, Local {ty: Interned<Type>.clone(&i64Ty), kind: LocalKind.Return, origin: origin0()})
  run List<Local>.append(&mut entryLocals, Local {ty: Interned<Type>.clone(&i64Ty), kind: LocalKind.Parameter {index: 0}, origin: origin0()})
  let mut callArgs = List<Operand>.make()
  run List<Operand>.append(&mut callArgs, Operand.Copy {place: placeOf(1)})
  let mut entryBlocks = List<Block>.make()
  run List<Block>.append(&mut entryBlocks, Block {
    suspends: false,
    statements: List<Statement>.make(),
    terminator: Terminator.Call {call: run CallBox.make(CallTerminator {
      callee: Callee.Instance {key: InstanceKey.copy(&bodyKey)},
      arguments: move callArgs,
      providers: List<Operand>.make(),
      diagnostics: Option<Diagnostics>.none(),
      destination: placeOf(0),
      normal: 1,
      failure: Option<FailureEdge>.none(),
      origin: origin0(),
    })},
  })
  run List<Block>.append(&mut entryBlocks, Block {suspends: false, statements: List<Statement>.make(), terminator: Terminator.Return {origin: origin0()}})
  let entryMir = run makeMir(InstanceKey.copy(&entryKey), Interned<Type>.clone(&i64Ty), move entryParams, move entryLocals, move entryBlocks, true)

  let entryLowered = match move run Effect.result(SsaLower.lower(
    &entryMir, &x86, List<TypeLayout>.asSlice(&layouts), &[], List<InstanceIdentity>.asSlice(&identities),
    &noSuspension, false, true, Level.Speed, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => {
        run Testing.expect(false, "x86-64 lowering of variadic C export should succeed")
        return ()
      }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let ef = &List<LoweredFunction>.asSlice(&entryLowered.functions)[usize.ZERO].function
  run Testing.expect(ef.callingConvention == CallingConvention.C && ef.variadic, "variadic C export sets C convention and variadic flag")
  run Testing.expect(countOperationKind(ef, 3) == usize.ONE, "variadic C export emits VaStart")
  run Testing.expect(countOperationKind(ef, 4) == usize.ONE, "variadic C export emits VaEnd before return")

  let wasmVariadicRefused = match move run Effect.result(SsaLower.lower(
    &entryMir, &wasm, List<TypeLayout>.asSlice(&layouts), &[], List<InstanceIdentity>.asSlice(&identities),
    &noSuspension, false, true, Level.None, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {..} => false
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => true
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(wasmVariadicRefused, "Wasm lowering still refuses variadic C exports")

  // Variadic body: receives hidden va_list pointer parameter and reads it via Rvalue.VariadicArguments.
  let mut bodyParams = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut bodyParams, Interned<Type>.clone(&i64Ty))
  let mut bodyLocals = List<Local>.make()
  run List<Local>.append(&mut bodyLocals, Local {ty: Interned<Type>.clone(&ptrTy), kind: LocalKind.Return, origin: origin0()})
  run List<Local>.append(&mut bodyLocals, Local {ty: Interned<Type>.clone(&i64Ty), kind: LocalKind.Parameter {index: 0}, origin: origin0()})
  let mut bodyStmts = List<Statement>.make()
  run List<Statement>.append(&mut bodyStmts, Statement.Assign {
    destination: placeOf(0),
    value: Rvalue.VariadicArguments,
    origin: origin0(),
  })
  let mut bodyBlocks = List<Block>.make()
  run List<Block>.append(&mut bodyBlocks, Block {suspends: false, statements: move bodyStmts, terminator: Terminator.Return {origin: origin0()}})
  let bodyMir = run makeMir(InstanceKey.copy(&bodyKey), Interned<Type>.clone(&ptrTy), move bodyParams, move bodyLocals, move bodyBlocks, true)

  let bodyLowered = match move run Effect.result(SsaLower.lower(
    &bodyMir, &x86, List<TypeLayout>.asSlice(&layouts), &[], List<InstanceIdentity>.asSlice(&identities),
    &noSuspension, false, false, Level.Speed, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => {
        run Testing.expect(false, "x86-64 lowering of variadic body should succeed")
        return ()
      }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let bf = &List<LoweredFunction>.asSlice(&bodyLowered.functions)[usize.ZERO].function
  run Testing.expect(List<u64>.length(&bf.arguments) == 2, "variadic body takes written param plus trailing va_list pointer")
  let vaArg = List<u64>.get(&bf.arguments, usize.ONE)
  run Testing.expect(bf.kindOf(vaArg).equals(Kind.address(64)), "trailing variadic argument is a 64-bit address")
  run Testing.expect(bf.block(usize.ZERO).value == vaArg, "Rvalue.VariadicArguments lowers directly to the va_list argument")
}

test effect fn emitsStackSlotLifetimeMarkersForAggregatesOnNative() -> () ! InvalidModulePath | Gap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run stackLifetimeClaims()
    |> Effect.provideMut<Types>(&mut types)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn stackLifetimeClaims() -> () ! InvalidModulePath | Gap | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let x86 = Target.forId(TargetId.X8664UnknownLinuxGnu)
  let wasm = Target.forId(TargetId.Wasm32UnknownUnknown)
  let setup = run pair16TypeAndLayouts()

  let fnId = run declId(b"aggregate_lifetime")
  let fnKey = run InstanceKey.named(&fnId)
  let mut params = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut params, Interned<Type>.clone(&setup.pairTy))
  let mut locals = List<Local>.make()
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&setup.i64Ty), kind: LocalKind.Return, origin: origin0()})
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&setup.pairTy), kind: LocalKind.Parameter {index: 0}, origin: origin0()})
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&setup.pairTy), kind: LocalKind.Temp, origin: origin0()})

  let mut r0 = List<Projection>.make()
  run List<Projection>.append(&mut r0, Projection.Field {index: 0})
  let mut stmts = List<Statement>.make()
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(2),
    value: Rvalue.Use {value: Operand.Copy {place: placeOf(1)}},
    origin: origin0(),
  })
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(0),
    value: Rvalue.Use {value: Operand.Copy {place: Place {local: 2, projections: move r0}}},
    origin: origin0(),
  })
  let mut blocks = List<Block>.make()
  run List<Block>.append(&mut blocks, Block {suspends: false, statements: move stmts, terminator: Terminator.Return {origin: origin0()}})
  let mir = run makeMir(InstanceKey.copy(&fnKey), Interned<Type>.clone(&setup.i64Ty), move params, move locals, move blocks, false)
  let mut identities = List<InstanceIdentity>.make()
  run List<InstanceIdentity>.append(&mut identities, InstanceIdentity {key: InstanceKey.copy(&fnKey), symbol: run Bytes.copy(b"aggregate_lifetime")})
  let noSuspension = Option<Facts>.none()

  // At Level.None, promotion does not promote stack slots, so aggregate SlotStart/SlotEnd remain.
  let nativeLowered = match move run Effect.result(SsaLower.lower(
    &mir, &x86, List<TypeLayout>.asSlice(&setup.layouts), &[], List<InstanceIdentity>.asSlice(&identities),
    &noSuspension, false, false, Level.None, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => {
        run Testing.expect(false, "native aggregate lowering should succeed")
        return ()
      }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let nf = &List<LoweredFunction>.asSlice(&nativeLowered.functions)[usize.ZERO].function
  run Testing.expect(countOperationKind(nf, 5) >= usize.ONE && countOperationKind(nf, 6) >= usize.ONE,
    "native lowering emits SlotStart and SlotEnd markers for aggregate stack slots")

  let wasmLowered = match move run Effect.result(SsaLower.lower(
    &mir, &wasm, List<TypeLayout>.asSlice(&setup.layouts), &[], List<InstanceIdentity>.asSlice(&identities),
    &noSuspension, false, false, Level.None, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => {
        run Testing.expect(false, "wasm aggregate lowering should succeed")
        return ()
      }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let wf = &List<LoweredFunction>.asSlice(&wasmLowered.functions)[usize.ZERO].function
  run Testing.expect(countOperationKind(wf, 5) == usize.ZERO && countOperationKind(wf, 6) == usize.ZERO,
    "Wasm lowering emits no SlotStart/SlotEnd markers")
}

fn hasArchOp(function: &SsaFunction, wanted: ArchOperation) -> bool {
  let mut block = usize.ZERO
  while block < function.blockCount() {
    let listed = List<usize>.asSlice(&function.block(block).instructions)
    let mut at = usize.ZERO
    while at < listed.length {
      if let Operation.ArchIntrinsic {operation, ..} = function.instruction(listed[at]).operation {
        if operation == wanted { return true }
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  return false
}

test effect fn lowersAarch64ArchIntrinsics() -> () ! InvalidModulePath | Gap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run aarch64ArchLoweringClaims()
    |> Effect.provideMut<Types>(&mut types)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn aarch64ArchLoweringClaims() -> () ! InvalidModulePath | Gap | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let darwin = Target.forId(TargetId.Aarch64AppleDarwin)
  let x86 = Target.forId(TargetId.X8664UnknownLinuxGnu)
  let wasm = Target.forId(TargetId.Wasm32UnknownUnknown)

  let v16u8 = run vectorType(b"u8", 16)
  let v16i8 = run vectorType(b"i8", 16)
  let v8u16 = run vectorType(b"u16", 8)
  let v4u32 = run vectorType(b"u32", 4)
  let v4i32 = run vectorType(b"i32", 4)
  let v2u64 = run vectorType(b"u64", 2)
  let mut layouts = List<TypeLayout>.make()
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&v16u8, 16, 16, Abi.Vector))
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&v16i8, 16, 16, Abi.Vector))
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&v8u16, 16, 16, Abi.Vector))
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&v4u32, 16, 16, Abi.Vector))
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&v4i32, 16, 16, Abi.Vector))
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&v2u64, 16, 16, Abi.Vector))

  let fnId = run declId(b"aarch64_arch_intrinsics")
  let fnKey = run InstanceKey.named(&fnId)
  let mut params = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut params, Interned<Type>.clone(&v16u8))
  run List<Interned<Type>>.append(&mut params, Interned<Type>.clone(&v16i8))
  run List<Interned<Type>>.append(&mut params, Interned<Type>.clone(&v8u16))
  run List<Interned<Type>>.append(&mut params, Interned<Type>.clone(&v4u32))
  run List<Interned<Type>>.append(&mut params, Interned<Type>.clone(&v4i32))
  run List<Interned<Type>>.append(&mut params, Interned<Type>.clone(&v2u64))

  let mut locals = List<Local>.make()
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&v4u32), kind: LocalKind.Return, origin: origin0()})
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&v16u8), kind: LocalKind.Parameter {index: 0}, origin: origin0()})
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&v16i8), kind: LocalKind.Parameter {index: 1}, origin: origin0()})
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&v8u16), kind: LocalKind.Parameter {index: 2}, origin: origin0()})
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&v4u32), kind: LocalKind.Parameter {index: 3}, origin: origin0()})
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&v4i32), kind: LocalKind.Parameter {index: 4}, origin: origin0()})
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&v2u64), kind: LocalKind.Parameter {index: 5}, origin: origin0()})
  // Temps 7..21 for the 15 intrinsic results.
  let mut ti: usize = 7
  while ti <= 21 {
    let tempTy = if ti == 11 || ti == 13 || ti >= 18 {
      Interned<Type>.clone(&v4u32)
    } else if ti == 12 {
      Interned<Type>.clone(&v4i32)
    } else if ti == 14 {
      Interned<Type>.clone(&v8u16)
    } else if ti == 16 || ti == 17 {
      Interned<Type>.clone(&v2u64)
    } else {
      Interned<Type>.clone(&v16u8)
    }
    run List<Local>.append(&mut locals, Local {ty: move tempTy, kind: LocalKind.Temp, origin: origin0()})
    ti = ti + usize.ONE
  }

  let mut stmts = List<Statement>.make()
  let mut a2 = List<Operand>.make()
  run List<Operand>.append(&mut a2, Operand.Copy {place: placeOf(1)})
  run List<Operand>.append(&mut a2, Operand.Copy {place: placeOf(1)})
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(7),
    value: Rvalue.Vector {primitive: IntrinsicPrimitive.Aarch64TableLookup, operands: move a2, ty: Interned<Type>.clone(&v16u8)},
    origin: origin0(),
  })

  let mut b2 = List<Operand>.make()
  run List<Operand>.append(&mut b2, Operand.Copy {place: placeOf(1)})
  run List<Operand>.append(&mut b2, Operand.Copy {place: placeOf(1)})
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(8),
    value: Rvalue.Vector {primitive: IntrinsicPrimitive.Aarch64AesEncrypt, operands: move b2, ty: Interned<Type>.clone(&v16u8)},
    origin: origin0(),
  })

  let mut c1 = List<Operand>.make()
  run List<Operand>.append(&mut c1, Operand.Copy {place: placeOf(8)})
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(9),
    value: Rvalue.Vector {primitive: IntrinsicPrimitive.Aarch64AesMixColumns, operands: move c1, ty: Interned<Type>.clone(&v16u8)},
    origin: origin0(),
  })

  let mut d2 = List<Operand>.make()
  run List<Operand>.append(&mut d2, Operand.Copy {place: placeOf(9)})
  run List<Operand>.append(&mut d2, Operand.Copy {place: placeOf(1)})
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(10),
    value: Rvalue.Vector {primitive: IntrinsicPrimitive.Aarch64AesDecrypt, operands: move d2, ty: Interned<Type>.clone(&v16u8)},
    origin: origin0(),
  })

  let mut e1 = List<Operand>.make()
  run List<Operand>.append(&mut e1, Operand.Copy {place: placeOf(10)})
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(15),
    value: Rvalue.Vector {primitive: IntrinsicPrimitive.Aarch64AesInverseMixColumns, operands: move e1, ty: Interned<Type>.clone(&v16u8)},
    origin: origin0(),
  })

  let mut udotArgs = List<Operand>.make()
  run List<Operand>.append(&mut udotArgs, Operand.Copy {place: placeOf(4)})
  run List<Operand>.append(&mut udotArgs, Operand.Copy {place: placeOf(1)})
  run List<Operand>.append(&mut udotArgs, Operand.Copy {place: placeOf(15)})
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(11),
    value: Rvalue.Vector {primitive: IntrinsicPrimitive.Aarch64DotProduct, operands: move udotArgs, ty: Interned<Type>.clone(&v4u32)},
    origin: origin0(),
  })

  let mut sdotArgs = List<Operand>.make()
  run List<Operand>.append(&mut sdotArgs, Operand.Copy {place: placeOf(5)})
  run List<Operand>.append(&mut sdotArgs, Operand.Copy {place: placeOf(2)})
  run List<Operand>.append(&mut sdotArgs, Operand.Copy {place: placeOf(2)})
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(12),
    value: Rvalue.Vector {primitive: IntrinsicPrimitive.Aarch64DotProduct, operands: move sdotArgs, ty: Interned<Type>.clone(&v4i32)},
    origin: origin0(),
  })

  let mut addpArgs = List<Operand>.make()
  run List<Operand>.append(&mut addpArgs, Operand.Copy {place: placeOf(4)})
  run List<Operand>.append(&mut addpArgs, Operand.Copy {place: placeOf(11)})
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(13),
    value: Rvalue.Vector {primitive: IntrinsicPrimitive.Aarch64PairwiseAdd, operands: move addpArgs, ty: Interned<Type>.clone(&v4u32)},
    origin: origin0(),
  })

  let mut addp16Args = List<Operand>.make()
  run List<Operand>.append(&mut addp16Args, Operand.Copy {place: placeOf(3)})
  run List<Operand>.append(&mut addp16Args, Operand.Copy {place: placeOf(3)})
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(14),
    value: Rvalue.Vector {primitive: IntrinsicPrimitive.Aarch64PairwiseAdd, operands: move addp16Args, ty: Interned<Type>.clone(&v8u16)},
    origin: origin0(),
  })

  let mut pm0Args = List<Operand>.make()
  run List<Operand>.append(&mut pm0Args, Operand.Copy {place: placeOf(6)})
  run List<Operand>.append(&mut pm0Args, Operand.Copy {place: placeOf(6)})
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(16),
    value: Rvalue.Vector {primitive: IntrinsicPrimitive.Aarch64PolynomialMultiply, operands: move pm0Args, ty: Interned<Type>.clone(&v2u64)},
    origin: origin0(),
  })

  let mut pm1Args = List<Operand>.make()
  run List<Operand>.append(&mut pm1Args, Operand.Copy {place: placeOf(16)})
  run List<Operand>.append(&mut pm1Args, Operand.Copy {place: placeOf(6)})
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(17),
    value: Rvalue.Vector {primitive: IntrinsicPrimitive.Aarch64PolynomialMultiplyHigh, operands: move pm1Args, ty: Interned<Type>.clone(&v2u64)},
    origin: origin0(),
  })

  let mut shaHArgs = List<Operand>.make()
  run List<Operand>.append(&mut shaHArgs, Operand.Copy {place: placeOf(13)})
  run List<Operand>.append(&mut shaHArgs, Operand.Copy {place: placeOf(4)})
  run List<Operand>.append(&mut shaHArgs, Operand.Copy {place: placeOf(4)})
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(18),
    value: Rvalue.Vector {primitive: IntrinsicPrimitive.Aarch64Sha256Hash, operands: move shaHArgs, ty: Interned<Type>.clone(&v4u32)},
    origin: origin0(),
  })

  let mut shaH2Args = List<Operand>.make()
  run List<Operand>.append(&mut shaH2Args, Operand.Copy {place: placeOf(18)})
  run List<Operand>.append(&mut shaH2Args, Operand.Copy {place: placeOf(13)})
  run List<Operand>.append(&mut shaH2Args, Operand.Copy {place: placeOf(4)})
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(19),
    value: Rvalue.Vector {primitive: IntrinsicPrimitive.Aarch64Sha256Hash2, operands: move shaH2Args, ty: Interned<Type>.clone(&v4u32)},
    origin: origin0(),
  })

  let mut su0Args = List<Operand>.make()
  run List<Operand>.append(&mut su0Args, Operand.Copy {place: placeOf(19)})
  run List<Operand>.append(&mut su0Args, Operand.Copy {place: placeOf(4)})
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(20),
    value: Rvalue.Vector {primitive: IntrinsicPrimitive.Aarch64Sha256ScheduleUpdate0, operands: move su0Args, ty: Interned<Type>.clone(&v4u32)},
    origin: origin0(),
  })

  let mut su1Args = List<Operand>.make()
  run List<Operand>.append(&mut su1Args, Operand.Copy {place: placeOf(20)})
  run List<Operand>.append(&mut su1Args, Operand.Copy {place: placeOf(19)})
  run List<Operand>.append(&mut su1Args, Operand.Copy {place: placeOf(4)})
  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(21),
    value: Rvalue.Vector {primitive: IntrinsicPrimitive.Aarch64Sha256ScheduleUpdate1, operands: move su1Args, ty: Interned<Type>.clone(&v4u32)},
    origin: origin0(),
  })

  run List<Statement>.append(&mut stmts, Statement.Assign {
    destination: placeOf(0),
    value: Rvalue.Use {value: Operand.Copy {place: placeOf(21)}},
    origin: origin0(),
  })

  let mut blocks = List<Block>.make()
  run List<Block>.append(&mut blocks, Block {suspends: false, statements: move stmts, terminator: Terminator.Return {origin: origin0()}})
  let mir = run makeMir(InstanceKey.copy(&fnKey), Interned<Type>.clone(&v4u32), move params, move locals, move blocks, false)
  let mut identities = List<InstanceIdentity>.make()
  run List<InstanceIdentity>.append(&mut identities, InstanceIdentity {key: InstanceKey.copy(&fnKey), symbol: run Bytes.copy(b"aarch64_arch_intrinsics")})
  let noSuspension = Option<Facts>.none()

  let lowered = match move run Effect.result(SsaLower.lower(
    &mir, &darwin, List<TypeLayout>.asSlice(&layouts), &[], List<InstanceIdentity>.asSlice(&identities),
    &noSuspension, false, false, Level.None, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => {
        run Testing.expect(false, "aarch64 darwin lowering of AArch64 arch intrinsics should succeed")
        return ()
      }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let f = &List<LoweredFunction>.asSlice(&lowered.functions)[usize.ZERO].function
  run Testing.expect(hasArchOp(f, ArchOperation.Aarch64TableLookup), "tbl lowers")
  run Testing.expect(hasArchOp(f, ArchOperation.Aarch64UnsignedDotProduct), "u32x4 dotProduct lowers to udot")
  run Testing.expect(hasArchOp(f, ArchOperation.Aarch64SignedDotProduct), "i32x4 dotProduct lowers to sdot")
  run Testing.expect(hasArchOp(f, ArchOperation.Aarch64PairwiseAdd), "addp lowers")
  run Testing.expect(hasArchOp(f, ArchOperation.Aarch64AesEncrypt), "aese lowers")
  run Testing.expect(hasArchOp(f, ArchOperation.Aarch64AesDecrypt), "aesd lowers")
  run Testing.expect(hasArchOp(f, ArchOperation.Aarch64AesMixColumns), "aesmc lowers")
  run Testing.expect(hasArchOp(f, ArchOperation.Aarch64AesInverseMixColumns), "aesimc lowers")
  run Testing.expect(hasArchOp(f, ArchOperation.Aarch64PolynomialMultiply), "pmull lowers")
  run Testing.expect(hasArchOp(f, ArchOperation.Aarch64PolynomialMultiplyHigh), "pmull2 lowers")
  run Testing.expect(hasArchOp(f, ArchOperation.Aarch64Sha256Hash), "sha256h lowers")
  run Testing.expect(hasArchOp(f, ArchOperation.Aarch64Sha256Hash2), "sha256h2 lowers")
  run Testing.expect(hasArchOp(f, ArchOperation.Aarch64Sha256ScheduleUpdate0), "sha256su0 lowers")
  run Testing.expect(hasArchOp(f, ArchOperation.Aarch64Sha256ScheduleUpdate1), "sha256su1 lowers")

  // Cross-architecture gating: AArch64 intrinsics are refused on x86-64 and Wasm.
  let x86Refused = match move run Effect.result(SsaLower.lower(
    &mir, &x86, List<TypeLayout>.asSlice(&layouts), &[], List<InstanceIdentity>.asSlice(&identities),
    &noSuspension, false, false, Level.None, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {..} => false
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => true
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(x86Refused, "x86-64 target refuses AArch64 arch intrinsics")

  let wasmRefused = match move run Effect.result(SsaLower.lower(
    &mir, &wasm, List<TypeLayout>.asSlice(&layouts), &[], List<InstanceIdentity>.asSlice(&identities),
    &noSuspension, false, false, Level.None, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {..} => false
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => true
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(wasmRefused, "Wasm target refuses AArch64 arch intrinsics")

  // Bidirectional check: x86-64 arch intrinsic is refused on AArch64.
  let x86Id = run declId(b"x86_on_arm")
  let x86Key = run InstanceKey.named(&x86Id)
  let mut xParams = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut xParams, Interned<Type>.clone(&v2u64))
  let mut xLocals = List<Local>.make()
  run List<Local>.append(&mut xLocals, Local {ty: Interned<Type>.clone(&v2u64), kind: LocalKind.Return, origin: origin0()})
  run List<Local>.append(&mut xLocals, Local {ty: Interned<Type>.clone(&v2u64), kind: LocalKind.Parameter {index: 0}, origin: origin0()})
  let mut xArgs = List<Operand>.make()
  run List<Operand>.append(&mut xArgs, Operand.Copy {place: placeOf(1)})
  run List<Operand>.append(&mut xArgs, Operand.Copy {place: placeOf(1)})
  let mut xStmts = List<Statement>.make()
  run List<Statement>.append(&mut xStmts, Statement.Assign {
    destination: placeOf(0),
    value: Rvalue.Vector {primitive: IntrinsicPrimitive.X86AesEncrypt, operands: move xArgs, ty: Interned<Type>.clone(&v2u64)},
    origin: origin0(),
  })
  let mut xBlocks = List<Block>.make()
  run List<Block>.append(&mut xBlocks, Block {suspends: false, statements: move xStmts, terminator: Terminator.Return {origin: origin0()}})
  let xMir = run makeMir(InstanceKey.copy(&x86Key), Interned<Type>.clone(&v2u64), move xParams, move xLocals, move xBlocks, false)
  let mut xIds = List<InstanceIdentity>.make()
  run List<InstanceIdentity>.append(&mut xIds, InstanceIdentity {key: InstanceKey.copy(&x86Key), symbol: run Bytes.copy(b"x86_on_arm")})
  let armRefusedX86 = match move run Effect.result(SsaLower.lower(
    &xMir, &darwin, List<TypeLayout>.asSlice(&layouts), &[], List<InstanceIdentity>.asSlice(&xIds),
    &noSuspension, false, false, Level.None, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {..} => false
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => true
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(armRefusedX86, "AArch64 target refuses x86-64 arch intrinsics")
}

test effect fn lowersDarwinArm64CAbiAndVariadics() -> () ! InvalidModulePath | Gap | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run darwinArm64CAbiClaims()
    |> Effect.provideMut<Types>(&mut types)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn darwinArm64CAbiClaims() -> () ! InvalidModulePath | Gap | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let darwin = Target.forId(TargetId.Aarch64AppleDarwin)
  let linuxArm = Target.forId(TargetId.Aarch64UnknownLinuxGnu)
  let noSuspension = Option<Facts>.none()

  let i8Ty = run primitiveType(b"i8")
  let u16Ty = run primitiveType(b"u16")
  let i32Ty = run primitiveType(b"i32")
  let i64Ty = run primitiveType(b"i64")
  let f32Ty = run primitiveType(b"f32")
  let f64Ty = run primitiveType(b"f64")
  let v16u8 = run vectorType(b"u8", 16)
  let ptrI8Ty = run pointerType(&i8Ty)

  // Build layouts for narrow scalars, HFA3 {f32,f32,f32}, HVA2 {v16u8,v16u8}, Pair16 {i64,f64}, Large24 {i64,i64,i64}.
  let hfaId = run structDeclId(b"Hfa3")
  let hfaTy = run Types.intern(Type.Nominal {declaration: move hfaId, isPublic: true, arguments: List<Argument>.make()})
  let mut hfaFields = List<LayoutField>.make()
  run List<LayoutField>.append(&mut hfaFields, LayoutField {ty: Interned<Type>.clone(&f32Ty), offset: usize.ZERO})
  run List<LayoutField>.append(&mut hfaFields, LayoutField {ty: Interned<Type>.clone(&f32Ty), offset: 4})
  run List<LayoutField>.append(&mut hfaFields, LayoutField {ty: Interned<Type>.clone(&f32Ty), offset: 8})

  let hvaId = run structDeclId(b"Hva2")
  let hvaTy = run Types.intern(Type.Nominal {declaration: move hvaId, isPublic: true, arguments: List<Argument>.make()})
  let mut hvaFields = List<LayoutField>.make()
  run List<LayoutField>.append(&mut hvaFields, LayoutField {ty: Interned<Type>.clone(&v16u8), offset: usize.ZERO})
  run List<LayoutField>.append(&mut hvaFields, LayoutField {ty: Interned<Type>.clone(&v16u8), offset: 16})

  let pair16Id = run structDeclId(b"ArmPair16")
  let pair16Ty = run Types.intern(Type.Nominal {declaration: move pair16Id, isPublic: true, arguments: List<Argument>.make()})
  let mut pairFields = List<LayoutField>.make()
  run List<LayoutField>.append(&mut pairFields, LayoutField {ty: Interned<Type>.clone(&i64Ty), offset: usize.ZERO})
  run List<LayoutField>.append(&mut pairFields, LayoutField {ty: Interned<Type>.clone(&f64Ty), offset: 8})

  let largeId = run structDeclId(b"Large24")
  let largeTy = run Types.intern(Type.Nominal {declaration: move largeId, isPublic: true, arguments: List<Argument>.make()})
  let mut largeFields = List<LayoutField>.make()
  run List<LayoutField>.append(&mut largeFields, LayoutField {ty: Interned<Type>.clone(&i64Ty), offset: usize.ZERO})
  run List<LayoutField>.append(&mut largeFields, LayoutField {ty: Interned<Type>.clone(&i64Ty), offset: 8})
  run List<LayoutField>.append(&mut largeFields, LayoutField {ty: Interned<Type>.clone(&i64Ty), offset: 16})

  let mut layouts = List<TypeLayout>.make()
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&i8Ty, 1, 1, Abi.Integer))
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&u16Ty, 2, 2, Abi.Integer))
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&i32Ty, 4, 4, Abi.Integer))
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&i64Ty, 8, 8, Abi.Integer))
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&f32Ty, 4, 4, Abi.Floating))
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&f64Ty, 8, 8, Abi.Floating))
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&v16u8, 16, 16, Abi.Vector))
  run List<TypeLayout>.append(&mut layouts, run scalarLayout(&ptrI8Ty, 8, 8, Abi.Pointer))
  run List<TypeLayout>.append(&mut layouts, TypeLayout {
    ty: Interned<Type>.clone(&hfaTy),
    layout: run Interned<Layout>.make(Layout {size: 12, alignment: 4, abi: Abi.Indirect, storage: Storage.Record {fields: move hfaFields}, head: usize.ZERO}),
  })
  run List<TypeLayout>.append(&mut layouts, TypeLayout {
    ty: Interned<Type>.clone(&hvaTy),
    layout: run Interned<Layout>.make(Layout {size: 32, alignment: 16, abi: Abi.Indirect, storage: Storage.Record {fields: move hvaFields}, head: usize.ZERO}),
  })
  run List<TypeLayout>.append(&mut layouts, TypeLayout {
    ty: Interned<Type>.clone(&pair16Ty),
    layout: run Interned<Layout>.make(Layout {size: 16, alignment: 8, abi: Abi.Indirect, storage: Storage.Record {fields: move pairFields}, head: usize.ZERO}),
  })
  run List<TypeLayout>.append(&mut layouts, TypeLayout {
    ty: Interned<Type>.clone(&largeTy),
    layout: run Interned<Layout>.make(Layout {size: 24, alignment: 8, abi: Abi.Indirect, storage: Storage.Record {fields: move largeFields}, head: usize.ZERO}),
  })

  // 1. Narrow integer AbiExtension: Darwin extends i8/u16, Linux AAPCS64 does not.
  let narrowId = run declId(b"darwin_narrow")
  let narrowKey = InstanceKey.Export {function: Interned<DeclarationId>.clone(&narrowId), symbol: run Arc<Bytes>.make(run Bytes.copy(b"darwin_narrow"))}
  let mut nParams = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut nParams, Interned<Type>.clone(&i8Ty))
  run List<Interned<Type>>.append(&mut nParams, Interned<Type>.clone(&u16Ty))
  let mut nLocals = List<Local>.make()
  run List<Local>.append(&mut nLocals, Local {ty: Interned<Type>.clone(&i8Ty), kind: LocalKind.Return, origin: origin0()})
  run List<Local>.append(&mut nLocals, Local {ty: Interned<Type>.clone(&i8Ty), kind: LocalKind.Parameter {index: 0}, origin: origin0()})
  run List<Local>.append(&mut nLocals, Local {ty: Interned<Type>.clone(&u16Ty), kind: LocalKind.Parameter {index: 1}, origin: origin0()})
  let mut nStmts = List<Statement>.make()
  run List<Statement>.append(&mut nStmts, Statement.Assign {
    destination: placeOf(0),
    value: Rvalue.Use {value: Operand.Copy {place: placeOf(1)}},
    origin: origin0(),
  })
  let mut nBlocks = List<Block>.make()
  run List<Block>.append(&mut nBlocks, Block {suspends: false, statements: move nStmts, terminator: Terminator.Return {origin: origin0()}})
  let narrowMir = run makeMir(InstanceKey.copy(&narrowKey), Interned<Type>.clone(&i8Ty), move nParams, move nLocals, move nBlocks, false)
  let mut nIds = List<InstanceIdentity>.make()
  run List<InstanceIdentity>.append(&mut nIds, InstanceIdentity {key: InstanceKey.copy(&narrowKey), symbol: run Bytes.copy(b"darwin_narrow")})

  let darwinNarrow = match move run Effect.result(SsaLower.lower(
    &narrowMir, &darwin, List<TypeLayout>.asSlice(&layouts), &[], List<InstanceIdentity>.asSlice(&nIds),
    &noSuspension, false, true, Level.None, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => { run Testing.expect(false, "darwin narrow int export should lower") return () }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let dnf = &List<LoweredFunction>.asSlice(&darwinNarrow.functions)[usize.ZERO].function
  run Testing.expect(
    dnf.resultExtension == AbiExtension.Signed
      && dnf.argumentAbi(0).extension == AbiExtension.Signed
      && dnf.argumentAbi(1).extension == AbiExtension.Unsigned,
    "Darwin ARM64 sets Signed/Unsigned AbiExtension on narrow integer C parameters and results")

  let linuxNarrow = match move run Effect.result(SsaLower.lower(
    &narrowMir, &linuxArm, List<TypeLayout>.asSlice(&layouts), &[], List<InstanceIdentity>.asSlice(&nIds),
    &noSuspension, false, true, Level.None, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => { run Testing.expect(false, "linux arm64 narrow int export should lower") return () }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let lnf = &List<LoweredFunction>.asSlice(&linuxNarrow.functions)[usize.ZERO].function
  run Testing.expect(
    lnf.resultExtension == AbiExtension.None
      && lnf.argumentAbi(0).extension == AbiExtension.None
      && lnf.argumentAbi(1).extension == AbiExtension.None,
    "Linux AAPCS64 leaves narrow integer AbiExtension as None")

  // 2. >16B struct sret + non-byval Indirect arg, plus <=16B struct + HFA/HVA groupRemaining & stackAlignment.
  let abiId = run declId(b"darwin_abi_aggregates")
  let abiKey = InstanceKey.Export {function: Interned<DeclarationId>.clone(&abiId), symbol: run Arc<Bytes>.make(run Bytes.copy(b"darwin_abi_aggregates"))}
  let mut aParams = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut aParams, Interned<Type>.clone(&largeTy))
  run List<Interned<Type>>.append(&mut aParams, Interned<Type>.clone(&hfaTy))
  run List<Interned<Type>>.append(&mut aParams, Interned<Type>.clone(&hvaTy))
  run List<Interned<Type>>.append(&mut aParams, Interned<Type>.clone(&pair16Ty))
  let mut aLocals = List<Local>.make()
  run List<Local>.append(&mut aLocals, Local {ty: Interned<Type>.clone(&largeTy), kind: LocalKind.Return, origin: origin0()})
  run List<Local>.append(&mut aLocals, Local {ty: Interned<Type>.clone(&largeTy), kind: LocalKind.Parameter {index: 0}, origin: origin0()})
  run List<Local>.append(&mut aLocals, Local {ty: Interned<Type>.clone(&hfaTy), kind: LocalKind.Parameter {index: 1}, origin: origin0()})
  run List<Local>.append(&mut aLocals, Local {ty: Interned<Type>.clone(&hvaTy), kind: LocalKind.Parameter {index: 2}, origin: origin0()})
  run List<Local>.append(&mut aLocals, Local {ty: Interned<Type>.clone(&pair16Ty), kind: LocalKind.Parameter {index: 3}, origin: origin0()})
  let mut aStmts = List<Statement>.make()
  run List<Statement>.append(&mut aStmts, Statement.Assign {
    destination: placeOf(0),
    value: Rvalue.Use {value: Operand.Copy {place: placeOf(1)}},
    origin: origin0(),
  })
  let mut aBlocks = List<Block>.make()
  run List<Block>.append(&mut aBlocks, Block {suspends: false, statements: move aStmts, terminator: Terminator.Return {origin: origin0()}})
  let abiMir = run makeMir(InstanceKey.copy(&abiKey), Interned<Type>.clone(&largeTy), move aParams, move aLocals, move aBlocks, false)
  let mut aIds = List<InstanceIdentity>.make()
  run List<InstanceIdentity>.append(&mut aIds, InstanceIdentity {key: InstanceKey.copy(&abiKey), symbol: run Bytes.copy(b"darwin_abi_aggregates")})

  let darwinAgg = match move run Effect.result(SsaLower.lower(
    &abiMir, &darwin, List<TypeLayout>.asSlice(&layouts), &[], List<InstanceIdentity>.asSlice(&aIds),
    &noSuspension, false, true, Level.None, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => { run Testing.expect(false, "darwin aggregate ABI export should lower") return () }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let daf = &List<LoweredFunction>.asSlice(&darwinAgg.functions)[usize.ZERO].function
  // Args: [0]=sret ptr, [1]=Large24 ptr, [2..4]=Hfa3 (3x f32), [5..6]=Hva2 (2x v16i8), [7..8]=Pair16 (2x i64).
  run Testing.expect(List<u64>.length(&daf.arguments) == 9, "sret + Large24 + 3x f32 + 2x v16i8 + 2x i64 = 9 SSA args")
  run Testing.expect(daf.result.isUnit(), ">16B sret return lowers to unit SSA result")
  run Testing.expect(daf.argumentAbi(0).sret && daf.argumentAbi(1).byvalSize == 0 && !daf.argumentAbi(1).sret,
    ">16B struct return uses sret and >16B param uses non-byval pointer")
  run Testing.expect(
    daf.argumentAbi(2).groupRemaining == 3 && daf.argumentAbi(3).groupRemaining == 2 && daf.argumentAbi(4).groupRemaining == 1
      && daf.argumentAbi(2).stackAlignment == usize.ZERO,
    "Darwin HFA3 carries groupRemaining 3,2,1 and stackAlignment 0")
  run Testing.expect(
    daf.argumentAbi(5).groupRemaining == 2 && daf.argumentAbi(6).groupRemaining == 1
      && daf.argumentAbi(5).stackAlignment == usize.ZERO,
    "Darwin HVA2 carries groupRemaining 2,1 and stackAlignment 0")
  run Testing.expect(
    daf.argumentAbi(7).groupRemaining == 2 && daf.argumentAbi(8).groupRemaining == 1
      && daf.argumentAbi(7).stackAlignment == usize.ZERO,
    "Darwin <=16B Pair16 carries groupRemaining 2,1 across its two i64 lanes")

  let linuxAgg = match move run Effect.result(SsaLower.lower(
    &abiMir, &linuxArm, List<TypeLayout>.asSlice(&layouts), &[], List<InstanceIdentity>.asSlice(&aIds),
    &noSuspension, false, true, Level.None, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => { run Testing.expect(false, "linux arm64 aggregate ABI export should lower") return () }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let laf = &List<LoweredFunction>.asSlice(&linuxAgg.functions)[usize.ZERO].function
  run Testing.expect(laf.argumentAbi(2).groupRemaining == 3 && laf.argumentAbi(2).stackAlignment == 8,
    "Linux AAPCS64 HFA3 propagates stackAlignment 8")
  run Testing.expect(laf.argumentAbi(5).groupRemaining == 2 && laf.argumentAbi(5).stackAlignment == 16,
    "Linux AAPCS64 HVA2 propagates stackAlignment 16")

  // 3. <=16B Pair16 C return on Darwin lowers to (i64, i64) pair return, while 3-reg HFA return hits Unsupported.
  let p16Id = run declId(b"darwin_pair16_ret")
  let p16Key = InstanceKey.Export {function: Interned<DeclarationId>.clone(&p16Id), symbol: run Arc<Bytes>.make(run Bytes.copy(b"darwin_pair16_ret"))}
  let mut p16Params = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut p16Params, Interned<Type>.clone(&pair16Ty))
  let mut p16Locals = List<Local>.make()
  run List<Local>.append(&mut p16Locals, Local {ty: Interned<Type>.clone(&pair16Ty), kind: LocalKind.Return, origin: origin0()})
  run List<Local>.append(&mut p16Locals, Local {ty: Interned<Type>.clone(&pair16Ty), kind: LocalKind.Parameter {index: 0}, origin: origin0()})
  let mut p16Stmts = List<Statement>.make()
  run List<Statement>.append(&mut p16Stmts, Statement.Assign {
    destination: placeOf(0),
    value: Rvalue.Use {value: Operand.Copy {place: placeOf(1)}},
    origin: origin0(),
  })
  let mut p16Blocks = List<Block>.make()
  run List<Block>.append(&mut p16Blocks, Block {suspends: false, statements: move p16Stmts, terminator: Terminator.Return {origin: origin0()}})
  let p16Mir = run makeMir(InstanceKey.copy(&p16Key), Interned<Type>.clone(&pair16Ty), move p16Params, move p16Locals, move p16Blocks, false)
  let mut p16Ids = List<InstanceIdentity>.make()
  run List<InstanceIdentity>.append(&mut p16Ids, InstanceIdentity {key: InstanceKey.copy(&p16Key), symbol: run Bytes.copy(b"darwin_pair16_ret")})
  let p16Lowered = match move run Effect.result(SsaLower.lower(
    &p16Mir, &darwin, List<TypeLayout>.asSlice(&layouts), &[], List<InstanceIdentity>.asSlice(&p16Ids),
    &noSuspension, false, true, Level.None, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => { run Testing.expect(false, "darwin <=16B struct export should lower") return () }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let p16f = &List<LoweredFunction>.asSlice(&p16Lowered.functions)[usize.ZERO].function
  run Testing.expect(p16f.result.equals(Kind.integer(64)) && p16f.secondResultKind.equals(Kind.integer(64)),
    "Darwin <=16B struct Pair16 returns as (i64, i64) pair")

  let typeLayouts = run TypeLayouts.copyOf(List<TypeLayout>.asSlice(&layouts))
  if let Option<CLane>.Some {value: hfaRetLane} = move run CAbi.classify(&hfaTy, &typeLayouts, &darwin, true) {
    let hfaKinds = match move run Effect.result(SsaLower.cResultKinds(&hfaRetLane, 64, true, b"hfa3_ret")) {
      Result<SsaLower.ResultKinds, Unsupported | OutOfMemoryError>.Success {value} => value
      Result<SsaLower.ResultKinds, Unsupported | OutOfMemoryError>.Failure {error} => match move error {
        Unsupported _ => { run Testing.expect(false, "3-piece HFA C return should coerce into 3 SSA results") return () }
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
    let f32k = Kind.float(32)
    run Testing.expect(
      hfaKinds.first.equals(f32k) && hfaKinds.second.equals(f32k) && hfaKinds.third.equals(f32k) && hfaKinds.fourth.isUnit(),
      "3-piece HFA C return yields (f32, f32, f32)",
    )
  } else {
    run Testing.expect(false, "Hfa3 should classify as C result")
  }

  // 4. Darwin variadic C export, va_list body, and variadic extern C call promotions.
  let vBodyId = run declId(b"darwin_va_body")
  let vBodyKey = run InstanceKey.named(&vBodyId)
  let vEntryKey = InstanceKey.Export {function: Interned<DeclarationId>.clone(&vBodyId), symbol: run Arc<Bytes>.make(run Bytes.copy(b"darwin_va_entry"))}
  let mut vIds = List<InstanceIdentity>.make()
  run List<InstanceIdentity>.append(&mut vIds, InstanceIdentity {key: InstanceKey.copy(&vBodyKey), symbol: run Bytes.copy(b"darwin_va_body")})
  run List<InstanceIdentity>.append(&mut vIds, InstanceIdentity {key: InstanceKey.copy(&vEntryKey), symbol: run Bytes.copy(b"darwin_va_entry")})

  let mut veParams = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut veParams, Interned<Type>.clone(&i64Ty))
  let mut veLocals = List<Local>.make()
  run List<Local>.append(&mut veLocals, Local {ty: Interned<Type>.clone(&i64Ty), kind: LocalKind.Return, origin: origin0()})
  run List<Local>.append(&mut veLocals, Local {ty: Interned<Type>.clone(&i64Ty), kind: LocalKind.Parameter {index: 0}, origin: origin0()})
  let mut veCallArgs = List<Operand>.make()
  run List<Operand>.append(&mut veCallArgs, Operand.Copy {place: placeOf(1)})
  let mut veBlocks = List<Block>.make()
  run List<Block>.append(&mut veBlocks, Block {
    suspends: false,
    statements: List<Statement>.make(),
    terminator: Terminator.Call {call: run CallBox.make(CallTerminator {
      callee: Callee.Instance {key: InstanceKey.copy(&vBodyKey)},
      arguments: move veCallArgs,
      providers: List<Operand>.make(),
      diagnostics: Option<Diagnostics>.none(),
      destination: placeOf(0),
      normal: 1,
      failure: Option<FailureEdge>.none(),
      origin: origin0(),
    })},
  })
  run List<Block>.append(&mut veBlocks, Block {suspends: false, statements: List<Statement>.make(), terminator: Terminator.Return {origin: origin0()}})
  let veMir = run makeMir(InstanceKey.copy(&vEntryKey), Interned<Type>.clone(&i64Ty), move veParams, move veLocals, move veBlocks, true)
  let veLowered = match move run Effect.result(SsaLower.lower(
    &veMir, &darwin, List<TypeLayout>.asSlice(&layouts), &[], List<InstanceIdentity>.asSlice(&vIds),
    &noSuspension, false, true, Level.Speed, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => { run Testing.expect(false, "darwin variadic export should lower") return () }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let vef = &List<LoweredFunction>.asSlice(&veLowered.functions)[usize.ZERO].function
  run Testing.expect(vef.callingConvention == CallingConvention.C && vef.variadic, "darwin variadic export marks C and variadic")
  run Testing.expect(countOperationKind(vef, 3) == usize.ONE && countOperationKind(vef, 4) == usize.ONE,
    "darwin variadic export emits VaStart and VaEnd")

  // Variadic extern C call with i8 -> i32 (SExt) and f32 -> f64 (FPExt) promotions.
  let cPrintfId = run declId(b"darwin_var_printf")
  let mut extParams = List<CLane>.make()
  run List<CLane>.append(&mut extParams, CLane {
    ty: Interned<Type>.clone(&i64Ty),
    layout: Metrics {size: 8, alignment: 8, abi: Abi.Integer, tagged: false, head: 0},
    extension: CExtension.None,
    passing: CPassing.Direct,
    pieces: List<CPiece>.make(),
    grouped: false,
    byval: false,
    stackAlignment: 0,
  })
  let mut foreign = List<CSignature>.make()
  run List<CSignature>.append(&mut foreign, CSignature {
    behavior: ForeignContract.conservative(),
    callbackContracts: Bytes.make(),
    declaration: Interned<DeclarationId>.clone(&cPrintfId),
    symbol: run Bytes.copy(b"darwin_var_printf"),
    importModule: Bytes.make(),
    importName: Bytes.make(),
    source: GapSource.Generated {declaration: Interned<DeclarationId>.clone(&cPrintfId)},
    result: CLane {
      ty: Interned<Type>.clone(&i32Ty),
      layout: Metrics {size: 4, alignment: 4, abi: Abi.Integer, tagged: false, head: 0},
      extension: CExtension.None,
      passing: CPassing.Direct,
      pieces: List<CPiece>.make(),
      grouped: false,
      byval: false,
      stackAlignment: 0,
    },
    parameters: move extParams,
    variadic: true,
    global: false,
  })

  let vcCallerId = run declId(b"call_darwin_var")
  let vcCallerKey = run InstanceKey.named(&vcCallerId)
  let mut vcParams = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut vcParams, Interned<Type>.clone(&i64Ty))
  run List<Interned<Type>>.append(&mut vcParams, Interned<Type>.clone(&i8Ty))
  run List<Interned<Type>>.append(&mut vcParams, Interned<Type>.clone(&f32Ty))
  let mut vcLocals = List<Local>.make()
  run List<Local>.append(&mut vcLocals, Local {ty: Interned<Type>.clone(&i32Ty), kind: LocalKind.Return, origin: origin0()})
  run List<Local>.append(&mut vcLocals, Local {ty: Interned<Type>.clone(&i64Ty), kind: LocalKind.Parameter {index: 0}, origin: origin0()})
  run List<Local>.append(&mut vcLocals, Local {ty: Interned<Type>.clone(&i8Ty), kind: LocalKind.Parameter {index: 1}, origin: origin0()})
  run List<Local>.append(&mut vcLocals, Local {ty: Interned<Type>.clone(&f32Ty), kind: LocalKind.Parameter {index: 2}, origin: origin0()})
  let mut vcArgs = List<Operand>.make()
  run List<Operand>.append(&mut vcArgs, Operand.Copy {place: placeOf(1)})
  run List<Operand>.append(&mut vcArgs, Operand.Copy {place: placeOf(2)})
  run List<Operand>.append(&mut vcArgs, Operand.Copy {place: placeOf(3)})
  let mut vcVar = List<VariadicArgument>.make()
  run List<VariadicArgument>.append(&mut vcVar, VariadicArgument {sourceType: Interned<Type>.clone(&i8Ty), promotedType: Interned<Type>.clone(&i32Ty)})
  run List<VariadicArgument>.append(&mut vcVar, VariadicArgument {sourceType: Interned<Type>.clone(&f32Ty), promotedType: Interned<Type>.clone(&f64Ty)})
  let mut vcBlocks = List<Block>.make()
  run List<Block>.append(&mut vcBlocks, Block {
    suspends: false,
    statements: List<Statement>.make(),
    terminator: Terminator.Call {call: run CallBox.make(CallTerminator {
      callee: Callee.Extern {declaration: Interned<DeclarationId>.clone(&cPrintfId), variadicArguments: move vcVar},
      arguments: move vcArgs,
      providers: List<Operand>.make(),
      diagnostics: Option<Diagnostics>.none(),
      destination: placeOf(0),
      normal: 1,
      failure: Option<FailureEdge>.none(),
      origin: origin0(),
    })},
  })
  run List<Block>.append(&mut vcBlocks, Block {suspends: false, statements: List<Statement>.make(), terminator: Terminator.Return {origin: origin0()}})
  let vcMir = run makeMir(InstanceKey.copy(&vcCallerKey), Interned<Type>.clone(&i32Ty), move vcParams, move vcLocals, move vcBlocks, false)
  let mut vcIds = List<InstanceIdentity>.make()
  run List<InstanceIdentity>.append(&mut vcIds, InstanceIdentity {key: InstanceKey.copy(&vcCallerKey), symbol: run Bytes.copy(b"call_darwin_var")})
  let vcLowered = match move run Effect.result(SsaLower.lower(
    &vcMir, &darwin, List<TypeLayout>.asSlice(&layouts), List<CSignature>.asSlice(&foreign),
    List<InstanceIdentity>.asSlice(&vcIds), &noSuspension, false, false, Level.Speed, true, false,
  )) {
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => { run Testing.expect(false, "darwin variadic extern C call should lower") return () }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let vcf = &List<LoweredFunction>.asSlice(&vcLowered.functions)[usize.ZERO].function
  let mut sawFixedCall = false
  let mut sawSExt = false
  let mut sawFPExt = false
  let mut bi = usize.ZERO
  while bi < vcf.blockCount() {
    let insts = List<usize>.asSlice(&vcf.block(bi).instructions)
    let mut ii = usize.ZERO
    while ii < insts.length {
      let inst = vcf.instruction(insts[ii])
      match inst.operation {
        Operation.Call {fixed, ..} => {
          if fixed == usize.ONE && vcf.operandsOf(insts[ii]).length == 3 { sawFixedCall = true }
        }
        Operation.Cast {operation} => {
          if operation == Cast.SExt && inst.kind.equals(Kind.integer(32)) { sawSExt = true }
          if operation == Cast.FPExt && inst.kind.equals(Kind.float(64)) { sawFPExt = true }
        }
        _ => {}
      }
      ii = ii + usize.ONE
    }
    bi = bi + usize.ONE
  }
  run Testing.expect(sawFixedCall && sawSExt && sawFPExt,
    "Darwin variadic C call records fixed=1 and promotes i8->i32 (SExt) and f32->f64 (FPExt)")
}
