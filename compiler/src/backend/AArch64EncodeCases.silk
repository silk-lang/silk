//! Unit checks for `AArch64Encode`, `AArch64Asm`, `AArch64Object`, and `AArch64Helpers`.

import backend.AArch64Asm
import backend.AArch64Asm {AsmCallReloc, ConstraintKind, OperandBinding, UnsupportedAsm}
import backend.AArch64Encode
import backend.AArch64Encode {ExtendKind, PairMode}
import backend.AArch64Helpers
import backend.AArch64Object
import backend.AArch64Object {Fragment, Function, Object, Pointer, Relocation, RelocationKind, RodataJumpEntry, UnwindInfo}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.testing.testing {AssertionError, Testing}

fn sameBytes(actual: &[u8], expected: &[u8]) -> bool {
  if actual.length != expected.length { return false }
  let mut at = usize.ZERO
  while at < actual.length {
    if actual[at] != expected[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn readWordLe(bytes: &[u8], at: usize) -> u32 {
  return u8.toU32(bytes[at])
    | u32.shiftLeft(u8.toU32(bytes[at + 1]), 8)
    | u32.shiftLeft(u8.toU32(bytes[at + 2]), 16)
    | u32.shiftLeft(u8.toU32(bytes[at + 3]), 24)
}

test effect fn encodesGprControlPatchAndMemoryModes() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run gprAndMemClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn gprAndMemClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // 1. SP vs XZR distinctions (`mov fp, sp`, `mov sp, x9`, `mov x0, xzr`, `cmp sp, #16`).
  let mut buf = Bytes.make()
  run AArch64Encode.movSp64(&mut buf, AArch64Encode.fp(), AArch64Encode.sp())
  run AArch64Encode.movSp64(&mut buf, AArch64Encode.sp(), AArch64Encode.x9())
  run AArch64Encode.movRr64(&mut buf, AArch64Encode.x0(), AArch64Encode.xzr())
  run AArch64Encode.cmpImm(&mut buf, true, AArch64Encode.sp(), 16, false)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[
    0xFD, 0x03, 0x00, 0x91,
    0x3F, 0x01, 0x00, 0x91,
    0xE0, 0x03, 0x1F, 0xAA,
    0xFF, 0x43, 0x00, 0xF1,
  ]), "sp vs xzr encodings match llvm-mc")

  // 2. Logical immediate encoding positive & negative boundaries.
  run Testing.expect(Option<u32>.isSome(&AArch64Encode.encodeLogicalImm(true, 0x0101010101010101)), "repeating 8-bit bitmask encodes")
  run Testing.expect(Option<u32>.isSome(&AArch64Encode.encodeLogicalImm(true, 0x8000000000000001)), "wraparound 64-bit bitmask encodes")
  run Testing.expect(Option<u32>.isSome(&AArch64Encode.encodeLogicalImm(false, 0x55555555)), "alternating 32-bit bitmask encodes")
  run Testing.expect(!Option<u32>.isSome(&AArch64Encode.encodeLogicalImm(true, 0)), "zero is not a logical immediate")
  run Testing.expect(!Option<u32>.isSome(&AArch64Encode.encodeLogicalImm(true, u64.MAX)), "all-ones is not a logical immediate")
  run Testing.expect(!Option<u32>.isSome(&AArch64Encode.encodeLogicalImm(false, 0xFFFFFFFF)), "32-bit all-ones is not a logical immediate")
  run Testing.expect(!Option<u32>.isSome(&AArch64Encode.encodeLogicalImm(true, 0x1234)), "non-contiguous pattern is refused")

  // `movImm64` uses single-instruction `orr` for bitmask constants and `movz`/`movk` otherwise.
  buf = Bytes.make()
  run AArch64Encode.movImm64(&mut buf, AArch64Encode.x0(), 0x0101010101010101)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[
    0xE0, 0xC3, 0x00, 0xB2,
  ]), "logical bitmask constant materializes as single orr instruction matching llvm-mc")
  buf = Bytes.make()
  run AArch64Encode.movImm64(&mut buf, AArch64Encode.x0(), 0x123456789ABCDEF0)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[
    0x00, 0xDE, 0x9B, 0xD2,
    0x80, 0x57, 0xB3, 0xF2,
    0x00, 0xCF, 0xCA, 0xF2,
    0x80, 0x46, 0xE2, 0xF2,
  ]), "arbitrary 64-bit constant materializes as movz/movk sequence matching llvm-mc")

  // 3. Bit-ops (`rev` 64 vs 32, `rev32`), shifts, extensions, and `csinc`.
  buf = Bytes.make()
  run AArch64Encode.rev(&mut buf, true, AArch64Encode.x0(), AArch64Encode.x1())
  run AArch64Encode.rev(&mut buf, false, AArch64Encode.x0(), AArch64Encode.x1())
  run AArch64Encode.rev32(&mut buf, AArch64Encode.x0(), AArch64Encode.x1())
  run AArch64Encode.lslImm(&mut buf, true, AArch64Encode.x0(), AArch64Encode.x1(), 5)
  run AArch64Encode.sxtw(&mut buf, AArch64Encode.x0(), AArch64Encode.x1())
  run AArch64Encode.csinc(&mut buf, true, AArch64Encode.x0(), AArch64Encode.x0(), AArch64Encode.x0(), AArch64Encode.ccLo())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[
    0x20, 0x0C, 0xC0, 0xDA,
    0x20, 0x08, 0xC0, 0x5A,
    0x20, 0x08, 0xC0, 0xDA,
    0x20, 0xE8, 0x7B, 0xD3,
    0x20, 0x7C, 0x40, 0x93,
    0x00, 0x34, 0x80, 0x9A,
  ]), "rev/rev32/lsl/sxtw/csinc match llvm-mc")

  // 4. Branch range checks and patchers (including cross-4KB ADRP and 16B Q-reg `patchLdrSt12`).
  run Testing.expect(AArch64Encode.fitsB26(0, 134217724), "max positive b26 fits")
  run Testing.expect(!AArch64Encode.fitsB26(0, 134217728), "overflow b26 rejected")
  run Testing.expect(AArch64Encode.fitsImm19(0, 1048572), "max positive imm19 fits")
  run Testing.expect(!AArch64Encode.fitsImm19(0, 1048576), "overflow imm19 rejected")
  run Testing.expect(AArch64Encode.fitsImm14(0, 32764), "max positive imm14 fits")
  run Testing.expect(!AArch64Encode.fitsImm14(0, 32768), "overflow imm14 rejected")
  run Testing.expect(AArch64Encode.fitsAdr21(0, 1048575), "max positive adr21 fits")
  run Testing.expect(!AArch64Encode.fitsAdr21(0, 1048576), "overflow adr21 rejected")

  buf = Bytes.make()
  let bAt = run AArch64Encode.b(&mut buf)
  let bcAt = run AArch64Encode.bCond(&mut buf, AArch64Encode.ccNe())
  let cbAt = run AArch64Encode.cbnz(&mut buf, true, AArch64Encode.x9())
  let tbAt = run AArch64Encode.tbz(&mut buf, AArch64Encode.x1(), 63)
  let adrpAt = run AArch64Encode.adrp(&mut buf, AArch64Encode.x0())
  let addAt = Bytes.length(&buf)
  run AArch64Encode.addImm(&mut buf, true, AArch64Encode.x0(), AArch64Encode.x0(), 0, false)
  let ldrQAt = Bytes.length(&buf)
  run AArch64Encode.ldrFpImm(&mut buf, 16, AArch64Encode.v0(), AArch64Encode.x1(), 0)
  let endAt = Bytes.length(&buf)
  AArch64Encode.patchB26(&mut buf, bAt, endAt)
  AArch64Encode.patchBCond19(&mut buf, bcAt, endAt)
  AArch64Encode.patchCbz19(&mut buf, cbAt, endAt)
  AArch64Encode.patchTbz14(&mut buf, tbAt, endAt)
  AArch64Encode.patchAdrp21(&mut buf, adrpAt, 0x100001800, 0x100004FF0)
  AArch64Encode.patchAdd12(&mut buf, addAt, 0x100004FF0)
  AArch64Encode.patchLdrSt12(&mut buf, ldrQAt, 0x100004FF0)
  let bs = Bytes.asSlice(&buf)
  // Cross-4KB ADRP: page 0x100004 - 0x100001 = +3 pages -> immlo=3, immhi=0 -> 0xF0000000.
  run Testing.expect(readWordLe(bs, adrpAt) == 0xF0000000, "patchAdrp21 computes exact 4KB page delta")
  run Testing.expect(readWordLe(bs, addAt) == 0x913FC000, "patchAdd12 patches 0xFF0 offset")
  // 16-byte Q-reg load at page offset 0xFF0 -> imm12 = 0xFF0 >> 4 = 0xFF -> 0x3DC3FC20.
  run Testing.expect(readWordLe(bs, ldrQAt) == 0x3DC3FC20, "patchLdrSt12 scales 16B Q-reg offset by 16")
  run Testing.expect(readWordLe(bs, bAt) == 0x14000007, "patchB26 patches 7 words ahead")
  run Testing.expect(readWordLe(bs, bcAt) == 0x540000C1, "patchBCond19 patches 6 words ahead")
  run Testing.expect(readWordLe(bs, cbAt) == 0xB50000A9, "patchCbz19 patches 5 words ahead")
  run Testing.expect(readWordLe(bs, tbAt) == 0xB6F80081, "patchTbz14 patches 4 words ahead")

  // 5. Memory, register-offset (`Uxtw` vs `LSL #4` Q-reg), `ldp`/`stp`, barriers, and atomics.
  run Testing.expect(
    AArch64Encode.isValidRegOffExtend(ExtendKind.Uxtw)
      && AArch64Encode.isValidRegOffExtend(ExtendKind.Uxtx)
      && AArch64Encode.isValidRegOffExtend(ExtendKind.Sxtw)
      && AArch64Encode.isValidRegOffExtend(ExtendKind.Sxtx),
    "register-offset load/store admits Uxtw/Uxtx/Sxtw/Sxtx",
  )
  run Testing.expect(
    !AArch64Encode.isValidRegOffExtend(ExtendKind.Uxtb)
      && !AArch64Encode.isValidRegOffExtend(ExtendKind.Uxth)
      && !AArch64Encode.isValidRegOffExtend(ExtendKind.Sxtb)
      && !AArch64Encode.isValidRegOffExtend(ExtendKind.Sxth),
    "register-offset load/store rejects 8-bit/16-bit ExtendKind",
  )
  buf = Bytes.make()
  run AArch64Encode.stpGp(&mut buf, true, PairMode.PreIndex, AArch64Encode.fp(), AArch64Encode.lr(), AArch64Encode.sp(), -16)
  run AArch64Encode.ldpGp(&mut buf, true, PairMode.PostIndex, AArch64Encode.fp(), AArch64Encode.lr(), AArch64Encode.sp(), 16)
  run AArch64Encode.ldrFpImm(&mut buf, 16, AArch64Encode.v0(), AArch64Encode.x1(), 4080)
  run AArch64Encode.ldrFpRegOff(&mut buf, 16, AArch64Encode.v0(), AArch64Encode.x1(), AArch64Encode.x2(), ExtendKind.Uxtx, true)
  run AArch64Encode.ldrRegOff(&mut buf, 1, false, false, AArch64Encode.x0(), AArch64Encode.x1(), AArch64Encode.x2(), ExtendKind.Uxtw, false)
  run AArch64Encode.dmb(&mut buf, AArch64Encode.barrierIsh())
  run AArch64Encode.ldaxr(&mut buf, 8, AArch64Encode.x0(), AArch64Encode.x1())
  run AArch64Encode.stlxr(&mut buf, 8, AArch64Encode.x2(), AArch64Encode.x0(), AArch64Encode.x1())
  run AArch64Encode.casal(&mut buf, 8, AArch64Encode.x2(), AArch64Encode.x0(), AArch64Encode.x1())
  run AArch64Encode.lseAtomic(&mut buf, 8, 0, AArch64Encode.x2(), AArch64Encode.x0(), AArch64Encode.x1())
  run AArch64Encode.lseAtomic(&mut buf, 8, 8, AArch64Encode.x2(), AArch64Encode.x0(), AArch64Encode.x1())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[
    0xFD, 0x7B, 0xBF, 0xA9,
    0xFD, 0x7B, 0xC1, 0xA8,
    0x20, 0xFC, 0xC3, 0x3D,
    0x20, 0x78, 0xE2, 0x3C,
    0x20, 0x48, 0x62, 0x38,
    0xBF, 0x3B, 0x03, 0xD5,
    0x20, 0xFC, 0x5F, 0xC8,
    0x20, 0xFC, 0x02, 0xC8,
    0x20, 0xFC, 0xE2, 0xC8,
    0x20, 0x00, 0xE2, 0xF8,
    0x20, 0x80, 0xE2, 0xF8,
  ]), "pair, memory, barrier, LL/SC, and LSE atomic encodings match llvm-mc")
}

test effect fn encodesScalarFpNeonAndCryptoInstructions() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run neonCryptoClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn neonCryptoClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // Scalar FP encodings.
  let mut buf = Bytes.make()
  run AArch64Encode.fmovGpToFp(&mut buf, true, AArch64Encode.v0(), AArch64Encode.x1())
  run AArch64Encode.fmovFpToGp(&mut buf, false, AArch64Encode.x0(), AArch64Encode.v1())
  run AArch64Encode.fmadd(&mut buf, true, AArch64Encode.v0(), AArch64Encode.v1(), AArch64Encode.v2(), AArch64Encode.v3())
  run AArch64Encode.fcsel(&mut buf, true, AArch64Encode.v0(), AArch64Encode.v1(), AArch64Encode.v2(), AArch64Encode.ccGt())
  run AArch64Encode.fcvtzs(&mut buf, true, true, AArch64Encode.x0(), AArch64Encode.v1())
  run AArch64Encode.fcvtS2D(&mut buf, AArch64Encode.v0(), AArch64Encode.v1())
  run AArch64Encode.fcmpZero(&mut buf, true, AArch64Encode.v0())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[
    0x20, 0x00, 0x67, 0x9E,
    0x20, 0x00, 0x26, 0x1E,
    0x20, 0x0C, 0x42, 0x1F,
    0x20, 0xCC, 0x62, 0x1E,
    0x20, 0x00, 0x78, 0x9E,
    0x20, 0xC0, 0x22, 0x1E,
    0x08, 0x20, 0x60, 0x1E,
  ]), "scalar FP encodings match llvm-mc")

  // 128-bit NEON integer, permute, compare, shift (including shift=0 edge), and reductions.
  buf = Bytes.make()
  run AArch64Encode.dupGp(&mut buf, 1, AArch64Encode.v0(), AArch64Encode.x1())
  run AArch64Encode.dupElem(&mut buf, 4, AArch64Encode.v0(), AArch64Encode.v1(), 2)
  run AArch64Encode.insGp(&mut buf, 4, AArch64Encode.v0(), 2, AArch64Encode.x1())
  run AArch64Encode.insElem(&mut buf, 8, AArch64Encode.v0(), 1, AArch64Encode.v1(), 0)
  run AArch64Encode.umov(&mut buf, 8, AArch64Encode.x0(), AArch64Encode.v1(), 1)
  run AArch64Encode.smov(&mut buf, true, 2, AArch64Encode.x0(), AArch64Encode.v1(), 3)
  run AArch64Encode.vecShlImm(&mut buf, 4, AArch64Encode.v0(), AArch64Encode.v1(), 5)
  run AArch64Encode.vecUshrImm(&mut buf, 4, AArch64Encode.v0(), AArch64Encode.v1(), 5)
  run AArch64Encode.vecUshrImm(&mut buf, 4, AArch64Encode.v0(), AArch64Encode.v1(), 0)
  run AArch64Encode.vecSriImm(&mut buf, 4, AArch64Encode.v0(), AArch64Encode.v1(), 5)
  run AArch64Encode.vecSriImm(&mut buf, 8, AArch64Encode.v0(), AArch64Encode.v1(), 13)
  run AArch64Encode.vecCmeq(&mut buf, 1, AArch64Encode.v0(), AArch64Encode.v1(), AArch64Encode.v2())
  run AArch64Encode.vecCmgt(&mut buf, 4, AArch64Encode.v0(), AArch64Encode.v1(), AArch64Encode.v2())
  run AArch64Encode.vecCmhi(&mut buf, 4, AArch64Encode.v0(), AArch64Encode.v1(), AArch64Encode.v2())
  run AArch64Encode.vecCmge(&mut buf, 2, AArch64Encode.v0(), AArch64Encode.v1(), AArch64Encode.v2())
  run AArch64Encode.vecCmhs(&mut buf, 8, AArch64Encode.v0(), AArch64Encode.v1(), AArch64Encode.v2())
  run AArch64Encode.vecBsl(&mut buf, AArch64Encode.v0(), AArch64Encode.v1(), AArch64Encode.v2())
  run AArch64Encode.vecBit(&mut buf, AArch64Encode.v0(), AArch64Encode.v1(), AArch64Encode.v2())
  run AArch64Encode.vecTbl(&mut buf, AArch64Encode.v0(), AArch64Encode.v1(), AArch64Encode.v2())
  run AArch64Encode.vecAddv(&mut buf, 1, AArch64Encode.v0(), AArch64Encode.v1())
  run AArch64Encode.vecUmaxv(&mut buf, 1, AArch64Encode.v0(), AArch64Encode.v1())
  run AArch64Encode.vecUminv(&mut buf, 4, AArch64Encode.v0(), AArch64Encode.v1())
  run AArch64Encode.vecAddp(&mut buf, 4, AArch64Encode.v0(), AArch64Encode.v1(), AArch64Encode.v2())
  run AArch64Encode.vecAddpScalar2d(&mut buf, AArch64Encode.v0(), AArch64Encode.v1())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[
    0x20, 0x0C, 0x01, 0x4E,
    0x20, 0x04, 0x14, 0x4E,
    0x20, 0x1C, 0x14, 0x4E,
    0x20, 0x04, 0x18, 0x6E,
    0x20, 0x3C, 0x18, 0x4E,
    0x20, 0x2C, 0x0E, 0x4E,
    0x20, 0x54, 0x25, 0x4F,
    0x20, 0x04, 0x3B, 0x6F,
    0x20, 0x1C, 0xA1, 0x4E,
    0x20, 0x44, 0x3B, 0x6F,
    0x20, 0x44, 0x73, 0x6F,
    0x20, 0x8C, 0x22, 0x6E,
    0x20, 0x34, 0xA2, 0x4E,
    0x20, 0x34, 0xA2, 0x6E,
    0x20, 0x3C, 0x62, 0x4E,
    0x20, 0x3C, 0xE2, 0x6E,
    0x20, 0x1C, 0x62, 0x6E,
    0x20, 0x1C, 0xA2, 0x6E,
    0x20, 0x00, 0x02, 0x4E,
    0x20, 0xB8, 0x31, 0x4E,
    0x20, 0xA8, 0x30, 0x6E,
    0x20, 0xA8, 0xB1, 0x6E,
    0x20, 0xBC, 0xA2, 0x4E,
    0x20, 0xB8, 0xF1, 0x5E,
  ]), "128-bit NEON encodings match llvm-mc")

  // DotProd + AES + PMULL + SHA-256 crypto extensions.
  buf = Bytes.make()
  run AArch64Encode.vecUdot(&mut buf, AArch64Encode.v0(), AArch64Encode.v1(), AArch64Encode.v2())
  run AArch64Encode.vecSdot(&mut buf, AArch64Encode.v0(), AArch64Encode.v1(), AArch64Encode.v2())
  run AArch64Encode.aese(&mut buf, AArch64Encode.v0(), AArch64Encode.v1())
  run AArch64Encode.aesd(&mut buf, AArch64Encode.v0(), AArch64Encode.v1())
  run AArch64Encode.aesmc(&mut buf, AArch64Encode.v0(), AArch64Encode.v1())
  run AArch64Encode.aesimc(&mut buf, AArch64Encode.v0(), AArch64Encode.v1())
  run AArch64Encode.pmull(&mut buf, AArch64Encode.v0(), AArch64Encode.v1(), AArch64Encode.v2())
  run AArch64Encode.pmull2(&mut buf, AArch64Encode.v0(), AArch64Encode.v1(), AArch64Encode.v2())
  run AArch64Encode.sha256h(&mut buf, AArch64Encode.v0(), AArch64Encode.v1(), AArch64Encode.v2())
  run AArch64Encode.sha256h2(&mut buf, AArch64Encode.v0(), AArch64Encode.v1(), AArch64Encode.v2())
  run AArch64Encode.sha256su0(&mut buf, AArch64Encode.v0(), AArch64Encode.v1())
  run AArch64Encode.sha256su1(&mut buf, AArch64Encode.v0(), AArch64Encode.v1(), AArch64Encode.v2())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[
    0x20, 0x94, 0x82, 0x6E,
    0x20, 0x94, 0x82, 0x4E,
    0x20, 0x48, 0x28, 0x4E,
    0x20, 0x58, 0x28, 0x4E,
    0x20, 0x68, 0x28, 0x4E,
    0x20, 0x78, 0x28, 0x4E,
    0x20, 0xE0, 0xE2, 0x0E,
    0x20, 0xE0, 0xE2, 0x4E,
    0x20, 0x40, 0x02, 0x5E,
    0x20, 0x50, 0x02, 0x5E,
    0x20, 0x28, 0x28, 0x5E,
    0x20, 0x60, 0x02, 0x5E,
  ]), "DotProd, AES, PMULL, and SHA-256 encodings match llvm-mc")
}

test effect fn assemblesDarwinAArch64InlineAsmAndEnforcesReservedRegs() -> ()
! UnsupportedAsm | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run asmClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn asmClaims() -> () ! UnsupportedAsm | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // Register admission: ONLY x0..x17 and w0..w17; x18, x19..x30, sp, fp, lr, x00 rejected.
  run Testing.expect(Option<u8>.isSome(&AArch64Asm.parseRegisterName(b"x0")), "x0 admitted")
  run Testing.expect(Option<u8>.isSome(&AArch64Asm.parseRegisterName(b"w17")), "w17 admitted")
  run Testing.expect(!Option<u8>.isSome(&AArch64Asm.parseRegisterName(b"x18")), "x18 Darwin platform reg rejected")
  run Testing.expect(!Option<u8>.isSome(&AArch64Asm.parseRegisterName(b"w18")), "w18 rejected")
  run Testing.expect(!Option<u8>.isSome(&AArch64Asm.parseRegisterName(b"x19")), "callee-saved x19 rejected")
  run Testing.expect(!Option<u8>.isSome(&AArch64Asm.parseRegisterName(b"sp")), "sp rejected")
  run Testing.expect(!Option<u8>.isSome(&AArch64Asm.parseRegisterName(b"fp")), "fp rejected")
  run Testing.expect(!Option<u8>.isSome(&AArch64Asm.parseRegisterName(b"lr")), "lr rejected")
  run Testing.expect(!Option<u8>.isSome(&AArch64Asm.parseRegisterName(b"x00")), "leading-zero x00 rejected")

  // Constraints and clobbers (`flags`/`cc`/`memory` ignored, bit 18 never set).
  let cs = run AArch64Asm.parseConstraints(b"={x0},0,r,m,{x17}", true)
  let cSlice = List<AArch64Asm.Constraint>.asSlice(&cs)
  run Testing.expect(cSlice.length == 5, "five constraints parsed")
  run Testing.expect(cSlice[0].kind == ConstraintKind.FixedReg && cSlice[0].reg == 0 && cSlice[0].isOutput, "output x0")
  run Testing.expect(cSlice[1].kind == ConstraintKind.TiedOutput, "tied operand 0")
  run Testing.expect(cSlice[2].kind == ConstraintKind.AnyReg, "any reg")
  run Testing.expect(cSlice[3].kind == ConstraintKind.Memory, "memory constraint")
  run Testing.expect(cSlice[4].kind == ConstraintKind.FixedReg && cSlice[4].reg == 17, "input x17")
  let mask = AArch64Asm.parseClobberMask(b"x0,x17,x18,flags,cc,memory")
  run Testing.expect(mask == (1 | u64.shiftLeft(1, 17)), "clobber mask captures x0 and x17 and ignores x18/flags/cc/memory")

  // Assemble empty barrier + stdlib/test templates + `bl` call reloc.
  let mut code = Bytes.make()
  let mut relocs = List<AsmCallReloc>.make()
  run AArch64Asm.assemble(&mut code, &mut relocs, b"", &[])
  run Testing.expect(Bytes.length(&code) == usize.ZERO, "empty compiler barrier emits zero bytes")

  let bind0 = [OperandBinding {reg: 0, isMemory: false}, OperandBinding {reg: 1, isMemory: false}, OperandBinding {reg: 17, isMemory: false}]
  run AArch64Asm.assemble(&mut code, &mut relocs, b"yield; mrs $0, cntvct_el0; svc #0; adds $0, $1, $2; mov $0, #0; ldr $0, [$1, #8]; bl silk_trace_emit", &bind0)
  run Testing.expect(List<AsmCallReloc>.length(&relocs) == usize.ONE, "bl records one AsmCallReloc")
  let rel0 = &List<AsmCallReloc>.asSlice(&relocs)[0]
  run Testing.expect(rel0.offset == 24 && sameBytes(Bytes.asSlice(&rel0.symbol), b"silk_trace_emit"), "bl reloc points to instruction offset 24")
  run Testing.expect(sameBytes(Bytes.asSlice(&code), &[
    0x3F, 0x20, 0x03, 0xD5, // yield
    0x40, 0xE0, 0x3B, 0xD5, // mrs x0, cntvct_el0
    0x01, 0x00, 0x00, 0xD4, // svc #0
    0x20, 0x00, 0x11, 0xAB, // adds x0, x1, x17
    0x00, 0x00, 0x80, 0xD2, // mov x0, #0
    0x20, 0x04, 0x40, 0xF9, // ldr x0, [x1, #8]
    0x00, 0x00, 0x00, 0x94, // bl 0
  ]), "assembled Darwin inline asm templates match llvm-mc")

  // Negative controls: `x18`, `x19`, `sp`, and unknown mnemonic fail with `UnsupportedAsm`.
  let badTemplates = [b"mov x18, #1", b"mov x19, #1", b"mov sp, x0", b"bogus_insn x0"]
  let mut idx = usize.ZERO
  while idx < 4 {
    let mut badOut = Bytes.make()
    let mut badRel = List<AsmCallReloc>.make()
    let failed = match move run Effect.result(AArch64Asm.assemble(&mut badOut, &mut badRel, badTemplates[idx], &[])) {
      Result<(), UnsupportedAsm | OutOfMemoryError>.Success {..} => false
      Result<(), UnsupportedAsm | OutOfMemoryError>.Failure {error} => match move error {
        UnsupportedAsm _ => true
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
    run Testing.expect(failed, "disallowed register or unknown mnemonic fails with UnsupportedAsm")
    idx = idx + usize.ONE
  }

  // Whitespace-padded constraint lists classify identically to compact lists.
  let spacedCs = run AArch64Asm.parseConstraints(b"=r, m, 0, {x5}", true)
  let spacedSlice = List<AArch64Asm.Constraint>.asSlice(&spacedCs)
  run Testing.expect(spacedSlice.length == 4, "four whitespace-padded constraints parsed")
  run Testing.expect(spacedSlice[0].kind == ConstraintKind.AnyReg && spacedSlice[0].isOutput, "spaced output =r")
  run Testing.expect(spacedSlice[1].kind == ConstraintKind.Memory && !spacedSlice[1].isOutput, "spaced memory m")
  run Testing.expect(spacedSlice[2].kind == ConstraintKind.TiedOutput, "spaced tied operand 0")
  run Testing.expect(spacedSlice[3].kind == ConstraintKind.FixedReg && spacedSlice[3].reg == 5, "spaced fixed reg {x5}")

  // Edge immediates (`i64.MIN`, `u64` max, negative `add`/`sub`, valid `xzr` slots).
  let mut edgeCode = Bytes.make()
  let mut edgeRelocs = List<AsmCallReloc>.make()
  run AArch64Asm.assemble(
    &mut edgeCode,
    &mut edgeRelocs,
    b"mov x0, #-9223372036854775808; mov x0, #-0x8000000000000000; mov x0, #9223372036854775808; mov x0, #18446744073709551615; and x0, x1, #0x8000000000000000; add x0, x1, #-16; sub x0, x1, #-4096; tst xzr, #1; adds xzr, x0, #1; and x0, xzr, #1",
    &[],
  )
  run Testing.expect(sameBytes(Bytes.asSlice(&edgeCode), &[
    0x00, 0x00, 0xF0, 0xD2,
    0x00, 0x00, 0xF0, 0xD2,
    0x00, 0x00, 0xF0, 0xD2,
    0x00, 0x00, 0xE0, 0x92,
    0x20, 0x00, 0x41, 0x92,
    0x20, 0x40, 0x00, 0xD1,
    0x20, 0x04, 0x40, 0x91,
    0xFF, 0x03, 0x40, 0xF2,
    0x1F, 0x04, 0x00, 0xB1,
    0xE0, 0x03, 0x40, 0x92,
  ]), "i64.MIN, u64, negative add/sub, and valid xzr immediate encodings match llvm-mc")

  // Negative controls: out-of-range immediates, 33-bit 32-bit logic imm, and xzr/wzr in sp-only slots.
  let badImmAndRegTemplates = [
    b"cmp x0, #-9223372036854775808",
    b"add x0, x1, #-9223372036854775808",
    b"add x0, x1, #18446744073709551617",
    b"mov x0, #18446744073709551616",
    b"mov x0, #0x10000000000000000",
    b"mov x0, #-9223372036854775809",
    b"mov x0, #-18446744073709551615",
    b"mov x0, #-0x8000000000000001",
    b"add x0, x1, #9223372036854775808",
    b"add x0, x1, #18446744073709551600",
    b"ldr x0, [x1, #18446744073709551608]",
    b"and w0, w1, #0x100000001",
    b"add xzr, x0, #1",
    b"add x0, xzr, #1",
    b"sub wzr, w0, #1",
    b"cmp xzr, #1",
    b"cmn wzr, #1",
    b"and xzr, x0, #1",
    b"orr wzr, w0, #1",
    b"eor xzr, x0, #1",
  ]
  idx = usize.ZERO
  while idx < badImmAndRegTemplates.length {
    let mut badOut = Bytes.make()
    let mut badRel = List<AsmCallReloc>.make()
    let failed = match move run Effect.result(AArch64Asm.assemble(&mut badOut, &mut badRel, badImmAndRegTemplates[idx], &[])) {
      Result<(), UnsupportedAsm | OutOfMemoryError>.Success {..} => false
      Result<(), UnsupportedAsm | OutOfMemoryError>.Failure {error} => match move error {
        UnsupportedAsm _ => true
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
    run Testing.expect(failed, "out-of-range immediate or xzr in sp-only slot fails with UnsupportedAsm")
    idx = idx + usize.ONE
  }

  // Negative controls: OperandBinding.reg >= 18 is rejected at both placeholder lookup sites.
  let badBindings = [
    OperandBinding {reg: 18, isMemory: false},
    OperandBinding {reg: 29, isMemory: false},
    OperandBinding {reg: 255, isMemory: false},
  ]
  let badBindTemplates = [b"mov $0, #1", b"ldr x0, [$0, #8]", b"mov $0, #1"]
  idx = usize.ZERO
  while idx < badBindings.length {
    let mut badOut = Bytes.make()
    let mut badRel = List<AsmCallReloc>.make()
    let singleBind = [badBindings[idx]]
    let failed = match move run Effect.result(AArch64Asm.assemble(&mut badOut, &mut badRel, badBindTemplates[idx], &singleBind)) {
      Result<(), UnsupportedAsm | OutOfMemoryError>.Success {..} => false
      Result<(), UnsupportedAsm | OutOfMemoryError>.Failure {error} => match move error {
        UnsupportedAsm _ => true
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
    run Testing.expect(failed, "out-of-contract OperandBinding reg >= 18 fails with UnsupportedAsm")
    idx = idx + usize.ONE
  }
}

test effect fn roundTripsAArch64FragmentsAndValidates128BitHelpers() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run fragmentAndHelpersClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn fragmentAndHelpersClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // 1. AArch64Object v2 Fragment encode/decode + all 10 RelocationKinds + `seen` bit 3 = 8.
  let mut frag = Fragment.make()
  let mut relocs = List<Relocation>.make()
  let kinds = [
    RelocationKind.Branch26,
    RelocationKind.Page21,
    RelocationKind.PageOff12,
    RelocationKind.GotLoadPage21,
    RelocationKind.GotLoadPageOff12,
    RelocationKind.Abs64,
    RelocationKind.LocalRodataPage21,
    RelocationKind.LocalRodataPageOff12,
    RelocationKind.TlvpLoadPage21,
    RelocationKind.TlvpLoadPageOff12,
  ]
  let mut k = usize.ZERO
  while k < 10 {
    run List<Relocation>.append(&mut relocs, Relocation {offset: k * 4, kind: kinds[k], target: 0, addend: 16})
    k = k + usize.ONE
  }
  let mut syms = List<Bytes>.make()
  run List<Bytes>.append(&mut syms, run Bytes.copy(b"target_sym"))
  let mut jumps = List<RodataJumpEntry>.make()
  run List<RodataJumpEntry>.append(&mut jumps, RodataJumpEntry {rodataOffset: 8, tableOffset: 8, targetCodeOffset: 12})
  let mut locs = List<u64>.make()
  run List<u64>.append(&mut locs, 0)
  run List<u64>.append(&mut locs, 0x0000000400000002)
  let mut code = Bytes.make()
  run AArch64Encode.ret(&mut code)
  let mut rodata = Bytes.make()
  run AArch64Encode.u64Le(&mut rodata, 0x1122334455667788)

  run List<Function>.append(&mut frag.functions, Function {
    symbol: run Bytes.copy(b"fn_a64"),
    exported: run Bytes.copy(b"fn_a64_c"),
    code: move code,
    relocations: move relocs,
    symbols: move syms,
    rodata: move rodata,
    rodataJumps: move jumps,
    unwind: UnwindInfo {hasFramePointer: true, prologueEnd: 8, savesEnd: 16, savedGpMask: 0x60000000, savedFpMask: 0x0300, frameBytes: 48},
    locations: move locs,
  })
  let mut seenImg = Bytes.make()
  run AArch64Encode.byte(&mut seenImg, 0)
  run AArch64Encode.u64Le(&mut seenImg, 0xAABBCCDDEEFF0011)
  run AArch64Encode.u64Le(&mut seenImg, 0x2233445566778899)
  run List<Object>.append(&mut frag.objects, Object {
    symbol: run Bytes.copy(b"fn_a64.silk_seen"),
    alignment: 1,
    image: move seenImg,
    pointers: List<Pointer>.make(),
    framed: false,
    local: false,
    readonly: false,
    seen: true,
  })
  run List<Bytes>.append(&mut frag.refused, run Bytes.copy(b"refused reason"))
  run List<Bytes>.append(&mut frag.declaredObjects, run Bytes.copy(b"extern_c_data"))

  let enc = run frag.encode()
  let encSlice = Bytes.asSlice(&enc)
  run Testing.expect(encSlice.length >= 8 && readWordLe(encSlice, 0) == 0x34366100, "v2 header has \\0a64 magic at +0")
  run Testing.expect(u32.toUsize(readWordLe(encSlice, 4)) == encSlice.length, "v2 header stores total byte length at +4")
  run Testing.expect(run AArch64Object.declaresObject(encSlice, b"extern_c_data"), "declaresObject finds extern_c_data")

  // Concatenated fragments decode cleanly.
  let mut combined = run Bytes.copy(encSlice)
  run Bytes.append(&mut combined, encSlice)
  let dec = run AArch64Object.decode(Bytes.asSlice(&combined))
  run Testing.expect(List<Function>.length(&dec.functions) == 2, "concatenated fragments decode 2 functions")
  run Testing.expect(List<Object>.length(&dec.objects) == 2, "concatenated fragments decode 2 objects")
  let f0 = &List<Function>.asSlice(&dec.functions)[0]
  run Testing.expect(List<Relocation>.length(&f0.relocations) == 10, "all 10 relocation kinds round-trip")
  let rSlice = List<Relocation>.asSlice(&f0.relocations)
  k = usize.ZERO
  while k < 10 {
    run Testing.expect(rSlice[k].kind == kinds[k] && rSlice[k].addend == 16, "relocation kind and addend preserved")
    k = k + usize.ONE
  }
  run Testing.expect(f0.unwind.hasFramePointer && f0.unwind.savesEnd == 16 && f0.unwind.savedFpMask == 0x0300 && f0.unwind.frameBytes == 48,
    "AArch64 UnwindInfo round-trips")
  run Testing.expect(List<u64>.length(&f0.locations) == 2, "debug locations round-trip")
  let o0 = &List<Object>.asSlice(&dec.objects)[0]
  run Testing.expect(o0.seen && !o0.framed && !o0.local && !o0.readonly, "seen object flag round-trips cleanly")
  run Testing.expect(List<Bytes>.length(&dec.refused) == 2, "refused entries round-trip")

  // 2. AArch64Helpers: 4 helpers, Branch26 relocs in signed helpers, zero x18 or x19..x28 usage.
  let mut helpers = List<Function>.make()
  run AArch64Helpers.appendAll(&mut helpers)
  let hs = List<Function>.asSlice(&helpers)
  run Testing.expect(hs.length == 4, "appendAll emits 4 128-bit helpers")
  run Testing.expect(sameBytes(Bytes.asSlice(&hs[0].symbol), b"__silk_udivti3"), "helper 0 is __silk_udivti3")
  run Testing.expect(sameBytes(Bytes.asSlice(&hs[1].symbol), b"__silk_umodti3"), "helper 1 is __silk_umodti3")
  run Testing.expect(sameBytes(Bytes.asSlice(&hs[2].symbol), b"__silk_divti3"), "helper 2 is __silk_divti3")
  run Testing.expect(sameBytes(Bytes.asSlice(&hs[3].symbol), b"__silk_modti3"), "helper 3 is __silk_modti3")
  run Testing.expect(List<Relocation>.length(&hs[2].relocations) == 1 && List<Relocation>.asSlice(&hs[2].relocations)[0].kind == RelocationKind.Branch26,
    "__silk_divti3 calls __silk_udivti3 via Branch26")
  run Testing.expect(sameBytes(Bytes.asSlice(&List<Bytes>.asSlice(&hs[2].symbols)[0]), b"__silk_udivti3"),
    "__silk_divti3 target symbol is __silk_udivti3")
  run Testing.expect(sameBytes(Bytes.asSlice(&List<Bytes>.asSlice(&hs[3].symbols)[0]), b"__silk_umodti3"),
    "__silk_modti3 target symbol is __silk_umodti3")

  let mut h = usize.ZERO
  while h < hs.length {
    let hCode = Bytes.asSlice(&hs[h].code)
    run Testing.expect(hCode.length >= 16 && (hCode.length & 3) == 0, "helper code is non-empty and 4-byte aligned")
    let mut off = usize.ZERO
    while off < hCode.length {
      let word = readWordLe(hCode, off)
      run Testing.expect(!helperWordTouchesReservedOrCalleeSaved(word), "helper instruction never encodes x18 or x19..x28")
      off = off + 4
    }
    h = h + usize.ONE
  }
}

fn isBadHelperReg(reg: u32) -> bool {
  return reg == 18 || (reg >= 19 && reg <= 28)
}

fn helperWordTouchesReservedOrCalleeSaved(word: u32) -> bool {
  // Skip immediate-only branches (`b`/`bl`, `b.cond`), `brk`, and `ret` (`x30`).
  let top6 = u32.shiftRight(word, 26)
  if top6 == 0x05 || top6 == 0x25 { return false }
  if u32.shiftRight(word, 24) == 0x54 { return false }
  if (word & 0xFFE0001F) == 0xD4200000 || word == 0xD65F03C0 { return false }
  let rt = word & 31
  let rn = u32.shiftRight(word, 5) & 31
  if isBadHelperReg(rt) || isBadHelperReg(rn) { return true }
  // `cbnz` / `tbz` / `movz` / `addImm`/`subsImm` / `ldr64Imm`/`str64Imm` only have `rt` and/or `rn`.
  let top8 = u32.shiftRight(word, 24)
  if top8 == 0x91 || top8 == 0xB5 || top8 == 0x36 || top8 == 0xB6 || top8 == 0xD2 || top8 == 0xF1 || top8 == 0xF9 {
    return false
  }
  // `stp`/`ldp` pair: `rt2` at `[14:10]` (fp=29, lr=30).
  if (word & 0x3A000000) == 0x28000000 {
    let rt2 = u32.shiftRight(word, 10) & 31
    return isBadHelperReg(rt2)
  }
  // 3-register data processing (`orr`/`eor`/`adds`/`subs`/`adcs`/`adc`/`sbcs`/`sbc`/`csel`/`csinc`/`udiv`/`msub`).
  let rm = u32.shiftRight(word, 16) & 31
  if isBadHelperReg(rm) { return true }
  if (word & 0x7FE08000) == 0x1B008000 {
    let ra = u32.shiftRight(word, 10) & 31
    if isBadHelperReg(ra) { return true }
  }
  return false
}
