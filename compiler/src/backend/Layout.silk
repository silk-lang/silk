//! Backend-neutral size, alignment, and ABI facts for scalar types.

import backend.Gap {Code as GapCode, Gap}
import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId}
import semantic.Target {Target}
import semantic.Type {Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.result {Result}
import silk.shared {Shared}
import silk.u32
import silk.usize

/// A scalar's target facts without an LLVM type or calling-convention spelling.
pub struct Layout {
  pub size: usize
  pub alignment: usize
  pub abi: Abi
}

impl Copy for Layout {}

/// How a scalar is passed and returned at the native function boundary.
pub enum Abi {
  Unit,
  Integer,
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

impl Layout {
  /// Resolves only B1 scalar forms; every other reached type reports its owner and source span.
  pub effect fn scalar(
    ty: &Shared<Type>,
    target: &Target,
    owner: &Shared<DeclarationId>,
    span: Span,
  ) -> Result<Layout, Gap> ! OutOfMemoryError ? &mut Allocator {
    let bits = Shared.with<Type, usize>(
      ty,
      fn(value: &Type) -> usize {
        return match & value.* {
          Type.Unit => usize.ZERO
          Type.Primitive {name} => {
            let text = Bytes.asSlice(&name)
            if same(text, b"bool") || same(text, b"i8") || same(text, b"u8") {
              return 8
            }
            if same(text, b"i16") || same(text, b"u16") {
              return 16
            }
            if same(text, b"i32") || same(text, b"u32") {
              return 32
            }
            if same(text, b"i64") || same(text, b"u64") {
              return 64
            }
            if same(text, b"isize") || same(text, b"usize") {
              return u32.toUsize(Target.pointerBits(target))
            }
            return usize.MAX
          }
          _ => usize.MAX
        }
      },
    )
    if bits == usize.MAX {
      return Result.failResult<Layout, Gap>(Gap.make(GapCode.ScalarLayout, owner, span))
    }
    if bits == usize.ZERO {
      return Result.succeed<Layout, Gap>(
        Layout {size: usize.ZERO, alignment: usize.ONE, abi: Abi.Unit},
      )
    }
    let bytes = bits / 8
    return Result.succeed<Layout, Gap>(Layout {size: bytes, alignment: bytes, abi: Abi.Integer})
  }
}
