//! Backend-neutral size, alignment, and ABI facts for runtime representations.

import semantic.Target {Target}
import semantic.Type {Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.shared {Shared}
import silk.u32
import silk.vector {Vector}
import silk.usize

/// A runtime representation's target facts without backend type spelling.
pub struct Layout {
  pub size: usize
  pub alignment: usize
  pub abi: Abi
  pub storage: Storage
}

/// Copyable boundary facts; field topology stays in the owning layout.
pub struct Metrics {
  pub size: usize
  pub alignment: usize
  pub abi: Abi
}

impl Copy for Metrics {}

/// Storage topology in declaration order, independent of backend type spelling.
pub union Storage {
  Scalar,
  Record {pub fields: Vector<Field>},
  /// Fixed elements retain one type and stride, without expanding the array length.
  Sequence {pub element: Shared<Type>, pub count: usize, pub stride: usize},
  /// A borrowed runtime view stores its address and logical length, not its elements.
  Slice {pub element: Shared<Type>, pub stride: usize, pub lengthOffset: usize},
  /// A structural union stores an unsigned tag at offset zero and one member at `payloadOffset`.
  /// `members` follow the union's canonical order, so member `tag` is `members[tag]`.
  Tagged {pub members: Vector<Shared<Type>>, pub tagSize: usize, pub payloadOffset: usize},
}

/// Tag width and payload position of a structural union.
pub struct Tagged {
  pub tagSize: usize
  pub payloadOffset: usize
}

impl Copy for Tagged {}

/// Compact contiguous-storage facts, including logical bounds for zero-size elements.
pub struct Sequence {
  pub element: Shared<Type>
  pub count: usize
  pub stride: usize
}

/// Neutral descriptor facts; element storage is borrowed and the length is runtime data.
pub struct Slice {
  pub element: Shared<Type>
  pub stride: usize
  pub lengthOffset: usize
}

/// One field's runtime type and byte offset in its enclosing record.
pub struct Field {
  pub ty: Shared<Type>
  pub offset: usize
}

/// A resolved field type and the child layout's target facts.
pub struct FieldInput {
  pub ty: Shared<Type>
  pub metrics: Metrics
}

/// A demanded runtime representation and its neutral target facts, supplied to emission.
pub struct TypeLayout {
  pub ty: Shared<Type>
  pub layout: Shared<Layout>
}

/// How a value is passed and returned at the native function boundary.
pub enum Abi {
  Unit,
  Integer,
  Floating,
  Pointer,
  Indirect,
}

fn alignUp(size: usize, alignment: usize) -> Option<usize> {
  if alignment == usize.ZERO { return Option.none<usize>() }
  let remainder = usize.remainder(size, alignment)
  let mut padding = usize.ZERO
  if remainder != usize.ZERO { padding = alignment - remainder }
  if padding > usize.MAX - size { return Option.none<usize>() }
  return Option.some<usize>(size + padding)
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

impl Layout {
  /// Returns the target's size, alignment and boundary classification.
  pub fn metrics(self: &Layout) -> Metrics {
    return Metrics {size: self.size, alignment: self.alignment, abi: self.abi}
  }

  /// Counts the declared fields retained by a record layout.
  pub fn fieldCount(self: &Layout) -> usize {
    return match &self.storage {
      Storage.Record {fields} => Vector.length<Field>(&fields)
      Storage.Sequence {count, ..} => count
      Storage.Slice {..} => usize.ZERO
      Storage.Tagged {..} => usize.ZERO
      Storage.Scalar => usize.ZERO
    }
  }

  /// Returns an owned field fact without retaining a loan of the layout cache.
  pub fn fieldAt(self: &Layout, index: usize) -> Option<Field> {
    if let Storage.Record {fields} = &self.storage {
      let entries = Vector.asSlice<Field>(&fields)
      if index < entries.length {
        return Option.some<Field>(Field {ty: Shared.clone<Type>(&entries[index].ty), offset: entries[index].offset})
      }
    }
    if let Storage.Sequence {element, count, stride} = &self.storage {
      if index < count {
        return Option.some<Field>(Field {ty: Shared.clone<Type>(&element), offset: index * stride})
      }
    }
    return Option.none<Field>()
  }

  /// Returns contiguous storage facts without retaining a loan of the layout cache.
  pub fn sequenceFacts(self: &Layout) -> Option<Sequence> {
    if let Storage.Sequence {element, count, stride} = &self.storage {
      return Option.some<Sequence>(Sequence {element: Shared.clone<Type>(&element), count: count, stride: stride})
    }
    return Option.none<Sequence>()
  }

  /// Reads descriptor offsets and the borrowed element stride without retaining a cache loan.
  pub fn sliceFacts(self: &Layout) -> Option<Slice> {
    if let Storage.Slice {element, stride, lengthOffset} = &self.storage {
      return Option.some<Slice>(Slice {element: Shared.clone<Type>(&element), stride: stride, lengthOffset: lengthOffset})
    }
    return Option.none<Slice>()
  }

  /// Reads a structural union's tag width and payload offset without retaining a cache loan.
  pub fn taggedFacts(self: &Layout) -> Option<Tagged> {
    if let Storage.Tagged {tagSize, payloadOffset, ..} = &self.storage {
      return Option.some<Tagged>(Tagged {tagSize: tagSize, payloadOffset: payloadOffset})
    }
    return Option.none<Tagged>()
  }

  /// The smallest unsigned tag width, in bytes, that distinguishes `count` members.
  pub fn tagBytes(count: usize) -> usize {
    if count <= 256 { return usize.ONE }
    if count <= 65536 { return 2 }
    return 4
  }

  /// Counts distinct child facts required by emission, independently of repeated storage.
  pub fn childCount(self: &Layout) -> usize {
    return match &self.storage {
      Storage.Scalar => usize.ZERO
      Storage.Record {fields} => Vector.length<Field>(&fields)
      Storage.Sequence {..} => usize.ONE
      Storage.Slice {..} => usize.ONE
      Storage.Tagged {members, ..} => Vector.length<Shared<Type>>(&members)
    }
  }

  /// Returns a child type whose layout must be supplied alongside this layout.
  pub fn childAt(self: &Layout, index: usize) -> Option<Shared<Type>> {
    return match &self.storage {
      Storage.Sequence {element, ..} => {
        if index == usize.ZERO { return Option.some<Shared<Type>>(Shared.clone<Type>(&element)) }
        return Option.none<Shared<Type>>()
      }
      Storage.Slice {element, ..} => {
        if index == usize.ZERO { return Option.some<Shared<Type>>(Shared.clone<Type>(&element)) }
        return Option.none<Shared<Type>>()
      }
      Storage.Record {fields} => {
        let entries = Vector.asSlice<Field>(&fields)
        if index < entries.length { return Option.some<Shared<Type>>(Shared.clone<Type>(&entries[index].ty)) }
        return Option.none<Shared<Type>>()
      }
      Storage.Tagged {members, ..} => {
        let entries = Vector.asSlice<Shared<Type>>(&members)
        if index < entries.length { return Option.some<Shared<Type>>(Shared.clone<Type>(&entries[index])) }
        return Option.none<Shared<Type>>()
      }
      Storage.Scalar => Option.none<Shared<Type>>()
    }
  }

  /// Resolves contiguous array storage, retaining logical bounds for empty and zero-size elements.
  pub fn sequence(element: &Shared<Type>, count: usize, child: Metrics) -> Option<Layout> {
    let padded = alignUp(child.size, child.alignment)
    let stride = match move padded {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return Option.none<Layout>() }
    }
    if stride != usize.ZERO && count > usize.MAX / stride { return Option.none<Layout>() }
    return Option.some<Layout>(Layout {
      size: count * stride, alignment: child.alignment, abi: Abi.Indirect,
      storage: Storage.Sequence {element: Shared.clone<Type>(element), count: count, stride: stride},
    })
  }

  /// Resolves a two-word borrowed descriptor and its element stride from demanded target facts.
  pub fn slice(element: &Shared<Type>, child: Metrics, target: &Target) -> Option<Layout> {
    let padded = alignUp(child.size, child.alignment)
    let stride = match move padded {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return Option.none<Layout>() }
    }
    let word = u32.toUsize(Target.pointerBits(target)) / 8
    let alignment = u32.toUsize(Target.pointerAlignment(target))
    return Option.some<Layout>(Layout {
      size: word + word, alignment: alignment, abi: Abi.Indirect,
      storage: Storage.Slice {element: Shared.clone<Type>(element), stride: stride, lengthOffset: word},
    })
  }

  /// Places an unsigned tag first and the largest member after it at the strictest member
  /// alignment; the size is rounded to the union's alignment. Order-independent in its inputs.
  pub effect fn tagged(inputs: &[FieldInput]) -> Option<Layout>
  ! OutOfMemoryError ? &mut Allocator {
    let tagSize = Layout.tagBytes(inputs.length)
    let mut alignment = tagSize
    let mut payload = usize.ZERO
    let mut members = Vector.make<Shared<Type>>()
    let mut at = usize.ZERO
    while at < inputs.length {
      let child = inputs[at].metrics
      if child.alignment > alignment { alignment = child.alignment }
      if child.size > payload { payload = child.size }
      run Vector.append<Shared<Type>>(&mut members, Shared.clone<Type>(&inputs[at].ty))
      at = at + usize.ONE
    }
    let offset = match move alignUp(tagSize, alignment) {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return Option.none<Layout>() }
    }
    if payload > usize.MAX - offset { return Option.none<Layout>() }
    return match move alignUp(offset + payload, alignment) {
      Option<usize>.Some {value} => Option.some<Layout>(Layout {
        size: value, alignment: alignment, abi: Abi.Indirect,
        storage: Storage.Tagged {members: move members, tagSize: tagSize, payloadOffset: offset},
      })
      Option<usize>.None => Option.none<Layout>()
    }
  }

  /// Lays fields out in declaration order, retaining padding and final record alignment.
  /// An unrepresentable size remains a structured layout gap at the query boundary.
  pub effect fn record(inputs: &[FieldInput]) -> Option<Layout>
  ! OutOfMemoryError ? &mut Allocator {
    let mut fields = Vector.make<Field>()
    let mut size = usize.ZERO
    let mut alignment = usize.ONE
    let mut at = usize.ZERO
    while at < inputs.length {
      let child = inputs[at].metrics
      let offset = alignUp(size, child.alignment)
      let aligned = match move offset {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return Option.none<Layout>() }
      }
      if child.size > usize.MAX - aligned { return Option.none<Layout>() }
      run Vector.append<Field>(&mut fields, Field {
        ty: Shared.clone<Type>(&inputs[at].ty), offset: aligned,
      })
      size = aligned + child.size
      if child.alignment > alignment { alignment = child.alignment }
      at = at + usize.ONE
    }
    let padded = alignUp(size, alignment)
    return match move padded {
      Option<usize>.Some {value} => Option.some<Layout>(Layout {
        size: value, alignment: alignment, abi: Abi.Indirect,
        storage: Storage.Record {fields: move fields},
      })
      Option<usize>.None => Option.none<Layout>()
    }
  }

  /// Resolves scalars and machine addresses; aggregate and slice facts remain explicit gaps.
  pub fn scalar(ty: &Shared<Type>, target: &Target) -> Option<Layout> {
    let pointer = Shared.with<Type, bool>(
      ty,
      fn(value: &Type) -> bool {
        return match & value.* {
          Type.Reference {..} => true
          Type.Pointer {..} => true
          _ => false
        }
      },
    )
    if pointer {
      let bytes = u32.toUsize(Target.pointerBits(target)) / 8
      return Option.some<Layout>(
        Layout {
          size: bytes,
          alignment: u32.toUsize(Target.pointerAlignment(target)),
          abi: Abi.Pointer,
          storage: Storage.Scalar,
        },
      )
    }
    let bits = Shared.with<Type, usize>(
      ty,
      fn(value: &Type) -> usize {
        return match & value.* {
          Type.Unit => usize.ZERO
          Type.Pointer {..} => u32.toUsize(Target.pointerBits(target))
          Type.Primitive {name} => {
            let text = Bytes.asSlice(&name)
            if same(text, b"bool") || same(text, b"i8") || same(text, b"u8") {
              return 8
            }
            if same(text, b"i16") || same(text, b"u16") {
              return 16
            }
            if same(text, b"i32") || same(text, b"u32") || same(text, b"f32") {
              return 32
            }
            if same(text, b"i64") || same(text, b"u64") || same(text, b"f64") {
              return 64
            }
            if same(text, b"isize") || same(text, b"usize") {
              return u32.toUsize(Target.pointerBits(target))
            }
            return usize.MAX
          }
          _ => usize.MAX
        }
      },
    )
    if bits == usize.MAX {
      return Option.none<Layout>()
    }
    if bits == usize.ZERO {
      return Option.some<Layout>(Layout {size: usize.ZERO, alignment: usize.ONE, abi: Abi.Unit, storage: Storage.Scalar})
    }
    let abi = Shared.with<Type, Abi>(
      ty,
      fn(value: &Type) -> Abi {
        return match & value.* {
          Type.Pointer {..} => Abi.Pointer
          Type.Primitive {name} => {
            let text = Bytes.asSlice(&name)
            if same(text, b"f32") || same(text, b"f64") {
              return Abi.Floating
            }
            return Abi.Integer
          }
          _ => Abi.Integer
        }
      },
    )
    let bytes = bits / 8
    return Option.some<Layout>(Layout {size: bytes, alignment: bytes, abi: abi, storage: Storage.Scalar})
  }
}
