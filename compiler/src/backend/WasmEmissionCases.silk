//! The wasm code of hand-built SSA functions: which values pass on the wasm stack when the
//! emission keeps single-use values there, and which keep a local because an operation between
//! their definition and their use could change what they read.

import backend.SsaFunction {ArchOperation, Binary, Cast, Kind, Predicate, SsaFunction}
import backend.WasmEmission
import backend.WasmLocals
import backend.WasmObject {Relocation, RelocationKind, Unsupported}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.testing.testing {AssertionError, Testing}
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn startsWith(code: &[u8], prefix: &[u8]) -> bool {
  if code.length < prefix.length { return false }
  let mut at = usize.ZERO
  while at < prefix.length {
    if code[at] != prefix[at] { return false }
    at = at + usize.ONE
  }
  return true
}

// The code entry of `function`: its local declarations, then its code.
effect fn entryOf(function: &SsaFunction, trees: bool) -> Bytes ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let translated = run WasmEmission.emit(function, false, trees, false)
  return run Bytes.copy(Bytes.asSlice(&translated.entry))
}

effect fn entryOfSimd(function: &SsaFunction, trees: bool) -> Bytes ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let translated = run WasmEmission.emit(function, false, trees, true)
  return run Bytes.copy(Bytes.asSlice(&translated.entry))
}

// `(a + b) * c`, or `(a + b) * (a + b)` when `twice`.
effect fn product(twice: bool) -> SsaFunction ! OutOfMemoryError ? &mut Allocator {
  let mut function = run SsaFunction.make(b"product", 32)
  let int = Kind.integer(32)
  let a = run function.argument(int)
  let b = run function.argument(int)
  let c = run function.argument(int)
  function.setResult(int)
  let entry = run function.newBlock()
  function.startBlock(entry)
  let sum = run function.binary(Binary.Add, a, b)
  let mut other = c
  if twice { other = sum }
  let scaled = run function.binary(Binary.Mul, sum, other)
  run function.ret(scaled)
  run function.finish()
  return move function
}

test effect fn singleUseValuesStayOnTheStack() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run stackClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn stackClaims() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let single = run product(false)
  let stacked = run entryOf(&single, true)
  // No locals; local.get 0, local.get 1, i32.add, local.get 2, i32.mul, return, unreachable, end.
  run Testing.expect(same(Bytes.asSlice(&stacked), &[0, 0x20, 0, 0x20, 1, 0x6A, 0x20, 2, 0x6C, 0x0F, 0x00, 0x0B]),
    "a sum used once and the returned product pass on the stack")
  let plain = run entryOf(&single, false)
  // One run of two `i32` locals.
  run Testing.expect(startsWith(Bytes.asSlice(&plain), &[1, 2, 0x7F]), "without trees each result has a local")
  let twice = run product(true)
  let kept = run entryOf(&twice, true)
  // One `i32` local; local.get 0, local.get 1, i32.add, local.tee 3, local.get 3, i32.mul, return, unreachable, end.
  run Testing.expect(same(Bytes.asSlice(&kept), &[1, 1, 0x7F, 0x20, 0, 0x20, 1, 0x6A, 0x22, 3, 0x20, 3, 0x6C, 0x0F, 0x00, 0x0B]),
    "a sum used twice keeps its local")
}

test effect fn readsStayBeforeSideEffects() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run orderClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A load of `p`, returned after one is added to it; with `between`, a store through `q` lies
// between the load and the sum.
effect fn loaded(between: bool) -> SsaFunction ! OutOfMemoryError ? &mut Allocator {
  let mut function = run SsaFunction.make(b"loaded", 32)
  let int = Kind.integer(32)
  let p = run function.argument(Kind.address(32))
  let q = run function.argument(Kind.address(32))
  function.setResult(int)
  let entry = run function.newBlock()
  function.startBlock(entry)
  let read = run function.load(int, p, 0, 4)
  let seven = run function.integer(32, 7)
  let one = run function.integer(32, 1)
  if between { run function.store(seven, q, 0, 4) }
  let sum = run function.binary(Binary.Add, read, one)
  run function.ret(sum)
  run function.finish()
  return move function
}

effect fn orderClaims() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let free = run loaded(false)
  let moved = run entryOf(&free, true)
  // No locals; local.get 0, i32.load align=2, i32.const 1, i32.add, return, unreachable, end.
  run Testing.expect(same(Bytes.asSlice(&moved), &[0, 0x20, 0, 0x28, 2, 0, 0x41, 1, 0x6A, 0x0F, 0x00, 0x0B]),
    "a load with nothing between it and its use passes on the stack")
  let stored = run loaded(true)
  let held = run entryOf(&stored, true)
  // One `i32` local; the load is set before the store: local.get 0, i32.load align=2, local.set 2,
  // local.get 1, i32.const 7, i32.store align=2, local.get 2, i32.const 1, i32.add, return, unreachable, end.
  run Testing.expect(same(Bytes.asSlice(&held), &[1, 1, 0x7F, 0x20, 0, 0x28, 2, 0, 0x21, 2, 0x20, 1, 0x41, 7, 0x36, 2, 0, 0x20, 2, 0x41, 1,
    0x6A, 0x0F, 0x00, 0x0B]), "a load a store follows runs before the store")
}

test effect fn exitsAndRepeatedPushesTakeDeferredValues() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run exitClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn exitClaims() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let int = Kind.integer(32)
  let mut branching = run SsaFunction.make(b"branching", 32)
  let a = run branching.argument(int)
  let b = run branching.argument(int)
  branching.setResult(int)
  let entry = run branching.newBlock()
  let low = run branching.newBlock()
  let high = run branching.newBlock()
  branching.startBlock(entry)
  let below = run branching.compare(Predicate.Ult, a, b)
  run branching.branchIf(below, low, high)
  branching.startBlock(low)
  run branching.ret(a)
  branching.startBlock(high)
  run branching.ret(b)
  run branching.finish()
  let branched = run entryOf(&branching, true)
  // No locals; local.get 0, local.get 1, i32.lt_u, if.
  run Testing.expect(startsWith(Bytes.asSlice(&branched), &[0, 0x20, 0, 0x20, 1, 0x49, 0x04]), "a branch takes its condition from the stack")

  // An ordered comparison pushes each operand twice, so the deferred sum is kept in a local
  // where its first push put it.
  let float = Kind.float(32)
  let mut ordered = run SsaFunction.make(b"ordered", 32)
  let x = run ordered.argument(float)
  let y = run ordered.argument(float)
  let z = run ordered.argument(float)
  ordered.setResult(Kind.flag())
  let only = run ordered.newBlock()
  ordered.startBlock(only)
  let sum = run ordered.binary(Binary.Add, x, y)
  let both = run ordered.compare(Predicate.Ord, sum, z)
  run ordered.ret(both)
  run ordered.finish()
  let compared = run entryOf(&ordered, true)
  // One `f32` local; local.get 0, local.get 1, f32.add, local.tee 3, local.get 3,
  // f32.eq, local.get 2, local.get 2, f32.eq, i32.and, return, unreachable, end.
  run Testing.expect(same(Bytes.asSlice(&compared), &[1, 1, 0x7D, 0x20, 0, 0x20, 1, 0x92, 0x22, 3, 0x20, 3, 0x5B, 0x20, 2, 0x20, 2,
    0x5B, 0x71, 0x0F, 0x00, 0x0B]), "a deferred value pushed twice is computed once")
}

test effect fn checkedSumsStayInTheirWidth() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkedClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// `a + b` or `a - b` of `bits`-wide integers, trapping on overflow.
effect fn checked(operation: Binary, signed: bool, bits: usize) -> SsaFunction ! OutOfMemoryError ? &mut Allocator {
  let mut function = run SsaFunction.make(b"checked", 32)
  let int = Kind.integer(bits)
  let a = run function.argument(int)
  let b = run function.argument(int)
  function.setResult(int)
  let entry = run function.newBlock()
  let failed = run function.newBlock()
  let passed = run function.newBlock()
  function.startBlock(entry)
  let sum = run function.overflowing(operation, signed, a, b)
  run function.branchIf(sum.overflow, failed, passed)
  function.startBlock(failed)
  run function.trap()
  function.startBlock(passed)
  run function.ret(sum.value)
  run function.finish()
  return move function
}

effect fn checkedClaims() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // The sum stays in a local and the branch consumes the flag directly from the stack.
  let unsignedSum = run checked(Binary.Add, false, 32)
  let added = run entryOf(&unsignedSum, true)
  // local.get 0, local.get 1, i32.add, local.tee 2, local.get 0, i32.lt_u, if.
  run Testing.expect(startsWith(Bytes.asSlice(&added), &[1, 1, 0x7F, 0x20, 0, 0x20, 1, 0x6A, 0x22, 2, 0x20, 0, 0x49, 0x04]),
    "an unsigned 32-bit sum overflowed when it is below an operand")
  let unsignedDifference = run checked(Binary.Sub, false, 32)
  let subtracted = run entryOf(&unsignedDifference, true)
  // local.get 0, local.get 1, i32.sub, local.set 2, local.get 0, local.get 1, i32.lt_u, if.
  run Testing.expect(startsWith(Bytes.asSlice(&subtracted), &[1, 1, 0x7F, 0x20, 0, 0x20, 1, 0x6B, 0x21, 2, 0x20, 0, 0x20, 1, 0x49, 0x04]),
    "an unsigned 32-bit difference overflowed when the left is below the right")
  let signedSum = run checked(Binary.Add, true, 32)
  let signedAdded = run entryOf(&signedSum, true)
  // local.get 0, local.get 1, i32.add, local.tee 2, local.get 0, i32.xor,
  // local.get 1, local.get 2, i32.xor, i32.and, i32.const 0, i32.lt_s, if.
  run Testing.expect(startsWith(Bytes.asSlice(&signedAdded), &[1, 1, 0x7F, 0x20, 0, 0x20, 1, 0x6A, 0x22, 2, 0x20, 0, 0x73, 0x20, 1,
    0x20, 2, 0x73, 0x71, 0x41, 0, 0x48, 0x04]), "a signed 32-bit sum overflowed when its sign differs from both operands'")
  let narrowSum = run checked(Binary.Add, false, 8)
  let narrow = run entryOf(&narrowSum, true)
  // Two `i32` locals, the first holding the exact sum: local.get 0, local.get 1, i32.add, local.tee 2,
  // i32.const 255, i32.and, local.set 3, local.get 2, i32.const 8, i32.shr_u, if.
  run Testing.expect(startsWith(Bytes.asSlice(&narrow), &[1, 2, 0x7F, 0x20, 0, 0x20, 1, 0x6A, 0x22, 2, 0x41, 0xFF, 0x01, 0x71, 0x21, 3, 0x20, 2,
    0x41, 8, 0x76, 0x04]), "an unsigned 8-bit sum overflowed when it carries into bit 8")
}

test effect fn deferredOperationsKeepTheLocalsTheyUse() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run scratchClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// An element of a vector at a run-time index is chosen through the result's own local, so the
// deferred result keeps that local declared.
effect fn scratchClaims() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let int = Kind.integer(32)
  let mut function = run SsaFunction.make(b"element", 32)
  let vector = run function.argument(Kind.vector(int, 2))
  let index = run function.argument(int)
  function.setResult(int)
  let entry = run function.newBlock()
  function.startBlock(entry)
  let element = run function.extractElement(vector, index)
  run function.ret(element)
  run function.finish()
  let code = run entryOf(&function, true)
  // One `i32` local, local 3 after the vector's two lanes and the index; local.get 0,
  // local.set 3, local.get 1, local.get 3, local.get 2, i32.const 1, i32.eq, select, return.
  run Testing.expect(same(Bytes.asSlice(&code), &[1, 1, 0x7F, 0x20, 0, 0x21, 3, 0x20, 1, 0x20, 3, 0x20, 2, 0x41, 1, 0x46, 0x1B, 0x0F, 0x00, 0x0B]),
    "the chosen element's local is declared and the last choice is returned from the stack")
}

test effect fn denseSwitchesAreTables() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run switchClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A switch on the argument with four cases `step` apart from `first`, each returning its own
// constant, and a default.
effect fn switching(first: u64, step: u64) -> SsaFunction ! OutOfMemoryError ? &mut Allocator {
  let mut function = run SsaFunction.make(b"switching", 32)
  let int = Kind.integer(32)
  let value = run function.argument(int)
  function.setResult(int)
  let entry = run function.newBlock()
  let fallback = run function.newBlock()
  let mut pairs = List<u64>.make()
  let mut targets = List<usize>.make()
  let mut at: u64 = 0
  while at < 4 {
    let target = run function.newBlock()
    run List<usize>.append(&mut targets, target)
    run List<u64>.append(&mut pairs, first + at * step)
    run List<u64>.append(&mut pairs, usize.toU64(target))
    at = at + 1
  }
  function.startBlock(entry)
  run function.switch(value, List<u64>.asSlice(&pairs), fallback)
  function.startBlock(fallback)
  let missed = run function.integer(32, 99)
  run function.ret(missed)
  let mut each = usize.ZERO
  while each < 4 {
    function.startBlock(List<usize>.get(&targets, each))
    let answer = run function.integer(32, usize.toU64(each))
    run function.ret(answer)
    each = each + usize.ONE
  }
  run function.finish()
  return move function
}

effect fn switchClaims() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let dense = run switching(10, 1)
  let table = run entryOf(&dense, true)
  // No locals; five blocks, one per target and the default's outermost; local.get 0,
  // i32.const 10, i32.sub, br_table with four entries to blocks 0 to 3 and default 4, end.
  run Testing.expect(startsWith(Bytes.asSlice(&table), &[0, 0x02, 0x40, 0x02, 0x40, 0x02, 0x40, 0x02, 0x40, 0x02, 0x40, 0x20, 0, 0x41, 10, 0x6B,
    0x0E, 4, 0, 1, 2, 3, 4, 0x0B]), "four adjacent cases are one table over the value less the least case")
  let sparse = run switching(0, 100)
  let chain = run entryOf(&sparse, true)
  // No locals; local.get 0, i32.const 0, i32.eq, if.
  run Testing.expect(startsWith(Bytes.asSlice(&chain), &[0, 0x20, 0, 0x41, 0, 0x46, 0x04, 0x40]), "cases far apart are tested one by one")
}

test effect fn framesOnlyEndingBlocksReadAreMadeThere() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run frameClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A function that stores its argument in a slot and reports the slot before it traps when
// `failed` holds, and otherwise returns the argument. With `reads` 1 the returning block reads
// the argument back from the slot; with 2 the entry block stores it there first as well.
effect fn reporting(reads: usize) -> SsaFunction ! OutOfMemoryError ? &mut Allocator {
  let mut function = run SsaFunction.make(b"reporting", 32)
  let int = Kind.integer(32)
  let failed = run function.argument(Kind.flag())
  let value = run function.argument(int)
  function.setResult(int)
  let entry = run function.newBlock()
  let trapping = run function.newBlock()
  let returning = run function.newBlock()
  function.startBlock(entry)
  let cell = run function.slotOf(4, 4)
  if reads == 2 { run function.store(value, cell, 0, 4) }
  run function.branchIf(failed, trapping, returning)
  function.startBlock(trapping)
  run function.store(value, cell, 0, 4)
  drop run function.call(b"report", &[cell], Kind.unit())
  run function.trap()
  function.startBlock(returning)
  let mut answer = value
  if reads != usize.ZERO { answer = run function.load(int, cell, 0, 4) }
  run function.ret(answer)
  run function.finish()
  return move function
}

effect fn frameClaims() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let cold = run reporting(usize.ZERO)
  let lazy = run entryOf(&cold, true)
  // Only the frame needs a local on the trapping path: local.get 0, if, and only then
  // global.get 0, i32.const 16, i32.sub, local.tee 2, global.set 0.
  run Testing.expect(startsWith(Bytes.asSlice(&lazy), &[1, 1, 0x7F, 0x20, 0, 0x04, 0x40, 0x23, 0, 0x41, 16, 0x6B, 0x22, 2, 0x24, 0]),
    "a frame only a trapping block reads is made in that block")
  run Testing.expect(!contains(Bytes.asSlice(&lazy), &[0x20, 2, 0x24, 0]), "a return that made no frame restores nothing")
  let ending = run reporting(usize.ONE)
  let ended = run entryOf(&ending, true)
  // The returning block makes the frame too, and its return gives it back: local.get 2,
  // global.set 0.
  run Testing.expect(startsWith(Bytes.asSlice(&ended), &[1, 2, 0x7F, 0x20, 0, 0x04, 0x40, 0x23, 0, 0x22, 2])
    && contains(Bytes.asSlice(&ended), &[0x20, 2, 0x24, 0]), "a frame the blocks that end the function read is made in each, and given back by the one that returns")
  let warm = run reporting(2)
  let eager = run entryOf(&warm, true)
  // global.get 0, local.tee 2, i32.const 16, i32.sub, local.tee 3, global.set 0 come first.
  run Testing.expect(startsWith(Bytes.asSlice(&eager), &[1, 2, 0x7F, 0x23, 0, 0x22, 2, 0x41, 16, 0x6B, 0x22, 3, 0x24, 0]),
    "a frame a block that goes on reads is made at entry")
}

fn contains(code: &[u8], part: &[u8]) -> bool {
  if part.length > code.length { return false }
  let mut start = usize.ZERO
  while start + part.length <= code.length {
    let mut at = usize.ZERO
    while at < part.length && code[start + at] == part[at] { at = at + usize.ONE }
    if at == part.length { return true }
    start = start + usize.ONE
  }
  return false
}

test effect fn edgeArgumentsPassOnTheStack() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run edgeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A loop over `(a, b, k)` that swaps `a` and `b` and counts `k` up to `n`. The back edge passes
// `b`, `a` and `k + 1`: all three are pushed before any of the loop's variables is set, so the
// swap needs no copy and the sum no local of its own.
effect fn edgeClaims() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let int = Kind.integer(32)
  let mut function = run SsaFunction.make(b"swapping", 32)
  let x = run function.argument(int)
  let y = run function.argument(int)
  let n = run function.argument(int)
  function.setResult(int)
  let entry = run function.newBlock()
  let head = run function.newBlock()
  let step = run function.newBlock()
  let done = run function.newBlock()
  let a = run function.addParameter(head, int)
  let b = run function.addParameter(head, int)
  let k = run function.addParameter(head, int)
  function.startBlock(entry)
  let zero = run function.integer(32, 0)
  run function.jumpWith(head, &[x, y, zero])
  function.startBlock(head)
  let more = run function.compare(Predicate.Ult, k, n)
  run function.branchIf(more, step, done)
  function.startBlock(step)
  let one = run function.integer(32, 1)
  let next = run function.binary(Binary.Add, k, one)
  run function.jumpWith(head, &[b, a, next])
  function.startBlock(done)
  run function.ret(a)
  run function.finish()
  let code = run entryOf(&function, true)
  // Three `i32` locals, the loop's variables 3, 4 and 5, and none for the comparison or the sum.
  run Testing.expect(startsWith(Bytes.asSlice(&code), &[1, 3, 0x7F]), "only the loop's variables are locals")
  // All three arguments push before the variables are set (no temporary copy for the swap), and
  // the increment stays on the stack (`i32.const 1, i32.add, local.set`).
  run Testing.expect(contains(Bytes.asSlice(&code), &[0x41, 1, 0x6A, 0x21]),
    "the back edge pushes its three arguments, then sets the three variables")
}

test effect fn aCastThatAnswersItsOperandLeavesTheOperandsLocal() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run aliasClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A pointer loaded through `p` and its bits as an integer, returned from the next block after a
// store through the pointer. The cast to an integer of the pointer's width has no code and
// answers the pointer's own value: though the cast's result is read once, the store reads the
// pointer too, so the pointer keeps its local for the block that returns.
effect fn aliasClaims() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let int = Kind.integer(32)
  let address = Kind.address(32)
  let mut function = run SsaFunction.make(b"aliased", 32)
  let p = run function.argument(address)
  function.setResult(int)
  let entry = run function.newBlock()
  let after = run function.newBlock()
  function.startBlock(entry)
  let pointer = run function.load(address, p, 0, 4)
  let word = run function.cast(Cast.PtrToInt, pointer, int)
  let seven = run function.integer(32, 7)
  run function.store(seven, pointer, 4, 4)
  run function.jump(after)
  function.startBlock(after)
  run function.ret(word)
  run function.finish()
  let code = run entryOf(&function, true)
  // One `i32` local; local.get 0, i32.load align=2, local.tee 1, i32.const 7, i32.store align=2 offset=4,
  // local.get 1, return, unreachable, end.
  run Testing.expect(same(Bytes.asSlice(&code), &[1, 1, 0x7F, 0x20, 0, 0x28, 2, 0, 0x22, 1, 0x41, 7, 0x36, 2, 4, 0x20, 1, 0x0F, 0x00, 0x0B]),
    "the store reads the pointer where it is set, and the next block reads its local")
}

test effect fn bitcastLoadsReadWordsAtTheOriginalOffset() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run wordLoadClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn wordLoadClaims() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"wordLoad", 32)
  let words = Kind.vector(Kind.integer(32), 4)
  let pointer = run function.argument(Kind.address(32))
  function.setResult(words)
  let entry = run function.newBlock()
  function.startBlock(entry)
  let bytes = run function.load(Kind.vector(Kind.integer(8), 16), pointer, 1, 1)
  let cast = run function.cast(Cast.Bitcast, bytes, words)
  run function.ret(cast)
  run function.finish()
  let code = run entryOf(&function, true)
  // Four i32 locals. The first two loads read directly from the argument at offsets 1 and 5.
  run Testing.expect(startsWith(Bytes.asSlice(&code), &[1, 4, 0x7F, 0x20, 0, 0x28, 0, 1, 0x21, 1, 0x20, 0, 0x28, 0, 5]),
    "a bitcast from loaded bytes reads unaligned words directly")
}

test effect fn localLifetimesIncludeBackEdgesAndInitialZeros() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run lifetimeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn lifetimeClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // Local 128 must survive a back edge across the write to 129. Local 130 is read as its
  // initial zero after the loop. The call has a linker-supplied operand at the next opcode.
  // Local 129's single write followed immediately by its single read is kept on the stack.
  let mut code = run Bytes.copy(&[0x41, 7, 0x21, 0x80, 1, 3, 0x40, 0x20, 0x80, 1, 0x1A, 0x41, 9, 0x21, 0x81, 1, 0x20, 0x81, 1, 0x0D, 0, 0x0B, 0x10, 0x20, 0x82, 1])
  let mut types = List<u8>.make()
  run List<u8>.appendRepeated(&mut types, 0x7F, 131)
  let mut fixes = List<Relocation>.make()
  run List<Relocation>.append(&mut fixes, Relocation {offset: 23, kind: RelocationKind.Call, target: 0, addend: 0})
  let mut places = List<u64>.make()
  run List<u64>.append(&mut places, 23)
  run List<u64>.append(&mut places, 7)
  run WasmLocals.coalesce(&mut code, &mut types, usize.ZERO, &mut fixes, &mut places)
  run Testing.expect(List<u8>.length(&types) == 3 && same(Bytes.asSlice(&code),
    &[0x41, 7, 0x21, 1, 3, 0x40, 0x20, 1, 0x1A, 0x41, 9, 0x0D, 0, 0x0B, 0x10, 0x20, 0]),
    "the loop-carried local and initial zero occupy distinct slots while single-use set+get stays on the stack")
  run Testing.expect(List<Relocation>.get(&fixes, usize.ZERO).offset == 15 && List<u64>.get(&places, usize.ZERO) == 15,
    "shorter indices and eliminated set+get move both the call relocation and the following source location")
}

test effect fn extendingALoadReadsOnlyItsOriginalBytes() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run extendingClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn extendingClaims() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"extended", 32)
  let ptr = run function.argument(Kind.address(32))
  function.setResult(Kind.integer(64))
  let block = run function.newBlock()
  function.startBlock(block)
  let word = run function.load(Kind.integer(32), ptr, 3, 1)
  let wide = run function.cast(Cast.SExt, word, Kind.integer(64))
  run function.ret(wide)
  run function.finish()
  let code = run entryOf(&function, true)
  run Testing.expect(contains(Bytes.asSlice(&code), &[0x20, 0, 0x34, 0, 3, 0x0F]), "i64.load32_s preserves the width, offset and sign extension")
}

test effect fn narrowShiftsKeepOnlyNecessaryMasks() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run narrowShiftClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn narrowShiftClaims() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut left: u64 = 1
  while left <= 2 {
    let mut f = run SsaFunction.make(b"byte_shift", 32)
    let x = run f.argument(Kind.integer(32))
    f.setResult(Kind.integer(8))
    drop run f.newBlock()
    let seven = run f.integer(32, 7)
    let low = run f.binary(Binary.And, x, seven)
    let amount = run f.cast(Cast.Trunc, low, Kind.integer(8))
    let operand = run f.integer(8, left)
    let shifted = run f.binary(Binary.Shl, operand, amount)
    run f.ret(shifted)
    run f.finish()
    let code = run entryOf(&f, true)
    let mask = contains(Bytes.asSlice(&code), &[0x41, 0xff, 0x01, 0x71])
    run Testing.expect(mask == (left == 2), "shifting one by up to seven places fits a byte, while shifting two can overflow it")
    left = left + 1
  }
}

test effect fn p1BranchFoldOffsetAndMultiUseTee() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run p1Claims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn p1Claims() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let int = Kind.integer(32)
  let ptr = Kind.address(32)

  // 1. Forward branch to a merge block emits `br_if` (with inverted compare) instead of `if/else/end`.
  let mut diamond = run SsaFunction.make(b"diamond", 32)
  let x = run diamond.argument(int)
  let y = run diamond.argument(int)
  diamond.setResult(int)
  let entry = run diamond.newBlock()
  let thenB = run diamond.newBlock()
  let merge = run diamond.newBlock()
  let res = run diamond.addParameter(merge, int)
  diamond.startBlock(entry)
  let cmp = run diamond.compare(Predicate.Ult, x, y)
  run diamond.branchIf(cmp, thenB, merge)
  diamond.startBlock(thenB)
  let one = run diamond.integer(32, 1)
  let inc = run diamond.binary(Binary.Add, x, one)
  run diamond.jumpWith(merge, &[inc])
  diamond.startBlock(merge)
  run diamond.ret(res)
  run diamond.finish()
  let dCode = run entryOf(&diamond, true)
  // `Ult` (0x49) inverted to `Uge` (0x4F) followed by `br_if 0` (0x0D, 0) and no `if` (0x04) / `else` (0x05).
  run Testing.expect(contains(Bytes.asSlice(&dCode), &[0x4F, 0x0D, 0]) && !contains(Bytes.asSlice(&dCode), &[0x05]),
    "a branch whose false arm is a merge block inverts its compare into br_if")

  // 2. `Offset` and `Index(Offset(base, 40), i)` fold the constant offset into the load memarg.
  let mut indexed = run SsaFunction.make(b"indexed_offset", 32)
  let base = run indexed.argument(ptr)
  let idx = run indexed.argument(int)
  indexed.setResult(int)
  let ib = run indexed.newBlock()
  indexed.startBlock(ib)
  let shifted = run indexed.offset(base, 40)
  let addr = run indexed.indexed(shifted, idx)
  let val = run indexed.load(int, addr, 0, 4)
  run indexed.ret(val)
  run indexed.finish()
  let iCode = run entryOf(&indexed, true)
  // Single `i32.add` (0x6A) and `i32.load align=2 offset=40` (0x28, 2, 40).
  run Testing.expect(contains(Bytes.asSlice(&iCode), &[0x28, 2, 40]),
    "Index over Offset folds the constant displacement into the load memarg")

  // 3. Multi-use value used immediately as first operand converts `local.set; local.get` into `local.tee`.
  let mut multi = run SsaFunction.make(b"multi_tee", 32)
  let a = run multi.argument(int)
  let b = run multi.argument(int)
  multi.setResult(int)
  let mb = run multi.newBlock()
  multi.startBlock(mb)
  let sum = run multi.binary(Binary.Add, a, b)
  let k1 = run multi.integer(32, 10)
  let k2 = run multi.integer(32, 3)
  let first = run multi.binary(Binary.Sub, sum, k1)
  let second = run multi.binary(Binary.Mul, first, sum)
  let final = run multi.binary(Binary.Add, second, k2)
  run multi.ret(final)
  run multi.finish()
  let mCode = run entryOf(&multi, true)
  run Testing.expect(contains(Bytes.asSlice(&mCode), &[0x6A, 0x22]) && !contains(Bytes.asSlice(&mCode), &[0x21]),
    "a multi-use value used immediately converts to local.tee without breaking expression trees")

  // 4. Negative wrapping 32-bit `Offset` (`-4`) must NOT fold into the unsigned Wasm memarg offset.
  let mut negOff = run SsaFunction.make(b"neg_offset", 32)
  let np = run negOff.argument(ptr)
  negOff.setResult(int)
  let nb = run negOff.newBlock()
  negOff.startBlock(nb)
  let back = run negOff.offset(np, 4294967292)
  let nval = run negOff.load(int, back, 0, 4)
  run negOff.ret(nval)
  run negOff.finish()
  let nCode = run entryOf(&negOff, true)
  run Testing.expect(contains(Bytes.asSlice(&nCode), &[0x6A, 0x28, 2, 0]),
    "a negative 32-bit offset stays an explicit wrapping i32.add before the load")
}

test effect fn p2ConstUDivRemInlineI128MulAndConstWideShift() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run p2Claims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn p2Claims() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let int = Kind.integer(32)
  let wide128 = Kind.integer(128)

  // 1. Unsigned constant division/remainder by 96 uses 64-bit reciprocal multiply, not i32.div_u/rem_u.
  let mut remFn = run SsaFunction.make(b"rem96", 32)
  let n = run remFn.argument(int)
  remFn.setResult(int)
  let rb = run remFn.newBlock()
  remFn.startBlock(rb)
  let c96 = run remFn.integer(32, 96)
  let r = run remFn.binary(Binary.URem, n, c96)
  run remFn.ret(r)
  run remFn.finish()
  let rCode = run entryOf(&remFn, true)
  run Testing.expect(contains(Bytes.asSlice(&rCode), &[0x7E]) && !contains(Bytes.asSlice(&rCode), &[0x70]) && !contains(Bytes.asSlice(&rCode), &[0x6E]),
    "u32 % 96 lowers to reciprocal i64.mul instead of i32.rem_u")

  // 2. 128-bit multiply emits inline 64-bit partial products without calling `__multi3`.
  let mut mulFn = run SsaFunction.make(b"mul128", 32)
  let a = run mulFn.argument(wide128)
  let b = run mulFn.argument(wide128)
  mulFn.setResult(wide128)
  let mb = run mulFn.newBlock()
  mulFn.startBlock(mb)
  let prod = run mulFn.binary(Binary.Mul, a, b)
  run mulFn.ret(prod)
  run mulFn.finish()
  let mCode = run entryOf(&mulFn, true)
  run Testing.expect(contains(Bytes.asSlice(&mCode), &[0x7E]) && !contains(Bytes.asSlice(&mCode), &[0x10]),
    "128-bit multiply lowers inline without a __multi3 call")

  // 3. 128-bit constant shift right by 64 specializes without `select`.
  let mut shrFn = run SsaFunction.make(b"shr64", 32)
  let v = run shrFn.argument(wide128)
  shrFn.setResult(wide128)
  let sb = run shrFn.newBlock()
  shrFn.startBlock(sb)
  let c64 = run shrFn.constant(wide128, 64)
  let shifted = run shrFn.binary(Binary.LShr, v, c64)
  run shrFn.ret(shifted)
  run shrFn.finish()
  let sCode = run entryOf(&shrFn, true)
  run Testing.expect(!contains(Bytes.asSlice(&sCode), &[0x1B]),
    "128-bit shift by constant 64 specializes without select")
}

test effect fn p3StackifySwapAndI64Switch() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run p3Claims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn p3Claims() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let int = Kind.integer(32)
  let wide = Kind.integer(64)

  // 1. Commutative `local.set X; local.get Y; local.get X; i32.add` swaps to `local.tee X; local.get Y; i32.add`.
  let mut swapFn = run SsaFunction.make(b"swap_tee", 32)
  let a = run swapFn.argument(int)
  let b = run swapFn.argument(int)
  swapFn.setResult(int)
  let sb = run swapFn.newBlock()
  swapFn.startBlock(sb)
  let t = run swapFn.binary(Binary.Mul, a, b)
  let u = run swapFn.binary(Binary.Add, a, t)
  let v = run swapFn.binary(Binary.Xor, t, u)
  run swapFn.ret(v)
  run swapFn.finish()
  let swapCode = run entryOf(&swapFn, true)
  run Testing.expect(contains(Bytes.asSlice(&swapCode), &[0x22]) && !contains(Bytes.asSlice(&swapCode), &[0x21]),
    "just-set operand swaps to first position so local.tee replaces local.set + local.get")

  // 2. 64-bit dense switch (>= 3 cases) emits a `br_table` (`0x0E`).
  let mut swFn = run SsaFunction.make(b"switch64", 32)
  let x = run swFn.argument(wide)
  swFn.setResult(int)
  let entry = run swFn.newBlock()
  let b0 = run swFn.newBlock()
  let b1 = run swFn.newBlock()
  let b2 = run swFn.newBlock()
  let bDef = run swFn.newBlock()
  swFn.startBlock(entry)
  run swFn.switch(x, &[0, usize.toU64(b0), 1, usize.toU64(b1), 2, usize.toU64(b2)], bDef)
  swFn.startBlock(b0)
  let r0 = run swFn.integer(32, 10)
  run swFn.ret(r0)
  swFn.startBlock(b1)
  let r1 = run swFn.integer(32, 20)
  run swFn.ret(r1)
  swFn.startBlock(b2)
  let r2 = run swFn.integer(32, 30)
  run swFn.ret(r2)
  swFn.startBlock(bDef)
  let rDef = run swFn.integer(32, 99)
  run swFn.ret(rDef)
  run swFn.finish()
  let swCode = run entryOf(&swFn, true)
  run Testing.expect(contains(Bytes.asSlice(&swCode), &[0x0E]),
    "64-bit switch with 3 dense cases lowers to br_table")
}

test effect fn p5NativeWasmSimd128() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run p5Claims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn p5Claims() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let u8K = Kind.integer(8)
  let u16K = Kind.integer(16)
  let u32K = Kind.integer(32)
  let ptrK = Kind.address(32)
  let v16 = Kind.vector(u8K, 16)
  let v4 = Kind.vector(u32K, 4)

  // 1. `u8x16` load + splat + eq + bitcast `<16 x i1>` -> `u16` emits `v128.load`, `i8x16.splat`,
  // `i8x16.eq`, and `i8x16.bitmask` with zero `v128` locals (all deferred on the stack).
  let mut f1 = run SsaFunction.make(b"simd_bitmask", 32)
  let p = run f1.argument(ptrK)
  let needle = run f1.argument(u8K)
  f1.setResult(u16K)
  let b1 = run f1.newBlock()
  f1.startBlock(b1)
  let chunk = run f1.load(v16, p, 0, 1)
  let target = run f1.splat(needle, 16)
  let eq = run f1.compare(Predicate.Eq, chunk, target)
  let mask = run f1.cast(Cast.Bitcast, eq, u16K)
  run f1.ret(mask)
  run f1.finish()
  let code1 = run entryOfSimd(&f1, true)
  let s1 = Bytes.asSlice(&code1)
  // Expect `0xFD 0x00` (v128.load), `0xFD 0x0F` (i8x16.splat), `0xFD 0x23` (i8x16.eq), `0xFD 0x64` (i8x16.bitmask).
  run Testing.expect(contains(s1, &[0xFD, 0x00]) && contains(s1, &[0xFD, 0x0F]) && contains(s1, &[0xFD, 0x23]) && contains(s1, &[0xFD, 0x64]),
    "u8x16 load+splat+eq+bitmask lowers to native v128.load, i8x16.splat, i8x16.eq, i8x16.bitmask")

  // 2. `u32x4` add + shuffle + rotate + bitselect emits native `i32x4.add`, `i8x16.shuffle`, `v128.or`, `v128.bitselect`.
  let mut f2 = run SsaFunction.make(b"simd_u32x4", 32)
  let a = run f2.argument(v4)
  let b = run f2.argument(v4)
  f2.setResult(v4)
  let b2 = run f2.newBlock()
  f2.startBlock(b2)
  let sum = run f2.binary(Binary.Add, a, b)
  let c7 = run f2.constant(v4, 7)
  let rot = run f2.rotate(true, sum, c7)
  let shuf = run f2.shuffle(rot, b, &[1, 2, 3, 4])
  let cond = run f2.compare(Predicate.Ult, a, b)
  let sel = run f2.select(cond, shuf, sum)
  run f2.ret(sel)
  run f2.finish()
  let code2 = run entryOfSimd(&f2, true)
  let s2 = Bytes.asSlice(&code2)
  // `i32x4.add` (0xFD 0xAE 0x01), `i8x16.shuffle` (0xFD 0x0D), `i32x4.lt_u` (0xFD 0x3A), `v128.bitselect` (0xFD 0x52).
  run Testing.expect(contains(s2, &[0xFD, 0xAE, 0x01]) && contains(s2, &[0xFD, 0x0D]) && contains(s2, &[0xFD, 0x3A]) && contains(s2, &[0xFD, 0x52]),
    "u32x4 add+rotate+shuffle+compare+select lowers to native Wasm simd128 instructions")

  // 3. `ArchOperation.WasmSwizzle` lowers to `i8x16.swizzle` (`0xFD 0x0E`).
  let mut f3 = run SsaFunction.make(b"simd_swizzle", 32)
  let tbl = run f3.argument(v16)
  let idxs = run f3.argument(v16)
  f3.setResult(v16)
  let b3 = run f3.newBlock()
  f3.startBlock(b3)
  let swz = run f3.archIntrinsic(ArchOperation.WasmSwizzle, 0, &[tbl, idxs], v16)
  run f3.ret(swz)
  run f3.finish()
  let code3 = run entryOfSimd(&f3, true)
  run Testing.expect(contains(Bytes.asSlice(&code3), &[0xFD, 0x0E]),
    "WasmSwizzle arch intrinsic lowers to i8x16.swizzle (0xFD 0x0E)")
}
