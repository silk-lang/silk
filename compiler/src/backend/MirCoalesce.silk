//! Copy coalescing on lowered MIR: removes the temporaries a call's result and its by-value
//! arguments pass through when nothing can observe the difference.
//!
//! # Details
//! Lowering gives each call a fresh temporary destination and a fresh snapshot of each argument, so
//! `return f(x)` copies `f`'s result into the function's own result, and `f(x)` copies `x` before the
//! call. For a large `Copy` struct each copy is a `memcpy` that LLVM keeps, because the callee may
//! write the address it receives. Two rewrites remove them:
//!
//! - A call whose temporary result is only moved or copied whole into the result local, or into
//!   another temporary, by the first statement of its continuation writes that place directly. The
//!   place must not be named by the call itself, borrowed anywhere, dropped anywhere, or named on the
//!   call's failure path.
//! - An argument that is a temporary snapshot of a place (a local and its constant field or element
//!   projections), taken in the call's own block with nothing after it touching that local, passes
//!   the place itself when the local is never borrowed and no block the call can continue to names
//!   it. The callee owns the storage it receives for the call, so the local must be dead afterwards.
//!
//! - A local that every return path moves or copies whole into the result local, as its last use,
//!   becomes the result local itself, so it is built in the caller's result storage.
//!
//! - An aggregate, variant or union operand that is a temporary snapshot of a place, taken earlier
//!   in the same block with nothing in between touching that place, reads the place itself. The
//!   operand is copied into the new value either way, so the place need not be dead afterwards. A
//!   wrapper such as an effect combinator builds its value around the effect it received without
//!   first moving that effect into a temporary.
//!
//! - A temporary written only whole and moved or copied whole into another temporary becomes that
//!   temporary, so each arm of an `if` or `match` writes the value of the whole expression. The
//!   backend then lets every call that writes such a temporary write a large `let` binding that
//!   the move alone defines (`joinBindings`).
//!
//! - A local built whole by one aggregate of moved locals, and otherwise named only through its
//!   fields, becomes those locals when it is an Effect or lives in a suspending frame. A composed
//!   Effect built from its function's parameters then runs on the parameters' own storage instead
//!   of a copy of them.
//!
//! All keep the invariants `MirVerification.callDestinationsFresh` checks: a destination is still a
//! whole temporary or the result local, never borrowed, and named by no argument.

import backend.MirVerification
import backend.Mir {
  AggregateField,
  AssemblyFragment,
  Block,
  Callee,
  Cancel,
  Diagnostics,
  FailureEdge,
  Local,
  LocalKind,
  MirFunction,
  Operand,
  Place,
  Projection,
  Rvalue,
  Variable,
  Statement,
  Terminator,
}
import semantic.Type {Type}
import semantic.TypedBody {Origin}
import semantic.Types {Types}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.box {Box}
import silk.mem.shared {Shared}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.num.usize

/// Rewrites `function`'s call results and by-value arguments to skip the temporaries they pass
/// through, where no reachable code can tell the difference.
pub effect fn coalesce(function: &mut MirFunction) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  // Collapsing first folds each return's own temporary into `_0 = r`, which the rename needs.
  run collapseCopies(&mut function.*)
  run mergeJoins(&mut function.*)
  run renameReturned(&mut function.*)
  let mut table = run UseTable.of(&function.*)
  run forwardFields(&mut function.*, &mut table)
  if hasCall(&function.*) {
    run forwardResults(&mut function.*, &mut table)
    run forwardArguments(&mut function.*, &mut table)
  }
  return run splitAggregates(&mut function.*)
}

// Whether `callee` follows the Silk calling convention rather than a C signature.
fn silkCallee(callee: &Callee) -> bool {
  return match &callee.* {
    Callee.Instance {..} => true
    Callee.Indirect {..} => true
    _ => false
  }
}

fn hasCall(function: &MirFunction) -> bool {
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    if let Terminator.Call {..} = &blocks[at].terminator { return true }
    at = at + usize.ONE
  }
  return false
}

// The whole local an operand copies or moves, or `usize.MAX`.
fn wholeLocal(operand: &Operand) -> usize {
  return match &operand.* {
    Operand.Copy {place} => wholePlace(&place)
    Operand.Move {place} => wholePlace(&place)
    _ => usize.MAX
  }
}

fn wholePlace(place: &Place) -> usize {
  if List<Projection>.length(&place.projections) != usize.ZERO { return usize.MAX }
  return place.local
}

fn isTemp(function: &MirFunction, local: usize) -> bool {
  return match &List<Local>.asSlice(&function.locals)[local].kind { LocalKind.Temp => true _ => false }
}

fn isReturn(function: &MirFunction, local: usize) -> bool {
  return match &List<Local>.asSlice(&function.locals)[local].kind { LocalKind.Return => true _ => false }
}

// Counts of how `function` names one local.
struct Uses {
  // Places that name the local: operands, destinations, drops and index projections.
  named: usize,
  // Shared or exclusive borrows and address-of of a place of the local.
  borrowed: bool,
  // Drops of a place of the local.
  dropped: bool,
}

impl Copy for Uses {}

fn placeNames(place: &Place, local: usize) -> usize {
  let mut count = usize.ZERO
  if place.local == local { count = usize.ONE }
  let steps = List<Projection>.asSlice(&place.projections)
  let mut at = usize.ZERO
  while at < steps.length {
    if let Projection.Index {local: index} = &steps[at] {
      if index == local { count = count + usize.ONE }
    }
    at = at + usize.ONE
  }
  return count
}

fn operandNames(operand: &Operand, local: usize) -> usize {
  return match &operand.* {
    Operand.Copy {place} => placeNames(&place, local)
    Operand.Move {place} => placeNames(&place, local)
    _ => usize.ZERO
  }
}

fn operandsName(operands: &List<Operand>, local: usize) -> usize {
  let listed = List<Operand>.asSlice(operands)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < listed.length {
    count = count + operandNames(&listed[at], local)
    at = at + usize.ONE
  }
  return count
}

fn fieldsName(fields: &List<AggregateField>, local: usize) -> usize {
  let listed = List<AggregateField>.asSlice(fields)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < listed.length {
    count = count + operandNames(&listed[at].value, local)
    at = at + usize.ONE
  }
  return count
}

fn diagnosticsName(diagnostics: &Option<Diagnostics>, local: usize) -> usize {
  if let Option<Diagnostics>.Some {value} = &diagnostics.* {
    return operandNames(Diagnostics.observer(&value), local) + operandNames(Diagnostics.cause(&value), local)
      + operandNames(Diagnostics.site(&value), local)
  }
  return usize.ZERO
}

fn rvalueNames(value: &Rvalue, local: usize) -> usize {
  return match &value.* {
    Rvalue.Aggregate {fields} => fieldsName(&fields, local)
    Rvalue.Slice {data, count} => operandNames(&data, local) + operandNames(&count, local)
    Rvalue.SliceLength {place} => placeNames(&place, local)
    Rvalue.SliceData {place} => placeNames(&place, local)
    Rvalue.PointerOffset {pointer, index, ..} => operandNames(&pointer, local) + operandNames(&index, local)
    Rvalue.Use {value: used} => operandNames(&used, local)
    Rvalue.Ref {place, ..} => placeNames(&place, local)
    Rvalue.AddressOf {place, ..} => placeNames(&place, local)
    Rvalue.Unary {value: used, ..} => operandNames(&used, local)
    Rvalue.Binary {left, right, ..} => operandNames(&left, local) + operandNames(&right, local)
    Rvalue.ScalarBinary {left, right, ..} => operandNames(&left, local) + operandNames(&right, local)
    Rvalue.ScalarUnary {value: used, ..} => operandNames(&used, local)
    Rvalue.Convert {value: used, ..} => operandNames(&used, local)
    Rvalue.Fits {value: used, ..} => operandNames(&used, local)
    Rvalue.AddressIntegerConversion {operand, ..} => operandNames(&operand, local)
    Rvalue.Bitcast {value: used, ..} => operandNames(&used, local)
    Rvalue.Discriminant {place} => placeNames(&place, local)
    Rvalue.Inject {value: used, ..} => operandNames(&used, local)
    Rvalue.Variant {fields, ..} => fieldsName(&fields, local)
    Rvalue.ContextOf {place} => placeNames(&place, local)
    Rvalue.ContextHandle {address} => operandNames(&address, local)
    Rvalue.Assembly {fragment} => operandsName(&Box<AssemblyFragment>.get(&fragment)[0].inputs, local)
    Rvalue.Atomic {operands, ..} => operandsName(&operands, local)
    Rvalue.Vector {operands, ..} => operandsName(&operands, local)
    Rvalue.StackAllocate {count, ..} => operandNames(&count, local)
    Rvalue.Wasm {operands, ..} => operandsName(&operands, local)
    _ => usize.ZERO
  }
}

fn borrows(value: &Rvalue, local: usize) -> bool {
  return match &value.* {
    Rvalue.Ref {place, ..} => place.local == local
    Rvalue.AddressOf {place, ..} => place.local == local
    Rvalue.ContextOf {place} => place.local == local
    _ => false
  }
}

fn statementNames(statement: &Statement, local: usize) -> usize {
  return match &statement.* {
    Statement.Assign {destination, value, ..} => placeNames(&destination, local) + rvalueNames(&value, local)
    Statement.Drop {destination, diagnostics, ..} => placeNames(&destination, local) + diagnosticsName(&diagnostics, local)
    Statement.FailureContext {destination, source, ..} => {
      let mut count = placeNames(&destination, local)
      if let Option<Place>.Some {value: from} = &source { count = count + placeNames(&from, local) }
      return count
    }
    Statement.SetContextHandle {address, value, ..} => operandNames(&address, local) + operandNames(&value, local)
  }
}

fn terminatorNames(terminator: &Terminator, local: usize) -> usize {
  return match &terminator.* {
    Terminator.Branch {condition, ..} => operandNames(&condition, local)
    Terminator.Switch {value, ..} => operandNames(&value, local)
    Terminator.TrapText {reason, ..} => operandNames(&reason, local)
    Terminator.Call {callee, arguments, providers, diagnostics, destination, failure, ..} => {
      let mut count = operandsName(&arguments, local) + operandsName(&providers, local) + diagnosticsName(&diagnostics, local)
        + placeNames(&destination, local)
      match &callee {
        Callee.Indirect {address} => { count = count + operandNames(&address, local) }
        Callee.NativeIndirect {address, ..} => { count = count + operandNames(&address, local) }
        _ => ()
      }
      if let Option<FailureEdge>.Some {value: edge} = &failure { count = count + placeNames(&edge.destination, local) }
      return count
    }
    _ => usize.ZERO
  }
}

// The result local is read by `return` and the failure slot by `fail`, so a block ending in either
// names it.
fn blockNames(function: &MirFunction, block: &Block, local: usize) -> usize {
  let statements = List<Statement>.asSlice(&block.statements)
  let mut count = terminatorNames(&block.terminator, local)
  let mut at = usize.ZERO
  while at < statements.length {
    count = count + statementNames(&statements[at], local)
    at = at + usize.ONE
  }
  let exits = match &block.terminator {
    Terminator.Return {..} => isReturn(function, local)
    Terminator.Fail {..} => match &List<Local>.asSlice(&function.locals)[local].kind { LocalKind.Failure => true _ => false }
    _ => false
  }
  if exits { count = count + usize.ONE }
  return count
}

// How every local of a function is named, gathered in one walk so each candidate's check is a
// lookup rather than a scan of the whole body. A rewrite that drops a local's last two names
// clears that local with `forget`; it names no other local differently.
struct UseTable {
  named: List<usize>,
  borrowed: List<bool>,
  dropped: List<bool>,
  flags: List<bool>,
}

fn countPlace(place: &Place, named: &mut List<usize>) -> () {
  let mut slots = List<usize>.asMutSlice(&mut named.*)
  slots[place.local] = slots[place.local] + usize.ONE
  let steps = List<Projection>.asSlice(&place.projections)
  let mut at = usize.ZERO
  while at < steps.length {
    if let Projection.Index {local: index} = &steps[at] { slots[index] = slots[index] + usize.ONE }
    at = at + usize.ONE
  }
  return ()
}

fn countOperand(operand: &Operand, named: &mut List<usize>) -> () {
  match &operand.* {
    Operand.Copy {place} => countPlace(&place, &mut named.*)
    Operand.Move {place} => countPlace(&place, &mut named.*)
    _ => ()
  }
  return ()
}

fn countOperands(operands: &List<Operand>, named: &mut List<usize>) -> () {
  let listed = List<Operand>.asSlice(operands)
  let mut at = usize.ZERO
  while at < listed.length {
    countOperand(&listed[at], &mut named.*)
    at = at + usize.ONE
  }
  return ()
}

fn countFields(fields: &List<AggregateField>, named: &mut List<usize>) -> () {
  let listed = List<AggregateField>.asSlice(fields)
  let mut at = usize.ZERO
  while at < listed.length {
    countOperand(&listed[at].value, &mut named.*)
    at = at + usize.ONE
  }
  return ()
}

fn countDiagnostics(diagnostics: &Option<Diagnostics>, named: &mut List<usize>) -> () {
  if let Option<Diagnostics>.Some {value} = &diagnostics.* {
    countOperand(Diagnostics.observer(&value), &mut named.*)
    countOperand(Diagnostics.cause(&value), &mut named.*)
    countOperand(Diagnostics.site(&value), &mut named.*)
  }
  return ()
}

fn countRvalue(value: &Rvalue, named: &mut List<usize>) -> () {
  match &value.* {
    Rvalue.Aggregate {fields} => countFields(&fields, &mut named.*)
    Rvalue.Slice {data, count} => {
      countOperand(&data, &mut named.*)
      countOperand(&count, &mut named.*)
    }
    Rvalue.SliceLength {place} => countPlace(&place, &mut named.*)
    Rvalue.SliceData {place} => countPlace(&place, &mut named.*)
    Rvalue.PointerOffset {pointer, index, ..} => {
      countOperand(&pointer, &mut named.*)
      countOperand(&index, &mut named.*)
    }
    Rvalue.Use {value: used} => countOperand(&used, &mut named.*)
    Rvalue.Ref {place, ..} => countPlace(&place, &mut named.*)
    Rvalue.AddressOf {place, ..} => countPlace(&place, &mut named.*)
    Rvalue.Unary {value: used, ..} => countOperand(&used, &mut named.*)
    Rvalue.Binary {left, right, ..} => {
      countOperand(&left, &mut named.*)
      countOperand(&right, &mut named.*)
    }
    Rvalue.ScalarBinary {left, right, ..} => {
      countOperand(&left, &mut named.*)
      countOperand(&right, &mut named.*)
    }
    Rvalue.ScalarUnary {value: used, ..} => countOperand(&used, &mut named.*)
    Rvalue.Convert {value: used, ..} => countOperand(&used, &mut named.*)
    Rvalue.Fits {value: used, ..} => countOperand(&used, &mut named.*)
    Rvalue.AddressIntegerConversion {operand, ..} => countOperand(&operand, &mut named.*)
    Rvalue.Bitcast {value: used, ..} => countOperand(&used, &mut named.*)
    Rvalue.Discriminant {place} => countPlace(&place, &mut named.*)
    Rvalue.Inject {value: used, ..} => countOperand(&used, &mut named.*)
    Rvalue.Variant {fields, ..} => countFields(&fields, &mut named.*)
    Rvalue.ContextOf {place} => countPlace(&place, &mut named.*)
    Rvalue.ContextHandle {address} => countOperand(&address, &mut named.*)
    Rvalue.Assembly {fragment} => countOperands(&Box<AssemblyFragment>.get(&fragment)[0].inputs, &mut named.*)
    Rvalue.Atomic {operands, ..} => countOperands(&operands, &mut named.*)
    Rvalue.Vector {operands, ..} => countOperands(&operands, &mut named.*)
    Rvalue.StackAllocate {count, ..} => countOperand(&count, &mut named.*)
    Rvalue.Wasm {operands, ..} => countOperands(&operands, &mut named.*)
    _ => ()
  }
  return ()
}

fn countStatement(statement: &Statement, named: &mut List<usize>) -> () {
  match &statement.* {
    Statement.Assign {destination, value, ..} => {
      countPlace(&destination, &mut named.*)
      countRvalue(&value, &mut named.*)
    }
    Statement.Drop {destination, diagnostics, ..} => {
      countPlace(&destination, &mut named.*)
      countDiagnostics(&diagnostics, &mut named.*)
    }
    Statement.FailureContext {destination, source, ..} => {
      countPlace(&destination, &mut named.*)
      if let Option<Place>.Some {value: from} = &source { countPlace(&from, &mut named.*) }
    }
    Statement.SetContextHandle {address, value, ..} => {
      countOperand(&address, &mut named.*)
      countOperand(&value, &mut named.*)
    }
  }
  return ()
}

fn countTerminator(terminator: &Terminator, named: &mut List<usize>) -> () {
  match &terminator.* {
    Terminator.Branch {condition, ..} => countOperand(&condition, &mut named.*)
    Terminator.Switch {value, ..} => countOperand(&value, &mut named.*)
    Terminator.TrapText {reason, ..} => countOperand(&reason, &mut named.*)
    Terminator.Call {callee, arguments, providers, diagnostics, destination, failure, ..} => {
      countOperands(&arguments, &mut named.*)
      countOperands(&providers, &mut named.*)
      countDiagnostics(&diagnostics, &mut named.*)
      countPlace(&destination, &mut named.*)
      match &callee {
        Callee.Indirect {address} => countOperand(&address, &mut named.*)
        Callee.NativeIndirect {address, ..} => countOperand(&address, &mut named.*)
        _ => ()
      }
      if let Option<FailureEdge>.Some {value: edge} = &failure { countPlace(&edge.destination, &mut named.*) }
    }
    _ => ()
  }
  return ()
}

fn mark(flags: &mut List<bool>, local: usize) -> () {
  let mut slots = List<bool>.asMutSlice(&mut flags.*)
  slots[local] = true
  return ()
}

impl UseTable {
  effect fn of(function: &MirFunction) -> UseTable ! OutOfMemoryError ? &mut Allocator {
    let locals = List<Local>.asSlice(&function.locals)
    let mut table = UseTable {
      named: run List<usize>.makeWithCapacity(locals.length),
      borrowed: run List<bool>.makeWithCapacity(locals.length),
      dropped: run List<bool>.makeWithCapacity(locals.length),
      flags: run List<bool>.makeWithCapacity(locals.length),
    }
    run List<usize>.appendRepeated(&mut table.named, usize.ZERO, locals.length)
    run List<bool>.appendRepeated(&mut table.borrowed, false, locals.length)
    run List<bool>.appendRepeated(&mut table.dropped, false, locals.length)
    run List<bool>.appendRepeated(&mut table.flags, false, locals.length)
    let mut flags = List<bool>.asMutSlice(&mut table.flags)
    let mut local = usize.ZERO
    while local < locals.length {
      if let LocalKind.DropFlag {local: guarded, ..} = &locals[local].kind { flags[guarded] = true }
      local = local + usize.ONE
    }
    let blocks = List<Block>.asSlice(&function.blocks)
    let mut at = usize.ZERO
    while at < blocks.length {
      countTerminator(&blocks[at].terminator, &mut table.named)
      let statements = List<Statement>.asSlice(&blocks[at].statements)
      let mut index = usize.ZERO
      while index < statements.length {
        countStatement(&statements[index], &mut table.named)
        match &statements[index] {
          Statement.Assign {value, ..} => {
            match &value {
              Rvalue.Ref {place, ..} => { mark(&mut table.borrowed, place.local) }
              Rvalue.AddressOf {place, ..} => { mark(&mut table.borrowed, place.local) }
              Rvalue.ContextOf {place} => { mark(&mut table.borrowed, place.local) }
              _ => ()
            }
          }
          Statement.Drop {destination, ..} => { mark(&mut table.dropped, destination.local) }
          _ => ()
        }
        index = index + usize.ONE
      }
      at = at + usize.ONE
    }
    return move table
  }

  fn uses(self: &Self, local: usize) -> Uses {
    return Uses {
      named: List<usize>.asSlice(&self.named)[local],
      borrowed: List<bool>.asSlice(&self.borrowed)[local],
      dropped: List<bool>.asSlice(&self.dropped)[local],
    }
  }

  fn flagged(self: &Self, local: usize) -> bool {
    return List<bool>.asSlice(&self.flags)[local]
  }

  // `local`, named exactly twice, is named nowhere after a rewrite removed both names.
  fn forget(self: &mut Self, local: usize) -> () {
    let mut named = List<usize>.asMutSlice(&mut self.named)
    named[local] = usize.ZERO
    return ()
  }
}

// Whether a block reachable from one of `starts`, including a start itself, names `local`.
effect fn reachedNames(function: &MirFunction, starts: &List<usize>, local: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut seen = List<bool>.make()
  run List<bool>.appendRepeated(&mut seen, false, blocks.length)
  let mut pending = List<usize>.make()
  run List<usize>.appendSlice(&mut pending, List<usize>.asSlice(starts))
  while true {
    let next = match List<usize>.pop(&mut pending) {
      Option<usize>.Some {value} => value
      Option<usize>.None => { break }
    }
    if List<bool>.get(&seen, next) { continue }
    List<bool>.set(&mut seen, next, true)
    if blockNames(function, &blocks[next], local) != usize.ZERO { return true }
    let following = run MirFunction.successors(function, next)
    run List<usize>.appendSlice(&mut pending, List<usize>.asSlice(&following))
  }
  return false
}

// Whether `local` is a user binding or temporary.
fn isUserOrTemp(function: &MirFunction, local: usize) -> bool {
  return match &List<Local>.asSlice(&function.locals)[local].kind {
    LocalKind.Temp => true
    LocalKind.User {..} => true
    _ => false
  }
}

// Renames the local every return moves into the result local to the result local itself, so a
// value built up in a binding (`let mut r = ...; r.x = ...; return r`) is built in the caller's
// result storage instead of copied there. Every statement naming the result must be `_0 = r` for
// one whole user binding or temporary `r` of the result's type, and nothing reachable after one of
// those statements may name `r` again. Paths that leave without returning `r`, such as a failure
// exit, drop it as before, now in the result storage the caller does not read on failure.
/// Statements and terminators below which `renameReturned` leaves a body alone.
const smallBody: usize = 64

fn bodySize(function: &MirFunction) -> usize {
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut size = blocks.length
  let mut at = usize.ZERO
  while at < blocks.length {
    size = size + List<Statement>.length(&blocks[at].statements)
    at = at + usize.ONE
  }
  return size
}

effect fn renameReturned(function: &mut MirFunction) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  // A small function is likely inlined, where its local result folds away anyway. Building it in
  // the caller's slot instead leaves no local for SROA, so LLVM's inline cost loses that saving
  // and stops inlining it (a 240-byte `let mut result = value; result.f = ...; return result`
  // went out of line in silk-layout).
  if bodySize(&function.*) < smallBody { return () }
  let returned = run returnedLocal(&function.*)
  if returned == usize.MAX { return () }
  let mut blocks = List<Block>.asMutSlice(&mut function.blocks)
  let mut block = usize.ZERO
  while block < blocks.length {
    let mut at = usize.ZERO
    while at < List<Statement>.length(&blocks[block].statements) {
      let returning = match &List<Statement>.asSlice(&blocks[block].statements)[at] {
        Statement.Assign {destination, value: Rvalue.Use {value: used}, ..} => wholePlace(&destination) == usize.ZERO && wholeLocal(&used) == returned
        _ => false
      }
      if returning {
        drop List<Statement>.remove(&mut blocks[block].statements, at)
        continue
      }
      renameStatement(&mut List<Statement>.asMutSlice(&mut blocks[block].statements)[at], returned)
      at = at + usize.ONE
    }
    renameTerminator(&mut blocks[block].terminator, returned)
    block = block + usize.ONE
  }
  moveVariables(&mut function.*, returned, usize.ZERO)
  // Drops of the local on paths that do not return it, such as a failure exit, now drop the
  // result local, guarded by the same flags.
  let mut locals = List<Local>.asMutSlice(&mut function.locals)
  let mut at = usize.ZERO
  while at < locals.length {
    if let LocalKind.DropFlag {local: guarded, path} = &mut locals[at].kind {
      if guarded == returned { guarded = usize.ZERO }
      let mut steps = List<Projection>.asMutSlice(&mut path)
      let mut step = usize.ZERO
      while step < steps.length {
        if let Projection.Index {local: index} = &mut steps[step] {
          if index == returned { index = usize.ZERO }
        }
        step = step + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// A debug build's source variable held in `from` is held in `to` once a rewrite merges them.
fn moveVariables(function: &mut MirFunction, from: usize, to: usize) -> () {
  let mut variables = List<Variable>.asMutSlice(&mut function.variables)
  let mut at = usize.ZERO
  while at < variables.length {
    if variables[at].local == from { variables[at].local = to }
    at = at + usize.ONE
  }
  return ()
}

fn renamePlace(place: &mut Place, local: usize) -> () {
  if place.local == local { place.local = usize.ZERO }
  let mut steps = List<Projection>.asMutSlice(&mut place.projections)
  let mut at = usize.ZERO
  while at < steps.length {
    if let Projection.Index {local: index} = &mut steps[at] {
      if index == local { index = usize.ZERO }
    }
    at = at + usize.ONE
  }
  return ()
}

fn renameOperand(operand: &mut Operand, local: usize) -> () {
  match &mut operand.* {
    Operand.Copy {place} => renamePlace(&mut place, local)
    Operand.Move {place} => renamePlace(&mut place, local)
    _ => ()
  }
  return ()
}

fn renameOperands(operands: &mut List<Operand>, local: usize) -> () {
  let mut listed = List<Operand>.asMutSlice(&mut operands.*)
  let mut at = usize.ZERO
  while at < listed.length {
    renameOperand(&mut listed[at], local)
    at = at + usize.ONE
  }
  return ()
}

fn renameFields(fields: &mut List<AggregateField>, local: usize) -> () {
  let mut listed = List<AggregateField>.asMutSlice(&mut fields.*)
  let mut at = usize.ZERO
  while at < listed.length {
    renameOperand(&mut listed[at].value, local)
    at = at + usize.ONE
  }
  return ()
}

// Every place `rvalueNames` counts except assembly inputs, which `returnedLocal` rules out.
fn renameRvalue(value: &mut Rvalue, local: usize) -> () {
  match &mut value.* {
    Rvalue.Aggregate {fields} => renameFields(&mut fields, local)
    Rvalue.Slice {data, count} => {
      renameOperand(&mut data, local)
      renameOperand(&mut count, local)
    }
    Rvalue.SliceLength {place} => renamePlace(&mut place, local)
    Rvalue.SliceData {place} => renamePlace(&mut place, local)
    Rvalue.PointerOffset {pointer, index, ..} => {
      renameOperand(&mut pointer, local)
      renameOperand(&mut index, local)
    }
    Rvalue.Use {value: used} => renameOperand(&mut used, local)
    Rvalue.Ref {place, ..} => renamePlace(&mut place, local)
    Rvalue.AddressOf {place, ..} => renamePlace(&mut place, local)
    Rvalue.Unary {value: used, ..} => renameOperand(&mut used, local)
    Rvalue.Binary {left, right, ..} => {
      renameOperand(&mut left, local)
      renameOperand(&mut right, local)
    }
    Rvalue.ScalarBinary {left, right, ..} => {
      renameOperand(&mut left, local)
      renameOperand(&mut right, local)
    }
    Rvalue.ScalarUnary {value: used, ..} => renameOperand(&mut used, local)
    Rvalue.Convert {value: used, ..} => renameOperand(&mut used, local)
    Rvalue.Fits {value: used, ..} => renameOperand(&mut used, local)
    Rvalue.AddressIntegerConversion {operand, ..} => renameOperand(&mut operand, local)
    Rvalue.Bitcast {value: used, ..} => renameOperand(&mut used, local)
    Rvalue.Discriminant {place} => renamePlace(&mut place, local)
    Rvalue.Inject {value: used, ..} => renameOperand(&mut used, local)
    Rvalue.Variant {fields, ..} => renameFields(&mut fields, local)
    Rvalue.ContextOf {place} => renamePlace(&mut place, local)
    Rvalue.ContextHandle {address} => renameOperand(&mut address, local)
    Rvalue.Atomic {operands, ..} => renameOperands(&mut operands, local)
    Rvalue.Vector {operands, ..} => renameOperands(&mut operands, local)
    Rvalue.StackAllocate {count, ..} => renameOperand(&mut count, local)
    Rvalue.Wasm {operands, ..} => renameOperands(&mut operands, local)
    _ => ()
  }
  return ()
}

fn renameStatement(statement: &mut Statement, local: usize) -> () {
  match &mut statement.* {
    Statement.Assign {destination, value, ..} => {
      renamePlace(&mut destination, local)
      renameRvalue(&mut value, local)
    }
    Statement.Drop {destination, ..} => renamePlace(&mut destination, local)
    Statement.FailureContext {destination, source, ..} => {
      renamePlace(&mut destination, local)
      if let Option<Place>.Some {value: from} = &mut source { renamePlace(&mut from, local) }
    }
    Statement.SetContextHandle {address, value, ..} => {
      renameOperand(&mut address, local)
      renameOperand(&mut value, local)
    }
  }
  return ()
}

// Every place `terminatorNames` counts except diagnostics, which `returnedLocal` rules out.
fn renameTerminator(terminator: &mut Terminator, local: usize) -> () {
  match &mut terminator.* {
    Terminator.Branch {condition, ..} => renameOperand(&mut condition, local)
    Terminator.Switch {value, ..} => renameOperand(&mut value, local)
    Terminator.TrapText {reason, ..} => renameOperand(&mut reason, local)
    Terminator.Call {callee, arguments, providers, destination, failure, ..} => {
      renameOperands(&mut arguments, local)
      renameOperands(&mut providers, local)
      renamePlace(&mut destination, local)
      match &mut callee {
        Callee.Indirect {address} => renameOperand(&mut address, local)
        Callee.NativeIndirect {address, ..} => renameOperand(&mut address, local)
        _ => ()
      }
      if let Option<FailureEdge>.Some {value: edge} = &mut failure { renamePlace(&mut edge.destination, local) }
    }
    _ => ()
  }
  return ()
}

// The local `renameReturned` can turn into the result local, or `usize.MAX`.
effect fn returnedLocal(function: &MirFunction) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
  // A suspending frame keeps its locals in the frame; leave it alone.
  if let Option<Origin>.Some {..} = &function.suspension { return usize.MAX }
  if List<Cancel>.length(&function.cancels) != usize.ZERO { return usize.MAX }
  let locals = List<Local>.asSlice(&function.locals)
  if locals.length == usize.ZERO || !isReturn(function, usize.ZERO) { return usize.MAX }
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut returned = usize.MAX
  let mut exits = List<usize>.make()
  let mut block = usize.ZERO
  while block < blocks.length {
    if let Terminator.Relinquish {..} = &blocks[block].terminator { return usize.MAX }
    if terminatorNames(&blocks[block].terminator, usize.ZERO) != usize.ZERO { return usize.MAX }
    let statements = List<Statement>.asSlice(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      if statementNames(&statements[at], usize.ZERO) != usize.ZERO {
        let source = match &statements[at] {
          Statement.Assign {destination, value: Rvalue.Use {value: used}, ..} => {
            if wholePlace(&destination) != usize.ZERO { return usize.MAX }
            wholeLocal(&used)
          }
          _ => { return usize.MAX }
        }
        if source == usize.MAX || (returned != usize.MAX && source != returned) { return usize.MAX }
        returned = source
        // Nothing after the move in its own block may name the local.
        let mut after = at + usize.ONE
        while after < statements.length {
          if statementNames(&statements[after], source) != usize.ZERO { return usize.MAX }
          after = after + usize.ONE
        }
        if terminatorNames(&blocks[block].terminator, source) != usize.ZERO { return usize.MAX }
        let following = run MirFunction.successors(function, block)
        run List<usize>.appendSlice(&mut exits, List<usize>.asSlice(&following))
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  if returned == usize.MAX || returned == usize.ZERO || !isUserOrTemp(function, returned) { return usize.MAX }
  if !(run Type.equalsShared(&locals[returned].ty, &locals[usize.ZERO].ty)) { return usize.MAX }
  // Assembly inputs and diagnostics sit behind boxes the rename does not reach.
  block = usize.ZERO
  while block < blocks.length {
    if let Terminator.Call {diagnostics, ..} = &blocks[block].terminator {
      if diagnosticsName(&diagnostics, returned) != usize.ZERO { return usize.MAX }
    }
    let statements = List<Statement>.asSlice(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      match &statements[at] {
        Statement.Assign {value: Rvalue.Assembly {fragment}, ..} => {
          if operandsName(&Box<AssemblyFragment>.get(&fragment)[0].inputs, returned) != usize.ZERO { return usize.MAX }
        }
        Statement.Drop {diagnostics, ..} => {
          if diagnosticsName(&diagnostics, returned) != usize.ZERO { return usize.MAX }
        }
        _ => ()
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  if run reachedNames(function, &exits, returned) { return usize.MAX }
  return returned
}

// Where a temporary is written whole: statement `index` of `block`, or its terminator when `index`
// is `usize.MAX`. `next` links the local's next site, or is `usize.MAX`.
struct JoinSite {
  block: usize,
  index: usize,
  next: usize,
}

impl Copy for JoinSite {}

// The whole writes of every temporary, gathered in one walk, as one linked list of sites for each
// local.
struct JoinSites {
  sites: List<JoinSite>,
  first: List<usize>,
  count: List<usize>,
}

impl JoinSites {
  effect fn of(function: &MirFunction) -> JoinSites ! OutOfMemoryError ? &mut Allocator {
    let locals = List<Local>.asSlice(&function.locals)
    let mut table = JoinSites {
      sites: List<JoinSite>.make(),
      first: run List<usize>.makeWithCapacity(locals.length),
      count: run List<usize>.makeWithCapacity(locals.length),
    }
    run List<usize>.appendRepeated(&mut table.first, usize.MAX, locals.length)
    run List<usize>.appendRepeated(&mut table.count, usize.ZERO, locals.length)
    let blocks = List<Block>.asSlice(&function.blocks)
    let mut block = usize.ZERO
    while block < blocks.length {
      let statements = List<Statement>.asSlice(&blocks[block].statements)
      let mut index = usize.ZERO
      while index < statements.length {
        if let Statement.Assign {destination, ..} = &statements[index] {
          let local = wholePlace(&destination)
          if local != usize.MAX && isTemp(function, local) { run table.add(local, block, index) }
        }
        index = index + usize.ONE
      }
      if let Terminator.Call {destination, ..} = &blocks[block].terminator {
        let local = wholePlace(&destination)
        if local != usize.MAX && isTemp(function, local) { run table.add(local, block, usize.MAX) }
      }
      block = block + usize.ONE
    }
    return move table
  }

  effect fn add(self: &mut Self, local: usize, block: usize, index: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let head = List<usize>.get(&self.first, local)
    List<usize>.set(&mut self.first, local, List<JoinSite>.length(&self.sites))
    let count = List<usize>.get(&self.count, local)
    List<usize>.set(&mut self.count, local, count + usize.ONE)
    return run List<JoinSite>.append(&mut self.sites, JoinSite {block: block, index: index, next: head})
  }

  // Moves the sites of `from` to `into`, leaving out the site of statement `index` of `block`.
  fn merge(self: &mut Self, from: usize, into: usize, block: usize, index: usize) -> () {
    let mut sites = List<JoinSite>.asMutSlice(&mut self.sites)
    let mut kept = usize.MAX
    let mut count = usize.ZERO
    let mut lists: [usize; 2] = [List<usize>.get(&self.first, into), List<usize>.get(&self.first, from)]
    let mut list = usize.ZERO
    while list < 2 {
      let mut at = lists[list]
      while at != usize.MAX {
        let next = sites[at].next
        if !(sites[at].block == block && sites[at].index == index) {
          sites[at].next = kept
          kept = at
          count = count + usize.ONE
        }
        at = next
      }
      list = list + usize.ONE
    }
    List<usize>.set(&mut self.first, into, kept)
    List<usize>.set(&mut self.count, into, count)
    List<usize>.set(&mut self.first, from, usize.MAX)
    List<usize>.set(&mut self.count, from, usize.ZERO)
    return ()
  }
}

// The most blocks `joinable` walks for one copy before it gives up on it.
fn joinWalkLimit() -> usize { return 256 }

// Merges a temporary that is only ever written whole, and read only by one whole move or copy into
// another temporary, into that temporary. The arms of an `if` or `match` each write the value of
// the arm into a temporary of their own, which a join block then copies into the temporary of the
// whole expression, so a nested `match` copies a large result once for each level. After the merge
// each arm writes the outer temporary directly. No block that a write of the inner temporary
// reaches before the copy may name the outer one, so its earlier value is dead wherever the inner
// one was live.
effect fn mergeJoins(function: &mut MirFunction) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut table = run UseTable.of(&function.*)
  let mut sites = run JoinSites.of(&function.*)
  let mut removed = List<JoinSite>.make()
  let mut block = usize.ZERO
  while block < List<Block>.length(&function.blocks) {
    let mut at = usize.ZERO
    while at < List<Statement>.length(&List<Block>.asSlice(&function.blocks)[block].statements) {
      let mut source = usize.MAX
      let mut target = usize.MAX
      if let Statement.Assign {destination, value: Rvalue.Use {value: used}, ..} = &List<Statement>.asSlice(&List<Block>.asSlice(&function.blocks)[block].statements)[at] {
        source = wholeLocal(&used)
        target = wholePlace(&destination)
      }
      if source != usize.MAX && target != usize.MAX && run joinable(&function.*, &table, &sites, block, at, source, target) {
        renameSites(&mut function.*, &sites, source, target)
        moveVariables(&mut function.*, source, target)
        let mut named = List<usize>.asMutSlice(&mut table.named)
        named[target] = named[target] + named[source] - 2
        named[source] = usize.ZERO
        sites.merge(source, target, block, at)
        run List<JoinSite>.append(&mut removed, JoinSite {block: block, index: at, next: usize.MAX})
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  // The copies were found in increasing order; removing them from the last keeps each index valid.
  let mut blocks = List<Block>.asMutSlice(&mut function.blocks)
  let mut left = List<JoinSite>.length(&removed)
  while left > usize.ZERO {
    left = left - usize.ONE
    let site = List<JoinSite>.get(&removed, left)
    drop List<Statement>.remove(&mut blocks[site.block].statements, site.index)
  }
  return ()
}

// Whether `source` can be merged into `target` at the copy `target = source`, statement `at` of
// `block`.
effect fn joinable(
  function: &MirFunction,
  table: &UseTable,
  sites: &JoinSites,
  block: usize,
  at: usize,
  source: usize,
  target: usize,
) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if source == target || !isTemp(function, source) || !isTemp(function, target) { return false }
  let writes = List<usize>.get(&sites.count, source)
  let sourceUses = UseTable.uses(table, source)
  // Every name of the source but this copy is one of its whole writes.
  if writes == usize.ZERO || sourceUses.named != writes + usize.ONE { return false }
  if sourceUses.borrowed || sourceUses.dropped || UseTable.flagged(table, source) { return false }
  let targetUses = UseTable.uses(table, target)
  if targetUses.borrowed || targetUses.dropped || UseTable.flagged(table, target) { return false }
  let locals = List<Local>.asSlice(&function.locals)
  if !(run Type.equalsShared(&locals[source].ty, &locals[target].ty)) { return false }
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut pending = List<usize>.make()
  let all = List<JoinSite>.asSlice(&sites.sites)
  let mut site = List<usize>.get(&sites.first, source)
  while site != usize.MAX {
    let write = all[site]
    site = write.next
    if write.index == usize.MAX {
      // A call writes the source and continues to its successors, which the walk below checks.
      if terminatorNames(&blocks[write.block].terminator, target) != usize.ZERO { return false }
      if terminatorNames(&blocks[write.block].terminator, source) != usize.ONE { return false }
      let following = run MirFunction.successors(function, write.block)
      run List<usize>.appendSlice(&mut pending, List<usize>.asSlice(&following))
      continue
    }
    let statements = List<Statement>.asSlice(&blocks[write.block].statements)
    if statementNames(&statements[write.index], source) != usize.ONE { return false }
    if statementNames(&statements[write.index], target) != usize.ZERO { return false }
    // A write before the copy in its own block reaches the copy first.
    let mut end = statements.length
    if write.block == block && write.index < at { end = at }
    let mut index = write.index + usize.ONE
    while index < end {
      if statementNames(&statements[index], target) != usize.ZERO { return false }
      index = index + usize.ONE
    }
    if end == at && write.block == block { continue }
    if terminatorNames(&blocks[write.block].terminator, target) != usize.ZERO { return false }
    let following = run MirFunction.successors(function, write.block)
    run List<usize>.appendSlice(&mut pending, List<usize>.asSlice(&following))
  }
  let mut seen = List<bool>.make()
  run List<bool>.appendRepeated(&mut seen, false, blocks.length)
  let mut walked = usize.ZERO
  while true {
    let next = match List<usize>.pop(&mut pending) {
      Option<usize>.Some {value} => value
      Option<usize>.None => { break }
    }
    if List<bool>.get(&seen, next) { continue }
    List<bool>.set(&mut seen, next, true)
    walked = walked + usize.ONE
    if walked > joinWalkLimit() { return false }
    if next == block {
      // The walk stops at the copy, where the target is written.
      let statements = List<Statement>.asSlice(&blocks[next].statements)
      let mut index = usize.ZERO
      while index < at {
        if statementNames(&statements[index], target) != usize.ZERO { return false }
        index = index + usize.ONE
      }
      continue
    }
    if blockNames(function, &blocks[next], target) != usize.ZERO { return false }
    let following = run MirFunction.successors(function, next)
    run List<usize>.appendSlice(&mut pending, List<usize>.asSlice(&following))
  }
  return true
}

// Names `target` at every whole write of `source`, which `joinable` found are its only names but
// the copy.
fn renameSites(function: &mut MirFunction, sites: &JoinSites, source: usize, target: usize) -> () {
  let all = List<JoinSite>.asSlice(&sites.sites)
  let mut blocks = List<Block>.asMutSlice(&mut function.blocks)
  let mut site = List<usize>.get(&sites.first, source)
  while site != usize.MAX {
    let write = all[site]
    site = write.next
    if write.index == usize.MAX {
      if let Terminator.Call {destination, ..} = &mut blocks[write.block].terminator { destination.local = target }
      continue
    }
    let mut statements = List<Statement>.asMutSlice(&mut blocks[write.block].statements)
    if let Statement.Assign {destination, ..} = &mut statements[write.index] { destination.local = target }
  }
  return ()
}

// Collapses `b = v; ...; a = b` within a block into `a = v` when `b` is a whole user binding or
// temporary named nowhere else and `a` is a whole local of the same type that nothing borrows,
// drops or names in between. Lowering moves a call's result through a temporary, a `let` and
// further temporaries before it reaches its destination, and each step is a copy LLVM keeps for a
// large value.
effect fn collapseCopies(function: &mut MirFunction) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut table = run UseTable.of(&function.*)
  let mut block = usize.ZERO
  while block < List<Block>.length(&function.blocks) {
    let mut at = usize.ZERO
    while at < List<Statement>.length(&List<Block>.asSlice(&function.blocks)[block].statements) {
      let definition = run collapsible(&function.*, &table, block, at)
      if definition == usize.MAX {
        at = at + usize.ONE
        continue
      }
      let mut blocks = List<Block>.asMutSlice(&mut function.blocks)
      let removed = List<Statement>.remove(&mut blocks[block].statements, at)
      let mut source = usize.MAX
      let target = match move removed {
        Statement.Assign {destination, value: Rvalue.Use {value: used}, ..} => {
          source = wholeLocal(&used)
          move destination
        }
        _ => { continue }
      }
      let merged = wholePlace(&target)
      let mut statements = List<Statement>.asMutSlice(&mut blocks[block].statements)
      if let Statement.Assign {destination, ..} = &mut statements[definition] { destination = move target }
      moveVariables(&mut function.*, source, merged)
      UseTable.forget(&mut table, source)
    }
    block = block + usize.ONE
  }
  return ()
}

// The statement defining the source of the whole copy at `at` in `block` that can write the copy's
// destination directly, or `usize.MAX`.
effect fn collapsible(function: &MirFunction, table: &UseTable, block: usize, at: usize) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let statements = List<Statement>.asSlice(&List<Block>.asSlice(&function.blocks)[block].statements)
  let mut source = usize.MAX
  let target = match &statements[at] {
    Statement.Assign {destination, value: Rvalue.Use {value: used}, ..} => {
      source = wholeLocal(&used)
      wholePlace(&destination)
    }
    _ => { return usize.MAX }
  }
  if source == usize.MAX || target == usize.MAX || source == target { return usize.MAX }
  if !isUserOrTemp(function, source) { return usize.MAX }
  if !(isReturn(function, target) || isUserOrTemp(function, target)) { return usize.MAX }
  let mut definition = at
  let mut found = false
  while definition > usize.ZERO {
    definition = definition - usize.ONE
    if statementNames(&statements[definition], source) != usize.ZERO {
      found = true
      break
    }
    if statementNames(&statements[definition], target) != usize.ZERO { return usize.MAX }
  }
  if !found { return usize.MAX }
  match &statements[definition] {
    Statement.Assign {destination, value, ..} => {
      if wholePlace(&destination) != source { return usize.MAX }
      if rvalueNames(&value, source) != usize.ZERO || rvalueNames(&value, target) != usize.ZERO { return usize.MAX }
    }
    _ => { return usize.MAX }
  }
  let locals = List<Local>.asSlice(&function.locals)
  if !(run Type.equalsShared(&locals[source].ty, &locals[target].ty)) { return usize.MAX }
  let sourceUses = UseTable.uses(table, source)
  if sourceUses.named != 2 || sourceUses.borrowed || sourceUses.dropped || UseTable.flagged(table, source) { return usize.MAX }
  let targetUses = UseTable.uses(table, target)
  if targetUses.borrowed || targetUses.dropped || UseTable.flagged(table, target) { return usize.MAX }
  return definition
}

// Whether `local` is a user binding that exactly one whole assignment defines, as a `let` does,
// though a `let mut` may then write its parts.
fn freshBinding(function: &MirFunction, local: usize) -> bool {
  if !isUserOrTemp(function, local) || isTemp(function, local) { return false }
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut definitions = usize.ZERO
  let mut at = usize.ZERO
  while at < blocks.length {
    if let Terminator.Call {destination, ..} = &blocks[at].terminator {
      if destination.local == local { return false }
    }
    let statements = List<Statement>.asSlice(&blocks[at].statements)
    let mut index = usize.ZERO
    while index < statements.length {
      if let Statement.Assign {destination, ..} = &statements[index] {
        // Writes to part of it come after its definition, which the borrow checker requires.
        if wholePlace(&destination) == local { definitions = definitions + usize.ONE }
      }
      index = index + usize.ONE
    }
    at = at + usize.ONE
  }
  return definitions == usize.ONE
}

// Whether `local` can stand in for a call's temporary destination: a whole result local or
// temporary that nothing borrows or drops.
fn forwardable(function: &MirFunction, table: &UseTable, local: usize, uses: &Uses) -> bool {
  if !(isReturn(function, local) || isTemp(function, local)) { return false }
  return !uses.borrowed && !uses.dropped && !UseTable.flagged(table, local)
}

effect fn forwardResults(function: &mut MirFunction, table: &mut UseTable) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < List<Block>.length(&function.blocks) {
    let candidate = run resultCandidate(&function.*, &table.*, at)
    if candidate != usize.MAX {
      let mut blocks = List<Block>.asMutSlice(&mut function.blocks)
      let mut continuation = usize.MAX
      if let Terminator.Call {destination, normal, ..} = &mut blocks[at].terminator {
        UseTable.forget(&mut table.*, destination.local)
        destination.local = candidate
        continuation = normal
      }
      drop List<Statement>.remove(&mut blocks[continuation].statements, usize.ZERO)
    }
    at = at + usize.ONE
  }
  return ()
}

// The local the call ending block `at` can write in place of its temporary destination, or
// `usize.MAX`.
effect fn resultCandidate(function: &MirFunction, table: &UseTable, at: usize) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut temporary = usize.MAX
  let mut next = usize.MAX
  let mut failed = usize.MAX
  if let Terminator.Call {callee, destination, normal, failure, ..} = &blocks[at].terminator {
    // C calls check their destination against the foreign signature; leave them alone.
    if !silkCallee(&callee) { return usize.MAX }
    if let Option<FailureEdge>.Some {value: edge} = &failure { failed = edge.target }
    temporary = wholePlace(&destination)
    next = normal
  }
  if temporary == usize.MAX || !isTemp(function, temporary) { return usize.MAX }
  let statements = List<Statement>.asSlice(&blocks[next].statements)
  if statements.length == usize.ZERO { return usize.MAX }
  let target = match &statements[usize.ZERO] {
    Statement.Assign {destination, value: Rvalue.Use {value: used}, ..} => {
      if wholeLocal(&used) != temporary { return usize.MAX }
      wholePlace(&destination)
    }
    _ => { return usize.MAX }
  }
  if target == usize.MAX || target == temporary { return usize.MAX }
  let locals = List<Local>.asSlice(&function.locals)
  if !(run Type.equalsShared(&locals[temporary].ty, &locals[target].ty)) { return usize.MAX }
  let temporaryUses = UseTable.uses(table, temporary)
  if temporaryUses.named != 2 || temporaryUses.borrowed || temporaryUses.dropped || UseTable.flagged(table, temporary) {
    return usize.MAX
  }
  let targetUses = UseTable.uses(table, target)
  // A result local built up in place may be borrowed, but only after the call writes it.
  let mut uses = targetUses
  if isReturn(function, target) && uses.borrowed && !(run MirVerification.resultBorrowedBefore(function, at)) {
    uses.borrowed = false
  }
  if !forwardable(function, table, target, &uses) { return usize.MAX }
  if terminatorNames(&blocks[at].terminator, target) != usize.ZERO { return usize.MAX }
  // A failed call may leave its destination partly written, so the failure path must not read it.
  if failed != usize.MAX {
    let mut starts = List<usize>.make()
    run List<usize>.append(&mut starts, failed)
    if run reachedNames(function, &starts, target) { return usize.MAX }
  }
  return target
}

/// The binding the call ending block `at` can write in place of its temporary, when the call's
/// result goes straight into `let x = run f(...)` and `x` is borrowed later, or `usize.MAX`.
///
/// The call is the binding's only definition, so no earlier value of it is live and no borrow of
/// it can reach the call, even inside a loop, where the borrow checker ends each iteration's
/// borrows with that iteration's binding (#2515). A borrowed binding lives in memory anyway; one
/// that is never borrowed is left to LLVM. The backend takes the binding only for large types,
/// since LLVM still promotes a small one to registers once inlining removes its borrows.
pub effect fn bindingCandidate(function: &MirFunction, at: usize) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut temporary = usize.MAX
  let mut next = usize.MAX
  if let Terminator.Call {callee, destination, normal, ..} = &blocks[at].terminator {
    if !silkCallee(&callee) { return usize.MAX }
    temporary = wholePlace(&destination)
    next = normal
  }
  if temporary == usize.MAX || !isTemp(function, temporary) { return usize.MAX }
  let statements = List<Statement>.asSlice(&blocks[next].statements)
  if statements.length == usize.ZERO { return usize.MAX }
  let binding = match &statements[usize.ZERO] {
    Statement.Assign {destination, value: Rvalue.Use {value: used}, ..} => {
      if wholeLocal(&used) != temporary { return usize.MAX }
      wholePlace(&destination)
    }
    _ => { return usize.MAX }
  }
  if binding == usize.MAX || binding == temporary || !freshBinding(function, binding) { return usize.MAX }
  let locals = List<Local>.asSlice(&function.locals)
  if !(run Type.equalsShared(&locals[temporary].ty, &locals[binding].ty)) { return usize.MAX }
  let table = run UseTable.of(function)
  let temporaryUses = UseTable.uses(&table, temporary)
  if temporaryUses.named != 2 || temporaryUses.borrowed || temporaryUses.dropped || UseTable.flagged(&table, temporary) {
    return usize.MAX
  }
  if !UseTable.uses(&table, binding).borrowed || UseTable.flagged(&table, binding) { return usize.MAX }
  if terminatorNames(&blocks[at].terminator, binding) != usize.ZERO { return usize.MAX }
  return binding
}

/// A `let` binding that the calls writing a temporary can write instead, for the move of that
/// temporary into the binding at statement `index` of `block`.
pub struct JoinBinding {
  pub block: usize,
  pub index: usize,
  pub binding: usize,
  /// The blocks whose calls write the temporary.
  pub calls: List<usize>,
}

/// The moves `x = t` where every write of the temporary `t` is a call and `x` is a borrowed `let`
/// binding that the move alone defines, such as `let x = match ... { ... => run f(...) }` or
/// `let x = if c { run f() } else { run g() }`: each call can write the binding, and the move
/// then has nothing to do.
///
/// The argument is the one of [`bindingCandidate`] for each of the calls: the move is the
/// binding's only definition, so no earlier value of it is live wherever the temporary is, and the
/// temporary is named nowhere but by the calls and the move. Moves that `bindingCandidate` takes
/// are found too; the backend takes those first.
pub effect fn joinBindings(function: &MirFunction) -> List<JoinBinding> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut result = List<JoinBinding>.make()
  if !hasCall(function) { return move result }
  let blocks = List<Block>.asSlice(&function.blocks)
  let locals = List<Local>.asSlice(&function.locals)
  // Whole statement writes and call writes of each local.
  let mut written = run List<usize>.makeWithCapacity(locals.length)
  run List<usize>.appendRepeated(&mut written, usize.ZERO, locals.length)
  let mut called = run List<usize>.makeWithCapacity(locals.length)
  run List<usize>.appendRepeated(&mut called, usize.ZERO, locals.length)
  let mut moves = usize.ZERO
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = List<Statement>.asSlice(&blocks[block].statements)
    let mut index = usize.ZERO
    while index < statements.length {
      if let Statement.Assign {destination, value, ..} = &statements[index] {
        let local = wholePlace(&destination)
        if local != usize.MAX {
          let count = List<usize>.get(&written, local)
          List<usize>.set(&mut written, local, count + usize.ONE)
          if let Rvalue.Use {..} = &value { moves = moves + usize.ONE }
        }
      }
      index = index + usize.ONE
    }
    if let Terminator.Call {destination, ..} = &blocks[block].terminator {
      let local = wholePlace(&destination)
      if local != usize.MAX {
        let count = List<usize>.get(&called, local)
        List<usize>.set(&mut called, local, count + usize.ONE)
      }
    }
    block = block + usize.ONE
  }
  if moves == usize.ZERO { return move result }
  let uses = run UseTable.of(function)
  block = usize.ZERO
  while block < blocks.length {
    let statements = List<Statement>.asSlice(&blocks[block].statements)
    let mut index = usize.ZERO
    while index < statements.length {
      let mut binding = usize.MAX
      let mut temporary = usize.MAX
      if let Statement.Assign {destination, value: Rvalue.Use {value: used}, ..} = &statements[index] {
        binding = wholePlace(&destination)
        temporary = wholeLocal(&used)
      }
      index = index + usize.ONE
      if binding == usize.MAX || temporary == usize.MAX || binding == temporary { continue }
      if !isUserOrTemp(function, binding) || isTemp(function, binding) || !isTemp(function, temporary) { continue }
      let calls = List<usize>.get(&called, temporary)
      if calls == usize.ZERO || List<usize>.get(&written, temporary) != usize.ZERO { continue }
      if List<usize>.get(&written, binding) != usize.ONE || List<usize>.get(&called, binding) != usize.ZERO { continue }
      let temporaryUses = UseTable.uses(&uses, temporary)
      if temporaryUses.named != calls + usize.ONE || temporaryUses.borrowed || temporaryUses.dropped || UseTable.flagged(&uses, temporary) { continue }
      if !UseTable.uses(&uses, binding).borrowed || UseTable.flagged(&uses, binding) { continue }
      if !(run Type.equalsShared(&locals[temporary].ty, &locals[binding].ty)) { continue }
      let mut writers = List<usize>.make()
      let mut valid = true
      let mut at = usize.ZERO
      while at < blocks.length {
        if let Terminator.Call {callee, destination, ..} = &blocks[at].terminator {
          if destination.local == temporary {
            if !silkCallee(&callee) || terminatorNames(&blocks[at].terminator, temporary) != usize.ONE
              || terminatorNames(&blocks[at].terminator, binding) != usize.ZERO {
              valid = false
              break
            }
            run List<usize>.append(&mut writers, at)
          }
        }
        at = at + usize.ONE
      }
      if !valid { continue }
      run List<JoinBinding>.append(&mut result, JoinBinding {block: block, index: index - usize.ONE, binding: binding, calls: move writers})
    }
    block = block + usize.ONE
  }
  return move result
}

// A by-value argument and the snapshot statement it can replace.
struct Snapshot {
  argument: usize,
  statement: usize,
}

impl Copy for Snapshot {}

effect fn forwardArguments(function: &mut MirFunction, table: &mut UseTable) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < List<Block>.length(&function.blocks) {
    let mut found = run argumentCandidates(&function.*, &table.*, at)
    // Later statements first, so earlier indexes stay valid.
    while List<Snapshot>.length(&found) > usize.ZERO {
      let picked = match List<Snapshot>.pop(&mut found) {
        Option<Snapshot>.Some {value} => value
        Option<Snapshot>.None => { break }
      }
      let mut blocks = List<Block>.asMutSlice(&mut function.blocks)
      let removed = List<Statement>.remove(&mut blocks[at].statements, picked.statement)
      let source = match move removed {
        Statement.Assign {value: Rvalue.Use {value: Operand.Copy {place}}, ..} => move place
        _ => { continue }
      }
      let whole = wholePlace(&source)
      let mut snapshot = usize.MAX
      if let Terminator.Call {arguments, ..} = &mut blocks[at].terminator {
        let mut listed = List<Operand>.asMutSlice(&mut arguments)
        snapshot = match &listed[picked.argument] {
          Operand.Move {place} => place.local
          Operand.Copy {place} => place.local
          _ => usize.MAX
        }
        // Keep the argument's own kind: a moved snapshot of an affine value still moves it.
        let moved = match &listed[picked.argument] { Operand.Move {..} => true _ => false }
        if moved {
          listed[picked.argument] = Operand.Move {place: move source}
        } else {
          listed[picked.argument] = Operand.Copy {place: move source}
        }
      }
      // A variable the snapshot held is now the source local, or, for part of one, no slot.
      if snapshot != usize.MAX {
        moveVariables(&mut function.*, snapshot, whole)
        UseTable.forget(&mut table.*, snapshot)
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// Whether a place's projections are all fixed offsets into its local.
fn fixedPath(place: &Place) -> bool {
  let steps = List<Projection>.asSlice(&place.projections)
  let mut at = usize.ZERO
  while at < steps.length {
    let fixed = match &steps[at] {
      Projection.Field {..} => true
      Projection.ConstIndex {..} => true
      _ => false
    }
    if !fixed { return false }
    at = at + usize.ONE
  }
  return true
}

// The arguments of the call ending block `at` that can pass their source place directly, ordered
// by the statement that snapshots them.
effect fn argumentCandidates(function: &MirFunction, table: &UseTable, at: usize) -> List<Snapshot> ! OutOfMemoryError ? &mut Allocator {
  let mut found = List<Snapshot>.make()
  let blocks = List<Block>.asSlice(&function.blocks)
  let block = &blocks[at]
  let arguments = match &block.terminator {
    Terminator.Call {callee, arguments, ..} => {
      if !silkCallee(&callee) { return move found }
      List<Operand>.asSlice(&arguments)
    }
    _ => { return move found }
  }
  let statements = List<Statement>.asSlice(&block.statements)
  let mut successors = List<usize>.make()
  let mut statement = statements.length
  while statement > usize.ZERO {
    statement = statement - usize.ONE
    let source = match &statements[statement] {
      Statement.Assign {value: Rvalue.Use {value: Operand.Copy {place}}, ..} => &place
      _ => { continue }
    }
    let temporary = match &statements[statement] {
      Statement.Assign {destination, ..} => wholePlace(&destination)
      _ => usize.MAX
    }
    if temporary == usize.MAX || !isTemp(function, temporary) || source.local == temporary { continue }
    let mut argument = usize.ZERO
    while argument < arguments.length && wholeLocal(&arguments[argument]) != temporary { argument = argument + usize.ONE }
    if argument == arguments.length { continue }
    let local = source.local
    let kind = match &List<Local>.asSlice(&function.locals)[local].kind {
      LocalKind.Parameter {..} => true
      LocalKind.User {..} => true
      LocalKind.Temp => true
      _ => false
    }
    if !kind || !fixedPath(source) { continue }
    let temporaryUses = UseTable.uses(table, temporary)
    if temporaryUses.named != 2 || temporaryUses.borrowed || temporaryUses.dropped { continue }
    // Nothing between the snapshot and the call touches the source.
    let mut later = statement + usize.ONE
    let mut touched = false
    while later < statements.length {
      if statementNames(&statements[later], local) != usize.ZERO { touched = true }
      later = later + usize.ONE
    }
    if touched || terminatorNames(&block.terminator, local) != usize.ZERO { continue }
    let localUses = UseTable.uses(table, local)
    if localUses.borrowed { continue }
    if List<usize>.length(&successors) == usize.ZERO { successors = run MirFunction.successors(function, at) }
    if run reachedNames(function, &successors, local) { continue }
    run List<Snapshot>.append(&mut found, Snapshot {argument: argument, statement: statement})
  }
  // Collected from the last statement back; reverse so popping removes the latest first.
  let mut ordered = List<Snapshot>.make()
  while List<Snapshot>.length(&found) > usize.ZERO {
    match List<Snapshot>.pop(&mut found) {
      Option<Snapshot>.Some {value} => { run List<Snapshot>.append(&mut ordered, value) }
      Option<Snapshot>.None => { break }
    }
  }
  return move ordered
}

// The operand of an aggregate field, variant field or injection at `index` of `value`, counting
// fields in order, or none past the last.
fn operandAt(value: &Rvalue, index: usize) -> Option<&Operand> {
  return match &value.* {
    Rvalue.Aggregate {fields} => fieldOperand(&fields, index)
    Rvalue.Variant {fields, ..} => fieldOperand(&fields, index)
    Rvalue.Inject {value: injected, ..} => {
      if index == usize.ZERO { return Option<&Operand>.some(&injected) }
      return Option<&Operand>.none()
    }
    _ => Option<&Operand>.none()
  }
}

fn fieldOperand(fields: &List<AggregateField>, index: usize) -> Option<&Operand> {
  let listed = List<AggregateField>.asSlice(&fields.*)
  if index >= listed.length { return Option<&Operand>.none() }
  return Option<&Operand>.some(&listed[index].value)
}

fn replaceOperandAt(value: &mut Rvalue, index: usize, operand: Operand) -> () {
  match &mut value.* {
    Rvalue.Aggregate {fields} => {
      let mut listed = List<AggregateField>.asMutSlice(&mut fields)
      listed[index].value = move operand
    }
    Rvalue.Variant {fields, ..} => {
      let mut listed = List<AggregateField>.asMutSlice(&mut fields)
      listed[index].value = move operand
    }
    Rvalue.Inject {value: injected, ..} => { injected = move operand }
    _ => { drop operand }
  }
  return ()
}

// A field operand at `operand` of the statement at `statement` that can read the place its
// temporary snapshots, taken by the statement at `snapshot`.
struct FieldSnapshot {
  statement: usize,
  operand: usize,
  snapshot: usize,
}

impl Copy for FieldSnapshot {}

effect fn forwardFields(function: &mut MirFunction, table: &mut UseTable) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut block = usize.ZERO
  while block < List<Block>.length(&function.blocks) {
    while true {
      let picked = match fieldCandidate(&function.*, &table.*, block) {
        Option<FieldSnapshot>.None => { break }
        Option<FieldSnapshot>.Some {value} => value
      }
      let mut blocks = List<Block>.asMutSlice(&mut function.blocks)
      let removed = List<Statement>.remove(&mut blocks[block].statements, picked.snapshot)
      let mut temporary = usize.MAX
      let source = match move removed {
        Statement.Assign {destination, value: Rvalue.Use {value: used}, ..} => {
          temporary = wholePlace(&destination)
          move used
        }
        _ => { continue }
      }
      let whole = match &source {
        Operand.Move {place} => wholePlace(&place)
        Operand.Copy {place} => wholePlace(&place)
        _ => usize.MAX
      }
      let mut statements = List<Statement>.asMutSlice(&mut blocks[block].statements)
      // The snapshot came first, so the field's statement moved up by one.
      if let Statement.Assign {value, ..} = &mut statements[picked.statement - usize.ONE] {
        replaceOperandAt(&mut value, picked.operand, move source)
      }
      if whole != usize.MAX { moveVariables(&mut function.*, temporary, whole) }
      UseTable.forget(&mut table.*, temporary)
    }
    block = block + usize.ONE
  }
  return ()
}

fn fieldCandidate(function: &MirFunction, table: &UseTable, block: usize) -> Option<FieldSnapshot> {
  let statements = List<Statement>.asSlice(&List<Block>.asSlice(&function.blocks)[block].statements)
  let locals = List<Local>.asSlice(&function.locals)
  let mut statement = usize.ZERO
  while statement < statements.length {
    if let Statement.Assign {value, ..} = &statements[statement] {
      let mut operand = usize.ZERO
      while true {
        let field = match operandAt(&value, operand) {
          Option<&Operand>.None => { break }
          Option<&Operand>.Some {value: found} => found
        }
        let temporary = wholeLocal(field)
        operand = operand + usize.ONE
        if temporary == usize.MAX || !isTemp(function, temporary) { continue }
        let temporaryUses = UseTable.uses(table, temporary)
        if temporaryUses.named != 2 || temporaryUses.borrowed || temporaryUses.dropped || UseTable.flagged(table, temporary) { continue }
        // The snapshot: the temporary's whole assignment from a place, earlier in this block.
        let mut snapshot = statement
        let mut found = false
        while snapshot > usize.ZERO {
          snapshot = snapshot - usize.ONE
          if statementNames(&statements[snapshot], temporary) != usize.ZERO {
            found = true
            break
          }
        }
        if !found { continue }
        let source = match &statements[snapshot] {
          Statement.Assign {destination, value: Rvalue.Use {value: Operand.Move {place}}, ..} => {
            if wholePlace(&destination) != temporary { continue }
            &place
          }
          Statement.Assign {destination, value: Rvalue.Use {value: Operand.Copy {place}}, ..} => {
            // A copy that the field then moves is a move out whose transfer only the field shows,
            // so the field keeps its temporary.
            if wholePlace(&destination) != temporary { continue }
            if let Operand.Move {..} = &field.* { continue }
            &place
          }
          _ => { continue }
        }
        let local = source.local
        if local == temporary || !fixedPath(source) { continue }
        let kind = match &locals[local].kind {
          LocalKind.Parameter {..} => true
          LocalKind.User {..} => true
          LocalKind.Temp => true
          _ => false
        }
        if !kind { continue }
        // Nothing between the snapshot and the field touches the source, and the field's own
        // statement names it nowhere else.
        let mut between = snapshot + usize.ONE
        let mut touched = false
        while between < statement {
          if statementNames(&statements[between], local) != usize.ZERO { touched = true }
          between = between + usize.ONE
        }
        if touched || statementNames(&statements[statement], local) != usize.ZERO { continue }
        return Option<FieldSnapshot>.some(FieldSnapshot {statement: statement, operand: operand - usize.ONE, snapshot: snapshot})
      }
    }
    statement = statement + usize.ONE
  }
  return Option<FieldSnapshot>.none()
}

// Splits a local built whole by one aggregate of moved locals, and otherwise only named through
// its fields, into those locals: `e = {a, b}; ... e.0 ...` reads `a` in place of `e.0`. A composed
// Effect is such a local: `run Effect.map(move inner, f)` builds `{inner, f}` from the function's
// parameters, and every step of the run names a part of it. In a suspending frame both live in
// the frame, so the aggregate was a copy of each parameter that LLVM cannot remove.
//
// A part's source is a whole temporary the same block defines earlier, named only there and in
// the aggregate, or a parameter named only by the aggregate or by the one snapshot that a source
// temporary copies or moves it into. Nothing borrows, drops or flags a source. Between the
// earliest source definition and the aggregate nothing names the split local, a parameter source
// is used outside every loop, and the split local is no call's destination and no debug
// variable. Its drop flags guard a field path, which moves to the source.
effect fn splitAggregates(function: &mut MirFunction) -> ()
  ! OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut table = run UseTable.of(&function.*)
  let mut block = usize.ZERO
  while block < List<Block>.length(&function.blocks) {
    let mut at = usize.ZERO
    while at < List<Statement>.length(&List<Block>.asSlice(&function.blocks)[block].statements) {
      let found = run splitCandidate(&mut function.*, &table, block, at)
      if let Option<SplitPlan>.Some { value: plan } = move found {
        run applySplit(&mut function.*, block, move plan)
        table = run UseTable.of(&function.*)

        // The aggregate is gone; the statement now at `at` is the one after it.
        continue
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  return ()
}

// One split: the local, the source of each field index, and the statements of `block` it
// removes, in increasing order.
struct SplitPlan {
  local: usize,
  sources: List<usize>,
  removed: List<usize>,
}

// How a walk over the body treats the places of the split local `local`: counting them and
// checking each has a field first (`apply` false), or naming the field's source instead.
struct SplitWalk {
  local: usize,
  sources: List<usize>,
  apply: bool,
  valid: bool,
  seen: usize,
}

fn splitPlace(place: &mut Place, walk: &mut SplitWalk, destination: bool) -> () {
  let steps = List<Projection>.asSlice(&place.projections)
  let mut at = usize.ZERO
  while at < steps.length {
    if let Projection.Index { local: index } = &steps[at] {
      if index == walk.local {
        walk.valid = false
      }
    }
    at = at + usize.ONE
  }
  if place.local != walk.local {
    return ()
  }
  walk.seen = walk.seen + usize.ONE
  if destination {
    walk.valid = false
  }
  let mut field = usize.MAX
  if steps.length > usize.ZERO {
    if let Projection.Field { index } = &steps[usize.ZERO] {
      field = index
    }
  }
  let sources = List<usize>.asSlice(&walk.sources)
  if field >= sources.length || sources[field] == usize.MAX {
    walk.valid = false
    return ()
  }
  if walk.apply {
    drop List<Projection>.remove(&mut place.projections, usize.ZERO)
    place.local = sources[field]
  }
  return ()
}

fn splitOperand(operand: &mut Operand, walk: &mut SplitWalk) -> () {
  match &mut operand.* {
    Operand.Copy { place } => splitPlace(&mut place, &mut walk.*, false)
    Operand.Move { place } => splitPlace(&mut place, &mut walk.*, false)
    _ => ()
  }
  return ()
}

fn splitOperands(operands: &mut List<Operand>, walk: &mut SplitWalk) -> () {
  let mut listed = List<Operand>.asMutSlice(&mut operands.*)
  let mut at = usize.ZERO
  while at < listed.length {
    splitOperand(&mut listed[at], &mut walk.*)
    at = at + usize.ONE
  }
  return ()
}

fn splitFields(fields: &mut List<AggregateField>, walk: &mut SplitWalk) -> () {
  let mut listed = List<AggregateField>.asMutSlice(&mut fields.*)
  let mut at = usize.ZERO
  while at < listed.length {
    splitOperand(&mut listed[at].value, &mut walk.*)
    at = at + usize.ONE
  }
  return ()
}

// Every place `rvalueNames` counts but assembly inputs; the count check rejects a split local
// named there.
fn splitRvalue(value: &mut Rvalue, walk: &mut SplitWalk) -> () {
  match &mut value.* {
    Rvalue.Aggregate { fields } => splitFields(&mut fields, &mut walk.*)
    Rvalue.Slice { data, count } => {
      splitOperand(&mut data, &mut walk.*)
      splitOperand(&mut count, &mut walk.*)
    }
    Rvalue.SliceLength { place } => splitPlace(&mut place, &mut walk.*, false)
    Rvalue.SliceData { place } => splitPlace(&mut place, &mut walk.*, false)
    Rvalue.PointerOffset { pointer, index, .. } => {
      splitOperand(&mut pointer, &mut walk.*)
      splitOperand(&mut index, &mut walk.*)
    }
    Rvalue.Use { value: used } => splitOperand(&mut used, &mut walk.*)
    Rvalue.Ref { place, .. } => splitPlace(&mut place, &mut walk.*, false)
    Rvalue.AddressOf { place, .. } => splitPlace(&mut place, &mut walk.*, false)
    Rvalue.Unary { value: used, .. } => splitOperand(&mut used, &mut walk.*)
    Rvalue.Binary { left, right, .. } => {
      splitOperand(&mut left, &mut walk.*)
      splitOperand(&mut right, &mut walk.*)
    }
    Rvalue.ScalarBinary { left, right, .. } => {
      splitOperand(&mut left, &mut walk.*)
      splitOperand(&mut right, &mut walk.*)
    }
    Rvalue.ScalarUnary { value: used, .. } => splitOperand(&mut used, &mut walk.*)
    Rvalue.Convert { value: used, .. } => splitOperand(&mut used, &mut walk.*)
    Rvalue.Fits { value: used, .. } => splitOperand(&mut used, &mut walk.*)
    Rvalue.AddressIntegerConversion { operand, .. } => splitOperand(&mut operand, &mut walk.*)
    Rvalue.Bitcast { value: used, .. } => splitOperand(&mut used, &mut walk.*)
    Rvalue.Discriminant { place } => splitPlace(&mut place, &mut walk.*, false)
    Rvalue.Inject { value: used, .. } => splitOperand(&mut used, &mut walk.*)
    Rvalue.Variant { fields, .. } => splitFields(&mut fields, &mut walk.*)
    Rvalue.ContextOf { place } => splitPlace(&mut place, &mut walk.*, false)
    Rvalue.ContextHandle { address } => splitOperand(&mut address, &mut walk.*)
    Rvalue.Atomic { operands, .. } => splitOperands(&mut operands, &mut walk.*)
    Rvalue.Vector { operands, .. } => splitOperands(&mut operands, &mut walk.*)
    Rvalue.StackAllocate { count, .. } => splitOperand(&mut count, &mut walk.*)
    Rvalue.Wasm { operands, .. } => splitOperands(&mut operands, &mut walk.*)
    _ => ()
  }
  return ()
}

fn splitStatement(statement: &mut Statement, walk: &mut SplitWalk) -> () {
  match &mut statement.* {
    Statement.Assign { destination, value, .. } => {
      // A whole write would define the local again.
      if destination.local == walk.local
        && List<Projection>.length(&destination.projections) == usize.ZERO {
        walk.valid = false
      }
      splitPlace(&mut destination, &mut walk.*, false)
      splitRvalue(&mut value, &mut walk.*)
    }
    Statement.Drop { destination, .. } => splitPlace(&mut destination, &mut walk.*, false)
    Statement.FailureContext { destination, source, .. } => {
      splitPlace(&mut destination, &mut walk.*, false)
      if let Option<Place>.Some { value: from } = &mut source {
        splitPlace(&mut from, &mut walk.*, false)
      }
    }
    Statement.SetContextHandle { address, value, .. } => {
      splitOperand(&mut address, &mut walk.*)
      splitOperand(&mut value, &mut walk.*)
    }
  }
  return ()
}

fn splitTerminator(terminator: &mut Terminator, walk: &mut SplitWalk) -> () {
  match &mut terminator.* {
    Terminator.Branch { condition, .. } => splitOperand(&mut condition, &mut walk.*)
    Terminator.Switch { value, .. } => splitOperand(&mut value, &mut walk.*)
    Terminator.TrapText { reason, .. } => splitOperand(&mut reason, &mut walk.*)
    Terminator.Call { callee, arguments, providers, destination, failure, .. } => {
      splitOperands(&mut arguments, &mut walk.*)
      splitOperands(&mut providers, &mut walk.*)

      // A call destination stays a fresh whole temporary (`callDestinationsFresh`).
      splitPlace(&mut destination, &mut walk.*, true)
      match &mut callee {
        Callee.Indirect { address } => splitOperand(&mut address, &mut walk.*)
        Callee.NativeIndirect { address, .. } => splitOperand(&mut address, &mut walk.*)
        _ => ()
      }
      if let Option<FailureEdge>.Some { value: edge } = &mut failure {
        splitPlace(&mut edge.destination, &mut walk.*, true)
      }
    }
    _ => ()
  }
  return ()
}

// Walks every block but the statements `skipped` of `block`.
fn walkSplit(
  function: &mut MirFunction,
  block: usize,
  skipped: &List<usize>,
  walk: &mut SplitWalk,
) -> () {
  let removed = List<usize>.asSlice(&skipped.*)
  let mut blocks = List<Block>.asMutSlice(&mut function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let mut statements = List<Statement>.asMutSlice(&mut blocks[at].statements)
    let mut index = usize.ZERO
    while index < statements.length {
      let mut skip = false
      if at == block {
        let mut k = usize.ZERO
        while k < removed.length {
          if removed[k] == index {
            skip = true
          }
          k = k + usize.ONE
        }
      }
      if !skip {
        splitStatement(&mut statements[index], &mut walk.*)
      }
      index = index + usize.ONE
    }
    splitTerminator(&mut blocks[at].terminator, &mut walk.*)
    at = at + usize.ONE
  }
  return ()
}

fn splitSource(function: &MirFunction, table: &UseTable, local: usize, names: usize) -> bool {
  let uses = UseTable.uses(table, local)
  return uses.named == names && !uses.borrowed && !uses.dropped && !UseTable.flagged(table, local)
}

fn isParameter(function: &MirFunction, local: usize) -> bool {
  return match &List<Local>.asSlice(&function.locals)[local].kind {
    LocalKind.Parameter { .. } => true
    _ => false
  }
}

// Whether `block` can run again after itself.
effect fn inCycle(function: &MirFunction, block: usize) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let count = List<Block>.length(&function.blocks)
  let mut seen = List<bool>.make()
  run List<bool>.appendRepeated(&mut seen, false, count)
  let mut pending = run MirFunction.successors(function, block)
  while true {
    let next = match List<usize>.pop(&mut pending) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        break
      }
    }
    if next == block {
      return true
    }
    if List<bool>.get(&seen, next) {
      continue
    }
    List<bool>.set(&mut seen, next, true)
    let following = run MirFunction.successors(function, next)
    run List<usize>.appendSlice(&mut pending, List<usize>.asSlice(&following))
  }
  return false
}

// The split the aggregate at statement `at` of `block` allows, if any.
// Whether `ty` is an Effect value, such as one a composition intrinsic builds.
fn composedEffect(ty: &Shared<Type>) -> bool {
  return Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
    return match &value.* {
      Type.EffectComposite {..} => true
      Type.EffectJoin {..} => true
      Type.Effect {..} => true
      _ => false
    }
  })
}

effect fn splitCandidate(
  owner: &mut MirFunction,
  table: &UseTable,
  block: usize,
  at: usize,
) -> Option<SplitPlan>
  ! OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let function = &owner.*
  let statements = List<Statement>.asSlice(&List<Block>.asSlice(&function.blocks)[block].statements)
  let mut built = usize.MAX
  let mut operands = List<usize>.make()
  let mut indexes = List<usize>.make()
  match &statements[at] {
    Statement.Assign { destination, value: Rvalue.Aggregate { fields }, .. } => {
      built = wholePlace(&destination)
      let listed = List<AggregateField>.asSlice(&fields)
      let mut k = usize.ZERO
      while k < listed.length {
        run List<usize>.append(&mut operands, wholeLocal(&listed[k].value))
        run List<usize>.append(&mut indexes, listed[k].index)
        k = k + usize.ONE
      }
    }
    _ => {
      return Option<SplitPlan>.none()
    }
  }
  if built == usize.MAX || !isUserOrTemp(function, built)
    || List<usize>.length(&operands) == usize.ZERO {
    return Option<SplitPlan>.none()
  }
  // An ordinary function keeps any other such local in a stack slot that SROA splits anyway,
  // together with its lifetime markers. A composed Effect is copied into the frame of the step
  // that runs it, which SROA cannot see through.
  if let Option<Origin>.None = &function.suspension {
    if !composedEffect(&List<Local>.asSlice(&function.locals)[built].ty) { return Option<SplitPlan>.none() }
  }
  let mut removed = List<usize>.make()
  run List<usize>.append(&mut removed, at)

  // `e = move t` right after the aggregate, with nothing naming `e` between, splits `e`.
  let mut local = built
  let builtUses = UseTable.uses(table, built)
  if isTemp(function, built) && builtUses.named == 2 && !builtUses.borrowed && !builtUses.dropped
    && !UseTable.flagged(table, built) {
    let mut next = at + usize.ONE
    while next < statements.length && statementNames(&statements[next], built) == usize.ZERO {
      next = next + usize.ONE
    }
    if next < statements.length {
      if let Statement.Assign {
        destination,
        value: Rvalue.Use { value: Operand.Move { place } },
        ..
      } = &statements[next] {
        let target = wholePlace(&destination)
        if wholePlace(&place) == built && target != usize.MAX && target != built
          && isUserOrTemp(function, target) {
          let mut between = at + usize.ONE
          let mut clear = true
          while between < next {
            if statementNames(&statements[between], target) != usize.ZERO {
              clear = false
            }
            between = between + usize.ONE
          }
          if clear {
            local = target
            run List<usize>.append(&mut removed, next)
          }
        }
      }
    }
  }

  // The source of each field.
  let mut highest = usize.ZERO
  let listed = List<usize>.asSlice(&indexes)
  let mut k = usize.ZERO
  while k < listed.length {
    if listed[k] > highest {
      highest = listed[k]
    }
    k = k + usize.ONE
  }
  let mut sources = List<usize>.make()
  run List<usize>.appendRepeated(&mut sources, usize.MAX, highest + usize.ONE)
  let mut earliest = at
  let mut parameter = false
  let fields = List<usize>.asSlice(&operands)
  let locals = List<Local>.asSlice(&function.locals)
  k = usize.ZERO
  while k < fields.length {
    let named = fields[k]
    if named == usize.MAX || named == local {
      return Option<SplitPlan>.none()
    }
    let mut source = usize.MAX
    if isParameter(function, named) && splitSource(function, table, named, usize.ONE) {
      source = named
      parameter = true
    } else if isTemp(function, named) && splitSource(function, table, named, 2) {
      let mut definition = at
      let mut found = false
      while definition > usize.ZERO {
        definition = definition - usize.ONE
        if statementNames(&statements[definition], named) != usize.ZERO {
          found = true
          break
        }
      }
      if !found {
        return Option<SplitPlan>.none()
      }
      let mut snapshot = usize.MAX
      match &statements[definition] {
        Statement.Assign { destination, value, .. } => {
          if wholePlace(&destination) != named || rvalueNames(&value, named) != usize.ZERO {
            return Option<SplitPlan>.none()
          }
          match &value {
            Rvalue.Use { value: Operand.Move { place } } => {
              snapshot = wholePlace(&place)
            }
            Rvalue.Use { value: Operand.Copy { place } } => {
              snapshot = wholePlace(&place)
            }
            _ => ()
          }
        }
        _ => {
          return Option<SplitPlan>.none()
        }
      }
      if definition < earliest {
        earliest = definition
      }
      source = named

      // A snapshot of a parameter used nowhere else reads the parameter itself.
      if snapshot != usize.MAX && isParameter(function, snapshot)
        && splitSource(function, table, snapshot, usize.ONE)
        && run Type.equalsShared(&locals[snapshot].ty, &locals[named].ty) {
        source = snapshot
        parameter = true
        run List<usize>.append(&mut removed, definition)
      }
    } else {
      return Option<SplitPlan>.none()
    }
    let mut slots = List<usize>.asMutSlice(&mut sources)
    if slots[listed[k]] != usize.MAX {
      return Option<SplitPlan>.none()
    }
    let mut other = usize.ZERO
    while other < slots.length {
      if slots[other] == source {
        return Option<SplitPlan>.none()
      }
      other = other + usize.ONE
    }
    slots[listed[k]] = source
    k = k + usize.ONE
  }
  let mut between = earliest
  while between < at {
    if statementNames(&statements[between], local) != usize.ZERO {
      return Option<SplitPlan>.none()
    }
    between = between + usize.ONE
  }
  if parameter && run inCycle(function, block) {
    return Option<SplitPlan>.none()
  }
  let variables = List<Variable>.asSlice(&function.variables)
  k = usize.ZERO
  while k < variables.length {
    if variables[k].local == local {
      return Option<SplitPlan>.none()
    }
    k = k + usize.ONE
  }

  // Drop flags of the local guard a field with a source.
  let slotsRead = List<usize>.asSlice(&sources)
  k = usize.ZERO
  while k < locals.length {
    if let LocalKind.DropFlag { local: guarded, path } = &locals[k].kind {
      if guarded == local {
        let steps = List<Projection>.asSlice(&path)
        if steps.length == usize.ZERO {
          return Option<SplitPlan>.none()
        }
        let field = match &steps[usize.ZERO] {
          Projection.Field { index } => index
          _ => usize.MAX
        }
        if field >= slotsRead.length || slotsRead[field] == usize.MAX {
          return Option<SplitPlan>.none()
        }
      }
      let steps = List<Projection>.asSlice(&path)
      let mut step = usize.ZERO
      while step < steps.length {
        if let Projection.Index { local: index } = &steps[step] {
          if index == local {
            return Option<SplitPlan>.none()
          }
        }
        step = step + usize.ONE
      }
    }
    k = k + usize.ONE
  }

  // Every other name of the local is a field place: the walk sees all names the table counts
  // but the removed definitions'.
  let mut walk = SplitWalk {
    local: local,
    sources: run copyIndexes(&sources),
    apply: false,
    valid: true,
    seen: usize.ZERO,
  }
  walkSplit(&mut owner.*, block, &removed, &mut walk)

  // Its one whole definition, the aggregate or `e = move t`, names it once.
  let mut expected = UseTable.uses(table, local).named
  if expected < usize.ONE {
    return Option<SplitPlan>.none()
  }
  expected = expected - usize.ONE
  if !walk.valid || walk.seen != expected {
    return Option<SplitPlan>.none()
  }
  return Option<SplitPlan>.some(
    SplitPlan { local: local, sources: move sources, removed: move removed },
  )
}

effect fn copyIndexes(values: &List<usize>) -> List<usize>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copied = List<usize>.make()
  run List<usize>.appendSlice(&mut copied, List<usize>.asSlice(values))
  return move copied
}

effect fn applySplit(function: &mut MirFunction, block: usize, plan: SplitPlan) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let SplitPlan { local, sources, removed } = move plan
  let mut walk = SplitWalk {
    local: local,
    sources: move sources,
    apply: true,
    valid: true,
    seen: usize.ZERO,
  }
  walkSplit(&mut function.*, block, &removed, &mut walk)

  // Drop flags move to the source of their field.
  let slots = List<usize>.asSlice(&walk.sources)
  let mut locals = List<Local>.asMutSlice(&mut function.locals)
  let mut k = usize.ZERO
  while k < locals.length {
    if let LocalKind.DropFlag { local: guarded, path } = &mut locals[k].kind {
      if guarded == local {
        let field = match &List<Projection>.asSlice(&path)[usize.ZERO] {
          Projection.Field { index } => index
          _ => usize.ZERO
        }
        guarded = slots[field]
        drop List<Projection>.remove(&mut path, usize.ZERO)
      }
    }
    k = k + usize.ONE
  }

  // Later statements first, so earlier indexes stay valid.
  let mut order = move removed
  let mut ordered = List<usize>.asMutSlice(&mut order)
  let mut i = usize.ZERO
  while i < ordered.length {
    let mut j = i + usize.ONE
    while j < ordered.length {
      if ordered[j] > ordered[i] {
        let held = ordered[i]
        ordered[i] = ordered[j]
        ordered[j] = held
      }
      j = j + usize.ONE
    }
    i = i + usize.ONE
  }
  let mut blocks = List<Block>.asMutSlice(&mut function.blocks)
  let listed = List<usize>.asSlice(&order)
  i = usize.ZERO
  while i < listed.length {
    drop List<Statement>.remove(&mut blocks[block].statements, listed[i])
    i = i + usize.ONE
  }
  return ()
}
