//! A binary module prints as WebAssembly text with its names, labels and immediates, and a
//! module the printer cannot read is refused at the byte it stopped at.

import backend.WasmModule
import backend.WasmText
import backend.WasmText {Printed}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.testing.testing {AssertionError, Testing}
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

test effect fn printsNamesLabelsAndImmediates() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run printClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A module importing `env.log`, defining `main` with a block, a branch, a call, a float and a
// load, a memory, a named global, two exports and a data segment.
effect fn sampleModule(body: &Bytes) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut module = Bytes.make()
  run WasmModule.header(&mut module)
  let mut types = Bytes.make()
  run Bytes.append(&mut types, &[1, 0x60, 1, WasmModule.i32Type(), 1, WasmModule.i32Type()])
  run WasmModule.section(&mut module, WasmModule.typeSection(), &types)
  let mut imports = Bytes.make()
  run WasmModule.index(&mut imports, usize.ONE)
  run WasmModule.name(&mut imports, b"env")
  run WasmModule.name(&mut imports, b"log")
  run Bytes.append(&mut imports, &[0, 0])
  run WasmModule.section(&mut module, WasmModule.importSection(), &imports)
  let mut functions = Bytes.make()
  run Bytes.append(&mut functions, &[1, 0])
  run WasmModule.section(&mut module, WasmModule.functionSection(), &functions)
  let mut memories = Bytes.make()
  run Bytes.append(&mut memories, &[1, 0, 1])
  run WasmModule.section(&mut module, WasmModule.memorySection(), &memories)
  let mut globals = Bytes.make()
  run Bytes.append(&mut globals, &[1, WasmModule.i32Type(), 1])
  run WasmModule.i32Const(&mut globals, 16)
  run WasmModule.op(&mut globals, WasmModule.opEnd())
  run WasmModule.section(&mut module, WasmModule.globalSection(), &globals)
  let mut exports = Bytes.make()
  run WasmModule.index(&mut exports, 2)
  run WasmModule.name(&mut exports, b"main")
  run Bytes.append(&mut exports, &[0, 1])
  run WasmModule.name(&mut exports, b"memory")
  run Bytes.append(&mut exports, &[2, 0])
  run WasmModule.section(&mut module, WasmModule.exportSection(), &exports)
  let mut code = Bytes.make()
  run WasmModule.index(&mut code, usize.ONE)
  run WasmModule.index(&mut code, Bytes.length(body))
  run Bytes.append(&mut code, Bytes.asSlice(body))
  run WasmModule.section(&mut module, WasmModule.codeSection(), &code)
  let mut data = Bytes.make()
  run Bytes.append(&mut data, &[1, 0])
  run WasmModule.i32Const(&mut data, 16)
  run WasmModule.op(&mut data, WasmModule.opEnd())
  run WasmModule.name(&mut data, b"hi\n")
  run WasmModule.section(&mut module, WasmModule.dataSection(), &data)
  // The `name` section: functions `log` and `main`, global `sp`.
  let mut functionNames = Bytes.make()
  run Bytes.append(&mut functionNames, &[2, 0])
  run WasmModule.name(&mut functionNames, b"log")
  run Bytes.append(&mut functionNames, &[1])
  run WasmModule.name(&mut functionNames, b"main")
  let mut globalNames = Bytes.make()
  run Bytes.append(&mut globalNames, &[1, 0])
  run WasmModule.name(&mut globalNames, b"sp")
  let mut names = Bytes.make()
  run WasmModule.name(&mut names, b"name")
  run WasmModule.section(&mut names, 1, &functionNames)
  run WasmModule.section(&mut names, 7, &globalNames)
  run WasmModule.section(&mut module, 0, &names)
  return move module
}

effect fn printClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut body = Bytes.make()
  // One i64 local.
  run Bytes.append(&mut body, &[1, 1, WasmModule.i64Type()])
  run WasmModule.structured(&mut body, WasmModule.opBlock())
  run WasmModule.localGet(&mut body, usize.ZERO)
  run WasmModule.opIndex(&mut body, WasmModule.opBrIf(), usize.ZERO)
  run WasmModule.i32Const(&mut body, 4294967295)
  run WasmModule.opIndex(&mut body, WasmModule.opCall(), usize.ZERO)
  run WasmModule.op(&mut body, WasmModule.opDrop())
  run WasmModule.localGet(&mut body, usize.ZERO)
  run WasmModule.i32Const(&mut body, 0)
  run WasmModule.opIndex(&mut body, WasmModule.opCallIndirect(), usize.ZERO)
  run WasmModule.index(&mut body, usize.ZERO)
  run WasmModule.op(&mut body, WasmModule.opDrop())
  run WasmModule.op(&mut body, WasmModule.opEnd())
  // 1.5
  run WasmModule.f64Const(&mut body, 4609434218613702656)
  run WasmModule.op(&mut body, WasmModule.opDrop())
  run WasmModule.localGet(&mut body, usize.ZERO)
  run WasmModule.memoryAccess(&mut body, 0x28, 2, 4)
  run WasmModule.op(&mut body, WasmModule.opEnd())
  let module = run sampleModule(&body)
  let expected = b"(module\n  (type (;0;) (func (param i32) (result i32)))\n  (import \"env\" \"log\" (func $log (;0;) (type 0) (param i32) (result i32)))\n  (memory (;0;) 1)\n  (global $sp (;0;) (mut i32) i32.const 16)\n  (export \"main\" (func $main))\n  (export \"memory\" (memory 0))\n  (func $main (;1;) (type 0) (param i32) (result i32)\n    (local i64)\n    block ;; label = @1\n      local.get 0\n      br_if 0 (;@1;)\n      i32.const -1\n      call $log\n      drop\n      local.get 0\n      i32.const 0\n      call_indirect (type 0)\n      drop\n    end\n    f64.const 1.5\n    drop\n    local.get 0\n    i32.load offset=4\n  )\n  (data (;0;) (i32.const 16) \"hi\\n\")\n)\n"
  match move run WasmText.print(Bytes.asSlice(&module)) {
    Printed.Text {text} => run Testing.expect(same(Bytes.asSlice(&text), expected), "the module prints with its names, labels and immediates")
    Printed.Refused {..} => run Testing.expect(false, "a well-formed module prints")
  }

  // A SIMD instruction is refused at its prefix byte, which follows the locals and `local.get 0`.
  let mut vector = Bytes.make()
  run Bytes.append(&mut vector, &[0])
  run WasmModule.localGet(&mut vector, usize.ZERO)
  run WasmModule.prefixed(&mut vector, 0xFD, 15)
  run WasmModule.op(&mut vector, WasmModule.opEnd())
  let refused = run sampleModule(&vector)
  let mut prefix = usize.ZERO
  let bytes = Bytes.asSlice(&refused)
  while prefix < bytes.length && !(bytes[prefix] == 0x20 && bytes[prefix + usize.ONE] == 0 && bytes[prefix + 2] == 0xFD) { prefix = prefix + usize.ONE }
  match move run WasmText.print(bytes) {
    Printed.Text {..} => run Testing.expect(false, "a SIMD instruction is refused")
    Printed.Refused {offset, ..} => run Testing.expect(offset == prefix + 2, "the refusal names the SIMD prefix byte")
  }
  match move run WasmText.print(&[0, 97, 115, 109, 2, 0, 0, 0]) {
    Printed.Text {..} => run Testing.expect(false, "another binary version is refused")
    Printed.Refused {offset, ..} => run Testing.expect(offset == usize.ZERO, "a bad header is refused at its start")
  }
}
