//! Hand-built SSA functions print as their listing, the builder's variables become block
//! parameters, and the verifier refuses each kind of malformed function by its rule.

import backend.SsaFunction {Binary, Kind, Operation, Predicate, SsaFunction, none}
import backend.SsaPromotion
import backend.SsaText
import backend.SsaVerification
import backend.SsaVerification {Rule, Violation}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.testing.testing {AssertionError, Testing}
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn listing(function: &SsaFunction) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut out = Bytes.make()
  run SsaText.append(function, &mut out)
  return move out
}

fn breaks(found: Option<Violation>, rule: Rule) -> bool {
  return match found {
    Option<Violation>.Some {value} => value.rule == rule
    Option<Violation>.None => false
  }
}

test effect fn buildsPrintsAndVerifies() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run buildClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A sum of 0 to n-1 over a loop whose header takes the counter and the sum, a slot, a call and
// a load at an offset.
effect fn buildClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"sum", 32)
  let int = Kind.integer(32)
  let n = run function.argument(int)
  function.setResult(int)
  let entry = run function.newBlock()
  let header = run function.newBlock()
  let body = run function.newBlock()
  let done = run function.newBlock()
  let counter = run function.addParameter(header, int)
  let sum = run function.addParameter(header, int)
  function.startBlock(entry)
  let zero = run function.integer(32, 0)
  let cell = run function.slotOf(8, 4)
  run function.store(n, cell, 4, 4)
  let start = [zero, zero]
  run function.jumpWith(header, &start)
  function.startBlock(header)
  let more = run function.compare(Predicate.Slt, counter, n)
  run function.branchIf(more, body, done)
  function.startBlock(body)
  let added = run function.binary(Binary.Add, sum, counter)
  let one = run function.integer(32, 1)
  let next = run function.binary(Binary.Add, counter, one)
  let arguments = [next]
  drop run function.call(b"tick", &arguments, Kind.unit())
  let again = [next, added]
  run function.jumpWith(header, &again)
  function.startBlock(done)
  let reloaded = run function.load(int, cell, 4, 4)
  let total = run function.binary(Binary.Add, sum, reloaded)
  run function.ret(total)
  run function.finish()
  let text = run listing(&function)
  let expected = b"function sum(v0: i32) -> i32\n  slot s0: 8 align 4\nblock0:\n  v4: ptr = slot s0\n  store v0, v4 +4 align 4\n  jump block1(i32 0, i32 0)\nblock1(v1: i32, v2: i32):\n  v5: i1 = compare.slt v1, v0\n  branch v5, block2, block3\nblock2:\n  v6: i32 = add v2, v1\n  v8: i32 = add v1, i32 1\n  call @tick -> void v8\n  jump block1(v8, v6)\nblock3:\n  v9: i32 = load v4 +4 align 4\n  v10: i32 = add v2, v9\n  return v10\n"
  run Testing.expect(same(Bytes.asSlice(&text), expected), "the function prints its slot, block parameters, instructions and exits")
  run Testing.expect(!Option<Violation>.isSome(&(run SsaVerification.check(&function))), "a well-formed function passes the verifier")
}

test effect fn promotesVariablesToBlockParameters() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run promotionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A variable set on both arms of a branch and in a loop becomes block parameters; a variable read
// before any assignment reads zero; a slot whose address escapes into a call stays in memory unless
// asked, and one only loaded and stored is promoted when asked.
effect fn promotionClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"pick", 32)
  let int = Kind.integer(32)
  let flag = run function.argument(Kind.flag())
  function.setResult(int)
  let entry = run function.newBlock()
  let left = run function.newBlock()
  let right = run function.newBlock()
  let join = run function.newBlock()
  function.startBlock(entry)
  let chosen = run function.variable(int)
  let untouched = run function.variable(int)
  run function.branchIf(flag, left, right)
  function.startBlock(left)
  let seven = run function.integer(32, 7)
  run function.assign(chosen, seven)
  run function.jump(join)
  function.startBlock(right)
  let nine = run function.integer(32, 9)
  run function.assign(chosen, nine)
  run function.jump(join)
  function.startBlock(join)
  let sum = run function.binary(Binary.Add, chosen, untouched)
  run function.ret(sum)
  run function.finish()
  run SsaPromotion.promote(&mut function, false)
  let text = run listing(&function)
  let expected = b"function pick(v0: i1) -> i32\n  variable slot s0: 4 align 4\n  variable slot s1: 4 align 4\nblock0:\n  branch v0, block1, block2\nblock1:\n  jump block3(i32 7)\nblock2:\n  jump block3(i32 9)\nblock3(v12: i32):\n  v11: i32 = add v12, i32 0\n  return v11\n"
  run Testing.expect(same(Bytes.asSlice(&text), expected), "the assigned variable joins as a parameter and the unassigned one reads zero")
  run Testing.expect(!Option<Violation>.isSome(&(run SsaVerification.check(&function))), "the promoted function passes the verifier")

  // A counting loop over a variable keeps one header parameter.
  let mut looping = run SsaFunction.make(b"count", 64)
  let limit = run looping.argument(Kind.integer(64))
  looping.setResult(Kind.integer(64))
  let start = run looping.newBlock()
  let test = run looping.newBlock()
  let step = run looping.newBlock()
  let exit = run looping.newBlock()
  looping.startBlock(start)
  let counter = run looping.variable(Kind.integer(64))
  run looping.jump(test)
  looping.startBlock(test)
  let below = run looping.compare(Predicate.Ult, counter, limit)
  run looping.branchIf(below, step, exit)
  looping.startBlock(step)
  let one = run looping.integer(64, 1)
  let increased = run looping.binary(Binary.Add, counter, one)
  run looping.assign(counter, increased)
  run looping.jump(test)
  looping.startBlock(exit)
  run looping.ret(counter)
  run looping.finish()
  run SsaPromotion.promote(&mut looping, false)
  let loopText = run listing(&looping)
  let loopExpected = b"function count(v0: i64) -> i64\n  variable slot s0: 8 align 8\nblock0:\n  jump block1(i64 0)\nblock1(v12: i64):\n  v4: i1 = compare.ult v12, v0\n  branch v4, block2, block3\nblock2:\n  v8: i64 = add v12, i64 1\n  jump block1(v8)\nblock3:\n  return v12\n"
  run Testing.expect(same(Bytes.asSlice(&loopText), loopExpected), "a loop-carried variable is one header parameter")
  run Testing.expect(!Option<Violation>.isSome(&(run SsaVerification.check(&looping))), "the promoted loop passes the verifier")

  // A slot passed to a call escapes; one only stored and loaded is promoted when asked.
  let mut slots = run SsaFunction.make(b"slots", 32)
  slots.setResult(Kind.integer(32))
  let only = run slots.newBlock()
  slots.startBlock(only)
  let passed = run slots.slotOf(4, 4)
  let kept = run slots.slotOf(8, 4)
  let arguments = [passed]
  drop run slots.call(b"use", &arguments, Kind.unit())
  let three = run slots.integer(32, 3)
  run slots.store(three, kept, 4, 4)
  let read = run slots.load(Kind.integer(32), kept, 4, 4)
  run slots.ret(read)
  run slots.finish()
  run SsaPromotion.promote(&mut slots, false)
  let unpromoted = run listing(&slots)
  run SsaPromotion.promote(&mut slots, true)
  let promoted = run listing(&slots)
  run Testing.expect(same(Bytes.asSlice(&unpromoted), b"function slots() -> i32\n  slot s0: 4 align 4\n  slot s1: 8 align 4\nblock0:\n  v0: ptr = slot s0\n  v1: ptr = slot s1\n  call @use -> void v0\n  store i32 3, v1 +4 align 4\n  v3: i32 = load v1 +4 align 4\n  return v3\n"),
    "only variable slots are promoted unless every slot is asked for")
  run Testing.expect(same(Bytes.asSlice(&promoted), b"function slots() -> i32\n  slot s0: 4 align 4\n  slot s1: 8 align 4\nblock0:\n  v0: ptr = slot s0\n  call @use -> void v0\n  return i32 3\n"),
    "a slot only stored and loaded is promoted, and the escaping one stays")
}

test effect fn verifierRefusesEachRule() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run verifierClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A function with blocks 0 and 1, started in order, each holding `jump block1` or `return`, which
// each claim then breaks in one way without `finish`.
effect fn twoBlocks() -> SsaFunction ! OutOfMemoryError ? &mut Allocator {
  let mut function = run SsaFunction.make(b"f", 32)
  drop run function.newBlock()
  drop run function.newBlock()
  return move function
}

effect fn verifierClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let int = Kind.integer(32)

  let mut open = run twoBlocks()
  open.startBlock(usize.ZERO)
  run open.jump(usize.ONE)
  open.startBlock(usize.ONE)
  run Testing.expect(breaks(run SsaVerification.check(&open), Rule.OpenBlock), "a block without an exit is refused")

  let mut returned = run twoBlocks()
  returned.setResult(int)
  returned.startBlock(usize.ZERO)
  run returned.jump(usize.ONE)
  returned.startBlock(usize.ONE)
  let yes = run returned.flag(true)
  run returned.ret(yes)
  run Testing.expect(breaks(run SsaVerification.check(&returned), Rule.ExitShape), "a return of another kind than the result is refused")

  let mut toEntry = run twoBlocks()
  toEntry.startBlock(usize.ZERO)
  run toEntry.jump(usize.ONE)
  toEntry.startBlock(usize.ONE)
  run toEntry.jump(usize.ZERO)
  run Testing.expect(breaks(run SsaVerification.check(&toEntry), Rule.EdgeTarget), "an edge to the entry is refused")

  let mut counted = run twoBlocks()
  drop run counted.addParameter(usize.ONE, int)
  counted.startBlock(usize.ZERO)
  run counted.jump(usize.ONE)
  counted.startBlock(usize.ONE)
  run counted.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&counted), Rule.ArgumentCount), "an edge missing an argument is refused")

  let mut kinded = run twoBlocks()
  drop run kinded.addParameter(usize.ONE, int)
  kinded.startBlock(usize.ZERO)
  let no = run kinded.flag(false)
  let wrong = [no]
  run kinded.jumpWith(usize.ONE, &wrong)
  kinded.startBlock(usize.ONE)
  run kinded.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&kinded), Rule.ArgumentKind), "an argument of another kind than its parameter is refused")

  let mut unreached = run twoBlocks()
  unreached.startBlock(usize.ZERO)
  run unreached.ret(none())
  unreached.startBlock(usize.ONE)
  run unreached.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&unreached), Rule.Unreached), "a block no path reaches is refused")

  let mut undefined = run twoBlocks()
  undefined.startBlock(usize.ZERO)
  let dropped = run undefined.integer(32, 1)
  let gone = run undefined.binary(Binary.Add, dropped, dropped)
  run undefined.jump(usize.ONE)
  undefined.startBlock(usize.ONE)
  drop run undefined.binary(Binary.Add, gone, dropped)
  run undefined.ret(none())
  let doomed = List<usize>.get(&undefined.block(usize.ZERO).instructions, usize.ZERO)
  undefined.remove(doomed)
  undefined.sweep()
  run Testing.expect(breaks(run SsaVerification.check(&undefined), Rule.UndefinedValue), "a use of a removed instruction's value is refused")

  let mut early = run twoBlocks()
  let third = run early.newBlock()
  early.startBlock(usize.ZERO)
  let always = run early.flag(true)
  run early.branchIf(always, usize.ONE, third)
  early.startBlock(usize.ONE)
  let first = run early.integer(32, 1)
  let second = run early.integer(32, 2)
  let sideways = run early.binary(Binary.Add, first, second)
  run early.ret(none())
  early.startBlock(third)
  drop run early.binary(Binary.Add, sideways, sideways)
  run early.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&early), Rule.UseBeforeDefinition), "a use its definition does not dominate is refused")

  let mut placed = run twoBlocks()
  placed.startBlock(usize.ZERO)
  let a = run placed.integer(32, 1)
  let b = run placed.integer(32, 2)
  drop run placed.binary(Binary.Add, a, b)
  run placed.jump(usize.ONE)
  placed.startBlock(usize.ONE)
  run placed.ret(none())
  let stale = List<usize>.get(&placed.block(usize.ZERO).instructions, usize.ZERO)
  placed.remove(stale)
  run Testing.expect(breaks(run SsaVerification.check(&placed), Rule.Placement), "a removed instruction left in its block is refused")

  let mut operandCount = run twoBlocks()
  operandCount.startBlock(usize.ZERO)
  let single = run operandCount.integer(32, 1)
  let lone = [single]
  drop run operandCount.addInstruction(Operation.Binary {operation: Binary.Add}, int, &lone)
  run operandCount.jump(usize.ONE)
  operandCount.startBlock(usize.ONE)
  run operandCount.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&operandCount), Rule.OperandCount), "an operation with one operand too few is refused")

  let mut operandKind = run twoBlocks()
  operandKind.startBlock(usize.ZERO)
  let address = run operandKind.null()
  drop run operandKind.binary(Binary.Add, address, address)
  run operandKind.jump(usize.ONE)
  operandKind.startBlock(usize.ONE)
  run operandKind.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&operandKind), Rule.OperandKind), "arithmetic on addresses is refused")

  let mut resultKind = run twoBlocks()
  resultKind.startBlock(usize.ZERO)
  let x = run resultKind.integer(32, 1)
  let y = run resultKind.integer(32, 2)
  let pair = [x, y]
  drop run resultKind.addInstruction(Operation.Compare {predicate: Predicate.Eq}, int, &pair)
  run resultKind.jump(usize.ONE)
  resultKind.startBlock(usize.ONE)
  run resultKind.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&resultKind), Rule.ResultKind), "a comparison yielding an integer is refused")

  let mut ranged = run twoBlocks()
  ranged.startBlock(usize.ZERO)
  drop run ranged.slotAddress(3)
  run ranged.jump(usize.ONE)
  ranged.startBlock(usize.ONE)
  run ranged.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&ranged), Rule.Range), "the address of an undeclared slot is refused")
}
