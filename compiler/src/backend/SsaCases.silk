//! Hand-built SSA functions print as their listing, the builder's variables become block
//! parameters, and the verifier refuses each kind of malformed function by its rule.

import backend.SsaFunction {
  AbiExtension,
  ArchOperation,
  Binary,
  CallingConvention,
  Cast,
  Kind,
  MemoryEffect,
  Operation,
  ParameterAbi,
  Predicate,
  SsaFunction,
  none,
}
import backend.SsaPromotion
import backend.SsaText
import backend.SsaVerification
import backend.SsaVerification {Rule, Violation}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.testing.testing {AssertionError, Testing}
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn listing(function: &SsaFunction) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut out = Bytes.make()
  run SsaText.append(function, &mut out)
  return move out
}

fn breaks(found: Option<Violation>, rule: Rule) -> bool {
  return match found {
    Option<Violation>.Some {value} => value.rule == rule
    Option<Violation>.None => false
  }
}

test effect fn buildsPrintsAndVerifies() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run buildClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A sum of 0 to n-1 over a loop whose header takes the counter and the sum, a slot, a call and
// a load at an offset.
effect fn buildClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"sum", 32)
  let int = Kind.integer(32)
  let n = run function.argument(int)
  function.setResult(int)
  let entry = run function.newBlock()
  let header = run function.newBlock()
  let body = run function.newBlock()
  let done = run function.newBlock()
  let counter = run function.addParameter(header, int)
  let sum = run function.addParameter(header, int)
  function.startBlock(entry)
  let zero = run function.integer(32, 0)
  let cell = run function.slotOf(8, 4)
  run function.store(n, cell, 4, 4)
  let start = [zero, zero]
  run function.jumpWith(header, &start)
  function.startBlock(header)
  let more = run function.compare(Predicate.Slt, counter, n)
  run function.branchIf(more, body, done)
  function.startBlock(body)
  let added = run function.binary(Binary.Add, sum, counter)
  let one = run function.integer(32, 1)
  let next = run function.binary(Binary.Add, counter, one)
  let arguments = [next]
  drop run function.call(b"tick", &arguments, Kind.unit())
  let again = [next, added]
  run function.jumpWith(header, &again)
  function.startBlock(done)
  let reloaded = run function.load(int, cell, 4, 4)
  let total = run function.binary(Binary.Add, sum, reloaded)
  run function.ret(total)
  run function.finish()
  let text = run listing(&function)
  let expected = b"function sum(v0: i32) -> i32\n  slot s0: 8 align 4\nblock0:\n  v4: ptr = slot s0\n  store v0, v4 +4 align 4\n  jump block1(i32 0, i32 0)\nblock1(v1: i32, v2: i32):\n  v5: i1 = compare.slt v1, v0\n  branch v5, block2, block3\nblock2:\n  v6: i32 = add v2, v1\n  v8: i32 = add v1, i32 1\n  call @tick -> void v8\n  jump block1(v8, v6)\nblock3:\n  v9: i32 = load v4 +4 align 4\n  v10: i32 = add v2, v9\n  return v10\n"
  run Testing.expect(same(Bytes.asSlice(&text), expected), "the function prints its slot, block parameters, instructions and exits")
  run Testing.expect(!Option<Violation>.isSome(&(run SsaVerification.check(&function))), "a well-formed function passes the verifier")
}

test effect fn promotesVariablesToBlockParameters() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run promotionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A variable set on both arms of a branch and in a loop becomes block parameters; a variable read
// before any assignment reads zero; a slot whose address escapes into a call stays in memory unless
// asked, and one only loaded and stored is promoted when asked.
effect fn promotionClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"pick", 32)
  let int = Kind.integer(32)
  let flag = run function.argument(Kind.flag())
  function.setResult(int)
  let entry = run function.newBlock()
  let left = run function.newBlock()
  let right = run function.newBlock()
  let join = run function.newBlock()
  function.startBlock(entry)
  let chosen = run function.variable(int)
  let untouched = run function.variable(int)
  run function.branchIf(flag, left, right)
  function.startBlock(left)
  let seven = run function.integer(32, 7)
  run function.assign(chosen, seven)
  run function.jump(join)
  function.startBlock(right)
  let nine = run function.integer(32, 9)
  run function.assign(chosen, nine)
  run function.jump(join)
  function.startBlock(join)
  let sum = run function.binary(Binary.Add, chosen, untouched)
  run function.ret(sum)
  run function.finish()
  run SsaPromotion.promote(&mut function, false)
  let text = run listing(&function)
  let expected = b"function pick(v0: i1) -> i32\n  variable slot s0: 4 align 4\n  variable slot s1: 4 align 4\nblock0:\n  branch v0, block1, block2\nblock1:\n  jump block3(i32 7)\nblock2:\n  jump block3(i32 9)\nblock3(v12: i32):\n  v11: i32 = add v12, i32 0\n  return v11\n"
  run Testing.expect(same(Bytes.asSlice(&text), expected), "the assigned variable joins as a parameter and the unassigned one reads zero")
  run Testing.expect(!Option<Violation>.isSome(&(run SsaVerification.check(&function))), "the promoted function passes the verifier")

  // A counting loop over a variable keeps one header parameter.
  let mut looping = run SsaFunction.make(b"count", 64)
  let limit = run looping.argument(Kind.integer(64))
  looping.setResult(Kind.integer(64))
  let start = run looping.newBlock()
  let test = run looping.newBlock()
  let step = run looping.newBlock()
  let exit = run looping.newBlock()
  looping.startBlock(start)
  let counter = run looping.variable(Kind.integer(64))
  run looping.jump(test)
  looping.startBlock(test)
  let below = run looping.compare(Predicate.Ult, counter, limit)
  run looping.branchIf(below, step, exit)
  looping.startBlock(step)
  let one = run looping.integer(64, 1)
  let increased = run looping.binary(Binary.Add, counter, one)
  run looping.assign(counter, increased)
  run looping.jump(test)
  looping.startBlock(exit)
  run looping.ret(counter)
  run looping.finish()
  run SsaPromotion.promote(&mut looping, false)
  let loopText = run listing(&looping)
  let loopExpected = b"function count(v0: i64) -> i64\n  variable slot s0: 8 align 8\nblock0:\n  jump block1(i64 0)\nblock1(v12: i64):\n  v4: i1 = compare.ult v12, v0\n  branch v4, block2, block3\nblock2:\n  v8: i64 = add v12, i64 1\n  jump block1(v8)\nblock3:\n  return v12\n"
  run Testing.expect(same(Bytes.asSlice(&loopText), loopExpected), "a loop-carried variable is one header parameter")
  run Testing.expect(!Option<Violation>.isSome(&(run SsaVerification.check(&looping))), "the promoted loop passes the verifier")

  // A slot passed to a call escapes; one only stored and loaded is promoted when asked.
  let mut slots = run SsaFunction.make(b"slots", 32)
  slots.setResult(Kind.integer(32))
  let only = run slots.newBlock()
  slots.startBlock(only)
  let passed = run slots.slotOf(4, 4)
  let kept = run slots.slotOf(8, 4)
  let arguments = [passed]
  drop run slots.call(b"use", &arguments, Kind.unit())
  let three = run slots.integer(32, 3)
  run slots.store(three, kept, 4, 4)
  let read = run slots.load(Kind.integer(32), kept, 4, 4)
  run slots.ret(read)
  run slots.finish()
  run SsaPromotion.promote(&mut slots, false)
  let unpromoted = run listing(&slots)
  run SsaPromotion.promote(&mut slots, true)
  let promoted = run listing(&slots)
  run Testing.expect(same(Bytes.asSlice(&unpromoted), b"function slots() -> i32\n  slot s0: 4 align 4\n  slot s1: 8 align 4\nblock0:\n  v0: ptr = slot s0\n  v1: ptr = slot s1\n  call @use -> void v0\n  store i32 3, v1 +4 align 4\n  v3: i32 = load v1 +4 align 4\n  return v3\n"),
    "only variable slots are promoted unless every slot is asked for")
  run Testing.expect(same(Bytes.asSlice(&promoted), b"function slots() -> i32\n  slot s0: 4 align 4\n  slot s1: 8 align 4\nblock0:\n  v0: ptr = slot s0\n  call @use -> void v0\n  return i32 3\n"),
    "a slot only stored and loaded is promoted, and the escaping one stays")
}

test effect fn verifierRefusesEachRule() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run verifierClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A function with blocks 0 and 1, started in order, each holding `jump block1` or `return`, which
// each claim then breaks in one way without `finish`.
effect fn twoBlocks() -> SsaFunction ! OutOfMemoryError ? &mut Allocator {
  let mut function = run SsaFunction.make(b"f", 32)
  drop run function.newBlock()
  drop run function.newBlock()
  return move function
}

effect fn verifierClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let int = Kind.integer(32)

  let mut open = run twoBlocks()
  open.startBlock(usize.ZERO)
  run open.jump(usize.ONE)
  open.startBlock(usize.ONE)
  run Testing.expect(breaks(run SsaVerification.check(&open), Rule.OpenBlock), "a block without an exit is refused")

  let mut returned = run twoBlocks()
  returned.setResult(int)
  returned.startBlock(usize.ZERO)
  run returned.jump(usize.ONE)
  returned.startBlock(usize.ONE)
  let yes = run returned.flag(true)
  run returned.ret(yes)
  run Testing.expect(breaks(run SsaVerification.check(&returned), Rule.ExitShape), "a return of another kind than the result is refused")

  let mut toEntry = run twoBlocks()
  toEntry.startBlock(usize.ZERO)
  run toEntry.jump(usize.ONE)
  toEntry.startBlock(usize.ONE)
  run toEntry.jump(usize.ZERO)
  run Testing.expect(breaks(run SsaVerification.check(&toEntry), Rule.EdgeTarget), "an edge to the entry is refused")

  let mut counted = run twoBlocks()
  drop run counted.addParameter(usize.ONE, int)
  counted.startBlock(usize.ZERO)
  run counted.jump(usize.ONE)
  counted.startBlock(usize.ONE)
  run counted.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&counted), Rule.ArgumentCount), "an edge missing an argument is refused")

  let mut kinded = run twoBlocks()
  drop run kinded.addParameter(usize.ONE, int)
  kinded.startBlock(usize.ZERO)
  let no = run kinded.flag(false)
  let wrong = [no]
  run kinded.jumpWith(usize.ONE, &wrong)
  kinded.startBlock(usize.ONE)
  run kinded.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&kinded), Rule.ArgumentKind), "an argument of another kind than its parameter is refused")

  let mut unreached = run twoBlocks()
  unreached.startBlock(usize.ZERO)
  run unreached.ret(none())
  unreached.startBlock(usize.ONE)
  run unreached.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&unreached), Rule.Unreached), "a block no path reaches is refused")

  let mut undefined = run twoBlocks()
  undefined.startBlock(usize.ZERO)
  let dropped = run undefined.integer(32, 1)
  let gone = run undefined.binary(Binary.Add, dropped, dropped)
  run undefined.jump(usize.ONE)
  undefined.startBlock(usize.ONE)
  drop run undefined.binary(Binary.Add, gone, dropped)
  run undefined.ret(none())
  let doomed = List<usize>.get(&undefined.block(usize.ZERO).instructions, usize.ZERO)
  undefined.remove(doomed)
  undefined.sweep()
  run Testing.expect(breaks(run SsaVerification.check(&undefined), Rule.UndefinedValue), "a use of a removed instruction's value is refused")

  let mut early = run twoBlocks()
  let third = run early.newBlock()
  early.startBlock(usize.ZERO)
  let always = run early.flag(true)
  run early.branchIf(always, usize.ONE, third)
  early.startBlock(usize.ONE)
  let first = run early.integer(32, 1)
  let second = run early.integer(32, 2)
  let sideways = run early.binary(Binary.Add, first, second)
  run early.ret(none())
  early.startBlock(third)
  drop run early.binary(Binary.Add, sideways, sideways)
  run early.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&early), Rule.UseBeforeDefinition), "a use its definition does not dominate is refused")

  let mut placed = run twoBlocks()
  placed.startBlock(usize.ZERO)
  let a = run placed.integer(32, 1)
  let b = run placed.integer(32, 2)
  drop run placed.binary(Binary.Add, a, b)
  run placed.jump(usize.ONE)
  placed.startBlock(usize.ONE)
  run placed.ret(none())
  let stale = List<usize>.get(&placed.block(usize.ZERO).instructions, usize.ZERO)
  placed.remove(stale)
  run Testing.expect(breaks(run SsaVerification.check(&placed), Rule.Placement), "a removed instruction left in its block is refused")

  let mut operandCount = run twoBlocks()
  operandCount.startBlock(usize.ZERO)
  let single = run operandCount.integer(32, 1)
  let lone = [single]
  drop run operandCount.addInstruction(Operation.Binary {operation: Binary.Add}, int, &lone)
  run operandCount.jump(usize.ONE)
  operandCount.startBlock(usize.ONE)
  run operandCount.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&operandCount), Rule.OperandCount), "an operation with one operand too few is refused")

  let mut operandKind = run twoBlocks()
  operandKind.startBlock(usize.ZERO)
  let address = run operandKind.null()
  drop run operandKind.binary(Binary.Add, address, address)
  run operandKind.jump(usize.ONE)
  operandKind.startBlock(usize.ONE)
  run operandKind.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&operandKind), Rule.OperandKind), "arithmetic on addresses is refused")

  let mut resultKind = run twoBlocks()
  resultKind.startBlock(usize.ZERO)
  let x = run resultKind.integer(32, 1)
  let y = run resultKind.integer(32, 2)
  let pair = [x, y]
  drop run resultKind.addInstruction(Operation.Compare {predicate: Predicate.Eq}, int, &pair)
  run resultKind.jump(usize.ONE)
  resultKind.startBlock(usize.ONE)
  run resultKind.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&resultKind), Rule.ResultKind), "a comparison yielding an integer is refused")

  let mut ranged = run twoBlocks()
  ranged.startBlock(usize.ZERO)
  drop run ranged.slotAddress(3)
  run ranged.jump(usize.ONE)
  ranged.startBlock(usize.ONE)
  run ranged.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&ranged), Rule.Range), "the address of an undeclared slot is refused")

  // Native SSA extension verification refusals.
  let mut missingSecond = run twoBlocks()
  missingSecond.setResults(int, Kind.float(64))
  missingSecond.startBlock(usize.ZERO)
  run missingSecond.jump(usize.ONE)
  missingSecond.startBlock(usize.ONE)
  let onlyOne = run missingSecond.integer(32, 1)
  run missingSecond.ret(onlyOne)
  run Testing.expect(breaks(run SsaVerification.check(&missingSecond), Rule.ExitShape), "a 1-value return in a 2-result function is refused")

  let mut badSlotStart = run twoBlocks()
  badSlotStart.startBlock(usize.ZERO)
  run badSlotStart.slotStart(5)
  run badSlotStart.jump(usize.ONE)
  badSlotStart.startBlock(usize.ONE)
  run badSlotStart.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&badSlotStart), Rule.Range), "slot.start naming an undeclared slot is refused")

  let mut badAbi = run twoBlocks()
  badAbi.startBlock(usize.ZERO)
  drop run badAbi.callWithAbi(b"ext", &[], Kind.unit(), Kind.unit(), 7)
  run badAbi.jump(usize.ONE)
  badAbi.startBlock(usize.ONE)
  run badAbi.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&badAbi), Rule.Range), "a call naming an undeclared CallAbi descriptor is refused")

  let mut badAsm = run twoBlocks()
  badAsm.startBlock(usize.ZERO)
  drop run badAsm.addInstruction(Operation.InlineAsm {index: 2, readsMemory: false, writesMemory: false, sideEffects: true, noReturn: false}, Kind.unit(), &[])
  run badAsm.jump(usize.ONE)
  badAsm.startBlock(usize.ONE)
  run badAsm.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&badAsm), Rule.Range), "inline asm naming an undeclared assembly entry is refused")

  let mut badArchArity = run twoBlocks()
  badArchArity.startBlock(usize.ZERO)
  let vec = run badArchArity.constant(Kind.vector(Kind.integer(32), 4), 0)
  drop run badArchArity.archIntrinsic(ArchOperation.X86Sha256Rounds2, 0, &[vec, vec], Kind.vector(Kind.integer(32), 4))
  run badArchArity.jump(usize.ONE)
  badArchArity.startBlock(usize.ONE)
  run badArchArity.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&badArchArity), Rule.OperandCount), "sha256rnds2 with two operands instead of three is refused")

  let mut badVa = run twoBlocks()
  badVa.startBlock(usize.ZERO)
  let nonPtr = run badVa.integer(32, 0)
  run badVa.vaStart(nonPtr)
  run badVa.jump(usize.ONE)
  badVa.startBlock(usize.ONE)
  run badVa.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&badVa), Rule.OperandKind), "va.start on a non-address operand is refused")

  // AArch64 ArchIntrinsic verification: arity, operand shapes, and result shapes.
  let v16i8 = Kind.vector(Kind.integer(8), 16)
  let v8i16 = Kind.vector(Kind.integer(16), 8)
  let v4i32 = Kind.vector(Kind.integer(32), 4)
  let v2i64 = Kind.vector(Kind.integer(64), 2)

  let mut badAesmcArity = run twoBlocks()
  badAesmcArity.startBlock(usize.ZERO)
  let c16i8 = run badAesmcArity.constant(v16i8, 0)
  drop run badAesmcArity.archIntrinsic(ArchOperation.Aarch64AesMixColumns, 0, &[c16i8, c16i8], v16i8)
  run badAesmcArity.jump(usize.ONE)
  badAesmcArity.startBlock(usize.ONE)
  run badAesmcArity.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&badAesmcArity), Rule.OperandCount), "aesmc with two operands instead of one is refused")

  let mut badShaArity = run twoBlocks()
  badShaArity.startBlock(usize.ZERO)
  let c4i32 = run badShaArity.constant(v4i32, 0)
  drop run badShaArity.archIntrinsic(ArchOperation.Aarch64Sha256Hash, 0, &[c4i32, c4i32], v4i32)
  run badShaArity.jump(usize.ONE)
  badShaArity.startBlock(usize.ONE)
  run badShaArity.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&badShaArity), Rule.OperandCount), "sha256h with two operands instead of three is refused")

  let mut badDotArity = run twoBlocks()
  badDotArity.startBlock(usize.ZERO)
  let c4d = run badDotArity.constant(v4i32, 0)
  let c16d = run badDotArity.constant(v16i8, 0)
  drop run badDotArity.archIntrinsic(ArchOperation.Aarch64UnsignedDotProduct, 0, &[c4d, c16d], v4i32)
  run badDotArity.jump(usize.ONE)
  badDotArity.startBlock(usize.ONE)
  run badDotArity.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&badDotArity), Rule.OperandCount), "udot with two operands instead of three is refused")

  let mut badTblShape = run twoBlocks()
  badTblShape.startBlock(usize.ZERO)
  let c8i16 = run badTblShape.constant(v8i16, 0)
  drop run badTblShape.archIntrinsic(ArchOperation.Aarch64TableLookup, 0, &[c8i16, c8i16], v16i8)
  run badTblShape.jump(usize.ONE)
  badTblShape.startBlock(usize.ONE)
  run badTblShape.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&badTblShape), Rule.OperandKind), "tbl with v8xi16 operands is refused")

  let mut badDotOperand = run twoBlocks()
  badDotOperand.startBlock(usize.ZERO)
  let dAcc = run badDotOperand.constant(v4i32, 0)
  let dBytes = run badDotOperand.constant(v16i8, 0)
  drop run badDotOperand.archIntrinsic(ArchOperation.Aarch64SignedDotProduct, 0, &[dAcc, dAcc, dBytes], v4i32)
  run badDotOperand.jump(usize.ONE)
  badDotOperand.startBlock(usize.ONE)
  run badDotOperand.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&badDotOperand), Rule.OperandKind), "sdot with non-v16xi8 source operand is refused")

  let mut badAddpShape = run twoBlocks()
  badAddpShape.startBlock(usize.ZERO)
  let c2i64 = run badAddpShape.constant(v2i64, 0)
  drop run badAddpShape.archIntrinsic(ArchOperation.Aarch64PairwiseAdd, 0, &[c2i64, c2i64], v2i64)
  run badAddpShape.jump(usize.ONE)
  badAddpShape.startBlock(usize.ONE)
  run badAddpShape.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&badAddpShape), Rule.OperandKind), "addp with v2xi64 operands is refused")

  let mut badPmullShape = run twoBlocks()
  badPmullShape.startBlock(usize.ZERO)
  let c4p = run badPmullShape.constant(v4i32, 0)
  drop run badPmullShape.archIntrinsic(ArchOperation.Aarch64PolynomialMultiply, 0, &[c4p, c4p], v2i64)
  run badPmullShape.jump(usize.ONE)
  badPmullShape.startBlock(usize.ONE)
  run badPmullShape.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&badPmullShape), Rule.OperandKind), "pmull with v4xi32 operands is refused")

  let mut badTblResult = run twoBlocks()
  badTblResult.startBlock(usize.ZERO)
  let tIn = run badTblResult.constant(v16i8, 0)
  drop run badTblResult.archIntrinsic(ArchOperation.Aarch64TableLookup, 0, &[tIn, tIn], v8i16)
  run badTblResult.jump(usize.ONE)
  badTblResult.startBlock(usize.ONE)
  run badTblResult.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&badTblResult), Rule.ResultKind), "tbl returning v8xi16 is refused")

  let mut badAddpResult = run twoBlocks()
  badAddpResult.startBlock(usize.ZERO)
  let aIn = run badAddpResult.constant(v8i16, 0)
  drop run badAddpResult.archIntrinsic(ArchOperation.Aarch64PairwiseAdd, 0, &[aIn, aIn], v4i32)
  run badAddpResult.jump(usize.ONE)
  badAddpResult.startBlock(usize.ONE)
  run badAddpResult.ret(none())
  run Testing.expect(breaks(run SsaVerification.check(&badAddpResult), Rule.ResultKind), "addp returning mismatched lane kind is refused")
}

fn contains(haystack: &[u8], needle: &[u8]) -> bool {
  if needle.length == usize.ZERO { return true }
  if needle.length > haystack.length { return false }
  let mut start = usize.ZERO
  while start + needle.length <= haystack.length {
    let mut at = usize.ZERO
    let mut matched = true
    while at < needle.length {
      if haystack[start + at] != needle[at] {
        matched = false
        break
      }
      at = at + usize.ONE
    }
    if matched { return true }
    start = start + usize.ONE
  }
  return false
}

test effect fn buildsPrintsAndVerifiesNativeExtensions() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run nativeExtensionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nativeExtensionClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut f = run SsaFunction.make(b"native_ext", 64)
  let i64Kind = Kind.integer(64)
  let f64Kind = Kind.float(64)
  let v2i64 = Kind.vector(i64Kind, 2)
  let v4i32 = Kind.vector(Kind.integer(32), 4)
  f.setCallingConvention(CallingConvention.C, true, AbiExtension.None)
  f.setResults(i64Kind, f64Kind)
  let p0 = run f.argument(i64Kind)
  let p1 = run f.argument(v2i64)
  let p2 = run f.argument(v4i32)
  f.setArgumentAbi(p0, ParameterAbi {extension: AbiExtension.Signed, byvalSize: 0, byvalAlignment: usize.ZERO, sret: false, groupRemaining: 0, stackAlignment: usize.ZERO})
  let entry = run f.newBlock()
  f.startBlock(entry)
  let vaSlot = run f.slotOf(32, 8)
  run f.slotStart(0)
  run f.vaStart(vaSlot)
  let abi = run f.addCallAbi(CallingConvention.C, AbiExtension.Unsigned, &[ParameterAbi.plain()])
  let pair = run f.callWithAbi(b"sysv_pair", &[p0], i64Kind, f64Kind, abi)
  let clmul = run f.archIntrinsic(ArchOperation.X86CarrylessMultiply, 0, &[p1, p1], v2i64)
  let sha1 = run f.archIntrinsic(ArchOperation.X86Sha1Rounds4, 2, &[p2, p2], v4i32)
  let zero32 = run f.integer(32, 0)
  let lane0 = run f.extractElement(clmul, zero32)
  let lane1 = run f.extractElement(sha1, zero32)
  let wide1 = run f.cast(Cast.ZExt, lane1, i64Kind)
  let sum = run f.binary(Binary.Add, pair, lane0)
  let asmOut = run f.inlineAsm(b"add $0, $1", b"=r,0,r", b"flags", MemoryEffect.None, true, false, &[sum, wide1], i64Kind)
  run f.vaEnd(vaSlot)
  run f.slotEnd(0)
  run f.retPair(asmOut, pair + 1)
  run f.finish()

  run Testing.expect(!Option<Violation>.isSome(&(run SsaVerification.check(&f))), "native SSA extensions pass verification")
  run Testing.expect(f.callingConvention == CallingConvention.C && f.variadic, "calling convention and variadic flag are recorded")
  run Testing.expect(f.argumentAbi(usize.ZERO).extension == AbiExtension.Signed, "argument ABI extension is recorded")
  run Testing.expect(f.callAbiCount() == usize.ONE && f.callAbi(0).resultExtension == AbiExtension.Unsigned, "call ABI descriptor is recorded")
  run Testing.expect(f.asmCount() == usize.ONE && same(Bytes.asSlice(&f.asm(0).template), b"add $0, $1"), "inline asm template is stored")

  let text = run listing(&f)
  let printed = Bytes.asSlice(&text)
  run Testing.expect(contains(printed, b"-> (i64, f64)"), "pair return type prints in header")
  run Testing.expect(contains(printed, b"slot.start s0"), "slot.start prints")
  run Testing.expect(contains(printed, b"slot.end s0"), "slot.end prints")
  run Testing.expect(contains(printed, b"va.start"), "va.start prints")
  run Testing.expect(contains(printed, b"va.end"), "va.end prints")
  run Testing.expect(contains(printed, b"arch.x86.pclmulqdq"), "pclmulqdq arch intrinsic prints")
  run Testing.expect(contains(printed, b"arch.x86.sha1rnds4"), "sha1rnds4 arch intrinsic prints")
  run Testing.expect(contains(printed, b"imm 2"), "arch intrinsic immediate prints")
  run Testing.expect(contains(printed, b"asm #0"), "inline asm prints")
  run Testing.expect(contains(printed, b"return "), "pair return prints")

  // Packing preserves all values, pair returns, and verification.
  run f.pack()
  run Testing.expect(!Option<Violation>.isSome(&(run SsaVerification.check(&f))), "packed native SSA function passes verification")
}

test effect fn buildsPrintsAndVerifiesAarch64ArchOperations() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run aarch64ArchClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn aarch64ArchClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut f = run SsaFunction.make(b"aarch64_ext", 64)
  let v16i8 = Kind.vector(Kind.integer(8), 16)
  let v8i16 = Kind.vector(Kind.integer(16), 8)
  let v4i32 = Kind.vector(Kind.integer(32), 4)
  let v2i64 = Kind.vector(Kind.integer(64), 2)
  f.setCallingConvention(CallingConvention.C, false, AbiExtension.None)
  f.setResult(v4i32)
  let p0 = run f.argument(v16i8)
  let p1 = run f.argument(v8i16)
  let p2 = run f.argument(v4i32)
  let p3 = run f.argument(v2i64)
  f.setArgumentAbi(p0, ParameterAbi {extension: AbiExtension.None, byvalSize: 0, byvalAlignment: usize.ZERO, sret: false, groupRemaining: 2, stackAlignment: 8})
  let entry = run f.newBlock()
  f.startBlock(entry)

  let t = run f.archIntrinsic(ArchOperation.Aarch64TableLookup, 0, &[p0, p0], v16i8)
  let ae = run f.archIntrinsic(ArchOperation.Aarch64AesEncrypt, 0, &[t, p0], v16i8)
  let am = run f.archIntrinsic(ArchOperation.Aarch64AesMixColumns, 0, &[ae], v16i8)
  let ad = run f.archIntrinsic(ArchOperation.Aarch64AesDecrypt, 0, &[am, p0], v16i8)
  let ai = run f.archIntrinsic(ArchOperation.Aarch64AesInverseMixColumns, 0, &[ad], v16i8)
  let addp8 = run f.archIntrinsic(ArchOperation.Aarch64PairwiseAdd, 0, &[ai, p0], v16i8)
  let addp16 = run f.archIntrinsic(ArchOperation.Aarch64PairwiseAdd, 0, &[p1, p1], v8i16)
  let addp32 = run f.archIntrinsic(ArchOperation.Aarch64PairwiseAdd, 0, &[p2, p2], v4i32)
  let ud = run f.archIntrinsic(ArchOperation.Aarch64UnsignedDotProduct, 0, &[addp32, addp8, p0], v4i32)
  let sd = run f.archIntrinsic(ArchOperation.Aarch64SignedDotProduct, 0, &[ud, addp8, p0], v4i32)
  let pm0 = run f.archIntrinsic(ArchOperation.Aarch64PolynomialMultiply, 0, &[p3, p3], v2i64)
  let pm1 = run f.archIntrinsic(ArchOperation.Aarch64PolynomialMultiplyHigh, 0, &[pm0, p3], v2i64)
  let sh0 = run f.archIntrinsic(ArchOperation.Aarch64Sha256Hash, 0, &[sd, p2, p2], v4i32)
  let sh1 = run f.archIntrinsic(ArchOperation.Aarch64Sha256Hash2, 0, &[sh0, sd, p2], v4i32)
  let su0 = run f.archIntrinsic(ArchOperation.Aarch64Sha256ScheduleUpdate0, 0, &[sh1, p2], v4i32)
  let su1 = run f.archIntrinsic(ArchOperation.Aarch64Sha256ScheduleUpdate1, 0, &[su0, sh1, p2], v4i32)
  let mix16 = run f.cast(Cast.Bitcast, addp16, v4i32)
  let mix64 = run f.cast(Cast.Bitcast, pm1, v4i32)
  let res0 = run f.binary(Binary.Xor, su1, mix16)
  let res1 = run f.binary(Binary.Xor, res0, mix64)
  run f.ret(res1)
  run f.finish()

  run Testing.expect(!Option<Violation>.isSome(&(run SsaVerification.check(&f))), "all 14 AArch64 ArchOperations pass verification")
  run Testing.expect(f.argumentAbi(usize.ZERO).groupRemaining == 2 && f.argumentAbi(usize.ZERO).stackAlignment == 8,
    "ParameterAbi preserves groupRemaining and stackAlignment")

  let text = run listing(&f)
  let printed = Bytes.asSlice(&text)
  run Testing.expect(contains(printed, b"arch.aarch64.tbl"), "tbl prints")
  run Testing.expect(contains(printed, b"arch.aarch64.udot"), "udot prints")
  run Testing.expect(contains(printed, b"arch.aarch64.sdot"), "sdot prints")
  run Testing.expect(contains(printed, b"arch.aarch64.addp"), "addp prints")
  run Testing.expect(contains(printed, b"arch.aarch64.aese"), "aese prints")
  run Testing.expect(contains(printed, b"arch.aarch64.aesd"), "aesd prints")
  run Testing.expect(contains(printed, b"arch.aarch64.aesmc"), "aesmc prints")
  run Testing.expect(contains(printed, b"arch.aarch64.aesimc"), "aesimc prints")
  run Testing.expect(contains(printed, b"arch.aarch64.pmull "), "pmull prints")
  run Testing.expect(contains(printed, b"arch.aarch64.pmull2"), "pmull2 prints")
  run Testing.expect(contains(printed, b"arch.aarch64.sha256h "), "sha256h prints")
  run Testing.expect(contains(printed, b"arch.aarch64.sha256h2"), "sha256h2 prints")
  run Testing.expect(contains(printed, b"arch.aarch64.sha256su0"), "sha256su0 prints")
  run Testing.expect(contains(printed, b"arch.aarch64.sha256su1"), "sha256su1 prints")

  run f.pack()
  run Testing.expect(!Option<Violation>.isSome(&(run SsaVerification.check(&f))), "packed AArch64 SSA function passes verification")
}
