//! Dead code elimination for one SSA function: instructions and block parameters whose values
//! nothing observable needs.
//!
//! # When to use
//! Run [`eliminate`] in an optimized build after the passes that leave values unused, such as
//! value numbering and load forwarding. Dead stores are `SsaMemory`'s, which knows what memory a
//! store can reach.
//!
//! # Details
//! A value is live when an exit uses it, when a live instruction uses it, or when it is the
//! argument an edge passes to a live parameter. An instruction is kept when it is live or
//! observable: it has side effects (`Operation.hasSideEffects`) or it can trap
//! (`SsaFunction.mayTrap`), since a trap is the program's behavior, with one exception: a load
//! from a stack slot or from the frame, at a constant offset, cannot trap, so an unused one goes.
//! Every other instruction and every parameter that is not live is removed.

import backend.SsaFunction {Definition, Edge, Operation, SsaFunction, none}
import backend.SsaGraph {SsaGraph}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.u64
import silk.num.usize

/// Removes the instructions and block parameters of `function` that nothing observable needs;
/// answers whether it removed any.
pub effect fn eliminate(function: &mut SsaFunction) -> bool ! OutOfMemoryError ? &mut Allocator {
  let graph = run SsaGraph.of(&function.*)
  let values = function.valueCount()
  let mut live = run List<bool>.makeWithCapacity(values)
  run List<bool>.appendRepeated(&mut live, false, values)
  let mut kept = run List<bool>.makeWithCapacity(function.instructionCount())
  run List<bool>.appendRepeated(&mut kept, false, function.instructionCount())
  let mut work = List<u64>.make()
  let blocks = function.blockCount()
  let mut block = usize.ZERO
  while block < blocks {
    let listed = List<usize>.asSlice(&function.block(block).instructions)
    let mut at = usize.ZERO
    while at < listed.length {
      let instruction = listed[at]
      if observable(&function.*, instruction) {
        List<bool>.set(&mut kept, instruction, true)
        run markOperands(&function.*, instruction, &mut live, &mut work)
      }
      at = at + usize.ONE
    }
    run mark(&mut live, &mut work, function.block(block).value)
    block = block + usize.ONE
  }
  while let Option<u64>.Some {value} = List<u64>.pop(&mut work) {
    let defined = function.value(value)
    if defined.definition == Definition.Result {
      let instruction = defined.owner
      if !List<bool>.get(&kept, instruction) {
        List<bool>.set(&mut kept, instruction, true)
        run markOperands(&function.*, instruction, &mut live, &mut work)
      }
    } else if defined.definition == Definition.Parameter {
      let incoming = graph.predecessorsOf(defined.owner)
      let mut at = usize.ZERO
      while at < incoming.length {
        // A predecessor with two edges into the block is listed twice and marks both each time.
        let edges = List<Edge>.asSlice(&function.block(incoming[at]).edges)
        let mut edge = usize.ZERO
        while edge < edges.length {
          if edges[edge].block == defined.owner { run mark(&mut live, &mut work, List<u64>.get(&edges[edge].arguments, defined.index)) }
          edge = edge + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  let mut changed = false
  block = usize.ZERO
  while block < blocks {
    let listed = List<usize>.length(&function.block(block).instructions)
    let mut at = usize.ZERO
    while at < listed {
      let instruction = List<usize>.get(&function.block(block).instructions, at)
      if !List<bool>.get(&kept, instruction) {
        function.remove(instruction)
        changed = true
      }
      at = at + usize.ONE
    }
    let mut position = List<u64>.length(&function.block(block).parameters)
    while position > usize.ZERO {
      position = position - usize.ONE
      let parameter = List<u64>.get(&function.block(block).parameters, position)
      if !List<bool>.get(&live, u64.toUsize(parameter)) {
        function.removeParameter(block, position)
        changed = true
      }
    }
    block = block + usize.ONE
  }
  function.sweep()
  return changed
}

// Whether `instruction` must stay whether or not its results are used.
fn observable(function: &SsaFunction, instruction: usize) -> bool {
  let found = function.instruction(instruction)
  if found.operation.hasSideEffects() { return true }
  if !function.mayTrap(instruction) { return false }
  if let Operation.Load {..} = found.operation { return !inFrame(function, function.operandsOf(instruction)[usize.ZERO]) }
  return true
}

/// Whether `address` is a stack slot's or the frame's address, or a constant offset from one,
/// which an access cannot find out of bounds.
pub fn inFrame(function: &SsaFunction, address: u64) -> bool {
  let mut at = address
  let mut steps = usize.ZERO
  while steps < 64 {
    let producer = function.producerOf(at)
    if producer == usize.MAX { return false }
    match function.instruction(producer).operation {
      Operation.SlotAddress {..} => { return true }
      Operation.FrameAddress => { return true }
      Operation.Offset {..} => { at = function.operandsOf(producer)[usize.ZERO] }
      _ => { return false }
    }
    steps = steps + usize.ONE
  }
  return false
}

effect fn markOperands(function: &SsaFunction, instruction: usize, live: &mut List<bool>, work: &mut List<u64>) -> () ! OutOfMemoryError ? &mut Allocator {
  let operands = function.operandsOf(instruction)
  let mut at = usize.ZERO
  while at < operands.length {
    run mark(&mut live.*, &mut work.*, operands[at])
    at = at + usize.ONE
  }
  return ()
}

effect fn mark(live: &mut List<bool>, work: &mut List<u64>, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  if value == none() || u64.toUsize(value) >= List<bool>.length(&live.*) { return () }
  if List<bool>.get(&live.*, u64.toUsize(value)) { return () }
  List<bool>.set(&mut live.*, u64.toUsize(value), true)
  return run List<u64>.append(&mut work.*, value)
}
