//! Copies an immutable finalized certified executable body under another exact logical key.
//! Only schemas with no logical calls or proof obligations use this transport. It preserves
//! the complete instruction, ABI, extern and source metadata; lowering and coalescing run once.
import CompilerBug
import backend.Mir
import backend.Mir {MirFunction, Local, LocalKind, Block, Statement, Terminator, Rvalue, Operand,
  Place, Projection, Diagnostics, Callee, FailureEdge, SwitchCase, AggregateField, AssemblyFragment,
  Reference, ContextText, TrapSite, NonParkingRun, Cancel, SharedAccess, EscapeSite, Variable}
import backend.InstanceKey {InstanceKey}
import backend.CAbi
import semantic.Type {Type}
import semantic.StaticValue {Value as StaticData}
import semantic.DeclarationId {DeclarationId}
import semantic.TypedBody {Origin}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.interned {Interned}
import silk.mem.box {Box}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.num.usize
import silk.num.u64

/// Copies all finalized generated payload while preserving a caller's distinct logical identity.
pub effect fn copy(source: &MirFunction, key: InstanceKey) -> MirFunction ! OutOfMemoryError ? &mut Allocator {
  if source.observes || source.releasesPackages || List<Reference>.length(&source.references) != usize.ZERO
    || List<ContextText>.length(&source.contexts) != usize.ZERO || List<TrapSite>.length(&source.traps) != usize.ZERO
    || List<NonParkingRun>.length(&source.nonParking) != usize.ZERO || List<Cancel>.length(&source.cancels) != usize.ZERO
    || List<SharedAccess>.length(&source.accesses) != usize.ZERO || List<EscapeSite>.length(&source.escapes) != usize.ZERO {
    return CompilerBug.panic(b"certified executable template contains logical proof obligations")
  }
  if let Option<Origin>.Some {..} = &source.suspension { return CompilerBug.panic(b"certified executable template suspends") }
  if let Option<Origin>.Some {..} = &source.parks { return CompilerBug.panic(b"certified executable template parks") }
  let mut parameters = List<Interned<Type>>.make()
  let params = List<Interned<Type>>.asSlice(&source.parameters)
  let mut at = usize.ZERO
  while at < params.length { run List<Interned<Type>>.append(&mut parameters, Interned<Type>.clone(&params[at])) at = at + usize.ONE }
  let mut locals = List<Local>.make()
  let slots = List<Local>.asSlice(&source.locals)
  at = usize.ZERO
  while at < slots.length {
    let kind = match &slots[at].kind {
      LocalKind.Return => LocalKind.Return
      LocalKind.Parameter {index} => LocalKind.Parameter {index: index}
      LocalKind.Temp => LocalKind.Temp
      LocalKind.Observer => LocalKind.Observer
      LocalKind.Cause => LocalKind.Cause
      LocalKind.Site => LocalKind.Site
      _ => { return CompilerBug.panic(b"certified executable template has noncanonical locals") }
    }
    run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&slots[at].ty), kind: move kind, origin: slots[at].origin})
    at = at + usize.ONE
  }
  let mut blocks = List<Block>.make()
  let originals = List<Block>.asSlice(&source.blocks)
  at = usize.ZERO
  while at < originals.length { run List<Block>.append(&mut blocks, run copyBlock(&originals[at])) at = at + usize.ONE }
  let mut externs = List<Interned<DeclarationId>>.make()
  let external = List<Interned<DeclarationId>>.asSlice(&source.externs)
  at = usize.ZERO
  while at < external.length { run List<Interned<DeclarationId>>.append(&mut externs, Interned<DeclarationId>.clone(&external[at])) at = at + usize.ONE }
  let mut lines = List<u64>.make()
  run List<u64>.appendSlice(&mut lines, List<u64>.asSlice(&source.lines))
  let mut variables = List<Variable>.make()
  let written = List<Variable>.asSlice(&source.variables)
  at = usize.ZERO
  while at < written.length {
    run List<Variable>.append(&mut variables, Variable {local: written[at].local, name: run Bytes.copy(Bytes.asSlice(&written[at].name)),
      place: written[at].place, argument: written[at].argument, view: written[at].view})
    at = at + usize.ONE
  }
  return MirFunction {key: move key, borrow: source.borrow, result: Interned<Type>.clone(&source.result),
    parameters: move parameters, locals: move locals, blocks: move blocks, references: List<Reference>.make(), externs: move externs,
    observes: false, contexts: List<ContextText>.make(), traps: List<TrapSite>.make(), suspension: Option<Origin>.none(),
    parks: Option<Origin>.none(), releasesPackages: false, nonParking: List<NonParkingRun>.make(), cancels: List<Cancel>.make(),
    accesses: List<SharedAccess>.make(), escapes: List<EscapeSite>.make(), features: run Bytes.copy(Bytes.asSlice(&source.features)),
    inlining: source.inlining, optimizeSize: source.optimizeSize, frame: run Bytes.copy(Bytes.asSlice(&source.frame)),
    lines: move lines, variables: move variables}
}

effect fn copyBlock(block: &Block) -> Block ! OutOfMemoryError ? &mut Allocator {
  let mut statements = List<Statement>.make()
  let listed = List<Statement>.asSlice(&block.statements)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<Statement>.append(&mut statements, run copyStatement(&listed[at]))
    at = at + usize.ONE
  }
  return Block {statements: move statements, terminator: run copyTerminator(&block.terminator)}
}

effect fn copyStatement(statement: &Statement) -> Statement ! OutOfMemoryError ? &mut Allocator {
  return match &statement.* {
    Statement.Assign {destination, value, origin} => Statement.Assign {destination: run Mir.copyPlace(&destination), value: run copyRvalue(&value), origin: origin}
    Statement.Drop {destination, glue, diagnostics, origin} => Statement.Drop {destination: run Mir.copyPlace(&destination), glue: InstanceKey.copy(&glue),
      diagnostics: run copyDiagnostics(&diagnostics), origin: origin}
    Statement.FailureContext {destination, source, origin} => Statement.FailureContext {destination: run Mir.copyPlace(&destination), source: run copySource(&source), origin: origin}
    Statement.SetContextHandle {address, value, origin} => Statement.SetContextHandle {address: run copyOperand(&address), value: run copyOperand(&value), origin: origin}
  }
}

effect fn copySource(source: &Option<Place>) -> Option<Place> ! OutOfMemoryError ? &mut Allocator {
  if let Option<Place>.Some {value} = &source.* { return Option<Place>.some(run Mir.copyPlace(&value)) }
  return Option<Place>.none()
}

effect fn copyDiagnostics(diagnostics: &Option<Diagnostics>) -> Option<Diagnostics> ! OutOfMemoryError ? &mut Allocator {
  if let Option<Diagnostics>.Some {value} = &diagnostics.* {
    return Option<Diagnostics>.some(run Diagnostics.make(run copyOperand(Diagnostics.observer(&value)), run copyOperand(Diagnostics.cause(&value)),
      run copyOperand(Diagnostics.site(&value))))
  }
  return Option<Diagnostics>.none()
}

effect fn copyOperand(operand: &Operand) -> Operand ! OutOfMemoryError ? &mut Allocator {
  return match &operand.* {
    Operand.Copy {place} => Operand.Copy {place: run Mir.copyPlace(&place)}
    Operand.Move {place} => Operand.Move {place: run Mir.copyPlace(&place)}
    Operand.Integer {decimal, negative, ty} => Operand.Integer {decimal: run Bytes.copy(Bytes.asSlice(&decimal)), negative: negative, ty: Interned<Type>.clone(&ty)}
    Operand.Float {bits, ty} => Operand.Float {bits: bits, ty: Interned<Type>.clone(&ty)}
    Operand.Boolean {value} => Operand.Boolean {value: value}
    Operand.Unit => Operand.Unit
    Operand.StaticBytes {bytes} => Operand.StaticBytes {bytes: run Bytes.copy(Bytes.asSlice(&bytes))}
    Operand.StaticText {bytes} => Operand.StaticText {bytes: run Bytes.copy(Bytes.asSlice(&bytes))}
    Operand.StaticValue {value, ty} => Operand.StaticValue {value: Interned<StaticData>.clone(&value), ty: Interned<Type>.clone(&ty)}
    Operand.Null {ty} => Operand.Null {ty: Interned<Type>.clone(&ty)}
  }
}

effect fn copyOperands(operands: &List<Operand>) -> List<Operand> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<Operand>.make()
  let listed = List<Operand>.asSlice(&operands.*)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<Operand>.append(&mut copied, run copyOperand(&listed[at]))
    at = at + usize.ONE
  }
  return move copied
}

effect fn copyFields(fields: &List<AggregateField>) -> List<AggregateField> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<AggregateField>.make()
  let listed = List<AggregateField>.asSlice(&fields.*)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<AggregateField>.append(&mut copied, AggregateField {index: listed[at].index, value: run copyOperand(&listed[at].value)})
    at = at + usize.ONE
  }
  return move copied
}

effect fn copyRvalue(value: &Rvalue) -> Rvalue ! OutOfMemoryError ? &mut Allocator {
  return match &value.* {
    Rvalue.Aggregate {fields} => Rvalue.Aggregate {fields: run copyFields(&fields)}
    Rvalue.Slice {data, count} => Rvalue.Slice {data: run copyOperand(&data), count: run copyOperand(&count)}
    Rvalue.SliceLength {place} => Rvalue.SliceLength {place: run Mir.copyPlace(&place)}
    Rvalue.SliceData {place} => Rvalue.SliceData {place: run Mir.copyPlace(&place)}
    Rvalue.PointerOffset {pointer, index, element} => Rvalue.PointerOffset {pointer: run copyOperand(&pointer), index: run copyOperand(&index), element: Interned<Type>.clone(&element)}
    Rvalue.Use {value: used} => Rvalue.Use {value: run copyOperand(&used)}
    Rvalue.Ref {access, place} => Rvalue.Ref {access: access, place: run Mir.copyPlace(&place)}
    Rvalue.AddressOf {access, place} => Rvalue.AddressOf {access: access, place: run Mir.copyPlace(&place)}
    Rvalue.Unary {operation, value: used} => Rvalue.Unary {operation: operation, value: run copyOperand(&used)}
    Rvalue.Binary {operation, left, right} => Rvalue.Binary {operation: operation, left: run copyOperand(&left), right: run copyOperand(&right)}
    Rvalue.ScalarBinary {operation, left, right} => Rvalue.ScalarBinary {operation: operation, left: run copyOperand(&left), right: run copyOperand(&right)}
    Rvalue.ScalarUnary {operation, value: used} => Rvalue.ScalarUnary {operation: operation, value: run copyOperand(&used)}
    Rvalue.Convert {value: used, ty} => Rvalue.Convert {value: run copyOperand(&used), ty: Interned<Type>.clone(&ty)}
    Rvalue.Fits {value: used, ty} => Rvalue.Fits {value: run copyOperand(&used), ty: Interned<Type>.clone(&ty)}
    Rvalue.AddressIntegerConversion {operand, destinationType} => Rvalue.AddressIntegerConversion {operand: run copyOperand(&operand), destinationType: Interned<Type>.clone(&destinationType)}
    Rvalue.Bitcast {value: used, ty} => Rvalue.Bitcast {value: run copyOperand(&used), ty: Interned<Type>.clone(&ty)}
    Rvalue.Discriminant {place} => Rvalue.Discriminant {place: run Mir.copyPlace(&place)}
    Rvalue.Inject {tag, value: used} => Rvalue.Inject {tag: tag, value: run copyOperand(&used)}
    Rvalue.Variant {tag, fields} => Rvalue.Variant {tag: tag, fields: run copyFields(&fields)}
    Rvalue.FunctionAddress {key} => Rvalue.FunctionAddress {key: InstanceKey.copy(&key)}
    Rvalue.ContextOf {place} => Rvalue.ContextOf {place: run Mir.copyPlace(&place)}
    Rvalue.ContextHandle {address} => Rvalue.ContextHandle {address: run copyOperand(&address)}
    Rvalue.ForeignStatic {declaration, address} => Rvalue.ForeignStatic {declaration: Interned<DeclarationId>.clone(&declaration), address: address}
    Rvalue.RunningPackage => Rvalue.RunningPackage
    Rvalue.FrameAddress => Rvalue.FrameAddress
    Rvalue.ProcessWord => Rvalue.ProcessWord
    Rvalue.Wasm {primitive, operands} => Rvalue.Wasm {primitive: primitive, operands: run copyOperands(&operands)}
    Rvalue.Fill {byte} => Rvalue.Fill {byte: byte}
    Rvalue.StackAllocate {count, element} => Rvalue.StackAllocate {count: run copyOperand(&count), element: Interned<Type>.clone(&element)}
    Rvalue.Assembly {fragment} => run copyAssembly(&fragment)
    Rvalue.Atomic {primitive, operands, success, failure, element} => Rvalue.Atomic {primitive: primitive,
      operands: run copyOperands(&operands), success: success, failure: failure, element: Interned<Type>.clone(&element)}
    Rvalue.Vector {primitive, operands, ty} => Rvalue.Vector {primitive: primitive, operands: run copyOperands(&operands),
      ty: Interned<Type>.clone(&ty)}
  }
}

effect fn copyAssembly(fragment: &Box<AssemblyFragment>) -> Rvalue ! OutOfMemoryError ? &mut Allocator {
  let AssemblyFragment {template, constraints, clobbers, memory, sideEffects, noReturn, inputs, ty} =
    &Box<AssemblyFragment>.get(fragment)[0]
  let parts = AssemblyFragment {
    template: run Bytes.copy(Bytes.asSlice(&template)), constraints: run Bytes.copy(Bytes.asSlice(&constraints)),
    clobbers: run Bytes.copy(Bytes.asSlice(&clobbers)), memory: memory, sideEffects: sideEffects, noReturn: noReturn,
    inputs: run copyOperands(&inputs), ty: Interned<Type>.clone(&ty)}
  return Rvalue.Assembly {fragment: run Box<AssemblyFragment>.make(move parts)}
}

effect fn copyTerminator(terminator: &Terminator) -> Terminator ! OutOfMemoryError ? &mut Allocator {
  return match &terminator.* {
    Terminator.Goto {target, origin} => Terminator.Goto {target: target, origin: origin}
    Terminator.Branch {condition, thenBlock, elseBlock, origin} => Terminator.Branch {condition: run copyOperand(&condition), thenBlock: thenBlock, elseBlock: elseBlock, origin: origin}
    Terminator.Return {origin} => Terminator.Return {origin: origin}
    Terminator.Call {callee, arguments, providers, diagnostics, destination, normal, failure, origin} => Terminator.Call {
      callee: run copyCallee(&callee), arguments: run copyOperands(&arguments), providers: run copyOperands(&providers),
      diagnostics: run copyDiagnostics(&diagnostics), destination: run Mir.copyPlace(&destination), normal: normal,
      failure: run copyFailureEdge(&failure), origin: origin}
    Terminator.Fail {origin} => Terminator.Fail {origin: origin}
    Terminator.Trap {reason, origin} => Terminator.Trap {reason: reason, origin: origin}
    Terminator.TrapText {reason, origin} => Terminator.TrapText {reason: run copyOperand(&reason), origin: origin}
    Terminator.Unreachable {origin} => Terminator.Unreachable {origin: origin}
    Terminator.Switch {value, cases, otherwise, origin} => Terminator.Switch {value: run copyOperand(&value), cases: run copyCases(&cases), otherwise: otherwise, origin: origin}
    Terminator.Relinquish {resume, origin} => Terminator.Relinquish {resume: resume, origin: origin}
    Terminator.Abandon {origin} => Terminator.Abandon {origin: origin}
  }
}

effect fn copyCallee(callee: &Callee) -> Callee ! OutOfMemoryError ? &mut Allocator {
  match &callee.* {
    Callee.Instance {key} => { return Callee.Instance {key: InstanceKey.copy(&key)} }
    Callee.Extern {declaration, variadicArguments} => {
      let mut variadic = List<CAbi.VariadicArgument>.make()
      let listed = List<CAbi.VariadicArgument>.asSlice(&variadicArguments)
      let mut at = usize.ZERO
      while at < listed.length {
        run List<CAbi.VariadicArgument>.append(&mut variadic, CAbi.VariadicArgument {sourceType: Interned<Type>.clone(&listed[at].sourceType), promotedType: Interned<Type>.clone(&listed[at].promotedType)})
        at = at + usize.ONE
      }
      return Callee.Extern {declaration: Interned<DeclarationId>.clone(&declaration), variadicArguments: move variadic}
    }
    Callee.Indirect {address} => { return Callee.Indirect {address: run copyOperand(&address)} }
    Callee.NativeIndirect {address, signature} => { return Callee.NativeIndirect {address: run copyOperand(&address), signature: Interned<Type>.clone(&signature)} }
  }
}

effect fn copyFailureEdge(failure: &Option<FailureEdge>) -> Option<FailureEdge> ! OutOfMemoryError ? &mut Allocator {
  if let Option<FailureEdge>.Some {value} = &failure.* {
    return Option<FailureEdge>.some(FailureEdge {destination: run Mir.copyPlace(&value.destination), target: value.target})
  }
  return Option<FailureEdge>.none()
}

effect fn copyCases(cases: &List<SwitchCase>) -> List<SwitchCase> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<SwitchCase>.make()
  let listed = List<SwitchCase>.asSlice(&cases.*)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<SwitchCase>.append(&mut copied, SwitchCase {decimal: run Bytes.copy(Bytes.asSlice(&listed[at].decimal)), negative: listed[at].negative, target: listed[at].target})
    at = at + usize.ONE
  }
  return move copied
}

import backend.Mir {Inlining, VariableView}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.DeclarationId {OwnerStep}
import semantic.SourceLocations {Location}
import semantic.TypedBody {BorrowStatus}
import semantic.Types {Types, TypeTable}
import semantic.RuntimeEncoding
import silk.core.effect {Effect}
import silk.testing.testing {Testing, AssertionError}

effect fn templateCopyClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let sourceDeclaration = run DeclarationId.fromParts(run ModuleId.make(b"memory", b"template", b"first"), List<OwnerStep>.make())
  let aliasDeclaration = run DeclarationId.fromParts(run ModuleId.make(b"memory", b"template", b"second"), List<OwnerStep>.make())
  let first = run InstanceKey.named(&run Types.internDeclaration(move sourceDeclaration))
  let second = run InstanceKey.named(&run Types.internDeclaration(move aliasDeclaration))
  let expected = run InstanceKey.encoding(&second)
  let original = run InstanceKey.encoding(&first)
  let ty = run Types.intern(Type.Primitive {name: run Bytes.copy(b"usize")})
  let origin = Origin {node: 4, location: Location.generated()}
  let mut locals = List<Local>.make()
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&ty), kind: LocalKind.Return, origin: origin})
  let mut statements = List<Statement>.make()
  run List<Statement>.append(&mut statements, Statement.Assign {destination: Place {local: usize.ZERO, projections: List<Projection>.make()},
    value: Rvalue.Use {value: Operand.Integer {decimal: run Bytes.copy(b"42"), negative: false, ty: Interned<Type>.clone(&ty)}}, origin: origin})
  let mut blocks = List<Block>.make()
  run List<Block>.append(&mut blocks, Block {statements: move statements, terminator: Terminator.Return {origin: origin}})
  let mut lines = List<u64>.make()
  run List<u64>.append(&mut lines, 19)
  let mut variables = List<Variable>.make()
  run List<Variable>.append(&mut variables, Variable {local: usize.ZERO, name: run Bytes.copy(b"buffer"),
    place: 19, argument: usize.ONE, view: VariableView.ErasedRawBufferHeader})
  let source = MirFunction {key: move first, borrow: BorrowStatus.Checked, result: Interned<Type>.clone(&ty),
    parameters: List<Interned<Type>>.make(), locals: move locals, blocks: move blocks, references: List<Reference>.make(),
    externs: List<Interned<DeclarationId>>.make(), observes: false, contexts: List<ContextText>.make(), traps: List<TrapSite>.make(),
    suspension: Option<Origin>.none(), parks: Option<Origin>.none(), releasesPackages: false,
    nonParking: List<NonParkingRun>.make(), cancels: List<Cancel>.make(), accesses: List<SharedAccess>.make(), escapes: List<EscapeSite>.make(),
    features: run Bytes.copy(b"+sse2"), inlining: Inlining.Never, optimizeSize: true,
    frame: run Bytes.copy(b"template.frame"), lines: move lines, variables: move variables}
  let mut alias = run copy(&source, move second)
  let actual = run InstanceKey.encoding(&alias.key)
  run Testing.expect(RuntimeEncoding.equals(Bytes.asSlice(&actual), Bytes.asSlice(&expected))
    && !RuntimeEncoding.equals(Bytes.asSlice(&actual), Bytes.asSlice(&original)), "template reuse retains the requesting logical key")
  run Testing.expect(alias.inlining == source.inlining && alias.optimizeSize == source.optimizeSize
    && RuntimeEncoding.equals(Bytes.asSlice(&alias.features), Bytes.asSlice(&source.features))
    && RuntimeEncoding.equals(Bytes.asSlice(&alias.frame), Bytes.asSlice(&source.frame)), "template reuse preserves directives and observer frame")
  let debug = List<Variable>.asSlice(&alias.variables)
  run Testing.expect(debug[0].view == VariableView.ErasedRawBufferHeader && debug[0].place == 19
    && List<u64>.asSlice(&alias.lines)[0] == 19, "template reuse preserves honest debug metadata")
  let changed = List<Block>.asMutSlice(&mut alias.blocks)
  List<Statement>.truncate(&mut changed[0].statements, usize.ZERO)
  run Testing.expect(List<Statement>.length(&List<Block>.asSlice(&source.blocks)[0].statements) == usize.ONE,
    "a logical copy owns its instruction payload independently")
  return ()
}

test effect fn executableTemplateCopiesFinalizedPayloadWithDistinctLogicalIdentity() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run templateCopyClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}
