//! Shares a certified executable body while retaining each instance's exact logical identity.
//! Only schemas without logical calls or proof obligations may use this transport. The caller
//! proves equality of source, target, layout, extern, observer, policy and debug footprints.
import CompilerBug
import backend.Mir {MirDraft, MirInstance, LogicalMir, ExecutableBody, Local, LocalKind, Block,
  Statement, Terminator, Rvalue, Operand, Place, Projection, Reference, ContextText, TrapSite,
  NonParkingRun, Cancel, SharedAccess, EscapeSite, Variable, Inlining, VariableView}
import backend.InstanceKey {InstanceKey}
import semantic.Type {Type}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.TypedBody {Origin, BorrowStatus}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.interned {Interned}
import silk.mem.frozen {Frozen}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.num.usize
import silk.num.u64

/// Retains a certified immutable body under a new exact logical key without copying instructions.
/// The caller authenticates the complete executable footprint before choosing this template.
pub fn instantiate(source: &MirInstance, key: InstanceKey) -> MirInstance {
  let body = Frozen<ExecutableBody>.get(&source.body)
  if source.logical.observes || source.logical.releasesPackages || List<Reference>.length(&source.logical.references) != usize.ZERO
    || List<ContextText>.length(&body.contexts) != usize.ZERO || List<TrapSite>.length(&body.traps) != usize.ZERO
    || List<NonParkingRun>.length(&source.logical.nonParking) != usize.ZERO || List<Cancel>.length(&body.cancels) != usize.ZERO
    || List<SharedAccess>.length(&source.logical.accesses) != usize.ZERO || List<EscapeSite>.length(&source.logical.escapes) != usize.ZERO {
    return CompilerBug.panic(b"certified executable template contains logical proof obligations")
  }
  if let Option<Origin>.Some {..} = &source.logical.suspension { return CompilerBug.panic(b"certified executable template suspends") }
  if let Option<Origin>.Some {..} = &source.logical.parks { return CompilerBug.panic(b"certified executable template parks") }
  let locals = List<Local>.asSlice(&body.locals)
  let mut at = usize.ZERO
  while at < locals.length {
    match &locals[at].kind {
      LocalKind.Return => ()
      LocalKind.Parameter {..} => ()
      LocalKind.Temp => ()
      LocalKind.Observer => ()
      LocalKind.Cause => ()
      LocalKind.Site => ()
      _ => { return CompilerBug.panic(b"certified executable template has noncanonical locals") }
    }
    at = at + usize.ONE
  }
  return MirInstance {
    key: move key,
    logical: LogicalMir {borrow: source.logical.borrow, references: List<Reference>.make(),
      observes: false, suspension: Option<Origin>.none(), parks: Option<Origin>.none(), releasesPackages: false,
      nonParking: List<NonParkingRun>.make(), accesses: List<SharedAccess>.make(), escapes: List<EscapeSite>.make()},
    body: Frozen<ExecutableBody>.clone(&source.body),
  }
}

import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.SourceLocations {Location}
import semantic.Types {Types, TypeTable}
import semantic.RuntimeEncoding
import silk.core.effect {Effect}
import silk.testing.testing {Testing, AssertionError}

effect fn fixtureKey(name: &[u8]) -> InstanceKey
! InvalidModulePath | OutOfMemoryError ? &mut Allocator | &mut Types {
  let declaration = run DeclarationId.fromParts(run ModuleId.make(b"memory", b"template", name), List<OwnerStep>.make())
  return run InstanceKey.named(&run Types.internDeclaration(move declaration))
}

effect fn fixture(key: InstanceKey) -> MirDraft ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let ty = run Types.intern(Type.Primitive {name: run Bytes.copy(b"usize")})
  let origin = Origin {node: 4, location: Location.generated()}
  let mut locals = List<Local>.make()
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&ty), kind: LocalKind.Return, origin: origin})
  let mut statements = List<Statement>.make()
  run List<Statement>.append(&mut statements, Statement.Assign {destination: Place {local: usize.ZERO, projections: List<Projection>.make()},
    value: Rvalue.Use {value: Operand.Integer {decimal: run Bytes.copy(b"42"), negative: false, ty: Interned<Type>.clone(&ty)}}, origin: origin})
  let mut blocks = List<Block>.make()
  run List<Block>.append(&mut blocks, Block {statements: move statements, terminator: Terminator.Return {origin: origin}})
  let mut lines = List<u64>.make()
  run List<u64>.append(&mut lines, 19)
  let mut variables = List<Variable>.make()
  run List<Variable>.append(&mut variables, Variable {local: usize.ZERO, name: run Bytes.copy(b"buffer"),
    place: 19, argument: usize.ONE, view: VariableView.ErasedRawBufferHeader})
  return MirDraft {
    key: move key,
    logical: LogicalMir {
      borrow: BorrowStatus.Checked,
      references: List<Reference>.make(),
      observes: false,
      suspension: Option<Origin>.none(),
      parks: Option<Origin>.none(),
      releasesPackages: false,
      nonParking: List<NonParkingRun>.make(),
      accesses: List<SharedAccess>.make(),
      escapes: List<EscapeSite>.make(),
    },
    body: ExecutableBody {
      result: Interned<Type>.clone(&ty),
      parameters: List<Interned<Type>>.make(),
      locals: move locals,
      blocks: move blocks,
      externs: List<Interned<DeclarationId>>.make(),
      contexts: List<ContextText>.make(),
      traps: List<TrapSite>.make(),
      cancels: List<Cancel>.make(),
      features: run Bytes.copy(b"+sse2"),
      inlining: Inlining.Never,
      optimizeSize: true,
      frame: run Bytes.copy(b"template.frame"),
      lines: move lines,
      variables: move variables,
    },
  }
}

effect fn templateSharingClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let source = run MirDraft.freeze(run fixture(run fixtureKey(b"first")))
  let requested = run fixtureKey(b"second")
  let expected = run InstanceKey.encoding(&requested)
  let original = run InstanceKey.encoding(&source.key)
  let alias = instantiate(&source, move requested)
  let retained = instantiate(&source, run fixtureKey(b"third"))
  let actual = run InstanceKey.encoding(&alias.key)
  run Testing.expect(RuntimeEncoding.equals(Bytes.asSlice(&actual), Bytes.asSlice(&expected))
    && !RuntimeEncoding.equals(Bytes.asSlice(&actual), Bytes.asSlice(&original)),
    "shared executable bodies retain each requesting logical identity")
  run Testing.expect(Frozen<ExecutableBody>.same(&source.body, &alias.body)
    && Frozen<ExecutableBody>.same(&alias.body, &retained.body)
    && Frozen<ExecutableBody>.count(&source.body) == 3,
    "template instantiation retains one allocation without copying any executable payload")
  let view = MirInstance.view(&alias)
  run Testing.expect(view.body.inlining == Inlining.Never && view.body.optimizeSize
    && RuntimeEncoding.equals(Bytes.asSlice(&view.body.features), b"+sse2")
    && RuntimeEncoding.equals(Bytes.asSlice(&view.body.frame), b"template.frame"),
    "shared executable metadata preserves directives and observer frame")
  let debug = List<Variable>.asSlice(&view.body.variables)
  run Testing.expect(debug[0].view == VariableView.ErasedRawBufferHeader && debug[0].place == 19
    && List<u64>.asSlice(&view.body.lines)[0] == 19, "shared bodies preserve honest authored debug metadata")
  drop source
  run Testing.expect(Frozen<ExecutableBody>.count(&alias.body) == 2
    && Frozen<ExecutableBody>.same(&alias.body, &retained.body),
    "dropping the cached template retains both live logical instances")
  drop alias
  run Testing.expect(Frozen<ExecutableBody>.count(&retained.body) == usize.ONE,
    "dropping one logical instance releases only its own body handle")
  let live = MirInstance.view(&retained)
  run Testing.expect(List<Statement>.length(&List<Block>.asSlice(&live.body.blocks)[0].statements) == usize.ONE,
    "instructions remain readable after the template and another instance are gone")
  return ()
}

effect fn uniqueFreezeClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let first = run MirDraft.freeze(run fixture(run fixtureKey(b"ordinary-first")))
  let mut secondDraft = run fixture(run fixtureKey(b"ordinary-second"))
  let blocks = List<Block>.asMutSlice(&mut secondDraft.body.blocks)
  List<Statement>.truncate(&mut blocks[0].statements, usize.ZERO)
  let second = run MirDraft.freeze(move secondDraft)
  run Testing.expect(!Frozen<ExecutableBody>.same(&first.body, &second.body)
    && Frozen<ExecutableBody>.count(&first.body) == usize.ONE && Frozen<ExecutableBody>.count(&second.body) == usize.ONE,
    "ordinary draft freezes publish independent immutable allocations")
  let firstView = MirInstance.view(&first)
  let secondView = MirInstance.view(&second)
  run Testing.expect(List<Statement>.length(&List<Block>.asSlice(&firstView.body.blocks)[0].statements) == usize.ONE
    && List<Statement>.length(&List<Block>.asSlice(&secondView.body.blocks)[0].statements) == usize.ZERO,
    "mutating an owned draft cannot change another finalized body")
  return ()
}

test effect fn executableTemplateSharesBodyAcrossDistinctLogicalInstances() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run templateSharingClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn executableTemplateOrdinaryDraftsFreezeUniqueBodies() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run uniqueFreezeClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}
