//! Collected per-instance linkage identities. Assembly never derives identity from a reached graph.
import backend.Gap {Code, Gap}
import backend.InstanceKey {InstanceKey}
import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId}
import semantic.InternIndex {InternIndex}
import semantic.ModuleId {ModuleId}
import semantic.RuntimeEncoding
import semantic.TypedBody {BorrowStatus, uncheckedReason, uncheckedReasonName}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.text.string {String}
import silk.num.usize
import silk.collections.list {List}

pub struct Resolution {
  /// The reached key; none for an instance a build replayed from its record.
  pub key: Option<InstanceKey>,
  pub identity: usize,
  /// The digest of the key's `InstanceKey.exactIdentity` ([`exactDigest`]), which a key-less
  /// resolution is looked up by.
  exact: Bytes,
  /// The declaration the instance belongs to.
  declaration: DeclarationId,
  /// The instance family a symbol map line reports.
  family: &'static [u8],
}

/// What a plan keeps of an instance a build replayed without its key.
pub struct Replayed {
  /// The key's [`exactDigest`].
  pub exact: Bytes,
  /// The key's `InstanceKey.runtimeHash`.
  pub hash: u64,
  pub declaration: DeclarationId,
  /// The key's `EmissionPlan.familyName`.
  pub family: u64,
}

pub struct Identity {
  pub encoding: Bytes,
  pub symbol: Bytes,
  pub representative: usize,
  /// The first unchecked status among the instances sharing this identity, or `Checked`.
  pub borrow: BorrowStatus,
}

/// A checked root-package body borrow checking left unchecked that no reached instance emits.
pub struct Unemitted {
  pub identity: DeclarationId,
  pub borrow: BorrowStatus,
}

pub struct EmissionPlan {
  pub resolutions: List<Resolution>,
  pub identities: List<Identity>,
  pub unemitted: List<Unemitted>,
  // Resolutions by their key's runtime family and by their key's declaration, and identities by
  // encoding and by symbol.
  resolutionLookup: InternIndex,
  declarationLookup: InternIndex,
  encodingLookup: InternIndex,
  symbolLookup: InternIndex,
}

fn contentHash(content: &[u8]) -> u64 {
  return InternIndex.hashBytes(0, content)
}

impl EmissionPlan {
  /// The number a build record keeps for `key`'s family, as a symbol map line names it.
  pub fn familyName(key: &InstanceKey) -> u64 {
    return match & key.* {
      InstanceKey.Function {..} => 0
      InstanceKey.Export {..} => 1
      InstanceKey.DropGlue {..} => 2
      InstanceKey.Helper {..} => 3
    }
  }
  pub fn empty() -> EmissionPlan {
    return EmissionPlan {
      resolutions: List<Resolution>.make(),
      identities: List<Identity>.make(),
      unemitted: List<Unemitted>.make(),
      resolutionLookup: InternIndex.make(),
      declarationLookup: InternIndex.make(),
      encodingLookup: InternIndex.make(),
      symbolLookup: InternIndex.make(),
    }
  }
  /// Collects immutable identity metadata supplied by a completed instance answer.
  pub effect fn include(
    self: &mut Self,
    key: &InstanceKey,
    encoding: &[u8],
    symbol: &[u8],
    borrow: BorrowStatus,
  ) -> () ! OutOfMemoryError ? &mut Allocator {
    let exact = run exactDigest(key)
    let declaration = DeclarationId.copyShared(&InstanceKey.identity(key))
    return run EmissionPlan.includeResolution(&mut self.*, Option<InstanceKey>.some(InstanceKey.copy(key)), move exact,
      InstanceKey.runtimeHash(key), move declaration, family(key), encoding, symbol, borrow)
  }
  /// Collects a replayed instance's identity metadata, as [`include`] does a reached key's.
  pub effect fn includeReplayed(
    self: &mut Self,
    replayed: &Replayed,
    encoding: &[u8],
    symbol: &[u8],
    borrow: BorrowStatus,
  ) -> () ! OutOfMemoryError ? &mut Allocator {
    return run EmissionPlan.includeResolution(&mut self.*, Option<InstanceKey>.none(), run Bytes.copy(Bytes.asSlice(&replayed.exact)),
      replayed.hash, DeclarationId.copy(&replayed.declaration), familyOf(replayed.family), encoding, symbol, borrow)
  }
  effect fn includeResolution(
    self: &mut Self,
    key: Option<InstanceKey>,
    exact: Bytes,
    hash: u64,
    declaration: DeclarationId,
    named: &'static [u8],
    encoding: &[u8],
    symbol: &[u8],
    borrow: BorrowStatus,
  ) -> () ! OutOfMemoryError ? &mut Allocator {
    let hashed = contentHash(encoding)
    let declared = DeclarationId.hash(&declaration)
    let listed = List<Identity>.asMutSlice(&mut self.identities)
    let mut at = InternIndex.first(&self.encodingLookup, hashed)
    while at != usize.MAX {
      if RuntimeEncoding.equals(Bytes.asSlice(&listed[at].encoding), encoding) {
        if listed[at].borrow == BorrowStatus.Checked {
          listed[at].borrow = borrow
        }
        run List<Resolution>.append(
          &mut self.resolutions,
          Resolution {key: move key, identity: at, exact: move exact, declaration: move declaration, family: named},
        )
        run InternIndex.record(&mut self.resolutionLookup, hash)
        run InternIndex.record(&mut self.declarationLookup, declared)
        return ()
      }
      at = InternIndex.after(&self.encodingLookup, at)
    }
    let identity = List<Identity>.length(&self.identities)
    let representative = List<Resolution>.length(&self.resolutions)
    run List<Identity>.append(
      &mut self.identities,
      Identity {
        encoding: run Bytes.copy(encoding),
        symbol: run Bytes.copy(symbol),
        representative: representative,
        borrow: borrow,
      },
    )
    run InternIndex.record(&mut self.encodingLookup, hashed)
    run InternIndex.record(&mut self.symbolLookup, contentHash(symbol))
    run List<Resolution>.append(
      &mut self.resolutions,
      Resolution {key: move key, identity: identity, exact: move exact, declaration: move declaration, family: named},
    )
    run InternIndex.record(&mut self.resolutionLookup, hash)
    run InternIndex.record(&mut self.declarationLookup, declared)
    return ()
  }

  /// Whether some reached instance of `declaration` is emitted.
  pub fn emitsDeclaration(self: &Self, declaration: &DeclarationId) -> bool {
    let listed = List<Resolution>.asSlice(&self.resolutions)
    let mut at = InternIndex.first(&self.declarationLookup, DeclarationId.hash(declaration))
    while at != usize.MAX {
      if DeclarationId.equals(&listed[at].declaration, declaration) {
        return true
      }
      at = InternIndex.after(&self.declarationLookup, at)
    }
    return false
  }

  /// Records a checked root body borrow checking left unchecked that no reached instance emits.
  pub effect fn recordUnemitted(self: &mut Self, identity: DeclarationId, borrow: BorrowStatus) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    run List<Unemitted>.append(&mut self.unemitted, Unemitted {identity: move identity, borrow: borrow})
  }

  /// Finds an exact semantic application, not a lifetime-erased base or a shortened symbol.
  pub effect fn lookup(self: &Self, key: &InstanceKey) -> Option<usize>
  ! OutOfMemoryError ? &mut Allocator {
    let listed = List<Resolution>.asSlice(&self.resolutions)
    // A replayed resolution has no key and is compared by its exact identity, computed once.
    let mut exact = Option<Bytes>.none()
    let mut at = InternIndex.first(&self.resolutionLookup, InstanceKey.runtimeHash(key))
    while at != usize.MAX {
      let mut found = false
      if let Option<InstanceKey>.Some {value: reached} = &listed[at].key {
        found = run InstanceKey.sameApplication(&reached, key)
      } else {
        if let Option<Bytes>.None = &exact { exact = Option<Bytes>.some(run exactDigest(key)) }
        if let Option<Bytes>.Some {value: probe} = &exact {
          found = RuntimeEncoding.equals(Bytes.asSlice(&listed[at].exact), Bytes.asSlice(&probe))
        }
      }
      if found {
        return Option<usize>.some(listed[at].identity)
      }
      at = InternIndex.after(&self.resolutionLookup, at)
    }
    return Option<usize>.none()
  }

  /// Copies the resolved definition/call/drop name. An incomplete plan never falls back to a
  /// base-family digest; doing so would silently call a different cleanup recipe.
  pub effect fn symbol(self: &Self, key: &InstanceKey) -> Bytes
  ! Gap | OutOfMemoryError ? &mut Allocator {
    let identity = match move run EmissionPlan.lookup(self, key) {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        let owner = InstanceKey.identity(key)
        fail Gap.make(Code.CalleeModule, &owner, Span.make(usize.ZERO, usize.ZERO))
      }
    }
    let listed = List<Identity>.asSlice(&self.identities)
    return run Bytes.copy(Bytes.asSlice(&listed[identity].symbol))
  }

  /// The number of emitted symbols: one per identity.
  pub fn symbolCount(self: &Self) -> usize {
    return List<Identity>.length(&self.identities)
  }

  /// The identity emitted under `symbol`, or `usize.MAX` when no identity has it.
  pub fn identityOfSymbol(self: &Self, symbol: &[u8]) -> usize {
    let listed = List<Identity>.asSlice(&self.identities)
    let mut at = InternIndex.first(&self.symbolLookup, contentHash(symbol))
    while at != usize.MAX {
      if RuntimeEncoding.equals(Bytes.asSlice(&listed[at].symbol), symbol) { return at }
      at = InternIndex.after(&self.symbolLookup, at)
    }
    return usize.MAX
  }

  /// The declaration identity `at`'s representative instance belongs to.
  pub fn identityDeclaration(self: &Self, at: usize) -> &DeclarationId {
    let representative = List<Identity>.asSlice(&self.identities)[at].representative
    return &List<Resolution>.asSlice(&self.resolutions)[representative].declaration
  }

  /// The symbol identity `at` is emitted under.
  pub fn identitySymbol(self: &Self, at: usize) -> &[u8] {
    return Bytes.asSlice(&List<Identity>.asSlice(&self.identities)[at].symbol)
  }

  /// The family of identity `at`'s representative instance: `function`, `export`, `drop` or
  /// `helper`.
  pub fn identityFamily(self: &Self, at: usize) -> &'static [u8] {
    let representative = List<Identity>.asSlice(&self.identities)[at].representative
    return List<Resolution>.asSlice(&self.resolutions)[representative].family
  }

  /// Renders one line per identity, in plan order: its symbol, the family of its representative
  /// instance, and the source declaration that instance belongs to, as
  /// `symbol<TAB>family<TAB>package:path::Owner.name`. An unnamed owner step reads `_`.
  pub effect fn symbolMap(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut output = Bytes.make()
    let listed = List<Identity>.asSlice(&self.identities)
    let resolutions = List<Resolution>.asSlice(&self.resolutions)
    let mut at = usize.ZERO
    while at < listed.length {
      let resolution = &resolutions[listed[at].representative]
      run Bytes.append(&mut output, Bytes.asSlice(&listed[at].symbol))
      run Bytes.append(&mut output, b"\t")
      run Bytes.append(&mut output, resolution.family)
      run Bytes.append(&mut output, b"\t")
      run appendDeclarationName(&mut output, &resolution.declaration)
      run Bytes.append(&mut output, b"\n")
      at = at + usize.ONE
    }
    return move output
  }

  /// One line per emitted definition and unemitted checked root body borrow checking left
  /// unchecked, in byte order so two compilers' lists diff cleanly: the reason, the family, the
  /// authored owner path and the symbol, separated by tabs, since an owner path may contain spaces.
  /// An unemitted body has the family `unemitted` and the symbol `-`.
  pub effect fn uncheckedBodies(self: &Self) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
    let mut lines = List<Bytes>.make()
    let listed = List<Identity>.asSlice(&self.identities)
    let resolutions = List<Resolution>.asSlice(&self.resolutions)
    let mut at = usize.ZERO
    while at < listed.length {
      let reason = uncheckedReason(listed[at].borrow)
      if reason != usize.MAX {
        let resolution = &resolutions[listed[at].representative]
        let mut line = run Bytes.copy(String.utf8Bytes(uncheckedReasonName(reason)))
        run Bytes.append(&mut line, b"\t")
        run Bytes.append(&mut line, resolution.family)
        run Bytes.append(&mut line, b"\t")
        run appendDeclarationName(&mut line, &resolution.declaration)
        run Bytes.append(&mut line, b"\t")
        run Bytes.append(&mut line, Bytes.asSlice(&listed[at].symbol))
        run insertOrdered(&mut lines, move line)
      }
      at = at + usize.ONE
    }
    let unemitted = List<Unemitted>.asSlice(&self.unemitted)
    at = usize.ZERO
    while at < unemitted.length {
      let mut line = run Bytes.copy(String.utf8Bytes(uncheckedReasonName(uncheckedReason(unemitted[at].borrow))))
      run Bytes.append(&mut line, b"\tunemitted\t")
      run appendDeclarationName(&mut line, &unemitted[at].identity)
      run Bytes.append(&mut line, b"\t-")
      run insertOrdered(&mut lines, move line)
      at = at + usize.ONE
    }
    return move lines
  }

  /// Detects distinct canonical identities shortened to the same symbol. The caller reports the
  /// existing instance-symbol-conflict rejection before emitting any definitions or call sites.
  pub fn hasSymbolConflict(self: &Self) -> bool {
    let listed = List<Identity>.asSlice(&self.identities)
    let mut at = usize.ZERO
    while at < listed.length {
      // Only identities whose symbols share a hash can share a symbol.
      let mut prior = InternIndex.first(&self.symbolLookup, contentHash(Bytes.asSlice(&listed[at].symbol)))
      while prior < at {
        if RuntimeEncoding.equals(Bytes.asSlice(&listed[at].symbol), Bytes.asSlice(&listed[prior].symbol))
          && !RuntimeEncoding.equals(Bytes.asSlice(&listed[at].encoding), Bytes.asSlice(&listed[prior].encoding)) {
          return true
        }
        prior = InternIndex.after(&self.symbolLookup, prior)
      }
      at = at + usize.ONE
    }
    return false
  }
}

// The package, module path and owner chain of a declaration. An unnamed owner step reads `_`.
effect fn appendDeclarationName(output: &mut Bytes, declaration: &DeclarationId) -> () ! OutOfMemoryError ? &mut Allocator {
  run ModuleId.appendPackage(DeclarationId.moduleId(declaration), &mut output.*)
  run Bytes.append(&mut output.*, b":")
  run ModuleId.appendPath(DeclarationId.moduleId(declaration), &mut output.*)
  run Bytes.append(&mut output.*, b"::")
  let mut owner = usize.ZERO
  while owner < DeclarationId.ownerCount(declaration) {
    if owner > usize.ZERO {
      run Bytes.append(&mut output.*, b".")
    }
    if DeclarationId.ownerNamed(declaration, owner) {
      let ownerName = run DeclarationId.copyOwnerName(declaration, owner)
      run Bytes.append(&mut output.*, Bytes.asSlice(&ownerName))
    } else {
      run Bytes.append(&mut output.*, b"_")
    }
    owner = owner + usize.ONE
  }
}

// Inserts `line` after every line that is not greater, keeping `lines` in byte order.
effect fn insertOrdered(lines: &mut List<Bytes>, line: Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut tail = List<Bytes>.make()
  while List<Bytes>.length(&lines.*) != usize.ZERO {
    let listed = List<Bytes>.asSlice(&lines.*)
    let last = Bytes.asSlice(&listed[listed.length - usize.ONE])
    if !bytesAfter(last, Bytes.asSlice(&line)) { break }
    if let Option<Bytes>.Some {value} = move List<Bytes>.pop(&mut lines.*) { run List<Bytes>.append(&mut tail, move value) }
  }
  run List<Bytes>.append(&mut lines.*, move line)
  while List<Bytes>.length(&tail) != usize.ZERO {
    if let Option<Bytes>.Some {value} = move List<Bytes>.pop(&mut tail) { run List<Bytes>.append(&mut lines.*, move value) }
  }
}

// Whether `left` sorts strictly after `right`, byte by byte.
fn bytesAfter(left: &[u8], right: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < left.length && at < right.length {
    if left[at] != right[at] { return left[at] > right[at] }
    at = at + usize.ONE
  }
  return left.length > right.length
}

// Names the instance family a symbol map line reports.
fn family(key: &InstanceKey) -> &'static [u8] {
  return familyOf(EmissionPlan.familyName(key))
}

fn familyOf(name: u64) -> &'static [u8] {
  return match name {
    0 => b"function"
    1 => b"export"
    2 => b"drop"
    _ => b"helper"
  }
}

/// The digest a build record names `key` by: the two words of the `ContentHash` of its
/// `InstanceKey.exactIdentity`.
pub effect fn exactDigest(key: &InstanceKey) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let digest = run InstanceKey.identityDigest(key)
  let mut output = Bytes.make()
  run RuntimeEncoding.word(&mut output, digest.high)
  run RuntimeEncoding.word(&mut output, digest.low)
  return move output
}
