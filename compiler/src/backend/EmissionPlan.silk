//! Closed, target-neutral selected-recipe identities for definitions, calls and drops.
//!
//! Exact semantic applications remain distinct inputs. A plan shares code only after minimizing
//! their ordered runtime dependency graph. Root-local quotient encodings do not contain discovery
//! ordinals, unrelated components, source provenance, target layouts or emitted LLVM text.

import backend.Gap {Code, Gap}
import backend.InstanceKey {InstanceKey}
import backend.InstanceRecipe {InstanceRecipe}
import lexer.Span {Span}
import semantic.RuntimeEncoding
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.usize
import silk.vector {Vector}

/// The resolved emitted identity of one exact semantic instance.
pub struct Resolution {
  pub key: InstanceKey
  pub identity: usize
}

/// One interned canonical reachable quotient, with a representative input recipe.
///
/// `representative` is only an input index, never part of the identity. Safety is the conjunction
/// over every exact member, so choosing a checked representative cannot hide an unchecked member.
pub struct Identity {
  pub encoding: Bytes
  pub symbol: Bytes
  pub representative: usize
  pub safetyChecked: bool
}

/// A complete exact-key resolution table and one definition per selected runtime identity.
pub struct EmissionPlan {
  pub resolutions: Vector<Resolution>
  pub identities: Vector<Identity>
}

struct Node {
  successors: Vector<usize>
}

struct Frame {
  node: usize
  next: usize
}

impl Copy for Frame {}

effect fn recipeIndex(recipes: &[InstanceRecipe], key: &InstanceKey) -> Option<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < recipes.length {
    if run InstanceKey.sameApplication(&recipes[at].key, key) {
      return Option.some<usize>(at)
    }
    at = at + usize.ONE
  }
  return Option.none<usize>()
}

effect fn node(recipes: &[InstanceRecipe], recipe: &InstanceRecipe) -> Node
! Gap | OutOfMemoryError ? &mut Allocator {
  let mut successors = Vector.make<usize>()
  let callees = Vector.asSlice<InstanceKey>(&recipe.callees)
  let mut at = usize.ZERO
  while at < callees.length {
    let target = match move run recipeIndex(recipes, &callees[at]) {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        let owner = InstanceKey.identity(&recipe.key)
        fail Gap.make(Code.CalleeModule, &owner, Span.make(usize.ZERO, usize.ZERO))
      }
    }
    run Vector.append<usize>(&mut successors, target)
    at = at + usize.ONE
  }
  return Node {successors: move successors}
}

effect fn validateKeys(recipes: &[InstanceRecipe]) -> ()
! Gap | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < recipes.length {
    let mut prior = usize.ZERO
    while prior < at {
      if run InstanceKey.sameApplication(&recipes[at].key, &recipes[prior].key) {
        // The semantic closure supplies one selected recipe per exact key. Duplicate keys are
        // ambiguous producers, even when their current runtime recipes happen to agree.
        let owner = InstanceKey.identity(&recipes[at].key)
        fail Gap.make(Code.CalleeModule, &owner, Span.make(usize.ZERO, usize.ZERO))
      }
      prior = prior + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn graph(recipes: &[InstanceRecipe]) -> Vector<Node>
! Gap | OutOfMemoryError ? &mut Allocator {
  let mut result = Vector.make<Node>()
  let mut at = usize.ZERO
  while at < recipes.length {
    run Vector.append<Node>(&mut result, run node(recipes, &recipes[at]))
    at = at + usize.ONE
  }
  return move result
}

fn sameShape(recipes: &[InstanceRecipe], left: usize, right: usize) -> bool {
  return RuntimeEncoding.equals(Bytes.asSlice(&recipes[left].shape), Bytes.asSlice(&recipes[right].shape))
}

/// Class numbers are representative input indexes. They are private working data and never encoded.
effect fn initialClasses(recipes: &[InstanceRecipe]) -> Vector<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut result = Vector.make<usize>()
  let mut at = usize.ZERO
  while at < recipes.length {
    let mut representative = at
    let mut prior = usize.ZERO
    while prior < at {
      if sameShape(recipes, at, prior) {
        representative = Vector.get<usize>(&result, prior)
        break
      }
      prior = prior + usize.ONE
    }
    run Vector.append<usize>(&mut result, representative)
    at = at + usize.ONE
  }
  return move result
}

fn sameSuccessors(nodes: &Vector<Node>, classes: &Vector<usize>, left: usize, right: usize) -> bool {
  let listed = Vector.asSlice<Node>(nodes)
  let first = Vector.asSlice<usize>(&listed[left].successors)
  let second = Vector.asSlice<usize>(&listed[right].successors)
  if first.length != second.length {
    return false
  }
  let mut at = usize.ZERO
  while at < first.length {
    if Vector.get<usize>(classes, first[at]) != Vector.get<usize>(classes, second[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn refine(nodes: &Vector<Node>, classes: &Vector<usize>) -> Vector<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut result = Vector.make<usize>()
  let mut at = usize.ZERO
  while at < Vector.length<usize>(classes) {
    let mut representative = at
    let mut prior = usize.ZERO
    while prior < at {
      // Retaining the old class makes the sequence monotone: refinement can only split classes.
      if Vector.get<usize>(classes, at) == Vector.get<usize>(classes, prior)
        && sameSuccessors(nodes, classes, at, prior) {
        representative = Vector.get<usize>(&result, prior)
        break
      }
      prior = prior + usize.ONE
    }
    run Vector.append<usize>(&mut result, representative)
    at = at + usize.ONE
  }
  return move result
}

fn sameClasses(left: &Vector<usize>, right: &Vector<usize>) -> bool {
  let mut at = usize.ZERO
  while at < Vector.length<usize>(left) {
    if Vector.get<usize>(left, at) != Vector.get<usize>(right, at) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn partition(recipes: &[InstanceRecipe], nodes: &Vector<Node>) -> Vector<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut classes = run initialClasses(recipes)
  while true {
    let next = run refine(nodes, &classes)
    if sameClasses(&classes, &next) {
      break
    }
    classes = move next
  }
  return move classes
}

fn ordinal(order: &Vector<usize>, node: usize) -> Option<usize> {
  let mut at = usize.ZERO
  while at < Vector.length<usize>(order) {
    if Vector.get<usize>(order, at) == node {
      return Option.some<usize>(at)
    }
    at = at + usize.ONE
  }
  return Option.none<usize>()
}

fn successorCount(nodes: &Vector<Node>, node: usize) -> usize {
  let listed = Vector.asSlice<Node>(nodes)
  return Vector.length<usize>(&listed[node].successors)
}

fn successor(nodes: &Vector<Node>, node: usize, edge: usize) -> usize {
  let listed = Vector.asSlice<Node>(nodes)
  return Vector.get<usize>(&listed[node].successors, edge)
}

/// Iterative first-visit DFS numbers only the root-reachable minimized quotient. A previously
/// visited class is a backreference, including recursive self/mutual edges and duplicate sites.
effect fn rootOrder(nodes: &Vector<Node>, classes: &Vector<usize>, root: usize) -> Vector<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut order = Vector.make<usize>()
  let mut stack = Vector.make<Frame>()
  run Vector.append<usize>(&mut order, root)
  run Vector.append<Frame>(&mut stack, Frame {node: root, next: usize.ZERO})
  while Vector.length<Frame>(&stack) > usize.ZERO {
    let top = Vector.length<Frame>(&stack) - usize.ONE
    let frame = Vector.get<Frame>(&stack, top)
    if frame.next == successorCount(nodes, frame.node) {
      drop Vector.pop<Frame>(&mut stack)
    } else {
      let target = Vector.get<usize>(classes, successor(nodes, frame.node, frame.next))
      Vector.set<Frame>(&mut stack, top, Frame {node: frame.node, next: frame.next + usize.ONE})
      let visited = match move ordinal(&order, target) {
        Option<usize>.Some {value: _} => true
        Option<usize>.None => false
      }
      if !visited {
        run Vector.append<usize>(&mut order, target)
        run Vector.append<Frame>(&mut stack, Frame {node: target, next: usize.ZERO})
      }
    }
  }
  return move order
}

effect fn encodeNode(output: &mut Bytes, recipes: &[InstanceRecipe], nodes: &Vector<Node>,
  classes: &Vector<usize>, order: &Vector<usize>, node: usize) -> ()
! Gap | OutOfMemoryError ? &mut Allocator {
  run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&recipes[node].shape))
  let count = successorCount(nodes, node)
  run RuntimeEncoding.word(&mut output.*, usize.toU64(count))
  let mut at = usize.ZERO
  while at < count {
    let target = Vector.get<usize>(classes, successor(nodes, node, at))
    let position = match move ordinal(order, target) {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        let owner = InstanceKey.identity(&recipes[node].key)
        fail Gap.make(Code.CalleeModule, &owner, Span.make(usize.ZERO, usize.ZERO))
      }
    }
    run RuntimeEncoding.word(&mut output.*, usize.toU64(position))
    at = at + usize.ONE
  }
  return ()
}

effect fn encoding(recipes: &[InstanceRecipe], nodes: &Vector<Node>, classes: &Vector<usize>, root: usize) -> Bytes
! Gap | OutOfMemoryError ? &mut Allocator {
  let order = run rootOrder(nodes, classes, root)
  let mut result = Bytes.make()
  run RuntimeEncoding.field(&mut result, b"silk-selected-recipe-graph-v1")
  run RuntimeEncoding.word(&mut result, usize.toU64(Vector.length<usize>(&order)))
  let mut at = usize.ZERO
  while at < Vector.length<usize>(&order) {
    run encodeNode(&mut result, recipes, nodes, classes, &order, Vector.get<usize>(&order, at))
    at = at + usize.ONE
  }
  return move result
}

fn interned(identities: &Vector<Identity>, bytes: &Bytes) -> Option<usize> {
  let listed = Vector.asSlice<Identity>(identities)
  let mut at = usize.ZERO
  while at < listed.length {
    if RuntimeEncoding.equals(Bytes.asSlice(&listed[at].encoding), Bytes.asSlice(bytes)) {
      return Option.some<usize>(at)
    }
    at = at + usize.ONE
  }
  return Option.none<usize>()
}

fn includeSafety(identities: &mut Vector<Identity>, identity: usize, checked: bool) -> () {
  let listed = Vector.asMutSlice<Identity>(&mut identities.*)
  listed[identity].safetyChecked = listed[identity].safetyChecked && checked
  return ()
}

effect fn appendResolution(plan: &mut EmissionPlan, recipes: &[InstanceRecipe], nodes: &Vector<Node>,
  classes: &Vector<usize>, at: usize) -> ()
! Gap | OutOfMemoryError ? &mut Allocator {
  let recipe = &recipes[at]
  let representative = Vector.get<usize>(classes, at)
  if representative < at {
    // Representatives are the first input in each class. Every earlier exact input already has
    // one resolution, so equivalent lifetime applications need not re-encode the same quotient.
    let identity = Vector.asSlice<Resolution>(&plan.resolutions)[representative].identity
    includeSafety(&mut plan.identities, identity, recipe.safetyChecked)
    run Vector.append<Resolution>(&mut plan.resolutions, Resolution {
      key: InstanceKey.copy(&recipe.key), identity: identity,
    })
    return ()
  }
  let bytes = run encoding(recipes, nodes, classes, representative)
  let mut identity = usize.ZERO
  match move interned(&plan.identities, &bytes) {
    Option<usize>.Some {value} => {
      includeSafety(&mut plan.identities, value, recipe.safetyChecked)
      identity = value
    }
    Option<usize>.None => {
      let mut name = Bytes.make()
      if InstanceKey.isEntry(&recipe.key) {
        name = run Bytes.copy(b"main")
      } else {
        name = run InstanceKey.contentName(Bytes.asSlice(&bytes))
      }
      let index = Vector.length<Identity>(&plan.identities)
      run Vector.append<Identity>(&mut plan.identities, Identity {encoding: move bytes,
        symbol: move name, representative: at, safetyChecked: recipe.safetyChecked})
      identity = index
    }
  }
  run Vector.append<Resolution>(&mut plan.resolutions, Resolution {
    key: InstanceKey.copy(&recipe.key), identity: identity,
  })
  return ()
}

impl EmissionPlan {
  /// Resolves a closed graph with one selected recipe per exact key. Missing runtime dependencies
  /// and duplicate exact keys are explicit errors; finite admission and semantic validation remain
  /// the caller's prerequisites. Distinct lifetime-bearing keys may share a runtime identity.
  pub effect fn make(recipes: &[InstanceRecipe]) -> EmissionPlan
  ! Gap | OutOfMemoryError ? &mut Allocator {
    run validateKeys(recipes)
    let nodes = run graph(recipes)
    let classes = run partition(recipes, &nodes)
    let mut result = EmissionPlan {resolutions: Vector.make<Resolution>(), identities: Vector.make<Identity>()}
    let mut at = usize.ZERO
    while at < recipes.length {
      run appendResolution(&mut result, recipes, &nodes, &classes, at)
      at = at + usize.ONE
    }
    return move result
  }

  /// Finds an exact semantic application, not a lifetime-erased base or a shortened symbol.
  pub effect fn lookup(self: &Self, key: &InstanceKey) -> Option<usize>
  ! OutOfMemoryError ? &mut Allocator {
    let listed = Vector.asSlice<Resolution>(&self.resolutions)
    let mut at = usize.ZERO
    while at < listed.length {
      if run InstanceKey.sameApplication(&listed[at].key, key) {
        return Option.some<usize>(listed[at].identity)
      }
      at = at + usize.ONE
    }
    return Option.none<usize>()
  }

  /// Copies the resolved definition/call/drop name. An incomplete plan never falls back to a
  /// base-family digest; doing so would silently call a different cleanup recipe.
  pub effect fn symbol(self: &Self, key: &InstanceKey) -> Bytes
  ! Gap | OutOfMemoryError ? &mut Allocator {
    let identity = match move run EmissionPlan.lookup(self, key) {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        let owner = InstanceKey.identity(key)
        fail Gap.make(Code.CalleeModule, &owner, Span.make(usize.ZERO, usize.ZERO))
      }
    }
    let listed = Vector.asSlice<Identity>(&self.identities)
    return run Bytes.copy(Bytes.asSlice(&listed[identity].symbol))
  }

  /// Detects distinct canonical identities shortened to the same symbol. The caller reports the
  /// existing instance-symbol-conflict rejection before emitting any definitions or call sites.
  pub fn hasSymbolConflict(self: &Self) -> bool {
    let listed = Vector.asSlice<Identity>(&self.identities)
    let mut at = usize.ZERO
    while at < listed.length {
      let mut prior = usize.ZERO
      while prior < at {
        if RuntimeEncoding.equals(Bytes.asSlice(&listed[at].symbol), Bytes.asSlice(&listed[prior].symbol))
          && !RuntimeEncoding.equals(Bytes.asSlice(&listed[at].encoding), Bytes.asSlice(&listed[prior].encoding)) {
          return true
        }
        prior = prior + usize.ONE
      }
      at = at + usize.ONE
    }
    return false
  }
}
