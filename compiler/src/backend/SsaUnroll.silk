//! Unrolling of the loops of one SSA function that run a small, known number of times.
//!
//! # When to use
//! Run [`unroll`] in a build optimized for speed after the scalar passes, which make a loop's
//! bounds constants, then run them again: each copy of the body then has a constant for the
//! counter, so its bounds checks and index arithmetic fold. A build optimized for size skips it.
//!
//! # Details
//! A loop is unrolled when all of this holds:
//!
//! - It is a natural loop with one block outside it that enters its header and one block inside
//!   it, not the header, that goes back to the header.
//! - The header ends in a branch on an integer comparison of one of its parameters, the counter,
//!   with a constant; one edge of the branch stays in the loop and the other leaves it.
//! - The entry passes a constant for the counter, and the back edge passes the counter plus or
//!   minus a constant.
//! - Counting from the entry's constant, the comparison lets the body run between one and
//!   [`trips`] times. The total number of blocks and instructions across those copies is at most
//!   [`growth`].
//! - No value the loop defines is used outside it other than as an argument of an edge that
//!   leaves it, or, for a value the header defines, in blocks only the header's leaving edge
//!   leads to, where the last copy of the header stands for it.
//!
//! The loop's blocks are copied once per iteration. A copy of the header takes no parameters:
//! the first reads what the entry passed, each later one what the copy before passed along its
//! back edge, and each jumps straight to its body, since the comparison is known to hold. After
//! the last copy a copy of the header alone runs and jumps along the leaving edge, since the
//! comparison is known to fail. Every other edge that leaves the loop is copied with its
//! arguments. The original blocks are then unreachable, and `SsaFunction.compact` removes them.
//!
//! The header's instructions run once more than the body's, as they did, and every instruction of
//! every iteration runs in the order it did. Blocks are only added after the others, in the
//! loop's own order, so the result depends only on the function.

import backend.SsaFunction {Binary, Edge, Exit, Operation, Predicate, SsaFunction, masked, none}
import backend.SsaGraph {SsaGraph}
import backend.SsaInduction
import backend.SsaInduction {Counter}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.u64
import silk.num.usize

/// The most iterations an unrolled loop runs.
pub fn trips() -> u64 { return 16 }

/// The most blocks and instructions the copies of one loop body may contain in total.
pub fn growth() -> usize { return 2048 }

/// The most loops a speed build unrolls in one function.
pub fn loops() -> usize { return 16 }

/// Unrolls up to `budget` loops of `function` with small constant trip counts and returns how many it unrolled.
pub effect fn unroll(function: &mut SsaFunction, budget: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  let mut done = usize.ZERO
  while done < budget {
    // A copy changes the blocks, so the loops are found again after each.
    let graph = run SsaGraph.of(&function.*)
    let sequence = graph.reversePostorder()
    let mut unrolled = false
    let mut unrolledOuter = false
    let mut step = sequence.length
    while step > usize.ZERO && !unrolled {
      step = step - usize.ONE
      unrolled = run unrollLoop(&mut function.*, &graph, sequence[step], &mut unrolledOuter)
    }
    if !unrolled { break }
    drop run function.compact()
    done = done + usize.ONE
    if unrolledOuter { break }
  }
  return done
}

// The value `value` stands for in a copy: its entry in `map`, or itself when it has none.
fn mapped(map: &List<u64>, value: u64) -> u64 {
  if value == none() { return value }
  let at = u64.toUsize(value)
  if at < List<u64>.length(map) && List<u64>.get(map, at) != none() { return List<u64>.get(map, at) }
  return value
}

// `bits`-wide `value` as a signed number in 64 bits.
fn signed(value: u64, bits: usize) -> u64 {
  if bits >= 64 { return value }
  let shift = usize.toU64(64 - bits)
  let low = masked(value, bits)
  if (u64.shiftLeft(low, shift) & 9223372036854775808) != 0 { return low | u64.shiftLeft(u64.MAX, usize.toU64(bits)) }
  return low
}

// Whether the signed 64-bit `left` is below `right`.
fn below(left: u64, right: u64) -> bool {
  let flipped: u64 = 9223372036854775808
  return u64.bitXor(left, flipped) < u64.bitXor(right, flipped)
}

// Whether `left predicate right` holds for `bits`-wide integers; `usize.MAX` for a predicate
// that is not an integer one, 1 when it holds, else 0.
fn holds(predicate: Predicate, left: u64, right: u64, bits: usize) -> usize {
  let a = masked(left, bits)
  let b = masked(right, bits)
  let x = signed(left, bits)
  let y = signed(right, bits)
  let truth = match predicate {
    Predicate.Eq => a == b
    Predicate.Ne => a != b
    Predicate.Ult => a < b
    Predicate.Ule => a <= b
    Predicate.Ugt => a > b
    Predicate.Uge => a >= b
    Predicate.Slt => below(x, y)
    Predicate.Sle => !below(y, x)
    Predicate.Sgt => below(y, x)
    Predicate.Sge => !below(x, y)
    _ => { return usize.MAX }
  }
  if truth { return usize.ONE }
  return usize.ZERO
}

// Unrolls the loop whose header is `header`, when it is one and fits the module's conditions;
// answers whether it did.
effect fn unrollLoop(function: &mut SsaFunction, graph: &SsaGraph, header: usize, unrolledOuter: &mut bool) -> bool ! OutOfMemoryError ? &mut Allocator {
  // The entry and the back edge's source.
  let incoming = graph.predecessorsOf(header)
  let mut entry = usize.MAX
  let mut latch = usize.MAX
  let mut at = usize.ZERO
  while at < incoming.length {
    if graph.dominates(header, incoming[at]) {
      if latch != usize.MAX { return false }
      latch = incoming[at]
    } else {
      if entry != usize.MAX { return false }
      entry = incoming[at]
    }
    at = at + usize.ONE
  }
  // A loop of one block has no body apart from its header.
  if latch == usize.MAX || entry == usize.MAX || latch == header { return false }
  // The loop's blocks, by a walk back from the back edge's source.
  let count = function.blockCount()
  let mut inLoop = run List<bool>.makeWithCapacity(count)
  run List<bool>.appendRepeated(&mut inLoop, false, count)
  List<bool>.set(&mut inLoop, header, true)
  let mut stack = List<usize>.make()
  List<bool>.set(&mut inLoop, latch, true)
  run List<usize>.append(&mut stack, latch)
  while let Option<usize>.Some {value: block} = List<usize>.pop(&mut stack) {
    let before = graph.predecessorsOf(block)
    let mut edge = usize.ZERO
    while edge < before.length {
      if !List<bool>.get(&inLoop, before[edge]) && graph.reaches(before[edge]) {
        List<bool>.set(&mut inLoop, before[edge], true)
        run List<usize>.append(&mut stack, before[edge])
      }
      edge = edge + usize.ONE
    }
  }
  let mut body = List<usize>.make()
  let sequence = graph.reversePostorder()
  let mut size = usize.ZERO
  at = usize.ZERO
  while at < sequence.length {
    if List<bool>.get(&inLoop, sequence[at]) {
      run List<usize>.append(&mut body, sequence[at])
      size = size + usize.ONE + List<usize>.length(&function.block(sequence[at]).instructions)
    }
    at = at + usize.ONE
  }
  let blocks = List<usize>.asSlice(&body)
  let mut hasInnerLoop = false
  at = usize.ZERO
  while at < blocks.length && !hasInnerLoop {
    let bEdges = List<Edge>.asSlice(&function.block(blocks[at]).edges)
    let mut e = usize.ZERO
    while e < bEdges.length {
      let tgt = bEdges[e].block
      if tgt != header && List<bool>.get(&inLoop, tgt) && graph.dominates(tgt, blocks[at]) {
        hasInnerLoop = true
      }
      e = e + usize.ONE
    }
    at = at + usize.ONE
  }
  // The header's branch: a comparison of the counter with a constant, one edge staying.
  let head = function.block(header)
  if head.exit != Exit.Branch { return false }
  let headEdges = List<Edge>.asSlice(&head.edges)
  let firstStays = List<bool>.get(&inLoop, headEdges[usize.ZERO].block)
  let secondStays = List<bool>.get(&inLoop, headEdges[usize.ONE].block)
  if firstStays == secondStays { return false }
  let mut staying = usize.ONE
  if firstStays { staying = usize.ZERO }
  let leaving = usize.ONE - staying
  let producer = function.producerOf(head.value)
  if producer == usize.MAX { return false }
  let predicate = match function.instruction(producer).operation {
    Operation.Compare {predicate: found} => found
    _ => { return false }
  }
  let compared = function.operandsOf(producer)
  let parameters = List<u64>.asSlice(&head.parameters)
  let mut counter = usize.MAX
  let mut counterLeft = true
  at = usize.ZERO
  while at < parameters.length {
    if parameters[at] == compared[usize.ZERO] && function.isBits(compared[usize.ONE]) { counter = at }
    if parameters[at] == compared[usize.ONE] && function.isBits(compared[usize.ZERO]) {
      counter = at
      counterLeft = false
    }
    at = at + usize.ONE
  }
  if counter == usize.MAX { return false }
  let kind = function.kindOf(parameters[counter])
  if !kind.isInteger() || kind.isVector() || kind.bits > 64 { return false }
  let mut bound = compared[usize.ONE]
  if !counterLeft { bound = compared[usize.ZERO] }
  let limit = function.constantOf(bound).low
  // The entry's constant and the back edge's step.
  let entryEdge = function.block(entry).edgeTo(header)
  let latchEdge = function.block(latch).edgeTo(header)
  if entryEdge == usize.MAX || latchEdge == usize.MAX { return false }
  let started = List<u64>.get(&List<Edge>.asSlice(&function.block(entry).edges)[entryEdge].arguments, counter)
  if !function.isBits(started) { return false }
  let stepped = List<u64>.get(&List<Edge>.asSlice(&function.block(latch).edges)[latchEdge].arguments, counter)
  let stepper = function.producerOf(stepped)
  if stepper == usize.MAX { return false }
  let mut adds = true
  match function.instruction(stepper).operation {
    Operation.Binary {operation: Binary.Add} => {}
    Operation.Binary {operation: Binary.Sub} => { adds = false }
    _ => { return false }
  }
  let terms = function.operandsOf(stepper)
  let mut amount: u64 = 0
  if terms[usize.ZERO] == parameters[counter] && function.isBits(terms[usize.ONE]) {
    amount = function.constantOf(terms[usize.ONE]).low
  } else if adds && terms[usize.ONE] == parameters[counter] && function.isBits(terms[usize.ZERO]) {
    amount = function.constantOf(terms[usize.ZERO]).low
  } else {
    return false
  }
  // Each counter at entry to the header, including its final test. Use the same values
  // when cloning so nested bounds and array indices are already constants before promotion.
  let mut value = function.constantOf(started).low
  let mut counters = List<u64>.make()
  while true {
    run List<u64>.append(&mut counters, value)
    let mut truth = holds(predicate, value, limit, kind.bits)
    if !counterLeft { truth = holds(predicate, limit, value, kind.bits) }
    if truth == usize.MAX { return false }
    if (truth == usize.ONE) != (staying == usize.ZERO) { break }
    if usize.toU64(List<u64>.length(&counters)) > trips() { return false }
    if adds { value = masked(u64.wrappingAdd(value, amount), kind.bits) } else { value = masked(u64.wrappingSubtract(value, amount), kind.bits) }
  }
  let runs = List<u64>.length(&counters) - usize.ONE
  let maxGrowth = if hasInnerLoop { 1280 } else { growth() }
  if runs == 0 || size > maxGrowth / runs { return false }
  // Nothing outside the loop reads a value the loop defines, except through an edge that leaves
  // it, a value of the header where only the header's leaving edge leads, or inside a dedicated
  // loop exit block (all predecessors inside the loop) which we promote to block parameters.
  let values = function.valueCount()
  let mut defined = run List<bool>.makeWithCapacity(values)
  run List<bool>.appendRepeated(&mut defined, false, values)
  let mut inHeader = run List<bool>.makeWithCapacity(values)
  run List<bool>.appendRepeated(&mut inHeader, false, values)
  let after = headEdges[leaving].block
  let onlyFromHeader = graph.predecessorsOf(after).length == usize.ONE
  let mut substituted = false
  let mut promoteBlocks = List<usize>.make()
  let mut promoteValues = List<u64>.make()
  at = usize.ZERO
  while at < blocks.length {
    let found = function.block(blocks[at])
    let taken = List<u64>.asSlice(&found.parameters)
    let mut each = usize.ZERO
    while each < taken.length {
      List<bool>.set(&mut defined, u64.toUsize(taken[each]), true)
      if blocks[at] == header { List<bool>.set(&mut inHeader, u64.toUsize(taken[each]), true) }
      each = each + usize.ONE
    }
    let listed = List<usize>.asSlice(&found.instructions)
    each = usize.ZERO
    while each < listed.length {
      let made = function.instruction(listed[each])
      if made.result != none() {
        let rc = made.resultCount()
        let mut rIdx = usize.ZERO
        while rIdx < rc {
          let rv = u64.toUsize(made.result) + rIdx
          List<bool>.set(&mut defined, rv, true)
          if blocks[at] == header { List<bool>.set(&mut inHeader, rv, true) }
          rIdx = rIdx + usize.ONE
        }
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < count {
    if !List<bool>.get(&inLoop, at) && graph.reaches(at) {
      let found = function.block(at)
      // Where the last copy of the header can stand for the header's values.
      let behind = onlyFromHeader && graph.dominates(after, at)
      let preds = graph.predecessorsOf(at)
      let mut dedicatedExit = preds.length > usize.ZERO
      let mut pIdx = usize.ZERO
      while pIdx < preds.length && dedicatedExit {
        if !List<bool>.get(&inLoop, preds[pIdx]) { dedicatedExit = false }
        pIdx = pIdx + usize.ONE
      }
      if found.value != none() && List<bool>.get(&defined, u64.toUsize(found.value)) {
        if behind && List<bool>.get(&inHeader, u64.toUsize(found.value)) {
          substituted = true
        } else if dedicatedExit {
          run recordPromote(&mut promoteBlocks, &mut promoteValues, at, found.value)
        } else {
          return false
        }
      }
      if found.secondValue != none() && List<bool>.get(&defined, u64.toUsize(found.secondValue)) {
        if behind && List<bool>.get(&inHeader, u64.toUsize(found.secondValue)) {
          substituted = true
        } else if dedicatedExit {
          run recordPromote(&mut promoteBlocks, &mut promoteValues, at, found.secondValue)
        } else {
          return false
        }
      }
      if found.thirdValue != none() && List<bool>.get(&defined, u64.toUsize(found.thirdValue)) {
        if behind && List<bool>.get(&inHeader, u64.toUsize(found.thirdValue)) {
          substituted = true
        } else if dedicatedExit {
          run recordPromote(&mut promoteBlocks, &mut promoteValues, at, found.thirdValue)
        } else {
          return false
        }
      }
      if found.fourthValue != none() && List<bool>.get(&defined, u64.toUsize(found.fourthValue)) {
        if behind && List<bool>.get(&inHeader, u64.toUsize(found.fourthValue)) {
          substituted = true
        } else if dedicatedExit {
          run recordPromote(&mut promoteBlocks, &mut promoteValues, at, found.fourthValue)
        } else {
          return false
        }
      }
      let listed = List<usize>.asSlice(&found.instructions)
      let mut each = usize.ZERO
      while each < listed.length {
        let used = function.operandsOf(listed[each])
        let mut operand = usize.ZERO
        while operand < used.length {
          if used[operand] != none() && List<bool>.get(&defined, u64.toUsize(used[operand])) {
            if behind && List<bool>.get(&inHeader, u64.toUsize(used[operand])) {
              substituted = true
            } else if dedicatedExit {
              run recordPromote(&mut promoteBlocks, &mut promoteValues, at, used[operand])
            } else {
              return false
            }
          }
          operand = operand + usize.ONE
        }
        each = each + usize.ONE
      }
      let edges = List<Edge>.asSlice(&found.edges)
      each = usize.ZERO
      while each < edges.length {
        let passed = List<u64>.asSlice(&edges[each].arguments)
        let mut argument = usize.ZERO
        while argument < passed.length {
          if passed[argument] != none() && List<bool>.get(&defined, u64.toUsize(passed[argument])) {
            if behind && List<bool>.get(&inHeader, u64.toUsize(passed[argument])) {
              substituted = true
            } else if dedicatedExit {
              run recordPromote(&mut promoteBlocks, &mut promoteValues, at, passed[argument])
            } else {
              return false
            }
          }
          argument = argument + usize.ONE
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  // Promote dedicated-exit uses into block parameters before cloning the loop.
  let mut p = usize.ZERO
  let pCount = List<usize>.length(&promoteBlocks)
  while p < pCount {
    let exBlk = List<usize>.get(&promoteBlocks, p)
    let val = List<u64>.get(&promoteValues, p)
    let vKind = function.kindOf(val)
    let promoted = run function.addParameter(exBlk, vKind)
    let preds = graph.predecessorsOf(exBlk)
    let mut pr = usize.ZERO
    while pr < preds.length {
      let pred = preds[pr]
      let pEdgeCount = List<Edge>.length(&function.block(pred).edges)
      let mut pe = usize.ZERO
      while pe < pEdgeCount {
        if List<Edge>.asSlice(&function.block(pred).edges)[pe].block == exBlk {
          run function.appendArgument(pred, pe, val)
        }
        pe = pe + usize.ONE
      }
      pr = pr + usize.ONE
    }
    if function.block(exBlk).value == val { function.setExitValue(exBlk, promoted) }
    if function.block(exBlk).secondValue == val { function.setExitSecondValue(exBlk, promoted) }
    if function.block(exBlk).thirdValue == val { function.setExitThirdValue(exBlk, promoted) }
    if function.block(exBlk).fourthValue == val { function.setExitFourthValue(exBlk, promoted) }
    let instCount = List<usize>.length(&function.block(exBlk).instructions)
    let mut ii = usize.ZERO
    while ii < instCount {
      let instId = List<usize>.get(&function.block(exBlk).instructions, ii)
      let opCount = function.operandsOf(instId).length
      let mut oi = usize.ZERO
      while oi < opCount {
        if function.operandsOf(instId)[oi] == val { function.setOperand(instId, oi, promoted) }
        oi = oi + usize.ONE
      }
      ii = ii + usize.ONE
    }
    let eCount = List<Edge>.length(&function.block(exBlk).edges)
    let mut ei = usize.ZERO
    while ei < eCount {
      let aCount = List<u64>.length(&List<Edge>.asSlice(&function.block(exBlk).edges)[ei].arguments)
      let mut ai = usize.ZERO
      while ai < aCount {
        if List<u64>.get(&List<Edge>.asSlice(&function.block(exBlk).edges)[ei].arguments, ai) == val {
          function.setArgument(exBlk, ei, ai, promoted)
        }
        ai = ai + usize.ONE
      }
      ei = ei + usize.ONE
    }
    p = p + usize.ONE
  }
  // The copies. `carried` holds what the header's parameters are in the copy being made.
  let mut carried = List<u64>.make()
  run List<u64>.appendSlice(&mut carried, List<u64>.asSlice(&List<Edge>.asSlice(&function.block(entry).edges)[entryEdge].arguments))
  let mut previous = usize.MAX
  let mut copy = usize.ZERO
  while copy <= runs {
    let known = run function.constant(kind, List<u64>.get(&counters, copy))
    List<u64>.set(&mut carried, counter, known)
    let last = copy == runs
    let mut map = run List<u64>.makeWithCapacity(values)
    run List<u64>.appendRepeated(&mut map, none(), values)
    let mut clones = run List<usize>.makeWithCapacity(count)
    run List<usize>.appendRepeated(&mut clones, usize.MAX, count)
    // The blocks and their parameters; the header's are what was carried here.
    at = usize.ZERO
    while at < blocks.length {
      if !last || blocks[at] == header {
        let place = function.block(blocks[at]).startPlace
        let made = run function.addJumpBlock(header, &[], place)
        List<usize>.set(&mut clones, blocks[at], made)
        let taken = List<u64>.length(&function.block(blocks[at]).parameters)
        let mut each = usize.ZERO
        while each < taken {
          let parameter = List<u64>.get(&function.block(blocks[at]).parameters, each)
          if blocks[at] == header {
            List<u64>.set(&mut map, u64.toUsize(parameter), List<u64>.get(&carried, each))
          } else {
            let parameterKind = function.kindOf(parameter)
            let fresh = run function.addParameter(made, parameterKind)
            List<u64>.set(&mut map, u64.toUsize(parameter), fresh)
          }
          each = each + usize.ONE
        }
      }
      at = at + usize.ONE
    }
    // The instructions, in an order in which every definition comes before its uses.
    at = usize.ZERO
    while at < blocks.length {
      let made = List<usize>.get(&clones, blocks[at])
      if made != usize.MAX {
        let listed = List<usize>.length(&function.block(blocks[at]).instructions)
        let mut each = usize.ZERO
        while each < listed {
          let number = List<usize>.get(&function.block(blocks[at]).instructions, each)
          run cloneInstruction(&mut function.*, &mut map, number, made, each)
          each = each + usize.ONE
        }
      }
      at = at + usize.ONE
    }
    // The exits. The header's copy jumps to its body, or along the leaving edge after the last
    // iteration; the back edge is taken up by the next copy's header.
    let mut next = List<u64>.make()
    at = usize.ZERO
    while at < blocks.length {
      let made = List<usize>.get(&clones, blocks[at])
      if made != usize.MAX {
        if blocks[at] == header {
          let mut taken = staying
          if last { taken = leaving }
          let onward = &List<Edge>.asSlice(&function.block(header).edges)[taken]
          let mut target = onward.block
          if !last { target = List<usize>.get(&clones, target) }
          let mut arguments = List<u64>.make()
          let passed = List<u64>.length(&onward.arguments)
          let mut each = usize.ZERO
          while each < passed {
            let argument = List<u64>.get(&List<Edge>.asSlice(&function.block(header).edges)[taken].arguments, each)
            run List<u64>.append(&mut arguments, mapped(&map, argument))
            each = each + usize.ONE
          }
          run function.setJump(made, target, List<u64>.asSlice(&arguments))
        } else {
          run function.copyExit(blocks[at], made)
          let exitValue = mapped(&map, function.block(blocks[at]).value)
          function.setExitValue(made, exitValue)
          let exitSecond = mapped(&map, function.block(blocks[at]).secondValue)
          function.setExitSecondValue(made, exitSecond)
          let exitThird = mapped(&map, function.block(blocks[at]).thirdValue)
          function.setExitThirdValue(made, exitThird)
          let exitFourth = mapped(&map, function.block(blocks[at]).fourthValue)
          function.setExitFourthValue(made, exitFourth)
          let edges = List<Edge>.length(&function.block(blocks[at]).edges)
          let mut edge = usize.ZERO
          while edge < edges {
            let target = List<Edge>.asSlice(&function.block(blocks[at]).edges)[edge].block
            let mut arguments = List<u64>.make()
            let passed = List<u64>.length(&List<Edge>.asSlice(&function.block(blocks[at]).edges)[edge].arguments)
            let mut each = usize.ZERO
            while each < passed {
              let argument = List<u64>.get(&List<Edge>.asSlice(&function.block(blocks[at]).edges)[edge].arguments, each)
              run List<u64>.append(&mut arguments, mapped(&map, argument))
              each = each + usize.ONE
            }
            if target == header {
              // The next copy's header takes these as its parameters; the edge is pointed at it
              // once it exists.
              List<u64>.clear(&mut next)
              run List<u64>.appendSlice(&mut next, List<u64>.asSlice(&arguments))
              run function.setEdge(made, edge, header, &[])
            } else if List<bool>.get(&inLoop, target) {
              run function.setEdge(made, edge, List<usize>.get(&clones, target), List<u64>.asSlice(&arguments))
            } else {
              run function.setEdge(made, edge, target, List<u64>.asSlice(&arguments))
            }
            edge = edge + usize.ONE
          }
        }
      }
      at = at + usize.ONE
    }
    // What led to the header now leads to this copy's: the entry, or the copy before's back edge.
    let headerCopy = List<usize>.get(&clones, header)
    if previous == usize.MAX {
      run function.setEdge(entry, entryEdge, headerCopy, &[])
    } else {
      let back = function.block(previous).edgeTo(header)
      run function.setEdge(previous, back, headerCopy, &[])
    }
    // What reads the header's values after the loop reads the last copy's.
    if last && substituted { function.substitute(&mut map) }
    if !last {
      previous = List<usize>.get(&clones, latch)
      List<u64>.clear(&mut carried)
      run List<u64>.appendSlice(&mut carried, List<u64>.asSlice(&next))
    }
    copy = copy + 1
  }
  unrolledOuter.* = hasInnerLoop
  return true
}

effect fn recordPromote(blocks: &mut List<usize>, values: &mut List<u64>, block: usize, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let bs = List<usize>.asSlice(&blocks.*)
  let vs = List<u64>.asSlice(&values.*)
  let mut i = usize.ZERO
  while i < bs.length {
    if bs[i] == block && vs[i] == value { return () }
    i = i + usize.ONE
  }
  run List<usize>.append(&mut blocks.*, block)
  return run List<u64>.append(&mut values.*, value)
}

// Clone one instruction using the SSA values produced by the current copy.
effect fn cloneInstruction(f: &mut SsaFunction, map: &mut List<u64>, id: usize, block: usize, at: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let inst = f.instruction(id)
  let wasPure = inst.pure
  let mut operands = List<u64>.make()
  let used = f.operandsOf(id)
  let mut i = usize.ZERO
  while i < used.length {
    run List<u64>.append(&mut operands, mapped(&map.*, used[i]))
    i = i + usize.ONE
  }
  let result = run f.insertInstructionWithResults(
    block, at, inst.operation, inst.kind, inst.secondKind, inst.thirdKind, inst.fourthKind,
    List<u64>.asSlice(&operands), inst.place,
  )
  if wasPure {
    let madeId = f.instructionCount() - usize.ONE
    f.markPureCall(madeId)
  }
  if inst.result != none() {
    let rc = inst.resultCount()
    let mut rIdx = usize.ZERO
    while rIdx < rc {
      List<u64>.set(&mut map.*, u64.toUsize(inst.result) + rIdx, result + usize.toU64(rIdx))
      rIdx = rIdx + usize.ONE
    }
  }
  return ()
}

/// Executes two successive iterations per branch in short straight-line memory loops
/// with an even trip count. Both iterations retain their original memory order.
pub effect fn pairIterations(f: &mut SsaFunction, graph: &SsaGraph) -> bool ! OutOfMemoryError ? &mut Allocator {
  let order = graph.reversePostorder()
  let mut budget: usize = 128
  let mut b = usize.ZERO
  while b < order.length {
    let header = order[b]
    b = b + usize.ONE
    let head = f.block(header)
    if List<usize>.length(&head.instructions) != usize.ONE { continue }
    let c = match SsaInduction.find(&f.*, graph, header) { Option<Counter>.Some {value} => value _ => { continue } }
    let trips = (f.constantOf(c.limit).low - f.constantOf(c.initial).low) / c.step
    if trips < 2 || trips % 2 != 0 { continue }
    let body = c.latch
    if List<Edge>.asSlice(&head.edges)[c.arm].block != body || f.block(body).exit != Exit.Jump || List<u64>.length(&f.block(body).parameters) != usize.ZERO { continue }
    let list = List<usize>.asSlice(&f.block(body).instructions)
    let size = list.length
    if size > 48 || size > budget { continue }
    let mut memory = false
    let mut i = usize.ZERO
    while i < size {
      let op = f.instruction(list[i]).operation
      match op {
        Operation.Load {..} => { memory = true }
        Operation.Store {..} => { memory = true }
        _ => { if !op.isPure() { break } }
      }
      i = i + usize.ONE
    }
    if i != size || !memory { continue }
    let mut map = List<u64>.make()
    run List<u64>.appendRepeated(&mut map, none(), f.valueCount())
    let params = List<u64>.asSlice(&head.parameters)
    let edge = &List<Edge>.asSlice(&f.block(body).edges)[0]
    let args = List<u64>.asSlice(&edge.arguments)
    let carried = args.length
    i = usize.ZERO
    while i < params.length {
      List<u64>.set(&mut map, u64.toUsize(params[i]), args[i])
      i = i + usize.ONE
    }
    i = usize.ZERO
    while i < size {
      let id = List<usize>.get(&f.block(body).instructions, i)
      if f.instruction(id).result == c.next {
        let kind = f.kindOf(c.value)
        let place = f.instruction(id).place
        let double = run f.integer(kind.bits, c.step * 2)
        let fresh = run f.insertInstruction(body, size + i, Operation.Binary {operation: Binary.Add}, kind, &[c.value, double], place)
        List<u64>.set(&mut map, u64.toUsize(c.next), fresh)
      } else { run cloneInstruction(&mut f.*, &mut map, id, body, size + i) }
      i = i + usize.ONE
    }
    i = usize.ZERO
    while i < carried {
      let incoming = List<u64>.get(&List<Edge>.asSlice(&f.block(body).edges)[0].arguments, i)
      f.setArgument(body, usize.ZERO, i, mapped(&map, incoming))
      i = i + usize.ONE
    }
    budget = budget - size
  }
  return budget < 128
}
