//! Executable identity, separate from exact logical applications and their proof records.
//! A certificate permits erasing only inputs absent from the implementation's footprint.
import semantic.DeclarationId {DeclarationId}
import semantic.RuntimeEncoding
import semantic.Target {Target}
import silk.collections.bytes {Bytes}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.u32
import silk.num.usize

/// A checked implementation schema. Logical function and provider identities are never changed.
pub enum Schema { BufferCount, BufferResize }

/// Canonical bytes naming a source declaration's implementation under its complete footprint.
pub struct ExecutableKey { pub encoding: Bytes }

impl ExecutableKey {
  /// Names one certified implementation, without the erased element's logical type identity.
  /// Resize retains measured layout; Count requires neither element size nor alignment.
  pub effect fn make(declaration: &DeclarationId, schema: Schema, target: Target,
    observing: bool, size: usize, alignment: usize) -> Self
  ! OutOfMemoryError ? &mut Allocator {
    let mut output = Bytes.make()
    run RuntimeEncoding.field(&mut output, b"silk-executable-schema-v1")
    run RuntimeEncoding.declaration(&mut output, declaration)
    run RuntimeEncoding.word(&mut output, match schema { Schema.BufferCount => 0 Schema.BufferResize => 1 })
    run RuntimeEncoding.field(&mut output, Target.name(&target))
    run RuntimeEncoding.word(&mut output, u32.toU64(Target.revision(&target)))
    run RuntimeEncoding.word(&mut output, if observing { 1 } else { 0 })
    if schema == Schema.BufferResize {
      run RuntimeEncoding.word(&mut output, usize.toU64(size))
      run RuntimeEncoding.word(&mut output, usize.toU64(alignment))
    }
    return Self {encoding: move output}
  }
}

import semantic.DeclarationId {OwnerStep}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.Target {Id as TargetId}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.testing.testing {Testing, AssertionError}

fn sameEncoding(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length { if left[at] != right[at] { return false } at = at + usize.ONE }
  return true
}

effect fn executableFootprintClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let declaration = run DeclarationId.fromParts(run ModuleId.make(b"memory", b"executable", b"body"), List<OwnerStep>.make())
  let native = Target.forId(TargetId.X8664UnknownLinuxGnu)
  let plain = run ExecutableKey.make(&declaration, Schema.BufferCount, native, false, usize.ONE, usize.ONE)
  let observed = run ExecutableKey.make(&declaration, Schema.BufferCount, native, true, usize.ONE, usize.ONE)
  let otherElement = run ExecutableKey.make(&declaration, Schema.BufferCount, native, true, 64, 8)
  run Testing.expect(!sameEncoding(Bytes.asSlice(&plain.encoding), Bytes.asSlice(&observed.encoding)),
    "observer ABI lanes are executable identity even for a leaf that emits no events")
  run Testing.expect(sameEncoding(Bytes.asSlice(&observed.encoding), Bytes.asSlice(&otherElement.encoding)),
    "Count never inspects the element size or alignment")
  let wasm = run ExecutableKey.make(&declaration, Schema.BufferCount, Target.forId(TargetId.Wasm32UnknownUnknown), true, usize.ONE, usize.ONE)
  run Testing.expect(!sameEncoding(Bytes.asSlice(&observed.encoding), Bytes.asSlice(&wasm.encoding)),
    "target pointer width and convention remain part of the executable footprint")
  let narrow = run ExecutableKey.make(&declaration, Schema.BufferResize, native, true, usize.ONE, usize.ONE)
  let wide = run ExecutableKey.make(&declaration, Schema.BufferResize, native, true, 64, 8)
  run Testing.expect(!sameEncoding(Bytes.asSlice(&narrow.encoding), Bytes.asSlice(&wide.encoding)),
    "a schema that uses element layout cannot erase that footprint")
  return ()
}

test effect fn executableFootprintsKeepObserverAbiAndRequiredLayout() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run executableFootprintClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
