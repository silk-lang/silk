//! The identities one instance's text references: its own first, then each callee's.
import backend.Gap {Code, Gap}
import backend.InstanceIdentity {InstanceIdentity}
import backend.InstanceKey {InstanceKey}
import lexer.Span {Span}
import semantic.InternIndex {InternIndex}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.usize
import silk.vector {Vector}

/// The identities of one recipe, bucketed by each key's runtime hash.
pub struct InstanceIdentities {
  values: Vector<InstanceIdentity>
  lookup: InternIndex
}

impl InstanceIdentities {
  /// Creates a list that names no instance.
  pub fn make() -> InstanceIdentities {
    return InstanceIdentities {values: Vector.make<InstanceIdentity>(), lookup: InternIndex.make()}
  }
  /// Appends one identity after those already listed.
  pub effect fn append(self: &mut Self, identity: InstanceIdentity) -> () ! OutOfMemoryError ? &mut Allocator {
    let hashed = InstanceKey.runtimeHash(&identity.key)
    run Vector.append<InstanceIdentity>(&mut self.values, move identity)
    run InternIndex.record(&mut self.lookup, hashed)
    return ()
  }
  /// Borrows the identities in the order they were appended.
  pub fn list(self: &Self) -> &[InstanceIdentity] {
    return Vector.asSlice<InstanceIdentity>(&self.values)
  }
  /// The symbol of the first listed identity whose key names the same application as `key`.
  ///
  /// # Details
  ///
  /// Every instruction reference is supplied by the instance preparation query. Keys of one
  /// application share a runtime hash, so only identities recorded under `key`'s hash are compared,
  /// oldest first, and the result is the one a scan of the whole list finds first.
  pub effect fn name(self: &Self, key: &InstanceKey) -> Bytes
  ! Gap | OutOfMemoryError
  ? &mut Allocator {
    let listed = Vector.asSlice<InstanceIdentity>(&self.values)
    let mut at = InternIndex.first(&self.lookup, InstanceKey.runtimeHash(key))
    while at != usize.MAX {
      if run InstanceKey.sameApplication(&listed[at].key, key) {
        return run Bytes.copy(Bytes.asSlice(&listed[at].symbol))
      }
      at = InternIndex.after(&self.lookup, at)
    }
    let owner = InstanceKey.identity(key)
    fail Gap.make(Code.CalleeModule, &owner, Span.make(usize.ZERO, usize.ZERO))
  }
}
