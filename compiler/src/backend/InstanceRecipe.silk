//! Target-neutral instruction content and ordered direct instance references.

import backend.CAbi
import backend.InstanceKey {InstanceKey}
import backend.Mir {AggregateField, Block, Callee, Cancel, ContextText, Diagnostics, FailureEdge, Local, LocalKind, MirFunction, Operand, Place, Projection, Rvalue, ScalarBinary, ScalarUnary, Statement, SwitchCase, Terminator, TrapSite}
import hir.Hir {Access, InfixOperator, PrefixOperator}
import semantic.DeclarationId {DeclarationId}
import semantic.RuntimeEncoding
import semantic.NativeAssembly {Memory as AssemblyMemory}
import semantic.Type {Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// One selected body's own runtime shape and its ordered exact runtime dependencies.
/// Callee positions describe instruction occurrences, not the sorted admission worklist.
pub struct InstanceRecipe {
  pub key: InstanceKey
  pub shape: Bytes
  pub callees: Vector<InstanceKey>
  /// Safety is retained for reporting but does not participate in runtime identity.
  pub safetyChecked: bool
}

effect fn index(output: &mut Bytes, value: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  return run RuntimeEncoding.word(&mut output.*, usize.toU64(value))
}

effect fn boolean(output: &mut Bytes, value: bool) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut encoded: u64 = 0
  if value { encoded = 1 }
  return run RuntimeEncoding.word(&mut output.*, encoded)
}

effect fn runtimeType(output: &mut Bytes, value: &Shared<Type>, owner: &DeclarationId) -> ()
! OutOfMemoryError ? &mut Allocator {
  let encoded = run Type.runtimeEncoding(value, owner)
  return run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&encoded))
}

fn accessCode(value: Access) -> u64 {
  return match value { Access.Shared => 0 Access.Mutable => 1 }
}

fn prefixCode(value: PrefixOperator) -> u64 {
  return match value {
    PrefixOperator.Negate => 0
    PrefixOperator.Not => 1
    PrefixOperator.BitwiseNot => 2
  }
}

fn scalarBinaryCode(value: ScalarBinary) -> u64 {
  return match value {
    ScalarBinary.ShiftLeft => 0
    ScalarBinary.ShiftRight => 1
    ScalarBinary.RotateLeft => 2
    ScalarBinary.RotateRight => 3
    ScalarBinary.WrappingAdd => 4
    ScalarBinary.WrappingSubtract => 5
    ScalarBinary.WrappingMultiply => 6
    ScalarBinary.SaturatingAdd => 7
    ScalarBinary.SaturatingSubtract => 8
    ScalarBinary.SaturatingMultiply => 9
    ScalarBinary.TotalOrder => 10
    ScalarBinary.AddOverflows => 11
    ScalarBinary.SubtractOverflows => 12
    ScalarBinary.MultiplyOverflows => 13
    ScalarBinary.DivisionUndefined => 14
  }
}

fn scalarUnaryCode(value: ScalarUnary) -> u64 {
  return match value {
    ScalarUnary.IsNaN => 0
    ScalarUnary.IsInfinite => 1
    ScalarUnary.IsFinite => 2
    ScalarUnary.IsNormal => 3
    ScalarUnary.IsSubnormal => 4
    ScalarUnary.IsSignNegative => 5
    ScalarUnary.Sqrt => 6
    ScalarUnary.Sin => 7
    ScalarUnary.Cos => 8
  }
}

fn infixCode(value: InfixOperator) -> u64 {
  return match value {
    InfixOperator.Add => 0
    InfixOperator.Subtract => 1
    InfixOperator.Multiply => 2
    InfixOperator.Divide => 3
    InfixOperator.Remainder => 4
    InfixOperator.Equals => 5
    InfixOperator.NotEquals => 6
    InfixOperator.LessThan => 7
    InfixOperator.LessOrEqual => 8
    InfixOperator.GreaterThan => 9
    InfixOperator.GreaterOrEqual => 10
    InfixOperator.And => 11
    InfixOperator.Or => 12
    InfixOperator.BitAnd => 13
    InfixOperator.BitOr => 14
    InfixOperator.BitXor => 15
  }
}

effect fn projection(output: &mut Bytes, value: &Projection, owner: &DeclarationId) -> ()
! OutOfMemoryError ? &mut Allocator {
  match &value.* {
    Projection.Field {index: field} => {
      run RuntimeEncoding.word(&mut output.*, 0)
      run index(&mut output.*, field)
    }
    Projection.Payload {index: member, ty} => {
      run RuntimeEncoding.word(&mut output.*, 1)
      run index(&mut output.*, member)
      run runtimeType(&mut output.*, &ty, owner)
    }
    Projection.VariantField {variant, field} => {
      run RuntimeEncoding.word(&mut output.*, 2)
      run index(&mut output.*, variant)
      run index(&mut output.*, field)
    }
    Projection.Index {local} => {
      run RuntimeEncoding.word(&mut output.*, 3)
      run index(&mut output.*, local)
    }
    Projection.ConstIndex {index: element} => {
      run RuntimeEncoding.word(&mut output.*, 4)
      run index(&mut output.*, element)
    }
    Projection.Deref => { run RuntimeEncoding.word(&mut output.*, 5) }
  }
  return ()
}

effect fn place(output: &mut Bytes, value: &Place, owner: &DeclarationId) -> ()
! OutOfMemoryError ? &mut Allocator {
  run index(&mut output.*, value.local)
  let projections = Vector.asSlice<Projection>(&value.projections)
  run index(&mut output.*, projections.length)
  let mut at = usize.ZERO
  while at < projections.length {
    run projection(&mut output.*, &projections[at], owner)
    at = at + usize.ONE
  }
  return ()
}

effect fn operand(output: &mut Bytes, value: &Operand, owner: &DeclarationId) -> ()
! OutOfMemoryError ? &mut Allocator {
  match &value.* {
    Operand.Copy {place: source} => {
      run RuntimeEncoding.word(&mut output.*, 0)
      run place(&mut output.*, &source, owner)
    }
    Operand.Move {place: source} => {
      run RuntimeEncoding.word(&mut output.*, 1)
      run place(&mut output.*, &source, owner)
    }
    Operand.Integer {decimal, negative, ty} => {
      run RuntimeEncoding.word(&mut output.*, 2)
      run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&decimal))
      run boolean(&mut output.*, negative)
      run runtimeType(&mut output.*, &ty, owner)
    }
    Operand.Float {bits, ty} => {
      run RuntimeEncoding.word(&mut output.*, 3)
      run RuntimeEncoding.word(&mut output.*, bits)
      run runtimeType(&mut output.*, &ty, owner)
    }
    Operand.Boolean {value: literal} => {
      run RuntimeEncoding.word(&mut output.*, 4)
      run boolean(&mut output.*, literal)
    }
    Operand.Unit => { run RuntimeEncoding.word(&mut output.*, 5) }
    Operand.StaticBytes {bytes} => {
      run RuntimeEncoding.word(&mut output.*, 6)
      run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&bytes))
    }
    Operand.Null {ty} => {
      run RuntimeEncoding.word(&mut output.*, 7)
      run runtimeType(&mut output.*, &ty, owner)
    }
  }
  return ()
}

effect fn operands(output: &mut Bytes, values: &Vector<Operand>, owner: &DeclarationId) -> ()
! OutOfMemoryError ? &mut Allocator {
  let listed = Vector.asSlice<Operand>(values)
  run index(&mut output.*, listed.length)
  let mut at = usize.ZERO
  while at < listed.length {
    run operand(&mut output.*, &listed[at], owner)
    at = at + usize.ONE
  }
  return ()
}

effect fn fields(output: &mut Bytes, values: &Vector<AggregateField>, owner: &DeclarationId) -> ()
! OutOfMemoryError ? &mut Allocator {
  let listed = Vector.asSlice<AggregateField>(values)
  run index(&mut output.*, listed.length)
  let mut at = usize.ZERO
  while at < listed.length {
    run index(&mut output.*, listed[at].index)
    run operand(&mut output.*, &listed[at].value, owner)
    at = at + usize.ONE
  }
  return ()
}

effect fn rvalue(output: &mut Bytes, value: &Rvalue, owner: &DeclarationId) -> ()
! OutOfMemoryError ? &mut Allocator {
  match &value.* {
    Rvalue.Aggregate {fields: members} => {
      run RuntimeEncoding.word(&mut output.*, 0)
      run fields(&mut output.*, &members, owner)
    }
    Rvalue.Slice {data, count} => {
      run RuntimeEncoding.word(&mut output.*, 1)
      run operand(&mut output.*, &data, owner)
      run operand(&mut output.*, &count, owner)
    }
    Rvalue.SliceLength {place: source} => {
      run RuntimeEncoding.word(&mut output.*, 2)
      run place(&mut output.*, &source, owner)
    }
    Rvalue.Use {value: source} => {
      run RuntimeEncoding.word(&mut output.*, 3)
      run operand(&mut output.*, &source, owner)
    }
    Rvalue.Ref {access, place: source} => {
      run RuntimeEncoding.word(&mut output.*, 4)
      run RuntimeEncoding.word(&mut output.*, accessCode(access))
      run place(&mut output.*, &source, owner)
    }
    Rvalue.AddressOf {access, place: source} => {
      run RuntimeEncoding.word(&mut output.*, 5)
      run RuntimeEncoding.word(&mut output.*, accessCode(access))
      run place(&mut output.*, &source, owner)
    }
    Rvalue.Unary {operation, value: source} => {
      run RuntimeEncoding.word(&mut output.*, 6)
      run RuntimeEncoding.word(&mut output.*, prefixCode(operation))
      run operand(&mut output.*, &source, owner)
    }
    Rvalue.Binary {operation, left, right} => {
      run RuntimeEncoding.word(&mut output.*, 7)
      run RuntimeEncoding.word(&mut output.*, infixCode(operation))
      run operand(&mut output.*, &left, owner)
      run operand(&mut output.*, &right, owner)
    }
    Rvalue.ScalarBinary {operation, left, right} => {
      run RuntimeEncoding.word(&mut output.*, 18)
      run RuntimeEncoding.word(&mut output.*, scalarBinaryCode(operation))
      run operand(&mut output.*, &left, owner)
      run operand(&mut output.*, &right, owner)
    }
    Rvalue.ScalarUnary {operation, value: source} => {
      run RuntimeEncoding.word(&mut output.*, 19)
      run RuntimeEncoding.word(&mut output.*, scalarUnaryCode(operation))
      run operand(&mut output.*, &source, owner)
    }
    Rvalue.Convert {value: source, ty} => {
      run RuntimeEncoding.word(&mut output.*, 16)
      run operand(&mut output.*, &source, owner)
      run runtimeType(&mut output.*, &ty, owner)
    }
    Rvalue.Fits {value: source, ty} => {
      run RuntimeEncoding.word(&mut output.*, 20)
      run operand(&mut output.*, &source, owner)
      run runtimeType(&mut output.*, &ty, owner)
    }
    Rvalue.AddressIntegerConversion {operand: source, destinationType} => {
      run RuntimeEncoding.word(&mut output.*, 17)
      run operand(&mut output.*, &source, owner)
      run runtimeType(&mut output.*, &destinationType, owner)
    }
    Rvalue.Bitcast {value: source, ty} => {
      run RuntimeEncoding.word(&mut output.*, 8)
      run operand(&mut output.*, &source, owner)
      run runtimeType(&mut output.*, &ty, owner)
    }
    Rvalue.Discriminant {place: source} => {
      run RuntimeEncoding.word(&mut output.*, 9)
      run place(&mut output.*, &source, owner)
    }
    Rvalue.Inject {tag, value: source} => {
      run RuntimeEncoding.word(&mut output.*, 10)
      run index(&mut output.*, tag)
      run operand(&mut output.*, &source, owner)
    }
    Rvalue.Variant {tag, fields: members} => {
      run RuntimeEncoding.word(&mut output.*, 11)
      run index(&mut output.*, tag)
      run fields(&mut output.*, &members, owner)
    }
    Rvalue.SliceData {place: source} => {
      run RuntimeEncoding.word(&mut output.*, 12)
      run place(&mut output.*, &source, owner)
    }
    Rvalue.PointerOffset {pointer, index: offset, element} => {
      run RuntimeEncoding.word(&mut output.*, 13)
      run operand(&mut output.*, &pointer, owner)
      run operand(&mut output.*, &offset, owner)
      run runtimeType(&mut output.*, &element, owner)
    }
    // The function's site is an edge encoded by its statement.
    Rvalue.FunctionAddress {..} => { run RuntimeEncoding.word(&mut output.*, 14) }
    Rvalue.ContextOf {place: source} => {
      run RuntimeEncoding.word(&mut output.*, 15)
      run place(&mut output.*, &source, owner)
    }
    Rvalue.ContextHandle {address} => {
      run RuntimeEncoding.word(&mut output.*, 23)
      run operand(&mut output.*, &address, owner)
    }
    Rvalue.RunningPackage => { run RuntimeEncoding.word(&mut output.*, 22) }
    Rvalue.ForeignStatic {declaration} => {
      run RuntimeEncoding.word(&mut output.*, 18)
      let identity = run DeclarationId.copyShared(&declaration)
      run RuntimeEncoding.declaration(&mut output.*, &identity)
    }
    Rvalue.Assembly {template, constraints, clobbers, memory, sideEffects, noReturn, inputs, ty} => {
      run RuntimeEncoding.word(&mut output.*, 21)
      run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&template))
      run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&constraints))
      run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&clobbers))
      run RuntimeEncoding.word(&mut output.*, assemblyMemoryCode(memory))
      run boolean(&mut output.*, sideEffects)
      run boolean(&mut output.*, noReturn)
      run operands(&mut output.*, &inputs, owner)
      run runtimeType(&mut output.*, &ty, owner)
    }
  }
  return ()
}

fn assemblyMemoryCode(memory: AssemblyMemory) -> u64 {
  return match memory {
    AssemblyMemory.None => 0
    AssemblyMemory.Read => 1
    AssemblyMemory.Write => 2
    AssemblyMemory.ReadWrite => 3
  }
}

effect fn edge(output: &mut Bytes, callees: &mut Vector<InstanceKey>, key: &InstanceKey) -> ()
! OutOfMemoryError ? &mut Allocator {
  // Site ordinals are local to this recipe and retain repeated targets at distinct sites.
  run index(&mut output.*, Vector.length<InstanceKey>(&callees.*))
  return run Vector.append<InstanceKey>(&mut callees.*, InstanceKey.copy(key))
}

effect fn statement(
  output: &mut Bytes,
  callees: &mut Vector<InstanceKey>,
  value: &Statement,
  owner: &DeclarationId,
  contexts: &[ContextText],
) -> () ! OutOfMemoryError ? &mut Allocator {
  match &value.* {
    Statement.Assign {destination, value: source, origin: _} => {
      run RuntimeEncoding.word(&mut output.*, 0)
      run place(&mut output.*, &destination, owner)
      run rvalue(&mut output.*, &source, owner)
      if let Rvalue.FunctionAddress {key} = &source { run edge(&mut output.*, &mut callees.*, &key) }
    }
    Statement.Drop {destination, glue, diagnostics, origin: _} => {
      run RuntimeEncoding.word(&mut output.*, 1)
      run place(&mut output.*, &destination, owner)
      run edge(&mut output.*, &mut callees.*, &glue)
      run hidden(&mut output.*, &diagnostics, owner)
    }
    Statement.FailureContext {destination, source, origin} => {
      run RuntimeEncoding.word(&mut output.*, 2)
      run place(&mut output.*, &destination, owner)
      match &source {
        Option<Place>.Some {value: carried} => {
          run RuntimeEncoding.word(&mut output.*, 1)
          run place(&mut output.*, &carried, owner)
        }
        // Encode the context table ordinal; module-local origins are lookup provenance.
        Option<Place>.None => {
          run RuntimeEncoding.word(&mut output.*, 0)
          let mut selected = usize.MAX
          let mut at = usize.ZERO
          while at < contexts.length {
            if contexts[at].origin.syntax.index == origin.syntax.index && contexts[at].origin.span.start == origin.span.start {
              selected = at
            }
            at = at + usize.ONE
          }
          run index(&mut output.*, selected)
        }
      }
    }
    Statement.SetContextHandle {address, value: handle, origin: _} => {
      run RuntimeEncoding.word(&mut output.*, 3)
      run operand(&mut output.*, &address, owner)
      run operand(&mut output.*, &handle, owner)
    }
  }
  return ()
}

effect fn hidden(output: &mut Bytes, value: &Option<Diagnostics>, owner: &DeclarationId) -> () ! OutOfMemoryError ? &mut Allocator {
  match &value.* {
    Option<Diagnostics>.Some {value: observed} => {
      run RuntimeEncoding.word(&mut output.*, 1)
      run operand(&mut output.*, &observed.observer, owner)
      run operand(&mut output.*, &observed.cause, owner)
    }
    Option<Diagnostics>.None => { run RuntimeEncoding.word(&mut output.*, 0) }
  }
  return ()
}

effect fn callee(output: &mut Bytes, callees: &mut Vector<InstanceKey>, value: &Callee, owner: &DeclarationId) -> ()
! OutOfMemoryError ? &mut Allocator {
  match &value.* {
    Callee.Instance {key} => {
      run RuntimeEncoding.word(&mut output.*, 0)
      run edge(&mut output.*, &mut callees.*, &key)
    }
    Callee.Extern {declaration, variadicArguments} => {
      run RuntimeEncoding.word(&mut output.*, 1)
      let identity = run DeclarationId.copyShared(&declaration)
      run RuntimeEncoding.declaration(&mut output.*, &identity)
      let tails = Vector.asSlice<CAbi.VariadicArgument>(&variadicArguments)
      run index(&mut output.*, tails.length)
      let mut at = usize.ZERO
      while at < tails.length {
        run runtimeType(&mut output.*, &tails[at].sourceType, owner)
        run runtimeType(&mut output.*, &tails[at].promotedType, owner)
        at = at + usize.ONE
      }
    }
    Callee.NativeIndirect {address, signature} => {
      run RuntimeEncoding.word(&mut output.*, 3)
      run operand(&mut output.*, &address, owner)
      run runtimeType(&mut output.*, &signature, owner)
    }
    Callee.Indirect {address} => {
      run RuntimeEncoding.word(&mut output.*, 2)
      run operand(&mut output.*, &address, owner)
    }
  }
  return ()
}

effect fn terminator(output: &mut Bytes, callees: &mut Vector<InstanceKey>, value: &Terminator, owner: &DeclarationId) -> ()
! OutOfMemoryError ? &mut Allocator {
  match &value.* {
    Terminator.Goto {target, origin: _} => {
      run RuntimeEncoding.word(&mut output.*, 0)
      run index(&mut output.*, target)
    }
    Terminator.Branch {condition, thenBlock, elseBlock, origin: _} => {
      run RuntimeEncoding.word(&mut output.*, 1)
      run operand(&mut output.*, &condition, owner)
      run index(&mut output.*, thenBlock)
      run index(&mut output.*, elseBlock)
    }
    Terminator.Return {origin: _} => { run RuntimeEncoding.word(&mut output.*, 2) }
    Terminator.Call {callee: target, arguments, providers, diagnostics, destination, normal, failure, origin: _} => {
      run RuntimeEncoding.word(&mut output.*, 3)
      run callee(&mut output.*, &mut callees.*, &target, owner)
      run operands(&mut output.*, &arguments, owner)
      run operands(&mut output.*, &providers, owner)
      run hidden(&mut output.*, &diagnostics, owner)
      run place(&mut output.*, &destination, owner)
      run index(&mut output.*, normal)
      match &failure {
        Option<FailureEdge>.Some {value: exceptional} => {
          run RuntimeEncoding.word(&mut output.*, 1)
          run place(&mut output.*, &exceptional.destination, owner)
          run index(&mut output.*, exceptional.target)
        }
        Option<FailureEdge>.None => { run RuntimeEncoding.word(&mut output.*, 0) }
      }
    }
    Terminator.Trap {origin: _} => { run RuntimeEncoding.word(&mut output.*, 4) }
    Terminator.Unreachable {origin: _} => { run RuntimeEncoding.word(&mut output.*, 5) }
    Terminator.Fail {origin: _} => { run RuntimeEncoding.word(&mut output.*, 7) }
    Terminator.Relinquish {resume, origin: _} => {
      run RuntimeEncoding.word(&mut output.*, 8)
      run index(&mut output.*, resume)
    }
    Terminator.Abandon {origin: _} => { run RuntimeEncoding.word(&mut output.*, 9) }
    Terminator.Switch {value: source, cases, otherwise, origin: _} => {
      run RuntimeEncoding.word(&mut output.*, 6)
      run operand(&mut output.*, &source, owner)
      let listed = Vector.asSlice<SwitchCase>(&cases)
      run index(&mut output.*, listed.length)
      let mut at = usize.ZERO
      while at < listed.length {
        run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&listed[at].decimal))
        run boolean(&mut output.*, listed[at].negative)
        run index(&mut output.*, listed[at].target)
        at = at + usize.ONE
      }
      run index(&mut output.*, otherwise)
    }
  }
  return ()
}

effect fn block(
  output: &mut Bytes,
  callees: &mut Vector<InstanceKey>,
  value: &Block,
  owner: &DeclarationId,
  contexts: &[ContextText],
) -> () ! OutOfMemoryError ? &mut Allocator {
  let statements = Vector.asSlice<Statement>(&value.statements)
  run index(&mut output.*, statements.length)
  let mut at = usize.ZERO
  while at < statements.length {
    run statement(&mut output.*, &mut callees.*, &statements[at], owner, contexts)
    at = at + usize.ONE
  }
  return run terminator(&mut output.*, &mut callees.*, &value.terminator, owner)
}

effect fn parameters(output: &mut Bytes, function: &MirFunction, owner: &DeclarationId) -> ()
! OutOfMemoryError ? &mut Allocator {
  let listed = Vector.asSlice<Shared<Type>>(&function.parameters)
  run index(&mut output.*, listed.length)
  let mut at = usize.ZERO
  while at < listed.length {
    run runtimeType(&mut output.*, &listed[at], owner)
    at = at + usize.ONE
  }
  return ()
}

effect fn locals(output: &mut Bytes, function: &MirFunction, owner: &DeclarationId) -> ()
! OutOfMemoryError ? &mut Allocator {
  let listed = Vector.asSlice<Local>(&function.locals)
  run index(&mut output.*, listed.length)
  let mut at = usize.ZERO
  while at < listed.length {
    run runtimeType(&mut output.*, &listed[at].ty, owner)
    // The failure out-slot (D3) and provider addresses (D2) change the instance ABI; other kinds
    // are provenance.
    match &listed[at].kind {
      LocalKind.Failure => { run RuntimeEncoding.word(&mut output.*, 1) }
      LocalKind.Provider {index: provider} => {
        run RuntimeEncoding.word(&mut output.*, 2)
        run index(&mut output.*, provider)
      }
      // The diagnostic addresses change the ABI of a program that observes diagnostics (N1, N2).
      LocalKind.Observer => { run RuntimeEncoding.word(&mut output.*, 3) }
      LocalKind.Cause => { run RuntimeEncoding.word(&mut output.*, 4) }
      _ => { run RuntimeEncoding.word(&mut output.*, 0) }
    }
    at = at + usize.ONE
  }
  return ()
}

impl InstanceRecipe {
  /// Encodes every runtime instruction field without layouts, target facts or provenance.
  /// Exact call/drop keys stay separate as direct references in the LLVM content subject.
  pub effect fn make(function: &MirFunction) -> InstanceRecipe
  ! OutOfMemoryError ? &mut Allocator {
    let declaration = InstanceKey.identity(&function.key)
    let owner = run DeclarationId.copyShared(&declaration)
    let base = run InstanceKey.runtimeEncoding(&function.key)
    let mut shape = Bytes.make()
    run RuntimeEncoding.field(&mut shape, b"silk.mir.recipe.v2")
    run RuntimeEncoding.field(&mut shape, Bytes.asSlice(&base))
    run runtimeType(&mut shape, &function.result, &owner)
    run parameters(&mut shape, function, &owner)
    run locals(&mut shape, function, &owner)
    let mut callees = Vector.make<InstanceKey>()
    let blocks = Vector.asSlice<Block>(&function.blocks)
    run index(&mut shape, blocks.length)
    let mut at = usize.ZERO
    while at < blocks.length {
      run block(
        &mut shape,
        &mut callees,
        &blocks[at],
        &owner,
        Vector.asSlice<ContextText>(&function.contexts),
      )
      at = at + usize.ONE
    }
    // Originated failure contexts store these texts (failure observer note N3).
    let contexts = Vector.asSlice<ContextText>(&function.contexts)
    run index(&mut shape, contexts.length)
    at = usize.ZERO
    while at < contexts.length {
      let identities = Vector.asSlice<Bytes>(&contexts[at].identities)
      run index(&mut shape, identities.length)
      let mut identityAt = usize.ZERO
      while identityAt < identities.length {
        run RuntimeEncoding.field(&mut shape, Bytes.asSlice(&identities[identityAt]))
        identityAt = identityAt + usize.ONE
      }
      run RuntimeEncoding.field(&mut shape, Bytes.asSlice(&contexts[at].label))
      at = at + usize.ONE
    }
    // Observed traps report these site labels (event 6, N7).
    let traps = Vector.asSlice<TrapSite>(&function.traps)
    run index(&mut shape, traps.length)
    at = usize.ZERO
    while at < traps.length {
      run RuntimeEncoding.field(&mut shape, Bytes.asSlice(&traps[at].label))
      at = at + usize.ONE
    }
    // A frame variant's suspension points and their cancel exits.
    let cancels = Vector.asSlice<Cancel>(&function.cancels)
    run index(&mut shape, cancels.length)
    at = usize.ZERO
    while at < cancels.length {
      run index(&mut shape, cancels[at].point)
      run index(&mut shape, cancels[at].entry)
      at = at + usize.ONE
    }
    return InstanceRecipe {key: InstanceKey.copy(&function.key), shape: move shape,
      callees: move callees, safetyChecked: function.safetyChecked}
  }
}
