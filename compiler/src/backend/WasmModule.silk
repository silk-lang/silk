//! The WebAssembly binary encoding the direct backend writes: LEB128 numbers, value types, the
//! instructions it uses, and module sections.
//!
//! # Details
//! A writer only appends bytes; nothing here validates what it writes. Engines and
//! `wasm-tools validate` check modules in tests, so the compiler does not re-check its own output.

import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// Value types.
pub fn i32Type() -> u8 { return 0x7F }
pub fn i64Type() -> u8 { return 0x7E }
pub fn f32Type() -> u8 { return 0x7D }
pub fn f64Type() -> u8 { return 0x7C }
pub fn v128Type() -> u8 { return 0x7B }
pub fn funcrefType() -> u8 { return 0x70 }
/// The empty block type.
pub fn emptyBlock() -> u8 { return 0x40 }

/// Section ids.
pub fn typeSection() -> u8 { return 1 }
pub fn importSection() -> u8 { return 2 }
pub fn functionSection() -> u8 { return 3 }
pub fn tableSection() -> u8 { return 4 }
pub fn memorySection() -> u8 { return 5 }
pub fn globalSection() -> u8 { return 6 }
pub fn exportSection() -> u8 { return 7 }
pub fn elementSection() -> u8 { return 9 }
pub fn codeSection() -> u8 { return 10 }
pub fn dataSection() -> u8 { return 11 }
pub fn dataCountSection() -> u8 { return 12 }

/// Appends one byte.
pub effect fn byte(out: &mut Bytes, value: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run Bytes.append(&mut out.*, &[value])
}

/// Appends `value` as an unsigned LEB128 number.
pub effect fn unsigned(out: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut rest = value
  while true {
    let low = u64.wrappingToU8(rest & 127)
    rest = u64.shiftRight(rest, 7)
    if rest == 0 { return run byte(&mut out.*, low) }
    run byte(&mut out.*, low | 128)
  }
}

/// Appends `value` as an unsigned LEB128 number.
pub effect fn index(out: &mut Bytes, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  return run unsigned(&mut out.*, usize.toU64(value))
}

/// Appends the two's complement `value` as a signed LEB128 number.
pub effect fn signed(out: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut rest = value
  while true {
    let low = u64.wrappingToU8(rest & 127)
    let negative = (rest & 9223372036854775808) != 0
    // An arithmetic shift right by seven.
    rest = u64.shiftRight(rest, 7)
    if negative { rest = rest | 18302628885633695744 }
    let sign = (low & 64) != 0
    if rest == 0 && !sign || rest == u64.MAX && sign { return run byte(&mut out.*, low) }
    run byte(&mut out.*, low | 128)
  }
}

/// Appends `value` as a five-byte unsigned LEB128 number, which a later write can patch in place.
pub effect fn padded(out: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut rest = value
  let mut at = usize.ZERO
  while at < 4 {
    run byte(&mut out.*, u64.wrappingToU8(rest & 127) | 128)
    rest = u64.shiftRight(rest, 7)
    at = at + usize.ONE
  }
  return run byte(&mut out.*, u64.wrappingToU8(rest & 127))
}

/// Appends a name: its length, then its bytes.
pub effect fn name(out: &mut Bytes, text: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run index(&mut out.*, text.length)
  return run Bytes.append(&mut out.*, text)
}

/// Appends section `id` holding `contents`.
pub effect fn section(out: &mut Bytes, id: u8, contents: &Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  run byte(&mut out.*, id)
  run index(&mut out.*, Bytes.length(contents))
  return run Bytes.append(&mut out.*, Bytes.asSlice(contents))
}

/// Appends the module header: the magic number and version 1.
pub effect fn header(out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  return run Bytes.append(&mut out.*, &[0, 0x61, 0x73, 0x6D, 1, 0, 0, 0])
}

/// Appends `value` as `size` little-endian bytes.
pub effect fn littleEndian(out: &mut Bytes, value: u64, size: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut rest = value
  let mut at = usize.ZERO
  while at < size {
    run byte(&mut out.*, u64.wrappingToU8(rest & 255))
    rest = u64.shiftRight(rest, 8)
    at = at + usize.ONE
  }
  return ()
}

// Instructions.

/// Appends a one-byte instruction.
pub effect fn op(out: &mut Bytes, code: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run byte(&mut out.*, code)
}

/// Appends a one-byte instruction followed by one unsigned immediate, such as `local.get 3`.
pub effect fn opIndex(out: &mut Bytes, code: u8, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  run byte(&mut out.*, code)
  return run index(&mut out.*, value)
}

/// Appends a prefixed instruction, such as `0xFC 10` for `memory.copy`.
pub effect fn prefixed(out: &mut Bytes, prefix: u8, code: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  run byte(&mut out.*, prefix)
  return run unsigned(&mut out.*, code)
}

pub effect fn localGet(out: &mut Bytes, local: usize) -> () ! OutOfMemoryError ? &mut Allocator { return run opIndex(&mut out.*, 0x20, local) }
pub effect fn localSet(out: &mut Bytes, local: usize) -> () ! OutOfMemoryError ? &mut Allocator { return run opIndex(&mut out.*, 0x21, local) }
pub effect fn localTee(out: &mut Bytes, local: usize) -> () ! OutOfMemoryError ? &mut Allocator { return run opIndex(&mut out.*, 0x22, local) }
pub effect fn globalGet(out: &mut Bytes, global: usize) -> () ! OutOfMemoryError ? &mut Allocator { return run opIndex(&mut out.*, 0x23, global) }
pub effect fn globalSet(out: &mut Bytes, global: usize) -> () ! OutOfMemoryError ? &mut Allocator { return run opIndex(&mut out.*, 0x24, global) }

/// `i32.const value`, `value` taken as 32-bit two's complement.
pub effect fn i32Const(out: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  run byte(&mut out.*, 0x41)
  let mut low = value & 4294967295
  if (low & 2147483648) != 0 { low = low | 18446744069414584320 }
  return run signed(&mut out.*, low)
}

/// `i64.const value`.
pub effect fn i64Const(out: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  run byte(&mut out.*, 0x42)
  return run signed(&mut out.*, value)
}

/// `f32.const` with the single-precision `bits`.
pub effect fn f32Const(out: &mut Bytes, bits: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  run byte(&mut out.*, 0x43)
  return run littleEndian(&mut out.*, bits, 4)
}

/// `f64.const` with the double-precision `bits`.
pub effect fn f64Const(out: &mut Bytes, bits: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  run byte(&mut out.*, 0x44)
  return run littleEndian(&mut out.*, bits, 8)
}

/// A memory access `code` with alignment exponent `align` and constant offset `offset`.
pub effect fn memoryAccess(out: &mut Bytes, code: u8, align: usize, offset: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  run byte(&mut out.*, code)
  run index(&mut out.*, align)
  return run unsigned(&mut out.*, offset)
}

/// `block`, `loop` or `if` with no result.
pub effect fn structured(out: &mut Bytes, code: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  run byte(&mut out.*, code)
  return run byte(&mut out.*, emptyBlock())
}

pub fn opBlock() -> u8 { return 0x02 }
pub fn opLoop() -> u8 { return 0x03 }
pub fn opIf() -> u8 { return 0x04 }
pub fn opElse() -> u8 { return 0x05 }
pub fn opEnd() -> u8 { return 0x0B }
pub fn opBr() -> u8 { return 0x0C }
pub fn opBrIf() -> u8 { return 0x0D }
pub fn opReturn() -> u8 { return 0x0F }
pub fn opUnreachable() -> u8 { return 0x00 }
pub fn opCall() -> u8 { return 0x10 }
pub fn opCallIndirect() -> u8 { return 0x11 }
pub fn opDrop() -> u8 { return 0x1A }
pub fn opSelect() -> u8 { return 0x1B }
