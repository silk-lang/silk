//! The control flow facts of one finished `SsaFunction`: predecessors, reverse postorder, the
//! dominator tree and dominance frontiers, which its verifier and passes read.
//!
//! # When to use
//! Compute an [`SsaGraph`] with [`SsaGraph.of`] after `SsaFunction.finish`, and again after a
//! pass changes a block's edges: the graph does not follow later changes.
//!
//! # Details
//! Immediate dominators come from Cooper, Harvey and Kennedy's iteration over reverse postorder,
//! and dominance frontiers from their walk up from each predecessor of a merge. A block reached
//! twice from one predecessor, as a switch's two cases can, lists that predecessor twice.

import backend.SsaFunction {Edge, SsaFunction}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize

/// The control flow facts of one function, by block position.
pub struct SsaGraph {
  /// Per block, its predecessors as `[start, end)` into `predecessors`, one per edge into it.
  predecessorStart: List<usize>,
  predecessors: List<usize>,
  /// Per block, its reverse postorder number, or `usize.MAX` when no path reaches it.
  order: List<usize>,
  /// The reached blocks in reverse postorder, the entry first.
  sequence: List<usize>,
  /// Per block, its immediate dominator; the entry's is itself, and an unreached block's
  /// `usize.MAX`.
  dominator: List<usize>,
  /// Per block, its children in the dominator tree as `[start, end)` into `children`, in reverse
  /// postorder.
  childStart: List<usize>,
  children: List<usize>,
}

fn intersect(dominator: &[usize], order: &[usize], left: usize, right: usize) -> usize {
  let mut first = left
  let mut second = right
  while first != second {
    while order[first] > order[second] { first = dominator[first] }
    while order[second] > order[first] { second = dominator[second] }
  }
  return first
}

impl SsaGraph {
  /// The graph of `function`, whose entry is block 0.
  pub effect fn of(function: &SsaFunction) -> SsaGraph ! OutOfMemoryError ? &mut Allocator {
    let count = function.blockCount()
    // Postorder by an explicit depth-first walk over each block's edges in order.
    let mut visited = run List<bool>.makeWithCapacity(count)
    run List<bool>.appendRepeated(&mut visited, false, count)
    let mut postorder = run List<usize>.makeWithCapacity(count)
    let mut stack = List<usize>.make()
    let mut cursor = List<usize>.make()
    if count != usize.ZERO {
      run List<usize>.append(&mut stack, usize.ZERO)
      run List<usize>.append(&mut cursor, usize.ZERO)
      List<bool>.set(&mut visited, usize.ZERO, true)
    }
    while List<usize>.length(&stack) > usize.ZERO {
      let top = List<usize>.length(&stack) - usize.ONE
      let node = List<usize>.get(&stack, top)
      let position = List<usize>.get(&cursor, top)
      let edges = List<Edge>.asSlice(&function.block(node).edges)
      if position < edges.length {
        List<usize>.set(&mut cursor, top, position + usize.ONE)
        let target = edges[position].block
        if !List<bool>.get(&visited, target) {
          List<bool>.set(&mut visited, target, true)
          run List<usize>.append(&mut stack, target)
          run List<usize>.append(&mut cursor, usize.ZERO)
        }
      } else {
        run List<usize>.append(&mut postorder, node)
        drop List<usize>.pop(&mut stack)
        drop List<usize>.pop(&mut cursor)
      }
    }
    let reached = List<usize>.length(&postorder)
    let mut order = run List<usize>.makeWithCapacity(count)
    run List<usize>.appendRepeated(&mut order, usize.MAX, count)
    let mut sequence = run List<usize>.makeWithCapacity(reached)
    let mut at = usize.ZERO
    while at < reached {
      let node = List<usize>.get(&postorder, reached - usize.ONE - at)
      List<usize>.set(&mut order, node, at)
      run List<usize>.append(&mut sequence, node)
      at = at + usize.ONE
    }
    // Predecessors, by counting then filling.
    let mut inCount = run List<usize>.makeWithCapacity(count)
    run List<usize>.appendRepeated(&mut inCount, usize.ZERO, count)
    at = usize.ZERO
    while at < count {
      let edges = List<Edge>.asSlice(&function.block(at).edges)
      let mut edge = usize.ZERO
      while edge < edges.length {
        let counted = List<usize>.get(&inCount, edges[edge].block) + usize.ONE
        List<usize>.set(&mut inCount, edges[edge].block, counted)
        edge = edge + usize.ONE
      }
      at = at + usize.ONE
    }
    let mut predecessorStart = run List<usize>.makeWithCapacity(count + usize.ONE)
    let mut total = usize.ZERO
    at = usize.ZERO
    while at < count {
      run List<usize>.append(&mut predecessorStart, total)
      total = total + List<usize>.get(&inCount, at)
      at = at + usize.ONE
    }
    run List<usize>.append(&mut predecessorStart, total)
    let mut predecessors = run List<usize>.makeWithCapacity(total)
    run List<usize>.appendRepeated(&mut predecessors, usize.ZERO, total)
    let mut filled = run List<usize>.makeWithCapacity(count)
    run List<usize>.appendRepeated(&mut filled, usize.ZERO, count)
    at = usize.ZERO
    while at < count {
      let edges = List<Edge>.asSlice(&function.block(at).edges)
      let mut edge = usize.ZERO
      while edge < edges.length {
        let target = edges[edge].block
        let slot = List<usize>.get(&predecessorStart, target) + List<usize>.get(&filled, target)
        List<usize>.set(&mut predecessors, slot, at)
        let done = List<usize>.get(&filled, target) + usize.ONE
        List<usize>.set(&mut filled, target, done)
        edge = edge + usize.ONE
      }
      at = at + usize.ONE
    }
    // Immediate dominators over reverse postorder numbers.
    let mut dominator = run List<usize>.makeWithCapacity(count)
    run List<usize>.appendRepeated(&mut dominator, usize.MAX, count)
    if count != usize.ZERO { List<usize>.set(&mut dominator, usize.ZERO, usize.ZERO) }
    let mut changed = true
    while changed {
      changed = false
      let mut step = usize.ONE
      while step < reached {
        let node = List<usize>.get(&sequence, step)
        let mut chosen = usize.MAX
        let mut edge = List<usize>.get(&predecessorStart, node)
        while edge < List<usize>.get(&predecessorStart, node + usize.ONE) {
          let from = List<usize>.get(&predecessors, edge)
          if List<usize>.get(&dominator, from) != usize.MAX {
            if chosen == usize.MAX {
              chosen = from
            } else {
              chosen = intersect(List<usize>.asSlice(&dominator), List<usize>.asSlice(&order), from, chosen)
            }
          }
          edge = edge + usize.ONE
        }
        if chosen != List<usize>.get(&dominator, node) {
          List<usize>.set(&mut dominator, node, chosen)
          changed = true
        }
        step = step + usize.ONE
      }
    }
    // Dominator tree children, in reverse postorder.
    let mut childCount = run List<usize>.makeWithCapacity(count)
    run List<usize>.appendRepeated(&mut childCount, usize.ZERO, count)
    at = usize.ONE
    while at < reached {
      let parent = List<usize>.get(&dominator, List<usize>.get(&sequence, at))
      let counted = List<usize>.get(&childCount, parent) + usize.ONE
      List<usize>.set(&mut childCount, parent, counted)
      at = at + usize.ONE
    }
    let mut childStart = run List<usize>.makeWithCapacity(count + usize.ONE)
    total = usize.ZERO
    at = usize.ZERO
    while at < count {
      run List<usize>.append(&mut childStart, total)
      total = total + List<usize>.get(&childCount, at)
      at = at + usize.ONE
    }
    run List<usize>.append(&mut childStart, total)
    let mut children = run List<usize>.makeWithCapacity(total)
    run List<usize>.appendRepeated(&mut children, usize.ZERO, total)
    let mut placed = run List<usize>.makeWithCapacity(count)
    run List<usize>.appendRepeated(&mut placed, usize.ZERO, count)
    at = usize.ONE
    while at < reached {
      let node = List<usize>.get(&sequence, at)
      let parent = List<usize>.get(&dominator, node)
      let slot = List<usize>.get(&childStart, parent) + List<usize>.get(&placed, parent)
      List<usize>.set(&mut children, slot, node)
      let done = List<usize>.get(&placed, parent) + usize.ONE
      List<usize>.set(&mut placed, parent, done)
      at = at + usize.ONE
    }
    return SsaGraph {predecessorStart: move predecessorStart, predecessors: move predecessors, order: move order, sequence: move sequence,
      dominator: move dominator, childStart: move childStart, children: move children}
  }

  /// The predecessors of `block`, one per edge into it.
  pub fn predecessorsOf(self: &Self, block: usize) -> &[usize] {
    let start = List<usize>.get(&self.predecessorStart, block)
    let end = List<usize>.get(&self.predecessorStart, block + usize.ONE)
    return Slice.view<usize>(List<usize>.asSlice(&self.predecessors), start, end - start)
  }

  /// Whether a path from the entry reaches `block`.
  pub fn reaches(self: &Self, block: usize) -> bool { return List<usize>.get(&self.order, block) != usize.MAX }

  /// The reached blocks in reverse postorder, the entry first.
  pub fn reversePostorder(self: &Self) -> &[usize] { return List<usize>.asSlice(&self.sequence) }

  /// `block`'s reverse postorder number, or `usize.MAX` when no path reaches it.
  pub fn orderOf(self: &Self, block: usize) -> usize { return List<usize>.get(&self.order, block) }

  /// The immediate dominator of `block`: the entry's is itself, an unreached block's `usize.MAX`.
  pub fn dominatorOf(self: &Self, block: usize) -> usize { return List<usize>.get(&self.dominator, block) }

  /// The children of `block` in the dominator tree, in reverse postorder.
  pub fn childrenOf(self: &Self, block: usize) -> &[usize] {
    let start = List<usize>.get(&self.childStart, block)
    let end = List<usize>.get(&self.childStart, block + usize.ONE)
    return Slice.view<usize>(List<usize>.asSlice(&self.children), start, end - start)
  }

  /// Whether every path from the entry to `below` passes through `above`; a block dominates
  /// itself. Both must be reached.
  pub fn dominates(self: &Self, above: usize, below: usize) -> bool {
    let order = List<usize>.asSlice(&self.order)
    let dominator = List<usize>.asSlice(&self.dominator)
    let mut at = below
    while true {
      if at == above { return true }
      if at == usize.ZERO || order[at] <= order[above] { return false }
      at = dominator[at]
    }
    return false
  }

  /// Each block's dominance frontier: the blocks where its dominance ends, each listed once per
  /// block, by block position.
  pub effect fn frontiers(self: &Self) -> List<List<usize>> ! OutOfMemoryError ? &mut Allocator {
    let count = List<usize>.length(&self.order)
    let mut frontiers = run List<List<usize>>.makeWithCapacity(count)
    let mut at = usize.ZERO
    while at < count {
      run List<List<usize>>.append(&mut frontiers, List<usize>.make())
      at = at + usize.ONE
    }
    let dominator = List<usize>.asSlice(&self.dominator)
    at = usize.ZERO
    while at < count {
      let incoming = self.predecessorsOf(at)
      if incoming.length >= 2 && self.reaches(at) {
        let mut edge = usize.ZERO
        while edge < incoming.length {
          let mut runner = incoming[edge]
          while self.reaches(runner) && runner != dominator[at] {
            let listed = &mut List<List<usize>>.asMutSlice(&mut frontiers)[runner]
            let length = List<usize>.length(&listed.*)
            if length == usize.ZERO || List<usize>.get(&listed.*, length - usize.ONE) != at { run List<usize>.append(&mut listed.*, at) }
            if runner == usize.ZERO { break }
            runner = dominator[runner]
          }
          edge = edge + usize.ONE
        }
      }
      at = at + usize.ONE
    }
    return move frontiers
  }
}
