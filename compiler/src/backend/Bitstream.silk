//! The bit writer under LLVM bitcode: fixed-width and variable-width (VBR) fields packed into
//! little-endian 32-bit words, blocks whose length is written when they end, and records.
//!
//! # Details
//! A field of up to 64 bits enters a 64-bit buffer that never holds a whole word for long: each
//! full word moves to `words` at once. A block's length word is reserved when it starts and set
//! when it ends, so nothing is copied after the fact. Records are unabbreviated unless a block
//! defines an abbreviation for them; the only abbreviation here is the blob one the string table
//! needs, since LLVM reads a blob only through an abbreviation.

import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.ownership {Copy}
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// Bitcode bytes being written: whole words, and the bits of the word being filled.
pub struct Writer {
  words: List<u32>,
  buffer: u64,
  /// The bits held in `buffer`, always fewer than 32 between writes.
  count: usize,
}

/// An open block: the abbreviation width of its records, and where its length word is.
pub struct Block {
  pub width: usize,
  lengthWord: usize,
}

impl Copy for Block {}

/// The abbreviation width of the outermost level, and of a block that defines no abbreviation.
pub fn topWidth() -> usize { return 2 }

impl Writer {
  /// A writer that has written nothing.
  pub fn make() -> Writer {
    return Writer {words: List<u32>.make(), buffer: 0, count: usize.ZERO}
  }

  /// The number of whole words written so far.
  pub fn wordCount(self: &Self) -> usize {
    return List<u32>.length(&self.words)
  }

  /// Writes the low `width` bits of `value`, for a width of at most 64.
  pub effect fn bits(self: &mut Self, value: u64, width: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    if width > 32 {
      run Writer.bits(&mut self.*, u64.bitAnd(value, 4294967295), 32)
      run Writer.bits(&mut self.*, u64.shiftRight(value, 32), width - 32)
      return ()
    }
    let mut masked = value
    if width < 32 { masked = u64.bitAnd(value, u64.shiftLeft(1, usize.toU64(width)) - 1) }
    self.buffer = u64.bitOr(self.buffer, u64.shiftLeft(masked, usize.toU64(self.count)))
    self.count = self.count + width
    if self.count >= 32 {
      run List<u32>.append(&mut self.words, u64.toU32(u64.bitAnd(self.buffer, 4294967295)))
      self.buffer = u64.shiftRight(self.buffer, 32)
      self.count = self.count - 32
    }
    return ()
  }

  /// Writes `value` as VBR fields of `width` bits: each holds `width - 1` bits of the value, low
  /// first, and its top bit says that another follows.
  pub effect fn vbr(self: &mut Self, value: u64, width: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let payload = usize.toU64(width - usize.ONE)
    let limit = u64.shiftLeft(1, payload)
    let mut rest = value
    while rest >= limit {
      run Writer.bits(&mut self.*, u64.bitOr(u64.bitAnd(rest, limit - 1), limit), width)
      rest = u64.shiftRight(rest, payload)
    }
    return run Writer.bits(&mut self.*, rest, width)
  }

  /// Pads the current word with zero bits.
  pub effect fn align(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.count == usize.ZERO { return () }
    run List<u32>.append(&mut self.words, u64.toU32(self.buffer))
    self.buffer = 0
    self.count = usize.ZERO
    return ()
  }

  /// Starts block `id` inside a level whose abbreviation width is `outer`; its own records use
  /// `width` bits for their abbreviation ids.
  pub effect fn enter(self: &mut Self, outer: usize, id: u64, width: usize) -> Block ! OutOfMemoryError ? &mut Allocator {
    run Writer.bits(&mut self.*, 1, outer)
    run Writer.vbr(&mut self.*, id, 8)
    run Writer.vbr(&mut self.*, usize.toU64(width), 4)
    run Writer.align(&mut self.*)
    let lengthWord = List<u32>.length(&self.words)
    run List<u32>.append(&mut self.words, 0)
    return Block {width: width, lengthWord: lengthWord}
  }

  /// Ends `block`, writing its length in words.
  pub effect fn exit(self: &mut Self, block: Block) -> () ! OutOfMemoryError ? &mut Allocator {
    run Writer.bits(&mut self.*, 0, block.width)
    run Writer.align(&mut self.*)
    let length = List<u32>.length(&self.words) - block.lengthWord - usize.ONE
    List<u32>.set(&mut self.words, block.lengthWord, u64.toU32(usize.toU64(length)))
    return ()
  }

  /// Starts an unabbreviated record of `code` with `count` operands; each operand follows as one
  /// `operand` call.
  pub effect fn record(self: &mut Self, block: Block, code: u64, count: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    run Writer.bits(&mut self.*, 3, block.width)
    run Writer.vbr(&mut self.*, code, 6)
    return run Writer.vbr(&mut self.*, usize.toU64(count), 6)
  }

  /// Writes one operand of an unabbreviated record.
  pub effect fn operand(self: &mut Self, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
    return run Writer.vbr(&mut self.*, value, 6)
  }

  /// Writes a whole unabbreviated record.
  pub effect fn recordOf(self: &mut Self, block: Block, code: u64, values: &[u64]) -> () ! OutOfMemoryError ? &mut Allocator {
    run Writer.record(&mut self.*, block, code, values.length)
    let mut at = usize.ZERO
    while at < values.length {
      run Writer.vbr(&mut self.*, values[at], 6)
      at = at + usize.ONE
    }
    return ()
  }

  /// Writes an unabbreviated record whose operands are `bytes`, one per byte.
  pub effect fn recordOfBytes(self: &mut Self, block: Block, code: u64, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    run Writer.record(&mut self.*, block, code, bytes.length)
    let mut at = usize.ZERO
    while at < bytes.length {
      run Writer.vbr(&mut self.*, u8.toU64(bytes[at]), 6)
      at = at + usize.ONE
    }
    return ()
  }

  /// Defines, in `block`, the abbreviation `[literal code, blob]`. The first abbreviation a block
  /// defines has id 4.
  pub effect fn defineBlob(self: &mut Self, block: Block, code: u64) -> () ! OutOfMemoryError ? &mut Allocator {
    run Writer.bits(&mut self.*, 2, block.width)
    run Writer.vbr(&mut self.*, 2, 5)
    run Writer.bits(&mut self.*, 1, 1)
    run Writer.vbr(&mut self.*, code, 8)
    run Writer.bits(&mut self.*, 0, 1)
    return run Writer.bits(&mut self.*, 5, 3)
  }

  /// Writes a record through the blob abbreviation `abbreviation`: the length, then the bytes from
  /// the next word, padded to a whole word.
  pub effect fn blob(self: &mut Self, block: Block, abbreviation: u64, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    run Writer.bits(&mut self.*, abbreviation, block.width)
    run Writer.vbr(&mut self.*, usize.toU64(bytes.length), 6)
    run Writer.align(&mut self.*)
    let mut at = usize.ZERO
    while at < bytes.length {
      let mut word: u64 = 0
      let mut lane = usize.ZERO
      while lane < 4 && at + lane < bytes.length {
        word = u64.bitOr(word, u64.shiftLeft(u8.toU64(bytes[at + lane]), usize.toU64(lane * 8)))
        lane = lane + usize.ONE
      }
      run List<u32>.append(&mut self.words, u64.toU32(word))
      at = at + 4
    }
    return ()
  }

  /// The bytes written, once the last word is complete.
  pub effect fn finish(self: &mut Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    run Writer.align(&mut self.*)
    let words = List<u32>.asSlice(&self.words)
    let mut bytes = run Bytes.zeroed(words.length * 4)
    let out = Bytes.asMutSlice(&mut bytes)
    let mut at = usize.ZERO
    while at < words.length {
      let word = u32.toU64(words[at])
      out[at * 4] = u64.toU8(u64.bitAnd(word, 255))
      out[at * 4 + 1] = u64.toU8(u64.bitAnd(u64.shiftRight(word, 8), 255))
      out[at * 4 + 2] = u64.toU8(u64.bitAnd(u64.shiftRight(word, 16), 255))
      out[at * 4 + 3] = u64.toU8(u64.shiftRight(word, 24))
      at = at + usize.ONE
    }
    return move bytes
  }
}
