//! Checked-plan projections retain concrete graph identity, ordering and pending obligations.

import backend.InstanceKey {HelperRole, InstanceKey}
import backend.Mir {MirFunction, Block, Statement, Rvalue, Place, Projection, Diagnostics,
  Reference as MirReference, NonParkingRun, SharedAccess, EscapeSite as MirEscapeSite, AccessEscape}
import backend.MirProof
import backend.RuntimeProof {RuntimeProof, Reference, Site, Obligation, EscapeKind, EscapeSite,
  Control, ControlEvent, EventKind}
import hir.Hir {OwnerKind}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.SourceLocations {Location}
import semantic.Specialization {Edge}
import semantic.Type {Type, Argument}
import semantic.TypedBody {BorrowStatus, Origin}
import semantic.Types {Types, TypeTable}
import semantic.Lifetime {CanonicalizationFailure}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.interned {Interned}
import silk.mem.shared {Shared}
import silk.num.usize
import silk.testing.testing {AssertionError, Testing}

effect fn declaration(name: &[u8], kind: OwnerKind) -> DeclarationId
! OutOfMemoryError | InvalidModulePath ? &mut Allocator {
  let module = run ModuleId.make(b"workspace", b"proof", b"main")
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners,
    OwnerStep {kind: kind, name: Option<Bytes>.some(run Bytes.copy(name)), occurrence: usize.ZERO})
  return run DeclarationId.fromParts(move module, move owners)
}

fn origin(node: usize) -> Origin { return Origin {node: node, location: Location.make(node, node + usize.ONE)} }

fn place() -> Place { return Place {local: usize.ZERO, projections: List<Projection>.make()} }

effect fn helper(owner: &InstanceKey, role: HelperRole) -> InstanceKey ! OutOfMemoryError ? &mut Allocator {
  return InstanceKey.Helper {creator: run Shared<InstanceKey>.make(InstanceKey.copy(owner)),
    node: usize.ZERO, ordinal: usize.ZERO, purpose: role}
}

test effect fn runtimeProofRetainsPendingBorrowAndConcreteCallbackRoles() -> ()
! OutOfMemoryError | InvalidModulePath | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run projectionWithTypes() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn projectionWithTypes() -> ()
! OutOfMemoryError | InvalidModulePath | AssertionError<'static> ? &mut Allocator {
  let mut types = TypeTable.make()
  return run projectionClaims() |> Effect.provideMut<Types>(&mut types)
}

effect fn projectionClaims() -> ()
! OutOfMemoryError | InvalidModulePath | AssertionError<'static> ? &mut Allocator | &mut Types {
  let identity = run Types.internDeclaration(run declaration(b"call", OwnerKind.Function))
  let unit = run Types.intern(Type.Unit)
  let symbol = run Shared<Bytes>.make(run Bytes.copy(b"proof_export"))
  let mut function = run MirFunction.cExport(&identity, &symbol, &[], &unit, false)
  let start = run helper(&function.key, HelperRole.Start)
  let notify = run helper(&function.key, HelperRole.Notify)
  let nominal = run declaration(b"Owner", OwnerKind.Struct)
  let nominalType = run Types.intern(Type.Nominal {declaration: DeclarationId.copy(&nominal),
    isPublic: false, arguments: List<Argument>.make()})
  let glue = match move run InstanceKey.dropGlue(&nominalType, &nominal) {
    Result<Option<InstanceKey>, CanonicalizationFailure>.Success {value: Option<InstanceKey>.Some {value}} => move value
    _ => {
      run Testing.expect(false, "a nominal cleanup has an exact glue key")
      return ()
    }
  }
  function.borrow = BorrowStatus.Awaiting
  function.observes = true
  function.releasesPackages = true
  function.suspension = Option<Origin>.some(origin(7))
  function.parks = Option<Origin>.some(origin(9))
  let blocks = List<Block>.asMutSlice(&mut function.blocks)
  run List<Statement>.append(&mut blocks[0].statements,
    Statement.Assign {destination: place(), value: Rvalue.FunctionAddress {key: InstanceKey.copy(&start)}, origin: origin(1)})
  run List<Statement>.append(&mut blocks[0].statements,
    Statement.Assign {destination: place(), value: Rvalue.FunctionAddress {key: InstanceKey.copy(&notify)}, origin: origin(2)})
  run List<Statement>.append(&mut blocks[0].statements,
    Statement.Assign {destination: place(), value: Rvalue.FunctionAddress {key: InstanceKey.copy(&function.key)}, origin: origin(3)})
  run List<Statement>.append(&mut blocks[0].statements,
    Statement.Assign {destination: place(), value: Rvalue.FunctionAddress {key: InstanceKey.copy(&glue)}, origin: origin(4)})
  run List<Statement>.append(&mut blocks[0].statements,
    Statement.Drop {destination: place(), glue: InstanceKey.copy(&glue), diagnostics: Option<Diagnostics>.none(), origin: origin(5)})
  drop blocks
  run List<MirReference>.append(&mut function.references,
    MirReference {key: InstanceKey.copy(&glue), edge: Edge.Cleanup {owner: Interned<Type>.clone(&nominalType)}, origin: origin(5)})
  run List<MirReference>.append(&mut function.references,
    MirReference {key: InstanceKey.copy(&glue), edge: Edge.Witness, origin: origin(6)})
  let mut callees = List<InstanceKey>.make()
  run List<InstanceKey>.append(&mut callees, InstanceKey.copy(&notify))
  let mut glues = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut glues, Interned<Type>.clone(&nominalType))
  let mut declarations = List<Interned<DeclarationId>>.make()
  run List<Interned<DeclarationId>>.append(&mut declarations, Interned<DeclarationId>.clone(&identity))
  run List<NonParkingRun>.append(&mut function.nonParking, NonParkingRun {callees: move callees,
    glues: move glues, declarations: move declarations, exact: false, origin: Option<Origin>.none()})
  run List<SharedAccess>.append(&mut function.accesses, SharedAccess {callback: InstanceKey.copy(&notify), origin: origin(10)})
  run List<MirEscapeSite>.append(&mut function.escapes, MirEscapeSite {kind: AccessEscape.Callback, origin: origin(11)})
  let proof = run MirProof.extract(&function)
  run Testing.expect(proof.borrow == BorrowStatus.Awaiting && proof.observes && proof.releasesPackages,
    "projection preserves pending borrowing and logical observation/release facts")
  let callbacks = List<Site>.asSlice(&proof.callbacks)
  run Testing.expect(callbacks.length == usize.ONE && callbacks[0].origin.node == 3,
    "only the formed fixed-linkage address is a callback boundary, with its raw origin")
  let indirect = List<InstanceKey>.asSlice(&proof.indirect)
  run Testing.expect(indirect.length == 4, "forming a start helper does not execute it; notify, callback and two glue uses remain")
  run Testing.expect(run InstanceKey.sameApplication(&indirect[0], &notify), "readiness precedes the later formed addresses")
  run Testing.expect(run InstanceKey.sameApplication(&indirect[2], &glue), "formed package glue remains an indirect target")
  run Testing.expect(run InstanceKey.sameApplication(&indirect[3], &glue), "the repeated drop is not deduplicated")
  let packages = List<InstanceKey>.asSlice(&proof.packages)
  run Testing.expect(packages.length == usize.ONE, "only forming the glue address adds a package target")
  let refs = List<Reference>.asSlice(&proof.references)
  run Testing.expect(refs.length == 3 && refs[1].origin.node == 5 && refs[2].origin.node == 6,
    "reference multiplicity and authored ordering survive projection")
  run Testing.expect(match &refs[1].edge { Edge.Cleanup {..} => true _ => false }, "cleanup provenance stays attached")
  run Testing.expect(match &refs[2].edge { Edge.Witness => true _ => false }, "a repeated identity retains distinct witness provenance")
  let owed = List<Obligation>.asSlice(&proof.nonParking)
  run Testing.expect(owed.length == usize.ONE && !owed[0].exact
    && match &owed[0].origin { Option<Origin>.None => true _ => false },
    "an unavailable nonparking target stays unproved and an entry obligation stays caller-anchored")
  let accesses = List<Site>.asSlice(&proof.accesses)
  run Testing.expect(accesses.length == usize.ONE && accesses[0].origin.node == 10,
    "held callback origins remain declaration-relative")
  let escapes = List<EscapeSite>.asSlice(&proof.escapes)
  run Testing.expect(escapes.length == usize.ONE && escapes[0].kind == EscapeKind.Callback && escapes[0].origin.node == 11,
    "readiness escapes preserve their kind and origin")
  run Testing.expect(match &proof.suspension { Option<Origin>.Some {value} => value.node == 7 _ => false },
    "the first suspension keeps its own origin")
  run Testing.expect(match &proof.parks { Option<Origin>.Some {value} => value.node == 9 _ => false },
    "external parking remains separate from suspension")
  let mut changed = run MirProof.extract(&function)
  run Testing.expect(run RuntimeProof.equivalent(&proof, &changed), "identical concrete obligations compare equal")
  let changedCalls = List<Site>.asMutSlice(&mut changed.callees)
  changedCalls[0].origin = origin(99)
  drop changedCalls
  run Testing.expect(!run RuntimeProof.equivalent(&proof, &changed),
    "the same target set at a different diagnostic site is not an equivalent proof")
  changed = run MirProof.extract(&function)
  let changedOwed = List<Obligation>.asMutSlice(&mut changed.nonParking)
  changedOwed[0].exact = true
  drop changedOwed
  run Testing.expect(!run RuntimeProof.equivalent(&proof, &changed),
    "an unavailable obligation cannot compare equal to a discharged concrete target")
  return ()
}

test effect fn runtimeControlUsesFinalBlockOrderAndReplacedTerminators() -> ()
! OutOfMemoryError | InvalidModulePath | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run controlWithTypes() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn controlWithTypes() -> ()
! OutOfMemoryError | InvalidModulePath | AssertionError<'static> ? &mut Allocator {
  let mut types = TypeTable.make()
  return run controlClaims() |> Effect.provideMut<Types>(&mut types)
}

effect fn controlClaims() -> ()
! OutOfMemoryError | InvalidModulePath | AssertionError<'static> ? &mut Allocator | &mut Types {
  let identity = run Types.internDeclaration(run declaration(b"call", OwnerKind.Function))
  let key = run InstanceKey.named(&identity)
  let mut control = Control.make()
  let first = run Control.block(&mut control)
  let second = run Control.block(&mut control)
  let third = run Control.block(&mut control)
  Control.terminate(&mut control, second, Option<Site>.some(Site {key: InstanceKey.copy(&key), origin: origin(20)}))
  Control.terminate(&mut control, third, Option<Site>.some(Site {key: InstanceKey.copy(&key), origin: origin(30)}))
  Control.terminate(&mut control, first, Option<Site>.some(Site {key: InstanceKey.copy(&key), origin: origin(10)}))
  Control.terminate(&mut control, third, Option<Site>.none())
  run Control.append(&mut control, second, ControlEvent {kind: EventKind.Drop, key: InstanceKey.copy(&key), origin: origin(22)})
  run Control.append(&mut control, first, ControlEvent {kind: EventKind.Drop, key: InstanceKey.copy(&key), origin: origin(12)})
  let mut proof = RuntimeProof.make(InstanceKey.copy(&key), BorrowStatus.Checked)
  run RuntimeProof.projectControl(&mut proof, &control)
  let calls = List<Site>.asSlice(&proof.callees)
  run Testing.expect(calls.length == 2 && calls[0].origin.node == 10 && calls[1].origin.node == 20,
    "final logical block order wins over visit order, and replaced calls leave no stale target")
  drop calls
  run RuntimeProof.projectControl(&mut proof, &control)
  run Testing.expect(List<Site>.length(&proof.callees) == 2 && List<InstanceKey>.length(&proof.indirect) == 2,
    "reprojecting finalized control replaces derived targets instead of duplicating budget edges")
  return ()
}
