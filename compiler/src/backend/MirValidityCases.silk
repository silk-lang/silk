//! The structural MIR check catches each defect a pass could leave behind, in hand-built
//! functions that are well formed but for that one defect.

import backend.CAbi
import backend.InstanceKey {InstanceKey}
import backend.Mir {
  Block,
  Callee,
  Cancel,
  ContextText,
  Diagnostics,
  EscapeSite,
  Inlining,
  Local,
  LocalKind,
  MirFunction,
  NonParkingRun,
  Operand,
  Place,
  Projection,
  Reference,
  Rvalue,
  SharedAccess,
  Statement,
  SwitchCase,
  Terminator,
  TrapSite,
  Variable,
}
import backend.MirValidity
import backend.MirValidity {Defect, Violation}
import semantic.DeclarationId {DeclarationId}
import semantic.Lifetime {CanonicalizationFailure}
import semantic.ModuleId {InvalidModulePath}
import semantic.SemanticCaseSupport {module, recipeControlKey}
import semantic.SourceLocations {Location}
import semantic.Specialization {Edge}
import semantic.Type {Type}
import semantic.TypedBody {BorrowStatus, Origin}
import semantic.Types {TypeTable, Types}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.interned {Interned}
import silk.testing.testing {AssertionError, Testing}
import silk.num.u64
import silk.num.usize

fn origin() -> Origin {
  return Origin {node: usize.ZERO, location: Location.make(usize.ZERO, usize.ONE)}
}

fn place(local: usize) -> Place {
  return Place {local: local, projections: List<Projection>.make()}
}

effect fn local(ty: &Interned<Type>, kind: LocalKind) -> Local ! OutOfMemoryError ? &mut Allocator {
  return Local {ty: Interned<Type>.clone(ty), kind: move kind, origin: origin()}
}

// `fn f(flag: bool) -> ()`: `_2 = copy _1; branch _2 -> bb1, bb1`, then `return`. Well formed.
effect fn sample(key: &InstanceKey) -> MirFunction ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let unit = run Types.intern(Type.Unit)
  let boolean = run Types.intern(Type.Primitive {name: run Bytes.copy(b"bool")})
  let mut locals = List<Local>.make()
  run List<Local>.append(&mut locals, run local(&unit, LocalKind.Return))
  run List<Local>.append(&mut locals, run local(&boolean, LocalKind.Parameter {index: usize.ZERO}))
  run List<Local>.append(&mut locals, run local(&boolean, LocalKind.Temp))
  let mut statements = List<Statement>.make()
  run List<Statement>.append(&mut statements, Statement.Assign {destination: place(2), value: Rvalue.Use {value: Operand.Copy {place: place(usize.ONE)}},
    origin: origin()})
  let mut blocks = List<Block>.make()
  run List<Block>.append(&mut blocks, Block {statements: move statements,
    terminator: Terminator.Branch {condition: Operand.Copy {place: place(2)}, thenBlock: usize.ONE, elseBlock: usize.ONE, origin: origin()}})
  run List<Block>.append(&mut blocks, Block {statements: List<Statement>.make(), terminator: Terminator.Return {origin: origin()}})
  let mut parameters = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut parameters, move boolean)
  return MirFunction {key: InstanceKey.copy(key), borrow: BorrowStatus.Checked, result: move unit, parameters: move parameters,
    locals: move locals, blocks: move blocks, references: List<Reference>.make(), externs: List<Interned<DeclarationId>>.make(),
    observes: false, contexts: List<ContextText>.make(), traps: List<TrapSite>.make(), suspension: Option<Origin>.none(),
    parks: Option<Origin>.none(), releasesPackages: false, nonParking: List<NonParkingRun>.make(), cancels: List<Cancel>.make(),
    accesses: List<SharedAccess>.make(), escapes: List<EscapeSite>.make(), features: Bytes.make(), inlining: Inlining.Default,
    optimizeSize: false, frame: Bytes.make(), lines: List<u64>.make(), variables: List<Variable>.make(), inlined: List<InstanceKey>.make()}
}

effect fn defect(function: &MirFunction) -> Option<Defect> ! OutOfMemoryError ? &mut Allocator {
  return match move run MirValidity.check(function) {
    Option<Violation>.Some {value} => Option<Defect>.some(value.defect)
    Option<Violation>.None => Option<Defect>.none()
  }
}

effect fn finds(function: &MirFunction, expected: Defect) -> bool ! OutOfMemoryError ? &mut Allocator {
  return match move run defect(function) {
    Option<Defect>.Some {value} => value == expected
    Option<Defect>.None => false
  }
}

effect fn key() -> InstanceKey ! InvalidModulePath | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let id = run module("validity.silk")
  return run recipeControlKey(&id, b"sample", false)
}

effect fn setTerminator(function: &mut MirFunction, block: usize, terminator: Terminator) -> () {
  let mut blocks = List<Block>.asMutSlice(&mut function.blocks)
  blocks[block].terminator = move terminator
}

effect fn setKind(function: &mut MirFunction, at: usize, kind: LocalKind) -> () {
  let mut locals = List<Local>.asMutSlice(&mut function.locals)
  locals[at].kind = move kind
}

test effect fn localsMustKeepTheirShape() -> ()
! InvalidModulePath | CanonicalizationFailure | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run localClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn localClaims() -> () ! InvalidModulePath | CanonicalizationFailure | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let instance = run key()
  let valid = run sample(&instance)
  let none = match move run defect(&valid) { Option<Defect>.None => true _ => false }
  run Testing.expect(none, "the sample function is well formed")

  let mut twoReturns = run sample(&instance)
  run setKind(&mut twoReturns, 2, LocalKind.Return)
  run Testing.expect(run finds(&twoReturns, Defect.ReturnLocal), "a second return local is a defect")

  let mut missing = run sample(&instance)
  run setKind(&mut missing, usize.ONE, LocalKind.Temp)
  run Testing.expect(run finds(&missing, Defect.Parameters), "a listed parameter without its local is a defect")

  let mut misplaced = run sample(&instance)
  run setKind(&mut misplaced, 2, LocalKind.Parameter {index: usize.ONE})
  run Testing.expect(run finds(&misplaced, Defect.Parameters), "a parameter local past the listed parameters is a defect")

  let mut hidden = run sample(&instance)
  run setKind(&mut hidden, 2, LocalKind.Observer)
  let unit = run Types.intern(Type.Unit)
  run List<Local>.append(&mut hidden.locals, run local(&unit, LocalKind.Observer))
  run Testing.expect(run finds(&hidden, Defect.DuplicateHidden), "two observer locals are a defect")

  let mut stray = run sample(&instance)
  run List<Local>.append(&mut stray.locals, run local(&unit, LocalKind.DropFlag {local: 9, path: List<Projection>.make()}))
  run Testing.expect(run finds(&stray, Defect.LocalRange), "a drop flag of a missing local is a defect")

  let mut nested = run sample(&instance)
  run List<Local>.append(&mut nested.locals, run local(&unit, LocalKind.DropFlag {local: 2, path: List<Projection>.make()}))
  run List<Local>.append(&mut nested.locals, run local(&unit, LocalKind.DropFlag {local: 3, path: List<Projection>.make()}))
  run Testing.expect(run finds(&nested, Defect.FlagOfFlag), "a drop flag of a drop flag is a defect")

  let mut indexed = run sample(&instance)
  let mut projections = List<Projection>.make()
  run List<Projection>.append(&mut projections, Projection.Index {local: 7})
  let mut statements = List<Statement>.asMutSlice(&mut List<Block>.asMutSlice(&mut indexed.blocks)[usize.ZERO].statements)
  statements[usize.ZERO] = Statement.Assign {destination: place(2),
    value: Rvalue.Use {value: Operand.Copy {place: Place {local: usize.ONE, projections: move projections}}}, origin: origin()}
  drop statements
  run Testing.expect(run finds(&indexed, Defect.LocalRange), "a runtime index naming a missing local is a defect")
  return ()
}

test effect fn controlFlowMustStayInsideTheFunction() -> ()
! InvalidModulePath | CanonicalizationFailure | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run controlClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn controlClaims() -> () ! InvalidModulePath | CanonicalizationFailure | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let instance = run key()
  let mut empty = run sample(&instance)
  empty.blocks = List<Block>.make()
  run Testing.expect(run finds(&empty, Defect.NoBlocks), "a function without an entry block is a defect")

  let mut far = run sample(&instance)
  run setTerminator(&mut far, usize.ZERO, Terminator.Branch {condition: Operand.Copy {place: place(2)}, thenBlock: usize.ONE, elseBlock: 7,
    origin: origin()})
  run Testing.expect(run finds(&far, Defect.BlockRange), "a branch to a missing block is a defect")

  let mut switched = run sample(&instance)
  let mut cases = List<SwitchCase>.make()
  run List<SwitchCase>.append(&mut cases, SwitchCase {decimal: run Bytes.copy(b"1"), negative: false, target: usize.ONE})
  run List<SwitchCase>.append(&mut cases, SwitchCase {decimal: run Bytes.copy(b"1"), negative: false, target: usize.ONE})
  run setTerminator(&mut switched, usize.ZERO, Terminator.Switch {value: Operand.Copy {place: place(2)}, cases: move cases,
    otherwise: usize.ONE, origin: origin()})
  run Testing.expect(run finds(&switched, Defect.SwitchRepeat), "a switch listing one value twice is a defect")

  let mut failing = run sample(&instance)
  run setTerminator(&mut failing, usize.ONE, Terminator.Fail {origin: origin()})
  run Testing.expect(run finds(&failing, Defect.FailWithoutSlot), "failing without a failure slot is a defect")

  let mut cancelled = run sample(&instance)
  run List<Cancel>.append(&mut cancelled.cancels, Cancel {point: usize.ONE, entry: usize.ONE})
  run Testing.expect(run finds(&cancelled, Defect.CancelPoint), "a cancel exit of a block that does not call is a defect")

  let mut lost = run sample(&instance)
  run List<Cancel>.append(&mut lost.cancels, Cancel {point: usize.ZERO, entry: 5})
  run Testing.expect(run finds(&lost, Defect.BlockRange), "a cancel exit to a missing block is a defect")
  return ()
}

test effect fn callsAndTablesMustMatchTheBody() -> ()
! InvalidModulePath | CanonicalizationFailure | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run tableClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn call(callee: Callee, providers: List<Operand>, diagnostics: Option<Diagnostics>) -> Terminator {
  return Terminator.Call {callee: move callee, arguments: List<Operand>.make(), providers: move providers, diagnostics: move diagnostics,
    destination: place(usize.ZERO), normal: usize.ONE, failure: Option.None, origin: origin()}
}

effect fn tableClaims() -> () ! InvalidModulePath | CanonicalizationFailure | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let instance = run key()
  let id = run module("validity.silk")
  let other = run recipeControlKey(&id, b"other", false)

  let mut unlisted = run sample(&instance)
  run setTerminator(&mut unlisted, usize.ZERO, run call(Callee.Instance {key: InstanceKey.copy(&other)}, List<Operand>.make(), Option.None))
  run Testing.expect(run finds(&unlisted, Defect.Unreferenced), "a call of an instance the references omit is a defect")
  run List<Reference>.append(&mut unlisted.references, Reference {key: InstanceKey.copy(&other), edge: Edge.Direct, origin: origin()})
  let listed = match move run defect(&unlisted) { Option<Defect>.None => true _ => false }
  run Testing.expect(listed, "a call of a referenced instance is well formed")

  let mut addressed = run sample(&instance)
  let mut statements = List<Statement>.asMutSlice(&mut List<Block>.asMutSlice(&mut addressed.blocks)[usize.ZERO].statements)
  statements[usize.ZERO] = Statement.Assign {destination: place(2), value: Rvalue.FunctionAddress {key: InstanceKey.copy(&other)}, origin: origin()}
  drop statements
  run Testing.expect(run finds(&addressed, Defect.Unreferenced), "taking the address of an instance the references omit is a defect")

  let declaration = InstanceKey.identity(&instance)
  let mut providers = List<Operand>.make()
  run List<Operand>.append(&mut providers, Operand.Unit)
  let mut foreign = run sample(&instance)
  run setTerminator(&mut foreign, usize.ZERO, run call(Callee.Extern {declaration: move declaration, variadicArguments: List<CAbi.VariadicArgument>.make()},
    move providers, Option.None))
  run Testing.expect(run finds(&foreign, Defect.ForeignHidden), "a C call with providers is a defect")

  let mut context = run sample(&instance)
  let mut written = List<Statement>.asMutSlice(&mut List<Block>.asMutSlice(&mut context.blocks)[usize.ZERO].statements)
  written[usize.ZERO] = Statement.FailureContext {destination: place(2), source: Option<Place>.none(), origin: origin()}
  drop written
  run Testing.expect(run finds(&context, Defect.MissingContext), "originating a context without its entry is a defect")
  run List<ContextText>.append(&mut context.contexts, ContextText {origin: origin(), identities: List<Bytes>.make(), label: Bytes.make()})
  let found = match move run defect(&context) { Option<Defect>.None => true _ => false }
  run Testing.expect(found, "originating a context with its entry is well formed")
  return ()
}
