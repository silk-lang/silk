//! Reference projection of executable MIR's runtime obligations.
//!
//! This projection establishes the checked-plan transition's parity contract. It performs no
//! new semantic checking and does not make constructing executable MIR cheaper.

import backend.InstanceKey {InstanceKey}
import backend.Mir {AccessEscape, Block, Callee, MirFunction, NonParkingRun, Reference as MirReference,
  Rvalue, Statement, Terminator, SharedAccess, EscapeSite as MirEscapeSite}
import backend.RuntimeProof {RuntimeProof, Reference, Site, Obligation, EscapeKind, EscapeSite, Control, ControlEvent, EventKind}
import semantic.DeclarationId {DeclarationId}
import semantic.Specialization {Edge}
import semantic.Type {Type}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.interned {Interned}
import silk.num.usize

/// Projects the same ordered direct calls, addresses, drops and logical obligations that an
/// escape walk reads from `function`. Source origins remain unanchored and repeated edges remain.
pub effect fn extract(function: &MirFunction) -> RuntimeProof ! OutOfMemoryError ? &mut Allocator {
  let mut control = Control.make()
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let block = run Control.block(&mut control)
    if let Terminator.Call {callee: Callee.Instance {key}, origin, ..} = &blocks[at].terminator {
      Control.terminate(&mut control, block, Option<Site>.some(Site {key: InstanceKey.copy(&key), origin: origin}))
    }
    let statements = List<Statement>.asSlice(&blocks[at].statements)
    let mut statement = usize.ZERO
    while statement < statements.length {
      if let Statement.Assign {value: Rvalue.FunctionAddress {key}, origin, ..} = &statements[statement] {
        run Control.append(&mut control, block,
          ControlEvent {kind: EventKind.Address, key: InstanceKey.copy(&key), origin: origin})
      }
      if let Statement.Drop {glue, origin, ..} = &statements[statement] {
        run Control.append(&mut control, block,
          ControlEvent {kind: EventKind.Drop, key: InstanceKey.copy(&glue), origin: origin})
      }
      statement = statement + usize.ONE
    }
    at = at + usize.ONE
  }
  return run extractPlanned(function, &control)
}

/// Combines the lowering engine's logical metadata with its finalized proof-only control sink.
/// The function's executable blocks are neither read nor required.
pub effect fn extractPlanned(function: &MirFunction, control: &Control) -> RuntimeProof
! OutOfMemoryError ? &mut Allocator {
  let mut proof = RuntimeProof.make(InstanceKey.copy(&function.key), function.borrow)
  proof.suspension = function.suspension
  proof.parks = function.parks
  proof.observes = function.observes
  proof.releasesPackages = function.releasesPackages
  let references = List<MirReference>.asSlice(&function.references)
  let mut at = usize.ZERO
  while at < references.length {
    run List<Reference>.append(&mut proof.references, Reference {key: InstanceKey.copy(&references[at].key),
      edge: Edge.copy(&references[at].edge), origin: references[at].origin})
    at = at + usize.ONE
  }
  run RuntimeProof.projectControl(&mut proof, control)
  let obligations = List<NonParkingRun>.asSlice(&function.nonParking)
  at = usize.ZERO
  while at < obligations.length {
    let value = &obligations[at]
    let mut callees = List<InstanceKey>.make()
    let selected = List<InstanceKey>.asSlice(&value.callees)
    let mut each = usize.ZERO
    while each < selected.length {
      run List<InstanceKey>.append(&mut callees, InstanceKey.copy(&selected[each]))
      each = each + usize.ONE
    }
    let mut glues = List<Interned<Type>>.make()
    let types = List<Interned<Type>>.asSlice(&value.glues)
    each = usize.ZERO
    while each < types.length {
      run List<Interned<Type>>.append(&mut glues, Interned<Type>.clone(&types[each]))
      each = each + usize.ONE
    }
    let mut declarations = List<Interned<DeclarationId>>.make()
    let identities = List<Interned<DeclarationId>>.asSlice(&value.declarations)
    each = usize.ZERO
    while each < identities.length {
      run List<Interned<DeclarationId>>.append(&mut declarations, Interned<DeclarationId>.clone(&identities[each]))
      each = each + usize.ONE
    }
    run List<Obligation>.append(&mut proof.nonParking, Obligation {callees: move callees,
      glues: move glues, declarations: move declarations, exact: value.exact, origin: value.origin})
    at = at + usize.ONE
  }
  let accesses = List<SharedAccess>.asSlice(&function.accesses)
  at = usize.ZERO
  while at < accesses.length {
    run List<Site>.append(&mut proof.accesses, Site {key: InstanceKey.copy(&accesses[at].callback), origin: accesses[at].origin})
    at = at + usize.ONE
  }
  let escapes = List<MirEscapeSite>.asSlice(&function.escapes)
  at = usize.ZERO
  while at < escapes.length {
    let kind = match escapes[at].kind { AccessEscape.Suspension => EscapeKind.Suspension AccessEscape.Callback => EscapeKind.Callback }
    run List<EscapeSite>.append(&mut proof.escapes, EscapeSite {kind: kind, origin: escapes[at].origin})
    at = at + usize.ONE
  }
  return move proof
}
