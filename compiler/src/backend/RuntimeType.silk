//! Exact storage projection after ordinary semantic substitution. Proof applications and
//! deferred schema blueprints retain their source identities; only runtime storage is projected.

import semantic.CallableWitness
import semantic.CallableWitness {CallableWitness as WitnessRecipe}
import semantic.Type {Argument, Binding, Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.option {Option}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// One resolver-proven finite representation of a closed semantic type.
pub struct Projection {
  pub source: Shared<Type>
  pub storage: Shared<Type>
}

/// Substitutes the selected application before projecting its runtime storage.
pub effect fn applyBindings(value: &Shared<Type>, bindings: &[Binding], projections: &[Projection]) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let closed = run Type.applyBindings(value, bindings, true)
  return run project(&closed, projections)
}

/// Applies exact representation evidence without modifying a semantic proof key.
/// Replacements are already recursively realized by the resolver; they are never rebound here.
pub effect fn project(value: &Shared<Type>, projections: &[Projection]) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let view = Shared.with<Type, Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> {
    return match &node.* {
      Type.CallableView {representation, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&representation))
      _ => Option.none<Shared<Type>>()
    }
  })
  if let Option<Shared<Type>>.Some {value: original} = move view { return run project(&original, projections) }
  if projections.length == usize.ZERO && !Type.containsStorageView(value) { return Shared.clone<Type>(value) }
  let selected = run resolved(value, projections)
  if let Option<Shared<Type>>.Some {value: storage} = move selected { return move storage }
  let copied = run Type.copy(value)
  return run children(move copied, projections)
}

/// Looks up resolver evidence by exact semantic identity after substitution.
pub effect fn resolved(value: &Shared<Type>, projections: &[Projection]) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < projections.length {
    if run Type.equalsShared(value, &projections[at].source) {
      return Option.some<Shared<Type>>(Shared.clone<Type>(&projections[at].storage))
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Type>>()
}

effect fn types(values: &Vector<Shared<Type>>, projections: &[Projection]) -> Vector<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  let listed = Vector.asSlice<Shared<Type>>(values)
  let mut output = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < listed.length {
    run Vector.append<Shared<Type>>(&mut output, run project(&listed[at], projections))
    at = at + usize.ONE
  }
  return move output
}

effect fn arguments(values: &Vector<Argument>, projections: &[Projection]) -> Vector<Argument>
! OutOfMemoryError ? &mut Allocator {
  let listed = Vector.asSlice<Argument>(values)
  let mut output = Vector.make<Argument>()
  let mut at = usize.ZERO
  while at < listed.length {
    let argument = match &listed[at] {
      Argument.Type {value} => Argument.Type {value: run project(&value, projections)}
      _ => Argument.copy(&listed[at])
    }
    run Vector.append<Argument>(&mut output, move argument)
    at = at + usize.ONE
  }
  return move output
}

effect fn children(value: Type, projections: &[Projection]) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  return match move value {
    Type.CallableView {representation, ..} => run project(&representation, projections)
    Type.Reference {referent, access, lifetime} => run Shared.make<Type>(Type.Reference {
      referent: run project(&referent, projections), access: access, lifetime: move lifetime})
    Type.Slice {element, access, lifetime} => run Shared.make<Type>(Type.Slice {
      element: run project(&element, projections), access: access, lifetime: move lifetime})
    Type.Pointer {pointee, access, nullable, multiplicity, alignment} => run Shared.make<Type>(Type.Pointer {
      pointee: run project(&pointee, projections), access: access, nullable: nullable,
      multiplicity: multiplicity, alignment: move alignment})
    Type.Array {element, extent} => run Shared.make<Type>(Type.Array {
      element: run project(&element, projections), extent: move extent})
    Type.Nominal {declaration, isPublic, arguments: supplied} => run Shared.make<Type>(Type.Nominal {
      declaration: move declaration, isPublic: isPublic, arguments: run arguments(&supplied, projections)})
    Type.Anonymous {occurrence, members} => run Shared.make<Type>(Type.Anonymous {
      occurrence: move occurrence, members: run types(&members, projections)})
    Type.Union {members} => run Shared.make<Type>(Type.Union {members: run types(&members, projections)})
    Type.Callable {mode, isUnsafe, environment, invocationBinders, invocationUse, invocationBounds, parameters, result} =>
      run Shared.make<Type>(Type.Callable {mode: mode, isUnsafe: isUnsafe, environment: move environment,
        invocationBinders: invocationBinders, invocationUse: invocationUse, invocationBounds: move invocationBounds,
        parameters: run types(&parameters, projections), result: run project(&result, projections)})
    Type.CallableValue {isPublic, application, contract, captures, fieldInputs, ..} =>
      run Type.callableValue(isPublic, move application, run project(&contract, projections),
        run types(&captures, projections), move fieldInputs)
    Type.CallableSchema {schema, captures, fieldInputs, ..} =>
      run Type.callableSchema(move schema, run types(&captures, projections), move fieldInputs)
    // A still-unrealized recipe remains explicit so the backend reports its named gap.
    // The resolver must provide evidence for every reached opaque or staged storage value.
    Type.Primitive {name} => run Shared.make<Type>(Type.Primitive {name: move name})
    Type.Unit => run Shared.make<Type>(Type.Unit)
    Type.String {lifetime} => run Shared.make<Type>(Type.String {lifetime: move lifetime})
    Type.Parameter {declaration, ordinal} => run Shared.make<Type>(Type.Parameter {
      declaration: move declaration, ordinal: ordinal})
    Type.TypeDescriptor {owner} => run Shared.make<Type>(Type.TypeDescriptor {owner: move owner})
    Type.OpaqueRepresentation {application, contract, detached, nonParking} =>
      run Shared.make<Type>(Type.OpaqueRepresentation {application: move application,
        contract: move contract, detached: detached, nonParking: nonParking})
    Type.CallableWitnessResult {witness} => run Shared.make<Type>(Type.CallableWitnessResult {witness: move witness})
    Type.CallableOrigin {application, contract} => run Shared.make<Type>(Type.CallableOrigin {application: move application, contract: move contract})
    Type.CallableResult {producer, contract, arguments: supplied, selected, selectedOrdinals} =>
      run Shared.make<Type>(Type.CallableResult {producer: move producer, contract: move contract, arguments: move supplied, selected: move selected, selectedOrdinals: move selectedOrdinals})
    Type.CallableStage {base, contract, captures, remaining, suffixMode} =>
      run Shared.make<Type>(Type.CallableStage {base: move base, contract: move contract,
        captures: move captures, remaining: remaining, suffixMode: suffixMode})
    Type.Effect {mode, environment, success, failure, requirements} =>
      run Shared.make<Type>(Type.Effect {mode: mode, environment: move environment,
        success: move success, failure: move failure, requirements: move requirements})
    Type.EffectComposite {operation, selector, parts, contract} => run Shared.make<Type>(Type.EffectComposite {
      operation: operation, selector: run project(&selector, projections), parts: run types(&parts, projections),
      contract: run project(&contract, projections)})
    Type.EffectJoin {alternatives, ..} => run joinStorage(&alternatives, projections)
  }
}

/// A join stores its one alternative as itself and several as their structural union (D1).
effect fn joinStorage(alternatives: &Vector<Shared<Type>>, projections: &[Projection]) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let listed = Vector.asSlice<Shared<Type>>(alternatives)
  let mut members = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < listed.length {
    let storage = run project(&listed[at], projections)
    run Type.joinMember(&mut members, &storage)
    at = at + usize.ONE
  }
  if Vector.length<Shared<Type>>(&members) == usize.ONE { return Vector.remove<Shared<Type>>(&mut members, usize.ZERO) }
  return run Shared.make<Type>(Type.Union {members: move members})
}

/// Direct runtime type inputs, excluding application proof keys and bound schema blueprints.
pub effect fn inputs(value: &Shared<Type>) -> Vector<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(value)
  let mut output = Vector.make<Shared<Type>>()
  match move copied {
    Type.CallableView {representation, ..} => run Vector.append<Shared<Type>>(&mut output, move representation)
    Type.Reference {referent, ..} => run Vector.append<Shared<Type>>(&mut output, move referent)
    Type.Slice {element, ..} => run Vector.append<Shared<Type>>(&mut output, move element)
    Type.Pointer {pointee, ..} => run Vector.append<Shared<Type>>(&mut output, move pointee)
    Type.Array {element, ..} => run Vector.append<Shared<Type>>(&mut output, move element)
    Type.Nominal {arguments: supplied, ..} => {
      let listed = Vector.asSlice<Argument>(&supplied)
      let mut at = usize.ZERO
      while at < listed.length {
        if let Argument.Type {value: child} = &listed[at] {
          run Vector.append<Shared<Type>>(&mut output, Shared.clone<Type>(&child))
        }
        at = at + usize.ONE
      }
    }
    Type.Anonymous {members, ..} => { output = move members }
    Type.Union {members} => { output = move members }
    Type.CallableValue {captures, ..} => { output = move captures }
    Type.CallableSchema {captures, ..} => { output = move captures }
    Type.CallableWitnessResult {witness} => {
      let recipe = Shared.with<WitnessRecipe, WitnessRecipe>(&witness, CallableWitness.copy)
      let count = CallableWitness.argumentCount(&recipe)
      let mut at = usize.ZERO
      while at < count {
        run Vector.append<Shared<Type>>(&mut output, CallableWitness.argumentAt(&recipe, at))
        at = at + usize.ONE
      }
    }
    Type.CallableResult {producer, arguments: supplied, ..} => {
      output = move supplied
      run Vector.append<Shared<Type>>(&mut output, move producer)
    }
    Type.EffectComposite {parts, ..} => { output = move parts }
    Type.EffectJoin {alternatives, ..} => { output = move alternatives }
    Type.CallableStage {base, captures, ..} => {
      output = move captures
      run Vector.append<Shared<Type>>(&mut output, move base)
    }
    Type.Callable {parameters, result, ..} => {
      output = move parameters
      run Vector.append<Shared<Type>>(&mut output, move result)
    }
    _ => ()
  }
  return move output
}
