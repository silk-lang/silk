//! Real-source equivalence of compact runtime planning and executable lowering.

import backend.InstanceKey {InstanceKey, HelperRole}
import backend.RuntimeProof {RuntimeProof, Reference, Site, Obligation}
import backend.RuntimeProofCases
import hir.Hir {OwnerKind}
import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.Query {Cycle}
import semantic.Semantic {Semantic, Request, Answer, Outcome, Value, NoRejection, RevisionMismatch}
import semantic.SemanticCaseSupport {staticSemantic}
import semantic.Target {Target, Id as TargetId}
import semantic.Types {Types, TypeTable}
import semantic.TypedBody {Origin}
import semantic.Type {Type}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.shared {Shared}
import silk.mem.interned {Interned}
import silk.num.usize
import silk.testing.testing {AssertionError, Testing}

struct Evidence {
  helpers: usize,
  observerHelpers: usize,
  cleanup: bool,
  observes: bool,
  parks: bool,
  access: bool,
  obligation: bool,
  unreachable: bool,
}

fn isPlan(answer: &Result<Answer, NoRejection>) -> bool {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.RuntimePlan {..}} => true
      _ => false
    }
    _ => false
  }
}

effect fn rootIdentity(module: &ModuleId, name: &[u8]) -> DeclarationId ! OutOfMemoryError ? &mut Allocator {
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners,
    OwnerStep {kind: OwnerKind.Function, name: Option<Bytes>.some(run Bytes.copy(name)), occurrence: usize.ZERO})
  return run DeclarationId.fromParts(ModuleId.copy(module), move owners)
}

effect fn alreadySeen(keys: &[InstanceKey], key: &InstanceKey) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < keys.length {
    if run InstanceKey.sameApplication(&keys[at], key) { return true }
    at = at + usize.ONE
  }
  return false
}

// Walks the real concrete references before requesting any executable oracle. This also tests
// helper lookup through the creator plan and ordinary callee/provider/drop admission.
effect fn compareSource(text: string, root: &[u8], observing: bool) -> Evidence
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let module = run ModuleId.make(b"memory", b"runtime-plan-cases", b"case.silk")
  let mut store = run staticSemantic(&module, text, Target.forId(TargetId.X8664UnknownLinuxGnu))
  let identity = run rootIdentity(&module, root)
  let canonical = run Types.internDeclaration(DeclarationId.copy(&identity))
  let key = run InstanceKey.named(&canonical)
  let mut request = Request.make()
  let mut pending = List<InstanceKey>.make()
  let mut visited = List<InstanceKey>.make()
  run List<InstanceKey>.append(&mut pending, move key)
  let mut scanned = usize.ZERO
  while List<InstanceKey>.length(&pending) > usize.ZERO {
    let instance = match move List<InstanceKey>.pop(&mut pending) {
      Option<InstanceKey>.Some {value} => move value
      _ => { run Testing.expect(false, "a queued concrete plan exists") return Evidence {helpers: 0, observerHelpers: 0,
        cleanup: false, observes: false, parks: false, access: false, obligation: false, unreachable: false} }
    }
    if run alreadySeen(List<InstanceKey>.asSlice(&visited), &instance) { continue }
    run List<InstanceKey>.append(&mut visited, InstanceKey.copy(&instance))
    let owner = DeclarationId.copyShared(&InstanceKey.identity(&instance))
    let answer = run Semantic.demandInstanceRuntimePlan(&mut store, &mut request, &instance, &owner,
      Span.make(usize.ZERO, usize.ZERO), observing)
    run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&answer, isPlan),
      "each real reachable instance produces a complete runtime plan")
    while scanned < Semantic.runtimeProofCount(&store) {
      let proof = match move Semantic.runtimeProofAt(&store, scanned) {
        Option<&RuntimeProof>.Some {value} => value
        _ => { run Testing.expect(false, "published runtime proofs are present") return Evidence {helpers: 0, observerHelpers: 0,
          cleanup: false, observes: false, parks: false, access: false, obligation: false, unreachable: false} }
      }
      let refs = List<Reference>.asSlice(&proof.references)
      let mut at = usize.ZERO
      while at < refs.length {
        run List<InstanceKey>.append(&mut pending, InstanceKey.copy(&refs[at].key))
        at = at + usize.ONE
      }
      scanned = scanned + usize.ONE
    }
  }
  let count = Semantic.runtimeProofCount(&store)
  run Testing.expect(count > usize.ZERO, "the fixture executes the concrete planner")
  let mut result = Evidence {helpers: 0, observerHelpers: 0, cleanup: false, observes: false,
    parks: false, access: false, obligation: false, unreachable: false}
  let mut at = usize.ZERO
  while at < count {
    let proof = match move Semantic.runtimeProofAt(&store, at) {
      Option<&RuntimeProof>.Some {value} => value
      _ => { run Testing.expect(false, "the planner retains its proof") return move result }
    }
    if let InstanceKey.Helper {purpose, ..} = &proof.key {
      result.helpers = result.helpers + usize.ONE
      if purpose == HelperRole.Observe { result.observerHelpers = result.observerHelpers + usize.ONE }
      run Testing.expect(!Semantic.runtimeProofHasExecutable(&store, at),
        "generated helper proof comes from compact control, not executable fallback")
    }
    let declaration = DeclarationId.copyShared(&InstanceKey.identity(&proof.key))
    if DeclarationId.named(&declaration, root) {
      run Testing.expect(!Semantic.runtimeProofHasExecutable(&store, at),
        "the source root is checked by the compact sink")
    }
    result.observes = result.observes || proof.observes
    result.parks = result.parks || match &proof.parks { Option<Origin>.Some {..} => true _ => false }
    result.access = result.access || List<Site>.length(&proof.accesses) > usize.ZERO
    result.obligation = result.obligation || List<Obligation>.length(&proof.nonParking) > usize.ZERO
    let refs = List<Reference>.asSlice(&proof.references)
    let mut edge = usize.ZERO
    while edge < refs.length {
      if let Option<Interned<Type>>.Some {..} = move InstanceKey.glueType(&refs[edge].key) {
        result.cleanup = true
      }
      let target = DeclarationId.copyShared(&InstanceKey.identity(&refs[edge].key))
      result.unreachable = result.unreachable || DeclarationId.named(&target, b"unreachableTarget")
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < count {
    let executable = match move run Semantic.runtimeProofExecutableOracle(&mut store, at, observing) {
      Option<RuntimeProof>.Some {value} => move value
      _ => { run Testing.expect(false, "the exact executable counterpart materializes") return move result }
    }
    let planned = match move Semantic.runtimeProofAt(&store, at) {
      Option<&RuntimeProof>.Some {value} => value
      _ => { run Testing.expect(false, "materialization preserves the checked plan") return move result }
    }
    run Testing.expect(run RuntimeProof.equivalent(planned, &executable),
      "actual compact control and coalesced executable MIR preserve every exact target, obligation and origin")
    at = at + usize.ONE
  }
  return move result
}

test effect fn checkedRuntimePlanPreservesCleanupBranchesAndUnreachableCalls() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  run cleanupClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn cleanupClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn unreachableTarget() -> i32 { return 99 }
fn cleanup(flag: bool) -> i32 {
  let token = Token { value: 7 }
  if flag { return 1 }
  drop token
  return 2
  return unreachableTarget()
}
"""
  let evidence = run compareSource(text, b"cleanup", false)
  run Testing.expect(evidence.cleanup && !evidence.unreachable,
    "both early-exit and explicit cleanup survive while unreachable calls remain excluded")
}

test effect fn checkedRuntimePlanPreservesObserverFailureHelpersInBothModes() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  run observerClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn observerClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let text = """
struct Log { reports: usize }
struct Missing { code: i32 }
fn onEvent(self: &mut Log, event: u8, first: usize, second: usize, identity: string<'static>, origin: string<'static>) -> usize { return 1 }
effect fn load() -> i32 ! Missing { fail Missing { code: 1 } }
effect fn recover(problem: Missing) -> i32 { return problem.code }
effect fn body() -> i32 { return run Intrinsic.catchFailure<Missing>(load(), recover) }
fn observed() -> i32 { return run Intrinsic.observeDiagnostics(Log { reports: 0 }, onEvent, body()) }
"""
  let plain = run compareSource(text, b"observed", false)
  let observed = run compareSource(text, b"observed", true)
  run Testing.expect(plain.observes && observed.observes && plain.observerHelpers > usize.ZERO && observed.observerHelpers > usize.ZERO,
    "the real observer adapter group and failure context paths are compared in both instrumentation modes")
}

test effect fn checkedRuntimePlanPreservesSharedAccessAndExternalParking() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  run accessClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn accessClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let text = """
fn bump(value: &mut i32) -> i32 { return 1 }
fn busy() -> i32 { return 0 }
fn access(core: &Intrinsic.SharedCore<i32>) -> i32 { return Intrinsic.sharedWithMut<i32, i32>(core, bump, busy) }
effect fn pause() -> () { return run Intrinsic.relinquish() }
fn parked() -> i32 { run pause() return 1 }
"""
  let access = run compareSource(text, b"access", false)
  let parked = run compareSource(text, b"parked", false)
  run Testing.expect(access.access && parked.parks, "held callbacks and external parking remain concrete proof facts")
}

test effect fn checkedRuntimePlanPreservesSelectedProviderNonparkingObligations() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  run providerClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn providerClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let text = """
effect fn provideMut<'env, ?S, A, P, E, ?R>(self: once Effect<'env; A ! E ? R>, provider: &'env mut P) -> A ! E ? Without<R, S>
where &'env mut P provides S from R {
  let bound = Intrinsic.bindRequirementMut<S>(move self, provider)
  return run bound
}
service Port { @nonParking effect fn close() -> () ? &mut Port }
effect fn closing() -> () ? &mut Port { run Port.close() }
struct Calm {}
effect fn shut(self: &mut Calm) -> () { return () }
impl Port for Calm { close: Calm.shut }
fn closed() -> i32 {
  let mut port = Calm {}
  run closing() |> provideMut<Port>(&mut port)
  return 3
}
"""
  let evidence = run compareSource(text, b"closed", false)
  run Testing.expect(evidence.obligation, "the exact selected provider carries its nonparking obligation into the proof")
}
