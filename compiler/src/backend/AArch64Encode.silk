//! Pure AArch64 (ARM64) machine-code encoder for Darwin (`aarch64-apple-darwin`) code generation.
//!
//! # When to use
//! Use this module to append fixed-width 32-bit little-endian AArch64 instructions directly to a
//! `Bytes` code buffer without an external assembler. Every instruction handles `sp` (`31`) versus
//! `xzr` (`31`) distinctions, logical bitmask immediate encoding, branch and `adrp` page-offset
//! patching, scalar floating-point, 128-bit NEON SIMD, and ARMv8 crypto extensions.
//!
//! # Details
//! General-purpose registers are numbered `0..30` (`x0..x30`, with `fp = 29`, `lr = 30`), while
//! `31` denotes `sp` or `xzr` depending on the instruction encoding. Register `x18` is the Darwin
//! platform register and must never be allocated or clobbered by callers. Vector registers are
//! numbered `0..31` (`v0..v31`). Functions returning `usize` return the byte offset of the
//! 32-bit instruction word in `out` so callers can patch local branches or record Mach-O
//! relocations.

import CompilerBug
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.i32
import silk.num.i64
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// Shift kind for AArch64 shifted-register arithmetic and logical instructions.
pub enum ShiftKind {
  /// Logical shift left (`LSL`, `0b00`).
  Lsl,
  /// Logical shift right (`LSR`, `0b01`).
  Lsr,
  /// Arithmetic shift right (`ASR`, `0b10`).
  Asr,
  /// Rotate right (`ROR`, `0b11`, logical instructions only).
  Ror,
}

/// Index or operand extension kind for extended-register ALU (`Uxtb`..`Sxtx`) and
/// `[Xn, Xm, extend]` register-offset load/store (`Uxtw`, `Uxtx`, `Sxtw`, `Sxtx` only).
pub enum ExtendKind {
  /// Unsigned 8-bit extend (`UXTB`, `0b000`).
  Uxtb,
  /// Unsigned 16-bit extend (`UXTH`, `0b001`).
  Uxth,
  /// Unsigned 32-bit extend (`UXTW`, `0b010`).
  Uxtw,
  /// Unsigned 64-bit / `LSL` (`UXTX`, `0b011`).
  Uxtx,
  /// Signed 8-bit extend (`SXTB`, `0b100`).
  Sxtb,
  /// Signed 16-bit extend (`SXTH`, `0b101`).
  Sxth,
  /// Signed 32-bit extend (`SXTW`, `0b110`).
  Sxtw,
  /// Signed 64-bit extend (`SXTX`, `0b111`).
  Sxtx,
}

/// Addressing mode for `ldp` and `stp` load/store pair instructions.
pub enum PairMode {
  /// Signed scaled offset (`[Xn, #imm]`, `0b010`).
  SignedOffset,
  /// Post-indexed writeback (`[Xn], #imm`, `0b001`).
  PostIndex,
  /// Pre-indexed writeback (`[Xn, #imm]!`, `0b011`).
  PreIndex,
}

