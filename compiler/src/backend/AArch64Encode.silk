pub effect fn frintm(out: &mut Bytes, double: bool, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E254000 | ftypeBit(double) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `frintz vd, vn` (round toward zero / trunc).
pub effect fn frintz(out: &mut Bytes, double: bool, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E25C000 | ftypeBit(double) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `frinta vd, vn` (round to nearest, ties away from zero).
pub effect fn frinta(out: &mut Bytes, double: bool, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E264000 | ftypeBit(double) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

// ---- 128-bit NEON SIMD (`Q=1`) + Crypto ----

fn vecSizeCode(laneBytes: usize) -> u32 {
  if laneBytes == 8 { return 3 }
  if laneBytes == 4 { return 2 }
  if laneBytes == 2 { return 1 }
  return 0
}

fn vecShiftCode(laneBytes: usize) -> u32 {
  if laneBytes == 8 { return 3 }
  if laneBytes == 4 { return 2 }
  if laneBytes == 2 { return 1 }
  return 0
}

fn laneImm5(laneBytes: usize, idx: usize) -> u32 {
  let shift = vecShiftCode(laneBytes)
  return u32.shiftLeft(usize.toU32(idx), shift + 1) | u32.shiftLeft(1, shift)
}

/// `mov vd.16b, vn.16b` (`orr vd.16b, vn.16b, vn.16b`).
pub effect fn movVec(out: &mut Bytes, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4EA01C00 | u32.shiftLeft(r5(vn), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `movi vd.2d, #0` (zeroes all 128 bits of `vd`).
pub effect fn moviZero(out: &mut Bytes, vd: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x6F00E400 | r5(vd))
}

/// `movi vd.16b, #imm8` (splats an 8-bit constant across all 16 bytes of `vd`).
pub effect fn moviByte(out: &mut Bytes, vd: u8, imm8: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let abc = u8.toU32(u8.shiftRight(imm8, 5) & 7)
  let defgh = u8.toU32(imm8 & 31)
  return run emitWord(&mut out.*, 0x4F00E400 | u32.shiftLeft(abc, 16) | u32.shiftLeft(defgh, 5) | r5(vd))
}

/// `dup vd.T, rn` (`laneBytes` in `{1, 2, 4, 8}`).
pub effect fn dupGp(out: &mut Bytes, laneBytes: usize, vd: u8, rn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let imm5 = usize.toU32(laneBytes) & 0x1F
  return run emitWord(&mut out.*, 0x4E000C00 | u32.shiftLeft(imm5, 16) | u32.shiftLeft(r5(rn), 5) | r5(vd))
}

/// `dup vd.T, vn.Ts[idx]` (`laneBytes` in `{1, 2, 4, 8}`).
pub effect fn dupElem(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8, idx: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let imm5 = laneImm5(laneBytes, idx)
  return run emitWord(&mut out.*, 0x4E000400 | u32.shiftLeft(imm5, 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `mov vd.Ts[idx], rn` (`ins` from GPR; `laneBytes` in `{1, 2, 4, 8}`).
pub effect fn insGp(out: &mut Bytes, laneBytes: usize, vd: u8, idx: usize, rn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let imm5 = laneImm5(laneBytes, idx)
  return run emitWord(&mut out.*, 0x4E001C00 | u32.shiftLeft(imm5, 16) | u32.shiftLeft(r5(rn), 5) | r5(vd))
}

/// `mov vd.Ts[dstIdx], vn.Ts[srcIdx]` (`ins` between vector elements; `laneBytes` in `{1, 2, 4, 8}`).
pub effect fn insElem(out: &mut Bytes, laneBytes: usize, vd: u8, dstIdx: usize, vn: u8, srcIdx: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let shift = vecShiftCode(laneBytes)
  let imm5 = laneImm5(laneBytes, dstIdx)
  let imm4 = u32.shiftLeft(usize.toU32(srcIdx), shift) & 0xF
  return run emitWord(&mut out.*, 0x6E000400 | u32.shiftLeft(imm5, 16) | u32.shiftLeft(imm4, 11) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `umov rd, vn.Ts[idx]` (zero-extends byte/halfword/word into `wRd`, or copies 64-bit lane into `xRd`; `laneBytes` in `{1, 2, 4, 8}`).
pub effect fn umov(out: &mut Bytes, laneBytes: usize, rd: u8, vn: u8, idx: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let imm5 = laneImm5(laneBytes, idx)
  let base: u32 = if laneBytes == 8 { 0x4E003C00 } else { 0x0E003C00 }
  return run emitWord(&mut out.*, base | u32.shiftLeft(imm5, 16) | u32.shiftLeft(r5(vn), 5) | r5(rd))
}

/// `smov rd, vn.Ts[idx]` (sign-extends lane into `xRd` when `wide64`, else `wRd`; `laneBytes` in `{1, 2}` when `!wide64`, or `{1, 2, 4}` when `wide64`).
pub effect fn smov(out: &mut Bytes, wide64: bool, laneBytes: usize, rd: u8, vn: u8, idx: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let imm5 = laneImm5(laneBytes, idx)
  let base: u32 = if wide64 { 0x4E002C00 } else { 0x0E002C00 }
  return run emitWord(&mut out.*, base | u32.shiftLeft(imm5, 16) | u32.shiftLeft(r5(vn), 5) | r5(rd))
}

// Vector integer operations.

/// `add vd.T, vn.T, vm.T` (`laneBytes` in `{1, 2, 4, 8}`).
pub effect fn vecAdd(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4E208400 | u32.shiftLeft(vecSizeCode(laneBytes), 22) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `sub vd.T, vn.T, vm.T` (`laneBytes` in `{1, 2, 4, 8}`).
pub effect fn vecSub(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x6E208400 | u32.shiftLeft(vecSizeCode(laneBytes), 22) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `mul vd.T, vn.T, vm.T` (`laneBytes` in `{1, 2, 4}`).
pub effect fn vecMul(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4E209C00 | u32.shiftLeft(vecSizeCode(laneBytes), 22) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `smin vd.T, vn.T, vm.T` (`laneBytes` in `{1, 2, 4}`).
pub effect fn vecSmin(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4E206C00 | u32.shiftLeft(vecSizeCode(laneBytes), 22) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `smax vd.T, vn.T, vm.T` (`laneBytes` in `{1, 2, 4}`).
pub effect fn vecSmax(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4E206400 | u32.shiftLeft(vecSizeCode(laneBytes), 22) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `umin vd.T, vn.T, vm.T` (`laneBytes` in `{1, 2, 4}`).
pub effect fn vecUmin(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x6E206C00 | u32.shiftLeft(vecSizeCode(laneBytes), 22) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `umax vd.T, vn.T, vm.T` (`laneBytes` in `{1, 2, 4}`).
pub effect fn vecUmax(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x6E206400 | u32.shiftLeft(vecSizeCode(laneBytes), 22) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `sqadd vd.T, vn.T, vm.T` (signed saturating add).
pub effect fn vecSqadd(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4E200C00 | u32.shiftLeft(vecSizeCode(laneBytes), 22) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `uqadd vd.T, vn.T, vm.T` (unsigned saturating add).
pub effect fn vecUqadd(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x6E200C00 | u32.shiftLeft(vecSizeCode(laneBytes), 22) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `sqsub vd.T, vn.T, vm.T` (signed saturating subtract).
pub effect fn vecSqsub(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4E202C00 | u32.shiftLeft(vecSizeCode(laneBytes), 22) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `uqsub vd.T, vn.T, vm.T` (unsigned saturating subtract).
pub effect fn vecUqsub(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x6E202C00 | u32.shiftLeft(vecSizeCode(laneBytes), 22) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `neg vd.T, vn.T` (`laneBytes` in `{1, 2, 4, 8}`).
pub effect fn vecNeg(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x6E20B800 | u32.shiftLeft(vecSizeCode(laneBytes), 22) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `abs vd.T, vn.T` (`laneBytes` in `{1, 2, 4, 8}`).
pub effect fn vecAbs(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4E20B800 | u32.shiftLeft(vecSizeCode(laneBytes), 22) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `clz vd.T, vn.T` (`laneBytes` in `{1, 2, 4}`).
pub effect fn vecClz(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x6E204800 | u32.shiftLeft(vecSizeCode(laneBytes), 22) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `cnt vd.16b, vn.16b` (per-byte population count).
pub effect fn vecCnt(out: &mut Bytes, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4E205800 | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `rbit vd.16b, vn.16b` (per-byte bit reversal).
pub effect fn vecRbit(out: &mut Bytes, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x6E605800 | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `rev64 vd.T, vn.T` (`laneBytes` in `{1, 2, 4}`).
pub effect fn vecRev64(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4E200800 | u32.shiftLeft(vecSizeCode(laneBytes), 22) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

