pub fn fp() -> u8 { return 29 }
/// Link register alias (`x30`).
pub fn lr() -> u8 { return 30 }
/// Stack pointer register encoding (`31`, valid only in `sp`-accepting instruction slots).
pub fn sp() -> u8 { return 31 }
/// Zero register encoding (`31`, valid only in `xzr`/`wzr`-accepting instruction slots).
pub fn xzr() -> u8 { return 31 }

