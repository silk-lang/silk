pub effect fn vecRev16(out: &mut Bytes, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4E201800 | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

