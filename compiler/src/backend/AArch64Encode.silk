pub effect fn frintp(out: &mut Bytes, double: bool, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E24C000 | ftypeBit(double) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

