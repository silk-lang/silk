pub fn x17() -> u8 { return 17 }
/// `x18` / `w18` (Darwin-reserved platform register; never allocate or clobber).
pub fn x18() -> u8 { return 18 }
/// `x19` / `w19` (callee-saved).
pub fn x19() -> u8 { return 19 }
