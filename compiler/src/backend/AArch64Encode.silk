// Condition codes (ARM64 4-bit condition encodings).

/// Equal (`Z == 1`, `0x0`).
pub fn ccEq() -> u8 { return 0x0 }
/// Not equal (`Z == 0`, `0x1`).
pub fn ccNe() -> u8 { return 0x1 }
/// Carry set (`C == 1`, `0x2`).
pub fn ccCs() -> u8 { return 0x2 }
/// Unsigned higher or same (`C == 1`, `0x2`).
pub fn ccHs() -> u8 { return 0x2 }
/// Carry clear (`C == 0`, `0x3`).
pub fn ccCc() -> u8 { return 0x3 }
/// Unsigned lower (`C == 0`, `0x3`).
pub fn ccLo() -> u8 { return 0x3 }
/// Minus / negative (`N == 1`, `0x4`).
pub fn ccMi() -> u8 { return 0x4 }
/// Plus / non-negative (`N == 0`, `0x5`).
pub fn ccPl() -> u8 { return 0x5 }
/// Overflow (`V == 1`, `0x6`).
pub fn ccVs() -> u8 { return 0x6 }
/// No overflow (`V == 0`, `0x7`).
pub fn ccVc() -> u8 { return 0x7 }
/// Unsigned higher (`C == 1 && Z == 0`, `0x8`).
pub fn ccHi() -> u8 { return 0x8 }
/// Unsigned lower or same (`!(C == 1 && Z == 0)`, `0x9`).
pub fn ccLs() -> u8 { return 0x9 }
/// Signed greater or equal (`N == V`, `0xA`).
pub fn ccGe() -> u8 { return 0xA }
/// Signed less (`N != V`, `0xB`).
pub fn ccLt() -> u8 { return 0xB }
/// Signed greater (`Z == 0 && N == V`, `0xC`).
pub fn ccGt() -> u8 { return 0xC }
/// Signed less or equal (`!(Z == 0 && N == V)`, `0xD`).
pub fn ccLe() -> u8 { return 0xD }
/// Always (`0xE`).
pub fn ccAl() -> u8 { return 0xE }

/// Inverts an AArch64 condition code (`cc ^ 1`).
pub fn invertCc(cc: u8) -> u8 { return u8.bitXor(cc, 1) }

// Barrier domain/option encodings for `dmb` / `dsb`.

/// Inner shareable full barrier (`ISH`, `0xB`).
pub fn barrierIsh() -> u8 { return 0xB }
/// Inner shareable store barrier (`ISHST`, `0xA`).
pub fn barrierIshst() -> u8 { return 0xA }
/// Full system barrier (`SY`, `0xF`).
pub fn barrierSy() -> u8 { return 0xF }

// Common system register encodings for `mrs`.

/// `CNTFRQ_EL0` (`0x5F00`).
pub fn sysCntFrqEl0() -> u32 { return 0x5F00 }
/// `CNTVCT_EL0` (`0x5F02`).
pub fn sysCntVctEl0() -> u32 { return 0x5F02 }
/// `TPIDR_EL0` (`0x5E82`).
pub fn sysTpidrEl0() -> u32 { return 0x5E82 }
/// `TPIDRRO_EL0` (`0x5E83`).
pub fn sysTpidrRoEl0() -> u32 { return 0x5E83 }

// Buffer & patch primitives.

/// Appends one raw byte to `out`.
pub effect fn byte(out: &mut Bytes, value: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run Bytes.append(&mut out.*, &[value])
}

/// Appends a little-endian 16-bit integer to `out`.
pub effect fn u16Le(out: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let b0 = u64.wrappingToU8(value & 255)
  let b1 = u64.wrappingToU8(u64.shiftRight(value, 8) & 255)
  return run Bytes.append(&mut out.*, &[b0, b1])
}

/// Appends a little-endian 32-bit integer to `out`.
pub effect fn u32Le(out: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let b0 = u64.wrappingToU8(value & 255)
  let b1 = u64.wrappingToU8(u64.shiftRight(value, 8) & 255)
  let b2 = u64.wrappingToU8(u64.shiftRight(value, 16) & 255)
  let b3 = u64.wrappingToU8(u64.shiftRight(value, 24) & 255)
  return run Bytes.append(&mut out.*, &[b0, b1, b2, b3])
}

/// Appends a little-endian signed 32-bit integer to `out`.
pub effect fn i32Le(out: &mut Bytes, value: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  return run u32Le(&mut out.*, u32.toU64(i32.wrappingToU32(value)))
}

/// Appends a little-endian 64-bit integer to `out`.
pub effect fn u64Le(out: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let b0 = u64.wrappingToU8(value & 255)
  let b1 = u64.wrappingToU8(u64.shiftRight(value, 8) & 255)
  let b2 = u64.wrappingToU8(u64.shiftRight(value, 16) & 255)
  let b3 = u64.wrappingToU8(u64.shiftRight(value, 24) & 255)
  let b4 = u64.wrappingToU8(u64.shiftRight(value, 32) & 255)
  let b5 = u64.wrappingToU8(u64.shiftRight(value, 40) & 255)
  let b6 = u64.wrappingToU8(u64.shiftRight(value, 48) & 255)
  let b7 = u64.wrappingToU8(u64.shiftRight(value, 56) & 255)
  return run Bytes.append(&mut out.*, &[b0, b1, b2, b3, b4, b5, b6, b7])
}

/// Patches a little-endian 32-bit value at byte offset `at` inside `out`.
pub fn patchU32(out: &mut Bytes, at: usize, value: u64) -> () {
  let buf = Bytes.asMutSlice(&mut out.*)
  buf[at] = u64.wrappingToU8(value & 255)
  buf[at + 1] = u64.wrappingToU8(u64.shiftRight(value, 8) & 255)
  buf[at + 2] = u64.wrappingToU8(u64.shiftRight(value, 16) & 255)
  buf[at + 3] = u64.wrappingToU8(u64.shiftRight(value, 24) & 255)
}

effect fn emitWord(out: &mut Bytes, word: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  return run u32Le(&mut out.*, u32.toU64(word))
}

fn readU32(out: &Bytes, at: usize) -> u32 {
  let buf = Bytes.asSlice(out)
  return u8.toU32(buf[at])
    | u32.shiftLeft(u8.toU32(buf[at + 1]), 8)
    | u32.shiftLeft(u8.toU32(buf[at + 2]), 16)
    | u32.shiftLeft(u8.toU32(buf[at + 3]), 24)
}

fn sfBit(wide64: bool) -> u32 {
  if wide64 { return 0x80000000 }
  return 0
}

fn r5(reg: u8) -> u32 {
  return u8.toU32(reg & 31)
}

fn shiftCode(kind: ShiftKind) -> u32 {
  return match kind {
    ShiftKind.Lsl => 0
    ShiftKind.Lsr => 1
    ShiftKind.Asr => 2
    ShiftKind.Ror => 3
  }
}

fn extendCode(kind: ExtendKind) -> u32 {
  return match kind {
    ExtendKind.Uxtb => 0
    ExtendKind.Uxth => 1
    ExtendKind.Uxtw => 2
    ExtendKind.Uxtx => 3
    ExtendKind.Sxtb => 4
    ExtendKind.Sxth => 5
    ExtendKind.Sxtw => 6
    ExtendKind.Sxtx => 7
  }
}

/// Returns `true` when `kind` is valid for AArch64 register-offset load/store (`Uxtw`, `Uxtx`,
/// `Sxtw`, or `Sxtx`), or `false` otherwise.
pub fn isValidRegOffExtend(kind: ExtendKind) -> bool {
  return match kind {
    ExtendKind.Uxtw => true
    ExtendKind.Uxtx => true
    ExtendKind.Sxtw => true
    ExtendKind.Sxtx => true
    _ => false
  }
}

fn regOffExtendCode(kind: ExtendKind) -> u32 {
  return match kind {
    ExtendKind.Uxtw => 2
    ExtendKind.Uxtx => 3
    ExtendKind.Sxtw => 6
    ExtendKind.Sxtx => 7
    _ => CompilerBug.panic(b"AArch64Encode: register-offset load/store extend must be Uxtw, Uxtx, Sxtw, or Sxtx")
  }
}

fn pairModeBits(mode: PairMode) -> u32 {
  return match mode {
    PairMode.PostIndex => 1
    PairMode.SignedOffset => 2
    PairMode.PreIndex => 3
  }
}

fn widthSizeCode(widthBytes: usize) -> u32 {
  if widthBytes == 8 { return 3 }
  if widthBytes == 4 { return 2 }
  if widthBytes == 2 { return 1 }
  return 0
}

// Branch range checks & relocation/branch patch helpers.

/// Whether a branch from `at` to `targetOffset` fits in an unconditional `b`/`bl` `imm26`
/// signed 4-byte word offset (`[-134217728, 134217724]`, 4-byte aligned).
pub fn fitsB26(at: usize, targetOffset: usize) -> bool {
  let delta = usize.toI64(targetOffset) - usize.toI64(at)
  return (delta & 3) == 0 && delta >= -134217728 && delta <= 134217724
}

/// Whether a branch from `at` to `targetOffset` fits in a `b.cond` / `cbz` / `cbnz` `imm19`
/// signed 4-byte word offset (`[-1048576, 1048572]`, 4-byte aligned).
pub fn fitsImm19(at: usize, targetOffset: usize) -> bool {
  let delta = usize.toI64(targetOffset) - usize.toI64(at)
  return (delta & 3) == 0 && delta >= -1048576 && delta <= 1048572
}

/// Whether a branch from `at` to `targetOffset` fits in a `tbz` / `tbnz` `imm14` signed
/// 4-byte word offset (`[-32768, 32764]`, 4-byte aligned).
pub fn fitsImm14(at: usize, targetOffset: usize) -> bool {
  let delta = usize.toI64(targetOffset) - usize.toI64(at)
  return (delta & 3) == 0 && delta >= -32768 && delta <= 32764
}

/// Whether an `adr` byte delta from `at` to `targetOffset` fits in signed 21 bits (`[-1048576, 1048575]`).
pub fn fitsAdr21(at: usize, targetOffset: usize) -> bool {
  let delta = usize.toI64(targetOffset) - usize.toI64(at)
  return delta >= -1048576 && delta <= 1048575
}

/// Patches a `b` or `bl` instruction at `at` to branch to `targetOffset`.
pub fn patchB26(out: &mut Bytes, at: usize, targetOffset: usize) -> () {
  let orig = readU32(&out.*, at)
  let delta = usize.toI64(targetOffset) - usize.toI64(at)
  let imm26 = i64.wrappingToU32(i64.shiftRight(delta, 2)) & 0x03FFFFFF
  let word = (orig & 0xFC000000) | imm26
  patchU32(&mut out.*, at, u32.toU64(word))
}

/// Patches a `b.cond` instruction at `at` to branch to `targetOffset`.
pub fn patchBCond19(out: &mut Bytes, at: usize, targetOffset: usize) -> () {
  let orig = readU32(&out.*, at)
  let delta = usize.toI64(targetOffset) - usize.toI64(at)
  let imm19 = i64.wrappingToU32(i64.shiftRight(delta, 2)) & 0x7FFFF
  let word = (orig & 0xFF00001F) | u32.shiftLeft(imm19, 5)
  patchU32(&mut out.*, at, u32.toU64(word))
}

/// Patches a `cbz` or `cbnz` instruction at `at` to branch to `targetOffset`.
pub fn patchCbz19(out: &mut Bytes, at: usize, targetOffset: usize) -> () {
  patchBCond19(&mut out.*, at, targetOffset)
}

/// Patches a `tbz` or `tbnz` instruction at `at` to branch to `targetOffset`.
pub fn patchTbz14(out: &mut Bytes, at: usize, targetOffset: usize) -> () {
  let orig = readU32(&out.*, at)
  let delta = usize.toI64(targetOffset) - usize.toI64(at)
  let imm14 = i64.wrappingToU32(i64.shiftRight(delta, 2)) & 0x3FFF
  let word = (orig & 0xFFF8001F) | u32.shiftLeft(imm14, 5)
  patchU32(&mut out.*, at, u32.toU64(word))
}

/// Patches an `adr` instruction at `at` to compute the address of `targetOffset`.
pub fn patchAdr21(out: &mut Bytes, at: usize, targetOffset: usize) -> () {
  let orig = readU32(&out.*, at)
  let delta = i64.wrappingToU32(usize.toI64(targetOffset) - usize.toI64(at))
  let immlo = delta & 3
  let immhi = u32.shiftRight(delta, 2) & 0x7FFFF
  let word = (orig & 0x9F00001F) | u32.shiftLeft(immlo, 29) | u32.shiftLeft(immhi, 5)
  patchU32(&mut out.*, at, u32.toU64(word))
}

/// Patches an `adrp` instruction at `at` using a signed 4 KB page delta `pageDelta`.
pub fn patchAdrp21Pages(out: &mut Bytes, at: usize, pageDelta: i64) -> () {
  let orig = readU32(&out.*, at)
  let raw = i64.wrappingToU32(pageDelta)
  let immlo = raw & 3
  let immhi = u32.shiftRight(raw, 2) & 0x7FFFF
  let word = (orig & 0x9F00001F) | u32.shiftLeft(immlo, 29) | u32.shiftLeft(immhi, 5)
  patchU32(&mut out.*, at, u32.toU64(word))
}

/// Patches an `adrp` instruction at `at` from its virtual address `instrVa` to `targetVa`'s 4 KB page.
pub fn patchAdrp21(out: &mut Bytes, at: usize, instrVa: u64, targetVa: u64) -> () {
  let instrPage = u64.wrappingToI64(u64.shiftRight(instrVa, 12))
  let targetPage = u64.wrappingToI64(u64.shiftRight(targetVa, 12))
  patchAdrp21Pages(&mut out.*, at, targetPage - instrPage)
}

/// Patches an `add (immediate)` instruction at `at` with the 12-bit page offset of `targetVaOrPageOff`.
pub fn patchAdd12(out: &mut Bytes, at: usize, targetVaOrPageOff: u64) -> () {
  let orig = readU32(&out.*, at)
  let imm12 = u64.wrappingToU32(targetVaOrPageOff & 0xFFF)
  let word = (orig & 0xFFC003FF) | u32.shiftLeft(imm12, 10)
  patchU32(&mut out.*, at, u32.toU64(word))
}

/// Patches an unsigned-immediate `ldr` or `str` (GPR or FP/SIMD, including 16-byte `Q` register
/// accesses) at `at` with the scaled 12-bit page offset of `targetVaOrPageOff`.
pub fn patchLdrSt12(out: &mut Bytes, at: usize, targetVaOrPageOff: u64) -> () {
  let orig = readU32(&out.*, at)
  let size = u32.shiftRight(orig, 30) & 3
  let v = u32.shiftRight(orig, 26) & 1
  let opc = u32.shiftRight(orig, 22) & 3
  let mut scaleShift = size
  if v == 1 && size == 0 && (opc & 2) != 0 {
    scaleShift = 4
  }
  let pageOff = u64.wrappingToU32(targetVaOrPageOff & 0xFFF)
  let imm12 = u32.shiftRight(pageOff, scaleShift) & 0xFFF
  let word = (orig & 0xFFC003FF) | u32.shiftLeft(imm12, 10)
  patchU32(&mut out.*, at, u32.toU64(word))
}

// ---- Control & System Instructions ----

/// `nop`.
pub effect fn nop(out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0xD503201F)
}

/// `yield`.
pub effect fn yieldHint(out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0xD503203F)
}

/// `ret` (returns to `x30` / `lr`).
pub effect fn ret(out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0xD65F03C0)
}

/// `ret reg`.
pub effect fn retReg(out: &mut Bytes, reg: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0xD65F0000 | u32.shiftLeft(r5(reg), 5))
}

/// `brk #imm16`.
pub effect fn brk(out: &mut Bytes, imm16: u16) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0xD4200000 | u32.shiftLeft(u16.toU32(imm16), 5))
}

/// `svc #imm16`.
pub effect fn svc(out: &mut Bytes, imm16: u16) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0xD4000001 | u32.shiftLeft(u16.toU32(imm16), 5))
}

/// `mrs dst, sysreg` where `sysReg15` encodes `(o0&1)<<14 | op1<<11 | crn<<7 | crm<<3 | op2`.
pub effect fn mrs(out: &mut Bytes, dst: u8, sysReg15: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0xD5300000 | u32.shiftLeft(sysReg15 & 0x7FFF, 5) | r5(dst))
}

/// `b #0` returning the instruction's byte offset in `out` for [`patchB26`] or a `Branch26` relocation.
pub effect fn b(out: &mut Bytes) -> usize ! OutOfMemoryError ? &mut Allocator {
  let at = Bytes.length(&out.*)
  run emitWord(&mut out.*, 0x14000000)
  return at
}

/// `b #byteOff` (signed 4-byte-aligned byte offset within ±128 MB).
pub effect fn bImm(out: &mut Bytes, byteOff: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let imm26 = i32.wrappingToU32(i32.shiftRight(byteOff, 2)) & 0x03FFFFFF
  return run emitWord(&mut out.*, 0x14000000 | imm26)
}

/// `bl #0` returning the instruction's byte offset in `out` for [`patchB26`] or a `Branch26` relocation.
pub effect fn bl(out: &mut Bytes) -> usize ! OutOfMemoryError ? &mut Allocator {
  let at = Bytes.length(&out.*)
  run emitWord(&mut out.*, 0x94000000)
  return at
}

/// `bl #byteOff` (signed 4-byte-aligned byte offset within ±128 MB).
pub effect fn blImm(out: &mut Bytes, byteOff: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let imm26 = i32.wrappingToU32(i32.shiftRight(byteOff, 2)) & 0x03FFFFFF
  return run emitWord(&mut out.*, 0x94000000 | imm26)
}

/// `br reg`.
pub effect fn br(out: &mut Bytes, reg: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0xD61F0000 | u32.shiftLeft(r5(reg), 5))
}

/// `blr reg`.
pub effect fn blr(out: &mut Bytes, reg: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0xD63F0000 | u32.shiftLeft(r5(reg), 5))
}

/// `b.cc #0` returning the instruction's byte offset in `out` for [`patchBCond19`].
pub effect fn bCond(out: &mut Bytes, cc: u8) -> usize ! OutOfMemoryError ? &mut Allocator {
  let at = Bytes.length(&out.*)
  run emitWord(&mut out.*, 0x54000000 | u8.toU32(cc & 15))
  return at
}

/// `b.cc #byteOff` (signed 4-byte-aligned byte offset within ±1 MB).
pub effect fn bCondImm(out: &mut Bytes, cc: u8, byteOff: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let imm19 = i32.wrappingToU32(i32.shiftRight(byteOff, 2)) & 0x7FFFF
  return run emitWord(&mut out.*, 0x54000000 | u32.shiftLeft(imm19, 5) | u8.toU32(cc & 15))
}

/// `cbz reg, #0` returning the instruction's byte offset in `out` for [`patchCbz19`].
pub effect fn cbz(out: &mut Bytes, wide64: bool, reg: u8) -> usize ! OutOfMemoryError ? &mut Allocator {
  let at = Bytes.length(&out.*)
  run emitWord(&mut out.*, sfBit(wide64) | 0x34000000 | r5(reg))
  return at
}

/// `cbz reg, #byteOff`.
pub effect fn cbzImm(out: &mut Bytes, wide64: bool, reg: u8, byteOff: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let imm19 = i32.wrappingToU32(i32.shiftRight(byteOff, 2)) & 0x7FFFF
  return run emitWord(&mut out.*, sfBit(wide64) | 0x34000000 | u32.shiftLeft(imm19, 5) | r5(reg))
}

/// `cbnz reg, #0` returning the instruction's byte offset in `out` for [`patchCbz19`].
pub effect fn cbnz(out: &mut Bytes, wide64: bool, reg: u8) -> usize ! OutOfMemoryError ? &mut Allocator {
  let at = Bytes.length(&out.*)
  run emitWord(&mut out.*, sfBit(wide64) | 0x35000000 | r5(reg))
  return at
}

/// `cbnz reg, #byteOff`.
pub effect fn cbnzImm(out: &mut Bytes, wide64: bool, reg: u8, byteOff: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let imm19 = i32.wrappingToU32(i32.shiftRight(byteOff, 2)) & 0x7FFFF
  return run emitWord(&mut out.*, sfBit(wide64) | 0x35000000 | u32.shiftLeft(imm19, 5) | r5(reg))
}

/// `tbz reg, #bit, #0` returning the instruction's byte offset in `out` for [`patchTbz14`].
pub effect fn tbz(out: &mut Bytes, reg: u8, bit: u8) -> usize ! OutOfMemoryError ? &mut Allocator {
  let at = Bytes.length(&out.*)
  let b5 = u8.toU32(u8.shiftRight(bit, 5) & 1)
  let b40 = u8.toU32(bit & 31)
  run emitWord(&mut out.*, u32.shiftLeft(b5, 31) | 0x36000000 | u32.shiftLeft(b40, 19) | r5(reg))
  return at
}

/// `tbz reg, #bit, #byteOff`.
pub effect fn tbzImm(out: &mut Bytes, reg: u8, bit: u8, byteOff: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let b5 = u8.toU32(u8.shiftRight(bit, 5) & 1)
  let b40 = u8.toU32(bit & 31)
  let imm14 = i32.wrappingToU32(i32.shiftRight(byteOff, 2)) & 0x3FFF
  return run emitWord(&mut out.*, u32.shiftLeft(b5, 31) | 0x36000000 | u32.shiftLeft(b40, 19) | u32.shiftLeft(imm14, 5) | r5(reg))
}

/// `tbnz reg, #bit, #0` returning the instruction's byte offset in `out` for [`patchTbz14`].
pub effect fn tbnz(out: &mut Bytes, reg: u8, bit: u8) -> usize ! OutOfMemoryError ? &mut Allocator {
  let at = Bytes.length(&out.*)
  let b5 = u8.toU32(u8.shiftRight(bit, 5) & 1)
  let b40 = u8.toU32(bit & 31)
  run emitWord(&mut out.*, u32.shiftLeft(b5, 31) | 0x37000000 | u32.shiftLeft(b40, 19) | r5(reg))
  return at
}

/// `tbnz reg, #bit, #byteOff`.
pub effect fn tbnzImm(out: &mut Bytes, reg: u8, bit: u8, byteOff: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let b5 = u8.toU32(u8.shiftRight(bit, 5) & 1)
  let b40 = u8.toU32(bit & 31)
  let imm14 = i32.wrappingToU32(i32.shiftRight(byteOff, 2)) & 0x3FFF
  return run emitWord(&mut out.*, u32.shiftLeft(b5, 31) | 0x37000000 | u32.shiftLeft(b40, 19) | u32.shiftLeft(imm14, 5) | r5(reg))
}

/// `adr dst, #0` returning the instruction's byte offset in `out` for [`patchAdr21`].
pub effect fn adr(out: &mut Bytes, dst: u8) -> usize ! OutOfMemoryError ? &mut Allocator {
  let at = Bytes.length(&out.*)
  run emitWord(&mut out.*, 0x10000000 | r5(dst))
  return at
}

/// `adrp dst, #0` returning the instruction's byte offset in `out` for [`patchAdrp21`] or a `Page21` relocation.
pub effect fn adrp(out: &mut Bytes, dst: u8) -> usize ! OutOfMemoryError ? &mut Allocator {
  let at = Bytes.length(&out.*)
  run emitWord(&mut out.*, 0x90000000 | r5(dst))
  return at
}

// ---- GPR / SP / XZR Data Processing ----

/// `mov xDst, xSrc` via `orr dst, xzr, src` (`31` encodes `xzr`; never use for `sp`).
pub effect fn movRr64(out: &mut Bytes, dst: u8, src: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0xAA0003E0 | u32.shiftLeft(r5(src), 16) | r5(dst))
}

/// `mov wDst, wSrc` via `orr wDst, wzr, wSrc` (`31` encodes `wzr`; never use for `wsp`).
pub effect fn movRr32(out: &mut Bytes, dst: u8, src: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x2A0003E0 | u32.shiftLeft(r5(src), 16) | r5(dst))
}

/// `mov xDst, xSrc` via `add dst, src, #0` (`31` encodes `sp`, suitable for `mov fp, sp` and `mov sp, xN`).
pub effect fn movSp64(out: &mut Bytes, dst: u8, src: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x91000000 | u32.shiftLeft(r5(src), 5) | r5(dst))
}

/// `mov wDst, wSrc` via `add wDst, wSrc, #0` (`31` encodes `wsp`).
pub effect fn movSp32(out: &mut Bytes, dst: u8, src: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x11000000 | u32.shiftLeft(r5(src), 5) | r5(dst))
}

/// `movz dst, #imm16, lsl #shift` (`shift` in `{0, 16, 32, 48}` for 64-bit, `{0, 16}` for 32-bit).
pub effect fn movz(out: &mut Bytes, wide64: bool, dst: u8, imm16: u16, shift: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let hw = u8.toU32(u8.shiftRight(shift, 4) & 3)
  return run emitWord(&mut out.*, sfBit(wide64) | 0x52800000 | u32.shiftLeft(hw, 21) | u32.shiftLeft(u16.toU32(imm16), 5) | r5(dst))
}

/// `movn dst, #imm16, lsl #shift`.
pub effect fn movn(out: &mut Bytes, wide64: bool, dst: u8, imm16: u16, shift: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let hw = u8.toU32(u8.shiftRight(shift, 4) & 3)
  return run emitWord(&mut out.*, sfBit(wide64) | 0x12800000 | u32.shiftLeft(hw, 21) | u32.shiftLeft(u16.toU32(imm16), 5) | r5(dst))
}

/// `movk dst, #imm16, lsl #shift`.
pub effect fn movk(out: &mut Bytes, wide64: bool, dst: u8, imm16: u16, shift: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let hw = u8.toU32(u8.shiftRight(shift, 4) & 3)
  return run emitWord(&mut out.*, sfBit(wide64) | 0x72800000 | u32.shiftLeft(hw, 21) | u32.shiftLeft(u16.toU32(imm16), 5) | r5(dst))
}

/// Encodes an AArch64 logical bitmask immediate `(N << 12) | (immr << 6) | imms` for 32-bit or
/// 64-bit `and`/`orr`/`eor`/`ands` instructions, or `None` when `value` is not a valid bitmask.
pub fn encodeLogicalImm(wide64: bool, value: u64) -> Option<u32> {
  let mut v = value
  if !wide64 {
    let low32 = value & 0xFFFFFFFF
    if low32 == 0 || low32 == 0xFFFFFFFF { return Option<u32>.none() }
    v = low32 | u64.shiftLeft(low32, 32)
  } else {
    if value == 0 || value == u64.MAX { return Option<u32>.none() }
  }
  let mut esize: u64 = 2
  while esize < 64 {
    if u64.rotateRight(v, esize) == v { break }
    esize = esize * 2
  }
  if !wide64 && esize > 32 { return Option<u32>.none() }
  let elemMask = if esize == 64 { u64.MAX } else { u64.shiftLeft(1, esize) - 1 }
  let elem = v & elemMask
  let mut ones: u64 = 0
  let mut immr: u64 = 0
  if (elem & 1) == 0 {
    let tz = u32.toU64(u64.trailingZeros(elem))
    let shifted = u64.shiftRight(elem, tz)
    if (shifted & (shifted + 1)) != 0 { return Option<u32>.none() }
    ones = u32.toU64(u64.countOnes(shifted))
    immr = esize - tz
  } else {
    let inv = u64.bitAnd(u64.bitNot(elem), elemMask)
    let tz0 = u32.toU64(u64.trailingZeros(inv))
    let shiftedInv = u64.shiftRight(inv, tz0)
    if (shiftedInv & (shiftedInv + 1)) != 0 { return Option<u32>.none() }
    ones = esize - u32.toU64(u64.countOnes(inv))
    immr = ones - tz0
  }
  if ones == 0 || ones >= esize { return Option<u32>.none() }
  let nBit: u32 = if esize == 64 { 1 } else { 0 }
  let immsPrefix = u64.wrappingToU32(u64.shiftLeft(u64.bitNot(esize - 1), 1)) & 0x3F
  let imms = immsPrefix | (u64.wrappingToU32(ones - 1) & 0x3F)
  let immrField = u64.wrappingToU32(immr) & 0x3F
  return Option<u32>.some(u32.shiftLeft(nBit, 12) | u32.shiftLeft(immrField, 6) | imms)
}

/// Materializes an arbitrary 64-bit constant into `dst` using the fewest instructions (`movz`,
/// `movn`, logical `orr`, or `movz`/`movn` + `movk`).
pub effect fn movImm64(out: &mut Bytes, dst: u8, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  if value == 0 {
    return run movz(&mut out.*, true, dst, 0, 0)
  }
  // Check single-chunk movz.
  let c0 = u64.wrappingToU16(value & 0xFFFF)
  let c1 = u64.wrappingToU16(u64.shiftRight(value, 16) & 0xFFFF)
  let c2 = u64.wrappingToU16(u64.shiftRight(value, 32) & 0xFFFF)
  let c3 = u64.wrappingToU16(u64.shiftRight(value, 48) & 0xFFFF)
  let inv = u64.bitNot(value)
  let n0 = u64.wrappingToU16(inv & 0xFFFF)
  let n1 = u64.wrappingToU16(u64.shiftRight(inv, 16) & 0xFFFF)
  let n2 = u64.wrappingToU16(u64.shiftRight(inv, 32) & 0xFFFF)
  let n3 = u64.wrappingToU16(u64.shiftRight(inv, 48) & 0xFFFF)
  let mut zeroChunks: u32 = 0
  if c0 == 0 { zeroChunks = zeroChunks + 1 }
  if c1 == 0 { zeroChunks = zeroChunks + 1 }
  if c2 == 0 { zeroChunks = zeroChunks + 1 }
  if c3 == 0 { zeroChunks = zeroChunks + 1 }
  let mut onesChunks: u32 = 0
  if c0 == 0xFFFF { onesChunks = onesChunks + 1 }
  if c1 == 0xFFFF { onesChunks = onesChunks + 1 }
  if c2 == 0xFFFF { onesChunks = onesChunks + 1 }
  if c3 == 0xFFFF { onesChunks = onesChunks + 1 }
  if zeroChunks == 3 {
    if c0 != 0 { return run movz(&mut out.*, true, dst, c0, 0) }
    if c1 != 0 { return run movz(&mut out.*, true, dst, c1, 16) }
    if c2 != 0 { return run movz(&mut out.*, true, dst, c2, 32) }
    return run movz(&mut out.*, true, dst, c3, 48)
  }
  if onesChunks >= 3 {
    if n0 != 0 { return run movn(&mut out.*, true, dst, n0, 0) }
    if n1 != 0 { return run movn(&mut out.*, true, dst, n1, 16) }
    if n2 != 0 { return run movn(&mut out.*, true, dst, n2, 32) }
    return run movn(&mut out.*, true, dst, n3, 48)
  }
  if let Option<u32>.Some {value: imm13} = encodeLogicalImm(true, value) {
    return run orrImmEncoded(&mut out.*, true, dst, xzr(), imm13)
  }
  let chunks = [c0, c1, c2, c3]
  let invChunks = [n0, n1, n2, n3]
  let shifts: [u8; 4] = [0, 16, 32, 48]
  let useMovn = onesChunks > zeroChunks
  let mut emittedFirst = false
  let mut idx = usize.ZERO
  while idx < 4 {
    let chunk = chunks[idx]
    let skip = if useMovn { chunk == 0xFFFF } else { chunk == 0 }
    if !skip {
      if !emittedFirst {
        if useMovn {
          run movn(&mut out.*, true, dst, invChunks[idx], shifts[idx])
        } else {
          run movz(&mut out.*, true, dst, chunk, shifts[idx])
        }
        emittedFirst = true
      } else {
        run movk(&mut out.*, true, dst, chunk, shifts[idx])
      }
    }
    idx = idx + usize.ONE
  }
  return ()
}

/// Materializes an unsigned 32-bit constant into `wDst` (zeroing the upper 32 bits).
pub effect fn movImm32(out: &mut Bytes, dst: u8, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let low32 = value & 0xFFFFFFFF
  if low32 == 0 { return run movz(&mut out.*, false, dst, 0, 0) }
  let c0 = u64.wrappingToU16(low32 & 0xFFFF)
  let c1 = u64.wrappingToU16(u64.shiftRight(low32, 16) & 0xFFFF)
  if c1 == 0 { return run movz(&mut out.*, false, dst, c0, 0) }
  if c0 == 0 { return run movz(&mut out.*, false, dst, c1, 16) }
  let inv32 = u64.bitAnd(u64.bitNot(low32), 0xFFFFFFFF)
  let n0 = u64.wrappingToU16(inv32 & 0xFFFF)
  let n1 = u64.wrappingToU16(u64.shiftRight(inv32, 16) & 0xFFFF)
  if c1 == 0xFFFF { return run movn(&mut out.*, false, dst, n0, 0) }
  if c0 == 0xFFFF { return run movn(&mut out.*, false, dst, n1, 16) }
  if let Option<u32>.Some {value: imm13} = encodeLogicalImm(false, low32) {
    return run orrImmEncoded(&mut out.*, false, dst, xzr(), imm13)
  }
  run movz(&mut out.*, false, dst, c0, 0)
  return run movk(&mut out.*, false, dst, c1, 16)
}

/// `add dst, src, #imm12` (`lsl #12` when `shift12` is true; `31` encodes `sp`).
pub effect fn addImm(out: &mut Bytes, wide64: bool, dst: u8, src: u8, imm12: u16, shift12: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let sh: u32 = if shift12 { 1 } else { 0 }
  return run emitWord(&mut out.*, sfBit(wide64) | 0x11000000 | u32.shiftLeft(sh, 22) | u32.shiftLeft(u16.toU32(imm12) & 0xFFF, 10) | u32.shiftLeft(r5(src), 5) | r5(dst))
}

/// `adds dst, src, #imm12` (`src=31` is `sp`; `dst=31` is `xzr`).
pub effect fn addsImm(out: &mut Bytes, wide64: bool, dst: u8, src: u8, imm12: u16, shift12: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let sh: u32 = if shift12 { 1 } else { 0 }
  return run emitWord(&mut out.*, sfBit(wide64) | 0x31000000 | u32.shiftLeft(sh, 22) | u32.shiftLeft(u16.toU32(imm12) & 0xFFF, 10) | u32.shiftLeft(r5(src), 5) | r5(dst))
}

/// `sub dst, src, #imm12` (`lsl #12` when `shift12` is true; `31` encodes `sp`).
pub effect fn subImm(out: &mut Bytes, wide64: bool, dst: u8, src: u8, imm12: u16, shift12: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let sh: u32 = if shift12 { 1 } else { 0 }
  return run emitWord(&mut out.*, sfBit(wide64) | 0x51000000 | u32.shiftLeft(sh, 22) | u32.shiftLeft(u16.toU32(imm12) & 0xFFF, 10) | u32.shiftLeft(r5(src), 5) | r5(dst))
}

/// `subs dst, src, #imm12` (`src=31` is `sp`; `dst=31` is `xzr`).
pub effect fn subsImm(out: &mut Bytes, wide64: bool, dst: u8, src: u8, imm12: u16, shift12: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let sh: u32 = if shift12 { 1 } else { 0 }
  return run emitWord(&mut out.*, sfBit(wide64) | 0x71000000 | u32.shiftLeft(sh, 22) | u32.shiftLeft(u16.toU32(imm12) & 0xFFF, 10) | u32.shiftLeft(r5(src), 5) | r5(dst))
}

/// `cmp left, #imm12` (`subs xzr, left, #imm12`).
pub effect fn cmpImm(out: &mut Bytes, wide64: bool, left: u8, imm12: u16, shift12: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  return run subsImm(&mut out.*, wide64, xzr(), left, imm12, shift12)
}

/// `cmn left, #imm12` (`adds xzr, left, #imm12`).
pub effect fn cmnImm(out: &mut Bytes, wide64: bool, left: u8, imm12: u16, shift12: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  return run addsImm(&mut out.*, wide64, xzr(), left, imm12, shift12)
}

/// `add dst, left, right, shift #amount` (`31` encodes `xzr`; `shift` in `{Lsl, Lsr, Asr}`, never `Ror`; `amount` in `0..63` when `wide64`, `0..31` when `!wide64`).
pub effect fn addReg(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8, shift: ShiftKind, amount: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x0B000000 | u32.shiftLeft(shiftCode(shift), 22) | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(u8.toU32(amount & 63), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `adds dst, left, right, shift #amount` (`left` `31` and `dst` `31` encode `xzr`; `shift` in `{Lsl, Lsr, Asr}`, never `Ror`; `amount` in `0..63` when `wide64`, `0..31` when `!wide64`).
pub effect fn addsReg(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8, shift: ShiftKind, amount: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x2B000000 | u32.shiftLeft(shiftCode(shift), 22) | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(u8.toU32(amount & 63), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `sub dst, left, right, shift #amount` (`31` encodes `xzr`; `shift` in `{Lsl, Lsr, Asr}`, never `Ror`; `amount` in `0..63` when `wide64`, `0..31` when `!wide64`).
pub effect fn subReg(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8, shift: ShiftKind, amount: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x4B000000 | u32.shiftLeft(shiftCode(shift), 22) | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(u8.toU32(amount & 63), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `subs dst, left, right, shift #amount` (`left` `31` and `dst` `31` encode `xzr`; `shift` in `{Lsl, Lsr, Asr}`, never `Ror`; `amount` in `0..63` when `wide64`, `0..31` when `!wide64`).
pub effect fn subsReg(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8, shift: ShiftKind, amount: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x6B000000 | u32.shiftLeft(shiftCode(shift), 22) | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(u8.toU32(amount & 63), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `add dst, left, right, extend #amount` (`dst` and `left` `31` encode `sp`; `amount` in `0..4`).
pub effect fn addExt(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8, extend: ExtendKind, amount: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x0B200000 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(extendCode(extend), 13) | u32.shiftLeft(u8.toU32(amount & 7), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `adds dst, left, right, extend #amount` (`left` `31` is `sp`; `dst` `31` is `xzr`; `amount` in `0..4`).
pub effect fn addsExt(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8, extend: ExtendKind, amount: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x2B200000 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(extendCode(extend), 13) | u32.shiftLeft(u8.toU32(amount & 7), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `sub dst, left, right, extend #amount` (`dst` and `left` `31` encode `sp`; `amount` in `0..4`).
pub effect fn subExt(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8, extend: ExtendKind, amount: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x4B200000 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(extendCode(extend), 13) | u32.shiftLeft(u8.toU32(amount & 7), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `subs dst, left, right, extend #amount` (`left` `31` is `sp`; `dst` `31` is `xzr`; `amount` in `0..4`).
pub effect fn subsExt(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8, extend: ExtendKind, amount: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x6B200000 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(extendCode(extend), 13) | u32.shiftLeft(u8.toU32(amount & 7), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `cmp left, right` (`subs xzr, left, right`).
pub effect fn cmpReg(out: &mut Bytes, wide64: bool, left: u8, right: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run subsReg(&mut out.*, wide64, xzr(), left, right, ShiftKind.Lsl, 0)
}

/// `cmn left, right` (`adds xzr, left, right`).
pub effect fn cmnReg(out: &mut Bytes, wide64: bool, left: u8, right: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run addsReg(&mut out.*, wide64, xzr(), left, right, ShiftKind.Lsl, 0)
}

/// `neg dst, src` (`sub dst, xzr, src`).
pub effect fn negReg(out: &mut Bytes, wide64: bool, dst: u8, src: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run subReg(&mut out.*, wide64, dst, xzr(), src, ShiftKind.Lsl, 0)
}

/// `negs dst, src` (`subs dst, xzr, src`).
pub effect fn negsReg(out: &mut Bytes, wide64: bool, dst: u8, src: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run subsReg(&mut out.*, wide64, dst, xzr(), src, ShiftKind.Lsl, 0)
}

/// `adc dst, left, right`.
pub effect fn adc(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x1A000000 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `adcs dst, left, right`.
pub effect fn adcs(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x3A000000 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `sbc dst, left, right`.
pub effect fn sbc(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x5A000000 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `sbcs dst, left, right`.
pub effect fn sbcs(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x7A000000 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

// Logical shifted register.

/// `and dst, left, right, shift #amount`.
pub effect fn andReg(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8, shift: ShiftKind, amount: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x0A000000 | u32.shiftLeft(shiftCode(shift), 22) | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(u8.toU32(amount & 63), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `bic dst, left, right, shift #amount` (`left & ~right`).
pub effect fn bicReg(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8, shift: ShiftKind, amount: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x0A200000 | u32.shiftLeft(shiftCode(shift), 22) | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(u8.toU32(amount & 63), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `orr dst, left, right, shift #amount`.
pub effect fn orrReg(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8, shift: ShiftKind, amount: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x2A000000 | u32.shiftLeft(shiftCode(shift), 22) | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(u8.toU32(amount & 63), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `orn dst, left, right, shift #amount` (`left | ~right`).
pub effect fn ornReg(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8, shift: ShiftKind, amount: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x2A200000 | u32.shiftLeft(shiftCode(shift), 22) | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(u8.toU32(amount & 63), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `eor dst, left, right, shift #amount`.
pub effect fn eorReg(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8, shift: ShiftKind, amount: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x4A000000 | u32.shiftLeft(shiftCode(shift), 22) | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(u8.toU32(amount & 63), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `eon dst, left, right, shift #amount` (`left ^ ~right`).
pub effect fn eonReg(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8, shift: ShiftKind, amount: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x4A200000 | u32.shiftLeft(shiftCode(shift), 22) | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(u8.toU32(amount & 63), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `ands dst, left, right, shift #amount`.
pub effect fn andsReg(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8, shift: ShiftKind, amount: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x6A000000 | u32.shiftLeft(shiftCode(shift), 22) | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(u8.toU32(amount & 63), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `bics dst, left, right, shift #amount`.
pub effect fn bicsReg(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8, shift: ShiftKind, amount: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x6A200000 | u32.shiftLeft(shiftCode(shift), 22) | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(u8.toU32(amount & 63), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `mvn dst, src` (`orn dst, xzr, src`).
pub effect fn mvnReg(out: &mut Bytes, wide64: bool, dst: u8, src: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run ornReg(&mut out.*, wide64, dst, xzr(), src, ShiftKind.Lsl, 0)
}

/// `tst left, right` (`ands xzr, left, right`).
pub effect fn tstReg(out: &mut Bytes, wide64: bool, left: u8, right: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run andsReg(&mut out.*, wide64, xzr(), left, right, ShiftKind.Lsl, 0)
}

// Logical bitmask immediates.

/// `and dst, src, #imm13` using pre-encoded 13-bit `(N:immr:imms)` from [`encodeLogicalImm`].
pub effect fn andImmEncoded(out: &mut Bytes, wide64: bool, dst: u8, src: u8, imm13: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x12000000 | u32.shiftLeft(imm13 & 0x1FFF, 10) | u32.shiftLeft(r5(src), 5) | r5(dst))
}

/// `orr dst, src, #imm13` using pre-encoded 13-bit `(N:immr:imms)` from [`encodeLogicalImm`].
pub effect fn orrImmEncoded(out: &mut Bytes, wide64: bool, dst: u8, src: u8, imm13: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x32000000 | u32.shiftLeft(imm13 & 0x1FFF, 10) | u32.shiftLeft(r5(src), 5) | r5(dst))
}

/// `eor dst, src, #imm13` using pre-encoded 13-bit `(N:immr:imms)` from [`encodeLogicalImm`].
pub effect fn eorImmEncoded(out: &mut Bytes, wide64: bool, dst: u8, src: u8, imm13: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x52000000 | u32.shiftLeft(imm13 & 0x1FFF, 10) | u32.shiftLeft(r5(src), 5) | r5(dst))
}

/// `ands dst, src, #imm13` using pre-encoded 13-bit `(N:immr:imms)` from [`encodeLogicalImm`].
pub effect fn andsImmEncoded(out: &mut Bytes, wide64: bool, dst: u8, src: u8, imm13: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x72000000 | u32.shiftLeft(imm13 & 0x1FFF, 10) | u32.shiftLeft(r5(src), 5) | r5(dst))
}

/// Emits `and dst, src, #value` and returns `true` if `value` is a valid logical bitmask immediate.
pub effect fn tryAndImm(out: &mut Bytes, wide64: bool, dst: u8, src: u8, value: u64) -> bool ! OutOfMemoryError ? &mut Allocator {
  if let Option<u32>.Some {value: imm13} = encodeLogicalImm(wide64, value) {
    run andImmEncoded(&mut out.*, wide64, dst, src, imm13)
    return true
  }
  return false
}

/// Emits `orr dst, src, #value` and returns `true` if `value` is a valid logical bitmask immediate.
pub effect fn tryOrrImm(out: &mut Bytes, wide64: bool, dst: u8, src: u8, value: u64) -> bool ! OutOfMemoryError ? &mut Allocator {
  if let Option<u32>.Some {value: imm13} = encodeLogicalImm(wide64, value) {
    run orrImmEncoded(&mut out.*, wide64, dst, src, imm13)
    return true
  }
  return false
}

/// Emits `eor dst, src, #value` and returns `true` if `value` is a valid logical bitmask immediate.
pub effect fn tryEorImm(out: &mut Bytes, wide64: bool, dst: u8, src: u8, value: u64) -> bool ! OutOfMemoryError ? &mut Allocator {
  if let Option<u32>.Some {value: imm13} = encodeLogicalImm(wide64, value) {
    run eorImmEncoded(&mut out.*, wide64, dst, src, imm13)
    return true
  }
  return false
}

/// Emits `tst src, #value` and returns `true` if `value` is a valid logical bitmask immediate.
pub effect fn tryTstImm(out: &mut Bytes, wide64: bool, src: u8, value: u64) -> bool ! OutOfMemoryError ? &mut Allocator {
  if let Option<u32>.Some {value: imm13} = encodeLogicalImm(wide64, value) {
    run andsImmEncoded(&mut out.*, wide64, xzr(), src, imm13)
    return true
  }
  return false
}

// Shifts, bitfield & extract.

/// `lsl dst, left, right` (`lslv`).
pub effect fn lslv(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x1AC02000 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `lsr dst, left, right` (`lsrv`).
pub effect fn lsrv(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x1AC02400 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `asr dst, left, right` (`asrv`).
pub effect fn asrv(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x1AC02800 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `ror dst, left, right` (`rorv`).
pub effect fn rorv(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x1AC02C00 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `sbfm dst, src, #immr, #imms`.
pub effect fn sbfm(out: &mut Bytes, wide64: bool, dst: u8, src: u8, immr: u8, imms: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let nBit: u32 = if wide64 { 1 } else { 0 }
  return run emitWord(&mut out.*, sfBit(wide64) | 0x13000000 | u32.shiftLeft(nBit, 22) | u32.shiftLeft(u8.toU32(immr & 63), 16) | u32.shiftLeft(u8.toU32(imms & 63), 10) | u32.shiftLeft(r5(src), 5) | r5(dst))
}

/// `bfm dst, src, #immr, #imms`.
pub effect fn bfm(out: &mut Bytes, wide64: bool, dst: u8, src: u8, immr: u8, imms: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let nBit: u32 = if wide64 { 1 } else { 0 }
  return run emitWord(&mut out.*, sfBit(wide64) | 0x33000000 | u32.shiftLeft(nBit, 22) | u32.shiftLeft(u8.toU32(immr & 63), 16) | u32.shiftLeft(u8.toU32(imms & 63), 10) | u32.shiftLeft(r5(src), 5) | r5(dst))
}

/// `ubfm dst, src, #immr, #imms`.
pub effect fn ubfm(out: &mut Bytes, wide64: bool, dst: u8, src: u8, immr: u8, imms: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let nBit: u32 = if wide64 { 1 } else { 0 }
  return run emitWord(&mut out.*, sfBit(wide64) | 0x53000000 | u32.shiftLeft(nBit, 22) | u32.shiftLeft(u8.toU32(immr & 63), 16) | u32.shiftLeft(u8.toU32(imms & 63), 10) | u32.shiftLeft(r5(src), 5) | r5(dst))
}

/// `extr dst, high, low, #lsb`.
pub effect fn extr(out: &mut Bytes, wide64: bool, dst: u8, high: u8, low: u8, lsb: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let nBit: u32 = if wide64 { 1 } else { 0 }
  return run emitWord(&mut out.*, sfBit(wide64) | 0x13800000 | u32.shiftLeft(nBit, 22) | u32.shiftLeft(r5(low), 16) | u32.shiftLeft(u8.toU32(lsb & 63), 10) | u32.shiftLeft(r5(high), 5) | r5(dst))
}

/// `lsl dst, src, #shift` (`shift` masked to `0..63` for 64-bit, `0..31` for 32-bit).
pub effect fn lslImm(out: &mut Bytes, wide64: bool, dst: u8, src: u8, shift: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let width: u8 = if wide64 { 64 } else { 32 }
  let amt = shift & (width - 1)
  if amt == 0 { return run ubfm(&mut out.*, wide64, dst, src, 0, width - 1) }
  return run ubfm(&mut out.*, wide64, dst, src, width - amt, width - 1 - amt)
}

/// `lsr dst, src, #shift`.
pub effect fn lsrImm(out: &mut Bytes, wide64: bool, dst: u8, src: u8, shift: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let width: u8 = if wide64 { 64 } else { 32 }
  let amt = shift & (width - 1)
  return run ubfm(&mut out.*, wide64, dst, src, amt, width - 1)
}

/// `asr dst, src, #shift`.
pub effect fn asrImm(out: &mut Bytes, wide64: bool, dst: u8, src: u8, shift: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let width: u8 = if wide64 { 64 } else { 32 }
  let amt = shift & (width - 1)
  return run sbfm(&mut out.*, wide64, dst, src, amt, width - 1)
}

/// `ror dst, src, #shift`.
pub effect fn rorImm(out: &mut Bytes, wide64: bool, dst: u8, src: u8, shift: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let width: u8 = if wide64 { 64 } else { 32 }
  let amt = shift & (width - 1)
  return run extr(&mut out.*, wide64, dst, src, src, amt)
}

/// `sxtb dst, wSrc`.
pub effect fn sxtb(out: &mut Bytes, wide64: bool, dst: u8, src: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run sbfm(&mut out.*, wide64, dst, src, 0, 7)
}

/// `sxth dst, wSrc`.
pub effect fn sxth(out: &mut Bytes, wide64: bool, dst: u8, src: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run sbfm(&mut out.*, wide64, dst, src, 0, 15)
}

/// `sxtw xDst, wSrc`.
pub effect fn sxtw(out: &mut Bytes, dst: u8, src: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run sbfm(&mut out.*, true, dst, src, 0, 31)
}

/// `uxtb wDst, wSrc`.
pub effect fn uxtb(out: &mut Bytes, dst: u8, src: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run ubfm(&mut out.*, false, dst, src, 0, 7)
}

/// `uxth wDst, wSrc`.
pub effect fn uxth(out: &mut Bytes, dst: u8, src: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run ubfm(&mut out.*, false, dst, src, 0, 15)
}

// Multiply, divide, conditional select & bit operations.

/// `madd dst, left, right, acc` (`dst = acc + left * right`).
pub effect fn madd(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8, acc: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x1B000000 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(r5(acc), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `msub dst, left, right, acc` (`dst = acc - left * right`).
pub effect fn msub(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8, acc: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x1B008000 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(r5(acc), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `mul dst, left, right` (`madd dst, left, right, xzr`).
pub effect fn mul(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run madd(&mut out.*, wide64, dst, left, right, xzr())
}

/// `smaddl xDst, wLeft, wRight, xAcc`.
pub effect fn smaddl(out: &mut Bytes, dst: u8, left: u8, right: u8, acc: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x9B200000 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(r5(acc), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `smull xDst, wLeft, wRight`.
pub effect fn smull(out: &mut Bytes, dst: u8, left: u8, right: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run smaddl(&mut out.*, dst, left, right, xzr())
}

/// `umaddl xDst, wLeft, wRight, xAcc`.
pub effect fn umaddl(out: &mut Bytes, dst: u8, left: u8, right: u8, acc: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x9BA00000 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(r5(acc), 10) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `umull xDst, wLeft, wRight`.
pub effect fn umull(out: &mut Bytes, dst: u8, left: u8, right: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run umaddl(&mut out.*, dst, left, right, xzr())
}

/// `smulh xDst, xLeft, xRight` (high 64 bits of signed 64x64->128 multiply).
pub effect fn smulh(out: &mut Bytes, dst: u8, left: u8, right: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x9B407C00 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `umulh xDst, xLeft, xRight` (high 64 bits of unsigned 64x64->128 multiply).
pub effect fn umulh(out: &mut Bytes, dst: u8, left: u8, right: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x9BC07C00 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `udiv dst, left, right`.
pub effect fn udiv(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x1AC00800 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `sdiv dst, left, right`.
pub effect fn sdiv(out: &mut Bytes, wide64: bool, dst: u8, left: u8, right: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x1AC00C00 | u32.shiftLeft(r5(right), 16) | u32.shiftLeft(r5(left), 5) | r5(dst))
}

/// `csel dst, onTrue, onFalse, cc`.
pub effect fn csel(out: &mut Bytes, wide64: bool, dst: u8, onTrue: u8, onFalse: u8, cc: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x1A800000 | u32.shiftLeft(r5(onFalse), 16) | u32.shiftLeft(u8.toU32(cc & 15), 12) | u32.shiftLeft(r5(onTrue), 5) | r5(dst))
}

/// `csinc dst, onTrue, onFalse, cc` (`onTrue` if `cc`, else `onFalse + 1`).
pub effect fn csinc(out: &mut Bytes, wide64: bool, dst: u8, onTrue: u8, onFalse: u8, cc: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x1A800400 | u32.shiftLeft(r5(onFalse), 16) | u32.shiftLeft(u8.toU32(cc & 15), 12) | u32.shiftLeft(r5(onTrue), 5) | r5(dst))
}

/// `csinv dst, onTrue, onFalse, cc` (`onTrue` if `cc`, else `~onFalse`).
pub effect fn csinv(out: &mut Bytes, wide64: bool, dst: u8, onTrue: u8, onFalse: u8, cc: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x5A800000 | u32.shiftLeft(r5(onFalse), 16) | u32.shiftLeft(u8.toU32(cc & 15), 12) | u32.shiftLeft(r5(onTrue), 5) | r5(dst))
}

/// `csneg dst, onTrue, onFalse, cc` (`onTrue` if `cc`, else `-onFalse`).
pub effect fn csneg(out: &mut Bytes, wide64: bool, dst: u8, onTrue: u8, onFalse: u8, cc: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x5A800400 | u32.shiftLeft(r5(onFalse), 16) | u32.shiftLeft(u8.toU32(cc & 15), 12) | u32.shiftLeft(r5(onTrue), 5) | r5(dst))
}

/// `cset dst, cc` (`1` if `cc`, else `0`).
pub effect fn cset(out: &mut Bytes, wide64: bool, dst: u8, cc: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run csinc(&mut out.*, wide64, dst, xzr(), xzr(), invertCc(cc))
}

/// `csetm dst, cc` (`-1` if `cc`, else `0`).
pub effect fn csetm(out: &mut Bytes, wide64: bool, dst: u8, cc: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run csinv(&mut out.*, wide64, dst, xzr(), xzr(), invertCc(cc))
}

/// `rbit dst, src`.
pub effect fn rbit(out: &mut Bytes, wide64: bool, dst: u8, src: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x5AC00000 | u32.shiftLeft(r5(src), 5) | r5(dst))
}

/// `rev16 dst, src`.
pub effect fn rev16(out: &mut Bytes, wide64: bool, dst: u8, src: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x5AC00400 | u32.shiftLeft(r5(src), 5) | r5(dst))
}

/// `rev dst, src` (`rev xD, xS` when `wide64`, else `rev wD, wS`).
pub effect fn rev(out: &mut Bytes, wide64: bool, dst: u8, src: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let base: u32 = if wide64 { 0xDAC00C00 } else { 0x5AC00800 }
  return run emitWord(&mut out.*, base | u32.shiftLeft(r5(src), 5) | r5(dst))
}

/// `rev32 xDst, xSrc` (byte-reverse each 32-bit word inside a 64-bit register).
pub effect fn rev32(out: &mut Bytes, dst: u8, src: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0xDAC00800 | u32.shiftLeft(r5(src), 5) | r5(dst))
}

/// `clz dst, src`.
pub effect fn clz(out: &mut Bytes, wide64: bool, dst: u8, src: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x5AC01000 | u32.shiftLeft(r5(src), 5) | r5(dst))
}

/// `cls dst, src`.
pub effect fn cls(out: &mut Bytes, wide64: bool, dst: u8, src: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x5AC01400 | u32.shiftLeft(r5(src), 5) | r5(dst))
}

// ---- Memory, Barriers & Atomics ----

effect fn emitImmMem(out: &mut Bytes, baseOp: u32, scaleShift: u32, rt: u8, base: u8, byteOffset: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let imm12 = u64.wrappingToU32(u64.shiftRight(byteOffset, u32.toU64(scaleShift))) & 0xFFF
  return run emitWord(&mut out.*, baseOp | u32.shiftLeft(imm12, 10) | u32.shiftLeft(r5(base), 5) | r5(rt))
}

/// `ldr xRt, [xBase, #byteOffset]` (8-byte scaled unsigned offset).
pub effect fn ldr64Imm(out: &mut Bytes, rt: u8, base: u8, byteOffset: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitImmMem(&mut out.*, 0xF9400000, 3, rt, base, byteOffset)
}

/// `str xRt, [xBase, #byteOffset]` (8-byte scaled unsigned offset).
pub effect fn str64Imm(out: &mut Bytes, rt: u8, base: u8, byteOffset: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitImmMem(&mut out.*, 0xF9000000, 3, rt, base, byteOffset)
}

/// `ldr wRt, [xBase, #byteOffset]` (4-byte scaled unsigned offset).
pub effect fn ldr32Imm(out: &mut Bytes, rt: u8, base: u8, byteOffset: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitImmMem(&mut out.*, 0xB9400000, 2, rt, base, byteOffset)
}

/// `str wRt, [xBase, #byteOffset]` (4-byte scaled unsigned offset).
pub effect fn str32Imm(out: &mut Bytes, rt: u8, base: u8, byteOffset: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitImmMem(&mut out.*, 0xB9000000, 2, rt, base, byteOffset)
}

/// `ldrh wRt, [xBase, #byteOffset]` (2-byte scaled unsigned offset).
pub effect fn ldrhImm(out: &mut Bytes, rt: u8, base: u8, byteOffset: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitImmMem(&mut out.*, 0x79400000, 1, rt, base, byteOffset)
}

/// `strh wRt, [xBase, #byteOffset]` (2-byte scaled unsigned offset).
pub effect fn strhImm(out: &mut Bytes, rt: u8, base: u8, byteOffset: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitImmMem(&mut out.*, 0x79000000, 1, rt, base, byteOffset)
}

/// `ldrb wRt, [xBase, #byteOffset]`.
pub effect fn ldrbImm(out: &mut Bytes, rt: u8, base: u8, byteOffset: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitImmMem(&mut out.*, 0x39400000, 0, rt, base, byteOffset)
}

/// `strb wRt, [xBase, #byteOffset]`.
pub effect fn strbImm(out: &mut Bytes, rt: u8, base: u8, byteOffset: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitImmMem(&mut out.*, 0x39000000, 0, rt, base, byteOffset)
}

/// `ldrsb rt, [xBase, #byteOffset]` (sign-extends byte to 64-bit when `wide64`, else 32-bit).
pub effect fn ldrsbImm(out: &mut Bytes, wide64: bool, rt: u8, base: u8, byteOffset: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let op: u32 = if wide64 { 0x39800000 } else { 0x39C00000 }
  return run emitImmMem(&mut out.*, op, 0, rt, base, byteOffset)
}

/// `ldrsh rt, [xBase, #byteOffset]` (sign-extends 16-bit halfword to 64-bit when `wide64`, else 32-bit).
pub effect fn ldrshImm(out: &mut Bytes, wide64: bool, rt: u8, base: u8, byteOffset: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let op: u32 = if wide64 { 0x79800000 } else { 0x79C00000 }
  return run emitImmMem(&mut out.*, op, 1, rt, base, byteOffset)
}

/// `ldrsw xRt, [xBase, #byteOffset]` (sign-extends 32-bit word to 64-bit).
pub effect fn ldrswImm(out: &mut Bytes, rt: u8, base: u8, byteOffset: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitImmMem(&mut out.*, 0xB9800000, 2, rt, base, byteOffset)
}

/// `ldr vt, [xBase, #byteOffset]` for scalar FP or 128-bit NEON (`widthBytes` in `{1, 2, 4, 8, 16}`).
pub effect fn ldrFpImm(out: &mut Bytes, widthBytes: usize, vt: u8, base: u8, byteOffset: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  if widthBytes == 16 { return run emitImmMem(&mut out.*, 0x3DC00000, 4, vt, base, byteOffset) }
  if widthBytes == 8 { return run emitImmMem(&mut out.*, 0xFD400000, 3, vt, base, byteOffset) }
  if widthBytes == 4 { return run emitImmMem(&mut out.*, 0xBD400000, 2, vt, base, byteOffset) }
  if widthBytes == 2 { return run emitImmMem(&mut out.*, 0x7D400000, 1, vt, base, byteOffset) }
  return run emitImmMem(&mut out.*, 0x3D400000, 0, vt, base, byteOffset)
}

/// `str vt, [xBase, #byteOffset]` for scalar FP or 128-bit NEON (`widthBytes` in `{1, 2, 4, 8, 16}`).
pub effect fn strFpImm(out: &mut Bytes, widthBytes: usize, vt: u8, base: u8, byteOffset: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  if widthBytes == 16 { return run emitImmMem(&mut out.*, 0x3D800000, 4, vt, base, byteOffset) }
  if widthBytes == 8 { return run emitImmMem(&mut out.*, 0xFD000000, 3, vt, base, byteOffset) }
  if widthBytes == 4 { return run emitImmMem(&mut out.*, 0xBD000000, 2, vt, base, byteOffset) }
  if widthBytes == 2 { return run emitImmMem(&mut out.*, 0x7D000000, 1, vt, base, byteOffset) }
  return run emitImmMem(&mut out.*, 0x3D000000, 0, vt, base, byteOffset)
}

// Unscaled `ldur` / `stur` (`imm9` in `[-256, 255]`).

effect fn emitUnscaledMem(out: &mut Bytes, baseOp: u32, rt: u8, base: u8, byteOffset: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let imm9 = i32.wrappingToU32(byteOffset) & 0x1FF
  return run emitWord(&mut out.*, baseOp | u32.shiftLeft(imm9, 12) | u32.shiftLeft(r5(base), 5) | r5(rt))
}

/// `ldur xRt, [xBase, #imm9]`.
pub effect fn ldur64(out: &mut Bytes, rt: u8, base: u8, byteOffset: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitUnscaledMem(&mut out.*, 0xF8400000, rt, base, byteOffset)
}

/// `stur xRt, [xBase, #imm9]`.
pub effect fn stur64(out: &mut Bytes, rt: u8, base: u8, byteOffset: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitUnscaledMem(&mut out.*, 0xF8000000, rt, base, byteOffset)
}

/// `ldur wRt, [xBase, #imm9]`.
pub effect fn ldur32(out: &mut Bytes, rt: u8, base: u8, byteOffset: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitUnscaledMem(&mut out.*, 0xB8400000, rt, base, byteOffset)
}

/// `stur wRt, [xBase, #imm9]`.
pub effect fn stur32(out: &mut Bytes, rt: u8, base: u8, byteOffset: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitUnscaledMem(&mut out.*, 0xB8000000, rt, base, byteOffset)
}

/// `ldurh wRt, [xBase, #imm9]`.
pub effect fn ldurh(out: &mut Bytes, rt: u8, base: u8, byteOffset: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitUnscaledMem(&mut out.*, 0x78400000, rt, base, byteOffset)
}

/// `sturh wRt, [xBase, #imm9]`.
pub effect fn sturh(out: &mut Bytes, rt: u8, base: u8, byteOffset: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitUnscaledMem(&mut out.*, 0x78000000, rt, base, byteOffset)
}

/// `ldurb wRt, [xBase, #imm9]`.
pub effect fn ldurb(out: &mut Bytes, rt: u8, base: u8, byteOffset: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitUnscaledMem(&mut out.*, 0x38400000, rt, base, byteOffset)
}

/// `sturb wRt, [xBase, #imm9]`.
pub effect fn sturb(out: &mut Bytes, rt: u8, base: u8, byteOffset: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitUnscaledMem(&mut out.*, 0x38000000, rt, base, byteOffset)
}

/// `ldursb rt, [xBase, #imm9]`.
pub effect fn ldursb(out: &mut Bytes, wide64: bool, rt: u8, base: u8, byteOffset: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let op: u32 = if wide64 { 0x38800000 } else { 0x38C00000 }
  return run emitUnscaledMem(&mut out.*, op, rt, base, byteOffset)
}

/// `ldursh rt, [xBase, #imm9]`.
pub effect fn ldursh(out: &mut Bytes, wide64: bool, rt: u8, base: u8, byteOffset: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let op: u32 = if wide64 { 0x78800000 } else { 0x78C00000 }
  return run emitUnscaledMem(&mut out.*, op, rt, base, byteOffset)
}

/// `ldursw xRt, [xBase, #imm9]`.
pub effect fn ldursw(out: &mut Bytes, rt: u8, base: u8, byteOffset: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitUnscaledMem(&mut out.*, 0xB8800000, rt, base, byteOffset)
}

/// `ldur vt, [xBase, #imm9]` for scalar FP or 128-bit NEON (`widthBytes` in `{4, 8, 16}`).
pub effect fn ldurFp(out: &mut Bytes, widthBytes: usize, vt: u8, base: u8, byteOffset: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  if widthBytes == 16 { return run emitUnscaledMem(&mut out.*, 0x3CC00000, vt, base, byteOffset) }
  if widthBytes == 8 { return run emitUnscaledMem(&mut out.*, 0xFC400000, vt, base, byteOffset) }
  if widthBytes == 4 { return run emitUnscaledMem(&mut out.*, 0xBC400000, vt, base, byteOffset) }
  if widthBytes == 2 { return run emitUnscaledMem(&mut out.*, 0x7C400000, vt, base, byteOffset) }
  return run emitUnscaledMem(&mut out.*, 0x3C400000, vt, base, byteOffset)
}

/// `stur vt, [xBase, #imm9]` for scalar FP or 128-bit NEON (`widthBytes` in `{4, 8, 16}`).
pub effect fn sturFp(out: &mut Bytes, widthBytes: usize, vt: u8, base: u8, byteOffset: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  if widthBytes == 16 { return run emitUnscaledMem(&mut out.*, 0x3C800000, vt, base, byteOffset) }
  if widthBytes == 8 { return run emitUnscaledMem(&mut out.*, 0xFC000000, vt, base, byteOffset) }
  if widthBytes == 4 { return run emitUnscaledMem(&mut out.*, 0xBC000000, vt, base, byteOffset) }
  if widthBytes == 2 { return run emitUnscaledMem(&mut out.*, 0x7C000000, vt, base, byteOffset) }
  return run emitUnscaledMem(&mut out.*, 0x3C000000, vt, base, byteOffset)
}

// Register-offset addressing `[base, index, extend #scale]`.

/// `ldr* rt, [base, index, extend #scale]` (`widthBytes` in `{1, 2, 4, 8}`; `extend` must be
/// `Uxtw`, `Uxtx`, `Sxtw`, or `Sxtx`; `signedExt` is valid only when `widthBytes` is in `{1, 2, 4}`).
pub effect fn ldrRegOff(
  out: &mut Bytes,
  widthBytes: usize,
  signedExt: bool,
  wide64: bool,
  rt: u8,
  base: u8,
  index: u8,
  extend: ExtendKind,
  scaled: bool,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let size = widthSizeCode(widthBytes)
  let mut opc: u32 = 1
  if signedExt {
    if widthBytes != 1 && widthBytes != 2 && widthBytes != 4 {
      CompilerBug.panic(b"AArch64Encode: signedExt ldrRegOff requires widthBytes in {1, 2, 4}")
    }
    opc = if widthBytes == 4 || wide64 { 2 } else { 3 }
  }
  let sBit: u32 = if scaled { 1 } else { 0 }
  return run emitWord(&mut out.*, 0x38200800 | u32.shiftLeft(size, 30) | u32.shiftLeft(opc, 22) | u32.shiftLeft(r5(index), 16) | u32.shiftLeft(regOffExtendCode(extend), 13) | u32.shiftLeft(sBit, 12) | u32.shiftLeft(r5(base), 5) | r5(rt))
}

/// `str* rt, [base, index, extend #scale]` (`widthBytes` in `{1, 2, 4, 8}`; `extend` must be
/// `Uxtw`, `Uxtx`, `Sxtw`, or `Sxtx`).
pub effect fn strRegOff(
  out: &mut Bytes,
  widthBytes: usize,
  rt: u8,
  base: u8,
  index: u8,
  extend: ExtendKind,
  scaled: bool,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let size = widthSizeCode(widthBytes)
  let sBit: u32 = if scaled { 1 } else { 0 }
  return run emitWord(&mut out.*, 0x38200800 | u32.shiftLeft(size, 30) | u32.shiftLeft(r5(index), 16) | u32.shiftLeft(regOffExtendCode(extend), 13) | u32.shiftLeft(sBit, 12) | u32.shiftLeft(r5(base), 5) | r5(rt))
}

/// `ldr vt, [base, index, extend #scale]` for scalar FP or 128-bit NEON (`widthBytes` in
/// `{4, 8, 16}`; `extend` must be `Uxtw`, `Uxtx`, `Sxtw`, or `Sxtx`).
pub effect fn ldrFpRegOff(
  out: &mut Bytes,
  widthBytes: usize,
  vt: u8,
  base: u8,
  index: u8,
  extend: ExtendKind,
  scaled: bool,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let sBit: u32 = if scaled { 1 } else { 0 }
  let prefix: u32 = if widthBytes == 16 { 0x3CE00800 } else if widthBytes == 8 { 0xFC600800 } else { 0xBC600800 }
  return run emitWord(&mut out.*, prefix | u32.shiftLeft(r5(index), 16) | u32.shiftLeft(regOffExtendCode(extend), 13) | u32.shiftLeft(sBit, 12) | u32.shiftLeft(r5(base), 5) | r5(vt))
}

/// `str vt, [base, index, extend #scale]` for scalar FP or 128-bit NEON (`widthBytes` in
/// `{4, 8, 16}`; `extend` must be `Uxtw`, `Uxtx`, `Sxtw`, or `Sxtx`).
pub effect fn strFpRegOff(
  out: &mut Bytes,
  widthBytes: usize,
  vt: u8,
  base: u8,
  index: u8,
  extend: ExtendKind,
  scaled: bool,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let sBit: u32 = if scaled { 1 } else { 0 }
  let prefix: u32 = if widthBytes == 16 { 0x3CA00800 } else if widthBytes == 8 { 0xFC200800 } else { 0xBC200800 }
  return run emitWord(&mut out.*, prefix | u32.shiftLeft(r5(index), 16) | u32.shiftLeft(regOffExtendCode(extend), 13) | u32.shiftLeft(sBit, 12) | u32.shiftLeft(r5(base), 5) | r5(vt))
}

// Pair load/store `ldp` / `stp`.

/// `ldp rt, rt2, [base, #byteOffset]` (`SignedOffset`, `PostIndex`, or `PreIndex`; 8-byte aligned when `wide64`, else 4-byte).
pub effect fn ldpGp(out: &mut Bytes, wide64: bool, mode: PairMode, rt: u8, rt2: u8, base: u8, byteOffset: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let opc: u32 = if wide64 { 2 } else { 0 }
  let shift: i32 = if wide64 { 3 } else { 2 }
  let imm7 = i32.wrappingToU32(i32.shiftRight(byteOffset, shift)) & 0x7F
  return run emitWord(&mut out.*, u32.shiftLeft(opc, 30) | 0x28400000 | u32.shiftLeft(pairModeBits(mode), 23) | u32.shiftLeft(imm7, 15) | u32.shiftLeft(r5(rt2), 10) | u32.shiftLeft(r5(base), 5) | r5(rt))
}

/// `stp rt, rt2, [base, #byteOffset]`.
pub effect fn stpGp(out: &mut Bytes, wide64: bool, mode: PairMode, rt: u8, rt2: u8, base: u8, byteOffset: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let opc: u32 = if wide64 { 2 } else { 0 }
  let shift: i32 = if wide64 { 3 } else { 2 }
  let imm7 = i32.wrappingToU32(i32.shiftRight(byteOffset, shift)) & 0x7F
  return run emitWord(&mut out.*, u32.shiftLeft(opc, 30) | 0x28000000 | u32.shiftLeft(pairModeBits(mode), 23) | u32.shiftLeft(imm7, 15) | u32.shiftLeft(r5(rt2), 10) | u32.shiftLeft(r5(base), 5) | r5(rt))
}

/// `ldp vt, vt2, [base, #byteOffset]` for scalar FP or 128-bit NEON (`widthBytes` in `{4, 8, 16}`).
pub effect fn ldpFp(out: &mut Bytes, widthBytes: usize, mode: PairMode, vt: u8, vt2: u8, base: u8, byteOffset: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let opc: u32 = if widthBytes == 16 { 2 } else if widthBytes == 8 { 1 } else { 0 }
  let shift: i32 = if widthBytes == 16 { 4 } else if widthBytes == 8 { 3 } else { 2 }
  let imm7 = i32.wrappingToU32(i32.shiftRight(byteOffset, shift)) & 0x7F
  return run emitWord(&mut out.*, u32.shiftLeft(opc, 30) | 0x2C400000 | u32.shiftLeft(pairModeBits(mode), 23) | u32.shiftLeft(imm7, 15) | u32.shiftLeft(r5(vt2), 10) | u32.shiftLeft(r5(base), 5) | r5(vt))
}

/// `stp vt, vt2, [base, #byteOffset]` for scalar FP or 128-bit NEON (`widthBytes` in `{4, 8, 16}`).
pub effect fn stpFp(out: &mut Bytes, widthBytes: usize, mode: PairMode, vt: u8, vt2: u8, base: u8, byteOffset: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  let opc: u32 = if widthBytes == 16 { 2 } else if widthBytes == 8 { 1 } else { 0 }
  let shift: i32 = if widthBytes == 16 { 4 } else if widthBytes == 8 { 3 } else { 2 }
  let imm7 = i32.wrappingToU32(i32.shiftRight(byteOffset, shift)) & 0x7F
  return run emitWord(&mut out.*, u32.shiftLeft(opc, 30) | 0x2C000000 | u32.shiftLeft(pairModeBits(mode), 23) | u32.shiftLeft(imm7, 15) | u32.shiftLeft(r5(vt2), 10) | u32.shiftLeft(r5(base), 5) | r5(vt))
}

// Barriers, acquire/release, LL/SC, and LSE atomics.

/// `dmb option` (`barrierIsh()`, `barrierIshst()`, or `barrierSy()`).
pub effect fn dmb(out: &mut Bytes, option: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0xD50330BF | u32.shiftLeft(u8.toU32(option & 15), 8))
}

/// `dsb option`.
pub effect fn dsb(out: &mut Bytes, option: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0xD503309F | u32.shiftLeft(u8.toU32(option & 15), 8))
}

/// `isb`.
pub effect fn isb(out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0xD5033FDF)
}

/// `clrex`.
pub effect fn clrex(out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0xD5033F5F)
}

/// `ldar* rt, [base]` (`widthBytes` in `{1, 2, 4, 8}`).
pub effect fn ldar(out: &mut Bytes, widthBytes: usize, rt: u8, base: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let size = widthSizeCode(widthBytes)
  return run emitWord(&mut out.*, u32.shiftLeft(size, 30) | 0x08DFFC00 | u32.shiftLeft(r5(base), 5) | r5(rt))
}

/// `stlr* rt, [base]` (`widthBytes` in `{1, 2, 4, 8}`).
pub effect fn stlr(out: &mut Bytes, widthBytes: usize, rt: u8, base: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let size = widthSizeCode(widthBytes)
  return run emitWord(&mut out.*, u32.shiftLeft(size, 30) | 0x089FFC00 | u32.shiftLeft(r5(base), 5) | r5(rt))
}

/// `ldaxr* rt, [base]` (`widthBytes` in `{1, 2, 4, 8}`).
pub effect fn ldaxr(out: &mut Bytes, widthBytes: usize, rt: u8, base: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let size = widthSizeCode(widthBytes)
  return run emitWord(&mut out.*, u32.shiftLeft(size, 30) | 0x085FFC00 | u32.shiftLeft(r5(base), 5) | r5(rt))
}

/// `stlxr* wStatus, rt, [base]` (`widthBytes` in `{1, 2, 4, 8}`).
pub effect fn stlxr(out: &mut Bytes, widthBytes: usize, status: u8, rt: u8, base: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let size = widthSizeCode(widthBytes)
  return run emitWord(&mut out.*, u32.shiftLeft(size, 30) | 0x0800FC00 | u32.shiftLeft(r5(status), 16) | u32.shiftLeft(r5(base), 5) | r5(rt))
}

/// `casal* expected, desired, [base]` (`widthBytes` in `{1, 2, 4, 8}`, returns previous value in `expected`).
pub effect fn casal(out: &mut Bytes, widthBytes: usize, expected: u8, desired: u8, base: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let size = widthSizeCode(widthBytes)
  return run emitWord(&mut out.*, u32.shiftLeft(size, 30) | 0x08E0FC00 | u32.shiftLeft(r5(expected), 16) | u32.shiftLeft(r5(base), 5) | r5(desired))
}

/// Emits an ARMv8.1-A LSE acquire-release atomic memory operation (`opc`: `0` `ldaddal`, `1` `ldclral`,
/// `2` `ldeoral`, `3` `ldsetal`, `4` `ldsmaxal`, `5` `ldsminal`, `6` `ldumaxal`, `7` `lduminal`, `8` `swpal`).
pub effect fn lseAtomic(out: &mut Bytes, widthBytes: usize, opc: u32, rs: u8, rt: u8, base: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let size = widthSizeCode(widthBytes)
  return run emitWord(&mut out.*, u32.shiftLeft(size, 30) | 0x38E00000 | u32.shiftLeft(r5(rs), 16) | u32.shiftLeft(opc & 15, 12) | u32.shiftLeft(r5(base), 5) | r5(rt))
}

// ---- Scalar Floating-Point ----

fn ftypeBit(double: bool) -> u32 {
  if double { return 0x00400000 }
  return 0
}

/// `fmov dDst, xSrc` (`double == true`) or `fmov sDst, wSrc`.
pub effect fn fmovGpToFp(out: &mut Bytes, double: bool, vd: u8, rn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let base: u32 = if double { 0x9E670000 } else { 0x1E270000 }
  return run emitWord(&mut out.*, base | u32.shiftLeft(r5(rn), 5) | r5(vd))
}

/// `fmov xDst, dSrc` (`double == true`) or `fmov wDst, sSrc`.
pub effect fn fmovFpToGp(out: &mut Bytes, double: bool, rd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let base: u32 = if double { 0x9E660000 } else { 0x1E260000 }
  return run emitWord(&mut out.*, base | u32.shiftLeft(r5(vn), 5) | r5(rd))
}

/// `fmov vd, vn` (scalar single or double register copy).
pub effect fn fmovFpRr(out: &mut Bytes, double: bool, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E204000 | ftypeBit(double) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `fadd vd, vn, vm`.
pub effect fn fadd(out: &mut Bytes, double: bool, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E202800 | ftypeBit(double) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `fsub vd, vn, vm`.
pub effect fn fsub(out: &mut Bytes, double: bool, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E203800 | ftypeBit(double) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `fmul vd, vn, vm`.
pub effect fn fmul(out: &mut Bytes, double: bool, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E200800 | ftypeBit(double) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `fdiv vd, vn, vm`.
pub effect fn fdiv(out: &mut Bytes, double: bool, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E201800 | ftypeBit(double) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `fmax vd, vn, vm`.
pub effect fn fmax(out: &mut Bytes, double: bool, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E204800 | ftypeBit(double) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `fmin vd, vn, vm`.
pub effect fn fmin(out: &mut Bytes, double: bool, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E205800 | ftypeBit(double) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `fmaxnm vd, vn, vm`.
pub effect fn fmaxnm(out: &mut Bytes, double: bool, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E206800 | ftypeBit(double) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `fminnm vd, vn, vm`.
pub effect fn fminnm(out: &mut Bytes, double: bool, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E207800 | ftypeBit(double) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `fmadd vd, vn, vm, va` (`vd = vn * vm + va`).
pub effect fn fmadd(out: &mut Bytes, double: bool, vd: u8, vn: u8, vm: u8, va: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1F000000 | ftypeBit(double) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(va), 10) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `fmsub vd, vn, vm, va` (`vd = va - vn * vm`).
pub effect fn fmsub(out: &mut Bytes, double: bool, vd: u8, vn: u8, vm: u8, va: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1F008000 | ftypeBit(double) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(va), 10) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `fabs vd, vn`.
pub effect fn fabs(out: &mut Bytes, double: bool, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E20C000 | ftypeBit(double) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `fneg vd, vn`.
pub effect fn fneg(out: &mut Bytes, double: bool, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E214000 | ftypeBit(double) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `fsqrt vd, vn`.
pub effect fn fsqrt(out: &mut Bytes, double: bool, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E21C000 | ftypeBit(double) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `fcmp vn, vm`.
pub effect fn fcmp(out: &mut Bytes, double: bool, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E202000 | ftypeBit(double) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5))
}

/// `fcmp vn, #0.0`.
pub effect fn fcmpZero(out: &mut Bytes, double: bool, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E202008 | ftypeBit(double) | u32.shiftLeft(r5(vn), 5))
}

/// `fcsel vd, vn, vm, cc`.
pub effect fn fcsel(out: &mut Bytes, double: bool, vd: u8, vn: u8, vm: u8, cc: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E200C00 | ftypeBit(double) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(u8.toU32(cc & 15), 12) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `fcvtzs rd, vn` (round toward zero float to signed integer).
pub effect fn fcvtzs(out: &mut Bytes, wide64: bool, double: bool, rd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x1E380000 | ftypeBit(double) | u32.shiftLeft(r5(vn), 5) | r5(rd))
}

/// `fcvtzu rd, vn` (round toward zero float to unsigned integer).
pub effect fn fcvtzu(out: &mut Bytes, wide64: bool, double: bool, rd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x1E390000 | ftypeBit(double) | u32.shiftLeft(r5(vn), 5) | r5(rd))
}

/// `scvtf vd, rn` (signed integer to float).
pub effect fn scvtf(out: &mut Bytes, wide64: bool, double: bool, vd: u8, rn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x1E220000 | ftypeBit(double) | u32.shiftLeft(r5(rn), 5) | r5(vd))
}

/// `ucvtf vd, rn` (unsigned integer to float).
pub effect fn ucvtf(out: &mut Bytes, wide64: bool, double: bool, vd: u8, rn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, sfBit(wide64) | 0x1E230000 | ftypeBit(double) | u32.shiftLeft(r5(rn), 5) | r5(vd))
}

/// `fcvt dDst, sSrc` (`f32` to `f64`).
pub effect fn fcvtS2D(out: &mut Bytes, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E22C000 | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `fcvt sDst, dSrc` (`f64` to `f32`).
pub effect fn fcvtD2S(out: &mut Bytes, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E624000 | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `frintn vd, vn` (round to nearest, ties to even).
pub effect fn frintn(out: &mut Bytes, double: bool, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x1E244000 | ftypeBit(double) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

