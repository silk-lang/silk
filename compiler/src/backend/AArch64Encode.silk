/// `fcvtzs vd.T, vn.T` (`4s` or `2d`).
pub effect fn vecFcvtzs(out: &mut Bytes, double: bool, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4EA1B800 | ftypeBit(double) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

