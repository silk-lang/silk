// Vector shifts.

/// `shl vd.T, vn.T, #shift` (`laneBytes` in `{1, 2, 4, 8}`, `shift` in `0..(8*laneBytes - 1)`).
pub effect fn vecShlImm(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8, shift: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let bits = usize.toU32(laneBytes * 8)
  let amt = u8.toU32(shift) & (bits - 1)
  let immhb = bits + amt
  return run emitWord(&mut out.*, 0x4F005400 | u32.shiftLeft(immhb, 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `ushr vd.T, vn.T, #shift` (`mov` when `shift == 0`, since `immh=0` is invalid in `ushr`).
pub effect fn vecUshrImm(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8, shift: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let bits = usize.toU32(laneBytes * 8)
  let amt = u8.toU32(shift) & (bits - 1)
  if amt == 0 { return run movVec(&mut out.*, vd, vn) }
  let immhb = bits * 2 - amt
  return run emitWord(&mut out.*, 0x6F000400 | u32.shiftLeft(immhb, 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `sri vd.T, vn.T, #shift` (shift right and insert into low `width - shift` bits of `vd`; `shift` in `1..(8*laneBytes - 1)`).
pub effect fn vecSriImm(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8, shift: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let bits = usize.toU32(laneBytes * 8)
  let amt = u8.toU32(shift) & (bits - 1)
  if amt == 0 { return run movVec(&mut out.*, vd, vn) }
  let immhb = bits * 2 - amt
  return run emitWord(&mut out.*, 0x6F004400 | u32.shiftLeft(immhb, 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `sshr vd.T, vn.T, #shift` (`mov` when `shift == 0`).
pub effect fn vecSshrImm(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8, shift: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let bits = usize.toU32(laneBytes * 8)
  let amt = u8.toU32(shift) & (bits - 1)
  if amt == 0 { return run movVec(&mut out.*, vd, vn) }
  let immhb = bits * 2 - amt
  return run emitWord(&mut out.*, 0x4F000400 | u32.shiftLeft(immhb, 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `sshl vd.T, vn.T, vm.T` (signed variable shift: positive left, negative right).
pub effect fn vecSshlReg(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4E204400 | u32.shiftLeft(vecSizeCode(laneBytes), 22) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `ushl vd.T, vn.T, vm.T` (unsigned variable shift: positive left, negative right).
pub effect fn vecUshlReg(out: &mut Bytes, laneBytes: usize, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x6E204400 | u32.shiftLeft(vecSizeCode(laneBytes), 22) | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

