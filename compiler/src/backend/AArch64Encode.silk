// Dot product & Crypto extensions.

/// `udot vd.4s, vn.16b, vm.16b` (accumulates unsigned 8-bit dot products into 32-bit lanes of `vd`).
pub effect fn vecUdot(out: &mut Bytes, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x6E809400 | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `sdot vd.4s, vn.16b, vm.16b` (accumulates signed 8-bit dot products into 32-bit lanes of `vd`).
pub effect fn vecSdot(out: &mut Bytes, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4E809400 | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `aese vd.16b, vn.16b` (AES single round encryption in place on `vd`).
pub effect fn aese(out: &mut Bytes, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4E284800 | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `aesd vd.16b, vn.16b` (AES single round decryption in place on `vd`).
pub effect fn aesd(out: &mut Bytes, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4E285800 | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `aesmc vd.16b, vn.16b` (AES MixColumns).
pub effect fn aesmc(out: &mut Bytes, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4E286800 | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `aesimc vd.16b, vn.16b` (AES inverse MixColumns).
pub effect fn aesimc(out: &mut Bytes, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4E287800 | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `pmull vd.1q, vn.1d, vm.1d` (64-bit carry-less multiply of low 64-bit lanes).
pub effect fn pmull(out: &mut Bytes, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x0EE0E000 | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `pmull2 vd.1q, vn.2d, vm.2d` (64-bit carry-less multiply of high 64-bit lanes).
pub effect fn pmull2(out: &mut Bytes, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x4EE0E000 | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `sha256h qd, qn, vm.4s` (first half of 4 SHA-256 rounds; updates `qd` in place).
pub effect fn sha256h(out: &mut Bytes, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x5E004000 | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `sha256h2 qd, qn, vm.4s` (second half of 4 SHA-256 rounds; updates `qd` in place).
pub effect fn sha256h2(out: &mut Bytes, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x5E005000 | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `sha256su0 vd.4s, vn.4s` (SHA-256 schedule update 0; updates `vd` in place).
pub effect fn sha256su0(out: &mut Bytes, vd: u8, vn: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x5E282800 | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `sha256su1 vd.4s, vn.4s, vm.4s` (SHA-256 schedule update 1; updates `vd` in place).
pub effect fn sha256su1(out: &mut Bytes, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x5E006000 | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
