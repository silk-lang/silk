pub effect fn vecBsl(out: &mut Bytes, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x6E601C00 | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `bit vd.16b, vn.16b, vm.16b` (insert bits of `vn` into `vd` where `vm` has `1`).
pub effect fn vecBit(out: &mut Bytes, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  return run emitWord(&mut out.*, 0x6EA01C00 | u32.shiftLeft(r5(vm), 16) | u32.shiftLeft(r5(vn), 5) | r5(vd))
}

/// `bif vd.16b, vn.16b, vm.16b` (insert bits of `vn` into `vd` where `vm` has `0`).
pub effect fn vecBif(out: &mut Bytes, vd: u8, vn: u8, vm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
