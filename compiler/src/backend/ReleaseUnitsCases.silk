//! A release split keeps the edited part of a program apart from the rest, and splits the rest
//! the same way whatever the edited part holds.

import backend.Bitcode
import backend.LlvmCode
import backend.ReleaseUnits { Graph }
import backend.ReleaseUnits as ReleaseUnits
import semantic.Target { Id as TargetId, Target }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.testing.testing { AssertionError, Testing }

test effect fn anEditChangesOnlyTheEditedPartsUnits() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  // Node 0 is the application, which an edited module declares. Node 1 is a library function
  // instantiated for it, which calls it back. Nodes 2 to 5 are library functions that reach
  // neither; 2 and 4 both call 3.
  let before = run ReleaseUnits.assign(3, Graph {
    sizes: &[100, 100, 100, 100, 100, 100],
    copyable: &[true, true, true, true, true, true],
    copied: &[false, false, false, false, false, false],
    edited: &[true, false, false, false, false, false],
    homes: &[7, 3, 4, 4, 5, 6],
    edgeStarts: &[0, 2, 3, 4, 4, 5, 5],
    edges: &[1, 2, 0, 3, 3],
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = List<usize>.asSlice(&before)
  run Testing.expect(first[0] == 2, "an edited module's function is in the edited part's unit")
  run Testing.expect(first[1] == 2, "a function that reaches an edited one is in the edited part")
  run Testing.expect(first[2] < 2 && first[3] < 2 && first[4] < 2 && first[5] < 2, "a function that reaches no edited one stays in the rest")
  run Testing.expect(first[2] + first[3] + first[4] + first[5] == 2, "the rest spreads evenly over its units")
  // The edit grows the application and adds node 6, another function of its module, which calls
  // 5; node 7 is a helper every caller copies.
  let after = run ReleaseUnits.assign(3, Graph {
    sizes: &[120, 100, 100, 100, 100, 100, 30, 10],
    copyable: &[true, true, true, true, true, true, true, true],
    copied: &[false, false, false, false, false, false, false, true],
    edited: &[true, false, false, false, false, false, true, false],
    homes: &[7, 3, 4, 4, 5, 6, 7, 6],
    edgeStarts: &[0, 3, 4, 5, 5, 6, 6, 8, 8],
    edges: &[1, 2, 6, 0, 3, 3, 5, 7],
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = List<usize>.asSlice(&after)
  run Testing.expect(second[2] == first[2] && second[3] == first[3] && second[4] == first[4] && second[5] == first[5],
    "the rest keeps its units after an edit")
  run Testing.expect(second[0] == 2 && second[6] == 2, "functions of one edited module share a unit")
  run Testing.expect(second[7] == usize.MAX, "no unit owns a function every caller copies")
  return ()
}

test effect fn aProgramWithoutAnEditedPartSplitsWhole() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let owners = run ReleaseUnits.assign(2, Graph {
    sizes: &[100, 100, 100, 100],
    copyable: &[true, true, true, true],
    copied: &[false, false, false, false],
    edited: &[false, false, false, false],
    homes: &[1, 2, 3, 4],
    edgeStarts: &[0, 0, 0, 0, 0],
    edges: &[],
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let placed = List<usize>.asSlice(&owners)
  let mut inFirst = 0
  let mut at: usize = 0
  while at < placed.length {
    if placed[at] == 0 { inFirst = inFirst + 1 }
    at = at + 1
  }
  run Testing.expect(inFirst == 2, "every unit takes an even share when nothing is edited")
  return ()
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

test effect fn runtimeHelpersPartitionIntoOneUnit() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let target = Target.forId(TargetId.X8664UnknownLinuxGnu)
  let head = run LlvmCode.unitHead(&target) |> Effect.provideMut<Allocator>(&mut allocator)
  let headGlobals = run Bitcode.globalsOf(Bytes.asSlice(&head)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut headDefined = usize.ZERO
  let mut at = usize.ZERO
  let headSlice = List<Bitcode.Named>.asSlice(&headGlobals)
  while at < headSlice.length {
    if headSlice[at].defined {
      headDefined = headDefined + usize.ONE
    }
    at = at + usize.ONE
  }
  run Testing.expect(headDefined == usize.ZERO,
    "unitHead declares the runtime helpers and foreign personality without defining them so ReleaseUnits places it in shared")
  let runtime = run LlvmCode.runtimeUnit(&target, true) |> Effect.provideMut<Allocator>(&mut allocator)
  let runtimeGlobals = run Bitcode.globalsOf(Bytes.asSlice(&runtime)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut externalFatal = false
  let mut externalReclaim = false
  let mut coalescedPersonality = false
  let mut internalSubHelpers = usize.ZERO
  let runtimeSlice = List<Bitcode.Named>.asSlice(&runtimeGlobals)
  at = usize.ZERO
  while at < runtimeSlice.length {
    let entry = &runtimeSlice[at]
    let name = Bytes.asSlice(&entry.name)
    if entry.function && entry.defined {
      if sameBytes(name, b"silk.diagnostic.fatal") {
        externalFatal = entry.linkage == Bitcode.linkExternal()
      } else if sameBytes(name, b"__silk_guarded_reclaim") {
        externalReclaim = entry.linkage == Bitcode.linkExternal()
      } else if sameBytes(name, b"__silk_foreign_personality") {
        coalescedPersonality = entry.linkage == Bitcode.linkLinkOnceOdr()
      } else if entry.linkage == Bitcode.linkInternal() {
        internalSubHelpers = internalSubHelpers + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  run Testing.expect(externalFatal && externalReclaim && coalescedPersonality && internalSubHelpers >= 4,
    "runtimeUnit defines fatal, reclaim, and the coalesced foreign personality once and keeps frame helpers internal")
  return ()
}
