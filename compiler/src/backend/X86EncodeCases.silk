//! Unit checks for `X86Encode`, `X86Asm`, `X86Unwind`, `X86Object`, and `X86ElfObject`.

import backend.X86Asm
import backend.X86Asm {AsmCallReloc, ConstraintKind, OperandBinding, UnsupportedAsm}
import backend.X86ElfObject
import backend.X86Encode
import backend.X86Encode {Alu, Mem, Shift}
import backend.X86Object
import backend.X86Object {Fragment, Function, Object, Pointer, Relocation, RodataJumpEntry, Unsupported}
import backend.X86Unwind
import backend.X86Unwind {UnwindInfo}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.result {Result}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.u8
import silk.num.usize
import silk.testing.testing {AssertionError, Testing}

fn sameBytes(actual: &[u8], expected: &[u8]) -> bool {
  if actual.length != expected.length { return false }
  let mut at = usize.ZERO
  while at < actual.length {
    if actual[at] != expected[at] { return false }
    at = at + usize.ONE
  }
  return true
}

test effect fn encodesCoreInstructionsAndAddressingModes() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run encodeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn encodeClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // push rbp; mov rbp, rsp; leave; ret -> 55 48 89 e5 c9 c3
  let mut buf = Bytes.make()
  run X86Encode.push(&mut buf, X86Encode.rbp())
  run X86Encode.movRr64(&mut buf, X86Encode.rbp(), X86Encode.rsp())
  run X86Encode.leave(&mut buf)
  run X86Encode.ret(&mut buf)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x55, 0x48, 0x89, 0xE5, 0xC9, 0xC3]),
    "standard frame prologue and epilogue bytes")

  // 8-bit SPL/SIL require REX=0x40 so they do not encode AH/DH.
  buf = Bytes.make()
  run X86Encode.movRr8(&mut buf, X86Encode.rsp(), X86Encode.rsi())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x40, 0x88, 0xF4]),
    "mov spl, sil emits REX 0x40")

  // [rsp] needs SIB 0x24; [rbp] with disp 0 needs mod=01 disp8=0.
  buf = Bytes.make()
  drop run X86Encode.movRm64(&mut buf, X86Encode.rax(), Mem.baseDisp(X86Encode.rsp(), 0))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x48, 0x8B, 0x04, 0x24]),
    "mov rax, [rsp] emits SIB 0x24")

  buf = Bytes.make()
  drop run X86Encode.movRm64(&mut buf, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), 0))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x48, 0x8B, 0x45, 0x00]),
    "mov rax, [rbp] emits disp8=0")

  // [r12 + r13*8 + 16]: REX.W|X|B (0x4B), 8B, ModRM(mod=01, reg=0, rm=4 -> 0x44), SIB(scale=3, idx=5, base=4 -> 0xEC), disp8=0x10
  buf = Bytes.make()
  drop run X86Encode.movRm64(&mut buf, X86Encode.rax(), Mem.baseIndex(X86Encode.r12(), X86Encode.r13(), 8, 16))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x4B, 0x8B, 0x44, 0xEC, 0x10]),
    "mov rax, [r12 + r13*8 + 16] encodes REX.WXB + SIB")

  // TLS base read: mov rax, qword ptr fs:[0] -> 64 48 8b 04 25 00 00 00 00
  buf = Bytes.make()
  drop run X86Encode.movRm64(&mut buf, X86Encode.rax(), Mem.fsDisp(0))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x64, 0x48, 0x8B, 0x04, 0x25, 0x00, 0x00, 0x00, 0x00]),
    "mov rax, fs:[0] encodes FS prefix + SIB disp32")

  // RIP-relative LEA: lea rdi, [rip + 0] -> 48 8d 3d 00 00 00 00, dispAt == 3
  buf = Bytes.make()
  let dispAt = run X86Encode.lea64(&mut buf, X86Encode.rdi(), Mem.ripRel(0))
  run Testing.expect(dispAt == 3 && sameBytes(Bytes.asSlice(&buf), &[0x48, 0x8D, 0x3D, 0x00, 0x00, 0x00, 0x00]),
    "lea rdi, [rip + 0] returns disp offset 3")

  // Branch patching: jmp to offset 8 (5-byte jmp + 3 nops -> rel32 = 3).
  buf = Bytes.make()
  let jAt = run X86Encode.jmpRel32(&mut buf)
  run X86Encode.nop(&mut buf)
  run X86Encode.nop(&mut buf)
  run X86Encode.nop(&mut buf)
  let target = Bytes.length(&buf)
  X86Encode.patchRel32(&mut buf, jAt, target)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xE9, 0x03, 0x00, 0x00, 0x00, 0x90, 0x90, 0x90]),
    "patchRel32 computes exact signed relative displacement")

  // Short rel8 branches: jmp -2 -> eb fe; jne +12 -> 75 0c.
  buf = Bytes.make()
  run X86Encode.jmpRel8(&mut buf, -2)
  run X86Encode.jccRel8(&mut buf, X86Encode.ccNe(), 12)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xEB, 0xFE, 0x75, 0x0C]),
    "jmpRel8 and jccRel8 emit exact 2-byte short branch encodings")

  // SSE2 shifts/compare/pmovmskb and scalar bswap32/bswap64.
  buf = Bytes.make()
  run X86Encode.psllImm(&mut buf, 4, 1, 16)
  run X86Encode.psrlImm(&mut buf, 4, 1, 16)
  run X86Encode.psraImm(&mut buf, 4, 9, 3)
  run X86Encode.pcmpeq(&mut buf, 1, 0, 1)
  run X86Encode.pmovmskb(&mut buf, X86Encode.rax(), 0)
  run X86Encode.bswap32(&mut buf, X86Encode.rax())
  run X86Encode.bswap32(&mut buf, X86Encode.r13())
  run X86Encode.bswap64(&mut buf, X86Encode.r14())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[
    0x66, 0x0F, 0x72, 0xF1, 0x10,
    0x66, 0x0F, 0x72, 0xD1, 0x10,
    0x66, 0x41, 0x0F, 0x72, 0xE1, 0x03,
    0x66, 0x0F, 0x74, 0xC1,
    0x66, 0x0F, 0xD7, 0xC0,
    0x0F, 0xC8,
    0x41, 0x0F, 0xCD,
    0x49, 0x0F, 0xCE,
  ]), "SSE2 shift/compare/pmovmskb and bswap32/bswap64 emit exact bytes")

  // SSE2 register-count vector shifts (psllRr/psrlRr/psraRr) and low-word shuffle (pshuflw).
  buf = Bytes.make()
  run X86Encode.psllRr(&mut buf, 2, 0, 2)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x0F, 0xF1, 0xC2]), "psllw xmm0, xmm2")
  buf = Bytes.make()
  run X86Encode.psllRr(&mut buf, 4, 0, 2)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x0F, 0xF2, 0xC2]), "pslld xmm0, xmm2")
  buf = Bytes.make()
  run X86Encode.psllRr(&mut buf, 8, 9, 10)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x45, 0x0F, 0xF3, 0xCA]), "psllq xmm9, xmm10")
  buf = Bytes.make()
  run X86Encode.psrlRr(&mut buf, 2, 0, 2)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x0F, 0xD1, 0xC2]), "psrlw xmm0, xmm2")
  buf = Bytes.make()
  run X86Encode.psrlRr(&mut buf, 4, 9, 10)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x45, 0x0F, 0xD2, 0xCA]), "psrld xmm9, xmm10")
  buf = Bytes.make()
  run X86Encode.psrlRr(&mut buf, 8, 0, 2)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x0F, 0xD3, 0xC2]), "psrlq xmm0, xmm2")
  buf = Bytes.make()
  run X86Encode.psraRr(&mut buf, 2, 0, 2)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x0F, 0xE1, 0xC2]), "psraw xmm0, xmm2")
  buf = Bytes.make()
  run X86Encode.psraRr(&mut buf, 4, 9, 10)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x45, 0x0F, 0xE2, 0xCA]), "psrad xmm9, xmm10")
  buf = Bytes.make()
  run X86Encode.pshuflw(&mut buf, 2, 1, 0)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xF2, 0x0F, 0x70, 0xD1, 0x00]), "pshuflw xmm2, xmm1, 0")
  buf = Bytes.make()
  run X86Encode.pshuflw(&mut buf, 9, 10, 0)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xF2, 0x45, 0x0F, 0x70, 0xCA, 0x00]), "pshuflw xmm9, xmm10, 0")

  // AES-NI & SHA encodings: aesenc xmm1, xmm2 -> 66 0f 38 dc ca; sha256rnds2 xmm1, xmm2 -> 0f 38 cb ca.
  buf = Bytes.make()
  run X86Encode.aesenc(&mut buf, 1, 2)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x0F, 0x38, 0xDC, 0xCA]), "aesenc xmm1, xmm2")
  buf = Bytes.make()
  run X86Encode.sha256rnds2(&mut buf, 1, 2)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x0F, 0x38, 0xCB, 0xCA]), "sha256rnds2 xmm1, xmm2")
  buf = Bytes.make()
  run X86Encode.pclmulqdq(&mut buf, 0, 1, 0x11)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x0F, 0x3A, 0x44, 0xC1, 0x11]), "pclmulqdq xmm0, xmm1, 0x11")

  // Atomic lock cmpxchg [rdi], rsi -> f0 48 0f b1 37
  buf = Bytes.make()
  drop run X86Encode.lockCmpxchg(&mut buf, Mem.baseDisp(X86Encode.rdi(), 0), X86Encode.rsi(), 8)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xF0, 0x48, 0x0F, 0xB1, 0x37]), "lock cmpxchg [rdi], rsi")

  // Shifts and ALU sanity.
  buf = Bytes.make()
  run X86Encode.aluRi64(&mut buf, Alu.Add, X86Encode.rsp(), 16)
  run X86Encode.shiftImm64(&mut buf, Shift.Shl, X86Encode.rdx(), 32)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x48, 0x83, 0xC4, 0x10, 0x48, 0xC1, 0xE2, 0x20]),
    "add rsp, 16 and shl rdx, 32")
}

test effect fn encodesM4AluMemAndSibModes() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run m4EncodeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn m4EncodeClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut buf = Bytes.make()

  // aluRm32 (llvm-mc verified).
  drop run X86Encode.aluRm32(&mut buf, Alu.Add, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), -8))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x03, 0x45, 0xF8]), "add eax, dword [rbp-8]")
  buf = Bytes.make()
  drop run X86Encode.aluRm32(&mut buf, Alu.Sub, X86Encode.r8(), Mem.baseDisp(X86Encode.rbp(), -256))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x44, 0x2B, 0x85, 0x00, 0xFF, 0xFF, 0xFF]), "sub r8d, dword [rbp-256]")
  buf = Bytes.make()
  drop run X86Encode.aluRm32(&mut buf, Alu.Cmp, X86Encode.r12(), Mem.baseDisp(X86Encode.r12(), 8))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x45, 0x3B, 0x64, 0x24, 0x08]), "cmp r12d, dword [r12+8]")
  buf = Bytes.make()
  drop run X86Encode.aluRm32(&mut buf, Alu.And, X86Encode.rcx(), Mem.baseDisp(X86Encode.rsp(), 16))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x23, 0x4C, 0x24, 0x10]), "and ecx, dword [rsp+16]")
  buf = Bytes.make()
  drop run X86Encode.aluRm32(&mut buf, Alu.Xor, X86Encode.r13(), Mem.baseDisp(X86Encode.r13(), 0))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x45, 0x33, 0x6D, 0x00]), "xor r13d, dword [r13]")

  // aluMi64 (imm8 vs imm32, [rbp], [r13], [rsp]).
  buf = Bytes.make()
  drop run X86Encode.aluMi64(&mut buf, Alu.Add, Mem.baseDisp(X86Encode.rbp(), -8), 1)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x48, 0x83, 0x45, 0xF8, 0x01]), "add qword [rbp-8], 1")
  buf = Bytes.make()
  drop run X86Encode.aluMi64(&mut buf, Alu.Add, Mem.baseDisp(X86Encode.rbp(), -8), 1000)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x48, 0x81, 0x45, 0xF8, 0xE8, 0x03, 0x00, 0x00]), "add qword [rbp-8], 1000")
  buf = Bytes.make()
  drop run X86Encode.aluMi64(&mut buf, Alu.Cmp, Mem.baseDisp(X86Encode.rbp(), -256), -1)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x48, 0x83, 0xBD, 0x00, 0xFF, 0xFF, 0xFF, 0xFF]), "cmp qword [rbp-256], -1")
  buf = Bytes.make()
  drop run X86Encode.aluMi64(&mut buf, Alu.Cmp, Mem.baseDisp(X86Encode.r13(), 0), 0x12345678)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x49, 0x81, 0x7D, 0x00, 0x78, 0x56, 0x34, 0x12]), "cmp qword [r13], 0x12345678")
  buf = Bytes.make()
  drop run X86Encode.aluMi64(&mut buf, Alu.Cmp, Mem.baseDisp(X86Encode.rsp(), 8), 0)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x48, 0x83, 0x7C, 0x24, 0x08, 0x00]), "cmp qword [rsp+8], 0")

  // aluMi32.
  buf = Bytes.make()
  drop run X86Encode.aluMi32(&mut buf, Alu.Sub, Mem.baseDisp(X86Encode.rbp(), -16), 1)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x83, 0x6D, 0xF0, 0x01]), "sub dword [rbp-16], 1")
  buf = Bytes.make()
  drop run X86Encode.aluMi32(&mut buf, Alu.Cmp, Mem.baseDisp(X86Encode.rbp(), -256), 1000)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x81, 0xBD, 0x00, 0xFF, 0xFF, 0xFF, 0xE8, 0x03, 0x00, 0x00]), "cmp dword [rbp-256], 1000")
  buf = Bytes.make()
  drop run X86Encode.aluMi32(&mut buf, Alu.Cmp, Mem.baseDisp(X86Encode.r12(), 8), -128)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x41, 0x83, 0x7C, 0x24, 0x08, 0x80]), "cmp dword [r12+8], -128")

  // aluMi8 (verify no spurious REX 0x40 on sub-opcode 7 = Cmp).
  buf = Bytes.make()
  drop run X86Encode.aluMi8(&mut buf, Alu.Cmp, Mem.baseDisp(X86Encode.rbp(), -8), 0)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x80, 0x7D, 0xF8, 0x00]), "cmp byte [rbp-8], 0")
  buf = Bytes.make()
  drop run X86Encode.aluMi8(&mut buf, Alu.Cmp, Mem.baseDisp(X86Encode.rbp(), -256), 255)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x80, 0xBD, 0x00, 0xFF, 0xFF, 0xFF, 0xFF]), "cmp byte [rbp-256], 255")
  buf = Bytes.make()
  drop run X86Encode.aluMi8(&mut buf, Alu.Cmp, Mem.baseDisp(X86Encode.r12(), 4), 128)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x41, 0x80, 0x7C, 0x24, 0x04, 0x80]), "cmp byte [r12+4], 128")
  buf = Bytes.make()
  drop run X86Encode.aluMi8(&mut buf, Alu.Cmp, Mem.baseDisp(X86Encode.r13(), 0), 1)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x41, 0x80, 0x7D, 0x00, 0x01]), "cmp byte [r13], 1")
  buf = Bytes.make()
  drop run X86Encode.aluMi8(&mut buf, Alu.Add, Mem.baseDisp(X86Encode.rsp(), 8), 7)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x80, 0x44, 0x24, 0x08, 0x07]), "add byte [rsp+8], 7")

  // testMi8.
  buf = Bytes.make()
  drop run X86Encode.testMi8(&mut buf, Mem.baseDisp(X86Encode.rbp(), -8), 1)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xF6, 0x45, 0xF8, 0x01]), "test byte [rbp-8], 1")
  buf = Bytes.make()
  drop run X86Encode.testMi8(&mut buf, Mem.baseDisp(X86Encode.rbp(), -256), 1)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xF6, 0x85, 0x00, 0xFF, 0xFF, 0xFF, 0x01]), "test byte [rbp-256], 1")
  buf = Bytes.make()
  drop run X86Encode.testMi8(&mut buf, Mem.baseDisp(X86Encode.r12(), 8), 1)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x41, 0xF6, 0x44, 0x24, 0x08, 0x01]), "test byte [r12+8], 1")
  buf = Bytes.make()
  drop run X86Encode.testMi8(&mut buf, Mem.baseDisp(X86Encode.r13(), 0), 1)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x41, 0xF6, 0x45, 0x00, 0x01]), "test byte [r13], 1")
  buf = Bytes.make()
  drop run X86Encode.testMi8(&mut buf, Mem.baseDisp(X86Encode.rsp(), 8), 1)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xF6, 0x44, 0x24, 0x08, 0x01]), "test byte [rsp+8], 1")

  // imulRm32 & imulRm64.
  buf = Bytes.make()
  drop run X86Encode.imulRm32(&mut buf, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), -8))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x0F, 0xAF, 0x45, 0xF8]), "imul eax, dword [rbp-8]")
  buf = Bytes.make()
  drop run X86Encode.imulRm32(&mut buf, X86Encode.r8(), Mem.baseDisp(X86Encode.rbp(), -256))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x44, 0x0F, 0xAF, 0x85, 0x00, 0xFF, 0xFF, 0xFF]), "imul r8d, dword [rbp-256]")
  buf = Bytes.make()
  drop run X86Encode.imulRm32(&mut buf, X86Encode.r12(), Mem.baseDisp(X86Encode.r13(), 16))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x45, 0x0F, 0xAF, 0x65, 0x10]), "imul r12d, dword [r13+16]")
  buf = Bytes.make()
  drop run X86Encode.imulRm64(&mut buf, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), -8))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x48, 0x0F, 0xAF, 0x45, 0xF8]), "imul rax, qword [rbp-8]")
  buf = Bytes.make()
  drop run X86Encode.imulRm64(&mut buf, X86Encode.r8(), Mem.baseDisp(X86Encode.rbp(), -256))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x4C, 0x0F, 0xAF, 0x85, 0x00, 0xFF, 0xFF, 0xFF]), "imul r8, qword [rbp-256]")
  buf = Bytes.make()
  drop run X86Encode.imulRm64(&mut buf, X86Encode.r12(), Mem.baseDisp(X86Encode.r13(), 16))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x4D, 0x0F, 0xAF, 0x65, 0x10]), "imul r12, qword [r13+16]")

  // aluRi16, aluRm8 (spl/bpl/sil/dil REX 0x40 + r8), aluRm16, aluMi16, testRr16, mul8/imulOne8 REX 0x40.
  buf = Bytes.make()
  run X86Encode.aluRi16(&mut buf, Alu.Cmp, X86Encode.rax(), -1)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x83, 0xF8, 0xFF]), "cmp ax, -1")
  buf = Bytes.make()
  run X86Encode.aluRi16(&mut buf, Alu.Cmp, X86Encode.rax(), 128)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x81, 0xF8, 0x80, 0x00]), "cmp ax, 128")
  buf = Bytes.make()
  run X86Encode.aluRi16(&mut buf, Alu.Cmp, X86Encode.r8(), -1)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x41, 0x83, 0xF8, 0xFF]), "cmp r8w, -1")
  buf = Bytes.make()
  run X86Encode.aluRi16(&mut buf, Alu.Cmp, X86Encode.r8(), 0x1234)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x41, 0x81, 0xF8, 0x34, 0x12]), "cmp r8w, 0x1234")
  buf = Bytes.make()
  drop run X86Encode.aluRm8(&mut buf, Alu.Cmp, X86Encode.rsi(), Mem.baseDisp(X86Encode.rbp(), -8))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x40, 0x3A, 0x75, 0xF8]), "cmp sil, byte [rbp-8]")
  buf = Bytes.make()
  drop run X86Encode.aluRm8(&mut buf, Alu.Cmp, X86Encode.rdi(), Mem.baseDisp(X86Encode.rbp(), -8))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x40, 0x3A, 0x7D, 0xF8]), "cmp dil, byte [rbp-8]")
  buf = Bytes.make()
  drop run X86Encode.aluRm8(&mut buf, Alu.Cmp, X86Encode.rsp(), Mem.baseDisp(X86Encode.rbp(), -8))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x40, 0x3A, 0x65, 0xF8]), "cmp spl, byte [rbp-8]")
  buf = Bytes.make()
  drop run X86Encode.aluRm8(&mut buf, Alu.Cmp, X86Encode.rbp(), Mem.baseDisp(X86Encode.rbp(), -8))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x40, 0x3A, 0x6D, 0xF8]), "cmp bpl, byte [rbp-8]")
  buf = Bytes.make()
  drop run X86Encode.aluRm8(&mut buf, Alu.Cmp, X86Encode.r8(), Mem.baseDisp(X86Encode.r13(), 0))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x45, 0x3A, 0x45, 0x00]), "cmp r8b, byte [r13]")
  buf = Bytes.make()
  drop run X86Encode.aluRm16(&mut buf, Alu.Cmp, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), -8))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x3B, 0x45, 0xF8]), "cmp ax, word [rbp-8]")
  buf = Bytes.make()
  drop run X86Encode.aluRm16(&mut buf, Alu.Cmp, X86Encode.r8(), Mem.baseDisp(X86Encode.r13(), 0))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x45, 0x3B, 0x45, 0x00]), "cmp r8w, word [r13]")
  buf = Bytes.make()
  drop run X86Encode.aluMi16(&mut buf, Alu.Cmp, Mem.baseDisp(X86Encode.rbp(), -8), 1)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x83, 0x7D, 0xF8, 0x01]), "cmp word [rbp-8], 1")
  buf = Bytes.make()
  drop run X86Encode.aluMi16(&mut buf, Alu.Cmp, Mem.baseDisp(X86Encode.rbp(), -8), 0x1234)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x81, 0x7D, 0xF8, 0x34, 0x12]), "cmp word [rbp-8], 0x1234")
  buf = Bytes.make()
  run X86Encode.testRr16(&mut buf, X86Encode.rax(), X86Encode.rax())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x85, 0xC0]), "test ax, ax")
  buf = Bytes.make()
  run X86Encode.testRr16(&mut buf, X86Encode.r8(), X86Encode.r8())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x45, 0x85, 0xC0]), "test r8w, r8w")
  buf = Bytes.make()
  run X86Encode.mul8(&mut buf, X86Encode.rsi())
  run X86Encode.imulOne8(&mut buf, X86Encode.rdi())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x40, 0xF6, 0xE6, 0x40, 0xF6, 0xEF]), "mul sil; imul dil emit REX 0x40")

  // SIB Mem.baseIndex corner cases (llvm-mc verified: r12/r13/rbp base & index, disp0/disp8/disp32).
  buf = Bytes.make()
  drop run X86Encode.movRm64(&mut buf, X86Encode.rax(), Mem.baseIndex(X86Encode.r13(), X86Encode.r12(), 8, 0))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x4B, 0x8B, 0x44, 0xE5, 0x00]), "mov rax, [r13 + r12*8]")
  buf = Bytes.make()
  drop run X86Encode.movRm64(&mut buf, X86Encode.rax(), Mem.baseIndex(X86Encode.rbp(), X86Encode.r12(), 2, 0))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x4A, 0x8B, 0x44, 0x65, 0x00]), "mov rax, [rbp + r12*2]")
  buf = Bytes.make()
  drop run X86Encode.movRm64(&mut buf, X86Encode.rax(), Mem.baseIndex(X86Encode.r12(), X86Encode.r13(), 4, -128))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x4B, 0x8B, 0x44, 0xAC, 0x80]), "mov rax, [r12 + r13*4 - 128]")
  buf = Bytes.make()
  drop run X86Encode.movRm64(&mut buf, X86Encode.rax(), Mem.baseIndex(X86Encode.r12(), X86Encode.r12(), 1, 1000))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x4B, 0x8B, 0x84, 0x24, 0xE8, 0x03, 0x00, 0x00]), "mov rax, [r12 + r12*1 + 1000]")
  buf = Bytes.make()
  drop run X86Encode.movMr8(&mut buf, Mem.baseIndex(X86Encode.r13(), X86Encode.r12(), 1, 0), X86Encode.rsi())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x43, 0x88, 0x74, 0x25, 0x00]), "mov byte [r13 + r12*1], sil")
  buf = Bytes.make()
  drop run X86Encode.movsdRm(&mut buf, 9, Mem.baseIndex(X86Encode.r13(), X86Encode.r12(), 8, 0))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xF2, 0x47, 0x0F, 0x10, 0x4C, 0xE5, 0x00]), "movsd xmm9, [r13 + r12*8]")
  buf = Bytes.make()
  drop run X86Encode.movMi64(&mut buf, Mem.baseIndex(X86Encode.r13(), X86Encode.r12(), 4, 8), 42)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x4B, 0xC7, 0x44, 0xA5, 0x08, 0x2A, 0x00, 0x00, 0x00]), "mov qword [r13 + r12*4 + 8], 42")
  buf = Bytes.make()
  drop run X86Encode.movzxRm8(&mut buf, X86Encode.rax(), Mem.baseIndex(X86Encode.r13(), X86Encode.r12(), 1, 0))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x43, 0x0F, 0xB6, 0x44, 0x25, 0x00]), "movzx eax, byte [r13 + r12*1]")
}

test effect fn assemblesStdlibInlineAsmTemplates() -> () ! UnsupportedAsm | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run asmClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn asmClaims() -> () ! UnsupportedAsm | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // Parse constraints & clobbers for syscall3: "={rax},0,{rdi},{rsi},{rdx}" / "rcx,r11,flags".
  let constraints = run X86Asm.parseConstraints(b"={rax},0,{rdi},{rsi},{rdx}", true)
  let cs = List<X86Asm.Constraint>.asSlice(&constraints)
  run Testing.expect(cs.length == 5, "five constraints parsed")
  run Testing.expect(cs[0].kind == ConstraintKind.FixedReg && cs[0].reg == X86Encode.rax() && cs[0].isOutput, "output rax")
  run Testing.expect(cs[1].kind == ConstraintKind.TiedOutput, "tied operand 0")
  run Testing.expect(cs[2].kind == ConstraintKind.FixedReg && cs[2].reg == X86Encode.rdi(), "input rdi")
  let mask = X86Asm.parseClobberMask(b"rcx,r11,flags")
  run Testing.expect(mask == (2 | 2048), "clobber mask captures rcx (1) and r11 (11)")

  // Assemble rdtsc template from trace/record.silk.
  let mut code = Bytes.make()
  let mut relocs = List<AsmCallReloc>.make()
  run X86Asm.assemble(&mut code, &mut relocs, b"rdtsc\nshlq $$32, %rdx\norq %rdx, %rax", &[])
  run Testing.expect(sameBytes(Bytes.asSlice(&code), &[0x0F, 0x31, 0x48, 0xC1, 0xE2, 0x20, 0x48, 0x09, 0xD0]),
    "rdtsc + shlq + orq bytes match x86-64")

  // Assemble cpuid template from simd/cpu.silk (semicolon-separated).
  code = Bytes.make()
  run X86Asm.assemble(&mut code, &mut relocs, b"movq %rbx, %r8; movl %r9d, %ecx; cpuid; movl %ebx, %eax; movq %r8, %rbx", &[])
  run Testing.expect(Bytes.length(&code) > usize.ZERO, "cpuid template assembles cleanly")

  // Assemble leaq ($1,$2), $0 and movq $1, $0 with memory operand.
  code = Bytes.make()
  let bindings = [
    OperandBinding {reg: X86Encode.rax(), isMemory: false},
    OperandBinding {reg: X86Encode.rdi(), isMemory: false},
    OperandBinding {reg: X86Encode.rsi(), isMemory: false},
  ]
  run X86Asm.assemble(&mut code, &mut relocs, b"leaq ($1,$2), $0", &bindings)
  run Testing.expect(sameBytes(Bytes.asSlice(&code), &[0x48, 0x8D, 0x04, 0x37]), "leaq (%rdi,%rsi), %rax")

  code = Bytes.make()
  let memBindings = [
    OperandBinding {reg: X86Encode.rax(), isMemory: false},
    OperandBinding {reg: X86Encode.rdi(), isMemory: true},
  ]
  run X86Asm.assemble(&mut code, &mut relocs, b"movq $1, $0", &memBindings)
  run Testing.expect(sameBytes(Bytes.asSlice(&code), &[0x48, 0x8B, 0x07]), "movq (%rdi), %rax")

  // Assemble linux/start.silk template with symbolic call relocation.
  code = Bytes.make()
  relocs = List<AsmCallReloc>.make()
  run X86Asm.assemble(&mut code, &mut relocs, b"movq %rsp, %rdi\nandq $$-16, %rsp\ncall silk_raw_process_entry\nud2", &[])
  run Testing.expect(List<AsmCallReloc>.length(&relocs) == usize.ONE, "start template records call relocation")
  run Testing.expect(sameBytes(Bytes.asSlice(&List<AsmCallReloc>.asSlice(&relocs)[0].symbol), b"silk_raw_process_entry"),
    "call relocation targets silk_raw_process_entry")

  // Segment-override memory operands (%fs:0 TLS self-pointer, %gs:disp32, %fs:disp(%base))
  // and software prefetch instructions used by lib-silkjs and runtime TLS helpers.
  let raxOut = [OperandBinding {reg: X86Encode.rax(), isMemory: false}]
  code = Bytes.make()
  run X86Asm.assemble(&mut code, &mut relocs, b"movq %fs:0, $0", &raxOut)
  run Testing.expect(sameBytes(Bytes.asSlice(&code), &[0x64, 0x48, 0x8B, 0x04, 0x25, 0x00, 0x00, 0x00, 0x00]),
    "movq %fs:0, %rax emits FS prefix + SIB disp32-only encoding")

  let r9Out = [OperandBinding {reg: X86Encode.r9(), isMemory: false}]
  code = Bytes.make()
  run X86Asm.assemble(&mut code, &mut relocs, b"movq %gs:40, $0", &r9Out)
  run Testing.expect(sameBytes(Bytes.asSlice(&code), &[0x65, 0x4C, 0x8B, 0x0C, 0x25, 0x28, 0x00, 0x00, 0x00]),
    "movq %gs:40, %r9 emits GS prefix + REX.WR + SIB disp32-only encoding")

  code = Bytes.make()
  run X86Asm.assemble(&mut code, &mut relocs, b"movl %fs:16(%rdi), $0", &raxOut)
  run Testing.expect(sameBytes(Bytes.asSlice(&code), &[0x64, 0x8B, 0x47, 0x10]),
    "movl %fs:16(%rdi), %eax emits FS prefix + base+disp8 encoding")

  let rdiPtr = [OperandBinding {reg: X86Encode.rdi(), isMemory: false}]
  code = Bytes.make()
  run X86Asm.assemble(&mut code, &mut relocs, b"prefetchnta ($0)\nprefetcht0 ($0)\nprefetcht1 ($0)\nprefetcht2 ($0)\nprefetchw 64($0)", &rdiPtr)
  run Testing.expect(sameBytes(Bytes.asSlice(&code), &[
    0x0F, 0x18, 0x07,
    0x0F, 0x18, 0x0F,
    0x0F, 0x18, 0x17,
    0x0F, 0x18, 0x1F,
    0x0F, 0x0D, 0x4F, 0x40,
  ]), "prefetchnta/t0/t1/t2 and prefetchw emit exact 0F 18 /0..3 and 0F 0D /1 encodings")
}

test effect fn roundTripsFragmentsAndWritesValidElf64Object() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run elfClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn elfClaims() -> () ! Unsupported | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // Build one fragment containing `add_two(rdi, rsi) -> rax = rdi + rsi` + one data object.
  let mut code = Bytes.make()
  run X86Encode.push(&mut code, X86Encode.rbp())
  run X86Encode.movRr64(&mut code, X86Encode.rbp(), X86Encode.rsp())
  run X86Encode.movRr64(&mut code, X86Encode.rax(), X86Encode.rdi())
  run X86Encode.aluRr64(&mut code, Alu.Add, X86Encode.rax(), X86Encode.rsi())
  run X86Encode.leave(&mut code)
  run X86Encode.ret(&mut code)

  let mut frag = Fragment.make()
  run List<Function>.append(&mut frag.functions, Function {
    symbol: run Bytes.copy(b"add_two"),
    exported: run Bytes.copy(b"add_two"),
    code: move code,
    relocations: List<Relocation>.make(),
    symbols: List<Bytes>.make(),
    rodata: Bytes.make(),
    rodataJumps: List<RodataJumpEntry>.make(),
    unwind: UnwindInfo.frameOnly(),
    locations: List<u64>.make(),
  })
  let mut img = Bytes.make()
  run X86Encode.u64Le(&mut img, 42)
  run List<Object>.append(&mut frag.objects, Object {
    symbol: run Bytes.copy(b"answer_global"),
    alignment: 8,
    image: move img,
    pointers: List<Pointer>.make(),
    framed: false,
    local: false,
    readonly: true,
    seen: false,
  })
  run List<Bytes>.append(&mut frag.declaredObjects, run Bytes.copy(b"extern_var"))

  // Round-trip encode/decode.
  let encoded = run frag.encode()
  run Testing.expect(run X86Object.declaresObject(Bytes.asSlice(&encoded), b"extern_var"), "declaresObject finds extern_var")
  let decoded = run X86Object.decode(Bytes.asSlice(&encoded))
  run Testing.expect(List<Function>.length(&decoded.functions) == usize.ONE, "decoded 1 function")
  run Testing.expect(List<Object>.length(&decoded.objects) == usize.ONE, "decoded 1 object")

  // Pack into ELF64 .o and verify header invariants.
  let elf = run X86ElfObject.pack(Bytes.asSlice(&encoded))
  let bytes = Bytes.asSlice(&elf)
  run Testing.expect(bytes.length > 64, "ELF64 output has header + sections")
  run Testing.expect(bytes[0] == 0x7F && bytes[1] == 0x45 && bytes[2] == 0x4C && bytes[3] == 0x46, "ELF magic")
  run Testing.expect(bytes[4] == 2 && bytes[5] == 1, "ELFCLASS64 + ELFDATA2LSB")
  run Testing.expect(bytes[16] == 1 && bytes[17] == 0, "ET_REL")
  run Testing.expect(bytes[18] == 62 && bytes[19] == 0, "EM_X86_64")
  run Testing.expect(bytes[60] == 18 && bytes[61] == 0, "18 section headers (including silk_seen)")

  // Unwind CIE + FDE check.
  let mut eh = Bytes.make()
  run X86Unwind.appendCie(&mut eh)
  let cieLen = Bytes.length(&eh)
  run Testing.expect(cieLen >= 16 && cieLen % 8 == usize.ZERO, "CIE is 8-byte aligned")
  let fdeRel = run X86Unwind.appendFde(&mut eh, 12, UnwindInfo.frameOnly())
  run Testing.expect(fdeRel == cieLen + 8, "FDE initial_location sits at CIE_end + 8")
  run Testing.expect(Bytes.length(&eh) % 8 == usize.ZERO, "FDE is 8-byte aligned")

  // Ensure refusal entries in a fragment fail `pack` with `Unsupported`.
  let mut bad = Fragment.make()
  run List<Bytes>.append(&mut bad.refused, run Bytes.copy(b"test refusal"))
  let badBytes = run bad.encode()
  let refused = match move run Effect.result(X86ElfObject.pack(Bytes.asSlice(&badBytes))) {
    Result<Bytes, Unsupported | OutOfMemoryError>.Success {..} => false
    Result<Bytes, Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported _ => true
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(refused, "pack refuses fragments carrying refusal records")
}

test effect fn encodesSprint3VexBmiAvx2AndSse41() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sprint3EncodeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sprint3EncodeClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // 3-op imul, lea32, SSE2/SSE4.1 byte shifts & blend, pinsrw.
  let mut buf = Bytes.make()
  run X86Encode.imulRri64(&mut buf, X86Encode.rax(), X86Encode.rsi(), 7)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x48, 0x6B, 0xC6, 0x07]), "imulq $7, %rsi, %rax")

  buf = Bytes.make()
  run X86Encode.imulRri32(&mut buf, X86Encode.r9(), X86Encode.r8(), 0x12345)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x45, 0x69, 0xC8, 0x45, 0x23, 0x01, 0x00]), "imull $0x12345, %r8d, %r9d")

  buf = Bytes.make()
  drop run X86Encode.lea32(&mut buf, X86Encode.rax(), Mem.baseIndex(X86Encode.rdi(), X86Encode.rsi(), 1, 0))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x8D, 0x04, 0x37]), "leal (%rdi,%rsi), %eax")

  buf = Bytes.make()
  run X86Encode.pslldq(&mut buf, 4, 3)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x0F, 0x73, 0xFC, 0x03]), "pslldq $3, %xmm4")

  buf = Bytes.make()
  run X86Encode.psrldq(&mut buf, 9, 13)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x41, 0x0F, 0x73, 0xD9, 0x0D]), "psrldq $13, %xmm9")

  buf = Bytes.make()
  run X86Encode.shufpd(&mut buf, 4, 5, 1)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x0F, 0xC6, 0xE5, 0x01]), "shufpd $1, %xmm5, %xmm4")

  buf = Bytes.make()
  run X86Encode.pblendvb(&mut buf, 4, 5)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x0F, 0x38, 0x10, 0xE5]), "pblendvb %xmm0, %xmm5, %xmm4")

  buf = Bytes.make()
  run X86Encode.pinsrw(&mut buf, 4, X86Encode.rax(), 2)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x0F, 0xC4, 0xE0, 0x02]), "pinsrw $2, %eax, %xmm4")

  // BMI1 / LZCNT / POPCNT / BMI2.
  buf = Bytes.make()
  run X86Encode.tzcnt64(&mut buf, X86Encode.rax(), X86Encode.rsi())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xF3, 0x48, 0x0F, 0xBC, 0xC6]), "tzcntq %rsi, %rax")

  buf = Bytes.make()
  run X86Encode.lzcnt32(&mut buf, X86Encode.r9(), X86Encode.r8())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xF3, 0x45, 0x0F, 0xBD, 0xC8]), "lzcntl %r8d, %r9d")

  buf = Bytes.make()
  run X86Encode.popcnt32(&mut buf, X86Encode.rax(), X86Encode.rsi())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xF3, 0x0F, 0xB8, 0xC6]), "popcntl %esi, %eax")

  buf = Bytes.make()
  run X86Encode.andn64(&mut buf, X86Encode.rax(), X86Encode.rsi(), X86Encode.rdx())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xC4, 0xE2, 0xC8, 0xF2, 0xC2]), "andnq %rdx, %rsi, %rax")

  buf = Bytes.make()
  drop run X86Encode.andnRm64(&mut buf, X86Encode.r9(), X86Encode.r8(), Mem.baseDisp(X86Encode.rbp(), -16))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xC4, 0x62, 0xB8, 0xF2, 0x4D, 0xF0]), "andnq -16(%rbp), %r8, %r9")

  buf = Bytes.make()
  run X86Encode.rorx64(&mut buf, X86Encode.rax(), X86Encode.rsi(), 17)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xC4, 0xE3, 0xFB, 0xF0, 0xC6, 0x11]), "rorxq $17, %rsi, %rax")

  buf = Bytes.make()
  drop run X86Encode.rorxRm64(&mut buf, X86Encode.r9(), Mem.baseDisp(X86Encode.rbp(), -16), 17)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xC4, 0x63, 0xFB, 0xF0, 0x4D, 0xF0, 0x11]), "rorxq $17, -16(%rbp), %r9")

  buf = Bytes.make()
  run X86Encode.shlx64(&mut buf, X86Encode.rax(), X86Encode.rsi(), X86Encode.rdx())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xC4, 0xE2, 0xE9, 0xF7, 0xC6]), "shlxq %rdx, %rsi, %rax")

  buf = Bytes.make()
  run X86Encode.shrx64(&mut buf, X86Encode.r10(), X86Encode.r9(), X86Encode.r8())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xC4, 0x42, 0xBB, 0xF7, 0xD1]), "shrxq %r8, %r9, %r10")

  // AVX2 256-bit YMM & VEX GP-to-XMM.
  buf = Bytes.make()
  run X86Encode.vzeroupper(&mut buf)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xC5, 0xF8, 0x77]), "vzeroupper")

  buf = Bytes.make()
  drop run X86Encode.vmovdquYmmRm(&mut buf, 4, Mem.baseDisp(X86Encode.rbp(), -32))
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xC5, 0xFE, 0x6F, 0x65, 0xE0]), "vmovdqu -32(%rbp), %ymm4")

  buf = Bytes.make()
  drop run X86Encode.vmovdquYmmMr(&mut buf, Mem.baseDisp(X86Encode.rbp(), -32), 9)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xC5, 0x7E, 0x7F, 0x4D, 0xE0]), "vmovdqu %ymm9, -32(%rbp)")

  buf = Bytes.make()
  run X86Encode.vmovdqaYmmRr(&mut buf, 4, 5)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xC5, 0xFD, 0x6F, 0xE5]), "vmovdqa %ymm5, %ymm4")

  buf = Bytes.make()
  run X86Encode.vpaddYmm(&mut buf, 4, 4, 5, 6)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xC5, 0xD5, 0xFE, 0xE6]), "vpaddd %ymm6, %ymm5, %ymm4")

  buf = Bytes.make()
  run X86Encode.vpxorYmm(&mut buf, 7, 8, 9)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xC4, 0xC1, 0x3D, 0xEF, 0xF9]), "vpxor %ymm9, %ymm8, %ymm7")

  buf = Bytes.make()
  run X86Encode.vpsllImmYmm(&mut buf, 4, 4, 5, 12)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xC5, 0xDD, 0x72, 0xF5, 0x0C]), "vpslld $12, %ymm5, %ymm4")

  buf = Bytes.make()
  run X86Encode.vpshufbYmm(&mut buf, 4, 8, 9)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xC4, 0xC2, 0x3D, 0x00, 0xE1]), "vpshufb %ymm9, %ymm8, %ymm4")

  buf = Bytes.make()
  run X86Encode.vpbroadcastYmm(&mut buf, 4, 4, 0)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xC4, 0xE2, 0x7D, 0x58, 0xE0]), "vpbroadcastd %xmm0, %ymm4")

  buf = Bytes.make()
  run X86Encode.vmovdXmmGp(&mut buf, 0, X86Encode.r8())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xC4, 0xC1, 0x79, 0x6E, 0xC0]), "vmovd %r8d, %xmm0")

  buf = Bytes.make()
  run X86Encode.vmovqXmmGp(&mut buf, 0, X86Encode.r9())
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0xC4, 0xC1, 0xF9, 0x6E, 0xC1]), "vmovq %r9, %xmm0")
}

test effect fn encodesPhase8NopPadAndSimd128Vex() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run phase8EncodeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn phase8EncodeClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // Multi-byte canonical NOP padding (1..15 bytes).
  let mut buf = Bytes.make()
  run X86Encode.nopPad(&mut buf, 1)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x90]), "nopPad 1 byte")

  buf = Bytes.make()
  run X86Encode.nopPad(&mut buf, 3)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x0F, 0x1F, 0x00]), "nopPad 3 bytes")

  buf = Bytes.make()
  run X86Encode.nopPad(&mut buf, 5)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x0F, 0x1F, 0x44, 0x00, 0x00]), "nopPad 5 bytes")

  buf = Bytes.make()
  run X86Encode.nopPad(&mut buf, 9)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[0x66, 0x0F, 0x1F, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00]), "nopPad 9 bytes")

  buf = Bytes.make()
  run X86Encode.nopPad(&mut buf, 12)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[
    0x66, 0x0F, 0x1F, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x0F, 0x1F, 0x00,
  ]), "nopPad 12 bytes splits into 9+3 canonical NOPs")

  // SSE2 unsigned byte min/max.
  buf = Bytes.make()
  run X86Encode.pminub(&mut buf, 4, 5)
  run X86Encode.pmaxub(&mut buf, 9, 10)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[
    0x66, 0x0F, 0xDA, 0xE5,
    0x66, 0x45, 0x0F, 0xDE, 0xCA,
  ]), "SSE2 pminub and pmaxub with high XMM registers")

  // 128-bit VEX register-register encoders.
  buf = Bytes.make()
  run X86Encode.vpaddXmm(&mut buf, 1, 4, 5, 6)
  run X86Encode.vpsubXmm(&mut buf, 1, 4, 5, 6)
  run X86Encode.vpandXmm(&mut buf, 4, 5, 6)
  run X86Encode.vpandnXmm(&mut buf, 4, 5, 6)
  run X86Encode.vporXmm(&mut buf, 4, 5, 6)
  run X86Encode.vpxorXmm(&mut buf, 4, 5, 6)
  run X86Encode.vpminubXmm(&mut buf, 4, 5, 6)
  run X86Encode.vpmaxubXmm(&mut buf, 4, 5, 6)
  run X86Encode.vpcmpeqXmm(&mut buf, 1, 4, 5, 6)
  run X86Encode.vpmovmskbXmm(&mut buf, X86Encode.rax(), 4)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[
    0xC5, 0xD1, 0xFC, 0xE6,
    0xC5, 0xD1, 0xF8, 0xE6,
    0xC5, 0xD1, 0xDB, 0xE6,
    0xC5, 0xD1, 0xDF, 0xE6,
    0xC5, 0xD1, 0xEB, 0xE6,
    0xC5, 0xD1, 0xEF, 0xE6,
    0xC5, 0xD1, 0xDA, 0xE6,
    0xC5, 0xD1, 0xDE, 0xE6,
    0xC5, 0xD1, 0x74, 0xE6,
    0xC5, 0xF9, 0xD7, 0xC4,
  ]), "128-bit VEX XMM arithmetic, bitwise, min/max, compare, and movmskb encoders")

  // 128-bit VEX register-memory encoders and returned displacement offsets.
  let slotMem = Mem.baseDisp(X86Encode.rbp(), -16)
  buf = Bytes.make()
  let d1 = run X86Encode.vpaddXmmRm(&mut buf, 4, 4, 5, slotMem)
  run Testing.expect(d1 == 4 && sameBytes(Bytes.asSlice(&buf), &[0xC5, 0xD1, 0xFE, 0x65, 0xF0]), "vpaddd -16(%rbp), %xmm5, %xmm4")

  buf = Bytes.make()
  let d2 = run X86Encode.vpsubXmmRm(&mut buf, 4, 4, 5, slotMem)
  run Testing.expect(d2 == 4 && sameBytes(Bytes.asSlice(&buf), &[0xC5, 0xD1, 0xFA, 0x65, 0xF0]), "vpsubd -16(%rbp), %xmm5, %xmm4")

  buf = Bytes.make()
  drop run X86Encode.vpandXmmRm(&mut buf, 4, 5, slotMem)
  drop run X86Encode.vporXmmRm(&mut buf, 4, 5, slotMem)
  drop run X86Encode.vpxorXmmRm(&mut buf, 4, 5, slotMem)
  drop run X86Encode.vpminubXmmRm(&mut buf, 4, 5, slotMem)
  drop run X86Encode.vpmaxubXmmRm(&mut buf, 4, 5, slotMem)
  run Testing.expect(sameBytes(Bytes.asSlice(&buf), &[
    0xC5, 0xD1, 0xDB, 0x65, 0xF0,
    0xC5, 0xD1, 0xEB, 0x65, 0xF0,
    0xC5, 0xD1, 0xEF, 0x65, 0xF0,
    0xC5, 0xD1, 0xDA, 0x65, 0xF0,
    0xC5, 0xD1, 0xDE, 0x65, 0xF0,
  ]), "128-bit VEX memory-operand bitwise and byte min/max encoders")

  buf = Bytes.make()
  let ripDisp = run X86Encode.vpcmpeqXmmRm(&mut buf, 1, 4, 5, Mem.ripRel(0))
  run Testing.expect(ripDisp == 4 && sameBytes(Bytes.asSlice(&buf), &[0xC5, 0xD1, 0x74, 0x25, 0x00, 0x00, 0x00, 0x00]),
    "vpcmpeqb (%rip), %xmm5, %xmm4 returns exact RIP disp32 offset")
}


