//! Body-independent definition identity and direct-reference symbol inputs.
import backend.Gap {Code, Gap}
import backend.InstanceKey {InstanceKey}
import lexer.Span {Span}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.usize

/// The symbol an instance is defined and referenced by. The canonical encoding it is derived from
/// is content input only and is not retained.
pub struct InstanceIdentity {
  pub key: InstanceKey
  pub symbol: Bytes
}

impl InstanceIdentity {
  /// The identity of `key`, whose canonical encoding is `encoding`.
  pub effect fn make(key: &InstanceKey, encoding: &[u8]) -> InstanceIdentity
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut selected = run InstanceKey.contentName(encoding)
    if InstanceKey.fixedLinkage(key) {
      selected = run InstanceKey.symbol(key)
    }
    return InstanceIdentity {key: InstanceKey.copy(key), symbol: move selected}
  }
  /// Every instruction reference is supplied by the instance preparation query.
  pub effect fn name(values: &[InstanceIdentity], key: &InstanceKey) -> Bytes
  ! Gap | OutOfMemoryError
  ? &mut Allocator {
    let mut at = usize.ZERO
    while at < values.length {
      if run InstanceKey.sameApplication(&values[at].key, key) {
        return run Bytes.copy(Bytes.asSlice(&values[at].symbol))
      }
      at = at + usize.ONE
    }
    let owner = InstanceKey.identity(key)
    fail Gap.make(Code.CalleeModule, &owner, Span.make(usize.ZERO, usize.ZERO))
  }
}
