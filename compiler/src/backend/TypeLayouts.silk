//! The neutral layouts one instance's text reads, found by runtime type.
import semantic.Types {Types}
import backend.Layout {Field, Layout, Storage, TypeLayout}
import semantic.InternIndex {InternIndex}
import semantic.Type {Type}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.option {Option}
import silk.core.ownership {Copy}
import silk.mem.shared {Shared}
import silk.num.usize
import silk.collections.list {List}

/// `length` bytes at `offset` of a value.
pub struct DataSpan {
  pub offset: usize,
  pub length: usize,
}

impl Copy for DataSpan {}

/// The supplied layouts of one instance, bucketed by the runtime hash of their types.
pub struct TypeLayouts {
  values: List<TypeLayout>,
  lookup: InternIndex,
}

impl TypeLayouts {
  /// Creates a list that supplies no layout.
  pub fn make() -> TypeLayouts {
    return TypeLayouts {values: List<TypeLayout>.make(), lookup: InternIndex.make()}
  }
  /// Supplies every layout of `values`, in order.
  pub effect fn copyOf(values: &[TypeLayout]) -> TypeLayouts ! OutOfMemoryError ? &mut Allocator {
    let mut result = TypeLayouts.make()
    let mut at = usize.ZERO
    while at < values.length {
      run TypeLayouts.append(&mut result,
        TypeLayout {ty: Shared<Type>.clone(&values[at].ty), layout: Shared<Layout>.clone(&values[at].layout)})
      at = at + usize.ONE
    }
    return move result
  }
  /// Supplies one more layout after those already listed.
  pub effect fn append(self: &mut Self, layout: TypeLayout) -> () ! OutOfMemoryError ? &mut Allocator {
    let hashed = Type.hash(&layout.ty)
    run List<TypeLayout>.append(&mut self.values, move layout)
    run InternIndex.record(&mut self.lookup, hashed)
    return ()
  }
  /// Borrows the layouts in the order they were supplied.
  pub fn list(self: &Self) -> &[TypeLayout] {
    return List<TypeLayout>.asSlice(&self.values)
  }
  /// Returns the number of supplied layouts.
  pub fn length(self: &Self) -> usize {
    return List<TypeLayout>.length(&self.values)
  }
  /// Returns the first supplied layout whose type is runtime-equal to `ty`, or `usize.MAX`.
  ///
  /// # Details
  ///
  /// Runtime-equal types share a hash, so only layouts recorded under `ty`'s hash are compared,
  /// in supply order. With [`nextMatching`] this visits exactly the layouts a scan of the whole
  /// list comparing each type would, in the same order.
  pub effect fn firstMatching(self: &Self, ty: &Shared<Type>) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
    return run matchingFrom(&self.*, InternIndex.first(&self.lookup, Type.hash(ty)), ty)
  }
  /// Returns the next supplied layout after `after` whose type is runtime-equal to `ty`, or `usize.MAX`.
  pub effect fn nextMatching(self: &Self, after: usize, ty: &Shared<Type>) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
    return run matchingFrom(&self.*, InternIndex.after(&self.lookup, after), ty)
  }
  /// Returns the padding of a record `ty` in offset order: the bytes between its fields and after
  /// the last one, not those inside a field. Returns none when `ty` is not a record or a field has
  /// no supplied layout, and an empty list for a record without padding.
  pub effect fn padding(self: &Self, ty: &Shared<Type>) -> Option<List<DataSpan>>
  ! OutOfMemoryError ? &mut Allocator | &mut Types {
    let at = run TypeLayouts.firstMatching(&self.*, ty)
    if at == usize.MAX { return Option<List<DataSpan>>.none() }
    let layout = &List<TypeLayout>.asSlice(&self.values)[at].layout
    let record = Shared<Layout>.with<bool>(layout,
      fn(value: &Layout) -> bool { return match &value.storage { Storage.Record {..} => true _ => false } })
    if !record { return Option<List<DataSpan>>.none() }
    let size = Shared<Layout>.with<usize>(layout, fn(value: &Layout) -> usize { return value.size })
    let count = Shared<Layout>.with<usize>(layout, Layout.fieldCount)
    let mut gaps = List<DataSpan>.make()
    let mut end = usize.ZERO
    let mut index = usize.ZERO
    while index < count {
      let field = Shared<Layout>.with<Option<Field>>(layout,
        fn(value: &Layout) -> Option<Field> { return Layout.fieldAt(value, index) })
      if let Option<Field>.Some {value} = move field {
        let child = run TypeLayouts.firstMatching(&self.*, &value.ty)
        if child == usize.MAX { return Option<List<DataSpan>>.none() }
        let length = Shared<Layout>.with<usize>(&List<TypeLayout>.asSlice(&self.values)[child].layout,
          fn(child: &Layout) -> usize { return child.size })
        if length != usize.ZERO {
          if value.offset > end { run List<DataSpan>.append(&mut gaps, DataSpan {offset: end, length: value.offset - end}) }
          end = value.offset + length
        }
      }
      index = index + usize.ONE
    }
    if size > end { run List<DataSpan>.append(&mut gaps, DataSpan {offset: end, length: size - end}) }
    return Option<List<DataSpan>>.some(move gaps)
  }
}

// The first layout from `position` along its hash chain whose type is runtime-equal to `ty`.
effect fn matchingFrom(layouts: &TypeLayouts, position: usize, ty: &Shared<Type>) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let listed = List<TypeLayout>.asSlice(&layouts.values)
  let mut at = position
  while at != usize.MAX {
    if run Type.runtimeEqualsShared(&listed[at].ty, ty) {
      return at
    }
    at = InternIndex.after(&layouts.lookup, at)
  }
  return at
}
