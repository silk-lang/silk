//! The neutral layouts one instance's text reads, found by runtime type.
import semantic.Types {Types}
import backend.Layout {Layout, TypeLayout}
import semantic.InternIndex {InternIndex}
import semantic.Type {Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// The supplied layouts of one instance, bucketed by the runtime hash of their types.
pub struct TypeLayouts {
  values: Vector<TypeLayout>
  lookup: InternIndex
}

impl TypeLayouts {
  /// Creates a list that supplies no layout.
  pub fn make() -> TypeLayouts {
    return TypeLayouts {values: Vector<TypeLayout>.make(), lookup: InternIndex.make()}
  }
  /// Supplies every layout of `values`, in order.
  pub effect fn copyOf(values: &[TypeLayout]) -> TypeLayouts ! OutOfMemoryError ? &mut Allocator {
    let mut result = TypeLayouts.make()
    let mut at = usize.ZERO
    while at < values.length {
      run TypeLayouts.append(&mut result,
        TypeLayout {ty: Shared<Type>.clone(&values[at].ty), layout: Shared<Layout>.clone(&values[at].layout)})
      at = at + usize.ONE
    }
    return move result
  }
  /// Supplies one more layout after those already listed.
  pub effect fn append(self: &mut Self, layout: TypeLayout) -> () ! OutOfMemoryError ? &mut Allocator {
    let hashed = Type.hash(&layout.ty)
    run Vector<TypeLayout>.append(&mut self.values, move layout)
    run InternIndex.record(&mut self.lookup, hashed)
    return ()
  }
  /// Borrows the layouts in the order they were supplied.
  pub fn list(self: &Self) -> &[TypeLayout] {
    return Vector<TypeLayout>.asSlice(&self.values)
  }
  /// Returns the number of supplied layouts.
  pub fn length(self: &Self) -> usize {
    return Vector<TypeLayout>.length(&self.values)
  }
  /// Returns the first supplied layout whose type is runtime-equal to `ty`, or `usize.MAX`.
  ///
  /// # Details
  ///
  /// Runtime-equal types share a hash, so only layouts recorded under `ty`'s hash are compared,
  /// in supply order. With [`nextMatching`] this visits exactly the layouts a scan of the whole
  /// list comparing each type would, in the same order.
  pub effect fn firstMatching(self: &Self, ty: &Shared<Type>) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
    return run matchingFrom(&self.*, InternIndex.first(&self.lookup, Type.hash(ty)), ty)
  }
  /// Returns the next supplied layout after `after` whose type is runtime-equal to `ty`, or `usize.MAX`.
  pub effect fn nextMatching(self: &Self, after: usize, ty: &Shared<Type>) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
    return run matchingFrom(&self.*, InternIndex.after(&self.lookup, after), ty)
  }
}

// The first layout from `position` along its hash chain whose type is runtime-equal to `ty`.
effect fn matchingFrom(layouts: &TypeLayouts, position: usize, ty: &Shared<Type>) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let listed = Vector<TypeLayout>.asSlice(&layouts.values)
  let mut at = position
  while at != usize.MAX {
    if run Type.runtimeEqualsShared(&listed[at].ty, ty) {
      return at
    }
    at = InternIndex.after(&layouts.lookup, at)
  }
  return at
}
