//! Inlines closed forwarding calls before suspendable frames are laid out.
//!
//! # Details
//!
//! The caller supplies an acyclic selection of callees. Each splice shares the caller's success
//! and failure destinations, gives the callee's other locals fresh slots, and chains the callee's
//! cancellation cleanup into the caller's cancellation exit. Hidden diagnostic operands and
//! carried failure contexts follow their original edges. Bodies with their own observed trap or
//! failure sites, and builds with source line tables, retain their call boundaries.

import CompilerBug
import hir.Hir { InfixOperator }
import backend.InstanceKey { InstanceKey }
import backend.Mir {
  AggregateField,
  Block,
  Callee,
  Cancel,
  FailureEdge,
  Inlining,
  Local,
  LocalKind,
  MirDraft, MirView,
  Operand,
  Place,
  Projection,
  Reference,
  Rvalue,
  Statement,
  SwitchCase,
  Terminator,
  Variable,
  Diagnostics,
  ContextText,
}
import semantic.DeclarationId { DeclarationId }
import semantic.Specialization { Edge }
import semantic.Type { Type }
import semantic.StaticValue { Value as StaticData }
import silk.num.u64
import semantic.TypedBody { Origin }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.interned {Interned}
import silk.num.usize

/// Whether a body may share its caller's frame. The caller must also exclude recursive targets.
pub fn eligible(function: &MirView<'_>) -> bool {
  return function.body.inlining == Inlining.Always && safeBody(function)
}

/// Whether a small synchronous constructor or value-forwarding body can be spliced before frame
/// layout. Its caller must exclude recursive expansions and preserve explicit no-inline directives.
/// LLVM inlining alone happens too late to coalesce these callbacks' aggregate destinations.
pub fn valueForwarder(function: &MirView<'_>) -> bool {
  if function.body.inlining == Inlining.Never || function.body.inlining == Inlining.Cold
    || !safeBody(function)
    || List<Cancel>.length(&function.body.cancels) != 0 {
    return false
  }
  let blocks = List<Block>.asSlice(&function.body.blocks)
  if blocks.length > 2 {
    return false
  }
  let mut at = usize.ZERO
  while at < blocks.length {
    match &blocks[at].terminator {
      Terminator.Return { .. } => ()
      Terminator.Call {
        callee: Callee.Instance { .. },
        destination,
        normal,
        failure: Option.None,
        ..
      } => {
        if whole(&destination) != 0 || normal >= blocks.length {
          return false
        }
        if List<Statement>.length(&blocks[normal].statements) != 0 {
          return false
        }
        if let Terminator.Return { .. } = &blocks[normal].terminator {} else {
          return false
        }
      }
      _ => {
        return false
      }
    }
    let statements = List<Statement>.asSlice(&blocks[at].statements)
    if statements.length > 8 {
      return false
    }
    let mut next = usize.ZERO
    while next < statements.length {
      match &statements[next] {
        Statement.Assign { value: Rvalue.Use { .. }, .. } => ()
        Statement.Assign { value: Rvalue.Aggregate { .. }, .. } => ()
        Statement.Assign { value: Rvalue.Variant { .. }, .. } => ()
        Statement.Assign { value: Rvalue.Inject { .. }, .. } => ()
        _ => {
          return false
        }
      }
      next = next + 1
    }
    at = at + 1
  }
  return true
}

fn safeBody(function: &MirView<'_>) -> bool {
  if function.body.optimizeSize || Bytes.length(&function.body.features) != 0
    || List<ContextText>.length(&function.body.contexts) != 0
    || List<Variable>.length(&function.body.variables) != 0
    || List<u64>.length(&function.body.lines) != 0 {
    return false
  }
  if let Option<Origin>.Some { .. } = &function.logical.suspension {
    return false
  }
  if let Option<Origin>.Some { .. } = &function.logical.parks {
    return false
  }
  let blocks = List<Block>.asSlice(&function.body.blocks)
  if blocks.length > 64 {
    return false
  }
  let mut at = usize.ZERO
  while at < blocks.length {
    match &blocks[at].terminator {
      Terminator.Call { callee: Callee.Extern { .. }, .. } => {
        return false
      }
      Terminator.Call { callee: Callee.NativeIndirect { .. }, .. } => {
        return false
      }
      Terminator.Relinquish { .. } => {
        return false
      }
      Terminator.Trap { .. } => {
        return false
      }
      Terminator.TrapText { .. } => {
        return false
      }
      _ => ()
    }
    let statements = List<Statement>.asSlice(&blocks[at].statements)
    let mut statement = usize.ZERO
    while statement < statements.length {
      match &statements[statement] {
        // Diagnostic forwarding compares pointers to null. Those comparisons cannot trap,
        // even though lowering records a site for every Binary. Other checked operations keep
        // their own function's observer, cause and site when reporting a trap.
        Statement.Assign { value: Rvalue.Binary { operation, .. }, .. } => {
          if Bytes.length(&function.body.frame) != 0 && !comparison(operation) {
            return false
          }
        }
        Statement.Assign { value: Rvalue.Unary { .. }, .. } => {
          if Bytes.length(&function.body.frame) != 0 {
            return false
          }
        }
        Statement.Assign { value: Rvalue.ScalarBinary { .. }, .. } => {
          if Bytes.length(&function.body.frame) != 0 {
            return false
          }
        }
        Statement.Assign { value: Rvalue.Convert { .. }, .. } => {
          if Bytes.length(&function.body.frame) != 0 {
            return false
          }
        }
        Statement.Assign { value: Rvalue.Vector { .. }, .. } => {
          if Bytes.length(&function.body.frame) != 0 {
            return false
          }
        }
        Statement.Assign { value: Rvalue.FrameAddress, .. } => {
          return false
        }
        Statement.Assign { value: Rvalue.ProcessWord, .. } => {
          return false
        }
        Statement.Assign { value: Rvalue.StackAllocate { .. }, .. } => {
          return false
        }
        Statement.Assign { value: Rvalue.RunningPackage, .. } => {
          return false
        }
        Statement.Assign { value: Rvalue.Assembly { .. }, .. } => {
          return false
        }
        Statement.FailureContext { source: Option.None, .. } => {
          return false
        }
        _ => ()
      }
      statement = statement + 1
    }
    at = at + 1
  }
  return true
}

fn comparison(operation: InfixOperator) -> bool {
  return match operation {
    InfixOperator.Equals => true
    InfixOperator.NotEquals => true
    InfixOperator.LessThan => true
    InfixOperator.LessOrEqual => true
    InfixOperator.GreaterThan => true
    InfixOperator.GreaterOrEqual => true
    _ => false
  }
}

struct Splice {
  locals: List<usize>,
  blocks: usize,
  normal: usize,
  failure: usize,
  cancel: usize,
  origin: Origin,
}

effect fn path(source: &List<Projection>, splice: &Splice) -> List<Projection>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = List<Projection>.make()
  let listed = List<Projection>.asSlice(source)
  let mut at = usize.ZERO
  while at < listed.length {
    let step = match &listed[at] {
      Projection.Field { index } => Projection.Field { index: index }
      Projection.Payload { index, ty } => Projection.Payload {
        index: index,
        ty: Interned<Type>.clone(&ty),
      }
      Projection.VariantField { variant, field } => Projection.VariantField {
        variant: variant,
        field: field,
      }
      Projection.Index { local } => Projection.Index {
        local: List<usize>.get(&splice.locals, local),
      }
      Projection.ConstIndex { index } => Projection.ConstIndex { index: index }
      Projection.Deref => Projection.Deref
    }
    run List<Projection>.append(&mut result, move step)
    at = at + 1
  }
  return move result
}

effect fn place(source: &Place, splice: &Splice) -> Place
  ! OutOfMemoryError
  ? &mut Allocator {
  return Place {
    local: List<usize>.get(&splice.locals, source.local),
    projections: run path(&source.projections, splice),
  }
}

effect fn operand(source: &Operand, splice: &Splice) -> Operand
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &source.* {
    Operand.Copy { place: from } => Operand.Copy { place: run place(&from, splice) }
    Operand.Move { place: from } => Operand.Move { place: run place(&from, splice) }
    Operand.Integer { decimal, negative, ty } => Operand.Integer {
      decimal: run Bytes.copy(Bytes.asSlice(&decimal)),
      negative: negative,
      ty: Interned<Type>.clone(&ty),
    }
    Operand.Float { bits, ty } => Operand.Float { bits: bits, ty: Interned<Type>.clone(&ty) }
    Operand.Boolean { value } => Operand.Boolean { value: value }
    Operand.Unit => Operand.Unit
    Operand.StaticBytes { bytes } => Operand.StaticBytes {
      bytes: run Bytes.copy(Bytes.asSlice(&bytes)),
    }
    Operand.StaticText { bytes } => Operand.StaticText {
      bytes: run Bytes.copy(Bytes.asSlice(&bytes)),
    }
    Operand.StaticValue { value, ty } => Operand.StaticValue {
      value: Interned<StaticData>.clone(&value),
      ty: Interned<Type>.clone(&ty),
    }
    Operand.Null { ty } => Operand.Null { ty: Interned<Type>.clone(&ty) }
  }
}

effect fn operands(source: &List<Operand>, splice: &Splice) -> List<Operand>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = List<Operand>.make()
  let listed = List<Operand>.asSlice(source)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<Operand>.append(&mut result, run operand(&listed[at], splice))
    at = at + 1
  }
  return move result
}

effect fn fields(source: &List<AggregateField>, splice: &Splice) -> List<AggregateField>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = List<AggregateField>.make()
  let listed = List<AggregateField>.asSlice(source)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<AggregateField>.append(
      &mut result,
      AggregateField { index: listed[at].index, value: run operand(&listed[at].value, splice) },
    )
    at = at + 1
  }
  return move result
}

effect fn rvalue(source: &Rvalue, splice: &Splice) -> Rvalue
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &source.* {
    Rvalue.Aggregate { fields: values } => Rvalue.Aggregate { fields: run fields(&values, splice) }
    Rvalue.Slice { data, count } => Rvalue.Slice {
      data: run operand(&data, splice),
      count: run operand(&count, splice),
    }
    Rvalue.SliceLength { place: from } => Rvalue.SliceLength { place: run place(&from, splice) }
    Rvalue.SliceData { place: from } => Rvalue.SliceData { place: run place(&from, splice) }
    Rvalue.PointerOffset { pointer, index, element } => Rvalue.PointerOffset {
      pointer: run operand(&pointer, splice),
      index: run operand(&index, splice),
      element: Interned<Type>.clone(&element),
    }
    Rvalue.Use { value } => Rvalue.Use { value: run operand(&value, splice) }
    Rvalue.Ref { access, place: from } => Rvalue.Ref {
      access: access,
      place: run place(&from, splice),
    }
    Rvalue.AddressOf { access, place: from } => Rvalue.AddressOf {
      access: access,
      place: run place(&from, splice),
    }
    Rvalue.Unary { operation, value } => Rvalue.Unary {
      operation: operation,
      value: run operand(&value, splice),
    }
    Rvalue.Binary { operation, left, right } => Rvalue.Binary {
      operation: operation,
      left: run operand(&left, splice),
      right: run operand(&right, splice),
    }
    Rvalue.ScalarBinary { operation, left, right } => Rvalue.ScalarBinary {
      operation: operation,
      left: run operand(&left, splice),
      right: run operand(&right, splice),
    }
    Rvalue.ScalarUnary { operation, value } => Rvalue.ScalarUnary {
      operation: operation,
      value: run operand(&value, splice),
    }
    Rvalue.Convert { value, ty } => Rvalue.Convert {
      value: run operand(&value, splice),
      ty: Interned<Type>.clone(&ty),
    }
    Rvalue.Fits { value, ty } => Rvalue.Fits {
      value: run operand(&value, splice),
      ty: Interned<Type>.clone(&ty),
    }
    Rvalue.AddressIntegerConversion {
      operand: value,
      destinationType
    } => Rvalue.AddressIntegerConversion {
      operand: run operand(&value, splice),
      destinationType: Interned<Type>.clone(&destinationType),
    }
    Rvalue.Bitcast { value, ty } => Rvalue.Bitcast {
      value: run operand(&value, splice),
      ty: Interned<Type>.clone(&ty),
    }
    Rvalue.Discriminant { place: from } => Rvalue.Discriminant { place: run place(&from, splice) }
    Rvalue.Inject { tag, value } => Rvalue.Inject { tag: tag, value: run operand(&value, splice) }
    Rvalue.Variant { tag, fields: values } => Rvalue.Variant {
      tag: tag,
      fields: run fields(&values, splice),
    }
    Rvalue.FunctionAddress { key } => Rvalue.FunctionAddress { key: InstanceKey.copy(&key) }
    Rvalue.ContextOf { place: from } => Rvalue.ContextOf { place: run place(&from, splice) }
    Rvalue.ContextHandle { address } => Rvalue.ContextHandle {
      address: run operand(&address, splice),
    }
    Rvalue.ForeignStatic { declaration, address } => Rvalue.ForeignStatic {
      declaration: Interned<DeclarationId>.clone(&declaration),
      address: address,
    }
    Rvalue.Fill { byte } => Rvalue.Fill { byte: byte }
    Rvalue.Wasm { primitive, operands: values } => Rvalue.Wasm {
      primitive: primitive,
      operands: run operands(&values, splice),
    }
    Rvalue.Atomic { primitive, operands: values, success, failure, element } => Rvalue.Atomic {
      primitive: primitive,
      operands: run operands(&values, splice),
      success: success,
      failure: failure,
      element: Interned<Type>.clone(&element),
    }
    Rvalue.Vector { primitive, operands: values, ty } => Rvalue.Vector {
      primitive: primitive,
      operands: run operands(&values, splice),
      ty: Interned<Type>.clone(&ty),
    }
    _ => CompilerBug.panic(b"an ineligible MIR value reached inlining")
  }
}

effect fn diagnostics(source: &Option<Diagnostics>, splice: &Splice) -> Option<Diagnostics>
  ! OutOfMemoryError
  ? &mut Allocator {
  if let Option<Diagnostics>.Some { value } = &source.* {
    return Option<Diagnostics>.some(
      run Diagnostics.make(
        run operand(Diagnostics.observer(&value), splice),
        run operand(Diagnostics.cause(&value), splice),
        run operand(Diagnostics.site(&value), splice),
      ),
    )
  }
  return Option<Diagnostics>.none()
}

effect fn statement(source: &Statement, splice: &Splice) -> Statement
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &source.* {
    Statement.Assign { destination, value, .. } => Statement.Assign {
      destination: run place(&destination, splice),
      value: run rvalue(&value, splice),
      origin: splice.origin,
    }
    Statement.Drop { destination, glue, diagnostics: hidden, .. } => Statement.Drop {
      destination: run place(&destination, splice),
      glue: InstanceKey.copy(&glue),
      diagnostics: run diagnostics(&hidden, splice),
      origin: splice.origin,
    }
    Statement.FailureContext {
      destination,
      source: Option.Some { value: from },
      ..
    } => Statement.FailureContext {
      destination: run place(&destination, splice),
      source: Option<Place>.some(run place(&from, splice)),
      origin: splice.origin,
    }
    Statement.SetContextHandle { address, value, .. } => Statement.SetContextHandle {
      address: run operand(&address, splice),
      value: run operand(&value, splice),
      origin: splice.origin,
    }
    _ => CompilerBug.panic(b"an observed statement reached inlining")
  }
}

effect fn terminator(source: &Terminator, splice: &Splice) -> Terminator
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &source.* {
    Terminator.Goto { target, .. } => Terminator.Goto {
      target: splice.blocks + target,
      origin: splice.origin,
    }
    Terminator.Branch { condition, thenBlock, elseBlock, .. } => Terminator.Branch {
      condition: run operand(&condition, splice),
      thenBlock: splice.blocks + thenBlock,
      elseBlock: splice.blocks + elseBlock,
      origin: splice.origin,
    }
    Terminator.Return { .. } => Terminator.Goto { target: splice.normal, origin: splice.origin }
    Terminator.Fail { .. } => Terminator.Goto { target: splice.failure, origin: splice.origin }
    Terminator.Abandon { .. } => Terminator.Goto { target: splice.cancel, origin: splice.origin }
    Terminator.Trap { reason, .. } => Terminator.Trap { reason: reason, origin: splice.origin }
    Terminator.TrapText { reason, .. } => Terminator.TrapText {
      reason: run operand(&reason, splice),
      origin: splice.origin,
    }
    Terminator.Unreachable { .. } => Terminator.Unreachable { origin: splice.origin }
    Terminator.Switch { value, cases, otherwise, .. } => {
      let mut copied = List<SwitchCase>.make()
      let listed = List<SwitchCase>.asSlice(&cases)
      let mut at = usize.ZERO
      while at < listed.length {
        run List<SwitchCase>.append(
          &mut copied,
          SwitchCase {
            decimal: run Bytes.copy(Bytes.asSlice(&listed[at].decimal)),
            negative: listed[at].negative,
            target: splice.blocks + listed[at].target,
          },
        )
        at = at + 1
      }
      Terminator.Switch {
        value: run operand(&value, splice),
        cases: move copied,
        otherwise: splice.blocks + otherwise,
        origin: splice.origin,
      }
    }
    Terminator.Call {
      callee,
      arguments,
      providers,
      diagnostics: hidden,
      destination,
      normal,
      failure,
      ..
    } => {
      let target = match &callee {
        Callee.Instance { key } => Callee.Instance { key: InstanceKey.copy(&key) }
        Callee.Indirect { address } => Callee.Indirect { address: run operand(&address, splice) }
        _ => {
          return CompilerBug.panic(b"a foreign call reached inlining")
        }
      }
      let mut failed = Option<FailureEdge>.none()
      if let Option<FailureEdge>.Some { value: edge } = &failure {
        failed = Option<FailureEdge>.some(
          FailureEdge {
            destination: run place(&edge.destination, splice),
            target: splice.blocks + edge.target,
          },
        )
      }
      Terminator.Call {
        callee: move target,
        arguments: run operands(&arguments, splice),
        providers: run operands(&providers, splice),
        diagnostics: run diagnostics(&hidden, splice),
        destination: run place(&destination, splice),
        normal: splice.blocks + normal,
        failure: move failed,
        origin: splice.origin,
      }
    }
    Terminator.Relinquish { .. } => CompilerBug.panic(b"a parking origin reached inlining")
  }
}

fn whole(place: &Place) -> usize {
  if List<Projection>.length(&place.projections) != 0 {
    return usize.MAX
  }
  return place.local
}

/// Replaces a direct call at `point` with `callee`'s checked body and cancellation exits.
///
/// The callee must be an eligible acyclic frame body or a synchronous value forwarder. Returns false when the call's destinations are not
/// whole locals or when expanding it would exceed the caller's bounded inlining budget.
pub effect fn call(caller: &mut MirDraft, point: usize, callee: &MirView<'_>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if List<Block>.length(&caller.body.blocks) + List<Block>.length(&callee.body.blocks) > 256 {
    return false
  }
  let mut cancel = usize.MAX
  let mut cancelAt = usize.ZERO
  let cancellations = List<Cancel>.asSlice(&caller.body.cancels)
  while cancelAt < cancellations.length {
    if cancellations[cancelAt].point == point {
      cancel = cancellations[cancelAt].entry
      break
    }
    cancelAt = cancelAt + 1
  }
  if cancel == usize.MAX && !valueForwarder(callee) {
    return false
  }
  let mut mapping = List<usize>.make()
  let mut initialized = List<Statement>.make()
  let mut fresh = List<Local>.make()
  let target = &List<Block>.asSlice(&caller.body.blocks)[point].terminator
  let locals = List<Local>.asSlice(&callee.body.locals)
  let base = List<Local>.length(&caller.body.locals)
  let mut normal = usize.MAX
  let mut failure = usize.MAX
  let mut origin = locals[0].origin
  if let Terminator.Call {
    arguments,
    providers,
    diagnostics: hidden,
    destination,
    normal: continued,
    failure: failed,
    origin: site,
    ..
  } = &target.* {
    if whole(&destination) == usize.MAX {
      return false
    }
    if let Option<FailureEdge>.Some { value: edge } = &failed {
      if whole(&edge.destination) == usize.MAX {
        return false
      }
      failure = edge.target
    }
    normal = continued
    origin = site

    // The identity map copies the caller's already-evaluated operands into the callee's slots.
    let mut identity = List<usize>.make()
    let mut at = usize.ZERO
    while at < base {
      run List<usize>.append(&mut identity, at)
      at = at + 1
    }
    let source = Splice {
      locals: move identity,
      blocks: 0,
      normal: 0,
      failure: 0,
      cancel: 0,
      origin: origin,
    }
    at = usize.ZERO
    while at < locals.length {
      let mut mapped = base + List<Local>.length(&fresh)
      let mut own = true
      let mut input = Option<Operand>.none()
      match &locals[at].kind {
        LocalKind.Return => {
          mapped = destination.local
          own = false
        }
        LocalKind.Failure => {
          if let Option<FailureEdge>.Some { value: edge } = &failed {
            mapped = edge.destination.local
            own = false
          }
        }
        LocalKind.Parameter { index } => {
          input = Option<Operand>.some(
            run operand(&List<Operand>.asSlice(&arguments)[index], &source),
          )
        }
        LocalKind.Provider { index } => {
          input = Option<Operand>.some(
            run operand(&List<Operand>.asSlice(&providers)[index], &source),
          )
        }
        LocalKind.Observer => {
          if let Option<Diagnostics>.Some { value } = &hidden {
            input = Option<Operand>.some(run operand(Diagnostics.observer(&value), &source))
          }
        }
        LocalKind.Cause => {
          if let Option<Diagnostics>.Some { value } = &hidden {
            input = Option<Operand>.some(run operand(Diagnostics.cause(&value), &source))
          }
        }
        LocalKind.Site => {
          if let Option<Diagnostics>.Some { value } = &hidden {
            input = Option<Operand>.some(run operand(Diagnostics.site(&value), &source))
          }
        }
        _ => ()
      }
      run List<usize>.append(&mut mapping, mapped)
      if own {
        run List<Local>.append(
          &mut fresh,
          Local { ty: Interned<Type>.clone(&locals[at].ty), kind: LocalKind.Temp, origin: origin },
        )
      }
      if let Option<Operand>.Some { value } = move input {
        run List<Statement>.append(
          &mut initialized,
          Statement.Assign {
            destination: Place { local: mapped, projections: List<Projection>.make() },
            value: Rvalue.Use { value: move value },
            origin: origin,
          },
        )
      }
      at = at + 1
    }
  } else {
    return false
  }
  let splice = Splice {
    locals: move mapping,
    blocks: List<Block>.length(&caller.body.blocks),
    normal: normal,
    failure: failure,
    cancel: cancel,
    origin: origin,
  }

  // Preserve the flags' association with the moved owner and its projected cleanup component.
  let mut at = usize.ZERO
  while at < locals.length {
    if let LocalKind.DropFlag { local, path: steps } = &locals[at].kind {
      let mut changed = List<Local>.asMutSlice(&mut fresh)
      changed[List<usize>.get(&splice.locals, at) - base].kind = LocalKind.DropFlag {
        local: List<usize>.get(&splice.locals, local),
        path: run path(&steps, &splice),
      }
    }
    at = at + 1
  }
  while List<Local>.length(&fresh) != 0 {
    run List<Local>.append(&mut caller.body.locals, List<Local>.remove(&mut fresh, 0))
  }
  while List<Statement>.length(&initialized) != 0 {
    run List<Statement>.append(
      &mut List<Block>.asMutSlice(&mut caller.body.blocks)[point].statements,
      List<Statement>.remove(&mut initialized, 0),
    )
  }
  let mut changed = List<Block>.asMutSlice(&mut caller.body.blocks)
  changed[point].terminator = Terminator.Goto { target: splice.blocks, origin: origin }
  drop changed
  if cancel != usize.MAX {
    drop List<Cancel>.remove(&mut caller.body.cancels, cancelAt)
  }
  let blocks = List<Block>.asSlice(&callee.body.blocks)
  at = usize.ZERO
  while at < blocks.length {
    let mut statements = List<Statement>.make()
    let listed = List<Statement>.asSlice(&blocks[at].statements)
    let mut next = usize.ZERO
    while next < listed.length {
      run List<Statement>.append(&mut statements, run statement(&listed[next], &splice))
      next = next + 1
    }
    run List<Block>.append(
      &mut caller.body.blocks,
      Block {
        statements: move statements,
        terminator: run terminator(&blocks[at].terminator, &splice),
      },
    )
    at = at + 1
  }
  let cancels = List<Cancel>.asSlice(&callee.body.cancels)
  at = usize.ZERO
  while at < cancels.length {
    run List<Cancel>.append(
      &mut caller.body.cancels,
      Cancel { point: splice.blocks + cancels[at].point, entry: splice.blocks + cancels[at].entry },
    )
    at = at + 1
  }
  let references = List<Reference>.asSlice(&callee.logical.references)
  at = usize.ZERO
  while at < references.length {
    run List<Reference>.append(
      &mut caller.logical.references,
      Reference {
        key: InstanceKey.copy(&references[at].key),
        edge: Edge.copy(&references[at].edge),
        origin: origin,
      },
    )
    at = at + 1
  }
  return true
}
