//! Splices a callee's checked MIR into its caller at one call.
//!
//! # Details
//!
//! A splice shares the caller's success and failure destinations, gives the callee's other locals
//! fresh slots, and chains the callee's cancellation cleanup into the caller's cancellation exit.
//! Hidden diagnostic operands and carried failure contexts follow their original edges.
//!
//! What the callee reports stays the callee's. Each statement of the spliced body gets an origin
//! of its own in the caller, distinct from every origin the caller already has, and the callee's
//! trap sites and failure contexts are copied to the caller's tables at those origins. A copied
//! trap site names the locals that hold the observer, cause and entry site the call passed, so a
//! trap inside the spliced body reports the callee's label through the same observer, with the
//! same entry site, as the call would have.
//!
//! The obligations the callee's body owes travel with it: its external C declarations, its local
//! shared accesses and escapes, whether it releases execution packages or observes diagnostics,
//! and the instances it references.
//!
//! Which callees may be spliced is the caller's decision, through [`inlinable`], [`eligible`] and
//! [`valueForwarder`], each of which reads the callee alone. The caller must also exclude
//! recursive expansions.

import CompilerBug
import hir.Hir { InfixOperator, PrefixOperator }
import backend.InstanceKey { InstanceKey }
import backend.Mir
import backend.MirWalk
import backend.Mir {
  ErasureFact,
  Block,
  Callee,
  Cancel,
  ContextText,
  Diagnostics,
  EscapeSite,
  FailureEdge,
  Inlining,
  Local,
  LocalKind,
  MirFunction,
  NonParkingRun,
  ParkOrigin,
  Operand,
  Place,
  Projection,
  Reference,
  Rvalue,
  ScalarBinary,
  SharedAccess,
  Statement,
  Terminator,
  TrapSite,
  Variable,
 CallTerminator}
import semantic.DeclarationId { DeclarationId }
import semantic.Specialization { Edge }
import semantic.Type { Type }
import silk.num.u64
import semantic.TypedBody { Origin }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.interned { Interned }
import silk.num.u8
import silk.num.usize

/// Copies a complete MIR answer, preserving its local, block and origin indices and all body facts.
pub effect fn copy(function: &MirFunction) -> MirFunction ! OutOfMemoryError ? &mut Allocator {
  let mut parameters = List<Interned<Type>>.make()
  let parameterTypes = List<Interned<Type>>.asSlice(&function.parameters)
  let mut at = usize.ZERO
  while at < parameterTypes.length {
    run List<Interned<Type>>.append(&mut parameters, Interned<Type>.clone(&parameterTypes[at]))
    at = at + 1
  }
  let mut locals = List<Local>.make()
  let slots = List<Local>.asSlice(&function.locals)
  at = 0
  while at < slots.length {
    let kind = match &slots[at].kind {
      LocalKind.Return => LocalKind.Return
      LocalKind.Parameter {index} => LocalKind.Parameter {index: index}
      LocalKind.User {index} => LocalKind.User {index: index}
      LocalKind.Temp => LocalKind.Temp
      LocalKind.Failure => LocalKind.Failure
      LocalKind.Provider {index} => LocalKind.Provider {index: index}
      LocalKind.Observer => LocalKind.Observer
      LocalKind.Cause => LocalKind.Cause
      LocalKind.Site => LocalKind.Site
      LocalKind.DropFlag {local, path} => LocalKind.DropFlag {local: local, path: run Mir.copyProjectionPath(&path)}
    }
    run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&slots[at].ty), kind: move kind, origin: slots[at].origin})
    at = at + 1
  }
  let mut blocks = List<Block>.make()
  let body = List<Block>.asSlice(&function.blocks)
  at = 0
  while at < body.length {
    let mut statements = List<Statement>.make()
    let source = List<Statement>.asSlice(&body[at].statements)
    let mut next = usize.ZERO
    while next < source.length {
      run List<Statement>.append(&mut statements, run MirWalk.copyStatement(&source[next]))
      next = next + 1
    }
    run List<Block>.append(&mut blocks, Block {suspends: body[at].suspends, statements: move statements, terminator: run MirWalk.copyTerminator(&body[at].terminator)})
    at = at + 1
  }
  let mut references = List<Reference>.make()
  let referred = List<Reference>.asSlice(&function.references)
  at = 0
  while at < referred.length {
    run List<Reference>.append(&mut references, Reference {key: InstanceKey.copy(&referred[at].key), edge: Edge.copy(&referred[at].edge), origin: referred[at].origin})
    at = at + 1
  }
  let mut externs = List<Interned<DeclarationId>>.make()
  let external = List<Interned<DeclarationId>>.asSlice(&function.externs)
  at = 0
  while at < external.length {
    run List<Interned<DeclarationId>>.append(&mut externs, Interned<DeclarationId>.clone(&external[at]))
    at = at + 1
  }
  let mut contexts = List<ContextText>.make()
  let context = List<ContextText>.asSlice(&function.contexts)
  at = 0
  while at < context.length {
    let mut identities = List<Bytes>.make()
    let names = List<Bytes>.asSlice(&context[at].identities)
    let mut next = usize.ZERO
    while next < names.length {
      run List<Bytes>.append(&mut identities, run Bytes.copy(Bytes.asSlice(&names[next])))
      next = next + 1
    }
    run List<ContextText>.append(&mut contexts, ContextText {origin: context[at].origin, identities: move identities, label: run Bytes.copy(Bytes.asSlice(&context[at].label))})
    at = at + 1
  }
  let mut traps = List<TrapSite>.make()
  let sites = List<TrapSite>.asSlice(&function.traps)
  at = 0
  while at < sites.length {
    run List<TrapSite>.append(&mut traps, TrapSite {origin: sites[at].origin, label: run Bytes.copy(Bytes.asSlice(&sites[at].label)), observer: sites[at].observer, cause: sites[at].cause, site: sites[at].site})
    at = at + 1
  }
  let mut nonParking = List<NonParkingRun>.make()
  let runs = List<NonParkingRun>.asSlice(&function.nonParking)
  at = 0
  while at < runs.length {
    let mut callees = List<InstanceKey>.make()
    let called = List<InstanceKey>.asSlice(&runs[at].callees)
    let mut next = usize.ZERO
    while next < called.length {
      run List<InstanceKey>.append(&mut callees, InstanceKey.copy(&called[next]))
      next = next + 1
    }
    let mut glues = List<Interned<Type>>.make()
    let dropped = List<Interned<Type>>.asSlice(&runs[at].glues)
    next = 0
    while next < dropped.length {
      run List<Interned<Type>>.append(&mut glues, Interned<Type>.clone(&dropped[next]))
      next = next + 1
    }
    let mut declarations = List<Interned<DeclarationId>>.make()
    let declared = List<Interned<DeclarationId>>.asSlice(&runs[at].declarations)
    next = 0
    while next < declared.length {
      run List<Interned<DeclarationId>>.append(&mut declarations, Interned<DeclarationId>.clone(&declared[next]))
      next = next + 1
    }
    let origin = ParkOrigin.copy(&runs[at].origin)
    run List<NonParkingRun>.append(&mut nonParking, NonParkingRun {callees: move callees, glues: move glues, declarations: move declarations, exact: runs[at].exact, origin: move origin})
    at = at + 1
  }
  let mut cancels = List<Cancel>.make()
  let cancel = List<Cancel>.asSlice(&function.cancels)
  at = 0
  while at < cancel.length { run List<Cancel>.append(&mut cancels, cancel[at]) at = at + 1 }
  let mut accesses = List<SharedAccess>.make()
  let shared = List<SharedAccess>.asSlice(&function.accesses)
  at = 0
  while at < shared.length {
    run List<SharedAccess>.append(&mut accesses, SharedAccess {callback: InstanceKey.copy(&shared[at].callback), origin: shared[at].origin})
    at = at + 1
  }
  let mut escapes = List<EscapeSite>.make()
  let mut erasures = List<ErasureFact>.make()
  run ErasureFact.appendTo(List<ErasureFact>.asSlice(&function.erasures), &mut erasures)
  let escape = List<EscapeSite>.asSlice(&function.escapes)
  at = 0
  while at < escape.length {
    run List<EscapeSite>.append(&mut escapes, EscapeSite {kind: escape[at].kind, origin: escape[at].origin})
    at = at + 1
  }
  let mut lines = List<u64>.make()
  let line = List<u64>.asSlice(&function.lines)
  at = 0
  while at < line.length { run List<u64>.append(&mut lines, line[at]) at = at + 1 }
  let mut variables = List<Variable>.make()
  let variable = List<Variable>.asSlice(&function.variables)
  at = 0
  while at < variable.length {
    run List<Variable>.append(&mut variables, Variable {local: variable[at].local, name: run Bytes.copy(Bytes.asSlice(&variable[at].name)), place: variable[at].place, argument: variable[at].argument})
    at = at + 1
  }
  let mut inlined = List<InstanceKey>.make()
  let inline = List<InstanceKey>.asSlice(&function.inlined)
  at = 0
  while at < inline.length { run List<InstanceKey>.append(&mut inlined, InstanceKey.copy(&inline[at])) at = at + 1 }
  let mut quiet = List<InstanceKey>.make()
  let settled = List<InstanceKey>.asSlice(&function.quiet)
  at = 0
  while at < settled.length { run List<InstanceKey>.append(&mut quiet, InstanceKey.copy(&settled[at])) at = at + 1 }
  let mut pureCallBlocks = List<usize>.make()
  let pureCalls = List<usize>.asSlice(&function.pureCallBlocks)
  at = 0
  while at < pureCalls.length { run List<usize>.append(&mut pureCallBlocks, pureCalls[at]) at = at + 1 }
  let suspension = match &function.suspension { Option<Origin>.Some {value} => Option<Origin>.some(value) Option<Origin>.None => Option<Origin>.none() }
  let parks = match &function.parks { Option<Origin>.Some {value} => Option<Origin>.some(value) Option<Origin>.None => Option<Origin>.none() }
  return MirFunction {key: InstanceKey.copy(&function.key), borrow: function.borrow, result: Interned<Type>.clone(&function.result),
    parameters: move parameters, locals: move locals, blocks: move blocks, references: move references, externs: move externs,
    observes: function.observes, contexts: move contexts, traps: move traps, suspension: move suspension, parks: move parks,
    releasesPackages: function.releasesPackages, nonParking: move nonParking, cancels: move cancels, accesses: move accesses,
    escapes: move escapes, erasures: move erasures, features: run Bytes.copy(Bytes.asSlice(&function.features)), pureCallBlocks: move pureCallBlocks, inlining: function.inlining,
    optimizeSize: function.optimizeSize, variadic: function.variadic, frame: run Bytes.copy(Bytes.asSlice(&function.frame)), lines: move lines,
    variables: move variables, inlined: move inlined, quiet: move quiet}
}

/// The largest expanded cost, a body's own [`cost`] and those of the bodies its calls would inline
/// in turn, that a call inlines for a function without a directive. A caller has no budget of its
/// own: each call is judged by what it would bring, as LLVM's inliner judges a call by the cost
/// of the callee after its own inlining.
pub const plainExpanded: usize = 96

/// The same for a call on a cycle of its caller's blocks in a build for speed, where the call
/// runs many times for each time its code is paid for.
pub const loopExpanded: usize = 192

/// The same for a function without a directive in a build for size.
pub const compactExpanded: usize = 48

/// The largest expanded size an `@inline` function may have and still be inlined.
pub const hintedExpanded: usize = 256

/// Where the sum of an expanded size stops: any size above it is too large for every call but
/// one of an `@inlineAlways` function, which no size keeps out.
pub const expansionCap: usize = 1024

/// The largest body an `@inlineAlways` function may have and still be inlined.
pub const alwaysBody: usize = 8192

/// The largest body that is no larger than the call it replaces, with the call's operands and
/// result: an accessor, a wrapping operation, a conversion. Inlining one never grows the caller.
pub const callSized: usize = 4

/// The size of a body for inlining: its statements and its blocks.
pub fn size(function: &MirFunction) -> usize {
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut total = blocks.length
  let mut at = usize.ZERO
  while at < blocks.length {
    total = total + List<Statement>.length(&blocks[at].statements)
    at = at + usize.ONE
  }
  return total
}

/// Estimates the cost of inlining a body by counting its statements and all terminators except
/// unconditional jumps, which often disappear when the direct backend merges blocks.
pub fn cost(function: &MirFunction) -> usize {
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut total = blocks.length
  let mut at = usize.ZERO
  while at < blocks.length {
    total = total + List<Statement>.length(&blocks[at].statements)
    if let Terminator.Goto {..} = &blocks[at].terminator { total = total - usize.ONE }
    at = at + usize.ONE
  }
  return total
}

/// Whether a body may share its caller's frame at a suspension point, in a build for the direct
/// backend (`direct`) or for LLVM. The caller must also exclude recursive targets.
pub fn eligible(function: &MirFunction, direct: bool) -> bool {
  return function.inlining == Inlining.Always && List<Block>.length(&function.blocks) <= 64 && safeBody(function, direct)
}

/// The largest body an explicit `@inlineAlways` leaf may have to be spliced across all builds
/// (including dev and LLVM builds) so trivial generic wrappers never enter codegen or ELF.
pub const alwaysLeafLimit: usize = 32

/// Whether an explicit `@inlineAlways` function is a small, non-suspending, non-escaping leaf
/// safe to splice into any caller across direct, LLVM, and debug builds.
pub fn alwaysLeaf(function: &MirFunction, direct: bool) -> bool {
  drop direct
  if function.inlining != Inlining.Always || size(function) > alwaysLeafLimit { return false }
  if !safeBodyKind(function, true, true) { return false }
  if Bytes.length(&function.features) != usize.ZERO { return false }
  if List<Cancel>.length(&function.cancels) != usize.ZERO
    || List<NonParkingRun>.length(&function.nonParking) != usize.ZERO
    || List<SharedAccess>.length(&function.accesses) != usize.ZERO
    || List<EscapeSite>.length(&function.escapes) != usize.ZERO
    || List<ErasureFact>.length(&function.erasures) != usize.ZERO {
    return false
  }
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    if let Terminator.Call {call} = &blocks[at].terminator {
      match &call.get().callee {
        Callee.Extern {..} => { return false }
        Callee.NativeIndirect {..} => { return false }
        _ => ()
      }
    }
    at = at + usize.ONE
  }
  return true
}

/// Whether an optimized direct-backend build may inline a call of `function` that is not a
/// suspension point: its directive allows it, its own body is small enough for the directive, it
/// suspends and parks nowhere, and it owes no `Intrinsic.NonParking` proof of its own. Reads `function` alone, so the
/// decision never depends on the callers. The caller must also exclude recursive expansions and
/// check that nothing the body's calls reach suspends.
pub fn inlinable(function: &MirFunction) -> bool {
  // Admit candidates up to their hottest call's budget. The expanded cost still decides
  // whether a particular call is small enough to splice.
  let limit = match function.inlining {
    Inlining.Default => loopBudget(List<Interned<Type>>.length(&function.parameters), Interned<Type>.with<bool>(&function.result, mayReturnTag))
    Inlining.Hint => hintedExpanded
    Inlining.Always => alwaysBody
    Inlining.Never => usize.ZERO
    Inlining.Cold => usize.ZERO
  }
  if size(function) > limit || !safeBody(function, true) || List<Cancel>.length(&function.cancels) != usize.ZERO {
    return false
  }
  // A non-parking proof names the instance it is owed for, which must stay reached.
  return List<NonParkingRun>.length(&function.nonParking) == usize.ZERO
}

/// The directive of an inlinable `function` as a number: 0 for none, 1 for `@inline` and what
/// counts as it, 2 for `@inlineAlways` and what counts as it.
pub fn directive(function: &MirFunction) -> usize {
  return match function.inlining {
    Inlining.Hint => usize.ONE
    Inlining.Always => 2
    _ => usize.ZERO
  }
}

/// Applies the callee's directive and the build's size preference to the speed budget of a call.
pub fn expandedLimit(directive: usize, compact: bool, budget: usize) -> usize {
  if directive == 2 { return usize.MAX }
  if directive == usize.ONE { return hintedExpanded }
  if compact { return compactExpanded }
  return budget
}

fn mayReturnTag(ty: &Type) -> bool {
  return match &ty.* { Type.Nominal {..} => true Type.Union {..} => true _ => false }
}

/// Whether the start of the normal successor reads the result tag, possibly
/// through whole-value copies. Inlining can expose the callee's known variants
/// and eliminate the transient result object.
pub fn inspectsTag(function: &MirFunction, normal: usize, destination: &Place) -> bool {
  let mut local = whole(destination)
  let parts = List<Statement>.asSlice(&List<Block>.asSlice(&function.blocks)[normal].statements)
  let mut at = usize.ZERO
  while local != usize.MAX && at < parts.length && at < 8 {
    let statement = &parts[at]
    at = at + usize.ONE
    if let Statement.Assign {destination: next, value, ..} = &statement.* {
      if let Rvalue.Discriminant {place} = &value { return whole(&place) == local }
      if let Rvalue.Use {value: operand} = &value {
        let from = match &operand {
          Operand.Copy {place} => whole(&place)
          Operand.Move {place} => whole(&place)
          _ => usize.MAX
        }
        if from == local {
          local = whole(&next)
          continue
        }
      }
      if next.local == local { return false }
    } else { return false }
  }
  return false
}

/// Speed budget for a call inside a loop. Inlining can expose invariant
/// operands of a wide call or the tag of a result the caller immediately reads.
pub fn loopBudget(arguments: usize, takesTag: bool) -> usize {
  if takesTag || arguments >= 8 { return expansionCap }
  return loopExpanded
}

/// For each block of `function`, whether control can come back to it: it lies on a cycle of the
/// blocks' successors.
pub effect fn loopBlocks(function: &MirFunction) -> List<bool> ! OutOfMemoryError ? &mut Allocator {
  let blocks = List<Block>.asSlice(&function.blocks)
  let count = blocks.length
  let mut cyclic = run List<bool>.makeWithCapacity(count)
  run List<bool>.appendRepeated(&mut cyclic, false, count)
  // Tarjan's strongly connected components, with the walk's stack kept by hand: a block is on a
  // cycle when its component has another block, or it is its own successor.
  let mut number = run List<usize>.makeWithCapacity(count)
  run List<usize>.appendRepeated(&mut number, usize.MAX, count)
  let mut low = run List<usize>.makeWithCapacity(count)
  run List<usize>.appendRepeated(&mut low, usize.MAX, count)
  let mut waiting = run List<bool>.makeWithCapacity(count)
  run List<bool>.appendRepeated(&mut waiting, false, count)
  let mut component = List<usize>.make()
  let mut walk = List<usize>.make()
  let mut edge = List<usize>.make()
  let mut next = usize.ZERO
  let mut root = usize.ZERO
  while root < count {
    if List<usize>.get(&number, root) == usize.MAX {
      run List<usize>.append(&mut walk, root)
      run List<usize>.append(&mut edge, usize.ZERO)
      List<usize>.set(&mut number, root, next)
      List<usize>.set(&mut low, root, next)
      next = next + usize.ONE
      run List<usize>.append(&mut component, root)
      List<bool>.set(&mut waiting, root, true)
      while List<usize>.length(&walk) != usize.ZERO {
        let top = List<usize>.length(&walk) - usize.ONE
        let at = List<usize>.get(&walk, top)
        let taken = List<usize>.get(&edge, top)
        if taken < MirWalk.successorCount(&blocks[at].terminator) {
          List<usize>.set(&mut edge, top, taken + usize.ONE)
          let target = MirWalk.successor(&blocks[at].terminator, taken)
          if target >= count { continue }
          if target == at { List<bool>.set(&mut cyclic, at, true) }
          if List<usize>.get(&number, target) == usize.MAX {
            run List<usize>.append(&mut walk, target)
            run List<usize>.append(&mut edge, usize.ZERO)
            List<usize>.set(&mut number, target, next)
            List<usize>.set(&mut low, target, next)
            next = next + usize.ONE
            run List<usize>.append(&mut component, target)
            List<bool>.set(&mut waiting, target, true)
          } else if List<bool>.get(&waiting, target) && List<usize>.get(&number, target) < List<usize>.get(&low, at) {
            let seen = List<usize>.get(&number, target)
            List<usize>.set(&mut low, at, seen)
          }
          continue
        }
        // Every successor is done: the block closes its component when it is the first of it.
        drop List<usize>.pop(&mut walk)
        drop List<usize>.pop(&mut edge)
        if top > usize.ZERO {
          let parent = List<usize>.get(&walk, top - usize.ONE)
          if List<usize>.get(&low, at) < List<usize>.get(&low, parent) {
            let reached = List<usize>.get(&low, at)
            List<usize>.set(&mut low, parent, reached)
          }
        }
        if List<usize>.get(&low, at) == List<usize>.get(&number, at) {
          let mut members = usize.ZERO
          let mut from = List<usize>.length(&component)
          while from > usize.ZERO && List<usize>.get(&component, from - usize.ONE) != at { from = from - usize.ONE }
          from = from - usize.ONE
          members = List<usize>.length(&component) - from
          while List<usize>.length(&component) > from {
            let last = List<usize>.length(&component) - usize.ONE
            let member = List<usize>.get(&component, last)
            List<usize>.truncate(&mut component, last)
            List<bool>.set(&mut waiting, member, false)
            if members > usize.ONE { List<bool>.set(&mut cyclic, member, true) }
          }
        }
      }
    }
    root = root + usize.ONE
  }
  return move cyclic
}

/// Whether a small synchronous constructor or value-forwarding body can be spliced before frame
/// layout, in a build for the direct backend (`direct`) or for LLVM. Its caller must exclude
/// recursive expansions and preserve explicit no-inline directives. LLVM inlining alone happens
/// too late to coalesce these callbacks' aggregate destinations.
pub fn valueForwarder(function: &MirFunction, direct: bool) -> bool {
  let blocks = List<Block>.asSlice(&function.blocks)
  if blocks.length > 2 || function.inlining == Inlining.Never || function.inlining == Inlining.Cold
    || !safeBody(function, direct)
    || List<Cancel>.length(&function.cancels) != 0 {
    return false
  }
  let mut at = usize.ZERO
  while at < blocks.length {
    match &blocks[at].terminator {
      Terminator.Return { .. } => ()
      Terminator.Call { call } => {
        if let CallTerminator {
          callee: Callee.Instance { .. },
          destination,
          normal,
          failure: Option.None,
          ..
        } = &call.get().* {
          if whole(&destination) != 0 || normal >= blocks.length {
            return false
          }
          if List<Statement>.length(&blocks[normal].statements) != 0 {
            return false
          }
          if let Terminator.Return { .. } = &blocks[normal].terminator {} else {
            return false
          }
        } else {
          return false
        }
      }
      _ => {
        return false
      }
    }
    let statements = List<Statement>.asSlice(&blocks[at].statements)
    if statements.length > 8 {
      return false
    }
    let mut next = usize.ZERO
    while next < statements.length {
      match &statements[next] {
        Statement.Assign { value: Rvalue.Use { .. }, .. } => ()
        Statement.Assign { value: Rvalue.Aggregate { .. }, .. } => ()
        Statement.Assign { value: Rvalue.Variant { .. }, .. } => ()
        Statement.Assign { value: Rvalue.Inject { .. }, .. } => ()
        _ => {
          return false
        }
      }
      next = next + 1
    }
    at = at + 1
  }
  return true
}

// What no splice may move into another function, in a build for the direct backend (`direct`)
// or for LLVM. Traps, checked arithmetic and originated failure contexts may be spliced: they
// keep their labels and diagnostic operands (module details). An LLVM build, whose own inlining
// covers everything but frame layout, splices no more than its frames need: no trap, checked
// arithmetic, originated context, C call or target feature (`llvmFrameBody`).
fn safeBody(function: &MirFunction, direct: bool) -> bool {
  return safeBodyKind(function, direct, false)
}

fn safeBodyKind(function: &MirFunction, direct: bool, ignoreDebug: bool) -> bool {
  if !direct && !llvmFrameBody(function) {
    return false
  }
  // `@optimizeSize` asks for this function's own size-optimized code, which only its own
  // definition has. A variadic export's body takes its C entry's `va_list` as a lane of its own. Line tables and debug variables describe the function's own frame.
  if function.optimizeSize || function.variadic {
    return false
  }
  if !ignoreDebug && (List<Variable>.length(&function.variables) != 0 || List<u64>.length(&function.lines) != 0) {
    return false
  }
  // A suspension origin or an external park needs a frame of its own.
  if let Option<Origin>.Some { .. } = &function.suspension {
    return false
  }
  if let Option<Origin>.Some { .. } = &function.parks {
    return false
  }
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    if let Terminator.Relinquish { .. } = &blocks[at].terminator {
      return false
    }
    let statements = List<Statement>.asSlice(&blocks[at].statements)
    let mut statement = usize.ZERO
    while statement < statements.length {
      match &statements[statement] {
        // Each of these names the running function itself: its frame, its process word, its
        // stack allocations, which live until it returns, or its execution package.
        Statement.Assign { value: Rvalue.FrameAddress, .. } => {
          return false
        }
        Statement.Assign { value: Rvalue.ProcessWord, .. } => {
          return false
        }
        Statement.Assign { value: Rvalue.ProcessSlot { .. }, .. } => {
          return false
        }
        Statement.Assign { value: Rvalue.VariadicArguments, .. } => {
          return false
        }
        Statement.Assign { value: Rvalue.StackAllocate { .. }, .. } => {
          return false
        }
        Statement.Assign { value: Rvalue.RunningPackage, .. } => {
          return false
        }
        // A machine fragment's constraints are written for the function they appear in.
        Statement.Assign { value: Rvalue.Assembly { .. }, .. } => {
          return false
        }
        _ => ()
      }
      statement = statement + 1
    }
    at = at + 1
  }
  return true
}

/// Empties what nothing reads of `function` once a direct build has emitted its code: its locals,
/// trap sites, failure contexts and most statements. It keeps every block with its terminator,
/// the function addresses and drops a suspension summary lists, and the frame-bound values
/// [`eligible`] refuses. The whole-program checks after emission and a later frame walk read only
/// those, and read the same answers from what is kept.
pub effect fn residue(function: &mut MirFunction) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut blocks = List<Block>.asMutSlice(&mut function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let mut kept = List<Statement>.make()
    while let Option<Statement>.Some {value} = List<Statement>.pop(&mut blocks[at].statements) {
      if readAfterEmission(&value) { run List<Statement>.append(&mut kept, move value) }
    }
    while let Option<Statement>.Some {value} = List<Statement>.pop(&mut kept) {
      run List<Statement>.append(&mut blocks[at].statements, move value)
    }
    run List<Statement>.shrinkToFit(&mut blocks[at].statements)
    at = at + 1
  }
  List<Local>.clearAndFree(&mut function.locals)
  List<TrapSite>.clearAndFree(&mut function.traps)
  List<ContextText>.clearAndFree(&mut function.contexts)
  return ()
}

fn readAfterEmission(statement: &Statement) -> bool {
  return match &statement.* {
    Statement.Drop { .. } => true
    Statement.Assign { value: Rvalue.FunctionAddress { .. }, .. } => true
    Statement.Assign { value: Rvalue.FrameAddress, .. } => true
    Statement.Assign { value: Rvalue.ProcessWord, .. } => true
    Statement.Assign { value: Rvalue.ProcessSlot { .. }, .. } => true
    Statement.Assign { value: Rvalue.VariadicArguments, .. } => true
    Statement.Assign { value: Rvalue.StackAllocate { .. }, .. } => true
    Statement.Assign { value: Rvalue.RunningPackage, .. } => true
    Statement.Assign { value: Rvalue.Assembly { .. }, .. } => true
    _ => false
  }
}

struct Splice {
  locals: List<usize>,
  blocks: usize,
  normal: usize,
  failure: usize,
  cancel: usize,
  origin: Origin,
  // The first node of the origins this splice gives the callee's statements, and the callee's
  // trap and context sites in the order their fresh nodes count from it.
  base: usize,
  sites: List<Origin>,
}

fn sameSite(left: Origin, right: Origin) -> bool {
  return left.node == right.node && left.location.start == right.location.start
}

effect fn noteSite(sites: &mut List<Origin>, origin: Origin) -> () ! OutOfMemoryError ? &mut Allocator {
  let listed = List<Origin>.asSlice(&sites.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if sameSite(listed[at], origin) { return () }
    at = at + usize.ONE
  }
  return run List<Origin>.append(&mut sites.*, origin)
}

// The origin a statement of the callee at `origin` gets in the caller: a fresh node for each of
// the callee's trap and context sites, and one more for every other statement, all at the call's
// location so a gap still points at the call.
fn mapOrigin(splice: &Splice, origin: Origin) -> Origin {
  let listed = List<Origin>.asSlice(&splice.sites)
  let mut at = usize.ZERO
  while at < listed.length && !sameSite(listed[at], origin) { at = at + usize.ONE }
  return Origin { node: splice.base + at, location: splice.origin.location }
}

fn originNode(origin: Origin, highest: usize) -> usize {
  if origin.node > highest { return origin.node }
  return highest
}

/// One more than the highest origin node `function` uses: the first node a splice into it may
/// give its origins. [`call`] takes it and moves it past the nodes it used, so a function that
/// takes many splices is walked for it once.
pub fn freshNode(function: &MirFunction) -> usize {
  let mut highest = usize.ZERO
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = List<Statement>.asSlice(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      highest = originNode(MirWalk.statementOrigin(&statements[at]), highest)
      at = at + usize.ONE
    }
    highest = originNode(MirWalk.terminatorOrigin(&blocks[block].terminator), highest)
    block = block + usize.ONE
  }
  let traps = List<TrapSite>.asSlice(&function.traps)
  let mut at = usize.ZERO
  while at < traps.length {
    highest = originNode(traps[at].origin, highest)
    at = at + usize.ONE
  }
  let contexts = List<ContextText>.asSlice(&function.contexts)
  at = usize.ZERO
  while at < contexts.length {
    highest = originNode(contexts[at].origin, highest)
    at = at + usize.ONE
  }
  return highest + usize.ONE
}

effect fn statement(source: &Statement, splice: &Splice) -> Statement
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copied = run MirWalk.copyStatement(source)
  MirWalk.renameStatement(&mut copied, List<usize>.asSlice(&splice.locals))
  MirWalk.setStatementOrigin(&mut copied, mapOrigin(splice, MirWalk.statementOrigin(source)))
  return move copied
}

effect fn terminator(source: &Terminator, splice: &Splice) -> Terminator
  ! OutOfMemoryError
  ? &mut Allocator {
  let origin = mapOrigin(splice, MirWalk.terminatorOrigin(source))
  match &source.* {
    Terminator.Return { .. } => { return Terminator.Goto { target: splice.normal, origin: origin } }
    Terminator.Fail { .. } => { return Terminator.Goto { target: splice.failure, origin: origin } }
    Terminator.Abandon { .. } => {
      // Earlier splices can remove the last cancellation point that enters this exit.
      // A caller without a cancellation continuation cannot reach that copied block.
      if splice.cancel == usize.MAX { return Terminator.Unreachable {origin: origin} }
      return Terminator.Goto {target: splice.cancel, origin: origin}
    }
    Terminator.Relinquish { .. } => { return CompilerBug.panic(b"a parking origin reached inlining") }
    _ => ()
  }
  let mut copied = run MirWalk.copyTerminator(source)
  MirWalk.renameTerminator(&mut copied, List<usize>.asSlice(&splice.locals))
  let count = MirWalk.successorCount(&copied)
  let mut at = usize.ZERO
  while at < count {
    let target = MirWalk.successor(&copied, at)
    MirWalk.setSuccessor(&mut copied, at, splice.blocks + target)
    at = at + usize.ONE
  }
  MirWalk.setTerminatorOrigin(&mut copied, origin)
  return move copied
}

fn whole(place: &Place) -> usize {
  if List<Projection>.length(&place.projections) != 0 {
    return usize.MAX
  }
  return place.local
}

// The callee local of hidden kind `kind`, mapped into the caller, or `usize.MAX`.
fn hiddenLocal(callee: &MirFunction, splice: &Splice, observer: bool, cause: bool) -> usize {
  let locals = List<Local>.asSlice(&callee.locals)
  let mut at = usize.ZERO
  while at < locals.length {
    let found = match &locals[at].kind {
      LocalKind.Observer => observer
      LocalKind.Cause => cause
      LocalKind.Site => !observer && !cause
      _ => false
    }
    if found { return List<usize>.get(&splice.locals, at) }
    at = at + usize.ONE
  }
  return usize.MAX
}

// A local of the callee as the caller names it: a callee table names `usize.MAX` for its own
// hidden local, which is `own` in the caller.
fn mapped(splice: &Splice, local: usize, own: usize) -> usize {
  if local == usize.MAX { return own }
  return List<usize>.get(&splice.locals, local)
}

// Copies the callee's report tables and obligations to the caller, at the splice's origins.
fn plainEdge(edge: &Edge) -> bool {
  return match &edge.* {
    Edge.Direct => true
    _ => false
  }
}

fn witnessEdge(edge: &Edge) -> bool {
  return match &edge.* {
    Edge.Witness => true
    _ => false
  }
}

// Whether each reference of `callee` can stand in a caller that reached `callee` along `via`. The
// spliced body is no longer an application on the path from the caller to what it references, so
// the one edge left must carry what the two did (`Specialization.Admission.enter` admits a
// recursive specialization by the witness edges on its path): one of them is direct, or both are
// plain witnesses. Otherwise the call stays.
fn joinsEdges(via: &Edge, callee: &MirFunction) -> bool {
  if plainEdge(via) { return true }
  let references = List<Reference>.asSlice(&callee.references)
  let mut at = usize.ZERO
  while at < references.length {
    if !plainEdge(&references[at].edge) && !(witnessEdge(via) && witnessEdge(&references[at].edge)) { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn mergeTables(caller: &mut MirFunction, callee: &MirFunction, splice: &Splice, via: &Edge) -> () ! OutOfMemoryError ? &mut Allocator {
  let observer = hiddenLocal(callee, splice, true, false)
  let cause = hiddenLocal(callee, splice, false, true)
  let site = hiddenLocal(callee, splice, false, false)
  let traps = List<TrapSite>.asSlice(&callee.traps)
  let mut at = usize.ZERO
  while at < traps.length {
    run List<TrapSite>.append(&mut caller.traps, TrapSite {
      origin: mapOrigin(splice, traps[at].origin),
      label: run Bytes.copy(Bytes.asSlice(&traps[at].label)),
      observer: mapped(splice, traps[at].observer, observer),
      cause: mapped(splice, traps[at].cause, cause),
      site: mapped(splice, traps[at].site, site),
    })
    at = at + usize.ONE
  }
  let contexts = List<ContextText>.asSlice(&callee.contexts)
  at = usize.ZERO
  while at < contexts.length {
    let identities = List<Bytes>.asSlice(&contexts[at].identities)
    let mut copied = List<Bytes>.make()
    let mut identity = usize.ZERO
    while identity < identities.length {
      run List<Bytes>.append(&mut copied, run Bytes.copy(Bytes.asSlice(&identities[identity])))
      identity = identity + usize.ONE
    }
    run List<ContextText>.append(&mut caller.contexts, ContextText {
      origin: mapOrigin(splice, contexts[at].origin),
      identities: move copied,
      label: run Bytes.copy(Bytes.asSlice(&contexts[at].label)),
    })
    at = at + usize.ONE
  }
  let externs = List<Interned<DeclarationId>>.asSlice(&callee.externs)
  at = usize.ZERO
  while at < externs.length {
    let known = List<Interned<DeclarationId>>.asSlice(&caller.externs)
    let mut seen = false
    let mut prior = usize.ZERO
    while prior < known.length && !seen {
      seen = Interned<DeclarationId>.same(&known[prior], &externs[at])
      prior = prior + usize.ONE
    }
    if !seen { run List<Interned<DeclarationId>>.append(&mut caller.externs, Interned<DeclarationId>.clone(&externs[at])) }
    at = at + usize.ONE
  }
  let accesses = List<SharedAccess>.asSlice(&callee.accesses)
  at = usize.ZERO
  while at < accesses.length {
    run List<SharedAccess>.append(&mut caller.accesses, SharedAccess {
      callback: InstanceKey.copy(&accesses[at].callback),
      origin: splice.origin,
    })
    at = at + usize.ONE
  }
  run ErasureFact.appendTo(List<ErasureFact>.asSlice(&callee.erasures), &mut caller.erasures)
  let escapes = List<EscapeSite>.asSlice(&callee.escapes)
  at = usize.ZERO
  while at < escapes.length {
    run List<EscapeSite>.append(&mut caller.escapes, EscapeSite { kind: escapes[at].kind, origin: splice.origin })
    at = at + usize.ONE
  }
  caller.observes = caller.observes || callee.observes
  caller.releasesPackages = caller.releasesPackages || callee.releasesPackages
  let references = List<Reference>.asSlice(&callee.references)
  at = usize.ZERO
  while at < references.length {
    // A direct reference of the body was reached along the call's edge (`joinsEdges`).
    let mut edge = Edge.copy(&references[at].edge)
    if plainEdge(&references[at].edge) { edge = Edge.copy(via) }
    run List<Reference>.append(
      &mut caller.references,
      Reference {
        key: InstanceKey.copy(&references[at].key),
        edge: move edge,
        origin: splice.origin,
      },
    )
    at = at + usize.ONE
  }
  return ()
}

// Whether an LLVM build may splice `function` into a frame: it has no own report site, C call or
// target features, and, in a program that observes diagnostics, no operation that could trap.
fn llvmFrameBody(function: &MirFunction) -> bool {
  if Bytes.length(&function.features) != 0 || List<ContextText>.length(&function.contexts) != 0 {
    return false
  }
  let observed = Bytes.length(&function.frame) != 0
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    match &blocks[at].terminator {
      Terminator.Call { call } => {
        match &call.get().callee {
          Callee.Extern { .. } => { return false }
          Callee.NativeIndirect { .. } => { return false }
          _ => ()
        }
      }
      Terminator.Trap { .. } => { return false }
      Terminator.TrapText { .. } => { return false }
      _ => ()
    }
    let statements = List<Statement>.asSlice(&blocks[at].statements)
    let mut statement = usize.ZERO
    while statement < statements.length {
      let refused = match &statements[statement] {
        // Diagnostic forwarding compares pointers to null, which cannot trap.
        Statement.Assign { value: Rvalue.Binary { operation, .. }, .. } => observed && !comparison(operation)
        Statement.Assign { value: Rvalue.Unary { .. }, .. } => observed
        Statement.Assign { value: Rvalue.ScalarBinary { .. }, .. } => observed
        Statement.Assign { value: Rvalue.Convert { .. }, .. } => observed
        Statement.Assign { value: Rvalue.Vector { .. }, .. } => observed
        Statement.FailureContext { source: Option.None, .. } => true
        _ => false
      }
      if refused { return false }
      statement = statement + 1
    }
    at = at + 1
  }
  return true
}

fn comparison(operation: InfixOperator) -> bool {
  return match operation {
    InfixOperator.Equals => true
    InfixOperator.NotEquals => true
    InfixOperator.LessThan => true
    InfixOperator.LessOrEqual => true
    InfixOperator.GreaterThan => true
    InfixOperator.GreaterOrEqual => true
    _ => false
  }
}

/// Whether every comma-separated target-feature token in `required` appears as a complete
/// comma-separated token in `available`.
///
/// # Details
///
/// An empty `required` slice is a subset of every `available` slice, allowing baseline callees
/// without `@features(...)` to inline into `@features(...)` callers. A non-empty `required`
/// slice is never a subset of an empty `available` slice, so an `@features(...)` callee never
/// inlines into a baseline caller. Matching compares complete comma-delimited tokens rather than
/// substrings, so `+avx` never matches `+avx2` and `+sse4.1` never matches `+sse4.2`. Token
/// order and duplicates in either list do not affect the result.
pub fn featuresSubset(required: &[u8], available: &[u8]) -> bool {
  if required.length == usize.ZERO { return true }
  if available.length == usize.ZERO { return false }
  if sameSlice(required, available) { return true }
  let mut start = usize.ZERO
  while start < required.length {
    let mut end = start
    while end < required.length && required[end] != 44 {
      end = end + usize.ONE
    }
    if end > start && !containsFeatureToken(available, required, start, end) {
      return false
    }
    start = end + usize.ONE
  }
  return true
}

fn sameSlice(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn containsFeatureToken(available: &[u8], required: &[u8], reqStart: usize, reqEnd: usize) -> bool {
  let reqLen = reqEnd - reqStart
  let mut start = usize.ZERO
  while start < available.length {
    let mut end = start
    while end < available.length && available[end] != 44 {
      end = end + usize.ONE
    }
    if end - start == reqLen {
      let mut at = usize.ZERO
      let mut matched = true
      while at < reqLen {
        if available[start + at] != required[reqStart + at] {
          matched = false
          break
        }
        at = at + usize.ONE
      }
      if matched { return true }
    }
    start = end + usize.ONE
  }
  return false
}

/// Replaces the direct call ending block `point` with `callee`'s checked body. `nodes` is the
/// caller's first unused origin node ([`freshNode`]); a splice moves it past the nodes it gives
/// the body's origins.
///
/// At a suspension point the callee's cancellation exits chain into the point's own. A splice at
/// a suspension point, or any splice in a build for LLVM (`direct` false), is refused once the
/// caller would exceed 256 blocks. Direct non-suspending splices may write into a projected
/// success destination (such as a union variant field) through a fresh temporary local on each
/// normal return. Returns false, changing nothing, when a failure destination is not a whole
/// local, when a non-direct or suspending call's success destination is not a whole local, when
/// the callee requires target features absent from the caller, when a suspension point's splice is
/// refused, or when `via`, the edge of the caller's references to the callee, cannot stand for the
/// body's own references: each of them takes `via` when it is direct, and keeps its own edge when
/// `via` is direct or both are plain witnesses.
pub effect fn call(caller: &mut MirFunction, point: usize, callee: &MirFunction, direct: bool, nodes: &mut usize, via: &Edge) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if !featuresSubset(Bytes.asSlice(&callee.features), Bytes.asSlice(&caller.features)) {
    return false
  }
  if !joinsEdges(via, callee) {
    return false
  }
  let mut cancel = usize.MAX
  let mut cancelAt = usize.ZERO
  let cancellations = List<Cancel>.asSlice(&caller.cancels)
  while cancelAt < cancellations.length {
    if cancellations[cancelAt].point == point {
      cancel = cancellations[cancelAt].entry
      break
    }
    cancelAt = cancelAt + 1
  }
  if (cancel != usize.MAX || !direct) && List<Block>.length(&caller.blocks) + List<Block>.length(&callee.blocks) > 256 {
    return false
  }
  if cancel == usize.MAX && List<Cancel>.length(&callee.cancels) != usize.ZERO {
    return false
  }
  let mut mapping = List<usize>.make()
  let mut initialized = List<Statement>.make()
  let mut fresh = List<Local>.make()
  let target = &List<Block>.asSlice(&caller.blocks)[point].terminator
  let locals = List<Local>.asSlice(&callee.locals)
  let base = List<Local>.length(&caller.locals)
  let mut normal = usize.MAX
  let mut failure = usize.MAX
  let mut origin = locals[0].origin
  let mut projectedReturn = Option<Place>.none()
  let mut returnLocal = usize.MAX
  if let Terminator.Call {call} = &target.* {
    let CallTerminator {
      arguments,
      providers,
      diagnostics: hidden,
      destination,
      normal: continued,
      failure: failed,
      origin: site,
      ..
    } = &call.get().*
    if whole(&destination) == usize.MAX {
      if !direct || cancel != usize.MAX {
        return false
      }
      projectedReturn = Option<Place>.some(run Mir.copyPlace(&destination))
    }
    if let Option<FailureEdge>.Some { value: edge } = &failed {
      if whole(&edge.destination) == usize.MAX {
        return false
      }
      failure = edge.target
    }
    normal = continued
    origin = site

    // The caller's already-evaluated operands are copied into the callee's slots.
    let mut at = usize.ZERO
    while at < locals.length {
      let mut mapped = base + List<Local>.length(&fresh)
      let mut own = true
      let mut input = Option<Operand>.none()
      match &locals[at].kind {
        LocalKind.Return => {
          if Option<Place>.isSome(&projectedReturn) {
            returnLocal = mapped
          } else {
            mapped = destination.local
            own = false
          }
        }
        LocalKind.Failure => {
          if let Option<FailureEdge>.Some { value: edge } = &failed {
            mapped = edge.destination.local
            own = false
          }
        }
        LocalKind.Parameter { index } => {
          input = Option<Operand>.some(
            run MirWalk.copyOperand(&List<Operand>.asSlice(&arguments)[index]),
          )
        }
        LocalKind.Provider { index } => {
          input = Option<Operand>.some(
            run MirWalk.copyOperand(&List<Operand>.asSlice(&providers)[index]),
          )
        }
        LocalKind.Observer => {
          if let Option<Diagnostics>.Some { value } = &hidden {
            input = Option<Operand>.some(run MirWalk.copyOperand(Diagnostics.observer(&value)))
          }
        }
        LocalKind.Cause => {
          if let Option<Diagnostics>.Some { value } = &hidden {
            input = Option<Operand>.some(run MirWalk.copyOperand(Diagnostics.cause(&value)))
          }
        }
        LocalKind.Site => {
          if let Option<Diagnostics>.Some { value } = &hidden {
            input = Option<Operand>.some(run MirWalk.copyOperand(Diagnostics.site(&value)))
          }
        }
        _ => ()
      }
      run List<usize>.append(&mut mapping, mapped)
      if own {
        run List<Local>.append(
          &mut fresh,
          Local { ty: Interned<Type>.clone(&locals[at].ty), kind: LocalKind.Temp, origin: origin },
        )
      }
      if let Option<Operand>.Some { value } = move input {
        run List<Statement>.append(
          &mut initialized,
          Statement.Assign {
            destination: Place { local: mapped, projections: List<Projection>.make() },
            value: Rvalue.Use { value: move value },
            origin: origin,
          },
        )
      }
      at = at + usize.ONE
    }
    if Option<Place>.isSome(&projectedReturn) && returnLocal == usize.MAX {
      return false
    }
  } else {
    return false
  }
  let mut sites = List<Origin>.make()
  let traps = List<TrapSite>.asSlice(&callee.traps)
  let mut at = usize.ZERO
  while at < traps.length {
    run noteSite(&mut sites, traps[at].origin)
    at = at + usize.ONE
  }
  let contexts = List<ContextText>.asSlice(&callee.contexts)
  at = usize.ZERO
  while at < contexts.length {
    run noteSite(&mut sites, contexts[at].origin)
    at = at + usize.ONE
  }
  let splice = Splice {
    locals: move mapping,
    blocks: List<Block>.length(&caller.blocks),
    normal: normal,
    failure: failure,
    cancel: cancel,
    origin: origin,
    base: nodes.*,
    sites: move sites,
  }
  // The splice's origins take one node for each site and one for every other statement.
  nodes.* = splice.base + List<Origin>.length(&splice.sites) + usize.ONE

  // Preserve the flags' association with the moved owner and its projected cleanup component.
  at = usize.ZERO
  while at < locals.length {
    if let LocalKind.DropFlag { local, path: steps } = &locals[at].kind {
      let mut changed = List<Local>.asMutSlice(&mut fresh)
      let mut guarded = Place { local: local, projections: run Mir.copyProjectionPath(&steps) }
      MirWalk.renamePlace(&mut guarded, List<usize>.asSlice(&splice.locals))
      let Place { local: mappedLocal, projections: mappedPath } = move guarded
      changed[List<usize>.get(&splice.locals, at) - base].kind = LocalKind.DropFlag {
        local: mappedLocal,
        path: move mappedPath,
      }
    }
    at = at + 1
  }
  run List<Local>.appendList(&mut caller.locals, move fresh)
  run List<Statement>.appendList(
    &mut List<Block>.asMutSlice(&mut caller.blocks)[point].statements,
    move initialized,
  )
  let mut changed = List<Block>.asMutSlice(&mut caller.blocks)
  changed[point].terminator = Terminator.Goto { target: splice.blocks, origin: origin }
  drop changed
  if cancel != usize.MAX {
    drop List<Cancel>.remove(&mut caller.cancels, cancelAt)
  }
  let blocks = List<Block>.asSlice(&callee.blocks)
  at = usize.ZERO
  while at < blocks.length {
    let mut statements = List<Statement>.make()
    let listed = List<Statement>.asSlice(&blocks[at].statements)
    let mut next = usize.ZERO
    while next < listed.length {
      run List<Statement>.append(&mut statements, run statement(&listed[next], &splice))
      next = next + 1
    }
    if let Option<Place>.Some { value: targetPlace } = &projectedReturn {
      if let Terminator.Return { origin: retOrigin } = &blocks[at].terminator {
        run List<Statement>.append(
          &mut statements,
          Statement.Assign {
            destination: run Mir.copyPlace(&targetPlace),
            value: Rvalue.Use {
              value: Operand.Move {
                place: Place { local: returnLocal, projections: List<Projection>.make() },
              },
            },
            origin: mapOrigin(&splice, retOrigin),
          },
        )
      }
    }
    run List<Block>.append(
      &mut caller.blocks,
      Block {
        suspends: blocks[at].suspends, statements: move statements,
        terminator: run terminator(&blocks[at].terminator, &splice),
      },
    )
    at = at + 1
  }
  let cancels = List<Cancel>.asSlice(&callee.cancels)
  at = usize.ZERO
  while at < cancels.length {
    run List<Cancel>.append(
      &mut caller.cancels,
      Cancel { point: splice.blocks + cancels[at].point, entry: splice.blocks + cancels[at].entry },
    )
    at = at + 1
  }
  run mergeTables(&mut caller.*, callee, &splice, via)
  return true
}

fn placeIsPureLocal(place: &Place) -> bool {
  let projs = List<Projection>.asSlice(&place.projections)
  let mut at = usize.ZERO
  while at < projs.length {
    match &projs[at] {
      Projection.Deref => { return false }
      Projection.Index {..} => { return false }
      _ => {}
    }
    at = at + usize.ONE
  }
  return true
}

fn operandIsPure(op: &Operand) -> bool {
  return match &op.* {
    Operand.Copy {place} => placeIsPureLocal(&place)
    Operand.Move {place} => placeIsPureLocal(&place)
    Operand.Integer {..} => true
    Operand.Float {..} => true
    Operand.Boolean {..} => true
    Operand.Unit => true
    Operand.StaticBytes {..} => true
    Operand.StaticText {..} => true
    Operand.StaticValue {..} => true
    Operand.Null {..} => true
  }
}

fn operandPlainLocal(op: &Operand) -> usize {
  return match &op.* {
    Operand.Copy {place} => if List<Projection>.length(&place.projections) == usize.ZERO { place.local } else { usize.MAX }
    Operand.Move {place} => if List<Projection>.length(&place.projections) == usize.ZERO { place.local } else { usize.MAX }
    _ => usize.MAX
  }
}

fn operandSmallConst(op: &Operand, maxVal: u64) -> u64 {
  if let Operand.Integer {magnitude, negative, ..} = &op.* {
    if negative || magnitude > maxVal { return u64.MAX }
    return magnitude
  }
  return u64.MAX
}

fn blockSmallConst(stmts: &[Statement], op: &Operand, maxVal: u64) -> u64 {
  let direct = operandSmallConst(op, maxVal)
  if direct <= maxVal { return direct }
  let loc = operandPlainLocal(op)
  if loc == usize.MAX { return u64.MAX }
  let mut k = stmts.length
  while k > usize.ZERO {
    k = k - usize.ONE
    if let Statement.Assign {destination, value, ..} = &stmts[k] {
      if List<Projection>.length(&destination.projections) == usize.ZERO && destination.local == loc {
        if let Rvalue.Use {value: rhs} = &value {
          return operandSmallConst(&rhs, maxVal)
        }
        return u64.MAX
      }
    }
  }
  return u64.MAX
}

/// Returns true when `blocks[block]` ends in a 2-argument `Call` whose second argument is a
/// non-negative integer constant `<= maxVal`.
pub fn callArg1SmallConst(function: &MirFunction, block: usize, maxVal: u64) -> bool {
  let blocks = List<Block>.asSlice(&function.blocks)
  if block >= blocks.length { return false }
  if let Terminator.Call {call} = &blocks[block].terminator {
    let CallTerminator {arguments, ..} = &call.get().*
    let args = List<Operand>.asSlice(&arguments)
    if args.length != 2 { return false }
    let stmts = List<Statement>.asSlice(&blocks[block].statements)
    return blockSmallConst(stmts, &args[usize.ONE], maxVal) <= maxVal
  }
  return false
}

fn resolveBlockCopy(stmts: &[Statement], op: &Operand) -> usize {
  let mut loc = operandPlainLocal(op)
  if loc == usize.MAX { return usize.MAX }
  let mut hops = usize.ZERO
  while hops < 4 {
    let mut next = usize.MAX
    let mut k = stmts.length
    while k > usize.ZERO {
      k = k - usize.ONE
      if let Statement.Assign {destination, value, ..} = &stmts[k] {
        if List<Projection>.length(&destination.projections) == usize.ZERO && destination.local == loc {
          if let Rvalue.Use {value: rhs} = &value {
            next = operandPlainLocal(&rhs)
          }
          k = usize.ZERO
        }
      }
    }
    if next == usize.MAX || next == loc { return loc }
    loc = next
    hops = hops + usize.ONE
  }
  return loc
}

fn rvalueIsPureNoTrap(rv: &Rvalue, allowCounterAdd: bool, counterLocal: usize, stmts: &[Statement]) -> bool {
  return match &rv.* {
    Rvalue.Use {value} => operandIsPure(&value)
    Rvalue.Bitcast {value, ..} => operandIsPure(&value)
    Rvalue.Fill {..} => true
    Rvalue.Unary {operation, value} => {
      if !operandIsPure(&value) { return false }
      return operation == PrefixOperator.Not || operation == PrefixOperator.BitwiseNot
    }
    Rvalue.Binary {operation, left, right} => {
      if !operandIsPure(&left) || !operandIsPure(&right) { return false }
      if operation == InfixOperator.BitAnd || operation == InfixOperator.BitOr || operation == InfixOperator.BitXor
        || operation == InfixOperator.Equals || operation == InfixOperator.NotEquals
        || operation == InfixOperator.LessThan || operation == InfixOperator.LessOrEqual
        || operation == InfixOperator.GreaterThan || operation == InfixOperator.GreaterOrEqual
        || operation == InfixOperator.And || operation == InfixOperator.Or {
        return true
      }
      if allowCounterAdd && operation == InfixOperator.Add {
        return resolveBlockCopy(stmts, &left) == counterLocal && blockSmallConst(stmts, &right, 1) == 1
      }
      return false
    }
    Rvalue.ScalarBinary {operation, left, right} => {
      if !operandIsPure(&left) || !operandIsPure(&right) { return false }
      if operation == ScalarBinary.WrappingAdd || operation == ScalarBinary.WrappingSubtract
        || operation == ScalarBinary.WrappingMultiply || operation == ScalarBinary.SaturatingAdd
        || operation == ScalarBinary.SaturatingSubtract || operation == ScalarBinary.SaturatingMultiply
        || operation == ScalarBinary.RotateLeft || operation == ScalarBinary.RotateRight
        || operation == ScalarBinary.MultiplyHigh {
        return true
      }
      if operation == ScalarBinary.ShiftLeft || operation == ScalarBinary.ShiftRight {
        return blockSmallConst(stmts, &right, 7) <= 7
      }
      return false
    }
    _ => false
  }
}

/// Returns true when `function` is a 1-block, 2-parameter pure wrapper around `ShiftLeft` or
/// `ShiftRight` whose shift count is parameter 1 (so any call passing a constant `0 ..= 7` as
/// argument 1 is guaranteed pure and non-trapping for every Silk integer width `>= 8` bits).
pub fn isPureShift7Wrapper(function: &MirFunction) -> bool {
  if function.releasesPackages { return false }
  if List<Interned<DeclarationId>>.length(&function.externs) != usize.ZERO { return false }
  if List<SharedAccess>.length(&function.accesses) != usize.ZERO { return false }
  if List<EscapeSite>.length(&function.escapes) != usize.ZERO { return false }
  if let Option.Some {..} = &function.suspension { return false }
  if let Option.Some {..} = &function.parks { return false }
  if List<Interned<Type>>.length(&function.parameters) != 2 { return false }
  let blocks = List<Block>.asSlice(&function.blocks)
  if blocks.length != usize.ONE || blocks[usize.ZERO].suspends { return false }
  if let Terminator.Return {..} = &blocks[usize.ZERO].terminator {} else { return false }
  // Local 0 is the return slot; locals 1 and 2 are the two parameters.
  let param1Local: usize = 2
  let mut param1Alias = usize.MAX
  let stmts = List<Statement>.asSlice(&blocks[usize.ZERO].statements)
  let mut sawShift = false
  let mut s = usize.ZERO
  while s < stmts.length {
    if let Statement.Assign {destination, value, ..} = &stmts[s] {
      if !placeIsPureLocal(&destination) { return false }
      let ok = match &value {
        Rvalue.Use {value: op} => {
          if List<Projection>.length(&destination.projections) == usize.ZERO && operandPlainLocal(&op) == param1Local {
            param1Alias = destination.local
          }
          operandIsPure(&op)
        }
        Rvalue.ScalarBinary {operation, left, right} => {
          let rLoc = operandPlainLocal(&right)
          if (operation == ScalarBinary.ShiftLeft || operation == ScalarBinary.ShiftRight)
            && operandIsPure(&left) && (rLoc == param1Local || (param1Alias != usize.MAX && rLoc == param1Alias)) {
            sawShift = true
            true
          } else {
            false
          }
        }
        _ => false
      }
      if !ok { return false }
    } else {
      return false
    }
    s = s + usize.ONE
  }
  return sawShift
}

/// Classifies `function`'s self-purity: `1` = unconditionally pure & total (modulo callees),
/// `2` = pure & total whenever called with a 2nd argument constant `<= 7`, `0` = impure/unknown.
pub fn pureKind(function: &MirFunction) -> u8 {
  if isSelfPureTotal(function) { return 1 }
  if isPureShift7Wrapper(function) { return 2 }
  return 0
}

fn reachesReturnSoon(blocks: &[Block], start: usize) -> bool {
  let mut cur = start
  let mut hops = usize.ZERO
  while hops < 3 && cur < blocks.length {
    match &blocks[cur].terminator {
      Terminator.Return {..} => { return true }
      Terminator.Goto {target, ..} => {
        if target == cur { return false }
        cur = target
      }
      _ => { return false }
    }
    hops = hops + usize.ONE
  }
  return false
}

/// Returns true when `function`'s own MIR body (ignoring callees of direct Silk `Call`s, which the
/// caller verifies transitively) performs no memory reads/writes through pointers, cannot trap,
/// cannot suspend, and is guaranteed to terminate (either acyclic or a single small counted
/// `0 ..< K` loop with `K <= 64`).
pub fn isSelfPureTotal(function: &MirFunction) -> bool {
  if function.releasesPackages { return false }
  if List<Interned<DeclarationId>>.length(&function.externs) != usize.ZERO { return false }
  if List<SharedAccess>.length(&function.accesses) != usize.ZERO { return false }
  if List<EscapeSite>.length(&function.escapes) != usize.ZERO { return false }
  if let Option.Some {..} = &function.suspension { return false }
  if let Option.Some {..} = &function.parks { return false }
  let blocks = List<Block>.asSlice(&function.blocks)
  if blocks.length == usize.ZERO { return false }

  // Pass 1: Verify terminators and locate any back-edge (`target <= block`).
  let mut backCount = usize.ZERO
  let mut loopHdr = usize.MAX
  let mut loopLatch = usize.MAX
  let mut b = usize.ZERO
  while b < blocks.length {
    if blocks[b].suspends { return false }
    match &blocks[b].terminator {
      Terminator.Return {..} => {}
      Terminator.Goto {target, ..} => {
        if target <= b {
          backCount = backCount + usize.ONE
          loopHdr = target
          loopLatch = b
        }
      }
      Terminator.Branch {condition, thenBlock, elseBlock, ..} => {
        if !operandIsPure(&condition) { return false }
        if thenBlock <= b {
          backCount = backCount + usize.ONE
          loopHdr = thenBlock
          loopLatch = b
        }
        if elseBlock <= b {
          backCount = backCount + usize.ONE
          loopHdr = elseBlock
          loopLatch = b
        }
      }
      Terminator.Call {call} => {
        let CallTerminator {callee, arguments, providers, failure, normal, ..} = &call.get().*
        if let Callee.Instance {..} = &callee {} else { return false }
        if let Option.Some {..} = &failure { return false }
        if List<Operand>.length(&providers) != usize.ZERO { return false }
        let args = List<Operand>.asSlice(&arguments)
        let mut a = usize.ZERO
        while a < args.length {
          if !operandIsPure(&args[a]) { return false }
          a = a + usize.ONE
        }
        if normal <= b {
          backCount = backCount + usize.ONE
          loopHdr = normal
          loopLatch = b
        }
      }
      _ => { return false }
    }
    b = b + usize.ONE
  }
  if backCount > usize.ONE { return false }

  // If there is one back-edge (`loopLatch -> loopHdr`), verify it is a simple counted
  // `counter = 0; while counter < K { ...; counter = counter + 1 }` loop with `K <= 64`.
  let mut counterLocal = usize.MAX
  let mut exitBlk = usize.MAX
  if backCount == usize.ONE {
    if loopHdr == usize.ZERO || loopHdr >= blocks.length { return false }
    let mut condLocal = usize.MAX
    if let Terminator.Branch {condition, thenBlock, elseBlock, ..} = &blocks[loopHdr].terminator {
      condLocal = operandPlainLocal(&condition)
      if thenBlock <= loopHdr || thenBlock > loopLatch { return false }
      let elseExits = elseBlock > loopLatch || reachesReturnSoon(blocks, elseBlock)
      if elseBlock == loopHdr || !elseExits { return false }
      exitBlk = elseBlock
    } else {
      return false
    }
    if condLocal == usize.MAX || exitBlk == usize.MAX { return false }
    let hStmts = List<Statement>.asSlice(&blocks[loopHdr].statements)
    let mut hs = usize.ZERO
    while hs < hStmts.length {
      if let Statement.Assign {destination, value, ..} = &hStmts[hs] {
        if List<Projection>.length(&destination.projections) == usize.ZERO && destination.local == condLocal {
          if let Rvalue.Binary {operation: InfixOperator.LessThan, left, right} = &value {
            let cl = resolveBlockCopy(hStmts, &left)
            if cl != usize.MAX && blockSmallConst(hStmts, &right, 64) <= 64 {
              counterLocal = cl
            }
          }
        }
      }
      hs = hs + usize.ONE
    }
    if counterLocal == usize.MAX { return false }
    // Verify `counterLocal` is initialized to 0 before `loopHdr` and strictly incremented by +1
    // in `loopLatch` (directly or via one temp) with no other writes inside the loop.
    let mut sawInit = false
    let mut sawStep = false
    b = usize.ZERO
    while b < blocks.length {
      let stmts = List<Statement>.asSlice(&blocks[b].statements)
      let mut s = usize.ZERO
      let mut stepTemp = usize.MAX
      while s < stmts.length {
        if let Statement.Assign {destination, value, ..} = &stmts[s] {
          let dstPlain = List<Projection>.length(&destination.projections) == usize.ZERO
          if b < loopHdr && dstPlain && destination.local == counterLocal {
            if let Rvalue.Use {value: op} = &value {
              if blockSmallConst(stmts, &op, 0) == 0 { sawInit = true }
            }
          } else if b >= loopHdr && b <= loopLatch && b != exitBlk {
            if dstPlain && destination.local == counterLocal {
              let mut isValidStep = false
              if b == loopLatch {
                if let Rvalue.Binary {operation: InfixOperator.Add, left, right} = &value {
                  if resolveBlockCopy(stmts, &left) == counterLocal && blockSmallConst(stmts, &right, 1) == 1 {
                    isValidStep = true
                  }
                } else if let Rvalue.Use {value: op} = &value {
                  if stepTemp != usize.MAX && operandPlainLocal(&op) == stepTemp {
                    isValidStep = true
                  }
                }
              }
              if !isValidStep { return false }
              sawStep = true
            } else if b == loopLatch && dstPlain {
              if let Rvalue.Binary {operation: InfixOperator.Add, left, right} = &value {
                if resolveBlockCopy(stmts, &left) == counterLocal && blockSmallConst(stmts, &right, 1) == 1 {
                  stepTemp = destination.local
                }
              }
            }
          }
        }
        s = s + usize.ONE
      }
      b = b + usize.ONE
    }
    if !sawInit || !sawStep { return false }
  }

  // Pass 2: Verify every statement in every block is a pure, non-trapping assignment.
  b = usize.ZERO
  while b < blocks.length {
    let stmts = List<Statement>.asSlice(&blocks[b].statements)
    let mut s = usize.ZERO
    while s < stmts.length {
      if let Statement.Assign {destination, value, ..} = &stmts[s] {
        if !placeIsPureLocal(&destination) { return false }
        let allowAdd = backCount == usize.ONE && b == loopLatch
        if !rvalueIsPureNoTrap(&value, allowAdd, counterLocal, stmts) { return false }
      } else {
        return false
      }
      s = s + usize.ONE
    }
    b = b + usize.ONE
  }
  return true
}
