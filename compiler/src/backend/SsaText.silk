//! A readable listing of one `SsaFunction`, for tests, for the verifier's reports and for people.
//!
//! # When to use
//! Use [`append`] to show what a function lowered to: its arguments, slots, blocks and each
//! block's parameters, instructions and exit.
//!
//! # Details
//! A function begins with `function symbol(v0: i32, v1: ptr) -> i64`, then one `slot sN: size
//! align alignment` line per stack slot (`variable slot` for a builder variable's), then each block
//! as `blockN(parameters):` followed by its indented instructions and its exit. A value is `vN`; a
//! constant is spelled where it is used, as `i32 7`, `f64 0x3FF0000000000000`, `ptr @symbol+8`,
//! `ptr @tls symbol`, or `i32 @link symbol`. An instruction with results starts `vN: kind = `; its
//! operation follows with its operands and immediates. An edge is `blockN(arguments)`.
//!
//! # Gotchas
//! The listing is not a serialization format, and numbers are positions in one function that
//! change whenever lowering changes. Source places are not shown.

import backend.SsaFunction {
  Binary,
  Block,
  Cast,
  ConstantForm,
  Count,
  Edge,
  Exit,
  Extreme,
  Form,
  Instruction,
  Kind,
  Modify,
  Operation,
  Predicate,
  Reduction,
  SsaFunction,
  none,
}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// Appends the listing of `function` to `out`, one line per header, slot, block, instruction and
/// exit, each ending with a newline.
pub effect fn append(function: &SsaFunction, out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  run Bytes.append(&mut out.*, b"function ")
  run Bytes.append(&mut out.*, function.name())
  run Bytes.append(&mut out.*, b"(")
  let arguments = List<u64>.asSlice(&function.arguments)
  let mut at = usize.ZERO
  while at < arguments.length {
    if at != usize.ZERO { run Bytes.append(&mut out.*, b", ") }
    run appendDefinition(function, arguments[at], &mut out.*)
    at = at + usize.ONE
  }
  run Bytes.append(&mut out.*, b") -> ")
  run appendKind(function.result, &mut out.*)
  run Bytes.append(&mut out.*, b"\n")
  at = usize.ZERO
  while at < function.slotCount() {
    let slot = function.slot(at)
    if slot.variable { run Bytes.append(&mut out.*, b"  variable slot s") } else { run Bytes.append(&mut out.*, b"  slot s") }
    run appendDecimal(&mut out.*, usize.toU64(at))
    run Bytes.append(&mut out.*, b": ")
    run appendDecimal(&mut out.*, slot.size)
    run Bytes.append(&mut out.*, b" align ")
    run appendDecimal(&mut out.*, slot.alignment)
    run Bytes.append(&mut out.*, b"\n")
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < function.blockCount() {
    run appendBlock(function, at, &mut out.*)
    at = at + usize.ONE
  }
  return ()
}

/// Appends the listing of block `block` of `function`: its label with its parameters, its
/// instructions and its exit.
pub effect fn appendBlock(function: &SsaFunction, block: usize, out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  let found = function.block(block)
  run Bytes.append(&mut out.*, b"block")
  run appendDecimal(&mut out.*, usize.toU64(block))
  let parameters = List<u64>.asSlice(&found.parameters)
  if parameters.length != usize.ZERO {
    run Bytes.append(&mut out.*, b"(")
    let mut at = usize.ZERO
    while at < parameters.length {
      if at != usize.ZERO { run Bytes.append(&mut out.*, b", ") }
      run appendDefinition(function, parameters[at], &mut out.*)
      at = at + usize.ONE
    }
    run Bytes.append(&mut out.*, b")")
  }
  run Bytes.append(&mut out.*, b":\n")
  let listed = List<usize>.asSlice(&found.instructions)
  let mut at = usize.ZERO
  while at < listed.length {
    run Bytes.append(&mut out.*, b"  ")
    run appendInstruction(function, listed[at], &mut out.*)
    run Bytes.append(&mut out.*, b"\n")
    at = at + usize.ONE
  }
  run Bytes.append(&mut out.*, b"  ")
  run appendExit(function, found, &mut out.*)
  return run Bytes.append(&mut out.*, b"\n")
}

/// Appends instruction `instruction` of `function` without a newline: its results, its operation,
/// its operands and immediates.
pub effect fn appendInstruction(function: &SsaFunction, instruction: usize, out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  let found = function.instruction(instruction)
  let results = found.operation.resultCount(found.kind)
  if results != usize.ZERO {
    run appendDefinition(function, found.result, &mut out.*)
    if results == 2 {
      run Bytes.append(&mut out.*, b", ")
      run appendDefinition(function, found.result + 1, &mut out.*)
    }
    run Bytes.append(&mut out.*, b" = ")
  }
  run appendOperation(function, found.operation, found.kind, &mut out.*)
  let operands = function.operandsOf(instruction)
  let mut at = usize.ZERO
  while at < operands.length {
    if at == usize.ZERO { run Bytes.append(&mut out.*, b" ") } else { run Bytes.append(&mut out.*, b", ") }
    run appendValue(function, operands[at], &mut out.*)
    at = at + usize.ONE
  }
  return run appendImmediates(function, found, &mut out.*)
}

// The operation's name, and for a load, an atomic load or a call the kind it yields.
effect fn appendOperation(function: &SsaFunction, operation: Operation, kind: Kind, out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  match operation {
    Operation.Binary {operation: binary} => { run Bytes.append(&mut out.*, binaryName(binary)) }
    Operation.Negate => { run Bytes.append(&mut out.*, b"negate") }
    Operation.Compare {predicate} => {
      run Bytes.append(&mut out.*, b"compare.")
      run Bytes.append(&mut out.*, predicateName(predicate))
    }
    Operation.Select => { run Bytes.append(&mut out.*, b"select") }
    Operation.Cast {operation: cast} => {
      run Bytes.append(&mut out.*, b"cast.")
      run Bytes.append(&mut out.*, castName(cast))
    }
    Operation.Load {..} => { run Bytes.append(&mut out.*, b"load") }
    Operation.Store {..} => { run Bytes.append(&mut out.*, b"store") }
    Operation.Offset {..} => { run Bytes.append(&mut out.*, b"offset") }
    Operation.Index => { run Bytes.append(&mut out.*, b"index") }
    Operation.CopyBytes {..} => { run Bytes.append(&mut out.*, b"copy") }
    Operation.Fill {..} => { run Bytes.append(&mut out.*, b"fill") }
    Operation.SlotAddress {slot} => {
      run Bytes.append(&mut out.*, b"slot s")
      run appendDecimal(&mut out.*, usize.toU64(slot))
    }
    Operation.FrameAddress => { run Bytes.append(&mut out.*, b"frame") }
    Operation.DynamicSlot {..} => { run Bytes.append(&mut out.*, b"dynamic") }
    Operation.Call {symbol, fixed} => {
      run Bytes.append(&mut out.*, b"call @")
      run Bytes.append(&mut out.*, function.symbolName(symbol))
      if fixed != usize.MAX {
        run Bytes.append(&mut out.*, b" fixed ")
        run appendDecimal(&mut out.*, usize.toU64(fixed))
      }
      if kind.isUnit() { run Bytes.append(&mut out.*, b" -> void") }
    }
    Operation.CallIndirect => {
      run Bytes.append(&mut out.*, b"call.indirect")
      if kind.isUnit() { run Bytes.append(&mut out.*, b" -> void") }
    }
    Operation.Overflow {operation: binary, signed} => {
      run Bytes.append(&mut out.*, b"overflow.")
      run Bytes.append(&mut out.*, binaryName(binary))
      run appendSign(signed, &mut out.*)
    }
    Operation.Saturate {operation: binary, signed} => {
      run Bytes.append(&mut out.*, b"saturate.")
      run Bytes.append(&mut out.*, binaryName(binary))
      run appendSign(signed, &mut out.*)
    }
    Operation.Rotate {left} => { if left { run Bytes.append(&mut out.*, b"rotate.left") } else { run Bytes.append(&mut out.*, b"rotate.right") } }
    Operation.Count {which} => {
      if which == Count.Ones { run Bytes.append(&mut out.*, b"count.ones") }
      else if which == Count.LeadingZeros { run Bytes.append(&mut out.*, b"count.leading") }
      else { run Bytes.append(&mut out.*, b"count.trailing") }
    }
    Operation.Extreme {which} => {
      run Bytes.append(&mut out.*, b"extreme.")
      run Bytes.append(&mut out.*, extremeName(which))
    }
    Operation.FusedMultiplyAdd => { run Bytes.append(&mut out.*, b"fma") }
    Operation.SquareRoot => { run Bytes.append(&mut out.*, b"sqrt") }
    Operation.Reduce {which} => {
      run Bytes.append(&mut out.*, b"reduce.")
      run Bytes.append(&mut out.*, reductionName(which))
    }
    Operation.Shuffle {..} => { run Bytes.append(&mut out.*, b"shuffle") }
    Operation.Extract => { run Bytes.append(&mut out.*, b"extract") }
    Operation.Insert => { run Bytes.append(&mut out.*, b"insert") }
    Operation.Splat {..} => { run Bytes.append(&mut out.*, b"splat") }
    Operation.AtomicLoad => { run Bytes.append(&mut out.*, b"atomic.load") }
    Operation.AtomicStore => { run Bytes.append(&mut out.*, b"atomic.store") }
    Operation.AtomicModify {which} => {
      run Bytes.append(&mut out.*, b"atomic.")
      run Bytes.append(&mut out.*, modifyName(which))
    }
    Operation.CompareExchange => { run Bytes.append(&mut out.*, b"atomic.cmpxchg") }
    Operation.Fence => { run Bytes.append(&mut out.*, b"fence") }
    Operation.WasmGlobalGet {index} => {
      run Bytes.append(&mut out.*, b"wasm.global.get ")
      run appendDecimal(&mut out.*, usize.toU64(index))
    }
    Operation.WasmGlobalSet {index} => {
      run Bytes.append(&mut out.*, b"wasm.global.set ")
      run appendDecimal(&mut out.*, usize.toU64(index))
    }
    Operation.WasmMemorySize => { run Bytes.append(&mut out.*, b"wasm.memory.size") }
    Operation.WasmMemoryGrow => { run Bytes.append(&mut out.*, b"wasm.memory.grow") }
    Operation.WasmWait => { run Bytes.append(&mut out.*, b"wasm.wait") }
    Operation.WasmNotify => { run Bytes.append(&mut out.*, b"wasm.notify") }
  }
  return ()
}

// The immediates after the operands: an offset, an alignment, a size, a byte or a mask.
effect fn appendImmediates(function: &SsaFunction, found: Instruction, out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  match found.operation {
    Operation.Load {offset, alignment} => {
      run appendOffset(offset, &mut out.*)
      run Bytes.append(&mut out.*, b" align ")
      run appendDecimal(&mut out.*, usize.toU64(alignment))
    }
    Operation.Store {offset, alignment} => {
      run appendOffset(offset, &mut out.*)
      run Bytes.append(&mut out.*, b" align ")
      run appendDecimal(&mut out.*, usize.toU64(alignment))
    }
    Operation.Offset {offset} => { run appendOffset(offset, &mut out.*) }
    Operation.CopyBytes {size} => {
      run Bytes.append(&mut out.*, b" size ")
      run appendDecimal(&mut out.*, size)
    }
    Operation.Fill {byte, size} => {
      run Bytes.append(&mut out.*, b" byte ")
      run appendDecimal(&mut out.*, u8.toU64(byte))
      run Bytes.append(&mut out.*, b" size ")
      run appendDecimal(&mut out.*, size)
    }
    Operation.DynamicSlot {alignment} => {
      run Bytes.append(&mut out.*, b" align ")
      run appendDecimal(&mut out.*, alignment)
    }
    Operation.Shuffle {start, count} => {
      run Bytes.append(&mut out.*, b" mask [")
      let mask = function.immediatesAt(start, count)
      let mut at = usize.ZERO
      while at < mask.length {
        if at != usize.ZERO { run Bytes.append(&mut out.*, b", ") }
        if mask[at] == u64.MAX { run Bytes.append(&mut out.*, b"zero") } else { run appendDecimal(&mut out.*, mask[at]) }
        at = at + usize.ONE
      }
      run Bytes.append(&mut out.*, b"]")
    }
    Operation.Splat {count} => {
      run Bytes.append(&mut out.*, b" x ")
      run appendDecimal(&mut out.*, usize.toU64(count))
    }
    _ => {}
  }
  return ()
}

effect fn appendOffset(offset: u64, out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  if offset == 0 { return () }
  run Bytes.append(&mut out.*, b" +")
  return run appendDecimal(&mut out.*, offset)
}

effect fn appendSign(signed: bool, out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  if signed { return run Bytes.append(&mut out.*, b".signed") }
  return run Bytes.append(&mut out.*, b".unsigned")
}

// The exit of `found`: its kind, its value and its edges.
effect fn appendExit(function: &SsaFunction, found: &Block, out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  let edges = List<Edge>.asSlice(&found.edges)
  if found.exit == Exit.Open { return run Bytes.append(&mut out.*, b"open") }
  if found.exit == Exit.Trap { return run Bytes.append(&mut out.*, b"trap") }
  if found.exit == Exit.Unreachable { return run Bytes.append(&mut out.*, b"unreachable") }
  if found.exit == Exit.Return {
    run Bytes.append(&mut out.*, b"return")
    if found.value != none() {
      run Bytes.append(&mut out.*, b" ")
      run appendValue(function, found.value, &mut out.*)
    }
    return ()
  }
  if found.exit == Exit.Jump {
    run Bytes.append(&mut out.*, b"jump ")
    return run appendEdges(function, edges, usize.ZERO, &mut out.*)
  }
  if found.exit == Exit.Branch {
    run Bytes.append(&mut out.*, b"branch ")
    run appendValue(function, found.value, &mut out.*)
    run Bytes.append(&mut out.*, b", ")
    return run appendEdges(function, edges, usize.ZERO, &mut out.*)
  }
  run Bytes.append(&mut out.*, b"switch ")
  run appendValue(function, found.value, &mut out.*)
  run Bytes.append(&mut out.*, b", default ")
  if edges.length != usize.ZERO { run appendEdge(function, &edges[usize.ZERO], &mut out.*) }
  let cases = List<u64>.asSlice(&found.cases)
  let mut at = usize.ZERO
  while at < cases.length && at + usize.ONE < edges.length {
    run Bytes.append(&mut out.*, b", ")
    run appendDecimal(&mut out.*, cases[at])
    run Bytes.append(&mut out.*, b" => ")
    run appendEdge(function, &edges[at + usize.ONE], &mut out.*)
    at = at + usize.ONE
  }
  return ()
}

effect fn appendEdges(function: &SsaFunction, edges: &[Edge], from: usize, out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = from
  while at < edges.length {
    if at != from { run Bytes.append(&mut out.*, b", ") }
    run appendEdge(function, &edges[at], &mut out.*)
    at = at + usize.ONE
  }
  return ()
}

effect fn appendEdge(function: &SsaFunction, edge: &Edge, out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  run Bytes.append(&mut out.*, b"block")
  run appendDecimal(&mut out.*, usize.toU64(edge.block))
  let arguments = List<u64>.asSlice(&edge.arguments)
  if arguments.length == usize.ZERO { return () }
  run Bytes.append(&mut out.*, b"(")
  let mut at = usize.ZERO
  while at < arguments.length {
    if at != usize.ZERO { run Bytes.append(&mut out.*, b", ") }
    run appendValue(function, arguments[at], &mut out.*)
    at = at + usize.ONE
  }
  return run Bytes.append(&mut out.*, b")")
}

/// Appends `value` as an operand: `vN`, a constant's spelling, or `none` for `none()`.
pub effect fn appendValue(function: &SsaFunction, value: u64, out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  if value == none() { return run Bytes.append(&mut out.*, b"none") }
  if value >= usize.toU64(function.valueCount()) {
    run Bytes.append(&mut out.*, b"?")
    return run appendDecimal(&mut out.*, value)
  }
  if !function.isConstant(value) {
    run Bytes.append(&mut out.*, b"v")
    return run appendDecimal(&mut out.*, value)
  }
  let kind = function.kindOf(value)
  let constant = function.constantOf(value)
  run appendKind(kind, &mut out.*)
  run Bytes.append(&mut out.*, b" ")
  if constant.form == ConstantForm.Bits {
    if kind.isFloat() { return run appendHex(&mut out.*, constant.low) }
    if kind.bits > 64 {
      run appendHex(&mut out.*, constant.high)
      run Bytes.append(&mut out.*, b":")
      return run appendHex(&mut out.*, constant.low)
    }
    return run appendDecimal(&mut out.*, constant.low)
  }
  if constant.form == ConstantForm.Link { run Bytes.append(&mut out.*, b"@link ") }
  else if constant.form == ConstantForm.ThreadLocal { run Bytes.append(&mut out.*, b"@tls ") }
  else { run Bytes.append(&mut out.*, b"@") }
  run Bytes.append(&mut out.*, function.symbolName(constant.symbol))
  if constant.low != 0 {
    run Bytes.append(&mut out.*, b"+")
    run appendDecimal(&mut out.*, constant.low)
  }
  return ()
}

// `vN: kind`.
effect fn appendDefinition(function: &SsaFunction, value: u64, out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  run Bytes.append(&mut out.*, b"v")
  run appendDecimal(&mut out.*, value)
  run Bytes.append(&mut out.*, b": ")
  return run appendKind(function.kindOf(value), &mut out.*)
}

/// Appends `kind`: `i32`, `f64`, `ptr`, `<4 x i32>`, or `void` for `Kind.unit()`.
pub effect fn appendKind(kind: Kind, out: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  if kind.isUnit() { return run Bytes.append(&mut out.*, b"void") }
  if kind.isVector() {
    run Bytes.append(&mut out.*, b"<")
    run appendDecimal(&mut out.*, usize.toU64(kind.elements))
    run Bytes.append(&mut out.*, b" x ")
  }
  if kind.form == Form.Address {
    run Bytes.append(&mut out.*, b"ptr")
  } else {
    if kind.form == Form.Float { run Bytes.append(&mut out.*, b"f") } else { run Bytes.append(&mut out.*, b"i") }
    run appendDecimal(&mut out.*, usize.toU64(kind.bits))
  }
  if kind.isVector() { run Bytes.append(&mut out.*, b">") }
  return ()
}

/// Appends `value` in decimal.
pub effect fn appendDecimal(out: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 { run appendDecimal(&mut out.*, u64.divide(value, 10)) }
  let digit = [u64.toU8(48 + u64.remainder(value, 10))]
  return run Bytes.append(&mut out.*, &digit)
}

effect fn appendHex(out: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  run Bytes.append(&mut out.*, b"0x")
  let mut shift: u64 = 64
  let mut started = false
  while shift > 0 {
    shift = shift - 4
    let digit = u64.toU8(u64.shiftRight(value, shift) & 15)
    if digit != 0 || started || shift == 0 {
      started = true
      let mut code = 48 + digit
      if digit >= 10 { code = 55 + digit }
      run Bytes.append(&mut out.*, &[code])
    }
  }
  return ()
}

fn binaryName(operation: Binary) -> &'static [u8] {
  return match operation {
    Binary.Add => b"add"
    Binary.Sub => b"sub"
    Binary.Mul => b"mul"
    Binary.UDiv => b"udiv"
    Binary.SDiv => b"sdiv"
    Binary.URem => b"urem"
    Binary.SRem => b"srem"
    Binary.Shl => b"shl"
    Binary.LShr => b"lshr"
    Binary.AShr => b"ashr"
    Binary.And => b"and"
    Binary.Or => b"or"
    Binary.Xor => b"xor"
  }
}

fn predicateName(predicate: Predicate) -> &'static [u8] {
  return match predicate {
    Predicate.Eq => b"eq"
    Predicate.Ne => b"ne"
    Predicate.Ugt => b"ugt"
    Predicate.Uge => b"uge"
    Predicate.Ult => b"ult"
    Predicate.Ule => b"ule"
    Predicate.Sgt => b"sgt"
    Predicate.Sge => b"sge"
    Predicate.Slt => b"slt"
    Predicate.Sle => b"sle"
    Predicate.Oeq => b"oeq"
    Predicate.One => b"one"
    Predicate.Ogt => b"ogt"
    Predicate.Oge => b"oge"
    Predicate.Olt => b"olt"
    Predicate.Ole => b"ole"
    Predicate.Ord => b"ord"
    Predicate.Ueq => b"ueq"
    Predicate.Une => b"une"
    Predicate.Ugtf => b"ugtf"
    Predicate.Ugef => b"ugef"
    Predicate.Ultf => b"ultf"
    Predicate.Ulef => b"ulef"
    Predicate.Uno => b"uno"
  }
}

fn castName(operation: Cast) -> &'static [u8] {
  return match operation {
    Cast.Trunc => b"trunc"
    Cast.ZExt => b"zext"
    Cast.SExt => b"sext"
    Cast.FPToSI => b"fptosi"
    Cast.FPToUI => b"fptoui"
    Cast.SIToFP => b"sitofp"
    Cast.UIToFP => b"uitofp"
    Cast.FPTrunc => b"fptrunc"
    Cast.FPExt => b"fpext"
    Cast.Bitcast => b"bitcast"
    Cast.IntToPtr => b"inttoptr"
    Cast.PtrToInt => b"ptrtoint"
  }
}

fn extremeName(which: Extreme) -> &'static [u8] {
  return match which {
    Extreme.SignedMinimum => b"smin"
    Extreme.SignedMaximum => b"smax"
    Extreme.UnsignedMinimum => b"umin"
    Extreme.UnsignedMaximum => b"umax"
    Extreme.FloatMinimum => b"fmin"
    Extreme.FloatMaximum => b"fmax"
  }
}

fn reductionName(which: Reduction) -> &'static [u8] {
  return match which {
    Reduction.Add => b"add"
    Reduction.Mul => b"mul"
    Reduction.And => b"and"
    Reduction.Or => b"or"
    Reduction.Xor => b"xor"
    Reduction.SignedMinimum => b"smin"
    Reduction.SignedMaximum => b"smax"
    Reduction.UnsignedMinimum => b"umin"
    Reduction.UnsignedMaximum => b"umax"
    Reduction.FloatAdd => b"fadd"
    Reduction.FloatMul => b"fmul"
    Reduction.FloatMinimum => b"fmin"
    Reduction.FloatMaximum => b"fmax"
  }
}

fn modifyName(which: Modify) -> &'static [u8] {
  return match which {
    Modify.Exchange => b"xchg"
    Modify.Add => b"add"
    Modify.Sub => b"sub"
    Modify.And => b"and"
    Modify.Or => b"or"
    Modify.Xor => b"xor"
    Modify.SignedMinimum => b"smin"
    Modify.SignedMaximum => b"smax"
    Modify.UnsignedMinimum => b"umin"
    Modify.UnsignedMaximum => b"umax"
  }
}
