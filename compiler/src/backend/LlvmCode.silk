//! LLVM bitcode records for one already-lowered MIR instance using demanded neutral layouts. Each
//! definition is one `Bitcode.Module` fragment; a codegen unit merges its fragments and encodes them.

import semantic.Types {Types}
import semantic.ForeignContract {ForeignContract}
import backend.Bitcode
import backend.Bitcode {Module}
import backend.CAbi
import backend.CAbi {Extension as CExtension, Passing as CPassing, Piece as CPiece}
import backend.Coroutine {Coroutine, Extent, Facts, FrameSlot, State, requireCancelExits}
import backend.InstanceKey {HelperRole, InstanceKey}
import backend.InstanceIdentity {InstanceIdentity}
import backend.StackLifetimes
import backend.StackLifetimes {BlockMarkers, Marker}
import backend.Layout {Abi, Field, Layout, Metrics, Sequence, Slice as SliceFacts, Tagged as TaggedFacts, TypeLayout}
import backend.TypeLayouts {DataSpan, TypeLayouts}
import backend.Gap {Code as GapCode, Gap, Source as GapSource}
import backend.Mir
import backend.Mir {
  AggregateField,
  AssemblyFragment,
  Block,
  Callee,
  ContextText,
  Diagnostics,
  FailureEdge,
  Local,
  LocalKind,
  MirFunction,
  Operand,
  Place,
  Projection,
  Rvalue,
  ScalarBinary,
  ScalarUnary,
  Statement,
  SwitchCase,
  Terminator,
  TrapSite,
}
import hir.Hir {InfixOperator, PrefixOperator}
import semantic.SourceLocations {Location}
import semantic.DeclarationId {DeclarationId}
import semantic.Intrinsic as CheckedIntrinsic
import semantic.Intrinsic {MemoryOrder, Primitive as IntrinsicPrimitive}
import semantic.NativeAssembly
import semantic.NativeAssembly {Memory as AssemblyMemory}
import semantic.SealedCore
import semantic.StaticValue
import semantic.StaticValue {Sign as StaticSign, Value as StaticData}
import semantic.SealedCore {CFunction, Lifecycle}
import semantic.Target {Target}
import semantic.Type {ArrayShape, Type}
import semantic.TypedBody {Origin}
import silk.box {Box}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.ownership {Copy}
import silk.pointer {Pointer}
import silk.shared {Shared}
import silk.slice {Slice}
import silk.option {Option}
import silk.f32
import silk.f64
import silk.u32
import silk.u64
import silk.u8
import silk.usize
import silk.list {List}

struct Representation {
  aggregate: bool,
  size: usize,
  bits: usize,
  signed: bool,
  unit: bool,
  pointer: bool,
  floating: bool,
  /// The lane count of a SIMD vector or mask, whose `bits` are one lane's; zero for a scalar.
  lanes: usize,
  /// A union aggregate's alignment, which lets a 16-byte union copy as one integer; zero for
  /// any other value.
  unionAlignment: usize,
}

impl Copy for Representation {}

// An aggregate value is never a first-class SSA value: its value is the address of its bytes, and a
// store copies them with `llvm.memmove`. First-class `[N x i8]` loads and stores make LLVM's SROA,
// InstCombine and SLP passes scale with the byte count, which took certificate-path-validation's
// optimized build past two minutes. A unit value is `Bitcode.none()`.
struct Value {
  scalar: Representation,
  value: u64,
}

impl Copy for Value {}

struct Writer {
  module: Module,
  /// The defined function's symbol, which qualifies its private constants.
  symbol: Bytes,
  /// Where a trap emitted for the current statement reports to the current observer (event 6, N7).
  trap: Option<TrapReport>,
  /// Whether the code is shaped for an unoptimized (`-O0`) compile, whose fast instruction selector
  /// gives up on a function with a `switch`, an `llvm.memmove` or an `i1` return without `zeroext`:
  /// moves between distinct places use `llvm.memcpy`, a switch becomes a compare-and-branch chain,
  /// a fallible status is `zeroext`, and locals get no lifetime markers, which `-O0` never reads.
  fastPath: bool,
  /// The target's address width in bits.
  pointerBits: usize,
  /// The function being built: each MIR local's storage address, each failure slot's context
  /// companion address (`none()` for a slot without one), and each MIR block's handle.
  slots: List<u64>,
  companions: List<u64>,
  blocks: List<u64>,
  /// Caller copies of indirect C arguments in the entry block: block, parameter and address.
  copies: List<CallerCopy>,
  /// Entry-block copies that cold drops of whole aggregate locals run on: block, statement and
  /// address (`emitDropCopySlots`).
  dropCopies: List<DropCopy>,
  /// Its arguments: each written parameter's first lane (`none()` for a unit one), the hidden
  /// provider addresses, and the hidden result, failure, context, observer, cause and site
  /// addresses; a coroutine's transfer record and frame. Absent ones are `none()`.
  parameters: List<u64>,
  providers: List<u64>,
  out: u64,
  failure: u64,
  context: u64,
  observer: u64,
  cause: u64,
  site: u64,
  transfer: u64,
  frame: u64,
  /// Per MIR block, whether its switch dispatches through a table of block addresses, and the
  /// tables the function being built uses, defined once its blocks have positions.
  threaded: List<bool>,
  tables: List<JumpTable>,
}

/// A private table of block addresses one threaded switch loads from: its name, its array type,
/// and the block handle of each slot.
struct JumpTable {
  name: Bytes,
  ty: u64,
  slots: List<u64>,
}

/// An observed trap's report inputs: the observer and selected-cause local addresses, the site
/// label of the statement being emitted, and the target word width in bits.
struct TrapReport {
  observer: u64,
  cause: u64,
  label: Bytes,
  bits: usize,
  /// The slot of the function's package entry site, or `none()` when the function has none.
  entry: u64,
}

/// One caller copy slot of an indirect C argument.
struct CallerCopy {
  block: usize,
  parameter: usize,
  address: u64,
}

struct DropCopy {
  block: usize,
  statement: usize,
  address: u64,
  size: usize,
}

impl Copy for CallerCopy {}
impl Copy for DropCopy {}

effect fn writerFor(target: &Target, fastPath: bool) -> Writer ! OutOfMemoryError ? &mut Allocator {
  return run writerOfWidth(u32.toUsize(Target.pointerBits(target)), fastPath)
}

// A writer for a target whose addresses are `pointerBits` wide; zero for declarations, which use none.
effect fn writerOfWidth(pointerBits: usize, fastPath: bool) -> Writer ! OutOfMemoryError ? &mut Allocator {
  return Writer {module: Module.make(), symbol: Bytes.make(), trap: Option<TrapReport>.none(), fastPath: fastPath,
    pointerBits: pointerBits, slots: List<u64>.make(), companions: List<u64>.make(),
    blocks: List<u64>.make(), copies: List<CallerCopy>.make(), dropCopies: List<DropCopy>.make(), parameters: List<u64>.make(), providers: List<u64>.make(),
    out: Bitcode.none(), failure: Bitcode.none(), context: Bitcode.none(), observer: Bitcode.none(), cause: Bitcode.none(),
    site: Bitcode.none(), transfer: Bitcode.none(), frame: Bitcode.none(), threaded: List<bool>.make(),
    tables: List<JumpTable>.make()}
}

// Forgets the function just built, keeping the module and its counter.
fn resetFunction(writer: &mut Writer) -> () {
  List<u64>.clear(&mut writer.*.slots)
  List<u64>.clear(&mut writer.*.companions)
  List<u64>.clear(&mut writer.*.blocks)
  List<CallerCopy>.clear(&mut writer.*.copies)
  List<DropCopy>.clear(&mut writer.*.dropCopies)
  List<u64>.clear(&mut writer.*.parameters)
  List<u64>.clear(&mut writer.*.providers)
  writer.out = Bitcode.none()
  writer.failure = Bitcode.none()
  writer.context = Bitcode.none()
  writer.observer = Bitcode.none()
  writer.cause = Bitcode.none()
  writer.site = Bitcode.none()
  writer.transfer = Bitcode.none()
  writer.frame = Bitcode.none()
  return ()
}

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut at = usize.ZERO
  while at < a.length {
    if a[at] != b[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn scalar(ty: &Shared<Type>, target: &Target) -> Representation {
  return Shared<Type>.with<Representation>(
    ty,
    fn(value: &Type) -> Representation {
      return match & value.* {
        Type.Reference {..} => Representation {aggregate: false, size: usize.ZERO,
          bits: u32.toUsize(Target.pointerBits(target)),
          signed: false,
          unit: false,
          pointer: true,
          floating: false,
          lanes: usize.ZERO,
          unionAlignment: usize.ZERO,
        }
        Type.ForeignFunction {..} => Representation {aggregate: false, size: usize.ZERO,
          bits: u32.toUsize(Target.pointerBits(target)), signed: false, unit: false, pointer: true, floating: false, lanes: usize.ZERO, unionAlignment: usize.ZERO}
        Type.Pointer {..} => Representation {aggregate: false, size: usize.ZERO,
          bits: u32.toUsize(Target.pointerBits(target)),
          signed: false,
          unit: false,
          pointer: true,
          floating: false,
          lanes: usize.ZERO,
          unionAlignment: usize.ZERO,
        }
        Type.Unit => Representation {aggregate: false, size: usize.ZERO, bits: usize.ZERO, signed: false, unit: true, pointer: false, floating: false, lanes: usize.ZERO, unionAlignment: usize.ZERO}
        // A vector is its lane's representation repeated; a mask's lane is `i1`.
        Type.Vector {element, lanes} => {
          let mut lane = scalar(&element, target)
          lane.lanes = match move Type.extentValue(Bytes.asSlice(&lanes)) {
            Option<usize>.Some {value: count} => count
            Option<usize>.None => usize.ZERO
          }
          return lane
        }
        Type.Primitive {name} => {
          let word = Bytes.asSlice(&name)
          if same(word, b"bool") {
            return Representation {aggregate: false, size: usize.ZERO, bits: usize.ONE, signed: false, unit: false, pointer: false, floating: false, lanes: usize.ZERO, unionAlignment: usize.ZERO}
          }
          let mut signed = false
          if word.length > usize.ZERO && word[usize.ZERO] == 105 {
            signed = true
          }
          let mut bits = usize.ZERO
          if same(word, b"i8") || same(word, b"u8") {
            bits = 8
          }
          if same(word, b"i16") || same(word, b"u16") {
            bits = 16
          }
          if same(word, b"i32") || same(word, b"u32") || same(word, b"char") {
            bits = 32
          }
          if same(word, b"i64") || same(word, b"u64") {
            bits = 64
          }
          if same(word, b"isize") || same(word, b"usize") {
            bits = u32.toUsize(Target.pointerBits(target))
          }
          let floating = same(word, b"f32") || same(word, b"f64")
          if same(word, b"f32") {
            bits = 32
          }
          if same(word, b"f64") {
            bits = 64
          }
          return Representation {aggregate: false, size: usize.ZERO,
            bits: bits,
            signed: signed,
            unit: false,
            pointer: false,
            floating: floating,
          lanes: usize.ZERO,
          unionAlignment: usize.ZERO,
        }
        }
        _ => Representation {aggregate: false, size: usize.ZERO, bits: usize.ZERO, signed: false, unit: false, pointer: false, floating: false, lanes: usize.ZERO, unionAlignment: usize.ZERO}
      }
    },
  )
}

// Types.

effect fn integerType(writer: &mut Writer, bits: usize) -> u64 ! OutOfMemoryError ? &mut Allocator {
  return run Module.integer(&mut writer.*.module, bits)
}

effect fn pointerType(writer: &mut Writer) -> u64 ! OutOfMemoryError ? &mut Allocator {
  return run Module.pointer(&mut writer.*.module)
}

effect fn voidType(writer: &mut Writer) -> u64 ! OutOfMemoryError ? &mut Allocator {
  return run Module.void(&mut writer.*.module)
}

// The target word, an integer as wide as an address.
effect fn wordType(writer: &mut Writer) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let bits = writer.pointerBits
  return run Module.integer(&mut writer.*.module, bits)
}

// The type of one lane, which is the whole type of a scalar.
effect fn laneTypeOf(writer: &mut Writer, value: Representation) -> u64 ! OutOfMemoryError ? &mut Allocator {
  if value.floating { return run Module.floating(&mut writer.*.module, value.bits) }
  return run Module.integer(&mut writer.*.module, value.bits)
}

effect fn typeOf(writer: &mut Writer, value: Representation) -> u64 ! OutOfMemoryError ? &mut Allocator {
  if value.aggregate {
    let byte = run Module.integer(&mut writer.*.module, 8)
    return run Module.array(&mut writer.*.module, value.size, byte)
  }
  if value.pointer { return run pointerType(&mut writer.*) }
  if value.unit { return run voidType(&mut writer.*) }
  let lane = run laneTypeOf(&mut writer.*, value)
  if value.lanes != usize.ZERO { return run Module.vector(&mut writer.*.module, value.lanes, lane) }
  return lane
}

// The function type of `result` over `parameters`.
effect fn functionType(writer: &mut Writer, result: u64, parameters: &[u64]) -> u64 ! OutOfMemoryError ? &mut Allocator {
  return run Module.function(&mut writer.*.module, result, parameters, false)
}

// Appends `value` in decimal.
effect fn appendDecimal(text: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 { run appendDecimal(&mut text.*, u64.divide(value, 10)) }
  let digit = [u64.toU8(48 + u64.remainder(value, 10))]
  return run Bytes.append(&mut text.*, &digit)
}

// The overload suffix of an LLVM intrinsic name: `i32` for an integer, `f64` for `double`, and
// `v16i8` for a vector.
effect fn appendMangled(text: &mut Bytes, value: Representation) -> () ! OutOfMemoryError ? &mut Allocator {
  if value.pointer { return run Bytes.append(&mut text.*, b"p0") }
  if value.lanes != usize.ZERO {
    run Bytes.append(&mut text.*, b"v")
    run appendDecimal(&mut text.*, usize.toU64(value.lanes))
  }
  if value.floating { run Bytes.append(&mut text.*, b"f") } else { run Bytes.append(&mut text.*, b"i") }
  return run appendDecimal(&mut text.*, usize.toU64(value.bits))
}

// `llvm.<stem>.<type>`.
effect fn intrinsicName(stem: &[u8], kind: Representation) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut name = run Bytes.copy(b"llvm.")
  run Bytes.append(&mut name, stem)
  run Bytes.append(&mut name, b".")
  run appendMangled(&mut name, kind)
  return move name
}

// Constants.

// The integer constant `value` of `kind`, every lane `value` for a vector.
effect fn intOf(writer: &mut Writer, kind: Representation, value: u64) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let ty = run typeOf(&mut writer.*, kind)
  return run Module.int(&mut writer.*.module, ty, value)
}

// The integer constant `value` of `bits` bits.
effect fn integerOf(writer: &mut Writer, bits: usize, value: u64) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let ty = run integerType(&mut writer.*, bits)
  return run Module.int(&mut writer.*.module, ty, value)
}

// The target word constant `value`.
effect fn wordOf(writer: &mut Writer, value: usize) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let bits = writer.pointerBits
  return run integerOf(&mut writer.*, bits, usize.toU64(value))
}

// The floating constant of `kind` equal to the binary64 `bits`, every lane for a vector.
effect fn floatOf(writer: &mut Writer, kind: Representation, bits: u64) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let ty = run typeOf(&mut writer.*, kind)
  return run Module.float(&mut writer.*.module, ty, bits)
}

effect fn boolOf(writer: &mut Writer, value: bool) -> u64 ! OutOfMemoryError ? &mut Allocator {
  if value { return run integerOf(&mut writer.*, usize.ONE, 1) }
  return run integerOf(&mut writer.*, usize.ONE, 0)
}

effect fn nullOf(writer: &mut Writer) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let ty = run pointerType(&mut writer.*)
  return run Module.zero(&mut writer.*.module, ty)
}

// The two's complement bits of a decimal literal, negated when `negative`.
fn decimalBits(digits: &[u8], negative: bool) -> u64 {
  let mut value: u64 = 0
  let mut at = usize.ZERO
  while at < digits.length {
    value = u64.wrappingAdd(u64.wrappingMultiply(value, 10), u8.toU64(digits[at] - 48))
    at = at + usize.ONE
  }
  if negative { return u64.wrappingSubtract(0, value) }
  return value
}

// Names.

// Names value `reference` `prefix` followed by a fresh number, as `%v<n>` is.
fn freshName(writer: &mut Writer, prefix: u64) -> u64 {
  return Bitcode.named(prefix, Module.fresh(&mut writer.*.module))
}

// A new block named by the fixed label `text`.
effect fn labelled(writer: &mut Writer, text: &[u8]) -> u64 ! OutOfMemoryError ? &mut Allocator {
  return run Module.newBlock(&mut writer.*.module, Bitcode.plain(Bitcode.prefix(text)))
}

// A new block named by the fixed label `text` followed by `number`, such as `resume2`.
effect fn labelledNumber(writer: &mut Writer, text: &[u8], number: usize) -> u64 ! OutOfMemoryError ? &mut Allocator {
  return run Module.newBlock(&mut writer.*.module, Bitcode.named(Bitcode.prefix(text), number))
}

fn startBlock(writer: &mut Writer, handle: u64) -> () {
  return Module.startBlock(&mut writer.*.module, handle)
}

// The handle of MIR block `index`.
fn blockAt(writer: &Writer, index: usize) -> u64 {
  return List<u64>.get(&writer.blocks, index)
}

// The storage address of MIR local `index`.
fn slotOf(writer: &Writer, index: usize) -> u64 {
  return List<u64>.get(&writer.slots, index)
}

// Instructions.

effect fn binaryOf(writer: &mut Writer, op: u64, left: u64, right: u64) -> u64 ! OutOfMemoryError ? &mut Allocator {
  return run Module.binary(&mut writer.*.module, op, left, right, 0)
}

effect fn compareOf(writer: &mut Writer, predicate: u64, left: u64, right: u64) -> u64 ! OutOfMemoryError ? &mut Allocator {
  return run Module.compare(&mut writer.*.module, predicate, left, right, 0)
}

effect fn selectOf(writer: &mut Writer, condition: u64, chosen: u64, otherwise: u64) -> u64 ! OutOfMemoryError ? &mut Allocator {
  return run Module.select(&mut writer.*.module, condition, chosen, otherwise)
}

// `xor` of `value` with all ones: the negation of a flag.
effect fn notOf(writer: &mut Writer, kind: Representation, value: u64) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let ones = run intOf(&mut writer.*, kind, u64.MAX)
  return run binaryOf(&mut writer.*, Bitcode.opXor(), value, ones)
}

effect fn loadOf(writer: &mut Writer, kind: Representation, address: u64, alignment: usize) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let ty = run typeOf(&mut writer.*, kind)
  return run Module.load(&mut writer.*.module, ty, address, usize.toU64(alignment), false)
}

effect fn loadPointer(writer: &mut Writer, address: u64, alignment: usize) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let ty = run pointerType(&mut writer.*)
  return run Module.load(&mut writer.*.module, ty, address, usize.toU64(alignment), false)
}

effect fn storeOf(writer: &mut Writer, value: u64, address: u64, alignment: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  return run Module.store(&mut writer.*.module, value, address, usize.toU64(alignment), false)
}

effect fn castOf(writer: &mut Writer, op: u64, input: &Value, output: Representation) -> Value ! OutOfMemoryError ? &mut Allocator {
  let ty = run typeOf(&mut writer.*, output)
  return Value {scalar: output, value: run Module.cast(&mut writer.*.module, op, input.value, ty)}
}

// The address `offset` bytes past `base`, indexed by an `i64`.
effect fn byteOffset(writer: &mut Writer, base: u64, offset: usize) -> u64 ! OutOfMemoryError ? &mut Allocator {
  return run Module.byteGep(&mut writer.*.module, base, usize.toU64(offset))
}

// The address `offset` bytes past `base`, indexed by a target word.
effect fn wordOffset(writer: &mut Writer, base: u64, offset: usize) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let index = run wordOf(&mut writer.*, offset)
  return run indexedOffset(&mut writer.*, base, index)
}

// The address `index` bytes past `base`.
effect fn indexedOffset(writer: &mut Writer, base: u64, index: u64) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let byte = run integerType(&mut writer.*, 8)
  let indices = [index]
  return run Module.gep(&mut writer.*.module, 0, byte, base, &indices)
}

// Calls the function `name` of type `result(parameters)` with `arguments`, declaring it on first use.
effect fn callNamed(writer: &mut Writer, name: &[u8], result: u64, parameters: &[u64], arguments: &[u64]) -> u64
! OutOfMemoryError ? &mut Allocator {
  let ty = run functionType(&mut writer.*, result, parameters)
  return run Module.callNamed(&mut writer.*.module, name, ty, arguments)
}

// Calls `llvm.<stem>.<kind>` over `operands` of `kind`.
effect fn callIntrinsic(writer: &mut Writer, stem: &[u8], kind: Representation, operands: &[u64]) -> u64
! OutOfMemoryError ? &mut Allocator {
  let ty = run typeOf(&mut writer.*, kind)
  let mut parameters = List<u64>.make()
  let mut at = usize.ZERO
  while at < operands.length {
    run List<u64>.append(&mut parameters, ty)
    at = at + usize.ONE
  }
  let name = run intrinsicName(stem, kind)
  return run callNamed(&mut writer.*, Bytes.asSlice(&name), ty, List<u64>.asSlice(&parameters), operands)
}

// `call void @llvm.trap()` then `unreachable`.
effect fn trapHere(writer: &mut Writer) -> () ! OutOfMemoryError ? &mut Allocator {
  let void = run voidType(&mut writer.*)
  let none = run callNamed(&mut writer.*, b"llvm.trap", void, &[], &[])
  return run Module.unreachable(&mut writer.*.module)
}

effect fn branch(writer: &mut Writer, target: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  return run Module.br(&mut writer.*.module, target)
}

effect fn branchIf(writer: &mut Writer, condition: u64, onTrue: u64, onFalse: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  return run Module.condBr(&mut writer.*.module, condition, onTrue, onFalse)
}

// Starts or ends the life of a local's stack slot (backend.StackLifetimes), in Clang 22's
// one-operand form.
effect fn lifetimeCall(writer: &mut Writer, which: &[u8], address: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let void = run voidType(&mut writer.*)
  let pointer = run pointerType(&mut writer.*)
  let parameters = [pointer]
  let arguments = [address]
  let mut name = run Bytes.copy(b"llvm.lifetime.")
  run Bytes.append(&mut name, which)
  run Bytes.append(&mut name, b".p0")
  let none = run callNamed(&mut writer.*, Bytes.asSlice(&name), void, &parameters, &arguments)
  return ()
}

// Starts or ends a local's life together with its failure context companion's, if it owns one.
effect fn markLife(writer: &mut Writer, which: &[u8], local: usize, companions: &[usize]) -> ()
! OutOfMemoryError ? &mut Allocator {
  let slot = slotOf(&writer.*, local)
  run lifetimeCall(&mut writer.*, which, slot)
  let mut at = usize.ZERO
  while at < companions.length {
    if companions[at] == local {
      let companion = List<u64>.get(&writer.companions, local)
      return run lifetimeCall(&mut writer.*, which, companion)
    }
    at = at + usize.ONE
  }
}

effect fn lifetimeCalls(writer: &mut Writer, which: &[u8], locals: &[usize], companions: &[usize]) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < locals.length {
    run markLife(&mut writer.*, which, locals[at], companions)
    at = at + usize.ONE
  }
}

// Copies `size` bytes from `source` to `destination`, whose alignment `alignment` is known when not
// zero. Places known not to overlap copy with `llvm.memcpy`: LLVM's fast instruction selector lowers
// it but not `llvm.memmove`, and memcpyopt folds a chain of memcpys (a struct literal built in a
// temporary, then copied into its binding) where it leaves memmoves alone.
effect fn copyCall(writer: &mut Writer, destination: u64, alignment: usize, source: u64, size: usize, distinct: bool) -> ()
! OutOfMemoryError ? &mut Allocator {
  let void = run voidType(&mut writer.*)
  let pointer = run pointerType(&mut writer.*)
  let wide = run integerType(&mut writer.*, 64)
  let flag = run integerType(&mut writer.*, usize.ONE)
  let parameters = [pointer, pointer, wide, flag]
  let ty = run functionType(&mut writer.*, void, &parameters)
  let mut name: &[u8] = b"llvm.memmove.p0.p0.i64"
  if distinct { name = b"llvm.memcpy.p0.p0.i64" }
  let callee = run Module.functionRef(&mut writer.*.module, name, ty)
  let length = run integerOf(&mut writer.*, 64, usize.toU64(size))
  let volatile = run boolOf(&mut writer.*, false)
  let arguments = [destination, source, length, volatile]
  let mut attributes: u64 = 0
  if alignment != usize.ZERO {
    Module.beginAttributes(&mut writer.*.module)
    let encoding: [u64; 3] = [1, Bitcode.attrAlign(), usize.toU64(alignment)]
    run Module.attributeGroup(&mut writer.*.module, 1, &encoding)
    attributes = run Module.endAttributes(&mut writer.*.module)
  }
  let none = run Module.call(&mut writer.*.module, ty, callee, &arguments, attributes, false)
  return ()
}

// Sets `size` bytes at `destination` to `byte` with one `llvm.memset`.
effect fn fillCall(writer: &mut Writer, destination: u64, alignment: usize, byte: u8, size: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let void = run voidType(&mut writer.*)
  let pointer = run pointerType(&mut writer.*)
  let narrow = run integerType(&mut writer.*, 8)
  let wide = run integerType(&mut writer.*, 64)
  let flag = run integerType(&mut writer.*, usize.ONE)
  let parameters = [pointer, narrow, wide, flag]
  let ty = run functionType(&mut writer.*, void, &parameters)
  let callee = run Module.functionRef(&mut writer.*.module, b"llvm.memset.p0.i64", ty)
  let value = run integerOf(&mut writer.*, 8, u8.toU64(byte))
  let length = run integerOf(&mut writer.*, 64, usize.toU64(size))
  let volatile = run boolOf(&mut writer.*, false)
  let arguments = [destination, value, length, volatile]
  let mut attributes: u64 = 0
  if alignment != usize.ZERO {
    Module.beginAttributes(&mut writer.*.module)
    let encoding: [u64; 3] = [1, Bitcode.attrAlign(), usize.toU64(alignment)]
    run Module.attributeGroup(&mut writer.*.module, 1, &encoding)
    attributes = run Module.endAttributes(&mut writer.*.module)
  }
  drop run Module.call(&mut writer.*.module, ty, callee, &arguments, attributes, false)
  return ()
}

// Whether `value` is a `bool` result, which Clang's fast instruction selector refuses to return bare,
// so a fast-path function marks it `zeroext`.
fn extendedFlag(writer: &Writer, value: Representation) -> bool {
  return writer.fastPath && !value.aggregate && !value.pointer && !value.unit && !value.floating && value.lanes == usize.ZERO
    && value.bits == usize.ONE
}

// The result attributes of a function returning `zeroext` when `extended`, declared and called
// alike: an attribute list operand.
effect fn resultAttributes(writer: &mut Writer, extended: bool) -> u64 ! OutOfMemoryError ? &mut Allocator {
  if !extended { return 0 }
  Module.beginAttributes(&mut writer.*.module)
  let encoding: [u64; 2] = [0, Bitcode.attrZeroExt()]
  run Module.attributeGroup(&mut writer.*.module, Bitcode.positionResult(), &encoding)
  return run Module.endAttributes(&mut writer.*.module)
}

// Defines one private constant of `ty` initialized by `initializer`, named `<symbol>.<stem>.<n>`.
effect fn privateConstant(writer: &mut Writer, stem: &[u8], ty: u64, initializer: u64) -> u64
! OutOfMemoryError ? &mut Allocator {
  let mut name = run Bytes.copy(Bytes.asSlice(&writer.symbol))
  run Bytes.append(&mut name, stem)
  run appendDecimal(&mut name, usize.toU64(Module.fresh(&mut writer.*.module)))
  let global = run Module.defineObject(&mut writer.*.module, Bytes.asSlice(&name), ty, Bitcode.linkPrivate(), true, initializer)
  Module.setUnnamed(&mut writer.*.module, global, 1)
  return global
}

// Defines one private constant holding `bytes` and returns its address.
effect fn staticBytes(writer: &mut Writer, bytes: &[u8]) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let initializer = run Module.string(&mut writer.*.module, bytes)
  let byte = run integerType(&mut writer.*, 8)
  let ty = run Module.array(&mut writer.*.module, bytes.length, byte)
  return run privateConstant(&mut writer.*, b".bytes.", ty, initializer)
}

// A private static `string<'static>` descriptor `{address, length}` for `bytes`.
effect fn staticString(writer: &mut Writer, bytes: &[u8], bits: usize) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let data = run staticBytes(&mut writer.*, bytes)
  let pointer = run pointerType(&mut writer.*)
  let word = run integerType(&mut writer.*, bits)
  let ty = run Module.pair(&mut writer.*.module, pointer, word)
  let length = run Module.int(&mut writer.*.module, word, usize.toU64(bytes.length))
  let elements = [data, length]
  let initializer = run Module.aggregate(&mut writer.*.module, ty, &elements)
  return run privateConstant(&mut writer.*, b".string.", ty, initializer)
}

// One text descriptor inside a constant's storage: its address word at `offset` holds the address
// of `bytes`, which a byte image cannot spell.
struct TextAddress {
  offset: usize,
  bytes: Bytes,
}

// Writes the `size` low bytes of `value` at `offset`, least significant first; every target is
// little-endian.
fn writeWord(image: &mut Bytes, offset: usize, size: usize, value: u64) -> () {
  let slots = Bytes.asMutSlice(&mut image.*)
  let mut rest = value
  let mut at = usize.ZERO
  while at < size && at < 8 {
    slots[offset + at] = u64.wrappingToU8(rest)
    rest = rest / 256
    at = at + usize.ONE
  }
  return ()
}

// The two's complement bits of a static integer's sign and magnitude.
fn signedBits(negative: bool, magnitude: u64) -> u64 {
  if !negative || magnitude == 0 { return magnitude }
  return u64.MAX - magnitude + 1
}

// A static value's scalar bits, or its field count when it is an aggregate.
struct StaticLeaf {
  supported: bool,
  scalar: bool,
  bits: u64,
  fields: usize,
}

fn flagBits(flag: bool) -> u64 {
  if flag { return 1 }
  return 0
}

fn staticLeaf(data: &StaticData) -> StaticLeaf {
  return match & data.* {
    StaticData.Unit => StaticLeaf {supported: true, scalar: true, bits: 0, fields: usize.ZERO}
    StaticData.Boolean {value: flag} => StaticLeaf {supported: true, scalar: true, bits: flagBits(flag), fields: usize.ZERO}
    StaticData.Character {scalar: code} => StaticLeaf {supported: true, scalar: true, bits: u32.toU64(code), fields: usize.ZERO}
    StaticData.Integer {sign, magnitude, ..} => StaticLeaf {supported: true, scalar: true,
      bits: signedBits(sign == StaticSign.Negative, magnitude), fields: usize.ZERO}
    StaticData.Enum {sign, magnitude, ..} => StaticLeaf {supported: true, scalar: true,
      bits: signedBits(sign == StaticSign.Negative, magnitude), fields: usize.ZERO}
    StaticData.Float {bits: raw, ..} => StaticLeaf {supported: true, scalar: true, bits: raw, fields: usize.ZERO}
    StaticData.Aggregate {fields: members, variant, ..} => StaticLeaf {supported: !Option<usize>.isSome(&variant), scalar: false,
      bits: 0, fields: List<Shared<StaticData>>.length(&members)}
    _ => StaticLeaf {supported: false, scalar: true, bits: 0, fields: usize.ZERO}
  }
}

// Writes constant `value` of type `ty` at `offset` of `image` as its runtime layout stores it, and
// lists each text descriptor's address word in `texts`. Padding stays zero.
effect fn writeStatic(layouts: &TypeLayouts, function: &MirFunction, target: &Target, value: &Shared<StaticData>,
  ty: &Shared<Type>, offset: usize, image: &mut Bytes, texts: &mut List<TextAddress>) -> ()
! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = Location.make(usize.ZERO, usize.ZERO)
  let text = run StaticValue.textBytes(value)
  // A text descriptor holds its data address at offset zero and its byte length in a target word.
  if let Option<Bytes>.Some {value: bytes} = move text {
    let facts = run sliceFact(layouts, ty, function, span)
    let word = u32.toUsize(Target.pointerBits(target)) / 8
    writeWord(&mut image.*, offset + facts.lengthOffset, word, usize.toU64(Bytes.length(&bytes)))
    run List<TextAddress>.append(&mut texts.*, TextAddress {offset: offset, bytes: move bytes})
    return ()
  }
  let leaf = Shared<StaticData>.with<StaticLeaf>(value, staticLeaf)
  // An aggregate is a fixed array or a cleanup-free struct, as `Mir.materializeEmbedded` admits.
  let mut supported = leaf.supported
  if !leaf.scalar && !Shared<StaticData>.with<bool>(value, StaticValue.isStruct) {
    if let Option<ArrayShape>.None = move Type.arrayShape(ty) { supported = false }
  }
  if !supported {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.relative(GapCode.TypedForm, &owner, span)
  }
  if leaf.scalar {
    let facts = run layoutOf(layouts, ty, function, span)
    writeWord(&mut image.*, offset, facts.size, leaf.bits)
    return ()
  }
  let mut at = usize.ZERO
  while at < leaf.fields {
    let field = run fieldFact(layouts, ty, at, function, span)
    let child = Shared<StaticData>.with<Option<Shared<StaticData>>>(value, fn(data: &StaticData) -> Option<Shared<StaticData>> {
      return StaticValue.field(data, at)
    })
    if let Option<Shared<StaticData>>.Some {value: selected} = move child {
      run writeStatic(layouts, function, target, &selected, &field.ty, offset + field.offset, &mut image.*, &mut texts.*)
    }
    at = at + usize.ONE
  }
  return ()
}

// A private constant holding `value` of type `ty` at its runtime layout and alignment, which a
// shared borrow of a constant addresses for the whole program. Without text it is one byte array;
// each text descriptor's address word splits it into a packed run of bytes and addresses.
effect fn staticValue(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  value: &Shared<StaticData>, ty: &Shared<Type>) -> u64
! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let facts = run layoutOf(layouts, ty, function, Location.make(usize.ZERO, usize.ZERO))
  let mut image = run Bytes.zeroed(facts.size)
  let mut texts = List<TextAddress>.make()
  run writeStatic(layouts, function, target, value, ty, usize.ZERO, &mut image, &mut texts)
  let bytes = Bytes.asSlice(&image)
  let addresses = List<TextAddress>.asSlice(&texts)
  let mut initializer: u64 = 0
  let mut storage: u64 = 0
  if addresses.length == usize.ZERO {
    initializer = run Module.string(&mut writer.*.module, bytes)
    let byte = run integerType(&mut writer.*, 8)
    storage = run Module.array(&mut writer.*.module, bytes.length, byte)
  } else {
    // Fields are listed in declaration order, which a layout may not keep, so runs follow offsets.
    let word = u32.toUsize(Target.pointerBits(target)) / 8
    let pointer = run pointerType(&mut writer.*)
    let byte = run integerType(&mut writer.*, 8)
    let mut types = List<u64>.make()
    let mut elements = List<u64>.make()
    let mut cursor = usize.ZERO
    while cursor < bytes.length {
      let mut next = usize.MAX
      let mut selected = usize.MAX
      let mut at = usize.ZERO
      while at < addresses.length {
        if addresses[at].offset >= cursor && addresses[at].offset < next {
          next = addresses[at].offset
          selected = at
        }
        at = at + usize.ONE
      }
      if next == usize.MAX { next = bytes.length }
      if next > cursor {
        run List<u64>.append(&mut types, run Module.array(&mut writer.*.module, next - cursor, byte))
        run List<u64>.append(&mut elements, run Module.string(&mut writer.*.module, Slice.view<u8>(bytes, cursor, next - cursor)))
      }
      if selected != usize.MAX {
        run List<u64>.append(&mut types, pointer)
        run List<u64>.append(&mut elements, run staticBytes(&mut writer.*, Bytes.asSlice(&addresses[selected].bytes)))
        next = next + word
      }
      cursor = next
    }
    storage = run Module.packed(&mut writer.*.module, List<u64>.asSlice(&types))
    initializer = run Module.aggregate(&mut writer.*.module, storage, List<u64>.asSlice(&elements))
  }
  let global = run privateConstant(&mut writer.*, b".constant.", storage, initializer)
  Module.setAlignment(&mut writer.*.module, global, usize.toU64(facts.alignment))
  return global
}

// The overflow intrinsic result `{ kind, flags }`.
effect fn overflowType(writer: &mut Writer, kind: Representation) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let value = run typeOf(&mut writer.*, kind)
  let flag = run typeOf(&mut writer.*, flags(kind))
  return run Module.pair(&mut writer.*.module, value, flag)
}

// Calls `@llvm.<s|u><stem>.with.overflow` and returns the result pair.
effect fn overflowPair(writer: &mut Writer, stem: &[u8], kind: Representation, left: u64, right: u64) -> u64
! OutOfMemoryError ? &mut Allocator {
  let mut name = run Bytes.copy(b"llvm.")
  if kind.signed { run Bytes.append(&mut name, b"s") } else { run Bytes.append(&mut name, b"u") }
  run Bytes.append(&mut name, stem)
  run Bytes.append(&mut name, b".with.overflow.")
  run appendMangled(&mut name, kind)
  let pair = run overflowType(&mut writer.*, kind)
  let operand = run typeOf(&mut writer.*, kind)
  let parameters = [operand, operand]
  let arguments = [left, right]
  return run callNamed(&mut writer.*, Bytes.asSlice(&name), pair, &parameters, &arguments)
}

// Extracts field `index` (0 the wrapped value, 1 the overflow flag) of an overflow pair.
effect fn pairField(writer: &mut Writer, pair: u64, index: usize) -> u64 ! OutOfMemoryError ? &mut Allocator {
  return run Module.extractValue(&mut writer.*.module, pair, index)
}

/// Shared module definitions, emitted into every unit: the fatal dispatch helper and the foreign
/// personality.
pub effect fn declarations(target: &Target) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut writer = run writerFor(target, false)
  run defineFatalDispatch(&mut writer, target)
  run defineForeignPersonality(&mut writer)
  run defineGuardedReclaim(&mut writer)
  return run Module.serialize(&writer.module)
}

// The guard frame of an adopted allocation's reclaim call: `__silk_guarded_reclaim(reclaim,
// context)` calls `reclaim(context)` under the foreign personality. Allocation drop glue calls it
// instead of guarding itself, so the glue, whose usual path is a tag check and `free`, stays
// inlinable and the value it drops need not stay in memory (#2507).
effect fn defineGuardedReclaim(writer: &mut Writer) -> () ! OutOfMemoryError ? &mut Allocator {
  let void = run voidType(&mut writer.*)
  let pointer = run pointerType(&mut writer.*)
  let parameters = [pointer, pointer]
  let ty = run functionType(&mut writer.*, void, &parameters)
  let mut encoding = List<u64>.make()
  run guardAttributes(&mut encoding)
  Module.beginAttributes(&mut writer.*.module)
  run Module.attributeGroup(&mut writer.*.module, Bitcode.positionFunction(), List<u64>.asSlice(&encoding))
  let attributes = run Module.endAttributes(&mut writer.*.module)
  let function = run Module.defineFunction(&mut writer.*.module, b"__silk_guarded_reclaim", ty, Bitcode.linkInternal(), attributes)
  run guard(&mut writer.*, function)
  let names = [Bitcode.plain(Bitcode.prefix(b"reclaim")), Bitcode.plain(Bitcode.prefix(b"context"))]
  run Module.beginBody(&mut writer.*.module, function, &parameters, &names)
  let entry = run Module.block(&mut writer.*.module, Bitcode.plain(Bitcode.prefix(b"entry")))
  let reclaimParameters = [pointer]
  let reclaimTy = run functionType(&mut writer.*, void, &reclaimParameters)
  let arguments = [Bitcode.local(1)]
  drop run invokeGuarded(&mut writer.*, reclaimTy, Bitcode.local(0), &arguments, 0)
  run Module.retVoid(&mut writer.*.module)
  return run Module.endBody(&mut writer.*.module)
}

// The personality of every foreign guard: it terminates during either unwind phase.
effect fn defineForeignPersonality(writer: &mut Writer) -> () ! OutOfMemoryError ? &mut Allocator {
  let int32 = run integerType(&mut writer.*, 32)
  let int64 = run integerType(&mut writer.*, 64)
  let pointer = run pointerType(&mut writer.*)
  let parameters = [int32, int32, int64, pointer, pointer]
  let ty = run functionType(&mut writer.*, int32, &parameters)
  Module.beginAttributes(&mut writer.*.module)
  let encoding: [u64; 6] = [0, Bitcode.attrNoInline(), 0, Bitcode.attrNoUnwind(), 0, Bitcode.attrNoReturn()]
  run Module.attributeGroup(&mut writer.*.module, Bitcode.positionFunction(), &encoding)
  let attributes = run Module.endAttributes(&mut writer.*.module)
  let function = run Module.defineFunction(&mut writer.*.module, b"__silk_foreign_personality", ty, Bitcode.linkInternal(), attributes)
  let names = [Bitcode.plain(Bitcode.prefix(b"version")), Bitcode.plain(Bitcode.prefix(b"actions")), Bitcode.plain(Bitcode.prefix(b"class")),
    Bitcode.plain(Bitcode.prefix(b"exception")), Bitcode.plain(Bitcode.prefix(b"context"))]
  run Module.beginBody(&mut writer.*.module, function, &parameters, &names)
  let entry = run Module.block(&mut writer.*.module, Bitcode.plain(Bitcode.prefix(b"entry")))
  run trapHere(&mut writer.*)
  return run Module.endBody(&mut writer.*.module)
}

// The fatal dispatch helper an observed trap calls before trapping: event 6 with the selected
// cause's pool handle, or `0`, the trap reason and its site label (failure observer note N7). A
// null observer reports nothing. A record without an adapter is an execution's trap record, which
// forwards to the observer of the drive running it, without a cause.
effect fn defineFatalDispatch(writer: &mut Writer, target: &Target) -> () ! OutOfMemoryError ? &mut Allocator {
  let word = wordSize(target)
  let bits = word * 8
  let void = run voidType(&mut writer.*)
  let pointer = run pointerType(&mut writer.*)
  let wordTy = run integerType(&mut writer.*, bits)
  let byte = run integerType(&mut writer.*, 8)
  let parameters = [pointer, pointer, pointer, pointer]
  let ty = run functionType(&mut writer.*, void, &parameters)
  Module.beginAttributes(&mut writer.*.module)
  let encoding: [u64; 4] = [0, Bitcode.attrNoInline(), 0, Bitcode.attrCold()]
  run Module.attributeGroup(&mut writer.*.module, Bitcode.positionFunction(), &encoding)
  let attributes = run Module.endAttributes(&mut writer.*.module)
  let function = run Module.defineFunction(&mut writer.*.module, b"silk.diagnostic.fatal", ty, Bitcode.linkInternal(), attributes)
  let names = [Bitcode.plain(Bitcode.prefix(b"observer")), Bitcode.plain(Bitcode.prefix(b"cause")), Bitcode.plain(Bitcode.prefix(b"reason")),
    Bitcode.plain(Bitcode.prefix(b"origin"))]
  run Module.beginBody(&mut writer.*.module, function, &parameters, &names)
  let observer = Bitcode.local(0)
  let cause = Bitcode.local(1)
  let reason = Bitcode.local(2)
  let origin = Bitcode.local(3)
  let entry = run labelled(&mut writer.*, b"entry")
  let find = run labelled(&mut writer.*, b"find")
  let report = run labelled(&mut writer.*, b"report")
  let forward = run labelled(&mut writer.*, b"forward")
  let deliver = run labelled(&mut writer.*, b"deliver")
  let selection = run labelled(&mut writer.*, b"selection")
  let call = run labelled(&mut writer.*, b"call")
  let done = run labelled(&mut writer.*, b"done")
  let null = run nullOf(&mut writer.*)
  startBlock(&mut writer.*, entry)
  run branch(&mut writer.*, find)
  startBlock(&mut writer.*, find)
  let next = run Module.reserve(&mut writer.*.module)
  let recordIncoming = [observer, entry, next, forward]
  let record = run Module.phi(&mut writer.*.module, pointer, &recordIncoming)
  Module.setName(&mut writer.*.module, record, Bitcode.plain(Bitcode.prefix(b"record")))
  let heldIncoming = [cause, entry, null, forward]
  let held = run Module.phi(&mut writer.*.module, pointer, &heldIncoming)
  Module.setName(&mut writer.*.module, held, Bitcode.plain(Bitcode.prefix(b"held")))
  let absent = run compareOf(&mut writer.*, Bitcode.intEq(), record, null)
  Module.setName(&mut writer.*.module, absent, Bitcode.plain(Bitcode.prefix(b"absent")))
  run branchIf(&mut writer.*, absent, done, report)
  startBlock(&mut writer.*, report)
  let callback = run loadPointer(&mut writer.*, record, usize.ZERO)
  Module.setName(&mut writer.*.module, callback, Bitcode.plain(Bitcode.prefix(b"callback")))
  let stateAddress = run byteOffset(&mut writer.*, record, word)
  Module.setName(&mut writer.*.module, stateAddress, Bitcode.plain(Bitcode.prefix(b"stateAddress")))
  let adapterless = run compareOf(&mut writer.*, Bitcode.intEq(), callback, null)
  Module.setName(&mut writer.*.module, adapterless, Bitcode.plain(Bitcode.prefix(b"adapterless")))
  run branchIf(&mut writer.*, adapterless, forward, deliver)
  startBlock(&mut writer.*, forward)
  let forwarded = run loadPointer(&mut writer.*, stateAddress, usize.ZERO)
  Module.setName(&mut writer.*.module, forwarded, Bitcode.plain(Bitcode.prefix(b"next")))
  Module.bind(&mut writer.*.module, next, forwarded)
  run branch(&mut writer.*, find)
  startBlock(&mut writer.*, deliver)
  let state = run loadPointer(&mut writer.*, stateAddress, usize.ZERO)
  Module.setName(&mut writer.*.module, state, Bitcode.plain(Bitcode.prefix(b"state")))
  let callableAddress = run byteOffset(&mut writer.*, record, word * 2)
  Module.setName(&mut writer.*.module, callableAddress, Bitcode.plain(Bitcode.prefix(b"callableAddress")))
  let callable = run loadPointer(&mut writer.*, callableAddress, usize.ZERO)
  Module.setName(&mut writer.*.module, callable, Bitcode.plain(Bitcode.prefix(b"callable")))
  let selected = run compareOf(&mut writer.*, Bitcode.intNe(), held, null)
  Module.setName(&mut writer.*.module, selected, Bitcode.plain(Bitcode.prefix(b"selected")))
  run branchIf(&mut writer.*, selected, selection, call)
  startBlock(&mut writer.*, selection)
  let handleAddress = run byteOffset(&mut writer.*, held, companionHandleOffset(target))
  Module.setName(&mut writer.*.module, handleAddress, Bitcode.plain(Bitcode.prefix(b"handleAddress")))
  let handle = run Module.load(&mut writer.*.module, wordTy, handleAddress, 0, false)
  Module.setName(&mut writer.*.module, handle, Bitcode.plain(Bitcode.prefix(b"handle")))
  run branch(&mut writer.*, call)
  startBlock(&mut writer.*, call)
  let zero = run Module.zero(&mut writer.*.module, wordTy)
  let firstIncoming = [zero, deliver, handle, selection]
  let first = run Module.phi(&mut writer.*.module, wordTy, &firstIncoming)
  Module.setName(&mut writer.*.module, first, Bitcode.plain(Bitcode.prefix(b"first")))
  let callbackParameters = [pointer, pointer, byte, wordTy, wordTy, pointer, pointer, pointer, pointer, pointer]
  let callbackType = run functionType(&mut writer.*, wordTy, &callbackParameters)
  let event = run Module.int(&mut writer.*.module, byte, 6)
  let arguments = [callable, state, event, first, zero, reason, origin, null, null, null]
  let answer = run Module.call(&mut writer.*.module, callbackType, callback, &arguments, 0, false)
  Module.setName(&mut writer.*.module, answer, Bitcode.plain(Bitcode.prefix(b"answer")))
  run branch(&mut writer.*, done)
  startBlock(&mut writer.*, done)
  run Module.retVoid(&mut writer.*.module)
  return run Module.endBody(&mut writer.*.module)
}

// Branches to a trap when `condition` holds. Under an observer, the trap first reports `reason` at
// the statement's site through the module's fatal dispatch helper (event 6, N7).
effect fn trapWhen(writer: &mut Writer, condition: u64, reason: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let number = Module.fresh(&mut writer.*.module)
  let trap = run Module.newBlock(&mut writer.*.module, Bitcode.named(Bitcode.prefixTrap(), number))
  let safe = run Module.newBlock(&mut writer.*.module, Bitcode.named(Bitcode.prefixSafe(), number))
  run branchIf(&mut writer.*, condition, trap, safe)
  startBlock(&mut writer.*, trap)
  run reportTrap(&mut writer.*, reason)
  run trapHere(&mut writer.*)
  startBlock(&mut writer.*, safe)
  return ()
}

// Like [`trapWhen`] for an operand the caller supplies, such as a shift count: the violated
// precondition belongs to the call that entered the package, so the report names it (TERM-008).
effect fn trapWhenEntered(writer: &mut Writer, condition: u64, reason: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let number = Module.fresh(&mut writer.*.module)
  let trap = run Module.newBlock(&mut writer.*.module, Bitcode.named(Bitcode.prefixTrap(), number))
  let safe = run Module.newBlock(&mut writer.*.module, Bitcode.named(Bitcode.prefixSafe(), number))
  run branchIf(&mut writer.*, condition, trap, safe)
  startBlock(&mut writer.*, trap)
  let mut entry = Bitcode.none()
  let mut bits = usize.ZERO
  if let Option<TrapReport>.Some {value} = &writer.trap {
    entry = value.entry
    bits = value.bits
  }
  if bits != usize.ZERO {
    let reasonText = run staticString(&mut writer.*, reason, bits)
    run reportTrapDescriptor(&mut writer.*, reasonText, entry)
  }
  run trapHere(&mut writer.*)
  startBlock(&mut writer.*, safe)
  return ()
}

// Where a trap emitted for the statement at `origin` reports: the function's observer and cause
// locals with the statement's recorded site label, when the function observes (event 6, N7).
effect fn trapReport(writer: &Writer, function: &MirFunction, target: &Target, origin: Origin) -> Option<TrapReport>
! OutOfMemoryError ? &mut Allocator {
  let observer = diagnosticLocal(function, usize.ZERO)
  if observer == usize.MAX { return Option<TrapReport>.none() }
  let sites = List<TrapSite>.asSlice(&function.traps)
  let mut at = usize.ZERO
  while at < sites.length {
    if sites[at].origin.node == origin.node && sites[at].origin.location.start == origin.location.start {
      let site = diagnosticLocal(function, 2)
      let mut entry = Bitcode.none()
      if site != usize.MAX { entry = slotOf(writer, site) }
      return Option<TrapReport>.some(TrapReport {observer: slotOf(writer, observer), cause: slotOf(writer, diagnosticLocal(function, usize.ONE)),
        label: run Bytes.copy(Bytes.asSlice(&sites[at].label)), bits: wordSize(target) * 8, entry: entry})
    }
    at = at + usize.ONE
  }
  return Option<TrapReport>.none()
}

// Calls the fatal dispatch helper with the current observer and cause, when the statement has a
// recorded trap site.
effect fn reportTrap(writer: &mut Writer, reason: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let bits = match &writer.trap {
    Option<TrapReport>.Some {value} => value.bits
    Option<TrapReport>.None => { return () }
  }
  let reasonText = run staticString(&mut writer.*, reason, bits)
  return run reportTrapDescriptor(&mut writer.*, reasonText, Bitcode.none())
}

// Calls the fatal dispatch helper with the reason descriptor at address `reasonText`, when the
// statement has a recorded trap site. An `entry` other than `none()` is the local holding the
// function's package entry site, which the report names instead of the statement's site when it is
// not null.
effect fn reportTrapDescriptor(writer: &mut Writer, reasonText: u64, entry: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let report = match &writer.trap {
    Option<TrapReport>.Some {value} => TrapReport {observer: value.observer, cause: value.cause,
      label: run Bytes.copy(Bytes.asSlice(&value.label)), bits: value.bits, entry: value.entry}
    Option<TrapReport>.None => { return () }
  }
  let mut labelText = run staticString(&mut writer.*, Bytes.asSlice(&report.label), report.bits)
  if entry != Bitcode.none() {
    let entered = run loadPointer(&mut writer.*, entry, usize.ZERO)
    let null = run nullOf(&mut writer.*)
    let absent = run compareOf(&mut writer.*, Bitcode.intEq(), entered, null)
    labelText = run selectOf(&mut writer.*, absent, labelText, entered)
  }
  let observer = run loadPointer(&mut writer.*, report.observer, usize.ZERO)
  let cause = run loadPointer(&mut writer.*, report.cause, usize.ZERO)
  let void = run voidType(&mut writer.*)
  let pointer = run pointerType(&mut writer.*)
  let parameters = [pointer, pointer, pointer, pointer]
  let arguments = [observer, cause, reasonText, labelText]
  let none = run callNamed(&mut writer.*, b"silk.diagnostic.fatal", void, &parameters, &arguments)
  return ()
}

effect fn checkedBinary(writer: &mut Writer, operation: &[u8], lhs: &Value, rhs: &Value) -> Value
! OutOfMemoryError ? &mut Allocator {
  let pair = run overflowPair(&mut writer.*, operation, lhs.scalar, lhs.value, rhs.value)
  let result = run pairField(&mut writer.*, pair, usize.ZERO)
  let overflow = run pairField(&mut writer.*, pair, usize.ONE)
  let any = run anyLane(&mut writer.*, overflow, lhs.scalar)
  run trapWhen(&mut writer.*, any, b"arithmetic overflow")
  return Value {scalar: lhs.scalar, value: result}
}

// The `i1` flag of a scalar, or the `<N x i1>` flags of a vector's lanes.
fn flags(kind: Representation) -> Representation {
  return Representation {aggregate: false, size: usize.ZERO, bits: usize.ONE, signed: false, unit: false, pointer: false,
    floating: false, lanes: kind.lanes, unionAlignment: usize.ZERO}
}

// Whether any lane of `flag` (the flags of a `kind` operation) is set; a scalar flag is itself.
effect fn anyLane(writer: &mut Writer, flag: u64, kind: Representation) -> u64 ! OutOfMemoryError ? &mut Allocator {
  if kind.lanes == usize.ZERO { return flag }
  return run reduceFlags(&mut writer.*, b"llvm.vector.reduce.or.", flag, kind)
}

// The one `bool` of a comparison whose lane flags are `flag`: `==` holds when every lane is equal
// and `!=` when any lane differs (SIMD-002). A scalar comparison's flag is itself.
effect fn wholeVector(writer: &mut Writer, flag: u64, kind: Representation, operation: InfixOperator) -> u64
! OutOfMemoryError ? &mut Allocator {
  if kind.lanes == usize.ZERO { return flag }
  if operation != InfixOperator.Equals { return run anyLane(&mut writer.*, flag, kind) }
  return run reduceFlags(&mut writer.*, b"llvm.vector.reduce.and.", flag, kind)
}

effect fn reduceFlags(writer: &mut Writer, stem: &[u8], flag: u64, kind: Representation) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let mut name = run Bytes.copy(stem)
  run appendMangled(&mut name, flags(kind))
  let boolean = run integerType(&mut writer.*, usize.ONE)
  let vector = run typeOf(&mut writer.*, flags(kind))
  let parameters = [vector]
  let arguments = [flag]
  return run callNamed(&mut writer.*, Bytes.asSlice(&name), boolean, &parameters, &arguments)
}

// The bits of the smallest value of a signed integer of `bits`, or zero for a width without one.
fn signedMinimum(bits: usize) -> u64 {
  if bits == 8 || bits == 16 || bits == 32 || bits == 64 { return u64.shiftLeft(u64.MAX, usize.toU64(bits - usize.ONE)) }
  return 0
}

effect fn guardedDivision(
  writer: &mut Writer,
  function: &MirFunction,
  lhs: &Value,
  rhs: &Value,
  remainder: bool,
  span: Location,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  let minimum = signedMinimum(lhs.scalar.bits)
  if lhs.scalar.signed && minimum == 0 {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.relative(GapCode.ArithmeticTrap, &owner, span)
  }
  let zeroValue = run intOf(&mut writer.*, rhs.scalar, 0)
  let zero = run compareOf(&mut writer.*, Bitcode.intEq(), rhs.value, zeroValue)
  let anyZero = run anyLane(&mut writer.*, zero, rhs.scalar)
  run trapWhen(&mut writer.*, anyZero, b"division by zero")
  if lhs.scalar.signed {
    let minimumValue = run intOf(&mut writer.*, lhs.scalar, minimum)
    let min = run compareOf(&mut writer.*, Bitcode.intEq(), lhs.value, minimumValue)
    let negativeOneValue = run intOf(&mut writer.*, rhs.scalar, u64.MAX)
    let negativeOne = run compareOf(&mut writer.*, Bitcode.intEq(), rhs.value, negativeOneValue)
    let overflow = run binaryOf(&mut writer.*, Bitcode.opAnd(), min, negativeOne)
    let anyOverflow = run anyLane(&mut writer.*, overflow, lhs.scalar)
    run trapWhen(&mut writer.*, anyOverflow, b"arithmetic overflow")
  }
  let mut op = Bitcode.opUDiv()
  if lhs.scalar.signed && remainder { op = Bitcode.opSRem() }
  else if lhs.scalar.signed { op = Bitcode.opSDiv() }
  else if remainder { op = Bitcode.opURem() }
  return Value {scalar: lhs.scalar, value: run binaryOf(&mut writer.*, op, lhs.value, rhs.value)}
}


struct Address {
  ty: Shared<Type>,
  value: u64,
  alignment: usize,
  representation: Representation,
}

struct Pointee {
  ty: Shared<Type>,
  alignment: Option<u64>,
}

effect fn layoutOf(layouts: &TypeLayouts, ty: &Shared<Type>, function: &MirFunction, span: Location) -> Metrics
! Gap | OutOfMemoryError
? &mut Allocator | &mut Types {
  let at = run TypeLayouts.firstMatching(layouts, ty)
  if at != usize.MAX {
    let listed = TypeLayouts.list(layouts)
    return Shared<Layout>.with<Metrics>(&listed[at].layout, Layout.metrics)
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.relative(GapCode.ScalarLayout, &owner, span)
}

// Whether a vector or mask crosses a Silk function boundary through memory: a vector wider than
// 128 bits or a mask of more than 16 lanes. LLVM passes those in different registers with and
// without AVX or AVX-512, and a function written with `features` calls and is called by functions
// compiled without them, so their address is passed instead (SIMD-009).
fn passedIndirectly(kind: Representation) -> bool {
  return kind.lanes != usize.ZERO && (kind.lanes > 16 || kind.bits * kind.lanes > 128)
}

// The parameter index whose caller-provided storage `local` uses as its own slot, so the value is
// not copied on entry: a parameter of an ordinary Silk definition passed by address. The callee
// owns that storage for the call (`exclusiveParameter`), so it may also write and drop it there.
fn ownedParameter(function: &MirFunction, local: &Local, facts: Metrics, kind: Representation) -> Option<usize> {
  if cExport(function) || !exclusiveParameter(facts, kind) { return Option<usize>.none() }
  return match &local.kind {
    LocalKind.Parameter {index} => Option<usize>.some(index)
    _ => Option<usize>.none()
  }
}

// Whether the result local's slot is the caller's `%out`, so `emitReturn` copies nothing: an
// ordinary definition (not a C export) whose result travels by address. The caller passes a
// fresh temporary as the destination, so `%out` aliases nothing the body reads, and a failed
// call's success slot is never read, so a fallible definition writes there too.
fn resultInOut(function: &MirFunction, kind: Representation) -> bool {
  return !cExport(function) && (kind.aggregate || passedIndirectly(kind))
}

// Whether a Silk definition marks a parameter's address `noalias`. A parameter passed by address
// names storage the caller gives the call: MIR passes a fresh temporary snapshot of the argument,
// or a place the call moves out of, and never reads it afterwards, so nothing else reads or writes
// it until the callee returns. Without the mark LLVM must assume a store through another pointer, such as a
// field written into the callee's destination, can change the argument, and keeps an extra copy.
fn exclusiveParameter(facts: Metrics, lane: Representation) -> bool {
  return facts.abi == Abi.Indirect || passedIndirectly(lane)
}

// The scalar a by-address record parameter travels as instead (#2469): a record whose only
// field is a pointer, integer or float of the record's whole size, or such a record, passes as
// that field. The callee stores it into a slot of its own on entry. A C export's own parameters
// follow the C ABI instead, so its definition never asks.
effect fn unwrappedParameter(layouts: &TypeLayouts, ty: &Shared<Type>, facts: Metrics,
  function: &MirFunction, span: Location) -> Option<Shared<Type>> ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  if facts.abi != Abi.Indirect || facts.tagged { return Option<Shared<Type>>.none() }
  let mut current = Shared<Type>.clone(ty)
  let mut depth = usize.ZERO
  while depth < 8 {
    let at = run TypeLayouts.firstMatching(layouts, &current)
    if at == usize.MAX { return Option<Shared<Type>>.none() }
    let listed = TypeLayouts.list(layouts)
    if Shared<Layout>.with<usize>(&listed[at].layout, Layout.fieldCount) != usize.ONE { return Option<Shared<Type>>.none() }
    let selected = Shared<Layout>.with<Option<Field>>(&listed[at].layout,
      fn(layout: &Layout) -> Option<Field> { return Layout.fieldAt(layout, usize.ZERO) },
    )
    let field = match move selected {
      Option<Field>.Some {value} => move value
      Option<Field>.None => { return Option<Shared<Type>>.none() }
    }
    if field.offset != usize.ZERO { return Option<Shared<Type>>.none() }
    let inner = run layoutOf(layouts, &field.ty, function, span)
    if inner.size != facts.size || inner.tagged { return Option<Shared<Type>>.none() }
    if inner.abi == Abi.Pointer || inner.abi == Abi.Integer || inner.abi == Abi.Floating {
      return Option<Shared<Type>>.some(move field.ty)
    }
    if inner.abi != Abi.Indirect { return Option<Shared<Type>>.none() }
    current = move field.ty
    depth = depth + usize.ONE
  }
  return Option<Shared<Type>>.none()
}

// The lane an unwrapped parameter's field travels in.
effect fn unwrappedLane(layouts: &TypeLayouts, field: &Shared<Type>, target: &Target,
  function: &MirFunction, span: Location) -> Representation ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let facts = run layoutOf(layouts, field, function, span)
  return storageRepresentation(field, target, facts)
}

// Whether `function` is a C export shim, whose lanes follow the C ABI instead (SIMD-010).
fn cExport(function: &MirFunction) -> bool {
  return match &function.key { InstanceKey.Export {..} => true _ => false }
}

fn storageRepresentation(ty: &Shared<Type>, target: &Target, facts: Metrics) -> Representation {
  if facts.abi == Abi.Indirect {
    let mut unionAlignment = usize.ZERO
    if facts.tagged { unionAlignment = facts.alignment }
    return Representation {aggregate: true, size: facts.size, bits: usize.ZERO,
      signed: false, unit: false, pointer: false, floating: false, lanes: usize.ZERO,
      unionAlignment: unionAlignment}
  }
  let written = scalar(ty, target)
  // A nominal integer (a scalar enum) is spelled from its neutral layout, never its declaration.
  if facts.abi == Abi.Integer && written.bits == usize.ZERO {
    return Representation {aggregate: false, size: usize.ZERO, bits: facts.size * 8,
      signed: false, unit: false, pointer: false, floating: false, lanes: usize.ZERO, unionAlignment: usize.ZERO}
  }
  return written
}

effect fn fieldFact(layouts: &TypeLayouts, ty: &Shared<Type>, index: usize,
  function: &MirFunction, span: Location) -> Field ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let listed = TypeLayouts.list(layouts)
  let mut at = run TypeLayouts.firstMatching(layouts, ty)
  while at != usize.MAX {
    let selected = Shared<Layout>.with<Option<Field>>(&listed[at].layout,
      fn(layout: &Layout) -> Option<Field> { return Layout.fieldAt(layout, index) },
    )
    if let Option<Field>.Some {value} = move selected { return move value }
    at = run TypeLayouts.nextMatching(layouts, at, ty)
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.relative(GapCode.PlaceProjection, &owner, span)
}

effect fn sequenceFact(layouts: &TypeLayouts, ty: &Shared<Type>, function: &MirFunction,
  span: Location) -> Sequence ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let listed = TypeLayouts.list(layouts)
  let mut at = run TypeLayouts.firstMatching(layouts, ty)
  while at != usize.MAX {
    let selected = Shared<Layout>.with<Option<Sequence>>(&listed[at].layout,
      fn(layout: &Layout) -> Option<Sequence> { return Layout.sequenceFacts(layout) },
    )
    if let Option<Sequence>.Some {value} = move selected { return move value }
    at = run TypeLayouts.nextMatching(layouts, at, ty)
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.relative(GapCode.IndexProjection, &owner, span)
}

struct IndexFacts {
  element: Shared<Type>,
  stride: usize,
  borrowed: bool,
}

fn indexFacts(layout: &Layout) -> Option<IndexFacts> {
  if let Option<Sequence>.Some {value: array} = move Layout.sequenceFacts(layout) {
    return Option<IndexFacts>.some(IndexFacts {element: move array.element, stride: array.stride, borrowed: false})
  }
  if let Option<SliceFacts>.Some {value: slice} = move Layout.sliceFacts(layout) {
    return Option<IndexFacts>.some(IndexFacts {element: move slice.element, stride: slice.stride, borrowed: true})
  }
  return Option<IndexFacts>.none()
}

effect fn indexedFact(layouts: &TypeLayouts, ty: &Shared<Type>, function: &MirFunction,
  span: Location) -> IndexFacts ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let listed = TypeLayouts.list(layouts)
  let mut at = run TypeLayouts.firstMatching(layouts, ty)
  while at != usize.MAX {
    let selected = Shared<Layout>.with<Option<IndexFacts>>(&listed[at].layout, indexFacts)
    if let Option<IndexFacts>.Some {value} = move selected { return move value }
    at = run TypeLayouts.nextMatching(layouts, at, ty)
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.relative(GapCode.IndexProjection, &owner, span)
}

effect fn sliceFact(layouts: &TypeLayouts, ty: &Shared<Type>, function: &MirFunction,
  span: Location) -> SliceFacts ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let listed = TypeLayouts.list(layouts)
  let mut at = run TypeLayouts.firstMatching(layouts, ty)
  while at != usize.MAX {
    let selected = Shared<Layout>.with<Option<SliceFacts>>(&listed[at].layout, Layout.sliceFacts)
    if let Option<SliceFacts>.Some {value} = move selected { return move value }
    at = run TypeLayouts.nextMatching(layouts, at, ty)
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.relative(GapCode.SliceLayout, &owner, span)
}

effect fn taggedFact(layouts: &TypeLayouts, ty: &Shared<Type>, function: &MirFunction,
  span: Location) -> TaggedFacts ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let listed = TypeLayouts.list(layouts)
  let mut at = run TypeLayouts.firstMatching(layouts, ty)
  while at != usize.MAX {
    let selected = Shared<Layout>.with<Option<TaggedFacts>>(&listed[at].layout, Layout.taggedFacts)
    if let Option<TaggedFacts>.Some {value} = move selected { return move value }
    at = run TypeLayouts.nextMatching(layouts, at, ty)
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.relative(GapCode.UnionForm, &owner, span)
}

effect fn variantFieldFact(layouts: &TypeLayouts, ty: &Shared<Type>, variant: usize, field: usize,
  function: &MirFunction, span: Location) -> Field ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let listed = TypeLayouts.list(layouts)
  let mut at = run TypeLayouts.firstMatching(layouts, ty)
  while at != usize.MAX {
    let selected = Shared<Layout>.with<Option<Field>>(&listed[at].layout, fn(layout: &Layout) -> Option<Field> {
      return Layout.variantField(layout, variant, field)
    })
    if let Option<Field>.Some {value} = move selected { return move value }
    at = run TypeLayouts.nextMatching(layouts, at, ty)
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.relative(GapCode.UnionForm, &owner, span)
}

fn tagRepresentation(facts: TaggedFacts) -> Representation {
  return Representation {aggregate: false, size: usize.ZERO, bits: facts.tagSize * 8,
    signed: false, unit: false, pointer: false, floating: false, lanes: usize.ZERO, unionAlignment: usize.ZERO}
}

// Layout alignments are powers of two. Offsets reduce the base guarantee without inventing one.
fn offsetAlignment(alignment: usize, offset: usize) -> usize {
  let mut guarantee = alignment
  while guarantee > usize.ONE && usize.remainder(offset, guarantee) != usize.ZERO {
    guarantee = guarantee / 2
  }
  return guarantee
}

effect fn projectField(writer: &mut Writer, function: &MirFunction, target: &Target,
  layouts: &TypeLayouts, base: &Address, index: usize, span: Location) -> Address
! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let field = run fieldFact(layouts, &base.ty, index, function, span)
  let projected = run wordOffset(&mut writer.*, base.value, field.offset)
  let metrics = run layoutOf(layouts, &field.ty, function, span)
  let represented = storageRepresentation(&field.ty, target, metrics)
  return Address {ty: move field.ty, value: projected,
    alignment: offsetAlignment(base.alignment, field.offset), representation: represented}
}

fn copiedAlignment(written: &Option<u64>) -> Option<u64> {
  return match & written.* {
    Option<u64>.Some {value: declaredAlignment} => Option<u64>.some(declaredAlignment)
    Option<u64>.None => Option<u64>.none()
  }
}

// Returns what a reference or pointer type points at, absent for any other type.
fn pointeeOf(ty: &Shared<Type>) -> Option<Pointee> {
  return Shared<Type>.with<Option<Pointee>>(
    ty,
    fn(value: &Type) -> Option<Pointee> {
      return match & value.* {
        Type.Reference {referent, ..} => Option<Pointee>.some(
          Pointee {ty: Shared<Type>.clone(&referent), alignment: Option<u64>.none()},
        )
        Type.Pointer {pointee, alignment: written, ..} => Option<Pointee>.some(
          Pointee {ty: Shared<Type>.clone(&pointee), alignment: copiedAlignment(&written)},
        )
        _ => Option<Pointee>.none()
      }
    },
  )
}

// Returns what a dereferenced place points at, or rejects a place that is not a reference or pointer.
effect fn pointeeOrGap(function: &MirFunction, ty: &Shared<Type>, span: Location) -> Pointee
! Gap | OutOfMemoryError
? &mut Allocator {
  let pointee = pointeeOf(ty)
  let selected = match move pointee {
    Option<Pointee>.Some {value} => move value
    Option<Pointee>.None => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.PlaceProjection, &owner, span)
    }
  }
  return move selected
}

// `index * stride` bytes past `address`, the index keeping its own width.
effect fn stridedOffset(writer: &mut Writer, address: u64, index: &Value, stride: usize) -> u64
! OutOfMemoryError ? &mut Allocator {
  let strideValue = run intOf(&mut writer.*, index.scalar, usize.toU64(stride))
  let offset = run binaryOf(&mut writer.*, Bitcode.opMul(), index.value, strideValue)
  return run indexedOffset(&mut writer.*, address, offset)
}

effect fn emitPlace(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  place: &Place,
) -> Address ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let locals = List<Local>.asSlice(&function.locals)
  let owner = InstanceKey.identity(&function.key)
  let span = locals[place.local].origin.location
  let mut ty = Shared<Type>.clone(&locals[place.local].ty)
  let rootLayout = run layoutOf(layouts, &ty, function, span)
  let mut alignment = rootLayout.alignment
  let mut address = slotOf(&writer.*, place.local)
  let projections = List<Projection>.asSlice(&place.projections)
  let mut at = usize.ZERO
  while at < projections.length {
    match & projections[at] {
      Projection.Deref => {
        let selected = run pointeeOrGap(function, &ty, span)
        address = run loadPointer(&mut writer.*, address, alignment)
        ty = move selected.ty
        let referentLayout = run layoutOf(layouts, &ty, function, span)
        alignment = match move selected.alignment {
          Option<u64>.Some {value} => u64.toUsize(value)
          Option<u64>.None => referentLayout.alignment
        }
      }
      Projection.Field {index} => {
        let facts = run layoutOf(layouts, &ty, function, span)
        let represented = storageRepresentation(&ty, target, facts)
        let base = Address {ty: Shared<Type>.clone(&ty), value: address, alignment: alignment, representation: represented}
        let field = run projectField(&mut writer.*, function, target, layouts, &base, index, span)
        ty = move field.ty
        address = field.value
        alignment = field.alignment
      }
      Projection.Index {local} => {
        let sequence = run indexedFact(layouts, &ty, function, span)
        if sequence.borrowed {
          address = run loadPointer(&mut writer.*, address, alignment)
          let elementLayout = run layoutOf(layouts, &sequence.element, function, span)
          alignment = elementLayout.alignment
        }
        let indexPlace = Place {local: local, projections: List<Projection>.make()}
        let selectedIndex = run loadPlace(&mut writer.*, function, target, layouts, &indexPlace)
        address = run stridedOffset(&mut writer.*, address, &selectedIndex, sequence.stride)
        alignment = offsetAlignment(alignment, sequence.stride)
        ty = move sequence.element
      }
      Projection.VariantField {variant, field} => {
        let selected = run variantFieldFact(layouts, &ty, variant, field, function, span)
        address = run byteOffset(&mut writer.*, address, selected.offset)
        alignment = offsetAlignment(alignment, selected.offset)
        ty = move selected.ty
      }
      Projection.Payload {ty: member, ..} => {
        let facts = run taggedFact(layouts, &ty, function, span)
        address = run byteOffset(&mut writer.*, address, facts.payloadOffset)
        alignment = offsetAlignment(alignment, facts.payloadOffset)
        ty = Shared<Type>.clone(&member)
      }
      Projection.ConstIndex {index} => {
        let sequence = run sequenceFact(layouts, &ty, function, span)
        if index >= sequence.count { fail Gap.relative(GapCode.IndexProjection, &owner, span) }
        let facts = run layoutOf(layouts, &ty, function, span)
        let represented = storageRepresentation(&ty, target, facts)
        let base = Address {ty: Shared<Type>.clone(&ty), value: address, alignment: alignment, representation: represented}
        let element = run projectField(&mut writer.*, function, target, layouts, &base, index, span)
        ty = move element.ty
        address = element.value
        alignment = element.alignment
      }
    }
    at = at + usize.ONE
  }
  let finalLayout = run layoutOf(layouts, &ty, function, span)
  let kind = storageRepresentation(&ty, target, finalLayout)
  if !kind.unit && !kind.aggregate && kind.bits == usize.ZERO {
    fail Gap.relative(GapCode.ScalarLayout, &owner, span)
  }
  return Address {ty: move ty, value: address, alignment: alignment, representation: kind}
}

effect fn loadPlace(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  place: &Place,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let address = run emitPlace(&mut writer.*, function, target, layouts, place)
  return run loadAddress(&mut writer.*, &address)
}

// Reuse the resolved address when an operation must validate its exact source type before loading.
effect fn loadAddress(writer: &mut Writer, address: &Address) -> Value
! OutOfMemoryError ? &mut Allocator {
  let kind = address.representation
  if kind.unit {
    return Value {scalar: kind, value: Bitcode.none()}
  }
  // The consuming store copies the bytes; nothing writes memory between this read and that store.
  if kind.aggregate {
    return Value {scalar: kind, value: address.value}
  }
  return Value {scalar: kind, value: run loadOf(&mut writer.*, kind, address.value, address.alignment)}
}

effect fn emitOperand(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  operand: &Operand,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  return match & operand.* {
    Operand.Copy {place} => run loadPlace(&mut writer.*, function, target, layouts, &place)
    Operand.Move {place} => run loadPlace(&mut writer.*, function, target, layouts, &place)
    Operand.Integer {decimal: digits, negative, ty} => {
      let mut kind = scalar(&ty, target)
      if kind.bits == usize.ZERO && !kind.unit {
        let facts = run layoutOf(layouts, &ty, function, Location.make(usize.ZERO, usize.ZERO))
        kind = storageRepresentation(&ty, target, facts)
      }
      return Value {scalar: kind, value: run intOf(&mut writer.*, kind, decimalBits(Bytes.asSlice(&digits), negative))}
    }
    Operand.Float {bits, ty} => {
      let kind = scalar(&ty, target)
      return Value {scalar: kind, value: run floatOf(&mut writer.*, kind, bits)}
    }
    Operand.Boolean {value} => Value {scalar: booleanRepresentation(), value: run boolOf(&mut writer.*, value)}
    Operand.Unit => Value {
      scalar: Representation {aggregate: false, size: usize.ZERO, bits: usize.ZERO, signed: false, unit: true, pointer: false, floating: false, lanes: usize.ZERO, unionAlignment: usize.ZERO},
      value: Bitcode.none(),
    }
    Operand.Null {..} => Value {scalar: pointerRepresentation(target), value: run nullOf(&mut writer.*)}
    Operand.StaticText {bytes} => Value {scalar: pointerRepresentation(target),
      value: run staticString(&mut writer.*, Bytes.asSlice(&bytes), u32.toUsize(Target.pointerBits(target)))}
    Operand.StaticBytes {bytes} => Value {scalar: pointerRepresentation(target),
      value: run staticBytes(&mut writer.*, Bytes.asSlice(&bytes))}
    Operand.StaticValue {value, ty} => Value {scalar: pointerRepresentation(target),
      value: run staticValue(&mut writer.*, function, target, layouts, &value, &ty)}
  }
}

effect fn emitArgument(writer: &mut Writer, function: &MirFunction, target: &Target,
  layouts: &TypeLayouts, operand: &Operand, foreign: bool) -> Value ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut place = Option<Address>.none()
  if let Operand.Copy {place: source} = &operand.* {
    place = Option<Address>.some(run emitPlace(&mut writer.*, function, target, layouts, &source))
  }
  if let Operand.Move {place: source} = &operand.* {
    place = Option<Address>.some(run emitPlace(&mut writer.*, function, target, layouts, &source))
  }
  if let Option<Address>.Some {value: address} = move place {
    if address.representation.aggregate && !foreign {
      let facts = run layoutOf(layouts, &address.ty, function, Location.generated())
      if let Option<Shared<Type>>.Some {value: field} = run unwrappedParameter(layouts, &address.ty, facts, function, Location.generated()) {
        let lane = run unwrappedLane(layouts, &field, target, function, Location.generated())
        return Value {scalar: lane, value: run loadOf(&mut writer.*, lane, address.value, address.alignment)}
      }
    }
    if address.representation.aggregate || (!foreign && passedIndirectly(address.representation)) {
      return Value {scalar: pointerRepresentation(target), value: address.value}
    }
  }
  let value = run emitOperand(&mut writer.*, function, target, layouts, operand)
  // A wide vector argument is always a place, whose address a Silk callee reads; a C callee
  // takes the vector itself.
  if !foreign && passedIndirectly(value.scalar) {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.relative(GapCode.TypedForm, &owner, Location.generated())
  }
  return value
}

fn lengthRepresentation(target: &Target) -> Representation {
  return Representation {aggregate: false, size: usize.ZERO, bits: u32.toUsize(Target.pointerBits(target)),
    signed: false, unit: false, pointer: false, floating: false, lanes: usize.ZERO, unionAlignment: usize.ZERO}
}

// Selects the floating compare predicate for an operation, `u64.MAX` when it has none.
fn floatPredicate(operation: InfixOperator) -> u64 {
  return match operation {
    InfixOperator.Equals => Bitcode.floatOeq()
    InfixOperator.NotEquals => Bitcode.floatUne()
    InfixOperator.LessThan => Bitcode.floatOlt()
    InfixOperator.LessOrEqual => Bitcode.floatOle()
    InfixOperator.GreaterThan => Bitcode.floatOgt()
    InfixOperator.GreaterOrEqual => Bitcode.floatOge()
    _ => u64.MAX
  }
}

// Selects the IEEE 754 arithmetic opcode for an operation, `u64.MAX` when it has none: LLVM spells
// `fdiv` and `frem` with the signed division codes.
fn floatOpcode(operation: InfixOperator) -> u64 {
  return match operation {
    InfixOperator.Add => Bitcode.opAdd()
    InfixOperator.Subtract => Bitcode.opSub()
    InfixOperator.Multiply => Bitcode.opMul()
    InfixOperator.Divide => Bitcode.opSDiv()
    InfixOperator.Remainder => Bitcode.opSRem()
    _ => u64.MAX
  }
}

// Selects the integer compare predicate for an operation, `u64.MAX` when it has none.
fn integerPredicate(operation: InfixOperator, signed: bool) -> u64 {
  return match operation {
    InfixOperator.Equals => Bitcode.intEq()
    InfixOperator.NotEquals => Bitcode.intNe()
    InfixOperator.LessThan => { if signed { return Bitcode.intSlt() } return Bitcode.intUlt() }
    InfixOperator.LessOrEqual => { if signed { return Bitcode.intSle() } return Bitcode.intUle() }
    InfixOperator.GreaterThan => { if signed { return Bitcode.intSgt() } return Bitcode.intUgt() }
    InfixOperator.GreaterOrEqual => { if signed { return Bitcode.intSge() } return Bitcode.intUge() }
    _ => u64.MAX
  }
}

// Selects the bitwise opcode for an operation, `u64.MAX` when it has none.
fn bitwiseOpcode(operation: InfixOperator) -> u64 {
  return match operation {
    InfixOperator.BitAnd => Bitcode.opAnd()
    InfixOperator.And => Bitcode.opAnd()
    InfixOperator.BitOr => Bitcode.opOr()
    InfixOperator.Or => Bitcode.opOr()
    InfixOperator.BitXor => Bitcode.opXor()
    _ => u64.MAX
  }
}

fn pointerRepresentation(target: &Target) -> Representation {
  return Representation {aggregate: false, size: usize.ZERO, bits: u32.toUsize(Target.pointerBits(target)),
    signed: false, unit: false, pointer: true, floating: false, lanes: usize.ZERO, unionAlignment: usize.ZERO}
}

// Whether a semantic type is a numeric scalar or a vector of numeric lanes, whose scalar
// operations apply lane by lane.
fn numericValue(ty: &Shared<Type>) -> bool {
  if let Option<ArrayShape>.Some {value: shape} = move Type.vectorShape(ty) { return numericPrimitive(&shape.element) }
  return numericPrimitive(ty)
}

// Whether a semantic type is a numeric scalar: an integer, a floating type or a character. A
// scalar enum shares an integer's storage but is not numeric.
fn numericPrimitive(ty: &Shared<Type>) -> bool {
  return Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
    if let Type.Primitive {name} = &value.* {
      let word = Bytes.asSlice(&name)
      return same(word, b"u8") || same(word, b"u16") || same(word, b"u32") || same(word, b"u64") || same(word, b"usize")
        || same(word, b"i8") || same(word, b"i16") || same(word, b"i32") || same(word, b"i64") || same(word, b"isize")
        || same(word, b"f32") || same(word, b"f64") || same(word, b"char")
    }
    return false
  })
}

// Scalar intrinsic operations admit actual numeric primitives, not an enum's scalar storage.
effect fn emitNumeric(
  writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts, operand: &Operand, span: Location,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  match &operand.* {
    Operand.Copy {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      if numericValue(&address.ty) { return run loadAddress(&mut writer.*, &address) }
    }
    Operand.Move {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      if numericValue(&address.ty) { return run loadAddress(&mut writer.*, &address) }
    }
    Operand.Integer {ty, ..} => {
      if numericValue(&ty) { return run emitOperand(&mut writer.*, function, target, layouts, operand) }
    }
    Operand.Float {ty, ..} => {
      if numericValue(&ty) { return run emitOperand(&mut writer.*, function, target, layouts, operand) }
    }
    _ => ()
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.relative(GapCode.TypedForm, &owner, span)
}

effect fn typedFormGap(function: &MirFunction, span: Location) -> never ! Gap | OutOfMemoryError ? &mut Allocator {
  let owner = InstanceKey.identity(&function.key)
  fail Gap.relative(GapCode.TypedForm, &owner, span)
}

// 2^power for power <= 63.
fn powerOfTwo(power: usize) -> u64 {
  return u64.shiftLeft(1, usize.toU64(power))
}

// 2^bits - 1 for bits <= 64.
fn allOnes(bits: usize) -> u64 {
  if bits == 64 { return u64.MAX }
  return powerOfTwo(bits) - 1
}

// The number of magnitude bits: one fewer than the width for a signed integer.
fn magnitudeBits(kind: Representation) -> usize {
  if kind.signed { return kind.bits - usize.ONE }
  return kind.bits
}

// The bits of the largest value of an integer representation.
fn maximumBits(kind: Representation) -> u64 {
  return allOnes(magnitudeBits(kind))
}

// The bits of the smallest value of an integer representation.
fn minimumBits(kind: Representation) -> u64 {
  if !kind.signed { return 0 }
  return u64.wrappingSubtract(0, powerOfTwo(kind.bits - usize.ONE))
}

// The binary64 bits of the exact integer `±(2^power)` or `±(2^power + 1)`, for power <= 52 when
// `plusOne`. Both are exactly representable, in binary32 too while power stays below 24.
fn exactDouble(negative: bool, power: usize, plusOne: bool) -> u64 {
  let mut bits = u64.shiftLeft(usize.toU64(1023 + power), 52)
  if plusOne { bits = u64.bitOr(bits, powerOfTwo(52 - power)) }
  if negative { bits = u64.bitOr(bits, powerOfTwo(63)) }
  return bits
}

fn booleanRepresentation() -> Representation {
  return Representation {aggregate: false, size: usize.ZERO, bits: usize.ONE, signed: false, unit: false, pointer: false, floating: false, lanes: usize.ZERO, unionAlignment: usize.ZERO}
}

fn integerRepresentation(bits: usize, signed: bool) -> Representation {
  return Representation {aggregate: false, size: usize.ZERO, bits: bits, signed: signed, unit: false, pointer: false, floating: false, lanes: usize.ZERO, unionAlignment: usize.ZERO}
}

fn isIntegral(kind: Representation) -> bool {
  return !kind.aggregate && !kind.pointer && !kind.unit && !kind.floating && kind.bits >= 8
}

fn isFloating(kind: Representation) -> bool {
  return !kind.aggregate && !kind.pointer && !kind.unit && kind.floating
}

// Compares `value` of `kind` with the constant `bits` under `predicate`.
effect fn compareWith(writer: &mut Writer, predicate: u64, kind: Representation, value: u64, bits: u64) -> u64
! OutOfMemoryError ? &mut Allocator {
  let constant = run intOf(&mut writer.*, kind, bits)
  return run compareOf(&mut writer.*, predicate, value, constant)
}

// Compares `value` of floating `kind` with the binary64 constant `bits` under `predicate`.
effect fn compareWithFloat(writer: &mut Writer, predicate: u64, kind: Representation, value: u64, bits: u64) -> u64
! OutOfMemoryError ? &mut Allocator {
  let constant = run floatOf(&mut writer.*, kind, bits)
  return run compareOf(&mut writer.*, predicate, value, constant)
}

// Traps when an integer value lies outside the destination integer range (CONV-002).
effect fn integerRangeGuard(writer: &mut Writer, input: &Value, output: Representation) -> ()
! OutOfMemoryError ? &mut Allocator {
  let violation = run integerRangeViolation(&mut writer.*, input, output)
  if violation != Bitcode.none() {
    let any = run anyLane(&mut writer.*, violation, input.scalar)
    run trapWhen(&mut writer.*, any, b"arithmetic overflow")
  }
  return ()
}

// The condition that an integer value lies outside the destination integer range, or `none()`
// when every source value fits.
effect fn integerRangeViolation(writer: &mut Writer, input: &Value, output: Representation) -> u64
! OutOfMemoryError ? &mut Allocator {
  let source = input.scalar
  let mut below = Bitcode.none()
  if source.signed && (!output.signed || output.bits < source.bits) {
    below = run compareWith(&mut writer.*, Bitcode.intSlt(), source, input.value, minimumBits(output))
  }
  let mut above = Bitcode.none()
  if magnitudeBits(output) < magnitudeBits(source) {
    let mut predicate = Bitcode.intUgt()
    if source.signed { predicate = Bitcode.intSgt() }
    above = run compareWith(&mut writer.*, predicate, source, input.value, maximumBits(output))
  }
  if below == Bitcode.none() { return above }
  if above == Bitcode.none() { return below }
  return run binaryOf(&mut writer.*, Bitcode.opOr(), below, above)
}

fn characterType(ty: &Shared<Type>) -> bool {
  return Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
    return match &value.* {
      Type.Primitive {name} => same(Bytes.asSlice(&name), b"char")
      _ => false
    }
  })
}

// Whether an integer is exactly representable in an integer type, or is a Unicode scalar value:
// at most 0x10FFFF and outside the surrogates 0xD800 to 0xDFFF.
effect fn emitFits(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  operand: &Operand, ty: &Shared<Type>, span: Location) -> Value ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let input = run emitNumeric(&mut writer.*, function, target, layouts, operand, span)
  if !isIntegral(input.scalar) || !numericPrimitive(ty) { return run typedFormGap(function, span) }
  let boolean = booleanRepresentation()
  if characterType(ty) {
    let above = run compareWith(&mut writer.*, Bitcode.intUgt(), input.scalar, input.value, 1114111)
    let low = run compareWith(&mut writer.*, Bitcode.intUge(), input.scalar, input.value, 55296)
    let high = run compareWith(&mut writer.*, Bitcode.intUle(), input.scalar, input.value, 57343)
    let surrogate = run binaryOf(&mut writer.*, Bitcode.opAnd(), low, high)
    let invalid = run binaryOf(&mut writer.*, Bitcode.opOr(), above, surrogate)
    return Value {scalar: boolean, value: run notOf(&mut writer.*, boolean, invalid)}
  }
  let output = scalar(ty, target)
  if !isIntegral(output) { return run typedFormGap(function, span) }
  let invalid = run integerRangeViolation(&mut writer.*, &input, output)
  if invalid == Bitcode.none() { return Value {scalar: boolean, value: run boolOf(&mut writer.*, true)} }
  return Value {scalar: boolean, value: run notOf(&mut writer.*, boolean, invalid)}
}

// Traps when a floating value is NaN or truncates outside the destination integer range. The
// high bound `maximum + 1` is a power of two; below the low bound the truncation falls under the
// minimum, tested inclusively against `minimum - 1` when that is exactly representable.
effect fn floatRangeGuard(writer: &mut Writer, input: &Value, output: Representation) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut precision: usize = 53
  if input.scalar.bits == 32 { precision = 24 }
  let exactLow = !output.signed || output.bits <= precision
  let mut low = exactDouble(true, usize.ZERO, false)
  if output.signed { low = exactDouble(true, output.bits - usize.ONE, exactLow) }
  let high = exactDouble(false, magnitudeBits(output), false)
  let mut predicate = Bitcode.floatUlt()
  if exactLow { predicate = Bitcode.floatUle() }
  let below = run compareWithFloat(&mut writer.*, predicate, input.scalar, input.value, low)
  let above = run compareWithFloat(&mut writer.*, Bitcode.floatUge(), input.scalar, input.value, high)
  let invalid = run binaryOf(&mut writer.*, Bitcode.opOr(), below, above)
  let any = run anyLane(&mut writer.*, invalid, input.scalar)
  return run trapWhen(&mut writer.*, any, b"arithmetic overflow")
}

effect fn emitConvert(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  operand: &Operand, ty: &Shared<Type>, span: Location) -> Value ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let input = run emitNumeric(&mut writer.*, function, target, layouts, operand, span)
  let output = scalar(ty, target)
  if !numericValue(ty) || input.scalar.lanes != output.lanes { return run typedFormGap(function, span) }
  if input.scalar.floating && output.floating {
    if input.scalar.bits == output.bits { return Value {scalar: output, value: input.value} }
    if input.scalar.bits > output.bits { return run castOf(&mut writer.*, Bitcode.castFPTrunc(), &input, output) }
    return run castOf(&mut writer.*, Bitcode.castFPExt(), &input, output)
  }
  if output.floating {
    if input.scalar.signed { return run castOf(&mut writer.*, Bitcode.castSIToFP(), &input, output) }
    return run castOf(&mut writer.*, Bitcode.castUIToFP(), &input, output)
  }
  if input.scalar.floating {
    run floatRangeGuard(&mut writer.*, &input, output)
    if output.signed { return run castOf(&mut writer.*, Bitcode.castFPToSI(), &input, output) }
    return run castOf(&mut writer.*, Bitcode.castFPToUI(), &input, output)
  }
  run integerRangeGuard(&mut writer.*, &input, output)
  return run resize(&mut writer.*, &input, output)
}

// Classifies a floating value from its IEEE 754 exponent and fraction fields, as the bootstrap
// does; the square root is LLVM's correctly rounded intrinsic.
effect fn emitScalarUnary(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  operation: ScalarUnary, operand: &Operand, span: Location) -> Value ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let input = run emitNumeric(&mut writer.*, function, target, layouts, operand, span)
  if !isFloating(input.scalar) { return run typedFormGap(function, span) }
  if operation == ScalarUnary.Sin || operation == ScalarUnary.Cos {
    return run emitTranscendental(&mut writer.*, &input, operation == ScalarUnary.Sin)
  }
  if operation == ScalarUnary.Sqrt {
    let operands = [input.value]
    return Value {scalar: input.scalar, value: run callIntrinsic(&mut writer.*, b"sqrt", input.scalar, &operands)}
  }
  let raw = run castOf(&mut writer.*, Bitcode.castBitcast(), &input, integerRepresentation(input.scalar.bits, false))
  let integer = raw.scalar
  let mut exponentMask: u64 = 9218868437227405312
  let mut fractionMask: u64 = 4503599627370495
  if input.scalar.bits == 32 {
    exponentMask = 2139095040
    fractionMask = 8388607
  }
  let bits = raw.value
  let boolean = booleanRepresentation()
  if operation == ScalarUnary.IsSignNegative {
    return Value {scalar: boolean, value: run compareWith(&mut writer.*, Bitcode.intSlt(), integer, bits, 0)}
  }
  let exponentMaskValue = run intOf(&mut writer.*, integer, exponentMask)
  let fractionMaskValue = run intOf(&mut writer.*, integer, fractionMask)
  let exponent = run binaryOf(&mut writer.*, Bitcode.opAnd(), bits, exponentMaskValue)
  let fraction = run binaryOf(&mut writer.*, Bitcode.opAnd(), bits, fractionMaskValue)
  let exponentZero = run compareWith(&mut writer.*, Bitcode.intEq(), integer, exponent, 0)
  let exponentAll = run compareOf(&mut writer.*, Bitcode.intEq(), exponent, exponentMaskValue)
  let fractionZero = run compareWith(&mut writer.*, Bitcode.intEq(), integer, fraction, 0)
  let exponentSome = run notOf(&mut writer.*, boolean, exponentZero)
  let exponentFinite = run notOf(&mut writer.*, boolean, exponentAll)
  let fractionSome = run notOf(&mut writer.*, boolean, fractionZero)
  let flag = match operation {
    ScalarUnary.IsNaN => run binaryOf(&mut writer.*, Bitcode.opAnd(), exponentAll, fractionSome)
    ScalarUnary.IsInfinite => run binaryOf(&mut writer.*, Bitcode.opAnd(), exponentAll, fractionZero)
    ScalarUnary.IsFinite => exponentFinite
    ScalarUnary.IsNormal => run binaryOf(&mut writer.*, Bitcode.opAnd(), exponentSome, exponentFinite)
    ScalarUnary.IsSubnormal => run binaryOf(&mut writer.*, Bitcode.opAnd(), exponentZero, fractionSome)
    _ => run typedFormGap(function, span)
  }
  return Value {scalar: boolean, value: flag}
}

// The bootstrap's fixed sine and cosine plan as binary64 bits. Binary32 constants are widened
// exactly.
fn halfPiParts(single: bool) -> [u64; 10] {
  if single {
    return [0x3FF9000000000000, 0x3F80000000000000, 0x3F3F000000000000, 0x3EE6000000000000, 0x3E95000000000000,
      0x3E11000000000000, 0x3D86000000000000, 0x3D31000000000000, 0x3CE0000000000000, 0x3C91000000000000]
  }
  return [0x3FF9200000000000, 0x3F3FB40000000000, 0x3E74440000000000, 0x3D868C0000000000, 0x3C91A60000000000,
    0x3BA3180000000000, 0x3AE8A20000000000, 0x3A1C060000000000, 0x394C1C0000000000, 0x387A240000000000]
}

fn sineCoefficients(single: bool) -> [u64; 6] {
  if single {
    return [0xBFC5555560000000, 0x3F81111120000000, 0xBF2A01A020000000, 0x3EC71DE360000000, 0xBE5AE5E680000000,
      0x3DE5D93A60000000]
  }
  return [0xBFC5555555555549, 0x3F8111111110F8A6, 0xBF2A01A019C161D5, 0x3EC71DE357B1FE7D, 0xBE5AE5E68A2B9CEB,
    0x3DE5D93A5ACFD57C]
}

fn cosineCoefficients(single: bool) -> [u64; 6] {
  if single {
    return [0x3FA5555560000000, 0xBF56C16C20000000, 0x3EFA01A020000000, 0xBE927E4F80000000, 0x3E21EE9EC0000000,
      0xBDA8FAE9C0000000]
  }
  return [0x3FA555555555554C, 0xBF56C16C16C15177, 0x3EFA01A019CB1590, 0xBE927E4F809C52AD, 0x3E21EE9EBDB4B1C4,
    0xBDA8FAE9BE8838D4]
}

// Horner evaluation in the plan's fixed order: `c[i] + squared * result` from the last coefficient.
effect fn polynomial(writer: &mut Writer, kind: Representation, coefficients: &[u64], squared: u64) -> u64
! OutOfMemoryError ? &mut Allocator {
  let mut at = coefficients.length - usize.ONE
  let mut result = run floatOf(&mut writer.*, kind, coefficients[at])
  while at > usize.ZERO {
    at = at - usize.ONE
    let product = run binaryOf(&mut writer.*, Bitcode.opMul(), squared, result)
    let coefficient = run floatOf(&mut writer.*, kind, coefficients[at])
    result = run binaryOf(&mut writer.*, Bitcode.opAdd(), coefficient, product)
  }
  return result
}

// Selects the result for quadrant 0 to 3: sine, cosine, -sine, -cosine for sine, and cosine,
// -sine, -cosine, sine for cosine.
effect fn quadrantResult(writer: &mut Writer, quadrant: u64, sine: bool, sineValue: u64,
  cosineValue: u64, negativeSine: u64, negativeCosine: u64) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let wide = integerRepresentation(64, true)
  let second = run compareWith(&mut writer.*, Bitcode.intEq(), wide, quadrant, 2)
  let first = run compareWith(&mut writer.*, Bitcode.intEq(), wide, quadrant, 1)
  let initial = run compareWith(&mut writer.*, Bitcode.intEq(), wide, quadrant, 0)
  if sine {
    let upper = run selectOf(&mut writer.*, second, negativeSine, negativeCosine)
    let lower = run selectOf(&mut writer.*, first, cosineValue, upper)
    return run selectOf(&mut writer.*, initial, sineValue, lower)
  }
  let upper = run selectOf(&mut writer.*, second, negativeCosine, sineValue)
  let lower = run selectOf(&mut writer.*, first, negativeSine, upper)
  return run selectOf(&mut writer.*, initial, cosineValue, lower)
}

// The bootstrap's deterministic sine or cosine: quadrant reduction by a ten-part pi/2, fixed
// polynomial kernels, signed zero kept by sine, and the canonical NaN for NaN and infinities.
effect fn emitTranscendental(writer: &mut Writer, input: &Value, sine: bool) -> Value ! OutOfMemoryError ? &mut Allocator {
  let kind = input.scalar
  let single = kind.bits == 32
  let x = input.value
  let zero = run floatOf(&mut writer.*, kind, 0)
  let one = run floatOf(&mut writer.*, kind, 0x3FF0000000000000)
  let half = run floatOf(&mut writer.*, kind, 0x3FE0000000000000)
  let negativeHalf = run floatOf(&mut writer.*, kind, 0xBFE0000000000000)
  let mut inverseBits: u64 = 0x3FE45F306DC9C883
  if single { inverseBits = 0x3FE45F3060000000 }
  let inverse = run floatOf(&mut writer.*, kind, inverseBits)
  let negative = run compareOf(&mut writer.*, Bitcode.floatOlt(), x, zero)
  let offset = run selectOf(&mut writer.*, negative, negativeHalf, half)
  let scaled = run binaryOf(&mut writer.*, Bitcode.opMul(), x, inverse)
  let shifted = run binaryOf(&mut writer.*, Bitcode.opAdd(), scaled, offset)
  let wide = integerRepresentation(64, true)
  let rounded = Value {scalar: kind, value: shifted}
  let quadrantInteger = run castOf(&mut writer.*, Bitcode.castFPToSI(), &rounded, wide)
  let quadrantFloat = run castOf(&mut writer.*, Bitcode.castSIToFP(), &quadrantInteger, kind)
  let partTable = halfPiParts(single)
  let parts: &[u64] = &partTable
  let mut residual = x
  let mut at = usize.ZERO
  while at < parts.length {
    let part = run floatOf(&mut writer.*, kind, parts[at])
    let product = run binaryOf(&mut writer.*, Bitcode.opMul(), quadrantFloat.value, part)
    residual = run binaryOf(&mut writer.*, Bitcode.opSub(), residual, product)
    at = at + usize.ONE
  }
  let squared = run binaryOf(&mut writer.*, Bitcode.opMul(), residual, residual)
  let sineTable = sineCoefficients(single)
  let sineTail = run polynomial(&mut writer.*, kind, &sineTable, squared)
  let cubed = run binaryOf(&mut writer.*, Bitcode.opMul(), residual, squared)
  let sineProduct = run binaryOf(&mut writer.*, Bitcode.opMul(), cubed, sineTail)
  let sineValue = run binaryOf(&mut writer.*, Bitcode.opAdd(), residual, sineProduct)
  let cosineTable = cosineCoefficients(single)
  let cosineTail = run polynomial(&mut writer.*, kind, &cosineTable, squared)
  let halfSquared = run binaryOf(&mut writer.*, Bitcode.opMul(), half, squared)
  let cosineBase = run binaryOf(&mut writer.*, Bitcode.opSub(), one, halfSquared)
  let fourth = run binaryOf(&mut writer.*, Bitcode.opMul(), squared, squared)
  let cosineProduct = run binaryOf(&mut writer.*, Bitcode.opMul(), fourth, cosineTail)
  let cosineValue = run binaryOf(&mut writer.*, Bitcode.opAdd(), cosineBase, cosineProduct)
  let three = run intOf(&mut writer.*, wide, 3)
  let quadrant = run binaryOf(&mut writer.*, Bitcode.opAnd(), quadrantInteger.value, three)
  let negativeSine = run Module.fneg(&mut writer.*.module, sineValue, 0)
  let negativeCosine = run Module.fneg(&mut writer.*.module, cosineValue, 0)
  let finite = run quadrantResult(&mut writer.*, quadrant, sine, sineValue, cosineValue, negativeSine, negativeCosine)
  let unordered = run compareOf(&mut writer.*, Bitcode.floatUno(), x, x)
  let above = run compareWithFloat(&mut writer.*, Bitcode.floatOeq(), kind, x, 0x7FF0000000000000)
  let below = run compareWithFloat(&mut writer.*, Bitcode.floatOeq(), kind, x, 0xFFF0000000000000)
  let infinite = run binaryOf(&mut writer.*, Bitcode.opOr(), above, below)
  let nonFinite = run binaryOf(&mut writer.*, Bitcode.opOr(), unordered, infinite)
  let isZero = run compareOf(&mut writer.*, Bitcode.floatOeq(), x, zero)
  let mut atZero = one
  if sine { atZero = x }
  let withZero = run selectOf(&mut writer.*, isZero, atZero, finite)
  let canonical = run floatOf(&mut writer.*, kind, 0x7FF8000000000000)
  return Value {scalar: kind, value: run selectOf(&mut writer.*, nonFinite, canonical, withZero)}
}

// The IEEE 754 totalOrder key: negative values reverse their magnitude order below positive ones.
effect fn totalOrderKey(writer: &mut Writer, bits: &Value) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let negative = run compareWith(&mut writer.*, Bitcode.intSlt(), bits.scalar, bits.value, 0)
  let ones = run intOf(&mut writer.*, bits.scalar, u64.MAX)
  let sign = run intOf(&mut writer.*, bits.scalar, minimumBits(integerRepresentation(bits.scalar.bits, true)))
  let mask = run selectOf(&mut writer.*, negative, ones, sign)
  return run binaryOf(&mut writer.*, Bitcode.opXor(), bits.value, mask)
}

effect fn emitScalarBinary(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  operation: ScalarBinary, left: &Operand, right: &Operand, span: Location) -> Value ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let lhs = run emitNumeric(&mut writer.*, function, target, layouts, left, span)
  let rhs = run emitNumeric(&mut writer.*, function, target, layouts, right, span)
  let kind = lhs.scalar
  if operation == ScalarBinary.TotalOrder {
    if !isFloating(kind) || !isFloating(rhs.scalar) || kind.bits != rhs.scalar.bits { return run typedFormGap(function, span) }
    let integer = integerRepresentation(kind.bits, true)
    let leftBits = run castOf(&mut writer.*, Bitcode.castBitcast(), &lhs, integer)
    let rightBits = run castOf(&mut writer.*, Bitcode.castBitcast(), &rhs, integer)
    let leftKey = run totalOrderKey(&mut writer.*, &leftBits)
    let rightKey = run totalOrderKey(&mut writer.*, &rightBits)
    return Value {scalar: booleanRepresentation(), value: run compareOf(&mut writer.*, Bitcode.intUle(), leftKey, rightKey)}
  }
  if !isIntegral(kind) || !isIntegral(rhs.scalar) || kind.bits != rhs.scalar.bits { return run typedFormGap(function, span) }
  let l = lhs.value
  let r = rhs.value
  if operation == ScalarBinary.ShiftLeft || operation == ScalarBinary.ShiftRight {
    let invalid = run compareWith(&mut writer.*, Bitcode.intUge(), kind, r, usize.toU64(kind.bits))
    let any = run anyLane(&mut writer.*, invalid, kind)
    run trapWhenEntered(&mut writer.*, any, b"invalid shift count")
    let mut opcode = Bitcode.opShl()
    if operation == ScalarBinary.ShiftRight {
      opcode = Bitcode.opLShr()
      if kind.signed { opcode = Bitcode.opAShr() }
    }
    return Value {scalar: kind, value: run binaryOf(&mut writer.*, opcode, l, r)}
  }
  let boolean = booleanRepresentation()
  if operation == ScalarBinary.AddOverflows || operation == ScalarBinary.SubtractOverflows || operation == ScalarBinary.MultiplyOverflows {
    let mut stem: &[u8] = b"add"
    if operation == ScalarBinary.SubtractOverflows { stem = b"sub" }
    if operation == ScalarBinary.MultiplyOverflows { stem = b"mul" }
    let pair = run overflowPair(&mut writer.*, stem, kind, l, r)
    return Value {scalar: boolean, value: run pairField(&mut writer.*, pair, usize.ONE)}
  }
  if operation == ScalarBinary.DivisionUndefined {
    let zero = run compareWith(&mut writer.*, Bitcode.intEq(), kind, r, 0)
    if !kind.signed { return Value {scalar: boolean, value: zero} }
    let lowest = run compareWith(&mut writer.*, Bitcode.intEq(), kind, l, minimumBits(kind))
    let negative = run compareWith(&mut writer.*, Bitcode.intEq(), kind, r, u64.MAX)
    let overflow = run binaryOf(&mut writer.*, Bitcode.opAnd(), lowest, negative)
    return Value {scalar: boolean, value: run binaryOf(&mut writer.*, Bitcode.opOr(), zero, overflow)}
  }
  if operation == ScalarBinary.WrappingAdd { return Value {scalar: kind, value: run binaryOf(&mut writer.*, Bitcode.opAdd(), l, r)} }
  if operation == ScalarBinary.WrappingSubtract { return Value {scalar: kind, value: run binaryOf(&mut writer.*, Bitcode.opSub(), l, r)} }
  if operation == ScalarBinary.WrappingMultiply { return Value {scalar: kind, value: run binaryOf(&mut writer.*, Bitcode.opMul(), l, r)} }
  if operation == ScalarBinary.MultiplyHigh {
    // The upper half of the product at twice the width, which LLVM selects as one widening
    // multiply, such as x86-64 `mul` or `imul`, or AArch64 `umulh` or `smulh`.
    let wide = integerRepresentation(kind.bits * 2, kind.signed)
    let mut extend = Bitcode.castZExt()
    if kind.signed { extend = Bitcode.castSExt() }
    let leftWide = run castOf(&mut writer.*, extend, &lhs, wide)
    let rightWide = run castOf(&mut writer.*, extend, &rhs, wide)
    let product = run binaryOf(&mut writer.*, Bitcode.opMul(), leftWide.value, rightWide.value)
    let width = run intOf(&mut writer.*, wide, usize.toU64(kind.bits))
    let high = Value {scalar: wide, value: run binaryOf(&mut writer.*, Bitcode.opLShr(), product, width)}
    return run castOf(&mut writer.*, Bitcode.castTrunc(), &high, kind)
  }
  if operation == ScalarBinary.RotateLeft || operation == ScalarBinary.RotateRight {
    let operands = [l, l, r]
    let mut funnel: &[u8] = b"fshl"
    if operation == ScalarBinary.RotateRight { funnel = b"fshr" }
    return Value {scalar: kind, value: run callIntrinsic(&mut writer.*, funnel, kind, &operands)}
  }
  let operands = [l, r]
  if operation == ScalarBinary.SaturatingAdd || operation == ScalarBinary.SaturatingSubtract {
    let mut name: &[u8] = b"uadd.sat"
    if kind.signed { name = b"sadd.sat" }
    if operation == ScalarBinary.SaturatingSubtract {
      name = b"usub.sat"
      if kind.signed { name = b"ssub.sat" }
    }
    return Value {scalar: kind, value: run callIntrinsic(&mut writer.*, name, kind, &operands)}
  }
  // A saturating product clamps an overflowing result toward the sign of the exact product.
  let pair = run overflowPair(&mut writer.*, b"mul", kind, l, r)
  let wrapped = run pairField(&mut writer.*, pair, usize.ZERO)
  let overflow = run pairField(&mut writer.*, pair, usize.ONE)
  let maximum = run intOf(&mut writer.*, kind, maximumBits(kind))
  let mut bound = maximum
  if kind.signed {
    let minimum = run intOf(&mut writer.*, kind, minimumBits(kind))
    let signs = run binaryOf(&mut writer.*, Bitcode.opXor(), l, r)
    let negative = run compareWith(&mut writer.*, Bitcode.intSlt(), kind, signs, 0)
    bound = run selectOf(&mut writer.*, negative, minimum, maximum)
  }
  return Value {scalar: kind, value: run selectOf(&mut writer.*, overflow, bound, wrapped)}
}

// Address transport admits the exact semantic word or data-pointer category, not a storage alias.
enum AddressLane { Unsupported, Pointer, Word }

fn addressLane(ty: &Shared<Type>) -> AddressLane {
  return Shared<Type>.with<AddressLane>(ty, fn(value: &Type) -> AddressLane {
    return match &value.* {
      Type.Pointer {..} => AddressLane.Pointer
      Type.ForeignFunction {..} => AddressLane.Pointer
      Type.Primitive {name} => {
        if same(Bytes.asSlice(&name), b"usize") { return AddressLane.Word }
        return AddressLane.Unsupported
      }
      _ => AddressLane.Unsupported
    }
  })
}

effect fn emitAddressOperand(
  writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  operand: &Operand, expected: AddressLane, span: Location,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  match &operand.* {
    Operand.Copy {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      if addressLane(&address.ty) == expected { return run loadAddress(&mut writer.*, &address) }
    }
    Operand.Move {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      if addressLane(&address.ty) == expected { return run loadAddress(&mut writer.*, &address) }
    }
    Operand.Integer {ty, negative, ..} => {
      if !negative && expected == AddressLane.Word && addressLane(&ty) == expected {
        return run emitOperand(&mut writer.*, function, target, layouts, operand)
      }
    }
    Operand.Null {ty} => {
      if expected == AddressLane.Pointer && addressLane(&ty) == expected {
        return run emitOperand(&mut writer.*, function, target, layouts, operand)
      }
    }
    _ => ()
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.relative(GapCode.TypedForm, &owner, span)
}

// The ordering code of one memory ordering; Relaxed is LLVM's `monotonic`.
fn atomicOrdering(order: MemoryOrder) -> u64 {
  return match order {
    MemoryOrder.Relaxed => Bitcode.orderMonotonic()
    MemoryOrder.Acquire => Bitcode.orderAcquire()
    MemoryOrder.Release => Bitcode.orderRelease()
    MemoryOrder.AcquireRelease => Bitcode.orderAcquireRelease()
    MemoryOrder.SequentiallyConsistent => Bitcode.orderSequential()
  }
}

// The `atomicrmw` operation of a swap or fetch primitive under the element's signedness.
fn atomicReadModifyWrite(primitive: IntrinsicPrimitive, signed: bool) -> u64 {
  return match primitive {
    IntrinsicPrimitive.AtomicFetchAdd => Bitcode.rmwAdd()
    IntrinsicPrimitive.AtomicFetchSubtract => Bitcode.rmwSub()
    IntrinsicPrimitive.AtomicFetchBitAnd => Bitcode.rmwAnd()
    IntrinsicPrimitive.AtomicFetchBitOr => Bitcode.rmwOr()
    IntrinsicPrimitive.AtomicFetchBitXor => Bitcode.rmwXor()
    IntrinsicPrimitive.AtomicFetchMinimum => {
      if signed { return Bitcode.rmwMin() }
      return Bitcode.rmwUMin()
    }
    IntrinsicPrimitive.AtomicFetchMaximum => {
      if signed { return Bitcode.rmwMax() }
      return Bitcode.rmwUMax()
    }
    _ => Bitcode.rmwXchg()
  }
}


// One SIMD vector operation (SIMD-003) whose result is `ty`. A lane index is already in range.
effect fn emitVector(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  primitive: IntrinsicPrimitive,
  operands: &List<Operand>,
  ty: &Shared<Type>,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let listed = List<Operand>.asSlice(operands)
  let mut values = List<Value>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    let lowered = run emitOperand(&mut writer.*, function, target, layouts, &listed[at])
    run List<Value>.append(&mut values, lowered)
    at = at + usize.ONE
  }
  let lowered = List<Value>.asSlice(&values)
  let kind = scalar(ty, target)
  // An architecture operation calls its catalog intrinsic on the operands as they are (SIMD-007).
  let arch = CheckedIntrinsic.archForResult(primitive, ty)
  if arch.arity != usize.ZERO {
    let mut parameters = List<u64>.make()
    let mut arguments = List<u64>.make()
    let mut operand = usize.ZERO
    while operand < lowered.length {
      run List<u64>.append(&mut parameters, run typeOf(&mut writer.*, lowered[operand].scalar))
      run List<u64>.append(&mut arguments, lowered[operand].value)
      operand = operand + usize.ONE
    }
    if arch.immediate != usize.MAX {
      run List<u64>.append(&mut parameters, run integerType(&mut writer.*, 8))
      run List<u64>.append(&mut arguments, run integerOf(&mut writer.*, 8, usize.toU64(arch.immediate)))
    }
    let result = run typeOf(&mut writer.*, kind)
    return Value {scalar: kind, value: run callNamed(&mut writer.*, arch.llvm, result, List<u64>.asSlice(&parameters),
      List<u64>.asSlice(&arguments))}
  }
  if primitive == IntrinsicPrimitive.SimdFromArray || primitive == IntrinsicPrimitive.SimdPointerLoad {
    return run arrayVector(&mut writer.*, lowered[usize.ZERO].value, kind)
  }
  if primitive == IntrinsicPrimitive.SimdShuffle {
    // `shufflevector` over the two operands, with one constant i32 lane index per result lane.
    let int32 = run integerType(&mut writer.*, 32)
    let mut lanes = List<u64>.make()
    let mut lane: usize = 2
    while lane < listed.length {
      let index = match &listed[lane] {
        Operand.Integer {decimal, negative, ..} => decimalBits(Bytes.asSlice(&decimal), negative)
        _ => { return run typedFormGap(function, Location.generated()) }
      }
      run List<u64>.append(&mut lanes, run Module.int(&mut writer.*.module, int32, index))
      lane = lane + usize.ONE
    }
    let maskType = run Module.vector(&mut writer.*.module, List<u64>.length(&lanes), int32)
    let mask = run Module.aggregate(&mut writer.*.module, maskType, List<u64>.asSlice(&lanes))
    return Value {scalar: kind, value: run Module.shuffle(&mut writer.*.module, lowered[usize.ZERO].value, lowered[usize.ONE].value, mask)}
  }
  if primitive == IntrinsicPrimitive.SimdPointerStore {
    let stored = run arrayLanes(&mut writer.*, &lowered[usize.ONE])
    run storeOf(&mut writer.*, stored.value, lowered[usize.ZERO].value, laneBytes(lowered[usize.ONE].scalar))
    return Value {scalar: kind, value: Bitcode.none()}
  }
  if primitive == IntrinsicPrimitive.SimdSplat {
    let vector = run typeOf(&mut writer.*, kind)
    let poison = run Module.poison(&mut writer.*.module, vector)
    let zero = run integerOf(&mut writer.*, 32, 0)
    let first = run Module.insertElement(&mut writer.*.module, poison, lowered[usize.ZERO].value, zero)
    let int32 = run integerType(&mut writer.*, 32)
    let maskType = run Module.vector(&mut writer.*.module, kind.lanes, int32)
    let mask = run Module.zero(&mut writer.*.module, maskType)
    return Value {scalar: kind, value: run Module.shuffle(&mut writer.*.module, first, poison, mask)}
  }
  let first = lowered[usize.ZERO]
  let input = first.scalar
  if primitive == IntrinsicPrimitive.SimdMinimum || primitive == IntrinsicPrimitive.SimdMaximum ||
    primitive == IntrinsicPrimitive.SimdMulAdd {
    let mut arguments = List<u64>.make()
    let mut used = usize.ZERO
    while used < lowered.length {
      run List<u64>.append(&mut arguments, lowered[used].value)
      used = used + usize.ONE
    }
    let result = run callIntrinsic(&mut writer.*, lanewiseIntrinsic(primitive, kind), kind, List<u64>.asSlice(&arguments))
    if primitive == IntrinsicPrimitive.SimdMulAdd || !kind.floating { return Value {scalar: kind, value: result} }
    return Value {scalar: kind, value: run canonicalNaN(&mut writer.*, result, kind)}
  }
  if primitive == IntrinsicPrimitive.SimdBitcast { return run castOf(&mut writer.*, Bitcode.castBitcast(), &first, kind) }
  if primitive == IntrinsicPrimitive.SimdMaskFromBits {
    let bits = integerRepresentation(kind.lanes, false)
    if kind.lanes == 64 { return run castOf(&mut writer.*, Bitcode.castBitcast(), &first, kind) }
    let narrowed = run castOf(&mut writer.*, Bitcode.castTrunc(), &first, bits)
    return run castOf(&mut writer.*, Bitcode.castBitcast(), &narrowed, kind)
  }
  if primitive == IntrinsicPrimitive.SimdMaskAny { return Value {scalar: kind, value: run anyLane(&mut writer.*, first.value, input)} }
  if primitive == IntrinsicPrimitive.SimdMaskAll {
    return Value {scalar: kind, value: run wholeVector(&mut writer.*, first.value, input, InfixOperator.Equals)}
  }
  if primitive == IntrinsicPrimitive.SimdMaskToBits || primitive == IntrinsicPrimitive.SimdMaskCount ||
    primitive == IntrinsicPrimitive.SimdMaskFirstSet {
    let mut counted = run castOf(&mut writer.*, Bitcode.castBitcast(), &first, integerRepresentation(input.lanes, false))
    if primitive != IntrinsicPrimitive.SimdMaskToBits {
      let mut name: &[u8] = b"ctpop"
      let mut flag = Bitcode.none()
      if primitive == IntrinsicPrimitive.SimdMaskFirstSet {
        name = b"cttz"
        flag = run boolOf(&mut writer.*, false)
      }
      counted = Value {scalar: counted.scalar, value: run callFlagged(&mut writer.*, name, counted.scalar, counted.value, flag)}
    }
    return run resize(&mut writer.*, &counted, kind)
  }
  if primitive == IntrinsicPrimitive.SimdReduceAdd && !input.floating {
    // The exact sum of N lanes fits in twice the lane width, so only the final range can fail.
    let mut wide = input
    wide.bits = input.bits * 2
    let widened = run resize(&mut writer.*, &first, wide)
    let mut sum = wide
    sum.lanes = usize.ZERO
    let total = Value {scalar: sum, value: run reduce(&mut writer.*, b"add", &widened, sum, false, 0, false)}
    run integerRangeGuard(&mut writer.*, &total, kind)
    return run castOf(&mut writer.*, Bitcode.castTrunc(), &total, kind)
  }
  if let Option<&'static [u8]>.Some {value: reduction} = move reductionName(primitive, input) {
    // An ordered float sum starts from lane 0 at negative zero, which leaves every sum unchanged,
    // including a zero one.
    let started = primitive == IntrinsicPrimitive.SimdReduceAdd || primitive == IntrinsicPrimitive.SimdReduceAddUnordered
    let result = run reduce(&mut writer.*, reduction, &first, kind, started, 0x8000000000000000,
      primitive == IntrinsicPrimitive.SimdReduceAddUnordered && kind.floating)
    if !kind.floating || started { return Value {scalar: kind, value: result} }
    return Value {scalar: kind, value: run canonicalNaN(&mut writer.*, result, kind)}
  }
  if primitive == IntrinsicPrimitive.SimdExtract {
    return Value {scalar: kind, value: run Module.extractElement(&mut writer.*.module, first.value, lowered[usize.ONE].value)}
  }
  if primitive == IntrinsicPrimitive.SimdInsert {
    return Value {scalar: kind, value: run Module.insertElement(&mut writer.*.module, first.value, lowered[2].value,
      lowered[usize.ONE].value)}
  }
  if primitive == IntrinsicPrimitive.SimdSelect {
    return Value {scalar: kind, value: run selectOf(&mut writer.*, first.value, lowered[usize.ONE].value, lowered[2].value)}
  }
  // A lane comparison: an ordered float predicate, except that `!=` holds for a NaN lane.
  return Value {scalar: kind, value: run compareOf(&mut writer.*, lanePredicate(primitive, input), first.value, lowered[usize.ONE].value)}
}

// The LLVM intrinsic stem of a lane-wise minimum, maximum or fused multiply-add of `kind`. A float
// minimum orders negative zero below positive zero, as `f32.min` does.
fn lanewiseIntrinsic(primitive: IntrinsicPrimitive, kind: Representation) -> &'static [u8] {
  if primitive == IntrinsicPrimitive.SimdMulAdd { return b"fma" }
  let minimum = primitive == IntrinsicPrimitive.SimdMinimum
  if kind.floating {
    if minimum { return b"minimum" }
    return b"maximum"
  }
  if kind.signed {
    if minimum { return b"smin" }
    return b"smax"
  }
  if minimum { return b"umin" }
  return b"umax"
}

// The `llvm.vector.reduce` stem of a reduction over `input`'s lanes; none for any other primitive.
fn reductionName(primitive: IntrinsicPrimitive, input: Representation) -> Option<&'static [u8]> {
  let name: &'static [u8] = match primitive {
    IntrinsicPrimitive.SimdReduceAdd => b"fadd"
    IntrinsicPrimitive.SimdReduceAddUnordered => b"fadd"
    IntrinsicPrimitive.SimdReduceWrappingAdd => b"add"
    IntrinsicPrimitive.SimdReduceBitAnd => b"and"
    IntrinsicPrimitive.SimdReduceBitOr => b"or"
    IntrinsicPrimitive.SimdReduceBitXor => b"xor"
    IntrinsicPrimitive.SimdReduceMinimum => {
      if input.floating { return Option<&'static [u8]>.some(b"fminimum") }
      if input.signed { return Option<&'static [u8]>.some(b"smin") }
      return Option<&'static [u8]>.some(b"umin")
    }
    IntrinsicPrimitive.SimdReduceMaximum => {
      if input.floating { return Option<&'static [u8]>.some(b"fmaximum") }
      if input.signed { return Option<&'static [u8]>.some(b"smax") }
      return Option<&'static [u8]>.some(b"umax")
    }
    _ => { return Option<&'static [u8]>.none() }
  }
  return Option<&'static [u8]>.some(name)
}

// `call <result> @llvm.vector.reduce.<name>.<vector>([<result> start,] <vector> value)`, starting
// from the binary64 `start` when `started`. An unordered float sum may reassociate.
effect fn reduce(writer: &mut Writer, name: &[u8], value: &Value, result: Representation, started: bool, start: u64,
  unordered: bool) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let mut callee = run Bytes.copy(b"llvm.vector.reduce.")
  run Bytes.append(&mut callee, name)
  run Bytes.append(&mut callee, b".")
  run appendMangled(&mut callee, value.scalar)
  let resultType = run typeOf(&mut writer.*, result)
  let vector = run typeOf(&mut writer.*, value.scalar)
  let mut parameters = List<u64>.make()
  let mut arguments = List<u64>.make()
  if started {
    run List<u64>.append(&mut parameters, resultType)
    run List<u64>.append(&mut arguments, run floatOf(&mut writer.*, result, start))
  }
  run List<u64>.append(&mut parameters, vector)
  run List<u64>.append(&mut arguments, value.value)
  let ty = run functionType(&mut writer.*, resultType, List<u64>.asSlice(&parameters))
  let function = run Module.functionRef(&mut writer.*.module, Bytes.asSlice(&callee), ty)
  if unordered {
    return run Module.callMath(&mut writer.*.module, ty, function, List<u64>.asSlice(&arguments), Bitcode.mathReassociate())
  }
  return run Module.call(&mut writer.*.module, ty, function, List<u64>.asSlice(&arguments), 0, false)
}

// Each NaN lane of `value` replaced by the canonical quiet NaN, so results do not depend on the
// target's NaN payloads.
effect fn canonicalNaN(writer: &mut Writer, value: u64, kind: Representation) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let unordered = run compareOf(&mut writer.*, Bitcode.floatUno(), value, value)
  let quiet = run floatOf(&mut writer.*, kind, 0x7FF8000000000000)
  return run selectOf(&mut writer.*, unordered, quiet, value)
}

// `call <kind> @llvm.<name>.<kind>(<kind> value[, i1 flag])`: a bit count with its trailing `i1`
// operand, such as `cttz`'s zero-is-poison flag, when `flag` is not `none()`.
effect fn callFlagged(writer: &mut Writer, name: &[u8], kind: Representation, value: u64, flag: u64) -> u64
! OutOfMemoryError ? &mut Allocator {
  let callee = run intrinsicName(name, kind)
  let ty = run typeOf(&mut writer.*, kind)
  if flag == Bitcode.none() {
    let parameters = [ty]
    let arguments = [value]
    return run callNamed(&mut writer.*, Bytes.asSlice(&callee), ty, &parameters, &arguments)
  }
  let boolean = run integerType(&mut writer.*, usize.ONE)
  let parameters = [ty, boolean]
  let arguments = [value, flag]
  return run callNamed(&mut writer.*, Bytes.asSlice(&callee), ty, &parameters, &arguments)
}

// `value` widened or narrowed to `output`'s integer width; a signed input widens by sign.
effect fn resize(writer: &mut Writer, value: &Value, output: Representation) -> Value ! OutOfMemoryError ? &mut Allocator {
  if value.scalar.bits == output.bits { return Value {scalar: output, value: value.value} }
  if value.scalar.bits > output.bits { return run castOf(&mut writer.*, Bitcode.castTrunc(), value, output) }
  if value.scalar.signed { return run castOf(&mut writer.*, Bitcode.castSExt(), value, output) }
  return run castOf(&mut writer.*, Bitcode.castZExt(), value, output)
}

// The byte alignment of one lane of `kind` in an array; a mask lane is one `bool` byte.
fn laneBytes(kind: Representation) -> usize {
  if kind.bits < 8 { return usize.ONE }
  return kind.bits / 8
}

// The predicate of a lane comparison over `kind`'s lanes.
fn lanePredicate(primitive: IntrinsicPrimitive, kind: Representation) -> u64 {
  if kind.floating {
    if primitive == IntrinsicPrimitive.SimdLanesEqual { return Bitcode.floatOeq() }
    if primitive == IntrinsicPrimitive.SimdLanesNotEqual { return Bitcode.floatUne() }
    if primitive == IntrinsicPrimitive.SimdLanesLess { return Bitcode.floatOlt() }
    if primitive == IntrinsicPrimitive.SimdLanesLessOrEqual { return Bitcode.floatOle() }
    if primitive == IntrinsicPrimitive.SimdLanesGreater { return Bitcode.floatOgt() }
    return Bitcode.floatOge()
  }
  if primitive == IntrinsicPrimitive.SimdLanesEqual { return Bitcode.intEq() }
  if primitive == IntrinsicPrimitive.SimdLanesNotEqual { return Bitcode.intNe() }
  if kind.signed {
    if primitive == IntrinsicPrimitive.SimdLanesLess { return Bitcode.intSlt() }
    if primitive == IntrinsicPrimitive.SimdLanesLessOrEqual { return Bitcode.intSle() }
    if primitive == IntrinsicPrimitive.SimdLanesGreater { return Bitcode.intSgt() }
    return Bitcode.intSge()
  }
  if primitive == IntrinsicPrimitive.SimdLanesLess { return Bitcode.intUlt() }
  if primitive == IntrinsicPrimitive.SimdLanesLessOrEqual { return Bitcode.intUle() }
  if primitive == IntrinsicPrimitive.SimdLanesGreater { return Bitcode.intUgt() }
  return Bitcode.intUge()
}

// The vector `kind` read from the array at `address`. A mask lane is a `bool` byte holding 0 or
// 1, so it narrows to its bit.
effect fn arrayVector(writer: &mut Writer, address: u64, kind: Representation) -> Value ! OutOfMemoryError ? &mut Allocator {
  let mut stored = kind
  if kind.bits == usize.ONE { stored.bits = 8 }
  let loaded = Value {scalar: stored, value: run loadOf(&mut writer.*, stored, address, laneBytes(kind))}
  if kind.bits != usize.ONE { return Value {scalar: kind, value: loaded.value} }
  return run castOf(&mut writer.*, Bitcode.castTrunc(), &loaded, kind)
}

// The lanes of `value` as an array store writes them; a mask lane widens to its `bool` byte.
effect fn arrayLanes(writer: &mut Writer, value: &Value) -> Value ! OutOfMemoryError ? &mut Allocator {
  if value.scalar.bits != usize.ONE { return value.* }
  let mut bytes = value.scalar
  bytes.bits = 8
  return run castOf(&mut writer.*, Bitcode.castZExt(), value, bytes)
}

// One atomic instruction at the element's natural alignment (ATOMIC-002 through ATOMIC-004). A
// compare-exchange always stores the observed value through its expected pointer: on success it
// equals the value already there.
effect fn emitAtomic(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  primitive: IntrinsicPrimitive,
  operands: &List<Operand>,
  success: MemoryOrder,
  failure: MemoryOrder,
  element: &Shared<Type>,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let unit = Value {scalar: Representation {aggregate: false, size: usize.ZERO, bits: usize.ZERO, signed: false, unit: true,
    pointer: false, floating: false, lanes: usize.ZERO, unionAlignment: usize.ZERO}, value: Bitcode.none()}
  if primitive == IntrinsicPrimitive.AtomicFence {
    run Module.fence(&mut writer.*.module, atomicOrdering(success))
    return unit
  }
  let listed = List<Operand>.asSlice(operands)
  let mut values = List<Value>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    let lowered = run emitOperand(&mut writer.*, function, target, layouts, &listed[at])
    run List<Value>.append(&mut values, lowered)
    at = at + usize.ONE
  }
  let lowered = List<Value>.asSlice(&values)
  let kind = scalar(element, target)
  let alignment = usize.toU64(kind.bits / 8)
  let pointer = lowered[usize.ZERO].value
  if primitive == IntrinsicPrimitive.AtomicLoad {
    let ty = run typeOf(&mut writer.*, kind)
    return Value {scalar: kind, value: run Module.loadAtomic(&mut writer.*.module, ty, pointer, alignment, atomicOrdering(success))}
  }
  if primitive == IntrinsicPrimitive.AtomicStore {
    run Module.storeAtomic(&mut writer.*.module, lowered[usize.ONE].value, pointer, alignment, atomicOrdering(success))
    return unit
  }
  if primitive == IntrinsicPrimitive.AtomicCompareExchange || primitive == IntrinsicPrimitive.AtomicCompareExchangeWeak {
    let expected = lowered[usize.ONE].value
    let current = run loadOf(&mut writer.*, kind, expected, kind.bits / 8)
    let pair = run Module.compareExchange(&mut writer.*.module, pointer, current, lowered[2].value, atomicOrdering(success),
      atomicOrdering(failure), primitive == IntrinsicPrimitive.AtomicCompareExchangeWeak, alignment)
    let observed = run Module.extractValue(&mut writer.*.module, pair, usize.ZERO)
    run storeOf(&mut writer.*, observed, expected, kind.bits / 8)
    return Value {scalar: booleanRepresentation(), value: run Module.extractValue(&mut writer.*.module, pair, usize.ONE)}
  }
  return Value {scalar: kind, value: run Module.atomicRmw(&mut writer.*.module, atomicReadModifyWrite(primitive, kind.signed), pointer,
    lowered[usize.ONE].value, atomicOrdering(success), alignment)}
}

// The memory effects of an inline assembly fragment as LLVM 22's `memory` attribute value: the
// inaccessible, argument, other and the two target locations, two bits each from the low end,
// with the target locations untouched unless every location is.
fn assemblyMemory(access: AssemblyMemory, sideEffects: bool) -> u64 {
  let base: u64 = 72057594037927936
  return match access {
    AssemblyMemory.None => {
      if sideEffects { return base + 12 }
      return base
    }
    AssemblyMemory.Read => {
      if sideEffects { return base + 93 }
      return base + 85
    }
    AssemblyMemory.Write => base + 174
    AssemblyMemory.ReadWrite => base + 255
  }
}

effect fn emitScalarRvalue(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  rvalue: &Rvalue,
  span: Location,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  return match & rvalue.* {
    Rvalue.SliceLength {place} => {
      let descriptor = run emitPlace(&mut writer.*, function, target, layouts, &place)
      let facts = run sliceFact(layouts, &descriptor.ty, function, span)
      let address = run wordOffset(&mut writer.*, descriptor.value, facts.lengthOffset)
      let kind = lengthRepresentation(target)
      return Value {scalar: kind, value: run loadOf(&mut writer.*, kind, address, offsetAlignment(descriptor.alignment, facts.lengthOffset))}
    }
    Rvalue.SliceData {place} => {
      let descriptor = run emitPlace(&mut writer.*, function, target, layouts, &place)
      return Value {scalar: pointerRepresentation(target), value: run loadPointer(&mut writer.*, descriptor.value, descriptor.alignment)}
    }
    Rvalue.PointerOffset {pointer, index, element} => {
      let base = run emitOperand(&mut writer.*, function, target, layouts, &pointer)
      let selected = run emitOperand(&mut writer.*, function, target, layouts, &index)
      let facts = run layoutOf(layouts, &element, function, span)
      let stride = match move Metrics.stride(&facts) {
        Option<usize>.Some {value} => value
        Option<usize>.None => {
          let owner = InstanceKey.identity(&function.key)
          fail Gap.relative(GapCode.ScalarLayout, &owner, span)
        }
      }
      return Value {scalar: pointerRepresentation(target), value: run stridedOffset(&mut writer.*, base.value, &selected, stride)}
    }
    Rvalue.Slice {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.TypedForm, &owner, span)
    }
    Rvalue.ContextOf {place} => Value {scalar: pointerRepresentation(target), value: companionAddress(&writer.*, function, place.local)}
    Rvalue.ContextHandle {address} => {
      let base = run emitOperand(&mut writer.*, function, target, layouts, &address)
      let slot = run byteOffset(&mut writer.*, base.value, companionHandleOffset(target))
      let kind = lengthRepresentation(target)
      return Value {scalar: kind, value: run loadOf(&mut writer.*, kind, slot, usize.ZERO)}
    }
    // Stored by its statement, which retains the exact instance identity.
    Rvalue.FunctionAddress {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.TypedForm, &owner, span)
    }
    // Loaded by its statement, which retains the classified C object.
    Rvalue.ForeignStatic {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.TypedForm, &owner, span)
    }
    Rvalue.FrameAddress => {
      let pointer = run pointerType(&mut writer.*)
      let int32 = run integerType(&mut writer.*, 32)
      let parameters = [int32]
      let arguments = [run integerOf(&mut writer.*, 32, 0)]
      return Value {scalar: pointerRepresentation(target),
        value: run callNamed(&mut writer.*, b"llvm.frameaddress.p0", pointer, &parameters, &arguments)}
    }
    // A dynamic `alloca` outside the entry block: LLVM releases it when the function returns. The
    // byte count traps when it does not fit the target word.
    Rvalue.StackAllocate {count, element} => {
      let selected = run emitOperand(&mut writer.*, function, target, layouts, &count)
      let facts = run layoutOf(layouts, &element, function, span)
      let stride = match move Metrics.stride(&facts) {
        Option<usize>.Some {value} => value
        Option<usize>.None => {
          let owner = InstanceKey.identity(&function.key)
          fail Gap.relative(GapCode.ScalarLayout, &owner, span)
        }
      }
      let kind = lengthRepresentation(target)
      let strideValue = run intOf(&mut writer.*, kind, usize.toU64(stride))
      let pair = run overflowPair(&mut writer.*, b"mul", kind, selected.value, strideValue)
      let overflow = run pairField(&mut writer.*, pair, usize.ONE)
      run trapWhen(&mut writer.*, overflow, b"arithmetic overflow")
      let bytes = run pairField(&mut writer.*, pair, usize.ZERO)
      let byte = run integerType(&mut writer.*, 8)
      return Value {scalar: pointerRepresentation(target),
        value: run Module.allocaCount(&mut writer.*.module, byte, bytes, usize.toU64(facts.alignment))}
    }
    // A frame-based instance's step reads its transfer record's package word.
    Rvalue.RunningPackage => {
      let transfer = writer.transfer
      return Value {scalar: pointerRepresentation(target),
        value: run loadWordAt(&mut writer.*, transfer, Coroutine.transferPackage(wordSize(target)))}
    }
    // One admitted fragment is one inline-asm call: unit fragments return `void`, every operand
    // is one word or pointer lane, and the contract supplies the clobber and memory effects.
    Rvalue.Assembly {fragment} => {
      let AssemblyFragment {template, constraints, clobbers, memory, sideEffects, noReturn, inputs, ty} =
        &Box<AssemblyFragment>.get(&fragment)[0]
      let operands = List<Operand>.asSlice(&inputs)
      let mut parameters = List<u64>.make()
      let mut arguments = List<u64>.make()
      let mut at = usize.ZERO
      while at < operands.length {
        let lowered = run emitOperand(&mut writer.*, function, target, layouts, &operands[at])
        run List<u64>.append(&mut parameters, run typeOf(&mut writer.*, lowered.scalar))
        run List<u64>.append(&mut arguments, lowered.value)
        at = at + usize.ONE
      }
      let result = scalar(&ty, target)
      let resultType = run typeOf(&mut writer.*, result)
      let functionTy = run functionType(&mut writer.*, resultType, List<u64>.asSlice(&parameters))
      let contract = run NativeAssembly.llvmConstraints(target.id(), Bytes.asSlice(&constraints),
        Bytes.asSlice(&clobbers), memory)
      let mut flags: u64 = 0
      if sideEffects { flags = 1 }
      let callee = run Module.inlineAssembly(&mut writer.*.module, functionTy, Bytes.asSlice(&template), Bytes.asSlice(&contract), flags)
      Module.beginAttributes(&mut writer.*.module)
      let mut encoding = List<u64>.make()
      if noReturn {
        run List<u64>.append(&mut encoding, 0)
        run List<u64>.append(&mut encoding, Bitcode.attrNoReturn())
      }
      run List<u64>.append(&mut encoding, 1)
      run List<u64>.append(&mut encoding, Bitcode.attrMemory())
      run List<u64>.append(&mut encoding, assemblyMemory(memory, sideEffects))
      run Module.attributeGroup(&mut writer.*.module, Bitcode.positionFunction(), List<u64>.asSlice(&encoding))
      let attributes = run Module.endAttributes(&mut writer.*.module)
      let called = run Module.call(&mut writer.*.module, functionTy, callee, List<u64>.asSlice(&arguments), attributes, false)
      return Value {scalar: result, value: called}
    }
    Rvalue.Atomic {primitive, operands, success, failure, element} =>
      run emitAtomic(&mut writer.*, function, target, layouts, primitive, &operands, success, failure, &element)
    Rvalue.Vector {primitive, operands, ty} => run emitVector(&mut writer.*, function, target, layouts, primitive, &operands, &ty)
    Rvalue.Ref {place, ..} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      return Value {scalar: pointerRepresentation(target), value: address.value}
    }
    Rvalue.AddressOf {place, ..} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      return Value {scalar: pointerRepresentation(target), value: address.value}
    }
    Rvalue.Aggregate {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.TypedForm, &owner, span)
    }
    Rvalue.Inject {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.TypedForm, &owner, span)
    }
    Rvalue.Fill {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.TypedForm, &owner, span)
    }
    Rvalue.Variant {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.TypedForm, &owner, span)
    }
    Rvalue.Discriminant {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      let kind = tagRepresentation(run taggedFact(layouts, &address.ty, function, span))
      return Value {scalar: kind, value: run loadOf(&mut writer.*, kind, address.value, address.alignment)}
    }
    Rvalue.Use {value} => run emitOperand(&mut writer.*, function, target, layouts, &value)
    Rvalue.Convert {value, ty} => run emitConvert(&mut writer.*, function, target, layouts, &value, &ty, span)
    Rvalue.Fits {value, ty} => run emitFits(&mut writer.*, function, target, layouts, &value, &ty, span)
    Rvalue.ScalarUnary {operation, value} => run emitScalarUnary(&mut writer.*, function, target, layouts, operation, &value, span)
    Rvalue.ScalarBinary {operation, left, right} => run emitScalarBinary(&mut writer.*, function, target, layouts, operation, &left, &right, span)
    Rvalue.AddressIntegerConversion {operand, destinationType} => {
      let lane = addressLane(&destinationType)
      // A wasm32 address is an exact 32-bit offset into linear memory, so the conversion is the
      // same as on native targets; only nonzero data address spaces stay refused.
      if lane == AddressLane.Unsupported || Target.dataAddressSpace(target) != 0 {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.relative(GapCode.TypedForm, &owner, span)
      }
      let mut expected = AddressLane.Pointer
      if lane == AddressLane.Pointer { expected = AddressLane.Word }
      let input = run emitAddressOperand(&mut writer.*, function, target, layouts, &operand, expected, span)
      let output = scalar(&destinationType, target)
      let bits = u32.toUsize(Target.pointerBits(target))
      if input.scalar.bits != bits || output.bits != bits {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.relative(GapCode.TypedForm, &owner, span)
      }
      if lane == AddressLane.Word { return run castOf(&mut writer.*, Bitcode.castPtrToInt(), &input, output) }
      return run castOf(&mut writer.*, Bitcode.castIntToPtr(), &input, output)
    }
    Rvalue.Bitcast {value, ty} => {
      let input = run emitOperand(&mut writer.*, function, target, layouts, &value)
      let output = scalar(&ty, target)
      if input.scalar.bits != output.bits || input.scalar.floating == output.floating || input.scalar.pointer || output.pointer || input.scalar.unit || output.unit {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.relative(GapCode.TypedForm, &owner, span)
      }
      return run castOf(&mut writer.*, Bitcode.castBitcast(), &input, output)
    }
    Rvalue.Unary {operation, value} => {
      let input = run emitOperand(&mut writer.*, function, target, layouts, &value)
      if input.scalar.floating && operation == PrefixOperator.Negate {
        return Value {scalar: input.scalar, value: run Module.fneg(&mut writer.*.module, input.value, 0)}
      }
      if input.scalar.floating || input.scalar.pointer {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.relative(GapCode.TypedForm, &owner, span)
      }
      if operation == PrefixOperator.Negate {
        let zero = Value {scalar: input.scalar, value: run intOf(&mut writer.*, input.scalar, 0)}
        return run checkedBinary(&mut writer.*, b"sub", &zero, &input)
      }
      return Value {scalar: input.scalar, value: run notOf(&mut writer.*, input.scalar, input.value)}
    }
    Rvalue.Binary {operation, left, right} => {
      let lhs = run emitOperand(&mut writer.*, function, target, layouts, &left)
      let rhs = run emitOperand(&mut writer.*, function, target, layouts, &right)
      if lhs.scalar.floating {
        let arithmetic = floatOpcode(operation)
        if arithmetic != u64.MAX {
          return Value {scalar: lhs.scalar, value: run binaryOf(&mut writer.*, arithmetic, lhs.value, rhs.value)}
        }
        let predicate = floatPredicate(operation)
        if predicate == u64.MAX {
          let owner = InstanceKey.identity(&function.key)
          fail Gap.relative(GapCode.TypedForm, &owner, span)
        }
        let compared = run compareOf(&mut writer.*, predicate, lhs.value, rhs.value)
        return Value {scalar: booleanRepresentation(), value: run wholeVector(&mut writer.*, compared, lhs.scalar, operation)}
      }
      if lhs.scalar.pointer {
        // Addresses compare only for identity, such as a null observer or cause (N4).
        if operation != InfixOperator.Equals && operation != InfixOperator.NotEquals {
          let owner = InstanceKey.identity(&function.key)
          fail Gap.relative(GapCode.TypedForm, &owner, span)
        }
        return Value {scalar: booleanRepresentation(),
          value: run compareOf(&mut writer.*, integerPredicate(operation, false), lhs.value, rhs.value)}
      }
      match operation {
        InfixOperator.Add => {
          return run checkedBinary(&mut writer.*, b"add", &lhs, &rhs)
        }
        InfixOperator.Subtract => {
          return run checkedBinary(&mut writer.*, b"sub", &lhs, &rhs)
        }
        InfixOperator.Multiply => {
          return run checkedBinary(&mut writer.*, b"mul", &lhs, &rhs)
        }
        InfixOperator.Divide => {
          return run guardedDivision(&mut writer.*, function, &lhs, &rhs, false, span)
        }
        InfixOperator.Remainder => {
          return run guardedDivision(&mut writer.*, function, &lhs, &rhs, true, span)
        }
        _ => {}
      }
      let predicate = integerPredicate(operation, lhs.scalar.signed)
      if predicate != u64.MAX {
        let compared = run compareOf(&mut writer.*, predicate, lhs.value, rhs.value)
        return Value {scalar: booleanRepresentation(), value: run wholeVector(&mut writer.*, compared, lhs.scalar, operation)}
      }
      let opcode = bitwiseOpcode(operation)
      if opcode == u64.MAX {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.relative(GapCode.TypedForm, &owner, span)
      }
      return Value {scalar: lhs.scalar, value: run binaryOf(&mut writer.*, opcode, lhs.value, rhs.value)}
    }
  }
}

effect fn storeValue(writer: &mut Writer, address: &Address, value: &Value) -> ()
! OutOfMemoryError ? &mut Allocator {
  return run storeCopy(&mut writer.*, address, value, false)
}

// `distinct` says the value's bytes never overlap the address, so a fast-path function may copy an
// aggregate with `llvm.memcpy` (see `Writer.fastPath`).
effect fn storeCopy(writer: &mut Writer, address: &Address, value: &Value, distinct: bool) -> ()
! OutOfMemoryError ? &mut Allocator {
  if address.representation.unit { return () }
  // Source and destination may overlap, as when a member is injected into a slot of its own place.
  if address.representation.aggregate {
    if address.representation.unionAlignment != usize.ZERO && address.representation.size == 16 {
      return run storePackedUnion(&mut writer.*, address, value)
    }
    return run copyCall(&mut writer.*, address.value, address.alignment, value.value, address.representation.size, distinct)
  }
  return run storeOf(&mut writer.*, value.value, address.value, address.alignment)
}

// A 16-byte union (a tag and a word, like an optional word or an interpreter's value cell) copies
// as one i128 instead of an `llvm.memmove`. LLVM turns a whole-size copy of at most a word into an integer
// copy itself, but leaves a 16-byte one as bytes, so SROA keeps the padding after the tag as its own
// slice and every copy through a stack slot reloads and stores it. The load precedes the store, so
// overlapping places stay correct, and both places hold the union, so both have its alignment.
effect fn storePackedUnion(writer: &mut Writer, address: &Address, value: &Value) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut alignment = address.representation.unionAlignment
  if address.alignment < alignment { alignment = address.alignment }
  // Clang's fast instruction selector has no i128 memory access, so a fast-path function copies
  // the two words, both loads before both stores.
  if writer.fastPath { return run storeWordPair(&mut writer.*, address, value, alignment) }
  let wide = integerRepresentation(128, false)
  let loaded = run loadOf(&mut writer.*, wide, value.value, alignment)
  return run storeOf(&mut writer.*, loaded, address.value, alignment)
}

effect fn storeWordPair(writer: &mut Writer, address: &Address, value: &Value, alignment: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let high = offsetAlignment(alignment, 8)
  let word = integerRepresentation(64, false)
  let source = run byteOffset(&mut writer.*, value.value, 8)
  let first = run loadOf(&mut writer.*, word, value.value, alignment)
  let second = run loadOf(&mut writer.*, word, source, high)
  let destination = run byteOffset(&mut writer.*, address.value, 8)
  run storeOf(&mut writer.*, first, address.value, alignment)
  return run storeOf(&mut writer.*, second, destination, high)
}

fn sameDeclaration(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  let firstAddress = Shared<DeclarationId>.with<usize>(
    left,
    fn(id: &DeclarationId) -> usize {
      return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(id))
    },
  )
  let secondAddress = Shared<DeclarationId>.with<usize>(
    right,
    fn(id: &DeclarationId) -> usize {
      return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(id))
    },
  )
  if firstAddress == secondAddress {
    return true
  }
  return Shared<DeclarationId>.with<bool>(
    left,
    fn(id: &DeclarationId) -> bool {
      return sameDeclarationRight(id, right)
    },
  )
}

// Whether `operand` reads a place whose storage never overlaps `destination`'s: another local's own
// slot, reached without a dereference on either side. An index may follow a borrowed sequence's
// data address, so it counts as one. Only an ordinary body's locals each own a slot; a step's
// frame states share storage.
fn separate(destination: &Place, operand: &Operand, ordinary: bool) -> bool {
  if !ordinary { return false }
  return match &operand.* {
    Operand.Copy {place} => separatePlaces(destination, &place)
    Operand.Move {place} => separatePlaces(destination, &place)
    _ => false
  }
}

fn separatePlaces(destination: &Place, source: &Place) -> bool {
  return source.local != destination.local && !dereferences(source) && !dereferences(destination)
}

fn dereferences(place: &Place) -> bool {
  let projections = List<Projection>.asSlice(&place.projections)
  let mut at = usize.ZERO
  while at < projections.length {
    let followed = match &projections[at] {
      Projection.Deref => true
      Projection.Index {..} => true
      _ => false
    }
    if followed { return true }
    at = at + usize.ONE
  }
  return false
}

// Stores the tag `tag` of a union at `address`, as an integer that also covers the padding up
// to the payload, which is always zero (every target is little-endian, so the tag stays in the
// low bytes). A union copies whole, padding included, so padding a built value leaves unwritten
// is read from the place's previous value: in a loop that builds a value in the same stack slot
// every iteration, SROA carries the old padding around the loop as a live value.
effect fn storeTag(writer: &mut Writer, facts: TaggedFacts, tag: usize, address: &Address) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut kind = tagRepresentation(facts)
  if facts.payloadOffset > facts.tagSize { kind.bits = facts.payloadOffset * 8 }
  let value = run intOf(&mut writer.*, kind, usize.toU64(tag))
  return run storeOf(&mut writer.*, value, address.value, address.alignment)
}

// Stores a narrow integer member of a union, such as a one-byte error enum, as a wider integer that
// also covers the padding after it, up to a word and within `room` bytes, as storeTag does for the
// tag. A union copies whole, so SROA splits its slots at every store boundary: a one-byte store at
// the payload makes every copy of a word-sized payload one byte plus an unaligned rest, and loads
// that straddle two earlier word stores miss store forwarding. Returns false when it stores nothing.
effect fn storeWidened(writer: &mut Writer, slot: &Address, value: &Value, room: usize) -> bool
! OutOfMemoryError ? &mut Allocator {
  let kind = value.scalar
  if kind.aggregate || kind.pointer || kind.unit || kind.floating || kind.lanes != usize.ZERO { return false }
  let mut width: usize = 8
  while width > room || width > slot.alignment { width = width / 2 }
  if width * 8 <= kind.bits { return false }
  let wide = integerRepresentation(width * 8, false)
  let extended = run castOf(&mut writer.*, Bitcode.castZExt(), value, wide)
  run storeOf(&mut writer.*, extended.value, slot.value, slot.alignment)
  return true
}

effect fn emitAssign(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  destination: &Place,
  value: &Rvalue,
  span: Location,
  ordinary: bool,
) -> () ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let address = run emitPlace(&mut writer.*, function, target, layouts, destination)
  if let Rvalue.Aggregate {fields} = &value.* {
    run clearPadding(&mut writer.*, layouts, &address)
    let operands = List<AggregateField>.asSlice(&fields)
    let mut fieldAt = usize.ZERO
    while fieldAt < operands.length {
      let selectedField = run projectField(&mut writer.*, function, target, layouts,
        &address, operands[fieldAt].index, span)
      let operand = run emitOperand(&mut writer.*, function, target, layouts, &operands[fieldAt].value)
      run storeCopy(&mut writer.*, &selectedField, &operand, separate(destination, &operands[fieldAt].value, ordinary))
      fieldAt = fieldAt + usize.ONE
    }
    return ()
  }
  if let Rvalue.Fill {byte} = &value.* {
    let facts = run layoutOf(layouts, &address.ty, function, span)
    run fillCall(&mut writer.*, address.value, address.alignment, byte, facts.size)
    return ()
  }
  if let Rvalue.Inject {tag, value: member} = &value.* {
    // The tag is stored first; the member is stored at the layout's payload offset.
    let facts = run taggedFact(layouts, &address.ty, function, span)
    run storeTag(&mut writer.*, facts, tag, &address)
    let operand = run emitOperand(&mut writer.*, function, target, layouts, &member)
    let payload = run byteOffset(&mut writer.*, address.value, facts.payloadOffset)
    let slot = Address {ty: Shared<Type>.clone(&address.ty), value: payload,
      alignment: offsetAlignment(address.alignment, facts.payloadOffset), representation: operand.scalar}
    let whole = run layoutOf(layouts, &address.ty, function, span)
    let room = whole.size - facts.payloadOffset
    if run storeWidened(&mut writer.*, &slot, &operand, room) { return () }
    run storeCopy(&mut writer.*, &slot, &operand, separate(destination, &member, ordinary))
    return ()
  }
  if let Rvalue.Variant {tag, fields} = &value.* {
    // The tag is stored first; each operand is stored at its variant field offset.
    let facts = run taggedFact(layouts, &address.ty, function, span)
    run storeTag(&mut writer.*, facts, tag, &address)
    let operands = List<AggregateField>.asSlice(&fields)
    let mut fieldAt = usize.ZERO
    while fieldAt < operands.length {
      let selected = run variantFieldFact(layouts, &address.ty, tag, operands[fieldAt].index, function, span)
      let operand = run emitOperand(&mut writer.*, function, target, layouts, &operands[fieldAt].value)
      let fieldAddress = run byteOffset(&mut writer.*, address.value, selected.offset)
      let slot = Address {ty: move selected.ty, value: fieldAddress,
        alignment: offsetAlignment(address.alignment, selected.offset), representation: operand.scalar}
      let mut widened = false
      // A variant's only field is followed by padding up to the end of the union.
      if operands.length == usize.ONE {
        let whole = run layoutOf(layouts, &address.ty, function, span)
        let room = whole.size - selected.offset
        widened = run storeWidened(&mut writer.*, &slot, &operand, room)
      }
      if !widened {
        run storeCopy(&mut writer.*, &slot, &operand, separate(destination, &operands[fieldAt].value, ordinary))
      }
      fieldAt = fieldAt + usize.ONE
    }
    return ()
  }
  if let Rvalue.Slice {data, count} = &value.* {
    let facts = run sliceFact(layouts, &address.ty, function, span)
    let input = run emitOperand(&mut writer.*, function, target, layouts, &data)
    let length = run emitOperand(&mut writer.*, function, target, layouts, &count)
    let kind = length.scalar
    if !input.scalar.pointer || kind.aggregate || kind.pointer || kind.floating || kind.unit
      || kind.signed || kind.bits != lengthRepresentation(target).bits {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.SliceLayout, &owner, span)
    }
    run storeOf(&mut writer.*, input.value, address.value, address.alignment)
    let lengthAddress = run wordOffset(&mut writer.*, address.value, facts.lengthOffset)
    run storeOf(&mut writer.*, length.value, lengthAddress, offsetAlignment(address.alignment, facts.lengthOffset))
    return ()
  }
  // A vector's lanes are stored as the array's elements; a mask lane is one `bool` byte.
  let toArray = match &value.* {
    Rvalue.Vector {primitive, ..} => primitive == IntrinsicPrimitive.SimdToArray
    _ => false
  }
  if toArray {
    if let Rvalue.Vector {operands, ..} = &value.* {
      let listed = List<Operand>.asSlice(&operands)
      let input = run emitOperand(&mut writer.*, function, target, layouts, &listed[usize.ZERO])
      let stored = run arrayLanes(&mut writer.*, &input)
      return run storeOf(&mut writer.*, stored.value, address.value, laneBytes(input.scalar))
    }
  }
  let selected = run emitScalarRvalue(&mut writer.*, function, target, layouts, value, span)
  let distinct = match &value.* {
    Rvalue.Use {value: used} => separate(destination, &used, ordinary)
    _ => false
  }
  run storeCopy(&mut writer.*, &address, &selected, distinct)
  return ()
}


// `ret i1 <failed>`: a fallible function's status (D3).
effect fn returnStatus(writer: &mut Writer, failed: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let status = run boolOf(&mut writer.*, failed)
  return run Module.ret(&mut writer.*.module, status)
}

// Zeroes the padding between and after a record's fields before the fields are stored. A record
// built here is usually copied whole to its final place, and a copy of never-written padding bytes
// keeps LLVM from forwarding a field the record received by copy, such as a moved payload, to that
// place: both copies stay. Written padding splits off as its own small store instead.
effect fn clearPadding(writer: &mut Writer, layouts: &TypeLayouts, address: &Address) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let gaps = match move run TypeLayouts.padding(layouts, &address.ty) {
    Option<List<DataSpan>>.Some {value} => move value
    Option<List<DataSpan>>.None => { return () }
  }
  let listed = List<DataSpan>.asSlice(&gaps)
  if listed.length == usize.ZERO { return () }
  let void = run voidType(&mut writer.*)
  let pointer = run pointerType(&mut writer.*)
  let byte = run integerType(&mut writer.*, 8)
  let wide = run integerType(&mut writer.*, 64)
  let flag = run integerType(&mut writer.*, usize.ONE)
  let parameters = [pointer, byte, wide, flag]
  let ty = run functionType(&mut writer.*, void, &parameters)
  let callee = run Module.functionRef(&mut writer.*.module, b"llvm.memset.p0.i64", ty)
  let zero = run integerOf(&mut writer.*, 8, 0)
  let volatile = run boolOf(&mut writer.*, false)
  let mut at = usize.ZERO
  while at < listed.length {
    let gap = run byteOffset(&mut writer.*, address.value, listed[at].offset)
    let length = run integerOf(&mut writer.*, 64, usize.toU64(listed[at].length))
    let arguments = [gap, zero, length, volatile]
    Module.beginAttributes(&mut writer.*.module)
    let encoding: [u64; 3] = [1, Bitcode.attrAlign(), usize.toU64(offsetAlignment(address.alignment, listed[at].offset))]
    run Module.attributeGroup(&mut writer.*.module, 1, &encoding)
    let attributes = run Module.endAttributes(&mut writer.*.module)
    drop run Module.call(&mut writer.*.module, ty, callee, &arguments, attributes, false)
    at = at + usize.ONE
  }
  return ()
}

effect fn emitReturn(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  span: Location,
) -> () ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let resultLayout = run layoutOf(layouts, &function.result, function, span)
  let kind = storageRepresentation(&function.result, target, resultLayout)
  if cExport(function) && kind.aggregate {
    let lane = run classifiedLane(function, target, layouts, &function.result, span, true)
    let slot = slotOf(&writer.*, usize.ZERO)
    if lane.passing == CPassing.Indirect {
      let out = writer.out
      run copyBytes(&mut writer.*, out, slot, lane.layout.size)
    }
    if lane.passing == CPassing.Coerce {
      let value = run readCRecord(&mut writer.*, &lane, slot)
      return run Module.ret(&mut writer.*.module, value)
    }
    return run Module.retVoid(&mut writer.*.module)
  }
  let fallible = failureLocal(function) != usize.MAX
  if kind.unit {
    if fallible { return run returnStatus(&mut writer.*, false) }
    return run Module.retVoid(&mut writer.*.module)
  }
  let returned = Operand.Copy {
    place: Place {local: usize.ZERO, projections: List<Projection>.make()},
  }
  // The result local already lives in the caller's out-slot (`resultInOut`).
  if writer.out != Bitcode.none() && resultInOut(function, kind) {
    if fallible { return run returnStatus(&mut writer.*, false) }
    return run Module.retVoid(&mut writer.*.module)
  }
  let value = run emitOperand(&mut writer.*, function, target, layouts, &returned)
  // A fallible function returns its status and writes success to the caller's out-slot (D3).
  if fallible {
    let output = Address {ty: Shared<Type>.clone(&function.result), value: writer.out,
      alignment: resultLayout.alignment, representation: kind}
    run storeCopy(&mut writer.*, &output, &value, true)
    return run returnStatus(&mut writer.*, false)
  }
  if kind.aggregate || (!cExport(function) && passedIndirectly(kind)) {
    let output = Address {ty: Shared<Type>.clone(&function.result), value: writer.out,
      alignment: resultLayout.alignment, representation: kind}
    run storeCopy(&mut writer.*, &output, &value, true)
    return run Module.retVoid(&mut writer.*.module)
  }
  return run Module.ret(&mut writer.*.module, value.value)
}

/// The `Provider` locals of a function in requirement-key order.
fn providerLocalAt(function: &MirFunction, index: usize) -> usize {
  let locals = List<Local>.asSlice(&function.locals)
  let mut at = usize.ZERO
  while at < locals.length {
    let found = match &locals[at].kind { LocalKind.Provider {index: own} => own == index _ => false }
    if found { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

/// The hidden `Observer` (0), `Cause` (1) or `Site` (2) local, or `usize.MAX` when the program
/// does not observe diagnostics (failure observer note N1, N2).
fn diagnosticLocal(function: &MirFunction, wanted: usize) -> usize {
  let locals = List<Local>.asSlice(&function.locals)
  let mut at = usize.ZERO
  while at < locals.length {
    let kind = match &locals[at].kind {
      LocalKind.Observer => usize.ZERO
      LocalKind.Cause => usize.ONE
      LocalKind.Site => 2
      _ => usize.MAX
    }
    if kind == wanted { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

/// The words of a failure context companion: identity and label descriptors, then the observer
/// pool handle (failure observer note N3, N7).
fn companionWords() -> usize { return 5 }

// The byte offset of a companion's pool handle, after its two text descriptors.
fn companionHandleOffset(target: &Target) -> usize { return wordSize(target) * 4 }

// The address of failure slot `local`'s context companion: the caller's `%context` for the
// `Failure` local, else this function's own `%cN` (failure observer note N3).
fn companionAddress(writer: &Writer, function: &MirFunction, local: usize) -> u64 {
  if local == failureLocal(function) { return writer.context }
  return List<u64>.get(&writer.companions, local)
}

effect fn addLocal(listed: &mut List<usize>, local: usize, skipped: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if local == skipped { return () }
  let entries = List<usize>.asSlice(&listed.*)
  let mut at = usize.ZERO
  while at < entries.length {
    if entries[at] == local { return () }
    at = at + usize.ONE
  }
  return run List<usize>.append(&mut listed.*, local)
}

// The failure slots that own a companion: those a context statement, a selected cause or a
// call edge of a program that observes diagnostics names, except `Failure`.
effect fn companionLocals(function: &MirFunction) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let skipped = failureLocal(function)
  let mut listed = List<usize>.make()
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = List<Statement>.asSlice(&blocks[at].statements)
    let mut statementAt = usize.ZERO
    while statementAt < statements.length {
      match &statements[statementAt] {
        Statement.FailureContext {destination, source, ..} => {
          run addLocal(&mut listed, destination.local, skipped)
          if let Option<Place>.Some {value: from} = &source { run addLocal(&mut listed, from.local, skipped) }
        }
        Statement.Assign {value, ..} => {
          if let Rvalue.ContextOf {place} = &value { run addLocal(&mut listed, place.local, skipped) }
        }
        _ => {}
      }
      statementAt = statementAt + usize.ONE
    }
    if let Terminator.Call {failure, diagnostics, ..} = &blocks[at].terminator {
      if let Option<FailureEdge>.Some {value: edge} = &failure {
        if let Option<Diagnostics>.Some {..} = &diagnostics { run addLocal(&mut listed, edge.destination.local, skipped) }
      }
    }
    at = at + usize.ONE
  }
  return move listed
}

// Stores one string descriptor `{address, length}` at `offset` of a companion.
effect fn storeText(writer: &mut Writer, companion: u64, offset: usize, word: usize, address: u64, length: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let data = run byteOffset(&mut writer.*, companion, offset)
  run storeOf(&mut writer.*, address, data, usize.ZERO)
  let size = run byteOffset(&mut writer.*, companion, offset + word)
  return run storeOf(&mut writer.*, length, size, usize.ZERO)
}

// Writes a failure slot's companion `[identity, label, handle]` (failure observer note N3, N7): carried
// word by word from `source`'s, or originated from the function's context table, selecting a union's
// active member identity by its tag.
effect fn emitFailureContext(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  destination: &Place, source: &Option<Place>, origin: Origin) -> () ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = u32.toUsize(Target.pointerBits(target)) / 8
  let wordKind = integerRepresentation(word * 8, false)
  let into = companionAddress(&writer.*, function, destination.local)
  if let Option<Place>.Some {value: from} = &source.* {
    let carried = companionAddress(&writer.*, function, from.local)
    let mut part = usize.ZERO
    while part < companionWords() {
      let read = run byteOffset(&mut writer.*, carried, part * word)
      let written = run byteOffset(&mut writer.*, into, part * word)
      let value = run loadOf(&mut writer.*, wordKind, read, usize.ZERO)
      run storeOf(&mut writer.*, value, written, usize.ZERO)
      part = part + usize.ONE
    }
    return ()
  }
  let texts = List<ContextText>.asSlice(&function.contexts)
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < texts.length && found == usize.MAX {
    if texts[at].origin.node == origin.node && texts[at].origin.location.start == origin.location.start { found = at }
    at = at + usize.ONE
  }
  if found == usize.MAX {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.relative(GapCode.TypedForm, &owner, origin.location)
  }
  let identities = List<Bytes>.asSlice(&texts[found].identities)
  let mut address = run staticBytes(&mut writer.*, Bytes.asSlice(&identities[usize.ZERO]))
  let mut length = run intOf(&mut writer.*, wordKind, usize.toU64(Bytes.length(&identities[usize.ZERO])))
  if identities.length > usize.ONE {
    // The active member's tag selects its identity.
    let slot = run emitPlace(&mut writer.*, function, target, layouts, destination)
    let kind = tagRepresentation(run taggedFact(layouts, &slot.ty, function, origin.location))
    let tag = run loadOf(&mut writer.*, kind, slot.value, usize.ZERO)
    let mut member = usize.ONE
    while member < identities.length {
      let candidate = run staticBytes(&mut writer.*, Bytes.asSlice(&identities[member]))
      let matched = run compareWith(&mut writer.*, Bitcode.intEq(), kind, tag, usize.toU64(member))
      address = run selectOf(&mut writer.*, matched, candidate, address)
      let measured = run intOf(&mut writer.*, wordKind, usize.toU64(Bytes.length(&identities[member])))
      length = run selectOf(&mut writer.*, matched, measured, length)
      member = member + usize.ONE
    }
  }
  run storeText(&mut writer.*, into, usize.ZERO, word, address, length)
  let label = run staticBytes(&mut writer.*, Bytes.asSlice(&texts[found].label))
  let labelLength = run intOf(&mut writer.*, wordKind, usize.toU64(Bytes.length(&texts[found].label)))
  return run storeText(&mut writer.*, into, word + word, word, label, labelLength)
}

/// The `Failure` local of a fallible function, or `usize.MAX` when it cannot fail.
fn failureLocal(function: &MirFunction) -> usize {
  let locals = List<Local>.asSlice(&function.locals)
  let mut at = usize.ZERO
  while at < locals.length {
    let failure = match &locals[at].kind { LocalKind.Failure => true _ => false }
    if failure { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

// `Fail` writes the failure value to the caller's failure out-slot and returns status 1 (D3).
effect fn emitFail(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts, span: Location) -> ()
! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let local = failureLocal(function)
  if local == usize.MAX {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.relative(GapCode.TypedForm, &owner, span)
  }
  let locals = List<Local>.asSlice(&function.locals)
  let failureLayout = run layoutOf(layouts, &locals[local].ty, function, span)
  let kind = storageRepresentation(&locals[local].ty, target, failureLayout)
  if !kind.unit {
    let failed = Operand.Copy {place: Place {local: local, projections: List<Projection>.make()}}
    let value = run emitOperand(&mut writer.*, function, target, layouts, &failed)
    let output = Address {ty: Shared<Type>.clone(&locals[local].ty), value: writer.failure,
      alignment: failureLayout.alignment, representation: kind}
    run storeCopy(&mut writer.*, &output, &value, true)
  }
  return run returnStatus(&mut writer.*, true)
}

/// Returns the last foreign signature declared by `declaration`, or `usize.MAX` when none is.
fn foreignSignatureIndex(foreign: &[CAbi.Signature], declaration: &Shared<DeclarationId>) -> usize {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < foreign.length {
    if sameDeclaration(declaration, &foreign[at].declaration) {
      found = at
    }
    at = at + usize.ONE
  }
  return found
}

// Authenticate a tail's actual source before loading, then promote that one materialized value.
effect fn emitVariadicArgument(writer: &mut Writer, function: &MirFunction, target: &Target,
  layouts: &TypeLayouts, operand: &Operand, argument: &CAbi.VariadicArgument, span: Location) -> Value
! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&function.key)
  let mut address = Option<Address>.none()
  if let Operand.Copy {place: source} = &operand.* {
    address = Option<Address>.some(run emitPlace(&mut writer.*, function, target, layouts, &source))
  }
  if let Operand.Move {place: source} = &operand.* {
    address = Option<Address>.some(run emitPlace(&mut writer.*, function, target, layouts, &source))
  }
  let mut input = Value {scalar: scalar(&argument.sourceType, target), value: Bitcode.none()}
  match move address {
    Option<Address>.Some {value: sourceAddress} => {
      if !(run CAbi.validVariadic(argument, &sourceAddress.ty)) { fail Gap.relative(GapCode.CAbiVariadic, &owner, span) }
      input = run loadAddress(&mut writer.*, &sourceAddress)
    }
    Option<Address>.None => {
      // Constant tails are integer, floating or null-pointer literals of the tail's exact type.
      let constant = match &operand.* {
        Operand.Integer {ty: sourceType, ..} => run CAbi.validVariadic(argument, &sourceType)
        Operand.Float {ty: sourceType, ..} => run CAbi.validVariadic(argument, &sourceType)
        Operand.Null {ty: sourceType} => run CAbi.validVariadic(argument, &sourceType)
        _ => false
      }
      if !constant { fail Gap.relative(GapCode.CAbiVariadic, &owner, span) }
      input = run emitOperand(&mut writer.*, function, target, layouts, operand)
    }
  }
  let source = scalar(&argument.sourceType, target)
  let promoted = scalar(&argument.promotedType, target)
  if input.scalar.aggregate || input.scalar.unit || input.scalar.lanes != usize.ZERO
    || input.scalar.pointer != source.pointer || input.scalar.floating != source.floating
    || input.scalar.bits != source.bits || input.scalar.signed != source.signed {
    fail Gap.relative(GapCode.CAbiVariadic, &owner, span)
  }
  // Pointers and f64 pass unchanged; f32 widens to double.
  if source.pointer || source.floating {
    if source.floating && source.bits < promoted.bits { return run castOf(&mut writer.*, Bitcode.castFPExt(), &input, promoted) }
    return input
  }
  if source.bits < promoted.bits {
    if source.signed { return run castOf(&mut writer.*, Bitcode.castSExt(), &input, promoted) }
    return run castOf(&mut writer.*, Bitcode.castZExt(), &input, promoted)
  }
  if source.bits != promoted.bits || source.signed != promoted.signed {
    fail Gap.relative(GapCode.CAbiVariadic, &owner, span)
  }
  return input
}

// Each admitted C call or exported entry retains a frame whose personality terminates during
// either unwind phase. It must survive optimization; a nounwind assertion alone is insufficient.
// A call of a sealed C allocator function needs no guard: `malloc`, `free`, `memmove` and `memset`
// never unwind, and a guard would keep every `List` growth and `RawBuffer.copy` out of line.
fn foreignGuard(function: &MirFunction) -> bool {
  if InstanceKey.fixedLinkage(&function.key) { return true }
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    if let Terminator.Call {callee, ..} = &blocks[at].terminator {
      if let Callee.Extern {..} = &callee {
        if let Option<CFunction>.None = sealedCall(&callee) { return true }
      }
      if let Callee.NativeIndirect {..} = &callee {
        if !guardedReclaim(function, &callee) { return true }
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Whether a native indirect call is drop glue's call of an adopted allocation's reclaim function,
// which goes through `__silk_guarded_reclaim` rather than guarding the glue itself.
fn guardedReclaim(function: &MirFunction, callee: &Callee) -> bool {
  if let Option<Shared<Type>>.None = InstanceKey.glueType(&function.key) { return false }
  return match &callee.* {
    Callee.NativeIndirect {..} => true
    _ => false
  }
}

effect fn nativeSignature(function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  signature: &Shared<Type>, span: Location) -> CAbi.Signature
! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&function.key)
  let copied = run Type.copy(signature)
  if let Type.Callable {parameters, result, ..} = move copied {
    let returned = run classifiedLane(function, target, layouts, &result, span, true)
    let lanes = run classifiedParameters(function, target, layouts, List<Shared<Type>>.asSlice(&parameters), &returned, span)
    return CAbi.Signature {importModule: Bytes.make(), importName: Bytes.make(),
      behavior: ForeignContract.conservative(), callbackContracts: Bytes.make(), noCapture: List<usize>.make(),
      declaration: Shared<DeclarationId>.clone(&owner), symbol: Bytes.make(),
      source: GapSource.Relative {declaration: move owner, location: span}, result: move returned,
      parameters: move lanes, global: false, variadic: false}
  }
  fail Gap.relative(GapCode.ForeignAbi, &owner, span)
}

effect fn cCopySlots(writer: &mut Writer, parameters: &[CAbi.Lane], block: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < parameters.length {
    let lane = &parameters[at]
    if lane.passing == CPassing.Indirect {
      let storage = run cStorageType(&mut writer.*, lane)
      let mut alignment = lane.layout.alignment
      if lane.stackAlignment > alignment { alignment = lane.stackAlignment }
      let address = run Module.alloca(&mut writer.*.module, storage, usize.toU64(alignment))
      Module.setName(&mut writer.*.module, address, Bitcode.named2(Bitcode.prefixCopy(), block, at))
      run List<CallerCopy>.append(&mut writer.*.copies, CallerCopy {block: block, parameter: at, address: address})
    }
    at = at + usize.ONE
  }
  return ()
}

// Blocks reached from the entry without taking a failure edge or a cancel exit.
effect fn hotBlocks(function: &MirFunction) -> List<bool> ! OutOfMemoryError ? &mut Allocator {
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut hot = List<bool>.make()
  run List<bool>.appendRepeated(&mut hot, false, blocks.length)
  if blocks.length == usize.ZERO { return move hot }
  let mut pending = List<usize>.make()
  run List<usize>.append(&mut pending, usize.ZERO)
  List<bool>.set(&mut hot, usize.ZERO, true)
  while List<usize>.length(&pending) > usize.ZERO {
    let last = List<usize>.length(&pending) - usize.ONE
    let at = List<usize>.get(&pending, last)
    List<usize>.truncate(&mut pending, last)
    let mut next = List<usize>.make()
    match &blocks[at].terminator {
      Terminator.Goto {target, ..} => run List<usize>.append(&mut next, target)
      Terminator.Branch {thenBlock, elseBlock, ..} => {
        run List<usize>.append(&mut next, thenBlock)
        run List<usize>.append(&mut next, elseBlock)
      }
      Terminator.Call {normal, ..} => run List<usize>.append(&mut next, normal)
      Terminator.Relinquish {resume, ..} => run List<usize>.append(&mut next, resume)
      Terminator.Switch {cases, otherwise, ..} => {
        let listed = List<SwitchCase>.asSlice(&cases)
        let mut case = usize.ZERO
        while case < listed.length {
          run List<usize>.append(&mut next, listed[case].target)
          case = case + usize.ONE
        }
        run List<usize>.append(&mut next, otherwise)
      }
      _ => {}
    }
    let reached = List<usize>.asSlice(&next)
    let mut each = usize.ZERO
    while each < reached.length {
      if !List<bool>.get(&hot, reached[each]) {
        List<bool>.set(&mut hot, reached[each], true)
        run List<usize>.append(&mut pending, reached[each])
      }
      each = each + usize.ONE
    }
  }
  return move hot
}

// A drop on a failure path that passes a whole aggregate local's own address to out-of-line drop
// glue makes that local escape, so LLVM keeps it in memory on the hot path too: a struct literal
// moved into an inlined constructor is built in a stack temporary and copied into place (#2507).
// Such a drop runs on an entry-block copy instead, made by `copyBytes` just before the call; the
// copy is a plain memory transfer, which leaves the local promotable.
effect fn emitDropCopySlots(writer: &mut Writer, function: &MirFunction, target: &Target,
  layouts: &TypeLayouts) -> () ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let hot = run hotBlocks(function)
  let blocks = List<Block>.asSlice(&function.blocks)
  let locals = List<Local>.asSlice(&function.locals)
  let word = usize.toU64(writer.pointerBits) / 8
  let mut block = usize.ZERO
  while block < blocks.length {
    if !List<bool>.get(&hot, block) {
      let statements = List<Statement>.asSlice(&blocks[block].statements)
      let mut at = usize.ZERO
      while at < statements.length {
        if let Statement.Drop {destination, origin, ..} = &statements[at] {
          if List<Projection>.length(&destination.projections) == usize.ZERO {
            let local = destination.local
            let facts = run layoutOf(layouts, &locals[local].ty, function, origin.location)
            let kind = storageRepresentation(&locals[local].ty, target, facts)
            if !kind.unit && usize.toU64(facts.size) > word * 2 {
              let ty = run typeOf(&mut writer.*, kind)
              let address = run Module.alloca(&mut writer.*.module, ty, usize.toU64(facts.alignment))
              run List<DropCopy>.append(&mut writer.*.dropCopies, DropCopy {block: block, statement: at, address: address, size: facts.size})
            }
          }
        }
        at = at + usize.ONE
      }
    }
    block = block + usize.ONE
  }
  return ()
}

// The entry-block copy that cold drop statement `statement` of block `block` runs on, if any.
fn dropCopy(writer: &Writer, block: usize, statement: usize) -> Option<DropCopy> {
  let listed = List<DropCopy>.asSlice(&writer.dropCopies)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].block == block && listed[at].statement == statement { return Option<DropCopy>.some(listed[at]) }
    at = at + usize.ONE
  }
  return Option<DropCopy>.none()
}

// The caller copy slot of indirect C argument `parameter` of block `block`'s call.
fn callerCopy(writer: &Writer, block: usize, parameter: usize) -> u64 {
  let copies = List<CallerCopy>.asSlice(&writer.copies)
  let mut at = usize.ZERO
  while at < copies.length {
    if copies[at].block == block && copies[at].parameter == parameter { return copies[at].address }
    at = at + usize.ONE
  }
  return Bitcode.none()
}

// Caller copies belong to the entry block, so a foreign call in a loop does not grow the stack.
effect fn emitCCopySlots(writer: &mut Writer, function: &MirFunction, target: &Target,
  layouts: &TypeLayouts, foreign: &[CAbi.Signature]) -> ()
! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    if let Terminator.Call {callee, origin, ..} = &blocks[at].terminator {
      if let Callee.Extern {declaration, ..} = &callee {
        let index = foreignSignatureIndex(foreign, &declaration)
        if index != usize.MAX { run cCopySlots(&mut writer.*, List<CAbi.Lane>.asSlice(&foreign[index].parameters), at) }
      }
      if let Callee.NativeIndirect {signature, ..} = &callee {
        let native = run nativeSignature(function, target, layouts, &signature, origin.location)
        run cCopySlots(&mut writer.*, List<CAbi.Lane>.asSlice(&native.parameters), at)
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// `invoke` of `callee`: an unwind lands in a cleanup that traps, and the code that follows runs in
// the normal continuation.
effect fn invokeGuarded(writer: &mut Writer, functionTy: u64, callee: u64, arguments: &[u64], attributes: u64) -> u64
! OutOfMemoryError ? &mut Allocator {
  let resumedName = freshName(&mut writer.*, Bitcode.prefixValue())
  let resumed = run Module.newBlock(&mut writer.*.module, resumedName)
  let unwoundName = freshName(&mut writer.*, Bitcode.prefixValue())
  let unwound = run Module.newBlock(&mut writer.*.module, unwoundName)
  let result = run Module.invoke(&mut writer.*.module, functionTy, callee, arguments, attributes, resumed, unwound)
  startBlock(&mut writer.*, unwound)
  let pointer = run pointerType(&mut writer.*)
  let int32 = run integerType(&mut writer.*, 32)
  let landing = run Module.pair(&mut writer.*.module, pointer, int32)
  let pad = run Module.landingPad(&mut writer.*.module, landing)
  run trapHere(&mut writer.*)
  startBlock(&mut writer.*, resumed)
  return result
}

// The sealed C allocator function `callee` names, if it names one.
fn sealedCall(callee: &Callee) -> Option<CFunction> {
  if let Callee.Extern {declaration, ..} = &callee.* {
    return Shared<DeclarationId>.with<Option<CFunction>>(&declaration, SealedCore.declarationFunction)
  }
  return Option<CFunction>.none()
}

// Calls a sealed C allocator function: `memmove` and `memset` as LLVM's intrinsics, which LLVM
// expands inline for a small or constant length, and `malloc` and `free` as plain calls. Returns
// the result value, the destination for `memmove` and `memset`.
effect fn emitSealedCall(writer: &mut Writer, selected: CFunction, functionTy: u64, callee: u64,
  passed: &[u64], attributes: u64) -> u64 ! OutOfMemoryError ? &mut Allocator {
  if !writer.fastPath && selected == CFunction.Memmove {
    let void = run voidType(&mut writer.*)
    let pointer = run pointerType(&mut writer.*)
    // The length is a `usize`, so the intrinsic is the one of the target's word width.
    let bits = writer.pointerBits
    let wide = run integerType(&mut writer.*, bits)
    let flag = run integerType(&mut writer.*, usize.ONE)
    let parameters = [pointer, pointer, wide, flag]
    let ty = run functionType(&mut writer.*, void, &parameters)
    let mut name: &[u8] = b"llvm.memmove.p0.p0.i64"
    if bits == 32 { name = b"llvm.memmove.p0.p0.i32" }
    let intrinsic = run Module.functionRef(&mut writer.*.module, name, ty)
    let volatile = run boolOf(&mut writer.*, false)
    let arguments = [passed[0], passed[1], passed[2], volatile]
    drop run Module.call(&mut writer.*.module, ty, intrinsic, &arguments, 0, false)
    return passed[0]
  }
  if !writer.fastPath && selected == CFunction.Memset {
    let void = run voidType(&mut writer.*)
    let pointer = run pointerType(&mut writer.*)
    let narrow = run integerType(&mut writer.*, 8)
    let bits = writer.pointerBits
    let wide = run integerType(&mut writer.*, bits)
    let flag = run integerType(&mut writer.*, usize.ONE)
    let parameters = [pointer, narrow, wide, flag]
    let ty = run functionType(&mut writer.*, void, &parameters)
    let mut name: &[u8] = b"llvm.memset.p0.i64"
    if bits == 32 { name = b"llvm.memset.p0.i32" }
    let intrinsic = run Module.functionRef(&mut writer.*.module, name, ty)
    let byte = run Module.cast(&mut writer.*.module, Bitcode.castTrunc(), passed[1], narrow)
    let volatile = run boolOf(&mut writer.*, false)
    let arguments = [passed[0], byte, passed[2], volatile]
    drop run Module.call(&mut writer.*.module, ty, intrinsic, &arguments, 0, false)
    return passed[0]
  }
  return run Module.call(&mut writer.*.module, functionTy, callee, passed, attributes, false)
}

effect fn emitCCall(writer: &mut Writer, function: &MirFunction, target: &Target,
  layouts: &TypeLayouts, signature: &CAbi.Signature, callee: &Callee, arguments: &List<Operand>,
  providers: &List<Operand>, diagnostics: &Option<Diagnostics>, destination: &Place,
  normal: usize, failure: &Option<FailureEdge>, span: Location, block: usize) -> ()
! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&function.key)
  let parameters = List<CAbi.Lane>.asSlice(&signature.parameters)
  let values = List<Operand>.asSlice(arguments)
  if signature.global || values.length < parameters.length || (!signature.variadic && values.length != parameters.length)
    || (signature.variadic && parameters.length == usize.ZERO) {
    fail Gap.relative(GapCode.CAbiVariadic, &owner, span)
  }
  if List<Operand>.length(providers) != usize.ZERO { fail Gap.relative(GapCode.ForeignAbi, &owner, span) }
  if let Option<Diagnostics>.Some {..} = &diagnostics.* { fail Gap.relative(GapCode.ForeignAbi, &owner, span) }
  if let Option<FailureEdge>.Some {..} = &failure.* { fail Gap.relative(GapCode.ForeignAbi, &owner, span) }
  if let Callee.Extern {variadicArguments, ..} = &callee.* {
    if List<CAbi.VariadicArgument>.length(&variadicArguments) != values.length - parameters.length {
      fail Gap.relative(GapCode.CAbiVariadic, &owner, span)
    }
  }
  let output = run emitPlace(&mut writer.*, function, target, layouts, destination)
  if !(run Type.equalsShared(&output.ty, &signature.result.ty)) { fail Gap.relative(GapCode.ForeignAbi, &owner, span) }
  let mut address = Bitcode.none()
  if let Callee.NativeIndirect {address: operand, ..} = &callee.* {
    let loaded = run emitOperand(&mut writer.*, function, target, layouts, &operand)
    address = loaded.value
  }
  // Each lane's parts, in order.
  let mut prepared = List<u64>.make()
  let mut at = usize.ZERO
  while at < parameters.length {
    let lane = &parameters[at]
    if lane.layout.abi == Abi.Unit { fail Gap.relative(GapCode.UnitParameter, &owner, span) }
    if lane.passing == CPassing.Direct {
      let value = run emitArgument(&mut writer.*, function, target, layouts, &values[at], true)
      run List<u64>.append(&mut prepared, value.value)
    } else {
      let selected = match &values[at] {
        Operand.Copy {place} => run emitPlace(&mut writer.*, function, target, layouts, &place)
        Operand.Move {place} => run emitPlace(&mut writer.*, function, target, layouts, &place)
        _ => { fail Gap.relative(GapCode.ForeignAbi, &owner, span) }
      }
      if !(run Type.equalsShared(&selected.ty, &lane.ty)) { fail Gap.relative(GapCode.ForeignAbi, &owner, span) }
      if lane.passing == CPassing.Indirect {
        let copy = callerCopy(&writer.*, block, at)
        run copyBytes(&mut writer.*, copy, selected.value, lane.layout.size)
        run List<u64>.append(&mut prepared, copy)
      } else if lane.passing == CPassing.Coerce {
        if lane.grouped {
          run List<u64>.append(&mut prepared, run readCRecord(&mut writer.*, lane, selected.value))
        } else {
          let pieces = List<CPiece>.asSlice(&lane.pieces)
          let mut part = usize.ZERO
          while part < pieces.length {
            let value = run loadCPiece(&mut writer.*, lane, pieces[part], selected.value)
            run List<u64>.append(&mut prepared, value.value)
            part = part + usize.ONE
          }
        }
      }
    }
    at = at + usize.ONE
  }
  let mut tails = List<Value>.make()
  if let Callee.Extern {variadicArguments, ..} = &callee.* {
    let promotions = List<CAbi.VariadicArgument>.asSlice(&variadicArguments)
    at = usize.ZERO
    while at < promotions.length {
      run List<Value>.append(&mut tails, run emitVariadicArgument(&mut writer.*, function, target, layouts,
        &values[parameters.length + at], &promotions[at], span))
      at = at + usize.ONE
    }
  }
  let returned = &signature.result
  let hasResult = returned.passing == CPassing.Coerce || (returned.passing == CPassing.Direct && returned.layout.abi != Abi.Unit)
  let functionTy = run cFunctionType(&mut writer.*, signature)
  let mut passed = List<u64>.make()
  if returned.passing == CPassing.Indirect { run List<u64>.append(&mut passed, output.value) }
  let inputs = List<u64>.asSlice(&prepared)
  at = usize.ZERO
  while at < inputs.length {
    run List<u64>.append(&mut passed, inputs[at])
    at = at + usize.ONE
  }
  let trailing = List<Value>.asSlice(&tails)
  at = usize.ZERO
  while at < trailing.length {
    run List<u64>.append(&mut passed, trailing[at].value)
    at = at + usize.ONE
  }
  let mut invoked = address
  if invoked == Bitcode.none() { invoked = run Module.functionRef(&mut writer.*.module, Bytes.asSlice(&signature.symbol), functionTy) }
  let attributes = run cAttributes(&mut writer.*, signature, false)
  let mut result = Bitcode.none()
  if let Option<CFunction>.Some {value: selected} = sealedCall(callee) {
    result = run emitSealedCall(&mut writer.*, selected, functionTy, invoked, List<u64>.asSlice(&passed), attributes)
  } else if guardedReclaim(function, callee) {
    if List<u64>.length(&passed) != usize.ONE || hasResult { fail Gap.relative(GapCode.ForeignAbi, &owner, span) }
    let void = run voidType(&mut writer.*)
    let pointer = run pointerType(&mut writer.*)
    let helperParameters = [pointer, pointer]
    let helperTy = run functionType(&mut writer.*, void, &helperParameters)
    let helper = run Module.functionRef(&mut writer.*.module, b"__silk_guarded_reclaim", helperTy)
    let helperArguments = [invoked, List<u64>.get(&passed, usize.ZERO)]
    drop run Module.call(&mut writer.*.module, helperTy, helper, &helperArguments, 0, false)
  } else {
    result = run invokeGuarded(&mut writer.*, functionTy, invoked, List<u64>.asSlice(&passed), attributes)
  }
  if returned.passing == CPassing.Coerce { run writeCRecord(&mut writer.*, returned, result, output.value) }
  else if hasResult { run storeValue(&mut writer.*, &output, &Value {scalar: output.representation, value: result}) }
  let next = blockAt(&writer.*, normal)
  return run branch(&mut writer.*, next)
}

effect fn emitCall(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  foreign: &[CAbi.Signature],
  identities: &[InstanceIdentity],
  callee: &Callee,
  arguments: &List<Operand>,
  providers: &List<Operand>,
  diagnostics: &Option<Diagnostics>,
  destination: &Place,
  normal: usize,
  failure: &Option<FailureEdge>,
  span: Location,
  block: usize,
) -> () ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Callee.NativeIndirect {signature, ..} = &callee.* {
    let native = run nativeSignature(function, target, layouts, &signature, span)
    return run emitCCall(&mut writer.*, function, target, layouts, &native, callee, arguments,
      providers, diagnostics, destination, normal, failure, span, block)
  }
  if let Callee.Extern {declaration, ..} = &callee.* {
    let index = foreignSignatureIndex(foreign, &declaration)
    if index == usize.MAX {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.ForeignAbi, &owner, span)
    }
    return run emitCCall(&mut writer.*, function, target, layouts, &foreign[index], callee, arguments,
      providers, diagnostics, destination, normal, failure, span, block)
  }
  return run emitCallInner(&mut writer.*, function, target, layouts, identities,
    callee, arguments, providers, diagnostics, destination, normal, failure, span)
}

effect fn emitCallInner(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  identities: &[InstanceIdentity],
  callee: &Callee,
  arguments: &List<Operand>,
  providers: &List<Operand>,
  diagnostics: &Option<Diagnostics>,
  destination: &Place,
  normal: usize,
  failure: &Option<FailureEdge>,
  span: Location,
) -> () ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let output = run emitPlace(&mut writer.*, function, target, layouts, destination)
  let kind = output.representation
  // A fallible callee takes success and failure out-addresses after its arguments and returns a
  // status: 0 continues at `normal`, 1 at the failure edge (D3).
  let mut failed = Option<Address>.none()
  let mut context = Bitcode.none()
  let mut handler = usize.MAX
  if let Option<FailureEdge>.Some {value: edge} = &failure.* {
    failed = Option<Address>.some(run emitPlace(&mut writer.*, function, target, layouts, &edge.destination))
    // In a program that observes diagnostics the callee also writes the destination's companion (N3).
    if let Option<Diagnostics>.Some {..} = &diagnostics.* {
      context = companionAddress(&writer.*, function, edge.destination.local)
    }
    handler = edge.target
  }
  let mut indirect = Bitcode.none()
  if let Callee.Indirect {address} = &callee.* {
    let loaded = run emitOperand(&mut writer.*, function, target, layouts, &address)
    indirect = loaded.value
  }
  let fallible = handler != usize.MAX
  // Provider addresses follow the written arguments (D2).
  let mut addresses = List<u64>.make()
  let hidden = List<Operand>.asSlice(providers)
  let mut providerAt = usize.ZERO
  while providerAt < hidden.length {
    let provided = run emitOperand(&mut writer.*, function, target, layouts, &hidden[providerAt])
    run List<u64>.append(&mut addresses, provided.value)
    providerAt = providerAt + usize.ONE
  }
  // An observed callee then takes the observer and selected-cause addresses (N1, N2).
  if let Option<Diagnostics>.Some {value: observed} = &diagnostics.* {
    run appendDiagnostics(&mut writer.*, function, target, layouts, &observed, &mut addresses)
  }
  let values = List<Operand>.asSlice(arguments)
  let mut evaluated = List<Value>.make()
  let mut index = usize.ZERO
  while index < values.length {
    let value = run emitArgument(&mut writer.*, function, target, layouts, &values[index], false)
    if !value.scalar.unit { run List<Value>.append(&mut evaluated, value) }
    index = index + usize.ONE
  }
  // A wide vector result is written through the caller's address like an aggregate (SIMD-009).
  let outward = kind.aggregate || passedIndirectly(kind)
  let pointer = run pointerType(&mut writer.*)
  let mut resultType = run voidType(&mut writer.*)
  let mut extended = false
  if fallible {
    resultType = run integerType(&mut writer.*, usize.ONE)
    extended = writer.fastPath
  } else if !outward {
    resultType = run typeOf(&mut writer.*, kind)
    extended = extendedFlag(&writer.*, kind)
  }
  let mut parameters = List<u64>.make()
  let mut passed = List<u64>.make()
  let leadingOutput = outward && !fallible
  if leadingOutput {
    run List<u64>.append(&mut parameters, pointer)
    run List<u64>.append(&mut passed, output.value)
  }
  let prepared = List<Value>.asSlice(&evaluated)
  index = usize.ZERO
  while index < prepared.length {
    run List<u64>.append(&mut parameters, run typeOf(&mut writer.*, prepared[index].scalar))
    run List<u64>.append(&mut passed, prepared[index].value)
    index = index + usize.ONE
  }
  let addressed = List<u64>.asSlice(&addresses)
  index = usize.ZERO
  while index < addressed.length {
    run List<u64>.append(&mut parameters, pointer)
    run List<u64>.append(&mut passed, addressed[index])
    index = index + usize.ONE
  }
  if let Option<Address>.Some {value: failureSlot} = &failed {
    run List<u64>.append(&mut parameters, pointer)
    run List<u64>.append(&mut passed, output.value)
    run List<u64>.append(&mut parameters, pointer)
    run List<u64>.append(&mut passed, failureSlot.value)
    if context != Bitcode.none() {
      run List<u64>.append(&mut parameters, pointer)
      run List<u64>.append(&mut passed, context)
    }
  }
  let functionTy = run functionType(&mut writer.*, resultType, List<u64>.asSlice(&parameters))
  let mut calleeValue = indirect
  if let Callee.Instance {key} = &callee.* {
    let symbol = run InstanceIdentity.name(identities, &key)
    calleeValue = run Module.functionRef(&mut writer.*.module, Bytes.asSlice(&symbol), functionTy)
  }
  let attributes = run resultAttributes(&mut writer.*, extended)
  let mut returned = Bitcode.none()
  if InstanceKey.fixedLinkage(&function.key) {
    returned = run invokeGuarded(&mut writer.*, functionTy, calleeValue, List<u64>.asSlice(&passed), attributes)
  } else {
    returned = run Module.call(&mut writer.*.module, functionTy, calleeValue, List<u64>.asSlice(&passed), attributes, false)
  }
  if fallible {
    let onFailure = blockAt(&writer.*, handler)
    let onSuccess = blockAt(&writer.*, normal)
    return run branchIf(&mut writer.*, returned, onFailure, onSuccess)
  }
  if !kind.unit && !outward {
    run storeValue(&mut writer.*, &output, &Value {scalar: kind, value: returned})
  }
  let next = blockAt(&writer.*, normal)
  return run branch(&mut writer.*, next)
}

// Appends the current observer, selected cause and site addresses an observed callee takes.
effect fn appendDiagnostics(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  observed: &Diagnostics, addresses: &mut List<u64>) -> () ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let observer = run emitOperand(&mut writer.*, function, target, layouts, Diagnostics.observer(observed))
  run List<u64>.append(&mut addresses.*, observer.value)
  let cause = run emitOperand(&mut writer.*, function, target, layouts, Diagnostics.cause(observed))
  run List<u64>.append(&mut addresses.*, cause.value)
  let site = run emitOperand(&mut writer.*, function, target, layouts, Diagnostics.site(observed))
  return run List<u64>.append(&mut addresses.*, site.value)
}

// Copies the current value of one classified C object into its destination place.
effect fn emitForeignStaticRead(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  foreign: &[CAbi.Signature],
  destination: &Place,
  declaration: &Shared<DeclarationId>,
  span: Location,
) -> () ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let index = foreignSignatureIndex(foreign, declaration)
  if index == usize.MAX || !foreign[index].global {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.relative(GapCode.ForeignStatic, &owner, span)
  }
  let output = run emitPlace(&mut writer.*, function, target, layouts, destination)
  let ty = run cLaneType(&mut writer.*, &foreign[index].result, &foreign[index].declaration, &foreign[index].source)
  let symbol = run Module.objectRef(&mut writer.*.module, Bytes.asSlice(&foreign[index].symbol), ty)
  let object = Address {
    ty: Shared<Type>.clone(&output.ty),
    value: symbol,
    alignment: foreign[index].result.layout.alignment,
    representation: output.representation,
  }
  let value = run loadAddress(&mut writer.*, &object)
  return run storeValue(&mut writer.*, &output, &value)
}

// A placeholder function type for a symbol used only as an address.
effect fn addressOnlyType(writer: &mut Writer) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let void = run voidType(&mut writer.*)
  return run functionType(&mut writer.*, void, &[])
}

effect fn emitBlock(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  block: &Block,
  foreign: &[CAbi.Signature],
  identities: &[InstanceIdentity],
  suspended: &Option<Suspended>,
  index: usize,
  lifetimes: &[BlockMarkers],
  companions: &[usize],
) -> () ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let statements = List<Statement>.asSlice(&block.statements)
  let ordinary = match &suspended.* {
    Option<Suspended>.Some {..} => false
    Option<Suspended>.None => true
  }
  let none = List<Marker>.make()
  let mut starts = List<Marker>.asSlice(&none)
  let mut ends = List<Marker>.asSlice(&none)
  if index < lifetimes.length {
    run lifetimeCalls(&mut writer.*, b"end", List<usize>.asSlice(&lifetimes[index].entry), companions)
    starts = List<Marker>.asSlice(&lifetimes[index].starts)
    ends = List<Marker>.asSlice(&lifetimes[index].ends)
  }
  let mut startAt = usize.ZERO
  let mut endAt = usize.ZERO
  let mut at = usize.ZERO
  while at < statements.length {
    while startAt < starts.length && starts[startAt].at == at {
      run markLife(&mut writer.*, b"start", starts[startAt].local, companions)
      startAt = startAt + usize.ONE
    }
    match & statements[at] {
      Statement.Assign {destination, value, origin} => {
        match &value {
          // A callback's address is its emitted symbol (failure observer note N1).
          Rvalue.FunctionAddress {key} => {
            let address = run emitPlace(&mut writer.*, function, target, layouts, &destination)
            let symbol = run InstanceIdentity.name(identities, &key)
            let ty = run addressOnlyType(&mut writer.*)
            let callback = run Module.functionRef(&mut writer.*.module, Bytes.asSlice(&symbol), ty)
            run storeOf(&mut writer.*, callback, address.value, usize.ZERO)
          }
          Rvalue.ForeignStatic {declaration} => {
            run emitForeignStaticRead(&mut writer.*, function, target, layouts, foreign, &destination, &declaration, origin.location)
          }
          _ => {
            let report = run trapReport(&writer.*, function, target, origin)
            writer.trap = move report
            run emitAssign(&mut writer.*, function, target, layouts, &destination, &value, origin.location, ordinary)
            writer.trap = Option<TrapReport>.none()
          }
        }
      }
      // A drop calls the glue of the place's type with the place's address (MIR core shape §3),
      // then the current observer and cause in a program that observes diagnostics.
      Statement.Drop {destination, glue, diagnostics, origin} => {
        let address = run emitPlace(&mut writer.*, function, target, layouts, &destination)
        let mut droppedAddress = address.value
        if let Option<DropCopy>.Some {value: copy} = dropCopy(&writer.*, index, at) {
          run copyBytes(&mut writer.*, copy.address, address.value, copy.size)
          droppedAddress = copy.address
        }
        let mut passed = List<u64>.make()
        run List<u64>.append(&mut passed, droppedAddress)
        if let Option<Diagnostics>.Some {value: observed} = &diagnostics {
          run appendDiagnostics(&mut writer.*, function, target, layouts, &observed, &mut passed)
        }
        let symbol = run InstanceIdentity.name(identities, &glue)
        let pointer = run pointerType(&mut writer.*)
        let mut parameters = List<u64>.make()
        let mut counted = usize.ZERO
        while counted < List<u64>.length(&passed) {
          run List<u64>.append(&mut parameters, pointer)
          counted = counted + usize.ONE
        }
        let void = run voidType(&mut writer.*)
        let dropped = run callNamed(&mut writer.*, Bytes.asSlice(&symbol), void, List<u64>.asSlice(&parameters), List<u64>.asSlice(&passed))
      }
      Statement.FailureContext {destination, source, origin} => {
        run emitFailureContext(&mut writer.*, function, target, layouts, &destination, &source, origin)
      }
      Statement.SetContextHandle {address, value, ..} => {
        let base = run emitOperand(&mut writer.*, function, target, layouts, &address)
        let handle = run emitOperand(&mut writer.*, function, target, layouts, &value)
        let slot = run byteOffset(&mut writer.*, base.value, companionHandleOffset(target))
        run storeOf(&mut writer.*, handle.value, slot, usize.ZERO)
      }
    }
    while endAt < ends.length && ends[endAt].at == at {
      run markLife(&mut writer.*, b"end", ends[endAt].local, companions)
      endAt = endAt + usize.ONE
    }
    at = at + usize.ONE
  }
  while startAt < starts.length {
    run markLife(&mut writer.*, b"start", starts[startAt].local, companions)
    startAt = startAt + usize.ONE
  }
  match & block.terminator {
    Terminator.Goto {target: next, origin: _} => {
      let handle = blockAt(&writer.*, next)
      run branch(&mut writer.*, handle)
    }
    Terminator.Branch {condition, thenBlock, elseBlock, origin: _} => {
      let tested = run emitOperand(&mut writer.*, function, target, layouts, &condition)
      let onTrue = blockAt(&writer.*, thenBlock)
      let onFalse = blockAt(&writer.*, elseBlock)
      run branchIf(&mut writer.*, tested.value, onTrue, onFalse)
    }
    Terminator.Return {origin} => match &suspended.* {
      Option<Suspended>.Some {value: stepping} => run emitStepReturn(&mut writer.*, function, target, layouts, &stepping, origin.location)
      Option<Suspended>.None => run emitReturn(&mut writer.*, function, target, layouts, origin.location)
    }
    Terminator.Call {callee, arguments, providers, diagnostics, destination, normal, failure, origin} => {
      let mut state = usize.MAX
      if let Option<Suspended>.Some {value: stepping} = &suspended.* {
        state = Coroutine.stateAfter(&stepping.coroutine, index)
      }
      if state != usize.MAX {
        if let Option<Suspended>.Some {value: stepping} = &suspended.* {
          run emitSuspendingCall(&mut writer.*, function, target, layouts, identities, &stepping, state, &callee,
            &arguments, &providers, &diagnostics, &destination, &failure, origin.location)
        }
      } else {
        run emitCall(
          &mut writer.*,
          function,
          target,
          layouts,
          foreign,
          identities,
          &callee,
          &arguments,
          &providers,
          &diagnostics,
          &destination,
          normal,
          &failure,
          origin.location,
          index,
        )
      }
    }
    Terminator.Fail {origin} => match &suspended.* {
      Option<Suspended>.Some {value: stepping} => run emitStepFail(&mut writer.*, function, target, layouts, &stepping, origin.location)
      Option<Suspended>.None => run emitFail(&mut writer.*, function, target, layouts, origin.location)
    }
    // An observed trap reports its reason at its site before trapping (event 6, TERM-008).
    Terminator.Trap {reason, origin} => {
      let report = run trapReport(&writer.*, function, target, origin)
      writer.trap = move report
      run reportTrap(&mut writer.*, Mir.trapReasonText(reason))
      writer.trap = Option<TrapReport>.none()
      run trapHere(&mut writer.*)
    }
    // The source's reason is a `string<'static>` descriptor in memory, which the fatal dispatch
    // helper reads as it reads a constant reason (event 6, TERM-008).
    Terminator.TrapText {reason, origin} => {
      let text = run emitOperand(&mut writer.*, function, target, layouts, &reason)
      if !text.scalar.aggregate {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.relative(GapCode.TypedForm, &owner, origin.location)
      }
      let report = run trapReport(&writer.*, function, target, origin)
      writer.trap = move report
      // A source trap is a violated precondition of the package's API, so it reports at the call
      // that entered the package (TERM-008).
      let mut entry = Bitcode.none()
      let site = diagnosticLocal(function, 2)
      if site != usize.MAX { entry = slotOf(&writer.*, site) }
      run reportTrapDescriptor(&mut writer.*, text.value, entry)
      writer.trap = Option<TrapReport>.none()
      run trapHere(&mut writer.*)
    }
    // An instance that relinquishes is a suspension origin, so the build emits it again with its
    // frames; only the walk that selects the suspendable set emits it without them.
    Terminator.Relinquish {..} => match &suspended.* {
      Option<Suspended>.Some {value: stepping} => run emitRelinquish(&mut writer.*, target, &stepping, Coroutine.stateAfter(&stepping.coroutine, index))
      Option<Suspended>.None => run trapHere(&mut writer.*)
    }
    // A cancelled frame's exit releases it without writing a result; its caller cancels next.
    Terminator.Abandon {..} => match &suspended.* {
      Option<Suspended>.Some {value: stepping} => run emitPop(&mut writer.*, target, &stepping, Option<bool>.none())
      Option<Suspended>.None => run trapHere(&mut writer.*)
    }
    Terminator.Unreachable {origin: _} => run Module.unreachable(&mut writer.*.module)
    Terminator.Switch {value, cases, otherwise, origin: _} => {
      let tested = run emitOperand(&mut writer.*, function, target, layouts, &value)
      if writer.fastPath {
        return run compareChain(&mut writer.*, &tested, List<SwitchCase>.asSlice(&cases), otherwise, index)
      }
      let selected = List<SwitchCase>.asSlice(&cases)
      if index < List<bool>.length(&writer.threaded) && List<bool>.get(&writer.threaded, index) {
        return run emitThreadedSwitch(&mut writer.*, &tested, selected, otherwise)
      }
      let mut table = List<u64>.make()
      let mut caseAt = usize.ZERO
      while caseAt < selected.length {
        let matched = run intOf(&mut writer.*, tested.scalar, decimalBits(Bytes.asSlice(&selected[caseAt].decimal), selected[caseAt].negative))
        run List<u64>.append(&mut table, matched)
        run List<u64>.append(&mut table, blockAt(&writer.*, selected[caseAt].target))
        caseAt = caseAt + usize.ONE
      }
      let fallback = blockAt(&writer.*, otherwise)
      run Module.switch(&mut writer.*.module, tested.value, fallback, List<u64>.asSlice(&table))
    }
  }
  return ()
}

// Threaded dispatch: a large switch inside a loop, such as a bytecode interpreter's, loads its
// target from a table of block addresses and branches there with `indirectbr`. LLVM copies an
// indirect branch's block into each predecessor (as it does for a computed `goto`), so every arm
// dispatches the next case itself instead of jumping back to one shared jump-table branch, which
// saves the jump and lets the branch predictor learn from each arm. A function with an `indirectbr`
// is never inlined, so only switches with many cases inside a loop qualify.
fn threadedMinimumCases() -> usize { return 64 }
fn threadedMaximumValue() -> u64 { return 4096 }

// Per MIR block, whether its switch qualifies for threaded dispatch: at least
// `threadedMinimumCases` cases with distinct targets, every case value in `0..threadedMaximumValue`
// of an integer of at most 64 bits, no target the entry block, and a case that reaches the switch again.
effect fn threadedSwitches(function: &MirFunction, target: &Target) -> List<bool> ! OutOfMemoryError ? &mut Allocator {
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut result = List<bool>.make()
  let wasm = same(Target.objectFormat(target), b"wasm")
  let mut at = usize.ZERO
  while at < blocks.length {
    let mut qualifies = false
    if let Terminator.Switch {cases, otherwise, ..} = &blocks[at].terminator {
      let selected = List<SwitchCase>.asSlice(&cases)
      qualifies = !wasm && selected.length >= threadedMinimumCases() && otherwise != usize.ZERO
      let mut seen = List<bool>.make()
      run List<bool>.appendRepeated(&mut seen, false, blocks.length)
      let mut distinct = usize.ZERO
      let mut caseAt = usize.ZERO
      while qualifies && caseAt < selected.length {
        let value = decimalBits(Bytes.asSlice(&selected[caseAt].decimal), false)
        if selected[caseAt].negative || value >= threadedMaximumValue() || selected[caseAt].target == usize.ZERO {
          qualifies = false
        } else if !List<bool>.get(&seen, selected[caseAt].target) {
          List<bool>.set(&mut seen, selected[caseAt].target, true)
          distinct = distinct + usize.ONE
        }
        caseAt = caseAt + usize.ONE
      }
      if qualifies && distinct < threadedMinimumCases() { qualifies = false }
      if qualifies { qualifies = run reachesAgain(function, at) }
    }
    run List<bool>.append(&mut result, qualifies)
    at = at + usize.ONE
  }
  return move result
}

// Whether some successor of block `start` leads back to it.
effect fn reachesAgain(function: &MirFunction, start: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
  let count = List<Block>.length(&function.blocks)
  let mut visited = List<bool>.make()
  run List<bool>.appendRepeated(&mut visited, false, count)
  let mut pending = run MirFunction.successors(function, start)
  while List<usize>.length(&pending) > usize.ZERO {
    let block = match List<usize>.pop(&mut pending) {
      Option<usize>.Some {value} => value
      Option<usize>.None => { break }
    }
    if block == start { return true }
    if !List<bool>.get(&visited, block) {
      List<bool>.set(&mut visited, block, true)
      let next = run MirFunction.successors(function, block)
      run List<usize>.appendSlice(&mut pending, List<usize>.asSlice(&next))
    }
  }
  return false
}

// The threaded form of a qualifying switch (`threadedSwitches`): values past the table go to
// `otherwise`, the rest load their block's address from the table and branch to it.
effect fn emitThreadedSwitch(writer: &mut Writer, tested: &Value, cases: &[SwitchCase], otherwise: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let fallback = blockAt(&writer.*, otherwise)
  let mut highest: u64 = 0
  let mut at = usize.ZERO
  while at < cases.length {
    let value = decimalBits(Bytes.asSlice(&cases[at].decimal), false)
    if value > highest { highest = value }
    at = at + usize.ONE
  }
  let span = u64.toUsize(highest) + usize.ONE
  let mut slots = List<u64>.make()
  run List<u64>.appendRepeated(&mut slots, fallback, span)
  let mut targets = List<u64>.make()
  run List<u64>.append(&mut targets, fallback)
  at = usize.ZERO
  while at < cases.length {
    let block = blockAt(&writer.*, cases[at].target)
    List<u64>.set(&mut slots, u64.toUsize(decimalBits(Bytes.asSlice(&cases[at].decimal), false)), block)
    if !listed(List<u64>.asSlice(&targets), block) { run List<u64>.append(&mut targets, block) }
    at = at + usize.ONE
  }
  let word = integerRepresentation(64, false)
  let mut position = tested.*
  if tested.scalar.bits < 64 { position = run castOf(&mut writer.*, Bitcode.castZExt(), tested, word) }
  // An unsigned value whose every value has a slot needs no range check.
  let covered = !tested.scalar.signed && tested.scalar.bits < 64 && span == u64.toUsize(u64.shiftLeft(1, usize.toU64(tested.scalar.bits)))
  if !covered {
    let inside = run compareWith(&mut writer.*, Bitcode.intUlt(), word, position.value, usize.toU64(span))
    let dispatch = run Module.newBlock(&mut writer.*.module, 0)
    run branchIf(&mut writer.*, inside, dispatch, fallback)
    Module.startBlock(&mut writer.*.module, dispatch)
  }
  let pointer = run pointerType(&mut writer.*)
  let ty = run Module.array(&mut writer.*.module, span, pointer)
  let mut name = run Bytes.copy(Bytes.asSlice(&writer.symbol))
  run Bytes.append(&mut name, b".dispatch.")
  run appendDecimal(&mut name, usize.toU64(Module.fresh(&mut writer.*.module)))
  let table = run Module.objectRef(&mut writer.*.module, Bytes.asSlice(&name), ty)
  let indices = [position.value]
  let slot = run Module.gep(&mut writer.*.module, 0, pointer, table, &indices)
  let alignment = writer.pointerBits / 8
  let address = run loadPointer(&mut writer.*, slot, alignment)
  run Module.indirectBranch(&mut writer.*.module, address, List<u64>.asSlice(&targets))
  run List<JumpTable>.append(&mut writer.*.tables, JumpTable {name: move name, ty: ty, slots: move slots})
  return ()
}

fn listed(values: &[u64], value: u64) -> bool {
  let mut at = usize.ZERO
  while at < values.length {
    if values[at] == value { return true }
    at = at + usize.ONE
  }
  return false
}

// Defines the tables of the function just built, `function` of type `functionType`, now that its
// blocks have positions.
effect fn defineTables(writer: &mut Writer, functionType: u64, function: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut tables = List<JumpTable>.make()
  let pending = Intrinsic.replace(writer.*.tables, move tables)
  let listed = List<JumpTable>.asSlice(&pending)
  let mut at = usize.ZERO
  while at < listed.length {
    let handles = List<u64>.asSlice(&listed[at].slots)
    let mut addresses = List<u64>.make()
    let mut slot = usize.ZERO
    while slot < handles.length {
      let position = writer.*.module.blockPosition(handles[slot])
      run List<u64>.append(&mut addresses, run Module.blockAddress(&mut writer.*.module, functionType, function, position))
      slot = slot + usize.ONE
    }
    let initializer = run Module.aggregate(&mut writer.*.module, listed[at].ty, List<u64>.asSlice(&addresses))
    let global = run Module.defineObject(&mut writer.*.module, Bytes.asSlice(&listed[at].name), listed[at].ty, Bitcode.linkPrivate(), true, initializer)
    Module.setUnnamed(&mut writer.*.module, global, 1)
    at = at + usize.ONE
  }
  drop pending
  return ()
}

// A switch as one compare and branch per case, in case order: block `b<block>`'s case `n` after
// the first is tested in its own block `b<block>.<n>`.
effect fn compareChain(writer: &mut Writer, tested: &Value, cases: &[SwitchCase], otherwise: usize, block: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let fallback = blockAt(&writer.*, otherwise)
  if cases.length == usize.ZERO { return run branch(&mut writer.*, fallback) }
  // The fast selector has no `i1` comparison, so a flag is compared as a byte.
  let mut compared = tested.*
  let flag = compared.scalar.bits == usize.ONE && compared.scalar.lanes == usize.ZERO
  if flag {
    let mut byte = compared.scalar
    byte.bits = 8
    compared = run castOf(&mut writer.*, Bitcode.castZExt(), tested, byte)
  }
  let mut next = Bitcode.none()
  let mut at = usize.ZERO
  while at < cases.length {
    if at > usize.ZERO { startBlock(&mut writer.*, next) }
    // An `i1` case of -1 or 1 is the set flag.
    let mut bits = decimalBits(Bytes.asSlice(&cases[at].decimal), cases[at].negative)
    if flag && !same(Bytes.asSlice(&cases[at].decimal), b"0") { bits = 1 }
    let equal = run compareWith(&mut writer.*, Bitcode.intEq(), compared.scalar, compared.value, bits)
    let mut otherwiseBlock = fallback
    if at + usize.ONE < cases.length {
      next = run Module.newBlock(&mut writer.*.module, Bitcode.named2(Bitcode.prefixBlock(), block, at + usize.ONE))
      otherwiseBlock = next
    }
    let matched = blockAt(&writer.*, cases[at].target)
    run branchIf(&mut writer.*, equal, matched, otherwiseBlock)
    at = at + usize.ONE
  }
}

/// Emits the entry-block stack slots for every local and spills each parameter into its slot.
effect fn emitEntrySlots(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  foreign: &[CAbi.Signature],
) -> () ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  run emitSlots(&mut writer.*, function, target, layouts, &Option<Suspended>.none())
  run emitCCopySlots(&mut writer.*, function, target, layouts, foreign)
  if !writer.fastPath { run emitDropCopySlots(&mut writer.*, function, target, layouts) }
  let locals = List<Local>.asSlice(&function.locals)
  let parameters = List<Shared<Type>>.asSlice(&function.parameters)
  let mut cParameters = List<CAbi.Lane>.make()
  if cExport(function) {
    let result = run classifiedLane(function, target, layouts, &function.result, locals[usize.ZERO].origin.location, true)
    cParameters = run classifiedParameters(function, target, layouts, parameters, &result, locals[usize.ZERO].origin.location)
  }
  let mut local = usize.ZERO
  while local < parameters.length {
    let parameterLayout = run layoutOf(layouts, &parameters[local], function,
      locals[local + usize.ONE].origin.location)
    let kind = storageRepresentation(&parameters[local], target, parameterLayout)
    let input = List<u64>.get(&writer.parameters, local)
    let slot = slotOf(&writer.*, local + usize.ONE)
    if cExport(function) {
      let classified = List<CAbi.Lane>.asSlice(&cParameters)
      let lane = &classified[local]
      if lane.passing == CPassing.Ignore { local = local + usize.ONE continue }
      if lane.passing == CPassing.Indirect {
        run copyBytes(&mut writer.*, slot, input, lane.layout.size)
        local = local + usize.ONE
        continue
      }
      if lane.passing == CPassing.Coerce {
        if lane.grouped || cParameterCount(lane) == usize.ONE {
          run writeCRecord(&mut writer.*, lane, input, slot)
        } else {
          let parts = List<CPiece>.asSlice(&lane.pieces)
          let mut at = usize.ZERO
          while at < parts.length {
            run storeCPiece(&mut writer.*, lane, parts[at], Bitcode.local(Bitcode.referenceIndex(input) + at), slot)
            at = at + usize.ONE
          }
        }
        local = local + usize.ONE
        continue
      }
    }
    let span = locals[local + usize.ONE].origin.location
    let mut unwrapped = Option<Shared<Type>>.none()
    if !cExport(function) { unwrapped = run unwrappedParameter(layouts, &parameters[local], parameterLayout, function, span) }
    if let Option<Shared<Type>>.Some {value: field} = move unwrapped {
      let lane = run unwrappedLane(layouts, &field, target, function, span)
      let address = Address {ty: move field, value: slot, alignment: parameterLayout.alignment, representation: lane}
      run storeValue(&mut writer.*, &address, &Value {scalar: lane, value: input})
      local = local + usize.ONE
      continue
    }
    if let Option<usize>.Some {..} = ownedParameter(function, &locals[local + usize.ONE], parameterLayout, kind) {
      local = local + usize.ONE
      continue
    }
    let address = Address {ty: Shared<Type>.clone(&parameters[local]), value: slot,
      alignment: parameterLayout.alignment, representation: kind}
    run storeCopy(&mut writer.*, &address, &Value {scalar: kind, value: input}, true)
    local = local + usize.ONE
  }
  return run emitHiddenStores(&mut writer.*, function)
}

/// Emits one storage address per local: a stack slot, or for a suspended step the frame slot of a
/// frame-resident local. Then each failure slot's context companion.
effect fn emitSlots(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  suspended: &Option<Suspended>,
) -> () ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let locals = List<Local>.asSlice(&function.locals)
  let frame = writer.frame
  let mut local = usize.ZERO
  while local < locals.length {
    let mut resident = usize.MAX
    if let Option<Suspended>.Some {value: stepping} = &suspended.* {
      resident = Coroutine.residentAt(&stepping.coroutine, local)
    }
    let mut slot = Bitcode.none()
    let mut named = true
    if resident != usize.MAX {
      slot = run byteOffset(&mut writer.*, frame, resident)
    } else {
      let localLayout = run layoutOf(
        layouts,
        &locals[local].ty,
        function,
        locals[local].origin.location,
      )
      let kind = storageRepresentation(&locals[local].ty, target, localLayout)
      let mut owned = usize.MAX
      let mut outward = false
      if let Option<Suspended>.None = &suspended.* {
        if let Option<usize>.Some {value: index} = ownedParameter(function, &locals[local], localLayout, kind) {
          let unwrapped = run unwrappedParameter(layouts, &locals[local].ty, localLayout, function, locals[local].origin.location)
          if let Option<Shared<Type>>.None = &unwrapped { owned = index }
        }
        outward = local == usize.ZERO && writer.out != Bitcode.none() && resultInOut(function, kind)
      }
      if owned != usize.MAX {
        // The caller's storage is the slot itself.
        slot = List<u64>.get(&writer.parameters, owned)
        named = false
      } else if outward {
        // The result is built in the caller's out-slot.
        slot = writer.out
        named = false
      } else {
        let mut ty = run integerType(&mut writer.*, 8)
        if !kind.unit { ty = run typeOf(&mut writer.*, kind) }
        slot = run Module.alloca(&mut writer.*.module, ty, usize.toU64(localLayout.alignment))
      }
    }
    if named {
      Module.setName(&mut writer.*.module, slot, Bitcode.named(Bitcode.prefixLocal(), local))
    }
    run List<u64>.append(&mut writer.*.slots, slot)
    run List<u64>.append(&mut writer.*.companions, Bitcode.none())
    local = local + usize.ONE
  }
  // Every failure slot except `Failure` owns a fixed-size context companion; `Failure`'s is the
  // caller's `%context` (failure observer note N3). A step keeps every companion in its frame.
  let companions = run companionLocals(function)
  let owned = List<usize>.asSlice(&companions)
  let word = u32.toUsize(Target.pointerBits(target)) / 8
  let mut companionAt = usize.ZERO
  while companionAt < owned.length {
    let mut address = Bitcode.none()
    if let Option<Suspended>.Some {value: stepping} = &suspended.* {
      address = run byteOffset(&mut writer.*, frame, Coroutine.companionAt(&stepping.coroutine, owned[companionAt]))
    } else {
      let wordTy = run integerType(&mut writer.*, word * 8)
      let ty = run Module.array(&mut writer.*.module, companionWords(), wordTy)
      address = run Module.alloca(&mut writer.*.module, ty, usize.toU64(word))
    }
    Module.setName(&mut writer.*.module, address, Bitcode.named(Bitcode.prefixCompanion(), owned[companionAt]))
    List<u64>.set(&mut writer.*.companions, owned[companionAt], address)
    companionAt = companionAt + usize.ONE
  }
  return ()
}

/// Stores the hidden provider, observer and cause addresses into their locals.
effect fn emitHiddenStores(writer: &mut Writer, function: &MirFunction) -> () ! OutOfMemoryError ? &mut Allocator {
  // Each hidden provider address lands in its `Provider` local.
  let mut provider = usize.ZERO
  while providerLocalAt(function, provider) != usize.MAX {
    let slot = slotOf(&writer.*, providerLocalAt(function, provider))
    let address = List<u64>.get(&writer.providers, provider)
    run storeOf(&mut writer.*, address, slot, usize.ZERO)
    provider = provider + usize.ONE
  }
  return run emitDiagnosticStores(&mut writer.*, function)
}

/// Stores an observed function's observer, selected-cause and entry-site addresses into their locals
/// (N1, N2). A resumed frame stores them again: a trap reads them, which liveness does not see.
effect fn emitDiagnosticStores(writer: &mut Writer, function: &MirFunction) -> () ! OutOfMemoryError ? &mut Allocator {
  let observer = diagnosticLocal(function, usize.ZERO)
  if observer != usize.MAX {
    let hidden = [writer.observer, writer.cause, writer.site]
    let slots = [slotOf(&writer.*, observer), slotOf(&writer.*, diagnosticLocal(function, usize.ONE)),
      slotOf(&writer.*, diagnosticLocal(function, 2))]
    let mut at = usize.ZERO
    while at < 3 {
      run storeOf(&mut writer.*, hidden[at], slots[at], usize.ZERO)
      at = at + usize.ONE
    }
  }
  return ()
}

// The parameter list of a function being defined: each lane's type and name, and the attribute
// encodings of the lanes that carry any.
struct Signature {
  types: List<u64>,
  names: List<u64>,
  /// `[position, length, encoding...]` runs.
  attributes: List<u64>,
}

fn signature() -> Signature {
  return Signature {types: List<u64>.make(), names: List<u64>.make(), attributes: List<u64>.make()}
}

// Adds one parameter of `ty` named `name`; answers its argument.
effect fn addParameter(signature: &mut Signature, ty: u64, name: u64) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let index = List<u64>.length(&signature.types)
  run List<u64>.append(&mut signature.*.types, ty)
  run List<u64>.append(&mut signature.*.names, name)
  return Bitcode.local(index)
}

// Records the attribute `encoding` at `position`.
effect fn addAttributes(signature: &mut Signature, position: u64, encoding: &[u64]) -> () ! OutOfMemoryError ? &mut Allocator {
  if encoding.length == usize.ZERO { return () }
  run List<u64>.append(&mut signature.*.attributes, position)
  run List<u64>.append(&mut signature.*.attributes, usize.toU64(encoding.length))
  let mut at = usize.ZERO
  while at < encoding.length {
    run List<u64>.append(&mut signature.*.attributes, encoding[at])
    at = at + usize.ONE
  }
  return ()
}

// The recorded attributes as one list operand.
effect fn attributeList(writer: &mut Writer, signature: &Signature) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let words = List<u64>.asSlice(&signature.attributes)
  Module.beginAttributes(&mut writer.*.module)
  let mut at = usize.ZERO
  while at < words.length {
    let length = u64.toUsize(words[at + usize.ONE])
    let mut encoding = List<u64>.make()
    let mut item = usize.ZERO
    while item < length {
      run List<u64>.append(&mut encoding, words[at + 2 + item])
      item = item + usize.ONE
    }
    run Module.attributeGroup(&mut writer.*.module, words[at], List<u64>.asSlice(&encoding))
    at = at + 2 + length
  }
  return run Module.endAttributes(&mut writer.*.module)
}

// Appends the string attribute `key`=`value` to `encoding`.
effect fn appendStringAttribute(encoding: &mut List<u64>, key: &[u8], value: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<u64>.append(&mut encoding.*, 4)
  let mut at = usize.ZERO
  while at < key.length {
    run List<u64>.append(&mut encoding.*, u8.toU64(key[at]))
    at = at + usize.ONE
  }
  run List<u64>.append(&mut encoding.*, 0)
  at = usize.ZERO
  while at < value.length {
    run List<u64>.append(&mut encoding.*, u8.toU64(value[at]))
    at = at + usize.ONE
  }
  return run List<u64>.append(&mut encoding.*, 0)
}

// The attribute kind of an inline clause's attribute spelling (FUNC-003), or zero for none.
fn inliningKind(spelled: &[u8]) -> u64 {
  if same(spelled, b"inlinehint") { return Bitcode.attrInlineHint() }
  if same(spelled, b"alwaysinline") { return Bitcode.attrAlwaysInline() }
  if same(spelled, b"noinline") { return Bitcode.attrNoInline() }
  if same(spelled, b"cold") { return Bitcode.attrCold() }
  return 0
}

// Adds a foreign guard's function attributes, `noinline nounwind`, to `signature`.
effect fn guardAttributes(encoding: &mut List<u64>) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<u64>.append(&mut encoding.*, 0)
  run List<u64>.append(&mut encoding.*, Bitcode.attrNoInline())
  run List<u64>.append(&mut encoding.*, 0)
  return run List<u64>.append(&mut encoding.*, Bitcode.attrNoUnwind())
}

// Gives the function being defined the foreign personality.
effect fn guard(writer: &mut Writer, defined: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let int32 = run integerType(&mut writer.*, 32)
  let int64 = run integerType(&mut writer.*, 64)
  let pointer = run pointerType(&mut writer.*)
  let parameters = [int32, int32, int64, pointer, pointer]
  let ty = run functionType(&mut writer.*, int32, &parameters)
  let personality = run Module.functionRef(&mut writer.*.module, b"__silk_foreign_personality", ty)
  return Module.setPersonality(&mut writer.*.module, defined, personality)
}

// Starts the body of `defined`, whose arguments `signature` lists.
effect fn beginFunction(writer: &mut Writer, defined: u64, signature: &Signature) -> () ! OutOfMemoryError ? &mut Allocator {
  return run Module.beginBody(&mut writer.*.module, defined, List<u64>.asSlice(&signature.types), List<u64>.asSlice(&signature.names))
}

// The hidden parameter name `text`.
fn hiddenName(text: &[u8]) -> u64 {
  return Bitcode.plain(Bitcode.prefix(text))
}

/// Emits one definition as a fragment; a codegen unit merges complete fragments into one module.
///
/// A gap's span counts from the anchor of the instance's declaration, like the MIR origins it
/// comes from; the caller positions it in the current source.
///
/// A suspendable instance's `suspension` facts make its ordinary symbol a driver and add its
/// `$enter` and `$step` definitions (`backend.Coroutine`).
pub effect fn emit(
  function: &MirFunction,
  target: &Target,
  supplied: &[TypeLayout],
  foreign: &[CAbi.Signature],
  identities: &[InstanceIdentity],
  suspension: &Option<Facts>,
  fastPath: bool,
) -> Bytes ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  // The lookup index lives only while this instance's code is built.
  let indexed = run TypeLayouts.copyOf(supplied)
  let layouts = &indexed
  let mut writer = run writerFor(target, fastPath)
  let locals = List<Local>.asSlice(&function.locals)
  let resultFacts = run layoutOf(layouts, &function.result, function, locals[usize.ZERO].origin.location)
  let result = storageRepresentation(&function.result, target, resultFacts)
  let parameters = List<Shared<Type>>.asSlice(&function.parameters)
  let fallible = failureLocal(function) != usize.MAX
  // A C export shim keeps its requested linkage name and the C narrow-integer extension rules.
  let exported = match &function.key {
    InstanceKey.Export {..} => true
    _ => false
  }
  let mut cResult = Option<CAbi.Lane>.none()
  let mut cParameters = List<CAbi.Lane>.make()
  if exported {
    let returned = run classifiedLane(function, target, layouts, &function.result, locals[usize.ZERO].origin.location, true)
    cParameters = run classifiedParameters(function, target, layouts, parameters, &returned, locals[usize.ZERO].origin.location)
    cResult = Option<CAbi.Lane>.some(move returned)
  }
  let pointer = run pointerType(&mut writer)
  let mut lanes = signature()
  let mut resultType = run voidType(&mut writer)
  let mut outward = result.aggregate || passedIndirectly(result)
  if let Option<CAbi.Lane>.Some {value: returned} = &cResult {
    outward = returned.passing == CPassing.Indirect
    let owner = InstanceKey.identity(&function.key)
    resultType = run cLaneType(&mut writer, &returned, &owner, &GapSource.Relative {
      declaration: InstanceKey.identity(&function.key), location: locals[usize.ZERO].origin.location})
    let mut encoding = List<u64>.make()
    run appendExtension(&mut encoding, returned.extension)
    run addAttributes(&mut lanes, Bitcode.positionResult(), List<u64>.asSlice(&encoding))
  } else if fallible {
    resultType = run integerType(&mut writer, usize.ONE)
    if fastPath { run addAttributes(&mut lanes, Bitcode.positionResult(), &[0, Bitcode.attrZeroExt()]) }
  } else if !outward {
    resultType = run typeOf(&mut writer, result)
    if extendedFlag(&writer, result) { run addAttributes(&mut lanes, Bitcode.positionResult(), &[0, Bitcode.attrZeroExt()]) }
  }
  let symbol = run InstanceIdentity.name(identities, &function.key)
  writer.symbol = move symbol
  let leadingOutput = outward && !fallible
  if leadingOutput {
    if let Option<CAbi.Lane>.Some {value: returned} = &cResult {
      let encoding = run cSretEncoding(&mut writer, &returned)
      run addAttributes(&mut lanes, 1, List<u64>.asSlice(&encoding))
    } else {
      // The caller's destination is a fresh temporary (`resultInOut`).
      let encoding: [u64; 2] = [0, Bitcode.attrNoAlias()]
      run addAttributes(&mut lanes, 1, &encoding)
    }
    writer.out = run addParameter(&mut lanes, pointer, hiddenName(b"out"))
  }
  let mut at = usize.ZERO
  while at < parameters.length {
    if exported {
      let classified = List<CAbi.Lane>.asSlice(&cParameters)
      let lane = &classified[at]
      let mut first = Bitcode.none()
      let mut part = usize.ZERO
      while part < cParameterCount(lane) {
        let position = usize.toU64(List<u64>.length(&lanes.types)) + 1
        let encoding = run cParameterEncoding(&mut writer, lane)
        run addAttributes(&mut lanes, position, List<u64>.asSlice(&encoding))
        let ty = run cParameterType(&mut writer, lane, part)
        let mut name = Bitcode.named(Bitcode.prefixParameter(), at)
        if cParameterCount(lane) > usize.ONE { name = Bitcode.named2(Bitcode.prefixParameter(), at, part) }
        let added = run addParameter(&mut lanes, ty, name)
        if part == usize.ZERO { first = added }
        part = part + usize.ONE
      }
      run List<u64>.append(&mut writer.parameters, first)
    } else {
      let facts = run layoutOf(layouts, &parameters[at], function, locals[at + usize.ONE].origin.location)
      let lane = storageRepresentation(&parameters[at], target, facts)
      if !lane.unit {
        let mut ty = pointer
        if facts.abi != Abi.Indirect && !passedIndirectly(lane) { ty = run typeOf(&mut writer, lane) }
        let span = locals[at + usize.ONE].origin.location
        let unwrapped = run unwrappedParameter(layouts, &parameters[at], facts, function, span)
        if let Option<Shared<Type>>.Some {value: field} = &unwrapped {
          ty = run typeOf(&mut writer, run unwrappedLane(layouts, &field, target, function, span))
        } else if exclusiveParameter(facts, lane) {
          let position = usize.toU64(List<u64>.length(&lanes.types)) + 1
          let encoding: [u64; 2] = [0, Bitcode.attrNoAlias()]
          run addAttributes(&mut lanes, position, &encoding)
        }
        run List<u64>.append(&mut writer.parameters, run addParameter(&mut lanes, ty, Bitcode.named(Bitcode.prefixParameter(), at)))
      } else {
        run List<u64>.append(&mut writer.parameters, Bitcode.none())
      }
    }
    at = at + usize.ONE
  }
  // Hidden provider addresses follow the written parameters (D2).
  let mut providerCount = usize.ZERO
  while providerLocalAt(function, providerCount) != usize.MAX {
    run List<u64>.append(&mut writer.providers, run addParameter(&mut lanes, pointer, Bitcode.named(Bitcode.prefixHidden(), providerCount)))
    providerCount = providerCount + usize.ONE
  }
  let observed = diagnosticLocal(function, usize.ZERO) != usize.MAX
  if observed {
    writer.observer = run addParameter(&mut lanes, pointer, hiddenName(b"observer"))
    writer.cause = run addParameter(&mut lanes, pointer, hiddenName(b"cause"))
    writer.site = run addParameter(&mut lanes, pointer, hiddenName(b"site"))
  }
  if fallible {
    if !exported {
      let outPosition = usize.toU64(List<u64>.length(&lanes.types)) + 1
      let outEncoding: [u64; 2] = [0, Bitcode.attrNoAlias()]
      run addAttributes(&mut lanes, outPosition, &outEncoding)
    }
    writer.out = run addParameter(&mut lanes, pointer, hiddenName(b"out"))
    writer.failure = run addParameter(&mut lanes, pointer, hiddenName(b"fail"))
    if observed { writer.context = run addParameter(&mut lanes, pointer, hiddenName(b"context")) }
  }
  let mut functionAttributes = List<u64>.make()
  // A WebAssembly module exports exactly the C exports source names, under their symbols. `main`
  // is the exception: the wasm backend renames a `main` without arguments and defines `main` as a
  // wrapper, so the attribute would export both; the final link exports the wrapper instead.
  if exported && same(Target.objectFormat(target), b"wasm") && !same(Bytes.asSlice(&writer.symbol), b"main") {
    run appendStringAttribute(&mut functionAttributes, b"wasm-export-name", Bytes.asSlice(&writer.symbol))
  }
  // A function written with `features` compiles for them; LLVM inlines callees compiled for fewer
  // features into it, never the reverse (SIMD-009).
  if Bytes.length(&function.features) > usize.ZERO {
    run appendStringAttribute(&mut functionAttributes, b"target-features", Bytes.asSlice(&function.features))
  }
  // A function written with an inline clause asks for it (FUNC-003); a foreign guard never has one.
  // Drop glue is left to the optimizer's own choice, so a value whose drop is a tag check inlines it.
  let guarded = foreignGuard(function)
  let inlining = inliningKind(Mir.inliningAttribute(function.inlining))
  if guarded { run guardAttributes(&mut functionAttributes) }
  else if inlining != 0 {
    run List<u64>.append(&mut functionAttributes, 0)
    run List<u64>.append(&mut functionAttributes, inlining)
    // A cold function also stays out of line, so its callers keep only the call on a path LLVM
    // now weighs as rarely taken.
    if inlining == Bitcode.attrCold() {
      run List<u64>.append(&mut functionAttributes, 0)
      run List<u64>.append(&mut functionAttributes, Bitcode.attrNoInline())
    }
  }
  run addAttributes(&mut lanes, Bitcode.positionFunction(), List<u64>.asSlice(&functionAttributes))
  let functionTy = run functionType(&mut writer, resultType, List<u64>.asSlice(&lanes.types))
  let attributes = run attributeList(&mut writer, &lanes)
  let defined = run Module.defineFunction(&mut writer.module, Bytes.asSlice(&writer.symbol), functionTy, Bitcode.linkExternal(), attributes)
  if guarded { run guard(&mut writer, defined) }
  if let Option<Facts>.Some {value: facts} = &suspension.* {
    let suspended = Option<Suspended>.some(
      Suspended {facts: run Facts.copy(&facts), coroutine: run planFrame(function, target, layouts, &facts)},
    )
    let base = run Bytes.copy(Bytes.asSlice(&writer.symbol))
    if let Option<Suspended>.Some {value: stepping} = &suspended {
      run beginFunction(&mut writer, defined, &lanes)
      run emitDriver(&mut writer, function, target, layouts, &stepping, Bytes.asSlice(&base))
      run Module.endBody(&mut writer.module)
      resetFunction(&mut writer)
      run emitEnter(&mut writer, function, target, layouts, &stepping, Bytes.asSlice(&base))
      resetFunction(&mut writer)
      run emitStep(&mut writer, function, target, layouts, foreign, identities, &suspended, &stepping, Bytes.asSlice(&base))
    }
    return run Module.serialize(&writer.module)
  }
  run beginFunction(&mut writer, defined, &lanes)
  let ordinary = Option<Suspended>.none()
  let blocks = List<Block>.asSlice(&function.blocks)
  // An unoptimized compile never reads lifetime markers, so a fast-path function plans none.
  let mut lifetimes = StackLifetimes.Markers {blocks: List<BlockMarkers>.make()}
  if !fastPath { lifetimes = run StackLifetimes.plan(function) }
  let companions = run companionLocals(function)
  run addBlocks(&mut writer, blocks.length)
  if !fastPath { writer.threaded = run threadedSwitches(function, target) }
  at = usize.ZERO
  while at < blocks.length {
    let handle = blockAt(&writer, at)
    startBlock(&mut writer, handle)
    if at == usize.ZERO {
      run emitEntrySlots(&mut writer, function, target, layouts, foreign)
    }
    run emitBlock(&mut writer, function, target, layouts, &blocks[at], foreign, identities, &ordinary, at,
      List<BlockMarkers>.asSlice(&lifetimes.blocks), List<usize>.asSlice(&companions))
    at = at + usize.ONE
  }
  run Module.endBody(&mut writer.module)
  run defineTables(&mut writer, functionTy, defined)
  return run Module.serialize(&writer.module)
}

// Makes the handles of `count` MIR blocks, named `b<i>`.
effect fn addBlocks(writer: &mut Writer, count: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < count {
    run List<u64>.append(&mut writer.*.blocks, run Module.newBlock(&mut writer.*.module, Bitcode.named(Bitcode.prefixBlock(), at)))
    at = at + usize.ONE
  }
  return ()
}

struct Suspended {
  facts: Facts,
  coroutine: Coroutine,
}

fn wordSize(target: &Target) -> usize {
  return u32.toUsize(Target.pointerBits(target)) / 8
}

effect fn planFrame(function: &MirFunction, target: &Target, layouts: &TypeLayouts, facts: &Facts) -> Coroutine
! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let locals = List<Local>.asSlice(&function.locals)
  let mut extents = List<Extent>.make()
  let mut local = usize.ZERO
  while local < locals.length {
    let metrics = run layoutOf(layouts, &locals[local].ty, function, locals[local].origin.location)
    let kind = storageRepresentation(&locals[local].ty, target, metrics)
    let mut size = metrics.size
    if kind.unit { size = usize.ZERO }
    let mut alignment = metrics.alignment
    if alignment == usize.ZERO { alignment = usize.ONE }
    run List<Extent>.append(&mut extents, Extent {size: size, alignment: alignment})
    local = local + usize.ONE
  }
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut suspending = List<bool>.make()
  let mut points = List<bool>.make()
  let mut block = usize.ZERO
  while block < blocks.length {
    let mut suspends = false
    if let Terminator.Call {callee, ..} = &blocks[block].terminator {
      if let Callee.Instance {key} = &callee { suspends = run Facts.suspends(facts, &key) }
    }
    if let Terminator.Relinquish {..} = &blocks[block].terminator { suspends = true }
    run List<bool>.append(&mut suspending, suspends)
    // A cancel landing runs its nonparking cleanup to completion through an ordinary driver
    // call. It records no cancel exit and must not push that call onto the destroyed package.
    run List<bool>.append(&mut points, suspends && Coroutine.cancelAfter(function, block) != usize.MAX)
    block = block + usize.ONE
  }
  run requireCancelExits(function, List<bool>.asSlice(&suspending))
  let mut providers = usize.ZERO
  while providerLocalAt(function, providers) != usize.MAX { providers = providers + usize.ONE }
  let companions = run companionLocals(function)
  return run Coroutine.plan(function, List<Extent>.asSlice(&extents), List<bool>.asSlice(&points), providers,
    List<usize>.asSlice(&companions), wordSize(target))
}

// `<symbol><suffix>`, such as a definition's `$enter` symbol.
effect fn suffixed(symbol: &[u8], suffix: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut name = run Bytes.copy(symbol)
  run Bytes.append(&mut name, suffix)
  return move name
}

// Copies `size` bytes; frame states and stack slots never overlap.
effect fn copyBytes(writer: &mut Writer, destination: u64, source: u64, size: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  return run copyCall(&mut writer.*, destination, usize.ZERO, source, size, true)
}

effect fn storeWordAt(writer: &mut Writer, value: u64, base: u64, offset: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let address = run byteOffset(&mut writer.*, base, offset)
  return run storeOf(&mut writer.*, value, address, usize.ZERO)
}

effect fn loadWordAt(writer: &mut Writer, base: u64, offset: usize) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let address = run byteOffset(&mut writer.*, base, offset)
  return run loadPointer(&mut writer.*, address, usize.ZERO)
}

// Loads one hidden caller address from the frame header and names it `name`.
effect fn loadHidden(writer: &mut Writer, name: u64, offset: usize) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let frame = writer.frame
  let loaded = run loadWordAt(&mut writer.*, frame, offset)
  Module.setName(&mut writer.*.module, loaded, name)
  return loaded
}

effect fn takesResult(function: &MirFunction, target: &Target, layouts: &TypeLayouts) -> bool
! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let locals = List<Local>.asSlice(&function.locals)
  let facts = run layoutOf(layouts, &function.result, function, locals[usize.ZERO].origin.location)
  return failureLocal(function) != usize.MAX || !storageRepresentation(&function.result, target, facts).unit
}

// The `$enter` lanes after the transfer record: the written parameter lanes, then the hidden
// provider, observer and cause addresses, then the result (`out`, when not empty), failure and

// The `$enter` signature: the transfer record, the written parameter lanes, then the hidden
// provider, observer and cause addresses, then the result (when `takes`), failure and context
// addresses. Records the arguments in `writer` as a definition's own are.
effect fn enterSignature(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts, takes: bool)
-> Signature ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let pointer = run pointerType(&mut writer.*)
  let mut lanes = signature()
  writer.transfer = run addParameter(&mut lanes, pointer, hiddenName(b"transfer"))
  let locals = List<Local>.asSlice(&function.locals)
  let parameters = List<Shared<Type>>.asSlice(&function.parameters)
  let mut at = usize.ZERO
  while at < parameters.length {
    let facts = run layoutOf(layouts, &parameters[at], function, locals[at + usize.ONE].origin.location)
    let lane = storageRepresentation(&parameters[at], target, facts)
    if !lane.unit {
      let mut ty = pointer
      if facts.abi != Abi.Indirect && !passedIndirectly(lane) { ty = run typeOf(&mut writer.*, lane) }
      let span = locals[at + usize.ONE].origin.location
      if let Option<Shared<Type>>.Some {value: field} = run unwrappedParameter(layouts, &parameters[at], facts, function, span) {
        ty = run typeOf(&mut writer.*, run unwrappedLane(layouts, &field, target, function, span))
      }
      let added = run addParameter(&mut lanes, ty, Bitcode.named(Bitcode.prefixParameter(), at))
      run List<u64>.append(&mut writer.*.parameters, added)
    } else {
      run List<u64>.append(&mut writer.*.parameters, Bitcode.none())
    }
    at = at + usize.ONE
  }
  let mut provider = usize.ZERO
  while providerLocalAt(function, provider) != usize.MAX {
    let added = run addParameter(&mut lanes, pointer, Bitcode.named(Bitcode.prefixHidden(), provider))
    run List<u64>.append(&mut writer.*.providers, added)
    provider = provider + usize.ONE
  }
  let observed = diagnosticLocal(function, usize.ZERO) != usize.MAX
  if observed {
    writer.observer = run addParameter(&mut lanes, pointer, hiddenName(b"observer"))
    writer.cause = run addParameter(&mut lanes, pointer, hiddenName(b"cause"))
    writer.site = run addParameter(&mut lanes, pointer, hiddenName(b"site"))
  }
  if takes { writer.out = run addParameter(&mut lanes, pointer, hiddenName(b"out")) }
  if failureLocal(function) != usize.MAX {
    writer.failure = run addParameter(&mut lanes, pointer, hiddenName(b"fail"))
    if observed { writer.context = run addParameter(&mut lanes, pointer, hiddenName(b"context")) }
  }
  return move lanes
}

// Calls `<symbol>$enter` from a driver with its own arguments in `$enter`'s order, passing `out`
// as the result address unless it is `none()`.
effect fn callEnter(writer: &mut Writer, symbol: &[u8], transfer: u64, out: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut arguments = List<u64>.make()
  run List<u64>.append(&mut arguments, transfer)
  let parameters = List<u64>.asSlice(&writer.parameters)
  let mut at = usize.ZERO
  while at < parameters.length {
    if parameters[at] != Bitcode.none() { run List<u64>.append(&mut arguments, parameters[at]) }
    at = at + usize.ONE
  }
  run appendWords(&mut arguments, List<u64>.asSlice(&writer.providers))
  if writer.observer != Bitcode.none() {
    run List<u64>.append(&mut arguments, writer.observer)
    run List<u64>.append(&mut arguments, writer.cause)
    run List<u64>.append(&mut arguments, writer.site)
  }
  if out != Bitcode.none() { run List<u64>.append(&mut arguments, out) }
  if writer.failure != Bitcode.none() {
    run List<u64>.append(&mut arguments, writer.failure)
    if writer.context != Bitcode.none() { run List<u64>.append(&mut arguments, writer.context) }
  }
  return run callSuffixed(&mut writer.*, symbol, b"$enter", List<u64>.asSlice(&arguments))
}

// Calls `<symbol><suffix>`, a function returning nothing, with `arguments`.
effect fn callSuffixed(writer: &mut Writer, symbol: &[u8], suffix: &[u8], arguments: &[u64]) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut types = List<u64>.make()
  let mut at = usize.ZERO
  while at < arguments.length {
    let ty = Module.typeOf(&writer.module, arguments[at])
    run List<u64>.append(&mut types, ty)
    at = at + usize.ONE
  }
  let void = run voidType(&mut writer.*)
  let ty = run functionType(&mut writer.*, void, List<u64>.asSlice(&types))
  let name = run suffixed(symbol, suffix)
  let callee = run Module.functionRef(&mut writer.*.module, Bytes.asSlice(&name), ty)
  let none = run Module.call(&mut writer.*.module, ty, callee, arguments, 0, false)
  return ()
}

effect fn appendWords(list: &mut List<u64>, words: &[u64]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < words.length {
    run List<u64>.append(&mut list.*, words[at])
    at = at + usize.ONE
  }
  return ()
}

// The type of `$step`: `i32 (ptr, ptr)`.
effect fn stepType(writer: &mut Writer) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let int32 = run integerType(&mut writer.*, 32)
  let pointer = run pointerType(&mut writer.*)
  let parameters = [pointer, pointer]
  return run functionType(&mut writer.*, int32, &parameters)
}

// Steps the frame on top of `transfer`, answering the step's completion code.
effect fn stepTop(writer: &mut Writer, transfer: u64, top: u64, word: usize) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let resume = run loadWordAt(&mut writer.*, top, Coroutine.resumeOffset(word))
  let ty = run stepType(&mut writer.*)
  let arguments = [transfer, top]
  return run Module.call(&mut writer.*.module, ty, resume, &arguments, 0, false)
}

// Whether `value` is the null address.
effect fn isNull(writer: &mut Writer, value: u64) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let null = run nullOf(&mut writer.*)
  return run compareOf(&mut writer.*, Bitcode.intEq(), value, null)
}

// Destroys the storage state of `transfer`, if any, then continues at `exit`.
effect fn destroyState(writer: &mut Writer, stepping: &Suspended, transfer: u64, clear: bool, exit: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let state = run loadPointer(&mut writer.*, transfer, usize.ZERO)
  let absent = run isNull(&mut writer.*, state)
  let destroy = run labelled(&mut writer.*, b"destroy")
  run branchIf(&mut writer.*, absent, exit, destroy)
  startBlock(&mut writer.*, destroy)
  let void = run voidType(&mut writer.*)
  let pointer = run pointerType(&mut writer.*)
  let parameters = [pointer]
  let arguments = [state]
  let none = run callNamed(&mut writer.*, Bytes.asSlice(&stepping.facts.destroy), void, &parameters, &arguments)
  if clear {
    let null = run nullOf(&mut writer.*)
    run storeOf(&mut writer.*, null, transfer, usize.ZERO)
  }
  return run branch(&mut writer.*, exit)
}

// The ordinary symbol's body: push the instance's frame, step the top frame until none remains,
// destroy the storage state the frames used, and return the outcome under the ordinary convention.
effect fn emitDriver(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  stepping: &Suspended, symbol: &[u8]) -> () ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = wordSize(target)
  let locals = List<Local>.asSlice(&function.locals)
  let resultFacts = run layoutOf(layouts, &function.result, function, locals[usize.ZERO].origin.location)
  let result = storageRepresentation(&function.result, target, resultFacts)
  let fallible = failureLocal(function) != usize.MAX
  if packageStart(function) { return run emitPackageDriver(&mut writer.*, function, target, layouts, stepping, symbol) }
  let entry = run labelled(&mut writer.*, b"entry")
  startBlock(&mut writer.*, entry)
  let wordTy = run wordType(&mut writer.*)
  let record = run Module.array(&mut writer.*.module, 4, wordTy)
  let transfer = run Module.alloca(&mut writer.*.module, record, usize.toU64(word))
  Module.setName(&mut writer.*.module, transfer, hiddenName(b"transfer"))
  let null = run nullOf(&mut writer.*)
  run storeOf(&mut writer.*, null, transfer, usize.ZERO)
  run storeWordAt(&mut writer.*, null, transfer, Coroutine.transferTop(word))
  run storeWordAt(&mut writer.*, null, transfer, Coroutine.transferPackage(word))
  let failed = run byteOffset(&mut writer.*, transfer, Coroutine.transferFailed(word))
  let clear = run integerOf(&mut writer.*, 8, 0)
  run storeOf(&mut writer.*, clear, failed, usize.ZERO)
  let mut out = Bitcode.none()
  if fallible || result.aggregate || passedIndirectly(result) { out = writer.out }
  else if !result.unit {
    let ty = run typeOf(&mut writer.*, result)
    out = run Module.alloca(&mut writer.*.module, ty, usize.toU64(resultFacts.alignment))
    Module.setName(&mut writer.*.module, out, hiddenName(b"result"))
  }
  run callEnter(&mut writer.*, symbol, transfer, out)
  let drive = run labelled(&mut writer.*, b"drive")
  run branch(&mut writer.*, drive)
  startBlock(&mut writer.*, drive)
  let top = run loadWordAt(&mut writer.*, transfer, Coroutine.transferTop(word))
  let empty = run isNull(&mut writer.*, top)
  let finish = run labelled(&mut writer.*, b"finish")
  let step = run labelled(&mut writer.*, b"step")
  run branchIf(&mut writer.*, empty, finish, step)
  startBlock(&mut writer.*, step)
  let code = run stepTop(&mut writer.*, transfer, top, word)
  run branch(&mut writer.*, drive)
  startBlock(&mut writer.*, finish)
  let exit = run labelled(&mut writer.*, b"exit")
  run destroyState(&mut writer.*, stepping, transfer, false, exit)
  startBlock(&mut writer.*, exit)
  if fallible {
    let byte = run integerType(&mut writer.*, 8)
    let flag = run Module.load(&mut writer.*.module, byte, failed, 0, false)
    let zero = run integerOf(&mut writer.*, 8, 0)
    let status = run compareOf(&mut writer.*, Bitcode.intNe(), flag, zero)
    return run Module.ret(&mut writer.*.module, status)
  }
  if result.aggregate || result.unit || passedIndirectly(result) { return run Module.retVoid(&mut writer.*.module) }
  let value = run loadOf(&mut writer.*, result, out, resultFacts.alignment)
  return run Module.ret(&mut writer.*.module, value)
}

fn packageStart(function: &MirFunction) -> bool {
  return match &function.key {
    InstanceKey.Helper {purpose, ..} => purpose == HelperRole.Start
    _ => false
  }
}

// An execution package's start drives the transfer record its header begins with: the first
// activation pushes the start's own frame, a later one continues the frames a relinquishment left.
// A step that relinquishes returns with the frames in place; the storage state is destroyed once,
// when the last frame completes.
effect fn emitPackageDriver(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  stepping: &Suspended, symbol: &[u8]) -> () ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = wordSize(target)
  let entry = run labelled(&mut writer.*, b"entry")
  startBlock(&mut writer.*, entry)
  let header = List<u64>.get(&writer.parameters, usize.ZERO)
  let transfer = run byteOffset(&mut writer.*, header, usize.ZERO)
  Module.setName(&mut writer.*.module, transfer, hiddenName(b"transfer"))
  let first = run loadWordAt(&mut writer.*, transfer, Coroutine.transferTop(word))
  let fresh = run isNull(&mut writer.*, first)
  let enter = run labelled(&mut writer.*, b"enter")
  let drive = run labelled(&mut writer.*, b"drive")
  run branchIf(&mut writer.*, fresh, enter, drive)
  startBlock(&mut writer.*, enter)
  run callEnter(&mut writer.*, symbol, transfer, Bitcode.none())
  run branch(&mut writer.*, drive)
  startBlock(&mut writer.*, drive)
  let top = run loadWordAt(&mut writer.*, transfer, Coroutine.transferTop(word))
  let empty = run isNull(&mut writer.*, top)
  let finish = run labelled(&mut writer.*, b"finish")
  let step = run labelled(&mut writer.*, b"step")
  run branchIf(&mut writer.*, empty, finish, step)
  startBlock(&mut writer.*, step)
  let code = run stepTop(&mut writer.*, transfer, top, word)
  let relinquishedCode = run integerOf(&mut writer.*, 32, 2)
  let relinquished = run compareOf(&mut writer.*, Bitcode.intEq(), code, relinquishedCode)
  let parked = run labelled(&mut writer.*, b"parked")
  run branchIf(&mut writer.*, relinquished, parked, drive)
  startBlock(&mut writer.*, parked)
  run Module.retVoid(&mut writer.*.module)
  startBlock(&mut writer.*, finish)
  let exit = run labelled(&mut writer.*, b"exit")
  run destroyState(&mut writer.*, stepping, transfer, true, exit)
  startBlock(&mut writer.*, exit)
  return run Module.retVoid(&mut writer.*.module)
}

// `$enter` acquires the instance's frame from the transfer record's storage state, creating that
// state on first use, records the caller's addresses and the parameters, and pushes the frame.
// Storage refusal is the fatal execution-stack exhaustion trap (SUSP-006).
effect fn emitEnter(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  stepping: &Suspended, symbol: &[u8]) -> () ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = wordSize(target)
  let takes = run takesResult(function, target, layouts)
  let lanes = run enterSignature(&mut writer.*, function, target, layouts, takes)
  let void = run voidType(&mut writer.*)
  let ty = run functionType(&mut writer.*, void, List<u64>.asSlice(&lanes.types))
  let name = run suffixed(symbol, b"$enter")
  let defined = run Module.defineFunction(&mut writer.*.module, Bytes.asSlice(&name), ty, Bitcode.linkExternal(), 0)
  run beginFunction(&mut writer.*, defined, &lanes)
  let transfer = writer.transfer
  let pointer = run pointerType(&mut writer.*)
  let entry = run labelled(&mut writer.*, b"entry")
  startBlock(&mut writer.*, entry)
  let current = run loadPointer(&mut writer.*, transfer, usize.ZERO)
  let missing = run isNull(&mut writer.*, current)
  let create = run labelled(&mut writer.*, b"create")
  let ready = run labelled(&mut writer.*, b"ready")
  run branchIf(&mut writer.*, missing, create, ready)
  startBlock(&mut writer.*, create)
  let created = run callNamed(&mut writer.*, Bytes.asSlice(&stepping.facts.create), pointer, &[], &[])
  let refused = run isNull(&mut writer.*, created)
  let exhausted = run labelled(&mut writer.*, b"exhausted")
  let publish = run labelled(&mut writer.*, b"publish")
  run branchIf(&mut writer.*, refused, exhausted, publish)
  startBlock(&mut writer.*, publish)
  run storeOf(&mut writer.*, created, transfer, usize.ZERO)
  run branch(&mut writer.*, ready)
  startBlock(&mut writer.*, ready)
  let state = run loadPointer(&mut writer.*, transfer, usize.ZERO)
  let wordTy = run wordType(&mut writer.*)
  let size = run wordOf(&mut writer.*, stepping.coroutine.size)
  let alignment = run wordOf(&mut writer.*, stepping.coroutine.alignment)
  let acquireParameters = [pointer, wordTy, wordTy]
  let acquireArguments = [state, size, alignment]
  let frame = run callNamed(&mut writer.*, Bytes.asSlice(&stepping.facts.acquire), pointer, &acquireParameters, &acquireArguments)
  Module.setName(&mut writer.*.module, frame, hiddenName(b"frame"))
  writer.frame = frame
  let absent = run isNull(&mut writer.*, frame)
  let start = run labelled(&mut writer.*, b"start")
  run branchIf(&mut writer.*, absent, exhausted, start)
  startBlock(&mut writer.*, exhausted)
  run trapHere(&mut writer.*)
  startBlock(&mut writer.*, start)
  let parent = run loadWordAt(&mut writer.*, transfer, Coroutine.transferTop(word))
  run storeOf(&mut writer.*, parent, frame, usize.ZERO)
  let stepTy = run stepType(&mut writer.*)
  let stepName = run suffixed(symbol, b"$step")
  let stepFunction = run Module.functionRef(&mut writer.*.module, Bytes.asSlice(&stepName), stepTy)
  run storeWordAt(&mut writer.*, stepFunction, frame, Coroutine.resumeOffset(word))
  let initial = run byteOffset(&mut writer.*, frame, Coroutine.stateOffset(word))
  let zero = run integerOf(&mut writer.*, 32, 0)
  run storeOf(&mut writer.*, zero, initial, usize.ZERO)
  let observed = diagnosticLocal(function, usize.ZERO) != usize.MAX
  let fallible = failureLocal(function) != usize.MAX
  let hidden = [writer.out, writer.failure, writer.context, writer.observer, writer.cause, writer.site]
  if takes { run storeWordAt(&mut writer.*, hidden[0], frame, Coroutine.outOffset(word)) }
  if fallible {
    run storeWordAt(&mut writer.*, hidden[1], frame, Coroutine.failOffset(word))
    if observed { run storeWordAt(&mut writer.*, hidden[2], frame, Coroutine.contextOffset(word)) }
  }
  if observed {
    run storeWordAt(&mut writer.*, hidden[3], frame, Coroutine.observerOffset(word))
    run storeWordAt(&mut writer.*, hidden[4], frame, Coroutine.causeOffset(word))
    run storeWordAt(&mut writer.*, hidden[5], frame, Coroutine.siteOffset(word))
  }
  let mut provider = usize.ZERO
  while providerLocalAt(function, provider) != usize.MAX {
    let address = List<u64>.get(&writer.providers, provider)
    run storeWordAt(&mut writer.*, address, frame, Coroutine.providerOffset(word, provider))
    provider = provider + usize.ONE
  }
  // Each parameter lands where the body reads it: its resident slot or its slot in state 0.
  let locals = List<Local>.asSlice(&function.locals)
  let parameters = List<Shared<Type>>.asSlice(&function.parameters)
  let mut at = usize.ZERO
  while at < parameters.length {
    let offset = Coroutine.parameterAt(&stepping.coroutine, at + usize.ONE)
    let parameterLayout = run layoutOf(layouts, &parameters[at], function, locals[at + usize.ONE].origin.location)
    let kind = storageRepresentation(&parameters[at], target, parameterLayout)
    if !kind.unit && offset != usize.MAX {
      let slot = run byteOffset(&mut writer.*, frame, offset)
      let input = List<u64>.get(&writer.parameters, at)
      let span = locals[at + usize.ONE].origin.location
      if let Option<Shared<Type>>.Some {value: field} = run unwrappedParameter(layouts, &parameters[at], parameterLayout, function, span) {
        let lane = run unwrappedLane(layouts, &field, target, function, span)
        let address = Address {ty: move field, value: slot,
          alignment: offsetAlignment(stepping.coroutine.alignment, offset), representation: lane}
        run storeValue(&mut writer.*, &address, &Value {scalar: lane, value: input})
        at = at + usize.ONE
        continue
      }
      if passedIndirectly(kind) {
        run copyBytes(&mut writer.*, slot, input, parameterLayout.size)
        at = at + usize.ONE
        continue
      }
      let address = Address {ty: Shared<Type>.clone(&parameters[at]), value: slot,
        alignment: offsetAlignment(stepping.coroutine.alignment, offset), representation: kind}
      run storeValue(&mut writer.*, &address, &Value {scalar: kind, value: input})
    }
    at = at + usize.ONE
  }
  run storeWordAt(&mut writer.*, frame, transfer, Coroutine.transferTop(word))
  run Module.retVoid(&mut writer.*.module)
  return run Module.endBody(&mut writer.*.module)
}

// Copies one state's saved locals between their stack slots and the frame.
effect fn transferState(writer: &mut Writer, slots: &[FrameSlot], saving: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let base = writer.frame
  let mut at = usize.ZERO
  while at < slots.length {
    let frame = run byteOffset(&mut writer.*, base, slots[at].offset)
    let local = slotOf(&writer.*, slots[at].local)
    if saving { run copyBytes(&mut writer.*, frame, local, slots[at].size) }
    else { run copyBytes(&mut writer.*, local, frame, slots[at].size) }
    at = at + usize.ONE
  }
  return ()
}

// `$step` runs the frame on top from its resume state: state 0 starts the body, and state `k + 1`
// restores what lives after point `k`, then continues at that call's normal or failure edge, or,
// when the frame's package was dropped while relinquished, at that point's cancel exit.
effect fn emitStep(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  foreign: &[CAbi.Signature], identities: &[InstanceIdentity], suspended: &Option<Suspended>, stepping: &Suspended,
  symbol: &[u8]) -> () ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = wordSize(target)
  let pointer = run pointerType(&mut writer.*)
  let int32 = run integerType(&mut writer.*, 32)
  let mut lanes = signature()
  writer.transfer = run addParameter(&mut lanes, pointer, hiddenName(b"transfer"))
  writer.frame = run addParameter(&mut lanes, pointer, hiddenName(b"frame"))
  let guarded = foreignGuard(function)
  if guarded {
    let mut encoding = List<u64>.make()
    run guardAttributes(&mut encoding)
    run addAttributes(&mut lanes, Bitcode.positionFunction(), List<u64>.asSlice(&encoding))
  }
  let ty = run stepType(&mut writer.*)
  let attributes = run attributeList(&mut writer.*, &lanes)
  let name = run suffixed(symbol, b"$step")
  let defined = run Module.defineFunction(&mut writer.*.module, Bytes.asSlice(&name), ty, Bitcode.linkExternal(), attributes)
  if guarded { run guard(&mut writer.*, defined) }
  run beginFunction(&mut writer.*, defined, &lanes)
  let transfer = writer.transfer
  let frame = writer.frame
  let blocks = List<Block>.asSlice(&function.blocks)
  let states = List<State>.asSlice(&stepping.coroutine.states)
  let points = List<usize>.asSlice(&stepping.coroutine.points)
  let entry = run labelled(&mut writer.*, b"entry")
  run addBlocks(&mut writer.*, blocks.length)
  startBlock(&mut writer.*, entry)
  run emitSlots(&mut writer.*, function, target, layouts, suspended)
  run emitCCopySlots(&mut writer.*, function, target, layouts, foreign)
  let observed = diagnosticLocal(function, usize.ZERO) != usize.MAX
  let fallible = failureLocal(function) != usize.MAX
  if run takesResult(function, target, layouts) { writer.out = run loadHidden(&mut writer.*, hiddenName(b"out"), Coroutine.outOffset(word)) }
  if fallible {
    writer.failure = run loadHidden(&mut writer.*, hiddenName(b"fail"), Coroutine.failOffset(word))
    if observed { writer.context = run loadHidden(&mut writer.*, hiddenName(b"context"), Coroutine.contextOffset(word)) }
  }
  if observed {
    writer.observer = run loadHidden(&mut writer.*, hiddenName(b"observer"), Coroutine.observerOffset(word))
    writer.cause = run loadHidden(&mut writer.*, hiddenName(b"cause"), Coroutine.causeOffset(word))
    writer.site = run loadHidden(&mut writer.*, hiddenName(b"site"), Coroutine.siteOffset(word))
  }
  let mut provider = usize.ZERO
  while providerLocalAt(function, provider) != usize.MAX {
    let loaded = run loadHidden(&mut writer.*, Bitcode.named(Bitcode.prefixHidden(), provider), Coroutine.providerOffset(word, provider))
    run List<u64>.append(&mut writer.*.providers, loaded)
    provider = provider + usize.ONE
  }
  let stateAddress = run byteOffset(&mut writer.*, frame, Coroutine.stateOffset(word))
  let state = run Module.load(&mut writer.*.module, int32, stateAddress, 0, false)
  // A frame whose package was dropped while relinquished cancels from its point (`Destroyed`).
  let package = run loadWordAt(&mut writer.*, transfer, Coroutine.transferPackage(word))
  let null = run nullOf(&mut writer.*)
  let owned = run compareOf(&mut writer.*, Bitcode.intNe(), package, null)
  let probe = run labelled(&mut writer.*, b"probe")
  let dispatch = run labelled(&mut writer.*, b"dispatch")
  let cancelling = run labelled(&mut writer.*, b"cancelling")
  let invalid = run labelled(&mut writer.*, b"invalid")
  let start = run labelled(&mut writer.*, b"start")
  let mut resumes = List<u64>.make()
  let mut cancels = List<u64>.make()
  let mut point = usize.ONE
  while point < states.length {
    run List<u64>.append(&mut resumes, run labelledNumber(&mut writer.*, b"resume", point))
    run List<u64>.append(&mut cancels, run labelledNumber(&mut writer.*, b"cancel", point))
    point = point + usize.ONE
  }
  run branchIf(&mut writer.*, owned, probe, dispatch)
  startBlock(&mut writer.*, probe)
  let activation = run byteOffset(&mut writer.*, package, Coroutine.packageActivation(word))
  let wordTy = run wordType(&mut writer.*)
  let lifecycle = run Module.load(&mut writer.*.module, wordTy, activation, 0, false)
  let destroyedWord = run wordOf(&mut writer.*, SealedCore.lifecycleWord(Lifecycle.Destroyed))
  let destroyed = run compareOf(&mut writer.*, Bitcode.intEq(), lifecycle, destroyedWord)
  run branchIf(&mut writer.*, destroyed, cancelling, dispatch)
  startBlock(&mut writer.*, cancelling)
  let mut table = List<u64>.make()
  point = usize.ONE
  while point < states.length {
    run List<u64>.append(&mut table, run integerOf(&mut writer.*, 32, usize.toU64(point)))
    run List<u64>.append(&mut table, List<u64>.get(&cancels, point - usize.ONE))
    point = point + usize.ONE
  }
  run Module.switch(&mut writer.*.module, state, invalid, List<u64>.asSlice(&table))
  startBlock(&mut writer.*, dispatch)
  List<u64>.clear(&mut table)
  run List<u64>.append(&mut table, run integerOf(&mut writer.*, 32, 0))
  run List<u64>.append(&mut table, start)
  point = usize.ONE
  while point < states.length {
    run List<u64>.append(&mut table, run integerOf(&mut writer.*, 32, usize.toU64(point)))
    run List<u64>.append(&mut table, List<u64>.get(&resumes, point - usize.ONE))
    point = point + usize.ONE
  }
  run Module.switch(&mut writer.*.module, state, invalid, List<u64>.asSlice(&table))
  startBlock(&mut writer.*, invalid)
  run Module.unreachable(&mut writer.*.module)
  startBlock(&mut writer.*, start)
  run transferState(&mut writer.*, List<FrameSlot>.asSlice(&states[usize.ZERO].slots), false)
  run emitHiddenStores(&mut writer.*, function)
  let first = blockAt(&writer.*, usize.ZERO)
  run branch(&mut writer.*, first)
  point = usize.ONE
  while point < states.length {
    startBlock(&mut writer.*, List<u64>.get(&resumes, point - usize.ONE))
    run transferState(&mut writer.*, List<FrameSlot>.asSlice(&states[point].slots), false)
    run emitDiagnosticStores(&mut writer.*, function)
    if let Terminator.Relinquish {resume, ..} = &blocks[points[point - usize.ONE]].terminator {
      let next = blockAt(&writer.*, resume)
      run branch(&mut writer.*, next)
    }
    if let Terminator.Call {normal, failure, ..} = &blocks[points[point - usize.ONE]].terminator {
      let onSuccess = blockAt(&writer.*, normal)
      if let Option<FailureEdge>.Some {value: edge} = &failure {
        let failed = run byteOffset(&mut writer.*, transfer, Coroutine.transferFailed(word))
        let byte = run integerType(&mut writer.*, 8)
        let flag = run Module.load(&mut writer.*.module, byte, failed, 0, false)
        let zero = run integerOf(&mut writer.*, 8, 0)
        let taken = run compareOf(&mut writer.*, Bitcode.intNe(), flag, zero)
        let onFailure = blockAt(&writer.*, edge.target)
        run branchIf(&mut writer.*, taken, onFailure, onSuccess)
      } else {
        run branch(&mut writer.*, onSuccess)
      }
    }
    point = point + usize.ONE
  }
  // State `k + 1` cancels by restoring what lives after point `k` and entering its cancel exit.
  point = usize.ONE
  while point < states.length {
    startBlock(&mut writer.*, List<u64>.get(&cancels, point - usize.ONE))
    let exit = Coroutine.cancelAfter(function, points[point - usize.ONE])
    if exit == usize.MAX {
      run trapHere(&mut writer.*)
    } else {
      run transferState(&mut writer.*, List<FrameSlot>.asSlice(&states[point].slots), false)
      run emitDiagnosticStores(&mut writer.*, function)
      let next = blockAt(&writer.*, exit)
      run branch(&mut writer.*, next)
    }
    point = point + usize.ONE
  }
  // A step keeps its frame plan; its locals get no lifetime markers.
  let unmarked = List<BlockMarkers>.make()
  let uncompanioned = List<usize>.make()
  let mut at = usize.ZERO
  while at < blocks.length {
    let handle = blockAt(&writer.*, at)
    startBlock(&mut writer.*, handle)
    run emitBlock(&mut writer.*, function, target, layouts, &blocks[at], foreign, identities, suspended, at,
      List<BlockMarkers>.asSlice(&unmarked), List<usize>.asSlice(&uncompanioned))
    at = at + usize.ONE
  }
  return run Module.endBody(&mut writer.*.module)
}

// Completes the frame on top: records whether it failed, pops it, releases it to its storage
// state, and reports completion to the driver.
effect fn emitPop(writer: &mut Writer, target: &Target, stepping: &Suspended, failed: Option<bool>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let word = wordSize(target)
  let transfer = writer.transfer
  let frame = writer.frame
  if let Option<bool>.Some {value} = move failed {
    let flag = run byteOffset(&mut writer.*, transfer, Coroutine.transferFailed(word))
    let mut bit: u64 = 0
    if value { bit = 1 }
    let stored = run integerOf(&mut writer.*, 8, bit)
    run storeOf(&mut writer.*, stored, flag, usize.ZERO)
  }
  let parent = run loadPointer(&mut writer.*, frame, usize.ZERO)
  run storeWordAt(&mut writer.*, parent, transfer, Coroutine.transferTop(word))
  let state = run loadPointer(&mut writer.*, transfer, usize.ZERO)
  let void = run voidType(&mut writer.*)
  let pointer = run pointerType(&mut writer.*)
  let parameters = [pointer, pointer]
  let arguments = [state, frame]
  let none = run callNamed(&mut writer.*, Bytes.asSlice(&stepping.facts.release), void, &parameters, &arguments)
  let done = run integerOf(&mut writer.*, 32, 0)
  return run Module.ret(&mut writer.*.module, done)
}

// A step's `Return` writes the result through the caller's result address before completing.
effect fn emitStepReturn(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  stepping: &Suspended, span: Location) -> () ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let resultLayout = run layoutOf(layouts, &function.result, function, span)
  let kind = storageRepresentation(&function.result, target, resultLayout)
  if !kind.unit {
    let returned = Operand.Copy {place: Place {local: usize.ZERO, projections: List<Projection>.make()}}
    let value = run emitOperand(&mut writer.*, function, target, layouts, &returned)
    let output = Address {ty: Shared<Type>.clone(&function.result), value: writer.out,
      alignment: resultLayout.alignment, representation: kind}
    run storeValue(&mut writer.*, &output, &value)
  }
  let mut failed = Option<bool>.none()
  if failureLocal(function) != usize.MAX { failed = Option<bool>.some(false) }
  return run emitPop(&mut writer.*, target, stepping, move failed)
}

// A step's `Fail` writes the failure through the caller's failure address before completing.
effect fn emitStepFail(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  stepping: &Suspended, span: Location) -> () ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let local = failureLocal(function)
  if local == usize.MAX {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.relative(GapCode.TypedForm, &owner, span)
  }
  let locals = List<Local>.asSlice(&function.locals)
  let failureLayout = run layoutOf(layouts, &locals[local].ty, function, span)
  let kind = storageRepresentation(&locals[local].ty, target, failureLayout)
  if !kind.unit {
    let failedValue = Operand.Copy {place: Place {local: local, projections: List<Projection>.make()}}
    let value = run emitOperand(&mut writer.*, function, target, layouts, &failedValue)
    let output = Address {ty: Shared<Type>.clone(&locals[local].ty), value: writer.failure,
      alignment: failureLayout.alignment, representation: kind}
    run storeValue(&mut writer.*, &output, &value)
  }
  return run emitPop(&mut writer.*, target, stepping, Option<bool>.some(true))
}

// Records resume state `state` in the frame and saves the locals it restores.
effect fn suspendAt(writer: &mut Writer, target: &Target, stepping: &Suspended, state: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let word = wordSize(target)
  let frame = writer.frame
  let resume = run byteOffset(&mut writer.*, frame, Coroutine.stateOffset(word))
  let stored = run integerOf(&mut writer.*, 32, usize.toU64(state))
  run storeOf(&mut writer.*, stored, resume, usize.ZERO)
  let states = List<State>.asSlice(&stepping.coroutine.states)
  return run transferState(&mut writer.*, List<FrameSlot>.asSlice(&states[state].slots), true)
}

// A relinquishment saves the locals its resume state restores and returns 2: the frames stay in
// the package's transfer record until the package's start continues them.
effect fn emitRelinquish(writer: &mut Writer, target: &Target, stepping: &Suspended, state: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let word = wordSize(target)
  run suspendAt(&mut writer.*, target, stepping, state)
  // The package's activation records the relinquishment its drive reads (`Lifecycle.Relinquished`).
  let transfer = writer.transfer
  let package = run loadWordAt(&mut writer.*, transfer, Coroutine.transferPackage(word))
  let activation = run byteOffset(&mut writer.*, package, Coroutine.packageActivation(word))
  // A waking thread reads the activation atomically, so the owner writes it atomically (EXEC-009).
  let relinquished = run wordOf(&mut writer.*, SealedCore.lifecycleWord(Lifecycle.Relinquished))
  run Module.storeAtomic(&mut writer.*.module, relinquished, activation, usize.toU64(word), Bitcode.orderMonotonic())
  let parked = run integerOf(&mut writer.*, 32, 2)
  return run Module.ret(&mut writer.*.module, parked)
}

// A call at a suspension point saves the locals its resume state restores, pushes the callee's
// frame with the call's operands, and returns to the driver, which runs the callee next.
effect fn emitSuspendingCall(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  identities: &[InstanceIdentity],
  stepping: &Suspended,
  state: usize,
  callee: &Callee,
  arguments: &List<Operand>,
  providers: &List<Operand>,
  diagnostics: &Option<Diagnostics>,
  destination: &Place,
  failure: &Option<FailureEdge>,
  span: Location,
) -> () ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut symbol = Bytes.make()
  if let Callee.Instance {key} = &callee.* { symbol = run InstanceIdentity.name(identities, &key) }
  else {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.relative(GapCode.TypedForm, &owner, span)
  }
  let output = run emitPlace(&mut writer.*, function, target, layouts, destination)
  let mut failed = Bitcode.none()
  let mut context = Bitcode.none()
  if let Option<FailureEdge>.Some {value: edge} = &failure.* {
    let failureSlot = run emitPlace(&mut writer.*, function, target, layouts, &edge.destination)
    failed = failureSlot.value
    if let Option<Diagnostics>.Some {..} = &diagnostics.* {
      context = companionAddress(&writer.*, function, edge.destination.local)
    }
  }
  let mut passed = List<u64>.make()
  run List<u64>.append(&mut passed, writer.transfer)
  let values = List<Operand>.asSlice(arguments)
  let mut index = usize.ZERO
  while index < values.length {
    let value = run emitArgument(&mut writer.*, function, target, layouts, &values[index], false)
    if !value.scalar.unit { run List<u64>.append(&mut passed, value.value) }
    index = index + usize.ONE
  }
  let hidden = List<Operand>.asSlice(providers)
  index = usize.ZERO
  while index < hidden.length {
    let provided = run emitOperand(&mut writer.*, function, target, layouts, &hidden[index])
    run List<u64>.append(&mut passed, provided.value)
    index = index + usize.ONE
  }
  if let Option<Diagnostics>.Some {value: observed} = &diagnostics.* {
    run appendDiagnostics(&mut writer.*, function, target, layouts, &observed, &mut passed)
  }
  run suspendAt(&mut writer.*, target, stepping, state)
  let fallible = failed != Bitcode.none()
  if fallible || !output.representation.unit { run List<u64>.append(&mut passed, output.value) }
  if fallible {
    run List<u64>.append(&mut passed, failed)
    if context != Bitcode.none() { run List<u64>.append(&mut passed, context) }
  }
  run callSuffixed(&mut writer.*, Bytes.asSlice(&symbol), b"$enter", List<u64>.asSlice(&passed))
  let pushed = run integerOf(&mut writer.*, 32, 1)
  return run Module.ret(&mut writer.*.module, pushed)
}

/// One deduplicated declaration candidate owned by an instance answer; `text` is its fragment.
pub struct Declaration {
  pub contract: Bytes,
  pub symbol: Bytes,
  pub text: Bytes,
}

// Appends the enum attribute `kind` to `encoding`.
effect fn appendAttribute(encoding: &mut List<u64>, kind: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<u64>.append(&mut encoding.*, 0)
  return run List<u64>.append(&mut encoding.*, kind)
}

// Appends the integer attribute `kind` of `value` to `encoding`.
effect fn appendValueAttribute(encoding: &mut List<u64>, kind: u64, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<u64>.append(&mut encoding.*, 1)
  run List<u64>.append(&mut encoding.*, kind)
  return run List<u64>.append(&mut encoding.*, usize.toU64(value))
}

// Appends the type attribute `kind` of `ty` to `encoding`.
effect fn appendTypeAttribute(encoding: &mut List<u64>, kind: u64, ty: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<u64>.append(&mut encoding.*, 6)
  run List<u64>.append(&mut encoding.*, kind)
  return run List<u64>.append(&mut encoding.*, ty)
}

effect fn appendExtension(encoding: &mut List<u64>, rule: CExtension) -> () ! OutOfMemoryError ? &mut Allocator {
  return match rule {
    CExtension.None => ()
    CExtension.Signed => run appendAttribute(&mut encoding.*, Bitcode.attrSignExt())
    CExtension.Unsigned => run appendAttribute(&mut encoding.*, Bitcode.attrZeroExt())
  }
}

effect fn cLaneType(writer: &mut Writer, lane: &CAbi.Lane, declaration: &Shared<DeclarationId>, source: &GapSource) -> u64
! Gap | OutOfMemoryError
? &mut Allocator {
  if lane.passing == CPassing.Ignore || lane.passing == CPassing.Indirect { return run voidType(&mut writer.*) }
  if lane.passing == CPassing.Coerce { return run coercionType(&mut writer.*, lane) }
  match lane.layout.abi {
    Abi.Unit => {
      return run voidType(&mut writer.*)
    }
    Abi.Pointer => {
      return run pointerType(&mut writer.*)
    }
    Abi.Floating => {
      if lane.layout.size == 4 {
        return run Module.floating(&mut writer.*.module, 32)
      }
      return run Module.floating(&mut writer.*.module, 64)
    }
    Abi.Integer => {}
    Abi.Indirect => {
      fail Gap.fromSource(GapCode.CAbiAggregate, declaration, source)
    }
    // A C vector is one first-class LLVM vector, which LLVM passes as the C compilers do (SIMD-010).
    Abi.Vector => {
      let bits = Shared<Type>.with<usize>(&lane.ty, CAbi.vectorLaneBits)
      if bits == usize.ZERO { fail Gap.fromSource(GapCode.CAbiAggregate, declaration, source) }
      let mut element = run integerType(&mut writer.*, bits)
      if Shared<Type>.with<bool>(&lane.ty, CAbi.vectorFloating) { element = run Module.floating(&mut writer.*.module, bits) }
      return run Module.vector(&mut writer.*.module, Shared<Type>.with<usize>(&lane.ty, CAbi.vectorBits) / bits, element)
    }
  }
  return run integerType(&mut writer.*, lane.layout.size * 8)
}

fn pieceRepresentation(piece: CPiece) -> Representation {
  return Representation {aggregate: false, size: usize.ZERO, bits: piece.bits, signed: false,
    unit: false, pointer: piece.abi == Abi.Pointer, floating: piece.abi == Abi.Floating, lanes: piece.lanes, unionAlignment: usize.ZERO}
}

effect fn coercionType(writer: &mut Writer, lane: &CAbi.Lane) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let parts = List<CPiece>.asSlice(&lane.pieces)
  let first = run typeOf(&mut writer.*, pieceRepresentation(parts[usize.ZERO]))
  if lane.grouped { return run Module.array(&mut writer.*.module, parts.length, first) }
  if parts.length == usize.ONE { return first }
  let mut fields = List<u64>.make()
  let mut at = usize.ZERO
  while at < parts.length {
    run List<u64>.append(&mut fields, run typeOf(&mut writer.*, pieceRepresentation(parts[at])))
    at = at + usize.ONE
  }
  return run Module.structure(&mut writer.*.module, List<u64>.asSlice(&fields))
}

effect fn cStorageType(writer: &mut Writer, lane: &CAbi.Lane) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let byte = run integerType(&mut writer.*, 8)
  return run Module.array(&mut writer.*.module, lane.layout.size, byte)
}

// `sret([N x i8]) align A`.
effect fn cSretEncoding(writer: &mut Writer, lane: &CAbi.Lane) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  let storage = run cStorageType(&mut writer.*, lane)
  let mut encoding = List<u64>.make()
  run appendTypeAttribute(&mut encoding, Bitcode.attrStructRet(), storage)
  run appendValueAttribute(&mut encoding, Bitcode.attrAlign(), lane.layout.alignment)
  return move encoding
}

fn cParameterCount(lane: &CAbi.Lane) -> usize {
  if lane.passing == CPassing.Ignore { return usize.ZERO }
  if lane.passing == CPassing.Coerce && !lane.grouped { return List<CPiece>.length(&lane.pieces) }
  return usize.ONE
}

effect fn cParameterType(writer: &mut Writer, lane: &CAbi.Lane, part: usize) -> u64 ! OutOfMemoryError ? &mut Allocator {
  if lane.passing == CPassing.Indirect { return run pointerType(&mut writer.*) }
  if lane.passing == CPassing.Coerce {
    if lane.grouped { return run coercionType(&mut writer.*, lane) }
    return run typeOf(&mut writer.*, pieceRepresentation(List<CPiece>.asSlice(&lane.pieces)[part]))
  }
  // Direct lanes need no source position: their scalar admission and layout are already checked.
  if lane.layout.abi == Abi.Vector {
    return run typeOf(&mut writer.*, Representation {aggregate: false, size: usize.ZERO,
      bits: Shared<Type>.with<usize>(&lane.ty, CAbi.vectorLaneBits), signed: false, unit: false,
      pointer: false, floating: Shared<Type>.with<bool>(&lane.ty, CAbi.vectorFloating),
      lanes: Shared<Type>.with<usize>(&lane.ty, CAbi.vectorBits) / Shared<Type>.with<usize>(&lane.ty, CAbi.vectorLaneBits), unionAlignment: usize.ZERO})
  }
  return run typeOf(&mut writer.*, Representation {aggregate: false, size: usize.ZERO,
    bits: lane.layout.size * 8, signed: false, unit: lane.layout.abi == Abi.Unit,
    pointer: lane.layout.abi == Abi.Pointer, floating: lane.layout.abi == Abi.Floating, lanes: usize.ZERO, unionAlignment: usize.ZERO})
}

// The attributes each part of a C parameter lane carries: `byval` and its stack alignment for an
// indirect lane, `alignstack` for a grouped coercion, and the extension of a direct one.
effect fn cParameterEncoding(writer: &mut Writer, lane: &CAbi.Lane) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  let mut encoding = List<u64>.make()
  if lane.passing == CPassing.Indirect {
    if lane.byval {
      let storage = run cStorageType(&mut writer.*, lane)
      run appendTypeAttribute(&mut encoding, Bitcode.attrByVal(), storage)
      run appendValueAttribute(&mut encoding, Bitcode.attrAlign(), lane.stackAlignment)
    }
    return move encoding
  }
  if lane.passing == CPassing.Coerce {
    if lane.grouped && lane.stackAlignment != usize.ZERO {
      run appendValueAttribute(&mut encoding, Bitcode.attrAlignStack(), lane.stackAlignment)
    }
    return move encoding
  }
  if lane.passing == CPassing.Direct { run appendExtension(&mut encoding, lane.extension) }
  return move encoding
}

// The function type of a C signature: its result lane, a leading result address when the result
// is returned indirectly, and each parameter lane's parts.
effect fn cFunctionType(writer: &mut Writer, called: &CAbi.Signature) -> u64 ! Gap | OutOfMemoryError ? &mut Allocator {
  let result = run cLaneType(&mut writer.*, &called.result, &called.declaration, &called.source)
  let mut types = List<u64>.make()
  if called.result.passing == CPassing.Indirect { run List<u64>.append(&mut types, run pointerType(&mut writer.*)) }
  let parameters = List<CAbi.Lane>.asSlice(&called.parameters)
  let mut at = usize.ZERO
  while at < parameters.length {
    let mut part = usize.ZERO
    while part < cParameterCount(&parameters[at]) {
      run List<u64>.append(&mut types, run cParameterType(&mut writer.*, &parameters[at], part))
      part = part + usize.ONE
    }
    at = at + usize.ONE
  }
  return run Module.function(&mut writer.*.module, result, List<u64>.asSlice(&types), called.variadic)
}

// The attribute list of a C signature's calls, or of its declaration when `declaration`, which
// also names a WebAssembly import's module and field.
effect fn cAttributes(writer: &mut Writer, called: &CAbi.Signature, declaration: bool) -> u64 ! OutOfMemoryError ? &mut Allocator {
  let mut lanes = signature()
  let mut encoding = List<u64>.make()
  run appendExtension(&mut encoding, called.result.extension)
  run addAttributes(&mut lanes, Bitcode.positionResult(), List<u64>.asSlice(&encoding))
  let mut position: u64 = 1
  if called.result.passing == CPassing.Indirect {
    let sret = run cSretEncoding(&mut writer.*, &called.result)
    run addAttributes(&mut lanes, position, List<u64>.asSlice(&sret))
    position = position + 1
  }
  let parameters = List<CAbi.Lane>.asSlice(&called.parameters)
  let mut at = usize.ZERO
  while at < parameters.length {
    let mut part = usize.ZERO
    while part < cParameterCount(&parameters[at]) {
      let parameter = run cParameterEncoding(&mut writer.*, &parameters[at])
      run addAttributes(&mut lanes, position, List<u64>.asSlice(&parameter))
      position = position + 1
      part = part + usize.ONE
    }
    at = at + usize.ONE
  }
  if declaration && Bytes.length(&called.importModule) > usize.ZERO {
    let mut imported = List<u64>.make()
    run appendStringAttribute(&mut imported, b"wasm-import-module", Bytes.asSlice(&called.importModule))
    run appendStringAttribute(&mut imported, b"wasm-import-name", Bytes.asSlice(&called.importName))
    run addAttributes(&mut lanes, Bitcode.positionFunction(), List<u64>.asSlice(&imported))
  }
  return run attributeList(&mut writer.*, &lanes)
}

// Coercion registers can be wider than the final bytes of a record on AAPCS64. Load only the
// actual object bytes, then extend the register; never read beyond the source allocation.
effect fn loadCPiece(writer: &mut Writer, lane: &CAbi.Lane, part: CPiece, source: u64) -> Value
! OutOfMemoryError ? &mut Allocator {
  let full = pieceRepresentation(part)
  let mut stored = full
  if part.abi == Abi.Integer && part.lanes == usize.ZERO && stored.bits > (lane.layout.size - part.offset) * 8 {
    stored.bits = (lane.layout.size - part.offset) * 8
  }
  let address = run byteOffset(&mut writer.*, source, part.offset)
  let loaded = Value {scalar: stored, value: run loadOf(&mut writer.*, stored, address, usize.ONE)}
  if stored.bits != full.bits { return run castOf(&mut writer.*, Bitcode.castZExt(), &loaded, full) }
  return loaded
}

effect fn storeCPiece(writer: &mut Writer, lane: &CAbi.Lane, part: CPiece, value: u64, destination: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let full = pieceRepresentation(part)
  let mut stored = Value {scalar: full, value: value}
  if part.abi == Abi.Integer && part.lanes == usize.ZERO && full.bits > (lane.layout.size - part.offset) * 8 {
    let mut narrowed = full
    narrowed.bits = (lane.layout.size - part.offset) * 8
    stored = run castOf(&mut writer.*, Bitcode.castTrunc(), &stored, narrowed)
  }
  let address = run byteOffset(&mut writer.*, destination, part.offset)
  return run storeOf(&mut writer.*, stored.value, address, usize.ONE)
}

effect fn readCRecord(writer: &mut Writer, lane: &CAbi.Lane, source: u64) -> u64
! OutOfMemoryError ? &mut Allocator {
  let parts = List<CPiece>.asSlice(&lane.pieces)
  if parts.length == usize.ONE && !lane.grouped {
    let value = run loadCPiece(&mut writer.*, lane, parts[usize.ZERO], source)
    return value.value
  }
  let ty = run coercionType(&mut writer.*, lane)
  let mut combined = run Module.poison(&mut writer.*.module, ty)
  let mut at = usize.ZERO
  while at < parts.length {
    let value = run loadCPiece(&mut writer.*, lane, parts[at], source)
    combined = run Module.insertValue(&mut writer.*.module, combined, value.value, at)
    at = at + usize.ONE
  }
  return combined
}

effect fn writeCRecord(writer: &mut Writer, lane: &CAbi.Lane, value: u64, destination: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let parts = List<CPiece>.asSlice(&lane.pieces)
  let mut at = usize.ZERO
  while at < parts.length {
    let mut piece = value
    if lane.grouped || parts.length > usize.ONE { piece = run Module.extractValue(&mut writer.*.module, value, at) }
    run storeCPiece(&mut writer.*, lane, parts[at], piece, destination)
    at = at + usize.ONE
  }
  return ()
}

effect fn classifiedLane(function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  ty: &Shared<Type>, span: Location, result: bool) -> CAbi.Lane
! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<CAbi.Lane>.Some {value} = move run CAbi.classify(ty, layouts, target, result) { return move value }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.relative(GapCode.ForeignAbi, &owner, span)
}

effect fn classifiedParameters(function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  parameters: &[Shared<Type>], result: &CAbi.Lane, span: Location) -> List<CAbi.Lane>
! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut lanes = List<CAbi.Lane>.make()
  let mut at = usize.ZERO
  while at < parameters.length {
    let lane = run classifiedLane(function, target, layouts, &parameters[at], span, false)
    if lane.layout.abi == Abi.Unit {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.UnitParameter, &owner, span)
    }
    run List<CAbi.Lane>.append(&mut lanes, move lane)
    at = at + usize.ONE
  }
  CAbi.assignArguments(&mut lanes, result, target)
  return move lanes
}


/// One statically evaluated C scalar that initializes an exported C object.
pub union ObjectConstant {
  Integer {pub negative: bool, pub magnitude: u64},
  /// Binary32 bits when `single`, otherwise binary64 bits.
  Float {pub bits: u64, pub single: bool},
}

// Widens binary32 `bits` exactly to binary64 when `single`.
fn binary64(bits: u64, single: bool) -> u64 {
  if single { return f64.toBits(f32.toF64(f32.fromBits(u64.toU32(bits)))) }
  return bits
}

// The two's complement bits of `magnitude`, negated when `negative`.
fn twosComplement(negative: bool, magnitude: u64) -> u64 {
  if negative { return u64.wrappingSubtract(0, magnitude) }
  return magnitude
}

/// Defines one exported C object as a fragment: a global of its value lane under its symbol,
/// initialized by `constant`. An import of the same C type is `foreignDeclarations` of this signature.
pub effect fn exportedObject(signature: &CAbi.Signature, constant: &ObjectConstant) -> Bytes
! Gap | OutOfMemoryError
? &mut Allocator {
  let pointer = match signature.result.layout.abi {
    Abi.Pointer => true
    _ => false
  }
  if pointer { fail Gap.fromSource(GapCode.ForeignStatic, &signature.declaration, &signature.source) }
  let mut writer = run writerOfWidth(usize.ZERO, false)
  let ty = run cLaneType(&mut writer, &signature.result, &signature.declaration, &signature.source)
  let initializer = match &constant.* {
    ObjectConstant.Integer {negative, magnitude} => run Module.int(&mut writer.module, ty, twosComplement(negative, magnitude))
    ObjectConstant.Float {bits, single} => run Module.float(&mut writer.module, ty, binary64(bits, single))
  }
  let defined = run Module.defineObject(&mut writer.module, Bytes.asSlice(&signature.symbol), ty, Bitcode.linkExternal(), false, initializer)
  return run Module.serialize(&writer.module)
}

/// Declares signatures only, each as its own fragment. The final join rejects conflicting native
/// symbols.
pub effect fn foreignDeclarations(foreign: &[CAbi.Signature]) -> List<Declaration>
! Gap | OutOfMemoryError
? &mut Allocator {
  let mut output = List<Declaration>.make()
  let mut at = usize.ZERO
  while at < foreign.length {
    let signature = &foreign[at]
    if signature.variadic && (signature.global || List<CAbi.Lane>.length(&signature.parameters) == usize.ZERO) {
      fail Gap.fromSource(GapCode.CAbiVariadic, &signature.declaration, &signature.source)
    }
    let mut writer = run writerOfWidth(usize.ZERO, false)
    if signature.global {
      // A C object is an external global of its value lane, defined by the C side.
      let ty = run cLaneType(&mut writer, &signature.result, &signature.declaration, &signature.source)
      let declared = run Module.declareObject(&mut writer.module, Bytes.asSlice(&signature.symbol), ty)
    } else {
      let ty = run cFunctionType(&mut writer, signature)
      let attributes = run cAttributes(&mut writer, signature, true)
      let declared = run Module.declareFunction(&mut writer.module, Bytes.asSlice(&signature.symbol), ty, attributes)
    }
    run List<Declaration>.append(
      &mut output,
      Declaration {contract: run CAbi.identity(signature), symbol: run Bytes.copy(Bytes.asSlice(&signature.symbol)),
        text: run Module.serialize(&writer.module)},
    )
    at = at + usize.ONE
  }
  return move output
}

fn sameDeclarationRight(first: &DeclarationId, right: &Shared<DeclarationId>) -> bool {
  return Shared<DeclarationId>.with<bool>(
    right,
    fn(second: &DeclarationId) -> bool {
      return DeclarationId.equals(first, second)
    },
  )
}

/// The fragment marking the functions `symbols` used (ARTIFACT-003): one `@llvm.used` array in
/// the `llvm.metadata` section, which neither the optimizer nor the linker's dead-code elimination
/// looks past.
pub effect fn retained(symbols: &[Bytes]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut writer = run writerOfWidth(usize.ZERO, false)
  let ty = run addressOnlyType(&mut writer)
  let mut elements = List<u64>.make()
  let mut at = usize.ZERO
  while at < symbols.length {
    run List<u64>.append(&mut elements, run Module.functionRef(&mut writer.module, Bytes.asSlice(&symbols[at]), ty))
    at = at + usize.ONE
  }
  let pointer = run pointerType(&mut writer)
  let array = run Module.array(&mut writer.module, symbols.length, pointer)
  let initializer = run Module.aggregate(&mut writer.module, array, List<u64>.asSlice(&elements))
  let used = run Module.defineObject(&mut writer.module, b"llvm.used", array, Bitcode.linkAppending(), false, initializer)
  let section = run Module.section(&mut writer.module, b"llvm.metadata")
  Module.setSection(&mut writer.module, used, section)
  return run Module.serialize(&writer.module)
}
