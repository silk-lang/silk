//! Groups whole small modules into bounded native compilation units within their source package.
//! Hash-prefix partitions split only an overflowing group; definition names never choose a
//! small module's group. Large modules retain their independent symbol shards.
import semantic.ModuleId {InvalidModulePath, ModuleId}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.ownership {Copy}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.testing.testing {AssertionError, Testing}
import silk.num.usize

/// One module's exact package ordinal, stable identity hash, and total fragment size.
pub struct Module {
  pub package: usize,
  pub hash: u64,
  pub bytes: usize,
}

impl Copy for Module {}

struct Partition {start: usize, end: usize, mask: u64}
impl Copy for Partition {}

/// Reports whether modules belong to the same package in the same source origin.
pub fn samePackage(left: &ModuleId, right: &ModuleId) -> bool {
  return ModuleId.sameOrigin(left, right) && ModuleId.samePackage(left, right)
}

/// Returns a representative module index for each group. Modules exceeding `limit` stay alone.
/// Package ordinals must distinguish both source origin and package identity. Hash collisions
/// cannot combine an oversized group: exhausted hashes leave each module separate.
pub effect fn groups(modules: &[Module], limit: usize) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<usize>.make()
  let mut at = usize.ZERO
  while at < modules.length {
    run List<usize>.append(&mut result, at)
    at = at + usize.ONE
  }
  let mut indices = List<usize>.make()
  let mut partitions = List<Partition>.make()
  at = usize.ZERO
  while at < modules.length {
    if modules[at].bytes <= limit {
      let mut first = true
      let mut before = usize.ZERO
      while before < at {
        if modules[before].bytes <= limit && modules[before].package == modules[at].package {
          first = false
          break
        }
        before = before + usize.ONE
      }
      if first {
        let start = List<usize>.length(&indices)
        let mut member = at
        while member < modules.length {
          if modules[member].bytes <= limit && modules[member].package == modules[at].package {
            run List<usize>.append(&mut indices, member)
          }
          member = member + usize.ONE
        }
        run List<Partition>.append(&mut partitions, Partition {start: start, end: List<usize>.length(&indices), mask: 9223372036854775808})
      }
    }
    at = at + usize.ONE
  }
  let mut next = usize.ZERO
  while next < List<Partition>.length(&partitions) {
    let part = List<Partition>.get(&partitions, next)
    let mut total = usize.ZERO
    let mut fits = true
    at = part.start
    while at < part.end {
      let size = modules[List<usize>.get(&indices, at)].bytes
      if size > limit - total {
        fits = false
        break
      }
      total = total + size
      at = at + usize.ONE
    }
    if fits {
      let representative = List<usize>.get(&indices, part.start)
      at = part.start
      while at < part.end {
        List<usize>.set(&mut result, List<usize>.get(&indices, at), representative)
        at = at + usize.ONE
      }
    } else if part.mask != 0 {
      let mut middle = part.start
      at = part.start
      while at < part.end {
        let member = List<usize>.get(&indices, at)
        if (modules[member].hash / part.mask) % 2 == 0 {
          let displaced = List<usize>.get(&indices, middle)
          List<usize>.set(&mut indices, middle, member)
          List<usize>.set(&mut indices, at, displaced)
          middle = middle + usize.ONE
        }
        at = at + usize.ONE
      }
      if middle > part.start {
        run List<Partition>.append(&mut partitions, Partition {start: part.start, end: middle, mask: part.mask / 2})
      }
      if middle < part.end {
        run List<Partition>.append(&mut partitions, Partition {start: middle, end: part.end, mask: part.mask / 2})
      }
    }
    next = next + usize.ONE
  }
  return move result
}

fn together(plan: &List<usize>, left: usize, right: usize) -> bool {
  return List<usize>.get(plan, left) == List<usize>.get(plan, right)
}

effect fn packingClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut modules = List<Module>.make()
  run List<Module>.append(&mut modules, Module {package: 0, hash: 0, bytes: 3})
  run List<Module>.append(&mut modules, Module {package: 0, hash: 4611686018427387904, bytes: 3})
  run List<Module>.append(&mut modules, Module {package: 0, hash: 9223372036854775808, bytes: 6})
  run List<Module>.append(&mut modules, Module {package: 1, hash: 0, bytes: 4})
  run List<Module>.append(&mut modules, Module {package: 0, hash: 0, bytes: 9})
  let original = run groups(List<Module>.asSlice(&modules), 8)
  run Testing.expect(together(&original, 0, 1) && !together(&original, 0, 2), "only the overflowing hash prefix splits")
  run Testing.expect(!together(&original, 0, 3) && !together(&original, 0, 4), "package boundaries and large-module shards remain independent")
  List<Module>.set(&mut modules, 0, Module {package: 0, hash: 0, bytes: 5})
  List<Module>.set(&mut modules, 3, Module {package: 1, hash: 0, bytes: 100})
  let edited = run groups(List<Module>.asSlice(&modules), 8)
  run Testing.expect(together(&edited, 0, 1) && !together(&edited, 0, 2), "body growth within a group and unrelated package growth preserve membership")
  run List<Module>.append(&mut modules, Module {package: 0, hash: 9223372036854775809, bytes: 3})
  let added = run groups(List<Module>.asSlice(&modules), 8)
  run Testing.expect(together(&added, 0, 1) && !together(&added, 2, 5), "adding a module splits only its overflowing prefix")
  List<Module>.set(&mut modules, 1, Module {package: 0, hash: 0, bytes: 5})
  let collision = run groups(List<Module>.asSlice(&modules), 8)
  run Testing.expect(!together(&collision, 0, 1), "a full hash collision cannot exceed the pack limit")
  let mut reversed = List<Module>.make()
  let mut index = List<Module>.length(&modules)
  while index > 0 {
    index = index - usize.ONE
    run List<Module>.append(&mut reversed, List<Module>.get(&modules, index))
  }
  let reverse = run groups(List<Module>.asSlice(&reversed), 8)
  let mut left = usize.ZERO
  while left < List<Module>.length(&modules) {
    let mut right = usize.ZERO
    while right < List<Module>.length(&modules) {
      run Testing.expect(together(&collision, left, right) == together(&reverse, List<Module>.length(&modules) - left - usize.ONE,
        List<Module>.length(&modules) - right - usize.ONE), "discovery order does not change group membership")
      right = right + usize.ONE
    }
    left = left + usize.ONE
  }
  let empty = run groups(&[], 8)
  run Testing.expect(List<usize>.length(&empty) == 0, "an empty program has no definition packs")
}

test effect fn packageCoherentNativePacksPreserveEditLocality() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run packingClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn packageClaims() -> () ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let first = run ModuleId.make(b"workspace", b"library", b"first")
  let second = run ModuleId.make(b"workspace", b"library", b"second")
  let otherOrigin = run ModuleId.make(b"registry", b"library", b"first")
  let otherPackage = run ModuleId.make(b"workspace", b"application", b"first")
  run Testing.expect(samePackage(&first, &second), "different modules in one exact package can share a pack")
  run Testing.expect(!samePackage(&first, &otherOrigin), "identically named packages from different source origins never share a pack")
  run Testing.expect(!samePackage(&first, &otherPackage), "different packages in one source origin never share a pack")
}

test effect fn packageCoherentNativePacksKeepExactOrigins() -> () ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run packageClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
