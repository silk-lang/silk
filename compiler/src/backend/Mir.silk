//! Backend-neutral control flow for one checked scalar function instance.

import backend.DropGlue {Child as GlueChild, Children as GlueChildren, Remainder, RemainderLevel, Variant as GlueVariant}
import backend.CleanupNeeds {CleanupNeeds}
import backend.CAbi
import backend.Gap {Code as GapCode, Gap}
import backend.InstanceKey {HelperRole, InstanceKey}
import backend.RuntimeType
import backend.UnionProjection
import backend.RuntimeType {Projection as RuntimeProjection}
import backend.Layout {Layout}
import semantic.Specialization {Application, Edge}
import semantic.RuntimeEncoding
import semantic.StaticValue
import semantic.StaticValue {FloatType as StaticFloatType, Sign as StaticSign, Value as StaticData}
import hir.FloatingLiteral
import silk.f32
import silk.f64
import silk.format {ParseError}
import silk.result {Result}
import silk.u32
import silk.u64
import hir.Hir {Access, CallableMode, HirId, InfixOperator, Module, Multiplicity, Node as HirNode, OwnerKind, PrefixOperator, Sign}
import lexer.Span {Span}
import semantic.Lifetime {CanonicalizationFailure, Lifetime}
import semantic.ModuleId {ModuleId}
import semantic.DeclarationId {DeclarationId}
import semantic.Type {Argument, Binding, ArrayShape, CallableFieldInput, Requirement, Row, RowParameter, Type}
import semantic.Lifetime {Intersection, Member as Region}
import semantic.Intrinsic as CheckedIntrinsic
import semantic.SealedCore
import semantic.SealedCore {Field as CoreField, Lifecycle}
import semantic.StorageOperation {StorageOperation}
import semantic.Intrinsic {Member as IntrinsicMember, Primitive as IntrinsicPrimitive}
import semantic.NativeAssembly
import semantic.NativeAssembly {Memory as AssemblyMemory}
import semantic.ScalarOperation {Code as ScalarCode, Scalar, ScalarOperation}
import semantic.TypedBody {
  ConsumedPlace as BodyConsumedPlace,
  Expression as BodyExpression,
  PlaceRoot as BodyPlaceRoot,
  AggregateField as BodyAggregateField,
  EnumMember as BodyEnumMember,
  MatchArm as BodyMatchArm,
  MatchSyntax as BodyMatchSyntax,
  Pattern as BodyPattern,
  SubjectAccess as BodySubjectAccess,
  UnionMember as BodyUnionMember,
  PlaceStep as BodyPlaceStep,
  PatternTest as BodyPatternTest,
  NodeId as BodyNodeId,
  NodeKind as BodyNodeKind,
