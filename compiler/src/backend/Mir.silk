/// One local storage slot. Positions are stable within this MIR answer only.
pub struct Local {
  pub ty: Interned<Type>,
  pub kind: LocalKind,
  pub origin: Origin,
}

pub union LocalKind {
  Return,
  Parameter {pub index: usize},
  User {pub index: usize},
  Temp,
  /// The caller-owned failure out-slot of a function whose failure type is not `never` (Effect
  /// note D3). `Fail` exits with it initialized.
  Failure,
  /// The address of the provider of requirement entry `index`, in canonical key order (D2).
  Provider {pub index: usize},
  /// The address of the current diagnostic observer record `[callback, state]`, or null, in a
  /// program that observes diagnostics (failure observer note N1).
  Observer,
  /// The address of the context of the failure the current recovery handler selected, or null
  /// when none is selected (N2).
  Cause,
  /// The address of the `string<'static>` site label of the call that entered the function's
  /// package, or null when no call entered it, such as for an independent invocation. A source
  /// trap reports there, so a violated library precondition names the line that misused the
  /// library (TERM-008).
  Site,
  /// A `bool` recording whether the cleanup component at `local` plus canonical `path` is live
  /// on this runtime path. Distinct independently mutable children have independent flags;
  /// the exact prepared component glue remains part of the lowering proof (MIR core shape §3).
  DropFlag {pub local: usize, pub path: List<Projection>},
}

pub struct Place {
  pub local: usize,
  pub projections: List<Projection>,
}

pub union Projection {
  Field {pub index: usize},
  /// The member storage of a structural union selected by canonical tag `index`.
  Payload {pub index: usize, pub ty: Interned<Type>},
  /// One field of the nominal union variant with declaration-order tag `variant`.
  VariantField {pub variant: usize, pub field: usize},
  Index {pub local: usize},
  ConstIndex {pub index: usize},
  Deref,
}

pub union Operand {
  Copy {pub place: Place},
  Move {pub place: Place},
  Integer {pub decimal: Bytes, pub negative: bool, pub ty: Interned<Type>},
  Float {pub bits: u64, pub ty: Interned<Type>},
  Boolean {pub value: bool},
  Unit,
  /// The address of immutable program-lifetime storage holding exactly `bytes`.
  StaticBytes {pub bytes: Bytes},
  /// The address of an immutable program-lifetime `string<'static>` descriptor of `bytes`.
  StaticText {pub bytes: Bytes},
  /// The address of immutable program-lifetime storage holding the constant `value` of type `ty`,
  /// which a shared borrow of a constant views (BORROW-006).
  StaticValue {pub value: Interned<StaticData>, pub ty: Interned<Type>},
  /// A null address of pointer type `ty`: no observer or no selected failure (N1, N2).
  Null {pub ty: Interned<Type>},
}

/// One aggregate operand evaluated in written order and stored at its canonical field.
pub struct AggregateField {
  pub index: usize,
  pub value: Operand,
}

pub union Rvalue {
  Aggregate {pub fields: List<AggregateField>},
  /// A borrowed descriptor stores an address and an ordinary unsigned usize count operand.
  Slice {pub data: Operand, pub count: Operand},
  /// Reads the runtime length stored in a descriptor place.
  SliceLength {pub place: Place},
  /// Reads the data address stored in a descriptor place.
  SliceData {pub place: Place},
  /// Advances a many-element address by `index` elements of type `element`.
  PointerOffset {pub pointer: Operand, pub index: Operand, pub element: Interned<Type>},
  Use {pub value: Operand},
  Ref {pub access: Access, pub place: Place},
  AddressOf {pub access: Access, pub place: Place},
  Unary {pub operation: PrefixOperator, pub value: Operand},
  Binary {pub operation: InfixOperator, pub left: Operand, pub right: Operand},
  /// A scalar operation with no source operator; both operands have the same scalar type.
  ScalarBinary {pub operation: ScalarBinary, pub left: Operand, pub right: Operand},
  /// A floating-point classification or square root.
  ScalarUnary {pub operation: ScalarUnary, pub value: Operand},
  /// Converts a numeric scalar to the numeric scalar `ty`. An integer result outside `ty`'s range
  /// traps, as does a NaN or out-of-range floating source of an integer result; an integer or
  /// wider floating source of a floating result rounds to nearest, ties to even.
  Convert {pub value: Operand, pub ty: Interned<Type>},
  /// Whether an integer is exactly representable as the integer `ty`; for `char`, whether it is a
  /// Unicode scalar value.
  Fits {pub value: Operand, pub ty: Interned<Type>},
  /// Compiler expansion transports native data-address bits through exactly target usize.
  AddressIntegerConversion {pub operand: Operand, pub destinationType: Interned<Type>},
  Bitcast {pub value: Operand, pub ty: Interned<Type>},
  /// Reads a structural union's tag from its place.
  Discriminant {pub place: Place},
  /// Stores `value` as the union member with canonical tag `tag`.
  Inject {pub tag: usize, pub value: Operand},
  /// Stores a nominal union variant: its tag, then each operand at its variant field.
  Variant {pub tag: usize, pub fields: List<AggregateField>},
  /// The address of the selected function instance `key` (an observer callback, N1).
  FunctionAddress {pub key: InstanceKey},
  /// The address of failure slot `place`'s context companion: a selected cause (N2).
  ContextOf {pub place: Place},
  /// The observer pool handle stored in the context companion at `address` (N7).
  ContextHandle {pub address: Operand},
  /// Reads the current value of an imported C object through its symbol's address, or with
  /// `address`, is that address: the referent of a shared borrow of the object.
  ForeignStatic {pub declaration: Interned<DeclarationId>, pub address: bool},
  /// The erased address of the execution package whose frames the running frame belongs to, or
  /// null outside any package. Only a frame-based instance reads it.
  RunningPackage,
  /// The address of the running function's native stack frame (`Intrinsic.frameAddress`).
  FrameAddress,
  /// The address of the running instance's process word (`Intrinsic.processWord`): one
  /// zero-initialized `u64` per function instance that lives as long as the process.
  ProcessWord,
  /// Uninitialized stack storage for `count` elements of `element`, naturally aligned, that lives
  /// until the running function returns (`Intrinsic.stackAllocate`).
  StackAllocate {pub count: Operand, pub element: Interned<Type>},
  /// One WebAssembly memory instruction (`Intrinsic.wasmMemorySize`, `wasmMemoryGrow`,
  /// `wasmAtomicWait32` or `wasmAtomicNotify`) with its operands in written order. Its result is
  /// the primitive's closed result.
  Wasm {pub primitive: IntrinsicPrimitive, pub operands: List<Operand>},
  /// Sets every byte of the destination array to `byte`: a repeat literal of a constant element
  /// whose bytes all equal `byte`, such as `[false; N]` or `[0; N]`, filled with one memset.
  Fill {pub byte: u8},
  /// One admitted literal machine fragment (ASSEMBLY-001) over its operand lanes. Its result is
  /// `ty`; a unit fragment has no output and a no-return fragment ends its block.
  /// The fragment is boxed so this rare variant does not size every rvalue and statement.
  Assembly {pub fragment: Box<AssemblyFragment>},
  /// One atomic memory operation or fence (ATOMIC-002 through ATOMIC-004) over `element`, the
  /// pointee of its first operand, or unit for a fence. A compare-exchange yields its success
  /// flag and writes the observed value through its second operand when it fails; `failure` is
  /// its failure ordering and equals `success` for every other operation.
  Atomic {
    pub primitive: IntrinsicPrimitive,
    pub operands: List<Operand>,
    pub success: MemoryOrder,
    pub failure: MemoryOrder,
    pub element: Interned<Type>,
  },
  /// One SIMD vector operation (SIMD-003) whose result is `ty`, with its operands in written order.
  /// A lane index operand is already checked against the lane count, and a slice load or store is
  /// already a pointer load or store of checked elements.
  Vector {pub primitive: IntrinsicPrimitive, pub operands: List<Operand>, pub ty: Interned<Type>},
}

/// The parts of one admitted literal machine fragment (`Rvalue.Assembly`).
pub struct AssemblyFragment {
  pub template: Bytes,
  pub constraints: Bytes,
  pub clobbers: Bytes,
  pub memory: AssemblyMemory,
  pub sideEffects: bool,
  pub noReturn: bool,
  pub inputs: List<Operand>,
  pub ty: Interned<Type>,
}

/// An integer or floating-point operation selected by a sealed scalar intrinsic that no source
/// operator spells.
pub enum ScalarBinary {
  /// Traps unless the count is less than the operand width.
  ShiftLeft,
  /// Logical for unsigned and arithmetic for signed operands; traps unless the count is less than
  /// the operand width.
  ShiftRight,
  /// Rotates by the count modulo the operand width.
  RotateLeft,
  RotateRight,
  /// Modulo 2^width arithmetic.
  WrappingAdd,
  WrappingSubtract,
  WrappingMultiply,
  /// Clamps at the operand type's minimum or maximum.
  SaturatingAdd,
  SaturatingSubtract,
  SaturatingMultiply,
  /// The high half of the exact double-width product, signed or unsigned as the operands are.
  MultiplyHigh,
  /// IEEE 754 totalOrder of two floating values: whether `left` orders before or equals `right`.
  TotalOrder,
  /// Whether the exact sum, difference or product leaves the operand type's range.
  AddOverflows,
  SubtractOverflows,
  MultiplyOverflows,
  /// Whether `left / right` is undefined: a zero divisor, or the signed minimum divided by -1.
  DivisionUndefined,
}

/// A floating-point operation selected by a sealed scalar intrinsic.
pub enum ScalarUnary {
  IsNaN,
  IsInfinite,
  IsFinite,
  IsNormal,
  IsSubnormal,
  IsSignNegative,
  /// The correctly rounded IEEE 754 square root.
  Sqrt,
}

pub union Statement {
  Assign {pub destination: Place, pub value: Rvalue, pub origin: Origin},
  /// Calls the exact selected glue of a complete place. Lifetimes remain semantic evidence;
  /// emission resolves this key's compatible runtime recipe after closing the instance graph.
  Drop {pub destination: Place, pub glue: InstanceKey, pub diagnostics: Option<Diagnostics>, pub origin: Origin},
  /// Writes the context companion of failure slot `destination` (failure observer note N3).
  /// Without `source` it originates the context at `origin`: the identity of the slot's active
  /// member and the site label, both from the function's `contexts` table. With `source` it
  /// carries the companion of that failure slot. Layout gives every failure slot a fixed-size
  /// companion; a call edge's callee writes its destination's companion directly.
  FailureContext {pub destination: Place, pub source: Option<Place>, pub origin: Origin},
  /// Stores `value` as the observer pool handle of the context companion at `address` (N7).
  SetContextHandle {pub address: Operand, pub value: Operand, pub origin: Origin},
}

pub union Terminator {
  Goto {pub target: usize, pub origin: Origin},
  Branch {pub condition: Operand, pub thenBlock: usize, pub elseBlock: usize, pub origin: Origin},
  Return {pub origin: Origin},
  Call {
    pub callee: Callee,
    pub arguments: List<Operand>,
    /// Provider addresses in the callee's canonical requirement-key order (D2).
    pub providers: List<Operand>,
    /// Present exactly when the program observes diagnostics and the callee is a Silk function (N1).
    pub diagnostics: Option<Diagnostics>,
    pub destination: Place,
    pub normal: usize,
    /// Present exactly when the callee's failure type is not `never`.
    pub failure: Option<FailureEdge>,
    pub origin: Origin,
  },
  /// Exits through the caller's failure out-slot with the `Failure` local initialized.
  Fail {pub origin: Origin},
  /// Stops the program; under an observer it first reports `reason` at its site (event 6, TERM-008).
  Trap {pub reason: TrapReason, pub origin: Origin},
  /// Stops the program for `reason`, the `string<'static>` a source `Intrinsic.trap` supplies;
  /// under an observer it first reports that text at its site (event 6, TERM-008).
  TrapText {pub reason: Operand, pub origin: Origin},
  Unreachable {pub origin: Origin},
  /// Jumps to the case whose value equals the scalar operand, or to `otherwise` for every other value.
  Switch {pub value: Operand, pub cases: List<SwitchCase>, pub otherwise: usize, pub origin: Origin},
  /// Leaves the running package's frames in the package and returns its activation to the drive;
  /// the next drive continues at `resume`. Only a frame-based instance lowers it, inside a package.
  Relinquish {pub resume: usize, pub origin: Origin},
  /// Ends a cancelled frame after the drops of its cancel exit: the frame is released and its
  /// caller's frame cancels in turn. No result or failure is written.
  Abandon {pub origin: Origin},
}

/// Where a fallible callee writes its failure value, typed by the callee's failure type, and the
/// block that converts it and leaves the scopes it exits (MIR core shape §3).
pub struct FailureEdge {
  pub destination: Place,
  pub target: usize,
}

/// The hidden operands of a Silk callee in a program that observes diagnostics, after its
/// providers (failure observer note N1, N2). The operands are boxed so that calls and drops in a
/// program that does not observe diagnostics stay small.
pub struct Diagnostics {
  operands: Box<DiagnosticOperands>,
}

struct DiagnosticOperands {
  observer: Operand,
  cause: Operand,
  site: Operand,
}

impl Diagnostics {
  /// Hidden operands passing `observer`, `cause` and the package entry `site`.
  pub effect fn make(observer: Operand, cause: Operand, site: Operand) -> Diagnostics ! OutOfMemoryError ? &mut Allocator {
    let operands = DiagnosticOperands {observer: move observer, cause: move cause, site: move site}
    return Diagnostics {operands: run Box<DiagnosticOperands>.make(move operands)}
  }
  /// The package entry site operand.
  pub fn site(self: &Self) -> &Operand {
    return &Box<DiagnosticOperands>.get(&self.operands)[0].site
  }
  /// The observer address operand.
  pub fn observer(self: &Self) -> &Operand {
    return &Box<DiagnosticOperands>.get(&self.operands)[0].observer
  }
  /// The selected-cause operand.
  pub fn cause(self: &Self) -> &Operand {
    return &Box<DiagnosticOperands>.get(&self.operands)[0].cause
  }
}

/// One distinct switch value in sign-magnitude decimal form and its target block.
pub struct SwitchCase {
  pub decimal: Bytes,
  pub negative: bool,
  pub target: usize,
}

/// Direct Silk and C callees keep separate identities and worklist edges.
pub union Callee {
  Instance {pub key: InstanceKey},
  Extern {pub declaration: Interned<DeclarationId>, pub variadicArguments: List<CAbi.VariadicArgument>},
  /// A Silk function reached through its address: an observer callback (N4).
  Indirect {pub address: Operand},
  /// A synchronous native C pointer, retaining its closed scalar ABI signature.
  NativeIndirect {pub address: Operand, pub signature: Interned<Type>},
}

pub struct Block {
  pub statements: List<Statement>,
  pub terminator: Terminator,
}

/// One `Intrinsic.NonParking` obligation of a body. A site obligation is a nonparking finalizer
/// or release whose proof no `Intrinsic.NonParking` premise of the instance carries, or a call of
/// a service operation declared `@nonParking`. An entry obligation is an
/// `Intrinsic.NonParking` premise of the instance itself, owed by the call that reaches it. None of
/// `callees`, the instances that run the obligated value, may reach an external park.
pub struct NonParkingRun {
  pub callees: List<InstanceKey>,
  /// The types whose drop glue running or dropping the obligated value may execute in place: its
  /// own value, a bracket's resource, a binding's provider, an observer's state. A reached glue of
  /// one of them may not park either; an unreached one never runs.
  pub glues: List<Interned<Type>>,
  /// Declarations whose every reached instance runs an obligated value: a named function
  /// value whose deferred binders each use opens (a callable schema).
  pub declarations: List<Interned<DeclarationId>>,
  /// Whether every obligated value has an exact executable target; one without is unproved
  /// (SEM0139, the bootstrap's `Unavailable:exact execution target`).
  pub exact: bool,
  /// The obligated site; absent for an entry obligation.
  pub origin: Option<Origin>,
}

/// The answer for one instance. `references` is the backend-independent worklist edge set.
pub struct MirFunction {
  pub key: InstanceKey,
  /// The body's borrow-checking status; MIR construction never discharges pending obligations.
  pub borrow: BodyBorrowStatus,
  pub result: Interned<Type>,
  pub parameters: List<Interned<Type>>,
  pub locals: List<Local>,
  pub blocks: List<Block>,
  pub references: List<Reference>,
  pub externs: List<Interned<DeclarationId>>,
  /// Whether this function runs an `observeDiagnostics` scope, which makes the program observe
  /// diagnostics (failure observer note N1).
  pub observes: bool,
  /// The texts each originating `FailureContext` writes, by origin (N3).
  pub contexts: List<ContextText>,
  /// The site label of each statement whose emission may trap, by origin, reported to the
  /// current observer before the trap (event 6, N7). Empty when the program does not observe.
  pub traps: List<TrapSite>,
  /// The first explicit suspension boundary this function runs, which makes it a suspension
  /// origin (SUSP-001); absent for an instance that runs none.
  pub suspension: Option<Origin>,
  /// The first external park this function runs: an `Intrinsic.relinquish` or
  /// `Intrinsic.executionCurrent`, which only a frame running in an Execution package can reach.
  /// A nested transfer through `Effect.suspend` marks [`suspension`] only. Absent for an instance
  /// that runs no external park.
  pub parks: Option<Origin>,
  /// Whether this body releases an Execution package through its erased drop: completing a
  /// drive, destroying a notified package, or dropping the handle. That drop runs the package
  /// glue of whichever package the handle names.
  pub releasesPackages: bool,
  /// The `Intrinsic.NonParking` obligations this body owes at its own sites, in lowering order.
  /// The build proves each one against the closed external-park set (SEM0139).
  pub nonParking: List<NonParkingRun>,
  /// The cancel exit of each suspension point, in a suspendable instance's frame variant only.
  pub cancels: List<Cancel>,
  /// The local-shared accesses this function holds while their callbacks run (SHARED-003).
  pub accesses: List<SharedAccess>,
  /// This body's own runs and direct readiness notifications, which no function reached from a
  /// held access's callback may contain (SHARED-003).
  pub escapes: List<EscapeSite>,
  /// The LLVM `target-features` text of a function written with `features` (SIMD-009), such as
  /// `+avx,+avx2,+sse2`; empty for every other function.
  pub features: Bytes,
  /// How callers inline a function written with an inline clause; `Default` for every other one.
  pub inlining: Inlining,
  /// Whether the function is written `@optimizeSize`, so LLVM builds it for size (`optsize` and
  /// `minsize`) whatever the build's profile.
  pub optimizeSize: bool,
  /// The name a trap's call chain prints for this function's frame, `module.function`, in a
  /// program that observes diagnostics; empty in any other.
  pub frame: Bytes,
  /// For a build with line tables, the source place of each position a location marker names: a
  /// position (`LlvmCode.locate`) and then `line << 24 | column`, both 1-based, per entry, sorted
  /// by position. Empty in any other build. The emitted markers carry these, so the text, and the
  /// object a codegen unit caches, changes whenever a line it names moves.
  pub lines: List<u64>,
  /// For a build with line tables, the written parameters and bindings a debugger shows, in local
  /// order. Empty in any other build.
  pub variables: List<Variable>,
}

/// One written parameter or binding of a function built with line tables: its local, the name it
/// is written with, where it is declared (`line << 24 | column`), and its 1-based parameter
/// position, or 0 for a binding.
pub struct Variable {
  pub local: usize,
  pub name: Bytes,
  pub place: u64,
  pub argument: usize,
}

/// What a function's `@inline`, `@inlineAlways`, `@inlineNever` or `@cold` directive asks of the
/// optimizer: LLVM's `inlinehint`, `alwaysinline`, `noinline`, or `cold` with `noinline`.
pub enum Inlining {
  Default,
  Hint,
  Always,
  Never,
  Cold,
}

/// The LLVM function attribute `inlining` writes: `inlinehint`, `alwaysinline` or `noinline`, and
/// empty for `Default`.
pub fn inliningAttribute(inlining: Inlining) -> &'static [u8] {
  return match inlining {
    Inlining.Default => b""
    Inlining.Hint => b"inlinehint"
    Inlining.Always => b"alwaysinline"
    Inlining.Never => b"noinline"
    Inlining.Cold => b"cold"
  }
}

/// One `sharedWithMut` access a function holds, and the instance of its `use` callback.
pub struct SharedAccess {
  pub callback: InstanceKey,
  pub origin: Origin,
}

/// What would leave a local-shared access from a function its callback reaches (SHARED-003).
pub enum AccessEscape {
  /// A `run`, which may suspend while the access is held.
  Suspension,
  /// A direct `executionNotify`, which may re-enter the accessed state.
  Callback,
}

pub struct EscapeSite {
  pub kind: AccessEscape,
  pub origin: Origin,
}

/// The block whose terminator is a suspension point, and the block that drops every owner live
/// there and abandons the frame when its package is dropped while suspended.
pub struct Cancel {
  pub point: usize,
  pub entry: usize,
}

impl Copy for Cancel {}

/// One lowered body and the erased helpers of the execution packages it adopts, lowered with it
/// because they run its prepared invocations. Storing the function stores each helper after it.
pub struct Lowered {
  pub function: MirFunction,
  pub helpers: List<MirFunction>,
}

/// The identity of each canonical member of a failure slot's type (one when it is not a union),
/// selected by the runtime tag, and the site label `module.function (module:line:column)`.
pub struct ContextText {
  pub origin: Origin,
  pub identities: List<Bytes>,
  pub label: Bytes,
}

/// The site label `module.function (module:line:column)` an observed trap at `origin` reports.
pub struct TrapSite {
  pub origin: Origin,
  pub label: Bytes,
}

/// Why a `Trap` terminator stops the program: a failed bounds, layout or execution-control check.
pub enum TrapReason {
  IndexOutOfBounds,
  SliceRangeOutOfBounds,
  RawBufferRangeOutOfBounds,
  InvalidRawBufferLayout,
  InvalidSharedAllocationLayout,
  SharedCountOverflow,
  InvalidExecutionAllocationLayout,
  InvalidExecutionControlWord,
  InvalidExecutionDrive,
  RelinquishOutsideExecution,
  ExecutionReferenceOutsideExecution,
}

/// The reason text an observed trap reports in its `fatal trap` line (TERM-008).
pub fn trapReasonText(reason: TrapReason) -> &'static [u8] {
  return match reason {
    TrapReason.IndexOutOfBounds => b"index out of bounds"
    TrapReason.SliceRangeOutOfBounds => b"slice range out of bounds"
    TrapReason.RawBufferRangeOutOfBounds => b"raw buffer range out of bounds"
    TrapReason.InvalidRawBufferLayout => b"invalid raw buffer layout"
    TrapReason.InvalidSharedAllocationLayout => b"invalid shared allocation layout"
    TrapReason.SharedCountOverflow => b"shared count overflow"
    TrapReason.InvalidExecutionAllocationLayout => b"invalid execution allocation layout"
    TrapReason.InvalidExecutionControlWord => b"invalid execution control word"
    TrapReason.InvalidExecutionDrive => b"invalid execution drive"
    TrapReason.RelinquishOutsideExecution => b"relinquish outside a running execution"
    TrapReason.ExecutionReferenceOutsideExecution => b"execution reference outside a running execution"
  }
}

/// A sorted reached instance with its admission provenance and authored call site.
pub struct Reference {
  pub key: InstanceKey,
  pub edge: Edge,
  pub origin: Origin,
}

// A temporary awaiting the end of its full expression, and how many owners preceded it, which
// places it in the reverse acquisition order of an exit (CLEANUP-002).
struct Pending {
  local: usize,
  owners: usize,
}

// One drop a function exit performs: a cleanup node's value in one state (live, or the flag that
// answers), an open union as exit plan `plan` records its subtree, or a pending temporary (`node`
// is then usize.MAX).
struct ExitDrop {
  node: usize,
  state: usize,
  plan: usize,
  temporary: usize,
}

impl Copy for ExitDrop {}

// How an exit path ends: returning, failing, forwarding a callee's failure through the shared
// forward block, or abandoning a cancelled frame.
enum ExitKind {
  Returns,
  Fails,
  Forwards,
  Abandons,
}

// One node of the function-exit drop trie. Each exit's drops, read outermost first, form a path
// from a root (`next` is usize.MAX) that returns, fails or abandons the frame; exits whose remaining drops agree share
// the end of that path. `count` exits pass through the step, and `block` is its shared block once
// one is needed. A root that forwards names the forward block its paths end in as `forward`.
struct ExitStep {
  next: usize,
  released: ExitDrop,
  kind: ExitKind,
  forward: usize,
  count: usize,
  entries: usize,
  block: usize,
  origin: Origin,
  children: List<usize>,
}

// The forward block that records frames for the observer at `observer`.
struct ForwardBlock {
  observer: Place,
  block: usize,
}

// The slot run sites catch failures of type `ty` in, on their way out of the function.
struct CaughtSlot {
  ty: Interned<Type>,
  local: usize,
}

// A `return`, `fail` or failure propagation whose block is completed once the function ends: its
// drops start at trie step `step`.
struct LeftExit {
  block: usize,
  step: usize,
  origin: Origin,
}

impl Copy for LeftExit {}

struct LoopTargets {
  exit: usize,
  repeat: usize,
  // Owners and temporaries created before the loop; `break` and `continue` drop only later ones.
  owners: usize,
  temporaries: usize,
  // Each cleanup node's state at the loop header (`loopHeads`), which every edge back to `repeat`
  // writes or keeps.
  heads: List<usize>,
  // The owner states on each edge into `exit`, joined when the loop ends.
  exits: List<Arrival>,
}

// One complete partition of a cleanup node's storage: the children of a nominal value or array
// (`tag` is usize.MAX), or of one member or variant tag of a union.
struct CleanupPartition {
  tag: usize,
  children: List<usize>,
}

// One node of an owner's move-path tree: the actual storage path of a whole owner or of a part a
// partial consuming site reaches, with the glue that cleans it whole.
struct CleanupNode {
  place: Place,
  ty: Interned<Type>,
  glue: Option<InstanceKey>,
  partitions: List<CleanupPartition>,
  // A union's canonical member or variant count, which sizes its runtime tag; zero otherwise.
  tags: usize,
  // The node's drop flag (`nodeFlag`), or usize.MAX.
  flag: usize,
}

// One lexical owner, in acquisition order, and the root of its move-path tree.
struct Owner {
  local: usize,
  path: List<Projection>,
  subject: usize,
  ty: Interned<Type>,
  root: usize,
}

// The owners a path holds and the state of every cleanup node on it.
struct OwnerSnapshot {
  owners: usize,
  states: List<usize>,
}

// One edge into a join: its source block and the owner states on that edge.
struct Arrival {
  block: usize,
  states: OwnerSnapshot,
}

// What a consuming site leaves without an owner.
union Release {
  // An owned rvalue: nothing on the cleanup stack changes.
  Value,
  // The complete value of a local.
  Whole {local: usize},
  // A projection of a local (OWN-004), consumed at body node `node`.
  Partial {local: usize, node: usize},
  // A place `steps` deep below match subject node `subject`, inside one of its by-value bindings
  // (MATCH-002), consumed at body node `node`.
  Binding {subject: usize, node: usize, steps: usize},
}

/// A checked call's resolved canonical target, prepared without demanding its body.
/// One written value and its validated specialized target parameter.
pub struct CallOperand {
  pub value: Interned<Type>,
  pub parameter: Interned<Type>,
  pub borrow: Option<Access>,
}

pub struct CallTarget {
  pub node: BodyNodeId,
  /// The canonical callee instance; see [`InstanceKey.withProviders`].
  pub key: InstanceKey,
  /// The call edge's actual application, before `key` numbered its caller regions. Providers are
  /// served from these actual regions.
  pub application: Application,
  pub edge: Edge,
  /// Descriptor projections between a temporary source view and its original environment.
  pub receiverDereferences: usize,
  pub operands: List<CallOperand>,
  /// A section places its environment fields among the written operands in target parameter
  /// order. They are operands of the original direct call, never an adapter or a distinct
  /// instance identity.
  pub stored: Option<StoredArguments>,
  /// Where each provider of the callee's requirement row comes from, in its key order (D2).
  pub providers: List<ProviderSource>,
  /// A service operation's witness receives the dispatched provider's address first (D2).
  pub dispatch: Option<ProviderSource>,
  /// A witness's own declared failure, which may be narrower than the failure its operation
  /// promises (EFF-009). It types the call's failure edge, which widens it into the promised
  /// one's sink; `never` leaves the call without an edge (D3).
  pub witnessFailure: Option<Interned<Type>>,
  /// Whether the callee is a service operation declared `@nonParking`: the selected
  /// witness owes the NonParking proof at this call.
  pub nonParking: bool,
  /// Whether the dispatched provider is `never`: no provider value exists, so the call is never
  /// reached and lowers as unreachable, with no witness to select.
  pub vacuous: bool,
  /// The Effect value an ordinary callee returns when the call's contract promises an Effect
  /// (EFF-005). An `effect fn` callee's invocation constructs its own Effect, which a `run` of
  /// the call executes as one call of the callee; an ordinary callee is called and returns an
  /// Effect, which that `run` then executes. Absent for every other call.
  pub returned: Option<Interned<Type>>,
}

/// The source of one provider address passed to a callee (Effect note D2).
pub union ProviderSource {
  /// This function's own provider of requirement entry `index`.
  Own {pub index: usize},
  /// The provider stored in part 1 of the `depth`th binding enclosing the run, outermost first;
  /// `owned` when the part holds the provider value itself rather than its loan.
  Bound {pub depth: usize, pub owned: bool, pub access: Access, pub address: Interned<Type>},
}

impl ProviderSource {
  pub fn copy(self: &Self) -> ProviderSource {
    return match &self.* {
      ProviderSource.Own {index} => ProviderSource.Own {index: index}
      ProviderSource.Bound {depth, owned, access, address} => ProviderSource.Bound {depth: depth, owned: owned,
        access: access, address: Interned<Type>.clone(&address)}
    }
  }
}

pub struct StoredArguments {
  pub environment: Option<StoredEnvironment>,
  /// The operands after the environment, in target parameter order.
  pub lanes: List<StoredLane>,
  pub consumes: bool,
}

/// The source of one section call operand: a stored argument keeps its original parameter
/// ordinal, and the written operands fill the other parameters in order (CALL-003).
pub union StoredLane {
  /// The next written operand.
  Written,
  /// The environment's field `index`.
  Field {pub index: usize},
  /// The environment's field `index`, which owns the value a parameter borrows at `access`: an
  /// interface operation's Effect stores the operand it was given, and lends it to a witness that
  /// takes it borrowed. A consuming run moves the value out first and drops it after the call when
  /// `cleanup` says it needs it.
  Lent {pub index: usize, pub access: Access, pub cleanup: bool},
}

impl Copy for StoredLane {}

/// An owned bound provider that needs cleanup, with the failure of the run it outlives.
pub struct ProviderDrop {
  pub provider: Interned<Type>,
  pub innerFailure: Interned<Type>,
}

/// How a run site expands one exact Effect stored at a place (Effect note D4). Semantic analysis
/// prepares every target, so lowering reads no callee body.
pub union RunPlan {
  /// The Effect's own runner: a construction's target with its stored arguments, or an Effect
  /// block's instance with the environment.
  /// `partDrop` is the part's type when a loaned run leaves an owning callable for it to drop.
  Runner {pub target: CallTarget, pub success: Interned<Type>, pub failure: Interned<Type>, pub partDrop: Option<Interned<Type>>},
  /// Runs part 0. A failure in `selector` runs the handler stored in part 1 with that failure;
  /// every other failure is residual.
  Catch {
    pub selector: Interned<Type>,
    /// The step that runs part 0, in the same plan.
    pub inner: usize,
    pub innerFailure: Interned<Type>,
    pub handler: CallTarget,
    pub handlerSuccess: Interned<Type>,
    pub handlerFailure: Interned<Type>,
    /// The handler part's type when it owns cleanup; only the selected path consumes it.
    pub handlerDrop: Option<Interned<Type>>,
    /// Whether the handler is invoked by loan, so the selected path also drops it after the call.
    pub handlerKept: bool,
  },
  /// Runs part 0, then the `() ! never` finalizer stored in part 1 on both exits. A failure waits
  /// in a temporary while the finalizer runs, then continues to the enclosing sink.
  Finalize {
    /// The steps that run parts 0 and 1, in the same plan.
    pub inner: usize,
    pub innerFailure: Interned<Type>,
    /// The failure's type when it owns cleanup; a frame cancelled while it waits drops it.
    pub innerFailureDrop: Option<Interned<Type>>,
    pub finalizer: usize,
    pub finalizerSuccess: Interned<Type>,
    /// Whether the finalizer is `NonParking`. Cancelling a parked protected part runs a nonparking
    /// finalizer once and drops any other finalizer unrun.
    pub nonParking: bool,
    /// The finalizer part's type when it owns cleanup; a cancelled parking finalizer drops it.
    pub finalizerDrop: Option<Interned<Type>>,
    /// Whether this run owes the finalizer's NonParking proof: it is nonparking and no
    /// `Intrinsic.NonParking` premise of the running instance carries that proof.
    pub owed: bool,
  },
  /// Owns the resource in part 0 and lends it exclusively to `use` (part 1), then to `release`
  /// (part 2) on both exits, and drops it before the outcome continues.
  UseRelease {
    /// The exclusive loan both callables receive.
    pub lent: Interned<Type>,
    pub use: CallTarget,
    pub useSuccess: Interned<Type>,
    pub useFailure: Interned<Type>,
    /// The failure's type when it owns cleanup; a frame cancelled while it waits drops it.
    pub useFailureDrop: Option<Interned<Type>>,
    /// The use part's type when a loaned invocation leaves an owning callable to drop after it.
    pub useDrop: Option<Interned<Type>>,
    pub release: CallTarget,
    /// The release part's type when a loaned invocation leaves an owning callable to drop after it.
    pub releaseDrop: Option<Interned<Type>>,
    pub releaseSuccess: Interned<Type>,
    pub releaseFailure: Interned<Type>,
    /// The release failure's type when it owns cleanup; a cancelled frame drops that failure.
    pub releaseFailureDrop: Option<Interned<Type>>,
    /// The resource's type when it owns cleanup.
    pub resourceDrop: Option<Interned<Type>>,
    /// Whether this run owes the release's NonParking proof: no `Intrinsic.NonParking` premise of
    /// the running instance carries it.
    pub owed: bool,
    /// Whether this run owes the proof for the resource drop it runs after the release: no premise
    /// carries the whole composite. A carried release does not cover the resource.
    pub resourceOwed: bool,
  },
  /// Runs part 0 with the provider in part 1 bound for one requirement key (D2 rule 2): only
  /// this execution sees the replacement. An owned provider that needs cleanup is dropped on both
  /// exits of that run.
  Bind {pub inner: usize, pub providerDrop: Option<ProviderDrop>},
  /// Runs the alternative a finite join stores (EFF-013, D1). Several alternatives are a tagged
  /// union: the run switches on the tag to each arm's runner. One alternative is stored as itself.
  Join {pub arms: List<JoinArm>, pub tagged: bool},
  /// Runs part 2 under the diagnostic observer whose state is part 0 and whose callback is the
  /// callable stored in part 1, invoked as `callback`, with no selected failure, then drops the
  /// callback and the state (failure observer note N1). `state` and `callable` are the parts'
  /// address types.
  Observe {
    pub inner: usize,
    pub state: Interned<Type>,
    pub stateDrop: Option<Interned<Type>>,
    pub callable: Interned<Type>,
    pub callbackDrop: Option<Interned<Type>>,
    pub callback: CallTarget,
    /// Whether this run owes the callback's NonParking proof: any diagnostic the body reports
    /// invokes it, and no `Intrinsic.NonParking` premise of the running instance carries it.
    pub owed: bool,
  },
  /// Runs part 0, the deferred child, at an explicit suspension boundary (SUSP-001). Its run is
  /// ordinary; the instance that reaches it becomes a suspension origin.
  Suspend {pub inner: usize},
  /// Runs the Effect an exclusive reference lends: `inner` runs the lender's storage through the
  /// reference without consuming it (EFFECT-OWN-002).
  Lent {pub inner: usize},
  /// Runs part 1, a body that succeeds with `()`, as an interruptible boundary for the token in
  /// part 0. The run succeeds with `true` when the body completes, and with `false` when an
  /// interrupt request for the token abandoned the frames above it at a suspension point.
  Interrupt {pub inner: usize},
}

/// One alternative of a finite Effect join and the step that runs it.
pub struct JoinArm {
  /// The step that runs this alternative, in the same plan.
  pub step: usize,
  /// The alternative's tag in the join's union storage.
  pub tag: usize,
  /// The alternative's storage type, read as the union payload.
  pub ty: Interned<Type>,
}

// The place of the provider stored by one binding that encloses the current expansion.
struct BoundPlace {
  place: Place,
}

/// The prepared invocations of one checked scalar operation's carriers (by call node).
pub struct CarrierPlan {
  pub node: BodyNodeId,
  /// Invoked with the operation's exact result when it exists.
  pub present: CallTarget,
  /// Invoked with no argument otherwise.
  pub absent: CallTarget,
  /// The present carrier's type when the absent path, which leaves it unconsumed, must drop it.
  pub presentDrop: Option<Interned<Type>>,
  /// The absent carrier's type when the present path, which leaves it unconsumed, must drop it.
  pub absentDrop: Option<Interned<Type>>,
}

/// An interface call whose selected witness is a scalar intrinsic (by call node). It lowers in
/// place as that intrinsic over the call's operands; no instance is called.
pub struct WitnessIntrinsic {
  pub node: BodyNodeId,
  pub member: IntrinsicMember,
}

/// The expansion prepared for one `run` of a composed Effect: its steps, each after the steps it
/// runs, so the root is last.
pub struct NodePlan {
  pub node: BodyNodeId,
  pub steps: List<RunPlan>,
}

/// What one storage primitive's expansion needs from semantic analysis, which alone measures
/// layouts and prepares targets.
pub struct StoragePlan {
  pub node: BodyNodeId,
  /// The measured size (`layoutOf<T>`, `T`'s control block for `sharedLayout` and
  /// `sharedFromAllocation`, or the complete package for `executionLayout` and
  /// `executionFromAllocation`) or element stride (`rawBufferFrom`, `rawBufferCopy`).
  pub size: usize,
  pub alignment: usize,
  /// The sealed C allocator functions `malloc`, `free`, `memmove` and `memset`, in that order.
  pub externs: List<Interned<DeclarationId>>,
  /// Whether `slotDrop`'s element runs cleanup.
  pub cleanup: bool,
  /// `sharedWithMut`'s prepared `use` and `onConflict` invocations and their result types, or
  /// `executionFromAllocation`'s readiness endpoint invoked with its readiness state.
  pub targets: List<CallTarget>,
  pub results: List<Interned<Type>>,
  /// `executionFromAllocation`'s prepared run of the package body; its last step runs the whole body.
  pub steps: List<RunPlan>,
}

/// A staged anonymous target keeps its original environment as one capture field.
pub struct StoredEnvironment {
  pub field: usize,
  pub parameter: Interned<Type>,
  pub borrow: Option<Access>,
}

fn copyAccess(value: &Option<Access>) -> Option<Access> {
  return match &value.* { Option<Access>.Some {value: access} => Option<Access>.some(access) _ => Option<Access>.none() }
}

struct ResolvedCall {
  key: InstanceKey,
  edge: Edge,
  nonParking: bool,
}

// The evaluated place of one match subject; arm bindings project from it.
struct Scrutinee {
  subject: usize,
  place: Place,
}

// A pattern binding of a union member that is itself a union at this instance: it has no place
// inside the wider storage, so its arm narrows the active payload into this local.
struct Narrowed {
  subject: usize,
  prefix: List<Projection>,
  ordinal: usize,
  local: usize,
}

// A binding path that ends at a member stored spread over its union's tags: the lowered place of
// that union, the member's source ordinal, its storage tags and its own union type.
struct SpreadBinding {
  prefix: List<Projection>,
  ordinal: usize,
  tags: List<usize>,
  ty: Interned<Type>,
  storage: Interned<Type>,
}

struct Builder {
  bindings: List<Binding>,
  projections: List<RuntimeProjection>,
  calls: List<CallTarget>,
  function: MirFunction,
  current: usize,
  live: bool,
  loops: List<LoopTargets>,
  scrutinees: List<Scrutinee>,
  narrowed: List<Narrowed>,
  // The cleanup stack: owned locals in acquisition order, and where each open scope starts.
  owners: List<Owner>,
  cleanup: List<CleanupNode>,
  // Each cleanup node's state on the current path (`liveState`, `movedState` or its flag).
  states: List<usize>,
  // The states each open union's exit drop reads (`exitPlan`).
  dropPlans: List<List<usize>>,
  scopes: List<usize>,
  // Owned rvalues used only as places; they live until the end of their full expression.
  temporaries: List<Pending>,
  // The drop trie that `return`, `fail` and failure propagation leave the function through, and
  // those exits in lowering order.
  exits: List<ExitStep>,
  left: List<LeftExit>,
  // The blocks forwarded failures' drop paths end in, one per observer place, each recording the
  // forwarding site as the failure's next frame and failing; the one the exit being left ends in;
  // and the local holding that site's label, usize.MAX until a run site in a program that observes
  // diagnostics forwards a failure. Sharing the blocks keeps the observer glue out of each run site.
  forwards: List<ForwardBlock>,
  forward: usize,
  forwardSite: usize,
  // The slot each failure type a run site forwards is caught in. Only one failure is in flight at
  // a time and each site moves it out at once, so the sites of one type share a slot and its
  // context companion instead of each keeping its own for the whole frame.
  caught: List<CaughtSlot>,
  // The remaining children of each partial consuming site, keyed by body node.
  remainders: List<Remainder>,
  // Which typed-body locals and node values need cleanup, answered by semantic analysis.
  needs: CleanupNeeds,
  // The `Failure` local, or `usize.MAX` when this function cannot fail.
  failure: usize,
  // The expansions of runs of composed Effects, each consumed by its run node.
  plans: List<NodePlan>,
  // The prepared facts of storage primitive calls, each consumed by its call node.
  storage: List<StoragePlan>,
  // The carrier invocations of checked scalar operations, each consumed by its call node.
  carriers: List<CarrierPlan>,
  witnessIntrinsics: List<WitnessIntrinsic>,
  // The erased helpers of the execution packages this function adopts.
  helpers: List<MirFunction>,
  // This function's `Provider` locals in canonical requirement-key order.
  providers: List<usize>,
  // The current observer and selected-cause addresses passed to Silk callees; absent unless the
  // program observes diagnostics (failure observer note N1, N2).
  diagnostics: Option<DiagnosticPlaces>,
  // Renders this function's site labels; absent unless the program observes diagnostics.
  sites: Option<SiteText>,
  // The anchor this body's origins and literal nodes count from.
  anchor: Anchor,
  // The suspendable direct callees of a suspendable instance's frame variant, whose calls and
  // relinquishments each record a cancel exit; absent in every other lowering.
  suspending: Option<List<InstanceKey>>,
  // An erased package helper is lowered before the suspendable set is known, so each of its
  // instance calls records a cancel exit; its frame uses those at its suspension points.
  cancelEveryCall: bool,
  // The failure slots whose context holds a live pool node while the calls lowered now run: the
  // handler of a caught failure, and the finalizer or release that holds one. A cancel exit
  // from those calls releases each, innermost first (N7), and drops a value it still owns.
  held: List<HeldFailure>,
  // The composed Effects whose pending cleanup a cancel exit inside them runs, innermost last.
  cancelScopes: List<CancelScope>,
  // The interruptible boundaries a cancel exit inside them may resume, innermost last.
  interrupts: List<InterruptBoundary>,
  // Set while a cancel landing is lowered: its calls run to completion, so they record no exit.
  landing: bool,
  // The published value of each constant this body reads.
  constants: List<ConstantValue>,
  // The closed runtime type of each distinct written node type `instanceView` has seen, keyed by
  // the exact written type: most nodes repeat a few types, so each is substituted once.
  written: List<Interned<Type>>,
  closed: List<Interned<Type>>,
  writtenLookup: InternIndex,
}

// A failure slot held across the calls lowered now. `cleanup` is its type when the slot still owns
// a value that needs cleanup: a finalizer or release runs before the failure is delivered, while
// a handler has already received it. `depth` counts the cancel scopes open when it was held.
struct HeldFailure {
  slot: usize,
  cleanup: Option<Interned<Type>>,
  depth: usize,
}

// An interruptible boundary open while its body is lowered. A cancel exit recorded inside it first
// compares the package's interrupt word with `token`: on a match it clears the word, runs the
// cleanup of the cancel scopes and held failures opened inside the boundary, and continues at
// `continuation`, allocated by the first such exit. The marks count the scopes and held failures
// open when the boundary opened; a plan's expansion acquires no owner or pending temporary.
struct InterruptBoundary {
  token: usize,
  scopes: usize,
  held: usize,
  continuation: usize,
}

// A composed Effect whose cleanup is still pending while its protected part runs: a finalizer, a
// release, an observer state or an unused handler. Each cancel exit recorded inside it sets
// `selector` to its own continuation and enters `entry`, which runs that cleanup once and
// dispatches on `selector`. Both are allocated by the first cancel exit, so a scope no exit
// reaches adds nothing.
struct CancelScope {
  selector: usize,
  entry: usize,
  continuations: List<usize>,
}

struct DiagnosticPlaces {
  observer: Place,
  cause: Place,
  site: Place,
}

// An observed function's report name and its module's line starts (failure observer note N3).
struct SiteText {
  name: Bytes,
  path: Bytes,
  // A module of the program's own package; reports lead another package's names with its name.
  root: Option<ModuleId>,
}

// Where a failure inside an expansion goes: out of this function, or into a handler's temporary.
union FailureSink {
  Propagate,
  Catch {temp: usize, block: usize},
}

// A shallow, owned projection of one cached typed node. Shared.with never leaks a body loan.
union View {
  Integer {ty: Interned<Type>, literal: usize, origin: Origin},
  Embedded {value: Interned<StaticData>, ty: Interned<Type>, origin: Origin},
  ForeignStatic {declaration: Interned<DeclarationId>, ty: Interned<Type>, origin: Origin},
  ForeignAddress {declaration: Interned<DeclarationId>, symbol: Shared<Bytes>, ty: Interned<Type>, origin: Origin},
  Float {ty: Interned<Type>, literal: usize, origin: Origin},
  Text {ty: Interned<Type>, literal: usize, origin: Origin},
  Boolean {value: bool, origin: Origin},
  Unit {origin: Origin},
  Local {index: usize, ty: Interned<Type>, origin: Origin},
  Move {value: BodyNodeId, release: Release, ty: Interned<Type>, origin: Origin},
  Borrow {access: Access, value: BodyNodeId, ty: Interned<Type>, origin: Origin},
  Dereference {value: BodyNodeId, ty: Interned<Type>, origin: Origin},
  Field {value: BodyNodeId, index: usize, ty: Interned<Type>, origin: Origin},
  Index {value: BodyNodeId, index: BodyNodeId, element: usize, ty: Interned<Type>, origin: Origin},
  ArrayLength {value: BodyNodeId, count: usize, ty: Interned<Type>, origin: Origin},
  ArrayRepeat {value: BodyNodeId, count: usize, ty: Interned<Type>, origin: Origin},
  ArraySlice {value: BodyNodeId, count: usize, ty: Interned<Type>, origin: Origin},
  SliceLength {value: BodyNodeId, ty: Interned<Type>, origin: Origin},
  Aggregate {node: BodyNodeId, count: usize, ty: Interned<Type>, origin: Origin},
  StagedCallable {node: BodyNodeId, count: usize, ty: Interned<Type>, origin: Origin},
  EnumMember {member: BodyEnumMember, ty: Interned<Type>, origin: Origin},
  EnumValue {value: BodyNodeId, ty: Interned<Type>, origin: Origin},
  Match {
    node: BodyNodeId,
    subject: BodyNodeId,
    place: bool,
    consumes: bool,
    release: Release,
    tags: usize,
    count: usize,
    syntax: BodyMatchSyntax,
    ty: Interned<Type>,
    origin: Origin,
  },
  VariantConstruct {node: BodyNodeId, tag: usize, count: usize, ty: Interned<Type>, origin: Origin},
  UnionInject {value: BodyNodeId, ty: Interned<Type>, origin: Origin},
  UnionWiden {value: BodyNodeId, ty: Interned<Type>, origin: Origin},
  PatternBinding {node: BodyNodeId, subject: BodyNodeId, ty: Interned<Type>, origin: Origin},
  PlaceAssignment {target: BodyNodeId, value: BodyNodeId, origin: Origin},
  Prefix {operation: PrefixOperator, operand: BodyNodeId, ty: Interned<Type>, origin: Origin},
  Infix {
    operation: InfixOperator,
    left: BodyNodeId,
    right: BodyNodeId,
    ty: Interned<Type>,
    origin: Origin,
  },
  Call {
    environment: bool,
    foreign: Option<Interned<DeclarationId>>,
    variadicArguments: Option<Shared<List<CAbi.VariadicArgument>>>,
    count: usize,
    node: BodyNodeId,
    ty: Interned<Type>,
    origin: Origin,
  },
  Intrinsic {member: IntrinsicMember, node: BodyNodeId, ty: Interned<Type>, origin: Origin},
  Storage {operation: StorageOperation, node: BodyNodeId, ty: Interned<Type>, origin: Origin},
  Run {value: BodyNodeId, ty: Interned<Type>, origin: Origin},
  Fail {value: BodyNodeId, origin: Origin},
  Binding {index: usize, initializer: BodyNodeId, origin: Origin},
  Assignment {index: usize, value: BodyNodeId, origin: Origin},
  Return {value: Option<BodyNodeId>, origin: Origin},
  Branch {
    condition: BodyNodeId,
    thenBranch: BodyNodeId,
    elseBranch: Option<BodyNodeId>,
    origin: Origin,
  },
  While {condition: BodyNodeId, body: BodyNodeId, origin: Origin},
  Break {origin: Origin},
  Continue {origin: Origin},
  Drop {value: BodyNodeId, release: Release, origin: Origin},
  Block {count: usize, node: BodyNodeId, origin: Origin},
  Unsupported {origin: Origin},
}

struct LocalView {
  ty: Interned<Type>,
  origin: Origin,
}

fn bodyRoot(body: &Shared<TypedBody>) -> BodyNodeId {
  return Shared<TypedBody>.with<BodyNodeId>(body, TypedBody.rootNode)
}

fn nodeOrigin(body: &Shared<TypedBody>, id: BodyNodeId) -> Origin {
  return Shared<TypedBody>.with<Origin>(
    body,
    fn(value: &TypedBody) -> Origin {
      return TypedBody.nodeSlice(value)[id.index].origin
    },
  )
}

fn nodeType(body: &Shared<TypedBody>, id: BodyNodeId) -> Option<Interned<Type>> {
  return Shared<TypedBody>.with<Option<Interned<Type>>>(body, fn(value: &TypedBody) -> Option<Interned<Type>> {
    let nodes = TypedBody.nodeSlice(value)
    if let BodyNodeKind.Expression {ty, ..} = &nodes[id.index].kind {
      return Option<Interned<Type>>.some(Interned<Type>.clone(&ty))
    }
    return Option<Interned<Type>>.none()
  })
}

fn bodyOrigin(body: &Shared<TypedBody>) -> Origin {
  return Shared<TypedBody>.with<Origin>(
    body,
    fn(value: &TypedBody) -> Origin {
      let root = TypedBody.rootNode(value)
      return TypedBody.nodeSlice(value)[root.index].origin
    },
  )
}

fn bodyBorrowStatus(body: &Shared<TypedBody>) -> BodyBorrowStatus {
  return Shared<TypedBody>.with<BodyBorrowStatus>(body, fn(value: &TypedBody) -> BodyBorrowStatus { return TypedBody.borrowStatus(value) })
}

fn localCount(body: &Shared<TypedBody>) -> usize {
  return Shared<TypedBody>.with<usize>(
    body,
    fn(value: &TypedBody) -> usize {
      return TypedBody.localSlice(value).length
    },
  )
}

fn localView(body: &Shared<TypedBody>, index: usize) -> LocalView {
  return Shared<TypedBody>.with<LocalView>(
    body,
    fn(value: &TypedBody) -> LocalView {
      let locals = TypedBody.localSlice(value)
      return LocalView {ty: Interned<Type>.clone(&locals[index].ty), origin: locals[index].origin}
    },
  )
}

fn childAt(body: &Shared<TypedBody>, id: BodyNodeId, index: usize) -> Option<BodyNodeId> {
  return Shared<TypedBody>.with<Option<BodyNodeId>>(
    body,
    fn(value: &TypedBody) -> Option<BodyNodeId> {
      let nodes = TypedBody.nodeSlice(value)
      return match & nodes[id.index].kind {
        BodyNodeKind.Block {statements, ..} => {
          let children = List<BodyNodeId>.asSlice(&statements)
          if index < children.length {
            return Option<BodyNodeId>.some(children[index])
          }
          return Option<BodyNodeId>.none()
        }
        BodyNodeKind.Expression {form: BodyExpression.Aggregate {fields, ..}, ..} => {
          let children = List<BodyAggregateField>.asSlice(&fields)
          if index < children.length { return Option<BodyNodeId>.some(children[index].value) }
          return Option<BodyNodeId>.none()
        }
        BodyNodeKind.Expression {form: BodyExpression.Callable {fields, ..}, ..} => {
          let children = List<BodyAggregateField>.asSlice(&fields)
          if index < children.length { return Option<BodyNodeId>.some(children[index].value) }
          return Option<BodyNodeId>.none()
        }
        BodyNodeKind.Expression {form: BodyExpression.CallableCall {callee, arguments, ..}, ..} => {
          if index == usize.ZERO { return Option<BodyNodeId>.some(callee) }
          let children = List<BodyNodeId>.asSlice(&arguments)
          if index - usize.ONE < children.length { return Option<BodyNodeId>.some(children[index - usize.ONE]) }
          return Option<BodyNodeId>.none()
        }
        BodyNodeKind.Expression {form: BodyExpression.StagedCallable {callee, arguments, ..}, ..} => {
          if index == usize.ZERO { return Option<BodyNodeId>.some(callee) }
          let children = List<BodyNodeId>.asSlice(&arguments)
          if index - usize.ONE < children.length { return Option<BodyNodeId>.some(children[index - usize.ONE]) }
          return Option<BodyNodeId>.none()
        }
        BodyNodeKind.Expression {form: BodyExpression.VariantConstruct {fields, ..}, ..} => {
          let children = List<BodyAggregateField>.asSlice(&fields)
          if index < children.length { return Option<BodyNodeId>.some(children[index].value) }
          return Option<BodyNodeId>.none()
        }
        BodyNodeKind.Expression {form: BodyExpression.DirectCall {arguments, ..}, ..} => {
          let children = List<BodyNodeId>.asSlice(&arguments)
          if index < children.length {
            return Option<BodyNodeId>.some(children[index])
          }
          return Option<BodyNodeId>.none()
        }
        // A stored Effect's runner receives the operand as its callee, like a callable invocation.
        BodyNodeKind.Expression {form: BodyExpression.Run {value: operand, ..}, ..} => {
          if index == usize.ZERO { return Option<BodyNodeId>.some(operand) }
          return Option<BodyNodeId>.none()
        }
        BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {arguments, ..}, ..} => {
          let children = List<BodyNodeId>.asSlice(&arguments)
          if index < children.length { return Option<BodyNodeId>.some(children[index]) }
          return Option<BodyNodeId>.none()
        }
        BodyNodeKind.Expression {form: BodyExpression.ForeignCall {arguments, ..}, ..} => {
          let children = List<BodyNodeId>.asSlice(&arguments)
          if index < children.length {
            return Option<BodyNodeId>.some(children[index])
          }
          return Option<BodyNodeId>.none()
        }
        BodyNodeKind.Expression {form: BodyExpression.IntrinsicCall {arguments, ..}, ..} => {
          let children = List<BodyNodeId>.asSlice(&arguments)
          if index < children.length {
            return Option<BodyNodeId>.some(children[index])
          }
          return Option<BodyNodeId>.none()
        }
        BodyNodeKind.Expression {form: BodyExpression.StorageCall {arguments, ..}, ..} => {
          let children = List<BodyNodeId>.asSlice(&arguments)
          if index < children.length { return Option<BodyNodeId>.some(children[index]) }
          return Option<BodyNodeId>.none()
        }
        _ => Option<BodyNodeId>.none()
      }
    },
  )
}

fn aggregateFieldIndex(body: &Shared<TypedBody>, id: BodyNodeId, index: usize) -> usize {
  return Shared<TypedBody>.with<usize>(body, fn(value: &TypedBody) -> usize {
    let nodes = TypedBody.nodeSlice(value)
    if let BodyNodeKind.Expression {form: BodyExpression.Aggregate {fields, ..}, ..} = &nodes[id.index].kind {
      let children = List<BodyAggregateField>.asSlice(&fields)
      if index < children.length { return children[index].index }
    }
    if let BodyNodeKind.Expression {form: BodyExpression.Callable {fields, ..}, ..} = &nodes[id.index].kind {
      let children = List<BodyAggregateField>.asSlice(&fields)
      if index < children.length { return children[index].index }
    }
    if let BodyNodeKind.Expression {form: BodyExpression.VariantConstruct {fields, ..}, ..} = &nodes[id.index].kind {
      let children = List<BodyAggregateField>.asSlice(&fields)
      if index < children.length { return children[index].index }
    }
    return usize.MAX
  })
}

fn foreignIdentityMatches(handle: &Interned<DeclarationId>, declaration: &DeclarationId) -> bool {
  return Interned<DeclarationId>.with<bool>(handle, fn(identity: &DeclarationId) -> bool {
    return DeclarationId.equals(identity, declaration)
  })
}

fn foreignHandleIndex(identities: &[Interned<DeclarationId>], declaration: &DeclarationId) -> Option<usize> {
  let mut at = usize.ZERO
  while at < identities.length {
    if foreignIdentityMatches(&identities[at], declaration) {
      return Option<usize>.some(at)
    }
    at = at + usize.ONE
  }
  return Option<usize>.none()
}

// One constant's published value, read by every runtime body node that names the constant.
pub struct ConstantValue {
  pub declaration: Interned<DeclarationId>,
  pub value: Interned<StaticData>,
}

// The value published for one constant, when the lowering was given it.
fn constantValue(constants: &[ConstantValue], declaration: &Interned<DeclarationId>) -> Option<Interned<StaticData>> {
  let mut at = usize.ZERO
  while at < constants.length {
    if StaticValue.sameDeclaration(&constants[at].declaration, declaration) { return Option<Interned<StaticData>>.some(Interned<StaticData>.clone(&constants[at].value)) }
    at = at + usize.ONE
  }
  return Option<Interned<StaticData>>.none()
}

// A constant read is typed by the constant's declared type alone; its value comes from
// `constants`, which the lowering's preparation demanded. Without it the read is unsupported.
fn view(body: &Shared<TypedBody>, id: BodyNodeId, constants: &[ConstantValue]) -> View {
  return Shared<TypedBody>.with<View>(
    body,
    fn(bodyValue: &TypedBody) -> View {
      let nodes = TypedBody.nodeSlice(bodyValue)
      let origin = nodes[id.index].origin
      return match & nodes[id.index].kind {
        BodyNodeKind.Expression {ty, form} => match & form {
          BodyExpression.Constant {declaration} => match move constantValue(constants, &declaration) {
            Option<Interned<StaticData>>.Some {value} => View.Embedded {value: move value, ty: Interned<Type>.clone(&ty), origin: origin}
            Option<Interned<StaticData>>.None => View.Unsupported {origin: origin}
          }
          BodyExpression.Integer {literal} => View.Integer {
            ty: Interned<Type>.clone(&ty),
            literal: literal,
            origin: origin,
          }
          BodyExpression.Float {literal} => View.Float {
            ty: Interned<Type>.clone(&ty),
            literal: literal,
            origin: origin,
          }
          BodyExpression.Text {literal} => View.Text {ty: Interned<Type>.clone(&ty), literal: literal, origin: origin}
          BodyExpression.Boolean {value} => View.Boolean {value: value, origin: origin}
          BodyExpression.Unit => View.Unit {origin: origin}
          BodyExpression.Embedded {value} => View.Embedded {
            value: Interned<StaticData>.clone(&value), ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.Local {local} => View.Local {
            index: local.index,
            ty: Interned<Type>.clone(&ty),
            origin: origin,
          }
          BodyExpression.Move {value, consumed} => View.Move {
            value: value,
            release: releaseOf(&consumed, id),
            ty: Interned<Type>.clone(&ty),
            origin: origin,
          }
          // Pointer weakening is the existing scalar value-copy lane, with no address change.
          BodyExpression.PointerWeaken {value} => View.Move {
            value: value, release: Release.Value, ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.Borrow {access, value} => View.Borrow {
            access: access,
            value: value,
            ty: Interned<Type>.clone(&ty),
            origin: origin,
          }
          BodyExpression.Dereference {value} => View.Dereference {
            value: value,
            ty: Interned<Type>.clone(&ty),
            origin: origin,
          }
          BodyExpression.Field {value, index, ..} => View.Field {
            value: value,
            index: index,
            ty: Interned<Type>.clone(&ty),
            origin: origin,
          }
          BodyExpression.ArrayLength {value, count} => View.ArrayLength {
            value: value, count: count, ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.ArrayRepeat {value, count} => View.ArrayRepeat {
            value: value, count: count, ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.ArraySlice {value, count} => View.ArraySlice {
            value: value, count: count, ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.SliceLength {value} => View.SliceLength {
            value: value, ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.Index {value, index, element} => View.Index {
            value: value, index: index, element: element, ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.Aggregate {fields, ..} => View.Aggregate {
            node: id, count: List<BodyAggregateField>.length(&fields),
            ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.Callable {fields, ..} => View.Aggregate {
            node: id, count: List<BodyAggregateField>.length(&fields),
            ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.StagedCallable {arguments, ..} => View.StagedCallable {
            node: id, count: List<BodyNodeId>.length(&arguments) + usize.ONE,
            ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.EnumMember {member} => View.EnumMember {
            member: member, ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.EnumValue {value} => View.EnumValue {
            value: value, ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.VariantConstruct {tag, fields} => View.VariantConstruct {
            node: id, tag: tag, count: List<BodyAggregateField>.length(&fields), ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.Match {subject, access, tags, arms, syntax, ..} => View.Match {
            node: id, subject: subject, place: match &access { BodySubjectAccess.Place {..} => true _ => false },
            consumes: match &access { BodySubjectAccess.Consume {..} => true _ => false },
            release: match &access { BodySubjectAccess.Consume {consumed} => releaseOf(&consumed, id) _ => Release.Value },
            tags: tags, count: List<BodyMatchArm>.length(&arms), syntax: syntax,
            ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.UnionInject {value, ..} => View.UnionInject {value: value, ty: Interned<Type>.clone(&ty), origin: origin}
          BodyExpression.UnionWiden {value} => View.UnionWiden {value: value, ty: Interned<Type>.clone(&ty), origin: origin}
          BodyExpression.PatternBinding {subject, ..} => View.PatternBinding {
            node: id, subject: subject, ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.ConcretePrefix {operator, operand} => View.Prefix {
            operation: operator,
            operand: operand,
            ty: Interned<Type>.clone(&ty),
            origin: origin,
          }
          BodyExpression.ConcreteInfix {operator, left, right} => View.Infix {
            operation: operator,
            left: left,
            right: right,
            ty: Interned<Type>.clone(&ty),
            origin: origin,
          }
          BodyExpression.DirectCall {arguments, ..} => View.Call {
            environment: false,
            foreign: Option<Interned<DeclarationId>>.none(),
            variadicArguments: Option<Shared<List<CAbi.VariadicArgument>>>.none(),
            count: List<BodyNodeId>.length(&arguments), node: id,
            ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.CallableCall {arguments, ..} => View.Call {
            environment: true, foreign: Option<Interned<DeclarationId>>.none(),
            variadicArguments: Option<Shared<List<CAbi.VariadicArgument>>>.none(),
            count: List<BodyNodeId>.length(&arguments) + usize.ONE, node: id,
            ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.InterfaceCall {arguments, ..} => View.Call {
            environment: false,
            foreign: Option<Interned<DeclarationId>>.none(),
            variadicArguments: Option<Shared<List<CAbi.VariadicArgument>>>.none(),
            count: List<BodyNodeId>.length(&arguments), node: id,
            ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.IntrinsicCall {member, ..} => View.Intrinsic {
            member: member,
            node: id,
            ty: Interned<Type>.clone(&ty),
            origin: origin,
          }
          BodyExpression.StorageCall {operation, ..} => View.Storage {
            operation: operation, node: id, ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.Run {value, ..} => View.Run {value: value, ty: Interned<Type>.clone(&ty), origin: origin}
          BodyExpression.ForeignCall {declaration, arguments, variadicArguments} => {
            let identities = TypedBody.foreignHandles(bodyValue)
            let found = foreignHandleIndex(identities, &declaration)
            if let Option<usize>.Some {value: at} = move found {
              return View.Call {
                environment: false,
                foreign: Option<Interned<DeclarationId>>.some(Interned<DeclarationId>.clone(&identities[at])),
                variadicArguments: Option<Shared<List<CAbi.VariadicArgument>>>.some(Shared<List<CAbi.VariadicArgument>>.clone(&variadicArguments)),
                count: List<BodyNodeId>.length(&arguments),
                node: id,
                ty: Interned<Type>.clone(&ty),
                origin: origin,
              }
            }
            return View.Unsupported {origin: origin}
          }
          BodyExpression.ForeignAddress {declaration, symbol} => View.ForeignAddress {
            declaration: Interned<DeclarationId>.clone(&declaration), symbol: Shared<Bytes>.clone(&symbol),
            ty: Interned<Type>.clone(&ty), origin: origin,
          }
          BodyExpression.ForeignStatic {declaration} => View.ForeignStatic {
            declaration: Interned<DeclarationId>.clone(&declaration), ty: Interned<Type>.clone(&ty), origin: origin,
          }
          _ => View.Unsupported {origin: origin}
        }
        BodyNodeKind.LocalBinding {local, initializer} => View.Binding {
          index: local.index,
          initializer: initializer,
          origin: origin,
        }
        BodyNodeKind.MutableBinding {local, initializer} => View.Binding {
          index: local.index,
          initializer: initializer,
          origin: origin,
        }
        BodyNodeKind.Assignment {local, value} => View.Assignment {
          index: local.index,
          value: value,
          origin: origin,
        }
        BodyNodeKind.PlaceAssignment {target, value} => View.PlaceAssignment {
          target: target,
          value: value,
          origin: origin,
        }
        BodyNodeKind.Return {value} => View.Return {
          value: match & value {
            Option<BodyNodeId>.Some {value: returned} => Option<BodyNodeId>.some(returned)
            Option<BodyNodeId>.None => Option<BodyNodeId>.none()
          },
          origin: origin,
        }
        BodyNodeKind.Branch {condition, thenBranch, elseBranch, ..} => View.Branch {
          condition: condition,
          thenBranch: thenBranch,
          elseBranch: match & elseBranch {
            Option<BodyNodeId>.Some {value: other} => Option<BodyNodeId>.some(other)
            Option<BodyNodeId>.None => Option<BodyNodeId>.none()
          },
          origin: origin,
        }
        BodyNodeKind.While {condition, body: loopBody} => View.While {
          condition: condition,
          body: loopBody,
          origin: origin,
        }
        BodyNodeKind.Break => View.Break {origin: origin}
        BodyNodeKind.Drop {value, consumed} => View.Drop {value: value, release: releaseOf(&consumed, id), origin: origin}
        BodyNodeKind.Fail {value} => View.Fail {value: value, origin: origin}
        BodyNodeKind.Continue => View.Continue {origin: origin}
        BodyNodeKind.Recovered {..} => CompilerBug.panic(b"a recovered statement reached lowering")
        BodyNodeKind.Block {statements, ..} => View.Block {
          count: List<BodyNodeId>.length(&statements),
          node: id,
          origin: origin,
        }
      }
    },
  )
}

fn place(local: usize) -> Place {
  return Place {local: local, projections: List<Projection>.make()}
}

effect fn unsupported(owner: &Interned<DeclarationId>, origin: Origin, code: GapCode) -> never
! Gap | CanonicalizationFailure | OutOfMemoryError
? &mut Allocator {
  fail Gap.relative(code, owner, origin.location)
}

effect fn block(builder: &mut Builder, origin: Origin) -> usize ! OutOfMemoryError ? &mut Allocator {
  let index = List<Block>.length(&builder.function.blocks)
  run List<Block>.append(
    &mut builder.*.function.blocks,
    Block {
      statements: List<Statement>.make(),
      terminator: Terminator.Unreachable {origin: origin},
    },
  )
  return index
}

// Emission after a diverging operand is unreachable, so it never replaces the terminator of the
// block that already diverged or prepends statements to it.
fn terminate(builder: &mut Builder, terminator: Terminator) -> () {
  if !builder.live { return () }
  let current = builder.current
  let mut blocks = List<Block>.asMutSlice(&mut builder.*.function.blocks)
  blocks[current].terminator = move terminator
  builder.live = false
  return ()
}

fn resume(builder: &mut Builder, index: usize) -> () {
  builder.current = index
  builder.live = true
  return ()
}

effect fn assign(builder: &mut Builder, destination: Place, value: Rvalue, origin: Origin) -> ()
! OutOfMemoryError
? &mut Allocator {
  if !builder.live { return () }
  // A value of an uninhabited type never exists, so a path that reads one is unreachable.
  if neverSource(&builder.*, &value) {
    terminate(&mut builder.*, Terminator.Unreachable {origin: origin})
    return ()
  }
  if mayTrap(&value) { run recordTrapSite(&mut builder.*, origin) }
  let current = builder.current
  let mut blocks = List<Block>.asMutSlice(&mut builder.*.function.blocks)
  return run List<Statement>.append(
    &mut blocks[current].statements,
    Statement.Assign {destination: move destination, value: move value, origin: origin},
  )
}

// Arithmetic, shifts and conversions trap on invalid operands when emitted (TERM-008).
fn mayTrap(value: &Rvalue) -> bool {
  return match &value.* {
    Rvalue.Unary {..} => true
    Rvalue.Binary {..} => true
    Rvalue.ScalarBinary {..} => true
    Rvalue.Convert {..} => true
    // The byte count of stack storage traps when it does not fit the target word.
    Rvalue.StackAllocate {..} => true
    // A checked integer lane sum traps when the total does not fit the lane type.
    Rvalue.Vector {primitive, ..} => primitive == IntrinsicPrimitive.SimdReduceAdd
    _ => false
  }
}

// Records the site label an observed trap at `origin` reports, once per origin (event 6, N7).
effect fn recordTrapSite(builder: &mut Builder, origin: Origin) -> () ! OutOfMemoryError ? &mut Allocator {
  let label = match &builder.sites {
    Option<SiteText>.Some {value: sites} => run siteLabel(&sites, &builder.anchor, origin)
    Option<SiteText>.None => { return () }
  }
  let recorded = List<TrapSite>.asSlice(&builder.function.traps)
  let mut at = usize.ZERO
  while at < recorded.length {
    if recorded[at].origin.node == origin.node && recorded[at].origin.location.start == origin.location.start {
      return ()
    }
    at = at + usize.ONE
  }
  return run List<TrapSite>.append(&mut builder.*.function.traps, TrapSite {origin: origin, label: move label})
}

// Whether `value` reads a whole local whose type is uninhabited.
fn neverSource(builder: &Builder, value: &Rvalue) -> bool {
  return match &value.* {
    Rvalue.Use {value: Operand.Copy {place}} => neverLocal(builder, &place)
    Rvalue.Use {value: Operand.Move {place}} => neverLocal(builder, &place)
    _ => false
  }
}

fn neverLocal(builder: &Builder, place: &Place) -> bool {
  if List<Projection>.length(&place.projections) != usize.ZERO { return false }
  return Interned<Type>.with<bool>(&localType(builder, place.local), neverType)
}

effect fn temporary(builder: &mut Builder, ty: &Interned<Type>, origin: Origin) -> usize
! OutOfMemoryError
? &mut Allocator {
  let index = List<Local>.length(&builder.function.locals)
  run List<Local>.append(
    &mut builder.*.function.locals,
    Local {ty: Interned<Type>.clone(ty), kind: LocalKind.Temp, origin: origin},
  )
  return index
}

// Cleans one complete owned value through its type's glue, which the instance now references.
effect fn dropPlace(builder: &mut Builder, destination: Place, ty: &Interned<Type>, owner: &Interned<DeclarationId>, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !builder.live { return () }
  let sourceOwner = DeclarationId.copyShared(owner)
  let keyed = match move run InstanceKey.dropGlue(ty, &sourceOwner) {
    Result<Option<InstanceKey>, CanonicalizationFailure>.Success {value: canonicalGlue} => move canonicalGlue
    Result<Option<InstanceKey>, CanonicalizationFailure>.Failure {error: reason} => { fail move reason }
  }
  let glue = match move keyed {
    Option<InstanceKey>.Some {value} => move value
    Option<InstanceKey>.None => { return run unsupported(owner, origin, GapCode.OpenInstance) }
  }
  return run dropPrepared(&mut builder.*, move destination, move glue, origin)
}

effect fn dropPrepared(builder: &mut Builder, destination: Place, glue: InstanceKey, origin: Origin) -> ()
! OutOfMemoryError ? &mut Allocator {
  if !builder.live { return () }
  run List<Reference>.append(&mut builder.*.function.references, Reference {key: InstanceKey.copy(&glue), edge: Edge.Direct, origin: origin})
  let diagnostics = run currentDiagnostics(&builder.*)
  let current = builder.current
  let mut blocks = List<Block>.asMutSlice(&mut builder.*.function.blocks)
  return run List<Statement>.append(&mut blocks[current].statements, Statement.Drop {destination: move destination,
    glue: move glue, diagnostics: move diagnostics, origin: origin})
}

pub effect fn copyPlace(value: &Place) -> Place ! OutOfMemoryError ? &mut Allocator {
  let mut copied = place(value.local)
  let projections = List<Projection>.asSlice(&value.projections)
  let mut at = usize.ZERO
  while at < projections.length {
    let selected = match &projections[at] {
      Projection.Field {index} => Projection.Field {index: index}
      Projection.Payload {index, ty} => Projection.Payload {index: index, ty: Interned<Type>.clone(&ty)}
      Projection.VariantField {variant, field} => Projection.VariantField {variant: variant, field: field}
      Projection.Index {local} => Projection.Index {local: local}
      Projection.ConstIndex {index} => Projection.ConstIndex {index: index}
      Projection.Deref => Projection.Deref
    }
    run List<Projection>.append(&mut copied.projections, move selected)
    at = at + usize.ONE
  }
  return move copied
}

// Copy source path evidence under a short body borrow; resolve storage after releasing it.
fn copyStep(path: &List<BodyPlaceStep>, at: usize) -> Option<BodyPlaceStep> {
  let steps = List<BodyPlaceStep>.asSlice(path)
  if at >= steps.length { return Option<BodyPlaceStep>.none() }
  return Option<BodyPlaceStep>.some(match &steps[at] {
    BodyPlaceStep.Member {tag, ty, source} => BodyPlaceStep.Member {tag: tag,
      ty: Interned<Type>.clone(&ty), source: Interned<Type>.clone(&source)}
    BodyPlaceStep.VariantField {tag, field} => BodyPlaceStep.VariantField {tag: tag, field: field}
    BodyPlaceStep.Field {index} => BodyPlaceStep.Field {index: index}
    BodyPlaceStep.Element {index} => BodyPlaceStep.Element {index: index}
  })
}

// Where a checked union member is stored in this instance. Every member a checked program names
// has a placement (UNION-001), so a missing one is an internal invariant failure.
effect fn instancePlacement(builder: &Builder, source: &Interned<Type>, member: &Interned<Type>) -> UnionPlacement
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = run UnionProjection.placement(source, member, List<Binding>.asSlice(&builder.bindings),
    List<RuntimeProjection>.asSlice(&builder.projections))
  return match move selected {
    Option<UnionPlacement>.Some {value} => move value
    _ => CompilerBug.panic(b"a checked union member has no placement in its instance")
  }
}

// Appends the storage projection of one source place step. A member stored as the whole instance
// value adds no projection. A member that is itself a union at this instance has no place inside
// the wider storage; only a pattern binding ends at it, and binding narrows it into its own value.
effect fn lowerStep(builder: &Builder, step: &BodyPlaceStep, path: &mut List<Projection>) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let projection = match &step.* {
    BodyPlaceStep.Member {ty: member, source, ..} => match move run instancePlacement(builder, &source, &member) {
      UnionPlacement.Whole => { return () }
      UnionPlacement.Tagged {tag: physical, ty} => Projection.Payload {index: physical, ty: move ty}
      UnionPlacement.Spread {..} => CompilerBug.panic(b"a union member that is itself a union was projected as a place")
    }
    BodyPlaceStep.VariantField {tag, field} => Projection.VariantField {variant: tag, field: field}
    BodyPlaceStep.Field {index} => Projection.Field {index: index}
    BodyPlaceStep.Element {index} => Projection.ConstIndex {index: index}
  }
  run List<Projection>.append(&mut path.*, move projection)
  return ()
}

// A release counted in this instance's storage steps: a union member stored whole adds no step,
// and a member stored spread over the tags of a wider union ends the path at that union, which a
// binding then takes whole (UNION-001).
effect fn instanceRelease(builder: &Builder, body: &Shared<TypedBody>, node: BodyNodeId, release: Release) -> Release
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut depth = usize.ZERO
  let mut at = usize.ZERO
  while true {
    let step = match move consumedStepAt(body, node, at) {
      Option<BodyPlaceStep>.Some {value} => move value
      Option<BodyPlaceStep>.None => { break }
    }
    at = at + usize.ONE
    if let BodyPlaceStep.Member {ty: member, source, ..} = &step {
      match move run instancePlacement(builder, &source, &member) {
        UnionPlacement.Whole => { continue }
        UnionPlacement.Spread {..} => { break }
        UnionPlacement.Tagged {..} => {}
      }
    }
    depth = depth + usize.ONE
  }
  return match move release {
    Release.Partial {local, node: site} => {
      if depth == usize.ZERO { return Release.Whole {local: local} }
      return Release.Partial {local: local, node: site}
    }
    Release.Binding {subject, node: site, ..} => Release.Binding {subject: subject, node: site, steps: depth}
    Release.Whole {local} => Release.Whole {local: local}
    Release.Value => Release.Value
  }
}

// Step `at` of the place that consuming node `node` releases.
fn consumedStepAt(body: &Shared<TypedBody>, node: BodyNodeId, at: usize) -> Option<BodyPlaceStep> {
  return Shared<TypedBody>.with<Option<BodyPlaceStep>>(body, fn(value: &TypedBody) -> Option<BodyPlaceStep> {
    let nodes = TypedBody.nodeSlice(value)
    match &nodes[node.index].kind {
      BodyNodeKind.Expression {form: BodyExpression.Move {consumed: Option<BodyConsumedPlace>.Some {value: place}, ..}, ..} =>
        { return copyStep(&place.steps, at) }
      BodyNodeKind.Expression {form: BodyExpression.Match {
        access: BodySubjectAccess.Consume {consumed: Option<BodyConsumedPlace>.Some {value: place}}, ..}, ..} =>
        { return copyStep(&place.steps, at) }
      BodyNodeKind.Drop {consumed: Option<BodyConsumedPlace>.Some {value: place}, ..} => { return copyStep(&place.steps, at) }
      _ => {}
    }
    return Option<BodyPlaceStep>.none()
  })
}

// The release a recorded consumed place makes at body node `node`, in MIR local numbering.
fn releaseOf(consumed: &Option<BodyConsumedPlace>, node: BodyNodeId) -> Release {
  if let Option<BodyConsumedPlace>.Some {value} = &consumed.* {
    let whole = List<BodyPlaceStep>.length(&value.steps) == usize.ZERO
    return match &value.root {
      BodyPlaceRoot.Local {local} => {
        if whole { return Release.Whole {local: local.index + usize.ONE} }
        return Release.Partial {local: local.index + usize.ONE, node: node.index}
      }
      BodyPlaceRoot.Subject {subject} => Release.Binding {subject: subject.index, node: node.index,
        steps: List<BodyPlaceStep>.length(&value.steps)}
    }
  }
  return Release.Value
}

fn localType(builder: &Builder, local: usize) -> Interned<Type> {
  let locals = List<Local>.asSlice(&builder.function.locals)
  return Interned<Type>.clone(&locals[local].ty)
}

// How many projections below its local the place of owner `index` lies: zero for a local's owner.
fn ownerDepth(builder: &Builder, index: usize) -> usize {
  let owners = List<Owner>.asSlice(&builder.owners)
  return List<Projection>.length(&owners[index].path)
}

// The owner of local `local` itself; the binding owners of a subject stored there are not.
fn ownerIndex(builder: &Builder, local: usize) -> usize {
  let owners = List<Owner>.asSlice(&builder.owners)
  let mut at = owners.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if owners[at].local == local && owners[at].subject == usize.MAX { return at }
  }
  return usize.MAX
}

// Replacement identifies the lexical owner of this actual place, including consuming-match
// bindings whose storage remains a projection of their subject rather than a separate local.
fn placeOwnerIndex(builder: &Builder, stored: &Place) -> usize {
  let owners = List<Owner>.asSlice(&builder.owners)
  let mut at = owners.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if owners[at].local == stored.local && prefixPath(List<Projection>.asSlice(&owners[at].path), List<Projection>.asSlice(&stored.projections)) {
      return at
    }
  }
  return usize.MAX
}

// The binding owner of match subject node `subject` that contains the place `steps` deep that
// site `node` consumes: one whose path the site's moved path extends, or MAX.
fn bindingOwnerIndex(builder: &Builder, subject: usize, node: usize, steps: usize) -> usize {
  let owners = List<Owner>.asSlice(&builder.owners)
  let remainder = remainderIndex(builder, node)
  let mut at = owners.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if owners[at].subject == subject {
      let path = List<Projection>.asSlice(&owners[at].path)
      let mut contains = path.length <= steps
      if contains && path.length != usize.ZERO {
        contains = remainder != usize.MAX
        let mut depth = usize.ZERO
        while contains && depth < path.length {
          contains = stepMatches(builder, remainder, depth, &path[depth])
          depth = depth + usize.ONE
        }
      }
      if contains { return at }
    }
  }
  return usize.MAX
}

// Drop elaboration (MIR core shape §4). Each owner has a move-path tree of cleanup nodes, built
// when it is acquired, and each node has one state on the current path: live, moved, or the drop
// flag whose runtime value answers for the paths that joined here. A drop then reads the states of
// the node's subtree, wherever control came from.

// The state of a node whose storage is initialized on every path here.
fn liveState() -> usize { return usize.MAX }

// The state of a node whose storage holds nothing to clean on every path here.
fn movedState() -> usize { return usize.MAX - usize.ONE }

// What `uniformState` answers when a subtree's nodes disagree: its drop opens into its children.
fn mixedState() -> usize { return usize.MAX - 2 }

fn nodeState(builder: &Builder, node: usize) -> usize {
  return List<usize>.asSlice(&builder.states)[node]
}

fn setNodeState(builder: &mut Builder, node: usize, state: usize) -> () {
  let mut states = List<usize>.asMutSlice(&mut builder.*.states)
  states[node] = state
  return ()
}

// The states a drop reads: the current path's, or those recorded for exit plan `plan`.
fn stateSource(builder: &Builder, plan: usize) -> &[usize] {
  if plan == usize.MAX { return List<usize>.asSlice(&builder.states) }
  return List<usize>.asSlice(&List<List<usize>>.asSlice(&builder.dropPlans)[plan])
}

// The one state every node of `node`'s subtree has in `states`, or `mixedState()`.
fn uniformState(builder: &Builder, states: &[usize], node: usize) -> usize {
  let own = states[node]
  let nodes = List<CleanupNode>.asSlice(&builder.cleanup)
  let partitions = List<CleanupPartition>.asSlice(&nodes[node].partitions)
  let mut partition = usize.ZERO
  while partition < partitions.length {
    let children = List<usize>.asSlice(&partitions[partition].children)
    let mut child = usize.ZERO
    while child < children.length {
      if uniformState(builder, states, children[child]) != own { return mixedState() }
      child = child + usize.ONE
    }
    partition = partition + usize.ONE
  }
  return own
}

// The nodes of `node`'s subtree, `node` first and every child after its parent.
effect fn subtree(builder: &Builder, node: usize) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let nodes = List<CleanupNode>.asSlice(&builder.cleanup)
  let mut found = List<usize>.make()
  run List<usize>.append(&mut found, node)
  let mut at = usize.ZERO
  while at < List<usize>.length(&found) {
    let current = List<usize>.asSlice(&found)[at]
    let partitions = List<CleanupPartition>.asSlice(&nodes[current].partitions)
    let mut partition = usize.ZERO
    while partition < partitions.length {
      let children = List<usize>.asSlice(&partitions[partition].children)
      let mut child = usize.ZERO
      while child < children.length {
        run List<usize>.append(&mut found, children[child])
        child = child + usize.ONE
      }
      partition = partition + usize.ONE
    }
    at = at + usize.ONE
  }
  return move found
}

// Gives every node of `node`'s subtree state `state`: a move ends all of it, and a store of a
// whole value initializes all of it.
effect fn settleSubtree(builder: &mut Builder, node: usize, state: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let found = run subtree(&builder.*, node)
  let listed = List<usize>.asSlice(&found)
  let mut states = List<usize>.asMutSlice(&mut builder.*.states)
  let mut at = usize.ZERO
  while at < listed.length {
    states[listed[at]] = state
    at = at + usize.ONE
  }
  return ()
}

// A whole transfer ends every node of the owner.
effect fn moveOwner(builder: &mut Builder, index: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let root = List<Owner>.asSlice(&builder.owners)[index].root
  return run settleSubtree(&mut builder.*, root, movedState())
}

// Whether owner `index` may have been transferred whole on some path here.
fn ownerEnded(builder: &Builder, index: usize) -> bool {
  let root = List<Owner>.asSlice(&builder.owners)[index].root
  return nodeState(builder, root) != liveState()
}

// Which cleanup nodes belong to an owner that is still acquired.
effect fn liveNodes(builder: &Builder) -> List<bool> ! OutOfMemoryError ? &mut Allocator {
  let count = List<CleanupNode>.length(&builder.cleanup)
  let mut alive = run List<bool>.makeWithCapacity(count)
  run List<bool>.appendRepeated(&mut alive, false, count)
  let owners = List<Owner>.asSlice(&builder.owners)
  let mut index = usize.ZERO
  while index < owners.length {
    let found = run subtree(builder, owners[index].root)
    let listed = List<usize>.asSlice(&found)
    let mut marked = List<bool>.asMutSlice(&mut alive)
    let mut at = usize.ZERO
    while at < listed.length {
      marked[listed[at]] = true
      at = at + usize.ONE
    }
    index = index + usize.ONE
  }
  return move alive
}

// The one drop flag of `node`, created on first use. Every join and loop header that leaves the
// node's state path-dependent writes this flag on its incoming edges, so a state names at most
// this one flag and an edge never reads a flag it also writes.
effect fn nodeFlag(builder: &mut Builder, node: usize, origin: Origin) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let nodes = List<CleanupNode>.asSlice(&builder.cleanup)
  let existing = nodes[node].flag
  if existing != usize.MAX { return existing }
  let stored = run copyPlace(&nodes[node].place)
  let flag = List<Local>.length(&builder.function.locals)
  let boolean = run Types.intern(Type.Primitive {name: run Bytes.copy(b"bool")})
  run List<Local>.append(&mut builder.*.function.locals, Local {ty: move boolean,
    kind: LocalKind.DropFlag {local: stored.local, path: move stored.projections}, origin: origin})
  let mut mutable = List<CleanupNode>.asMutSlice(&mut builder.*.cleanup)
  mutable[node].flag = flag
  return flag
}

// The value a flag takes on an edge whose state for the node is the constant `state`.
fn stateValue(state: usize) -> Operand {
  return Operand.Boolean {value: state == liveState()}
}

// Flag writes belong to the actual incoming edge, including copies when a Maybe parent is split.
effect fn flagOnEdge(builder: &mut Builder, edge: usize, flag: usize, value: Operand, origin: Origin) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut blocks = List<Block>.asMutSlice(&mut builder.*.function.blocks)
  return run List<Statement>.append(&mut blocks[edge].statements,
    Statement.Assign {destination: place(flag), value: Rvalue.Use {value: move value}, origin: origin})
}

effect fn copyIndices(values: &List<usize>) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let listed = List<usize>.asSlice(values)
  let mut copied = run List<usize>.makeWithCapacity(listed.length)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<usize>.append(&mut copied, listed[at])
    at = at + usize.ONE
  }
  return move copied
}

effect fn copyCleanupPath(builder: &Builder, node: usize) -> List<Projection>
! OutOfMemoryError ? &mut Allocator {
  let nodes = List<CleanupNode>.asSlice(&builder.cleanup)
  return run copyProjectionPath(&nodes[node].place.projections)
}

effect fn newOwner(builder: &mut Builder, local: usize, path: List<Projection>, subject: usize, ty: &Interned<Type>) -> usize
! CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut stored = place(local)
  let listed = List<Projection>.asSlice(&path)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<Projection>.append(&mut stored.projections, run copyProjection(&listed[at]))
    at = at + usize.ONE
  }
  let root = List<CleanupNode>.length(&builder.cleanup)
  let owner = InstanceKey.identity(&builder.function.key)
  let sourceOwner = DeclarationId.copyShared(&owner)
  let glue = match move run InstanceKey.dropGlue(ty, &sourceOwner) {
    Result<Option<InstanceKey>, CanonicalizationFailure>.Success {value: canonicalGlue} => move canonicalGlue
    Result<Option<InstanceKey>, CanonicalizationFailure>.Failure {error: reason} => { fail move reason }
  }
  run List<CleanupNode>.append(&mut builder.*.cleanup, CleanupNode {place: move stored, ty: Interned<Type>.clone(ty), glue: move glue,
    partitions: List<CleanupPartition>.make(), tags: usize.ZERO, flag: usize.MAX})
  run List<usize>.append(&mut builder.*.states, liveState())
  let index = List<Owner>.length(&builder.owners)
  run List<Owner>.append(&mut builder.*.owners, Owner {local: local, path: move path, subject: subject, ty: Interned<Type>.clone(ty),
    root: root})
  return index
}

// A local whose value needs cleanup becomes a live owner of the innermost scope.
effect fn acquire(builder: &mut Builder, local: usize, ty: &Interned<Type>, needed: bool) -> () ! CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !needed { return () }
  let index = run newOwner(&mut builder.*, local, List<Projection>.make(), usize.MAX, ty)
  // Typed-body local `k` is MIR local `k + 1`; a temporary matches no consuming site.
  let mut typed = usize.MAX
  if local != usize.ZERO { typed = local - usize.ONE }
  return run expandOwner(&mut builder.*, index, typed, usize.MAX)
}

// Builds owner `index`'s move-path tree before anything moves. Every partial consuming site of
// the body whose place lies strictly inside the owner (rooted at typed local `local`, or at match
// subject node `subject`) splits each node on its path into the complete children of that node's
// level, so a later move, store or drop finds its node however control reached it.
effect fn expandOwner(builder: &mut Builder, index: usize, local: usize, subject: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = List<Remainder>.length(&builder.remainders)
  let depth = ownerDepth(&builder.*, index)
  let root = List<Owner>.asSlice(&builder.owners)[index].root
  let mut remainder = usize.ZERO
  while remainder < count {
    let remainders = List<Remainder>.asSlice(&builder.remainders)
    let site = &remainders[remainder]
    let rooted = (local != usize.MAX && site.local == local) || (subject != usize.MAX && site.subject == subject)
    let steps = List<Projection>.length(&site.steps)
    let owned = rooted && steps > depth
      && prefixPath(List<Projection>.asSlice(&List<Owner>.asSlice(&builder.owners)[index].path), List<Projection>.asSlice(&site.steps))
    if owned {
      let mut node = root
      let mut at = depth
      while node != usize.MAX && at < steps {
        node = run partitionChild(&mut builder.*, node, remainder, at)
        at = at + usize.ONE
      }
    }
    remainder = remainder + usize.ONE
  }
  return ()
}

// The child of `node` that remainder `remainder`'s step at `depth` selects. The node's partition
// for that step is created on first use: one complete partition of a nominal value or array, and
// one per member or variant tag of a union. A runtime index or a level with a Drop hook selects no
// tracked child; the ownership check rejects a partial move through either.
effect fn partitionChild(builder: &mut Builder, node: usize, remainder: usize, depth: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  let remainders = List<Remainder>.asSlice(&builder.remainders)
  let level = &List<RemainderLevel>.asSlice(&remainders[remainder].levels)[depth]
  let step = run copyProjection(&List<Projection>.asSlice(&remainders[remainder].steps)[depth])
  if runtimeIndex(&step) || level.hooked { return usize.MAX }
  let mut tags = usize.ZERO
  match &level.children {
    GlueChildren.Members {count, ..} => { tags = count }
    GlueChildren.Variants {count, ..} => { tags = count }
    _ => {}
  }
  let mut tag = usize.MAX
  if tags != usize.ZERO {
    tag = match &step {
      Projection.Payload {index, ..} => index
      Projection.VariantField {variant, ..} => variant
      _ => usize.MAX
    }
  }
  let mut found = usize.MAX
  let existing = List<CleanupPartition>.asSlice(&List<CleanupNode>.asSlice(&builder.cleanup)[node].partitions)
  let mut at = usize.ZERO
  while at < existing.length {
    if existing[at].tag == tag { found = at }
    at = at + usize.ONE
  }
  if found == usize.MAX {
    found = existing.length
    let parent = run copyPlace(&List<CleanupNode>.asSlice(&builder.cleanup)[node].place)
    let inherited = nodeState(&builder.*, node)
    let children = run remainderChildren(&builder.*, remainder, depth)
    let listed = List<GlueChild>.asSlice(&children)
    let mut created = run List<usize>.makeWithCapacity(listed.length)
    let mut child = usize.ZERO
    while child < listed.length {
      let mut stored = run copyPlace(&parent)
      run List<Projection>.append(&mut stored.projections, run childStep(&builder.*, remainder, depth, &listed[child]))
      run List<usize>.append(&mut created, List<CleanupNode>.length(&builder.cleanup))
      run List<CleanupNode>.append(&mut builder.*.cleanup, CleanupNode {place: move stored, ty: Interned<Type>.clone(&listed[child].ty),
        glue: Option<InstanceKey>.some(InstanceKey.copy(&listed[child].glue)), partitions: List<CleanupPartition>.make(),
        tags: usize.ZERO, flag: usize.MAX})
      run List<usize>.append(&mut builder.*.states, inherited)
      child = child + usize.ONE
    }
    let mut mutable = List<CleanupNode>.asMutSlice(&mut builder.*.cleanup)
    mutable[node].tags = tags
    run List<CleanupPartition>.append(&mut mutable[node].partitions, CleanupPartition {tag: tag, children: move created})
  }
  let nodes = List<CleanupNode>.asSlice(&builder.cleanup)
  let children = List<usize>.asSlice(&List<CleanupPartition>.asSlice(&nodes[node].partitions)[found].children)
  at = usize.ZERO
  while at < children.length {
    let path = List<Projection>.asSlice(&nodes[children[at]].place.projections)
    if path.length != usize.ZERO && sameProjection(&path[path.length - usize.ONE], &step) { return children[at] }
    at = at + usize.ONE
  }
  return usize.MAX
}

// The node of owner `index` at the path consuming site `remainder` moves.
fn releasedNode(builder: &Builder, index: usize, remainder: usize) -> usize {
  if index == usize.MAX || remainder == usize.MAX { return CompilerBug.panic(b"a partial move reached MIR without its owner's remainder") }
  let remainders = List<Remainder>.asSlice(&builder.remainders)
  let root = List<Owner>.asSlice(&builder.owners)[index].root
  let found = componentPathNode(builder, root, List<Projection>.asSlice(&remainders[remainder].steps))
  if found == usize.MAX { return CompilerBug.panic(b"a partial move reached MIR outside its owner's move-path tree") }
  return found
}

// Applies a consuming site's whole or partial transfer to the states of its owner's nodes.
effect fn applyRelease(builder: &mut Builder, release: &Release, needed: bool, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  let mut index = usize.MAX
  let mut site = usize.MAX
  match &release.* {
    Release.Value => { return () }
    Release.Whole {local} => {
      let whole = ownerIndex(&builder.*, local)
      if whole != usize.MAX { run moveOwner(&mut builder.*, whole) }
      return ()
    }
    Release.Partial {local, node} => {
      if !needed { return () }
      index = ownerIndex(&builder.*, local)
      site = node
    }
    Release.Binding {subject, node, steps} => {
      if !needed { return () }
      index = bindingOwnerIndex(&builder.*, subject, node, steps)
      if index != usize.MAX && ownerDepth(&builder.*, index) == steps { return run moveOwner(&mut builder.*, index) }
      site = node
    }
  }
  let node = releasedNode(&builder.*, index, remainderIndex(&builder.*, site))
  return run settleSubtree(&mut builder.*, node, movedState())
}

fn remainderIndex(builder: &Builder, node: usize) -> usize {
  let listed = List<Remainder>.asSlice(&builder.remainders)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].node == node { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

// A copy of the current path's owner states, which branch restoration and joins read back.
effect fn ownerStates(builder: &Builder) -> OwnerSnapshot ! OutOfMemoryError ? &mut Allocator {
  return OwnerSnapshot {owners: List<Owner>.length(&builder.owners), states: run copyIndices(&builder.states)}
}

effect fn copyStates(states: &OwnerSnapshot) -> OwnerSnapshot ! OutOfMemoryError ? &mut Allocator {
  return OwnerSnapshot {owners: states.owners, states: run copyIndices(&states.states)}
}

// The move-path trees and their flags survive restoration; only the path-dependent states change.
// A node created after the snapshot belongs to an owner the restored path no longer holds.
effect fn restoreOwners(builder: &mut Builder, states: &OwnerSnapshot) -> () ! OutOfMemoryError ? &mut Allocator {
  truncateOwners(&mut builder.*, states.owners)
  let mut restored = run copyIndices(&states.states)
  let missing = List<CleanupNode>.length(&builder.cleanup) - List<usize>.length(&restored)
  run List<usize>.appendRepeated(&mut restored, movedState(), missing)
  builder.states = move restored
  return ()
}

effect fn arrival(builder: &Builder) -> Arrival ! OutOfMemoryError ? &mut Allocator {
  return Arrival {block: builder.current, states: run ownerStates(builder)}
}

// Joins the incoming edges' states node by node. A node whose arrivals disagree takes its flag,
// which each disagreeing edge writes; an edge whose state already is that flag writes nothing.
effect fn joinOwners(builder: &mut Builder, arrivals: &[Arrival], origin: Origin) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if arrivals.length == usize.ZERO { return () }
  if arrivals.length == usize.ONE { return run restoreOwners(&mut builder.*, &arrivals[usize.ZERO].states) }
  let alive = run liveNodes(&builder.*)
  let count = List<CleanupNode>.length(&builder.cleanup)
  let mut joined = run List<usize>.makeWithCapacity(count)
  let mut node = usize.ZERO
  while node < count {
    if !List<bool>.asSlice(&alive)[node] {
      run List<usize>.append(&mut joined, movedState())
      node = node + usize.ONE
      continue
    }
    let first = arrivalState(&arrivals[usize.ZERO], node)
    let mut same = true
    let mut at = usize.ONE
    while at < arrivals.length {
      if arrivalState(&arrivals[at], node) != first { same = false }
      at = at + usize.ONE
    }
    if same {
      run List<usize>.append(&mut joined, first)
    } else {
      let flag = run nodeFlag(&mut builder.*, node, origin)
      at = usize.ZERO
      while at < arrivals.length {
        let state = arrivalState(&arrivals[at], node)
        if state != flag { run flagOnEdge(&mut builder.*, arrivals[at].block, flag, stateValue(state), origin) }
        at = at + usize.ONE
      }
      run List<usize>.append(&mut joined, flag)
    }
    node = node + usize.ONE
  }
  builder.states = move joined
  return ()
}

// The state of `node` on an incoming edge. A node of an owner the join still holds existed when
// the edge was recorded, since owners are acquired in scopes the join encloses.
fn arrivalState(arrival: &Arrival, node: usize) -> usize {
  let states = List<usize>.asSlice(&arrival.states.states)
  if node >= states.length { return CompilerBug.panic(b"a join edge was recorded before an owner the join holds") }
  return states[node]
}

// Whether the current path's states are still those of `states`.
fn sameStates(builder: &Builder, states: &OwnerSnapshot) -> bool {
  let current = List<usize>.asSlice(&builder.states)
  let saved = List<usize>.asSlice(&states.states)
  let mut at = usize.ZERO
  let nodes = List<CleanupNode>.asSlice(&builder.cleanup)
  while at < saved.length {
    // A loop inside the guard keeps a moved node moved under its flag.
    if current[at] != saved[at] && !(saved[at] == movedState() && current[at] == nodes[at].flag) { return false }
    at = at + usize.ONE
  }
  return true
}

// Opens a loop header. A node live on entry stays live on every back edge (the ownership check
// rejects a move that a later iteration would see, OWN0005); a moved node of a source place may
// become live again in the body, so its header state is its flag, written on the entry edge here and on each back
// edge by `repeatLoop`. The result lists each node's header state, or `mixedState()` for a node no
// owner holds; no node's state is ever mixed, so the two cannot be confused.
effect fn loopHeads(builder: &mut Builder, origin: Origin) -> List<usize> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let alive = run liveNodes(&builder.*)
  let count = List<CleanupNode>.length(&builder.cleanup)
  let mut heads = run List<usize>.makeWithCapacity(count)
  let mut node = usize.ZERO
  while node < count {
    let mut head = mixedState()
    if List<bool>.asSlice(&alive)[node] {
      let state = nodeState(&builder.*, node)
      head = state
      if state == movedState() && refillable(&builder.*, node) {
        head = run nodeFlag(&mut builder.*, node, origin)
        if builder.live { run assign(&mut builder.*, place(head), Rvalue.Use {value: stateValue(state)}, origin) }
        setNodeState(&mut builder.*, node, head)
      }
    }
    run List<usize>.append(&mut heads, head)
    node = node + usize.ONE
  }
  return move heads
}

// Whether a moved node can become live again: only source can store into a place, and a
// temporary is written once, so a temporary's moved part stays moved and needs no loop flag.
fn refillable(builder: &Builder, node: usize) -> bool {
  let local = List<CleanupNode>.asSlice(&builder.cleanup)[node].place.local
  return match &List<Local>.asSlice(&builder.function.locals)[local].kind {
    LocalKind.Temp => false
    _ => true
  }
}

// Ends the current block's path as a back edge to a loop header with states `heads`.
effect fn repeatLoop(builder: &mut Builder, heads: &List<usize>, origin: Origin) -> () ! OutOfMemoryError ? &mut Allocator {
  let listed = List<usize>.asSlice(heads)
  let mut node = usize.ZERO
  while node < listed.length {
    let head = listed[node]
    let state = nodeState(&builder.*, node)
    if head == liveState() && state != liveState() { return CompilerBug.panic(b"a loop back edge ends an owner that is live on entry") }
    if head == movedState() && state != movedState() { return CompilerBug.panic(b"a loop back edge refills a temporary's moved part") }
    if head != mixedState() && head != liveState() && head != movedState() && state != head {
      run assign(&mut builder.*, place(head), Rvalue.Use {value: stateValue(state)}, origin)
    }
    node = node + usize.ONE
  }
  return ()
}

// Drops what `node`'s subtree still owns, on the current path (plan usize.MAX) or as recorded by
// exit plan `plan`: its whole value when every node is live, nothing when every node is moved, its
// whole value under the flag every node shares, and otherwise each child of its partition in turn.
// An open union first selects the partition of its active member or variant by its runtime tag;
// a tag no partial move reached keeps the union's own state.
effect fn elaborate(builder: &mut Builder, node: usize, plan: usize, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !builder.live { return () }
  let state = uniformState(&builder.*, stateSource(&builder.*, plan), node)
  if state != mixedState() { return run dropNodeAs(&mut builder.*, node, state, origin) }
  let tags = List<CleanupNode>.asSlice(&builder.cleanup)[node].tags
  if tags == usize.ZERO {
    let children = run partitionChildren(&builder.*, node, usize.ZERO)
    let listed = List<usize>.asSlice(&children)
    let mut at = usize.ZERO
    while at < listed.length {
      run elaborate(&mut builder.*, listed[at], plan, origin)
      at = at + usize.ONE
    }
    return ()
  }
  // A payload moved on every path here proves its member or variant is the active one.
  let proven = run provenPartition(&builder.*, stateSource(&builder.*, plan), node)
  if proven != usize.MAX {
    let children = run partitionChildren(&builder.*, node, proven)
    let listed = List<usize>.asSlice(&children)
    let mut at = usize.ZERO
    while at < listed.length {
      run elaborate(&mut builder.*, listed[at], plan, origin)
      at = at + usize.ONE
    }
    return ()
  }
  let own = stateSource(&builder.*, plan)[node]
  let stored = run copyPlace(&List<CleanupNode>.asSlice(&builder.cleanup)[node].place)
  let tagType = run Layout.tagType(tags)
  let read = run temporary(&mut builder.*, &tagType, origin)
  run assign(&mut builder.*, place(read), Rvalue.Discriminant {place: move stored}, origin)
  let count = List<CleanupPartition>.length(&List<CleanupNode>.asSlice(&builder.cleanup)[node].partitions)
  let after = run block(&mut builder.*, origin)
  let otherwise = run block(&mut builder.*, origin)
  let mut cases = List<SwitchCase>.make()
  let mut targets = List<usize>.make()
  let mut at = usize.ZERO
  while at < count {
    let tag = List<CleanupPartition>.asSlice(&List<CleanupNode>.asSlice(&builder.cleanup)[node].partitions)[at].tag
    let target = run block(&mut builder.*, origin)
    run List<usize>.append(&mut targets, target)
    run List<SwitchCase>.append(&mut cases, SwitchCase {decimal: run Type.extentText(tag), negative: false, target: target})
    at = at + usize.ONE
  }
  terminate(&mut builder.*, Terminator.Switch {value: Operand.Copy {place: place(read)}, cases: move cases, otherwise: otherwise, origin: origin})
  at = usize.ZERO
  while at < count {
    resume(&mut builder.*, List<usize>.asSlice(&targets)[at])
    let children = run partitionChildren(&builder.*, node, at)
    let listed = List<usize>.asSlice(&children)
    let mut child = usize.ZERO
    while child < listed.length {
      run elaborate(&mut builder.*, listed[child], plan, origin)
      child = child + usize.ONE
    }
    terminate(&mut builder.*, Terminator.Goto {target: after, origin: origin})
    at = at + usize.ONE
  }
  resume(&mut builder.*, otherwise)
  run dropNodeAs(&mut builder.*, node, own, origin)
  terminate(&mut builder.*, Terminator.Goto {target: after, origin: origin})
  resume(&mut builder.*, after)
  return ()
}

// The partition of union `node` holding a node that `states` records as moved, or usize.MAX. Only
// the active member's payload can be moved, so that partition is the one present.
effect fn provenPartition(builder: &Builder, states: &[usize], node: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  let count = List<CleanupPartition>.length(&List<CleanupNode>.asSlice(&builder.cleanup)[node].partitions)
  let mut partition = usize.ZERO
  while partition < count {
    let children = run partitionChildren(builder, node, partition)
    let listed = List<usize>.asSlice(&children)
    let mut at = usize.ZERO
    while at < listed.length {
      let found = run subtree(builder, listed[at])
      let reached = List<usize>.asSlice(&found)
      let mut position = usize.ZERO
      while position < reached.length {
        if states[reached[position]] == movedState() { return partition }
        position = position + usize.ONE
      }
      at = at + usize.ONE
    }
    partition = partition + usize.ONE
  }
  return usize.MAX
}

effect fn partitionChildren(builder: &Builder, node: usize, partition: usize) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let nodes = List<CleanupNode>.asSlice(&builder.cleanup)
  return run copyIndices(&List<CleanupPartition>.asSlice(&nodes[node].partitions)[partition].children)
}

// Drops `node`'s whole value in one state: through its glue when live, under the flag that holds
// its answer, or not at all when moved. Only an owner of an open abstract type has no glue.
effect fn dropNodeAs(builder: &mut Builder, node: usize, state: usize, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  if state == movedState() || !builder.live { return () }
  let nodes = List<CleanupNode>.asSlice(&builder.cleanup)
  let stored = run copyPlace(&nodes[node].place)
  let glue = match &nodes[node].glue {
    Option<InstanceKey>.Some {value} => InstanceKey.copy(&value)
    Option<InstanceKey>.None => {
      let identity = InstanceKey.identity(&builder.function.key)
      return run unsupported(&identity, origin, GapCode.OpenInstance)
    }
  }
  if state == liveState() { return run dropPrepared(&mut builder.*, move stored, move glue, origin) }
  let dropping = run block(&mut builder.*, origin)
  let after = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: Operand.Copy {place: place(state)}, thenBlock: dropping, elseBlock: after, origin: origin})
  resume(&mut builder.*, dropping)
  run dropPrepared(&mut builder.*, move stored, move glue, origin)
  terminate(&mut builder.*, Terminator.Goto {target: after, origin: origin})
  resume(&mut builder.*, after)
  return ()
}

// Lexical owners are dropped in acquisition order, each by elaborating its move-path tree.
effect fn dropOwner(builder: &mut Builder, index: usize, origin: Origin) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let root = List<Owner>.asSlice(&builder.owners)[index].root
  return run elaborate(&mut builder.*, root, usize.MAX, origin)
}

// Ends the temporaries created since `pending` on the current path.
effect fn endTemporaries(builder: &mut Builder, pending: usize, origin: Origin) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if builder.live { run dropTemporariesFrom(&mut builder.*, pending, origin) }
  return truncateTemporaries(&mut builder.*, pending)
}

// A condition is copied out of its expression's temporaries before they end, so a test never reads
// dropped storage.
effect fn settledCondition(builder: &mut Builder, condition: Operand, pending: usize, origin: Origin) -> Operand ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if List<Pending>.length(&builder.temporaries) == pending { return move condition }
  let boolean = run Types.intern(Type.Primitive {name: run Bytes.copy(b"bool")})
  let copied = run temporary(&mut builder.*, &boolean, origin)
  run assign(&mut builder.*, place(copied), Rvalue.Use {value: move condition}, origin)
  run endTemporaries(&mut builder.*, pending, origin)
  return Operand.Copy {place: place(copied)}
}

// The node of the tree under `node` whose place is exactly `path`, or usize.MAX.
fn componentPathNode(builder: &Builder, node: usize, path: &[Projection]) -> usize {
  let nodes = List<CleanupNode>.asSlice(&builder.cleanup)
  let actual = List<Projection>.asSlice(&nodes[node].place.projections)
  if !prefixPath(actual, path) { return usize.MAX }
  if actual.length == path.length { return node }
  let partitions = List<CleanupPartition>.asSlice(&nodes[node].partitions)
  let mut partition = usize.ZERO
  while partition < partitions.length {
    let children = List<usize>.asSlice(&partitions[partition].children)
    let mut child = usize.ZERO
    while child < children.length {
      let found = componentPathNode(builder, children[child], path)
      if found != usize.MAX { return found }
      child = child + usize.ONE
    }
    partition = partition + usize.ONE
  }
  return usize.MAX
}

// The deepest node under `node` whose place is a prefix of `path`.
fn containingNode(builder: &Builder, node: usize, path: &[Projection]) -> usize {
  let nodes = List<CleanupNode>.asSlice(&builder.cleanup)
  let partitions = List<CleanupPartition>.asSlice(&nodes[node].partitions)
  let mut partition = usize.ZERO
  while partition < partitions.length {
    let children = List<usize>.asSlice(&partitions[partition].children)
    let mut child = usize.ZERO
    while child < children.length {
      if prefixPath(List<Projection>.asSlice(&nodes[children[child]].place.projections), path) {
        return containingNode(builder, children[child], path)
      }
      child = child + usize.ONE
    }
    partition = partition + usize.ONE
  }
  return node
}

fn runtimeIndex(step: &Projection) -> bool {
  return match &step.* {
    Projection.Index {..} => true
    _ => false
  }
}

fn sameProjection(left: &Projection, right: &Projection) -> bool {
  return match &left.* {
    Projection.Field {index} => match &right.* { Projection.Field {index: other} => index == other _ => false }
    Projection.ConstIndex {index} => match &right.* { Projection.ConstIndex {index: other} => index == other _ => false }
    Projection.Payload {index, ..} => match &right.* { Projection.Payload {index: other, ..} => index == other _ => false }
    Projection.VariantField {variant, field} => match &right.* {
      Projection.VariantField {variant: otherVariant, field: otherField} => variant == otherVariant && field == otherField
      _ => false
    }
    _ => false
  }
}

pub effect fn copyProjection(value: &Projection) -> Projection ! OutOfMemoryError ? &mut Allocator {
  return match &value.* {
    Projection.Field {index} => Projection.Field {index: index}
    Projection.Payload {index, ty} => Projection.Payload {index: index, ty: Interned<Type>.clone(&ty)}
    Projection.VariantField {variant, field} => Projection.VariantField {variant: variant, field: field}
    Projection.Index {local} => Projection.Index {local: local}
    Projection.ConstIndex {index} => Projection.ConstIndex {index: index}
    Projection.Deref => Projection.Deref
  }
}

effect fn copyChildList(children: &List<GlueChild>) -> List<GlueChild> ! OutOfMemoryError ? &mut Allocator {
  let listed = List<GlueChild>.asSlice(children)
  let mut copied = run List<GlueChild>.makeWithCapacity(listed.length)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<GlueChild>.append(&mut copied, GlueChild {index: listed[at].index, ty: Interned<Type>.clone(&listed[at].ty), glue: InstanceKey.copy(&listed[at].glue)})
    at = at + usize.ONE
  }
  return move copied
}

// The complete ordered children at `depth` of the owner this consuming path passes through:
// every droppable field or element, or the active member's payload or variant's fields.
effect fn remainderChildren(builder: &Builder, remainder: usize, depth: usize) -> List<GlueChild> ! OutOfMemoryError ? &mut Allocator {
  let remainders = List<Remainder>.asSlice(&builder.remainders)
  let levels = List<RemainderLevel>.asSlice(&remainders[remainder].levels)
  let steps = List<Projection>.asSlice(&remainders[remainder].steps)
  let level = &levels[depth]
  let step = &steps[depth]
  let mut selected = List<GlueChild>.make()
  match &level.children {
    GlueChildren.Fields {fields} => { selected = run copyChildList(&fields) }
    GlueChildren.Elements {element, count} => {
      let mut at = usize.ZERO
      while at < count {
        run List<GlueChild>.append(&mut selected, GlueChild {index: at, ty: Interned<Type>.clone(&element.ty), glue: InstanceKey.copy(&element.glue)})
        at = at + usize.ONE
      }
    }
    GlueChildren.Members {members, ..} => {
      if let Projection.Payload {index: tag, ..} = &step.* {
        let listed = List<GlueChild>.asSlice(&members)
        let mut at = usize.ZERO
        while at < listed.length {
          if listed[at].index == tag {
            run List<GlueChild>.append(&mut selected, GlueChild {index: tag, ty: Interned<Type>.clone(&listed[at].ty), glue: InstanceKey.copy(&listed[at].glue)})
          }
          at = at + usize.ONE
        }
      }
    }
    GlueChildren.Variants {variants, ..} => {
      if let Projection.VariantField {variant, ..} = &step.* {
        let listed = List<GlueVariant>.asSlice(&variants)
        let mut at = usize.ZERO
        while at < listed.length {
          if listed[at].tag == variant { selected = run copyChildList(&listed[at].fields) }
          at = at + usize.ONE
        }
      }
    }
  }
  return move selected
}

// The projection selecting child `index` at `depth`, in the step's own form.
effect fn childStep(builder: &Builder, remainder: usize, depth: usize, child: &GlueChild) -> Projection ! OutOfMemoryError ? &mut Allocator {
  let remainders = List<Remainder>.asSlice(&builder.remainders)
  let steps = List<Projection>.asSlice(&remainders[remainder].steps)
  let step = &steps[depth]
  return match &step.* {
    Projection.ConstIndex {..} => Projection.ConstIndex {index: child.index}
    Projection.Payload {..} => Projection.Payload {index: child.index, ty: Interned<Type>.clone(&child.ty)}
    Projection.VariantField {variant, ..} => Projection.VariantField {variant: variant, field: child.index}
    _ => Projection.Field {index: child.index}
  }
}

fn prefixPath(first: &[Projection], second: &[Projection]) -> bool {
  if first.length > second.length { return false }
  let mut at = usize.ZERO
  while at < first.length {
    if !sameProjection(&first[at], &second[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn copyProjectionPath(path: &List<Projection>) -> List<Projection> ! OutOfMemoryError ? &mut Allocator {
  let listed = List<Projection>.asSlice(path)
  let mut copied = run List<Projection>.makeWithCapacity(listed.length)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<Projection>.append(&mut copied, run copyProjection(&listed[at]))
    at = at + usize.ONE
  }
  return move copied
}

// Whether consuming path `remainder`'s step at `depth` selects the same child as `other`.
fn stepMatches(builder: &Builder, remainder: usize, depth: usize, other: &Projection) -> bool {
  let remainders = List<Remainder>.asSlice(&builder.remainders)
  let steps = List<Projection>.asSlice(&remainders[remainder].steps)
  return sameProjection(&steps[depth], other)
}

// Ends the value a store into `destination` replaces, and returns the node the store initializes,
// or usize.MAX. A store of a tracked node elaborates that node's drop; a store inside one live node
// drops the old value through its own glue and leaves the node live. A place no owner holds is
// replaced as one complete value.
effect fn replaceOld(builder: &mut Builder, index: usize, destination: &Place, ty: &Interned<Type>, origin: Origin) -> usize
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let identity = InstanceKey.identity(&builder.function.key)
  if index == usize.MAX {
    run dropPlace(&mut builder.*, run copyPlace(destination), ty, &identity, origin)
    return usize.MAX
  }
  let root = List<Owner>.asSlice(&builder.owners)[index].root
  let written = List<Projection>.asSlice(&destination.projections)
  let node = containingNode(&builder.*, root, written)
  if List<Projection>.length(&List<CleanupNode>.asSlice(&builder.cleanup)[node].place.projections) == written.length {
    run elaborate(&mut builder.*, node, usize.MAX, origin)
    return node
  }
  // A union's partitions cover only the tags partial moves reached; any other tag is its own state.
  let mut state = nodeState(&builder.*, node)
  if List<CleanupNode>.asSlice(&builder.cleanup)[node].tags == usize.ZERO {
    state = uniformState(&builder.*, List<usize>.asSlice(&builder.states), node)
  }
  // The ownership check rejects a store into storage that may hold no value (OWN0001).
  if state != liveState() { return CompilerBug.panic(b"a store reached MIR inside storage that may hold no value") }
  run dropPlace(&mut builder.*, run copyPlace(destination), ty, &identity, origin)
  return usize.MAX
}

// After a store, the node it initialized is live, with all its parts.
effect fn refill(builder: &mut Builder, node: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if node == usize.MAX { return () }
  return run settleSubtree(&mut builder.*, node, liveState())
}

effect fn dropReleased(builder: &mut Builder, release: &Release, storage: Place, ty: &Interned<Type>, needed: bool, origin: Origin)
  -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut index = usize.MAX
  let mut site = usize.MAX
  let mut whole = false
  match &release.* {
    Release.Whole {local} => {
      index = ownerIndex(&builder.*, local)
      whole = true
    }
    Release.Partial {local, node} => {
      index = ownerIndex(&builder.*, local)
      site = node
    }
    Release.Binding {subject, node, steps} => {
      index = bindingOwnerIndex(&builder.*, subject, node, steps)
      site = node
      if index != usize.MAX { whole = ownerDepth(&builder.*, index) == steps }
    }
    Release.Value => {}
  }
  if !needed { return run applyRelease(&mut builder.*, release, false, origin) }
  if index == usize.MAX {
    if !whole { return CompilerBug.panic(b"a partial drop reached MIR without its owner") }
    let identity = InstanceKey.identity(&builder.function.key)
    return run dropPlace(&mut builder.*, move storage, ty, &identity, origin)
  }
  drop storage
  let mut node = List<Owner>.asSlice(&builder.owners)[index].root
  if !whole { node = releasedNode(&builder.*, index, remainderIndex(&builder.*, site)) }
  run elaborate(&mut builder.*, node, usize.MAX, origin)
  return run settleSubtree(&mut builder.*, node, movedState())
}

// Drops owners `from..` innermost first, in reverse acquisition order (CLEANUP-002).
effect fn dropOwnersFrom(builder: &mut Builder, from: usize, origin: Origin) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = List<Owner>.length(&builder.owners)
  while at > from {
    at = at - usize.ONE
    run dropOwner(&mut builder.*, at, origin)
  }
  return ()
}

// Turns temporaries `from..` into owners of the enclosing scope, for bindings that view them.
effect fn retainTemporaries(builder: &mut Builder, from: usize) -> () ! CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = from
  while at < List<Pending>.length(&builder.temporaries) {
    let local = List<Pending>.asSlice(&builder.temporaries)[at].local
    let held = localType(&builder.*, local)
    // Only temporaries that need cleanup are pending.
    run acquire(&mut builder.*, local, &held, true)
    at = at + usize.ONE
  }
  truncateTemporaries(&mut builder.*, from)
  return ()
}

// Drops owned temporaries `from..` in reverse creation order.
effect fn dropTemporariesFrom(builder: &mut Builder, from: usize, origin: Origin) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let mut at = List<Pending>.length(&builder.temporaries)
  while at > from {
    at = at - usize.ONE
    let local = List<Pending>.asSlice(&builder.temporaries)[at].local
    let ty = localType(&builder.*, local)
    run dropPlace(&mut builder.*, place(local), &ty, &owner, origin)
  }
  return ()
}

fn truncateTemporaries(builder: &mut Builder, length: usize) -> () {
  while List<Pending>.length(&builder.temporaries) > length { drop List<Pending>.pop(&mut builder.*.temporaries) }
  return ()
}

effect fn pend(builder: &mut Builder, local: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  return run List<Pending>.append(&mut builder.*.temporaries, Pending {local: local, owners: List<Owner>.length(&builder.owners)})
}

// An exit leaves every temporary created after `temporaries` and every owner acquired after `owners`,
// together in reverse creation order: a temporary drops before the owners that preceded it.
effect fn exitTo(builder: &mut Builder, owners: usize, temporaries: usize, origin: Origin) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let mut held = List<Owner>.length(&builder.owners)
  let mut at = List<Pending>.length(&builder.temporaries)
  while held > owners || at > temporaries {
    let mut temporaryNext = false
    if at > temporaries {
      temporaryNext = held <= owners || List<Pending>.asSlice(&builder.temporaries)[at - usize.ONE].owners >= held
    }
    if temporaryNext {
      at = at - usize.ONE
      let local = List<Pending>.asSlice(&builder.temporaries)[at].local
      let ty = localType(&builder.*, local)
      run dropPlace(&mut builder.*, place(local), &ty, &owner, origin)
    } else {
      held = held - usize.ONE
      run dropOwner(&mut builder.*, held, origin)
    }
  }
  return ()
}

// The drops `exitTo(builder, 0, 0, ..)` would emit, in the same order: every temporary and owner,
// innermost first, each owner's tree elaborated as `elaborate` would. An open union's drop reads
// its subtree's states from an exit plan, so exits that leave it in the same states share it.
effect fn exitDrops(builder: &mut Builder) -> List<ExitDrop> ! OutOfMemoryError ? &mut Allocator {
  let mut drops = List<ExitDrop>.make()
  let mut held = List<Owner>.length(&builder.owners)
  let mut at = List<Pending>.length(&builder.temporaries)
  while held > usize.ZERO || at > usize.ZERO {
    let mut temporaryNext = false
    if at > usize.ZERO {
      temporaryNext = held == usize.ZERO || List<Pending>.asSlice(&builder.temporaries)[at - usize.ONE].owners >= held
    }
    if temporaryNext {
      at = at - usize.ONE
      let local = List<Pending>.asSlice(&builder.temporaries)[at].local
      run List<ExitDrop>.append(&mut drops, ExitDrop {node: usize.MAX, state: liveState(), plan: usize.MAX, temporary: local})
    } else {
      held = held - usize.ONE
      let root = List<Owner>.asSlice(&builder.owners)[held].root
      run appendExitDrops(&mut builder.*, root, &mut drops)
    }
  }
  return move drops
}

effect fn appendExitDrops(builder: &mut Builder, node: usize, drops: &mut List<ExitDrop>) -> () ! OutOfMemoryError ? &mut Allocator {
  let state = uniformState(&builder.*, List<usize>.asSlice(&builder.states), node)
  if state == movedState() { return () }
  if state != mixedState() {
    return run List<ExitDrop>.append(&mut drops.*, ExitDrop {node: node, state: state, plan: usize.MAX, temporary: usize.MAX})
  }
  if List<CleanupNode>.asSlice(&builder.cleanup)[node].tags == usize.ZERO {
    let children = run partitionChildren(&builder.*, node, usize.ZERO)
    let listed = List<usize>.asSlice(&children)
    let mut at = usize.ZERO
    while at < listed.length {
      run appendExitDrops(&mut builder.*, listed[at], &mut drops.*)
      at = at + usize.ONE
    }
    return ()
  }
  let plan = run exitPlan(&mut builder.*, node)
  return run List<ExitDrop>.append(&mut drops.*, ExitDrop {node: node, state: mixedState(), plan: plan, temporary: usize.MAX})
}

// The exit plan recording the current states of `node`'s subtree, shared with an earlier plan
// that recorded the same states.
effect fn exitPlan(builder: &mut Builder, node: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  let found = run subtree(&builder.*, node)
  let listed = List<usize>.asSlice(&found)
  let current = List<usize>.asSlice(&builder.states)
  let plans = List<List<usize>>.asSlice(&builder.dropPlans)
  let mut plan = usize.ZERO
  while plan < plans.length {
    let recorded = List<usize>.asSlice(&plans[plan])
    let mut same = true
    let mut at = usize.ZERO
    while same && at < listed.length {
      same = listed[at] < recorded.length && recorded[listed[at]] == current[listed[at]]
      at = at + usize.ONE
    }
    if same { return plan }
    plan = plan + usize.ONE
  }
  let next = plans.length
  let recorded = run copyIndices(&builder.states)
  run List<List<usize>>.append(&mut builder.*.dropPlans, move recorded)
  return next
}

fn sameExitDrop(left: ExitDrop, right: ExitDrop) -> bool {
  return left.node == right.node && left.state == right.state && left.plan == right.plan && left.temporary == right.temporary
}

// How an exit of `kind` ends; a forwarding one jumps to forward block `forward`.
fn exitTerminator(kind: ExitKind, forward: usize, origin: Origin) -> Terminator {
  if kind == ExitKind.Fails { return Terminator.Fail {origin: origin} }
  if kind == ExitKind.Forwards { return Terminator.Goto {target: forward, origin: origin} }
  if kind == ExitKind.Abandons { return Terminator.Abandon {origin: origin} }
  return Terminator.Return {origin: origin}
}

effect fn exitStep(builder: &mut Builder, next: usize, released: ExitDrop, kind: ExitKind, origin: Origin) -> usize
! OutOfMemoryError ? &mut Allocator {
  let index = List<ExitStep>.length(&builder.exits)
  let mut forward = usize.MAX
  if kind == ExitKind.Forwards { forward = builder.forward }
  run List<ExitStep>.append(&mut builder.*.exits, ExitStep {next: next, released: released, kind: kind, forward: forward,
    count: usize.ZERO, entries: usize.ZERO, block: usize.MAX, origin: origin, children: List<usize>.make()})
  if next != usize.MAX {
    let mut steps = List<ExitStep>.asMutSlice(&mut builder.*.exits)
    run List<usize>.append(&mut steps[next].children, index)
  }
  return index
}

// The root step that returns, fails or abandons, created once per function and kind, and for a
// forwarding exit once per forward block.
effect fn exitRoot(builder: &mut Builder, kind: ExitKind, origin: Origin) -> usize ! OutOfMemoryError ? &mut Allocator {
  let mut forward = usize.MAX
  if kind == ExitKind.Forwards { forward = builder.forward }
  let steps = List<ExitStep>.asSlice(&builder.exits)
  let mut at = usize.ZERO
  while at < steps.length {
    if steps[at].next == usize.MAX && steps[at].kind == kind && steps[at].forward == forward { return at }
    at = at + usize.ONE
  }
  return run exitStep(&mut builder.*, usize.MAX, ExitDrop {node: usize.MAX, state: usize.MAX, plan: usize.MAX, temporary: usize.MAX}, kind, origin)
}

// The existing step after `parent` that performs `wanted`, or usize.MAX.
fn exitChild(builder: &Builder, parent: usize, wanted: ExitDrop) -> usize {
  let steps = List<ExitStep>.asSlice(&builder.exits)
  let children = List<usize>.asSlice(&steps[parent].children)
  let mut at = usize.ZERO
  while at < children.length {
    if sameExitDrop(steps[children[at]].released, wanted) { return children[at] }
    at = at + usize.ONE
  }
  return usize.MAX
}

// Emits `wanted` into the current block: a temporary through its glue, a node in its one state,
// or an open union as its exit plan elaborates it. Emission continues in the join after it.
effect fn emitExitDrop(builder: &mut Builder, wanted: ExitDrop, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if wanted.temporary != usize.MAX {
    let identity = InstanceKey.identity(&builder.function.key)
    let ty = localType(&builder.*, wanted.temporary)
    return run dropPlace(&mut builder.*, place(wanted.temporary), &ty, &identity, origin)
  }
  if wanted.plan != usize.MAX { return run elaborate(&mut builder.*, wanted.node, wanted.plan, origin) }
  return run dropNodeAs(&mut builder.*, wanted.node, wanted.state, origin)
}

// Leaves the function from the current block, then returns, fails or abandons, dropping exactly what
// `exitTo(builder, 0, 0, ..)` would, in the same order. The drops are only recorded here, as a
// path through the exit trie; `closeExits` emits them once every exit is known.
effect fn leaveFunction(builder: &mut Builder, kind: ExitKind, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  if !builder.live { return () }
  let drops = run exitDrops(&mut builder.*)
  let listed = List<ExitDrop>.asSlice(&drops)
  if listed.length == usize.ZERO {
    let forward = builder.forward
    terminate(&mut builder.*, exitTerminator(kind, forward, origin))
    return ()
  }
  // An owner of an open abstract type is reported at the exit that needs its drop, as inline
  // cleanup would.
  let identity = InstanceKey.identity(&builder.function.key)
  let nodes = List<CleanupNode>.asSlice(&builder.cleanup)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].temporary == usize.MAX {
      if let Option<InstanceKey>.None = &nodes[listed[at].node].glue { return run unsupported(&identity, origin, GapCode.OpenInstance) }
    }
    at = at + usize.ONE
  }
  // The outermost drops run last, so exits share the end of `listed`.
  let mut reached = run exitRoot(&mut builder.*, kind, origin)
  at = listed.length
  while at > usize.ZERO {
    at = at - usize.ONE
    let mut child = exitChild(&builder.*, reached, listed[at])
    if child == usize.MAX { child = run exitStep(&mut builder.*, reached, listed[at], kind, origin) }
    let mut steps = List<ExitStep>.asMutSlice(&mut builder.*.exits)
    steps[child].count = steps[child].count + usize.ONE
    reached = child
  }
  run List<LeftExit>.append(&mut builder.*.left, LeftExit {block: builder.current, step: reached, origin: origin})
  builder.live = false
  return ()
}

// Records the cancel exit of the suspension point that ends the current block: a fresh block that
// drops every owner and pending temporary live here, as an exit from here would, and abandons the
// frame. The point's own terminator is still to be written.
effect fn recordCancel(builder: &mut Builder, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !builder.live || builder.landing { return () }
  let point = builder.current
  let entry = run block(&mut builder.*, origin)
  resume(&mut builder.*, entry)
  if List<InterruptBoundary>.length(&builder.interrupts) > usize.ZERO { run interruptDispatch(&mut builder.*, origin) }
  // Cleanup runs innermost first, before the point's own drops, as in an exit that completes:
  // each enclosing composed Effect's pending cleanup, and each failure held across this point.
  // A held failure is never delivered: once the scopes opened while it waits have run their
  // cleanup, its node is released (N7) and a value it still owns is dropped (SUSP-013).
  let mut held = List<HeldFailure>.length(&builder.held)
  let mut scope = List<CancelScope>.length(&builder.cancelScopes)
  while held > usize.ZERO || scope > usize.ZERO {
    if held > usize.ZERO && List<HeldFailure>.asSlice(&builder.held)[held - usize.ONE].depth >= scope {
      held = held - usize.ONE
      let listed = List<HeldFailure>.asSlice(&builder.held)
      let slot = listed[held].slot
      let dropped = copyOptionalType(&listed[held].cleanup)
      run release(&mut builder.*, slot, origin)
      let value = place(slot)
      run dropUnused(&mut builder.*, &value, &dropped, origin)
    } else {
      scope = scope - usize.ONE
      run enterLanding(&mut builder.*, scope, origin)
    }
  }
  run leaveFunction(&mut builder.*, ExitKind.Abandons, origin)
  resume(&mut builder.*, point)
  return run List<Cancel>.append(&mut builder.*.function.cancels, Cancel {point: point, entry: entry})
}

// Starts a cancel exit inside interruptible boundaries: a package that is not dropped and whose
// interrupt word names an open boundary's token resumes that boundary. Lowering continues in the
// block that cancels the frame, which a dropped package and every other word reach.
effect fn interruptDispatch(builder: &mut Builder, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = run storagePrimitive(b"usize")
  let wordAddress = run SealedCore.address(&word)
  let bytes = run SealedCore.bytes()
  // The header's fields up to the interrupt word are each one word wide, so field `k` is at word `k`.
  let running = run storageValue(&mut builder.*, &bytes, Rvalue.RunningPackage, origin)
  let integer = run storageValue(&mut builder.*, &word, Rvalue.AddressIntegerConversion {operand: Operand.Copy {place: place(running)},
    destinationType: Interned<Type>.clone(&word)}, origin)
  let header = run storageValue(&mut builder.*, &wordAddress, Rvalue.AddressIntegerConversion {
    operand: Operand.Copy {place: place(integer)}, destinationType: Interned<Type>.clone(&wordAddress)}, origin)
  let lifecycleAddress = run storageValue(&mut builder.*, &wordAddress, Rvalue.PointerOffset {pointer: Operand.Copy {place: place(header)},
    index: run wordOperand(SealedCore.ordinal(CoreField.HeaderLifecycle)), element: Interned<Type>.clone(&word)}, origin)
  let lifecycle = run wordAtomic(&mut builder.*, lifecycleAddress, IntrinsicPrimitive.AtomicLoad, List<Operand>.make(),
    MemoryOrder.Acquire, &word, origin)
  let dropped = run storageCondition(&mut builder.*, InfixOperator.Equals, Operand.Copy {place: place(lifecycle)},
    run wordOperand(SealedCore.lifecycleWord(Lifecycle.Destroyed)), origin)
  let cancelling = run block(&mut builder.*, origin)
  let requested = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: move dropped, thenBlock: cancelling, elseBlock: requested, origin: origin})
  resume(&mut builder.*, requested)
  let address = run storageValue(&mut builder.*, &wordAddress, Rvalue.PointerOffset {pointer: Operand.Copy {place: place(header)},
    index: run wordOperand(SealedCore.ordinal(CoreField.HeaderInterrupt)), element: Interned<Type>.clone(&word)}, origin)
  let request = run wordAtomic(&mut builder.*, address, IntrinsicPrimitive.AtomicLoad, List<Operand>.make(), MemoryOrder.Acquire,
    &word, origin)
  // The innermost boundary with the requested token resumes; an outer one would abandon it.
  let mut at = List<InterruptBoundary>.length(&builder.interrupts)
  while at > usize.ZERO {
    at = at - usize.ONE
    let token = List<InterruptBoundary>.asSlice(&builder.interrupts)[at].token
    let matched = run storageCondition(&mut builder.*, InfixOperator.Equals, Operand.Copy {place: place(request)},
      Operand.Copy {place: place(token)}, origin)
    let resuming = run block(&mut builder.*, origin)
    let next = run block(&mut builder.*, origin)
    terminate(&mut builder.*, Terminator.Branch {condition: move matched, thenBlock: resuming, elseBlock: next, origin: origin})
    resume(&mut builder.*, resuming)
    let unit = run Types.intern(Type.Unit)
    let mut cleared = List<Operand>.make()
    run List<Operand>.append(&mut cleared, run wordOperand(usize.ZERO))
    drop run wordAtomic(&mut builder.*, address, IntrinsicPrimitive.AtomicStore, move cleared, MemoryOrder.Release, &unit, origin)
    run resumeBoundary(&mut builder.*, at, origin)
    resume(&mut builder.*, next)
  }
  terminate(&mut builder.*, Terminator.Goto {target: cancelling, origin: origin})
  resume(&mut builder.*, cancelling)
  return ()
}

// Runs the cleanup a cancel exit would for the cancel scopes and held failures opened inside
// boundary `at`, innermost first, then continues at the boundary's continuation.
effect fn resumeBoundary(builder: &mut Builder, at: usize, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let floorScopes = List<InterruptBoundary>.asSlice(&builder.interrupts)[at].scopes
  let floorHeld = List<InterruptBoundary>.asSlice(&builder.interrupts)[at].held
  let mut held = List<HeldFailure>.length(&builder.held)
  let mut scope = List<CancelScope>.length(&builder.cancelScopes)
  while held > floorHeld || scope > floorScopes {
    if held > floorHeld && List<HeldFailure>.asSlice(&builder.held)[held - usize.ONE].depth >= scope {
      held = held - usize.ONE
      let listed = List<HeldFailure>.asSlice(&builder.held)
      let slot = listed[held].slot
      let dropped = copyOptionalType(&listed[held].cleanup)
      run release(&mut builder.*, slot, origin)
      let value = place(slot)
      run dropUnused(&mut builder.*, &value, &dropped, origin)
    } else {
      scope = scope - usize.ONE
      run enterLanding(&mut builder.*, scope, origin)
    }
  }
  if List<InterruptBoundary>.asSlice(&builder.interrupts)[at].continuation == usize.MAX {
    let continuation = run block(&mut builder.*, origin)
    let mut boundaries = List<InterruptBoundary>.asMutSlice(&mut builder.*.interrupts)
    boundaries[at].continuation = continuation
  }
  let target = List<InterruptBoundary>.asSlice(&builder.interrupts)[at].continuation
  terminate(&mut builder.*, Terminator.Goto {target: target, origin: origin})
  return ()
}

// Continues a cancel exit through scope `at`'s landing, resuming where its dispatch returns.
effect fn enterLanding(builder: &mut Builder, at: usize, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if List<CancelScope>.asSlice(&builder.cancelScopes)[at].entry == usize.MAX {
    let selector = run temporary(&mut builder.*, &run usizeType(), origin)
    let entry = run block(&mut builder.*, origin)
    let mut scopes = List<CancelScope>.asMutSlice(&mut builder.*.cancelScopes)
    scopes[at].selector = selector
    scopes[at].entry = entry
  }
  let selector = List<CancelScope>.asSlice(&builder.cancelScopes)[at].selector
  let entry = List<CancelScope>.asSlice(&builder.cancelScopes)[at].entry
  let selectedScopes = List<CancelScope>.asSlice(&builder.cancelScopes)
  let index = List<usize>.length(&selectedScopes[at].continuations)
  run assign(&mut builder.*, place(selector), Rvalue.Use {value: run usizeOperand(usize.toU64(index))}, origin)
  terminate(&mut builder.*, Terminator.Goto {target: entry, origin: origin})
  let continuation = run block(&mut builder.*, origin)
  let mut scopes = List<CancelScope>.asMutSlice(&mut builder.*.cancelScopes)
  run List<usize>.append(&mut scopes[at].continuations, continuation)
  resume(&mut builder.*, continuation)
  return ()
}

// Opens the cancel scope of a composed Effect whose protected part is about to run.
effect fn openCancelScope(builder: &mut Builder) -> () ! OutOfMemoryError ? &mut Allocator {
  return run List<CancelScope>.append(&mut builder.*.cancelScopes,
    CancelScope {selector: usize.MAX, entry: usize.MAX, continuations: List<usize>.make()})
}

// Closes the innermost cancel scope once its protected part is lowered. When a cancel exit
// entered it, lowering resumes in its landing for the caller to lower the pending cleanup into,
// then `closeLanding` dispatches; the returned state restores ordinary lowering.
fn closeCancelScope(builder: &mut Builder) -> Option<Landing> {
  let scope = match move List<CancelScope>.pop(&mut builder.*.cancelScopes) {
    Option<CancelScope>.Some {value} => move value
    Option<CancelScope>.None => { return Option<Landing>.none() }
  }
  if scope.entry == usize.MAX { return Option<Landing>.none() }
  let landing = Landing {scope: move scope, current: builder.current, live: builder.live, nested: builder.landing}
  resume(&mut builder.*, landing.scope.entry)
  builder.landing = true
  return Option<Landing>.some(move landing)
}

// Ends a landing: dispatches to the continuation of the cancel exit that entered it.
effect fn closeLanding(builder: &mut Builder, landing: Landing, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  let continuations = List<usize>.asSlice(&landing.scope.continuations)
  let mut cases = run List<SwitchCase>.makeWithCapacity(continuations.length)
  let mut at = usize.ZERO
  while at < continuations.length {
    run List<SwitchCase>.append(&mut cases, SwitchCase {decimal: run Type.extentText(at), negative: false,
      target: continuations[at]})
    at = at + usize.ONE
  }
  let unreachable = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Switch {value: Operand.Copy {place: place(landing.scope.selector)}, cases: move cases,
    otherwise: unreachable, origin: origin})
  resume(&mut builder.*, unreachable)
  terminate(&mut builder.*, Terminator.Unreachable {origin: origin})
  builder.landing = landing.nested
  builder.current = landing.current
  builder.live = landing.live
  return ()
}

// The ordinary lowering state a cancel landing interrupts.
struct Landing {
  scope: CancelScope,
  current: usize,
  live: bool,
  nested: bool,
}

// A call to a suspendable callee is a suspension point of the frame variant.
effect fn noteCancel(builder: &mut Builder, callee: &Callee, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut suspends = false
  if let Callee.Instance {..} = &callee.* { suspends = builder.cancelEveryCall }
  if let Option<List<InstanceKey>>.Some {value: callees} = &builder.suspending {
    if let Callee.Instance {key} = &callee.* {
      let listed = List<InstanceKey>.asSlice(&callees)
      let mut at = usize.ZERO
      while at < listed.length && !suspends {
        suspends = run InstanceKey.sameApplication(&listed[at], &key)
        at = at + usize.ONE
      }
    }
  }
  if suspends { run recordCancel(&mut builder.*, origin) }
  return ()
}

// The block of shared step `step`, allocated on first use and queued for `closeExits` to fill.
effect fn exitBlock(builder: &mut Builder, step: usize, queue: &mut List<usize>) -> usize
! OutOfMemoryError ? &mut Allocator {
  let steps = List<ExitStep>.asSlice(&builder.exits)
  if steps[step].block != usize.MAX { return steps[step].block }
  let origin = steps[step].origin
  let index = run block(&mut builder.*, origin)
  let mut filled = List<ExitStep>.asMutSlice(&mut builder.*.exits)
  filled[step].block = index
  run List<usize>.append(&mut queue.*, step)
  return index
}

// Emits the drops along the trie from `start` into the current block. A drop only one exit
// performs stays inline in that exit, and a shared step entered from a single path is inlined into
// that path; the walk stops at a shared step entered from elsewhere and continues into its block,
// or returns, fails or abandons at the root. `owned` says the current block is `start`'s own shared block.
// Every trie step is emitted once, so cleanup grows with the distinct live sets of the function's
// exits rather than with live set times exit count.
effect fn walkExit(builder: &mut Builder, start: usize, owned: bool, queue: &mut List<usize>, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut step = start
  let mut inline = owned
  while true {
    let steps = List<ExitStep>.asSlice(&builder.exits)
    let next = steps[step].next
    let kind = steps[step].kind
    let shared = steps[step].count > usize.ONE
    let released = steps[step].released
    let forward = steps[step].forward
    if next == usize.MAX {
      terminate(&mut builder.*, exitTerminator(kind, forward, origin))
      return ()
    }
    if !inline && shared {
      let target = run exitBlock(&mut builder.*, step, &mut queue.*)
      terminate(&mut builder.*, Terminator.Goto {target: target, origin: origin})
      return ()
    }
    run emitExitDrop(&mut builder.*, released, origin)
    step = next
    let following = List<ExitStep>.asSlice(&builder.exits)
    inline = following[step].count == usize.ONE || following[step].entries == usize.ONE
  }
  return ()
}

// Completes every exit recorded by `leaveFunction`, then fills the shared steps they reach.
effect fn closeExits(builder: &mut Builder) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let left = List<LeftExit>.length(&builder.left)
  if left == usize.ZERO { return () }
  // A shared step is entered by each exit whose own drops end there and by each shared child.
  let mut at = usize.ZERO
  while at < left {
    let exit = List<LeftExit>.asSlice(&builder.left)[at]
    let mut steps = List<ExitStep>.asMutSlice(&mut builder.*.exits)
    let mut step = exit.step
    while steps[step].next != usize.MAX && steps[step].count == usize.ONE { step = steps[step].next }
    steps[step].entries = steps[step].entries + usize.ONE
    at = at + usize.ONE
  }
  let total = List<ExitStep>.length(&builder.exits)
  at = usize.ZERO
  while at < total {
    let mut steps = List<ExitStep>.asMutSlice(&mut builder.*.exits)
    let next = steps[at].next
    if next != usize.MAX && steps[at].count > usize.ONE { steps[next].entries = steps[next].entries + usize.ONE }
    at = at + usize.ONE
  }
  let mut queue = List<usize>.make()
  at = usize.ZERO
  while at < left {
    let exit = List<LeftExit>.asSlice(&builder.left)[at]
    resume(&mut builder.*, exit.block)
    run walkExit(&mut builder.*, exit.step, false, &mut queue, exit.origin)
    at = at + usize.ONE
  }
  let mut filled = usize.ZERO
  while filled < List<usize>.length(&queue) {
    let step = List<usize>.asSlice(&queue)[filled]
    let steps = List<ExitStep>.asSlice(&builder.exits)
    let target = steps[step].block
    let origin = steps[step].origin
    resume(&mut builder.*, target)
    run walkExit(&mut builder.*, step, true, &mut queue, origin)
    filled = filled + usize.ONE
  }
  return ()
}

effect fn openScope(builder: &mut Builder) -> () ! OutOfMemoryError ? &mut Allocator {
  return run List<usize>.append(&mut builder.*.scopes, List<Owner>.length(&builder.owners))
}

// Fallthrough out of a scope drops its owners; an exit already dropped them on its own path.
effect fn closeScope(builder: &mut Builder, origin: Origin) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let start = match move List<usize>.pop(&mut builder.*.scopes) {
    Option<usize>.Some {value} => value
    Option<usize>.None => usize.ZERO
  }
  if builder.live { run dropOwnersFrom(&mut builder.*, start, origin) }
  return truncateOwners(&mut builder.*, start)
}

// Whether an expression produces a fresh owned value rather than reading an existing place.
// The pointer argument of `Intrinsic.pointerTake(pointer)` when `id` is that call.
fn takenPointer(body: &Shared<TypedBody>, id: BodyNodeId) -> Option<BodyNodeId> {
  let taken = Shared<TypedBody>.with<bool>(body, fn(value: &TypedBody) -> bool {
    if let BodyNodeKind.Expression {form: BodyExpression.IntrinsicCall {member, ..}, ..} = &TypedBody.nodeSlice(value)[id.index].kind {
      return match member {
        IntrinsicMember.Primitive {primitive} => primitive == IntrinsicPrimitive.PointerTake
        _ => false
      }
    }
    return false
  })
  if !taken { return Option<BodyNodeId>.none() }
  return childAt(body, id, usize.ZERO)
}

fn ownedRvalue(body: &Shared<TypedBody>, id: BodyNodeId) -> bool {
  return Shared<TypedBody>.with<bool>(body, fn(value: &TypedBody) -> bool {
    if let BodyNodeKind.Expression {form, ..} = &TypedBody.nodeSlice(value)[id.index].kind {
      return match &form {
        BodyExpression.DirectCall {..} => true
        BodyExpression.CallableCall {..} => true
        BodyExpression.Callable {..} => true
        BodyExpression.StagedCallable {..} => true
        BodyExpression.InterfaceCall {..} => true
        BodyExpression.ForeignCall {..} => true
        BodyExpression.IntrinsicCall {..} => true
        BodyExpression.StorageCall {..} => true
        BodyExpression.Run {..} => true
        BodyExpression.Aggregate {..} => true
        BodyExpression.ArrayRepeat {..} => true
        BodyExpression.VariantConstruct {..} => true
        BodyExpression.UnionInject {..} => true
        BodyExpression.UnionWiden {..} => true
        BodyExpression.Move {..} => true
        BodyExpression.Match {..} => true
        _ => false
      }
    }
    return false
  })
}

// An owned projection step of one binding path, read under a short body borrow.
// The spread member a binding path ends at, when the instance stores that member as a strict
// union part of the storage; absent for every place-projectable binding.
effect fn spreadBinding(builder: &Builder, body: &Shared<TypedBody>, node: BodyNodeId) -> Option<SpreadBinding>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut count = usize.ZERO
  while true {
    if let Option<BodyPlaceStep>.None = move bindingStepAt(body, node, count) { break }
    count = count + usize.ONE
  }
  if count == usize.ZERO { return Option<SpreadBinding>.none() }
  let last = match move bindingStepAt(body, node, count - usize.ONE) {
    Option<BodyPlaceStep>.Some {value} => move value
    Option<BodyPlaceStep>.None => { return Option<SpreadBinding>.none() }
  }
  let mut ordinal = usize.ZERO
  let mut source = run Types.intern(Type.Unit)
  let mut member = run Types.intern(Type.Unit)
  match move last {
    BodyPlaceStep.Member {tag, ty: written, source: parent} => {
      ordinal = tag
      member = move written
      source = move parent
    }
    _ => { return Option<SpreadBinding>.none() }
  }
  let mut tags = List<usize>.make()
  let mut ty = run Types.intern(Type.Unit)
  match move run instancePlacement(builder, &source, &member) {
    UnionPlacement.Spread {tags: spread, ty: narrower} => {
      tags = move spread
      ty = move narrower
    }
    _ => { return Option<SpreadBinding>.none() }
  }
  let mut prefix = List<Projection>.make()
  let mut at = usize.ZERO
  while at + usize.ONE < count {
    if let Option<BodyPlaceStep>.Some {value: step} = move bindingStepAt(body, node, at) {
      run lowerStep(builder, &step, &mut prefix)
    }
    at = at + usize.ONE
  }
  let storage = run RuntimeType.applyBindings(&source, List<Binding>.asSlice(&builder.bindings),
    List<RuntimeProjection>.asSlice(&builder.projections))
  return Option<SpreadBinding>.some(SpreadBinding {prefix: move prefix, ordinal: ordinal, tags: move tags, ty: move ty,
    storage: move storage})
}

// The local a spread binding of `subject` was narrowed into by its arm, or `usize.MAX`.
effect fn narrowedLocal(builder: &Builder, body: &Shared<TypedBody>, node: BodyNodeId, subject: BodyNodeId) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let spread = match move run spreadBinding(builder, body, node) {
    Option<SpreadBinding>.Some {value} => move value
    Option<SpreadBinding>.None => { return usize.MAX }
  }
  let wanted = List<Projection>.asSlice(&spread.prefix)
  let listed = List<Narrowed>.asSlice(&builder.narrowed)
  let mut at = listed.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if listed[at].subject == subject.index && listed[at].ordinal == spread.ordinal
      && sameProjections(List<Projection>.asSlice(&listed[at].prefix), wanted) { return listed[at].local }
  }
  return CompilerBug.panic(b"a spread union binding was read before its arm narrowed it")
}

fn takenOperand(selected: Place, moves: bool) -> Operand {
  if moves { return Operand.Move {place: move selected} }
  return Operand.Copy {place: move selected}
}

fn sameProjections(left: &[Projection], right: &[Projection]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if !sameProjection(&left[at], &right[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

// Builds each spread binding of the selected arm `arm` as its own union value: the active payload,
// under one of the member's storage tags, is injected under that part's tag in the member's own
// union (UNION-001). A consuming match moves the payload; any other match copies it.
effect fn narrowBindings(builder: &mut Builder, body: &Shared<TypedBody>, node: BodyNodeId, arm: usize,
  subject: BodyNodeId, consumes: bool, origin: Origin) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let selected = match move scrutineePlace(&builder.*, subject) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return run unsupported(&owner, origin, GapCode.ExpectedPlace) }
  }
  let mut binding = usize.ZERO
  while true {
    let declared = match move TypedBody.armBinding(body, node, arm, binding) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { break }
    }
    binding = binding + usize.ONE
    let spread = match move run spreadBinding(&builder.*, body, declared) {
      Option<SpreadBinding>.Some {value} => move value
      Option<SpreadBinding>.None => { continue }
    }
    let evaluated = List<Scrutinee>.asSlice(&builder.scrutinees)
    let mut wider = run copyPlace(&evaluated[selected].place)
    let prefix = List<Projection>.asSlice(&spread.prefix)
    let mut at = usize.ZERO
    while at < prefix.length {
      run List<Projection>.append(&mut wider.projections, run copyProjection(&prefix[at]))
      at = at + usize.ONE
    }
    let output = run temporary(&mut builder.*, &spread.ty, origin)
    run narrowInto(&mut builder.*, &wider, &spread.storage, List<usize>.asSlice(&spread.tags), &spread.ty, output, consumes, origin)
    run List<Narrowed>.append(&mut builder.*.narrowed, Narrowed {subject: subject.index, prefix: move spread.prefix,
      ordinal: spread.ordinal, local: output})
  }
  return ()
}

// Stores the active member of `wider`, one of the member union `narrower`'s parts kept under
// `tags`, into `destination` under that part's own tag. The inverse of `widenInto`.
effect fn narrowInto(builder: &mut Builder, wider: &Place, storage: &Interned<Type>, tags: &[usize], narrower: &Interned<Type>,
  destination: usize, moves: bool, origin: Origin) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let parts = match move run Type.canonicalUnionMembers(narrower) {
    Option<List<Interned<Type>>>.Some {value} => move value
    Option<List<Interned<Type>>>.None => CompilerBug.panic(b"a spread union member is not a union")
  }
  let stored = match move run Type.canonicalUnionMembers(storage) {
    Option<List<Interned<Type>>>.Some {value} => List<Interned<Type>>.length(&value)
    Option<List<Interned<Type>>>.None => CompilerBug.panic(b"a spread union member's storage is not a union")
  }
  let listed = List<Interned<Type>>.asSlice(&parts)
  let tagType = run Layout.tagType(stored)
  let read = run temporary(&mut builder.*, &tagType, origin)
  run assign(&mut builder.*, place(read), Rvalue.Discriminant {place: run copyPlace(wider)}, origin)
  let joined = run block(&mut builder.*, origin)
  let mut cases = List<SwitchCase>.make()
  let mut targets = List<usize>.make()
  let mut at = usize.ZERO
  while at < tags.length {
    let arm = run block(&mut builder.*, origin)
    run List<usize>.append(&mut targets, arm)
    run List<SwitchCase>.append(&mut cases, SwitchCase {decimal: run Type.extentText(tags[at]), negative: false, target: arm})
    at = at + usize.ONE
  }
  let unreachable = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Switch {value: Operand.Copy {place: place(read)}, cases: move cases,
    otherwise: unreachable, origin: origin})
  resume(&mut builder.*, unreachable)
  terminate(&mut builder.*, Terminator.Unreachable {origin: origin})
  at = usize.ZERO
  while at < tags.length {
    resume(&mut builder.*, List<usize>.asSlice(&targets)[at])
    let mut payload = run copyPlace(wider)
    run List<Projection>.append(&mut payload.projections, Projection.Payload {index: tags[at], ty: Interned<Type>.clone(&listed[at])})
    let value = takenOperand(move payload, moves)
    run assign(&mut builder.*, place(destination), Rvalue.Inject {tag: at, value: move value}, origin)
    terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
    at = at + usize.ONE
  }
  resume(&mut builder.*, joined)
  return ()
}

fn bindingStepAt(body: &Shared<TypedBody>, node: BodyNodeId, at: usize) -> Option<BodyPlaceStep> {
  return Shared<TypedBody>.with<Option<BodyPlaceStep>>(body, fn(value: &TypedBody) -> Option<BodyPlaceStep> {
    let nodes = TypedBody.nodeSlice(value)
    if let BodyNodeKind.Expression {form: BodyExpression.PatternBinding {path, ..}, ..} = &nodes[node.index].kind {
      return copyStep(&path, at)
    }
    return Option<BodyPlaceStep>.none()
  })
}

effect fn expressionPlace(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  id: BodyNodeId,
) -> Place ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  return run placeOf(&mut builder.*, body, hir, id, false)
}

// The place a shared borrow views: a constant, or a part of one, is its program-lifetime storage
// instead of a temporary copy, so the reference outlives the borrowing statement (BORROW-006).
effect fn sharedPlace(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  id: BodyNodeId,
) -> Place ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  return run placeOf(&mut builder.*, body, hir, id, true)
}

effect fn placeOf(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  id: BodyNodeId,
  shared: bool,
) -> Place ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = run instanceView(&mut builder.*, body, id)
  let owner = InstanceKey.identity(&builder.function.key)
  if shared {
    if let View.Embedded {value, ty, origin} = &selected {
      let referenceType = run Types.intern(Type.Reference {referent: Interned<Type>.clone(&ty), access: Access.Shared,
        lifetime: run Types.internLifetime(Lifetime.Static)})
      let address = run temporary(&mut builder.*, &referenceType, origin)
      run assign(&mut builder.*, place(address), Rvalue.Use {value: Operand.StaticValue {
        value: Interned<StaticData>.clone(&value), ty: Interned<Type>.clone(&ty),
      }}, origin)
      let mut projected = place(address)
      run List<Projection>.append(&mut projected.projections, Projection.Deref)
      return move projected
    }
  }
  return match move selected {
    View.Local {index, ..} => place(index + usize.ONE)
    View.Field {value, index, ..} => {
      let mut projected = run placeOf(&mut builder.*, body, hir, value, shared)
      run List<Projection>.append(&mut projected.projections, Projection.Field {index: index})
      return move projected
    }
    View.Index {value, index, element, origin, ..} => {
      // Bounds precede the projected access and a PlaceAssignment's replacement expression.
      let mut projected = run placeOf(&mut builder.*, body, hir, value, shared)
      let subjectType = match move run instanceNodeType(&builder.*, body, value) {
        Option<Interned<Type>>.Some {value: selectedType} => move selectedType
        Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
      }
      let mut knownLength = Option<usize>.none()
      if let Option<ArrayShape>.Some {value: facts} = move Type.arrayShape(&subjectType) {
        // The static element typing recorded for a literal in-bounds index is the component a
        // consuming site moves, so cleanup tracks a store to it as that component.
        if element != usize.MAX {
          run List<Projection>.append(&mut projected.projections, Projection.ConstIndex {index: element})
          return move projected
        }
        knownLength = Option<usize>.some(facts.length)
      } else {
        if let Option<Interned<Type>>.None = move Type.sliceElement(&subjectType) {
          return run unsupported(&owner, origin, GapCode.IndexProjection)
        }
        // A descriptor is captured before evaluating the index, which may call user code.
        let snapshot = run temporary(&mut builder.*, &subjectType, origin)
        run assign(&mut builder.*, place(snapshot), Rvalue.Use {value: Operand.Copy {place: move projected}}, origin)
        projected = place(snapshot)
      }
      let indexType = match move run instanceNodeType(&builder.*, body, index) {
        Option<Interned<Type>>.Some {value: selectedType} => move selectedType
        Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
      }
      let input = run expression(&mut builder.*, body, hir, index)
      let captured = run temporary(&mut builder.*, &indexType, origin)
      run assign(&mut builder.*, place(captured), Rvalue.Use {value: move input}, origin)
      let mut bound = Operand.Unit
      if let Option<usize>.Some {value: count} = move knownLength {
        bound = Operand.Integer {decimal: run Type.extentText(count), negative: false, ty: Interned<Type>.clone(&indexType)}
      } else {
        let lengthSlot = run temporary(&mut builder.*, &indexType, origin)
        let lengthPlace = run copyPlace(&projected)
        run assign(&mut builder.*, place(lengthSlot), Rvalue.SliceLength {place: move lengthPlace}, origin)
        bound = Operand.Copy {place: place(lengthSlot)}
      }
      let boolean = run Types.intern(Type.Primitive {name: run Bytes.copy(b"bool")})
      let condition = run temporary(&mut builder.*, &boolean, origin)
      run assign(&mut builder.*, place(condition), Rvalue.Binary {
        operation: InfixOperator.LessThan,
        left: Operand.Copy {place: place(captured)},
        right: move bound,
      }, origin)
      let safe = run block(&mut builder.*, origin)
      let trap = run block(&mut builder.*, origin)
      terminate(&mut builder.*, Terminator.Branch {
        condition: Operand.Copy {place: place(condition)}, thenBlock: safe, elseBlock: trap, origin: origin,
      })
      resume(&mut builder.*, trap)
      run trapHere(&mut builder.*, TrapReason.IndexOutOfBounds, origin)
      resume(&mut builder.*, safe)
      run List<Projection>.append(&mut projected.projections, Projection.Index {local: captured})
      return move projected
    }
    View.PatternBinding {node, subject, origin, ..} => {
      let selected = match move scrutineePlace(&builder.*, subject) {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return run unsupported(&owner, origin, GapCode.ExpectedPlace) }
      }
      let narrowed = run narrowedLocal(&builder.*, body, node, subject)
      if narrowed != usize.MAX { return place(narrowed) }
      let evaluated = List<Scrutinee>.asSlice(&builder.scrutinees)
      let mut projected = run copyPlace(&evaluated[selected].place)
      let mut at = usize.ZERO
      while true {
        let step = match move bindingStepAt(body, node, at) {
          Option<BodyPlaceStep>.Some {value} => move value
          Option<BodyPlaceStep>.None => { break }
        }
        run lowerStep(&builder.*, &step, &mut projected.projections)
        at = at + usize.ONE
      }
      return move projected
    }
    View.Dereference {value, origin, ..} => {
      let input = run expression(&mut builder.*, body, hir, value)
      let mut projected = match move input {
        Operand.Copy {place: selectedPlace} => move selectedPlace
        Operand.Move {place: selectedPlace} => move selectedPlace
        _ => run unsupported(&owner, origin, GapCode.ExpectedPlace)
      }
      run List<Projection>.append(&mut projected.projections, Projection.Deref)
      return move projected
    }
    _ => {
      let mut input = run expression(&mut builder.*, body, hir, id)
      let addressed = match &input {
        Operand.Copy {..} => true
        Operand.Move {..} => true
        _ => false
      }
      // An immediate operand (a literal or scalar result) is stored in its own temporary, which a
      // loan then addresses (BORROW-006).
      if !addressed && builder.live {
        let origin = nodeOrigin(body, id)
        let selectedType = match move run instanceNodeType(&builder.*, body, id) {
          Option<Interned<Type>>.Some {value} => move value
          Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
        }
        let stored = run temporary(&mut builder.*, &selectedType, origin)
        run assign(&mut builder.*, place(stored), Rvalue.Use {value: move input}, origin)
        input = Operand.Copy {place: place(stored)}
      }
      let storage = match move input {
        Operand.Copy {place: stored} => move stored
        Operand.Move {place: stored} => move stored
        _ => run unsupported(&owner, nodeOrigin(body, id), GapCode.ExpectedPlace)
      }
      // An owned rvalue used as a place is a temporary of the enclosing full expression.
      if ownedRvalue(body, id) && List<Projection>.length(&storage.projections) == usize.ZERO && CleanupNeeds.node(&builder.needs, id.index) {
        run pend(&mut builder.*, storage.local)
      }
      return move storage
    }
  }
}

fn nativePointerSignature(value: &Type) -> Option<Interned<Type>> {
  return match &value.* {
    Type.ForeignFunction {signature, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&signature))
    _ => Option<Interned<Type>>.none()
  }
}

effect fn nativeIndirectCall(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module,
  callNode: BodyNodeId, callee: BodyNodeId, count: usize, result: &Interned<Type>, signature: Interned<Type>, origin: Origin) -> Operand
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let address = run expression(&mut builder.*, body, hir, callee)
  if !builder.live { return Operand.Unit }
  let mut arguments = List<Operand>.make()
  let mut at = usize.ONE
  while at < count {
    let child = match move childAt(body, callNode, at) {
      Option<BodyNodeId>.Some {value} => value
      _ => { return run unsupported(&owner, origin, GapCode.MissingCallArgument) }
    }
    let argument = run expression(&mut builder.*, body, hir, child)
    if !builder.live { return Operand.Unit }
    run List<Operand>.append(&mut arguments, move argument)
    at = at + usize.ONE
  }
  let output = run temporary(&mut builder.*, result, origin)
  let continuation = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Call {callee: Callee.NativeIndirect {address: move address, signature: move signature},
    arguments: move arguments, providers: List<Operand>.make(), diagnostics: Option<Diagnostics>.none(),
    destination: place(output), normal: continuation, failure: Option<FailureEdge>.none(), origin: origin})
  resume(&mut builder.*, continuation)
  return Operand.Copy {place: place(output)}
}

effect fn callCallee(builder: &mut Builder, foreign: Option<Interned<DeclarationId>>, variadicArguments: Option<Shared<List<CAbi.VariadicArgument>>>, node: BodyNodeId,
  owner: &Interned<DeclarationId>, origin: Origin) -> Callee
! Gap | CanonicalizationFailure | OutOfMemoryError
? &mut Allocator {
  if let Option<Interned<DeclarationId>>.Some {value: callee} = move foreign {
    run List<Interned<DeclarationId>>.append(&mut builder.*.function.externs, Interned<DeclarationId>.clone(&callee))
    let tails = match move variadicArguments {
      Option<Shared<List<CAbi.VariadicArgument>>>.Some {value: supplied} => run CAbi.copySharedVariadic(&supplied)
      Option<Shared<List<CAbi.VariadicArgument>>>.None => { return CompilerBug.panic(b"a C call reached MIR without the variadic tails its check classified") }
    }
    return Callee.Extern {declaration: move callee, variadicArguments: move tails}
  }
  let selected = resolvedCallTarget(&builder.*, node)
  let call = match move selected {
    Option<ResolvedCall>.Some {value} => move value
    _ => { return run unsupported(owner, origin, GapCode.TypedForm) }
  }
  run List<Reference>.append(&mut builder.*.function.references,
    Reference {key: InstanceKey.copy(&call.key), edge: move call.edge, origin: origin})
  if call.nonParking { run oweNonParking(&mut builder.*, &call.key, origin) }
  return Callee.Instance {key: move call.key}
}

// The decimal spelling of one magnitude, as integer literal operands carry it.
effect fn decimalBytes(magnitude: u64) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut reversed = List<u8>.make()
  let mut remaining = magnitude
  while true {
    run List<u8>.append(&mut reversed, u64.toU8(48 + u64.remainder(remaining, 10)))
    remaining = u64.divide(remaining, 10)
    if remaining == 0 { break }
  }
  let mut digits = List<u8>.make()
  let mut index = List<u8>.length(&reversed)
  while index > usize.ZERO {
    index = index - usize.ONE
    run List<u8>.append(&mut digits, List<u8>.get(&reversed, index))
  }
  return run Bytes.copy(List<u8>.asSlice(&digits))
}

// A selected static scalar used at runtime. A character is its Unicode scalar value at its own
// type; an f32 widens exactly to the f64 bit pattern that float operands carry.
effect fn embeddedOperand(value: &Interned<StaticData>, ty: Interned<Type>) -> Option<Operand> ! OutOfMemoryError ? &mut Allocator {
  let kind = Interned<StaticData>.with<usize>(value, fn(data: &StaticData) -> usize {
    return match & data.* {
      StaticData.Unit => 1
      StaticData.Boolean {..} => 2
      StaticData.Integer {..} => 3
      StaticData.Float {..} => 4
      StaticData.Character {..} => 5
      _ => 0
    }
  })
  if kind == 1 { return Option<Operand>.some(Operand.Unit) }
  if kind == 2 {
    let flag = Interned<StaticData>.with<bool>(value, fn(data: &StaticData) -> bool {
      return match & data.* { StaticData.Boolean {value: answer} => answer _ => false }
    })
    return Option<Operand>.some(Operand.Boolean {value: flag})
  }
  if kind == 3 {
    let magnitude = Interned<StaticData>.with<u64>(value, fn(data: &StaticData) -> u64 {
      return match & data.* { StaticData.Integer {magnitude: amount, ..} => amount _ => 0 }
    })
    let negative = Interned<StaticData>.with<bool>(value, fn(data: &StaticData) -> bool {
      return match & data.* { StaticData.Integer {sign, ..} => sign == StaticSign.Negative _ => false }
    })
    return Option<Operand>.some(Operand.Integer {decimal: run decimalBytes(magnitude), negative: negative, ty: move ty})
  }
  if kind == 4 {
    let bits = Interned<StaticData>.with<u64>(value, fn(data: &StaticData) -> u64 {
      return match & data.* { StaticData.Float {bits: raw, ..} => raw _ => 0 }
    })
    let narrow = Interned<StaticData>.with<bool>(value, fn(data: &StaticData) -> bool {
      return match & data.* { StaticData.Float {ty: width, ..} => width == StaticFloatType.F32 _ => false }
    })
    if narrow {
      return Option<Operand>.some(Operand.Float {bits: f64.toBits(f32.toF64(f32.fromBits(u64.toU32(bits)))), ty: move ty})
    }
    return Option<Operand>.some(Operand.Float {bits: bits, ty: move ty})
  }
  if kind == 5 {
    let scalar = Interned<StaticData>.with<u32>(value, fn(data: &StaticData) -> u32 {
      return match & data.* { StaticData.Character {scalar: code} => code _ => 0 }
    })
    return Option<Operand>.some(Operand.Integer {decimal: run decimalBytes(u32.toU64(scalar)), negative: false, ty: move ty})
  }
  return Option<Operand>.none()
}

// Materializes one embedded static value at its use: a scalar as a constant, text as a descriptor
// over its immutable program-lifetime bytes, a scalar enum as its representation integer typed by
// the enum, and a fixed array or cleanup-free struct field by field into a fresh aggregate.
// Anything else is None, an explicit gap.
effect fn materializeEmbedded(builder: &mut Builder, value: &Interned<StaticData>, ty: &Interned<Type>, origin: Origin) -> Option<Operand>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  // A static view is the address of the program-lifetime storage holding its referent: a
  // reference is that address, a slice that address with the viewed array's length.
  let viewed = Interned<StaticData>.with<Option<Interned<StaticData>>>(value, StaticValue.borrowTarget)
  if let Option<Interned<StaticData>>.Some {value: target} = move viewed {
    if let Option<Interned<Type>>.Some {..} = move Type.sliceElement(ty) {
      let arrayType = match move Interned<StaticData>.with<Option<Interned<Type>>>(&target, StaticValue.carriedType) {
        Option<Interned<Type>>.Some {value: selected} => move selected
        Option<Interned<Type>>.None => { return Option<Operand>.none() }
      }
      let count = match move Interned<StaticData>.with<Option<usize>>(&target, StaticValue.arrayElements) {
        Option<usize>.Some {value: total} => total
        Option<usize>.None => { return Option<Operand>.none() }
      }
      let output = run temporary(&mut builder.*, ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Slice {data: Operand.StaticValue {value: move target, ty: move arrayType},
        count: run usizeOperand(usize.toU64(count))}, origin)
      return Option<Operand>.some(Operand.Copy {place: place(output)})
    }
    let referent = Interned<Type>.with<Option<Interned<Type>>>(ty, fn(view: &Type) -> Option<Interned<Type>> {
      return match &view.* {
        Type.Reference {referent, access: Access.Shared, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&referent))
        _ => Option<Interned<Type>>.none()
      }
    })
    if let Option<Interned<Type>>.Some {value: referentType} = move referent {
      let output = run temporary(&mut builder.*, ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Use {value: Operand.StaticValue {value: move target, ty: move referentType}}, origin)
      return Option<Operand>.some(Operand.Copy {place: place(output)})
    }
    return Option<Operand>.none()
  }
  // A value stored in a structural union field is built as its member, then injected under the
  // member's tag.
  match move run staticPlacement(value, ty) {
    StaticPlacement.Plain => {}
    StaticPlacement.Member {tag, ty: stored} => {
      let inner = match move run materializeEmbedded(&mut builder.*, value, &stored, origin) {
        Option<Operand>.Some {value: built} => move built
        Option<Operand>.None => { return Option<Operand>.none() }
      }
      let output = run temporary(&mut builder.*, ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Inject {tag: tag, value: move inner}, origin)
      return Option<Operand>.some(Operand.Move {place: place(output)})
    }
    StaticPlacement.Unplaced => { return Option<Operand>.none() }
  }
  let scalar = run embeddedOperand(value, Interned<Type>.clone(ty))
  if let Option<Operand>.Some {value: operand} = move scalar { return Option<Operand>.some(move operand) }
  let mut text = run StaticValue.textBytes(value)
  if let Option<Bytes>.None = &text { text = run StaticValue.embeddedBytes(value) }
  if let Option<Bytes>.Some {value: bytes} = move text {
    let count = Bytes.length(&bytes)
    let output = run temporary(&mut builder.*, ty, origin)
    run assign(&mut builder.*, place(output), Rvalue.Slice {data: Operand.StaticBytes {bytes: move bytes}, count: run usizeOperand(usize.toU64(count))}, origin)
    return Option<Operand>.some(Operand.Copy {place: place(output)})
  }
  let isEnum = Interned<StaticData>.with<bool>(value, fn(data: &StaticData) -> bool {
    return match & data.* { StaticData.Enum {..} => true _ => false }
  })
  if isEnum {
    let magnitude = Interned<StaticData>.with<u64>(value, fn(data: &StaticData) -> u64 {
      return match & data.* { StaticData.Enum {magnitude: amount, ..} => amount _ => 0 }
    })
    let negative = Interned<StaticData>.with<bool>(value, fn(data: &StaticData) -> bool {
      return match & data.* { StaticData.Enum {sign, ..} => sign == StaticSign.Negative _ => false }
    })
    return Option<Operand>.some(Operand.Integer {decimal: run magnitudeText(magnitude), negative: negative, ty: Interned<Type>.clone(ty)})
  }
  // A union variant is built from its fields under its declaration-order tag, each field typed
  // by its own value as a struct field is.
  if let Option<usize>.Some {value: tag} = move Interned<StaticData>.with<Option<usize>>(value, StaticValue.variantTag) {
    let total = Interned<StaticData>.with<usize>(value, fn(data: &StaticData) -> usize {
      return match & data.* { StaticData.Aggregate {fields, ..} => List<Interned<StaticData>>.length(&fields) _ => usize.ZERO }
    })
    let mut payload = List<AggregateField>.make()
    let mut slot = usize.ZERO
    while slot < total {
      let child = Interned<StaticData>.with<Option<Interned<StaticData>>>(value, fn(data: &StaticData) -> Option<Interned<StaticData>> {
        return StaticValue.field(data, slot)
      })
      let found = match move child {
        Option<Interned<StaticData>>.Some {value: selected} => move selected
        Option<Interned<StaticData>>.None => { return Option<Operand>.none() }
      }
      let fieldType = match move run representationType(&found) {
        Option<Interned<Type>>.Some {value: selected} => move selected
        Option<Interned<Type>>.None => { return Option<Operand>.none() }
      }
      let operand = match move run materializeEmbedded(&mut builder.*, &found, &fieldType, origin) {
        Option<Operand>.Some {value: selected} => move selected
        Option<Operand>.None => { return Option<Operand>.none() }
      }
      run List<AggregateField>.append(&mut payload, AggregateField {index: slot, value: move operand})
      slot = slot + usize.ONE
    }
    let output = run temporary(&mut builder.*, ty, origin)
    run assign(&mut builder.*, place(output), Rvalue.Variant {tag: tag, fields: move payload}, origin)
    return Option<Operand>.some(Operand.Move {place: place(output)})
  }
  let array = Type.arrayShape(ty)
  let isStruct = Interned<StaticData>.with<bool>(value, StaticValue.isStruct)
  if !isStruct {
    if let Option<ArrayShape>.None = &array { return Option<Operand>.none() }
  }
  let count = Interned<StaticData>.with<usize>(value, fn(data: &StaticData) -> usize {
    return match & data.* { StaticData.Aggregate {fields, ..} => List<Interned<StaticData>>.length(&fields) _ => usize.ZERO }
  })
  let mut fields = List<AggregateField>.make()
  let mut at = usize.ZERO
  while at < count {
    let child = Interned<StaticData>.with<Option<Interned<StaticData>>>(value, fn(data: &StaticData) -> Option<Interned<StaticData>> {
      return StaticValue.field(data, at)
    })
    let found = match move child {
      Option<Interned<StaticData>>.Some {value: selected} => move selected
      Option<Interned<StaticData>>.None => { return Option<Operand>.none() }
    }
    // An array element has the array's element type. A struct field is typed by its own value at
    // its runtime representation: an aggregate carries its type, a scalar enum is stored as its
    // representation integer, and the field's place has that layout.
    let fieldType = match &array {
      Option<ArrayShape>.Some {value: shape} => Interned<Type>.clone(&shape.element)
      Option<ArrayShape>.None => match move run representationType(&found) {
        Option<Interned<Type>>.Some {value: selected} => move selected
        Option<Interned<Type>>.None => { return Option<Operand>.none() }
      }
    }
    let operand = match move run materializeEmbedded(&mut builder.*, &found, &fieldType, origin) {
      Option<Operand>.Some {value: selected} => move selected
      Option<Operand>.None => { return Option<Operand>.none() }
    }
    run List<AggregateField>.append(&mut fields, AggregateField {index: at, value: move operand})
    at = at + usize.ONE
  }
  let output = run temporary(&mut builder.*, ty, origin)
  run assign(&mut builder.*, place(output), Rvalue.Aggregate {fields: move fields}, origin)
  return Option<Operand>.some(Operand.Move {place: place(output)})
}

// The runtime representation type of one embedded struct field's value: an aggregate's own type,
// a scalar's primitive, `char`, unit, `'static` text, a `&'static [u8]` byte view, or a scalar
// enum's representation integer.
/// Where a static value is stored in storage of type `ty`.
pub union StaticPlacement {
  /// `ty` is not a structural union, or is normalized to the value's own type: the value is the storage.
  Plain,
  /// Under this tag of the structural union `ty`, as a value of the member type `ty`.
  Member {pub tag: usize, pub ty: Interned<Type>},
  /// The value's type is not a member the storage can place.
  Unplaced,
}

/// Where `value` sits when stored as `ty`: a value held by a structural union field is one of its
/// members, so it is stored under that member's tag.
pub effect fn staticPlacement(value: &Interned<StaticData>, ty: &Interned<Type>) -> StaticPlacement
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<List<Interned<Type>>>.None = move run Type.canonicalUnionMembers(ty) { return StaticPlacement.Plain }
  let member = match move run representationType(value) {
    Option<Interned<Type>>.Some {value: found} => move found
    Option<Interned<Type>>.None => { return StaticPlacement.Unplaced }
  }
  return match move run UnionProjection.within(ty, &member) {
    Option<UnionPlacement>.Some {value: UnionPlacement.Whole} => StaticPlacement.Plain
    Option<UnionPlacement>.Some {value: UnionPlacement.Tagged {tag, ty: stored}} => StaticPlacement.Member {tag: tag, ty: move stored}
    _ => StaticPlacement.Unplaced
  }
}

pub effect fn representationType(value: &Interned<StaticData>) -> Option<Interned<Type>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let aggregate = Interned<StaticData>.with<Option<Interned<Type>>>(value, fn(data: &StaticData) -> Option<Interned<Type>> {
    return match & data.* {
      StaticData.Aggregate {ty, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&ty))
      _ => Option<Interned<Type>>.none()
    }
  })
  if let Option<Interned<Type>>.Some {..} = &aggregate { return move aggregate }
  // A static view is a `'static` reference or slice, whatever region typing gave its borrow.
  let view = Interned<StaticData>.with<Option<Interned<Type>>>(value, fn(data: &StaticData) -> Option<Interned<Type>> {
    return match & data.* {
      StaticData.Borrow {ty, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&ty))
      _ => Option<Interned<Type>>.none()
    }
  })
  if let Option<Interned<Type>>.Some {value: viewType} = move view {
    if let Option<Interned<Type>>.Some {value: element} = move Type.sliceElement(&viewType) {
      return Option<Interned<Type>>.some(run Types.intern(Type.Slice {
        element: move element, access: Access.Shared, lifetime: run Types.internLifetime(Lifetime.Static),
      }))
    }
    let referent = Interned<Type>.with<Option<Interned<Type>>>(&viewType, fn(shape: &Type) -> Option<Interned<Type>> {
      return match &shape.* {
        Type.Reference {referent: held, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&held))
        _ => Option<Interned<Type>>.none()
      }
    })
    if let Option<Interned<Type>>.Some {value: held} = move referent {
      return Option<Interned<Type>>.some(run Types.intern(Type.Reference {
        referent: move held, access: Access.Shared, lifetime: run Types.internLifetime(Lifetime.Static),
      }))
    }
    return Option<Interned<Type>>.none()
  }
  let kind = Interned<StaticData>.with<usize>(value, fn(data: &StaticData) -> usize {
    return match & data.* {
      StaticData.Unit => 1
      StaticData.Text {..} => 2
      StaticData.Character {..} => 3
      StaticData.Boolean {..} => 4
      StaticData.Bytes {..} => 5
      _ => 0
    }
  })
  if kind == 1 { return Option<Interned<Type>>.some(run Types.intern(Type.Unit)) }
  if kind == 2 { return Option<Interned<Type>>.some(run Types.intern(Type.String {lifetime: run Types.internLifetime(Lifetime.Static)})) }
  if kind == 5 {
    let byte = run Types.intern(Type.Primitive {name: run Bytes.copy(b"u8")})
    return Option<Interned<Type>>.some(run Types.intern(Type.Slice {
      element: move byte, access: Access.Shared, lifetime: run Types.internLifetime(Lifetime.Static),
    }))
  }
  let name = Interned<StaticData>.with<&'static [u8]>(value, fn(data: &StaticData) -> &'static [u8] {
    return match & data.* {
      StaticData.Character {..} => b"char"
      StaticData.Boolean {..} => b"bool"
      StaticData.Integer {ty: integer, ..} => StaticConstant.integerName(integer)
      StaticData.Enum {representation, ..} => StaticConstant.integerName(representation)
      StaticData.Float {ty: width, ..} => {
        if width == StaticFloatType.F32 { return b"f32" }
        return b"f64"
      }
      _ => b""
    }
  })
  if name.length == usize.ZERO { return Option<Interned<Type>>.none() }
  return Option<Interned<Type>>.some(run Types.intern(Type.Primitive {name: run Bytes.copy(name)}))
}

// Lowers each child of an aggregate expression, in order, into its field value.
effect fn aggregateFields(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  node: BodyNodeId,
  count: usize,
  origin: Origin,
) -> List<AggregateField>
! Gap | CanonicalizationFailure | OutOfMemoryError
? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let mut fields = List<AggregateField>.make()
  let mut transferred = List<usize>.make()
  let mut at = usize.ZERO
  while at < count {
    let child = match move childAt(body, node, at) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => {
        return run unsupported(&owner, origin, GapCode.TypedForm)
      }
    }
    let produced = run expression(&mut builder.*, body, hir, child)
    let input = run guardOperand(&mut builder.*, body, child, move produced, &mut transferred, origin)
    run List<AggregateField>.append(&mut fields, AggregateField {
      index: aggregateFieldIndex(body, node, at), value: move input,
    })
    at = at + usize.ONE
  }
  transferGuarded(&mut builder.*, &transferred)
  return move fields
}

// Whether `id` is a literal that `constructInto` builds in place: a struct, tuple or array literal,
// a variant construction or a repetition.
fn constructs(body: &Shared<TypedBody>, id: BodyNodeId) -> bool {
  return Shared<TypedBody>.with<bool>(body, fn(bodyValue: &TypedBody) -> bool {
    let nodes = TypedBody.nodeSlice(bodyValue)
    if let BodyNodeKind.Expression {form, ..} = &nodes[id.index].kind {
      return match &form {
        BodyExpression.Aggregate {..} => true
        BodyExpression.VariantConstruct {..} => true
        BodyExpression.ArrayRepeat {..} => true
        _ => false
      }
    }
    return false
  })
}

// Builds the literal `id` directly in local `output`, which holds no value yet, instead of in a
// temporary that is then copied there (#2438). Every part is evaluated before `output` is written,
// so a part that fails or exits leaves it untouched. False, with nothing lowered, when `id` is not
// such a literal or its runtime type is not `output`'s.
effect fn constructInto(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, id: BodyNodeId, output: usize) -> bool
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !constructs(body, id) { return false }
  let selected = run instanceView(&mut builder.*, body, id)
  let ty = match &selected {
    View.Aggregate {ty, ..} => Interned<Type>.clone(&ty)
    View.VariantConstruct {ty, ..} => Interned<Type>.clone(&ty)
    View.ArrayRepeat {ty, ..} => Interned<Type>.clone(&ty)
    _ => { return false }
  }
  let bindings = List<Binding>.asSlice(&builder.bindings)
  let projections = List<RuntimeProjection>.asSlice(&builder.projections)
  let built = run RuntimeType.applyBindings(&ty, bindings, projections)
  let stored = run RuntimeType.applyBindings(&localType(&builder.*, output), bindings, projections)
  if !(run Type.runtimeEqualsShared(&built, &stored)) { return false }
  match move selected {
    View.Aggregate {node, count, origin, ..} => {
      if count >= fieldwiseMinimum && fieldwise(&builder.*, body, node, count, &ty) {
        run aggregateInto(&mut builder.*, body, hir, node, count, output, origin)
        return true
      }
      let fields = run aggregateFields(&mut builder.*, body, hir, node, count, origin)
      run assign(&mut builder.*, place(output), Rvalue.Aggregate {fields: move fields}, origin)
    }
    View.VariantConstruct {node, tag, count, origin, ..} => {
      let fields = run aggregateFields(&mut builder.*, body, hir, node, count, origin)
      run assign(&mut builder.*, place(output), Rvalue.Variant {tag: tag, fields: move fields}, origin)
    }
    View.ArrayRepeat {value, count, origin, ..} => run arrayRepeatInto(&mut builder.*, body, hir, value, count, &ty, output, origin)
    _ => ()
  }
  return true
}

// The fewest fields a struct literal needs before `constructInto` stores each field as soon as it
// is evaluated. Gathering every field first keeps all of them live at once, and a literal with
// many fields spills most of them to the stack before the record is stored.
const fieldwiseMinimum: usize = 8

// Whether the struct or tuple literal `node` can store each field into its destination as it is
// evaluated: no field value needs cleanup, so when a later field fails, the partly written
// destination owns nothing and every moved-from source has nothing left to drop.
fn fieldwise(builder: &Builder, body: &Shared<TypedBody>, node: BodyNodeId, count: usize, ty: &Interned<Type>) -> bool {
  if let Option<ArrayShape>.Some {..} = Type.arrayShape(ty) { return false }
  let mut at = usize.ZERO
  while at < count {
    let child = match childAt(body, node, at) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { return false }
    }
    if CleanupNeeds.node(&builder.needs, child.index) { return false }
    at = at + usize.ONE
  }
  return true
}

// Builds the struct or tuple literal `node` in local `output`, which holds no value, storing each
// field in source order as soon as it is evaluated.
effect fn aggregateInto(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, node: BodyNodeId, count: usize,
  output: usize, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let mut at = usize.ZERO
  while at < count {
    let child = match move childAt(body, node, at) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
    }
    let produced = run expression(&mut builder.*, body, hir, child)
    if !builder.live { return () }
    let mut destination = place(output)
    run List<Projection>.append(&mut destination.projections, Projection.Field {index: aggregateFieldIndex(body, node, at)})
    run assign(&mut builder.*, move destination, Rvalue.Use {value: move produced}, origin)
    at = at + usize.ONE
  }
  return ()
}

// Repetition has one source evaluation and constant-size control flow. No call or fallible
// source operation occurs while filling, so ownership transfers directly into the array.
effect fn arrayRepeat(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, value: BodyNodeId,
  count: usize, ty: &Interned<Type>, origin: Origin) -> Operand
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let output = run temporary(&mut builder.*, ty, origin)
  run arrayRepeatInto(&mut builder.*, body, hir, value, count, ty, output, origin)
  if !builder.live { return Operand.Unit }
  return Operand.Move {place: place(output)}
}

// Fills local `output`, which holds no value, with the repetition: the source is evaluated once,
// before any element is stored.
effect fn arrayRepeatInto(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, value: BodyNodeId,
  count: usize, ty: &Interned<Type>, output: usize, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if count == usize.ZERO {
    run discard(&mut builder.*, body, hir, value)
    run assign(&mut builder.*, place(output), Rvalue.Aggregate {fields: List<AggregateField>.make()}, origin)
    return ()
  }
  let input = run expression(&mut builder.*, body, hir, value)
  if !builder.live { return () }
  if count == usize.ONE {
    let mut destination = place(output)
    run List<Projection>.append(&mut destination.projections, Projection.ConstIndex {index: usize.ZERO})
    run assign(&mut builder.*, move destination, Rvalue.Use {value: move input}, origin)
    return ()
  }
  let splat = fillByte(&input)
  if splat != usize.MAX {
    run assign(&mut builder.*, place(output), Rvalue.Fill {byte: usize.toU8(splat)}, origin)
    return ()
  }
  // Expression lowering already snapshots place reads and call results. Reuse that storage
  // rather than copying an aggregate operand again just to enter the fill loop.
  let mut stored = usize.MAX
  if let Operand.Copy {place: source} = &input {
    if List<Projection>.length(&source.projections) == usize.ZERO { stored = source.local }
  }
  if let Operand.Move {place: source} = &input {
    if List<Projection>.length(&source.projections) == usize.ZERO { stored = source.local }
  }
  if stored == usize.MAX {
    let owner = InstanceKey.identity(&builder.function.key)
    let element = match move Type.arrayShape(ty) {
      Option<ArrayShape>.Some {value: shape} => move shape.element
      _ => { return run unsupported(&owner, origin, GapCode.TypedForm) }
    }
    stored = run storageValue(&mut builder.*, &element, Rvalue.Use {value: move input}, origin)
  }
  let word = run usizeType()
  let index = run storageValue(&mut builder.*, &word, Rvalue.Use {value: run wordOperand(usize.ZERO)}, origin)
  let condition = run block(&mut builder.*, origin)
  let filling = run block(&mut builder.*, origin)
  let joined = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Goto {target: condition, origin: origin})
  resume(&mut builder.*, condition)
  let bounded = run storageCondition(&mut builder.*, InfixOperator.LessThan,
    Operand.Copy {place: place(index)}, run wordOperand(count), origin)
  terminate(&mut builder.*, Terminator.Branch {condition: move bounded, thenBlock: filling,
    elseBlock: joined, origin: origin})
  resume(&mut builder.*, filling)
  let mut destination = place(output)
  run List<Projection>.append(&mut destination.projections, Projection.Index {local: index})
  run assign(&mut builder.*, move destination, Rvalue.Use {value: Operand.Copy {place: place(stored)}}, origin)
  // The guard and the fixed-array extent limit prove this increment cannot overflow.
  run assign(&mut builder.*, place(index), Rvalue.Binary {operation: InfixOperator.Add,
    left: Operand.Copy {place: place(index)}, right: run wordOperand(usize.ONE)}, origin)
  terminate(&mut builder.*, Terminator.Goto {target: condition, origin: origin})
  resume(&mut builder.*, joined)
  return ()
}

// The byte every byte of a constant element repeats, or usize.MAX: `false`, `true`, a zero integer
// or positive zero float, and any 8-bit integer.
fn fillByte(input: &Operand) -> usize {
  if let Operand.Boolean {value} = &input.* {
    if value { return usize.ONE }
    return usize.ZERO
  }
  if let Operand.Integer {decimal, negative, ty} = &input.* {
    return integerFillByte(Bytes.asSlice(&decimal), negative, &ty)
  }
  if let Operand.Float {bits, ..} = &input.* {
    if bits == 0 { return usize.ZERO }
  }
  return usize.MAX
}

fn integerFillByte(decimal: &[u8], negative: bool, ty: &Interned<Type>) -> usize {
  if decimal.length == usize.ONE && decimal[0] == 48 { return usize.ZERO }
  let narrow = Interned<Type>.with<bool>(ty, fn(value: &Type) -> bool { return Type.laneBits(value, 64) == 8 })
  if !narrow || decimal.length > 3 { return usize.MAX }
  let mut magnitude = usize.ZERO
  let mut at = usize.ZERO
  while at < decimal.length {
    magnitude = magnitude * 10 + u8.toUsize(decimal[at] - 48)
    at = at + usize.ONE
  }
  if magnitude > 255 || (negative && magnitude > 128) { return usize.MAX }
  if negative { return (256 - magnitude) % 256 }
  return magnitude
}

// A later operand of the same full expression may fail or leave the body (a `return`, `break` or
// `continue` inside a match arm or block); an owned operand already evaluated is then a temporary
// that exit must drop (D7, FAIL-006, CLEANUP-002). `produced` is the operand's own value, moved or
// copied out of its fresh result storage. Ownership transfers to the call or aggregate once every
// operand is evaluated.
effect fn guardOperand(builder: &mut Builder, body: &Shared<TypedBody>, child: BodyNodeId, produced: Operand,
  transferred: &mut List<usize>, origin: Origin) -> Operand ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !builder.live || !ownedRvalue(body, child) || !CleanupNeeds.node(&builder.needs, child.index) {
    return move produced
  }
  // A fresh result temporary is itself the pending owner; anything else is captured first.
  let mut whole = usize.MAX
  if let Operand.Copy {place: stored} = &produced {
    if List<Projection>.length(&stored.projections) == usize.ZERO { whole = stored.local }
  }
  if let Operand.Move {place: stored} = &produced {
    if List<Projection>.length(&stored.projections) == usize.ZERO { whole = stored.local }
  }
  let mut captured = freshTemporary(&builder.*, whole)
  if captured == usize.MAX {
    let owner = InstanceKey.identity(&builder.function.key)
    let ty = match move run instanceNodeType(&builder.*, body, child) {
      Option<Interned<Type>>.Some {value} => move value
      _ => { return run unsupported(&owner, origin, GapCode.TypedForm) }
    }
    captured = run temporary(&mut builder.*, &ty, origin)
    run assign(&mut builder.*, place(captured), Rvalue.Use {value: move produced}, origin)
  }
  run pend(&mut builder.*, captured)
  run List<usize>.append(&mut transferred.*, captured)
  return Operand.Move {place: place(captured)}
}

// `local` when it is a compiler temporary not already pending cleanup.
fn freshTemporary(builder: &Builder, local: usize) -> usize {
  let locals = List<Local>.asSlice(&builder.function.locals)
  if local >= locals.length { return usize.MAX }
  let temporary = match &locals[local].kind { LocalKind.Temp => true _ => false }
  if !temporary { return usize.MAX }
  let pending = List<Pending>.asSlice(&builder.temporaries)
  let mut at = usize.ZERO
  while at < pending.length {
    if pending[at].local == local { return usize.MAX }
    at = at + usize.ONE
  }
  return local
}

fn transferGuarded(builder: &mut Builder, transferred: &List<usize>) -> () {
  let guarded = List<usize>.asSlice(transferred)
  let mut at = usize.ZERO
  while at < guarded.length {
    transferTemporary(&mut builder.*, guarded[at])
    at = at + usize.ONE
  }
  return ()
}

// For a call through a witness (`witness`), lends an operand by reference when the selected
// application takes the parameter borrowed; any other call passes the operand through.
effect fn witnessArgument(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  callNode: BodyNodeId,
  child: BodyNodeId,
  at: usize,
  witness: bool,
  argument: Operand,
  origin: Origin,
) -> Operand
! Gap | CanonicalizationFailure | OutOfMemoryError
? &mut Allocator {
  if !witness { return move argument }
  let owner = InstanceKey.identity(&builder.function.key)
  let selected = resolvedCallOperand(&builder.*, callNode, at)
  let operand = match move selected {
    Option<CallOperand>.Some {value} => move value
    _ => { return run unsupported(&owner, origin, GapCode.WitnessOperand) }
  }
  if let Option<Access>.Some {value: access} = move operand.borrow {
    // Capture an arbitrary owned rvalue exactly once before lending its storage.
    let captured = run temporary(&mut builder.*, &operand.value, origin)
    run assign(&mut builder.*, place(captured), Rvalue.Use {value: move argument}, origin)
    if ownedRvalue(body, child) && CleanupNeeds.node(&builder.needs, child.index) { run pend(&mut builder.*, captured) }
    let reference = run temporary(&mut builder.*, &operand.parameter, origin)
    run assign(&mut builder.*, place(reference), Rvalue.Ref {access: access, place: place(captured)}, origin)
    return Operand.Copy {place: place(reference)}
  }
  return move argument
}

// Exact invocation loans address the stored environment; other witnesses retain their
// ordinary owned-rvalue capture rule. Inspect the pass before evaluating the receiver.
effect fn callArgument(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module,
  callNode: BodyNodeId, child: BodyNodeId, at: usize, environment: bool, witness: bool,
  origin: Origin) -> Operand ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if environment && at == usize.ZERO && witness {
    let selected = resolvedCallOperand(&builder.*, callNode, at)
    if let Option<CallOperand>.Some {value: operand} = move selected {
      if let Option<Access>.Some {value: access} = move operand.borrow {
        let mut selectedPlace = run expressionPlace(&mut builder.*, body, hir, child)
        run projectCallableReceiver(&mut selectedPlace, receiverDereferences(&builder.*, callNode))
        let reference = run temporary(&mut builder.*, &operand.parameter, origin)
        run assign(&mut builder.*, place(reference), Rvalue.Ref {access: access, place: move selectedPlace}, origin)
        return Operand.Copy {place: place(reference)}
      }
    }
  }
  let produced = run expression(&mut builder.*, body, hir, child)
  return run witnessArgument(&mut builder.*, body, callNode, child, at, witness, move produced, origin)
}

// Whether a witness call lends operand `at` by reference rather than passing its value.
fn lentArgument(builder: &Builder, callNode: BodyNodeId, at: usize, witness: bool) -> bool {
  if !witness { return false }
  return match move resolvedCallOperand(builder, callNode, at) {
    Option<CallOperand>.Some {value} => match &value.borrow { Option<Access>.Some {..} => true _ => false }
    Option<CallOperand>.None => false
  }
}

struct PipedArgument {
  operand: Operand,
  cleanup: Option<usize>,
}

fn callablePipeline(body: &Shared<TypedBody>, node: BodyNodeId) -> bool {
  return Shared<TypedBody>.with<bool>(body, fn(value: &TypedBody) -> bool {
    return match &TypedBody.nodeSlice(value)[node.index].kind {
      BodyNodeKind.Expression {form: BodyExpression.CallableCall {pipeline, ..}, ..} => pipeline
      _ => false
    }
  })
}

// A unary pipeline completes its input before touching the callable environment. Retain
// transferred input storage until invocation/construction commits, including callee exits.
effect fn pipedArgument(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module,
  node: BodyNodeId, witness: bool, origin: Origin) -> Option<PipedArgument>
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !callablePipeline(body, node) { return Option<PipedArgument>.none() }
  let owner = InstanceKey.identity(&builder.function.key)
  let child = match move childAt(body, node, usize.ONE) {
    Option<BodyNodeId>.Some {value} => value
    _ => { return run unsupported(&owner, origin, GapCode.MissingCallArgument) }
  }
  let mut ty = match move run instanceNodeType(&builder.*, body, child) {
    Option<Interned<Type>>.Some {value} => move value
    _ => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let mut borrowed = false
  if witness {
    if let Option<CallOperand>.Some {value} = move resolvedCallOperand(&builder.*, node, usize.ONE) {
      borrowed = match &value.borrow { Option<Access>.Some {..} => true _ => false }
      ty = Interned<Type>.clone(&value.parameter)
    }
  }
  let input = run callArgument(&mut builder.*, body, hir, node, child, usize.ONE, false, witness, origin)
  if !builder.live { return Option<PipedArgument>.none() }
  let transfers = !borrowed && ownedRvalue(body, child)
  let snapshot = run temporary(&mut builder.*, &ty, origin)
  run assign(&mut builder.*, place(snapshot), Rvalue.Use {value: move input}, origin)
  let mut cleanup = Option<usize>.none()
  if transfers && CleanupNeeds.node(&builder.needs, child.index) {
    run pend(&mut builder.*, snapshot)
    cleanup = Option<usize>.some(snapshot)
  }
  let mut operand = Operand.Copy {place: place(snapshot)}
  if transfers { operand = Operand.Move {place: place(snapshot)} }
  return Option<PipedArgument>.some(PipedArgument {operand: move operand, cleanup: move cleanup})
}

fn commitPipedArgument(builder: &mut Builder, cleanup: Option<usize>) -> () {
  if let Option<usize>.Some {value} = move cleanup { transferTemporary(&mut builder.*, value) }
}

// Lowers call operands in source evaluation order, retaining their ABI parameter order.
effect fn callArguments(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  callNode: BodyNodeId,
  count: usize,
  environment: bool,
  foreign: &Option<Interned<DeclarationId>>,
  origin: Origin,
) -> List<Operand>
! Gap | CanonicalizationFailure | OutOfMemoryError
? &mut Allocator | &mut Types {
  let stored = run storedCallArguments(&builder.*, callNode)
  if let Option<StoredArguments>.Some {value} = move stored {
    return run sectionArguments(&mut builder.*, body, hir, callNode, count, move value, origin)
  }
  let owner = InstanceKey.identity(&builder.function.key)
  let mut witness = false
  if let Option<Interned<DeclarationId>>.None = &foreign.* { witness = true }
  let mut piped = run pipedArgument(&mut builder.*, body, hir, callNode, witness, origin)
  let mut pipedCleanup = Option<usize>.none()
  let mut values = List<Operand>.make()
  let mut transferred = List<usize>.make()
  if !builder.live { return move values }
  let mut at = usize.ZERO
  while at < count {
    let child = match move childAt(body, callNode, at) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => {
        return run unsupported(&owner, origin, GapCode.MissingCallArgument)
      }
    }
    let mut argument = Operand.Unit
    // A piped input and a lent witness operand already hold their own cleanup temporary.
    let mut held = lentArgument(&builder.*, callNode, at, witness)
    if at == usize.ONE {
      if let Option<PipedArgument>.Some {value} = move piped {
        pipedCleanup = move value.cleanup
        argument = move value.operand
        held = true
      } else { argument = run callArgument(&mut builder.*, body, hir, callNode, child, at, environment, witness, origin) }
      piped = Option<PipedArgument>.none()
    } else { argument = run callArgument(&mut builder.*, body, hir, callNode, child, at, environment, witness, origin) }
    if !builder.live { return move values }
    if held { run List<Operand>.append(&mut values, move argument) } else {
      let guarded = run guardOperand(&mut builder.*, body, child, move argument, &mut transferred, origin)
      run List<Operand>.append(&mut values, move guarded)
    }
    at = at + usize.ONE
  }
  commitPipedArgument(&mut builder.*, move pipedCleanup)
  transferGuarded(&mut builder.*, &transferred)
  return move values
}

effect fn storedCallArguments(builder: &Builder, node: BodyNodeId) -> Option<StoredArguments>
! OutOfMemoryError ? &mut Allocator {
  let calls = List<CallTarget>.asSlice(&builder.calls)
  let mut at = usize.ZERO
  while at < calls.length {
    if calls[at].node.index == node.index {
      if let Option<StoredArguments>.Some {value} = &calls[at].stored {
        let mut lanes = List<StoredLane>.make()
        let listed = List<StoredLane>.asSlice(&value.lanes)
        let mut laneAt = usize.ZERO
        while laneAt < listed.length {
          run List<StoredLane>.append(&mut lanes, listed[laneAt])
          laneAt = laneAt + usize.ONE
        }
        let mut environment = Option<StoredEnvironment>.none()
        if let Option<StoredEnvironment>.Some {value: input} = &value.environment {
          environment = Option<StoredEnvironment>.some(StoredEnvironment {field: input.field,
            parameter: Interned<Type>.clone(&input.parameter), borrow: copyAccess(&input.borrow)})
        }
        return Option<StoredArguments>.some(StoredArguments {environment: move environment, lanes: move lanes, consumes: value.consumes})
      }
    }
    at = at + usize.ONE
  }
  return Option<StoredArguments>.none()
}

// Release only the cleanup owner transferred into a new aggregate, retaining any other
// temporaries whose referents must remain live through this full expression.
fn transferTemporary(builder: &mut Builder, local: usize) -> () {
  let mut at = List<Pending>.length(&builder.temporaries)
  while at > usize.ZERO {
    at = at - usize.ONE
    if List<Pending>.asSlice(&builder.temporaries)[at].local == local {
      drop List<Pending>.remove(&mut builder.*.temporaries, at)
      return ()
    }
  }
  return ()
}

effect fn stagedCallableFields(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module,
  node: BodyNodeId, count: usize, origin: Origin) -> List<AggregateField>
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let callee = match move childAt(body, node, usize.ZERO) {
    Option<BodyNodeId>.Some {value} => value
    _ => { return run unsupported(&owner, origin, GapCode.MissingCallArgument) }
  }
  let baseType = match move run instanceNodeType(&builder.*, body, callee) {
    Option<Interned<Type>>.Some {value} => move value
    _ => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let consumes = Shared<TypedBody>.with<bool>(body, fn(value: &TypedBody) -> bool {
    return match &TypedBody.nodeSlice(value)[node.index].kind {
      BodyNodeKind.Expression {form: BodyExpression.StagedCallable {mode, ..}, ..} => mode != CallableMode.Shared
      _ => false
    }
  })
  let selectedCount = Interned<Type>.with<Option<usize>>(&baseType, fn(value: &Type) -> Option<usize> {
    if let Type.CallableValue {application, captures, fieldInputs, ..} = &value.* {
      let environment = Interned<Application>.with<CallableEnvironment>(&application, fn(target: &Application) -> CallableEnvironment {
        return CallableEnvironment.of(target, List<CallableFieldInput>.asSlice(&fieldInputs))
      })
      if CallableEnvironment.isValue(&environment) { return Option<usize>.some(usize.MAX) }
      return Option<usize>.some(List<Interned<Type>>.length(&captures))
    }
    if let Type.CallableSchema {captures, ..} = &value.* {
      return Option<usize>.some(List<Interned<Type>>.length(&captures))
    }
    return Option<usize>.none()
  })
  let baseCount = match move selectedCount {
    Option<usize>.Some {value} => value
    _ => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let input = run expression(&mut builder.*, body, hir, callee)
  let mut fields = List<AggregateField>.make()
  if !builder.live { return move fields }
  // Own a stable snapshot before evaluating any newly supplied argument.
  let snapshot = run temporary(&mut builder.*, &baseType, origin)
  run assign(&mut builder.*, place(snapshot), Rvalue.Use {value: move input}, origin)
  let mut transferred = List<usize>.make()
  if consumes && CleanupNeeds.node(&builder.needs, callee.index) {
    run pend(&mut builder.*, snapshot)
    run List<usize>.append(&mut transferred, snapshot)
  }
  let mut retained = baseCount
  if baseCount == usize.MAX { retained = usize.ONE }
  let mut at = usize.ZERO
  while at < retained {
    let mut field = place(snapshot)
    if baseCount != usize.MAX { run List<Projection>.append(&mut field.projections, Projection.Field {index: at}) }
    let mut value = Operand.Unit
    if consumes { value = Operand.Move {place: move field} } else { value = Operand.Copy {place: move field} }
    run List<AggregateField>.append(&mut fields, AggregateField {index: at, value: move value})
    at = at + usize.ONE
  }
  at = usize.ONE
  while at < count {
    let child = match move childAt(body, node, at) {
      Option<BodyNodeId>.Some {value} => value
      _ => { return run unsupported(&owner, origin, GapCode.MissingCallArgument) }
    }
    let produced = run expression(&mut builder.*, body, hir, child)
    if !builder.live { return move fields }
    let mut value = Operand.Unit
    if ownedRvalue(body, child) && CleanupNeeds.node(&builder.needs, child.index) {
      let ty = match move run instanceNodeType(&builder.*, body, child) {
        Option<Interned<Type>>.Some {value: selectedType} => move selectedType
        _ => { return run unsupported(&owner, origin, GapCode.TypedForm) }
      }
      let captured = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(captured), Rvalue.Use {value: move produced}, origin)
      run pend(&mut builder.*, captured)
      run List<usize>.append(&mut transferred, captured)
      value = Operand.Move {place: place(captured)}
    } else { value = move produced }
    run List<AggregateField>.append(&mut fields, AggregateField {index: retained + at - usize.ONE, value: move value})
    at = at + usize.ONE
  }
  let guarded = List<usize>.asSlice(&transferred)
  let mut guardAt = usize.ZERO
  while guardAt < guarded.length {
    transferTemporary(&mut builder.*, guarded[guardAt])
    guardAt = guardAt + usize.ONE
  }
  return move fields
}

effect fn sectionArguments(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module,
  node: BodyNodeId, count: usize, stored: StoredArguments, origin: Origin) -> List<Operand>
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let mut piped = run pipedArgument(&mut builder.*, body, hir, node, false, origin)
  let mut pipedCleanup = Option<usize>.none()
  let mut values = List<Operand>.make()
  if !builder.live { return move values }
  let callee = match move childAt(body, node, usize.ZERO) {
    Option<BodyNodeId>.Some {value} => value
    _ => { return run unsupported(&owner, origin, GapCode.MissingCallArgument) }
  }
  // Read the environment before written arguments can replace its stored binding. A mutable
  // section snapshots loan descriptors, so repeated invocation still reaches the same referents.
  let dereferences = receiverDereferences(&builder.*, node)
  let mut original = Option<Place>.none()
  if dereferences == usize.ZERO && !stored.consumes {
    if let Option<StoredEnvironment>.Some {value: input} = &stored.environment {
      if let Option<Access>.Some {..} = &input.borrow {
        original = Option<Place>.some(run expressionPlace(&mut builder.*, body, hir, callee))
      }
    }
  }
  let mut evaluated = Operand.Unit
  if let Option<Place>.Some {value} = &original {
    let ty = match move run instanceNodeType(&builder.*, body, callee) {
      Option<Interned<Type>>.Some {value: selectedType} => move selectedType
      _ => { return run unsupported(&owner, origin, GapCode.TypedForm) }
    }
    let snapshot = run temporary(&mut builder.*, &ty, origin)
    run assign(&mut builder.*, place(snapshot), Rvalue.Use {value: Operand.Copy {place: run copyPlace(&value)}}, origin)
    evaluated = Operand.Copy {place: place(snapshot)}
  } else { evaluated = run expression(&mut builder.*, body, hir, callee) }
  if !builder.live { return move values }
  let mut environment = match move evaluated {
    Operand.Copy {place: value} => move value
    Operand.Move {place: value} => move value
    _ => { return run unsupported(&owner, origin, GapCode.ExpectedPlace) }
  }
  if dereferences != usize.ZERO {
    // Snapshot only the loan descriptor. Never copy its affine environment into a temporary.
    let ty = match move run instanceNodeType(&builder.*, body, callee) {
      Option<Interned<Type>>.Some {value} => move value
      _ => { return run unsupported(&owner, origin, GapCode.TypedForm) }
    }
    let snapshot = run temporary(&mut builder.*, &ty, origin)
    run assign(&mut builder.*, place(snapshot), Rvalue.Use {value: Operand.Copy {place: move environment}}, origin)
    environment = place(snapshot)
    run projectCallableReceiver(&mut environment, dereferences)
  }
  let pending = List<Pending>.length(&builder.temporaries)
  let guarded = stored.consumes && CleanupNeeds.node(&builder.needs, callee.index)
  if guarded { run pend(&mut builder.*, environment.local) }
  if let Option<StoredEnvironment>.Some {value: input} = &stored.environment {
    let mut field = run copyPlace(&environment)
    if let Option<Place>.Some {value} = &original { field = run copyPlace(&value) }
    run List<Projection>.append(&mut field.projections, Projection.Field {index: input.field})
    let mut operand = Operand.Unit
    if let Option<Access>.Some {value: access} = &input.borrow {
      let reference = run temporary(&mut builder.*, &input.parameter, origin)
      run assign(&mut builder.*, place(reference), Rvalue.Ref {access: access, place: move field}, origin)
      operand = Operand.Copy {place: place(reference)}
    } else { operand = Operand.Move {place: move field} }
    run List<Operand>.append(&mut values, move operand)
  }
  let mut written = List<Operand>.make()
  let mut at = usize.ONE
  while at < count {
    let child = match move childAt(body, node, at) {
      Option<BodyNodeId>.Some {value} => value
      _ => { return run unsupported(&owner, origin, GapCode.MissingCallArgument) }
    }
    let mut argument = Operand.Unit
    if at == usize.ONE {
      if let Option<PipedArgument>.Some {value} = move piped {
        pipedCleanup = move value.cleanup
        argument = move value.operand
      } else { argument = run expression(&mut builder.*, body, hir, child) }
      piped = Option<PipedArgument>.none()
    } else { argument = run expression(&mut builder.*, body, hir, child) }
    run List<Operand>.append(&mut written, move argument)
    if !builder.live { return move values }
    at = at + usize.ONE
  }
  let operands = run callOperands(&builder.*, node)
  run placeStoredLanes(&mut builder.*, &mut values, &environment, List<CallOperand>.asSlice(&operands), &stored, move written, origin)
  // A diverging written argument cleaned the transferred environment. On the call edge every
  // capture moves into its original target parameter, so remove the temporary cleanup owner.
  if guarded { drop List<Pending>.remove(&mut builder.*.temporaries, pending) }
  commitPipedArgument(&mut builder.*, move pipedCleanup)
  return move values
}

// Returns the bit pattern of a floating literal at its written width, absent when it does not parse.
fn floatLiteralBits(hir: &Module, literal: HirId, ty: &Interned<Type>) -> Option<u64> {
  if let HirNode.FloatingLiteral {spelling, ..} = Module.node(hir, literal) {
    let narrow = Interned<Type>.with<bool>(
      ty,
      fn(value: &Type) -> bool {
        if let Type.Primitive {name} = &value.* {
          let text = Bytes.asSlice(&name)
          return text.length == 3 && text[usize.ZERO] == 102 && text[usize.ONE] == 51 && text[2] == 50
        }
        return false
      },
    )
    if narrow {
      let parsed = FloatingLiteral.f32Bits(hir, spelling)
      if let Result<u32, ParseError>.Success {value} = move parsed {
        return Option<u64>.some(f64.toBits(f32.toF64(f32.fromBits(value))))
      }
      return Option<u64>.none()
    }
    let parsed = FloatingLiteral.f64Bits(hir, spelling)
    if let Result<u64, ParseError>.Success {value} = move parsed {
      return Option<u64>.some(value)
    }
  }
  return Option<u64>.none()
}

// The live owner a binding read names exactly: a consuming-pattern binding that needs cleanup is
// owned as its subject projected along the read's own path. `usize.MAX` when it names none.
effect fn readOwner(builder: &Builder, body: &Shared<TypedBody>, read: BodyNodeId, subject: BodyNodeId, origin: Origin) -> usize
! Gap | CanonicalizationFailure | OutOfMemoryError
? &mut Allocator | &mut Types {
  let narrowed = run narrowedLocal(builder, body, read, subject)
  if narrowed != usize.MAX {
    let owners = List<Owner>.asSlice(&builder.owners)
    let mut at = owners.length
    while at > usize.ZERO {
      at = at - usize.ONE
      if owners[at].local == narrowed && !ownerEnded(builder, at) { return at }
    }
    return usize.MAX
  }
  let mut path = List<Projection>.make()
  let mut step = usize.ZERO
  while true {
    let selected = match move bindingStepAt(body, read, step) {
      Option<BodyPlaceStep>.Some {value} => move value
      Option<BodyPlaceStep>.None => { break }
    }
    run lowerStep(builder, &selected, &mut path)
    step = step + usize.ONE
  }
  let wanted = List<Projection>.asSlice(&path)
  let owners = List<Owner>.asSlice(&builder.owners)
  let mut at = owners.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if owners[at].subject == subject.index && !ownerEnded(builder, at) {
      let held = List<Projection>.asSlice(&owners[at].path)
      if held.length == wanted.length {
        let mut same = true
        let mut depth = usize.ZERO
        while same && depth < held.length {
          same = sameProjection(&held[depth], &wanted[depth])
          depth = depth + usize.ONE
        }
        if same {
          return at
        }
      }
    }
  }
  return usize.MAX
}

// Reads the value a consuming site (`move`, a consuming match) releases afterwards. Its release,
// not this read, ends the owner, so the owned-read refusal does not apply.
effect fn consumedOperand(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, id: BodyNodeId) -> Operand
! Gap | CanonicalizationFailure | OutOfMemoryError
? &mut Allocator | &mut Types {
  let selected = run instanceView(&mut builder.*, body, id)
  return match move selected {
    View.Local {index, ty, origin} => {
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Use {value: Operand.Copy {place: place(index + usize.ONE)}}, origin)
      return Operand.Copy {place: place(output)}
    }
    View.PatternBinding {ty, origin, ..} => {
      let projected = run expressionPlace(&mut builder.*, body, hir, id)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Use {value: Operand.Copy {place: move projected}}, origin)
      return Operand.Copy {place: place(output)}
    }
    _ => run expression(&mut builder.*, body, hir, id)
  }
}

// One operator of a left-nested infix chain, with its right operand.
struct InfixLink {
  operation: InfixOperator,
  right: BodyNodeId,
  ty: Interned<Type>,
  origin: Origin,
}

// Lowers a left-nested chain such as `a + b + c` without recursing once per operator: the chain's
// left spine is collected first, then its leftmost operand and each right operand lower in source
// order. `expression`'s frame is large, so per-operator recursion would bound the chain length by
// the native stack (EXPR-006). A short-circuit or `string` operator ends the spine and lowers as
// an operand.
effect fn infixChain(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, outer: InfixLink, left: BodyNodeId) -> Operand
! Gap | CanonicalizationFailure | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut links = List<InfixLink>.make()
  run List<InfixLink>.append(&mut links, move outer)
  let mut leftmost = left
  while true {
    let selected = run instanceView(&mut builder.*, body, leftmost)
    if let View.Infix {operation, left: inner, right, ty, origin} = move selected {
      if operation == InfixOperator.And || operation == InfixOperator.Or {
        break
      }
      if let Option<Interned<Type>>.Some {value: operand} = move run instanceNodeType(&builder.*, body, inner) {
        if Interned<Type>.with<bool>(&operand, byteView) {
          break
        }
      }
      run List<InfixLink>.append(&mut links, InfixLink {operation: operation, right: right, ty: move ty, origin: origin})
      leftmost = inner
    } else {
      break
    }
  }
  let mut result = run expression(&mut builder.*, body, hir, leftmost)
  let chain = List<InfixLink>.asSlice(&links)
  let mut at = chain.length
  while at > usize.ZERO {
    at = at - usize.ONE
    let link = &chain[at]
    let rhs = run expression(&mut builder.*, body, hir, link.right)
    let output = run temporary(&mut builder.*, &link.ty, link.origin)
    run assign(
      &mut builder.*,
      place(output),
      Rvalue.Binary {operation: link.operation, left: move result, right: move rhs},
      link.origin,
    )
    result = Operand.Copy {place: place(output)}
  }
  return move result
}

effect fn expression(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, id: BodyNodeId) -> Operand
! Gap | CanonicalizationFailure | OutOfMemoryError
? &mut Allocator | &mut Types {
  let selected = run instanceView(&mut builder.*, body, id)
  let owner = InstanceKey.identity(&builder.function.key)
  return match move selected {
    View.Integer {ty, literal, origin} => match Module.node(hir, Anchor.hir(&builder.anchor, literal)) {
      HirNode.IntegerLiteral {sign, magnitude, ..} => Operand.Integer {
        decimal: run Bytes.copy(Module.text(hir, magnitude)),
        negative: sign == Sign.Negative,
        ty: move ty,
      }
      _ => run unsupported(&owner, origin, GapCode.IntegerLiteral)
    }
    View.Float {ty, literal, origin} => {
      let bits = floatLiteralBits(hir, Anchor.hir(&builder.anchor, literal), &ty)
      if let Option<u64>.Some {value} = move bits {
        return Operand.Float {bits: value, ty: move ty}
      }
      return run unsupported(&owner, origin, GapCode.FloatLiteral)
    }
    // Text and byte-string literals are descriptors over their decoded bytes (TEXT-001).
    View.Text {ty, literal, origin} => {
      let bytes = match Module.node(hir, Anchor.hir(&builder.anchor, literal)) {
        HirNode.TextLiteral {value} => run Bytes.copy(Module.text(hir, value))
        HirNode.BytesLiteral {value} => run Bytes.copy(Module.text(hir, value))
        _ => run unsupported(&owner, origin, GapCode.TypedForm)
      }
      let count = Bytes.length(&bytes)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Slice {data: Operand.StaticBytes {bytes: move bytes}, count: run usizeOperand(usize.toU64(count))}, origin)
      return Operand.Copy {place: place(output)}
    }
    View.Boolean {value, origin: _} => Operand.Boolean {value: value}
    View.Unit {origin: _} => Operand.Unit
    View.Embedded {value, ty, origin} => {
      // A struct or variant constant is copied from its program-lifetime image, which lays out
      // each field at its declared type: a field the value alone does not type, such as a
      // structural union holding one member, is stored as the layout says.
      let nominal = Interned<StaticData>.with<bool>(&value, StaticValue.isStruct)
        || Option<usize>.isSome(&Interned<StaticData>.with<Option<usize>>(&value, StaticValue.variantTag))
      if nominal {
        let referenceType = run Types.intern(Type.Reference {referent: Interned<Type>.clone(&ty), access: Access.Shared,
          lifetime: run Types.internLifetime(Lifetime.Static)})
        let address = run temporary(&mut builder.*, &referenceType, origin)
        run assign(&mut builder.*, place(address), Rvalue.Use {value: Operand.StaticValue {
          value: Interned<StaticData>.clone(&value), ty: Interned<Type>.clone(&ty),
        }}, origin)
        let mut stored = place(address)
        run List<Projection>.append(&mut stored.projections, Projection.Deref)
        // The image is read-only program storage: a use gets its own copy, as any place read does.
        let output = run temporary(&mut builder.*, &ty, origin)
        run assign(&mut builder.*, place(output), Rvalue.Use {value: Operand.Copy {place: move stored}}, origin)
        return Operand.Move {place: place(output)}
      }
      let selected = run materializeEmbedded(&mut builder.*, &value, &ty, origin)
      return match move selected {
        Option<Operand>.Some {value: operand} => move operand
        Option<Operand>.None => run unsupported(&owner, origin, GapCode.TypedForm)
      }
    }
    // One read of a foreign C object lands in a temporary; its symbol is a separate C edge.
    View.ForeignAddress {declaration, symbol, ty, origin} => {
      let key = InstanceKey.Export {function: move declaration, symbol: move symbol}
      run List<Reference>.append(&mut builder.*.function.references, Reference {key: InstanceKey.copy(&key), edge: Edge.Direct, origin: origin})
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.FunctionAddress {key: move key}, origin)
      return Operand.Copy {place: place(output)}
    }
    View.ForeignStatic {declaration, ty, origin} => {
      run List<Interned<DeclarationId>>.append(&mut builder.*.function.externs, Interned<DeclarationId>.clone(&declaration))
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.ForeignStatic {declaration: move declaration, address: false}, origin)
      return Operand.Copy {place: place(output)}
    }
    View.Local {index, ty, origin} => {
      // The same holds for a whole live local owner (OWN-002).
      let held = ownerIndex(&builder.*, index + usize.ONE)
      if held != usize.MAX && !ownerEnded(&builder.*, held) {
        return run unsupported(&owner, origin, GapCode.OwnedBindingRead)
      }
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(
        &mut builder.*,
        place(output),
        Rvalue.Use {value: Operand.Copy {place: place(index + usize.ONE)}},
        origin,
      )
      return Operand.Copy {place: place(output)}
    }
    View.Move {value, release, ty, origin} => {
      // Typing rejects a projection out of an owned rvalue (OWN0002), so a release names a place or
      // a fresh value.
      let needed = CleanupNeeds.node(&builder.needs, value.index)
      let input = run consumedOperand(&mut builder.*, body, hir, value)
      run applyRelease(&mut builder.*, &release, needed, origin)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Use {value: move input}, origin)
      return Operand.Move {place: place(output)}
    }
    View.ArrayLength {value, count, ty, ..} => {
      let evaluated = run expressionPlace(&mut builder.*, body, hir, value)
      drop evaluated
      return Operand.Integer {decimal: run Type.extentText(count), negative: false, ty: move ty}
    }
    View.ArrayRepeat {value, count, ty, origin} => run arrayRepeat(&mut builder.*, body, hir, value, count, &ty, origin)
    View.ArraySlice {value, count, ty, origin} => {
      let data = run expression(&mut builder.*, body, hir, value)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Slice {data: move data, count: run usizeOperand(usize.toU64(count))}, origin)
      return Operand.Copy {place: place(output)}
    }
    View.SliceLength {value, ty, origin} => {
      let descriptor = run expressionPlace(&mut builder.*, body, hir, value)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.SliceLength {place: move descriptor}, origin)
      return Operand.Copy {place: place(output)}
    }
    View.Index {ty, origin, ..} => {
      // Reading an element only views its subject, so a constant subject is read from its
      // program-lifetime storage instead of being built on the stack at every read (#2461).
      let projected = run sharedPlace(&mut builder.*, body, hir, id)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Use {value: Operand.Copy {place: move projected}}, origin)
      return Operand.Copy {place: place(output)}
    }
    View.Field {ty, origin, ..} => {
      let projected = run expressionPlace(&mut builder.*, body, hir, id)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(
        &mut builder.*,
        place(output),
        Rvalue.Use {value: Operand.Copy {place: move projected}},
        origin,
      )
      return Operand.Copy {place: place(output)}
    }
    View.Aggregate {node, count, ty, origin} => {
      let fields = run aggregateFields(&mut builder.*, body, hir, node, count, origin)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Aggregate {fields: move fields}, origin)
      return Operand.Move {place: place(output)}
    }
    View.StagedCallable {node, count, ty, origin} => {
      let fields = run stagedCallableFields(&mut builder.*, body, hir, node, count, origin)
      if !builder.live { return Operand.Unit }
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Aggregate {fields: move fields}, origin)
      return Operand.Move {place: place(output)}
    }
    View.Dereference {ty, origin, ..} => {
      let projected = run expressionPlace(&mut builder.*, body, hir, id)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(
        &mut builder.*,
        place(output),
        Rvalue.Use {value: Operand.Copy {place: move projected}},
        origin,
      )
      return Operand.Copy {place: place(output)}
    }
    View.Borrow {access, value, ty, origin} => {
      // A shared borrow of a C object is its symbol's address, not a borrow of a copy.
      if access == Access.Shared {
        if let View.ForeignStatic {declaration, ..} = run instanceView(&mut builder.*, body, value) {
          run List<Interned<DeclarationId>>.append(&mut builder.*.function.externs, Interned<DeclarationId>.clone(&declaration))
          let output = run temporary(&mut builder.*, &ty, origin)
          run assign(&mut builder.*, place(output), Rvalue.ForeignStatic {declaration: move declaration, address: true}, origin)
          return Operand.Copy {place: place(output)}
        }
      }
      let mut borrowed = Place {local: usize.ZERO, projections: List<Projection>.make()}
      if access == Access.Shared {
        borrowed = run sharedPlace(&mut builder.*, body, hir, value)
      } else {
        borrowed = run expressionPlace(&mut builder.*, body, hir, value)
      }
      let output = run temporary(&mut builder.*, &ty, origin)
      if let Option<Interned<Type>>.Some {..} = move Type.sliceElement(&ty) {
        run assign(&mut builder.*, place(output), Rvalue.Use {value: Operand.Copy {place: move borrowed}}, origin)
        return Operand.Copy {place: place(output)}
      }
      // Reborrowing a lent exclusive view normalizes to the lender reference it already holds
      // (see `Type.callableView`), so the runtime value is a copy of that reference.
      let lender = run instanceNodeType(&builder.*, body, value)
      if let Option<Interned<Type>>.Some {value: lent} = move lender {
        let held = viewStorage(&lent)
        if Interned<Type>.with<bool>(&held, exclusiveLender) && run Type.runtimeEqualsShared(&viewStorage(&ty), &held) {
          run assign(&mut builder.*, place(output), Rvalue.Use {value: Operand.Copy {place: move borrowed}}, origin)
          return Operand.Copy {place: place(output)}
        }
      }
      run assign(
        &mut builder.*,
        place(output),
        Rvalue.Ref {access: access, place: move borrowed},
        origin,
      )
      return Operand.Copy {place: place(output)}
    }
    View.Prefix {operation, operand, ty, origin} => {
      let input = run expression(&mut builder.*, body, hir, operand)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(
        &mut builder.*,
        place(output),
        Rvalue.Unary {operation: operation, value: move input},
        origin,
      )
      return Operand.Copy {place: place(output)}
    }
    View.Infix {operation, left, right, ty, origin} => {
      if operation == InfixOperator.And || operation == InfixOperator.Or {
        return run shortCircuit(&mut builder.*, body, hir, operation, left, right, &ty, origin)
      }
      // `string` compares exact UTF-8 bytes, independently of descriptor identity (TEXT-001), and a
      // byte slice compares its bytes the same way.
      let leftType = run instanceNodeType(&builder.*, body, left)
      if let Option<Interned<Type>>.Some {value: operand} = move leftType {
        if Interned<Type>.with<bool>(&operand, byteView) {
          return run stringComparison(&mut builder.*, body, hir, operation, left, right, &operand, &ty, origin)
        }
      }
      return run infixChain(&mut builder.*, body, hir, InfixLink {operation: operation, right: right, ty: move ty, origin: origin}, left)
    }
    View.EnumMember {member, ty, origin} => {
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Use {value: run enumOperand(member, &ty)}, origin)
      return Operand.Copy {place: place(output)}
    }
    View.EnumValue {value, ty, origin} => {
      let input = run expression(&mut builder.*, body, hir, value)
      let output = run temporary(&mut builder.*, &ty, origin)
      // A scalar enum has its representation's layout (ENUM-003), so the backing integer keeps its bits.
      run assign(&mut builder.*, place(output), Rvalue.Use {value: move input}, origin)
      return Operand.Copy {place: place(output)}
    }
    View.Match {node, subject, place: placeMatch, consumes, release, tags, count, syntax, ty, origin} => {
      return run lowerMatch(&mut builder.*, body, hir, node, subject, placeMatch, consumes, &release, tags, count, syntax, &ty, origin)
    }
    View.VariantConstruct {node, tag, count, ty, origin} => {
      let fields = run aggregateFields(&mut builder.*, body, hir, node, count, origin)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Variant {tag: tag, fields: move fields}, origin)
      return Operand.Move {place: place(output)}
    }
    View.UnionInject {value, ty, origin} => {
      // The injected value's own instance type finds its place in the instance's storage.
      let member = match move run instanceNodeType(&builder.*, body, value) {
        Option<Interned<Type>>.Some {value: injected} => move injected
        Option<Interned<Type>>.None => CompilerBug.panic(b"an injected union member has no type")
      }
      let placed = match move run UnionProjection.within(&ty, &member) {
        Option<UnionPlacement>.Some {value: found} => move found
        Option<UnionPlacement>.None => CompilerBug.panic(b"an injected value is not a member of its union")
      }
      let input = run expression(&mut builder.*, body, hir, value)
      if !builder.live { return Operand.Unit }
      let output = run temporary(&mut builder.*, &ty, origin)
      match move placed {
        UnionPlacement.Whole => run assign(&mut builder.*, place(output), Rvalue.Use {value: move input}, origin)
        UnionPlacement.Tagged {tag: physical, ..} => run assign(&mut builder.*, place(output),
          Rvalue.Inject {tag: physical, value: move input}, origin)
        // A member written as a type parameter can be instantiated with a union (`E | Late` with
        // `E = Broken | Lost`): its value is widened member by member, as an explicit widening is.
        UnionPlacement.Spread {ty: memberType, ..} => {
          let held = run temporary(&mut builder.*, &memberType, origin)
          run assign(&mut builder.*, place(held), Rvalue.Use {value: move input}, origin)
          run widenInto(&mut builder.*, held, &memberType, output, origin)
        }
      }
      return Operand.Move {place: place(output)}
    }
    View.UnionWiden {value, ty, origin} => {
      let from = match move run instanceNodeType(&builder.*, body, value) {
        Option<Interned<Type>>.Some {value: sourceType} => move sourceType
        Option<Interned<Type>>.None => CompilerBug.panic(b"a widened union operand has no type")
      }
      let input = run expression(&mut builder.*, body, hir, value)
      if !builder.live { return Operand.Unit }
      let held = run temporary(&mut builder.*, &from, origin)
      run assign(&mut builder.*, place(held), Rvalue.Use {value: move input}, origin)
      let output = run temporary(&mut builder.*, &ty, origin)
      run widenInto(&mut builder.*, held, &from, output, origin)
      return Operand.Move {place: place(output)}
    }
    View.PatternBinding {node: read, subject, ty, origin} => {
      // Copying a binding its live owner still drops would release it twice. Ownership transfers
      // only through `move` (OWN-002, MATCH-002), which reads through `consumedOperand`.
      let held = run readOwner(&builder.*, body, read, subject, origin)
      if held != usize.MAX {
        return run unsupported(&owner, origin, GapCode.OwnedBindingRead)
      }
      let projected = run expressionPlace(&mut builder.*, body, hir, id)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Use {value: Operand.Copy {place: move projected}}, origin)
      return Operand.Copy {place: place(output)}
    }
    View.Intrinsic {member, node: callNode, ty, origin} => {
      if CheckedIntrinsic.isPrimitive(member, IntrinsicPrimitive.ObserveUnhandled) { return run observeSelected(&mut builder.*, &ty, 5, origin) }
      if CheckedIntrinsic.isPrimitive(member, IntrinsicPrimitive.ObserveHandled) { return run observeSelected(&mut builder.*, &ty, 7, origin) }
      if CheckedIntrinsic.isPrimitive(member, IntrinsicPrimitive.Trap) { return run trapText(&mut builder.*, body, hir, callNode, origin) }
      // Exact text equality is the language's `string` comparison (TEXT-001).
      if CheckedIntrinsic.isPrimitive(member, IntrinsicPrimitive.StringEqualsExact) {
        let left = match move childAt(body, callNode, usize.ZERO) {
          Option<BodyNodeId>.Some {value} => value
          Option<BodyNodeId>.None => run unsupported(&owner, origin, GapCode.MissingCallArgument)
        }
        let right = match move childAt(body, callNode, usize.ONE) {
          Option<BodyNodeId>.Some {value} => value
          Option<BodyNodeId>.None => run unsupported(&owner, origin, GapCode.MissingCallArgument)
        }
        let text = match move run instanceNodeType(&builder.*, body, left) {
          Option<Interned<Type>>.Some {value} => move value
          Option<Interned<Type>>.None => run unsupported(&owner, origin, GapCode.TypedForm)
        }
        return run stringComparison(&mut builder.*, body, hir, InfixOperator.Equals, left, right, &text, &ty, origin)
      }
      if let Option<ScalarOperation>.Some {value: checked} = move checkedOperation(member) {
        return run checkedScalar(&mut builder.*, body, hir, callNode, checked, &ty, origin)
      }
      let operation = run intrinsicRvalue(&mut builder.*, body, hir, callNode, member, &ty, origin)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), move operation, origin)
      return Operand.Copy {place: place(output)}
    }
    View.Call {environment, foreign, variadicArguments, count, node: callNode, ty: checkedType, origin} => {
      // An ordinary callee returns the Effect its contract promises; the call runs it (EFF-005).
      let returned = returnedEffect(&builder.*, callNode)
      let returnsEffect = match &returned { Option<Interned<Type>>.Some {..} => true _ => false }
      let ty = match move returned {
        Option<Interned<Type>>.Some {value} => move value
        Option<Interned<Type>>.None => move checkedType
      }
      if environment {
        if let Option<CallableCallInputs>.Some {value: input} = move TypedBody.callableCall(body, callNode) {
          let receiver = run instanceNodeType(&builder.*, body, input.callee)
          if let Option<Interned<Type>>.Some {value: pointer} = move receiver {
            let signature = Interned<Type>.with<Option<Interned<Type>>>(&pointer, nativePointerSignature)
            if let Option<Interned<Type>>.Some {value: contract} = move signature {
              return run nativeIndirectCall(&mut builder.*, body, hir, callNode, input.callee, count, &ty, move contract, origin)
            }
          }
        }
      }
      // An interface operation a scalar intrinsic implements runs that operation in place.
      if let Option<IntrinsicMember>.Some {value: witnessed} = move witnessIntrinsic(&builder.*, callNode) {
        let operation = run intrinsicRvalue(&mut builder.*, body, hir, callNode, witnessed, &ty, origin)
        let output = run temporary(&mut builder.*, &ty, origin)
        run assign(&mut builder.*, place(output), move operation, origin)
        return Operand.Copy {place: place(output)}
      }
      // Invoking an `effect fn` value without `run` constructs its target's exact Effect: the
      // value's stored arguments and the supplied operands, in target parameter order (EFF-001).
      if environment && !returnsEffect && invokedConstruction(body, callNode) {
        // An invocation that only borrows its anonymous callee stores no exact Effect; only its run
        // executes it.
        if Interned<Type>.with<bool>(&ty, effectContract) { return run unsupported(&owner, origin, GapCode.EffectForm) }
        let mut values = run callArguments(&mut builder.*, body, hir, callNode, count, true, &foreign, origin)
        if !builder.live { return Operand.Unit }
        let mut fields = List<AggregateField>.make()
        let mut at = usize.ZERO
        while List<Operand>.length(&values) > usize.ZERO {
          run List<AggregateField>.append(&mut fields, AggregateField {index: at, value: List<Operand>.remove(&mut values, usize.ZERO)})
          at = at + usize.ONE
        }
        let constructed = run temporary(&mut builder.*, &ty, origin)
        run assign(&mut builder.*, place(constructed), Rvalue.Aggregate {fields: move fields}, origin)
        return Operand.Move {place: place(constructed)}
      }
      // Constructing an Effect stores its written arguments as its environment; nothing runs (D1).
      if !environment && constructionCall(body, callNode, &ty) {
        let mut fields = List<AggregateField>.make()
        let mut at = usize.ZERO
        while at < count {
          let child = match move childAt(body, callNode, at) {
            Option<BodyNodeId>.Some {value} => value
            Option<BodyNodeId>.None => { return run unsupported(&owner, origin, GapCode.MissingCallArgument) }
          }
          let stored = run expression(&mut builder.*, body, hir, child)
          if !builder.live { return Operand.Unit }
          run List<AggregateField>.append(&mut fields, AggregateField {index: at, value: move stored})
          at = at + usize.ONE
        }
        let constructed = run temporary(&mut builder.*, &ty, origin)
        run assign(&mut builder.*, place(constructed), Rvalue.Aggregate {fields: move fields}, origin)
        return Operand.Move {place: place(constructed)}
      }
      let mut values = run callArguments(&mut builder.*, body, hir, callNode, count, environment, &foreign, origin)
      if !builder.live { return Operand.Unit }
      if environment {
        let prepared = run preparedOperands(&builder.*, callNode)
        run widenCallOperands(&mut builder.*, List<CallOperand>.asSlice(&prepared), &mut values, origin)
      }
      let output = run temporary(&mut builder.*, &ty, origin)
      let continuation = run block(&mut builder.*, origin)
      let target = run callCallee(&mut builder.*, move foreign, move variadicArguments, callNode, &owner, origin)
      let providers = run targetProviders(&mut builder.*, callNode, origin)
      let diagnostics = run calleeDiagnostics(&builder.*, &target, origin)
      run noteCancel(&mut builder.*, &target, origin)
      terminate(
        &mut builder.*,
        Terminator.Call {
          callee: move target,
          arguments: move values,
          providers: move providers,
          diagnostics: move diagnostics,
          destination: place(output),
          normal: continuation,
          failure: Option<FailureEdge>.none(),
          origin: origin,
        },
      )
      return continueAfter(&mut builder.*, continuation, output, &ty, origin)
    }
    View.Storage {operation, node: callNode, ty, origin} => run lowerStorage(&mut builder.*, body, hir, callNode, operation, &ty, origin)
    View.Run {value, ty, origin} => run lowerRun(&mut builder.*, body, hir, id, value, &ty, origin)
    View.Unsupported {origin} => run unsupported(&owner, origin, GapCode.TypedForm)
    _ => run unsupported(
      &owner,
      Origin {node: usize.ZERO, location: Location.generated()},
      GapCode.ExpectedExpression,
    )
  }
}

// Lowers argument `index` of an intrinsic call in source order, like an ordinary call argument.
effect fn intrinsicArgument(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  callNode: BodyNodeId,
  index: usize,
  origin: Origin,
) -> Operand ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let child = match move childAt(body, callNode, index) {
    Option<BodyNodeId>.Some {value} => value
    Option<BodyNodeId>.None => run unsupported(&owner, origin, GapCode.MissingCallArgument)
  }
  return run expression(&mut builder.*, body, hir, child)
}

// Lowers one scalar operand, reading a borrowed operand's referent before a later argument can
// change it.
effect fn scalarOperand(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  callNode: BodyNodeId,
  index: usize,
  operation: ScalarOperation,
  origin: Origin,
) -> Operand ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let input = run intrinsicArgument(&mut builder.*, body, hir, callNode, index, origin)
  if !ScalarOperation.borrows(operation) { return move input }
  let owner = InstanceKey.identity(&builder.function.key)
  let mut borrowed = run operandPlace(&owner, move input, origin)
  run List<Projection>.append(&mut borrowed.projections, Projection.Deref)
  let ty = run CheckedIntrinsic.scalarType(ScalarOperation.operand(operation))
  let output = run temporary(&mut builder.*, &ty, origin)
  run assign(&mut builder.*, place(output), Rvalue.Use {value: Operand.Copy {place: move borrowed}}, origin)
  return Operand.Copy {place: place(output)}
}

effect fn intrinsicRvalue(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  callNode: BodyNodeId,
  member: IntrinsicMember,
  ty: &Interned<Type>,
  origin: Origin,
) -> Rvalue ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  return match member {
    IntrinsicMember.Scalar {operation} => run scalarRvalue(&mut builder.*, body, hir, callNode, operation, ty, origin)
    IntrinsicMember.Primitive {primitive} => run primitiveRvalue(&mut builder.*, body, hir, callNode, primitive, ty, origin)
  }
}

// The MIR operation of a scalar intrinsic with no source operator, if it has one.
fn scalarBinary(code: ScalarCode) -> Option<ScalarBinary> {
  return match code {
    ScalarCode.ShiftLeft => Option<ScalarBinary>.some(ScalarBinary.ShiftLeft)
    ScalarCode.ShiftRight => Option<ScalarBinary>.some(ScalarBinary.ShiftRight)
    ScalarCode.RotateLeft => Option<ScalarBinary>.some(ScalarBinary.RotateLeft)
    ScalarCode.RotateRight => Option<ScalarBinary>.some(ScalarBinary.RotateRight)
    ScalarCode.WrappingAdd => Option<ScalarBinary>.some(ScalarBinary.WrappingAdd)
    ScalarCode.WrappingSubtract => Option<ScalarBinary>.some(ScalarBinary.WrappingSubtract)
    ScalarCode.WrappingMultiply => Option<ScalarBinary>.some(ScalarBinary.WrappingMultiply)
    ScalarCode.SaturatingAdd => Option<ScalarBinary>.some(ScalarBinary.SaturatingAdd)
    ScalarCode.SaturatingSubtract => Option<ScalarBinary>.some(ScalarBinary.SaturatingSubtract)
    ScalarCode.SaturatingMultiply => Option<ScalarBinary>.some(ScalarBinary.SaturatingMultiply)
    ScalarCode.MultiplyHigh => Option<ScalarBinary>.some(ScalarBinary.MultiplyHigh)
    ScalarCode.TotalOrder => Option<ScalarBinary>.some(ScalarBinary.TotalOrder)
    _ => Option<ScalarBinary>.none()
  }
}

fn scalarUnary(code: ScalarCode) -> Option<ScalarUnary> {
  return match code {
    ScalarCode.IsNaN => Option<ScalarUnary>.some(ScalarUnary.IsNaN)
    ScalarCode.IsInfinite => Option<ScalarUnary>.some(ScalarUnary.IsInfinite)
    ScalarCode.IsFinite => Option<ScalarUnary>.some(ScalarUnary.IsFinite)
    ScalarCode.IsNormal => Option<ScalarUnary>.some(ScalarUnary.IsNormal)
    ScalarCode.IsSubnormal => Option<ScalarUnary>.some(ScalarUnary.IsSubnormal)
    ScalarCode.IsSignNegative => Option<ScalarUnary>.some(ScalarUnary.IsSignNegative)
    ScalarCode.Sqrt => Option<ScalarUnary>.some(ScalarUnary.Sqrt)
    _ => Option<ScalarUnary>.none()
  }
}

// Scalar intrinsics with a source operator reuse it; the rest select one scalar MIR operation.
// Negations without an operator subtract from zero with their own overflow policy.
effect fn scalarRvalue(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  callNode: BodyNodeId,
  operation: ScalarOperation,
  ty: &Interned<Type>,
  origin: Origin,
) -> Rvalue ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let first = run scalarOperand(&mut builder.*, body, hir, callNode, usize.ZERO, operation, origin)
  if ScalarOperation.arity(operation) == usize.ONE {
    if let Option<PrefixOperator>.Some {value: prefix} = move ScalarOperation.prefix(operation) {
      return Rvalue.Unary {operation: prefix, value: move first}
    }
    if let Option<ScalarUnary>.Some {value: unary} = move scalarUnary(operation.code) {
      return Rvalue.ScalarUnary {operation: unary, value: move first}
    }
    if operation.code == ScalarCode.WrappingNegate || operation.code == ScalarCode.SaturatingNegate {
      let zero = Operand.Integer {decimal: run Bytes.copy(b"0"), negative: false, ty: Interned<Type>.clone(ty)}
      let mut subtract = ScalarBinary.WrappingSubtract
      if operation.code == ScalarCode.SaturatingNegate { subtract = ScalarBinary.SaturatingSubtract }
      return Rvalue.ScalarBinary {operation: subtract, left: move zero, right: move first}
    }
    if operation.code == ScalarCode.ToBits || operation.code == ScalarCode.FromBits {
      return Rvalue.Bitcast {value: move first, ty: Interned<Type>.clone(ty)}
    }
    if operation.code == ScalarCode.Convert {
      return Rvalue.Convert {value: move first, ty: Interned<Type>.clone(ty)}
    }
    return run unsupported(&owner, origin, GapCode.IntrinsicMember)
  }
  let second = run scalarOperand(&mut builder.*, body, hir, callNode, usize.ONE, operation, origin)
  if let Option<InfixOperator>.Some {value: infix} = move ScalarOperation.infix(operation) {
    return Rvalue.Binary {operation: infix, left: move first, right: move second}
  }
  if let Option<ScalarBinary>.Some {value: binary} = move scalarBinary(operation.code) {
    return Rvalue.ScalarBinary {operation: binary, left: move first, right: move second}
  }
  return run unsupported(&owner, origin, GapCode.IntrinsicMember)
}

// The instance type of argument `index` of an intrinsic call.
effect fn intrinsicArgumentType(builder: &Builder, body: &Shared<TypedBody>, callNode: BodyNodeId, index: usize) -> Option<Interned<Type>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  return match move childAt(body, callNode, index) {
    Option<BodyNodeId>.Some {value: child} => run instanceNodeType(&builder.*, body, child)
    Option<BodyNodeId>.None => Option<Interned<Type>>.none()
  }
}

// Continues only when `condition` holds; otherwise the program traps for `reason`.
effect fn trapUnless(builder: &mut Builder, condition: Operand, reason: TrapReason, origin: Origin) -> ()
! OutOfMemoryError ? &mut Allocator {
  let safe = run block(&mut builder.*, origin)
  let trap = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: move condition, thenBlock: safe, elseBlock: trap, origin: origin})
  resume(&mut builder.*, trap)
  run trapHere(&mut builder.*, reason, origin)
  resume(&mut builder.*, safe)
  return ()
}

// `trap(reason)` ends the current block with a trap that reports the source's reason text,
// recording the site label an observed trap reports (event 6, TERM-008).
effect fn trapText(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, callNode: BodyNodeId, origin: Origin) -> Operand
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let argument = match move childAt(body, callNode, usize.ZERO) {
    Option<BodyNodeId>.Some {value} => value
    Option<BodyNodeId>.None => run unsupported(&owner, origin, GapCode.MissingCallArgument)
  }
  let reason = run expression(&mut builder.*, body, hir, argument)
  if !builder.live { return Operand.Unit }
  run recordTrapSite(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.TrapText {reason: move reason, origin: origin})
  return Operand.Unit
}

// Ends the current block with a trap for `reason`, recording the site label an observed trap
// reports (event 6, N7).
effect fn trapHere(builder: &mut Builder, reason: TrapReason, origin: Origin) -> () ! OutOfMemoryError ? &mut Allocator {
  if !builder.live { return () }
  run recordTrapSite(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Trap {reason: reason, origin: origin})
  return ()
}

effect fn primitiveRvalue(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  callNode: BodyNodeId,
  primitive: IntrinsicPrimitive,
  ty: &Interned<Type>,
  origin: Origin,
) -> Rvalue ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  // A null pointer has no argument.
  if primitive == IntrinsicPrimitive.PointerNull || primitive == IntrinsicPrimitive.PointerNullFunction {
    return Rvalue.Use {value: Operand.Null {ty: Interned<Type>.clone(ty)}}
  }
  if primitive == IntrinsicPrimitive.FrameAddress { return Rvalue.FrameAddress }
  if primitive == IntrinsicPrimitive.ProcessWord { return Rvalue.ProcessWord }
  if primitive == IntrinsicPrimitive.WasmMemorySize || primitive == IntrinsicPrimitive.WasmMemoryGrow ||
    primitive == IntrinsicPrimitive.WasmAtomicWait32 || primitive == IntrinsicPrimitive.WasmAtomicNotify {
    let count = CheckedIntrinsic.arity(IntrinsicMember.Primitive {primitive: primitive})
    let mut operands = List<Operand>.make()
    let mut at = usize.ZERO
    while at < count {
      run List<Operand>.append(&mut operands, run intrinsicArgument(&mut builder.*, body, hir, callNode, at, origin))
      at = at + usize.ONE
    }
    return Rvalue.Wasm {primitive: primitive, operands: move operands}
  }
  if primitive == IntrinsicPrimitive.Assembly {
    return run assembly(&mut builder.*, body, hir, callNode, ty, origin)
  }
  if CheckedIntrinsic.isAtomic(IntrinsicMember.Primitive {primitive: primitive}) {
    return run atomic(&mut builder.*, body, hir, callNode, primitive, origin)
  }
  if CheckedIntrinsic.isVector(IntrinsicMember.Primitive {primitive: primitive}) {
    return run vector(&mut builder.*, body, hir, callNode, primitive, ty, origin)
  }
  let first = run intrinsicArgument(&mut builder.*, body, hir, callNode, usize.ZERO, origin)
  return match primitive {
    IntrinsicPrimitive.PointerFromSlice => Rvalue.SliceData {place: run operandPlace(&owner, move first, origin)}
    IntrinsicPrimitive.PointerFromMutSlice => Rvalue.SliceData {place: run operandPlace(&owner, move first, origin)}
    // Address formation keeps the referent's address and representation.
    IntrinsicPrimitive.PointerFromRef => Rvalue.Use {value: move first}
    IntrinsicPrimitive.PointerFromMutRef => Rvalue.Use {value: move first}
    // Qualifier changes keep the address and representation.
    IntrinsicPrimitive.PointerRequalify => Rvalue.Use {value: move first}
    IntrinsicPrimitive.PointerReinterpret => Rvalue.Use {value: move first}
    IntrinsicPrimitive.PointerBytes => Rvalue.Use {value: move first}
    IntrinsicPrimitive.PointerAddress => Rvalue.AddressIntegerConversion {operand: move first, destinationType: Interned<Type>.clone(ty)}
    IntrinsicPrimitive.PointerIsNull => {
      let pointer = match move run intrinsicArgumentType(&builder.*, body, callNode, usize.ZERO) {
        Option<Interned<Type>>.Some {value} => move value
        Option<Interned<Type>>.None => run unsupported(&owner, origin, GapCode.TypedForm)
      }
      return Rvalue.Binary {operation: InfixOperator.Equals, left: move first, right: Operand.Null {ty: move pointer}}
    }
    IntrinsicPrimitive.PointerRead => {
      let mut read = run operandPlace(&owner, move first, origin)
      run List<Projection>.append(&mut read.projections, Projection.Deref)
      return Rvalue.Use {value: Operand.Copy {place: move read}}
    }
    // The value moves out bit for bit; the caller owns it and the storage keeps no drop obligation.
    IntrinsicPrimitive.PointerTake => {
      let mut read = run operandPlace(&owner, move first, origin)
      run List<Projection>.append(&mut read.projections, Projection.Deref)
      return Rvalue.Use {value: Operand.Copy {place: move read}}
    }
    // A reference has the pointer's address and representation; the anchor only names the loan.
    IntrinsicPrimitive.PointerBorrow => Rvalue.Use {value: run intrinsicArgument(&mut builder.*, body, hir, callNode, usize.ONE, origin)}
    IntrinsicPrimitive.PointerBorrowMut => Rvalue.Use {value: run intrinsicArgument(&mut builder.*, body, hir, callNode, usize.ONE, origin)}
    // A slice descriptor of the pointer and the count, unchecked: the caller proves the range.
    IntrinsicPrimitive.PointerBorrowMany => Rvalue.Slice {data: run intrinsicArgument(&mut builder.*, body, hir, callNode, usize.ONE, origin),
      count: run intrinsicArgument(&mut builder.*, body, hir, callNode, 2, origin)}
    IntrinsicPrimitive.PointerBorrowManyMut => Rvalue.Slice {data: run intrinsicArgument(&mut builder.*, body, hir, callNode, usize.ONE, origin),
      count: run intrinsicArgument(&mut builder.*, body, hir, callNode, 2, origin)}
    IntrinsicPrimitive.PointerReadUnaligned => {
      let mut read = run operandPlace(&owner, move first, origin)
      run List<Projection>.append(&mut read.projections, Projection.Deref)
      return Rvalue.Use {value: Operand.Copy {place: move read}}
    }
    IntrinsicPrimitive.PointerWrite => run pointerWrite(&mut builder.*, body, hir, callNode, move first, origin)
    IntrinsicPrimitive.PointerWriteUnaligned => run pointerWrite(&mut builder.*, body, hir, callNode, move first, origin)
    IntrinsicPrimitive.PointerAt => run pointerAt(&mut builder.*, body, hir, callNode, move first, ty, origin)
    IntrinsicPrimitive.PointerAtMut => run pointerAt(&mut builder.*, body, hir, callNode, move first, ty, origin)
    IntrinsicPrimitive.SliceView => run sliceView(&mut builder.*, body, hir, callNode, move first, ty, origin)
    IntrinsicPrimitive.StackAllocate => {
      let element = match move Interned<Type>.with<Option<Interned<Type>>>(ty, pointeeOf) {
        Option<Interned<Type>>.Some {value} => move value
        Option<Interned<Type>>.None => run unsupported(&owner, origin, GapCode.TypedForm)
      }
      return Rvalue.StackAllocate {count: move first, element: move element}
    }
    _ => run unsupported(&owner, origin, GapCode.IntrinsicMember)
  }
}

// One atomic operation: its runtime operands in written order, then its static orderings. A
// generic caller's element is checked here, once its instance fixes it.
effect fn atomic(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  callNode: BodyNodeId,
  primitive: IntrinsicPrimitive,
  origin: Origin,
) -> Rvalue ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let selected = IntrinsicMember.Primitive {primitive: primitive}
  let start = match move CheckedIntrinsic.orderingStart(selected) {
    Option<usize>.Some {value} => value
    Option<usize>.None => run unsupported(&owner, origin, GapCode.IntrinsicMember)
  }
  let mut operands = List<Operand>.make()
  let mut at = usize.ZERO
  while at < start {
    let lowered = run intrinsicArgument(&mut builder.*, body, hir, callNode, at, origin)
    run List<Operand>.append(&mut operands, move lowered)
    at = at + usize.ONE
  }
  let constants = List<ConstantValue>.asSlice(&builder.constants)
  let success = run intrinsicOrder(&owner, body, constants, callNode, start, origin)
  let mut failure = success
  if CheckedIntrinsic.orderingCount(selected) == 2 { failure = run intrinsicOrder(&owner, body, constants, callNode, start + usize.ONE, origin) }
  let mut element = run Types.intern(Type.Unit)
  if start != usize.ZERO {
    let pointer = match move run intrinsicArgumentType(&builder.*, body, callNode, usize.ZERO) {
      Option<Interned<Type>>.Some {value} => move value
      Option<Interned<Type>>.None => run unsupported(&owner, origin, GapCode.TypedForm)
    }
    element = match move Interned<Type>.with<Option<Interned<Type>>>(&pointer, fn(value: &Type) -> Option<Interned<Type>> {
      return match &value.* {
        Type.Pointer {pointee, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&pointee))
        _ => Option<Interned<Type>>.none()
      }
    }) {
      Option<Interned<Type>>.Some {value} => move value
      Option<Interned<Type>>.None => run unsupported(&owner, origin, GapCode.TypedForm)
    }
    let admitted = Interned<Type>.with<bool>(&element, fn(value: &Type) -> bool { return CheckedIntrinsic.admitsElement(selected, value) })
    if !admitted { run unsupported(&owner, origin, GapCode.IntrinsicMember) }
  }
  return Rvalue.Atomic {primitive: primitive, operands: move operands, success: success, failure: failure, element: move element}
}

// One SIMD vector operation, whose result is `ty`. Integer lane arithmetic and the square root
// reuse the scalar rvalues, which apply lane by lane; a conversion is the scalar conversion. A
// lane index is checked against the lane count once every argument is evaluated, and a slice
// load or store checks its lane range before it addresses the slice's elements.
effect fn vector(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  callNode: BodyNodeId,
  primitive: IntrinsicPrimitive,
  ty: &Interned<Type>,
  origin: Origin,
) -> Rvalue ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let form = match move CheckedIntrinsic.vectorForm(primitive) {
    Option<VectorForm>.Some {value} => value
    Option<VectorForm>.None => run unsupported(&owner, origin, GapCode.IntrinsicMember)
  }
  // The vector whose lane count bounds an index or a slice range.
  let mut over = Interned<Type>.clone(ty)
  if form == VectorForm.Extract {
    over = match move run intrinsicArgumentType(&builder.*, body, callNode, usize.ZERO) {
      Option<Interned<Type>>.Some {value} => move value
      Option<Interned<Type>>.None => run unsupported(&owner, origin, GapCode.TypedForm)
    }
  }
  if form == VectorForm.Store {
    over = match move run intrinsicArgumentType(&builder.*, body, callNode, 2) {
      Option<Interned<Type>>.Some {value} => move value
      Option<Interned<Type>>.None => run unsupported(&owner, origin, GapCode.TypedForm)
    }
  }
  let word = run storagePrimitive(b"usize")
  // A shuffle's operands are its two vectors, then one usize constant per result lane.
  if form == VectorForm.Shuffle {
    let mut shuffled = List<Operand>.make()
    run List<Operand>.append(&mut shuffled, run intrinsicArgument(&mut builder.*, body, hir, callNode, usize.ZERO, origin))
    run List<Operand>.append(&mut shuffled, run intrinsicArgument(&mut builder.*, body, hir, callNode, usize.ONE, origin))
    let indices = run shuffleIndices(&owner, body, List<ConstantValue>.asSlice(&builder.constants), callNode, origin)
    let listed = List<u64>.asSlice(&indices)
    let mut lane = usize.ZERO
    while lane < listed.length {
      run List<Operand>.append(&mut shuffled, Operand.Integer {decimal: run decimalBytes(listed[lane]), negative: false, ty: Interned<Type>.clone(&word)})
      lane = lane + usize.ONE
    }
    return Rvalue.Vector {primitive: primitive, operands: move shuffled, ty: Interned<Type>.clone(ty)}
  }
  let indexed = form == VectorForm.Extract || form == VectorForm.Insert || form == VectorForm.Load || form == VectorForm.Store
  let mut index = usize.MAX
  let mut operands = List<Operand>.make()
  let count = CheckedIntrinsic.arity(IntrinsicMember.Primitive {primitive: primitive})
  let mut at = usize.ZERO
  while at < count {
    let lowered = run intrinsicArgument(&mut builder.*, body, hir, callNode, at, origin)
    if indexed && at == usize.ONE {
      index = run storageValue(&mut builder.*, &word, Rvalue.Use {value: move lowered}, origin)
      run List<Operand>.append(&mut operands, Operand.Copy {place: place(index)})
    } else {
      run List<Operand>.append(&mut operands, move lowered)
    }
    at = at + usize.ONE
  }
  if !indexed {
    let mut listed = move operands
    if form == VectorForm.Binary {
      if let Option<ScalarBinary>.Some {value: operation} = move vectorScalarBinary(primitive) {
        let right = List<Operand>.remove(&mut listed, usize.ONE)
        let left = List<Operand>.remove(&mut listed, usize.ZERO)
        return Rvalue.ScalarBinary {operation: operation, left: move left, right: move right}
      }
    }
    if primitive == IntrinsicPrimitive.SimdSqrt {
      return Rvalue.ScalarUnary {operation: ScalarUnary.Sqrt, value: List<Operand>.remove(&mut listed, usize.ZERO)}
    }
    if primitive == IntrinsicPrimitive.SimdConvert {
      return Rvalue.Convert {value: List<Operand>.remove(&mut listed, usize.ZERO), ty: Interned<Type>.clone(ty)}
    }
    return Rvalue.Vector {primitive: primitive, operands: move listed, ty: Interned<Type>.clone(ty)}
  }
  let shape = match move Type.vectorShape(&over) {
    Option<ArrayShape>.Some {value} => move value
    Option<ArrayShape>.None => run unsupported(&owner, origin, GapCode.IntrinsicMember)
  }
  let lanes = Operand.Integer {decimal: run Type.extentText(shape.length), negative: false, ty: Interned<Type>.clone(&word)}
  if form == VectorForm.Extract || form == VectorForm.Insert {
    let bounded = run storageCondition(&mut builder.*, InfixOperator.LessThan, Operand.Copy {place: place(index)}, move lanes, origin)
    run trapUnless(&mut builder.*, move bounded, TrapReason.IndexOutOfBounds, origin)
    return Rvalue.Vector {primitive: primitive, operands: move operands, ty: Interned<Type>.clone(ty)}
  }
  // `offset <= length` and then `N <= length - offset`, so the subtraction cannot wrap.
  let mut listed = move operands
  let descriptor = run operandPlace(&owner, List<Operand>.remove(&mut listed, usize.ZERO), origin)
  let length = run storageValue(&mut builder.*, &word, Rvalue.SliceLength {place: run copyPlace(&descriptor)}, origin)
  let starts = run storageCondition(&mut builder.*, InfixOperator.LessOrEqual, Operand.Copy {place: place(index)},
    Operand.Copy {place: place(length)}, origin)
  run trapUnless(&mut builder.*, move starts, TrapReason.SliceRangeOutOfBounds, origin)
  let remaining = run storageValue(&mut builder.*, &word, Rvalue.Binary {operation: InfixOperator.Subtract,
    left: Operand.Copy {place: place(length)}, right: Operand.Copy {place: place(index)}}, origin)
  let fits = run storageCondition(&mut builder.*, InfixOperator.LessOrEqual, move lanes, Operand.Copy {place: place(remaining)}, origin)
  run trapUnless(&mut builder.*, move fits, TrapReason.SliceRangeOutOfBounds, origin)
  let mut access = Access.Shared
  if form == VectorForm.Store { access = Access.Mutable }
  let addressType = run Types.intern(Type.Pointer {pointee: Interned<Type>.clone(&shape.element), access: access,
    nullable: true, multiplicity: Multiplicity.Many, alignment: Option<u64>.none()})
  let data = run storageValue(&mut builder.*, &addressType, Rvalue.SliceData {place: move descriptor}, origin)
  let element = run storageValue(&mut builder.*, &addressType, Rvalue.PointerOffset {pointer: Operand.Copy {place: place(data)},
    index: Operand.Copy {place: place(index)}, element: Interned<Type>.clone(&shape.element)}, origin)
  let mut addressed = List<Operand>.make()
  run List<Operand>.append(&mut addressed, Operand.Copy {place: place(element)})
  if form == VectorForm.Load {
    return Rvalue.Vector {primitive: IntrinsicPrimitive.SimdPointerLoad, operands: move addressed, ty: Interned<Type>.clone(ty)}
  }
  run List<Operand>.append(&mut addressed, List<Operand>.remove(&mut listed, usize.ONE))
  return Rvalue.Vector {primitive: IntrinsicPrimitive.SimdPointerStore, operands: move addressed, ty: Interned<Type>.clone(ty)}
}

// The scalar operation an integer vector primitive applies to each lane.
fn vectorScalarBinary(primitive: IntrinsicPrimitive) -> Option<ScalarBinary> {
  let operation = match primitive {
    IntrinsicPrimitive.SimdWrappingAdd => ScalarBinary.WrappingAdd
    IntrinsicPrimitive.SimdWrappingSubtract => ScalarBinary.WrappingSubtract
    IntrinsicPrimitive.SimdWrappingMultiply => ScalarBinary.WrappingMultiply
    IntrinsicPrimitive.SimdSaturatingAdd => ScalarBinary.SaturatingAdd
    IntrinsicPrimitive.SimdSaturatingSubtract => ScalarBinary.SaturatingSubtract
    IntrinsicPrimitive.SimdShiftLeft => ScalarBinary.ShiftLeft
    IntrinsicPrimitive.SimdShiftRight => ScalarBinary.ShiftRight
    IntrinsicPrimitive.SimdRotateLeft => ScalarBinary.RotateLeft
    IntrinsicPrimitive.SimdRotateRight => ScalarBinary.RotateRight
    _ => { return Option<ScalarBinary>.none() }
  }
  return Option<ScalarBinary>.some(operation)
}

// The static value of one intrinsic argument node: a selected embedded value, or the published
// value of a constant it reads.
fn staticArgument(body: &Shared<TypedBody>, constants: &[ConstantValue], child: BodyNodeId) -> Option<Interned<StaticData>> {
  return Shared<TypedBody>.with<Option<Interned<StaticData>>>(body, fn(value: &TypedBody) -> Option<Interned<StaticData>> {
    return match &TypedBody.nodeSlice(value)[child.index].kind {
      BodyNodeKind.Expression {form: BodyExpression.Embedded {value: data}, ..} => Option<Interned<StaticData>>.some(Interned<StaticData>.clone(&data))
      BodyNodeKind.Expression {form: BodyExpression.Constant {declaration}, ..} => constantValue(constants, &declaration)
      _ => Option<Interned<StaticData>>.none()
    }
  })
}

// The memory ordering embedded as static intrinsic argument `index`.
// The checked static lane indices of a shuffle, its third argument (SIMD-006).
effect fn shuffleIndices(owner: &Interned<DeclarationId>, body: &Shared<TypedBody>, constants: &[ConstantValue], callNode: BodyNodeId,
  origin: Origin) -> List<u64>
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  let child = match move childAt(body, callNode, 2) {
    Option<BodyNodeId>.Some {value} => value
    Option<BodyNodeId>.None => run unsupported(owner, origin, GapCode.MissingCallArgument)
  }
  let data = match move staticArgument(body, constants, child) {
    Option<Interned<StaticData>>.Some {value} => move value
    Option<Interned<StaticData>>.None => run unsupported(owner, origin, GapCode.IntrinsicMember)
  }
  let count = Interned<StaticData>.with<usize>(&data, fn(selected: &StaticData) -> usize {
    return match &selected.* {
      StaticData.Aggregate {fields, ..} => List<Interned<StaticData>>.length(&fields)
      _ => usize.ZERO
    }
  })
  let mut indices = List<u64>.make()
  let mut at = usize.ZERO
  while at < count {
    let lane = at
    let index = Interned<StaticData>.with<u64>(&data, fn(selected: &StaticData) -> u64 {
      return match &selected.* {
        StaticData.Aggregate {fields, ..} => Interned<StaticData>.with<u64>(&List<Interned<StaticData>>.asSlice(&fields)[lane],
          fn(field: &StaticData) -> u64 {
            return match &field.* {
              StaticData.Integer {magnitude, ..} => magnitude
              _ => u64.MAX
            }
          })
        _ => u64.MAX
      }
    })
    if index == u64.MAX { run unsupported(owner, origin, GapCode.IntrinsicMember) }
    run List<u64>.append(&mut indices, index)
    at = at + usize.ONE
  }
  return move indices
}

effect fn intrinsicOrder(owner: &Interned<DeclarationId>, body: &Shared<TypedBody>, constants: &[ConstantValue], callNode: BodyNodeId,
  index: usize, origin: Origin) -> MemoryOrder
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  let child = match move childAt(body, callNode, index) {
    Option<BodyNodeId>.Some {value} => value
    Option<BodyNodeId>.None => run unsupported(owner, origin, GapCode.MissingCallArgument)
  }
  let order = match move staticArgument(body, constants, child) {
    Option<Interned<StaticData>>.Some {value: data} => Interned<StaticData>.with<Option<MemoryOrder>>(&data,
      fn(selected: &StaticData) -> Option<MemoryOrder> {
        return match &selected.* {
          StaticData.Text {bytes} => CheckedIntrinsic.memoryOrder(Bytes.asSlice(&bytes))
          _ => Option<MemoryOrder>.none()
        }
      })
    Option<Interned<StaticData>>.None => Option<MemoryOrder>.none()
  }
  return match move order {
    Option<MemoryOrder>.Some {value} => value
    Option<MemoryOrder>.None => run unsupported(owner, origin, GapCode.IntrinsicMember)
  }
}

// One checked machine fragment: its literal metadata and its operand tuple in written order. A
// no-return fragment is assigned here and its block ends unreachable.
effect fn assembly(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  callNode: BodyNodeId,
  ty: &Interned<Type>,
  origin: Origin,
) -> Rvalue ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let template = run assemblyText(&owner, body, &builder.anchor, hir, callNode, usize.ZERO, origin)
  let constraints = run assemblyText(&owner, body, &builder.anchor, hir, callNode, usize.ONE, origin)
  let clobbers = run assemblyText(&owner, body, &builder.anchor, hir, callNode, 2, origin)
  let written = run assemblyText(&owner, body, &builder.anchor, hir, callNode, 3, origin)
  let sideEffects = match move intrinsicFlag(body, callNode, 4) {
    Option<bool>.Some {value} => value
    Option<bool>.None => run unsupported(&owner, origin, GapCode.IntrinsicMember)
  }
  let noReturn = match move intrinsicFlag(body, callNode, 5) {
    Option<bool>.Some {value} => value
    Option<bool>.None => run unsupported(&owner, origin, GapCode.IntrinsicMember)
  }
  let memory = match move NativeAssembly.memory(Bytes.asSlice(&written)) {
    Option<AssemblyMemory>.Some {value} => value
    Option<AssemblyMemory>.None => run unsupported(&owner, origin, GapCode.IntrinsicMember)
  }
  let operandTuple = match move childAt(body, callNode, 6) {
    Option<BodyNodeId>.Some {value} => value
    Option<BodyNodeId>.None => run unsupported(&owner, origin, GapCode.MissingCallArgument)
  }
  let mut inputs = List<Operand>.make()
  let mut operand = usize.ZERO
  let mut remaining = true
  while remaining {
    if let Option<BodyNodeId>.Some {value: field} = move childAt(body, operandTuple, operand) {
      let lowered = run expression(&mut builder.*, body, hir, field)
      run List<Operand>.append(&mut inputs, move lowered)
      operand = operand + usize.ONE
    } else {
      remaining = false
    }
  }
  let parts = AssemblyFragment {
    template: move template, constraints: move constraints, clobbers: move clobbers, memory: memory,
    sideEffects: sideEffects, noReturn: noReturn, inputs: move inputs, ty: Interned<Type>.clone(ty),
  }
  let fragment = Rvalue.Assembly {fragment: run Box<AssemblyFragment>.make(move parts)}
  if !noReturn { return move fragment }
  let output = run temporary(&mut builder.*, ty, origin)
  run assign(&mut builder.*, place(output), move fragment, origin)
  terminate(&mut builder.*, Terminator.Unreachable {origin: origin})
  return Rvalue.Use {value: Operand.Unit}
}

// The decoded literal text written as intrinsic argument `index`.
effect fn assemblyText(owner: &Interned<DeclarationId>, body: &Shared<TypedBody>, anchor: &Anchor, hir: &Module, callNode: BodyNodeId,
  index: usize, origin: Origin) -> Bytes
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  let literal = match move intrinsicLiteral(body, anchor, callNode, index) {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => run unsupported(owner, origin, GapCode.IntrinsicMember)
  }
  return match Module.node(hir, literal) {
    HirNode.TextLiteral {value} => run Bytes.copy(Module.text(hir, value))
    _ => run unsupported(owner, origin, GapCode.IntrinsicMember)
  }
}

// The literal HIR text written as intrinsic argument `index`.
fn intrinsicLiteral(body: &Shared<TypedBody>, anchor: &Anchor, callNode: BodyNodeId, index: usize) -> Option<HirId> {
  let child = match move childAt(body, callNode, index) {
    Option<BodyNodeId>.Some {value} => value
    Option<BodyNodeId>.None => { return Option<HirId>.none() }
  }
  return Shared<TypedBody>.with<Option<HirId>>(body, fn(value: &TypedBody) -> Option<HirId> {
    return match &TypedBody.nodeSlice(value)[child.index].kind {
      BodyNodeKind.Expression {form: BodyExpression.Text {literal}, ..} => Option<HirId>.some(Anchor.hir(anchor, literal))
      _ => Option<HirId>.none()
    }
  })
}

// The literal Boolean written as intrinsic argument `index`.
fn intrinsicFlag(body: &Shared<TypedBody>, callNode: BodyNodeId, index: usize) -> Option<bool> {
  let child = match move childAt(body, callNode, index) {
    Option<BodyNodeId>.Some {value} => value
    Option<BodyNodeId>.None => { return Option<bool>.none() }
  }
  return Shared<TypedBody>.with<Option<bool>>(body, fn(value: &TypedBody) -> Option<bool> {
    return match &TypedBody.nodeSlice(value)[child.index].kind {
      BodyNodeKind.Expression {form: BodyExpression.Boolean {value: flag}, ..} => Option<bool>.some(flag)
      _ => Option<bool>.none()
    }
  })
}

// Stores the second argument through the first; the call's own value is unit.
effect fn pointerWrite(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  callNode: BodyNodeId,
  pointer: Operand,
  origin: Origin,
) -> Rvalue ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let value = run intrinsicArgument(&mut builder.*, body, hir, callNode, usize.ONE, origin)
  let mut written = run operandPlace(&owner, move pointer, origin)
  run List<Projection>.append(&mut written.projections, Projection.Deref)
  run assign(&mut builder.*, move written, Rvalue.Use {value: move value}, origin)
  return Rvalue.Use {value: Operand.Unit}
}

effect fn pointerAt(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  callNode: BodyNodeId,
  pointer: Operand,
  ty: &Interned<Type>,
  origin: Origin,
) -> Rvalue ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let index = run intrinsicArgument(&mut builder.*, body, hir, callNode, usize.ONE, origin)
  let element = match move Interned<Type>.with<Option<Interned<Type>>>(ty, pointeeOf) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => run unsupported(&owner, origin, GapCode.TypedForm)
  }
  return Rvalue.PointerOffset {pointer: move pointer, index: move index, element: move element}
}

// `sliceView(values, offset, length)` traps unless `offset <= values.length` and
// `length <= values.length - offset`, then describes `length` elements from `offset`.
effect fn sliceView(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  callNode: BodyNodeId,
  values: Operand,
  ty: &Interned<Type>,
  origin: Origin,
) -> Rvalue ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let offset = run intrinsicArgument(&mut builder.*, body, hir, callNode, usize.ONE, origin)
  let length = run intrinsicArgument(&mut builder.*, body, hir, callNode, 2, origin)
  let element = match move Type.sliceElement(ty) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => run unsupported(&owner, origin, GapCode.TypedForm)
  }
  let descriptor = run operandPlace(&owner, move values, origin)
  let word = run CheckedIntrinsic.scalarType(Scalar.Usize)
  let boolean = run CheckedIntrinsic.scalarType(Scalar.Bool)
  let count = run temporary(&mut builder.*, &word, origin)
  run assign(&mut builder.*, place(count), Rvalue.SliceLength {place: run copyPlace(&descriptor)}, origin)
  let start = run temporary(&mut builder.*, &word, origin)
  run assign(&mut builder.*, place(start), Rvalue.Use {value: move offset}, origin)
  let extent = run temporary(&mut builder.*, &word, origin)
  run assign(&mut builder.*, place(extent), Rvalue.Use {value: move length}, origin)
  let within = run temporary(&mut builder.*, &boolean, origin)
  run assign(&mut builder.*, place(within), Rvalue.Binary {operation: InfixOperator.LessOrEqual,
    left: Operand.Copy {place: place(start)}, right: Operand.Copy {place: place(count)}}, origin)
  run trapUnless(&mut builder.*, Operand.Copy {place: place(within)}, TrapReason.SliceRangeOutOfBounds, origin)
  let remaining = run temporary(&mut builder.*, &word, origin)
  run assign(&mut builder.*, place(remaining), Rvalue.Binary {operation: InfixOperator.Subtract,
    left: Operand.Copy {place: place(count)}, right: Operand.Copy {place: place(start)}}, origin)
  let fits = run temporary(&mut builder.*, &boolean, origin)
  run assign(&mut builder.*, place(fits), Rvalue.Binary {operation: InfixOperator.LessOrEqual,
    left: Operand.Copy {place: place(extent)}, right: Operand.Copy {place: place(remaining)}}, origin)
  run trapUnless(&mut builder.*, Operand.Copy {place: place(fits)}, TrapReason.SliceRangeOutOfBounds, origin)
  let addressType = run Types.intern(Type.Pointer {pointee: Interned<Type>.clone(&element), access: Access.Shared,
    nullable: true, multiplicity: Multiplicity.Many, alignment: Option<u64>.none()})
  let data = run temporary(&mut builder.*, &addressType, origin)
  run assign(&mut builder.*, place(data), Rvalue.SliceData {place: move descriptor}, origin)
  let selected = run temporary(&mut builder.*, &addressType, origin)
  run assign(&mut builder.*, place(selected), Rvalue.PointerOffset {pointer: Operand.Copy {place: place(data)},
    index: Operand.Copy {place: place(start)}, element: move element}, origin)
  return Rvalue.Slice {data: Operand.Copy {place: place(selected)}, count: Operand.Copy {place: place(extent)}}
}

fn pointeeOf(value: &Type) -> Option<Interned<Type>> {
  return match &value.* {
    Type.Pointer {pointee, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&pointee))
    _ => Option<Interned<Type>>.none()
  }
}

// The place an intrinsic operand reads; a constant operand has none.
effect fn operandPlace(owner: &Interned<DeclarationId>, value: Operand, origin: Origin) -> Place
! Gap | CanonicalizationFailure | OutOfMemoryError
? &mut Allocator {
  return match move value {
    Operand.Copy {place: selected} => move selected
    Operand.Move {place: selected} => move selected
    _ => run unsupported(owner, origin, GapCode.ExpectedPlace)
  }
}

// An owned copy of one checked arm, so lowering never holds a body loan; its nested tests are read
// piecewise by `armTestTag` and `armTestStepAt`. An arm written with `|` has `alternatives` rows,
// read by `alternativeView`, and its own pattern is `_`.
struct ArmView {
  pattern: BodyPattern,
  alternatives: usize,
  tests: usize,
  guard: Option<BodyNodeId>,
  result: BodyNodeId,
  origin: Origin,
}

fn copyMember(member: &Option<BodyUnionMember>) -> Option<BodyUnionMember> {
  return match &member.* {
    Option<BodyUnionMember>.Some {value} => Option<BodyUnionMember>.some(BodyUnionMember {tag: value.tag, ty: Interned<Type>.clone(&value.ty), source: Interned<Type>.clone(&value.source)})
    Option<BodyUnionMember>.None => Option<BodyUnionMember>.none()
  }
}

// A copy of a pattern that is not `Pattern.Alternatives`, which needs no allocation; alternatives
// copy as `_`.
fn flatPattern(written: &BodyPattern) -> BodyPattern {
  return match &written.* {
    BodyPattern.Universal => BodyPattern.Universal
    BodyPattern.EnumMember {member} => BodyPattern.EnumMember {member: member}
    BodyPattern.Record {member} => BodyPattern.Record {member: copyMember(&member)}
    BodyPattern.Variant {tag} => BodyPattern.Variant {tag: tag}
    BodyPattern.Integer {magnitude, negative} => BodyPattern.Integer {magnitude: magnitude, negative: negative}
    BodyPattern.Boolean {value: selected} => BodyPattern.Boolean {value: selected}
    BodyPattern.Range {lowMagnitude, lowNegative, highMagnitude, highNegative} => BodyPattern.Range {lowMagnitude: lowMagnitude,
      lowNegative: lowNegative, highMagnitude: highMagnitude, highNegative: highNegative}
    BodyPattern.Alternatives {..} => BodyPattern.Universal
  }
}

fn alternativeCount(written: &BodyPattern) -> usize {
  return match &written.* {
    BodyPattern.Alternatives {alternatives} => List<BodyAlternative>.length(&alternatives)
    _ => usize.ZERO
  }
}

// The nested tests of arm `arm`, or of its alternative `alternative` when that is not `usize.MAX`.
fn rowTests(arm: &BodyMatchArm, alternative: usize) -> &[BodyPatternTest] {
  if alternative != usize.MAX {
    if let BodyPattern.Alternatives {alternatives} = &arm.pattern {
      return List<BodyPatternTest>.asSlice(&List<BodyAlternative>.asSlice(&alternatives)[alternative].tests)
    }
  }
  return List<BodyPatternTest>.asSlice(&arm.tests)
}

// One alternative of an arm written with `|`: its pattern and how many nested tests it has.
struct AlternativeView {
  pattern: BodyPattern,
  tests: usize,
}

fn alternativeView(body: &Shared<TypedBody>, node: BodyNodeId, arm: usize, alternative: usize) -> Option<AlternativeView> {
  return Shared<TypedBody>.with<Option<AlternativeView>>(body, fn(value: &TypedBody) -> Option<AlternativeView> {
    let nodes = TypedBody.nodeSlice(value)
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[node.index].kind {
      let written = List<BodyMatchArm>.asSlice(&arms)
      if let BodyPattern.Alternatives {alternatives} = &written[arm].pattern {
        let listed = List<BodyAlternative>.asSlice(&alternatives)
        return Option<AlternativeView>.some(AlternativeView {pattern: flatPattern(&listed[alternative].pattern),
          tests: List<BodyPatternTest>.length(&listed[alternative].tests)})
      }
    }
    return Option<AlternativeView>.none()
  })
}

fn armView(body: &Shared<TypedBody>, node: BodyNodeId, at: usize) -> Option<ArmView> {
  return Shared<TypedBody>.with<Option<ArmView>>(body, fn(value: &TypedBody) -> Option<ArmView> {
    let nodes = TypedBody.nodeSlice(value)
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[node.index].kind {
      let written = List<BodyMatchArm>.asSlice(&arms)
      if at < written.length {
        let pattern = flatPattern(&written[at].pattern)
        let mut guard = Option<BodyNodeId>.none()
        if let Option<BodyNodeId>.Some {value: tested} = &written[at].guard { guard = Option<BodyNodeId>.some(tested) }
        return Option<ArmView>.some(ArmView {pattern: move pattern, alternatives: alternativeCount(&written[at].pattern),
          tests: List<BodyPatternTest>.length(&written[at].tests),
          guard: move guard, result: written[at].result, origin: written[at].origin})
      }
    }
    return Option<ArmView>.none()
  })
}

// The tag nested test `test` of arm `arm` requires, and how many tags its union has.
struct ArmTestTag {
  tag: usize,
  tags: usize,
  member: Option<BodyUnionMember>,
  scalar: Option<BodyScalarTest>,
}

fn armTestTag(body: &Shared<TypedBody>, node: BodyNodeId, arm: usize, alternative: usize, test: usize) -> Option<ArmTestTag> {
  return Shared<TypedBody>.with<Option<ArmTestTag>>(body, fn(value: &TypedBody) -> Option<ArmTestTag> {
    let nodes = TypedBody.nodeSlice(value)
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[node.index].kind {
      let written = List<BodyMatchArm>.asSlice(&arms)
      let tests = rowTests(&written[arm], alternative)
      let scalar = match &tests[test].scalar {
        Option<BodyScalarTest>.Some {value: selected} => Option<BodyScalarTest>.some(BodyScalarTest {member: selected.member, ty: Interned<Type>.clone(&selected.ty)})
        Option<BodyScalarTest>.None => Option<BodyScalarTest>.none()
      }
      return Option<ArmTestTag>.some(ArmTestTag {tag: tests[test].tag, tags: tests[test].tags, member: copyBodyUnionMember(&tests[test].member),
        scalar: move scalar})
    }
    return Option<ArmTestTag>.none()
  })
}

fn armTestStepAt(body: &Shared<TypedBody>, node: BodyNodeId, arm: usize, alternative: usize, test: usize, at: usize) -> Option<BodyPlaceStep> {
  return Shared<TypedBody>.with<Option<BodyPlaceStep>>(body, fn(value: &TypedBody) -> Option<BodyPlaceStep> {
    let nodes = TypedBody.nodeSlice(value)
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[node.index].kind {
      let written = List<BodyMatchArm>.asSlice(&arms)
      let tests = rowTests(&written[arm], alternative)
      return copyStep(&tests[test].path, at)
    }
    return Option<BodyPlaceStep>.none()
  })
}

effect fn magnitudeText(value: u64) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  if value == 0 { return run Bytes.copy(b"0") }
  let mut reversed = Bytes.make()
  let mut remaining = value
  while remaining > 0 {
    let digit = [u64.toU8(48 + u64.remainder(remaining, 10))]
    run Bytes.append(&mut reversed, &digit)
    remaining = remaining / 10
  }
  let digits = Bytes.asSlice(&reversed)
  let mut text = Bytes.make()
  let mut at = digits.length
  while at > usize.ZERO {
    at = at - usize.ONE
    run Bytes.append(&mut text, &[digits[at]])
  }
  return move text
}

effect fn enumOperand(member: BodyEnumMember, ty: &Interned<Type>) -> Operand ! OutOfMemoryError ? &mut Allocator {
  return Operand.Integer {decimal: run magnitudeText(member.magnitude), negative: member.negative, ty: Interned<Type>.clone(ty)}
}

// One dispatch choice: a distinct case value, keyed by member ordinal or tag, the tags a union
// member spreads over, or every remaining value.
union Selector {
  Any,
  Case {decimal: Bytes, negative: bool},
  Tags {tags: List<usize>},
  /// The values from `low` through `high`, both included, tested by comparison.
  Range {low: Bytes, lowNegative: bool, high: Bytes, highNegative: bool},
}

effect fn selectorOf(builder: &Builder, pattern: &BodyPattern) -> Selector ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return match &pattern.* {
    BodyPattern.Universal => Selector.Any
    BodyPattern.EnumMember {member} => Selector.Case {decimal: run magnitudeText(member.magnitude), negative: member.negative}
    BodyPattern.Variant {tag} => Selector.Case {decimal: run Type.extentText(tag), negative: false}
    BodyPattern.Record {member} => match &member {
      Option<BodyUnionMember>.Some {value} => match move run instancePlacement(builder, &value.source, &value.ty) {
        UnionPlacement.Whole => Selector.Any
        UnionPlacement.Tagged {tag, ..} => Selector.Case {decimal: run Type.extentText(tag), negative: false}
        UnionPlacement.Spread {tags, ..} => Selector.Tags {tags: move tags}
      }
      Option<BodyUnionMember>.None => Selector.Any
    }
    BodyPattern.Integer {magnitude, negative} => Selector.Case {decimal: run decimalBytes(magnitude), negative: negative}
    BodyPattern.Boolean {value} => Selector.Case {decimal: run Type.extentText(booleanCase(value)), negative: false}
    BodyPattern.Range {lowMagnitude, lowNegative, highMagnitude, highNegative} => Selector.Range {low: run decimalBytes(lowMagnitude),
      lowNegative: lowNegative, high: run decimalBytes(highMagnitude), highNegative: highNegative}
    // An arm's alternatives are dispatched as rows of their own.
    BodyPattern.Alternatives {..} => Selector.Any
  }
}

// The switch value of a `bool`: 1 for `true`.
fn booleanCase(value: bool) -> usize {
  if value { return usize.ONE }
  return usize.ZERO
}

// Ends the current block with one switch over arms `from..`: each case value goes to the first arm
// that can select it, and every other value to the first arm that selects any value. Coverage was
// proven during checking, so a missing catch-all leaves an unreachable default.
fn sameDecimal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn dispatchArms(builder: &mut Builder, selectors: &[Selector], entries: &[usize], switched: usize, switchedType: &Interned<Type>,
  from: usize, origin: Origin) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = from
  // Each pass switches over the rows up to the next range; a value no case routes then meets the
  // range, and a value outside it continues with the rows after the range.
  while true {
    let mut cases = List<SwitchCase>.make()
    let mut otherwise = usize.MAX
    let mut range = usize.MAX
    while at < selectors.length && otherwise == usize.MAX && range == usize.MAX {
      match &selectors[at] {
        Selector.Any => { otherwise = entries[at] }
        Selector.Case {decimal, negative} => run routeCase(&mut cases, Bytes.asSlice(&decimal), negative, entries[at])
        Selector.Tags {tags} => {
          let listed = List<usize>.asSlice(&tags)
          let mut tag = usize.ZERO
          while tag < listed.length {
            let decimal = run Type.extentText(listed[tag])
            run routeCase(&mut cases, Bytes.asSlice(&decimal), false, entries[at])
            tag = tag + usize.ONE
          }
        }
        Selector.Range {..} => { range = at }
      }
      at = at + usize.ONE
    }
    if otherwise == usize.MAX { otherwise = run block(&mut builder.*, origin) }
    if List<SwitchCase>.length(&cases) == usize.ZERO {
      terminate(&mut builder.*, Terminator.Goto {target: otherwise, origin: origin})
    } else {
      terminate(&mut builder.*, Terminator.Switch {
        value: Operand.Copy {place: place(switched)}, cases: move cases, otherwise: otherwise, origin: origin,
      })
    }
    if range == usize.MAX { return () }
    resume(&mut builder.*, otherwise)
    if let Selector.Range {low, lowNegative, high, highNegative} = &selectors[range] {
      let boolean = run CheckedIntrinsic.scalarType(Scalar.Bool)
      let rest = run block(&mut builder.*, origin)
      let upper = run block(&mut builder.*, origin)
      let above = run temporary(&mut builder.*, &boolean, origin)
      run assign(&mut builder.*, place(above), Rvalue.Binary {operation: InfixOperator.LessOrEqual,
        left: Operand.Integer {decimal: run Bytes.copy(Bytes.asSlice(&low)), negative: lowNegative, ty: Interned<Type>.clone(switchedType)},
        right: Operand.Copy {place: place(switched)}}, origin)
      terminate(&mut builder.*, Terminator.Branch {condition: Operand.Copy {place: place(above)}, thenBlock: upper, elseBlock: rest, origin: origin})
      resume(&mut builder.*, upper)
      let below = run temporary(&mut builder.*, &boolean, origin)
      run assign(&mut builder.*, place(below), Rvalue.Binary {operation: InfixOperator.LessOrEqual,
        left: Operand.Copy {place: place(switched)},
        right: Operand.Integer {decimal: run Bytes.copy(Bytes.asSlice(&high)), negative: highNegative, ty: Interned<Type>.clone(switchedType)}}, origin)
      terminate(&mut builder.*, Terminator.Branch {condition: Operand.Copy {place: place(below)}, thenBlock: entries[range], elseBlock: rest, origin: origin})
      resume(&mut builder.*, rest)
    }
  }
  return ()
}

// A value already routed to an earlier arm stays there; a later arm with the same value is reached
// only after that arm's guard fails.
effect fn routeCase(cases: &mut List<SwitchCase>, decimal: &[u8], negative: bool, target: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let prior = List<SwitchCase>.asSlice(&cases.*)
  let mut scan = usize.ZERO
  while scan < prior.length {
    if prior[scan].negative == negative && sameDecimal(Bytes.asSlice(&prior[scan].decimal), decimal) { return () }
    scan = scan + usize.ONE
  }
  run List<SwitchCase>.append(&mut cases.*, SwitchCase {decimal: run Bytes.copy(decimal), negative: negative, target: target})
  return ()
}

fn scrutineePlace(builder: &Builder, subject: BodyNodeId) -> Option<usize> {
  let listed = List<Scrutinee>.asSlice(&builder.scrutinees)
  let mut at = listed.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if listed[at].subject == subject.index { return Option<usize>.some(at) }
  }
  return Option<usize>.none()
}

// Once consuming arm `arm` is selected, each of its by-value bindings that needs cleanup owns its
// part of the evaluated subject, whose owner is `scrutinee`, until the binding's scope ends: the
// arm, or for a destructuring `let` the enclosing block (MATCH-002, PATT-006). The subject keeps
// only what no binding took.
effect fn bindArm(builder: &mut Builder, body: &Shared<TypedBody>, node: BodyNodeId, arm: usize, subject: BodyNodeId,
  scrutinee: usize, origin: Origin) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let local = List<Owner>.asSlice(&builder.owners)[scrutinee].local
  let mut binding = usize.ZERO
  while true {
    let declared = match move TypedBody.armBinding(body, node, arm, binding) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { break }
    }
    binding = binding + usize.ONE
    if !CleanupNeeds.node(&builder.needs, declared.index) { continue }
    let ty = match move run instanceNodeType(&builder.*, body, declared) {
      Option<Interned<Type>>.Some {value} => move value
      Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
    }
    // A spread binding owns the value its arm narrowed, after taking the union it was narrowed from.
    if let Option<SpreadBinding>.Some {value: spread} = move run spreadBinding(&builder.*, body, declared) {
      let narrowed = run narrowedLocal(&builder.*, body, declared, subject)
      if List<Projection>.length(&spread.prefix) == usize.ZERO {
        run moveOwner(&mut builder.*, scrutinee)
      } else {
        let taken = releasedNode(&builder.*, scrutinee, remainderIndex(&builder.*, declared.index))
        run settleSubtree(&mut builder.*, taken, movedState())
      }
      let bound = run newOwner(&mut builder.*, narrowed, List<Projection>.make(), subject.index, &ty)
      run expandOwner(&mut builder.*, bound, usize.MAX, subject.index)
      continue
    }
    let mut path = List<Projection>.make()
    let mut step = usize.ZERO
    while true {
      let selected = match move bindingStepAt(body, declared, step) {
        Option<BodyPlaceStep>.Some {value} => move value
        Option<BodyPlaceStep>.None => { break }
      }
      run lowerStep(&builder.*, &selected, &mut path)
      step = step + usize.ONE
    }
    if List<Projection>.length(&path) == usize.ZERO {
      // A whole-value binding takes the complete subject.
      run moveOwner(&mut builder.*, scrutinee)
    } else {
      let taken = releasedNode(&builder.*, scrutinee, remainderIndex(&builder.*, declared.index))
      run settleSubtree(&mut builder.*, taken, movedState())
    }
    let bound = run newOwner(&mut builder.*, local, move path, subject.index, &ty)
    run expandOwner(&mut builder.*, bound, usize.MAX, subject.index)
  }
  return ()
}

fn truncateOwners(builder: &mut Builder, length: usize) -> () {
  while List<Owner>.length(&builder.owners) > length { drop List<Owner>.pop(&mut builder.*.owners) }
  return ()
}

// The subject is evaluated once: a place match keeps its projected storage, other matches read one
// copy. Enum values are switched directly; a union switches on its tag. A false guard resumes
// dispatch at the following arm. A consuming match's `syntax` fixes where the selected arm's binding
// owners and the subject parts no binding took end (`MatchSyntax`).
// The shared reference `r` that a match subject `r.*` reads through, if it is one.
effect fn sharedReferent(builder: &mut Builder, body: &Shared<TypedBody>, subject: BodyNodeId) -> Option<BodyNodeId>
! OutOfMemoryError
? &mut Allocator | &mut Types {
  let reference = match move run instanceView(&mut builder.*, body, subject) {
    View.Dereference {value, ..} => value
    _ => { return Option<BodyNodeId>.none() }
  }
  let shared = match move run instanceNodeType(&builder.*, body, reference) {
    Option<Interned<Type>>.Some {value} => Interned<Type>.with<bool>(&value, sharedLender)
    Option<Interned<Type>>.None => false
  }
  if !shared { return Option<BodyNodeId>.none() }
  return Option<BodyNodeId>.some(reference)
}

fn sharedLender(value: &Type) -> bool {
  return match &value.* { Type.Reference {access, ..} => access == Access.Shared _ => false }
}

effect fn lowerMatch(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  node: BodyNodeId,
  subject: BodyNodeId,
  placeMatch: bool,
  consumes: bool,
  release: &Release,
  tags: usize,
  count: usize,
  syntax: BodyMatchSyntax,
  ty: &Interned<Type>,
  origin: Origin,
) -> Operand ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  // A destructuring `let` leaves its bindings' owners in the enclosing scope (PATT-006).
  let declaring = syntax == BodyMatchSyntax.Let
  // A written match and the taken body of an `if let` keep the subject parts no binding took until
  // the arm exits, after its bindings (MATCH-002). A `let` drops them when it binds (PATT-006), and
  // an `if let` mismatch cleans the whole subject before its path continues (PATT-008).
  let ifLet = syntax == BodyMatchSyntax.IfLet
  let subjectType = match move run instanceNodeType(&builder.*, body, subject) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let mut scrutinee = place(usize.ZERO)
  if placeMatch {
    let pending = List<Pending>.length(&builder.temporaries)
    scrutinee = run expressionPlace(&mut builder.*, body, hir, subject)
    // A borrowing destructuring `let` keeps its subject's temporaries alive for its bindings'
    // scope, like a borrowing binding (BORROW-006).
    if declaring { run retainTemporaries(&mut builder.*, pending) }
  } else if let Option<BodyNodeId>.Some {value: reference} = run sharedReferent(&mut builder.*, body, subject) {
    // Nothing writes through a live shared reference, so a copying match of `r.*` reads the referent
    // in place: its arms copy only the parts they bind, not the whole value first. Only the reference
    // is held, in case the arm assigns `r` itself.
    let referenceType = match move run instanceNodeType(&builder.*, body, reference) {
      Option<Interned<Type>>.Some {value} => move value
      Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
    }
    let input = run expression(&mut builder.*, body, hir, reference)
    let held = run temporary(&mut builder.*, &referenceType, origin)
    run assign(&mut builder.*, place(held), Rvalue.Use {value: move input}, origin)
    scrutinee = place(held)
    run List<Projection>.append(&mut scrutinee.projections, Projection.Deref)
  } else {
    let input = run consumedOperand(&mut builder.*, body, hir, subject)
    let copied = run temporary(&mut builder.*, &subjectType, origin)
    run assign(&mut builder.*, place(copied), Rvalue.Use {value: move input}, origin)
    scrutinee = place(copied)
  }
  // A consuming match moves the subject into its evaluated copy, which owns the active payload
  // until the selected arm ends, less the parts its by-value bindings take (MATCH-002).
  let mut scrutineeOwner = usize.MAX
  if consumes {
    let needed = CleanupNeeds.node(&builder.needs, subject.index)
    run applyRelease(&mut builder.*, release, needed, origin)
    if !declaring { run openScope(&mut builder.*) }
    let before = List<Owner>.length(&builder.owners)
    run acquire(&mut builder.*, scrutinee.local, &subjectType, needed)
    if List<Owner>.length(&builder.owners) > before {
      scrutineeOwner = before
      // The subject's parts that arm bindings and partial moves take are its move-path tree.
      run expandOwner(&mut builder.*, scrutineeOwner, usize.MAX, subject.index)
    }
  }
  // A structural union switches on its instance's own canonical tags (UNION-001); a subject the
  // instance normalized to one member has no tag, and every arm's member test then passes.
  let mut switchTags = tags
  if let Option<Interned<Type>>.Some {value: written} = move nodeType(body, subject) {
    if Interned<Type>.with<bool>(&written, unionType) {
      switchTags = match move run Type.canonicalUnionMembers(&subjectType) {
        Option<List<Interned<Type>>>.Some {value} => List<Interned<Type>>.length(&value)
        Option<List<Interned<Type>>>.None => usize.ZERO
      }
    }
  }
  let mut switched = scrutinee.local
  if switchTags != usize.ZERO {
    let tag = run Layout.tagType(switchTags)
    switched = run temporary(&mut builder.*, &tag, origin)
    run assign(&mut builder.*, place(switched), Rvalue.Discriminant {place: run copyPlace(&scrutinee)}, origin)
  } else if List<Projection>.length(&scrutinee.projections) != usize.ZERO {
    switched = run temporary(&mut builder.*, &subjectType, origin)
    run assign(&mut builder.*, place(switched), Rvalue.Use {value: Operand.Copy {place: run copyPlace(&scrutinee)}}, origin)
  }
  let tested = run copyPlace(&scrutinee)
  run List<Scrutinee>.append(&mut builder.*.scrutinees, Scrutinee {subject: subject.index, place: move scrutinee})
  // A `()` or `never` match stores no value; only a valued match owns an output temporary.
  let valued = Interned<Type>.with<bool>(ty, storedMatchValue)
  let mut output = usize.MAX
  if valued { output = run temporary(&mut builder.*, ty, origin) }
  // Dispatch tests rows in order: one per arm, or one per alternative of an arm written with `|`.
  // A row's entry runs its nested tests; a row without tests enters its arm's guard, or its result.
  let mut arms = List<ArmView>.make()
  let mut selectors = List<Selector>.make()
  let mut entries = List<usize>.make()
  let mut rowAlternatives = List<usize>.make()
  let mut rowTestCounts = List<usize>.make()
  let mut firstRows = List<usize>.make()
  let mut guardBlocks = List<usize>.make()
  let mut results = List<usize>.make()
  let mut at = usize.ZERO
  while at < count {
    let arm = match move armView(body, node, at) {
      Option<ArmView>.Some {value} => move value
      Option<ArmView>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
    }
    let resultBlock = run block(&mut builder.*, arm.origin)
    let mut guardBlock = resultBlock
    if let Option<BodyNodeId>.Some {..} = &arm.guard { guardBlock = run block(&mut builder.*, arm.origin) }
    run List<usize>.append(&mut firstRows, List<Selector>.length(&selectors))
    if arm.alternatives == usize.ZERO {
      let mut entry = guardBlock
      if arm.tests != usize.ZERO { entry = run block(&mut builder.*, arm.origin) }
      run List<Selector>.append(&mut selectors, run selectorOf(&builder.*, &arm.pattern))
      run List<usize>.append(&mut entries, entry)
      run List<usize>.append(&mut rowAlternatives, usize.MAX)
      run List<usize>.append(&mut rowTestCounts, arm.tests)
    } else {
      let mut alternative = usize.ZERO
      while alternative < arm.alternatives {
        let view = match move alternativeView(body, node, at, alternative) {
          Option<AlternativeView>.Some {value} => move value
          Option<AlternativeView>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
        }
        let mut entry = guardBlock
        if view.tests != usize.ZERO { entry = run block(&mut builder.*, arm.origin) }
        run List<Selector>.append(&mut selectors, run selectorOf(&builder.*, &view.pattern))
        run List<usize>.append(&mut entries, entry)
        run List<usize>.append(&mut rowAlternatives, alternative)
        run List<usize>.append(&mut rowTestCounts, view.tests)
        alternative = alternative + usize.ONE
      }
    }
    run List<usize>.append(&mut guardBlocks, guardBlock)
    run List<usize>.append(&mut results, resultBlock)
    run List<ArmView>.append(&mut arms, move arm)
    at = at + usize.ONE
  }
  run List<usize>.append(&mut firstRows, List<Selector>.length(&selectors))
  let join = run block(&mut builder.*, origin)
  let entryStates = run ownerStates(&builder.*)
  let mut arrivals = List<Arrival>.make()
  let armSlice = List<ArmView>.asSlice(&arms)
  let selectorSlice = List<Selector>.asSlice(&selectors)
  let entrySlice = List<usize>.asSlice(&entries)
  let rowAlternativeSlice = List<usize>.asSlice(&rowAlternatives)
  let rowTestSlice = List<usize>.asSlice(&rowTestCounts)
  let firstRowSlice = List<usize>.asSlice(&firstRows)
  let guardSlice = List<usize>.asSlice(&guardBlocks)
  let resultSlice = List<usize>.asSlice(&results)
  run dispatchArms(&mut builder.*, selectorSlice, entrySlice, switched, &subjectType, usize.ZERO, origin)
  let mut joined = false
  at = usize.ZERO
  while at < count {
    let armOrigin = armSlice[at].origin
    let result = armSlice[at].result
    let resultBlock = resultSlice[at]
    let guardBlock = guardSlice[at]
    let selecting = declaring || (ifLet && at != usize.ZERO)
    // Every arm starts from the owner states at dispatch; guards and tests cannot consume.
    run restoreOwners(&mut builder.*, &entryStates)
    // A failed guard resumes dispatch at the next arm; so does a failed test of the arm's last row,
    // through the same block.
    let mut guardFallback = usize.MAX
    if let Option<BodyNodeId>.Some {..} = &armSlice[at].guard { guardFallback = run block(&mut builder.*, armOrigin) }
    // Each row's nested tests run in order; the first that fails resumes dispatch at the next row.
    let mut row = firstRowSlice[at]
    while row < firstRowSlice[at + usize.ONE] {
      if rowTestSlice[row] != usize.ZERO {
        let alternative = rowAlternativeSlice[row]
        let last = row + usize.ONE == firstRowSlice[at + usize.ONE]
        resume(&mut builder.*, entrySlice[row])
        let mut fallback = guardFallback
        if !last || fallback == usize.MAX { fallback = run block(&mut builder.*, armOrigin) }
        let mut test = usize.ZERO
        while test < rowTestSlice[row] {
          let required = match move armTestTag(body, node, at, alternative, test) {
            Option<ArmTestTag>.Some {value} => move value
            Option<ArmTestTag>.None => { return run unsupported(&owner, armOrigin, GapCode.TypedForm) }
          }
          let mut projected = run copyPlace(&tested)
          let mut step = usize.ZERO
          while true {
            let selected = match move armTestStepAt(body, node, at, alternative, test, step) {
              Option<BodyPlaceStep>.Some {value} => move value
              Option<BodyPlaceStep>.None => { break }
            }
            run lowerStep(&builder.*, &selected, &mut projected.projections)
            step = step + usize.ONE
          }
          let next = run block(&mut builder.*, armOrigin)
          let mut cases = List<SwitchCase>.make()
          let mut read = usize.MAX
          if let Option<BodyScalarTest>.Some {value: scalar} = &required.scalar {
            // A scalar enum field is its representation value; the test compares it with the member's.
            read = run temporary(&mut builder.*, &scalar.ty, armOrigin)
            run assign(&mut builder.*, place(read), Rvalue.Use {value: Operand.Copy {place: move projected}}, armOrigin)
            run List<SwitchCase>.append(&mut cases, SwitchCase {decimal: run magnitudeText(scalar.member.magnitude),
              negative: scalar.member.negative, target: next})
          } else if let Option<BodyUnionMember>.Some {value: selectedMember} = &required.member {
            // A structural member test reads the instance's own tags (UNION-001): a member the
            // instance stores whole always passes, and one that is itself a union passes on any of
            // its members' tags.
            let mut selected = List<usize>.make()
            let mut whole = false
            match move run instancePlacement(&builder.*, &selectedMember.source, &selectedMember.ty) {
              UnionPlacement.Whole => { whole = true }
              UnionPlacement.Tagged {tag, ..} => run List<usize>.append(&mut selected, tag)
              UnionPlacement.Spread {tags: spread, ..} => { selected = move spread }
            }
            if whole {
              terminate(&mut builder.*, Terminator.Goto {target: next, origin: armOrigin})
              resume(&mut builder.*, next)
              test = test + usize.ONE
              continue
            }
            let storage = run RuntimeType.applyBindings(&selectedMember.source, List<Binding>.asSlice(&builder.bindings),
              List<RuntimeProjection>.asSlice(&builder.projections))
            let tags = match move run Type.canonicalUnionMembers(&storage) {
              Option<List<Interned<Type>>>.Some {value} => List<Interned<Type>>.length(&value)
              Option<List<Interned<Type>>>.None => CompilerBug.panic(b"a tested union member's storage is not a union")
            }
            let tagged = run Layout.tagType(tags)
            read = run temporary(&mut builder.*, &tagged, armOrigin)
            run assign(&mut builder.*, place(read), Rvalue.Discriminant {place: move projected}, armOrigin)
            let listed = List<usize>.asSlice(&selected)
            let mut pick = usize.ZERO
            while pick < listed.length {
              run List<SwitchCase>.append(&mut cases, SwitchCase {decimal: run Type.extentText(listed[pick]), negative: false, target: next})
              pick = pick + usize.ONE
            }
          } else {
            let tagged = run Layout.tagType(required.tags)
            read = run temporary(&mut builder.*, &tagged, armOrigin)
            run assign(&mut builder.*, place(read), Rvalue.Discriminant {place: move projected}, armOrigin)
            run List<SwitchCase>.append(&mut cases, SwitchCase {decimal: run Type.extentText(required.tag), negative: false, target: next})
          }
          terminate(&mut builder.*, Terminator.Switch {value: Operand.Copy {place: place(read)}, cases: move cases, otherwise: fallback, origin: armOrigin})
          resume(&mut builder.*, next)
          test = test + usize.ONE
        }
        terminate(&mut builder.*, Terminator.Goto {target: guardBlock, origin: armOrigin})
        if fallback != guardFallback {
          resume(&mut builder.*, fallback)
          run dispatchArms(&mut builder.*, selectorSlice, entrySlice, switched, &subjectType, row + usize.ONE, armOrigin)
        }
      }
      row = row + usize.ONE
    }
    // The guard runs once whichever row selected the arm; when it fails, dispatch resumes at the
    // next arm, since every alternative shares it and binds nothing.
    if let Option<BodyNodeId>.Some {value: condition} = &armSlice[at].guard {
      resume(&mut builder.*, guardBlock)
      let fallback = guardFallback
      // A guard's temporaries end before it selects the arm or resumes dispatch.
      let guardPending = List<Pending>.length(&builder.temporaries)
      let evaluated = run expression(&mut builder.*, body, hir, condition)
      // The ownership check keeps a guard from moving, dropping or storing a place declared
      // outside it (OWN0008), so a failed guard resumes dispatch with the arm's entry states.
      if !sameStates(&builder.*, &entryStates) { return CompilerBug.panic(b"a match guard changed an owner's state") }
      let passed = run settledCondition(&mut builder.*, move evaluated, guardPending, armOrigin)
      terminate(&mut builder.*, Terminator.Branch {condition: move passed, thenBlock: resultBlock, elseBlock: fallback, origin: armOrigin})
      resume(&mut builder.*, fallback)
      run dispatchArms(&mut builder.*, selectorSlice, entrySlice, switched, &subjectType, firstRowSlice[at + usize.ONE], armOrigin)
    }
    resume(&mut builder.*, resultBlock)
    run narrowBindings(&mut builder.*, body, node, at, subject, consumes, armOrigin)
    // The selected arm's by-value bindings take their parts of the subject (MATCH-002).
    let bindingOwners = List<Owner>.length(&builder.owners)
    if scrutineeOwner != usize.MAX {
      run bindArm(&mut builder.*, body, node, at, subject, scrutineeOwner, armOrigin)
      if selecting {
        run dropOwner(&mut builder.*, scrutineeOwner, armOrigin)
        run moveOwner(&mut builder.*, scrutineeOwner)
      }
    }
    // A block arm runs as statements; a transfer inside it leaves the arm without reaching the join.
    // A block that yields a value stores it after its statements, before its locals end.
    let yielded = blockValue(body, result)
    if let Option<BodyNodeId>.Some {value: produced} = move yielded {
      run openScope(&mut builder.*)
      run blockStatements(&mut builder.*, body, hir, result, blockCount(body, result), armOrigin)
      if builder.live {
        let armPending = List<Pending>.length(&builder.temporaries)
        let value = run expression(&mut builder.*, body, hir, produced)
        if valued && builder.live {
          run assign(&mut builder.*, place(output), Rvalue.Use {value: move value}, armOrigin)
        } else {
          drop value
        }
        run endTemporaries(&mut builder.*, armPending, armOrigin)
      }
      run closeScope(&mut builder.*, armOrigin)
    } else if blockNode(body, result) {
      run statement(&mut builder.*, body, hir, result)
    } else {
      // An arm's temporaries end with the arm, after its value is stored.
      let armPending = List<Pending>.length(&builder.temporaries)
      let value = run expression(&mut builder.*, body, hir, result)
      if valued && builder.live {
        run assign(&mut builder.*, place(output), Rvalue.Use {value: move value}, armOrigin)
      } else {
        drop value
      }
      run endTemporaries(&mut builder.*, armPending, armOrigin)
    }
    // Arm-local binding owners end with their arm, innermost first; then a written match's subject
    // drops what no binding took.
    if builder.live {
      if !declaring { run dropOwnersFrom(&mut builder.*, bindingOwners, armOrigin) }
      if scrutineeOwner != usize.MAX && !selecting {
        run dropOwner(&mut builder.*, scrutineeOwner, armOrigin)
        run moveOwner(&mut builder.*, scrutineeOwner)
      }
    }
    if !declaring { truncateOwners(&mut builder.*, bindingOwners) }
    // A destructuring `let`'s subject owns nothing more, while its bindings stay with the block.
    if declaring && scrutineeOwner != usize.MAX { drop List<Owner>.remove(&mut builder.*.owners, scrutineeOwner) }
    if builder.live {
      run List<Arrival>.append(&mut arrivals, run arrival(&builder.*))
      terminate(&mut builder.*, Terminator.Goto {target: join, origin: armOrigin})
      joined = true
    }
    at = at + usize.ONE
  }
  if joined {
    resume(&mut builder.*, join)
    run joinOwners(&mut builder.*, List<Arrival>.asSlice(&arrivals), origin)
  }
  if consumes && !declaring { run closeScope(&mut builder.*, origin) }
  if !joined { return Operand.Unit }
  // An uninhabited match value, such as `Result<never, E>.Success` matched in a generic body, never
  // reaches the join, as an uninhabited call never reaches its continuation (`continueAfter`).
  if Interned<Type>.with<bool>(ty, neverType) {
    terminate(&mut builder.*, Terminator.Unreachable {origin: origin})
    return Operand.Unit
  }
  if !valued { return Operand.Unit }
  return Operand.Copy {place: place(output)}
}

fn storedMatchValue(value: &Type) -> bool {
  return match &value.* {
    Type.Unit => false
    Type.Union {members} => List<Interned<Type>>.length(&members) != usize.ZERO
    _ => true
  }
}

// The value block `id` yields, if it is a block that yields one.
fn blockValue(body: &Shared<TypedBody>, id: BodyNodeId) -> Option<BodyNodeId> {
  return Shared<TypedBody>.with<Option<BodyNodeId>>(body, fn(value: &TypedBody) -> Option<BodyNodeId> {
    if let BodyNodeKind.Block {value: Option<BodyNodeId>.Some {value: yielded}, ..} = &TypedBody.nodeSlice(value)[id.index].kind {
      return Option<BodyNodeId>.some(yielded)
    }
    return Option<BodyNodeId>.none()
  })
}

fn blockCount(body: &Shared<TypedBody>, id: BodyNodeId) -> usize {
  return Shared<TypedBody>.with<usize>(body, fn(value: &TypedBody) -> usize {
    if let BodyNodeKind.Block {statements, ..} = &TypedBody.nodeSlice(value)[id.index].kind {
      return List<BodyNodeId>.length(&statements)
    }
    return usize.ZERO
  })
}

fn blockNode(body: &Shared<TypedBody>, id: BodyNodeId) -> bool {
  return Shared<TypedBody>.with<bool>(body, fn(value: &TypedBody) -> bool {
    return match &TypedBody.nodeSlice(value)[id.index].kind {
      BodyNodeKind.Block {..} => true
      _ => false
    }
  })
}

effect fn shortCircuit(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  operation: InfixOperator,
  left: BodyNodeId,
  right: BodyNodeId,
  ty: &Interned<Type>,
  origin: Origin,
) -> Operand ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let lhs = run expression(&mut builder.*, body, hir, left)
  let rhsBlock = run block(&mut builder.*, origin)
  let shortBlock = run block(&mut builder.*, origin)
  let join = run block(&mut builder.*, origin)
  let output = run temporary(&mut builder.*, ty, origin)
  if operation == InfixOperator.And {
    terminate(
      &mut builder.*,
      Terminator.Branch {
        condition: move lhs,
        thenBlock: rhsBlock,
        elseBlock: shortBlock,
        origin: origin,
      },
    )
  } else {
    terminate(
      &mut builder.*,
      Terminator.Branch {
        condition: move lhs,
        thenBlock: shortBlock,
        elseBlock: rhsBlock,
        origin: origin,
      },
    )
  }
  resume(&mut builder.*, shortBlock)
  run assign(
    &mut builder.*,
    place(output),
    Rvalue.Use {value: Operand.Boolean {value: operation == InfixOperator.Or}},
    origin,
  )
  // The right operand runs on one path only: its temporaries end with it, and owners it moves join.
  let mut arrivals = List<Arrival>.make()
  run List<Arrival>.append(&mut arrivals, run arrival(&builder.*))
  terminate(&mut builder.*, Terminator.Goto {target: join, origin: origin})
  resume(&mut builder.*, rhsBlock)
  let pending = List<Pending>.length(&builder.temporaries)
  let rhs = run expression(&mut builder.*, body, hir, right)
  if builder.live {
    run assign(&mut builder.*, place(output), Rvalue.Use {value: move rhs}, origin)
    run endTemporaries(&mut builder.*, pending, origin)
    run List<Arrival>.append(&mut arrivals, run arrival(&builder.*))
    terminate(&mut builder.*, Terminator.Goto {target: join, origin: origin})
  } else {
    drop rhs
    truncateTemporaries(&mut builder.*, pending)
  }
  resume(&mut builder.*, join)
  run joinOwners(&mut builder.*, List<Arrival>.asSlice(&arrivals), origin)
  return Operand.Copy {place: place(output)}
}

// Lowers the children of a block in order, stopping once the block can no longer be reached.
effect fn blockStatements(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  blockNode: BodyNodeId,
  count: usize,
  origin: Origin,
) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError
? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let mut at = usize.ZERO
  while at < count && builder.live {
    let child = match move childAt(body, blockNode, at) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => {
        return run unsupported(&owner, origin, GapCode.MissingBlockStatement)
      }
    }
    run statement(&mut builder.*, body, hir, child)
    at = at + usize.ONE
  }
  return ()
}

effect fn statement(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, id: BodyNodeId) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError
? &mut Allocator | &mut Types {
  if !builder.live {
    return ()
  }
  let pending = List<Pending>.length(&builder.temporaries)
  run lowerStatement(&mut builder.*, body, hir, id, pending)
  // Owned temporaries live until the end of their full expression.
  if builder.live { run dropTemporariesFrom(&mut builder.*, pending, nodeOrigin(body, id)) }
  truncateTemporaries(&mut builder.*, pending)
  return ()
}

fn neverType(value: &Type) -> bool {
  return Type.isNever(value)
}

fn effectContract(value: &Type) -> bool {
  return match &value.* { Type.Effect {..} => true _ => false }
}

// Whether a callable invocation invokes an `effect fn` value, so it constructs that value's Effect.
fn invokedConstruction(body: &Shared<TypedBody>, node: BodyNodeId) -> bool {
  return Shared<TypedBody>.with<bool>(body, fn(value: &TypedBody) -> bool {
    let nodes = TypedBody.nodeSlice(value)
    if let BodyNodeKind.Expression {form: BodyExpression.CallableCall {constructs, ..}, ..} = &nodes[node.index].kind { return constructs }
    return false
  })
}

// Whether this call is itself an `effect fn` construction: its result is the exact Effect whose
// runner is the called declaration, or an interface operation's selected witness. A generic call
// merely returning an Effect still runs. A run executes its immediate operand without lowering it.
fn constructionCall(body: &Shared<TypedBody>, node: BodyNodeId, ty: &Interned<Type>) -> bool {
  return Shared<TypedBody>.with<bool>(body, fn(value: &TypedBody) -> bool {
    let nodes = TypedBody.nodeSlice(value)
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration, ..}, ..} = &nodes[node.index].kind {
      return constructsDeclaration(ty, &declaration)
    }
    if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {isEffect, ..}, ..} = &nodes[node.index].kind { return isEffect }
    return false
  })
}

fn constructsDeclaration(ty: &Interned<Type>, declaration: &DeclarationId) -> bool {
  return Interned<Type>.with<bool>(ty, fn(result: &Type) -> bool { return constructedBy(result, declaration) })
}

fn constructedBy(result: &Type, declaration: &DeclarationId) -> bool {
  if let Type.CallableValue {application, contract, ..} = &result.* {
    if !Interned<Type>.with<bool>(&contract, effectContract) { return false }
    return Interned<Application>.with<bool>(&application, fn(selected: &Application) -> bool {
      return DeclarationId.equals(Application.bodyDeclaration(selected), declaration)
    })
  }
  return false
}

// The runtime storage of a callable or Effect view is its representation.
fn viewStorage(value: &Interned<Type>) -> Interned<Type> {
  let inner = Interned<Type>.with<Option<Interned<Type>>>(value, fn(node: &Type) -> Option<Interned<Type>> {
    return match &node.* {
      Type.CallableView {representation, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&representation))
      _ => Option<Interned<Type>>.none()
    }
  })
  if let Option<Interned<Type>>.Some {value: stored} = move inner { return move stored }
  return Interned<Type>.clone(value)
}

fn exclusiveLender(value: &Type) -> bool {
  return match &value.* { Type.Reference {access, ..} => access == Access.Mutable _ => false }
}

fn effectFailure(value: &Type) -> Option<Interned<Type>> {
  return match &value.* {
    Type.Effect {failure, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&failure))
    Type.CallableValue {contract, ..} => Interned<Type>.with<Option<Interned<Type>>>(&contract, effectFailure)
    Type.EffectComposite {contract, ..} => Interned<Type>.with<Option<Interned<Type>>>(&contract, effectFailure)
    // A lent exclusive view runs the lender's Effect under the view's contract, and a lent
    // reference runs its lender's.
    Type.CallableView {contract, ..} => Interned<Type>.with<Option<Interned<Type>>>(&contract, effectFailure)
    Type.Reference {referent, ..} => Interned<Type>.with<Option<Interned<Type>>>(&referent, effectFailure)
    _ => Option<Interned<Type>>.none()
  }
}

fn takeStorage(builder: &mut Builder, node: BodyNodeId) -> Option<StoragePlan> {
  let mut at = usize.ZERO
  while at < List<StoragePlan>.length(&builder.storage) {
    if List<StoragePlan>.asSlice(&builder.storage)[at].node.index == node.index {
      return Option<StoragePlan>.some(List<StoragePlan>.remove(&mut builder.*.storage, at))
    }
    at = at + usize.ONE
  }
  return Option<StoragePlan>.none()
}

// Both views are evaluated once, in written order, before comparing their byte lengths. A byte
// load is reached only when the lengths agree and the shared index is below that length.
// A `string` or a slice of `u8`: a view whose `==` compares its bytes.
fn byteView(value: &Type) -> bool {
  return match &value.* {
    Type.String {..} => true
    Type.Slice {element, ..} => Interned<Type>.with<bool>(&element, fn(item: &Type) -> bool {
      if let Type.Primitive {name} = &item.* {
        let text = Bytes.asSlice(&name)
        return text.length == 2 && text[usize.ZERO] == 117 && text[usize.ONE] == 56
      }
      return false
    })
    _ => false
  }
}

effect fn stringComparison(
  builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, operation: InfixOperator,
  left: BodyNodeId, right: BodyNodeId, leftType: &Interned<Type>, resultType: &Interned<Type>, origin: Origin,
) -> Operand ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  if operation != InfixOperator.Equals && operation != InfixOperator.NotEquals {
    return run unsupported(&owner, origin, GapCode.TypedForm)
  }
  let rightType = match move run instanceNodeType(&builder.*, body, right) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  if !Interned<Type>.with<bool>(&rightType, byteView) { return run unsupported(&owner, origin, GapCode.TypedForm) }
  let lhs = run expression(&mut builder.*, body, hir, left)
  if !builder.live { return Operand.Unit }
  let leftView = run storageValue(&mut builder.*, leftType, Rvalue.Use {value: move lhs}, origin)
  let rhs = run expression(&mut builder.*, body, hir, right)
  if !builder.live { return Operand.Unit }
  let rightView = run storageValue(&mut builder.*, &rightType, Rvalue.Use {value: move rhs}, origin)
  let word = run storagePrimitive(b"usize")
  let byte = run storagePrimitive(b"u8")
  let pointer = run Types.intern(Type.Pointer {pointee: Interned<Type>.clone(&byte), access: Access.Shared,
    nullable: true, multiplicity: Multiplicity.Many, alignment: Option<u64>.none()})
  let leftLength = run storageValue(&mut builder.*, &word, Rvalue.SliceLength {place: place(leftView)}, origin)
  let rightLength = run storageValue(&mut builder.*, &word, Rvalue.SliceLength {place: place(rightView)}, origin)
  let index = run storageValue(&mut builder.*, &word, Rvalue.Use {value: run usizeOperand(0)}, origin)
  let output = run temporary(&mut builder.*, resultType, origin)
  let scanning = run block(&mut builder.*, origin)
  let condition = run block(&mut builder.*, origin)
  let reading = run block(&mut builder.*, origin)
  let advance = run block(&mut builder.*, origin)
  let equal = run block(&mut builder.*, origin)
  let different = run block(&mut builder.*, origin)
  let joined = run block(&mut builder.*, origin)
  let sameLength = run storageCondition(&mut builder.*, InfixOperator.Equals,
    Operand.Copy {place: place(leftLength)}, Operand.Copy {place: place(rightLength)}, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: move sameLength, thenBlock: scanning,
    elseBlock: different, origin: origin})
  resume(&mut builder.*, scanning)
  let leftData = run storageValue(&mut builder.*, &pointer, Rvalue.SliceData {place: place(leftView)}, origin)
  let rightData = run storageValue(&mut builder.*, &pointer, Rvalue.SliceData {place: place(rightView)}, origin)
  terminate(&mut builder.*, Terminator.Goto {target: condition, origin: origin})
  resume(&mut builder.*, condition)
  let bounded = run storageCondition(&mut builder.*, InfixOperator.LessThan,
    Operand.Copy {place: place(index)}, Operand.Copy {place: place(leftLength)}, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: move bounded, thenBlock: reading,
    elseBlock: equal, origin: origin})
  resume(&mut builder.*, reading)
  let leftAddress = run storageValue(&mut builder.*, &pointer, Rvalue.PointerOffset {
    pointer: Operand.Copy {place: place(leftData)}, index: Operand.Copy {place: place(index)},
    element: Interned<Type>.clone(&byte)}, origin)
  let rightAddress = run storageValue(&mut builder.*, &pointer, Rvalue.PointerOffset {
    pointer: Operand.Copy {place: place(rightData)}, index: Operand.Copy {place: place(index)},
    element: Interned<Type>.clone(&byte)}, origin)
  let leftByte = run storageValue(&mut builder.*, &byte, Rvalue.Use {
    value: Operand.Copy {place: run pointedPlace(leftAddress)}}, origin)
  let rightByte = run storageValue(&mut builder.*, &byte, Rvalue.Use {
    value: Operand.Copy {place: run pointedPlace(rightAddress)}}, origin)
  let sameByte = run storageCondition(&mut builder.*, InfixOperator.Equals,
    Operand.Copy {place: place(leftByte)}, Operand.Copy {place: place(rightByte)}, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: move sameByte, thenBlock: advance,
    elseBlock: different, origin: origin})
  resume(&mut builder.*, advance)
  // The preceding guard proves index < length <= usize.MAX, so the ordinary checked addition
  // cannot overflow. Increment only after equal bytes, then recheck before reading again.
  run assign(&mut builder.*, place(index), Rvalue.Binary {operation: InfixOperator.Add,
    left: Operand.Copy {place: place(index)}, right: run usizeOperand(1)}, origin)
  terminate(&mut builder.*, Terminator.Goto {target: condition, origin: origin})
  resume(&mut builder.*, equal)
  run assign(&mut builder.*, place(output), Rvalue.Use {
    value: Operand.Boolean {value: operation == InfixOperator.Equals}}, origin)
  terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
  resume(&mut builder.*, different)
  run assign(&mut builder.*, place(output), Rvalue.Use {
    value: Operand.Boolean {value: operation == InfixOperator.NotEquals}}, origin)
  terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
  resume(&mut builder.*, joined)
  return Operand.Copy {place: place(output)}
}

effect fn storagePrimitive(name: &[u8]) -> Interned<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run Types.intern(Type.Primitive {name: run Bytes.copy(name)})
}

effect fn wordOperand(value: usize) -> Operand ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run usizeOperand(usize.toU64(value))
}

// Stores one rvalue in a fresh temporary of `ty` and returns that local.
effect fn storageValue(builder: &mut Builder, ty: &Interned<Type>, value: Rvalue, origin: Origin) -> usize
! OutOfMemoryError ? &mut Allocator {
  let local = run temporary(&mut builder.*, ty, origin)
  run assign(&mut builder.*, place(local), move value, origin)
  return local
}

// One comparison or boolean combination, as a `bool` operand.
effect fn storageCondition(builder: &mut Builder, operation: InfixOperator, left: Operand, right: Operand, origin: Origin) -> Operand
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let boolean = run storagePrimitive(b"bool")
  let local = run storageValue(&mut builder.*, &boolean, Rvalue.Binary {operation: operation, left: move left, right: move right}, origin)
  return Operand.Copy {place: place(local)}
}

// `base`, optionally dereferenced, then the record fields `steps` in order.
effect fn storagePlace(base: &Place, dereference: bool, steps: &[usize]) -> Place ! OutOfMemoryError ? &mut Allocator {
  let mut projected = run copyPlace(base)
  if dereference { run List<Projection>.append(&mut projected.projections, Projection.Deref) }
  let mut at = usize.ZERO
  while at < steps.length {
    run List<Projection>.append(&mut projected.projections, Projection.Field {index: steps[at]})
    at = at + usize.ONE
  }
  return move projected
}

// The value a pointer local addresses.
effect fn pointedPlace(local: usize) -> Place ! OutOfMemoryError ? &mut Allocator {
  let mut projected = place(local)
  run List<Projection>.append(&mut projected.projections, Projection.Deref)
  return move projected
}

// One written type argument of a storage call under this instance's bindings.
effect fn storageArgumentType(builder: &Builder, body: &Shared<TypedBody>, node: BodyNodeId, at: usize, origin: Origin) -> Interned<Type>
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  return match move TypedBody.storageTypeArgument(body, node, at) {
    Option<Interned<Type>>.Some {value} => run RuntimeType.applyBindings(&value, List<Binding>.asSlice(&builder.bindings),
      List<RuntimeProjection>.asSlice(&builder.projections))
    Option<Interned<Type>>.None => {
      let owner = InstanceKey.identity(&builder.function.key)
      return run unsupported(&owner, origin, GapCode.TypedForm)
    }
  }
}

// Evaluates a storage call's operands in written order. An owned operand evaluated before a later
// one exits is a temporary that exit drops; the primitive owns them all once every one is ready.
effect fn storageOperands(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, node: BodyNodeId, count: usize,
  origin: Origin) -> List<Operand> ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let mut values = List<Operand>.make()
  let mut transferred = List<usize>.make()
  let mut at = usize.ZERO
  while at < count {
    let child = match move childAt(body, node, at) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { return run unsupported(&owner, origin, GapCode.MissingCallArgument) }
    }
    let produced = run expression(&mut builder.*, body, hir, child)
    if !builder.live { return move values }
    let guarded = run guardOperand(&mut builder.*, body, child, move produced, &mut transferred, origin)
    run List<Operand>.append(&mut values, move guarded)
    at = at + usize.ONE
  }
  transferGuarded(&mut builder.*, &transferred)
  return move values
}

// Calls one sealed C allocator function and continues after it; returns the result local.
effect fn callAllocator(builder: &mut Builder, plan: &StoragePlan, selected: usize, arguments: List<Operand>,
  result: &Interned<Type>, origin: Origin) -> usize ! OutOfMemoryError ? &mut Allocator {
  let externs = List<Interned<DeclarationId>>.asSlice(&plan.externs)
  let declaration = Interned<DeclarationId>.clone(&externs[selected])
  run List<Interned<DeclarationId>>.append(&mut builder.*.function.externs, Interned<DeclarationId>.clone(&declaration))
  let output = run temporary(&mut builder.*, result, origin)
  let continuation = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Call {callee: Callee.Extern {declaration: move declaration, variadicArguments: List<CAbi.VariadicArgument>.make()}, arguments: move arguments,
    providers: List<Operand>.make(), diagnostics: Option<Diagnostics>.none(), destination: place(output), normal: continuation,
    failure: Option<FailureEdge>.none(), origin: origin})
  resume(&mut builder.*, continuation)
  return output
}

// `rawBufferResize<T>(buffer, count)`: system storage (reclaim 0 with a nonzero context, the
// address `malloc` returned) grows with `realloc` to `count` slots plus the alignment padding
// `systemAllocationAcquire` adds, and the base is aligned again inside the result. `realloc` keeps
// the old bytes from the start of the block, so the slots move along when the base's offset into
// the block changes. Every refusal leaves the buffer as it was and yields false.
effect fn lowerBufferResize(builder: &mut Builder, plan: &StoragePlan, buffer: &Place, requested: Operand,
  ty: &Interned<Type>, origin: Origin) -> Operand ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = run storagePrimitive(b"usize")
  let address = run SealedCore.bytes()
  let count = run storageValue(&mut builder.*, &word, Rvalue.Use {value: move requested}, origin)
  let output = run storageValue(&mut builder.*, ty, Rvalue.Use {value: Operand.Boolean {value: false}}, origin)
  let done = run block(&mut builder.*, origin)
  if plan.size == usize.ZERO {
    terminate(&mut builder.*, Terminator.Goto {target: done, origin: origin})
    resume(&mut builder.*, done)
    return Operand.Copy {place: place(output)}
  }
  let reclaim = run storageValue(&mut builder.*, &word, Rvalue.Use {value: Operand.Copy {place: run storagePlace(buffer, true,
    &[SealedCore.ordinal(CoreField.BufferReclaim)])}}, origin)
  let context = run storageValue(&mut builder.*, &word, Rvalue.Use {value: Operand.Copy {place: run storagePlace(buffer, true,
    &[SealedCore.ordinal(CoreField.BufferContext)])}}, origin)
  let held = run storageValue(&mut builder.*, &word, Rvalue.Use {value: Operand.Copy {place: run storagePlace(buffer, true,
    &[SealedCore.ordinal(CoreField.BufferCount)])}}, origin)
  let padding = plan.alignment - usize.ONE
  // The largest slot count whose bytes and padding still fit in a word.
  let ceiling = run storageValue(&mut builder.*, &word, Rvalue.Unary {operation: PrefixOperator.BitwiseNot,
    value: run wordOperand(padding)}, origin)
  let limit = run storageValue(&mut builder.*, &word, Rvalue.Binary {operation: InfixOperator.Divide,
    left: Operand.Copy {place: place(ceiling)}, right: run wordOperand(plan.size)}, origin)
  let system = run storageCondition(&mut builder.*, InfixOperator.Equals, Operand.Copy {place: place(reclaim)}, run wordOperand(usize.ZERO), origin)
  let owned = run storageCondition(&mut builder.*, InfixOperator.NotEquals, Operand.Copy {place: place(context)}, run wordOperand(usize.ZERO), origin)
  let grows = run storageCondition(&mut builder.*, InfixOperator.GreaterOrEqual, Operand.Copy {place: place(count)},
    Operand.Copy {place: place(held)}, origin)
  let fits = run storageCondition(&mut builder.*, InfixOperator.LessOrEqual, Operand.Copy {place: place(count)},
    Operand.Copy {place: place(limit)}, origin)
  let nonzero = run storageCondition(&mut builder.*, InfixOperator.NotEquals, Operand.Copy {place: place(count)}, run wordOperand(usize.ZERO), origin)
  let first = run storageCondition(&mut builder.*, InfixOperator.BitAnd, move system, move owned, origin)
  let second = run storageCondition(&mut builder.*, InfixOperator.BitAnd, move grows, move fits, origin)
  let both = run storageCondition(&mut builder.*, InfixOperator.BitAnd, move first, move second, origin)
  let eligible = run storageCondition(&mut builder.*, InfixOperator.BitAnd, move both, move nonzero, origin)
  let request = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: move eligible, thenBlock: request, elseBlock: done, origin: origin})
  resume(&mut builder.*, request)
  let bytes = run storageValue(&mut builder.*, &word, Rvalue.Binary {operation: InfixOperator.Multiply,
    left: Operand.Copy {place: place(count)}, right: run wordOperand(plan.size)}, origin)
  let physical = run storageValue(&mut builder.*, &word, Rvalue.Binary {operation: InfixOperator.Add,
    left: Operand.Copy {place: place(bytes)}, right: run wordOperand(padding)}, origin)
  let old = run storageValue(&mut builder.*, &address, Rvalue.AddressIntegerConversion {operand: Operand.Copy {place: place(context)},
    destinationType: Interned<Type>.clone(&address)}, origin)
  let mut arguments = List<Operand>.make()
  run List<Operand>.append(&mut arguments, Operand.Copy {place: place(old)})
  run List<Operand>.append(&mut arguments, Operand.Copy {place: place(physical)})
  let raw = run callAllocator(&mut builder.*, plan, 4, move arguments, &address, origin)
  let missing = run storageCondition(&mut builder.*, InfixOperator.Equals, Operand.Copy {place: place(raw)},
    Operand.Null {ty: Interned<Type>.clone(&address)}, origin)
  let acquired = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: move missing, thenBlock: done, elseBlock: acquired, origin: origin})
  resume(&mut builder.*, acquired)
  let fresh = run storageValue(&mut builder.*, &word, Rvalue.AddressIntegerConversion {operand: Operand.Copy {place: place(raw)},
    destinationType: Interned<Type>.clone(&word)}, origin)
  let base = run storageValue(&mut builder.*, &word, Rvalue.Use {value: Operand.Copy {place: run storagePlace(buffer, true,
    &[SealedCore.ordinal(CoreField.BufferBase)])}}, origin)
  let offset = run storageValue(&mut builder.*, &word, Rvalue.Binary {operation: InfixOperator.Subtract,
    left: Operand.Copy {place: place(base)}, right: Operand.Copy {place: place(context)}}, origin)
  let advanced = run storageValue(&mut builder.*, &word, Rvalue.Binary {operation: InfixOperator.Add,
    left: Operand.Copy {place: place(fresh)}, right: run wordOperand(padding)}, origin)
  let aligned = run storageValue(&mut builder.*, &word, Rvalue.Binary {operation: InfixOperator.BitAnd,
    left: Operand.Copy {place: place(advanced)}, right: Operand.Copy {place: place(ceiling)}}, origin)
  let moved = run storageValue(&mut builder.*, &word, Rvalue.Binary {operation: InfixOperator.Add,
    left: Operand.Copy {place: place(fresh)}, right: Operand.Copy {place: place(offset)}}, origin)
  let shifted = run storageCondition(&mut builder.*, InfixOperator.NotEquals, Operand.Copy {place: place(moved)},
    Operand.Copy {place: place(aligned)}, origin)
  let shifting = run block(&mut builder.*, origin)
  let settled = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: move shifted, thenBlock: shifting, elseBlock: settled, origin: origin})
  resume(&mut builder.*, shifting)
  let destination = run storageValue(&mut builder.*, &address, Rvalue.AddressIntegerConversion {operand: Operand.Copy {place: place(aligned)},
    destinationType: Interned<Type>.clone(&address)}, origin)
  let source = run storageValue(&mut builder.*, &address, Rvalue.AddressIntegerConversion {operand: Operand.Copy {place: place(moved)},
    destinationType: Interned<Type>.clone(&address)}, origin)
  let kept = run storageValue(&mut builder.*, &word, Rvalue.Binary {operation: InfixOperator.Multiply,
    left: Operand.Copy {place: place(held)}, right: run wordOperand(plan.size)}, origin)
  let mut shifts = List<Operand>.make()
  run List<Operand>.append(&mut shifts, Operand.Copy {place: place(destination)})
  run List<Operand>.append(&mut shifts, Operand.Copy {place: place(source)})
  run List<Operand>.append(&mut shifts, Operand.Copy {place: place(kept)})
  drop run callAllocator(&mut builder.*, plan, 2, move shifts, &address, origin)
  terminate(&mut builder.*, Terminator.Goto {target: settled, origin: origin})
  resume(&mut builder.*, settled)
  run assign(&mut builder.*, run storagePlace(buffer, true, &[SealedCore.ordinal(CoreField.BufferBase)]),
    Rvalue.Use {value: Operand.Copy {place: place(aligned)}}, origin)
  run assign(&mut builder.*, run storagePlace(buffer, true, &[SealedCore.ordinal(CoreField.BufferCount)]),
    Rvalue.Use {value: Operand.Copy {place: place(count)}}, origin)
  run assign(&mut builder.*, run storagePlace(buffer, true, &[SealedCore.ordinal(CoreField.BufferContext)]),
    Rvalue.Use {value: Operand.Copy {place: place(fresh)}}, origin)
  run assign(&mut builder.*, place(output), Rvalue.Use {value: Operand.Boolean {value: true}}, origin)
  terminate(&mut builder.*, Terminator.Goto {target: done, origin: origin})
  resume(&mut builder.*, done)
  return Operand.Copy {place: place(output)}
}

// The aligned base address of the allocation a raw buffer referenced by `buffer` owns, as `*mut T`.
effect fn bufferBase(builder: &mut Builder, buffer: &Place, element: &Interned<Type>, origin: Origin) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = run storagePrimitive(b"usize")
  let address = run storageValue(&mut builder.*, &word, Rvalue.Use {value: Operand.Copy {place: run storagePlace(buffer, true, &[SealedCore.ordinal(CoreField.BufferBase)])}}, origin)
  let pointer = run SealedCore.address(element)
  return run storageValue(&mut builder.*, &pointer, Rvalue.AddressIntegerConversion {operand: Operand.Copy {place: place(address)},
    destinationType: Interned<Type>.clone(&pointer)}, origin)
}

// Traps unless `offset..offset + length` lies within the element count of the referenced buffer.
effect fn bufferRange(builder: &mut Builder, buffer: &Place, offset: usize, length: usize, origin: Origin) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = run storagePrimitive(b"usize")
  let count = run storageValue(&mut builder.*, &word, Rvalue.Use {value: Operand.Copy {place: run storagePlace(buffer, true, &[usize.ONE])}}, origin)
  let starts = run storageCondition(&mut builder.*, InfixOperator.LessOrEqual, Operand.Copy {place: place(offset)},
    Operand.Copy {place: place(count)}, origin)
  run trapUnless(&mut builder.*, move starts, TrapReason.RawBufferRangeOutOfBounds, origin)
  let remaining = run storageValue(&mut builder.*, &word, Rvalue.Binary {operation: InfixOperator.Subtract,
    left: Operand.Copy {place: place(count)}, right: Operand.Copy {place: place(offset)}}, origin)
  let fits = run storageCondition(&mut builder.*, InfixOperator.LessOrEqual, Operand.Copy {place: place(length)},
    Operand.Copy {place: place(remaining)}, origin)
  return run trapUnless(&mut builder.*, move fits, TrapReason.RawBufferRangeOutOfBounds, origin)
}

// The address of element `index` of the referenced buffer after its bounds check, as `*mut T`.
effect fn bufferElement(builder: &mut Builder, buffer: &Place, index: usize, element: &Interned<Type>, origin: Origin) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = run storagePrimitive(b"usize")
  let count = run storageValue(&mut builder.*, &word, Rvalue.Use {value: Operand.Copy {place: run storagePlace(buffer, true, &[usize.ONE])}}, origin)
  let bounded = run storageCondition(&mut builder.*, InfixOperator.LessThan, Operand.Copy {place: place(index)},
    Operand.Copy {place: place(count)}, origin)
  run trapUnless(&mut builder.*, move bounded, TrapReason.IndexOutOfBounds, origin)
  let base = run bufferBase(&mut builder.*, buffer, element, origin)
  let pointer = run SealedCore.address(element)
  return run storageValue(&mut builder.*, &pointer, Rvalue.PointerOffset {pointer: Operand.Copy {place: place(base)},
    index: Operand.Copy {place: place(index)}, element: Interned<Type>.clone(element)}, origin)
}

// Whether a prepared invocation consumes the callable environment it is given rather than lending it.
fn consumesCallable(target: &CallTarget) -> bool {
  if let Option<StoredArguments>.Some {value: stored} = &target.stored { return stored.consumes }
  let operands = List<CallOperand>.asSlice(&target.operands)
  if operands.length == usize.ZERO { return true }
  return match &operands[usize.ZERO].borrow { Option<Access>.None => true _ => false }
}

// Drops one owned callable operand that its path does not consume.
effect fn releaseCallable(builder: &mut Builder, body: &Shared<TypedBody>, child: BodyNodeId, callable: usize, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !CleanupNeeds.node(&builder.needs, child.index) { return () }
  let owner = InstanceKey.identity(&builder.function.key)
  let ty = localType(&builder.*, callable)
  return run dropPlace(&mut builder.*, place(callable), &ty, &owner, origin)
}

// `replace(place, value)`: the place is evaluated first, then the value; the displaced value is
// moved out and the new one moved in, with no cleanup of either.
effect fn lowerReplace(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, node: BodyNodeId, ty: &Interned<Type>,
  origin: Origin) -> Operand ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let target = match move childAt(body, node, usize.ZERO) {
    Option<BodyNodeId>.Some {value} => value
    Option<BodyNodeId>.None => { return run unsupported(&owner, origin, GapCode.MissingCallArgument) }
  }
  let replacement = match move childAt(body, node, usize.ONE) {
    Option<BodyNodeId>.Some {value} => value
    Option<BodyNodeId>.None => { return run unsupported(&owner, origin, GapCode.MissingCallArgument) }
  }
  let destination = run expressionPlace(&mut builder.*, body, hir, target)
  let value = run expression(&mut builder.*, body, hir, replacement)
  if !builder.live { return Operand.Unit }
  let displaced = run storageValue(&mut builder.*, ty, Rvalue.Use {value: Operand.Move {place: run copyPlace(&destination)}}, origin)
  run assign(&mut builder.*, move destination, Rvalue.Use {value: move value}, origin)
  return Operand.Move {place: place(displaced)}
}

// `run systemAllocationAcquire(layout)`: validates the request, then acquires `bytes + alignment - 1`
// bytes (at least one) from `malloc` and aligns the base inside them. A refused request or a null
// result fails with `StorageFailure` before any allocation is owned (SUSP-015); a null result is
// passed to `free` first.
effect fn lowerAcquisition(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, node: BodyNodeId, ty: &Interned<Type>,
  origin: Origin) -> Operand ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let plan = match move takeStorage(&mut builder.*, node) {
    Option<StoragePlan>.Some {value} => move value
    Option<StoragePlan>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let effectType = match move run instanceNodeType(&builder.*, body, node) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let failureType = match move Interned<Type>.with<Option<Interned<Type>>>(&effectType, effectFailure) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.EffectForm) }
  }
  if builder.failure == usize.MAX { return run unsupported(&owner, origin, GapCode.TypedForm) }
  let mut operands = run storageOperands(&mut builder.*, body, hir, node, usize.ONE, origin)
  if !builder.live { return Operand.Unit }
  let layout = run operandPlace(&owner, List<Operand>.remove(&mut operands, usize.ZERO), origin)
  let word = run storagePrimitive(b"usize")
  let address = run SealedCore.bytes()
  let bytes = run storageValue(&mut builder.*, &word, Rvalue.Use {value: Operand.Copy {place: run storagePlace(&layout, false, &[usize.ZERO])}}, origin)
  let alignment = run storageValue(&mut builder.*, &word, Rvalue.Use {value: Operand.Copy {place: run storagePlace(&layout, false, &[usize.ONE])}}, origin)
  let failed = run block(&mut builder.*, origin)
  let nonzero = run storageCondition(&mut builder.*, InfixOperator.NotEquals, Operand.Copy {place: place(alignment)}, run wordOperand(usize.ZERO), origin)
  let measured = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: move nonzero, thenBlock: measured, elseBlock: failed, origin: origin})
  resume(&mut builder.*, measured)
  let padding = run storageValue(&mut builder.*, &word, Rvalue.Binary {operation: InfixOperator.Subtract,
    left: Operand.Copy {place: place(alignment)}, right: run wordOperand(usize.ONE)}, origin)
  let shared = run storageValue(&mut builder.*, &word, Rvalue.Binary {operation: InfixOperator.BitAnd,
    left: Operand.Copy {place: place(alignment)}, right: Operand.Copy {place: place(padding)}}, origin)
  let power = run storageCondition(&mut builder.*, InfixOperator.Equals, Operand.Copy {place: place(shared)}, run wordOperand(usize.ZERO), origin)
  let aligned = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: move power, thenBlock: aligned, elseBlock: failed, origin: origin})
  resume(&mut builder.*, aligned)
  // The complement of the padding is the largest byte count the padding can be added to.
  let headroom = run storageValue(&mut builder.*, &word, Rvalue.Unary {operation: PrefixOperator.BitwiseNot,
    value: Operand.Copy {place: place(padding)}}, origin)
  let fits = run storageCondition(&mut builder.*, InfixOperator.LessOrEqual, Operand.Copy {place: place(bytes)},
    Operand.Copy {place: place(headroom)}, origin)
  let sized = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: move fits, thenBlock: sized, elseBlock: failed, origin: origin})
  resume(&mut builder.*, sized)
  let physical = run storageValue(&mut builder.*, &word, Rvalue.Binary {operation: InfixOperator.Add,
    left: Operand.Copy {place: place(bytes)}, right: Operand.Copy {place: place(padding)}}, origin)
  let empty = run storageCondition(&mut builder.*, InfixOperator.Equals, Operand.Copy {place: place(physical)}, run wordOperand(usize.ZERO), origin)
  let widened = run block(&mut builder.*, origin)
  let request = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: move empty, thenBlock: widened, elseBlock: request, origin: origin})
  resume(&mut builder.*, widened)
  run assign(&mut builder.*, place(physical), Rvalue.Use {value: run wordOperand(usize.ONE)}, origin)
  terminate(&mut builder.*, Terminator.Goto {target: request, origin: origin})
  resume(&mut builder.*, request)
  let mut requested = List<Operand>.make()
  run List<Operand>.append(&mut requested, Operand.Copy {place: place(physical)})
  let raw = run callAllocator(&mut builder.*, &plan, usize.ZERO, move requested, &address, origin)
  let missing = run storageCondition(&mut builder.*, InfixOperator.Equals, Operand.Copy {place: place(raw)},
    Operand.Null {ty: Interned<Type>.clone(&address)}, origin)
  let acquired = run block(&mut builder.*, origin)
  let released = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: move missing, thenBlock: released, elseBlock: acquired, origin: origin})
  // A null result is still released, as the bootstrap does: `free(NULL)` is inert, and an
  // unoptimized build keeps the call the allocator observes.
  resume(&mut builder.*, released)
  let mut releasing = List<Operand>.make()
  run List<Operand>.append(&mut releasing, Operand.Copy {place: place(raw)})
  let unit = run Types.intern(Type.Unit)
  drop run callAllocator(&mut builder.*, &plan, usize.ONE, move releasing, &unit, origin)
  terminate(&mut builder.*, Terminator.Goto {target: failed, origin: origin})
  resume(&mut builder.*, failed)
  // A refusal originates its failure here, like `fail` (N3, N7).
  let refusal = run storageValue(&mut builder.*, &failureType, Rvalue.Aggregate {fields: List<AggregateField>.make()}, origin)
  let destination = builder.failure
  run widenInto(&mut builder.*, refusal, &failureType, destination, origin)
  run raise(&mut builder.*, origin)
  run leaveFunction(&mut builder.*, ExitKind.Fails, origin)
  resume(&mut builder.*, acquired)
  let context = run storageValue(&mut builder.*, &word, Rvalue.AddressIntegerConversion {operand: Operand.Copy {place: place(raw)},
    destinationType: Interned<Type>.clone(&word)}, origin)
  let advanced = run storageValue(&mut builder.*, &word, Rvalue.Binary {operation: InfixOperator.Add,
    left: Operand.Copy {place: place(context)}, right: Operand.Copy {place: place(padding)}}, origin)
  let mask = run storageValue(&mut builder.*, &word, Rvalue.Unary {operation: PrefixOperator.BitwiseNot,
    value: Operand.Copy {place: place(padding)}}, origin)
  let base = run storageValue(&mut builder.*, &word, Rvalue.Binary {operation: InfixOperator.BitAnd,
    left: Operand.Copy {place: place(advanced)}, right: Operand.Copy {place: place(mask)}}, origin)
  let mut fields = List<AggregateField>.make()
  run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.AllocationBase), value: Operand.Copy {place: place(base)}})
  run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.AllocationBytes), value: Operand.Copy {place: place(bytes)}})
  run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.AllocationAlignment), value: Operand.Copy {place: place(alignment)}})
  // Reclaim 0 marks system storage: no reclaim function sits at address or table index 0.
  run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.AllocationReclaim), value: run wordOperand(usize.ZERO)})
  run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.AllocationContext), value: Operand.Copy {place: place(context)}})
  let output = run storageValue(&mut builder.*, ty, Rvalue.Aggregate {fields: move fields}, origin)
  return Operand.Move {place: place(output)}
}

// The declaration of a nominal type, where a core type is minted beside it.
fn nominalAnchor(value: &Type) -> Option<DeclarationId> {
  return match &value.* {
    Type.Nominal {declaration, ..} => Option<DeclarationId>.some(DeclarationId.copy(&declaration))
    _ => Option<DeclarationId>.none()
  }
}

// `sharedWithMut(core, use, onConflict)`: a block already under access runs the conflict policy;
// otherwise the access state is held while `use` receives the value exclusively.
effect fn lowerSharedAccess(builder: &mut Builder, body: &Shared<TypedBody>, node: BodyNodeId, plan: &StoragePlan,
  operands: List<Operand>, element: &Interned<Type>, ty: &Interned<Type>, origin: Origin) -> Operand
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let targets = List<CallTarget>.asSlice(&plan.targets)
  let results = List<Interned<Type>>.asSlice(&plan.results)
  if targets.length != 2 || results.length != 2 { return run unsupported(&owner, origin, GapCode.TypedForm) }
  let useChild = match move childAt(body, node, usize.ONE) {
    Option<BodyNodeId>.Some {value} => value
    Option<BodyNodeId>.None => { return run unsupported(&owner, origin, GapCode.MissingCallArgument) }
  }
  let conflictChild = match move childAt(body, node, 2) {
    Option<BodyNodeId>.Some {value} => value
    Option<BodyNodeId>.None => { return run unsupported(&owner, origin, GapCode.MissingCallArgument) }
  }
  let mut values = move operands
  let core = run operandPlace(&owner, List<Operand>.remove(&mut values, usize.ZERO), origin)
  let useType = match move run instanceNodeType(&builder.*, body, useChild) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let conflictType = match move run instanceNodeType(&builder.*, body, conflictChild) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let selected = run storageValue(&mut builder.*, &useType, Rvalue.Use {value: List<Operand>.remove(&mut values, usize.ZERO)}, origin)
  let policy = run storageValue(&mut builder.*, &conflictType, Rvalue.Use {value: List<Operand>.remove(&mut values, usize.ZERO)}, origin)
  let referenced = localType(&builder.*, core.local)
  let handle = match move Interned<Type>.with<Option<Interned<Type>>>(&referenced, referentOf) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let blockPointer = match move run SealedCore.fieldType(&handle, CoreField.CoreBlock) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let word = run storagePrimitive(b"usize")
  let controlBlock = run storageValue(&mut builder.*, &blockPointer, Rvalue.Use {value: Operand.Copy {place: run storagePlace(&core, true, &[SealedCore.ordinal(CoreField.CoreBlock)])}}, origin)
  let access = SealedCore.ordinal(CoreField.BlockAccess)
  let state = run storageValue(&mut builder.*, &word, Rvalue.Use {value: Operand.Copy {place: run storagePlace(&place(controlBlock), true, &[access])}}, origin)
  let busy = run storageCondition(&mut builder.*, InfixOperator.NotEquals, Operand.Copy {place: place(state)}, run wordOperand(usize.ZERO), origin)
  let output = run temporary(&mut builder.*, ty, origin)
  let never = run Types.intern(Type.Union {members: List<Interned<Type>>.make()})
  let none = List<BoundPlace>.make()
  let conflicted = run block(&mut builder.*, origin)
  let entered = run block(&mut builder.*, origin)
  let joined = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: move busy, thenBlock: conflicted, elseBlock: entered, origin: origin})
  resume(&mut builder.*, conflicted)
  run releaseCallable(&mut builder.*, body, useChild, selected, origin)
  run planCall(&mut builder.*, &targets[usize.ONE], &place(policy), List<Operand>.make(), &results[usize.ONE], &never, output,
    &FailureSink.Propagate, List<BoundPlace>.asSlice(&none), origin, usize.MAX)
  if !consumesCallable(&targets[usize.ONE]) { run releaseCallable(&mut builder.*, body, conflictChild, policy, origin) }
  terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
  resume(&mut builder.*, entered)
  run assign(&mut builder.*, run storagePlace(&place(controlBlock), true, &[access]), Rvalue.Use {value: run wordOperand(usize.ONE)}, origin)
  run List<SharedAccess>.append(&mut builder.function.accesses, SharedAccess {callback: InstanceKey.copy(&targets[usize.ZERO].key), origin: origin})
  let loanType = run Types.intern(Type.Reference {referent: Interned<Type>.clone(element), access: Access.Mutable,
    lifetime: run Types.internLifetime(Lifetime.Static)})
  let loan = run storageValue(&mut builder.*, &loanType, Rvalue.Ref {access: Access.Mutable,
    place: run storagePlace(&place(controlBlock), true, &[SealedCore.ordinal(CoreField.BlockValue)])}, origin)
  let mut written = List<Operand>.make()
  run List<Operand>.append(&mut written, Operand.Copy {place: place(loan)})
  run planCall(&mut builder.*, &targets[usize.ZERO], &place(selected), move written, &results[usize.ZERO], &never, output,
    &FailureSink.Propagate, List<BoundPlace>.asSlice(&none), origin, usize.MAX)
  run assign(&mut builder.*, run storagePlace(&place(controlBlock), true, &[access]), Rvalue.Use {value: run wordOperand(usize.ZERO)}, origin)
  if !consumesCallable(&targets[usize.ZERO]) { run releaseCallable(&mut builder.*, body, useChild, selected, origin) }
  run releaseCallable(&mut builder.*, body, conflictChild, policy, origin)
  terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
  resume(&mut builder.*, joined)
  return Operand.Copy {place: place(output)}
}

// Adopts a validated allocation as one `Initial` execution package: the transfer record is empty,
// the start, drop and notification functions are the package's own erased helpers and glue, and
// the body, readiness state, endpoint and then the allocation itself move into place. The handle
// addresses the package as erased bytes.
effect fn lowerExecutionPackage(builder: &mut Builder, body: &Shared<TypedBody>, node: BodyNodeId, prepared: StoragePlan,
  operands: List<Operand>, ty: &Interned<Type>, origin: Origin) -> Operand
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let mut plan = move prepared
  let mut inputs = move operands
  let allocation = run operandPlace(&owner, List<Operand>.remove(&mut inputs, usize.ZERO), origin)
  let mut packaged = List<Interned<Type>>.make()
  let mut argument = usize.ZERO
  while argument < 4 {
    run List<Interned<Type>>.append(&mut packaged, run storageArgumentType(&builder.*, body, node, argument, origin))
    argument = argument + usize.ONE
  }
  let anchor = match move run SealedCore.coreIdentity(ty) {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let types = List<Interned<Type>>.asSlice(&packaged)
  let package = run SealedCore.packageBeside(&anchor, types)
  let mut parts = List<usize>.make()
  let mut field = usize.ONE
  while field < 4 {
    let stored = run storageValue(&mut builder.*, &types[field],
      Rvalue.Use {value: List<Operand>.remove(&mut inputs, usize.ZERO)}, origin)
    run List<usize>.append(&mut parts, stored)
    field = field + usize.ONE
  }
  let sized = run storageCondition(&mut builder.*, InfixOperator.Equals,
    Operand.Copy {place: run storagePlace(&allocation, false, &[SealedCore.ordinal(CoreField.AllocationBytes)])}, run wordOperand(plan.size), origin)
  let aligned = run storageCondition(&mut builder.*, InfixOperator.Equals,
    Operand.Copy {place: run storagePlace(&allocation, false, &[SealedCore.ordinal(CoreField.AllocationAlignment)])}, run wordOperand(plan.alignment), origin)
  let valid = run storageCondition(&mut builder.*, InfixOperator.BitAnd, move sized, move aligned, origin)
  run trapUnless(&mut builder.*, move valid, TrapReason.InvalidExecutionAllocationLayout, origin)
  let sourceOwner = DeclarationId.copyShared(&owner)
  let glue = match move run InstanceKey.dropGlue(&package, &sourceOwner) {
    Result<Option<InstanceKey>, CanonicalizationFailure>.Success {value: canonicalGlue} => match move canonicalGlue {
      Option<InstanceKey>.Some {value} => move value
      Option<InstanceKey>.None => { return run unsupported(&owner, origin, GapCode.OpenInstance) }
    }
    Result<Option<InstanceKey>, CanonicalizationFailure>.Failure {error: reason} => { fail move reason }
  }
  let blockPointer = run SealedCore.address(&package)
  let base = run storagePlace(&allocation, false, &[SealedCore.ordinal(CoreField.AllocationBase)])
  let block = run storageValue(&mut builder.*, &blockPointer, Rvalue.AddressIntegerConversion {
    operand: Operand.Copy {place: run copyPlace(&base)}, destinationType: Interned<Type>.clone(&blockPointer)}, origin)
  let erased = run SealedCore.packageAddress()
  let address = run storageValue(&mut builder.*, &erased, Rvalue.AddressIntegerConversion {operand: Operand.Copy {place: move base},
    destinationType: Interned<Type>.clone(&erased)}, origin)
  let bytes = run SealedCore.bytes()
  let header = SealedCore.ordinal(CoreField.PackageHeader)
  run assign(&mut builder.*, run storagePlace(&place(block), true, &[header, SealedCore.ordinal(CoreField.HeaderState)]),
    Rvalue.Use {value: Operand.Null {ty: Interned<Type>.clone(&bytes)}}, origin)
  run assign(&mut builder.*, run storagePlace(&place(block), true, &[header, SealedCore.ordinal(CoreField.HeaderTop)]),
    Rvalue.Use {value: Operand.Null {ty: Interned<Type>.clone(&bytes)}}, origin)
  run assign(&mut builder.*, run storagePlace(&place(block), true, &[header, SealedCore.ordinal(CoreField.HeaderFailed)]),
    Rvalue.Use {value: Operand.Integer {decimal: run Bytes.copy(b"0"), negative: false, ty: run storagePrimitive(b"u8")}}, origin)
  run assign(&mut builder.*, run storagePlace(&place(block), true, &[header, SealedCore.ordinal(CoreField.HeaderPackage)]),
    Rvalue.Use {value: Operand.Copy {place: place(address)}}, origin)
  run assign(&mut builder.*, run storagePlace(&place(block), true, &[header, SealedCore.ordinal(CoreField.HeaderLifecycle)]),
    Rvalue.Use {value: run wordOperand(SealedCore.lifecycleWord(Lifecycle.Unstarted))}, origin)
  // The source control words start at zero, and the Execution handle holds the one authority.
  let mut zeroed = SealedCore.ordinal(CoreField.HeaderControl)
  while zeroed <= SealedCore.ordinal(CoreField.HeaderNotifying) {
    let mut initial = usize.ZERO
    if zeroed == SealedCore.ordinal(CoreField.HeaderAuthority) { initial = usize.ONE }
    run assign(&mut builder.*, run storagePlace(&place(block), true, &[header, zeroed]), Rvalue.Use {value: run wordOperand(initial)}, origin)
    zeroed = zeroed + usize.ONE
  }
  // In a program that observes diagnostics, the trap record starts with no adapter and no observer.
  if let Option<DiagnosticPlaces>.Some {..} = &builder.diagnostics {
    let trap = run storagePlace(&place(block), true, &[header, SealedCore.ordinal(CoreField.HeaderTrap)])
    let mut slot = usize.ZERO
    while slot < 3 {
      let mut element = run copyPlace(&trap)
      run List<Projection>.append(&mut element.projections, Projection.ConstIndex {index: slot})
      run assign(&mut builder.*, move element, Rvalue.Use {value: Operand.Null {ty: run addressType()}}, origin)
      slot = slot + usize.ONE
    }
  }
  run List<Reference>.append(&mut builder.*.function.references, Reference {key: InstanceKey.copy(&glue), edge: Edge.Direct, origin: origin})
  run assign(&mut builder.*, run storagePlace(&place(block), true, &[header, SealedCore.ordinal(CoreField.HeaderDrop)]),
    Rvalue.FunctionAddress {key: move glue}, origin)
  // The helpers run this site's prepared invocations, so they are lowered here with this function.
  let creator = run Shared<InstanceKey>.make(InstanceKey.copy(&builder.function.key))
  if List<CallTarget>.length(&plan.targets) == usize.ZERO { return run unsupported(&owner, origin, GapCode.TypedForm) }
  let endpoint = List<CallTarget>.remove(&mut plan.targets, usize.ZERO)
  let steps = Intrinsic.replace(plan.steps, List<RunPlan>.make())
  let started = InstanceKey.Helper {creator: Shared<InstanceKey>.clone(&creator), node: node.index, ordinal: usize.ZERO,
    purpose: HelperRole.Start}
  let notified = InstanceKey.Helper {creator: move creator, node: node.index, ordinal: usize.ZERO,
    purpose: HelperRole.Notify}
  let start = run packageHelper(&builder.*, InstanceKey.copy(&started), &package, HelperWork.Start {steps: move steps}, origin)
  let notify = run packageHelper(&builder.*, InstanceKey.copy(&notified), &package, HelperWork.Notify {target: move endpoint}, origin)
  run adoptHelpers(&mut builder.*, move start, origin)
  run adoptHelpers(&mut builder.*, move notify, origin)
  run List<Reference>.append(&mut builder.*.function.references, Reference {key: InstanceKey.copy(&started), edge: Edge.Direct, origin: origin})
  run List<Reference>.append(&mut builder.*.function.references, Reference {key: InstanceKey.copy(&notified), edge: Edge.Direct, origin: origin})
  run assign(&mut builder.*, run storagePlace(&place(block), true, &[header, SealedCore.ordinal(CoreField.HeaderStart)]),
    Rvalue.FunctionAddress {key: move started}, origin)
  run assign(&mut builder.*, run storagePlace(&place(block), true, &[header, SealedCore.ordinal(CoreField.HeaderNotify)]),
    Rvalue.FunctionAddress {key: move notified}, origin)
  let stored = List<usize>.asSlice(&parts)
  let mut at = usize.ZERO
  while at < stored.length {
    run assign(&mut builder.*, run storagePlace(&place(block), true, &[SealedCore.ordinal(CoreField.PackageBody) + at]),
      Rvalue.Use {value: Operand.Move {place: place(stored[at])}}, origin)
    at = at + usize.ONE
  }
  run assign(&mut builder.*, run storagePlace(&place(block), true, &[header, SealedCore.ordinal(CoreField.HeaderAllocation)]),
    Rvalue.Use {value: Operand.Move {place: run copyPlace(&allocation)}}, origin)
  let mut fields = List<AggregateField>.make()
  run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.ExecutionPackage),
    value: Operand.Copy {place: place(address)}})
  let output = run storageValue(&mut builder.*, ty, Rvalue.Aggregate {fields: move fields}, origin)
  return Operand.Move {place: place(output)}
}

// What one erased package helper runs: the prepared run of the body, or the endpoint invocation.
union HelperWork {
  Start {steps: List<RunPlan>},
  Notify {target: CallTarget},
}

// A builder for one helper of `creator`: parameters `parameters` in order, then the creator's
// observer and cause when it observes. It shares the creator's bindings and diagnostics
// convention but none of its locals or providers. `cancellable` records a cancel exit after every
// instance call, as a package body that may relinquish needs.
effect fn helperBuilder(creator: &Builder, key: InstanceKey, result: &Interned<Type>, parameters: List<Interned<Type>>,
  cancellable: bool, origin: Origin) -> Builder ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut locals = List<Local>.make()
  run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(result), kind: LocalKind.Return, origin: origin})
  let listed = List<Interned<Type>>.asSlice(&parameters)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&listed[at]), kind: LocalKind.Parameter {index: at}, origin: origin})
    at = at + usize.ONE
  }
  let mut diagnostics = Option<DiagnosticPlaces>.none()
  if let Option<DiagnosticPlaces>.Some {..} = &creator.diagnostics {
    let observer = List<Local>.length(&locals)
    run List<Local>.append(&mut locals, Local {ty: run observerAddress(), kind: LocalKind.Observer, origin: origin})
    run List<Local>.append(&mut locals, Local {ty: run causeType(), kind: LocalKind.Cause, origin: origin})
    run List<Local>.append(&mut locals, Local {ty: run siteType(), kind: LocalKind.Site, origin: origin})
    diagnostics = Option<DiagnosticPlaces>.some(DiagnosticPlaces {observer: place(observer), cause: place(observer + usize.ONE),
      site: place(observer + 2)})
  }
  let mut bindings = List<Binding>.make()
  let supplied = List<Binding>.asSlice(&creator.bindings)
  at = usize.ZERO
  while at < supplied.length {
    run List<Binding>.append(&mut bindings, Binding {declaration: Interned<DeclarationId>.clone(&supplied[at].declaration),
      ordinal: supplied[at].ordinal, value: Argument.copy(&supplied[at].value)})
    at = at + usize.ONE
  }
  let mut projections = List<RuntimeProjection>.make()
  let projected = List<RuntimeProjection>.asSlice(&creator.projections)
  at = usize.ZERO
  while at < projected.length {
    run List<RuntimeProjection>.append(&mut projections, RuntimeProjection {source: Interned<Type>.clone(&projected[at].source),
      storage: Interned<Type>.clone(&projected[at].storage)})
    at = at + usize.ONE
  }
  return Builder {
    bindings: move bindings, projections: move projections, calls: List<CallTarget>.make(),
    function: MirFunction {key: move key, borrow: BodyBorrowStatus.Checked, result: Interned<Type>.clone(result), parameters: move parameters,
      locals: move locals, blocks: List<Block>.make(), references: List<Reference>.make(), externs: List<Interned<DeclarationId>>.make(),
      observes: false, contexts: List<ContextText>.make(), traps: List<TrapSite>.make(), suspension: Option<Origin>.none(), parks: Option<Origin>.none(), releasesPackages: false, nonParking: List<NonParkingRun>.make(), cancels: List<Cancel>.make(), accesses: List<SharedAccess>.make(), escapes: List<EscapeSite>.make(), features: Bytes.make(), inlining: Inlining.Default, optimizeSize: false, frame: Bytes.make(), lines: List<u64>.make(), variables: List<Variable>.make()},
    current: usize.ZERO, live: true, loops: List<LoopTargets>.make(), scrutinees: List<Scrutinee>.make(), narrowed: List<Narrowed>.make(),
    owners: List<Owner>.make(), cleanup: List<CleanupNode>.make(), states: List<usize>.make(), dropPlans: List<List<usize>>.make(), scopes: List<usize>.make(), temporaries: List<Pending>.make(),
    remainders: List<Remainder>.make(), needs: CleanupNeeds {locals: List<bool>.make(), nodes: List<bool>.make()},
    failure: usize.MAX, plans: List<NodePlan>.make(), storage: List<StoragePlan>.make(), carriers: List<CarrierPlan>.make(),
    providers: List<usize>.make(), diagnostics: move diagnostics, sites: Option<SiteText>.none(), anchor: Anchor.copy(&creator.anchor),
    witnessIntrinsics: List<WitnessIntrinsic>.make(), helpers: List<MirFunction>.make(),
    exits: List<ExitStep>.make(), left: List<LeftExit>.make(), forwards: List<ForwardBlock>.make(), forward: usize.MAX, forwardSite: usize.MAX, caught: List<CaughtSlot>.make(), suspending: Option<List<InstanceKey>>.none(),
    cancelEveryCall: cancellable,
    held: List<HeldFailure>.make(),
    cancelScopes: List<CancelScope>.make(),
    interrupts: List<InterruptBoundary>.make(),
    landing: false,
    constants: run copyConstants(List<ConstantValue>.asSlice(&creator.constants)),
    written: List<Interned<Type>>.make(), closed: List<Interned<Type>>.make(), writtenLookup: InternIndex.make(),
  }
}

effect fn copyConstants(values: &[ConstantValue]) -> List<ConstantValue> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = run List<ConstantValue>.makeWithCapacity(values.length)
  let mut at = usize.ZERO
  while at < values.length {
    run List<ConstantValue>.append(&mut copied, ConstantValue {
      declaration: Interned<DeclarationId>.clone(&values[at].declaration), value: Interned<StaticData>.clone(&values[at].value)})
    at = at + usize.ONE
  }
  return move copied
}

// Lowers one erased package helper. Its one parameter addresses the package as erased bytes; it
// runs the creator's prepared invocation over the package's own storage, so it shares the
// creator's bindings and diagnostics convention but none of its locals or providers.
effect fn packageHelper(creator: &Builder, key: InstanceKey, package: &Interned<Type>, work: HelperWork, origin: Origin) -> Lowered
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let unit = run Types.intern(Type.Unit)
  let erased = run SealedCore.packageAddress()
  let mut parameters = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut parameters, Interned<Type>.clone(&erased))
  let mut builder = run helperBuilder(creator, move key, &unit, move parameters, true, origin)
  let first = run block(&mut builder, origin)
  resume(&mut builder, first)
  let owner = InstanceKey.identity(&builder.function.key)
  let word = run storagePrimitive(b"usize")
  let blockPointer = run SealedCore.address(package)
  let integer = run storageValue(&mut builder, &word, Rvalue.AddressIntegerConversion {operand: Operand.Copy {place: place(usize.ONE)},
    destinationType: Interned<Type>.clone(&word)}, origin)
  let addressed = run storageValue(&mut builder, &blockPointer, Rvalue.AddressIntegerConversion {
    operand: Operand.Copy {place: place(integer)}, destinationType: Interned<Type>.clone(&blockPointer)}, origin)
  let fields = match move run SealedCore.fields(package) {
    Option<List<Interned<Type>>>.Some {value} => move value
    Option<List<Interned<Type>>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let listed = List<Interned<Type>>.asSlice(&fields)
  let header = SealedCore.ordinal(CoreField.PackageHeader)
  match move work {
    HelperWork.Start {steps} => {
      let ran = List<RunPlan>.asSlice(&steps)
      if ran.length == usize.ZERO { return CompilerBug.panic(b"a package helper starts no run plan") }
      let result = match move SealedCore.element(&listed[header]) {
        Option<Interned<Type>>.Some {value} => move value
        Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
      }
      let environment = run storageValue(&mut builder, &listed[SealedCore.ordinal(CoreField.PackageBody)], Rvalue.Use {value: Operand.Move {
        place: run storagePlace(&place(addressed), true, &[SealedCore.ordinal(CoreField.PackageBody)])}}, origin)
      let output = run temporary(&mut builder, &result, origin)
      let mut bound = List<BoundPlace>.make()
      run executePlan(&mut builder, ran, ran.length - usize.ONE, &place(environment), output, &FailureSink.Propagate, &mut bound, origin)
      run assign(&mut builder, run storagePlace(&place(addressed), true, &[header, SealedCore.ordinal(CoreField.HeaderResult)]),
        Rvalue.Use {value: Operand.Move {place: place(output)}}, origin)
    }
    HelperWork.Notify {target} => {
      let lent = run Types.intern(Type.Reference {referent: Interned<Type>.clone(&listed[SealedCore.ordinal(CoreField.PackageReady)]),
        access: Access.Shared, lifetime: run Types.internLifetime(Lifetime.Static)})
      let state = run storageValue(&mut builder, &lent, Rvalue.Ref {access: Access.Shared,
        place: run storagePlace(&place(addressed), true, &[SealedCore.ordinal(CoreField.PackageReady)])}, origin)
      let output = run temporary(&mut builder, &unit, origin)
      let never = run Types.intern(Type.Union {members: List<Interned<Type>>.make()})
      let mut written = List<Operand>.make()
      run List<Operand>.append(&mut written, Operand.Copy {place: place(state)})
      let none = List<BoundPlace>.make()
      let endpoint = run storagePlace(&place(addressed), true, &[SealedCore.ordinal(CoreField.PackageEndpoint)])
      run planCall(&mut builder, &target, &endpoint,
        move written, &unit, &never, output, &FailureSink.Propagate, List<BoundPlace>.asSlice(&none), origin, usize.MAX)
    }
  }
  if builder.live { terminate(&mut builder, Terminator.Return {origin: origin}) }
  // A helper exit only records its drops and an Unreachable placeholder; the exit blocks close here.
  run closeExits(&mut builder)
  run MirFunction.sortReferences(&mut builder.function.references)
  return Lowered {function: move builder.function, helpers: move builder.helpers}
}

// Stores helpers with the function that creates them, where their queries find them. Two helpers
// with one key would make the key name two bodies, so a repeated key is a gap rather than a choice.
effect fn adoptHelpers(builder: &mut Builder, lowered: Lowered, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  let Lowered {function, helpers} = move lowered
  run adoptHelper(&mut builder.*, move function, origin)
  let mut pending = move helpers
  while List<MirFunction>.length(&pending) > usize.ZERO {
    run adoptHelper(&mut builder.*, List<MirFunction>.remove(&mut pending, usize.ZERO), origin)
  }
}

effect fn adoptHelper(builder: &mut Builder, helper: MirFunction, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  let adopted = List<MirFunction>.asSlice(&builder.helpers)
  let mut at = usize.ZERO
  while at < adopted.length {
    if InstanceKey.sameRuntimeBase(&adopted[at].key, &helper.key) { return CompilerBug.panic(b"a helper is adopted twice") }
    at = at + usize.ONE
  }
  return run List<MirFunction>.append(&mut builder.*.helpers, move helper)
}

// The helper an observation at plan step `step` records as its callback (N1): it invokes the
// stored callback through a shared loan of its callable with the event operands. Every record holds
// such an adapter, so an event call has one shape whatever the callback captures. A package
// helper's adapters belong to the package's creator, which stores and finds them.
effect fn observerAdapter(builder: &mut Builder, step: usize, state: &Interned<Type>, callable: &Interned<Type>,
  callback: &CallTarget, origin: Origin) -> InstanceKey ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let creator = match &builder.function.key {
    InstanceKey.Helper {creator, ..} => Shared<InstanceKey>.clone(&creator)
    _ => run Shared<InstanceKey>.make(InstanceKey.copy(&builder.function.key))
  }
  let key = InstanceKey.Helper {creator: move creator, node: origin.node, ordinal: step, purpose: HelperRole.Observe}
  let word = run storagePrimitive(b"usize")
  let text = run Types.intern(Type.String {lifetime: run Types.internLifetime(Lifetime.Static)})
  let mut parameters = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut parameters, Interned<Type>.clone(callable))
  run List<Interned<Type>>.append(&mut parameters, Interned<Type>.clone(state))
  run List<Interned<Type>>.append(&mut parameters, run storagePrimitive(b"u8"))
  run List<Interned<Type>>.append(&mut parameters, Interned<Type>.clone(&word))
  run List<Interned<Type>>.append(&mut parameters, Interned<Type>.clone(&word))
  run List<Interned<Type>>.append(&mut parameters, Interned<Type>.clone(&text))
  run List<Interned<Type>>.append(&mut parameters, move text)
  // The callback cannot park (Intrinsic.NonParking), so its call has no cancel exit.
  let mut adapter = run helperBuilder(&builder.*, InstanceKey.copy(&key), &word, move parameters, false, origin)
  let first = run block(&mut adapter, origin)
  resume(&mut adapter, first)
  let mut stored = place(usize.ONE)
  run List<Projection>.append(&mut stored.projections, Projection.Deref)
  let mut written = List<Operand>.make()
  let mut at: usize = 2
  while at <= 7 {
    run List<Operand>.append(&mut written, Operand.Copy {place: place(at)})
    at = at + usize.ONE
  }
  let never = run Types.intern(Type.Union {members: List<Interned<Type>>.make()})
  let none = List<BoundPlace>.make()
  run planCall(&mut adapter, callback, &stored, move written, &word, &never, usize.ZERO, &FailureSink.Propagate,
    List<BoundPlace>.asSlice(&none), origin, usize.MAX)
  if adapter.live { terminate(&mut adapter, Terminator.Return {origin: origin}) }
  run closeExits(&mut adapter)
  run MirFunction.sortReferences(&mut adapter.function.references)
  run adoptHelper(&mut builder.*, move adapter.function, origin)
  return move key
}

// The erased address of the package an Execution handle at `handle` addresses, and a typed address
// of its result-only header.
struct PackageAccess {
  package: usize,
  header: usize,
}

effect fn packageAt(builder: &mut Builder, handle: &Place, execution: &Interned<Type>, origin: Origin) -> PackageAccess
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let anchor = match move run SealedCore.coreIdentity(execution) {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let result = match move SealedCore.element(execution) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let headerType = run SealedCore.headerBeside(&anchor, &result)
  let headerPointer = run SealedCore.address(&headerType)
  let word = run storagePrimitive(b"usize")
  let erased = run SealedCore.packageAddress()
  let package = run storageValue(&mut builder.*, &erased, Rvalue.Use {value: Operand.Copy {
    place: run storagePlace(handle, false, &[SealedCore.ordinal(CoreField.ExecutionPackage)])}}, origin)
  let integer = run storageValue(&mut builder.*, &word, Rvalue.AddressIntegerConversion {operand: Operand.Copy {place: place(package)},
    destinationType: Interned<Type>.clone(&word)}, origin)
  let header = run storageValue(&mut builder.*, &headerPointer, Rvalue.AddressIntegerConversion {
    operand: Operand.Copy {place: place(integer)}, destinationType: Interned<Type>.clone(&headerPointer)}, origin)
  return PackageAccess {package: package, header: header}
}

// Calls the erased package function the header records at `field` with the package's address.
effect fn callErased(builder: &mut Builder, access: &PackageAccess, field: CoreField, origin: Origin) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if field == CoreField.HeaderDrop { builder.function.releasesPackages = true }
  let bytes = run SealedCore.bytes()
  let function = run storageValue(&mut builder.*, &bytes, Rvalue.Use {value: Operand.Copy {
    place: run storagePlace(&place(access.header), true, &[SealedCore.ordinal(field)])}}, origin)
  let unit = run Types.intern(Type.Unit)
  let output = run temporary(&mut builder.*, &unit, origin)
  let next = run block(&mut builder.*, origin)
  let mut arguments = List<Operand>.make()
  run List<Operand>.append(&mut arguments, Operand.Copy {place: place(access.package)})
  let mut diagnostics = run currentDiagnostics(&builder.*)
  let current = match &builder.diagnostics {
    Option<DiagnosticPlaces>.Some {value} => Option<Place>.some(run copyPlace(&value.observer))
    Option<DiagnosticPlaces>.None => Option<Place>.none()
  }
  let mut forwarded = Option<Place>.none()
  if field == CoreField.HeaderStart {
    if let Option<Place>.Some {value: observer} = &current {
      // The body starts an independent diagnostic invocation under the package's trap record, which
      // answers no event and forwards a fatal trap to this drive's observer. The record lives as
      // long as the package's frames, and holds the observer only while this drive runs them.
      let trap = run headerField(access, CoreField.HeaderTrap)
      let mut target = run copyPlace(&trap)
      run List<Projection>.append(&mut target.projections, Projection.ConstIndex {index: usize.ONE})
      run assign(&mut builder.*, run copyPlace(&target), Rvalue.Use {value: Operand.Copy {place: run copyPlace(&observer)}}, origin)
      let record = run temporary(&mut builder.*, &run observerAddress(), origin)
      run assign(&mut builder.*, place(record), Rvalue.AddressOf {access: Access.Shared, place: move trap}, origin)
      diagnostics = Option<Diagnostics>.some(run Diagnostics.make(Operand.Copy {place: place(record)}, Operand.Null {ty: run causeType()},
        Operand.Null {ty: run siteType()}))
      forwarded = Option<Place>.some(move target)
    }
  }
  terminate(&mut builder.*, Terminator.Call {callee: Callee.Indirect {address: Operand.Copy {place: place(function)}},
    arguments: move arguments, providers: List<Operand>.make(), diagnostics: move diagnostics,
    destination: place(output), normal: next, failure: Option<FailureEdge>.none(), origin: origin})
  resume(&mut builder.*, next)
  if let Option<Place>.Some {value: target} = &forwarded {
    run assign(&mut builder.*, run copyPlace(&target), Rvalue.Use {value: Operand.Null {ty: run addressType()}}, origin)
  }
  return ()
}

// The package an `ExecutionRef` place addresses, with a typed address of its header. A reference
// is erased over the result, so it reads every header field but the result through `()`'s header,
// whose prefix is the same.
effect fn referencedPackage(builder: &mut Builder, reference: &Place, referenced: &Interned<Type>, origin: Origin) -> PackageAccess
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let anchor = match move run SealedCore.coreIdentity(referenced) {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let erased = run SealedCore.packageAddress()
  let package = run storageValue(&mut builder.*, &erased, Rvalue.Use {value: Operand.Copy {
    place: run storagePlace(reference, false, &[SealedCore.ordinal(CoreField.RefPackage)])}}, origin)
  return run erasedHeader(&mut builder.*, &anchor, package, origin)
}

// A package's erased address together with a typed address of its header, read through `()`'s
// header: every field but the result has the same offset in every package.
effect fn erasedHeader(builder: &mut Builder, anchor: &DeclarationId, package: usize, origin: Origin) -> PackageAccess
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let unit = run Types.intern(Type.Unit)
  let headerType = run SealedCore.headerBeside(anchor, &unit)
  let headerPointer = run SealedCore.address(&headerType)
  let word = run storagePrimitive(b"usize")
  let integer = run storageValue(&mut builder.*, &word, Rvalue.AddressIntegerConversion {operand: Operand.Copy {place: place(package)},
    destinationType: Interned<Type>.clone(&word)}, origin)
  let header = run storageValue(&mut builder.*, &headerPointer, Rvalue.AddressIntegerConversion {
    operand: Operand.Copy {place: place(integer)}, destinationType: Interned<Type>.clone(&headerPointer)}, origin)
  return PackageAccess {package: package, header: header}
}

// One header field of an accessed package.
effect fn headerField(access: &PackageAccess, field: CoreField) -> Place ! OutOfMemoryError ? &mut Allocator {
  return run storagePlace(&place(access.header), true, &[SealedCore.ordinal(field)])
}

// Adds one unit of authority over the package's allocation and returns the `ExecutionRef` that holds it.
effect fn grantReference(builder: &mut Builder, access: &PackageAccess, ty: &Interned<Type>, origin: Origin) -> Operand
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = run storagePrimitive(b"usize")
  // A new unit is granted from one the caller holds, so no ordering is needed (EXEC-009).
  let mut added = List<Operand>.make()
  run List<Operand>.append(&mut added, run wordOperand(usize.ONE))
  drop run headerAtomic(&mut builder.*, run headerField(access, CoreField.HeaderAuthority), IntrinsicPrimitive.AtomicFetchAdd,
    move added, MemoryOrder.Relaxed, &word, origin)
  let mut fields = List<AggregateField>.make()
  run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.RefPackage),
    value: Operand.Copy {place: place(access.package)}})
  let output = run storageValue(&mut builder.*, ty, Rvalue.Aggregate {fields: move fields}, origin)
  return Operand.Move {place: place(output)}
}

// One atomic access of a word-sized header field: `primitive` over the field's address, then
// `operands`, at `order` (EXEC-009). A compare-exchange fails with acquire ordering.
effect fn headerAtomic(builder: &mut Builder, field: Place, primitive: IntrinsicPrimitive, operands: List<Operand>, order: MemoryOrder,
  ty: &Interned<Type>, origin: Origin) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = run storagePrimitive(b"usize")
  let wordAddress = run SealedCore.address(&word)
  let address = run storageValue(&mut builder.*, &wordAddress, Rvalue.AddressOf {access: Access.Mutable, place: move field}, origin)
  return run wordAtomic(&mut builder.*, address, primitive, move operands, order, ty, origin)
}

// One atomic access of the word at the address in local `address`.
effect fn wordAtomic(builder: &mut Builder, address: usize, primitive: IntrinsicPrimitive, operands: List<Operand>, order: MemoryOrder,
  ty: &Interned<Type>, origin: Origin) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = run storagePrimitive(b"usize")
  let mut listed = List<Operand>.make()
  run List<Operand>.append(&mut listed, Operand.Copy {place: place(address)})
  let mut rest = move operands
  while List<Operand>.length(&rest) > usize.ZERO {
    run List<Operand>.append(&mut listed, List<Operand>.remove(&mut rest, usize.ZERO))
  }
  let mut failure = order
  if primitive == IntrinsicPrimitive.AtomicCompareExchange { failure = MemoryOrder.Acquire }
  return run storageValue(&mut builder.*, ty, Rvalue.Atomic {primitive: primitive, operands: move listed, success: order,
    failure: failure, element: move word}, origin)
}

// A compare-exchange of the word at local `address` from `expected` to `desired`; returns the
// local holding the value it observed, which equals `expected` exactly when it stored.
effect fn wordExchange(builder: &mut Builder, address: usize, expected: Operand, desired: Operand, origin: Origin) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = run storagePrimitive(b"usize")
  let boolean = run storagePrimitive(b"bool")
  let wordAddress = run SealedCore.address(&word)
  let observed = run storageValue(&mut builder.*, &word, Rvalue.Use {value: move expected}, origin)
  let slot = run storageValue(&mut builder.*, &wordAddress, Rvalue.AddressOf {access: Access.Mutable, place: place(observed)}, origin)
  let mut operands = List<Operand>.make()
  run List<Operand>.append(&mut operands, Operand.Copy {place: place(slot)})
  run List<Operand>.append(&mut operands, move desired)
  drop run wordAtomic(&mut builder.*, address, IntrinsicPrimitive.AtomicCompareExchange, move operands, MemoryOrder.AcquireRelease,
    &boolean, origin)
  return observed
}

// The address of one header field, in a fresh local.
effect fn headerAddress(builder: &mut Builder, access: &PackageAccess, field: CoreField, origin: Origin) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = run storagePrimitive(b"usize")
  let wordAddress = run SealedCore.address(&word)
  return run storageValue(&mut builder.*, &wordAddress, Rvalue.AddressOf {access: Access.Mutable,
    place: run headerField(access, field)}, origin)
}

// Whether the package's Execution handle still owns its body: neither completed nor dropped. A
// waking thread reads it with acquire ordering against the owner's release stores (EXEC-009).
effect fn livePackage(builder: &mut Builder, access: &PackageAccess, origin: Origin) -> Operand ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = run storagePrimitive(b"usize")
  let state = run headerAtomic(&mut builder.*, run headerField(access, CoreField.HeaderLifecycle), IntrinsicPrimitive.AtomicLoad,
    List<Operand>.make(), MemoryOrder.Acquire, &word, origin)
  return run storageCondition(&mut builder.*, InfixOperator.LessThan, Operand.Copy {place: place(state)},
    run wordOperand(SealedCore.lifecycleWord(Lifecycle.Completed)), origin)
}

// Records lifecycle `state` with an atomic store a waking thread may observe (EXEC-009).
effect fn recordLifecycle(builder: &mut Builder, access: &PackageAccess, state: Lifecycle, order: MemoryOrder, origin: Origin) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let unit = run Types.intern(Type.Unit)
  let mut stored = List<Operand>.make()
  run List<Operand>.append(&mut stored, run wordOperand(SealedCore.lifecycleWord(state)))
  drop run headerAtomic(&mut builder.*, run headerField(access, CoreField.HeaderLifecycle), IntrinsicPrimitive.AtomicStore,
    move stored, order, &unit, origin)
}

// The address of the control word a control-word operation selects; any other index traps.
effect fn controlWord(builder: &mut Builder, access: &PackageAccess, index: Operand, origin: Origin) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = run storagePrimitive(b"usize")
  let selected = run storageValue(&mut builder.*, &word, Rvalue.Use {value: move index}, origin)
  let valid = run storageCondition(&mut builder.*, InfixOperator.LessOrEqual, Operand.Copy {place: place(selected)},
    run wordOperand(2), origin)
  run trapUnless(&mut builder.*, move valid, TrapReason.InvalidExecutionControlWord, origin)
  // The three words are adjacent, so the selected one is the first advanced by the index.
  let wordAddress = run SealedCore.address(&word)
  let first = run storageValue(&mut builder.*, &wordAddress, Rvalue.AddressOf {access: Access.Mutable,
    place: run headerField(access, CoreField.HeaderControl)}, origin)
  return run storageValue(&mut builder.*, &wordAddress, Rvalue.PointerOffset {
    pointer: Operand.Copy {place: place(first)}, index: Operand.Copy {place: place(selected)}, element: Interned<Type>.clone(&word)}, origin)
}

// The reference operations over one package: a new reference from a handle, a control word load,
// store or compare-exchange, the fixed readiness endpoint, and liveness. Notification first claims
// the notifying marker, waiting while another thread's notification holds it; a drop that arrives
// while the endpoint runs is performed once it returns, and a notification that finds the package
// dropping or dead runs nothing (EXEC-009).
effect fn lowerReference(builder: &mut Builder, operation: StorageOperation, operands: List<Operand>, ty: &Interned<Type>,
  origin: Origin) -> Operand ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let mut values = move operands
  let loan = run operandPlace(&owner, List<Operand>.remove(&mut values, usize.ZERO), origin)
  let loaned = localType(&builder.*, loan.local)
  let referent = match move Interned<Type>.with<Option<Interned<Type>>>(&loaned, referentOf) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let mut handle = run copyPlace(&loan)
  run List<Projection>.append(&mut handle.projections, Projection.Deref)
  if operation == StorageOperation.ExecutionRefOf {
    let access = run packageAt(&mut builder.*, &handle, &referent, origin)
    return run grantReference(&mut builder.*, &access, ty, origin)
  }
  let access = run referencedPackage(&mut builder.*, &handle, &referent, origin)
  if operation == StorageOperation.ExecutionNotify {
    run List<EscapeSite>.append(&mut builder.function.escapes, EscapeSite {kind: AccessEscape.Callback, origin: origin})
  }
  match operation {
    StorageOperation.ExecutionLoad => {
      let selected = run controlWord(&mut builder.*, &access, List<Operand>.remove(&mut values, usize.ZERO), origin)
      let output = run wordAtomic(&mut builder.*, selected, IntrinsicPrimitive.AtomicLoad, List<Operand>.make(), MemoryOrder.Acquire, ty, origin)
      return Operand.Move {place: place(output)}
    }
    StorageOperation.ExecutionStore => {
      let selected = run controlWord(&mut builder.*, &access, List<Operand>.remove(&mut values, usize.ZERO), origin)
      let unit = run Types.intern(Type.Unit)
      let mut stored = List<Operand>.make()
      run List<Operand>.append(&mut stored, List<Operand>.remove(&mut values, usize.ZERO))
      drop run wordAtomic(&mut builder.*, selected, IntrinsicPrimitive.AtomicStore, move stored, MemoryOrder.Release, &unit, origin)
      return Operand.Unit
    }
    StorageOperation.ExecutionCompareExchange => {
      let selected = run controlWord(&mut builder.*, &access, List<Operand>.remove(&mut values, usize.ZERO), origin)
      let expected = List<Operand>.remove(&mut values, usize.ZERO)
      let desired = List<Operand>.remove(&mut values, usize.ZERO)
      let observed = run wordExchange(&mut builder.*, selected, move expected, move desired, origin)
      return Operand.Move {place: place(observed)}
    }
    StorageOperation.ExecutionLive => {
      let live = run livePackage(&mut builder.*, &access, origin)
      let output = run storageValue(&mut builder.*, ty, Rvalue.Use {value: move live}, origin)
      return Operand.Move {place: place(output)}
    }
    StorageOperation.ExecutionNotify => {
      let word = run storagePrimitive(b"usize")
      // The marker is 0 when idle, 1 while notifying, 2 when a drop waits for the endpoint, and 3
      // once the package is dropping.
      let marker = run headerAddress(&mut builder.*, &access, CoreField.HeaderNotifying, origin)
      let claiming = run block(&mut builder.*, origin)
      let holding = run block(&mut builder.*, origin)
      let busy = run block(&mut builder.*, origin)
      let after = run block(&mut builder.*, origin)
      terminate(&mut builder.*, Terminator.Goto {target: claiming, origin: origin})
      resume(&mut builder.*, claiming)
      let observed = run wordExchange(&mut builder.*, marker, run wordOperand(usize.ZERO), run wordOperand(usize.ONE), origin)
      let claimed = run storageCondition(&mut builder.*, InfixOperator.Equals, Operand.Copy {place: place(observed)},
        run wordOperand(usize.ZERO), origin)
      terminate(&mut builder.*, Terminator.Branch {condition: move claimed, thenBlock: holding, elseBlock: busy, origin: origin})
      // Another thread's notification of an earlier generation still runs the endpoint. This one is
      // the only winner of its own generation, so it waits for the marker instead of being lost.
      resume(&mut builder.*, busy)
      let held = run storageCondition(&mut builder.*, InfixOperator.Equals, Operand.Copy {place: place(observed)},
        run wordOperand(usize.ONE), origin)
      terminate(&mut builder.*, Terminator.Branch {condition: move held, thenBlock: claiming, elseBlock: after, origin: origin})
      resume(&mut builder.*, holding)
      let live = run livePackage(&mut builder.*, &access, origin)
      let notifying = run block(&mut builder.*, origin)
      let releasing = run block(&mut builder.*, origin)
      terminate(&mut builder.*, Terminator.Branch {condition: move live, thenBlock: notifying, elseBlock: releasing, origin: origin})
      resume(&mut builder.*, notifying)
      run callErased(&mut builder.*, &access, CoreField.HeaderNotify, origin)
      terminate(&mut builder.*, Terminator.Goto {target: releasing, origin: origin})
      resume(&mut builder.*, releasing)
      let mut cleared = List<Operand>.make()
      run List<Operand>.append(&mut cleared, run wordOperand(usize.ZERO))
      let previous = run wordAtomic(&mut builder.*, marker, IntrinsicPrimitive.AtomicSwap, move cleared, MemoryOrder.AcquireRelease, &word, origin)
      let pending = run storageCondition(&mut builder.*, InfixOperator.Equals, Operand.Copy {place: place(previous)}, run wordOperand(2), origin)
      let destroy = run block(&mut builder.*, origin)
      terminate(&mut builder.*, Terminator.Branch {condition: move pending, thenBlock: destroy, elseBlock: after, origin: origin})
      resume(&mut builder.*, destroy)
      run callErased(&mut builder.*, &access, CoreField.HeaderDrop, origin)
      terminate(&mut builder.*, Terminator.Goto {target: after, origin: origin})
      resume(&mut builder.*, after)
      return Operand.Unit
    }
    _ => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
}

// `run Intrinsic.relinquish()` leaves the running package's frames in the package, records the
// activation as relinquished and returns it to the drive; outside any package it traps. The
// instance is frame-based from here on (SUSP private lowering).
effect fn lowerRelinquish(builder: &mut Builder, origin: Origin) -> Operand
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  run markSuspension(&mut builder.*, origin)
  markPark(&mut builder.*, origin)
  let bytes = run SealedCore.bytes()
  let running = run storageValue(&mut builder.*, &bytes, Rvalue.RunningPackage, origin)
  let present = run storageCondition(&mut builder.*, InfixOperator.NotEquals, Operand.Copy {place: place(running)},
    Operand.Null {ty: Interned<Type>.clone(&bytes)}, origin)
  run trapUnless(&mut builder.*, move present, TrapReason.RelinquishOutsideExecution, origin)
  let resumed = run block(&mut builder.*, origin)
  let cancellable = match &builder.suspending { Option<List<InstanceKey>>.Some {..} => true _ => builder.cancelEveryCall }
  if cancellable { run recordCancel(&mut builder.*, origin) }
  terminate(&mut builder.*, Terminator.Relinquish {resume: resumed, origin: origin})
  resume(&mut builder.*, resumed)
  return Operand.Unit
}

// `run Intrinsic.executionCurrent()` grants a reference to the package whose frames are running;
// outside any package it traps. Only a frame-based instance can see its package.
effect fn lowerCurrent(builder: &mut Builder, ty: &Interned<Type>, origin: Origin) -> Operand
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  run markSuspension(&mut builder.*, origin)
  markPark(&mut builder.*, origin)
  let bytes = run SealedCore.bytes()
  let running = run storageValue(&mut builder.*, &bytes, Rvalue.RunningPackage, origin)
  let present = run storageCondition(&mut builder.*, InfixOperator.NotEquals, Operand.Copy {place: place(running)},
    Operand.Null {ty: Interned<Type>.clone(&bytes)}, origin)
  run trapUnless(&mut builder.*, move present, TrapReason.ExecutionReferenceOutsideExecution, origin)
  let anchor = match move run SealedCore.coreIdentity(ty) {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let word = run storagePrimitive(b"usize")
  let erased = run SealedCore.packageAddress()
  let integer = run storageValue(&mut builder.*, &word, Rvalue.AddressIntegerConversion {operand: Operand.Copy {place: place(running)},
    destinationType: Interned<Type>.clone(&word)}, origin)
  let package = run storageValue(&mut builder.*, &erased, Rvalue.AddressIntegerConversion {operand: Operand.Copy {place: place(integer)},
    destinationType: Interned<Type>.clone(&erased)}, origin)
  let access = run erasedHeader(&mut builder.*, &anchor, package, origin)
  return run grantReference(&mut builder.*, &access, ty, origin)
}

// Records the instance's first explicit suspension boundary.
effect fn markSuspension(builder: &mut Builder, origin: Origin) -> () ! OutOfMemoryError ? &mut Allocator {
  let marked = match &builder.function.suspension { Option<Origin>.Some {..} => true Option<Origin>.None => false }
  if !marked { builder.function.suspension = Option<Origin>.some(origin) }
  return ()
}

// Records the instance's first external park (`Intrinsic.relinquish` or `executionCurrent`).
fn markPark(builder: &mut Builder, origin: Origin) -> () {
  let marked = match &builder.function.parks { Option<Origin>.Some {..} => true Option<Origin>.None => false }
  if !marked { builder.function.parks = Option<Origin>.some(origin) }
  return ()
}

// Runs one activation of an unstarted or relinquished package in place. The erased start starts the
// body or resumes its stored frames. A completed body's result goes to the completion callback and
// the package is released through its erased drop; a relinquished body hands the branch state and
// the Execution to the suspension callback. The callback not called is released.
effect fn lowerDrive(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, node: BodyNodeId, origin: Origin) -> Operand
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let plan = match move takeStorage(&mut builder.*, node) {
    Option<StoragePlan>.Some {value} => move value
    Option<StoragePlan>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let mut values = run storageOperands(&mut builder.*, body, hir, node, 4, origin)
  if !builder.live { return Operand.Unit }
  let targets = List<CallTarget>.asSlice(&plan.targets)
  if targets.length != 2 { return run unsupported(&owner, origin, GapCode.TypedForm) }
  let mut types = List<Interned<Type>>.make()
  let mut children = List<BodyNodeId>.make()
  let mut argument = usize.ZERO
  while argument < 4 {
    let child = match move childAt(body, node, argument) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { return run unsupported(&owner, origin, GapCode.MissingCallArgument) }
    }
    run List<BodyNodeId>.append(&mut children, child)
    let typed = match move run instanceNodeType(&builder.*, body, child) {
      Option<Interned<Type>>.Some {value} => move value
      Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
    }
    run List<Interned<Type>>.append(&mut types, move typed)
    argument = argument + usize.ONE
  }
  let typed = List<Interned<Type>>.asSlice(&types)
  let arguments = List<BodyNodeId>.asSlice(&children)
  let handle = run storageValue(&mut builder.*, &typed[usize.ZERO], Rvalue.Use {value: List<Operand>.remove(&mut values, usize.ZERO)}, origin)
  let state = run storageValue(&mut builder.*, &typed[usize.ONE], Rvalue.Use {value: List<Operand>.remove(&mut values, usize.ZERO)}, origin)
  let completion = run storageValue(&mut builder.*, &typed[2], Rvalue.Use {value: List<Operand>.remove(&mut values, usize.ZERO)}, origin)
  let suspension = run storageValue(&mut builder.*, &typed[3], Rvalue.Use {value: List<Operand>.remove(&mut values, usize.ZERO)}, origin)
  let result = match move SealedCore.element(&typed[usize.ZERO]) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let access = run packageAt(&mut builder.*, &place(handle), &typed[usize.ZERO], origin)
  let recorded = run headerField(&access, CoreField.HeaderLifecycle)
  let unstarted = run storageCondition(&mut builder.*, InfixOperator.Equals, Operand.Copy {place: run copyPlace(&recorded)},
    run wordOperand(SealedCore.lifecycleWord(Lifecycle.Unstarted)), origin)
  let relinquished = run storageCondition(&mut builder.*, InfixOperator.Equals, Operand.Copy {place: run copyPlace(&recorded)},
    run wordOperand(SealedCore.lifecycleWord(Lifecycle.Relinquished)), origin)
  let admitted = run storageCondition(&mut builder.*, InfixOperator.BitOr, move unstarted, move relinquished, origin)
  run trapUnless(&mut builder.*, move admitted, TrapReason.InvalidExecutionDrive, origin)
  run recordLifecycle(&mut builder.*, &access, Lifecycle.Running, MemoryOrder.Relaxed, origin)
  run callErased(&mut builder.*, &access, CoreField.HeaderStart, origin)
  // The start returns with the activation still Running when the body completed.
  let parked = run storageCondition(&mut builder.*, InfixOperator.Equals, Operand.Copy {place: run copyPlace(&recorded)},
    run wordOperand(SealedCore.lifecycleWord(Lifecycle.Relinquished)), origin)
  let suspending = run block(&mut builder.*, origin)
  let completing = run block(&mut builder.*, origin)
  let joined = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: move parked, thenBlock: suspending, elseBlock: completing, origin: origin})
  let unit = run Types.intern(Type.Unit)
  let never = run Types.intern(Type.Union {members: List<Interned<Type>>.make()})
  let none = List<BoundPlace>.make()
  resume(&mut builder.*, suspending)
  let returned = run temporary(&mut builder.*, &unit, origin)
  let mut handed = List<Operand>.make()
  run List<Operand>.append(&mut handed, Operand.Move {place: place(state)})
  run List<Operand>.append(&mut handed, Operand.Move {place: place(handle)})
  run planCall(&mut builder.*, &targets[usize.ONE], &place(suspension), move handed, &unit, &never, returned, &FailureSink.Propagate,
    List<BoundPlace>.asSlice(&none), origin, usize.MAX)
  if !consumesCallable(&targets[usize.ONE]) { run releaseCallable(&mut builder.*, body, arguments[3], suspension, origin) }
  run releaseCallable(&mut builder.*, body, arguments[2], completion, origin)
  terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
  resume(&mut builder.*, completing)
  run recordLifecycle(&mut builder.*, &access, Lifecycle.Completed, MemoryOrder.Release, origin)
  let completed = run storageValue(&mut builder.*, &result, Rvalue.Use {value: Operand.Move {
    place: run headerField(&access, CoreField.HeaderResult)}}, origin)
  let output = run temporary(&mut builder.*, &unit, origin)
  let mut written = List<Operand>.make()
  run List<Operand>.append(&mut written, Operand.Move {place: place(state)})
  run List<Operand>.append(&mut written, Operand.Move {place: place(completed)})
  run planCall(&mut builder.*, &targets[usize.ZERO], &place(completion), move written, &unit, &never, output, &FailureSink.Propagate,
    List<BoundPlace>.asSlice(&none), origin, usize.MAX)
  if !consumesCallable(&targets[usize.ZERO]) { run releaseCallable(&mut builder.*, body, arguments[2], completion, origin) }
  run releaseCallable(&mut builder.*, body, arguments[3], suspension, origin)
  run callErased(&mut builder.*, &access, CoreField.HeaderDrop, origin)
  terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
  resume(&mut builder.*, joined)
  return Operand.Unit
}

fn referentOf(value: &Type) -> Option<Interned<Type>> {
  return match &value.* {
    Type.Reference {referent, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&referent))
    _ => Option<Interned<Type>>.none()
  }
}

// Expands one sealed storage primitive into ordinary MIR. Layout validation, bounds checks and
// count exhaustion trap; raw-buffer and slot contents are moved, copied or dropped only where the
// primitive names one selected element.
effect fn lowerStorage(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, node: BodyNodeId,
  operation: StorageOperation, ty: &Interned<Type>, origin: Origin) -> Operand ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  if operation == StorageOperation.Replace { return run lowerReplace(&mut builder.*, body, hir, node, ty, origin) }
  // Only a run executes the allocation boundary; a stored acquisition Effect has no runner.
  if operation == StorageOperation.SystemAllocationAcquire { return run unsupported(&owner, origin, GapCode.EffectForm) }
  // An activation, a relinquishment and the running package are Effects only their run executes,
  // in place.
  if operation == StorageOperation.ExecutionDrive || operation == StorageOperation.Relinquish
    || operation == StorageOperation.ExecutionCurrent {
    return run unsupported(&owner, origin, GapCode.EffectForm)
  }
  let plan = match move takeStorage(&mut builder.*, node) {
    Option<StoragePlan>.Some {value} => move value
    Option<StoragePlan>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let mut operands = run storageOperands(&mut builder.*, body, hir, node, StorageOperation.arity(operation), origin)
  if !builder.live { return Operand.Unit }
  let word = run storagePrimitive(b"usize")
  let address = run SealedCore.bytes()
  let mut element = run Types.intern(Type.Unit)
  if StorageOperation.typeArity(operation) > usize.ZERO {
    element = run storageArgumentType(&builder.*, body, node, usize.ZERO, origin)
  }
  if operation == StorageOperation.LayoutOf || operation == StorageOperation.SharedLayout
    || operation == StorageOperation.ExecutionLayout {
    let mut fields = List<AggregateField>.make()
    run List<AggregateField>.append(&mut fields, AggregateField {index: usize.ZERO, value: run wordOperand(plan.size)})
    run List<AggregateField>.append(&mut fields, AggregateField {index: usize.ONE, value: run wordOperand(plan.alignment)})
    let output = run storageValue(&mut builder.*, ty, Rvalue.Aggregate {fields: move fields}, origin)
    return Operand.Move {place: place(output)}
  }
  if operation == StorageOperation.SharedWithMut {
    return run lowerSharedAccess(&mut builder.*, body, node, &plan, move operands, &element, ty, origin)
  }
  if operation == StorageOperation.ExecutionFromAllocation {
    return run lowerExecutionPackage(&mut builder.*, body, node, move plan, move operands, ty, origin)
  }
  if operation == StorageOperation.ExecutionRefOf || operation == StorageOperation.ExecutionLoad
    || operation == StorageOperation.ExecutionStore || operation == StorageOperation.ExecutionCompareExchange
    || operation == StorageOperation.ExecutionNotify || operation == StorageOperation.ExecutionLive {
    return run lowerReference(&mut builder.*, operation, move operands, ty, origin)
  }
  // An adopted allocation records the caller's storage and the address of its reclaim function,
  // which the allocation's glue calls with the context in place of `free` (ALLOC-001).
  if operation == StorageOperation.AllocationAdopt {
    let base = run storageValue(&mut builder.*, &word, Rvalue.AddressIntegerConversion {
      operand: List<Operand>.remove(&mut operands, usize.ZERO), destinationType: Interned<Type>.clone(&word)}, origin)
    let layout = run operandPlace(&owner, List<Operand>.remove(&mut operands, usize.ZERO), origin)
    let reclaim = run storageValue(&mut builder.*, &word, Rvalue.AddressIntegerConversion {
      operand: List<Operand>.remove(&mut operands, usize.ZERO), destinationType: Interned<Type>.clone(&word)}, origin)
    let context = run storageValue(&mut builder.*, &word, Rvalue.AddressIntegerConversion {
      operand: List<Operand>.remove(&mut operands, usize.ZERO), destinationType: Interned<Type>.clone(&word)}, origin)
    let mut fields = List<AggregateField>.make()
    run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.AllocationBase), value: Operand.Copy {place: place(base)}})
    run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.AllocationBytes),
      value: Operand.Copy {place: run storagePlace(&layout, false, &[usize.ZERO])}})
    run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.AllocationAlignment),
      value: Operand.Copy {place: run storagePlace(&layout, false, &[usize.ONE])}})
    run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.AllocationReclaim), value: Operand.Copy {place: place(reclaim)}})
    run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.AllocationContext), value: Operand.Copy {place: place(context)}})
    let output = run storageValue(&mut builder.*, ty, Rvalue.Aggregate {fields: move fields}, origin)
    return Operand.Move {place: place(output)}
  }
  // An empty buffer has base at its alignment, a nonzero address aligned for the element that no
  // slot ever reads. Reclaim 0 with context 0 owns nothing, so its release does nothing.
  if operation == StorageOperation.RawBufferEmpty {
    let mut fields = List<AggregateField>.make()
    run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.BufferBase), value: run wordOperand(plan.alignment)})
    run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.BufferCount), value: run wordOperand(usize.ZERO)})
    run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.BufferReclaim), value: run wordOperand(usize.ZERO)})
    run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.BufferContext), value: run wordOperand(usize.ZERO)})
    let output = run storageValue(&mut builder.*, ty, Rvalue.Aggregate {fields: move fields}, origin)
    return Operand.Move {place: place(output)}
  }
  let first = run operandPlace(&owner, List<Operand>.remove(&mut operands, usize.ZERO), origin)
  match operation {
    StorageOperation.RawBufferFrom => {
      let count = run storageValue(&mut builder.*, &word, Rvalue.Use {value: List<Operand>.remove(&mut operands, usize.ZERO)}, origin)
      let expected = run storageValue(&mut builder.*, &word, Rvalue.Binary {operation: InfixOperator.Multiply,
        left: Operand.Copy {place: place(count)}, right: run wordOperand(plan.size)}, origin)
      let sized = run storageCondition(&mut builder.*, InfixOperator.Equals, Operand.Copy {place: place(expected)},
        Operand.Copy {place: run storagePlace(&first, false, &[SealedCore.ordinal(CoreField.AllocationBytes)])}, origin)
      let aligned = run storageCondition(&mut builder.*, InfixOperator.LessOrEqual, run wordOperand(plan.alignment),
        Operand.Copy {place: run storagePlace(&first, false, &[SealedCore.ordinal(CoreField.AllocationAlignment)])}, origin)
      let valid = run storageCondition(&mut builder.*, InfixOperator.BitAnd, move sized, move aligned, origin)
      run trapUnless(&mut builder.*, move valid, TrapReason.InvalidRawBufferLayout, origin)
      let mut fields = List<AggregateField>.make()
      // The buffer takes over the allocation's release: its reclaim and context move into the
      // buffer, and the allocation itself is consumed without running its glue.
      run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.BufferBase),
        value: Operand.Copy {place: run storagePlace(&first, false, &[SealedCore.ordinal(CoreField.AllocationBase)])}})
      run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.BufferCount), value: Operand.Copy {place: place(count)}})
      run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.BufferReclaim),
        value: Operand.Copy {place: run storagePlace(&first, false, &[SealedCore.ordinal(CoreField.AllocationReclaim)])}})
      run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.BufferContext),
        value: Operand.Copy {place: run storagePlace(&first, false, &[SealedCore.ordinal(CoreField.AllocationContext)])}})
      let output = run storageValue(&mut builder.*, ty, Rvalue.Aggregate {fields: move fields}, origin)
      return Operand.Move {place: place(output)}
    }
    StorageOperation.RawBufferCount => {
      let output = run storageValue(&mut builder.*, ty, Rvalue.Use {value: Operand.Copy {place: run storagePlace(&first, true,
        &[SealedCore.ordinal(CoreField.BufferCount)])}}, origin)
      return Operand.Copy {place: place(output)}
    }
    StorageOperation.RawBufferSlot => {
      let index = run storageValue(&mut builder.*, &word, Rvalue.Use {value: List<Operand>.remove(&mut operands, usize.ZERO)}, origin)
      let selected = run bufferElement(&mut builder.*, &first, index, &element, origin)
      let mut fields = List<AggregateField>.make()
      run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.SlotAddress), value: Operand.Copy {place: place(selected)}})
      let output = run storageValue(&mut builder.*, ty, Rvalue.Aggregate {fields: move fields}, origin)
      return Operand.Move {place: place(output)}
    }
    StorageOperation.RawBufferRead => {
      let index = run storageValue(&mut builder.*, &word, Rvalue.Use {value: List<Operand>.remove(&mut operands, usize.ZERO)}, origin)
      let selected = run bufferElement(&mut builder.*, &first, index, &element, origin)
      let output = run storageValue(&mut builder.*, ty, Rvalue.Use {value: Operand.Copy {place: run pointedPlace(selected)}}, origin)
      return Operand.Copy {place: place(output)}
    }
    StorageOperation.RawBufferView => {
      let offset = run storageValue(&mut builder.*, &word, Rvalue.Use {value: List<Operand>.remove(&mut operands, usize.ZERO)}, origin)
      let length = run storageValue(&mut builder.*, &word, Rvalue.Use {value: List<Operand>.remove(&mut operands, usize.ZERO)}, origin)
      run bufferRange(&mut builder.*, &first, offset, length, origin)
      let base = run bufferBase(&mut builder.*, &first, &element, origin)
      let pointer = run SealedCore.address(&element)
      let start = run storageValue(&mut builder.*, &pointer, Rvalue.PointerOffset {pointer: Operand.Copy {place: place(base)},
        index: Operand.Copy {place: place(offset)}, element: Interned<Type>.clone(&element)}, origin)
      let output = run storageValue(&mut builder.*, ty, Rvalue.Slice {data: Operand.Copy {place: place(start)},
        count: Operand.Copy {place: place(length)}}, origin)
      return Operand.Copy {place: place(output)}
    }
    StorageOperation.RawBufferViewMut => {
      let offset = run storageValue(&mut builder.*, &word, Rvalue.Use {value: List<Operand>.remove(&mut operands, usize.ZERO)}, origin)
      let length = run storageValue(&mut builder.*, &word, Rvalue.Use {value: List<Operand>.remove(&mut operands, usize.ZERO)}, origin)
      run bufferRange(&mut builder.*, &first, offset, length, origin)
      let base = run bufferBase(&mut builder.*, &first, &element, origin)
      let pointer = run SealedCore.address(&element)
      let start = run storageValue(&mut builder.*, &pointer, Rvalue.PointerOffset {pointer: Operand.Copy {place: place(base)},
        index: Operand.Copy {place: place(offset)}, element: Interned<Type>.clone(&element)}, origin)
      let output = run storageValue(&mut builder.*, ty, Rvalue.Slice {data: Operand.Copy {place: place(start)},
        count: Operand.Copy {place: place(length)}}, origin)
      return Operand.Copy {place: place(output)}
    }
    StorageOperation.RawBufferCopy => {
      let offset = run storageValue(&mut builder.*, &word, Rvalue.Use {value: List<Operand>.remove(&mut operands, usize.ZERO)}, origin)
      let source = run operandPlace(&owner, List<Operand>.remove(&mut operands, usize.ZERO), origin)
      let length = run storageValue(&mut builder.*, &word, Rvalue.Use {value: List<Operand>.remove(&mut operands, usize.ZERO)}, origin)
      run bufferRange(&mut builder.*, &first, offset, length, origin)
      let available = run storageValue(&mut builder.*, &word, Rvalue.SliceLength {place: run copyPlace(&source)}, origin)
      let supplied = run storageCondition(&mut builder.*, InfixOperator.LessOrEqual, Operand.Copy {place: place(length)},
        Operand.Copy {place: place(available)}, origin)
      run trapUnless(&mut builder.*, move supplied, TrapReason.RawBufferRangeOutOfBounds, origin)
      let base = run bufferBase(&mut builder.*, &first, &element, origin)
      let pointer = run SealedCore.address(&element)
      let start = run storageValue(&mut builder.*, &pointer, Rvalue.PointerOffset {pointer: Operand.Copy {place: place(base)},
        index: Operand.Copy {place: place(offset)}, element: Interned<Type>.clone(&element)}, origin)
      let destination = run storageValue(&mut builder.*, &address, Rvalue.Use {value: Operand.Copy {place: place(start)}}, origin)
      let data = run storageValue(&mut builder.*, &address, Rvalue.SliceData {place: move source}, origin)
      let bytes = run storageValue(&mut builder.*, &word, Rvalue.Binary {operation: InfixOperator.Multiply,
        left: Operand.Copy {place: place(length)}, right: run wordOperand(plan.size)}, origin)
      // memmove, not memcpy: an overlapping source and destination is a defined move.
      let mut arguments = List<Operand>.make()
      run List<Operand>.append(&mut arguments, Operand.Copy {place: place(destination)})
      run List<Operand>.append(&mut arguments, Operand.Copy {place: place(data)})
      run List<Operand>.append(&mut arguments, Operand.Copy {place: place(bytes)})
      drop run callAllocator(&mut builder.*, &plan, 2, move arguments, &address, origin)
      return Operand.Unit
    }
    StorageOperation.RawBufferResize => {
      return run lowerBufferResize(&mut builder.*, &plan, &first, List<Operand>.remove(&mut operands, usize.ZERO), ty, origin)
    }
    StorageOperation.RawBufferFill => {
      let offset = run storageValue(&mut builder.*, &word, Rvalue.Use {value: List<Operand>.remove(&mut operands, usize.ZERO)}, origin)
      let length = run storageValue(&mut builder.*, &word, Rvalue.Use {value: List<Operand>.remove(&mut operands, usize.ZERO)}, origin)
      let octet = run storagePrimitive(b"u8")
      let value = run storageValue(&mut builder.*, &octet, Rvalue.Use {value: List<Operand>.remove(&mut operands, usize.ZERO)}, origin)
      run bufferRange(&mut builder.*, &first, offset, length, origin)
      let base = run storageValue(&mut builder.*, &word, Rvalue.Use {value: Operand.Copy {place: run storagePlace(&first, true,
        &[SealedCore.ordinal(CoreField.BufferBase)])}}, origin)
      let start = run storageValue(&mut builder.*, &word, Rvalue.Binary {operation: InfixOperator.Add,
        left: Operand.Copy {place: place(base)}, right: Operand.Copy {place: place(offset)}}, origin)
      let destination = run storageValue(&mut builder.*, &address, Rvalue.AddressIntegerConversion {operand: Operand.Copy {place: place(start)},
        destinationType: Interned<Type>.clone(&address)}, origin)
      let integer = run storagePrimitive(b"i32")
      let widened = run storageValue(&mut builder.*, &integer, Rvalue.Convert {value: Operand.Copy {place: place(value)},
        ty: Interned<Type>.clone(&integer)}, origin)
      let mut arguments = List<Operand>.make()
      run List<Operand>.append(&mut arguments, Operand.Copy {place: place(destination)})
      run List<Operand>.append(&mut arguments, Operand.Copy {place: place(widened)})
      run List<Operand>.append(&mut arguments, Operand.Copy {place: place(length)})
      drop run callAllocator(&mut builder.*, &plan, 3, move arguments, &address, origin)
      return Operand.Unit
    }
    StorageOperation.SharedFromAllocation => {
      let value = run storageValue(&mut builder.*, &element, Rvalue.Use {value: List<Operand>.remove(&mut operands, usize.ZERO)}, origin)
      let sized = run storageCondition(&mut builder.*, InfixOperator.Equals,
        Operand.Copy {place: run storagePlace(&first, false, &[SealedCore.ordinal(CoreField.AllocationBytes)])}, run wordOperand(plan.size), origin)
      let aligned = run storageCondition(&mut builder.*, InfixOperator.Equals,
        Operand.Copy {place: run storagePlace(&first, false, &[SealedCore.ordinal(CoreField.AllocationAlignment)])}, run wordOperand(plan.alignment), origin)
      let valid = run storageCondition(&mut builder.*, InfixOperator.BitAnd, move sized, move aligned, origin)
      run trapUnless(&mut builder.*, move valid, TrapReason.InvalidSharedAllocationLayout, origin)
      let blockPointer = match move run SealedCore.fieldType(ty, CoreField.CoreBlock) {
        Option<Interned<Type>>.Some {value: selected} => move selected
        Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
      }
      let controlBlock = run storageValue(&mut builder.*, &blockPointer, Rvalue.AddressIntegerConversion {
        operand: Operand.Copy {place: run storagePlace(&first, false, &[SealedCore.ordinal(CoreField.AllocationBase)])},
        destinationType: Interned<Type>.clone(&blockPointer)}, origin)
      run assign(&mut builder.*, run storagePlace(&place(controlBlock), true, &[SealedCore.ordinal(CoreField.BlockStrong)]),
        Rvalue.Use {value: run wordOperand(usize.ONE)}, origin)
      run assign(&mut builder.*, run storagePlace(&place(controlBlock), true, &[SealedCore.ordinal(CoreField.BlockAccess)]),
        Rvalue.Use {value: run wordOperand(usize.ZERO)}, origin)
      run assign(&mut builder.*, run storagePlace(&place(controlBlock), true, &[SealedCore.ordinal(CoreField.BlockAllocation)]),
        Rvalue.Use {value: Operand.Move {place: run copyPlace(&first)}}, origin)
      run assign(&mut builder.*, run storagePlace(&place(controlBlock), true, &[SealedCore.ordinal(CoreField.BlockValue)]),
        Rvalue.Use {value: Operand.Move {place: place(value)}}, origin)
      let mut fields = List<AggregateField>.make()
      run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.CoreBlock), value: Operand.Copy {place: place(controlBlock)}})
      let output = run storageValue(&mut builder.*, ty, Rvalue.Aggregate {fields: move fields}, origin)
      return Operand.Move {place: place(output)}
    }
    StorageOperation.SharedClone => {
      let blockPointer = match move run SealedCore.fieldType(ty, CoreField.CoreBlock) {
        Option<Interned<Type>>.Some {value: selected} => move selected
        Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
      }
      let controlBlock = run storageValue(&mut builder.*, &blockPointer, Rvalue.Use {value: Operand.Copy {place: run storagePlace(&first, true,
        &[SealedCore.ordinal(CoreField.CoreBlock)])}}, origin)
      let strong = run storagePlace(&place(controlBlock), true, &[SealedCore.ordinal(CoreField.BlockStrong)])
      let count = run storageValue(&mut builder.*, &word, Rvalue.Use {value: Operand.Copy {place: run copyPlace(&strong)}}, origin)
      // The increment traps at count exhaustion, when it wraps to zero, before any handle is produced.
      let incremented = run storageValue(&mut builder.*, &word, Rvalue.ScalarBinary {operation: ScalarBinary.WrappingAdd,
        left: Operand.Copy {place: place(count)}, right: run wordOperand(usize.ONE)}, origin)
      let counted = run storageCondition(&mut builder.*, InfixOperator.NotEquals, Operand.Copy {place: place(incremented)},
        run wordOperand(usize.ZERO), origin)
      run trapUnless(&mut builder.*, move counted, TrapReason.SharedCountOverflow, origin)
      run assign(&mut builder.*, move strong, Rvalue.Use {value: Operand.Copy {place: place(incremented)}}, origin)
      let mut fields = List<AggregateField>.make()
      run List<AggregateField>.append(&mut fields, AggregateField {index: SealedCore.ordinal(CoreField.CoreBlock), value: Operand.Copy {place: place(controlBlock)}})
      let output = run storageValue(&mut builder.*, ty, Rvalue.Aggregate {fields: move fields}, origin)
      return Operand.Move {place: place(output)}
    }
    StorageOperation.StringUtf8Bytes => {
      let data = run storageValue(&mut builder.*, &address, Rvalue.SliceData {place: run copyPlace(&first)}, origin)
      let length = run storageValue(&mut builder.*, &word, Rvalue.SliceLength {place: run copyPlace(&first)}, origin)
      let output = run storageValue(&mut builder.*, ty, Rvalue.Slice {data: Operand.Copy {place: place(data)},
        count: Operand.Copy {place: place(length)}}, origin)
      return Operand.Copy {place: place(output)}
    }
    StorageOperation.StringFromUtf8Unchecked => {
      let data = run storageValue(&mut builder.*, &address, Rvalue.SliceData {place: run copyPlace(&first)}, origin)
      let length = run storageValue(&mut builder.*, &word, Rvalue.SliceLength {place: run copyPlace(&first)}, origin)
      let output = run storageValue(&mut builder.*, ty, Rvalue.Slice {data: Operand.Copy {place: place(data)},
        count: Operand.Copy {place: place(length)}}, origin)
      return Operand.Copy {place: place(output)}
    }
    StorageOperation.StringByteLength => {
      let output = run storageValue(&mut builder.*, ty, Rvalue.SliceLength {place: run copyPlace(&first)}, origin)
      return Operand.Copy {place: place(output)}
    }
    _ => {}
  }
  // The slot primitives act on the one element their selection addresses.
  let pointer = run SealedCore.address(&element)
  let selected = run storageValue(&mut builder.*, &pointer, Rvalue.Use {value: Operand.Copy {place: run storagePlace(&first, false,
    &[SealedCore.ordinal(CoreField.SlotAddress)])}}, origin)
  let stored = run pointedPlace(selected)
  match operation {
    StorageOperation.SlotWrite => {
      run assign(&mut builder.*, move stored, Rvalue.Use {value: List<Operand>.remove(&mut operands, usize.ZERO)}, origin)
      return Operand.Unit
    }
    StorageOperation.SlotTake => {
      let output = run storageValue(&mut builder.*, ty, Rvalue.Use {value: Operand.Move {place: move stored}}, origin)
      return Operand.Move {place: place(output)}
    }
    StorageOperation.SlotCopy => {
      let output = run storageValue(&mut builder.*, ty, Rvalue.Use {value: Operand.Copy {place: move stored}}, origin)
      return Operand.Copy {place: place(output)}
    }
    StorageOperation.SlotDrop => {
      if plan.cleanup { run dropPlace(&mut builder.*, move stored, &element, &owner, origin) }
      return Operand.Unit
    }
    StorageOperation.SlotAddress => { return Operand.Copy {place: place(selected)} }
    _ => { return run unsupported(&owner, origin, GapCode.IntrinsicMember) }
  }
}

// `run f(a)` of a named `effect fn` is a direct call of its instance (Effect note D1). A callee
// that can fail writes its failure to a fresh slot of its own failure type; that edge converts it
// into this function's `Failure`, drops every scope it leaves and fails (D3, D7).
effect fn lowerRun(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, runNode: BodyNodeId, value: BodyNodeId,
  ty: &Interned<Type>, origin: Origin) -> Operand ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  run List<EscapeSite>.append(&mut builder.function.escapes, EscapeSite {kind: AccessEscape.Suspension, origin: origin})
  // A composed Effect expands at this run site into ordinary calls, branches and edges (D4).
  let planned = takePlan(&mut builder.*, runNode)
  if let Option<List<RunPlan>>.Some {value: steps} = move planned {
    let evaluated = run expression(&mut builder.*, body, hir, value)
    if !builder.live { return Operand.Unit }
    let stored = match move evaluated {
      Operand.Copy {place: at} => move at
      Operand.Move {place: at} => move at
      _ => { return run unsupported(&owner, origin, GapCode.ExpectedPlace) }
    }
    let output = run temporary(&mut builder.*, ty, origin)
    let root = List<RunPlan>.length(&steps) - usize.ONE
    let mut bound = List<BoundPlace>.make()
    run executePlan(&mut builder.*, List<RunPlan>.asSlice(&steps), root, &stored, output, &FailureSink.Propagate, &mut bound, origin)
    return Operand.Copy {place: place(output)}
  }
  let construction = run instanceView(&mut builder.*, body, value)
  // The primitive allocation boundary runs in place, failing with its refusal.
  if let View.Storage {operation, node: storageNode, ..} = &construction {
    if operation == StorageOperation.SystemAllocationAcquire && TypedBody.immediateRun(body, runNode) {
      return run lowerAcquisition(&mut builder.*, body, hir, storageNode, ty, origin)
    }
    if operation == StorageOperation.ExecutionDrive && TypedBody.immediateRun(body, runNode) {
      return run lowerDrive(&mut builder.*, body, hir, storageNode, origin)
    }
    if operation == StorageOperation.Relinquish && TypedBody.immediateRun(body, runNode) {
      return run lowerRelinquish(&mut builder.*, origin)
    }
    if operation == StorageOperation.ExecutionCurrent && TypedBody.immediateRun(body, runNode) {
      return run lowerCurrent(&mut builder.*, ty, origin)
    }
  }
  let mut node = value
  let mut count = usize.ZERO
  let mut constructed = Option<Interned<Type>>.none()
  let mut invoked = false
  // The checker decided whether the operand is itself the call to run: an `effect fn` call or an
  // invocation of an `effect fn` value runs as one direct call of the target instance (D1, D4).
  let immediate = TypedBody.immediateRun(body, runNode)
  // An ordinary callee is called first; this run executes the Effect it returns (EFF-005).
  let returned = returnedEffect(&builder.*, value)
  let returnsEffect = match &returned { Option<Interned<Type>>.Some {..} => true _ => false }
  if let View.Call {environment, foreign, count: arguments, node: callNode, ty: callType, ..} = move construction {
    if let Option<Interned<DeclarationId>>.None = &foreign {
      let callable = environment
      if immediate && !returnsEffect {
        node = callNode
        count = arguments
        invoked = callable
        constructed = Option<Interned<Type>>.some(move callType)
      }
    }
  }
  // A stored Effect value runs through its exact representation's runner (D1): the run node is
  // the call, its operand the environment.
  let environment = match &constructed { Option<Interned<Type>>.None => true _ => false }
  if environment {
    count = usize.ONE
    node = runNode
    constructed = match move returned {
      Option<Interned<Type>>.Some {value: selected} => Option<Interned<Type>>.some(move selected)
      Option<Interned<Type>>.None => run instanceNodeType(&builder.*, body, value)
    }
  }
  let constructionType = match move constructed {
    Option<Interned<Type>>.Some {value: selected} => move selected
    Option<Interned<Type>>.None => { return CompilerBug.panic(b"a run value has no construction type") }
  }
  let promisedFailure = match move Interned<Type>.with<Option<Interned<Type>>>(&constructionType, effectFailure) {
    Option<Interned<Type>>.Some {value: selected} => move selected
    Option<Interned<Type>>.None => { return CompilerBug.panic(b"a run value is not an Effect") }
  }
  let calleeFailure = edgeFailure(&builder.*, node, &promisedFailure)
  let mut values = run callArguments(&mut builder.*, body, hir, node, count, environment || invoked, &Option<Interned<DeclarationId>>.none(), origin)
  if !builder.live { return Operand.Unit }
  if vacuousCall(&builder.*, node) {
    terminate(&mut builder.*, Terminator.Unreachable {origin: origin})
    return Operand.Unit
  }
  // A service operation's witness takes the dispatched provider's address as its receiver.
  let dispatched = callDispatch(&builder.*, node)
  if let Option<ProviderSource>.Some {value: dispatch} = &dispatched {
    let none = List<BoundPlace>.make()
    let receiver = run providerOperand(&mut builder.*, &dispatch, List<BoundPlace>.asSlice(&none), origin)
    run List<Operand>.insert(&mut values, usize.ZERO, move receiver)
  }
  let output = run temporary(&mut builder.*, ty, origin)
  let continuation = run block(&mut builder.*, origin)
  // The instance is reached by the call this run runs, as the bootstrap's incoming call span is;
  // a stored Effect is reached by the run itself.
  let mut reaching = origin
  if !environment { reaching = nodeOrigin(body, node) }
  let target = run callCallee(&mut builder.*, Option<Interned<DeclarationId>>.none(), Option<Shared<List<CAbi.VariadicArgument>>>.none(), node, &owner, reaching)
  let mut edge = Option<FailureEdge>.none()
  let mut caught = usize.MAX
  let mut handler = usize.MAX
  if !Interned<Type>.with<bool>(&calleeFailure, neverType) {
    if builder.failure == usize.MAX { return run unsupported(&owner, origin, GapCode.TypedForm) }
    caught = run caughtSlot(&mut builder.*, &calleeFailure, origin)
    handler = run block(&mut builder.*, origin)
    edge = Option<FailureEdge>.some(FailureEdge {destination: place(caught), target: handler,
})
  }
  let providers = run targetProviders(&mut builder.*, node, origin)
  let diagnostics = run calleeDiagnostics(&builder.*, &target, origin)
  run noteCancel(&mut builder.*, &target, origin)
  terminate(&mut builder.*, Terminator.Call {
    callee: move target, arguments: move values, providers: move providers, diagnostics: move diagnostics,
    destination: place(output), normal: continuation, failure: move edge, origin: origin,
  })
  if handler != usize.MAX {
    resume(&mut builder.*, handler)
    run propagateFailure(&mut builder.*, caught, &calleeFailure, origin)
  }
  return continueAfter(&mut builder.*, continuation, output, ty, origin)
}

// Resumes at a call's normal continuation and reads its result. A call whose success type is
// uninhabited never returns there, so the continuation is unreachable and no result flows on.
fn continueAfter(builder: &mut Builder, continuation: usize, output: usize, ty: &Interned<Type>, origin: Origin) -> Operand {
  resume(&mut builder.*, continuation)
  if Interned<Type>.with<bool>(ty, neverType) {
    terminate(&mut builder.*, Terminator.Unreachable {origin: origin})
    return Operand.Unit
  }
  return Operand.Copy {place: place(output)}
}

// The slot a run site catches a forwarded failure of type `ty` in, shared by every such site.
effect fn caughtSlot(builder: &mut Builder, ty: &Interned<Type>, origin: Origin) -> usize ! OutOfMemoryError ? &mut Allocator {
  let slots = List<CaughtSlot>.asSlice(&builder.caught)
  let mut at = usize.ZERO
  while at < slots.length {
    if Interned<Type>.same(&slots[at].ty, ty) { return slots[at].local }
    at = at + usize.ONE
  }
  let local = run temporary(&mut builder.*, ty, origin)
  run List<CaughtSlot>.append(&mut builder.*.caught, CaughtSlot {ty: Interned<Type>.clone(ty), local: local})
  return local
}

// Moves a caught failure into `Failure`, widening it into the caller's failure union, then leaves
// every open scope innermost first and fails. In a program that observes diagnostics the exit ends
// in the shared forward block, which records this site as the failure's next frame.
effect fn propagateFailure(builder: &mut Builder, caught: usize, from: &Interned<Type>, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let destination = builder.failure
  run widenInto(&mut builder.*, caught, from, destination, origin)
  run carry(&mut builder.*, caught, destination, origin)
  if !run forwardFrom(&mut builder.*, origin) { return run leaveFunction(&mut builder.*, ExitKind.Fails, origin) }
  return run leaveFunction(&mut builder.*, ExitKind.Forwards, origin)
}

// Names the current block's run site as the forwarded failure's next frame, for the shared forward
// block to record after the site's drops, and reports whether there is a frame to record: only a
// program that observes diagnostics records one. The current observer selects the block, since an
// observed body runs under an observer of its own; its first forwarding site creates it.
effect fn forwardFrom(builder: &mut Builder, origin: Origin) -> bool
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !builder.live { return false }
  let observer = match &builder.diagnostics {
    Option<DiagnosticPlaces>.Some {value} => run copyPlace(&value.observer)
    Option<DiagnosticPlaces>.None => { return false }
  }
  let label = match &builder.sites {
    Option<SiteText>.Some {value: sites} => run siteLabel(&sites, &builder.anchor, origin)
    Option<SiteText>.None => { return false }
  }
  if builder.forwardSite == usize.MAX { builder.forwardSite = run temporary(&mut builder.*, &run reportTextType(), origin) }
  builder.forward = usize.MAX
  let blocks = List<ForwardBlock>.asSlice(&builder.forwards)
  let mut at = usize.ZERO
  while at < blocks.length {
    if blocks[at].observer.local == observer.local
      && sameProjections(List<Projection>.asSlice(&blocks[at].observer.projections), List<Projection>.asSlice(&observer.projections)) {
      builder.forward = blocks[at].block
    }
    at = at + usize.ONE
  }
  if builder.forward == usize.MAX {
    let site = builder.current
    let shared = run block(&mut builder.*, origin)
    let text = builder.forwardSite
    let slot = builder.failure
    resume(&mut builder.*, shared)
    run frame(&mut builder.*, slot, text, origin)
    terminate(&mut builder.*, Terminator.Fail {origin: origin})
    resume(&mut builder.*, site)
    builder.forward = shared
    run List<ForwardBlock>.append(&mut builder.*.forwards, ForwardBlock {observer: move observer, block: shared})
  }
  let count = run usizeOperand(usize.toU64(Bytes.length(&label)))
  let named = builder.forwardSite
  run assign(&mut builder.*, place(named), Rvalue.Slice {data: Operand.StaticBytes {bytes: move label}, count: move count}, origin)
  return true
}

// Moves `caught`, of type `from`, into `destination`: as itself, injected under its tag, or, when
// `from` is a narrower union, each of its members re-injected under its tag in the wider one.
effect fn widenInto(builder: &mut Builder, caught: usize, from: &Interned<Type>, destination: usize, origin: Origin) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let into = localType(&builder.*, destination)
  match move run UnionProjection.within(&into, from) {
    Option<UnionPlacement>.Some {value: UnionPlacement.Whole} =>
      run assign(&mut builder.*, place(destination), Rvalue.Use {value: Operand.Move {place: place(caught)}}, origin)
    Option<UnionPlacement>.Some {value: UnionPlacement.Tagged {tag, ..}} =>
      run assign(&mut builder.*, place(destination), Rvalue.Inject {tag: tag, value: Operand.Move {place: place(caught)}}, origin)
    Option<UnionPlacement>.Some {value: UnionPlacement.Spread {tags, ..}} => {
      let narrower = match move run Type.canonicalUnionMembers(from) {
        Option<List<Interned<Type>>>.Some {value} => move value
        Option<List<Interned<Type>>>.None => CompilerBug.panic(b"a widened union is not a union")
      }
      let listed = List<Interned<Type>>.asSlice(&narrower)
      let wider = List<usize>.asSlice(&tags)
      let tagType = run Layout.tagType(listed.length)
      let read = run temporary(&mut builder.*, &tagType, origin)
      run assign(&mut builder.*, place(read), Rvalue.Discriminant {place: place(caught)}, origin)
      let joined = run block(&mut builder.*, origin)
      let mut cases = List<SwitchCase>.make()
      let mut targets = List<usize>.make()
      let mut at = usize.ZERO
      while at < listed.length {
        let arm = run block(&mut builder.*, origin)
        run List<usize>.append(&mut targets, arm)
        run List<SwitchCase>.append(&mut cases, SwitchCase {decimal: run Type.extentText(at), negative: false, target: arm})
        at = at + usize.ONE
      }
      let unreachable = run block(&mut builder.*, origin)
      terminate(&mut builder.*, Terminator.Switch {value: Operand.Copy {place: place(read)}, cases: move cases,
        otherwise: unreachable, origin: origin})
      at = usize.ZERO
      while at < listed.length {
        resume(&mut builder.*, List<usize>.asSlice(&targets)[at])
        let mut payload = place(caught)
        run List<Projection>.append(&mut payload.projections, Projection.Payload {index: at, ty: Interned<Type>.clone(&listed[at])})
        run assign(&mut builder.*, place(destination), Rvalue.Inject {tag: wider[at], value: Operand.Move {place: move payload}}, origin)
        terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
        at = at + usize.ONE
      }
      resume(&mut builder.*, joined)
    }
    Option<UnionPlacement>.None => CompilerBug.panic(b"a widening target does not contain its source")
  }
  return ()
}

// A checked scalar operation decides whether its exact result exists, then invokes exactly one
// carrier: `present` with that result, or `absent`. Each path consumes its own carrier and then
// drops the other, as an argument temporary the call left unconsumed.
effect fn checkedScalar(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  callNode: BodyNodeId,
  operation: ScalarOperation,
  ty: &Interned<Type>,
  origin: Origin,
) -> Operand ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  let plan = match move takeCarrierPlan(&mut builder.*, callNode) {
    Option<CarrierPlan>.Some {value} => move value
    Option<CarrierPlan>.None => run unsupported(&owner, origin, GapCode.IntrinsicMember)
  }
  let arity = ScalarOperation.arity(operation)
  let operandType = run CheckedIntrinsic.scalarType(ScalarOperation.operand(operation))
  let valueType = run CheckedIntrinsic.scalarType(ScalarOperation.result(operation))
  let boolean = run CheckedIntrinsic.scalarType(Scalar.Bool)
  let left = run temporary(&mut builder.*, &operandType, origin)
  let first = run scalarOperand(&mut builder.*, body, hir, callNode, usize.ZERO, operation, origin)
  run assign(&mut builder.*, place(left), Rvalue.Use {value: move first}, origin)
  let right = run temporary(&mut builder.*, &operandType, origin)
  if arity == 2 {
    let second = run scalarOperand(&mut builder.*, body, hir, callNode, usize.ONE, operation, origin)
    run assign(&mut builder.*, place(right), Rvalue.Use {value: move second}, origin)
  }
  let present = run intrinsicArgument(&mut builder.*, body, hir, callNode, arity, origin)
  let absent = run intrinsicArgument(&mut builder.*, body, hir, callNode, arity + usize.ONE, origin)
  if !builder.live { return Operand.Unit }
  let presentPlace = run operandPlace(&owner, move present, origin)
  let absentPlace = run operandPlace(&owner, move absent, origin)
  let exists = run temporary(&mut builder.*, &boolean, origin)
  if operation.code == ScalarCode.CheckedConvert {
    run assign(&mut builder.*, place(exists), Rvalue.Fits {value: Operand.Copy {place: place(left)},
      ty: Interned<Type>.clone(&valueType)}, origin)
  } else {
    let mut failure = ScalarBinary.DivisionUndefined
    if operation.code == ScalarCode.CheckedAdd { failure = ScalarBinary.AddOverflows }
    if operation.code == ScalarCode.CheckedSubtract { failure = ScalarBinary.SubtractOverflows }
    if operation.code == ScalarCode.CheckedMultiply { failure = ScalarBinary.MultiplyOverflows }
    let undefined = run temporary(&mut builder.*, &boolean, origin)
    run assign(&mut builder.*, place(undefined), Rvalue.ScalarBinary {operation: failure,
      left: Operand.Copy {place: place(left)}, right: Operand.Copy {place: place(right)}}, origin)
    run assign(&mut builder.*, place(exists), Rvalue.Unary {operation: PrefixOperator.Not,
      value: Operand.Copy {place: place(undefined)}}, origin)
  }
  let output = run temporary(&mut builder.*, ty, origin)
  let presentBlock = run block(&mut builder.*, origin)
  let absentBlock = run block(&mut builder.*, origin)
  let joined = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: Operand.Copy {place: place(exists)}, thenBlock: presentBlock,
    elseBlock: absentBlock, origin: origin})
  resume(&mut builder.*, presentBlock)
  // On this path the operation is defined, so its ordinary or wrapping form is exact.
  let mut exact = Rvalue.Convert {value: Operand.Copy {place: place(left)}, ty: Interned<Type>.clone(&valueType)}
  if operation.code == ScalarCode.CheckedAdd || operation.code == ScalarCode.CheckedSubtract || operation.code == ScalarCode.CheckedMultiply {
    let mut wrapping = ScalarBinary.WrappingAdd
    if operation.code == ScalarCode.CheckedSubtract { wrapping = ScalarBinary.WrappingSubtract }
    if operation.code == ScalarCode.CheckedMultiply { wrapping = ScalarBinary.WrappingMultiply }
    exact = Rvalue.ScalarBinary {operation: wrapping, left: Operand.Copy {place: place(left)}, right: Operand.Copy {place: place(right)}}
  }
  if operation.code == ScalarCode.CheckedDivide || operation.code == ScalarCode.CheckedRemainder {
    let mut quotient = InfixOperator.Divide
    if operation.code == ScalarCode.CheckedRemainder { quotient = InfixOperator.Remainder }
    exact = Rvalue.Binary {operation: quotient, left: Operand.Copy {place: place(left)}, right: Operand.Copy {place: place(right)}}
  }
  let produced = run temporary(&mut builder.*, &valueType, origin)
  run assign(&mut builder.*, place(produced), move exact, origin)
  let never = run Types.intern(Type.Union {members: List<Interned<Type>>.make()})
  let unbound = List<BoundPlace>.make()
  run planCall(&mut builder.*, &plan.present, &presentPlace, run singleOperand(Operand.Copy {place: place(produced)}), ty,
    &never, output, &FailureSink.Propagate, List<BoundPlace>.asSlice(&unbound), origin, usize.MAX)
  run dropUnused(&mut builder.*, &absentPlace, &plan.absentDrop, origin)
  terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
  resume(&mut builder.*, absentBlock)
  run planCall(&mut builder.*, &plan.absent, &absentPlace, List<Operand>.make(), ty, &never, output, &FailureSink.Propagate,
    List<BoundPlace>.asSlice(&unbound), origin, usize.MAX)
  run dropUnused(&mut builder.*, &presentPlace, &plan.presentDrop, origin)
  terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
  resume(&mut builder.*, joined)
  return Operand.Move {place: place(output)}
}

fn witnessIntrinsic(builder: &Builder, node: BodyNodeId) -> Option<IntrinsicMember> {
  let listed = List<WitnessIntrinsic>.asSlice(&builder.witnessIntrinsics)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].node.index == node.index { return Option<IntrinsicMember>.some(listed[at].member) }
    at = at + usize.ONE
  }
  return Option<IntrinsicMember>.none()
}

fn takeCarrierPlan(builder: &mut Builder, node: BodyNodeId) -> Option<CarrierPlan> {
  let mut at = usize.ZERO
  while at < List<CarrierPlan>.length(&builder.carriers) {
    if List<CarrierPlan>.asSlice(&builder.carriers)[at].node.index == node.index {
      return Option<CarrierPlan>.some(List<CarrierPlan>.remove(&mut builder.*.carriers, at))
    }
    at = at + usize.ONE
  }
  return Option<CarrierPlan>.none()
}

fn checkedOperation(member: IntrinsicMember) -> Option<ScalarOperation> {
  return match member {
    IntrinsicMember.Scalar {operation} => {
      if ScalarOperation.checked(operation) { return Option<ScalarOperation>.some(operation) }
      return Option<ScalarOperation>.none()
    }
    IntrinsicMember.Primitive {..} => Option<ScalarOperation>.none()
  }
}

fn takePlan(builder: &mut Builder, node: BodyNodeId) -> Option<List<RunPlan>> {
  let mut at = usize.ZERO
  while at < List<NodePlan>.length(&builder.plans) {
    if List<NodePlan>.asSlice(&builder.plans)[at].node.index == node.index {
      let found = List<NodePlan>.remove(&mut builder.*.plans, at)
      return Option<List<RunPlan>>.some(move found.steps)
    }
    at = at + usize.ONE
  }
  return Option<List<RunPlan>>.none()
}

// Delivers a failure held in `caught` to its sink: out of the function, or into a handler.
effect fn deliverFailure(builder: &mut Builder, caught: usize, from: &Interned<Type>, sink: &FailureSink, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  match &sink.* {
    FailureSink.Propagate => {
      let owner = InstanceKey.identity(&builder.function.key)
      if builder.failure == usize.MAX { return run unsupported(&owner, origin, GapCode.TypedForm) }
      run propagateFailure(&mut builder.*, caught, from, origin)
    }
    FailureSink.Catch {temp, block: target, ..} => {
      run widenInto(&mut builder.*, caught, from, temp, origin)
      run carry(&mut builder.*, caught, temp, origin)
      terminate(&mut builder.*, Terminator.Goto {target: target, origin: origin})
    }
  }
  return ()
}

// Appends a section call's operands after its environment in target parameter order: each stored
// field at its own lane and the written operands, already evaluated in source order, in the rest.
effect fn placeStoredLanes(builder: &mut Builder, values: &mut List<Operand>, environment: &Place, targetOperands: &[CallOperand],
  stored: &StoredArguments, written: List<Operand>, origin: Origin) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut supplied = move written
  let lanes = List<StoredLane>.asSlice(&stored.lanes)
  let operands = targetOperands
  let mut hidden = usize.ZERO
  if let Option<StoredEnvironment>.Some {..} = &stored.environment { hidden = usize.ONE }
  let mut at = usize.ZERO
  while at < lanes.length {
    match lanes[at] {
      StoredLane.Written => run List<Operand>.append(&mut values.*, List<Operand>.remove(&mut supplied, usize.ZERO))
      StoredLane.Field {index} => {
        let mut field = run copyPlace(environment)
        run List<Projection>.append(&mut field.projections, Projection.Field {index: index})
        if stored.consumes { run List<Operand>.append(&mut values.*, Operand.Move {place: move field}) }
        else { run List<Operand>.append(&mut values.*, Operand.Copy {place: move field}) }
      }
      StoredLane.Lent {index, access, cleanup} => {
        let mut field = run copyPlace(environment)
        run List<Projection>.append(&mut field.projections, Projection.Field {index: index})
        let operand = &operands[hidden + at]
        if stored.consumes {
          // The run consumes the Effect, so the lent value leaves it and lives until the call ends.
          let held = run temporary(&mut builder.*, &operand.value, origin)
          run assign(&mut builder.*, place(held), Rvalue.Use {value: Operand.Move {place: move field}}, origin)
          if cleanup { run pend(&mut builder.*, held) }
          field = place(held)
        }
        let reference = run temporary(&mut builder.*, &operand.parameter, origin)
        run assign(&mut builder.*, place(reference), Rvalue.Ref {access: access, place: move field}, origin)
        run List<Operand>.append(&mut values.*, Operand.Copy {place: place(reference)})
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// The operands of a prepared target whose environment is the Effect stored at `environment`, with
// the written operands in their parameter positions (MIR note §7).
effect fn placeArguments(builder: &mut Builder, target: &CallTarget, environment: &Place, written: List<Operand>,
  origin: Origin) -> List<Operand> ! OutOfMemoryError ? &mut Allocator {
  let mut values = List<Operand>.make()
  let mut supplied = move written
  if let Option<StoredArguments>.Some {value: stored} = &target.stored {
    if let Option<StoredEnvironment>.Some {value: input} = &stored.environment {
      let mut field = run copyPlace(environment)
      run List<Projection>.append(&mut field.projections, Projection.Field {index: input.field})
      if let Option<Access>.Some {value: access} = &input.borrow {
        let reference = run temporary(&mut builder.*, &input.parameter, origin)
        run assign(&mut builder.*, place(reference), Rvalue.Ref {access: access, place: move field}, origin)
        run List<Operand>.append(&mut values, Operand.Copy {place: place(reference)})
      } else { run List<Operand>.append(&mut values, Operand.Move {place: move field}) }
    }
    run placeStoredLanes(&mut builder.*, &mut values, environment, List<CallOperand>.asSlice(&target.operands), &stored, move supplied, origin)
    return move values
  }
  // An anonymous body receives its whole environment first, lent or moved per its run access.
  let operands = List<CallOperand>.asSlice(&target.operands)
  let mut lent = Option<Access>.none()
  let mut parameter = Option<Interned<Type>>.none()
  if operands.length > usize.ZERO {
    lent = copyAccess(&operands[usize.ZERO].borrow)
    parameter = Option<Interned<Type>>.some(Interned<Type>.clone(&operands[usize.ZERO].parameter))
  }
  match move lent {
    Option<Access>.Some {value: access} => {
      if let Option<Interned<Type>>.Some {value: referenceType} = move parameter {
        let reference = run temporary(&mut builder.*, &referenceType, origin)
        run assign(&mut builder.*, place(reference), Rvalue.Ref {access: access, place: run copyPlace(environment)}, origin)
        run List<Operand>.append(&mut values, Operand.Copy {place: place(reference)})
      }
    }
    Option<Access>.None => { run List<Operand>.append(&mut values, Operand.Move {place: run copyPlace(environment)}) }
  }
  while List<Operand>.length(&supplied) > usize.ZERO {
    run List<Operand>.append(&mut values, List<Operand>.remove(&mut supplied, usize.ZERO))
  }
  return move values
}

// Calls a prepared target, writing success to `output` (injected when `output` is a wider union)
// and routing a failure of the callee's own type to `sink`. Emission continues on the success edge.
// `releasing`, when not `usize.MAX`, is a caught failure slot whose context the call's outcome
// releases: the call is that failure's handler (N7).
effect fn planCall(builder: &mut Builder, target: &CallTarget, environment: &Place, written: List<Operand>,
  success: &Interned<Type>, failure: &Interned<Type>, output: usize, sink: &FailureSink, bound: &[BoundPlace], origin: Origin,
  releasing: usize) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let _owner = InstanceKey.identity(&builder.function.key)
  let mut values = run placeArguments(&mut builder.*, target, environment, move written, origin)
  run widenCallOperands(&mut builder.*, List<CallOperand>.asSlice(&target.operands), &mut values, origin)
  if target.vacuous {
    terminate(&mut builder.*, Terminator.Unreachable {origin: origin})
    return ()
  }
  // Stored lanes name the service operation's original parameters. Its selected witness adds a
  // provider receiver before those parameters, after their written/stored operands are placed.
  if let Option<ProviderSource>.Some {value: dispatch} = &target.dispatch {
    let receiver = run providerOperand(&mut builder.*, &dispatch, bound, origin)
    run List<Operand>.insert(&mut values, usize.ZERO, move receiver)
  }
  let providers = run providerOperands(&mut builder.*, List<ProviderSource>.asSlice(&target.providers), bound, origin)
  let outputType = localType(&builder.*, output)
  let mut destination = output
  // A success named by a producer family and its realized storage are the same runtime value.
  let realizedSuccess = run RuntimeType.applyBindings(success, List<Binding>.asSlice(&builder.bindings),
    List<RuntimeProjection>.asSlice(&builder.projections))
  let realizedOutput = run RuntimeType.applyBindings(&outputType, List<Binding>.asSlice(&builder.bindings),
    List<RuntimeProjection>.asSlice(&builder.projections))
  let direct = run Type.runtimeEqualsShared(&realizedSuccess, &realizedOutput)
  if !direct { destination = run temporary(&mut builder.*, success, origin) }
  let continuation = run block(&mut builder.*, origin)
  run List<Reference>.append(&mut builder.*.function.references,
    Reference {key: InstanceKey.copy(&target.key), edge: Edge.copy(&target.edge), origin: origin})
  if target.nonParking { run oweNonParking(&mut builder.*, &target.key, origin) }
  let calleeFailure = match &target.witnessFailure {
    Option<Interned<Type>>.Some {value} => Interned<Type>.clone(&value)
    Option<Interned<Type>>.None => Interned<Type>.clone(failure)
  }
  let mut edge = Option<FailureEdge>.none()
  let mut caught = usize.MAX
  let mut handler = usize.MAX
  if !Interned<Type>.with<bool>(&calleeFailure, neverType) {
    caught = run temporary(&mut builder.*, &calleeFailure, origin)
    handler = run block(&mut builder.*, origin)
    edge = Option<FailureEdge>.some(FailureEdge {destination: place(caught), target: handler})
  }
  let callee = Callee.Instance {key: InstanceKey.copy(&target.key)}
  let diagnostics = run calleeDiagnostics(&builder.*, &callee, origin)
  if releasing != usize.MAX {
    run List<HeldFailure>.append(&mut builder.*.held, HeldFailure {slot: releasing, cleanup: Option<Interned<Type>>.none(),
      depth: List<CancelScope>.length(&builder.cancelScopes)})
  }
  run noteCancel(&mut builder.*, &callee, origin)
  if releasing != usize.MAX { drop List<HeldFailure>.pop(&mut builder.*.held) }
  terminate(&mut builder.*, Terminator.Call {callee: move callee,
    arguments: move values, providers: move providers, diagnostics: move diagnostics, destination: place(destination),
    normal: continuation, failure: move edge, origin: origin})
  if handler != usize.MAX {
    resume(&mut builder.*, handler)
    if releasing != usize.MAX { run release(&mut builder.*, releasing, origin) }
    run deliverFailure(&mut builder.*, caught, &calleeFailure, sink, origin)
  }
  resume(&mut builder.*, continuation)
  if releasing != usize.MAX { run release(&mut builder.*, releasing, origin) }
  if !direct {
    // A handler that cannot succeed never reaches the join.
    if Interned<Type>.with<bool>(success, neverType) {
      terminate(&mut builder.*, Terminator.Unreachable {origin: origin})
      return ()
    }
    run widenInto(&mut builder.*, destination, success, output, origin)
  }
  return ()
}

// Widens each operand a call supplies at a member of its target's wider union parameter, as the
// `Frozen` left to handle passed to a handler `fn(error: Overdrawn | Frozen)`. `values` are the
// call's operands in target parameter order, aligned with the prepared `operands`.
effect fn widenCallOperands(builder: &mut Builder, operands: &[CallOperand], values: &mut List<Operand>, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if operands.length != List<Operand>.length(&values.*) { return () }
  let mut at = usize.ZERO
  while at < operands.length {
    let widens = Interned<Type>.with<bool>(&operands[at].parameter, unionType)
      && !(run Type.runtimeEqualsShared(&operands[at].value, &operands[at].parameter))
    if widens {
      let supplied = List<Operand>.remove(&mut values.*, at)
      let held = run temporary(&mut builder.*, &operands[at].value, origin)
      run assign(&mut builder.*, place(held), Rvalue.Use {value: move supplied}, origin)
      let widened = run temporary(&mut builder.*, &operands[at].parameter, origin)
      run widenInto(&mut builder.*, held, &operands[at].value, widened, origin)
      run List<Operand>.insert(&mut values.*, at, Operand.Move {place: place(widened)})
    }
    at = at + usize.ONE
  }
  return ()
}

// The prepared operands of the call at `node`, copied out of the builder's call targets.
effect fn preparedOperands(builder: &Builder, node: BodyNodeId) -> List<CallOperand> ! OutOfMemoryError ? &mut Allocator {
  let calls = List<CallTarget>.asSlice(&builder.calls)
  let mut copied = List<CallOperand>.make()
  let mut at = usize.ZERO
  while at < calls.length {
    if calls[at].node.index == node.index {
      let operands = List<CallOperand>.asSlice(&calls[at].operands)
      let mut index = usize.ZERO
      while index < operands.length {
        run List<CallOperand>.append(&mut copied, CallOperand {value: Interned<Type>.clone(&operands[index].value),
          parameter: Interned<Type>.clone(&operands[index].parameter), borrow: copyAccess(&operands[index].borrow)})
        index = index + usize.ONE
      }
      return move copied
    }
    at = at + usize.ONE
  }
  return move copied
}

fn unionType(value: &Type) -> bool {
  return match &value.* { Type.Union {..} => true _ => false }
}

effect fn dropUnused(builder: &mut Builder, part: &Place, ty: &Option<Interned<Type>>, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Interned<Type>>.Some {value} = &ty.* {
    let owner = InstanceKey.identity(&builder.function.key)
    run dropPlace(&mut builder.*, run copyPlace(part), &value, &owner, origin)
  }
  return ()
}

effect fn projectedPart(environment: &Place, index: usize) -> Place ! OutOfMemoryError ? &mut Allocator {
  let mut part = run copyPlace(environment)
  run List<Projection>.append(&mut part.projections, Projection.Field {index: index})
  return move part
}

// Expands one composed Effect stored at `environment` into calls and edges (Effect note D4).
effect fn executePlan(builder: &mut Builder, steps: &[RunPlan], step: usize, environment: &Place, output: usize,
  sink: &FailureSink, bound: &mut List<BoundPlace>, origin: Origin) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&builder.function.key)
  match &steps[step] {
    RunPlan.Runner {target, success, failure, partDrop} => {
      run callAndDrop(&mut builder.*, &target, environment, List<Operand>.make(), &success, &failure, output, sink,
        List<BoundPlace>.asSlice(&bound.*), origin, usize.MAX, &partDrop)
    }
    RunPlan.Join {arms, tagged} => {
      let listed = List<JoinArm>.asSlice(&arms)
      if !tagged { return run executePlan(&mut builder.*, steps, listed[usize.ZERO].step, environment, output, sink, &mut bound.*, origin) }
      // Only the selected alternative runs; each arm reads its payload in place (D1, D3).
      let tagType = run Layout.tagType(listed.length)
      let read = run temporary(&mut builder.*, &tagType, origin)
      run assign(&mut builder.*, place(read), Rvalue.Discriminant {place: run copyPlace(environment)}, origin)
      let joined = run block(&mut builder.*, origin)
      let mut cases = List<SwitchCase>.make()
      let mut targets = List<usize>.make()
      let mut at = usize.ZERO
      while at < listed.length {
        let arm = run block(&mut builder.*, origin)
        run List<usize>.append(&mut targets, arm)
        run List<SwitchCase>.append(&mut cases, SwitchCase {decimal: run Type.extentText(listed[at].tag), negative: false, target: arm})
        at = at + usize.ONE
      }
      let unreachable = run block(&mut builder.*, origin)
      terminate(&mut builder.*, Terminator.Switch {value: Operand.Copy {place: place(read)}, cases: move cases,
        otherwise: unreachable, origin: origin})
      at = usize.ZERO
      while at < listed.length {
        resume(&mut builder.*, List<usize>.asSlice(&targets)[at])
        let mut payload = run copyPlace(environment)
        run List<Projection>.append(&mut payload.projections, Projection.Payload {index: listed[at].tag, ty: Interned<Type>.clone(&listed[at].ty)})
        run executePlan(&mut builder.*, steps, listed[at].step, &payload, output, sink, &mut bound.*, origin)
        terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
        at = at + usize.ONE
      }
      resume(&mut builder.*, joined)
    }
    RunPlan.Bind {inner, providerDrop} => {
      // The provider part stays in place; its address reaches every runner below this binding.
      let providerPart = run projectedPart(environment, usize.ONE)
      run List<BoundPlace>.append(&mut bound.*, BoundPlace {place: run copyPlace(&providerPart)})
      let protectedPart = run projectedPart(environment, usize.ZERO)
      if let Option<ProviderDrop>.Some {value: dropping} = &providerDrop {
        if Interned<Type>.with<bool>(&dropping.innerFailure, neverType) {
          run executePlan(&mut builder.*, steps, inner, &protectedPart, output, sink, &mut bound.*, origin)
          drop List<BoundPlace>.pop(&mut bound.*)
          return run dropPlace(&mut builder.*, move providerPart, &dropping.provider, &owner, origin)
        }
        // Both exits drop the provider; a failure is held in `caught` until it is dropped (D4).
        let caught = run temporary(&mut builder.*, &dropping.innerFailure, origin)
        let failing = run block(&mut builder.*, origin)
        let joined = run block(&mut builder.*, origin)
        run executePlan(&mut builder.*, steps, inner, &protectedPart, output, &FailureSink.Catch {temp: caught, block: failing},
          &mut bound.*, origin)
        drop List<BoundPlace>.pop(&mut bound.*)
        run dropPlace(&mut builder.*, run copyPlace(&providerPart), &dropping.provider, &owner, origin)
        terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
        resume(&mut builder.*, failing)
        run dropPlace(&mut builder.*, move providerPart, &dropping.provider, &owner, origin)
        run deliverFailure(&mut builder.*, caught, &dropping.innerFailure, sink, origin)
        resume(&mut builder.*, joined)
        return ()
      }
      run executePlan(&mut builder.*, steps, inner, &protectedPart, output, sink, &mut bound.*, origin)
      drop List<BoundPlace>.pop(&mut bound.*)
    }
    RunPlan.Lent {inner} => {
      let mut lender = run copyPlace(environment)
      run List<Projection>.append(&mut lender.projections, Projection.Deref)
      run executePlan(&mut builder.*, steps, inner, &lender, output, sink, &mut bound.*, origin)
    }
    RunPlan.Interrupt {inner} => {
      // The body's frames above this one are abandoned by an interrupt for the token, which
      // resumes here with `false` once the cleanup opened inside the boundary has run.
      let tokenType = run usizeType()
      let token = run temporary(&mut builder.*, &tokenType, origin)
      run assign(&mut builder.*, place(token), Rvalue.Use {value: Operand.Copy {place: run projectedPart(environment, usize.ZERO)}},
        origin)
      let bodyPart = run projectedPart(environment, usize.ONE)
      run List<InterruptBoundary>.append(&mut builder.*.interrupts, InterruptBoundary {token: token,
        scopes: List<CancelScope>.length(&builder.cancelScopes), held: List<HeldFailure>.length(&builder.held),
        continuation: usize.MAX})
      let unit = run Types.intern(Type.Unit)
      let done = run temporary(&mut builder.*, &unit, origin)
      run executePlan(&mut builder.*, steps, inner, &bodyPart, done, sink, &mut bound.*, origin)
      let boundary = match move List<InterruptBoundary>.pop(&mut builder.*.interrupts) {
        Option<InterruptBoundary>.Some {value} => move value
        Option<InterruptBoundary>.None => { return CompilerBug.panic(b"an interrupt boundary was popped twice") }
      }
      run assign(&mut builder.*, place(output), Rvalue.Use {value: Operand.Boolean {value: true}}, origin)
      if boundary.continuation == usize.MAX { return () }
      let joined = run block(&mut builder.*, origin)
      terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
      resume(&mut builder.*, boundary.continuation)
      run assign(&mut builder.*, place(output), Rvalue.Use {value: Operand.Boolean {value: false}}, origin)
      terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
      resume(&mut builder.*, joined)
    }
    RunPlan.Suspend {inner} => {
      run markSuspension(&mut builder.*, origin)
      let deferredPart = run projectedPart(environment, usize.ZERO)
      run executePlan(&mut builder.*, steps, inner, &deferredPart, output, sink, &mut bound.*, origin)
    }
    RunPlan.Observe {inner, state, stateDrop, callable, callbackDrop, callback, owed} => {
      if owed { run oweNonParking(&mut builder.*, &callback.key, origin) }
      // The body runs under the record `[adapter, &mut state, &callback]` with no selected failure
      // (N1, N2), then the callback and the state drop. Its presence makes the whole program
      // observe diagnostics.
      builder.function.observes = true
      let statePart = run projectedPart(environment, usize.ZERO)
      let callbackPart = run projectedPart(environment, usize.ONE)
      let bodyPart = run projectedPart(environment, 2)
      let observing = match &builder.diagnostics { Option<DiagnosticPlaces>.Some {..} => true _ => false }
      if !observing {
        run openCancelScope(&mut builder.*)
        run executePlan(&mut builder.*, steps, inner, &bodyPart, output, sink, &mut bound.*, origin)
        run dropPartsOnCancel(&mut builder.*, &callbackPart, &callbackDrop, &statePart, &stateDrop, origin)
        run dropUnused(&mut builder.*, &callbackPart, &callbackDrop, origin)
        return run dropUnused(&mut builder.*, &statePart, &stateDrop, origin)
      }
      let adapter = run observerAdapter(&mut builder.*, step, &state, &callable, &callback, origin)
      let word = run addressType()
      let function = run temporary(&mut builder.*, &word, origin)
      run List<Reference>.append(&mut builder.*.function.references,
        Reference {key: InstanceKey.copy(&adapter), edge: Edge.Direct, origin: origin})
      run assign(&mut builder.*, place(function), Rvalue.FunctionAddress {key: move adapter}, origin)
      let address = run temporary(&mut builder.*, &state, origin)
      run assign(&mut builder.*, place(address), Rvalue.AddressOf {access: Access.Mutable, place: run copyPlace(&statePart)}, origin)
      let lent = run temporary(&mut builder.*, &callable, origin)
      run assign(&mut builder.*, place(lent), Rvalue.AddressOf {access: Access.Shared, place: run copyPlace(&callbackPart)}, origin)
      let record = run temporary(&mut builder.*, &run observerRecord(), origin)
      let mut fields = List<AggregateField>.make()
      run List<AggregateField>.append(&mut fields, AggregateField {index: usize.ZERO, value: Operand.Copy {place: place(function)}})
      run List<AggregateField>.append(&mut fields, AggregateField {index: usize.ONE, value: Operand.Copy {place: place(address)}})
      run List<AggregateField>.append(&mut fields, AggregateField {index: 2, value: Operand.Copy {place: place(lent)}})
      run assign(&mut builder.*, place(record), Rvalue.Aggregate {fields: move fields}, origin)
      let observer = run temporary(&mut builder.*, &run observerAddress(), origin)
      run assign(&mut builder.*, place(observer), Rvalue.AddressOf {access: Access.Shared, place: place(record)}, origin)
      let none = run temporary(&mut builder.*, &run causeType(), origin)
      run assign(&mut builder.*, place(none), Rvalue.Use {value: Operand.Null {ty: run causeType()}}, origin)
      run openCancelScope(&mut builder.*)
      let entered = run currentSite(&mut builder.*, origin)
      let outer = swapDiagnostics(&mut builder.*, Option<DiagnosticPlaces>.some(DiagnosticPlaces {observer: place(observer),
        cause: place(none), site: move entered}))
      run executePlan(&mut builder.*, steps, inner, &bodyPart, output, sink, &mut bound.*, origin)
      drop swapDiagnostics(&mut builder.*, move outer)
      // A cancelled body drops both parts after its exits released their nodes, as a completed one does.
      run dropPartsOnCancel(&mut builder.*, &callbackPart, &callbackDrop, &statePart, &stateDrop, origin)
      run dropUnused(&mut builder.*, &callbackPart, &callbackDrop, origin)
      run dropUnused(&mut builder.*, &statePart, &stateDrop, origin)
    }
    RunPlan.Catch {selector, inner, innerFailure, handler, handlerSuccess, handlerFailure, handlerDrop, handlerKept} => {
      let mut keptDrop = Option<Interned<Type>>.none()
      if handlerKept { keptDrop = copyOptionalType(&handlerDrop) }
      // The protected Effect fails into a temporary of its own failure type; the edge selects.
      let caught = run temporary(&mut builder.*, &innerFailure, origin)
      let selecting = run block(&mut builder.*, origin)
      let joined = run block(&mut builder.*, origin)
      let protectedPart = run projectedPart(environment, usize.ZERO)
      let handlerPart = run projectedPart(environment, usize.ONE)
      let local = FailureSink.Catch {temp: caught, block: selecting}
      run openCancelScope(&mut builder.*)
      run executePlan(&mut builder.*, steps, inner, &protectedPart, output, &local, &mut bound.*, origin)
      run dropOnCancel(&mut builder.*, &handlerPart, &handlerDrop, origin)
      run dropUnused(&mut builder.*, &handlerPart, &handlerDrop, origin)
      terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
      resume(&mut builder.*, selecting)
      let failureUnion = Interned<Type>.with<bool>(&innerFailure, unionType)
      let mut canonical = run Type.canonicalUnionMembers(&innerFailure)
      if failureUnion {
        if let Option<List<Interned<Type>>>.None = &canonical { return CompilerBug.panic(b"a caught failure union has no canonical members") }
      }
      // Selecting the whole failure needs no switch (D4).
      if run Type.runtimeEqualsShared(&selector, &innerFailure) { canonical = Option<List<Interned<Type>>>.none() }
      let members = match move canonical {
        Option<List<Interned<Type>>>.Some {value} => move value
        Option<List<Interned<Type>>>.None => {
          // One failure type, or the whole failure: it is the selection. A handler section whose
          // own parameter fixed a wider selector, as `parse() |> Effect.catchAll(explain)` with
          // `explain(error: UsageError | BoardFull)`, receives the one failure injected into it.
          let mut argument = Operand.Move {place: place(caught)}
          let exact = run Type.runtimeEqualsShared(&selector, &innerFailure)
          if !exact && Interned<Type>.with<bool>(&selector, unionType) {
            let widened = run temporary(&mut builder.*, &selector, origin)
            run widenInto(&mut builder.*, caught, &innerFailure, widened, origin)
            argument = Operand.Move {place: place(widened)}
          }
          let outer = run selectCause(&mut builder.*, caught, origin)
          run callAndDrop(&mut builder.*, &handler, &handlerPart, run singleOperand(move argument),
            &handlerSuccess, &handlerFailure, output, sink, List<BoundPlace>.asSlice(&bound.*), origin, caught, &keptDrop)
          drop swapDiagnostics(&mut builder.*, move outer)
          terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
          resume(&mut builder.*, joined)
          return ()
        }
      }
      let listed = List<Interned<Type>>.asSlice(&members)
      let selectedMembers = run Type.canonicalUnionMembers(&selector)
      let tagType = run Layout.tagType(listed.length)
      let read = run temporary(&mut builder.*, &tagType, origin)
      run assign(&mut builder.*, place(read), Rvalue.Discriminant {place: place(caught)}, origin)
      let mut cases = List<SwitchCase>.make()
      let mut arms = List<usize>.make()
      let mut at = usize.ZERO
      while at < listed.length {
        let arm = run block(&mut builder.*, origin)
        run List<usize>.append(&mut arms, arm)
        run List<SwitchCase>.append(&mut cases, SwitchCase {decimal: run Type.extentText(at), negative: false, target: arm})
        at = at + usize.ONE
      }
      let unreachable = run block(&mut builder.*, origin)
      terminate(&mut builder.*, Terminator.Switch {value: Operand.Copy {place: place(read)}, cases: move cases,
        otherwise: unreachable, origin: origin})
      at = usize.ZERO
      while at < listed.length {
        resume(&mut builder.*, List<usize>.asSlice(&arms)[at])
        let mut payload = place(caught)
        run List<Projection>.append(&mut payload.projections, Projection.Payload {index: at, ty: Interned<Type>.clone(&listed[at])})
        let held = run temporary(&mut builder.*, &listed[at], origin)
        run assign(&mut builder.*, place(held), Rvalue.Use {value: Operand.Move {place: move payload}}, origin)
        if run Type.coversFailure(&selector, &listed[at]) {
          // A selected member reaches the handler as the handler's parameter type `S`.
          let mut argument = Operand.Move {place: place(held)}
          if let Option<List<Interned<Type>>>.Some {..} = &selectedMembers {
            let injected = run temporary(&mut builder.*, &selector, origin)
            run widenInto(&mut builder.*, held, &listed[at], injected, origin)
            argument = Operand.Move {place: place(injected)}
          }
          let outer = run selectCause(&mut builder.*, caught, origin)
          run callAndDrop(&mut builder.*, &handler, &handlerPart, run singleOperand(move argument), &handlerSuccess, &handlerFailure,
            output, sink, List<BoundPlace>.asSlice(&bound.*), origin, caught, &keptDrop)
          drop swapDiagnostics(&mut builder.*, move outer)
          terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
        } else {
          run dropUnused(&mut builder.*, &handlerPart, &handlerDrop, origin)
          run carry(&mut builder.*, caught, held, origin)
          run deliverFailure(&mut builder.*, held, &listed[at], sink, origin)
        }
        at = at + usize.ONE
      }
      resume(&mut builder.*, joined)
    }
    RunPlan.Finalize {inner, innerFailure, innerFailureDrop, finalizer, finalizerSuccess, nonParking, finalizerDrop, owed} => {
      if owed {
        // A cancelled finalizer is dropped unrun, also within the NonParking scope.
        let mut callees = List<InstanceKey>.make()
        let mut glues = List<Interned<Type>>.make()
        run planCallees(steps, finalizer, &mut callees, &mut glues)
        run appendDrop(&mut glues, &finalizerDrop)
        run List<NonParkingRun>.append(&mut builder.*.function.nonParking, NonParkingRun {callees: move callees, glues: move glues,
          declarations: List<Interned<DeclarationId>>.make(), exact: true, origin: Option<Origin>.some(origin)})
      }
      let protectedPart = run projectedPart(environment, usize.ZERO)
      let finalizerPart = run projectedPart(environment, usize.ONE)
      if Interned<Type>.with<bool>(&innerFailure, neverType) {
        run openCancelScope(&mut builder.*)
        run executePlan(&mut builder.*, steps, inner, &protectedPart, output, sink, &mut bound.*, origin)
        run finalizeOnCancel(&mut builder.*, steps, finalizer, &finalizerPart, &finalizerSuccess, nonParking, &finalizerDrop,
          &mut bound.*, origin)
        return run finalizeOnce(&mut builder.*, steps, finalizer, &finalizerPart, &finalizerSuccess, &mut bound.*, origin)
      }
      // Both exits run the finalizer; a failure is held in `caught` until it has finished (D4).
      let caught = run temporary(&mut builder.*, &innerFailure, origin)
      let failing = run block(&mut builder.*, origin)
      let joined = run block(&mut builder.*, origin)
      run openCancelScope(&mut builder.*)
      run executePlan(&mut builder.*, steps, inner, &protectedPart, output, &FailureSink.Catch {temp: caught, block: failing},
        &mut bound.*, origin)
      run finalizeOnCancel(&mut builder.*, steps, finalizer, &finalizerPart, &finalizerSuccess, nonParking, &finalizerDrop,
        &mut bound.*, origin)
      run finalizeOnce(&mut builder.*, steps, finalizer, &finalizerPart, &finalizerSuccess, &mut bound.*, origin)
      terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
      resume(&mut builder.*, failing)
      run List<HeldFailure>.append(&mut builder.*.held, HeldFailure {slot: caught, cleanup: copyOptionalType(&innerFailureDrop),
        depth: List<CancelScope>.length(&builder.cancelScopes)})
      run finalizeOnce(&mut builder.*, steps, finalizer, &finalizerPart, &finalizerSuccess, &mut bound.*, origin)
      drop List<HeldFailure>.pop(&mut builder.*.held)
      run deliverFailure(&mut builder.*, caught, &innerFailure, sink, origin)
      resume(&mut builder.*, joined)
    }
    RunPlan.UseRelease {lent, use, useSuccess, useFailure, useFailureDrop, useDrop, release, releaseDrop, releaseSuccess, releaseFailure,
      releaseFailureDrop, resourceDrop, owed,
      resourceOwed} => {
      // Invoking the release runs the Effect it returns in the same call. The run then drops the
      // resource, within the same NonParking scope.
      if owed || resourceOwed {
        let mut callees = List<InstanceKey>.make()
        if owed { run List<InstanceKey>.append(&mut callees, InstanceKey.copy(&release.key)) }
        let mut glues = List<Interned<Type>>.make()
        if resourceOwed { run appendDrop(&mut glues, &resourceDrop) }
        run List<NonParkingRun>.append(&mut builder.*.function.nonParking, NonParkingRun {callees: move callees, glues: move glues,
          declarations: List<Interned<DeclarationId>>.make(), exact: true, origin: Option<Origin>.some(origin)})
      }
      let resource = run projectedPart(environment, usize.ZERO)
      let usePart = run projectedPart(environment, usize.ONE)
      let releasePart = run projectedPart(environment, 2)
      let borrowed = run temporary(&mut builder.*, &lent, origin)
      run assign(&mut builder.*, place(borrowed), Rvalue.Ref {access: Access.Mutable, place: run copyPlace(&resource)}, origin)
      let used = run singleOperand(Operand.Copy {place: place(borrowed)})
      if Interned<Type>.with<bool>(&useFailure, neverType) {
        run openCancelScope(&mut builder.*)
        run callAndDrop(&mut builder.*, &use, &usePart, move used, &useSuccess, &useFailure, output, sink,
          List<BoundPlace>.asSlice(&bound.*), origin, usize.MAX, &useDrop)
        run releaseOnCancel(&mut builder.*, &release, &releasePart, &resource, &lent, &releaseSuccess, &releaseFailure,
          &releaseFailureDrop, &releaseDrop, &resourceDrop, List<BoundPlace>.asSlice(&bound.*), origin)
        return run releaseOnce(&mut builder.*, &release, &releasePart, &resource, &lent, &releaseSuccess, &releaseFailure,
          &releaseDrop, &resourceDrop, List<BoundPlace>.asSlice(&bound.*), &FailureSink.Propagate, origin)
      }
      let caught = run temporary(&mut builder.*, &useFailure, origin)
      let failing = run block(&mut builder.*, origin)
      let joined = run block(&mut builder.*, origin)
      run openCancelScope(&mut builder.*)
      run callAndDrop(&mut builder.*, &use, &usePart, move used, &useSuccess, &useFailure, output,
        &FailureSink.Catch {temp: caught, block: failing}, List<BoundPlace>.asSlice(&bound.*), origin, usize.MAX, &useDrop)
      run releaseOnCancel(&mut builder.*, &release, &releasePart, &resource, &lent, &releaseSuccess, &releaseFailure,
        &releaseFailureDrop, &releaseDrop, &resourceDrop, List<BoundPlace>.asSlice(&bound.*), origin)
      run releaseOnce(&mut builder.*, &release, &releasePart, &resource, &lent, &releaseSuccess, &releaseFailure, &releaseDrop, &resourceDrop,
        List<BoundPlace>.asSlice(&bound.*), &FailureSink.Propagate, origin)
      terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
      resume(&mut builder.*, failing)
      run List<HeldFailure>.append(&mut builder.*.held, HeldFailure {slot: caught, cleanup: copyOptionalType(&useFailureDrop),
        depth: List<CancelScope>.length(&builder.cancelScopes)})
      run releaseOnce(&mut builder.*, &release, &releasePart, &resource, &lent, &releaseSuccess, &releaseFailure, &releaseDrop, &resourceDrop,
        List<BoundPlace>.asSlice(&bound.*), &FailureSink.Propagate, origin)
      drop List<HeldFailure>.pop(&mut builder.*.held)
      run deliverFailure(&mut builder.*, caught, &useFailure, sink, origin)
      resume(&mut builder.*, joined)
    }
  }
  return ()
}

// Records a NonParking obligation whose only callee is `key`.
effect fn oweNonParking(builder: &mut Builder, key: &InstanceKey, origin: Origin) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut callees = List<InstanceKey>.make()
  run List<InstanceKey>.append(&mut callees, InstanceKey.copy(key))
  return run List<NonParkingRun>.append(&mut builder.*.function.nonParking, NonParkingRun {callees: move callees,
    glues: List<Interned<Type>>.make(), declarations: List<Interned<DeclarationId>>.make(), exact: true, origin: Option<Origin>.some(origin)})
}

// Appends the instances that running plan step `step` calls: each runner, handler, use, release
// and observer callback beneath it; and the types whose drop glue the expansion runs in place:
// a dropped handler, finalizer, resource, provider or observer state.
effect fn planCallees(steps: &[RunPlan], step: usize, callees: &mut List<InstanceKey>, glues: &mut List<Interned<Type>>) -> ()
! OutOfMemoryError ? &mut Allocator {
  match &steps[step] {
    RunPlan.Runner {target, partDrop, ..} => {
      run List<InstanceKey>.append(&mut callees.*, InstanceKey.copy(&target.key))
      run appendDrop(&mut glues.*, &partDrop)
    }
    RunPlan.Catch {inner, handler, handlerDrop, ..} => {
      run planCallees(steps, inner, &mut callees.*, &mut glues.*)
      run List<InstanceKey>.append(&mut callees.*, InstanceKey.copy(&handler.key))
      run appendDrop(&mut glues.*, &handlerDrop)
    }
    RunPlan.Finalize {inner, finalizer, finalizerDrop, ..} => {
      run planCallees(steps, inner, &mut callees.*, &mut glues.*)
      run planCallees(steps, finalizer, &mut callees.*, &mut glues.*)
      run appendDrop(&mut glues.*, &finalizerDrop)
    }
    RunPlan.UseRelease {use, release, useDrop, releaseDrop, resourceDrop, ..} => {
      run List<InstanceKey>.append(&mut callees.*, InstanceKey.copy(&use.key))
      run List<InstanceKey>.append(&mut callees.*, InstanceKey.copy(&release.key))
      run appendDrop(&mut glues.*, &useDrop)
      run appendDrop(&mut glues.*, &releaseDrop)
      run appendDrop(&mut glues.*, &resourceDrop)
    }
    RunPlan.Bind {inner, providerDrop} => {
      run planCallees(steps, inner, &mut callees.*, &mut glues.*)
      if let Option<ProviderDrop>.Some {value: dropped} = &providerDrop {
        run List<Interned<Type>>.append(&mut glues.*, Interned<Type>.clone(&dropped.provider))
      }
    }
    RunPlan.Join {arms, ..} => {
      let listed = List<JoinArm>.asSlice(&arms)
      let mut at = usize.ZERO
      while at < listed.length {
        run planCallees(steps, listed[at].step, &mut callees.*, &mut glues.*)
        at = at + usize.ONE
      }
    }
    RunPlan.Observe {inner, callback, stateDrop, callbackDrop, ..} => {
      run planCallees(steps, inner, &mut callees.*, &mut glues.*)
      run List<InstanceKey>.append(&mut callees.*, InstanceKey.copy(&callback.key))
      run appendDrop(&mut glues.*, &stateDrop)
      run appendDrop(&mut glues.*, &callbackDrop)
    }
    RunPlan.Suspend {inner} => { run planCallees(steps, inner, &mut callees.*, &mut glues.*) }
    RunPlan.Interrupt {inner} => { run planCallees(steps, inner, &mut callees.*, &mut glues.*) }
    RunPlan.Lent {inner} => { run planCallees(steps, inner, &mut callees.*, &mut glues.*) }
  }
  return ()
}

effect fn appendDrop(glues: &mut List<Interned<Type>>, dropped: &Option<Interned<Type>>) -> () ! OutOfMemoryError ? &mut Allocator {
  if let Option<Interned<Type>>.Some {value} = &dropped.* { run List<Interned<Type>>.append(&mut glues.*, Interned<Type>.clone(&value)) }
  return ()
}

// Runs a `() ! never` finalizer step into a fresh unit temporary.
effect fn finalizeOnce(builder: &mut Builder, steps: &[RunPlan], step: usize, part: &Place, success: &Interned<Type>,
  bound: &mut List<BoundPlace>, origin: Origin) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let done = run temporary(&mut builder.*, success, origin)
  return run executePlan(&mut builder.*, steps, step, part, done, &FailureSink.Propagate, &mut bound.*, origin)
}

// Closes the innermost cancel scope, dropping an unused part in its landing (E3b-2 cancel).
effect fn dropOnCancel(builder: &mut Builder, part: &Place, ty: &Option<Interned<Type>>, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Landing>.Some {value: landing} = move closeCancelScope(&mut builder.*) {
    run dropUnused(&mut builder.*, part, ty, origin)
    run closeLanding(&mut builder.*, move landing, origin)
  }
  return ()
}

// Closes the innermost cancel scope, dropping two parts in its landing in order.
effect fn dropPartsOnCancel(builder: &mut Builder, first: &Place, firstDrop: &Option<Interned<Type>>, second: &Place,
  secondDrop: &Option<Interned<Type>>, origin: Origin) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Landing>.Some {value: landing} = move closeCancelScope(&mut builder.*) {
    run dropUnused(&mut builder.*, first, firstDrop, origin)
    run dropUnused(&mut builder.*, second, secondDrop, origin)
    run closeLanding(&mut builder.*, move landing, origin)
  }
  return ()
}

// Closes the innermost cancel scope. Its landing runs an armed nonparking finalizer once, before
// the frame's own cleanup, and drops any other finalizer unrun.
effect fn finalizeOnCancel(builder: &mut Builder, steps: &[RunPlan], step: usize, part: &Place, success: &Interned<Type>,
  nonParking: bool, finalizerDrop: &Option<Interned<Type>>, bound: &mut List<BoundPlace>, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Landing>.Some {value: landing} = move closeCancelScope(&mut builder.*) {
    if nonParking {
      run finalizeOnce(&mut builder.*, steps, step, part, success, &mut bound.*, origin)
    } else {
      run dropUnused(&mut builder.*, part, finalizerDrop, origin)
    }
    run closeLanding(&mut builder.*, move landing, origin)
  }
  return ()
}

// Closes the innermost cancel scope, releasing and dropping the resource in its landing. The frame
// is already cancelled, so a failure the release raises there is dropped and the cancel goes on.
effect fn releaseOnCancel(builder: &mut Builder, release: &CallTarget, part: &Place, resource: &Place, lent: &Interned<Type>,
  success: &Interned<Type>, failure: &Interned<Type>, failureDrop: &Option<Interned<Type>>, releaseDrop: &Option<Interned<Type>>,
  resourceDrop: &Option<Interned<Type>>, bound: &[BoundPlace], origin: Origin) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Landing>.Some {value: landing} = move closeCancelScope(&mut builder.*) {
    if Interned<Type>.with<bool>(failure, neverType) {
      run releaseOnce(&mut builder.*, release, part, resource, lent, success, failure, releaseDrop, resourceDrop, bound,
        &FailureSink.Propagate, origin)
    } else {
      let caught = run temporary(&mut builder.*, failure, origin)
      let discarded = run block(&mut builder.*, origin)
      let released = run block(&mut builder.*, origin)
      run releaseOnce(&mut builder.*, release, part, resource, lent, success, failure, releaseDrop, resourceDrop, bound,
        &FailureSink.Catch {temp: caught, block: discarded}, origin)
      terminate(&mut builder.*, Terminator.Goto {target: released, origin: origin})
      resume(&mut builder.*, discarded)
      run dropUnused(&mut builder.*, &place(caught), failureDrop, origin)
      run dropUnused(&mut builder.*, resource, resourceDrop, origin)
      terminate(&mut builder.*, Terminator.Goto {target: released, origin: origin})
      resume(&mut builder.*, released)
    }
    run closeLanding(&mut builder.*, move landing, origin)
  }
  return ()
}

// Lends the resource afresh to `release`, runs the Effect it returns, then drops the resource. A
// failure goes to `sink` before the resource is dropped.
effect fn releaseOnce(builder: &mut Builder, release: &CallTarget, part: &Place, resource: &Place, lent: &Interned<Type>,
  success: &Interned<Type>, failure: &Interned<Type>, releaseDrop: &Option<Interned<Type>>, resourceDrop: &Option<Interned<Type>>,
  bound: &[BoundPlace], sink: &FailureSink, origin: Origin) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let borrowed = run temporary(&mut builder.*, lent, origin)
  run assign(&mut builder.*, place(borrowed), Rvalue.Ref {access: Access.Mutable, place: run copyPlace(resource)}, origin)
  let done = run temporary(&mut builder.*, success, origin)
  run callAndDrop(&mut builder.*, release, part, run singleOperand(Operand.Copy {place: place(borrowed)}), success, failure, done,
    sink, bound, origin, usize.MAX, releaseDrop)
  return run dropUnused(&mut builder.*, resource, resourceDrop, origin)
}

// Calls `target` on `part`. A loaned invocation leaves an owning callable in place, so when
// `partDrop` names its type the part is dropped after the call on every exit, cancel included.
effect fn callAndDrop(builder: &mut Builder, target: &CallTarget, part: &Place, written: List<Operand>, success: &Interned<Type>,
  failure: &Interned<Type>, output: usize, sink: &FailureSink, bound: &[BoundPlace], origin: Origin, releasing: usize,
  partDrop: &Option<Interned<Type>>) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Interned<Type>>.None = &partDrop.* {
    return run planCall(&mut builder.*, target, part, move written, success, failure, output, sink, bound, origin, releasing)
  }
  run openCancelScope(&mut builder.*)
  if Interned<Type>.with<bool>(failure, neverType) {
    run planCall(&mut builder.*, target, part, move written, success, failure, output, sink, bound, origin, releasing)
    run dropOnCancel(&mut builder.*, part, partDrop, origin)
    return run dropUnused(&mut builder.*, part, partDrop, origin)
  }
  let caught = run temporary(&mut builder.*, failure, origin)
  let failing = run block(&mut builder.*, origin)
  let joined = run block(&mut builder.*, origin)
  run planCall(&mut builder.*, target, part, move written, success, failure, output, &FailureSink.Catch {temp: caught, block: failing},
    bound, origin, releasing)
  run dropOnCancel(&mut builder.*, part, partDrop, origin)
  run dropUnused(&mut builder.*, part, partDrop, origin)
  terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
  resume(&mut builder.*, failing)
  run dropUnused(&mut builder.*, part, partDrop, origin)
  run deliverFailure(&mut builder.*, caught, failure, sink, origin)
  resume(&mut builder.*, joined)
  return ()
}

// One provider address: this function's own provider, or a binding's stored provider (D2).
effect fn providerOperand(builder: &mut Builder, source: &ProviderSource, bound: &[BoundPlace], origin: Origin) -> Operand
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  match &source.* {
    ProviderSource.Own {index} => {
      if index >= List<usize>.length(&builder.providers) { return CompilerBug.panic(b"an own provider index is out of range") }
      return Operand.Copy {place: place(List<usize>.asSlice(&builder.providers)[index])}
    }
    ProviderSource.Bound {depth, owned, access, address} => {
      if depth >= bound.length { return CompilerBug.panic(b"a bound provider depth is out of range") }
      if !owned { return Operand.Copy {place: run copyPlace(&bound[depth].place)} }
      let reference = run temporary(&mut builder.*, &address, origin)
      run assign(&mut builder.*, place(reference), Rvalue.Ref {access: access, place: run copyPlace(&bound[depth].place)}, origin)
      return Operand.Copy {place: place(reference)}
    }
  }
}

effect fn providerOperands(builder: &mut Builder, sources: &[ProviderSource], bound: &[BoundPlace], origin: Origin) -> List<Operand>
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  let mut values = run List<Operand>.makeWithCapacity(sources.length)
  let mut at = usize.ZERO
  while at < sources.length {
    run List<Operand>.append(&mut values, run providerOperand(&mut builder.*, &sources[at], bound, origin))
    at = at + usize.ONE
  }
  return move values
}

// The provider addresses of the direct call prepared for `node`. Outside an expansion every
// source is this function's own provider (D2 rule 1).
effect fn targetProviders(builder: &mut Builder, node: BodyNodeId, origin: Origin) -> List<Operand>
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator {
  let mut sources = List<ProviderSource>.make()
  let calls = List<CallTarget>.asSlice(&builder.calls)
  let mut at = usize.ZERO
  while at < calls.length {
    if calls[at].node.index == node.index {
      let listed = List<ProviderSource>.asSlice(&calls[at].providers)
      let mut index = usize.ZERO
      while index < listed.length {
        run List<ProviderSource>.append(&mut sources, ProviderSource.copy(&listed[index]))
        index = index + usize.ONE
      }
      break
    }
    at = at + usize.ONE
  }
  let none = List<BoundPlace>.make()
  return run providerOperands(&mut builder.*, List<ProviderSource>.asSlice(&sources), List<BoundPlace>.asSlice(&none), origin)
}

// The failure type of the call edge at `node`: a witness callee's own declared failure, otherwise
// the one the call site's Effect promises (D3).
fn edgeFailure(builder: &Builder, node: BodyNodeId, promised: &Interned<Type>) -> Interned<Type> {
  let calls = List<CallTarget>.asSlice(&builder.calls)
  let mut at = usize.ZERO
  while at < calls.length {
    if calls[at].node.index == node.index {
      if let Option<Interned<Type>>.Some {value} = &calls[at].witnessFailure { return Interned<Type>.clone(&value) }
      break
    }
    at = at + usize.ONE
  }
  return Interned<Type>.clone(promised)
}

// The Effect value the ordinary callee at `node` returns, when its contract promises one.
fn returnedEffect(builder: &Builder, node: BodyNodeId) -> Option<Interned<Type>> {
  let calls = List<CallTarget>.asSlice(&builder.calls)
  let mut at = usize.ZERO
  while at < calls.length {
    if calls[at].node.index == node.index {
      return match &calls[at].returned {
        Option<Interned<Type>>.Some {value} => Option<Interned<Type>>.some(Interned<Type>.clone(&value))
        Option<Interned<Type>>.None => Option<Interned<Type>>.none()
      }
    }
    at = at + usize.ONE
  }
  return Option<Interned<Type>>.none()
}

// Whether the call at `node` dispatches to a `never` provider and so is never reached.
fn vacuousCall(builder: &Builder, node: BodyNodeId) -> bool {
  let calls = List<CallTarget>.asSlice(&builder.calls)
  let mut at = usize.ZERO
  while at < calls.length {
    if calls[at].node.index == node.index { return calls[at].vacuous }
    at = at + usize.ONE
  }
  return false
}

fn callDispatch(builder: &Builder, node: BodyNodeId) -> Option<ProviderSource> {
  let calls = List<CallTarget>.asSlice(&builder.calls)
  let mut at = usize.ZERO
  while at < calls.length {
    if calls[at].node.index == node.index {
      return match &calls[at].dispatch {
        Option<ProviderSource>.Some {value} => Option<ProviderSource>.some(ProviderSource.copy(&value))
        Option<ProviderSource>.None => Option<ProviderSource>.none()
      }
    }
    at = at + usize.ONE
  }
  return Option<ProviderSource>.none()
}

// The failure context companion: the failure's identity and its origin label (failure
// observer note N3).
effect fn contextType() -> Interned<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let text = run Types.intern(Type.String {lifetime: run Types.internLifetime(Lifetime.Static)})
  return run Types.intern(Type.Array {element: move text, extent: run Bytes.copy(b"2")})
}

// A nullable address of a context companion: the selected failure (N2).
pub effect fn causeType() -> Interned<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run Types.intern(Type.Pointer {pointee: run contextType(), access: Access.Shared, nullable: true,
    multiplicity: Multiplicity.Single, alignment: Option<u64>.none()})
}

/// The address of a package entry site label: a `string<'static>` descriptor, or null.
pub effect fn siteType() -> Interned<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run Types.intern(Type.Pointer {pointee: run Types.intern(Type.String {lifetime: run Types.internLifetime(Lifetime.Static)}),
    access: Access.Shared, nullable: true, multiplicity: Multiplicity.Single, alignment: Option<u64>.none()})
}

// An untyped code or data address: an observer record field.
effect fn addressType() -> Interned<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run Types.intern(Type.Pointer {pointee: run Types.intern(Type.Primitive {name: run Bytes.copy(b"u8")}),
    access: Access.Shared, nullable: true, multiplicity: Multiplicity.Single, alignment: Option<u64>.none()})
}

// The observer record `[adapter address, state address, callback address]` (N1).
effect fn observerRecord() -> Interned<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run Types.intern(Type.Array {element: run addressType(), extent: run Bytes.copy(b"3")})
}

// A nullable address of the current observer record (N1).
pub effect fn observerAddress() -> Interned<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run Types.intern(Type.Pointer {pointee: run observerRecord(), access: Access.Shared, nullable: true,
    multiplicity: Multiplicity.Single, alignment: Option<u64>.none()})
}

// A module's report name: its logical path without the source extension.
effect fn modulePath(module: &ModuleId) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut copied = run ModuleId.copyPath(module)
  let path = Bytes.asSlice(&copied)
  let mut end = path.length
  if end > 5 && path[end - 5] == 46 && path[end - 4] == 115 && path[end - 3] == 105 && path[end - 2] == 108 && path[end - 1] == 107 {
    end = end - 5
  }
  Bytes.truncate(&mut copied, end)
  return move copied
}

// `module.Owner.name`, naming only named owner steps (anonymous bodies report their owner).
pub effect fn declarationName(declaration: &DeclarationId) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  return run reportName(declaration, &Option<ModuleId>.none())
}

// `declarationName`, led by the package name, `geo.lib.keep`, for a declaration of another package
// than `root`'s: every library's root module is `lib`. Standard-library names keep their path.
effect fn reportName(declaration: &DeclarationId, root: &Option<ModuleId>) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let module = DeclarationId.moduleId(declaration)
  let mut name = Bytes.make()
  if let Option<ModuleId>.Some {value: own} = &root.* {
    let foreign = !ModuleId.samePackage(module, &own) && ModuleId.sameOrigin(module, &own)
    if foreign && !ModuleId.withPath<bool>(module, PackageGraph.isStandard) {
      let package = run ModuleId.copyPackage(module)
      let identity = Bytes.asSlice(&package)
      let mut end = usize.ZERO
      while end < identity.length && identity[end] != '@' {
        run Bytes.append(&mut name, &[identity[end]])
        end = end + usize.ONE
      }
      if end > usize.ZERO { run Bytes.append(&mut name, b".") }
    }
  }
  run Bytes.append(&mut name, Bytes.asSlice(&run modulePath(module)))
  let count = DeclarationId.ownerCount(declaration)
  let mut at = usize.ZERO
  while at < count {
    // An `impl` block is named with no spelling; its methods read as members of the module.
    let ownerName = run DeclarationId.copyOwnerName(declaration, at)
    if DeclarationId.ownerNamed(declaration, at) && Bytes.length(&ownerName) > usize.ZERO {
      run Bytes.append(&mut name, b".")
      run Bytes.append(&mut name, Bytes.asSlice(&ownerName))
    }
    at = at + usize.ONE
  }
  return move name
}

effect fn siteText(key: &InstanceKey, root: Option<ModuleId>) -> SiteText ! OutOfMemoryError ? &mut Allocator {
  let identity = DeclarationId.copyShared(&InstanceKey.identity(key))
  return SiteText {name: run reportName(&identity, &root), path: run modulePath(DeclarationId.moduleId(&identity)),
    root: move root}
}

// `module.function (module:line:column)` for one site, 1-based.
effect fn siteLabel(sites: &SiteText, anchor: &Anchor, origin: Origin) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let span = Origin.span(origin, anchor)
  let position = Anchor.lineColumn(anchor, span.start)
  let mut label = run Bytes.copy(Bytes.asSlice(&sites.name))
  run Bytes.append(&mut label, b" (")
  run Bytes.append(&mut label, Bytes.asSlice(&sites.path))
  run Bytes.append(&mut label, b":")
  run Bytes.append(&mut label, Bytes.asSlice(&run decimalBytes(usize.toU64(position.line))))
  run Bytes.append(&mut label, b":")
  run Bytes.append(&mut label, Bytes.asSlice(&run decimalBytes(usize.toU64(position.column))))
  run Bytes.append(&mut label, b")")
  return move label
}

// The canonical identity a report names for one failure type, spelled as the bootstrap's type
// encoding: `module.Name<Arguments>`, `string<'static>`, `&'static mut T`, `Array<T, N>`. Only
// `'static` has a source spelling after instance selection; any other region is omitted
// (`&T`, `string`, `Holder`), where the bootstrap prints its inference region (`'_local9`).
// A requirement row or a compiler-minted aggregate stays a gap rather than printing a guess.
effect fn identityText(ty: &Interned<Type>, root: &Option<ModuleId>, output: &mut Bytes) -> bool ! OutOfMemoryError ? &mut Allocator {
  let shape = run Type.copy(ty)
  match move shape {
    Type.Primitive {name} => { run Bytes.append(&mut output.*, Bytes.asSlice(&name)) }
    Type.Unit => { run Bytes.append(&mut output.*, b"()") }
    Type.String {lifetime} => {
      if staticLifetime(&lifetime) { run Bytes.append(&mut output.*, b"string<'static>") } else { run Bytes.append(&mut output.*, b"string") }
    }
    Type.Reference {referent, access, lifetime} => {
      run borrowPrefix(access, staticLifetime(&lifetime), &mut output.*)
      return run identityText(&referent, root, &mut output.*)
    }
    Type.Slice {element, access, lifetime} => {
      run borrowPrefix(access, staticLifetime(&lifetime), &mut output.*)
      run Bytes.append(&mut output.*, b"[")
      if !run identityText(&element, root, &mut output.*) { return false }
      run Bytes.append(&mut output.*, b"]")
    }
    Type.Pointer {pointee, access, nullable, multiplicity, alignment} => {
      if nullable { run Bytes.append(&mut output.*, b"?") }
      if multiplicity == Multiplicity.Many { run Bytes.append(&mut output.*, b"[*]") } else { run Bytes.append(&mut output.*, b"*") }
      if access == Access.Mutable { run Bytes.append(&mut output.*, b"mut ") } else { run Bytes.append(&mut output.*, b"const ") }
      if let Option<u64>.Some {value: written} = &alignment {
        run Bytes.append(&mut output.*, b"align(")
        run Bytes.append(&mut output.*, Bytes.asSlice(&run decimalBytes(written)))
        run Bytes.append(&mut output.*, b") ")
      }
      return run identityText(&pointee, root, &mut output.*)
    }
    Type.Array {element, extent} => {
      run Bytes.append(&mut output.*, b"Array<")
      if !run identityText(&element, root, &mut output.*) { return false }
      run Bytes.append(&mut output.*, b", ")
      run Bytes.append(&mut output.*, Bytes.asSlice(&extent))
      run Bytes.append(&mut output.*, b">")
    }
    Type.Nominal {declaration, arguments, ..} => {
      run Bytes.append(&mut output.*, Bytes.asSlice(&run reportName(&declaration, root)))
      let listed = List<Argument>.asSlice(&arguments)
      let mut written = usize.ZERO
      let mut at = usize.ZERO
      while at < listed.length {
        let spelled = match &listed[at] {
          Argument.Type {..} => true
          Argument.Lifetime {value} => staticLifetime(&value)
          Argument.Row {..} => { return false }
        }
        if spelled {
          if written == usize.ZERO { run Bytes.append(&mut output.*, b"<") } else { run Bytes.append(&mut output.*, b", ") }
          if let Argument.Type {value} = &listed[at] {
            if !run identityText(&value, root, &mut output.*) { return false }
          } else { run Bytes.append(&mut output.*, b"'static") }
          written = written + usize.ONE
        }
        at = at + usize.ONE
      }
      if written != usize.ZERO { run Bytes.append(&mut output.*, b">") }
    }
    _ => { return false }
  }
  return true
}

// `&`, then `'static ` when the borrow region has that spelling, then `mut ` for exclusive access.
effect fn borrowPrefix(access: Access, spelled: bool, output: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  if spelled { run Bytes.append(&mut output.*, b"&'static ") } else { run Bytes.append(&mut output.*, b"&") }
  if access == Access.Mutable { run Bytes.append(&mut output.*, b"mut ") }
}

fn staticLifetime(value: &Interned<Lifetime>) -> bool {
  return Interned<Lifetime>.with<bool>(
    value,
    fn(region: &Lifetime) -> bool {
      return match & region.* {
        Lifetime.Static => true
        _ => false
      }
    },
  )
}

// Carries a failure's context with its payload from slot `from` to slot `to` (N3).
effect fn carry(builder: &mut Builder, from: usize, to: usize, origin: Origin) -> () ! OutOfMemoryError ? &mut Allocator {
  if let Option<DiagnosticPlaces>.None = &builder.diagnostics { return () }
  return run contextStatement(&mut builder.*, place(to), Option<Place>.some(place(from)), origin)
}

effect fn contextStatement(builder: &mut Builder, destination: Place, source: Option<Place>, origin: Origin) -> ()
! OutOfMemoryError ? &mut Allocator {
  let current = builder.current
  let mut blocks = List<Block>.asMutSlice(&mut builder.*.function.blocks)
  return run List<Statement>.append(&mut blocks[current].statements,
    Statement.FailureContext {destination: move destination, source: move source, origin: origin})
}

// `fail` originates its context after `Assign(Failure, x)`: the active member's identity and this
// site's label (N3).
effect fn raise(builder: &mut Builder, origin: Origin) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let label = match &builder.sites {
    Option<SiteText>.Some {value: sites} => run siteLabel(&sites, &builder.anchor, origin)
    Option<SiteText>.None => { return () }
  }
  let root = match &builder.sites {
    Option<SiteText>.Some {value: sites} => match &sites.root {
      Option<ModuleId>.Some {value} => Option<ModuleId>.some(ModuleId.copy(&value))
      Option<ModuleId>.None => Option<ModuleId>.none()
    }
    Option<SiteText>.None => Option<ModuleId>.none()
  }
  let owner = InstanceKey.identity(&builder.function.key)
  let slot = builder.failure
  let failed = localType(&builder.*, slot)
  let mut identities = List<Bytes>.make()
  match move run Type.canonicalUnionMembers(&failed) {
    Option<List<Interned<Type>>>.Some {value: members} => {
      let listed = List<Interned<Type>>.asSlice(&members)
      let mut at = usize.ZERO
      while at < listed.length {
        let mut identity = Bytes.make()
        if !run identityText(&listed[at], &root, &mut identity) { return run unsupported(&owner, origin, GapCode.FailureIdentity) }
        run List<Bytes>.append(&mut identities, move identity)
        at = at + usize.ONE
      }
    }
    Option<List<Interned<Type>>>.None => {
      let mut identity = Bytes.make()
      if !run identityText(&failed, &root, &mut identity) { return run unsupported(&owner, origin, GapCode.FailureIdentity) }
      run List<Bytes>.append(&mut identities, move identity)
    }
  }
  run List<ContextText>.append(&mut builder.*.function.contexts, ContextText {origin: origin, identities: move identities,
    label: move label})
  run contextStatement(&mut builder.*, place(slot), Option<Place>.none(), origin)
  // The originated context becomes a node of the current observer's pool (event 0, N7).
  let address = run companion(&mut builder.*, slot, origin)
  let text = run reportTextType()
  let mut identity = place(address)
  run List<Projection>.append(&mut identity.projections, Projection.Deref)
  let mut site = run copyPlace(&identity)
  run List<Projection>.append(&mut identity.projections, Projection.ConstIndex {index: usize.ZERO})
  run List<Projection>.append(&mut site.projections, Projection.ConstIndex {index: usize.ONE})
  let named = run temporary(&mut builder.*, &text, origin)
  run assign(&mut builder.*, place(named), Rvalue.Use {value: Operand.Copy {place: move identity}}, origin)
  let located = run temporary(&mut builder.*, &text, origin)
  run assign(&mut builder.*, place(located), Rvalue.Use {value: Operand.Copy {place: move site}}, origin)
  let handle = run observerEvent(&mut builder.*, 0, run usizeOperand(0), run usizeOperand(0), Operand.Copy {place: place(named)},
    Operand.Copy {place: place(located)}, origin)
  run chainCause(&mut builder.*, handle, origin)
  return run setHandle(&mut builder.*, address, handle, origin)
}

// A failure raised while a handler handles a selected failure records that failure as its cause
// (event 2, `while handling`), then releases the plain origin node the chained node retains (N7).
effect fn chainCause(builder: &mut Builder, handle: usize, origin: Origin) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let cause = match &builder.diagnostics {
    Option<DiagnosticPlaces>.Some {value} => run copyPlace(&value.cause)
    Option<DiagnosticPlaces>.None => { return () }
  }
  let boolean = run Types.intern(Type.Primitive {name: run Bytes.copy(b"bool")})
  let selected = run temporary(&mut builder.*, &boolean, origin)
  run assign(&mut builder.*, place(selected), Rvalue.Binary {operation: InfixOperator.NotEquals,
    left: Operand.Copy {place: run copyPlace(&cause)}, right: Operand.Null {ty: run causeType()}}, origin)
  let chaining = run block(&mut builder.*, origin)
  let joined = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: Operand.Copy {place: place(selected)}, thenBlock: chaining,
    elseBlock: joined, origin: origin})
  resume(&mut builder.*, chaining)
  let held = run temporary(&mut builder.*, &run usizeType(), origin)
  run assign(&mut builder.*, place(held), Rvalue.ContextHandle {address: Operand.Copy {place: move cause}}, origin)
  let unlabeled = run reportText(&mut builder.*, b"", origin)
  let chained = run observerEvent(&mut builder.*, 2, Operand.Copy {place: place(handle)}, Operand.Copy {place: place(held)},
    Operand.Copy {place: place(unlabeled)}, Operand.Copy {place: place(unlabeled)}, origin)
  drop run observerEvent(&mut builder.*, 4, Operand.Copy {place: place(handle)}, run usizeOperand(0),
    Operand.Copy {place: place(unlabeled)}, Operand.Copy {place: place(unlabeled)}, origin)
  run assign(&mut builder.*, place(handle), Rvalue.Use {value: Operand.Copy {place: place(chained)}}, origin)
  terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
  resume(&mut builder.*, joined)
  return ()
}

// A failure that leaves this function through a run site gains that site, labeled by local `site`,
// as its next logical frame (event 1), which takes over the previous node's reference (event 4, N7).
effect fn frame(builder: &mut Builder, slot: usize, site: usize, origin: Origin) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let address = run companion(&mut builder.*, slot, origin)
  let previous = run handleOf(&mut builder.*, address, origin)
  let unlabeled = run reportText(&mut builder.*, b"", origin)
  let handle = run observerEvent(&mut builder.*, 1, Operand.Copy {place: place(previous)}, run usizeOperand(0),
    Operand.Copy {place: place(site)}, Operand.Copy {place: place(unlabeled)}, origin)
  drop run observerEvent(&mut builder.*, 4, Operand.Copy {place: place(previous)}, run usizeOperand(0),
    Operand.Copy {place: place(unlabeled)}, Operand.Copy {place: place(unlabeled)}, origin)
  return run setHandle(&mut builder.*, address, handle, origin)
}

// Releases the pool node a failure slot's context holds: its failure was handled (event 4, N7).
effect fn release(builder: &mut Builder, slot: usize, origin: Origin) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<DiagnosticPlaces>.None = &builder.diagnostics { return () }
  let address = run companion(&mut builder.*, slot, origin)
  let held = run handleOf(&mut builder.*, address, origin)
  let unlabeled = run reportText(&mut builder.*, b"", origin)
  drop run observerEvent(&mut builder.*, 4, Operand.Copy {place: place(held)}, run usizeOperand(0),
    Operand.Copy {place: place(unlabeled)}, Operand.Copy {place: place(unlabeled)}, origin)
  return ()
}

// The address of failure slot `slot`'s context companion.
effect fn companion(builder: &mut Builder, slot: usize, origin: Origin) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let address = run temporary(&mut builder.*, &run causeType(), origin)
  run assign(&mut builder.*, place(address), Rvalue.ContextOf {place: place(slot)}, origin)
  return address
}

effect fn handleOf(builder: &mut Builder, address: usize, origin: Origin) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let held = run temporary(&mut builder.*, &run usizeType(), origin)
  run assign(&mut builder.*, place(held), Rvalue.ContextHandle {address: Operand.Copy {place: place(address)}}, origin)
  return held
}

effect fn setHandle(builder: &mut Builder, address: usize, handle: usize, origin: Origin) -> () ! OutOfMemoryError ? &mut Allocator {
  let current = builder.current
  let mut blocks = List<Block>.asMutSlice(&mut builder.*.function.blocks)
  return run List<Statement>.append(&mut blocks[current].statements, Statement.SetContextHandle {
    address: Operand.Copy {place: place(address)}, value: Operand.Copy {place: place(handle)}, origin: origin})
}

effect fn usizeType() -> Interned<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run Types.intern(Type.Primitive {name: run Bytes.copy(b"usize")})
}

effect fn reportTextType() -> Interned<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run Types.intern(Type.String {lifetime: run Types.internLifetime(Lifetime.Static)})
}

// A temporary holding a static report text.
effect fn reportText(builder: &mut Builder, text: &[u8], origin: Origin) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let output = run temporary(&mut builder.*, &run reportTextType(), origin)
  run assign(&mut builder.*, place(output), Rvalue.Slice {data: Operand.StaticBytes {bytes: run Bytes.copy(text)},
    count: run usizeOperand(usize.toU64(text.length))}, origin)
  return output
}

// One observer event's answer when an observer is current, else `0` (N7).
effect fn observerEvent(builder: &mut Builder, event: u64, first: Operand, second: Operand, identity: Operand, label: Operand,
  origin: Origin) -> usize ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let output = run temporary(&mut builder.*, &run usizeType(), origin)
  let current = match &builder.diagnostics {
    Option<DiagnosticPlaces>.Some {value} => Option<Place>.some(run copyPlace(&value.observer))
    Option<DiagnosticPlaces>.None => Option<Place>.none()
  }
  let observer = match move current {
    Option<Place>.Some {value} => move value
    Option<Place>.None => {
      run assign(&mut builder.*, place(output), Rvalue.Use {value: run usizeOperand(0)}, origin)
      return output
    }
  }
  let boolean = run Types.intern(Type.Primitive {name: run Bytes.copy(b"bool")})
  let observed = run temporary(&mut builder.*, &boolean, origin)
  run assign(&mut builder.*, place(observed), Rvalue.Binary {operation: InfixOperator.NotEquals,
    left: Operand.Copy {place: run copyPlace(&observer)}, right: Operand.Null {ty: run observerAddress()}}, origin)
  let calling = run block(&mut builder.*, origin)
  let quiet = run block(&mut builder.*, origin)
  let joined = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: Operand.Copy {place: place(observed)}, thenBlock: calling,
    elseBlock: quiet, origin: origin})
  resume(&mut builder.*, calling)
  run callObserver(&mut builder.*, &observer, event, move first, move second, move identity, move label, output, joined, origin)
  resume(&mut builder.*, quiet)
  run assign(&mut builder.*, place(output), Rvalue.Use {value: run usizeOperand(0)}, origin)
  terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
  resume(&mut builder.*, joined)
  return output
}

// Calls the adapter of the observer record at `observer` with one event, continuing at `joined`.
// The callback is an independent edge: it runs with no observer and no selected failure (N1, N4).
effect fn callObserver(builder: &mut Builder, observer: &Place, event: u64, first: Operand, second: Operand, identity: Operand,
  label: Operand, output: usize, joined: usize, origin: Origin) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut adapter = run copyPlace(observer)
  run List<Projection>.append(&mut adapter.projections, Projection.Deref)
  let mut state = run copyPlace(&adapter)
  let mut callable = run copyPlace(&adapter)
  run List<Projection>.append(&mut adapter.projections, Projection.ConstIndex {index: usize.ZERO})
  run List<Projection>.append(&mut state.projections, Projection.ConstIndex {index: usize.ONE})
  run List<Projection>.append(&mut callable.projections, Projection.ConstIndex {index: 2})
  // Reads go through statements, so the record layout is an emission input.
  let word = run addressType()
  let function = run temporary(&mut builder.*, &word, origin)
  run assign(&mut builder.*, place(function), Rvalue.Use {value: Operand.Copy {place: move adapter}}, origin)
  // An execution's trap record has no adapter: it answers every event with `0`.
  let boolean = run Types.intern(Type.Primitive {name: run Bytes.copy(b"bool")})
  let adapted = run temporary(&mut builder.*, &boolean, origin)
  run assign(&mut builder.*, place(adapted), Rvalue.Binary {operation: InfixOperator.NotEquals,
    left: Operand.Copy {place: place(function)}, right: Operand.Null {ty: Interned<Type>.clone(&word)}}, origin)
  let calling = run block(&mut builder.*, origin)
  let unanswered = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: Operand.Copy {place: place(adapted)}, thenBlock: calling,
    elseBlock: unanswered, origin: origin})
  resume(&mut builder.*, unanswered)
  run assign(&mut builder.*, place(output), Rvalue.Use {value: run usizeOperand(0)}, origin)
  terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
  resume(&mut builder.*, calling)
  let stored = run temporary(&mut builder.*, &word, origin)
  run assign(&mut builder.*, place(stored), Rvalue.Use {value: Operand.Copy {place: move callable}}, origin)
  let receiver = run temporary(&mut builder.*, &word, origin)
  run assign(&mut builder.*, place(receiver), Rvalue.Use {value: Operand.Copy {place: move state}}, origin)
  let mut arguments = List<Operand>.make()
  run List<Operand>.append(&mut arguments, Operand.Copy {place: place(stored)})
  run List<Operand>.append(&mut arguments, Operand.Copy {place: place(receiver)})
  run List<Operand>.append(&mut arguments, Operand.Integer {decimal: run decimalBytes(event), negative: false,
    ty: run Types.intern(Type.Primitive {name: run Bytes.copy(b"u8")})})
  run List<Operand>.append(&mut arguments, move first)
  run List<Operand>.append(&mut arguments, move second)
  run List<Operand>.append(&mut arguments, move identity)
  run List<Operand>.append(&mut arguments, move label)
  let independent = run independentDiagnostics(true)
  return terminate(&mut builder.*, Terminator.Call {callee: Callee.Indirect {address: Operand.Copy {place: place(function)}},
    arguments: move arguments, providers: List<Operand>.make(), diagnostics: move independent,
    destination: place(output), normal: joined, failure: Option<FailureEdge>.none(), origin: origin})
}

// The current observer and selected-cause operands, when the program observes diagnostics (N1, N2).
effect fn currentDiagnostics(builder: &Builder) -> Option<Diagnostics> ! OutOfMemoryError ? &mut Allocator {
  return match &builder.diagnostics {
    Option<DiagnosticPlaces>.Some {value: places} => Option<Diagnostics>.some(run Diagnostics.make(
      Operand.Copy {place: run copyPlace(&places.observer)}, Operand.Copy {place: run copyPlace(&places.cause)},
      Operand.Copy {place: run copyPlace(&places.site)}))
    Option<DiagnosticPlaces>.None => Option<Diagnostics>.none()
  }
}

// Every Silk callee of a program that observes diagnostics takes them; foreign callees do not (N1).
// A direct call into another package passes this call's site label as the callee's entry site;
// every other call passes the caller's own entry site on. The standard library is a dependency of
// every package and never the reverse, so its calls into another package are callbacks: they pass
// no entry site, and a trap there reports at its own statement (TERM-008).
effect fn calleeDiagnostics(builder: &Builder, callee: &Callee, origin: Origin) -> Option<Diagnostics>
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Callee.Extern {..} = &callee.* { return Option<Diagnostics>.none() }
  let crossing = match &callee.* {
    Callee.Instance {key} => packageCrossing(&builder.function.key, &key)
    _ => Crossing.Within
  }
  let places = match &builder.diagnostics {
    Option<DiagnosticPlaces>.Some {value} => DiagnosticPlaces {observer: run copyPlace(&value.observer),
      cause: run copyPlace(&value.cause), site: run copyPlace(&value.site)}
    Option<DiagnosticPlaces>.None => { return Option<Diagnostics>.none() }
  }
  let site = match crossing {
    Crossing.Within => Operand.Copy {place: move places.site}
    Crossing.Callback => Operand.Null {ty: run siteType()}
    Crossing.Entry => match &builder.sites {
      Option<SiteText>.Some {value: sites} => Operand.StaticText {bytes: run siteLabel(&sites, &builder.anchor, origin)}
      Option<SiteText>.None => Operand.Null {ty: run siteType()}
    }
  }
  return Option<Diagnostics>.some(run Diagnostics.make(Operand.Copy {place: move places.observer},
    Operand.Copy {place: move places.cause}, move site))
}

// How a direct call relates the caller's package to the callee's.
enum Crossing {
  Within,
  Entry,
  Callback,
}

// The standard library is its own package, the implicit dependency `silk` (PACKAGE-005), whose
// modules are known by their paths.
fn packageCrossing(caller: &InstanceKey, callee: &InstanceKey) -> Crossing {
  let callerIdentity = DeclarationId.copyShared(&InstanceKey.identity(caller))
  let calleeIdentity = DeclarationId.copyShared(&InstanceKey.identity(callee))
  let callerModule = DeclarationId.moduleId(&callerIdentity)
  let calleeModule = DeclarationId.moduleId(&calleeIdentity)
  let standardCaller = ModuleId.withPath<bool>(callerModule, PackageGraph.isStandard)
  let standardCallee = ModuleId.withPath<bool>(calleeModule, PackageGraph.isStandard)
  if standardCaller && standardCallee { return Crossing.Within }
  if standardCaller { return Crossing.Callback }
  if standardCallee || !ModuleId.samePackage(callerModule, calleeModule) { return Crossing.Entry }
  return Crossing.Within
}

// The current package entry site, or a null one when the function does not observe diagnostics.
effect fn currentSite(builder: &mut Builder, origin: Origin) -> Place ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<DiagnosticPlaces>.Some {value} = &builder.diagnostics { return run copyPlace(&value.site) }
  let absent = run temporary(&mut builder.*, &run siteType(), origin)
  run assign(&mut builder.*, place(absent), Rvalue.Use {value: Operand.Null {ty: run siteType()}}, origin)
  return place(absent)
}

// The hidden operands of an independent call: no observer and no selected failure (N1), or
// none when the program does not observe diagnostics.
effect fn independentDiagnostics(observing: bool) -> Option<Diagnostics> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !observing { return Option<Diagnostics>.none() }
  return Option<Diagnostics>.some(run Diagnostics.make(Operand.Null {ty: run observerAddress()}, Operand.Null {ty: run causeType()},
    Operand.Null {ty: run siteType()}))
}

fn swapDiagnostics(builder: &mut Builder, next: Option<DiagnosticPlaces>) -> Option<DiagnosticPlaces> {
  return Intrinsic.replace(builder.diagnostics, move next)
}

// Selects the caught failure's context for its handler's run; returns the places to restore (N2).
effect fn selectCause(builder: &mut Builder, caught: usize, origin: Origin) -> Option<DiagnosticPlaces>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let observer = match &builder.diagnostics {
    Option<DiagnosticPlaces>.Some {value: places} => run copyPlace(&places.observer)
    Option<DiagnosticPlaces>.None => { return Option<DiagnosticPlaces>.none() }
  }
  let address = run temporary(&mut builder.*, &run causeType(), origin)
  run assign(&mut builder.*, place(address), Rvalue.ContextOf {place: place(caught)}, origin)
  let site = match &builder.diagnostics {
    Option<DiagnosticPlaces>.Some {value: places} => run copyPlace(&places.site)
    Option<DiagnosticPlaces>.None => { return Option<DiagnosticPlaces>.none() }
  }
  return swapDiagnostics(&mut builder.*, Option<DiagnosticPlaces>.some(DiagnosticPlaces {observer: move observer, cause: place(address),
    site: move site}))
}

effect fn usizeOperand(value: u64) -> Operand ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return Operand.Integer {decimal: run decimalBytes(value), negative: false,
    ty: run Types.intern(Type.Primitive {name: run Bytes.copy(b"usize")})}
}

// `observeUnhandled()` hands the selected failure's context to the current observer's callback as
// event 5 with its pool handle, and `observeHandled()` as event 7; without an observer or a selected
// failure it is 0 (failure observer note N4). The callback is an independent edge: it runs with no
// observer and no selected failure.
effect fn observeSelected(builder: &mut Builder, ty: &Interned<Type>, event: u64, origin: Origin) -> Operand
! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let output = run temporary(&mut builder.*, ty, origin)
  let current = match &builder.diagnostics {
    Option<DiagnosticPlaces>.Some {value} => Option<DiagnosticPlaces>.some(
      DiagnosticPlaces {observer: run copyPlace(&value.observer), cause: run copyPlace(&value.cause), site: run copyPlace(&value.site)})
    Option<DiagnosticPlaces>.None => Option<DiagnosticPlaces>.none()
  }
  let places = match move current {
    Option<DiagnosticPlaces>.Some {value} => move value
    Option<DiagnosticPlaces>.None => {
      run assign(&mut builder.*, place(output), Rvalue.Use {value: run usizeOperand(0)}, origin)
      return Operand.Copy {place: place(output)}
    }
  }
  let boolean = run Types.intern(Type.Primitive {name: run Bytes.copy(b"bool")})
  let observed = run temporary(&mut builder.*, &boolean, origin)
  run assign(&mut builder.*, place(observed), Rvalue.Binary {operation: InfixOperator.NotEquals,
    left: Operand.Copy {place: run copyPlace(&places.observer)}, right: Operand.Null {ty: run observerAddress()}}, origin)
  let selected = run temporary(&mut builder.*, &boolean, origin)
  run assign(&mut builder.*, place(selected), Rvalue.Binary {operation: InfixOperator.NotEquals,
    left: Operand.Copy {place: run copyPlace(&places.cause)}, right: Operand.Null {ty: run causeType()}}, origin)
  let both = run temporary(&mut builder.*, &boolean, origin)
  run assign(&mut builder.*, place(both), Rvalue.Binary {operation: InfixOperator.BitAnd,
    left: Operand.Copy {place: place(observed)}, right: Operand.Copy {place: place(selected)}}, origin)
  let report = run block(&mut builder.*, origin)
  let quiet = run block(&mut builder.*, origin)
  let joined = run block(&mut builder.*, origin)
  terminate(&mut builder.*, Terminator.Branch {condition: Operand.Copy {place: place(both)}, thenBlock: report,
    elseBlock: quiet, origin: origin})
  resume(&mut builder.*, report)
  let mut identity = run copyPlace(&places.cause)
  run List<Projection>.append(&mut identity.projections, Projection.Deref)
  let mut label = run copyPlace(&identity)
  run List<Projection>.append(&mut identity.projections, Projection.ConstIndex {index: usize.ZERO})
  run List<Projection>.append(&mut label.projections, Projection.ConstIndex {index: usize.ONE})
  // Reads go through statements, so the companion layout is an emission input.
  let text = run reportTextType()
  let named = run temporary(&mut builder.*, &text, origin)
  run assign(&mut builder.*, place(named), Rvalue.Use {value: Operand.Copy {place: move identity}}, origin)
  let located = run temporary(&mut builder.*, &text, origin)
  run assign(&mut builder.*, place(located), Rvalue.Use {value: Operand.Copy {place: move label}}, origin)
  let causeHandle = run temporary(&mut builder.*, &run usizeType(), origin)
  run assign(&mut builder.*, place(causeHandle), Rvalue.ContextHandle {address: Operand.Copy {place: run copyPlace(&places.cause)}}, origin)
  run callObserver(&mut builder.*, &places.observer, event, Operand.Copy {place: place(causeHandle)}, run usizeOperand(0),
    Operand.Copy {place: place(named)}, Operand.Copy {place: place(located)}, output, joined, origin)
  resume(&mut builder.*, quiet)
  run assign(&mut builder.*, place(output), Rvalue.Use {value: run usizeOperand(0)}, origin)
  terminate(&mut builder.*, Terminator.Goto {target: joined, origin: origin})
  resume(&mut builder.*, joined)
  return Operand.Copy {place: place(output)}
}

effect fn singleOperand(value: Operand) -> List<Operand> ! OutOfMemoryError ? &mut Allocator {
  let mut values = List<Operand>.make()
  run List<Operand>.append(&mut values, move value)
  return move values
}

// An expression statement's owned value is dropped at once; a place read leaves its owner alone.
effect fn discard(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, id: BodyNodeId) -> () ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
  let selectedType = run instanceNodeType(&builder.*, body, id)
  let value = run expression(&mut builder.*, body, hir, id)
  if !builder.live || !ownedRvalue(body, id) { return () }
  if let Option<Interned<Type>>.Some {value: ty} = move selectedType {
    if CleanupNeeds.node(&builder.needs, id.index) {
      let owner = InstanceKey.identity(&builder.function.key)
      match move value {
        Operand.Copy {place: stored} => { run dropPlace(&mut builder.*, move stored, &ty, &owner, nodeOrigin(body, id)) }
        Operand.Move {place: stored} => { run dropPlace(&mut builder.*, move stored, &ty, &owner, nodeOrigin(body, id)) }
        _ => {}
      }
    }
  }
  return ()
}

effect fn lowerStatement(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, id: BodyNodeId, pending: usize) -> ()
! Gap | CanonicalizationFailure | OutOfMemoryError
? &mut Allocator | &mut Types {
  let selected = run instanceView(&mut builder.*, body, id)
  let owner = InstanceKey.identity(&builder.function.key)
  match move selected {
    View.Integer {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Float {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Text {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Boolean {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Unit {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Embedded {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.ForeignAddress {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.ForeignStatic {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Local {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Move {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Borrow {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Dereference {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Field {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.ArrayLength {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.ArrayRepeat {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.ArraySlice {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.SliceLength {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Index {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Aggregate {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.StagedCallable {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.EnumMember {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.EnumValue {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Match {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.UnionInject {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.UnionWiden {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.PatternBinding {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.VariantConstruct {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.PlaceAssignment {target, value, origin} => {
      let destination = run expressionPlace(&mut builder.*, body, hir, target)
      let assigned = run expression(&mut builder.*, body, hir, value)
      if !builder.live { return () }
      let root = placeOwnerIndex(&builder.*, &destination)
      let targetType = run instanceNodeType(&builder.*, body, target)
      let mut initialized = usize.MAX
      if let Option<Interned<Type>>.Some {value: replaced} = move targetType {
        if CleanupNeeds.node(&builder.needs, target.index) {
          initialized = run replaceOld(&mut builder.*, root, &destination, &replaced, origin)
        }
      }
      run assign(&mut builder.*, move destination, Rvalue.Use {value: move assigned}, origin)
      run refill(&mut builder.*, initialized)
    }
    View.Prefix {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Infix {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Intrinsic {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Storage {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Call {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Run {..} => {
      run discard(&mut builder.*, body, hir, id)
    }
    View.Fail {value, origin} => {
      // The failure value moves out before every scope the exit leaves is dropped (D7).
      let failed = run expression(&mut builder.*, body, hir, value)
      if !builder.live { return () }
      let owner = InstanceKey.identity(&builder.function.key)
      if builder.failure == usize.MAX {
        // An instance that cannot fail raises only an uninhabited value, which never exists.
        let raised = match move run instanceNodeType(&builder.*, body, value) {
          Option<Interned<Type>>.Some {value: raisedType} => move raisedType
          Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
        }
        if !Interned<Type>.with<bool>(&raised, neverType) { return run unsupported(&owner, origin, GapCode.TypedForm) }
        drop failed
        terminate(&mut builder.*, Terminator.Unreachable {origin: origin})
        return ()
      }
      let destination = builder.failure
      run assign(&mut builder.*, place(destination), Rvalue.Use {value: move failed}, origin)
      run raise(&mut builder.*, origin)
      run leaveFunction(&mut builder.*, ExitKind.Fails, origin)
    }
    View.Binding {index, initializer, origin} => {
      if !(run constructInto(&mut builder.*, body, hir, initializer, index + usize.ONE)) {
        let value = run expression(&mut builder.*, body, hir, initializer)
        if !builder.live { return () }
        run assign(&mut builder.*, place(index + usize.ONE), Rvalue.Use {value: move value}, origin)
      }
      if !builder.live { return () }
      let ty = localType(&builder.*, index + usize.ONE)
      // A borrowing binding keeps its initializer's temporaries alive for its whole scope.
      if Interned<Type>.with<bool>(&ty, Type.holdsView) { run retainTemporaries(&mut builder.*, pending) }
      let needed = CleanupNeeds.local(&builder.needs, index)
      run acquire(&mut builder.*, index + usize.ONE, &ty, needed)
    }
    View.Assignment {index, value, origin} => {
      let assigned = run expression(&mut builder.*, body, hir, value)
      if !builder.live { return () }
      let replaced = ownerIndex(&builder.*, index + usize.ONE)
      let ty = localType(&builder.*, index + usize.ONE)
      let destination = place(index + usize.ONE)
      let mut initialized = usize.MAX
      if replaced != usize.MAX { initialized = run replaceOld(&mut builder.*, replaced, &destination, &ty, origin) }
      run assign(&mut builder.*, move destination, Rvalue.Use {value: move assigned}, origin)
      run refill(&mut builder.*, initialized)
    }
    View.Return {value, origin} => {
      // The returned value moves out before every scope the return leaves is dropped.
      if let Option<BodyNodeId>.Some {value: returned} = move value {
        if !(run constructInto(&mut builder.*, body, hir, returned, usize.ZERO)) {
          let result = run expression(&mut builder.*, body, hir, returned)
          if !builder.live { return () }
          run assign(&mut builder.*, place(usize.ZERO), Rvalue.Use {value: move result}, origin)
        }
        if !builder.live { return () }
      }
      run leaveFunction(&mut builder.*, ExitKind.Returns, origin)
    }
    View.Branch {condition, thenBranch, elseBranch, origin} => {
      let evaluated = run expression(&mut builder.*, body, hir, condition)
      if !builder.live { return () }
      let tested = run settledCondition(&mut builder.*, move evaluated, pending, origin)
      let thenBlock = run block(&mut builder.*, origin)
      let elseBlock = run block(&mut builder.*, origin)
      let join = run block(&mut builder.*, origin)
      terminate(
        &mut builder.*,
        Terminator.Branch {
          condition: move tested,
          thenBlock: thenBlock,
          elseBlock: elseBlock,
          origin: origin,
        },
      )
      let entry = run ownerStates(&builder.*)
      let mut arrivals = List<Arrival>.make()
      resume(&mut builder.*, thenBlock)
      run statement(&mut builder.*, body, hir, thenBranch)
      let thenLive = builder.live
      if thenLive {
        run List<Arrival>.append(&mut arrivals, run arrival(&builder.*))
        terminate(&mut builder.*, Terminator.Goto {target: join, origin: origin})
      }
      run restoreOwners(&mut builder.*, &entry)
      resume(&mut builder.*, elseBlock)
      if let Option<BodyNodeId>.Some {value: other} = move elseBranch {
        run statement(&mut builder.*, body, hir, other)
      }
      let elseLive = builder.live
      if elseLive {
        run List<Arrival>.append(&mut arrivals, run arrival(&builder.*))
        terminate(&mut builder.*, Terminator.Goto {target: join, origin: origin})
      }
      if thenLive || elseLive {
        resume(&mut builder.*, join)
        run joinOwners(&mut builder.*, List<Arrival>.asSlice(&arrivals), origin)
      }
    }
    View.While {condition, body: loopBody, origin} => {
      let header = run block(&mut builder.*, origin)
      let loopBlock = run block(&mut builder.*, origin)
      let exit = run block(&mut builder.*, origin)
      let heads = run loopHeads(&mut builder.*, origin)
      terminate(&mut builder.*, Terminator.Goto {target: header, origin: origin})
      resume(&mut builder.*, header)
      let evaluated = run expression(&mut builder.*, body, hir, condition)
      if !builder.live { return () }
      // The condition's temporaries end before each test of the loop.
      let tested = run settledCondition(&mut builder.*, move evaluated, pending, origin)
      let mut exits = List<Arrival>.make()
      run List<Arrival>.append(&mut exits, run arrival(&builder.*))
      terminate(
        &mut builder.*,
        Terminator.Branch {
          condition: move tested,
          thenBlock: loopBlock,
          elseBlock: exit,
          origin: origin,
        },
      )
      let ownersBefore = List<Owner>.length(&builder.owners)
      let temporariesBefore = List<Pending>.length(&builder.temporaries)
      let iteration = run copyIndices(&heads)
      run List<LoopTargets>.append(&mut builder.*.loops, LoopTargets {
        exit: exit, repeat: header, owners: ownersBefore, temporaries: temporariesBefore, heads: move iteration, exits: move exits,
      })
      resume(&mut builder.*, loopBlock)
      run statement(&mut builder.*, body, hir, loopBody)
      if builder.live {
        run repeatLoop(&mut builder.*, &heads, origin)
        terminate(&mut builder.*, Terminator.Goto {target: header, origin: origin})
      }
      let finished = match move List<LoopTargets>.pop(&mut builder.*.loops) {
        Option<LoopTargets>.Some {value} => move value
        Option<LoopTargets>.None => { return run unsupported(&owner, origin, GapCode.BreakOutsideLoop) }
      }
      resume(&mut builder.*, exit)
      run joinOwners(&mut builder.*, List<Arrival>.asSlice(&finished.exits), origin)
    }
    View.Break {origin} => {
      let loops = List<LoopTargets>.asSlice(&builder.loops)
      if loops.length == usize.ZERO {
        return run unsupported(&owner, origin, GapCode.BreakOutsideLoop)
      }
      let innermost = loops.length - usize.ONE
      let exit = loops[innermost].exit
      let kept = loops[innermost].owners
      let pendingBefore = loops[innermost].temporaries
      // `break` drops only the scopes it leaves (CLEANUP-002), then joins the loop's exit.
      run exitTo(&mut builder.*, kept, pendingBefore, origin)
      let edge = run arrival(&builder.*)
      let mut targets = List<LoopTargets>.asMutSlice(&mut builder.*.loops)
      run List<Arrival>.append(&mut targets[innermost].exits, move edge)
      terminate(&mut builder.*, Terminator.Goto {target: exit, origin: origin})
    }
    View.Drop {value, release, origin} => {
      let dropped = match move run instanceNodeType(&builder.*, body, value) {
        Option<Interned<Type>>.Some {value: droppedType} => move droppedType
        Option<Interned<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
      }
      let needed = CleanupNeeds.node(&builder.needs, value.index)
      let fresh = match &release { Release.Value => true _ => false }
      if fresh {
        // Dropping a value taken through a pointer cleans the pointee in place: moving it out first
        // would only copy it to the stack.
        if needed {
          if let Option<BodyNodeId>.Some {value: pointer} = takenPointer(body, value) {
            let address = run expression(&mut builder.*, body, hir, pointer)
            if !builder.live { return () }
            let mut pointee = run operandPlace(&owner, move address, origin)
            run List<Projection>.append(&mut pointee.projections, Projection.Deref)
            return run dropPlace(&mut builder.*, move pointee, &dropped, &owner, origin)
          }
        }
        // A fresh rvalue is evaluated once and cleaned as one complete value.
        let operand = run expression(&mut builder.*, body, hir, value)
        if !builder.live { return () }
        if needed {
          let storage = match move operand {
            Operand.Copy {place: stored} => move stored
            Operand.Move {place: stored} => move stored
            _ => { return run unsupported(&owner, origin, GapCode.ExpectedPlace) }
          }
          run dropPlace(&mut builder.*, move storage, &dropped, &owner, origin)
        }
      } else {
        // An owned place's initialized remainder is cleaned in place, before ending its ownership.
        let storage = run expressionPlace(&mut builder.*, body, hir, value)
        if !builder.live { return () }
        run dropReleased(&mut builder.*, &release, move storage, &dropped, needed, origin)
      }
    }
    View.Continue {origin} => {
      let loops = List<LoopTargets>.asSlice(&builder.loops)
      if loops.length == usize.ZERO {
        return run unsupported(&owner, origin, GapCode.ContinueOutsideLoop)
      }
      let innermost = loops.length - usize.ONE
      let repeat = loops[innermost].repeat
      let kept = loops[innermost].owners
      let pendingBefore = loops[innermost].temporaries
      run exitTo(&mut builder.*, kept, pendingBefore, origin)
      let targets = List<LoopTargets>.asSlice(&builder.loops)
      let heads = run copyIndices(&targets[innermost].heads)
      run repeatLoop(&mut builder.*, &heads, origin)
      terminate(&mut builder.*, Terminator.Goto {target: repeat, origin: origin})
    }
    View.Block {count, node: blockNode, origin} => {
      run openScope(&mut builder.*)
      run blockStatements(&mut builder.*, body, hir, blockNode, count, origin)
      // A yielded value whose block runs as a statement is discarded like an expression statement.
      if let Option<BodyNodeId>.Some {value: yielded} = move blockValue(body, blockNode) { run statement(&mut builder.*, body, hir, yielded) }
      run closeScope(&mut builder.*, origin)
    }
    View.Unsupported {origin} => {
      return run unsupported(&owner, origin, GapCode.TypedForm)
    }
  }
  return ()
}

// Traverse the same shallow views as lowering. A completed return/break or both returning
// branches ends its surrounding block, so unreachable checked calls contribute no proof demand.
effect fn collectCallNodes(body: &Shared<TypedBody>, id: BodyNodeId, output: &mut List<BodyNodeId>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let selected = view(body, id, &[])
  match move selected {
    View.Call {node, count, ..} => {
      let mut at = usize.ZERO
      while at < count {
        if let Option<BodyNodeId>.Some {value} = move childAt(body, node, at) { drop run collectCallNodes(body, value, &mut output.*) }
        at = at + usize.ONE
      }
      run List<BodyNodeId>.append(&mut output.*, node)
    }
    View.Intrinsic {member, node, ..} => {
      let mut at = usize.ZERO
      while true {
        let child = match move childAt(body, node, at) { Option<BodyNodeId>.Some {value} => value _ => { break } }
        drop run collectCallNodes(body, child, &mut output.*)
        at = at + usize.ONE
      }
      // A checked scalar operation invokes one of its carriers.
      if let Option<ScalarOperation>.Some {..} = move checkedOperation(member) { run List<BodyNodeId>.append(&mut output.*, node) }
    }
    // A storage call's facts are prepared with the calls; its operands are evaluated first.
    View.Storage {node, ..} => {
      let mut at = usize.ZERO
      while true {
        let child = match move childAt(body, node, at) { Option<BodyNodeId>.Some {value} => value _ => { break } }
        drop run collectCallNodes(body, child, &mut output.*)
        at = at + usize.ONE
      }
      run List<BodyNodeId>.append(&mut output.*, node)
    }
    View.Aggregate {node, ..} => {
      let mut at = usize.ZERO
      while true {
        let child = match move childAt(body, node, at) { Option<BodyNodeId>.Some {value} => value _ => { break } }
        drop run collectCallNodes(body, child, &mut output.*)
        at = at + usize.ONE
      }
    }
    View.StagedCallable {node, ..} => {
      let mut at = usize.ZERO
      while true {
        let child = match move childAt(body, node, at) { Option<BodyNodeId>.Some {value} => value _ => { break } }
        if !run collectCallNodes(body, child, &mut output.*) { return false }
        at = at + usize.ONE
      }
    }
    View.VariantConstruct {node, ..} => {
      let mut at = usize.ZERO
      while true {
        let child = match move childAt(body, node, at) { Option<BodyNodeId>.Some {value} => value _ => { break } }
        drop run collectCallNodes(body, child, &mut output.*)
        at = at + usize.ONE
      }
    }
    View.Move {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.Run {value, ..} => {
      drop run collectCallNodes(body, value, &mut output.*)
      run List<BodyNodeId>.append(&mut output.*, id)
    }
    View.Fail {value, ..} => {
      drop run collectCallNodes(body, value, &mut output.*)
      return false
    }
    View.Drop {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.EnumValue {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.UnionInject {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.UnionWiden {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.Match {node, subject, count, ..} => {
      drop run collectCallNodes(body, subject, &mut output.*)
      let mut at = usize.ZERO
      while at < count {
        if let Option<ArmView>.Some {value: arm} = move armView(body, node, at) {
          if let Option<BodyNodeId>.Some {value: guard} = move arm.guard { drop run collectCallNodes(body, guard, &mut output.*) }
          drop run collectCallNodes(body, arm.result, &mut output.*)
        }
        at = at + usize.ONE
      }
    }
    View.Borrow {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.Dereference {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.Field {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.ArrayLength {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.ArrayRepeat {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.ArraySlice {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.SliceLength {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.Index {value, index, ..} => {
      drop run collectCallNodes(body, value, &mut output.*)
      drop run collectCallNodes(body, index, &mut output.*)
    }
    View.Prefix {operand, ..} => { drop run collectCallNodes(body, operand, &mut output.*) }
    View.Infix {left, right, ..} => {
      drop run collectCallNodes(body, left, &mut output.*)
      drop run collectCallNodes(body, right, &mut output.*)
    }
    View.Binding {initializer, ..} => { drop run collectCallNodes(body, initializer, &mut output.*) }
    View.Assignment {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.PlaceAssignment {target, value, ..} => {
      drop run collectCallNodes(body, target, &mut output.*)
      drop run collectCallNodes(body, value, &mut output.*)
    }
    View.Return {value, ..} => {
      if let Option<BodyNodeId>.Some {value: returned} = move value { drop run collectCallNodes(body, returned, &mut output.*) }
      return false
    }
    View.Break {..} => { return false }
    View.Continue {..} => { return false }
    View.Branch {condition, thenBranch, elseBranch, ..} => {
      drop run collectCallNodes(body, condition, &mut output.*)
      let first = run collectCallNodes(body, thenBranch, &mut output.*)
      let mut second = true
      if let Option<BodyNodeId>.Some {value} = move elseBranch { second = run collectCallNodes(body, value, &mut output.*) }
      return first || second
    }
    View.While {condition, body: loopBody, ..} => {
      drop run collectCallNodes(body, condition, &mut output.*)
      drop run collectCallNodes(body, loopBody, &mut output.*)
    }
    View.Block {node, count, ..} => {
      let mut at = usize.ZERO
      while at < count {
        if let Option<BodyNodeId>.Some {value} = move childAt(body, node, at) {
          if !run collectCallNodes(body, value, &mut output.*) { return false }
        }
        at = at + usize.ONE
      }
      if let Option<BodyNodeId>.Some {value: yielded} = move blockValue(body, node) { return run collectCallNodes(body, yielded, &mut output.*) }
    }
    _ => {}
  }
  return true
}

// Appends the blocks `terminator` can continue to, in order.
effect fn appendTerminatorSuccessors(terminator: &Terminator, result: &mut List<usize>) -> () ! OutOfMemoryError ? &mut Allocator {
  match &terminator.* {
    Terminator.Goto {target, ..} => run List<usize>.append(&mut result.*, target)
    Terminator.Branch {thenBlock, elseBlock, ..} => {
      run List<usize>.append(&mut result.*, thenBlock)
      run List<usize>.append(&mut result.*, elseBlock)
    }
    Terminator.Call {normal, failure, ..} => {
      run List<usize>.append(&mut result.*, normal)
      if let Option<FailureEdge>.Some {value: edge} = &failure { run List<usize>.append(&mut result.*, edge.target) }
    }
    Terminator.Relinquish {resume, ..} => run List<usize>.append(&mut result.*, resume)
    Terminator.Switch {cases, otherwise, ..} => {
      let listed = List<SwitchCase>.asSlice(&cases)
      let mut at = usize.ZERO
      while at < listed.length {
        run List<usize>.append(&mut result.*, listed[at].target)
        at = at + usize.ONE
      }
      run List<usize>.append(&mut result.*, otherwise)
    }
    _ => {}
  }
  return ()
}

// Trims each block's statements, then the block list itself.
// Whether reference `left` sorts before reference `right` by runtime name: by their name digests
// when every reference has one, else by the names themselves.
// Fills in the second digest half of each partial order whose first half another reference
// shares, so the orders compare as the full digests do.
effect fn completeTiedOrders(listed: &[Reference], digests: &mut List<NameOrder>, partial: &[bool]) -> ()
! OutOfMemoryError ? &mut Allocator {
  let orders = List<NameOrder>.asMutSlice(&mut digests.*)
  let mut at = usize.ZERO
  while at < orders.length {
    if partial[at] {
      let mut other = usize.ZERO
      let mut tied = false
      while other < orders.length && !tied {
        tied = other != at && orders[other].first == orders[at].first
        other = other + usize.ONE
      }
      if tied {
        if let Option<NameOrder>.Some {value} = run InstanceKey.nameOrder(&listed[at].key) { orders[at] = value }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

fn referenceBefore(digested: bool, orders: &[NameOrder], names: &[Bytes], left: usize, right: usize) -> bool {
  if digested { return NameOrder.before(orders[left], orders[right]) }
  return RuntimeEncoding.less(Bytes.asSlice(&names[left]), Bytes.asSlice(&names[right]))
}

effect fn compactBlocks(blocks: &mut List<Block>) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<Block>.shrinkToFit(&mut blocks.*)
  let mut listed = List<Block>.asMutSlice(&mut blocks.*)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<Statement>.shrinkToFit(&mut listed[at].statements)
    at = at + usize.ONE
  }
  return ()
}

impl MirFunction {
  /// Releases the spare capacity of the block, statement and local lists of a finished function,
  /// which stays stored for the rest of the compilation.
  pub effect fn compact(function: &mut MirFunction) -> () ! OutOfMemoryError ? &mut Allocator {
    run compactBlocks(&mut function.*.blocks)
    return run List<Local>.shrinkToFit(&mut function.*.locals)
  }

  /// The blocks `block` can continue to, including the cancel exit of a suspension point: a
  /// cancelled frame restores the point's state and drops what is live there.
  pub effect fn successors(function: &MirFunction, block: usize) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
    let mut result = List<usize>.make()
    run MirFunction.appendSuccessors(function, block, &mut result)
    return move result
  }

  /// Appends [`MirFunction.successors`] of `block` to `into`, without a list of its own.
  pub effect fn appendSuccessors(function: &MirFunction, block: usize, into: &mut List<usize>) -> () ! OutOfMemoryError ? &mut Allocator {
    let blocks = List<Block>.asSlice(&function.blocks)
    run appendTerminatorSuccessors(&blocks[block].terminator, &mut into.*)
    let cancels = List<Cancel>.asSlice(&function.cancels)
    let mut at = usize.ZERO
    while at < cancels.length {
      if cancels[at].point == block { run List<usize>.append(&mut into.*, cancels[at].entry) }
      at = at + usize.ONE
    }
    return ()
  }

  /// Orders reached instances by symbol so worklist edges are deterministic.
  pub effect fn sortReferences(references: &mut List<Reference>) -> () ! OutOfMemoryError ? &mut Allocator {
    let listed = List<Reference>.asSlice(&references.*)
    // Without a C export every name is its digest, so the digests order the keys without names.
    // A function or drop glue key holds its digest's first half; the second half hashes the whole
    // encoding, so it is computed only for keys whose first halves tie.
    let mut digests = List<NameOrder>.make()
    let mut partial = List<bool>.make()
    run List<NameOrder>.reserveExact(&mut digests, listed.length)
    run List<bool>.reserveExact(&mut partial, listed.length)
    let mut at = usize.ZERO
    while at < listed.length {
      if let Option<u64>.Some {value: first} = InstanceKey.heldNameFirst(&listed[at].key) {
        run List<NameOrder>.append(&mut digests, NameOrder {first: first, second: 0})
        run List<bool>.append(&mut partial, true)
      } else {
        match move run InstanceKey.nameOrder(&listed[at].key) {
          Option<NameOrder>.Some {value} => {
            run List<NameOrder>.append(&mut digests, value)
            run List<bool>.append(&mut partial, false)
          }
          Option<NameOrder>.None => { at = listed.length }
        }
      }
      at = at + usize.ONE
    }
    let digested = List<NameOrder>.length(&digests) == listed.length
    let mut symbols = List<Bytes>.make()
    at = usize.ZERO
    while !digested && at < listed.length {
      run List<Bytes>.append(&mut symbols, run InstanceKey.runtimeName(&listed[at].key))
      at = at + usize.ONE
    }
    let mut order = List<usize>.make()
    run List<usize>.reserveExact(&mut order, listed.length)
    at = usize.ZERO
    while at < listed.length {
      run List<usize>.append(&mut order, at)
      at = at + usize.ONE
    }
    if digested {
      run completeTiedOrders(listed, &mut digests, List<bool>.asSlice(&partial))
    }
    let sorted = List<usize>.asMutSlice(&mut order)
    let names = List<Bytes>.asSlice(&symbols)
    let orders = List<NameOrder>.asSlice(&digests)
    at = usize.ONE
    while at < sorted.length {
      let mut next = at
      while next > usize.ZERO && referenceBefore(digested, orders, names, sorted[next], sorted[next - usize.ONE]) {
        let prior = sorted[next - usize.ONE]
        sorted[next - usize.ONE] = sorted[next]
        sorted[next] = prior
        next = next - usize.ONE
      }
      at = at + usize.ONE
    }
    let mut output = List<Reference>.make()
    at = usize.ZERO
    while at < sorted.length {
      let current = &listed[sorted[at]]
      run List<Reference>.append(
        &mut output,
        Reference {
          key: InstanceKey.copy(&current.key),
          edge: Edge.copy(&current.edge),
          origin: current.origin,
        },
      )
      at = at + usize.ONE
    }
    references.* = move output
    return ()
  }
  /// Lists only calls reached by ordinary MIR control-flow lowering, in evaluation order.
  pub effect fn callNodes(body: &Shared<TypedBody>) -> List<BodyNodeId> ! OutOfMemoryError ? &mut Allocator {
    let mut output = List<BodyNodeId>.make()
    drop run collectCallNodes(body, bodyRoot(body), &mut output)
    return move output
  }
  /// Makes one C export shim as ordinary MIR: its C-classified scalar and pointer lanes pass
  /// unchanged to the exported function's ordinary Silk instance, whose result it returns.
  pub effect fn cExport(function: &Interned<DeclarationId>, symbol: &Shared<Bytes>, parameters: &[Interned<Type>],
    result: &Interned<Type>, observing: bool) -> MirFunction
  ! OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let origin = Origin {node: usize.ZERO, location: Location.generated()}
    let key = InstanceKey.Export {function: Interned<DeclarationId>.clone(function), symbol: Shared<Bytes>.clone(symbol)}
    let callee = run InstanceKey.named(function)
    let mut locals = List<Local>.make()
    run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(result), kind: LocalKind.Return, origin: origin})
    let mut lanes = List<Interned<Type>>.make()
    let mut arguments = List<Operand>.make()
    let mut at = usize.ZERO
    while at < parameters.length {
      run List<Local>.append(&mut locals,
        Local {ty: Interned<Type>.clone(&parameters[at]), kind: LocalKind.Parameter {index: at}, origin: origin})
      run List<Interned<Type>>.append(&mut lanes, Interned<Type>.clone(&parameters[at]))
      run List<Operand>.append(&mut arguments, Operand.Copy {place: place(at + usize.ONE)})
      at = at + usize.ONE
    }
    let mut blocks = List<Block>.make()
    run List<Block>.append(
      &mut blocks,
      Block {
        statements: List<Statement>.make(),
        terminator: Terminator.Call {
          callee: Callee.Instance {key: InstanceKey.copy(&callee)},
          arguments: move arguments,
          providers: List<Operand>.make(),
          diagnostics: run independentDiagnostics(observing),
          destination: place(usize.ZERO),
          normal: usize.ONE,
          failure: Option<FailureEdge>.none(),
          origin: origin,
        },
      },
    )
    run List<Block>.append(&mut blocks, Block {statements: List<Statement>.make(), terminator: Terminator.Return {origin: origin}})
    let mut references = List<Reference>.make()
    run List<Reference>.append(&mut references, Reference {key: move callee, edge: Edge.Direct, origin: origin})
    return MirFunction {
      key: move key,
      borrow: BodyBorrowStatus.Checked,
      result: Interned<Type>.clone(result),
      parameters: move lanes,
      locals: move locals,
      blocks: move blocks,
      references: move references,
      externs: List<Interned<DeclarationId>>.make(),
      observes: false,
      contexts: List<ContextText>.make(), traps: List<TrapSite>.make(), suspension: Option<Origin>.none(), parks: Option<Origin>.none(), releasesPackages: false, nonParking: List<NonParkingRun>.make(), cancels: List<Cancel>.make(), accesses: List<SharedAccess>.make(), escapes: List<EscapeSite>.make(), features: Bytes.make(), inlining: Inlining.Default, optimizeSize: false, frame: Bytes.make(), lines: List<u64>.make(), variables: List<Variable>.make(),
    }
  }
  /// Lowers a closed body while preserving its unfinished safety status, without reading a callee body.
  pub effect fn lower(
    key: InstanceKey,
    body: &Shared<TypedBody>,
    hir: &Module,
    result: &Interned<Type>,
    failure: &Interned<Type>,
    parameters: &[Interned<Type>],
    providers: &[Interned<Type>],
    calls: List<CallTarget>,
    plans: List<NodePlan>,
    storage: List<StoragePlan>,
    carriers: List<CarrierPlan>,
    witnessIntrinsics: List<WitnessIntrinsic>,
    remainders: List<Remainder>,
    needs: CleanupNeeds,
    projections: List<RuntimeProjection>,
    source: &[u8],
    anchor: &Anchor,
    observing: bool,
    lineTables: bool,
    packageRoot: Option<ModuleId>,
    suspending: Option<List<InstanceKey>>,
    constants: List<ConstantValue>,
  ) -> Lowered ! Gap | CanonicalizationFailure | OutOfMemoryError ? &mut Allocator | &mut Types {
    let application = run InstanceKey.selected(&key)
    let bindings = run Application.bindings(&application)
    let supplied = List<Binding>.asSlice(&bindings)
    let selectedProjections = List<RuntimeProjection>.asSlice(&projections)

    let closedResult = run RuntimeType.applyBindings(result, supplied, selectedProjections)
    let root = bodyRoot(body)
    let origin = bodyOrigin(body)
    // ContractTyped bodies are not fully checked, and building MIR checks nothing more:
    // unsupported expression forms and layouts still stop emission with a named gap.
    let mut params = List<Interned<Type>>.make()
    let mut at = usize.ZERO
    while at < parameters.length {
      run List<Interned<Type>>.append(
        &mut params,
        run RuntimeType.applyBindings(&parameters[at], supplied, selectedProjections),
      )
      at = at + usize.ONE
    }
    let mut locals = List<Local>.make()
    run List<Local>.append(
      &mut locals,
      Local {ty: Interned<Type>.clone(&closedResult), kind: LocalKind.Return, origin: origin},
    )
    at = usize.ZERO
    let count = localCount(body)
    while at < count {
      let local = localView(body, at)
      let mut kind = LocalKind.User {index: at}
      if at < parameters.length {
        kind = LocalKind.Parameter {index: at}
      }
      run List<Local>.append(
        &mut locals,
        Local {
          ty: run RuntimeType.applyBindings(&local.ty, supplied, selectedProjections),
          kind: move kind,
          origin: local.origin,
        },
      )
      at = at + usize.ONE
    }
    // One hidden provider address per requirement entry, after the written parameters (D2).
    let mut providerLocals = run List<usize>.makeWithCapacity(providers.length)
    let mut providerAt = usize.ZERO
    while providerAt < providers.length {
      run List<usize>.append(&mut providerLocals, List<Local>.length(&locals))
      run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&providers[providerAt]),
        kind: LocalKind.Provider {index: providerAt}, origin: origin})
      providerAt = providerAt + usize.ONE
    }
    // In a program that observes diagnostics, every function receives the current observer and
    // selected-cause addresses after its providers (N1, N2).
    let mut diagnostics = Option<DiagnosticPlaces>.none()
    let mut sites = Option<SiteText>.none()
    if observing {
      let observerLocal = List<Local>.length(&locals)
      run List<Local>.append(&mut locals, Local {ty: run observerAddress(), kind: LocalKind.Observer, origin: origin})
      run List<Local>.append(&mut locals, Local {ty: run causeType(), kind: LocalKind.Cause, origin: origin})
      run List<Local>.append(&mut locals, Local {ty: run siteType(), kind: LocalKind.Site, origin: origin})
      diagnostics = Option<DiagnosticPlaces>.some(DiagnosticPlaces {observer: place(observerLocal),
        cause: place(observerLocal + usize.ONE), site: place(observerLocal + 2)})
      sites = Option<SiteText>.some(run siteText(&key, move packageRoot))
    }
    let mut frame = Bytes.make()
    if let Option<SiteText>.Some {value: named} = &sites { frame = run Bytes.copy(Bytes.asSlice(&named.name)) }
    // A function that can fail writes its failure value to a caller-owned out-slot (D3).
    let mut failureLocal = usize.MAX
    let closedFailure = run Type.applyBindings(failure, supplied, true)
    if !Interned<Type>.with<bool>(&closedFailure, neverType) {
      failureLocal = List<Local>.length(&locals)
      run List<Local>.append(&mut locals, Local {ty: move closedFailure, kind: LocalKind.Failure, origin: origin})
    }
    let mut builder = Builder {
      bindings: move bindings,
      projections: move projections,
      calls: move calls,
      function: MirFunction {
        key: move key,
        borrow: bodyBorrowStatus(body),
        result: move closedResult,
        parameters: move params,
        locals: move locals,
        blocks: List<Block>.make(),
        references: List<Reference>.make(),
        externs: List<Interned<DeclarationId>>.make(),
        observes: false,
        contexts: List<ContextText>.make(), traps: List<TrapSite>.make(), suspension: Option<Origin>.none(), parks: Option<Origin>.none(), releasesPackages: false, nonParking: List<NonParkingRun>.make(), cancels: List<Cancel>.make(), accesses: List<SharedAccess>.make(), escapes: List<EscapeSite>.make(), features: Bytes.make(), inlining: Inlining.Default, optimizeSize: false, frame: move frame, lines: List<u64>.make(), variables: List<Variable>.make(),
      },
      current: usize.ZERO,
      live: true,
      loops: List<LoopTargets>.make(),
      scrutinees: List<Scrutinee>.make(),
      narrowed: List<Narrowed>.make(),
      owners: List<Owner>.make(),
      cleanup: List<CleanupNode>.make(),
      states: List<usize>.make(),
      dropPlans: List<List<usize>>.make(),
      scopes: List<usize>.make(),
      temporaries: List<Pending>.make(),
      exits: List<ExitStep>.make(),
      left: List<LeftExit>.make(),
      forwards: List<ForwardBlock>.make(),
      forward: usize.MAX,
      forwardSite: usize.MAX,
      caught: List<CaughtSlot>.make(),
      remainders: move remainders,
      needs: move needs,
      failure: failureLocal,
      plans: move plans,
      storage: move storage,
      carriers: move carriers,
      witnessIntrinsics: move witnessIntrinsics,
      helpers: List<MirFunction>.make(),
      providers: move providerLocals,
      diagnostics: move diagnostics,
      sites: move sites,
      anchor: Anchor.copy(anchor),
      suspending: move suspending,
      cancelEveryCall: false,
      held: List<HeldFailure>.make(),
      cancelScopes: List<CancelScope>.make(),
      interrupts: List<InterruptBoundary>.make(),
      landing: false,
      constants: move constants,
      written: List<Interned<Type>>.make(),
      closed: List<Interned<Type>>.make(),
      writtenLookup: InternIndex.make(),
    }
    let first = run block(&mut builder, origin)
    resume(&mut builder, first)
    // By-value parameters are owners of the function's outermost scope (CALL-001).
    run openScope(&mut builder)
    at = usize.ZERO
    while at < parameters.length {
      let ty = localType(&builder, at + usize.ONE)
      let needed = CleanupNeeds.local(&builder.needs, at)
      run acquire(&mut builder, at + usize.ONE, &ty, needed)
      at = at + usize.ONE
    }
    run statement(&mut builder, body, hir, root)
    run closeScope(&mut builder, origin)
    if builder.live {
      // Unit may fall through. A non-unit missing return was rejected by body typing.
      terminate(&mut builder, Terminator.Return {origin: origin})
    }
    run closeExits(&mut builder)
    run MirFunction.sortReferences(&mut builder.function.references)
    if lineTables {
      builder.function.lines = run sourceLines(List<Block>.asSlice(&builder.function.blocks), anchor)
      // The adopted packages' helpers are located in this function's source too.
      let mut helpers = List<MirFunction>.asMutSlice(&mut builder.helpers)
      let mut helper = usize.ZERO
      while helper < helpers.length {
        helpers[helper].lines = run sourceLines(List<Block>.asSlice(&helpers[helper].blocks), anchor)
        helper = helper + usize.ONE
      }
      builder.function.variables = run sourceVariables(List<Local>.asSlice(&builder.function.locals), hir, anchor)
    }
    return Lowered {function: move builder.function, helpers: move builder.helpers}
  }
}

/// The origin a statement's instructions are located by, or none.
pub fn statementOrigin(statement: &Statement) -> Option<Origin> {
  return match &statement.* {
    Statement.Assign {origin, ..} => Option<Origin>.some(origin)
    Statement.Drop {origin, ..} => Option<Origin>.some(origin)
    Statement.FailureContext {origin, ..} => Option<Origin>.some(origin)
    _ => Option<Origin>.none()
  }
}

/// The origin a terminator's instructions are located by, or none.
pub fn terminatorOrigin(terminator: &Terminator) -> Option<Origin> {
  return match &terminator.* {
    Terminator.Goto {origin, ..} => Option<Origin>.some(origin)
    Terminator.Branch {origin, ..} => Option<Origin>.some(origin)
    Terminator.Return {origin} => Option<Origin>.some(origin)
    Terminator.Call {origin, ..} => Option<Origin>.some(origin)
    Terminator.Fail {origin} => Option<Origin>.some(origin)
    Terminator.Trap {origin, ..} => Option<Origin>.some(origin)
    Terminator.TrapText {origin, ..} => Option<Origin>.some(origin)
    Terminator.Unreachable {origin} => Option<Origin>.some(origin)
    Terminator.Switch {origin, ..} => Option<Origin>.some(origin)
    _ => Option<Origin>.none()
  }
}

/// The marker position of `origin`: its first token boundary plus one, or zero for a
/// compiler-made origin, which has no authored position.
pub fn markerPosition(origin: Option<Origin>) -> usize {
  if let Option<Origin>.Some {value} = origin {
    if Location.isAuthored(value.location) { return value.location.start + usize.ONE }
  }
  return usize.ZERO
}

// Appends the source place of marker position `position` to `pairs` (`MirFunction.lines`).
effect fn appendSourceLine(pairs: &mut List<u64>, position: usize, anchor: &Anchor) -> () ! OutOfMemoryError ? &mut Allocator {
  if position == usize.ZERO { return () }
  let boundary = position - usize.ONE
  if let Option<Span>.Some {value: span} = Anchor.retainedSpan(anchor, Location.make(boundary, boundary)) {
    let place = Anchor.lineColumn(anchor, span.start)
    // A column past 24 bits, on a line over 16 MB, keeps the line and says column 0.
    let mut column = usize.toU64(place.column)
    if column > 0xFFFFFF { column = 0 }
    run List<u64>.append(&mut pairs.*, u64.shiftLeft(usize.toU64(position), 32))
    run List<u64>.append(&mut pairs.*, u64.bitOr(u64.shiftLeft(usize.toU64(place.line), 24), column))
  }
}

// The `MirFunction.variables` of `locals`: each written parameter and binding whose binder names
// it, with the place of that name.
effect fn sourceVariables(locals: &[Local], hir: &Module, anchor: &Anchor) -> List<Variable> ! OutOfMemoryError ? &mut Allocator {
  let mut variables = List<Variable>.make()
  let mut at = usize.ZERO
  while at < locals.length {
    let mut argument = usize.ZERO
    let mut written = false
    match &locals[at].kind {
      LocalKind.Parameter {index} => {
        argument = index + usize.ONE
        written = true
      }
      LocalKind.User {..} => { written = true }
      _ => {}
    }
    if written {
      let name = match Module.node(hir, Anchor.hir(anchor, locals[at].origin.node)) {
        HirNode.Parameter {name, ..} => Option<HirId>.some(name)
        HirNode.BindingStatement {name, ..} => Option<HirId>.some(name)
        HirNode.BindingPattern {name, ..} => Option<HirId>.some(name)
        _ => Option<HirId>.none()
      }
      if let Option<HirId>.Some {value: named} = name {
        if let HirNode.Name {text} = Module.node(hir, named) {
          let place = Anchor.lineColumn(anchor, Module.span(hir, named).start)
          let mut column = usize.toU64(place.column)
          if column > 0xFFFFFF { column = 0 }
          run List<Variable>.append(&mut variables, Variable {local: at, name: run Bytes.copy(Module.text(hir, text)),
            place: u64.bitOr(u64.shiftLeft(usize.toU64(place.line), 24), column), argument: argument})
        }
      }
    }
    at = at + usize.ONE
  }
  return move variables
}

// The `MirFunction.lines` of `blocks`, resolved through the declaration's `anchor`.
effect fn sourceLines(blocks: &[Block], anchor: &Anchor) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  // Each position's key first, shifted above its place, so one sort orders the pairs.
  let mut keyed = List<u64>.make()
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = List<Statement>.asSlice(&blocks[at].statements)
    let mut index = usize.ZERO
    while index < statements.length {
      run appendSourceLine(&mut keyed, markerPosition(statementOrigin(&statements[index])), anchor)
      index = index + usize.ONE
    }
    run appendSourceLine(&mut keyed, markerPosition(terminatorOrigin(&blocks[at].terminator)), anchor)
    at = at + usize.ONE
  }
  // Sort the (position, place) pairs by position and keep one pair per position.
  let listed = List<u64>.asSlice(&keyed)
  let mut order = List<u64>.make()
  at = usize.ZERO
  while at < listed.length {
    run List<u64>.append(&mut order, u64.bitOr(listed[at], usize.toU64(at / 2)))
    at = at + 2
  }
  run List<u64>.sort(&mut order)
  let mut lines = List<u64>.make()
  let sorted = List<u64>.asSlice(&order)
  let mut last = u64.MAX
  at = usize.ZERO
  while at < sorted.length {
    let position = u64.shiftRight(sorted[at], 32)
    if position != last {
      let pair = u64.toUsize(sorted[at] & 4294967295) * 2
      run List<u64>.append(&mut lines, position)
      run List<u64>.append(&mut lines, listed[pair + usize.ONE])
      last = position
    }
    at = at + usize.ONE
  }
  return move lines
}

effect fn instanceNodeType(builder: &Builder, body: &Shared<TypedBody>, id: BodyNodeId) -> Option<Interned<Type>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  return match move nodeType(body, id) {
    Option<Interned<Type>>.Some {value: ty} => Option<Interned<Type>>.some(
      run RuntimeType.applyBindings(&ty, List<Binding>.asSlice(&builder.bindings), List<RuntimeProjection>.asSlice(&builder.projections)),
    )
    Option<Interned<Type>>.None => Option<Interned<Type>>.none()
  }
}

// The runtime type a written node type closes to in this instance.
effect fn closedType(builder: &mut Builder, ty: &Interned<Type>) -> Interned<Type>
! OutOfMemoryError
? &mut Allocator | &mut Types {
  if List<Binding>.length(&builder.bindings) == usize.ZERO && List<RuntimeProjection>.length(&builder.projections) == usize.ZERO {
    return run RuntimeType.applyBindings(ty, List<Binding>.asSlice(&builder.bindings), List<RuntimeProjection>.asSlice(&builder.projections))
  }
  let hashed = Type.hashExact(ty)
  let known = run writtenTypeAt(&builder.*, ty, hashed)
  if known != usize.MAX { return Interned<Type>.clone(&List<Interned<Type>>.asSlice(&builder.closed)[known]) }
  let closed = run RuntimeType.applyBindings(ty, List<Binding>.asSlice(&builder.bindings), List<RuntimeProjection>.asSlice(&builder.projections))
  run List<Interned<Type>>.append(&mut builder.closed, Interned<Type>.clone(&closed))
  run List<Interned<Type>>.append(&mut builder.written, Interned<Type>.clone(ty))
  run InternIndex.record(&mut builder.writtenLookup, hashed)
  return move closed
}

effect fn writtenTypeAt(builder: &Builder, ty: &Interned<Type>, hashed: u64) -> usize
! OutOfMemoryError
? &mut Allocator | &mut Types {
  let written = List<Interned<Type>>.asSlice(&builder.written)
  let mut at = InternIndex.first(&builder.writtenLookup, hashed)
  while at != usize.MAX {
    if run Type.equalsShared(&written[at], ty) { return at }
    at = InternIndex.after(&builder.writtenLookup, at)
  }
  return usize.MAX
}

effect fn instanceView(builder: &mut Builder, body: &Shared<TypedBody>, id: BodyNodeId) -> View
! OutOfMemoryError
? &mut Allocator | &mut Types {
  let selected = view(body, id, List<ConstantValue>.asSlice(&builder.constants))
  return match move selected {
    View.Integer {ty, literal, origin} => View.Integer {
      ty: run closedType(&mut builder.*, &ty),
      literal: literal,
      origin: origin,
    }
    View.Float {ty, literal, origin} => View.Float {
      ty: run closedType(&mut builder.*, &ty),
      literal: literal,
      origin: origin,
    }
    View.Text {ty, literal, origin} => View.Text {
      ty: run Type.applyBindings(&ty, List<Binding>.asSlice(&builder.bindings), true),
      literal: literal,
      origin: origin,
    }
    View.Local {ty, index, origin} => View.Local {
      ty: run closedType(&mut builder.*, &ty),
      index: index,
      origin: origin,
    }
    View.Move {ty, value, release, origin} => View.Move {
      ty: run closedType(&mut builder.*, &ty),
      value: value,
      release: run instanceRelease(&builder.*, body, id, move release),
      origin: origin,
    }
    View.Borrow {ty, access, value, origin} => View.Borrow {
      ty: run closedType(&mut builder.*, &ty),
      access: access,
      value: value,
      origin: origin,
    }
    View.Dereference {ty, value, origin} => View.Dereference {
      ty: run closedType(&mut builder.*, &ty),
      value: value,
      origin: origin,
    }
    View.Field {ty, value, index, origin} => View.Field {
      ty: run closedType(&mut builder.*, &ty),
      value: value,
      index: index,
      origin: origin,
    }
    View.Index {ty, value, index, element, origin} => View.Index {
      ty: run closedType(&mut builder.*, &ty),
      value: value,
      index: index,
      element: element,
      origin: origin,
    }
    View.ArrayLength {ty, value, count, origin} => View.ArrayLength {
      ty: run closedType(&mut builder.*, &ty),
      value: value,
      count: count,
      origin: origin,
    }
    View.ArrayRepeat {ty, value, count, origin} => View.ArrayRepeat {
      ty: run closedType(&mut builder.*, &ty), value: value, count: count, origin: origin,
    }
    View.ArraySlice {ty, value, count, origin} => View.ArraySlice {
      ty: run closedType(&mut builder.*, &ty), value: value, count: count, origin: origin,
    }
    View.SliceLength {ty, value, origin} => View.SliceLength {
      ty: run closedType(&mut builder.*, &ty), value: value, origin: origin,
    }
    View.Aggregate {ty, node, count, origin} => View.Aggregate {
      ty: run closedType(&mut builder.*, &ty),
      node: node,
      count: count,
      origin: origin,
    }
    View.StagedCallable {ty, node, count, origin} => View.StagedCallable {
      ty: run closedType(&mut builder.*, &ty), node: node, count: count, origin: origin,
    }
    View.EnumMember {ty, member, origin} => View.EnumMember {
      ty: run closedType(&mut builder.*, &ty), member: member, origin: origin,
    }
    View.EnumValue {ty, value, origin} => View.EnumValue {
      ty: run closedType(&mut builder.*, &ty), value: value, origin: origin,
    }
    View.Match {ty, node, subject, place: placeMatch, consumes, release, tags, count, syntax, origin} => View.Match {
      ty: run closedType(&mut builder.*, &ty), node: node, subject: subject, place: placeMatch, consumes: consumes,
      release: run instanceRelease(&builder.*, body, id, move release), tags: tags, count: count, syntax: syntax, origin: origin,
    }
    View.VariantConstruct {ty, node, tag, count, origin} => View.VariantConstruct {
      ty: run closedType(&mut builder.*, &ty), node: node, tag: tag, count: count, origin: origin,
    }
    View.UnionWiden {ty, value, origin} => View.UnionWiden {
      value: value, ty: run closedType(&mut builder.*, &ty), origin: origin,
    }
    View.UnionInject {ty, value, origin} => View.UnionInject {
      ty: run closedType(&mut builder.*, &ty), value: value, origin: origin,
    }
    View.PatternBinding {ty, node, subject, origin} => View.PatternBinding {
      ty: run closedType(&mut builder.*, &ty), node: node, subject: subject, origin: origin,
    }
    View.Prefix {ty, operation, operand, origin} => View.Prefix {
      ty: run closedType(&mut builder.*, &ty),
      operation: operation,
      operand: operand,
      origin: origin,
    }
    View.Infix {ty, operation, left, right, origin} => View.Infix {
      ty: run closedType(&mut builder.*, &ty),
      operation: operation,
      left: left,
      right: right,
      origin: origin,
    }
    View.Call {ty, environment, foreign, variadicArguments, count, node, origin} => View.Call {
      environment: environment,
      ty: run closedType(&mut builder.*, &ty),
      foreign: move foreign,
      // Tail admission already requires closed primitive types, independent of instance binders.
      variadicArguments: move variadicArguments,
      count: count,
      node: node,
      origin: origin,
    }
    View.Intrinsic {ty, member, node, origin} => View.Intrinsic {
      ty: run closedType(&mut builder.*, &ty),
      member: member,
      node: node,
      origin: origin,
    }
    View.Storage {ty, operation, node, origin} => View.Storage {
      ty: run closedType(&mut builder.*, &ty), operation: operation, node: node, origin: origin,
    }
    View.Run {ty, value, origin} => View.Run {ty: run closedType(&mut builder.*, &ty), value: value, origin: origin}
    View.Fail {value, origin} => View.Fail {value: value, origin: origin}
    View.Boolean {value, origin} => View.Boolean {value: value, origin: origin}
    View.Unit {origin} => View.Unit {origin: origin}
    View.Embedded {value, ty, origin} => View.Embedded {
      value: move value, ty: run closedType(&mut builder.*, &ty), origin: origin,
    }
    View.ForeignAddress {declaration, symbol, ty, origin} => View.ForeignAddress {
      declaration: Interned<DeclarationId>.clone(&declaration), symbol: Shared<Bytes>.clone(&symbol),
      ty: Interned<Type>.clone(&ty), origin: origin,
    }
    View.ForeignStatic {declaration, ty, origin} => View.ForeignStatic {
      declaration: move declaration, ty: run closedType(&mut builder.*, &ty), origin: origin,
    }
    View.PlaceAssignment {target, value, origin} => View.PlaceAssignment {
      target: target,
      value: value,
      origin: origin,
    }
    View.Binding {index, initializer, origin} => View.Binding {
      index: index,
      initializer: initializer,
      origin: origin,
    }
    View.Assignment {index, value, origin} => View.Assignment {
      index: index,
      value: value,
      origin: origin,
    }
    View.Return {value, origin} => View.Return {value: move value, origin: origin}
    View.Branch {condition, thenBranch, elseBranch, origin} => View.Branch {
      condition: condition,
      thenBranch: thenBranch,
      elseBranch: move elseBranch,
      origin: origin,
    }
    View.While {condition, body: loopBody, origin} => View.While {
      condition: condition,
      body: loopBody,
      origin: origin,
    }
    View.Break {origin} => View.Break {origin: origin}
    View.Continue {origin} => View.Continue {origin: origin}
    View.Drop {value, release, origin} => View.Drop {value: value, release: run instanceRelease(&builder.*, body, id, move release), origin: origin}
    View.Block {count, node, origin} => View.Block {count: count, node: node, origin: origin}
    View.Unsupported {origin} => View.Unsupported {origin: origin}
  }
}

fn resolvedCallTarget(builder: &Builder, node: BodyNodeId) -> Option<ResolvedCall> {
  let calls = List<CallTarget>.asSlice(&builder.calls)
  let mut at = usize.ZERO
  while at < calls.length {
    if calls[at].node.index == node.index {
      return Option<ResolvedCall>.some(ResolvedCall {key: InstanceKey.copy(&calls[at].key), edge: Edge.copy(&calls[at].edge),
        nonParking: calls[at].nonParking})
    }
    at = at + usize.ONE
  }
  return Option<ResolvedCall>.none()
}

fn receiverDereferences(builder: &Builder, node: BodyNodeId) -> usize {
  let calls = List<CallTarget>.asSlice(&builder.calls)
  let mut at = usize.ZERO
  while at < calls.length {
    if calls[at].node.index == node.index { return calls[at].receiverDereferences }
    at = at + usize.ONE
  }
  return usize.ZERO
}

effect fn projectCallableReceiver(place: &mut Place, count: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < count {
    run List<Projection>.append(&mut place.*.projections, Projection.Deref)
    at = at + usize.ONE
  }
  return ()
}

// The prepared operands of the call at `node`, in target parameter order.
effect fn callOperands(builder: &Builder, node: BodyNodeId) -> List<CallOperand> ! OutOfMemoryError ? &mut Allocator {
  let mut output = List<CallOperand>.make()
  let mut index = usize.ZERO
  while true {
    match move resolvedCallOperand(builder, node, index) {
      Option<CallOperand>.Some {value} => run List<CallOperand>.append(&mut output, move value)
      Option<CallOperand>.None => { return move output }
    }
    index = index + usize.ONE
  }
  return move output
}

fn resolvedCallOperand(builder: &Builder, node: BodyNodeId, index: usize) -> Option<CallOperand> {
  let calls = List<CallTarget>.asSlice(&builder.calls)
  let mut at = usize.ZERO
  while at < calls.length {
    if calls[at].node.index == node.index {
      let operands = List<CallOperand>.asSlice(&calls[at].operands)
      if index < operands.length {
        let borrow = match &operands[index].borrow {
          Option<Access>.Some {value} => Option<Access>.some(value)
          Option<Access>.None => Option<Access>.none()
        }
        return Option<CallOperand>.some(CallOperand {value: Interned<Type>.clone(&operands[index].value),
          parameter: Interned<Type>.clone(&operands[index].parameter), borrow: move borrow})
      }
    }
    at = at + usize.ONE
  }
  return Option<CallOperand>.none()
}

fn absurd<T>() -> T {
  return Intrinsic.trap("an internal invariant failed")
}

fn copyBodyUnionMember(value: &Option<BodyUnionMember>) -> Option<BodyUnionMember> {
  return match &value.* {
    Option<BodyUnionMember>.Some {value: member} => Option<BodyUnionMember>.some(BodyUnionMember {tag: member.tag,
      ty: Interned<Type>.clone(&member.ty), source: Interned<Type>.clone(&member.source)})
    _ => Option<BodyUnionMember>.none()
  }
}

fn copyOptionalType(value: &Option<Interned<Type>>) -> Option<Interned<Type>> {
  return match &value.* {
    Option<Interned<Type>>.Some {value: ty} => Option<Interned<Type>>.some(Interned<Type>.clone(&ty))
    _ => Option<Interned<Type>>.none()
  }
}
