//! Backend-neutral control flow for one checked scalar function instance.

import backend.Gap {Code as GapCode, Gap}
import backend.InstanceKey {InstanceKey}
import backend.Layout {Layout}
import semantic.Specialization {Application, Edge}
import semantic.RuntimeEncoding
import semantic.StaticValue
import semantic.StaticValue {Sign as StaticSign, Value as StaticData}
import hir.FloatingLiteral
import silk.f32
import silk.f64
import silk.format {ParseError}
import silk.result {Result}
import silk.u32
import silk.u64
import hir.Hir {Access, HirId, InfixOperator, Module, Node as HirNode, PrefixOperator, Sign}
import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId}
import semantic.Type {Argument, Binding, ArrayShape, Requirement, Row, RowParameter, Type}
import semantic.Intrinsic as CheckedIntrinsic
import semantic.Intrinsic {Member as IntrinsicMember}
import semantic.TypedBody {
  Expression as BodyExpression,
  AggregateField as BodyAggregateField,
  EnumMember as BodyEnumMember,
  MatchArm as BodyMatchArm,
  Pattern as BodyPattern,
  UnionMember as BodyUnionMember,
  PatternStep as BodyPatternStep,
  PatternTest as BodyPatternTest,
  NodeId as BodyNodeId,
  NodeKind as BodyNodeKind,
  Origin,
  TypedBody,
  Stage,
}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// One local storage slot. Positions are stable within this MIR answer only.
pub struct Local {
  pub ty: Shared<Type>
  pub kind: LocalKind
  pub origin: Origin
}

pub union LocalKind {
  Return,
  Parameter {pub index: usize},
  User {pub index: usize},
  Temp,
}

pub struct Place {
  pub local: usize
  pub projections: Vector<Projection>
}

pub union Projection {
  Field {pub index: usize},
  /// The member storage of a structural union selected by canonical tag `index`.
  Payload {pub index: usize, pub ty: Shared<Type>},
  /// One field of the nominal union variant with declaration-order tag `variant`.
  VariantField {pub variant: usize, pub field: usize},
  Index {pub local: usize},
  ConstIndex {pub index: usize},
  Deref,
}

pub union Operand {
  Copy {pub place: Place},
  Move {pub place: Place},
  Integer {pub decimal: Bytes, pub negative: bool, pub ty: Shared<Type>},
  Float {pub bits: u64, pub ty: Shared<Type>},
  Boolean {pub value: bool},
  Unit,
}

/// One aggregate operand evaluated in written order and stored at its canonical field.
pub struct AggregateField {
  pub index: usize
  pub value: Operand
}

pub union Rvalue {
  Aggregate {pub fields: Vector<AggregateField>},
  /// An explicit array loan becomes a descriptor with its logical count.
  Slice {pub data: Operand, pub count: usize},
  /// Reads the runtime length stored in a descriptor place.
  SliceLength {pub place: Place},
  Use {pub value: Operand},
  Ref {pub access: Access, pub place: Place},
  AddressOf {pub access: Access, pub place: Place},
  Unary {pub operation: PrefixOperator, pub value: Operand},
  Binary {pub operation: InfixOperator, pub left: Operand, pub right: Operand},
  Bitcast {pub value: Operand, pub ty: Shared<Type>},
  /// Reads a structural union's tag from its place.
  Discriminant {pub place: Place},
  /// Stores `value` as the union member with canonical tag `tag`.
  Inject {pub tag: usize, pub value: Operand},
  /// Stores a nominal union variant: its tag, then each operand at its variant field.
  Variant {pub tag: usize, pub fields: Vector<AggregateField>},
}

pub union Statement {
  Assign {pub destination: Place, pub value: Rvalue, pub origin: Origin},
  Drop {pub destination: Place, pub origin: Origin},
}

pub union Terminator {
  Goto {pub target: usize, pub origin: Origin},
  Branch {pub condition: Operand, pub thenBlock: usize, pub elseBlock: usize, pub origin: Origin},
  Return {pub origin: Origin},
  Call {
    pub callee: Callee,
    pub arguments: Vector<Operand>,
    pub destination: Place,
    pub normal: usize,
    pub failure: Option<usize>,
    pub origin: Origin,
  },
  Trap {pub origin: Origin},
  Unreachable {pub origin: Origin},
  /// Jumps to the case whose value equals the scalar operand, or to `otherwise` for every other value.
  Switch {pub value: Operand, pub cases: Vector<SwitchCase>, pub otherwise: usize, pub origin: Origin},
}

/// One distinct switch value in sign-magnitude decimal form and its target block.
pub struct SwitchCase {
  pub decimal: Bytes
  pub negative: bool
  pub target: usize
}

/// Direct Silk and C callees keep separate identities and worklist edges.
pub union Callee {
  Instance {pub key: InstanceKey},
  Extern {pub declaration: Shared<DeclarationId>},
}

pub struct Block {
  pub statements: Vector<Statement>
  pub terminator: Terminator
}

/// The answer for one instance. `references` is the backend-independent worklist edge set.
pub struct MirFunction {
  pub key: InstanceKey
  /// Whether body safety has been checked; MIR construction never discharges pending obligations.
  pub safetyChecked: bool
  pub result: Shared<Type>
  pub parameters: Vector<Shared<Type>>
  pub locals: Vector<Local>
  pub blocks: Vector<Block>
  pub references: Vector<Reference>
  pub externs: Vector<Shared<DeclarationId>>
}

/// A sorted reached instance with its admission provenance and authored call site.
pub struct Reference {
  pub key: InstanceKey
  pub edge: Edge
  pub origin: Origin
}

struct LoopTargets {
  exit: usize
  repeat: usize
}

/// A checked call's resolved canonical target, prepared without demanding its body.
/// One written value and its validated specialized target parameter.
pub struct CallOperand {
  pub value: Shared<Type>
  pub parameter: Shared<Type>
  pub borrow: Option<Access>
}

pub struct CallTarget {
  pub node: BodyNodeId
  pub key: InstanceKey
  pub edge: Edge
  pub operands: Vector<CallOperand>
}

struct ResolvedCall {
  key: InstanceKey
  edge: Edge
}

// The evaluated place of one match subject; arm bindings project from it.
struct Scrutinee {
  subject: usize
  place: Place
}

struct Builder {
  bindings: Vector<Binding>
  calls: Vector<CallTarget>
  function: MirFunction
  current: usize
  live: bool
  loops: Vector<LoopTargets>
  scrutinees: Vector<Scrutinee>
}

// A shallow, owned projection of one cached typed node. Shared.with never leaks a body loan.
union View {
  Integer {ty: Shared<Type>, literal: HirId, origin: Origin},
  Embedded {value: Shared<StaticData>, ty: Shared<Type>, origin: Origin},
  Float {ty: Shared<Type>, literal: HirId, origin: Origin},
  Boolean {value: bool, origin: Origin},
  Unit {origin: Origin},
  Local {index: usize, ty: Shared<Type>, origin: Origin},
  Move {value: BodyNodeId, ty: Shared<Type>, origin: Origin},
  Borrow {access: Access, value: BodyNodeId, ty: Shared<Type>, origin: Origin},
  Dereference {value: BodyNodeId, ty: Shared<Type>, origin: Origin},
  Field {value: BodyNodeId, index: usize, ty: Shared<Type>, origin: Origin},
  Index {value: BodyNodeId, index: BodyNodeId, ty: Shared<Type>, origin: Origin},
  ArrayLength {value: BodyNodeId, count: usize, ty: Shared<Type>, origin: Origin},
  ArraySlice {value: BodyNodeId, count: usize, ty: Shared<Type>, origin: Origin},
  SliceLength {value: BodyNodeId, ty: Shared<Type>, origin: Origin},
  Aggregate {node: BodyNodeId, count: usize, ty: Shared<Type>, origin: Origin},
  EnumMember {member: BodyEnumMember, ty: Shared<Type>, origin: Origin},
  EnumValue {value: BodyNodeId, ty: Shared<Type>, origin: Origin},
  Match {node: BodyNodeId, subject: BodyNodeId, place: bool, tags: usize, count: usize, ty: Shared<Type>, origin: Origin},
  VariantConstruct {node: BodyNodeId, tag: usize, count: usize, ty: Shared<Type>, origin: Origin},
  UnionInject {tag: usize, value: BodyNodeId, ty: Shared<Type>, origin: Origin},
  PatternBinding {node: BodyNodeId, subject: BodyNodeId, ty: Shared<Type>, origin: Origin},
  PlaceAssignment {target: BodyNodeId, value: BodyNodeId, origin: Origin},
  Prefix {operation: PrefixOperator, operand: BodyNodeId, ty: Shared<Type>, origin: Origin},
  Infix {
    operation: InfixOperator,
    left: BodyNodeId,
    right: BodyNodeId,
    ty: Shared<Type>,
    origin: Origin,
  },
  Call {
    foreign: Option<Shared<DeclarationId>>,
    count: usize,
    node: BodyNodeId,
    ty: Shared<Type>,
    origin: Origin,
  },
  Intrinsic {member: IntrinsicMember, node: BodyNodeId, ty: Shared<Type>, origin: Origin},
  Binding {index: usize, initializer: BodyNodeId, origin: Origin},
  Assignment {index: usize, value: BodyNodeId, origin: Origin},
  Return {value: Option<BodyNodeId>, origin: Origin},
  Branch {
    condition: BodyNodeId,
    thenBranch: BodyNodeId,
    elseBranch: Option<BodyNodeId>,
    origin: Origin,
  },
  While {condition: BodyNodeId, body: BodyNodeId, origin: Origin},
  Break {origin: Origin},
  Continue {origin: Origin},
  Block {count: usize, node: BodyNodeId, origin: Origin},
  Unsupported {origin: Origin},
}

struct LocalView {
  ty: Shared<Type>
  origin: Origin
}

fn bodyRoot(body: &Shared<TypedBody>) -> BodyNodeId {
  return Shared.with<TypedBody, BodyNodeId>(body, TypedBody.rootNode)
}

fn nodeOrigin(body: &Shared<TypedBody>, id: BodyNodeId) -> Origin {
  return Shared.with<TypedBody, Origin>(
    body,
    fn(value: &TypedBody) -> Origin {
      return TypedBody.nodeSlice(value)[id.index].origin
    },
  )
}

fn nodeType(body: &Shared<TypedBody>, id: BodyNodeId) -> Option<Shared<Type>> {
  return Shared.with<TypedBody, Option<Shared<Type>>>(body, fn(value: &TypedBody) -> Option<Shared<Type>> {
    let nodes = TypedBody.nodeSlice(value)
    if let BodyNodeKind.Expression {ty, ..} = &nodes[id.index].kind {
      return Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
    }
    return Option.none<Shared<Type>>()
  })
}

fn bodyOrigin(body: &Shared<TypedBody>) -> Origin {
  return Shared.with<TypedBody, Origin>(
    body,
    fn(value: &TypedBody) -> Origin {
      let root = TypedBody.rootNode(value)
      return TypedBody.nodeSlice(value)[root.index].origin
    },
  )
}

fn bodySafetyChecked(body: &Shared<TypedBody>) -> bool {
  return Shared.with<TypedBody, bool>(
    body,
    fn(value: &TypedBody) -> bool {
      let stage = TypedBody.checkingStage(value)
      return match & stage.* {
        Stage.FullyChecked => true
        Stage.ContractTyped {..} => false
      }
    },
  )
}

fn localCount(body: &Shared<TypedBody>) -> usize {
  return Shared.with<TypedBody, usize>(
    body,
    fn(value: &TypedBody) -> usize {
      return TypedBody.localSlice(value).length
    },
  )
}

fn localView(body: &Shared<TypedBody>, index: usize) -> LocalView {
  return Shared.with<TypedBody, LocalView>(
    body,
    fn(value: &TypedBody) -> LocalView {
      let locals = TypedBody.localSlice(value)
      return LocalView {ty: Shared.clone<Type>(&locals[index].ty), origin: locals[index].origin}
    },
  )
}

fn childAt(body: &Shared<TypedBody>, id: BodyNodeId, index: usize) -> Option<BodyNodeId> {
  return Shared.with<TypedBody, Option<BodyNodeId>>(
    body,
    fn(value: &TypedBody) -> Option<BodyNodeId> {
      let nodes = TypedBody.nodeSlice(value)
      return match & nodes[id.index].kind {
        BodyNodeKind.Block {statements, ..} => {
          let children = Vector.asSlice<BodyNodeId>(&statements)
          if index < children.length {
            return Option.some<BodyNodeId>(children[index])
          }
          return Option.none<BodyNodeId>()
        }
        BodyNodeKind.Expression {form: BodyExpression.Aggregate {fields}, ..} => {
          let children = Vector.asSlice<BodyAggregateField>(&fields)
          if index < children.length { return Option.some<BodyNodeId>(children[index].value) }
          return Option.none<BodyNodeId>()
        }
        BodyNodeKind.Expression {form: BodyExpression.VariantConstruct {fields, ..}, ..} => {
          let children = Vector.asSlice<BodyAggregateField>(&fields)
          if index < children.length { return Option.some<BodyNodeId>(children[index].value) }
          return Option.none<BodyNodeId>()
        }
        BodyNodeKind.Expression {form: BodyExpression.DirectCall {arguments, ..}, ..} => {
          let children = Vector.asSlice<BodyNodeId>(&arguments)
          if index < children.length {
            return Option.some<BodyNodeId>(children[index])
          }
          return Option.none<BodyNodeId>()
        }
        BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {arguments, ..}, ..} => {
          let children = Vector.asSlice<BodyNodeId>(&arguments)
          if index < children.length { return Option.some<BodyNodeId>(children[index]) }
          return Option.none<BodyNodeId>()
        }
        BodyNodeKind.Expression {form: BodyExpression.ForeignCall {arguments, ..}, ..} => {
          let children = Vector.asSlice<BodyNodeId>(&arguments)
          if index < children.length {
            return Option.some<BodyNodeId>(children[index])
          }
          return Option.none<BodyNodeId>()
        }
        BodyNodeKind.Expression {form: BodyExpression.IntrinsicCall {arguments, ..}, ..} => {
          let children = Vector.asSlice<BodyNodeId>(&arguments)
          if index < children.length {
            return Option.some<BodyNodeId>(children[index])
          }
          return Option.none<BodyNodeId>()
        }
        _ => Option.none<BodyNodeId>()
      }
    },
  )
}

fn aggregateFieldIndex(body: &Shared<TypedBody>, id: BodyNodeId, index: usize) -> usize {
  return Shared.with<TypedBody, usize>(body, fn(value: &TypedBody) -> usize {
    let nodes = TypedBody.nodeSlice(value)
    if let BodyNodeKind.Expression {form: BodyExpression.Aggregate {fields}, ..} = &nodes[id.index].kind {
      let children = Vector.asSlice<BodyAggregateField>(&fields)
      if index < children.length { return children[index].index }
    }
    if let BodyNodeKind.Expression {form: BodyExpression.VariantConstruct {fields, ..}, ..} = &nodes[id.index].kind {
      let children = Vector.asSlice<BodyAggregateField>(&fields)
      if index < children.length { return children[index].index }
    }
    return usize.MAX
  })
}

fn foreignIdentityMatches(handle: &Shared<DeclarationId>, declaration: &DeclarationId) -> bool {
  return Shared.with<DeclarationId, bool>(handle, fn(identity: &DeclarationId) -> bool {
    return DeclarationId.equals(identity, declaration)
  })
}

fn view(body: &Shared<TypedBody>, id: BodyNodeId) -> View {
  return Shared.with<TypedBody, View>(
    body,
    fn(bodyValue: &TypedBody) -> View {
      let nodes = TypedBody.nodeSlice(bodyValue)
      let origin = nodes[id.index].origin
      return match & nodes[id.index].kind {
        BodyNodeKind.Expression {ty, form} => match & form {
          BodyExpression.Integer {literal} => View.Integer {
            ty: Shared.clone<Type>(&ty),
            literal: literal,
            origin: origin,
          }
          BodyExpression.Float {literal} => View.Float {
            ty: Shared.clone<Type>(&ty),
            literal: literal,
            origin: origin,
          }
          BodyExpression.Boolean {value} => View.Boolean {value: value, origin: origin}
          BodyExpression.Unit => View.Unit {origin: origin}
          BodyExpression.Embedded {value} => View.Embedded {
            value: Shared.clone<StaticData>(&value), ty: Shared.clone<Type>(&ty), origin: origin,
          }
          BodyExpression.Local {local} => View.Local {
            index: local.index,
            ty: Shared.clone<Type>(&ty),
            origin: origin,
          }
          BodyExpression.Move {value} => View.Move {
            value: value,
            ty: Shared.clone<Type>(&ty),
            origin: origin,
          }
          // Pointer access weakening is the existing scalar value-copy lane, with no address change.
          BodyExpression.PointerAccessWeaken {value} => View.Move {
            value: value, ty: Shared.clone<Type>(&ty), origin: origin,
          }
          BodyExpression.Borrow {access, value} => View.Borrow {
            access: access,
            value: value,
            ty: Shared.clone<Type>(&ty),
            origin: origin,
          }
          BodyExpression.Dereference {value} => View.Dereference {
            value: value,
            ty: Shared.clone<Type>(&ty),
            origin: origin,
          }
          BodyExpression.Field {value, index} => View.Field {
            value: value,
            index: index,
            ty: Shared.clone<Type>(&ty),
            origin: origin,
          }
          BodyExpression.ArrayLength {value, count} => View.ArrayLength {
            value: value, count: count, ty: Shared.clone<Type>(&ty), origin: origin,
          }
          BodyExpression.ArraySlice {value, count} => View.ArraySlice {
            value: value, count: count, ty: Shared.clone<Type>(&ty), origin: origin,
          }
          BodyExpression.SliceLength {value} => View.SliceLength {
            value: value, ty: Shared.clone<Type>(&ty), origin: origin,
          }
          BodyExpression.Index {value, index} => View.Index {
            value: value, index: index, ty: Shared.clone<Type>(&ty), origin: origin,
          }
          BodyExpression.Aggregate {fields} => View.Aggregate {
            node: id, count: Vector.length<BodyAggregateField>(&fields),
            ty: Shared.clone<Type>(&ty), origin: origin,
          }
          BodyExpression.EnumMember {member} => View.EnumMember {
            member: member, ty: Shared.clone<Type>(&ty), origin: origin,
          }
          BodyExpression.EnumValue {value} => View.EnumValue {
            value: value, ty: Shared.clone<Type>(&ty), origin: origin,
          }
          BodyExpression.VariantConstruct {tag, fields} => View.VariantConstruct {
            node: id, tag: tag, count: Vector.length<BodyAggregateField>(&fields), ty: Shared.clone<Type>(&ty), origin: origin,
          }
          BodyExpression.Match {subject, place, tags, arms} => View.Match {
            node: id, subject: subject, place: place, tags: tags, count: Vector.length<BodyMatchArm>(&arms),
            ty: Shared.clone<Type>(&ty), origin: origin,
          }
          BodyExpression.UnionInject {tag, value} => View.UnionInject {
            tag: tag, value: value, ty: Shared.clone<Type>(&ty), origin: origin,
          }
          BodyExpression.PatternBinding {subject, ..} => View.PatternBinding {
            node: id, subject: subject, ty: Shared.clone<Type>(&ty), origin: origin,
          }
          BodyExpression.ConcretePrefix {operator, operand} => View.Prefix {
            operation: operator,
            operand: operand,
            ty: Shared.clone<Type>(&ty),
            origin: origin,
          }
          BodyExpression.ConcreteInfix {operator, left, right} => View.Infix {
            operation: operator,
            left: left,
            right: right,
            ty: Shared.clone<Type>(&ty),
            origin: origin,
          }
          BodyExpression.DirectCall {arguments, ..} => View.Call {
            foreign: Option.none<Shared<DeclarationId>>(),
            count: Vector.length<BodyNodeId>(&arguments), node: id,
            ty: Shared.clone<Type>(&ty), origin: origin,
          }
          BodyExpression.InterfaceCall {arguments, ..} => View.Call {
            foreign: Option.none<Shared<DeclarationId>>(),
            count: Vector.length<BodyNodeId>(&arguments), node: id,
            ty: Shared.clone<Type>(&ty), origin: origin,
          }
          BodyExpression.IntrinsicCall {member, ..} => View.Intrinsic {
            member: member,
            node: id,
            ty: Shared.clone<Type>(&ty),
            origin: origin,
          }
          BodyExpression.ForeignCall {declaration, arguments} => {
            let identities = TypedBody.foreignHandles(bodyValue)
            let mut at = usize.ZERO
            while at < identities.length {
              let matched = foreignIdentityMatches(&identities[at], &declaration)
              if matched {
                return View.Call {
                  foreign: Option.some<Shared<DeclarationId>>(Shared.clone<DeclarationId>(&identities[at])),
                  count: Vector.length<BodyNodeId>(&arguments),
                  node: id,
                  ty: Shared.clone<Type>(&ty),
                  origin: origin,
                }
              }
              at = at + usize.ONE
            }
            return View.Unsupported {origin: origin}
          }
          _ => View.Unsupported {origin: origin}
        }
        BodyNodeKind.LocalBinding {local, initializer} => View.Binding {
          index: local.index,
          initializer: initializer,
          origin: origin,
        }
        BodyNodeKind.MutableBinding {local, initializer} => View.Binding {
          index: local.index,
          initializer: initializer,
          origin: origin,
        }
        BodyNodeKind.Assignment {local, value} => View.Assignment {
          index: local.index,
          value: value,
          origin: origin,
        }
        BodyNodeKind.PlaceAssignment {target, value} => View.PlaceAssignment {
          target: target,
          value: value,
          origin: origin,
        }
        BodyNodeKind.Return {value} => View.Return {
          value: match & value {
            Option<BodyNodeId>.Some {value: returned} => Option.some<BodyNodeId>(returned)
            Option<BodyNodeId>.None => Option.none<BodyNodeId>()
          },
          origin: origin,
        }
        BodyNodeKind.Branch {condition, thenBranch, elseBranch, ..} => View.Branch {
          condition: condition,
          thenBranch: thenBranch,
          elseBranch: match & elseBranch {
            Option<BodyNodeId>.Some {value: other} => Option.some<BodyNodeId>(other)
            Option<BodyNodeId>.None => Option.none<BodyNodeId>()
          },
          origin: origin,
        }
        BodyNodeKind.While {condition, body: loopBody} => View.While {
          condition: condition,
          body: loopBody,
          origin: origin,
        }
        BodyNodeKind.Break => View.Break {origin: origin}
        BodyNodeKind.Continue => View.Continue {origin: origin}
        BodyNodeKind.Block {statements, ..} => View.Block {
          count: Vector.length<BodyNodeId>(&statements),
          node: id,
          origin: origin,
        }
      }
    },
  )
}

fn place(local: usize) -> Place {
  return Place {local: local, projections: Vector.make<Projection>()}
}

effect fn unsupported(owner: &Shared<DeclarationId>, origin: Origin, code: GapCode) -> never
! Gap | OutOfMemoryError
? &mut Allocator {
  fail Gap.make(code, owner, origin.span)
}

effect fn block(builder: &mut Builder, origin: Origin) -> usize ! OutOfMemoryError ? &mut Allocator {
  let index = Vector.length<Block>(&builder.function.blocks)
  run Vector.append<Block>(
    &mut builder.*.function.blocks,
    Block {
      statements: Vector.make<Statement>(),
      terminator: Terminator.Unreachable {origin: origin},
    },
  )
  return index
}

fn terminate(builder: &mut Builder, terminator: Terminator) -> () {
  let current = builder.current
  let mut blocks = Vector.asMutSlice<Block>(&mut builder.*.function.blocks)
  blocks[current].terminator = move terminator
  builder.live = false
  return ()
}

fn resume(builder: &mut Builder, index: usize) -> () {
  builder.current = index
  builder.live = true
  return ()
}

effect fn assign(builder: &mut Builder, destination: Place, value: Rvalue, origin: Origin) -> ()
! OutOfMemoryError
? &mut Allocator {
  let current = builder.current
  let mut blocks = Vector.asMutSlice<Block>(&mut builder.*.function.blocks)
  return run Vector.append<Statement>(
    &mut blocks[current].statements,
    Statement.Assign {destination: move destination, value: move value, origin: origin},
  )
}

effect fn temporary(builder: &mut Builder, ty: &Shared<Type>, origin: Origin) -> usize
! OutOfMemoryError
? &mut Allocator {
  let index = Vector.length<Local>(&builder.function.locals)
  run Vector.append<Local>(
    &mut builder.*.function.locals,
    Local {ty: Shared.clone<Type>(ty), kind: LocalKind.Temp, origin: origin},
  )
  return index
}

effect fn copyPlace(value: &Place) -> Place ! OutOfMemoryError ? &mut Allocator {
  let mut copied = place(value.local)
  let projections = Vector.asSlice<Projection>(&value.projections)
  let mut at = usize.ZERO
  while at < projections.length {
    let selected = match &projections[at] {
      Projection.Field {index} => Projection.Field {index: index}
      Projection.Payload {index, ty} => Projection.Payload {index: index, ty: Shared.clone<Type>(&ty)}
      Projection.VariantField {variant, field} => Projection.VariantField {variant: variant, field: field}
      Projection.Index {local} => Projection.Index {local: local}
      Projection.ConstIndex {index} => Projection.ConstIndex {index: index}
      Projection.Deref => Projection.Deref
    }
    run Vector.append<Projection>(&mut copied.projections, move selected)
    at = at + usize.ONE
  }
  return move copied
}

// The owned projection of step `at` of one pattern path, if the path has that many steps.
fn stepProjection(path: &Vector<BodyPatternStep>, at: usize) -> Option<Projection> {
  let steps = Vector.asSlice<BodyPatternStep>(path)
  if at < steps.length {
    if let BodyPatternStep.Member {tag, ty} = &steps[at] { return Option.some<Projection>(Projection.Payload {index: tag, ty: Shared.clone<Type>(&ty)}) }
    if let BodyPatternStep.VariantField {tag, field} = &steps[at] { return Option.some<Projection>(Projection.VariantField {variant: tag, field: field}) }
    if let BodyPatternStep.Field {index} = &steps[at] { return Option.some<Projection>(Projection.Field {index: index}) }
  }
  return Option.none<Projection>()
}

// An owned projection step of one binding path, read under a short body borrow.
fn bindingStepAt(body: &Shared<TypedBody>, node: BodyNodeId, at: usize) -> Option<Projection> {
  return Shared.with<TypedBody, Option<Projection>>(body, fn(value: &TypedBody) -> Option<Projection> {
    let nodes = TypedBody.nodeSlice(value)
    if let BodyNodeKind.Expression {form: BodyExpression.PatternBinding {path, ..}, ..} = &nodes[node.index].kind {
      return stepProjection(&path, at)
    }
    return Option.none<Projection>()
  })
}

effect fn expressionPlace(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  id: BodyNodeId,
) -> Place ! Gap | OutOfMemoryError ? &mut Allocator {
  let selected = run instanceView(&builder.*, body, id)
  let owner = InstanceKey.identity(&builder.function.key)
  return match move selected {
    View.Local {index, ..} => place(index + usize.ONE)
    View.Field {value, index, ..} => {
      let mut projected = run expressionPlace(&mut builder.*, body, hir, value)
      run Vector.append<Projection>(&mut projected.projections, Projection.Field {index: index})
      return move projected
    }
    View.Index {value, index, origin, ..} => {
      // Bounds precede the projected access and a PlaceAssignment's replacement expression.
      let mut projected = run expressionPlace(&mut builder.*, body, hir, value)
      let subjectType = match move run instanceNodeType(&builder.*, body, value) {
        Option<Shared<Type>>.Some {value: selectedType} => move selectedType
        Option<Shared<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
      }
      let mut knownLength = Option.none<usize>()
      if let Option<ArrayShape>.Some {value: facts} = move Type.arrayShape(&subjectType) {
        knownLength = Option.some<usize>(facts.length)
      } else {
        if let Option<Shared<Type>>.None = move Type.sliceElement(&subjectType) {
          return run unsupported(&owner, origin, GapCode.IndexProjection)
        }
        // A descriptor is captured before evaluating the index, which may call user code.
        let snapshot = run temporary(&mut builder.*, &subjectType, origin)
        run assign(&mut builder.*, place(snapshot), Rvalue.Use {value: Operand.Copy {place: move projected}}, origin)
        projected = place(snapshot)
      }
      let indexType = match move run instanceNodeType(&builder.*, body, index) {
        Option<Shared<Type>>.Some {value: selectedType} => move selectedType
        Option<Shared<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
      }
      let input = run expression(&mut builder.*, body, hir, index)
      let captured = run temporary(&mut builder.*, &indexType, origin)
      run assign(&mut builder.*, place(captured), Rvalue.Use {value: move input}, origin)
      let mut bound = Operand.Unit
      if let Option<usize>.Some {value: count} = move knownLength {
        bound = Operand.Integer {decimal: run Type.extentText(count), negative: false, ty: Shared.clone<Type>(&indexType)}
      } else {
        let lengthSlot = run temporary(&mut builder.*, &indexType, origin)
        let lengthPlace = run copyPlace(&projected)
        run assign(&mut builder.*, place(lengthSlot), Rvalue.SliceLength {place: move lengthPlace}, origin)
        bound = Operand.Copy {place: place(lengthSlot)}
      }
      let boolean = run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(b"bool")})
      let condition = run temporary(&mut builder.*, &boolean, origin)
      run assign(&mut builder.*, place(condition), Rvalue.Binary {
        operation: InfixOperator.LessThan,
        left: Operand.Copy {place: place(captured)},
        right: move bound,
      }, origin)
      let safe = run block(&mut builder.*, origin)
      let trap = run block(&mut builder.*, origin)
      terminate(&mut builder.*, Terminator.Branch {
        condition: Operand.Copy {place: place(condition)}, thenBlock: safe, elseBlock: trap, origin: origin,
      })
      resume(&mut builder.*, trap)
      terminate(&mut builder.*, Terminator.Trap {origin: origin})
      resume(&mut builder.*, safe)
      run Vector.append<Projection>(&mut projected.projections, Projection.Index {local: captured})
      return move projected
    }
    View.PatternBinding {node, subject, origin, ..} => {
      let selected = match move scrutineePlace(&builder.*, subject) {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return run unsupported(&owner, origin, GapCode.ExpectedPlace) }
      }
      let evaluated = Vector.asSlice<Scrutinee>(&builder.scrutinees)
      let mut projected = run copyPlace(&evaluated[selected].place)
      let mut at = usize.ZERO
      while true {
        let step = match move bindingStepAt(body, node, at) {
          Option<Projection>.Some {value} => value
          Option<Projection>.None => { break }
        }
        run Vector.append<Projection>(&mut projected.projections, move step)
        at = at + usize.ONE
      }
      return move projected
    }
    View.Dereference {value, origin, ..} => {
      let input = run expression(&mut builder.*, body, hir, value)
      let mut projected = match move input {
        Operand.Copy {place: selectedPlace} => move selectedPlace
        Operand.Move {place: selectedPlace} => move selectedPlace
        _ => run unsupported(&owner, origin, GapCode.ExpectedPlace)
      }
      run Vector.append<Projection>(&mut projected.projections, Projection.Deref)
      return move projected
    }
    _ => {
      let input = run expression(&mut builder.*, body, hir, id)
      return match move input {
        Operand.Copy {place: storage} => move storage
        Operand.Move {place: storage} => move storage
        _ => run unsupported(&owner, nodeOrigin(body, id), GapCode.ExpectedPlace)
      }
    }
  }
}

effect fn callCallee(builder: &mut Builder, foreign: Option<Shared<DeclarationId>>, node: BodyNodeId,
  owner: &Shared<DeclarationId>, origin: Origin) -> Callee
! Gap | OutOfMemoryError
? &mut Allocator {
  if let Option<Shared<DeclarationId>>.Some {value: callee} = move foreign {
    run Vector.append<Shared<DeclarationId>>(&mut builder.*.function.externs, Shared.clone<DeclarationId>(&callee))
    return Callee.Extern {declaration: move callee}
  }
  let selected = resolvedCallTarget(&builder.*, node)
  let call = match move selected {
    Option<ResolvedCall>.Some {value} => move value
    _ => { return run unsupported(owner, origin, GapCode.TypedForm) }
  }
  run Vector.append<Reference>(&mut builder.*.function.references,
    Reference {key: InstanceKey.copy(&call.key), edge: move call.edge, origin: origin})
  return Callee.Instance {key: move call.key}
}

// The decimal spelling of one magnitude, as integer literal operands carry it.
effect fn decimalBytes(magnitude: u64) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut reversed = Vector.make<u8>()
  let mut remaining = magnitude
  while true {
    run Vector.append<u8>(&mut reversed, u64.toU8(48 + u64.remainder(remaining, 10)))
    remaining = u64.divide(remaining, 10)
    if remaining == 0 { break }
  }
  let mut digits = Vector.make<u8>()
  let mut index = Vector.length<u8>(&reversed)
  while index > usize.ZERO {
    index = index - usize.ONE
    run Vector.append<u8>(&mut digits, Vector.get<u8>(&reversed, index))
  }
  return run Bytes.copy(Vector.asSlice<u8>(&digits))
}

// A selected static value used at runtime; only scalar kinds have an operand representation yet.
effect fn embeddedOperand(value: &Shared<StaticData>, ty: Shared<Type>) -> Option<Operand> ! OutOfMemoryError ? &mut Allocator {
  let kind = Shared.with<StaticData, usize>(value, fn(data: &StaticData) -> usize {
    return match & data.* {
      StaticData.Unit => 1
      StaticData.Boolean {..} => 2
      StaticData.Integer {..} => 3
      StaticData.Float {..} => 4
      _ => 0
    }
  })
  if kind == 1 { return Option.some<Operand>(Operand.Unit) }
  if kind == 2 {
    let flag = Shared.with<StaticData, bool>(value, fn(data: &StaticData) -> bool {
      return match & data.* { StaticData.Boolean {value: answer} => answer _ => false }
    })
    return Option.some<Operand>(Operand.Boolean {value: flag})
  }
  if kind == 3 {
    let magnitude = Shared.with<StaticData, u64>(value, fn(data: &StaticData) -> u64 {
      return match & data.* { StaticData.Integer {magnitude: amount, ..} => amount _ => 0 }
    })
    let negative = Shared.with<StaticData, bool>(value, fn(data: &StaticData) -> bool {
      return match & data.* { StaticData.Integer {sign, ..} => sign == StaticSign.Negative _ => false }
    })
    return Option.some<Operand>(Operand.Integer {decimal: run decimalBytes(magnitude), negative: negative, ty: move ty})
  }
  if kind == 4 {
    let bits = Shared.with<StaticData, u64>(value, fn(data: &StaticData) -> u64 {
      return match & data.* { StaticData.Float {bits: raw, ..} => raw _ => 0 }
    })
    return Option.some<Operand>(Operand.Float {bits: bits, ty: move ty})
  }
  return Option.none<Operand>()
}

// Materializes one embedded static value at its use: a scalar as a constant, a scalar enum as its
// representation integer typed by the enum, and a fixed array element by element into a fresh
// aggregate. Anything else is None, an explicit gap.
effect fn materializeEmbedded(builder: &mut Builder, value: &Shared<StaticData>, ty: &Shared<Type>, origin: Origin) -> Option<Operand>
! OutOfMemoryError ? &mut Allocator {
  let scalar = run embeddedOperand(value, Shared.clone<Type>(ty))
  if let Option<Operand>.Some {value: operand} = move scalar { return Option.some<Operand>(move operand) }
  let isEnum = Shared.with<StaticData, bool>(value, fn(data: &StaticData) -> bool {
    return match & data.* { StaticData.Enum {..} => true _ => false }
  })
  if isEnum {
    let magnitude = Shared.with<StaticData, u64>(value, fn(data: &StaticData) -> u64 {
      return match & data.* { StaticData.Enum {magnitude: amount, ..} => amount _ => 0 }
    })
    let negative = Shared.with<StaticData, bool>(value, fn(data: &StaticData) -> bool {
      return match & data.* { StaticData.Enum {sign, ..} => sign == StaticSign.Negative _ => false }
    })
    return Option.some<Operand>(Operand.Integer {decimal: run magnitudeText(magnitude), negative: negative, ty: Shared.clone<Type>(ty)})
  }
  let element = match move Type.arrayShape(ty) {
    Option<ArrayShape>.Some {value: shape} => move shape.element
    Option<ArrayShape>.None => { return Option.none<Operand>() }
  }
  let count = Shared.with<StaticData, usize>(value, fn(data: &StaticData) -> usize {
    return match & data.* { StaticData.Aggregate {fields, ..} => Vector.length<Shared<StaticData>>(&fields) _ => usize.ZERO }
  })
  let mut fields = Vector.make<AggregateField>()
  let mut at = usize.ZERO
  while at < count {
    let child = Shared.with<StaticData, Option<Shared<StaticData>>>(value, fn(data: &StaticData) -> Option<Shared<StaticData>> {
      return StaticValue.field(data, at)
    })
    let found = match move child {
      Option<Shared<StaticData>>.Some {value: selected} => selected
      Option<Shared<StaticData>>.None => { return Option.none<Operand>() }
    }
    let operand = match move run materializeEmbedded(&mut builder.*, &found, &element, origin) {
      Option<Operand>.Some {value: selected} => selected
      Option<Operand>.None => { return Option.none<Operand>() }
    }
    run Vector.append<AggregateField>(&mut fields, AggregateField {index: at, value: move operand})
    at = at + usize.ONE
  }
  let output = run temporary(&mut builder.*, ty, origin)
  run assign(&mut builder.*, place(output), Rvalue.Aggregate {fields: move fields}, origin)
  return Option.some<Operand>(Operand.Move {place: place(output)})
}

effect fn expression(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, id: BodyNodeId) -> Operand
! Gap | OutOfMemoryError
? &mut Allocator {
  let selected = run instanceView(&builder.*, body, id)
  let owner = InstanceKey.identity(&builder.function.key)
  return match move selected {
    View.Integer {ty, literal, origin} => match Module.node(hir, literal) {
      HirNode.IntegerLiteral {sign, magnitude, ..} => Operand.Integer {
        decimal: run Bytes.copy(Module.text(hir, magnitude)),
        negative: sign == Sign.Negative,
        ty: move ty,
      }
      _ => run unsupported(&owner, origin, GapCode.IntegerLiteral)
    }
    View.Float {ty, literal, origin} => {
      if let HirNode.FloatingLiteral {spelling, ..} = Module.node(hir, literal) {
        let narrow = Shared.with<Type, bool>(
          &ty,
          fn(value: &Type) -> bool {
            if let Type.Primitive {name} = &value.* {
              let text = Bytes.asSlice(&name)
              return text.length == 3 && text[usize.ZERO] == 102 && text[usize.ONE] == 51 && text[2] == 50
            }
            return false
          },
        )
        if narrow {
          let parsed = FloatingLiteral.f32Bits(hir, spelling)
          if let Result<u32, ParseError>.Success {value} = move parsed {
            return Operand.Float {bits: f64.toBits(f32.toF64(f32.fromBits(value))), ty: move ty}
          }
        } else {
          let parsed = FloatingLiteral.f64Bits(hir, spelling)
          if let Result<u64, ParseError>.Success {value} = move parsed {
            return Operand.Float {bits: value, ty: move ty}
          }
        }
      }
      return run unsupported(&owner, origin, GapCode.FloatLiteral)
    }
    View.Boolean {value, origin: _} => Operand.Boolean {value: value}
    View.Unit {origin: _} => Operand.Unit
    View.Embedded {value, ty, origin} => {
      let selected = run materializeEmbedded(&mut builder.*, &value, &ty, origin)
      return match move selected {
        Option<Operand>.Some {value: operand} => operand
        Option<Operand>.None => run unsupported(&owner, origin, GapCode.TypedForm)
      }
    }
    View.Local {index, ty, origin} => {
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(
        &mut builder.*,
        place(output),
        Rvalue.Use {value: Operand.Copy {place: place(index + usize.ONE)}},
        origin,
      )
      return Operand.Copy {place: place(output)}
    }
    View.Move {value, ty, origin} => {
      let input = run expression(&mut builder.*, body, hir, value)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Use {value: move input}, origin)
      return Operand.Move {place: place(output)}
    }
    View.ArrayLength {value, count, ty, ..} => {
      let evaluated = run expressionPlace(&mut builder.*, body, hir, value)
      drop evaluated
      return Operand.Integer {decimal: run Type.extentText(count), negative: false, ty: move ty}
    }
    View.ArraySlice {value, count, ty, origin} => {
      let data = run expression(&mut builder.*, body, hir, value)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Slice {data: move data, count: count}, origin)
      return Operand.Copy {place: place(output)}
    }
    View.SliceLength {value, ty, origin} => {
      let descriptor = run expressionPlace(&mut builder.*, body, hir, value)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.SliceLength {place: move descriptor}, origin)
      return Operand.Copy {place: place(output)}
    }
    View.Index {ty, origin, ..} => {
      let projected = run expressionPlace(&mut builder.*, body, hir, id)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Use {value: Operand.Copy {place: move projected}}, origin)
      return Operand.Copy {place: place(output)}
    }
    View.Field {ty, origin, ..} => {
      let projected = run expressionPlace(&mut builder.*, body, hir, id)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(
        &mut builder.*,
        place(output),
        Rvalue.Use {value: Operand.Copy {place: move projected}},
        origin,
      )
      return Operand.Copy {place: place(output)}
    }
    View.Aggregate {node, count, ty, origin} => {
      let mut fields = Vector.make<AggregateField>()
      let mut at = usize.ZERO
      while at < count {
        let child = match move childAt(body, node, at) {
          Option<BodyNodeId>.Some {value} => value
          Option<BodyNodeId>.None => {
            return run unsupported(&owner, origin, GapCode.TypedForm)
          }
        }
        let input = run expression(&mut builder.*, body, hir, child)
        run Vector.append<AggregateField>(&mut fields, AggregateField {
          index: aggregateFieldIndex(body, node, at), value: move input,
        })
        at = at + usize.ONE
      }
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Aggregate {fields: move fields}, origin)
      return Operand.Move {place: place(output)}
    }
    View.Dereference {ty, origin, ..} => {
      let projected = run expressionPlace(&mut builder.*, body, hir, id)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(
        &mut builder.*,
        place(output),
        Rvalue.Use {value: Operand.Copy {place: move projected}},
        origin,
      )
      return Operand.Copy {place: place(output)}
    }
    View.Borrow {access, value, ty, origin} => {
      let borrowed = run expressionPlace(&mut builder.*, body, hir, value)
      let output = run temporary(&mut builder.*, &ty, origin)
      if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&ty) {
        run assign(&mut builder.*, place(output), Rvalue.Use {value: Operand.Copy {place: move borrowed}}, origin)
        return Operand.Copy {place: place(output)}
      }
      run assign(
        &mut builder.*,
        place(output),
        Rvalue.Ref {access: access, place: move borrowed},
        origin,
      )
      return Operand.Copy {place: place(output)}
    }
    View.Prefix {operation, operand, ty, origin} => {
      let input = run expression(&mut builder.*, body, hir, operand)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(
        &mut builder.*,
        place(output),
        Rvalue.Unary {operation: operation, value: move input},
        origin,
      )
      return Operand.Copy {place: place(output)}
    }
    View.Infix {operation, left, right, ty, origin} => {
      if operation == InfixOperator.And || operation == InfixOperator.Or {
        return run shortCircuit(&mut builder.*, body, hir, operation, left, right, &ty, origin)
      }
      let lhs = run expression(&mut builder.*, body, hir, left)
      let rhs = run expression(&mut builder.*, body, hir, right)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(
        &mut builder.*,
        place(output),
        Rvalue.Binary {operation: operation, left: move lhs, right: move rhs},
        origin,
      )
      return Operand.Copy {place: place(output)}
    }
    View.EnumMember {member, ty, origin} => {
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Use {value: run enumOperand(member, &ty)}, origin)
      return Operand.Copy {place: place(output)}
    }
    View.EnumValue {value, ty, origin} => {
      let input = run expression(&mut builder.*, body, hir, value)
      let output = run temporary(&mut builder.*, &ty, origin)
      // A scalar enum has its representation's layout (ENUM-003), so the backing integer keeps its bits.
      run assign(&mut builder.*, place(output), Rvalue.Use {value: move input}, origin)
      return Operand.Copy {place: place(output)}
    }
    View.Match {node, subject, place: placeMatch, tags, count, ty, origin} => {
      return run lowerMatch(&mut builder.*, body, hir, node, subject, placeMatch, tags, count, &ty, origin)
    }
    View.VariantConstruct {node, tag, count, ty, origin} => {
      let mut fields = Vector.make<AggregateField>()
      let mut at = usize.ZERO
      while at < count {
        let child = match move childAt(body, node, at) {
          Option<BodyNodeId>.Some {value} => value
          Option<BodyNodeId>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
        }
        let input = run expression(&mut builder.*, body, hir, child)
        run Vector.append<AggregateField>(&mut fields, AggregateField {index: aggregateFieldIndex(body, node, at), value: move input})
        at = at + usize.ONE
      }
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Variant {tag: tag, fields: move fields}, origin)
      return Operand.Move {place: place(output)}
    }
    View.UnionInject {tag, value, ty, origin} => {
      let input = run expression(&mut builder.*, body, hir, value)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Inject {tag: tag, value: move input}, origin)
      return Operand.Move {place: place(output)}
    }
    View.PatternBinding {ty, origin, ..} => {
      let projected = run expressionPlace(&mut builder.*, body, hir, id)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), Rvalue.Use {value: Operand.Copy {place: move projected}}, origin)
      return Operand.Copy {place: place(output)}
    }
    View.Intrinsic {member, node: callNode, ty, origin} => {
      let operation = run intrinsicRvalue(&mut builder.*, body, hir, callNode, member, &ty, origin)
      let output = run temporary(&mut builder.*, &ty, origin)
      run assign(&mut builder.*, place(output), move operation, origin)
      return Operand.Copy {place: place(output)}
    }
    View.Call {foreign, count, node: callNode, ty, origin} => {
      let mut values = Vector.make<Operand>()
      let mut at = usize.ZERO
      while at < count {
        let child = match move childAt(body, callNode, at) {
          Option<BodyNodeId>.Some {value} => value
          Option<BodyNodeId>.None => {
            return run unsupported(&owner, origin, GapCode.MissingCallArgument)
          }
        }
        let mut argument = run expression(&mut builder.*, body, hir, child)
        if let Option<Shared<DeclarationId>>.None = &foreign {
          let selected = resolvedCallOperand(&builder.*, callNode, at)
          let operand = match move selected {
            Option<CallOperand>.Some {value} => move value
            _ => { return run unsupported(&owner, origin, GapCode.WitnessOperand) }
          }
          if let Option<Access>.Some {value: access} = move operand.borrow {
            // Capture an arbitrary owned rvalue exactly once before lending its storage.
            let captured = run temporary(&mut builder.*, &operand.value, origin)
            run assign(&mut builder.*, place(captured), Rvalue.Use {value: move argument}, origin)
            let reference = run temporary(&mut builder.*, &operand.parameter, origin)
            run assign(&mut builder.*, place(reference), Rvalue.Ref {access: access, place: place(captured)}, origin)
            argument = Operand.Copy {place: place(reference)}
          }
        }
        run Vector.append<Operand>(&mut values, move argument)
        at = at + usize.ONE
      }
      let output = run temporary(&mut builder.*, &ty, origin)
      let continuation = run block(&mut builder.*, origin)
      let target = run callCallee(&mut builder.*, move foreign, callNode, &owner, origin)
      terminate(
        &mut builder.*,
        Terminator.Call {
          callee: move target,
          arguments: move values,
          destination: place(output),
          normal: continuation,
          failure: Option.none<usize>(),
          origin: origin,
        },
      )
      resume(&mut builder.*, continuation)
      return Operand.Copy {place: place(output)}
    }
    View.Unsupported {origin} => run unsupported(&owner, origin, GapCode.TypedForm)
    _ => run unsupported(
      &owner,
      Origin {syntax: HirId {index: id.index}, span: Span.make(usize.ZERO, usize.ZERO)},
      GapCode.ExpectedExpression,
    )
  }
}

// Capture borrowed scalar operands before a later argument can change their referents.
effect fn intrinsicOperand(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  child: BodyNodeId,
  member: IntrinsicMember,
  origin: Origin,
) -> Operand ! Gap | OutOfMemoryError ? &mut Allocator {
  let input = run expression(&mut builder.*, body, hir, child)
  if !CheckedIntrinsic.borrowsOperands(member) { return move input }
  let owner = InstanceKey.identity(&builder.function.key)
  let mut borrowed = match move input {
    Operand.Copy {place: selected} => move selected
    Operand.Move {place: selected} => move selected
    _ => run unsupported(&owner, origin, GapCode.ExpectedPlace)
  }
  run Vector.append<Projection>(&mut borrowed.projections, Projection.Deref)
  let ty = run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(b"i32")})
  let output = run temporary(&mut builder.*, &ty, origin)
  run assign(&mut builder.*, place(output), Rvalue.Use {value: Operand.Copy {place: move borrowed}}, origin)
  return Operand.Copy {place: place(output)}
}

effect fn intrinsicRvalue(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  callNode: BodyNodeId,
  member: IntrinsicMember,
  ty: &Shared<Type>,
  origin: Origin,
) -> Rvalue ! Gap | OutOfMemoryError ? &mut Allocator {
  let owner = InstanceKey.identity(&builder.function.key)
  let first = match move childAt(body, callNode, usize.ZERO) {
    Option<BodyNodeId>.Some {value} => value
    Option<BodyNodeId>.None => run unsupported(&owner, origin, GapCode.MissingCallArgument)
  }
  let left = run intrinsicOperand(&mut builder.*, body, hir, first, member, origin)
  if let Option<InfixOperator>.Some {value: binary} = move CheckedIntrinsic.binary(member) {
    let second = match move childAt(body, callNode, usize.ONE) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => run unsupported(&owner, origin, GapCode.MissingCallArgument)
    }
    let right = run intrinsicOperand(&mut builder.*, body, hir, second, member, origin)
    return Rvalue.Binary {operation: binary, left: move left, right: move right}
  }
  if let Option<PrefixOperator>.Some {value: unary} = move CheckedIntrinsic.unary(member) {
    return Rvalue.Unary {operation: unary, value: move left}
  }
  if CheckedIntrinsic.isBitcast(member) {
    return Rvalue.Bitcast {value: move left, ty: Shared.clone<Type>(ty)}
  }
  return run unsupported(&owner, origin, GapCode.IntrinsicMember)
}

// An owned copy of one checked arm, so lowering never holds a body loan; its nested tests are read
// piecewise by `armTestTag` and `armTestStepAt`.
struct ArmView {
  pattern: BodyPattern
  tests: usize
  guard: Option<BodyNodeId>
  result: BodyNodeId
  origin: Origin
}

fn copyMember(member: &Option<BodyUnionMember>) -> Option<BodyUnionMember> {
  return match &member.* {
    Option<BodyUnionMember>.Some {value} => Option.some<BodyUnionMember>(BodyUnionMember {tag: value.tag, ty: Shared.clone<Type>(&value.ty)})
    Option<BodyUnionMember>.None => Option.none<BodyUnionMember>()
  }
}

fn armView(body: &Shared<TypedBody>, node: BodyNodeId, at: usize) -> Option<ArmView> {
  return Shared.with<TypedBody, Option<ArmView>>(body, fn(value: &TypedBody) -> Option<ArmView> {
    let nodes = TypedBody.nodeSlice(value)
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[node.index].kind {
      let written = Vector.asSlice<BodyMatchArm>(&arms)
      if at < written.length {
        let mut pattern = BodyPattern.Universal
        if let BodyPattern.EnumMember {member} = &written[at].pattern { pattern = BodyPattern.EnumMember {member: member} }
        if let BodyPattern.Record {member} = &written[at].pattern { pattern = BodyPattern.Record {member: copyMember(&member)} }
        if let BodyPattern.Variant {tag} = &written[at].pattern { pattern = BodyPattern.Variant {tag: tag} }
        if let BodyPattern.Integer {magnitude, negative} = &written[at].pattern { pattern = BodyPattern.Integer {magnitude: magnitude, negative: negative} }
        let mut guard = Option.none<BodyNodeId>()
        if let Option<BodyNodeId>.Some {value: tested} = &written[at].guard { guard = Option.some<BodyNodeId>(tested) }
        return Option.some<ArmView>(ArmView {pattern: move pattern, tests: Vector.length<BodyPatternTest>(&written[at].tests),
          guard: move guard, result: written[at].result, origin: written[at].origin})
      }
    }
    return Option.none<ArmView>()
  })
}

// The tag nested test `test` of arm `arm` requires, and how many tags its union has.
struct ArmTestTag {
  tag: usize
  tags: usize
}

fn armTestTag(body: &Shared<TypedBody>, node: BodyNodeId, arm: usize, test: usize) -> Option<ArmTestTag> {
  return Shared.with<TypedBody, Option<ArmTestTag>>(body, fn(value: &TypedBody) -> Option<ArmTestTag> {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &TypedBody.nodeSlice(value)[node.index].kind {
      let tests = Vector.asSlice<BodyPatternTest>(&Vector.asSlice<BodyMatchArm>(&arms)[arm].tests)
      return Option.some<ArmTestTag>(ArmTestTag {tag: tests[test].tag, tags: tests[test].tags})
    }
    return Option.none<ArmTestTag>()
  })
}

fn armTestStepAt(body: &Shared<TypedBody>, node: BodyNodeId, arm: usize, test: usize, at: usize) -> Option<Projection> {
  return Shared.with<TypedBody, Option<Projection>>(body, fn(value: &TypedBody) -> Option<Projection> {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &TypedBody.nodeSlice(value)[node.index].kind {
      let tests = Vector.asSlice<BodyPatternTest>(&Vector.asSlice<BodyMatchArm>(&arms)[arm].tests)
      return stepProjection(&tests[test].path, at)
    }
    return Option.none<Projection>()
  })
}

effect fn magnitudeText(value: u64) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  if value == 0 { return run Bytes.copy(b"0") }
  let mut reversed = Bytes.make()
  let mut remaining = value
  while remaining > 0 {
    let digit = [u64.toU8(48 + u64.remainder(remaining, 10))]
    run Bytes.append(&mut reversed, &digit)
    remaining = remaining / 10
  }
  let digits = Bytes.asSlice(&reversed)
  let mut text = Bytes.make()
  let mut at = digits.length
  while at > usize.ZERO {
    at = at - usize.ONE
    run Bytes.append(&mut text, &[digits[at]])
  }
  return move text
}

effect fn enumOperand(member: BodyEnumMember, ty: &Shared<Type>) -> Operand ! OutOfMemoryError ? &mut Allocator {
  return Operand.Integer {decimal: run magnitudeText(member.magnitude), negative: member.negative, ty: Shared.clone<Type>(ty)}
}

// One dispatch choice: a distinct case value, keyed by member ordinal or tag, or every remaining value.
union Selector {
  Any,
  Case {decimal: Bytes, negative: bool},
}

effect fn selectorOf(pattern: &BodyPattern) -> Selector ! OutOfMemoryError ? &mut Allocator {
  return match &pattern.* {
    BodyPattern.Universal => Selector.Any
    BodyPattern.EnumMember {member} => Selector.Case {decimal: run magnitudeText(member.magnitude), negative: member.negative}
    BodyPattern.Variant {tag} => Selector.Case {decimal: run Type.extentText(tag), negative: false}
    BodyPattern.Record {member} => match &member {
      Option<BodyUnionMember>.Some {value} => Selector.Case {decimal: run Type.extentText(value.tag), negative: false}
      Option<BodyUnionMember>.None => Selector.Any
    }
    BodyPattern.Integer {magnitude, negative} => Selector.Case {decimal: run decimalBytes(magnitude), negative: negative}
  }
}

// Ends the current block with one switch over arms `from..`: each case value goes to the first arm
// that can select it, and every other value to the first arm that selects any value. Coverage was
// proven during checking, so a missing catch-all leaves an unreachable default.
fn sameDecimal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn dispatchArms(builder: &mut Builder, selectors: &[Selector], entries: &[usize], switched: usize,
  from: usize, origin: Origin) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut cases = Vector.make<SwitchCase>()
  let mut otherwise = usize.MAX
  let mut at = from
  while at < selectors.length && otherwise == usize.MAX {
    match &selectors[at] {
      Selector.Any => { otherwise = entries[at] }
      // A value already routed to an earlier arm stays there; a later arm with the same value is
      // reached only after that arm's guard fails.
      Selector.Case {decimal, negative} => {
        let prior = Vector.asSlice<SwitchCase>(&cases)
        let mut repeated = false
        let mut scan = usize.ZERO
        while scan < prior.length {
          if prior[scan].negative == negative && sameDecimal(Bytes.asSlice(&prior[scan].decimal), Bytes.asSlice(&decimal)) { repeated = true }
          scan = scan + usize.ONE
        }
        if !repeated {
          run Vector.append<SwitchCase>(&mut cases, SwitchCase {
            decimal: run Bytes.copy(Bytes.asSlice(&decimal)), negative: negative, target: entries[at],
          })
        }
      }
    }
    at = at + usize.ONE
  }
  if otherwise == usize.MAX { otherwise = run block(&mut builder.*, origin) }
  if Vector.length<SwitchCase>(&cases) == usize.ZERO {
    terminate(&mut builder.*, Terminator.Goto {target: otherwise, origin: origin})
    return ()
  }
  terminate(&mut builder.*, Terminator.Switch {
    value: Operand.Copy {place: place(switched)}, cases: move cases, otherwise: otherwise, origin: origin,
  })
  return ()
}

// The unsigned tag type whose width the structural union's layout stores at offset zero.
effect fn tagType(tags: usize) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  let bytes = Layout.tagBytes(tags)
  if bytes == usize.ONE { return run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(b"u8")}) }
  if bytes == 2 { return run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(b"u16")}) }
  return run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(b"u32")})
}

fn scrutineePlace(builder: &Builder, subject: BodyNodeId) -> Option<usize> {
  let listed = Vector.asSlice<Scrutinee>(&builder.scrutinees)
  let mut at = listed.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if listed[at].subject == subject.index { return Option.some<usize>(at) }
  }
  return Option.none<usize>()
}

// The subject is evaluated once: a place match keeps its projected storage, other matches read one
// copy. Enum values are switched directly; a union switches on its tag. A false guard resumes
// dispatch at the following arm.
effect fn lowerMatch(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  node: BodyNodeId,
  subject: BodyNodeId,
  placeMatch: bool,
  tags: usize,
  count: usize,
  ty: &Shared<Type>,
  origin: Origin,
) -> Operand ! Gap | OutOfMemoryError ? &mut Allocator {
  let owner = InstanceKey.identity(&builder.function.key)
  let subjectType = match move run instanceNodeType(&builder.*, body, subject) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
  }
  let mut scrutinee = place(usize.ZERO)
  if placeMatch {
    scrutinee = run expressionPlace(&mut builder.*, body, hir, subject)
  } else {
    let input = run expression(&mut builder.*, body, hir, subject)
    let copied = run temporary(&mut builder.*, &subjectType, origin)
    run assign(&mut builder.*, place(copied), Rvalue.Use {value: move input}, origin)
    scrutinee = place(copied)
  }
  let mut switched = scrutinee.local
  if tags != usize.ZERO {
    let tag = run tagType(tags)
    switched = run temporary(&mut builder.*, &tag, origin)
    run assign(&mut builder.*, place(switched), Rvalue.Discriminant {place: run copyPlace(&scrutinee)}, origin)
  } else if Vector.length<Projection>(&scrutinee.projections) != usize.ZERO {
    switched = run temporary(&mut builder.*, &subjectType, origin)
    run assign(&mut builder.*, place(switched), Rvalue.Use {value: Operand.Copy {place: run copyPlace(&scrutinee)}}, origin)
  }
  let tested = run copyPlace(&scrutinee)
  run Vector.append<Scrutinee>(&mut builder.*.scrutinees, Scrutinee {subject: subject.index, place: move scrutinee})
  // A `()` or `never` match stores no value; only a valued match owns an output temporary.
  let valued = Shared.with<Type, bool>(ty, storedMatchValue)
  let mut output = usize.MAX
  if valued { output = run temporary(&mut builder.*, ty, origin) }
  let mut arms = Vector.make<ArmView>()
  let mut selectors = Vector.make<Selector>()
  let mut entries = Vector.make<usize>()
  let mut results = Vector.make<usize>()
  let mut at = usize.ZERO
  while at < count {
    let arm = match move armView(body, node, at) {
      Option<ArmView>.Some {value} => value
      Option<ArmView>.None => { return run unsupported(&owner, origin, GapCode.TypedForm) }
    }
    let resultBlock = run block(&mut builder.*, arm.origin)
    let mut entry = resultBlock
    let guarded = match &arm.guard {
      Option<BodyNodeId>.Some {..} => true
      Option<BodyNodeId>.None => false
    }
    if guarded || arm.tests != usize.ZERO { entry = run block(&mut builder.*, arm.origin) }
    run Vector.append<Selector>(&mut selectors, run selectorOf(&arm.pattern))
    run Vector.append<usize>(&mut entries, entry)
    run Vector.append<usize>(&mut results, resultBlock)
    run Vector.append<ArmView>(&mut arms, move arm)
    at = at + usize.ONE
  }
  let join = run block(&mut builder.*, origin)
  let armSlice = Vector.asSlice<ArmView>(&arms)
  let selectorSlice = Vector.asSlice<Selector>(&selectors)
  let entrySlice = Vector.asSlice<usize>(&entries)
  let resultSlice = Vector.asSlice<usize>(&results)
  run dispatchArms(&mut builder.*, selectorSlice, entrySlice, switched, usize.ZERO, origin)
  let mut joined = false
  at = usize.ZERO
  while at < count {
    let armOrigin = armSlice[at].origin
    let result = armSlice[at].result
    let resultBlock = resultSlice[at]
    // Nested tests, then the guard, run in order; the first that fails resumes dispatch at the next arm.
    if entrySlice[at] != resultBlock {
      resume(&mut builder.*, entrySlice[at])
      let fallback = run block(&mut builder.*, armOrigin)
      let mut test = usize.ZERO
      while test < armSlice[at].tests {
        let required = match move armTestTag(body, node, at, test) {
          Option<ArmTestTag>.Some {value} => value
          Option<ArmTestTag>.None => { return run unsupported(&owner, armOrigin, GapCode.TypedForm) }
        }
        let mut projected = run copyPlace(&tested)
        let mut step = usize.ZERO
        while true {
          let selected = match move armTestStepAt(body, node, at, test, step) {
            Option<Projection>.Some {value} => value
            Option<Projection>.None => { break }
          }
          run Vector.append<Projection>(&mut projected.projections, move selected)
          step = step + usize.ONE
        }
        let tagged = run tagType(required.tags)
        let read = run temporary(&mut builder.*, &tagged, armOrigin)
        run assign(&mut builder.*, place(read), Rvalue.Discriminant {place: move projected}, armOrigin)
        let next = run block(&mut builder.*, armOrigin)
        let mut cases = Vector.make<SwitchCase>()
        run Vector.append<SwitchCase>(&mut cases, SwitchCase {decimal: run Type.extentText(required.tag), negative: false, target: next})
        terminate(&mut builder.*, Terminator.Switch {value: Operand.Copy {place: place(read)}, cases: move cases, otherwise: fallback, origin: armOrigin})
        resume(&mut builder.*, next)
        test = test + usize.ONE
      }
      if let Option<BodyNodeId>.Some {value: condition} = &armSlice[at].guard {
        let passed = run expression(&mut builder.*, body, hir, condition)
        terminate(&mut builder.*, Terminator.Branch {condition: move passed, thenBlock: resultBlock, elseBlock: fallback, origin: armOrigin})
      } else {
        terminate(&mut builder.*, Terminator.Goto {target: resultBlock, origin: armOrigin})
      }
      resume(&mut builder.*, fallback)
      run dispatchArms(&mut builder.*, selectorSlice, entrySlice, switched, at + usize.ONE, armOrigin)
    }
    resume(&mut builder.*, resultBlock)
    // A block arm runs as statements; a transfer inside it leaves the arm without reaching the join.
    if blockNode(body, result) {
      run statement(&mut builder.*, body, hir, result)
    } else {
      let value = run expression(&mut builder.*, body, hir, result)
      if valued && builder.live {
        run assign(&mut builder.*, place(output), Rvalue.Use {value: move value}, armOrigin)
      } else {
        drop value
      }
    }
    if builder.live {
      terminate(&mut builder.*, Terminator.Goto {target: join, origin: armOrigin})
      joined = true
    }
    at = at + usize.ONE
  }
  if !joined { return Operand.Unit }
  resume(&mut builder.*, join)
  if !valued { return Operand.Unit }
  return Operand.Copy {place: place(output)}
}

fn storedMatchValue(value: &Type) -> bool {
  return match &value.* {
    Type.Unit => false
    Type.Union {members} => Vector.length<Shared<Type>>(&members) != usize.ZERO
    _ => true
  }
}

fn blockNode(body: &Shared<TypedBody>, id: BodyNodeId) -> bool {
  return Shared.with<TypedBody, bool>(body, fn(value: &TypedBody) -> bool {
    return match &TypedBody.nodeSlice(value)[id.index].kind {
      BodyNodeKind.Block {..} => true
      _ => false
    }
  })
}

effect fn shortCircuit(
  builder: &mut Builder,
  body: &Shared<TypedBody>,
  hir: &Module,
  operation: InfixOperator,
  left: BodyNodeId,
  right: BodyNodeId,
  ty: &Shared<Type>,
  origin: Origin,
) -> Operand ! Gap | OutOfMemoryError ? &mut Allocator {
  let lhs = run expression(&mut builder.*, body, hir, left)
  let rhsBlock = run block(&mut builder.*, origin)
  let shortBlock = run block(&mut builder.*, origin)
  let join = run block(&mut builder.*, origin)
  let output = run temporary(&mut builder.*, ty, origin)
  if operation == InfixOperator.And {
    terminate(
      &mut builder.*,
      Terminator.Branch {
        condition: move lhs,
        thenBlock: rhsBlock,
        elseBlock: shortBlock,
        origin: origin,
      },
    )
  } else {
    terminate(
      &mut builder.*,
      Terminator.Branch {
        condition: move lhs,
        thenBlock: shortBlock,
        elseBlock: rhsBlock,
        origin: origin,
      },
    )
  }
  resume(&mut builder.*, shortBlock)
  run assign(
    &mut builder.*,
    place(output),
    Rvalue.Use {value: Operand.Boolean {value: operation == InfixOperator.Or}},
    origin,
  )
  terminate(&mut builder.*, Terminator.Goto {target: join, origin: origin})
  resume(&mut builder.*, rhsBlock)
  let rhs = run expression(&mut builder.*, body, hir, right)
  run assign(&mut builder.*, place(output), Rvalue.Use {value: move rhs}, origin)
  terminate(&mut builder.*, Terminator.Goto {target: join, origin: origin})
  resume(&mut builder.*, join)
  return Operand.Copy {place: place(output)}
}

effect fn statement(builder: &mut Builder, body: &Shared<TypedBody>, hir: &Module, id: BodyNodeId) -> ()
! Gap | OutOfMemoryError
? &mut Allocator {
  if !builder.live {
    return ()
  }
  let selected = run instanceView(&builder.*, body, id)
  let owner = InstanceKey.identity(&builder.function.key)
  match move selected {
    View.Integer {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.Float {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.Boolean {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.Unit {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.Embedded {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.Local {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.Move {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.Borrow {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.Dereference {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.Field {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.ArrayLength {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.ArraySlice {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.SliceLength {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.Index {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.Aggregate {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.EnumMember {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.EnumValue {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.Match {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.UnionInject {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.PatternBinding {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.VariantConstruct {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.PlaceAssignment {target, value, origin} => {
      let destination = run expressionPlace(&mut builder.*, body, hir, target)
      let assigned = run expression(&mut builder.*, body, hir, value)
      run assign(&mut builder.*, move destination, Rvalue.Use {value: move assigned}, origin)
    }
    View.Prefix {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.Infix {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.Intrinsic {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.Call {..} => {
      let ignored = run expression(&mut builder.*, body, hir, id)
      drop ignored
    }
    View.Binding {index, initializer, origin} => {
      let value = run expression(&mut builder.*, body, hir, initializer)
      run assign(&mut builder.*, place(index + usize.ONE), Rvalue.Use {value: move value}, origin)
    }
    View.Assignment {index, value, origin} => {
      let assigned = run expression(&mut builder.*, body, hir, value)
      run assign(
        &mut builder.*,
        place(index + usize.ONE),
        Rvalue.Use {value: move assigned},
        origin,
      )
    }
    View.Return {value, origin} => {
      if let Option<BodyNodeId>.Some {value: returned} = move value {
        let result = run expression(&mut builder.*, body, hir, returned)
        run assign(&mut builder.*, place(usize.ZERO), Rvalue.Use {value: move result}, origin)
      }
      terminate(&mut builder.*, Terminator.Return {origin: origin})
    }
    View.Branch {condition, thenBranch, elseBranch, origin} => {
      let tested = run expression(&mut builder.*, body, hir, condition)
      let thenBlock = run block(&mut builder.*, origin)
      let elseBlock = run block(&mut builder.*, origin)
      let join = run block(&mut builder.*, origin)
      terminate(
        &mut builder.*,
        Terminator.Branch {
          condition: move tested,
          thenBlock: thenBlock,
          elseBlock: elseBlock,
          origin: origin,
        },
      )
      resume(&mut builder.*, thenBlock)
      run statement(&mut builder.*, body, hir, thenBranch)
      let thenLive = builder.live
      if thenLive {
        terminate(&mut builder.*, Terminator.Goto {target: join, origin: origin})
      }
      resume(&mut builder.*, elseBlock)
      if let Option<BodyNodeId>.Some {value: other} = move elseBranch {
        run statement(&mut builder.*, body, hir, other)
      }
      let elseLive = builder.live
      if elseLive {
        terminate(&mut builder.*, Terminator.Goto {target: join, origin: origin})
      }
      if thenLive || elseLive {
        resume(&mut builder.*, join)
      }
    }
    View.While {condition, body: loopBody, origin} => {
      let header = run block(&mut builder.*, origin)
      let loopBlock = run block(&mut builder.*, origin)
      let exit = run block(&mut builder.*, origin)
      terminate(&mut builder.*, Terminator.Goto {target: header, origin: origin})
      resume(&mut builder.*, header)
      let tested = run expression(&mut builder.*, body, hir, condition)
      terminate(
        &mut builder.*,
        Terminator.Branch {
          condition: move tested,
          thenBlock: loopBlock,
          elseBlock: exit,
          origin: origin,
        },
      )
      run Vector.append<LoopTargets>(&mut builder.*.loops, LoopTargets {exit: exit, repeat: header})
      resume(&mut builder.*, loopBlock)
      run statement(&mut builder.*, body, hir, loopBody)
      if builder.live {
        terminate(&mut builder.*, Terminator.Goto {target: header, origin: origin})
      }
      drop Vector.pop<LoopTargets>(&mut builder.*.loops)
      resume(&mut builder.*, exit)
    }
    View.Break {origin} => {
      let loops = Vector.asSlice<LoopTargets>(&builder.loops)
      if loops.length == usize.ZERO {
        return run unsupported(&owner, origin, GapCode.BreakOutsideLoop)
      }
      let exit = loops[loops.length - usize.ONE].exit
      terminate(&mut builder.*, Terminator.Goto {target: exit, origin: origin})
    }
    View.Continue {origin} => {
      let loops = Vector.asSlice<LoopTargets>(&builder.loops)
      if loops.length == usize.ZERO {
        return run unsupported(&owner, origin, GapCode.ContinueOutsideLoop)
      }
      let repeat = loops[loops.length - usize.ONE].repeat
      terminate(&mut builder.*, Terminator.Goto {target: repeat, origin: origin})
    }
    View.Block {count, node: blockNode, origin} => {
      let mut at = usize.ZERO
      while at < count && builder.live {
        let child = match move childAt(body, blockNode, at) {
          Option<BodyNodeId>.Some {value} => value
          Option<BodyNodeId>.None => {
            return run unsupported(&owner, origin, GapCode.MissingBlockStatement)
          }
        }
        run statement(&mut builder.*, body, hir, child)
        at = at + usize.ONE
      }
    }
    View.Unsupported {origin} => {
      return run unsupported(&owner, origin, GapCode.TypedForm)
    }
  }
  return ()
}

// Traverse the same shallow views as lowering. A completed return/break or both returning
// branches ends its surrounding block, so unreachable checked calls contribute no proof demand.
effect fn collectCallNodes(body: &Shared<TypedBody>, id: BodyNodeId, output: &mut Vector<BodyNodeId>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let selected = view(body, id)
  match move selected {
    View.Call {node, count, ..} => {
      let mut at = usize.ZERO
      while at < count {
        if let Option<BodyNodeId>.Some {value} = move childAt(body, node, at) { drop run collectCallNodes(body, value, &mut output.*) }
        at = at + usize.ONE
      }
      run Vector.append<BodyNodeId>(&mut output.*, node)
    }
    View.Intrinsic {node, ..} => {
      let mut at = usize.ZERO
      while true {
        let child = match move childAt(body, node, at) { Option<BodyNodeId>.Some {value} => value _ => { break } }
        drop run collectCallNodes(body, child, &mut output.*)
        at = at + usize.ONE
      }
    }
    View.Aggregate {node, ..} => {
      let mut at = usize.ZERO
      while true {
        let child = match move childAt(body, node, at) { Option<BodyNodeId>.Some {value} => value _ => { break } }
        drop run collectCallNodes(body, child, &mut output.*)
        at = at + usize.ONE
      }
    }
    View.VariantConstruct {node, ..} => {
      let mut at = usize.ZERO
      while true {
        let child = match move childAt(body, node, at) { Option<BodyNodeId>.Some {value} => value _ => { break } }
        drop run collectCallNodes(body, child, &mut output.*)
        at = at + usize.ONE
      }
    }
    View.Move {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.EnumValue {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.UnionInject {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.Match {node, subject, count, ..} => {
      drop run collectCallNodes(body, subject, &mut output.*)
      let mut at = usize.ZERO
      while at < count {
        if let Option<ArmView>.Some {value: arm} = move armView(body, node, at) {
          if let Option<BodyNodeId>.Some {value: guard} = move arm.guard { drop run collectCallNodes(body, guard, &mut output.*) }
          drop run collectCallNodes(body, arm.result, &mut output.*)
        }
        at = at + usize.ONE
      }
    }
    View.Borrow {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.Dereference {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.Field {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.ArrayLength {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.ArraySlice {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.SliceLength {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.Index {value, index, ..} => {
      drop run collectCallNodes(body, value, &mut output.*)
      drop run collectCallNodes(body, index, &mut output.*)
    }
    View.Prefix {operand, ..} => { drop run collectCallNodes(body, operand, &mut output.*) }
    View.Infix {left, right, ..} => {
      drop run collectCallNodes(body, left, &mut output.*)
      drop run collectCallNodes(body, right, &mut output.*)
    }
    View.Binding {initializer, ..} => { drop run collectCallNodes(body, initializer, &mut output.*) }
    View.Assignment {value, ..} => { drop run collectCallNodes(body, value, &mut output.*) }
    View.PlaceAssignment {target, value, ..} => {
      drop run collectCallNodes(body, target, &mut output.*)
      drop run collectCallNodes(body, value, &mut output.*)
    }
    View.Return {value, ..} => {
      if let Option<BodyNodeId>.Some {value: returned} = move value { drop run collectCallNodes(body, returned, &mut output.*) }
      return false
    }
    View.Break {..} => { return false }
    View.Continue {..} => { return false }
    View.Branch {condition, thenBranch, elseBranch, ..} => {
      drop run collectCallNodes(body, condition, &mut output.*)
      let first = run collectCallNodes(body, thenBranch, &mut output.*)
      let mut second = true
      if let Option<BodyNodeId>.Some {value} = move elseBranch { second = run collectCallNodes(body, value, &mut output.*) }
      return first || second
    }
    View.While {condition, body: loopBody, ..} => {
      drop run collectCallNodes(body, condition, &mut output.*)
      drop run collectCallNodes(body, loopBody, &mut output.*)
    }
    View.Block {node, count, ..} => {
      let mut at = usize.ZERO
      while at < count {
        if let Option<BodyNodeId>.Some {value} = move childAt(body, node, at) {
          if !run collectCallNodes(body, value, &mut output.*) { return false }
        }
        at = at + usize.ONE
      }
    }
    _ => {}
  }
  return true
}

impl MirFunction {
  /// Lists only calls reached by ordinary MIR control-flow lowering, in evaluation order.
  pub effect fn callNodes(body: &Shared<TypedBody>) -> Vector<BodyNodeId> ! OutOfMemoryError ? &mut Allocator {
    let mut output = Vector.make<BodyNodeId>()
    drop run collectCallNodes(body, bodyRoot(body), &mut output)
    return move output
  }
  /// Makes the C entry instance as ordinary MIR that calls the selected Silk main.
  pub effect fn entry(main: &Shared<DeclarationId>, result: &Shared<Type>) -> MirFunction
  ! OutOfMemoryError
  ? &mut Allocator {
    let origin = Origin {syntax: HirId {index: usize.ZERO}, span: Span.make(usize.ZERO, usize.ZERO)}
    let key = InstanceKey.Entry {main: Shared.clone<DeclarationId>(main)}
    let callee = run InstanceKey.named(main)
    let mut locals = Vector.make<Local>()
    run Vector.append<Local>(
      &mut locals,
      Local {ty: Shared.clone<Type>(result), kind: LocalKind.Return, origin: origin},
    )
    let mut blocks = Vector.make<Block>()
    run Vector.append<Block>(
      &mut blocks,
      Block {
        statements: Vector.make<Statement>(),
        terminator: Terminator.Call {
          callee: Callee.Instance {key: InstanceKey.copy(&callee)},
          arguments: Vector.make<Operand>(),
          destination: place(usize.ZERO),
          normal: usize.ONE,
          failure: Option.none<usize>(),
          origin: origin,
        },
      },
    )
    run Vector.append<Block>(
      &mut blocks,
      Block {statements: Vector.make<Statement>(), terminator: Terminator.Return {origin: origin}},
    )
    let mut references = Vector.make<Reference>()
    run Vector.append<Reference>(
      &mut references,
      Reference {key: move callee, edge: Edge.Direct, origin: origin},
    )
    return MirFunction {
      key: move key,
      safetyChecked: true,
      result: Shared.clone<Type>(result),
      parameters: Vector.make<Shared<Type>>(),
      locals: move locals,
      blocks: move blocks,
      references: move references,
      externs: Vector.make<Shared<DeclarationId>>(),
    }
  }
  /// Lowers a closed body while preserving its unfinished safety status, without reading a callee body.
  pub effect fn lower(
    key: InstanceKey,
    body: &Shared<TypedBody>,
    hir: &Module,
    result: &Shared<Type>,
    parameters: &[Shared<Type>],
    calls: Vector<CallTarget>,
  ) -> MirFunction ! Gap | OutOfMemoryError ? &mut Allocator {
    let identity = InstanceKey.identity(&key)
    let application = run InstanceKey.selected(&key)
    let bindings = run Application.bindings(&application)
    let supplied = Vector.asSlice<Binding>(&bindings)
    let mut argumentAt = usize.ZERO
    while argumentAt < supplied.length {
      if let Argument.Row {value: row} = &supplied[argumentAt].value {
        let nonempty = Shared.with<Row, bool>(
          &row,
          fn(value: &Row) -> bool {
            return Vector.length<Requirement>(&value.entries) > usize.ZERO || Vector.length<
              RowParameter,
            >(&value.parameters) > usize.ZERO
          },
        )
        if nonempty {
          fail Gap.make(GapCode.EffectInstance, &identity, bodyOrigin(body).span)
        }
      }
      argumentAt = argumentAt + usize.ONE
    }

    let closedResult = run Type.applyBindings(result, supplied, true)
    let root = bodyRoot(body)
    let origin = bodyOrigin(body)
    // ContractTyped bodies retain explicit safety obligations. Building MIR does not discharge
    // them: unsupported expression forms and layouts still stop emission with a named gap.
    let mut params = Vector.make<Shared<Type>>()
    let mut at = usize.ZERO
    while at < parameters.length {
      run Vector.append<Shared<Type>>(
        &mut params,
        run Type.applyBindings(&parameters[at], supplied, true),
      )
      at = at + usize.ONE
    }
    let mut locals = Vector.make<Local>()
    run Vector.append<Local>(
      &mut locals,
      Local {ty: Shared.clone<Type>(&closedResult), kind: LocalKind.Return, origin: origin},
    )
    at = usize.ZERO
    let count = localCount(body)
    while at < count {
      let local = localView(body, at)
      let mut kind = LocalKind.User {index: at}
      if at < parameters.length {
        kind = LocalKind.Parameter {index: at}
      }
      run Vector.append<Local>(
        &mut locals,
        Local {
          ty: run Type.applyBindings(&local.ty, supplied, true),
          kind: move kind,
          origin: local.origin,
        },
      )
      at = at + usize.ONE
    }
    let mut builder = Builder {
      bindings: move bindings,
      calls: move calls,
      function: MirFunction {
        key: move key,
        safetyChecked: bodySafetyChecked(body),
        result: move closedResult,
        parameters: move params,
        locals: move locals,
        blocks: Vector.make<Block>(),
        references: Vector.make<Reference>(),
        externs: Vector.make<Shared<DeclarationId>>(),
      },
      current: usize.ZERO,
      live: true,
      loops: Vector.make<LoopTargets>(),
      scrutinees: Vector.make<Scrutinee>(),
    }
    let first = run block(&mut builder, origin)
    resume(&mut builder, first)
    run statement(&mut builder, body, hir, root)
    if builder.live {
      // Unit may fall through. A non-unit missing return was rejected by body typing.
      terminate(&mut builder, Terminator.Return {origin: origin})
    }
    run sortReferences(&mut builder.function.references)
    return move builder.function
  }
}

effect fn instanceNodeType(builder: &Builder, body: &Shared<TypedBody>, id: BodyNodeId) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  return match move nodeType(body, id) {
    Option<Shared<Type>>.Some {value: ty} => Option.some<Shared<Type>>(
      run Type.applyBindings(&ty, Vector.asSlice<Binding>(&builder.bindings), true),
    )
    Option<Shared<Type>>.None => Option.none<Shared<Type>>()
  }
}

effect fn instanceView(builder: &Builder, body: &Shared<TypedBody>, id: BodyNodeId) -> View
! OutOfMemoryError
? &mut Allocator {
  let selected = view(body, id)
  let bindings = Vector.asSlice<Binding>(&builder.bindings)
  return match move selected {
    View.Integer {ty, literal, origin} => View.Integer {
      ty: run Type.applyBindings(&ty, bindings, true),
      literal: literal,
      origin: origin,
    }
    View.Float {ty, literal, origin} => View.Float {
      ty: run Type.applyBindings(&ty, bindings, true),
      literal: literal,
      origin: origin,
    }
    View.Local {ty, index, origin} => View.Local {
      ty: run Type.applyBindings(&ty, bindings, true),
      index: index,
      origin: origin,
    }
    View.Move {ty, value, origin} => View.Move {
      ty: run Type.applyBindings(&ty, bindings, true),
      value: value,
      origin: origin,
    }
    View.Borrow {ty, access, value, origin} => View.Borrow {
      ty: run Type.applyBindings(&ty, bindings, true),
      access: access,
      value: value,
      origin: origin,
    }
    View.Dereference {ty, value, origin} => View.Dereference {
      ty: run Type.applyBindings(&ty, bindings, true),
      value: value,
      origin: origin,
    }
    View.Field {ty, value, index, origin} => View.Field {
      ty: run Type.applyBindings(&ty, bindings, true),
      value: value,
      index: index,
      origin: origin,
    }
    View.Index {ty, value, index, origin} => View.Index {
      ty: run Type.applyBindings(&ty, bindings, true),
      value: value,
      index: index,
      origin: origin,
    }
    View.ArrayLength {ty, value, count, origin} => View.ArrayLength {
      ty: run Type.applyBindings(&ty, bindings, true),
      value: value,
      count: count,
      origin: origin,
    }
    View.ArraySlice {ty, value, count, origin} => View.ArraySlice {
      ty: run Type.applyBindings(&ty, bindings, true), value: value, count: count, origin: origin,
    }
    View.SliceLength {ty, value, origin} => View.SliceLength {
      ty: run Type.applyBindings(&ty, bindings, true), value: value, origin: origin,
    }
    View.Aggregate {ty, node, count, origin} => View.Aggregate {
      ty: run Type.applyBindings(&ty, bindings, true),
      node: node,
      count: count,
      origin: origin,
    }
    View.EnumMember {ty, member, origin} => View.EnumMember {
      ty: run Type.applyBindings(&ty, bindings, true), member: member, origin: origin,
    }
    View.EnumValue {ty, value, origin} => View.EnumValue {
      ty: run Type.applyBindings(&ty, bindings, true), value: value, origin: origin,
    }
    View.Match {ty, node, subject, place: placeMatch, tags, count, origin} => View.Match {
      ty: run Type.applyBindings(&ty, bindings, true), node: node, subject: subject, place: placeMatch, tags: tags, count: count, origin: origin,
    }
    View.VariantConstruct {ty, node, tag, count, origin} => View.VariantConstruct {
      ty: run Type.applyBindings(&ty, bindings, true), node: node, tag: tag, count: count, origin: origin,
    }
    View.UnionInject {ty, tag, value, origin} => View.UnionInject {
      ty: run Type.applyBindings(&ty, bindings, true), tag: tag, value: value, origin: origin,
    }
    View.PatternBinding {ty, node, subject, origin} => View.PatternBinding {
      ty: run Type.applyBindings(&ty, bindings, true), node: node, subject: subject, origin: origin,
    }
    View.Prefix {ty, operation, operand, origin} => View.Prefix {
      ty: run Type.applyBindings(&ty, bindings, true),
      operation: operation,
      operand: operand,
      origin: origin,
    }
    View.Infix {ty, operation, left, right, origin} => View.Infix {
      ty: run Type.applyBindings(&ty, bindings, true),
      operation: operation,
      left: left,
      right: right,
      origin: origin,
    }
    View.Call {ty, foreign, count, node, origin} => View.Call {
      ty: run Type.applyBindings(&ty, bindings, true),
      foreign: move foreign,
      count: count,
      node: node,
      origin: origin,
    }
    View.Intrinsic {ty, member, node, origin} => View.Intrinsic {
      ty: run Type.applyBindings(&ty, bindings, true),
      member: member,
      node: node,
      origin: origin,
    }
    View.Boolean {value, origin} => View.Boolean {value: value, origin: origin}
    View.Unit {origin} => View.Unit {origin: origin}
    View.Embedded {value, ty, origin} => View.Embedded {
      value: value, ty: run Type.applyBindings(&ty, bindings, true), origin: origin,
    }
    View.PlaceAssignment {target, value, origin} => View.PlaceAssignment {
      target: target,
      value: value,
      origin: origin,
    }
    View.Binding {index, initializer, origin} => View.Binding {
      index: index,
      initializer: initializer,
      origin: origin,
    }
    View.Assignment {index, value, origin} => View.Assignment {
      index: index,
      value: value,
      origin: origin,
    }
    View.Return {value, origin} => View.Return {value: move value, origin: origin}
    View.Branch {condition, thenBranch, elseBranch, origin} => View.Branch {
      condition: condition,
      thenBranch: thenBranch,
      elseBranch: move elseBranch,
      origin: origin,
    }
    View.While {condition, body: loopBody, origin} => View.While {
      condition: condition,
      body: loopBody,
      origin: origin,
    }
    View.Break {origin} => View.Break {origin: origin}
    View.Continue {origin} => View.Continue {origin: origin}
    View.Block {count, node, origin} => View.Block {count: count, node: node, origin: origin}
    View.Unsupported {origin} => View.Unsupported {origin: origin}
  }
}

fn resolvedCallTarget(builder: &Builder, node: BodyNodeId) -> Option<ResolvedCall> {
  let calls = Vector.asSlice<CallTarget>(&builder.calls)
  let mut at = usize.ZERO
  while at < calls.length {
    if calls[at].node.index == node.index {
      return Option.some<ResolvedCall>(ResolvedCall {key: InstanceKey.copy(&calls[at].key), edge: Edge.copy(&calls[at].edge)})
    }
    at = at + usize.ONE
  }
  return Option.none<ResolvedCall>()
}

fn resolvedCallOperand(builder: &Builder, node: BodyNodeId, index: usize) -> Option<CallOperand> {
  let calls = Vector.asSlice<CallTarget>(&builder.calls)
  let mut at = usize.ZERO
  while at < calls.length {
    if calls[at].node.index == node.index {
      let operands = Vector.asSlice<CallOperand>(&calls[at].operands)
      if index < operands.length {
        let borrow = match &operands[index].borrow {
          Option<Access>.Some {value} => Option.some<Access>(value)
          Option<Access>.None => Option.none<Access>()
        }
        return Option.some<CallOperand>(CallOperand {value: Shared.clone<Type>(&operands[index].value),
          parameter: Shared.clone<Type>(&operands[index].parameter), borrow: move borrow})
      }
    }
    at = at + usize.ONE
  }
  return Option.none<CallOperand>()
}

effect fn sortReferences(references: &mut Vector<Reference>) -> ()
! OutOfMemoryError
? &mut Allocator {
  let listed = Vector.asSlice<Reference>(&references.*)
  let mut symbols = Vector.make<Bytes>()
  let mut at = usize.ZERO
  while at < listed.length {
    run Vector.append<Bytes>(&mut symbols, run InstanceKey.symbol(&listed[at].key))
    at = at + usize.ONE
  }
  let mut order = Vector.make<usize>()
  at = usize.ZERO
  while at < listed.length {
    run Vector.append<usize>(&mut order, at)
    at = at + usize.ONE
  }
  let sorted = Vector.asMutSlice<usize>(&mut order)
  let names = Vector.asSlice<Bytes>(&symbols)
  at = usize.ONE
  while at < sorted.length {
    let mut next = at
    while next > usize.ZERO && RuntimeEncoding.less(
      Bytes.asSlice(&names[sorted[next]]),
      Bytes.asSlice(&names[sorted[next - usize.ONE]]),
    ) {
      let prior = sorted[next - usize.ONE]
      sorted[next - usize.ONE] = sorted[next]
      sorted[next] = prior
      next = next - usize.ONE
    }
    at = at + usize.ONE
  }
  let mut output = Vector.make<Reference>()
  at = usize.ZERO
  while at < sorted.length {
    let current = &listed[sorted[at]]
    run Vector.append<Reference>(
      &mut output,
      Reference {
        key: InstanceKey.copy(&current.key),
        edge: Edge.copy(&current.edge),
        origin: current.origin,
      },
    )
    at = at + usize.ONE
  }
  references.* = move output
  return ()
}

fn absurd<T>() -> T {
  let boom = 1 / 0
  return absurd<T>()
}
