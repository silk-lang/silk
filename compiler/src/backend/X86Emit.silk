//! Linux x86-64 machine-code emitter translating one finished [`SsaFunction`] into an
//! [`X86Object.Function`] (System V AMD64 ABI).
//!
//! # When to use
//! Call [`X86Emit.emit`] on each lowered, prepared [`SsaFunction`] produced by `SsaLower` for
//! `x86_64-unknown-linux-gnu`.
//!
//! # Details
//! - Uses `X86Frame.plan` for `StackLifetimes`-colored MIR stack slots and live-interval-colored
//!   SSA value home slots, keeping `rbp` as the frame pointer and maintaining 16-byte `rsp`
//!   alignment at every `call`.
//! - Covers all target-neutral `SsaFunction` operations: `i1`..`i128` integers, IEEE 754 `f32`/
//!   `f64`, saturating float-to-int conversions, 128-bit div/rem via built-in `__silk_*ti3`
//!   helpers, `memmove`/`rep stosb` bulk memory, Initial-Exec TLS (`R_X86_64_GOTTPOFF` + `fs:[0]`),
//!   TSO/LOCK atomics, SysV AMD64 C ABI calls & 2-register coerced struct returns, `sret`/`byval`,
//!   variadic C calls and exports (`VaStart`/`VaEnd`), validated native inline assembly via
//!   `X86Asm`, SIMD vectors of arbitrary lane width, and all 19 x86-64 `ArchOperation` intrinsics.

import backend.SsaFunction {
  AbiExtension,
  ArchOperation,
  Binary,
  CallAbi,
  CallingConvention,
  Cast,
  Constant,
  ConstantForm,
  Count,
  Definition,
  Edge,
  Exit,
  Extreme,
  InlineAsm,
  Instruction,
  Kind,
  Modify,
  Operation,
  ParameterAbi,
  Predicate,
  Reduction,
  SsaFunction,
  none,
}
import backend.SsaPipeline {Level}
import backend.X86Asm
import backend.X86Asm {AsmCallReloc, Constraint, ConstraintKind, OperandBinding, UnsupportedAsm}
import backend.X86Encode
import backend.X86Encode {Alu, Mem, Shift}
import backend.X86Frame
import backend.X86Frame {FramePlan}
import backend.X86Object
import backend.X86Object {Function, Relocation, RelocationKind, RodataJumpEntry, Unsupported}
import backend.X86Unwind {UnwindInfo}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.core.effect {Effect}
import silk.core.ownership {Copy}
import silk.core.result {Result}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize

struct LocalBranch {
  opcodeAt: usize,
  isJcc: bool,
  cc: u8,
  targetBlock: usize,
  targetOffset: usize,
  shortened: bool,
}

impl Copy for LocalBranch {}

struct Imm32 {
  ok: bool,
  value: i32,
}

impl Copy for Imm32 {}

struct JumpEntryRef {
  rodataOffset: usize,
  tableOffset: usize,
  targetBlock: usize,
}

impl Copy for JumpEntryRef {}

struct Emitter {
  code: Bytes,
  relocations: List<Relocation>,
  symbols: List<Bytes>,
  symTable: List<usize>,
  rodata: Bytes,
  rodataJumps: List<RodataJumpEntry>,
  jumpRefs: List<JumpEntryRef>,
  locations: List<u64>,
  blockOffsets: List<usize>,
  localBranches: List<LocalBranch>,
  frame: FramePlan,
  knownBool: List<u8>,
  retTargetVal: u64,
  fixedGpCount: usize,
  fixedFpCount: usize,
  fixedStackBytes: u64,
  unwind: UnwindInfo,
  symbol: Bytes,
}

/// Emits x86-64 Linux ELF64 machine code for `function` under `symbol` (and optional `exported`
/// C alias) at optimization `level` (`SsaPipeline.Level`), without a `silk_seen` entry store.
pub effect fn emit(function: &SsaFunction, symbol: &[u8], exported: &[u8], level: Level) -> Function
! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run emitWithSeen(function, symbol, exported, b"", level)
}

/// Emits x86-64 Linux ELF64 machine code for `function` under `symbol` (and optional `exported`
/// C alias) at optimization `level` (`SsaPipeline.Level`), emitting an entry store that marks
/// `seenSymbol` in `silk_seen` when `seenSymbol` is non-empty and `function` is not naked.
pub effect fn emitWithSeen(function: &SsaFunction, symbol: &[u8], exported: &[u8], seenSymbol: &[u8], level: Level) -> Function
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let frame = run X86Frame.plan(function, level)
  let blockCount = function.blockCount()
  let mut blockOffsets = run List<usize>.makeWithCapacity(blockCount)
  let mut b = usize.ZERO
  while b < blockCount {
    run List<usize>.append(&mut blockOffsets, usize.ZERO)
    b = b + usize.ONE
  }
  let knownBool = run computeKnownBool(function, List<usize>.asSlice(&frame.blockOrder))
  let mut em = Emitter {
    code: Bytes.make(),
    relocations: List<Relocation>.make(),
    symbols: List<Bytes>.make(),
    symTable: List<usize>.make(),
    rodata: Bytes.make(),
    rodataJumps: List<RodataJumpEntry>.make(),
    jumpRefs: List<JumpEntryRef>.make(),
    locations: List<u64>.make(),
    blockOffsets: move blockOffsets,
    localBranches: List<LocalBranch>.make(),
    frame: move frame,
    knownBool: move knownBool,
    retTargetVal: none(),
    fixedGpCount: usize.ZERO,
    fixedFpCount: usize.ZERO,
    fixedStackBytes: 0,
    unwind: UnwindInfo.frameOnly(),
    symbol: run Bytes.copy(symbol),
  }

  let naked = isNakedFunction(function)
  if naked {
    em.unwind = UnwindInfo.naked()
  } else {
    run emitPrologue(&mut em, function)
    run emitIncomingParams(&mut em, function)
    if seenSymbol.length > usize.ZERO {
      let dispAt = run X86Encode.movMi8(&mut em.code, Mem.ripRel(0), 1)
      let symIdx = run internSymbol(&mut em, seenSymbol)
      run List<Relocation>.append(&mut em.relocations, Relocation {
        offset: dispAt,
        kind: RelocationKind.Pc32,
        target: symIdx,
        addend: -5,
      })
    }
  }

  let orderLen = List<usize>.length(&em.frame.blockOrder)
  let mut ordIdx = usize.ZERO
  while ordIdx < orderLen {
    b = List<usize>.asSlice(&em.frame.blockOrder)[ordIdx]
    let nextBlk = if ordIdx + usize.ONE < orderLen {
      List<usize>.asSlice(&em.frame.blockOrder)[ordIdx + usize.ONE]
    } else {
      usize.MAX
    }
    let off = Bytes.length(&em.code)
    let bOffMut = List<usize>.asMutSlice(&mut em.blockOffsets)
    bOffMut[b] = off
    let blk = function.block(b)
    if blk.startPlace != 0 {
      run recordLocation(&mut em, blk.startPlace)
    }
    let fusedCmp = findFusedBranchInst(&em, function, b)
    let fusedRet = findFusedReturnInst(&em, function, b, naked)
    let insts = List<usize>.asSlice(&blk.instructions)
    let mut i = usize.ZERO
    while i < insts.length {
      let instIdx = insts[i]
      let inst = function.instruction(instIdx)
      if !inst.removed && instIdx != fusedCmp {
        if inst.place != 0 {
          run recordLocation(&mut em, inst.place)
        }
        if instIdx == fusedRet {
          em.retTargetVal = blk.value
        }
        run emitInstruction(&mut em, function, instIdx)
        if instIdx == fusedRet {
          em.retTargetVal = none()
        }
      }
      i = i + usize.ONE
    }
    if blk.place != 0 {
      run recordLocation(&mut em, blk.place)
    }
    run emitExit(&mut em, function, b, nextBlk, naked, fusedCmp, fusedRet != usize.MAX)
    ordIdx = ordIdx + usize.ONE
  }

  // Relax short local branches from rel32 to 2-byte rel8 and patch all branch displacements.
  run relaxBranches(&mut em)

  // Record jump-table entries using post-relaxation block offsets.
  let bOffs = List<usize>.asSlice(&em.blockOffsets)
  let jRefs = List<JumpEntryRef>.asSlice(&em.jumpRefs)
  let mut p = usize.ZERO
  while p < jRefs.length {
    run List<RodataJumpEntry>.append(&mut em.rodataJumps, RodataJumpEntry {
      rodataOffset: jRefs[p].rodataOffset,
      tableOffset: jRefs[p].tableOffset,
      targetCodeOffset: bOffs[jRefs[p].targetBlock],
    })
    p = p + usize.ONE
  }

  return Function {
    symbol: move em.symbol,
    exported: run Bytes.copy(exported),
    code: move em.code,
    relocations: move em.relocations,
    symbols: move em.symbols,
    rodata: move em.rodata,
    rodataJumps: move em.rodataJumps,
    unwind: em.unwind,
    locations: move em.locations,
  }
}

// Computes a sound `knownBool[v]` table (`1` iff scalar `i1` whose 64-bit representation is
// guaranteed `{0, 1}` with upper 63 bits zero; `0` conservatively for ABI inputs/calls/bitcasts).
effect fn computeKnownBool(function: &SsaFunction, blockOrder: &[usize]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let valueCount = function.valueCount()
  let mut known = run List<u8>.makeWithCapacity(valueCount)
  let mut paramAll = run List<u8>.makeWithCapacity(valueCount)
  let mut paramPreds = run List<usize>.makeWithCapacity(valueCount)
  let mut v = usize.ZERO
  while v < valueCount {
    let val = usize.toU64(v)
    let info = function.value(val)
    let mut isKb: u8 = 0
    if !info.kind.isVector() && info.kind.isInteger() && info.kind.bits == usize.ONE {
      if info.definition == Definition.Constant {
        if function.isBits(val) { isKb = 1 }
      } else if info.definition == Definition.Result {
        let prod = function.producerOf(val)
        if prod != usize.MAX {
          let inst = function.instruction(prod)
          if !inst.removed {
            match inst.operation {
              Operation.Compare {..} => { isKb = 1 }
              Operation.Overflow {..} => {
                if inst.result != none() && inst.result + 1 == val { isKb = 1 }
              }
              Operation.CompareExchange => {
                if inst.result != none() && inst.result + 1 == val { isKb = 1 }
              }
              Operation.Load {..} => { isKb = 1 }
              Operation.Cast {operation} => {
                if operation == Cast.Trunc { isKb = 1 }
              }
              Operation.Binary {operation} => {
                if operation == Binary.Add || operation == Binary.Sub || operation == Binary.And || operation == Binary.Or || operation == Binary.Xor {
                  isKb = 1
                }
              }
              _ => {}
            }
          }
        }
      }
    }
    run List<u8>.append(&mut known, isKb)
    run List<u8>.append(&mut paramAll, 1)
    run List<usize>.append(&mut paramPreds, usize.ZERO)
    v = v + usize.ONE
  }
  let kbMut = List<u8>.asMutSlice(&mut known)
  let pAllMut = List<u8>.asMutSlice(&mut paramAll)
  let pPredMut = List<usize>.asMutSlice(&mut paramPreds)
  let blockCount = function.blockCount()
  let mut pass = usize.ZERO
  while pass < 2 {
    let mut b = usize.ZERO
    while b < blockCount {
      let params = List<u64>.asSlice(&function.block(b).parameters)
      let mut p = usize.ZERO
      while p < params.length {
        let pIdx = u64.toUsize(params[p])
        if pIdx < valueCount {
          pAllMut[pIdx] = 1
          pPredMut[pIdx] = usize.ZERO
        }
        p = p + usize.ONE
      }
      b = b + usize.ONE
    }
    b = usize.ZERO
    while b < blockCount {
      let edges = List<Edge>.asSlice(&function.block(b).edges)
      let mut e = usize.ZERO
      while e < edges.length {
        let tgt = edges[e].block
        if tgt < blockCount {
          let tParams = List<u64>.asSlice(&function.block(tgt).parameters)
          let eArgs = List<u64>.asSlice(&edges[e].arguments)
          let mut a = usize.ZERO
          while a < eArgs.length && a < tParams.length {
            let pIdx = u64.toUsize(tParams[a])
            if pIdx < valueCount {
              pPredMut[pIdx] = pPredMut[pIdx] + usize.ONE
              let arg = eArgs[a]
              let ok = arg != none() && u64.toUsize(arg) < valueCount && kbMut[u64.toUsize(arg)] != 0
              if !ok { pAllMut[pIdx] = 0 }
            }
            a = a + usize.ONE
          }
        }
        e = e + usize.ONE
      }
      b = b + usize.ONE
    }
    let mut ord = usize.ZERO
    while ord < blockOrder.length {
      let blk = function.block(blockOrder[ord])
      let params = List<u64>.asSlice(&blk.parameters)
      let mut p = usize.ZERO
      while p < params.length {
        let pVal = params[p]
        let pIdx = u64.toUsize(pVal)
        if pIdx < valueCount && kbMut[pIdx] == 0 && pPredMut[pIdx] > usize.ZERO && pAllMut[pIdx] != 0 {
          let pk = function.value(pVal).kind
          if !pk.isVector() && pk.isInteger() && pk.bits == usize.ONE {
            kbMut[pIdx] = 1
          }
        }
        p = p + usize.ONE
      }
      let insts = List<usize>.asSlice(&blk.instructions)
      let mut i = usize.ZERO
      while i < insts.length {
        let inst = function.instruction(insts[i])
        if !inst.removed && inst.result != none() && !inst.kind.isVector() && inst.kind.isInteger() && inst.kind.bits == usize.ONE {
          if let Operation.Select = inst.operation {
            let ops = function.operandsOf(insts[i])
            if ops.length >= 3 && ops[1] != none() && ops[2] != none() {
              let yi = u64.toUsize(ops[1])
              let ni = u64.toUsize(ops[2])
              let ri = u64.toUsize(inst.result)
              if ri < valueCount && yi < valueCount && ni < valueCount && kbMut[yi] != 0 && kbMut[ni] != 0 {
                kbMut[ri] = 1
              }
            }
          }
        }
        i = i + usize.ONE
      }
      ord = ord + usize.ONE
    }
    pass = pass + usize.ONE
  }
  return move known
}

fn findFusedBranchInst(em: &Emitter, function: &SsaFunction, blockIdx: usize) -> usize {
  let blk = function.block(blockIdx)
  if blk.exit != Exit.Branch || blk.value == none() { return usize.MAX }
  let uses = List<usize>.asSlice(&em.frame.valueUses)
  let condIdx = u64.toUsize(blk.value)
  if condIdx >= uses.length || uses[condIdx] != usize.ONE { return usize.MAX }
  let insts = List<usize>.asSlice(&blk.instructions)
  let mut k = insts.length
  while k > usize.ZERO {
    k = k - usize.ONE
    let instIdx = insts[k]
    let inst = function.instruction(instIdx)
    if !inst.removed {
      if let Operation.SlotStart {..} = inst.operation { continue }
      if let Operation.SlotEnd {..} = inst.operation { continue }
      if inst.result == blk.value {
        if let Operation.Compare {..} = inst.operation {
          let ops = function.operandsOf(instIdx)
          if ops.length >= 2 {
            let opKind = function.value(ops[0]).kind
            if !opKind.isVector() && !opKind.isFloat() && opKind.bits <= 64 {
              return instIdx
            }
          }
        } else if let Operation.Reduce {which} = inst.operation {
          let ops = function.operandsOf(instIdx)
          if ops.length == usize.ONE && (which == Reduction.Or || which == Reduction.And) && isXmmMask16(em, ops[0]) {
            return instIdx
          }
        }
      } else if inst.result != none() && inst.result + 1 == blk.value {
        if let Operation.Overflow {..} = inst.operation {
          let ops = function.operandsOf(instIdx)
          if ops.length >= 2 && !inst.kind.isVector() && (inst.kind.bits == 8 || inst.kind.bits == 16 || inst.kind.bits == 32 || inst.kind.bits == 64) {
            return instIdx
          }
        }
      }
      return usize.MAX
    }
  }
  return usize.MAX
}

fn findFusedReturnInst(em: &Emitter, function: &SsaFunction, blockIdx: usize, naked: bool) -> usize {
  if naked { return usize.MAX }
  let blk = function.block(blockIdx)
  if blk.exit != Exit.Return || blk.value == none() || blk.secondValue != none() { return usize.MAX }
  if function.result.isUnit() || function.result.isVector() || function.result.isFloat() || function.result.bits > 64 {
    return usize.MAX
  }
  let uses = List<usize>.asSlice(&em.frame.valueUses)
  let vIdx = u64.toUsize(blk.value)
  if vIdx >= uses.length || uses[vIdx] != usize.ONE { return usize.MAX }
  if valSlotBase(em, blk.value) != 0 || foldedAddrKind(em, blk.value) != 0 || fusedLoadBytes(em, blk.value) != 0 || isFusedCallStore(em, blk.value) {
    return usize.MAX
  }
  let insts = List<usize>.asSlice(&blk.instructions)
  let mut k = insts.length
  while k > usize.ZERO {
    k = k - usize.ONE
    let instIdx = insts[k]
    let inst = function.instruction(instIdx)
    if !inst.removed {
      if inst.result != blk.value || inst.resultCount() != usize.ONE { return usize.MAX }
      if inst.kind.isUnit() || inst.kind.isVector() || inst.kind.isFloat() || inst.kind.bits > 64 {
        return usize.MAX
      }
      return match inst.operation {
        Operation.Load {..} => instIdx
        Operation.Binary {..} => instIdx
        Operation.Compare {..} => instIdx
        Operation.Cast {operation} => {
          let okCast = operation == Cast.Trunc || operation == Cast.ZExt || operation == Cast.SExt || operation == Cast.IntToPtr || operation == Cast.PtrToInt
          let ops = function.operandsOf(instIdx)
          if okCast && ops.length >= usize.ONE && !function.value(ops[0]).kind.isVector() { instIdx } else { usize.MAX }
        }
        Operation.Call {..} => instIdx
        Operation.CallIndirect {..} => instIdx
        _ => usize.MAX
      }
    }
  }
  return usize.MAX
}

fn isNakedFunction(function: &SsaFunction) -> bool {
  if List<u64>.length(&function.arguments) != usize.ZERO || function.slotCount() != usize.ZERO || function.blockCount() != usize.ONE {
    return false
  }
  let blk = function.block(usize.ZERO)
  if blk.exit != Exit.Unreachable { return false }
  let insts = List<usize>.asSlice(&blk.instructions)
  let mut liveCount = usize.ZERO
  let mut hasNoReturnAsm = false
  let mut i = usize.ZERO
  while i < insts.length {
    let inst = function.instruction(insts[i])
    if !inst.removed {
      liveCount = liveCount + usize.ONE
      if let Operation.InlineAsm {noReturn, ..} = inst.operation {
        if noReturn && inst.operandCount == usize.ZERO && inst.kind.isUnit() {
          hasNoReturnAsm = true
        }
      }
    }
    i = i + usize.ONE
  }
  return liveCount == usize.ONE && hasNoReturnAsm
}

effect fn recordLocation(em: &mut Emitter, place: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let off = usize.toU64(Bytes.length(&em.code))
  run List<u64>.append(&mut em.locations, off)
  return run List<u64>.append(&mut em.locations, place)
}

fn hashSymbolName(name: &[u8]) -> u64 {
  let mut h: u64 = 14695981039346656037
  let mut i = usize.ZERO
  while i < name.length {
    h = u64.bitXor(h, u8.toU64(name[i]))
    h = u64.wrappingMultiply(h, 1099511628211)
    i = i + usize.ONE
  }
  return h
}

effect fn rehashSymTable(em: &mut Emitter, newCap: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut table = run List<usize>.makeWithCapacity(newCap)
  let mut i = usize.ZERO
  while i < newCap {
    run List<usize>.append(&mut table, usize.MAX)
    i = i + usize.ONE
  }
  let mask = newCap - usize.ONE
  let tMut = List<usize>.asMutSlice(&mut table)
  let syms = List<Bytes>.asSlice(&em.symbols)
  i = usize.ZERO
  while i < syms.length {
    let mut slot = u64.toUsize(hashSymbolName(Bytes.asSlice(&syms[i]))) & mask
    while tMut[slot] != usize.MAX {
      slot = (slot + usize.ONE) & mask
    }
    tMut[slot] = i
    i = i + usize.ONE
  }
  em.symTable = move table
}

effect fn internSymbol(em: &mut Emitter, name: &[u8]) -> usize ! OutOfMemoryError ? &mut Allocator {
  let symLen = List<Bytes>.length(&em.symbols)
  let cap = List<usize>.length(&em.symTable)
  if cap == usize.ZERO && symLen < 16 {
    let syms = List<Bytes>.asSlice(&em.symbols)
    let mut at = usize.ZERO
    while at < syms.length {
      if same(Bytes.asSlice(&syms[at]), name) { return at }
      at = at + usize.ONE
    }
    run List<Bytes>.append(&mut em.symbols, run Bytes.copy(name))
    return symLen
  }
  if cap == usize.ZERO {
    run rehashSymTable(&mut em.*, 64)
  } else if (symLen + usize.ONE) * 2 > cap {
    run rehashSymTable(&mut em.*, cap * 2)
  }
  let curCap = List<usize>.length(&em.symTable)
  let mask = curCap - usize.ONE
  let mut slot = u64.toUsize(hashSymbolName(name)) & mask
  let syms = List<Bytes>.asSlice(&em.symbols)
  let table = List<usize>.asSlice(&em.symTable)
  while table[slot] != usize.MAX {
    let existing = table[slot]
    if same(Bytes.asSlice(&syms[existing]), name) { return existing }
    slot = (slot + usize.ONE) & mask
  }
  let idx = symLen
  run List<Bytes>.append(&mut em.symbols, run Bytes.copy(name))
  let tMut = List<usize>.asMutSlice(&mut em.symTable)
  tMut[slot] = idx
  return idx
}

effect fn addReloc(em: &mut Emitter, offset: usize, kind: RelocationKind, name: &[u8], addend: i64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let target = run internSymbol(&mut em.*, name)
  return run List<Relocation>.append(&mut em.relocations, Relocation {
    offset: offset, kind: kind, target: target, addend: addend,
  })
}

effect fn addRodata16(em: &mut Emitter, bytes: &[u8]) -> usize ! OutOfMemoryError ? &mut Allocator {
  if bytes.length == 16 {
    let existing = Bytes.asSlice(&em.rodata)
    let mut off = usize.ZERO
    while off + 16 <= existing.length {
      let mut eq = true
      let mut k = usize.ZERO
      while k < 16 {
        if existing[off + k] != bytes[k] {
          eq = false
          break
        }
        k = k + usize.ONE
      }
      if eq { return off }
      off = off + 16
    }
  }
  while Bytes.length(&em.rodata) % 16 != usize.ZERO {
    run X86Encode.byte(&mut em.rodata, 0)
  }
  let off = Bytes.length(&em.rodata)
  run Bytes.append(&mut em.rodata, bytes)
  return off
}

effect fn addRodata32(em: &mut Emitter, bytes: &[u8]) -> usize ! OutOfMemoryError ? &mut Allocator {
  if bytes.length == 32 {
    let existing = Bytes.asSlice(&em.rodata)
    let mut off = usize.ZERO
    while off + 32 <= existing.length {
      let mut eq = true
      let mut k = usize.ZERO
      while k < 32 {
        if existing[off + k] != bytes[k] {
          eq = false
          break
        }
        k = k + usize.ONE
      }
      if eq { return off }
      off = off + 16
    }
  }
  while Bytes.length(&em.rodata) % 16 != usize.ZERO {
    run X86Encode.byte(&mut em.rodata, 0)
  }
  let off = Bytes.length(&em.rodata)
  run Bytes.append(&mut em.rodata, bytes)
  return off
}

fn hasFeat(em: &Emitter, bit: u64) -> bool {
  return (em.frame.features & bit) != 0
}

fn isFusedNot(em: &Emitter, val: u64) -> bool {
  if val == none() { return false }
  let idx = u64.toUsize(val)
  let s = List<u8>.asSlice(&em.frame.fusedNot)
  return idx < s.length && s[idx] != 0
}

fn isFusedTrunc(em: &Emitter, val: u64) -> bool {
  if val == none() { return false }
  let idx = u64.toUsize(val)
  let s = List<u8>.asSlice(&em.frame.fusedTrunc)
  return idx < s.length && s[idx] != 0
}

fn isXmmMask16(em: &Emitter, val: u64) -> bool {
  if val == none() { return false }
  let idx = u64.toUsize(val)
  let s = List<u8>.asSlice(&em.frame.xmmMask16)
  return idx < s.length && s[idx] != 0
}

effect fn addRodataReloc(em: &mut Emitter, codeOffset: usize, rodataOffset: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  return run List<Relocation>.append(&mut em.relocations, Relocation {
    offset: codeOffset, kind: RelocationKind.LocalRodataPc32, target: usize.ZERO, addend: usize.toI64(rodataOffset),
  })
}

effect fn emitJmp(em: &mut Emitter) -> usize ! OutOfMemoryError ? &mut Allocator {
  let opAt = Bytes.length(&em.code)
  drop run X86Encode.jmpRel32(&mut em.code)
  let idx = List<LocalBranch>.length(&em.localBranches)
  run List<LocalBranch>.append(&mut em.localBranches, LocalBranch {
    opcodeAt: opAt, isJcc: false, cc: 0, targetBlock: usize.MAX, targetOffset: usize.ZERO, shortened: false,
  })
  return idx
}

effect fn emitJcc(em: &mut Emitter, cc: u8) -> usize ! OutOfMemoryError ? &mut Allocator {
  let opAt = Bytes.length(&em.code)
  drop run X86Encode.jccRel32(&mut em.code, cc)
  let idx = List<LocalBranch>.length(&em.localBranches)
  run List<LocalBranch>.append(&mut em.localBranches, LocalBranch {
    opcodeAt: opAt, isJcc: true, cc: cc, targetBlock: usize.MAX, targetOffset: usize.ZERO, shortened: false,
  })
  return idx
}

effect fn emitJmpBlock(em: &mut Emitter, targetBlock: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let opAt = Bytes.length(&em.code)
  drop run X86Encode.jmpRel32(&mut em.code)
  return run List<LocalBranch>.append(&mut em.localBranches, LocalBranch {
    opcodeAt: opAt, isJcc: false, cc: 0, targetBlock: targetBlock, targetOffset: usize.ZERO, shortened: false,
  })
}

effect fn emitJccBlock(em: &mut Emitter, cc: u8, targetBlock: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let opAt = Bytes.length(&em.code)
  drop run X86Encode.jccRel32(&mut em.code, cc)
  return run List<LocalBranch>.append(&mut em.localBranches, LocalBranch {
    opcodeAt: opAt, isJcc: true, cc: cc, targetBlock: targetBlock, targetOffset: usize.ZERO, shortened: false,
  })
}

fn patchHere(em: &mut Emitter, brIdx: usize) -> () {
  let here = Bytes.length(&em.code)
  let brs = List<LocalBranch>.asMutSlice(&mut em.localBranches)
  brs[brIdx].targetOffset = here
}

fn patchTo(em: &mut Emitter, brIdx: usize, targetOffset: usize) -> () {
  let brs = List<LocalBranch>.asMutSlice(&mut em.localBranches)
  brs[brIdx].targetOffset = targetOffset
}

fn mapOldOffset(oldOff: usize, brs: &[LocalBranch], sb: &[usize]) -> usize {
  let mut lo = usize.ZERO
  let mut hi = brs.length
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if brs[mid].opcodeAt < oldOff {
      lo = mid + usize.ONE
    } else {
      hi = mid
    }
  }
  return oldOff - sb[lo]
}

fn mapOldOffsetWithPads(
  oldOff: usize,
  brs: &[LocalBranch],
  sb: &[usize],
  padOffs: &[usize],
  padPrefix: &[usize],
) -> usize {
  let base = mapOldOffset(oldOff, brs, sb)
  if padOffs.length == usize.ZERO { return base }
  let mut lo = usize.ZERO
  let mut hi = padOffs.length
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if padOffs[mid] <= oldOff {
      lo = mid + usize.ONE
    } else {
      hi = mid
    }
  }
  return base + padPrefix[lo]
}

fn resolveBranchTargets(bOffs: &[usize], brs: &mut [LocalBranch]) -> () {
  let mut i = usize.ZERO
  while i < brs.length {
    if brs[i].targetBlock != usize.MAX {
      brs[i].targetOffset = bOffs[brs[i].targetBlock]
    }
    i = i + usize.ONE
  }
}

fn computeSavedPrefix(brs: &[LocalBranch], sb: &mut [usize]) -> () {
  let mut acc = usize.ZERO
  let mut i = usize.ZERO
  while i < brs.length {
    sb[i] = acc
    if brs[i].shortened {
      let delta: usize = if brs[i].isJcc { 4 } else { 3 }
      acc = acc + delta
    }
    i = i + usize.ONE
  }
  sb[brs.length] = acc
}

fn markShortenedBranches(brs: &mut [LocalBranch], sb: &[usize]) -> bool {
  let n = brs.length
  let mut changed = false
  let mut i = usize.ZERO
  while i < n {
    if !brs[i].shortened {
      let oldLen: usize = if brs[i].isJcc { 6 } else { 5 }
      let mappedStart = brs[i].opcodeAt - sb[i]
      let target = brs[i].targetOffset
      let mut lo = usize.ZERO
      let mut hi = n
      while lo < hi {
        let mid = lo + (hi - lo) / 2
        if brs[mid].opcodeAt < target {
          lo = mid + usize.ONE
        } else {
          hi = mid
        }
      }
      let mappedTarget = target - sb[lo]
      let nextBase = if target > brs[i].opcodeAt { mappedStart + oldLen } else { mappedStart + 2 }
      let rel = usize.toI64(mappedTarget) - usize.toI64(nextBase)
      if rel >= -128 && rel <= 127 {
        brs[i].shortened = true
        changed = true
      }
    }
    i = i + usize.ONE
  }
  return changed
}

effect fn appendRangeWithPads(
  newCode: &mut Bytes,
  oldBytes: &[u8],
  from: usize,
  to: usize,
  padOffs: &[usize],
  padLens: &[usize],
  padIdx: &mut usize,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut cur = from
  while padIdx.* < padOffs.length && padOffs[padIdx.*] <= to {
    let pOff = padOffs[padIdx.*]
    if pOff > cur {
      run Bytes.append(&mut newCode.*, Slice.view<u8>(oldBytes, cur, pOff - cur))
      cur = pOff
    }
    let pLen = padLens[padIdx.*]
    if pLen > usize.ZERO {
      run X86Encode.nopPad(&mut newCode.*, pLen)
    }
    padIdx.* = padIdx.* + usize.ONE
  }
  if to > cur {
    run Bytes.append(&mut newCode.*, Slice.view<u8>(oldBytes, cur, to - cur))
  }
  return ()
}

effect fn buildCompactedCode(
  oldBytes: &[u8],
  brs: &[LocalBranch],
  sb: &[usize],
  padOffs: &[usize],
  padLens: &[usize],
  padPrefix: &[usize],
) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let n = brs.length
  let totalPads = if padPrefix.length > usize.ZERO { padPrefix[padPrefix.length - usize.ONE] } else { usize.ZERO }
  let mut newCode = run Bytes.makeWithCapacity(oldBytes.length - sb[n] + totalPads)
  let mut cursor = usize.ZERO
  let mut padIdx = usize.ZERO
  let mut i = usize.ZERO
  while i < n {
    let br = brs[i]
    run appendRangeWithPads(&mut newCode, oldBytes, cursor, br.opcodeAt, padOffs, padLens, &mut padIdx)
    let oldLen: usize = if br.isJcc { 6 } else { 5 }
    let mappedTarget = mapOldOffsetWithPads(br.targetOffset, brs, sb, padOffs, padPrefix)
    if br.shortened {
      let nextIp = Bytes.length(&newCode) + 2
      let rel = i64.wrappingToI32(usize.toI64(mappedTarget) - usize.toI64(nextIp))
      if br.isJcc {
        run X86Encode.jccRel8(&mut newCode, br.cc, rel)
      } else {
        run X86Encode.jmpRel8(&mut newCode, rel)
      }
    } else {
      let dispAt = if br.isJcc {
        run X86Encode.jccRel32(&mut newCode, br.cc)
      } else {
        run X86Encode.jmpRel32(&mut newCode)
      }
      X86Encode.patchRel32(&mut newCode, dispAt, mappedTarget)
    }
    cursor = br.opcodeAt + oldLen
    i = i + usize.ONE
  }
  run appendRangeWithPads(&mut newCode, oldBytes, cursor, oldBytes.length, padOffs, padLens, &mut padIdx)
  return move newCode
}

effect fn relaxBranches(em: &mut Emitter) -> () ! OutOfMemoryError ? &mut Allocator {
  let n = List<LocalBranch>.length(&em.localBranches)
  if n == usize.ZERO { return () }
  resolveBranchTargets(List<usize>.asSlice(&em.blockOffsets), List<LocalBranch>.asMutSlice(&mut em.localBranches))
  // Keep offsets untouched when raw inline assembly is present.
  if em.frame.hasInlineAsm {
    let brs = List<LocalBranch>.asSlice(&em.localBranches)
    let mut i = usize.ZERO
    while i < n {
      let dispAt = brs[i].opcodeAt + (if brs[i].isJcc { 2 } else { usize.ONE })
      X86Encode.patchRel32(&mut em.code, dispAt, brs[i].targetOffset)
      i = i + usize.ONE
    }
    return ()
  }

  let mut savedBefore = run List<usize>.makeWithCapacity(n + usize.ONE)
  let mut i = usize.ZERO
  while i <= n {
    run List<usize>.append(&mut savedBefore, usize.ZERO)
    i = i + usize.ONE
  }
  let mut anyShortened = false
  let mut changed = true
  while changed {
    computeSavedPrefix(List<LocalBranch>.asSlice(&em.localBranches), List<usize>.asMutSlice(&mut savedBefore))
    changed = markShortenedBranches(List<LocalBranch>.asMutSlice(&mut em.localBranches), List<usize>.asSlice(&savedBefore))
    if changed { anyShortened = true }
  }

  // At Level.Speed, align loop-header blocks (targets of backward branches) to 16 bytes with
  // canonical multi-byte NOPs so hot loops do not suffer x86 DSB/JCC 32-byte boundary stalls.
  let mut padOffs = List<usize>.make()
  let mut padLens = List<usize>.make()
  let mut padPrefix = List<usize>.make()
  let mut totalPads = usize.ZERO
  if em.frame.level == Level.Speed {
    let bOffs = List<usize>.asSlice(&em.blockOffsets)
    let mut isHeader = run List<u8>.makeWithCapacity(bOffs.length)
    i = usize.ZERO
    while i < bOffs.length {
      run List<u8>.append(&mut isHeader, 0)
      i = i + usize.ONE
    }
    let brsScan = List<LocalBranch>.asSlice(&em.localBranches)
    let isHdrMut = List<u8>.asMutSlice(&mut isHeader)
    i = usize.ZERO
    while i < n {
      let tb = brsScan[i].targetBlock
      if tb != usize.MAX && tb != usize.ZERO && tb < bOffs.length && brsScan[i].targetOffset <= brsScan[i].opcodeAt {
        isHdrMut[tb] = 1
      }
      i = i + usize.ONE
    }
    let order = List<usize>.asSlice(&em.frame.blockOrder)
    let hdrSlice = List<u8>.asSlice(&isHeader)
    let entryOff = if bOffs.length > usize.ZERO { bOffs[usize.ZERO] } else { usize.ZERO }
    let mut lastOff = usize.ZERO
    let mut oi = usize.ZERO
    while oi < order.length {
      let blk = order[oi]
      if blk < hdrSlice.length && hdrSlice[blk] != 0 {
        let off = bOffs[blk]
        if off > entryOff && (List<usize>.length(&padOffs) == usize.ZERO || off > lastOff) {
          run List<usize>.append(&mut padOffs, off)
          lastOff = off
        }
      }
      oi = oi + usize.ONE
    }
    let pCount = List<usize>.length(&padOffs)
    if pCount > usize.ZERO {
      i = usize.ZERO
      while i < pCount {
        run List<usize>.append(&mut padLens, usize.ZERO)
        run List<usize>.append(&mut padPrefix, usize.ZERO)
        i = i + usize.ONE
      }
      run List<usize>.append(&mut padPrefix, usize.ZERO)
      let mut aligning = true
      while aligning {
        aligning = false
        computeSavedPrefix(List<LocalBranch>.asSlice(&em.localBranches), List<usize>.asMutSlice(&mut savedBefore))
        let sbCur = List<usize>.asSlice(&savedBefore)
        let brsCur = List<LocalBranch>.asSlice(&em.localBranches)
        let poCur = List<usize>.asSlice(&padOffs)
        let plMut = List<usize>.asMutSlice(&mut padLens)
        let ppMut = List<usize>.asMutSlice(&mut padPrefix)
        let mut accPad = usize.ZERO
        let mut pk = usize.ZERO
        while pk < pCount {
          ppMut[pk] = accPad
          let raw = mapOldOffset(poCur[pk], brsCur, sbCur) + accPad
          let rem = raw & 15
          let pad = if rem == usize.ZERO { usize.ZERO } else { 16 - rem }
          plMut[pk] = pad
          accPad = accPad + pad
          pk = pk + usize.ONE
        }
        ppMut[pCount] = accPad
        totalPads = accPad
        // Verify every shortened rel8 branch still fits in [-128, 127]; un-shorten any that grew out of range.
        let ppCur = List<usize>.asSlice(&padPrefix)
        let mut unshorten = List<usize>.make()
        i = usize.ZERO
        while i < n {
          if brsCur[i].shortened {
            let mStart = mapOldOffsetWithPads(brsCur[i].opcodeAt, brsCur, sbCur, poCur, ppCur)
            let mTarget = mapOldOffsetWithPads(brsCur[i].targetOffset, brsCur, sbCur, poCur, ppCur)
            let rel = usize.toI64(mTarget) - usize.toI64(mStart + 2)
            if rel < -128 || rel > 127 {
              run List<usize>.append(&mut unshorten, i)
            }
          }
          i = i + usize.ONE
        }
        let uLen = List<usize>.length(&unshorten)
        if uLen > usize.ZERO {
          let brsMut = List<LocalBranch>.asMutSlice(&mut em.localBranches)
          let us = List<usize>.asSlice(&unshorten)
          let mut ui = usize.ZERO
          while ui < uLen {
            brsMut[us[ui]].shortened = false
            ui = ui + usize.ONE
          }
          aligning = true
        }
      }
    }
  }

  if !anyShortened && totalPads == usize.ZERO {
    let brs = List<LocalBranch>.asSlice(&em.localBranches)
    i = usize.ZERO
    while i < n {
      let dispAt = brs[i].opcodeAt + (if brs[i].isJcc { 2 } else { usize.ONE })
      X86Encode.patchRel32(&mut em.code, dispAt, brs[i].targetOffset)
      i = i + usize.ONE
    }
    return ()
  }
  computeSavedPrefix(List<LocalBranch>.asSlice(&em.localBranches), List<usize>.asMutSlice(&mut savedBefore))
  let sbSlice = List<usize>.asSlice(&savedBefore)
  let brs = List<LocalBranch>.asSlice(&em.localBranches)
  let poSlice = List<usize>.asSlice(&padOffs)
  let plSlice = List<usize>.asSlice(&padLens)
  let ppSlice = List<usize>.asSlice(&padPrefix)
  let mut newCode = run buildCompactedCode(Bytes.asSlice(&em.code), brs, sbSlice, poSlice, plSlice, ppSlice)
  em.code = move newCode
  let bOffMut = List<usize>.asMutSlice(&mut em.blockOffsets)
  i = usize.ZERO
  while i < bOffMut.length {
    bOffMut[i] = mapOldOffsetWithPads(bOffMut[i], brs, sbSlice, poSlice, ppSlice)
    i = i + usize.ONE
  }
  let relsMut = List<Relocation>.asMutSlice(&mut em.relocations)
  i = usize.ZERO
  while i < relsMut.length {
    relsMut[i].offset = mapOldOffsetWithPads(relsMut[i].offset, brs, sbSlice, poSlice, ppSlice)
    i = i + usize.ONE
  }
  let locsMut = List<u64>.asMutSlice(&mut em.locations)
  i = usize.ZERO
  while i < locsMut.length {
    locsMut[i] = usize.toU64(mapOldOffsetWithPads(u64.toUsize(locsMut[i]), brs, sbSlice, poSlice, ppSlice))
    i = i + 2
  }
  return ()
}

effect fn callExternal(em: &mut Emitter, name: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let callAt = run X86Encode.callRel32(&mut em.code)
  return run addReloc(&mut em.*, callAt, RelocationKind.Plt32, name, -4)
}

// SysV AMD64 GP argument registers: rdi, rsi, rdx, rcx, r8, r9.
fn sysvGpArg(index: usize) -> u8 {
  if index == 0 { return X86Encode.rdi() }
  if index == 1 { return X86Encode.rsi() }
  if index == 2 { return X86Encode.rdx() }
  if index == 3 { return X86Encode.rcx() }
  if index == 4 { return X86Encode.r8() }
  return X86Encode.r9()
}

// ---- Prologue, Incoming Parameters, Epilogue ----

effect fn emitPrologue(em: &mut Emitter, function: &SsaFunction) -> () ! OutOfMemoryError ? &mut Allocator {
  let start = Bytes.length(&em.code)
  run X86Encode.push(&mut em.code, X86Encode.rbp())
  let pushEnd = u64.wrappingToU8(usize.toU64(Bytes.length(&em.code) - start))
  run X86Encode.movRr64(&mut em.code, X86Encode.rbp(), X86Encode.rsp())
  let movEnd = u64.wrappingToU8(usize.toU64(Bytes.length(&em.code) - start))

  // Push any callee-saved GPRs allocated to SSA values or needed by inline asm / cmpxchg16b.
  let mask = em.frame.savedCalleeMask
  let mut r: u8 = 0
  while r < 16 {
    if (mask & u64.shiftLeft(1, u8.toU64(r))) != 0 {
      run X86Encode.push(&mut em.code, r)
    }
    r = r + 1
  }
  let savesEnd = u64.wrappingToU8(usize.toU64(Bytes.length(&em.code) - start))
  em.unwind = UnwindInfo {
    hasFramePointer: true,
    pushRbpEnd: pushEnd,
    movRbpEnd: movEnd,
    savedCalleeMask: mask,
    savesEnd: savesEnd,
  }

  let subBytes = em.frame.subRspBytes
  if subBytes > 0 {
    if subBytes <= 2147483647 {
      run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rsp(), u64.wrappingToI32(subBytes))
    } else {
      run X86Encode.movImm64(&mut em.code, X86Encode.r11(), subBytes)
      run X86Encode.aluRr64(&mut em.code, Alu.Sub, X86Encode.rsp(), X86Encode.r11())
    }
  }

  // Variadic C export prologue: save all 6 GP arg regs + 8 XMM arg regs (when AL != 0) into
  // `[rbp + regSaveOffset]`.
  if em.frame.hasVaStart {
    let base = em.frame.regSaveOffset
    let mut g = usize.ZERO
    while g < 6 {
      drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), base + usize.toI32(g * 8)), sysvGpArg(g))
      g = g + usize.ONE
    }
    run X86Encode.testRr8(&mut em.code, X86Encode.rax(), X86Encode.rax())
    let skipFp = run emitJcc(&mut em.*, X86Encode.ccE())
    let mut x: u8 = 0
    while x < 8 {
      drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), base + 48 + u8.toI32(x) * 16), x)
      x = x + 1
    }
    patchHere(&mut em.*, skipFp)
  }
  drop function
  return ()
}

effect fn emitIncomingParams(em: &mut Emitter, function: &SsaFunction) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let argCount = List<u64>.length(&function.arguments)
  let mut gpMoves = List<GpMove>.make()
  let mut xmmMoves = List<XmmMove>.make()
  let mut xmmReserved: u64 = 0
  let mut gpIdx = usize.ZERO
  let mut fpIdx = usize.ZERO
  let mut stackOff: i32 = 16 // [rbp + 16] is first incoming stack argument
  let mut a = usize.ZERO
  // Phase A: perform all immediate stack/`i128` stores (writing zero allocated GP/XMM registers)
  // and defer all register-targeted moves into `gpMoves`/`xmmMoves` for parallel resolution.
  while a < argCount {
    let val = List<u64>.asSlice(&function.arguments)[a]
    let kind = function.value(val).kind
    let abi = function.argumentAbi(a)
    let home = valOff(&em.*, val)
    let homeReg = valReg(&em.*, val)
    let homeXmm = valXmm(&em.*, val)
    if abi.byvalSize > 0 {
      // `byval` aggregate lives on the caller's stack; the SSA argument is its address!
      let align: i32 = if abi.byvalAlignment > 8 { usize.toI32(abi.byvalAlignment) } else { 8 }
      stackOff = alignI32(stackOff, align)
      if homeReg != X86Frame.regNone() {
        run List<GpMove>.append(&mut gpMoves, GpMove {
          srcKind: 4, srcBytes: 8, srcVal: 0, srcReg: X86Frame.regNone(), srcOff: stackOff,
          dstIsReg: true, dstReg: homeReg, dstOff: 0, done: false,
        })
      } else if home != 0 {
        drop run X86Encode.lea64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rbp(), stackOff))
        drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), home), X86Encode.r11())
      }
      stackOff = stackOff + u64.wrappingToI32(((abi.byvalSize + 7) / 8) * 8)
    } else if kind.isVector() {
      let sz = kind.storeSize()
      if sz <= 16 && fpIdx < 8 {
        if homeXmm != X86Frame.regNone() {
          let srcXmm = usize.toU8(fpIdx)
          if homeXmm != srcXmm {
            run List<XmmMove>.append(&mut xmmMoves, XmmMove {
              srcKind: 0, width: 16, srcVal: 0, srcReg: srcXmm, srcOff: 0,
              dstIsReg: true, dstReg: homeXmm, dstOff: 0, done: false,
            })
          } else if homeXmm < 16 {
            xmmReserved = xmmReserved | u64.shiftLeft(1, u8.toU64(homeXmm))
          }
        } else if home != 0 {
          drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), home), usize.toU8(fpIdx))
        }
        fpIdx = fpIdx + usize.ONE
      } else {
        let align: i32 = if sz >= 16 { 16 } else { 8 }
        stackOff = alignI32(stackOff, align)
        if homeXmm != X86Frame.regNone() && (sz == 16 || (sz == 32 && hasFeat(&em.*, X86Frame.featAvx2()))) {
          run List<XmmMove>.append(&mut xmmMoves, XmmMove {
            srcKind: 1, width: usize.toU8(sz), srcVal: 0, srcReg: X86Frame.regNone(), srcOff: stackOff,
            dstIsReg: true, dstReg: homeXmm, dstOff: 0, done: false,
          })
        } else if home != 0 {
          let mut off = usize.ZERO
          while off < sz {
            drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rbp(), stackOff + usize.toI32(off)))
            drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), home + usize.toI32(off)), X86Encode.r11())
            off = off + 8
          }
        }
        stackOff = stackOff + usize.toI32(((sz + 7) / 8) * 8)
      }
    } else if kind.isFloat() {
      if fpIdx < 8 {
        if homeXmm != X86Frame.regNone() {
          let srcXmm = usize.toU8(fpIdx)
          if homeXmm != srcXmm {
            let w: u8 = if kind.bits == 64 { 8 } else { 4 }
            run List<XmmMove>.append(&mut xmmMoves, XmmMove {
              srcKind: 0, width: w, srcVal: 0, srcReg: srcXmm, srcOff: 0,
              dstIsReg: true, dstReg: homeXmm, dstOff: 0, done: false,
            })
          } else if homeXmm < 16 {
            xmmReserved = xmmReserved | u64.shiftLeft(1, u8.toU64(homeXmm))
          }
        } else if home != 0 {
          if kind.bits == 64 {
            drop run X86Encode.movsdMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), home), usize.toU8(fpIdx))
          } else {
            drop run X86Encode.movssMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), home), usize.toU8(fpIdx))
          }
        }
        fpIdx = fpIdx + usize.ONE
      } else {
        if homeXmm != X86Frame.regNone() {
          let w: u8 = if kind.bits == 64 { 8 } else { 4 }
          run List<XmmMove>.append(&mut xmmMoves, XmmMove {
            srcKind: 1, width: w, srcVal: 0, srcReg: X86Frame.regNone(), srcOff: stackOff,
            dstIsReg: true, dstReg: homeXmm, dstOff: 0, done: false,
          })
        } else if home != 0 {
          drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rbp(), stackOff))
          drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), home), X86Encode.r11())
        }
        stackOff = stackOff + 8
      }
    } else if kind.bits > 64 {
      // `i128`: two consecutive GP registers if both fit, else 16 bytes on stack.
      if gpIdx + 2 <= 6 {
        if home != 0 {
          drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), home), sysvGpArg(gpIdx))
          drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), home + 8), sysvGpArg(gpIdx + usize.ONE))
        }
        gpIdx = gpIdx + 2
      } else {
        if home != 0 {
          drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rbp(), stackOff))
          drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), home), X86Encode.r11())
          drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rbp(), stackOff + 8))
          drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), home + 8), X86Encode.r11())
        }
        stackOff = stackOff + 16
      }
    } else {
      // Ordinary <=64-bit integer or address.
      if gpIdx < 6 {
        let srcReg = sysvGpArg(gpIdx)
        if homeReg != X86Frame.regNone() {
          if homeReg != srcReg {
            run List<GpMove>.append(&mut gpMoves, GpMove {
              srcKind: 0, srcBytes: 8, srcVal: 0, srcReg: srcReg, srcOff: 0,
              dstIsReg: true, dstReg: homeReg, dstOff: 0, done: false,
            })
          }
        } else if home != 0 {
          drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), home), srcReg)
        }
        gpIdx = gpIdx + usize.ONE
      } else {
        if homeReg != X86Frame.regNone() {
          run List<GpMove>.append(&mut gpMoves, GpMove {
            srcKind: 1, srcBytes: 8, srcVal: 0, srcReg: X86Frame.regNone(), srcOff: stackOff,
            dstIsReg: true, dstReg: homeReg, dstOff: 0, done: false,
          })
        } else if home != 0 {
          drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rbp(), stackOff))
          drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), home), X86Encode.r11())
        }
        stackOff = stackOff + 8
      }
    }
    a = a + usize.ONE
  }
  // Phase B: execute all register-targeted XMM and GP moves in parallel.
  if List<XmmMove>.length(&xmmMoves) > usize.ZERO {
    run resolveXmmMoves(&mut em.*, function, &mut xmmMoves, xmmReserved)
  }
  if List<GpMove>.length(&gpMoves) > usize.ZERO {
    run resolveGpMoves(&mut em.*, function, &mut gpMoves)
  }
  em.fixedGpCount = gpIdx
  em.fixedFpCount = fpIdx
  em.fixedStackBytes = i32.toU64(stackOff - 16)
  return ()
}

effect fn emitEpilogue(em: &mut Emitter) -> () ! OutOfMemoryError ? &mut Allocator {
  if em.frame.usesYmm {
    run X86Encode.vzeroupper(&mut em.code)
  }
  if em.frame.savedCount == usize.ZERO {
    run X86Encode.leave(&mut em.code)
    return run X86Encode.ret(&mut em.code)
  }
  // Restore `rsp` to just below the pushed callee-saved registers, pop them in reverse order.
  let savedBytes = usize.toI32(em.frame.savedCount * 8)
  drop run X86Encode.lea64(&mut em.code, X86Encode.rsp(), Mem.baseDisp(X86Encode.rbp(), 0 - savedBytes))
  let mask = em.frame.savedCalleeMask
  let mut r: usize = 16
  while r > usize.ZERO {
    r = r - usize.ONE
    if (mask & u64.shiftLeft(1, usize.toU64(r))) != 0 {
      run X86Encode.pop(&mut em.code, usize.toU8(r))
    }
  }
  run X86Encode.pop(&mut em.code, X86Encode.rbp())
  return run X86Encode.ret(&mut em.code)
}

// ---- Value Load / Store Helpers ----

fn valOff(em: &Emitter, val: u64) -> i32 {
  if val == none() { return 0 }
  return List<i32>.asSlice(&em.frame.valueOffsets)[u64.toUsize(val)]
}

fn valReg(em: &Emitter, val: u64) -> u8 {
  if val == none() { return X86Frame.regNone() }
  return List<u8>.asSlice(&em.frame.valueRegs)[u64.toUsize(val)]
}

fn valSlotBase(em: &Emitter, val: u64) -> i32 {
  if val == none() { return 0 }
  return List<i32>.asSlice(&em.frame.valueSlotBase)[u64.toUsize(val)]
}

fn fusedLoadBytes(em: &Emitter, val: u64) -> u8 {
  if val == none() { return 0 }
  let idx = u64.toUsize(val)
  let bytes = List<u8>.asSlice(&em.frame.fusedLoadBytes)
  if idx >= bytes.length { return 0 }
  return bytes[idx]
}

fn fusedLoadOff(em: &Emitter, val: u64) -> i32 {
  if val == none() { return 0 }
  let idx = u64.toUsize(val)
  let offs = List<i32>.asSlice(&em.frame.fusedLoadOffsets)
  if idx >= offs.length { return 0 }
  return offs[idx]
}

fn isFusedCallStore(em: &Emitter, val: u64) -> bool {
  if val == none() { return false }
  let idx = u64.toUsize(val)
  let flags = List<u8>.asSlice(&em.frame.fusedCallStores)
  if idx >= flags.length { return false }
  return flags[idx] != 0
}

fn foldedAddrKind(em: &Emitter, val: u64) -> u8 {
  if val == none() { return 0 }
  let idx = u64.toUsize(val)
  let kinds = List<u8>.asSlice(&em.frame.foldedAddrKind)
  if idx >= kinds.length { return 0 }
  return kinds[idx]
}

fn foldedAddrBase(em: &Emitter, val: u64) -> u64 {
  return List<u64>.asSlice(&em.frame.foldedAddrBase)[u64.toUsize(val)]
}

fn foldedAddrIndex(em: &Emitter, val: u64) -> u64 {
  return List<u64>.asSlice(&em.frame.foldedAddrIndex)[u64.toUsize(val)]
}

fn foldedAddrScale(em: &Emitter, val: u64) -> u8 {
  return List<u8>.asSlice(&em.frame.foldedAddrScale)[u64.toUsize(val)]
}

fn foldedAddrDisp(em: &Emitter, val: u64) -> i32 {
  return List<i32>.asSlice(&em.frame.foldedAddrDisp)[u64.toUsize(val)]
}

fn isKnownBool(em: &Emitter, val: u64) -> bool {
  if val == none() { return false }
  let idx = u64.toUsize(val)
  let kb = List<u8>.asSlice(&em.knownBool)
  if idx >= kb.length { return false }
  return kb[idx] != 0
}

fn spilledGpOff(em: &Emitter, function: &SsaFunction, value: u64) -> i32 {
  let info = function.value(value)
  if info.definition == Definition.Constant { return 0 }
  if valSlotBase(em, value) != 0 { return 0 }
  if valReg(em, value) != X86Frame.regNone() { return 0 }
  return valOff(em, value)
}

fn slotOff(em: &Emitter, slot: usize) -> i32 {
  return List<i32>.asSlice(&em.frame.slotOffsets)[slot]
}

fn dstRegOrScratch(em: &Emitter, val: u64, scratch: u8) -> u8 {
  if val != none() && val == em.retTargetVal { return X86Encode.rax() }
  let r = valReg(em, val)
  if r != X86Frame.regNone() { return r }
  return scratch
}

// Returns `val`'s assigned callee-saved GPR without emitting code, or loads `val` into `scratch`.
effect fn regOrLoad(em: &mut Emitter, function: &SsaFunction, value: u64, scratch: u8) -> u8
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let info = function.value(value)
  if info.definition != Definition.Constant {
    let r = valReg(&em.*, value)
    if r != X86Frame.regNone() { return r }
  }
  run loadGp(&mut em.*, function, value, scratch)
  return scratch
}

fn constBitsImm32(function: &SsaFunction, value: u64, bits: usize) -> Imm32 {
  let info = function.value(value)
  if info.definition != Definition.Constant { return Imm32 {ok: false, value: 0} }
  let c = function.constantOf(value)
  if c.form != ConstantForm.Bits { return Imm32 {ok: false, value: 0} }
  let masked = maskBits(c.low, bits)
  if bits == 32 {
    return Imm32 {ok: true, value: u64.wrappingToI32(masked)}
  }
  let signed = u64.wrappingToI64(masked)
  if signed >= -2147483648 && signed <= 2147483647 {
    return Imm32 {ok: true, value: i64.wrappingToI32(signed)}
  }
  return Imm32 {ok: false, value: 0}
}

// Loads any <=64-bit integer, flag, or address value into `dstReg` (clobbers only `dstReg` and
// `r11` for TLS if `dstReg != r11`, or `r10` if `dstReg == r11`).
effect fn loadGp(em: &mut Emitter, function: &SsaFunction, value: u64, dstReg: u8) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let info = function.value(value)
  if info.definition == Definition.Constant {
    let c = function.constantOf(value)
    return run loadConstantGp(&mut em.*, function, c, info.kind, dstReg)
  }
  let sb = valSlotBase(&em.*, value)
  if sb != 0 {
    drop run X86Encode.lea64(&mut em.code, dstReg, Mem.baseDisp(X86Encode.rbp(), sb))
    return ()
  }
  let reg = valReg(&em.*, value)
  if reg != X86Frame.regNone() {
    if reg != dstReg {
      return run X86Encode.movRr64(&mut em.code, dstReg, reg)
    }
    return ()
  }
  let off = valOff(&em.*, value)
  if off == 0 {
    return run X86Encode.movImm64(&mut em.code, dstReg, 0)
  }
  drop run X86Encode.movRm64(&mut em.code, dstReg, Mem.baseDisp(X86Encode.rbp(), off))
  return ()
}

effect fn loadConstantGp(em: &mut Emitter, function: &SsaFunction, c: Constant, kind: Kind, dstReg: u8) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  match c.form {
    ConstantForm.Bits => {
      return run X86Encode.movImm64(&mut em.code, dstReg, maskBits(c.low, kind.bits))
    }
    ConstantForm.Symbol => {
      // Load address via GOT (`mov dst, [rip + sym@GOTPCREL]`) for full PIE & weak-symbol safety.
      let sym = function.symbolName(c.symbol)
      let dispAt = run X86Encode.movRm64(&mut em.code, dstReg, Mem.ripRel(0))
      run addReloc(&mut em.*, dispAt, RelocationKind.GotPcRel, sym, -4)
      if c.low != 0 {
        let signed = u64.wrappingToI64(c.low)
        if signed >= -2147483648 && signed <= 2147483647 {
          run X86Encode.aluRi64(&mut em.code, Alu.Add, dstReg, i64.wrappingToI32(signed))
        } else {
          let tmp = if dstReg == X86Encode.r11() { X86Encode.r10() } else { X86Encode.r11() }
          run X86Encode.movImm64(&mut em.code, tmp, c.low)
          run X86Encode.aluRr64(&mut em.code, Alu.Add, dstReg, tmp)
        }
      }
      return ()
    }
    ConstantForm.ThreadLocal => {
      // Initial-Exec TLS: `mov dst, [rip + sym@GOTTPOFF]; add dst, fs:[0]`.
      let sym = function.symbolName(c.symbol)
      let dispAt = run X86Encode.movRm64(&mut em.code, dstReg, Mem.ripRel(0))
      run addReloc(&mut em.*, dispAt, RelocationKind.GotTpOff, sym, -4)
      drop run X86Encode.aluRm64(&mut em.code, Alu.Add, dstReg, Mem.fsDisp(0))
      if c.low != 0 {
        let signed = u64.wrappingToI64(c.low)
        if signed >= -2147483648 && signed <= 2147483647 {
          run X86Encode.aluRi64(&mut em.code, Alu.Add, dstReg, i64.wrappingToI32(signed))
        } else {
          let tmp = if dstReg == X86Encode.r11() { X86Encode.r10() } else { X86Encode.r11() }
          run X86Encode.movImm64(&mut em.code, tmp, c.low)
          run X86Encode.aluRr64(&mut em.code, Alu.Add, dstReg, tmp)
        }
      }
      return ()
    }
    ConstantForm.Link => {
      return run X86Object.unsupported(b"wasm link constant on x86-64", Bytes.asSlice(&em.symbol))
    }
  }
}

effect fn storeGp(em: &mut Emitter, value: u64, srcReg: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  if value != none() && value == em.retTargetVal {
    if srcReg != X86Encode.rax() {
      return run X86Encode.movRr64(&mut em.code, X86Encode.rax(), srcReg)
    }
    return ()
  }
  let reg = valReg(&em.*, value)
  if reg != X86Frame.regNone() {
    if reg != srcReg {
      return run X86Encode.movRr64(&mut em.code, reg, srcReg)
    }
    return ()
  }
  let off = valOff(&em.*, value)
  if off == 0 { return () }
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), off), srcReg)
  return ()
}

effect fn loadPair(em: &mut Emitter, function: &SsaFunction, value: u64, loReg: u8, hiReg: u8) -> ()
! OutOfMemoryError ? &mut Allocator {
  let info = function.value(value)
  if info.definition == Definition.Constant {
    let c = function.constantOf(value)
    run X86Encode.movImm64(&mut em.code, loReg, c.low)
    return run X86Encode.movImm64(&mut em.code, hiReg, c.high)
  }
  let off = valOff(&em.*, value)
  if off == 0 {
    run X86Encode.movImm64(&mut em.code, loReg, 0)
    return run X86Encode.movImm64(&mut em.code, hiReg, 0)
  }
  drop run X86Encode.movRm64(&mut em.code, loReg, Mem.baseDisp(X86Encode.rbp(), off))
  drop run X86Encode.movRm64(&mut em.code, hiReg, Mem.baseDisp(X86Encode.rbp(), off + 8))
  return ()
}

effect fn storePair(em: &mut Emitter, value: u64, loReg: u8, hiReg: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let off = valOff(&em.*, value)
  if off == 0 { return () }
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), off), loReg)
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), off + 8), hiReg)
  return ()
}

fn valXmm(em: &Emitter, value: u64) -> u8 {
  if value == none() { return X86Frame.regNone() }
  let idx = u64.toUsize(value)
  let xmms = List<u8>.asSlice(&em.frame.valueXmms)
  if idx >= xmms.length { return X86Frame.regNone() }
  return xmms[idx]
}

fn dstXmmOrScratch(em: &Emitter, result: u64, scratch: u8) -> u8 {
  let x = valXmm(em, result)
  if x != X86Frame.regNone() { return x }
  return scratch
}

effect fn loadFloat(em: &mut Emitter, function: &SsaFunction, value: u64, xmmReg: u8, scratchGp: u8) -> ()
! OutOfMemoryError ? &mut Allocator {
  let info = function.value(value)
  let double = info.kind.bits == 64
  if info.definition == Definition.Constant {
    let c = function.constantOf(value)
    if c.low == 0 {
      return run X86Encode.pxor(&mut em.code, xmmReg, xmmReg)
    }
    run X86Encode.movImm64(&mut em.code, scratchGp, c.low)
    if double { return run X86Encode.movqToXmm(&mut em.code, xmmReg, scratchGp) }
    return run X86Encode.movdToXmm(&mut em.code, xmmReg, scratchGp)
  }
  let homeXmm = valXmm(&em.*, value)
  if homeXmm != X86Frame.regNone() {
    if homeXmm != xmmReg {
      return run X86Encode.movapsRr(&mut em.code, xmmReg, homeXmm)
    }
    return ()
  }
  let off = valOff(&em.*, value)
  if off == 0 {
    return run X86Encode.pxor(&mut em.code, xmmReg, xmmReg)
  }
  if double {
    drop run X86Encode.movsdRm(&mut em.code, xmmReg, Mem.baseDisp(X86Encode.rbp(), off))
  } else {
    drop run X86Encode.movssRm(&mut em.code, xmmReg, Mem.baseDisp(X86Encode.rbp(), off))
  }
  return ()
}

effect fn storeFloat(em: &mut Emitter, value: u64, xmmReg: u8, double: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let homeXmm = valXmm(&em.*, value)
  if homeXmm != X86Frame.regNone() {
    if homeXmm != xmmReg {
      return run X86Encode.movapsRr(&mut em.code, homeXmm, xmmReg)
    }
    return ()
  }
  let off = valOff(&em.*, value)
  if off == 0 { return () }
  if double {
    drop run X86Encode.movsdMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), off), xmmReg)
  } else {
    drop run X86Encode.movssMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), off), xmmReg)
  }
  return ()
}

effect fn loadVec128(em: &mut Emitter, function: &SsaFunction, value: u64, dstXmm: u8) -> ()
! OutOfMemoryError ? &mut Allocator {
  let info = function.value(value)
  if info.definition == Definition.Constant {
    let c = function.constantOf(value)
    if c.low == 0 {
      return run X86Encode.pxor(&mut em.code, dstXmm, dstXmm)
    }
    let img = run buildVectorConstantBytes(info.kind, c.low)
    let roOff = run addRodata16(&mut em.*, Bytes.asSlice(&img))
    let dispAt = run X86Encode.movdquRm(&mut em.code, dstXmm, Mem.ripRel(0))
    return run addRodataReloc(&mut em.*, dispAt, roOff)
  }
  let homeXmm = valXmm(&em.*, value)
  if homeXmm != X86Frame.regNone() {
    if homeXmm != dstXmm {
      return run X86Encode.movapsRr(&mut em.code, dstXmm, homeXmm)
    }
    return ()
  }
  let off = valOff(&em.*, value)
  if off == 0 {
    return run X86Encode.pxor(&mut em.code, dstXmm, dstXmm)
  }
  drop run X86Encode.movdqaRm(&mut em.code, dstXmm, Mem.baseDisp(X86Encode.rbp(), off))
  return ()
}

effect fn xmmOrLoadVec128(em: &mut Emitter, function: &SsaFunction, value: u64, scratchXmm: u8) -> u8
! OutOfMemoryError ? &mut Allocator {
  if function.value(value).definition != Definition.Constant {
    let homeXmm = valXmm(&em.*, value)
    if homeXmm != X86Frame.regNone() { return homeXmm }
  }
  run loadVec128(&mut em.*, function, value, scratchXmm)
  return scratchXmm
}

effect fn storeVec128(em: &mut Emitter, value: u64, srcXmm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let homeXmm = valXmm(&em.*, value)
  if homeXmm != X86Frame.regNone() {
    if homeXmm != srcXmm {
      return run X86Encode.movapsRr(&mut em.code, homeXmm, srcXmm)
    }
    return ()
  }
  let off = valOff(&em.*, value)
  if off == 0 { return () }
  drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), off), srcXmm)
  return ()
}

effect fn loadVec256(em: &mut Emitter, function: &SsaFunction, value: u64, dstYmm: u8) -> ()
! OutOfMemoryError ? &mut Allocator {
  let info = function.value(value)
  if info.definition == Definition.Constant {
    let c = function.constantOf(value)
    if c.low == 0 {
      return run X86Encode.vpxorYmm(&mut em.code, dstYmm, dstYmm, dstYmm)
    }
    let img = run buildVectorConstantBytes(info.kind, c.low)
    let roOff = run addRodata32(&mut em.*, Bytes.asSlice(&img))
    let dispAt = run X86Encode.vmovdquYmmRm(&mut em.code, dstYmm, Mem.ripRel(0))
    return run addRodataReloc(&mut em.*, dispAt, roOff)
  }
  let homeYmm = valXmm(&em.*, value)
  if homeYmm != X86Frame.regNone() {
    if homeYmm != dstYmm {
      return run X86Encode.vmovdqaYmmRr(&mut em.code, dstYmm, homeYmm)
    }
    return ()
  }
  let off = valOff(&em.*, value)
  if off == 0 {
    return run X86Encode.vpxorYmm(&mut em.code, dstYmm, dstYmm, dstYmm)
  }
  drop run X86Encode.vmovdquYmmRm(&mut em.code, dstYmm, Mem.baseDisp(X86Encode.rbp(), off))
  return ()
}

effect fn ymmOrLoadVec256(em: &mut Emitter, function: &SsaFunction, value: u64, scratchYmm: u8) -> u8
! OutOfMemoryError ? &mut Allocator {
  if function.value(value).definition != Definition.Constant {
    let homeYmm = valXmm(&em.*, value)
    if homeYmm != X86Frame.regNone() { return homeYmm }
  }
  run loadVec256(&mut em.*, function, value, scratchYmm)
  return scratchYmm
}

effect fn storeVec256(em: &mut Emitter, value: u64, srcYmm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let homeYmm = valXmm(&em.*, value)
  if homeYmm != X86Frame.regNone() {
    if homeYmm != srcYmm {
      return run X86Encode.vmovdqaYmmRr(&mut em.code, homeYmm, srcYmm)
    }
    return ()
  }
  let off = valOff(&em.*, value)
  if off == 0 { return () }
  drop run X86Encode.vmovdquYmmMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), off), srcYmm)
  return ()
}

effect fn loadMask16ToXmm(em: &mut Emitter, function: &SsaFunction, value: u64, dstXmm: u8, tmpXmm: u8) -> ()
! OutOfMemoryError ? &mut Allocator {
  if isXmmMask16(&em.*, value) {
    let hx = valXmm(&em.*, value)
    if hx != dstXmm {
      return run X86Encode.movapsRr(&mut em.code, dstXmm, hx)
    }
    return ()
  }
  let info = function.value(value)
  if info.definition == Definition.Constant {
    if (function.constantOf(value).low & 1) == 0 {
      return run X86Encode.pxor(&mut em.code, dstXmm, dstXmm)
    }
    return run X86Encode.pcmpeq(&mut em.code, 1, dstXmm, dstXmm)
  }
  run loadMaskBits64(&mut em.*, function, value, X86Encode.rax())
  run X86Encode.movdToXmm(&mut em.code, dstXmm, X86Encode.rax())
  run X86Encode.punpcklbw(&mut em.code, dstXmm, dstXmm)
  run X86Encode.punpcklwd(&mut em.code, dstXmm, dstXmm)
  run X86Encode.pshufd(&mut em.code, dstXmm, dstXmm, 0x50)
  let mut bitMask = run Bytes.zeroed(16)
  let bmBuf = Bytes.asMutSlice(&mut bitMask)
  let mut k = usize.ZERO
  while k < 16 {
    bmBuf[k] = u8.shiftLeft(1, usize.toU8(k % 8))
    k = k + usize.ONE
  }
  let roOff = run addRodata16(&mut em.*, Bytes.asSlice(&bitMask))
  let dispAt = run X86Encode.movdquRm(&mut em.code, tmpXmm, Mem.ripRel(0))
  run addRodataReloc(&mut em.*, dispAt, roOff)
  run X86Encode.pand(&mut em.code, dstXmm, tmpXmm)
  return run X86Encode.pcmpeq(&mut em.code, 1, dstXmm, tmpXmm)
}

effect fn xmmOrLoadMask16(em: &mut Emitter, function: &SsaFunction, value: u64, scratchXmm: u8, tmpXmm: u8) -> u8
! OutOfMemoryError ? &mut Allocator {
  if isXmmMask16(&em.*, value) {
    return valXmm(&em.*, value)
  }
  run loadMask16ToXmm(&mut em.*, function, value, scratchXmm, tmpXmm)
  return scratchXmm
}

effect fn storeXmmMask16(em: &mut Emitter, kind: Kind, result: u64, srcXmm: u8) -> ()
! OutOfMemoryError ? &mut Allocator {
  if isXmmMask16(&em.*, result) {
    let hx = valXmm(&em.*, result)
    if hx != srcXmm {
      return run X86Encode.movapsRr(&mut em.code, hx, srcXmm)
    }
    return ()
  }
  run X86Encode.pmovmskb(&mut em.code, X86Encode.rax(), srcXmm)
  return run storeMaskBits64(&mut em.*, kind, result, X86Encode.rax())
}

// Loads a small vector (`storeSize()` in `{1, 2, 4, 8}`) zero-extended into `dstGp` without
// clobbering any other GP register or causing wide-load STLF stalls.
effect fn loadSmallVecGp(em: &mut Emitter, function: &SsaFunction, value: u64, dstGp: u8) -> ()
! OutOfMemoryError ? &mut Allocator {
  let info = function.value(value)
  let sz = info.kind.storeSize()
  if info.definition == Definition.Constant {
    let c = function.constantOf(value)
    let img = run buildVectorConstantBytes(info.kind, c.low)
    let buf = Bytes.asSlice(&img)
    let mut bits: u64 = 0
    let mut b = usize.ZERO
    while b < sz {
      bits = bits | u64.shiftLeft(u8.toU64(buf[b]), usize.toU64(b * 8))
      b = b + usize.ONE
    }
    return run X86Encode.movImm64(&mut em.code, dstGp, bits)
  }
  let off = valOff(&em.*, value)
  if off == 0 {
    return run X86Encode.aluRr32(&mut em.code, Alu.Xor, dstGp, dstGp)
  }
  let mem = Mem.baseDisp(X86Encode.rbp(), off)
  if sz == 1 { drop run X86Encode.movzxRm8(&mut em.code, dstGp, mem) }
  else if sz == 2 { drop run X86Encode.movzxRm16(&mut em.code, dstGp, mem) }
  else if sz == 4 { drop run X86Encode.movRm32(&mut em.code, dstGp, mem) }
  else { drop run X86Encode.movRm64(&mut em.code, dstGp, mem) }
  return ()
}

// Stores exact `sz` bytes (`1, 2, 4, or 8`) from `srcGp` into `mem`.
effect fn storeSmallVecMem(em: &mut Emitter, sz: usize, mem: Mem, srcGp: u8) -> ()
! OutOfMemoryError ? &mut Allocator {
  if sz == 1 { drop run X86Encode.movMr8(&mut em.code, mem, srcGp) }
  else if sz == 2 { drop run X86Encode.movMr16(&mut em.code, mem, srcGp) }
  else if sz == 4 { drop run X86Encode.movMr32(&mut em.code, mem, srcGp) }
  else { drop run X86Encode.movMr64(&mut em.code, mem, srcGp) }
  return ()
}

// Loads a small vector (`storeSize()` in `{1, 2, 4, 8}`) zero-extended into `dstXmm`, avoiding
// 2B-store -> 16B-load STLF hazards. Uses only `scratchGp` when a GP staging move is required.
effect fn loadSmallVecToXmm(em: &mut Emitter, function: &SsaFunction, value: u64, dstXmm: u8, scratchGp: u8) -> ()
! OutOfMemoryError ? &mut Allocator {
  let info = function.value(value)
  let sz = info.kind.storeSize()
  if info.definition != Definition.Constant {
    let off = valOff(&em.*, value)
    if off != 0 {
      if sz == 4 {
        drop run X86Encode.movssRm(&mut em.code, dstXmm, Mem.baseDisp(X86Encode.rbp(), off))
        return ()
      }
      if sz == 8 {
        drop run X86Encode.movsdRm(&mut em.code, dstXmm, Mem.baseDisp(X86Encode.rbp(), off))
        return ()
      }
    }
  }
  run loadSmallVecGp(&mut em.*, function, value, scratchGp)
  if sz == 8 {
    return run X86Encode.movqToXmm(&mut em.code, dstXmm, scratchGp)
  }
  return run X86Encode.movdToXmm(&mut em.code, dstXmm, scratchGp)
}

// Loads the memory address of a vector value into `dstReg` (for constants, materializes the
// repeated-lane byte image into `.rodata` and emits RIP-relative LEA).
effect fn vectorAddr(em: &mut Emitter, function: &SsaFunction, value: u64, dstReg: u8) -> ()
! OutOfMemoryError ? &mut Allocator {
  let info = function.value(value)
  if info.definition == Definition.Constant {
    let c = function.constantOf(value)
    let img = run buildVectorConstantBytes(info.kind, c.low)
    let roOff = run addRodata16(&mut em.*, Bytes.asSlice(&img))
    let dispAt = run X86Encode.lea64(&mut em.code, dstReg, Mem.ripRel(0))
    return run addRodataReloc(&mut em.*, dispAt, roOff)
  }
  let off = valOff(&em.*, value)
  drop run X86Encode.lea64(&mut em.code, dstReg, Mem.baseDisp(X86Encode.rbp(), off))
  return ()
}

effect fn buildVectorConstantBytes(kind: Kind, laneBits: u64) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let sz = kind.storeSize()
  let mut out = run Bytes.zeroed(if sz < 16 { 16 } else { sz })
  let buf = Bytes.asMutSlice(&mut out)
  if kind.bits == 1 {
    // Bit-packed mask vector: element `i` lives at bit `i`.
    if (laneBits & 1) != 0 {
      let mut i = usize.ZERO
      while i < kind.elements {
        let byteIdx = i / 8
        let bitIdx = usize.toU8(i % 8)
        buf[byteIdx] = u8.bitOr(buf[byteIdx], u8.shiftLeft(1, bitIdx))
        i = i + usize.ONE
      }
    }
    return move out
  }
  let elemBytes = kind.elementBytes()
  let mut lane = usize.ZERO
  while lane < kind.elements {
    let mut b = usize.ZERO
    while b < elemBytes {
      buf[lane * elemBytes + b] = u64.wrappingToU8(u64.shiftRight(laneBits, usize.toU64(b * 8)) & 255)
      b = b + usize.ONE
    }
    lane = lane + usize.ONE
  }
  return move out
}

// Masks `reg` to `bits` bits (zero-extending when `!signed`, sign-extending when `signed`).
effect fn normalizeInt(em: &mut Emitter, reg: u8, bits: usize, signed: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  if bits >= 64 { return () }
  if signed {
    if bits == 8 { return run X86Encode.movsxRr8(&mut em.code, reg, reg) }
    if bits == 16 { return run X86Encode.movsxRr16(&mut em.code, reg, reg) }
    if bits == 32 { return run X86Encode.movsxdRr(&mut em.code, reg, reg) }
    let shift = usize.toU8(64 - bits)
    run X86Encode.shiftImm64(&mut em.code, Shift.Shl, reg, shift)
    return run X86Encode.shiftImm64(&mut em.code, Shift.Sar, reg, shift)
  }
  if bits == 1 { return run X86Encode.aluRi32(&mut em.code, Alu.And, reg, 1) }
  if bits == 8 { return run X86Encode.movzxRr8(&mut em.code, reg, reg) }
  if bits == 16 { return run X86Encode.movzxRr16(&mut em.code, reg, reg) }
  if bits == 32 { return run X86Encode.movRr32(&mut em.code, reg, reg) }
  let shift = usize.toU8(64 - bits)
  run X86Encode.shiftImm64(&mut em.code, Shift.Shl, reg, shift)
  return run X86Encode.shiftImm64(&mut em.code, Shift.Shr, reg, shift)
}

fn maskBits(value: u64, bits: usize) -> u64 {
  if bits == usize.ZERO || bits >= 64 { return value }
  return value & (u64.shiftLeft(1, usize.toU64(bits)) - 1)
}

// ---- Instruction Dispatch ----

effect fn emitInstruction(em: &mut Emitter, function: &SsaFunction, instIdx: usize) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let inst = function.instruction(instIdx)
  let ops = function.operandsOf(instIdx)
  match inst.operation {
    Operation.SlotStart {..} => { return () }
    Operation.SlotEnd {..} => { return () }
    Operation.VaEnd => { return () }
    Operation.VaStart => { return run emitVaStart(&mut em.*, function, ops[0]) }
    Operation.SlotAddress {slot} => {
      if valSlotBase(&em.*, inst.result) != 0 { return () }
      let sOff = slotOff(&em.*, slot)
      let dst = dstRegOrScratch(&em.*, inst.result, X86Encode.rax())
      drop run X86Encode.lea64(&mut em.code, dst, Mem.baseDisp(X86Encode.rbp(), sOff))
      return run storeGp(&mut em.*, inst.result, dst)
    }
    Operation.FrameAddress => {
      return run storeGp(&mut em.*, inst.result, X86Encode.rbp())
    }
    Operation.DynamicSlot {alignment} => {
      return run emitDynamicSlot(&mut em.*, function, ops[0], alignment, inst.result)
    }
    Operation.Offset {offset} => {
      if valSlotBase(&em.*, inst.result) != 0 || foldedAddrKind(&em.*, inst.result) != 0 { return () }
      let dst = dstRegOrScratch(&em.*, inst.result, X86Encode.rax())
      if offset == 0 {
        run loadGp(&mut em.*, function, ops[0], dst)
        return run storeGp(&mut em.*, inst.result, dst)
      }
      let signed = u64.wrappingToI64(offset)
      if signed >= -2147483648 && signed <= 2147483647 {
        let base = run regOrLoad(&mut em.*, function, ops[0], X86Encode.rax())
        drop run X86Encode.lea64(&mut em.code, dst, Mem.baseDisp(base, i64.wrappingToI32(signed)))
        return run storeGp(&mut em.*, inst.result, dst)
      }
      run loadGp(&mut em.*, function, ops[0], X86Encode.rax())
      run X86Encode.movImm64(&mut em.code, X86Encode.r11(), offset)
      run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.rax(), X86Encode.r11())
      return run storeGp(&mut em.*, inst.result, X86Encode.rax())
    }
    Operation.Index => {
      if valSlotBase(&em.*, inst.result) != 0 || foldedAddrKind(&em.*, inst.result) != 0 { return () }
      let idxBits = function.value(ops[1]).kind.bits
      if idxBits == 64 {
        let dst = dstRegOrScratch(&em.*, inst.result, X86Encode.rax())
        let imm = constBitsImm32(function, ops[1], 64)
        if imm.ok {
          let base = run regOrLoad(&mut em.*, function, ops[0], X86Encode.rax())
          if imm.value == 0 {
            if dst != base { run X86Encode.movRr64(&mut em.code, dst, base) }
          } else {
            drop run X86Encode.lea64(&mut em.code, dst, Mem.baseDisp(base, imm.value))
          }
          return run storeGp(&mut em.*, inst.result, dst)
        }
        let base = run regOrLoad(&mut em.*, function, ops[0], X86Encode.rax())
        let idx = run regOrLoad(&mut em.*, function, ops[1], X86Encode.r11())
        drop run X86Encode.lea64(&mut em.code, dst, Mem.baseIndex(base, idx, 1, 0))
        return run storeGp(&mut em.*, inst.result, dst)
      }
      run loadGp(&mut em.*, function, ops[0], X86Encode.rax())
      run loadGp(&mut em.*, function, ops[1], X86Encode.r11())
      run normalizeInt(&mut em.*, X86Encode.r11(), idxBits, false)
      run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.rax(), X86Encode.r11())
      return run storeGp(&mut em.*, inst.result, X86Encode.rax())
    }
    Operation.Load {offset, ..} => {
      if fusedLoadBytes(&em.*, inst.result) != 0 { return () }
      return run emitLoad(&mut em.*, function, ops[0], offset, inst.kind, inst.result)
    }
    Operation.Store {offset, ..} => {
      return run emitStore(&mut em.*, function, ops[0], ops[1], offset)
    }
    Operation.CopyBytes {size} => {
      return run emitCopyBytes(&mut em.*, function, ops[0], ops[1], size)
    }
    Operation.Fill {byte, size} => {
      return run emitFill(&mut em.*, function, ops[0], byte, size)
    }
    Operation.CopyCounted => {
      return run emitCopyCounted(&mut em.*, function, ops[0], ops[1], ops[2])
    }
    Operation.FillCounted => {
      return run emitFillCounted(&mut em.*, function, ops[0], ops[1], ops[2])
    }
    Operation.Binary {operation} => {
      if foldedAddrKind(&em.*, inst.result) != 0 { return () }
      return run emitBinary(&mut em.*, function, operation, inst.kind, ops[0], ops[1], inst.result)
    }
    Operation.Negate => {
      return run emitNegate(&mut em.*, function, inst.kind, ops[0], inst.result)
    }
    Operation.Compare {predicate} => {
      return run emitCompare(&mut em.*, function, predicate, ops[0], ops[1], inst.result)
    }
    Operation.Select => {
      return run emitSelect(&mut em.*, function, inst.kind, ops[0], ops[1], ops[2], inst.result)
    }
    Operation.Cast {operation} => {
      if operation == Cast.Trunc && isFusedTrunc(&em.*, inst.result) { return () }
      return run emitCast(&mut em.*, function, operation, inst.kind, ops[0], inst.result)
    }
    Operation.Overflow {operation, signed} => {
      return run emitOverflow(&mut em.*, function, operation, signed, inst.kind, ops[0], ops[1], inst.result)
    }
    Operation.Saturate {operation, signed} => {
      return run emitSaturate(&mut em.*, function, operation, signed, inst.kind, ops[0], ops[1], inst.result)
    }
    Operation.Rotate {left} => {
      return run emitRotate(&mut em.*, function, left, inst.kind, ops[0], ops[1], inst.result)
    }
    Operation.Count {which} => {
      return run emitCount(&mut em.*, function, which, inst.kind, ops[0], inst.result)
    }
    Operation.Extreme {which} => {
      return run emitExtreme(&mut em.*, function, which, inst.kind, ops[0], ops[1], inst.result)
    }
    Operation.FusedMultiplyAdd => {
      return run emitFma(&mut em.*, function, inst.kind, ops[0], ops[1], ops[2], inst.result)
    }
    Operation.SquareRoot => {
      return run emitSqrt(&mut em.*, function, inst.kind, ops[0], inst.result)
    }
    Operation.Splat {..} => {
      return run emitSplat(&mut em.*, function, inst.kind, ops[0], inst.result)
    }
    Operation.Extract => {
      return run emitExtract(&mut em.*, function, inst.kind, ops[0], ops[1], inst.result)
    }
    Operation.Insert => {
      return run emitInsert(&mut em.*, function, inst.kind, ops[0], ops[1], ops[2], inst.result)
    }
    Operation.Shuffle {start, count} => {
      return run emitShuffle(&mut em.*, function, inst.kind, ops[0], ops[1], start, count, inst.result)
    }
    Operation.Reduce {which} => {
      let init = if ops.length >= 2 { ops[1] } else { none() }
      return run emitReduce(&mut em.*, function, which, inst.kind, ops[0], init, inst.result)
    }
    Operation.ArchIntrinsic {operation, immediate} => {
      return run emitArchIntrinsic(&mut em.*, function, operation, immediate, inst.kind, ops, inst.result)
    }
    Operation.InlineAsm {index, ..} => {
      return run emitInlineAsm(&mut em.*, function, index, inst.kind, ops, inst.result)
    }
    Operation.Call {symbol, fixed, abi} => {
      return run emitCall(&mut em.*, function, instIdx, symbol, false, fixed, abi, inst, ops)
    }
    Operation.CallIndirect {abi} => {
      return run emitCall(&mut em.*, function, instIdx, usize.MAX, true, usize.MAX, abi, inst, ops)
    }
    Operation.AtomicLoad => {
      return run emitAtomicLoad(&mut em.*, function, inst.kind, ops[0], inst.result)
    }
    Operation.AtomicStore => {
      return run emitAtomicStore(&mut em.*, function, ops[0], ops[1])
    }
    Operation.AtomicModify {which} => {
      return run emitAtomicModify(&mut em.*, function, which, inst.kind, ops[0], ops[1], inst.result)
    }
    Operation.CompareExchange => {
      return run emitCompareExchange(&mut em.*, function, inst.kind, ops[0], ops[1], ops[2], inst.result)
    }
    Operation.Fence => {
      return run X86Encode.mfence(&mut em.code)
    }
    _ => {
      return run X86Object.unsupported(b"wasm-only operation on x86-64", Bytes.asSlice(&em.symbol))
    }
  }
}

// ---- Memory Operations ----

effect fn emitAddrWithOffset(em: &mut Emitter, function: &SsaFunction, addrVal: u64, offset: u64, dstReg: u8) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  run loadGp(&mut em.*, function, addrVal, dstReg)
  if offset != 0 {
    let signed = u64.wrappingToI64(offset)
    if signed >= -2147483648 && signed <= 2147483647 {
      run X86Encode.aluRi64(&mut em.code, Alu.Add, dstReg, i64.wrappingToI32(signed))
    } else {
      let tmp = if dstReg == X86Encode.r11() { X86Encode.r10() } else { X86Encode.r11() }
      run X86Encode.movImm64(&mut em.code, tmp, offset)
      run X86Encode.aluRr64(&mut em.code, Alu.Add, dstReg, tmp)
    }
  }
  return ()
}

// Builds a `Mem.baseDisp(baseReg, disp)` addressing mode directly when `offset` fits in `i32`
// (reusing `addrVal`'s callee-saved GPR with zero extra instructions), falling back to
// `emitAddrWithOffset` into `scratchReg` otherwise.
effect fn resolveAddrMem(em: &mut Emitter, function: &SsaFunction, addrVal: u64, offset: u64, scratchReg: u8) -> Mem
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let sb = valSlotBase(&em.*, addrVal)
  let offI64 = u64.wrappingToI64(offset)
  if sb != 0 && offI64 >= -2147483648 && offI64 <= 2147483647 {
    let total = i32.toI64(sb) + offI64
    if total >= -2147483648 && total <= 2147483647 {
      return Mem.baseDisp(X86Encode.rbp(), i64.wrappingToI32(total))
    }
  }
  let fk = foldedAddrKind(&em.*, addrVal)
  if (fk == 1 || fk == 2) && offI64 >= -1073741824 && offI64 <= 1073741824 {
    let disp = foldedAddrDisp(&em.*, addrVal)
    let total = i32.toI64(disp) + offI64
    if total >= -2147483648 && total <= 2147483647 {
      let baseVal = foldedAddrBase(&em.*, addrVal)
      let bsb = valSlotBase(&em.*, baseVal)
      if fk == 1 {
        if bsb != 0 {
          let t2 = i32.toI64(bsb) + total
          if t2 >= -2147483648 && t2 <= 2147483647 {
            return Mem.baseDisp(X86Encode.rbp(), i64.wrappingToI32(t2))
          }
        }
        let baseReg = run regOrLoad(&mut em.*, function, baseVal, scratchReg)
        return Mem.baseDisp(baseReg, i64.wrappingToI32(total))
      }
      // fk == 2: BaseIndex `[base + index*scale + total]`.
      // Resolve `base` FIRST into `scratchReg` (`r11`), `index` SECOND into `scratchIdx` (`r10`).
      let idxVal = foldedAddrIndex(&em.*, addrVal)
      let scale = foldedAddrScale(&em.*, addrVal)
      let scratchIdx = if scratchReg == X86Encode.r11() { X86Encode.r10() } else { X86Encode.r11() }
      if bsb != 0 {
        let t2 = i32.toI64(bsb) + total
        if t2 >= -2147483648 && t2 <= 2147483647 {
          let idxReg = run regOrLoad(&mut em.*, function, idxVal, scratchIdx)
          return Mem.baseIndex(X86Encode.rbp(), idxReg, scale, i64.wrappingToI32(t2))
        }
      }
      let baseReg = run regOrLoad(&mut em.*, function, baseVal, scratchReg)
      let idxReg = run regOrLoad(&mut em.*, function, idxVal, scratchIdx)
      return Mem.baseIndex(baseReg, idxReg, scale, i64.wrappingToI32(total))
    }
  }
  if offI64 >= -2147483648 && offI64 <= 2147483647 {
    let base = run regOrLoad(&mut em.*, function, addrVal, scratchReg)
    return Mem.baseDisp(base, i64.wrappingToI32(offI64))
  }
  run emitAddrWithOffset(&mut em.*, function, addrVal, offset, scratchReg)
  return Mem.baseDisp(scratchReg, 0)
}

effect fn emitLoad(em: &mut Emitter, function: &SsaFunction, addrVal: u64, offset: u64, kind: Kind, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if kind.isVector() {
    let sz = kind.storeSize()
    if sz == usize.ZERO { return () }
    let dstXmm = valXmm(&em.*, result)
    let dstOff = valOff(&em.*, result)
    if dstXmm == X86Frame.regNone() && dstOff == 0 { return () }
    if sz == 16 {
      let mem = run resolveAddrMem(&mut em.*, function, addrVal, offset, X86Encode.r11())
      let targetXmm = if dstXmm != X86Frame.regNone() { dstXmm } else { 0 }
      drop run X86Encode.movdquRm(&mut em.code, targetXmm, mem)
      if dstXmm == X86Frame.regNone() {
        drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff), 0)
      }
      return ()
    }
    if sz == 32 {
      if hasFeat(&em.*, X86Frame.featAvx2()) && kind.isInteger() {
        let mem = run resolveAddrMem(&mut em.*, function, addrVal, offset, X86Encode.r11())
        let targetYmm = if dstXmm != X86Frame.regNone() { dstXmm } else { 0 }
        drop run X86Encode.vmovdquYmmRm(&mut em.code, targetYmm, mem)
        if dstXmm == X86Frame.regNone() {
          drop run X86Encode.vmovdquYmmMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff), 0)
        }
        return ()
      }
      run emitAddrWithOffset(&mut em.*, function, addrVal, offset, X86Encode.r11())
      drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(X86Encode.r11(), 0))
      drop run X86Encode.movdquRm(&mut em.code, 1, Mem.baseDisp(X86Encode.r11(), 16))
      drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff), 0)
      drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff + 16), 1)
      return ()
    }
    if sz == 1 || sz == 2 || sz == 4 || sz == 8 {
      let mem = run resolveAddrMem(&mut em.*, function, addrVal, offset, X86Encode.r11())
      if sz == 1 { drop run X86Encode.movzxRm8(&mut em.code, X86Encode.rax(), mem) }
      else if sz == 2 { drop run X86Encode.movzxRm16(&mut em.code, X86Encode.rax(), mem) }
      else if sz == 4 { drop run X86Encode.movRm32(&mut em.code, X86Encode.rax(), mem) }
      else { drop run X86Encode.movRm64(&mut em.code, X86Encode.rax(), mem) }
      return run storeSmallVecMem(&mut em.*, sz, Mem.baseDisp(X86Encode.rbp(), dstOff), X86Encode.rax())
    }
    run emitAddrWithOffset(&mut em.*, function, addrVal, offset, X86Encode.rsi())
    // Copy exact `sz` bytes from `[rsi]` into `[rbp + dstOff]`.
    drop run X86Encode.lea64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rbp(), dstOff))
    run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), usize.toU64(sz))
    return run X86Encode.repMovsb(&mut em.code)
  }
  if kind.isFloat() {
    let mem = run resolveAddrMem(&mut em.*, function, addrVal, offset, X86Encode.r11())
    let targetXmm = dstXmmOrScratch(&em.*, result, 0)
    if kind.bits == 64 {
      drop run X86Encode.movsdRm(&mut em.code, targetXmm, mem)
      return run storeFloat(&mut em.*, result, targetXmm, true)
    }
    drop run X86Encode.movssRm(&mut em.code, targetXmm, mem)
    return run storeFloat(&mut em.*, result, targetXmm, false)
  }
  if kind.bits > 64 {
    run emitAddrWithOffset(&mut em.*, function, addrVal, offset, X86Encode.rsi())
    drop run X86Encode.movRm64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rsi(), 0))
    drop run X86Encode.movRm64(&mut em.code, X86Encode.rdx(), Mem.baseDisp(X86Encode.rsi(), 8))
    return run storePair(&mut em.*, result, X86Encode.rax(), X86Encode.rdx())
  }
  let mem = run resolveAddrMem(&mut em.*, function, addrVal, offset, X86Encode.r11())
  let dst = dstRegOrScratch(&em.*, result, X86Encode.rax())
  let bytes = kind.elementBytes()
  if bytes == 1 {
    drop run X86Encode.movzxRm8(&mut em.code, dst, mem)
    if kind.bits == 1 { run X86Encode.aluRi32(&mut em.code, Alu.And, dst, 1) }
  } else if bytes == 2 {
    drop run X86Encode.movzxRm16(&mut em.code, dst, mem)
  } else if bytes == 4 {
    drop run X86Encode.movRm32(&mut em.code, dst, mem)
  } else {
    drop run X86Encode.movRm64(&mut em.code, dst, mem)
  }
  return run storeGp(&mut em.*, result, dst)
}

effect fn emitStore(em: &mut Emitter, function: &SsaFunction, val: u64, addrVal: u64, offset: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let kind = function.value(val).kind
  if kind.isVector() {
    let sz = kind.storeSize()
    if sz == usize.ZERO { return () }
    if sz == 16 {
      let mem = run resolveAddrMem(&mut em.*, function, addrVal, offset, X86Encode.r11())
      let srcXmm = run xmmOrLoadVec128(&mut em.*, function, val, 0)
      drop run X86Encode.movdquMr(&mut em.code, mem, srcXmm)
      return ()
    }
    if sz == 32 {
      if hasFeat(&em.*, X86Frame.featAvx2()) && kind.isInteger() {
        let mem = run resolveAddrMem(&mut em.*, function, addrVal, offset, X86Encode.r11())
        let srcYmm = run ymmOrLoadVec256(&mut em.*, function, val, 0)
        drop run X86Encode.vmovdquYmmMr(&mut em.code, mem, srcYmm)
        return ()
      }
      run emitAddrWithOffset(&mut em.*, function, addrVal, offset, X86Encode.r11())
      run vectorAddr(&mut em.*, function, val, X86Encode.r10())
      drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(X86Encode.r10(), 0))
      drop run X86Encode.movdquRm(&mut em.code, 1, Mem.baseDisp(X86Encode.r10(), 16))
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(X86Encode.r11(), 0), 0)
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(X86Encode.r11(), 16), 1)
      return ()
    }
    if sz == 1 || sz == 2 || sz == 4 || sz == 8 {
      let mem = run resolveAddrMem(&mut em.*, function, addrVal, offset, X86Encode.r11())
      run loadSmallVecGp(&mut em.*, function, val, X86Encode.rax())
      return run storeSmallVecMem(&mut em.*, sz, mem, X86Encode.rax())
    }
    run emitAddrWithOffset(&mut em.*, function, addrVal, offset, X86Encode.rdi())
    run vectorAddr(&mut em.*, function, val, X86Encode.rsi())
    run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), usize.toU64(sz))
    return run X86Encode.repMovsb(&mut em.code)
  }
  if kind.isFloat() {
    let mem = run resolveAddrMem(&mut em.*, function, addrVal, offset, X86Encode.r11())
    let homeXmm = if function.value(val).definition != Definition.Constant { valXmm(&em.*, val) } else { X86Frame.regNone() }
    let srcXmm = if homeXmm != X86Frame.regNone() { homeXmm } else { 0 }
    if homeXmm == X86Frame.regNone() {
      run loadFloat(&mut em.*, function, val, 0, X86Encode.rax())
    }
    if kind.bits == 64 {
      drop run X86Encode.movsdMr(&mut em.code, mem, srcXmm)
    } else {
      drop run X86Encode.movssMr(&mut em.code, mem, srcXmm)
    }
    return ()
  }
  if kind.bits > 64 {
    run emitAddrWithOffset(&mut em.*, function, addrVal, offset, X86Encode.rdi())
    run loadPair(&mut em.*, function, val, X86Encode.rax(), X86Encode.rdx())
    drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rdi(), 0), X86Encode.rax())
    drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rdi(), 8), X86Encode.rdx())
    return ()
  }
  let bytes = kind.elementBytes()
  if isFusedCallStore(&em.*, val) {
    let mem = run resolveAddrMem(&mut em.*, function, addrVal, offset, X86Encode.r11())
    if bytes == 1 {
      drop run X86Encode.movMr8(&mut em.code, mem, X86Encode.rax())
    } else if bytes == 2 {
      drop run X86Encode.movMr16(&mut em.code, mem, X86Encode.rax())
    } else if bytes == 4 {
      drop run X86Encode.movMr32(&mut em.code, mem, X86Encode.rax())
    } else {
      drop run X86Encode.movMr64(&mut em.code, mem, X86Encode.rax())
    }
    return ()
  }
  if bytes == 8 {
    let imm = constBitsImm32(function, val, 64)
    if imm.ok {
      let mem = run resolveAddrMem(&mut em.*, function, addrVal, offset, X86Encode.r11())
      drop run X86Encode.movMi64(&mut em.code, mem, imm.value)
      return ()
    }
  } else if bytes == 4 {
    let imm = constBitsImm32(function, val, 32)
    if imm.ok {
      let mem = run resolveAddrMem(&mut em.*, function, addrVal, offset, X86Encode.r11())
      drop run X86Encode.movMi32(&mut em.code, mem, i32.wrappingToU64(imm.value) & 0xFFFFFFFF)
      return ()
    }
  } else if bytes == 1 && function.isBits(val) {
    let mem = run resolveAddrMem(&mut em.*, function, addrVal, offset, X86Encode.r11())
    let imm8 = u64.wrappingToU8(maskBits(function.constantOf(val).low, kind.bits))
    drop run X86Encode.movMi8(&mut em.code, mem, imm8)
    return ()
  }
  // Load `srcReg` into `rax` (or home GPR) BEFORE `resolveAddrMem` so `ConstantForm.Symbol`/
  // `ThreadLocal` with large offsets using `r11` scratch never clobber `mem`'s base register.
  if bytes == 1 && kind.bits == 1 && !isKnownBool(&em.*, val) {
    run loadGp(&mut em.*, function, val, X86Encode.rax())
    run X86Encode.aluRi32(&mut em.code, Alu.And, X86Encode.rax(), 1)
    let mem = run resolveAddrMem(&mut em.*, function, addrVal, offset, X86Encode.r11())
    drop run X86Encode.movMr8(&mut em.code, mem, X86Encode.rax())
    return ()
  }
  let storeVal = if isFusedTrunc(&em.*, val) { function.operandsOf(function.producerOf(val))[usize.ZERO] } else { val }
  let srcReg = run regOrLoad(&mut em.*, function, storeVal, X86Encode.rax())
  let mem = run resolveAddrMem(&mut em.*, function, addrVal, offset, X86Encode.r11())
  if bytes == 1 {
    drop run X86Encode.movMr8(&mut em.code, mem, srcReg)
  } else if bytes == 2 {
    drop run X86Encode.movMr16(&mut em.code, mem, srcReg)
  } else if bytes == 4 {
    drop run X86Encode.movMr32(&mut em.code, mem, srcReg)
  } else {
    drop run X86Encode.movMr64(&mut em.code, mem, srcReg)
  }
  return ()
}

effect fn emitDynamicSlot(em: &mut Emitter, function: &SsaFunction, sizeVal: u64, alignment: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let align = if alignment < 16 { 16 } else { alignment }
  run loadGp(&mut em.*, function, sizeVal, X86Encode.rax())
  // Round size up to multiple of `align` (power of 2 >= 16).
  run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), align - 1)
  run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.rax(), X86Encode.rcx())
  run X86Encode.not64(&mut em.code, X86Encode.rcx())
  run X86Encode.aluRr64(&mut em.code, Alu.And, X86Encode.rax(), X86Encode.rcx())
  run X86Encode.aluRr64(&mut em.code, Alu.Sub, X86Encode.rsp(), X86Encode.rax())
  if align > 16 {
    run X86Encode.aluRr64(&mut em.code, Alu.And, X86Encode.rsp(), X86Encode.rcx())
  }
  return run storeGp(&mut em.*, result, X86Encode.rsp())
}

effect fn emitCopyBytes(em: &mut Emitter, function: &SsaFunction, dstVal: u64, srcVal: u64, size: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if size == 0 { return () }
  if size <= 64 {
    // Load all bytes into scratch regs (`rax, rcx, xmm0..xmm3`) BEFORE emitting any stores so
    // arbitrary overlapping `src`/`dst` regions are 100% `memmove`-exact, and never clobber
    // caller-saved GPRs (`rdi, rsi, r8, r9`) or XMMs (`xmm4..xmm15`).
    let dstSb = valSlotBase(&em.*, dstVal)
    let dstBase = if dstSb != 0 { X86Encode.rbp() } else { run regOrLoad(&mut em.*, function, dstVal, X86Encode.r11()) }
    let dstDisp: i32 = if dstSb != 0 { dstSb } else { 0 }
    let srcSb = valSlotBase(&em.*, srcVal)
    let srcBase = if srcSb != 0 { X86Encode.rbp() } else { run regOrLoad(&mut em.*, function, srcVal, X86Encode.r10()) }
    let srcDisp: i32 = if srcSb != 0 { srcSb } else { 0 }
    let s = u64.wrappingToI32(size)
    if size == 1 {
      drop run X86Encode.movzxRm8(&mut em.code, X86Encode.rax(), Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movMr8(&mut em.code, Mem.baseDisp(dstBase, dstDisp), X86Encode.rax())
      return ()
    }
    if size == 2 {
      drop run X86Encode.movzxRm16(&mut em.code, X86Encode.rax(), Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movMr16(&mut em.code, Mem.baseDisp(dstBase, dstDisp), X86Encode.rax())
      return ()
    }
    if size == 3 {
      drop run X86Encode.movzxRm16(&mut em.code, X86Encode.rax(), Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movzxRm8(&mut em.code, X86Encode.rcx(), Mem.baseDisp(srcBase, srcDisp + 2))
      drop run X86Encode.movMr16(&mut em.code, Mem.baseDisp(dstBase, dstDisp), X86Encode.rax())
      drop run X86Encode.movMr8(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 2), X86Encode.rcx())
      return ()
    }
    if size == 4 {
      drop run X86Encode.movRm32(&mut em.code, X86Encode.rax(), Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movMr32(&mut em.code, Mem.baseDisp(dstBase, dstDisp), X86Encode.rax())
      return ()
    }
    if size == 5 {
      drop run X86Encode.movRm32(&mut em.code, X86Encode.rax(), Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movzxRm8(&mut em.code, X86Encode.rcx(), Mem.baseDisp(srcBase, srcDisp + 4))
      drop run X86Encode.movMr32(&mut em.code, Mem.baseDisp(dstBase, dstDisp), X86Encode.rax())
      drop run X86Encode.movMr8(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 4), X86Encode.rcx())
      return ()
    }
    if size == 6 {
      drop run X86Encode.movRm32(&mut em.code, X86Encode.rax(), Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movzxRm16(&mut em.code, X86Encode.rcx(), Mem.baseDisp(srcBase, srcDisp + 4))
      drop run X86Encode.movMr32(&mut em.code, Mem.baseDisp(dstBase, dstDisp), X86Encode.rax())
      drop run X86Encode.movMr16(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 4), X86Encode.rcx())
      return ()
    }
    if size == 7 {
      drop run X86Encode.movRm32(&mut em.code, X86Encode.rax(), Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movRm32(&mut em.code, X86Encode.rcx(), Mem.baseDisp(srcBase, srcDisp + 3))
      drop run X86Encode.movMr32(&mut em.code, Mem.baseDisp(dstBase, dstDisp), X86Encode.rax())
      drop run X86Encode.movMr32(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 3), X86Encode.rcx())
      return ()
    }
    if size == 8 {
      drop run X86Encode.movRm64(&mut em.code, X86Encode.rax(), Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(dstBase, dstDisp), X86Encode.rax())
      return ()
    }
    if size == 9 {
      drop run X86Encode.movRm64(&mut em.code, X86Encode.rax(), Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movzxRm8(&mut em.code, X86Encode.rcx(), Mem.baseDisp(srcBase, srcDisp + 8))
      drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(dstBase, dstDisp), X86Encode.rax())
      drop run X86Encode.movMr8(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 8), X86Encode.rcx())
      return ()
    }
    if size == 10 {
      drop run X86Encode.movRm64(&mut em.code, X86Encode.rax(), Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movzxRm16(&mut em.code, X86Encode.rcx(), Mem.baseDisp(srcBase, srcDisp + 8))
      drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(dstBase, dstDisp), X86Encode.rax())
      drop run X86Encode.movMr16(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 8), X86Encode.rcx())
      return ()
    }
    if size == 12 {
      drop run X86Encode.movRm64(&mut em.code, X86Encode.rax(), Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movRm32(&mut em.code, X86Encode.rcx(), Mem.baseDisp(srcBase, srcDisp + 8))
      drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(dstBase, dstDisp), X86Encode.rax())
      drop run X86Encode.movMr32(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 8), X86Encode.rcx())
      return ()
    }
    if size < 16 {
      drop run X86Encode.movRm64(&mut em.code, X86Encode.rax(), Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movRm64(&mut em.code, X86Encode.rcx(), Mem.baseDisp(srcBase, srcDisp + s - 8))
      drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(dstBase, dstDisp), X86Encode.rax())
      drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(dstBase, dstDisp + s - 8), X86Encode.rcx())
      return ()
    }
    if size == 16 {
      drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp), 0)
      return ()
    }
    if size == 17 {
      drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movzxRm8(&mut em.code, X86Encode.rax(), Mem.baseDisp(srcBase, srcDisp + 16))
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp), 0)
      drop run X86Encode.movMr8(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 16), X86Encode.rax())
      return ()
    }
    if size == 18 {
      drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movzxRm16(&mut em.code, X86Encode.rax(), Mem.baseDisp(srcBase, srcDisp + 16))
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp), 0)
      drop run X86Encode.movMr16(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 16), X86Encode.rax())
      return ()
    }
    if size == 20 {
      drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movRm32(&mut em.code, X86Encode.rax(), Mem.baseDisp(srcBase, srcDisp + 16))
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp), 0)
      drop run X86Encode.movMr32(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 16), X86Encode.rax())
      return ()
    }
    if size == 24 {
      drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movRm64(&mut em.code, X86Encode.rax(), Mem.baseDisp(srcBase, srcDisp + 16))
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp), 0)
      drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 16), X86Encode.rax())
      return ()
    }
    if size <= 32 {
      drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movdquRm(&mut em.code, 1, Mem.baseDisp(srcBase, srcDisp + s - 16))
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp), 0)
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + s - 16), 1)
      return ()
    }
    if size == 40 {
      drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movdquRm(&mut em.code, 1, Mem.baseDisp(srcBase, srcDisp + 16))
      drop run X86Encode.movRm64(&mut em.code, X86Encode.rax(), Mem.baseDisp(srcBase, srcDisp + 32))
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp), 0)
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 16), 1)
      drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 32), X86Encode.rax())
      return ()
    }
    if size <= 48 {
      drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movdquRm(&mut em.code, 1, Mem.baseDisp(srcBase, srcDisp + 16))
      drop run X86Encode.movdquRm(&mut em.code, 2, Mem.baseDisp(srcBase, srcDisp + s - 16))
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp), 0)
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 16), 1)
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + s - 16), 2)
      return ()
    }
    if size == 56 {
      drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(srcBase, srcDisp))
      drop run X86Encode.movdquRm(&mut em.code, 1, Mem.baseDisp(srcBase, srcDisp + 16))
      drop run X86Encode.movdquRm(&mut em.code, 2, Mem.baseDisp(srcBase, srcDisp + 32))
      drop run X86Encode.movRm64(&mut em.code, X86Encode.rax(), Mem.baseDisp(srcBase, srcDisp + 48))
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp), 0)
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 16), 1)
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 32), 2)
      drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 48), X86Encode.rax())
      return ()
    }
    drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(srcBase, srcDisp))
    drop run X86Encode.movdquRm(&mut em.code, 1, Mem.baseDisp(srcBase, srcDisp + 16))
    drop run X86Encode.movdquRm(&mut em.code, 2, Mem.baseDisp(srcBase, srcDisp + 32))
    drop run X86Encode.movdquRm(&mut em.code, 3, Mem.baseDisp(srcBase, srcDisp + s - 16))
    drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp), 0)
    drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 16), 1)
    drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 32), 2)
    drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + s - 16), 3)
    return ()
  }
  if size <= 2048 {
    let dstSb = valSlotBase(&em.*, dstVal)
    let srcSb = valSlotBase(&em.*, srcVal)
    if dstSb != 0 {
      drop run X86Encode.lea64(&mut em.code, X86Encode.r10(), Mem.baseDisp(X86Encode.rbp(), dstSb))
    } else {
      run loadGp(&mut em.*, function, dstVal, X86Encode.r10())
    }
    if srcSb != 0 {
      drop run X86Encode.lea64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rbp(), srcSb))
    } else {
      run loadGp(&mut em.*, function, srcVal, X86Encode.r11())
    }
    let chunks16 = size / 16
    let rem = size % 16
    run X86Encode.aluRr64(&mut em.code, Alu.Cmp, X86Encode.r10(), X86Encode.r11())
    let toBwd = run emitJcc(&mut em.*, X86Encode.ccA())
    // Forward path (`dst <= src`).
    run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), chunks16)
    let fwdStart = Bytes.length(&em.code)
    drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(X86Encode.r11(), 0))
    drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(X86Encode.r10(), 0), 0)
    run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r11(), 16)
    run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r10(), 16)
    run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rcx(), 1)
    let fwdBack = run emitJcc(&mut em.*, X86Encode.ccNe())
    patchTo(&mut em.*, fwdBack, fwdStart)
    if rem != 0 {
      let backDisp = u64.wrappingToI32(rem) - 16
      drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(X86Encode.r11(), backDisp))
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(X86Encode.r10(), backDisp), 0)
    }
    let toDone = run emitJmp(&mut em.*)
    // Backward path (`dst > src`).
    patchHere(&mut em.*, toBwd)
    let endOff = u64.wrappingToI32(size - 16)
    run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r11(), endOff)
    run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r10(), endOff)
    run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), chunks16)
    let bwdStart = Bytes.length(&em.code)
    drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(X86Encode.r11(), 0))
    drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(X86Encode.r10(), 0), 0)
    run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.r11(), 16)
    run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.r10(), 16)
    run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rcx(), 1)
    let bwdBack = run emitJcc(&mut em.*, X86Encode.ccNe())
    patchTo(&mut em.*, bwdBack, bwdStart)
    if rem != 0 {
      let fwdDisp = 16 - u64.wrappingToI32(rem)
      drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(X86Encode.r11(), fwdDisp))
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(X86Encode.r10(), fwdDisp), 0)
    }
    patchHere(&mut em.*, toDone)
    return ()
  }
  // Use `memmove` to guarantee overlapping-copy safety per `SsaFunction` specification.
  run loadGp(&mut em.*, function, dstVal, X86Encode.rdi())
  run loadGp(&mut em.*, function, srcVal, X86Encode.rsi())
  run X86Encode.movImm64(&mut em.code, X86Encode.rdx(), size)
  return run callExternal(&mut em.*, b"memmove")
}

effect fn emitFill(em: &mut Emitter, function: &SsaFunction, dstVal: u64, fillByte: u8, size: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if size == 0 { return () }
  if size <= 64 {
    let dstSb = valSlotBase(&em.*, dstVal)
    let dstBase = if dstSb != 0 { X86Encode.rbp() } else { run regOrLoad(&mut em.*, function, dstVal, X86Encode.r10()) }
    let dstDisp: i32 = if dstSb != 0 { dstSb } else { 0 }
    let b16: u64 = u8.toU64(fillByte) * 0x0101
    let b32: u64 = u8.toU64(fillByte) * 0x01010101
    let b64: u64 = u8.toU64(fillByte) * 0x0101010101010101
    let s = u64.wrappingToI32(size)
    if size == 1 {
      drop run X86Encode.movMi8(&mut em.code, Mem.baseDisp(dstBase, dstDisp), fillByte)
      return ()
    }
    if size == 2 {
      run X86Encode.movImm64(&mut em.code, X86Encode.rax(), b16)
      drop run X86Encode.movMr16(&mut em.code, Mem.baseDisp(dstBase, dstDisp), X86Encode.rax())
      return ()
    }
    if size == 3 {
      run X86Encode.movImm64(&mut em.code, X86Encode.rax(), b16)
      drop run X86Encode.movMr16(&mut em.code, Mem.baseDisp(dstBase, dstDisp), X86Encode.rax())
      drop run X86Encode.movMr8(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 2), X86Encode.rax())
      return ()
    }
    if size == 4 {
      drop run X86Encode.movMi32(&mut em.code, Mem.baseDisp(dstBase, dstDisp), b32)
      return ()
    }
    if size == 5 {
      drop run X86Encode.movMi32(&mut em.code, Mem.baseDisp(dstBase, dstDisp), b32)
      drop run X86Encode.movMi8(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 4), fillByte)
      return ()
    }
    if size == 6 {
      run X86Encode.movImm64(&mut em.code, X86Encode.rax(), b32)
      drop run X86Encode.movMr32(&mut em.code, Mem.baseDisp(dstBase, dstDisp), X86Encode.rax())
      drop run X86Encode.movMr16(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 4), X86Encode.rax())
      return ()
    }
    if size == 7 {
      drop run X86Encode.movMi32(&mut em.code, Mem.baseDisp(dstBase, dstDisp), b32)
      drop run X86Encode.movMi32(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 3), b32)
      return ()
    }
    if size == 8 {
      if fillByte == 0 || fillByte == 0xFF {
        let imm64: i32 = if fillByte == 0 { 0 } else { -1 }
        drop run X86Encode.movMi64(&mut em.code, Mem.baseDisp(dstBase, dstDisp), imm64)
        return ()
      }
      run X86Encode.movImm64(&mut em.code, X86Encode.rax(), b64)
      drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(dstBase, dstDisp), X86Encode.rax())
      return ()
    }
    if size < 16 {
      if fillByte == 0 || fillByte == 0xFF {
        let imm64: i32 = if fillByte == 0 { 0 } else { -1 }
        drop run X86Encode.movMi64(&mut em.code, Mem.baseDisp(dstBase, dstDisp), imm64)
        if size == 9 {
          drop run X86Encode.movMi8(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 8), fillByte)
        } else if size == 12 {
          drop run X86Encode.movMi32(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 8), b32)
        } else {
          drop run X86Encode.movMi64(&mut em.code, Mem.baseDisp(dstBase, dstDisp + s - 8), imm64)
        }
        return ()
      }
      run X86Encode.movImm64(&mut em.code, X86Encode.rax(), b64)
      drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(dstBase, dstDisp), X86Encode.rax())
      if size == 9 {
        drop run X86Encode.movMr8(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 8), X86Encode.rax())
      } else if size == 10 {
        drop run X86Encode.movMr16(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 8), X86Encode.rax())
      } else if size == 12 {
        drop run X86Encode.movMr32(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 8), X86Encode.rax())
      } else {
        drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(dstBase, dstDisp + s - 8), X86Encode.rax())
      }
      return ()
    }
    // 16..64 bytes: broadcast pattern into `xmm0` and emit unaligned SSE2 stores.
    if fillByte == 0 {
      run X86Encode.pxor(&mut em.code, 0, 0)
    } else {
      run X86Encode.movImm64(&mut em.code, X86Encode.rax(), b64)
      run X86Encode.movqToXmm(&mut em.code, 0, X86Encode.rax())
      run X86Encode.punpcklqdq(&mut em.code, 0, 0)
    }
    drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp), 0)
    if size == 16 { return () }
    if size <= 32 {
      if size == 20 { drop run X86Encode.movssMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 16), 0) }
      else if size == 24 { drop run X86Encode.movsdMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 16), 0) }
      else { drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + s - 16), 0) }
      return ()
    }
    drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 16), 0)
    if size <= 48 {
      if size == 36 { drop run X86Encode.movssMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 32), 0) }
      else if size == 40 { drop run X86Encode.movsdMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 32), 0) }
      else { drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + s - 16), 0) }
      return ()
    }
    drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 32), 0)
    if size == 52 { drop run X86Encode.movssMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 48), 0) }
    else if size == 56 { drop run X86Encode.movsdMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + 48), 0) }
    else { drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(dstBase, dstDisp + s - 16), 0) }
    return ()
  }
  // > 64 bytes: 32B/iter SSE2 fill loop using ONLY scratch regs (`r10`, `rcx`, `rax`, `xmm0`),
  // so caller-saved GPRs (`rdi`, `rsi`, `r8`, `r9`) and allocatable XMMs (`xmm4..xmm15`) stay live!
  let dstSb = valSlotBase(&em.*, dstVal)
  if dstSb != 0 {
    drop run X86Encode.lea64(&mut em.code, X86Encode.r10(), Mem.baseDisp(X86Encode.rbp(), dstSb))
  } else {
    run loadGp(&mut em.*, function, dstVal, X86Encode.r10())
  }
  if fillByte == 0 {
    run X86Encode.pxor(&mut em.code, 0, 0)
  } else {
    let b64: u64 = u8.toU64(fillByte) * 0x0101010101010101
    run X86Encode.movImm64(&mut em.code, X86Encode.rax(), b64)
    run X86Encode.movqToXmm(&mut em.code, 0, X86Encode.rax())
    run X86Encode.punpcklqdq(&mut em.code, 0, 0)
  }
  let chunks32 = size / 32
  let rem = size % 32
  run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), chunks32)
  let loopStart = Bytes.length(&em.code)
  drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(X86Encode.r10(), 0), 0)
  drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(X86Encode.r10(), 16), 0)
  run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r10(), 32)
  run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rcx(), 1)
  let back = run emitJcc(&mut em.*, X86Encode.ccNe())
  patchTo(&mut em.*, back, loopStart)
  if rem != 0 {
    if rem <= 16 {
      let tailDisp = u64.wrappingToI32(rem) - 16
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(X86Encode.r10(), tailDisp), 0)
    } else {
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(X86Encode.r10(), 0), 0)
      let tailDisp = u64.wrappingToI32(rem) - 16
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(X86Encode.r10(), tailDisp), 0)
    }
  }
  return ()
}

effect fn emitCopyCounted(em: &mut Emitter, function: &SsaFunction, dstVal: u64, srcVal: u64, countVal: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  run loadGp(&mut em.*, function, dstVal, X86Encode.rdi())
  run loadGp(&mut em.*, function, srcVal, X86Encode.rsi())
  run loadGp(&mut em.*, function, countVal, X86Encode.rdx())
  return run callExternal(&mut em.*, b"memmove")
}

effect fn emitFillCounted(em: &mut Emitter, function: &SsaFunction, dstVal: u64, byteVal: u64, countVal: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  run loadGp(&mut em.*, function, dstVal, X86Encode.rdi())
  run loadGp(&mut em.*, function, byteVal, X86Encode.rax())
  run loadGp(&mut em.*, function, countVal, X86Encode.rcx())
  return run X86Encode.repStosb(&mut em.code)
}

// ---- VaStart ----

effect fn emitVaStart(em: &mut Emitter, function: &SsaFunction, vaPtrVal: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  run loadGp(&mut em.*, function, vaPtrVal, X86Encode.rdi())
  let gpOff: u64 = if em.fixedGpCount < 6 { usize.toU64(em.fixedGpCount * 8) } else { 48 }
  let fpOff: u64 = if em.fixedFpCount < 8 { 48 + usize.toU64(em.fixedFpCount * 16) } else { 176 }
  drop run X86Encode.movMi32(&mut em.code, Mem.baseDisp(X86Encode.rdi(), 0), gpOff)
  drop run X86Encode.movMi32(&mut em.code, Mem.baseDisp(X86Encode.rdi(), 4), fpOff)
  // overflow_arg_area = rbp + 16 + fixedStackBytes
  drop run X86Encode.lea64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), 16 + u64.wrappingToI32(em.fixedStackBytes)))
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rdi(), 8), X86Encode.rax())
  // reg_save_area = rbp + regSaveOffset
  drop run X86Encode.lea64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), em.frame.regSaveOffset))
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rdi(), 16), X86Encode.rax())
  return ()
}

// ---- Binary Arithmetic (Scalar <=64, i128, Float, Vector) ----

effect fn emitBinary(em: &mut Emitter, function: &SsaFunction, op: Binary, kind: Kind, left: u64, right: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if kind.isVector() {
    return run emitVectorBinary(&mut em.*, function, op, kind, left, right, result)
  }
  if kind.isFloat() {
    return run emitFloatBinary(&mut em.*, function, op, kind.bits == 64, left, right, result)
  }
  if kind.bits > 64 {
    return run emitI128Binary(&mut em.*, function, op, left, right, result)
  }
  let bits = kind.bits
  // Direct register + immediate fast path for Add/Sub/And/Or/Xor.
  if op == Binary.Add || op == Binary.Sub || op == Binary.And || op == Binary.Or || op == Binary.Xor {
    if op == Binary.Xor && isFusedNot(&em.*, result) {
      return ()
    }
    if op == Binary.And && (bits == 32 || bits == 64) && hasFeat(&em.*, X86Frame.featBmi()) && (isFusedNot(&em.*, left) || isFusedNot(&em.*, right)) {
      let notVal = if isFusedNot(&em.*, left) { left } else { right }
      let otherVal = if isFusedNot(&em.*, left) { right } else { left }
      let prod = function.producerOf(notVal)
      let pOps = function.operandsOf(prod)
      let allOnes: u64 = if bits == 64 { u64.MAX } else { 4294967295 }
      let src1Val = if function.isBits(pOps[1]) && (function.constantOf(pOps[1]).low & allOnes) == allOnes { pOps[0] } else { pOps[1] }
      let src1Reg = run regOrLoad(&mut em.*, function, src1Val, X86Encode.r10())
      let workDst = dstRegOrScratch(&em.*, result, X86Encode.rax())
      let otherSpill = spilledGpOff(&em.*, function, otherVal)
      if otherSpill != 0 {
        let mem = Mem.baseDisp(X86Encode.rbp(), otherSpill)
        if bits == 64 {
          drop run X86Encode.andnRm64(&mut em.code, workDst, src1Reg, mem)
        } else {
          drop run X86Encode.andnRm32(&mut em.code, workDst, src1Reg, mem)
        }
      } else {
        let otherReg = run regOrLoad(&mut em.*, function, otherVal, X86Encode.r11())
        if bits == 64 {
          run X86Encode.andn64(&mut em.code, workDst, src1Reg, otherReg)
        } else {
          run X86Encode.andn32(&mut em.code, workDst, src1Reg, otherReg)
        }
      }
      return run storeGp(&mut em.*, result, workDst)
    }
    let aluOp = match op {
      Binary.Add => Alu.Add
      Binary.Sub => Alu.Sub
      Binary.And => Alu.And
      Binary.Or => Alu.Or
      _ => Alu.Xor
    }
    let mut lhs = left
    let mut rhs = right
    let mut imm = constBitsImm32(function, rhs, bits)
    if !imm.ok && op != Binary.Sub {
      let lhsImm = constBitsImm32(function, lhs, bits)
      if lhsImm.ok {
        lhs = right
        rhs = left
        imm = lhsImm
      } else {
        let rDstPre = if result != none() && result == em.retTargetVal { X86Encode.rax() } else { valReg(&em.*, result) }
        if rDstPre != X86Frame.regNone() && valReg(&em.*, rhs) == rDstPre && valReg(&em.*, lhs) != rDstPre {
          lhs = right
          rhs = left
        } else if spilledGpOff(&em.*, function, rhs) == 0 && spilledGpOff(&em.*, function, lhs) != 0 {
          lhs = right
          rhs = left
        }
      }
    }
    let rDst = if result != none() && result == em.retTargetVal { X86Encode.rax() } else { valReg(&em.*, result) }
    let rLhs = valReg(&em.*, lhs)
    let rRhs = if imm.ok { X86Frame.regNone() } else { valReg(&em.*, rhs) }
    let workDst = if rDst != X86Frame.regNone() && rDst != rRhs { rDst } else { X86Encode.rax() }
    // 3-operand `lea` fast path avoids `mov + add/sub` when destination differs from source registers.
    if (bits == 8 || bits == 16 || bits == 32 || bits == 64) && rLhs != X86Frame.regNone() {
      if (bits == 32 || bits == 64) && op == Binary.Add && !imm.ok && rRhs != X86Frame.regNone() && workDst != rLhs && workDst != rRhs && rRhs != X86Encode.rsp() {
        let mem = Mem.baseIndex(rLhs, rRhs, 1, 0)
        if bits == 64 { drop run X86Encode.lea64(&mut em.code, workDst, mem) }
        else { drop run X86Encode.lea32(&mut em.code, workDst, mem) }
        return run storeGp(&mut em.*, result, workDst)
      }
      if op == Binary.Add && imm.ok && workDst != rLhs {
        let mem = Mem.baseDisp(rLhs, imm.value)
        if bits == 64 { drop run X86Encode.lea64(&mut em.code, workDst, mem) }
        else {
          drop run X86Encode.lea32(&mut em.code, workDst, mem)
          if bits < 32 { run normalizeInt(&mut em.*, workDst, bits, false) }
        }
        return run storeGp(&mut em.*, result, workDst)
      }
      if op == Binary.Sub && imm.ok && workDst != rLhs && imm.value != -2147483648 {
        let mem = Mem.baseDisp(rLhs, 0 - imm.value)
        if bits == 64 { drop run X86Encode.lea64(&mut em.code, workDst, mem) }
        else {
          drop run X86Encode.lea32(&mut em.code, workDst, mem)
          if bits < 32 { run normalizeInt(&mut em.*, workDst, bits, false) }
        }
        return run storeGp(&mut em.*, result, workDst)
      }
    }
    let skipBoolNorm = bits == usize.ONE && (
      (op == Binary.And && (isKnownBool(&em.*, lhs) || isKnownBool(&em.*, rhs)))
        || ((op == Binary.Or || op == Binary.Xor) && isKnownBool(&em.*, lhs) && isKnownBool(&em.*, rhs))
    )
    run loadGp(&mut em.*, function, lhs, workDst)
    if imm.ok {
      if bits == 32 {
        run X86Encode.aluRi32(&mut em.code, aluOp, workDst, imm.value)
      } else if op == Binary.And && bits < 32 {
        run X86Encode.aluRi32(&mut em.code, Alu.And, workDst, imm.value)
      } else {
        run X86Encode.aluRi64(&mut em.code, aluOp, workDst, imm.value)
        if bits < 64 && !skipBoolNorm { run normalizeInt(&mut em.*, workDst, bits, false) }
      }
    } else {
      let rhsSpill = spilledGpOff(&em.*, function, rhs)
      if rhsSpill != 0 {
        let mem = Mem.baseDisp(X86Encode.rbp(), rhsSpill)
        if bits == 32 {
          drop run X86Encode.aluRm32(&mut em.code, aluOp, workDst, mem)
        } else {
          drop run X86Encode.aluRm64(&mut em.code, aluOp, workDst, mem)
          if bits < 64 && !skipBoolNorm { run normalizeInt(&mut em.*, workDst, bits, false) }
        }
      } else {
        let rhsReg = run regOrLoad(&mut em.*, function, rhs, X86Encode.r11())
        if bits == 32 {
          run X86Encode.aluRr32(&mut em.code, aluOp, workDst, rhsReg)
        } else {
          run X86Encode.aluRr64(&mut em.code, aluOp, workDst, rhsReg)
          if bits < 64 && !skipBoolNorm { run normalizeInt(&mut em.*, workDst, bits, false) }
        }
      }
    }
    return run storeGp(&mut em.*, result, workDst)
  }
  // Direct register fast path for 32-bit and 64-bit multiply (with power-of-two shift, lea 3/5/9, and 3-op imulRri).
  if op == Binary.Mul && (bits == 32 || bits == 64) {
    let mut mulLhs = left
    let mut mulRhs = right
    let mut powShift: u8 = 255
    if function.isBits(right) {
      let c = function.constantOf(right).low
      if c > 0 && (c & (c - 1)) == 0 { powShift = u32.wrappingToU8(u64.trailingZeros(c)) }
    } else if function.isBits(left) {
      let c = function.constantOf(left).low
      if c > 0 && (c & (c - 1)) == 0 {
        powShift = u32.wrappingToU8(u64.trailingZeros(c))
        mulLhs = right
        mulRhs = left
      }
    }
    if powShift != 255 && u8.toUsize(powShift) < bits {
      let workDst = dstRegOrScratch(&em.*, result, X86Encode.rax())
      run loadGp(&mut em.*, function, mulLhs, workDst)
      if bits == 32 {
        if powShift == 0 { run X86Encode.movRr32(&mut em.code, workDst, workDst) }
        else { run X86Encode.shiftImm32(&mut em.code, Shift.Shl, workDst, powShift) }
      } else {
        if powShift != 0 { run X86Encode.shiftImm64(&mut em.code, Shift.Shl, workDst, powShift) }
      }
      return run storeGp(&mut em.*, result, workDst)
    }
    let mut mulImm = constBitsImm32(function, mulRhs, bits)
    if !mulImm.ok {
      let lImm = constBitsImm32(function, mulLhs, bits)
      if lImm.ok {
        mulLhs = right
        mulRhs = left
        mulImm = lImm
      }
    }
    if mulImm.ok {
      let workDst = dstRegOrScratch(&em.*, result, X86Encode.rax())
      let srcReg = run regOrLoad(&mut em.*, function, mulLhs, X86Encode.r11())
      if (mulImm.value == 3 || mulImm.value == 5 || mulImm.value == 9) && srcReg != X86Encode.rsp() {
        let scale: u8 = if mulImm.value == 3 { 2 } else if mulImm.value == 5 { 4 } else { 8 }
        let mem = Mem.baseIndex(srcReg, srcReg, scale, 0)
        if bits == 64 { drop run X86Encode.lea64(&mut em.code, workDst, mem) }
        else { drop run X86Encode.lea32(&mut em.code, workDst, mem) }
      } else if bits == 64 {
        run X86Encode.imulRri64(&mut em.code, workDst, srcReg, mulImm.value)
      } else {
        run X86Encode.imulRri32(&mut em.code, workDst, srcReg, mulImm.value)
      }
      return run storeGp(&mut em.*, result, workDst)
    }
    let rDstPre = if result != none() && result == em.retTargetVal { X86Encode.rax() } else { valReg(&em.*, result) }
    if rDstPre != X86Frame.regNone() && valReg(&em.*, mulRhs) == rDstPre && valReg(&em.*, mulLhs) != rDstPre {
      let tmp = mulLhs
      mulLhs = mulRhs
      mulRhs = tmp
    } else if spilledGpOff(&em.*, function, mulRhs) == 0 && spilledGpOff(&em.*, function, mulLhs) != 0 {
      let tmp = mulLhs
      mulLhs = mulRhs
      mulRhs = tmp
    }
    let rDst = rDstPre
    let rRhs = valReg(&em.*, mulRhs)
    let workDst = if rDst != X86Frame.regNone() && rDst != rRhs { rDst } else { X86Encode.rax() }
    run loadGp(&mut em.*, function, mulLhs, workDst)
    let rhsSpill = spilledGpOff(&em.*, function, mulRhs)
    if rhsSpill != 0 {
      let mem = Mem.baseDisp(X86Encode.rbp(), rhsSpill)
      if bits == 32 {
        drop run X86Encode.imulRm32(&mut em.code, workDst, mem)
      } else {
        drop run X86Encode.imulRm64(&mut em.code, workDst, mem)
      }
    } else {
      let rhsReg = run regOrLoad(&mut em.*, function, mulRhs, X86Encode.r11())
      if bits == 32 {
        run X86Encode.imulRr32(&mut em.code, workDst, rhsReg)
      } else {
        run X86Encode.imulRr64(&mut em.code, workDst, rhsReg)
      }
    }
    return run storeGp(&mut em.*, result, workDst)
  }
  // Constant-count and BMI2 variable-count shift fast paths.
  if op == Binary.Shl || op == Binary.LShr || op == Binary.AShr {
    let rhsInfo = function.value(right)
    if rhsInfo.definition == Definition.Constant {
      let c = function.constantOf(right)
      if c.form == ConstantForm.Bits {
        let amt: u8 = if bits == usize.ONE {
          0
        } else if bits < 64 {
          u64.wrappingToU8(c.low & usize.toU64(bits - usize.ONE))
        } else {
          u64.wrappingToU8(c.low & 63)
        }
        let shOp = match op {
          Binary.Shl => Shift.Shl
          Binary.LShr => Shift.Shr
          _ => Shift.Sar
        }
        let workDst = dstRegOrScratch(&em.*, result, X86Encode.rax())
        run loadGp(&mut em.*, function, left, workDst)
        if bits == 64 {
          if amt != 0 { run X86Encode.shiftImm64(&mut em.code, shOp, workDst, amt) }
        } else if bits == 32 {
          if amt == 0 {
            run X86Encode.movRr32(&mut em.code, workDst, workDst)
          } else {
            run X86Encode.shiftImm32(&mut em.code, shOp, workDst, amt)
          }
        } else if op == Binary.Shl {
          if amt != 0 { run X86Encode.shiftImm64(&mut em.code, Shift.Shl, workDst, amt) }
          run normalizeInt(&mut em.*, workDst, bits, false)
        } else if op == Binary.LShr {
          run normalizeInt(&mut em.*, workDst, bits, false)
          if amt != 0 { run X86Encode.shiftImm64(&mut em.code, Shift.Shr, workDst, amt) }
        } else {
          run normalizeInt(&mut em.*, workDst, bits, true)
          if amt != 0 { run X86Encode.shiftImm64(&mut em.code, Shift.Sar, workDst, amt) }
          run normalizeInt(&mut em.*, workDst, bits, false)
        }
        return run storeGp(&mut em.*, result, workDst)
      }
    }
    if (bits == 32 || bits == 64) && hasFeat(&em.*, X86Frame.featBmi2()) {
      let srcReg = run regOrLoad(&mut em.*, function, left, X86Encode.r10())
      let cntReg = run regOrLoad(&mut em.*, function, right, X86Encode.r11())
      let workDst = dstRegOrScratch(&em.*, result, X86Encode.rax())
      if bits == 64 {
        if op == Binary.Shl { run X86Encode.shlx64(&mut em.code, workDst, srcReg, cntReg) }
        else if op == Binary.LShr { run X86Encode.shrx64(&mut em.code, workDst, srcReg, cntReg) }
        else { run X86Encode.sarx64(&mut em.code, workDst, srcReg, cntReg) }
      } else {
        if op == Binary.Shl { run X86Encode.shlx32(&mut em.code, workDst, srcReg, cntReg) }
        else if op == Binary.LShr { run X86Encode.shrx32(&mut em.code, workDst, srcReg, cntReg) }
        else { run X86Encode.sarx32(&mut em.code, workDst, srcReg, cntReg) }
      }
      return run storeGp(&mut em.*, result, workDst)
    }
  }
  run loadGp(&mut em.*, function, left, X86Encode.rax())
  run loadGp(&mut em.*, function, right, X86Encode.rcx())
  run emitScalarIntBinaryRegs(&mut em.*, op, bits)
  return run storeGp(&mut em.*, result, X86Encode.rax())
}

// Computes `rax = rax op rcx` for `bits <= 64` (may clobber `rdx`, `r8`).
effect fn emitScalarIntBinaryRegs(em: &mut Emitter, op: Binary, bits: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  match op {
    Binary.Add => {
      run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.rax(), X86Encode.rcx())
      return run normalizeInt(&mut em.*, X86Encode.rax(), bits, false)
    }
    Binary.Sub => {
      run X86Encode.aluRr64(&mut em.code, Alu.Sub, X86Encode.rax(), X86Encode.rcx())
      return run normalizeInt(&mut em.*, X86Encode.rax(), bits, false)
    }
    Binary.Mul => {
      run X86Encode.imulRr64(&mut em.code, X86Encode.rax(), X86Encode.rcx())
      return run normalizeInt(&mut em.*, X86Encode.rax(), bits, false)
    }
    Binary.UMulHi => {
      run X86Encode.mul64(&mut em.code, X86Encode.rcx())
      return run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.rdx())
    }
    Binary.SMulHi => {
      run X86Encode.imulOne64(&mut em.code, X86Encode.rcx())
      return run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.rdx())
    }
    Binary.And => {
      run X86Encode.aluRr64(&mut em.code, Alu.And, X86Encode.rax(), X86Encode.rcx())
      return run normalizeInt(&mut em.*, X86Encode.rax(), bits, false)
    }
    Binary.Or => {
      run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.rax(), X86Encode.rcx())
      return run normalizeInt(&mut em.*, X86Encode.rax(), bits, false)
    }
    Binary.Xor => {
      run X86Encode.aluRr64(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rcx())
      return run normalizeInt(&mut em.*, X86Encode.rax(), bits, false)
    }
    Binary.Shl => {
      run maskShiftCount(&mut em.*, bits)
      run X86Encode.shiftCl64(&mut em.code, Shift.Shl, X86Encode.rax())
      return run normalizeInt(&mut em.*, X86Encode.rax(), bits, false)
    }
    Binary.LShr => {
      run normalizeInt(&mut em.*, X86Encode.rax(), bits, false)
      run maskShiftCount(&mut em.*, bits)
      return run X86Encode.shiftCl64(&mut em.code, Shift.Shr, X86Encode.rax())
    }
    Binary.AShr => {
      run normalizeInt(&mut em.*, X86Encode.rax(), bits, true)
      run maskShiftCount(&mut em.*, bits)
      run X86Encode.shiftCl64(&mut em.code, Shift.Sar, X86Encode.rax())
      return run normalizeInt(&mut em.*, X86Encode.rax(), bits, false)
    }
    Binary.UDiv => {
      run normalizeInt(&mut em.*, X86Encode.rax(), bits, false)
      run normalizeInt(&mut em.*, X86Encode.rcx(), bits, false)
      run X86Encode.testRr64(&mut em.code, X86Encode.rcx(), X86Encode.rcx())
      let ok = run emitJcc(&mut em.*, X86Encode.ccNe())
      run X86Encode.ud2(&mut em.code)
      patchHere(&mut em.*, ok)
      run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rdx(), X86Encode.rdx())
      return run X86Encode.div64(&mut em.code, X86Encode.rcx())
    }
    Binary.URem => {
      run normalizeInt(&mut em.*, X86Encode.rax(), bits, false)
      run normalizeInt(&mut em.*, X86Encode.rcx(), bits, false)
      run X86Encode.testRr64(&mut em.code, X86Encode.rcx(), X86Encode.rcx())
      let ok = run emitJcc(&mut em.*, X86Encode.ccNe())
      run X86Encode.ud2(&mut em.code)
      patchHere(&mut em.*, ok)
      run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rdx(), X86Encode.rdx())
      run X86Encode.div64(&mut em.code, X86Encode.rcx())
      return run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.rdx())
    }
    Binary.SDiv => {
      run emitSignedDivRem64(&mut em.*, bits, false)
      return ()
    }
    Binary.SRem => {
      run emitSignedDivRem64(&mut em.*, bits, true)
      return ()
    }
  }
}

effect fn maskShiftCount(em: &mut Emitter, bits: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if bits == 1 {
    return run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rcx(), X86Encode.rcx())
  }
  if bits < 64 {
    return run X86Encode.aluRi32(&mut em.code, Alu.And, X86Encode.rcx(), usize.toI32(bits - usize.ONE))
  }
  return ()
}

effect fn emitSignedDivRem64(em: &mut Emitter, bits: usize, wantRem: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  run normalizeInt(&mut em.*, X86Encode.rax(), bits, true)
  run normalizeInt(&mut em.*, X86Encode.rcx(), bits, true)
  // Trap on divisor == 0.
  run X86Encode.testRr64(&mut em.code, X86Encode.rcx(), X86Encode.rcx())
  let nonZero = run emitJcc(&mut em.*, X86Encode.ccNe())
  run X86Encode.ud2(&mut em.code)
  patchHere(&mut em.*, nonZero)
  // Trap on INT_MIN / -1.
  run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.rcx(), -1)
  let notNegOne = run emitJcc(&mut em.*, X86Encode.ccNe())
  let minVal = u64.shiftLeft(1, usize.toU64(bits - usize.ONE))
  let signExtMin = if bits == 64 { minVal } else { u64.MAX - (minVal - 1) }
  run X86Encode.movImm64(&mut em.code, X86Encode.r8(), signExtMin)
  run X86Encode.aluRr64(&mut em.code, Alu.Cmp, X86Encode.rax(), X86Encode.r8())
  let notMin = run emitJcc(&mut em.*, X86Encode.ccNe())
  run X86Encode.ud2(&mut em.code)
  let doDiv = Bytes.length(&em.code)
  patchTo(&mut em.*, notNegOne, doDiv)
  patchTo(&mut em.*, notMin, doDiv)
  run X86Encode.cqo(&mut em.code)
  run X86Encode.idiv64(&mut em.code, X86Encode.rcx())
  if wantRem {
    run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.rdx())
  }
  return run normalizeInt(&mut em.*, X86Encode.rax(), bits, false)
}

effect fn emitFloatBinary(em: &mut Emitter, function: &SsaFunction, op: Binary, double: bool, left: u64, right: u64, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  run loadFloat(&mut em.*, function, left, 0, X86Encode.rax())
  run loadFloat(&mut em.*, function, right, 1, X86Encode.rax())
  match op {
    Binary.Add => { run X86Encode.addFloat(&mut em.code, double, 0, 1) }
    Binary.Sub => { run X86Encode.subFloat(&mut em.code, double, 0, 1) }
    Binary.Mul => { run X86Encode.mulFloat(&mut em.code, double, 0, 1) }
    Binary.UDiv => { run X86Encode.divFloat(&mut em.code, double, 0, 1) }
    Binary.SDiv => { run X86Encode.divFloat(&mut em.code, double, 0, 1) }
    Binary.URem => { run callExternal(&mut em.*, if double { b"fmod" } else { b"fmodf" }) }
    Binary.SRem => { run callExternal(&mut em.*, if double { b"fmod" } else { b"fmodf" }) }
    _ => {}
  }
  return run storeFloat(&mut em.*, result, 0, double)
}

effect fn emitI128Binary(em: &mut Emitter, function: &SsaFunction, op: Binary, left: u64, right: u64, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  run loadPair(&mut em.*, function, left, X86Encode.rax(), X86Encode.rdx())
  run loadPair(&mut em.*, function, right, X86Encode.r8(), X86Encode.r9())
  match op {
    Binary.Add => {
      run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.rax(), X86Encode.r8())
      run X86Encode.aluRr64(&mut em.code, Alu.Adc, X86Encode.rdx(), X86Encode.r9())
    }
    Binary.Sub => {
      run X86Encode.aluRr64(&mut em.code, Alu.Sub, X86Encode.rax(), X86Encode.r8())
      run X86Encode.aluRr64(&mut em.code, Alu.Sbb, X86Encode.rdx(), X86Encode.r9())
    }
    Binary.And => {
      run X86Encode.aluRr64(&mut em.code, Alu.And, X86Encode.rax(), X86Encode.r8())
      run X86Encode.aluRr64(&mut em.code, Alu.And, X86Encode.rdx(), X86Encode.r9())
    }
    Binary.Or => {
      run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.rax(), X86Encode.r8())
      run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.rdx(), X86Encode.r9())
    }
    Binary.Xor => {
      run X86Encode.aluRr64(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.r8())
      run X86Encode.aluRr64(&mut em.code, Alu.Xor, X86Encode.rdx(), X86Encode.r9())
    }
    Binary.Mul => {
      // r10 = lhsHi * rhsLo + lhsLo * rhsHi; rdx:rax = lhsLo * rhsLo; rdx += r10.
      run X86Encode.movRr64(&mut em.code, X86Encode.r10(), X86Encode.rdx())
      run X86Encode.imulRr64(&mut em.code, X86Encode.r10(), X86Encode.r8())
      run X86Encode.movRr64(&mut em.code, X86Encode.r11(), X86Encode.rax())
      run X86Encode.imulRr64(&mut em.code, X86Encode.r11(), X86Encode.r9())
      run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.r10(), X86Encode.r11())
      run X86Encode.mul64(&mut em.code, X86Encode.r8())
      run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.rdx(), X86Encode.r10())
    }
    Binary.Shl => {
      run X86Encode.movRr64(&mut em.code, X86Encode.rcx(), X86Encode.r8())
      run X86Encode.aluRi32(&mut em.code, Alu.And, X86Encode.rcx(), 127)
      run X86Encode.aluRi32(&mut em.code, Alu.Cmp, X86Encode.rcx(), 64)
      let wide = run emitJcc(&mut em.*, X86Encode.ccAe())
      run X86Encode.shldCl64(&mut em.code, X86Encode.rdx(), X86Encode.rax())
      run X86Encode.shiftCl64(&mut em.code, Shift.Shl, X86Encode.rax())
      let done = run emitJmp(&mut em.*)
      patchHere(&mut em.*, wide)
      run X86Encode.movRr64(&mut em.code, X86Encode.rdx(), X86Encode.rax())
      run X86Encode.shiftCl64(&mut em.code, Shift.Shl, X86Encode.rdx())
      run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rax())
      patchHere(&mut em.*, done)
    }
    Binary.LShr => {
      run X86Encode.movRr64(&mut em.code, X86Encode.rcx(), X86Encode.r8())
      run X86Encode.aluRi32(&mut em.code, Alu.And, X86Encode.rcx(), 127)
      run X86Encode.aluRi32(&mut em.code, Alu.Cmp, X86Encode.rcx(), 64)
      let wide = run emitJcc(&mut em.*, X86Encode.ccAe())
      run X86Encode.shrdCl64(&mut em.code, X86Encode.rax(), X86Encode.rdx())
      run X86Encode.shiftCl64(&mut em.code, Shift.Shr, X86Encode.rdx())
      let done = run emitJmp(&mut em.*)
      patchHere(&mut em.*, wide)
      run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.rdx())
      run X86Encode.shiftCl64(&mut em.code, Shift.Shr, X86Encode.rax())
      run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rdx(), X86Encode.rdx())
      patchHere(&mut em.*, done)
    }
    Binary.AShr => {
      run X86Encode.movRr64(&mut em.code, X86Encode.rcx(), X86Encode.r8())
      run X86Encode.aluRi32(&mut em.code, Alu.And, X86Encode.rcx(), 127)
      run X86Encode.aluRi32(&mut em.code, Alu.Cmp, X86Encode.rcx(), 64)
      let wide = run emitJcc(&mut em.*, X86Encode.ccAe())
      run X86Encode.shrdCl64(&mut em.code, X86Encode.rax(), X86Encode.rdx())
      run X86Encode.shiftCl64(&mut em.code, Shift.Sar, X86Encode.rdx())
      let done = run emitJmp(&mut em.*)
      patchHere(&mut em.*, wide)
      run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.rdx())
      run X86Encode.shiftCl64(&mut em.code, Shift.Sar, X86Encode.rax())
      run X86Encode.shiftImm64(&mut em.code, Shift.Sar, X86Encode.rdx(), 63)
      patchHere(&mut em.*, done)
    }
    Binary.UDiv => { run emitI128DivCall(&mut em.*, false, false) }
    Binary.URem => { run emitI128DivCall(&mut em.*, false, true) }
    Binary.SDiv => { run emitI128DivCall(&mut em.*, true, false) }
    Binary.SRem => { run emitI128DivCall(&mut em.*, true, true) }
    _ => {}
  }
  return run storePair(&mut em.*, result, X86Encode.rax(), X86Encode.rdx())
}

effect fn emitI128DivCall(em: &mut Emitter, signed: bool, rem: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  // Check divisor (r8:r9) != 0 -> else ud2.
  run X86Encode.movRr64(&mut em.code, X86Encode.r10(), X86Encode.r8())
  run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.r10(), X86Encode.r9())
  let ok = run emitJcc(&mut em.*, X86Encode.ccNe())
  run X86Encode.ud2(&mut em.code)
  patchHere(&mut em.*, ok)
  if signed {
    // Check INT128_MIN / -1: (r8 == -1 && r9 == -1 && rax == 0 && rdx == 0x8000...0).
    run X86Encode.movRr64(&mut em.code, X86Encode.r10(), X86Encode.r8())
    run X86Encode.aluRr64(&mut em.code, Alu.And, X86Encode.r10(), X86Encode.r9())
    run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.r10(), -1)
    let ok1 = run emitJcc(&mut em.*, X86Encode.ccNe())
    run X86Encode.testRr64(&mut em.code, X86Encode.rax(), X86Encode.rax())
    let ok2 = run emitJcc(&mut em.*, X86Encode.ccNe())
    run X86Encode.movImm64(&mut em.code, X86Encode.r11(), 0x8000000000000000)
    run X86Encode.aluRr64(&mut em.code, Alu.Cmp, X86Encode.rdx(), X86Encode.r11())
    let ok3 = run emitJcc(&mut em.*, X86Encode.ccNe())
    run X86Encode.ud2(&mut em.code)
    let pass = Bytes.length(&em.code)
    patchTo(&mut em.*, ok1, pass)
    patchTo(&mut em.*, ok2, pass)
    patchTo(&mut em.*, ok3, pass)
  }
  run X86Encode.movRr64(&mut em.code, X86Encode.rdi(), X86Encode.rax())
  run X86Encode.movRr64(&mut em.code, X86Encode.rsi(), X86Encode.rdx())
  run X86Encode.movRr64(&mut em.code, X86Encode.rdx(), X86Encode.r8())
  run X86Encode.movRr64(&mut em.code, X86Encode.rcx(), X86Encode.r9())
  let helper = if signed {
    if rem { b"__silk_modti3" } else { b"__silk_divti3" }
  } else {
    if rem { b"__silk_umodti3" } else { b"__silk_udivti3" }
  }
  return run callExternal(&mut em.*, helper)
}

// ---- Negate, Compare, Select ----

effect fn emitNegate(em: &mut Emitter, function: &SsaFunction, kind: Kind, src: u64, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  if kind.isVector() {
    return run emitVectorUnary(&mut em.*, function, 0, kind, src, result)
  }
  if kind.bits == 64 {
    run loadFloat(&mut em.*, function, src, 0, X86Encode.rax())
    run X86Encode.movqFromXmm(&mut em.code, X86Encode.rax(), 0)
    run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), 0x8000000000000000)
    run X86Encode.aluRr64(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rcx())
    run X86Encode.movqToXmm(&mut em.code, 0, X86Encode.rax())
    return run storeFloat(&mut em.*, result, 0, true)
  }
  run loadFloat(&mut em.*, function, src, 0, X86Encode.rax())
  run X86Encode.movdFromXmm(&mut em.code, X86Encode.rax(), 0)
  run X86Encode.movImm32(&mut em.code, X86Encode.rcx(), 0x80000000)
  run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rcx())
  run X86Encode.movdToXmm(&mut em.code, 0, X86Encode.rax())
  return run storeFloat(&mut em.*, result, 0, false)
}

// Emits a scalar integer (`bits <= 64`) comparison setting CPU flags and returning the matching
// x86 condition code `cc`. Used both by `emitCompare` and by fused compare-branch exits.
fn swapIntPred(pred: Predicate) -> Predicate {
  return match pred {
    Predicate.Slt => Predicate.Sgt
    Predicate.Sle => Predicate.Sge
    Predicate.Sgt => Predicate.Slt
    Predicate.Sge => Predicate.Sle
    Predicate.Ult => Predicate.Ugt
    Predicate.Ule => Predicate.Uge
    Predicate.Ugt => Predicate.Ult
    Predicate.Uge => Predicate.Ule
    _ => pred
  }
}

effect fn emitScalarIntCmpFlags(em: &mut Emitter, function: &SsaFunction, predIn: Predicate, leftIn: u64, rightIn: u64) -> u8
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut pred = predIn
  let mut left = leftIn
  let mut right = rightIn
  let bits = function.value(left).kind.bits
  // Signed `i1` compares (`Slt`/`Sle`/`Sgt`/`Sge`) treat `1` as `-1` and MUST use the full
  // sign-extension fallback; unsigned/equality `i1` with known `{0,1}` operands can use 8-bit ops.
  let fastBool = bits == usize.ONE && !isSignedPred(pred)
    && (function.isBits(left) || isKnownBool(&em.*, left))
    && (function.isBits(right) || isKnownBool(&em.*, right))
  if (bits == 64 || bits == 32 || bits == 16 || bits == 8 || fastBool) && !function.isBits(right) && function.isBits(left) {
    left = rightIn
    right = leftIn
    pred = swapIntPred(predIn)
  }
  let zeroTestOk = pred == Predicate.Eq || pred == Predicate.Ne || isSignedPred(pred)
  if bits == 64 {
    let imm = constBitsImm32(function, right, 64)
    if imm.ok {
      let leftSpill = spilledGpOff(&em.*, function, left)
      if leftSpill != 0 {
        drop run X86Encode.aluMi64(&mut em.code, Alu.Cmp, Mem.baseDisp(X86Encode.rbp(), leftSpill), imm.value)
        return intPredCc(pred)
      }
      let lhsReg = run regOrLoad(&mut em.*, function, left, X86Encode.rax())
      if imm.value == 0 && zeroTestOk {
        run X86Encode.testRr64(&mut em.code, lhsReg, lhsReg)
      } else {
        run X86Encode.aluRi64(&mut em.code, Alu.Cmp, lhsReg, imm.value)
      }
      return intPredCc(pred)
    }
    if spilledGpOff(&em.*, function, right) == 0 && spilledGpOff(&em.*, function, left) != 0 {
      let tmp = left
      left = right
      right = tmp
      pred = swapIntPred(pred)
    }
    let cc = intPredCc(pred)
    let lhsReg = run regOrLoad(&mut em.*, function, left, X86Encode.rax())
    let rhsSpill = spilledGpOff(&em.*, function, right)
    if rhsSpill != 0 {
      drop run X86Encode.aluRm64(&mut em.code, Alu.Cmp, lhsReg, Mem.baseDisp(X86Encode.rbp(), rhsSpill))
    } else {
      let rhsReg = run regOrLoad(&mut em.*, function, right, X86Encode.r11())
      run X86Encode.aluRr64(&mut em.code, Alu.Cmp, lhsReg, rhsReg)
    }
    return cc
  }
  if bits == 32 {
    let imm = constBitsImm32(function, right, 32)
    if imm.ok {
      let leftSpill = spilledGpOff(&em.*, function, left)
      if leftSpill != 0 {
        drop run X86Encode.aluMi32(&mut em.code, Alu.Cmp, Mem.baseDisp(X86Encode.rbp(), leftSpill), imm.value)
        return intPredCc(pred)
      }
      let lhsReg = run regOrLoad(&mut em.*, function, left, X86Encode.rax())
      if imm.value == 0 && zeroTestOk {
        run X86Encode.testRr32(&mut em.code, lhsReg, lhsReg)
      } else {
        run X86Encode.aluRi32(&mut em.code, Alu.Cmp, lhsReg, imm.value)
      }
      return intPredCc(pred)
    }
    if spilledGpOff(&em.*, function, right) == 0 && spilledGpOff(&em.*, function, left) != 0 {
      let tmp = left
      left = right
      right = tmp
      pred = swapIntPred(pred)
    }
    let cc = intPredCc(pred)
    let lhsReg = run regOrLoad(&mut em.*, function, left, X86Encode.rax())
    let rhsSpill = spilledGpOff(&em.*, function, right)
    if rhsSpill != 0 {
      drop run X86Encode.aluRm32(&mut em.code, Alu.Cmp, lhsReg, Mem.baseDisp(X86Encode.rbp(), rhsSpill))
    } else {
      let rhsReg = run regOrLoad(&mut em.*, function, right, X86Encode.r11())
      run X86Encode.aluRr32(&mut em.code, Alu.Cmp, lhsReg, rhsReg)
    }
    return cc
  }
  if bits == 16 {
    if function.isBits(right) {
      let c16 = function.constantOf(right).low & 0xFFFF
      let imm16: i32 = if c16 >= 32768 { u64.wrappingToI32(c16) - 65536 } else { u64.wrappingToI32(c16) }
      let leftSpill = spilledGpOff(&em.*, function, left)
      if leftSpill != 0 {
        drop run X86Encode.aluMi16(&mut em.code, Alu.Cmp, Mem.baseDisp(X86Encode.rbp(), leftSpill), imm16)
        return intPredCc(pred)
      }
      let lhsReg = run regOrLoad(&mut em.*, function, left, X86Encode.rax())
      if imm16 == 0 && zeroTestOk {
        run X86Encode.testRr16(&mut em.code, lhsReg, lhsReg)
      } else {
        run X86Encode.aluRi16(&mut em.code, Alu.Cmp, lhsReg, imm16)
      }
      return intPredCc(pred)
    }
    if spilledGpOff(&em.*, function, right) == 0 && spilledGpOff(&em.*, function, left) != 0 {
      let tmp = left
      left = right
      right = tmp
      pred = swapIntPred(pred)
    }
    let cc = intPredCc(pred)
    let lhsReg = run regOrLoad(&mut em.*, function, left, X86Encode.rax())
    let rhsSpill = spilledGpOff(&em.*, function, right)
    if rhsSpill != 0 {
      drop run X86Encode.aluRm16(&mut em.code, Alu.Cmp, lhsReg, Mem.baseDisp(X86Encode.rbp(), rhsSpill))
    } else {
      let rhsReg = run regOrLoad(&mut em.*, function, right, X86Encode.r11())
      run X86Encode.aluRr16(&mut em.code, Alu.Cmp, lhsReg, rhsReg)
    }
    return cc
  }
  if bits == 8 || fastBool {
    if function.isBits(right) {
      let imm8 = u64.wrappingToU8(maskBits(function.constantOf(right).low, bits))
      let leftSpill = spilledGpOff(&em.*, function, left)
      if leftSpill != 0 {
        drop run X86Encode.aluMi8(&mut em.code, Alu.Cmp, Mem.baseDisp(X86Encode.rbp(), leftSpill), imm8)
        return intPredCc(pred)
      }
      let lhsReg = run regOrLoad(&mut em.*, function, left, X86Encode.rax())
      if imm8 == 0 && zeroTestOk {
        run X86Encode.testRr8(&mut em.code, lhsReg, lhsReg)
      } else {
        run X86Encode.aluRi8(&mut em.code, Alu.Cmp, lhsReg, imm8)
      }
      return intPredCc(pred)
    }
    if spilledGpOff(&em.*, function, right) == 0 && spilledGpOff(&em.*, function, left) != 0 {
      let tmp = left
      left = right
      right = tmp
      pred = swapIntPred(pred)
    }
    let cc = intPredCc(pred)
    let lhsReg = run regOrLoad(&mut em.*, function, left, X86Encode.rax())
    let rhsSpill = spilledGpOff(&em.*, function, right)
    if rhsSpill != 0 {
      drop run X86Encode.aluRm8(&mut em.code, Alu.Cmp, lhsReg, Mem.baseDisp(X86Encode.rbp(), rhsSpill))
    } else {
      let rhsReg = run regOrLoad(&mut em.*, function, right, X86Encode.r11())
      run X86Encode.aluRr8(&mut em.code, Alu.Cmp, lhsReg, rhsReg)
    }
    return cc
  }
  let cc = intPredCc(pred)
  let signed = isSignedPred(pred)
  run loadGp(&mut em.*, function, left, X86Encode.rax())
  run normalizeInt(&mut em.*, X86Encode.rax(), bits, signed)
  let imm = constBitsImm32(function, right, bits)
  if imm.ok && !signed {
    if imm.value == 0 && zeroTestOk {
      run X86Encode.testRr64(&mut em.code, X86Encode.rax(), X86Encode.rax())
    } else {
      run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.rax(), imm.value)
    }
    return cc
  }
  run loadGp(&mut em.*, function, right, X86Encode.r11())
  run normalizeInt(&mut em.*, X86Encode.r11(), bits, signed)
  run X86Encode.aluRr64(&mut em.code, Alu.Cmp, X86Encode.rax(), X86Encode.r11())
  return cc
}

effect fn emitCompare(em: &mut Emitter, function: &SsaFunction, pred: Predicate, left: u64, right: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let opKind = function.value(left).kind
  if opKind.isVector() {
    return run emitVectorCompare(&mut em.*, function, pred, opKind, left, right, result)
  }
  if opKind.isFloat() {
    run loadFloat(&mut em.*, function, left, 0, X86Encode.rax())
    run loadFloat(&mut em.*, function, right, 1, X86Encode.rax())
    run emitFloatCompareRegs(&mut em.*, pred, opKind.bits == 64)
    return run storeGp(&mut em.*, result, X86Encode.rax())
  }
  if opKind.bits > 64 {
    run loadPair(&mut em.*, function, left, X86Encode.rax(), X86Encode.rdx())
    run loadPair(&mut em.*, function, right, X86Encode.r8(), X86Encode.r9())
    run emitI128CompareRegs(&mut em.*, pred)
    return run storeGp(&mut em.*, result, X86Encode.rax())
  }
  let cc = run emitScalarIntCmpFlags(&mut em.*, function, pred, left, right)
  let dst = dstRegOrScratch(&em.*, result, X86Encode.rax())
  run X86Encode.setcc(&mut em.code, cc, dst)
  run X86Encode.movzxRr8(&mut em.code, dst, dst)
  return run storeGp(&mut em.*, result, dst)
}

fn isSignedPred(pred: Predicate) -> bool {
  return pred == Predicate.Sgt || pred == Predicate.Sge || pred == Predicate.Slt || pred == Predicate.Sle
}

fn intPredCc(pred: Predicate) -> u8 {
  return match pred {
    Predicate.Eq => X86Encode.ccE()
    Predicate.Ne => X86Encode.ccNe()
    Predicate.Ugt => X86Encode.ccA()
    Predicate.Uge => X86Encode.ccAe()
    Predicate.Ult => X86Encode.ccB()
    Predicate.Ule => X86Encode.ccBe()
    Predicate.Sgt => X86Encode.ccG()
    Predicate.Sge => X86Encode.ccGe()
    Predicate.Slt => X86Encode.ccL()
    Predicate.Sle => X86Encode.ccLe()
    _ => X86Encode.ccE()
  }
}

effect fn emitIntCompareRegs(em: &mut Emitter, pred: Predicate, bits: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let signed = isSignedPred(pred)
  run normalizeInt(&mut em.*, X86Encode.rax(), bits, signed)
  run normalizeInt(&mut em.*, X86Encode.rcx(), bits, signed)
  run X86Encode.aluRr64(&mut em.code, Alu.Cmp, X86Encode.rax(), X86Encode.rcx())
  run X86Encode.setcc(&mut em.code, intPredCc(pred), X86Encode.rax())
  return run X86Encode.movzxRr8(&mut em.code, X86Encode.rax(), X86Encode.rax())
}

// Compares 128-bit `(rax:rdx)` against `(r8:r9)`, setting `rax` to 0 or 1.
effect fn emitI128CompareRegs(em: &mut Emitter, pred: Predicate) -> () ! OutOfMemoryError ? &mut Allocator {
  if pred == Predicate.Eq || pred == Predicate.Ne {
    run X86Encode.aluRr64(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.r8())
    run X86Encode.aluRr64(&mut em.code, Alu.Xor, X86Encode.rdx(), X86Encode.r9())
    run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.rax(), X86Encode.rdx())
    run X86Encode.setcc(&mut em.code, if pred == Predicate.Eq { X86Encode.ccE() } else { X86Encode.ccNe() }, X86Encode.rax())
    return run X86Encode.movzxRr8(&mut em.code, X86Encode.rax(), X86Encode.rax())
  }
  // Compare high words first; if equal, compare unsigned low words!
  run X86Encode.aluRr64(&mut em.code, Alu.Cmp, X86Encode.rdx(), X86Encode.r9())
  let eqHi = run emitJcc(&mut em.*, X86Encode.ccE())
  let hiCc = match pred {
    Predicate.Sgt => X86Encode.ccG()
    Predicate.Sge => X86Encode.ccG()
    Predicate.Slt => X86Encode.ccL()
    Predicate.Sle => X86Encode.ccL()
    Predicate.Ugt => X86Encode.ccA()
    Predicate.Uge => X86Encode.ccA()
    Predicate.Ult => X86Encode.ccB()
    _ => X86Encode.ccB()
  }
  run X86Encode.setcc(&mut em.code, hiCc, X86Encode.rax())
  let done = run emitJmp(&mut em.*)
  patchHere(&mut em.*, eqHi)
  run X86Encode.aluRr64(&mut em.code, Alu.Cmp, X86Encode.rax(), X86Encode.r8())
  let loCc = match pred {
    Predicate.Sgt => X86Encode.ccA()
    Predicate.Ugt => X86Encode.ccA()
    Predicate.Sge => X86Encode.ccAe()
    Predicate.Uge => X86Encode.ccAe()
    Predicate.Slt => X86Encode.ccB()
    Predicate.Ult => X86Encode.ccB()
    _ => X86Encode.ccBe()
  }
  run X86Encode.setcc(&mut em.code, loCc, X86Encode.rax())
  patchHere(&mut em.*, done)
  return run X86Encode.movzxRr8(&mut em.code, X86Encode.rax(), X86Encode.rax())
}

// Compares float `xmm0` vs `xmm1`, setting `rax` to 0 or 1 with exact IEEE 754 NaN semantics.
effect fn emitFloatCompareRegs(em: &mut Emitter, pred: Predicate, double: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  match pred {
    Predicate.Ord => {
      run X86Encode.ucomiFloat(&mut em.code, double, 0, 1)
      run X86Encode.setcc(&mut em.code, X86Encode.ccNp(), X86Encode.rax())
    }
    Predicate.Uno => {
      run X86Encode.ucomiFloat(&mut em.code, double, 0, 1)
      run X86Encode.setcc(&mut em.code, X86Encode.ccP(), X86Encode.rax())
    }
    Predicate.Ogt => {
      run X86Encode.ucomiFloat(&mut em.code, double, 0, 1)
      run X86Encode.setcc(&mut em.code, X86Encode.ccA(), X86Encode.rax())
    }
    Predicate.Oge => {
      run X86Encode.ucomiFloat(&mut em.code, double, 0, 1)
      run X86Encode.setcc(&mut em.code, X86Encode.ccAe(), X86Encode.rax())
    }
    Predicate.Olt => {
      run X86Encode.ucomiFloat(&mut em.code, double, 1, 0)
      run X86Encode.setcc(&mut em.code, X86Encode.ccA(), X86Encode.rax())
    }
    Predicate.Ole => {
      run X86Encode.ucomiFloat(&mut em.code, double, 1, 0)
      run X86Encode.setcc(&mut em.code, X86Encode.ccAe(), X86Encode.rax())
    }
    Predicate.Oeq => {
      run X86Encode.ucomiFloat(&mut em.code, double, 0, 1)
      run X86Encode.setcc(&mut em.code, X86Encode.ccE(), X86Encode.rax())
      run X86Encode.setcc(&mut em.code, X86Encode.ccNp(), X86Encode.rdx())
      run X86Encode.aluRr8(&mut em.code, Alu.And, X86Encode.rax(), X86Encode.rdx())
    }
    Predicate.One => {
      run X86Encode.ucomiFloat(&mut em.code, double, 0, 1)
      run X86Encode.setcc(&mut em.code, X86Encode.ccNe(), X86Encode.rax())
      run X86Encode.setcc(&mut em.code, X86Encode.ccNp(), X86Encode.rdx())
      run X86Encode.aluRr8(&mut em.code, Alu.And, X86Encode.rax(), X86Encode.rdx())
    }
    Predicate.Ueq => {
      run X86Encode.ucomiFloat(&mut em.code, double, 0, 1)
      run X86Encode.setcc(&mut em.code, X86Encode.ccE(), X86Encode.rax())
    }
    Predicate.Une => {
      run X86Encode.ucomiFloat(&mut em.code, double, 0, 1)
      run X86Encode.setcc(&mut em.code, X86Encode.ccNe(), X86Encode.rax())
      run X86Encode.setcc(&mut em.code, X86Encode.ccP(), X86Encode.rdx())
      run X86Encode.aluRr8(&mut em.code, Alu.Or, X86Encode.rax(), X86Encode.rdx())
    }
    Predicate.Ugtf => {
      run X86Encode.ucomiFloat(&mut em.code, double, 1, 0)
      run X86Encode.setcc(&mut em.code, X86Encode.ccB(), X86Encode.rax())
    }
    Predicate.Ugef => {
      run X86Encode.ucomiFloat(&mut em.code, double, 1, 0)
      run X86Encode.setcc(&mut em.code, X86Encode.ccBe(), X86Encode.rax())
    }
    Predicate.Ultf => {
      run X86Encode.ucomiFloat(&mut em.code, double, 0, 1)
      run X86Encode.setcc(&mut em.code, X86Encode.ccB(), X86Encode.rax())
    }
    Predicate.Ulef => {
      run X86Encode.ucomiFloat(&mut em.code, double, 0, 1)
      run X86Encode.setcc(&mut em.code, X86Encode.ccBe(), X86Encode.rax())
    }
    _ => {
      run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rax())
    }
  }
  return run X86Encode.movzxRr8(&mut em.code, X86Encode.rax(), X86Encode.rax())
}

effect fn emitSelect(em: &mut Emitter, function: &SsaFunction, kind: Kind, cond: u64, yes: u64, no: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if kind.isVector() {
    return run emitVectorSelect(&mut em.*, function, kind, cond, yes, no, result)
  }
  let condSpill = spilledGpOff(&em.*, function, cond)
  if kind.isFloat() {
    if condSpill != 0 {
      run loadFloat(&mut em.*, function, yes, 0, X86Encode.rax())
      run loadFloat(&mut em.*, function, no, 1, X86Encode.rax())
      drop run X86Encode.testMi8(&mut em.code, Mem.baseDisp(X86Encode.rbp(), condSpill), 1)
    } else {
      let condReg = run regOrLoad(&mut em.*, function, cond, X86Encode.r10())
      run loadFloat(&mut em.*, function, yes, 0, X86Encode.rax())
      run loadFloat(&mut em.*, function, no, 1, X86Encode.rax())
      if isKnownBool(&em.*, cond) {
        run X86Encode.testRr8(&mut em.code, condReg, condReg)
      } else {
        run X86Encode.testRi8(&mut em.code, condReg, 1)
      }
    }
    let takeYes = run emitJcc(&mut em.*, X86Encode.ccNe())
    run X86Encode.movapsRr(&mut em.code, 0, 1)
    patchHere(&mut em.*, takeYes)
    return run storeFloat(&mut em.*, result, 0, kind.bits == 64)
  }
  if kind.bits > 64 {
    if condSpill != 0 {
      run loadPair(&mut em.*, function, yes, X86Encode.rax(), X86Encode.rdx())
      run loadPair(&mut em.*, function, no, X86Encode.r8(), X86Encode.r9())
      drop run X86Encode.testMi8(&mut em.code, Mem.baseDisp(X86Encode.rbp(), condSpill), 1)
    } else {
      run loadGp(&mut em.*, function, cond, X86Encode.r10())
      run loadPair(&mut em.*, function, yes, X86Encode.rax(), X86Encode.rdx())
      run loadPair(&mut em.*, function, no, X86Encode.r8(), X86Encode.r9())
      if isKnownBool(&em.*, cond) {
        run X86Encode.testRr8(&mut em.code, X86Encode.r10(), X86Encode.r10())
      } else {
        run X86Encode.testRi8(&mut em.code, X86Encode.r10(), 1)
      }
    }
    run X86Encode.cmov64(&mut em.code, X86Encode.ccE(), X86Encode.rax(), X86Encode.r8())
    run X86Encode.cmov64(&mut em.code, X86Encode.ccE(), X86Encode.rdx(), X86Encode.r9())
    return run storePair(&mut em.*, result, X86Encode.rax(), X86Encode.rdx())
  }
  if condSpill != 0 {
    let noReg = run regOrLoad(&mut em.*, function, no, X86Encode.r11())
    let rDst = valReg(&em.*, result)
    let workDst = if rDst != X86Frame.regNone() && rDst != noReg { rDst } else { X86Encode.rax() }
    run loadGp(&mut em.*, function, yes, workDst)
    drop run X86Encode.testMi8(&mut em.code, Mem.baseDisp(X86Encode.rbp(), condSpill), 1)
    run X86Encode.cmov64(&mut em.code, X86Encode.ccE(), workDst, noReg)
    return run storeGp(&mut em.*, result, workDst)
  }
  let condReg = run regOrLoad(&mut em.*, function, cond, X86Encode.r10())
  let noReg = run regOrLoad(&mut em.*, function, no, X86Encode.r11())
  let rDst = valReg(&em.*, result)
  let workDst = if rDst != X86Frame.regNone() && rDst != condReg && rDst != noReg { rDst } else { X86Encode.rax() }
  run loadGp(&mut em.*, function, yes, workDst)
  if isKnownBool(&em.*, cond) {
    run X86Encode.testRr8(&mut em.code, condReg, condReg)
  } else {
    run X86Encode.testRi8(&mut em.code, condReg, 1)
  }
  run X86Encode.cmov64(&mut em.code, X86Encode.ccE(), workDst, noReg)
  return run storeGp(&mut em.*, result, workDst)
}

// ---- Casts (All 12 Cast Operations) ----

effect fn emitCast(em: &mut Emitter, function: &SsaFunction, op: Cast, dstKind: Kind, src: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let srcKind = function.value(src).kind
  if op == Cast.Bitcast {
    return run emitBitcast(&mut em.*, function, srcKind, dstKind, src, result)
  }
  if dstKind.isVector() || srcKind.isVector() {
    return run emitVectorCast(&mut em.*, function, op, srcKind, dstKind, src, result)
  }
  match op {
    Cast.Trunc => {
      if srcKind.bits > 64 {
        run loadPair(&mut em.*, function, src, X86Encode.rax(), X86Encode.rdx())
        run normalizeInt(&mut em.*, X86Encode.rax(), dstKind.bits, false)
        return run storeGp(&mut em.*, result, X86Encode.rax())
      }
      let dst = dstRegOrScratch(&em.*, result, X86Encode.rax())
      if dstKind.bits == 32 {
        let sReg = run regOrLoad(&mut em.*, function, src, dst)
        run X86Encode.movRr32(&mut em.code, dst, sReg)
      } else {
        run loadGp(&mut em.*, function, src, dst)
        run normalizeInt(&mut em.*, dst, dstKind.bits, false)
      }
      return run storeGp(&mut em.*, result, dst)
    }
    Cast.ZExt => {
      if dstKind.bits > 64 {
        run loadGp(&mut em.*, function, src, X86Encode.rax())
        if !(srcKind.bits == usize.ONE && isKnownBool(&em.*, src)) && !isZeroExtendedInt(function, src, srcKind.bits) {
          run normalizeInt(&mut em.*, X86Encode.rax(), srcKind.bits, false)
        }
        run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rdx(), X86Encode.rdx())
        return run storePair(&mut em.*, result, X86Encode.rax(), X86Encode.rdx())
      }
      let dst = dstRegOrScratch(&em.*, result, X86Encode.rax())
      if srcKind.bits == 32 {
        let sReg = run regOrLoad(&mut em.*, function, src, dst)
        if !(sReg == dst && isZeroExtendedInt(function, src, 32)) {
          run X86Encode.movRr32(&mut em.code, dst, sReg)
        }
      } else if (srcKind.bits == usize.ONE && isKnownBool(&em.*, src)) || isZeroExtendedInt(function, src, srcKind.bits) {
        run loadGp(&mut em.*, function, src, dst)
      } else {
        run loadGp(&mut em.*, function, src, dst)
        run normalizeInt(&mut em.*, dst, srcKind.bits, false)
      }
      return run storeGp(&mut em.*, result, dst)
    }
    Cast.SExt => {
      if dstKind.bits > 64 {
        run loadGp(&mut em.*, function, src, X86Encode.rax())
        run normalizeInt(&mut em.*, X86Encode.rax(), srcKind.bits, true)
        run X86Encode.movRr64(&mut em.code, X86Encode.rdx(), X86Encode.rax())
        run X86Encode.shiftImm64(&mut em.code, Shift.Sar, X86Encode.rdx(), 63)
        return run storePair(&mut em.*, result, X86Encode.rax(), X86Encode.rdx())
      }
      let dst = dstRegOrScratch(&em.*, result, X86Encode.rax())
      run loadGp(&mut em.*, function, src, dst)
      run normalizeInt(&mut em.*, dst, srcKind.bits, true)
      run normalizeInt(&mut em.*, dst, dstKind.bits, false)
      return run storeGp(&mut em.*, result, dst)
    }
    Cast.IntToPtr => {
      let dst = dstRegOrScratch(&em.*, result, X86Encode.rax())
      run loadGp(&mut em.*, function, src, dst)
      run normalizeInt(&mut em.*, dst, srcKind.bits, false)
      return run storeGp(&mut em.*, result, dst)
    }
    Cast.PtrToInt => {
      let dst = dstRegOrScratch(&em.*, result, X86Encode.rax())
      run loadGp(&mut em.*, function, src, dst)
      run normalizeInt(&mut em.*, dst, dstKind.bits, false)
      return run storeGp(&mut em.*, result, dst)
    }
    Cast.FPTrunc => {
      run loadFloat(&mut em.*, function, src, 0, X86Encode.rax())
      run X86Encode.cvtsd2ss(&mut em.code, 0, 0)
      return run storeFloat(&mut em.*, result, 0, false)
    }
    Cast.FPExt => {
      run loadFloat(&mut em.*, function, src, 0, X86Encode.rax())
      run X86Encode.cvtss2sd(&mut em.code, 0, 0)
      return run storeFloat(&mut em.*, result, 0, true)
    }
    Cast.SIToFP => {
      let double = dstKind.bits == 64
      if srcKind.bits > 64 {
        run loadPair(&mut em.*, function, src, X86Encode.rdi(), X86Encode.rsi())
        run emitI128ToFloat(&mut em.*, true, double)
        return run storeFloat(&mut em.*, result, 0, double)
      }
      run loadGp(&mut em.*, function, src, X86Encode.rax())
      run normalizeInt(&mut em.*, X86Encode.rax(), srcKind.bits, true)
      run X86Encode.cvtsi2Float(&mut em.code, double, true, 0, X86Encode.rax())
      return run storeFloat(&mut em.*, result, 0, double)
    }
    Cast.UIToFP => {
      let double = dstKind.bits == 64
      if srcKind.bits > 64 {
        run loadPair(&mut em.*, function, src, X86Encode.rdi(), X86Encode.rsi())
        run emitI128ToFloat(&mut em.*, false, double)
        return run storeFloat(&mut em.*, result, 0, double)
      }
      run loadGp(&mut em.*, function, src, X86Encode.rax())
      run normalizeInt(&mut em.*, X86Encode.rax(), srcKind.bits, false)
      if srcKind.bits < 64 {
        run X86Encode.cvtsi2Float(&mut em.code, double, true, 0, X86Encode.rax())
      } else {
        // Unsigned 64-bit -> float: if high bit clear, direct `cvtsi2s*`; else `(x >> 1) | (x & 1)`,
        // convert, and double (`addss`/`addsd xmm0, xmm0`) to preserve exact round-to-nearest-even!
        run X86Encode.testRr64(&mut em.code, X86Encode.rax(), X86Encode.rax())
        let highSet = run emitJcc(&mut em.*, X86Encode.ccS())
        run X86Encode.cvtsi2Float(&mut em.code, double, true, 0, X86Encode.rax())
        let done = run emitJmp(&mut em.*)
        patchHere(&mut em.*, highSet)
        run X86Encode.movRr64(&mut em.code, X86Encode.rcx(), X86Encode.rax())
        run X86Encode.shiftImm64(&mut em.code, Shift.Shr, X86Encode.rax(), 1)
        run X86Encode.aluRi64(&mut em.code, Alu.And, X86Encode.rcx(), 1)
        run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.rax(), X86Encode.rcx())
        run X86Encode.cvtsi2Float(&mut em.code, double, true, 0, X86Encode.rax())
        run X86Encode.addFloat(&mut em.code, double, 0, 0)
        patchHere(&mut em.*, done)
      }
      return run storeFloat(&mut em.*, result, 0, double)
    }
    Cast.FPToSI => {
      return run emitFloatToIntSat(&mut em.*, function, srcKind.bits == 64, dstKind.bits, true, src, result)
    }
    Cast.FPToUI => {
      return run emitFloatToIntSat(&mut em.*, function, srcKind.bits == 64, dstKind.bits, false, src, result)
    }
    Cast.Bitcast => { return () }
  }
}

// Returns true when `val` is guaranteed to already have bits `bits..63` cleared in its x86-64
// home register/slot (excludes incoming function arguments and calls whose upper bits may be dirty).
fn isZeroExtendedInt(function: &SsaFunction, val: u64, bits: usize) -> bool {
  if val == none() || bits >= 64 { return false }
  if function.value(val).definition != Definition.Result { return false }
  let prod = function.producerOf(val)
  if prod == usize.MAX { return false }
  let inst = function.instruction(prod)
  return match inst.operation {
    Operation.Load {..} => true
    Operation.AtomicLoad => true
    Operation.Compare {..} => true
    Operation.Count {..} => true
    Operation.Rotate {..} => bits == 32 || bits == 16 || bits == 8
    Operation.Cast {operation} => operation == Cast.Trunc || operation == Cast.ZExt
    Operation.Binary {operation} => {
      if bits == 32 {
        return operation == Binary.Add || operation == Binary.Sub || operation == Binary.Mul
          || operation == Binary.And || operation == Binary.Or || operation == Binary.Xor
          || operation == Binary.Shl || operation == Binary.LShr || operation == Binary.AShr
      }
      return false
    }
    _ => false
  }
}

effect fn emitBitcast(em: &mut Emitter, function: &SsaFunction, srcKind: Kind, dstKind: Kind, src: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let sz = srcKind.storeSize()
  if sz == usize.ZERO { return () }
  if srcKind.isVector() && dstKind.isVector() && sz == 16 && dstKind.storeSize() == 16 {
    let rDst = valXmm(&em.*, result)
    let dstOff = valOff(&em.*, result)
    if rDst == X86Frame.regNone() && dstOff == 0 { return () }
    let workDst = dstXmmOrScratch(&em.*, result, 0)
    run loadVec128(&mut em.*, function, src, workDst)
    return run storeVec128(&mut em.*, result, workDst)
  }
  if hasFeat(&em.*, X86Frame.featAvx2()) && srcKind.isVector() && dstKind.isVector() && sz == 32 && dstKind.storeSize() == 32 && srcKind.isInteger() && dstKind.isInteger() {
    let rDst = valXmm(&em.*, result)
    let dstOff = valOff(&em.*, result)
    if rDst == X86Frame.regNone() && dstOff == 0 { return () }
    let workDst = dstXmmOrScratch(&em.*, result, 0)
    run loadVec256(&mut em.*, function, src, workDst)
    return run storeVec256(&mut em.*, result, workDst)
  }
  if !srcKind.isVector() && !dstKind.isVector() && sz <= 8 {
    if srcKind.isFloat() {
      run loadFloat(&mut em.*, function, src, 0, X86Encode.rax())
      if srcKind.bits == 64 { run X86Encode.movqFromXmm(&mut em.code, X86Encode.rax(), 0) }
      else { run X86Encode.movdFromXmm(&mut em.code, X86Encode.rax(), 0) }
    } else {
      run loadGp(&mut em.*, function, src, X86Encode.rax())
    }
    if dstKind.isFloat() {
      if dstKind.bits == 64 {
        run X86Encode.movqToXmm(&mut em.code, 0, X86Encode.rax())
        return run storeFloat(&mut em.*, result, 0, true)
      }
      run X86Encode.movdToXmm(&mut em.code, 0, X86Encode.rax())
      return run storeFloat(&mut em.*, result, 0, false)
    }
    return run storeGp(&mut em.*, result, X86Encode.rax())
  }
  if sz == 1 || sz == 2 || sz == 4 || sz == 8 {
    if dstKind.isVector() && valOff(&em.*, result) == 0 { return () }
    if srcKind.isVector() {
      run loadSmallVecGp(&mut em.*, function, src, X86Encode.rax())
    } else if srcKind.isFloat() {
      run loadFloat(&mut em.*, function, src, 0, X86Encode.rax())
      if srcKind.bits == 64 { run X86Encode.movqFromXmm(&mut em.code, X86Encode.rax(), 0) }
      else { run X86Encode.movdFromXmm(&mut em.code, X86Encode.rax(), 0) }
    } else {
      run loadGp(&mut em.*, function, src, X86Encode.rax())
    }
    if dstKind.isVector() {
      let dstOff = valOff(&em.*, result)
      return run storeSmallVecMem(&mut em.*, sz, Mem.baseDisp(X86Encode.rbp(), dstOff), X86Encode.rax())
    }
    if dstKind.isFloat() {
      if dstKind.bits == 64 {
        run X86Encode.movqToXmm(&mut em.code, 0, X86Encode.rax())
        return run storeFloat(&mut em.*, result, 0, true)
      }
      run X86Encode.movdToXmm(&mut em.code, 0, X86Encode.rax())
      return run storeFloat(&mut em.*, result, 0, false)
    }
    return run storeGp(&mut em.*, result, X86Encode.rax())
  }
  // General byte-exact bitcast (vectors, i128 <-> v128, etc.).
  let dstOff = valOff(&em.*, result)
  if dstOff == 0 { return () }
  if srcKind.isVector() && sz == 16 {
    run loadVec128(&mut em.*, function, src, 0)
    drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff), 0)
    return ()
  }
  if srcKind.isVector() && sz == 32 {
    run vectorAddr(&mut em.*, function, src, X86Encode.r10())
    drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(X86Encode.r10(), 0))
    drop run X86Encode.movdquRm(&mut em.code, 1, Mem.baseDisp(X86Encode.r10(), 16))
    drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff), 0)
    drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff + 16), 1)
    return ()
  }
  if srcKind.isVector() {
    run vectorAddr(&mut em.*, function, src, X86Encode.rsi())
  } else if srcKind.bits > 64 {
    run loadPair(&mut em.*, function, src, X86Encode.rax(), X86Encode.rdx())
    drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff), X86Encode.rax())
    drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff + 8), X86Encode.rdx())
    return ()
  } else {
    run loadGp(&mut em.*, function, src, X86Encode.rax())
    drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff), X86Encode.rax())
    return ()
  }
  drop run X86Encode.lea64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rbp(), dstOff))
  run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), usize.toU64(sz))
  return run X86Encode.repMovsb(&mut em.code)
}

// Saturating float-to-integer conversion (NaN -> 0, out-of-range -> MIN / MAX).
effect fn emitFloatToIntSat(
  em: &mut Emitter,
  function: &SsaFunction,
  double: bool,
  dstBits: usize,
  signed: bool,
  src: u64,
  result: u64,
) -> () ! OutOfMemoryError ? &mut Allocator {
  run loadFloat(&mut em.*, function, src, 0, X86Encode.rax())
  // Promote f32 to f64 in xmm0 so threshold checks are uniform in double precision!
  if !double {
    run X86Encode.cvtss2sd(&mut em.code, 0, 0)
  }
  if dstBits > 64 {
    run emitFloat64ToI128Sat(&mut em.*, signed)
    return run storePair(&mut em.*, result, X86Encode.rax(), X86Encode.rdx())
  }
  // Check NaN: `ucomisd xmm0, xmm0; jp isNan`.
  run X86Encode.ucomiFloat(&mut em.code, true, 0, 0)
  let isNan = run emitJcc(&mut em.*, X86Encode.ccP())

  if signed {
    // Signed dstBits (1..64): min = -2^(bits-1), maxUpper = +2^(bits-1) (exact power of 2 in f64!).
    let expBits: u64 = 1023 + usize.toU64(dstBits - usize.ONE)
    let upperF64 = u64.shiftLeft(expBits, 52)
    let lowerF64 = upperF64 | 0x8000000000000000
    let minInt = u64.shiftLeft(1, usize.toU64(dstBits - usize.ONE))
    let maxInt = minInt - 1
    // Check x <= lowerF64 -> clamp minInt.
    run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), lowerF64)
    run X86Encode.movqToXmm(&mut em.code, 1, X86Encode.rcx())
    run X86Encode.ucomiFloat(&mut em.code, true, 0, 1)
    let belowMin = run emitJcc(&mut em.*, X86Encode.ccBe())
    // Check x >= upperF64 -> clamp maxInt.
    run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), upperF64)
    run X86Encode.movqToXmm(&mut em.code, 1, X86Encode.rcx())
    run X86Encode.ucomiFloat(&mut em.code, true, 0, 1)
    let aboveMax = run emitJcc(&mut em.*, X86Encode.ccAe())
    // In range: `cvttsd2si rax, xmm0`.
    run X86Encode.cvttFloat2Si(&mut em.code, true, true, X86Encode.rax(), 0)
    run normalizeInt(&mut em.*, X86Encode.rax(), dstBits, false)
    let done1 = run emitJmp(&mut em.*)
    patchHere(&mut em.*, isNan)
    run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rax())
    let done2 = run emitJmp(&mut em.*)
    patchHere(&mut em.*, belowMin)
    run X86Encode.movImm64(&mut em.code, X86Encode.rax(), maskBits(minInt, dstBits))
    let done3 = run emitJmp(&mut em.*)
    patchHere(&mut em.*, aboveMax)
    run X86Encode.movImm64(&mut em.code, X86Encode.rax(), maxInt)
    let end = Bytes.length(&em.code)
    patchTo(&mut em.*, done1, end)
    patchTo(&mut em.*, done2, end)
    patchTo(&mut em.*, done3, end)
    return run storeGp(&mut em.*, result, X86Encode.rax())
  }

  // Unsigned dstBits (1..64): <= 0.0 -> 0; >= 2^dstBits -> (2^dstBits - 1).
  run X86Encode.pxor(&mut em.code, 1, 1)
  run X86Encode.ucomiFloat(&mut em.code, true, 0, 1)
  let belowZero = run emitJcc(&mut em.*, X86Encode.ccBe())
  let upperExp: u64 = 1023 + usize.toU64(dstBits)
  let upperF64 = u64.shiftLeft(upperExp, 52)
  let maxUint = if dstBits == 64 { u64.MAX } else { u64.shiftLeft(1, usize.toU64(dstBits)) - 1 }
  run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), upperF64)
  run X86Encode.movqToXmm(&mut em.code, 1, X86Encode.rcx())
  run X86Encode.ucomiFloat(&mut em.code, true, 0, 1)
  let aboveMax = run emitJcc(&mut em.*, X86Encode.ccAe())
  if dstBits < 64 {
    run X86Encode.cvttFloat2Si(&mut em.code, true, true, X86Encode.rax(), 0)
  } else {
    // Unsigned 64-bit in range (0, 2^64): if >= 2^63, subtract 2^63, cvttsd2si, add 2^63.
    let two63 = u64.shiftLeft(1023 + 63, 52)
    run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), two63)
    run X86Encode.movqToXmm(&mut em.code, 1, X86Encode.rcx())
    run X86Encode.ucomiFloat(&mut em.code, true, 0, 1)
    let geHalf = run emitJcc(&mut em.*, X86Encode.ccAe())
    run X86Encode.cvttFloat2Si(&mut em.code, true, true, X86Encode.rax(), 0)
    let uDone = run emitJmp(&mut em.*)
    patchHere(&mut em.*, geHalf)
    run X86Encode.subFloat(&mut em.code, true, 0, 1)
    run X86Encode.cvttFloat2Si(&mut em.code, true, true, X86Encode.rax(), 0)
    run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), 0x8000000000000000)
    run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.rax(), X86Encode.rcx())
    patchHere(&mut em.*, uDone)
  }
  let done1 = run emitJmp(&mut em.*)
  let zeroLbl = Bytes.length(&em.code)
  patchTo(&mut em.*, isNan, zeroLbl)
  patchTo(&mut em.*, belowZero, zeroLbl)
  run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rax())
  let done2 = run emitJmp(&mut em.*)
  patchHere(&mut em.*, aboveMax)
  run X86Encode.movImm64(&mut em.code, X86Encode.rax(), maxUint)
  let end = Bytes.length(&em.code)
  patchTo(&mut em.*, done1, end)
  patchTo(&mut em.*, done2, end)
  return run storeGp(&mut em.*, result, X86Encode.rax())
}

// Converts 128-bit `(rdi=lo, rsi=hi)` to float in `xmm0`.
effect fn emitI128ToFloat(em: &mut Emitter, signed: bool, double: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  // Compute: f64(hi) * 2^64 + f64(unsigned lo) in xmm0, handling sign for signed i128.
  run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.r9(), X86Encode.r9())
  if signed {
    run X86Encode.testRr64(&mut em.code, X86Encode.rsi(), X86Encode.rsi())
    let nonNeg = run emitJcc(&mut em.*, X86Encode.ccNs())
    run X86Encode.movImm32(&mut em.code, X86Encode.r9(), 1)
    run X86Encode.neg64(&mut em.code, X86Encode.rdi())
    run X86Encode.aluRi64(&mut em.code, Alu.Adc, X86Encode.rsi(), 0)
    run X86Encode.neg64(&mut em.code, X86Encode.rsi())
    patchHere(&mut em.*, nonNeg)
  }
  // Convert unsigned `rsi` -> `xmm0`, multiply by 2^64 (`0x43F0000000000000`).
  run emitU64ToF64(&mut em.*, X86Encode.rsi(), 0)
  run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), 0x43F0000000000000)
  run X86Encode.movqToXmm(&mut em.code, 2, X86Encode.rcx())
  run X86Encode.mulFloat(&mut em.code, true, 0, 2)
  // Convert unsigned `rdi` -> `xmm1`, add to `xmm0`.
  run emitU64ToF64(&mut em.*, X86Encode.rdi(), 1)
  run X86Encode.addFloat(&mut em.code, true, 0, 1)
  if signed {
    run X86Encode.testRr64(&mut em.code, X86Encode.r9(), X86Encode.r9())
    let keepPos = run emitJcc(&mut em.*, X86Encode.ccE())
    run X86Encode.movqFromXmm(&mut em.code, X86Encode.rax(), 0)
    run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), 0x8000000000000000)
    run X86Encode.aluRr64(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rcx())
    run X86Encode.movqToXmm(&mut em.code, 0, X86Encode.rax())
    patchHere(&mut em.*, keepPos)
  }
  if !double {
    return run X86Encode.cvtsd2ss(&mut em.code, 0, 0)
  }
  return ()
}

effect fn emitU64ToF64(em: &mut Emitter, srcReg: u8, dstXmm: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  run X86Encode.movRr64(&mut em.code, X86Encode.rax(), srcReg)
  run X86Encode.testRr64(&mut em.code, X86Encode.rax(), X86Encode.rax())
  let highSet = run emitJcc(&mut em.*, X86Encode.ccS())
  run X86Encode.cvtsi2Float(&mut em.code, true, true, dstXmm, X86Encode.rax())
  let done = run emitJmp(&mut em.*)
  patchHere(&mut em.*, highSet)
  run X86Encode.movRr64(&mut em.code, X86Encode.rcx(), X86Encode.rax())
  run X86Encode.shiftImm64(&mut em.code, Shift.Shr, X86Encode.rax(), 1)
  run X86Encode.aluRi64(&mut em.code, Alu.And, X86Encode.rcx(), 1)
  run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.rax(), X86Encode.rcx())
  run X86Encode.cvtsi2Float(&mut em.code, true, true, dstXmm, X86Encode.rax())
  run X86Encode.addFloat(&mut em.code, true, dstXmm, dstXmm)
  patchHere(&mut em.*, done)
  return ()
}

// Saturating `f64` in `xmm0` -> 128-bit integer in `(rax, rdx)`.
effect fn emitFloat64ToI128Sat(em: &mut Emitter, signed: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  // Decode IEEE 754 f64 bits in `r8`: sign (bit 63), exp (bits 52..62), mantissa (bits 0..51).
  run X86Encode.movqFromXmm(&mut em.code, X86Encode.r8(), 0)
  // Extract biased exponent into `rcx`.
  run X86Encode.movRr64(&mut em.code, X86Encode.rcx(), X86Encode.r8())
  run X86Encode.shiftImm64(&mut em.code, Shift.Shr, X86Encode.rcx(), 52)
  run X86Encode.aluRi32(&mut em.code, Alu.And, X86Encode.rcx(), 0x7FF)
  // Extract sign bit into `r9` (0 or 1).
  run X86Encode.movRr64(&mut em.code, X86Encode.r9(), X86Encode.r8())
  run X86Encode.shiftImm64(&mut em.code, Shift.Shr, X86Encode.r9(), 63)
  // If exp == 0x7FF and mantissa != 0 -> NaN -> return 0.
  run X86Encode.movImm64(&mut em.code, X86Encode.r10(), 0x000FFFFFFFFFFFFF)
  run X86Encode.aluRr64(&mut em.code, Alu.And, X86Encode.r8(), X86Encode.r10())
  run X86Encode.aluRi32(&mut em.code, Alu.Cmp, X86Encode.rcx(), 0x7FF)
  let notSpecial = run emitJcc(&mut em.*, X86Encode.ccNe())
  run X86Encode.testRr64(&mut em.code, X86Encode.r8(), X86Encode.r8())
  let isInf = run emitJcc(&mut em.*, X86Encode.ccE())
  // NaN -> 0.
  run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rax())
  run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rdx(), X86Encode.rdx())
  let doneNan = run emitJmp(&mut em.*)

  patchHere(&mut em.*, notSpecial)
  // If exp < 1023 (|x| < 1.0) -> return 0.
  run X86Encode.aluRi32(&mut em.code, Alu.Cmp, X86Encode.rcx(), 1023)
  let geOne = run emitJcc(&mut em.*, X86Encode.ccAe())
  run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rax())
  run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rdx(), X86Encode.rdx())
  let doneSmall = run emitJmp(&mut em.*)

  patchHere(&mut em.*, geOne)
  if !signed {
    // Negative -> 0.
    run X86Encode.testRr64(&mut em.code, X86Encode.r9(), X86Encode.r9())
    let posOk = run emitJcc(&mut em.*, X86Encode.ccE())
    run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rax())
    run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rdx(), X86Encode.rdx())
    let doneNeg = run emitJmp(&mut em.*)
    patchHere(&mut em.*, posOk)
    // If exp >= 1023 + 128 -> clamp u128::MAX.
    run X86Encode.aluRi32(&mut em.code, Alu.Cmp, X86Encode.rcx(), 1151)
    let inRange = run emitJcc(&mut em.*, X86Encode.ccB())
    let satMaxU = Bytes.length(&em.code)
    patchTo(&mut em.*, isInf, satMaxU)
    run X86Encode.testRr64(&mut em.code, X86Encode.r9(), X86Encode.r9())
    let infNeg = run emitJcc(&mut em.*, X86Encode.ccNe())
    run X86Encode.movImm64(&mut em.code, X86Encode.rax(), u64.MAX)
    run X86Encode.movImm64(&mut em.code, X86Encode.rdx(), u64.MAX)
    let doneMax = run emitJmp(&mut em.*)
    patchHere(&mut em.*, infNeg)
    run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rax())
    run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rdx(), X86Encode.rdx())
    let doneInfNeg = run emitJmp(&mut em.*)

    // In-range magnitude: `(1 << 52) | mantissa` shifted by `exp - 1023 - 52`.
    patchHere(&mut em.*, inRange)
    run emitMantissaShift128(&mut em.*)
    let end = Bytes.length(&em.code)
    patchTo(&mut em.*, doneNan, end)
    patchTo(&mut em.*, doneSmall, end)
    patchTo(&mut em.*, doneNeg, end)
    patchTo(&mut em.*, doneMax, end)
    patchTo(&mut em.*, doneInfNeg, end)
    return ()
  }

  // Signed i128: if exp >= 1023 + 127 (1150) -> clamp INT128_MIN (neg) or INT128_MAX (pos).
  run X86Encode.aluRi32(&mut em.code, Alu.Cmp, X86Encode.rcx(), 1150)
  let inRange = run emitJcc(&mut em.*, X86Encode.ccB())
  let satS = Bytes.length(&em.code)
  patchTo(&mut em.*, isInf, satS)
  run X86Encode.testRr64(&mut em.code, X86Encode.r9(), X86Encode.r9())
  let clampNeg = run emitJcc(&mut em.*, X86Encode.ccNe())
  run X86Encode.movImm64(&mut em.code, X86Encode.rax(), u64.MAX)
  run X86Encode.movImm64(&mut em.code, X86Encode.rdx(), 0x7FFFFFFFFFFFFFFF)
  let doneMaxS = run emitJmp(&mut em.*)
  patchHere(&mut em.*, clampNeg)
  run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rax())
  run X86Encode.movImm64(&mut em.code, X86Encode.rdx(), 0x8000000000000000)
  let doneMinS = run emitJmp(&mut em.*)

  patchHere(&mut em.*, inRange)
  run emitMantissaShift128(&mut em.*)
  run X86Encode.testRr64(&mut em.code, X86Encode.r9(), X86Encode.r9())
  let posDone = run emitJcc(&mut em.*, X86Encode.ccE())
  run X86Encode.neg64(&mut em.code, X86Encode.rax())
  run X86Encode.aluRi64(&mut em.code, Alu.Adc, X86Encode.rdx(), 0)
  run X86Encode.neg64(&mut em.code, X86Encode.rdx())
  let end = Bytes.length(&em.code)
  patchTo(&mut em.*, doneNan, end)
  patchTo(&mut em.*, doneSmall, end)
  patchTo(&mut em.*, doneMaxS, end)
  patchTo(&mut em.*, doneMinS, end)
  patchTo(&mut em.*, posDone, end)
  return ()
}

// Given biased exponent `rcx` in [1023, 1150] and 52-bit mantissa `r8`, computes
// `((1 << 52) | r8) << (rcx - 1075)` (or `>> (1075 - rcx)`) into `(rax, rdx)`.
effect fn emitMantissaShift128(em: &mut Emitter) -> () ! OutOfMemoryError ? &mut Allocator {
  run X86Encode.movImm64(&mut em.code, X86Encode.rax(), 0x0010000000000000)
  run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.rax(), X86Encode.r8())
  run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rdx(), X86Encode.rdx())
  run X86Encode.aluRi32(&mut em.code, Alu.Sub, X86Encode.rcx(), 1075)
  let shiftLeft = run emitJcc(&mut em.*, X86Encode.ccGe())
  // Shift right by `-rcx`.
  run X86Encode.neg32(&mut em.code, X86Encode.rcx())
  run X86Encode.shiftCl64(&mut em.code, Shift.Shr, X86Encode.rax())
  let doneR = run emitJmp(&mut em.*)
  patchHere(&mut em.*, shiftLeft)
  run X86Encode.aluRi32(&mut em.code, Alu.Cmp, X86Encode.rcx(), 64)
  let wide = run emitJcc(&mut em.*, X86Encode.ccAe())
  run X86Encode.shldCl64(&mut em.code, X86Encode.rdx(), X86Encode.rax())
  run X86Encode.shiftCl64(&mut em.code, Shift.Shl, X86Encode.rax())
  let doneL = run emitJmp(&mut em.*)
  patchHere(&mut em.*, wide)
  run X86Encode.movRr64(&mut em.code, X86Encode.rdx(), X86Encode.rax())
  run X86Encode.shiftCl64(&mut em.code, Shift.Shl, X86Encode.rdx())
  run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rax())
  let end = Bytes.length(&em.code)
  patchTo(&mut em.*, doneR, end)
  patchTo(&mut em.*, doneL, end)
  return ()
}

// ---- Overflow, Saturate, Rotate, Count, Extreme, FMA, Sqrt ----

effect fn emitOverflow(em: &mut Emitter, function: &SsaFunction, op: Binary, signed: bool, kind: Kind, left: u64, right: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if kind.isVector() {
    return run emitVectorOverflow(&mut em.*, function, op, signed, kind, left, right, result)
  }
  if kind.bits > 64 {
    return run emitI128Overflow(&mut em.*, function, op, signed, left, right, result)
  }
  if kind.bits == 8 || kind.bits == 16 || kind.bits == 32 || kind.bits == 64 {
    let flagCc = run emitScalarOverflowCore(&mut em.*, function, op, signed, kind.bits, left, right, result)
    let ovfVal = result + 1
    if valReg(&em.*, ovfVal) != X86Frame.regNone() || valOff(&em.*, ovfVal) != 0 {
      let ovfDst = dstRegOrScratch(&em.*, ovfVal, X86Encode.r11())
      run X86Encode.setcc(&mut em.code, flagCc, ovfDst)
      run X86Encode.movzxRr8(&mut em.code, ovfDst, ovfDst)
      run storeGp(&mut em.*, ovfVal, ovfDst)
    }
    return ()
  }
  run loadGp(&mut em.*, function, left, X86Encode.rax())
  run loadGp(&mut em.*, function, right, X86Encode.rcx())
  run emitScalarOverflowRegs(&mut em.*, op, signed, kind.bits)
  run storeGp(&mut em.*, result, X86Encode.rax())
  return run storeGp(&mut em.*, result + 1, X86Encode.rdx())
}

// Emits scalar `{8,16,32,64}`-bit `Add`/`Sub`/`Mul` overflow op, stores the wrapped arithmetic
// `result` (via `mov` / `movzx`, preserving hardware EFLAGS!), and returns the x86 condition code
// that is true iff overflow occurred.
effect fn emitScalarOverflowCore(
  em: &mut Emitter,
  function: &SsaFunction,
  op: Binary,
  signed: bool,
  bits: usize,
  left: u64,
  right: u64,
  result: u64,
) -> u8 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  if op == Binary.Add || op == Binary.Sub {
    let flagCc = if signed { X86Encode.ccO() } else { X86Encode.ccB() }
    let aluOp = if op == Binary.Add { Alu.Add } else { Alu.Sub }
    let mut lhs = left
    let mut rhs = right
    let mut hasImm = false
    let mut immVal: i32 = 0
    let mut imm8: u8 = 0
    if bits == 64 || bits == 32 {
      let mut imm = constBitsImm32(function, rhs, bits)
      if !imm.ok && op == Binary.Add {
        let lhsImm = constBitsImm32(function, lhs, bits)
        if lhsImm.ok {
          lhs = right
          rhs = left
          imm = lhsImm
        }
      }
      if imm.ok {
        hasImm = true
        immVal = imm.value
      }
    } else if bits == 16 {
      if function.isBits(rhs) {
        let c16 = function.constantOf(rhs).low & 0xFFFF
        immVal = if c16 >= 32768 { u64.wrappingToI32(c16) - 65536 } else { u64.wrappingToI32(c16) }
        hasImm = true
      } else if op == Binary.Add && function.isBits(lhs) {
        let c16 = function.constantOf(lhs).low & 0xFFFF
        immVal = if c16 >= 32768 { u64.wrappingToI32(c16) - 65536 } else { u64.wrappingToI32(c16) }
        lhs = right
        rhs = left
        hasImm = true
      }
    } else {
      // bits == 8
      if function.isBits(rhs) {
        imm8 = u64.wrappingToU8(function.constantOf(rhs).low & 0xFF)
        hasImm = true
      } else if op == Binary.Add && function.isBits(lhs) {
        imm8 = u64.wrappingToU8(function.constantOf(lhs).low & 0xFF)
        lhs = right
        rhs = left
        hasImm = true
      }
    }
    if !hasImm && op == Binary.Add && spilledGpOff(&em.*, function, rhs) == 0 && spilledGpOff(&em.*, function, lhs) != 0 {
      let tmp = lhs
      lhs = rhs
      rhs = tmp
    }
    let rDst = valReg(&em.*, result)
    let rRhs = if hasImm { X86Frame.regNone() } else { valReg(&em.*, rhs) }
    let workDst = if rDst != X86Frame.regNone() && rDst != rRhs { rDst } else { X86Encode.rax() }
    run loadGp(&mut em.*, function, lhs, workDst)
    if hasImm {
      if bits == 64 {
        run X86Encode.aluRi64(&mut em.code, aluOp, workDst, immVal)
      } else if bits == 32 {
        run X86Encode.aluRi32(&mut em.code, aluOp, workDst, immVal)
      } else if bits == 16 {
        run X86Encode.aluRi16(&mut em.code, aluOp, workDst, immVal)
        run X86Encode.movzxRr16(&mut em.code, workDst, workDst)
      } else {
        run X86Encode.aluRi8(&mut em.code, aluOp, workDst, imm8)
        run X86Encode.movzxRr8(&mut em.code, workDst, workDst)
      }
    } else {
      let rhsSpill = spilledGpOff(&em.*, function, rhs)
      if rhsSpill != 0 {
        let mem = Mem.baseDisp(X86Encode.rbp(), rhsSpill)
        if bits == 64 {
          drop run X86Encode.aluRm64(&mut em.code, aluOp, workDst, mem)
        } else if bits == 32 {
          drop run X86Encode.aluRm32(&mut em.code, aluOp, workDst, mem)
        } else if bits == 16 {
          drop run X86Encode.aluRm16(&mut em.code, aluOp, workDst, mem)
          run X86Encode.movzxRr16(&mut em.code, workDst, workDst)
        } else {
          drop run X86Encode.aluRm8(&mut em.code, aluOp, workDst, mem)
          run X86Encode.movzxRr8(&mut em.code, workDst, workDst)
        }
      } else {
        let rhsReg = run regOrLoad(&mut em.*, function, rhs, X86Encode.r11())
        if bits == 64 {
          run X86Encode.aluRr64(&mut em.code, aluOp, workDst, rhsReg)
        } else if bits == 32 {
          run X86Encode.aluRr32(&mut em.code, aluOp, workDst, rhsReg)
        } else if bits == 16 {
          run X86Encode.aluRr16(&mut em.code, aluOp, workDst, rhsReg)
          run X86Encode.movzxRr16(&mut em.code, workDst, workDst)
        } else {
          run X86Encode.aluRr8(&mut em.code, aluOp, workDst, rhsReg)
          run X86Encode.movzxRr8(&mut em.code, workDst, workDst)
        }
      }
    }
    run storeGp(&mut em.*, result, workDst)
    return flagCc
  }
  // Multiply with overflow (`Binary.Mul`): all x86 `mul`/`imul` set `OF == CF` on overflow.
  if signed && (bits == 64 || bits == 32 || bits == 16) {
    let mut lhs = left
    let mut rhs = right
    if bits != 16 && spilledGpOff(&em.*, function, rhs) == 0 && spilledGpOff(&em.*, function, lhs) != 0 {
      lhs = right
      rhs = left
    }
    let rDst = valReg(&em.*, result)
    let rRhs = valReg(&em.*, rhs)
    let workDst = if rDst != X86Frame.regNone() && rDst != rRhs { rDst } else { X86Encode.rax() }
    run loadGp(&mut em.*, function, lhs, workDst)
    let rhsSpill = if bits == 16 { 0 } else { spilledGpOff(&em.*, function, rhs) }
    if rhsSpill != 0 {
      let mem = Mem.baseDisp(X86Encode.rbp(), rhsSpill)
      if bits == 64 {
        drop run X86Encode.imulRm64(&mut em.code, workDst, mem)
      } else {
        drop run X86Encode.imulRm32(&mut em.code, workDst, mem)
      }
    } else {
      let rhsReg = run regOrLoad(&mut em.*, function, rhs, X86Encode.r11())
      if bits == 64 {
        run X86Encode.imulRr64(&mut em.code, workDst, rhsReg)
      } else if bits == 32 {
        run X86Encode.imulRr32(&mut em.code, workDst, rhsReg)
      } else {
        run X86Encode.imulRr16(&mut em.code, workDst, rhsReg)
        run X86Encode.movzxRr16(&mut em.code, workDst, workDst)
      }
    }
    run storeGp(&mut em.*, result, workDst)
    return X86Encode.ccO()
  }
  // Unsigned `Mul` (`8/16/32/64`) and signed 8-bit `imulOne8`: implicit `rax` accumulator.
  run loadGp(&mut em.*, function, left, X86Encode.rax())
  let rhsReg = run regOrLoad(&mut em.*, function, right, X86Encode.rcx())
  if bits == 64 {
    run X86Encode.mul64(&mut em.code, rhsReg)
  } else if bits == 32 {
    run X86Encode.mul32(&mut em.code, rhsReg)
  } else if bits == 16 {
    run X86Encode.mul16(&mut em.code, rhsReg)
    run X86Encode.movzxRr16(&mut em.code, X86Encode.rax(), X86Encode.rax())
  } else {
    if signed {
      run X86Encode.imulOne8(&mut em.code, rhsReg)
    } else {
      run X86Encode.mul8(&mut em.code, rhsReg)
    }
    run X86Encode.movzxRr8(&mut em.code, X86Encode.rax(), X86Encode.rax())
  }
  run storeGp(&mut em.*, result, X86Encode.rax())
  return X86Encode.ccO()
}

// Computes `(rax = wrapped, rdx = overflow 0/1)` for `bits <= 64` from inputs `(rax, rcx)`.
effect fn emitScalarOverflowRegs(em: &mut Emitter, op: Binary, signed: bool, bits: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let flagCc = if signed { X86Encode.ccO() } else { X86Encode.ccB() }
  if op == Binary.Add || op == Binary.Sub {
    let aluOp = if op == Binary.Add { Alu.Add } else { Alu.Sub }
    if bits == 8 {
      run X86Encode.aluRr8(&mut em.code, aluOp, X86Encode.rax(), X86Encode.rcx())
      run X86Encode.setcc(&mut em.code, flagCc, X86Encode.rdx())
      run X86Encode.movzxRr8(&mut em.code, X86Encode.rax(), X86Encode.rax())
      return run X86Encode.movzxRr8(&mut em.code, X86Encode.rdx(), X86Encode.rdx())
    }
    if bits == 16 {
      run X86Encode.aluRr16(&mut em.code, aluOp, X86Encode.rax(), X86Encode.rcx())
      run X86Encode.setcc(&mut em.code, flagCc, X86Encode.rdx())
      run X86Encode.movzxRr16(&mut em.code, X86Encode.rax(), X86Encode.rax())
      return run X86Encode.movzxRr8(&mut em.code, X86Encode.rdx(), X86Encode.rdx())
    }
    if bits == 32 {
      run X86Encode.aluRr32(&mut em.code, aluOp, X86Encode.rax(), X86Encode.rcx())
      run X86Encode.setcc(&mut em.code, flagCc, X86Encode.rdx())
      return run X86Encode.movzxRr8(&mut em.code, X86Encode.rdx(), X86Encode.rdx())
    }
    if bits == 64 {
      run X86Encode.aluRr64(&mut em.code, aluOp, X86Encode.rax(), X86Encode.rcx())
      run X86Encode.setcc(&mut em.code, flagCc, X86Encode.rdx())
      return run X86Encode.movzxRr8(&mut em.code, X86Encode.rdx(), X86Encode.rdx())
    }
    // Arbitrary bit width `1..63`: shift left by `64 - bits` so overflow lands in bit 63!
    let sh = usize.toU8(64 - bits)
    run X86Encode.shiftImm64(&mut em.code, Shift.Shl, X86Encode.rax(), sh)
    run X86Encode.shiftImm64(&mut em.code, Shift.Shl, X86Encode.rcx(), sh)
    run X86Encode.aluRr64(&mut em.code, aluOp, X86Encode.rax(), X86Encode.rcx())
    run X86Encode.setcc(&mut em.code, flagCc, X86Encode.rdx())
    run X86Encode.shiftImm64(&mut em.code, Shift.Shr, X86Encode.rax(), sh)
    return run X86Encode.movzxRr8(&mut em.code, X86Encode.rdx(), X86Encode.rdx())
  }
  // Multiply with overflow (`Mul`).
  if bits == 64 {
    if signed { run X86Encode.imulOne64(&mut em.code, X86Encode.rcx()) }
    else { run X86Encode.mul64(&mut em.code, X86Encode.rcx()) }
    run X86Encode.setcc(&mut em.code, X86Encode.ccO(), X86Encode.rdx())
    return run X86Encode.movzxRr8(&mut em.code, X86Encode.rdx(), X86Encode.rdx())
  }
  // For `bits < 64`, widen both operands to 64 bits, multiply in 64-bit, check if normalized
  // product equals the exact 64-bit product!
  run normalizeInt(&mut em.*, X86Encode.rax(), bits, signed)
  run normalizeInt(&mut em.*, X86Encode.rcx(), bits, signed)
  run X86Encode.imulRr64(&mut em.code, X86Encode.rax(), X86Encode.rcx())
  run X86Encode.movRr64(&mut em.code, X86Encode.r10(), X86Encode.rax())
  run normalizeInt(&mut em.*, X86Encode.r10(), bits, signed)
  run X86Encode.aluRr64(&mut em.code, Alu.Cmp, X86Encode.rax(), X86Encode.r10())
  run X86Encode.setcc(&mut em.code, X86Encode.ccNe(), X86Encode.rdx())
  run normalizeInt(&mut em.*, X86Encode.rax(), bits, false)
  return run X86Encode.movzxRr8(&mut em.code, X86Encode.rdx(), X86Encode.rdx())
}

effect fn emitI128Overflow(em: &mut Emitter, function: &SsaFunction, op: Binary, signed: bool, left: u64, right: u64, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  run loadPair(&mut em.*, function, left, X86Encode.rax(), X86Encode.rdx())
  run loadPair(&mut em.*, function, right, X86Encode.r8(), X86Encode.r9())
  let flagCc = if signed { X86Encode.ccO() } else { X86Encode.ccB() }
  if op == Binary.Add {
    run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.rax(), X86Encode.r8())
    run X86Encode.aluRr64(&mut em.code, Alu.Adc, X86Encode.rdx(), X86Encode.r9())
    run X86Encode.setcc(&mut em.code, flagCc, X86Encode.rcx())
    run X86Encode.movzxRr8(&mut em.code, X86Encode.rcx(), X86Encode.rcx())
    run storePair(&mut em.*, result, X86Encode.rax(), X86Encode.rdx())
    return run storeGp(&mut em.*, result + 1, X86Encode.rcx())
  }
  if op == Binary.Sub {
    run X86Encode.aluRr64(&mut em.code, Alu.Sub, X86Encode.rax(), X86Encode.r8())
    run X86Encode.aluRr64(&mut em.code, Alu.Sbb, X86Encode.rdx(), X86Encode.r9())
    run X86Encode.setcc(&mut em.code, flagCc, X86Encode.rcx())
    run X86Encode.movzxRr8(&mut em.code, X86Encode.rcx(), X86Encode.rcx())
    run storePair(&mut em.*, result, X86Encode.rax(), X86Encode.rdx())
    return run storeGp(&mut em.*, result + 1, X86Encode.rcx())
  }
  // 128-bit multiply overflow: save inputs in rsi:rdi and r8:r9, compute wrapped product and check
  // high 128 bits of full 256-bit product!
  run X86Encode.movRr64(&mut em.code, X86Encode.rsi(), X86Encode.rax()) // aLo
  run X86Encode.movRr64(&mut em.code, X86Encode.rdi(), X86Encode.rdx()) // aHi
  if !signed {
    // Unsigned 128x128 -> overflow iff (aHi != 0 && bHi != 0) or high(aLo*bHi) != 0 or high(aHi*bLo) != 0
    // or sum of cross terms carries into bit 128.
    run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.r11(), X86Encode.r11()) // ovf = 0
    // rdx:rax = aLo * bLo
    run X86Encode.mul64(&mut em.code, X86Encode.r8())
    run X86Encode.movRr64(&mut em.code, X86Encode.rcx(), X86Encode.rax()) // pLo
    run X86Encode.movRr64(&mut em.code, X86Encode.r10(), X86Encode.rdx()) // pHi_0
    // aHi * bHi != 0 -> ovf
    run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.rdi())
    run X86Encode.mul64(&mut em.code, X86Encode.r9())
    run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.rax(), X86Encode.rdx())
    run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.r11(), X86Encode.rax())
    // aHi * bLo
    run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.rdi())
    run X86Encode.mul64(&mut em.code, X86Encode.r8())
    run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.r11(), X86Encode.rdx())
    run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.r10(), X86Encode.rax())
    run X86Encode.aluRi64(&mut em.code, Alu.Adc, X86Encode.r11(), 0)
    // aLo * bHi
    run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.rsi())
    run X86Encode.mul64(&mut em.code, X86Encode.r9())
    run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.r11(), X86Encode.rdx())
    run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.r10(), X86Encode.rax())
    run X86Encode.aluRi64(&mut em.code, Alu.Adc, X86Encode.r11(), 0)
    // ovfFlag = r11 != 0
    run X86Encode.testRr64(&mut em.code, X86Encode.r11(), X86Encode.r11())
    run X86Encode.setcc(&mut em.code, X86Encode.ccNe(), X86Encode.r11())
    run X86Encode.movzxRr8(&mut em.code, X86Encode.r11(), X86Encode.r11())
    run storePair(&mut em.*, result, X86Encode.rcx(), X86Encode.r10())
    return run storeGp(&mut em.*, result + 1, X86Encode.r11())
  }
  // Signed 128x128: compute wrapped product, then check exact overflow via |a|*|b| using the
  // unsigned check: fits in signed 128 iff |a|*|b| <= 2^127 - (neg ? 0 : 1).
  // First compute wrapped product in r10(lo):r11(hi) on stack temp? No, compute via signs!
  // Record resNeg = (aHi ^ bHi) >> 63 in bit 0 of stack-free? Compute wrapped product first and store it!
  run X86Encode.movRr64(&mut em.code, X86Encode.r10(), X86Encode.rdi())
  run X86Encode.imulRr64(&mut em.code, X86Encode.r10(), X86Encode.r8())
  run X86Encode.movRr64(&mut em.code, X86Encode.r11(), X86Encode.rsi())
  run X86Encode.imulRr64(&mut em.code, X86Encode.r11(), X86Encode.r9())
  run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.r10(), X86Encode.r11())
  run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.rsi())
  run X86Encode.mul64(&mut em.code, X86Encode.r8())
  run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.rdx(), X86Encode.r10())
  run storePair(&mut em.*, result, X86Encode.rax(), X86Encode.rdx())

  // Now check signed overflow: rcx = resSign = (aHi ^ bHi) < 0.
  run X86Encode.movRr64(&mut em.code, X86Encode.rcx(), X86Encode.rdi())
  run X86Encode.aluRr64(&mut em.code, Alu.Xor, X86Encode.rcx(), X86Encode.r9())
  run X86Encode.shiftImm64(&mut em.code, Shift.Shr, X86Encode.rcx(), 63)
  // abs(a) -> rsi:rdi
  run X86Encode.testRr64(&mut em.code, X86Encode.rdi(), X86Encode.rdi())
  let aPos = run emitJcc(&mut em.*, X86Encode.ccNs())
  run X86Encode.neg64(&mut em.code, X86Encode.rsi())
  run X86Encode.aluRi64(&mut em.code, Alu.Adc, X86Encode.rdi(), 0)
  run X86Encode.neg64(&mut em.code, X86Encode.rdi())
  patchHere(&mut em.*, aPos)
  // abs(b) -> r8:r9
  run X86Encode.testRr64(&mut em.code, X86Encode.r9(), X86Encode.r9())
  let bPos = run emitJcc(&mut em.*, X86Encode.ccNs())
  run X86Encode.neg64(&mut em.code, X86Encode.r8())
  run X86Encode.aluRi64(&mut em.code, Alu.Adc, X86Encode.r9(), 0)
  run X86Encode.neg64(&mut em.code, X86Encode.r9())
  patchHere(&mut em.*, bPos)
  // Unsigned |a| * |b| -> (magLo, magHi, hiCarry in r11).
  run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.r11(), X86Encode.r11())
  run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.rsi())
  run X86Encode.mul64(&mut em.code, X86Encode.r8())
  run X86Encode.movRr64(&mut em.code, X86Encode.r10(), X86Encode.rdx())
  let saveMagLo = X86Encode.rax()
  // Need magLo later; push it? Just test if aHi*bHi, aHi*bLo, aLo*bHi overflow, and keep magLo in rsi after last use!
  // Compute aLo * bHi first (last use of rsi!).
  run X86Encode.push(&mut em.code, saveMagLo)
  run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.rsi())
  run X86Encode.mul64(&mut em.code, X86Encode.r9())
  run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.r11(), X86Encode.rdx())
  run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.r10(), X86Encode.rax())
  run X86Encode.aluRi64(&mut em.code, Alu.Adc, X86Encode.r11(), 0)
  // aHi * bLo
  run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.rdi())
  run X86Encode.mul64(&mut em.code, X86Encode.r8())
  run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.r11(), X86Encode.rdx())
  run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.r10(), X86Encode.rax())
  run X86Encode.aluRi64(&mut em.code, Alu.Adc, X86Encode.r11(), 0)
  // aHi * bHi
  run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.rdi())
  run X86Encode.mul64(&mut em.code, X86Encode.r9())
  run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.r11(), X86Encode.rax())
  run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.r11(), X86Encode.rdx())
  run X86Encode.pop(&mut em.code, X86Encode.rax()) // magLo in rax, magHi in r10, hiCarry in r11
  // Check limit: if r11 != 0 -> ovf. Else if magHi > 0x8000...0 -> ovf.
  // If magHi == 0x8000...0 -> ok iff (rcx == 1 && magLo == 0).
  run X86Encode.testRr64(&mut em.code, X86Encode.r11(), X86Encode.r11())
  let ovf1 = run emitJcc(&mut em.*, X86Encode.ccNe())
  run X86Encode.movImm64(&mut em.code, X86Encode.rdx(), 0x8000000000000000)
  run X86Encode.aluRr64(&mut em.code, Alu.Cmp, X86Encode.r10(), X86Encode.rdx())
  let okSmall = run emitJcc(&mut em.*, X86Encode.ccB())
  let ovf2 = run emitJcc(&mut em.*, X86Encode.ccA())
  // magHi == 2^63: ok iff resNeg == 1 && magLo == 0.
  run X86Encode.testRr64(&mut em.code, X86Encode.rax(), X86Encode.rax())
  let ovf3 = run emitJcc(&mut em.*, X86Encode.ccNe())
  run X86Encode.testRr64(&mut em.code, X86Encode.rcx(), X86Encode.rcx())
  let ovf4 = run emitJcc(&mut em.*, X86Encode.ccE())
  patchHere(&mut em.*, okSmall)
  run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rax())
  let doneOk = run emitJmp(&mut em.*)
  let ovfLbl = Bytes.length(&em.code)
  patchTo(&mut em.*, ovf1, ovfLbl)
  patchTo(&mut em.*, ovf2, ovfLbl)
  patchTo(&mut em.*, ovf3, ovfLbl)
  patchTo(&mut em.*, ovf4, ovfLbl)
  run X86Encode.movImm32(&mut em.code, X86Encode.rax(), 1)
  patchHere(&mut em.*, doneOk)
  return run storeGp(&mut em.*, result + 1, X86Encode.rax())
}

effect fn emitSaturate(em: &mut Emitter, function: &SsaFunction, op: Binary, signed: bool, kind: Kind, left: u64, right: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if kind.isVector() {
    return run emitVectorSaturate(&mut em.*, function, op, signed, kind, left, right, result)
  }
  if kind.bits > 64 {
    return run emitI128Saturate(&mut em.*, function, op, signed, left, right, result)
  }
  run loadGp(&mut em.*, function, left, X86Encode.rax())
  run loadGp(&mut em.*, function, right, X86Encode.rcx())
  run emitScalarSaturateRegs(&mut em.*, op, signed, kind.bits)
  return run storeGp(&mut em.*, result, X86Encode.rax())
}

effect fn emitScalarSaturateRegs(em: &mut Emitter, op: Binary, signed: bool, bits: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  run emitScalarOverflowRegs(&mut em.*, op, signed, bits)
  // `rax` = wrapped result, `rdx` = 1 if overflowed else 0.
  run X86Encode.testRr64(&mut em.code, X86Encode.rdx(), X86Encode.rdx())
  let ok = run emitJcc(&mut em.*, X86Encode.ccE())
  if !signed {
    let clamp = if op == Binary.Add { maskBits(u64.MAX, bits) } else { 0 }
    run X86Encode.movImm64(&mut em.code, X86Encode.rax(), clamp)
  } else {
    // Signed overflow: if wrapped result is negative (sign bit set), positive overflow -> MAX;
    // if wrapped result is non-negative, negative overflow -> MIN!
    let signBit = u64.shiftLeft(1, usize.toU64(bits - usize.ONE))
    let maxS = signBit - 1
    let minS = maskBits(signBit, bits)
    run X86Encode.movImm64(&mut em.code, X86Encode.r8(), signBit)
    run X86Encode.testRr64(&mut em.code, X86Encode.rax(), X86Encode.r8())
    run X86Encode.movImm64(&mut em.code, X86Encode.rax(), minS)
    run X86Encode.movImm64(&mut em.code, X86Encode.r9(), maxS)
    run X86Encode.cmov64(&mut em.code, X86Encode.ccNe(), X86Encode.rax(), X86Encode.r9())
  }
  patchHere(&mut em.*, ok)
  return ()
}

effect fn emitI128Saturate(em: &mut Emitter, function: &SsaFunction, op: Binary, signed: bool, left: u64, right: u64, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  run loadPair(&mut em.*, function, left, X86Encode.rax(), X86Encode.rdx())
  run loadPair(&mut em.*, function, right, X86Encode.r8(), X86Encode.r9())
  let flagCc = if signed { X86Encode.ccO() } else { X86Encode.ccB() }
  if op == Binary.Add {
    run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.rax(), X86Encode.r8())
    run X86Encode.aluRr64(&mut em.code, Alu.Adc, X86Encode.rdx(), X86Encode.r9())
  } else {
    run X86Encode.aluRr64(&mut em.code, Alu.Sub, X86Encode.rax(), X86Encode.r8())
    run X86Encode.aluRr64(&mut em.code, Alu.Sbb, X86Encode.rdx(), X86Encode.r9())
  }
  let ok = run emitJcc(&mut em.*, X86Encode.invertCc(flagCc))
  if !signed {
    let v = if op == Binary.Add { u64.MAX } else { 0 }
    run X86Encode.movImm64(&mut em.code, X86Encode.rax(), v)
    run X86Encode.movImm64(&mut em.code, X86Encode.rdx(), v)
  } else {
    run X86Encode.testRr64(&mut em.code, X86Encode.rdx(), X86Encode.rdx())
    let wasNeg = run emitJcc(&mut em.*, X86Encode.ccS())
    run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rax())
    run X86Encode.movImm64(&mut em.code, X86Encode.rdx(), 0x8000000000000000)
    let done = run emitJmp(&mut em.*)
    patchHere(&mut em.*, wasNeg)
    run X86Encode.movImm64(&mut em.code, X86Encode.rax(), u64.MAX)
    run X86Encode.movImm64(&mut em.code, X86Encode.rdx(), 0x7FFFFFFFFFFFFFFF)
    patchHere(&mut em.*, done)
  }
  patchHere(&mut em.*, ok)
  return run storePair(&mut em.*, result, X86Encode.rax(), X86Encode.rdx())
}

effect fn emitRotate(em: &mut Emitter, function: &SsaFunction, left: bool, kind: Kind, val: u64, amt: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if kind.isVector() {
    return run emitVectorRotate(&mut em.*, function, left, kind, val, amt, result)
  }
  if kind.bits > 64 {
    // 128-bit rotate: `(x << k) | (x >> (128 - k))`.
    run loadPair(&mut em.*, function, val, X86Encode.rax(), X86Encode.rdx())
    run loadGp(&mut em.*, function, amt, X86Encode.rcx())
    run X86Encode.aluRi32(&mut em.code, Alu.And, X86Encode.rcx(), 127)
    run X86Encode.testRr32(&mut em.code, X86Encode.rcx(), X86Encode.rcx())
    let zero = run emitJcc(&mut em.*, X86Encode.ccE())
    if !left {
      run X86Encode.movImm32(&mut em.code, X86Encode.r8(), 128)
      run X86Encode.aluRr32(&mut em.code, Alu.Sub, X86Encode.r8(), X86Encode.rcx())
      run X86Encode.movRr32(&mut em.code, X86Encode.rcx(), X86Encode.r8())
    }
    // Rotate left by rcx in 1..127.
    run X86Encode.aluRi32(&mut em.code, Alu.Cmp, X86Encode.rcx(), 64)
    let lt64 = run emitJcc(&mut em.*, X86Encode.ccB())
    // Swap halves and subtract 64.
    run X86Encode.movRr64(&mut em.code, X86Encode.r8(), X86Encode.rax())
    run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.rdx())
    run X86Encode.movRr64(&mut em.code, X86Encode.rdx(), X86Encode.r8())
    run X86Encode.aluRi32(&mut em.code, Alu.Sub, X86Encode.rcx(), 64)
    patchHere(&mut em.*, lt64)
    run X86Encode.movRr64(&mut em.code, X86Encode.r8(), X86Encode.rdx())
    run X86Encode.shldCl64(&mut em.code, X86Encode.rdx(), X86Encode.rax())
    run X86Encode.shldCl64(&mut em.code, X86Encode.rax(), X86Encode.r8())
    patchHere(&mut em.*, zero)
    return run storePair(&mut em.*, result, X86Encode.rax(), X86Encode.rdx())
  }
  if (kind.bits == 32 || kind.bits == 64) && function.isBits(amt) {
    let mask = usize.toU64(kind.bits - usize.ONE)
    let count = u64.wrappingToU8(function.constantOf(amt).low & mask)
    let workDst = dstRegOrScratch(&em.*, result, X86Encode.rax())
    if hasFeat(&em.*, X86Frame.featBmi2()) && count != 0 {
      let rorCount: u8 = if left { usize.toU8(kind.bits) - count } else { count }
      let valSpill = spilledGpOff(&em.*, function, val)
      if valSpill != 0 {
        let mem = Mem.baseDisp(X86Encode.rbp(), valSpill)
        if kind.bits == 64 {
          drop run X86Encode.rorxRm64(&mut em.code, workDst, mem, rorCount)
        } else {
          drop run X86Encode.rorxRm32(&mut em.code, workDst, mem, rorCount)
        }
      } else {
        let srcReg = run regOrLoad(&mut em.*, function, val, X86Encode.r11())
        if kind.bits == 64 {
          run X86Encode.rorx64(&mut em.code, workDst, srcReg, rorCount)
        } else {
          run X86Encode.rorx32(&mut em.code, workDst, srcReg, rorCount)
        }
      }
      return run storeGp(&mut em.*, result, workDst)
    }
    let op = if left { Shift.Rol } else { Shift.Ror }
    run loadGp(&mut em.*, function, val, workDst)
    if kind.bits == 64 {
      if count != 0 { run X86Encode.shiftImm64(&mut em.code, op, workDst, count) }
    } else {
      if count == 0 { run X86Encode.movRr32(&mut em.code, workDst, workDst) }
      else { run X86Encode.shiftImm32(&mut em.code, op, workDst, count) }
    }
    return run storeGp(&mut em.*, result, workDst)
  }
  run loadGp(&mut em.*, function, val, X86Encode.rax())
  run loadGp(&mut em.*, function, amt, X86Encode.rcx())
  run emitScalarRotateRegs(&mut em.*, left, kind.bits)
  return run storeGp(&mut em.*, result, X86Encode.rax())
}

effect fn emitScalarRotateRegs(em: &mut Emitter, left: bool, bits: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let op = if left { Shift.Rol } else { Shift.Ror }
  if bits == 64 { return run X86Encode.shiftCl64(&mut em.code, op, X86Encode.rax()) }
  if bits == 32 { return run X86Encode.shiftCl32(&mut em.code, op, X86Encode.rax()) }
  if bits == 16 {
    run X86Encode.shiftCl16(&mut em.code, op, X86Encode.rax())
    return run X86Encode.movzxRr16(&mut em.code, X86Encode.rax(), X86Encode.rax())
  }
  if bits == 8 {
    run X86Encode.shiftCl8(&mut em.code, op, X86Encode.rax())
    return run X86Encode.movzxRr8(&mut em.code, X86Encode.rax(), X86Encode.rax())
  }
  return run normalizeInt(&mut em.*, X86Encode.rax(), bits, false)
}

effect fn emitCount(em: &mut Emitter, function: &SsaFunction, which: Count, kind: Kind, src: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if kind.isVector() {
    return run emitVectorCount(&mut em.*, function, which, kind, src, result)
  }
  if kind.bits > 64 {
    run loadPair(&mut em.*, function, src, X86Encode.r8(), X86Encode.r9())
    match which {
      Count.Ones => {
        run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.r8())
        run emitPopcount64(&mut em.*)
        run X86Encode.movRr64(&mut em.code, X86Encode.r10(), X86Encode.rax())
        run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.r9())
        run emitPopcount64(&mut em.*)
        run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.rax(), X86Encode.r10())
      }
      Count.LeadingZeros => {
        run X86Encode.testRr64(&mut em.code, X86Encode.r9(), X86Encode.r9())
        let hiZero = run emitJcc(&mut em.*, X86Encode.ccE())
        run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.r9())
        run emitClz64(&mut em.*, 64)
        let done = run emitJmp(&mut em.*)
        patchHere(&mut em.*, hiZero)
        run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.r8())
        run emitClz64(&mut em.*, 64)
        run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rax(), 64)
        patchHere(&mut em.*, done)
      }
      Count.TrailingZeros => {
        run X86Encode.testRr64(&mut em.code, X86Encode.r8(), X86Encode.r8())
        let loZero = run emitJcc(&mut em.*, X86Encode.ccE())
        run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.r8())
        run emitCtz64(&mut em.*, 64)
        let done = run emitJmp(&mut em.*)
        patchHere(&mut em.*, loZero)
        run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.r9())
        run emitCtz64(&mut em.*, 64)
        run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rax(), 64)
        patchHere(&mut em.*, done)
      }
    }
    run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rdx(), X86Encode.rdx())
    return run storePair(&mut em.*, result, X86Encode.rax(), X86Encode.rdx())
  }
  if kind.bits == 32 || kind.bits == 64 {
    if which == Count.TrailingZeros && hasFeat(&em.*, X86Frame.featBmi()) {
      let srcReg = run regOrLoad(&mut em.*, function, src, X86Encode.r11())
      let workDst = dstRegOrScratch(&em.*, result, X86Encode.rax())
      if kind.bits == 64 { run X86Encode.tzcnt64(&mut em.code, workDst, srcReg) }
      else { run X86Encode.tzcnt32(&mut em.code, workDst, srcReg) }
      return run storeGp(&mut em.*, result, workDst)
    }
    if which == Count.LeadingZeros && hasFeat(&em.*, X86Frame.featLzcnt()) {
      let srcReg = run regOrLoad(&mut em.*, function, src, X86Encode.r11())
      let workDst = dstRegOrScratch(&em.*, result, X86Encode.rax())
      if kind.bits == 64 { run X86Encode.lzcnt64(&mut em.code, workDst, srcReg) }
      else { run X86Encode.lzcnt32(&mut em.code, workDst, srcReg) }
      return run storeGp(&mut em.*, result, workDst)
    }
    if which == Count.Ones && hasFeat(&em.*, X86Frame.featPopcnt()) {
      let srcReg = run regOrLoad(&mut em.*, function, src, X86Encode.r11())
      let workDst = dstRegOrScratch(&em.*, result, X86Encode.rax())
      if kind.bits == 64 { run X86Encode.popcnt64(&mut em.code, workDst, srcReg) }
      else { run X86Encode.popcnt32(&mut em.code, workDst, srcReg) }
      return run storeGp(&mut em.*, result, workDst)
    }
  }
  run loadGp(&mut em.*, function, src, X86Encode.rax())
  run normalizeInt(&mut em.*, X86Encode.rax(), kind.bits, false)
  match which {
    Count.Ones => { run emitPopcount64(&mut em.*) }
    Count.LeadingZeros => { run emitClz64(&mut em.*, kind.bits) }
    Count.TrailingZeros => { run emitCtz64(&mut em.*, kind.bits) }
  }
  return run storeGp(&mut em.*, result, X86Encode.rax())
}

// Baseline-safe software SWAR popcount on `rax` (clobbers `rcx`, `rdx`). Works on all x86-64 CPUs.
effect fn emitPopcount64(em: &mut Emitter) -> () ! OutOfMemoryError ? &mut Allocator {
  // x = x - ((x >> 1) & 0x5555555555555555)
  run X86Encode.movRr64(&mut em.code, X86Encode.rcx(), X86Encode.rax())
  run X86Encode.shiftImm64(&mut em.code, Shift.Shr, X86Encode.rcx(), 1)
  run X86Encode.movImm64(&mut em.code, X86Encode.rdx(), 0x5555555555555555)
  run X86Encode.aluRr64(&mut em.code, Alu.And, X86Encode.rcx(), X86Encode.rdx())
  run X86Encode.aluRr64(&mut em.code, Alu.Sub, X86Encode.rax(), X86Encode.rcx())
  // x = (x & 0x3333...) + ((x >> 2) & 0x3333...)
  run X86Encode.movImm64(&mut em.code, X86Encode.rdx(), 0x3333333333333333)
  run X86Encode.movRr64(&mut em.code, X86Encode.rcx(), X86Encode.rax())
  run X86Encode.shiftImm64(&mut em.code, Shift.Shr, X86Encode.rcx(), 2)
  run X86Encode.aluRr64(&mut em.code, Alu.And, X86Encode.rax(), X86Encode.rdx())
  run X86Encode.aluRr64(&mut em.code, Alu.And, X86Encode.rcx(), X86Encode.rdx())
  run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.rax(), X86Encode.rcx())
  // x = ((x + (x >> 4)) & 0x0F0F...) * 0x0101... >> 56
  run X86Encode.movRr64(&mut em.code, X86Encode.rcx(), X86Encode.rax())
  run X86Encode.shiftImm64(&mut em.code, Shift.Shr, X86Encode.rcx(), 4)
  run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.rax(), X86Encode.rcx())
  run X86Encode.movImm64(&mut em.code, X86Encode.rdx(), 0x0F0F0F0F0F0F0F0F)
  run X86Encode.aluRr64(&mut em.code, Alu.And, X86Encode.rax(), X86Encode.rdx())
  run X86Encode.movImm64(&mut em.code, X86Encode.rdx(), 0x0101010101010101)
  run X86Encode.imulRr64(&mut em.code, X86Encode.rax(), X86Encode.rdx())
  return run X86Encode.shiftImm64(&mut em.code, Shift.Shr, X86Encode.rax(), 56)
}

effect fn emitClz64(em: &mut Emitter, bits: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  run X86Encode.testRr64(&mut em.code, X86Encode.rax(), X86Encode.rax())
  let isZero = run emitJcc(&mut em.*, X86Encode.ccE())
  run X86Encode.bsr64(&mut em.code, X86Encode.rcx(), X86Encode.rax())
  run X86Encode.movImm64(&mut em.code, X86Encode.rax(), usize.toU64(bits - usize.ONE))
  run X86Encode.aluRr64(&mut em.code, Alu.Sub, X86Encode.rax(), X86Encode.rcx())
  let done = run emitJmp(&mut em.*)
  patchHere(&mut em.*, isZero)
  run X86Encode.movImm64(&mut em.code, X86Encode.rax(), usize.toU64(bits))
  patchHere(&mut em.*, done)
  return ()
}

effect fn emitCtz64(em: &mut Emitter, bits: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  run X86Encode.testRr64(&mut em.code, X86Encode.rax(), X86Encode.rax())
  let isZero = run emitJcc(&mut em.*, X86Encode.ccE())
  run X86Encode.bsf64(&mut em.code, X86Encode.rax(), X86Encode.rax())
  let done = run emitJmp(&mut em.*)
  patchHere(&mut em.*, isZero)
  run X86Encode.movImm64(&mut em.code, X86Encode.rax(), usize.toU64(bits))
  patchHere(&mut em.*, done)
  return ()
}

effect fn emitExtreme(em: &mut Emitter, function: &SsaFunction, which: Extreme, kind: Kind, left: u64, right: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if kind.isVector() {
    return run emitVectorExtreme(&mut em.*, function, which, kind, left, right, result)
  }
  if kind.isFloat() {
    let double = kind.bits == 64
    run loadFloat(&mut em.*, function, left, 0, X86Encode.rax())
    run loadFloat(&mut em.*, function, right, 1, X86Encode.rax())
    run emitIeeeFloatExtremeRegs(&mut em.*, which == Extreme.FloatMaximum, double)
    return run storeFloat(&mut em.*, result, 0, double)
  }
  if kind.bits > 64 {
    let pred = match which {
      Extreme.SignedMinimum => Predicate.Slt
      Extreme.SignedMaximum => Predicate.Sgt
      Extreme.UnsignedMinimum => Predicate.Ult
      _ => Predicate.Ugt
    }
    run loadPair(&mut em.*, function, left, X86Encode.rax(), X86Encode.rdx())
    run loadPair(&mut em.*, function, right, X86Encode.r8(), X86Encode.r9())
    run emitI128CompareRegs(&mut em.*, pred)
    run X86Encode.movRr64(&mut em.code, X86Encode.r10(), X86Encode.rax())
    run loadPair(&mut em.*, function, left, X86Encode.rax(), X86Encode.rdx())
    run loadPair(&mut em.*, function, right, X86Encode.r8(), X86Encode.r9())
    run X86Encode.testRi8(&mut em.code, X86Encode.r10(), 1)
    run X86Encode.cmov64(&mut em.code, X86Encode.ccE(), X86Encode.rax(), X86Encode.r8())
    run X86Encode.cmov64(&mut em.code, X86Encode.ccE(), X86Encode.rdx(), X86Encode.r9())
    return run storePair(&mut em.*, result, X86Encode.rax(), X86Encode.rdx())
  }
  let signed = which == Extreme.SignedMinimum || which == Extreme.SignedMaximum
  let cc = match which {
    Extreme.SignedMinimum => X86Encode.ccG()
    Extreme.SignedMaximum => X86Encode.ccL()
    Extreme.UnsignedMinimum => X86Encode.ccA()
    _ => X86Encode.ccB()
  }
  run loadGp(&mut em.*, function, left, X86Encode.rax())
  run loadGp(&mut em.*, function, right, X86Encode.r11())
  run normalizeInt(&mut em.*, X86Encode.rax(), kind.bits, signed)
  run normalizeInt(&mut em.*, X86Encode.r11(), kind.bits, signed)
  run X86Encode.aluRr64(&mut em.code, Alu.Cmp, X86Encode.rax(), X86Encode.r11())
  run X86Encode.cmov64(&mut em.code, cc, X86Encode.rax(), X86Encode.r11())
  run normalizeInt(&mut em.*, X86Encode.rax(), kind.bits, false)
  return run storeGp(&mut em.*, result, X86Encode.rax())
}

// IEEE 754 minimum/maximum on `xmm0` and `xmm1` -> `xmm0` (NaN propagates, -0.0 < +0.0).
effect fn emitIeeeFloatExtremeRegs(em: &mut Emitter, isMax: bool, double: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  run X86Encode.ucomiFloat(&mut em.code, double, 0, 1)
  let unordered = run emitJcc(&mut em.*, X86Encode.ccP())
  let equal = run emitJcc(&mut em.*, X86Encode.ccE())
  let keep0 = run emitJcc(&mut em.*, if isMax { X86Encode.ccA() } else { X86Encode.ccB() })
  run X86Encode.movapsRr(&mut em.code, 0, 1)
  let done1 = run emitJmp(&mut em.*)

  // Unordered: return whichever is NaN (`addFloat` propagates quiet NaN cleanly).
  patchHere(&mut em.*, unordered)
  run X86Encode.addFloat(&mut em.code, double, 0, 1)
  let done2 = run emitJmp(&mut em.*)

  // Equal (+0.0 vs -0.0): for min, OR bits (picks -0.0); for max, AND bits (picks +0.0)!
  patchHere(&mut em.*, equal)
  if isMax { run X86Encode.pand(&mut em.code, 0, 1) }
  else { run X86Encode.por(&mut em.code, 0, 1) }

  let end = Bytes.length(&em.code)
  patchTo(&mut em.*, keep0, end)
  patchTo(&mut em.*, done1, end)
  patchTo(&mut em.*, done2, end)
  return ()
}

effect fn emitFma(em: &mut Emitter, function: &SsaFunction, kind: Kind, a: u64, b: u64, c: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if kind.isVector() {
    return run emitVectorFma(&mut em.*, function, kind, a, b, c, result)
  }
  let double = kind.bits == 64
  run loadFloat(&mut em.*, function, a, 0, X86Encode.rax())
  run loadFloat(&mut em.*, function, b, 1, X86Encode.rax())
  run loadFloat(&mut em.*, function, c, 2, X86Encode.rax())
  run callExternal(&mut em.*, if double { b"fma" } else { b"fmaf" })
  return run storeFloat(&mut em.*, result, 0, double)
}

effect fn emitSqrt(em: &mut Emitter, function: &SsaFunction, kind: Kind, src: u64, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  if kind.isVector() {
    return run emitVectorUnary(&mut em.*, function, 1, kind, src, result)
  }
  let double = kind.bits == 64
  run loadFloat(&mut em.*, function, src, 0, X86Encode.rax())
  run X86Encode.sqrtFloat(&mut em.code, double, 0, 0)
  return run storeFloat(&mut em.*, result, 0, double)
}

// ---- Atomics ----

effect fn emitAtomicLoad(em: &mut Emitter, function: &SsaFunction, kind: Kind, addrVal: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  // On x86-64 TSO, naturally aligned loads are acquire-atomic; `emitLoad` reads directly.
  return run emitLoad(&mut em.*, function, addrVal, 0, kind, result)
}

effect fn emitAtomicStore(em: &mut Emitter, function: &SsaFunction, val: u64, addrVal: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let kind = function.value(val).kind
  run loadGp(&mut em.*, function, addrVal, X86Encode.rdi())
  run loadGp(&mut em.*, function, val, X86Encode.rax())
  let w = kind.elementBytes()
  drop run X86Encode.xchgMr(&mut em.code, Mem.baseDisp(X86Encode.rdi(), 0), X86Encode.rax(), w)
  return ()
}

effect fn emitAtomicModify(em: &mut Emitter, function: &SsaFunction, which: Modify, kind: Kind, addrVal: u64, val: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  run loadGp(&mut em.*, function, addrVal, X86Encode.rdi())
  run loadGp(&mut em.*, function, val, X86Encode.rsi())
  let w = kind.elementBytes()
  if which == Modify.Exchange {
    run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.rsi())
    drop run X86Encode.xchgMr(&mut em.code, Mem.baseDisp(X86Encode.rdi(), 0), X86Encode.rax(), w)
    run normalizeInt(&mut em.*, X86Encode.rax(), kind.bits, false)
    return run storeGp(&mut em.*, result, X86Encode.rax())
  }
  if which == Modify.Add {
    run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.rsi())
    drop run X86Encode.lockXadd(&mut em.code, Mem.baseDisp(X86Encode.rdi(), 0), X86Encode.rax(), w)
    run normalizeInt(&mut em.*, X86Encode.rax(), kind.bits, false)
    return run storeGp(&mut em.*, result, X86Encode.rax())
  }
  if which == Modify.Sub {
    run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.rsi())
    run X86Encode.neg64(&mut em.code, X86Encode.rax())
    drop run X86Encode.lockXadd(&mut em.code, Mem.baseDisp(X86Encode.rdi(), 0), X86Encode.rax(), w)
    run normalizeInt(&mut em.*, X86Encode.rax(), kind.bits, false)
    return run storeGp(&mut em.*, result, X86Encode.rax())
  }
  // General `lock cmpxchg` retry loop for And/Or/Xor/SignedMin/Max/UnsignedMin/Max.
  if w == 1 { drop run X86Encode.movzxRm8(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rdi(), 0)) }
  else if w == 2 { drop run X86Encode.movzxRm16(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rdi(), 0)) }
  else if w == 4 { drop run X86Encode.movRm32(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rdi(), 0)) }
  else { drop run X86Encode.movRm64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rdi(), 0)) }
  let retry = Bytes.length(&em.code)
  run X86Encode.movRr64(&mut em.code, X86Encode.rcx(), X86Encode.rax())
  match which {
    Modify.And => { run X86Encode.aluRr64(&mut em.code, Alu.And, X86Encode.rcx(), X86Encode.rsi()) }
    Modify.Or => { run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.rcx(), X86Encode.rsi()) }
    Modify.Xor => { run X86Encode.aluRr64(&mut em.code, Alu.Xor, X86Encode.rcx(), X86Encode.rsi()) }
    _ => {
      let signed = which == Modify.SignedMinimum || which == Modify.SignedMaximum
      let cc = match which {
        Modify.SignedMinimum => X86Encode.ccG()
        Modify.SignedMaximum => X86Encode.ccL()
        Modify.UnsignedMinimum => X86Encode.ccA()
        _ => X86Encode.ccB()
      }
      run X86Encode.movRr64(&mut em.code, X86Encode.r8(), X86Encode.rcx())
      run X86Encode.movRr64(&mut em.code, X86Encode.r9(), X86Encode.rsi())
      run normalizeInt(&mut em.*, X86Encode.r8(), kind.bits, signed)
      run normalizeInt(&mut em.*, X86Encode.r9(), kind.bits, signed)
      run X86Encode.aluRr64(&mut em.code, Alu.Cmp, X86Encode.r8(), X86Encode.r9())
      run X86Encode.cmov64(&mut em.code, cc, X86Encode.rcx(), X86Encode.rsi())
    }
  }
  drop run X86Encode.lockCmpxchg(&mut em.code, Mem.baseDisp(X86Encode.rdi(), 0), X86Encode.rcx(), w)
  let back = run emitJcc(&mut em.*, X86Encode.ccNe())
  patchTo(&mut em.*, back, retry)
  run normalizeInt(&mut em.*, X86Encode.rax(), kind.bits, false)
  return run storeGp(&mut em.*, result, X86Encode.rax())
}

effect fn emitCompareExchange(em: &mut Emitter, function: &SsaFunction, kind: Kind, addrVal: u64, expected: u64, replacement: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  run loadGp(&mut em.*, function, addrVal, X86Encode.rdi())
  if kind.bits > 64 {
    run loadPair(&mut em.*, function, expected, X86Encode.rax(), X86Encode.rdx())
    run loadPair(&mut em.*, function, replacement, X86Encode.rbx(), X86Encode.rcx())
    drop run X86Encode.lockCmpxchg16b(&mut em.code, Mem.baseDisp(X86Encode.rdi(), 0))
    run X86Encode.setcc(&mut em.code, X86Encode.ccE(), X86Encode.r8())
    run X86Encode.movzxRr8(&mut em.code, X86Encode.r8(), X86Encode.r8())
    run storePair(&mut em.*, result, X86Encode.rax(), X86Encode.rdx())
    return run storeGp(&mut em.*, result + 1, X86Encode.r8())
  }
  run loadGp(&mut em.*, function, expected, X86Encode.rax())
  run loadGp(&mut em.*, function, replacement, X86Encode.rcx())
  let w = kind.elementBytes()
  drop run X86Encode.lockCmpxchg(&mut em.code, Mem.baseDisp(X86Encode.rdi(), 0), X86Encode.rcx(), w)
  run X86Encode.setcc(&mut em.code, X86Encode.ccE(), X86Encode.rdx())
  run normalizeInt(&mut em.*, X86Encode.rax(), kind.bits, false)
  run X86Encode.movzxRr8(&mut em.code, X86Encode.rdx(), X86Encode.rdx())
  run storeGp(&mut em.*, result, X86Encode.rax())
  return run storeGp(&mut em.*, result + 1, X86Encode.rdx())
}

// ---- Inline Assembly ----

effect fn emitInlineAsm(em: &mut Emitter, function: &SsaFunction, asmIdx: usize, kind: Kind, ops: &[u64], result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let asm: &InlineAsm = function.asm(asmIdx)
  let hasOut = !kind.isUnit()
  let parsed = run X86Asm.parseConstraints(Bytes.asSlice(&asm.constraints), hasOut)
  let cs = List<Constraint>.asSlice(&parsed)
  let clobMask = X86Asm.parseClobberMask(Bytes.asSlice(&asm.clobbers))

  // Reserve all fixed registers + clobbers + rsp(4) + rbp(5).
  let mut used: u64 = clobMask | u64.shiftLeft(1, 4) | u64.shiftLeft(1, 5)
  let mut c = usize.ZERO
  while c < cs.length {
    if cs[c].kind == ConstraintKind.FixedReg && cs[c].reg < 16 {
      used = used | u64.shiftLeft(1, u8.toU64(cs[c].reg))
    }
    c = c + usize.ONE
  }

  // Assign a physical GPR to every operand slot `$0..$N`.
  let mut bindings = run List<OperandBinding>.makeWithCapacity(cs.length)
  let allocOrder: [u8; 9] = [0, 7, 6, 2, 1, 8, 9, 10, 11]
  c = usize.ZERO
  while c < cs.length {
    let cur = cs[c]
    if cur.kind == ConstraintKind.FixedReg {
      run List<OperandBinding>.append(&mut bindings, OperandBinding {reg: cur.reg, isMemory: false})
    } else if cur.kind == ConstraintKind.TiedOutput {
      let outReg = List<OperandBinding>.asSlice(&bindings)[usize.ZERO].reg
      run List<OperandBinding>.append(&mut bindings, OperandBinding {reg: outReg, isMemory: false})
    } else {
      let mut chosen: u8 = 0
      let mut k = usize.ZERO
      while k < 9 {
        let cand = allocOrder[k]
        if (used & u64.shiftLeft(1, u8.toU64(cand))) == 0 {
          chosen = cand
          used = used | u64.shiftLeft(1, u8.toU64(cand))
          break
        }
        k = k + usize.ONE
      }
      run List<OperandBinding>.append(&mut bindings, OperandBinding {reg: chosen, isMemory: cur.kind == ConstraintKind.Memory})
    }
    c = c + usize.ONE
  }

  // Load input operands into their assigned GPRs.
  let bound = List<OperandBinding>.asSlice(&bindings)
  let mut opAt = usize.ZERO
  while opAt < ops.length {
    let slotIdx = if hasOut { opAt + usize.ONE } else { opAt }
    if slotIdx < bound.length {
      run loadGp(&mut em.*, function, ops[opAt], bound[slotIdx].reg)
    }
    opAt = opAt + usize.ONE
  }

  // Assemble the template directly into `em.code`.
  let mut asmRelocs = List<AsmCallReloc>.make()
  match move run Effect.result(X86Asm.assemble(&mut em.code, &mut asmRelocs, Bytes.asSlice(&asm.template), bound)) {
    Result<(), UnsupportedAsm | OutOfMemoryError>.Success {..} => {}
    Result<(), UnsupportedAsm | OutOfMemoryError>.Failure {error} => match move error {
      UnsupportedAsm bad => { return run X86Object.unsupported(Bytes.asSlice(&bad.detail), Bytes.asSlice(&em.symbol)) }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let rels = List<AsmCallReloc>.asSlice(&asmRelocs)
  let mut r = usize.ZERO
  while r < rels.length {
    run addReloc(&mut em.*, rels[r].offset, RelocationKind.Plt32, Bytes.asSlice(&rels[r].symbol), -4)
    r = r + usize.ONE
  }

  // Store the output GPR into `result`'s home slot.
  if hasOut && bound.length > usize.ZERO {
    run storeGp(&mut em.*, result, bound[usize.ZERO].reg)
  }
  return ()
}

// ---- Calls (SysV AMD64 C & Silk ABI, Direct & Indirect, 0/1/2-Value Returns) ----

effect fn emitCall(
  em: &mut Emitter,
  function: &SsaFunction,
  instIdx: usize,
  symbolIdx: usize,
  indirect: bool,
  fixed: usize,
  abiIdx: usize,
  inst: Instruction,
  ops: &[u64],
) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let ccMasks = List<u8>.asSlice(&em.frame.coldCallSaveMask)
  let coldSaveMask: u8 = if instIdx < ccMasks.length { ccMasks[instIdx] } else { 0 }
  if coldSaveMask != 0 {
    let baseOff = em.frame.callerSaveOffset
    if (coldSaveMask & 1) != 0 { drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), baseOff), X86Encode.r8()) }
    if (coldSaveMask & 2) != 0 { drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), baseOff + 8), X86Encode.r9()) }
    if (coldSaveMask & 4) != 0 { drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), baseOff + 16), X86Encode.rsi()) }
    if (coldSaveMask & 8) != 0 { drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), baseOff + 24), X86Encode.rdi()) }
    if (coldSaveMask & 16) != 0 { drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), baseOff + 32), X86Encode.rdx()) }
    if (coldSaveMask & 32) != 0 { drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), baseOff + 40), X86Encode.rcx()) }
  }
  let argStart = if indirect { usize.ONE } else { usize.ZERO }
  let argCount = ops.length - argStart
  let hasAbi = abiIdx != usize.MAX
  let callAbi = if hasAbi { function.callAbi(abiIdx) } else { CallAbi {callingConvention: CallingConvention.Silk, resultExtension: AbiExtension.None, parameterStart: usize.ZERO, parameterCount: usize.ZERO} }

  // First pass: plan how each argument is passed (GP reg, XMM reg, or stack offset).
  let mut gpCount = usize.ZERO
  let mut fpCount = usize.ZERO
  let mut stackSize: u64 = 0
  let mut argClass = run List<u8>.makeWithCapacity(argCount) // 0=GP, 1=FP, 2=I128_GP, 3=STACK, 4=BYVAL, 5=VEC_FP, 6=VEC_STACK
  let mut argLoc = run List<u64>.makeWithCapacity(argCount)  // reg index or stack byte offset
  let mut a = usize.ZERO
  while a < argCount {
    let opVal = ops[argStart + a]
    let k = function.value(opVal).kind
    let pAbi = if hasAbi && a < callAbi.parameterCount { function.callParameterAbisOf(abiIdx)[a] } else { ParameterAbi.plain() }
    if pAbi.byvalSize > 0 {
      let align: u64 = if pAbi.byvalAlignment > 8 { usize.toU64(pAbi.byvalAlignment) } else { 8 }
      stackSize = alignUpU64(stackSize, align)
      run List<u8>.append(&mut argClass, 4)
      run List<u64>.append(&mut argLoc, stackSize)
      stackSize = stackSize + ((pAbi.byvalSize + 7) / 8) * 8
    } else if k.isVector() {
      let sz = usize.toU64(k.storeSize())
      if sz <= 16 && fpCount < 8 {
        run List<u8>.append(&mut argClass, 5)
        run List<u64>.append(&mut argLoc, usize.toU64(fpCount))
        fpCount = fpCount + usize.ONE
      } else {
        let align: u64 = if sz >= 16 { 16 } else { 8 }
        stackSize = alignUpU64(stackSize, align)
        run List<u8>.append(&mut argClass, 6)
        run List<u64>.append(&mut argLoc, stackSize)
        stackSize = stackSize + ((sz + 7) / 8) * 8
      }
    } else if k.isFloat() {
      if fpCount < 8 {
        run List<u8>.append(&mut argClass, 1)
        run List<u64>.append(&mut argLoc, usize.toU64(fpCount))
        fpCount = fpCount + usize.ONE
      } else {
        run List<u8>.append(&mut argClass, 3)
        run List<u64>.append(&mut argLoc, stackSize)
        stackSize = stackSize + 8
      }
    } else if k.bits > 64 {
      if gpCount + 2 <= 6 {
        run List<u8>.append(&mut argClass, 2)
        run List<u64>.append(&mut argLoc, usize.toU64(gpCount))
        gpCount = gpCount + 2
      } else {
        run List<u8>.append(&mut argClass, 3)
        run List<u64>.append(&mut argLoc, stackSize)
        stackSize = stackSize + 16
      }
    } else {
      if gpCount < 6 {
        run List<u8>.append(&mut argClass, 0)
        run List<u64>.append(&mut argLoc, usize.toU64(gpCount))
        gpCount = gpCount + usize.ONE
      } else {
        run List<u8>.append(&mut argClass, 3)
        run List<u64>.append(&mut argLoc, stackSize)
        stackSize = stackSize + 8
      }
    }
    a = a + usize.ONE
  }

  let outgoingStack = alignUpU64(stackSize, 16)
  if outgoingStack > 0 {
    run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rsp(), u64.wrappingToI32(outgoingStack))
  }

  // Second pass: populate outgoing stack arguments first (so scratch regs are completely free).
  let cls = List<u8>.asSlice(&argClass)
  let loc = List<u64>.asSlice(&argLoc)
  a = usize.ZERO
  while a < argCount {
    let opVal = ops[argStart + a]
    let k = function.value(opVal).kind
    let pAbi = if hasAbi && a < callAbi.parameterCount { function.callParameterAbisOf(abiIdx)[a] } else { ParameterAbi.plain() }
    let off = u64.wrappingToI32(loc[a])
    if cls[a] == 4 {
      // `byval`: copy `pAbi.byvalSize` bytes from pointer operand to `[rsp + off]`.
      run loadGp(&mut em.*, function, opVal, X86Encode.rsi())
      drop run X86Encode.lea64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rsp(), off))
      run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), pAbi.byvalSize)
      run X86Encode.repMovsb(&mut em.code)
    } else if cls[a] == 6 {
      // Vector passed on stack (wide vector or 9th+ XMM vector argument).
      let sz = k.storeSize()
      if sz == 16 {
        let srcXmm = run xmmOrLoadVec128(&mut em.*, function, opVal, 0)
        drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(X86Encode.rsp(), off), srcXmm)
      } else if sz == 32 {
        if hasFeat(&em.*, X86Frame.featAvx2()) && k.isInteger() {
          let srcYmm = run ymmOrLoadVec256(&mut em.*, function, opVal, 0)
          drop run X86Encode.vmovdquYmmMr(&mut em.code, Mem.baseDisp(X86Encode.rsp(), off), srcYmm)
        } else {
          run vectorAddr(&mut em.*, function, opVal, X86Encode.r10())
          drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(X86Encode.r10(), 0))
          drop run X86Encode.movdquRm(&mut em.code, 1, Mem.baseDisp(X86Encode.r10(), 16))
          drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(X86Encode.rsp(), off), 0)
          drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(X86Encode.rsp(), off + 16), 1)
        }
      } else if sz == 1 || sz == 2 || sz == 4 || sz == 8 {
        run loadSmallVecGp(&mut em.*, function, opVal, X86Encode.rax())
        drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), off), X86Encode.rax())
      } else if sz > usize.ZERO {
        run vectorAddr(&mut em.*, function, opVal, X86Encode.rsi())
        drop run X86Encode.lea64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rsp(), off))
        run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), usize.toU64(sz))
        run X86Encode.repMovsb(&mut em.code)
      }
    } else if cls[a] == 3 {
      if k.isFloat() {
        run loadFloat(&mut em.*, function, opVal, 0, X86Encode.rax())
        if k.bits == 64 { drop run X86Encode.movsdMr(&mut em.code, Mem.baseDisp(X86Encode.rsp(), off), 0) }
        else { drop run X86Encode.movssMr(&mut em.code, Mem.baseDisp(X86Encode.rsp(), off), 0) }
      } else if k.bits > 64 {
        run loadPair(&mut em.*, function, opVal, X86Encode.rax(), X86Encode.rdx())
        drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), off), X86Encode.rax())
        drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), off + 8), X86Encode.rdx())
      } else {
        run loadGp(&mut em.*, function, opVal, X86Encode.rax())
        run applyParamExt(&mut em.*, X86Encode.rax(), k.bits, pAbi.extension)
        drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), off), X86Encode.rax())
      }
    }
    a = a + usize.ONE
  }

  // Third pass: stage XMM register arguments conflict-free via `resolveXmmMoves` (may clobber
  // `rax` for float/small-vec constants; never clobbers allocated GPRs).
  let mut xmmMoves = List<XmmMove>.make()
  let mut xmmReserved: u64 = 0
  a = usize.ZERO
  while a < argCount {
    let opVal = ops[argStart + a]
    if cls[a] == 1 {
      let dstXmm = u64.wrappingToU8(loc[a])
      let k = function.value(opVal).kind
      let w: u8 = if k.bits == 64 { 8 } else { 4 }
      let srcInfo = function.value(opVal)
      let mut srcKind: u8 = 2
      let mut srcReg: u8 = X86Frame.regNone()
      let mut srcOff: i32 = 0
      if srcInfo.definition != Definition.Constant {
        let sx = valXmm(&em.*, opVal)
        if sx != X86Frame.regNone() {
          srcKind = 0
          srcReg = sx
        } else {
          let so = valOff(&em.*, opVal)
          if so != 0 {
            srcKind = 1
            srcOff = so
          }
        }
      }
      if !(srcKind == 0 && srcReg == dstXmm) {
        run List<XmmMove>.append(&mut xmmMoves, XmmMove {
          srcKind: srcKind, width: w, srcVal: opVal, srcReg: srcReg, srcOff: srcOff,
          dstIsReg: true, dstReg: dstXmm, dstOff: 0, done: false,
        })
      } else if dstXmm < 16 {
        xmmReserved = xmmReserved | u64.shiftLeft(1, u8.toU64(dstXmm))
      }
    } else if cls[a] == 5 {
      let dstXmm = u64.wrappingToU8(loc[a])
      let sz = function.value(opVal).kind.storeSize()
      if sz == 16 {
        let srcInfo = function.value(opVal)
        let mut srcKind: u8 = 2
        let mut srcReg: u8 = X86Frame.regNone()
        let mut srcOff: i32 = 0
        if srcInfo.definition != Definition.Constant {
          let sx = valXmm(&em.*, opVal)
          if sx != X86Frame.regNone() {
            srcKind = 0
            srcReg = sx
          } else {
            let so = valOff(&em.*, opVal)
            if so != 0 {
              srcKind = 1
              srcOff = so
            }
          }
        }
        if !(srcKind == 0 && srcReg == dstXmm) {
          run List<XmmMove>.append(&mut xmmMoves, XmmMove {
            srcKind: srcKind, width: 16, srcVal: opVal, srcReg: srcReg, srcOff: srcOff,
            dstIsReg: true, dstReg: dstXmm, dstOff: 0, done: false,
          })
        } else if dstXmm < 16 {
          xmmReserved = xmmReserved | u64.shiftLeft(1, u8.toU64(dstXmm))
        }
      } else if sz == 1 || sz == 2 || sz == 4 || sz == 8 {
        run List<XmmMove>.append(&mut xmmMoves, XmmMove {
          srcKind: 4, width: 16, srcVal: opVal, srcReg: X86Frame.regNone(), srcOff: 0,
          dstIsReg: true, dstReg: dstXmm, dstOff: 0, done: false,
        })
      } else {
        run List<XmmMove>.append(&mut xmmMoves, XmmMove {
          srcKind: 5, width: 16, srcVal: opVal, srcReg: X86Frame.regNone(), srcOff: 0,
          dstIsReg: true, dstReg: dstXmm, dstOff: 0, done: false,
        })
      }
    }
    a = a + usize.ONE
  }
  if List<XmmMove>.length(&xmmMoves) > usize.ZERO {
    run resolveXmmMoves(&mut em.*, function, &mut xmmMoves, xmmReserved)
  }

  // Fourth pass: stage GP register arguments conflict-free via `resolveGpMoves`.
  // For indirect calls, pre-load the callee pointer into `rax` before `resolveGpMoves` overwrites
  // `rdi..r9` (`resolveGpMoves` + `applyParamExt` never clobber `rax` when all `dstIsReg == true`).
  if indirect {
    run loadGp(&mut em.*, function, ops[0], X86Encode.rax())
  }
  let mut gpMoves = List<GpMove>.make()
  a = usize.ZERO
  while a < argCount {
    let opVal = ops[argStart + a]
    if cls[a] == 0 {
      let dstReg = sysvGpArg(u64.toUsize(loc[a]))
      let fBytes = fusedLoadBytes(&em.*, opVal)
      if fBytes != 0 {
        run List<GpMove>.append(&mut gpMoves, GpMove {
          srcKind: 6, srcBytes: fBytes, srcVal: opVal, srcReg: X86Frame.regNone(), srcOff: fusedLoadOff(&em.*, opVal),
          dstIsReg: true, dstReg: dstReg, dstOff: 0, done: false,
        })
      } else {
        let srcInfo = function.value(opVal)
        let mut srcKind: u8 = 3
        let mut srcReg: u8 = X86Frame.regNone()
        let mut srcOff: i32 = 0
        if srcInfo.definition == Definition.Constant {
          srcKind = 2
        } else {
          let sb = valSlotBase(&em.*, opVal)
          if sb != 0 {
            srcKind = 4
            srcOff = sb
          } else {
            let sr = valReg(&em.*, opVal)
            if sr != X86Frame.regNone() {
              srcKind = 0
              srcReg = sr
            } else {
              let so = valOff(&em.*, opVal)
              if so != 0 {
                srcKind = 1
                srcOff = so
              }
            }
          }
        }
        if !(srcKind == 0 && srcReg == dstReg) {
          run List<GpMove>.append(&mut gpMoves, GpMove {
            srcKind: srcKind, srcBytes: 8, srcVal: opVal, srcReg: srcReg, srcOff: srcOff,
            dstIsReg: true, dstReg: dstReg, dstOff: 0, done: false,
          })
        }
      }
    } else if cls[a] == 2 {
      let g = u64.toUsize(loc[a])
      let loDst = sysvGpArg(g)
      let hiDst = sysvGpArg(g + usize.ONE)
      let srcInfo = function.value(opVal)
      if srcInfo.definition == Definition.Constant {
        let c = function.constantOf(opVal)
        run List<GpMove>.append(&mut gpMoves, GpMove {
          srcKind: 5, srcBytes: 8, srcVal: c.low, srcReg: X86Frame.regNone(), srcOff: 0,
          dstIsReg: true, dstReg: loDst, dstOff: 0, done: false,
        })
        run List<GpMove>.append(&mut gpMoves, GpMove {
          srcKind: 5, srcBytes: 8, srcVal: c.high, srcReg: X86Frame.regNone(), srcOff: 0,
          dstIsReg: true, dstReg: hiDst, dstOff: 0, done: false,
        })
      } else {
        let off = valOff(&em.*, opVal)
        if off != 0 {
          run List<GpMove>.append(&mut gpMoves, GpMove {
            srcKind: 1, srcBytes: 8, srcVal: 0, srcReg: X86Frame.regNone(), srcOff: off,
            dstIsReg: true, dstReg: loDst, dstOff: 0, done: false,
          })
          run List<GpMove>.append(&mut gpMoves, GpMove {
            srcKind: 1, srcBytes: 8, srcVal: 0, srcReg: X86Frame.regNone(), srcOff: off + 8,
            dstIsReg: true, dstReg: hiDst, dstOff: 0, done: false,
          })
        } else {
          run List<GpMove>.append(&mut gpMoves, GpMove {
            srcKind: 3, srcBytes: 8, srcVal: 0, srcReg: X86Frame.regNone(), srcOff: 0,
            dstIsReg: true, dstReg: loDst, dstOff: 0, done: false,
          })
          run List<GpMove>.append(&mut gpMoves, GpMove {
            srcKind: 3, srcBytes: 8, srcVal: 0, srcReg: X86Frame.regNone(), srcOff: 0,
            dstIsReg: true, dstReg: hiDst, dstOff: 0, done: false,
          })
        }
      }
    }
    a = a + usize.ONE
  }
  if List<GpMove>.length(&gpMoves) > usize.ZERO {
    run resolveGpMoves(&mut em.*, function, &mut gpMoves)
  }

  // Apply ABI parameter extensions after parallel moves settle so aliased values are never corrupted.
  a = usize.ZERO
  while a < argCount {
    if cls[a] == 0 {
      let pAbi = if hasAbi && a < callAbi.parameterCount { function.callParameterAbisOf(abiIdx)[a] } else { ParameterAbi.plain() }
      if pAbi.extension != AbiExtension.None {
        let k = function.value(ops[argStart + a]).kind
        run applyParamExt(&mut em.*, sysvGpArg(u64.toUsize(loc[a])), k.bits, pAbi.extension)
      }
    }
    a = a + usize.ONE
  }

  // SysV AMD64 variadic ABI (`al` = XMM arg count) + `call`.
  if em.frame.usesYmm {
    run X86Encode.vzeroupper(&mut em.code)
  }
  if indirect {
    if fixed != usize.MAX {
      run X86Encode.movRr64(&mut em.code, X86Encode.r11(), X86Encode.rax())
      run X86Encode.movImm32(&mut em.code, X86Encode.rax(), usize.toU64(fpCount))
      run X86Encode.callReg(&mut em.code, X86Encode.r11())
    } else {
      run X86Encode.callReg(&mut em.code, X86Encode.rax())
    }
  } else {
    if fixed != usize.MAX {
      run X86Encode.movImm32(&mut em.code, X86Encode.rax(), usize.toU64(fpCount))
    }
    let sym = function.symbolName(symbolIdx)
    let callAt = run X86Encode.callRel32(&mut em.code)
    run addReloc(&mut em.*, callAt, RelocationKind.Plt32, sym, -4)
  }

  if outgoingStack > 0 {
    run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rsp(), u64.wrappingToI32(outgoingStack))
  }

  // Store 0, 1, or 2 return values per SysV AMD64 register assignment (`rax`/`rdx`, `xmm0`/`xmm1`).
  let rc = inst.resultCount()
  if rc != usize.ZERO && !(rc == usize.ONE && isFusedCallStore(&em.*, inst.result)) {
    let mut gpRet = usize.ZERO
    let mut fpRet = usize.ZERO
    run storeReturnPiece(&mut em.*, inst.kind, inst.result, &mut gpRet, &mut fpRet)
    if rc >= 2 {
      run storeReturnPiece(&mut em.*, inst.secondKind, inst.result + 1, &mut gpRet, &mut fpRet)
    }
  }

  if coldSaveMask != 0 {
    let baseOff = em.frame.callerSaveOffset
    if (coldSaveMask & 1) != 0 { drop run X86Encode.movRm64(&mut em.code, X86Encode.r8(), Mem.baseDisp(X86Encode.rbp(), baseOff)) }
    if (coldSaveMask & 2) != 0 { drop run X86Encode.movRm64(&mut em.code, X86Encode.r9(), Mem.baseDisp(X86Encode.rbp(), baseOff + 8)) }
    if (coldSaveMask & 4) != 0 { drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rbp(), baseOff + 16)) }
    if (coldSaveMask & 8) != 0 { drop run X86Encode.movRm64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rbp(), baseOff + 24)) }
    if (coldSaveMask & 16) != 0 { drop run X86Encode.movRm64(&mut em.code, X86Encode.rdx(), Mem.baseDisp(X86Encode.rbp(), baseOff + 32)) }
    if (coldSaveMask & 32) != 0 { drop run X86Encode.movRm64(&mut em.code, X86Encode.rcx(), Mem.baseDisp(X86Encode.rbp(), baseOff + 40)) }
  }
  return ()
}

effect fn applyParamExt(em: &mut Emitter, reg: u8, bits: usize, ext: AbiExtension) -> () ! OutOfMemoryError ? &mut Allocator {
  match ext {
    AbiExtension.Signed => { return run normalizeInt(&mut em.*, reg, bits, true) }
    AbiExtension.Unsigned => { return run normalizeInt(&mut em.*, reg, bits, false) }
    AbiExtension.None => { return () }
  }
}

effect fn storeReturnPiece(em: &mut Emitter, kind: Kind, dstVal: u64, gpRet: &mut usize, fpRet: &mut usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  if kind.isVector() {
    let xmm = usize.toU8(fpRet.*)
    fpRet.* = fpRet.* + usize.ONE
    if kind.storeSize() == 16 {
      return run storeVec128(&mut em.*, dstVal, xmm)
    }
    let off = valOff(&em.*, dstVal)
    if off != 0 {
      drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), off), xmm)
    }
    return ()
  }
  if kind.isFloat() {
    let xmm = usize.toU8(fpRet.*)
    fpRet.* = fpRet.* + usize.ONE
    return run storeFloat(&mut em.*, dstVal, xmm, kind.bits == 64)
  }
  if kind.bits > 64 {
    gpRet.* = gpRet.* + 2
    return run storePair(&mut em.*, dstVal, X86Encode.rax(), X86Encode.rdx())
  }
  let reg = if gpRet.* == usize.ZERO { X86Encode.rax() } else { X86Encode.rdx() }
  gpRet.* = gpRet.* + usize.ONE
  return run storeGp(&mut em.*, dstVal, reg)
}

// ---- SIMD / Vector Operations & All 19 x86-64 Architecture Intrinsics ----

// Loads lane `idxReg` (in `r11`) of vector at address `baseReg` into `dstReg` (or `xmm0` for float).
effect fn loadVectorLane(em: &mut Emitter, kind: Kind, baseReg: u8, idxReg: u8, dstGp: u8, dstXmm: u8) -> ()
! OutOfMemoryError ? &mut Allocator {
  if kind.bits == 1 {
    // Bit-packed mask: byte = [base + (idx >> 3)], bit = (byte >> (idx & 7)) & 1.
    // Load through `r10` so `dstGp == rcx` is never clobbered before the shift.
    run X86Encode.movRr64(&mut em.code, X86Encode.rcx(), idxReg)
    run X86Encode.shiftImm64(&mut em.code, Shift.Shr, X86Encode.rcx(), 3)
    drop run X86Encode.movzxRm8(&mut em.code, X86Encode.r10(), Mem.baseIndex(baseReg, X86Encode.rcx(), 1, 0))
    run X86Encode.movRr64(&mut em.code, X86Encode.rcx(), idxReg)
    run X86Encode.aluRi32(&mut em.code, Alu.And, X86Encode.rcx(), 7)
    run X86Encode.shiftCl64(&mut em.code, Shift.Shr, X86Encode.r10())
    run X86Encode.aluRi64(&mut em.code, Alu.And, X86Encode.r10(), 1)
    return run X86Encode.movRr64(&mut em.code, dstGp, X86Encode.r10())
  }
  let eb = kind.elementBytes()
  let scale: u8 = usize.toU8(eb)
  let mem = Mem.baseIndex(baseReg, idxReg, scale, 0)
  if kind.isFloat() {
    if kind.bits == 64 { drop run X86Encode.movsdRm(&mut em.code, dstXmm, mem) }
    else { drop run X86Encode.movssRm(&mut em.code, dstXmm, mem) }
    return ()
  }
  if eb == 1 { drop run X86Encode.movzxRm8(&mut em.code, dstGp, mem) }
  else if eb == 2 { drop run X86Encode.movzxRm16(&mut em.code, dstGp, mem) }
  else if eb == 4 { drop run X86Encode.movRm32(&mut em.code, dstGp, mem) }
  else { drop run X86Encode.movRm64(&mut em.code, dstGp, mem) }
  return ()
}

// Clears unused padding bits in a bit-packed `mask<N>` destination slot before lane writes.
effect fn zeroMaskSlot(em: &mut Emitter, kind: Kind, dstOff: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  if kind.bits != 1 || dstOff == 0 { return () }
  let sz = kind.storeSize()
  run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rax())
  let mut at = usize.ZERO
  while at + 8 <= sz {
    drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff + usize.toI32(at)), X86Encode.rax())
    at = at + 8
  }
  while at < sz {
    drop run X86Encode.movMr8(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff + usize.toI32(at)), X86Encode.rax())
    at = at + usize.ONE
  }
  return ()
}

// Stores lane `idxReg` (`r11`) into vector at address `baseReg` from `srcGp` / `srcXmm`.
effect fn storeVectorLane(em: &mut Emitter, kind: Kind, baseReg: u8, idxReg: u8, srcGp: u8, srcXmm: u8) -> ()
! OutOfMemoryError ? &mut Allocator {
  if kind.bits == 1 {
    // Set or clear bit `idx & 7` in byte `[base + (idx >> 3)]` (clobbers `rcx`, `rdx`, `r8`).
    run X86Encode.movRr64(&mut em.code, X86Encode.r8(), idxReg)
    run X86Encode.shiftImm64(&mut em.code, Shift.Shr, X86Encode.r8(), 3)
    run X86Encode.movRr64(&mut em.code, X86Encode.rcx(), idxReg)
    run X86Encode.aluRi32(&mut em.code, Alu.And, X86Encode.rcx(), 7)
    run X86Encode.movImm32(&mut em.code, X86Encode.rdx(), 1)
    run X86Encode.shiftCl64(&mut em.code, Shift.Shl, X86Encode.rdx())
    // Clear bit, then OR in `(srcGp & 1) << (idx & 7)`.
    drop run X86Encode.movzxRm8(&mut em.code, X86Encode.r10(), Mem.baseIndex(baseReg, X86Encode.r8(), 1, 0))
    run X86Encode.not64(&mut em.code, X86Encode.rdx())
    run X86Encode.aluRr64(&mut em.code, Alu.And, X86Encode.r10(), X86Encode.rdx())
    run X86Encode.movRr64(&mut em.code, X86Encode.rdx(), srcGp)
    run X86Encode.aluRi64(&mut em.code, Alu.And, X86Encode.rdx(), 1)
    run X86Encode.shiftCl64(&mut em.code, Shift.Shl, X86Encode.rdx())
    run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.r10(), X86Encode.rdx())
    drop run X86Encode.movMr8(&mut em.code, Mem.baseIndex(baseReg, X86Encode.r8(), 1, 0), X86Encode.r10())
    return ()
  }
  let eb = kind.elementBytes()
  let scale: u8 = usize.toU8(eb)
  let mem = Mem.baseIndex(baseReg, idxReg, scale, 0)
  if kind.isFloat() {
    if kind.bits == 64 { drop run X86Encode.movsdMr(&mut em.code, mem, srcXmm) }
    else { drop run X86Encode.movssMr(&mut em.code, mem, srcXmm) }
    return ()
  }
  if eb == 1 { drop run X86Encode.movMr8(&mut em.code, mem, srcGp) }
  else if eb == 2 { drop run X86Encode.movMr16(&mut em.code, mem, srcGp) }
  else if eb == 4 { drop run X86Encode.movMr32(&mut em.code, mem, srcGp) }
  else { drop run X86Encode.movMr64(&mut em.code, mem, srcGp) }
  return ()
}

fn maskBitMask(elements: usize) -> u64 {
  if elements >= 64 { return u64.MAX }
  return u64.shiftLeft(1, usize.toU64(elements)) - 1
}

effect fn loadMaskBits64(em: &mut Emitter, function: &SsaFunction, value: u64, dstReg: u8) -> ()
! OutOfMemoryError ? &mut Allocator {
  let info = function.value(value)
  if info.definition == Definition.Constant {
    let c = function.constantOf(value)
    if (c.low & 1) == 0 {
      return run X86Encode.aluRr32(&mut em.code, Alu.Xor, dstReg, dstReg)
    }
    return run X86Encode.movImm64(&mut em.code, dstReg, maskBitMask(info.kind.elements))
  }
  let reg = valReg(&em.*, value)
  if reg != X86Frame.regNone() {
    if reg != dstReg { run X86Encode.movRr64(&mut em.code, dstReg, reg) }
    return ()
  }
  let off = valOff(&em.*, value)
  if off == 0 {
    return run X86Encode.aluRr32(&mut em.code, Alu.Xor, dstReg, dstReg)
  }
  let mem = Mem.baseDisp(X86Encode.rbp(), off)
  let sz = info.kind.storeSize()
  if sz == 1 { drop run X86Encode.movzxRm8(&mut em.code, dstReg, mem) }
  else if sz == 2 { drop run X86Encode.movzxRm16(&mut em.code, dstReg, mem) }
  else if sz == 4 { drop run X86Encode.movRm32(&mut em.code, dstReg, mem) }
  else { drop run X86Encode.movRm64(&mut em.code, dstReg, mem) }
  return ()
}

effect fn storeMaskBits64(em: &mut Emitter, kind: Kind, result: u64, srcReg: u8) -> ()
! OutOfMemoryError ? &mut Allocator {
  let reg = valReg(&em.*, result)
  if reg != X86Frame.regNone() {
    if reg != srcReg { run X86Encode.movRr64(&mut em.code, reg, srcReg) }
    return ()
  }
  let off = valOff(&em.*, result)
  if off == 0 { return () }
  let mem = Mem.baseDisp(X86Encode.rbp(), off)
  let sz = kind.storeSize()
  if sz == 1 { drop run X86Encode.movMr8(&mut em.code, mem, srcReg) }
  else if sz == 2 { drop run X86Encode.movMr16(&mut em.code, mem, srcReg) }
  else if sz == 4 { drop run X86Encode.movMr32(&mut em.code, mem, srcReg) }
  else { drop run X86Encode.movMr64(&mut em.code, mem, srcReg) }
  return ()
}

fn isGuaranteedUniformVec(function: &SsaFunction, value: u64) -> bool {
  if value == none() { return false }
  if function.value(value).definition == Definition.Constant { return true }
  let prod = function.producerOf(value)
  if prod != usize.MAX {
    if let Operation.Splat {..} = function.instruction(prod).operation { return true }
  }
  return false
}

// Splats low 8 bits of `gprByte` into all 16 bytes of `dstXmm` (4 SSE2 insns, zero `.rodata`).
effect fn emitSplatByteToXmm(em: &mut Emitter, gprByte: u8, dstXmm: u8) -> ()
! OutOfMemoryError ? &mut Allocator {
  run X86Encode.movdToXmm(&mut em.code, dstXmm, gprByte)
  run X86Encode.punpcklbw(&mut em.code, dstXmm, dstXmm)
  run X86Encode.punpcklwd(&mut em.code, dstXmm, dstXmm)
  return run X86Encode.pshufd(&mut em.code, dstXmm, dstXmm, 0)
}

// Emits a runtime uniformity check on `cntXmm` (`1` or `4..15`, never `2`), returning the branch
// index of `jne slow_distinct`. Clobbers only `xmm2` and `rax`.
effect fn emitVec128UniformCheck(em: &mut Emitter, laneBytes: usize, cntXmm: u8) -> usize
! OutOfMemoryError ? &mut Allocator {
  if laneBytes == 4 {
    run X86Encode.pshufd(&mut em.code, 2, cntXmm, 0)
    run X86Encode.pcmpeq(&mut em.code, 4, 2, cntXmm)
  } else if laneBytes == 2 {
    run X86Encode.pshuflw(&mut em.code, 2, cntXmm, 0)
    run X86Encode.pshufd(&mut em.code, 2, 2, 0)
    run X86Encode.pcmpeq(&mut em.code, 2, 2, cntXmm)
  } else {
    run X86Encode.movapsRr(&mut em.code, 2, cntXmm)
    run X86Encode.punpcklbw(&mut em.code, 2, 2)
    run X86Encode.punpcklwd(&mut em.code, 2, 2)
    run X86Encode.pshufd(&mut em.code, 2, 2, 0)
    run X86Encode.pcmpeq(&mut em.code, 1, 2, cntXmm)
  }
  run X86Encode.pmovmskb(&mut em.code, X86Encode.rax(), 2)
  run X86Encode.aluRi32(&mut em.code, Alu.Cmp, X86Encode.rax(), 0xFFFF)
  return run emitJcc(&mut em.*, X86Encode.ccNe())
}

// Direct 2-lane register-only lowering for all `u64x2`/`i64x2` dynamic shifts and rotates.
// Precondition: `workDst != valXmm && workDst != cntXmm && workDst != 2`. Clobbers `rax, rcx, xmm2`.
effect fn emitVec128Lane64ShiftOrRotate(em: &mut Emitter, shiftOp: Shift, valXmm: u8, cntXmm: u8, workDst: u8, uniform: bool) -> ()
! OutOfMemoryError ? &mut Allocator {
  run X86Encode.movqFromXmm(&mut em.code, X86Encode.rax(), valXmm)
  run X86Encode.movqFromXmm(&mut em.code, X86Encode.rcx(), cntXmm)
  run X86Encode.shiftCl64(&mut em.code, shiftOp, X86Encode.rax())
  run X86Encode.movqToXmm(&mut em.code, workDst, X86Encode.rax())
  run X86Encode.pshufd(&mut em.code, 2, valXmm, 0xEE)
  run X86Encode.movqFromXmm(&mut em.code, X86Encode.rax(), 2)
  if !uniform {
    run X86Encode.pshufd(&mut em.code, 2, cntXmm, 0xEE)
    run X86Encode.movqFromXmm(&mut em.code, X86Encode.rcx(), 2)
  }
  run X86Encode.shiftCl64(&mut em.code, shiftOp, X86Encode.rax())
  run X86Encode.movqToXmm(&mut em.code, 2, X86Encode.rax())
  return run X86Encode.punpcklqdq(&mut em.code, workDst, 2)
}

// Register-only unrolled 4-lane `slow_distinct` path for `u32x4`/`i32x4` shifts and rotates.
// Clobbers only scratch `rax, rcx, rdx, r10, r11, xmm2, xmm3`; writes `workDst` only at the end.
effect fn emitVec128Distinct32ShiftOrRotate(em: &mut Emitter, shiftOp: Shift, valXmm: u8, cntXmm: u8, workDst: u8) -> ()
! OutOfMemoryError ? &mut Allocator {
  // Pair 0 (lanes 0 & 1 -> `xmm2[63:0]`).
  run X86Encode.movqFromXmm(&mut em.code, X86Encode.rdx(), valXmm)
  run X86Encode.movqFromXmm(&mut em.code, X86Encode.r11(), cntXmm)
  run X86Encode.movRr32(&mut em.code, X86Encode.rax(), X86Encode.rdx())
  run X86Encode.movRr32(&mut em.code, X86Encode.rcx(), X86Encode.r11())
  run X86Encode.shiftCl32(&mut em.code, shiftOp, X86Encode.rax())
  run X86Encode.movRr32(&mut em.code, X86Encode.r10(), X86Encode.rax())
  run X86Encode.shiftImm64(&mut em.code, Shift.Shr, X86Encode.rdx(), 32)
  run X86Encode.shiftImm64(&mut em.code, Shift.Shr, X86Encode.r11(), 32)
  run X86Encode.movRr32(&mut em.code, X86Encode.rax(), X86Encode.rdx())
  run X86Encode.movRr32(&mut em.code, X86Encode.rcx(), X86Encode.r11())
  run X86Encode.shiftCl32(&mut em.code, shiftOp, X86Encode.rax())
  run X86Encode.shiftImm64(&mut em.code, Shift.Shl, X86Encode.rax(), 32)
  run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.r10(), X86Encode.rax())
  run X86Encode.movqToXmm(&mut em.code, 2, X86Encode.r10())
  // Pair 1 (lanes 2 & 3 -> `xmm3[63:0]`).
  run X86Encode.pshufd(&mut em.code, 3, valXmm, 0xEE)
  run X86Encode.movqFromXmm(&mut em.code, X86Encode.rdx(), 3)
  run X86Encode.pshufd(&mut em.code, 3, cntXmm, 0xEE)
  run X86Encode.movqFromXmm(&mut em.code, X86Encode.r11(), 3)
  run X86Encode.movRr32(&mut em.code, X86Encode.rax(), X86Encode.rdx())
  run X86Encode.movRr32(&mut em.code, X86Encode.rcx(), X86Encode.r11())
  run X86Encode.shiftCl32(&mut em.code, shiftOp, X86Encode.rax())
  run X86Encode.movRr32(&mut em.code, X86Encode.r10(), X86Encode.rax())
  run X86Encode.shiftImm64(&mut em.code, Shift.Shr, X86Encode.rdx(), 32)
  run X86Encode.shiftImm64(&mut em.code, Shift.Shr, X86Encode.r11(), 32)
  run X86Encode.movRr32(&mut em.code, X86Encode.rax(), X86Encode.rdx())
  run X86Encode.movRr32(&mut em.code, X86Encode.rcx(), X86Encode.r11())
  run X86Encode.shiftCl32(&mut em.code, shiftOp, X86Encode.rax())
  run X86Encode.shiftImm64(&mut em.code, Shift.Shl, X86Encode.rax(), 32)
  run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.r10(), X86Encode.rax())
  run X86Encode.movqToXmm(&mut em.code, 3, X86Encode.r10())
  run X86Encode.punpcklqdq(&mut em.code, 2, 3)
  if workDst != 2 {
    return run X86Encode.movapsRr(&mut em.code, workDst, 2)
  }
  return ()
}

// Compact scratch-only `slow_distinct` loop for `u8x16`/`i8x16` (`laneBytes == 1`) and
// `u16x8`/`i16x8` (`laneBytes == 2`) shifts and rotates. Clobbers only `rax, rcx, r11`.
effect fn emitVec128DistinctSmallShiftOrRotate(
  em: &mut Emitter,
  laneBytes: usize,
  shiftOp: Shift,
  isRotate: bool,
  valXmm: u8,
  cntXmm: u8,
  workDst: u8,
) -> () ! OutOfMemoryError ? &mut Allocator {
  run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rsp(), 48)
  drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 0), valXmm)
  drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 16), cntXmm)
  run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.r11(), X86Encode.r11())
  let loopHead = Bytes.length(&em.code)
  if laneBytes == 1 {
    drop run X86Encode.movzxRm8(&mut em.code, X86Encode.rax(), Mem.baseIndex(X86Encode.rsp(), X86Encode.r11(), 1, 0))
    drop run X86Encode.movzxRm8(&mut em.code, X86Encode.rcx(), Mem.baseIndex(X86Encode.rsp(), X86Encode.r11(), 1, 16))
    if !isRotate {
      run X86Encode.aluRi32(&mut em.code, Alu.And, X86Encode.rcx(), 7)
    }
    run X86Encode.shiftCl8(&mut em.code, shiftOp, X86Encode.rax())
    drop run X86Encode.movMr8(&mut em.code, Mem.baseIndex(X86Encode.rsp(), X86Encode.r11(), 1, 32), X86Encode.rax())
  } else {
    drop run X86Encode.movzxRm16(&mut em.code, X86Encode.rax(), Mem.baseIndex(X86Encode.rsp(), X86Encode.r11(), 2, 0))
    drop run X86Encode.movzxRm16(&mut em.code, X86Encode.rcx(), Mem.baseIndex(X86Encode.rsp(), X86Encode.r11(), 2, 16))
    if !isRotate {
      run X86Encode.aluRi32(&mut em.code, Alu.And, X86Encode.rcx(), 15)
    }
    run X86Encode.shiftCl16(&mut em.code, shiftOp, X86Encode.rax())
    drop run X86Encode.movMr16(&mut em.code, Mem.baseIndex(X86Encode.rsp(), X86Encode.r11(), 2, 32), X86Encode.rax())
  }
  run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r11(), 1)
  run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.r11(), if laneBytes == 1 { 16 } else { 8 })
  let back = run emitJcc(&mut em.*, X86Encode.ccB())
  patchTo(&mut em.*, back, loopHead)
  drop run X86Encode.movdquRm(&mut em.code, workDst, Mem.baseDisp(X86Encode.rsp(), 32))
  return run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rsp(), 48)
}

// Native SSE2 / register-only lowering for 128-bit integer vector shifts (`Shl`/`LShr`/`AShr`).
// Touches only scratch GPRs (`rax, rcx, rdx, r10, r11`) and scratch XMMs (`xmm0..xmm3`).
effect fn emitVector128Shift(em: &mut Emitter, function: &SsaFunction, op: Binary, kind: Kind, left: u64, right: u64, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let rDst = valXmm(&em.*, result)
  let dstOff = valOff(&em.*, result)
  if rDst == X86Frame.regNone() && dstOff == 0 { return () }
  let laneBytes = kind.bits / 8
  let shiftAmt = X86Frame.uniformVecConst(function, right)
  if shiftAmt < usize.toU64(kind.bits) {
    let amtU8 = u64.wrappingToU8(shiftAmt)
    let workDst = dstXmmOrScratch(&em.*, result, 0)
    if amtU8 == 0 {
      run loadVec128(&mut em.*, function, left, workDst)
      return run storeVec128(&mut em.*, result, workDst)
    }
    if (kind.bits == 16 || kind.bits == 32) || (kind.bits == 64 && op != Binary.AShr) {
      run loadVec128(&mut em.*, function, left, workDst)
      if op == Binary.Shl { run X86Encode.psllImm(&mut em.code, laneBytes, workDst, amtU8) }
      else if op == Binary.LShr { run X86Encode.psrlImm(&mut em.code, laneBytes, workDst, amtU8) }
      else { run X86Encode.psraImm(&mut em.code, laneBytes, workDst, amtU8) }
      return run storeVec128(&mut em.*, result, workDst)
    }
    if kind.bits == 64 {
      // Constant `i64x2` arithmetic right shift (8 insns, zero branches).
      let valXmm = run xmmOrLoadVec128(&mut em.*, function, left, 0)
      let wDst = if rDst != X86Frame.regNone() && rDst != valXmm { rDst } else { 3 }
      run X86Encode.movqFromXmm(&mut em.code, X86Encode.rax(), valXmm)
      run X86Encode.shiftImm64(&mut em.code, Shift.Sar, X86Encode.rax(), amtU8)
      run X86Encode.movqToXmm(&mut em.code, wDst, X86Encode.rax())
      run X86Encode.pshufd(&mut em.code, 2, valXmm, 0xEE)
      run X86Encode.movqFromXmm(&mut em.code, X86Encode.rax(), 2)
      run X86Encode.shiftImm64(&mut em.code, Shift.Sar, X86Encode.rax(), amtU8)
      run X86Encode.movqToXmm(&mut em.code, 2, X86Encode.rax())
      run X86Encode.punpcklqdq(&mut em.code, wDst, 2)
      return run storeVec128(&mut em.*, result, wDst)
    }
    // Constant `u8x16`/`i8x16` shift.
    run loadVec128(&mut em.*, function, left, workDst)
    if op == Binary.Shl || op == Binary.LShr {
      if op == Binary.Shl { run X86Encode.psllImm(&mut em.code, 2, workDst, amtU8) }
      else { run X86Encode.psrlImm(&mut em.code, 2, workDst, amtU8) }
      let maskByte: u64 = if op == Binary.Shl { u64.shiftLeft(0xFF, shiftAmt) & 0xFF } else { u64.shiftRight(0xFF, shiftAmt) }
      run X86Encode.movImm32(&mut em.code, X86Encode.rax(), maskByte * 0x01010101)
      run X86Encode.movdToXmm(&mut em.code, 1, X86Encode.rax())
      run X86Encode.pshufd(&mut em.code, 1, 1, 0)
      run X86Encode.pand(&mut em.code, workDst, 1)
    } else {
      run X86Encode.movapsRr(&mut em.code, 1, workDst)
      run X86Encode.psllImm(&mut em.code, 2, 1, 8)
      run X86Encode.psraImm(&mut em.code, 2, 1, amtU8 + 8)
      run X86Encode.psllImm(&mut em.code, 2, 1, 8)
      run X86Encode.psrlImm(&mut em.code, 2, 1, 8)
      run X86Encode.psraImm(&mut em.code, 2, workDst, amtU8)
      run X86Encode.psrlImm(&mut em.code, 2, workDst, 8)
      run X86Encode.psllImm(&mut em.code, 2, workDst, 8)
      run X86Encode.por(&mut em.code, workDst, 1)
    }
    return run storeVec128(&mut em.*, result, workDst)
  }

  // Dynamic shift count path.
  let shiftOp = if op == Binary.Shl { Shift.Shl } else if op == Binary.LShr { Shift.Shr } else { Shift.Sar }
  let valXmm = run xmmOrLoadVec128(&mut em.*, function, left, 0)
  let cntXmm = run xmmOrLoadVec128(&mut em.*, function, right, 1)
  let uniform = isGuaranteedUniformVec(function, right)
  if kind.bits == 64 {
    let workDst = if rDst != X86Frame.regNone() && rDst != valXmm && rDst != cntXmm { rDst } else { 3 }
    run emitVec128Lane64ShiftOrRotate(&mut em.*, shiftOp, valXmm, cntXmm, workDst, uniform)
    return run storeVec128(&mut em.*, result, workDst)
  }
  let workDst = if rDst != X86Frame.regNone() && rDst != valXmm && rDst != cntXmm { rDst } else { 0 }
  let mut slowBr = usize.MAX
  if !uniform {
    slowBr = run emitVec128UniformCheck(&mut em.*, laneBytes, cntXmm)
  }
  if kind.bits == 32 || kind.bits == 16 {
    run X86Encode.movdFromXmm(&mut em.code, X86Encode.rax(), cntXmm)
    run X86Encode.aluRi32(&mut em.code, Alu.And, X86Encode.rax(), usize.toI32(kind.bits - usize.ONE))
    run X86Encode.movdToXmm(&mut em.code, 2, X86Encode.rax())
    if workDst != valXmm {
      run X86Encode.movapsRr(&mut em.code, workDst, valXmm)
    }
    if op == Binary.Shl { run X86Encode.psllRr(&mut em.code, laneBytes, workDst, 2) }
    else if op == Binary.LShr { run X86Encode.psrlRr(&mut em.code, laneBytes, workDst, 2) }
    else { run X86Encode.psraRr(&mut em.code, laneBytes, workDst, 2) }
    if !uniform {
      let doneBr = run emitJmp(&mut em.*)
      patchHere(&mut em.*, slowBr)
      if kind.bits == 32 {
        run emitVec128Distinct32ShiftOrRotate(&mut em.*, shiftOp, valXmm, cntXmm, workDst)
      } else {
        run emitVec128DistinctSmallShiftOrRotate(&mut em.*, 2, shiftOp, false, valXmm, cntXmm, workDst)
      }
      patchHere(&mut em.*, doneBr)
    }
    return run storeVec128(&mut em.*, result, workDst)
  }
  // Dynamic `u8x16`/`i8x16` shift.
  run X86Encode.movdFromXmm(&mut em.code, X86Encode.rax(), cntXmm)
  run X86Encode.aluRi32(&mut em.code, Alu.And, X86Encode.rax(), 7)
  if op == Binary.Shl || op == Binary.LShr {
    run X86Encode.movdToXmm(&mut em.code, 2, X86Encode.rax())
    run X86Encode.movRr32(&mut em.code, X86Encode.rcx(), X86Encode.rax())
    run X86Encode.movImm32(&mut em.code, X86Encode.rdx(), 0xFF)
    if op == Binary.Shl {
      run X86Encode.shiftCl32(&mut em.code, Shift.Shl, X86Encode.rdx())
      run X86Encode.movzxRr8(&mut em.code, X86Encode.rdx(), X86Encode.rdx())
    } else {
      run X86Encode.shiftCl32(&mut em.code, Shift.Shr, X86Encode.rdx())
    }
    run emitSplatByteToXmm(&mut em.*, X86Encode.rdx(), 3)
    if workDst != valXmm {
      run X86Encode.movapsRr(&mut em.code, workDst, valXmm)
    }
    if op == Binary.Shl { run X86Encode.psllRr(&mut em.code, 2, workDst, 2) }
    else { run X86Encode.psrlRr(&mut em.code, 2, workDst, 2) }
    run X86Encode.pand(&mut em.code, workDst, 3)
  } else {
    run X86Encode.movdToXmm(&mut em.code, 2, X86Encode.rax())
    run X86Encode.aluRi32(&mut em.code, Alu.Add, X86Encode.rax(), 8)
    run X86Encode.movdToXmm(&mut em.code, 3, X86Encode.rax())
    run X86Encode.movapsRr(&mut em.code, 1, valXmm)
    if workDst != valXmm {
      run X86Encode.movapsRr(&mut em.code, workDst, valXmm)
    }
    run X86Encode.psllImm(&mut em.code, 2, 1, 8)
    run X86Encode.psraRr(&mut em.code, 2, 1, 3)
    run X86Encode.psllImm(&mut em.code, 2, 1, 8)
    run X86Encode.psrlImm(&mut em.code, 2, 1, 8)
    run X86Encode.psraRr(&mut em.code, 2, workDst, 2)
    run X86Encode.psrlImm(&mut em.code, 2, workDst, 8)
    run X86Encode.psllImm(&mut em.code, 2, workDst, 8)
    run X86Encode.por(&mut em.code, workDst, 1)
  }
  if !uniform {
    let doneBr = run emitJmp(&mut em.*)
    patchHere(&mut em.*, slowBr)
    run emitVec128DistinctSmallShiftOrRotate(&mut em.*, 1, shiftOp, false, valXmm, cntXmm, workDst)
    patchHere(&mut em.*, doneBr)
  }
  return run storeVec128(&mut em.*, result, workDst)
}

// Native SSE2 / register-only lowering for 128-bit integer vector rotates (`Rol`/`Ror`).
// Touches only scratch GPRs (`rax, rcx, rdx, r10, r11`) and scratch XMMs (`xmm0..xmm3`).
effect fn emitVector128Rotate(em: &mut Emitter, function: &SsaFunction, left: bool, kind: Kind, val: u64, amt: u64, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let rDst = valXmm(&em.*, result)
  let dstOff = valOff(&em.*, result)
  if rDst == X86Frame.regNone() && dstOff == 0 { return () }
  let laneBytes = kind.bits / 8
  let rawAmt = X86Frame.uniformVecConst(function, amt)
  if rawAmt < 64 {
    let width = usize.toU64(kind.bits)
    let k = rawAmt & (width - 1)
    let workDst = dstXmmOrScratch(&em.*, result, 0)
    run loadVec128(&mut em.*, function, val, workDst)
    if k == 0 {
      return run storeVec128(&mut em.*, result, workDst)
    }
    let shlAmt = u64.wrappingToU8(if left { k } else { width - k })
    let shrAmt = u64.wrappingToU8(width - u8.toU64(shlAmt))
    if kind.bits == 16 || kind.bits == 32 || kind.bits == 64 {
      run X86Encode.movapsRr(&mut em.code, 1, workDst)
      run X86Encode.psllImm(&mut em.code, laneBytes, workDst, shlAmt)
      run X86Encode.psrlImm(&mut em.code, laneBytes, 1, shrAmt)
      run X86Encode.por(&mut em.code, workDst, 1)
    } else {
      let shlMask: u64 = u64.shiftLeft(0xFF, u8.toU64(shlAmt)) & 0xFF
      run X86Encode.movapsRr(&mut em.code, 1, workDst)
      run X86Encode.psllImm(&mut em.code, 2, workDst, shlAmt)
      run X86Encode.psrlImm(&mut em.code, 2, 1, shrAmt)
      run X86Encode.movImm32(&mut em.code, X86Encode.rax(), shlMask * 0x01010101)
      run X86Encode.movdToXmm(&mut em.code, 2, X86Encode.rax())
      run X86Encode.pshufd(&mut em.code, 2, 2, 0)
      run X86Encode.pand(&mut em.code, workDst, 2)
      run X86Encode.pandn(&mut em.code, 2, 1)
      run X86Encode.por(&mut em.code, workDst, 2)
    }
    return run storeVec128(&mut em.*, result, workDst)
  }

  // Dynamic rotate count path.
  let shiftOp = if left { Shift.Rol } else { Shift.Ror }
  let valXmm = run xmmOrLoadVec128(&mut em.*, function, val, 0)
  let cntXmm = run xmmOrLoadVec128(&mut em.*, function, amt, 1)
  let uniform = isGuaranteedUniformVec(function, amt)
  if kind.bits == 64 {
    let workDst = if rDst != X86Frame.regNone() && rDst != valXmm && rDst != cntXmm { rDst } else { 3 }
    run emitVec128Lane64ShiftOrRotate(&mut em.*, shiftOp, valXmm, cntXmm, workDst, uniform)
    return run storeVec128(&mut em.*, result, workDst)
  }
  let workDst = if rDst != X86Frame.regNone() && rDst != valXmm && rDst != cntXmm { rDst } else { 0 }
  let mut slowBr = usize.MAX
  if !uniform {
    slowBr = run emitVec128UniformCheck(&mut em.*, laneBytes, cntXmm)
  }
  if kind.bits == 32 || kind.bits == 16 {
    run X86Encode.movdFromXmm(&mut em.code, X86Encode.rax(), cntXmm)
    run X86Encode.aluRi32(&mut em.code, Alu.And, X86Encode.rax(), usize.toI32(kind.bits - usize.ONE))
    run X86Encode.movImm32(&mut em.code, X86Encode.rcx(), usize.toU64(kind.bits))
    run X86Encode.aluRr32(&mut em.code, Alu.Sub, X86Encode.rcx(), X86Encode.rax())
    if left {
      run X86Encode.movdToXmm(&mut em.code, 2, X86Encode.rax())
      run X86Encode.movdToXmm(&mut em.code, 3, X86Encode.rcx())
    } else {
      run X86Encode.movdToXmm(&mut em.code, 2, X86Encode.rcx())
      run X86Encode.movdToXmm(&mut em.code, 3, X86Encode.rax())
    }
    run X86Encode.movapsRr(&mut em.code, 1, valXmm)
    if workDst != valXmm {
      run X86Encode.movapsRr(&mut em.code, workDst, valXmm)
    }
    run X86Encode.psllRr(&mut em.code, laneBytes, workDst, 2)
    run X86Encode.psrlRr(&mut em.code, laneBytes, 1, 3)
    run X86Encode.por(&mut em.code, workDst, 1)
    if !uniform {
      let doneBr = run emitJmp(&mut em.*)
      patchHere(&mut em.*, slowBr)
      if kind.bits == 32 {
        run emitVec128Distinct32ShiftOrRotate(&mut em.*, shiftOp, valXmm, cntXmm, workDst)
      } else {
        run emitVec128DistinctSmallShiftOrRotate(&mut em.*, 2, shiftOp, true, valXmm, cntXmm, workDst)
      }
      patchHere(&mut em.*, doneBr)
    }
    return run storeVec128(&mut em.*, result, workDst)
  }
  // Dynamic `u8x16`/`i8x16` rotate (branchless for `k = 0..7`).
  run X86Encode.movdFromXmm(&mut em.code, X86Encode.rax(), cntXmm)
  run X86Encode.aluRi32(&mut em.code, Alu.And, X86Encode.rax(), 7)
  run X86Encode.movImm32(&mut em.code, X86Encode.rcx(), 8)
  run X86Encode.aluRr32(&mut em.code, Alu.Sub, X86Encode.rcx(), X86Encode.rax())
  run X86Encode.movdToXmm(&mut em.code, 2, X86Encode.rax())
  run X86Encode.movdToXmm(&mut em.code, 3, X86Encode.rcx())
  run X86Encode.movapsRr(&mut em.code, 1, valXmm)
  if workDst != valXmm {
    run X86Encode.movapsRr(&mut em.code, workDst, valXmm)
  }
  if left {
    run X86Encode.psllRr(&mut em.code, 2, workDst, 2)
    run X86Encode.psrlRr(&mut em.code, 2, 1, 3)
    run X86Encode.movRr32(&mut em.code, X86Encode.rcx(), X86Encode.rax())
    run X86Encode.movImm32(&mut em.code, X86Encode.rdx(), 0xFF)
    run X86Encode.shiftCl32(&mut em.code, Shift.Shl, X86Encode.rdx())
    run X86Encode.movzxRr8(&mut em.code, X86Encode.rdx(), X86Encode.rdx())
  } else {
    run X86Encode.psrlRr(&mut em.code, 2, workDst, 2)
    run X86Encode.psllRr(&mut em.code, 2, 1, 3)
    run X86Encode.movRr32(&mut em.code, X86Encode.rcx(), X86Encode.rax())
    run X86Encode.movImm32(&mut em.code, X86Encode.rdx(), 0xFF)
    run X86Encode.shiftCl32(&mut em.code, Shift.Shr, X86Encode.rdx())
  }
  run emitSplatByteToXmm(&mut em.*, X86Encode.rdx(), 2)
  run X86Encode.pand(&mut em.code, workDst, 2)
  run X86Encode.pandn(&mut em.code, 2, 1)
  run X86Encode.por(&mut em.code, workDst, 2)
  if !uniform {
    let doneBr = run emitJmp(&mut em.*)
    patchHere(&mut em.*, slowBr)
    run emitVec128DistinctSmallShiftOrRotate(&mut em.*, 1, shiftOp, true, valXmm, cntXmm, workDst)
    patchHere(&mut em.*, doneBr)
  }
  return run storeVec128(&mut em.*, result, workDst)
}

effect fn emitVectorBinary(em: &mut Emitter, function: &SsaFunction, op: Binary, kind: Kind, left: u64, right: u64, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let sz = kind.storeSize()
  // Fast XMM-resident 16-byte lane-mask bitwise ops for `mask<16>` (`v16xi1`).
  if kind.bits == 1 && kind.elements == 16 && (op == Binary.And || op == Binary.Or || op == Binary.Xor)
    && (isXmmMask16(&em.*, result) || isXmmMask16(&em.*, left) || isXmmMask16(&em.*, right)) {
    if valXmm(&em.*, result) == X86Frame.regNone() && valReg(&em.*, result) == X86Frame.regNone() && valOff(&em.*, result) == 0 { return () }
    let rDst = if isXmmMask16(&em.*, result) { valXmm(&em.*, result) } else { X86Frame.regNone() }
    if hasFeat(&em.*, X86Frame.featAvx2()) {
      let lhsXmm = run xmmOrLoadMask16(&mut em.*, function, left, 0, 3)
      let rhsXmm = run xmmOrLoadMask16(&mut em.*, function, right, 1, 3)
      let workDst = if rDst != X86Frame.regNone() { rDst } else { 0 }
      if op == Binary.And { run X86Encode.vpandXmm(&mut em.code, workDst, lhsXmm, rhsXmm) }
      else if op == Binary.Or { run X86Encode.vporXmm(&mut em.code, workDst, lhsXmm, rhsXmm) }
      else { run X86Encode.vpxorXmm(&mut em.code, workDst, lhsXmm, rhsXmm) }
      return run storeXmmMask16(&mut em.*, kind, result, workDst)
    }
    let mut lhs = left
    let mut rhs = right
    if rDst != X86Frame.regNone() && isXmmMask16(&em.*, rhs) && valXmm(&em.*, rhs) == rDst && !(isXmmMask16(&em.*, lhs) && valXmm(&em.*, lhs) == rDst) {
      lhs = right
      rhs = left
    }
    let rRhs = if isXmmMask16(&em.*, rhs) { valXmm(&em.*, rhs) } else { X86Frame.regNone() }
    let workDst = if rDst != X86Frame.regNone() && rDst != rRhs { rDst } else { 0 }
    run loadMask16ToXmm(&mut em.*, function, lhs, workDst, 3)
    let rhsXmm = run xmmOrLoadMask16(&mut em.*, function, rhs, 1, 3)
    if op == Binary.And { run X86Encode.pand(&mut em.code, workDst, rhsXmm) }
    else if op == Binary.Or { run X86Encode.por(&mut em.code, workDst, rhsXmm) }
    else { run X86Encode.pxor(&mut em.code, workDst, rhsXmm) }
    return run storeXmmMask16(&mut em.*, kind, result, workDst)
  }
  // Fast scalar bitwise operations for bit-packed `mask<N>` vectors (`bits == 1`, `N <= 64`).
  if kind.bits == 1 && kind.elements <= 64 && (sz == 1 || sz == 2 || sz == 4 || sz == 8)
    && (op == Binary.And || op == Binary.Or || op == Binary.Xor) {
    if valReg(&em.*, result) == X86Frame.regNone() && valOff(&em.*, result) == 0 { return () }
    run loadMaskBits64(&mut em.*, function, left, X86Encode.rax())
    run loadMaskBits64(&mut em.*, function, right, X86Encode.r11())
    if op == Binary.And { run X86Encode.aluRr64(&mut em.code, Alu.And, X86Encode.rax(), X86Encode.r11()) }
    else if op == Binary.Or { run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.rax(), X86Encode.r11()) }
    else { run X86Encode.aluRr64(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.r11()) }
    if kind.elements < 64 {
      let m = maskBitMask(kind.elements)
      if m <= 0x7FFFFFFF {
        run X86Encode.aluRi32(&mut em.code, Alu.And, X86Encode.rax(), u64.wrappingToI32(m))
      } else {
        run X86Encode.movImm64(&mut em.code, X86Encode.r11(), m)
        run X86Encode.aluRr64(&mut em.code, Alu.And, X86Encode.rax(), X86Encode.r11())
      }
    }
    return run storeMaskBits64(&mut em.*, kind, result, X86Encode.rax())
  }
  // Native SSE2 / AVX2 fast path for 128-bit and 256-bit integer vectors (`i8`, `i16`, `i32`, `i64`).
  if kind.isInteger() && (sz == 16 || sz == 32) && (kind.bits == 8 || kind.bits == 16 || kind.bits == 32 || kind.bits == 64) {
    if sz == 16 && (op == Binary.Shl || op == Binary.LShr || op == Binary.AShr) {
      return run emitVector128Shift(&mut em.*, function, op, kind, left, right, result)
    }
    let laneBytes = kind.bits / 8
    let isBitwiseOrAddSub = op == Binary.Add || op == Binary.Sub || op == Binary.And || op == Binary.Or || op == Binary.Xor
    let shiftAmt = if !isBitwiseOrAddSub { X86Frame.uniformVecConst(function, right) } else { u64.MAX }
    let isConstShift = shiftAmt < usize.toU64(kind.bits) && (
      ((op == Binary.Shl || op == Binary.LShr) && (kind.bits == 16 || kind.bits == 32 || kind.bits == 64))
      || (op == Binary.AShr && (kind.bits == 16 || kind.bits == 32))
    )
    if isBitwiseOrAddSub || isConstShift {
      if sz == 32 {
        if hasFeat(&em.*, X86Frame.featAvx2()) {
          let rDst = valXmm(&em.*, result)
          let dstOff = valOff(&em.*, result)
          if rDst == X86Frame.regNone() && dstOff == 0 { return () }
          let workDst = dstXmmOrScratch(&em.*, result, 0)
          let lhsYmm = run ymmOrLoadVec256(&mut em.*, function, left, 0)
          if isConstShift {
            let amtU8 = u64.wrappingToU8(shiftAmt)
            if amtU8 == 0 {
              if workDst != lhsYmm { run X86Encode.vmovdqaYmmRr(&mut em.code, workDst, lhsYmm) }
            } else if op == Binary.Shl {
              run X86Encode.vpsllImmYmm(&mut em.code, laneBytes, workDst, lhsYmm, amtU8)
            } else if op == Binary.LShr {
              run X86Encode.vpsrlImmYmm(&mut em.code, laneBytes, workDst, lhsYmm, amtU8)
            } else {
              run X86Encode.vpsraImmYmm(&mut em.code, laneBytes, workDst, lhsYmm, amtU8)
            }
          } else {
            let rhsYmm = run ymmOrLoadVec256(&mut em.*, function, right, 1)
            if op == Binary.Add { run X86Encode.vpaddYmm(&mut em.code, laneBytes, workDst, lhsYmm, rhsYmm) }
            else if op == Binary.Sub { run X86Encode.vpsubYmm(&mut em.code, laneBytes, workDst, lhsYmm, rhsYmm) }
            else if op == Binary.And { run X86Encode.vpandYmm(&mut em.code, workDst, lhsYmm, rhsYmm) }
            else if op == Binary.Or { run X86Encode.vporYmm(&mut em.code, workDst, lhsYmm, rhsYmm) }
            else { run X86Encode.vpxorYmm(&mut em.code, workDst, lhsYmm, rhsYmm) }
          }
          return run storeVec256(&mut em.*, result, workDst)
        }
        let dstOff = valOff(&em.*, result)
        if dstOff == 0 { return () }
        run vectorAddr(&mut em.*, function, left, X86Encode.r10())
        if !isConstShift {
          run vectorAddr(&mut em.*, function, right, X86Encode.r11())
        }
        let mut half: i32 = 0
        while half < 32 {
          drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(X86Encode.r10(), half))
          if isConstShift {
            let amtU8 = u64.wrappingToU8(shiftAmt)
            if amtU8 != 0 {
              if op == Binary.Shl { run X86Encode.psllImm(&mut em.code, laneBytes, 0, amtU8) }
              else if op == Binary.LShr { run X86Encode.psrlImm(&mut em.code, laneBytes, 0, amtU8) }
              else { run X86Encode.psraImm(&mut em.code, laneBytes, 0, amtU8) }
            }
          } else {
            drop run X86Encode.movdquRm(&mut em.code, 1, Mem.baseDisp(X86Encode.r11(), half))
            if op == Binary.Add { run X86Encode.padd(&mut em.code, laneBytes, 0, 1) }
            else if op == Binary.Sub { run X86Encode.psub(&mut em.code, laneBytes, 0, 1) }
            else if op == Binary.And { run X86Encode.pand(&mut em.code, 0, 1) }
            else if op == Binary.Or { run X86Encode.por(&mut em.code, 0, 1) }
            else { run X86Encode.pxor(&mut em.code, 0, 1) }
          }
          drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff + half), 0)
          half = half + 16
        }
        return ()
      }
      let rDst = valXmm(&em.*, result)
      let dstOff = valOff(&em.*, result)
      if rDst == X86Frame.regNone() && dstOff == 0 { return () }
      if isConstShift {
        let workDst = dstXmmOrScratch(&em.*, result, 0)
        run loadVec128(&mut em.*, function, left, workDst)
        let amtU8 = u64.wrappingToU8(shiftAmt)
        if amtU8 != 0 {
          if op == Binary.Shl { run X86Encode.psllImm(&mut em.code, laneBytes, workDst, amtU8) }
          else if op == Binary.LShr { run X86Encode.psrlImm(&mut em.code, laneBytes, workDst, amtU8) }
          else { run X86Encode.psraImm(&mut em.code, laneBytes, workDst, amtU8) }
        }
        return run storeVec128(&mut em.*, result, workDst)
      }
      if hasFeat(&em.*, X86Frame.featAvx2()) {
        let workDst = if rDst != X86Frame.regNone() { rDst } else { 0 }
        let rightIsConst = function.value(right).definition == Definition.Constant && function.constantOf(right).low != 0
        let leftIsConst = op != Binary.Sub && function.value(left).definition == Definition.Constant && function.constantOf(left).low != 0
        if rightIsConst || leftIsConst {
          let varSide = if rightIsConst { left } else { right }
          let constSide = if rightIsConst { right } else { left }
          let lhsXmm = run xmmOrLoadVec128(&mut em.*, function, varSide, 0)
          let img = run buildVectorConstantBytes(kind, function.constantOf(constSide).low)
          let roOff = run addRodata16(&mut em.*, Bytes.asSlice(&img))
          let dispAt = if op == Binary.Add { run X86Encode.vpaddXmmRm(&mut em.code, laneBytes, workDst, lhsXmm, Mem.ripRel(0)) }
            else if op == Binary.Sub { run X86Encode.vpsubXmmRm(&mut em.code, laneBytes, workDst, lhsXmm, Mem.ripRel(0)) }
            else if op == Binary.And { run X86Encode.vpandXmmRm(&mut em.code, workDst, lhsXmm, Mem.ripRel(0)) }
            else if op == Binary.Or { run X86Encode.vporXmmRm(&mut em.code, workDst, lhsXmm, Mem.ripRel(0)) }
            else { run X86Encode.vpxorXmmRm(&mut em.code, workDst, lhsXmm, Mem.ripRel(0)) }
          run addRodataReloc(&mut em.*, dispAt, roOff)
          return run storeVec128(&mut em.*, result, workDst)
        }
        let lhsXmm = run xmmOrLoadVec128(&mut em.*, function, left, 0)
        let rhsXmm = run xmmOrLoadVec128(&mut em.*, function, right, 1)
        if op == Binary.Add { run X86Encode.vpaddXmm(&mut em.code, laneBytes, workDst, lhsXmm, rhsXmm) }
        else if op == Binary.Sub { run X86Encode.vpsubXmm(&mut em.code, laneBytes, workDst, lhsXmm, rhsXmm) }
        else if op == Binary.And { run X86Encode.vpandXmm(&mut em.code, workDst, lhsXmm, rhsXmm) }
        else if op == Binary.Or { run X86Encode.vporXmm(&mut em.code, workDst, lhsXmm, rhsXmm) }
        else { run X86Encode.vpxorXmm(&mut em.code, workDst, lhsXmm, rhsXmm) }
        return run storeVec128(&mut em.*, result, workDst)
      }
      let rRhs = if function.value(right).definition != Definition.Constant { valXmm(&em.*, right) } else { X86Frame.regNone() }
      let workDst = if rDst != X86Frame.regNone() && rDst != rRhs { rDst } else { 0 }
      run loadVec128(&mut em.*, function, left, workDst)
      let rhsXmm = run xmmOrLoadVec128(&mut em.*, function, right, 1)
      if op == Binary.Add { run X86Encode.padd(&mut em.code, laneBytes, workDst, rhsXmm) }
      else if op == Binary.Sub { run X86Encode.psub(&mut em.code, laneBytes, workDst, rhsXmm) }
      else if op == Binary.And { run X86Encode.pand(&mut em.code, workDst, rhsXmm) }
      else if op == Binary.Or { run X86Encode.por(&mut em.code, workDst, rhsXmm) }
      else { run X86Encode.pxor(&mut em.code, workDst, rhsXmm) }
      return run storeVec128(&mut em.*, result, workDst)
    }
  }
  let dstOff = valOff(&em.*, result)
  if dstOff == 0 { return () }
  run zeroMaskSlot(&mut em.*, kind, dstOff)
  // Reserve 24 bytes on stack for lane loop state: [rsp+0]=dstPtr, [rsp+8]=lhsPtr, [rsp+16]=rhsPtr, [rsp+24]=idx.
  run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rsp(), 32)
  drop run X86Encode.lea64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), dstOff))
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 0), X86Encode.rax())
  run vectorAddr(&mut em.*, function, left, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 8), X86Encode.rax())
  run vectorAddr(&mut em.*, function, right, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 16), X86Encode.rax())
  drop run X86Encode.movMi64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 24), 0)

  let loopHead = Bytes.length(&em.code)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 24))
  run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.r11(), usize.toI32(kind.elements))
  let done = run emitJcc(&mut em.*, X86Encode.ccAe())

  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 8))
  run loadVectorLane(&mut em.*, kind, X86Encode.rsi(), X86Encode.r11(), X86Encode.r9(), 0)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 16))
  run loadVectorLane(&mut em.*, kind, X86Encode.rsi(), X86Encode.r11(), X86Encode.rcx(), 1)
  if kind.isFloat() {
    let double = kind.bits == 64
    match op {
      Binary.Add => { run X86Encode.addFloat(&mut em.code, double, 0, 1) }
      Binary.Sub => { run X86Encode.subFloat(&mut em.code, double, 0, 1) }
      Binary.Mul => { run X86Encode.mulFloat(&mut em.code, double, 0, 1) }
      Binary.UDiv => { run X86Encode.divFloat(&mut em.code, double, 0, 1) }
      Binary.SDiv => { run X86Encode.divFloat(&mut em.code, double, 0, 1) }
      Binary.URem => { run callExternal(&mut em.*, if double { b"fmod" } else { b"fmodf" }) }
      Binary.SRem => { run callExternal(&mut em.*, if double { b"fmod" } else { b"fmodf" }) }
      _ => {}
    }
  } else {
    run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.r9())
    run emitScalarIntBinaryRegs(&mut em.*, op, kind.bits)
  }
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rsp(), 0))
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 24))
  run storeVectorLane(&mut em.*, kind, X86Encode.rdi(), X86Encode.r11(), X86Encode.rax(), 0)
  run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r11(), 1)
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 24), X86Encode.r11())
  let back = run emitJmp(&mut em.*)
  patchTo(&mut em.*, back, loopHead)
  patchHere(&mut em.*, done)
  return run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rsp(), 32)
}

// `mode == 0`: float negate; `mode == 1`: float sqrt.
effect fn emitVectorUnary(em: &mut Emitter, function: &SsaFunction, mode: u8, kind: Kind, src: u64, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let dstOff = valOff(&em.*, result)
  if dstOff == 0 { return () }
  run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rsp(), 32)
  drop run X86Encode.lea64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), dstOff))
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 0), X86Encode.rax())
  run vectorAddr(&mut em.*, function, src, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 8), X86Encode.rax())
  drop run X86Encode.movMi64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 16), 0)

  let loopHead = Bytes.length(&em.code)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 16))
  run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.r11(), usize.toI32(kind.elements))
  let done = run emitJcc(&mut em.*, X86Encode.ccAe())
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 8))
  run loadVectorLane(&mut em.*, kind, X86Encode.rsi(), X86Encode.r11(), X86Encode.rax(), 0)
  if mode == 0 {
    if kind.bits == 64 {
      run X86Encode.movqFromXmm(&mut em.code, X86Encode.rax(), 0)
      run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), 0x8000000000000000)
      run X86Encode.aluRr64(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rcx())
      run X86Encode.movqToXmm(&mut em.code, 0, X86Encode.rax())
    } else {
      run X86Encode.movdFromXmm(&mut em.code, X86Encode.rax(), 0)
      run X86Encode.movImm32(&mut em.code, X86Encode.rcx(), 0x80000000)
      run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rcx())
      run X86Encode.movdToXmm(&mut em.code, 0, X86Encode.rax())
    }
  } else {
    run X86Encode.sqrtFloat(&mut em.code, kind.bits == 64, 0, 0)
  }
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rsp(), 0))
  run storeVectorLane(&mut em.*, kind, X86Encode.rdi(), X86Encode.r11(), X86Encode.rax(), 0)
  run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r11(), 1)
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 16), X86Encode.r11())
  let back = run emitJmp(&mut em.*)
  patchTo(&mut em.*, back, loopHead)
  patchHere(&mut em.*, done)
  return run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rsp(), 32)
}

effect fn emitVectorCompare(em: &mut Emitter, function: &SsaFunction, pred: Predicate, opKind: Kind, left: u64, right: u64, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let dstXmm = if isXmmMask16(&em.*, result) { valXmm(&em.*, result) } else { X86Frame.regNone() }
  let dstReg = valReg(&em.*, result)
  let dstOff = valOff(&em.*, result)
  if dstXmm == X86Frame.regNone() && dstReg == X86Frame.regNone() && dstOff == 0 { return () }
  let maskKind = opKind.flags()
  // Native SSE2 fast path for 128-bit integer vectors (`v16xi8`, `v8xi16`, `v4xi32`).
  if opKind.isInteger() && opKind.storeSize() == 16 && (opKind.bits == 8 || opKind.bits == 16 || opKind.bits == 32) {
    let laneBytes = opKind.bits / 8
    let isUnsigned = pred == Predicate.Ult || pred == Predicate.Ule || pred == Predicate.Ugt || pred == Predicate.Uge
    let isEq = pred == Predicate.Eq || pred == Predicate.Ne
    let swapOps = pred == Predicate.Slt || pred == Predicate.Sge || pred == Predicate.Ult || pred == Predicate.Uge
    let invert = pred == Predicate.Ne || pred == Predicate.Sle || pred == Predicate.Sge || pred == Predicate.Ule || pred == Predicate.Uge

    let mut resXmm: u8 = 0
    let mut needInvert = invert
    let mut handledU8MinMax = false
    if laneBytes == 1 && isUnsigned {
      let leftIsConst = function.value(left).definition == Definition.Constant
      let rightIsConst = function.value(right).definition == Definition.Constant
      let mut useMin = false
      let mut useMax = false
      let mut varSide = none()
      let mut otherSide = none()
      let mut otherConst: u64 = u64.MAX
      let mut constResultZero = false
      if pred == Predicate.Ule {
        useMin = true
        varSide = left
        otherSide = right
      } else if pred == Predicate.Uge {
        useMax = true
        varSide = left
        otherSide = right
      } else if pred == Predicate.Ult && rightIsConst {
        let c = function.constantOf(right).low & 0xFF
        if c == 0 {
          constResultZero = true
        } else {
          useMin = true
          varSide = left
          otherConst = c - 1
        }
      } else if pred == Predicate.Ugt && rightIsConst {
        let c = function.constantOf(right).low & 0xFF
        if c == 255 {
          constResultZero = true
        } else {
          useMax = true
          varSide = left
          otherConst = c + 1
        }
      } else if pred == Predicate.Ult && leftIsConst {
        let c = function.constantOf(left).low & 0xFF
        if c == 255 {
          constResultZero = true
        } else {
          useMax = true
          varSide = right
          otherConst = c + 1
        }
      } else if pred == Predicate.Ugt && leftIsConst {
        let c = function.constantOf(left).low & 0xFF
        if c == 0 {
          constResultZero = true
        } else {
          useMin = true
          varSide = right
          otherConst = c - 1
        }
      }
      if constResultZero {
        let work = if dstXmm != X86Frame.regNone() { dstXmm } else { 0 }
        run X86Encode.pxor(&mut em.code, work, work)
        resXmm = work
        needInvert = false
        handledU8MinMax = true
      } else if useMin || useMax {
        let mut constByte: u64 = otherConst
        if constByte == u64.MAX && otherSide != none() && function.value(otherSide).definition == Definition.Constant {
          constByte = function.constantOf(otherSide).low & 0xFF
        }
        if hasFeat(&em.*, X86Frame.featAvx2()) {
          let lhsXmm = run xmmOrLoadVec128(&mut em.*, function, varSide, 1)
          let work = if dstXmm != X86Frame.regNone() && dstXmm != lhsXmm { dstXmm } else { 0 }
          if constByte != u64.MAX && constByte != 0 {
            let img = run buildVectorConstantBytes(opKind, constByte)
            let roOff = run addRodata16(&mut em.*, Bytes.asSlice(&img))
            let dispAt = if useMin {
              run X86Encode.vpminubXmmRm(&mut em.code, work, lhsXmm, Mem.ripRel(0))
            } else {
              run X86Encode.vpmaxubXmmRm(&mut em.code, work, lhsXmm, Mem.ripRel(0))
            }
            run addRodataReloc(&mut em.*, dispAt, roOff)
          } else {
            let rhsXmm = if constByte == 0 {
              run X86Encode.vpxorXmm(&mut em.code, work, work, work)
              work
            } else {
              run xmmOrLoadVec128(&mut em.*, function, otherSide, work)
            }
            if useMin {
              run X86Encode.vpminubXmm(&mut em.code, work, lhsXmm, rhsXmm)
            } else {
              run X86Encode.vpmaxubXmm(&mut em.code, work, lhsXmm, rhsXmm)
            }
          }
          run X86Encode.vpcmpeqXmm(&mut em.code, 1, work, work, lhsXmm)
          resXmm = work
          needInvert = false
          handledU8MinMax = true
        } else {
          let mut rhsXmm: u8 = 1
          if otherConst != u64.MAX {
            if otherConst == 0 {
              run X86Encode.pxor(&mut em.code, 1, 1)
            } else {
              let img = run buildVectorConstantBytes(opKind, otherConst)
              let roOff = run addRodata16(&mut em.*, Bytes.asSlice(&img))
              let dispAt = run X86Encode.movdquRm(&mut em.code, 1, Mem.ripRel(0))
              run addRodataReloc(&mut em.*, dispAt, roOff)
            }
          } else {
            rhsXmm = run xmmOrLoadVec128(&mut em.*, function, otherSide, 1)
          }
          let workSse = if dstXmm != X86Frame.regNone() && dstXmm != rhsXmm { dstXmm } else { 0 }
          run loadVec128(&mut em.*, function, varSide, workSse)
          if useMin {
            // `varSide <= rhs` iff `max(varSide, rhs) == rhs` (keeps `rhsXmm` intact).
            run X86Encode.pmaxub(&mut em.code, workSse, rhsXmm)
          } else {
            // `varSide >= rhs` iff `min(varSide, rhs) == rhs` (keeps `rhsXmm` intact).
            run X86Encode.pminub(&mut em.code, workSse, rhsXmm)
          }
          run X86Encode.pcmpeq(&mut em.code, 1, workSse, rhsXmm)
          resXmm = workSse
          needInvert = false
          handledU8MinMax = true
        }
      }
    }
    if handledU8MinMax {
      // Exact lane mask already in `resXmm` with zero `0x80` bias or `xmm2` clobber.
    } else if isUnsigned {
      let leftIsConst = function.value(left).definition == Definition.Constant
      let rightIsConst = function.value(right).definition == Definition.Constant
      if leftIsConst {
        let mut lImg = run buildVectorConstantBytes(opKind, function.constantOf(left).low)
        let lBuf = Bytes.asMutSlice(&mut lImg)
        let mut k = usize.ZERO
        while k < 16 {
          if (k % laneBytes) == (laneBytes - usize.ONE) { lBuf[k] = u8.bitXor(lBuf[k], 0x80) }
          k = k + usize.ONE
        }
        let roL = run addRodata16(&mut em.*, Bytes.asSlice(&lImg))
        let dispL = run X86Encode.movdquRm(&mut em.code, 0, Mem.ripRel(0))
        run addRodataReloc(&mut em.*, dispL, roL)
      } else {
        run loadVec128(&mut em.*, function, left, 0)
      }
      if rightIsConst {
        let mut rImg = run buildVectorConstantBytes(opKind, function.constantOf(right).low)
        let rBuf = Bytes.asMutSlice(&mut rImg)
        let mut k = usize.ZERO
        while k < 16 {
          if (k % laneBytes) == (laneBytes - usize.ONE) { rBuf[k] = u8.bitXor(rBuf[k], 0x80) }
          k = k + usize.ONE
        }
        let roR = run addRodata16(&mut em.*, Bytes.asSlice(&rImg))
        let dispR = run X86Encode.movdquRm(&mut em.code, 1, Mem.ripRel(0))
        run addRodataReloc(&mut em.*, dispR, roR)
      } else {
        run loadVec128(&mut em.*, function, right, 1)
      }
      if !leftIsConst || !rightIsConst {
        let mut bias = run Bytes.zeroed(16)
        let bBuf = Bytes.asMutSlice(&mut bias)
        let mut k = usize.ZERO
        while k < 16 {
          if (k % laneBytes) == (laneBytes - usize.ONE) { bBuf[k] = 0x80 }
          k = k + usize.ONE
        }
        let roOff = run addRodata16(&mut em.*, Bytes.asSlice(&bias))
        let dispAt = run X86Encode.movdquRm(&mut em.code, 2, Mem.ripRel(0))
        run addRodataReloc(&mut em.*, dispAt, roOff)
        if !leftIsConst { run X86Encode.pxor(&mut em.code, 0, 2) }
        if !rightIsConst { run X86Encode.pxor(&mut em.code, 1, 2) }
      }
      if swapOps {
        run X86Encode.pcmpgt(&mut em.code, laneBytes, 1, 0)
        resXmm = 1
      } else {
        run X86Encode.pcmpgt(&mut em.code, laneBytes, 0, 1)
        resXmm = 0
      }
    } else if isEq {
      if hasFeat(&em.*, X86Frame.featAvx2()) {
        let work = if dstXmm != X86Frame.regNone() { dstXmm } else { 0 }
        let rightIsConst = function.value(right).definition == Definition.Constant && function.constantOf(right).low != 0
        let leftIsConst = function.value(left).definition == Definition.Constant && function.constantOf(left).low != 0
        if rightIsConst || leftIsConst {
          let varSide = if rightIsConst { left } else { right }
          let constSide = if rightIsConst { right } else { left }
          let lhsXmm = run xmmOrLoadVec128(&mut em.*, function, varSide, 0)
          let img = run buildVectorConstantBytes(opKind, function.constantOf(constSide).low)
          let roOff = run addRodata16(&mut em.*, Bytes.asSlice(&img))
          let dispAt = run X86Encode.vpcmpeqXmmRm(&mut em.code, laneBytes, work, lhsXmm, Mem.ripRel(0))
          run addRodataReloc(&mut em.*, dispAt, roOff)
        } else {
          let lhsXmm = run xmmOrLoadVec128(&mut em.*, function, left, 0)
          let rhsXmm = run xmmOrLoadVec128(&mut em.*, function, right, 1)
          run X86Encode.vpcmpeqXmm(&mut em.code, laneBytes, work, lhsXmm, rhsXmm)
        }
        resXmm = work
      } else {
        let rRhs = if function.value(right).definition != Definition.Constant { valXmm(&em.*, right) } else { X86Frame.regNone() }
        let work = if dstXmm != X86Frame.regNone() && dstXmm != rRhs { dstXmm } else { 0 }
        run loadVec128(&mut em.*, function, left, work)
        let rhsXmm = run xmmOrLoadVec128(&mut em.*, function, right, 1)
        run X86Encode.pcmpeq(&mut em.code, laneBytes, work, rhsXmm)
        resXmm = work
      }
    } else if swapOps {
      let rLhs = if function.value(left).definition != Definition.Constant { valXmm(&em.*, left) } else { X86Frame.regNone() }
      let work = if dstXmm != X86Frame.regNone() && dstXmm != rLhs { dstXmm } else { 1 }
      run loadVec128(&mut em.*, function, right, work)
      let lhsXmm = run xmmOrLoadVec128(&mut em.*, function, left, 0)
      run X86Encode.pcmpgt(&mut em.code, laneBytes, work, lhsXmm)
      resXmm = work
    } else {
      let rRhs = if function.value(right).definition != Definition.Constant { valXmm(&em.*, right) } else { X86Frame.regNone() }
      let work = if dstXmm != X86Frame.regNone() && dstXmm != rRhs { dstXmm } else { 0 }
      run loadVec128(&mut em.*, function, left, work)
      let rhsXmm = run xmmOrLoadVec128(&mut em.*, function, right, 1)
      run X86Encode.pcmpgt(&mut em.code, laneBytes, work, rhsXmm)
      resXmm = work
    }
    if dstXmm != X86Frame.regNone() && laneBytes == 1 {
      if needInvert {
        run X86Encode.pcmpeq(&mut em.code, 1, 2, 2)
        run X86Encode.pxor(&mut em.code, resXmm, 2)
      }
      return run storeXmmMask16(&mut em.*, maskKind, result, resXmm)
    }
    if laneBytes == 2 {
      run X86Encode.packsswb(&mut em.code, resXmm, resXmm)
    } else if laneBytes == 4 {
      run X86Encode.packssdw(&mut em.code, resXmm, resXmm)
      run X86Encode.packsswb(&mut em.code, resXmm, resXmm)
    }
    run X86Encode.pmovmskb(&mut em.code, X86Encode.rax(), resXmm)
    let fullMask: i32 = if laneBytes == 1 { 0xFFFF } else if laneBytes == 2 { 0xFF } else { 0x0F }
    if laneBytes != 1 {
      run X86Encode.aluRi32(&mut em.code, Alu.And, X86Encode.rax(), fullMask)
    }
    if needInvert {
      run X86Encode.aluRi32(&mut em.code, Alu.Xor, X86Encode.rax(), fullMask)
    }
    return run storeMaskBits64(&mut em.*, maskKind, result, X86Encode.rax())
  }
  if dstOff == 0 { return () }
  run zeroMaskSlot(&mut em.*, maskKind, dstOff)
  run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rsp(), 32)
  drop run X86Encode.lea64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), dstOff))
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 0), X86Encode.rax())
  run vectorAddr(&mut em.*, function, left, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 8), X86Encode.rax())
  run vectorAddr(&mut em.*, function, right, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 16), X86Encode.rax())
  drop run X86Encode.movMi64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 24), 0)

  let loopHead = Bytes.length(&em.code)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 24))
  run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.r11(), usize.toI32(opKind.elements))
  let done = run emitJcc(&mut em.*, X86Encode.ccAe())
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 8))
  run loadVectorLane(&mut em.*, opKind, X86Encode.rsi(), X86Encode.r11(), X86Encode.r9(), 0)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 16))
  run loadVectorLane(&mut em.*, opKind, X86Encode.rsi(), X86Encode.r11(), X86Encode.rcx(), 1)
  if opKind.isFloat() {
    run emitFloatCompareRegs(&mut em.*, pred, opKind.bits == 64)
  } else {
    run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.r9())
    run emitIntCompareRegs(&mut em.*, pred, opKind.bits)
  }
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rsp(), 0))
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 24))
  run storeVectorLane(&mut em.*, maskKind, X86Encode.rdi(), X86Encode.r11(), X86Encode.rax(), 0)
  run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r11(), 1)
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 24), X86Encode.r11())
  let back = run emitJmp(&mut em.*)
  patchTo(&mut em.*, back, loopHead)
  patchHere(&mut em.*, done)
  return run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rsp(), 32)
}

effect fn emitVectorSelect(em: &mut Emitter, function: &SsaFunction, kind: Kind, cond: u64, yes: u64, no: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let condKind = function.value(cond).kind
  // Native AVX2 fast path for 256-bit integer vector scalar select.
  if hasFeat(&em.*, X86Frame.featAvx2()) && !condKind.isVector() && kind.isInteger() && kind.storeSize() == 32
    && (kind.bits == 8 || kind.bits == 16 || kind.bits == 32 || kind.bits == 64) {
    let rDst = valXmm(&em.*, result)
    let dstOff = valOff(&em.*, result)
    if rDst == X86Frame.regNone() && dstOff == 0 { return () }
    let workDst = dstXmmOrScratch(&em.*, result, 0)
    run loadGp(&mut em.*, function, cond, X86Encode.rax())
    run X86Encode.testRi8(&mut em.code, X86Encode.rax(), 1)
    let pickNo = run emitJcc(&mut em.*, X86Encode.ccE())
    run loadVec256(&mut em.*, function, yes, workDst)
    let doneSel = run emitJmp(&mut em.*)
    patchHere(&mut em.*, pickNo)
    run loadVec256(&mut em.*, function, no, workDst)
    patchHere(&mut em.*, doneSel)
    return run storeVec256(&mut em.*, result, workDst)
  }
  // Native SSE2 / SSE4.1 fast path for 128-bit integer vectors (`v16xi8`, `v8xi16`, `v4xi32`, `v2xi64`).
  if kind.isInteger() && kind.storeSize() == 16 && (kind.bits == 8 || kind.bits == 16 || kind.bits == 32 || kind.bits == 64) {
    let rDst = valXmm(&em.*, result)
    let dstOff = valOff(&em.*, result)
    if rDst == X86Frame.regNone() && dstOff == 0 { return () }
    if !condKind.isVector() {
      let workDst = dstXmmOrScratch(&em.*, result, 0)
      run loadGp(&mut em.*, function, cond, X86Encode.rax())
      run X86Encode.testRi8(&mut em.code, X86Encode.rax(), 1)
      let pickNo = run emitJcc(&mut em.*, X86Encode.ccE())
      run loadVec128(&mut em.*, function, yes, workDst)
      let doneSel = run emitJmp(&mut em.*)
      patchHere(&mut em.*, pickNo)
      run loadVec128(&mut em.*, function, no, workDst)
      patchHere(&mut em.*, doneSel)
      return run storeVec128(&mut em.*, result, workDst)
    }
    if condKind.bits == 1 && condKind.elements == kind.elements {
      if kind.bits == 8 && isXmmMask16(&em.*, cond) {
        let maskXmm = valXmm(&em.*, cond)
        let noIsZero = function.value(no).definition == Definition.Constant && function.constantOf(no).low == 0
        if noIsZero {
          let workDst = if rDst != X86Frame.regNone() && rDst != maskXmm { rDst } else { 0 }
          run loadVec128(&mut em.*, function, yes, workDst)
          run X86Encode.pand(&mut em.code, workDst, maskXmm)
          return run storeVec128(&mut em.*, result, workDst)
        }
        let yesIsZero = function.value(yes).definition == Definition.Constant && function.constantOf(yes).low == 0
        if yesIsZero {
          let rNo = if function.value(no).definition != Definition.Constant { valXmm(&em.*, no) } else { X86Frame.regNone() }
          let workDst = if rDst != X86Frame.regNone() && rDst != rNo { rDst } else { 0 }
          if workDst != maskXmm { run X86Encode.movapsRr(&mut em.code, workDst, maskXmm) }
          let noXmm = run xmmOrLoadVec128(&mut em.*, function, no, 1)
          run X86Encode.pandn(&mut em.code, workDst, noXmm)
          return run storeVec128(&mut em.*, result, workDst)
        }
        if hasFeat(&em.*, X86Frame.featSse41()) {
          run X86Encode.movapsRr(&mut em.code, 0, maskXmm)
          let rYes = if function.value(yes).definition != Definition.Constant { valXmm(&em.*, yes) } else { X86Frame.regNone() }
          let workDst = if rDst != X86Frame.regNone() && rDst != rYes { rDst } else { 2 }
          run loadVec128(&mut em.*, function, no, workDst)
          let yesXmm = run xmmOrLoadVec128(&mut em.*, function, yes, 1)
          run X86Encode.pblendvb(&mut em.code, workDst, yesXmm)
          return run storeVec128(&mut em.*, result, workDst)
        }
        run loadVec128(&mut em.*, function, yes, 0)
        let noXmm = run xmmOrLoadVec128(&mut em.*, function, no, 1)
        run X86Encode.pand(&mut em.code, 0, maskXmm)
        run X86Encode.movapsRr(&mut em.code, 2, maskXmm)
        run X86Encode.pandn(&mut em.code, 2, noXmm)
        run X86Encode.por(&mut em.code, 0, 2)
        return run storeVec128(&mut em.*, result, 0)
      }
      let laneBytes = kind.bits / 8
      // Expand packed bitmask (`N = 16, 8, 4, 2`) into 16-byte lane mask in `xmm2`.
      run loadMaskBits64(&mut em.*, function, cond, X86Encode.rax())
      run X86Encode.movdToXmm(&mut em.code, 2, X86Encode.rax())
      run X86Encode.punpcklbw(&mut em.code, 2, 2)
      run X86Encode.punpcklwd(&mut em.code, 2, 2)
      run X86Encode.pshufd(&mut em.code, 2, 2, if laneBytes == 1 { 0x50 } else { 0x00 })
      let mut bitMask = run Bytes.zeroed(16)
      let bmBuf = Bytes.asMutSlice(&mut bitMask)
      let mut k = usize.ZERO
      while k < 16 {
        let bitIdx = if laneBytes == 1 { k % 8 } else { k / laneBytes }
        bmBuf[k] = u8.shiftLeft(1, usize.toU8(bitIdx))
        k = k + usize.ONE
      }
      let roOff = run addRodata16(&mut em.*, Bytes.asSlice(&bitMask))
      let dispAt = run X86Encode.movdquRm(&mut em.code, 3, Mem.ripRel(0))
      run addRodataReloc(&mut em.*, dispAt, roOff)
      run X86Encode.pand(&mut em.code, 2, 3)
      run X86Encode.pcmpeq(&mut em.code, 1, 2, 3)
      // Blend: `result = (yes & mask) | ((~mask) & no)`.
      run loadVec128(&mut em.*, function, yes, 0)
      run loadVec128(&mut em.*, function, no, 1)
      run X86Encode.pand(&mut em.code, 0, 2)
      run X86Encode.pandn(&mut em.code, 2, 1)
      run X86Encode.por(&mut em.code, 0, 2)
      return run storeVec128(&mut em.*, result, 0)
    }
  }
  let dstOff = valOff(&em.*, result)
  if dstOff == 0 { return () }
  run zeroMaskSlot(&mut em.*, kind, dstOff)
  run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rsp(), 48)
  drop run X86Encode.lea64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), dstOff))
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 0), X86Encode.rax())
  run vectorAddr(&mut em.*, function, yes, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 8), X86Encode.rax())
  run vectorAddr(&mut em.*, function, no, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 16), X86Encode.rax())
  if condKind.isVector() {
    run vectorAddr(&mut em.*, function, cond, X86Encode.rax())
  } else {
    run loadGp(&mut em.*, function, cond, X86Encode.rax())
  }
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 24), X86Encode.rax())
  drop run X86Encode.movMi64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 32), 0)

  let loopHead = Bytes.length(&em.code)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 32))
  run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.r11(), usize.toI32(kind.elements))
  let done = run emitJcc(&mut em.*, X86Encode.ccAe())
  if condKind.isVector() {
    drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 24))
    run loadVectorLane(&mut em.*, condKind, X86Encode.rsi(), X86Encode.r11(), X86Encode.rax(), 0)
  } else {
    drop run X86Encode.movRm64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rsp(), 24))
  }
  run X86Encode.testRi8(&mut em.code, X86Encode.rax(), 1)
  let pickNo = run emitJcc(&mut em.*, X86Encode.ccE())
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 8))
  let gotSrc = run emitJmp(&mut em.*)
  patchHere(&mut em.*, pickNo)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 16))
  patchHere(&mut em.*, gotSrc)
  run loadVectorLane(&mut em.*, kind, X86Encode.rsi(), X86Encode.r11(), X86Encode.rax(), 0)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rsp(), 0))
  run storeVectorLane(&mut em.*, kind, X86Encode.rdi(), X86Encode.r11(), X86Encode.rax(), 0)
  run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r11(), 1)
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 32), X86Encode.r11())
  let back = run emitJmp(&mut em.*)
  patchTo(&mut em.*, back, loopHead)
  patchHere(&mut em.*, done)
  return run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rsp(), 48)
}

effect fn emitVectorCast(em: &mut Emitter, function: &SsaFunction, op: Cast, srcKind: Kind, dstKind: Kind, src: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let dstOff = valOff(&em.*, result)
  if dstOff == 0 { return () }
  run zeroMaskSlot(&mut em.*, dstKind, dstOff)
  run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rsp(), 32)
  drop run X86Encode.lea64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), dstOff))
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 0), X86Encode.rax())
  run vectorAddr(&mut em.*, function, src, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 8), X86Encode.rax())
  drop run X86Encode.movMi64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 16), 0)

  let loopHead = Bytes.length(&em.code)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 16))
  run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.r11(), usize.toI32(dstKind.elements))
  let done = run emitJcc(&mut em.*, X86Encode.ccAe())
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 8))
  run loadVectorLane(&mut em.*, srcKind, X86Encode.rsi(), X86Encode.r11(), X86Encode.rax(), 0)
  match op {
    Cast.Trunc => { run normalizeInt(&mut em.*, X86Encode.rax(), dstKind.bits, false) }
    Cast.ZExt => { run normalizeInt(&mut em.*, X86Encode.rax(), srcKind.bits, false) }
    Cast.SExt => {
      run normalizeInt(&mut em.*, X86Encode.rax(), srcKind.bits, true)
      run normalizeInt(&mut em.*, X86Encode.rax(), dstKind.bits, false)
    }
    Cast.FPTrunc => { run X86Encode.cvtsd2ss(&mut em.code, 0, 0) }
    Cast.FPExt => { run X86Encode.cvtss2sd(&mut em.code, 0, 0) }
    Cast.SIToFP => {
      run normalizeInt(&mut em.*, X86Encode.rax(), srcKind.bits, true)
      run X86Encode.cvtsi2Float(&mut em.code, dstKind.bits == 64, true, 0, X86Encode.rax())
    }
    Cast.UIToFP => {
      run normalizeInt(&mut em.*, X86Encode.rax(), srcKind.bits, false)
      run emitU64ToF64(&mut em.*, X86Encode.rax(), 0)
      if dstKind.bits == 32 { run X86Encode.cvtsd2ss(&mut em.code, 0, 0) }
    }
    Cast.FPToSI => {
      if srcKind.bits == 32 { run X86Encode.cvtss2sd(&mut em.code, 0, 0) }
      run X86Encode.cvttFloat2Si(&mut em.code, true, true, X86Encode.rax(), 0)
      run normalizeInt(&mut em.*, X86Encode.rax(), dstKind.bits, false)
    }
    Cast.FPToUI => {
      if srcKind.bits == 32 { run X86Encode.cvtss2sd(&mut em.code, 0, 0) }
      run X86Encode.cvttFloat2Si(&mut em.code, true, true, X86Encode.rax(), 0)
      run normalizeInt(&mut em.*, X86Encode.rax(), dstKind.bits, false)
    }
    _ => {}
  }
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rsp(), 0))
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 16))
  run storeVectorLane(&mut em.*, dstKind, X86Encode.rdi(), X86Encode.r11(), X86Encode.rax(), 0)
  run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r11(), 1)
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 16), X86Encode.r11())
  let back = run emitJmp(&mut em.*)
  patchTo(&mut em.*, back, loopHead)
  patchHere(&mut em.*, done)
  return run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rsp(), 32)
}

effect fn emitVectorOverflow(em: &mut Emitter, function: &SsaFunction, op: Binary, signed: bool, kind: Kind, left: u64, right: u64, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let dstOff = valOff(&em.*, result)
  let ovfOff = valOff(&em.*, result + 1)
  let maskKind = kind.flags()
  run zeroMaskSlot(&mut em.*, maskKind, ovfOff)
  run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rsp(), 48)
  drop run X86Encode.lea64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), dstOff))
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 0), X86Encode.rax())
  drop run X86Encode.lea64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), ovfOff))
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 8), X86Encode.rax())
  run vectorAddr(&mut em.*, function, left, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 16), X86Encode.rax())
  run vectorAddr(&mut em.*, function, right, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 24), X86Encode.rax())
  drop run X86Encode.movMi64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 32), 0)

  let loopHead = Bytes.length(&em.code)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 32))
  run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.r11(), usize.toI32(kind.elements))
  let done = run emitJcc(&mut em.*, X86Encode.ccAe())
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 16))
  run loadVectorLane(&mut em.*, kind, X86Encode.rsi(), X86Encode.r11(), X86Encode.r9(), 0)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 24))
  run loadVectorLane(&mut em.*, kind, X86Encode.rsi(), X86Encode.r11(), X86Encode.rcx(), 0)
  run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.r9())
  run emitScalarOverflowRegs(&mut em.*, op, signed, kind.bits)
  run X86Encode.movRr64(&mut em.code, X86Encode.r9(), X86Encode.rdx())
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rsp(), 0))
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 32))
  if dstOff != 0 { run storeVectorLane(&mut em.*, kind, X86Encode.rdi(), X86Encode.r11(), X86Encode.rax(), 0) }
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rsp(), 8))
  if ovfOff != 0 { run storeVectorLane(&mut em.*, maskKind, X86Encode.rdi(), X86Encode.r11(), X86Encode.r9(), 0) }
  run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r11(), 1)
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 32), X86Encode.r11())
  let back = run emitJmp(&mut em.*)
  patchTo(&mut em.*, back, loopHead)
  patchHere(&mut em.*, done)
  return run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rsp(), 48)
}

effect fn emitVectorSaturate(em: &mut Emitter, function: &SsaFunction, op: Binary, signed: bool, kind: Kind, left: u64, right: u64, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let dstOff = valOff(&em.*, result)
  if dstOff == 0 { return () }
  run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rsp(), 32)
  drop run X86Encode.lea64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), dstOff))
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 0), X86Encode.rax())
  run vectorAddr(&mut em.*, function, left, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 8), X86Encode.rax())
  run vectorAddr(&mut em.*, function, right, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 16), X86Encode.rax())
  drop run X86Encode.movMi64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 24), 0)

  let loopHead = Bytes.length(&em.code)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 24))
  run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.r11(), usize.toI32(kind.elements))
  let done = run emitJcc(&mut em.*, X86Encode.ccAe())
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 8))
  run loadVectorLane(&mut em.*, kind, X86Encode.rsi(), X86Encode.r11(), X86Encode.r9(), 0)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 16))
  run loadVectorLane(&mut em.*, kind, X86Encode.rsi(), X86Encode.r11(), X86Encode.rcx(), 0)
  run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.r9())
  run emitScalarSaturateRegs(&mut em.*, op, signed, kind.bits)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rsp(), 0))
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 24))
  run storeVectorLane(&mut em.*, kind, X86Encode.rdi(), X86Encode.r11(), X86Encode.rax(), 0)
  run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r11(), 1)
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 24), X86Encode.r11())
  let back = run emitJmp(&mut em.*)
  patchTo(&mut em.*, back, loopHead)
  patchHere(&mut em.*, done)
  return run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rsp(), 32)
}

effect fn emitVectorRotate(em: &mut Emitter, function: &SsaFunction, left: bool, kind: Kind, val: u64, amt: u64, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let sz = kind.storeSize()
  if sz == 16 && kind.isInteger() && (kind.bits == 8 || kind.bits == 16 || kind.bits == 32 || kind.bits == 64) {
    return run emitVector128Rotate(&mut em.*, function, left, kind, val, amt, result)
  }
  // Native AVX2 / SSE2 fast path for 256-bit integer vector constant rotates (`i16`, `i32`, `i64`).
  if kind.isInteger() && sz == 32 && (kind.bits == 16 || kind.bits == 32 || kind.bits == 64) {
    let rawAmt = X86Frame.uniformVecConst(function, amt)
    if rawAmt < 64 {
      let width = usize.toU64(kind.bits)
      let k = rawAmt & (width - 1)
      let laneBytes = kind.bits / 8
      if hasFeat(&em.*, X86Frame.featAvx2()) {
        let rDst = valXmm(&em.*, result)
        let dstOff = valOff(&em.*, result)
        if rDst == X86Frame.regNone() && dstOff == 0 { return () }
        let workDst = dstXmmOrScratch(&em.*, result, 0)
        let srcYmm = run ymmOrLoadVec256(&mut em.*, function, val, 0)
        if k == 0 {
          if workDst != srcYmm { run X86Encode.vmovdqaYmmRr(&mut em.code, workDst, srcYmm) }
          return run storeVec256(&mut em.*, result, workDst)
        }
        let shlAmt = u64.wrappingToU8(if left { k } else { width - k })
        if kind.bits == 32 && (shlAmt == 8 || shlAmt == 16 || shlAmt == 24) {
          let mut shuf = run Bytes.zeroed(32)
          let sBuf = Bytes.asMutSlice(&mut shuf)
          let byteRot = u8.toUsize(shlAmt) / 8
          let mut half = usize.ZERO
          while half < 2 {
            let mut w = usize.ZERO
            while w < 4 {
              let mut b = usize.ZERO
              while b < 4 {
                let srcB = (b + 4 - byteRot) % 4
                sBuf[half * 16 + w * 4 + b] = usize.toU8(w * 4 + srcB)
                b = b + usize.ONE
              }
              w = w + usize.ONE
            }
            half = half + usize.ONE
          }
          let roOff = run addRodata32(&mut em.*, Bytes.asSlice(&shuf))
          let dispAt = run X86Encode.vmovdquYmmRm(&mut em.code, 1, Mem.ripRel(0))
          run addRodataReloc(&mut em.*, dispAt, roOff)
          run X86Encode.vpshufbYmm(&mut em.code, workDst, srcYmm, 1)
          return run storeVec256(&mut em.*, result, workDst)
        }
        let shrAmt = u64.wrappingToU8(width - u8.toU64(shlAmt))
        run X86Encode.vpsrlImmYmm(&mut em.code, laneBytes, 1, srcYmm, shrAmt)
        run X86Encode.vpsllImmYmm(&mut em.code, laneBytes, workDst, srcYmm, shlAmt)
        run X86Encode.vporYmm(&mut em.code, workDst, workDst, 1)
        return run storeVec256(&mut em.*, result, workDst)
      }
      let dstOff = valOff(&em.*, result)
      if dstOff == 0 { return () }
      run vectorAddr(&mut em.*, function, val, X86Encode.r10())
      let mut half: i32 = 0
      while half < 32 {
        drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(X86Encode.r10(), half))
        if k != 0 {
          let shlAmt = u64.wrappingToU8(if left { k } else { width - k })
          let shrAmt = u64.wrappingToU8(width - u8.toU64(shlAmt))
          run X86Encode.movapsRr(&mut em.code, 1, 0)
          run X86Encode.psllImm(&mut em.code, laneBytes, 0, shlAmt)
          run X86Encode.psrlImm(&mut em.code, laneBytes, 1, shrAmt)
          run X86Encode.por(&mut em.code, 0, 1)
        }
        drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff + half), 0)
        half = half + 16
      }
      return ()
    }
  }
  let dstOff = valOff(&em.*, result)
  if dstOff == 0 { return () }
  run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rsp(), 32)
  drop run X86Encode.lea64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), dstOff))
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 0), X86Encode.rax())
  run vectorAddr(&mut em.*, function, val, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 8), X86Encode.rax())
  run vectorAddr(&mut em.*, function, amt, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 16), X86Encode.rax())
  drop run X86Encode.movMi64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 24), 0)

  let loopHead = Bytes.length(&em.code)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 24))
  run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.r11(), usize.toI32(kind.elements))
  let done = run emitJcc(&mut em.*, X86Encode.ccAe())
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 8))
  run loadVectorLane(&mut em.*, kind, X86Encode.rsi(), X86Encode.r11(), X86Encode.r9(), 0)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 16))
  run loadVectorLane(&mut em.*, kind, X86Encode.rsi(), X86Encode.r11(), X86Encode.rcx(), 0)
  run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.r9())
  run emitScalarRotateRegs(&mut em.*, left, kind.bits)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rsp(), 0))
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 24))
  run storeVectorLane(&mut em.*, kind, X86Encode.rdi(), X86Encode.r11(), X86Encode.rax(), 0)
  run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r11(), 1)
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 24), X86Encode.r11())
  let back = run emitJmp(&mut em.*)
  patchTo(&mut em.*, back, loopHead)
  patchHere(&mut em.*, done)
  return run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rsp(), 32)
}

effect fn emitVectorCount(em: &mut Emitter, function: &SsaFunction, which: Count, kind: Kind, src: u64, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let dstOff = valOff(&em.*, result)
  if dstOff == 0 { return () }
  run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rsp(), 32)
  drop run X86Encode.lea64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), dstOff))
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 0), X86Encode.rax())
  run vectorAddr(&mut em.*, function, src, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 8), X86Encode.rax())
  drop run X86Encode.movMi64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 16), 0)

  let loopHead = Bytes.length(&em.code)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 16))
  run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.r11(), usize.toI32(kind.elements))
  let done = run emitJcc(&mut em.*, X86Encode.ccAe())
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 8))
  run loadVectorLane(&mut em.*, kind, X86Encode.rsi(), X86Encode.r11(), X86Encode.rax(), 0)
  run normalizeInt(&mut em.*, X86Encode.rax(), kind.bits, false)
  match which {
    Count.Ones => { run emitPopcount64(&mut em.*) }
    Count.LeadingZeros => { run emitClz64(&mut em.*, kind.bits) }
    Count.TrailingZeros => { run emitCtz64(&mut em.*, kind.bits) }
  }
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rsp(), 0))
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 16))
  run storeVectorLane(&mut em.*, kind, X86Encode.rdi(), X86Encode.r11(), X86Encode.rax(), 0)
  run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r11(), 1)
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 16), X86Encode.r11())
  let back = run emitJmp(&mut em.*)
  patchTo(&mut em.*, back, loopHead)
  patchHere(&mut em.*, done)
  return run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rsp(), 32)
}

effect fn emitVectorExtreme(em: &mut Emitter, function: &SsaFunction, which: Extreme, kind: Kind, left: u64, right: u64, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let dstOff = valOff(&em.*, result)
  if dstOff == 0 { return () }
  run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rsp(), 32)
  drop run X86Encode.lea64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), dstOff))
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 0), X86Encode.rax())
  run vectorAddr(&mut em.*, function, left, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 8), X86Encode.rax())
  run vectorAddr(&mut em.*, function, right, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 16), X86Encode.rax())
  drop run X86Encode.movMi64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 24), 0)

  let loopHead = Bytes.length(&em.code)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 24))
  run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.r11(), usize.toI32(kind.elements))
  let done = run emitJcc(&mut em.*, X86Encode.ccAe())
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 8))
  run loadVectorLane(&mut em.*, kind, X86Encode.rsi(), X86Encode.r11(), X86Encode.r9(), 0)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 16))
  run loadVectorLane(&mut em.*, kind, X86Encode.rsi(), X86Encode.r11(), X86Encode.rcx(), 1)
  if kind.isFloat() {
    run emitIeeeFloatExtremeRegs(&mut em.*, which == Extreme.FloatMaximum, kind.bits == 64)
  } else {
    let signed = which == Extreme.SignedMinimum || which == Extreme.SignedMaximum
    let cc = match which {
      Extreme.SignedMinimum => X86Encode.ccG()
      Extreme.SignedMaximum => X86Encode.ccL()
      Extreme.UnsignedMinimum => X86Encode.ccA()
      _ => X86Encode.ccB()
    }
    run X86Encode.movRr64(&mut em.code, X86Encode.rax(), X86Encode.r9())
    run normalizeInt(&mut em.*, X86Encode.rax(), kind.bits, signed)
    run normalizeInt(&mut em.*, X86Encode.rcx(), kind.bits, signed)
    run X86Encode.aluRr64(&mut em.code, Alu.Cmp, X86Encode.rax(), X86Encode.rcx())
    run X86Encode.cmov64(&mut em.code, cc, X86Encode.rax(), X86Encode.rcx())
    run normalizeInt(&mut em.*, X86Encode.rax(), kind.bits, false)
  }
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rsp(), 0))
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 24))
  run storeVectorLane(&mut em.*, kind, X86Encode.rdi(), X86Encode.r11(), X86Encode.rax(), 0)
  run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r11(), 1)
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 24), X86Encode.r11())
  let back = run emitJmp(&mut em.*)
  patchTo(&mut em.*, back, loopHead)
  patchHere(&mut em.*, done)
  return run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rsp(), 32)
}

effect fn emitVectorFma(em: &mut Emitter, function: &SsaFunction, kind: Kind, a: u64, b: u64, c: u64, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let dstOff = valOff(&em.*, result)
  if dstOff == 0 { return () }
  let double = kind.bits == 64
  run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rsp(), 48)
  drop run X86Encode.lea64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), dstOff))
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 0), X86Encode.rax())
  run vectorAddr(&mut em.*, function, a, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 8), X86Encode.rax())
  run vectorAddr(&mut em.*, function, b, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 16), X86Encode.rax())
  run vectorAddr(&mut em.*, function, c, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 24), X86Encode.rax())
  drop run X86Encode.movMi64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 32), 0)

  let loopHead = Bytes.length(&em.code)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 32))
  run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.r11(), usize.toI32(kind.elements))
  let done = run emitJcc(&mut em.*, X86Encode.ccAe())
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 8))
  run loadVectorLane(&mut em.*, kind, X86Encode.rsi(), X86Encode.r11(), X86Encode.rax(), 0)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 16))
  run loadVectorLane(&mut em.*, kind, X86Encode.rsi(), X86Encode.r11(), X86Encode.rax(), 1)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 24))
  run loadVectorLane(&mut em.*, kind, X86Encode.rsi(), X86Encode.r11(), X86Encode.rax(), 2)
  run callExternal(&mut em.*, if double { b"fma" } else { b"fmaf" })
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rsp(), 0))
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 32))
  run storeVectorLane(&mut em.*, kind, X86Encode.rdi(), X86Encode.r11(), X86Encode.rax(), 0)
  run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r11(), 1)
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 32), X86Encode.r11())
  let back = run emitJmp(&mut em.*)
  patchTo(&mut em.*, back, loopHead)
  patchHere(&mut em.*, done)
  return run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rsp(), 48)
}

effect fn emitSplat(em: &mut Emitter, function: &SsaFunction, kind: Kind, scalar: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let sz = kind.storeSize()
  if kind.isInteger() && (sz == 16 || sz == 32) && (kind.bits == 8 || kind.bits == 16 || kind.bits == 32 || kind.bits == 64) {
    if sz == 32 && hasFeat(&em.*, X86Frame.featAvx2()) {
      let rDst = valXmm(&em.*, result)
      let dstOff = valOff(&em.*, result)
      if rDst == X86Frame.regNone() && dstOff == 0 { return () }
      let workDst = dstXmmOrScratch(&em.*, result, 0)
      if function.isBits(scalar) && function.constantOf(scalar).low == 0 {
        run X86Encode.vpxorYmm(&mut em.code, workDst, workDst, workDst)
      } else {
        let srcReg = run regOrLoad(&mut em.*, function, scalar, X86Encode.rax())
        if kind.bits == 64 {
          run X86Encode.vmovqXmmGp(&mut em.code, 0, srcReg)
        } else {
          run X86Encode.vmovdXmmGp(&mut em.code, 0, srcReg)
        }
        run X86Encode.vpbroadcastYmm(&mut em.code, kind.bits / 8, workDst, 0)
      }
      return run storeVec256(&mut em.*, result, workDst)
    }
    let rDst = if sz == 16 { valXmm(&em.*, result) } else { X86Frame.regNone() }
    let dstOff = valOff(&em.*, result)
    if rDst == X86Frame.regNone() && dstOff == 0 { return () }
    let workDst = if rDst != X86Frame.regNone() { rDst } else { 0 }
    if function.isBits(scalar) && function.constantOf(scalar).low == 0 {
      run X86Encode.pxor(&mut em.code, workDst, workDst)
    } else if sz == 16 && function.isBits(scalar) {
      let img = run buildVectorConstantBytes(kind, function.constantOf(scalar).low)
      let roOff = run addRodata16(&mut em.*, Bytes.asSlice(&img))
      let dispAt = run X86Encode.movdquRm(&mut em.code, workDst, Mem.ripRel(0))
      run addRodataReloc(&mut em.*, dispAt, roOff)
    } else {
      let srcReg = run regOrLoad(&mut em.*, function, scalar, X86Encode.rax())
      if kind.bits == 64 {
        run X86Encode.movqToXmm(&mut em.code, workDst, srcReg)
        run X86Encode.punpcklqdq(&mut em.code, workDst, workDst)
      } else if kind.bits == 32 {
        run X86Encode.movdToXmm(&mut em.code, workDst, srcReg)
        run X86Encode.pshufd(&mut em.code, workDst, workDst, 0)
      } else if kind.bits == 16 {
        run X86Encode.movdToXmm(&mut em.code, workDst, srcReg)
        run X86Encode.punpcklwd(&mut em.code, workDst, workDst)
        run X86Encode.pshufd(&mut em.code, workDst, workDst, 0)
      } else {
        run X86Encode.movdToXmm(&mut em.code, workDst, srcReg)
        run X86Encode.punpcklbw(&mut em.code, workDst, workDst)
        run X86Encode.punpcklwd(&mut em.code, workDst, workDst)
        run X86Encode.pshufd(&mut em.code, workDst, workDst, 0)
      }
    }
    if sz == 16 {
      return run storeVec128(&mut em.*, result, workDst)
    }
    drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff), workDst)
    drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff + 16), workDst)
    return ()
  }
  let dstOff = valOff(&em.*, result)
  if dstOff == 0 { return () }
  run zeroMaskSlot(&mut em.*, kind, dstOff)
  if kind.isFloat() {
    run loadFloat(&mut em.*, function, scalar, 0, X86Encode.rax())
  } else {
    run loadGp(&mut em.*, function, scalar, X86Encode.rax())
  }
  drop run X86Encode.lea64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rbp(), dstOff))
  run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.r11(), X86Encode.r11())
  let loopHead = Bytes.length(&em.code)
  run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.r11(), usize.toI32(kind.elements))
  let done = run emitJcc(&mut em.*, X86Encode.ccAe())
  run storeVectorLane(&mut em.*, kind, X86Encode.rdi(), X86Encode.r11(), X86Encode.rax(), 0)
  run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r11(), 1)
  let back = run emitJmp(&mut em.*)
  patchTo(&mut em.*, back, loopHead)
  patchHere(&mut em.*, done)
  return ()
}

effect fn emitExtract(em: &mut Emitter, function: &SsaFunction, kind: Kind, vecVal: u64, idxVal: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let vecKind = function.value(vecVal).kind
  run loadGp(&mut em.*, function, idxVal, X86Encode.r11())
  run normalizeInt(&mut em.*, X86Encode.r11(), function.value(idxVal).kind.bits, false)
  // Out-of-range index returns zero per `SsaFunction` spec.
  run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.r11(), usize.toI32(vecKind.elements))
  let oob = run emitJcc(&mut em.*, X86Encode.ccAe())
  run vectorAddr(&mut em.*, function, vecVal, X86Encode.rsi())
  run loadVectorLane(&mut em.*, vecKind, X86Encode.rsi(), X86Encode.r11(), X86Encode.rax(), 0)
  let done = run emitJmp(&mut em.*)
  patchHere(&mut em.*, oob)
  if kind.isFloat() { run X86Encode.pxor(&mut em.code, 0, 0) }
  else { run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rax()) }
  patchHere(&mut em.*, done)
  if kind.isFloat() { return run storeFloat(&mut em.*, result, 0, kind.bits == 64) }
  return run storeGp(&mut em.*, result, X86Encode.rax())
}

effect fn emitInsert(em: &mut Emitter, function: &SsaFunction, kind: Kind, vecVal: u64, elemVal: u64, idxVal: u64, result: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let dstOff = valOff(&em.*, result)
  if dstOff == 0 { return () }
  // Copy `vecVal` into `result`'s slot first.
  let sz = kind.storeSize()
  if sz == 1 || sz == 2 || sz == 4 || sz == 8 {
    run loadSmallVecGp(&mut em.*, function, vecVal, X86Encode.rax())
    run storeSmallVecMem(&mut em.*, sz, Mem.baseDisp(X86Encode.rbp(), dstOff), X86Encode.rax())
  } else if sz == 16 {
    run loadVec128(&mut em.*, function, vecVal, 0)
    drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff), 0)
  } else if sz == 32 {
    run vectorAddr(&mut em.*, function, vecVal, X86Encode.r10())
    drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(X86Encode.r10(), 0))
    drop run X86Encode.movdquRm(&mut em.code, 1, Mem.baseDisp(X86Encode.r10(), 16))
    drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff), 0)
    drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff + 16), 1)
  } else if sz > usize.ZERO {
    run vectorAddr(&mut em.*, function, vecVal, X86Encode.rsi())
    drop run X86Encode.lea64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rbp(), dstOff))
    run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), usize.toU64(sz))
    run X86Encode.repMovsb(&mut em.code)
  }
  // Replace lane `idxVal` if in bounds.
  run loadGp(&mut em.*, function, idxVal, X86Encode.r11())
  run normalizeInt(&mut em.*, X86Encode.r11(), function.value(idxVal).kind.bits, false)
  run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.r11(), usize.toI32(kind.elements))
  let oob = run emitJcc(&mut em.*, X86Encode.ccAe())
  if kind.isFloat() { run loadFloat(&mut em.*, function, elemVal, 0, X86Encode.rax()) }
  else { run loadGp(&mut em.*, function, elemVal, X86Encode.rax()) }
  drop run X86Encode.lea64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rbp(), dstOff))
  run storeVectorLane(&mut em.*, kind, X86Encode.rdi(), X86Encode.r11(), X86Encode.rax(), 0)
  patchHere(&mut em.*, oob)
  return ()
}

effect fn emitShuffle(em: &mut Emitter, function: &SsaFunction, kind: Kind, first: u64, second: u64, start: usize, count: usize, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let srcKind = function.value(first).kind
  let mask = function.immediatesAt(start, count)
  // Native single-instruction SSE2 `pshufd` for 4x32-bit single-source shuffles.
  if kind.isVector() && kind.storeSize() == 16 && srcKind.isVector() && srcKind.storeSize() == 16
    && kind.bits == 32 && srcKind.bits == 32 && count == 4
    && mask[0] < 4 && mask[1] < 4 && mask[2] < 4 && mask[3] < 4 {
    let rDst = valXmm(&em.*, result)
    let dstOff = valOff(&em.*, result)
    if rDst == X86Frame.regNone() && dstOff == 0 { return () }
    let imm: u8 = u64.wrappingToU8(mask[0] | u64.shiftLeft(mask[1], 2) | u64.shiftLeft(mask[2], 4) | u64.shiftLeft(mask[3], 6))
    let srcXmm = run xmmOrLoadVec128(&mut em.*, function, first, 0)
    let workDst = dstXmmOrScratch(&em.*, result, 0)
    run X86Encode.pshufd(&mut em.code, workDst, srcXmm, imm)
    return run storeVec128(&mut em.*, result, workDst)
  }
  // Native SSE2 `pshufd` / `punpcklqdq` / `punpckhqdq` / `shufpd` for 2x64-bit (`u64x2`) shuffles.
  if kind.isVector() && kind.storeSize() == 16 && srcKind.isVector() && srcKind.storeSize() == 16
    && kind.bits == 64 && srcKind.bits == 64 && count == 2 {
    let rDst = valXmm(&em.*, result)
    let dstOff = valOff(&em.*, result)
    if rDst == X86Frame.regNone() && dstOff == 0 { return () }
    let m0 = mask[0]
    let m1 = mask[1]
    if m0 < 2 && m1 < 2 {
      let workDst = dstXmmOrScratch(&em.*, result, 0)
      if m0 == 0 && m1 == 1 {
        run loadVec128(&mut em.*, function, first, workDst)
      } else {
        let srcXmm = run xmmOrLoadVec128(&mut em.*, function, first, 0)
        let d0: u8 = if m0 == 0 { 0x04 } else { 0x0E }
        let d1: u8 = if m1 == 0 { 0x04 } else { 0x0E }
        run X86Encode.pshufd(&mut em.code, workDst, srcXmm, u8.bitOr(d0, u8.shiftLeft(d1, 4)))
      }
      return run storeVec128(&mut em.*, result, workDst)
    }
    if m0 >= 2 && m0 < 4 && m1 >= 2 && m1 < 4 {
      let workDst = dstXmmOrScratch(&em.*, result, 0)
      if m0 == 2 && m1 == 3 {
        run loadVec128(&mut em.*, function, second, workDst)
      } else {
        let srcXmm = run xmmOrLoadVec128(&mut em.*, function, second, 0)
        let d0: u8 = if m0 == 2 { 0x04 } else { 0x0E }
        let d1: u8 = if m1 == 2 { 0x04 } else { 0x0E }
        run X86Encode.pshufd(&mut em.code, workDst, srcXmm, u8.bitOr(d0, u8.shiftLeft(d1, 4)))
      }
      return run storeVec128(&mut em.*, result, workDst)
    }
    if m0 < 2 && m1 >= 2 && m1 < 4 {
      let rSec = if function.value(second).definition != Definition.Constant { valXmm(&em.*, second) } else { X86Frame.regNone() }
      let workDst = if rDst != X86Frame.regNone() && rDst != rSec { rDst } else { 0 }
      run loadVec128(&mut em.*, function, first, workDst)
      let secXmm = run xmmOrLoadVec128(&mut em.*, function, second, 1)
      if m0 == 0 && m1 == 2 {
        run X86Encode.punpcklqdq(&mut em.code, workDst, secXmm)
      } else if m0 == 1 && m1 == 3 {
        run X86Encode.punpckhqdq(&mut em.code, workDst, secXmm)
      } else {
        let imm = u64.wrappingToU8(m0 | u64.shiftLeft(m1 - 2, 1))
        run X86Encode.shufpd(&mut em.code, workDst, secXmm, imm)
      }
      return run storeVec128(&mut em.*, result, workDst)
    }
    if m0 >= 2 && m0 < 4 && m1 < 2 {
      let rFirst = if function.value(first).definition != Definition.Constant { valXmm(&em.*, first) } else { X86Frame.regNone() }
      let workDst = if rDst != X86Frame.regNone() && rDst != rFirst { rDst } else { 0 }
      run loadVec128(&mut em.*, function, second, workDst)
      let firstXmm = run xmmOrLoadVec128(&mut em.*, function, first, 1)
      if m0 == 2 && m1 == 0 {
        run X86Encode.punpcklqdq(&mut em.code, workDst, firstXmm)
      } else if m0 == 3 && m1 == 1 {
        run X86Encode.punpckhqdq(&mut em.code, workDst, firstXmm)
      } else {
        let imm = u64.wrappingToU8((m0 - 2) | u64.shiftLeft(m1, 1))
        run X86Encode.shufpd(&mut em.code, workDst, firstXmm, imm)
      }
      return run storeVec128(&mut em.*, result, workDst)
    }
    // One or both lanes out of range (zero-filled).
    run X86Encode.pxor(&mut em.code, 2, 2)
    let loXmm: u8 = if m0 < 2 {
      run loadVec128(&mut em.*, function, first, 0)
      0
    } else if m0 < 4 {
      run loadVec128(&mut em.*, function, second, 0)
      0
    } else {
      run X86Encode.pxor(&mut em.code, 0, 0)
      0
    }
    let hiXmm: u8 = if m1 < 2 {
      run xmmOrLoadVec128(&mut em.*, function, first, 1)
    } else if m1 < 4 {
      run xmmOrLoadVec128(&mut em.*, function, second, 1)
    } else {
      2
    }
    let b0: u8 = if m0 < 4 { u64.wrappingToU8(m0 & 1) } else { 0 }
    let b1: u8 = if m1 < 4 { u64.wrappingToU8(m1 & 1) } else { 0 }
    run X86Encode.shufpd(&mut em.code, loXmm, hiXmm, u8.bitOr(b0, u8.shiftLeft(b1, 1)))
    return run storeVec128(&mut em.*, result, loXmm)
  }
  // Native SSE2 / SSSE3 / zero-STLF byte shuffle for 16-byte `v16xi8` vectors.
  if kind.isVector() && kind.storeSize() == 16 && srcKind.isVector() && srcKind.storeSize() == 16
    && kind.bits == 8 && srcKind.bits == 8 && count == 16 {
    let rDst = valXmm(&em.*, result)
    let dstOff = valOff(&em.*, result)
    if rDst == X86Frame.regNone() && dstOff == 0 { return () }
    // Subcase 1: Sliding byte-concat `mask[k] == shiftR + k` (`1 <= shiftR <= 15`) -> 3 SSE2 insns.
    let m0 = mask[0]
    if m0 >= 1 && m0 <= 15 {
      let mut isSlide = true
      let mut k = usize.ONE
      while k < 16 {
        if mask[k] != m0 + usize.toU64(k) {
          isSlide = false
          break
        }
        k = k + usize.ONE
      }
      if isSlide {
        let shiftR = u64.wrappingToU8(m0)
        let shiftL: u8 = 16 - shiftR
        let rSec = if function.value(second).definition != Definition.Constant { valXmm(&em.*, second) } else { X86Frame.regNone() }
        let workDst = if rDst != X86Frame.regNone() && rDst != rSec { rDst } else { 0 }
        run loadVec128(&mut em.*, function, first, workDst)
        run loadVec128(&mut em.*, function, second, 1)
        run X86Encode.psrldq(&mut em.code, workDst, shiftR)
        run X86Encode.pslldq(&mut em.code, 1, shiftL)
        run X86Encode.por(&mut em.code, workDst, 1)
        return run storeVec128(&mut em.*, result, workDst)
      }
    }
    let mut usesFirst = false
    let mut usesSecond = false
    let mut chk = usize.ZERO
    while chk < 16 {
      let pk = mask[chk]
      if pk < 16 { usesFirst = true }
      else if pk < 32 { usesSecond = true }
      chk = chk + usize.ONE
    }
    // Subcase 2: SSSE3 `pshufb` (1-src = 2 insns, 2-src = 5 insns, zero stack traffic).
    if hasFeat(&em.*, X86Frame.featSsse3()) {
      if !usesSecond {
        let mut ctrl = run Bytes.zeroed(16)
        let cBuf = Bytes.asMutSlice(&mut ctrl)
        let mut k = usize.ZERO
        while k < 16 {
          cBuf[k] = if mask[k] < 16 { u64.wrappingToU8(mask[k]) } else { 0x80 }
          k = k + usize.ONE
        }
        let roOff = run addRodata16(&mut em.*, Bytes.asSlice(&ctrl))
        let workDst = dstXmmOrScratch(&em.*, result, 0)
        run loadVec128(&mut em.*, function, first, workDst)
        let dispAt = run X86Encode.movdquRm(&mut em.code, 1, Mem.ripRel(0))
        run addRodataReloc(&mut em.*, dispAt, roOff)
        run X86Encode.pshufb(&mut em.code, workDst, 1)
        return run storeVec128(&mut em.*, result, workDst)
      }
      if !usesFirst {
        let mut ctrl = run Bytes.zeroed(16)
        let cBuf = Bytes.asMutSlice(&mut ctrl)
        let mut k = usize.ZERO
        while k < 16 {
          cBuf[k] = if mask[k] >= 16 && mask[k] < 32 { u64.wrappingToU8(mask[k] - 16) } else { 0x80 }
          k = k + usize.ONE
        }
        let roOff = run addRodata16(&mut em.*, Bytes.asSlice(&ctrl))
        let workDst = dstXmmOrScratch(&em.*, result, 0)
        run loadVec128(&mut em.*, function, second, workDst)
        let dispAt = run X86Encode.movdquRm(&mut em.code, 1, Mem.ripRel(0))
        run addRodataReloc(&mut em.*, dispAt, roOff)
        run X86Encode.pshufb(&mut em.code, workDst, 1)
        return run storeVec128(&mut em.*, result, workDst)
      }
      let mut ctrl1 = run Bytes.zeroed(16)
      let mut ctrl2 = run Bytes.zeroed(16)
      let c1 = Bytes.asMutSlice(&mut ctrl1)
      let c2 = Bytes.asMutSlice(&mut ctrl2)
      let mut k = usize.ZERO
      while k < 16 {
        if mask[k] < 16 {
          c1[k] = u64.wrappingToU8(mask[k])
          c2[k] = 0x80
        } else if mask[k] < 32 {
          c1[k] = 0x80
          c2[k] = u64.wrappingToU8(mask[k] - 16)
        } else {
          c1[k] = 0x80
          c2[k] = 0x80
        }
        k = k + usize.ONE
      }
      let ro1 = run addRodata16(&mut em.*, Bytes.asSlice(&ctrl1))
      let ro2 = run addRodata16(&mut em.*, Bytes.asSlice(&ctrl2))
      run loadVec128(&mut em.*, function, first, 0)
      let disp1 = run X86Encode.movdquRm(&mut em.code, 2, Mem.ripRel(0))
      run addRodataReloc(&mut em.*, disp1, ro1)
      run X86Encode.pshufb(&mut em.code, 0, 2)
      run loadVec128(&mut em.*, function, second, 1)
      let disp2 = run X86Encode.movdquRm(&mut em.code, 2, Mem.ripRel(0))
      run addRodataReloc(&mut em.*, disp2, ro2)
      run X86Encode.pshufb(&mut em.code, 1, 2)
      run X86Encode.por(&mut em.code, 0, 1)
      return run storeVec128(&mut em.*, result, 0)
    }
    // Subcase 3: Baseline SSE2 general `v16xi8` shuffle via `pinsrw` (eliminates narrow-to-wide STLF stall).
    let stackBytes: i32 = if usesSecond { 32 } else { 16 }
    run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rsp(), stackBytes)
    let firstXmm = run xmmOrLoadVec128(&mut em.*, function, first, 0)
    drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 0), firstXmm)
    if usesSecond {
      let secXmm = run xmmOrLoadVec128(&mut em.*, function, second, 1)
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 16), secXmm)
    }
    let workDst = dstXmmOrScratch(&em.*, result, 0)
    run X86Encode.pxor(&mut em.code, workDst, workDst)
    let mut pair = usize.ZERO
    while pair < 8 {
      let pk0 = mask[pair * 2]
      let pk1 = mask[pair * 2 + usize.ONE]
      let v0 = pk0 < 32
      let v1 = pk1 < 32
      if v0 || v1 {
        if v0 && v1 && pk1 == pk0 + 1 && (pk0 / 16) == (pk1 / 16) {
          drop run X86Encode.movzxRm16(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rsp(), u64.wrappingToI32(pk0)))
        } else if v0 && v1 {
          drop run X86Encode.movzxRm8(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rsp(), u64.wrappingToI32(pk1)))
          run X86Encode.shiftImm32(&mut em.code, Shift.Shl, X86Encode.rax(), 8)
          drop run X86Encode.movzxRm8(&mut em.code, X86Encode.r10(), Mem.baseDisp(X86Encode.rsp(), u64.wrappingToI32(pk0)))
          run X86Encode.aluRr32(&mut em.code, Alu.Or, X86Encode.rax(), X86Encode.r10())
        } else if v0 {
          drop run X86Encode.movzxRm8(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rsp(), u64.wrappingToI32(pk0)))
        } else {
          drop run X86Encode.movzxRm8(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rsp(), u64.wrappingToI32(pk1)))
          run X86Encode.shiftImm32(&mut em.code, Shift.Shl, X86Encode.rax(), 8)
        }
        run X86Encode.pinsrw(&mut em.code, workDst, X86Encode.rax(), usize.toU8(pair))
      }
      pair = pair + usize.ONE
    }
    run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rsp(), stackBytes)
    return run storeVec128(&mut em.*, result, workDst)
  }
  let dstOff = valOff(&em.*, result)
  if dstOff == 0 { return () }
  run zeroMaskSlot(&mut em.*, kind, dstOff)
  let srcElems = srcKind.elements
  run vectorAddr(&mut em.*, function, first, X86Encode.rsi())
  run vectorAddr(&mut em.*, function, second, X86Encode.r9())
  drop run X86Encode.lea64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rbp(), dstOff))
  let mut lane = usize.ZERO
  while lane < count {
    let pick = mask[lane]
    if pick == u64.MAX || u64.toUsize(pick) >= srcElems * 2 {
      if kind.isFloat() { run X86Encode.pxor(&mut em.code, 0, 0) }
      else { run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rax()) }
    } else {
      let pickIdx = u64.toUsize(pick)
      let fromSecond = pickIdx >= srcElems
      let srcLane = if fromSecond { pickIdx - srcElems } else { pickIdx }
      run X86Encode.movImm64(&mut em.code, X86Encode.r11(), usize.toU64(srcLane))
      run loadVectorLane(&mut em.*, srcKind, if fromSecond { X86Encode.r9() } else { X86Encode.rsi() }, X86Encode.r11(), X86Encode.rax(), 0)
    }
    run X86Encode.movImm64(&mut em.code, X86Encode.r11(), usize.toU64(lane))
    run storeVectorLane(&mut em.*, kind, X86Encode.rdi(), X86Encode.r11(), X86Encode.rax(), 0)
    lane = lane + usize.ONE
  }
  return ()
}

effect fn emitReduce(em: &mut Emitter, function: &SsaFunction, which: Reduction, kind: Kind, vecVal: u64, initVal: u64, result: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let vecKind = function.value(vecVal).kind
  let isFloat = kind.isFloat()
  let vecSz = vecKind.storeSize()
  // Fast XMM-resident `mask<16>` (`any` / `all`) reduction via `pmovmskb`.
  if initVal == none() && !isFloat && isXmmMask16(&em.*, vecVal) && (which == Reduction.Or || which == Reduction.And) {
    let mx = valXmm(&em.*, vecVal)
    run X86Encode.pmovmskb(&mut em.code, X86Encode.rax(), mx)
    if which == Reduction.Or {
      run X86Encode.testRr32(&mut em.code, X86Encode.rax(), X86Encode.rax())
      run X86Encode.setcc(&mut em.code, X86Encode.ccNe(), X86Encode.rax())
    } else {
      run X86Encode.aluRi32(&mut em.code, Alu.Cmp, X86Encode.rax(), 0xFFFF)
      run X86Encode.setcc(&mut em.code, X86Encode.ccE(), X86Encode.rax())
    }
    run X86Encode.movzxRr8(&mut em.code, X86Encode.rax(), X86Encode.rax())
    return run storeGp(&mut em.*, result, X86Encode.rax())
  }
  // Fast scalar `any` (`Or`) and `all` (`And`) reductions on bit-packed `mask<N>` vectors.
  if initVal == none() && !isFloat && vecKind.bits == 1 && vecKind.elements <= 64
    && (vecSz == 1 || vecSz == 2 || vecSz == 4 || vecSz == 8)
    && (which == Reduction.Or || which == Reduction.And) {
    run loadMaskBits64(&mut em.*, function, vecVal, X86Encode.rax())
    let full = maskBitMask(vecKind.elements)
    if which == Reduction.Or {
      if vecKind.elements < 64 {
        if full <= 0x7FFFFFFF {
          run X86Encode.aluRi32(&mut em.code, Alu.And, X86Encode.rax(), u64.wrappingToI32(full))
        } else {
          run X86Encode.movImm64(&mut em.code, X86Encode.r11(), full)
          run X86Encode.aluRr64(&mut em.code, Alu.And, X86Encode.rax(), X86Encode.r11())
        }
      }
      run X86Encode.testRr64(&mut em.code, X86Encode.rax(), X86Encode.rax())
      run X86Encode.setcc(&mut em.code, X86Encode.ccNe(), X86Encode.rax())
      run X86Encode.movzxRr8(&mut em.code, X86Encode.rax(), X86Encode.rax())
      return run storeGp(&mut em.*, result, X86Encode.rax())
    }
    run X86Encode.movImm64(&mut em.code, X86Encode.r11(), full)
    run X86Encode.aluRr64(&mut em.code, Alu.And, X86Encode.rax(), X86Encode.r11())
    run X86Encode.aluRr64(&mut em.code, Alu.Cmp, X86Encode.rax(), X86Encode.r11())
    run X86Encode.setcc(&mut em.code, X86Encode.ccE(), X86Encode.rax())
    run X86Encode.movzxRr8(&mut em.code, X86Encode.rax(), X86Encode.rax())
    return run storeGp(&mut em.*, result, X86Encode.rax())
  }
  let double = kind.bits == 64
  run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rsp(), 32)
  run vectorAddr(&mut em.*, function, vecVal, X86Encode.rsi())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 0), X86Encode.rsi())
  let mut startIdx: i32 = 1
  if initVal != none() {
    run loadFloat(&mut em.*, function, initVal, 0, X86Encode.rax())
    startIdx = 0
  } else {
    run X86Encode.aluRr32(&mut em.code, Alu.Xor, X86Encode.r11(), X86Encode.r11())
    run loadVectorLane(&mut em.*, vecKind, X86Encode.rsi(), X86Encode.r11(), X86Encode.rax(), 0)
  }
  if isFloat {
    if double { drop run X86Encode.movsdMr(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 8), 0) }
    else { drop run X86Encode.movssMr(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 8), 0) }
  } else {
    drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 8), X86Encode.rax())
  }
  drop run X86Encode.movMi64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 16), startIdx)

  let loopHead = Bytes.length(&em.code)
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 16))
  run X86Encode.aluRi64(&mut em.code, Alu.Cmp, X86Encode.r11(), usize.toI32(vecKind.elements))
  let done = run emitJcc(&mut em.*, X86Encode.ccAe())
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), 0))
  run loadVectorLane(&mut em.*, vecKind, X86Encode.rsi(), X86Encode.r11(), X86Encode.rcx(), 1)
  if isFloat {
    if double { drop run X86Encode.movsdRm(&mut em.code, 0, Mem.baseDisp(X86Encode.rsp(), 8)) }
    else { drop run X86Encode.movssRm(&mut em.code, 0, Mem.baseDisp(X86Encode.rsp(), 8)) }
    match which {
      Reduction.FloatAdd => { run X86Encode.addFloat(&mut em.code, double, 0, 1) }
      Reduction.FloatMul => { run X86Encode.mulFloat(&mut em.code, double, 0, 1) }
      Reduction.FloatMinimum => { run emitIeeeFloatExtremeRegs(&mut em.*, false, double) }
      Reduction.FloatMaximum => { run emitIeeeFloatExtremeRegs(&mut em.*, true, double) }
      _ => {}
    }
    if double { drop run X86Encode.movsdMr(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 8), 0) }
    else { drop run X86Encode.movssMr(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 8), 0) }
  } else {
    drop run X86Encode.movRm64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rsp(), 8))
    match which {
      Reduction.Add => { run X86Encode.aluRr64(&mut em.code, Alu.Add, X86Encode.rax(), X86Encode.rcx()) }
      Reduction.Mul => { run X86Encode.imulRr64(&mut em.code, X86Encode.rax(), X86Encode.rcx()) }
      Reduction.And => { run X86Encode.aluRr64(&mut em.code, Alu.And, X86Encode.rax(), X86Encode.rcx()) }
      Reduction.Or => { run X86Encode.aluRr64(&mut em.code, Alu.Or, X86Encode.rax(), X86Encode.rcx()) }
      Reduction.Xor => { run X86Encode.aluRr64(&mut em.code, Alu.Xor, X86Encode.rax(), X86Encode.rcx()) }
      _ => {
        let signed = which == Reduction.SignedMinimum || which == Reduction.SignedMaximum
        let cc = match which {
          Reduction.SignedMinimum => X86Encode.ccG()
          Reduction.SignedMaximum => X86Encode.ccL()
          Reduction.UnsignedMinimum => X86Encode.ccA()
          _ => X86Encode.ccB()
        }
        run normalizeInt(&mut em.*, X86Encode.rax(), kind.bits, signed)
        run normalizeInt(&mut em.*, X86Encode.rcx(), kind.bits, signed)
        run X86Encode.aluRr64(&mut em.code, Alu.Cmp, X86Encode.rax(), X86Encode.rcx())
        run X86Encode.cmov64(&mut em.code, cc, X86Encode.rax(), X86Encode.rcx())
      }
    }
    run normalizeInt(&mut em.*, X86Encode.rax(), kind.bits, false)
    drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 8), X86Encode.rax())
  }
  drop run X86Encode.movRm64(&mut em.code, X86Encode.r11(), Mem.baseDisp(X86Encode.rsp(), 16))
  run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.r11(), 1)
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rsp(), 16), X86Encode.r11())
  let back = run emitJmp(&mut em.*)
  patchTo(&mut em.*, back, loopHead)
  patchHere(&mut em.*, done)
  if isFloat {
    if double { drop run X86Encode.movsdRm(&mut em.code, 0, Mem.baseDisp(X86Encode.rsp(), 8)) }
    else { drop run X86Encode.movssRm(&mut em.code, 0, Mem.baseDisp(X86Encode.rsp(), 8)) }
    run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rsp(), 32)
    return run storeFloat(&mut em.*, result, 0, double)
  }
  drop run X86Encode.movRm64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rsp(), 8))
  run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rsp(), 32)
  return run storeGp(&mut em.*, result, X86Encode.rax())
}

// Emits all 19 x86-64 SIMD/crypto architecture intrinsics directly via SSE2/SSSE3/SSE4.1/AES-NI/PCLMUL/SHA.
effect fn emitArchIntrinsic(
  em: &mut Emitter,
  function: &SsaFunction,
  op: ArchOperation,
  imm: u8,
  kind: Kind,
  ops: &[u64],
  result: u64,
) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let rDst = valXmm(&em.*, result)
  let dstOff = valOff(&em.*, result)
  if rDst == X86Frame.regNone() && dstOff == 0 { return () }
  let totalBytes = kind.storeSize()
  // Native XMM-homed fast path for 128-bit integer vector intrinsics (zero GPR clobbers!).
  if totalBytes == 16 && kind.isVector() && kind.isInteger() {
    let mut allVec16 = true
    let mut chk = usize.ZERO
    while chk < ops.length {
      let ok = function.value(ops[chk]).kind
      if !ok.isVector() || ok.storeSize() != 16 {
        allVec16 = false
        break
      }
      chk = chk + usize.ONE
    }
    if allVec16 {
      match op {
        ArchOperation.X86AesInverseMixColumns => {
          let srcXmm = run xmmOrLoadVec128(&mut em.*, function, ops[0], 1)
          let workDst = dstXmmOrScratch(&em.*, result, 1)
          run X86Encode.aesimc(&mut em.code, workDst, srcXmm)
          return run storeVec128(&mut em.*, result, workDst)
        }
        ArchOperation.X86Sha256Rounds2 => {
          let rRhs = if function.value(ops[1]).definition != Definition.Constant { valXmm(&em.*, ops[1]) } else { X86Frame.regNone() }
          let rKey = if function.value(ops[2]).definition != Definition.Constant { valXmm(&em.*, ops[2]) } else { X86Frame.regNone() }
          let workDst = if rDst != X86Frame.regNone() && rDst != rRhs && rDst != rKey { rDst } else { 1 }
          run loadVec128(&mut em.*, function, ops[0], workDst)
          let rhsXmm = run xmmOrLoadVec128(&mut em.*, function, ops[1], 2)
          run loadVec128(&mut em.*, function, ops[2], 0)
          run X86Encode.sha256rnds2(&mut em.code, workDst, rhsXmm)
          return run storeVec128(&mut em.*, result, workDst)
        }
        _ => {
          let rRhs = if function.value(ops[1]).definition != Definition.Constant { valXmm(&em.*, ops[1]) } else { X86Frame.regNone() }
          let workDst = if rDst != X86Frame.regNone() && rDst != rRhs { rDst } else { 1 }
          run loadVec128(&mut em.*, function, ops[0], workDst)
          let rhsXmm = run xmmOrLoadVec128(&mut em.*, function, ops[1], 0)
          match op {
            ArchOperation.X86ShuffleBytes => { run X86Encode.pshufb(&mut em.code, workDst, rhsXmm) }
            ArchOperation.X86MultiplyAddBytes => { run X86Encode.pmaddubsw(&mut em.code, workDst, rhsXmm) }
            ArchOperation.X86MultiplyAddWords => { run X86Encode.pmaddwd(&mut em.code, workDst, rhsXmm) }
            ArchOperation.X86PackUnsignedSaturate => {
              if kind.bits == 8 { run X86Encode.packuswb(&mut em.code, workDst, rhsXmm) }
              else { run X86Encode.packusdw(&mut em.code, workDst, rhsXmm) }
            }
            ArchOperation.X86PackSignedSaturate => {
              if kind.bits == 8 { run X86Encode.packsswb(&mut em.code, workDst, rhsXmm) }
              else { run X86Encode.packssdw(&mut em.code, workDst, rhsXmm) }
            }
            ArchOperation.X86SumAbsoluteDifferences => { run X86Encode.psadbw(&mut em.code, workDst, rhsXmm) }
            ArchOperation.X86AesEncrypt => { run X86Encode.aesenc(&mut em.code, workDst, rhsXmm) }
            ArchOperation.X86AesEncryptLast => { run X86Encode.aesenclast(&mut em.code, workDst, rhsXmm) }
            ArchOperation.X86AesDecrypt => { run X86Encode.aesdec(&mut em.code, workDst, rhsXmm) }
            ArchOperation.X86AesDecryptLast => { run X86Encode.aesdeclast(&mut em.code, workDst, rhsXmm) }
            ArchOperation.X86CarrylessMultiply => { run X86Encode.pclmulqdq(&mut em.code, workDst, rhsXmm, imm) }
            ArchOperation.X86Sha256Message1 => { run X86Encode.sha256msg1(&mut em.code, workDst, rhsXmm) }
            ArchOperation.X86Sha256Message2 => { run X86Encode.sha256msg2(&mut em.code, workDst, rhsXmm) }
            ArchOperation.X86Sha1Rounds4 => { run X86Encode.sha1rnds4(&mut em.code, workDst, rhsXmm, imm) }
            ArchOperation.X86Sha1NextE => { run X86Encode.sha1nexte(&mut em.code, workDst, rhsXmm) }
            ArchOperation.X86Sha1Message1 => { run X86Encode.sha1msg1(&mut em.code, workDst, rhsXmm) }
            ArchOperation.X86Sha1Message2 => { run X86Encode.sha1msg2(&mut em.code, workDst, rhsXmm) }
            _ => {}
          }
          return run storeVec128(&mut em.*, result, workDst)
        }
      }
    }
  }
  if dstOff == 0 { return () }
  let lanes16 = if totalBytes <= 16 { usize.ONE } else { totalBytes / 16 }
  // Process each 128-bit chunk (supports both 128-bit SSE and 256-bit two-chunk forms cleanly).
  run vectorAddr(&mut em.*, function, ops[0], X86Encode.rsi())
  if ops.length >= 2 { run vectorAddr(&mut em.*, function, ops[1], X86Encode.rdi()) }
  if ops.length >= 3 { run vectorAddr(&mut em.*, function, ops[2], X86Encode.r8()) }
  let mut chunk = usize.ZERO
  while chunk < lanes16 {
    let off = usize.toI32(chunk * 16)
    match op {
      ArchOperation.X86AesInverseMixColumns => {
        drop run X86Encode.movdquRm(&mut em.code, 1, Mem.baseDisp(X86Encode.rsi(), off))
        run X86Encode.aesimc(&mut em.code, 1, 1)
        drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff + off), 1)
      }
      ArchOperation.X86Sha256Rounds2 => {
        // `sha256rnds2 dst(xmm1), src(xmm2)` uses implicit `xmm0` for round keys (ops[2]).
        drop run X86Encode.movdquRm(&mut em.code, 1, Mem.baseDisp(X86Encode.rsi(), off))
        drop run X86Encode.movdquRm(&mut em.code, 2, Mem.baseDisp(X86Encode.rdi(), off))
        drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(X86Encode.r8(), off))
        run X86Encode.sha256rnds2(&mut em.code, 1, 2)
        drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff + off), 1)
      }
      _ => {
        drop run X86Encode.movdquRm(&mut em.code, 1, Mem.baseDisp(X86Encode.rsi(), off))
        drop run X86Encode.movdquRm(&mut em.code, 2, Mem.baseDisp(X86Encode.rdi(), off))
        match op {
          ArchOperation.X86ShuffleBytes => { run X86Encode.pshufb(&mut em.code, 1, 2) }
          ArchOperation.X86MultiplyAddBytes => { run X86Encode.pmaddubsw(&mut em.code, 1, 2) }
          ArchOperation.X86MultiplyAddWords => { run X86Encode.pmaddwd(&mut em.code, 1, 2) }
          ArchOperation.X86PackUnsignedSaturate => {
            if kind.bits == 8 { run X86Encode.packuswb(&mut em.code, 1, 2) }
            else { run X86Encode.packusdw(&mut em.code, 1, 2) }
          }
          ArchOperation.X86PackSignedSaturate => {
            if kind.bits == 8 { run X86Encode.packsswb(&mut em.code, 1, 2) }
            else { run X86Encode.packssdw(&mut em.code, 1, 2) }
          }
          ArchOperation.X86SumAbsoluteDifferences => { run X86Encode.psadbw(&mut em.code, 1, 2) }
          ArchOperation.X86AesEncrypt => { run X86Encode.aesenc(&mut em.code, 1, 2) }
          ArchOperation.X86AesEncryptLast => { run X86Encode.aesenclast(&mut em.code, 1, 2) }
          ArchOperation.X86AesDecrypt => { run X86Encode.aesdec(&mut em.code, 1, 2) }
          ArchOperation.X86AesDecryptLast => { run X86Encode.aesdeclast(&mut em.code, 1, 2) }
          ArchOperation.X86CarrylessMultiply => { run X86Encode.pclmulqdq(&mut em.code, 1, 2, imm) }
          ArchOperation.X86Sha256Message1 => { run X86Encode.sha256msg1(&mut em.code, 1, 2) }
          ArchOperation.X86Sha256Message2 => { run X86Encode.sha256msg2(&mut em.code, 1, 2) }
          ArchOperation.X86Sha1Rounds4 => { run X86Encode.sha1rnds4(&mut em.code, 1, 2, imm) }
          ArchOperation.X86Sha1NextE => { run X86Encode.sha1nexte(&mut em.code, 1, 2) }
          ArchOperation.X86Sha1Message1 => { run X86Encode.sha1msg1(&mut em.code, 1, 2) }
          ArchOperation.X86Sha1Message2 => { run X86Encode.sha1msg2(&mut em.code, 1, 2) }
          _ => {}
        }
        drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff + off), 1)
      }
    }
    chunk = chunk + usize.ONE
  }
  return ()
}

// ---- Block Exits & Parallel Edge Copies ----

struct GpMove {
  // 0 = physical GPR (`srcReg`), 1 = 64-bit stack slot (`[rbp + srcOff]`),
  // 2 = SSA constant (`srcVal`), 3 = zero, 4 = slot address (`lea [rbp + srcOff]`),
  // 5 = raw 64-bit immediate (`srcVal`), 6 = typed local-slot load (`[rbp + srcOff]`, `srcBytes`).
  srcKind: u8,
  srcBytes: u8,
  srcVal: u64,
  srcReg: u8,
  srcOff: i32,
  dstIsReg: bool,
  dstReg: u8,
  dstOff: i32,
  done: bool,
}

impl Copy for GpMove {}

struct XmmMove {
  // 0 = physical XMM (`srcReg`), 1 = stack slot (`[rbp + srcOff]`),
  // 2 = SSA constant/value (`srcVal`), 3 = zero, 4 = small vector (1..8B via `loadSmallVecToXmm`),
  // 5 = general vector addr (`vectorAddr` -> `movdqu`).
  srcKind: u8,
  width: u8, // 4 = f32, 8 = f64, 16 = 128-bit vector
  srcVal: u64,
  srcReg: u8,
  srcOff: i32,
  dstIsReg: bool,
  dstReg: u8,
  dstOff: i32,
  done: bool,
}

impl Copy for XmmMove {}

effect fn emitExit(em: &mut Emitter, function: &SsaFunction, blockIdx: usize, nextBlk: usize, naked: bool, fusedCmp: usize, retInRax: bool) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let blk = function.block(blockIdx)
  let edges = List<Edge>.asSlice(&blk.edges)
  match blk.exit {
    Exit.Jump => {
      run emitEdgeCopies(&mut em.*, function, &edges[0])
      if edges[0].block != nextBlk {
        run emitJmpBlock(&mut em.*, edges[0].block)
      }
      return ()
    }
    Exit.Branch => {
      let mut trueCc = X86Encode.ccNe()
      if fusedCmp != usize.MAX {
        let cmpInst = function.instruction(fusedCmp)
        if cmpInst.place != 0 {
          run recordLocation(&mut em.*, cmpInst.place)
        }
        let cmpOps = function.operandsOf(fusedCmp)
        match cmpInst.operation {
          Operation.Compare {predicate} => {
            trueCc = run emitScalarIntCmpFlags(&mut em.*, function, predicate, cmpOps[0], cmpOps[1])
          }
          Operation.Overflow {operation, signed} => {
            trueCc = run emitScalarOverflowCore(&mut em.*, function, operation, signed, cmpInst.kind.bits, cmpOps[0], cmpOps[1], cmpInst.result)
          }
          Operation.Reduce {which} => {
            let mx = valXmm(&em.*, cmpOps[0])
            if hasFeat(&em.*, X86Frame.featAvx2()) {
              run X86Encode.vpmovmskbXmm(&mut em.code, X86Encode.rax(), mx)
            } else {
              run X86Encode.pmovmskb(&mut em.code, X86Encode.rax(), mx)
            }
            if which == Reduction.Or {
              run X86Encode.testRr32(&mut em.code, X86Encode.rax(), X86Encode.rax())
              trueCc = X86Encode.ccNe()
            } else {
              run X86Encode.aluRi32(&mut em.code, Alu.Cmp, X86Encode.rax(), 0xFFFF)
              trueCc = X86Encode.ccE()
            }
          }
          _ => {}
        }
      } else {
        let condSpill = spilledGpOff(&em.*, function, blk.value)
        if condSpill != 0 {
          drop run X86Encode.testMi8(&mut em.code, Mem.baseDisp(X86Encode.rbp(), condSpill), 1)
        } else {
          let condReg = run regOrLoad(&mut em.*, function, blk.value, X86Encode.rax())
          if isKnownBool(&em.*, blk.value) {
            run X86Encode.testRr8(&mut em.code, condReg, condReg)
          } else {
            run X86Encode.testRi8(&mut em.code, condReg, 1)
          }
        }
      }
      let falseCc = X86Encode.invertCc(trueCc)
      let trueHasCopies = List<u64>.length(&edges[0].arguments) > usize.ZERO
      let falseHasCopies = List<u64>.length(&edges[1].arguments) > usize.ZERO
      if !trueHasCopies && !falseHasCopies && edges[0].block == nextBlk {
        return run emitJccBlock(&mut em.*, falseCc, edges[1].block)
      }
      if !trueHasCopies {
        run emitJccBlock(&mut em.*, trueCc, edges[0].block)
        run emitEdgeCopies(&mut em.*, function, &edges[1])
        if edges[1].block != nextBlk {
          run emitJmpBlock(&mut em.*, edges[1].block)
        }
        return ()
      }
      if !falseHasCopies {
        run emitJccBlock(&mut em.*, falseCc, edges[1].block)
        run emitEdgeCopies(&mut em.*, function, &edges[0])
        if edges[0].block != nextBlk {
          run emitJmpBlock(&mut em.*, edges[0].block)
        }
        return ()
      }
      let takeFalse = run emitJcc(&mut em.*, falseCc)
      // Edge 0 (true branch).
      run emitEdgeCopies(&mut em.*, function, &edges[0])
      run emitJmpBlock(&mut em.*, edges[0].block)
      // Edge 1 (false branch).
      patchHere(&mut em.*, takeFalse)
      run emitEdgeCopies(&mut em.*, function, &edges[1])
      if edges[1].block != nextBlk {
        run emitJmpBlock(&mut em.*, edges[1].block)
      }
      return ()
    }
    Exit.Switch => {
      let valKind = function.value(blk.value).kind
      let swReg = if valKind.bits == 64 {
        run regOrLoad(&mut em.*, function, blk.value, X86Encode.r11())
      } else {
        run loadGp(&mut em.*, function, blk.value, X86Encode.r11())
        run normalizeInt(&mut em.*, X86Encode.r11(), valKind.bits, false)
        X86Encode.r11()
      }
      let cases = List<u64>.asSlice(&blk.cases)
      // Emit case comparisons (preserving `swReg` across comparisons). Cases with no edge copies
      // jump straight to their target block without emitting a trampoline stub.
      let mut caseStubJumps = run List<usize>.makeWithCapacity(cases.length)
      let mut hasStubs = false
      let mut c = usize.ZERO
      while c < cases.length {
        let cv = maskBits(cases[c], valKind.bits)
        let signed = u64.wrappingToI64(cv)
        if signed >= -2147483648 && signed <= 2147483647 {
          run X86Encode.aluRi64(&mut em.code, Alu.Cmp, swReg, i64.wrappingToI32(signed))
        } else {
          run X86Encode.movImm64(&mut em.code, X86Encode.r10(), cv)
          run X86Encode.aluRr64(&mut em.code, Alu.Cmp, swReg, X86Encode.r10())
        }
        if List<u64>.length(&edges[c + usize.ONE].arguments) == usize.ZERO {
          run emitJccBlock(&mut em.*, X86Encode.ccE(), edges[c + usize.ONE].block)
          run List<usize>.append(&mut caseStubJumps, usize.MAX)
        } else {
          let eqAt = run emitJcc(&mut em.*, X86Encode.ccE())
          run List<usize>.append(&mut caseStubJumps, eqAt)
          hasStubs = true
        }
        c = c + usize.ONE
      }
      // Default edge (edge 0).
      run emitEdgeCopies(&mut em.*, function, &edges[0])
      if hasStubs || edges[0].block != nextBlk {
        run emitJmpBlock(&mut em.*, edges[0].block)
      }
      // Case stubs for cases that carry edge arguments (edge `c + 1`).
      if hasStubs {
        let cj = List<usize>.asSlice(&caseStubJumps)
        c = usize.ZERO
        while c < cases.length {
          if cj[c] != usize.MAX {
            patchHere(&mut em.*, cj[c])
            run emitEdgeCopies(&mut em.*, function, &edges[c + usize.ONE])
            run emitJmpBlock(&mut em.*, edges[c + usize.ONE].block)
          }
          c = c + usize.ONE
        }
      }
      return ()
    }
    Exit.Return => {
      if retInRax {
        run applyParamExt(&mut em.*, X86Encode.rax(), function.result.bits, function.resultExtension)
      } else if blk.value != none() {
        let mut gpRet = usize.ZERO
        let mut fpRet = usize.ZERO
        run loadReturnPiece(&mut em.*, function, blk.value, function.result, &mut gpRet, &mut fpRet)
        if blk.secondValue != none() {
          run loadReturnPiece(&mut em.*, function, blk.secondValue, function.secondResultKind, &mut gpRet, &mut fpRet)
        }
      }
      if !naked {
        return run emitEpilogue(&mut em.*)
      }
      return ()
    }
    Exit.Trap => {
      return run X86Encode.ud2(&mut em.code)
    }
    Exit.Unreachable => {
      if !naked {
        return run X86Encode.ud2(&mut em.code)
      }
      return ()
    }
    Exit.Open => { return () }
  }
}

effect fn loadReturnPiece(em: &mut Emitter, function: &SsaFunction, val: u64, kind: Kind, gpRet: &mut usize, fpRet: &mut usize) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if kind.isVector() {
    let xmm = usize.toU8(fpRet.*)
    fpRet.* = fpRet.* + usize.ONE
    let sz = kind.storeSize()
    if sz == 16 {
      return run loadVec128(&mut em.*, function, val, xmm)
    }
    if sz == 1 || sz == 2 || sz == 4 || sz == 8 {
      // Must use `r10` (never `rax`/`rdx`) to preserve piece 0 in pair returns!
      return run loadSmallVecToXmm(&mut em.*, function, val, xmm, X86Encode.r10())
    }
    run vectorAddr(&mut em.*, function, val, X86Encode.r10())
    drop run X86Encode.movdquRm(&mut em.code, xmm, Mem.baseDisp(X86Encode.r10(), 0))
    return ()
  }
  if kind.isFloat() {
    let xmm = usize.toU8(fpRet.*)
    fpRet.* = fpRet.* + usize.ONE
    return run loadFloat(&mut em.*, function, val, xmm, X86Encode.r10())
  }
  if kind.bits > 64 {
    gpRet.* = gpRet.* + 2
    return run loadPair(&mut em.*, function, val, X86Encode.rax(), X86Encode.rdx())
  }
  let reg = if gpRet.* == usize.ZERO { X86Encode.rax() } else { X86Encode.rdx() }
  gpRet.* = gpRet.* + usize.ONE
  run loadGp(&mut em.*, function, val, reg)
  if gpRet.* == usize.ONE {
    run applyParamExt(&mut em.*, reg, kind.bits, function.resultExtension)
  }
  return ()
}

// Emits one single GP move (`Reg`, `Mem`, `Const`, `SlotAddr`, `RawImm`, `TypedLoad`, or `Zero` ->
// `Reg` or `Mem`). When `mv.dstIsReg == true`, never touches `rax` or cycle-breaker `r10`.
effect fn emitSingleGpMove(em: &mut Emitter, function: &SsaFunction, mv: GpMove) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if mv.dstIsReg {
    if mv.srcKind == 0 {
      if mv.srcReg != mv.dstReg {
        return run X86Encode.movRr64(&mut em.code, mv.dstReg, mv.srcReg)
      }
      return ()
    }
    if mv.srcKind == 1 {
      drop run X86Encode.movRm64(&mut em.code, mv.dstReg, Mem.baseDisp(X86Encode.rbp(), mv.srcOff))
      return ()
    }
    if mv.srcKind == 2 {
      let info = function.value(mv.srcVal)
      let c = function.constantOf(mv.srcVal)
      return run loadConstantGp(&mut em.*, function, c, info.kind, mv.dstReg)
    }
    if mv.srcKind == 4 {
      drop run X86Encode.lea64(&mut em.code, mv.dstReg, Mem.baseDisp(X86Encode.rbp(), mv.srcOff))
      return ()
    }
    if mv.srcKind == 5 {
      return run X86Encode.movImm64(&mut em.code, mv.dstReg, mv.srcVal)
    }
    if mv.srcKind == 6 {
      let mem = Mem.baseDisp(X86Encode.rbp(), mv.srcOff)
      if mv.srcBytes == 1 {
        drop run X86Encode.movzxRm8(&mut em.code, mv.dstReg, mem)
      } else if mv.srcBytes == 2 {
        drop run X86Encode.movzxRm16(&mut em.code, mv.dstReg, mem)
      } else if mv.srcBytes == 4 {
        drop run X86Encode.movRm32(&mut em.code, mv.dstReg, mem)
      } else {
        drop run X86Encode.movRm64(&mut em.code, mv.dstReg, mem)
      }
      return ()
    }
    return run X86Encode.movImm64(&mut em.code, mv.dstReg, 0)
  }
  // Destination is `[rbp + mv.dstOff]`.
  if mv.srcKind == 0 {
    drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), mv.dstOff), mv.srcReg)
    return ()
  }
  if mv.srcKind == 1 {
    drop run X86Encode.movRm64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), mv.srcOff))
    drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), mv.dstOff), X86Encode.rax())
    return ()
  }
  if mv.srcKind == 2 {
    let info = function.value(mv.srcVal)
    let imm = constBitsImm32(function, mv.srcVal, info.kind.bits)
    if imm.ok {
      drop run X86Encode.movMi64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), mv.dstOff), imm.value)
      return ()
    }
    let c = function.constantOf(mv.srcVal)
    run loadConstantGp(&mut em.*, function, c, info.kind, X86Encode.rax())
    drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), mv.dstOff), X86Encode.rax())
    return ()
  }
  if mv.srcKind == 4 {
    drop run X86Encode.lea64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rbp(), mv.srcOff))
    drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), mv.dstOff), X86Encode.rax())
    return ()
  }
  if mv.srcKind == 5 {
    run X86Encode.movImm64(&mut em.code, X86Encode.rax(), mv.srcVal)
    drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), mv.dstOff), X86Encode.rax())
    return ()
  }
  if mv.srcKind == 6 {
    let mem = Mem.baseDisp(X86Encode.rbp(), mv.srcOff)
    if mv.srcBytes == 1 {
      drop run X86Encode.movzxRm8(&mut em.code, X86Encode.rax(), mem)
    } else if mv.srcBytes == 2 {
      drop run X86Encode.movzxRm16(&mut em.code, X86Encode.rax(), mem)
    } else if mv.srcBytes == 4 {
      drop run X86Encode.movRm32(&mut em.code, X86Encode.rax(), mem)
    } else {
      drop run X86Encode.movRm64(&mut em.code, X86Encode.rax(), mem)
    }
    drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), mv.dstOff), X86Encode.rax())
    return ()
  }
  drop run X86Encode.movMi64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), mv.dstOff), 0)
  return ()
}

// Schedules and emits an arbitrary parallel set of `GpMove`s with distinct destinations in place,
// breaking register/slot cycles via `r10`. When all moves have `dstIsReg == true`, `rax` is never
// clobbered.
effect fn resolveGpMoves(em: &mut Emitter, function: &SsaFunction, moves: &mut List<GpMove>) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let ms = List<GpMove>.asMutSlice(&mut moves.*)
  let mut remaining = ms.length
  while remaining > usize.ZERO {
    // Find a ready move whose destination is not read by any other remaining move.
    let mut ready = usize.MAX
    let mut k = usize.ZERO
    while k < ms.length {
      if !ms[k].done {
        let mut blocked = false
        let mut m = usize.ZERO
        while m < ms.length {
          if m != k && !ms[m].done {
            if ms[k].dstIsReg {
              if ms[m].srcKind == 0 && ms[m].srcReg == ms[k].dstReg {
                blocked = true
                break
              }
            } else {
              if ms[m].srcKind == 1 && ms[m].srcOff == ms[k].dstOff {
                blocked = true
                break
              }
            }
          }
          m = m + usize.ONE
        }
        if !blocked {
          ready = k
          break
        }
      }
      k = k + usize.ONE
    }
    if ready != usize.MAX {
      let mv = ms[ready]
      ms[ready].done = true
      remaining = remaining - usize.ONE
      run emitSingleGpMove(&mut em.*, function, mv)
    } else {
      // Every remaining move belongs to a disjoint cycle; break one cycle via `r10`.
      let mut pick = usize.ZERO
      while pick < ms.length && ms[pick].done {
        pick = pick + usize.ONE
      }
      let mv = ms[pick]
      if mv.dstIsReg {
        run X86Encode.movRr64(&mut em.code, X86Encode.r10(), mv.dstReg)
      } else {
        drop run X86Encode.movRm64(&mut em.code, X86Encode.r10(), Mem.baseDisp(X86Encode.rbp(), mv.dstOff))
      }
      ms[pick].done = true
      remaining = remaining - usize.ONE
      run emitSingleGpMove(&mut em.*, function, mv)
      // Redirect remaining readers of `mv.dst` to read the saved value in `r10`.
      let mut m = usize.ZERO
      while m < ms.length {
        if !ms[m].done {
          if mv.dstIsReg && ms[m].srcKind == 0 && ms[m].srcReg == mv.dstReg {
            ms[m].srcKind = 0
            ms[m].srcReg = X86Encode.r10()
          } else if !mv.dstIsReg && ms[m].srcKind == 1 && ms[m].srcOff == mv.dstOff {
            ms[m].srcKind = 0
            ms[m].srcReg = X86Encode.r10()
          }
        }
        m = m + usize.ONE
      }
    }
  }
  return ()
}

// Resolves arbitrary parallel <=64-bit GP edge moves (`Reg`/`Mem`/`Const`/`SlotBase` -> `Reg`/`Mem`)
// in place with zero stack traffic, breaking cycles via `r10`.
effect fn emitParallelGpMoves(em: &mut Emitter, function: &SsaFunction, args: &[u64], params: &[u64]) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut moves = run List<GpMove>.makeWithCapacity(args.length)
  let mut i = usize.ZERO
  while i < args.length {
    let dstParam = params[i]
    let dstKind = function.value(dstParam).kind
    if !dstKind.isUnit() {
      let dstReg = valReg(&em.*, dstParam)
      let dstOff = valOff(&em.*, dstParam)
      if dstReg != X86Frame.regNone() || dstOff != 0 {
        let dstIsReg = dstReg != X86Frame.regNone()
        let srcVal = args[i]
        let srcInfo = function.value(srcVal)
        let mut srcKind: u8 = 3
        let mut srcReg: u8 = X86Frame.regNone()
        let mut srcOff: i32 = 0
        if srcInfo.definition == Definition.Constant {
          srcKind = 2
        } else {
          let sb = valSlotBase(&em.*, srcVal)
          if sb != 0 {
            srcKind = 4
            srcOff = sb
          } else {
            let sr = valReg(&em.*, srcVal)
            if sr != X86Frame.regNone() {
              srcKind = 0
              srcReg = sr
            } else {
              let so = valOff(&em.*, srcVal)
              if so != 0 {
                srcKind = 1
                srcOff = so
              }
            }
          }
        }
        let isNoOp = (dstIsReg && srcKind == 0 && srcReg == dstReg) || (!dstIsReg && srcKind == 1 && srcOff == dstOff)
        if !isNoOp {
          run List<GpMove>.append(&mut moves, GpMove {
            srcKind: srcKind, srcBytes: 8, srcVal: srcVal, srcReg: srcReg, srcOff: srcOff,
            dstIsReg: dstIsReg, dstReg: dstReg, dstOff: dstOff, done: false,
          })
        }
      }
    }
    i = i + usize.ONE
  }
  return run resolveGpMoves(&mut em.*, function, &mut moves)
}

// Emits one `XmmMove` (never clobbering any allocated GPR; may use `rax` for float/small-vec loads
// and `scratchXmm` when `dstIsReg == false` and source is memory/constant/zero).
effect fn emitSingleXmmMove(em: &mut Emitter, function: &SsaFunction, mv: XmmMove, scratchXmm: u8) -> ()
! OutOfMemoryError ? &mut Allocator {
  let targetXmm = if mv.dstIsReg { mv.dstReg } else { scratchXmm }
  let mut readyXmm = targetXmm
  if mv.srcKind == 0 {
    if mv.dstIsReg {
      if mv.srcReg != mv.dstReg {
        if mv.width == 32 { run X86Encode.vmovdqaYmmRr(&mut em.code, mv.dstReg, mv.srcReg) }
        else { run X86Encode.movapsRr(&mut em.code, mv.dstReg, mv.srcReg) }
      }
      return ()
    }
    readyXmm = mv.srcReg
  } else if mv.srcKind == 1 {
    let mem = Mem.baseDisp(X86Encode.rbp(), mv.srcOff)
    if mv.width == 32 { drop run X86Encode.vmovdquYmmRm(&mut em.code, targetXmm, mem) }
    else if mv.width == 16 { drop run X86Encode.movdquRm(&mut em.code, targetXmm, mem) }
    else if mv.width == 8 { drop run X86Encode.movsdRm(&mut em.code, targetXmm, mem) }
    else { drop run X86Encode.movssRm(&mut em.code, targetXmm, mem) }
  } else if mv.srcKind == 2 {
    if mv.width == 32 { run loadVec256(&mut em.*, function, mv.srcVal, targetXmm) }
    else if mv.width == 16 { run loadVec128(&mut em.*, function, mv.srcVal, targetXmm) }
    else { run loadFloat(&mut em.*, function, mv.srcVal, targetXmm, X86Encode.rax()) }
  } else if mv.srcKind == 4 {
    run loadSmallVecToXmm(&mut em.*, function, mv.srcVal, targetXmm, X86Encode.rax())
  } else if mv.srcKind == 5 {
    run vectorAddr(&mut em.*, function, mv.srcVal, X86Encode.rax())
    drop run X86Encode.movdquRm(&mut em.code, targetXmm, Mem.baseDisp(X86Encode.rax(), 0))
  } else {
    if mv.width == 32 { run X86Encode.vpxorYmm(&mut em.code, targetXmm, targetXmm, targetXmm) }
    else { run X86Encode.pxor(&mut em.code, targetXmm, targetXmm) }
  }
  if !mv.dstIsReg {
    let dstMem = Mem.baseDisp(X86Encode.rbp(), mv.dstOff)
    if mv.width == 32 { drop run X86Encode.vmovdquYmmMr(&mut em.code, dstMem, readyXmm) }
    else if mv.width == 16 { drop run X86Encode.movdquMr(&mut em.code, dstMem, readyXmm) }
    else if mv.width == 8 { drop run X86Encode.movsdMr(&mut em.code, dstMem, readyXmm) }
    else { drop run X86Encode.movssMr(&mut em.code, dstMem, readyXmm) }
  }
  return ()
}

// Schedules and emits an arbitrary parallel set of `XmmMove`s with distinct destinations in place,
// breaking register/slot cycles via a free scratch XMM/YMM register outside `reservedMask` (zero
// `rsp` traffic).
effect fn resolveXmmMoves(em: &mut Emitter, function: &SsaFunction, moves: &mut List<XmmMove>, reservedMask: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  let ms = List<XmmMove>.asMutSlice(&mut moves.*)
  let mut liveReserved = reservedMask
  let mut remaining = ms.length
  while remaining > usize.ZERO {
    let mut ready = usize.MAX
    let mut busyMask: u64 = 0
    let mut k = usize.ZERO
    while k < ms.length {
      if !ms[k].done {
        if ms[k].srcKind == 0 && ms[k].srcReg < 16 {
          busyMask = busyMask | u64.shiftLeft(1, u8.toU64(ms[k].srcReg))
        }
        if ms[k].dstIsReg && ms[k].dstReg < 16 {
          busyMask = busyMask | u64.shiftLeft(1, u8.toU64(ms[k].dstReg))
        }
        if ready == usize.MAX {
          let mut blocked = false
          let mut m = usize.ZERO
          while m < ms.length {
            if m != k && !ms[m].done {
              if ms[k].dstIsReg {
                if ms[m].srcKind == 0 && ms[m].srcReg == ms[k].dstReg {
                  blocked = true
                  break
                }
              } else {
                if ms[m].srcKind == 1 && ms[m].srcOff == ms[k].dstOff {
                  blocked = true
                  break
                }
              }
            }
            m = m + usize.ONE
          }
          if !blocked { ready = k }
        }
      }
      k = k + usize.ONE
    }
    let usedMask = liveReserved | busyMask
    let mut scratch: u8 = 0
    while scratch < 16 && (usedMask & u64.shiftLeft(1, u8.toU64(scratch))) != 0 {
      scratch = scratch + 1
    }
    if scratch >= 16 { scratch = 0 }
    if ready != usize.MAX {
      let mv = ms[ready]
      ms[ready].done = true
      remaining = remaining - usize.ONE
      run emitSingleXmmMove(&mut em.*, function, mv, scratch)
      if mv.dstIsReg && mv.dstReg < 16 {
        liveReserved = liveReserved | u64.shiftLeft(1, u8.toU64(mv.dstReg))
      }
    } else {
      let tmp = scratch
      let mut moveScratch: u8 = 0
      let usedWithTmp = usedMask | u64.shiftLeft(1, u8.toU64(tmp))
      while moveScratch < 16 && (usedWithTmp & u64.shiftLeft(1, u8.toU64(moveScratch))) != 0 {
        moveScratch = moveScratch + 1
      }
      if moveScratch >= 16 { moveScratch = if tmp == 0 { 1 } else { 0 } }
      let mut pick = usize.ZERO
      while pick < ms.length && ms[pick].done {
        pick = pick + usize.ONE
      }
      let mv = ms[pick]
      if mv.dstIsReg {
        if mv.width == 32 { run X86Encode.vmovdqaYmmRr(&mut em.code, tmp, mv.dstReg) }
        else { run X86Encode.movapsRr(&mut em.code, tmp, mv.dstReg) }
      } else if mv.width == 32 {
        drop run X86Encode.vmovdquYmmRm(&mut em.code, tmp, Mem.baseDisp(X86Encode.rbp(), mv.dstOff))
      } else if mv.width == 16 {
        drop run X86Encode.movdquRm(&mut em.code, tmp, Mem.baseDisp(X86Encode.rbp(), mv.dstOff))
      } else if mv.width == 8 {
        drop run X86Encode.movsdRm(&mut em.code, tmp, Mem.baseDisp(X86Encode.rbp(), mv.dstOff))
      } else {
        drop run X86Encode.movssRm(&mut em.code, tmp, Mem.baseDisp(X86Encode.rbp(), mv.dstOff))
      }
      ms[pick].done = true
      remaining = remaining - usize.ONE
      run emitSingleXmmMove(&mut em.*, function, mv, moveScratch)
      if mv.dstIsReg && mv.dstReg < 16 {
        liveReserved = liveReserved | u64.shiftLeft(1, u8.toU64(mv.dstReg))
      }
      let mut m = usize.ZERO
      while m < ms.length {
        if !ms[m].done {
          if mv.dstIsReg && ms[m].srcKind == 0 && ms[m].srcReg == mv.dstReg {
            ms[m].srcKind = 0
            ms[m].srcReg = tmp
          } else if !mv.dstIsReg && ms[m].srcKind == 1 && ms[m].srcOff == mv.dstOff {
            ms[m].srcKind = 0
            ms[m].srcReg = tmp
          }
        }
        m = m + usize.ONE
      }
    }
  }
  return ()
}

// Emits parallel copies from `edge.arguments` into `targetBlock.parameters`. Uses zero-stack
// parallel move scheduling for GP, GPR-homed mask<N>, scalar float, 128-bit SSE2, and 256-bit
// AVX2 vector edges, falling back to stack staging only for `i128` or non-SIMD wide vectors.
effect fn emitEdgeCopies(em: &mut Emitter, function: &SsaFunction, edge: &Edge) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let args = List<u64>.asSlice(&edge.arguments)
  if args.length == usize.ZERO { return () }
  let params = List<u64>.asSlice(&function.block(edge.block).parameters)
  if args.length == usize.ONE {
    return run copyValueToParam(&mut em.*, function, args[0], params[0])
  }
  let hasAvx2 = hasFeat(&em.*, X86Frame.featAvx2())
  // Check whether all non-unit edge parameters can be scheduled via parallel GP + XMM/YMM moves.
  let mut canParallel = true
  let mut hasXmm = false
  let mut hasGp = false
  let mut i = usize.ZERO
  while i < args.length {
    let pVal = params[i]
    let k = function.value(pVal).kind
    if !k.isUnit() {
      if k.isVector() {
        let sz = k.storeSize()
        if sz == 16 || (hasAvx2 && sz == 32 && k.isInteger()) {
          hasXmm = true
        } else if k.bits == 1 && k.elements <= 64 && valReg(&em.*, pVal) != X86Frame.regNone() {
          hasGp = true
        } else {
          canParallel = false
          break
        }
      } else if k.isFloat() {
        hasXmm = true
      } else if k.bits <= 64 {
        hasGp = true
      } else {
        canParallel = false
        break
      }
    }
    i = i + usize.ONE
  }
  if canParallel {
    if !hasXmm && hasGp {
      let mut allScalarGp = true
      i = usize.ZERO
      while i < args.length {
        if function.value(params[i]).kind.isVector() {
          allScalarGp = false
          break
        }
        i = i + usize.ONE
      }
      if allScalarGp {
        return run emitParallelGpMoves(&mut em.*, function, args, params)
      }
    }
    // Emit XMM/YMM/float moves first (uses only `rax` and XMM/YMM regs; never clobbers allocated GPRs),
    // then GP / GPR-homed-mask moves (never clobbers XMM/YMM regs).
    if hasXmm {
      let mut xmmMoves = run List<XmmMove>.makeWithCapacity(args.length)
      i = usize.ZERO
      while i < args.length {
        let dstParam = params[i]
        let dstKind = function.value(dstParam).kind
        let isSimdXmm = dstKind.isVector() && (dstKind.storeSize() == 16 || (hasAvx2 && dstKind.storeSize() == 32 && dstKind.isInteger()))
        if !dstKind.isUnit() && (dstKind.isFloat() || isSimdXmm) {
          let dstXmm = valXmm(&em.*, dstParam)
          let dstOff = valOff(&em.*, dstParam)
          if dstXmm != X86Frame.regNone() || dstOff != 0 {
            let dstIsReg = dstXmm != X86Frame.regNone()
            let width: u8 = if dstKind.isVector() { usize.toU8(dstKind.storeSize()) } else if dstKind.bits == 64 { 8 } else { 4 }
            let srcVal = args[i]
            let srcInfo = function.value(srcVal)
            let mut srcKind: u8 = 3
            let mut srcReg: u8 = X86Frame.regNone()
            let mut srcOff: i32 = 0
            if srcInfo.definition == Definition.Constant {
              srcKind = 2
            } else {
              let sx = valXmm(&em.*, srcVal)
              if sx != X86Frame.regNone() {
                srcKind = 0
                srcReg = sx
              } else {
                let so = valOff(&em.*, srcVal)
                if so != 0 {
                  srcKind = 1
                  srcOff = so
                }
              }
            }
            let isNoOp = (dstIsReg && srcKind == 0 && srcReg == dstXmm) || (!dstIsReg && srcKind == 1 && srcOff == dstOff)
            if !isNoOp {
              run List<XmmMove>.append(&mut xmmMoves, XmmMove {
                srcKind: srcKind, width: width, srcVal: srcVal, srcReg: srcReg, srcOff: srcOff,
                dstIsReg: dstIsReg, dstReg: dstXmm, dstOff: dstOff, done: false,
              })
            }
          }
        }
        i = i + usize.ONE
      }
      if List<XmmMove>.length(&xmmMoves) > usize.ZERO {
        run resolveXmmMoves(&mut em.*, function, &mut xmmMoves, 0xFFFC)
      }
    }
    if hasGp {
      let mut gpMoves = run List<GpMove>.makeWithCapacity(args.length)
      i = usize.ZERO
      while i < args.length {
        let dstParam = params[i]
        let dstKind = function.value(dstParam).kind
        let isGpOrMask = !dstKind.isUnit() && ((!dstKind.isVector() && !dstKind.isFloat() && dstKind.bits <= 64) || (dstKind.isVector() && dstKind.bits == 1 && dstKind.elements <= 64 && valReg(&em.*, dstParam) != X86Frame.regNone()))
        if isGpOrMask {
          let dstReg = valReg(&em.*, dstParam)
          let dstOff = valOff(&em.*, dstParam)
          if dstReg != X86Frame.regNone() || dstOff != 0 {
            let dstIsReg = dstReg != X86Frame.regNone()
            let srcVal = args[i]
            let srcInfo = function.value(srcVal)
            let mut srcKind: u8 = 3
            let mut srcBytes: u8 = 8
            let mut srcValOut: u64 = srcVal
            let mut srcReg: u8 = X86Frame.regNone()
            let mut srcOff: i32 = 0
            if srcInfo.definition == Definition.Constant {
              if dstKind.isVector() {
                srcKind = 5
                let c = function.constantOf(srcVal)
                srcValOut = if (c.low & 1) == 0 { 0 } else { maskBitMask(dstKind.elements) }
              } else {
                srcKind = 2
              }
            } else {
              let sb = valSlotBase(&em.*, srcVal)
              if sb != 0 {
                srcKind = 4
                srcOff = sb
              } else {
                let sr = valReg(&em.*, srcVal)
                if sr != X86Frame.regNone() {
                  srcKind = 0
                  srcReg = sr
                } else {
                  let so = valOff(&em.*, srcVal)
                  if so != 0 {
                    if dstKind.isVector() {
                      srcKind = 6
                      srcBytes = usize.toU8(dstKind.storeSize())
                    } else {
                      srcKind = 1
                    }
                    srcOff = so
                  }
                }
              }
            }
            let isNoOp = (dstIsReg && srcKind == 0 && srcReg == dstReg) || (!dstIsReg && srcKind == 1 && srcOff == dstOff)
            if !isNoOp {
              run List<GpMove>.append(&mut gpMoves, GpMove {
                srcKind: srcKind, srcBytes: srcBytes, srcVal: srcValOut, srcReg: srcReg, srcOff: srcOff,
                dstIsReg: dstIsReg, dstReg: dstReg, dstOff: dstOff, done: false,
              })
            }
          }
        }
        i = i + usize.ONE
      }
      if List<GpMove>.length(&gpMoves) > usize.ZERO {
        run resolveGpMoves(&mut em.*, function, &mut gpMoves)
      }
    }
    return ()
  }
  // Mixed / wide edge fallback: stage all source values on `rsp` (16-byte aligned).
  let mut stageBytes: u64 = 0
  let mut stageOffs = run List<i32>.makeWithCapacity(args.length)
  i = usize.ZERO
  while i < args.length {
    let sz = usize.toU64(X86Frame.valueSlotBytes(function.value(params[i]).kind))
    let align: u64 = if sz >= 16 { 16 } else { 8 }
    stageBytes = alignUpU64(stageBytes, align)
    run List<i32>.append(&mut stageOffs, u64.wrappingToI32(stageBytes))
    stageBytes = stageBytes + sz
    i = i + usize.ONE
  }
  let totalStage = alignUpU64(stageBytes, 16)
  if totalStage == 0 { return () }
  run X86Encode.aluRi64(&mut em.code, Alu.Sub, X86Encode.rsp(), u64.wrappingToI32(totalStage))
  let offs = List<i32>.asSlice(&stageOffs)
  // Pass 1: copy every edge argument into its staging slot on `[rsp + offs[i]]`.
  i = usize.ZERO
  while i < args.length {
    let dstKind = function.value(params[i]).kind
    let dstReg = valReg(&em.*, params[i])
    let dstXmm = valXmm(&em.*, params[i])
    let dstOff = valOff(&em.*, params[i])
    if !dstKind.isUnit() && (dstReg != X86Frame.regNone() || dstXmm != X86Frame.regNone() || dstOff != 0) {
      run copyValueToMem(&mut em.*, function, args[i], dstKind, X86Encode.rsp(), offs[i])
    }
    i = i + usize.ONE
  }
  // Pass 2: copy every staged value into its parameter's register or stack home slot.
  i = usize.ZERO
  while i < args.length {
    let dstKind = function.value(params[i]).kind
    let dstReg = valReg(&em.*, params[i])
    let dstXmm = valXmm(&em.*, params[i])
    let dstOff = valOff(&em.*, params[i])
    if !dstKind.isUnit() && (dstReg != X86Frame.regNone() || dstXmm != X86Frame.regNone() || dstOff != 0) {
      if dstReg != X86Frame.regNone() {
        drop run X86Encode.movRm64(&mut em.code, dstReg, Mem.baseDisp(X86Encode.rsp(), offs[i]))
      } else if dstXmm != X86Frame.regNone() {
        if dstKind.isVector() && dstKind.storeSize() == 32 && hasAvx2 {
          drop run X86Encode.vmovdquYmmRm(&mut em.code, dstXmm, Mem.baseDisp(X86Encode.rsp(), offs[i]))
        } else if dstKind.isVector() {
          drop run X86Encode.movdquRm(&mut em.code, dstXmm, Mem.baseDisp(X86Encode.rsp(), offs[i]))
        } else if dstKind.bits == 64 {
          drop run X86Encode.movsdRm(&mut em.code, dstXmm, Mem.baseDisp(X86Encode.rsp(), offs[i]))
        } else {
          drop run X86Encode.movssRm(&mut em.code, dstXmm, Mem.baseDisp(X86Encode.rsp(), offs[i]))
        }
      } else {
        let mut handledSmallVec = false
        if dstKind.isVector() {
          let vsz = dstKind.storeSize()
          if vsz == 1 || vsz == 2 || vsz == 4 || vsz == 8 {
            let stMem = Mem.baseDisp(X86Encode.rsp(), offs[i])
            if vsz == 1 { drop run X86Encode.movzxRm8(&mut em.code, X86Encode.rax(), stMem) }
            else if vsz == 2 { drop run X86Encode.movzxRm16(&mut em.code, X86Encode.rax(), stMem) }
            else if vsz == 4 { drop run X86Encode.movRm32(&mut em.code, X86Encode.rax(), stMem) }
            else { drop run X86Encode.movRm64(&mut em.code, X86Encode.rax(), stMem) }
            run storeSmallVecMem(&mut em.*, vsz, Mem.baseDisp(X86Encode.rbp(), dstOff), X86Encode.rax())
            handledSmallVec = true
          }
        }
        if !handledSmallVec {
          let sz = X86Frame.valueSlotBytes(dstKind)
          if sz == 8 {
            drop run X86Encode.movRm64(&mut em.code, X86Encode.rax(), Mem.baseDisp(X86Encode.rsp(), offs[i]))
            drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff), X86Encode.rax())
          } else if sz == 16 {
            drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(X86Encode.rsp(), offs[i]))
            drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff), 0)
          } else if sz == 32 {
            if hasAvx2 {
              drop run X86Encode.vmovdquYmmRm(&mut em.code, 0, Mem.baseDisp(X86Encode.rsp(), offs[i]))
              drop run X86Encode.vmovdquYmmMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff), 0)
            } else {
              drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(X86Encode.rsp(), offs[i]))
              drop run X86Encode.movdquRm(&mut em.code, 1, Mem.baseDisp(X86Encode.rsp(), offs[i] + 16))
              drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff), 0)
              drop run X86Encode.movdqaMr(&mut em.code, Mem.baseDisp(X86Encode.rbp(), dstOff + 16), 1)
            }
          } else {
            drop run X86Encode.lea64(&mut em.code, X86Encode.rsi(), Mem.baseDisp(X86Encode.rsp(), offs[i]))
            drop run X86Encode.lea64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(X86Encode.rbp(), dstOff))
            run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), usize.toU64(sz))
            run X86Encode.repMovsb(&mut em.code)
          }
        }
      }
    }
    i = i + usize.ONE
  }
  return run X86Encode.aluRi64(&mut em.code, Alu.Add, X86Encode.rsp(), u64.wrappingToI32(totalStage))
}

effect fn copyValueToParam(em: &mut Emitter, function: &SsaFunction, src: u64, dstParam: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let kind = function.value(dstParam).kind
  if kind.isUnit() { return () }
  let dstReg = valReg(&em.*, dstParam)
  if dstReg != X86Frame.regNone() {
    if function.value(src).definition != Definition.Constant && valReg(&em.*, src) == dstReg {
      return ()
    }
    return run loadGp(&mut em.*, function, src, dstReg)
  }
  let dstXmm = valXmm(&em.*, dstParam)
  if dstXmm != X86Frame.regNone() {
    if function.value(src).definition != Definition.Constant && valXmm(&em.*, src) == dstXmm {
      return ()
    }
    if kind.isVector() {
      if kind.storeSize() == 32 && hasFeat(&em.*, X86Frame.featAvx2()) {
        return run loadVec256(&mut em.*, function, src, dstXmm)
      }
      return run loadVec128(&mut em.*, function, src, dstXmm)
    }
    return run loadFloat(&mut em.*, function, src, dstXmm, X86Encode.rax())
  }
  let dstOff = valOff(&em.*, dstParam)
  if dstOff == 0 { return () }
  if function.value(src).definition != Definition.Constant && valReg(&em.*, src) == X86Frame.regNone() && valXmm(&em.*, src) == X86Frame.regNone() && valOff(&em.*, src) == dstOff {
    return ()
  }
  return run copyValueToMem(&mut em.*, function, src, kind, X86Encode.rbp(), dstOff)
}

effect fn copyValueToMem(em: &mut Emitter, function: &SsaFunction, src: u64, kind: Kind, baseReg: u8, disp: i32) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if kind.isVector() {
    let sz = kind.storeSize()
    if sz == usize.ZERO { return () }
    if sz == 16 {
      let srcXmm = run xmmOrLoadVec128(&mut em.*, function, src, 0)
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(baseReg, disp), srcXmm)
      return ()
    }
    if sz == 32 {
      if hasFeat(&em.*, X86Frame.featAvx2()) && kind.isInteger() {
        let srcYmm = run ymmOrLoadVec256(&mut em.*, function, src, 0)
        drop run X86Encode.vmovdquYmmMr(&mut em.code, Mem.baseDisp(baseReg, disp), srcYmm)
        return ()
      }
      run vectorAddr(&mut em.*, function, src, X86Encode.r10())
      drop run X86Encode.movdquRm(&mut em.code, 0, Mem.baseDisp(X86Encode.r10(), 0))
      drop run X86Encode.movdquRm(&mut em.code, 1, Mem.baseDisp(X86Encode.r10(), 16))
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(baseReg, disp), 0)
      drop run X86Encode.movdquMr(&mut em.code, Mem.baseDisp(baseReg, disp + 16), 1)
      return ()
    }
    if sz == 1 || sz == 2 || sz == 4 || sz == 8 {
      run loadSmallVecGp(&mut em.*, function, src, X86Encode.rax())
      return run storeSmallVecMem(&mut em.*, sz, Mem.baseDisp(baseReg, disp), X86Encode.rax())
    }
    run vectorAddr(&mut em.*, function, src, X86Encode.rsi())
    drop run X86Encode.lea64(&mut em.code, X86Encode.rdi(), Mem.baseDisp(baseReg, disp))
    run X86Encode.movImm64(&mut em.code, X86Encode.rcx(), usize.toU64(sz))
    return run X86Encode.repMovsb(&mut em.code)
  }
  if kind.isFloat() {
    let homeXmm = if function.value(src).definition != Definition.Constant { valXmm(&em.*, src) } else { X86Frame.regNone() }
    let srcXmm = if homeXmm != X86Frame.regNone() { homeXmm } else { 0 }
    if homeXmm == X86Frame.regNone() {
      run loadFloat(&mut em.*, function, src, 0, X86Encode.rax())
    }
    if kind.bits == 64 { drop run X86Encode.movsdMr(&mut em.code, Mem.baseDisp(baseReg, disp), srcXmm) }
    else { drop run X86Encode.movssMr(&mut em.code, Mem.baseDisp(baseReg, disp), srcXmm) }
    return ()
  }
  if kind.bits > 64 {
    run loadPair(&mut em.*, function, src, X86Encode.rax(), X86Encode.rdx())
    drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(baseReg, disp), X86Encode.rax())
    drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(baseReg, disp + 8), X86Encode.rdx())
    return ()
  }
  let srcReg = run regOrLoad(&mut em.*, function, src, X86Encode.rax())
  drop run X86Encode.movMr64(&mut em.code, Mem.baseDisp(baseReg, disp), srcReg)
  return ()
}

fn alignI32(value: i32, align: i32) -> i32 {
  if align <= 1 { return value }
  let rem = value % align
  if rem == 0 { return value }
  return value + (align - rem)
}

fn alignUpU64(value: u64, align: u64) -> u64 {
  if align <= 1 { return value }
  let rem = value % align
  if rem == 0 { return value }
  return value + (align - rem)
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}
