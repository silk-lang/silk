//! The codegen units one assembled module splits into: a unit holds some definitions, so each
//! compiles to an object of its own and an edit recompiles only the units whose fragments changed.
//! What a unit's definitions use from other units stays a use, which its bitcode declares.
import semantic.ContentHash {ContentHash}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}

/// One codegen unit's fragments: `head` and then the body, its definitions.
pub struct CodegenUnit {
  /// The package that defines these functions; generic instances retain their declaration's owner.
  pub owner: Bytes,
  /// The defining package's backend optimization; absent uses the compilation's flags.
  pub optimization: Option<Bytes>,
  /// The defining package's debug-information setting; absent uses the compilation's flags.
  pub debug: Option<bool>,
  /// The unit's shared head: target personality, foreign declarations, and runtime helper
  /// declarations, or for the dedicated runtime unit, the shared runtime helper definitions.
  pub head: Bytes,
  /// The body; empty when `stored` or for the dedicated runtime unit.
  pub body: Bytes,
  /// The digest of the body's bytes.
  pub digest: ContentHash,
  /// For a build with line tables, a digest of where the declarations of the body's definitions
  /// start in their sources, which the body's markers are counted from and its object's line
  /// tables are written with; zero for any other unit.
  pub origins: ContentHash,
  /// Whether the body is the stored pack named `digest`, which the build left unread because no
  /// definition in it changed.
  pub stored: bool,
  /// For a release unit (`ReleaseUnits`), the content-named functions it defines that other units
  /// call, one per line; every other content-named function it defines is internal. `None` for a
  /// unit whose definitions all stay external.
  pub exports: Option<Bytes>,
}
