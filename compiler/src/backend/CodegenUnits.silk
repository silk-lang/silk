//! The codegen units one assembled module splits into: a unit holds some definitions, so each
//! compiles to an object of its own and an edit recompiles only the units whose fragments changed.
//! What a unit's definitions use from other units stays a use, which its bitcode declares.
import semantic.ContentHash {ContentHash}
import silk.collections.bytes {Bytes}

/// One codegen unit's fragments: `head` and then the body, its definitions.
pub struct CodegenUnit {
  /// The target's shared definitions and the declarations of the foreign functions and objects.
  pub head: Bytes,
  /// The body; empty when `stored`.
  pub body: Bytes,
  /// The digest of the body's bytes.
  pub digest: ContentHash,
  /// Whether the body is the stored pack named `digest`, which the build left unread because no
  /// definition in it changed.
  pub stored: bool,
}
