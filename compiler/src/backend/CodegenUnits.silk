//! The text helpers that split one assembled LLVM module into codegen units: a unit holds some
//! definitions and declares what it calls in the others, so each compiles to an object of its own
//! and an edit recompiles only the units whose text changed.
import semantic.ContentHash {ContentHash}
import semantic.InternIndex {InternIndex}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.list {List}
import silk.slice {Slice}
import silk.usize

/// One codegen unit's module text: `head` and then the body, its definitions.
pub struct CodegenUnit {
  /// The target header, and the declarations of what the body names in other units.
  pub head: Bytes,
  /// The body; empty when `stored`.
  pub body: Bytes,
  /// The digest of the body's bytes.
  pub digest: ContentHash,
  /// Whether the body is the stored pack named `digest`, which the build left unread because no
  /// definition in it changed.
  pub stored: bool,
}

/// A function one definition text defines: its symbol as written after `@`, and the `declare`
/// line another unit names it by.
pub struct Defined {
  pub symbol: Bytes,
  pub declaration: Bytes,
}

// Whether `byte` continues an unquoted LLVM identifier.
fn identifierByte(byte: u8) -> bool {
  return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57)
    || byte == 95 || byte == 46 || byte == 36 || byte == 45
}

/// The end of the global name that starts at `text[at]`, the byte after `@`: past the closing
/// quote of a quoted name, else past its identifier bytes.
pub fn nameEnd(text: &[u8], at: usize) -> usize {
  let mut end = at
  if end < text.length && text[end] == 34 {
    end = end + usize.ONE
    while end < text.length && text[end] != 34 { end = end + usize.ONE }
    if end < text.length { end = end + usize.ONE }
    return end
  }
  while end < text.length && identifierByte(text[end]) { end = end + usize.ONE }
  return end
}

fn startsWith(text: &[u8], at: usize, prefix: &[u8]) -> bool {
  if at + prefix.length > text.length { return false }
  let mut offset = usize.ZERO
  while offset < prefix.length {
    if text[at + offset] != prefix[offset] { return false }
    offset = offset + usize.ONE
  }
  return true
}

/// Each externally visible function that `definition`, one instance's complete text, defines,
/// with the `declare` line for it: the `define` line up to the end of its parameter list. A local
/// (`internal` or `private`) function is left out, since only its own text names it.
pub effect fn defined(definition: &[u8]) -> List<Defined> ! OutOfMemoryError ? &mut Allocator {
  let mut found = List<Defined>.make()
  let mut line = usize.ZERO
  while line < definition.length {
    if startsWith(definition, line, b"define ") && !startsWith(definition, line + 7, b"internal ")
      && !startsWith(definition, line + 7, b"private ") {
      let mut at = line + 7
      while at < definition.length && definition[at] != 64 && definition[at] != 10 { at = at + usize.ONE }
      if at < definition.length && definition[at] == 64 {
        let end = nameEnd(definition, at + usize.ONE)
        // The parameter list follows the name; a quoted attribute value may hold parentheses.
        let mut close = end
        let mut depth = usize.ZERO
        let mut quoted = false
        while close < definition.length && definition[close] != 10 {
          let byte = definition[close]
          if byte == 34 { quoted = !quoted }
          else if !quoted && byte == 40 { depth = depth + usize.ONE }
          else if !quoted && byte == 41 {
            depth = depth - usize.ONE
            if depth == usize.ZERO { break }
          }
          close = close + usize.ONE
        }
        if close < definition.length && definition[close] == 41 {
          let mut declaration = run Bytes.copy(b"declare ")
          run Bytes.append(&mut declaration, Slice.view<u8>(definition, line + 7, close + usize.ONE - (line + 7)))
          run Bytes.append(&mut declaration, b"\n")
          let symbol = run Bytes.copy(Slice.view<u8>(definition, at + usize.ONE, end - at - usize.ONE))
          run List<Defined>.append(&mut found, Defined {symbol: move symbol, declaration: move declaration})
        }
      }
    }
    while line < definition.length && definition[line] != 10 { line = line + usize.ONE }
    line = line + usize.ONE
  }
  return move found
}

/// Each global name `body` writes after `@`, once, in the order it first writes them. A string
/// constant may hold `@`, as `c"ptr @"` does, and names nothing; a quoted global name is read whole
/// by `nameEnd`, so every other quote opens or closes a constant.
pub effect fn names(body: &[u8]) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut found = List<Bytes>.make()
  let mut lookup = InternIndex.make()
  let mut scan = usize.ZERO
  let mut constant = false
  while scan < body.length {
    if body[scan] == 34 { constant = !constant }
    if constant || body[scan] != 64 {
      scan = scan + usize.ONE
      continue
    }
    let end = nameEnd(body, scan + usize.ONE)
    let name = Slice.view<u8>(body, scan + usize.ONE, end - scan - usize.ONE)
    scan = end
    let hash = InternIndex.hashBytes(0, name)
    let mut seen = InternIndex.first(&lookup, hash)
    while seen != usize.MAX && !same(Bytes.asSlice(&List<Bytes>.asSlice(&found)[seen]), name) { seen = InternIndex.after(&lookup, seen) }
    if seen == usize.MAX {
      run InternIndex.record(&mut lookup, hash)
      run List<Bytes>.append(&mut found, run Bytes.copy(name))
    }
  }
  return move found
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}
