//! C calling conventions for scalars, pointers, vectors and C-layout records.

import semantic.Types {Types}
import backend.Layout {Abi, Metrics, Layout, Storage, Field}
import backend.TypeLayouts {TypeLayouts}
import semantic.DeclarationId {DeclarationId}
import semantic.Target {Id, Target}
import semantic.Type {Type}
import semantic.ForeignContract {ForeignContract}
import semantic.RuntimeEncoding
import backend.Gap {Source as GapSource}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.mem.shared {Shared}
import silk.num.usize
import silk.collections.list {List}
import silk.core.ownership {Copy}

/// The caller or callee must extend this lane to the target's argument register width.
pub enum Extension {
  None,
  Signed,
  Unsigned,
}

// Ordinary C data pointers are opaque ABI lanes. A callback pointer additionally carries its
// exact source-level function/behavior contract; identical ptr text must not erase that contract.
effect fn callbackIdentity(output: &mut Bytes, ty: &Shared<Type>, owner: &DeclarationId) -> ()
! OutOfMemoryError ? &mut Allocator {
  let callback = Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
    return match &value.* { Type.ForeignFunction {..} => true _ => false }
  })
  if callback {
    run RuntimeEncoding.word(&mut output.*, 1)
    let encoded = run Type.runtimeEncoding(ty, owner)
    run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&encoded))
  } else { run RuntimeEncoding.word(&mut output.*, 0) }
  return ()
}

/// Closed semantic contract identity without source declaration names or authored spans.
pub effect fn identity(signature: &Signature) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut output = Bytes.make()
  run RuntimeEncoding.word(&mut output, ForeignContract.code(signature.behavior))
  run RuntimeEncoding.field(&mut output, Bytes.asSlice(&signature.callbackContracts))
  run RuntimeEncoding.field(&mut output, Bytes.asSlice(&signature.importModule))
  run RuntimeEncoding.field(&mut output, Bytes.asSlice(&signature.importName))
  let mut global: u64 = 0
  let mut variadic: u64 = 0
  if signature.global { global = 1 }
  if signature.variadic { variadic = 1 }
  run RuntimeEncoding.word(&mut output, global)
  run RuntimeEncoding.word(&mut output, variadic)
  let owner = DeclarationId.copyShared(&signature.declaration)
  run callbackIdentity(&mut output, &signature.result.ty, &owner)
  let parameters = List<Lane>.asSlice(&signature.parameters)
  run RuntimeEncoding.word(&mut output, usize.toU64(parameters.length))
  let mut at = usize.ZERO
  while at < parameters.length {
    run callbackIdentity(&mut output, &parameters[at].ty, &owner)
    at = at + usize.ONE
  }
  let noCapture = List<usize>.asSlice(&signature.noCapture)
  run RuntimeEncoding.word(&mut output, usize.toU64(noCapture.length))
  at = usize.ZERO
  while at < noCapture.length {
    run RuntimeEncoding.word(&mut output, usize.toU64(noCapture[at]))
    at = at + usize.ONE
  }
  return move output
}

/// The representation of one source value at a C function boundary.
pub enum Passing {
  /// One scalar, pointer or vector register value.
  Direct,
  /// One or more register values reconstructed from record storage.
  Coerce,
  /// An address of record storage, with a caller copy for arguments.
  Indirect,
  /// An empty record contributes no machine value.
  Ignore,
}

/// One register value and its byte offset in a C-layout record.
pub struct Piece {
  /// The byte offset in the source record.
  pub offset: usize,
  /// The scalar register class, or the element class of a vector.
  pub abi: Abi,
  /// The scalar or vector element width in bits.
  pub bits: usize,
  /// The vector element count; zero denotes a scalar.
  pub lanes: usize,
}

impl Copy for Piece {}

/// A source value's demanded layout and complete C passing rule.
pub struct Lane {
  pub ty: Shared<Type>,
  pub layout: Metrics,
  pub extension: Extension,
  /// Whether the value crosses in registers, through memory, or has no machine value.
  pub passing: Passing,
  /// Register pieces in storage order for a coerced record.
  pub pieces: List<Piece>,
  /// Whether record arguments keep their pieces in one homogeneous machine aggregate.
  pub grouped: bool,
  /// Whether an indirect argument uses the target's stack-by-value convention.
  pub byval: bool,
  /// Required stack alignment of an aggregate argument; zero means no extra attribute.
  pub stackAlignment: usize,
}

/// The complete machine signature of one foreign declaration, independent of LLVM spelling.
pub struct Signature {
  pub behavior: ForeignContract,
  /// Canonical parameter/field ordinal paths and callback signatures, including by-value structs.
  pub callbackContracts: Bytes,
  pub noCapture: List<usize>,
  pub declaration: Shared<DeclarationId>,
  pub symbol: Bytes,
  /// The external module and member for a named-module import; empty for ordinary C linkage.
  pub importModule: Bytes,
  pub importName: Bytes,
  pub source: GapSource,
  /// A function's result lane, or the value lane a C object's address holds.
  pub result: Lane,
  pub parameters: List<Lane>,
  /// Whether an imported function accepts scalar or raw-pointer tails after these fixed parameters.
  pub variadic: bool,
  /// Whether the symbol names a C object (`static`) rather than a function.
  pub global: bool,
}

/// A checked call-local tail before and after C default argument promotion.
pub struct VariadicArgument {
  pub sourceType: Shared<Type>,
  pub promotedType: Shared<Type>,
}

/// The scalar and raw-pointer unnamed-argument subset. Fixed C parameters use `admit` instead.
pub fn admitsVariadic(ty: &Type) -> bool {
  if let Type.Pointer {..} = &ty.* { return true }
  if let Type.Primitive {name} = &ty.* {
    let text = Bytes.asSlice(&name)
    return named(text, b"i8") || named(text, b"u8") || named(text, b"i16") || named(text, b"u16")
      || named(text, b"i32") || named(text, b"u32") || named(text, b"i64") || named(text, b"u64")
      || named(text, b"isize") || named(text, b"usize") || named(text, b"f32") || named(text, b"f64")
  }
  return false
}

fn narrowVariadic(ty: &Type) -> bool {
  if let Type.Primitive {name} = &ty.* {
    let text = Bytes.asSlice(&name)
    return named(text, b"i8") || named(text, b"u8") || named(text, b"i16") || named(text, b"u16")
  }
  return false
}

fn singleVariadic(ty: &Type) -> bool {
  if let Type.Primitive {name} = &ty.* { return named(Bytes.asSlice(&name), b"f32") }
  return false
}

/// Promotes narrow integers to signed C int and f32 to f64; other admitted tails retain their exact type.
pub effect fn promoteVariadic(ty: &Shared<Type>) -> Option<VariadicArgument>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !Shared<Type>.with<bool>(ty, admitsVariadic) { return Option<VariadicArgument>.none() }
  let mut promoted = Shared<Type>.clone(ty)
  if Shared<Type>.with<bool>(ty, narrowVariadic) {
    promoted = run Types.intern(Type.Primitive {name: run Bytes.copy(b"i32")})
  } else if Shared<Type>.with<bool>(ty, singleVariadic) {
    promoted = run Types.intern(Type.Primitive {name: run Bytes.copy(b"f64")})
  }
  return Option<VariadicArgument>.some(VariadicArgument {
    sourceType: Shared<Type>.clone(ty), promotedType: move promoted,
  })
}

fn variadicCount(arguments: &List<VariadicArgument>) -> usize {
  return List<VariadicArgument>.length(arguments)
}

/// Copies immutable evidence while releasing its shared list borrow before allocating.
pub effect fn copySharedVariadic(arguments: &Shared<List<VariadicArgument>>) -> List<VariadicArgument>
! OutOfMemoryError ? &mut Allocator {
  let count = Shared<List<VariadicArgument>>.with<usize>(arguments, variadicCount)
  let mut copied = List<VariadicArgument>.make()
  let mut at = usize.ZERO
  while at < count {
    let entry = Shared<List<VariadicArgument>>.with<VariadicArgument>(arguments,
      fn(listed: &List<VariadicArgument>) -> VariadicArgument {
        let values = List<VariadicArgument>.asSlice(listed)
        return VariadicArgument {
          sourceType: Shared<Type>.clone(&values[at].sourceType),
          promotedType: Shared<Type>.clone(&values[at].promotedType),
        }
      })
    run List<VariadicArgument>.append(&mut copied, move entry)
    at = at + usize.ONE
  }
  return move copied
}

/// Independently authenticates retained promotion evidence against the actual operand type.
pub effect fn validVariadic(argument: &VariadicArgument, actual: &Shared<Type>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !(run Type.equalsShared(&argument.sourceType, actual)) { return false }
  let expected = run promoteVariadic(actual)
  if let Option<VariadicArgument>.Some {value: prescribed} = move expected {
    return run Type.equalsShared(&argument.promotedType, &prescribed.promotedType)
  }
  return false
}

/// C calls are covered on these targets.
pub fn supported(target: &Target) -> bool {
  return match Target.id(target) {
    Id.X8664UnknownLinuxGnu => true
    Id.X8664PcWindowsMsvc => true
    Id.Aarch64AppleDarwin => true
    Id.Aarch64UnknownLinuxGnu => true
    Id.Wasm32UnknownUnknown => true
    Id.Wasm32Wasip1 => true
    Id.Wasm32Wasip2 => true
  }
}

/// Whether the target admits C statics and variadic tails.
/// WebAssembly supports fixed calls and callbacks but excludes these additional contracts.
pub fn fullBoundary(target: &Target) -> bool {
  return match Target.id(target) {
    Id.Wasm32UnknownUnknown => false
    Id.Wasm32Wasip1 => false
    Id.Wasm32Wasip2 => false
    _ => true
  }
}

/// Whether a narrow integer lane is extended to 32 bits at the boundary. The SysV x86-64, Apple
/// arm64 and WebAssembly C ABIs require it. AAPCS64 and Win64 leave the upper bits unspecified.
pub fn extendsNarrowIntegers(target: &Target) -> bool {
  return match Target.id(target) {
    Id.Aarch64UnknownLinuxGnu => false
    Id.X8664PcWindowsMsvc => false
    _ => true
  }
}

fn named(actual: &[u8], expected: &[u8]) -> bool {
  if actual.length != expected.length {
    return false
  }
  let mut at = usize.ZERO
  while at < actual.length {
    if actual[at] != expected[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// Checks the closed immediate C-call subset before asking for its representation.
/// Unit is admitted as a result; parameter validation excludes it separately.
pub fn admit(ty: &Type) -> bool {
  return match & ty.* {
    Type.Unit => true
    Type.ForeignFunction {signature, ..} => Shared<Type>.with<bool>(&signature, fn(contract: &Type) -> bool {
      if let Type.Callable {invocationBinders, parameters, result, ..} = &contract.* {
        if invocationBinders != usize.ZERO || !Shared<Type>.with<bool>(&result, callbackScalar) { return false }
        let listed = List<Shared<Type>>.asSlice(&parameters)
        let mut at = usize.ZERO
        while at < listed.length {
          if !Shared<Type>.with<bool>(&listed[at], admitsCallbackParameter) { return false }
          at = at + usize.ONE
        }
        return true
      }
      return false
    })
    Type.Pointer {..} => true
    // Semantic admission proves that a nominal lane is a C-layout struct.
    Type.Nominal {..} => true
    Type.Vector {..} => vectorLaneBits(ty) != usize.ZERO
    Type.Primitive {name} => {
      let spelling = Bytes.asSlice(&name)
      return named(spelling, b"i8") || named(spelling, b"u8") || named(spelling, b"i16") || named(
        spelling,
        b"u16",
      ) || named(spelling, b"i32") || named(spelling, b"u32") || named(spelling, b"i64") || named(
        spelling,
        b"u64",
      ) || named(spelling, b"isize") || named(spelling, b"usize") || named(spelling, b"f32") || named(
        spelling,
        b"f64",
      )
    }
    _ => false
  }
}

// Semantic admission also authenticates every nominal callback lane's C-layout declaration.
fn callbackScalar(ty: &Type) -> bool {
  return match &ty.* { Type.ForeignFunction {..} => false Type.Vector {..} => false _ => admit(ty) }
}

/// The lane width in bits of a vector the C boundary admits: fixed-width integer and
/// floating-point lanes, as C vector types have. Zero for any other type, a mask among them.
pub fn vectorLaneBits(ty: &Type) -> usize {
  if let Type.Vector {element, ..} = &ty.* {
    return Shared<Type>.with<usize>(&element, fn(lane: &Type) -> usize {
      if let Type.Primitive {name} = &lane.* {
        let text = Bytes.asSlice(&name)
        if named(text, b"i8") || named(text, b"u8") { return 8 }
        if named(text, b"i16") || named(text, b"u16") { return 16 }
        if named(text, b"i32") || named(text, b"u32") || named(text, b"f32") { return 32 }
        if named(text, b"i64") || named(text, b"u64") || named(text, b"f64") { return 64 }
      }
      return usize.ZERO
    })
  }
  return usize.ZERO
}

/// The width in bits of a vector the C boundary admits, or zero.
pub fn vectorBits(ty: &Type) -> usize {
  let lane = vectorLaneBits(ty)
  if let Type.Vector {lanes, ..} = &ty.* {
    if let Option<usize>.Some {value: count} = move Type.extentValue(Bytes.asSlice(&lanes)) { return lane * count }
  }
  return usize.ZERO
}

/// Whether an admitted vector's lanes are floating point.
pub fn vectorFloating(ty: &Type) -> bool {
  if let Type.Vector {element, ..} = &ty.* {
    return Shared<Type>.with<bool>(&element, fn(lane: &Type) -> bool {
      if let Type.Primitive {name} = &lane.* {
        let text = Bytes.asSlice(&name)
        return named(text, b"f32") || named(text, b"f64")
      }
      return false
    })
  }
  return false
}

/// The CPU feature the target's C compilers need to pass a vector of `bits` bits in one vector
/// register, or `None` when its C ABI has no vector of that width: 128 bits on x86-64 (SSE2,
/// always present), 256 with AVX and 512 with AVX-512F; 64 and 128 bits on AArch64 (NEON); 128
/// bits on wasm32 with `simd128` (SIMD-010).
pub fn vectorFeature(target: &Target, bits: usize) -> Option<&'static [u8]> {
  let id = Target.id(target)
  if id == Id.X8664PcWindowsMsvc { return Option<&'static [u8]>.none() }
  if id == Id.X8664UnknownLinuxGnu {
    if bits == 128 { return Option<&'static [u8]>.some(b"sse2") }
    if bits == 256 { return Option<&'static [u8]>.some(b"avx") }
    if bits == 512 { return Option<&'static [u8]>.some(b"avx512f") }
    return Option<&'static [u8]>.none()
  }
  if Target.pointerBits(target) == 32 {
    if bits == 128 { return Option<&'static [u8]>.some(b"simd128") }
    return Option<&'static [u8]>.none()
  }
  if bits == 64 || bits == 128 { return Option<&'static [u8]>.some(b"neon") }
  return Option<&'static [u8]>.none()
}
fn admitsCallbackParameter(ty: &Type) -> bool {
  return match &ty.* { Type.Unit => false _ => callbackScalar(ty) }
}

/// Computes the C ABI rule from a queried Layout, without inspecting a function body.
pub effect fn classify(ty: &Shared<Type>, layouts: &TypeLayouts, target: &Target, result: bool) -> Option<Lane>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !supported(target) || !Shared<Type>.with<bool>(ty, admit) {
    return Option<Lane>.none()
  }
  let index = run TypeLayouts.firstMatching(layouts, ty)
  if index == usize.MAX { return Option<Lane>.none() }
  let supplied = TypeLayouts.list(layouts)
  let layout = Shared<Layout>.with<Metrics>(&supplied[index].layout, Layout.metrics)
  // Win64 aggregate and vector boundaries need their own classifier; never use AAPCS64.
  if Target.id(target) == Id.X8664PcWindowsMsvc && (layout.abi == Abi.Indirect || layout.abi == Abi.Vector) {
    return Option<Lane>.none()
  }
  if layout.abi == Abi.Indirect { return run record(ty, layouts, target, layout, result) }
  let mut extension = Extension.None
  if layout.abi == Abi.Integer {
    let signed = Shared<Type>.with<bool>(
      ty,
      fn(value: &Type) -> bool {
        if let Type.Primitive {name} = &value.* {
          let text = Bytes.asSlice(&name)
          return text.length > usize.ZERO && text[usize.ZERO] == 105
        }
        return false
      },
    )
    if layout.size < 4 && extendsNarrowIntegers(target) {
      extension = Extension.Unsigned
      if signed {
        extension = Extension.Signed
      }
    }
  }
  return Option<Lane>.some(Lane {ty: Shared<Type>.clone(ty), layout: layout, extension: extension,
    passing: Passing.Direct, pieces: List<Piece>.make(), grouped: false, byval: false, stackAlignment: usize.ZERO})
}

// Stop once the classification cannot be homogeneous. Large arrays must not expand into a list
// proportional to their extent merely to establish that they cross through memory.
effect fn leaves(ty: &Shared<Type>, layouts: &TypeLayouts, offset: usize, limit: usize,
  output: &mut List<Piece>) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if List<Piece>.length(&output.*) >= limit { return true }
  let index = run TypeLayouts.firstMatching(layouts, ty)
  if index == usize.MAX { return false }
  let supplied = TypeLayouts.list(layouts)
  let selected = Shared<Layout>.clone(&supplied[index].layout)
  let facts = Shared<Layout>.with<Metrics>(&selected, Layout.metrics)
  if facts.size == usize.ZERO { return true }
  if facts.abi != Abi.Indirect {
    let mut bits = facts.size * 8
    let mut lanes = usize.ZERO
    let mut abi = facts.abi
    if abi == Abi.Vector {
      bits = Shared<Type>.with<usize>(ty, vectorLaneBits)
      if bits == usize.ZERO { return false }
      lanes = facts.size * 8 / bits
      abi = Abi.Integer
      if Shared<Type>.with<bool>(ty, vectorFloating) { abi = Abi.Floating }
    }
    if abi != Abi.Integer && abi != Abi.Floating && abi != Abi.Pointer { return false }
    run List<Piece>.append(&mut output.*, Piece {offset: offset, abi: abi, bits: bits, lanes: lanes})
    return true
  }
  let record = Shared<Layout>.with<bool>(&selected, fn(value: &Layout) -> bool {
    return match &value.storage { Storage.Record {..} => true Storage.Sequence {..} => true _ => false }
  })
  if !record { return false }
  let count = Shared<Layout>.with<usize>(&selected, Layout.fieldCount)
  let mut at = usize.ZERO
  while at < count && List<Piece>.length(&output.*) < limit {
    let child = Shared<Layout>.with<Option<Field>>(&selected, fn(value: &Layout) -> Option<Field> {
      return Layout.fieldAt(value, at)
    })
    if let Option<Field>.Some {value} = move child {
      if !(run leaves(&value.ty, layouts, offset + value.offset, limit, &mut output.*)) { return false }
    } else { return false }
    at = at + usize.ONE
  }
  return true
}

fn pieceBytes(piece: Piece) -> usize {
  if piece.lanes != usize.ZERO { return piece.bits * piece.lanes / 8 }
  return piece.bits / 8
}

effect fn record(ty: &Shared<Type>, layouts: &TypeLayouts, target: &Target, layout: Metrics, result: bool) -> Option<Lane>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let index = run TypeLayouts.firstMatching(layouts, ty)
  let supplied = TypeLayouts.list(layouts)
  if !Shared<Layout>.with<bool>(&supplied[index].layout, fn(value: &Layout) -> bool {
    return match &value.storage { Storage.Record {..} => true _ => false }
  }) { return Option<Lane>.none() }
  let id = Target.id(target)
  let x86 = id == Id.X8664UnknownLinuxGnu
  let wasm = Target.pointerBits(target) == 32
  let mut lane = Lane {ty: Shared<Type>.clone(ty), layout: layout, extension: Extension.None,
    passing: Passing.Indirect, pieces: List<Piece>.make(), grouped: false, byval: x86 || wasm, stackAlignment: layout.alignment}
  if x86 && lane.stackAlignment < 8 { lane.stackAlignment = 8 }
  if layout.size == usize.ZERO { lane.passing = Passing.Ignore return Option<Lane>.some(move lane) }
  let mut fields = List<Piece>.make()
  let mut limit: usize = 5
  if x86 { limit = 17 }
  if wasm { limit = 2 }
  if !(run leaves(ty, layouts, usize.ZERO, limit, &mut fields)) { return Option<Lane>.none() }
  let listed = List<Piece>.asSlice(&fields)
  if wasm {
    if listed.length == usize.ONE && listed[usize.ZERO].lanes == usize.ZERO {
      lane.passing = Passing.Coerce
      run List<Piece>.append(&mut lane.pieces, listed[usize.ZERO])
    }
    return Option<Lane>.some(move lane)
  }
  if !x86 {
    let mut homogeneous = listed.length > usize.ZERO && listed.length <= 4
    let mut at = usize.ZERO
    while at < listed.length && homogeneous {
      let part = listed[at]
      let first = listed[usize.ZERO]
      let floats = part.lanes == usize.ZERO && first.lanes == usize.ZERO
        && part.abi == Abi.Floating && first.abi == Abi.Floating && part.bits == first.bits
      // AAPCS64 short-vector base types are distinguished by their total size, not lane spelling.
      let vectors = part.lanes != usize.ZERO && first.lanes != usize.ZERO
        && pieceBytes(part) == pieceBytes(first) && (pieceBytes(part) == 8 || pieceBytes(part) == 16)
      homogeneous = (floats || vectors) && part.offset == at * pieceBytes(first)
      at = at + usize.ONE
    }
    if homogeneous && layout.size == listed.length * pieceBytes(listed[usize.ZERO]) {
      lane.passing = Passing.Coerce
      lane.grouped = !result
      lane.stackAlignment = usize.ZERO
      if id == Id.Aarch64UnknownLinuxGnu && !result {
        lane.stackAlignment = layout.alignment
        if lane.stackAlignment < 8 { lane.stackAlignment = 8 }
      }
      at = usize.ZERO
      while at < listed.length {
        let mut part = listed[usize.ZERO]
        part.offset = listed[at].offset
        run List<Piece>.append(&mut lane.pieces, part)
        at = at + usize.ONE
      }
      return Option<Lane>.some(move lane)
    }
    if layout.size <= 16 {
      lane.passing = Passing.Coerce
      lane.grouped = layout.size > 8
      lane.stackAlignment = usize.ZERO
      let mut offset = usize.ZERO
      while offset < layout.size {
        let mut bits: usize = 64
        if result && layout.size <= 8 { bits = layout.size * 8 }
        run List<Piece>.append(&mut lane.pieces, Piece {offset: offset, abi: Abi.Integer, bits: bits, lanes: usize.ZERO})
        offset = offset + 8
      }
    }
    return Option<Lane>.some(move lane)
  }
  // A lone vector has one SSE eightbyte followed by SSEUP eightbytes. With the required CPU
  // features, its entire 128-, 256- or 512-bit value occupies one vector register.
  if listed.length == usize.ONE && listed[usize.ZERO].lanes != usize.ZERO && layout.size == pieceBytes(listed[usize.ZERO]) {
    lane.passing = Passing.Coerce
    run List<Piece>.append(&mut lane.pieces, listed[usize.ZERO])
    return Option<Lane>.some(move lane)
  }
  if layout.size > 16 { return Option<Lane>.some(move lane) }
  let mut offset = usize.ZERO
  while offset < layout.size {
    let mut integer = false
    let mut double = false
    let mut used = usize.ZERO
    let mut at = usize.ZERO
    while at < listed.length {
      let part = listed[at]
      let end = part.offset + pieceBytes(part)
      if part.offset < offset + 8 && end > offset {
        if part.abi != Abi.Floating && part.lanes == usize.ZERO { integer = true }
        if part.lanes != usize.ZERO && pieceBytes(part) == 8 { double = true }
        if part.abi == Abi.Floating && part.bits == 64 { double = true }
        let mut extent = end - offset
        if extent > 8 { extent = 8 }
        if extent > used { used = extent }
      }
      at = at + usize.ONE
    }
    if used > usize.ZERO {
      let mut part = Piece {offset: offset, abi: Abi.Integer, bits: used * 8, lanes: usize.ZERO}
      if !integer {
        part.abi = Abi.Floating
        part.bits = 32
        if double { part.bits = 64 }
        else if used > 4 { part.lanes = 2 }
      }
      run List<Piece>.append(&mut lane.pieces, part)
    }
    offset = offset + 8
  }
  lane.passing = Passing.Coerce
  return Option<Lane>.some(move lane)
}

/// Applies SysV's all-or-memory rule when a record exceeds the remaining argument registers.
pub fn assignArguments(parameters: &mut List<Lane>, result: &Lane, target: &Target) -> () {
  if Target.id(target) != Id.X8664UnknownLinuxGnu { return () }
  let mut integers: usize = 6
  let mut vectors: usize = 8
  if result.passing == Passing.Indirect { integers = integers - usize.ONE }
  let listed = List<Lane>.asMutSlice(&mut parameters.*)
  let mut at = usize.ZERO
  while at < listed.length {
    let mut neededInteger = usize.ZERO
    let mut neededVector = usize.ZERO
    if listed[at].passing == Passing.Direct {
      let abi = listed[at].layout.abi
      if abi == Abi.Integer || abi == Abi.Pointer { neededInteger = usize.ONE }
      if abi == Abi.Floating || abi == Abi.Vector { neededVector = usize.ONE }
    } else if listed[at].passing == Passing.Coerce {
      let parts = List<Piece>.asSlice(&listed[at].pieces)
      let mut part = usize.ZERO
      while part < parts.length {
        if parts[part].abi == Abi.Floating || parts[part].lanes != usize.ZERO { neededVector = neededVector + usize.ONE }
        else { neededInteger = neededInteger + usize.ONE }
        part = part + usize.ONE
      }
      if neededInteger > integers || neededVector > vectors {
        listed[at].passing = Passing.Indirect
        listed[at].byval = true
        at = at + usize.ONE
        continue
      }
    }
    if neededInteger <= integers { integers = integers - neededInteger }
    if neededVector <= vectors { vectors = vectors - neededVector }
    at = at + usize.ONE
  }
  return ()
}
