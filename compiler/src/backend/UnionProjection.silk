//! Where each source member of a union is stored in an instance's canonical union layout.

import semantic.Types {Types}
import backend.RuntimeType
import backend.RuntimeType {Projection as RuntimeProjection}
import semantic.Type {Binding, Type}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.option {Option}
import silk.mem.frozen {Frozen}
import silk.num.usize
import silk.collections.list {List}

/// Source ordinals are chosen before substitutions or opaque realization can reorder storage.
/// Closed ordinary unions retain their canonical ordinals; unresolved unions use authored order.
/// An Effect join's ordinals are its alternatives in their recorded order.
pub effect fn members(source: &Frozen<Type>) -> Option<List<Frozen<Type>>>
! OutOfMemoryError ? &mut Allocator {
  let ordered = run Type.canonicalUnionMembers(source)
  if let Option<List<Frozen<Type>>>.Some {value} = move ordered {
    return Option<List<Frozen<Type>>>.some(move value)
  }
  return match move run Type.copy(source) {
    Type.Union {members: written} => Option<List<Frozen<Type>>>.some(move written)
    Type.EffectJoin {alternatives, ..} => Option<List<Frozen<Type>>>.some(move alternatives)
    _ => Option<List<Frozen<Type>>>.none()
  }
}

/// Where one original member of a union is stored in an instance.
///
/// Substitution and opaque realization normalize the instance's union again (UNION-001): members
/// that become equal share one stored member, and a member that becomes a union contributes each of
/// its own members. So several original members may share a placement, and every placement is
/// computed from the instance's canonical members alone.
pub union Placement {
  /// As the complete storage: the instance normalized the union to this member's own type, so a
  /// value of the member is already the instance's value.
  Whole,
  /// Under this tag of the instance's union storage, with the member's storage type.
  Tagged {pub tag: usize, pub ty: Frozen<Type>},
  /// The member is itself a union at this instance, a strict part of the storage: its canonical
  /// members, in their own canonical order, are stored under these tags.
  Spread {pub tags: List<usize>, pub ty: Frozen<Type>},
}

/// Where the source member `member` of the source union `source` is stored once `bindings` and
/// `projections` close both. Absent only when the closed storage does not contain the member, which
/// a checked program never reaches.
pub effect fn placement(source: &Frozen<Type>, member: &Frozen<Type>, bindings: &[Binding], projections: &[RuntimeProjection])
  -> Option<Placement> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let storage = run RuntimeType.applyBindings(source, bindings, projections)
  let projected = run RuntimeType.applyBindings(member, bindings, projections)
  return run within(&storage, &projected)
}

/// Where a value of type `member` is stored in a value of type `storage`, both closed instance
/// types. Absent when `storage` does not contain every value of `member`.
pub effect fn within(storage: &Frozen<Type>, member: &Frozen<Type>) -> Option<Placement>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if run Type.runtimeEqualsShared(member, storage) { return Option<Placement>.some(Placement.Whole) }
  let canonical = match move run Type.canonicalUnionMembers(storage) {
    Option<List<Frozen<Type>>>.Some {value} => move value
    _ => { return Option<Placement>.none() }
  }
  let physical = List<Frozen<Type>>.asSlice(&canonical)
  let tag = run tagOf(physical, member)
  if tag != usize.MAX {
    return Option<Placement>.some(Placement.Tagged {tag: tag, ty: Frozen<Type>.clone(&physical[tag])})
  }
  let narrower = match move run Type.canonicalUnionMembers(member) {
    Option<List<Frozen<Type>>>.Some {value} => move value
    _ => { return Option<Placement>.none() }
  }
  let parts = List<Frozen<Type>>.asSlice(&narrower)
  let mut tags = run List<usize>.makeWithCapacity(parts.length)
  let mut at = usize.ZERO
  while at < parts.length {
    let found = run tagOf(physical, &parts[at])
    if found == usize.MAX { return Option<Placement>.none() }
    run List<usize>.append(&mut tags, found)
    at = at + usize.ONE
  }
  return Option<Placement>.some(Placement.Spread {tags: move tags, ty: Frozen<Type>.clone(member)})
}

/// The storage tag of one canonical member, or `usize.MAX`.
pub effect fn tagOf(physical: &[Frozen<Type>], member: &Frozen<Type>) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut tag = usize.ZERO
  while tag < physical.length {
    if run Type.runtimeEqualsShared(member, &physical[tag]) { return tag }
    tag = tag + usize.ONE
  }
  return usize.MAX
}
