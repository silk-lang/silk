//! Source member ordinals mapped to one exact canonical physical union layout.

import backend.RuntimeType
import backend.RuntimeType {Projection as RuntimeProjection}
import semantic.Type {Binding, Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.option {Option}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// One original member's physical payload tag and storage type.
pub struct Member {
  pub tag: usize
  pub ty: Shared<Type>
}

/// Source ordinals are chosen before substitutions or opaque realization can reorder storage.
/// Closed ordinary unions retain their canonical ordinals; unresolved unions use authored order.
/// An Effect join's ordinals are its alternatives in their recorded order.
pub effect fn members(source: &Shared<Type>) -> Option<Vector<Shared<Type>>>
! OutOfMemoryError ? &mut Allocator {
  let ordered = run Type.canonicalUnionMembers(source)
  if let Option<Vector<Shared<Type>>>.Some {value} = move ordered {
    return Option<Vector<Shared<Type>>>.some(move value)
  }
  return match move run Type.copy(source) {
    Type.Union {members: written} => Option<Vector<Shared<Type>>>.some(move written)
    Type.EffectJoin {alternatives, ..} => Option<Vector<Shared<Type>>>.some(move alternatives)
    _ => Option<Vector<Shared<Type>>>.none()
  }
}

/// An injective map of every original source member onto the complete canonical storage set.
/// Absent for unresolved layouts or collapsed representations; no member or tag is invented.
pub effect fn map(source: &Shared<Type>, bindings: &[Binding], projections: &[RuntimeProjection])
  -> Option<Vector<Member>> ! OutOfMemoryError ? &mut Allocator {
  let original = match move run members(source) {
    Option<Vector<Shared<Type>>>.Some {value} => move value
    _ => { return Option<Vector<Member>>.none() }
  }
  let storage = run RuntimeType.applyBindings(source, bindings, projections)
  let canonical = match move run Type.canonicalUnionMembers(&storage) {
    Option<Vector<Shared<Type>>>.Some {value} => move value
    _ => { return Option<Vector<Member>>.none() }
  }
  let written = Vector<Shared<Type>>.asSlice(&original)
  let physical = Vector<Shared<Type>>.asSlice(&canonical)
  if written.length != physical.length { return Option<Vector<Member>>.none() }
  let mut output = Vector<Member>.make()
  let mut at = usize.ZERO
  while at < written.length {
    let projected = run RuntimeType.applyBindings(&written[at], bindings, projections)
    let mut tag = usize.ZERO
    while tag < physical.length {
      if run Type.equalsShared(&projected, &physical[tag]) { break }
      tag = tag + usize.ONE
    }
    if tag == physical.length { return Option<Vector<Member>>.none() }
    let previous = Vector<Member>.asSlice(&output)
    let mut scan = usize.ZERO
    while scan < previous.length {
      if previous[scan].tag == tag { return Option<Vector<Member>>.none() }
      scan = scan + usize.ONE
    }
    run Vector<Member>.append(&mut output, Member {tag: tag, ty: move projected})
    at = at + usize.ONE
  }
  return Option<Vector<Member>>.some(move output)
}

/// Resolves one ordinal only after the complete union map has been validated.
pub effect fn member(source: &Shared<Type>, ordinal: usize, bindings: &[Binding], projections: &[RuntimeProjection])
  -> Option<Member> ! OutOfMemoryError ? &mut Allocator {
  let mapped = match move run map(source, bindings, projections) {
    Option<Vector<Member>>.Some {value} => move value
    _ => { return Option<Member>.none() }
  }
  let listed = Vector<Member>.asSlice(&mapped)
  if ordinal >= listed.length { return Option<Member>.none() }
  return Option<Member>.some(Member {tag: listed[ordinal].tag, ty: Shared<Type>.clone(&listed[ordinal].ty)})
}

/// Where one injected original member is stored in an instance.
pub union Injection {
  /// Under this tag of the instance's union storage.
  Tagged {pub tag: usize},
  /// As the complete storage: substitution normalized the union to this member's own type
  /// (UNION-001), so the injected value is already the instance's value.
  Whole,
}

/// Resolves where one injected original member is stored.
///
/// Injection needs only that member's own placement. Substitution may collapse other members into
/// it or into each other (UNION-001) without moving where this member is stored, so this does not
/// require the complete injective map that payload access, match tags and cleanup use. A member
/// whose projection is neither the complete storage nor exactly one stored member, such as a
/// parameter bound to a union that the storage widens, has no single placement.
pub effect fn injection(source: &Shared<Type>, ordinal: usize, bindings: &[Binding], projections: &[RuntimeProjection])
  -> Option<Injection> ! OutOfMemoryError ? &mut Allocator {
  let original = match move run members(source) {
    Option<Vector<Shared<Type>>>.Some {value} => move value
    _ => { return Option<Injection>.none() }
  }
  let written = Vector<Shared<Type>>.asSlice(&original)
  if ordinal >= written.length { return Option<Injection>.none() }
  let storage = run RuntimeType.applyBindings(source, bindings, projections)
  let projected = run RuntimeType.applyBindings(&written[ordinal], bindings, projections)
  if run Type.equalsShared(&projected, &storage) { return Option<Injection>.some(Injection.Whole) }
  let canonical = match move run Type.canonicalUnionMembers(&storage) {
    Option<Vector<Shared<Type>>>.Some {value} => move value
    _ => { return Option<Injection>.none() }
  }
  let physical = Vector<Shared<Type>>.asSlice(&canonical)
  let mut tag = usize.ZERO
  while tag < physical.length {
    if run Type.equalsShared(&projected, &physical[tag]) { return Option<Injection>.some(Injection.Tagged {tag: tag}) }
    tag = tag + usize.ONE
  }
  return Option<Injection>.none()
}
