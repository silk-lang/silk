//! Each SSA optimization pass on hand-built functions: what it folds, merges, forwards, removes
//! or moves, and what it must leave alone because a trap, a call or an escaped address makes the
//! difference observable.

import backend.SsaControlFlow
import backend.SsaDeadCode
import backend.SsaFolding
import backend.SsaFunction {
  AbiExtension,
  ArchOperation,
  Binary,
  CallingConvention,
  Cast,
  Count,
  Edge,
  Exit,
  Extreme,
  Kind,
  MemoryEffect,
  Operation,
  ParameterAbi,
  Predicate,
  Reduction,
  SsaFunction,
  none,
}
import backend.SsaGraph {SsaGraph}
import backend.SsaIdioms
import backend.SsaInduction
import backend.SsaPackedBytes
import backend.SsaLoops
import backend.SsaMemory
import backend.SsaPipeline
import backend.SsaPipeline {Level}
import backend.SsaPromotion
import backend.SsaThreading
import backend.SsaUnroll
import backend.SsaValueNumbering
import backend.SsaWebs
import backend.SsaVerification
import backend.SsaVerification {Violation}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.testing.testing {AssertionError, Testing}
import silk.num.u64
import silk.num.usize

// The instructions a test counts.
enum Sort { Add, Divide, Load, Store, SlotAddress, Copy, CountedCopy, CountedFill, Call, Compare, Select, Cast, Overflow, Arch, Asm, SlotMarker, Any }


effect fn forwardWithGraph(function: &mut SsaFunction) -> bool ! OutOfMemoryError ? &mut Allocator {
  let graph = run SsaGraph.of(&function.*)
  return run SsaMemory.forward(&mut function.*, &graph)
}

effect fn numberWithGraph(function: &mut SsaFunction) -> bool ! OutOfMemoryError ? &mut Allocator {
  let graph = run SsaGraph.of(&function.*)
  return run SsaValueNumbering.number(&mut function.*, &graph)
}

effect fn eliminateWithGraph(function: &mut SsaFunction) -> bool ! OutOfMemoryError ? &mut Allocator {
  let graph = run SsaGraph.of(&function.*)
  return run SsaDeadCode.eliminate(&mut function.*, &graph)
}

effect fn promoteWithGraph(function: &mut SsaFunction, all: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let graph = run SsaGraph.of(&function.*)
  return run SsaPromotion.promote(&mut function.*, &graph, all)
}

effect fn scaleCountersWithGraph(function: &mut SsaFunction) -> bool ! OutOfMemoryError ? &mut Allocator {
  let graph = run SsaGraph.of(&function.*)
  return run SsaInduction.scaleCounters(&mut function.*, &graph)
}

effect fn pairIterationsWithGraph(function: &mut SsaFunction) -> bool ! OutOfMemoryError ? &mut Allocator {
  let graph = run SsaGraph.of(&function.*)
  return run SsaUnroll.pairIterations(&mut function.*, &graph)
}

effect fn rotateWithGraph(function: &mut SsaFunction) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut graph = run SsaGraph.of(&function.*)
  return run SsaInduction.rotate(&mut function.*, &mut graph)
}

effect fn lowerPackedBytesWithGraph(function: &mut SsaFunction) -> bool ! OutOfMemoryError ? &mut Allocator {
  let graph = run SsaGraph.of(&function.*)
  return run SsaPackedBytes.lower(&mut function.*, &graph)
}

fn sorted(operation: Operation, sort: Sort) -> bool {
  return match operation {
    Operation.Binary {operation: binary} => sort == Sort.Any || (sort == Sort.Add && binary == Binary.Add)
      || (sort == Sort.Divide && (binary == Binary.UDiv || binary == Binary.SDiv))
    Operation.Load {..} => sort == Sort.Any || sort == Sort.Load
    Operation.Store {..} => sort == Sort.Any || sort == Sort.Store
    Operation.SlotAddress {..} => sort == Sort.Any || sort == Sort.SlotAddress
    Operation.CopyBytes {..} => sort == Sort.Any || sort == Sort.Copy
    Operation.CopyCounted => sort == Sort.Any || sort == Sort.CountedCopy
    Operation.FillCounted => sort == Sort.Any || sort == Sort.CountedFill
    Operation.Call {..} => sort == Sort.Any || sort == Sort.Call
    Operation.Compare {..} => sort == Sort.Any || sort == Sort.Compare
    Operation.Select => sort == Sort.Any || sort == Sort.Select
    Operation.Cast {..} => sort == Sort.Any || sort == Sort.Cast
    Operation.Overflow {..} => sort == Sort.Any || sort == Sort.Overflow
    Operation.ArchIntrinsic {..} => sort == Sort.Any || sort == Sort.Arch
    Operation.InlineAsm {..} => sort == Sort.Any || sort == Sort.Asm
    Operation.SlotStart {..} => sort == Sort.Any || sort == Sort.SlotMarker
    Operation.SlotEnd {..} => sort == Sort.Any || sort == Sort.SlotMarker
    _ => sort == Sort.Any
  }
}

// How many instructions of `sort` the blocks of `function` hold, in `block` alone unless it is
// `usize.MAX`.
fn count(function: &SsaFunction, sort: Sort, block: usize) -> usize {
  let mut total = usize.ZERO
  let mut at = usize.ZERO
  while at < function.blockCount() {
    if block == usize.MAX || block == at {
      let listed = List<usize>.asSlice(&function.block(at).instructions)
      let mut position = usize.ZERO
      while position < listed.length {
        if sorted(function.instruction(listed[position]).operation, sort) { total = total + usize.ONE }
        position = position + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return total
}

effect fn wellFormed(function: &SsaFunction) -> bool ! OutOfMemoryError ? &mut Allocator {
  return !Option<Violation>.isSome(&(run SsaVerification.check(function)))
}

// The block ending in a return, or `usize.MAX`.
fn returning(function: &SsaFunction) -> usize {
  let mut at = usize.ZERO
  while at < function.blockCount() {
    if function.block(at).exit == Exit.Return { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

test effect fn foldsConstantsAndIdentities() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run foldingClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// `x + 0`, `x - x`, `6 * 7` at 8 bits, `x == x` and `(x + 0) * 1` fold; a division by zero and
// the signed minimum divided by -1 stay, so they still trap.
effect fn foldingClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"fold", 32)
  let int = Kind.integer(32)
  let x = run function.argument(int)
  function.setResult(int)
  let entry = run function.newBlock()
  function.startBlock(entry)
  let zero = run function.integer(32, 0)
  let one = run function.integer(32, 1)
  let same = run function.binary(Binary.Add, x, zero)
  let scaled = run function.binary(Binary.Mul, same, one)
  let nothing = run function.binary(Binary.Sub, scaled, x)
  let byteSix = run function.integer(8, 200)
  let byteSeven = run function.integer(8, 100)
  let wrapped = run function.binary(Binary.Add, byteSix, byteSeven)
  let widened = run function.cast(Cast.ZExt, wrapped, int)
  let equal = run function.compare(Predicate.Eq, x, x)
  let chosen = run function.select(equal, widened, x)
  let total = run function.binary(Binary.Add, chosen, nothing)
  let byZero = run function.binary(Binary.UDiv, x, zero)
  let minimum = run function.integer(32, 2147483648)
  let minusOne = run function.integer(32, 4294967295)
  let overflowing = run function.binary(Binary.SDiv, minimum, minusOne)
  let kept = run function.binary(Binary.Add, byZero, overflowing)
  let result = run function.binary(Binary.Add, total, kept)
  run function.ret(result)
  run function.finish()
  drop run numberWithGraph(&mut function)
  drop run eliminateWithGraph(&mut function)
  run Testing.expect(run wellFormed(&function), "the folded function passes the verifier")
  run Testing.expect(count(&function, Sort.Divide, usize.MAX) == 2, "a division by zero and the signed minimum by -1 are not folded")
  // 200 + 100 wraps to 44 at 8 bits; everything else folds away but the two divisions' sum.
  run Testing.expect(count(&function, Sort.Any, usize.MAX) == 4, "the identities and the 8-bit sum fold")
  let last = List<usize>.get(&function.block(usize.ZERO).instructions, 3)
  let operands = function.operandsOf(last)
  let mut wraps = false
  let mut at = usize.ZERO
  while at < operands.length {
    if function.isBits(operands[at]) && function.constantOf(operands[at]).low == 44 { wraps = true }
    at = at + usize.ONE
  }
  run Testing.expect(wraps, "the 8-bit sum wraps")
}

test effect fn numbersValuesAndDecidesChecks() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run numberingClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// `i < n` guards a block that checks `i >= n` again before an array access: the second check is
// decided and its trap path goes. Two equal sums are one; two equal loads stay two for this pass.
effect fn numberingClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"check", 32)
  let int = Kind.integer(32)
  let i = run function.argument(int)
  let n = run function.argument(int)
  let base = run function.argument(Kind.address(32))
  function.setResult(int)
  let entry = run function.newBlock()
  let inside = run function.newBlock()
  let trap = run function.newBlock()
  let safe = run function.newBlock()
  let outside = run function.newBlock()
  function.startBlock(entry)
  let below = run function.compare(Predicate.Ult, i, n)
  run function.branchIf(below, inside, outside)
  function.startBlock(inside)
  let beyond = run function.compare(Predicate.Uge, i, n)
  run function.branchIf(beyond, trap, safe)
  function.startBlock(trap)
  drop run function.call(b"report", &[], Kind.unit())
  run function.trap()
  function.startBlock(safe)
  let first = run function.binary(Binary.Add, i, n)
  let second = run function.binary(Binary.Add, n, i)
  let loaded = run function.load(int, base, 0, 4)
  let again = run function.load(int, base, 0, 4)
  let sum = run function.binary(Binary.Add, first, second)
  let loads = run function.binary(Binary.Add, loaded, again)
  let total = run function.binary(Binary.Add, sum, loads)
  run function.ret(total)
  function.startBlock(outside)
  run function.ret(i)
  run function.finish()
  drop run numberWithGraph(&mut function)
  run Testing.expect(run wellFormed(&function), "the numbered function passes the verifier")
  run Testing.expect(count(&function, Sort.Load, usize.MAX) == 2, "value numbering leaves loads alone")
  run Testing.expect(count(&function, Sort.Add, usize.MAX) == 4, "the commuted sum is the first one")
  drop run SsaControlFlow.simplify(&mut function)
  drop run eliminateWithGraph(&mut function)
  run Testing.expect(run wellFormed(&function), "the simplified function passes the verifier")
  run Testing.expect(count(&function, Sort.Call, usize.MAX) == usize.ZERO, "the decided check's trap path is gone")
  run Testing.expect(count(&function, Sort.Compare, usize.MAX) == usize.ONE, "only the first check is left")
  run Testing.expect(function.blockCount() == 3, "the checked block joins its guard")
}

test effect fn simplifiesControlFlow() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run controlClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A chain of jumps is one block, a branch on a constant drops the other arm, an edge skips an
// empty block and passes what that block would have, and a parameter given one value goes.
effect fn controlClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"flow", 32)
  let int = Kind.integer(32)
  let flag = run function.argument(Kind.flag())
  let x = run function.argument(int)
  function.setResult(int)
  let entry = run function.newBlock()
  let middle = run function.newBlock()
  let decided = run function.newBlock()
  let dead = run function.newBlock()
  let empty = run function.newBlock()
  let other = run function.newBlock()
  let join = run function.newBlock()
  let joined = run function.addParameter(join, int)
  let passed = run function.addParameter(empty, int)
  function.startBlock(entry)
  run function.jump(middle)
  function.startBlock(middle)
  let doubled = run function.binary(Binary.Add, x, x)
  let always = run function.flag(true)
  run function.branchIf(always, decided, dead)
  function.startBlock(dead)
  drop run function.call(b"never", &[], Kind.unit())
  run function.jumpWith(join, &[x])
  function.startBlock(decided)
  run function.branchWith(flag, empty, &[doubled], other, &[])
  function.startBlock(empty)
  run function.jumpWith(join, &[passed])
  function.startBlock(other)
  drop run function.call(b"side", &[], Kind.unit())
  run function.jumpWith(join, &[doubled])
  function.startBlock(join)
  run function.ret(joined)
  run function.finish()
  drop run SsaControlFlow.simplify(&mut function)
  run Testing.expect(run wellFormed(&function), "the simplified function passes the verifier")
  run Testing.expect(count(&function, Sort.Call, usize.MAX) == usize.ONE, "the arm a constant rules out is gone")
  // The entry, the jump chain and the decided branch are one block; the empty block is skipped.
  run Testing.expect(function.blockCount() == 3, "the chain is one block and the empty block is skipped")
  run Testing.expect(List<u64>.length(&function.block(returning(&function)).parameters) == usize.ZERO, "a join of one value takes no parameter")
}

test effect fn threadsBranchesOnJoinedConstants() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run threadClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// `a < b || b < c` as lowered: one path passes a true flag to the block that branches on the
// joined flag, the other a comparison. The path that knows the flag goes straight to the taken
// target, so the entry's first edge leads to the returning block and no block is left that only
// branches on a parameter.
effect fn threadClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"either", 32)
  let int = Kind.integer(32)
  let a = run function.argument(int)
  let b = run function.argument(int)
  let c = run function.argument(int)
  function.setResult(int)
  let entry = run function.newBlock()
  let second = run function.newBlock()
  let joined = run function.newBlock()
  let holds = run function.newBlock()
  let fails = run function.newBlock()
  let either = run function.addParameter(joined, Kind.flag())
  function.startBlock(entry)
  let first = run function.compare(Predicate.Ult, a, b)
  let yes = run function.flag(true)
  run function.branchWith(first, joined, &[yes], second, &[])
  function.startBlock(second)
  let other = run function.compare(Predicate.Ult, b, c)
  run function.jumpWith(joined, &[other])
  function.startBlock(joined)
  run function.branchIf(either, holds, fails)
  function.startBlock(holds)
  run function.ret(a)
  function.startBlock(fails)
  drop run function.call(b"act", &[], Kind.unit())
  run function.ret(b)
  run function.finish()
  drop run SsaControlFlow.simplify(&mut function)
  run Testing.expect(run wellFormed(&function), "the threaded function passes the verifier")
  let taken = List<Edge>.asSlice(&function.block(usize.ZERO).edges)[usize.ZERO].block
  run Testing.expect(function.block(taken).exit == Exit.Return && count(&function, Sort.Call, taken) == usize.ZERO,
    "the path that passes a true flag goes straight to the block the flag chooses")
  let mut parameters = usize.ZERO
  let mut at = usize.ZERO
  while at < function.blockCount() {
    parameters = parameters + List<u64>.length(&function.block(at).parameters)
    at = at + usize.ONE
  }
  run Testing.expect(parameters == usize.ZERO, "no block takes the joined flag any more")
}

test effect fn joinsBranchesIntoChosenValues() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run joinClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A branch whose two edges enter `joined` with `differing` pairs of different arguments, the
// first pair the constants 1 and 0, the second 0 and 1, the rest two arguments of the function.
effect fn joinedBranch(differing: usize) -> SsaFunction ! OutOfMemoryError ? &mut Allocator {
  let mut function = run SsaFunction.make(b"carry", 32)
  let int = Kind.integer(64)
  let a = run function.argument(int)
  let b = run function.argument(int)
  function.setResult(int)
  let entry = run function.newBlock()
  let joined = run function.newBlock()
  let mut parameters = List<u64>.make()
  let mut at = usize.ZERO
  while at < differing {
    run List<u64>.append(&mut parameters, run function.addParameter(joined, int))
    at = at + usize.ONE
  }
  function.startBlock(entry)
  let sum = run function.binary(Binary.Add, a, b)
  let carried = run function.compare(Predicate.Ult, sum, a)
  let one = run function.integer(64, 1)
  let zero = run function.integer(64, 0)
  let mut taken = List<u64>.make()
  let mut other = List<u64>.make()
  at = usize.ZERO
  while at < differing {
    if at == usize.ZERO {
      run List<u64>.append(&mut taken, one)
      run List<u64>.append(&mut other, zero)
    } else if at == usize.ONE {
      run List<u64>.append(&mut taken, zero)
      run List<u64>.append(&mut other, one)
    } else {
      run List<u64>.append(&mut taken, a)
      run List<u64>.append(&mut other, b)
    }
    at = at + usize.ONE
  }
  run function.branchWith(carried, joined, List<u64>.asSlice(&taken), joined, List<u64>.asSlice(&other))
  function.startBlock(joined)
  let mut total = sum
  at = usize.ZERO
  while at < differing {
    total = run function.binary(Binary.Add, total, List<u64>.get(&parameters, at))
    at = at + usize.ONE
  }
  run function.ret(total)
  run function.finish()
  return move function
}

fn branches(function: &SsaFunction) -> usize {
  let mut total = usize.ZERO
  let mut at = usize.ZERO
  while at < function.blockCount() {
    if function.block(at).exit == Exit.Branch { total = total + usize.ONE }
    at = at + usize.ONE
  }
  return total
}

// `if sum < a { 1 } else { 0 }` and its like: the two edges of the branch enter one block, so the
// block takes the flag widened, its negation widened, and a select of the two arguments, and no
// branch is left. Past `SsaControlFlow.joined()` differing parameters the branch stays. A flag
// widened and compared with one is the flag, and compared with zero its negation.
effect fn joinClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run joinedBranch(3)
  drop run SsaControlFlow.simplify(&mut function)
  run Testing.expect(run wellFormed(&function), "the joined function passes the verifier")
  run Testing.expect(function.blockCount() == usize.ONE && branches(&function) == usize.ZERO, "the branch became a jump its target joined")
  run Testing.expect(count(&function, Sort.Cast, usize.MAX) == 2, "the constants 1 and 0, either way round, are the widened flag")
  run Testing.expect(count(&function, Sort.Select, usize.MAX) == usize.ONE, "two other values are a select")
  let mut wide = run joinedBranch(SsaControlFlow.joined() + usize.ONE)
  drop run SsaControlFlow.simplify(&mut wide)
  run Testing.expect(branches(&wide) == usize.ONE && count(&wide, Sort.Select, usize.MAX) == usize.ZERO, "a branch that differs on more stays")

  let mut compared = run SsaFunction.make(b"flags", 32)
  let int = Kind.integer(32)
  let a = run compared.argument(int)
  let b = run compared.argument(int)
  compared.setResult(Kind.flag())
  drop run compared.newBlock()
  let below = run compared.compare(Predicate.Ult, a, b)
  let byte = run compared.cast(Cast.ZExt, below, Kind.integer(8))
  let set = run compared.integer(8, 1)
  let clear = run compared.integer(8, 0)
  let same = run compared.compare(Predicate.Eq, byte, set)
  let negated = run compared.compare(Predicate.Eq, byte, clear)
  let both = run compared.binary(Binary.And, same, negated)
  run compared.ret(both)
  run compared.finish()
  drop run numberWithGraph(&mut compared)
  drop run eliminateWithGraph(&mut compared)
  run Testing.expect(run wellFormed(&compared), "the folded function passes the verifier")
  run Testing.expect(count(&compared, Sort.Compare, usize.MAX) == usize.ONE && count(&compared, Sort.Cast, usize.MAX) == usize.ZERO,
    "comparing the widened flag with one or zero needs neither the widening nor a second comparison")
}

test effect fn decidesChecksByRanges() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run rangeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Inside `index < 256`, a check of `index < 258` holds; a value masked to 32 bits is never above
// them; and once `index >= 1` is known too, `index - 1 < 258` holds without wrapping. Only the two
// comparisons that guard the blocks stay. A check the ranges leave open, `index < 100`, stays too.
effect fn rangeClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"ranges", 32)
  let int = Kind.integer(32)
  let wide = Kind.integer(64)
  let index = run function.argument(int)
  let value = run function.argument(wide)
  function.setResult(Kind.flag())
  let entry = run function.newBlock()
  let inside = run function.newBlock()
  let deeper = run function.newBlock()
  let out = run function.newBlock()
  function.startBlock(entry)
  let limit = run function.integer(32, 256)
  let within = run function.compare(Predicate.Ult, index, limit)
  run function.branchIf(within, inside, out)
  function.startBlock(inside)
  let looser = run function.integer(32, 258)
  let implied = run function.compare(Predicate.Ult, index, looser)
  let mask = run function.integer(64, 4294967295)
  let low = run function.binary(Binary.And, value, mask)
  let above = run function.compare(Predicate.Ugt, low, mask)
  let one = run function.integer(32, 1)
  let positive = run function.compare(Predicate.Uge, index, one)
  let first = run function.binary(Binary.Or, implied, above)
  drop run function.call(b"note", &[first], Kind.unit())
  run function.branchIf(positive, deeper, out)
  function.startBlock(deeper)
  let before = run function.binary(Binary.Sub, index, one)
  let shifted = run function.compare(Predicate.Ult, before, looser)
  let hundred = run function.integer(32, 100)
  let open = run function.compare(Predicate.Ult, index, hundred)
  let both = run function.binary(Binary.And, shifted, open)
  run function.ret(both)
  function.startBlock(out)
  let never = run function.flag(false)
  run function.ret(never)
  run function.finish()
  drop run numberWithGraph(&mut function)
  run Testing.expect(run wellFormed(&function), "the numbered function passes the verifier")
  run Testing.expect(count(&function, Sort.Compare, usize.MAX) == 3, "the guards and the open check stay; the checks the ranges answer are gone")
}

test effect fn boundsTwoVariableOperands() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run variableRangeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn variableRangeClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"variable_ranges", 32)
  let int = Kind.integer(32)
  let x = run function.argument(int)
  let y = run function.argument(int)
  function.setResult(Kind.flag())
  let entry = run function.newBlock()
  function.startBlock(entry)
  let mask = run function.integer(32, 255)
  let a = run function.binary(Binary.And, x, mask)
  let b = run function.binary(Binary.And, y, mask)
  let sum = run function.binary(Binary.Add, a, b)
  let high = run function.integer(32, 510)
  let sumFits = run function.compare(Predicate.Ule, sum, high)
  let biased = run function.binary(Binary.Add, a, mask)
  let difference = run function.binary(Binary.Sub, biased, b)
  let differenceFits = run function.compare(Predicate.Ule, difference, high)
  let open = run function.binary(Binary.Sub, a, b)
  let mayWrap = run function.compare(Predicate.Ule, open, high)
  let unbounded = run function.binary(Binary.Add, x, b)
  let mayOverflow = run function.compare(Predicate.Ule, unbounded, high)
  drop run function.call(b"note", &[sumFits, differenceFits, mayWrap], Kind.unit())
  let note = function.instructionCount() - usize.ONE
  run function.ret(mayOverflow)
  run function.finish()
  drop run numberWithGraph(&mut function)
  run Testing.expect(run wellFormed(&function), "the inferred ranges pass the verifier")
  let answers = function.operandsOf(note)
  run Testing.expect(function.isBits(answers[usize.ZERO]) && function.constantOf(answers[usize.ZERO]).low == 1, "the sum of two bytes is at most 510")
  run Testing.expect(function.isBits(answers[usize.ONE]) && function.constantOf(answers[usize.ONE]).low == 1, "subtracting a byte from a value in [255, 510] stays within [0, 510]")
  run Testing.expect(count(&function, Sort.Compare, usize.MAX) == 2, "wrapping differences and sums with an unbounded operand keep their comparisons")
}

test effect fn checksSelectedValuesAgainstTheirAlternatives() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run selectedClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn selectedClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut f = run SsaFunction.make(b"selected_bounds", 32)
  let int = Kind.integer(32)
  let x = run f.argument(int)
  let y = run f.argument(int)
  let z = run f.argument(int)
  let entry = run f.newBlock()
  f.startBlock(entry)
  let below = run f.compare(Predicate.Ult, y, x)
  let low = run f.select(below, y, x)
  let lowFits = run f.compare(Predicate.Ule, low, x)
  let yTooSmall = run f.compare(Predicate.Ult, y, low)
  let strict = run f.compare(Predicate.Ult, low, x)
  let signed = run f.compare(Predicate.Sle, low, x)
  let unrelated = run f.select(below, y, z)
  let open = run f.compare(Predicate.Ule, unrelated, x)
  let high = run f.extreme(Extreme.SignedMaximum, y, z)
  let highFits = run f.compare(Predicate.Sle, z, high)
  drop run f.call(b"note", &[lowFits, yTooSmall, highFits, strict, signed, open], Kind.unit())
  let note = f.instructionCount() - usize.ONE
  run f.ret(none())
  run f.finish()
  drop run numberWithGraph(&mut f)
  run Testing.expect(run wellFormed(&f), "select bounds pass the verifier")
  let args = f.operandsOf(note)
  run Testing.expect(f.isBits(args[0]) && f.constantOf(args[0]).low == 1, "a minimum is at most either alternative")
  run Testing.expect(f.isBits(args[1]) && f.constantOf(args[1]).low == 0, "an alternative cannot be below the minimum")
  run Testing.expect(f.isBits(args[2]) && f.constantOf(args[2]).low == 1, "a signed maximum bounds its input")
  run Testing.expect(!f.isBits(args[3]) && !f.isBits(args[4]) && !f.isBits(args[5]), "strict, mixed-sign and unrelated comparisons stay open")
}

test effect fn decidesSignedChecksByRanges() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run signedRangeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Below `value < 0`, `value + 1` cannot pass the greatest integer, and `0 - (value + 1)` is not
// negative, so both checks fold; and that difference with every bit flipped is `value` again,
// which the block returns. Only the guard's comparison stays.
effect fn signedRangeClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"signed", 32)
  let wide = Kind.integer(64)
  let value = run function.argument(wide)
  function.setResult(wide)
  let entry = run function.newBlock()
  let below = run function.newBlock()
  let out = run function.newBlock()
  function.startBlock(entry)
  let zero = run function.integer(64, 0)
  let negative = run function.compare(Predicate.Slt, value, zero)
  run function.branchIf(negative, below, out)
  function.startBlock(below)
  let one = run function.integer(64, 1)
  let nearlyMost = run function.integer(64, 9223372036854775806)
  let overflows = run function.compare(Predicate.Sgt, value, nearlyMost)
  let next = run function.binary(Binary.Add, value, one)
  let negated = run function.binary(Binary.Sub, zero, next)
  let underflows = run function.compare(Predicate.Slt, negated, zero)
  let either = run function.binary(Binary.Or, overflows, underflows)
  drop run function.call(b"note", &[either], Kind.unit())
  let ones = run function.integer(64, 18446744073709551615)
  let flipped = run function.binary(Binary.Xor, negated, ones)
  run function.ret(flipped)
  function.startBlock(out)
  run function.ret(zero)
  run function.finish()
  drop run numberWithGraph(&mut function)
  run Testing.expect(run wellFormed(&function), "the numbered function passes the verifier")
  run Testing.expect(count(&function, Sort.Compare, usize.MAX) == usize.ONE, "only the guard's comparison stays")
  let returning = List<Edge>.asSlice(&function.block(usize.ZERO).edges)[usize.ZERO].block
  run Testing.expect(function.block(returning).value == value, "the flipped negation of the successor is the value itself")
}

test effect fn foldsAWrappingConversionToATruncation() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run wrappingClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// The upper half of a `u64` to `i32` conversion that keeps the low 32 bits, as the standard
// library writes it: above the greatest `i32`, `-(4294967295 - low) - 1` with a range check of
// the difference. The difference cannot pass the greatest `i32` there, so the check folds, and
// the arithmetic is the truncation of the value itself.
effect fn wrappingClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"wrapping", 32)
  let wide = Kind.integer(64)
  let narrow = Kind.integer(32)
  let value = run function.argument(wide)
  function.setResult(narrow)
  let entry = run function.newBlock()
  let upper = run function.newBlock()
  let out = run function.newBlock()
  function.startBlock(entry)
  let mask = run function.integer(64, 4294967295)
  let greatest = run function.integer(64, 2147483647)
  let low = run function.binary(Binary.And, value, mask)
  let above = run function.compare(Predicate.Ugt, low, greatest)
  run function.branchIf(above, upper, out)
  function.startBlock(upper)
  let rest = run function.binary(Binary.Sub, mask, low)
  let unfit = run function.compare(Predicate.Ugt, rest, greatest)
  drop run function.call(b"note", &[unfit], Kind.unit())
  let small = run function.cast(Cast.Trunc, rest, narrow)
  let zero = run function.integer(32, 0)
  let one = run function.integer(32, 1)
  let negated = run function.binary(Binary.Sub, zero, small)
  let result = run function.binary(Binary.Sub, negated, one)
  run function.ret(result)
  function.startBlock(out)
  run function.ret(zero)
  run function.finish()
  let mut round = usize.ZERO
  while round < 4 {
    drop run numberWithGraph(&mut function)
    drop run eliminateWithGraph(&mut function)
    round = round + usize.ONE
  }
  run Testing.expect(run wellFormed(&function), "the folded function passes the verifier")
  run Testing.expect(count(&function, Sort.Compare, usize.MAX) == usize.ONE, "the difference's range check is decided")
  let returning = List<Edge>.asSlice(&function.block(usize.ZERO).edges)[usize.ZERO].block
  let returned = function.block(returning).value
  let producer = function.producerOf(returned)
  let mut truncates = false
  if producer != usize.MAX {
    if let Operation.Cast {operation: Cast.Trunc} = function.instruction(producer).operation {
      truncates = function.operandsOf(producer)[usize.ZERO] == value
    }
  }
  run Testing.expect(truncates, "the upper half returns the value truncated")
}

test effect fn parametersThatHandAValueOnShareAWeb() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run webClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// `held` enters `fork`, which passes it on to `join` along one edge and a sum along the other.
// When `join` reads only its own parameter, `held` is dead there and the two share a web; when
// `join` also reads `held` (`both`), both are live at once and each keeps its own location.
effect fn webbed(both: bool) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut function = run SsaFunction.make(b"webs", 32)
  let int = Kind.integer(32)
  let start = run function.argument(int)
  function.setResult(int)
  let entry = run function.newBlock()
  let fork = run function.newBlock()
  let plain = run function.newBlock()
  let bumped = run function.newBlock()
  let join = run function.newBlock()
  let held = run function.addParameter(fork, int)
  let passed = run function.addParameter(join, int)
  function.startBlock(entry)
  let doubled = run function.binary(Binary.Add, start, start)
  run function.jumpWith(fork, &[doubled])
  function.startBlock(fork)
  let zero = run function.integer(32, 0)
  let empty = run function.compare(Predicate.Eq, held, zero)
  run function.branchIf(empty, plain, bumped)
  function.startBlock(plain)
  run function.jumpWith(join, &[held])
  function.startBlock(bumped)
  let one = run function.integer(32, 1)
  let more = run function.binary(Binary.Add, held, one)
  run function.jumpWith(join, &[more])
  function.startBlock(join)
  let mut result = passed
  if both { result = run function.binary(Binary.Add, passed, held) }
  run function.ret(result)
  run function.finish()
  let graph = run SsaGraph.of(&function)
  let webs = run SsaWebs.of(&function, &graph)
  return List<u64>.get(&webs, u64.toUsize(passed)) == held && List<u64>.get(&webs, u64.toUsize(held)) == held
}

effect fn webClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run Testing.expect(run webbed(false), "a parameter passed on where it is dead shares its successor's web")
  run Testing.expect(!(run webbed(true)), "two parameters live at once keep their own locations")
}

test effect fn promotesAFieldReadNarrowerThanItIsStored() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sharedFieldClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A tag stored as a word on two paths and read as a byte after they join, as a copy expanded
// word by word leaves an `Option`: the slot is promoted, so no load or store is left, and the
// byte is the low part of the word the paths pass on.
effect fn sharedFieldClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"tagged", 32)
  let chosen = run function.argument(Kind.flag())
  function.setResult(Kind.integer(8))
  let entry = run function.newBlock()
  let some = run function.newBlock()
  let nothing = run function.newBlock()
  let after = run function.newBlock()
  function.startBlock(entry)
  let slot = run function.slotOf(16, 8)
  run function.branchIf(chosen, some, nothing)
  function.startBlock(some)
  let set = run function.integer(64, 1)
  run function.store(set, slot, 0, 8)
  run function.jump(after)
  function.startBlock(nothing)
  let clear = run function.integer(64, 0)
  run function.store(clear, slot, 0, 8)
  run function.jump(after)
  function.startBlock(after)
  let tag = run function.load(Kind.integer(8), slot, 0, 1)
  run function.ret(tag)
  run function.finish()
  run promoteWithGraph(&mut function, true)
  run Testing.expect(run wellFormed(&function), "the promoted function passes the verifier")
  run Testing.expect(count(&function, Sort.Load, usize.MAX) == usize.ZERO && count(&function, Sort.Store, usize.MAX) == usize.ZERO,
    "the word stores and the byte load are gone")
  run Testing.expect(count(&function, Sort.Cast, usize.MAX) == usize.ONE, "the byte is the word truncated")

  // A flag read from the field a word was stored to is the word truncated to a flag.
  let mut flagged = run SsaFunction.make(b"flagged", 32)
  let word = run flagged.argument(Kind.integer(64))
  flagged.setResult(Kind.flag())
  let only = run flagged.newBlock()
  flagged.startBlock(only)
  let held = run flagged.slotOf(8, 8)
  run flagged.store(word, held, 0, 8)
  let flag = run flagged.load(Kind.flag(), held, 0, 1)
  run flagged.ret(flag)
  run flagged.finish()
  run promoteWithGraph(&mut flagged, true)
  run Testing.expect(run wellFormed(&flagged), "a flag read from a word's field passes the verifier")
  run Testing.expect(count(&flagged, Sort.Load, usize.MAX) == usize.ZERO && count(&flagged, Sort.Store, usize.MAX) == usize.ZERO,
    "the word store and the flag load are gone")

  // A word stored over a flag and an integer beside it is split into them, the flag as a flag.
  let mut split = run SsaFunction.make(b"split", 32)
  let both = run split.argument(Kind.integer(64))
  split.setResult(Kind.integer(32))
  let body = run split.newBlock()
  split.startBlock(body)
  let pair = run split.slotOf(8, 4)
  run split.store(both, pair, 0, 4)
  let low = run split.load(Kind.flag(), pair, 0, 1)
  let high = run split.load(Kind.integer(32), pair, 4, 4)
  let lowWord = run split.cast(Cast.ZExt, low, Kind.integer(32))
  let sum = run split.binary(Binary.Add, lowWord, high)
  run split.ret(sum)
  run split.finish()
  run promoteWithGraph(&mut split, true)
  run Testing.expect(run wellFormed(&split), "a word split into a flag and an integer passes the verifier")
  run Testing.expect(count(&split, Sort.Load, usize.MAX) == usize.ZERO && count(&split, Sort.Store, usize.MAX) == usize.ZERO,
    "the split word's store and loads are gone")
}

test effect fn aSignBranchWithEqualSidesGoes() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run signBranchClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A `u64` to `i32` conversion that keeps the low 32 bits, once its upper side's arithmetic has
// folded: at most the greatest `i32`, the low bits truncated; above it, the value truncated, after
// a check that its bits flipped do not pass the least `i32`. Above the greatest `i32` the low
// bits have their top bit set, so the truncation is negative and the check is decided. Both
// sides then truncate the same value and pass it on, so they join and the branch goes.
effect fn signBranchClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"converted", 32)
  let wide = Kind.integer(64)
  let narrow = Kind.integer(32)
  let value = run function.argument(wide)
  function.setResult(narrow)
  let entry = run function.newBlock()
  let lower = run function.newBlock()
  let upper = run function.newBlock()
  let bad = run function.newBlock()
  let good = run function.newBlock()
  let out = run function.newBlock()
  let result = run function.addParameter(out, narrow)
  function.startBlock(entry)
  let mask = run function.integer(64, 4294967295)
  let greatest = run function.integer(64, 2147483647)
  let low = run function.binary(Binary.And, value, mask)
  let small = run function.compare(Predicate.Ule, low, greatest)
  run function.branchIf(small, lower, upper)
  function.startBlock(lower)
  let kept = run function.cast(Cast.Trunc, low, narrow)
  run function.jumpWith(out, &[kept])
  function.startBlock(upper)
  let wrapped = run function.cast(Cast.Trunc, value, narrow)
  let ones = run function.integer(32, 4294967295)
  let flipped = run function.binary(Binary.Xor, wrapped, ones)
  let nearlyLeast = run function.integer(32, 2147483649)
  let passes = run function.compare(Predicate.Sgt, nearlyLeast, flipped)
  run function.branchIf(passes, bad, good)
  function.startBlock(bad)
  run function.trap()
  function.startBlock(good)
  run function.jumpWith(out, &[wrapped])
  function.startBlock(out)
  run function.ret(result)
  run function.finish()
  drop run numberWithGraph(&mut function)
  run Testing.expect(run wellFormed(&function), "the numbered function passes the verifier")
  run Testing.expect(count(&function, Sort.Compare, usize.MAX) == usize.ONE, "the upper side's check is decided by what the branch says of the low bits")
  let mut round = usize.ZERO
  while round < 3 {
    drop run SsaControlFlow.simplify(&mut function)
    drop run numberWithGraph(&mut function)
    drop run eliminateWithGraph(&mut function)
    round = round + usize.ONE
  }
  run Testing.expect(run wellFormed(&function), "the simplified function passes the verifier")
  run Testing.expect(function.blockCount() == usize.ONE && count(&function, Sort.Compare, usize.MAX) == usize.ZERO,
    "sides that truncate the same value join, and the branch between them goes")
  let returned = function.block(usize.ZERO).value
  let producer = function.producerOf(returned)
  let mut truncates = false
  if producer != usize.MAX {
    if let Operation.Cast {operation: Cast.Trunc} = function.instruction(producer).operation {
      truncates = function.operandsOf(producer)[usize.ZERO] == value
    }
  }
  run Testing.expect(truncates, "the conversion returns the value truncated")
}

test effect fn promotesAPairCopiedAsOneWord() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run packedPairClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A pointer and a length stored as two words, copied to a second slot, and read back as two
// words, as a slice passed by value is. With `wide`, the copy moves both as one integer; without,
// it moves the pointer as an integer of its own width. Either way both slots are promoted, and
// after numbering the loaded byte is read through the argument itself.
effect fn packedPair(wide: bool) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut function = run SsaFunction.make(b"paired", 32)
  let pointer = run function.argument(Kind.address(32))
  let length = run function.argument(Kind.integer(32))
  function.setResult(Kind.integer(32))
  let entry = run function.newBlock()
  function.startBlock(entry)
  let first = run function.slotOf(8, 4)
  let second = run function.slotOf(8, 4)
  run function.store(pointer, first, 0, 4)
  run function.store(length, first, 4, 4)
  if wide {
    let both = run function.load(Kind.integer(64), first, 0, 4)
    run function.store(both, second, 0, 4)
  } else {
    let low = run function.load(Kind.integer(32), first, 0, 4)
    run function.store(low, second, 0, 4)
    let high = run function.load(Kind.integer(32), first, 4, 4)
    run function.store(high, second, 4, 4)
  }
  let data = run function.load(Kind.address(32), second, 0, 4)
  let byte = run function.load(Kind.integer(8), data, 0, 1)
  let widened = run function.cast(Cast.ZExt, byte, Kind.integer(32))
  let held = run function.load(Kind.integer(32), second, 4, 4)
  let sum = run function.binary(Binary.Add, widened, held)
  run function.ret(sum)
  run function.finish()
  run promoteWithGraph(&mut function, true)
  if !(run wellFormed(&function)) { return false }
  drop run numberWithGraph(&mut function)
  drop run eliminateWithGraph(&mut function)
  if !(run wellFormed(&function)) { return false }
  // Only the byte's load is left, and it reads through the pointer argument.
  if count(&function, Sort.Store, usize.MAX) != usize.ZERO || count(&function, Sort.Load, usize.MAX) != usize.ONE { return false }
  let listed = List<usize>.asSlice(&function.block(entry).instructions)
  let mut direct = false
  let mut at = usize.ZERO
  while at < listed.length {
    if let Operation.Load {..} = function.instruction(listed[at]).operation { direct = function.operandsOf(listed[at])[usize.ZERO] == pointer }
    at = at + usize.ONE
  }
  return direct && count(&function, Sort.Add, usize.MAX) == usize.ONE
}

effect fn packedPairClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run Testing.expect(run packedPair(true), "a pair copied as one integer is promoted field by field")
  run Testing.expect(run packedPair(false), "a pointer copied as an integer shares the pointer's field")
}

test effect fn dropsOverflowChecksRangesRuleOut() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run uncheckedClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// An exponent of eleven bits less 1075 times a constant of a few million cannot leave 64 bits, so
// the checked product is the plain one and the branch on its overflow flag folds. The product of
// two values nothing bounds keeps its check.
effect fn unchecked(bounded: bool) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut function = run SsaFunction.make(b"scaled", 32)
  let wide = Kind.integer(64)
  let bits = run function.argument(wide)
  let other = run function.argument(wide)
  function.setResult(wide)
  let entry = run function.newBlock()
  let fine = run function.newBlock()
  let failed = run function.newBlock()
  function.startBlock(entry)
  let mask = run function.integer(64, 2047)
  let bias = run function.integer(64, 1075)
  let field = run function.binary(Binary.And, bits, mask)
  let exponent = run function.binary(Binary.Sub, field, bias)
  let mut factor = run function.integer(64, 1262611)
  if !bounded { factor = other }
  let scaled = run function.overflowing(Binary.Mul, true, exponent, factor)
  run function.branchIf(scaled.overflow, failed, fine)
  function.startBlock(fine)
  run function.ret(scaled.value)
  function.startBlock(failed)
  run function.trap()
  run function.finish()
  drop run numberWithGraph(&mut function)
  drop run SsaControlFlow.simplify(&mut function)
  drop run eliminateWithGraph(&mut function)
  return (run wellFormed(&function)) && count(&function, Sort.Overflow, usize.MAX) == usize.ZERO && branches(&function) == usize.ZERO
}

effect fn uncheckedClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run Testing.expect(run unchecked(true), "a product whose operands' ranges fit needs no check")
  run Testing.expect(!(run unchecked(false)), "a product of unbounded values keeps its check")
}

test effect fn strictUnsignedOrderLeavesRoomForAUnitStep() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run unitStepClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn unitStepClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut f = run SsaFunction.make(b"unit_step", 32)
  let x = run f.argument(Kind.integer(32))
  let y = run f.argument(Kind.integer(32))
  let entry = run f.newBlock()
  let strict = run f.newBlock()
  let other = run f.newBlock()
  let one = run f.integer(32, 1)
  f.startBlock(entry)
  let ordered = run f.compare(Predicate.Ult, x, y)
  run f.branchIf(ordered, strict, other)
  let sides = [strict, other]
  let mut i = usize.ZERO
  while i < 2 {
    f.startBlock(sides[i])
    let next = run f.overflowing(Binary.Add, false, x, one)
    let prev = run f.overflowing(Binary.Sub, false, y, one)
    drop run f.call(b"observe", &[next.value, next.overflow, prev.value, prev.overflow], Kind.unit())
    run f.ret(none())
    i = i + 1
  }
  run f.finish()
  drop run numberWithGraph(&mut f)
  run Testing.expect(count(&f, Sort.Overflow, strict) == 0 && count(&f, Sort.Overflow, other) == 2,
    "x < y bounds the increment of x and the decrement of y only along the strict edge")
  run Testing.expect(run wellFormed(&f), "both branch outcomes pass verification")
}

test effect fn checksConstantProductsAtTheirLastFittingInput() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run constantProductClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn constantProductClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut f = run SsaFunction.make(b"constant_product", 32)
  let x = run f.argument(Kind.integer(16))
  let factor = run f.integer(16, 17)
  let block = run f.newBlock()
  f.startBlock(block)
  let product = run f.overflowing(Binary.Mul, false, factor, x)
  let square = run f.overflowing(Binary.Mul, false, x, x)
  drop run f.call(b"observe", &[product.value, product.overflow, square.value, square.overflow], Kind.unit())
  let observer = f.instructionCount() - usize.ONE
  run f.ret(none())
  run f.finish()
  drop run numberWithGraph(&mut f)
  run Testing.expect(run wellFormed(&f), "both product results pass the verifier")
  let outputs = f.operandsOf(observer)
  let calc = f.producerOf(outputs[0])
  let check = f.producerOf(outputs[1])
  if let Operation.Binary {operation: Binary.Mul} = f.instruction(calc).operation {} else { return run Testing.expect(false, "the wrapped product is available") }
  if let Operation.Compare {predicate: Predicate.Ugt} = f.instruction(check).operation {} else { return run Testing.expect(false, "the overflow test uses a strict unsigned comparison") }
  let args = f.operandsOf(check)
  run Testing.expect(args[0] == x && f.isBits(args[1]) && f.constantOf(args[1]).low == 3855, "3855 fits exactly and the next input overflows")
  let squareCheck = f.producerOf(outputs[3])
  if let Operation.Compare {predicate: Predicate.Ugt} = f.instruction(squareCheck).operation {} else { return run Testing.expect(false, "the square has an unsigned threshold") }
  let compared = f.operandsOf(squareCheck)
  run Testing.expect(compared[0] == x && f.isBits(compared[1]) && f.constantOf(compared[1]).low == 255,
    "255 squared fits in sixteen bits and 256 squared overflows")
}

test effect fn packsWhatPassesLeftBehind() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run packClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A function most of whose instructions dead code elimination removed: packing leaves only the
// numbers the blocks still hold, the function still verifies, and a constant asked for again is
// the value the kept code already uses.
effect fn packClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"sparse", 32)
  let int = Kind.integer(32)
  let a = run function.argument(int)
  function.setResult(int)
  let entry = run function.newBlock()
  let exit = run function.newBlock()
  let joined = run function.addParameter(exit, int)
  function.startBlock(entry)
  let seven = run function.integer(32, 7)
  let mut unused = a
  let mut at = usize.ZERO
  while at < 40 {
    let mask = run function.integer(32, usize.toU64(at) + 100)
    unused = run function.binary(Binary.Xor, unused, mask)
    at = at + usize.ONE
  }
  let kept = run function.binary(Binary.Add, a, seven)
  run function.jumpWith(exit, &[kept])
  function.startBlock(exit)
  let doubled = run function.binary(Binary.Add, joined, joined)
  run function.ret(doubled)
  run function.finish()
  drop run eliminateWithGraph(&mut function)
  let before = function.valueCount()
  run Testing.expect(function.instructionCount() > function.heldCount(), "removed instructions keep their numbers until the function is packed")
  run function.pack()
  run Testing.expect(run wellFormed(&function), "the packed function passes the verifier")
  run Testing.expect(function.instructionCount() == function.heldCount() && function.heldCount() == 2, "only the held instructions are numbered")
  run Testing.expect(function.valueCount() < before, "the values nothing uses are forgotten")
  let again = run function.integer(32, 7)
  let add = List<usize>.get(&function.block(usize.ZERO).instructions, usize.ZERO)
  run Testing.expect(function.operandsOf(add)[usize.ONE] == again, "a constant asked for again is the one the kept code uses")
}

test effect fn decidesChecksABoundImplies() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run boundClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// How many blocks of `function` end in a trap.
fn traps(function: &SsaFunction) -> usize {
  let mut total = usize.ZERO
  let mut at = usize.ZERO
  while at < function.blockCount() {
    if function.block(at).exit == Exit.Trap { total = total + usize.ONE }
    at = at + usize.ONE
  }
  return total
}

// Where `i < n` holds, `i + 1` cannot wrap, so its check goes; where only `n` is known nothing
// says so and the check stays. A branch on a negated flag decides the flag itself on each side.
effect fn boundClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let int = Kind.integer(32)
  let mut bounded = run SsaFunction.make(b"bounded", 32)
  let i = run bounded.argument(int)
  let n = run bounded.argument(int)
  bounded.setResult(int)
  let entry = run bounded.newBlock()
  let inside = run bounded.newBlock()
  let outside = run bounded.newBlock()
  let wrapped = run bounded.newBlock()
  let fine = run bounded.newBlock()
  let wrappedOutside = run bounded.newBlock()
  let fineOutside = run bounded.newBlock()
  bounded.startBlock(entry)
  let below = run bounded.compare(Predicate.Ult, i, n)
  run bounded.branchIf(below, inside, outside)
  bounded.startBlock(inside)
  let one = run bounded.integer(32, 1)
  let next = run bounded.binary(Binary.Add, i, one)
  let over = run bounded.compare(Predicate.Ult, next, i)
  run bounded.branchIf(over, wrapped, fine)
  bounded.startBlock(wrapped)
  run bounded.trap()
  bounded.startBlock(fine)
  run bounded.ret(next)
  bounded.startBlock(outside)
  let after = run bounded.binary(Binary.Add, n, one)
  let overOutside = run bounded.compare(Predicate.Ult, after, n)
  run bounded.branchIf(overOutside, wrappedOutside, fineOutside)
  bounded.startBlock(wrappedOutside)
  run bounded.trap()
  bounded.startBlock(fineOutside)
  run bounded.ret(after)
  run bounded.finish()
  drop run numberWithGraph(&mut bounded)
  drop run SsaControlFlow.simplify(&mut bounded)
  run Testing.expect(run wellFormed(&bounded), "the bounded function passes the verifier")
  run Testing.expect(traps(&bounded) == usize.ONE, "the increment of a value below a bound is not checked, and the bound's own increment is")

  let mut negated = run SsaFunction.make(b"negated", 32)
  let x = run negated.argument(int)
  let y = run negated.argument(int)
  negated.setResult(int)
  let first = run negated.newBlock()
  let not = run negated.newBlock()
  let so = run negated.newBlock()
  let never = run negated.newBlock()
  let always = run negated.newBlock()
  negated.startBlock(first)
  let less = run negated.compare(Predicate.Ult, x, y)
  let set = run negated.flag(true)
  let flipped = run negated.binary(Binary.Xor, less, set)
  run negated.branchIf(flipped, not, so)
  negated.startBlock(not)
  run negated.branchIf(less, never, always)
  negated.startBlock(never)
  run negated.trap()
  negated.startBlock(always)
  run negated.ret(x)
  negated.startBlock(so)
  run negated.ret(y)
  run negated.finish()
  drop run numberWithGraph(&mut negated)
  drop run SsaControlFlow.simplify(&mut negated)
  run Testing.expect(traps(&negated) == usize.ZERO, "a branch on a negated flag decides the flag where it leads")
}

test effect fn equalConstantsAreOneValue() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run constantClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A constant asked for twice is one value, so two sums of an argument and that constant are one
// sum once numbered; a constant of another width or content is another value. Enough constants
// to grow the table several times are all still found.
effect fn constantClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"constants", 32)
  let int = Kind.integer(32)
  let x = run function.argument(int)
  function.setResult(int)
  let entry = run function.newBlock()
  function.startBlock(entry)
  let seven = run function.integer(32, 7)
  let again = run function.integer(32, 7)
  let wide = run function.integer(64, 7)
  let eight = run function.integer(32, 8)
  run Testing.expect(seven == again, "the same constant asked for twice is one value")
  run Testing.expect(seven != wide && seven != eight, "another width or content is another value")
  let mut held = true
  let mut each: u64 = 100
  while each < 400 {
    drop run function.integer(32, each)
    each = each + 1
  }
  each = 100
  while each < 400 {
    let first = run function.integer(32, each)
    let second = run function.integer(32, each)
    if first != second { held = false }
    each = each + 1
  }
  let found = run function.integer(32, 7)
  run Testing.expect(held && found == seven, "every constant is found again after the table grew")
  let first = run function.binary(Binary.Add, x, seven)
  let second = run function.binary(Binary.Add, x, again)
  let both = run function.binary(Binary.Mul, first, second)
  run function.ret(both)
  run function.finish()
  drop run numberWithGraph(&mut function)
  run Testing.expect(count(&function, Sort.Add, usize.MAX) == usize.ONE, "two sums with the same constant are one sum")
}

test effect fn anUnsignedRemainderIsWithinItsDivisor() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run remainderBound() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn remainderBound() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"remainder_bound", 32)
  let word = Kind.integer(32)
  let index = run function.argument(word)
  let length = run function.argument(word)
  function.setResult(Kind.flag())
  let entry = run function.newBlock()
  function.startBlock(entry)
  let remainder = run function.binary(Binary.URem, index, length)
  let producer = function.producerOf(remainder)
  let fits = run function.compare(Predicate.Ugt, length, remainder)
  run function.ret(fits)
  run function.finish()
  drop run numberWithGraph(&mut function)
  drop run eliminateWithGraph(&mut function)
  let answer = function.block(entry).value
  run Testing.expect(function.isBits(answer) && function.constantOf(answer).low == 1, "the divisor exceeds its unsigned remainder")
  run Testing.expect(!function.instruction(producer).removed, "computing the remainder still traps on a zero divisor")
}

test effect fn unrollsLoopsOfKnownLength() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run unrollClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// The sum of `i` for `i` from 0 while `i < bound`, each step calling `act` when `calls`.
effect fn summing(bound: u64, calls: bool) -> SsaFunction ! OutOfMemoryError ? &mut Allocator {
  let mut function = run SsaFunction.make(b"summing", 32)
  let int = Kind.integer(32)
  function.setResult(int)
  let entry = run function.newBlock()
  let head = run function.newBlock()
  let step = run function.newBlock()
  let done = run function.newBlock()
  let i = run function.addParameter(head, int)
  let sum = run function.addParameter(head, int)
  let total = run function.addParameter(done, int)
  function.startBlock(entry)
  let zero = run function.integer(32, 0)
  run function.jumpWith(head, &[zero, zero])
  function.startBlock(head)
  let limit = run function.integer(32, bound)
  let more = run function.compare(Predicate.Ult, i, limit)
  run function.branchWith(more, step, &[], done, &[sum])
  function.startBlock(step)
  if calls { drop run function.call(b"act", &[i], Kind.unit()) }
  let added = run function.binary(Binary.Add, sum, i)
  let one = run function.integer(32, 1)
  let next = run function.binary(Binary.Add, i, one)
  run function.jumpWith(head, &[next, added])
  function.startBlock(done)
  run function.ret(total)
  run function.finish()
  return move function
}

// A loop that runs four times becomes four copies of its body, each with its counter known, so
// the sum folds to a constant and the calls stay, one per iteration. A loop that runs more
// often than the limit is left alone.
effect fn unrollClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut short = run summing(4, true)
  let unrolled = run SsaUnroll.unroll(&mut short, SsaUnroll.loops())
  let formed = run wellFormed(&short)
  run Testing.expect(unrolled == usize.ONE && formed, "the unrolled function passes the verifier")
  drop run SsaControlFlow.simplify(&mut short)
  let body = List<usize>.asSlice(&short.block(usize.ZERO).instructions)
  let mut ordinal: u64 = 0
  let mut at = usize.ZERO
  while at < body.length {
    if let Operation.Call {..} = short.instruction(body[at]).operation {
      let argument = short.operandsOf(body[at])[usize.ZERO]
      run Testing.expect(short.isBits(argument) && short.constantOf(argument).low == ordinal, "each copy passes its constant counter before folding")
      ordinal = ordinal + 1
    }
    at = at + usize.ONE
  }
  run Testing.expect(short.blockCount() == usize.ONE && ordinal == 4, "each iteration still calls act in order")
  drop run numberWithGraph(&mut short)
  drop run SsaControlFlow.simplify(&mut short)
  let returned = short.block(usize.ZERO).value
  run Testing.expect(short.isBits(returned) && short.constantOf(returned).low == 6, "the sum of the four counters is the constant six")
  // The same sum returned straight from the header's parameter, with no parameter after the loop.
  let mut direct = run SsaFunction.make(b"direct", 32)
  let int = Kind.integer(32)
  direct.setResult(int)
  let entry = run direct.newBlock()
  let head = run direct.newBlock()
  let step = run direct.newBlock()
  let done = run direct.newBlock()
  let i = run direct.addParameter(head, int)
  let sum = run direct.addParameter(head, int)
  direct.startBlock(entry)
  let zero = run direct.integer(32, 0)
  run direct.jumpWith(head, &[zero, zero])
  direct.startBlock(head)
  let limit = run direct.integer(32, 4)
  let more = run direct.compare(Predicate.Ugt, limit, i)
  run direct.branchIf(more, step, done)
  direct.startBlock(step)
  let added = run direct.binary(Binary.Add, sum, i)
  let one = run direct.integer(32, 1)
  let next = run direct.binary(Binary.Add, i, one)
  run direct.jumpWith(head, &[next, added])
  direct.startBlock(done)
  run direct.ret(sum)
  run direct.finish()
  let opened = run SsaUnroll.unroll(&mut direct, SsaUnroll.loops())
  let sound = run wellFormed(&direct)
  run Testing.expect(opened == usize.ONE && sound, "a loop whose header value is read after it unrolls")
  drop run SsaControlFlow.simplify(&mut direct)
  drop run numberWithGraph(&mut direct)
  drop run SsaControlFlow.simplify(&mut direct)
  let answer = direct.block(usize.ZERO).value
  run Testing.expect(direct.blockCount() == usize.ONE && direct.isBits(answer) && direct.constantOf(answer).low == 6,
    "what read the header's sum after the loop reads the last copy's")
  let mut long = run summing(100, false)
  let lengthened = run SsaUnroll.unroll(&mut long, SsaUnroll.loops())
  run Testing.expect(lengthened == usize.ZERO, "a loop of a hundred iterations stays a loop")
}

test effect fn eliminatesDeadCode() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run deadClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// An unused sum and an unused load of a slot go; an unused division by a variable, an unused load
// through an argument and an unused call stay, since each can trap or act.
effect fn deadClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"dead", 32)
  let int = Kind.integer(32)
  let x = run function.argument(int)
  let pointer = run function.argument(Kind.address(32))
  let entry = run function.newBlock()
  function.startBlock(entry)
  drop run function.binary(Binary.Add, x, x)
  drop run function.binary(Binary.UDiv, x, x)
  let cell = run function.slotOf(4, 4)
  drop run function.load(int, cell, 0, 4)
  drop run function.load(int, pointer, 0, 4)
  drop run function.call(b"act", &[], int)
  run function.ret(none())
  run function.finish()
  drop run eliminateWithGraph(&mut function)
  run Testing.expect(run wellFormed(&function), "the cleaned function passes the verifier")
  run Testing.expect(count(&function, Sort.Add, usize.MAX) == usize.ZERO, "an unused sum goes")
  run Testing.expect(count(&function, Sort.Divide, usize.MAX) == usize.ONE, "an unused division that can trap stays")
  run Testing.expect(count(&function, Sort.Load, usize.MAX) == usize.ONE, "only the load that cannot trap goes")
  run Testing.expect(count(&function, Sort.Call, usize.MAX) == usize.ONE, "an unused call stays")
}

test effect fn forwardsMemory() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run memoryClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A slot indexed at run time keeps its memory, but a load after a store of the same field reads
// the stored value even across a call, since the slot does not escape. Memory behind an argument
// is reloaded after a call, and a store to another field of a slot does not disturb a forward.
effect fn memoryClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"memory", 32)
  let int = Kind.integer(32)
  let index = run function.argument(int)
  let pointer = run function.argument(Kind.address(32))
  function.setResult(int)
  let entry = run function.newBlock()
  function.startBlock(entry)
  let array = run function.slotOf(16, 4)
  let seven = run function.integer(32, 7)
  let nine = run function.integer(32, 9)
  run function.store(seven, array, 4, 4)
  run function.store(nine, array, 8, 4)
  let element = run function.indexed(array, index)
  let unknown = run function.load(int, element, 0, 4)
  drop run function.call(b"act", &[], Kind.unit())
  let field = run function.load(int, array, 4, 4)
  run function.store(seven, pointer, 0, 4)
  drop run function.call(b"act", &[], Kind.unit())
  let behind = run function.load(int, pointer, 0, 4)
  let partial = run function.binary(Binary.Add, unknown, field)
  let total = run function.binary(Binary.Add, partial, behind)
  run function.ret(total)
  run function.finish()
  run promoteWithGraph(&mut function, true)
  let before = count(&function, Sort.Load, usize.MAX)
  drop run forwardWithGraph(&mut function)
  run Testing.expect(run wellFormed(&function), "the forwarded function passes the verifier")
  run Testing.expect(before == 3, "the slot indexed at run time stays in memory")
  run Testing.expect(count(&function, Sort.Load, usize.MAX) == 2, "the field load reads the stored value across a call")

  // A slot whose address a call receives is reloaded after the call.
  let mut escaping = run SsaFunction.make(b"escaping", 32)
  escaping.setResult(int)
  let only = run escaping.newBlock()
  escaping.startBlock(only)
  let cell = run escaping.slotOf(4, 4)
  let three = run escaping.integer(32, 3)
  run escaping.store(three, cell, 0, 4)
  drop run escaping.call(b"use", &[cell], Kind.unit())
  let reloaded = run escaping.load(int, cell, 0, 4)
  run escaping.ret(reloaded)
  run escaping.finish()
  drop run forwardWithGraph(&mut escaping)
  run Testing.expect(count(&escaping, Sort.Load, usize.MAX) == usize.ONE, "a load of an escaped slot is not forwarded across a call")
  run Testing.expect(count(&escaping, Sort.Store, usize.MAX) == usize.ONE, "a store the callee can read stays")

  // A second load through the same address value reads what the first read, wherever the
  // address points, unless something was written between.
  let mut repeated = run SsaFunction.make(b"repeated", 32)
  let base = run repeated.argument(Kind.address(32))
  let offset = run repeated.argument(int)
  let other = run repeated.argument(Kind.address(32))
  repeated.setResult(int)
  let reading = run repeated.newBlock()
  repeated.startBlock(reading)
  let place = run repeated.indexed(base, offset)
  let initial = run repeated.load(int, place, 0, 4)
  let again = run repeated.load(int, place, 0, 4)
  run repeated.store(initial, other, 0, 4)
  let later = run repeated.load(int, place, 0, 4)
  let pair = run repeated.binary(Binary.Add, initial, again)
  let all = run repeated.binary(Binary.Add, pair, later)
  run repeated.ret(all)
  run repeated.finish()
  drop run forwardWithGraph(&mut repeated)
  run Testing.expect(run wellFormed(&repeated), "the repeated function passes the verifier")
  run Testing.expect(count(&repeated, Sort.Load, usize.MAX) == 2, "a repeated load is one load until a store may have changed it")

  // A byte inside a wider constant a store wrote is that byte of the constant, low byte first;
  // a byte of a stored argument is still loaded. The escaping call keeps both stores.
  let byte = Kind.integer(8)
  let mut narrow = run SsaFunction.make(b"narrow", 32)
  let given = run narrow.argument(int)
  narrow.setResult(byte)
  let body = run narrow.newBlock()
  narrow.startBlock(body)
  let wide = run narrow.slotOf(8, 4)
  let pattern = run narrow.integer(32, 0x01020304)
  run narrow.store(pattern, wide, 0, 4)
  run narrow.store(given, wide, 4, 4)
  let second = run narrow.load(byte, wide, 1, 1)
  let passed = run narrow.load(byte, wide, 5, 1)
  let joined = run narrow.binary(Binary.Add, second, passed)
  drop run narrow.call(b"use", &[wide], Kind.unit())
  run narrow.ret(joined)
  run narrow.finish()
  drop run forwardWithGraph(&mut narrow)
  run Testing.expect(run wellFormed(&narrow), "the narrowed function passes the verifier")
  run Testing.expect(count(&narrow, Sort.Load, usize.MAX) == usize.ONE, "only the byte of the stored argument is still loaded")
  let listed = List<usize>.asSlice(&narrow.block(body).instructions)
  let mut folded = none()
  let mut at = usize.ZERO
  while at < listed.length {
    if sorted(narrow.instruction(listed[at]).operation, Sort.Add) { folded = narrow.operandsOf(listed[at])[usize.ZERO] }
    at = at + usize.ONE
  }
  run Testing.expect(narrow.isBits(folded) && narrow.constantOf(folded).low == 3, "the second byte of 0x01020304 reads as 3")
}

test effect fn expandsSmallCopies() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run copyClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// An 8-byte copy between two slots of two `i32` fields becomes field loads and stores, so both
// slots promote and no memory is left; a copy over the limit stays a copy.
effect fn copyClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"copy", 32)
  let int = Kind.integer(32)
  let x = run function.argument(int)
  function.setResult(int)
  let entry = run function.newBlock()
  function.startBlock(entry)
  let from = run function.slotOf(8, 4)
  let to = run function.slotOf(8, 4)
  let large = run function.slotOf(32, 4)
  run function.store(x, from, 0, 4)
  run function.store(x, from, 4, 4)
  run function.copyBytes(to, from, 8)
  run function.copyBytes(large, to, 8)
  let low = run function.load(int, to, 0, 4)
  let high = run function.load(int, to, 4, 4)
  let sum = run function.binary(Binary.Add, low, high)
  run function.ret(sum)
  run function.finish()
  drop run SsaMemory.expandCopies(&mut function, 4)
  run Testing.expect(count(&function, Sort.Copy, usize.MAX) == 2, "a copy over the limit stays")
  drop run SsaMemory.expandCopies(&mut function, 8)
  run promoteWithGraph(&mut function, true)
  drop run forwardWithGraph(&mut function)
  drop run eliminateWithGraph(&mut function)
  run Testing.expect(run wellFormed(&function), "the expanded function passes the verifier")
  run Testing.expect(count(&function, Sort.Copy, usize.MAX) == usize.ZERO, "the small copies are loads and stores")
  run Testing.expect(count(&function, Sort.Load, usize.MAX) + count(&function, Sort.Store, usize.MAX) == usize.ZERO,
    "the slots promote, and stores nothing reads go")
}

test effect fn expandsCopiesOverFlagsAsBytes() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run flagCopyClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A union's variant stores a flag in a slot that a copy then fills with another variant, whose
// integer covers the flag's byte. The copy moves that byte whole: a flag is only the low bit of
// its byte, so once the slots promote a flag piece would keep that bit of the integer alone.
effect fn flagCopyClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"flag_copy", 32)
  let int = Kind.integer(32)
  let x = run function.argument(int)
  let flag = run function.argument(Kind.integer(1))
  function.setResult(int)
  let entry = run function.newBlock()
  function.startBlock(entry)
  let from = run function.slotOf(8, 4)
  let to = run function.slotOf(8, 4)
  let out = run function.slotOf(8, 4)
  run function.store(flag, to, 0, 1)
  run function.store(x, from, 0, 4)
  run function.store(x, from, 4, 4)
  run function.copyBytes(to, from, 8)
  run function.copyBytes(out, to, 8)
  let low = run function.load(int, out, 0, 4)
  run function.ret(low)
  run function.finish()
  drop run SsaMemory.expandCopies(&mut function, 8)
  run Testing.expect(run wellFormed(&function), "the expanded function passes the verifier")
  run Testing.expect(count(&function, Sort.Copy, usize.MAX) == usize.ZERO, "both copies are loads and stores")
  let mut flags = usize.ZERO
  let mut block = usize.ZERO
  while block < function.blockCount() {
    let listed = List<usize>.asSlice(&function.block(block).instructions)
    let mut at = usize.ZERO
    while at < listed.length {
      let found = function.instruction(listed[at])
      if sorted(found.operation, Sort.Load) && found.kind.bits == usize.ONE { flags = flags + usize.ONE }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  run Testing.expect(flags == usize.ZERO, "no copied byte is loaded as a flag")
}

test effect fn forwardsWholeStackCopies() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run stackCopyClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn stackCopyClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut variant = usize.ZERO
  while variant < 11 {
    let mut function = run SsaFunction.make(b"stack_copy", 32)
    let output = run function.argument(Kind.address(32))
    let entry = run function.newBlock()
    function.startBlock(entry)
    let source = run function.slotOf(128, 4)
    let mut temporary = run function.slotOf(128, 4)
    if variant == 4 { temporary = run function.offset(source, 4) }
    if variant == 6 { temporary = run function.offset(temporary, 32) }
    if variant == 5 || variant >= 9 { drop run function.call(b"publish", &[source], Kind.unit()) }
    run function.copyBytes(temporary, source, 100)
    if variant == 9 { drop run function.load(Kind.integer(32), temporary, 0, 4) }
    if variant == 10 { drop run function.load(Kind.integer(32), output, 0, 4) }
    if variant == 1 { run function.fill(source, 1, 4) }
    if variant == 2 { run function.fill(temporary, 2, 4) }
    if variant == 7 { drop run function.call(b"between", &[], Kind.unit()) }
    if variant == 8 { temporary = run function.offset(temporary, 4) }
    let mut size: u64 = 100
    if variant == 3 { size = 104 }
    run function.copyBytes(output, temporary, size)
    let copy = function.instructionCount() - usize.ONE
    run function.ret(none())
    run function.finish()
    drop run forwardWithGraph(&mut function)
    run Testing.expect(run wellFormed(&function), "the forwarded copy passes the verifier")
    let forwarded = function.operandsOf(copy)[usize.ONE] == source
    run Testing.expect(forwarded == (variant == usize.ZERO || variant == 5), "an observable source is read once through a private temporary, with no other read or intervening effect")
    variant = variant + usize.ONE
  }
}

test effect fn forwardsPrivateSnapshotFields() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run snapshotFieldClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn snapshotFieldClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut variant = usize.ZERO
  while variant < 5 {
    let mut f = run SsaFunction.make(b"snapshot", 32)
    let source = run f.argument(Kind.address(32))
    if variant == 1 { run f.setReach(source, 96) }
    let int = Kind.integer(32)
    f.setResult(int)
    let entry = run f.newBlock()
    f.startBlock(entry)
    let temporary = run f.slotOf(96, 4)
    run f.copyBytes(temporary, source, 96)
    if variant == 2 { run f.fill(source, 0, 96) }
    if variant == 3 { drop run f.call(b"mutate", &[source], Kind.unit()) }
    let mut address = temporary
    let mut displacement: u64 = 12
    if variant == 4 {
      address = run f.offset(temporary, 16)
      displacement = 0xfffffffc
    }
    let field = run f.load(int, address, displacement, 4)
    run f.ret(field)
    run f.finish()
    drop run forwardWithGraph(&mut f)
    drop run eliminateWithGraph(&mut f)
    run Testing.expect(run wellFormed(&f), "the forwarded snapshot passes verification")
    let load = f.producerOf(field)
    run Testing.expect((f.operandsOf(load)[0] == source) == (variant < 2), "a mutation keeps the original snapshot")
    run Testing.expect((count(&f, Sort.Copy, entry) == usize.ZERO) == (variant < 2), "only a fully forwarded copy disappears")
    let instructions = List<usize>.asSlice(&f.block(entry).instructions)
    let mut guarded = false
    let mut at = usize.ZERO
    while at < instructions.length && instructions[at] != load {
      let id = instructions[at]
      if let Operation.Load {offset, ..} = f.instruction(id).operation {
        guarded = offset == 95 && f.instruction(id).kind.bits == 8 && f.operandsOf(id)[0] == source
      }
      at = at + usize.ONE
    }
    run Testing.expect(guarded == (variant == usize.ZERO), "an unproven source keeps its whole-range bounds check before the field read")
    if let Operation.Load {offset, ..} = f.instruction(load).operation {
      run Testing.expect(offset == displacement, "the field keeps its nonwrapping byte displacement")
    }
    variant = variant + usize.ONE
  }
  // Even zero bytes of memory.copy checks whether the source is beyond memory.
  let mut f = run SsaFunction.make(b"empty_copy", 32)
  let ptr = run f.argument(Kind.address(32))
  let entry = run f.newBlock()
  f.startBlock(entry)
  let slot = run f.slotOf(4, 4)
  run f.copyBytes(slot, ptr, 0)
  run f.ret(none())
  run f.finish()
  drop run forwardWithGraph(&mut f)
  run Testing.expect(count(&f, Sort.Copy, entry) == usize.ONE, "a zero-byte copy through an unknown source keeps its bounds check")
}

test effect fn hoistsLoopInvariants() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run loopClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// In a counting loop with a call, `a * b` moves to the preheader; a division by an argument,
// which traps on zero only once the loop runs, and a load through an argument, which the call can
// change, stay in the loop.
effect fn loopClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"loop", 32)
  let int = Kind.integer(32)
  let a = run function.argument(int)
  let b = run function.argument(int)
  let pointer = run function.argument(Kind.address(32))
  function.setResult(int)
  let entry = run function.newBlock()
  let header = run function.newBlock()
  let body = run function.newBlock()
  let done = run function.newBlock()
  let counter = run function.addParameter(header, int)
  function.startBlock(entry)
  let zero = run function.integer(32, 0)
  run function.jumpWith(header, &[zero])
  function.startBlock(header)
  let more = run function.compare(Predicate.Ult, counter, a)
  run function.branchIf(more, body, done)
  function.startBlock(body)
  let product = run function.binary(Binary.Mul, a, b)
  let quotient = run function.binary(Binary.UDiv, a, b)
  let loaded = run function.load(int, pointer, 0, 4)
  let first = run function.binary(Binary.Add, counter, product)
  let second = run function.binary(Binary.Add, first, quotient)
  let next = run function.binary(Binary.Add, second, loaded)
  drop run function.call(b"tick", &[], Kind.unit())
  run function.jumpWith(header, &[next])
  function.startBlock(done)
  run function.ret(counter)
  run function.finish()
  run Testing.expect(run SsaLoops.hoist(&mut function), "the loop has an invariant")
  run Testing.expect(run wellFormed(&function), "the hoisted function passes the verifier")
  let preheader = usize.ZERO
  run Testing.expect(count(&function, Sort.Any, preheader) == usize.ONE, "the product moves to the preheader")
  run Testing.expect(count(&function, Sort.Divide, body) == usize.ONE, "a division that can trap stays in the loop")
  run Testing.expect(count(&function, Sort.Load, body) == usize.ONE, "a load the loop's call can change stays in the loop")

  // The whole pipeline keeps the function well formed at every level.
  let mut copied = run SsaFunction.make(b"pipeline", 32)
  copied.setResult(int)
  let only = run copied.newBlock()
  copied.startBlock(only)
  let slot = run copied.slotOf(8, 4)
  let four = run copied.integer(32, 4)
  run copied.store(four, slot, 0, 4)
  let back = run copied.load(int, slot, 0, 4)
  run copied.ret(back)
  run copied.finish()
  run SsaPipeline.prepare(&mut copied, Level.Speed, true)
  run Testing.expect(count(&copied, Sort.Any, usize.MAX) == usize.ZERO, "the pipeline reduces a stored and reloaded constant to a return")
}

// A loop over bytes: `while at < bound { ...; at = at + 1 }` from zero, or from the argument
// `first` with `offset`, or with `down`, `while at > 0 { at = at - 1; ... }` from `bound`. Each
// time round it stores at index `at` of `to` the byte at that index of `from` with `copies`, the
// low byte of the counter with `varying`, and else the argument `byte`.
effect fn byteLoop(copies: bool, down: bool, offset: bool, varying: bool) -> SsaFunction ! OutOfMemoryError ? &mut Allocator {
  let mut function = run SsaFunction.make(b"bytes", 32)
  let word = Kind.integer(32)
  let to = run function.argument(Kind.address(32))
  let from = run function.argument(Kind.address(32))
  let bound = run function.argument(word)
  let first = run function.argument(word)
  let byte = run function.argument(Kind.integer(8))
  function.setResult(word)
  let entry = run function.newBlock()
  let head = run function.newBlock()
  let body = run function.newBlock()
  let out = run function.newBlock()
  let at = run function.addParameter(head, word)
  function.startBlock(entry)
  let zero = run function.integer(32, 0)
  let one = run function.integer(32, 1)
  let mut start = zero
  if offset { start = first }
  if down { start = bound }
  run function.jumpWith(head, &[start])
  function.startBlock(head)
  let mut more = none()
  if down { more = run function.compare(Predicate.Ult, zero, at) } else { more = run function.compare(Predicate.Ugt, bound, at) }
  run function.branchIf(more, body, out)
  function.startBlock(body)
  let mut reached = at
  let mut next = none()
  if down {
    next = run function.binary(Binary.Sub, at, one)
    reached = next
  }
  let target = run function.indexed(to, reached)
  let mut stored = byte
  if copies {
    let origin = run function.indexed(from, reached)
    stored = run function.load(Kind.integer(8), origin, 0, 1)
  }
  if varying { stored = run function.cast(Cast.Trunc, at, Kind.integer(8)) }
  run function.store(stored, target, 0, 1)
  if !down { next = run function.binary(Binary.Add, at, one) }
  run function.jumpWith(head, &[next])
  function.startBlock(out)
  run function.ret(zero)
  run function.finish()
  return move function
}

test effect fn byteLoopsBecomeFillsAndCopies() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run idiomClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn emptyOrWrappingByteRangesKeepTheirBoundsCheck() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run readRangeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn readRangeClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut f = run SsaFunction.make(b"read_range", 32)
  let word = Kind.integer(32)
  let address = f.addressKind()
  let base = run f.argument(address)
  let first = run f.argument(word)
  let end = run f.argument(word)
  let entry = run f.newBlock()
  let header = run f.newBlock()
  let body = run f.newBlock()
  let after = run f.newBlock()
  let index = run f.addParameter(header, word)
  f.startBlock(entry)
  run f.jumpWith(header, &[first])
  f.startBlock(header)
  let nonempty = run f.compare(Predicate.Ult, index, end)
  run f.branchIf(nonempty, body, after)
  f.startBlock(body)
  let pointer = run f.indexed(base, index)
  drop run f.load(Kind.integer(8), pointer, 0, 1)
  let one = run f.integer(32, 1)
  let next = run f.binary(Binary.Add, index, one)
  run f.jumpWith(header, &[next])
  f.startBlock(after)
  run f.ret(none())
  run f.finish()
  run Testing.expect((run SsaIdioms.recognize(&mut f)) && (run wellFormed(&f)), "the range becomes a valid acyclic bounds check")
  let reached = List<Edge>.asSlice(&f.block(header).edges)
  let checked = reached[0].block
  run Testing.expect(count(&f, Sort.Load, checked) == usize.ONE && count(&f, Sort.Load, usize.MAX) == usize.ONE
    && f.block(checked).exit == Exit.Jump && List<Edge>.asSlice(&f.block(checked).edges)[0].block == reached[1].block,
    "one read checks a nonempty range and the empty path bypasses it")
  let ops = List<usize>.asSlice(&f.block(checked).instructions)
  let mut saturated = false
  let mut at = usize.ZERO
  while at < ops.length {
    if let Operation.Select = f.instruction(ops[at]).operation {
      let args = f.operandsOf(ops[at])
      saturated = f.isBits(args[1]) && f.constantOf(args[1]).low == 4294967295
    }
    at = at + usize.ONE
  }
  return run Testing.expect(saturated, "a wrapping range checks the highest address")
}

// The operands of the one subtraction of two addresses' bits in `function`: the arguments those
// addresses are, by position, or `usize.MAX` twice without one.
fn distanceOf(function: &SsaFunction) -> [usize; 2] {
  let mut found: [usize; 2] = [usize.MAX, usize.MAX]
  let mut block = usize.ZERO
  while block < function.blockCount() {
    let listed = List<usize>.asSlice(&function.block(block).instructions)
    let mut at = usize.ZERO
    while at < listed.length {
      if let Operation.Binary {operation: Binary.Sub} = function.instruction(listed[at]).operation {
        let operands = function.operandsOf(listed[at])
        let high = function.producerOf(operands[usize.ZERO])
        let low = function.producerOf(operands[usize.ONE])
        if high != usize.MAX && low != usize.MAX {
          if let Operation.Cast {operation: Cast.PtrToInt} = function.instruction(high).operation {
            found = [function.value(function.operandsOf(high)[usize.ZERO]).owner, function.value(function.operandsOf(low)[usize.ZERO]).owner]
          }
        }
      }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  return found
}

effect fn idiomClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // A fill from zero: the loop goes, and one fill of the bound's bytes stays.
  let mut filling = run byteLoop(false, false, false, false)
  run Testing.expect(run SsaIdioms.recognize(&mut filling), "a loop that stores one byte each time round is a fill")
  run Testing.expect(run wellFormed(&filling), "the fill passes the verifier")
  run Testing.expect(count(&filling, Sort.CountedFill, usize.MAX) == usize.ONE && count(&filling, Sort.Store, usize.MAX) == usize.ZERO
    && count(&filling, Sort.Compare, usize.MAX) == usize.ZERO, "the fill replaces the loop")
  // A fill from another index covers what lies between it and the bound, when anything does.
  let mut later = run byteLoop(false, false, true, false)
  run Testing.expect((run SsaIdioms.recognize(&mut later)) && (run wellFormed(&later)), "a fill may start past zero")
  let mut bounded = false
  let mut block = usize.ZERO
  while block < later.blockCount() {
    let listed = List<usize>.asSlice(&later.block(block).instructions)
    let mut at = usize.ZERO
    while at < listed.length {
      if let Operation.Extreme {..} = later.instruction(listed[at]).operation { bounded = true }
      at = at + usize.ONE
    }
    block = block + usize.ONE
  }
  run Testing.expect(bounded, "its count is the bound less the first index, and nothing when the index is past the bound")
  // A copy that counts up keeps its loop for a destination inside the source's range, and
  // checks the destination's distance past the source.
  let mut rising = run byteLoop(true, false, false, false)
  run Testing.expect((run SsaIdioms.recognize(&mut rising)) && (run wellFormed(&rising)), "a loop that moves one byte each time round gets a copy")
  run Testing.expect(count(&rising, Sort.CountedCopy, usize.MAX) == usize.ONE && count(&rising, Sort.Store, usize.MAX) == usize.ONE
    && count(&rising, Sort.Compare, usize.MAX) == 2, "the copy runs where a check allows it, and the loop stays for the rest")
  let up = distanceOf(&rising)
  run Testing.expect(up[usize.ZERO] == usize.ZERO && up[usize.ONE] == usize.ONE, "counting up, the destination's distance past the source is checked")
  // One that counts down checks the source's distance past the destination.
  let mut falling = run byteLoop(true, true, false, false)
  run Testing.expect((run SsaIdioms.recognize(&mut falling)) && (run wellFormed(&falling)), "a loop that moves bytes from the last down gets a copy")
  let reversed = distanceOf(&falling)
  run Testing.expect(count(&falling, Sort.CountedCopy, usize.MAX) == usize.ONE && reversed[usize.ZERO] == usize.ONE && reversed[usize.ONE] == usize.ZERO,
    "counting down, the source's distance past the destination is checked")
  // A byte the loop computes is no fill.
  let mut counting = run byteLoop(false, false, false, true)
  run Testing.expect(!(run SsaIdioms.recognize(&mut counting)) && count(&counting, Sort.CountedFill, usize.MAX) == usize.ZERO,
    "a loop that stores a byte it computes stays")
}

// `low <= value && value <= high` as two branches that both leave to one block, on the first
// argument; with `apart`, the second branch tests the second argument instead.
effect fn ranged(apart: bool) -> SsaFunction ! OutOfMemoryError ? &mut Allocator {
  let mut function = run SsaFunction.make(b"ranged", 32)
  let octet = Kind.integer(8)
  let value = run function.argument(octet)
  let other = run function.argument(octet)
  function.setResult(Kind.integer(32))
  let entry = run function.newBlock()
  let inner = run function.newBlock()
  let inside = run function.newBlock()
  let outside = run function.newBlock()
  function.startBlock(entry)
  let low = run function.integer(8, 65)
  let high = run function.integer(8, 90)
  let above = run function.compare(Predicate.Uge, value, low)
  run function.branchIf(above, inner, outside)
  function.startBlock(inner)
  let mut tested = value
  if apart { tested = other }
  let below = run function.compare(Predicate.Ule, tested, high)
  run function.branchIf(below, inside, outside)
  function.startBlock(inside)
  let one = run function.integer(32, 1)
  run function.ret(one)
  function.startBlock(outside)
  let zero = run function.integer(32, 0)
  run function.ret(zero)
  run function.finish()
  return move function
}

test effect fn twoBranchesOnARangeBecomeOne() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run rangeFusionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rangeFusionClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run ranged(false)
  let value: u64 = 0
  run Testing.expect(run SsaControlFlow.fuseRanges(&mut function), "two branches that keep a value between two constants fuse")
  // The second branch's block is no longer reached.
  drop run function.compact()
  run Testing.expect(run wellFormed(&function), "the fused function passes the verifier")
  // The entry branches on `value - 65 <= 25`, to the block inside the range first.
  let entry = function.block(usize.ZERO)
  let test = function.producerOf(entry.value)
  let mut spans = false
  if test != usize.MAX {
    if let Operation.Compare {predicate: Predicate.Ule} = function.instruction(test).operation {
      let moved = function.producerOf(function.operandsOf(test)[usize.ZERO])
      let span = function.operandsOf(test)[usize.ONE]
      if moved != usize.MAX && function.isBits(span) && function.constantOf(span).low == 25 {
        if let Operation.Binary {operation: Binary.Sub} = function.instruction(moved).operation {
          let start = function.operandsOf(moved)[usize.ONE]
          spans = function.operandsOf(moved)[usize.ZERO] == value && function.isBits(start) && function.constantOf(start).low == 65
        }
      }
    }
  }
  run Testing.expect(spans, "the one comparison is of the value less the lower constant with the range's width")
  let returns = function.block(List<Edge>.asSlice(&entry.edges)[usize.ZERO].block)
  run Testing.expect(returns.exit == Exit.Return && function.isBits(returns.value) && function.constantOf(returns.value).low == 1,
    "inside the range the branch goes where the second one did")
  let mut separate = run ranged(true)
  run Testing.expect(!(run SsaControlFlow.fuseRanges(&mut separate)), "branches on two values stay")
}

test effect fn edgesThatKnowATestSkipIt() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run threadingClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Two paths that each pass a constant tag and a value to a block that widens the tag, compares
// it with zero and branches; both sides of the branch read the value. Each path goes straight to
// its side, so the comparison goes, and the side a zero tag chooses returns the first path's
// value, the argument itself.
effect fn threadingClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"tagged", 32)
  let word = Kind.integer(32)
  let octet = Kind.integer(8)
  let chosen = run function.argument(Kind.flag())
  let value = run function.argument(word)
  function.setResult(word)
  let entry = run function.newBlock()
  let first = run function.newBlock()
  let second = run function.newBlock()
  let join = run function.newBlock()
  let fine = run function.newBlock()
  let failed = run function.newBlock()
  let tag = run function.addParameter(join, octet)
  let carried = run function.addParameter(join, word)
  function.startBlock(entry)
  run function.branchIf(chosen, first, second)
  function.startBlock(first)
  let success = run function.integer(8, 0)
  run function.jumpWith(join, &[success, value])
  function.startBlock(second)
  let failure = run function.integer(8, 1)
  let one = run function.integer(32, 1)
  let other = run function.binary(Binary.Add, value, one)
  run function.jumpWith(join, &[failure, other])
  function.startBlock(join)
  let wide = run function.cast(Cast.ZExt, tag, word)
  let zero = run function.integer(32, 0)
  let succeeded = run function.compare(Predicate.Eq, wide, zero)
  run function.branchIf(succeeded, fine, failed)
  function.startBlock(fine)
  run function.ret(carried)
  function.startBlock(failed)
  let doubled = run function.binary(Binary.Add, carried, carried)
  run function.ret(doubled)
  run function.finish()
  run Testing.expect(run SsaThreading.thread(&mut function), "an edge that passes a constant for the tested parameter is threaded")
  run Testing.expect(run wellFormed(&function), "the threaded function passes the verifier")
  drop run SsaControlFlow.simplify(&mut function)
  drop run eliminateWithGraph(&mut function)
  run Testing.expect(run wellFormed(&function), "the simplified function passes the verifier")
  run Testing.expect(count(&function, Sort.Compare, usize.MAX) == usize.ZERO && count(&function, Sort.Cast, usize.MAX) == usize.ZERO,
    "no path widens or tests its tag")
  let taken = function.block(List<Edge>.asSlice(&function.block(usize.ZERO).edges)[usize.ZERO].block)
  run Testing.expect(taken.exit == Exit.Return && taken.value == value, "the success path returns the value it passed")

  // A loop's header keeps the edge that enters the loop, though it passes a constant.
  let mut looping = run SsaFunction.make(b"looping", 32)
  looping.setResult(word)
  let start = run looping.newBlock()
  let head = run looping.newBlock()
  let body = run looping.newBlock()
  let out = run looping.newBlock()
  let round = run looping.addParameter(head, word)
  looping.startBlock(start)
  let none = run looping.integer(32, 0)
  run looping.jumpWith(head, &[none])
  looping.startBlock(head)
  let again = run looping.compare(Predicate.Eq, round, none)
  run looping.branchIf(again, body, out)
  looping.startBlock(body)
  let next = run looping.integer(32, 1)
  run looping.jumpWith(head, &[next])
  looping.startBlock(out)
  run looping.ret(round)
  run looping.finish()
  run Testing.expect(!(run SsaThreading.thread(&mut looping)), "an edge into a loop's header is not threaded past it")

  // Every edge into the testing block passes a constant and nothing outside it reads a value it
  // defines, so no value moves to a slot; the block is still removed once nothing reaches it.
  let mut unread = run SsaFunction.make(b"unread", 32)
  let pick = run unread.argument(Kind.flag())
  unread.setResult(word)
  let top = run unread.newBlock()
  let left = run unread.newBlock()
  let right = run unread.newBlock()
  let meet = run unread.newBlock()
  let yes = run unread.newBlock()
  let no = run unread.newBlock()
  let mark = run unread.addParameter(meet, octet)
  unread.startBlock(top)
  run unread.branchIf(pick, left, right)
  unread.startBlock(left)
  let clear = run unread.integer(8, 0)
  run unread.jumpWith(meet, &[clear])
  unread.startBlock(right)
  let set = run unread.integer(8, 1)
  run unread.jumpWith(meet, &[set])
  unread.startBlock(meet)
  let widened = run unread.cast(Cast.ZExt, mark, word)
  let nothing = run unread.integer(32, 0)
  let isClear = run unread.compare(Predicate.Eq, widened, nothing)
  let seven = run unread.integer(32, 7)
  let nine = run unread.integer(32, 9)
  run unread.branchIf(isClear, yes, no)
  unread.startBlock(yes)
  run unread.ret(seven)
  unread.startBlock(no)
  run unread.ret(nine)
  run unread.finish()
  run Testing.expect(run SsaThreading.thread(&mut unread), "edges are threaded through a block whose values nothing else reads")
  run Testing.expect(run wellFormed(&unread), "the block every edge skips is removed")
}

test effect fn promotesAnArrayIndexedByConstants() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run constantIndexClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// An element stored through an index that is a constant, as an unrolled loop leaves it, and
// loaded through the offset that names the same bytes: the slot is promoted, and the constant
// index back from the second element reaches the first.
effect fn constantIndexClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"indexed", 32)
  let word = Kind.integer(32)
  let value = run function.argument(word)
  function.setResult(word)
  let entry = run function.newBlock()
  function.startBlock(entry)
  let slot = run function.slotOf(16, 4)
  let four = run function.integer(32, 4)
  let second = run function.indexed(slot, four)
  run function.store(value, second, 0, 4)
  let back = run function.integer(32, 4294967292)
  let first = run function.indexed(second, back)
  let one = run function.integer(32, 1)
  run function.store(one, first, 0, 4)
  let stored = run function.load(word, slot, 4, 4)
  let low = run function.load(word, slot, 0, 4)
  let sum = run function.binary(Binary.Add, stored, low)
  run function.ret(sum)
  run function.finish()
  run promoteWithGraph(&mut function, true)
  run Testing.expect(run wellFormed(&function), "the promoted function passes the verifier")
  run Testing.expect(count(&function, Sort.Load, usize.MAX) == usize.ZERO && count(&function, Sort.Store, usize.MAX) == usize.ZERO,
    "a slot indexed only by constants is promoted")
  let added = function.producerOf(function.block(entry).value)
  run Testing.expect(added != usize.MAX && function.operandsOf(added)[usize.ZERO] == value && function.operandsOf(added)[usize.ONE] == one,
    "each load reads what the index that reaches its bytes stored")
}

// Two loads through one indexed address of the argument `from`, with a store between them at the
// same index of a stack slot whose address a call was given, or with `through` of the second
// argument.
effect fn reread(through: bool) -> SsaFunction ! OutOfMemoryError ? &mut Allocator {
  let mut function = run SsaFunction.make(b"reread", 32)
  let word = Kind.integer(32)
  let from = run function.argument(Kind.address(32))
  let other = run function.argument(Kind.address(32))
  let index = run function.argument(word)
  function.setResult(word)
  let entry = run function.newBlock()
  function.startBlock(entry)
  let slot = run function.slotOf(64, 4)
  drop run function.call(b"keep", &[slot], Kind.unit())
  let source = run function.indexed(from, index)
  let first = run function.load(word, source, 0, 4)
  let mut written = slot
  if through { written = other }
  let target = run function.indexed(written, index)
  run function.store(first, target, 0, 4)
  let again = run function.load(word, source, 0, 4)
  let sum = run function.binary(Binary.Add, first, again)
  run function.ret(sum)
  run function.finish()
  return move function
}

test effect fn aStoreToASlotKeepsWhatAnArgumentReaches() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run rereadClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rereadClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // The slot did not exist when the caller made the argument, though its address has escaped.
  let mut local = run reread(false)
  drop run forwardWithGraph(&mut local)
  run Testing.expect(run wellFormed(&local), "the forwarded function passes the verifier")
  run Testing.expect(count(&local, Sort.Load, usize.MAX) == usize.ONE, "a store to a stack slot leaves what an argument reaches as it was read")
  // Two arguments may reach the same bytes.
  let mut apart = run reread(true)
  drop run forwardWithGraph(&mut apart)
  run Testing.expect(count(&apart, Sort.Load, usize.MAX) == 2, "a store through another argument may change it")
}

test effect fn aSlotReachedThroughAHeldAddressIsPromoted() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run heldAddressClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A record in one slot whose address a second slot holds, as the `self` of a spliced method
// does: a loop loads the address each time round and adds one to a field of the record through
// it. The first promotion sees the record's address stored and leaves the record in memory,
// where forwarding cannot carry the field round the loop; once the held address is a value, the
// second promotes the record too, and nothing is left in memory.
effect fn heldAddressClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"held", 32)
  let word = Kind.integer(32)
  let pointer = Kind.address(32)
  let rounds = run function.argument(word)
  function.setResult(word)
  let entry = run function.newBlock()
  let head = run function.newBlock()
  let body = run function.newBlock()
  let out = run function.newBlock()
  let round = run function.addParameter(head, word)
  function.startBlock(entry)
  let record = run function.slotOf(8, 4)
  let reference = run function.slotOf(4, 4)
  let zero = run function.integer(32, 0)
  let one = run function.integer(32, 1)
  run function.store(record, reference, 0, 4)
  run function.store(zero, record, 4, 4)
  run function.jumpWith(head, &[zero])
  function.startBlock(head)
  let more = run function.compare(Predicate.Ult, round, rounds)
  run function.branchIf(more, body, out)
  function.startBlock(body)
  let through = run function.load(pointer, reference, 0, 4)
  let before = run function.load(word, through, 4, 4)
  let after = run function.binary(Binary.Add, before, one)
  run function.store(after, through, 4, 4)
  let next = run function.binary(Binary.Add, round, one)
  run function.jumpWith(head, &[next])
  function.startBlock(out)
  let last = run function.load(pointer, reference, 0, 4)
  let total = run function.load(word, last, 4, 4)
  run function.ret(total)
  run function.finish()
  run SsaPipeline.prepare(&mut function, Level.Size, true)
  run Testing.expect(count(&function, Sort.Load, usize.MAX) == usize.ZERO && count(&function, Sort.Store, usize.MAX) == usize.ZERO,
    "the record leaves memory once its held address has")
}

// A loop over `count` rounds that reads the word four bytes into the first argument each time
// round. With `writes` it also stores a byte through the second argument at that word's index and
// stores the word plus one back. `reach` says the first argument reaches eight bytes, and
// `exclusive` that both arguments are exclusive. Answers the function and its body block.
effect fn fieldLoop(writes: bool, reach: bool, exclusive: bool) -> SsaFunction ! OutOfMemoryError ? &mut Allocator {
  let mut function = run SsaFunction.make(b"fields", 32)
  let word = Kind.integer(32)
  let pointer = Kind.address(32)
  let record = run function.argument(pointer)
  let buffer = run function.argument(pointer)
  let count = run function.argument(word)
  function.setResult(word)
  if reach { run function.setReach(record, 8) }
  if exclusive {
    run function.setExclusive(record)
    run function.setExclusive(buffer)
  }
  let entry = run function.newBlock()
  let head = run function.newBlock()
  let body = run function.newBlock()
  let out = run function.newBlock()
  let round = run function.addParameter(head, word)
  let total = run function.addParameter(head, word)
  function.startBlock(entry)
  let zero = run function.integer(32, 0)
  let one = run function.integer(32, 1)
  run function.jumpWith(head, &[zero, zero])
  function.startBlock(head)
  let more = run function.compare(Predicate.Ult, round, count)
  run function.branchIf(more, body, out)
  function.startBlock(body)
  let field = run function.load(word, record, 4, 4)
  if writes {
    let target = run function.indexed(buffer, field)
    let seven = run function.integer(8, 7)
    run function.store(seven, target, 0, 1)
    let advanced = run function.binary(Binary.Add, field, one)
    run function.store(advanced, record, 4, 4)
  }
  let sum = run function.binary(Binary.Add, total, field)
  let next = run function.binary(Binary.Add, round, one)
  run function.jumpWith(head, &[next, sum])
  function.startBlock(out)
  run function.ret(total)
  run function.finish()
  return move function
}

// The loads and the stores the loop of `function` holds, counted in the blocks from which an
// edge leads back to block 1, its header, and in the header.
fn inLoopAccesses(function: &SsaFunction) -> [usize; 2] {
  let mut found: [usize; 2] = [count(function, Sort.Load, usize.ONE), count(function, Sort.Store, usize.ONE)]
  let mut block: usize = 2
  while block < function.blockCount() {
    let edges = List<Edge>.asSlice(&function.block(block).edges)
    if edges.length == usize.ONE && edges[usize.ZERO].block == usize.ONE {
      found[usize.ZERO] = found[usize.ZERO] + count(function, Sort.Load, block)
      found[usize.ONE] = found[usize.ONE] + count(function, Sort.Store, block)
    }
    block = block + usize.ONE
  }
  return found
}

test effect fn loopsKeepAnArgumentsFieldsInValues() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run fieldLoopClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn fieldLoopClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // A load the loop only repeats moves before it when the argument is known to reach its bytes,
  // though it is not in the header: before the loop it cannot trap either.
  let mut read = run fieldLoop(false, true, false)
  run Testing.expect(run SsaLoops.hoist(&mut read), "a load within an argument's reach is hoisted from the body")
  run Testing.expect((run wellFormed(&read)) && inLoopAccesses(&read)[usize.ZERO] == usize.ZERO, "the loop no longer loads the field")
  let mut unknown = run fieldLoop(false, false, false)
  drop run SsaLoops.hoist(&mut unknown)
  run Testing.expect(inLoopAccesses(&unknown)[usize.ZERO] == usize.ONE, "a load that might trap stays where the loop reaches it")
  // A field the loop also stores lives in a value for the loop's length when nothing else in
  // the loop can reach it: one load before, the byte store alone inside, one store after.
  let mut kept = run fieldLoop(true, true, true)
  run Testing.expect(run SsaLoops.hoist(&mut kept), "a field read and written through an exclusive argument is promoted")
  run Testing.expect(run wellFormed(&kept), "the promoted loop passes the verifier")
  let inside = inLoopAccesses(&kept)
  run Testing.expect(inside[usize.ZERO] == usize.ZERO && inside[usize.ONE] == usize.ONE, "the loop holds only the byte store")
  run Testing.expect(count(&kept, Sort.Load, usize.MAX) == usize.ONE && count(&kept, Sort.Store, usize.MAX) == 2,
    "the field is loaded once before the loop and stored once on the way out")
  // Two plain arguments may reach the same bytes, so the byte store may change the field.
  let mut shared = run fieldLoop(true, true, false)
  drop run SsaLoops.hoist(&mut shared)
  run Testing.expect(inLoopAccesses(&shared)[usize.ZERO] == usize.ONE, "a field another argument may reach stays in memory")
}

test effect fn shiftCountsRequireAUnitLogicalShift() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run shiftLoopClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn shiftLoopClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut variant: u64 = 0
  while variant < 3 {
    let mut amount: u64 = 1
    if variant == 1 { amount = 2 }
    let mut function = run SsaFunction.make(b"width", 32)
    let word = Kind.integer(64)
    let input = run function.argument(word)
    let initial = run function.argument(word)
    function.setResult(word)
    let entry = run function.newBlock()
    let head = run function.newBlock()
    let body = run function.newBlock()
    let exit = run function.newBlock()
    let rest = run function.addParameter(head, word)
    let sum = run function.addParameter(head, word)
    function.startBlock(entry)
    let zero = run function.integer(64, 0)
    let one = run function.integer(64, 1)
    let shift = run function.integer(64, amount)
    if variant == 2 {
      let chosen = run function.compare(Predicate.Ugt, input, initial)
      run function.branchWith(chosen, head, &[input, initial], head, &[initial, input])
    } else {
      run function.jumpWith(head, &[input, initial])
    }
    function.startBlock(head)
    let done = run function.compare(Predicate.Eq, rest, zero)
    run function.branchIf(done, exit, body)
    function.startBlock(body)
    let next = run function.binary(Binary.LShr, rest, shift)
    let added = run function.binary(Binary.Add, sum, one)
    run function.jumpWith(head, &[next, added])
    function.startBlock(exit)
    let result = run function.binary(Binary.Or, rest, sum)
    run function.ret(result)
    run function.finish()
    let rewritten = run SsaIdioms.recognize(&mut function)
    run Testing.expect(rewritten == (amount == 1), "only a one-bit shift has a bit-length trip count")
    let mut expected = usize.ZERO
    if variant != 0 { expected = usize.ONE }
    run Testing.expect(branches(&function) == expected, "only the two-input entry or the non-unit shift keeps a branch")
    run Testing.expect(run wellFormed(&function), "the loop preserves the incoming count and the zero exit")
    variant = variant + 1
  }
}

test effect fn rollingRemaindersRequireBothGuards() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run remainderLoopClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn remainderLoopClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut variant = usize.ZERO
  while variant < 3 {
    let mut function = run SsaFunction.make(b"cycle", 32)
    let word = Kind.integer(32)
    let divisor = run function.argument(word)
    let limit = run function.argument(word)
    function.setResult(word)
    let entry = run function.newBlock()
    let head = run function.newBlock()
    let check = run function.newBlock()
    let body = run function.newBlock()
    let exit = run function.newBlock()
    let index = run function.addParameter(head, word)
    function.startBlock(entry)
    let zero = run function.integer(32, 0)
    let one = run function.integer(32, 1)
    run function.jumpWith(head, &[zero])
    function.startBlock(head)
    let mut comparison = Predicate.Ult
    if variant == 1 { comparison = Predicate.Ule }
    let more = run function.compare(comparison, index, limit)
    run function.branchIf(more, check, exit)
    function.startBlock(check)
    let mut tested = divisor
    if variant == 2 { tested = limit }
    let nonzero = run function.compare(Predicate.Ne, tested, zero)
    run function.branchIf(nonzero, body, exit)
    function.startBlock(body)
    let position = run function.binary(Binary.URem, index, divisor)
    drop run function.call(b"use", &[position], Kind.unit())
    let next = run function.binary(Binary.Add, index, one)
    run function.jumpWith(head, &[next])
    function.startBlock(exit)
    run function.ret(index)
    run function.finish()
    let graph = run SsaGraph.of(&function)
    let changed = run SsaIdioms.reduceRemainders(&mut function, &graph)
    run Testing.expect(changed == (variant == usize.ZERO), "the divisor must be nonzero and the induction value cannot wrap")
    run Testing.expect(run wellFormed(&function), "the rolling index has an input on every edge")
    variant = variant + usize.ONE
  }
}

test effect fn memoryOffsetsRequireReachableBytes() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run memoryOffsetClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn memoryOffsetClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut variant = usize.ZERO
  while variant < 3 {
    let mut function = run SsaFunction.make(b"field", 32)
    let argument = run function.argument(Kind.address(32))
    if variant != 1 { run function.setReach(argument, 16) }
    function.setResult(Kind.integer(32))
    let entry = run function.newBlock()
    function.startBlock(entry)
    let mut offset: u64 = 4
    if variant == 2 { offset = 4294967292 }
    let address = run function.offset(argument, offset)
    let result = run function.load(Kind.integer(32), address, 8, 1)
    run function.ret(result)
    run function.finish()
    drop run forwardWithGraph(&mut function)
    let load = function.producerOf(result)
    run Testing.expect((function.operandsOf(load)[0] == argument) == (variant == usize.ZERO),
      "only an in-range field with a non-wrapping memory immediate uses the original base")
    if let Operation.Load {offset: immediate, alignment} = function.instruction(load).operation {
      let mut expected: u64 = 8
      if variant == usize.ZERO { expected = 12 }
      run Testing.expect(immediate == expected && alignment == 1, "the load keeps its effective address and alignment")
    }
    variant = variant + usize.ONE
  }
}

test effect fn parallelPopulationCountsRequireEveryGroupAndMask() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run populationClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn populationClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut variant = usize.ZERO
  while variant < 3 {
    let mut function = run SsaFunction.make(b"population", 32)
    let kind = Kind.integer(64)
    let x = run function.argument(kind)
    function.setResult(kind)
    let block = run function.newBlock()
    function.startBlock(block)
    let one = run function.integer(64, 1)
    let mut input = x
    if variant == usize.ONE {
      let inverseConstant = run function.integer(64, u64.MAX)
      let inverse = run function.binary(Binary.Xor, x, inverseConstant)
      let previous = run function.binary(Binary.Sub, x, one)
      input = run function.binary(Binary.And, previous, inverse)
    }
    let half = run function.binary(Binary.LShr, input, one)
    let maskedHalfConstant = run function.integer(64, 0x5555555555555555)
    let maskedHalf = run function.binary(Binary.And, half, maskedHalfConstant)
    let pairs = run function.binary(Binary.Sub, input, maskedHalf)
    let mask = run function.integer(64, 0x3333333333333333)
    let low = run function.binary(Binary.And, pairs, mask)
    let upperConstant = run function.integer(64, 2)
    let upper = run function.binary(Binary.LShr, pairs, upperConstant)
    let high = run function.binary(Binary.And, mask, upper)
    let quads = run function.binary(Binary.Add, high, low)
    let otherConstant = run function.integer(64, 4)
    let other = run function.binary(Binary.LShr, quads, otherConstant)
    let sum = run function.binary(Binary.Add, other, quads)
    let mut nibbleMask: u64 = 0x0f0f0f0f0f0f0f0f
    if variant == 2 { nibbleMask = nibbleMask - 1 }
    let bytesConstant = run function.integer(64, nibbleMask)
    let bytes = run function.binary(Binary.And, sum, bytesConstant)
    let productConstant = run function.integer(64, 0x0101010101010101)
    let product = run function.binary(Binary.Mul, bytes, productConstant)
    let resultConstant = run function.integer(64, 56)
    let result = run function.binary(Binary.LShr, product, resultConstant)
    run function.ret(result)
    run function.finish()
    let number = function.producerOf(result)
    drop run SsaFolding.simplify(&mut function, number)
    let op = function.instruction(number).operation
    if variant == 2 {
      let shift = match op { Operation.Binary {operation} => operation == Binary.LShr _ => false }
      run Testing.expect(shift, "a changed nibble mask preserves the arithmetic")
    } else {
      let mut wanted = Count.Ones
      if variant == usize.ONE { wanted = Count.TrailingZeros }
      let counted = match op { Operation.Count {which} => which == wanted _ => false }
      run Testing.expect(counted && function.operandsOf(number).length == usize.ONE && function.operandsOf(number)[0] == x,
        "the exact grouping becomes a unary count of the original word")
    }
    variant = variant + usize.ONE
  }
  return ()
}

test effect fn sharesScaledNeighborAddresses() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run neighborClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn neighborClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut function = run SsaFunction.make(b"neighbors", 32)
  let pointer = run function.argument(Kind.address(32))
  let x = run function.argument(Kind.integer(32))
  let entry = run function.newBlock()
  function.startBlock(entry)
  let eight = run function.integer(32, 8)
  let one = run function.integer(32, 1)
  let scaled = run function.binary(Binary.Mul, x, eight)
  let first = run function.indexed(pointer, scaled)
  let prev = run function.binary(Binary.Sub, x, one)
  let distance = run function.binary(Binary.Mul, eight, prev)
  let second = run function.indexed(pointer, distance)
  drop run function.call(b"use", &[first, second], Kind.unit())
  run function.ret(none())
  run function.finish()
  run Testing.expect(run SsaMemory.shareIndices(&mut function), "neighboring indices share the first address")
  let id = function.producerOf(second)
  let wrapped = match function.instruction(id).operation { Operation.Offset {offset} => offset == 4294967288 _ => false }
  run Testing.expect(wrapped && function.operandsOf(id)[usize.ZERO] == first, "the negative eight-byte displacement wraps at pointer width")
  run Testing.expect(run wellFormed(&function), "the rewritten addresses pass verification")
}

test effect fn indexedImmediatesRequireSlotBounds() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run immediateClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn immediateClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut variant = usize.ZERO
  while variant < 4 {
    let mut function = run SsaFunction.make(b"guarded_offset", 32)
    let word = Kind.integer(32)
    let x = run function.argument(word)
    let arg = run function.argument(Kind.address(32))
    function.setResult(word)
    let entry = run function.newBlock()
    function.startBlock(entry)
    let mut base = run function.slotOf(128, 4)
    if variant == 3 { base = arg }
    let mask = run function.integer(32, 63)
    let low = run function.binary(Binary.And, x, mask)
    let eight = run function.integer(32, 8)
    let index = run function.binary(Binary.Add, low, eight)
    let root = run function.indexed(base, index)
    let mut delta: u64 = 4
    if variant == 1 { delta = 4294967292 }
    if variant == 2 { delta = 56 }
    let ptr = run function.offset(root, delta)
    let result = run function.load(word, ptr, 0, 1)
    run function.ret(result)
    run function.finish()
    drop run numberWithGraph(&mut function)
    let offset = match function.instruction(function.producerOf(result)).operation { Operation.Load {offset, ..} => offset _ => u64.MAX }
    run Testing.expect((offset == 4) == (variant < 2), "only in-bounds loads use a positive immediate")
    run Testing.expect(run wellFormed(&function), "the folded access passes verification")
    variant = variant + usize.ONE
  }
}

test effect fn rescalesOnlyBoundedLoopCounters() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run scaledCounterClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn scaledCounterClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut variant = usize.ZERO
  while variant < 4 {
    let mut f = run SsaFunction.make(b"scaled_counter", 32)
    let int = Kind.integer(32)
    let entry = run f.newBlock()
    let header = run f.newBlock()
    let body = run f.newBlock()
    let done = run f.newBlock()
    let i = run f.addParameter(header, int)
    f.startBlock(entry)
    let one = run f.integer(32, 1)
    let mut limit = run f.integer(32, 64)
    if variant == 1 { limit = run f.integer(32, 1073741824) }
    let four = run f.integer(32, 4)
    run f.jumpWith(header, &[one])
    f.startBlock(header)
    let cond = run f.compare(Predicate.Ugt, limit, i)
    run f.branchIf(cond, body, done)
    f.startBlock(body)
    let offset = run f.binary(Binary.Mul, i, four)
    drop run f.call(b"use", &[offset], Kind.unit())
    if variant == 2 { drop run f.call(b"unscaled", &[i], Kind.unit()) }
    let mut step = one
    if variant == 3 { step = four }
    let next = run f.binary(Binary.Add, i, step)
    run f.jumpWith(header, &[next])
    f.startBlock(done)
    run f.ret(none())
    run f.finish()
    let changed = run scaleCountersWithGraph(&mut f)
    run Testing.expect(changed == (variant == usize.ZERO), "byte counters require fitting endpoints, a guarded unit step and no unscaled users")
    run Testing.expect(run wellFormed(&f), "the byte counter passes verification")
    if changed {
      let begin = List<u64>.get(&List<Edge>.asSlice(&f.block(entry).edges)[usize.ZERO].arguments, usize.ZERO)
      run Testing.expect(f.constantOf(begin).low == 4 && f.operandsOf(f.producerOf(next))[usize.ONE] == four, "both the initial offset and the increment count bytes")
    }
    variant = variant + usize.ONE
  }
}

test effect fn pairsEvenMemoryLoopsInOriginalOrder() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run pairedClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn pairedClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut variant = usize.ZERO
  while variant < 4 {
    let mut trips: u64 = 18
    if variant == 1 { trips = 19 }
    if variant == 2 { trips = 0 }
    let mut f = run summing(trips, variant == 3)
    let body: usize = 2
    let sum = List<u64>.get(&f.block(usize.ONE).parameters, usize.ONE)
    let pointer = run f.constant(Kind.address(32), 1024)
    drop run f.insertInstruction(body, usize.ZERO, Operation.Store {offset: 0, alignment: 4}, Kind.unit(), &[sum, pointer], 0)
    let firstSum = List<u64>.get(&List<Edge>.asSlice(&f.block(body).edges)[0].arguments, usize.ONE)
    let paired = run pairIterationsWithGraph(&mut f)
    run Testing.expect(paired == (variant == usize.ZERO), "only the nonempty even loop with a straight-line memory body is paired")
    run Testing.expect(run wellFormed(&f), "paired loop values pass verification")
    if paired {
      let insts = List<usize>.asSlice(&f.block(body).instructions)
      run Testing.expect(insts.length == 6 && f.operandsOf(insts[0])[0] == sum && f.operandsOf(insts[3])[0] == firstSum,
        "the second store observes the first iteration's accumulated value")
      let counter = List<u64>.get(&List<Edge>.asSlice(&f.block(body).edges)[0].arguments, 0)
      let stride = f.operandsOf(f.producerOf(counter))[1]
      run Testing.expect(f.isBits(stride) && f.constantOf(stride).low == 2, "the back edge advances by both iterations")
    }
    variant = variant + usize.ONE
  }
}

test effect fn rotatesOnlyEnteredLoopsWithDeadExitValues() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run rotationClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rotationClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut variant = usize.ZERO
  while variant < 4 {
    let mut f = run SsaFunction.make(b"rotate", 32)
    let int = Kind.integer(32)
    f.setResult(int)
    let entry = run f.newBlock()
    let head = run f.newBlock()
    let body = run f.newBlock()
    let done = run f.newBlock()
    let i = run f.addParameter(head, int)
    let start = run f.integer(32, 4)
    let mut bound = run f.integer(32, 20)
    if variant == 1 { bound = start }
    if variant == 3 { bound = run f.integer(32, 19) }
    f.startBlock(entry)
    run f.jumpWith(head, &[start])
    f.startBlock(head)
    let stop = run f.compare(Predicate.Uge, i, bound)
    run f.branchIf(stop, done, body)
    f.startBlock(body)
    let next = run f.binary(Binary.Add, i, start)
    run f.jumpWith(head, &[next])
    f.startBlock(done)
    if variant == 2 { run f.ret(i) } else { run f.ret(bound) }
    run f.finish()
    let changed = run rotateWithGraph(&mut f)
    run Testing.expect(changed == (variant == usize.ZERO), "the entry must execute and the last header values must be dead")
    run Testing.expect(run wellFormed(&f), "the loop with its inverted exit condition passes verification")
    variant = variant + usize.ONE
  }
}

test effect fn selectsOnlyPrivateInBoundsStores() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run privateStoreClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn privateStoreClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut variant = usize.ZERO
  while variant < 4 {
    let mut f = run SsaFunction.make(b"conditional_store", 32)
    let int = Kind.integer(32)
    let x = run f.argument(int)
    let value = run f.argument(int)
    let entry = run f.newBlock()
    let write = run f.newBlock()
    let exit = run f.newBlock()
    f.startBlock(entry)
    let slot = run f.slotOf(64, 4)
    if variant == 1 { drop run f.call(b"escape", &[slot], Kind.unit()) }
    let mut mask = run f.integer(32, 15)
    if variant == 2 { mask = run f.integer(32, 63) }
    let i = run f.binary(Binary.And, x, mask)
    let ptr = run f.indexed(slot, i)
    let old = run f.load(int, ptr, 0, 1)
    let smaller = run f.compare(Predicate.Ult, value, old)
    run f.branchIf(smaller, write, exit)
    f.startBlock(write)
    if variant == 3 { drop run f.call(b"side_effect", &[], Kind.unit()) }
    run f.store(value, ptr, 0, 1)
    run f.jump(exit)
    f.startBlock(exit)
    run f.ret(none())
    run f.finish()
    drop run numberWithGraph(&mut f)
    run Testing.expect((count(&f, Sort.Select, entry) == usize.ONE) == (variant == usize.ZERO), "only the in-bounds private update can store unconditionally")
    run Testing.expect(run wellFormed(&f), "the selected store passes verification")
    variant = variant + usize.ONE
  }
}

test effect fn wordMasksPreserveOtherVectorUsers() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run wordMaskClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn wordMaskClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut variant = usize.ZERO
  while variant < 3 {
    let mut f = run SsaFunction.make(b"byte_classes", 32)
    let ptr = run f.argument(Kind.address(32))
    let entry = run f.newBlock()
    f.setResult(Kind.flag())
    f.startBlock(entry)
    let vec = Kind.vector(Kind.integer(8), 16)
    let data = run f.load(vec, ptr, 0, 1)
    let tab = run f.integer(8, 9)
    let splat = run f.splat(tab, 16)
    let matches = run f.compare(Predicate.Eq, data, splat)
    let present = run f.reduce(Reduction.Or, matches, none())
    if variant == 1 { drop run f.call(b"raw", &[data], Kind.unit()) }
    if variant == 2 { drop run f.call(b"mask", &[matches], Kind.unit()) }
    run f.ret(present)
    run f.finish()
    let changed = run lowerPackedBytesWithGraph(&mut f)
    run Testing.expect(changed == (variant == usize.ZERO), "word masks require all vector and mask users to be covered")
    run Testing.expect(run wellFormed(&f), "word-at-a-time classification preserves SSA")
    variant = variant + usize.ONE
  }
}

test effect fn packsOnlyConsecutiveInBoundsConstantStores() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run packedStoreClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn packedStoreClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut variant = usize.ZERO
  while variant < 4 {
    let mut f = run SsaFunction.make(b"packed_initializers", 32)
    let dst = run f.argument(Kind.address(32))
    run f.setExclusive(dst)
    if variant != 1 { run f.setReach(dst, 5) }
    let block = run f.newBlock()
    f.startBlock(block)
    let a = run f.integer(8, 0x81)
    let b = run f.integer(16, 0x2345)
    let c = run f.integer(8, 0xfe)
    run f.store(a, dst, 1, 1)
    let first = f.instructionCount() - usize.ONE
    if variant == 2 { drop run f.call(b"observe", &[dst], Kind.unit()) }
    run f.store(b, dst, 2, 1)
    let mut end: u64 = 4
    if variant == 3 { end = 5 }
    run f.store(c, dst, end, 1)
    run f.ret(none())
    run f.finish()
    let changed = run SsaMemory.packStores(&mut f)
    run Testing.expect(changed == (variant == usize.ZERO), "a gap, an intervening call, or an unknown bound prevents combining the stores")
    run Testing.expect(run wellFormed(&f), "the packed initializer passes verification")
    if changed {
      let word = f.operandsOf(first)[0]
      run Testing.expect(count(&f, Sort.Store, usize.MAX) == 1 && f.kindOf(word).bits == 32 && f.constantOf(word).low == 0xfe234581,
        "a byte, halfword and byte become one unaligned little-endian store")
    }
    variant = variant + usize.ONE
  }
}

test effect fn bitCountsStayWithinTheirInputRange() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run bitCountRanges() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn bitCountRanges() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut f = run SsaFunction.make(b"counts", 32)
  let byte = run f.argument(Kind.integer(8))
  let set = run f.newBlock()
  let nonzero = run f.newBlock()
  let out = run f.newBlock()
  f.startBlock(set)
  let zero = run f.integer(32, 0)
  let word = run f.cast(Cast.ZExt, byte, Kind.integer(32))
  let eight = run f.integer(32, 8)
  let full = run f.integer(32, 32)
  let ones = run f.countBits(Count.Ones, word)
  let tooMany = run f.compare(Predicate.Ugt, ones, eight)
  let trailing = run f.countBits(Count.TrailingZeros, word)
  let allZero = run f.compare(Predicate.Eq, trailing, full)
  drop run f.call(b"observe", &[tooMany, allZero], Kind.unit())
  let positive = run f.compare(Predicate.Ugt, word, zero)
  run f.branchIf(positive, nonzero, out)
  f.startBlock(nonzero)
  let leading = run f.countBits(Count.LeadingZeros, word)
  let low = run f.integer(32, 24)
  let below = run f.compare(Predicate.Ult, leading, low)
  let above = run f.compare(Predicate.Uge, leading, full)
  let excessive = run f.compare(Predicate.Uge, trailing, eight)
  drop run f.call(b"observeNonzero", &[below, above, excessive], Kind.unit())
  run f.jump(out)
  f.startBlock(out)
  run f.ret(none())
  run f.finish()
  drop run numberWithGraph(&mut f)
  drop run eliminateWithGraph(&mut f)
  run Testing.expect(run wellFormed(&f), "the bit counts pass verification")
  run Testing.expect(count(&f, Sort.Compare, usize.MAX) == 2,
    "the nonzero byte guard and the zero input's full trailing count remain possible")

  let mut g = run SsaFunction.make(b"width-minus-bit-length", 32)
  let input = run g.argument(Kind.integer(32))
  g.setResult(Kind.integer(32))
  drop run g.newBlock()
  let width = run g.integer(32, 32)
  let leadingZeros = run g.countBits(Count.LeadingZeros, input)
  let length = run g.binary(Binary.Sub, width, leadingZeros)
  let countAgain = run g.binary(Binary.Sub, width, length)
  run g.ret(countAgain)
  run g.finish()
  drop run numberWithGraph(&mut g)
  drop run eliminateWithGraph(&mut g)
  run Testing.expect(g.block(0).value == leadingZeros, "subtracting the bit length from the width leaves its leading-zero count")
}

test effect fn preservesTwoResultCallsAndPairReturnsThroughPipeline() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run pairPipelineClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn pairPipelineClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut f = run SsaFunction.make(b"pair_pipeline", 64)
  let i64Kind = Kind.integer(64)
  let f64Kind = Kind.float(64)
  let x = run f.argument(i64Kind)
  f.setCallingConvention(CallingConvention.C, false, AbiExtension.None)
  f.setResults(i64Kind, f64Kind)
  let entry = run f.newBlock()
  f.startBlock(entry)
  let abi = run f.addCallAbi(CallingConvention.C, AbiExtension.None, &[ParameterAbi.plain()])
  let pair = run f.callWithAbi(b"make_pair", &[x], i64Kind, f64Kind, abi)
  let one = run f.integer(64, 1)
  let dead = run f.binary(Binary.Mul, x, one)
  drop dead
  let first = run f.binary(Binary.Add, pair, one)
  let second = run f.binary(Binary.Add, pair + 1, pair + 1)
  run f.retPair(first, second)
  run f.finish()
  run SsaPipeline.prepare(&mut f, Level.Speed, true)
  run Testing.expect(run wellFormed(&f), "2-result call and pair return pass full speed pipeline with verification")
  let exitBlock = returning(&f)
  run Testing.expect(exitBlock != usize.MAX, "a returning block remains")
  run Testing.expect(f.block(exitBlock).value != none() && f.block(exitBlock).secondValue != none(),
    "both primary and secondary return values stay live through DCE and speed passes")
  run Testing.expect(count(&f, Sort.Call, usize.MAX) == usize.ONE, "the 2-result call is preserved")
}

test effect fn deduplicatesArchIntrinsicsAndPreservesInlineAsmBarriers() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run archAndAsmPassClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn archAndAsmPassClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut f = run SsaFunction.make(b"arch_gvn", 64)
  let v2i64 = Kind.vector(Kind.integer(64), 2)
  let v4i32 = Kind.vector(Kind.integer(32), 4)
  let a = run f.argument(v2i64)
  let b = run f.argument(v2i64)
  let c = run f.argument(v4i32)
  let ptr = run f.argument(Kind.address(64))
  f.setResult(Kind.integer(64))
  let entry = run f.newBlock()
  f.startBlock(entry)
  // Two identical pure ArchIntrinsics -> GVN merges them into one.
  let aes1 = run f.archIntrinsic(ArchOperation.X86AesEncrypt, 0, &[a, b], v2i64)
  let aes2 = run f.archIntrinsic(ArchOperation.X86AesEncrypt, 0, &[a, b], v2i64)
  let aesXor = run f.binary(Binary.Xor, aes1, aes2)
  // Two ArchIntrinsics with different immediates -> must NOT merge.
  let sha0 = run f.archIntrinsic(ArchOperation.X86Sha1Rounds4, 0, &[c, c], v4i32)
  let sha1 = run f.archIntrinsic(ArchOperation.X86Sha1Rounds4, 1, &[c, c], v4i32)
  let shaXor = run f.binary(Binary.Xor, sha0, sha1)
  // Two identical InlineAsm blocks -> must NOT merge, and memory-writing asm blocks forwarding.
  let fortyTwo = run f.integer(64, 42)
  run f.store(fortyTwo, ptr, 0, 8)
  let t0 = run f.inlineAsm(b"rdtsc", b"=r", b"", MemoryEffect.None, false, false, &[], Kind.integer(64))
  let t1 = run f.inlineAsm(b"rdtsc", b"=r", b"", MemoryEffect.None, false, false, &[], Kind.integer(64))
  drop run f.inlineAsm(b"lock; nop", b"", b"memory", MemoryEffect.ReadWrite, true, false, &[], Kind.unit())
  let reloaded = run f.load(Kind.integer(64), ptr, 0, 8)
  let zero32 = run f.integer(32, 0)
  let e0 = run f.extractElement(aesXor, zero32)
  let shaElem = run f.extractElement(shaXor, zero32)
  let e1 = run f.cast(Cast.ZExt, shaElem, Kind.integer(64))
  let sum0 = run f.binary(Binary.Add, t0, t1)
  let sum1 = run f.binary(Binary.Add, sum0, reloaded)
  let sum2 = run f.binary(Binary.Add, sum1, e0)
  let total = run f.binary(Binary.Add, sum2, e1)
  run f.ret(total)
  run f.finish()
  run SsaPipeline.prepare(&mut f, Level.Speed, true)
  run Testing.expect(run wellFormed(&f), "arch intrinsic + inline asm function passes full speed pipeline")
  // aes1 ^ aes2 folds to 0 after GVN merges aes2 -> aes1, leaving sha0 + sha1 = 2 arch intrinsics!
  run Testing.expect(count(&f, Sort.Arch, usize.MAX) == 2,
    "identical pure ArchIntrinsics are deduplicated while distinct immediates stay separate")
  run Testing.expect(count(&f, Sort.Asm, usize.MAX) == 3,
    "distinct InlineAsm instructions are never merged by GVN and side-effecting asm stays")
  run Testing.expect(count(&f, Sort.Load, usize.MAX) == usize.ONE,
    "load after memory-clobbering InlineAsm is not forwarded across the barrier")
}

fn countArchOp(function: &SsaFunction, target: ArchOperation) -> usize {
  let mut total = usize.ZERO
  let mut at = usize.ZERO
  while at < function.blockCount() {
    let listed = List<usize>.asSlice(&function.block(at).instructions)
    let mut position = usize.ZERO
    while position < listed.length {
      if let Operation.ArchIntrinsic {operation, ..} = function.instruction(listed[position]).operation {
        if operation == target { total = total + usize.ONE }
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return total
}

test effect fn deduplicatesAarch64ArchIntrinsicsWithoutColliding() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run aarch64ArchPassClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn aarch64ArchPassClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut f = run SsaFunction.make(b"aarch64_arch_gvn", 64)
  let v16i8 = Kind.vector(Kind.integer(8), 16)
  let v4i32 = Kind.vector(Kind.integer(32), 4)
  let acc = run f.argument(v4i32)
  let tblData = run f.argument(v16i8)
  let tblIdx = run f.argument(v16i8)
  f.setResult(v4i32)
  let entry = run f.newBlock()
  f.startBlock(entry)

  let tbl1 = run f.archIntrinsic(ArchOperation.Aarch64TableLookup, 0, &[tblData, tblIdx], v16i8)
  let tbl2 = run f.archIntrinsic(ArchOperation.Aarch64TableLookup, 0, &[tblData, tblIdx], v16i8)
  let tblSum = run f.binary(Binary.Add, tbl1, tbl2)
  let ud = run f.archIntrinsic(ArchOperation.Aarch64UnsignedDotProduct, 0, &[acc, tblData, tblIdx], v4i32)
  let sd = run f.archIntrinsic(ArchOperation.Aarch64SignedDotProduct, 0, &[acc, tblData, tblIdx], v4i32)
  let dotXor = run f.binary(Binary.Xor, ud, sd)
  let tbl32 = run f.cast(Cast.Bitcast, tblSum, v4i32)
  let out = run f.binary(Binary.Xor, dotXor, tbl32)
  run f.ret(out)
  run f.finish()

  run SsaPipeline.prepare(&mut f, Level.Speed, true)
  run Testing.expect(run wellFormed(&f), "AArch64 arch intrinsic function passes full speed pipeline with verification")
  run Testing.expect(count(&f, Sort.Arch, usize.MAX) == 3, "only the duplicate tbl merges; udot and sdot remain distinct")
  run Testing.expect(countArchOp(&f, ArchOperation.Aarch64TableLookup) == usize.ONE, "one Aarch64TableLookup remains after GVN")
  run Testing.expect(countArchOp(&f, ArchOperation.Aarch64UnsignedDotProduct) == usize.ONE, "one Aarch64UnsignedDotProduct remains")
  run Testing.expect(countArchOp(&f, ArchOperation.Aarch64SignedDotProduct) == usize.ONE, "one Aarch64SignedDotProduct remains")
}

test effect fn handlesSlotLifetimeMarkersInPromotionAndMemory() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run slotLifetimePassClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn slotLifetimePassClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // Case 1: non-escaping scalar slot with SlotStart/SlotEnd is promoted and its markers removed.
  let mut promoted = run SsaFunction.make(b"promoted_lifetime", 64)
  let i64Kind = Kind.integer(64)
  let arg = run promoted.argument(i64Kind)
  promoted.setResult(i64Kind)
  let b0 = run promoted.newBlock()
  promoted.startBlock(b0)
  let s0 = run promoted.slotOf(8, 8)
  run promoted.slotStart(0)
  run promoted.store(arg, s0, 0, 8)
  let val = run promoted.load(i64Kind, s0, 0, 8)
  run promoted.slotEnd(0)
  run promoted.ret(val)
  run promoted.finish()
  run promoteWithGraph(&mut promoted, true)
  run Testing.expect(run wellFormed(&promoted), "promoting a slot with lifetime markers produces valid SSA")
  run Testing.expect(count(&promoted, Sort.SlotMarker, usize.MAX) == usize.ZERO,
    "promoting a stack slot removes its SlotStart and SlotEnd markers")
  run Testing.expect(count(&promoted, Sort.Load, usize.MAX) == usize.ZERO && count(&promoted, Sort.Store, usize.MAX) == usize.ZERO,
    "promoted slot loads and stores are eliminated")

  // Case 2: escaped slot keeps its SlotStart/SlotEnd markers and blocks forwarding across boundaries.
  let mut escaped = run SsaFunction.make(b"escaped_lifetime", 64)
  escaped.setResult(i64Kind)
  let e0 = run escaped.newBlock()
  escaped.startBlock(e0)
  let slot = run escaped.slotOf(8, 8)
  run escaped.slotStart(0)
  drop run escaped.call(b"observe_slot", &[slot], Kind.unit())
  let seven = run escaped.integer(64, 7)
  run escaped.store(seven, slot, 0, 8)
  run escaped.slotEnd(0)
  run escaped.slotStart(0)
  let after = run escaped.load(i64Kind, slot, 0, 8)
  run escaped.slotEnd(0)
  run escaped.ret(after)
  run escaped.finish()
  run SsaPipeline.prepare(&mut escaped, Level.Speed, true)
  run Testing.expect(run wellFormed(&escaped), "escaped slot with lifetime markers passes full speed pipeline")
  run Testing.expect(count(&escaped, Sort.SlotMarker, usize.MAX) == 4,
    "unpromoted escaped slot preserves its SlotStart and SlotEnd markers")
  run Testing.expect(count(&escaped, Sort.Load, usize.MAX) == usize.ONE,
    "store-to-load forwarding does not cross a SlotEnd/SlotStart lifetime boundary")
}

test effect fn foldsRotatesConstantIndicesAndTightensNonZeroRanges() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run phase5SsaClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn phase5SsaClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // 1. Scalar rotate recognition on i32 (`|`) and i64 (`^`), and rejection of mismatched shifts.
  let mut rot = run SsaFunction.make(b"rot_idioms", 64)
  let i32K = Kind.integer(32)
  let i64K = Kind.integer(64)
  let x32 = run rot.argument(i32K)
  let y64 = run rot.argument(i64K)
  rot.setResult(i64K)
  let rb0 = run rot.newBlock()
  rot.startBlock(rb0)
  let s7 = run rot.integer(32, 7)
  let s25 = run rot.integer(32, 25)
  let s24 = run rot.integer(32, 24)
  let shl32 = run rot.binary(Binary.Shl, x32, s7)
  let shr32 = run rot.binary(Binary.LShr, x32, s25)
  let r32 = run rot.binary(Binary.Or, shl32, shr32)
  let badShr32 = run rot.binary(Binary.LShr, x32, s24)
  let bad32 = run rot.binary(Binary.Or, shl32, badShr32)
  let s13 = run rot.integer(64, 13)
  let s51 = run rot.integer(64, 51)
  let shl64 = run rot.binary(Binary.Shl, y64, s13)
  let shr64 = run rot.binary(Binary.LShr, y64, s51)
  let r64 = run rot.binary(Binary.Xor, shr64, shl64)
  let extGood = run rot.cast(Cast.ZExt, r32, i64K)
  let extBad = run rot.cast(Cast.ZExt, bad32, i64K)
  let sum0 = run rot.binary(Binary.Add, r64, extGood)
  let sum1 = run rot.binary(Binary.Add, sum0, extBad)
  run rot.ret(sum1)
  run rot.finish()
  run SsaPipeline.prepare(&mut rot, Level.Speed, true)
  run Testing.expect(run wellFormed(&rot), "folded rotate function passes verification")
  let mut rotCount = usize.ZERO
  let mut instAt = usize.ZERO
  while instAt < rot.instructionCount() {
    let inst = rot.instruction(instAt)
    if !inst.removed {
      if let Operation.Rotate {left} = inst.operation {
        if left { rotCount = rotCount + usize.ONE }
      }
    }
    instAt = instAt + usize.ONE
  }
  run Testing.expect(rotCount == 2,
    "complementary i32 and i64 shifts fold into Operation.Rotate while mismatched shifts stay separate")

  // 2. Constant Index -> Offset chain folding, associative constant folding, redundant mask elision,
  //    and shift pair merging.
  let mut fold = run SsaFunction.make(b"fold_chains", 64)
  let ptr = run fold.argument(Kind.address(64))
  let v = run fold.argument(i64K)
  fold.setResult(i64K)
  let fb0 = run fold.newBlock()
  fold.startBlock(fb0)
  let c16 = run fold.integer(64, 16)
  let c8 = run fold.integer(64, 8)
  let p1 = run fold.indexed(ptr, c16)
  let p2 = run fold.indexed(p1, c8)
  let loaded = run fold.load(i64K, p2, 0, 8)
  let c5 = run fold.integer(64, 5)
  let c7 = run fold.integer(64, 7)
  let a1 = run fold.binary(Binary.Add, v, c5)
  let a2 = run fold.binary(Binary.Add, a1, c7)
  let mFF = run fold.integer(64, 0xff)
  let mFFF = run fold.integer(64, 0xfff)
  let m1 = run fold.binary(Binary.And, loaded, mFF)
  let m2 = run fold.binary(Binary.And, m1, mFFF)
  let c4 = run fold.integer(64, 4)
  let c3 = run fold.integer(64, 3)
  let sh1 = run fold.binary(Binary.LShr, a2, c4)
  let sh2 = run fold.binary(Binary.LShr, sh1, c3)
  let out = run fold.binary(Binary.Add, sh2, m2)
  run fold.ret(out)
  run fold.finish()
  run SsaPipeline.prepare(&mut fold, Level.Speed, true)
  run Testing.expect(run wellFormed(&fold), "folded address/arithmetic chains pass verification")
  let mut addCount = usize.ZERO
  let mut andCount = usize.ZERO
  let mut shrCount = usize.ZERO
  let mut idxCount = usize.ZERO
  instAt = usize.ZERO
  while instAt < fold.instructionCount() {
    let inst = fold.instruction(instAt)
    if !inst.removed {
      match inst.operation {
        Operation.Index => { idxCount = idxCount + usize.ONE }
        Operation.Binary {operation} => {
          if operation == Binary.Add { addCount = addCount + usize.ONE }
          if operation == Binary.And { andCount = andCount + usize.ONE }
          if operation == Binary.LShr { shrCount = shrCount + usize.ONE }
        }
        _ => {}
      }
    }
    instAt = instAt + usize.ONE
  }
  run Testing.expect(idxCount == usize.ZERO, "constant Index chains canonicalize into Offset")
  run Testing.expect(addCount == 2 && andCount == usize.ONE && shrCount == usize.ONE,
    "associative Add, redundant And mask, and consecutive LShr each collapse to a single instruction")

  // 3. GVN range propagation through Ne 0, UDiv, and Select.
  let mut rng = run SsaFunction.make(b"range_tighten", 64)
  let x = run rng.argument(i64K)
  let flag = run rng.argument(Kind.integer(1))
  rng.setResult(i64K)
  let gb0 = run rng.newBlock()
  let gb1 = run rng.newBlock()
  let gb2 = run rng.newBlock()
  let gb3 = run rng.newBlock()
  rng.startBlock(gb0)
  let zero = run rng.integer(64, 0)
  let forty = run rng.integer(64, 40)
  let isNz = run rng.compare(Predicate.Ne, x, zero)
  run rng.branchIf(isNz, gb1, gb3)
  rng.startBlock(gb1)
  let under40 = run rng.compare(Predicate.Ult, x, forty)
  run rng.branchIf(under40, gb2, gb3)
  rng.startBlock(gb2)
  let checkGt0 = run rng.compare(Predicate.Ugt, x, zero)
  let four = run rng.integer(64, 4)
  let q = run rng.binary(Binary.UDiv, x, four)
  let ten = run rng.integer(64, 10)
  let twenty = run rng.integer(64, 20)
  let thirty = run rng.integer(64, 30)
  let checkDiv = run rng.compare(Predicate.Ult, q, ten)
  let sel = run rng.select(flag, ten, twenty)
  let checkSel = run rng.compare(Predicate.Ult, sel, thirty)
  let bAnd1 = run rng.binary(Binary.And, checkGt0, checkDiv)
  let bAnd2 = run rng.binary(Binary.And, bAnd1, checkSel)
  let ext = run rng.cast(Cast.ZExt, bAnd2, i64K)
  run rng.ret(ext)
  rng.startBlock(gb3)
  run rng.ret(zero)
  run rng.finish()
  run SsaPipeline.prepare(&mut rng, Level.Speed, true)
  run Testing.expect(run wellFormed(&rng), "range-tightened function passes verification")
  let gb2Ret = rng.block(gb2).value
  run Testing.expect(rng.isBits(gb2Ret) && rng.constantOf(gb2Ret).low == 1,
    "Ne 0, UDiv, and Select ranges prove all three guards true and fold gb2 return to 1")
}

test effect fn backEdgeAndTwoPhasePipelineSynergy() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run backEdgeAndPipelineClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn backEdgeAndPipelineClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let i1K = Kind.integer(1)
  let i32K = Kind.integer(32)
  let i64K = Kind.integer(64)
  let ptrK = Kind.address(64)

  // 1a. Acyclic diamond CFG: hasBackEdge == false.
  let mut diamond = run SsaFunction.make(b"diamond", 64)
  let dCond = run diamond.argument(i1K)
  diamond.setResult(i64K)
  let db0 = run diamond.newBlock()
  let db1 = run diamond.newBlock()
  let db2 = run diamond.newBlock()
  let db3 = run diamond.newBlock()
  diamond.startBlock(db0)
  run diamond.branchIf(dCond, db1, db2)
  diamond.startBlock(db1)
  let dOne = run diamond.integer(64, 1)
  run diamond.jumpWith(db3, &[dOne])
  diamond.startBlock(db2)
  let dTwo = run diamond.integer(64, 2)
  run diamond.jumpWith(db3, &[dTwo])
  diamond.startBlock(db3)
  let dOut = run diamond.addParameter(db3, i64K)
  run diamond.ret(dOut)
  run diamond.finish()
  let dGraph = run SsaGraph.of(&diamond)
  run Testing.expect(!dGraph.hasBackEdge(), "acyclic diamond CFG has no back-edge")

  // 1b. Acyclic entry with an unreachable self-loop block: hasBackEdge == false.
  let mut deadLoop = run SsaFunction.make(b"dead_loop", 64)
  deadLoop.setResult(i64K)
  let ub0 = run deadLoop.newBlock()
  let ub1 = run deadLoop.newBlock()
  deadLoop.startBlock(ub0)
  let uZero = run deadLoop.integer(64, 0)
  run deadLoop.ret(uZero)
  deadLoop.startBlock(ub1)
  run deadLoop.jump(ub1)
  run deadLoop.finish()
  let uGraph = run SsaGraph.of(&deadLoop)
  run Testing.expect(!uGraph.hasBackEdge(), "unreachable self-loop does not mark hasBackEdge")

  // 1c. Natural loop: hasBackEdge == true.
  let mut natLoop = run SsaFunction.make(b"natural_loop", 64)
  let nCond = run natLoop.argument(i1K)
  let nb0 = run natLoop.newBlock()
  let nb1 = run natLoop.newBlock()
  let nb2 = run natLoop.newBlock()
  let nb3 = run natLoop.newBlock()
  natLoop.startBlock(nb0)
  run natLoop.jump(nb1)
  natLoop.startBlock(nb1)
  run natLoop.branchIf(nCond, nb2, nb3)
  natLoop.startBlock(nb2)
  run natLoop.jump(nb1)
  natLoop.startBlock(nb3)
  run natLoop.ret(none())
  run natLoop.finish()
  let nGraph = run SsaGraph.of(&natLoop)
  run Testing.expect(nGraph.hasBackEdge(), "natural loop sets hasBackEdge")

  // 1d. Reachable self-loop: hasBackEdge == true.
  let mut selfLoop = run SsaFunction.make(b"self_loop", 64)
  let sCond = run selfLoop.argument(i1K)
  let sb0 = run selfLoop.newBlock()
  let sb1 = run selfLoop.newBlock()
  let sb2 = run selfLoop.newBlock()
  selfLoop.startBlock(sb0)
  run selfLoop.jump(sb1)
  selfLoop.startBlock(sb1)
  run selfLoop.branchIf(sCond, sb1, sb2)
  selfLoop.startBlock(sb2)
  run selfLoop.ret(none())
  run selfLoop.finish()
  let sGraph = run SsaGraph.of(&selfLoop)
  run Testing.expect(sGraph.hasBackEdge(), "reachable self-loop sets hasBackEdge")

  // 1e. Irreducible two-entry cycle: hasBackEdge == true.
  let mut irred = run SsaFunction.make(b"irreducible", 64)
  let irC0 = run irred.argument(i1K)
  let irC1 = run irred.argument(i1K)
  let ibEntry = run irred.newBlock()
  let ibA = run irred.newBlock()
  let ibB = run irred.newBlock()
  let ibExit = run irred.newBlock()
  irred.startBlock(ibEntry)
  run irred.branchIf(irC0, ibA, ibB)
  irred.startBlock(ibA)
  run irred.branchIf(irC1, ibB, ibExit)
  irred.startBlock(ibB)
  run irred.branchIf(irC1, ibA, ibExit)
  irred.startBlock(ibExit)
  run irred.ret(none())
  run irred.finish()
  let irGraph = run SsaGraph.of(&irred)
  run Testing.expect(irGraph.hasBackEdge(), "irreducible two-entry cycle sets hasBackEdge")

  // 2. Two-phase SsaPipeline synergy: factorIndices -> DCE -> scaleCounters -> rotate.
  // Counted loop `i: 0..63` indexing `base + (row + i) * 4`, storing into `dst`.
  let mut f = run SsaFunction.make(b"factor_scale_rotate", 64)
  let base = run f.argument(ptrK)
  let dst = run f.argument(ptrK)
  let row = run f.argument(i64K)
  let fb0 = run f.newBlock()
  let fbHeader = run f.newBlock()
  let fbBody = run f.newBlock()
  let fbExit = run f.newBlock()
  f.startBlock(fb0)
  let fZero = run f.integer(64, 0)
  run f.jumpWith(fbHeader, &[fZero])
  f.startBlock(fbHeader)
  let fi = run f.addParameter(fbHeader, i64K)
  let fLimit = run f.integer(64, 63)
  let fCont = run f.compare(Predicate.Ult, fi, fLimit)
  run f.branchIf(fCont, fbBody, fbExit)
  f.startBlock(fbBody)
  let fRowI = run f.binary(Binary.Add, row, fi)
  let fFour = run f.integer(64, 4)
  let fBytes = run f.binary(Binary.Mul, fRowI, fFour)
  let fAddr = run f.indexed(base, fBytes)
  let fVal = run f.load(i32K, fAddr, 0, 4)
  run f.store(fVal, dst, 0, 4)
  let fOne = run f.integer(64, 1)
  let fNext = run f.binary(Binary.Add, fi, fOne)
  run f.jumpWith(fbHeader, &[fNext])
  f.startBlock(fbExit)
  run f.ret(none())
  run f.finish()
  run SsaPipeline.prepare(&mut f, Level.Speed, true)
  run Testing.expect(run wellFormed(&f), "factor/scale/rotate synergy loop passes verification")
  let mut mulInLoop = usize.ZERO
  let mut scaledStepFound = false
  let mut rotatedLatch = false
  let fGraph = run SsaGraph.of(&f)
  let mut b = usize.ZERO
  while b < f.blockCount() {
    if fGraph.reaches(b) {
      let edges = List<Edge>.asSlice(&f.block(b).edges)
      let mut isLatch = false
      let mut e = usize.ZERO
      while e < edges.length {
        if fGraph.orderOf(edges[e].block) <= fGraph.orderOf(b) { isLatch = true }
        e = e + usize.ONE
      }
      if isLatch && f.block(b).exit == Exit.Branch { rotatedLatch = true }
      let listed = List<usize>.asSlice(&f.block(b).instructions)
      let mut k = usize.ZERO
      while k < listed.length {
        let inst = f.instruction(listed[k])
        if !inst.removed {
          if let Operation.Binary {operation} = inst.operation {
            if operation == Binary.Mul && b != usize.ZERO { mulInLoop = mulInLoop + usize.ONE }
            if operation == Binary.Add && b != usize.ZERO {
              let ops = f.operandsOf(listed[k])
              if (f.isBits(ops[usize.ZERO]) && f.constantOf(ops[usize.ZERO]).low == 4)
                || (f.isBits(ops[usize.ONE]) && f.constantOf(ops[usize.ONE]).low == 4) {
                scaledStepFound = true
              }
            }
          }
        }
        k = k + usize.ONE
      }
    }
    b = b + usize.ONE
  }
  run Testing.expect(mulInLoop == usize.ZERO && scaledStepFound && rotatedLatch,
    "2-phase pipeline runs factorIndices, DCE, scaleCounters (step 4, no loop mul), and rotates latch branch")
}

test effect fn promotesSingleBlockScalarVectorAndMaskSlots() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run singleBlockScalarPromotionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn singleBlockScalarPromotionClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut f = run SsaFunction.make(b"single_block_scalars", 64)
  let i64K = Kind.integer(64)
  let v4i32K = Kind.vector(Kind.integer(32), 4)
  let m16K = Kind.vector(Kind.integer(1), 16)
  let x = run f.argument(i64K)
  let v = run f.argument(v4i32K)
  let m = run f.argument(m16K)
  f.setResult(i64K)
  let entry = run f.newBlock()
  f.startBlock(entry)
  let s0 = run f.slotOf(8, 8)
  let s1 = run f.slotOf(16, 16)
  let s2 = run f.slotOf(2, 2)
  run f.store(x, s0, 0, 8)
  let loadedX = run f.load(i64K, s0, 0, 8)
  let one = run f.integer(64, 1)
  let inc = run f.binary(Binary.Add, loadedX, one)
  run f.store(inc, s0, 0, 8)
  let finalX = run f.load(i64K, s0, 0, 8)
  run f.store(v, s1, 0, 16)
  let loadedV = run f.load(v4i32K, s1, 0, 16)
  let zero32 = run f.integer(32, 0)
  let lane0 = run f.extractElement(loadedV, zero32)
  let laneExt = run f.cast(Cast.ZExt, lane0, i64K)
  run f.store(m, s2, 0, 2)
  let loadedM = run f.load(m16K, s2, 0, 2)
  let bit0 = run f.extractElement(loadedM, zero32)
  let bitExt = run f.cast(Cast.ZExt, bit0, i64K)
  let sum0 = run f.binary(Binary.Add, finalX, laneExt)
  let total = run f.binary(Binary.Add, sum0, bitExt)
  run f.ret(total)
  run f.finish()
  run SsaPromotion.promoteScalars(&mut f)
  run Testing.expect(run wellFormed(&f), "single-block scalar, vector, and mask promotion produces valid SSA")
  run Testing.expect(count(&f, Sort.SlotAddress, usize.MAX) == usize.ZERO, "single-block promoted slots drop all SlotAddress ops")
  run Testing.expect(count(&f, Sort.Load, usize.MAX) == usize.ZERO && count(&f, Sort.Store, usize.MAX) == usize.ZERO,
    "single-block scalar, 128-bit vector, and mask loads/stores are eliminated")
  run Testing.expect(List<u64>.length(&f.block(usize.ZERO).parameters) == usize.ZERO,
    "single-block promotion introduces zero block parameters")
}

test effect fn promotesCrossBlockScalarSlotsInDiamondAndLoop() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run crossBlockScalarPromotionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn crossBlockScalarPromotionClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let i64K = Kind.integer(64)
  // Subcase A: diamond join.
  let mut diamond = run SsaFunction.make(b"diamond_scalar", 64)
  let flag = run diamond.argument(Kind.integer(1))
  let a = run diamond.argument(i64K)
  let b = run diamond.argument(i64K)
  diamond.setResult(i64K)
  let entry = run diamond.newBlock()
  let left = run diamond.newBlock()
  let right = run diamond.newBlock()
  let join = run diamond.newBlock()
  diamond.startBlock(entry)
  let slot = run diamond.slotOf(8, 8)
  run diamond.branchIf(flag, left, right)
  diamond.startBlock(left)
  run diamond.store(a, slot, 0, 8)
  run diamond.jump(join)
  diamond.startBlock(right)
  run diamond.store(b, slot, 0, 8)
  run diamond.jump(join)
  diamond.startBlock(join)
  let joined = run diamond.load(i64K, slot, 0, 8)
  run diamond.ret(joined)
  run diamond.finish()
  run SsaPromotion.promoteScalars(&mut diamond)
  run Testing.expect(run wellFormed(&diamond), "diamond scalar promotion produces valid SSA")
  run Testing.expect(count(&diamond, Sort.SlotAddress, usize.MAX) == usize.ZERO
    && count(&diamond, Sort.Load, usize.MAX) == usize.ZERO
    && count(&diamond, Sort.Store, usize.MAX) == usize.ZERO,
    "diamond scalar slot is fully promoted")
  run Testing.expect(List<u64>.length(&diamond.block(join).parameters) == usize.ONE,
    "diamond join receives one block parameter")
  run Testing.expect(diamond.block(join).value == List<u64>.get(&diamond.block(join).parameters, usize.ZERO),
    "diamond join returns its promoted block parameter")

  // Subcase B: counting loop with two loop-carried scalars.
  let mut loopFn = run SsaFunction.make(b"loop_scalars", 64)
  let n = run loopFn.argument(i64K)
  loopFn.setResult(i64K)
  let lEntry = run loopFn.newBlock()
  let lHead = run loopFn.newBlock()
  let lBody = run loopFn.newBlock()
  let lExit = run loopFn.newBlock()
  loopFn.startBlock(lEntry)
  let iSlot = run loopFn.slotOf(8, 8)
  let accSlot = run loopFn.slotOf(8, 8)
  let zero = run loopFn.integer(64, 0)
  run loopFn.store(zero, iSlot, 0, 8)
  run loopFn.store(zero, accSlot, 0, 8)
  run loopFn.jump(lHead)
  loopFn.startBlock(lHead)
  let curI = run loopFn.load(i64K, iSlot, 0, 8)
  let cond = run loopFn.compare(Predicate.Ult, curI, n)
  run loopFn.branchIf(cond, lBody, lExit)
  loopFn.startBlock(lBody)
  let bodyI = run loopFn.load(i64K, iSlot, 0, 8)
  let bodyAcc = run loopFn.load(i64K, accSlot, 0, 8)
  let nextAcc = run loopFn.binary(Binary.Add, bodyAcc, bodyI)
  let one = run loopFn.integer(64, 1)
  let nextI = run loopFn.binary(Binary.Add, bodyI, one)
  run loopFn.store(nextAcc, accSlot, 0, 8)
  run loopFn.store(nextI, iSlot, 0, 8)
  run loopFn.jump(lHead)
  loopFn.startBlock(lExit)
  let res = run loopFn.load(i64K, accSlot, 0, 8)
  run loopFn.ret(res)
  run loopFn.finish()
  run SsaPromotion.promoteScalars(&mut loopFn)
  run Testing.expect(run wellFormed(&loopFn), "counting-loop scalar promotion produces valid SSA")
  run Testing.expect(count(&loopFn, Sort.SlotAddress, usize.MAX) == usize.ZERO
    && count(&loopFn, Sort.Load, usize.MAX) == usize.ZERO
    && count(&loopFn, Sort.Store, usize.MAX) == usize.ZERO,
    "loop counter and accumulator slots are fully promoted")
  run Testing.expect(List<u64>.length(&loopFn.block(lHead).parameters) == 2,
    "loop header receives two promoted block parameters")
}

test effect fn keepsMarkedMultiFieldAndOverlappingSlotsAtLevelNone() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run scalarScopeFilterClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn scalarScopeFilterClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let i64K = Kind.integer(64)
  // Subcase A: single-field non-escaping marked slot stays unpromoted at Level.None while unmarked scalar promotes.
  let mut marked = run SsaFunction.make(b"marked_level_none", 64)
  let x = run marked.argument(i64K)
  marked.setResult(i64K)
  let m0 = run marked.newBlock()
  marked.startBlock(m0)
  let unmarkedSlot = run marked.slotOf(8, 8)
  let markedSlot = run marked.slotOf(8, 8)
  run marked.store(x, unmarkedSlot, 0, 8)
  let v0 = run marked.load(i64K, unmarkedSlot, 0, 8)
  run marked.slotStart(usize.ONE)
  run marked.store(v0, markedSlot, 0, 8)
  let v1 = run marked.load(i64K, markedSlot, 0, 8)
  run marked.slotEnd(usize.ONE)
  run marked.ret(v1)
  run marked.finish()
  run SsaPipeline.prepare(&mut marked, Level.None, true)
  run Testing.expect(run wellFormed(&marked), "marked slot function passes Level.None pipeline")
  run Testing.expect(count(&marked, Sort.SlotMarker, usize.MAX) == 2,
    "SlotStart and SlotEnd markers stay intact at Level.None")
  run Testing.expect(count(&marked, Sort.SlotAddress, usize.MAX) == usize.ONE
    && count(&marked, Sort.Load, usize.MAX) == usize.ONE
    && count(&marked, Sort.Store, usize.MAX) == usize.ONE,
    "unmarked scalar slot promotes while single-field marked slot stays in memory")

  // Subcase B: unmarked multi-field aggregate is not promoted by promoteScalars.
  let mut multi = run SsaFunction.make(b"multi_field_scalar", 64)
  let a = run multi.argument(i64K)
  let b = run multi.argument(i64K)
  multi.setResult(i64K)
  let b0 = run multi.newBlock()
  multi.startBlock(b0)
  let pair = run multi.slotOf(16, 8)
  run multi.store(a, pair, 0, 8)
  run multi.store(b, pair, 8, 8)
  let la = run multi.load(i64K, pair, 0, 8)
  let lb = run multi.load(i64K, pair, 8, 8)
  let sum = run multi.binary(Binary.Add, la, lb)
  run multi.ret(sum)
  run multi.finish()
  run SsaPromotion.promoteScalars(&mut multi)
  run Testing.expect(run wellFormed(&multi), "multi-field aggregate stays valid under promoteScalars")
  run Testing.expect(count(&multi, Sort.SlotAddress, usize.MAX) == usize.ONE
    && count(&multi, Sort.Load, usize.MAX) == 2
    && count(&multi, Sort.Store, usize.MAX) == 2,
    "multi-field unmarked aggregate is not promoted by promoteScalars")

  // Subcase C: overlapping wide/narrow accesses are not promoted by promoteScalars.
  let mut wide = run SsaFunction.make(b"wide_narrow_scalar", 64)
  let wx = run wide.argument(i64K)
  wide.setResult(i64K)
  let w0 = run wide.newBlock()
  wide.startBlock(w0)
  let ws = run wide.slotOf(8, 8)
  run wide.store(wx, ws, 0, 8)
  let lo = run wide.load(Kind.integer(8), ws, 0, 1)
  let hi = run wide.load(Kind.integer(32), ws, 4, 4)
  let loExt = run wide.cast(Cast.ZExt, lo, i64K)
  let hiExt = run wide.cast(Cast.ZExt, hi, i64K)
  let wsum = run wide.binary(Binary.Add, loExt, hiExt)
  run wide.ret(wsum)
  run wide.finish()
  run SsaPromotion.promoteScalars(&mut wide)
  run Testing.expect(run wellFormed(&wide), "overlapping wide/narrow slot stays valid under promoteScalars")
  run Testing.expect(count(&wide, Sort.SlotAddress, usize.MAX) == usize.ONE
    && count(&wide, Sort.Store, usize.MAX) == usize.ONE
    && count(&wide, Sort.Load, usize.MAX) == 2,
    "overlapping wide/narrow slot is not split or width-shared by promoteScalars")
}

test effect fn keepsEscapingFramedAndSecondReturnSlotAddresses() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run scalarEscapeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn scalarEscapeClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let i64K = Kind.integer(64)
  let addrK = Kind.address(64)

  // Subcase A: address passed to Call escapes while sibling scalar promotes.
  let mut callEsc = run SsaFunction.make(b"call_escape", 64)
  let cx = run callEsc.argument(i64K)
  callEsc.setResult(i64K)
  let cb0 = run callEsc.newBlock()
  callEsc.startBlock(cb0)
  let cs0 = run callEsc.slotOf(8, 8)
  let cs1 = run callEsc.slotOf(8, 8)
  run callEsc.store(cx, cs0, 0, 8)
  drop run callEsc.call(b"observe", &[cs0], Kind.unit())
  let cl0 = run callEsc.load(i64K, cs0, 0, 8)
  run callEsc.store(cl0, cs1, 0, 8)
  let cl1 = run callEsc.load(i64K, cs1, 0, 8)
  run callEsc.ret(cl1)
  run callEsc.finish()
  run SsaPromotion.promoteScalars(&mut callEsc)
  run Testing.expect(run wellFormed(&callEsc), "call-escaped scalar stays valid")
  run Testing.expect(count(&callEsc, Sort.SlotAddress, usize.MAX) == usize.ONE
    && count(&callEsc, Sort.Load, usize.MAX) == usize.ONE
    && count(&callEsc, Sort.Store, usize.MAX) == usize.ONE,
    "call-escaped slot stays in memory while non-escaping sibling promotes")

  // Subcase B: address stored into memory escapes.
  let mut storeEsc = run SsaFunction.make(b"store_escape", 64)
  let outPtr = run storeEsc.argument(addrK)
  let sx = run storeEsc.argument(i64K)
  storeEsc.setResult(i64K)
  let sb0 = run storeEsc.newBlock()
  storeEsc.startBlock(sb0)
  let ss0 = run storeEsc.slotOf(8, 8)
  run storeEsc.store(ss0, outPtr, 0, 8)
  run storeEsc.store(sx, ss0, 0, 8)
  drop run storeEsc.call(b"clobber", &[], Kind.unit())
  let sl0 = run storeEsc.load(i64K, ss0, 0, 8)
  run storeEsc.ret(sl0)
  run storeEsc.finish()
  run SsaPromotion.promoteScalars(&mut storeEsc)
  run Testing.expect(run wellFormed(&storeEsc), "store-escaped scalar stays valid")
  run Testing.expect(count(&storeEsc, Sort.SlotAddress, usize.MAX) == usize.ONE
    && count(&storeEsc, Sort.Load, usize.MAX) == usize.ONE
    && count(&storeEsc, Sort.Store, usize.MAX) == 2,
    "slot whose address is stored to memory stays unpromoted")

  // Subcase C: FrameAddress keeps non-variable scalars in memory while still promoting builder variables.
  let mut framed = run SsaFunction.make(b"framed_scalar", 64)
  let fx = run framed.argument(i64K)
  framed.setResult(i64K)
  let fb0 = run framed.newBlock()
  framed.startBlock(fb0)
  let fp = run framed.frameAddress()
  drop run framed.call(b"inspect_frame", &[fp], Kind.unit())
  let bvar = run framed.variable(i64K)
  run framed.assign(bvar, fx)
  let fs = run framed.slotOf(8, 8)
  run framed.store(bvar, fs, 0, 8)
  let fl = run framed.load(i64K, fs, 0, 8)
  run framed.ret(fl)
  run framed.finish()
  run SsaPromotion.promoteScalars(&mut framed)
  run Testing.expect(run wellFormed(&framed), "FrameAddress function stays valid under promoteScalars")
  run Testing.expect(count(&framed, Sort.SlotAddress, usize.MAX) == usize.ONE
    && count(&framed, Sort.Load, usize.MAX) == usize.ONE
    && count(&framed, Sort.Store, usize.MAX) == usize.ONE,
    "FrameAddress preserves non-variable scalar slots while still promoting builder variables")

  // Subcase D: slot address returned in Exit.Return secondValue escapes in BOTH promote(..., true) and promoteScalars.
  let mut mode = usize.ZERO
  while mode < 2 {
    let mut retEsc = run SsaFunction.make(b"ret_second_escape", 64)
    let rx = run retEsc.argument(i64K)
    retEsc.setResults(i64K, addrK)
    let rb0 = run retEsc.newBlock()
    retEsc.startBlock(rb0)
    let rs0 = run retEsc.slotOf(8, 8)
    let rs1 = run retEsc.slotOf(8, 8)
    run retEsc.store(rx, rs0, 0, 8)
    let rl0 = run retEsc.load(i64K, rs0, 0, 8)
    run retEsc.store(rl0, rs1, 0, 8)
    let rl1 = run retEsc.load(i64K, rs1, 0, 8)
    run retEsc.retPair(rl1, rs0)
    run retEsc.finish()
    if mode == usize.ZERO {
      run promoteWithGraph(&mut retEsc, true)
    } else {
      run SsaPromotion.promoteScalars(&mut retEsc)
    }
    run Testing.expect(run wellFormed(&retEsc), "secondValue-escaping slot passes verification in all promotion modes")
    run Testing.expect(count(&retEsc, Sort.SlotAddress, usize.MAX) == usize.ONE
      && count(&retEsc, Sort.Load, usize.MAX) == usize.ONE
      && count(&retEsc, Sort.Store, usize.MAX) == usize.ONE,
      "slot whose address escapes via Exit.Return secondValue is not promoted while non-escaping sibling promotes")
    mode = mode + usize.ONE
  }
}

test effect fn levelNonePreservesArchIntrinsicsZeroInitsAndCapsCrossBlockBudget() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run levelNoneEdgeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn levelNoneEdgeClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let i64K = Kind.integer(64)
  let v2i64K = Kind.vector(i64K, 2)

  // Subcase A: Level.None promotes scalar & vector slots while preserving unused ArchIntrinsic.
  let mut archFn = run SsaFunction.make(b"level_none_arch", 64)
  let ax = run archFn.argument(i64K)
  let av = run archFn.argument(v2i64K)
  archFn.setResult(i64K)
  let ab0 = run archFn.newBlock()
  archFn.startBlock(ab0)
  let as0 = run archFn.slotOf(8, 8)
  let as1 = run archFn.slotOf(16, 16)
  let as2 = run archFn.slotOf(16, 16)
  let as3 = run archFn.slotOf(8, 8)
  run archFn.store(ax, as0, 0, 8)
  let ax2 = run archFn.load(i64K, as0, 0, 8)
  run archFn.store(av, as1, 0, 16)
  let av2 = run archFn.load(v2i64K, as1, 0, 16)
  let aes = run archFn.archIntrinsic(ArchOperation.X86AesEncrypt, 0, &[av2, av2], v2i64K)
  run archFn.store(aes, as2, 0, 16)
  let one = run archFn.integer(64, 1)
  let sum = run archFn.binary(Binary.Add, ax2, one)
  run archFn.store(sum, as3, 0, 8)
  let retVal = run archFn.load(i64K, as3, 0, 8)
  run archFn.ret(retVal)
  run archFn.finish()
  run SsaPipeline.prepare(&mut archFn, Level.None, true)
  run Testing.expect(run wellFormed(&archFn), "Level.None pipeline with unused ArchIntrinsic passes verification")
  run Testing.expect(count(&archFn, Sort.Arch, usize.MAX) == usize.ONE,
    "Level.None preserves unused ArchIntrinsic when its temp store slot is promoted")
  run Testing.expect(count(&archFn, Sort.SlotAddress, usize.MAX) == usize.ZERO
    && count(&archFn, Sort.Load, usize.MAX) == usize.ZERO
    && count(&archFn, Sort.Store, usize.MAX) == usize.ZERO,
    "Level.None promotes all four scalar and vector temp slots")

  // Subcase B: load-before-store materializes a zero constant of the scalar field's kind.
  let mut zeroInit = run SsaFunction.make(b"zero_init_scalar", 64)
  zeroInit.setResult(i64K)
  let zb0 = run zeroInit.newBlock()
  zeroInit.startBlock(zb0)
  let zs = run zeroInit.slotOf(8, 8)
  let zLoaded = run zeroInit.load(i64K, zs, 0, 8)
  run zeroInit.ret(zLoaded)
  run zeroInit.finish()
  run SsaPromotion.promoteScalars(&mut zeroInit)
  run Testing.expect(run wellFormed(&zeroInit), "load-before-store scalar promotion passes verification")
  run Testing.expect(count(&zeroInit, Sort.SlotAddress, usize.MAX) == usize.ZERO
    && count(&zeroInit, Sort.Load, usize.MAX) == usize.ZERO,
    "load-only scalar slot is promoted to zero constant")
  let zRet = zeroInit.block(usize.ZERO).value
  run Testing.expect(zeroInit.isBits(zRet) && zeroInit.constantOf(zRet).low == 0,
    "load-before-store returns synthesized zero constant")

  // Subcase C: synthetic scalarCrossBudget cap (660 blocks * 200 cross-block scalars = 132000 > 131072).
  let mut capped = run SsaFunction.make(b"cross_budget_cap", 64)
  let cFlag = run capped.argument(Kind.integer(1))
  let cA = run capped.argument(i64K)
  let cB = run capped.argument(i64K)
  capped.setResult(i64K)
  let totalBlocks: usize = 660
  let crossSlots: usize = 200
  let mut blkIdx = usize.ZERO
  while blkIdx < totalBlocks {
    drop run capped.newBlock()
    blkIdx = blkIdx + usize.ONE
  }
  capped.startBlock(usize.ZERO)
  let builderVar = run capped.variable(i64K)
  let singleSlot = run capped.slotOf(8, 8)
  run capped.store(cA, singleSlot, 0, 8)
  let singleVal = run capped.load(i64K, singleSlot, 0, 8)
  let mut slotAddrs = run List<u64>.makeWithCapacity(crossSlots)
  let mut sIdx = usize.ZERO
  while sIdx < crossSlots {
    let addr = run capped.slotOf(8, 8)
    run capped.store(singleVal, addr, 0, 8)
    run List<u64>.append(&mut slotAddrs, addr)
    sIdx = sIdx + usize.ONE
  }
  run capped.branchIf(cFlag, usize.ONE, 2)
  capped.startBlock(usize.ONE)
  run capped.assign(builderVar, singleVal)
  run capped.jump(3)
  capped.startBlock(2)
  run capped.assign(builderVar, cB)
  run capped.jump(3)
  blkIdx = 3
  while blkIdx + usize.ONE < totalBlocks {
    capped.startBlock(blkIdx)
    run capped.jump(blkIdx + usize.ONE)
    blkIdx = blkIdx + usize.ONE
  }
  capped.startBlock(totalBlocks - usize.ONE)
  let mut acc = builderVar
  sIdx = usize.ZERO
  while sIdx < crossSlots {
    let loaded = run capped.load(i64K, List<u64>.get(&slotAddrs, sIdx), 0, 8)
    acc = run capped.binary(Binary.Add, acc, loaded)
    sIdx = sIdx + usize.ONE
  }
  run capped.ret(acc)
  run capped.finish()
  run SsaPromotion.promoteScalars(&mut capped)
  run Testing.expect(run wellFormed(&capped), "budget-capped giant function passes verification")
  run Testing.expect(count(&capped, Sort.SlotAddress, usize.MAX) == crossSlots
    && count(&capped, Sort.Load, usize.MAX) == crossSlots
    && count(&capped, Sort.Store, usize.MAX) == crossSlots,
    "cross-block non-variable slots are demoted cleanly while single-block scalar and builder variable promote")
  run Testing.expect(List<u64>.length(&capped.block(3).parameters) == usize.ONE,
    "builder variable still receives its diamond block parameter under cross-block scalar budget cap")
}
