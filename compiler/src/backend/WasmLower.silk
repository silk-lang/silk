// An aggregate value is never a wasm value: its value is the address of its bytes, and a store
// copies them. A unit value is `none()`.
struct Value {
  scalar: Representation,
  value: u64,
}

impl Copy for Value {}

struct Writer {
  /// The fragment the definition goes into, and the function being built for it.
  fragment: Fragment,
  function: SsaFunction,
  /// The last fresh number a private object's name took.
  counter: usize,
  /// The last location marker the body got, as `Origin.location.start` plus one, or zero.
  located: usize,
  /// The defined function's symbol, which qualifies its private objects.
  symbol: Bytes,
  /// The function's `MirFunction.lines`, which give each location marker its detail.
  lines: List<u64>,
  /// Where a trap emitted for the current statement reports to the current observer (event 6, N7).
  trap: Option<TrapReport>,
  /// The function's hidden `Observer`, `Cause` and `Site` locals (`LoweringPlan.diagnosticLocal`),
  /// found once before its blocks are emitted, since every trap site asks.
  observerLocal: usize,
  causeLocal: usize,
  siteLocal: usize,
  /// The target's address width in bits.
  pointerBits: usize,
  /// Whether the memory is shared between threads.
  shared: bool,
  /// The function being built: each MIR local's storage address, each failure slot's context
  /// companion address (`none()` for a slot without one), and each MIR block's body block.
  slots: List<u64>,
  companions: List<u64>,
  blocks: List<usize>,
  /// Per MIR local, the alignment of its storage, or `usize.MAX` where `emitSlots` read no layout.
  /// Places rooted at a local start from it instead of looking the layout up again.
  alignments: List<usize>,
  /// Caller copies of indirect C arguments in the entry block: block, parameter and address.
  copies: List<CallerCopy>,
  /// Its arguments: each written parameter's first lane (`none()` for a unit one), the hidden
  /// provider addresses, and the hidden result, failure, context, observer, cause and site
  /// addresses; a coroutine's transfer record and frame. Absent ones are `none()`.
  parameters: List<u64>,
  /// Each written parameter's further lanes when it travels in several (`parameterLanes`), three
  /// per parameter, `none()` past its last.
  extras: List<u64>,
  providers: List<u64>,
  out: u64,
  failure: u64,
  context: u64,
  observer: u64,
  cause: u64,
  site: u64,
  transfer: u64,
  frame: u64,
  /// A step's own step record (`stepRecord`), which its direct callee steps run published in.
  steps: u64,
  /// Whether the build optimizes the functions it emits, and whether it verifies each one's SSA
  /// form after lowering and after each pass.
  optimized: bool,
  verify: bool,
}

/// An observed trap's report inputs: the observer and selected-cause local addresses, the site
/// label of the statement being emitted, and the target word width in bits.
struct TrapReport {
  observer: u64,
  cause: u64,
  label: Bytes,
  bits: usize,
  /// The slot of the function's package entry site, or `none()` when the function has none.
  entry: u64,
}

/// One caller copy slot of an indirect C argument.
struct CallerCopy {
  block: usize,
  parameter: usize,
  address: u64,
}

impl Copy for CallerCopy {}

// A writer for `target`, whose memory threads share when `shared`.
effect fn writerFor(target: &Target, shared: bool) -> Writer ! OutOfMemoryError ? &mut Allocator {
  let bits = u32.toUsize(Target.pointerBits(target))
  return Writer {fragment: Fragment.make(), function: run SsaFunction.make(b"", bits), counter: usize.ZERO, located: usize.ZERO,
    symbol: Bytes.make(), lines: List<u64>.make(), trap: Option<TrapReport>.none(), observerLocal: usize.MAX, causeLocal: usize.MAX,
    siteLocal: usize.MAX, pointerBits: bits, shared: shared, slots: List<u64>.make(), companions: List<u64>.make(),
    blocks: List<usize>.make(), alignments: List<usize>.make(), copies: List<CallerCopy>.make(), parameters: List<u64>.make(),
    extras: List<u64>.make(), providers: List<u64>.make(), out: none(), failure: none(), context: none(), observer: none(),
    cause: none(), site: none(), transfer: none(), frame: none(), steps: none(), optimized: false, verify: false}
}

// Finds the hidden diagnostic locals of `function`, whose blocks are about to be emitted.
fn noteDiagnosticLocals(writer: &mut Writer, function: &MirFunction) -> () {
  writer.observerLocal = diagnosticLocal(function, usize.ZERO)
  writer.causeLocal = diagnosticLocal(function, usize.ONE)
  writer.siteLocal = diagnosticLocal(function, 2)
  return ()
}

// Forgets the function just built, keeping the fragment and its counter.
fn resetFunction(writer: &mut Writer) -> () {
  List<u64>.clear(&mut writer.*.slots)
  List<u64>.clear(&mut writer.*.companions)
  List<usize>.clear(&mut writer.*.blocks)
  List<usize>.clear(&mut writer.*.alignments)
  List<CallerCopy>.clear(&mut writer.*.copies)
  List<u64>.clear(&mut writer.*.parameters)
  List<u64>.clear(&mut writer.*.extras)
  List<u64>.clear(&mut writer.*.providers)
  writer.out = none()
  writer.failure = none()
  writer.context = none()
  writer.observer = none()
  writer.cause = none()
  writer.site = none()
  writer.transfer = none()
  writer.frame = none()
  writer.steps = none()
  return ()
}

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut at = usize.ZERO
  while at < a.length {
    if a[at] != b[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Functions.

// Starts the function `symbol`; its parameters and result follow.
effect fn beginBody(writer: &mut Writer, symbol: &[u8]) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  writer.function = run SsaFunction.make(symbol, writer.pointerBits)
  return ()
}

// Adds a parameter of `kind` to the function being built; answers its value.
effect fn parameterOf(writer: &mut Writer, kind: Kind) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run writer.function.argument(kind)
}

// Finishes the function being built and adds its wasm body to the fragment, exported as
// `exported` when not empty: its SSA form is finished, its variables promoted, with every frame
// slot only loaded and stored in an optimized build, and then it is emitted. A build that
// verifies checks the SSA form after each of those steps.
effect fn endBody(writer: &mut Writer, exported: &[u8]) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  run writer.function.finish()
  if writer.verify { run SsaVerification.verify(&writer.function, b"lowering") }
  run SsaPromotion.promote(&mut writer.*.function, writer.optimized)
  if writer.verify { run SsaVerification.verify(&writer.function, b"promotion") }
  let translated = run WasmEmission.emit(&writer.function, writer.shared)
  return run List<WasmFunction>.append(&mut writer.*.fragment.functions, WasmFunction {body: move translated, exported: run Bytes.copy(exported)})
}

// Types.

effect fn integerType(writer: &mut Writer, bits: usize) -> Kind ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return Kind.integer(bits)
}

effect fn pointerType(writer: &mut Writer) -> Kind ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return Kind.address(writer.pointerBits)
}

effect fn voidType(writer: &mut Writer) -> Kind ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return Kind.unit()
}

// The target word, an integer as wide as an address.
effect fn wordType(writer: &mut Writer) -> Kind ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return Kind.integer(writer.pointerBits)
}

// The kind of one lane, which is the whole kind of a scalar.
effect fn laneTypeOf(writer: &mut Writer, value: Representation) -> Kind ! Unsupported | OutOfMemoryError ? &mut Allocator {
  if value.floating { return Kind.float(value.bits) }
  return Kind.integer(value.bits)
}

// The kind of a value: an aggregate's is its address.
effect fn typeOf(writer: &mut Writer, value: Representation) -> Kind ! Unsupported | OutOfMemoryError ? &mut Allocator {
  if value.aggregate || value.pointer { return Kind.address(writer.pointerBits) }
  if value.unit { return Kind.unit() }
  let lane = run laneTypeOf(&mut writer.*, value)
  if value.lanes != usize.ZERO { return Kind.vector(lane, value.lanes) }
  return lane
}

// Appends `value` in decimal.
effect fn appendDecimal(text: &mut Bytes, value: u64) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  if value >= 10 { run appendDecimal(&mut text.*, u64.divide(value, 10)) }
  let digit = [u64.toU8(48 + u64.remainder(value, 10))]
  return run Bytes.append(&mut text.*, &digit)
}

// Constants.

// The integer constant `value` of `kind`, every lane `value` for a vector.
effect fn intOf(writer: &mut Writer, kind: Representation, value: u64) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let ty = run typeOf(&mut writer.*, kind)
  return run writer.function.constant(ty, value)
}

// The integer constant `value` of `bits` bits.
effect fn integerOf(writer: &mut Writer, bits: usize, value: u64) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run writer.function.integer(bits, value)
}

// The constant `value` of kind `ty`.
effect fn constantOf(writer: &mut Writer, ty: Kind, value: u64) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run writer.function.constant(ty, value)
}

// The target word constant `value`.
effect fn wordOf(writer: &mut Writer, value: usize) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run writer.function.word(usize.toU64(value))
}

// The floating constant of `kind` equal to the binary64 `bits`, every lane for a vector.
effect fn floatOf(writer: &mut Writer, kind: Representation, bits: u64) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let ty = run typeOf(&mut writer.*, kind)
  return run writer.function.constant(ty, bits)
}

effect fn boolOf(writer: &mut Writer, value: bool) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run writer.function.flag(value)
}

effect fn nullOf(writer: &mut Writer) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run writer.function.null()
}

// The two's complement bits of a decimal literal, negated when `negative`.
fn decimalBits(digits: &[u8], negative: bool) -> u64 {
  let mut value: u64 = 0
  let mut at = usize.ZERO
  while at < digits.length {
    value = u64.wrappingAdd(u64.wrappingMultiply(value, 10), u8.toU64(digits[at] - 48))
    at = at + usize.ONE
  }
  if negative { return u64.wrappingSubtract(0, value) }
  return value
}

// The `i128` constant of a decimal literal, negated when `negative`: its low and high lanes.
fn decimalWide(digits: &[u8], negative: bool) -> [u64; 2] {
  let mut low: u64 = 0
  let mut high: u64 = 0
  let mut at = usize.ZERO
  while at < digits.length {
    // (high, low) * 10 + digit, in 32-bit pieces.
    let digit = u8.toU64(digits[at] - 48)
    let l0 = (low & 4294967295) * 10 + digit
    let l1 = u64.shiftRight(low, 32) * 10 + u64.shiftRight(l0, 32)
    let h0 = (high & 4294967295) * 10 + u64.shiftRight(l1, 32)
    let h1 = u64.shiftRight(high, 32) * 10 + u64.shiftRight(h0, 32)
    low = (l0 & 4294967295) | u64.shiftLeft(l1 & 4294967295, 32)
    high = (h0 & 4294967295) | u64.shiftLeft(h1 & 4294967295, 32)
    at = at + usize.ONE
  }
  if negative {
    low = u64.bitNot(low)
    high = u64.bitNot(high)
    low = u64.wrappingAdd(low, 1)
    if low == 0 { high = u64.wrappingAdd(high, 1) }
  }
  return [low, high]
}

// Blocks.

// A new block; `text` names it in LLVM's form, which wasm has no use for.
effect fn labelled(writer: &mut Writer, text: &[u8]) -> usize ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run writer.function.newBlock()
}

effect fn labelledNumber(writer: &mut Writer, text: &[u8], number: usize) -> usize ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run writer.function.newBlock()
}

effect fn startBlock(writer: &mut Writer, handle: usize) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  writer.function.startBlock(handle)
  return ()
}

// The block of MIR block `index`.
fn blockAt(writer: &Writer, index: usize) -> usize {
  return List<usize>.get(&writer.blocks, index)
}

// The storage address of MIR local `index`.
fn slotOf(writer: &Writer, index: usize) -> u64 {
  return List<u64>.get(&writer.slots, index)
}

// Instructions.

effect fn binaryOf(writer: &mut Writer, op: Binary, left: u64, right: u64) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run SsaFunction.binary(&mut writer.*.function, op, left, right)
}

effect fn compareOf(writer: &mut Writer, predicate: Predicate, left: u64, right: u64) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run SsaFunction.compare(&mut writer.*.function, predicate, left, right)
}

effect fn selectOf(writer: &mut Writer, condition: u64, chosen: u64, otherwise: u64) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run SsaFunction.select(&mut writer.*.function, condition, chosen, otherwise)
}

// `xor` of `value` with all ones: the negation of a flag.
effect fn notOf(writer: &mut Writer, kind: Representation, value: u64) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let ones = run intOf(&mut writer.*, kind, u64.MAX)
  return run binaryOf(&mut writer.*, Binary.Xor, value, ones)
}

// A bool lives in memory as a byte, as Clang keeps C's `bool`; the body builder reads and writes
// the byte.
effect fn loadOf(writer: &mut Writer, kind: Representation, address: u64, alignment: usize) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let ty = run typeOf(&mut writer.*, kind)
  return run writer.function.load(ty, address, 0, alignment)
}

// Loads a value of kind `ty`.
effect fn loadKind(writer: &mut Writer, ty: Kind, address: u64) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run writer.function.load(ty, address, 0, usize.ONE)
}

effect fn loadPointer(writer: &mut Writer, address: u64, alignment: usize) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let ty = run pointerType(&mut writer.*)
  return run writer.function.load(ty, address, 0, alignment)
}

effect fn storeOf(writer: &mut Writer, value: u64, address: u64, alignment: usize) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run writer.function.store(value, address, 0, alignment)
}

effect fn castOf(writer: &mut Writer, op: Cast, input: &Value, output: Representation) -> Value ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let ty = run typeOf(&mut writer.*, output)
  return Value {scalar: output, value: run SsaFunction.cast(&mut writer.*.function, op, input.value, ty)}
}

// `value` converted to kind `ty` by `op`.
effect fn castTo(writer: &mut Writer, op: Cast, value: u64, ty: Kind) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run SsaFunction.cast(&mut writer.*.function, op, value, ty)
}

// The address `offset` bytes past `base`.
effect fn byteOffset(writer: &mut Writer, base: u64, offset: usize) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run SsaFunction.offset(&mut writer.*.function, base, usize.toU64(offset))
}

effect fn wordOffset(writer: &mut Writer, base: u64, offset: usize) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run SsaFunction.offset(&mut writer.*.function, base, usize.toU64(offset))
}

// The address `index` bytes past `base`.
effect fn indexedOffset(writer: &mut Writer, base: u64, index: u64) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run SsaFunction.indexed(&mut writer.*.function, base, index)
}

// Calls the function `name` with `arguments`; answers its `result`.
effect fn callNamed(writer: &mut Writer, name: &[u8], result: Kind, arguments: &[u64]) -> u64
! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run SsaFunction.call(&mut writer.*.function, name, arguments, result)
}

// Calls the function at address `callee` with `arguments`; answers its `result`.
effect fn callAddress(writer: &mut Writer, callee: u64, arguments: &[u64], result: Kind) -> u64
! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run SsaFunction.callIndirect(&mut writer.*.function, callee, arguments, result)
}

// A trap, which ends the block.
effect fn trapHere(writer: &mut Writer) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run SsaFunction.trap(&mut writer.*.function)
}

effect fn branch(writer: &mut Writer, target: usize) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run SsaFunction.jump(&mut writer.*.function, target)
}

effect fn branchIf(writer: &mut Writer, condition: u64, onTrue: usize, onFalse: usize) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run SsaFunction.branchIf(&mut writer.*.function, condition, onTrue, onFalse)
}

effect fn returnValue(writer: &mut Writer, value: u64) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run SsaFunction.ret(&mut writer.*.function, value)
}

effect fn returnVoid(writer: &mut Writer) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run SsaFunction.ret(&mut writer.*.function, none())
}

// A variable of kind `ty`, which `assignOf` sets: what LLVM spells as a `phi`.
effect fn variableOf(writer: &mut Writer, ty: Kind) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run SsaFunction.variable(&mut writer.*.function, ty)
}

effect fn assignOf(writer: &mut Writer, variable: u64, value: u64) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run SsaFunction.assign(&mut writer.*.function, variable, value)
}

// A frame slot of `size` bytes aligned to `alignment`: what LLVM spells as an `alloca`.
effect fn allocaOf(writer: &mut Writer, size: usize, alignment: usize) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut aligned = alignment
  if aligned == usize.ZERO { aligned = usize.ONE }
  return run writer.function.slotOf(usize.toU64(size), usize.toU64(aligned))
}

// Copies `size` bytes from `source` to `destination`; the two may overlap.
effect fn copyCall(writer: &mut Writer, destination: u64, alignment: usize, source: u64, size: usize, distinct: bool) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if size == usize.ZERO { return () }
  return run SsaFunction.copyBytes(&mut writer.*.function, destination, source, usize.toU64(size))
}

// Sets `size` bytes at `destination` to `byte`.
effect fn fillCall(writer: &mut Writer, destination: u64, alignment: usize, byte: u8, size: usize) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if size == usize.ZERO { return () }
  return run SsaFunction.fill(&mut writer.*.function, destination, byte, usize.toU64(size))
}

// Objects.

// The name `<symbol><stem><n>` of a new private object of the definition.
effect fn privateName(writer: &mut Writer, stem: &[u8]) -> Bytes ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut name = run Bytes.copy(Bytes.asSlice(&writer.symbol))
  run Bytes.append(&mut name, stem)
  writer.counter = writer.counter + usize.ONE
  run appendDecimal(&mut name, usize.toU64(writer.counter))
  return move name
}

// Adds the object `symbol` to the fragment.
effect fn defineObject(writer: &mut Writer, symbol: &[u8], alignment: usize, image: Bytes, pointers: List<ObjectPointer>, framed: bool,
  local: bool) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut aligned = alignment
  if aligned == usize.ZERO { aligned = usize.ONE }
  return run List<Object>.append(&mut writer.*.fragment.objects, Object {symbol: run Bytes.copy(symbol), alignment: usize.toU64(aligned),
    image: move image, pointers: move pointers, framed: framed, local: local})
}

// The address of the object or function `symbol`.
effect fn addressOf(writer: &mut Writer, symbol: &[u8]) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run writer.function.symbolAddress(symbol, 0, false)
}

// The name of a private object of `content` alone: `stem`, then the 128-bit hash of `content` in
// hex. Every definition that holds the same content names one object, and the link places the
// first object of each name, so the module holds one copy. A trap reason, such as `arithmetic
// overflow`, is written once per arithmetic site.
effect fn contentName(stem: &[u8], content: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut name = run Bytes.copy(stem)
  let digits = ContentHash.digits(ContentHash.of(content))
  run Bytes.append(&mut name, &digits)
  return move name
}

// Defines the private object holding `bytes`, shared by every definition that holds the same
// bytes; answers its name.
effect fn bytesObject(writer: &mut Writer, bytes: &[u8]) -> Bytes ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let name = run contentName(b"silk.bytes.", bytes)
  run defineObject(&mut writer.*, Bytes.asSlice(&name), usize.ONE, run Bytes.copy(bytes), List<ObjectPointer>.make(), false, false)
  return move name
}

// Defines one private constant holding `bytes` and returns its address.
effect fn staticBytes(writer: &mut Writer, bytes: &[u8]) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let name = run bytesObject(&mut writer.*, bytes)
  return run addressOf(&mut writer.*, Bytes.asSlice(&name))
}

// Defines the private static `string<'static>` descriptor `{address, length}` for `bytes`, shared
// by every definition that holds the same bytes; answers its name.
effect fn stringObject(writer: &mut Writer, bytes: &[u8], bits: usize) -> Bytes ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let data = run bytesObject(&mut writer.*, bytes)
  let word = bits / 8
  let mut image = run Bytes.zeroed(word * 2)
  writeWord(&mut image, word, word, usize.toU64(bytes.length))
  let mut pointers = List<ObjectPointer>.make()
  run List<ObjectPointer>.append(&mut pointers, ObjectPointer {offset: usize.ZERO, symbol: move data, addend: 0, size: word})
  let name = run contentName(b"silk.string.", bytes)
  run defineObject(&mut writer.*, Bytes.asSlice(&name), word, move image, move pointers, false, false)
  return move name
}

// A private static `string<'static>` descriptor `{address, length}` for `bytes`.
effect fn staticString(writer: &mut Writer, bytes: &[u8], bits: usize) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let name = run stringObject(&mut writer.*, bytes, bits)
  return run addressOf(&mut writer.*, Bytes.asSlice(&name))
}
// One text descriptor inside a constant's storage: its address word at `offset` holds the address
// of `bytes`, which a byte image cannot spell.
struct TextAddress {
  offset: usize,
  bytes: Bytes,
  // A static view's referent, addressed through its own constant instead of `bytes`.
  view: Option<StaticView>,
}

struct StaticView {
  value: Interned<StaticData>,
  ty: Interned<Type>,
}

// Writes the `size` low bytes of `value` at `offset`, least significant first; every target is
// little-endian.
fn writeWord(image: &mut Bytes, offset: usize, size: usize, value: u64) -> () {
  let slots = Bytes.asMutSlice(&mut image.*)
  let mut rest = value
  let mut at = usize.ZERO
  while at < size && at < 8 {
    slots[offset + at] = u64.wrappingToU8(rest)
    rest = rest / 256
    at = at + usize.ONE
  }
  return ()
}

// The two's complement bits of a static integer's sign and magnitude.
fn signedBits(negative: bool, magnitude: u64) -> u64 {
  if !negative || magnitude == 0 { return magnitude }
  return u64.MAX - magnitude + 1
}

// A static value's scalar bits, or its field count when it is an aggregate.
struct StaticLeaf {
  supported: bool,
  scalar: bool,
  bits: u64,
  fields: usize,
}

fn flagBits(flag: bool) -> u64 {
  if flag { return 1 }
  return 0
}

fn staticLeaf(data: &StaticData) -> StaticLeaf {
  return match & data.* {
    StaticData.Unit => StaticLeaf {supported: true, scalar: true, bits: 0, fields: usize.ZERO}
    StaticData.Boolean {value: flag} => StaticLeaf {supported: true, scalar: true, bits: flagBits(flag), fields: usize.ZERO}
    StaticData.Character {scalar: code} => StaticLeaf {supported: true, scalar: true, bits: u32.toU64(code), fields: usize.ZERO}
    StaticData.Integer {sign, magnitude, ..} => StaticLeaf {supported: true, scalar: true,
      bits: signedBits(sign == StaticSign.Negative, magnitude), fields: usize.ZERO}
    StaticData.Enum {sign, magnitude, ..} => StaticLeaf {supported: true, scalar: true,
      bits: signedBits(sign == StaticSign.Negative, magnitude), fields: usize.ZERO}
    StaticData.Float {bits: raw, ..} => StaticLeaf {supported: true, scalar: true, bits: raw, fields: usize.ZERO}
    StaticData.Aggregate {fields: members, variant, ..} => StaticLeaf {supported: !Option<usize>.isSome(&variant), scalar: false,
      bits: 0, fields: List<Interned<StaticData>>.length(&members)}
    _ => StaticLeaf {supported: false, scalar: true, bits: 0, fields: usize.ZERO}
  }
}

// Writes constant `value` of type `ty` at `offset` of `image` as its runtime layout stores it, and
// lists each text descriptor's address word in `texts`. Padding stays zero.
effect fn writeStatic(layouts: &TypeLayouts, function: &MirFunction, target: &Target, value: &Interned<StaticData>,
  ty: &Interned<Type>, offset: usize, image: &mut Bytes, texts: &mut List<TextAddress>) -> ()
! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = Location.make(usize.ZERO, usize.ZERO)
  let mut text = run StaticValue.textBytes(value)
  if let Option<Bytes>.None = &text { text = run StaticValue.embeddedBytes(value) }
  // A text or byte-view descriptor holds its data address at offset zero and its byte length in a
  // target word.
  if let Option<Bytes>.Some {value: bytes} = move text {
    let facts = run sliceFact(layouts, ty, function, span)
    let word = u32.toUsize(Target.pointerBits(target)) / 8
    writeWord(&mut image.*, offset + facts.lengthOffset, word, usize.toU64(Bytes.length(&bytes)))
    run List<TextAddress>.append(&mut texts.*, TextAddress {offset: offset, bytes: move bytes, view: Option<StaticView>.none()})
    return ()
  }
  // A static view holds the address of its referent's own constant; a slice also holds the
  // viewed array's length.
  let viewed = Interned<StaticData>.with<Option<Interned<StaticData>>>(value, StaticValue.borrowTarget)
  if let Option<Interned<StaticData>>.Some {value: referent} = move viewed {
    if let Option<Interned<Type>>.Some {..} = move Type.sliceElement(ty) {
      let arrayType = Interned<StaticData>.with<Option<Interned<Type>>>(&referent, StaticValue.carriedType)
      let count = Interned<StaticData>.with<Option<usize>>(&referent, StaticValue.arrayElements)
      if let Option<Interned<Type>>.Some {value: viewType} = move arrayType {
        if let Option<usize>.Some {value: length} = move count {
          let facts = run sliceFact(layouts, ty, function, span)
          let word = u32.toUsize(Target.pointerBits(target)) / 8
          writeWord(&mut image.*, offset + facts.lengthOffset, word, usize.toU64(length))
          run List<TextAddress>.append(&mut texts.*, TextAddress {offset: offset, bytes: Bytes.make(),
            view: Option<StaticView>.some(StaticView {value: move referent, ty: move viewType})})
          return ()
        }
      }
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.TypedForm, &owner, span)
    }
    let referentType = Interned<Type>.with<Option<Interned<Type>>>(ty, fn(view: &Type) -> Option<Interned<Type>> {
      return match &view.* {
        Type.Reference {referent: held, access: Access.Shared, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&held))
        _ => Option<Interned<Type>>.none()
      }
    })
    if let Option<Interned<Type>>.Some {value: viewType} = move referentType {
      run List<TextAddress>.append(&mut texts.*, TextAddress {offset: offset, bytes: Bytes.make(),
        view: Option<StaticView>.some(StaticView {value: move referent, ty: move viewType})})
      return ()
    }
    let owner = InstanceKey.identity(&function.key)
    fail Gap.relative(GapCode.TypedForm, &owner, span)
  }
  // A value held by a structural union is stored under its member's tag, at the payload offset.
  match move run Mir.staticPlacement(value, ty) {
    StaticPlacement.Plain => {}
    StaticPlacement.Member {tag, ty: stored} => {
      let tagged = run taggedFact(layouts, ty)
      writeWord(&mut image.*, offset, tagged.tagSize, usize.toU64(tag))
      return run writeStatic(layouts, function, target, value, &stored, offset + tagged.payloadOffset, &mut image.*, &mut texts.*)
    }
    StaticPlacement.Unplaced => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.TypedForm, &owner, span)
    }
  }
  // A cleanup-free union variant, as `Mir.materializeEmbedded` admits, stores its
  // declaration-order tag first and its fields where the variant's layout places them.
  if let Option<usize>.Some {value: tag} = move Interned<StaticData>.with<Option<usize>>(value, StaticValue.variantTag) {
    // A structural union's tag names a member, not a variant, so its image is not written here.
    if !run nominalUnionLayout(layouts, ty) {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.TypedForm, &owner, span)
    }
    let tagged = run taggedFact(layouts, ty)
    writeWord(&mut image.*, offset, tagged.tagSize, usize.toU64(tag))
    let total = Interned<StaticData>.with<usize>(value, fn(data: &StaticData) -> usize {
      return match & data.* { StaticData.Aggregate {fields, ..} => List<Interned<StaticData>>.length(&fields) _ => usize.ZERO }
    })
    let mut slot = usize.ZERO
    while slot < total {
      let field = run variantFieldFact(layouts, ty, tag, slot)
      let child = Interned<StaticData>.with<Option<Interned<StaticData>>>(value, fn(data: &StaticData) -> Option<Interned<StaticData>> {
        return StaticValue.field(data, slot)
      })
      if let Option<Interned<StaticData>>.Some {value: selected} = move child {
        run writeStatic(layouts, function, target, &selected, &field.ty, offset + field.offset, &mut image.*, &mut texts.*)
      }
      slot = slot + usize.ONE
    }
    return ()
  }
  let leaf = Interned<StaticData>.with<StaticLeaf>(value, staticLeaf)
  // An aggregate is a fixed array or a cleanup-free struct, as `Mir.materializeEmbedded` admits.
  let mut supported = leaf.supported
  if !leaf.scalar && !Interned<StaticData>.with<bool>(value, StaticValue.isStruct) {
    if let Option<ArrayShape>.None = move Type.arrayShape(ty) { supported = false }
  }
  if !supported {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.relative(GapCode.TypedForm, &owner, span)
  }
  if leaf.scalar {
    let facts = run layoutOf(layouts, ty, function, span)
    writeWord(&mut image.*, offset, facts.size, leaf.bits)
    return ()
  }
  let mut at = usize.ZERO
  while at < leaf.fields {
    let field = run fieldFact(layouts, ty, at, function, span)
    let child = Interned<StaticData>.with<Option<Interned<StaticData>>>(value, fn(data: &StaticData) -> Option<Interned<StaticData>> {
      return StaticValue.field(data, at)
    })
    if let Option<Interned<StaticData>>.Some {value: selected} = move child {
      run writeStatic(layouts, function, target, &selected, &field.ty, offset + field.offset, &mut image.*, &mut texts.*)
    }
    at = at + usize.ONE
  }
  return ()
}

// A private constant holding `value` of type `ty` at its runtime layout and alignment, which a
// shared borrow of a constant addresses for the whole program. Each text descriptor's address
// word is a pointer the link fills in.
effect fn staticValue(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  value: &Interned<StaticData>, ty: &Interned<Type>) -> u64
! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let name = run staticObject(&mut writer.*, function, target, layouts, value, ty)
  return run addressOf(&mut writer.*, Bytes.asSlice(&name))
}

// Defines the private constant `staticValue` addresses and returns its symbol.
effect fn staticObject(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  value: &Interned<StaticData>, ty: &Interned<Type>) -> Bytes
! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let facts = run layoutOf(layouts, ty, function, Location.make(usize.ZERO, usize.ZERO))
  let mut image = run Bytes.zeroed(facts.size)
  let mut texts = List<TextAddress>.make()
  run writeStatic(layouts, function, target, value, ty, usize.ZERO, &mut image, &mut texts)
  let word = u32.toUsize(Target.pointerBits(target)) / 8
  let mut pointers = List<ObjectPointer>.make()
  let addresses = List<TextAddress>.asSlice(&texts)
  let mut at = usize.ZERO
  while at < addresses.length {
    let data = match &addresses[at].view {
      Option<StaticView>.Some {value: view} => run staticObject(&mut writer.*, function, target, layouts, &view.value, &view.ty)
      Option<StaticView>.None => run bytesObject(&mut writer.*, Bytes.asSlice(&addresses[at].bytes))
    }
    run List<ObjectPointer>.append(&mut pointers, ObjectPointer {offset: addresses[at].offset, symbol: move data, addend: 0, size: word})
    at = at + usize.ONE
  }
  let name = run privateName(&mut writer.*, b".constant.")
  run defineObject(&mut writer.*, Bytes.asSlice(&name), facts.alignment, move image, move pointers, false, false)
  return move name
}

// The checked `stem` (`add`, `sub` or `mul`) of `left` and `right`, signed when `kind` is: the
// wrapped value and whether it overflowed.
effect fn overflowPair(writer: &mut Writer, stem: &[u8], kind: Representation, left: u64, right: u64) -> Checked
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut operation = Binary.Add
  if same(stem, b"sub") { operation = Binary.Sub }
  if same(stem, b"mul") { operation = Binary.Mul }
  return run SsaFunction.overflowing(&mut writer.*.function, operation, kind.signed, left, right)
}

/// Shared definitions, emitted into every unit, which the link keeps once: the fatal dispatch
/// helper, its frame walk over the step records (the frame table lookup, the report of one listed
/// frame, the chain of a stepped frame's suspended callers), and the guard of an adopted
/// allocation's reclaim call.
///
/// A construct the body builder cannot express leaves a fragment that records the refusal.
pub effect fn declarations(target: &Target, shared: bool, verify: bool) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  match move run Effect.result(declarationsChecked(target, shared, verify)) {
    Result<Bytes, Unsupported | OutOfMemoryError>.Success {value} => { return move value }
    Result<Bytes, Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported refused => { return run refusedFragment(move refused) }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// A fragment that records only the refusal `refused`.
effect fn refusedFragment(refused: Unsupported) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut fragment = Fragment.make()
  run List<Bytes>.append(&mut fragment.refused, move refused.detail)
  return run fragment.encode()
}

effect fn declarationsChecked(target: &Target, shared: bool, verify: bool) -> Bytes ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut writer = run writerFor(target, shared)
  writer.verify = verify
  run defineFatalDispatch(&mut writer, target)
  run defineFrameName(&mut writer, target)
  run defineFrameReport(&mut writer, target)
  run defineStepChain(&mut writer, target)
  run defineGuardedReclaim(&mut writer)
  return run writer.fragment.encode()
}

// `__silk_guarded_reclaim(reclaim, context)` calls `reclaim(context)`. Native targets guard the
// call with the foreign personality; a wasm target never unwinds, so the call is a plain one.
effect fn defineGuardedReclaim(writer: &mut Writer) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let pointer = run pointerType(&mut writer.*)
  run beginBody(&mut writer.*, b"__silk_guarded_reclaim")
  let reclaim = run parameterOf(&mut writer.*, pointer)
  let context = run parameterOf(&mut writer.*, pointer)
  let entry = run labelled(&mut writer.*, b"entry")
  run startBlock(&mut writer.*, entry)
  let arguments = [context]
  drop run callAddress(&mut writer.*, reclaim, &arguments, Kind.unit())
  run returnVoid(&mut writer.*)
  return run endBody(&mut writer.*, b"")
}

// The fatal dispatch helper an observed trap calls before trapping: event 6 with the selected
// cause's pool handle, or `0`, the trap reason and its site label (failure observer note N7). A
// null observer reports nothing. A record without an adapter is an execution's trap record, which
// forwards to the observer of the drive running it, without a cause.
//
// Event 6 then carries no cause: the helper reports each listed caller frame as event 8 with its
// name, and the cause last as event 9, so the call chain reads right below the trap site. A wasm
// target has no unwinder, so the walk follows the step records alone: each one names its stepped
// frame, then the suspended callers it leads to (`defineStepChain`).
effect fn defineFatalDispatch(writer: &mut Writer, target: &Target) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let word = wordSize(target)
  let bits = word * 8
  let pointer = run pointerType(&mut writer.*)
  let wordTy = run integerType(&mut writer.*, bits)
  run beginBody(&mut writer.*, b"silk.diagnostic.fatal")
  let observer = run parameterOf(&mut writer.*, pointer)
  let cause = run parameterOf(&mut writer.*, pointer)
  let reason = run parameterOf(&mut writer.*, pointer)
  let origin = run parameterOf(&mut writer.*, pointer)
  let entry = run labelled(&mut writer.*, b"entry")
  let find = run labelled(&mut writer.*, b"find")
  let report = run labelled(&mut writer.*, b"report")
  let forward = run labelled(&mut writer.*, b"forward")
  let deliver = run labelled(&mut writer.*, b"deliver")
  let selection = run labelled(&mut writer.*, b"selection")
  let call = run labelled(&mut writer.*, b"call")
  let done = run labelled(&mut writer.*, b"done")
  run startBlock(&mut writer.*, entry)
  let null = run nullOf(&mut writer.*)
  let zero = run constantOf(&mut writer.*, wordTy, 0)
  let record = run variableOf(&mut writer.*, pointer)
  run assignOf(&mut writer.*, record, observer)
  let held = run variableOf(&mut writer.*, pointer)
  run assignOf(&mut writer.*, held, cause)
  let first = run variableOf(&mut writer.*, wordTy)
  run branch(&mut writer.*, find)
  run startBlock(&mut writer.*, find)
  let absent = run compareOf(&mut writer.*, Predicate.Eq, record, null)
  run branchIf(&mut writer.*, absent, done, report)
  run startBlock(&mut writer.*, report)
  let callback = run loadPointer(&mut writer.*, record, usize.ZERO)
  let stateAddress = run byteOffset(&mut writer.*, record, word)
  let adapterless = run compareOf(&mut writer.*, Predicate.Eq, callback, null)
  run branchIf(&mut writer.*, adapterless, forward, deliver)
  run startBlock(&mut writer.*, forward)
  let forwarded = run loadPointer(&mut writer.*, stateAddress, usize.ZERO)
  run assignOf(&mut writer.*, record, forwarded)
  run assignOf(&mut writer.*, held, null)
  run branch(&mut writer.*, find)
  run startBlock(&mut writer.*, deliver)
  let state = run loadPointer(&mut writer.*, stateAddress, usize.ZERO)
  let callableAddress = run byteOffset(&mut writer.*, record, word * 2)
  let callable = run loadPointer(&mut writer.*, callableAddress, usize.ZERO)
  let selected = run compareOf(&mut writer.*, Predicate.Ne, held, null)
  run assignOf(&mut writer.*, first, zero)
  run branchIf(&mut writer.*, selected, selection, call)
  run startBlock(&mut writer.*, selection)
  let handleAddress = run byteOffset(&mut writer.*, held, companionHandleOffset(target))
  let handle = run loadKind(&mut writer.*, wordTy, handleAddress)
  run assignOf(&mut writer.*, first, handle)
  run branch(&mut writer.*, call)
  run startBlock(&mut writer.*, call)
  // The adapter is a Silk function, so its reason and origin slices arrive as pointer and length
  // lanes (#2530); the descriptors hold the pointer at offset 0 and the length one word later.
  let reasonData = run loadPointer(&mut writer.*, reason, usize.ZERO)
  let reasonLengthAddress = run byteOffset(&mut writer.*, reason, word)
  let reasonLength = run loadKind(&mut writer.*, wordTy, reasonLengthAddress)
  let originData = run loadPointer(&mut writer.*, origin, usize.ZERO)
  let originLengthAddress = run byteOffset(&mut writer.*, origin, word)
  let originLength = run loadKind(&mut writer.*, wordTy, originLengthAddress)
  let event = run integerOf(&mut writer.*, 8, 6)
  let arguments = [callable, state, event, zero, zero, reasonData, reasonLength, originData, originLength, null, null, null]
  drop run callAddress(&mut writer.*, callback, &arguments, wordTy)
  // The walk record `{callback, callable, state, count, site, site length, steps}` the frame walk
  // reads, `steps` the innermost step record it has yet to chain.
  let walk = run allocaOf(&mut writer.*, word * 7, word)
  run storeOf(&mut writer.*, callback, walk, word)
  let callableSlot = run byteOffset(&mut writer.*, walk, word)
  run storeOf(&mut writer.*, callable, callableSlot, word)
  let stateSlot = run byteOffset(&mut writer.*, walk, word * 2)
  run storeOf(&mut writer.*, state, stateSlot, word)
  let countSlot = run byteOffset(&mut writer.*, walk, word * 3)
  run storeOf(&mut writer.*, zero, countSlot, word)
  let siteSlot = run byteOffset(&mut writer.*, walk, word * 4)
  run storeOf(&mut writer.*, originData, siteSlot, word)
  let siteLengthSlot = run byteOffset(&mut writer.*, walk, word * 5)
  run storeOf(&mut writer.*, originLength, siteLengthSlot, word)
  let active = run activeSteps(&mut writer.*, word)
  let innermost = run loadPointer(&mut writer.*, active, word)
  let stepsSlot = run byteOffset(&mut writer.*, walk, word * 6)
  run storeOf(&mut writer.*, innermost, stepsSlot, word)
  // Each step record names its stepped frame, then the suspended callers it leads to.
  let records = run labelled(&mut writer.*, b"records")
  let stepped = run labelled(&mut writer.*, b"stepped")
  let walked = run labelled(&mut writer.*, b"walked")
  run branch(&mut writer.*, records)
  run startBlock(&mut writer.*, records)
  let steps = run loadPointer(&mut writer.*, stepsSlot, word)
  let unstepped = run compareOf(&mut writer.*, Predicate.Eq, steps, null)
  run branchIf(&mut writer.*, unstepped, walked, stepped)
  run startBlock(&mut writer.*, stepped)
  let top = run loadPointer(&mut writer.*, steps, word)
  let resume = run loadWordAt(&mut writer.*, top, Coroutine.resumeOffset(word))
  let named = run callFrameName(&mut writer.*, resume)
  run callFrameReport(&mut writer.*, walk, named)
  run callStepChain(&mut writer.*, walk)
  let count = run loadKind(&mut writer.*, wordTy, countSlot)
  let limit = run constantOf(&mut writer.*, wordTy, usize.toU64(frameLimit()))
  let exhausted = run compareOf(&mut writer.*, Predicate.Ugt, count, limit)
  run branchIf(&mut writer.*, exhausted, walked, records)
  run startBlock(&mut writer.*, walked)
  let causeBlock = run labelled(&mut writer.*, b"reportCause")
  let caused = run compareOf(&mut writer.*, Predicate.Ne, first, zero)
  run branchIf(&mut writer.*, caused, causeBlock, done)
  run startBlock(&mut writer.*, causeBlock)
  let causeEvent = run integerOf(&mut writer.*, 8, 9)
  let causeArguments = [callable, state, causeEvent, first, zero, null, zero, null, zero, null, null, null]
  drop run callAddress(&mut writer.*, callback, &causeArguments, wordTy)
  run branch(&mut writer.*, done)
  run startBlock(&mut writer.*, done)
  run returnVoid(&mut writer.*)
  return run endBody(&mut writer.*, b"")
}

// `silk.diagnostic.name(code)` answers the name descriptor the frame table lists for the function
// at `code`, or null. The table holds `{function, name}` entries the link lays out together
// between `__start_silk_frames` and `__stop_silk_frames` (`frameEntry`).
effect fn defineFrameName(writer: &mut Writer, target: &Target) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let word = wordSize(target)
  let pointer = run pointerType(&mut writer.*)
  run beginBody(&mut writer.*, b"silk.diagnostic.name")
  writer.function.setResult(pointer)
  let code = run parameterOf(&mut writer.*, pointer)
  let entry = run labelled(&mut writer.*, b"entry")
  let scan = run labelled(&mut writer.*, b"scan")
  let test = run labelled(&mut writer.*, b"test")
  let advance = run labelled(&mut writer.*, b"advance")
  let found = run labelled(&mut writer.*, b"found")
  let missing = run labelled(&mut writer.*, b"missing")
  run startBlock(&mut writer.*, entry)
  run List<Bytes>.append(&mut writer.*.fragment.weakObjects, run Bytes.copy(b"__start_silk_frames"))
  run List<Bytes>.append(&mut writer.*.fragment.weakObjects, run Bytes.copy(b"__stop_silk_frames"))
  let first = run addressOf(&mut writer.*, b"__start_silk_frames")
  let last = run addressOf(&mut writer.*, b"__stop_silk_frames")
  let at = run variableOf(&mut writer.*, pointer)
  run assignOf(&mut writer.*, at, first)
  run branch(&mut writer.*, scan)
  run startBlock(&mut writer.*, scan)
  let more = run compareOf(&mut writer.*, Predicate.Ult, at, last)
  run branchIf(&mut writer.*, more, test, missing)
  run startBlock(&mut writer.*, test)
  let listed = run loadPointer(&mut writer.*, at, word)
  let hit = run compareOf(&mut writer.*, Predicate.Eq, listed, code)
  run branchIf(&mut writer.*, hit, found, advance)
  run startBlock(&mut writer.*, advance)
  let after = run byteOffset(&mut writer.*, at, word * 2)
  run assignOf(&mut writer.*, at, after)
  run branch(&mut writer.*, scan)
  run startBlock(&mut writer.*, found)
  let nameAddress = run byteOffset(&mut writer.*, at, word)
  let name = run loadPointer(&mut writer.*, nameAddress, word)
  run returnValue(&mut writer.*, name)
  run startBlock(&mut writer.*, missing)
  let null = run nullOf(&mut writer.*)
  run returnValue(&mut writer.*, null)
  return run endBody(&mut writer.*, b"")
}

effect fn callFrameName(writer: &mut Writer, code: u64) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let pointer = run pointerType(&mut writer.*)
  let arguments = [code]
  return run callNamed(&mut writer.*, b"silk.diagnostic.name", pointer, &arguments)
}

// `silk.diagnostic.report(walk, name)` counts a listed frame and reports it as event 8 with its
// name descriptor `name`; a null `name` is an unlisted frame. A first listed frame whose name
// leads the trap's site label (`module.function (module:line:column)`) is the trapping function,
// which the site already names, so it is counted without a report.
effect fn defineFrameReport(writer: &mut Writer, target: &Target) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let word = wordSize(target)
  let bits = word * 8
  let pointer = run pointerType(&mut writer.*)
  let wordTy = run integerType(&mut writer.*, bits)
  let byte = run integerType(&mut writer.*, 8)
  run beginBody(&mut writer.*, b"silk.diagnostic.report")
  let walk = run parameterOf(&mut writer.*, pointer)
  let name = run parameterOf(&mut writer.*, pointer)
  let entry = run labelled(&mut writer.*, b"entry")
  let listed = run labelled(&mut writer.*, b"listed")
  let firstFrame = run labelled(&mut writer.*, b"first")
  let compare = run labelled(&mut writer.*, b"compare")
  let space = run labelled(&mut writer.*, b"space")
  let report = run labelled(&mut writer.*, b"report")
  let done = run labelled(&mut writer.*, b"done")
  run startBlock(&mut writer.*, entry)
  let null = run nullOf(&mut writer.*)
  let zero = run constantOf(&mut writer.*, wordTy, 0)
  let one = run constantOf(&mut writer.*, wordTy, 1)
  let unlisted = run compareOf(&mut writer.*, Predicate.Eq, name, null)
  run branchIf(&mut writer.*, unlisted, done, listed)
  run startBlock(&mut writer.*, listed)
  let countAddress = run byteOffset(&mut writer.*, walk, word * 3)
  let count = run loadKind(&mut writer.*, wordTy, countAddress)
  let counted = run binaryOf(&mut writer.*, Binary.Add, count, one)
  run storeOf(&mut writer.*, counted, countAddress, word)
  let nameData = run loadPointer(&mut writer.*, name, word)
  let nameLengthAddress = run byteOffset(&mut writer.*, name, word)
  let nameLength = run loadKind(&mut writer.*, wordTy, nameLengthAddress)
  let trapping = run compareOf(&mut writer.*, Predicate.Eq, count, zero)
  run branchIf(&mut writer.*, trapping, firstFrame, report)
  // The first listed frame is skipped when the site label is its name followed by ` (`.
  run startBlock(&mut writer.*, firstFrame)
  let siteSlot = run byteOffset(&mut writer.*, walk, word * 4)
  let site = run loadPointer(&mut writer.*, siteSlot, word)
  let siteLengthSlot = run byteOffset(&mut writer.*, walk, word * 5)
  let siteLength = run loadKind(&mut writer.*, wordTy, siteLengthSlot)
  let shorter = run compareOf(&mut writer.*, Predicate.Ult, nameLength, siteLength)
  run branchIf(&mut writer.*, shorter, compare, report)
  run startBlock(&mut writer.*, compare)
  let int32 = run integerType(&mut writer.*, 32)
  let compareArguments = [nameData, site, nameLength]
  let compared = run callNamed(&mut writer.*, b"memcmp", int32, &compareArguments)
  let int32Zero = run constantOf(&mut writer.*, int32, 0)
  let leading = run compareOf(&mut writer.*, Predicate.Eq, compared, int32Zero)
  run branchIf(&mut writer.*, leading, space, report)
  run startBlock(&mut writer.*, space)
  let afterName = run indexedOffset(&mut writer.*, site, nameLength)
  let nextByte = run loadKind(&mut writer.*, byte, afterName)
  let blank = run constantOf(&mut writer.*, byte, 32)
  let siteNamed = run compareOf(&mut writer.*, Predicate.Eq, nextByte, blank)
  run branchIf(&mut writer.*, siteNamed, done, report)
  run startBlock(&mut writer.*, report)
  let callback = run loadPointer(&mut writer.*, walk, word)
  let callableSlot = run byteOffset(&mut writer.*, walk, word)
  let callable = run loadPointer(&mut writer.*, callableSlot, word)
  let stateSlot = run byteOffset(&mut writer.*, walk, word * 2)
  let state = run loadPointer(&mut writer.*, stateSlot, word)
  let event = run constantOf(&mut writer.*, byte, 8)
  let arguments = [callable, state, event, zero, zero, nameData, nameLength, null, zero, null, null, null]
  drop run callAddress(&mut writer.*, callback, &arguments, wordTy)
  run branch(&mut writer.*, done)
  run startBlock(&mut writer.*, done)
  run returnVoid(&mut writer.*)
  return run endBody(&mut writer.*, b"")
}

effect fn callFrameReport(writer: &mut Writer, walk: u64, named: u64) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let arguments = [walk, named]
  drop run callNamed(&mut writer.*, b"silk.diagnostic.report", Kind.unit(), &arguments)
  return ()
}

// `silk.diagnostic.chain(walk)` reports the suspended callers of the frame the walk's innermost
// unchained step record holds, parent by parent (`defineFrameReport`), then moves the walk to the
// record's outer one. Only the frame chain knows these callers: each one's step returned when it or
// a callee it stepped directly gave the machine stack back to the driver, and a frame resumed later
// runs from its driver. The chain ends at the bottom frame, before the frame the outer record
// steps, which is on the machine stack, or after `frameLimit` frames.
effect fn defineStepChain(writer: &mut Writer, target: &Target) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let word = wordSize(target)
  let bits = word * 8
  let pointer = run pointerType(&mut writer.*)
  let wordTy = run integerType(&mut writer.*, bits)
  run beginBody(&mut writer.*, b"silk.diagnostic.chain")
  let walk = run parameterOf(&mut writer.*, pointer)
  let entry = run labelled(&mut writer.*, b"entry")
  let stepped = run labelled(&mut writer.*, b"stepped")
  let parents = run labelled(&mut writer.*, b"parents")
  let check = run labelled(&mut writer.*, b"check")
  let report = run labelled(&mut writer.*, b"report")
  let done = run labelled(&mut writer.*, b"done")
  run startBlock(&mut writer.*, entry)
  let null = run nullOf(&mut writer.*)
  let zero = run constantOf(&mut writer.*, wordTy, 0)
  let one = run constantOf(&mut writer.*, wordTy, 1)
  let limit = run constantOf(&mut writer.*, wordTy, usize.toU64(frameLimit()))
  let stop = run variableOf(&mut writer.*, pointer)
  let frame = run variableOf(&mut writer.*, pointer)
  let depth = run variableOf(&mut writer.*, wordTy)
  let stepsSlot = run byteOffset(&mut writer.*, walk, word * 6)
  let steps = run loadPointer(&mut writer.*, stepsSlot, word)
  let unstepped = run compareOf(&mut writer.*, Predicate.Eq, steps, null)
  run branchIf(&mut writer.*, unstepped, done, stepped)
  run startBlock(&mut writer.*, stepped)
  let top = run loadPointer(&mut writer.*, steps, word)
  let outer = run loadWordAt(&mut writer.*, steps, word)
  run storeOf(&mut writer.*, outer, stepsSlot, word)
  let caller = run loadPointer(&mut writer.*, top, word)
  // The frames up to the one the outer record steps are suspended callers. A step runs its direct
  // callee's step published in its own record, so that callee's caller is the outer record's frame,
  // which the walk reports itself.
  let enclosing = run labelled(&mut writer.*, b"enclosing")
  let begin = run labelled(&mut writer.*, b"begin")
  run assignOf(&mut writer.*, stop, null)
  let nested = run compareOf(&mut writer.*, Predicate.Ne, outer, null)
  run branchIf(&mut writer.*, nested, enclosing, begin)
  run startBlock(&mut writer.*, enclosing)
  let outerTop = run loadPointer(&mut writer.*, outer, word)
  run assignOf(&mut writer.*, stop, outerTop)
  run branch(&mut writer.*, begin)
  run startBlock(&mut writer.*, begin)
  run assignOf(&mut writer.*, frame, caller)
  run assignOf(&mut writer.*, depth, zero)
  run branch(&mut writer.*, parents)
  run startBlock(&mut writer.*, parents)
  let absent = run compareOf(&mut writer.*, Predicate.Eq, frame, null)
  let reached = run compareOf(&mut writer.*, Predicate.Eq, frame, stop)
  let ended = run binaryOf(&mut writer.*, Binary.Or, absent, reached)
  run branchIf(&mut writer.*, ended, done, check)
  run startBlock(&mut writer.*, check)
  let parent = run loadPointer(&mut writer.*, frame, word)
  run branch(&mut writer.*, report)
  run startBlock(&mut writer.*, report)
  let resume = run loadWordAt(&mut writer.*, frame, Coroutine.resumeOffset(word))
  let named = run callFrameName(&mut writer.*, resume)
  run callFrameReport(&mut writer.*, walk, named)
  run assignOf(&mut writer.*, frame, parent)
  let deeper = run binaryOf(&mut writer.*, Binary.Add, depth, one)
  run assignOf(&mut writer.*, depth, deeper)
  let countAddress = run byteOffset(&mut writer.*, walk, word * 3)
  let count = run loadKind(&mut writer.*, wordTy, countAddress)
  let exhausted = run compareOf(&mut writer.*, Predicate.Ugt, count, limit)
  let deep = run compareOf(&mut writer.*, Predicate.Ugt, deeper, limit)
  let ending = run binaryOf(&mut writer.*, Binary.Or, exhausted, deep)
  run branchIf(&mut writer.*, ending, done, parents)
  run startBlock(&mut writer.*, done)
  run returnVoid(&mut writer.*)
  return run endBody(&mut writer.*, b"")
}

effect fn callStepChain(writer: &mut Writer, walk: u64) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let arguments = [walk]
  drop run callNamed(&mut writer.*, b"silk.diagnostic.chain", Kind.unit(), &arguments)
  return ()
}

// The most caller frames one trap reports; a deeper chain, such as a runaway recursion, ends
// there.
fn frameLimit() -> usize { return 64 }

// Adds the entry `{defined, name}` of a function that has a frame name to the frame table the
// fatal helper's walk reads (`defineFrameName`). `suffix` follows the function's symbol in the
// defined function's, as `$step` does for the frame's step.
effect fn frameEntry(writer: &mut Writer, function: &MirFunction, target: &Target, suffix: &[u8]) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if Bytes.length(&function.frame) == usize.ZERO { return () }
  let word = wordSize(target)
  let label = run stringObject(&mut writer.*, Bytes.asSlice(&function.frame), word * 8)
  let mut defined = run Bytes.copy(Bytes.asSlice(&writer.symbol))
  run Bytes.append(&mut defined, suffix)
  let mut name = run Bytes.copy(Bytes.asSlice(&defined))
  run Bytes.append(&mut name, b".frame")
  let mut pointers = List<ObjectPointer>.make()
  run List<ObjectPointer>.append(&mut pointers, ObjectPointer {offset: usize.ZERO, symbol: move defined, addend: 0, size: word})
  run List<ObjectPointer>.append(&mut pointers, ObjectPointer {offset: word, symbol: move label, addend: 0, size: word})
  return run defineObject(&mut writer.*, Bytes.asSlice(&name), word, run Bytes.zeroed(word * 2), move pointers, true, false)
}

// Branches to a trap when `condition` holds. Under an observer, the trap first reports `reason` at
// the statement's site through the fatal dispatch helper (event 6, N7).
effect fn trapWhen(writer: &mut Writer, condition: u64, reason: &[u8]) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let trap = run labelled(&mut writer.*, b"trap")
  let safe = run labelled(&mut writer.*, b"safe")
  run branchIf(&mut writer.*, condition, trap, safe)
  run startBlock(&mut writer.*, trap)
  run reportTrap(&mut writer.*, reason)
  run trapHere(&mut writer.*)
  return run startBlock(&mut writer.*, safe)
}

// Like [`trapWhen`] for an operand the caller supplies, such as a shift count: the violated
// precondition belongs to the call that entered the package, so the report names it (TERM-008).
effect fn trapWhenEntered(writer: &mut Writer, condition: u64, reason: &[u8]) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let trap = run labelled(&mut writer.*, b"trap")
  let safe = run labelled(&mut writer.*, b"safe")
  run branchIf(&mut writer.*, condition, trap, safe)
  run startBlock(&mut writer.*, trap)
  let mut entry = none()
  let mut bits = usize.ZERO
  if let Option<TrapReport>.Some {value} = &writer.trap {
    entry = value.entry
    bits = value.bits
  }
  if bits != usize.ZERO {
    let reasonText = run staticString(&mut writer.*, reason, bits)
    run reportTrapDescriptor(&mut writer.*, reasonText, entry)
  }
  run trapHere(&mut writer.*)
  return run startBlock(&mut writer.*, safe)
}

// Where a trap emitted for the statement at `origin` reports: the function's observer and cause
// locals with the statement's recorded site label, when the function observes (event 6, N7).
effect fn trapReport(writer: &Writer, function: &MirFunction, target: &Target, origin: Origin) -> Option<TrapReport>
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let observer = writer.observerLocal
  if observer == usize.MAX { return Option<TrapReport>.none() }
  let sites = List<TrapSite>.asSlice(&function.traps)
  let mut at = usize.ZERO
  while at < sites.length {
    if sites[at].origin.node == origin.node && sites[at].origin.location.start == origin.location.start {
      // A trap of an inlined body names the locals holding what its call passed.
      let mut site = writer.siteLocal
      let mut held = observer
      let mut cause = writer.causeLocal
      if sites[at].observer != usize.MAX {
        site = sites[at].site
        held = sites[at].observer
        cause = sites[at].cause
      }
      let mut entry = none()
      if site != usize.MAX { entry = slotOf(writer, site) }
      return Option<TrapReport>.some(TrapReport {observer: slotOf(writer, held), cause: slotOf(writer, cause),
        label: run Bytes.copy(Bytes.asSlice(&sites[at].label)), bits: wordSize(target) * 8, entry: entry})
    }
    at = at + usize.ONE
  }
  return Option<TrapReport>.none()
}

// Calls the fatal dispatch helper with the current observer and cause, when the statement has a
// recorded trap site.
effect fn reportTrap(writer: &mut Writer, reason: &[u8]) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let bits = match &writer.trap {
    Option<TrapReport>.Some {value} => value.bits
    Option<TrapReport>.None => { return () }
  }
  let reasonText = run staticString(&mut writer.*, reason, bits)
  return run reportTrapDescriptor(&mut writer.*, reasonText, none())
}

// Calls the fatal dispatch helper with the reason descriptor at address `reasonText`, when the
// statement has a recorded trap site. An `entry` other than `none()` is the local holding the
// function's package entry site, which the report names instead of the statement's site when it is
// not null.
effect fn reportTrapDescriptor(writer: &mut Writer, reasonText: u64, entry: u64) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let report = match &writer.trap {
    Option<TrapReport>.Some {value} => TrapReport {observer: value.observer, cause: value.cause,
      label: run Bytes.copy(Bytes.asSlice(&value.label)), bits: value.bits, entry: value.entry}
    Option<TrapReport>.None => { return () }
  }
  let mut labelText = run staticString(&mut writer.*, Bytes.asSlice(&report.label), report.bits)
  if entry != none() {
    let entered = run loadPointer(&mut writer.*, entry, usize.ZERO)
    let null = run nullOf(&mut writer.*)
    let absent = run compareOf(&mut writer.*, Predicate.Eq, entered, null)
    labelText = run selectOf(&mut writer.*, absent, labelText, entered)
  }
  let observer = run loadPointer(&mut writer.*, report.observer, usize.ZERO)
  let cause = run loadPointer(&mut writer.*, report.cause, usize.ZERO)
  let arguments = [observer, cause, reasonText, labelText]
  drop run callNamed(&mut writer.*, b"silk.diagnostic.fatal", Kind.unit(), &arguments)
  return ()
}

effect fn checkedBinary(writer: &mut Writer, operation: &[u8], lhs: &Value, rhs: &Value) -> Value
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let pair = run overflowPair(&mut writer.*, operation, lhs.scalar, lhs.value, rhs.value)
  let any = run anyLane(&mut writer.*, pair.overflow, lhs.scalar)
  run trapWhen(&mut writer.*, any, b"arithmetic overflow")
  return Value {scalar: lhs.scalar, value: pair.value}
}

// The `i1` flag of a scalar, or the `<N x i1>` flags of a vector's lanes.
fn flags(kind: Representation) -> Representation {
  return Representation {aggregate: false, size: usize.ZERO, bits: usize.ONE, signed: false, unit: false, pointer: false,
    floating: false, lanes: kind.lanes, unionAlignment: usize.ZERO, head: usize.ZERO}
}

// Whether any lane of `flag` (the flags of a `kind` operation) is set; a scalar flag is itself.
effect fn anyLane(writer: &mut Writer, flag: u64, kind: Representation) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  if kind.lanes == usize.ZERO { return flag }
  return run SsaFunction.reduce(&mut writer.*.function, Reduction.Or, flag, none())
}

// The one `bool` of a comparison whose lane flags are `flag`: `==` holds when every lane is equal
// and `!=` when any lane differs (SIMD-002). A scalar comparison's flag is itself.
effect fn wholeVector(writer: &mut Writer, flag: u64, kind: Representation, operation: InfixOperator) -> u64
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if kind.lanes == usize.ZERO { return flag }
  if operation != InfixOperator.Equals { return run anyLane(&mut writer.*, flag, kind) }
  return run SsaFunction.reduce(&mut writer.*.function, Reduction.And, flag, none())
}

// The bits of the smallest value of a signed integer of `bits`, or zero for a width without one.
fn signedMinimum(bits: usize) -> u64 {
  if bits == 8 || bits == 16 || bits == 32 || bits == 64 { return u64.shiftLeft(u64.MAX, usize.toU64(bits - usize.ONE)) }
  return 0
}

effect fn guardedDivision(
  writer: &mut Writer,
  function: &MirFunction,
  lhs: &Value,
  rhs: &Value,
  remainder: bool,
  span: Location,
) -> Value ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator {
  let minimum = signedMinimum(lhs.scalar.bits)
  if lhs.scalar.signed && minimum == 0 {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.relative(GapCode.ArithmeticTrap, &owner, span)
  }
  let zeroValue = run intOf(&mut writer.*, rhs.scalar, 0)
  let zero = run compareOf(&mut writer.*, Predicate.Eq, rhs.value, zeroValue)
  let anyZero = run anyLane(&mut writer.*, zero, rhs.scalar)
  run trapWhen(&mut writer.*, anyZero, b"division by zero")
  if lhs.scalar.signed {
    let minimumValue = run intOf(&mut writer.*, lhs.scalar, minimum)
    let min = run compareOf(&mut writer.*, Predicate.Eq, lhs.value, minimumValue)
    let negativeOneValue = run intOf(&mut writer.*, rhs.scalar, u64.MAX)
    let negativeOne = run compareOf(&mut writer.*, Predicate.Eq, rhs.value, negativeOneValue)
    let overflow = run binaryOf(&mut writer.*, Binary.And, min, negativeOne)
    let anyOverflow = run anyLane(&mut writer.*, overflow, lhs.scalar)
    run trapWhen(&mut writer.*, anyOverflow, b"arithmetic overflow")
  }
  let mut op = Binary.UDiv
  if lhs.scalar.signed && remainder { op = Binary.SRem }
  else if lhs.scalar.signed { op = Binary.SDiv }
  else if remainder { op = Binary.URem }
  return Value {scalar: lhs.scalar, value: run binaryOf(&mut writer.*, op, lhs.value, rhs.value)}
}


struct Address {
  ty: Interned<Type>,
  value: u64,
  alignment: usize,
  representation: Representation,
}

// Stores a split parameter's lanes, `inputs` (`parameterLanes`), into its slot.
effect fn storeLanes(writer: &mut Writer, split: &ParameterLanes, slot: u64, alignment: usize, inputs: &[u64]) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if let Option<Interned<Type>>.Some {value: field} = &split.field {
    let address = Address {ty: Interned<Type>.clone(&field), value: slot, alignment: alignment, representation: split.lanes[0]}
    return run storeValue(&mut writer.*, &address, &Value {scalar: split.lanes[0], value: inputs[0]})
  }
  let mut at = usize.ZERO
  while at < split.count {
    let mut address = slot
    if split.offsets[at] != usize.ZERO { address = run byteOffset(&mut writer.*, slot, split.offsets[at]) }
    run storeOf(&mut writer.*, inputs[at], address, offsetAlignment(alignment, split.offsets[at]))
    at = at + usize.ONE
  }
  return ()
}

// Adds the parameter lanes of `split` after its first, recording them in `writer.extras`.
effect fn addExtraLanes(writer: &mut Writer, split: &ParameterLanes) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut lane = usize.ONE
  while lane < 4 {
    let mut added = none()
    if lane < split.count {
      let ty = run typeOf(&mut writer.*, split.lanes[lane])
      added = run parameterOf(&mut writer.*, ty)
    }
    run List<u64>.append(&mut writer.*.extras, added)
    lane = lane + usize.ONE
  }
  return ()
}

effect fn projectField(writer: &mut Writer, function: &MirFunction, target: &Target,
  layouts: &TypeLayouts, base: &Address, index: usize, span: Location) -> Address
! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let field = run fieldFact(layouts, &base.ty, index, function, span)
  let projected = run wordOffset(&mut writer.*, base.value, field.offset)
  let metrics = run layoutOf(layouts, &field.ty, function, span)
  let represented = storageRepresentation(&field.ty, target, metrics)
  return Address {ty: move field.ty, value: projected,
    alignment: offsetAlignment(base.alignment, field.offset), representation: represented}
}

// `index * stride` bytes past `address`, the index keeping its own width.
effect fn stridedOffset(writer: &mut Writer, address: u64, index: &Value, stride: usize) -> u64
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let strideValue = run intOf(&mut writer.*, index.scalar, usize.toU64(stride))
  let offset = run binaryOf(&mut writer.*, Binary.Mul, index.value, strideValue)
  return run indexedOffset(&mut writer.*, address, offset)
}

effect fn emitPlace(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  place: &Place,
) -> Address ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut rootAlignment = usize.MAX
  if place.local < List<usize>.length(&writer.alignments) { rootAlignment = List<usize>.get(&writer.alignments, place.local) }
  let path = run LoweringPlan.placePath(function, target, layouts, place, rootAlignment)
  let mut address = slotOf(&writer.*, place.local)
  let steps = List<Step>.asSlice(&path.steps)
  let mut at = usize.ZERO
  while at < steps.length {
    match steps[at] {
      Step.Load {alignment} => { address = run loadPointer(&mut writer.*, address, alignment) }
      Step.Member {offset} => { address = run wordOffset(&mut writer.*, address, offset) }
      Step.Variant {offset} => { address = run byteOffset(&mut writer.*, address, offset) }
      Step.Index {local, stride} => {
        let indexPlace = Place {local: local, projections: List<Projection>.make()}
        let selectedIndex = run loadPlace(&mut writer.*, function, target, layouts, &indexPlace)
        address = run stridedOffset(&mut writer.*, address, &selectedIndex, stride)
      }
    }
    at = at + usize.ONE
  }
  return Address {ty: move path.ty, value: address, alignment: path.alignment, representation: path.representation}
}

effect fn loadPlace(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  place: &Place,
) -> Value ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let address = run emitPlace(&mut writer.*, function, target, layouts, place)
  return run loadAddress(&mut writer.*, &address)
}

// Reuse the resolved address when an operation must validate its exact source type before loading.
effect fn loadAddress(writer: &mut Writer, address: &Address) -> Value
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let kind = address.representation
  if kind.unit {
    return Value {scalar: kind, value: none()}
  }
  // The consuming store copies the bytes; nothing writes memory between this read and that store.
  if kind.aggregate {
    return Value {scalar: kind, value: address.value}
  }
  return Value {scalar: kind, value: run loadOf(&mut writer.*, kind, address.value, address.alignment)}
}

effect fn emitOperand(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  operand: &Operand,
) -> Value ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  return match & operand.* {
    Operand.Copy {place} => run loadPlace(&mut writer.*, function, target, layouts, &place)
    Operand.Move {place} => run loadPlace(&mut writer.*, function, target, layouts, &place)
    Operand.Integer {decimal: digits, negative, ty} => {
      let mut kind = scalar(&ty, target)
      if kind.bits == usize.ZERO && !kind.unit {
        let facts = run layoutOf(layouts, &ty, function, Location.make(usize.ZERO, usize.ZERO))
        kind = storageRepresentation(&ty, target, facts)
      }
      return Value {scalar: kind, value: run intOf(&mut writer.*, kind, decimalBits(Bytes.asSlice(&digits), negative))}
    }
    Operand.Float {bits, ty} => {
      let kind = scalar(&ty, target)
      return Value {scalar: kind, value: run floatOf(&mut writer.*, kind, bits)}
    }
    Operand.Boolean {value} => Value {scalar: booleanRepresentation(), value: run boolOf(&mut writer.*, value)}
    Operand.Unit => Value {
      scalar: Representation {aggregate: false, size: usize.ZERO, bits: usize.ZERO, signed: false, unit: true, pointer: false, floating: false, lanes: usize.ZERO, unionAlignment: usize.ZERO, head: usize.ZERO},
      value: none(),
    }
    Operand.Null {..} => Value {scalar: pointerRepresentation(target), value: run nullOf(&mut writer.*)}
    Operand.StaticText {bytes} => Value {scalar: pointerRepresentation(target),
      value: run staticString(&mut writer.*, Bytes.asSlice(&bytes), u32.toUsize(Target.pointerBits(target)))}
    Operand.StaticBytes {bytes} => Value {scalar: pointerRepresentation(target),
      value: run staticBytes(&mut writer.*, Bytes.asSlice(&bytes))}
    Operand.StaticValue {value, ty} => Value {scalar: pointerRepresentation(target),
      value: run staticValue(&mut writer.*, function, target, layouts, &value, &ty)}
  }
}

effect fn emitArgument(writer: &mut Writer, function: &MirFunction, target: &Target,
  layouts: &TypeLayouts, operand: &Operand, foreign: bool) -> Value ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut lanes = List<Value>.make()
  run appendArgument(&mut writer.*, function, target, layouts, operand, foreign, &mut lanes)
  return List<Value>.get(&lanes, usize.ZERO)
}

// Appends the lanes `operand` passes in: a split record's (`parameterLanes`) for a Silk callee,
// else its one value, which is unit for a unit argument.
effect fn appendArgument(writer: &mut Writer, function: &MirFunction, target: &Target,
  layouts: &TypeLayouts, operand: &Operand, foreign: bool, lanes: &mut List<Value>) -> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut place = Option<Address>.none()
  if let Operand.Copy {place: source} = &operand.* {
    place = Option<Address>.some(run emitPlace(&mut writer.*, function, target, layouts, &source))
  }
  if let Operand.Move {place: source} = &operand.* {
    place = Option<Address>.some(run emitPlace(&mut writer.*, function, target, layouts, &source))
  }
  if let Option<Address>.Some {value: address} = move place {
    if address.representation.aggregate && !foreign {
      let facts = run layoutOf(layouts, &address.ty, function, Location.generated())
      let split = run parameterLanes(layouts, &address.ty, facts, target, function, Location.generated())
      if split.count != usize.ZERO {
        let mut at = usize.ZERO
        while at < split.count {
          let mut source = address.value
          if split.offsets[at] != usize.ZERO { source = run byteOffset(&mut writer.*, address.value, split.offsets[at]) }
          let lane = split.lanes[at]
          run List<Value>.append(&mut lanes.*, Value {scalar: lane,
            value: run loadOf(&mut writer.*, lane, source, offsetAlignment(address.alignment, split.offsets[at]))})
          at = at + usize.ONE
        }
        return ()
      }
    }
    if address.representation.aggregate || (!foreign && passedIndirectly(address.representation)) {
      return run List<Value>.append(&mut lanes.*, Value {scalar: pointerRepresentation(target), value: address.value})
    }
  }
  let value = run emitOperand(&mut writer.*, function, target, layouts, operand)
  // A wide vector argument is always a place, whose address a Silk callee reads; a C callee
  // takes the vector itself.
  if !foreign && passedIndirectly(value.scalar) {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.relative(GapCode.TypedForm, &owner, Location.generated())
  }
  return run List<Value>.append(&mut lanes.*, value)
}

fn lengthRepresentation(target: &Target) -> Representation {
  return Representation {aggregate: false, size: usize.ZERO, bits: u32.toUsize(Target.pointerBits(target)),
    signed: false, unit: false, pointer: false, floating: false, lanes: usize.ZERO, unionAlignment: usize.ZERO, head: usize.ZERO}
}

// Selects the floating compare predicate for an operation, if it has one.
fn floatPredicate(operation: InfixOperator) -> Option<Predicate> {
  return match operation {
    InfixOperator.Equals => Option<Predicate>.some(Predicate.Oeq)
    InfixOperator.NotEquals => Option<Predicate>.some(Predicate.Une)
    InfixOperator.LessThan => Option<Predicate>.some(Predicate.Olt)
    InfixOperator.LessOrEqual => Option<Predicate>.some(Predicate.Ole)
    InfixOperator.GreaterThan => Option<Predicate>.some(Predicate.Ogt)
    InfixOperator.GreaterOrEqual => Option<Predicate>.some(Predicate.Oge)
    _ => Option<Predicate>.none()
  }
}

// Selects the IEEE 754 arithmetic operation for an operation, if it has one: the signed division
// operations stand for the float ones.
fn floatOpcode(operation: InfixOperator) -> Option<Binary> {
  return match operation {
    InfixOperator.Add => Option<Binary>.some(Binary.Add)
    InfixOperator.Subtract => Option<Binary>.some(Binary.Sub)
    InfixOperator.Multiply => Option<Binary>.some(Binary.Mul)
    InfixOperator.Divide => Option<Binary>.some(Binary.SDiv)
    InfixOperator.Remainder => Option<Binary>.some(Binary.SRem)
    _ => Option<Binary>.none()
  }
}

// Selects the integer compare predicate for an operation, if it has one.
fn integerPredicate(operation: InfixOperator, signed: bool) -> Option<Predicate> {
  return match operation {
    InfixOperator.Equals => Option<Predicate>.some(Predicate.Eq)
    InfixOperator.NotEquals => Option<Predicate>.some(Predicate.Ne)
    InfixOperator.LessThan => { if signed { return Option<Predicate>.some(Predicate.Slt) } return Option<Predicate>.some(Predicate.Ult) }
    InfixOperator.LessOrEqual => { if signed { return Option<Predicate>.some(Predicate.Sle) } return Option<Predicate>.some(Predicate.Ule) }
    InfixOperator.GreaterThan => { if signed { return Option<Predicate>.some(Predicate.Sgt) } return Option<Predicate>.some(Predicate.Ugt) }
    InfixOperator.GreaterOrEqual => { if signed { return Option<Predicate>.some(Predicate.Sge) } return Option<Predicate>.some(Predicate.Uge) }
    _ => Option<Predicate>.none()
  }
}

// Selects the bitwise operation for an operation, if it has one.
fn bitwiseOpcode(operation: InfixOperator) -> Option<Binary> {
  return match operation {
    InfixOperator.BitAnd => Option<Binary>.some(Binary.And)
    InfixOperator.And => Option<Binary>.some(Binary.And)
    InfixOperator.BitOr => Option<Binary>.some(Binary.Or)
    InfixOperator.Or => Option<Binary>.some(Binary.Or)
    InfixOperator.BitXor => Option<Binary>.some(Binary.Xor)
    _ => Option<Binary>.none()
  }
}

// Whether a semantic type is a numeric scalar or a vector of numeric lanes, whose scalar
// operations apply lane by lane.
fn numericValue(ty: &Interned<Type>) -> bool {
  if let Option<ArrayShape>.Some {value: shape} = move Type.vectorShape(ty) { return numericPrimitive(&shape.element) }
  return numericPrimitive(ty)
}

// Whether a semantic type is a numeric scalar: an integer, a floating type or a character. A
// scalar enum shares an integer's storage but is not numeric.
fn numericPrimitive(ty: &Interned<Type>) -> bool {
  return Interned<Type>.with<bool>(ty, fn(value: &Type) -> bool {
    if let Type.Primitive {name} = &value.* {
      let word = Bytes.asSlice(&name)
      return same(word, b"u8") || same(word, b"u16") || same(word, b"u32") || same(word, b"u64") || same(word, b"usize")
        || same(word, b"i8") || same(word, b"i16") || same(word, b"i32") || same(word, b"i64") || same(word, b"isize")
        || same(word, b"f32") || same(word, b"f64") || same(word, b"char")
    }
    return false
  })
}

// Scalar intrinsic operations admit actual numeric primitives, not an enum's scalar storage.
effect fn emitNumeric(
  writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts, operand: &Operand, span: Location,
) -> Value ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  match &operand.* {
    Operand.Copy {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      if numericValue(&address.ty) { return run loadAddress(&mut writer.*, &address) }
    }
    Operand.Move {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      if numericValue(&address.ty) { return run loadAddress(&mut writer.*, &address) }
    }
    Operand.Integer {ty, ..} => {
      if numericValue(&ty) { return run emitOperand(&mut writer.*, function, target, layouts, operand) }
    }
    Operand.Float {ty, ..} => {
      if numericValue(&ty) { return run emitOperand(&mut writer.*, function, target, layouts, operand) }
    }
    _ => ()
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.relative(GapCode.TypedForm, &owner, span)
}

effect fn typedFormGap(function: &MirFunction, span: Location) -> never ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator {
  let owner = InstanceKey.identity(&function.key)
  fail Gap.relative(GapCode.TypedForm, &owner, span)
}

// 2^power for power <= 63.
fn powerOfTwo(power: usize) -> u64 {
  return u64.shiftLeft(1, usize.toU64(power))
}

// 2^bits - 1 for bits <= 64.
fn allOnes(bits: usize) -> u64 {
  if bits == 64 { return u64.MAX }
  return powerOfTwo(bits) - 1
}

// The number of magnitude bits: one fewer than the width for a signed integer.
fn magnitudeBits(kind: Representation) -> usize {
  if kind.signed { return kind.bits - usize.ONE }
  return kind.bits
}

// The bits of the largest value of an integer representation.
fn maximumBits(kind: Representation) -> u64 {
  return allOnes(magnitudeBits(kind))
}

// The bits of the smallest value of an integer representation.
fn minimumBits(kind: Representation) -> u64 {
  if !kind.signed { return 0 }
  return u64.wrappingSubtract(0, powerOfTwo(kind.bits - usize.ONE))
}

// The binary64 bits of the exact integer `±(2^power)` or `±(2^power + 1)`, for power <= 52 when
// `plusOne`. Both are exactly representable, in binary32 too while power stays below 24.
fn exactDouble(negative: bool, power: usize, plusOne: bool) -> u64 {
  let mut bits = u64.shiftLeft(usize.toU64(1023 + power), 52)
  if plusOne { bits = u64.bitOr(bits, powerOfTwo(52 - power)) }
  if negative { bits = u64.bitOr(bits, powerOfTwo(63)) }
  return bits
}

fn isIntegral(kind: Representation) -> bool {
  return !kind.aggregate && !kind.pointer && !kind.unit && !kind.floating && kind.bits >= 8
}

fn isFloating(kind: Representation) -> bool {
  return !kind.aggregate && !kind.pointer && !kind.unit && kind.floating
}

// Compares `value` of `kind` with the constant `bits` under `predicate`.
effect fn compareWith(writer: &mut Writer, predicate: Predicate, kind: Representation, value: u64, bits: u64) -> u64
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let constant = run intOf(&mut writer.*, kind, bits)
  return run compareOf(&mut writer.*, predicate, value, constant)
}

// Compares `value` of floating `kind` with the binary64 constant `bits` under `predicate`.
effect fn compareWithFloat(writer: &mut Writer, predicate: Predicate, kind: Representation, value: u64, bits: u64) -> u64
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let constant = run floatOf(&mut writer.*, kind, bits)
  return run compareOf(&mut writer.*, predicate, value, constant)
}

// Traps when an integer value lies outside the destination integer range (CONV-002).
effect fn integerRangeGuard(writer: &mut Writer, input: &Value, output: Representation) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let violation = run integerRangeViolation(&mut writer.*, input, output)
  if violation != none() {
    let any = run anyLane(&mut writer.*, violation, input.scalar)
    run trapWhen(&mut writer.*, any, b"arithmetic overflow")
  }
  return ()
}

// The condition that an integer value lies outside the destination integer range, or `none()`
// when every source value fits.
effect fn integerRangeViolation(writer: &mut Writer, input: &Value, output: Representation) -> u64
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let source = input.scalar
  let mut below = none()
  if source.signed && (!output.signed || output.bits < source.bits) {
    below = run compareWith(&mut writer.*, Predicate.Slt, source, input.value, minimumBits(output))
  }
  let mut above = none()
  if magnitudeBits(output) < magnitudeBits(source) {
    let mut predicate = Predicate.Ugt
    if source.signed { predicate = Predicate.Sgt }
    above = run compareWith(&mut writer.*, predicate, source, input.value, maximumBits(output))
  }
  if below == none() { return above }
  if above == none() { return below }
  return run binaryOf(&mut writer.*, Binary.Or, below, above)
}

fn characterType(ty: &Interned<Type>) -> bool {
  return Interned<Type>.with<bool>(ty, fn(value: &Type) -> bool {
    return match &value.* {
      Type.Primitive {name} => same(Bytes.asSlice(&name), b"char")
      _ => false
    }
  })
}

// Whether an integer is exactly representable in an integer type, or is a Unicode scalar value:
// at most 0x10FFFF and outside the surrogates 0xD800 to 0xDFFF.
effect fn emitFits(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  operand: &Operand, ty: &Interned<Type>, span: Location) -> Value ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let input = run emitNumeric(&mut writer.*, function, target, layouts, operand, span)
  if !isIntegral(input.scalar) || !numericPrimitive(ty) { return run typedFormGap(function, span) }
  let boolean = booleanRepresentation()
  if characterType(ty) {
    let above = run compareWith(&mut writer.*, Predicate.Ugt, input.scalar, input.value, 1114111)
    let low = run compareWith(&mut writer.*, Predicate.Uge, input.scalar, input.value, 55296)
    let high = run compareWith(&mut writer.*, Predicate.Ule, input.scalar, input.value, 57343)
    let surrogate = run binaryOf(&mut writer.*, Binary.And, low, high)
    let invalid = run binaryOf(&mut writer.*, Binary.Or, above, surrogate)
    return Value {scalar: boolean, value: run notOf(&mut writer.*, boolean, invalid)}
  }
  let output = scalar(ty, target)
  if !isIntegral(output) { return run typedFormGap(function, span) }
  let invalid = run integerRangeViolation(&mut writer.*, &input, output)
  if invalid == none() { return Value {scalar: boolean, value: run boolOf(&mut writer.*, true)} }
  return Value {scalar: boolean, value: run notOf(&mut writer.*, boolean, invalid)}
}

// Traps when a floating value is NaN or truncates outside the destination integer range. The
// high bound `maximum + 1` is a power of two; below the low bound the truncation falls under the
// minimum, tested inclusively against `minimum - 1` when that is exactly representable.
effect fn floatRangeGuard(writer: &mut Writer, input: &Value, output: Representation) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut precision: usize = 53
  if input.scalar.bits == 32 { precision = 24 }
  let exactLow = !output.signed || output.bits <= precision
  let mut low = exactDouble(true, usize.ZERO, false)
  if output.signed { low = exactDouble(true, output.bits - usize.ONE, exactLow) }
  let high = exactDouble(false, magnitudeBits(output), false)
  let mut predicate = Predicate.Ultf
  if exactLow { predicate = Predicate.Ulef }
  let below = run compareWithFloat(&mut writer.*, predicate, input.scalar, input.value, low)
  let above = run compareWithFloat(&mut writer.*, Predicate.Ugef, input.scalar, input.value, high)
  let invalid = run binaryOf(&mut writer.*, Binary.Or, below, above)
  let any = run anyLane(&mut writer.*, invalid, input.scalar)
  return run trapWhen(&mut writer.*, any, b"arithmetic overflow")
}

effect fn emitConvert(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  operand: &Operand, ty: &Interned<Type>, span: Location) -> Value ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let input = run emitNumeric(&mut writer.*, function, target, layouts, operand, span)
  let output = scalar(ty, target)
  if !numericValue(ty) || input.scalar.lanes != output.lanes { return run typedFormGap(function, span) }
  if input.scalar.floating && output.floating {
    if input.scalar.bits == output.bits { return Value {scalar: output, value: input.value} }
    if input.scalar.bits > output.bits { return run castOf(&mut writer.*, Cast.FPTrunc, &input, output) }
    return run castOf(&mut writer.*, Cast.FPExt, &input, output)
  }
  if output.floating {
    if input.scalar.signed { return run castOf(&mut writer.*, Cast.SIToFP, &input, output) }
    return run castOf(&mut writer.*, Cast.UIToFP, &input, output)
  }
  if input.scalar.floating {
    run floatRangeGuard(&mut writer.*, &input, output)
    if output.signed { return run castOf(&mut writer.*, Cast.FPToSI, &input, output) }
    return run castOf(&mut writer.*, Cast.FPToUI, &input, output)
  }
  run integerRangeGuard(&mut writer.*, &input, output)
  return run resize(&mut writer.*, &input, output)
}

// Classifies a floating value from its IEEE 754 exponent and fraction fields, as the bootstrap
// does; the square root is wasm's correctly rounded one.
effect fn emitScalarUnary(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  operation: ScalarUnary, operand: &Operand, span: Location) -> Value ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let input = run emitNumeric(&mut writer.*, function, target, layouts, operand, span)
  if !isFloating(input.scalar) { return run typedFormGap(function, span) }
  if operation == ScalarUnary.Sqrt {
    return Value {scalar: input.scalar, value: run SsaFunction.squareRoot(&mut writer.*.function, input.value)}
  }
  let raw = run castOf(&mut writer.*, Cast.Bitcast, &input, integerRepresentation(input.scalar.bits, false))
  let integer = raw.scalar
  let mut exponentMask: u64 = 9218868437227405312
  let mut fractionMask: u64 = 4503599627370495
  if input.scalar.bits == 32 {
    exponentMask = 2139095040
    fractionMask = 8388607
  }
  let bits = raw.value
  let boolean = booleanRepresentation()
  if operation == ScalarUnary.IsSignNegative {
    return Value {scalar: boolean, value: run compareWith(&mut writer.*, Predicate.Slt, integer, bits, 0)}
  }
  let exponentMaskValue = run intOf(&mut writer.*, integer, exponentMask)
  let fractionMaskValue = run intOf(&mut writer.*, integer, fractionMask)
  let exponent = run binaryOf(&mut writer.*, Binary.And, bits, exponentMaskValue)
  let fraction = run binaryOf(&mut writer.*, Binary.And, bits, fractionMaskValue)
  let exponentZero = run compareWith(&mut writer.*, Predicate.Eq, integer, exponent, 0)
  let exponentAll = run compareOf(&mut writer.*, Predicate.Eq, exponent, exponentMaskValue)
  let fractionZero = run compareWith(&mut writer.*, Predicate.Eq, integer, fraction, 0)
  let exponentSome = run notOf(&mut writer.*, boolean, exponentZero)
  let exponentFinite = run notOf(&mut writer.*, boolean, exponentAll)
  let fractionSome = run notOf(&mut writer.*, boolean, fractionZero)
  let flag = match operation {
    ScalarUnary.IsNaN => run binaryOf(&mut writer.*, Binary.And, exponentAll, fractionSome)
    ScalarUnary.IsInfinite => run binaryOf(&mut writer.*, Binary.And, exponentAll, fractionZero)
    ScalarUnary.IsFinite => exponentFinite
    ScalarUnary.IsNormal => run binaryOf(&mut writer.*, Binary.And, exponentSome, exponentFinite)
    ScalarUnary.IsSubnormal => run binaryOf(&mut writer.*, Binary.And, exponentZero, fractionSome)
    _ => run typedFormGap(function, span)
  }
  return Value {scalar: boolean, value: flag}
}

// The IEEE 754 totalOrder key: negative values reverse their magnitude order below positive ones.
effect fn totalOrderKey(writer: &mut Writer, bits: &Value) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let negative = run compareWith(&mut writer.*, Predicate.Slt, bits.scalar, bits.value, 0)
  let ones = run intOf(&mut writer.*, bits.scalar, u64.MAX)
  let sign = run intOf(&mut writer.*, bits.scalar, minimumBits(integerRepresentation(bits.scalar.bits, true)))
  let mask = run selectOf(&mut writer.*, negative, ones, sign)
  return run binaryOf(&mut writer.*, Binary.Xor, bits.value, mask)
}

effect fn emitScalarBinary(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  operation: ScalarBinary, left: &Operand, right: &Operand, span: Location) -> Value ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let lhs = run emitNumeric(&mut writer.*, function, target, layouts, left, span)
  let rhs = run emitNumeric(&mut writer.*, function, target, layouts, right, span)
  let kind = lhs.scalar
  if operation == ScalarBinary.TotalOrder {
    if !isFloating(kind) || !isFloating(rhs.scalar) || kind.bits != rhs.scalar.bits { return run typedFormGap(function, span) }
    let integer = integerRepresentation(kind.bits, true)
    let leftBits = run castOf(&mut writer.*, Cast.Bitcast, &lhs, integer)
    let rightBits = run castOf(&mut writer.*, Cast.Bitcast, &rhs, integer)
    let leftKey = run totalOrderKey(&mut writer.*, &leftBits)
    let rightKey = run totalOrderKey(&mut writer.*, &rightBits)
    return Value {scalar: booleanRepresentation(), value: run compareOf(&mut writer.*, Predicate.Ule, leftKey, rightKey)}
  }
  if !isIntegral(kind) || !isIntegral(rhs.scalar) || kind.bits != rhs.scalar.bits { return run typedFormGap(function, span) }
  let l = lhs.value
  let r = rhs.value
  if operation == ScalarBinary.ShiftLeft || operation == ScalarBinary.ShiftRight {
    let invalid = run compareWith(&mut writer.*, Predicate.Uge, kind, r, usize.toU64(kind.bits))
    let any = run anyLane(&mut writer.*, invalid, kind)
    run trapWhenEntered(&mut writer.*, any, b"invalid shift count")
    let mut opcode = Binary.Shl
    if operation == ScalarBinary.ShiftRight {
      opcode = Binary.LShr
      if kind.signed { opcode = Binary.AShr }
    }
    return Value {scalar: kind, value: run binaryOf(&mut writer.*, opcode, l, r)}
  }
  let boolean = booleanRepresentation()
  if operation == ScalarBinary.AddOverflows || operation == ScalarBinary.SubtractOverflows || operation == ScalarBinary.MultiplyOverflows {
    let mut stem: &[u8] = b"add"
    if operation == ScalarBinary.SubtractOverflows { stem = b"sub" }
    if operation == ScalarBinary.MultiplyOverflows { stem = b"mul" }
    let pair = run overflowPair(&mut writer.*, stem, kind, l, r)
    return Value {scalar: boolean, value: pair.overflow}
  }
  if operation == ScalarBinary.DivisionUndefined {
    let zero = run compareWith(&mut writer.*, Predicate.Eq, kind, r, 0)
    if !kind.signed { return Value {scalar: boolean, value: zero} }
    let lowest = run compareWith(&mut writer.*, Predicate.Eq, kind, l, minimumBits(kind))
    let negative = run compareWith(&mut writer.*, Predicate.Eq, kind, r, u64.MAX)
    let overflow = run binaryOf(&mut writer.*, Binary.And, lowest, negative)
    return Value {scalar: boolean, value: run binaryOf(&mut writer.*, Binary.Or, zero, overflow)}
  }
  if operation == ScalarBinary.WrappingAdd { return Value {scalar: kind, value: run binaryOf(&mut writer.*, Binary.Add, l, r)} }
  if operation == ScalarBinary.WrappingSubtract { return Value {scalar: kind, value: run binaryOf(&mut writer.*, Binary.Sub, l, r)} }
  if operation == ScalarBinary.WrappingMultiply { return Value {scalar: kind, value: run binaryOf(&mut writer.*, Binary.Mul, l, r)} }
  if operation == ScalarBinary.MultiplyHigh {
    // The upper half of the product at twice the width.
    let wide = integerRepresentation(kind.bits * 2, kind.signed)
    let mut extend = Cast.ZExt
    if kind.signed { extend = Cast.SExt }
    let leftWide = run castOf(&mut writer.*, extend, &lhs, wide)
    let rightWide = run castOf(&mut writer.*, extend, &rhs, wide)
    let product = run binaryOf(&mut writer.*, Binary.Mul, leftWide.value, rightWide.value)
    let width = run intOf(&mut writer.*, wide, usize.toU64(kind.bits))
    let high = Value {scalar: wide, value: run binaryOf(&mut writer.*, Binary.LShr, product, width)}
    return run castOf(&mut writer.*, Cast.Trunc, &high, kind)
  }
  if operation == ScalarBinary.RotateLeft || operation == ScalarBinary.RotateRight {
    return Value {scalar: kind, value: run SsaFunction.rotate(&mut writer.*.function, operation == ScalarBinary.RotateLeft, l, r)}
  }
  if operation == ScalarBinary.SaturatingAdd || operation == ScalarBinary.SaturatingSubtract {
    let mut saturated = Binary.Add
    if operation == ScalarBinary.SaturatingSubtract { saturated = Binary.Sub }
    return Value {scalar: kind, value: run SsaFunction.saturating(&mut writer.*.function, saturated, kind.signed, l, r)}
  }
  // A saturating product clamps an overflowing result toward the sign of the exact product.
  let pair = run overflowPair(&mut writer.*, b"mul", kind, l, r)
  let wrapped = pair.value
  let overflow = pair.overflow
  let maximum = run intOf(&mut writer.*, kind, maximumBits(kind))
  let mut bound = maximum
  if kind.signed {
    let minimum = run intOf(&mut writer.*, kind, minimumBits(kind))
    let signs = run binaryOf(&mut writer.*, Binary.Xor, l, r)
    let negative = run compareWith(&mut writer.*, Predicate.Slt, kind, signs, 0)
    bound = run selectOf(&mut writer.*, negative, minimum, maximum)
  }
  return Value {scalar: kind, value: run selectOf(&mut writer.*, overflow, bound, wrapped)}
}

// Address transport admits the exact semantic word or data-pointer category, not a storage alias.
enum AddressLane { Unsupported, Pointer, Word }

fn addressLane(ty: &Interned<Type>) -> AddressLane {
  return Interned<Type>.with<AddressLane>(ty, fn(value: &Type) -> AddressLane {
    return match &value.* {
      Type.Pointer {..} => AddressLane.Pointer
      Type.ForeignFunction {..} => AddressLane.Pointer
      Type.Primitive {name} => {
        if same(Bytes.asSlice(&name), b"usize") { return AddressLane.Word }
        return AddressLane.Unsupported
      }
      _ => AddressLane.Unsupported
    }
  })
}

effect fn emitAddressOperand(
  writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  operand: &Operand, expected: AddressLane, span: Location,
) -> Value ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  match &operand.* {
    Operand.Copy {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      if addressLane(&address.ty) == expected { return run loadAddress(&mut writer.*, &address) }
    }
    Operand.Move {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      if addressLane(&address.ty) == expected { return run loadAddress(&mut writer.*, &address) }
    }
    Operand.Integer {ty, negative, ..} => {
      if !negative && expected == AddressLane.Word && addressLane(&ty) == expected {
        return run emitOperand(&mut writer.*, function, target, layouts, operand)
      }
    }
    Operand.Null {ty} => {
      if expected == AddressLane.Pointer && addressLane(&ty) == expected {
        return run emitOperand(&mut writer.*, function, target, layouts, operand)
      }
    }
    _ => ()
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.relative(GapCode.TypedForm, &owner, span)
}

// The read-modify-write operation of a swap or fetch primitive under the element's signedness.
// Every wasm atomic access is sequentially consistent, which is at least each ordering asked for.
fn atomicReadModifyWrite(primitive: IntrinsicPrimitive, signed: bool) -> Modify {
  return match primitive {
    IntrinsicPrimitive.AtomicFetchAdd => Modify.Add
    IntrinsicPrimitive.AtomicFetchSubtract => Modify.Sub
    IntrinsicPrimitive.AtomicFetchBitAnd => Modify.And
    IntrinsicPrimitive.AtomicFetchBitOr => Modify.Or
    IntrinsicPrimitive.AtomicFetchBitXor => Modify.Xor
    IntrinsicPrimitive.AtomicFetchMinimum => {
      if signed { return Modify.SignedMinimum }
      return Modify.UnsignedMinimum
    }
    IntrinsicPrimitive.AtomicFetchMaximum => {
      if signed { return Modify.SignedMaximum }
      return Modify.UnsignedMaximum
    }
    _ => Modify.Exchange
  }
}


// One SIMD vector operation (SIMD-003) whose result is `ty`. A lane index is already in range.
effect fn emitVector(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  primitive: IntrinsicPrimitive,
  operands: &List<Operand>,
  ty: &Interned<Type>,
) -> Value ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let listed = List<Operand>.asSlice(operands)
  let mut values = List<Value>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    let lowered = run emitOperand(&mut writer.*, function, target, layouts, &listed[at])
    run List<Value>.append(&mut values, lowered)
    at = at + usize.ONE
  }
  let lowered = List<Value>.asSlice(&values)
  let kind = scalar(ty, target)
  // An architecture operation calls its catalog intrinsic on the operands as they are (SIMD-007).
  let arch = CheckedIntrinsic.archForResult(primitive, ty)
  if arch.arity != usize.ZERO { run WasmObject.unsupported(b"an architecture intrinsic", Bytes.asSlice(&writer.symbol)) }
  if primitive == IntrinsicPrimitive.SimdFromArray || primitive == IntrinsicPrimitive.SimdPointerLoad {
    return run arrayVector(&mut writer.*, lowered[usize.ZERO].value, kind)
  }
  if primitive == IntrinsicPrimitive.SimdShuffle {
    // A shuffle of the two operands, with one constant lane index per result lane.
    let mut lanes = List<u64>.make()
    let mut lane: usize = 2
    while lane < listed.length {
      let index = match &listed[lane] {
        Operand.Integer {decimal, negative, ..} => decimalBits(Bytes.asSlice(&decimal), negative)
        _ => { return run typedFormGap(function, Location.generated()) }
      }
      run List<u64>.append(&mut lanes, index)
      lane = lane + usize.ONE
    }
    return Value {scalar: kind, value: run SsaFunction.shuffle(&mut writer.*.function, lowered[usize.ZERO].value, lowered[usize.ONE].value,
      List<u64>.asSlice(&lanes))}
  }
  if primitive == IntrinsicPrimitive.SimdPointerStore {
    let stored = run arrayLanes(&mut writer.*, &lowered[usize.ONE])
    run storeOf(&mut writer.*, stored.value, lowered[usize.ZERO].value, laneBytes(lowered[usize.ONE].scalar))
    return Value {scalar: kind, value: none()}
  }
  if primitive == IntrinsicPrimitive.SimdSplat {
    return Value {scalar: kind, value: run SsaFunction.splat(&mut writer.*.function, lowered[usize.ZERO].value, kind.lanes)}
  }
  let first = lowered[usize.ZERO]
  let input = first.scalar
  if primitive == IntrinsicPrimitive.SimdMinimum || primitive == IntrinsicPrimitive.SimdMaximum ||
    primitive == IntrinsicPrimitive.SimdMulAdd {
    let mut result = none()
    if primitive == IntrinsicPrimitive.SimdMulAdd {
      result = run SsaFunction.fusedMultiplyAdd(&mut writer.*.function, lowered[usize.ZERO].value, lowered[usize.ONE].value, lowered[2].value)
    } else {
      result = run SsaFunction.extreme(&mut writer.*.function, lanewiseExtreme(primitive, kind), lowered[usize.ZERO].value, lowered[usize.ONE].value)
    }
    if primitive == IntrinsicPrimitive.SimdMulAdd || !kind.floating { return Value {scalar: kind, value: result} }
    return Value {scalar: kind, value: run canonicalNaN(&mut writer.*, result, kind)}
  }
  if primitive == IntrinsicPrimitive.SimdBitcast { return run castOf(&mut writer.*, Cast.Bitcast, &first, kind) }
  if primitive == IntrinsicPrimitive.SimdMaskFromBits {
    let bits = integerRepresentation(kind.lanes, false)
    if kind.lanes == 64 { return run castOf(&mut writer.*, Cast.Bitcast, &first, kind) }
    let narrowed = run castOf(&mut writer.*, Cast.Trunc, &first, bits)
    return run castOf(&mut writer.*, Cast.Bitcast, &narrowed, kind)
  }
  if primitive == IntrinsicPrimitive.SimdMaskAny { return Value {scalar: kind, value: run anyLane(&mut writer.*, first.value, input)} }
  if primitive == IntrinsicPrimitive.SimdMaskAll {
    return Value {scalar: kind, value: run wholeVector(&mut writer.*, first.value, input, InfixOperator.Equals)}
  }
  if primitive == IntrinsicPrimitive.SimdMaskToBits || primitive == IntrinsicPrimitive.SimdMaskCount ||
    primitive == IntrinsicPrimitive.SimdMaskFirstSet {
    let mut counted = run castOf(&mut writer.*, Cast.Bitcast, &first, integerRepresentation(input.lanes, false))
    if primitive != IntrinsicPrimitive.SimdMaskToBits {
      let mut which = Count.Ones
      if primitive == IntrinsicPrimitive.SimdMaskFirstSet { which = Count.TrailingZeros }
      counted = Value {scalar: counted.scalar, value: run SsaFunction.countBits(&mut writer.*.function, which, counted.value)}
    }
    return run resize(&mut writer.*, &counted, kind)
  }
  if primitive == IntrinsicPrimitive.SimdReduceAdd && !input.floating {
    // The exact sum of N lanes fits in twice the lane width, so only the final range can fail.
    let mut wide = input
    wide.bits = input.bits * 2
    let widened = run resize(&mut writer.*, &first, wide)
    let mut sum = wide
    sum.lanes = usize.ZERO
    let total = Value {scalar: sum, value: run SsaFunction.reduce(&mut writer.*.function, Reduction.Add, widened.value, none())}
    run integerRangeGuard(&mut writer.*, &total, kind)
    return run castOf(&mut writer.*, Cast.Trunc, &total, kind)
  }
  if let Option<Reduction>.Some {value: reduction} = move reductionName(primitive, input) {
    // An ordered float sum starts from lane 0 at negative zero, which leaves every sum unchanged,
    // including a zero one. An unordered one is summed in order too.
    let started = primitive == IntrinsicPrimitive.SimdReduceAdd || primitive == IntrinsicPrimitive.SimdReduceAddUnordered
    let mut start = none()
    if started { start = run floatOf(&mut writer.*, kind, 0x8000000000000000) }
    let result = run SsaFunction.reduce(&mut writer.*.function, reduction, first.value, start)
    if !kind.floating || started { return Value {scalar: kind, value: result} }
    return Value {scalar: kind, value: run canonicalNaN(&mut writer.*, result, kind)}
  }
  if primitive == IntrinsicPrimitive.SimdExtract {
    return Value {scalar: kind, value: run SsaFunction.extractElement(&mut writer.*.function, first.value, lowered[usize.ONE].value)}
  }
  if primitive == IntrinsicPrimitive.SimdInsert {
    return Value {scalar: kind, value: run SsaFunction.insertElement(&mut writer.*.function, first.value, lowered[2].value,
      lowered[usize.ONE].value)}
  }
  if primitive == IntrinsicPrimitive.SimdSelect {
    return Value {scalar: kind, value: run selectOf(&mut writer.*, first.value, lowered[usize.ONE].value, lowered[2].value)}
  }
  // A lane comparison: an ordered float predicate, except that `!=` holds for a NaN lane.
  return Value {scalar: kind, value: run compareOf(&mut writer.*, lanePredicate(primitive, input), first.value, lowered[usize.ONE].value)}
}

// The lane-wise minimum or maximum of `kind`. A float minimum orders negative zero below positive
// zero, as `f32.min` does.
fn lanewiseExtreme(primitive: IntrinsicPrimitive, kind: Representation) -> Extreme {
  let minimum = primitive == IntrinsicPrimitive.SimdMinimum
  if kind.floating {
    if minimum { return Extreme.FloatMinimum }
    return Extreme.FloatMaximum
  }
  if kind.signed {
    if minimum { return Extreme.SignedMinimum }
    return Extreme.SignedMaximum
  }
  if minimum { return Extreme.UnsignedMinimum }
  return Extreme.UnsignedMaximum
}

// The reduction over `input`'s lanes; none for any other primitive.
fn reductionName(primitive: IntrinsicPrimitive, input: Representation) -> Option<Reduction> {
  let name = match primitive {
    IntrinsicPrimitive.SimdReduceAdd => Reduction.FloatAdd
    IntrinsicPrimitive.SimdReduceAddUnordered => Reduction.FloatAdd
    IntrinsicPrimitive.SimdReduceWrappingAdd => Reduction.Add
    IntrinsicPrimitive.SimdReduceBitAnd => Reduction.And
    IntrinsicPrimitive.SimdReduceBitOr => Reduction.Or
    IntrinsicPrimitive.SimdReduceBitXor => Reduction.Xor
    IntrinsicPrimitive.SimdReduceMinimum => {
      if input.floating { return Option<Reduction>.some(Reduction.FloatMinimum) }
      if input.signed { return Option<Reduction>.some(Reduction.SignedMinimum) }
      return Option<Reduction>.some(Reduction.UnsignedMinimum)
    }
    IntrinsicPrimitive.SimdReduceMaximum => {
      if input.floating { return Option<Reduction>.some(Reduction.FloatMaximum) }
      if input.signed { return Option<Reduction>.some(Reduction.SignedMaximum) }
      return Option<Reduction>.some(Reduction.UnsignedMaximum)
    }
    _ => { return Option<Reduction>.none() }
  }
  return Option<Reduction>.some(name)
}

// Each NaN lane of `value` replaced by the canonical quiet NaN, so results do not depend on the
// target's NaN payloads.
effect fn canonicalNaN(writer: &mut Writer, value: u64, kind: Representation) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let unordered = run compareOf(&mut writer.*, Predicate.Uno, value, value)
  let quiet = run floatOf(&mut writer.*, kind, 0x7FF8000000000000)
  return run selectOf(&mut writer.*, unordered, quiet, value)
}

// `value` widened or narrowed to `output`'s integer width; a signed input widens by sign.
effect fn resize(writer: &mut Writer, value: &Value, output: Representation) -> Value ! Unsupported | OutOfMemoryError ? &mut Allocator {
  if value.scalar.bits == output.bits { return Value {scalar: output, value: value.value} }
  if value.scalar.bits > output.bits { return run castOf(&mut writer.*, Cast.Trunc, value, output) }
  if value.scalar.signed { return run castOf(&mut writer.*, Cast.SExt, value, output) }
  return run castOf(&mut writer.*, Cast.ZExt, value, output)
}

// The byte alignment of one lane of `kind` in an array; a mask lane is one `bool` byte.
fn laneBytes(kind: Representation) -> usize {
  if kind.bits < 8 { return usize.ONE }
  return kind.bits / 8
}

// The predicate of a lane comparison over `kind`'s lanes.
fn lanePredicate(primitive: IntrinsicPrimitive, kind: Representation) -> Predicate {
  if kind.floating {
    if primitive == IntrinsicPrimitive.SimdLanesEqual { return Predicate.Oeq }
    if primitive == IntrinsicPrimitive.SimdLanesNotEqual { return Predicate.Une }
    if primitive == IntrinsicPrimitive.SimdLanesLess { return Predicate.Olt }
    if primitive == IntrinsicPrimitive.SimdLanesLessOrEqual { return Predicate.Ole }
    if primitive == IntrinsicPrimitive.SimdLanesGreater { return Predicate.Ogt }
    return Predicate.Oge
  }
  if primitive == IntrinsicPrimitive.SimdLanesEqual { return Predicate.Eq }
  if primitive == IntrinsicPrimitive.SimdLanesNotEqual { return Predicate.Ne }
  if kind.signed {
    if primitive == IntrinsicPrimitive.SimdLanesLess { return Predicate.Slt }
    if primitive == IntrinsicPrimitive.SimdLanesLessOrEqual { return Predicate.Sle }
    if primitive == IntrinsicPrimitive.SimdLanesGreater { return Predicate.Sgt }
    return Predicate.Sge
  }
  if primitive == IntrinsicPrimitive.SimdLanesLess { return Predicate.Ult }
  if primitive == IntrinsicPrimitive.SimdLanesLessOrEqual { return Predicate.Ule }
  if primitive == IntrinsicPrimitive.SimdLanesGreater { return Predicate.Ugt }
  return Predicate.Uge
}

// The vector `kind` read from the array at `address`. A mask lane is a `bool` byte holding 0 or
// 1, so it narrows to its bit.
effect fn arrayVector(writer: &mut Writer, address: u64, kind: Representation) -> Value ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut stored = kind
  if kind.bits == usize.ONE { stored.bits = 8 }
  let loaded = Value {scalar: stored, value: run loadOf(&mut writer.*, stored, address, laneBytes(kind))}
  if kind.bits != usize.ONE { return Value {scalar: kind, value: loaded.value} }
  return run castOf(&mut writer.*, Cast.Trunc, &loaded, kind)
}

// The lanes of `value` as an array store writes them; a mask lane widens to its `bool` byte.
effect fn arrayLanes(writer: &mut Writer, value: &Value) -> Value ! Unsupported | OutOfMemoryError ? &mut Allocator {
  if value.scalar.bits != usize.ONE { return value.* }
  let mut bytes = value.scalar
  bytes.bits = 8
  return run castOf(&mut writer.*, Cast.ZExt, value, bytes)
}

// One atomic instruction at the element's natural alignment (ATOMIC-002 through ATOMIC-004). A
// compare-exchange always stores the observed value through its expected pointer: on success it
// equals the value already there.
effect fn emitAtomic(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  primitive: IntrinsicPrimitive,
  operands: &List<Operand>,
  success: MemoryOrder,
  failure: MemoryOrder,
  element: &Interned<Type>,
) -> Value ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let unit = Value {scalar: Representation {aggregate: false, size: usize.ZERO, bits: usize.ZERO, signed: false, unit: true,
    pointer: false, floating: false, lanes: usize.ZERO, unionAlignment: usize.ZERO, head: usize.ZERO}, value: none()}
  if primitive == IntrinsicPrimitive.AtomicFence {
    run SsaFunction.fence(&mut writer.*.function)
    return unit
  }
  let listed = List<Operand>.asSlice(operands)
  let mut values = List<Value>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    let lowered = run emitOperand(&mut writer.*, function, target, layouts, &listed[at])
    run List<Value>.append(&mut values, lowered)
    at = at + usize.ONE
  }
  let lowered = List<Value>.asSlice(&values)
  let kind = scalar(element, target)
  let pointer = lowered[usize.ZERO].value
  if primitive == IntrinsicPrimitive.AtomicLoad {
    let ty = run typeOf(&mut writer.*, kind)
    return Value {scalar: kind, value: run SsaFunction.atomicLoad(&mut writer.*.function, ty, pointer)}
  }
  if primitive == IntrinsicPrimitive.AtomicStore {
    run SsaFunction.atomicStore(&mut writer.*.function, lowered[usize.ONE].value, pointer)
    return unit
  }
  if primitive == IntrinsicPrimitive.AtomicCompareExchange || primitive == IntrinsicPrimitive.AtomicCompareExchangeWeak {
    let expected = lowered[usize.ONE].value
    let current = run loadOf(&mut writer.*, kind, expected, kind.bits / 8)
    let pair = run SsaFunction.compareExchange(&mut writer.*.function, pointer, current, lowered[2].value)
    run storeOf(&mut writer.*, pair.value, expected, kind.bits / 8)
    return Value {scalar: booleanRepresentation(), value: pair.overflow}
  }
  return Value {scalar: kind, value: run SsaFunction.atomicModify(&mut writer.*.function, atomicReadModifyWrite(primitive, kind.signed), pointer,
    lowered[usize.ONE].value)}
}

fn isSpace(byte: u8) -> bool { return byte == 32 || byte == 9 }

// The wasm global an inline assembly line names: `__stack_pointer`, or `__tls_base` in a module
// whose memory threads share; `usize.MAX` for any other.
fn assemblyGlobal(writer: &Writer, name: &[u8]) -> usize {
  if same(name, b"__stack_pointer") { return usize.ZERO }
  if writer.shared && same(name, b"__tls_base") { return usize.ONE }
  return usize.MAX
}

// An inline assembly fragment, line by line: `local.get $N` takes operand `N`, `global.get` and
// `global.set` read and write a global the link defines. A fragment leaves nothing behind, since
// it has no result.
effect fn emitAssembly(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts, fragment: &AssemblyFragment)
-> Value ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let operands = List<Operand>.asSlice(&fragment.inputs)
  let mut arguments = List<u64>.make()
  let mut at = usize.ZERO
  while at < operands.length {
    let lowered = run emitOperand(&mut writer.*, function, target, layouts, &operands[at])
    run List<u64>.append(&mut arguments, lowered.value)
    at = at + usize.ONE
  }
  let result = scalar(&fragment.ty, target)
  if !result.unit { run WasmObject.unsupported(b"inline assembly with a result", Bytes.asSlice(&writer.symbol)) }
  let mut stack = List<u64>.make()
  let bytes = Bytes.asSlice(&fragment.template)
  let mut start = usize.ZERO
  while start < bytes.length {
    let mut end = start
    while end < bytes.length && bytes[end] != 10 { end = end + usize.ONE }
    let mut from = start
    while from < end && isSpace(bytes[from]) { from = from + usize.ONE }
    let mut split = from
    while split < end && !isSpace(bytes[split]) { split = split + usize.ONE }
    let mut argument = split
    while argument < end && isSpace(bytes[argument]) { argument = argument + usize.ONE }
    let mut until = end
    while until > argument && isSpace(bytes[until - usize.ONE]) { until = until - usize.ONE }
    let mnemonic = Slice.view<u8>(bytes, from, split - from)
    let named = Slice.view<u8>(bytes, argument, until - argument)
    let mut done = mnemonic.length == usize.ZERO
    if same(mnemonic, b"local.get") && named.length > usize.ONE && named[0] == 36 {
      let mut index = usize.ZERO
      let mut digit = usize.ONE
      while digit < named.length {
        index = index * 10 + u8.toUsize(named[digit] - 48)
        digit = digit + usize.ONE
      }
      if index < List<u64>.length(&arguments) {
        run List<u64>.append(&mut stack, List<u64>.get(&arguments, index))
        done = true
      }
    } else if same(mnemonic, b"global.get") || same(mnemonic, b"global.set") {
      let global = assemblyGlobal(&writer.*, named)
      if global != usize.MAX {
        if same(mnemonic, b"global.get") {
          let pointer = run pointerType(&mut writer.*)
          run List<u64>.append(&mut stack, run SsaFunction.globalGet(&mut writer.*.function, global, pointer))
          done = true
        } else if let Option<u64>.Some {value} = List<u64>.pop(&mut stack) {
          run SsaFunction.globalSet(&mut writer.*.function, global, value)
          done = true
        }
      }
    }
    if !done {
      let mut what = run Bytes.copy(b"the inline assembly `")
      run Bytes.append(&mut what, Slice.view<u8>(bytes, from, until - from))
      run Bytes.append(&mut what, b"`")
      run WasmObject.unsupported(Bytes.asSlice(&what), Bytes.asSlice(&writer.symbol))
    }
    start = end + usize.ONE
  }
  if List<u64>.length(&stack) != usize.ZERO { run WasmObject.unsupported(b"inline assembly that leaves a value", Bytes.asSlice(&writer.symbol)) }
  return Value {scalar: result, value: none()}
}

effect fn emitScalarRvalue(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  rvalue: &Rvalue,
  span: Location,
) -> Value ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  return match & rvalue.* {
    Rvalue.SliceLength {place} => {
      let descriptor = run emitPlace(&mut writer.*, function, target, layouts, &place)
      let facts = run sliceFact(layouts, &descriptor.ty, function, span)
      let address = run wordOffset(&mut writer.*, descriptor.value, facts.lengthOffset)
      let kind = lengthRepresentation(target)
      return Value {scalar: kind, value: run loadOf(&mut writer.*, kind, address, offsetAlignment(descriptor.alignment, facts.lengthOffset))}
    }
    Rvalue.SliceData {place} => {
      let descriptor = run emitPlace(&mut writer.*, function, target, layouts, &place)
      return Value {scalar: pointerRepresentation(target), value: run loadPointer(&mut writer.*, descriptor.value, descriptor.alignment)}
    }
    Rvalue.PointerOffset {pointer, index, element} => {
      let base = run emitOperand(&mut writer.*, function, target, layouts, &pointer)
      let selected = run emitOperand(&mut writer.*, function, target, layouts, &index)
      let facts = run layoutOf(layouts, &element, function, span)
      let stride = match move Metrics.stride(&facts) {
        Option<usize>.Some {value} => value
        Option<usize>.None => {
          let owner = InstanceKey.identity(&function.key)
          fail Gap.relative(GapCode.ScalarLayout, &owner, span)
        }
      }
      return Value {scalar: pointerRepresentation(target), value: run stridedOffset(&mut writer.*, base.value, &selected, stride)}
    }
    Rvalue.Slice {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.TypedForm, &owner, span)
    }
    Rvalue.ContextOf {place} => Value {scalar: pointerRepresentation(target), value: companionAddress(&writer.*, function, place.local)}
    Rvalue.ContextHandle {address} => {
      let base = run emitOperand(&mut writer.*, function, target, layouts, &address)
      let slot = run byteOffset(&mut writer.*, base.value, companionHandleOffset(target))
      let kind = lengthRepresentation(target)
      return Value {scalar: kind, value: run loadOf(&mut writer.*, kind, slot, usize.ZERO)}
    }
    // Stored by its statement, which retains the exact instance identity.
    Rvalue.FunctionAddress {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.TypedForm, &owner, span)
    }
    // Loaded by its statement, which retains the classified C object.
    Rvalue.ForeignStatic {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.TypedForm, &owner, span)
    }
    Rvalue.FrameAddress => Value {scalar: pointerRepresentation(target), value: run SsaFunction.frameAddress(&mut writer.*.function)}
    // The word is a hidden zero-initialized object named after the instance's own symbol, so it
    // is defined exactly where the instance is, once per program.
    Rvalue.ProcessWord => {
      let mut name = run Bytes.copy(Bytes.asSlice(&writer.symbol))
      run Bytes.append(&mut name, b".word")
      run defineObject(&mut writer.*, Bytes.asSlice(&name), 8, run Bytes.zeroed(8), List<ObjectPointer>.make(), false, false)
      return Value {scalar: pointerRepresentation(target), value: run addressOf(&mut writer.*, Bytes.asSlice(&name))}
    }
    Rvalue.Wasm {primitive, operands} => run emitWasm(&mut writer.*, function, target, layouts, primitive, &operands, span)
    // A dynamic stack allocation, which the function's return releases. The byte count traps when
    // it does not fit the target word.
    Rvalue.StackAllocate {count, element} => {
      let selected = run emitOperand(&mut writer.*, function, target, layouts, &count)
      let facts = run layoutOf(layouts, &element, function, span)
      let stride = match move Metrics.stride(&facts) {
        Option<usize>.Some {value} => value
        Option<usize>.None => {
          let owner = InstanceKey.identity(&function.key)
          fail Gap.relative(GapCode.ScalarLayout, &owner, span)
        }
      }
      let kind = lengthRepresentation(target)
      let strideValue = run intOf(&mut writer.*, kind, usize.toU64(stride))
      let pair = run overflowPair(&mut writer.*, b"mul", kind, selected.value, strideValue)
      let overflow = pair.overflow
      run trapWhen(&mut writer.*, overflow, b"arithmetic overflow")
      let bytes = pair.value
      return Value {scalar: pointerRepresentation(target),
        value: run SsaFunction.dynamicSlot(&mut writer.*.function, bytes, usize.toU64(facts.alignment))}
    }
    // A frame-based instance's step reads its transfer record's package word.
    // An ordinary emission of such an instance, which only selects the suspendable set, has no
    // transfer record and reads through null.
    Rvalue.RunningPackage => {
      let mut transfer = writer.transfer
      if transfer == none() { transfer = run nullOf(&mut writer.*) }
      return Value {scalar: pointerRepresentation(target),
        value: run loadWordAt(&mut writer.*, transfer, Coroutine.transferPackage(wordSize(target)))}
    }
    // A wasm target's admitted fragments are lines of wasm text: `local.get $N` takes operand
    // `N`, and `global.get` or `global.set` names a global the link defines.
    Rvalue.Assembly {fragment} => run emitAssembly(&mut writer.*, function, target, layouts, &Box<AssemblyFragment>.get(&fragment)[0])
    Rvalue.Atomic {primitive, operands, success, failure, element} =>
      run emitAtomic(&mut writer.*, function, target, layouts, primitive, &operands, success, failure, &element)
    Rvalue.Vector {primitive, operands, ty} => run emitVector(&mut writer.*, function, target, layouts, primitive, &operands, &ty)
    Rvalue.Ref {place, ..} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      return Value {scalar: pointerRepresentation(target), value: address.value}
    }
    Rvalue.AddressOf {place, ..} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      return Value {scalar: pointerRepresentation(target), value: address.value}
    }
    Rvalue.Aggregate {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.TypedForm, &owner, span)
    }
    Rvalue.Inject {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.TypedForm, &owner, span)
    }
    Rvalue.Fill {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.TypedForm, &owner, span)
    }
    Rvalue.Variant {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.TypedForm, &owner, span)
    }
    Rvalue.Discriminant {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      let kind = tagRepresentation(run taggedFact(layouts, &address.ty))
      return Value {scalar: kind, value: run loadOf(&mut writer.*, kind, address.value, address.alignment)}
    }
    Rvalue.Use {value} => run emitOperand(&mut writer.*, function, target, layouts, &value)
    Rvalue.Convert {value, ty} => run emitConvert(&mut writer.*, function, target, layouts, &value, &ty, span)
    Rvalue.Fits {value, ty} => run emitFits(&mut writer.*, function, target, layouts, &value, &ty, span)
    Rvalue.ScalarUnary {operation, value} => run emitScalarUnary(&mut writer.*, function, target, layouts, operation, &value, span)
    Rvalue.ScalarBinary {operation, left, right} => run emitScalarBinary(&mut writer.*, function, target, layouts, operation, &left, &right, span)
    Rvalue.AddressIntegerConversion {operand, destinationType} => {
      let lane = addressLane(&destinationType)
      // A wasm32 address is an exact 32-bit offset into linear memory, so the conversion is the
      // same as on native targets; only nonzero data address spaces stay refused.
      if lane == AddressLane.Unsupported || Target.dataAddressSpace(target) != 0 {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.relative(GapCode.TypedForm, &owner, span)
      }
      let mut expected = AddressLane.Pointer
      if lane == AddressLane.Pointer { expected = AddressLane.Word }
      let input = run emitAddressOperand(&mut writer.*, function, target, layouts, &operand, expected, span)
      let output = scalar(&destinationType, target)
      let bits = u32.toUsize(Target.pointerBits(target))
      if input.scalar.bits != bits || output.bits != bits {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.relative(GapCode.TypedForm, &owner, span)
      }
      if lane == AddressLane.Word { return run castOf(&mut writer.*, Cast.PtrToInt, &input, output) }
      return run castOf(&mut writer.*, Cast.IntToPtr, &input, output)
    }
    Rvalue.Bitcast {value, ty} => {
      let input = run emitOperand(&mut writer.*, function, target, layouts, &value)
      let output = scalar(&ty, target)
      if input.scalar.bits != output.bits || input.scalar.floating == output.floating || input.scalar.pointer || output.pointer || input.scalar.unit || output.unit {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.relative(GapCode.TypedForm, &owner, span)
      }
      return run castOf(&mut writer.*, Cast.Bitcast, &input, output)
    }
    Rvalue.Unary {operation, value} => {
      let input = run emitOperand(&mut writer.*, function, target, layouts, &value)
      if input.scalar.floating && operation == PrefixOperator.Negate {
        return Value {scalar: input.scalar, value: run SsaFunction.negate(&mut writer.*.function, input.value)}
      }
      if input.scalar.floating || input.scalar.pointer {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.relative(GapCode.TypedForm, &owner, span)
      }
      if operation == PrefixOperator.Negate {
        let zero = Value {scalar: input.scalar, value: run intOf(&mut writer.*, input.scalar, 0)}
        return run checkedBinary(&mut writer.*, b"sub", &zero, &input)
      }
      return Value {scalar: input.scalar, value: run notOf(&mut writer.*, input.scalar, input.value)}
    }
    Rvalue.Binary {operation, left, right} => {
      let lhs = run emitOperand(&mut writer.*, function, target, layouts, &left)
      let rhs = run emitOperand(&mut writer.*, function, target, layouts, &right)
      if lhs.scalar.floating {
        if let Option<Binary>.Some {value: arithmetic} = move floatOpcode(operation) {
          return Value {scalar: lhs.scalar, value: run binaryOf(&mut writer.*, arithmetic, lhs.value, rhs.value)}
        }
        let predicate = match move floatPredicate(operation) {
          Option<Predicate>.Some {value} => value
          Option<Predicate>.None => {
            let owner = InstanceKey.identity(&function.key)
            fail Gap.relative(GapCode.TypedForm, &owner, span)
          }
        }
        let compared = run compareOf(&mut writer.*, predicate, lhs.value, rhs.value)
        return Value {scalar: booleanRepresentation(), value: run wholeVector(&mut writer.*, compared, lhs.scalar, operation)}
      }
      if lhs.scalar.pointer {
        // Addresses compare only for identity, such as a null observer or cause (N4).
        if operation != InfixOperator.Equals && operation != InfixOperator.NotEquals {
          let owner = InstanceKey.identity(&function.key)
          fail Gap.relative(GapCode.TypedForm, &owner, span)
        }
        let mut identity = Predicate.Eq
        if operation == InfixOperator.NotEquals { identity = Predicate.Ne }
        return Value {scalar: booleanRepresentation(), value: run compareOf(&mut writer.*, identity, lhs.value, rhs.value)}
      }
      match operation {
        InfixOperator.Add => {
          return run checkedBinary(&mut writer.*, b"add", &lhs, &rhs)
        }
        InfixOperator.Subtract => {
          return run checkedBinary(&mut writer.*, b"sub", &lhs, &rhs)
        }
        InfixOperator.Multiply => {
          return run checkedBinary(&mut writer.*, b"mul", &lhs, &rhs)
        }
        InfixOperator.Divide => {
          return run guardedDivision(&mut writer.*, function, &lhs, &rhs, false, span)
        }
        InfixOperator.Remainder => {
          return run guardedDivision(&mut writer.*, function, &lhs, &rhs, true, span)
        }
        _ => {}
      }
      if let Option<Predicate>.Some {value: predicate} = move integerPredicate(operation, lhs.scalar.signed) {
        let compared = run compareOf(&mut writer.*, predicate, lhs.value, rhs.value)
        return Value {scalar: booleanRepresentation(), value: run wholeVector(&mut writer.*, compared, lhs.scalar, operation)}
      }
      let opcode = match move bitwiseOpcode(operation) {
        Option<Binary>.Some {value} => value
        Option<Binary>.None => {
          let owner = InstanceKey.identity(&function.key)
          fail Gap.relative(GapCode.TypedForm, &owner, span)
        }
      }
      return Value {scalar: lhs.scalar, value: run binaryOf(&mut writer.*, opcode, lhs.value, rhs.value)}
    }
  }
}

effect fn storeValue(writer: &mut Writer, address: &Address, value: &Value) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run storeCopy(&mut writer.*, address, value, false)
}

// `distinct` says the value's bytes never overlap the address; a wasm copy allows overlap anyway.
effect fn storeCopy(writer: &mut Writer, address: &Address, value: &Value, distinct: bool) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  if address.representation.unit { return () }
  // Source and destination may overlap, as when a member is injected into a slot of its own place.
  if address.representation.aggregate {
    if address.representation.unionAlignment != usize.ZERO && address.representation.size == 16 {
      return run storePackedUnion(&mut writer.*, address, value)
    }
    let head = address.representation.head
    if head >= 2 && head <= 8 && address.representation.size >= 16 && address.alignment >= head {
      return run storeSplitHead(&mut writer.*, address, value, head, distinct)
    }
    return run copyCall(&mut writer.*, address.value, address.alignment, value.value, address.representation.size, distinct)
  }
  return run storeOf(&mut writer.*, value.value, address.value, address.alignment)
}

// A 16-byte union (a tag and a word, like an optional word or an interpreter's value cell) copies
// as one i128 instead of an `llvm.memmove`. LLVM turns a whole-size copy of at most a word into an
// integer copy itself, but leaves a 16-byte one as bytes, so SROA keeps the padding after the tag
// as its own slice and every copy through a stack slot reloads and stores it. One i128, not two
// words: LLVM merges a copy's two adjacent word loads and stores into one 16-byte vector move,
// while a value built in registers still stores as two words, so the next whole-value load of
// that slot (an interpreter popping what it just pushed) stalls on store forwarding. The load
// precedes the store, so overlapping places stay correct, and both places hold the union, so
// both have its alignment.
effect fn storePackedUnion(writer: &mut Writer, address: &Address, value: &Value) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut alignment = address.representation.unionAlignment
  if address.alignment < alignment { alignment = address.alignment }
  // The two words copy as an unoptimized LLVM build copies them, both loads before both stores.
  return run storeWordPair(&mut writer.*, address, value, alignment)
}

// A union wider than 16 bytes, or a record of at least 16, copies its head (a tag word, or a
// leading flag with the padding after it) as an integer and the rest with one copy. A whole-size
// copy leaves SROA a byte range whose first slice runs from the padding after the head into the
// next field, so the copy through a stack slot becomes moves at odd offsets that overlap the
// head's store, and every later load of the payload stalls waiting on store forwarding. The head
// loads before the rest is copied and stores after it, so overlapping places stay correct.
effect fn storeSplitHead(writer: &mut Writer, address: &Address, value: &Value, head: usize, distinct: bool) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let word = integerRepresentation(head * 8, false)
  let rest = offsetAlignment(address.alignment, head)
  let tag = run loadOf(&mut writer.*, word, value.value, head)
  let source = run byteOffset(&mut writer.*, value.value, head)
  let destination = run byteOffset(&mut writer.*, address.value, head)
  run copyCall(&mut writer.*, destination, rest, source, address.representation.size - head, distinct)
  return run storeOf(&mut writer.*, tag, address.value, head)
}

effect fn storeWordPair(writer: &mut Writer, address: &Address, value: &Value, alignment: usize) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let high = offsetAlignment(alignment, 8)
  let word = integerRepresentation(64, false)
  let source = run byteOffset(&mut writer.*, value.value, 8)
  let first = run loadOf(&mut writer.*, word, value.value, alignment)
  let second = run loadOf(&mut writer.*, word, source, high)
  let destination = run byteOffset(&mut writer.*, address.value, 8)
  run storeOf(&mut writer.*, first, address.value, alignment)
  return run storeOf(&mut writer.*, second, destination, high)
}

fn sameDeclaration(left: &Interned<DeclarationId>, right: &Interned<DeclarationId>) -> bool {
  let firstAddress = Interned<DeclarationId>.with<usize>(
    left,
    fn(id: &DeclarationId) -> usize {
      return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(id))
    },
  )
  let secondAddress = Interned<DeclarationId>.with<usize>(
    right,
    fn(id: &DeclarationId) -> usize {
      return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(id))
    },
  )
  if firstAddress == secondAddress {
    return true
  }
  return Interned<DeclarationId>.with<bool>(
    left,
    fn(id: &DeclarationId) -> bool {
      return sameDeclarationRight(id, right)
    },
  )
}

// Whether `operand` reads a place whose storage never overlaps `destination`'s: another local's own
// slot, reached without a dereference on either side. An index may follow a borrowed sequence's
// data address, so it counts as one. Only an ordinary body's locals each own a slot; a step's
// frame states share storage.
fn separate(destination: &Place, operand: &Operand, ordinary: bool) -> bool {
  if !ordinary { return false }
  return match &operand.* {
    Operand.Copy {place} => separatePlaces(destination, &place)
    Operand.Move {place} => separatePlaces(destination, &place)
    _ => false
  }
}

fn separatePlaces(destination: &Place, source: &Place) -> bool {
  return source.local != destination.local && !dereferences(source) && !dereferences(destination)
}

fn dereferences(place: &Place) -> bool {
  let projections = List<Projection>.asSlice(&place.projections)
  let mut at = usize.ZERO
  while at < projections.length {
    let followed = match &projections[at] {
      Projection.Deref => true
      Projection.Index {..} => true
      _ => false
    }
    if followed { return true }
    at = at + usize.ONE
  }
  return false
}

// Stores the tag `tag` of a union at `address`, as an integer that also covers the padding up
// to the payload, which is always zero (every target is little-endian, so the tag stays in the
// low bytes). A union copies whole, padding included, so padding a built value leaves unwritten
// is read from the place's previous value: in a loop that builds a value in the same stack slot
// every iteration, SROA carries the old padding around the loop as a live value.
effect fn storeTag(writer: &mut Writer, facts: TaggedFacts, tag: usize, address: &Address) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut kind = tagRepresentation(facts)
  if facts.payloadOffset > facts.tagSize { kind.bits = facts.payloadOffset * 8 }
  let value = run intOf(&mut writer.*, kind, usize.toU64(tag))
  return run storeOf(&mut writer.*, value, address.value, address.alignment)
}

// Stores a narrow integer member of a union, such as a one-byte error enum, as a wider integer that
// also covers the padding after it, up to a word and within `room` bytes, as storeTag does for the
// tag. A union copies whole, so SROA splits its slots at every store boundary: a one-byte store at
// the payload makes every copy of a word-sized payload one byte plus an unaligned rest, and loads
// that straddle two earlier word stores miss store forwarding. Returns false when it stores nothing.
effect fn storeWidened(writer: &mut Writer, slot: &Address, value: &Value, room: usize) -> bool
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let kind = value.scalar
  if kind.aggregate || kind.pointer || kind.unit || kind.floating || kind.lanes != usize.ZERO { return false }
  let mut width: usize = 8
  while width > room || width > slot.alignment { width = width / 2 }
  if width * 8 <= kind.bits { return false }
  let wide = integerRepresentation(width * 8, false)
  let extended = run castOf(&mut writer.*, Cast.ZExt, value, wide)
  run storeOf(&mut writer.*, extended.value, slot.value, slot.alignment)
  return true
}

effect fn emitAssign(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  destination: &Place,
  value: &Rvalue,
  span: Location,
  ordinary: bool,
) -> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let address = run emitPlace(&mut writer.*, function, target, layouts, destination)
  if let Rvalue.Aggregate {fields} = &value.* {
    run clearPadding(&mut writer.*, layouts, &address)
    let operands = List<AggregateField>.asSlice(&fields)
    let mut fieldAt = usize.ZERO
    while fieldAt < operands.length {
      let selectedField = run projectField(&mut writer.*, function, target, layouts,
        &address, operands[fieldAt].index, span)
      let operand = run emitOperand(&mut writer.*, function, target, layouts, &operands[fieldAt].value)
      run storeCopy(&mut writer.*, &selectedField, &operand, separate(destination, &operands[fieldAt].value, ordinary))
      fieldAt = fieldAt + usize.ONE
    }
    return ()
  }
  if let Rvalue.Fill {byte} = &value.* {
    let facts = run layoutOf(layouts, &address.ty, function, span)
    run fillCall(&mut writer.*, address.value, address.alignment, byte, facts.size)
    return ()
  }
  if let Rvalue.Inject {tag, value: member} = &value.* {
    // The tag is stored first; the member is stored at the layout's payload offset.
    let facts = run taggedFact(layouts, &address.ty)
    run storeTag(&mut writer.*, facts, tag, &address)
    let operand = run emitOperand(&mut writer.*, function, target, layouts, &member)
    let payload = run byteOffset(&mut writer.*, address.value, facts.payloadOffset)
    let slot = Address {ty: Interned<Type>.clone(&address.ty), value: payload,
      alignment: offsetAlignment(address.alignment, facts.payloadOffset), representation: operand.scalar}
    let whole = run layoutOf(layouts, &address.ty, function, span)
    let room = whole.size - facts.payloadOffset
    if run storeWidened(&mut writer.*, &slot, &operand, room) { return () }
    run storeCopy(&mut writer.*, &slot, &operand, separate(destination, &member, ordinary))
    return ()
  }
  if let Rvalue.Variant {tag, fields} = &value.* {
    // The tag is stored first; each operand is stored at its variant field offset.
    let facts = run taggedFact(layouts, &address.ty)
    run storeTag(&mut writer.*, facts, tag, &address)
    let operands = List<AggregateField>.asSlice(&fields)
    let mut fieldAt = usize.ZERO
    while fieldAt < operands.length {
      let selected = run variantFieldFact(layouts, &address.ty, tag, operands[fieldAt].index)
      let operand = run emitOperand(&mut writer.*, function, target, layouts, &operands[fieldAt].value)
      let fieldAddress = run byteOffset(&mut writer.*, address.value, selected.offset)
      let slot = Address {ty: move selected.ty, value: fieldAddress,
        alignment: offsetAlignment(address.alignment, selected.offset), representation: operand.scalar}
      let mut widened = false
      // A variant's only field is followed by padding up to the end of the union.
      if operands.length == usize.ONE {
        let whole = run layoutOf(layouts, &address.ty, function, span)
        let room = whole.size - selected.offset
        widened = run storeWidened(&mut writer.*, &slot, &operand, room)
      }
      if !widened {
        run storeCopy(&mut writer.*, &slot, &operand, separate(destination, &operands[fieldAt].value, ordinary))
      }
      fieldAt = fieldAt + usize.ONE
    }
    return ()
  }
  if let Rvalue.Slice {data, count} = &value.* {
    let facts = run sliceFact(layouts, &address.ty, function, span)
    let input = run emitOperand(&mut writer.*, function, target, layouts, &data)
    let length = run emitOperand(&mut writer.*, function, target, layouts, &count)
    let kind = length.scalar
    if !input.scalar.pointer || kind.aggregate || kind.pointer || kind.floating || kind.unit
      || kind.signed || kind.bits != lengthRepresentation(target).bits {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.relative(GapCode.SliceLayout, &owner, span)
    }
    run storeOf(&mut writer.*, input.value, address.value, address.alignment)
    let lengthAddress = run wordOffset(&mut writer.*, address.value, facts.lengthOffset)
    run storeOf(&mut writer.*, length.value, lengthAddress, offsetAlignment(address.alignment, facts.lengthOffset))
    return ()
  }
  // A vector's lanes are stored as the array's elements; a mask lane is one `bool` byte.
  let toArray = match &value.* {
    Rvalue.Vector {primitive, ..} => primitive == IntrinsicPrimitive.SimdToArray
    _ => false
  }
  if toArray {
    if let Rvalue.Vector {operands, ..} = &value.* {
      let listed = List<Operand>.asSlice(&operands)
      let input = run emitOperand(&mut writer.*, function, target, layouts, &listed[usize.ZERO])
      let stored = run arrayLanes(&mut writer.*, &input)
      return run storeOf(&mut writer.*, stored.value, address.value, laneBytes(input.scalar))
    }
  }
  let selected = run emitScalarRvalue(&mut writer.*, function, target, layouts, value, span)
  let distinct = match &value.* {
    Rvalue.Use {value: used} => separate(destination, &used, ordinary)
    _ => false
  }
  run storeCopy(&mut writer.*, &address, &selected, distinct)
  return ()
}


// `ret i1 <failed>`: a fallible function's status (D3).
effect fn returnStatus(writer: &mut Writer, failed: bool) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let status = run boolOf(&mut writer.*, failed)
  return run returnValue(&mut writer.*, status)
}

// Zeroes the padding between and after a record's fields before the fields are stored, as the LLVM
// backend does, so both backends leave the same bytes in a record's padding.
effect fn clearPadding(writer: &mut Writer, layouts: &TypeLayouts, address: &Address) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let gaps = match move run TypeLayouts.padding(layouts, &address.ty) {
    Option<List<DataSpan>>.Some {value} => move value
    Option<List<DataSpan>>.None => { return () }
  }
  let listed = List<DataSpan>.asSlice(&gaps)
  if listed.length == usize.ZERO { return () }
  let mut at = usize.ZERO
  while at < listed.length {
    let gap = run byteOffset(&mut writer.*, address.value, listed[at].offset)
    run fillCall(&mut writer.*, gap, offsetAlignment(address.alignment, listed[at].offset), 0, listed[at].length)
    at = at + usize.ONE
  }
  return ()
}

effect fn emitReturn(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  span: Location,
) -> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let resultLayout = run layoutOf(layouts, &function.result, function, span)
  let kind = storageRepresentation(&function.result, target, resultLayout)
  if cExport(function) && kind.aggregate {
    let lane = run classifiedLane(function, target, layouts, &function.result, span, true)
    let slot = slotOf(&writer.*, usize.ZERO)
    if lane.passing == CPassing.Indirect {
      let out = writer.out
      run copyBytes(&mut writer.*, out, slot, lane.layout.size)
    }
    if lane.passing == CPassing.Coerce {
      let mut values = List<u64>.make()
      run readCRecord(&mut writer.*, &lane, slot, &mut values)
      return run returnValue(&mut writer.*, List<u64>.get(&values, usize.ZERO))
    }
    return run returnVoid(&mut writer.*)
  }
  let fallible = failureLocal(function) != usize.MAX
  if kind.unit {
    if fallible { return run returnStatus(&mut writer.*, false) }
    return run returnVoid(&mut writer.*)
  }
  let returned = Operand.Copy {
    place: Place {local: usize.ZERO, projections: List<Projection>.make()},
  }
  // The result local already lives in the caller's out-slot (`resultInOut`).
  if writer.out != none() && resultInOut(function, kind) {
    if fallible { return run returnStatus(&mut writer.*, false) }
    return run returnVoid(&mut writer.*)
  }
  let value = run emitOperand(&mut writer.*, function, target, layouts, &returned)
  // A fallible function returns its status and writes success to the caller's out-slot (D3).
  if fallible {
    let output = Address {ty: Interned<Type>.clone(&function.result), value: writer.out,
      alignment: resultLayout.alignment, representation: kind}
    run storeCopy(&mut writer.*, &output, &value, true)
    return run returnStatus(&mut writer.*, false)
  }
  if kind.aggregate || (!cExport(function) && passedIndirectly(kind)) {
    let output = Address {ty: Interned<Type>.clone(&function.result), value: writer.out,
      alignment: resultLayout.alignment, representation: kind}
    run storeCopy(&mut writer.*, &output, &value, true)
    return run returnVoid(&mut writer.*)
  }
  return run returnValue(&mut writer.*, value.value)
}

/// The words of a failure context companion: identity and label descriptors, then the observer
/// pool handle (failure observer note N3, N7).
fn companionWords() -> usize { return 5 }

// The byte offset of a companion's pool handle, after its two text descriptors.
fn companionHandleOffset(target: &Target) -> usize { return wordSize(target) * 4 }

// The address of failure slot `local`'s context companion: the caller's `%context` for the
// `Failure` local, else this function's own `%cN` (failure observer note N3).
fn companionAddress(writer: &Writer, function: &MirFunction, local: usize) -> u64 {
  if local == failureLocal(function) { return writer.context }
  return List<u64>.get(&writer.companions, local)
}

effect fn addLocal(listed: &mut List<usize>, local: usize, skipped: usize) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  if local == skipped { return () }
  let entries = List<usize>.asSlice(&listed.*)
  let mut at = usize.ZERO
  while at < entries.length {
    if entries[at] == local { return () }
    at = at + usize.ONE
  }
  return run List<usize>.append(&mut listed.*, local)
}

// The failure slots that own a companion: those a context statement, a selected cause or a
// call edge of a program that observes diagnostics names, except `Failure`.
effect fn companionLocals(function: &MirFunction) -> List<usize> ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let skipped = failureLocal(function)
  let mut listed = List<usize>.make()
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = List<Statement>.asSlice(&blocks[at].statements)
    let mut statementAt = usize.ZERO
    while statementAt < statements.length {
      match &statements[statementAt] {
        Statement.FailureContext {destination, source, ..} => {
          run addLocal(&mut listed, destination.local, skipped)
          if let Option<Place>.Some {value: from} = &source { run addLocal(&mut listed, from.local, skipped) }
        }
        Statement.Assign {value, ..} => {
          if let Rvalue.ContextOf {place} = &value { run addLocal(&mut listed, place.local, skipped) }
        }
        _ => {}
      }
      statementAt = statementAt + usize.ONE
    }
    if let Terminator.Call {failure, diagnostics, ..} = &blocks[at].terminator {
      if let Option<FailureEdge>.Some {value: edge} = &failure {
        if let Option<Diagnostics>.Some {..} = &diagnostics { run addLocal(&mut listed, edge.destination.local, skipped) }
      }
    }
    at = at + usize.ONE
  }
  return move listed
}

// Stores one string descriptor `{address, length}` at `offset` of a companion.
effect fn storeText(writer: &mut Writer, companion: u64, offset: usize, word: usize, address: u64, length: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let data = run byteOffset(&mut writer.*, companion, offset)
  run storeOf(&mut writer.*, address, data, usize.ZERO)
  let size = run byteOffset(&mut writer.*, companion, offset + word)
  return run storeOf(&mut writer.*, length, size, usize.ZERO)
}

// Writes a failure slot's companion `[identity, label, handle]` (failure observer note N3, N7): carried
// word by word from `source`'s, or originated from the function's context table, selecting a union's
// active member identity by its tag.
effect fn emitFailureContext(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  destination: &Place, source: &Option<Place>, origin: Origin) -> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = u32.toUsize(Target.pointerBits(target)) / 8
  let wordKind = integerRepresentation(word * 8, false)
  let into = companionAddress(&writer.*, function, destination.local)
  if let Option<Place>.Some {value: from} = &source.* {
    let carried = companionAddress(&writer.*, function, from.local)
    let mut part = usize.ZERO
    while part < companionWords() {
      let read = run byteOffset(&mut writer.*, carried, part * word)
      let written = run byteOffset(&mut writer.*, into, part * word)
      let value = run loadOf(&mut writer.*, wordKind, read, usize.ZERO)
      run storeOf(&mut writer.*, value, written, usize.ZERO)
      part = part + usize.ONE
    }
    return ()
  }
  let texts = List<ContextText>.asSlice(&function.contexts)
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < texts.length && found == usize.MAX {
    if texts[at].origin.node == origin.node && texts[at].origin.location.start == origin.location.start { found = at }
    at = at + usize.ONE
  }
  if found == usize.MAX {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.relative(GapCode.TypedForm, &owner, origin.location)
  }
  let identities = List<Bytes>.asSlice(&texts[found].identities)
  let mut address = run staticBytes(&mut writer.*, Bytes.asSlice(&identities[usize.ZERO]))
  let mut length = run intOf(&mut writer.*, wordKind, usize.toU64(Bytes.length(&identities[usize.ZERO])))
  if identities.length > usize.ONE {
    // The active member's tag selects its identity.
    let slot = run emitPlace(&mut writer.*, function, target, layouts, destination)
    let kind = tagRepresentation(run taggedFact(layouts, &slot.ty))
    let tag = run loadOf(&mut writer.*, kind, slot.value, usize.ZERO)
    let mut member = usize.ONE
    while member < identities.length {
      let candidate = run staticBytes(&mut writer.*, Bytes.asSlice(&identities[member]))
      let matched = run compareWith(&mut writer.*, Predicate.Eq, kind, tag, usize.toU64(member))
      address = run selectOf(&mut writer.*, matched, candidate, address)
      let measured = run intOf(&mut writer.*, wordKind, usize.toU64(Bytes.length(&identities[member])))
      length = run selectOf(&mut writer.*, matched, measured, length)
      member = member + usize.ONE
    }
  }
  run storeText(&mut writer.*, into, usize.ZERO, word, address, length)
  let label = run staticBytes(&mut writer.*, Bytes.asSlice(&texts[found].label))
  let labelLength = run intOf(&mut writer.*, wordKind, usize.toU64(Bytes.length(&texts[found].label)))
  return run storeText(&mut writer.*, into, word + word, word, label, labelLength)
}

// `Fail` writes the failure value to the caller's failure out-slot and returns status 1 (D3).
effect fn emitFail(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts, span: Location) -> ()
! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let local = failureLocal(function)
  if local == usize.MAX {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.relative(GapCode.TypedForm, &owner, span)
  }
  let locals = List<Local>.asSlice(&function.locals)
  let failureLayout = run layoutOf(layouts, &locals[local].ty, function, span)
  let kind = storageRepresentation(&locals[local].ty, target, failureLayout)
  if !kind.unit {
    let failed = Operand.Copy {place: Place {local: local, projections: List<Projection>.make()}}
    let value = run emitOperand(&mut writer.*, function, target, layouts, &failed)
    let output = Address {ty: Interned<Type>.clone(&locals[local].ty), value: writer.failure,
      alignment: failureLayout.alignment, representation: kind}
    run storeCopy(&mut writer.*, &output, &value, true)
  }
  return run returnStatus(&mut writer.*, true)
}

/// Returns the last foreign signature declared by `declaration`, or `usize.MAX` when none is.
fn foreignSignatureIndex(foreign: &[CAbi.Signature], declaration: &Interned<DeclarationId>) -> usize {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < foreign.length {
    if sameDeclaration(declaration, &foreign[at].declaration) {
      found = at
    }
    at = at + usize.ONE
  }
  return found
}

// Authenticate a tail's actual source before loading, then promote that one materialized value.
effect fn emitVariadicArgument(writer: &mut Writer, function: &MirFunction, target: &Target,
  layouts: &TypeLayouts, operand: &Operand, argument: &CAbi.VariadicArgument, span: Location) -> Value
! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut address = Option<Address>.none()
  if let Operand.Copy {place: source} = &operand.* {
    address = Option<Address>.some(run emitPlace(&mut writer.*, function, target, layouts, &source))
  }
  if let Operand.Move {place: source} = &operand.* {
    address = Option<Address>.some(run emitPlace(&mut writer.*, function, target, layouts, &source))
  }
  let mut input = Value {scalar: scalar(&argument.sourceType, target), value: none()}
  match move address {
    Option<Address>.Some {value: sourceAddress} => {
      if !(run CAbi.validVariadic(argument, &sourceAddress.ty)) { return CompilerBug.panic(b"a C variadic call passed check with a tail its C promotion does not cover") }
      input = run loadAddress(&mut writer.*, &sourceAddress)
    }
    Option<Address>.None => {
      // Constant tails are integer, floating or null-pointer literals of the tail's exact type.
      let constant = match &operand.* {
        Operand.Integer {ty: sourceType, ..} => run CAbi.validVariadic(argument, &sourceType)
        Operand.Float {ty: sourceType, ..} => run CAbi.validVariadic(argument, &sourceType)
        Operand.Null {ty: sourceType} => run CAbi.validVariadic(argument, &sourceType)
        _ => false
      }
      if !constant { return CompilerBug.panic(b"a C variadic call passed check with a tail its C promotion does not cover") }
      input = run emitOperand(&mut writer.*, function, target, layouts, operand)
    }
  }
  let source = scalar(&argument.sourceType, target)
  let promoted = scalar(&argument.promotedType, target)
  if input.scalar.aggregate || input.scalar.unit || input.scalar.lanes != usize.ZERO
    || input.scalar.pointer != source.pointer || input.scalar.floating != source.floating
    || input.scalar.bits != source.bits || input.scalar.signed != source.signed {
    return CompilerBug.panic(b"a C variadic call passed check with a tail its C promotion does not cover")
  }
  // Pointers and f64 pass unchanged; f32 widens to double.
  if source.pointer || source.floating {
    if source.floating && source.bits < promoted.bits { return run castOf(&mut writer.*, Cast.FPExt, &input, promoted) }
    return input
  }
  if source.bits < promoted.bits {
    if source.signed { return run castOf(&mut writer.*, Cast.SExt, &input, promoted) }
    return run castOf(&mut writer.*, Cast.ZExt, &input, promoted)
  }
  if source.bits != promoted.bits || source.signed != promoted.signed {
    return CompilerBug.panic(b"a C variadic call passed check with a tail its C promotion does not cover")
  }
  return input
}

// Whether a native indirect call is drop glue's call of an adopted allocation's reclaim function,
// which goes through `__silk_guarded_reclaim` rather than guarding the glue itself.
fn guardedReclaim(function: &MirFunction, callee: &Callee) -> bool {
  if let Option<Interned<Type>>.None = InstanceKey.glueType(&function.key) { return false }
  return match &callee.* {
    Callee.NativeIndirect {..} => true
    _ => false
  }
}

effect fn nativeSignature(function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  signature: &Interned<Type>, span: Location) -> CAbi.Signature
! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = InstanceKey.identity(&function.key)
  let copied = run Type.copy(signature)
  if let Type.Callable {parameters, result, ..} = move copied {
    let returned = run classifiedLane(function, target, layouts, &result, span, true)
    let lanes = run classifiedParameters(function, target, layouts, List<Interned<Type>>.asSlice(&parameters), &returned, span)
    return CAbi.Signature {importModule: Bytes.make(), importName: Bytes.make(),
      behavior: ForeignContract.conservative(), callbackContracts: Bytes.make(),
      declaration: Interned<DeclarationId>.clone(&owner), symbol: Bytes.make(),
      source: GapSource.Relative {declaration: move owner, location: span}, result: move returned,
      parameters: move lanes, global: false, variadic: false}
  }
  return CompilerBug.panic(b"a C call passed check with a lane its classified C signature does not pass")
}

effect fn cCopySlots(writer: &mut Writer, parameters: &[CAbi.Lane], block: usize) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < parameters.length {
    let lane = &parameters[at]
    if lane.passing == CPassing.Indirect {
      let mut alignment = lane.layout.alignment
      if lane.stackAlignment > alignment { alignment = lane.stackAlignment }
      let address = run allocaOf(&mut writer.*, lane.layout.size, alignment)
      run List<CallerCopy>.append(&mut writer.*.copies, CallerCopy {block: block, parameter: at, address: address})
    }
    at = at + usize.ONE
  }
  return ()
}

// The caller copy slot of indirect C argument `parameter` of block `block`'s call.
fn callerCopy(writer: &Writer, block: usize, parameter: usize) -> u64 {
  let copies = List<CallerCopy>.asSlice(&writer.copies)
  let mut at = usize.ZERO
  while at < copies.length {
    if copies[at].block == block && copies[at].parameter == parameter { return copies[at].address }
    at = at + usize.ONE
  }
  return none()
}

// Caller copies belong to the entry block, so a foreign call in a loop does not grow the stack.
effect fn emitCCopySlots(writer: &mut Writer, function: &MirFunction, target: &Target,
  layouts: &TypeLayouts, foreign: &[CAbi.Signature]) -> ()
! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    if let Terminator.Call {callee, origin, ..} = &blocks[at].terminator {
      if let Callee.Extern {declaration, ..} = &callee {
        let index = foreignSignatureIndex(foreign, &declaration)
        if index != usize.MAX { run cCopySlots(&mut writer.*, List<CAbi.Lane>.asSlice(&foreign[index].parameters), at) }
      }
      if let Callee.NativeIndirect {signature, ..} = &callee {
        let native = run nativeSignature(function, target, layouts, &signature, origin.location)
        run cCopySlots(&mut writer.*, List<CAbi.Lane>.asSlice(&native.parameters), at)
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// The sealed C allocator function `callee` names, if it names one.
fn sealedCall(callee: &Callee) -> Option<CFunction> {
  if let Callee.Extern {declaration, ..} = &callee.* {
    return Interned<DeclarationId>.with<Option<CFunction>>(&declaration, SealedCore.declarationFunction)
  }
  return Option<CFunction>.none()
}

effect fn emitCCall(writer: &mut Writer, function: &MirFunction, target: &Target,
  layouts: &TypeLayouts, signature: &CAbi.Signature, callee: &Callee, arguments: &List<Operand>,
  providers: &List<Operand>, diagnostics: &Option<Diagnostics>, destination: &Place,
  normal: usize, failure: &Option<FailureEdge>, span: Location, block: usize) -> ()
! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let parameters = List<CAbi.Lane>.asSlice(&signature.parameters)
  let values = List<Operand>.asSlice(arguments)
  if signature.global || values.length < parameters.length || (!signature.variadic && values.length != parameters.length)
    || (signature.variadic && parameters.length == usize.ZERO) {
    return CompilerBug.panic(b"a C variadic call passed check with a tail its C promotion does not cover")
  }
  if List<Operand>.length(providers) != usize.ZERO { return CompilerBug.panic(b"a C call was lowered with a Silk provider, diagnostics or failure edge") }
  if let Option<Diagnostics>.Some {..} = &diagnostics.* { return CompilerBug.panic(b"a C call was lowered with a Silk provider, diagnostics or failure edge") }
  if let Option<FailureEdge>.Some {..} = &failure.* { return CompilerBug.panic(b"a C call was lowered with a Silk provider, diagnostics or failure edge") }
  if let Callee.Extern {variadicArguments, ..} = &callee.* {
    if List<CAbi.VariadicArgument>.length(&variadicArguments) != values.length - parameters.length {
      return CompilerBug.panic(b"a C variadic call passed check with a tail its C promotion does not cover")
    }
  }
  let output = run emitPlace(&mut writer.*, function, target, layouts, destination)
  // Lanes compare by representation: a C-layout record's lifetimes, such as the invocation
  // lifetime an elided `BufferRef` parameter gets, are validity only (#2541).
  if !(run Type.runtimeEqualsShared(&output.ty, &signature.result.ty)) { return CompilerBug.panic(b"a C call passed check with a lane its classified C signature does not pass") }
  let mut address = none()
  if let Callee.NativeIndirect {address: operand, ..} = &callee.* {
    let loaded = run emitOperand(&mut writer.*, function, target, layouts, &operand)
    address = loaded.value
  }
  // Each lane's parts, in order.
  let mut prepared = List<u64>.make()
  let mut at = usize.ZERO
  while at < parameters.length {
    let lane = &parameters[at]
    if lane.layout.abi == Abi.Unit { return CompilerBug.panic(b"a `()` C parameter passed check") }
    if lane.passing == CPassing.Direct {
      let value = run emitArgument(&mut writer.*, function, target, layouts, &values[at], true)
      run List<u64>.append(&mut prepared, value.value)
    } else {
      let selected = match &values[at] {
        Operand.Copy {place} => run emitPlace(&mut writer.*, function, target, layouts, &place)
        Operand.Move {place} => run emitPlace(&mut writer.*, function, target, layouts, &place)
        _ => { return CompilerBug.panic(b"a C call passed check with a lane its classified C signature does not pass") }
      }
      if !(run Type.runtimeEqualsShared(&selected.ty, &lane.ty)) { return CompilerBug.panic(b"a C call passed check with a lane its classified C signature does not pass") }
      if lane.passing == CPassing.Indirect {
        let copy = callerCopy(&writer.*, block, at)
        run copyBytes(&mut writer.*, copy, selected.value, lane.layout.size)
        run List<u64>.append(&mut prepared, copy)
      } else if lane.passing == CPassing.Coerce {
        run readCRecord(&mut writer.*, lane, selected.value, &mut prepared)
      }
    }
    at = at + usize.ONE
  }
  let mut tails = List<Value>.make()
  if let Callee.Extern {variadicArguments, ..} = &callee.* {
    let promotions = List<CAbi.VariadicArgument>.asSlice(&variadicArguments)
    at = usize.ZERO
    while at < promotions.length {
      run List<Value>.append(&mut tails, run emitVariadicArgument(&mut writer.*, function, target, layouts,
        &values[parameters.length + at], &promotions[at], span))
      at = at + usize.ONE
    }
  }
  let returned = &signature.result
  let hasResult = returned.passing == CPassing.Coerce || (returned.passing == CPassing.Direct && returned.layout.abi != Abi.Unit)
  let resultKind = run cResultType(&mut writer.*, signature)
  let mut passed = List<u64>.make()
  if returned.passing == CPassing.Indirect { run List<u64>.append(&mut passed, output.value) }
  let inputs = List<u64>.asSlice(&prepared)
  at = usize.ZERO
  while at < inputs.length {
    run List<u64>.append(&mut passed, inputs[at])
    at = at + usize.ONE
  }
  let mut trailing = List<u64>.make()
  let tailValues = List<Value>.asSlice(&tails)
  at = usize.ZERO
  while at < tailValues.length {
    run List<u64>.append(&mut trailing, tailValues[at].value)
    at = at + usize.ONE
  }
  // A wasm target never unwinds, so no call needs a guard; an adopted allocation's reclaim call
  // still goes through `__silk_guarded_reclaim`, as on every target. A sealed C allocator function
  // is a plain call of the C library's function.
  let mut result = none()
  if guardedReclaim(function, callee) {
    if List<u64>.length(&passed) != usize.ONE || hasResult { return CompilerBug.panic(b"a C call passed check with a lane its classified C signature does not pass") }
    let helperArguments = [address, List<u64>.get(&passed, usize.ZERO)]
    drop run callNamed(&mut writer.*, b"__silk_guarded_reclaim", Kind.unit(), &helperArguments)
  } else if address != none() {
    result = run callAddress(&mut writer.*, address, List<u64>.asSlice(&passed), resultKind)
  } else if signature.variadic {
    result = run SsaFunction.callVariadic(&mut writer.*.function, Bytes.asSlice(&signature.symbol), List<u64>.asSlice(&passed),
      List<u64>.asSlice(&trailing), resultKind)
  } else {
    result = run callNamed(&mut writer.*, Bytes.asSlice(&signature.symbol), resultKind, List<u64>.asSlice(&passed))
  }
  if returned.passing == CPassing.Coerce {
    let results = [result]
    run writeCRecord(&mut writer.*, returned, &results, output.value)
  }
  else if hasResult { run storeValue(&mut writer.*, &output, &Value {scalar: output.representation, value: result}) }
  let next = blockAt(&writer.*, normal)
  return run branch(&mut writer.*, next)
}

effect fn emitCall(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  foreign: &[CAbi.Signature],
  identities: &[InstanceIdentity],
  callee: &Callee,
  arguments: &List<Operand>,
  providers: &List<Operand>,
  diagnostics: &Option<Diagnostics>,
  destination: &Place,
  normal: usize,
  failure: &Option<FailureEdge>,
  span: Location,
  block: usize,
) -> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Callee.NativeIndirect {signature, ..} = &callee.* {
    let native = run nativeSignature(function, target, layouts, &signature, span)
    return run emitCCall(&mut writer.*, function, target, layouts, &native, callee, arguments,
      providers, diagnostics, destination, normal, failure, span, block)
  }
  if let Callee.Extern {declaration, ..} = &callee.* {
    let index = foreignSignatureIndex(foreign, &declaration)
    if index == usize.MAX { return CompilerBug.panic(b"a C call was emitted without its classified C signature") }
    return run emitCCall(&mut writer.*, function, target, layouts, &foreign[index], callee, arguments,
      providers, diagnostics, destination, normal, failure, span, block)
  }
  return run emitCallInner(&mut writer.*, function, target, layouts, identities,
    callee, arguments, providers, diagnostics, destination, normal, failure, span)
}

// Appends one argument lane passing `value`.
effect fn appendLane(passed: &mut List<u64>, value: u64) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run List<u64>.append(&mut passed.*, value)
}

effect fn emitCallInner(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  identities: &[InstanceIdentity],
  callee: &Callee,
  arguments: &List<Operand>,
  providers: &List<Operand>,
  diagnostics: &Option<Diagnostics>,
  destination: &Place,
  normal: usize,
  failure: &Option<FailureEdge>,
  span: Location,
) -> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let output = run emitPlace(&mut writer.*, function, target, layouts, destination)
  let kind = output.representation
  // A fallible callee takes success and failure out-addresses after its arguments and returns a
  // status: 0 continues at `normal`, 1 at the failure edge (D3).
  let mut failed = Option<Address>.none()
  let mut context = none()
  let mut handler = usize.MAX
  if let Option<FailureEdge>.Some {value: edge} = &failure.* {
    failed = Option<Address>.some(run emitPlace(&mut writer.*, function, target, layouts, &edge.destination))
    // In a program that observes diagnostics the callee also writes the destination's companion (N3).
    if let Option<Diagnostics>.Some {..} = &diagnostics.* {
      context = companionAddress(&writer.*, function, edge.destination.local)
    }
    handler = edge.target
  }
  let mut indirect = none()
  if let Callee.Indirect {address} = &callee.* {
    let loaded = run emitOperand(&mut writer.*, function, target, layouts, &address)
    indirect = loaded.value
  }
  let fallible = handler != usize.MAX
  // Provider addresses follow the written arguments (D2).
  let mut addresses = List<u64>.make()
  let hidden = List<Operand>.asSlice(providers)
  let mut providerAt = usize.ZERO
  while providerAt < hidden.length {
    let provided = run emitOperand(&mut writer.*, function, target, layouts, &hidden[providerAt])
    run List<u64>.append(&mut addresses, provided.value)
    providerAt = providerAt + usize.ONE
  }
  // An observed callee then takes the observer and selected-cause addresses (N1, N2).
  if let Option<Diagnostics>.Some {value: observed} = &diagnostics.* {
    run appendDiagnostics(&mut writer.*, function, target, layouts, &observed, &mut addresses)
  }
  let values = List<Operand>.asSlice(arguments)
  let mut evaluated = List<Value>.make()
  // Where each argument's lanes start in `evaluated`, and then its end.
  let mut starts = List<usize>.make()
  let mut index = usize.ZERO
  while index < values.length {
    run List<usize>.append(&mut starts, List<Value>.length(&evaluated))
    let mut lanes = List<Value>.make()
    run appendArgument(&mut writer.*, function, target, layouts, &values[index], false, &mut lanes)
    let passed = List<Value>.asSlice(&lanes)
    let mut lane = usize.ZERO
    while lane < passed.length {
      if !passed[lane].scalar.unit { run List<Value>.append(&mut evaluated, passed[lane]) }
      lane = lane + usize.ONE
    }
    index = index + usize.ONE
  }
  // A wide vector result is written through the caller's address like an aggregate (SIMD-009).
  let outward = kind.aggregate || passedIndirectly(kind)
  let mut resultType = run voidType(&mut writer.*)
  if fallible {
    resultType = run integerType(&mut writer.*, usize.ONE)
  } else if !outward {
    resultType = run typeOf(&mut writer.*, kind)
  }
  run List<usize>.append(&mut starts, List<Value>.length(&evaluated))
  let mut passed = List<u64>.make()
  let prepared = List<Value>.asSlice(&evaluated)
  let bounds = List<usize>.asSlice(&starts)
  let addressed = List<u64>.asSlice(&addresses)
  let facts = Callable {parameters: values.length, providers: hidden.length, observed: hidden.length < addressed.length,
    fallible: fallible}
  let shape = run LoweringPlan.ordinaryShape(facts, outward)
  let order = List<Lane>.asSlice(&shape.lanes)
  let mut step = usize.ZERO
  while step < order.length {
    match order[step] {
      Lane.Parameter {index: argument} => {
        index = bounds[argument]
        while index < bounds[argument + usize.ONE] {
          run List<u64>.append(&mut passed, prepared[index].value)
          index = index + usize.ONE
        }
      }
      Lane.Provider {index: provider} => { run appendLane(&mut passed, addressed[provider]) }
      Lane.Observer => { run appendLane(&mut passed, addressed[hidden.length]) }
      Lane.Cause => { run appendLane(&mut passed, addressed[hidden.length + usize.ONE]) }
      Lane.Site => { run appendLane(&mut passed, addressed[hidden.length + 2]) }
      Lane.Result => { run appendLane(&mut passed, output.value) }
      Lane.Failure => {
        if let Option<Address>.Some {value: failureSlot} = &failed { run appendLane(&mut passed, failureSlot.value) }
      }
      Lane.Context => {
        if context != none() { run appendLane(&mut passed, context) }
      }
      Lane.Transfer => {}
    }
    step = step + usize.ONE
  }
  let mut returned = none()
  if let Callee.Instance {key} = &callee.* {
    let symbol = run InstanceIdentity.name(identities, &key)
    returned = run callNamed(&mut writer.*, Bytes.asSlice(&symbol), resultType, List<u64>.asSlice(&passed))
  } else {
    returned = run callAddress(&mut writer.*, indirect, List<u64>.asSlice(&passed), resultType)
  }
  if fallible {
    let onFailure = blockAt(&writer.*, handler)
    let onSuccess = blockAt(&writer.*, normal)
    return run branchIf(&mut writer.*, returned, onFailure, onSuccess)
  }
  if !kind.unit && !outward {
    run storeValue(&mut writer.*, &output, &Value {scalar: kind, value: returned})
  }
  let next = blockAt(&writer.*, normal)
  return run branch(&mut writer.*, next)
}

// Appends the current observer, selected cause and site addresses an observed callee takes.
effect fn appendDiagnostics(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  observed: &Diagnostics, addresses: &mut List<u64>) -> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let observer = run emitOperand(&mut writer.*, function, target, layouts, Diagnostics.observer(observed))
  run List<u64>.append(&mut addresses.*, observer.value)
  let cause = run emitOperand(&mut writer.*, function, target, layouts, Diagnostics.cause(observed))
  run List<u64>.append(&mut addresses.*, cause.value)
  let site = run emitOperand(&mut writer.*, function, target, layouts, Diagnostics.site(observed))
  return run List<u64>.append(&mut addresses.*, site.value)
}

// Copies the current value of one classified C object into its destination place.
effect fn emitForeignStaticRead(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  foreign: &[CAbi.Signature],
  destination: &Place,
  declaration: &Interned<DeclarationId>,
  address: bool,
  span: Location,
) -> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let index = foreignSignatureIndex(foreign, declaration)
  if index == usize.MAX || !foreign[index].global {
    return CompilerBug.panic(b"a C static passed check without a C object emission can read or define")
  }
  let output = run emitPlace(&mut writer.*, function, target, layouts, destination)
  let symbol = run addressOf(&mut writer.*, Bytes.asSlice(&foreign[index].symbol))
  if address {
    let pointer = Value {scalar: pointerRepresentation(target), value: symbol}
    return run storeValue(&mut writer.*, &output, &pointer)
  }
  let object = Address {
    ty: Interned<Type>.clone(&output.ty),
    value: symbol,
    alignment: foreign[index].result.layout.alignment,
    representation: output.representation,
  }
  let value = run loadAddress(&mut writer.*, &object)
  return run storeValue(&mut writer.*, &output, &value)
}

effect fn emitBlock(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  block: &Block,
  foreign: &[CAbi.Signature],
  identities: &[InstanceIdentity],
  suspended: &Option<Suspended>,
  index: usize,
) -> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let statements = List<Statement>.asSlice(&block.statements)
  let ordinary = match &suspended.* {
    Option<Suspended>.Some {..} => false
    Option<Suspended>.None => true
  }
  let mut at = usize.ZERO
  while at < statements.length {
    run locate(&mut writer.*, Mir.statementOrigin(&statements[at]))
    match & statements[at] {
      Statement.Assign {destination, value, origin} => {
        match &value {
          // A callback's address is its emitted symbol (failure observer note N1).
          Rvalue.FunctionAddress {key} => {
            let address = run emitPlace(&mut writer.*, function, target, layouts, &destination)
            let symbol = run InstanceIdentity.name(identities, &key)
            let callback = run addressOf(&mut writer.*, Bytes.asSlice(&symbol))
            run storeOf(&mut writer.*, callback, address.value, usize.ZERO)
          }
          Rvalue.ForeignStatic {declaration, address} => {
            run emitForeignStaticRead(&mut writer.*, function, target, layouts, foreign, &destination, &declaration, address, origin.location)
          }
          _ => {
            let report = run trapReport(&writer.*, function, target, origin)
            writer.trap = move report
            run emitAssign(&mut writer.*, function, target, layouts, &destination, &value, origin.location, ordinary)
            writer.trap = Option<TrapReport>.none()
          }
        }
      }
      // A drop calls the glue of the place's type with the place's address (MIR core shape §3),
      // then the current observer and cause in a program that observes diagnostics.
      Statement.Drop {destination, glue, diagnostics, origin: _} => {
        let address = run emitPlace(&mut writer.*, function, target, layouts, &destination)
        let mut passed = List<u64>.make()
        run List<u64>.append(&mut passed, address.value)
        if let Option<Diagnostics>.Some {value: observed} = &diagnostics {
          run appendDiagnostics(&mut writer.*, function, target, layouts, &observed, &mut passed)
        }
        let symbol = run InstanceIdentity.name(identities, &glue)
        drop run callNamed(&mut writer.*, Bytes.asSlice(&symbol), Kind.unit(), List<u64>.asSlice(&passed))
      }
      Statement.FailureContext {destination, source, origin} => {
        run emitFailureContext(&mut writer.*, function, target, layouts, &destination, &source, origin)
      }
      Statement.SetContextHandle {address, value, ..} => {
        let base = run emitOperand(&mut writer.*, function, target, layouts, &address)
        let handle = run emitOperand(&mut writer.*, function, target, layouts, &value)
        let slot = run byteOffset(&mut writer.*, base.value, companionHandleOffset(target))
        run storeOf(&mut writer.*, handle.value, slot, usize.ZERO)
      }
    }
    at = at + usize.ONE
  }
  run locate(&mut writer.*, Mir.terminatorOrigin(&block.terminator))
  match & block.terminator {
    Terminator.Goto {target: next, origin: _} => {
      let handle = blockAt(&writer.*, next)
      run branch(&mut writer.*, handle)
    }
    Terminator.Branch {condition, thenBlock, elseBlock, origin: _} => {
      let tested = run emitOperand(&mut writer.*, function, target, layouts, &condition)
      let onTrue = blockAt(&writer.*, thenBlock)
      let onFalse = blockAt(&writer.*, elseBlock)
      run branchIf(&mut writer.*, tested.value, onTrue, onFalse)
    }
    Terminator.Return {origin} => match &suspended.* {
      Option<Suspended>.Some {value: stepping} => run emitStepReturn(&mut writer.*, function, target, layouts, &stepping, origin.location)
      Option<Suspended>.None => run emitReturn(&mut writer.*, function, target, layouts, origin.location)
    }
    Terminator.Call {callee, arguments, providers, diagnostics, destination, normal, failure, origin} => {
      let mut state = usize.MAX
      if let Option<Suspended>.Some {value: stepping} = &suspended.* {
        state = Coroutine.stateAfter(&stepping.coroutine, index)
      }
      if state != usize.MAX {
        if let Option<Suspended>.Some {value: stepping} = &suspended.* {
          let mut transfers = false
          if let Callee.Instance {key} = &callee { transfers = run Facts.transfers(&stepping.facts, &key) }
          run emitSuspendingCall(&mut writer.*, function, target, layouts, identities, &stepping, state, transfers,
            &callee, &arguments, &providers, &diagnostics, &destination, normal, &failure, origin.location)
        }
      } else {
        run emitCall(
          &mut writer.*,
          function,
          target,
          layouts,
          foreign,
          identities,
          &callee,
          &arguments,
          &providers,
          &diagnostics,
          &destination,
          normal,
          &failure,
          origin.location,
          index,
        )
      }
    }
    Terminator.Fail {origin} => match &suspended.* {
      Option<Suspended>.Some {value: stepping} => run emitStepFail(&mut writer.*, function, target, layouts, &stepping, origin.location)
      Option<Suspended>.None => run emitFail(&mut writer.*, function, target, layouts, origin.location)
    }
    // An observed trap reports its reason at its site before trapping (event 6, TERM-008).
    Terminator.Trap {reason, origin} => {
      let report = run trapReport(&writer.*, function, target, origin)
      writer.trap = move report
      run reportTrap(&mut writer.*, Mir.trapReasonText(reason))
      writer.trap = Option<TrapReport>.none()
      run trapHere(&mut writer.*)
    }
    // The source's reason is a `string<'static>` descriptor in memory, which the fatal dispatch
    // helper reads as it reads a constant reason (event 6, TERM-008).
    Terminator.TrapText {reason, origin} => {
      let text = run emitOperand(&mut writer.*, function, target, layouts, &reason)
      if !text.scalar.aggregate {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.relative(GapCode.TypedForm, &owner, origin.location)
      }
      let report = run trapReport(&writer.*, function, target, origin)
      writer.trap = move report
      // A source trap is a violated precondition of the package's API, so it reports at the call
      // that entered the package (TERM-008), which its trap site's entry local holds.
      let mut entry = none()
      if let Option<TrapReport>.Some {value} = &writer.trap { entry = value.entry }
      run reportTrapDescriptor(&mut writer.*, text.value, entry)
      writer.trap = Option<TrapReport>.none()
      run trapHere(&mut writer.*)
    }
    // An instance that relinquishes is a suspension origin, so the build emits it again with its
    // frames; only the walk that selects the suspendable set emits it without them.
    Terminator.Relinquish {..} => match &suspended.* {
      Option<Suspended>.Some {value: stepping} => run emitRelinquish(&mut writer.*, target, &stepping, Coroutine.stateAfter(&stepping.coroutine, index))
      Option<Suspended>.None => run trapHere(&mut writer.*)
    }
    // A cancelled frame's exit releases it without writing a result; its caller cancels next.
    Terminator.Abandon {..} => match &suspended.* {
      Option<Suspended>.Some {value: stepping} => run emitPop(&mut writer.*, target, &stepping, Option<bool>.none())
      Option<Suspended>.None => run trapHere(&mut writer.*)
    }
    Terminator.Unreachable {..} => run trapHere(&mut writer.*)
    // A switch tests its cases in order, as an unoptimized LLVM build does.
    Terminator.Switch {value, cases, otherwise, origin: _} => {
      let tested = run emitOperand(&mut writer.*, function, target, layouts, &value)
      return run compareChain(&mut writer.*, &tested, List<SwitchCase>.asSlice(&cases), otherwise, index)
    }
  }
  return ()
}

// A switch as one compare and branch per case, in case order: block `b<block>`'s case `n` after
// the first is tested in its own block `b<block>.<n>`.
effect fn compareChain(writer: &mut Writer, tested: &Value, cases: &[SwitchCase], otherwise: usize, block: usize) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let fallback = blockAt(&writer.*, otherwise)
  if cases.length == usize.ZERO { return run branch(&mut writer.*, fallback) }
  // A flag is compared as a byte, as an unoptimized LLVM build compares it.
  let mut compared = tested.*
  let flag = compared.scalar.bits == usize.ONE && compared.scalar.lanes == usize.ZERO
  if flag {
    let mut byte = compared.scalar
    byte.bits = 8
    compared = run castOf(&mut writer.*, Cast.ZExt, tested, byte)
  }
  let mut next = usize.MAX
  let mut at = usize.ZERO
  while at < cases.length {
    if at > usize.ZERO { run startBlock(&mut writer.*, next) }
    // An `i1` case of -1 or 1 is the set flag.
    let mut bits = decimalBits(Bytes.asSlice(&cases[at].decimal), cases[at].negative)
    if flag && !same(Bytes.asSlice(&cases[at].decimal), b"0") { bits = 1 }
    let equal = run compareWith(&mut writer.*, Predicate.Eq, compared.scalar, compared.value, bits)
    let mut otherwiseBlock = fallback
    if at + usize.ONE < cases.length {
      next = run labelled(&mut writer.*, b"case")
      otherwiseBlock = next
    }
    let matched = blockAt(&writer.*, cases[at].target)
    run branchIf(&mut writer.*, equal, matched, otherwiseBlock)
    at = at + usize.ONE
  }
  return ()
}

/// Emits the entry-block stack slots for every local and spills each parameter into its slot.
effect fn emitEntrySlots(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  foreign: &[CAbi.Signature],
) -> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  run emitSlots(&mut writer.*, function, target, layouts, &Option<Suspended>.none())
  run emitCCopySlots(&mut writer.*, function, target, layouts, foreign)
  let locals = List<Local>.asSlice(&function.locals)
  let parameters = List<Interned<Type>>.asSlice(&function.parameters)
  let mut cParameters = List<CAbi.Lane>.make()
  if cExport(function) {
    let result = run classifiedLane(function, target, layouts, &function.result, locals[usize.ZERO].origin.location, true)
    cParameters = run classifiedParameters(function, target, layouts, parameters, &result, locals[usize.ZERO].origin.location)
  }
  let mut local = usize.ZERO
  while local < parameters.length {
    let parameterLayout = run layoutOf(layouts, &parameters[local], function,
      locals[local + usize.ONE].origin.location)
    let kind = storageRepresentation(&parameters[local], target, parameterLayout)
    let input = List<u64>.get(&writer.parameters, local)
    let slot = slotOf(&writer.*, local + usize.ONE)
    if cExport(function) {
      let classified = List<CAbi.Lane>.asSlice(&cParameters)
      let lane = &classified[local]
      if lane.passing == CPassing.Ignore { local = local + usize.ONE continue }
      if lane.passing == CPassing.Indirect {
        run copyBytes(&mut writer.*, slot, input, lane.layout.size)
        local = local + usize.ONE
        continue
      }
      // A coerced lane's pieces are consecutive parameters, whose values are consecutive too.
      if lane.passing == CPassing.Coerce {
        let parts = List<CPiece>.asSlice(&lane.pieces)
        let mut at = usize.ZERO
        while at < parts.length {
          run storeCPiece(&mut writer.*, lane, parts[at], input + usize.toU64(at), slot)
          at = at + usize.ONE
        }
        local = local + usize.ONE
        continue
      }
    }
    let span = locals[local + usize.ONE].origin.location
    if !cExport(function) {
      let split = run parameterLanes(layouts, &parameters[local], parameterLayout, target, function, span)
      if split.count != usize.ZERO {
        let inputs = [input, List<u64>.get(&writer.extras, local * 3), List<u64>.get(&writer.extras, local * 3 + 1),
          List<u64>.get(&writer.extras, local * 3 + 2)]
        run storeLanes(&mut writer.*, &split, slot, parameterLayout.alignment, &inputs)
        local = local + usize.ONE
        continue
      }
    }
    if let Option<usize>.Some {..} = ownedParameter(function, &locals[local + usize.ONE], parameterLayout, kind) {
      local = local + usize.ONE
      continue
    }
    let address = Address {ty: Interned<Type>.clone(&parameters[local]), value: slot,
      alignment: parameterLayout.alignment, representation: kind}
    run storeCopy(&mut writer.*, &address, &Value {scalar: kind, value: input}, true)
    local = local + usize.ONE
  }
  return run emitHiddenStores(&mut writer.*, function)
}

/// Emits one storage address per local: a stack slot, or for a suspended step the frame slot of a
/// frame-resident local. Then each failure slot's context companion.
effect fn emitSlots(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  suspended: &Option<Suspended>,
) -> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let locals = List<Local>.asSlice(&function.locals)
  let frame = writer.frame
  let mut local = usize.ZERO
  while local < locals.length {
    let mut resident = usize.MAX
    if let Option<Suspended>.Some {value: stepping} = &suspended.* {
      resident = Coroutine.residentAt(&stepping.coroutine, local)
    }
    let mut slot = none()
    let mut aligned = usize.MAX
    if resident != usize.MAX {
      slot = run byteOffset(&mut writer.*, frame, resident)
    } else {
      let localLayout = run layoutOf(
        layouts,
        &locals[local].ty,
        function,
        locals[local].origin.location,
      )
      aligned = localLayout.alignment
      let kind = storageRepresentation(&locals[local].ty, target, localLayout)
      let mut owned = usize.MAX
      let mut outward = false
      if let Option<Suspended>.None = &suspended.* {
        if let Option<usize>.Some {value: index} = ownedParameter(function, &locals[local], localLayout, kind) {
          let split = run parameterLanes(layouts, &locals[local].ty, localLayout, target, function, locals[local].origin.location)
          if split.count == usize.ZERO { owned = index }
        }
        outward = local == usize.ZERO && writer.out != none() && resultInOut(function, kind)
      }
      if owned != usize.MAX {
        // The caller's storage is the slot itself.
        slot = List<u64>.get(&writer.parameters, owned)
      } else if outward {
        // The result is built in the caller's out-slot.
        slot = writer.out
      } else {
        let mut size = localLayout.size
        if kind.unit || size == usize.ZERO { size = usize.ONE }
        slot = run allocaOf(&mut writer.*, size, localLayout.alignment)
      }
    }
    run List<u64>.append(&mut writer.*.slots, slot)
    run List<usize>.append(&mut writer.*.alignments, aligned)
    run List<u64>.append(&mut writer.*.companions, none())
    local = local + usize.ONE
  }
  // Every failure slot except `Failure` owns a fixed-size context companion; `Failure`'s is the
  // caller's `%context` (failure observer note N3). A step keeps every companion in its frame.
  let companions = run companionLocals(function)
  let owned = List<usize>.asSlice(&companions)
  let word = u32.toUsize(Target.pointerBits(target)) / 8
  let mut companionAt = usize.ZERO
  while companionAt < owned.length {
    let mut address = none()
    if let Option<Suspended>.Some {value: stepping} = &suspended.* {
      address = run byteOffset(&mut writer.*, frame, Coroutine.companionAt(&stepping.coroutine, owned[companionAt]))
    } else {
      address = run allocaOf(&mut writer.*, companionWords() * word, word)
    }
    List<u64>.set(&mut writer.*.companions, owned[companionAt], address)
    companionAt = companionAt + usize.ONE
  }
  return ()
}

/// Stores the hidden provider, observer and cause addresses into their locals.
effect fn emitHiddenStores(writer: &mut Writer, function: &MirFunction) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  // Each hidden provider address lands in its `Provider` local.
  let mut provider = usize.ZERO
  while providerLocalAt(function, provider) != usize.MAX {
    let slot = slotOf(&writer.*, providerLocalAt(function, provider))
    let address = List<u64>.get(&writer.providers, provider)
    run storeOf(&mut writer.*, address, slot, usize.ZERO)
    provider = provider + usize.ONE
  }
  return run emitDiagnosticStores(&mut writer.*, function)
}

/// Stores an observed function's observer, selected-cause and entry-site addresses into their locals
/// (N1, N2). A resumed frame stores them again: a trap reads them, which liveness does not see.
effect fn emitDiagnosticStores(writer: &mut Writer, function: &MirFunction) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let observer = diagnosticLocal(function, usize.ZERO)
  if observer != usize.MAX {
    let hidden = [writer.observer, writer.cause, writer.site]
    let slots = [slotOf(&writer.*, observer), slotOf(&writer.*, diagnosticLocal(function, usize.ONE)),
      slotOf(&writer.*, diagnosticLocal(function, 2))]
    let mut at = usize.ZERO
    while at < 3 {
      run storeOf(&mut writer.*, hidden[at], slots[at], usize.ZERO)
      at = at + usize.ONE
    }
  }
  return ()
}

// Starts the body of a definition, its location markers starting afresh.
effect fn beginFunction(writer: &mut Writer, symbol: &[u8]) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  writer.located = usize.ZERO
  return run beginBody(&mut writer.*, symbol)
}

// The kind of a C export's result lane: nothing for one returned indirectly, and one coerced piece.
effect fn cLaneResult(writer: &mut Writer, lane: &CAbi.Lane) -> Kind ! Unsupported | OutOfMemoryError ? &mut Allocator {
  if lane.passing == CPassing.Ignore || lane.passing == CPassing.Indirect || lane.layout.abi == Abi.Unit { return Kind.unit() }
  if lane.passing == CPassing.Coerce {
    let pieces = List<CPiece>.asSlice(&lane.pieces)
    if pieces.length != usize.ONE { run WasmObject.unsupported(b"a C result in several registers", Bytes.asSlice(&writer.symbol)) }
    return run typeOf(&mut writer.*, pieceRepresentation(pieces[usize.ZERO]))
  }
  return run cParameterType(&mut writer.*, lane, usize.ZERO)
}

/// Emits one definition as a fragment of wasm bodies and data objects.
///
/// A gap's span counts from the anchor of the instance's declaration, like the MIR origins it
/// comes from; the caller positions it in the current source. A construct the body builder cannot
/// express leaves a fragment that records the refusal instead (`WasmObject.Fragment.refused`).
///
/// A suspendable instance's `suspension` facts make its ordinary symbol a driver and add its
/// `$enter` and `$step` definitions (`backend.Coroutine`). `shared` says the memory is shared
/// between threads. Each function is lowered to SSA form (`SsaFunction`), whose variables are
/// promoted to values (`SsaPromotion`), then emitted as wasm (`WasmEmission`); an `optimized`
/// build also promotes the frame slots only loaded and stored. With `verify`, each
/// function's SSA form is checked after lowering and promotion (`SsaVerification`).
pub effect fn emit(
  function: &MirFunction,
  target: &Target,
  supplied: &[TypeLayout],
  foreign: &[CAbi.Signature],
  identities: &[InstanceIdentity],
  suspension: &Option<Facts>,
  shared: bool,
  hostExport: bool,
  optimized: bool,
  verify: bool,
) -> Bytes ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  match move run Effect.result(emitChecked(function, target, supplied, foreign, identities, suspension, shared, hostExport, optimized, verify)) {
    Result<Bytes, Gap | Unsupported | OutOfMemoryError>.Success {value} => { return move value }
    Result<Bytes, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported refused => { return run refusedFragment(move refused) }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// Lowers one definition. An `optimized` build promotes each function's frame slots that are only
// loaded and stored to SSA values, as LLVM's mem2reg and SROA would: an unoptimized lowering gives
// every MIR local a frame slot.
effect fn emitChecked(
  function: &MirFunction,
  target: &Target,
  supplied: &[TypeLayout],
  foreign: &[CAbi.Signature],
  identities: &[InstanceIdentity],
  suspension: &Option<Facts>,
  shared: bool,
  hostExport: bool,
  optimized: bool,
  verify: bool,
) -> Bytes ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  // The lookup index lives only while this instance's code is built.
  let indexed = run TypeLayouts.copyOf(supplied)
  let layouts = &indexed
  let mut writer = run writerFor(target, shared)
  writer.optimized = optimized
  writer.verify = verify
  run List<u64>.appendSlice(&mut writer.lines, List<u64>.asSlice(&function.lines))
  let locals = List<Local>.asSlice(&function.locals)
  let resultFacts = run layoutOf(layouts, &function.result, function, locals[usize.ZERO].origin.location)
  let result = storageRepresentation(&function.result, target, resultFacts)
  let parameters = List<Interned<Type>>.asSlice(&function.parameters)
  let fallible = failureLocal(function) != usize.MAX
  // A C export shim keeps its requested linkage name and the C lanes.
  let exported = match &function.key {
    InstanceKey.Export {..} => true
    _ => false
  }
  let symbol = run InstanceIdentity.name(identities, &function.key)
  writer.symbol = move symbol
  let mut cResult = Option<CAbi.Lane>.none()
  let mut cParameters = List<CAbi.Lane>.make()
  if exported {
    let returned = run classifiedLane(function, target, layouts, &function.result, locals[usize.ZERO].origin.location, true)
    cParameters = run classifiedParameters(function, target, layouts, parameters, &returned, locals[usize.ZERO].origin.location)
    cResult = Option<CAbi.Lane>.some(move returned)
  }
  let pointer = run pointerType(&mut writer)
  let mut resultType = Kind.unit()
  let mut outward = result.aggregate || passedIndirectly(result)
  if let Option<CAbi.Lane>.Some {value: returned} = &cResult {
    outward = returned.passing == CPassing.Indirect
    resultType = run cLaneResult(&mut writer, &returned)
  } else if fallible {
    resultType = Kind.flag()
  } else if !outward {
    resultType = run typeOf(&mut writer, result)
  }
  let base = run Bytes.copy(Bytes.asSlice(&writer.symbol))
  run beginFunction(&mut writer, Bytes.asSlice(&base))
  writer.function.setResult(resultType)
  let shape = run LoweringPlan.ordinaryShape(LoweringPlan.callable(function), outward)
  let order = List<Lane>.asSlice(&shape.lanes)
  let mut step = usize.ZERO
  while step < order.length {
    match order[step] {
      Lane.Result => { writer.out = run parameterOf(&mut writer, pointer) }
      Lane.Parameter {index: at} => {
        if exported {
          let classified = List<CAbi.Lane>.asSlice(&cParameters)
          let lane = &classified[at]
          let mut first = none()
          let mut part = usize.ZERO
          while part < cParameterCount(lane) {
            let ty = run cParameterType(&mut writer, lane, part)
            let added = run parameterOf(&mut writer, ty)
            if part == usize.ZERO { first = added }
            part = part + usize.ONE
          }
          run List<u64>.append(&mut writer.parameters, first)
          run List<u64>.appendRepeated(&mut writer.extras, none(), 3)
        } else {
          let facts = run layoutOf(layouts, &parameters[at], function, locals[at + usize.ONE].origin.location)
          let lane = storageRepresentation(&parameters[at], target, facts)
          if !lane.unit {
            let mut ty = pointer
            if facts.abi != Abi.Indirect && !passedIndirectly(lane) { ty = run typeOf(&mut writer, lane) }
            let span = locals[at + usize.ONE].origin.location
            let split = run parameterLanes(layouts, &parameters[at], facts, target, function, span)
            if split.count != usize.ZERO { ty = run typeOf(&mut writer, split.lanes[0]) }
            let added = run parameterOf(&mut writer, ty)
            run List<u64>.append(&mut writer.parameters, added)
            run addExtraLanes(&mut writer, &split)
          } else {
            run List<u64>.append(&mut writer.parameters, none())
            run List<u64>.appendRepeated(&mut writer.extras, none(), 3)
          }
        }
      }
      // Hidden provider addresses follow the written parameters (D2).
      Lane.Provider {..} => {
        let added = run parameterOf(&mut writer, pointer)
        run List<u64>.append(&mut writer.providers, added)
      }
      Lane.Observer => { writer.observer = run parameterOf(&mut writer, pointer) }
      Lane.Cause => { writer.cause = run parameterOf(&mut writer, pointer) }
      Lane.Site => { writer.site = run parameterOf(&mut writer, pointer) }
      Lane.Failure => { writer.failure = run parameterOf(&mut writer, pointer) }
      Lane.Context => { writer.context = run parameterOf(&mut writer, pointer) }
      Lane.Transfer => { writer.transfer = run parameterOf(&mut writer, pointer) }
    }
    step = step + usize.ONE
  }
  // A WebAssembly module exports exactly the C exports source names, under their symbols, except
  // the target support module's, which only the link resolves (`hostExport`). `main` is the other
  // exception: the link exports the entry itself.
  let mut exportName = Bytes.make()
  if exported && hostExport && !same(Bytes.asSlice(&writer.symbol), b"main") {
    exportName = run Bytes.copy(Bytes.asSlice(&writer.symbol))
  }
  if let Option<Facts>.Some {value: facts} = &suspension.* {
    let suspended = Option<Suspended>.some(
      Suspended {facts: run Facts.copy(&facts), coroutine: run planFrame(function, target, layouts, &facts)},
    )
    if let Option<Suspended>.Some {value: stepping} = &suspended {
      run emitDriver(&mut writer, function, target, layouts, &stepping, Bytes.asSlice(&base))
      run endBody(&mut writer, Bytes.asSlice(&exportName))
      resetFunction(&mut writer)
      run emitEnter(&mut writer, function, target, layouts, &stepping, Bytes.asSlice(&base))
      resetFunction(&mut writer)
      run emitStep(&mut writer, function, target, layouts, foreign, identities, &suspended, &stepping, Bytes.asSlice(&base))
    }
    run frameEntry(&mut writer, function, target, b"")
    return run writer.fragment.encode()
  }
  let ordinary = Option<Suspended>.none()
  let blocks = List<Block>.asSlice(&function.blocks)
  run addBlocks(&mut writer, blocks.length)
  noteDiagnosticLocals(&mut writer, function)
  let mut at = usize.ZERO
  while at < blocks.length {
    let handle = blockAt(&writer, at)
    run startBlock(&mut writer, handle)
    if at == usize.ZERO { run emitEntrySlots(&mut writer, function, target, layouts, foreign) }
    run emitBlock(&mut writer, function, target, layouts, &blocks[at], foreign, identities, &ordinary, at)
    at = at + usize.ONE
  }
  run endBody(&mut writer, Bytes.asSlice(&exportName))
  run frameEntry(&mut writer, function, target, b"")
  if exported && same(Bytes.asSlice(&writer.symbol), threadEntrySymbol()) {
    run defineThreadStart(&mut writer, Bytes.asSlice(&base))
  }
  return run writer.fragment.encode()
}

// The symbol of the wasm32 entry module's thread entry, which `wasi_thread_start` calls.
fn threadEntrySymbol() -> &'static [u8] {
  return b"silk_wasm_thread_entry_v1"
}

// wasi-threads' `wasi_thread_start(thread, handle)`, defined beside the entry module's thread entry.
// The host calls it on a new instance whose `__stack_pointer` still holds the main thread's initial
// value, so it keeps no frame: before any call it carves the thread's thread-local block from the
// top of the stack that the handle's first word holds, moves `__stack_pointer` below that block,
// and has the link's `__wasm_init_tls` fill the block, then calls the entry with the handle. The
// entry returns the word that marks the thread done, which this sets to 1 before waking the
// joiner. The joiner may release the stack once it sees the word, and nothing after the store
// touches the stack.
effect fn defineThreadStart(writer: &mut Writer, entry: &[u8]) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let pointer = run pointerType(&mut writer.*)
  let int32 = run integerType(&mut writer.*, 32)
  run beginFunction(&mut writer.*, b"wasi_thread_start")
  drop run parameterOf(&mut writer.*, int32)
  let handle = run parameterOf(&mut writer.*, pointer)
  let start = run labelled(&mut writer.*, b"entry")
  run startBlock(&mut writer.*, start)
  let top = run loadPointer(&mut writer.*, handle, 4)
  // The block: the thread-local size below the top, aligned down; the stack: below the block,
  // aligned to 16.
  let size = run SsaFunction.linkConstant(&mut writer.*.function, b"__tls_size")
  let align = run SsaFunction.linkConstant(&mut writer.*.function, b"__tls_align")
  let below = run binaryOf(&mut writer.*, Binary.Sub, top, size)
  let zero = run integerOf(&mut writer.*, 32, 0)
  let mask = run binaryOf(&mut writer.*, Binary.Sub, zero, align)
  let block = run binaryOf(&mut writer.*, Binary.And, below, mask)
  let sixteen = run integerOf(&mut writer.*, 32, 4294967280)
  let stack = run binaryOf(&mut writer.*, Binary.And, block, sixteen)
  run SsaFunction.globalSet(&mut writer.*.function, usize.ZERO, stack)
  let blockArguments = [block]
  drop run callNamed(&mut writer.*, b"__wasm_init_tls", Kind.unit(), &blockArguments)
  let entryArguments = [handle]
  let done = run callNamed(&mut writer.*, entry, pointer, &entryArguments)
  let one = run integerOf(&mut writer.*, 32, 1)
  run SsaFunction.atomicStore(&mut writer.*.function, one, done)
  let count = run integerOf(&mut writer.*, 32, 4294967295)
  drop run SsaFunction.atomicNotify(&mut writer.*.function, done, count)
  run returnVoid(&mut writer.*)
  return run endBody(&mut writer.*, b"wasi_thread_start")
}

// One WebAssembly memory instruction. The memory index is 0, the module's one linear memory.
// A size or growth is a `usize`, as wide as the memory's addresses: growth reports failure as -1,
// `usize.MAX`. A wait or notify answers a `u32`: a wait reports 0 when woken, 1 when the word
// differed and 2 on timeout.
effect fn emitWasm(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  primitive: IntrinsicPrimitive, operands: &List<Operand>, span: Location) -> Value
! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut representation = Representation {aggregate: false, size: usize.ZERO, bits: 32,
    signed: false, unit: false, pointer: false, floating: false, lanes: usize.ZERO, unionAlignment: usize.ZERO, head: usize.ZERO}
  let mut arguments = List<u64>.make()
  let listed = List<Operand>.asSlice(operands)
  let mut at = usize.ZERO
  while at < listed.length {
    let lowered = run emitOperand(&mut writer.*, function, target, layouts, &listed[at])
    run List<u64>.append(&mut arguments, lowered.value)
    at = at + usize.ONE
  }
  let values = List<u64>.asSlice(&arguments)
  if primitive == IntrinsicPrimitive.WasmMemorySize {
    representation = lengthRepresentation(target)
    return Value {scalar: representation, value: run SsaFunction.memorySize(&mut writer.*.function)}
  }
  if primitive == IntrinsicPrimitive.WasmMemoryGrow {
    representation = lengthRepresentation(target)
    return Value {scalar: representation, value: run SsaFunction.memoryGrow(&mut writer.*.function, values[usize.ZERO])}
  }
  if primitive == IntrinsicPrimitive.WasmAtomicWait32 {
    return Value {scalar: representation, value: run SsaFunction.atomicWait(&mut writer.*.function, values[usize.ZERO], values[usize.ONE], values[2])}
  }
  return Value {scalar: representation, value: run SsaFunction.atomicNotify(&mut writer.*.function, values[usize.ZERO], values[usize.ONE])}
}

// Makes the blocks of `count` MIR blocks.
effect fn addBlocks(writer: &mut Writer, count: usize) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < count {
    let block = run labelled(&mut writer.*, b"block")
    run List<usize>.append(&mut writer.*.blocks, block)
    at = at + usize.ONE
  }
  return ()
}

struct Suspended {
  facts: Facts,
  coroutine: Coroutine,
}

fn wordSize(target: &Target) -> usize {
  return u32.toUsize(Target.pointerBits(target)) / 8
}

effect fn planFrame(function: &MirFunction, target: &Target, layouts: &TypeLayouts, facts: &Facts) -> Coroutine
! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let locals = List<Local>.asSlice(&function.locals)
  let mut extents = List<Extent>.make()
  let mut local = usize.ZERO
  while local < locals.length {
    let metrics = run layoutOf(layouts, &locals[local].ty, function, locals[local].origin.location)
    let kind = storageRepresentation(&locals[local].ty, target, metrics)
    let mut size = metrics.size
    if kind.unit { size = usize.ZERO }
    let mut alignment = metrics.alignment
    if alignment == usize.ZERO { alignment = usize.ONE }
    run List<Extent>.append(&mut extents, Extent {size: size, alignment: alignment})
    local = local + usize.ONE
  }
  let blocks = List<Block>.asSlice(&function.blocks)
  let mut suspending = List<bool>.make()
  let mut points = List<bool>.make()
  let mut block = usize.ZERO
  while block < blocks.length {
    let mut suspends = false
    if let Terminator.Call {callee, ..} = &blocks[block].terminator {
      if let Callee.Instance {key} = &callee { suspends = run Facts.suspends(facts, &key) }
    }
    if let Terminator.Relinquish {..} = &blocks[block].terminator { suspends = true }
    run List<bool>.append(&mut suspending, suspends)
    // A cancel landing runs its nonparking cleanup to completion through an ordinary driver
    // call. It records no cancel exit and must not push that call onto the destroyed package.
    run List<bool>.append(&mut points, suspends && Coroutine.cancelAfter(function, block) != usize.MAX)
    block = block + usize.ONE
  }
  run requireCancelExits(function, List<bool>.asSlice(&suspending))
  let mut providers = usize.ZERO
  while providerLocalAt(function, providers) != usize.MAX { providers = providers + usize.ONE }
  let companions = run companionLocals(function)
  return run Coroutine.plan(function, List<Extent>.asSlice(&extents), List<bool>.asSlice(&points), providers,
    List<usize>.asSlice(&companions), wordSize(target))
}

// `<symbol><suffix>`, such as a definition's `$enter` symbol.
effect fn suffixed(symbol: &[u8], suffix: &[u8]) -> Bytes ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut name = run Bytes.copy(symbol)
  run Bytes.append(&mut name, suffix)
  return move name
}

// Copies `size` bytes; frame states and stack slots never overlap.
effect fn copyBytes(writer: &mut Writer, destination: u64, source: u64, size: usize) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run copyCall(&mut writer.*, destination, usize.ZERO, source, size, true)
}

effect fn storeWordAt(writer: &mut Writer, value: u64, base: u64, offset: usize) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let address = run byteOffset(&mut writer.*, base, offset)
  return run storeOf(&mut writer.*, value, address, usize.ZERO)
}

effect fn loadWordAt(writer: &mut Writer, base: u64, offset: usize) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let address = run byteOffset(&mut writer.*, base, offset)
  return run loadPointer(&mut writer.*, address, usize.ZERO)
}

// Loads one hidden caller address from the frame header.
effect fn loadHidden(writer: &mut Writer, offset: usize) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let frame = writer.frame
  let loaded = run loadWordAt(&mut writer.*, frame, offset)
  return loaded
}

effect fn takesResult(function: &MirFunction, target: &Target, layouts: &TypeLayouts) -> bool
! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let locals = List<Local>.asSlice(&function.locals)
  let facts = run layoutOf(layouts, &function.result, function, locals[usize.ZERO].origin.location)
  return failureLocal(function) != usize.MAX || !storageRepresentation(&function.result, target, facts).unit
}

// The `$enter` signature: the transfer record, the written parameter lanes, then the hidden
// provider, observer and cause addresses, then the result (when `takes`), failure and context
// addresses. Records the arguments in `writer` as a definition's own are.
effect fn enterSignature(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts, takes: bool)
-> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let pointer = run pointerType(&mut writer.*)
  let locals = List<Local>.asSlice(&function.locals)
  let parameters = List<Interned<Type>>.asSlice(&function.parameters)
  let shape = run LoweringPlan.enterShape(LoweringPlan.callable(function), takes)
  let order = List<Lane>.asSlice(&shape.lanes)
  let mut step = usize.ZERO
  while step < order.length {
    match order[step] {
      Lane.Transfer => { writer.transfer = run parameterOf(&mut writer.*, pointer) }
      Lane.Parameter {index: at} => {
        let facts = run layoutOf(layouts, &parameters[at], function, locals[at + usize.ONE].origin.location)
        let lane = storageRepresentation(&parameters[at], target, facts)
        if !lane.unit {
          let mut ty = pointer
          if facts.abi != Abi.Indirect && !passedIndirectly(lane) { ty = run typeOf(&mut writer.*, lane) }
          let span = locals[at + usize.ONE].origin.location
          let split = run parameterLanes(layouts, &parameters[at], facts, target, function, span)
          if split.count != usize.ZERO { ty = run typeOf(&mut writer.*, split.lanes[0]) }
          let added = run parameterOf(&mut writer.*, ty)
          run List<u64>.append(&mut writer.*.parameters, added)
          run addExtraLanes(&mut writer.*, &split)
        } else {
          run List<u64>.append(&mut writer.*.parameters, none())
          run List<u64>.appendRepeated(&mut writer.*.extras, none(), 3)
        }
      }
      Lane.Provider {..} => {
        let added = run parameterOf(&mut writer.*, pointer)
        run List<u64>.append(&mut writer.*.providers, added)
      }
      Lane.Observer => { writer.observer = run parameterOf(&mut writer.*, pointer) }
      Lane.Cause => { writer.cause = run parameterOf(&mut writer.*, pointer) }
      Lane.Site => { writer.site = run parameterOf(&mut writer.*, pointer) }
      Lane.Result => { writer.out = run parameterOf(&mut writer.*, pointer) }
      Lane.Failure => { writer.failure = run parameterOf(&mut writer.*, pointer) }
      Lane.Context => { writer.context = run parameterOf(&mut writer.*, pointer) }
    }
    step = step + usize.ONE
  }
  return ()
}

// Calls `<symbol>$enter` from a driver with its own arguments in `$enter`'s order, passing `out`
// as the result address unless it is `none()`.
effect fn callEnter(writer: &mut Writer, symbol: &[u8], transfer: u64, out: u64) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut arguments = List<u64>.make()
  run List<u64>.append(&mut arguments, transfer)
  let parameters = List<u64>.asSlice(&writer.parameters)
  let extras = List<u64>.asSlice(&writer.extras)
  let mut at = usize.ZERO
  while at < parameters.length {
    if parameters[at] != none() { run List<u64>.append(&mut arguments, parameters[at]) }
    let mut lane = usize.ZERO
    while lane < 3 && at * 3 + lane < extras.length {
      if extras[at * 3 + lane] != none() { run List<u64>.append(&mut arguments, extras[at * 3 + lane]) }
      lane = lane + usize.ONE
    }
    at = at + usize.ONE
  }
  run appendWords(&mut arguments, List<u64>.asSlice(&writer.providers))
  if writer.observer != none() {
    run List<u64>.append(&mut arguments, writer.observer)
    run List<u64>.append(&mut arguments, writer.cause)
    run List<u64>.append(&mut arguments, writer.site)
  }
  if out != none() { run List<u64>.append(&mut arguments, out) }
  if writer.failure != none() {
    run List<u64>.append(&mut arguments, writer.failure)
    if writer.context != none() { run List<u64>.append(&mut arguments, writer.context) }
  }
  return run callSuffixed(&mut writer.*, symbol, b"$enter", List<u64>.asSlice(&arguments))
}

// Calls `<symbol><suffix>`, a function returning nothing, with `arguments`.
effect fn callSuffixed(writer: &mut Writer, symbol: &[u8], suffix: &[u8], arguments: &[u64]) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let name = run suffixed(symbol, suffix)
  drop run callNamed(&mut writer.*, Bytes.asSlice(&name), Kind.unit(), arguments)
  return ()
}

effect fn appendWords(list: &mut List<u64>, words: &[u64]) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < words.length {
    run List<u64>.append(&mut list.*, words[at])
    at = at + usize.ONE
  }
  return ()
}

// Steps the frame on top of `transfer`, answering the step's completion code. `steps` is the
// driver's step record (`stepRecord`), which the step runs published in, or `none()`.
effect fn stepTop(writer: &mut Writer, transfer: u64, top: u64, steps: u64, word: usize) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let resume = run loadWordAt(&mut writer.*, top, Coroutine.resumeOffset(word))
  return run stepFrame(&mut writer.*, resume, transfer, top, steps, word)
}

// Runs `resume`, the step of `top`, as `stepTop` does.
effect fn stepFrame(writer: &mut Writer, resume: u64, transfer: u64, top: u64, steps: u64, word: usize) -> u64
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let int32 = run integerType(&mut writer.*, 32)
  let arguments = [transfer, top]
  if steps == none() { return run callAddress(&mut writer.*, resume, &arguments, int32) }
  let active = run activeSteps(&mut writer.*, word)
  let outer = run loadPointer(&mut writer.*, active, word)
  run storeWordAt(&mut writer.*, top, steps, usize.ZERO)
  run storeWordAt(&mut writer.*, outer, steps, word)
  run storeOf(&mut writer.*, steps, active, word)
  let code = run callAddress(&mut writer.*, resume, &arguments, int32)
  run storeOf(&mut writer.*, outer, active, word)
  return code
}

// The step record of a driver, `{top, outer}`. While a driver steps a frame, its record holds that
// frame and the record it hides, and the thread's innermost record (`activeSteps`) is it, so a
// trap's report can name the suspended callers of the frame, which only the frame chain knows
// (`defineStepChain`).
effect fn stepRecord(writer: &mut Writer, word: usize) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  return run allocaOf(&mut writer.*, word * 2, word)
}

// The thread-local address of the innermost step record (`stepRecord`), null outside every step.
effect fn activeSteps(writer: &mut Writer, word: usize) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  // Every fragment that reads it defines it; the link keeps one.
  let objects = List<Object>.asSlice(&writer.fragment.objects)
  let mut defined = false
  let mut at = usize.ZERO
  while at < objects.length {
    if same(Bytes.asSlice(&objects[at].symbol), b"__silk_active_steps") { defined = true }
    at = at + usize.ONE
  }
  if !defined { run defineObject(&mut writer.*, b"__silk_active_steps", word, run Bytes.zeroed(word), List<ObjectPointer>.make(), false, true) }
  return run writer.function.symbolAddress(b"__silk_active_steps", 0, true)
}

// Whether `value` is the null address.
effect fn isNull(writer: &mut Writer, value: u64) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let null = run nullOf(&mut writer.*)
  return run compareOf(&mut writer.*, Predicate.Eq, value, null)
}

// Destroys the storage state of `transfer`, if any, then continues at `exit`.
effect fn destroyState(writer: &mut Writer, stepping: &Suspended, transfer: u64, clear: bool, exit: usize) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let state = run loadPointer(&mut writer.*, transfer, usize.ZERO)
  let absent = run isNull(&mut writer.*, state)
  let destroy = run labelled(&mut writer.*, b"destroy")
  run branchIf(&mut writer.*, absent, exit, destroy)
  run startBlock(&mut writer.*, destroy)
  let arguments = [state]
  drop run callNamed(&mut writer.*, Bytes.asSlice(&stepping.facts.destroy), Kind.unit(), &arguments)
  if clear {
    let null = run nullOf(&mut writer.*)
    run storeOf(&mut writer.*, null, transfer, usize.ZERO)
  }
  return run branch(&mut writer.*, exit)
}

// The ordinary symbol's body: push the instance's frame, step the top frame until none remains,
// destroy the storage state the frames used, and return the outcome under the ordinary convention.
effect fn emitDriver(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  stepping: &Suspended, symbol: &[u8]) -> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = wordSize(target)
  let locals = List<Local>.asSlice(&function.locals)
  let resultFacts = run layoutOf(layouts, &function.result, function, locals[usize.ZERO].origin.location)
  let result = storageRepresentation(&function.result, target, resultFacts)
  let fallible = failureLocal(function) != usize.MAX
  if packageStart(function) { return run emitPackageDriver(&mut writer.*, function, target, layouts, stepping, symbol) }
  let entry = run labelled(&mut writer.*, b"entry")
  run startBlock(&mut writer.*, entry)
  let steps = run stepRecord(&mut writer.*, word)
  let transfer = run allocaOf(&mut writer.*, word * 4, word)
  let null = run nullOf(&mut writer.*)
  run storeOf(&mut writer.*, null, transfer, usize.ZERO)
  run storeWordAt(&mut writer.*, null, transfer, Coroutine.transferTop(word))
  run storeWordAt(&mut writer.*, null, transfer, Coroutine.transferPackage(word))
  let failed = run byteOffset(&mut writer.*, transfer, Coroutine.transferFailed(word))
  let clear = run integerOf(&mut writer.*, 8, 0)
  run storeOf(&mut writer.*, clear, failed, usize.ZERO)
  let mut out = none()
  if fallible || result.aggregate || passedIndirectly(result) { out = writer.out }
  else if !result.unit {
    out = run allocaOf(&mut writer.*, resultFacts.size, resultFacts.alignment)
  }
  run callEnter(&mut writer.*, symbol, transfer, out)
  let drive = run labelled(&mut writer.*, b"drive")
  run branch(&mut writer.*, drive)
  run startBlock(&mut writer.*, drive)
  let top = run loadWordAt(&mut writer.*, transfer, Coroutine.transferTop(word))
  let empty = run isNull(&mut writer.*, top)
  let finish = run labelled(&mut writer.*, b"finish")
  let step = run labelled(&mut writer.*, b"step")
  run branchIf(&mut writer.*, empty, finish, step)
  run startBlock(&mut writer.*, step)
  let _code = run stepTop(&mut writer.*, transfer, top, steps, word)
  run branch(&mut writer.*, drive)
  run startBlock(&mut writer.*, finish)
  let exit = run labelled(&mut writer.*, b"exit")
  run destroyState(&mut writer.*, stepping, transfer, false, exit)
  run startBlock(&mut writer.*, exit)
  if fallible {
    let byte = run integerType(&mut writer.*, 8)
    let flag = run loadKind(&mut writer.*, byte, failed)
    let zero = run integerOf(&mut writer.*, 8, 0)
    let status = run compareOf(&mut writer.*, Predicate.Ne, flag, zero)
    return run returnValue(&mut writer.*, status)
  }
  if result.aggregate || result.unit || passedIndirectly(result) { return run returnVoid(&mut writer.*) }
  let value = run loadOf(&mut writer.*, result, out, resultFacts.alignment)
  return run returnValue(&mut writer.*, value)
}

fn packageStart(function: &MirFunction) -> bool {
  return match &function.key {
    InstanceKey.Helper {purpose, ..} => purpose == HelperRole.Start
    _ => false
  }
}

// An execution package's start drives the transfer record its header begins with: the first
// activation pushes the start's own frame, a later one continues the frames a relinquishment left.
// A step that relinquishes returns with the frames in place; the storage state is destroyed once,
// when the last frame completes.
effect fn emitPackageDriver(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  stepping: &Suspended, symbol: &[u8]) -> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = wordSize(target)
  let entry = run labelled(&mut writer.*, b"entry")
  run startBlock(&mut writer.*, entry)
  let steps = run stepRecord(&mut writer.*, word)
  let header = List<u64>.get(&writer.parameters, usize.ZERO)
  let transfer = run byteOffset(&mut writer.*, header, usize.ZERO)
  let first = run loadWordAt(&mut writer.*, transfer, Coroutine.transferTop(word))
  let fresh = run isNull(&mut writer.*, first)
  let enter = run labelled(&mut writer.*, b"enter")
  let drive = run labelled(&mut writer.*, b"drive")
  run branchIf(&mut writer.*, fresh, enter, drive)
  run startBlock(&mut writer.*, enter)
  run callEnter(&mut writer.*, symbol, transfer, none())
  run branch(&mut writer.*, drive)
  run startBlock(&mut writer.*, drive)
  let top = run loadWordAt(&mut writer.*, transfer, Coroutine.transferTop(word))
  let empty = run isNull(&mut writer.*, top)
  let finish = run labelled(&mut writer.*, b"finish")
  let step = run labelled(&mut writer.*, b"step")
  run branchIf(&mut writer.*, empty, finish, step)
  run startBlock(&mut writer.*, step)
  let code = run stepTop(&mut writer.*, transfer, top, steps, word)
  let relinquishedCode = run integerOf(&mut writer.*, 32, 2)
  let relinquished = run compareOf(&mut writer.*, Predicate.Eq, code, relinquishedCode)
  let parked = run labelled(&mut writer.*, b"parked")
  run branchIf(&mut writer.*, relinquished, parked, drive)
  run startBlock(&mut writer.*, parked)
  run returnVoid(&mut writer.*)
  run startBlock(&mut writer.*, finish)
  let exit = run labelled(&mut writer.*, b"exit")
  run destroyState(&mut writer.*, stepping, transfer, true, exit)
  run startBlock(&mut writer.*, exit)
  return run returnVoid(&mut writer.*)
}

// `$enter` acquires the instance's frame from the transfer record's storage state, creating that
// state on first use, records the caller's addresses and the parameters, and pushes the frame.
// Storage refusal is the fatal execution-stack exhaustion trap (SUSP-006).
effect fn emitEnter(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  stepping: &Suspended, symbol: &[u8]) -> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = wordSize(target)
  let takes = run takesResult(function, target, layouts)
  let name = run suffixed(symbol, b"$enter")
  run beginFunction(&mut writer.*, Bytes.asSlice(&name))
  run enterSignature(&mut writer.*, function, target, layouts, takes)
  let transfer = writer.transfer
  let pointer = run pointerType(&mut writer.*)
  let entry = run labelled(&mut writer.*, b"entry")
  run startBlock(&mut writer.*, entry)
  let current = run loadPointer(&mut writer.*, transfer, usize.ZERO)
  let missing = run isNull(&mut writer.*, current)
  let create = run labelled(&mut writer.*, b"create")
  let ready = run labelled(&mut writer.*, b"ready")
  run branchIf(&mut writer.*, missing, create, ready)
  run startBlock(&mut writer.*, create)
  let created = run callNamed(&mut writer.*, Bytes.asSlice(&stepping.facts.create), pointer, &[])
  let refused = run isNull(&mut writer.*, created)
  let exhausted = run labelled(&mut writer.*, b"exhausted")
  let publish = run labelled(&mut writer.*, b"publish")
  run branchIf(&mut writer.*, refused, exhausted, publish)
  run startBlock(&mut writer.*, publish)
  run storeOf(&mut writer.*, created, transfer, usize.ZERO)
  run branch(&mut writer.*, ready)
  run startBlock(&mut writer.*, ready)
  let state = run loadPointer(&mut writer.*, transfer, usize.ZERO)
  let size = run wordOf(&mut writer.*, stepping.coroutine.size)
  let alignment = run wordOf(&mut writer.*, stepping.coroutine.alignment)
  let null = run nullOf(&mut writer.*)
  let start = run labelled(&mut writer.*, b"start")
  let provide = run labelled(&mut writer.*, b"provide")
  let provided = run labelled(&mut writer.*, b"provided")
  // A frame no more aligned than a word is carved from the state's window when it fits: the
  // window's word-aligned cursor moves past it, and its release moves the cursor back.
  let frame = run variableOf(&mut writer.*, pointer)
  let carved = run variableOf(&mut writer.*, pointer)
  if stepping.coroutine.alignment <= word {
    let cursor = run loadPointer(&mut writer.*, state, usize.ZERO)
    let end = run loadWordAt(&mut writer.*, state, word)
    let wordTy = run wordType(&mut writer.*)
    let endWord = run castTo(&mut writer.*, Cast.PtrToInt, end, wordTy)
    let cursorWord = run castTo(&mut writer.*, Cast.PtrToInt, cursor, wordTy)
    let room = run binaryOf(&mut writer.*, Binary.Sub, endWord, cursorWord)
    let fits = run compareOf(&mut writer.*, Predicate.Ule, size, room)
    let carve = run labelled(&mut writer.*, b"carve")
    run branchIf(&mut writer.*, fits, carve, provide)
    run startBlock(&mut writer.*, carve)
    let moved = run byteOffset(&mut writer.*, cursor, stepping.coroutine.size)
    run storeOf(&mut writer.*, moved, state, usize.ZERO)
    run assignOf(&mut writer.*, frame, cursor)
    run assignOf(&mut writer.*, carved, cursor)
    run branch(&mut writer.*, start)
  } else {
    run branch(&mut writer.*, provide)
  }
  run startBlock(&mut writer.*, provide)
  let acquireArguments = [state, size, alignment]
  let acquired = run callNamed(&mut writer.*, Bytes.asSlice(&stepping.facts.acquire), pointer, &acquireArguments)
  let absent = run isNull(&mut writer.*, acquired)
  run branchIf(&mut writer.*, absent, exhausted, provided)
  run startBlock(&mut writer.*, exhausted)
  run trapHere(&mut writer.*)
  run startBlock(&mut writer.*, provided)
  run assignOf(&mut writer.*, frame, acquired)
  run assignOf(&mut writer.*, carved, null)
  run branch(&mut writer.*, start)
  run startBlock(&mut writer.*, start)
  writer.frame = frame
  run storeWordAt(&mut writer.*, carved, frame, Coroutine.carvedOffset(word))
  let parent = run loadWordAt(&mut writer.*, transfer, Coroutine.transferTop(word))
  run storeOf(&mut writer.*, parent, frame, usize.ZERO)
  let stepName = run suffixed(symbol, b"$step")
  let stepFunction = run addressOf(&mut writer.*, Bytes.asSlice(&stepName))
  run storeWordAt(&mut writer.*, stepFunction, frame, Coroutine.resumeOffset(word))
  let initial = run byteOffset(&mut writer.*, frame, Coroutine.stateOffset(word))
  let zero = run integerOf(&mut writer.*, 32, 0)
  run storeOf(&mut writer.*, zero, initial, usize.ZERO)
  let observed = diagnosticLocal(function, usize.ZERO) != usize.MAX
  let fallible = failureLocal(function) != usize.MAX
  let hidden = [writer.out, writer.failure, writer.context, writer.observer, writer.cause, writer.site]
  if takes { run storeWordAt(&mut writer.*, hidden[0], frame, Coroutine.outOffset(word)) }
  if fallible {
    run storeWordAt(&mut writer.*, hidden[1], frame, Coroutine.failOffset(word))
    if observed { run storeWordAt(&mut writer.*, hidden[2], frame, Coroutine.contextOffset(word)) }
  }
  if observed {
    run storeWordAt(&mut writer.*, hidden[3], frame, Coroutine.observerOffset(word))
    run storeWordAt(&mut writer.*, hidden[4], frame, Coroutine.causeOffset(word))
    run storeWordAt(&mut writer.*, hidden[5], frame, Coroutine.siteOffset(word))
  }
  let mut provider = usize.ZERO
  while providerLocalAt(function, provider) != usize.MAX {
    let address = List<u64>.get(&writer.providers, provider)
    run storeWordAt(&mut writer.*, address, frame, Coroutine.providerOffset(word, provider))
    provider = provider + usize.ONE
  }
  // Each parameter lands where the body reads it: its resident slot or its slot in state 0.
  let locals = List<Local>.asSlice(&function.locals)
  let parameters = List<Interned<Type>>.asSlice(&function.parameters)
  let mut at = usize.ZERO
  while at < parameters.length {
    let offset = Coroutine.parameterAt(&stepping.coroutine, at + usize.ONE)
    let parameterLayout = run layoutOf(layouts, &parameters[at], function, locals[at + usize.ONE].origin.location)
    let kind = storageRepresentation(&parameters[at], target, parameterLayout)
    if !kind.unit && offset != usize.MAX {
      let slot = run byteOffset(&mut writer.*, frame, offset)
      let input = List<u64>.get(&writer.parameters, at)
      let span = locals[at + usize.ONE].origin.location
      let split = run parameterLanes(layouts, &parameters[at], parameterLayout, target, function, span)
      if split.count != usize.ZERO {
        let inputs = [input, List<u64>.get(&writer.extras, at * 3), List<u64>.get(&writer.extras, at * 3 + 1),
          List<u64>.get(&writer.extras, at * 3 + 2)]
        run storeLanes(&mut writer.*, &split, slot, offsetAlignment(stepping.coroutine.alignment, offset), &inputs)
        at = at + usize.ONE
        continue
      }
      if passedIndirectly(kind) {
        run copyBytes(&mut writer.*, slot, input, parameterLayout.size)
        at = at + usize.ONE
        continue
      }
      let address = Address {ty: Interned<Type>.clone(&parameters[at]), value: slot,
        alignment: offsetAlignment(stepping.coroutine.alignment, offset), representation: kind}
      run storeValue(&mut writer.*, &address, &Value {scalar: kind, value: input})
    }
    at = at + usize.ONE
  }
  run storeWordAt(&mut writer.*, frame, transfer, Coroutine.transferTop(word))
  run returnVoid(&mut writer.*)
  return run endBody(&mut writer.*, b"")
}

// Copies one state's saved locals between their stack slots and the frame.
effect fn transferState(writer: &mut Writer, slots: &[FrameSlot], saving: bool) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let base = writer.frame
  let mut at = usize.ZERO
  while at < slots.length {
    let frame = run byteOffset(&mut writer.*, base, slots[at].offset)
    let local = slotOf(&writer.*, slots[at].local)
    if saving { run copyBytes(&mut writer.*, frame, local, slots[at].size) }
    else { run copyBytes(&mut writer.*, local, frame, slots[at].size) }
    at = at + usize.ONE
  }
  return ()
}

// `$step` runs the frame on top from its resume state: state 0 starts the body, and state `k + 1`
// restores what lives after point `k`, then continues at that call's normal or failure edge, or,
// when the frame's package was dropped while relinquished, at that point's cancel exit.
effect fn emitStep(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  foreign: &[CAbi.Signature], identities: &[InstanceIdentity], suspended: &Option<Suspended>, stepping: &Suspended,
  symbol: &[u8]) -> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = wordSize(target)
  let pointer = run pointerType(&mut writer.*)
  let int32 = run integerType(&mut writer.*, 32)
  let name = run suffixed(symbol, b"$step")
  run frameEntry(&mut writer.*, function, target, b"$step")
  run beginFunction(&mut writer.*, Bytes.asSlice(&name))
  writer.transfer = run parameterOf(&mut writer.*, pointer)
  writer.frame = run parameterOf(&mut writer.*, pointer)
  writer.function.setResult(int32)
  let transfer = writer.transfer
  let frame = writer.frame
  let blocks = List<Block>.asSlice(&function.blocks)
  let states = List<State>.asSlice(&stepping.coroutine.states)
  let points = List<usize>.asSlice(&stepping.coroutine.points)
  let entry = run labelled(&mut writer.*, b"entry")
  run addBlocks(&mut writer.*, blocks.length)
  run startBlock(&mut writer.*, entry)
  run emitSlots(&mut writer.*, function, target, layouts, suspended)
  run emitCCopySlots(&mut writer.*, function, target, layouts, foreign)
  writer.steps = run stepRecord(&mut writer.*, word)
  let observed = diagnosticLocal(function, usize.ZERO) != usize.MAX
  let fallible = failureLocal(function) != usize.MAX
  if run takesResult(function, target, layouts) { writer.out = run loadHidden(&mut writer.*, Coroutine.outOffset(word)) }
  if fallible {
    writer.failure = run loadHidden(&mut writer.*, Coroutine.failOffset(word))
    if observed { writer.context = run loadHidden(&mut writer.*, Coroutine.contextOffset(word)) }
  }
  if observed {
    writer.observer = run loadHidden(&mut writer.*, Coroutine.observerOffset(word))
    writer.cause = run loadHidden(&mut writer.*, Coroutine.causeOffset(word))
    writer.site = run loadHidden(&mut writer.*, Coroutine.siteOffset(word))
  }
  let mut provider = usize.ZERO
  while providerLocalAt(function, provider) != usize.MAX {
    let loaded = run loadHidden(&mut writer.*, Coroutine.providerOffset(word, provider))
    run List<u64>.append(&mut writer.*.providers, loaded)
    provider = provider + usize.ONE
  }
  let stateAddress = run byteOffset(&mut writer.*, frame, Coroutine.stateOffset(word))
  let state = run loadKind(&mut writer.*, int32, stateAddress)
  let probe = run labelled(&mut writer.*, b"probe")
  let dispatch = run labelled(&mut writer.*, b"dispatch")
  let cancelling = run labelled(&mut writer.*, b"cancelling")
  let invalid = run labelled(&mut writer.*, b"invalid")
  let start = run labelled(&mut writer.*, b"start")
  let resumed = run labelled(&mut writer.*, b"resumed")
  let mut resumes = List<usize>.make()
  let mut cancels = List<usize>.make()
  let mut point = usize.ONE
  while point < states.length {
    run List<usize>.append(&mut resumes, run labelledNumber(&mut writer.*, b"resume", point))
    run List<usize>.append(&mut cancels, run labelledNumber(&mut writer.*, b"cancel", point))
    point = point + usize.ONE
  }
  // A fresh frame starts its body: its caller is running, so its package is neither dropped nor
  // interrupted.
  let initial = run integerOf(&mut writer.*, 32, 0)
  let fresh = run compareOf(&mut writer.*, Predicate.Eq, state, initial)
  run branchIf(&mut writer.*, fresh, start, resumed)
  run startBlock(&mut writer.*, resumed)
  // A frame whose package was dropped while relinquished cancels from its point (`Destroyed`), as
  // does one whose package holds an interrupt request: its cancel exit resumes the boundary the
  // request names, or abandons the frame for its caller's.
  let package = run loadWordAt(&mut writer.*, transfer, Coroutine.transferPackage(word))
  let null = run nullOf(&mut writer.*)
  let owned = run compareOf(&mut writer.*, Predicate.Ne, package, null)
  run branchIf(&mut writer.*, owned, probe, dispatch)
  run startBlock(&mut writer.*, probe)
  let activation = run byteOffset(&mut writer.*, package, Coroutine.packageActivation(word))
  let wordTy = run wordType(&mut writer.*)
  let lifecycle = run loadKind(&mut writer.*, wordTy, activation)
  let destroyedWord = run wordOf(&mut writer.*, SealedCore.lifecycleWord(Lifecycle.Destroyed))
  let destroyed = run compareOf(&mut writer.*, Predicate.Eq, lifecycle, destroyedWord)
  let interruptAddress = run byteOffset(&mut writer.*, package, SealedCore.ordinal(CoreField.HeaderInterrupt) * word)
  let interruptWord = run loadKind(&mut writer.*, wordTy, interruptAddress)
  let idleWord = run wordOf(&mut writer.*, usize.ZERO)
  let interrupted = run compareOf(&mut writer.*, Predicate.Ne, interruptWord, idleWord)
  let stopping = run binaryOf(&mut writer.*, Binary.Or, destroyed, interrupted)
  run branchIf(&mut writer.*, stopping, cancelling, dispatch)
  run startBlock(&mut writer.*, cancelling)
  let mut table = List<u64>.make()
  point = usize.ONE
  while point < states.length {
    run List<u64>.append(&mut table, usize.toU64(point))
    run List<u64>.append(&mut table, usize.toU64(List<usize>.get(&cancels, point - usize.ONE)))
    point = point + usize.ONE
  }
  run SsaFunction.switch(&mut writer.*.function, state, List<u64>.asSlice(&table), invalid)
  run startBlock(&mut writer.*, dispatch)
  List<u64>.clear(&mut table)
  point = usize.ONE
  while point < states.length {
    run List<u64>.append(&mut table, usize.toU64(point))
    run List<u64>.append(&mut table, usize.toU64(List<usize>.get(&resumes, point - usize.ONE)))
    point = point + usize.ONE
  }
  run SsaFunction.switch(&mut writer.*.function, state, List<u64>.asSlice(&table), invalid)
  run startBlock(&mut writer.*, invalid)
  run trapHere(&mut writer.*)
  run startBlock(&mut writer.*, start)
  run transferState(&mut writer.*, List<FrameSlot>.asSlice(&states[usize.ZERO].slots), false)
  run emitHiddenStores(&mut writer.*, function)
  let first = blockAt(&writer.*, usize.ZERO)
  run branch(&mut writer.*, first)
  point = usize.ONE
  while point < states.length {
    run startBlock(&mut writer.*, List<usize>.get(&resumes, point - usize.ONE))
    run transferState(&mut writer.*, List<FrameSlot>.asSlice(&states[point].slots), false)
    run emitDiagnosticStores(&mut writer.*, function)
    if let Terminator.Relinquish {resume, ..} = &blocks[points[point - usize.ONE]].terminator {
      let next = blockAt(&writer.*, resume)
      run branch(&mut writer.*, next)
    }
    if let Terminator.Call {normal, failure, ..} = &blocks[points[point - usize.ONE]].terminator {
      let onSuccess = blockAt(&writer.*, normal)
      if let Option<FailureEdge>.Some {value: edge} = &failure {
        let failed = run byteOffset(&mut writer.*, transfer, Coroutine.transferFailed(word))
        let byte = run integerType(&mut writer.*, 8)
        let flag = run loadKind(&mut writer.*, byte, failed)
        let zero = run integerOf(&mut writer.*, 8, 0)
        let taken = run compareOf(&mut writer.*, Predicate.Ne, flag, zero)
        let onFailure = blockAt(&writer.*, edge.target)
        run branchIf(&mut writer.*, taken, onFailure, onSuccess)
      } else {
        run branch(&mut writer.*, onSuccess)
      }
    }
    point = point + usize.ONE
  }
  // State `k + 1` cancels by restoring what lives after point `k` and entering its cancel exit.
  point = usize.ONE
  while point < states.length {
    run startBlock(&mut writer.*, List<usize>.get(&cancels, point - usize.ONE))
    let exit = Coroutine.cancelAfter(function, points[point - usize.ONE])
    if exit == usize.MAX {
      run trapHere(&mut writer.*)
    } else {
      run transferState(&mut writer.*, List<FrameSlot>.asSlice(&states[point].slots), false)
      run emitDiagnosticStores(&mut writer.*, function)
      let next = blockAt(&writer.*, exit)
      run branch(&mut writer.*, next)
    }
    point = point + usize.ONE
  }
  noteDiagnosticLocals(&mut writer.*, function)
  let mut at = usize.ZERO
  while at < blocks.length {
    let handle = blockAt(&writer.*, at)
    run startBlock(&mut writer.*, handle)
    run emitBlock(&mut writer.*, function, target, layouts, &blocks[at], foreign, identities, suspended, at)
    at = at + usize.ONE
  }
  return run endBody(&mut writer.*, b"")
}

// Completes the frame on top: records whether it failed, pops it, releases it to its storage
// state, and reports completion to the driver.
effect fn emitPop(writer: &mut Writer, target: &Target, stepping: &Suspended, failed: Option<bool>) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let word = wordSize(target)
  let transfer = writer.transfer
  let frame = writer.frame
  if let Option<bool>.Some {value} = move failed {
    let flag = run byteOffset(&mut writer.*, transfer, Coroutine.transferFailed(word))
    let mut bit: u64 = 0
    if value { bit = 1 }
    let stored = run integerOf(&mut writer.*, 8, bit)
    run storeOf(&mut writer.*, stored, flag, usize.ZERO)
  }
  let parent = run loadPointer(&mut writer.*, frame, usize.ZERO)
  run storeWordAt(&mut writer.*, parent, transfer, Coroutine.transferTop(word))
  let state = run loadPointer(&mut writer.*, transfer, usize.ZERO)
  // A carved frame returns the window's cursor to itself; an acquired one goes back to the state.
  let carved = run loadWordAt(&mut writer.*, frame, Coroutine.carvedOffset(word))
  let acquiredFrame = run isNull(&mut writer.*, carved)
  let restore = run labelled(&mut writer.*, b"restore")
  let returning = run labelled(&mut writer.*, b"returning")
  let completed = run labelled(&mut writer.*, b"done")
  run branchIf(&mut writer.*, acquiredFrame, returning, restore)
  run startBlock(&mut writer.*, restore)
  run storeOf(&mut writer.*, frame, state, usize.ZERO)
  run branch(&mut writer.*, completed)
  run startBlock(&mut writer.*, returning)
  let arguments = [state, frame]
  drop run callNamed(&mut writer.*, Bytes.asSlice(&stepping.facts.release), Kind.unit(), &arguments)
  run branch(&mut writer.*, completed)
  run startBlock(&mut writer.*, completed)
  let done = run integerOf(&mut writer.*, 32, 0)
  return run returnValue(&mut writer.*, done)
}

// A step's `Return` writes the result through the caller's result address before completing.
effect fn emitStepReturn(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  stepping: &Suspended, span: Location) -> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let resultLayout = run layoutOf(layouts, &function.result, function, span)
  let kind = storageRepresentation(&function.result, target, resultLayout)
  if !kind.unit {
    let returned = Operand.Copy {place: Place {local: usize.ZERO, projections: List<Projection>.make()}}
    let value = run emitOperand(&mut writer.*, function, target, layouts, &returned)
    let output = Address {ty: Interned<Type>.clone(&function.result), value: writer.out,
      alignment: resultLayout.alignment, representation: kind}
    run storeValue(&mut writer.*, &output, &value)
  }
  let mut failed = Option<bool>.none()
  if failureLocal(function) != usize.MAX { failed = Option<bool>.some(false) }
  return run emitPop(&mut writer.*, target, stepping, move failed)
}

// A step's `Fail` writes the failure through the caller's failure address before completing.
effect fn emitStepFail(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  stepping: &Suspended, span: Location) -> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let local = failureLocal(function)
  if local == usize.MAX {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.relative(GapCode.TypedForm, &owner, span)
  }
  let locals = List<Local>.asSlice(&function.locals)
  let failureLayout = run layoutOf(layouts, &locals[local].ty, function, span)
  let kind = storageRepresentation(&locals[local].ty, target, failureLayout)
  if !kind.unit {
    let failedValue = Operand.Copy {place: Place {local: local, projections: List<Projection>.make()}}
    let value = run emitOperand(&mut writer.*, function, target, layouts, &failedValue)
    let output = Address {ty: Interned<Type>.clone(&locals[local].ty), value: writer.failure,
      alignment: failureLayout.alignment, representation: kind}
    run storeValue(&mut writer.*, &output, &value)
  }
  return run emitPop(&mut writer.*, target, stepping, Option<bool>.some(true))
}

// Records resume state `state` in the frame and saves the locals it restores.
effect fn suspendAt(writer: &mut Writer, target: &Target, stepping: &Suspended, state: usize) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let word = wordSize(target)
  let frame = writer.frame
  let resume = run byteOffset(&mut writer.*, frame, Coroutine.stateOffset(word))
  let stored = run integerOf(&mut writer.*, 32, usize.toU64(state))
  run storeOf(&mut writer.*, stored, resume, usize.ZERO)
  let states = List<State>.asSlice(&stepping.coroutine.states)
  return run transferState(&mut writer.*, List<FrameSlot>.asSlice(&states[state].slots), true)
}

// A relinquishment saves the locals its resume state restores and returns 2: the frames stay in
// the package's transfer record until the package's start continues them.
effect fn emitRelinquish(writer: &mut Writer, target: &Target, stepping: &Suspended, state: usize) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let word = wordSize(target)
  run suspendAt(&mut writer.*, target, stepping, state)
  // The package's activation records the relinquishment its drive reads (`Lifecycle.Relinquished`).
  let transfer = writer.transfer
  let package = run loadWordAt(&mut writer.*, transfer, Coroutine.transferPackage(word))
  let activation = run byteOffset(&mut writer.*, package, Coroutine.packageActivation(word))
  // A waking thread reads the activation atomically, so the owner writes it atomically (EXEC-009).
  let relinquished = run wordOf(&mut writer.*, SealedCore.lifecycleWord(Lifecycle.Relinquished))
  run SsaFunction.atomicStore(&mut writer.*.function, relinquished, activation)
  let parked = run integerOf(&mut writer.*, 32, 2)
  return run returnValue(&mut writer.*, parked)
}

// A call at a suspension point pushes the callee's frame with the call's operands. To a callee that
// can call back into the caller (`transfers`), it saves the locals its resume state restores and
// returns to the driver, which runs the callee next. Otherwise it runs the callee's step directly: a completed
// callee continues the caller in place at the call's normal or failure edge, and any other step
// code makes the caller save its state and return that code (`backend.Coroutine`).
effect fn emitSuspendingCall(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &TypeLayouts,
  identities: &[InstanceIdentity],
  stepping: &Suspended,
  state: usize,
  transfers: bool,
  callee: &Callee,
  arguments: &List<Operand>,
  providers: &List<Operand>,
  diagnostics: &Option<Diagnostics>,
  destination: &Place,
  normal: usize,
  failure: &Option<FailureEdge>,
  span: Location,
) -> () ! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut symbol = Bytes.make()
  if let Callee.Instance {key} = &callee.* { symbol = run InstanceIdentity.name(identities, &key) }
  else {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.relative(GapCode.TypedForm, &owner, span)
  }
  let output = run emitPlace(&mut writer.*, function, target, layouts, destination)
  let mut failed = none()
  let mut context = none()
  if let Option<FailureEdge>.Some {value: edge} = &failure.* {
    let failureSlot = run emitPlace(&mut writer.*, function, target, layouts, &edge.destination)
    failed = failureSlot.value
    if let Option<Diagnostics>.Some {..} = &diagnostics.* {
      context = companionAddress(&writer.*, function, edge.destination.local)
    }
  }
  let mut passed = List<u64>.make()
  run List<u64>.append(&mut passed, writer.transfer)
  let values = List<Operand>.asSlice(arguments)
  let mut index = usize.ZERO
  while index < values.length {
    let mut lanes = List<Value>.make()
    run appendArgument(&mut writer.*, function, target, layouts, &values[index], false, &mut lanes)
    let given = List<Value>.asSlice(&lanes)
    let mut lane = usize.ZERO
    while lane < given.length {
      if !given[lane].scalar.unit { run List<u64>.append(&mut passed, given[lane].value) }
      lane = lane + usize.ONE
    }
    index = index + usize.ONE
  }
  let hidden = List<Operand>.asSlice(providers)
  index = usize.ZERO
  while index < hidden.length {
    let provided = run emitOperand(&mut writer.*, function, target, layouts, &hidden[index])
    run List<u64>.append(&mut passed, provided.value)
    index = index + usize.ONE
  }
  if let Option<Diagnostics>.Some {value: observed} = &diagnostics.* {
    run appendDiagnostics(&mut writer.*, function, target, layouts, &observed, &mut passed)
  }
  if transfers { run suspendAt(&mut writer.*, target, stepping, state) }
  let fallible = failed != none()
  if fallible || !output.representation.unit { run List<u64>.append(&mut passed, output.value) }
  if fallible {
    run List<u64>.append(&mut passed, failed)
    if context != none() { run List<u64>.append(&mut passed, context) }
  }
  run callSuffixed(&mut writer.*, Bytes.asSlice(&symbol), b"$enter", List<u64>.asSlice(&passed))
  if transfers {
    let pushed = run integerOf(&mut writer.*, 32, 1)
    return run returnValue(&mut writer.*, pushed)
  }
  let word = wordSize(target)
  let transfer = writer.transfer
  let top = run loadWordAt(&mut writer.*, transfer, Coroutine.transferTop(word))
  let stepName = run suffixed(Bytes.asSlice(&symbol), b"$step")
  let step = run addressOf(&mut writer.*, Bytes.asSlice(&stepName))
  let steps = writer.steps
  let code = run stepFrame(&mut writer.*, step, transfer, top, steps, word)
  let done = run integerOf(&mut writer.*, 32, 0)
  let completed = run compareOf(&mut writer.*, Predicate.Eq, code, done)
  let saving = run labelledNumber(&mut writer.*, b"saving", state)
  let continuing = run labelledNumber(&mut writer.*, b"completed", state)
  run branchIf(&mut writer.*, completed, continuing, saving)
  run startBlock(&mut writer.*, saving)
  run suspendAt(&mut writer.*, target, stepping, state)
  run returnValue(&mut writer.*, code)
  run startBlock(&mut writer.*, continuing)
  let onSuccess = blockAt(&writer.*, normal)
  if let Option<FailureEdge>.Some {value: edge} = &failure.* {
    let flagAddress = run byteOffset(&mut writer.*, transfer, Coroutine.transferFailed(word))
    let byte = run integerType(&mut writer.*, 8)
    let flag = run loadKind(&mut writer.*, byte, flagAddress)
    let zero = run integerOf(&mut writer.*, 8, 0)
    let taken = run compareOf(&mut writer.*, Predicate.Ne, flag, zero)
    let onFailure = blockAt(&writer.*, edge.target)
    return run branchIf(&mut writer.*, taken, onFailure, onSuccess)
  }
  return run branch(&mut writer.*, onSuccess)
}

/// One deduplicated declaration candidate owned by an instance answer; `text` is its fragment.
pub struct Declaration {
  pub contract: Bytes,
  pub symbol: Bytes,
  pub text: Bytes,
}

fn pieceRepresentation(piece: CPiece) -> Representation {
  return Representation {aggregate: false, size: usize.ZERO, bits: piece.bits, signed: false,
    unit: false, pointer: piece.abi == Abi.Pointer, floating: piece.abi == Abi.Floating, lanes: piece.lanes, unionAlignment: usize.ZERO, head: usize.ZERO}
}

fn cParameterCount(lane: &CAbi.Lane) -> usize {
  if lane.passing == CPassing.Ignore { return usize.ZERO }
  if lane.passing == CPassing.Coerce { return List<CPiece>.length(&lane.pieces) }
  return usize.ONE
}

// The kind of part `part` of a C parameter lane: a grouped coercion passes its pieces one by one,
// as the wasm C ABI passes the fields of an array.
effect fn cParameterType(writer: &mut Writer, lane: &CAbi.Lane, part: usize) -> Kind ! Unsupported | OutOfMemoryError ? &mut Allocator {
  if lane.passing == CPassing.Indirect { return run pointerType(&mut writer.*) }
  if lane.passing == CPassing.Coerce {
    return run typeOf(&mut writer.*, pieceRepresentation(List<CPiece>.asSlice(&lane.pieces)[part]))
  }
  // Direct lanes need no source position: their scalar admission and layout are already checked.
  if lane.layout.abi == Abi.Vector {
    return run typeOf(&mut writer.*, Representation {aggregate: false, size: usize.ZERO,
      bits: Interned<Type>.with<usize>(&lane.ty, CAbi.vectorLaneBits), signed: false, unit: false,
      pointer: false, floating: Interned<Type>.with<bool>(&lane.ty, CAbi.vectorFloating),
      lanes: Interned<Type>.with<usize>(&lane.ty, CAbi.vectorBits) / Interned<Type>.with<usize>(&lane.ty, CAbi.vectorLaneBits), unionAlignment: usize.ZERO, head: usize.ZERO})
  }
  return run typeOf(&mut writer.*, Representation {aggregate: false, size: usize.ZERO,
    bits: lane.layout.size * 8, signed: false, unit: lane.layout.abi == Abi.Unit,
    pointer: lane.layout.abi == Abi.Pointer, floating: lane.layout.abi == Abi.Floating, lanes: usize.ZERO, unionAlignment: usize.ZERO, head: usize.ZERO})
}

// The kind of a C signature's result: nothing for one returned indirectly, and one coerced piece.
effect fn cResultType(writer: &mut Writer, called: &CAbi.Signature) -> Kind ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let lane = &called.result
  if lane.passing == CPassing.Ignore || lane.passing == CPassing.Indirect || lane.layout.abi == Abi.Unit { return Kind.unit() }
  if lane.passing == CPassing.Coerce {
    let pieces = List<CPiece>.asSlice(&lane.pieces)
    if pieces.length != usize.ONE { run WasmObject.unsupported(b"a C result in several registers", Bytes.asSlice(&called.symbol)) }
    return run typeOf(&mut writer.*, pieceRepresentation(pieces[usize.ZERO]))
  }
  return run cParameterType(&mut writer.*, lane, usize.ZERO)
}

// The wasm type of a C signature: its result lane, a leading result address when the result is
// returned indirectly, and each parameter lane's parts. A variadic function takes its tail's
// block address last.
effect fn cFunctionType(writer: &mut Writer, called: &CAbi.Signature) -> Bytes ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let result = run cResultType(&mut writer.*, called)
  let mut types = List<Kind>.make()
  if called.result.passing == CPassing.Indirect { run List<Kind>.append(&mut types, run pointerType(&mut writer.*)) }
  let parameters = List<CAbi.Lane>.asSlice(&called.parameters)
  let mut at = usize.ZERO
  while at < parameters.length {
    let mut part = usize.ZERO
    while part < cParameterCount(&parameters[at]) {
      run List<Kind>.append(&mut types, run cParameterType(&mut writer.*, &parameters[at], part))
      part = part + usize.ONE
    }
    at = at + usize.ONE
  }
  if called.variadic { run List<Kind>.append(&mut types, run pointerType(&mut writer.*)) }
  let mut lanes = run List<WasmKind>.makeWithCapacity(List<Kind>.length(&types))
  let listed = List<Kind>.asSlice(&types)
  let mut lane = usize.ZERO
  while lane < listed.length {
    run List<WasmKind>.append(&mut lanes, WasmEmission.wasmKind(listed[lane], writer.pointerBits))
    lane = lane + usize.ONE
  }
  return run WasmBody.signatureOf(List<WasmKind>.asSlice(&lanes), WasmEmission.wasmKind(result, writer.pointerBits))
}

// Coercion registers can be wider than the final bytes of a record on AAPCS64. Load only the
// actual object bytes, then extend the register; never read beyond the source allocation.
effect fn loadCPiece(writer: &mut Writer, lane: &CAbi.Lane, part: CPiece, source: u64) -> Value
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let full = pieceRepresentation(part)
  let mut stored = full
  if part.abi == Abi.Integer && part.lanes == usize.ZERO && stored.bits > (lane.layout.size - part.offset) * 8 {
    stored.bits = (lane.layout.size - part.offset) * 8
  }
  let address = run byteOffset(&mut writer.*, source, part.offset)
  let loaded = Value {scalar: stored, value: run loadOf(&mut writer.*, stored, address, usize.ONE)}
  if stored.bits != full.bits { return run castOf(&mut writer.*, Cast.ZExt, &loaded, full) }
  return loaded
}

effect fn storeCPiece(writer: &mut Writer, lane: &CAbi.Lane, part: CPiece, value: u64, destination: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let full = pieceRepresentation(part)
  let mut stored = Value {scalar: full, value: value}
  if part.abi == Abi.Integer && part.lanes == usize.ZERO && full.bits > (lane.layout.size - part.offset) * 8 {
    let mut narrowed = full
    narrowed.bits = (lane.layout.size - part.offset) * 8
    stored = run castOf(&mut writer.*, Cast.Trunc, &stored, narrowed)
  }
  let address = run byteOffset(&mut writer.*, destination, part.offset)
  return run storeOf(&mut writer.*, stored.value, address, usize.ONE)
}

// Appends the coerced pieces of the record at `source` to `out`, one value each.
effect fn readCRecord(writer: &mut Writer, lane: &CAbi.Lane, source: u64, out: &mut List<u64>) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let parts = List<CPiece>.asSlice(&lane.pieces)
  let mut at = usize.ZERO
  while at < parts.length {
    let value = run loadCPiece(&mut writer.*, lane, parts[at], source)
    run List<u64>.append(&mut out.*, value.value)
    at = at + usize.ONE
  }
  return ()
}

// Stores the coerced pieces `values` into the record at `destination`.
effect fn writeCRecord(writer: &mut Writer, lane: &CAbi.Lane, values: &[u64], destination: u64) -> ()
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let parts = List<CPiece>.asSlice(&lane.pieces)
  let mut at = usize.ZERO
  while at < parts.length {
    run storeCPiece(&mut writer.*, lane, parts[at], values[at], destination)
    at = at + usize.ONE
  }
  return ()
}

effect fn classifiedLane(function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  ty: &Interned<Type>, span: Location, result: bool) -> CAbi.Lane
! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<CAbi.Lane>.Some {value} = move run CAbi.classify(ty, layouts, target, result) { return move value }
  return CompilerBug.panic(b"a C call passed check with a lane its classified C signature does not pass")
}

effect fn classifiedParameters(function: &MirFunction, target: &Target, layouts: &TypeLayouts,
  parameters: &[Interned<Type>], result: &CAbi.Lane, span: Location) -> List<CAbi.Lane>
! Gap | Unsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut lanes = List<CAbi.Lane>.make()
  let mut at = usize.ZERO
  while at < parameters.length {
    let lane = run classifiedLane(function, target, layouts, &parameters[at], span, false)
    if lane.layout.abi == Abi.Unit {
      return CompilerBug.panic(b"a `()` C parameter passed check")
    }
    run List<CAbi.Lane>.append(&mut lanes, move lane)
    at = at + usize.ONE
  }
  CAbi.assignArguments(&mut lanes, result, target)
  return move lanes
}


/// One statically evaluated C scalar that initializes an exported C object.
pub union ObjectConstant {
  Integer {pub negative: bool, pub magnitude: u64},
  /// Binary32 bits when `single`, otherwise binary64 bits.
  Float {pub bits: u64, pub single: bool},
}

// Widens binary32 `bits` exactly to binary64 when `single`.
fn binary64(bits: u64, single: bool) -> u64 {
  if single { return f64.toBits(f32.toF64(f32.fromBits(u64.toU32(bits)))) }
  return bits
}

// The two's complement bits of `magnitude`, negated when `negative`.
fn twosComplement(negative: bool, magnitude: u64) -> u64 {
  if negative { return u64.wrappingSubtract(0, magnitude) }
  return magnitude
}

/// Defines one exported C object as a fragment: an object of its value lane under its symbol,
/// initialized by `constant`. An import of the same C type is `foreignDeclarations` of this signature.
pub effect fn exportedObject(target: &Target, signature: &CAbi.Signature, constant: &ObjectConstant) -> Bytes
! Gap | OutOfMemoryError
? &mut Allocator {
  match move run Effect.result(exportedObjectChecked(target, signature, constant)) {
    Result<Bytes, Gap | Unsupported | OutOfMemoryError>.Success {value} => { return move value }
    Result<Bytes, Gap | Unsupported | OutOfMemoryError>.Failure {error} => match move error {
      Unsupported refused => { return run refusedFragment(move refused) }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

effect fn exportedObjectChecked(target: &Target, signature: &CAbi.Signature, constant: &ObjectConstant) -> Bytes
! Gap | Unsupported | OutOfMemoryError
? &mut Allocator {
  let pointer = match signature.result.layout.abi {
    Abi.Pointer => true
    _ => false
  }
  if pointer { return CompilerBug.panic(b"a C static passed check without a C object emission can read or define") }
  let mut writer = run writerFor(target, false)
  let size = signature.result.layout.size
  let mut bits = match &constant.* {
    ObjectConstant.Integer {negative, magnitude} => twosComplement(negative, magnitude)
    ObjectConstant.Float {bits, single} => binary64(bits, single)
  }
  if let ObjectConstant.Float {..} = &constant.* {
    if size == 4 { bits = singleBits(bits) }
  }
  let mut image = run Bytes.zeroed(size)
  writeWord(&mut image, usize.ZERO, size, bits)
  run defineObject(&mut writer, Bytes.asSlice(&signature.symbol), signature.result.layout.alignment, move image, List<ObjectPointer>.make(), false, false)
  return run writer.fragment.encode()
}

/// Declares signatures only, each as its own fragment: a C function a WebAssembly import provides
/// is an import of its module and field, and a C object is recorded as declared
/// (`WasmObject.Fragment.declaredObjects`). Any other C symbol is left to the link, which refuses a
/// program that needs one, since the direct backend links no C code.
pub effect fn foreignDeclarations(target: &Target, foreign: &[CAbi.Signature]) -> List<Declaration>
! Gap | OutOfMemoryError
? &mut Allocator {
  let mut output = List<Declaration>.make()
  let mut at = usize.ZERO
  while at < foreign.length {
    let signature = &foreign[at]
    if signature.variadic && (signature.global || List<CAbi.Lane>.length(&signature.parameters) == usize.ZERO) {
      return CompilerBug.panic(b"a C variadic call passed check with a tail its C promotion does not cover")
    }
    let mut writer = run writerFor(target, false)
    let mut text = Bytes.make()
    if signature.global {
      run List<Bytes>.append(&mut writer.fragment.declaredObjects, run Bytes.copy(Bytes.asSlice(&signature.symbol)))
    } else if Bytes.length(&signature.importModule) > usize.ZERO {
      match move run Effect.result(cFunctionType(&mut writer, signature)) {
        Result<Bytes, Unsupported | OutOfMemoryError>.Success {value: encoding} => {
          run List<WasmImport>.append(&mut writer.fragment.imports, WasmImport {symbol: run Bytes.copy(Bytes.asSlice(&signature.symbol)),
            signature: move encoding, module: run Bytes.copy(Bytes.asSlice(&signature.importModule)),
            name: run Bytes.copy(Bytes.asSlice(&signature.importName))})
        }
        Result<Bytes, Unsupported | OutOfMemoryError>.Failure {error} => match move error {
          Unsupported refused => { text = run refusedFragment(move refused) }
          OutOfMemoryError exhausted => { fail move exhausted }
        }
      }
    }
    if Bytes.length(&text) == usize.ZERO { text = run writer.fragment.encode() }
    run List<Declaration>.append(
      &mut output,
      Declaration {contract: run CAbi.identity(signature), symbol: run Bytes.copy(Bytes.asSlice(&signature.symbol)),
        text: move text},
    )
    at = at + usize.ONE
  }
  return move output
}

fn sameDeclarationRight(first: &DeclarationId, right: &Interned<DeclarationId>) -> bool {
  return Interned<DeclarationId>.with<bool>(
    right,
    fn(second: &DeclarationId) -> bool {
      return DeclarationId.equals(first, second)
    },
  )
}

// Marks the code emitted next as coming from `origin`, by its first token boundary in the
// declaration (`Mir.markerPosition`), and, in a build with line tables, by the line and column
// `MirFunction.lines` gives it, which the module's line table is made from.
effect fn locate(writer: &mut Writer, origin: Option<Origin>) -> () ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let position = Mir.markerPosition(origin)
  // A compiler-made statement has no authored position and keeps the last one.
  if position == usize.ZERO || position == writer.located { return () }
  writer.located = position
  let lines = List<u64>.asSlice(&writer.lines)
  let mut place: u64 = 0
  let mut low = usize.ZERO
  let mut high = lines.length / 2
  let wanted = usize.toU64(position)
  while low < high {
    let middle = low + (high - low) / 2
    let found = lines[middle * 2]
    if found == wanted {
      place = lines[middle * 2 + usize.ONE]
      break
    }
    if found < wanted { low = middle + usize.ONE } else { high = middle }
  }
  if place == 0 { return () }
  writer.function.locate(place)
  return ()
}
