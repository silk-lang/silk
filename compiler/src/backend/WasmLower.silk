//! WebAssembly adapter over target-neutral SSA lowering (`SsaLower`): encodes each lowered unit
//! as a `WasmObject.Fragment` of WebAssembly function bodies, data objects, and Wasm imports.
//!
//! # When to use
//! Use [`emit`] to lower one MIR definition to an encoded `WasmObject.Fragment`, [`declarations`]
//! for the shared runtime helpers, [`exportedObject`] for an exported C scalar static, and
//! [`foreignDeclarations`] for WebAssembly import and object declarations.

import CompilerBug
import backend.CAbi
import backend.CAbi {Passing as CPassing}
import backend.Coroutine {Facts}
import backend.Gap {Gap}
import backend.InstanceIdentity {InstanceIdentity}
import backend.Layout {TypeLayout}
import backend.Mir {MirFunction}
import backend.SsaFunction {Kind}
import backend.SsaLower
import backend.SsaLower {
  DataObject,
  DataPointer,
  Lowered,
  LoweredFunction,
  ObjectConstant as SsaObjectConstant,
  Unsupported as LowerUnsupported,
}
import backend.SsaPipeline {Level}
import backend.WasmBody
import backend.WasmBody {Kind as WasmKind}
import backend.WasmEmission
import backend.WasmObject {
  Fragment,
  Function as WasmFunction,
  Import as WasmImport,
  Object,
  Pointer as ObjectPointer,
  Unsupported as WasmUnsupported,
}
import semantic.Target {Target}
import semantic.Types {Types}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.u32
import silk.num.usize

/// One deduplicated declaration candidate owned by an instance answer; `text` is its fragment.
pub struct Declaration {
  pub contract: Bytes,
  pub symbol: Bytes,
  pub text: Bytes,
}

/// One statically evaluated C scalar that initializes an exported C object.
pub union ObjectConstant {
  Integer {pub negative: bool, pub magnitude: u64},
  /// Binary32 bits when `single`, otherwise binary64 bits.
  Float {pub bits: u64, pub single: bool},
}

// A fragment that records only the refusal `detail`.
effect fn refusedFragment(detail: Bytes) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut fragment = Fragment.make()
  run List<Bytes>.append(&mut fragment.refused, move detail)
  return run fragment.encode()
}

// Emits every prepared SSA function of `lowered` to WebAssembly and packages the bodies, data
// objects, and weak symbols into one encoded `WasmObject.Fragment`.
effect fn encodeLowered(lowered: &Lowered, shared: bool, trees: bool, simd128: bool) -> Bytes
! WasmUnsupported | OutOfMemoryError ? &mut Allocator {
  let mut fragment = Fragment.make()
  let functions = List<LoweredFunction>.asSlice(&lowered.functions)
  let mut at = usize.ZERO
  while at < functions.length {
    let translated = run WasmEmission.emit(&functions[at].function, shared, trees, simd128)
    run List<WasmFunction>.append(
      &mut fragment.functions,
      WasmFunction {body: move translated, exported: run Bytes.copy(Bytes.asSlice(&functions[at].exported))},
    )
    at = at + usize.ONE
  }
  let objects = List<DataObject>.asSlice(&lowered.objects)
  at = usize.ZERO
  while at < objects.length {
    let source = &objects[at]
    let sourcePointers = List<DataPointer>.asSlice(&source.pointers)
    let mut pointers = run List<ObjectPointer>.makeWithCapacity(sourcePointers.length)
    let mut ptrAt = usize.ZERO
    while ptrAt < sourcePointers.length {
      run List<ObjectPointer>.append(
        &mut pointers,
        ObjectPointer {
          offset: sourcePointers[ptrAt].offset,
          symbol: run Bytes.copy(Bytes.asSlice(&sourcePointers[ptrAt].symbol)),
          addend: sourcePointers[ptrAt].addend,
          size: sourcePointers[ptrAt].size,
        },
      )
      ptrAt = ptrAt + usize.ONE
    }
    run List<Object>.append(
      &mut fragment.objects,
      Object {
        symbol: run Bytes.copy(Bytes.asSlice(&source.symbol)),
        alignment: source.alignment,
        image: run Bytes.copy(Bytes.asSlice(&source.image)),
        pointers: move pointers,
        framed: source.framed,
        local: source.local,
        readonly: source.readonly,
      },
    )
    at = at + usize.ONE
  }
  let weak = List<Bytes>.asSlice(&lowered.weakObjects)
  at = usize.ZERO
  while at < weak.length {
    run List<Bytes>.append(&mut fragment.weakObjects, run Bytes.copy(Bytes.asSlice(&weak[at])))
    at = at + usize.ONE
  }
  return run fragment.encode()
}

/// Emits one MIR definition as an encoded `WasmObject.Fragment` of WebAssembly bodies and data
/// objects. A construct the Wasm direct backend cannot express leaves a fragment recording the
/// refusal (`WasmObject.Fragment.refused`).
pub effect fn emit(
  function: &MirFunction,
  target: &Target,
  supplied: &[TypeLayout],
  foreign: &[CAbi.Signature],
  identities: &[InstanceIdentity],
  suspension: &Option<Facts>,
  shared: bool,
  hostExport: bool,
  level: Level,
  verify: bool,
  simd128: bool,
) -> Bytes ! Gap | OutOfMemoryError ? &mut Allocator | &mut Types {
  match move run Effect.result(emitChecked(function, target, supplied, foreign, identities, suspension, shared, hostExport, level, verify, simd128)) {
    Result<Bytes, Gap | LowerUnsupported | WasmUnsupported | OutOfMemoryError>.Success {value} => { return move value }
    Result<Bytes, Gap | LowerUnsupported | WasmUnsupported | OutOfMemoryError>.Failure {error} => match move error {
      LowerUnsupported refused => { return run refusedFragment(move refused.detail) }
      WasmUnsupported refused => { return run refusedFragment(move refused.detail) }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

effect fn emitChecked(
  function: &MirFunction,
  target: &Target,
  supplied: &[TypeLayout],
  foreign: &[CAbi.Signature],
  identities: &[InstanceIdentity],
  suspension: &Option<Facts>,
  shared: bool,
  hostExport: bool,
  level: Level,
  verify: bool,
  simd128: bool,
) -> Bytes ! Gap | LowerUnsupported | WasmUnsupported | OutOfMemoryError ? &mut Allocator | &mut Types {
  let lowered = run SsaLower.lower(function, target, supplied, foreign, identities, suspension, shared, hostExport, level, verify, simd128)
  return run encodeLowered(&lowered, shared, level != Level.None, simd128)
}

/// Shared WebAssembly runtime helper definitions (`silk.diagnostic.fatal`, `__silk_guarded_reclaim`,
/// and frame-table walk helpers when `frames` is set), encoded as a `WasmObject.Fragment`.
pub effect fn declarations(target: &Target, shared: bool, frames: bool, verify: bool) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  match move run Effect.result(declarationsChecked(target, shared, frames, verify)) {
    Result<Bytes, LowerUnsupported | WasmUnsupported | OutOfMemoryError>.Success {value} => { return move value }
    Result<Bytes, LowerUnsupported | WasmUnsupported | OutOfMemoryError>.Failure {error} => match move error {
      LowerUnsupported refused => { return run refusedFragment(move refused.detail) }
      WasmUnsupported refused => { return run refusedFragment(move refused.detail) }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

effect fn declarationsChecked(target: &Target, shared: bool, frames: bool, verify: bool) -> Bytes
! LowerUnsupported | WasmUnsupported | OutOfMemoryError ? &mut Allocator {
  let lowered = run SsaLower.declarations(target, shared, frames, verify)
  return run encodeLowered(&lowered, shared, false, false)
}

/// Defines one exported C scalar object as an encoded `WasmObject.Fragment`.
pub effect fn exportedObject(target: &Target, signature: &CAbi.Signature, constant: &ObjectConstant) -> Bytes
! Gap | OutOfMemoryError ? &mut Allocator {
  let converted = match &constant.* {
    ObjectConstant.Integer {negative, magnitude} => SsaObjectConstant.Integer {negative: negative, magnitude: magnitude}
    ObjectConstant.Float {bits, single} => SsaObjectConstant.Float {bits: bits, single: single}
  }
  match move run Effect.result(exportedObjectChecked(target, signature, &converted)) {
    Result<Bytes, Gap | LowerUnsupported | WasmUnsupported | OutOfMemoryError>.Success {value} => { return move value }
    Result<Bytes, Gap | LowerUnsupported | WasmUnsupported | OutOfMemoryError>.Failure {error} => match move error {
      LowerUnsupported refused => { return run refusedFragment(move refused.detail) }
      WasmUnsupported refused => { return run refusedFragment(move refused.detail) }
      Gap gap => { fail move gap }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

effect fn exportedObjectChecked(target: &Target, signature: &CAbi.Signature, constant: &SsaObjectConstant) -> Bytes
! Gap | LowerUnsupported | WasmUnsupported | OutOfMemoryError ? &mut Allocator {
  let lowered = run SsaLower.exportedObject(target, signature, constant)
  return run encodeLowered(&lowered, false, false, false)
}

// The WebAssembly signature encoding of a C import declaration.
effect fn cFunctionType(pointerBits: usize, called: &CAbi.Signature, simd128: bool) -> Bytes
! LowerUnsupported | OutOfMemoryError ? &mut Allocator {
  let result = run SsaLower.cResultKinds(&called.result, pointerBits, false, Bytes.asSlice(&called.symbol))
  let mut types = List<Kind>.make()
  if called.result.passing == CPassing.Indirect { run List<Kind>.append(&mut types, Kind.address(pointerBits)) }
  let parameters = List<CAbi.Lane>.asSlice(&called.parameters)
  let mut at = usize.ZERO
  while at < parameters.length {
    let mut part = usize.ZERO
    while part < SsaLower.cParameterCount(&parameters[at]) {
      run List<Kind>.append(&mut types, SsaLower.cParameterKind(&parameters[at], part, pointerBits))
      part = part + usize.ONE
    }
    at = at + usize.ONE
  }
  if called.variadic { run List<Kind>.append(&mut types, Kind.address(pointerBits)) }
  let mut lanes = run List<WasmKind>.makeWithCapacity(List<Kind>.length(&types))
  let listed = List<Kind>.asSlice(&types)
  let mut lane = usize.ZERO
  while lane < listed.length {
    run List<WasmKind>.append(&mut lanes, WasmEmission.wasmKind(listed[lane], pointerBits, simd128))
    lane = lane + usize.ONE
  }
  return run WasmBody.signatureOf(List<WasmKind>.asSlice(&lanes), WasmEmission.wasmKind(result.first, pointerBits, simd128))
}

/// Declares signatures only, each as its own fragment: a C function a WebAssembly import provides
/// is an import of its module and field, and a C object is recorded as declared
/// (`WasmObject.Fragment.declaredObjects`). Any other C symbol is left to the link, which refuses a
/// program that needs one, since the direct backend links no C code.
pub effect fn foreignDeclarations(target: &Target, foreign: &[CAbi.Signature], simd128: bool) -> List<Declaration>
! Gap | OutOfMemoryError ? &mut Allocator {
  let pointerBits = u32.toUsize(Target.pointerBits(target))
  let mut output = List<Declaration>.make()
  let mut at = usize.ZERO
  while at < foreign.length {
    let signature = &foreign[at]
    if signature.variadic && (signature.global || List<CAbi.Lane>.length(&signature.parameters) == usize.ZERO) {
      return CompilerBug.panic(b"a C variadic call passed check with a tail its C promotion does not cover")
    }
    let mut fragment = Fragment.make()
    let mut text = Bytes.make()
    if signature.global {
      run List<Bytes>.append(&mut fragment.declaredObjects, run Bytes.copy(Bytes.asSlice(&signature.symbol)))
    } else if Bytes.length(&signature.importModule) > usize.ZERO {
      match move run Effect.result(cFunctionType(pointerBits, signature, simd128)) {
        Result<Bytes, LowerUnsupported | OutOfMemoryError>.Success {value: encoding} => {
          run List<WasmImport>.append(
            &mut fragment.imports,
            WasmImport {
              symbol: run Bytes.copy(Bytes.asSlice(&signature.symbol)),
              signature: move encoding,
              module: run Bytes.copy(Bytes.asSlice(&signature.importModule)),
              name: run Bytes.copy(Bytes.asSlice(&signature.importName)),
            },
          )
        }
        Result<Bytes, LowerUnsupported | OutOfMemoryError>.Failure {error} => match move error {
          LowerUnsupported refused => { text = run refusedFragment(move refused.detail) }
          OutOfMemoryError exhausted => { fail move exhausted }
        }
      }
    }
    if Bytes.length(&text) == usize.ZERO { text = run fragment.encode() }
    run List<Declaration>.append(
      &mut output,
      Declaration {
        contract: run CAbi.identity(signature),
        symbol: run Bytes.copy(Bytes.asSlice(&signature.symbol)),
        text: move text,
      },
    )
    at = at + usize.ONE
  }
  return move output
}
