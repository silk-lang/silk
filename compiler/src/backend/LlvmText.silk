//! LLVM IR text for one already-lowered MIR instance using demanded neutral layouts.

import backend.CAbi
import backend.CAbi {Extension as CExtension}
import backend.InstanceKey {InstanceKey}
import backend.InstanceIdentity {InstanceIdentity}
import backend.Layout {Abi, Field, Layout, Metrics, Sequence, Slice as SliceFacts, Tagged as TaggedFacts, TypeLayout}
import backend.Gap {Code as GapCode, Gap}
import backend.Mir {
  AggregateField,
  Block,
  Callee,
  ContextText,
  Diagnostics,
  FailureEdge,
  Local,
  LocalKind,
  MirFunction,
  Operand,
  Place,
  Projection,
  Rvalue,
  Statement,
  SwitchCase,
  Terminator,
}
import hir.Hir {InfixOperator, PrefixOperator}
import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId}
import semantic.Target {Target}
import semantic.Type {Type}
import semantic.TypedBody {Origin}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.pointer {Pointer}
import silk.shared {Shared}
import silk.option {Option}
import silk.u32
import silk.u64
import silk.u8
import silk.usize
import silk.vector {Vector}

struct Representation {
  aggregate: bool
  size: usize
  bits: usize
  signed: bool
  unit: bool
  pointer: bool
  floating: bool
}

impl Copy for Representation {}

struct Value {
  scalar: Representation
  text: Bytes
}

struct Writer {
  text: Bytes
  next: usize
  /// The defined function's symbol, which qualifies its private constants.
  symbol: Bytes
  /// Private constant definitions emitted before the function definition.
  constants: Bytes
}

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut at = usize.ZERO
  while at < a.length {
    if a[at] != b[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn scalar(ty: &Shared<Type>, target: &Target) -> Representation {
  return Shared.with<Type, Representation>(
    ty,
    fn(value: &Type) -> Representation {
      return match & value.* {
        Type.Reference {..} => Representation {aggregate: false, size: usize.ZERO,
          bits: u32.toUsize(Target.pointerBits(target)),
          signed: false,
          unit: false,
          pointer: true,
          floating: false,
        }
        Type.Pointer {..} => Representation {aggregate: false, size: usize.ZERO,
          bits: u32.toUsize(Target.pointerBits(target)),
          signed: false,
          unit: false,
          pointer: true,
          floating: false,
        }
        Type.Unit => Representation {aggregate: false, size: usize.ZERO, bits: usize.ZERO, signed: false, unit: true, pointer: false, floating: false}
        Type.Primitive {name} => {
          let word = Bytes.asSlice(&name)
          if same(word, b"bool") {
            return Representation {aggregate: false, size: usize.ZERO, bits: usize.ONE, signed: false, unit: false, pointer: false, floating: false}
          }
          let mut signed = false
          if word.length > usize.ZERO && word[usize.ZERO] == 105 {
            signed = true
          }
          let mut bits = usize.ZERO
          if same(word, b"i8") || same(word, b"u8") {
            bits = 8
          }
          if same(word, b"i16") || same(word, b"u16") {
            bits = 16
          }
          if same(word, b"i32") || same(word, b"u32") {
            bits = 32
          }
          if same(word, b"i64") || same(word, b"u64") {
            bits = 64
          }
          if same(word, b"isize") || same(word, b"usize") {
            bits = u32.toUsize(Target.pointerBits(target))
          }
          let floating = same(word, b"f32") || same(word, b"f64")
          if same(word, b"f32") {
            bits = 32
          }
          if same(word, b"f64") {
            bits = 64
          }
          return Representation {aggregate: false, size: usize.ZERO,
            bits: bits,
            signed: signed,
            unit: false,
            pointer: false,
            floating: floating,
          }
        }
        _ => Representation {aggregate: false, size: usize.ZERO, bits: usize.ZERO, signed: false, unit: false, pointer: false, floating: false}
      }
    },
  )
}

effect fn append(writer: &mut Writer, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  return run Bytes.append(&mut writer.*.text, bytes)
}

effect fn decimal(writer: &mut Writer, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut remaining = usize.toU64(value)
  let mut reversed = Bytes.make()
  if remaining == 0 {
    return run append(&mut writer.*, b"0")
  }
  while remaining > 0 {
    let digit = [u64.toU8(48 + u64.remainder(remaining, 10))]
    run Bytes.append(&mut reversed, &digit)
    remaining = u64.divide(remaining, 10)
  }
  let slice = Bytes.asSlice(&reversed)
  let mut at = slice.length
  while at > usize.ZERO {
    at = at - usize.ONE
    run append(&mut writer.*, &[slice[at]])
  }
  return ()
}

effect fn typeName(writer: &mut Writer, value: Representation) -> () ! OutOfMemoryError ? &mut Allocator {
  if value.aggregate {
    run append(&mut writer.*, b"[")
    run decimal(&mut writer.*, value.size)
    return run append(&mut writer.*, b" x i8]")
  }
  if value.pointer {
    return run append(&mut writer.*, b"ptr")
  }
  if value.unit {
    return run append(&mut writer.*, b"void")
  }
  if value.floating {
    if value.bits == 32 {
      return run append(&mut writer.*, b"float")
    }
    return run append(&mut writer.*, b"double")
  }
  run append(&mut writer.*, b"i")
  return run decimal(&mut writer.*, value.bits)
}

effect fn localName(writer: &mut Writer, index: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  run append(&mut writer.*, b"%l")
  return run decimal(&mut writer.*, index)
}

effect fn label(writer: &mut Writer, index: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  run append(&mut writer.*, b"b")
  return run decimal(&mut writer.*, index)
}

effect fn temp(writer: &mut Writer) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let index = writer.next
  writer.next = writer.next + usize.ONE
  let mut result = Writer {text: run Bytes.copy(b"%v"), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make()}
  run decimal(&mut result, index)
  return move result.text
}

// Defines one private constant holding `bytes` and returns its address.
effect fn staticBytes(writer: &mut Writer, bytes: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut name = Writer {text: run Bytes.copy(b"@"), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make()}
  run append(&mut name, Bytes.asSlice(&writer.symbol))
  run append(&mut name, b".bytes.")
  run decimal(&mut name, writer.next)
  writer.next = writer.next + usize.ONE
  let mut global = Writer {text: run Bytes.copy(Bytes.asSlice(&name.text)), next: usize.ZERO,
    symbol: Bytes.make(), constants: Bytes.make()}
  run append(&mut global, b" = private unnamed_addr constant [")
  run decimal(&mut global, bytes.length)
  run append(&mut global, b" x i8] c")
  run quoted(&mut global, bytes)
  run append(&mut global, b"\n")
  run Bytes.append(&mut writer.*.constants, Bytes.asSlice(&global.text))
  return move name.text
}

effect fn aggregateType(writer: &mut Writer, kind: Representation) -> () ! OutOfMemoryError ? &mut Allocator {
  run append(&mut writer.*, b"{ ")
  run typeName(&mut writer.*, kind)
  run append(&mut writer.*, b", i1 }")
  return ()
}

effect fn overflowIntrinsic(writer: &mut Writer, operation: &[u8], kind: Representation) -> ()
! OutOfMemoryError
? &mut Allocator {
  run append(&mut writer.*, b"@llvm.")
  if kind.signed {
    run append(&mut writer.*, b"s")
  } else {
    run append(&mut writer.*, b"u")
  }
  run append(&mut writer.*, operation)
  run append(&mut writer.*, b".with.overflow.")
  run typeName(&mut writer.*, kind)
  return ()
}

effect fn declareOverflow(writer: &mut Writer, operation: &[u8], kind: Representation) -> ()
! OutOfMemoryError
? &mut Allocator {
  run append(&mut writer.*, b"declare ")
  run aggregateType(&mut writer.*, kind)
  run append(&mut writer.*, b" ")
  run overflowIntrinsic(&mut writer.*, operation, kind)
  run append(&mut writer.*, b"(")
  run typeName(&mut writer.*, kind)
  run append(&mut writer.*, b", ")
  run typeName(&mut writer.*, kind)
  run append(&mut writer.*, b")\n")
  return ()
}

effect fn declareWidth(writer: &mut Writer, bits: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let signed = Representation {aggregate: false, size: usize.ZERO, bits: bits, signed: true, unit: false, pointer: false, floating: false}
  let unsigned = Representation {aggregate: false, size: usize.ZERO, bits: bits, signed: false, unit: false, pointer: false, floating: false}
  run declareOverflow(&mut writer.*, b"add", signed)
  run declareOverflow(&mut writer.*, b"sub", signed)
  run declareOverflow(&mut writer.*, b"mul", signed)
  run declareOverflow(&mut writer.*, b"add", unsigned)
  run declareOverflow(&mut writer.*, b"sub", unsigned)
  run declareOverflow(&mut writer.*, b"mul", unsigned)
  return ()
}

/// Shared module declarations are emitted once before the sorted function definitions.
pub effect fn declarations() -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut writer = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make()}
  run append(&mut writer, b"declare void @llvm.trap()\n")
  run declareWidth(&mut writer, 1)
  run declareWidth(&mut writer, 8)
  run declareWidth(&mut writer, 16)
  run declareWidth(&mut writer, 32)
  run declareWidth(&mut writer, 64)
  run append(&mut writer, b"\n")
  return move writer.text
}

effect fn trapWhen(writer: &mut Writer, condition: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let labelIndex = writer.next
  writer.next = writer.next + usize.ONE
  run append(&mut writer.*, b"br i1 ")
  run append(&mut writer.*, condition)
  run append(&mut writer.*, b", label %trap")
  run decimal(&mut writer.*, labelIndex)
  run append(&mut writer.*, b", label %safe")
  run decimal(&mut writer.*, labelIndex)
  run append(&mut writer.*, b"\ntrap")
  run decimal(&mut writer.*, labelIndex)
  run append(&mut writer.*, b":\ncall void @llvm.trap()\nunreachable\nsafe")
  run decimal(&mut writer.*, labelIndex)
  run append(&mut writer.*, b":\n")
  return ()
}

effect fn checkedBinary(writer: &mut Writer, operation: &[u8], lhs: &Value, rhs: &Value) -> Value
! OutOfMemoryError
? &mut Allocator {
  let aggregate = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&aggregate))
  run append(&mut writer.*, b" = call ")
  run aggregateType(&mut writer.*, lhs.scalar)
  run append(&mut writer.*, b" ")
  run overflowIntrinsic(&mut writer.*, operation, lhs.scalar)
  run append(&mut writer.*, b"(")
  run typeName(&mut writer.*, lhs.scalar)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&lhs.text))
  run append(&mut writer.*, b", ")
  run typeName(&mut writer.*, rhs.scalar)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&rhs.text))
  run append(&mut writer.*, b")\n")
  let result = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&result))
  run append(&mut writer.*, b" = extractvalue ")
  run aggregateType(&mut writer.*, lhs.scalar)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&aggregate))
  run append(&mut writer.*, b", 0\n")
  let overflow = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&overflow))
  run append(&mut writer.*, b" = extractvalue ")
  run aggregateType(&mut writer.*, lhs.scalar)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&aggregate))
  run append(&mut writer.*, b", 1\n")
  run trapWhen(&mut writer.*, Bytes.asSlice(&overflow))
  return Value {scalar: lhs.scalar, text: move result}
}

fn signedMinimum(bits: usize) -> &'static [u8] {
  if bits == 8 {
    return b"-128"
  }
  if bits == 16 {
    return b"-32768"
  }
  if bits == 32 {
    return b"-2147483648"
  }
  if bits == 64 {
    return b"-9223372036854775808"
  }
  return b""
}

effect fn guardedDivision(
  writer: &mut Writer,
  function: &MirFunction,
  lhs: &Value,
  rhs: &Value,
  remainder: bool,
  span: Span,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  let minimum = signedMinimum(lhs.scalar.bits)
  if lhs.scalar.signed && minimum.length == usize.ZERO {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.make(GapCode.ArithmeticTrap, &owner, span)
  }
  let zero = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&zero))
  run append(&mut writer.*, b" = icmp eq ")
  run typeName(&mut writer.*, rhs.scalar)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&rhs.text))
  run append(&mut writer.*, b", 0\n")
  let mut invalid = move zero
  if lhs.scalar.signed {
    let min = run temp(&mut writer.*)
    run append(&mut writer.*, Bytes.asSlice(&min))
    run append(&mut writer.*, b" = icmp eq ")
    run typeName(&mut writer.*, lhs.scalar)
    run append(&mut writer.*, b" ")
    run append(&mut writer.*, Bytes.asSlice(&lhs.text))
    run append(&mut writer.*, b", ")
    run append(&mut writer.*, minimum)
    run append(&mut writer.*, b"\n")
    let negativeOne = run temp(&mut writer.*)
    run append(&mut writer.*, Bytes.asSlice(&negativeOne))
    run append(&mut writer.*, b" = icmp eq ")
    run typeName(&mut writer.*, rhs.scalar)
    run append(&mut writer.*, b" ")
    run append(&mut writer.*, Bytes.asSlice(&rhs.text))
    run append(&mut writer.*, b", -1\n")
    let overflow = run temp(&mut writer.*)
    run append(&mut writer.*, Bytes.asSlice(&overflow))
    run append(&mut writer.*, b" = and i1 ")
    run append(&mut writer.*, Bytes.asSlice(&min))
    run append(&mut writer.*, b", ")
    run append(&mut writer.*, Bytes.asSlice(&negativeOne))
    run append(&mut writer.*, b"\n")
    let either = run temp(&mut writer.*)
    run append(&mut writer.*, Bytes.asSlice(&either))
    run append(&mut writer.*, b" = or i1 ")
    run append(&mut writer.*, Bytes.asSlice(&invalid))
    run append(&mut writer.*, b", ")
    run append(&mut writer.*, Bytes.asSlice(&overflow))
    run append(&mut writer.*, b"\n")
    invalid = move either
  }
  run trapWhen(&mut writer.*, Bytes.asSlice(&invalid))
  let result = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&result))
  run append(&mut writer.*, b" = ")
  if lhs.scalar.signed {
    run append(&mut writer.*, b"s")
  } else {
    run append(&mut writer.*, b"u")
  }
  if remainder {
    run append(&mut writer.*, b"rem ")
  } else {
    run append(&mut writer.*, b"div ")
  }
  run typeName(&mut writer.*, lhs.scalar)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&lhs.text))
  run append(&mut writer.*, b", ")
  run append(&mut writer.*, Bytes.asSlice(&rhs.text))
  run append(&mut writer.*, b"\n")
  return Value {scalar: lhs.scalar, text: move result}
}

struct Address {
  ty: Shared<Type>
  text: Bytes
  alignment: usize
  representation: Representation
}

struct Pointee {
  ty: Shared<Type>
  alignment: Option<u64>
}

effect fn layoutOf(layouts: &[TypeLayout], ty: &Shared<Type>, function: &MirFunction, span: Span) -> Metrics
! Gap | OutOfMemoryError
? &mut Allocator {
  let mut at = usize.ZERO
  while at < layouts.length {
    if run Type.runtimeEqualsShared(&layouts[at].ty, ty) {
      let facts = Shared.with<Layout, Metrics>(&layouts[at].layout, Layout.metrics)
      return facts
    }
    at = at + usize.ONE
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.ScalarLayout, &owner, span)
}

fn storageRepresentation(ty: &Shared<Type>, target: &Target, facts: Metrics) -> Representation {
  if facts.abi == Abi.Indirect {
    return Representation {aggregate: true, size: facts.size, bits: usize.ZERO,
      signed: false, unit: false, pointer: false, floating: false}
  }
  let written = scalar(ty, target)
  // A nominal integer (a scalar enum) is spelled from its neutral layout, never its declaration.
  if facts.abi == Abi.Integer && written.bits == usize.ZERO {
    return Representation {aggregate: false, size: usize.ZERO, bits: facts.size * 8,
      signed: false, unit: false, pointer: false, floating: false}
  }
  return written
}

effect fn fieldFact(layouts: &[TypeLayout], ty: &Shared<Type>, index: usize,
  function: &MirFunction, span: Span) -> Field ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < layouts.length {
    if run Type.runtimeEqualsShared(&layouts[at].ty, ty) {
      let selected = Shared.with<Layout, Option<Field>>(&layouts[at].layout,
        fn(layout: &Layout) -> Option<Field> { return Layout.fieldAt(layout, index) },
      )
      if let Option<Field>.Some {value} = move selected { return move value }
    }
    at = at + usize.ONE
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.PlaceProjection, &owner, span)
}

effect fn sequenceFact(layouts: &[TypeLayout], ty: &Shared<Type>, function: &MirFunction,
  span: Span) -> Sequence ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < layouts.length {
    if run Type.runtimeEqualsShared(&layouts[at].ty, ty) {
      let selected = Shared.with<Layout, Option<Sequence>>(&layouts[at].layout,
        fn(layout: &Layout) -> Option<Sequence> { return Layout.sequenceFacts(layout) },
      )
      if let Option<Sequence>.Some {value} = move selected { return move value }
    }
    at = at + usize.ONE
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.IndexProjection, &owner, span)
}

struct IndexFacts {
  element: Shared<Type>
  stride: usize
  borrowed: bool
}

fn indexFacts(layout: &Layout) -> Option<IndexFacts> {
  if let Option<Sequence>.Some {value: array} = move Layout.sequenceFacts(layout) {
    return Option.some<IndexFacts>(IndexFacts {element: move array.element, stride: array.stride, borrowed: false})
  }
  if let Option<SliceFacts>.Some {value: slice} = move Layout.sliceFacts(layout) {
    return Option.some<IndexFacts>(IndexFacts {element: move slice.element, stride: slice.stride, borrowed: true})
  }
  return Option.none<IndexFacts>()
}

effect fn indexedFact(layouts: &[TypeLayout], ty: &Shared<Type>, function: &MirFunction,
  span: Span) -> IndexFacts ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < layouts.length {
    if run Type.runtimeEqualsShared(&layouts[at].ty, ty) {
      let selected = Shared.with<Layout, Option<IndexFacts>>(&layouts[at].layout, indexFacts)
      if let Option<IndexFacts>.Some {value} = move selected { return move value }
    }
    at = at + usize.ONE
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.IndexProjection, &owner, span)
}

effect fn sliceFact(layouts: &[TypeLayout], ty: &Shared<Type>, function: &MirFunction,
  span: Span) -> SliceFacts ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < layouts.length {
    if run Type.runtimeEqualsShared(&layouts[at].ty, ty) {
      let selected = Shared.with<Layout, Option<SliceFacts>>(&layouts[at].layout, Layout.sliceFacts)
      if let Option<SliceFacts>.Some {value} = move selected { return move value }
    }
    at = at + usize.ONE
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.SliceLayout, &owner, span)
}

effect fn taggedFact(layouts: &[TypeLayout], ty: &Shared<Type>, function: &MirFunction,
  span: Span) -> TaggedFacts ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < layouts.length {
    if run Type.runtimeEqualsShared(&layouts[at].ty, ty) {
      let selected = Shared.with<Layout, Option<TaggedFacts>>(&layouts[at].layout, Layout.taggedFacts)
      if let Option<TaggedFacts>.Some {value} = move selected { return move value }
    }
    at = at + usize.ONE
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.UnionForm, &owner, span)
}

effect fn variantFieldFact(layouts: &[TypeLayout], ty: &Shared<Type>, variant: usize, field: usize,
  function: &MirFunction, span: Span) -> Field ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < layouts.length {
    if run Type.runtimeEqualsShared(&layouts[at].ty, ty) {
      let selected = Shared.with<Layout, Option<Field>>(&layouts[at].layout, fn(layout: &Layout) -> Option<Field> {
        return Layout.variantField(layout, variant, field)
      })
      if let Option<Field>.Some {value} = move selected { return move value }
    }
    at = at + usize.ONE
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.UnionForm, &owner, span)
}

fn tagRepresentation(facts: TaggedFacts) -> Representation {
  return Representation {aggregate: false, size: usize.ZERO, bits: facts.tagSize * 8,
    signed: false, unit: false, pointer: false, floating: false}
}

effect fn byteOffset(writer: &mut Writer, base: &[u8], offset: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let projected = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&projected))
  run append(&mut writer.*, b" = getelementptr i8, ptr ")
  run append(&mut writer.*, base)
  run append(&mut writer.*, b", i64 ")
  run decimal(&mut writer.*, offset)
  run append(&mut writer.*, b"\n")
  return move projected
}

// Layout alignments are powers of two. Offsets reduce the base guarantee without inventing one.
fn offsetAlignment(alignment: usize, offset: usize) -> usize {
  let mut guarantee = alignment
  while guarantee > usize.ONE && usize.remainder(offset, guarantee) != usize.ZERO {
    guarantee = guarantee / 2
  }
  return guarantee
}

effect fn projectField(writer: &mut Writer, function: &MirFunction, target: &Target,
  layouts: &[TypeLayout], base: &Address, index: usize, span: Span) -> Address
! Gap | OutOfMemoryError ? &mut Allocator {
  let field = run fieldFact(layouts, &base.ty, index, function, span)
  let name = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&name))
  run append(&mut writer.*, b" = getelementptr i8, ptr ")
  run append(&mut writer.*, Bytes.asSlice(&base.text))
  run append(&mut writer.*, b", i")
  run decimal(&mut writer.*, u32.toUsize(Target.pointerBits(target)))
  run append(&mut writer.*, b" ")
  run decimal(&mut writer.*, field.offset)
  run append(&mut writer.*, b"\n")
  let metrics = run layoutOf(layouts, &field.ty, function, span)
  let represented = storageRepresentation(&field.ty, target, metrics)
  return Address {ty: move field.ty, text: move name,
    alignment: offsetAlignment(base.alignment, field.offset), representation: represented}
}

effect fn memoryAlignment(writer: &mut Writer, alignment: usize) -> ()
! OutOfMemoryError
? &mut Allocator {
  run append(&mut writer.*, b", align ")
  run decimal(&mut writer.*, alignment)
  return run append(&mut writer.*, b"\n")
}

fn copiedAlignment(written: &Option<u64>) -> Option<u64> {
  return match & written.* {
    Option<u64>.Some {value: declaredAlignment} => Option.some<u64>(declaredAlignment)
    Option<u64>.None => Option.none<u64>()
  }
}

// Returns what a reference or pointer type points at, absent for any other type.
fn pointeeOf(ty: &Shared<Type>) -> Option<Pointee> {
  return Shared.with<Type, Option<Pointee>>(
    ty,
    fn(value: &Type) -> Option<Pointee> {
      return match & value.* {
        Type.Reference {referent, ..} => Option.some<Pointee>(
          Pointee {ty: Shared.clone<Type>(&referent), alignment: Option.none<u64>()},
        )
        Type.Pointer {pointee, alignment: written, ..} => Option.some<Pointee>(
          Pointee {ty: Shared.clone<Type>(&pointee), alignment: copiedAlignment(&written)},
        )
        _ => Option.none<Pointee>()
      }
    },
  )
}

// Returns what a dereferenced place points at, or rejects a place that is not a reference or pointer.
effect fn pointeeOrGap(function: &MirFunction, ty: &Shared<Type>, span: Span) -> Pointee
! Gap | OutOfMemoryError
? &mut Allocator {
  let pointee = pointeeOf(ty)
  let selected = match move pointee {
    Option<Pointee>.Some {value} => value
    Option<Pointee>.None => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.PlaceProjection, &owner, span)
    }
  }
  return move selected
}

effect fn emitPlace(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  place: &Place,
) -> Address ! Gap | OutOfMemoryError ? &mut Allocator {
  let locals = Vector.asSlice<Local>(&function.locals)
  let owner = InstanceKey.identity(&function.key)
  let span = locals[place.local].origin.span
  let mut ty = Shared.clone<Type>(&locals[place.local].ty)
  let rootLayout = run layoutOf(layouts, &ty, function, span)
  let mut alignment = rootLayout.alignment
  let mut named = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make()}
  run localName(&mut named, place.local)
  let mut address = move named.text
  let projections = Vector.asSlice<Projection>(&place.projections)
  let mut at = usize.ZERO
  while at < projections.length {
    match & projections[at] {
      Projection.Deref => {
        let selected = run pointeeOrGap(function, &ty, span)
        let loaded = run temp(&mut writer.*)
        run append(&mut writer.*, Bytes.asSlice(&loaded))
        run append(&mut writer.*, b" = load ptr, ptr ")
        run append(&mut writer.*, Bytes.asSlice(&address))
        run memoryAlignment(&mut writer.*, alignment)
        ty = move selected.ty
        let referentLayout = run layoutOf(layouts, &ty, function, span)
        alignment = match move selected.alignment {
          Option<u64>.Some {value} => u64.toUsize(value)
          Option<u64>.None => referentLayout.alignment
        }
        address = move loaded
      }
      Projection.Field {index} => {
        let facts = run layoutOf(layouts, &ty, function, span)
        let represented = storageRepresentation(&ty, target, facts)
        let base = Address {ty: Shared.clone<Type>(&ty), text: run Bytes.copy(Bytes.asSlice(&address)),
          alignment: alignment, representation: represented}
        let field = run projectField(&mut writer.*, function, target, layouts, &base, index, span)
        ty = move field.ty
        address = move field.text
        alignment = field.alignment
      }
      Projection.Index {local} => {
        let sequence = run indexedFact(layouts, &ty, function, span)
        if sequence.borrowed {
          let data = run temp(&mut writer.*)
          run append(&mut writer.*, Bytes.asSlice(&data))
          run append(&mut writer.*, b" = load ptr, ptr ")
          run append(&mut writer.*, Bytes.asSlice(&address))
          run memoryAlignment(&mut writer.*, alignment)
          address = move data
          let elementLayout = run layoutOf(layouts, &sequence.element, function, span)
          alignment = elementLayout.alignment
        }
        let indexPlace = Place {local: local, projections: Vector.make<Projection>()}
        let selectedIndex = run loadPlace(&mut writer.*, function, target, layouts, &indexPlace)
        let offset = run temp(&mut writer.*)
        run append(&mut writer.*, Bytes.asSlice(&offset))
        run append(&mut writer.*, b" = mul ")
        run typeName(&mut writer.*, selectedIndex.scalar)
        run append(&mut writer.*, b" ")
        run append(&mut writer.*, Bytes.asSlice(&selectedIndex.text))
        run append(&mut writer.*, b", ")
        run decimal(&mut writer.*, sequence.stride)
        run append(&mut writer.*, b"\n")
        let projected = run temp(&mut writer.*)
        run append(&mut writer.*, Bytes.asSlice(&projected))
        run append(&mut writer.*, b" = getelementptr i8, ptr ")
        run append(&mut writer.*, Bytes.asSlice(&address))
        run append(&mut writer.*, b", ")
        run typeName(&mut writer.*, selectedIndex.scalar)
        run append(&mut writer.*, b" ")
        run append(&mut writer.*, Bytes.asSlice(&offset))
        run append(&mut writer.*, b"\n")
        alignment = offsetAlignment(alignment, sequence.stride)
        ty = move sequence.element
        address = move projected
      }
      Projection.VariantField {variant, field} => {
        let selected = run variantFieldFact(layouts, &ty, variant, field, function, span)
        address = run byteOffset(&mut writer.*, Bytes.asSlice(&address), selected.offset)
        alignment = offsetAlignment(alignment, selected.offset)
        ty = move selected.ty
      }
      Projection.Payload {ty: member, ..} => {
        let facts = run taggedFact(layouts, &ty, function, span)
        address = run byteOffset(&mut writer.*, Bytes.asSlice(&address), facts.payloadOffset)
        alignment = offsetAlignment(alignment, facts.payloadOffset)
        ty = Shared.clone<Type>(&member)
      }
      Projection.ConstIndex {index} => {
        let sequence = run sequenceFact(layouts, &ty, function, span)
        if index >= sequence.count { fail Gap.make(GapCode.IndexProjection, &owner, span) }
        let facts = run layoutOf(layouts, &ty, function, span)
        let represented = storageRepresentation(&ty, target, facts)
        let base = Address {ty: Shared.clone<Type>(&ty), text: run Bytes.copy(Bytes.asSlice(&address)),
          alignment: alignment, representation: represented}
        let element = run projectField(&mut writer.*, function, target, layouts, &base, index, span)
        ty = move element.ty
        address = move element.text
        alignment = element.alignment
      }
    }
    at = at + usize.ONE
  }
  let finalLayout = run layoutOf(layouts, &ty, function, span)
  let kind = storageRepresentation(&ty, target, finalLayout)
  if !kind.unit && !kind.aggregate && kind.bits == usize.ZERO {
    fail Gap.make(GapCode.ScalarLayout, &owner, span)
  }
  return Address {ty: move ty, text: move address, alignment: alignment, representation: kind}
}

effect fn loadPlace(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  place: &Place,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  let address = run emitPlace(&mut writer.*, function, target, layouts, place)
  return run loadAddress(&mut writer.*, &address)
}

// Reuse the resolved address when an operation must validate its exact source type before loading.
effect fn loadAddress(writer: &mut Writer, address: &Address) -> Value
! OutOfMemoryError ? &mut Allocator {
  let kind = address.representation
  if kind.unit {
    return Value {scalar: kind, text: Bytes.make()}
  }
  let name = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&name))
  run append(&mut writer.*, b" = load ")
  run typeName(&mut writer.*, kind)
  run append(&mut writer.*, b", ptr ")
  run append(&mut writer.*, Bytes.asSlice(&address.text))
  run memoryAlignment(&mut writer.*, address.alignment)
  return Value {scalar: kind, text: move name}
}

effect fn emitOperand(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  operand: &Operand,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  return match & operand.* {
    Operand.Copy {place} => run loadPlace(&mut writer.*, function, target, layouts, &place)
    Operand.Move {place} => run loadPlace(&mut writer.*, function, target, layouts, &place)
    Operand.Integer {decimal: digits, negative, ty} => {
      let mut text = Bytes.make()
      if negative {
        run Bytes.append(&mut text, b"-")
      }
      run Bytes.append(&mut text, Bytes.asSlice(&digits))
      let mut kind = scalar(&ty, target)
      if kind.bits == usize.ZERO && !kind.unit {
        let facts = run layoutOf(layouts, &ty, function, Span.make(usize.ZERO, usize.ZERO))
        kind = storageRepresentation(&ty, target, facts)
      }
      return Value {scalar: kind, text: move text}
    }
    Operand.Float {bits, ty} => {
      let mut literal = Writer {text: run Bytes.copy(b"0x"), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make()}
      let digits = b"0123456789ABCDEF"
      let mut shift: u64 = 60
      while true {
        let digit = u64.toUsize(u64.bitAnd(u64.shiftRight(bits, shift), 15))
        run append(&mut literal, &[digits[digit]])
        if shift == 0 {
          break
        }
        shift = shift - 4
      }
      return Value {scalar: scalar(&ty, target), text: move literal.text}
    }
    Operand.Boolean {value} => {
      let mut text = run Bytes.copy(b"false")
      if value {
        text = run Bytes.copy(b"true")
      }
      return Value {
        scalar: Representation {aggregate: false, size: usize.ZERO, bits: usize.ONE, signed: false, unit: false, pointer: false, floating: false},
        text: move text,
      }
    }
    Operand.Unit => Value {
      scalar: Representation {aggregate: false, size: usize.ZERO, bits: usize.ZERO, signed: false, unit: true, pointer: false, floating: false},
      text: Bytes.make(),
    }
    Operand.Null {..} => Value {scalar: pointerRepresentation(target), text: run Bytes.copy(b"null")}
    Operand.StaticBytes {bytes} => Value {
      scalar: Representation {aggregate: false, size: usize.ZERO, bits: u32.toUsize(Target.pointerBits(target)),
        signed: false, unit: false, pointer: true, floating: false},
      text: run staticBytes(&mut writer.*, Bytes.asSlice(&bytes)),
    }
  }
}

effect fn emitArgument(writer: &mut Writer, function: &MirFunction, target: &Target,
  layouts: &[TypeLayout], operand: &Operand) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut place = Option.none<Address>()
  if let Operand.Copy {place: source} = &operand.* {
    place = Option.some<Address>(run emitPlace(&mut writer.*, function, target, layouts, &source))
  }
  if let Operand.Move {place: source} = &operand.* {
    place = Option.some<Address>(run emitPlace(&mut writer.*, function, target, layouts, &source))
  }
  if let Option<Address>.Some {value: address} = move place {
    if address.representation.aggregate {
      return Value {scalar: Representation {aggregate: false, size: usize.ZERO,
        bits: u32.toUsize(Target.pointerBits(target)), signed: false, unit: false, pointer: true, floating: false},
        text: move address.text}
    }
  }
  return run emitOperand(&mut writer.*, function, target, layouts, operand)
}

effect fn descriptorLengthAddress(writer: &mut Writer, target: &Target, base: &[u8], offset: usize) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let name = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&name))
  run append(&mut writer.*, b" = getelementptr i8, ptr ")
  run append(&mut writer.*, base)
  run append(&mut writer.*, b", i")
  run decimal(&mut writer.*, u32.toUsize(Target.pointerBits(target)))
  run append(&mut writer.*, b" ")
  run decimal(&mut writer.*, offset)
  run append(&mut writer.*, b"\n")
  return move name
}

fn lengthRepresentation(target: &Target) -> Representation {
  return Representation {aggregate: false, size: usize.ZERO, bits: u32.toUsize(Target.pointerBits(target)),
    signed: false, unit: false, pointer: false, floating: false}
}

// Selects the floating compare predicate for an operation, empty when it has none.
fn floatPredicate(operation: InfixOperator) -> &'static [u8] {
  return match operation {
    InfixOperator.Equals => b"oeq"
    InfixOperator.NotEquals => b"une"
    InfixOperator.LessThan => b"olt"
    InfixOperator.LessOrEqual => b"ole"
    InfixOperator.GreaterThan => b"ogt"
    InfixOperator.GreaterOrEqual => b"oge"
    _ => b""
  }
}

// Selects the integer compare or bitwise opcode for an operation, empty when it has none.
fn integerOpcode(operation: InfixOperator, signed: bool) -> &'static [u8] {
  match operation {
    InfixOperator.Equals => {
      return b" = icmp eq "
    }
    InfixOperator.NotEquals => {
      return b" = icmp ne "
    }
    InfixOperator.LessThan => {
      if signed { return b" = icmp slt " }
      return b" = icmp ult "
    }
    InfixOperator.LessOrEqual => {
      if signed { return b" = icmp sle " }
      return b" = icmp ule "
    }
    InfixOperator.GreaterThan => {
      if signed { return b" = icmp sgt " }
      return b" = icmp ugt "
    }
    InfixOperator.GreaterOrEqual => {
      if signed { return b" = icmp sge " }
      return b" = icmp uge "
    }
    InfixOperator.BitAnd => {
      return b" = and "
    }
    InfixOperator.And => {
      return b" = and "
    }
    InfixOperator.BitOr => {
      return b" = or "
    }
    InfixOperator.Or => {
      return b" = or "
    }
    InfixOperator.BitXor => {
      return b" = xor "
    }
    _ => {}
  }
  return b""
}

fn pointerRepresentation(target: &Target) -> Representation {
  return Representation {aggregate: false, size: usize.ZERO, bits: u32.toUsize(Target.pointerBits(target)),
    signed: false, unit: false, pointer: true, floating: false}
}

fn integerPrimitive(ty: &Shared<Type>, unsignedOnly: bool) -> bool {
  return Shared.with<Type, bool>(ty, fn(value: &Type) -> bool {
    if let Type.Primitive {name} = &value.* {
      let word = Bytes.asSlice(&name)
      if same(word, b"u8") || same(word, b"u16") || same(word, b"u32") || same(word, b"u64") || same(word, b"usize") { return true }
      if !unsignedOnly { return same(word, b"i8") || same(word, b"i16") || same(word, b"i32") || same(word, b"i64") || same(word, b"isize") }
    }
    return false
  })
}

// Unsigned widening admits actual integer primitives, not an enum or character's scalar storage.
effect fn emitUnsignedInteger(
  writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout], operand: &Operand, span: Span,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  match &operand.* {
    Operand.Copy {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      if integerPrimitive(&address.ty, true) { return run loadAddress(&mut writer.*, &address) }
    }
    Operand.Move {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      if integerPrimitive(&address.ty, true) { return run loadAddress(&mut writer.*, &address) }
    }
    Operand.Integer {ty, negative, ..} => {
      if !negative && integerPrimitive(&ty, true) { return run emitOperand(&mut writer.*, function, target, layouts, operand) }
    }
    _ => ()
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.TypedForm, &owner, span)
}

// Address transport admits the exact semantic word or data-pointer category, not a storage alias.
enum AddressLane { Unsupported, Pointer, Word }

fn addressLane(ty: &Shared<Type>) -> AddressLane {
  return Shared.with<Type, AddressLane>(ty, fn(value: &Type) -> AddressLane {
    return match &value.* {
      Type.Pointer {..} => AddressLane.Pointer
      Type.Primitive {name} => {
        if same(Bytes.asSlice(&name), b"usize") { return AddressLane.Word }
        return AddressLane.Unsupported
      }
      _ => AddressLane.Unsupported
    }
  })
}

effect fn emitAddressOperand(
  writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout],
  operand: &Operand, expected: AddressLane, span: Span,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  match &operand.* {
    Operand.Copy {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      if addressLane(&address.ty) == expected { return run loadAddress(&mut writer.*, &address) }
    }
    Operand.Move {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      if addressLane(&address.ty) == expected { return run loadAddress(&mut writer.*, &address) }
    }
    Operand.Integer {ty, negative, ..} => {
      if !negative && expected == AddressLane.Word && addressLane(&ty) == expected {
        return run emitOperand(&mut writer.*, function, target, layouts, operand)
      }
    }
    Operand.Null {ty} => {
      if expected == AddressLane.Pointer && addressLane(&ty) == expected {
        return run emitOperand(&mut writer.*, function, target, layouts, operand)
      }
    }
    _ => ()
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.TypedForm, &owner, span)
}

effect fn emitScalarRvalue(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  rvalue: &Rvalue,
  span: Span,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  return match & rvalue.* {
    Rvalue.SliceLength {place} => {
      let descriptor = run emitPlace(&mut writer.*, function, target, layouts, &place)
      let facts = run sliceFact(layouts, &descriptor.ty, function, span)
      let address = run descriptorLengthAddress(&mut writer.*, target, Bytes.asSlice(&descriptor.text), facts.lengthOffset)
      let name = run temp(&mut writer.*)
      let kind = lengthRepresentation(target)
      run append(&mut writer.*, Bytes.asSlice(&name))
      run append(&mut writer.*, b" = load ")
      run typeName(&mut writer.*, kind)
      run append(&mut writer.*, b", ptr ")
      run append(&mut writer.*, Bytes.asSlice(&address))
      run memoryAlignment(&mut writer.*, offsetAlignment(descriptor.alignment, facts.lengthOffset))
      return Value {scalar: kind, text: move name}
    }
    Rvalue.SliceData {place} => {
      let descriptor = run emitPlace(&mut writer.*, function, target, layouts, &place)
      let name = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&name))
      run append(&mut writer.*, b" = load ptr, ptr ")
      run append(&mut writer.*, Bytes.asSlice(&descriptor.text))
      run memoryAlignment(&mut writer.*, descriptor.alignment)
      return Value {scalar: pointerRepresentation(target), text: move name}
    }
    Rvalue.PointerOffset {pointer, index, element} => {
      let base = run emitOperand(&mut writer.*, function, target, layouts, &pointer)
      let selected = run emitOperand(&mut writer.*, function, target, layouts, &index)
      let facts = run layoutOf(layouts, &element, function, span)
      let stride = match move Metrics.stride(&facts) {
        Option<usize>.Some {value} => value
        Option<usize>.None => {
          let owner = InstanceKey.identity(&function.key)
          fail Gap.make(GapCode.ScalarLayout, &owner, span)
        }
      }
      let offset = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&offset))
      run append(&mut writer.*, b" = mul ")
      run typeName(&mut writer.*, selected.scalar)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&selected.text))
      run append(&mut writer.*, b", ")
      run decimal(&mut writer.*, stride)
      run append(&mut writer.*, b"\n")
      let name = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&name))
      run append(&mut writer.*, b" = getelementptr i8, ptr ")
      run append(&mut writer.*, Bytes.asSlice(&base.text))
      run append(&mut writer.*, b", ")
      run typeName(&mut writer.*, selected.scalar)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&offset))
      run append(&mut writer.*, b"\n")
      return Value {scalar: pointerRepresentation(target), text: move name}
    }
    Rvalue.Slice {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.TypedForm, &owner, span)
    }
    Rvalue.ContextOf {place} => Value {scalar: pointerRepresentation(target), text: run companionAddress(function, place.local)}
    // Stored by its statement, which retains the exact instance identity.
    Rvalue.FunctionAddress {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.TypedForm, &owner, span)
    }
    // Loaded by its statement, which retains the classified C object.
    Rvalue.ForeignStatic {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.TypedForm, &owner, span)
    }
    Rvalue.Ref {place, ..} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      return Value {
        scalar: Representation {aggregate: false, size: usize.ZERO,
          bits: u32.toUsize(Target.pointerBits(target)),
          signed: false,
          unit: false,
          pointer: true,
          floating: false,
        },
        text: move address.text,
      }
    }
    Rvalue.AddressOf {place, ..} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      return Value {
        scalar: Representation {aggregate: false, size: usize.ZERO,
          bits: u32.toUsize(Target.pointerBits(target)),
          signed: false,
          unit: false,
          pointer: true,
          floating: false,
        },
        text: move address.text,
      }
    }
    Rvalue.Aggregate {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.TypedForm, &owner, span)
    }
    Rvalue.Inject {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.TypedForm, &owner, span)
    }
    Rvalue.Variant {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.TypedForm, &owner, span)
    }
    Rvalue.Discriminant {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      let kind = tagRepresentation(run taggedFact(layouts, &address.ty, function, span))
      let name = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&name))
      run append(&mut writer.*, b" = load ")
      run typeName(&mut writer.*, kind)
      run append(&mut writer.*, b", ptr ")
      run append(&mut writer.*, Bytes.asSlice(&address.text))
      run memoryAlignment(&mut writer.*, address.alignment)
      return Value {scalar: kind, text: move name}
    }
    Rvalue.Use {value} => run emitOperand(&mut writer.*, function, target, layouts, &value)
    Rvalue.UnsignedWiden {value, ty} => {
      let input = run emitUnsignedInteger(&mut writer.*, function, target, layouts, &value, span)
      let output = scalar(&ty, target)
      if !integerPrimitive(&ty, false) || input.scalar.signed || input.scalar.bits >= output.bits {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.make(GapCode.TypedForm, &owner, span)
      }
      let name = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&name))
      run append(&mut writer.*, b" = zext ")
      run typeName(&mut writer.*, input.scalar)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&input.text))
      run append(&mut writer.*, b" to ")
      run typeName(&mut writer.*, output)
      run append(&mut writer.*, b"\n")
      return Value {scalar: output, text: move name}
    }
    Rvalue.AddressIntegerConversion {operand, destinationType} => {
      let lane = addressLane(&destinationType)
      // This primitive is native data-address transport, never Wasm linear-memory policy.
      if lane == AddressLane.Unsupported || same(Target.objectFormat(target), b"wasm") || Target.dataAddressSpace(target) != 0 {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.make(GapCode.TypedForm, &owner, span)
      }
      let mut expected = AddressLane.Pointer
      if lane == AddressLane.Pointer { expected = AddressLane.Word }
      let input = run emitAddressOperand(&mut writer.*, function, target, layouts, &operand, expected, span)
      let output = scalar(&destinationType, target)
      let bits = u32.toUsize(Target.pointerBits(target))
      if input.scalar.bits != bits || output.bits != bits {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.make(GapCode.TypedForm, &owner, span)
      }
      let name = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&name))
      if lane == AddressLane.Word { run append(&mut writer.*, b" = ptrtoint ") }
      else { run append(&mut writer.*, b" = inttoptr ") }
      run typeName(&mut writer.*, input.scalar)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&input.text))
      run append(&mut writer.*, b" to ")
      run typeName(&mut writer.*, output)
      run append(&mut writer.*, b"\n")
      return Value {scalar: output, text: move name}
    }
    Rvalue.Bitcast {value, ty} => {
      let input = run emitOperand(&mut writer.*, function, target, layouts, &value)
      let output = scalar(&ty, target)
      if input.scalar.bits != output.bits || input.scalar.floating == output.floating || input.scalar.pointer || output.pointer || input.scalar.unit || output.unit {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.make(GapCode.TypedForm, &owner, span)
      }
      let name = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&name))
      run append(&mut writer.*, b" = bitcast ")
      run typeName(&mut writer.*, input.scalar)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&input.text))
      run append(&mut writer.*, b" to ")
      run typeName(&mut writer.*, output)
      run append(&mut writer.*, b"\n")
      return Value {scalar: output, text: move name}
    }
    Rvalue.Unary {operation, value} => {
      let input = run emitOperand(&mut writer.*, function, target, layouts, &value)
      if input.scalar.floating || input.scalar.pointer {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.make(GapCode.TypedForm, &owner, span)
      }
      if operation == PrefixOperator.Negate {
        let zero = Value {scalar: input.scalar, text: run Bytes.copy(b"0")}
        return run checkedBinary(&mut writer.*, b"sub", &zero, &input)
      }
      let name = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&name))
      run append(&mut writer.*, b" = xor ")
      run typeName(&mut writer.*, input.scalar)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&input.text))
      run append(&mut writer.*, b", -1")
      run append(&mut writer.*, b"\n")
      return Value {scalar: input.scalar, text: move name}
    }
    Rvalue.Binary {operation, left, right} => {
      let lhs = run emitOperand(&mut writer.*, function, target, layouts, &left)
      let rhs = run emitOperand(&mut writer.*, function, target, layouts, &right)
      if lhs.scalar.floating {
        let predicate = floatPredicate(operation)
        if predicate.length == usize.ZERO {
          let owner = InstanceKey.identity(&function.key)
          fail Gap.make(GapCode.TypedForm, &owner, span)
        }
        let name = run temp(&mut writer.*)
        run append(&mut writer.*, Bytes.asSlice(&name))
        run append(&mut writer.*, b" = fcmp ")
        run append(&mut writer.*, predicate)
        run append(&mut writer.*, b" ")
        run typeName(&mut writer.*, lhs.scalar)
        run append(&mut writer.*, b" ")
        run append(&mut writer.*, Bytes.asSlice(&lhs.text))
        run append(&mut writer.*, b", ")
        run append(&mut writer.*, Bytes.asSlice(&rhs.text))
        run append(&mut writer.*, b"\n")
        return Value {
          scalar: Representation {aggregate: false, size: usize.ZERO,
            bits: usize.ONE,
            signed: false,
            unit: false,
            pointer: false,
            floating: false,
          },
          text: move name,
        }
      }
      if lhs.scalar.pointer {
        // Addresses compare only for identity, such as a null observer or cause (N4).
        if operation != InfixOperator.Equals && operation != InfixOperator.NotEquals {
          let owner = InstanceKey.identity(&function.key)
          fail Gap.make(GapCode.TypedForm, &owner, span)
        }
        let name = run temp(&mut writer.*)
        run append(&mut writer.*, Bytes.asSlice(&name))
        run append(&mut writer.*, integerOpcode(operation, false))
        run append(&mut writer.*, b"ptr ")
        run append(&mut writer.*, Bytes.asSlice(&lhs.text))
        run append(&mut writer.*, b", ")
        run append(&mut writer.*, Bytes.asSlice(&rhs.text))
        run append(&mut writer.*, b"\n")
        return Value {scalar: Representation {aggregate: false, size: usize.ZERO, bits: usize.ONE, signed: false, unit: false,
          pointer: false, floating: false}, text: move name}
      }
      match operation {
        InfixOperator.Add => {
          return run checkedBinary(&mut writer.*, b"add", &lhs, &rhs)
        }
        InfixOperator.Subtract => {
          return run checkedBinary(&mut writer.*, b"sub", &lhs, &rhs)
        }
        InfixOperator.Multiply => {
          return run checkedBinary(&mut writer.*, b"mul", &lhs, &rhs)
        }
        InfixOperator.Divide => {
          return run guardedDivision(&mut writer.*, function, &lhs, &rhs, false, span)
        }
        InfixOperator.Remainder => {
          return run guardedDivision(&mut writer.*, function, &lhs, &rhs, true, span)
        }
        _ => {}
      }
      let name = run temp(&mut writer.*)
      let comparison = operation == InfixOperator.Equals || operation == InfixOperator.NotEquals || operation == InfixOperator.LessThan || operation == InfixOperator.LessOrEqual || operation == InfixOperator.GreaterThan || operation == InfixOperator.GreaterOrEqual
      let opcode = integerOpcode(operation, lhs.scalar.signed)
      if opcode.length == usize.ZERO {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.make(GapCode.TypedForm, &owner, span)
      }
      run append(&mut writer.*, Bytes.asSlice(&name))
      run append(&mut writer.*, opcode)
      run typeName(&mut writer.*, lhs.scalar)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&lhs.text))
      run append(&mut writer.*, b", ")
      run append(&mut writer.*, Bytes.asSlice(&rhs.text))
      run append(&mut writer.*, b"\n")
      let mut kind = lhs.scalar
      if comparison {
        kind = Representation {aggregate: false, size: usize.ZERO, bits: usize.ONE, signed: false, unit: false, pointer: false, floating: false}
      }
      return Value {scalar: kind, text: move name}
    }
  }
}

effect fn storeValue(writer: &mut Writer, address: &Address, value: &Value) -> ()
! OutOfMemoryError ? &mut Allocator {
  if address.representation.unit { return () }
  run append(&mut writer.*, b"store ")
  run typeName(&mut writer.*, address.representation)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&value.text))
  run append(&mut writer.*, b", ptr ")
  run append(&mut writer.*, Bytes.asSlice(&address.text))
  return run memoryAlignment(&mut writer.*, address.alignment)
}

fn sameDeclaration(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  let firstAddress = Shared.with<DeclarationId, usize>(
    left,
    fn(id: &DeclarationId) -> usize {
      return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(id))
    },
  )
  let secondAddress = Shared.with<DeclarationId, usize>(
    right,
    fn(id: &DeclarationId) -> usize {
      return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(id))
    },
  )
  if firstAddress == secondAddress {
    return true
  }
  return Shared.with<DeclarationId, bool>(
    left,
    fn(id: &DeclarationId) -> bool {
      return sameDeclarationRight(id, right)
    },
  )
}

effect fn emitAssign(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  destination: &Place,
  value: &Rvalue,
  span: Span,
) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let address = run emitPlace(&mut writer.*, function, target, layouts, destination)
  if let Rvalue.Aggregate {fields} = &value.* {
    let operands = Vector.asSlice<AggregateField>(&fields)
    let mut fieldAt = usize.ZERO
    while fieldAt < operands.length {
      let selectedField = run projectField(&mut writer.*, function, target, layouts,
        &address, operands[fieldAt].index, span)
      let operand = run emitOperand(&mut writer.*, function, target, layouts, &operands[fieldAt].value)
      run storeValue(&mut writer.*, &selectedField, &operand)
      fieldAt = fieldAt + usize.ONE
    }
    return ()
  }
  if let Rvalue.Inject {tag, value: member} = &value.* {
    // The tag is stored first; the member is stored at the layout's payload offset.
    let facts = run taggedFact(layouts, &address.ty, function, span)
    run append(&mut writer.*, b"store ")
    run typeName(&mut writer.*, tagRepresentation(facts))
    run append(&mut writer.*, b" ")
    run decimal(&mut writer.*, tag)
    run append(&mut writer.*, b", ptr ")
    run append(&mut writer.*, Bytes.asSlice(&address.text))
    run memoryAlignment(&mut writer.*, address.alignment)
    let operand = run emitOperand(&mut writer.*, function, target, layouts, &member)
    let payload = run byteOffset(&mut writer.*, Bytes.asSlice(&address.text), facts.payloadOffset)
    let slot = Address {ty: Shared.clone<Type>(&address.ty), text: move payload,
      alignment: offsetAlignment(address.alignment, facts.payloadOffset), representation: operand.scalar}
    run storeValue(&mut writer.*, &slot, &operand)
    return ()
  }
  if let Rvalue.Variant {tag, fields} = &value.* {
    // The tag is stored first; each operand is stored at its variant field offset.
    let facts = run taggedFact(layouts, &address.ty, function, span)
    run append(&mut writer.*, b"store ")
    run typeName(&mut writer.*, tagRepresentation(facts))
    run append(&mut writer.*, b" ")
    run decimal(&mut writer.*, tag)
    run append(&mut writer.*, b", ptr ")
    run append(&mut writer.*, Bytes.asSlice(&address.text))
    run memoryAlignment(&mut writer.*, address.alignment)
    let operands = Vector.asSlice<AggregateField>(&fields)
    let mut fieldAt = usize.ZERO
    while fieldAt < operands.length {
      let selected = run variantFieldFact(layouts, &address.ty, tag, operands[fieldAt].index, function, span)
      let operand = run emitOperand(&mut writer.*, function, target, layouts, &operands[fieldAt].value)
      let fieldAddress = run byteOffset(&mut writer.*, Bytes.asSlice(&address.text), selected.offset)
      let slot = Address {ty: move selected.ty, text: move fieldAddress,
        alignment: offsetAlignment(address.alignment, selected.offset), representation: operand.scalar}
      run storeValue(&mut writer.*, &slot, &operand)
      fieldAt = fieldAt + usize.ONE
    }
    return ()
  }
  if let Rvalue.Slice {data, count} = &value.* {
    let facts = run sliceFact(layouts, &address.ty, function, span)
    let input = run emitOperand(&mut writer.*, function, target, layouts, &data)
    let length = run emitOperand(&mut writer.*, function, target, layouts, &count)
    let kind = length.scalar
    if !input.scalar.pointer || kind.aggregate || kind.pointer || kind.floating || kind.unit
      || kind.signed || kind.bits != lengthRepresentation(target).bits {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.SliceLayout, &owner, span)
    }
    run append(&mut writer.*, b"store ptr ")
    run append(&mut writer.*, Bytes.asSlice(&input.text))
    run append(&mut writer.*, b", ptr ")
    run append(&mut writer.*, Bytes.asSlice(&address.text))
    run memoryAlignment(&mut writer.*, address.alignment)
    let lengthAddress = run descriptorLengthAddress(&mut writer.*, target, Bytes.asSlice(&address.text), facts.lengthOffset)
    run append(&mut writer.*, b"store ")
    run typeName(&mut writer.*, lengthRepresentation(target))
    run append(&mut writer.*, b" ")
    run append(&mut writer.*, Bytes.asSlice(&length.text))
    run append(&mut writer.*, b", ptr ")
    run append(&mut writer.*, Bytes.asSlice(&lengthAddress))
    run memoryAlignment(&mut writer.*, offsetAlignment(address.alignment, facts.lengthOffset))
    return ()
  }
  let selected = run emitScalarRvalue(&mut writer.*, function, target, layouts, value, span)
  run storeValue(&mut writer.*, &address, &selected)
  return ()
}

effect fn emitReturn(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  span: Span,
) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let resultLayout = run layoutOf(layouts, &function.result, function, span)
  let kind = storageRepresentation(&function.result, target, resultLayout)
  let fallible = failureLocal(function) != usize.MAX
  if kind.unit {
    if fallible { run append(&mut writer.*, b"ret i1 0\n") }
    else { run append(&mut writer.*, b"ret void\n") }
    return ()
  }
  let returned = Operand.Copy {
    place: Place {local: usize.ZERO, projections: Vector.make<Projection>()},
  }
  let value = run emitOperand(&mut writer.*, function, target, layouts, &returned)
  // A fallible function returns its status and writes success to the caller's out-slot (D3).
  if fallible {
    let output = Address {ty: Shared.clone<Type>(&function.result), text: run Bytes.copy(b"%out"),
      alignment: resultLayout.alignment, representation: kind}
    run storeValue(&mut writer.*, &output, &value)
    run append(&mut writer.*, b"ret i1 0\n")
    return ()
  }
  if kind.aggregate {
    let output = Address {ty: Shared.clone<Type>(&function.result), text: run Bytes.copy(b"%out"),
      alignment: resultLayout.alignment, representation: kind}
    run storeValue(&mut writer.*, &output, &value)
    run append(&mut writer.*, b"ret void\n")
    return ()
  }
  run append(&mut writer.*, b"ret ")
  run typeName(&mut writer.*, kind)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&value.text))
  run append(&mut writer.*, b"\n")
  return ()
}

/// The `Provider` locals of a function in requirement-key order.
fn providerLocalAt(function: &MirFunction, index: usize) -> usize {
  let locals = Vector.asSlice<Local>(&function.locals)
  let mut at = usize.ZERO
  while at < locals.length {
    let found = match &locals[at].kind { LocalKind.Provider {index: own} => own == index _ => false }
    if found { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

/// The hidden `Observer` (0) or `Cause` (1) local, or `usize.MAX` when the program does not
/// observe diagnostics (failure observer note N1, N2).
fn diagnosticLocal(function: &MirFunction, wanted: usize) -> usize {
  let locals = Vector.asSlice<Local>(&function.locals)
  let mut at = usize.ZERO
  while at < locals.length {
    let kind = match &locals[at].kind {
      LocalKind.Observer => usize.ZERO
      LocalKind.Cause => usize.ONE
      _ => usize.MAX
    }
    if kind == wanted { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

// The address of failure slot `local`'s context companion: the caller's `%context` for the
// `Failure` local, else this function's own `%cN` (failure observer note N3).
effect fn companionAddress(function: &MirFunction, local: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  if local == failureLocal(function) { return run Bytes.copy(b"%context") }
  let mut name = Writer {text: run Bytes.copy(b"%c"), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make()}
  run decimal(&mut name, local)
  return move name.text
}

effect fn addLocal(listed: &mut Vector<usize>, local: usize, skipped: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if local == skipped { return () }
  let entries = Vector.asSlice<usize>(&listed.*)
  let mut at = usize.ZERO
  while at < entries.length {
    if entries[at] == local { return () }
    at = at + usize.ONE
  }
  return run Vector.append<usize>(&mut listed.*, local)
}

// The failure slots that own a companion: those a context statement, a selected cause or a
// call edge of a program that observes diagnostics names, except `Failure`.
effect fn companionLocals(function: &MirFunction) -> Vector<usize> ! OutOfMemoryError ? &mut Allocator {
  let skipped = failureLocal(function)
  let mut listed = Vector.make<usize>()
  let blocks = Vector.asSlice<Block>(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<Statement>(&blocks[at].statements)
    let mut statementAt = usize.ZERO
    while statementAt < statements.length {
      match &statements[statementAt] {
        Statement.FailureContext {destination, source, ..} => {
          run addLocal(&mut listed, destination.local, skipped)
          if let Option<Place>.Some {value: from} = &source { run addLocal(&mut listed, from.local, skipped) }
        }
        Statement.Assign {value, ..} => {
          if let Rvalue.ContextOf {place} = &value { run addLocal(&mut listed, place.local, skipped) }
        }
        _ => {}
      }
      statementAt = statementAt + usize.ONE
    }
    if let Terminator.Call {failure, diagnostics, ..} = &blocks[at].terminator {
      if let Option<FailureEdge>.Some {value: edge} = &failure {
        if let Option<Diagnostics>.Some {..} = &diagnostics { run addLocal(&mut listed, edge.destination.local, skipped) }
      }
    }
    at = at + usize.ONE
  }
  return move listed
}

// Stores one string descriptor `{address, length}` at `offset` of a companion.
effect fn storeText(writer: &mut Writer, companion: &[u8], offset: usize, word: usize, address: &[u8], length: &[u8]) -> ()
! OutOfMemoryError ? &mut Allocator {
  let data = run byteOffset(&mut writer.*, companion, offset)
  run append(&mut writer.*, b"store ptr ")
  run append(&mut writer.*, address)
  run append(&mut writer.*, b", ptr ")
  run append(&mut writer.*, Bytes.asSlice(&data))
  run append(&mut writer.*, b"\n")
  let size = run byteOffset(&mut writer.*, companion, offset + word)
  run append(&mut writer.*, b"store i")
  run decimal(&mut writer.*, word * 8)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, length)
  run append(&mut writer.*, b", ptr ")
  run append(&mut writer.*, Bytes.asSlice(&size))
  return run append(&mut writer.*, b"\n")
}

effect fn decimalText(value: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make()}
  run decimal(&mut text, value)
  return move text.text
}

// Writes a failure slot's companion `[identity, label]` (failure observer note N3): carried word by
// word from `source`'s, or originated from the function's context table, selecting a union's
// active member identity by its tag.
effect fn emitFailureContext(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout],
  destination: &Place, source: &Option<Place>, origin: Origin) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let word = u32.toUsize(Target.pointerBits(target)) / 8
  let into = run companionAddress(function, destination.local)
  if let Option<Place>.Some {value: from} = &source.* {
    let carried = run companionAddress(function, from.local)
    let mut part = usize.ZERO
    while part < 4 {
      let read = run byteOffset(&mut writer.*, Bytes.asSlice(&carried), part * word)
      let written = run byteOffset(&mut writer.*, Bytes.asSlice(&into), part * word)
      let value = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&value))
      run append(&mut writer.*, b" = load i")
      run decimal(&mut writer.*, word * 8)
      run append(&mut writer.*, b", ptr ")
      run append(&mut writer.*, Bytes.asSlice(&read))
      run append(&mut writer.*, b"\nstore i")
      run decimal(&mut writer.*, word * 8)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&value))
      run append(&mut writer.*, b", ptr ")
      run append(&mut writer.*, Bytes.asSlice(&written))
      run append(&mut writer.*, b"\n")
      part = part + usize.ONE
    }
    return ()
  }
  let texts = Vector.asSlice<ContextText>(&function.contexts)
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < texts.length && found == usize.MAX {
    if texts[at].origin.syntax.index == origin.syntax.index && texts[at].origin.span.start == origin.span.start { found = at }
    at = at + usize.ONE
  }
  if found == usize.MAX {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.make(GapCode.TypedForm, &owner, origin.span)
  }
  let identities = Vector.asSlice<Bytes>(&texts[found].identities)
  let mut address = run staticBytes(&mut writer.*, Bytes.asSlice(&identities[usize.ZERO]))
  let mut length = run decimalText(Bytes.length(&identities[usize.ZERO]))
  if identities.length > usize.ONE {
    // The active member's tag selects its identity.
    let slot = run emitPlace(&mut writer.*, function, target, layouts, destination)
    let kind = tagRepresentation(run taggedFact(layouts, &slot.ty, function, origin.span))
    let tag = run temp(&mut writer.*)
    run append(&mut writer.*, Bytes.asSlice(&tag))
    run append(&mut writer.*, b" = load ")
    run typeName(&mut writer.*, kind)
    run append(&mut writer.*, b", ptr ")
    run append(&mut writer.*, Bytes.asSlice(&slot.text))
    run append(&mut writer.*, b"\n")
    let mut member = usize.ONE
    while member < identities.length {
      let candidate = run staticBytes(&mut writer.*, Bytes.asSlice(&identities[member]))
      let matched = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&matched))
      run append(&mut writer.*, b" = icmp eq ")
      run typeName(&mut writer.*, kind)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&tag))
      run append(&mut writer.*, b", ")
      run decimal(&mut writer.*, member)
      run append(&mut writer.*, b"\n")
      let selected = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&selected))
      run append(&mut writer.*, b" = select i1 ")
      run append(&mut writer.*, Bytes.asSlice(&matched))
      run append(&mut writer.*, b", ptr ")
      run append(&mut writer.*, Bytes.asSlice(&candidate))
      run append(&mut writer.*, b", ptr ")
      run append(&mut writer.*, Bytes.asSlice(&address))
      run append(&mut writer.*, b"\n")
      let measured = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&measured))
      run append(&mut writer.*, b" = select i1 ")
      run append(&mut writer.*, Bytes.asSlice(&matched))
      run append(&mut writer.*, b", i")
      run decimal(&mut writer.*, word * 8)
      run append(&mut writer.*, b" ")
      run decimal(&mut writer.*, Bytes.length(&identities[member]))
      run append(&mut writer.*, b", i")
      run decimal(&mut writer.*, word * 8)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&length))
      run append(&mut writer.*, b"\n")
      address = move selected
      length = move measured
      member = member + usize.ONE
    }
  }
  run storeText(&mut writer.*, Bytes.asSlice(&into), usize.ZERO, word, Bytes.asSlice(&address), Bytes.asSlice(&length))
  let label = run staticBytes(&mut writer.*, Bytes.asSlice(&texts[found].label))
  let labelLength = run decimalText(Bytes.length(&texts[found].label))
  return run storeText(&mut writer.*, Bytes.asSlice(&into), word + word, word, Bytes.asSlice(&label), Bytes.asSlice(&labelLength))
}

/// The `Failure` local of a fallible function, or `usize.MAX` when it cannot fail.
fn failureLocal(function: &MirFunction) -> usize {
  let locals = Vector.asSlice<Local>(&function.locals)
  let mut at = usize.ZERO
  while at < locals.length {
    let failure = match &locals[at].kind { LocalKind.Failure => true _ => false }
    if failure { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

// `Fail` writes the failure value to the caller's failure out-slot and returns status 1 (D3).
effect fn emitFail(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout], span: Span) -> ()
! Gap | OutOfMemoryError ? &mut Allocator {
  let local = failureLocal(function)
  if local == usize.MAX {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.make(GapCode.TypedForm, &owner, span)
  }
  let locals = Vector.asSlice<Local>(&function.locals)
  let failureLayout = run layoutOf(layouts, &locals[local].ty, function, span)
  let kind = storageRepresentation(&locals[local].ty, target, failureLayout)
  if !kind.unit {
    let failed = Operand.Copy {place: Place {local: local, projections: Vector.make<Projection>()}}
    let value = run emitOperand(&mut writer.*, function, target, layouts, &failed)
    let output = Address {ty: Shared.clone<Type>(&locals[local].ty), text: run Bytes.copy(b"%fail"),
      alignment: failureLayout.alignment, representation: kind}
    run storeValue(&mut writer.*, &output, &value)
  }
  run append(&mut writer.*, b"ret i1 1\n")
  return ()
}

/// Returns the last foreign signature declared by `declaration`, or `usize.MAX` when none is.
fn foreignSignatureIndex(foreign: &[CAbi.Signature], declaration: &Shared<DeclarationId>) -> usize {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < foreign.length {
    if sameDeclaration(declaration, &foreign[at].declaration) {
      found = at
    }
    at = at + usize.ONE
  }
  return found
}

effect fn emitCall(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  foreign: &[CAbi.Signature],
  identities: &[InstanceIdentity],
  callee: &Callee,
  arguments: &Vector<Operand>,
  providers: &Vector<Operand>,
  diagnostics: &Option<Diagnostics>,
  destination: &Place,
  normal: usize,
  failure: &Option<FailureEdge>,
  span: Span,
) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut foreignIndex = usize.MAX
  if let Callee.Extern {declaration} = &callee.* {
    foreignIndex = foreignSignatureIndex(foreign, &declaration)
    if foreignIndex == usize.MAX {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.ForeignAbi, &owner, span)
    }
  }
  let output = run emitPlace(&mut writer.*, function, target, layouts, destination)
  let kind = output.representation
  // A fallible callee takes success and failure out-addresses after its arguments and returns a
  // status: 0 continues at `normal`, 1 at the failure edge (D3).
  let mut failed = Option.none<Address>()
  let mut context = Option.none<Bytes>()
  let mut handler = usize.MAX
  if let Option<FailureEdge>.Some {value: edge} = &failure.* {
    failed = Option.some<Address>(run emitPlace(&mut writer.*, function, target, layouts, &edge.destination))
    // In a program that observes diagnostics the callee also writes the destination's companion (N3).
    if let Option<Diagnostics>.Some {..} = &diagnostics.* {
      context = Option.some<Bytes>(run companionAddress(function, edge.destination.local))
    }
    handler = edge.target
  }
  let mut indirect = Option.none<Value>()
  if let Callee.Indirect {address} = &callee.* {
    indirect = Option.some<Value>(run emitOperand(&mut writer.*, function, target, layouts, &address))
  }
  let fallible = handler != usize.MAX
  // Provider addresses follow the written arguments (D2).
  let mut addresses = Vector.make<Value>()
  let hidden = Vector.asSlice<Operand>(providers)
  let mut providerAt = usize.ZERO
  while providerAt < hidden.length {
    run Vector.append<Value>(&mut addresses, run emitOperand(&mut writer.*, function, target, layouts, &hidden[providerAt]))
    providerAt = providerAt + usize.ONE
  }
  // An observed callee then takes the observer and selected-cause addresses (N1, N2).
  if let Option<Diagnostics>.Some {value: observed} = &diagnostics.* {
    run Vector.append<Value>(&mut addresses, run emitOperand(&mut writer.*, function, target, layouts, &observed.observer))
    run Vector.append<Value>(&mut addresses, run emitOperand(&mut writer.*, function, target, layouts, &observed.cause))
  }
  let values = Vector.asSlice<Operand>(arguments)
  let mut evaluated = Vector.make<Value>()
  let mut index = usize.ZERO
  while index < values.length {
    let value = run emitArgument(&mut writer.*, function, target, layouts, &values[index])
    if value.scalar.unit {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.UnitParameter, &owner, span)
    }
    run Vector.append<Value>(&mut evaluated, move value)
    index = index + usize.ONE
  }
  let mut returned = Bytes.make()
  if fallible || (!kind.unit && !kind.aggregate) {
    returned = run temp(&mut writer.*)
    run append(&mut writer.*, Bytes.asSlice(&returned))
    run append(&mut writer.*, b" = ")
  }
  run append(&mut writer.*, b"call ")
  if foreignIndex != usize.MAX {
    run extension(&mut writer.*, foreign[foreignIndex].result.extension)
    run laneType(&mut writer.*, &foreign[foreignIndex].result, &foreign[foreignIndex].declaration, span)
    run append(&mut writer.*, b" @")
    run quoted(&mut writer.*, Bytes.asSlice(&foreign[foreignIndex].symbol))
  } else if let Callee.Instance {key} = &callee.* {
    if fallible { run append(&mut writer.*, b"i1") }
    else if kind.aggregate { run append(&mut writer.*, b"void") }
    else { run typeName(&mut writer.*, kind) }
    run append(&mut writer.*, b" @")
    let symbol = run InstanceIdentity.name(identities, &key)
    run append(&mut writer.*, Bytes.asSlice(&symbol))
  } else if let Option<Value>.Some {value: address} = &indirect {
    if fallible { run append(&mut writer.*, b"i1") }
    else if kind.aggregate { run append(&mut writer.*, b"void") }
    else { run typeName(&mut writer.*, kind) }
    run append(&mut writer.*, b" ")
    run append(&mut writer.*, Bytes.asSlice(&address.text))
  }
  run append(&mut writer.*, b"(")
  let leadingOutput = kind.aggregate && !fallible
  if leadingOutput {
    run append(&mut writer.*, b"ptr ")
    run append(&mut writer.*, Bytes.asSlice(&output.text))
  }
  let prepared = Vector.asSlice<Value>(&evaluated)
  index = usize.ZERO
  while index < prepared.length {
    if index > usize.ZERO || leadingOutput {
      run append(&mut writer.*, b", ")
    }
    if foreignIndex != usize.MAX {
      let parameters = Vector.asSlice<CAbi.Lane>(&foreign[foreignIndex].parameters)
      if index >= parameters.length {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.make(GapCode.CAbiVariadic, &owner, span)
      }
      run laneType(&mut writer.*, &parameters[index], &foreign[foreignIndex].declaration, span)
      run append(&mut writer.*, b" ")
      run extension(&mut writer.*, parameters[index].extension)
    } else {
      run typeName(&mut writer.*, prepared[index].scalar)
      run append(&mut writer.*, b" ")
    }
    run append(&mut writer.*, Bytes.asSlice(&prepared[index].text))
    index = index + usize.ONE
  }
  let passed = Vector.asSlice<Value>(&addresses)
  providerAt = usize.ZERO
  while providerAt < passed.length {
    if prepared.length > usize.ZERO || providerAt > usize.ZERO || leadingOutput { run append(&mut writer.*, b", ") }
    run append(&mut writer.*, b"ptr ")
    run append(&mut writer.*, Bytes.asSlice(&passed[providerAt].text))
    providerAt = providerAt + usize.ONE
  }
  if let Option<Address>.Some {value: failureSlot} = &failed {
    if prepared.length > usize.ZERO || passed.length > usize.ZERO { run append(&mut writer.*, b", ") }
    run append(&mut writer.*, b"ptr ")
    run append(&mut writer.*, Bytes.asSlice(&output.text))
    run append(&mut writer.*, b", ptr ")
    run append(&mut writer.*, Bytes.asSlice(&failureSlot.text))
    if let Option<Bytes>.Some {value: companion} = &context {
      run append(&mut writer.*, b", ptr ")
      run append(&mut writer.*, Bytes.asSlice(&companion))
    }
  }
  run append(&mut writer.*, b")\n")
  if fallible {
    run append(&mut writer.*, b"br i1 ")
    run append(&mut writer.*, Bytes.asSlice(&returned))
    run append(&mut writer.*, b", label %")
    run label(&mut writer.*, handler)
    run append(&mut writer.*, b", label %")
    run label(&mut writer.*, normal)
    run append(&mut writer.*, b"\n")
    return ()
  }
  if !kind.unit && !kind.aggregate {
    let value = Value {scalar: kind, text: move returned}
    run storeValue(&mut writer.*, &output, &value)
  }
  run append(&mut writer.*, b"br label %")
  run label(&mut writer.*, normal)
  run append(&mut writer.*, b"\n")
  return ()
}

// Copies the current value of one classified C object into its destination place.
effect fn emitForeignStaticRead(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  foreign: &[CAbi.Signature],
  destination: &Place,
  declaration: &Shared<DeclarationId>,
  span: Span,
) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let index = foreignSignatureIndex(foreign, declaration)
  if index == usize.MAX || !foreign[index].global {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.make(GapCode.ForeignStatic, &owner, span)
  }
  let output = run emitPlace(&mut writer.*, function, target, layouts, destination)
  let mut symbol = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make()}
  run append(&mut symbol, b"@")
  run quoted(&mut symbol, Bytes.asSlice(&foreign[index].symbol))
  let object = Address {
    ty: Shared.clone<Type>(&output.ty),
    text: move symbol.text,
    alignment: foreign[index].result.layout.alignment,
    representation: output.representation,
  }
  let value = run loadAddress(&mut writer.*, &object)
  return run storeValue(&mut writer.*, &output, &value)
}

effect fn emitBlock(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  block: &Block,
  foreign: &[CAbi.Signature],
  identities: &[InstanceIdentity],
) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let statements = Vector.asSlice<Statement>(&block.statements)
  let locals = Vector.asSlice<Local>(&function.locals)
  let mut at = usize.ZERO
  while at < statements.length {
    match & statements[at] {
      Statement.Assign {destination, value, origin} => {
        match &value {
          // A callback's address is its emitted symbol (failure observer note N1).
          Rvalue.FunctionAddress {key} => {
            let address = run emitPlace(&mut writer.*, function, target, layouts, &destination)
            let symbol = run InstanceIdentity.name(identities, &key)
            run append(&mut writer.*, b"store ptr @")
            run append(&mut writer.*, Bytes.asSlice(&symbol))
            run append(&mut writer.*, b", ptr ")
            run append(&mut writer.*, Bytes.asSlice(&address.text))
            run append(&mut writer.*, b"\n")
          }
          Rvalue.ForeignStatic {declaration} => {
            run emitForeignStaticRead(&mut writer.*, function, target, layouts, foreign, &destination, &declaration, origin.span)
          }
          _ => { run emitAssign(&mut writer.*, function, target, layouts, &destination, &value, origin.span) }
        }
      }
      // A drop calls the glue of the place's type with the place's address (MIR core shape §3),
      // then the current observer and cause in a program that observes diagnostics.
      Statement.Drop {destination, glue, diagnostics, origin} => {
        let address = run emitPlace(&mut writer.*, function, target, layouts, &destination)
        let mut hidden = Vector.make<Value>()
        if let Option<Diagnostics>.Some {value: observed} = &diagnostics {
          run Vector.append<Value>(&mut hidden, run emitOperand(&mut writer.*, function, target, layouts, &observed.observer))
          run Vector.append<Value>(&mut hidden, run emitOperand(&mut writer.*, function, target, layouts, &observed.cause))
        }
        let symbol = run InstanceIdentity.name(identities, &glue)
        run append(&mut writer.*, b"call void @")
        run append(&mut writer.*, Bytes.asSlice(&symbol))
        run append(&mut writer.*, b"(ptr ")
        run append(&mut writer.*, Bytes.asSlice(&address.text))
        let passed = Vector.asSlice<Value>(&hidden)
        let mut hiddenAt = usize.ZERO
        while hiddenAt < passed.length {
          run append(&mut writer.*, b", ptr ")
          run append(&mut writer.*, Bytes.asSlice(&passed[hiddenAt].text))
          hiddenAt = hiddenAt + usize.ONE
        }
        run append(&mut writer.*, b")\n")
      }
      Statement.FailureContext {destination, source, origin} => {
        run emitFailureContext(&mut writer.*, function, target, layouts, &destination, &source, origin)
      }
    }
    at = at + usize.ONE
  }
  match & block.terminator {
    Terminator.Goto {target: next, origin: _} => {
      run append(&mut writer.*, b"br label %")
      run label(&mut writer.*, next)
      run append(&mut writer.*, b"\n")
    }
    Terminator.Branch {condition, thenBlock, elseBlock, origin: _} => {
      let tested = run emitOperand(&mut writer.*, function, target, layouts, &condition)
      run append(&mut writer.*, b"br i1 ")
      run append(&mut writer.*, Bytes.asSlice(&tested.text))
      run append(&mut writer.*, b", label %")
      run label(&mut writer.*, thenBlock)
      run append(&mut writer.*, b", label %")
      run label(&mut writer.*, elseBlock)
      run append(&mut writer.*, b"\n")
    }
    Terminator.Return {origin} => {
      run emitReturn(&mut writer.*, function, target, layouts, origin.span)
    }
    Terminator.Call {callee, arguments, providers, diagnostics, destination, normal, failure, origin} => {
      run emitCall(
        &mut writer.*,
        function,
        target,
        layouts,
        foreign,
        identities,
        &callee,
        &arguments,
        &providers,
        &diagnostics,
        &destination,
        normal,
        &failure,
        origin.span,
      )
    }
    Terminator.Fail {origin} => run emitFail(&mut writer.*, function, target, layouts, origin.span)
    Terminator.Trap {origin: _} => run append(&mut writer.*, b"call void @llvm.trap()\nunreachable\n")
    Terminator.Unreachable {origin: _} => run append(&mut writer.*, b"unreachable\n")
    Terminator.Switch {value, cases, otherwise, origin: _} => {
      let tested = run emitOperand(&mut writer.*, function, target, layouts, &value)
      run append(&mut writer.*, b"switch ")
      run typeName(&mut writer.*, tested.scalar)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&tested.text))
      run append(&mut writer.*, b", label %")
      run label(&mut writer.*, otherwise)
      run append(&mut writer.*, b" [")
      let selected = Vector.asSlice<SwitchCase>(&cases)
      let mut caseAt = usize.ZERO
      while caseAt < selected.length {
        run append(&mut writer.*, b" ")
        run typeName(&mut writer.*, tested.scalar)
        run append(&mut writer.*, b" ")
        if selected[caseAt].negative { run append(&mut writer.*, b"-") }
        run append(&mut writer.*, Bytes.asSlice(&selected[caseAt].decimal))
        run append(&mut writer.*, b", label %")
        run label(&mut writer.*, selected[caseAt].target)
        caseAt = caseAt + usize.ONE
      }
      run append(&mut writer.*, b" ]\n")
    }
  }
  return ()
}

/// Emits the entry-block stack slots for every local and spills each parameter into its slot.
effect fn emitEntrySlots(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let locals = Vector.asSlice<Local>(&function.locals)
  let parameters = Vector.asSlice<Shared<Type>>(&function.parameters)
  let mut local = usize.ZERO
  while local < locals.length {
    let localLayout = run layoutOf(
      layouts,
      &locals[local].ty,
      function,
      locals[local].origin.span,
    )
    let kind = storageRepresentation(&locals[local].ty, target, localLayout)
    if !kind.unit {
      run localName(&mut writer.*, local)
      run append(&mut writer.*, b" = alloca ")
      run typeName(&mut writer.*, kind)
      run memoryAlignment(&mut writer.*, localLayout.alignment)
    } else {
      run localName(&mut writer.*, local)
      run append(&mut writer.*, b" = alloca i8")
      run memoryAlignment(&mut writer.*, localLayout.alignment)
    }
    local = local + usize.ONE
  }
  local = usize.ZERO
  while local < parameters.length {
    let parameterLayout = run layoutOf(layouts, &parameters[local], function,
      locals[local + usize.ONE].origin.span)
    let kind = storageRepresentation(&parameters[local], target, parameterLayout)
    let mut parameterName = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make()}
    run append(&mut parameterName, b"%p")
    run decimal(&mut parameterName, local)
    let mut input = move parameterName.text
    if kind.aggregate {
      let copied = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&copied))
      run append(&mut writer.*, b" = load ")
      run typeName(&mut writer.*, kind)
      run append(&mut writer.*, b", ptr ")
      run append(&mut writer.*, Bytes.asSlice(&input))
      run memoryAlignment(&mut writer.*, parameterLayout.alignment)
      input = move copied
    }
    let mut addressName = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make()}
    run localName(&mut addressName, local + usize.ONE)
    let address = Address {ty: Shared.clone<Type>(&parameters[local]), text: move addressName.text,
      alignment: parameterLayout.alignment, representation: kind}
    let value = Value {scalar: kind, text: move input}
    run storeValue(&mut writer.*, &address, &value)
    local = local + usize.ONE
  }
  // Each hidden provider address lands in its `Provider` local.
  let mut provider = usize.ZERO
  while providerLocalAt(function, provider) != usize.MAX {
    let slot = providerLocalAt(function, provider)
    run append(&mut writer.*, b"store ptr %q")
    run decimal(&mut writer.*, provider)
    run append(&mut writer.*, b", ptr ")
    run localName(&mut writer.*, slot)
    run append(&mut writer.*, b"\n")
    provider = provider + usize.ONE
  }
  // Every failure slot except `Failure` owns a fixed-size context companion; `Failure`'s is the
  // caller's `%context` (failure observer note N3).
  let companions = run companionLocals(function)
  let owned = Vector.asSlice<usize>(&companions)
  let word = u32.toUsize(Target.pointerBits(target)) / 8
  let mut companionAt = usize.ZERO
  while companionAt < owned.length {
    run append(&mut writer.*, Bytes.asSlice(&run companionAddress(function, owned[companionAt])))
    run append(&mut writer.*, b" = alloca [4 x i")
    run decimal(&mut writer.*, word * 8)
    run append(&mut writer.*, b"], align ")
    run decimal(&mut writer.*, word)
    run append(&mut writer.*, b"\n")
    companionAt = companionAt + usize.ONE
  }
  // An observed function's observer and selected-cause addresses land in their locals (N1, N2).
  let observer = diagnosticLocal(function, usize.ZERO)
  if observer != usize.MAX {
    run append(&mut writer.*, b"store ptr %observer, ptr ")
    run localName(&mut writer.*, observer)
    run append(&mut writer.*, b"\nstore ptr %cause, ptr ")
    run localName(&mut writer.*, diagnosticLocal(function, usize.ONE))
    run append(&mut writer.*, b"\n")
  }
  return ()
}

/// Emits one definition; the caller sorts complete definitions before joining a module.
pub effect fn emit(
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  foreign: &[CAbi.Signature],
  identities: &[InstanceIdentity],
) -> Bytes ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut writer = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make()}
  let locals = Vector.asSlice<Local>(&function.locals)
  let resultFacts = run layoutOf(layouts, &function.result, function, locals[usize.ZERO].origin.span)
  let result = storageRepresentation(&function.result, target, resultFacts)
  let parameters = Vector.asSlice<Shared<Type>>(&function.parameters)
  let mut at = usize.ZERO
  while at < parameters.length {
    if scalar(&parameters[at], target).unit {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.UnitParameter, &owner, locals[at + usize.ONE].origin.span)
    }
    at = at + usize.ONE
  }
  let fallible = failureLocal(function) != usize.MAX
  // A C export shim keeps its requested linkage name and the C narrow-integer extension rules.
  let exported = match &function.key {
    InstanceKey.Export {..} => true
    _ => false
  }
  run append(&mut writer, b"define ")
  if exported { run cExtension(&mut writer, result) }
  if fallible { run append(&mut writer, b"i1") }
  else if result.aggregate { run append(&mut writer, b"void") }
  else { run typeName(&mut writer, result) }
  run append(&mut writer, b" @")
  let symbol = run InstanceIdentity.name(identities, &function.key)
  if exported { run quoted(&mut writer, Bytes.asSlice(&symbol)) }
  else { run append(&mut writer, Bytes.asSlice(&symbol)) }
  writer.symbol = move symbol
  run append(&mut writer, b"(")
  let leadingOutput = result.aggregate && !fallible
  if leadingOutput { run append(&mut writer, b"ptr %out") }
  at = usize.ZERO
  while at < parameters.length {
    if at > usize.ZERO || leadingOutput {
      run append(&mut writer, b", ")
    }
    let facts = run layoutOf(layouts, &parameters[at], function, locals[at + usize.ONE].origin.span)
    let lane = storageRepresentation(&parameters[at], target, facts)
    if facts.abi == Abi.Indirect { run append(&mut writer, b"ptr") }
    else { run typeName(&mut writer, lane) }
    run append(&mut writer, b" ")
    if exported { run cExtension(&mut writer, lane) }
    run append(&mut writer, b"%p")
    run decimal(&mut writer, at)
    at = at + usize.ONE
  }
  // Hidden provider addresses follow the written parameters (D2).
  let mut providerCount = usize.ZERO
  while providerLocalAt(function, providerCount) != usize.MAX {
    if parameters.length > usize.ZERO || providerCount > usize.ZERO || leadingOutput { run append(&mut writer, b", ") }
    run append(&mut writer, b"ptr %q")
    run decimal(&mut writer, providerCount)
    providerCount = providerCount + usize.ONE
  }
  let observed = diagnosticLocal(function, usize.ZERO) != usize.MAX
  if observed {
    if parameters.length > usize.ZERO || providerCount > usize.ZERO || leadingOutput { run append(&mut writer, b", ") }
    run append(&mut writer, b"ptr %observer, ptr %cause")
  }
  if fallible {
    if parameters.length > usize.ZERO || providerCount > usize.ZERO || observed { run append(&mut writer, b", ") }
    run append(&mut writer, b"ptr %out, ptr %fail")
    if observed { run append(&mut writer, b", ptr %context") }
  }
  run append(&mut writer, b") {\n")
  let blocks = Vector.asSlice<Block>(&function.blocks)
  at = usize.ZERO
  while at < blocks.length {
    run label(&mut writer, at)
    run append(&mut writer, b":\n")
    if at == usize.ZERO {
      run emitEntrySlots(&mut writer, function, target, layouts)
    }
    run emitBlock(&mut writer, function, target, layouts, &blocks[at], foreign, identities)
    at = at + usize.ONE
  }
  run append(&mut writer, b"}\n")
  run Bytes.append(&mut writer.constants, Bytes.asSlice(&writer.text))
  return move writer.constants
}

// The extension attribute, with its trailing space, that C requires of a narrow integer lane.
effect fn cExtension(writer: &mut Writer, lane: Representation) -> () ! OutOfMemoryError ? &mut Allocator {
  if lane.aggregate || lane.pointer || lane.floating || lane.unit || lane.bits == usize.ZERO || lane.bits >= 32 {
    return ()
  }
  if lane.signed { return run append(&mut writer.*, b"signext ") }
  return run append(&mut writer.*, b"zeroext ")
}

/// One deduplicated declaration candidate owned by an instance answer.
pub struct Declaration {
  pub symbol: Bytes
  pub text: Bytes
}

effect fn extension(writer: &mut Writer, rule: CExtension) -> () ! OutOfMemoryError ? &mut Allocator {
  return match rule {
    CExtension.None => ()
    CExtension.Signed => run append(&mut writer.*, b"signext ")
    CExtension.Unsigned => run append(&mut writer.*, b"zeroext ")
  }
}

effect fn laneType(writer: &mut Writer, lane: &CAbi.Lane, declaration: &Shared<DeclarationId>, span: Span) -> ()
! Gap | OutOfMemoryError
? &mut Allocator {
  match lane.layout.abi {
    Abi.Unit => {
      return run append(&mut writer.*, b"void")
    }
    Abi.Pointer => {
      return run append(&mut writer.*, b"ptr")
    }
    Abi.Floating => {
      if lane.layout.size == 4 {
        return run append(&mut writer.*, b"float")
      }
      return run append(&mut writer.*, b"double")
    }
    Abi.Integer => {}
    Abi.Indirect => {
      fail Gap.make(GapCode.CAbiAggregate, declaration, span)
    }
  }
  run append(&mut writer.*, b"i")
  return run decimal(&mut writer.*, lane.layout.size * 8)
}

// Writes `bytes` as one LLVM quoted string, escaping quotes, backslashes and nonprinting bytes.
effect fn quoted(writer: &mut Writer, bytes: &[u8]) -> ()
! OutOfMemoryError
? &mut Allocator {
  run append(&mut writer.*, b"\"")
  let digits = b"0123456789ABCDEF"
  let mut at = usize.ZERO
  while at < bytes.length {
    let byte = bytes[at]
    if byte >= 32 && byte < 127 && byte != 34 && byte != 92 {
      run append(&mut writer.*, &[byte])
    } else {
      run append(&mut writer.*, b"\\")
      run append(&mut writer.*, &[digits[u8.toUsize(byte / 16)], digits[u8.toUsize(byte % 16)]])
    }
    at = at + usize.ONE
  }
  return run append(&mut writer.*, b"\"")
}

/// Prints signatures only. The final join rejects conflicting native symbols.
pub effect fn foreignDeclarations(foreign: &[CAbi.Signature]) -> Vector<Declaration>
! Gap | OutOfMemoryError
? &mut Allocator {
  let mut output = Vector.make<Declaration>()
  let mut at = usize.ZERO
  while at < foreign.length {
    let signature = &foreign[at]
    let mut writer = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make()}
    if signature.global {
      // A C object is an external global of its value lane, defined by the C side.
      run append(&mut writer, b"@")
      run quoted(&mut writer, Bytes.asSlice(&signature.symbol))
      run append(&mut writer, b" = external global ")
      run laneType(&mut writer, &signature.result, &signature.declaration, signature.span)
      run append(&mut writer, b"\n")
      run Vector.append<Declaration>(
        &mut output,
        Declaration {symbol: run Bytes.copy(Bytes.asSlice(&signature.symbol)), text: move writer.text},
      )
      at = at + usize.ONE
      continue
    }
    run append(&mut writer, b"declare ")
    run extension(&mut writer, signature.result.extension)
    run laneType(&mut writer, &signature.result, &signature.declaration, signature.span)
    run append(&mut writer, b" @")
    run quoted(&mut writer, Bytes.asSlice(&signature.symbol))
    run append(&mut writer, b"(")
    let parameters = Vector.asSlice<CAbi.Lane>(&signature.parameters)
    let mut parameter = usize.ZERO
    while parameter < parameters.length {
      if parameter > usize.ZERO {
        run append(&mut writer, b", ")
      }
      run laneType(&mut writer, &parameters[parameter], &signature.declaration, signature.span)
      run append(&mut writer, b" ")
      run extension(&mut writer, parameters[parameter].extension)
      parameter = parameter + usize.ONE
    }
    run append(&mut writer, b")\n")
    run Vector.append<Declaration>(
      &mut output,
      Declaration {symbol: run Bytes.copy(Bytes.asSlice(&signature.symbol)), text: move writer.text},
    )
    at = at + usize.ONE
  }
  return move output
}

fn sameDeclarationRight(first: &DeclarationId, right: &Shared<DeclarationId>) -> bool {
  return Shared.with<DeclarationId, bool>(
    right,
    fn(second: &DeclarationId) -> bool {
      return DeclarationId.equals(first, second)
    },
  )
}
