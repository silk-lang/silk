//! LLVM IR text for one already-lowered MIR instance using demanded neutral layouts.

import backend.CAbi
import backend.CAbi {Extension as CExtension}
import backend.Coroutine {Coroutine, Extent, Facts, FrameSlot, State}
import backend.InstanceKey {HelperRole, InstanceKey}
import backend.InstanceIdentity {InstanceIdentity}
import backend.Layout {Abi, Field, Layout, Metrics, Sequence, Slice as SliceFacts, Tagged as TaggedFacts, TypeLayout}
import backend.Gap {Code as GapCode, Gap}
import backend.Mir {
  AggregateField,
  Block,
  Callee,
  ContextText,
  Diagnostics,
  FailureEdge,
  Local,
  LocalKind,
  MirFunction,
  Operand,
  Place,
  Projection,
  Rvalue,
  ScalarBinary,
  ScalarUnary,
  Statement,
  SwitchCase,
  Terminator,
  TrapSite,
}
import hir.Hir {InfixOperator, PrefixOperator}
import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId}
import semantic.NativeAssembly
import semantic.SealedCore
import semantic.SealedCore {Lifecycle}
import semantic.Target {Target}
import semantic.Type {Type}
import semantic.TypedBody {Origin}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.pointer {Pointer}
import silk.shared {Shared}
import silk.option {Option}
import silk.u32
import silk.u64
import silk.u8
import silk.usize
import silk.vector {Vector}

struct Representation {
  aggregate: bool
  size: usize
  bits: usize
  signed: bool
  unit: bool
  pointer: bool
  floating: bool
}

impl Copy for Representation {}

// An aggregate value is never a first-class SSA value: its text is the address of its bytes, and a
// store copies them with `llvm.memmove`. First-class `[N x i8]` loads and stores make LLVM's SROA,
// InstCombine and SLP passes scale with the byte count, which took certificate-path-validation's
// optimized build past two minutes.
struct Value {
  scalar: Representation
  text: Bytes
}

struct Writer {
  text: Bytes
  next: usize
  /// The defined function's symbol, which qualifies its private constants.
  symbol: Bytes
  /// Private constant definitions emitted before the function definition.
  constants: Bytes
  /// Where a trap emitted for the current statement reports to the current observer (event 6, N7).
  trap: Option<TrapReport>
}

/// An observed trap's report inputs: the observer and selected-cause local addresses, the site
/// label of the statement being emitted, and the target word width in bits.
struct TrapReport {
  observer: Bytes
  cause: Bytes
  label: Bytes
  bits: usize
}

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut at = usize.ZERO
  while at < a.length {
    if a[at] != b[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn scalar(ty: &Shared<Type>, target: &Target) -> Representation {
  return Shared.with<Type, Representation>(
    ty,
    fn(value: &Type) -> Representation {
      return match & value.* {
        Type.Reference {..} => Representation {aggregate: false, size: usize.ZERO,
          bits: u32.toUsize(Target.pointerBits(target)),
          signed: false,
          unit: false,
          pointer: true,
          floating: false,
        }
        Type.Pointer {..} => Representation {aggregate: false, size: usize.ZERO,
          bits: u32.toUsize(Target.pointerBits(target)),
          signed: false,
          unit: false,
          pointer: true,
          floating: false,
        }
        Type.Unit => Representation {aggregate: false, size: usize.ZERO, bits: usize.ZERO, signed: false, unit: true, pointer: false, floating: false}
        Type.Primitive {name} => {
          let word = Bytes.asSlice(&name)
          if same(word, b"bool") {
            return Representation {aggregate: false, size: usize.ZERO, bits: usize.ONE, signed: false, unit: false, pointer: false, floating: false}
          }
          let mut signed = false
          if word.length > usize.ZERO && word[usize.ZERO] == 105 {
            signed = true
          }
          let mut bits = usize.ZERO
          if same(word, b"i8") || same(word, b"u8") {
            bits = 8
          }
          if same(word, b"i16") || same(word, b"u16") {
            bits = 16
          }
          if same(word, b"i32") || same(word, b"u32") || same(word, b"char") {
            bits = 32
          }
          if same(word, b"i64") || same(word, b"u64") {
            bits = 64
          }
          if same(word, b"isize") || same(word, b"usize") {
            bits = u32.toUsize(Target.pointerBits(target))
          }
          let floating = same(word, b"f32") || same(word, b"f64")
          if same(word, b"f32") {
            bits = 32
          }
          if same(word, b"f64") {
            bits = 64
          }
          return Representation {aggregate: false, size: usize.ZERO,
            bits: bits,
            signed: signed,
            unit: false,
            pointer: false,
            floating: floating,
          }
        }
        _ => Representation {aggregate: false, size: usize.ZERO, bits: usize.ZERO, signed: false, unit: false, pointer: false, floating: false}
      }
    },
  )
}

effect fn append(writer: &mut Writer, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  return run Bytes.append(&mut writer.*.text, bytes)
}

effect fn decimal(writer: &mut Writer, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  return run unsignedDecimal(&mut writer.*, usize.toU64(value))
}

effect fn unsignedDecimal(writer: &mut Writer, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut remaining = value
  let mut reversed = Bytes.make()
  if remaining == 0 {
    return run append(&mut writer.*, b"0")
  }
  while remaining > 0 {
    let digit = [u64.toU8(48 + u64.remainder(remaining, 10))]
    run Bytes.append(&mut reversed, &digit)
    remaining = u64.divide(remaining, 10)
  }
  let slice = Bytes.asSlice(&reversed)
  let mut at = slice.length
  while at > usize.ZERO {
    at = at - usize.ONE
    run append(&mut writer.*, &[slice[at]])
  }
  return ()
}

effect fn typeName(writer: &mut Writer, value: Representation) -> () ! OutOfMemoryError ? &mut Allocator {
  if value.aggregate {
    run append(&mut writer.*, b"[")
    run decimal(&mut writer.*, value.size)
    return run append(&mut writer.*, b" x i8]")
  }
  if value.pointer {
    return run append(&mut writer.*, b"ptr")
  }
  if value.unit {
    return run append(&mut writer.*, b"void")
  }
  if value.floating {
    if value.bits == 32 {
      return run append(&mut writer.*, b"float")
    }
    return run append(&mut writer.*, b"double")
  }
  run append(&mut writer.*, b"i")
  return run decimal(&mut writer.*, value.bits)
}

// The overload suffix of an LLVM intrinsic name: `i32` for an integer and `f64` for `double`.
effect fn mangledType(writer: &mut Writer, value: Representation) -> () ! OutOfMemoryError ? &mut Allocator {
  if value.floating {
    run append(&mut writer.*, b"f")
    return run decimal(&mut writer.*, value.bits)
  }
  return run typeName(&mut writer.*, value)
}

effect fn localName(writer: &mut Writer, index: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  run append(&mut writer.*, b"%l")
  return run decimal(&mut writer.*, index)
}

effect fn label(writer: &mut Writer, index: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  run append(&mut writer.*, b"b")
  return run decimal(&mut writer.*, index)
}

effect fn temp(writer: &mut Writer) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let index = writer.next
  writer.next = writer.next + usize.ONE
  let mut result = Writer {text: run Bytes.copy(b"%v"), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
  run decimal(&mut result, index)
  return move result.text
}

// Defines one private constant holding `bytes` and returns its address.
effect fn staticBytes(writer: &mut Writer, bytes: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut name = Writer {text: run Bytes.copy(b"@"), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
  run append(&mut name, Bytes.asSlice(&writer.symbol))
  run append(&mut name, b".bytes.")
  run decimal(&mut name, writer.next)
  writer.next = writer.next + usize.ONE
  let mut global = Writer {text: run Bytes.copy(Bytes.asSlice(&name.text)), next: usize.ZERO,
    symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
  run append(&mut global, b" = private unnamed_addr constant [")
  run decimal(&mut global, bytes.length)
  run append(&mut global, b" x i8] c")
  run quoted(&mut global, bytes)
  run append(&mut global, b"\n")
  run Bytes.append(&mut writer.*.constants, Bytes.asSlice(&global.text))
  return move name.text
}

effect fn aggregateType(writer: &mut Writer, kind: Representation) -> () ! OutOfMemoryError ? &mut Allocator {
  run append(&mut writer.*, b"{ ")
  run typeName(&mut writer.*, kind)
  run append(&mut writer.*, b", i1 }")
  return ()
}

effect fn overflowIntrinsic(writer: &mut Writer, operation: &[u8], kind: Representation) -> ()
! OutOfMemoryError
? &mut Allocator {
  run append(&mut writer.*, b"@llvm.")
  if kind.signed {
    run append(&mut writer.*, b"s")
  } else {
    run append(&mut writer.*, b"u")
  }
  run append(&mut writer.*, operation)
  run append(&mut writer.*, b".with.overflow.")
  run typeName(&mut writer.*, kind)
  return ()
}

effect fn declareOverflow(writer: &mut Writer, operation: &[u8], kind: Representation) -> ()
! OutOfMemoryError
? &mut Allocator {
  run append(&mut writer.*, b"declare ")
  run aggregateType(&mut writer.*, kind)
  run append(&mut writer.*, b" ")
  run overflowIntrinsic(&mut writer.*, operation, kind)
  run append(&mut writer.*, b"(")
  run typeName(&mut writer.*, kind)
  run append(&mut writer.*, b", ")
  run typeName(&mut writer.*, kind)
  run append(&mut writer.*, b")\n")
  return ()
}

effect fn declareWidth(writer: &mut Writer, bits: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let signed = Representation {aggregate: false, size: usize.ZERO, bits: bits, signed: true, unit: false, pointer: false, floating: false}
  let unsigned = Representation {aggregate: false, size: usize.ZERO, bits: bits, signed: false, unit: false, pointer: false, floating: false}
  run declareOverflow(&mut writer.*, b"add", signed)
  run declareOverflow(&mut writer.*, b"sub", signed)
  run declareOverflow(&mut writer.*, b"mul", signed)
  run declareOverflow(&mut writer.*, b"add", unsigned)
  run declareOverflow(&mut writer.*, b"sub", unsigned)
  run declareOverflow(&mut writer.*, b"mul", unsigned)
  return ()
}

// Declares `iN @llvm.<name>.iN` over `count` operands of the same type.
effect fn declareUniform(writer: &mut Writer, name: &[u8], kind: Representation, count: usize) -> ()
! OutOfMemoryError
? &mut Allocator {
  run append(&mut writer.*, b"declare ")
  run typeName(&mut writer.*, kind)
  run append(&mut writer.*, b" @llvm.")
  run append(&mut writer.*, name)
  run append(&mut writer.*, b".")
  run mangledType(&mut writer.*, kind)
  run append(&mut writer.*, b"(")
  let mut at = usize.ZERO
  while at < count {
    if at != usize.ZERO { run append(&mut writer.*, b", ") }
    run typeName(&mut writer.*, kind)
    at = at + usize.ONE
  }
  run append(&mut writer.*, b")\n")
  return ()
}

// The rotate and saturating primitives of one integer width.
effect fn declareScalarWidth(writer: &mut Writer, bits: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let kind = Representation {aggregate: false, size: usize.ZERO, bits: bits, signed: false, unit: false, pointer: false, floating: false}
  run declareUniform(&mut writer.*, b"fshl", kind, 3)
  run declareUniform(&mut writer.*, b"fshr", kind, 3)
  run declareUniform(&mut writer.*, b"sadd.sat", kind, 2)
  run declareUniform(&mut writer.*, b"uadd.sat", kind, 2)
  run declareUniform(&mut writer.*, b"ssub.sat", kind, 2)
  run declareUniform(&mut writer.*, b"usub.sat", kind, 2)
  return ()
}

// The fatal dispatch helper an observed trap calls before trapping: event 6 with the selected
// cause's pool handle, or `0`, the trap reason and its site label (failure observer note N7). A
// null observer reports nothing.
effect fn defineFatalDispatch(writer: &mut Writer, target: &Target) -> () ! OutOfMemoryError ? &mut Allocator {
  let word = wordSize(target)
  let bits = word * 8
  run append(&mut writer.*, b"define internal void @\"silk.diagnostic.fatal\"(ptr %observer, ptr %cause, ptr %reason, ptr %origin) noinline cold {\n")
  run append(&mut writer.*, b"entry:\n%absent = icmp eq ptr %observer, null\nbr i1 %absent, label %done, label %report\n")
  run append(&mut writer.*, b"report:\n%callback = load ptr, ptr %observer\n%stateAddress = getelementptr i8, ptr %observer, i64 ")
  run decimal(&mut writer.*, word)
  run append(&mut writer.*, b"\n%state = load ptr, ptr %stateAddress\n%selected = icmp ne ptr %cause, null\n")
  run append(&mut writer.*, b"br i1 %selected, label %held, label %call\n")
  run append(&mut writer.*, b"held:\n%handleAddress = getelementptr i8, ptr %cause, i64 ")
  run decimal(&mut writer.*, companionHandleOffset(target))
  run append(&mut writer.*, b"\n%handle = load i")
  run decimal(&mut writer.*, bits)
  run append(&mut writer.*, b", ptr %handleAddress\nbr label %call\n")
  run append(&mut writer.*, b"call:\n%first = phi i")
  run decimal(&mut writer.*, bits)
  run append(&mut writer.*, b" [ 0, %report ], [ %handle, %held ]\n%answer = call i")
  run decimal(&mut writer.*, bits)
  run append(&mut writer.*, b" %callback(ptr %state, i8 6, i")
  run decimal(&mut writer.*, bits)
  run append(&mut writer.*, b" %first, i")
  run decimal(&mut writer.*, bits)
  run append(&mut writer.*, b" 0, ptr %reason, ptr %origin, ptr null, ptr null)\nbr label %done\n")
  run append(&mut writer.*, b"done:\nret void\n}\n")
  return ()
}

/// Shared module declarations are emitted once before the sorted function definitions.
pub effect fn declarations(target: &Target) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut writer = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
  run append(&mut writer, b"declare void @llvm.trap()\n")
  run defineFatalDispatch(&mut writer, target)
  run append(&mut writer, b"declare void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1)\n")
  run declareWidth(&mut writer, 1)
  run declareWidth(&mut writer, 8)
  run declareWidth(&mut writer, 16)
  run declareWidth(&mut writer, 32)
  run declareWidth(&mut writer, 64)
  run declareScalarWidth(&mut writer, 8)
  run declareScalarWidth(&mut writer, 16)
  run declareScalarWidth(&mut writer, 32)
  run declareScalarWidth(&mut writer, 64)
  let single = Representation {aggregate: false, size: usize.ZERO, bits: 32, signed: false, unit: false, pointer: false, floating: true}
  let double = Representation {aggregate: false, size: usize.ZERO, bits: 64, signed: false, unit: false, pointer: false, floating: true}
  run declareUniform(&mut writer, b"sqrt", single, usize.ONE)
  run declareUniform(&mut writer, b"sqrt", double, usize.ONE)
  run append(&mut writer, b"\n")
  return move writer.text
}

// Branches to a trap when `condition` holds. Under an observer, the trap first reports `reason` at
// the statement's site through the module's fatal dispatch helper (event 6, N7).
effect fn trapWhen(writer: &mut Writer, condition: &[u8], reason: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let labelIndex = writer.next
  writer.next = writer.next + usize.ONE
  run append(&mut writer.*, b"br i1 ")
  run append(&mut writer.*, condition)
  run append(&mut writer.*, b", label %trap")
  run decimal(&mut writer.*, labelIndex)
  run append(&mut writer.*, b", label %safe")
  run decimal(&mut writer.*, labelIndex)
  run append(&mut writer.*, b"\ntrap")
  run decimal(&mut writer.*, labelIndex)
  run append(&mut writer.*, b":\n")
  run reportTrap(&mut writer.*, reason)
  run append(&mut writer.*, b"call void @llvm.trap()\nunreachable\nsafe")
  run decimal(&mut writer.*, labelIndex)
  run append(&mut writer.*, b":\n")
  return ()
}

// Where a trap emitted for the statement at `origin` reports: the function's observer and cause
// locals with the statement's recorded site label, when the function observes (event 6, N7).
effect fn trapReport(function: &MirFunction, target: &Target, origin: Origin) -> Option<TrapReport>
! OutOfMemoryError ? &mut Allocator {
  let observer = diagnosticLocal(function, usize.ZERO)
  if observer == usize.MAX { return Option.none<TrapReport>() }
  let sites = Vector.asSlice<TrapSite>(&function.traps)
  let mut at = usize.ZERO
  while at < sites.length {
    if sites[at].origin.syntax.index == origin.syntax.index && sites[at].origin.span.start == origin.span.start {
      let mut observerName = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
      run localName(&mut observerName, observer)
      let mut causeName = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
      run localName(&mut causeName, diagnosticLocal(function, usize.ONE))
      return Option.some<TrapReport>(TrapReport {observer: move observerName.text, cause: move causeName.text,
        label: run Bytes.copy(Bytes.asSlice(&sites[at].label)), bits: wordSize(target) * 8})
    }
    at = at + usize.ONE
  }
  return Option.none<TrapReport>()
}

// Calls the fatal dispatch helper with the current observer and cause, when the statement has a
// recorded trap site.
effect fn reportTrap(writer: &mut Writer, reason: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let report = match &writer.trap {
    Option<TrapReport>.Some {value} => TrapReport {observer: run Bytes.copy(Bytes.asSlice(&value.observer)),
      cause: run Bytes.copy(Bytes.asSlice(&value.cause)), label: run Bytes.copy(Bytes.asSlice(&value.label)), bits: value.bits}
    Option<TrapReport>.None => { return () }
  }
  let reasonText = run staticString(&mut writer.*, reason, report.bits)
  let labelText = run staticString(&mut writer.*, Bytes.asSlice(&report.label), report.bits)
  let observer = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&observer))
  run append(&mut writer.*, b" = load ptr, ptr ")
  run append(&mut writer.*, Bytes.asSlice(&report.observer))
  run append(&mut writer.*, b"\n")
  let cause = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&cause))
  run append(&mut writer.*, b" = load ptr, ptr ")
  run append(&mut writer.*, Bytes.asSlice(&report.cause))
  run append(&mut writer.*, b"\ncall void @\"silk.diagnostic.fatal\"(ptr ")
  run append(&mut writer.*, Bytes.asSlice(&observer))
  run append(&mut writer.*, b", ptr ")
  run append(&mut writer.*, Bytes.asSlice(&cause))
  run append(&mut writer.*, b", ptr ")
  run append(&mut writer.*, Bytes.asSlice(&reasonText))
  run append(&mut writer.*, b", ptr ")
  run append(&mut writer.*, Bytes.asSlice(&labelText))
  run append(&mut writer.*, b")\n")
  return ()
}

// A private static `string<'static>` descriptor `{address, length}` for `bytes`.
effect fn staticString(writer: &mut Writer, bytes: &[u8], bits: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let data = run staticBytes(&mut writer.*, bytes)
  let mut name = Writer {text: run Bytes.copy(b"@"), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
  run append(&mut name, Bytes.asSlice(&writer.symbol))
  run append(&mut name, b".string.")
  run decimal(&mut name, writer.next)
  writer.next = writer.next + usize.ONE
  let mut global = Writer {text: run Bytes.copy(Bytes.asSlice(&name.text)), next: usize.ZERO,
    symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
  run append(&mut global, b" = private unnamed_addr constant { ptr, i")
  run decimal(&mut global, bits)
  run append(&mut global, b" } { ptr ")
  run append(&mut global, Bytes.asSlice(&data))
  run append(&mut global, b", i")
  run decimal(&mut global, bits)
  run append(&mut global, b" ")
  run decimal(&mut global, bytes.length)
  run append(&mut global, b" }\n")
  run Bytes.append(&mut writer.*.constants, Bytes.asSlice(&global.text))
  return move name.text
}

effect fn checkedBinary(writer: &mut Writer, operation: &[u8], lhs: &Value, rhs: &Value) -> Value
! OutOfMemoryError
? &mut Allocator {
  let aggregate = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&aggregate))
  run append(&mut writer.*, b" = call ")
  run aggregateType(&mut writer.*, lhs.scalar)
  run append(&mut writer.*, b" ")
  run overflowIntrinsic(&mut writer.*, operation, lhs.scalar)
  run append(&mut writer.*, b"(")
  run typeName(&mut writer.*, lhs.scalar)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&lhs.text))
  run append(&mut writer.*, b", ")
  run typeName(&mut writer.*, rhs.scalar)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&rhs.text))
  run append(&mut writer.*, b")\n")
  let result = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&result))
  run append(&mut writer.*, b" = extractvalue ")
  run aggregateType(&mut writer.*, lhs.scalar)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&aggregate))
  run append(&mut writer.*, b", 0\n")
  let overflow = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&overflow))
  run append(&mut writer.*, b" = extractvalue ")
  run aggregateType(&mut writer.*, lhs.scalar)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&aggregate))
  run append(&mut writer.*, b", 1\n")
  run trapWhen(&mut writer.*, Bytes.asSlice(&overflow), b"arithmetic overflow")
  return Value {scalar: lhs.scalar, text: move result}
}

fn signedMinimum(bits: usize) -> &'static [u8] {
  if bits == 8 {
    return b"-128"
  }
  if bits == 16 {
    return b"-32768"
  }
  if bits == 32 {
    return b"-2147483648"
  }
  if bits == 64 {
    return b"-9223372036854775808"
  }
  return b""
}

effect fn guardedDivision(
  writer: &mut Writer,
  function: &MirFunction,
  lhs: &Value,
  rhs: &Value,
  remainder: bool,
  span: Span,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  let minimum = signedMinimum(lhs.scalar.bits)
  if lhs.scalar.signed && minimum.length == usize.ZERO {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.make(GapCode.ArithmeticTrap, &owner, span)
  }
  let zero = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&zero))
  run append(&mut writer.*, b" = icmp eq ")
  run typeName(&mut writer.*, rhs.scalar)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&rhs.text))
  run append(&mut writer.*, b", 0\n")
  run trapWhen(&mut writer.*, Bytes.asSlice(&zero), b"division by zero")
  if lhs.scalar.signed {
    let min = run temp(&mut writer.*)
    run append(&mut writer.*, Bytes.asSlice(&min))
    run append(&mut writer.*, b" = icmp eq ")
    run typeName(&mut writer.*, lhs.scalar)
    run append(&mut writer.*, b" ")
    run append(&mut writer.*, Bytes.asSlice(&lhs.text))
    run append(&mut writer.*, b", ")
    run append(&mut writer.*, minimum)
    run append(&mut writer.*, b"\n")
    let negativeOne = run temp(&mut writer.*)
    run append(&mut writer.*, Bytes.asSlice(&negativeOne))
    run append(&mut writer.*, b" = icmp eq ")
    run typeName(&mut writer.*, rhs.scalar)
    run append(&mut writer.*, b" ")
    run append(&mut writer.*, Bytes.asSlice(&rhs.text))
    run append(&mut writer.*, b", -1\n")
    let overflow = run temp(&mut writer.*)
    run append(&mut writer.*, Bytes.asSlice(&overflow))
    run append(&mut writer.*, b" = and i1 ")
    run append(&mut writer.*, Bytes.asSlice(&min))
    run append(&mut writer.*, b", ")
    run append(&mut writer.*, Bytes.asSlice(&negativeOne))
    run append(&mut writer.*, b"\n")
    run trapWhen(&mut writer.*, Bytes.asSlice(&overflow), b"arithmetic overflow")
  }
  let result = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&result))
  run append(&mut writer.*, b" = ")
  if lhs.scalar.signed {
    run append(&mut writer.*, b"s")
  } else {
    run append(&mut writer.*, b"u")
  }
  if remainder {
    run append(&mut writer.*, b"rem ")
  } else {
    run append(&mut writer.*, b"div ")
  }
  run typeName(&mut writer.*, lhs.scalar)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&lhs.text))
  run append(&mut writer.*, b", ")
  run append(&mut writer.*, Bytes.asSlice(&rhs.text))
  run append(&mut writer.*, b"\n")
  return Value {scalar: lhs.scalar, text: move result}
}

struct Address {
  ty: Shared<Type>
  text: Bytes
  alignment: usize
  representation: Representation
}

struct Pointee {
  ty: Shared<Type>
  alignment: Option<u64>
}

effect fn layoutOf(layouts: &[TypeLayout], ty: &Shared<Type>, function: &MirFunction, span: Span) -> Metrics
! Gap | OutOfMemoryError
? &mut Allocator {
  let mut at = usize.ZERO
  while at < layouts.length {
    if run Type.runtimeEqualsShared(&layouts[at].ty, ty) {
      let facts = Shared.with<Layout, Metrics>(&layouts[at].layout, Layout.metrics)
      return facts
    }
    at = at + usize.ONE
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.ScalarLayout, &owner, span)
}

fn storageRepresentation(ty: &Shared<Type>, target: &Target, facts: Metrics) -> Representation {
  if facts.abi == Abi.Indirect {
    return Representation {aggregate: true, size: facts.size, bits: usize.ZERO,
      signed: false, unit: false, pointer: false, floating: false}
  }
  let written = scalar(ty, target)
  // A nominal integer (a scalar enum) is spelled from its neutral layout, never its declaration.
  if facts.abi == Abi.Integer && written.bits == usize.ZERO {
    return Representation {aggregate: false, size: usize.ZERO, bits: facts.size * 8,
      signed: false, unit: false, pointer: false, floating: false}
  }
  return written
}

effect fn fieldFact(layouts: &[TypeLayout], ty: &Shared<Type>, index: usize,
  function: &MirFunction, span: Span) -> Field ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < layouts.length {
    if run Type.runtimeEqualsShared(&layouts[at].ty, ty) {
      let selected = Shared.with<Layout, Option<Field>>(&layouts[at].layout,
        fn(layout: &Layout) -> Option<Field> { return Layout.fieldAt(layout, index) },
      )
      if let Option<Field>.Some {value} = move selected { return move value }
    }
    at = at + usize.ONE
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.PlaceProjection, &owner, span)
}

effect fn sequenceFact(layouts: &[TypeLayout], ty: &Shared<Type>, function: &MirFunction,
  span: Span) -> Sequence ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < layouts.length {
    if run Type.runtimeEqualsShared(&layouts[at].ty, ty) {
      let selected = Shared.with<Layout, Option<Sequence>>(&layouts[at].layout,
        fn(layout: &Layout) -> Option<Sequence> { return Layout.sequenceFacts(layout) },
      )
      if let Option<Sequence>.Some {value} = move selected { return move value }
    }
    at = at + usize.ONE
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.IndexProjection, &owner, span)
}

struct IndexFacts {
  element: Shared<Type>
  stride: usize
  borrowed: bool
}

fn indexFacts(layout: &Layout) -> Option<IndexFacts> {
  if let Option<Sequence>.Some {value: array} = move Layout.sequenceFacts(layout) {
    return Option.some<IndexFacts>(IndexFacts {element: move array.element, stride: array.stride, borrowed: false})
  }
  if let Option<SliceFacts>.Some {value: slice} = move Layout.sliceFacts(layout) {
    return Option.some<IndexFacts>(IndexFacts {element: move slice.element, stride: slice.stride, borrowed: true})
  }
  return Option.none<IndexFacts>()
}

effect fn indexedFact(layouts: &[TypeLayout], ty: &Shared<Type>, function: &MirFunction,
  span: Span) -> IndexFacts ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < layouts.length {
    if run Type.runtimeEqualsShared(&layouts[at].ty, ty) {
      let selected = Shared.with<Layout, Option<IndexFacts>>(&layouts[at].layout, indexFacts)
      if let Option<IndexFacts>.Some {value} = move selected { return move value }
    }
    at = at + usize.ONE
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.IndexProjection, &owner, span)
}

effect fn sliceFact(layouts: &[TypeLayout], ty: &Shared<Type>, function: &MirFunction,
  span: Span) -> SliceFacts ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < layouts.length {
    if run Type.runtimeEqualsShared(&layouts[at].ty, ty) {
      let selected = Shared.with<Layout, Option<SliceFacts>>(&layouts[at].layout, Layout.sliceFacts)
      if let Option<SliceFacts>.Some {value} = move selected { return move value }
    }
    at = at + usize.ONE
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.SliceLayout, &owner, span)
}

effect fn taggedFact(layouts: &[TypeLayout], ty: &Shared<Type>, function: &MirFunction,
  span: Span) -> TaggedFacts ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < layouts.length {
    if run Type.runtimeEqualsShared(&layouts[at].ty, ty) {
      let selected = Shared.with<Layout, Option<TaggedFacts>>(&layouts[at].layout, Layout.taggedFacts)
      if let Option<TaggedFacts>.Some {value} = move selected { return move value }
    }
    at = at + usize.ONE
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.UnionForm, &owner, span)
}

effect fn variantFieldFact(layouts: &[TypeLayout], ty: &Shared<Type>, variant: usize, field: usize,
  function: &MirFunction, span: Span) -> Field ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < layouts.length {
    if run Type.runtimeEqualsShared(&layouts[at].ty, ty) {
      let selected = Shared.with<Layout, Option<Field>>(&layouts[at].layout, fn(layout: &Layout) -> Option<Field> {
        return Layout.variantField(layout, variant, field)
      })
      if let Option<Field>.Some {value} = move selected { return move value }
    }
    at = at + usize.ONE
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.UnionForm, &owner, span)
}

fn tagRepresentation(facts: TaggedFacts) -> Representation {
  return Representation {aggregate: false, size: usize.ZERO, bits: facts.tagSize * 8,
    signed: false, unit: false, pointer: false, floating: false}
}

effect fn byteOffset(writer: &mut Writer, base: &[u8], offset: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let projected = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&projected))
  run append(&mut writer.*, b" = getelementptr i8, ptr ")
  run append(&mut writer.*, base)
  run append(&mut writer.*, b", i64 ")
  run decimal(&mut writer.*, offset)
  run append(&mut writer.*, b"\n")
  return move projected
}

// Layout alignments are powers of two. Offsets reduce the base guarantee without inventing one.
fn offsetAlignment(alignment: usize, offset: usize) -> usize {
  let mut guarantee = alignment
  while guarantee > usize.ONE && usize.remainder(offset, guarantee) != usize.ZERO {
    guarantee = guarantee / 2
  }
  return guarantee
}

effect fn projectField(writer: &mut Writer, function: &MirFunction, target: &Target,
  layouts: &[TypeLayout], base: &Address, index: usize, span: Span) -> Address
! Gap | OutOfMemoryError ? &mut Allocator {
  let field = run fieldFact(layouts, &base.ty, index, function, span)
  let name = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&name))
  run append(&mut writer.*, b" = getelementptr i8, ptr ")
  run append(&mut writer.*, Bytes.asSlice(&base.text))
  run append(&mut writer.*, b", i")
  run decimal(&mut writer.*, u32.toUsize(Target.pointerBits(target)))
  run append(&mut writer.*, b" ")
  run decimal(&mut writer.*, field.offset)
  run append(&mut writer.*, b"\n")
  let metrics = run layoutOf(layouts, &field.ty, function, span)
  let represented = storageRepresentation(&field.ty, target, metrics)
  return Address {ty: move field.ty, text: move name,
    alignment: offsetAlignment(base.alignment, field.offset), representation: represented}
}

effect fn memoryAlignment(writer: &mut Writer, alignment: usize) -> ()
! OutOfMemoryError
? &mut Allocator {
  run append(&mut writer.*, b", align ")
  run decimal(&mut writer.*, alignment)
  return run append(&mut writer.*, b"\n")
}

fn copiedAlignment(written: &Option<u64>) -> Option<u64> {
  return match & written.* {
    Option<u64>.Some {value: declaredAlignment} => Option.some<u64>(declaredAlignment)
    Option<u64>.None => Option.none<u64>()
  }
}

// Returns what a reference or pointer type points at, absent for any other type.
fn pointeeOf(ty: &Shared<Type>) -> Option<Pointee> {
  return Shared.with<Type, Option<Pointee>>(
    ty,
    fn(value: &Type) -> Option<Pointee> {
      return match & value.* {
        Type.Reference {referent, ..} => Option.some<Pointee>(
          Pointee {ty: Shared.clone<Type>(&referent), alignment: Option.none<u64>()},
        )
        Type.Pointer {pointee, alignment: written, ..} => Option.some<Pointee>(
          Pointee {ty: Shared.clone<Type>(&pointee), alignment: copiedAlignment(&written)},
        )
        _ => Option.none<Pointee>()
      }
    },
  )
}

// Returns what a dereferenced place points at, or rejects a place that is not a reference or pointer.
effect fn pointeeOrGap(function: &MirFunction, ty: &Shared<Type>, span: Span) -> Pointee
! Gap | OutOfMemoryError
? &mut Allocator {
  let pointee = pointeeOf(ty)
  let selected = match move pointee {
    Option<Pointee>.Some {value} => move value
    Option<Pointee>.None => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.PlaceProjection, &owner, span)
    }
  }
  return move selected
}

effect fn emitPlace(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  place: &Place,
) -> Address ! Gap | OutOfMemoryError ? &mut Allocator {
  let locals = Vector.asSlice<Local>(&function.locals)
  let owner = InstanceKey.identity(&function.key)
  let span = locals[place.local].origin.span
  let mut ty = Shared.clone<Type>(&locals[place.local].ty)
  let rootLayout = run layoutOf(layouts, &ty, function, span)
  let mut alignment = rootLayout.alignment
  let mut named = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
  run localName(&mut named, place.local)
  let mut address = move named.text
  let projections = Vector.asSlice<Projection>(&place.projections)
  let mut at = usize.ZERO
  while at < projections.length {
    match & projections[at] {
      Projection.Deref => {
        let selected = run pointeeOrGap(function, &ty, span)
        let loaded = run temp(&mut writer.*)
        run append(&mut writer.*, Bytes.asSlice(&loaded))
        run append(&mut writer.*, b" = load ptr, ptr ")
        run append(&mut writer.*, Bytes.asSlice(&address))
        run memoryAlignment(&mut writer.*, alignment)
        ty = move selected.ty
        let referentLayout = run layoutOf(layouts, &ty, function, span)
        alignment = match move selected.alignment {
          Option<u64>.Some {value} => u64.toUsize(value)
          Option<u64>.None => referentLayout.alignment
        }
        address = move loaded
      }
      Projection.Field {index} => {
        let facts = run layoutOf(layouts, &ty, function, span)
        let represented = storageRepresentation(&ty, target, facts)
        let base = Address {ty: Shared.clone<Type>(&ty), text: run Bytes.copy(Bytes.asSlice(&address)),
          alignment: alignment, representation: represented}
        let field = run projectField(&mut writer.*, function, target, layouts, &base, index, span)
        ty = move field.ty
        address = move field.text
        alignment = field.alignment
      }
      Projection.Index {local} => {
        let sequence = run indexedFact(layouts, &ty, function, span)
        if sequence.borrowed {
          let data = run temp(&mut writer.*)
          run append(&mut writer.*, Bytes.asSlice(&data))
          run append(&mut writer.*, b" = load ptr, ptr ")
          run append(&mut writer.*, Bytes.asSlice(&address))
          run memoryAlignment(&mut writer.*, alignment)
          address = move data
          let elementLayout = run layoutOf(layouts, &sequence.element, function, span)
          alignment = elementLayout.alignment
        }
        let indexPlace = Place {local: local, projections: Vector.make<Projection>()}
        let selectedIndex = run loadPlace(&mut writer.*, function, target, layouts, &indexPlace)
        let offset = run temp(&mut writer.*)
        run append(&mut writer.*, Bytes.asSlice(&offset))
        run append(&mut writer.*, b" = mul ")
        run typeName(&mut writer.*, selectedIndex.scalar)
        run append(&mut writer.*, b" ")
        run append(&mut writer.*, Bytes.asSlice(&selectedIndex.text))
        run append(&mut writer.*, b", ")
        run decimal(&mut writer.*, sequence.stride)
        run append(&mut writer.*, b"\n")
        let projected = run temp(&mut writer.*)
        run append(&mut writer.*, Bytes.asSlice(&projected))
        run append(&mut writer.*, b" = getelementptr i8, ptr ")
        run append(&mut writer.*, Bytes.asSlice(&address))
        run append(&mut writer.*, b", ")
        run typeName(&mut writer.*, selectedIndex.scalar)
        run append(&mut writer.*, b" ")
        run append(&mut writer.*, Bytes.asSlice(&offset))
        run append(&mut writer.*, b"\n")
        alignment = offsetAlignment(alignment, sequence.stride)
        ty = move sequence.element
        address = move projected
      }
      Projection.VariantField {variant, field} => {
        let selected = run variantFieldFact(layouts, &ty, variant, field, function, span)
        address = run byteOffset(&mut writer.*, Bytes.asSlice(&address), selected.offset)
        alignment = offsetAlignment(alignment, selected.offset)
        ty = move selected.ty
      }
      Projection.Payload {ty: member, ..} => {
        let facts = run taggedFact(layouts, &ty, function, span)
        address = run byteOffset(&mut writer.*, Bytes.asSlice(&address), facts.payloadOffset)
        alignment = offsetAlignment(alignment, facts.payloadOffset)
        ty = Shared.clone<Type>(&member)
      }
      Projection.ConstIndex {index} => {
        let sequence = run sequenceFact(layouts, &ty, function, span)
        if index >= sequence.count { fail Gap.make(GapCode.IndexProjection, &owner, span) }
        let facts = run layoutOf(layouts, &ty, function, span)
        let represented = storageRepresentation(&ty, target, facts)
        let base = Address {ty: Shared.clone<Type>(&ty), text: run Bytes.copy(Bytes.asSlice(&address)),
          alignment: alignment, representation: represented}
        let element = run projectField(&mut writer.*, function, target, layouts, &base, index, span)
        ty = move element.ty
        address = move element.text
        alignment = element.alignment
      }
    }
    at = at + usize.ONE
  }
  let finalLayout = run layoutOf(layouts, &ty, function, span)
  let kind = storageRepresentation(&ty, target, finalLayout)
  if !kind.unit && !kind.aggregate && kind.bits == usize.ZERO {
    fail Gap.make(GapCode.ScalarLayout, &owner, span)
  }
  return Address {ty: move ty, text: move address, alignment: alignment, representation: kind}
}

effect fn loadPlace(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  place: &Place,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  let address = run emitPlace(&mut writer.*, function, target, layouts, place)
  return run loadAddress(&mut writer.*, &address)
}

// Reuse the resolved address when an operation must validate its exact source type before loading.
effect fn loadAddress(writer: &mut Writer, address: &Address) -> Value
! OutOfMemoryError ? &mut Allocator {
  let kind = address.representation
  if kind.unit {
    return Value {scalar: kind, text: Bytes.make()}
  }
  // The consuming store copies the bytes; nothing writes memory between this read and that store.
  if kind.aggregate {
    return Value {scalar: kind, text: run Bytes.copy(Bytes.asSlice(&address.text))}
  }
  let name = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&name))
  run append(&mut writer.*, b" = load ")
  run typeName(&mut writer.*, kind)
  run append(&mut writer.*, b", ptr ")
  run append(&mut writer.*, Bytes.asSlice(&address.text))
  run memoryAlignment(&mut writer.*, address.alignment)
  return Value {scalar: kind, text: move name}
}

effect fn emitOperand(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  operand: &Operand,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  return match & operand.* {
    Operand.Copy {place} => run loadPlace(&mut writer.*, function, target, layouts, &place)
    Operand.Move {place} => run loadPlace(&mut writer.*, function, target, layouts, &place)
    Operand.Integer {decimal: digits, negative, ty} => {
      let mut text = Bytes.make()
      if negative {
        run Bytes.append(&mut text, b"-")
      }
      run Bytes.append(&mut text, Bytes.asSlice(&digits))
      let mut kind = scalar(&ty, target)
      if kind.bits == usize.ZERO && !kind.unit {
        let facts = run layoutOf(layouts, &ty, function, Span.make(usize.ZERO, usize.ZERO))
        kind = storageRepresentation(&ty, target, facts)
      }
      return Value {scalar: kind, text: move text}
    }
    Operand.Float {bits, ty} => Value {scalar: scalar(&ty, target), text: run hexDouble(bits)}
    Operand.Boolean {value} => {
      let mut text = run Bytes.copy(b"false")
      if value {
        text = run Bytes.copy(b"true")
      }
      return Value {
        scalar: Representation {aggregate: false, size: usize.ZERO, bits: usize.ONE, signed: false, unit: false, pointer: false, floating: false},
        text: move text,
      }
    }
    Operand.Unit => Value {
      scalar: Representation {aggregate: false, size: usize.ZERO, bits: usize.ZERO, signed: false, unit: true, pointer: false, floating: false},
      text: Bytes.make(),
    }
    Operand.Null {..} => Value {scalar: pointerRepresentation(target), text: run Bytes.copy(b"null")}
    Operand.StaticBytes {bytes} => Value {
      scalar: Representation {aggregate: false, size: usize.ZERO, bits: u32.toUsize(Target.pointerBits(target)),
        signed: false, unit: false, pointer: true, floating: false},
      text: run staticBytes(&mut writer.*, Bytes.asSlice(&bytes)),
    }
  }
}

effect fn emitArgument(writer: &mut Writer, function: &MirFunction, target: &Target,
  layouts: &[TypeLayout], operand: &Operand) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut place = Option.none<Address>()
  if let Operand.Copy {place: source} = &operand.* {
    place = Option.some<Address>(run emitPlace(&mut writer.*, function, target, layouts, &source))
  }
  if let Operand.Move {place: source} = &operand.* {
    place = Option.some<Address>(run emitPlace(&mut writer.*, function, target, layouts, &source))
  }
  if let Option<Address>.Some {value: address} = move place {
    if address.representation.aggregate {
      return Value {scalar: Representation {aggregate: false, size: usize.ZERO,
        bits: u32.toUsize(Target.pointerBits(target)), signed: false, unit: false, pointer: true, floating: false},
        text: move address.text}
    }
  }
  return run emitOperand(&mut writer.*, function, target, layouts, operand)
}

effect fn descriptorLengthAddress(writer: &mut Writer, target: &Target, base: &[u8], offset: usize) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let name = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&name))
  run append(&mut writer.*, b" = getelementptr i8, ptr ")
  run append(&mut writer.*, base)
  run append(&mut writer.*, b", i")
  run decimal(&mut writer.*, u32.toUsize(Target.pointerBits(target)))
  run append(&mut writer.*, b" ")
  run decimal(&mut writer.*, offset)
  run append(&mut writer.*, b"\n")
  return move name
}

fn lengthRepresentation(target: &Target) -> Representation {
  return Representation {aggregate: false, size: usize.ZERO, bits: u32.toUsize(Target.pointerBits(target)),
    signed: false, unit: false, pointer: false, floating: false}
}

// Selects the floating compare predicate for an operation, empty when it has none.
fn floatPredicate(operation: InfixOperator) -> &'static [u8] {
  return match operation {
    InfixOperator.Equals => b"oeq"
    InfixOperator.NotEquals => b"une"
    InfixOperator.LessThan => b"olt"
    InfixOperator.LessOrEqual => b"ole"
    InfixOperator.GreaterThan => b"ogt"
    InfixOperator.GreaterOrEqual => b"oge"
    _ => b""
  }
}

// Selects the IEEE 754 arithmetic opcode for an operation, empty when it has none.
fn floatOpcode(operation: InfixOperator) -> &'static [u8] {
  return match operation {
    InfixOperator.Add => b"fadd"
    InfixOperator.Subtract => b"fsub"
    InfixOperator.Multiply => b"fmul"
    InfixOperator.Divide => b"fdiv"
    InfixOperator.Remainder => b"frem"
    _ => b""
  }
}

// Selects the integer compare or bitwise opcode for an operation, empty when it has none.
fn integerOpcode(operation: InfixOperator, signed: bool) -> &'static [u8] {
  match operation {
    InfixOperator.Equals => {
      return b" = icmp eq "
    }
    InfixOperator.NotEquals => {
      return b" = icmp ne "
    }
    InfixOperator.LessThan => {
      if signed { return b" = icmp slt " }
      return b" = icmp ult "
    }
    InfixOperator.LessOrEqual => {
      if signed { return b" = icmp sle " }
      return b" = icmp ule "
    }
    InfixOperator.GreaterThan => {
      if signed { return b" = icmp sgt " }
      return b" = icmp ugt "
    }
    InfixOperator.GreaterOrEqual => {
      if signed { return b" = icmp sge " }
      return b" = icmp uge "
    }
    InfixOperator.BitAnd => {
      return b" = and "
    }
    InfixOperator.And => {
      return b" = and "
    }
    InfixOperator.BitOr => {
      return b" = or "
    }
    InfixOperator.Or => {
      return b" = or "
    }
    InfixOperator.BitXor => {
      return b" = xor "
    }
    _ => {}
  }
  return b""
}

fn pointerRepresentation(target: &Target) -> Representation {
  return Representation {aggregate: false, size: usize.ZERO, bits: u32.toUsize(Target.pointerBits(target)),
    signed: false, unit: false, pointer: true, floating: false}
}

// Whether a semantic type is a numeric scalar: an integer, a floating type or a character. A
// scalar enum shares an integer's storage but is not numeric.
fn numericPrimitive(ty: &Shared<Type>) -> bool {
  return Shared.with<Type, bool>(ty, fn(value: &Type) -> bool {
    if let Type.Primitive {name} = &value.* {
      let word = Bytes.asSlice(&name)
      return same(word, b"u8") || same(word, b"u16") || same(word, b"u32") || same(word, b"u64") || same(word, b"usize")
        || same(word, b"i8") || same(word, b"i16") || same(word, b"i32") || same(word, b"i64") || same(word, b"isize")
        || same(word, b"f32") || same(word, b"f64") || same(word, b"char")
    }
    return false
  })
}

// Scalar intrinsic operations admit actual numeric primitives, not an enum's scalar storage.
effect fn emitNumeric(
  writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout], operand: &Operand, span: Span,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  match &operand.* {
    Operand.Copy {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      if numericPrimitive(&address.ty) { return run loadAddress(&mut writer.*, &address) }
    }
    Operand.Move {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      if numericPrimitive(&address.ty) { return run loadAddress(&mut writer.*, &address) }
    }
    Operand.Integer {ty, ..} => {
      if numericPrimitive(&ty) { return run emitOperand(&mut writer.*, function, target, layouts, operand) }
    }
    Operand.Float {ty, ..} => {
      if numericPrimitive(&ty) { return run emitOperand(&mut writer.*, function, target, layouts, operand) }
    }
    _ => ()
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.TypedForm, &owner, span)
}

effect fn typedFormGap(function: &MirFunction, span: Span) -> never ! Gap | OutOfMemoryError ? &mut Allocator {
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.TypedForm, &owner, span)
}

// 2^power for power <= 63.
fn powerOfTwo(power: usize) -> u64 {
  let mut value: u64 = 1
  let mut at = usize.ZERO
  while at < power {
    value = value * 2
    at = at + usize.ONE
  }
  return value
}

// 2^bits - 1 for bits <= 64.
fn allOnes(bits: usize) -> u64 {
  if bits == 64 { return powerOfTwo(63) - 1 + powerOfTwo(63) }
  return powerOfTwo(bits) - 1
}

// The number of magnitude bits: one fewer than the width for a signed integer.
fn magnitudeBits(kind: Representation) -> usize {
  if kind.signed { return kind.bits - usize.ONE }
  return kind.bits
}

// The decimal text of `magnitude`, negated when `negative`.
effect fn integerText(negative: bool, magnitude: u64) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut writer = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
  if negative { run append(&mut writer, b"-") }
  run unsignedDecimal(&mut writer, magnitude)
  return move writer.text
}

// The largest value of an integer representation.
effect fn maximumText(kind: Representation) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  return run integerText(false, allOnes(magnitudeBits(kind)))
}

// The smallest value of an integer representation.
effect fn minimumText(kind: Representation) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  if !kind.signed { return run Bytes.copy(b"0") }
  return run integerText(true, powerOfTwo(kind.bits - usize.ONE))
}

// The LLVM hexadecimal spelling of IEEE 754 binary64 `bits`, which LLVM also uses for `float`.
effect fn hexDouble(bits: u64) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut literal = Writer {text: run Bytes.copy(b"0x"), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
  let digits = b"0123456789ABCDEF"
  let mut shift: u64 = 60
  while true {
    let digit = u64.toUsize(u64.bitAnd(u64.shiftRight(bits, shift), 15))
    run append(&mut literal, &[digits[digit]])
    if shift == 0 {
      break
    }
    shift = shift - 4
  }
  return move literal.text
}

// The binary64 bits of the exact integer `±(2^power)` or `±(2^power + 1)`, for power <= 52 when
// `plusOne`. Both are exactly representable, in binary32 too while power stays below 24.
fn exactDouble(negative: bool, power: usize, plusOne: bool) -> u64 {
  let mut bits = u64.shiftLeft(usize.toU64(1023 + power), 52)
  if plusOne { bits = u64.bitOr(bits, powerOfTwo(52 - power)) }
  if negative { bits = u64.bitOr(bits, powerOfTwo(63)) }
  return bits
}

effect fn emitCast(writer: &mut Writer, opcode: &[u8], input: &Value, output: Representation) -> Value
! OutOfMemoryError ? &mut Allocator {
  let name = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&name))
  run append(&mut writer.*, b" = ")
  run append(&mut writer.*, opcode)
  run append(&mut writer.*, b" ")
  run typeName(&mut writer.*, input.scalar)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&input.text))
  run append(&mut writer.*, b" to ")
  run typeName(&mut writer.*, output)
  run append(&mut writer.*, b"\n")
  return Value {scalar: output, text: move name}
}

// Emits `%name = <instruction> <type> <left>, <right>` and returns `%name`.
effect fn instruction(writer: &mut Writer, opcode: &[u8], kind: Representation, left: &[u8], right: &[u8]) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let name = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&name))
  run append(&mut writer.*, b" = ")
  run append(&mut writer.*, opcode)
  run append(&mut writer.*, b" ")
  run typeName(&mut writer.*, kind)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, left)
  run append(&mut writer.*, b", ")
  run append(&mut writer.*, right)
  run append(&mut writer.*, b"\n")
  return move name
}

// Emits `%name = select i1 <condition>, <type> <chosen>, <type> <otherwise>`.
effect fn selectValue(writer: &mut Writer, condition: &[u8], kind: Representation, chosen: &[u8], otherwise: &[u8]) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let name = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&name))
  run append(&mut writer.*, b" = select i1 ")
  run append(&mut writer.*, condition)
  run append(&mut writer.*, b", ")
  run typeName(&mut writer.*, kind)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, chosen)
  run append(&mut writer.*, b", ")
  run typeName(&mut writer.*, kind)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, otherwise)
  run append(&mut writer.*, b"\n")
  return move name
}

// Calls `@llvm.<name>.<type>` with the given operands of one type.
effect fn callIntrinsic(writer: &mut Writer, name: &[u8], kind: Representation, operands: &[Bytes]) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let result = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&result))
  run append(&mut writer.*, b" = call ")
  run typeName(&mut writer.*, kind)
  run append(&mut writer.*, b" @llvm.")
  run append(&mut writer.*, name)
  run append(&mut writer.*, b".")
  run mangledType(&mut writer.*, kind)
  run append(&mut writer.*, b"(")
  let mut at = usize.ZERO
  while at < operands.length {
    if at != usize.ZERO { run append(&mut writer.*, b", ") }
    run typeName(&mut writer.*, kind)
    run append(&mut writer.*, b" ")
    run append(&mut writer.*, Bytes.asSlice(&operands[at]))
    at = at + usize.ONE
  }
  run append(&mut writer.*, b")\n")
  return move result
}

fn booleanRepresentation() -> Representation {
  return Representation {aggregate: false, size: usize.ZERO, bits: usize.ONE, signed: false, unit: false, pointer: false, floating: false}
}

fn integerRepresentation(bits: usize, signed: bool) -> Representation {
  return Representation {aggregate: false, size: usize.ZERO, bits: bits, signed: signed, unit: false, pointer: false, floating: false}
}

fn isIntegral(kind: Representation) -> bool {
  return !kind.aggregate && !kind.pointer && !kind.unit && !kind.floating && kind.bits >= 8
}

fn isFloating(kind: Representation) -> bool {
  return !kind.aggregate && !kind.pointer && !kind.unit && kind.floating
}

// Traps when an integer value lies outside the destination integer range (CONV-002).
effect fn integerRangeGuard(writer: &mut Writer, input: &Value, output: Representation) -> ()
! OutOfMemoryError ? &mut Allocator {
  let violation = run integerRangeViolation(&mut writer.*, input, output)
  if let Option<Bytes>.Some {value: condition} = move violation {
    run trapWhen(&mut writer.*, Bytes.asSlice(&condition), b"arithmetic overflow")
  }
  return ()
}

// The condition that an integer value lies outside the destination integer range, or absence
// when every source value fits.
effect fn integerRangeViolation(writer: &mut Writer, input: &Value, output: Representation) -> Option<Bytes>
! OutOfMemoryError ? &mut Allocator {
  let source = input.scalar
  let mut below = Option.none<Bytes>()
  if source.signed && (!output.signed || output.bits < source.bits) {
    let minimum = run minimumText(output)
    below = Option.some<Bytes>(run instruction(&mut writer.*, b"icmp slt", source, Bytes.asSlice(&input.text), Bytes.asSlice(&minimum)))
  }
  let mut above = Option.none<Bytes>()
  if magnitudeBits(output) < magnitudeBits(source) {
    let maximum = run maximumText(output)
    let mut compare: &[u8] = b"icmp ugt"
    if source.signed { compare = b"icmp sgt" }
    above = Option.some<Bytes>(run instruction(&mut writer.*, compare, source, Bytes.asSlice(&input.text), Bytes.asSlice(&maximum)))
  }
  let invalid = match move below {
    Option<Bytes>.Some {value: low} => match move above {
      Option<Bytes>.Some {value: high} => Option.some<Bytes>(
        run instruction(&mut writer.*, b"or", booleanRepresentation(), Bytes.asSlice(&low), Bytes.asSlice(&high)))
      Option<Bytes>.None => Option.some<Bytes>(move low)
    }
    Option<Bytes>.None => move above
  }
  return move invalid
}

fn characterType(ty: &Shared<Type>) -> bool {
  return Shared.with<Type, bool>(ty, fn(value: &Type) -> bool {
    return match &value.* {
      Type.Primitive {name} => same(Bytes.asSlice(&name), b"char")
      _ => false
    }
  })
}

// Whether an integer is exactly representable in an integer type, or is a Unicode scalar value:
// at most 0x10FFFF and outside the surrogates 0xD800 to 0xDFFF.
effect fn emitFits(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout],
  operand: &Operand, ty: &Shared<Type>, span: Span) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  let input = run emitNumeric(&mut writer.*, function, target, layouts, operand, span)
  if !isIntegral(input.scalar) || !numericPrimitive(ty) { return run typedFormGap(function, span) }
  let boolean = booleanRepresentation()
  let value = Bytes.asSlice(&input.text)
  if characterType(ty) {
    let above = run instruction(&mut writer.*, b"icmp ugt", input.scalar, value, b"1114111")
    let low = run instruction(&mut writer.*, b"icmp uge", input.scalar, value, b"55296")
    let high = run instruction(&mut writer.*, b"icmp ule", input.scalar, value, b"57343")
    let surrogate = run instruction(&mut writer.*, b"and", boolean, Bytes.asSlice(&low), Bytes.asSlice(&high))
    let invalid = run instruction(&mut writer.*, b"or", boolean, Bytes.asSlice(&above), Bytes.asSlice(&surrogate))
    return Value {scalar: boolean, text: run instruction(&mut writer.*, b"xor", boolean, Bytes.asSlice(&invalid), b"true")}
  }
  let output = scalar(ty, target)
  if !isIntegral(output) { return run typedFormGap(function, span) }
  return match move run integerRangeViolation(&mut writer.*, &input, output) {
    Option<Bytes>.Some {value: invalid} => Value {scalar: boolean,
      text: run instruction(&mut writer.*, b"xor", boolean, Bytes.asSlice(&invalid), b"true")}
    Option<Bytes>.None => Value {scalar: boolean, text: run Bytes.copy(b"true")}
  }
}

// Calls `@llvm.<s|u><stem>.with.overflow` and returns the result pair.
effect fn overflowPair(writer: &mut Writer, stem: &[u8], kind: Representation, left: &[u8], right: &[u8]) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let pair = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&pair))
  run append(&mut writer.*, b" = call ")
  run aggregateType(&mut writer.*, kind)
  run append(&mut writer.*, b" ")
  run overflowIntrinsic(&mut writer.*, stem, kind)
  run append(&mut writer.*, b"(")
  run typeName(&mut writer.*, kind)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, left)
  run append(&mut writer.*, b", ")
  run typeName(&mut writer.*, kind)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, right)
  run append(&mut writer.*, b")\n")
  return move pair
}

// Extracts field `index` (0 the wrapped value, 1 the overflow flag) of an overflow pair.
effect fn pairField(writer: &mut Writer, kind: Representation, pair: &[u8], index: usize) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let name = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&name))
  run append(&mut writer.*, b" = extractvalue ")
  run aggregateType(&mut writer.*, kind)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, pair)
  run append(&mut writer.*, b", ")
  run decimal(&mut writer.*, index)
  run append(&mut writer.*, b"\n")
  return move name
}

// Traps when a floating value is NaN or truncates outside the destination integer range. The
// high bound `maximum + 1` is a power of two; below the low bound the truncation falls under the
// minimum, tested inclusively against `minimum - 1` when that is exactly representable.
effect fn floatRangeGuard(writer: &mut Writer, input: &Value, output: Representation) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut precision: usize = 53
  if input.scalar.bits == 32 { precision = 24 }
  let exactLow = !output.signed || output.bits <= precision
  let mut low = exactDouble(true, usize.ZERO, false)
  if output.signed { low = exactDouble(true, output.bits - usize.ONE, exactLow) }
  let high = exactDouble(false, magnitudeBits(output), false)
  let lowText = run hexDouble(low)
  let highText = run hexDouble(high)
  let mut compare: &[u8] = b"fcmp ult"
  if exactLow { compare = b"fcmp ule" }
  let below = run instruction(&mut writer.*, compare, input.scalar, Bytes.asSlice(&input.text), Bytes.asSlice(&lowText))
  let above = run instruction(&mut writer.*, b"fcmp uge", input.scalar, Bytes.asSlice(&input.text), Bytes.asSlice(&highText))
  let invalid = run instruction(&mut writer.*, b"or", booleanRepresentation(), Bytes.asSlice(&below), Bytes.asSlice(&above))
  return run trapWhen(&mut writer.*, Bytes.asSlice(&invalid), b"arithmetic overflow")
}

effect fn emitConvert(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout],
  operand: &Operand, ty: &Shared<Type>, span: Span) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  let input = run emitNumeric(&mut writer.*, function, target, layouts, operand, span)
  let output = scalar(ty, target)
  if !numericPrimitive(ty) { return run typedFormGap(function, span) }
  if input.scalar.floating && output.floating {
    if input.scalar.bits == output.bits { return Value {scalar: output, text: move input.text} }
    if input.scalar.bits > output.bits { return run emitCast(&mut writer.*, b"fptrunc", &input, output) }
    return run emitCast(&mut writer.*, b"fpext", &input, output)
  }
  if output.floating {
    if input.scalar.signed { return run emitCast(&mut writer.*, b"sitofp", &input, output) }
    return run emitCast(&mut writer.*, b"uitofp", &input, output)
  }
  if input.scalar.floating {
    run floatRangeGuard(&mut writer.*, &input, output)
    if output.signed { return run emitCast(&mut writer.*, b"fptosi", &input, output) }
    return run emitCast(&mut writer.*, b"fptoui", &input, output)
  }
  run integerRangeGuard(&mut writer.*, &input, output)
  if input.scalar.bits == output.bits { return Value {scalar: output, text: move input.text} }
  if input.scalar.bits > output.bits { return run emitCast(&mut writer.*, b"trunc", &input, output) }
  if input.scalar.signed { return run emitCast(&mut writer.*, b"sext", &input, output) }
  return run emitCast(&mut writer.*, b"zext", &input, output)
}

// Classifies a floating value from its IEEE 754 exponent and fraction fields, as the bootstrap
// does; the square root is LLVM's correctly rounded intrinsic.
effect fn emitScalarUnary(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout],
  operation: ScalarUnary, operand: &Operand, span: Span) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  let input = run emitNumeric(&mut writer.*, function, target, layouts, operand, span)
  if !isFloating(input.scalar) { return run typedFormGap(function, span) }
  if operation == ScalarUnary.Sin || operation == ScalarUnary.Cos {
    return run emitTranscendental(&mut writer.*, &input, operation == ScalarUnary.Sin)
  }
  if operation == ScalarUnary.Sqrt {
    let mut operands = Vector.make<Bytes>()
    run Vector.append<Bytes>(&mut operands, run Bytes.copy(Bytes.asSlice(&input.text)))
    let root = run callIntrinsic(&mut writer.*, b"sqrt", input.scalar, Vector.asSlice<Bytes>(&operands))
    return Value {scalar: input.scalar, text: move root}
  }
  let raw = run emitCast(&mut writer.*, b"bitcast", &input, integerRepresentation(input.scalar.bits, false))
  let integer = raw.scalar
  let mut exponentMask = run integerText(false, 9218868437227405312)
  let mut fractionMask = run integerText(false, 4503599627370495)
  if input.scalar.bits == 32 {
    exponentMask = run integerText(false, 2139095040)
    fractionMask = run integerText(false, 8388607)
  }
  let bits = Bytes.asSlice(&raw.text)
  let boolean = booleanRepresentation()
  if operation == ScalarUnary.IsSignNegative {
    return Value {scalar: boolean, text: run instruction(&mut writer.*, b"icmp slt", integer, bits, b"0")}
  }
  let exponent = run instruction(&mut writer.*, b"and", integer, bits, Bytes.asSlice(&exponentMask))
  let fraction = run instruction(&mut writer.*, b"and", integer, bits, Bytes.asSlice(&fractionMask))
  let exponentZero = run instruction(&mut writer.*, b"icmp eq", integer, Bytes.asSlice(&exponent), b"0")
  let exponentAll = run instruction(&mut writer.*, b"icmp eq", integer, Bytes.asSlice(&exponent), Bytes.asSlice(&exponentMask))
  let fractionZero = run instruction(&mut writer.*, b"icmp eq", integer, Bytes.asSlice(&fraction), b"0")
  let exponentSome = run instruction(&mut writer.*, b"xor", boolean, Bytes.asSlice(&exponentZero), b"true")
  let exponentFinite = run instruction(&mut writer.*, b"xor", boolean, Bytes.asSlice(&exponentAll), b"true")
  let fractionSome = run instruction(&mut writer.*, b"xor", boolean, Bytes.asSlice(&fractionZero), b"true")
  let flag = match operation {
    ScalarUnary.IsNaN => run instruction(&mut writer.*, b"and", boolean, Bytes.asSlice(&exponentAll), Bytes.asSlice(&fractionSome))
    ScalarUnary.IsInfinite => run instruction(&mut writer.*, b"and", boolean, Bytes.asSlice(&exponentAll), Bytes.asSlice(&fractionZero))
    ScalarUnary.IsFinite => move exponentFinite
    ScalarUnary.IsNormal => run instruction(&mut writer.*, b"and", boolean, Bytes.asSlice(&exponentSome), Bytes.asSlice(&exponentFinite))
    ScalarUnary.IsSubnormal => run instruction(&mut writer.*, b"and", boolean, Bytes.asSlice(&exponentZero), Bytes.asSlice(&fractionSome))
    _ => run typedFormGap(function, span)
  }
  return Value {scalar: boolean, text: move flag}
}

// The bootstrap's fixed sine and cosine plan as binary64 bits. Binary32 constants are widened
// exactly, which is how LLVM spells a `float` constant.
fn halfPiParts(single: bool) -> [u64; 10] {
  if single {
    return [0x3FF9000000000000, 0x3F80000000000000, 0x3F3F000000000000, 0x3EE6000000000000, 0x3E95000000000000,
      0x3E11000000000000, 0x3D86000000000000, 0x3D31000000000000, 0x3CE0000000000000, 0x3C91000000000000]
  }
  return [0x3FF9200000000000, 0x3F3FB40000000000, 0x3E74440000000000, 0x3D868C0000000000, 0x3C91A60000000000,
    0x3BA3180000000000, 0x3AE8A20000000000, 0x3A1C060000000000, 0x394C1C0000000000, 0x387A240000000000]
}

fn sineCoefficients(single: bool) -> [u64; 6] {
  if single {
    return [0xBFC5555560000000, 0x3F81111120000000, 0xBF2A01A020000000, 0x3EC71DE360000000, 0xBE5AE5E680000000,
      0x3DE5D93A60000000]
  }
  return [0xBFC5555555555549, 0x3F8111111110F8A6, 0xBF2A01A019C161D5, 0x3EC71DE357B1FE7D, 0xBE5AE5E68A2B9CEB,
    0x3DE5D93A5ACFD57C]
}

fn cosineCoefficients(single: bool) -> [u64; 6] {
  if single {
    return [0x3FA5555560000000, 0xBF56C16C20000000, 0x3EFA01A020000000, 0xBE927E4F80000000, 0x3E21EE9EC0000000,
      0xBDA8FAE9C0000000]
  }
  return [0x3FA555555555554C, 0xBF56C16C16C15177, 0x3EFA01A019CB1590, 0xBE927E4F809C52AD, 0x3E21EE9EBDB4B1C4,
    0xBDA8FAE9BE8838D4]
}

// Horner evaluation in the plan's fixed order: `c[i] + squared * result` from the last coefficient.
effect fn polynomial(writer: &mut Writer, kind: Representation, coefficients: &[u64], squared: &[u8]) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let mut at = coefficients.length - usize.ONE
  let mut result = run hexDouble(coefficients[at])
  while at > usize.ZERO {
    at = at - usize.ONE
    let product = run instruction(&mut writer.*, b"fmul", kind, squared, Bytes.asSlice(&result))
    let coefficient = run hexDouble(coefficients[at])
    result = run instruction(&mut writer.*, b"fadd", kind, Bytes.asSlice(&coefficient), Bytes.asSlice(&product))
  }
  return move result
}

// Selects the result for quadrant 0 to 3: sine, cosine, -sine, -cosine for sine, and cosine,
// -sine, -cosine, sine for cosine.
effect fn quadrantResult(writer: &mut Writer, kind: Representation, quadrant: &[u8], sine: bool, sineValue: &[u8],
  cosineValue: &[u8], negativeSine: &[u8], negativeCosine: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let wide = integerRepresentation(64, true)
  let second = run instruction(&mut writer.*, b"icmp eq", wide, quadrant, b"2")
  let first = run instruction(&mut writer.*, b"icmp eq", wide, quadrant, b"1")
  let initial = run instruction(&mut writer.*, b"icmp eq", wide, quadrant, b"0")
  if sine {
    let upper = run selectValue(&mut writer.*, Bytes.asSlice(&second), kind, negativeSine, negativeCosine)
    let lower = run selectValue(&mut writer.*, Bytes.asSlice(&first), kind, cosineValue, Bytes.asSlice(&upper))
    return run selectValue(&mut writer.*, Bytes.asSlice(&initial), kind, sineValue, Bytes.asSlice(&lower))
  }
  let upper = run selectValue(&mut writer.*, Bytes.asSlice(&second), kind, negativeCosine, sineValue)
  let lower = run selectValue(&mut writer.*, Bytes.asSlice(&first), kind, negativeSine, Bytes.asSlice(&upper))
  return run selectValue(&mut writer.*, Bytes.asSlice(&initial), kind, cosineValue, Bytes.asSlice(&lower))
}

// The bootstrap's deterministic sine or cosine: quadrant reduction by a ten-part pi/2, fixed
// polynomial kernels, signed zero kept by sine, and the canonical NaN for NaN and infinities.
effect fn emitTranscendental(writer: &mut Writer, input: &Value, sine: bool) -> Value ! OutOfMemoryError ? &mut Allocator {
  let kind = input.scalar
  let single = kind.bits == 32
  let x = Bytes.asSlice(&input.text)
  let zero = run hexDouble(0)
  let one = run hexDouble(0x3FF0000000000000)
  let half = run hexDouble(0x3FE0000000000000)
  let negativeHalf = run hexDouble(0xBFE0000000000000)
  let mut inverse = run hexDouble(0x3FE45F306DC9C883)
  if single { inverse = run hexDouble(0x3FE45F3060000000) }
  let negative = run instruction(&mut writer.*, b"fcmp olt", kind, x, Bytes.asSlice(&zero))
  let offset = run selectValue(&mut writer.*, Bytes.asSlice(&negative), kind, Bytes.asSlice(&negativeHalf), Bytes.asSlice(&half))
  let scaled = run instruction(&mut writer.*, b"fmul", kind, x, Bytes.asSlice(&inverse))
  let shifted = run instruction(&mut writer.*, b"fadd", kind, Bytes.asSlice(&scaled), Bytes.asSlice(&offset))
  let wide = integerRepresentation(64, true)
  let rounded = Value {scalar: kind, text: move shifted}
  let quadrantInteger = run emitCast(&mut writer.*, b"fptosi", &rounded, wide)
  let quadrantFloat = run emitCast(&mut writer.*, b"sitofp", &quadrantInteger, kind)
  let partTable = halfPiParts(single)
  let parts: &[u64] = &partTable
  let mut residual = run Bytes.copy(x)
  let mut at = usize.ZERO
  while at < parts.length {
    let part = run hexDouble(parts[at])
    let product = run instruction(&mut writer.*, b"fmul", kind, Bytes.asSlice(&quadrantFloat.text), Bytes.asSlice(&part))
    residual = run instruction(&mut writer.*, b"fsub", kind, Bytes.asSlice(&residual), Bytes.asSlice(&product))
    at = at + usize.ONE
  }
  let squared = run instruction(&mut writer.*, b"fmul", kind, Bytes.asSlice(&residual), Bytes.asSlice(&residual))
  let sineTable = sineCoefficients(single)
  let sineTail = run polynomial(&mut writer.*, kind, &sineTable, Bytes.asSlice(&squared))
  let cubed = run instruction(&mut writer.*, b"fmul", kind, Bytes.asSlice(&residual), Bytes.asSlice(&squared))
  let sineProduct = run instruction(&mut writer.*, b"fmul", kind, Bytes.asSlice(&cubed), Bytes.asSlice(&sineTail))
  let sineValue = run instruction(&mut writer.*, b"fadd", kind, Bytes.asSlice(&residual), Bytes.asSlice(&sineProduct))
  let cosineTable = cosineCoefficients(single)
  let cosineTail = run polynomial(&mut writer.*, kind, &cosineTable, Bytes.asSlice(&squared))
  let halfSquared = run instruction(&mut writer.*, b"fmul", kind, Bytes.asSlice(&half), Bytes.asSlice(&squared))
  let cosineBase = run instruction(&mut writer.*, b"fsub", kind, Bytes.asSlice(&one), Bytes.asSlice(&halfSquared))
  let fourth = run instruction(&mut writer.*, b"fmul", kind, Bytes.asSlice(&squared), Bytes.asSlice(&squared))
  let cosineProduct = run instruction(&mut writer.*, b"fmul", kind, Bytes.asSlice(&fourth), Bytes.asSlice(&cosineTail))
  let cosineValue = run instruction(&mut writer.*, b"fadd", kind, Bytes.asSlice(&cosineBase), Bytes.asSlice(&cosineProduct))
  let quadrant = run instruction(&mut writer.*, b"and", wide, Bytes.asSlice(&quadrantInteger.text), b"3")
  let negativeSine = run fneg(&mut writer.*, kind, Bytes.asSlice(&sineValue))
  let negativeCosine = run fneg(&mut writer.*, kind, Bytes.asSlice(&cosineValue))
  let finite = run quadrantResult(&mut writer.*, kind, Bytes.asSlice(&quadrant), sine, Bytes.asSlice(&sineValue),
    Bytes.asSlice(&cosineValue), Bytes.asSlice(&negativeSine), Bytes.asSlice(&negativeCosine))
  let unordered = run instruction(&mut writer.*, b"fcmp uno", kind, x, x)
  let positiveInfinity = run hexDouble(0x7FF0000000000000)
  let negativeInfinity = run hexDouble(0xFFF0000000000000)
  let above = run instruction(&mut writer.*, b"fcmp oeq", kind, x, Bytes.asSlice(&positiveInfinity))
  let below = run instruction(&mut writer.*, b"fcmp oeq", kind, x, Bytes.asSlice(&negativeInfinity))
  let boolean = booleanRepresentation()
  let infinite = run instruction(&mut writer.*, b"or", boolean, Bytes.asSlice(&above), Bytes.asSlice(&below))
  let nonFinite = run instruction(&mut writer.*, b"or", boolean, Bytes.asSlice(&unordered), Bytes.asSlice(&infinite))
  let isZero = run instruction(&mut writer.*, b"fcmp oeq", kind, x, Bytes.asSlice(&zero))
  let mut atZero = run Bytes.copy(Bytes.asSlice(&one))
  if sine { atZero = run Bytes.copy(x) }
  let withZero = run selectValue(&mut writer.*, Bytes.asSlice(&isZero), kind, Bytes.asSlice(&atZero), Bytes.asSlice(&finite))
  let canonical = run hexDouble(0x7FF8000000000000)
  return Value {scalar: kind, text: run selectValue(&mut writer.*, Bytes.asSlice(&nonFinite), kind, Bytes.asSlice(&canonical),
    Bytes.asSlice(&withZero))}
}

effect fn fneg(writer: &mut Writer, kind: Representation, value: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let name = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&name))
  run append(&mut writer.*, b" = fneg ")
  run typeName(&mut writer.*, kind)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, value)
  run append(&mut writer.*, b"\n")
  return move name
}

// The IEEE 754 totalOrder key: negative values reverse their magnitude order below positive ones.
effect fn totalOrderKey(writer: &mut Writer, bits: &Value) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let negative = run instruction(&mut writer.*, b"icmp slt", bits.scalar, Bytes.asSlice(&bits.text), b"0")
  let sign = run minimumText(integerRepresentation(bits.scalar.bits, true))
  let mask = run selectValue(&mut writer.*, Bytes.asSlice(&negative), bits.scalar, b"-1", Bytes.asSlice(&sign))
  return run instruction(&mut writer.*, b"xor", bits.scalar, Bytes.asSlice(&bits.text), Bytes.asSlice(&mask))
}

effect fn emitScalarBinary(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout],
  operation: ScalarBinary, left: &Operand, right: &Operand, span: Span) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  let lhs = run emitNumeric(&mut writer.*, function, target, layouts, left, span)
  let rhs = run emitNumeric(&mut writer.*, function, target, layouts, right, span)
  let kind = lhs.scalar
  if operation == ScalarBinary.TotalOrder {
    if !isFloating(kind) || !isFloating(rhs.scalar) || kind.bits != rhs.scalar.bits { return run typedFormGap(function, span) }
    let integer = integerRepresentation(kind.bits, true)
    let leftBits = run emitCast(&mut writer.*, b"bitcast", &lhs, integer)
    let rightBits = run emitCast(&mut writer.*, b"bitcast", &rhs, integer)
    let leftKey = run totalOrderKey(&mut writer.*, &leftBits)
    let rightKey = run totalOrderKey(&mut writer.*, &rightBits)
    let ordered = run instruction(&mut writer.*, b"icmp ule", integer, Bytes.asSlice(&leftKey), Bytes.asSlice(&rightKey))
    return Value {scalar: booleanRepresentation(), text: move ordered}
  }
  if !isIntegral(kind) || !isIntegral(rhs.scalar) || kind.bits != rhs.scalar.bits { return run typedFormGap(function, span) }
  let l = Bytes.asSlice(&lhs.text)
  let r = Bytes.asSlice(&rhs.text)
  if operation == ScalarBinary.ShiftLeft || operation == ScalarBinary.ShiftRight {
    let width = run integerText(false, usize.toU64(kind.bits))
    let invalid = run instruction(&mut writer.*, b"icmp uge", kind, r, Bytes.asSlice(&width))
    run trapWhen(&mut writer.*, Bytes.asSlice(&invalid), b"invalid shift count")
    let mut opcode: &[u8] = b"shl"
    if operation == ScalarBinary.ShiftRight {
      opcode = b"lshr"
      if kind.signed { opcode = b"ashr" }
    }
    return Value {scalar: kind, text: run instruction(&mut writer.*, opcode, kind, l, r)}
  }
  let boolean = booleanRepresentation()
  if operation == ScalarBinary.AddOverflows || operation == ScalarBinary.SubtractOverflows || operation == ScalarBinary.MultiplyOverflows {
    let mut stem: &[u8] = b"add"
    if operation == ScalarBinary.SubtractOverflows { stem = b"sub" }
    if operation == ScalarBinary.MultiplyOverflows { stem = b"mul" }
    let pair = run overflowPair(&mut writer.*, stem, kind, l, r)
    return Value {scalar: boolean, text: run pairField(&mut writer.*, kind, Bytes.asSlice(&pair), usize.ONE)}
  }
  if operation == ScalarBinary.DivisionUndefined {
    let zero = run instruction(&mut writer.*, b"icmp eq", kind, r, b"0")
    if !kind.signed { return Value {scalar: boolean, text: move zero} }
    let minimum = run minimumText(kind)
    let lowest = run instruction(&mut writer.*, b"icmp eq", kind, l, Bytes.asSlice(&minimum))
    let negative = run instruction(&mut writer.*, b"icmp eq", kind, r, b"-1")
    let overflow = run instruction(&mut writer.*, b"and", boolean, Bytes.asSlice(&lowest), Bytes.asSlice(&negative))
    return Value {scalar: boolean, text: run instruction(&mut writer.*, b"or", boolean, Bytes.asSlice(&zero), Bytes.asSlice(&overflow))}
  }
  if operation == ScalarBinary.WrappingAdd { return Value {scalar: kind, text: run instruction(&mut writer.*, b"add", kind, l, r)} }
  if operation == ScalarBinary.WrappingSubtract { return Value {scalar: kind, text: run instruction(&mut writer.*, b"sub", kind, l, r)} }
  if operation == ScalarBinary.WrappingMultiply { return Value {scalar: kind, text: run instruction(&mut writer.*, b"mul", kind, l, r)} }
  let mut operands = Vector.make<Bytes>()
  run Vector.append<Bytes>(&mut operands, run Bytes.copy(l))
  if operation == ScalarBinary.RotateLeft || operation == ScalarBinary.RotateRight {
    run Vector.append<Bytes>(&mut operands, run Bytes.copy(l))
    run Vector.append<Bytes>(&mut operands, run Bytes.copy(r))
    let mut funnel: &[u8] = b"fshl"
    if operation == ScalarBinary.RotateRight { funnel = b"fshr" }
    return Value {scalar: kind, text: run callIntrinsic(&mut writer.*, funnel, kind, Vector.asSlice<Bytes>(&operands))}
  }
  run Vector.append<Bytes>(&mut operands, run Bytes.copy(r))
  if operation == ScalarBinary.SaturatingAdd || operation == ScalarBinary.SaturatingSubtract {
    let mut name: &[u8] = b"uadd.sat"
    if kind.signed { name = b"sadd.sat" }
    if operation == ScalarBinary.SaturatingSubtract {
      name = b"usub.sat"
      if kind.signed { name = b"ssub.sat" }
    }
    return Value {scalar: kind, text: run callIntrinsic(&mut writer.*, name, kind, Vector.asSlice<Bytes>(&operands))}
  }
  // A saturating product clamps an overflowing result toward the sign of the exact product.
  let pair = run overflowPair(&mut writer.*, b"mul", kind, l, r)
  let wrapped = run pairField(&mut writer.*, kind, Bytes.asSlice(&pair), usize.ZERO)
  let overflow = run pairField(&mut writer.*, kind, Bytes.asSlice(&pair), usize.ONE)
  let maximum = run maximumText(kind)
  let mut bound = run Bytes.copy(Bytes.asSlice(&maximum))
  if kind.signed {
    let minimum = run minimumText(kind)
    let signs = run instruction(&mut writer.*, b"xor", kind, l, r)
    let negative = run instruction(&mut writer.*, b"icmp slt", kind, Bytes.asSlice(&signs), b"0")
    bound = run selectValue(&mut writer.*, Bytes.asSlice(&negative), kind, Bytes.asSlice(&minimum), Bytes.asSlice(&maximum))
  }
  return Value {scalar: kind, text: run selectValue(&mut writer.*, Bytes.asSlice(&overflow), kind, Bytes.asSlice(&bound), Bytes.asSlice(&wrapped))}
}

// Address transport admits the exact semantic word or data-pointer category, not a storage alias.
enum AddressLane { Unsupported, Pointer, Word }

fn addressLane(ty: &Shared<Type>) -> AddressLane {
  return Shared.with<Type, AddressLane>(ty, fn(value: &Type) -> AddressLane {
    return match &value.* {
      Type.Pointer {..} => AddressLane.Pointer
      Type.Primitive {name} => {
        if same(Bytes.asSlice(&name), b"usize") { return AddressLane.Word }
        return AddressLane.Unsupported
      }
      _ => AddressLane.Unsupported
    }
  })
}

effect fn emitAddressOperand(
  writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout],
  operand: &Operand, expected: AddressLane, span: Span,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  match &operand.* {
    Operand.Copy {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      if addressLane(&address.ty) == expected { return run loadAddress(&mut writer.*, &address) }
    }
    Operand.Move {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      if addressLane(&address.ty) == expected { return run loadAddress(&mut writer.*, &address) }
    }
    Operand.Integer {ty, negative, ..} => {
      if !negative && expected == AddressLane.Word && addressLane(&ty) == expected {
        return run emitOperand(&mut writer.*, function, target, layouts, operand)
      }
    }
    Operand.Null {ty} => {
      if expected == AddressLane.Pointer && addressLane(&ty) == expected {
        return run emitOperand(&mut writer.*, function, target, layouts, operand)
      }
    }
    _ => ()
  }
  let owner = InstanceKey.identity(&function.key)
  fail Gap.make(GapCode.TypedForm, &owner, span)
}

effect fn emitScalarRvalue(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  rvalue: &Rvalue,
  span: Span,
) -> Value ! Gap | OutOfMemoryError ? &mut Allocator {
  return match & rvalue.* {
    Rvalue.SliceLength {place} => {
      let descriptor = run emitPlace(&mut writer.*, function, target, layouts, &place)
      let facts = run sliceFact(layouts, &descriptor.ty, function, span)
      let address = run descriptorLengthAddress(&mut writer.*, target, Bytes.asSlice(&descriptor.text), facts.lengthOffset)
      let name = run temp(&mut writer.*)
      let kind = lengthRepresentation(target)
      run append(&mut writer.*, Bytes.asSlice(&name))
      run append(&mut writer.*, b" = load ")
      run typeName(&mut writer.*, kind)
      run append(&mut writer.*, b", ptr ")
      run append(&mut writer.*, Bytes.asSlice(&address))
      run memoryAlignment(&mut writer.*, offsetAlignment(descriptor.alignment, facts.lengthOffset))
      return Value {scalar: kind, text: move name}
    }
    Rvalue.SliceData {place} => {
      let descriptor = run emitPlace(&mut writer.*, function, target, layouts, &place)
      let name = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&name))
      run append(&mut writer.*, b" = load ptr, ptr ")
      run append(&mut writer.*, Bytes.asSlice(&descriptor.text))
      run memoryAlignment(&mut writer.*, descriptor.alignment)
      return Value {scalar: pointerRepresentation(target), text: move name}
    }
    Rvalue.PointerOffset {pointer, index, element} => {
      let base = run emitOperand(&mut writer.*, function, target, layouts, &pointer)
      let selected = run emitOperand(&mut writer.*, function, target, layouts, &index)
      let facts = run layoutOf(layouts, &element, function, span)
      let stride = match move Metrics.stride(&facts) {
        Option<usize>.Some {value} => value
        Option<usize>.None => {
          let owner = InstanceKey.identity(&function.key)
          fail Gap.make(GapCode.ScalarLayout, &owner, span)
        }
      }
      let offset = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&offset))
      run append(&mut writer.*, b" = mul ")
      run typeName(&mut writer.*, selected.scalar)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&selected.text))
      run append(&mut writer.*, b", ")
      run decimal(&mut writer.*, stride)
      run append(&mut writer.*, b"\n")
      let name = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&name))
      run append(&mut writer.*, b" = getelementptr i8, ptr ")
      run append(&mut writer.*, Bytes.asSlice(&base.text))
      run append(&mut writer.*, b", ")
      run typeName(&mut writer.*, selected.scalar)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&offset))
      run append(&mut writer.*, b"\n")
      return Value {scalar: pointerRepresentation(target), text: move name}
    }
    Rvalue.Slice {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.TypedForm, &owner, span)
    }
    Rvalue.ContextOf {place} => Value {scalar: pointerRepresentation(target), text: run companionAddress(function, place.local)}
    Rvalue.ContextHandle {address} => {
      let base = run emitOperand(&mut writer.*, function, target, layouts, &address)
      let slot = run byteOffset(&mut writer.*, Bytes.asSlice(&base.text), companionHandleOffset(target))
      let name = run temp(&mut writer.*)
      let kind = lengthRepresentation(target)
      run append(&mut writer.*, Bytes.asSlice(&name))
      run append(&mut writer.*, b" = load ")
      run typeName(&mut writer.*, kind)
      run append(&mut writer.*, b", ptr ")
      run append(&mut writer.*, Bytes.asSlice(&slot))
      run append(&mut writer.*, b"\n")
      return Value {scalar: kind, text: move name}
    }
    // Stored by its statement, which retains the exact instance identity.
    Rvalue.FunctionAddress {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.TypedForm, &owner, span)
    }
    // Loaded by its statement, which retains the classified C object.
    Rvalue.ForeignStatic {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.TypedForm, &owner, span)
    }
    // A frame-based instance's step reads its transfer record's package word.
    Rvalue.RunningPackage => Value {scalar: pointerRepresentation(target),
      text: run loadWordAt(&mut writer.*, b"%transfer", Coroutine.transferPackage(wordSize(target)))}
    // One admitted fragment is one inline-asm call: unit fragments return `void`, every operand
    // is one word or pointer lane, and the contract supplies the clobber and memory effects.
    Rvalue.Assembly {template, constraints, clobbers, memory, sideEffects, noReturn, inputs, ty} => {
      let operands = Vector.asSlice<Operand>(&inputs)
      let mut values = Vector.make<Value>()
      let mut at = usize.ZERO
      while at < operands.length {
        let lowered = run emitOperand(&mut writer.*, function, target, layouts, &operands[at])
        run Vector.append<Value>(&mut values, move lowered)
        at = at + usize.ONE
      }
      let result = scalar(&ty, target)
      let mut name = Bytes.make()
      if !result.unit {
        name = run temp(&mut writer.*)
        run append(&mut writer.*, Bytes.asSlice(&name))
        run append(&mut writer.*, b" = ")
      }
      run append(&mut writer.*, b"call ")
      run typeName(&mut writer.*, result)
      run append(&mut writer.*, b" asm ")
      if sideEffects { run append(&mut writer.*, b"sideeffect ") }
      run quoted(&mut writer.*, Bytes.asSlice(&template))
      run append(&mut writer.*, b", ")
      let contract = run NativeAssembly.llvmConstraints(target.id(), Bytes.asSlice(&constraints),
        Bytes.asSlice(&clobbers), memory)
      run quoted(&mut writer.*, Bytes.asSlice(&contract))
      run append(&mut writer.*, b"(")
      let lowered = Vector.asSlice<Value>(&values)
      at = usize.ZERO
      while at < lowered.length {
        if at != usize.ZERO { run append(&mut writer.*, b", ") }
        run typeName(&mut writer.*, lowered[at].scalar)
        run append(&mut writer.*, b" ")
        run append(&mut writer.*, Bytes.asSlice(&lowered[at].text))
        at = at + usize.ONE
      }
      run append(&mut writer.*, b")")
      if noReturn { run append(&mut writer.*, b" noreturn") }
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, NativeAssembly.effects(memory, sideEffects))
      run append(&mut writer.*, b"\n")
      return Value {scalar: result, text: move name}
    }
    Rvalue.Ref {place, ..} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      return Value {
        scalar: Representation {aggregate: false, size: usize.ZERO,
          bits: u32.toUsize(Target.pointerBits(target)),
          signed: false,
          unit: false,
          pointer: true,
          floating: false,
        },
        text: move address.text,
      }
    }
    Rvalue.AddressOf {place, ..} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      return Value {
        scalar: Representation {aggregate: false, size: usize.ZERO,
          bits: u32.toUsize(Target.pointerBits(target)),
          signed: false,
          unit: false,
          pointer: true,
          floating: false,
        },
        text: move address.text,
      }
    }
    Rvalue.Aggregate {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.TypedForm, &owner, span)
    }
    Rvalue.Inject {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.TypedForm, &owner, span)
    }
    Rvalue.Variant {..} => {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.TypedForm, &owner, span)
    }
    Rvalue.Discriminant {place} => {
      let address = run emitPlace(&mut writer.*, function, target, layouts, &place)
      let kind = tagRepresentation(run taggedFact(layouts, &address.ty, function, span))
      let name = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&name))
      run append(&mut writer.*, b" = load ")
      run typeName(&mut writer.*, kind)
      run append(&mut writer.*, b", ptr ")
      run append(&mut writer.*, Bytes.asSlice(&address.text))
      run memoryAlignment(&mut writer.*, address.alignment)
      return Value {scalar: kind, text: move name}
    }
    Rvalue.Use {value} => run emitOperand(&mut writer.*, function, target, layouts, &value)
    Rvalue.Convert {value, ty} => run emitConvert(&mut writer.*, function, target, layouts, &value, &ty, span)
    Rvalue.Fits {value, ty} => run emitFits(&mut writer.*, function, target, layouts, &value, &ty, span)
    Rvalue.ScalarUnary {operation, value} => run emitScalarUnary(&mut writer.*, function, target, layouts, operation, &value, span)
    Rvalue.ScalarBinary {operation, left, right} => run emitScalarBinary(&mut writer.*, function, target, layouts, operation, &left, &right, span)
    Rvalue.AddressIntegerConversion {operand, destinationType} => {
      let lane = addressLane(&destinationType)
      // This primitive is native data-address transport, never Wasm linear-memory policy.
      if lane == AddressLane.Unsupported || same(Target.objectFormat(target), b"wasm") || Target.dataAddressSpace(target) != 0 {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.make(GapCode.TypedForm, &owner, span)
      }
      let mut expected = AddressLane.Pointer
      if lane == AddressLane.Pointer { expected = AddressLane.Word }
      let input = run emitAddressOperand(&mut writer.*, function, target, layouts, &operand, expected, span)
      let output = scalar(&destinationType, target)
      let bits = u32.toUsize(Target.pointerBits(target))
      if input.scalar.bits != bits || output.bits != bits {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.make(GapCode.TypedForm, &owner, span)
      }
      let name = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&name))
      if lane == AddressLane.Word { run append(&mut writer.*, b" = ptrtoint ") }
      else { run append(&mut writer.*, b" = inttoptr ") }
      run typeName(&mut writer.*, input.scalar)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&input.text))
      run append(&mut writer.*, b" to ")
      run typeName(&mut writer.*, output)
      run append(&mut writer.*, b"\n")
      return Value {scalar: output, text: move name}
    }
    Rvalue.Bitcast {value, ty} => {
      let input = run emitOperand(&mut writer.*, function, target, layouts, &value)
      let output = scalar(&ty, target)
      if input.scalar.bits != output.bits || input.scalar.floating == output.floating || input.scalar.pointer || output.pointer || input.scalar.unit || output.unit {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.make(GapCode.TypedForm, &owner, span)
      }
      let name = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&name))
      run append(&mut writer.*, b" = bitcast ")
      run typeName(&mut writer.*, input.scalar)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&input.text))
      run append(&mut writer.*, b" to ")
      run typeName(&mut writer.*, output)
      run append(&mut writer.*, b"\n")
      return Value {scalar: output, text: move name}
    }
    Rvalue.Unary {operation, value} => {
      let input = run emitOperand(&mut writer.*, function, target, layouts, &value)
      if input.scalar.floating && operation == PrefixOperator.Negate {
        let name = run temp(&mut writer.*)
        run append(&mut writer.*, Bytes.asSlice(&name))
        run append(&mut writer.*, b" = fneg ")
        run typeName(&mut writer.*, input.scalar)
        run append(&mut writer.*, b" ")
        run append(&mut writer.*, Bytes.asSlice(&input.text))
        run append(&mut writer.*, b"\n")
        return Value {scalar: input.scalar, text: move name}
      }
      if input.scalar.floating || input.scalar.pointer {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.make(GapCode.TypedForm, &owner, span)
      }
      if operation == PrefixOperator.Negate {
        let zero = Value {scalar: input.scalar, text: run Bytes.copy(b"0")}
        return run checkedBinary(&mut writer.*, b"sub", &zero, &input)
      }
      let name = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&name))
      run append(&mut writer.*, b" = xor ")
      run typeName(&mut writer.*, input.scalar)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&input.text))
      run append(&mut writer.*, b", -1")
      run append(&mut writer.*, b"\n")
      return Value {scalar: input.scalar, text: move name}
    }
    Rvalue.Binary {operation, left, right} => {
      let lhs = run emitOperand(&mut writer.*, function, target, layouts, &left)
      let rhs = run emitOperand(&mut writer.*, function, target, layouts, &right)
      if lhs.scalar.floating {
        let arithmetic = floatOpcode(operation)
        if arithmetic.length != usize.ZERO {
          return Value {scalar: lhs.scalar, text: run instruction(&mut writer.*, arithmetic, lhs.scalar,
            Bytes.asSlice(&lhs.text), Bytes.asSlice(&rhs.text))}
        }
        let predicate = floatPredicate(operation)
        if predicate.length == usize.ZERO {
          let owner = InstanceKey.identity(&function.key)
          fail Gap.make(GapCode.TypedForm, &owner, span)
        }
        let name = run temp(&mut writer.*)
        run append(&mut writer.*, Bytes.asSlice(&name))
        run append(&mut writer.*, b" = fcmp ")
        run append(&mut writer.*, predicate)
        run append(&mut writer.*, b" ")
        run typeName(&mut writer.*, lhs.scalar)
        run append(&mut writer.*, b" ")
        run append(&mut writer.*, Bytes.asSlice(&lhs.text))
        run append(&mut writer.*, b", ")
        run append(&mut writer.*, Bytes.asSlice(&rhs.text))
        run append(&mut writer.*, b"\n")
        return Value {
          scalar: Representation {aggregate: false, size: usize.ZERO,
            bits: usize.ONE,
            signed: false,
            unit: false,
            pointer: false,
            floating: false,
          },
          text: move name,
        }
      }
      if lhs.scalar.pointer {
        // Addresses compare only for identity, such as a null observer or cause (N4).
        if operation != InfixOperator.Equals && operation != InfixOperator.NotEquals {
          let owner = InstanceKey.identity(&function.key)
          fail Gap.make(GapCode.TypedForm, &owner, span)
        }
        let name = run temp(&mut writer.*)
        run append(&mut writer.*, Bytes.asSlice(&name))
        run append(&mut writer.*, integerOpcode(operation, false))
        run append(&mut writer.*, b"ptr ")
        run append(&mut writer.*, Bytes.asSlice(&lhs.text))
        run append(&mut writer.*, b", ")
        run append(&mut writer.*, Bytes.asSlice(&rhs.text))
        run append(&mut writer.*, b"\n")
        return Value {scalar: Representation {aggregate: false, size: usize.ZERO, bits: usize.ONE, signed: false, unit: false,
          pointer: false, floating: false}, text: move name}
      }
      match operation {
        InfixOperator.Add => {
          return run checkedBinary(&mut writer.*, b"add", &lhs, &rhs)
        }
        InfixOperator.Subtract => {
          return run checkedBinary(&mut writer.*, b"sub", &lhs, &rhs)
        }
        InfixOperator.Multiply => {
          return run checkedBinary(&mut writer.*, b"mul", &lhs, &rhs)
        }
        InfixOperator.Divide => {
          return run guardedDivision(&mut writer.*, function, &lhs, &rhs, false, span)
        }
        InfixOperator.Remainder => {
          return run guardedDivision(&mut writer.*, function, &lhs, &rhs, true, span)
        }
        _ => {}
      }
      let name = run temp(&mut writer.*)
      let comparison = operation == InfixOperator.Equals || operation == InfixOperator.NotEquals || operation == InfixOperator.LessThan || operation == InfixOperator.LessOrEqual || operation == InfixOperator.GreaterThan || operation == InfixOperator.GreaterOrEqual
      let opcode = integerOpcode(operation, lhs.scalar.signed)
      if opcode.length == usize.ZERO {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.make(GapCode.TypedForm, &owner, span)
      }
      run append(&mut writer.*, Bytes.asSlice(&name))
      run append(&mut writer.*, opcode)
      run typeName(&mut writer.*, lhs.scalar)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&lhs.text))
      run append(&mut writer.*, b", ")
      run append(&mut writer.*, Bytes.asSlice(&rhs.text))
      run append(&mut writer.*, b"\n")
      let mut kind = lhs.scalar
      if comparison {
        kind = Representation {aggregate: false, size: usize.ZERO, bits: usize.ONE, signed: false, unit: false, pointer: false, floating: false}
      }
      return Value {scalar: kind, text: move name}
    }
  }
}

effect fn storeValue(writer: &mut Writer, address: &Address, value: &Value) -> ()
! OutOfMemoryError ? &mut Allocator {
  if address.representation.unit { return () }
  // Source and destination may overlap, as when a member is injected into a slot of its own place.
  if address.representation.aggregate {
    run append(&mut writer.*, b"call void @llvm.memmove.p0.p0.i64(ptr align ")
    run decimal(&mut writer.*, address.alignment)
    run append(&mut writer.*, b" ")
    run append(&mut writer.*, Bytes.asSlice(&address.text))
    run append(&mut writer.*, b", ptr ")
    run append(&mut writer.*, Bytes.asSlice(&value.text))
    run append(&mut writer.*, b", i64 ")
    run decimal(&mut writer.*, address.representation.size)
    return run append(&mut writer.*, b", i1 false)\n")
  }
  run append(&mut writer.*, b"store ")
  run typeName(&mut writer.*, address.representation)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&value.text))
  run append(&mut writer.*, b", ptr ")
  run append(&mut writer.*, Bytes.asSlice(&address.text))
  return run memoryAlignment(&mut writer.*, address.alignment)
}

fn sameDeclaration(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  let firstAddress = Shared.with<DeclarationId, usize>(
    left,
    fn(id: &DeclarationId) -> usize {
      return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(id))
    },
  )
  let secondAddress = Shared.with<DeclarationId, usize>(
    right,
    fn(id: &DeclarationId) -> usize {
      return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(id))
    },
  )
  if firstAddress == secondAddress {
    return true
  }
  return Shared.with<DeclarationId, bool>(
    left,
    fn(id: &DeclarationId) -> bool {
      return sameDeclarationRight(id, right)
    },
  )
}

effect fn emitAssign(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  destination: &Place,
  value: &Rvalue,
  span: Span,
) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let address = run emitPlace(&mut writer.*, function, target, layouts, destination)
  if let Rvalue.Aggregate {fields} = &value.* {
    let operands = Vector.asSlice<AggregateField>(&fields)
    let mut fieldAt = usize.ZERO
    while fieldAt < operands.length {
      let selectedField = run projectField(&mut writer.*, function, target, layouts,
        &address, operands[fieldAt].index, span)
      let operand = run emitOperand(&mut writer.*, function, target, layouts, &operands[fieldAt].value)
      run storeValue(&mut writer.*, &selectedField, &operand)
      fieldAt = fieldAt + usize.ONE
    }
    return ()
  }
  if let Rvalue.Inject {tag, value: member} = &value.* {
    // The tag is stored first; the member is stored at the layout's payload offset.
    let facts = run taggedFact(layouts, &address.ty, function, span)
    run append(&mut writer.*, b"store ")
    run typeName(&mut writer.*, tagRepresentation(facts))
    run append(&mut writer.*, b" ")
    run decimal(&mut writer.*, tag)
    run append(&mut writer.*, b", ptr ")
    run append(&mut writer.*, Bytes.asSlice(&address.text))
    run memoryAlignment(&mut writer.*, address.alignment)
    let operand = run emitOperand(&mut writer.*, function, target, layouts, &member)
    let payload = run byteOffset(&mut writer.*, Bytes.asSlice(&address.text), facts.payloadOffset)
    let slot = Address {ty: Shared.clone<Type>(&address.ty), text: move payload,
      alignment: offsetAlignment(address.alignment, facts.payloadOffset), representation: operand.scalar}
    run storeValue(&mut writer.*, &slot, &operand)
    return ()
  }
  if let Rvalue.Variant {tag, fields} = &value.* {
    // The tag is stored first; each operand is stored at its variant field offset.
    let facts = run taggedFact(layouts, &address.ty, function, span)
    run append(&mut writer.*, b"store ")
    run typeName(&mut writer.*, tagRepresentation(facts))
    run append(&mut writer.*, b" ")
    run decimal(&mut writer.*, tag)
    run append(&mut writer.*, b", ptr ")
    run append(&mut writer.*, Bytes.asSlice(&address.text))
    run memoryAlignment(&mut writer.*, address.alignment)
    let operands = Vector.asSlice<AggregateField>(&fields)
    let mut fieldAt = usize.ZERO
    while fieldAt < operands.length {
      let selected = run variantFieldFact(layouts, &address.ty, tag, operands[fieldAt].index, function, span)
      let operand = run emitOperand(&mut writer.*, function, target, layouts, &operands[fieldAt].value)
      let fieldAddress = run byteOffset(&mut writer.*, Bytes.asSlice(&address.text), selected.offset)
      let slot = Address {ty: move selected.ty, text: move fieldAddress,
        alignment: offsetAlignment(address.alignment, selected.offset), representation: operand.scalar}
      run storeValue(&mut writer.*, &slot, &operand)
      fieldAt = fieldAt + usize.ONE
    }
    return ()
  }
  if let Rvalue.Slice {data, count} = &value.* {
    let facts = run sliceFact(layouts, &address.ty, function, span)
    let input = run emitOperand(&mut writer.*, function, target, layouts, &data)
    let length = run emitOperand(&mut writer.*, function, target, layouts, &count)
    let kind = length.scalar
    if !input.scalar.pointer || kind.aggregate || kind.pointer || kind.floating || kind.unit
      || kind.signed || kind.bits != lengthRepresentation(target).bits {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.SliceLayout, &owner, span)
    }
    run append(&mut writer.*, b"store ptr ")
    run append(&mut writer.*, Bytes.asSlice(&input.text))
    run append(&mut writer.*, b", ptr ")
    run append(&mut writer.*, Bytes.asSlice(&address.text))
    run memoryAlignment(&mut writer.*, address.alignment)
    let lengthAddress = run descriptorLengthAddress(&mut writer.*, target, Bytes.asSlice(&address.text), facts.lengthOffset)
    run append(&mut writer.*, b"store ")
    run typeName(&mut writer.*, lengthRepresentation(target))
    run append(&mut writer.*, b" ")
    run append(&mut writer.*, Bytes.asSlice(&length.text))
    run append(&mut writer.*, b", ptr ")
    run append(&mut writer.*, Bytes.asSlice(&lengthAddress))
    run memoryAlignment(&mut writer.*, offsetAlignment(address.alignment, facts.lengthOffset))
    return ()
  }
  let selected = run emitScalarRvalue(&mut writer.*, function, target, layouts, value, span)
  run storeValue(&mut writer.*, &address, &selected)
  return ()
}

effect fn emitReturn(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  span: Span,
) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let resultLayout = run layoutOf(layouts, &function.result, function, span)
  let kind = storageRepresentation(&function.result, target, resultLayout)
  let fallible = failureLocal(function) != usize.MAX
  if kind.unit {
    if fallible { run append(&mut writer.*, b"ret i1 0\n") }
    else { run append(&mut writer.*, b"ret void\n") }
    return ()
  }
  let returned = Operand.Copy {
    place: Place {local: usize.ZERO, projections: Vector.make<Projection>()},
  }
  let value = run emitOperand(&mut writer.*, function, target, layouts, &returned)
  // A fallible function returns its status and writes success to the caller's out-slot (D3).
  if fallible {
    let output = Address {ty: Shared.clone<Type>(&function.result), text: run Bytes.copy(b"%out"),
      alignment: resultLayout.alignment, representation: kind}
    run storeValue(&mut writer.*, &output, &value)
    run append(&mut writer.*, b"ret i1 0\n")
    return ()
  }
  if kind.aggregate {
    let output = Address {ty: Shared.clone<Type>(&function.result), text: run Bytes.copy(b"%out"),
      alignment: resultLayout.alignment, representation: kind}
    run storeValue(&mut writer.*, &output, &value)
    run append(&mut writer.*, b"ret void\n")
    return ()
  }
  run append(&mut writer.*, b"ret ")
  run typeName(&mut writer.*, kind)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&value.text))
  run append(&mut writer.*, b"\n")
  return ()
}

/// The `Provider` locals of a function in requirement-key order.
fn providerLocalAt(function: &MirFunction, index: usize) -> usize {
  let locals = Vector.asSlice<Local>(&function.locals)
  let mut at = usize.ZERO
  while at < locals.length {
    let found = match &locals[at].kind { LocalKind.Provider {index: own} => own == index _ => false }
    if found { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

/// The hidden `Observer` (0) or `Cause` (1) local, or `usize.MAX` when the program does not
/// observe diagnostics (failure observer note N1, N2).
fn diagnosticLocal(function: &MirFunction, wanted: usize) -> usize {
  let locals = Vector.asSlice<Local>(&function.locals)
  let mut at = usize.ZERO
  while at < locals.length {
    let kind = match &locals[at].kind {
      LocalKind.Observer => usize.ZERO
      LocalKind.Cause => usize.ONE
      _ => usize.MAX
    }
    if kind == wanted { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

/// The words of a failure context companion: identity and label descriptors, then the observer
/// pool handle (failure observer note N3, N7).
fn companionWords() -> usize { return 5 }

// The byte offset of a companion's pool handle, after its two text descriptors.
fn companionHandleOffset(target: &Target) -> usize { return wordSize(target) * 4 }

// The address of failure slot `local`'s context companion: the caller's `%context` for the
// `Failure` local, else this function's own `%cN` (failure observer note N3).
effect fn companionAddress(function: &MirFunction, local: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  if local == failureLocal(function) { return run Bytes.copy(b"%context") }
  let mut name = Writer {text: run Bytes.copy(b"%c"), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
  run decimal(&mut name, local)
  return move name.text
}

effect fn addLocal(listed: &mut Vector<usize>, local: usize, skipped: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if local == skipped { return () }
  let entries = Vector.asSlice<usize>(&listed.*)
  let mut at = usize.ZERO
  while at < entries.length {
    if entries[at] == local { return () }
    at = at + usize.ONE
  }
  return run Vector.append<usize>(&mut listed.*, local)
}

// The failure slots that own a companion: those a context statement, a selected cause or a
// call edge of a program that observes diagnostics names, except `Failure`.
effect fn companionLocals(function: &MirFunction) -> Vector<usize> ! OutOfMemoryError ? &mut Allocator {
  let skipped = failureLocal(function)
  let mut listed = Vector.make<usize>()
  let blocks = Vector.asSlice<Block>(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<Statement>(&blocks[at].statements)
    let mut statementAt = usize.ZERO
    while statementAt < statements.length {
      match &statements[statementAt] {
        Statement.FailureContext {destination, source, ..} => {
          run addLocal(&mut listed, destination.local, skipped)
          if let Option<Place>.Some {value: from} = &source { run addLocal(&mut listed, from.local, skipped) }
        }
        Statement.Assign {value, ..} => {
          if let Rvalue.ContextOf {place} = &value { run addLocal(&mut listed, place.local, skipped) }
        }
        _ => {}
      }
      statementAt = statementAt + usize.ONE
    }
    if let Terminator.Call {failure, diagnostics, ..} = &blocks[at].terminator {
      if let Option<FailureEdge>.Some {value: edge} = &failure {
        if let Option<Diagnostics>.Some {..} = &diagnostics { run addLocal(&mut listed, edge.destination.local, skipped) }
      }
    }
    at = at + usize.ONE
  }
  return move listed
}

// Stores one string descriptor `{address, length}` at `offset` of a companion.
effect fn storeText(writer: &mut Writer, companion: &[u8], offset: usize, word: usize, address: &[u8], length: &[u8]) -> ()
! OutOfMemoryError ? &mut Allocator {
  let data = run byteOffset(&mut writer.*, companion, offset)
  run append(&mut writer.*, b"store ptr ")
  run append(&mut writer.*, address)
  run append(&mut writer.*, b", ptr ")
  run append(&mut writer.*, Bytes.asSlice(&data))
  run append(&mut writer.*, b"\n")
  let size = run byteOffset(&mut writer.*, companion, offset + word)
  run append(&mut writer.*, b"store i")
  run decimal(&mut writer.*, word * 8)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, length)
  run append(&mut writer.*, b", ptr ")
  run append(&mut writer.*, Bytes.asSlice(&size))
  return run append(&mut writer.*, b"\n")
}

effect fn decimalText(value: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
  run decimal(&mut text, value)
  return move text.text
}

// Writes a failure slot's companion `[identity, label, handle]` (failure observer note N3, N7): carried
// word by word from `source`'s, or originated from the function's context table, selecting a union's
// active member identity by its tag.
effect fn emitFailureContext(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout],
  destination: &Place, source: &Option<Place>, origin: Origin) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let word = u32.toUsize(Target.pointerBits(target)) / 8
  let into = run companionAddress(function, destination.local)
  if let Option<Place>.Some {value: from} = &source.* {
    let carried = run companionAddress(function, from.local)
    let mut part = usize.ZERO
    while part < companionWords() {
      let read = run byteOffset(&mut writer.*, Bytes.asSlice(&carried), part * word)
      let written = run byteOffset(&mut writer.*, Bytes.asSlice(&into), part * word)
      let value = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&value))
      run append(&mut writer.*, b" = load i")
      run decimal(&mut writer.*, word * 8)
      run append(&mut writer.*, b", ptr ")
      run append(&mut writer.*, Bytes.asSlice(&read))
      run append(&mut writer.*, b"\nstore i")
      run decimal(&mut writer.*, word * 8)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&value))
      run append(&mut writer.*, b", ptr ")
      run append(&mut writer.*, Bytes.asSlice(&written))
      run append(&mut writer.*, b"\n")
      part = part + usize.ONE
    }
    return ()
  }
  let texts = Vector.asSlice<ContextText>(&function.contexts)
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < texts.length && found == usize.MAX {
    if texts[at].origin.syntax.index == origin.syntax.index && texts[at].origin.span.start == origin.span.start { found = at }
    at = at + usize.ONE
  }
  if found == usize.MAX {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.make(GapCode.TypedForm, &owner, origin.span)
  }
  let identities = Vector.asSlice<Bytes>(&texts[found].identities)
  let mut address = run staticBytes(&mut writer.*, Bytes.asSlice(&identities[usize.ZERO]))
  let mut length = run decimalText(Bytes.length(&identities[usize.ZERO]))
  if identities.length > usize.ONE {
    // The active member's tag selects its identity.
    let slot = run emitPlace(&mut writer.*, function, target, layouts, destination)
    let kind = tagRepresentation(run taggedFact(layouts, &slot.ty, function, origin.span))
    let tag = run temp(&mut writer.*)
    run append(&mut writer.*, Bytes.asSlice(&tag))
    run append(&mut writer.*, b" = load ")
    run typeName(&mut writer.*, kind)
    run append(&mut writer.*, b", ptr ")
    run append(&mut writer.*, Bytes.asSlice(&slot.text))
    run append(&mut writer.*, b"\n")
    let mut member = usize.ONE
    while member < identities.length {
      let candidate = run staticBytes(&mut writer.*, Bytes.asSlice(&identities[member]))
      let matched = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&matched))
      run append(&mut writer.*, b" = icmp eq ")
      run typeName(&mut writer.*, kind)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&tag))
      run append(&mut writer.*, b", ")
      run decimal(&mut writer.*, member)
      run append(&mut writer.*, b"\n")
      let selected = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&selected))
      run append(&mut writer.*, b" = select i1 ")
      run append(&mut writer.*, Bytes.asSlice(&matched))
      run append(&mut writer.*, b", ptr ")
      run append(&mut writer.*, Bytes.asSlice(&candidate))
      run append(&mut writer.*, b", ptr ")
      run append(&mut writer.*, Bytes.asSlice(&address))
      run append(&mut writer.*, b"\n")
      let measured = run temp(&mut writer.*)
      run append(&mut writer.*, Bytes.asSlice(&measured))
      run append(&mut writer.*, b" = select i1 ")
      run append(&mut writer.*, Bytes.asSlice(&matched))
      run append(&mut writer.*, b", i")
      run decimal(&mut writer.*, word * 8)
      run append(&mut writer.*, b" ")
      run decimal(&mut writer.*, Bytes.length(&identities[member]))
      run append(&mut writer.*, b", i")
      run decimal(&mut writer.*, word * 8)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&length))
      run append(&mut writer.*, b"\n")
      address = move selected
      length = move measured
      member = member + usize.ONE
    }
  }
  run storeText(&mut writer.*, Bytes.asSlice(&into), usize.ZERO, word, Bytes.asSlice(&address), Bytes.asSlice(&length))
  let label = run staticBytes(&mut writer.*, Bytes.asSlice(&texts[found].label))
  let labelLength = run decimalText(Bytes.length(&texts[found].label))
  return run storeText(&mut writer.*, Bytes.asSlice(&into), word + word, word, Bytes.asSlice(&label), Bytes.asSlice(&labelLength))
}

/// The `Failure` local of a fallible function, or `usize.MAX` when it cannot fail.
fn failureLocal(function: &MirFunction) -> usize {
  let locals = Vector.asSlice<Local>(&function.locals)
  let mut at = usize.ZERO
  while at < locals.length {
    let failure = match &locals[at].kind { LocalKind.Failure => true _ => false }
    if failure { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

// `Fail` writes the failure value to the caller's failure out-slot and returns status 1 (D3).
effect fn emitFail(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout], span: Span) -> ()
! Gap | OutOfMemoryError ? &mut Allocator {
  let local = failureLocal(function)
  if local == usize.MAX {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.make(GapCode.TypedForm, &owner, span)
  }
  let locals = Vector.asSlice<Local>(&function.locals)
  let failureLayout = run layoutOf(layouts, &locals[local].ty, function, span)
  let kind = storageRepresentation(&locals[local].ty, target, failureLayout)
  if !kind.unit {
    let failed = Operand.Copy {place: Place {local: local, projections: Vector.make<Projection>()}}
    let value = run emitOperand(&mut writer.*, function, target, layouts, &failed)
    let output = Address {ty: Shared.clone<Type>(&locals[local].ty), text: run Bytes.copy(b"%fail"),
      alignment: failureLayout.alignment, representation: kind}
    run storeValue(&mut writer.*, &output, &value)
  }
  run append(&mut writer.*, b"ret i1 1\n")
  return ()
}

/// Returns the last foreign signature declared by `declaration`, or `usize.MAX` when none is.
fn foreignSignatureIndex(foreign: &[CAbi.Signature], declaration: &Shared<DeclarationId>) -> usize {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < foreign.length {
    if sameDeclaration(declaration, &foreign[at].declaration) {
      found = at
    }
    at = at + usize.ONE
  }
  return found
}

// Authenticate a tail's actual source before loading, then promote that one materialized value.
effect fn emitVariadicArgument(writer: &mut Writer, function: &MirFunction, target: &Target,
  layouts: &[TypeLayout], operand: &Operand, argument: &CAbi.VariadicArgument, span: Span) -> Value
! Gap | OutOfMemoryError ? &mut Allocator {
  let owner = InstanceKey.identity(&function.key)
  let mut address = Option.none<Address>()
  if let Operand.Copy {place: source} = &operand.* {
    address = Option.some<Address>(run emitPlace(&mut writer.*, function, target, layouts, &source))
  }
  if let Operand.Move {place: source} = &operand.* {
    address = Option.some<Address>(run emitPlace(&mut writer.*, function, target, layouts, &source))
  }
  let mut input = Value {scalar: scalar(&argument.sourceType, target), text: Bytes.make()}
  match move address {
    Option<Address>.Some {value: sourceAddress} => {
      if !(run CAbi.validVariadic(argument, &sourceAddress.ty)) { fail Gap.make(GapCode.CAbiVariadic, &owner, span) }
      input = run loadAddress(&mut writer.*, &sourceAddress)
    }
    Option<Address>.None => {
      if let Operand.Integer {ty: sourceType, ..} = &operand.* {
        if !(run CAbi.validVariadic(argument, &sourceType)) { fail Gap.make(GapCode.CAbiVariadic, &owner, span) }
      } else { fail Gap.make(GapCode.CAbiVariadic, &owner, span) }
      input = run emitOperand(&mut writer.*, function, target, layouts, operand)
    }
  }
  let source = scalar(&argument.sourceType, target)
  let promoted = scalar(&argument.promotedType, target)
  if input.scalar.aggregate || input.scalar.unit || input.scalar.pointer || input.scalar.floating
    || input.scalar.bits != source.bits || input.scalar.signed != source.signed {
    fail Gap.make(GapCode.CAbiVariadic, &owner, span)
  }
  if source.bits < promoted.bits {
    if source.signed { return run emitCast(&mut writer.*, b"sext", &input, promoted) }
    return run emitCast(&mut writer.*, b"zext", &input, promoted)
  }
  if source.bits != promoted.bits || source.signed != promoted.signed {
    fail Gap.make(GapCode.CAbiVariadic, &owner, span)
  }
  return move input
}

// LLVM needs the actual variadic function type even when this invocation has no unnamed lanes.
effect fn variadicFunctionType(writer: &mut Writer, signature: &CAbi.Signature, span: Span) -> ()
! Gap | OutOfMemoryError ? &mut Allocator {
  run append(&mut writer.*, b" (")
  let parameters = Vector.asSlice<CAbi.Lane>(&signature.parameters)
  let mut at = usize.ZERO
  while at < parameters.length {
    if at > usize.ZERO { run append(&mut writer.*, b", ") }
    run laneType(&mut writer.*, &parameters[at], &signature.declaration, span)
    at = at + usize.ONE
  }
  run append(&mut writer.*, b", ...)")
  return ()
}

effect fn emitCall(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  foreign: &[CAbi.Signature],
  identities: &[InstanceIdentity],
  callee: &Callee,
  arguments: &Vector<Operand>,
  providers: &Vector<Operand>,
  diagnostics: &Option<Diagnostics>,
  destination: &Place,
  normal: usize,
  failure: &Option<FailureEdge>,
  span: Span,
) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut foreignIndex = usize.MAX
  if let Callee.Extern {declaration, variadicArguments} = &callee.* {
    foreignIndex = foreignSignatureIndex(foreign, &declaration)
    if foreignIndex == usize.MAX {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.ForeignAbi, &owner, span)
    }
    let signature = &foreign[foreignIndex]
    let fixed = Vector.length<CAbi.Lane>(&signature.parameters)
    let actual = Vector.length<Operand>(arguments)
    let tails = Vector.length<CAbi.VariadicArgument>(&variadicArguments)
    if signature.global || actual < fixed || (!signature.variadic && actual != fixed)
      || tails != actual - fixed || (signature.variadic && fixed == usize.ZERO) {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.CAbiVariadic, &owner, span)
    }
    if Vector.length<Operand>(providers) != usize.ZERO {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.ForeignAbi, &owner, span)
    }
    if let Option<Diagnostics>.Some {..} = &diagnostics.* {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.ForeignAbi, &owner, span)
    }
    if let Option<FailureEdge>.Some {..} = &failure.* {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.ForeignAbi, &owner, span)
    }
  }
  let output = run emitPlace(&mut writer.*, function, target, layouts, destination)
  let kind = output.representation
  if foreignIndex != usize.MAX {
    if kind.aggregate || !(run Type.equalsShared(&output.ty, &foreign[foreignIndex].result.ty)) {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.ForeignAbi, &owner, span)
    }
  }
  // A fallible callee takes success and failure out-addresses after its arguments and returns a
  // status: 0 continues at `normal`, 1 at the failure edge (D3).
  let mut failed = Option.none<Address>()
  let mut context = Option.none<Bytes>()
  let mut handler = usize.MAX
  if let Option<FailureEdge>.Some {value: edge} = &failure.* {
    failed = Option.some<Address>(run emitPlace(&mut writer.*, function, target, layouts, &edge.destination))
    // In a program that observes diagnostics the callee also writes the destination's companion (N3).
    if let Option<Diagnostics>.Some {..} = &diagnostics.* {
      context = Option.some<Bytes>(run companionAddress(function, edge.destination.local))
    }
    handler = edge.target
  }
  let mut indirect = Option.none<Value>()
  if let Callee.Indirect {address} = &callee.* {
    indirect = Option.some<Value>(run emitOperand(&mut writer.*, function, target, layouts, &address))
  }
  let fallible = handler != usize.MAX
  // Provider addresses follow the written arguments (D2).
  let mut addresses = Vector.make<Value>()
  let hidden = Vector.asSlice<Operand>(providers)
  let mut providerAt = usize.ZERO
  while providerAt < hidden.length {
    run Vector.append<Value>(&mut addresses, run emitOperand(&mut writer.*, function, target, layouts, &hidden[providerAt]))
    providerAt = providerAt + usize.ONE
  }
  // An observed callee then takes the observer and selected-cause addresses (N1, N2).
  if let Option<Diagnostics>.Some {value: observed} = &diagnostics.* {
    run Vector.append<Value>(&mut addresses, run emitOperand(&mut writer.*, function, target, layouts, &observed.observer))
    run Vector.append<Value>(&mut addresses, run emitOperand(&mut writer.*, function, target, layouts, &observed.cause))
  }
  let values = Vector.asSlice<Operand>(arguments)
  let mut evaluated = Vector.make<Value>()
  let mut index = usize.ZERO
  while index < values.length {
    let mut tail = false
    if foreignIndex != usize.MAX { tail = index >= Vector.length<CAbi.Lane>(&foreign[foreignIndex].parameters) }
    let mut value = Value {scalar: pointerRepresentation(target), text: Bytes.make()}
    if tail {
      if let Callee.Extern {variadicArguments, ..} = &callee.* {
        let supplied = Vector.asSlice<CAbi.VariadicArgument>(&variadicArguments)
        let fixed = Vector.length<CAbi.Lane>(&foreign[foreignIndex].parameters)
        value = run emitVariadicArgument(&mut writer.*, function, target, layouts, &values[index], &supplied[index - fixed], span)
      } else {
        let owner = InstanceKey.identity(&function.key)
        fail Gap.make(GapCode.CAbiVariadic, &owner, span)
      }
    } else {
      value = run emitArgument(&mut writer.*, function, target, layouts, &values[index])
    }
    // A unit argument has no lane: an internal callee declares no parameter for it (see `emit`).
    if value.scalar.unit && foreignIndex != usize.MAX {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.UnitParameter, &owner, span)
    }
    if !value.scalar.unit { run Vector.append<Value>(&mut evaluated, move value) }
    index = index + usize.ONE
  }
  let mut returned = Bytes.make()
  if fallible || (!kind.unit && !kind.aggregate) {
    returned = run temp(&mut writer.*)
    run append(&mut writer.*, Bytes.asSlice(&returned))
    run append(&mut writer.*, b" = ")
  }
  run append(&mut writer.*, b"call ")
  if foreignIndex != usize.MAX {
    run extension(&mut writer.*, foreign[foreignIndex].result.extension)
    run laneType(&mut writer.*, &foreign[foreignIndex].result, &foreign[foreignIndex].declaration, span)
    if foreign[foreignIndex].variadic { run variadicFunctionType(&mut writer.*, &foreign[foreignIndex], span) }
    run append(&mut writer.*, b" @")
    run quoted(&mut writer.*, Bytes.asSlice(&foreign[foreignIndex].symbol))
  } else if let Callee.Instance {key} = &callee.* {
    if fallible { run append(&mut writer.*, b"i1") }
    else if kind.aggregate { run append(&mut writer.*, b"void") }
    else { run typeName(&mut writer.*, kind) }
    run append(&mut writer.*, b" @")
    let symbol = run InstanceIdentity.name(identities, &key)
    run append(&mut writer.*, Bytes.asSlice(&symbol))
  } else if let Option<Value>.Some {value: address} = &indirect {
    if fallible { run append(&mut writer.*, b"i1") }
    else if kind.aggregate { run append(&mut writer.*, b"void") }
    else { run typeName(&mut writer.*, kind) }
    run append(&mut writer.*, b" ")
    run append(&mut writer.*, Bytes.asSlice(&address.text))
  }
  run append(&mut writer.*, b"(")
  let leadingOutput = kind.aggregate && !fallible
  if leadingOutput {
    run append(&mut writer.*, b"ptr ")
    run append(&mut writer.*, Bytes.asSlice(&output.text))
  }
  let prepared = Vector.asSlice<Value>(&evaluated)
  index = usize.ZERO
  while index < prepared.length {
    if index > usize.ZERO || leadingOutput {
      run append(&mut writer.*, b", ")
    }
    if foreignIndex != usize.MAX {
      let parameters = Vector.asSlice<CAbi.Lane>(&foreign[foreignIndex].parameters)
      if index >= parameters.length {
        run typeName(&mut writer.*, prepared[index].scalar)
        run append(&mut writer.*, b" ")
      } else {
        run laneType(&mut writer.*, &parameters[index], &foreign[foreignIndex].declaration, span)
        run append(&mut writer.*, b" ")
        run extension(&mut writer.*, parameters[index].extension)
      }
    } else {
      run typeName(&mut writer.*, prepared[index].scalar)
      run append(&mut writer.*, b" ")
    }
    run append(&mut writer.*, Bytes.asSlice(&prepared[index].text))
    index = index + usize.ONE
  }
  let passed = Vector.asSlice<Value>(&addresses)
  providerAt = usize.ZERO
  while providerAt < passed.length {
    if prepared.length > usize.ZERO || providerAt > usize.ZERO || leadingOutput { run append(&mut writer.*, b", ") }
    run append(&mut writer.*, b"ptr ")
    run append(&mut writer.*, Bytes.asSlice(&passed[providerAt].text))
    providerAt = providerAt + usize.ONE
  }
  if let Option<Address>.Some {value: failureSlot} = &failed {
    if prepared.length > usize.ZERO || passed.length > usize.ZERO { run append(&mut writer.*, b", ") }
    run append(&mut writer.*, b"ptr ")
    run append(&mut writer.*, Bytes.asSlice(&output.text))
    run append(&mut writer.*, b", ptr ")
    run append(&mut writer.*, Bytes.asSlice(&failureSlot.text))
    if let Option<Bytes>.Some {value: companion} = &context {
      run append(&mut writer.*, b", ptr ")
      run append(&mut writer.*, Bytes.asSlice(&companion))
    }
  }
  run append(&mut writer.*, b")\n")
  if fallible {
    run append(&mut writer.*, b"br i1 ")
    run append(&mut writer.*, Bytes.asSlice(&returned))
    run append(&mut writer.*, b", label %")
    run label(&mut writer.*, handler)
    run append(&mut writer.*, b", label %")
    run label(&mut writer.*, normal)
    run append(&mut writer.*, b"\n")
    return ()
  }
  if !kind.unit && !kind.aggregate {
    let value = Value {scalar: kind, text: move returned}
    run storeValue(&mut writer.*, &output, &value)
  }
  run append(&mut writer.*, b"br label %")
  run label(&mut writer.*, normal)
  run append(&mut writer.*, b"\n")
  return ()
}

// Copies the current value of one classified C object into its destination place.
effect fn emitForeignStaticRead(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  foreign: &[CAbi.Signature],
  destination: &Place,
  declaration: &Shared<DeclarationId>,
  span: Span,
) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let index = foreignSignatureIndex(foreign, declaration)
  if index == usize.MAX || !foreign[index].global {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.make(GapCode.ForeignStatic, &owner, span)
  }
  let output = run emitPlace(&mut writer.*, function, target, layouts, destination)
  let mut symbol = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
  run append(&mut symbol, b"@")
  run quoted(&mut symbol, Bytes.asSlice(&foreign[index].symbol))
  let object = Address {
    ty: Shared.clone<Type>(&output.ty),
    text: move symbol.text,
    alignment: foreign[index].result.layout.alignment,
    representation: output.representation,
  }
  let value = run loadAddress(&mut writer.*, &object)
  return run storeValue(&mut writer.*, &output, &value)
}

effect fn emitBlock(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  block: &Block,
  foreign: &[CAbi.Signature],
  identities: &[InstanceIdentity],
  suspended: &Option<Suspended>,
  index: usize,
) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let statements = Vector.asSlice<Statement>(&block.statements)
  let locals = Vector.asSlice<Local>(&function.locals)
  let mut at = usize.ZERO
  while at < statements.length {
    match & statements[at] {
      Statement.Assign {destination, value, origin} => {
        match &value {
          // A callback's address is its emitted symbol (failure observer note N1).
          Rvalue.FunctionAddress {key} => {
            let address = run emitPlace(&mut writer.*, function, target, layouts, &destination)
            let symbol = run InstanceIdentity.name(identities, &key)
            run append(&mut writer.*, b"store ptr @")
            if InstanceKey.fixedLinkage(&key) { run quoted(&mut writer.*, Bytes.asSlice(&symbol)) }
            else { run append(&mut writer.*, Bytes.asSlice(&symbol)) }
            run append(&mut writer.*, b", ptr ")
            run append(&mut writer.*, Bytes.asSlice(&address.text))
            run append(&mut writer.*, b"\n")
          }
          Rvalue.ForeignStatic {declaration} => {
            run emitForeignStaticRead(&mut writer.*, function, target, layouts, foreign, &destination, &declaration, origin.span)
          }
          _ => {
            writer.trap = run trapReport(function, target, origin)
            run emitAssign(&mut writer.*, function, target, layouts, &destination, &value, origin.span)
            writer.trap = Option.none<TrapReport>()
          }
        }
      }
      // A drop calls the glue of the place's type with the place's address (MIR core shape §3),
      // then the current observer and cause in a program that observes diagnostics.
      Statement.Drop {destination, glue, diagnostics, origin} => {
        let address = run emitPlace(&mut writer.*, function, target, layouts, &destination)
        let mut hidden = Vector.make<Value>()
        if let Option<Diagnostics>.Some {value: observed} = &diagnostics {
          run Vector.append<Value>(&mut hidden, run emitOperand(&mut writer.*, function, target, layouts, &observed.observer))
          run Vector.append<Value>(&mut hidden, run emitOperand(&mut writer.*, function, target, layouts, &observed.cause))
        }
        let symbol = run InstanceIdentity.name(identities, &glue)
        run append(&mut writer.*, b"call void @")
        run append(&mut writer.*, Bytes.asSlice(&symbol))
        run append(&mut writer.*, b"(ptr ")
        run append(&mut writer.*, Bytes.asSlice(&address.text))
        let passed = Vector.asSlice<Value>(&hidden)
        let mut hiddenAt = usize.ZERO
        while hiddenAt < passed.length {
          run append(&mut writer.*, b", ptr ")
          run append(&mut writer.*, Bytes.asSlice(&passed[hiddenAt].text))
          hiddenAt = hiddenAt + usize.ONE
        }
        run append(&mut writer.*, b")\n")
      }
      Statement.FailureContext {destination, source, origin} => {
        run emitFailureContext(&mut writer.*, function, target, layouts, &destination, &source, origin)
      }
      Statement.SetContextHandle {address, value, ..} => {
        let base = run emitOperand(&mut writer.*, function, target, layouts, &address)
        let handle = run emitOperand(&mut writer.*, function, target, layouts, &value)
        let slot = run byteOffset(&mut writer.*, Bytes.asSlice(&base.text), companionHandleOffset(target))
        run append(&mut writer.*, b"store ")
        run typeName(&mut writer.*, lengthRepresentation(target))
        run append(&mut writer.*, b" ")
        run append(&mut writer.*, Bytes.asSlice(&handle.text))
        run append(&mut writer.*, b", ptr ")
        run append(&mut writer.*, Bytes.asSlice(&slot))
        run append(&mut writer.*, b"\n")
      }
    }
    at = at + usize.ONE
  }
  match & block.terminator {
    Terminator.Goto {target: next, origin: _} => {
      run append(&mut writer.*, b"br label %")
      run label(&mut writer.*, next)
      run append(&mut writer.*, b"\n")
    }
    Terminator.Branch {condition, thenBlock, elseBlock, origin: _} => {
      let tested = run emitOperand(&mut writer.*, function, target, layouts, &condition)
      run append(&mut writer.*, b"br i1 ")
      run append(&mut writer.*, Bytes.asSlice(&tested.text))
      run append(&mut writer.*, b", label %")
      run label(&mut writer.*, thenBlock)
      run append(&mut writer.*, b", label %")
      run label(&mut writer.*, elseBlock)
      run append(&mut writer.*, b"\n")
    }
    Terminator.Return {origin} => match &suspended.* {
      Option<Suspended>.Some {value: stepping} => run emitStepReturn(&mut writer.*, function, target, layouts, &stepping, origin.span)
      Option<Suspended>.None => run emitReturn(&mut writer.*, function, target, layouts, origin.span)
    }
    Terminator.Call {callee, arguments, providers, diagnostics, destination, normal, failure, origin} => {
      let mut state = usize.MAX
      if let Option<Suspended>.Some {value: stepping} = &suspended.* {
        state = Coroutine.stateAfter(&stepping.coroutine, index)
      }
      if state != usize.MAX {
        if let Option<Suspended>.Some {value: stepping} = &suspended.* {
          run emitSuspendingCall(&mut writer.*, function, target, layouts, identities, &stepping, state, &callee,
            &arguments, &providers, &diagnostics, &destination, &failure, origin.span)
        }
      } else {
        run emitCall(
          &mut writer.*,
          function,
          target,
          layouts,
          foreign,
          identities,
          &callee,
          &arguments,
          &providers,
          &diagnostics,
          &destination,
          normal,
          &failure,
          origin.span,
        )
      }
    }
    Terminator.Fail {origin} => match &suspended.* {
      Option<Suspended>.Some {value: stepping} => run emitStepFail(&mut writer.*, function, target, layouts, &stepping, origin.span)
      Option<Suspended>.None => run emitFail(&mut writer.*, function, target, layouts, origin.span)
    }
    Terminator.Trap {origin: _} => run append(&mut writer.*, b"call void @llvm.trap()\nunreachable\n")
    // An instance that relinquishes is a suspension origin, so the build emits it again with its
    // frames; only the walk that selects the suspendable set emits it without them.
    Terminator.Relinquish {..} => match &suspended.* {
      Option<Suspended>.Some {value: stepping} => run emitRelinquish(&mut writer.*, target, &stepping, Coroutine.stateAfter(&stepping.coroutine, index))
      Option<Suspended>.None => run append(&mut writer.*, b"call void @llvm.trap()\nunreachable\n")
    }
    // A cancelled frame's exit releases it without writing a result; its caller cancels next.
    Terminator.Abandon {..} => match &suspended.* {
      Option<Suspended>.Some {value: stepping} => run emitPop(&mut writer.*, target, &stepping, Option.none<bool>())
      Option<Suspended>.None => run append(&mut writer.*, b"call void @llvm.trap()\nunreachable\n")
    }
    Terminator.Unreachable {origin: _} => run append(&mut writer.*, b"unreachable\n")
    Terminator.Switch {value, cases, otherwise, origin: _} => {
      let tested = run emitOperand(&mut writer.*, function, target, layouts, &value)
      run append(&mut writer.*, b"switch ")
      run typeName(&mut writer.*, tested.scalar)
      run append(&mut writer.*, b" ")
      run append(&mut writer.*, Bytes.asSlice(&tested.text))
      run append(&mut writer.*, b", label %")
      run label(&mut writer.*, otherwise)
      run append(&mut writer.*, b" [")
      let selected = Vector.asSlice<SwitchCase>(&cases)
      let mut caseAt = usize.ZERO
      while caseAt < selected.length {
        run append(&mut writer.*, b" ")
        run typeName(&mut writer.*, tested.scalar)
        run append(&mut writer.*, b" ")
        if selected[caseAt].negative { run append(&mut writer.*, b"-") }
        run append(&mut writer.*, Bytes.asSlice(&selected[caseAt].decimal))
        run append(&mut writer.*, b", label %")
        run label(&mut writer.*, selected[caseAt].target)
        caseAt = caseAt + usize.ONE
      }
      run append(&mut writer.*, b" ]\n")
    }
  }
  return ()
}

/// Emits the entry-block stack slots for every local and spills each parameter into its slot.
effect fn emitEntrySlots(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  run emitSlots(&mut writer.*, function, target, layouts, &Option.none<Suspended>())
  let locals = Vector.asSlice<Local>(&function.locals)
  let parameters = Vector.asSlice<Shared<Type>>(&function.parameters)
  let mut local = usize.ZERO
  while local < parameters.length {
    let parameterLayout = run layoutOf(layouts, &parameters[local], function,
      locals[local + usize.ONE].origin.span)
    let kind = storageRepresentation(&parameters[local], target, parameterLayout)
    let mut parameterName = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
    run append(&mut parameterName, b"%p")
    run decimal(&mut parameterName, local)
    let input = move parameterName.text
    let mut addressName = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
    run localName(&mut addressName, local + usize.ONE)
    let address = Address {ty: Shared.clone<Type>(&parameters[local]), text: move addressName.text,
      alignment: parameterLayout.alignment, representation: kind}
    let value = Value {scalar: kind, text: move input}
    run storeValue(&mut writer.*, &address, &value)
    local = local + usize.ONE
  }
  return run emitHiddenStores(&mut writer.*, function)
}

/// Emits one storage address per local: a stack slot, or for a suspended step the frame slot of a
/// frame-resident local. Then each failure slot's context companion.
effect fn emitSlots(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  suspended: &Option<Suspended>,
) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let locals = Vector.asSlice<Local>(&function.locals)
  let mut local = usize.ZERO
  while local < locals.length {
    let mut resident = usize.MAX
    if let Option<Suspended>.Some {value: stepping} = &suspended.* {
      resident = Coroutine.residentAt(&stepping.coroutine, local)
    }
    if resident != usize.MAX {
      run localName(&mut writer.*, local)
      run append(&mut writer.*, b" = getelementptr i8, ptr %frame, i64 ")
      run decimal(&mut writer.*, resident)
      run append(&mut writer.*, b"\n")
      local = local + usize.ONE
      continue
    }
    let localLayout = run layoutOf(
      layouts,
      &locals[local].ty,
      function,
      locals[local].origin.span,
    )
    let kind = storageRepresentation(&locals[local].ty, target, localLayout)
    if !kind.unit {
      run localName(&mut writer.*, local)
      run append(&mut writer.*, b" = alloca ")
      run typeName(&mut writer.*, kind)
      run memoryAlignment(&mut writer.*, localLayout.alignment)
    } else {
      run localName(&mut writer.*, local)
      run append(&mut writer.*, b" = alloca i8")
      run memoryAlignment(&mut writer.*, localLayout.alignment)
    }
    local = local + usize.ONE
  }
  // Every failure slot except `Failure` owns a fixed-size context companion; `Failure`'s is the
  // caller's `%context` (failure observer note N3). A step keeps every companion in its frame.
  let companions = run companionLocals(function)
  let owned = Vector.asSlice<usize>(&companions)
  let word = u32.toUsize(Target.pointerBits(target)) / 8
  let mut companionAt = usize.ZERO
  while companionAt < owned.length {
    run append(&mut writer.*, Bytes.asSlice(&run companionAddress(function, owned[companionAt])))
    if let Option<Suspended>.Some {value: stepping} = &suspended.* {
      run append(&mut writer.*, b" = getelementptr i8, ptr %frame, i64 ")
      run decimal(&mut writer.*, Coroutine.companionAt(&stepping.coroutine, owned[companionAt]))
      run append(&mut writer.*, b"\n")
    } else {
      run append(&mut writer.*, b" = alloca [")
      run decimal(&mut writer.*, companionWords())
      run append(&mut writer.*, b" x i")
      run decimal(&mut writer.*, word * 8)
      run append(&mut writer.*, b"], align ")
      run decimal(&mut writer.*, word)
      run append(&mut writer.*, b"\n")
    }
    companionAt = companionAt + usize.ONE
  }
  return ()
}

/// Stores the hidden provider, observer and cause addresses into their locals.
effect fn emitHiddenStores(writer: &mut Writer, function: &MirFunction) -> () ! OutOfMemoryError ? &mut Allocator {
  // Each hidden provider address lands in its `Provider` local.
  let mut provider = usize.ZERO
  while providerLocalAt(function, provider) != usize.MAX {
    let slot = providerLocalAt(function, provider)
    run append(&mut writer.*, b"store ptr %q")
    run decimal(&mut writer.*, provider)
    run append(&mut writer.*, b", ptr ")
    run localName(&mut writer.*, slot)
    run append(&mut writer.*, b"\n")
    provider = provider + usize.ONE
  }
  // An observed function's observer and selected-cause addresses land in their locals (N1, N2).
  let observer = diagnosticLocal(function, usize.ZERO)
  if observer != usize.MAX {
    run append(&mut writer.*, b"store ptr %observer, ptr ")
    run localName(&mut writer.*, observer)
    run append(&mut writer.*, b"\nstore ptr %cause, ptr ")
    run localName(&mut writer.*, diagnosticLocal(function, usize.ONE))
    run append(&mut writer.*, b"\n")
  }
  return ()
}

/// Emits one definition; the caller sorts complete definitions before joining a module.
///
/// A suspendable instance's `suspension` facts make its ordinary symbol a driver and add its
/// `$enter` and `$step` definitions (`backend.Coroutine`).
pub effect fn emit(
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  foreign: &[CAbi.Signature],
  identities: &[InstanceIdentity],
  suspension: &Option<Facts>,
) -> Bytes ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut writer = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
  let locals = Vector.asSlice<Local>(&function.locals)
  let resultFacts = run layoutOf(layouts, &function.result, function, locals[usize.ZERO].origin.span)
  let result = storageRepresentation(&function.result, target, resultFacts)
  let parameters = Vector.asSlice<Shared<Type>>(&function.parameters)
  let fallible = failureLocal(function) != usize.MAX
  // A C export shim keeps its requested linkage name and the C narrow-integer extension rules.
  let exported = match &function.key {
    InstanceKey.Export {..} => true
    _ => false
  }
  // Only a C export keeps every written parameter as a lane; elsewhere a unit parameter has none.
  let mut at = usize.ZERO
  while at < parameters.length {
    if exported && scalar(&parameters[at], target).unit {
      let owner = InstanceKey.identity(&function.key)
      fail Gap.make(GapCode.UnitParameter, &owner, locals[at + usize.ONE].origin.span)
    }
    at = at + usize.ONE
  }
  run append(&mut writer, b"define ")
  if exported { run cExtension(&mut writer, result, target) }
  if fallible { run append(&mut writer, b"i1") }
  else if result.aggregate { run append(&mut writer, b"void") }
  else { run typeName(&mut writer, result) }
  run append(&mut writer, b" @")
  let symbol = run InstanceIdentity.name(identities, &function.key)
  if exported { run quoted(&mut writer, Bytes.asSlice(&symbol)) }
  else { run append(&mut writer, Bytes.asSlice(&symbol)) }
  writer.symbol = move symbol
  run append(&mut writer, b"(")
  let leadingOutput = result.aggregate && !fallible
  if leadingOutput { run append(&mut writer, b"ptr %out") }
  let mut lanes = usize.ZERO
  at = usize.ZERO
  while at < parameters.length {
    let facts = run layoutOf(layouts, &parameters[at], function, locals[at + usize.ONE].origin.span)
    let lane = storageRepresentation(&parameters[at], target, facts)
    if lane.unit {
      at = at + usize.ONE
      continue
    }
    if lanes > usize.ZERO || leadingOutput {
      run append(&mut writer, b", ")
    }
    lanes = lanes + usize.ONE
    if facts.abi == Abi.Indirect { run append(&mut writer, b"ptr") }
    else { run typeName(&mut writer, lane) }
    run append(&mut writer, b" ")
    if exported { run cExtension(&mut writer, lane, target) }
    run append(&mut writer, b"%p")
    run decimal(&mut writer, at)
    at = at + usize.ONE
  }
  // Hidden provider addresses follow the written parameters (D2).
  let mut providerCount = usize.ZERO
  while providerLocalAt(function, providerCount) != usize.MAX {
    if lanes > usize.ZERO || providerCount > usize.ZERO || leadingOutput { run append(&mut writer, b", ") }
    run append(&mut writer, b"ptr %q")
    run decimal(&mut writer, providerCount)
    providerCount = providerCount + usize.ONE
  }
  let observed = diagnosticLocal(function, usize.ZERO) != usize.MAX
  if observed {
    if lanes > usize.ZERO || providerCount > usize.ZERO || leadingOutput { run append(&mut writer, b", ") }
    run append(&mut writer, b"ptr %observer, ptr %cause")
  }
  if fallible {
    if lanes > usize.ZERO || providerCount > usize.ZERO || observed { run append(&mut writer, b", ") }
    run append(&mut writer, b"ptr %out, ptr %fail")
    if observed { run append(&mut writer, b", ptr %context") }
  }
  // Drop glue is never inlined back, as in the bootstrap: a drop site stays one call however large
  // its owner's cleanup is, and the optimizer cannot pair a release with its acquisition and elide
  // the observable allocator calls.
  let glue = match &function.key {
    InstanceKey.DropGlue {..} => true
    _ => false
  }
  if glue { run append(&mut writer, b") noinline {\n") }
  else { run append(&mut writer, b") {\n") }
  if let Option<Facts>.Some {value: facts} = &suspension.* {
    let suspended = Option.some<Suspended>(
      Suspended {facts: run Facts.copy(&facts), coroutine: run planFrame(function, target, layouts, &facts)},
    )
    let base = run Bytes.copy(Bytes.asSlice(&writer.symbol))
    if let Option<Suspended>.Some {value: stepping} = &suspended {
      run emitDriver(&mut writer, function, target, layouts, &stepping, Bytes.asSlice(&base))
      run emitEnter(&mut writer, function, target, layouts, &stepping, Bytes.asSlice(&base))
      run emitStep(&mut writer, function, target, layouts, foreign, identities, &suspended, &stepping, Bytes.asSlice(&base))
    }
    run Bytes.append(&mut writer.constants, Bytes.asSlice(&writer.text))
    return move writer.constants
  }
  let ordinary = Option.none<Suspended>()
  let blocks = Vector.asSlice<Block>(&function.blocks)
  at = usize.ZERO
  while at < blocks.length {
    run label(&mut writer, at)
    run append(&mut writer, b":\n")
    if at == usize.ZERO {
      run emitEntrySlots(&mut writer, function, target, layouts)
    }
    run emitBlock(&mut writer, function, target, layouts, &blocks[at], foreign, identities, &ordinary, at)
    at = at + usize.ONE
  }
  run append(&mut writer, b"}\n")
  run Bytes.append(&mut writer.constants, Bytes.asSlice(&writer.text))
  return move writer.constants
}

/// A suspendable definition's facts and frame, while its step is emitted.
struct Suspended {
  facts: Facts
  coroutine: Coroutine
}

fn wordSize(target: &Target) -> usize {
  return u32.toUsize(Target.pointerBits(target)) / 8
}

effect fn planFrame(function: &MirFunction, target: &Target, layouts: &[TypeLayout], facts: &Facts) -> Coroutine
! Gap | OutOfMemoryError ? &mut Allocator {
  let locals = Vector.asSlice<Local>(&function.locals)
  let mut extents = Vector.make<Extent>()
  let mut local = usize.ZERO
  while local < locals.length {
    let metrics = run layoutOf(layouts, &locals[local].ty, function, locals[local].origin.span)
    let kind = storageRepresentation(&locals[local].ty, target, metrics)
    let mut size = metrics.size
    if kind.unit { size = usize.ZERO }
    let mut alignment = metrics.alignment
    if alignment == usize.ZERO { alignment = usize.ONE }
    run Vector.append<Extent>(&mut extents, Extent {size: size, alignment: alignment})
    local = local + usize.ONE
  }
  let blocks = Vector.asSlice<Block>(&function.blocks)
  let mut points = Vector.make<bool>()
  let mut block = usize.ZERO
  while block < blocks.length {
    let mut point = false
    if let Terminator.Call {callee, ..} = &blocks[block].terminator {
      // A cancel landing runs its nonparking cleanup to completion through an ordinary driver
      // call. It records no cancel exit and must not push that call onto the destroyed package.
      if Coroutine.cancelAfter(function, block) != usize.MAX {
        if let Callee.Instance {key} = &callee { point = run Facts.suspends(facts, &key) }
      }
    }
    if let Terminator.Relinquish {..} = &blocks[block].terminator { point = true }
    run Vector.append<bool>(&mut points, point)
    block = block + usize.ONE
  }
  let mut providers = usize.ZERO
  while providerLocalAt(function, providers) != usize.MAX { providers = providers + usize.ONE }
  let companions = run companionLocals(function)
  return run Coroutine.plan(function, Vector.asSlice<Extent>(&extents), Vector.asSlice<bool>(&points), providers,
    Vector.asSlice<usize>(&companions), wordSize(target))
}

// Writes `@"<symbol><suffix>"`.
effect fn suffixedSymbol(writer: &mut Writer, symbol: &[u8], suffix: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut name = run Bytes.copy(symbol)
  run Bytes.append(&mut name, suffix)
  run append(&mut writer.*, b"@")
  return run quoted(&mut writer.*, Bytes.asSlice(&name))
}

// Copies `size` bytes; frame states and stack slots never overlap.
effect fn copyBytes(writer: &mut Writer, destination: &[u8], source: &[u8], size: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  run append(&mut writer.*, b"call void @llvm.memmove.p0.p0.i64(ptr ")
  run append(&mut writer.*, destination)
  run append(&mut writer.*, b", ptr ")
  run append(&mut writer.*, source)
  run append(&mut writer.*, b", i64 ")
  run decimal(&mut writer.*, size)
  return run append(&mut writer.*, b", i1 false)\n")
}

effect fn storeWordAt(writer: &mut Writer, value: &[u8], base: &[u8], offset: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let address = run byteOffset(&mut writer.*, base, offset)
  run append(&mut writer.*, b"store ptr ")
  run append(&mut writer.*, value)
  run append(&mut writer.*, b", ptr ")
  run append(&mut writer.*, Bytes.asSlice(&address))
  return run append(&mut writer.*, b"\n")
}

effect fn loadWordAt(writer: &mut Writer, base: &[u8], offset: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let address = run byteOffset(&mut writer.*, base, offset)
  let loaded = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&loaded))
  run append(&mut writer.*, b" = load ptr, ptr ")
  run append(&mut writer.*, Bytes.asSlice(&address))
  run append(&mut writer.*, b"\n")
  return move loaded
}

// Writes `%name = load ptr` of one hidden caller address from the frame header.
effect fn loadHidden(writer: &mut Writer, name: &[u8], offset: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let address = run byteOffset(&mut writer.*, b"%frame", offset)
  run append(&mut writer.*, name)
  run append(&mut writer.*, b" = load ptr, ptr ")
  run append(&mut writer.*, Bytes.asSlice(&address))
  return run append(&mut writer.*, b"\n")
}

// Whether a suspendable definition takes a result address: its failure convention always does,
// and so does any result with a lane.
effect fn takesResult(function: &MirFunction, target: &Target, layouts: &[TypeLayout]) -> bool
! Gap | OutOfMemoryError ? &mut Allocator {
  let locals = Vector.asSlice<Local>(&function.locals)
  let facts = run layoutOf(layouts, &function.result, function, locals[usize.ZERO].origin.span)
  return failureLocal(function) != usize.MAX || !storageRepresentation(&function.result, target, facts).unit
}

// The `$enter` lanes after the transfer record: the written parameter lanes, then the hidden
// provider, observer and cause addresses, then the result (`out`, when not empty), failure and
// context addresses. A definition and its driver spell them alike.
effect fn enterLanes(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout], out: &[u8]) -> ()
! Gap | OutOfMemoryError ? &mut Allocator {
  let locals = Vector.asSlice<Local>(&function.locals)
  let parameters = Vector.asSlice<Shared<Type>>(&function.parameters)
  let mut at = usize.ZERO
  while at < parameters.length {
    let facts = run layoutOf(layouts, &parameters[at], function, locals[at + usize.ONE].origin.span)
    let lane = storageRepresentation(&parameters[at], target, facts)
    if !lane.unit {
      run append(&mut writer.*, b", ")
      if facts.abi == Abi.Indirect { run append(&mut writer.*, b"ptr") }
      else { run typeName(&mut writer.*, lane) }
      run append(&mut writer.*, b" %p")
      run decimal(&mut writer.*, at)
    }
    at = at + usize.ONE
  }
  let mut provider = usize.ZERO
  while providerLocalAt(function, provider) != usize.MAX {
    run append(&mut writer.*, b", ptr %q")
    run decimal(&mut writer.*, provider)
    provider = provider + usize.ONE
  }
  let observed = diagnosticLocal(function, usize.ZERO) != usize.MAX
  if observed { run append(&mut writer.*, b", ptr %observer, ptr %cause") }
  if out.length > usize.ZERO {
    run append(&mut writer.*, b", ptr ")
    run append(&mut writer.*, out)
  }
  if failureLocal(function) != usize.MAX {
    run append(&mut writer.*, b", ptr %fail")
    if observed { run append(&mut writer.*, b", ptr %context") }
  }
  return ()
}

// The ordinary symbol's body: push the instance's frame, step the top frame until none remains,
// destroy the storage state the frames used, and return the outcome under the ordinary convention.
effect fn emitDriver(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout],
  stepping: &Suspended, symbol: &[u8]) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let word = wordSize(target)
  let locals = Vector.asSlice<Local>(&function.locals)
  let resultFacts = run layoutOf(layouts, &function.result, function, locals[usize.ZERO].origin.span)
  let result = storageRepresentation(&function.result, target, resultFacts)
  let fallible = failureLocal(function) != usize.MAX
  if packageStart(function) { return run emitPackageDriver(&mut writer.*, function, target, layouts, stepping, symbol) }
  run append(&mut writer.*, b"entry:\n%transfer = alloca [4 x i")
  run decimal(&mut writer.*, word * 8)
  run append(&mut writer.*, b"], align ")
  run decimal(&mut writer.*, word)
  run append(&mut writer.*, b"\nstore ptr null, ptr %transfer\n")
  run storeWordAt(&mut writer.*, b"null", b"%transfer", Coroutine.transferTop(word))
  run storeWordAt(&mut writer.*, b"null", b"%transfer", Coroutine.transferPackage(word))
  let failed = run byteOffset(&mut writer.*, b"%transfer", Coroutine.transferFailed(word))
  run append(&mut writer.*, b"store i8 0, ptr ")
  run append(&mut writer.*, Bytes.asSlice(&failed))
  run append(&mut writer.*, b"\n")
  let mut out = Bytes.make()
  if fallible || result.aggregate { out = run Bytes.copy(b"%out") }
  else if !result.unit {
    run append(&mut writer.*, b"%result = alloca ")
    run typeName(&mut writer.*, result)
    run memoryAlignment(&mut writer.*, resultFacts.alignment)
    out = run Bytes.copy(b"%result")
  }
  run append(&mut writer.*, b"call void ")
  run suffixedSymbol(&mut writer.*, symbol, b"$enter")
  run append(&mut writer.*, b"(ptr %transfer")
  run enterLanes(&mut writer.*, function, target, layouts, Bytes.asSlice(&out))
  run append(&mut writer.*, b")\nbr label %drive\ndrive:\n")
  let top = run loadWordAt(&mut writer.*, b"%transfer", Coroutine.transferTop(word))
  let empty = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&empty))
  run append(&mut writer.*, b" = icmp eq ptr ")
  run append(&mut writer.*, Bytes.asSlice(&top))
  run append(&mut writer.*, b", null\nbr i1 ")
  run append(&mut writer.*, Bytes.asSlice(&empty))
  run append(&mut writer.*, b", label %finish, label %step\nstep:\n")
  let resume = run loadWordAt(&mut writer.*, Bytes.asSlice(&top), Coroutine.resumeOffset(word))
  run append(&mut writer.*, b"call i32 ")
  run append(&mut writer.*, Bytes.asSlice(&resume))
  run append(&mut writer.*, b"(ptr %transfer, ptr ")
  run append(&mut writer.*, Bytes.asSlice(&top))
  run append(&mut writer.*, b")\nbr label %drive\nfinish:\n")
  let state = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&state))
  run append(&mut writer.*, b" = load ptr, ptr %transfer\n")
  let absent = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&absent))
  run append(&mut writer.*, b" = icmp eq ptr ")
  run append(&mut writer.*, Bytes.asSlice(&state))
  run append(&mut writer.*, b", null\nbr i1 ")
  run append(&mut writer.*, Bytes.asSlice(&absent))
  run append(&mut writer.*, b", label %exit, label %destroy\ndestroy:\ncall void @")
  run quoted(&mut writer.*, Bytes.asSlice(&stepping.facts.destroy))
  run append(&mut writer.*, b"(ptr ")
  run append(&mut writer.*, Bytes.asSlice(&state))
  run append(&mut writer.*, b")\nbr label %exit\nexit:\n")
  if fallible {
    let flag = run temp(&mut writer.*)
    run append(&mut writer.*, Bytes.asSlice(&flag))
    run append(&mut writer.*, b" = load i8, ptr ")
    run append(&mut writer.*, Bytes.asSlice(&failed))
    run append(&mut writer.*, b"\n")
    let status = run temp(&mut writer.*)
    run append(&mut writer.*, Bytes.asSlice(&status))
    run append(&mut writer.*, b" = icmp ne i8 ")
    run append(&mut writer.*, Bytes.asSlice(&flag))
    run append(&mut writer.*, b", 0\nret i1 ")
    run append(&mut writer.*, Bytes.asSlice(&status))
    return run append(&mut writer.*, b"\n}\n")
  }
  if result.aggregate || result.unit { return run append(&mut writer.*, b"ret void\n}\n") }
  let value = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&value))
  run append(&mut writer.*, b" = load ")
  run typeName(&mut writer.*, result)
  run append(&mut writer.*, b", ptr %result")
  run memoryAlignment(&mut writer.*, resultFacts.alignment)
  run append(&mut writer.*, b"ret ")
  run typeName(&mut writer.*, result)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&value))
  return run append(&mut writer.*, b"\n}\n")
}

// Whether an instance is an execution package's erased start, whose frames live in the package.
fn packageStart(function: &MirFunction) -> bool {
  return match &function.key {
    InstanceKey.ExecutionHelper {purpose, ..} => purpose == HelperRole.Start
    _ => false
  }
}

// An execution package's start drives the transfer record its header begins with: the first
// activation pushes the start's own frame, a later one continues the frames a relinquishment left.
// A step that relinquishes returns with the frames in place; the storage state is destroyed once,
// when the last frame completes.
effect fn emitPackageDriver(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout],
  stepping: &Suspended, symbol: &[u8]) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let word = wordSize(target)
  run append(&mut writer.*, b"entry:\n%transfer = getelementptr i8, ptr %p0, i64 0\n")
  let first = run loadWordAt(&mut writer.*, b"%transfer", Coroutine.transferTop(word))
  let fresh = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&fresh))
  run append(&mut writer.*, b" = icmp eq ptr ")
  run append(&mut writer.*, Bytes.asSlice(&first))
  run append(&mut writer.*, b", null\nbr i1 ")
  run append(&mut writer.*, Bytes.asSlice(&fresh))
  run append(&mut writer.*, b", label %enter, label %drive\nenter:\ncall void ")
  run suffixedSymbol(&mut writer.*, symbol, b"$enter")
  run append(&mut writer.*, b"(ptr %transfer")
  run enterLanes(&mut writer.*, function, target, layouts, b"")
  run append(&mut writer.*, b")\nbr label %drive\ndrive:\n")
  let top = run loadWordAt(&mut writer.*, b"%transfer", Coroutine.transferTop(word))
  let empty = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&empty))
  run append(&mut writer.*, b" = icmp eq ptr ")
  run append(&mut writer.*, Bytes.asSlice(&top))
  run append(&mut writer.*, b", null\nbr i1 ")
  run append(&mut writer.*, Bytes.asSlice(&empty))
  run append(&mut writer.*, b", label %finish, label %step\nstep:\n")
  let resume = run loadWordAt(&mut writer.*, Bytes.asSlice(&top), Coroutine.resumeOffset(word))
  let code = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&code))
  run append(&mut writer.*, b" = call i32 ")
  run append(&mut writer.*, Bytes.asSlice(&resume))
  run append(&mut writer.*, b"(ptr %transfer, ptr ")
  run append(&mut writer.*, Bytes.asSlice(&top))
  run append(&mut writer.*, b")\n")
  let relinquished = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&relinquished))
  run append(&mut writer.*, b" = icmp eq i32 ")
  run append(&mut writer.*, Bytes.asSlice(&code))
  run append(&mut writer.*, b", 2\nbr i1 ")
  run append(&mut writer.*, Bytes.asSlice(&relinquished))
  run append(&mut writer.*, b", label %parked, label %drive\nparked:\nret void\nfinish:\n")
  let state = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&state))
  run append(&mut writer.*, b" = load ptr, ptr %transfer\n")
  let absent = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&absent))
  run append(&mut writer.*, b" = icmp eq ptr ")
  run append(&mut writer.*, Bytes.asSlice(&state))
  run append(&mut writer.*, b", null\nbr i1 ")
  run append(&mut writer.*, Bytes.asSlice(&absent))
  run append(&mut writer.*, b", label %exit, label %destroy\ndestroy:\ncall void @")
  run quoted(&mut writer.*, Bytes.asSlice(&stepping.facts.destroy))
  run append(&mut writer.*, b"(ptr ")
  run append(&mut writer.*, Bytes.asSlice(&state))
  run append(&mut writer.*, b")\nstore ptr null, ptr %transfer\nbr label %exit\nexit:\nret void\n}\n")
  return ()
}

// `$enter` acquires the instance's frame from the transfer record's storage state, creating that
// state on first use, records the caller's addresses and the parameters, and pushes the frame.
// Storage refusal is the fatal execution-stack exhaustion trap (SUSP-006).
effect fn emitEnter(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout],
  stepping: &Suspended, symbol: &[u8]) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let word = wordSize(target)
  let takes = run takesResult(function, target, layouts)
  run append(&mut writer.*, b"define void ")
  run suffixedSymbol(&mut writer.*, symbol, b"$enter")
  run append(&mut writer.*, b"(ptr %transfer")
  let mut out = Bytes.make()
  if takes { out = run Bytes.copy(b"%out") }
  run enterLanes(&mut writer.*, function, target, layouts, Bytes.asSlice(&out))
  run append(&mut writer.*, b") {\nentry:\n")
  let current = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&current))
  run append(&mut writer.*, b" = load ptr, ptr %transfer\n")
  let missing = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&missing))
  run append(&mut writer.*, b" = icmp eq ptr ")
  run append(&mut writer.*, Bytes.asSlice(&current))
  run append(&mut writer.*, b", null\nbr i1 ")
  run append(&mut writer.*, Bytes.asSlice(&missing))
  run append(&mut writer.*, b", label %create, label %ready\ncreate:\n")
  let created = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&created))
  run append(&mut writer.*, b" = call ptr @")
  run quoted(&mut writer.*, Bytes.asSlice(&stepping.facts.create))
  run append(&mut writer.*, b"()\n")
  let refused = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&refused))
  run append(&mut writer.*, b" = icmp eq ptr ")
  run append(&mut writer.*, Bytes.asSlice(&created))
  run append(&mut writer.*, b", null\nbr i1 ")
  run append(&mut writer.*, Bytes.asSlice(&refused))
  run append(&mut writer.*, b", label %exhausted, label %publish\npublish:\nstore ptr ")
  run append(&mut writer.*, Bytes.asSlice(&created))
  run append(&mut writer.*, b", ptr %transfer\nbr label %ready\nready:\n")
  let state = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&state))
  run append(&mut writer.*, b" = load ptr, ptr %transfer\n%frame = call ptr @")
  run quoted(&mut writer.*, Bytes.asSlice(&stepping.facts.acquire))
  run append(&mut writer.*, b"(ptr ")
  run append(&mut writer.*, Bytes.asSlice(&state))
  run append(&mut writer.*, b", i")
  run decimal(&mut writer.*, word * 8)
  run append(&mut writer.*, b" ")
  run decimal(&mut writer.*, stepping.coroutine.size)
  run append(&mut writer.*, b", i")
  run decimal(&mut writer.*, word * 8)
  run append(&mut writer.*, b" ")
  run decimal(&mut writer.*, stepping.coroutine.alignment)
  run append(&mut writer.*, b")\n")
  let exhausted = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&exhausted))
  run append(&mut writer.*, b" = icmp eq ptr %frame, null\nbr i1 ")
  run append(&mut writer.*, Bytes.asSlice(&exhausted))
  run append(&mut writer.*, b", label %exhausted, label %start\nexhausted:\ncall void @llvm.trap()\nunreachable\nstart:\n")
  let parent = run loadWordAt(&mut writer.*, b"%transfer", Coroutine.transferTop(word))
  run append(&mut writer.*, b"store ptr ")
  run append(&mut writer.*, Bytes.asSlice(&parent))
  run append(&mut writer.*, b", ptr %frame\n")
  let resume = run byteOffset(&mut writer.*, b"%frame", Coroutine.resumeOffset(word))
  run append(&mut writer.*, b"store ptr ")
  run suffixedSymbol(&mut writer.*, symbol, b"$step")
  run append(&mut writer.*, b", ptr ")
  run append(&mut writer.*, Bytes.asSlice(&resume))
  run append(&mut writer.*, b"\n")
  let initial = run byteOffset(&mut writer.*, b"%frame", Coroutine.stateOffset(word))
  run append(&mut writer.*, b"store i32 0, ptr ")
  run append(&mut writer.*, Bytes.asSlice(&initial))
  run append(&mut writer.*, b"\n")
  let observed = diagnosticLocal(function, usize.ZERO) != usize.MAX
  let fallible = failureLocal(function) != usize.MAX
  if takes { run storeWordAt(&mut writer.*, b"%out", b"%frame", Coroutine.outOffset(word)) }
  if fallible {
    run storeWordAt(&mut writer.*, b"%fail", b"%frame", Coroutine.failOffset(word))
    if observed { run storeWordAt(&mut writer.*, b"%context", b"%frame", Coroutine.contextOffset(word)) }
  }
  if observed {
    run storeWordAt(&mut writer.*, b"%observer", b"%frame", Coroutine.observerOffset(word))
    run storeWordAt(&mut writer.*, b"%cause", b"%frame", Coroutine.causeOffset(word))
  }
  let mut provider = usize.ZERO
  while providerLocalAt(function, provider) != usize.MAX {
    let mut name = Writer {text: run Bytes.copy(b"%q"), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
    run decimal(&mut name, provider)
    run storeWordAt(&mut writer.*, Bytes.asSlice(&name.text), b"%frame", Coroutine.providerOffset(word, provider))
    provider = provider + usize.ONE
  }
  // Each parameter lands where the body reads it: its resident slot or its slot in state 0.
  let locals = Vector.asSlice<Local>(&function.locals)
  let parameters = Vector.asSlice<Shared<Type>>(&function.parameters)
  let mut at = usize.ZERO
  while at < parameters.length {
    let offset = Coroutine.parameterAt(&stepping.coroutine, at + usize.ONE)
    let parameterLayout = run layoutOf(layouts, &parameters[at], function, locals[at + usize.ONE].origin.span)
    let kind = storageRepresentation(&parameters[at], target, parameterLayout)
    if !kind.unit && offset != usize.MAX {
      let slot = run byteOffset(&mut writer.*, b"%frame", offset)
      let mut parameterName = Writer {text: run Bytes.copy(b"%p"), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
      run decimal(&mut parameterName, at)
      let address = Address {ty: Shared.clone<Type>(&parameters[at]), text: move slot,
        alignment: offsetAlignment(stepping.coroutine.alignment, offset), representation: kind}
      let value = Value {scalar: kind, text: move parameterName.text}
      run storeValue(&mut writer.*, &address, &value)
    }
    at = at + usize.ONE
  }
  let pushed = run byteOffset(&mut writer.*, b"%transfer", Coroutine.transferTop(word))
  run append(&mut writer.*, b"store ptr %frame, ptr ")
  run append(&mut writer.*, Bytes.asSlice(&pushed))
  return run append(&mut writer.*, b"\nret void\n}\n")
}

// Copies one state's saved locals between their stack slots and the frame.
effect fn transferState(writer: &mut Writer, slots: &[FrameSlot], saving: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < slots.length {
    let frame = run byteOffset(&mut writer.*, b"%frame", slots[at].offset)
    let mut named = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
    run localName(&mut named, slots[at].local)
    if saving { run copyBytes(&mut writer.*, Bytes.asSlice(&frame), Bytes.asSlice(&named.text), slots[at].size) }
    else { run copyBytes(&mut writer.*, Bytes.asSlice(&named.text), Bytes.asSlice(&frame), slots[at].size) }
    at = at + usize.ONE
  }
  return ()
}

// `$step` runs the frame on top from its resume state: state 0 starts the body, and state `k + 1`
// restores what lives after point `k`, then continues at that call's normal or failure edge, or,
// when the frame's package was dropped while relinquished, at that point's cancel exit.
effect fn emitStep(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout],
  foreign: &[CAbi.Signature], identities: &[InstanceIdentity], suspended: &Option<Suspended>, stepping: &Suspended,
  symbol: &[u8]) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let word = wordSize(target)
  run append(&mut writer.*, b"define i32 ")
  run suffixedSymbol(&mut writer.*, symbol, b"$step")
  run append(&mut writer.*, b"(ptr %transfer, ptr %frame) {\nentry:\n")
  run emitSlots(&mut writer.*, function, target, layouts, suspended)
  let observed = diagnosticLocal(function, usize.ZERO) != usize.MAX
  let fallible = failureLocal(function) != usize.MAX
  if run takesResult(function, target, layouts) { run loadHidden(&mut writer.*, b"%out", Coroutine.outOffset(word)) }
  if fallible {
    run loadHidden(&mut writer.*, b"%fail", Coroutine.failOffset(word))
    if observed { run loadHidden(&mut writer.*, b"%context", Coroutine.contextOffset(word)) }
  }
  if observed {
    run loadHidden(&mut writer.*, b"%observer", Coroutine.observerOffset(word))
    run loadHidden(&mut writer.*, b"%cause", Coroutine.causeOffset(word))
  }
  let mut provider = usize.ZERO
  while providerLocalAt(function, provider) != usize.MAX {
    let mut name = Writer {text: run Bytes.copy(b"%q"), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
    run decimal(&mut name, provider)
    run loadHidden(&mut writer.*, Bytes.asSlice(&name.text), Coroutine.providerOffset(word, provider))
    provider = provider + usize.ONE
  }
  let stateAddress = run byteOffset(&mut writer.*, b"%frame", Coroutine.stateOffset(word))
  let state = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&state))
  run append(&mut writer.*, b" = load i32, ptr ")
  run append(&mut writer.*, Bytes.asSlice(&stateAddress))
  run append(&mut writer.*, b"\n")
  let states = Vector.asSlice<State>(&stepping.coroutine.states)
  // A frame whose package was dropped while relinquished cancels from its point (`Destroyed`).
  let package = run loadWordAt(&mut writer.*, b"%transfer", Coroutine.transferPackage(word))
  let owned = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&owned))
  run append(&mut writer.*, b" = icmp ne ptr ")
  run append(&mut writer.*, Bytes.asSlice(&package))
  run append(&mut writer.*, b", null\nbr i1 ")
  run append(&mut writer.*, Bytes.asSlice(&owned))
  run append(&mut writer.*, b", label %probe, label %dispatch\nprobe:\n")
  let activation = run byteOffset(&mut writer.*, Bytes.asSlice(&package), Coroutine.packageActivation(word))
  let lifecycle = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&lifecycle))
  run append(&mut writer.*, b" = load i")
  run decimal(&mut writer.*, word * 8)
  run append(&mut writer.*, b", ptr ")
  run append(&mut writer.*, Bytes.asSlice(&activation))
  run append(&mut writer.*, b"\n")
  let destroyed = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&destroyed))
  run append(&mut writer.*, b" = icmp eq i")
  run decimal(&mut writer.*, word * 8)
  run append(&mut writer.*, b" ")
  run append(&mut writer.*, Bytes.asSlice(&lifecycle))
  run append(&mut writer.*, b", ")
  run decimal(&mut writer.*, SealedCore.lifecycleWord(Lifecycle.Destroyed))
  run append(&mut writer.*, b"\nbr i1 ")
  run append(&mut writer.*, Bytes.asSlice(&destroyed))
  run append(&mut writer.*, b", label %cancelling, label %dispatch\ncancelling:\nswitch i32 ")
  run append(&mut writer.*, Bytes.asSlice(&state))
  run append(&mut writer.*, b", label %invalid [")
  let mut cancelled = usize.ONE
  while cancelled < states.length {
    run append(&mut writer.*, b" i32 ")
    run decimal(&mut writer.*, cancelled)
    run append(&mut writer.*, b", label %cancel")
    run decimal(&mut writer.*, cancelled)
    cancelled = cancelled + usize.ONE
  }
  run append(&mut writer.*, b" ]\ndispatch:\nswitch i32 ")
  run append(&mut writer.*, Bytes.asSlice(&state))
  run append(&mut writer.*, b", label %invalid [ i32 0, label %start")
  let mut resumed = usize.ONE
  while resumed < states.length {
    run append(&mut writer.*, b" i32 ")
    run decimal(&mut writer.*, resumed)
    run append(&mut writer.*, b", label %resume")
    run decimal(&mut writer.*, resumed)
    resumed = resumed + usize.ONE
  }
  run append(&mut writer.*, b" ]\ninvalid:\nunreachable\nstart:\n")
  run transferState(&mut writer.*, Vector.asSlice<FrameSlot>(&states[usize.ZERO].slots), false)
  run emitHiddenStores(&mut writer.*, function)
  run append(&mut writer.*, b"br label %")
  run label(&mut writer.*, usize.ZERO)
  run append(&mut writer.*, b"\n")
  let blocks = Vector.asSlice<Block>(&function.blocks)
  let points = Vector.asSlice<usize>(&stepping.coroutine.points)
  resumed = usize.ONE
  while resumed < states.length {
    run append(&mut writer.*, b"resume")
    run decimal(&mut writer.*, resumed)
    run append(&mut writer.*, b":\n")
    run transferState(&mut writer.*, Vector.asSlice<FrameSlot>(&states[resumed].slots), false)
    if let Terminator.Relinquish {resume, ..} = &blocks[points[resumed - usize.ONE]].terminator {
      run append(&mut writer.*, b"br label %")
      run label(&mut writer.*, resume)
      run append(&mut writer.*, b"\n")
    }
    if let Terminator.Call {normal, failure, ..} = &blocks[points[resumed - usize.ONE]].terminator {
      if let Option<FailureEdge>.Some {value: edge} = &failure {
        let failed = run byteOffset(&mut writer.*, b"%transfer", Coroutine.transferFailed(word))
        let flag = run temp(&mut writer.*)
        run append(&mut writer.*, Bytes.asSlice(&flag))
        run append(&mut writer.*, b" = load i8, ptr ")
        run append(&mut writer.*, Bytes.asSlice(&failed))
        run append(&mut writer.*, b"\n")
        let taken = run temp(&mut writer.*)
        run append(&mut writer.*, Bytes.asSlice(&taken))
        run append(&mut writer.*, b" = icmp ne i8 ")
        run append(&mut writer.*, Bytes.asSlice(&flag))
        run append(&mut writer.*, b", 0\nbr i1 ")
        run append(&mut writer.*, Bytes.asSlice(&taken))
        run append(&mut writer.*, b", label %")
        run label(&mut writer.*, edge.target)
        run append(&mut writer.*, b", label %")
      } else {
        run append(&mut writer.*, b"br label %")
      }
      run label(&mut writer.*, normal)
      run append(&mut writer.*, b"\n")
    }
    resumed = resumed + usize.ONE
  }
  // State `k + 1` cancels by restoring what lives after point `k` and entering its cancel exit.
  cancelled = usize.ONE
  while cancelled < states.length {
    run append(&mut writer.*, b"cancel")
    run decimal(&mut writer.*, cancelled)
    run append(&mut writer.*, b":\n")
    let entry = Coroutine.cancelAfter(function, points[cancelled - usize.ONE])
    if entry == usize.MAX {
      run append(&mut writer.*, b"call void @llvm.trap()\nunreachable\n")
    } else {
      run transferState(&mut writer.*, Vector.asSlice<FrameSlot>(&states[cancelled].slots), false)
      run append(&mut writer.*, b"br label %")
      run label(&mut writer.*, entry)
      run append(&mut writer.*, b"\n")
    }
    cancelled = cancelled + usize.ONE
  }
  let mut at = usize.ZERO
  while at < blocks.length {
    run label(&mut writer.*, at)
    run append(&mut writer.*, b":\n")
    run emitBlock(&mut writer.*, function, target, layouts, &blocks[at], foreign, identities, suspended, at)
    at = at + usize.ONE
  }
  return run append(&mut writer.*, b"}\n")
}

// Completes the frame on top: records whether it failed, pops it, releases it to its storage
// state, and reports completion to the driver.
effect fn emitPop(writer: &mut Writer, target: &Target, stepping: &Suspended, failed: Option<bool>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let word = wordSize(target)
  if let Option<bool>.Some {value} = move failed {
    let flag = run byteOffset(&mut writer.*, b"%transfer", Coroutine.transferFailed(word))
    run append(&mut writer.*, b"store i8 ")
    if value { run append(&mut writer.*, b"1") } else { run append(&mut writer.*, b"0") }
    run append(&mut writer.*, b", ptr ")
    run append(&mut writer.*, Bytes.asSlice(&flag))
    run append(&mut writer.*, b"\n")
  }
  let parent = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&parent))
  run append(&mut writer.*, b" = load ptr, ptr %frame\n")
  run storeWordAt(&mut writer.*, Bytes.asSlice(&parent), b"%transfer", Coroutine.transferTop(word))
  let state = run temp(&mut writer.*)
  run append(&mut writer.*, Bytes.asSlice(&state))
  run append(&mut writer.*, b" = load ptr, ptr %transfer\ncall void @")
  run quoted(&mut writer.*, Bytes.asSlice(&stepping.facts.release))
  run append(&mut writer.*, b"(ptr ")
  run append(&mut writer.*, Bytes.asSlice(&state))
  return run append(&mut writer.*, b", ptr %frame)\nret i32 0\n")
}

// A step's `Return` writes the result through the caller's result address before completing.
effect fn emitStepReturn(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout],
  stepping: &Suspended, span: Span) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let resultLayout = run layoutOf(layouts, &function.result, function, span)
  let kind = storageRepresentation(&function.result, target, resultLayout)
  if !kind.unit {
    let returned = Operand.Copy {place: Place {local: usize.ZERO, projections: Vector.make<Projection>()}}
    let value = run emitOperand(&mut writer.*, function, target, layouts, &returned)
    let output = Address {ty: Shared.clone<Type>(&function.result), text: run Bytes.copy(b"%out"),
      alignment: resultLayout.alignment, representation: kind}
    run storeValue(&mut writer.*, &output, &value)
  }
  let mut failed = Option.none<bool>()
  if failureLocal(function) != usize.MAX { failed = Option.some<bool>(false) }
  return run emitPop(&mut writer.*, target, stepping, move failed)
}

// A step's `Fail` writes the failure through the caller's failure address before completing.
effect fn emitStepFail(writer: &mut Writer, function: &MirFunction, target: &Target, layouts: &[TypeLayout],
  stepping: &Suspended, span: Span) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let local = failureLocal(function)
  if local == usize.MAX {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.make(GapCode.TypedForm, &owner, span)
  }
  let locals = Vector.asSlice<Local>(&function.locals)
  let failureLayout = run layoutOf(layouts, &locals[local].ty, function, span)
  let kind = storageRepresentation(&locals[local].ty, target, failureLayout)
  if !kind.unit {
    let failedValue = Operand.Copy {place: Place {local: local, projections: Vector.make<Projection>()}}
    let value = run emitOperand(&mut writer.*, function, target, layouts, &failedValue)
    let output = Address {ty: Shared.clone<Type>(&locals[local].ty), text: run Bytes.copy(b"%fail"),
      alignment: failureLayout.alignment, representation: kind}
    run storeValue(&mut writer.*, &output, &value)
  }
  return run emitPop(&mut writer.*, target, stepping, Option.some<bool>(true))
}

// A relinquishment saves the locals its resume state restores and returns 2: the frames stay in
// the package's transfer record until the package's start continues them.
effect fn emitRelinquish(writer: &mut Writer, target: &Target, stepping: &Suspended, state: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let word = wordSize(target)
  let resume = run byteOffset(&mut writer.*, b"%frame", Coroutine.stateOffset(word))
  run append(&mut writer.*, b"store i32 ")
  run decimal(&mut writer.*, state)
  run append(&mut writer.*, b", ptr ")
  run append(&mut writer.*, Bytes.asSlice(&resume))
  run append(&mut writer.*, b"\n")
  let states = Vector.asSlice<State>(&stepping.coroutine.states)
  run transferState(&mut writer.*, Vector.asSlice<FrameSlot>(&states[state].slots), true)
  // The package's activation records the relinquishment its drive reads (`Lifecycle.Relinquished`).
  let package = run loadWordAt(&mut writer.*, b"%transfer", Coroutine.transferPackage(word))
  let activation = run byteOffset(&mut writer.*, Bytes.asSlice(&package), Coroutine.packageActivation(word))
  run append(&mut writer.*, b"store i")
  run decimal(&mut writer.*, word * 8)
  run append(&mut writer.*, b" ")
  run decimal(&mut writer.*, SealedCore.lifecycleWord(Lifecycle.Relinquished))
  run append(&mut writer.*, b", ptr ")
  run append(&mut writer.*, Bytes.asSlice(&activation))
  return run append(&mut writer.*, b"\nret i32 2\n")
}

// A call at a suspension point saves the locals its resume state restores, pushes the callee's
// frame with the call's operands, and returns to the driver, which runs the callee next.
effect fn emitSuspendingCall(
  writer: &mut Writer,
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  identities: &[InstanceIdentity],
  stepping: &Suspended,
  state: usize,
  callee: &Callee,
  arguments: &Vector<Operand>,
  providers: &Vector<Operand>,
  diagnostics: &Option<Diagnostics>,
  destination: &Place,
  failure: &Option<FailureEdge>,
  span: Span,
) -> () ! Gap | OutOfMemoryError ? &mut Allocator {
  let mut symbol = Bytes.make()
  if let Callee.Instance {key} = &callee.* { symbol = run InstanceIdentity.name(identities, &key) }
  else {
    let owner = InstanceKey.identity(&function.key)
    fail Gap.make(GapCode.TypedForm, &owner, span)
  }
  let word = wordSize(target)
  let output = run emitPlace(&mut writer.*, function, target, layouts, destination)
  let mut failed = Option.none<Address>()
  let mut context = Option.none<Bytes>()
  if let Option<FailureEdge>.Some {value: edge} = &failure.* {
    failed = Option.some<Address>(run emitPlace(&mut writer.*, function, target, layouts, &edge.destination))
    if let Option<Diagnostics>.Some {..} = &diagnostics.* {
      context = Option.some<Bytes>(run companionAddress(function, edge.destination.local))
    }
  }
  let values = Vector.asSlice<Operand>(arguments)
  let mut evaluated = Vector.make<Value>()
  let mut index = usize.ZERO
  while index < values.length {
    let value = run emitArgument(&mut writer.*, function, target, layouts, &values[index])
    if !value.scalar.unit { run Vector.append<Value>(&mut evaluated, move value) }
    index = index + usize.ONE
  }
  let mut addresses = Vector.make<Value>()
  let hidden = Vector.asSlice<Operand>(providers)
  index = usize.ZERO
  while index < hidden.length {
    run Vector.append<Value>(&mut addresses, run emitOperand(&mut writer.*, function, target, layouts, &hidden[index]))
    index = index + usize.ONE
  }
  if let Option<Diagnostics>.Some {value: observed} = &diagnostics.* {
    run Vector.append<Value>(&mut addresses, run emitOperand(&mut writer.*, function, target, layouts, &observed.observer))
    run Vector.append<Value>(&mut addresses, run emitOperand(&mut writer.*, function, target, layouts, &observed.cause))
  }
  let resume = run byteOffset(&mut writer.*, b"%frame", Coroutine.stateOffset(word))
  run append(&mut writer.*, b"store i32 ")
  run decimal(&mut writer.*, state)
  run append(&mut writer.*, b", ptr ")
  run append(&mut writer.*, Bytes.asSlice(&resume))
  run append(&mut writer.*, b"\n")
  let states = Vector.asSlice<State>(&stepping.coroutine.states)
  run transferState(&mut writer.*, Vector.asSlice<FrameSlot>(&states[state].slots), true)
  run append(&mut writer.*, b"call void ")
  run suffixedSymbol(&mut writer.*, Bytes.asSlice(&symbol), b"$enter")
  run append(&mut writer.*, b"(ptr %transfer")
  let prepared = Vector.asSlice<Value>(&evaluated)
  index = usize.ZERO
  while index < prepared.length {
    run append(&mut writer.*, b", ")
    run typeName(&mut writer.*, prepared[index].scalar)
    run append(&mut writer.*, b" ")
    run append(&mut writer.*, Bytes.asSlice(&prepared[index].text))
    index = index + usize.ONE
  }
  let passed = Vector.asSlice<Value>(&addresses)
  index = usize.ZERO
  while index < passed.length {
    run append(&mut writer.*, b", ptr ")
    run append(&mut writer.*, Bytes.asSlice(&passed[index].text))
    index = index + usize.ONE
  }
  let fallible = match &failed { Option<Address>.Some {..} => true Option<Address>.None => false }
  if fallible || !output.representation.unit {
    run append(&mut writer.*, b", ptr ")
    run append(&mut writer.*, Bytes.asSlice(&output.text))
  }
  if let Option<Address>.Some {value: failureSlot} = &failed {
    run append(&mut writer.*, b", ptr ")
    run append(&mut writer.*, Bytes.asSlice(&failureSlot.text))
    if let Option<Bytes>.Some {value: companion} = &context {
      run append(&mut writer.*, b", ptr ")
      run append(&mut writer.*, Bytes.asSlice(&companion))
    }
  }
  return run append(&mut writer.*, b")\nret i32 1\n")
}

// The extension attribute, with its trailing space, that the target's C ABI requires of a narrow
// integer lane.
effect fn cExtension(writer: &mut Writer, lane: Representation, target: &Target) -> () ! OutOfMemoryError ? &mut Allocator {
  if !CAbi.extendsNarrowIntegers(target) { return () }
  if lane.aggregate || lane.pointer || lane.floating || lane.unit || lane.bits == usize.ZERO || lane.bits >= 32 {
    return ()
  }
  if lane.signed { return run append(&mut writer.*, b"signext ") }
  return run append(&mut writer.*, b"zeroext ")
}

/// One deduplicated declaration candidate owned by an instance answer.
pub struct Declaration {
  pub symbol: Bytes
  pub text: Bytes
}

effect fn extension(writer: &mut Writer, rule: CExtension) -> () ! OutOfMemoryError ? &mut Allocator {
  return match rule {
    CExtension.None => ()
    CExtension.Signed => run append(&mut writer.*, b"signext ")
    CExtension.Unsigned => run append(&mut writer.*, b"zeroext ")
  }
}

effect fn laneType(writer: &mut Writer, lane: &CAbi.Lane, declaration: &Shared<DeclarationId>, span: Span) -> ()
! Gap | OutOfMemoryError
? &mut Allocator {
  match lane.layout.abi {
    Abi.Unit => {
      return run append(&mut writer.*, b"void")
    }
    Abi.Pointer => {
      return run append(&mut writer.*, b"ptr")
    }
    Abi.Floating => {
      if lane.layout.size == 4 {
        return run append(&mut writer.*, b"float")
      }
      return run append(&mut writer.*, b"double")
    }
    Abi.Integer => {}
    Abi.Indirect => {
      fail Gap.make(GapCode.CAbiAggregate, declaration, span)
    }
  }
  run append(&mut writer.*, b"i")
  return run decimal(&mut writer.*, lane.layout.size * 8)
}

// Writes `bytes` as one LLVM quoted string, escaping quotes, backslashes and nonprinting bytes.
effect fn quoted(writer: &mut Writer, bytes: &[u8]) -> ()
! OutOfMemoryError
? &mut Allocator {
  run append(&mut writer.*, b"\"")
  let digits = b"0123456789ABCDEF"
  let mut at = usize.ZERO
  while at < bytes.length {
    let byte = bytes[at]
    if byte >= 32 && byte < 127 && byte != 34 && byte != 92 {
      run append(&mut writer.*, &[byte])
    } else {
      run append(&mut writer.*, b"\\")
      run append(&mut writer.*, &[digits[u8.toUsize(byte / 16)], digits[u8.toUsize(byte % 16)]])
    }
    at = at + usize.ONE
  }
  return run append(&mut writer.*, b"\"")
}

/// Prints signatures only. The final join rejects conflicting native symbols.
pub effect fn foreignDeclarations(foreign: &[CAbi.Signature]) -> Vector<Declaration>
! Gap | OutOfMemoryError
? &mut Allocator {
  let mut output = Vector.make<Declaration>()
  let mut at = usize.ZERO
  while at < foreign.length {
    let signature = &foreign[at]
    if signature.variadic && (signature.global || Vector.length<CAbi.Lane>(&signature.parameters) == usize.ZERO) {
      fail Gap.make(GapCode.CAbiVariadic, &signature.declaration, signature.span)
    }
    let mut writer = Writer {text: Bytes.make(), next: usize.ZERO, symbol: Bytes.make(), constants: Bytes.make(), trap: Option.none<TrapReport>()}
    if signature.global {
      // A C object is an external global of its value lane, defined by the C side.
      run append(&mut writer, b"@")
      run quoted(&mut writer, Bytes.asSlice(&signature.symbol))
      run append(&mut writer, b" = external global ")
      run laneType(&mut writer, &signature.result, &signature.declaration, signature.span)
      run append(&mut writer, b"\n")
      run Vector.append<Declaration>(
        &mut output,
        Declaration {symbol: run Bytes.copy(Bytes.asSlice(&signature.symbol)), text: move writer.text},
      )
      at = at + usize.ONE
      continue
    }
    run append(&mut writer, b"declare ")
    run extension(&mut writer, signature.result.extension)
    run laneType(&mut writer, &signature.result, &signature.declaration, signature.span)
    run append(&mut writer, b" @")
    run quoted(&mut writer, Bytes.asSlice(&signature.symbol))
    run append(&mut writer, b"(")
    let parameters = Vector.asSlice<CAbi.Lane>(&signature.parameters)
    let mut parameter = usize.ZERO
    while parameter < parameters.length {
      if parameter > usize.ZERO {
        run append(&mut writer, b", ")
      }
      run laneType(&mut writer, &parameters[parameter], &signature.declaration, signature.span)
      run append(&mut writer, b" ")
      run extension(&mut writer, parameters[parameter].extension)
      parameter = parameter + usize.ONE
    }
    if signature.variadic { run append(&mut writer, b", ...") }
    run append(&mut writer, b")\n")
    run Vector.append<Declaration>(
      &mut output,
      Declaration {symbol: run Bytes.copy(Bytes.asSlice(&signature.symbol)), text: move writer.text},
    )
    at = at + usize.ONE
  }
  return move output
}

fn sameDeclarationRight(first: &DeclarationId, right: &Shared<DeclarationId>) -> bool {
  return Shared.with<DeclarationId, bool>(
    right,
    fn(second: &DeclarationId) -> bool {
      return DeclarationId.equals(first, second)
    },
  )
}
