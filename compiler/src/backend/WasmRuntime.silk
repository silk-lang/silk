__attribute__((import_module("wasi_snapshot_preview1"), import_name("fd_advise"))) unsigned silk_import_fd_advise(unsigned fd, unsigned long long offset, unsigned long long length, unsigned advice);
unsigned silk_wasi_fd_advise(unsigned fd, unsigned long long offset, unsigned long long length, unsigned advice) { return silk_import_fd_advise(fd, offset, length, advice); }
__attribute__((import_module("wasi_snapshot_preview1"), import_name("fd_allocate"))) unsigned silk_import_fd_allocate(unsigned fd, unsigned long long offset, unsigned long long length);
unsigned silk_wasi_fd_allocate(unsigned fd, unsigned long long offset, unsigned long long length) { return silk_import_fd_allocate(fd, offset, length); }
__attribute__((import_module("wasi_snapshot_preview1"), import_name("fd_close"))) unsigned silk_import_fd_close(unsigned fd);
unsigned silk_wasi_fd_close(unsigned fd) { return silk_import_fd_close(fd); }
__attribute__((import_module("wasi_snapshot_preview1"), import_name("fd_datasync"))) unsigned silk_import_fd_datasync(unsigned fd);
unsigned silk_wasi_fd_datasync(unsigned fd) { return silk_import_fd_datasync(fd); }
__attribute__((import_module("wasi_snapshot_preview1"), import_name("fd_fdstat_get"))) unsigned silk_import_fd_fdstat_get(unsigned fd, void * stat);
unsigned silk_wasi_fd_fdstat_get(unsigned fd, void * stat) { return silk_import_fd_fdstat_get(fd, stat); }
__attribute__((import_module("wasi_snapshot_preview1"), import_name("fd_fdstat_set_flags"))) unsigned silk_import_fd_fdstat_set_flags(unsigned fd, unsigned flags);
unsigned silk_wasi_fd_fdstat_set_flags(unsigned fd, unsigned flags) { return silk_import_fd_fdstat_set_flags(fd, flags); }
__attribute__((import_module("wasi_snapshot_preview1"), import_name("fd_fdstat_set_rights"))) unsigned silk_import_fd_fdstat_set_rights(unsigned fd, unsigned long long base, unsigned long long inheriting);
unsigned silk_wasi_fd_fdstat_set_rights(unsigned fd, unsigned long long base, unsigned long long inheriting) { return silk_import_fd_fdstat_set_rights(fd, base, inheriting); }
