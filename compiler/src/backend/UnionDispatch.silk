import semantic.SourceLocations {Location}
//! Union dispatch: the MIR of an interface operation whose `Self` is a structural union
//! (UNION-003).
//!
//! # When to use
//! Build a [`UnionDispatch`] from the operation's closed signature and each member's selected
//! witness instance, then lower it with [`UnionDispatch.lower`].
//!
//! # Details
//! The operation receives the union through a reference, its first parameter or, for a service
//! operation, its own provider, and names `Self` nowhere else.
//! The body reads the receiver's tag and, for the active member, borrows that member's payload
//! with the receiver's access and calls the member's witness with the remaining parameters and the
//! providers it needs. An operand the witness borrows is lent to it and dropped after the call,
//! on both exits. The witness writes the result directly; its failure, when it has one, goes
//! to this function's failure out-slot and leaves through `Fail`.

import semantic.Types {Types}
import backend.InstanceKey {InstanceKey}
import backend.Layout {Layout}
import backend.Mir {
  ErasureFact,
  Variable,
  Inlining,
  Block,
  Callee,
  Cancel,
  ContextText,
  Diagnostics,
  decimalBytes,
  EscapeSite,
  FailureEdge,
  Local,
  LocalKind,
  MirFunction,
  NonParkingRun,
  Operand,
  Place,
  Projection,
  Reference,
  Rvalue,
  SharedAccess,
  Statement,
  SwitchCase,
  Terminator,
  TrapSite,
  causeType,
  siteType,
  observerAddress,
}
import hir.Hir {Access, InfixOperator, Multiplicity}
import semantic.DeclarationId {DeclarationId}
import semantic.Lifetime {Lifetime}
import semantic.Specialization {Edge}
import semantic.Type {Type}
import semantic.TypedBody {BorrowStatus, Origin}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.mem.shared {Shared}
import silk.mem.interned {Interned}
import silk.num.usize
import silk.collections.list {List}

/// A by-value operand the member's witness takes by reference.
pub struct Borrowed {
  /// The operand's parameter index; the receiver is 0.
  pub parameter: usize,
  pub access: Access,
  /// The operand's drop glue, when it owns cleanup.
  pub glue: Option<InstanceKey>,
}

/// The call one union member's arm makes.
pub struct Arm {
  /// The member's canonical tag.
  pub tag: usize,
  /// The member type the payload projection reads.
  pub member: Interned<Type>,
  /// The member's selected witness instance.
  pub callee: InstanceKey,
  /// For each requirement entry of the callee, the index of the own provider that serves it.
  pub providers: List<usize>,
  /// Whether the callee can fail; its failure type equals this function's failure type.
  pub fails: bool,
  /// The operands the callee borrows, by increasing parameter index.
  pub borrows: List<Borrowed>,
}

/// The closed shape of one union dispatch instance.
pub struct UnionDispatch {
  pub key: InstanceKey,
  pub result: Interned<Type>,
  /// The runtime parameters.
  pub parameters: List<Interned<Type>>,
  /// The own provider that addresses the union, for a service operation; otherwise the first
  /// parameter is the reference to the union and the witness receives the rest.
  pub receiver: Option<usize>,
  pub ambientIndex: usize,
  pub ambientExtent: usize,
  /// The address type of each own provider, in canonical requirement order.
  pub providers: List<Interned<Type>>,
  /// The failure type; `never` when the operation cannot fail.
  pub failure: Interned<Type>,
  pub fails: bool,
  /// The union's canonical member count.
  pub count: usize,
  pub arms: List<Arm>,
}

impl UnionDispatch {
  /// The dispatch body.
  pub effect fn lower(self: UnionDispatch, observing: bool) -> MirFunction ! OutOfMemoryError ? &mut Allocator | &mut Types {
    let origin = Origin {node: usize.ZERO, location: Location.generated()}
    let parameters = List<Interned<Type>>.asSlice(&self.parameters)
    let mut locals = List<Local>.make()
    run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&self.result), kind: LocalKind.Return, origin: origin})
    let mut at = usize.ZERO
    while at < parameters.length {
      run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&parameters[at]), kind: LocalKind.Parameter {index: at},
        origin: origin})
      at = at + usize.ONE
    }
    let providerStart = List<Local>.length(&locals)
    let providers = List<Interned<Type>>.asSlice(&self.providers)
    at = usize.ZERO
    while at < providers.length {
      run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&providers[at]), kind: LocalKind.Provider {index: at},
        origin: origin})
      at = at + usize.ONE
    }
    let observer = List<Local>.length(&locals)
    if observing {
      run List<Local>.append(&mut locals, Local {ty: run observerAddress(), kind: LocalKind.Observer, origin: origin})
      run List<Local>.append(&mut locals, Local {ty: run causeType(), kind: LocalKind.Cause, origin: origin})
      run List<Local>.append(&mut locals, Local {ty: run siteType(), kind: LocalKind.Site, origin: origin})
    }
    let mut failure = usize.MAX
    if self.fails {
      failure = List<Local>.length(&locals)
      run List<Local>.append(&mut locals, Local {ty: Interned<Type>.clone(&self.failure), kind: LocalKind.Failure, origin: origin})
    }
    let mut address = usize.ONE
    let mut first = usize.ONE
    let mut addressType = Interned<Type>.clone(&self.result)
    match &self.receiver {
      Option<usize>.Some {value: index} => {
        address = providerStart + index
        first = usize.ZERO
        addressType = Interned<Type>.clone(&providers[index])
      }
      Option<usize>.None => { addressType = Interned<Type>.clone(&parameters[usize.ZERO]) }
    }
    let access = Interned<Type>.with<Access>(&addressType, |value: &Type| -> Access {
      return match &value.* { Type.Reference {access, ..} => access _ => Access.Shared }
    })
    let mut blocks = List<Block>.make()
    let mut entry = run block(&mut blocks, origin)
    let erased = Interned<Type>.with<bool>(&addressType, Type.erasedReference)
    let empty = erased && self.count == usize.ZERO
    let direct = erased && self.count == usize.ONE
    let mut done = usize.MAX
    if !empty {
      done = run block(&mut blocks, origin)
      terminate(&mut blocks, done, Terminator.Return {origin: origin})
    }
    if !empty && self.ambientIndex < self.ambientExtent {
      entry = run selectAmbient(&mut blocks, &mut locals, entry, done, address, &addressType, self.ambientIndex, self.ambientExtent, origin)
    }
    let mut failed = usize.MAX
    if self.fails && !empty {
      failed = run block(&mut blocks, origin)
      terminate(&mut blocks, failed, Terminator.Fail {origin: origin})
    }
    let mut otherwise = usize.MAX
    if !direct && !empty { otherwise = run block(&mut blocks, origin) }
    let tag = List<Local>.length(&locals)
    if self.count > usize.ZERO && !direct {
      let tagType = if erased { run Types.intern(Type.Primitive {name: run Bytes.copy(b"u64")}) } else { run Layout.tagType(self.count) }
      run List<Local>.append(&mut locals, Local {ty: move tagType, kind: LocalKind.Temp, origin: origin})
      let mut read = Rvalue.Discriminant {place: run receiver(address)}
      if erased {
        let mut field = place(address)
        run List<Projection>.append(&mut field.projections, Projection.Field {index: usize.ZERO})
        read = Rvalue.Use {value: Operand.Copy {place: move field}}
      }
      run statement(&mut blocks, entry, Statement.Assign {destination: place(tag), value: move read, origin: origin})
    }
    let mut abandon = usize.MAX
    if !empty {
      abandon = run block(&mut blocks, origin)
      terminate(&mut blocks, abandon, Terminator.Abandon {origin: origin})
    }
    let mut cancels = List<Cancel>.make()
    let mut references = List<Reference>.make()
    let mut cases = List<SwitchCase>.make()
    let arms = List<Arm>.asSlice(&self.arms)
    at = usize.ZERO
    while at < arms.length {
      let arm = if direct { entry } else { run block(&mut blocks, origin) }
      if !direct {
        let value = if erased {
          run decimalBytes(run InstanceKey.memberTag(&arms[at].member, &DeclarationId.copyShared(&InstanceKey.identity(&self.key))))
        } else { run Type.extentText(arms[at].tag) }
        run List<SwitchCase>.append(&mut cases, SwitchCase {decimal: move value, negative: false, target: arm})
      }
      let borrowed = run Types.intern(Type.Reference {referent: Interned<Type>.clone(&arms[at].member), access: access,
        lifetime: run Types.internLifetime(Lifetime.Static)})
      let payload = List<Local>.length(&locals)
      run List<Local>.append(&mut locals, Local {ty: move borrowed, kind: LocalKind.Temp, origin: origin})
      if erased {
        let mut field = place(address)
        run List<Projection>.append(&mut field.projections, Projection.Field {index: usize.ONE})
        run statement(&mut blocks, arm, Statement.Assign {destination: place(payload), value: Rvalue.Use {value: Operand.Copy {place: move field}}, origin: origin})
      } else {
        let mut member = run receiver(address)
        run List<Projection>.append(&mut member.projections, Projection.Payload {index: arms[at].tag, ty: Interned<Type>.clone(&arms[at].member)})
        run statement(&mut blocks, arm, Statement.Assign {destination: place(payload), value: Rvalue.Ref {access: access, place: move member},
          origin: origin})
      }
      let mut arguments = List<Operand>.make()
      run List<Operand>.append(&mut arguments, Operand.Move {place: place(payload)})
      let borrows = List<Borrowed>.asSlice(&arms[at].borrows)
      let mut lent = usize.ZERO
      let mut parameter = first
      while parameter < parameters.length {
        if lent < borrows.length && borrows[lent].parameter == parameter {
          let loan = List<Local>.length(&locals)
          run List<Local>.append(&mut locals, Local {ty: run Types.intern(Type.Reference {referent: Interned<Type>.clone(&parameters[parameter]),
            access: borrows[lent].access, lifetime: run Types.internLifetime(Lifetime.Static)}), kind: LocalKind.Temp, origin: origin})
          run statement(&mut blocks, arm, Statement.Assign {destination: place(loan),
            value: Rvalue.Ref {access: borrows[lent].access, place: place(parameter + usize.ONE)}, origin: origin})
          run List<Operand>.append(&mut arguments, Operand.Move {place: place(loan)})
          lent = lent + usize.ONE
        } else {
          run List<Operand>.append(&mut arguments, Operand.Move {place: place(parameter + usize.ONE)})
        }
        parameter = parameter + usize.ONE
      }
      // A lent operand is still this function's: each exit drops it after the call.
      let mut normal = done
      let mut failedExit = failed
      let mut cancelled = abandon
      if ownsCleanup(borrows) {
        cancelled = run release(&mut blocks, &mut references, borrows, abandon, observing, observer, origin)
        normal = run release(&mut blocks, &mut references, borrows, done, observing, observer, origin)
        if arms[at].fails { failedExit = run release(&mut blocks, &mut references, borrows, failed, observing, observer, origin) }
      }
      run List<Cancel>.append(&mut cancels, Cancel {point: arm, entry: cancelled})
      let mut served = List<Operand>.make()
      let sources = List<usize>.asSlice(&arms[at].providers)
      let mut source = usize.ZERO
      while source < sources.length {
        run List<Operand>.append(&mut served, Operand.Copy {place: place(providerStart + sources[source])})
        source = source + usize.ONE
      }
      let mut diagnostics = Option<Diagnostics>.none()
      if observing {
        diagnostics = Option<Diagnostics>.some(run Diagnostics.make(Operand.Copy {place: place(observer)},
          Operand.Copy {place: place(observer + usize.ONE)}, Operand.Copy {place: place(observer + usize.ONE + usize.ONE)}))
      }
      let mut edge = Option<FailureEdge>.none()
      if arms[at].fails {
        edge = Option<FailureEdge>.some(FailureEdge {destination: place(failure), target: failedExit})
      }
      run List<Reference>.append(&mut references, Reference {key: InstanceKey.copy(&arms[at].callee), edge: Edge.Witness, origin: origin})
      terminate(&mut blocks, arm, Terminator.Call {callee: Callee.Instance {key: InstanceKey.copy(&arms[at].callee)},
        arguments: move arguments, providers: move served, diagnostics: move diagnostics, destination: place(usize.ZERO),
        normal: normal, failure: move edge, origin: origin})
      at = at + usize.ONE
    }
    if self.count == usize.ZERO {
      terminate(&mut blocks, entry, Terminator.Unreachable {origin: origin})
    } else if !direct {
      terminate(&mut blocks, entry, Terminator.Switch {value: Operand.Copy {place: place(tag)}, cases: move cases,
        otherwise: otherwise, origin: origin})
    }
    run MirFunction.sortReferences(&mut references)
    return MirFunction {
      key: move self.key, borrow: BorrowStatus.Checked, result: move self.result, parameters: move self.parameters,
      locals: move locals, blocks: move blocks, references: move references, externs: List<Interned<DeclarationId>>.make(),
      observes: false, contexts: List<ContextText>.make(), traps: List<TrapSite>.make(), suspension: Option<Origin>.none(),
      parks: Option<Origin>.none(), releasesPackages: false, nonParking: List<NonParkingRun>.make(), cancels: move cancels,
      accesses: List<SharedAccess>.make(), escapes: List<EscapeSite>.make(), erasures: List<ErasureFact>.make(), features: Bytes.make(), inlining: Inlining.Default, optimizeSize: false, variadic: false, frame: Bytes.make(), lines: List<u64>.make(), variables: List<Variable>.make(), inlined: List<InstanceKey>.make(), quiet: List<InstanceKey>.make(),
    }
  }
}

effect fn ambientPointer(ty: &Interned<Type>) -> Interned<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run Types.intern(Type.Pointer {pointee: Interned<Type>.clone(ty), access: Access.Mutable,
    nullable: true, multiplicity: Multiplicity.Single, alignment: Option<u64>.none()})
}

effect fn temp(locals: &mut List<Local>, ty: &Interned<Type>, origin: Origin) -> usize ! OutOfMemoryError ? &mut Allocator {
  let index = List<Local>.length(&locals.*)
  run List<Local>.append(&mut locals.*, Local {ty: Interned<Type>.clone(ty), kind: LocalKind.Temp, origin: origin})
  return index
}

effect fn set(blocks: &mut List<Block>, at: usize, destination: Place, value: Rvalue, origin: Origin) -> () ! OutOfMemoryError ? &mut Allocator {
  return run statement(&mut blocks.*, at, Statement.Assign {destination: move destination, value: move value, origin: origin})
}

effect fn frameWord(frame: usize, index: usize) -> Place ! OutOfMemoryError ? &mut Allocator {
  let mut result = run receiver(frame)
  run List<Projection>.append(&mut result.projections, Projection.ConstIndex {index: index})
  return move result
}

// Each occupied slot points to an owned handle whose first field is the erased descriptor.
 // Only the running execution can reach this mutable table. Mask its entry until the
 // non-suspending witness returns so calls back into the same service select its default.
effect fn selectAmbient(blocks: &mut List<Block>, locals: &mut List<Local>, entry: usize, done: usize,
  address: usize, descriptor: &Interned<Type>, index: usize, extent: usize, origin: Origin) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let word = run Types.intern(Type.Primitive {name: run Bytes.copy(b"usize")})
  let boolean = run Types.intern(Type.Primitive {name: run Bytes.copy(b"bool")})
  let handle = run ambientPointer(descriptor)
  let tableType = run Types.intern(Type.Array {element: Interned<Type>.clone(&handle), extent: run Type.extentText(extent)})
  let pointer = run ambientPointer(&tableType)
  let slot = run temp(&mut locals.*, &run ambientPointer(&pointer), origin)
  let table = run temp(&mut locals.*, &pointer, origin)
  let selected = run temp(&mut locals.*, &handle, origin)
  let bits = run temp(&mut locals.*, &word, origin)
  let vacant = run temp(&mut locals.*, &boolean, origin)
  let noTable = run temp(&mut locals.*, &boolean, origin)
  let inspect = run block(&mut blocks.*, origin)
  let apply = run block(&mut blocks.*, origin)
  let dispatch = run block(&mut blocks.*, origin)
  let restore = run block(&mut blocks.*, origin)
  let finish = run block(&mut blocks.*, origin)
  run set(&mut blocks.*, entry, place(slot), Rvalue.AmbientSlot, origin)
  run set(&mut blocks.*, entry, place(table), Rvalue.Use {value: Operand.Copy {place: run receiver(slot)}}, origin)
  run set(&mut blocks.*, entry, place(bits), Rvalue.AddressIntegerConversion {operand: Operand.Copy {place: place(table)}, destinationType: Interned<Type>.clone(&word)}, origin)
  run set(&mut blocks.*, entry, place(noTable), Rvalue.Binary {operation: InfixOperator.Equals, left: Operand.Copy {place: place(bits)},
    right: Operand.Integer {decimal: run Bytes.copy(b"0"), negative: false, ty: Interned<Type>.clone(&word)}}, origin)
  terminate(&mut blocks.*, entry, Terminator.Branch {condition: Operand.Copy {place: place(noTable)}, thenBlock: dispatch, elseBlock: inspect, origin: origin})
  run set(&mut blocks.*, inspect, place(selected), Rvalue.Use {value: Operand.Copy {place: run frameWord(table, index)}}, origin)
  run set(&mut blocks.*, inspect, place(bits), Rvalue.AddressIntegerConversion {operand: Operand.Copy {place: place(selected)}, destinationType: Interned<Type>.clone(&word)}, origin)
  run set(&mut blocks.*, inspect, place(vacant), Rvalue.Binary {operation: InfixOperator.Equals, left: Operand.Copy {place: place(bits)},
    right: Operand.Integer {decimal: run Bytes.copy(b"0"), negative: false, ty: Interned<Type>.clone(&word)}}, origin)
  terminate(&mut blocks.*, inspect, Terminator.Branch {condition: Operand.Copy {place: place(vacant)}, thenBlock: dispatch, elseBlock: apply, origin: origin})
  run set(&mut blocks.*, apply, place(address), Rvalue.Use {value: Operand.Copy {place: run receiver(selected)}}, origin)
  run set(&mut blocks.*, apply, run frameWord(table, index), Rvalue.Use {value: Operand.Null {ty: Interned<Type>.clone(&handle)}}, origin)
  terminate(&mut blocks.*, apply, Terminator.Goto {target: dispatch, origin: origin})
  terminate(&mut blocks.*, done, Terminator.Branch {condition: Operand.Copy {place: place(noTable)}, thenBlock: finish, elseBlock: restore, origin: origin})
  run set(&mut blocks.*, restore, run frameWord(table, index), Rvalue.Use {value: Operand.Copy {place: place(selected)}}, origin)
  terminate(&mut blocks.*, restore, Terminator.Goto {target: finish, origin: origin})
  terminate(&mut blocks.*, finish, Terminator.Return {origin: origin})
  return dispatch
}

fn ownsCleanup(borrows: &[Borrowed]) -> bool {
  let mut at = usize.ZERO
  while at < borrows.length {
    if let Option<InstanceKey>.Some {..} = &borrows[at].glue { return true }
    at = at + usize.ONE
  }
  return false
}

// A block that drops each lent operand that owns cleanup, then continues to `next`.
effect fn release(blocks: &mut List<Block>, references: &mut List<Reference>, borrows: &[Borrowed], next: usize,
  observing: bool, observer: usize, origin: Origin) -> usize ! OutOfMemoryError ? &mut Allocator {
  let at = run block(&mut blocks.*, origin)
  let mut index = usize.ZERO
  while index < borrows.length {
    if let Option<InstanceKey>.Some {value: glue} = &borrows[index].glue {
      let mut diagnostics = Option<Diagnostics>.none()
      if observing {
        diagnostics = Option<Diagnostics>.some(run Diagnostics.make(Operand.Copy {place: place(observer)},
          Operand.Copy {place: place(observer + usize.ONE)}, Operand.Copy {place: place(observer + usize.ONE + usize.ONE)}))
      }
      run List<Reference>.append(&mut references.*, Reference {key: InstanceKey.copy(&glue), edge: Edge.Direct, origin: origin})
      run statement(&mut blocks.*, at, Statement.Drop {destination: place(borrows[index].parameter + usize.ONE),
        glue: InstanceKey.copy(&glue), diagnostics: move diagnostics, origin: origin})
    }
    index = index + usize.ONE
  }
  terminate(&mut blocks.*, at, Terminator.Goto {target: next, origin: origin})
  return at
}

fn place(local: usize) -> Place {
  return Place {local: local, projections: List<Projection>.make()}
}

// The union the reference in local `address` addresses.
effect fn receiver(address: usize) -> Place ! OutOfMemoryError ? &mut Allocator {
  let mut projected = place(address)
  run List<Projection>.append(&mut projected.projections, Projection.Deref)
  return move projected
}

effect fn block(blocks: &mut List<Block>, origin: Origin) -> usize ! OutOfMemoryError ? &mut Allocator {
  let index = List<Block>.length(&blocks.*)
  run List<Block>.append(&mut blocks.*, Block {suspends: false, statements: List<Statement>.make(), terminator: Terminator.Unreachable {origin: origin}})
  return index
}

fn terminate(blocks: &mut List<Block>, at: usize, terminator: Terminator) -> () {
  let mut listed = List<Block>.asMutSlice(&mut blocks.*)
  listed[at].terminator = move terminator
  return ()
}

effect fn statement(blocks: &mut List<Block>, at: usize, value: Statement) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut listed = List<Block>.asMutSlice(&mut blocks.*)
  return run List<Statement>.append(&mut listed[at].statements, move value)
}
