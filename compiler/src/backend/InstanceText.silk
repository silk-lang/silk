//! One immutable content-keyed LLVM definition and its assembly metadata.
import backend.CAbi
import backend.CAbi {Extension, Passing}
import backend.Coroutine {Facts as CoroutineFacts}
import backend.InstanceKey {InstanceKey}
import backend.InstanceIdentity {InstanceIdentity}
import backend.InstanceRecipe {InstanceRecipe}
import backend.Layout {Abi, Layout, TypeLayout}
import backend.LlvmCode
import backend.Mir {MirFunction}
import semantic.ContentHash {ContentHash, Stream}
import semantic.DeclarationId {DeclarationId}
import semantic.RuntimeEncoding
import semantic.RuntimeEncoding {Coordinates}
import semantic.Target {Target}
import semantic.Type {Type}
import semantic.TypedBody {BorrowStatus}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.usize
import silk.list {List}

pub struct InstanceText {
  pub encoding: Bytes,
  pub symbol: Bytes,
  pub text: Bytes,
  pub foreign: List<LlvmCode.Declaration>,
  pub borrow: BorrowStatus,
}

effect fn hashLane(stream: &mut Stream, lane: &CAbi.Lane, owner: &DeclarationId) -> ()
! OutOfMemoryError
? &mut Allocator {
  let ty = run Type.runtimeEncoding(&lane.ty, owner)
  RuntimeEncoding.hashField(&mut stream.*, Bytes.asSlice(&ty))
  RuntimeEncoding.hashWord(&mut stream.*, usize.toU64(lane.layout.size))
  RuntimeEncoding.hashWord(&mut stream.*, usize.toU64(lane.layout.alignment))
  RuntimeEncoding.hashWord(
    &mut stream.*,
    match lane.layout.abi {
      Abi.Unit => 0
      Abi.Integer => 1
      Abi.Floating => 2
      Abi.Pointer => 3
      Abi.Indirect => 4
      Abi.Vector => 5
    },
  )
  RuntimeEncoding.hashWord(
    &mut stream.*,
    match lane.extension {
      Extension.None => 0
      Extension.Signed => 1
      Extension.Unsigned => 2
    },
  )
  RuntimeEncoding.hashWord(&mut stream.*, match lane.passing {
    Passing.Direct => 0
    Passing.Coerce => 1
    Passing.Indirect => 2
    Passing.Ignore => 3
  })
  let mut grouped: u64 = 0
  let mut byval: u64 = 0
  if lane.grouped { grouped = 1 }
  if lane.byval { byval = 1 }
  RuntimeEncoding.hashWord(&mut stream.*, grouped)
  RuntimeEncoding.hashWord(&mut stream.*, byval)
  RuntimeEncoding.hashWord(&mut stream.*, usize.toU64(lane.stackAlignment))
  let pieces = List<CAbi.Piece>.asSlice(&lane.pieces)
  RuntimeEncoding.hashWord(&mut stream.*, usize.toU64(pieces.length))
  let mut at = usize.ZERO
  while at < pieces.length {
    RuntimeEncoding.hashWord(&mut stream.*, usize.toU64(pieces[at].offset))
    RuntimeEncoding.hashWord(&mut stream.*, usize.toU64(pieces[at].bits))
    RuntimeEncoding.hashWord(&mut stream.*, usize.toU64(pieces[at].lanes))
    RuntimeEncoding.hashWord(&mut stream.*, match pieces[at].abi {
      Abi.Unit => 0
      Abi.Integer => 1
      Abi.Floating => 2
      Abi.Pointer => 3
      Abi.Indirect => 4
      Abi.Vector => 5
    })
    at = at + usize.ONE
  }
  return ()
}

/// The digest of the exact compiler input content, independently of source revisions and other
/// instances' bodies.
pub effect fn content(
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  foreign: &[CAbi.Signature],
  signatures: &[u8],
) -> ContentHash ! OutOfMemoryError ? &mut Allocator {
  let mut coordinates = RuntimeEncoding.coordinates()
  let recipe = run InstanceRecipe.make(function)
  let encoded = run encodings(&recipe, &mut coordinates)
  let declaration = InstanceKey.identity(&recipe.key)
  let owner = DeclarationId.copyShared(&declaration)
  let mut supplied = Bytes.make()
  let mut at = usize.ZERO
  while at < layouts.length {
    let entry = run layoutContent(&layouts[at], &owner)
    run Bytes.append(&mut supplied, Bytes.asSlice(&entry))
    at = at + usize.ONE
  }
  return run contentDigest(
    &recipe,
    target,
    layouts.length,
    Bytes.asSlice(&supplied),
    foreign,
    signatures,
    List<Bytes>.asSlice(&encoded),
    &Option<CoroutineFacts>.none(),
  )
}

/// The canonical encodings of the recipe's own instance and then of each callee, in recipe order.
pub effect fn encodings(recipe: &InstanceRecipe, coordinates: &mut Coordinates) -> List<Bytes>
! OutOfMemoryError
? &mut Allocator {
  let mut result = List<Bytes>.make()
  run List<Bytes>.append(&mut result, run InstanceKey.encodingAt(&recipe.key, &mut coordinates.*))
  let callees = List<InstanceKey>.asSlice(&recipe.callees)
  let mut at = usize.ZERO
  while at < callees.length {
    run List<Bytes>.append(&mut result, run InstanceKey.encodingAt(&callees[at], &mut coordinates.*))
    at = at + usize.ONE
  }
  return move result
}

/// The identities of the recipe's own instance and then of each callee, named by `encoded`, the
/// result of `encodings` for the same recipe.
pub effect fn identities(recipe: &InstanceRecipe, encoded: &[Bytes]) -> List<InstanceIdentity>
! OutOfMemoryError
? &mut Allocator {
  let mut result = List<InstanceIdentity>.make()
  run List<InstanceIdentity>.append(
    &mut result,
    run InstanceIdentity.make(&recipe.key, Bytes.asSlice(&encoded[usize.ZERO])),
  )
  let callees = List<InstanceKey>.asSlice(&recipe.callees)
  let mut at = usize.ZERO
  while at < callees.length {
    run List<InstanceIdentity>.append(
      &mut result,
      run InstanceIdentity.make(&callees[at], Bytes.asSlice(&encoded[at + usize.ONE])),
    )
    at = at + usize.ONE
  }
  return move result
}

/// The content of one supplied layout: its type's runtime encoding, then its layout facts.
/// Neither encoding records `owner`, so the content depends only on the layout and its type.
pub effect fn layoutContent(layout: &TypeLayout, owner: &DeclarationId) -> Bytes
! OutOfMemoryError
? &mut Allocator {
  let mut output = Bytes.make()
  let ty = run Type.runtimeEncoding(&layout.ty, owner)
  run RuntimeEncoding.field(&mut output, Bytes.asSlice(&ty))
  let facts = run Layout.encoding(&layout.layout, owner)
  run RuntimeEncoding.field(&mut output, Bytes.asSlice(&facts))
  return move output
}

/// The digest of the complete content subject prepared inside the semantic query system from the
/// function's one recipe, with the facts that make a suspendable instance's definition a coroutine.
/// The fields are hashed as they are encoded, so the subject itself is never built.
/// `layouts` is the [`layoutContent`] of each of the `layoutCount` supplied layouts, in order.
pub effect fn contentDigest(
  recipe: &InstanceRecipe,
  target: &Target,
  layoutCount: usize,
  layouts: &[u8],
  foreign: &[CAbi.Signature],
  signatures: &[u8],
  encoded: &[Bytes],
  suspension: &Option<CoroutineFacts>,
) -> ContentHash ! OutOfMemoryError ? &mut Allocator {
  let mut stream = ContentHash.stream()
  RuntimeEncoding.hashField(&mut stream, b"silk.llvm.instance.v1")
  RuntimeEncoding.hashField(&mut stream, Bytes.asSlice(&encoded[usize.ZERO]))
  RuntimeEncoding.hashField(&mut stream, Target.name(target))
  RuntimeEncoding.hashField(&mut stream, Bytes.asSlice(&recipe.shape))
  RuntimeEncoding.hashWord(&mut stream, usize.toU64(encoded.length - usize.ONE))
  let mut at = usize.ONE
  while at < encoded.length {
    RuntimeEncoding.hashField(&mut stream, Bytes.asSlice(&encoded[at]))
    at = at + usize.ONE
  }
  RuntimeEncoding.hashField(&mut stream, signatures)
  let declaration = InstanceKey.identity(&recipe.key)
  let owner = DeclarationId.copyShared(&declaration)
  RuntimeEncoding.hashWord(&mut stream, usize.toU64(layoutCount))
  ContentHash.append(&mut stream, layouts)
  RuntimeEncoding.hashWord(&mut stream, usize.toU64(foreign.length))
  at = usize.ZERO
  while at < foreign.length {
    let declaration = DeclarationId.copyShared(&foreign[at].declaration)
    let mut declared = Bytes.make()
    run RuntimeEncoding.declaration(&mut declared, &declaration)
    ContentHash.append(&mut stream, Bytes.asSlice(&declared))
    RuntimeEncoding.hashField(&mut stream, Bytes.asSlice(&foreign[at].symbol))
    let contract = run CAbi.identity(&foreign[at])
    RuntimeEncoding.hashField(&mut stream, Bytes.asSlice(&contract))
    let mut object: u64 = 0
    if foreign[at].global { object = 1 }
    RuntimeEncoding.hashWord(&mut stream, object)
    let mut variadic: u64 = 0
    if foreign[at].variadic { variadic = 1 }
    RuntimeEncoding.hashWord(&mut stream, variadic)
    run hashLane(&mut stream, &foreign[at].result, &owner)
    let parameters = List<CAbi.Lane>.asSlice(&foreign[at].parameters)
    RuntimeEncoding.hashWord(&mut stream, usize.toU64(parameters.length))
    let mut parameter = usize.ZERO
    while parameter < parameters.length {
      run hashLane(&mut stream, &parameters[parameter], &owner)
      parameter = parameter + usize.ONE
    }
    at = at + usize.ONE
  }
  // A suspendable definition depends on which callees suspend and on the storage operations.
  if let Option<CoroutineFacts>.Some {value: facts} = &suspension.* {
    RuntimeEncoding.hashWord(&mut stream, 1)
    let callees = List<InstanceKey>.asSlice(&recipe.callees)
    at = usize.ZERO
    while at < callees.length {
      let mut suspends: u64 = 0
      if run CoroutineFacts.suspends(&facts, &callees[at]) { suspends = 1 }
      RuntimeEncoding.hashWord(&mut stream, suspends)
      at = at + usize.ONE
    }
    RuntimeEncoding.hashField(&mut stream, Bytes.asSlice(&facts.create))
    RuntimeEncoding.hashField(&mut stream, Bytes.asSlice(&facts.acquire))
    RuntimeEncoding.hashField(&mut stream, Bytes.asSlice(&facts.release))
    RuntimeEncoding.hashField(&mut stream, Bytes.asSlice(&facts.destroy))
  } else {
    RuntimeEncoding.hashWord(&mut stream, 0)
  }
  return ContentHash.finish(move stream)
}
