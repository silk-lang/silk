//! One immutable content-keyed LLVM definition and its assembly metadata.
import backend.CAbi
import backend.CAbi {Extension}
import backend.InstanceKey {InstanceKey}
import backend.InstanceIdentity {InstanceIdentity}
import backend.InstanceRecipe {InstanceRecipe}
import backend.Layout {Abi, Layout, TypeLayout}
import backend.LlvmText
import backend.Mir {MirFunction}
import semantic.DeclarationId {DeclarationId}
import semantic.RuntimeEncoding
import semantic.Target {Target}
import semantic.Type {Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.usize
import silk.vector {Vector}

pub struct InstanceText {
  pub encoding: Bytes
  pub symbol: Bytes
  pub text: Bytes
  pub foreign: Vector<LlvmText.Declaration>
  pub safetyChecked: bool
}

effect fn laneContent(output: &mut Bytes, lane: &CAbi.Lane, owner: &DeclarationId) -> ()
! OutOfMemoryError
? &mut Allocator {
  let ty = run Type.runtimeEncoding(&lane.ty, owner)
  run RuntimeEncoding.field(&mut output.*, Bytes.asSlice(&ty))
  run RuntimeEncoding.word(&mut output.*, usize.toU64(lane.layout.size))
  run RuntimeEncoding.word(&mut output.*, usize.toU64(lane.layout.alignment))
  run RuntimeEncoding.word(
    &mut output.*,
    match lane.layout.abi {
      Abi.Unit => 0
      Abi.Integer => 1
      Abi.Floating => 2
      Abi.Pointer => 3
      Abi.Indirect => 4
    },
  )
  run RuntimeEncoding.word(
    &mut output.*,
    match lane.extension {
      Extension.None => 0
      Extension.Signed => 1
      Extension.Unsigned => 2
    },
  )
  return ()
}

/// Exact compiler input content, independently of source revisions and other instances' bodies.
pub effect fn content(
  function: &MirFunction,
  target: &Target,
  layouts: &[TypeLayout],
  foreign: &[CAbi.Signature],
  signatures: &[u8],
) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut coordinates = RuntimeEncoding.coordinates()
  let mut identities = Vector.make<InstanceIdentity>()
  run Vector.append<InstanceIdentity>(
    &mut identities,
    run InstanceIdentity.make(&function.key, &mut coordinates),
  )
  let recipe = run InstanceRecipe.make(function)
  let callees = Vector.asSlice<InstanceKey>(&recipe.callees)
  let mut at = usize.ZERO
  while at < callees.length {
    run Vector.append<InstanceIdentity>(
      &mut identities,
      run InstanceIdentity.make(&callees[at], &mut coordinates),
    )
    at = at + usize.ONE
  }
  return run contentWith(
    &recipe,
    target,
    layouts,
    foreign,
    signatures,
    Vector.asSlice<InstanceIdentity>(&identities),
  )
}

/// The complete content subject prepared inside the semantic query system from the function's
/// one recipe.
pub effect fn contentWith(
  recipe: &InstanceRecipe,
  target: &Target,
  layouts: &[TypeLayout],
  foreign: &[CAbi.Signature],
  signatures: &[u8],
  identities: &[InstanceIdentity],
) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut output = Bytes.make()
  run RuntimeEncoding.field(&mut output, b"silk.llvm.instance.v1")
  run RuntimeEncoding.field(&mut output, Bytes.asSlice(&identities[usize.ZERO].encoding))
  run RuntimeEncoding.field(&mut output, Target.name(target))
  run RuntimeEncoding.field(&mut output, Bytes.asSlice(&recipe.shape))
  run RuntimeEncoding.word(&mut output, usize.toU64(identities.length - usize.ONE))
  let mut at = usize.ONE
  while at < identities.length {
    run RuntimeEncoding.field(&mut output, Bytes.asSlice(&identities[at].encoding))
    at = at + usize.ONE
  }
  run RuntimeEncoding.field(&mut output, signatures)
  let mut checked: u64 = 0
  if recipe.safetyChecked {
    checked = 1
  }
  run RuntimeEncoding.word(&mut output, checked)
  let declaration = InstanceKey.identity(&recipe.key)
  let owner = run DeclarationId.copyShared(&declaration)
  run RuntimeEncoding.word(&mut output, usize.toU64(layouts.length))
  at = usize.ZERO
  while at < layouts.length {
    let ty = run Type.runtimeEncoding(&layouts[at].ty, &owner)
    run RuntimeEncoding.field(&mut output, Bytes.asSlice(&ty))
    let facts = run Layout.encoding(&layouts[at].layout, &owner)
    run RuntimeEncoding.field(&mut output, Bytes.asSlice(&facts))
    at = at + usize.ONE
  }
  run RuntimeEncoding.word(&mut output, usize.toU64(foreign.length))
  at = usize.ZERO
  while at < foreign.length {
    let declaration = run DeclarationId.copyShared(&foreign[at].declaration)
    run RuntimeEncoding.declaration(&mut output, &declaration)
    run RuntimeEncoding.field(&mut output, Bytes.asSlice(&foreign[at].symbol))
    let mut object: u64 = 0
    if foreign[at].global { object = 1 }
    run RuntimeEncoding.word(&mut output, object)
    run laneContent(&mut output, &foreign[at].result, &owner)
    let parameters = Vector.asSlice<CAbi.Lane>(&foreign[at].parameters)
    run RuntimeEncoding.word(&mut output, usize.toU64(parameters.length))
    let mut parameter = usize.ZERO
    while parameter < parameters.length {
      run laneContent(&mut output, &parameters[parameter], &owner)
      parameter = parameter + usize.ONE
    }
    at = at + usize.ONE
  }
  return move output
}
