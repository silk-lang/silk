//! One immutable content-keyed LLVM definition and its assembly metadata.
import backend.CAbi
import backend.InstanceKey {InstanceKey}
import backend.InstanceRecipe {InstanceRecipe}
import backend.Layout {Layout, TypeLayout}
import backend.LlvmText
import backend.Mir {MirFunction}
import semantic.DeclarationId {DeclarationId}
import semantic.RuntimeEncoding
import semantic.Target {Target}
import semantic.Type {Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.usize
import silk.vector {Vector}

pub struct InstanceText {
  pub key: InstanceKey
  pub encoding: Bytes
  pub symbol: Bytes
  pub text: Bytes
  pub foreign: Vector<LlvmText.Declaration>
  pub safetyChecked: bool
}

/// Exact compiler input content, independently of source revisions and other instances' bodies.
pub effect fn content(function: &MirFunction, target: &Target, layouts: &[TypeLayout],
  foreign: &[CAbi.Signature], signatures: &[u8]) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let mut output = Bytes.make()
  run RuntimeEncoding.field(&mut output, b"silk.llvm.instance.v1")
  let identity = run InstanceKey.encoding(&function.key)
  run RuntimeEncoding.field(&mut output, Bytes.asSlice(&identity))
  run RuntimeEncoding.field(&mut output, Target.name(target))
  let recipe = run InstanceRecipe.make(function)
  run RuntimeEncoding.field(&mut output, Bytes.asSlice(&recipe.shape))
  let callees = Vector.asSlice<InstanceKey>(&recipe.callees)
  run RuntimeEncoding.word(&mut output, usize.toU64(callees.length))
  let mut at = usize.ZERO
  while at < callees.length {
    let selected = run InstanceKey.encoding(&callees[at])
    run RuntimeEncoding.field(&mut output, Bytes.asSlice(&selected))
    at = at + usize.ONE
  }
  run RuntimeEncoding.field(&mut output, signatures)
  run RuntimeEncoding.word(&mut output, match function.safetyChecked { true => 1 false => 0 })
  let declaration = InstanceKey.identity(&function.key)
  let owner = run DeclarationId.copyShared(&declaration)
  run RuntimeEncoding.word(&mut output, usize.toU64(layouts.length))
  at = usize.ZERO
  while at < layouts.length {
    let ty = run Type.runtimeEncoding(&layouts[at].ty, &owner)
    run RuntimeEncoding.field(&mut output, Bytes.asSlice(&ty))
    let facts = run Layout.encoding(&layouts[at].layout, &owner)
    run RuntimeEncoding.field(&mut output, Bytes.asSlice(&facts))
    at = at + usize.ONE
  }
  run RuntimeEncoding.word(&mut output, usize.toU64(foreign.length))
  at = usize.ZERO
  while at < foreign.length {
    let declaration = run DeclarationId.copyShared(&foreign[at].declaration)
    run RuntimeEncoding.declaration(&mut output, &declaration)
    run RuntimeEncoding.field(&mut output, Bytes.asSlice(&foreign[at].symbol))
    // Every admitted foreign lane is scalar; its complete layout is supplied above.
    let result = run Type.runtimeEncoding(&foreign[at].result.ty, &owner)
    run RuntimeEncoding.field(&mut output, Bytes.asSlice(&result))
    let parameters = Vector.asSlice<CAbi.Lane>(&foreign[at].parameters)
    run RuntimeEncoding.word(&mut output, usize.toU64(parameters.length))
    let mut parameter = usize.ZERO
    while parameter < parameters.length {
      let ty = run Type.runtimeEncoding(&parameters[parameter].ty, &owner)
      run RuntimeEncoding.field(&mut output, Bytes.asSlice(&ty))
      parameter = parameter + usize.ONE
    }
    at = at + usize.ONE
  }
  return move output
}
