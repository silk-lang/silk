//! Unit tests for transitive binary fragment ICF over Bitcode `SLKF`/`SLKA` and x86-64
//! [`X86Object.Fragment`] streams.

import backend.Bitcode
import backend.Bitcode {Module as BitcodeModule}
import backend.FragmentIcf
import backend.FragmentIcf {FragmentRef}
import backend.X86Object {
  Fragment as X86Fragment,
  Function as X86Function,
  Object as X86ObjectEntry,
  Pointer as X86Pointer,
  Relocation as X86Relocation,
  RelocationKind as X86RelocationKind,
  RodataJumpEntry as X86RodataJump,
}
import backend.X86Unwind {UnwindInfo}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.u64
import silk.num.usize
import silk.testing.testing {AssertionError, Testing}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn makeLeafFragment(name: &[u8], value: u64) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut module = BitcodeModule.make()
  let i64Ty = run BitcodeModule.integer(&mut module, 64)
  let fnTy = run BitcodeModule.function(&mut module, i64Ty, &[], false)
  let fnId = run BitcodeModule.defineFunction(&mut module, name, fnTy, 0, 0)
  run BitcodeModule.beginBody(&mut module, fnId, &[], &[])
  let _entry = run BitcodeModule.block(&mut module, 0)
  let c = run BitcodeModule.int(&mut module, i64Ty, value)
  run BitcodeModule.ret(&mut module, c)
  run BitcodeModule.endBody(&mut module)
  return run BitcodeModule.serialize(&module)
}

effect fn makeCallerFragment(name: &[u8], callee: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut module = BitcodeModule.make()
  let i64Ty = run BitcodeModule.integer(&mut module, 64)
  let fnTy = run BitcodeModule.function(&mut module, i64Ty, &[], false)
  let fnId = run BitcodeModule.defineFunction(&mut module, name, fnTy, 0, 0)
  run BitcodeModule.beginBody(&mut module, fnId, &[], &[])
  let _entry = run BitcodeModule.block(&mut module, 0)
  let called = run BitcodeModule.callNamed(&mut module, callee, fnTy, &[])
  run BitcodeModule.ret(&mut module, called)
  run BitcodeModule.endBody(&mut module)
  return run BitcodeModule.serialize(&module)
}

effect fn checkBitcodeFold<'a>(
  leafA: &'a [u8],
  leafB: &'a [u8],
  leafRetained: &'a [u8],
  callerA: &'a [u8],
  callerB: &'a [u8],
  distinct: &'a [u8],
  fragLeafA: &'a [u8],
  fragLeafB: &'a [u8],
  fragLeafRetained: &'a [u8],
  fragCallerA: &'a [u8],
  fragCallerB: &'a [u8],
  fragDistinct: &'a [u8],
) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut refs = List<FragmentRef<'a>>.make()
  run List<FragmentRef<'a>>.append(&mut refs, FragmentRef<'a> {symbol: leafA, bytes: fragLeafA, retained: false})
  run List<FragmentRef<'a>>.append(&mut refs, FragmentRef<'a> {symbol: leafB, bytes: fragLeafB, retained: false})
  run List<FragmentRef<'a>>.append(&mut refs, FragmentRef<'a> {symbol: leafRetained, bytes: fragLeafRetained, retained: true})
  run List<FragmentRef<'a>>.append(&mut refs, FragmentRef<'a> {symbol: callerA, bytes: fragCallerA, retained: false})
  run List<FragmentRef<'a>>.append(&mut refs, FragmentRef<'a> {symbol: callerB, bytes: fragCallerB, retained: false})
  run List<FragmentRef<'a>>.append(&mut refs, FragmentRef<'a> {symbol: distinct, bytes: fragDistinct, retained: false})

  let fold = run FragmentIcf.foldBitcode(List<FragmentRef<'a>>.asSlice(&refs))
  run Testing.expect(fold.foldedCount == 3, "leafA and leafB fold into retained leafRetained, and callerB transitively folds to callerA")
  run Testing.expect(!List<bool>.get(&fold.kept, 0), "non-retained leafA folds into retained leafRetained")
  run Testing.expect(!List<bool>.get(&fold.kept, 1), "non-retained leafB folds into retained leafRetained")
  run Testing.expect(List<bool>.get(&fold.kept, 2), "retained leafRetained is never folded away")
  run Testing.expect(List<bool>.get(&fold.kept, 3), "canonical callerA is kept")
  run Testing.expect(!List<bool>.get(&fold.kept, 4), "transitive duplicate callerB is folded away")
  run Testing.expect(List<bool>.get(&fold.kept, 5), "distinct function is kept")
  run Testing.expect(sameBytes(fold.resolve(leafA), leafRetained), "leafA resolves to leafRetained")
  run Testing.expect(sameBytes(fold.resolve(leafB), leafRetained), "leafB resolves to leafRetained")
  run Testing.expect(sameBytes(fold.resolve(callerB), callerA), "callerB resolves to callerA")

  // In-place rewrite swaps aliased 37-byte callee references cleanly.
  let mut rewritten = Bytes.make()
  run FragmentIcf.appendRewrittenBitcode(&mut rewritten, fragCallerB, &fold)
  let rewrittenGlobals = run Bitcode.globalsOf(Bytes.asSlice(&rewritten))
  let mut sawTarget = false
  let mut sawLeafB = false
  let gSlice = List<Bitcode.Named>.asSlice(&rewrittenGlobals)
  let mut at = usize.ZERO
  while at < gSlice.length {
    if sameBytes(Bytes.asSlice(&gSlice[at].name), leafRetained) { sawTarget = true }
    if sameBytes(Bytes.asSlice(&gSlice[at].name), leafB) { sawLeafB = true }
    at = at + usize.ONE
  }
  run Testing.expect(sawTarget && !sawLeafB, "appendRewrittenBitcode rewrites leafB callee to leafRetained")

  // Per-unit SLKA alias fragment resolves aliased callees during Bitcode.Module.mergeAll.
  let aliasFrag = run FragmentIcf.unitAliasFragment(fragCallerB, &fold)
  run Testing.expect(Bitcode.isAliasFragment(Bytes.asSlice(&aliasFrag), usize.ZERO), "unitAliasFragment emits SLKA")
  let mut stream = Bytes.make()
  run Bytes.append(&mut stream, Bytes.asSlice(&aliasFrag))
  run Bytes.append(&mut stream, fragLeafRetained)
  run Bytes.append(&mut stream, fragCallerB)
  let mut merged = BitcodeModule.make()
  run BitcodeModule.mergeAll(&mut merged, Bytes.asSlice(&stream))
  run Testing.expect(merged.find(leafB) == usize.MAX, "SLKA alias eliminates leafB from merged module")
  run Testing.expect(merged.find(leafRetained) != usize.MAX, "SLKA alias keeps leafRetained in merged module")
  return ()
}

effect fn runBitcodeIcfCheck() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let leafA = b"silk_00000000000000000000000000000001"
  let leafB = b"silk_00000000000000000000000000000002"
  let leafRetained = b"silk_00000000000000000000000000000003"
  let callerA = b"silk_00000000000000000000000000000004"
  let callerB = b"silk_00000000000000000000000000000005"
  let distinct = b"silk_00000000000000000000000000000006"

  let fragLeafA = run makeLeafFragment(leafA, 42)
  let fragLeafB = run makeLeafFragment(leafB, 42)
  let fragLeafRetained = run makeLeafFragment(leafRetained, 42)
  let fragCallerA = run makeCallerFragment(callerA, leafA)
  let fragCallerB = run makeCallerFragment(callerB, leafB)
  let fragDistinct = run makeLeafFragment(distinct, 99)

  return run checkBitcodeFold(
    leafA,
    leafB,
    leafRetained,
    callerA,
    callerB,
    distinct,
    Bytes.asSlice(&fragLeafA),
    Bytes.asSlice(&fragLeafB),
    Bytes.asSlice(&fragLeafRetained),
    Bytes.asSlice(&fragCallerA),
    Bytes.asSlice(&fragCallerB),
    Bytes.asSlice(&fragDistinct),
  )
}

effect fn makeX86Func(symbol: &[u8], code: &[u8], callee: &[u8]) -> X86Function ! OutOfMemoryError ? &mut Allocator {
  let mut relocs = List<X86Relocation>.make()
  let mut syms = List<Bytes>.make()
  if callee.length > usize.ZERO {
    run List<Bytes>.append(&mut syms, run Bytes.copy(callee))
    run List<X86Relocation>.append(
      &mut relocs,
      X86Relocation {offset: usize.ONE, kind: X86RelocationKind.Plt32, target: usize.ZERO, addend: -4},
    )
  }
  return X86Function {
    symbol: run Bytes.copy(symbol),
    exported: Bytes.make(),
    code: run Bytes.copy(code),
    relocations: move relocs,
    symbols: move syms,
    rodata: Bytes.make(),
    rodataJumps: List<X86RodataJump>.make(),
    unwind: UnwindInfo.frameOnly(),
    locations: List<u64>.make(),
  }
}

effect fn runX86IcfCheck() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let leafA = b"silk_00000000000000000000000000000011"
  let leafB = b"silk_00000000000000000000000000000012"
  let callerA = b"silk_00000000000000000000000000000013"
  let callerB = b"silk_00000000000000000000000000000014"
  let root = b"main"

  let mut functions = List<X86Function>.make()
  let mut f1 = run makeX86Func(leafA, &[0xB8, 42, 0, 0, 0, 0xC3], b"")
  run List<u64>.append(&mut f1.locations, 0)
  run List<u64>.append(&mut f1.locations, 100)
  run List<X86Function>.append(&mut functions, move f1)
  let mut f2 = run makeX86Func(leafB, &[0xB8, 42, 0, 0, 0, 0xC3], b"")
  run List<u64>.append(&mut f2.locations, 0)
  run List<u64>.append(&mut f2.locations, 100)
  run List<X86Function>.append(&mut functions, move f2)
  let mut fDiffLoc = run makeX86Func(b"silk_00000000000000000000000000000015", &[0xB8, 42, 0, 0, 0, 0xC3], b"")
  run List<u64>.append(&mut fDiffLoc.locations, 0)
  run List<u64>.append(&mut fDiffLoc.locations, 200)
  run List<X86Function>.append(&mut functions, move fDiffLoc)
  let f3 = run makeX86Func(callerA, &[0xE8, 0, 0, 0, 0, 0xC3], leafA)
  run List<X86Function>.append(&mut functions, move f3)
  let f4 = run makeX86Func(callerB, &[0xE8, 0, 0, 0, 0, 0xC3], leafB)
  run List<X86Function>.append(&mut functions, move f4)
  let f5 = run makeX86Func(root, &[0xE8, 0, 0, 0, 0, 0xC3], callerB)
  run List<X86Function>.append(&mut functions, move f5)

  let mut ptrs = List<X86Pointer>.make()
  let pSym = run Bytes.copy(callerB)
  run List<X86Pointer>.append(&mut ptrs, X86Pointer {offset: usize.ZERO, symbol: move pSym, addend: 0, size: 8})
  let mut objects = List<X86ObjectEntry>.make()
  let oSym = run Bytes.copy(b"vtable_slot")
  let oImg = run Bytes.copy(&[0, 0, 0, 0, 0, 0, 0, 0])
  run List<X86ObjectEntry>.append(
    &mut objects,
    X86ObjectEntry {
      symbol: move oSym,
      alignment: 8,
      image: move oImg,
      pointers: move ptrs,
      framed: false,
      local: false,
      readonly: true,
      seen: false,
    },
  )

  let mut frag = X86Fragment {
    functions: move functions,
    objects: move objects,
    weakFunctions: List<Bytes>.make(),
    weakObjects: List<Bytes>.make(),
    refused: List<Bytes>.make(),
    declaredObjects: List<Bytes>.make(),
  }

  let folded = run FragmentIcf.foldX86Fragment(&mut frag)
  run Testing.expect(folded == 2, "x86 ICF folds leafB -> leafA (identical locations) and callerB -> callerA, keeping distinct-location copy")
  run Testing.expect(List<X86Function>.length(&frag.functions) == 4, "four functions remain (leafA, diffLoc, callerA, main)")
  let keptFuncs = List<X86Function>.asSlice(&frag.functions)
  let rootSyms = List<Bytes>.asSlice(&keptFuncs[3].symbols)
  run Testing.expect(sameBytes(Bytes.asSlice(&rootSyms[0]), callerA), "main relocation rewritten from callerB to callerA")
  let objs = List<X86ObjectEntry>.asSlice(&frag.objects)
  let objPtrs = List<X86Pointer>.asSlice(&objs[0].pointers)
  run Testing.expect(sameBytes(Bytes.asSlice(&objPtrs[0].symbol), callerA), "object pointer rewritten from callerB to callerA")
  return ()
}

test effect fn bitcodeTransitiveIcfAndSlkaAliases() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run runBitcodeIcfCheck() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn x86TransitiveIcfAndDebugLocations() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run runX86IcfCheck() |> Effect.provideMut<Allocator>(&mut allocator)
}
