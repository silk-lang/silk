//! Tracing of the compiler's own work.
//!
//! Asked for a trace, a compiler process records what it does as OpenTelemetry spans and logs
//! through `silk.trace`, and appends them to a file as OTLP JSON, one request per line. A command
//! is asked with `--trace <file>`, and `silkc compile` by the `trace` record of its compilation
//! request: [`Options`] is either. The environment asks for nothing. The spans are opened where
//! the work is: `@trace` on the function that does a phase, and `Trace.span` where the name or an
//! attribute is only known inside. Unasked, no recorder is provided, every span is the default
//! provider's empty one, and nothing here reads a clock or allocates.
//!
//! One semantic query and one borrow check are far smaller than a phase, and a build runs them
//! by the hundred thousand, so their spans are recorded only when [`Options.queries`] gives the
//! number of microseconds a run must take to be kept (0 keeps every one). A shorter run is kept
//! too when something below it is, so no span of the file lacks its parent. Their totals are
//! logged either way, by query family and by module.
//!
//! The recorder is bounded and never waits. A thread of its own writes the file, so that the
//! thread that compiles only records: [`pump`], after pieces of work, starts it, and [`flush`]
//! stops it and writes what is left. A process that copies itself with `fork` must have no other
//! thread, so it flushes first; so does one that replaces itself.

import driver.ProcessMemory
import ReleaseVersion
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u64
import silk.num.usize
import silk.system.host_input { HostInput }
import silk.text.string { InvalidUtf8, String }

/// What a compiler process is asked to trace: the `--trace` options of its command line, or the
/// `trace` record of the compilation request it compiles.
pub struct Options {
  /// The file the trace is appended to, as written; it is created when absent.
  pub file: Bytes,
  /// How many microseconds a semantic query run or a borrow check must take to be a span of its
  /// own; zero makes every one a span, and none leaves both without spans.
  pub queries: Option<u64>,
  /// The W3C `traceparent` of the span the process's own span continues: the one open in the
  /// program that started this process for a part of its traced work.
  pub parent: Option<Bytes>,
}

/// Whether this compiler can trace itself: it needs a host whose files it can append to.
pub const supported: bool = (Intrinsic.targetOperatingSystem() == "darwin" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64"))

/// The enclosing query and the start of one timed query run; [`leaveQuery`] closes it.
pub struct QueryMark {
  slot: usize,
  module: usize,
  outerSlot: usize,
  outerModule: usize,
  started: u64,
}

impl Copy for QueryMark {}

/// The runs of one query family, or of the queries about one module's declarations.
pub struct QueryTime {
  /// The family's name; empty for a module.
  pub name: string<'static>,
  pub runs: u64,
  /// The demands its memo answered without a run, the ones it had to verify among them included.
  pub hits: u64,
  /// The memo's answers that an edit had marked outdated and that were verified current.
  pub verified: u64,
  /// The time in these runs and in no query they demanded, in nanoseconds.
  pub own: u64,
  /// The time in these runs with everything they demanded, in nanoseconds. A run that demands
  /// its own family counts the inner run twice.
  pub total: u64,
}

impl Copy for QueryTime {}

/// The text of `bytes` for a span attribute: its last 64 bytes, as an attribute keeps no more and
/// the end of a path or of a declaration's name says more than its start.
pub fn label<'a>(bytes: &'a [u8]) -> string<'a> {
  let mut start = usize.ZERO
  if bytes.length > 64 {
    start = bytes.length - 64
  }
  while start < bytes.length && u8.bitAnd(bytes[start], 192) == 128 {
    start = start + usize.ONE
  }
  return match String.fromUtf8(Slice.view<u8>(bytes, start, bytes.length - start)) {
    Result<string<'a>, InvalidUtf8>.Success { value } => value
    Result<string<'a>, InvalidUtf8>.Failure { .. } => ""
  }
}

/// The last component of the path `bytes` for a span attribute, as [`label`] gives it: the name
/// of a program or of a file whose directory says nothing.
pub fn leaf<'a>(bytes: &'a [u8]) -> string<'a> {
  let mut start = bytes.length
  while start > usize.ZERO && bytes[start - usize.ONE] != 47 && bytes[start - usize.ONE] != 92 {
    start = start - usize.ONE
  }
  return label(Slice.view<u8>(bytes, start, bytes.length - start))
}

static if supported {
  import silk.concurrency.sync { Arc, Parker, Unparker }
  import silk.concurrency.thread_native { JoinHandle, NativeThread, SpawnError }
  import silk.io.logger { Logger }
  import silk.io.writer { WriterError }
  import silk.io.writer_native { StderrWriter }
  import silk.mem.pointer { Pointer }
  import silk.num.i64
  import silk.num.u32
  import silk.platform.native.clock { NativeClock }
  import silk.platform.native.descriptor { NativeDescriptor }
  import silk.platform.native.file { NativeFile, NativeFileError, OPEN_APPEND, OPEN_CREATE, OPEN_WRITE_ONLY }
  import silk.trace { SpanContext, SpanGuard, SpanKind, Trace, Tracer }
  import silk.trace.log { OtelLogger }
  import silk.trace.otlp { Batch, Resource, encodeInto }
  import silk.trace.record { Config, Recorder, Span }
  import silk.trace.signals { LogRecord }

  // How many spans or logs one line of the file holds.
  const batch: usize = 128

  // How many calls of `pump` pass between two writes.
  const pumped: u32 = 64

  // How long the writing thread waits between two writes, in nanoseconds: the recorder holds
  // 8192 finished spans, which the fastest work fills in no less than several milliseconds.
  const writeNanos: u64 = 1000000

  // What writes the file: what the drains take from the recorder, and which of it the file keeps.
  // The writing thread holds it while one runs, and the compiling thread between.
  struct Sink {
    recorder: Arc<Recorder>,
    descriptor: i32,
    // Whether query runs and borrow checks have spans.
    queries: bool,
    // The shortest query run or borrow check the file keeps, in nanoseconds.
    minimum: u64,
    // What one drain took from the recorder, and which of it the file keeps.
    taken: List<Span>,
    kept: List<bool>,
    // The parents of the spans the file has kept: a table of span identifiers, zero where
    // empty. A query run too short to keep is kept all the same when something below it was.
    wanted: List<u64>,
    wantedCount: usize,
    spans: List<Span>,
    // The line being written, kept so that encoding a line needs no allocation.
    line: Bytes,
    logs: List<LogRecord>,
    // Whether a write failed: the file is then left alone.
    broken: bool,
    // The identifier of the process's span once `abandon` wrote it, whose own close is left out;
    // zero before.
    abandoned: u64,
  }

  // The thread that writes the file while the compiling thread works, and the token that stops it.
  struct Writing {
    thread: JoinHandle<Sink>,
    wake: Unparker,
  }

  // What the process records with, and what its compiling thread keeps. Only that thread reads or
  // writes it; the recorder inside is what the other threads share.
  struct State {
    recorder: Arc<Recorder>,
    descriptor: i32,
    // Whether query runs and borrow checks have spans.
    queries: bool,
    // The shortest query run or borrow check the file keeps, in nanoseconds.
    minimum: u64,
    calls: u32,
    // What writes the file, when no thread holds it.
    sink: Option<Sink>,
    // The thread that holds it, while one runs.
    writing: Option<Writing>,
    // Whether a thread could not be started: the compiling thread then writes the file itself.
    threadless: bool,
    // The span the process's own continues, when the program that started it gave one.
    parent: Option<SpanContext>,
    // The span of the whole process, kept to write it if the process ends without closing it.
    root: Span,
    rooted: bool,
    // The root span was written by `abandon`: its own close is left out.
    abandoned: bool,
    families: List<QueryTime>,
    modules: List<QueryTime>,
    active: usize,
    activeModule: usize,
    since: u64,
  }

  /// A traced process's recorder and state. `main` keeps one for as long as the process runs,
  /// and a copy of the process makes its own with [`copied`].
  pub struct Session {
    recorder: Arc<Recorder>,
    logger: Arc<OtelLogger>,
    state: State,
  }

  // The address of the running session's state, or null when the process is not traced.
  fn slot() -> *mut ?*mut State {
    return Intrinsic.processSlot<?*mut State>()
  }

  fn now() -> u64 {
    let time = run NativeClock.now()
    return i64.toU64(time.seconds()) * 1000000000 + u32.toU64(time.subsecondNanoseconds())
  }

  /// Whether this process is traced.
  pub fn on() -> bool {
    return !Pointer.isNull<State>(unsafe Pointer.read(slot()))
  }

  /// Whether each query run and each borrow check has a span of its own.
  pub fn queries() -> bool {
    let mut anchor = ()
    if let Option<*mut State>.Some { value } = Pointer.nonNullMut<State>(unsafe Pointer.read(slot())) {
      return (unsafe Pointer.borrowMut(&mut anchor, value)).queries
    }
    return false
  }

  /// A reading of the clock for [`lasted`], or zero when query runs and borrow checks have no
  /// spans.
  pub fn clock() -> u64 {
    if queries() {
      return now()
    }
    return 0
  }

  /// Whether the query run or borrow check that began at `began`, a [`clock`] reading, has run
  /// long enough for the file to keep its span. What a span says about its subject costs more
  /// than the span, so it is worked out only for the spans that are kept.
  pub fn lasted(began: u64) -> bool {
    let mut anchor = ()
    if let Option<*mut State>.Some { value } = Pointer.nonNullMut<State>(unsafe Pointer.read(slot())) {
      let state = unsafe Pointer.borrowMut(&mut anchor, value)
      return state.queries && now() - began >= state.minimum
    }
    return false
  }

  /// A span for one query run or borrow check, named `name`, when those are recorded.
  @inlineAlways
  pub fn detail(static name: string<'static>) -> Option<SpanGuard> {
    if queries() {
      return Option<SpanGuard>.some(Trace.span(name))
    }
    return Option<SpanGuard>.none()
  }

  // A recorder's sizes: for a process that compiles, or with `small` for a copy that does one
  // piece of work.
  fn settings(small: bool) -> Config {
    let mut config = Config.make("silkc")
    config.serviceVersion = label(ReleaseVersion.value())
    // The deepest chain of open spans: queries demand queries.
    config.openCapacity = if small { 64 } else { 2048 }
    // Finished spans wait in pages of 128 until the compiling thread writes them: 64 pages hold
    // what the parsing and code generation threads finish while it waits for them.
    config.threadCapacity = if small { 4 } else { 64 }
    config.bufferCapacity = 128
    return config
  }

  fn fresh(recorder: &Arc<Recorder>, descriptor: i32, queries: bool, minimum: u64) -> Sink {
    return Sink {
      recorder: recorder.clone(),
      descriptor: descriptor,
      queries: queries,
      minimum: minimum,
      taken: List<Span>.make(),
      kept: List<bool>.make(),
      wanted: List<u64>.make(),
      wantedCount: usize.ZERO,
      spans: List<Span>.make(),
      line: Bytes.make(),
      logs: List<LogRecord>.make(),
      broken: false,
      abandoned: 0,
    }
  }

  effect fn session(descriptor: i32, queries: bool, minimum: u64, small: bool) -> Session
    ! OutOfMemoryError
    ? &mut Allocator {
    let recorder = run Arc<Recorder>.make(run Recorder.make(settings(small)))
    let logger = run Arc<OtelLogger>.make(OtelLogger.make(&recorder))
    let state = State {
      recorder: recorder.clone(),
      descriptor: descriptor,
      queries: queries,
      minimum: minimum,
      calls: 0,
      sink: Option<Sink>.some(fresh(&recorder, descriptor, queries, minimum)),
      writing: Option<Writing>.none(),
      threadless: false,
      parent: Option<SpanContext>.none(),
      root: Span.empty(),
      rooted: false,
      abandoned: false,
      families: List<QueryTime>.make(),
      modules: List<QueryTime>.make(),
      active: usize.MAX,
      activeModule: usize.MAX,
      since: 0,
    }
    return Session { recorder: move recorder, logger: move logger, state: move state }
  }

  effect fn unset<E>(error: E) -> Option<Bytes> {
    drop error
    return Option<Bytes>.none()
  }

  effect fn unopened(error: NativeFileError) -> i32 {
    drop error
    return -1
  }

  /// The session of a process asked to trace itself as `options` say, or none when the file
  /// cannot be opened, which standard error then says.
  pub effect fn open(options: &Options) -> Option<Session> ! OutOfMemoryError ? &mut Allocator {
    let descriptor = run Effect.catch<NativeFileError>(
      NativeFile.open(Bytes.asSlice(&options.file), OPEN_WRITE_ONLY + OPEN_CREATE + OPEN_APPEND, 420),
      unopened,
    )
    if descriptor < 0 {
      StderrWriter.print("silk: cannot write the trace file\n", &())
      return Option<Session>.none()
    }
    let mut queries = false
    let mut minimum = u64.MAX
    if let Option<u64>.Some { value: microseconds } = options.queries {
      queries = true
      minimum = u64.saturatingMultiply(microseconds, 1000)
    }
    let mut opened = run session(descriptor, queries, minimum, false)
    if let Option<Bytes>.Some { value } = &options.parent {
      opened.state.parent = Trace.parseTraceparent(label(Bytes.asSlice(&value)))
    }
    return Option<Session>.some(move opened)
  }

  /// Makes `session` the one this process records into. `session` must stay where it is until
  /// [`close`].
  pub fn install(session: &mut Session) -> () {
    unsafe Pointer.write(slot(), Pointer.fromMutRef(&mut session.state))
  }

  /// In a copy of the process made with `fork`: a session of the copy's own, writing to the same
  /// file, or none when the process is not traced. The copy must [`install`] it and run its work
  /// [`within`] it, so that its spans have identifiers no other process makes and continue the
  /// trace under the span that was open at the copy. `small` is for a copy that does one piece of
  /// work rather than a compilation: its recorder holds little.
  pub effect fn copied(small: bool) -> Option<Session> ! OutOfMemoryError ? &mut Allocator {
    let mut anchor = ()
    if let Option<*mut State>.Some { value } = Pointer.nonNullMut<State>(unsafe Pointer.read(slot())) {
      let state = unsafe Pointer.borrowMut(&mut anchor, value)
      let descriptor = state.descriptor
      let queries = state.queries
      let minimum = state.minimum
      // What the original left unwritten is the original's to write.
      unsafe Pointer.write(slot(), Pointer.null<State>())
      return Option<Session>.some(run session(descriptor, queries, minimum, small))
    }
    return Option<Session>.none()
  }

  /// Ends the tracing of a copy of the process that cannot run [`within`] a session of its own,
  /// as one made in the middle of a walk: what it does from here is in no trace.
  pub fn silence() -> () {
    unsafe Pointer.write(slot(), Pointer.null<State>())
  }

  /// Runs `work` with `session` recording its spans and logs, or as it is without one.
  pub effect fn within<'env, A, E, ?R>(session: &Option<Session>, work: once Effect<'env; A ! E ? R>) -> A
    ! E
    ? R {
    if let Option<Session>.Some { value } = &session.* {
      return run move work
        |> Effect.provideAmbient<Logger>(&value.logger)
        |> Effect.provideAmbient<Tracer>(&value.recorder)
    }
    return run move work
  }

  /// Opens the span of the whole process, named `silkc`, with its command. It continues the span
  /// [`Options.parent`] named when the session was opened.
  pub effect fn root() -> SpanGuard ? &mut HostInput | &mut Allocator {
    let mut anchor = ()
    let state = match Pointer.nonNullMut<State>(unsafe Pointer.read(slot())) {
      Option<*mut State>.Some { value } => unsafe Pointer.borrowMut(&mut anchor, value)
      Option<*mut State>.None => {
        return Trace.spanOf("silkc", SpanKind.Server)
      }
    }
    let remote = state.parent
    let guard = match remote {
      Option<SpanContext>.Some { value } => Trace.spanFrom(&value, "silkc")
      Option<SpanContext>.None => Trace.spanOf("silkc", SpanKind.Server)
    }
    let mut command = Bytes.make()
    if let Option<Bytes>.Some { value } = move run Effect.catchAll(HostInput.argument(usize.ONE), unset) {
      command = move value
    }
    Trace.set("command", &label(Bytes.asSlice(&command)))
    if let Option<SpanContext>.Some { value: current } = Trace.current() {
      state.root.context = current
      if let Option<SpanContext>.Some { value: parent } = remote {
        state.root.parent = parent
      }
      state.root.name = "silkc"
      state.root.kind = SpanKind.Server
      state.root.start = state.recorder.get().now()
      state.root.attributes.set("command", &label(Bytes.asSlice(&command)))
      state.rooted = true
    }
    return move guard
  }

  /// The W3C `traceparent` of the current span, with which a compiler this process starts
  /// continues the trace under it, or none when the process is not traced.
  pub effect fn parent() -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
    if on() {
      if let Option<SpanContext>.Some { value } = Trace.current() {
        let header = Trace.traceparent(&value)
        return Option<Bytes>.some(run Bytes.copy(String.utf8Bytes(header.view())))
      }
    }
    return Option<Bytes>.none()
  }

  // Whether the file keeps `span` for what it is: every span but a query run or borrow check
  // shorter than `minimum` that neither failed nor has an event.
  fn keeps(span: &Span, minimum: u64) -> bool {
    if minimum == 0 || span.end - span.start >= minimum || span.error || span.eventCount != usize.ZERO {
      return true
    }
    return !(String.startsWith(span.name, "query.") || span.name == "borrow.check")
  }

  // Whether the table `wanted` holds the span identifier `id`.
  fn wants(wanted: &[u64], id: u64) -> bool {
    if wanted.length == usize.ZERO || id == 0 {
      return false
    }
    let mask = wanted.length - usize.ONE
    let mut at = usize.bitAnd(u64.wrappingToUsize(id), mask)
    while wanted[at] != 0 {
      if wanted[at] == id {
        return true
      }
      at = usize.bitAnd(at + usize.ONE, mask)
    }
    return false
  }

  fn place(wanted: &mut [u64], id: u64) -> bool {
    let mask = wanted.length - usize.ONE
    let mut at = usize.bitAnd(u64.wrappingToUsize(id), mask)
    while wanted[at] != 0 {
      if wanted[at] == id {
        return false
      }
      at = usize.bitAnd(at + usize.ONE, mask)
    }
    wanted[at] = id
    return true
  }

  // Adds the span identifier `id` to the table of parents the file must keep.
  effect fn want(state: &mut Sink, id: u64) -> () ! OutOfMemoryError ? &mut Allocator {
    if id == 0 {
      return ()
    }
    if (state.wantedCount + usize.ONE) * 2 > List<u64>.length(&state.wanted) {
      let mut size: usize = 1024
      while size < List<u64>.length(&state.wanted) * 2 {
        size = size * 2
      }
      let mut grown = List<u64>.make()
      run List<u64>.appendRepeated(&mut grown, 0, size)
      let held = List<u64>.asSlice(&state.wanted)
      let mut at = usize.ZERO
      while at < held.length {
        if held[at] != 0 {
          drop place(List<u64>.asMutSlice(&mut grown), held[at])
        }
        at = at + usize.ONE
      }
      state.wanted = move grown
    }
    if place(List<u64>.asMutSlice(&mut state.wanted), id) {
      state.wantedCount = state.wantedCount + usize.ONE
    }
  }

  effect fn encoded(result: Result<(), WriterError | OutOfMemoryError>, line: &mut Bytes) -> () {
    if let Result<(), WriterError | OutOfMemoryError>.Failure { error } = move result {
      drop error
      Bytes.clear(&mut line.*)
    }
  }

  fn identity(recorder: &Recorder) -> Resource {
    return Resource {
      serviceName: recorder.serviceName(),
      serviceVersion: recorder.serviceVersion(),
      droppedSpans: recorder.droppedSpans(),
      droppedLogs: recorder.signals.droppedLogs(),
      droppedMetrics: 0,
    }
  }

  // Appends one request to the file with one write, so that the lines of the processes that
  // share the file never mix.
  effect fn writeLine(state: &mut Sink) -> () ! OutOfMemoryError ? &mut Allocator {
    if Bytes.length(&state.line) == usize.ZERO || state.broken {
      return ()
    }
    run Bytes.append(&mut state.line, b"\n")
    let mut error = 0
    if !run NativeDescriptor.writeAll(state.descriptor, Bytes.asSlice(&state.line), &mut error) {
      state.broken = true
    }
  }

  // Writes `values` as lines of at most `batch` spans.
  effect fn writeSpanSlice(state: &mut Sink, values: &[Span]) -> () ! OutOfMemoryError ? &mut Allocator {
    let resource = identity(state.recorder.get())
    let mut start = usize.ZERO
    while start < values.length {
      let mut count = values.length - start
      if count > batch {
        count = batch
      }
      run encoded(
        run Effect.result(encodeInto(&resource, &Batch.Spans { values: Slice.view<Span>(values, start, count) },
          &mut state.line)),
        &mut state.line,
      )
      run writeLine(&mut state.*)
      start = start + count
    }
  }

  effect fn writeSpans(state: &mut Sink) -> () ! OutOfMemoryError ? &mut Allocator {
    if List<Span>.length(&state.spans) == usize.ZERO {
      return ()
    }
    let spans = Intrinsic.replace(state.spans, List<Span>.make())
    run writeSpanSlice(&mut state.*, List<Span>.asSlice(&spans))
    state.spans = move spans
    List<Span>.clear(&mut state.spans)
  }

  effect fn writeLogs(state: &mut Sink) -> () ! OutOfMemoryError ? &mut Allocator {
    if List<LogRecord>.length(&state.logs) == usize.ZERO {
      return ()
    }
    let resource = identity(state.recorder.get())
    run encoded(
      run Effect.result(encodeInto(&resource, &Batch.Logs { values: List<LogRecord>.asSlice(&state.logs) },
        &mut state.line)),
      &mut state.line,
    )
    List<LogRecord>.clear(&mut state.logs)
    return run writeLine(&mut state.*)
  }

  // Takes what the recorder has finished and writes what the file keeps of it.
  effect fn drain(state: &mut Sink) -> () ! OutOfMemoryError ? &mut Allocator {
    let recorder = state.recorder.clone()
    if List<Span>.capacity(&state.spans) == usize.ZERO {
      run List<Span>.reserveExact(&mut state.spans, batch)
      run List<LogRecord>.reserveExact(&mut state.logs, batch)
    }
    List<bool>.clear(&mut state.kept)
    // `taken` keeps its records from drain to drain, so a span is copied into one in place, and
    // only what it holds.
    let mut count = usize.ZERO
    let mut remaining = recorder.get().finishedCapacity()
    while remaining != usize.ZERO {
      if count == List<Span>.length(&state.taken) {
        run List<Span>.append(&mut state.taken, Span.empty())
      }
      let slot = &mut List<Span>.asMutSlice(&mut state.taken)[count]
      if recorder.get().takeSpanInto(&mut slot.*) {
        remaining = remaining - usize.ONE
        if state.abandoned == 0 || slot.context.span != state.abandoned {
          count = count + usize.ONE
        }
      } else {
        remaining = usize.ZERO
      }
    }
    // A span closes after everything below it, so what a drain takes holds no span whose
    // children an earlier drain did not. Within one drain the order is the recorder's pages',
    // so the parents are settled over the whole of it.
    let filtering = state.queries && state.minimum != 0
    let mut at = usize.ZERO
    while filtering && at < count {
      let span = &List<Span>.asSlice(&state.taken)[at]
      let kept = keeps(span, state.minimum)
      let parent = span.parent.span
      run List<bool>.append(&mut state.kept, kept)
      if kept && filtering {
        run want(&mut state.*, parent)
      }
      at = at + usize.ONE
    }
    let mut settling = filtering
    while settling {
      settling = false
      at = usize.ZERO
      while at < count {
        if !List<bool>.get(&state.kept, at) {
          let span = &List<Span>.asSlice(&state.taken)[at]
          let parent = span.parent.span
          if wants(List<u64>.asSlice(&state.wanted), span.context.span) {
            List<bool>.set(&mut state.kept, at, true)
            run want(&mut state.*, parent)
            settling = true
          }
        }
        at = at + usize.ONE
      }
    }
    // The kept spans move to the front of what was taken, in order, and are written from there.
    let mut held = usize.ZERO
    if filtering {
      at = usize.ZERO
      while at < count {
        if List<bool>.get(&state.kept, at) {
          if held != at {
            let taken = List<Span>.asMutSlice(&mut state.taken)
            taken[held] = taken[at]
          }
          held = held + usize.ONE
        }
        at = at + usize.ONE
      }
    } else {
      held = count
    }
    let taken = Intrinsic.replace(state.taken, List<Span>.make())
    run writeSpanSlice(&mut state.*, Slice.view<Span>(List<Span>.asSlice(&taken), usize.ZERO, held))
    state.taken = move taken
    remaining = recorder.get().signals.logCapacity()
    while remaining != usize.ZERO {
      match recorder.get().signals.takeLog() {
        Option<LogRecord>.Some { value } => {
          remaining = remaining - usize.ONE
          drop List<LogRecord>.appendWithinCapacity(&mut state.logs, value)
          if List<LogRecord>.length(&state.logs) == batch {
            run writeLogs(&mut state.*)
          }
        }
        Option<LogRecord>.None => {
          remaining = usize.ZERO
        }
      }
    }
    return run writeLogs(&mut state.*)
  }

  // The writing thread: writes what the recorder has finished every `writeNanos`, until it is
  // woken, and hands back what writes the file.
  effect fn writingLoop(sink: Sink, parker: Parker) -> Sink {
    let mut allocator = Allocator.systemAllocatorProvider()
    let mut held = move sink
    while !parker.parkTimeout(writeNanos) {
      drop run Effect.result(drain(&mut held) |> Effect.provideMut<Allocator>(&mut allocator))
    }
    return move held
  }

  // Starts the writing thread with what writes the file. When no thread can start, the compiling
  // thread writes the file itself from then on.
  effect fn start(state: &mut State) -> () ! OutOfMemoryError ? &mut Allocator {
    let sink = match move Intrinsic.replace(state.sink, Option<Sink>.none()) {
      Option<Sink>.Some { value } => move value
      Option<Sink>.None => {
        return ()
      }
    }
    let parker = run Parker.make()
    let wake = parker.unparker()
    let started = run Effect.result(NativeThread.spawn(|| -> Sink {
      return run writingLoop(move sink, move parker)
    }))
    match move started {
      Result<JoinHandle<Sink>, OutOfMemoryError | SpawnError>.Success { value } => {
        state.writing = Option<Writing>.some(Writing { thread: move value, wake: move wake })
      }
      Result<JoinHandle<Sink>, OutOfMemoryError | SpawnError>.Failure { error } => {
        drop error
        // What the thread was to hold held nothing yet unwritten but its buffers.
        state.threadless = true
        state.sink = Option<Sink>.some(fresh(&state.recorder, state.descriptor, state.queries, state.minimum))
      }
    }
  }

  // Stops the writing thread, if one runs, and takes back what writes the file.
  fn stop(state: &mut State) -> () {
    if let Option<Writing>.Some { value } = move Intrinsic.replace(state.writing, Option<Writing>.none()) {
      let writing = move value
      writing.wake.unpark()
      state.sink = Option<Sink>.some(writing.thread.join())
    }
  }

  // Stops the writing thread and writes everything the recorder has finished.
  effect fn settled(state: &mut State) -> () ! OutOfMemoryError ? &mut Allocator {
    stop(&mut state.*)
    if let Option<Sink>.Some { value } = &mut state.sink {
      run drain(&mut value)
    }
  }

  /// Counts one piece of finished work, and writes what the recorder has finished once enough of
  /// them have passed: on a thread of its own, started then, or on this one when none can start.
  /// Call it on the compiling thread, after a span closes: often enough that the recorder never
  /// fills, which costs it spans.
  pub effect fn pump() -> () ? &mut Allocator {
    let mut anchor = ()
    if let Option<*mut State>.Some { value } = Pointer.nonNullMut<State>(unsafe Pointer.read(slot())) {
      let state = unsafe Pointer.borrowMut(&mut anchor, value)
      state.calls = state.calls + 1
      if state.calls >= pumped {
        state.calls = 0
        if state.threadless {
          if let Option<Sink>.Some { value: sink } = &mut state.sink {
            drop run Effect.result(drain(&mut sink))
          }
        } else {
          drop run Effect.result(start(&mut state.*))
        }
      }
    }
  }

  /// Stops the thread that writes the file and writes everything the recorder has finished:
  /// after the work of other threads has been collected, and before this process copies itself
  /// with `fork`, so that the copy has no other thread and holds nothing unwritten. The next
  /// [`pump`] starts the thread again.
  pub effect fn flush() -> () ? &mut Allocator {
    let mut anchor = ()
    if let Option<*mut State>.Some { value } = Pointer.nonNullMut<State>(unsafe Pointer.read(slot())) {
      drop run Effect.result(settled(unsafe Pointer.borrowMut(&mut anchor, value)))
    }
  }

  /// Writes everything finished, and the process's span as ending now: for a process about to be
  /// replaced by the program it built, which never returns to close that span.
  pub effect fn abandon() -> () ? &mut Allocator {
    let mut anchor = ()
    if let Option<*mut State>.Some { value } = Pointer.nonNullMut<State>(unsafe Pointer.read(slot())) {
      let state = unsafe Pointer.borrowMut(&mut anchor, value)
      drop run Effect.result(settled(&mut state.*))
      if state.rooted && !state.abandoned {
        state.abandoned = true
        let mut root = state.root
        root.end = state.recorder.get().now()
        if let Option<Sink>.Some { value: sink } = &mut state.sink {
          sink.abandoned = root.context.span
          if List<Span>.appendWithinCapacity(&mut sink.spans, root) {
            drop run Effect.result(writeSpans(&mut sink))
          }
        }
      }
    }
  }

  /// Writes what is left and ends the tracing of this process. Reports the spans the recorder
  /// had no room for, since a trace that lacks spans misleads.
  pub effect fn close(session: &mut Session) -> () ? &mut Allocator {
    run flush()
    unsafe Pointer.write(slot(), Pointer.null<State>())
    let dropped = session.recorder.get().droppedSpans()
    if dropped != 0 {
      StderrWriter.print("silk: the trace lacks {} spans the recorder had no room for\n", &.(dropped))
    }
    let broken = match &session.state.sink {
      Option<Sink>.Some { value } => value.broken
      Option<Sink>.None => false
    }
    if broken {
      StderrWriter.print("silk: could not write all of the trace file\n", &())
    }
    drop run Effect.result(NativeFile.close(session.state.descriptor))
  }

  /// Records the largest resident memory of the process so far on the current span.
  pub effect fn memory() -> () {
    if on() {
      let peak = run ProcessMemory.peakBytes()
      Trace.set("memory.peak_bytes", &peak)
    }
  }

  fn settle(state: &mut State, current: u64) -> () {
    let spent = current - state.since
    if state.active != usize.MAX {
      let families = List<QueryTime>.asMutSlice(&mut state.families)
      families[state.active].own = families[state.active].own + spent
    }
    if state.activeModule != usize.MAX {
      let modules = List<QueryTime>.asMutSlice(&mut state.modules)
      modules[state.activeModule].own = modules[state.activeModule].own + spent
    }
    state.since = current
  }

  /// Starts one run of the query family numbered `family`, called `name`, about a declaration of the
  /// module numbered `module` (`usize.MAX` for none). The run that was open stops counting its
  /// own time until [`leaveQuery`]. Does nothing when the process is not traced.
  pub effect fn enterQuery(family: usize, name: string<'static>, module: usize) -> QueryMark
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut anchor = ()
    let state = match Pointer.nonNullMut<State>(unsafe Pointer.read(slot())) {
      Option<*mut State>.Some { value } => unsafe Pointer.borrowMut(&mut anchor, value)
      Option<*mut State>.None => {
        return QueryMark { slot: usize.MAX, module: usize.MAX, outerSlot: usize.MAX, outerModule: usize.MAX, started: 0 }
      }
    }
    let empty = QueryTime { name: "", runs: 0, hits: 0, verified: 0, own: 0, total: 0 }
    while List<QueryTime>.length(&state.families) <= family {
      run List<QueryTime>.append(&mut state.families, empty)
    }
    while module != usize.MAX && List<QueryTime>.length(&state.modules) <= module {
      run List<QueryTime>.append(&mut state.modules, empty)
    }
    let current = now()
    settle(&mut state.*, current)
    let families = List<QueryTime>.asMutSlice(&mut state.families)
    families[family].name = name
    families[family].runs = families[family].runs + 1
    if module != usize.MAX {
      let modules = List<QueryTime>.asMutSlice(&mut state.modules)
      modules[module].runs = modules[module].runs + 1
    }
    let mark = QueryMark {
      slot: family,
      module: module,
      outerSlot: state.active,
      outerModule: state.activeModule,
      started: current,
    }
    state.active = family
    state.activeModule = module
    return mark
  }

  /// Counts a demand of the query family numbered `family`, called `name`, that its memo answered
  /// without a run; `verified` when the answer had been marked outdated and was verified current.
  /// Does nothing when the process is not traced.
  pub effect fn countHit(family: usize, name: string<'static>, verified: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut anchor = ()
    let state = match Pointer.nonNullMut<State>(unsafe Pointer.read(slot())) {
      Option<*mut State>.Some { value } => unsafe Pointer.borrowMut(&mut anchor, value)
      Option<*mut State>.None => {
        return ()
      }
    }
    let empty = QueryTime { name: "", runs: 0, hits: 0, verified: 0, own: 0, total: 0 }
    while List<QueryTime>.length(&state.families) <= family {
      run List<QueryTime>.append(&mut state.families, empty)
    }
    let families = List<QueryTime>.asMutSlice(&mut state.families)
    families[family].name = name
    families[family].hits = families[family].hits + 1
    if verified {
      families[family].verified = families[family].verified + 1
    }
  }

  /// Ends the run `mark` opened, also one that failed. Calls nest as [`enterQuery`] did.
  pub fn leaveQuery(mark: QueryMark) -> () {
    if mark.slot == usize.MAX {
      return ()
    }
    let mut anchor = ()
    if let Option<*mut State>.Some { value } = Pointer.nonNullMut<State>(unsafe Pointer.read(slot())) {
      let state = unsafe Pointer.borrowMut(&mut anchor, value)
      let current = now()
      settle(&mut state.*, current)
      let families = List<QueryTime>.asMutSlice(&mut state.families)
      families[mark.slot].total = families[mark.slot].total + current - mark.started
      if mark.module != usize.MAX {
        let modules = List<QueryTime>.asMutSlice(&mut state.modules)
        modules[mark.module].total = modules[mark.module].total + current - mark.started
      }
      state.active = mark.outerSlot
      state.activeModule = mark.outerModule
    }
  }

  /// The query runs since the last [`takeQueryTimes`], by family: one entry per family that ran.
  /// Then by module, at the module's number. Both start again from nothing.
  pub effect fn takeQueryTimes(families: &mut List<QueryTime>, modules: &mut List<QueryTime>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut anchor = ()
    if let Option<*mut State>.Some { value } = Pointer.nonNullMut<State>(unsafe Pointer.read(slot())) {
      let state = unsafe Pointer.borrowMut(&mut anchor, value)
      let ran = List<QueryTime>.asSlice(&state.families)
      let mut at = usize.ZERO
      while at < ran.length {
        if ran[at].runs != 0 || ran[at].hits != 0 {
          run List<QueryTime>.append(&mut families.*, ran[at])
        }
        at = at + usize.ONE
      }
      run List<QueryTime>.appendSlice(&mut modules.*, List<QueryTime>.asSlice(&state.modules))
      List<QueryTime>.clear(&mut state.families)
      List<QueryTime>.clear(&mut state.modules)
    }
  }
} else {
  import silk.io.writer_native { StderrWriter }
  import silk.trace { SpanGuard, SpanKind, Trace }

  /// A traced process's recorder and state. This compiler traces nothing.
  pub struct Session {}

  /// Whether this process is traced. Never, in this compiler.
  pub fn on() -> bool {
    return false
  }

  /// Whether each query run and each borrow check has a span of its own. Never, in this compiler.
  pub fn queries() -> bool {
    return false
  }

  /// A reading of the clock for [`lasted`]. Zero, in this compiler.
  pub fn clock() -> u64 {
    return 0
  }

  /// Whether a query run or borrow check has run long enough to keep. Never, in this compiler.
  pub fn lasted(began: u64) -> bool {
    return false
  }

  /// A span for one query run or borrow check. None, in this compiler.
  @inlineAlways
  pub fn detail(static name: string<'static>) -> Option<SpanGuard> {
    return Option<SpanGuard>.none()
  }

  /// The session of a process asked to trace itself. None, in this compiler, which standard
  /// error says.
  pub effect fn open(options: &Options) -> Option<Session> ! OutOfMemoryError ? &mut Allocator {
    StderrWriter.print("silk: this compiler cannot write a trace on this host\n", &())
    return Option<Session>.none()
  }

  /// Makes `session` the one this process records into. Nothing, in this compiler.
  pub fn install(session: &mut Session) -> () {
    return ()
  }

  /// A session for a copy of the process. None, in this compiler.
  pub effect fn copied(small: bool) -> Option<Session> ! OutOfMemoryError ? &mut Allocator {
    return Option<Session>.none()
  }

  /// Ends the tracing of a copy of the process. Nothing, in this compiler.
  pub fn silence() -> () {
    return ()
  }

  /// Runs `work`. This compiler records none of it.
  pub effect fn within<'env, A, E, ?R>(session: &Option<Session>, work: once Effect<'env; A ! E ? R>) -> A
    ! E
    ? R {
    return run move work
  }

  /// Opens the span of the whole process. An empty one, in this compiler.
  pub effect fn root() -> SpanGuard ? &mut HostInput | &mut Allocator {
    return Trace.spanOf("silkc", SpanKind.Server)
  }

  /// The `traceparent` for a compiler this process starts. None, in this compiler.
  pub effect fn parent() -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
    return Option<Bytes>.none()
  }

  /// Counts one piece of finished work. Nothing, in this compiler.
  pub effect fn pump() -> () ? &mut Allocator {
    return ()
  }

  /// Writes everything the recorder has finished. Nothing, in this compiler.
  pub effect fn flush() -> () ? &mut Allocator {
    return ()
  }

  /// Writes everything finished and the process's span. Nothing, in this compiler.
  pub effect fn abandon() -> () ? &mut Allocator {
    return ()
  }

  /// Ends the tracing of this process. Nothing, in this compiler.
  pub effect fn close(session: &mut Session) -> () ? &mut Allocator {
    return ()
  }

  /// Records the process's peak memory on the current span. Nothing, in this compiler.
  pub effect fn memory() -> () {
    return ()
  }

  /// Starts one run of a query family. Nothing, in this compiler.
  pub effect fn enterQuery(family: usize, name: string<'static>, module: usize) -> QueryMark
    ! OutOfMemoryError
    ? &mut Allocator {
    return QueryMark { slot: usize.MAX, module: usize.MAX, outerSlot: usize.MAX, outerModule: usize.MAX, started: 0 }
  }

  /// Counts a demand its memo answered. Nothing, in this compiler.
  pub effect fn countHit(family: usize, name: string<'static>, verified: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    return ()
  }

  /// Ends the run `mark` opened. Nothing, in this compiler.
  pub fn leaveQuery(mark: QueryMark) -> () {
    return ()
  }

  /// The query runs since the last call, by family and by module. None, in this compiler.
  pub effect fn takeQueryTimes(families: &mut List<QueryTime>, modules: &mut List<QueryTime>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return ()
  }
}
