/// A command-line contract failure before source reading begins.
pub union ApplicationError {
  InvalidArgumentCount { pub actual: usize },
  InvalidBuildProfile,
  InvalidPath { pub argument: Bytes },
  /// A `--stdlib` directory that is missing or holds no standard library (no `compositions.json`).
  NotStandardLibrary { pub directory: Bytes, pub missing: bool },
  /// A project command line that does not parse, with the message that names why and the
  /// command's usage.
  InvalidCommand { pub message: Bytes },
  /// A package whose root module does not exist: its name, the module's path as the package
  /// spells it, such as `src/main.silk`, and whether the package has a tasks program instead.
  MissingRootModule { pub package: Bytes, pub path: Bytes, pub tasks: bool },
}

effect fn invalidArgumentCount(actual: usize) -> never
  ! ApplicationError {
  fail ApplicationError.InvalidArgumentCount { actual: actual }
}

// Refuses a `command` line that does not parse: `silk <command>: <reason>`, then where to find
// the command's options.
effect fn invalidCommand(command: &[u8], invalid: InvalidProjectCommand) -> never
  ! ApplicationError | OutOfMemoryError
  ? &mut Allocator {
  let mut message = run Bytes.copy(b"silk ")
  run Bytes.append(&mut message, command)
  run Bytes.append(&mut message, b": ")
  run Bytes.append(&mut message, Bytes.asSlice(&invalid.reason))
  run Bytes.append(&mut message, b"\nRun `silk help ")
  run Bytes.append(&mut message, command)
  run Bytes.append(&mut message, b"` for its options.\n")
  fail ApplicationError.InvalidCommand { message: move message }
}

// Refuses to build `project` from the root module `entry` when that file does not exist, rather
// than failing on its read, and says whether the package's tasks are what it holds instead.
effect fn requireRootModule(project: &Project, entry: &Path) -> ()
  ! ApplicationError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if run FileSystem.exists(entry) {
    return ()
  }
  let tasks = run Path.join(Projects.sourceRoot(project), "tasks.silk")
  let spelled = Path.rawBytes(entry)
  let directory = Path.rawBytes(Projects.directory(project))
  let mut shown = spelled
  if spelled.length > directory.length + usize.ONE
    && same(Slice.view<u8>(spelled, usize.ZERO, directory.length), directory)
    && (spelled[directory.length] == 47 || spelled[directory.length] == 92) {
    shown = Slice.view<u8>(
      spelled,
      directory.length + usize.ONE,
      spelled.length - directory.length - usize.ONE,
    )
  }
  fail ApplicationError.MissingRootModule {
    package: run Bytes.copy(Projects.name(project)),
    path: run Bytes.copy(shown),
    tasks: run FileSystem.exists(&tasks),
  }
}

/// One parsed command line: the source file to read and the requested artifact or dump. A test
/// request builds the bundled runner for its discovery root and runs the selected tests.
enum SchemaKind {
  Request,
  Manifest
}

union Request {
  Compile { file: Bytes, ignoreWarnings: bool, progress: bool },
  Graph { command: ProjectCommands.Graph },
  Resolve { command: ProjectCommands.Resolve },
  Fetch { command: ProjectCommands.Fetch },
  PackagePath { command: ProjectCommands.PackagePath },
  Schema { kind: SchemaKind },
  /// `silk dump tokens|syntax|hir <source>`: one front-end stage of one source file.
  Dump { stage: Dumped, source: Bytes },
  /// A single-source build, or with `mir` other than `Off`, `silk dump mir <source>`, which checks
  /// and lowers the build and lists its MIR instead of writing an artifact.
  Build {
    source: Bytes,
    output: Bytes,
    stage: Option<Stage>,
    standardLibrary: Option<Bytes>,
    input: ProfileInput,
    stats: bool,
    clang: Option<Bytes>,
    mir: MirListing,
    ignoreWarnings: bool
  },
  Test {
    source: Bytes,
    output: Bytes,
    standardLibrary: Option<Bytes>,
    profile: InitialProfile,
    filter: Option<Bytes>,
    file: Option<Bytes>,
    timeout: Option<Bytes>,
    noCache: bool,
    ignoreWarnings: bool
  },
  Run { command: RunCommand },
  Task { command: TaskCommand },
  Plan { command: ProjectCommands.Plan },
  Init { command: InitCommand },
  Add { command: AddCommand },
  Remove { command: RemoveCommand },
  Clean { command: CleanCommand },
  /// `sandbox-exec`, which a build tool step starts (driver/ToolSandbox); never typed by hand.
  Sandbox { arguments: List<Bytes> },
  ProjectBuild { command: BuildCommand },
  ProjectTest { command: TestCommand },
  Check { command: CheckCommand },
  Hash { command: HashCommand },
  Pack { command: PackCommand },
  Help,
  Version,
}

/// The front-end stage `silk dump` writes for one source file.
enum Dumped {
  /// Every token the lexer produces, trivia included, with its byte span and text.
  Tokens,
  /// The parsed syntax tree, indented by nesting, with each token's text.
  Syntax,
  /// The lowered HIR module of the file.
  Hir,
}

/// Which lowered functions a build lists instead of writing its artifact.
enum MirListing {
  /// None: the build writes its artifact.
  Off,
  /// The reached functions declared in the built package.
  Root,
  /// Every reached function, the standard library's included.
  All,
}

// Keeps in `directory` the files `store` parsed, which the next load parses ahead. A store that
// read no image of its own (`file.own`) parsed the files its next load reuses, so it keeps none.
effect fn saveParsed(
  directory: &Path,
  file: &CacheFile,
  sources: &ModuleSources,
  store: &Semantic,
) -> ()
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut digests = List<ContentHash>.make()
  if file.own {
    digests = run ModuleSourceFiles.parsedDigests(sources, Semantic.sourceEvents(store))
  }
  return run SemanticCache.saveParsed(directory, List<ContentHash>.asSlice(&digests))
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn argumentAt(index: usize, count: usize) -> Bytes
  ! ApplicationError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let found = run HostInput.argument(index)
  return match move found {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => run invalidArgumentCount(count)
  }
}

fn hasFilter(value: &Option<Bytes>) -> bool {
  return match &value.* {
    Option<Bytes>.Some { .. } => true
    Option<Bytes>.None => false
  }
}

// One line per counter group, in a fixed form a script can parse: `silk-stats <group>` then
// space-separated `name=value` pairs.
effect fn writeStatistics(counted: &Statistics) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Allocator {
  let mut text = run Bytes.copy(b"silk-stats demand demands=")
  run JsonText.appendDecimal(&mut text, counted.demands)
  run Bytes.append(&mut text, b" hits=")
  run JsonText.appendDecimal(&mut text, counted.hits)
  run Bytes.append(&mut text, b" units-run=")
  run JsonText.appendDecimal(&mut text, counted.runs)
  run Bytes.append(&mut text, b"\n")
  if let Option<GraphCounters>.Some { value: graph } = &counted.graph {
    run Bytes.append(&mut text, b"silk-stats graph units=")
    run JsonText.appendDecimal(&mut text, graph.units)
    run Bytes.append(&mut text, b" dependees=")
    run JsonText.appendDecimal(&mut text, graph.dependees)
    run Bytes.append(&mut text, b" edges=")
    run JsonText.appendDecimal(&mut text, graph.edges)
    run Bytes.append(&mut text, b" free-edges=")
    run JsonText.appendDecimal(&mut text, graph.freeEdges)
    run Bytes.append(&mut text, b" edges-recorded=")
    run JsonText.appendDecimal(&mut text, graph.edgesRecorded)
    run Bytes.append(&mut text, b" edges-deduplicated=")
    run JsonText.appendDecimal(&mut text, graph.edgesDeduplicated)
    run Bytes.append(&mut text, b" marked-outdated=")
    run JsonText.appendDecimal(&mut text, graph.markedOutdated)
    run Bytes.append(&mut text, b" fingerprinted=")
    run JsonText.appendDecimal(&mut text, graph.fingerprinted)
    run Bytes.append(&mut text, b" unchanged=")
    run JsonText.appendDecimal(&mut text, graph.unchanged)
    run Bytes.append(&mut text, b" verified=")
    run JsonText.appendDecimal(&mut text, graph.verified)
    run Bytes.append(&mut text, b" bytes=")
    run JsonText.appendDecimal(&mut text, graph.bytes)
    run Bytes.append(&mut text, b"\n")
  }
  return run writeError(Bytes.asSlice(&text))
}

// Coverage evidence for --stats: every structurally deferred body, with its full authored owner
// address. This reports no success verdict for a template awaiting selected static inputs.
effect fn writeDeferredTemplates(deferred: &[DeferredStaticTemplate]) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Allocator {
  let mut at = usize.ZERO
  while at < deferred.length {
    let declaration = &deferred[at].declaration
    let mut line = run Bytes.copy(b"silk-stats deferred-static ")
    let module = DeclarationId.moduleId(declaration)
    let path = run ModuleId.copyPath(module)
    run Bytes.append(&mut line, Bytes.asSlice(&path))
    let mut owner = usize.ZERO
    while owner < DeclarationId.ownerCount(declaration) {
      run Bytes.append(&mut line, b"::")
      if DeclarationId.ownerNamed(declaration, owner) {
        let name = run DeclarationId.copyOwnerName(declaration, owner)
        run Bytes.append(&mut line, Bytes.asSlice(&name))
      } else {
        run JsonText.appendDecimal(&mut line, DeclarationId.ownerOccurrence(declaration, owner))
      }
      owner = owner + usize.ONE
    }
    run Bytes.append(&mut line, b"\n")
    run writeError(Bytes.asSlice(&line))
    at = at + usize.ONE
  }
  return ()
}

// Whether `host` links an executable for `target` with `request`: its own target, freestanding
// wasm32, which needs only Clang and its WebAssembly linker, Windows, which carries its own
// import libraries, Linux, which carries its own glibc stubs (the link refuses what they cannot
// serve), macOS by default, which links against Silk's own libSystem stub when no SDK is found,
// or a macOS target whose platform supply resolves: an explicit one, `SDKROOT`, or the SDK a Mac
// discovers for either macOS architecture.
effect fn linksOn(target: &Target, host: &Target, request: &SupplyRequest) -> bool
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  if Target.id(target) == Target.id(host) || same(Target.objectFormat(target), b"wasm")
    || Target.id(target) == TargetId.X8664PcWindowsMsvc
    || same(Target.operatingSystem(target), b"linux") {
    return true
  }

  // Resolution later checks that an explicit supply names this target.
  if let SupplyRequest.Explicit { .. } = &request.* {
    return true
  }
  if !same(Target.operatingSystem(target), b"darwin") {
    return false
  }
  if let SupplyRequest.Automatic = &request.* {
    return true
  }
  if same(Target.operatingSystem(host), b"darwin") {
    return true
  }
  if let Option<Bytes>.Some { value } = move run HostInput.variableNamed("SDKROOT") {
    drop value
    return true
  }
  return false
}

// Says why `host` cannot link an executable for `target` and how to supply its platform.
effect fn refuseCrossLink(target: &Target, host: &Target) -> ()
  ! WriterError {
  run writeError(b"Cannot link an executable for target ")
  run writeError(Target.name(target))
  run writeError(b" on host ")
  run writeError(Target.name(host))
  run writeError(
    b": the link needs a platform supply.\nDeclare Compilation.platform with target = \"",
  )
  run writeError(Target.name(target))
  run writeError(b"\", root = \"<sysroot or SDK>\", linker = \"<ld.lld or ld64.lld>\" }")
  if same(Target.operatingSystem(target), b"darwin") {
    run writeError(b", or set SDKROOT to a macOS SDK")
  }
  run writeError(b"\n")
}

effect fn invalidBuildProfile() -> never
  ! ApplicationError {
  fail ApplicationError.InvalidBuildProfile
}

// The arguments after the command name.
effect fn commandArguments(count: usize) -> List<Bytes>
  ! ApplicationError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let mut arguments = List<Bytes>.make()
  let mut at = usize.add(0, 2)
  while at < count {
    run List<Bytes>.append(&mut arguments, run argumentAt(at, count))
    at = at + usize.ONE
  }
  return move arguments
}

// Runs `sandbox-exec --read <path>... --write <path>... -- <program> <argument>...`: restricts this
// process and runs the program in its place. Answers the status of a failure to.
effect fn sandboxed(arguments: &[Bytes]) -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut readable = List<Bytes>.make()
  let mut writable = List<Bytes>.make()
  let mut command = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    if same(argument, b"--") {
      at = at + usize.ONE
      while at < arguments.length {
        run List<Bytes>.append(&mut command, run terminatedBytes(Bytes.asSlice(&arguments[at])))
        at = at + usize.ONE
      }
      break
    }
    if at + usize.ONE >= arguments.length {
      return 2
    }
    let value = run terminatedBytes(Bytes.asSlice(&arguments[at + usize.ONE]))
    if same(argument, b"--read") {
      run List<Bytes>.append(&mut readable, move value)
    } else if same(argument, b"--write") {
      run List<Bytes>.append(&mut writable, move value)
    } else {
      return 2
    }
    at = at + usize.add(0, 2)
  }
  if List<Bytes>.length(&command) == usize.ZERO {
    return 2
  }
  let program = run Bytes.copy(Bytes.asSlice(&List<Bytes>.asSlice(&command)[usize.ZERO]))
  return run ToolSandbox.enter(
    List<Bytes>.asSlice(&readable),
    List<Bytes>.asSlice(&writable),
    &program,
    List<Bytes>.asSlice(&command),
  )
}

// `text` followed by a NUL byte.
effect fn terminatedBytes(text: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = run Bytes.copy(text)
  run Bytes.append(&mut result, b"\0")
  return move result
}

// Reads the arguments after `init`; a malformed command line reports the usage.
effect fn initRequest(count: usize) -> InitCommand
  ! ApplicationError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let arguments = run commandArguments(count)
  let parsed = run Effect.result(ProjectCommands.parseInit(List<Bytes>.asSlice(&arguments)))
  return match move parsed {
    Result<InitCommand, InvalidProjectCommand | OutOfMemoryError>.Success { value } => move value
    Result<InitCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {
      error
    } => match move error {
      InvalidProjectCommand invalid => run invalidCommand(b"init", move invalid)
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// How this command holds packages to their `silk-version`: relaxed under `--ignore-silk-version`
// (`ignored`), or when a parent command passed it on, which `relaxVersions` records in the
// environment of the processes it starts.
effect fn versionPolicy(ignored: bool) -> Versions
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  if ignored || run environmentSwitch(b"SILK_IGNORE_SILK_VERSION") {
    return Versions.Relaxed
  }
  return Versions.Checked
}

// With `--ignore-silk-version`, marks this process and the ones it starts, such as a tasks
// program's compilations, to build packages whose `silk-version` this Silk cannot build.
effect fn relaxVersions(options: &ProjectOptions) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if options.ignoreSilkVersion {
    let _marked = run ProcessImage.setVariable(b"SILK_IGNORE_SILK_VERSION", b"1")
  }
}

// Reads the arguments after `run`; a malformed command line reports the usage.
effect fn runRequest(count: usize) -> RunCommand
  ! ApplicationError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let arguments = run commandArguments(count)
  let parsed = run Effect.result(ProjectCommands.parseRun(List<Bytes>.asSlice(&arguments)))
  return match move parsed {
    Result<RunCommand, InvalidProjectCommand | OutOfMemoryError>.Success { value } => {
      run relaxVersions(&value.options)
      return move value
    }
    Result<RunCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {
      error
    } => match move error {
      InvalidProjectCommand invalid => run invalidCommand(b"run", move invalid)
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// Reads the arguments after `task`; a malformed command line reports the usage.
effect fn taskRequest(count: usize) -> TaskCommand
  ! ApplicationError | HostInputError | OutOfMemoryError
