/// A command-line contract failure before source reading begins.
pub union ApplicationError {
  InvalidArgumentCount {pub actual: usize},
  InvalidWorkingDirectoryEncoding,
  InvalidBuildProfile,
  InvalidPath {pub argument: Bytes},
  /// A `--stdlib` directory that is missing or holds no standard library (no `compositions.json`).
  NotStandardLibrary {pub directory: Bytes, pub missing: bool},
  /// A project command line that does not parse, with the message that names why and the
  /// command's usage.
  InvalidCommand {pub message: Bytes},
}

effect fn invalidArgumentCount(actual: usize) -> never ! ApplicationError {
  fail ApplicationError.InvalidArgumentCount {actual: actual}
}

// Refuses a `command` line that does not parse: `silk <command>: <reason>`, then the command's
// usage lines.
effect fn invalidCommand(command: &[u8], invalid: InvalidProjectCommand) -> never ! ApplicationError | OutOfMemoryError ? &mut Allocator {
  let mut message = run Bytes.copy(b"silk ")
  run Bytes.append(&mut message, command)
  run Bytes.append(&mut message, b": ")
  run Bytes.append(&mut message, Bytes.asSlice(&invalid.reason))
  run Bytes.append(&mut message, b"\n")
  let lines = run commandUsage(command)
  run Bytes.append(&mut message, Bytes.asSlice(&lines))
  fail ApplicationError.InvalidCommand {message: move message}
}

effect fn invalidWorkingDirectoryEncoding() -> never ! ApplicationError {
  fail ApplicationError.InvalidWorkingDirectoryEncoding
}

/// One parsed command line: the source file to read and the requested artifact or dump. A test
/// request builds the bundled runner for its discovery root and runs the selected tests.
union Request {
  Dump {source: Bytes, hir: bool},
  Build {source: Bytes, output: Bytes, stage: Option<Stage>, standardLibrary: Option<Bytes>, input: ProfileInput, stats: bool, clang: Option<Bytes>},
  Test {source: Bytes, output: Bytes, standardLibrary: Option<Bytes>, profile: InitialProfile, filter: Option<Bytes>, file: Option<Bytes>, timeout: Option<Bytes>, noCache: bool},
  Run {command: RunCommand},
  Init {command: InitCommand},
  Add {command: AddCommand},
  Remove {command: RemoveCommand},
  Clean {command: CleanCommand},
  ProjectBuild {command: BuildCommand},
  ProjectTest {command: TestCommand},
  Check {command: CheckCommand},
  Help,
  Version,
}

/// Reports whether `argument` spells the `hir` mode selector.
fn selectsHir(argument: &[u8]) -> bool {
  let wanted = String.utf8Bytes("hir")
  if argument.length != wanted.length {
    return false
  }
  let mut index = usize.ZERO
  while index < argument.length {
    if argument[index] != wanted[index] {
      return false
    }
    index = index + usize.ONE
  }
  return true
}

// Keeps in `directory` the files `store` parsed, which the next load parses ahead.
effect fn saveParsed(directory: &Path, sources: &ModuleSources, store: &Semantic) -> () ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let digests = run ModuleSourceFiles.parsedDigests(sources, Semantic.sourceEvents(store))
  return run SemanticCache.saveParsed(directory, List<ContentHash>.asSlice(&digests))
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn argumentAt(index: usize, count: usize) -> Bytes
! ApplicationError | HostInputError | OutOfMemoryError
? &mut HostInput | &mut Allocator {
  let found = run HostInput.argument(index)
  return match move found {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => run invalidArgumentCount(count)
  }
}

fn hasFilter(value: &Option<Bytes>) -> bool {
  return match &value.* {
    Option<Bytes>.Some {..} => true
    Option<Bytes>.None => false
  }
}

// One line per counter group, in a fixed form a script can parse: `silk-stats <group>` then
// space-separated `name=value` pairs.
effect fn writeStatistics(counted: &Statistics) -> () ! WriterError | OutOfMemoryError ? &mut Allocator {
  let mut text = run Bytes.copy(b"silk-stats demand demands=")
  run JsonText.appendDecimal(&mut text, counted.demands)
  run Bytes.append(&mut text, b" hits=")
  run JsonText.appendDecimal(&mut text, counted.hits)
  run Bytes.append(&mut text, b" units-run=")
  run JsonText.appendDecimal(&mut text, counted.runs)
  run Bytes.append(&mut text, b"\n")
  if let Option<GraphCounters>.Some {value: graph} = &counted.graph {
    run Bytes.append(&mut text, b"silk-stats graph units=")
    run JsonText.appendDecimal(&mut text, graph.units)
    run Bytes.append(&mut text, b" dependees=")
    run JsonText.appendDecimal(&mut text, graph.dependees)
    run Bytes.append(&mut text, b" edges=")
    run JsonText.appendDecimal(&mut text, graph.edges)
    run Bytes.append(&mut text, b" free-edges=")
    run JsonText.appendDecimal(&mut text, graph.freeEdges)
    run Bytes.append(&mut text, b" edges-recorded=")
    run JsonText.appendDecimal(&mut text, graph.edgesRecorded)
    run Bytes.append(&mut text, b" edges-deduplicated=")
    run JsonText.appendDecimal(&mut text, graph.edgesDeduplicated)
    run Bytes.append(&mut text, b" marked-outdated=")
    run JsonText.appendDecimal(&mut text, graph.markedOutdated)
    run Bytes.append(&mut text, b" fingerprinted=")
    run JsonText.appendDecimal(&mut text, graph.fingerprinted)
    run Bytes.append(&mut text, b" unchanged=")
    run JsonText.appendDecimal(&mut text, graph.unchanged)
    run Bytes.append(&mut text, b" verified=")
    run JsonText.appendDecimal(&mut text, graph.verified)
    run Bytes.append(&mut text, b" bytes=")
    run JsonText.appendDecimal(&mut text, graph.bytes)
    run Bytes.append(&mut text, b"\n")
  }
  return run writeError(Bytes.asSlice(&text))
}

// Coverage evidence for --stats: every structurally deferred body, with its full authored owner
// address. This reports no success verdict for a template awaiting selected static inputs.
effect fn writeDeferredTemplates(deferred: &[DeferredStaticTemplate]) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Allocator {
  let mut at = usize.ZERO
  while at < deferred.length {
    let declaration = &deferred[at].declaration
    let mut line = run Bytes.copy(b"silk-stats deferred-static ")
    let module = DeclarationId.moduleId(declaration)
    let path = run ModuleId.copyPath(module)
    run Bytes.append(&mut line, Bytes.asSlice(&path))
    let mut owner = usize.ZERO
    while owner < DeclarationId.ownerCount(declaration) {
      run Bytes.append(&mut line, b"::")
      if DeclarationId.ownerNamed(declaration, owner) {
        let name = run DeclarationId.copyOwnerName(declaration, owner)
        run Bytes.append(&mut line, Bytes.asSlice(&name))
      } else {
        run JsonText.appendDecimal(&mut line, DeclarationId.ownerOccurrence(declaration, owner))
      }
      owner = owner + usize.ONE
    }
    run Bytes.append(&mut line, b"\n")
    run writeError(Bytes.asSlice(&line))
    at = at + usize.ONE
  }
  return ()
}

// Whether `host` links an executable for `target`: its own target, or freestanding wasm32, which
// needs only Clang and its WebAssembly linker.
fn linksOn(target: &Target, host: &Target) -> bool {
  return Target.id(target) == Target.id(host) || same(Target.objectFormat(target), b"wasm")
}

effect fn invalidBuildProfile() -> never ! ApplicationError {
  fail ApplicationError.InvalidBuildProfile
}

// The arguments after the command name.
effect fn commandArguments(count: usize) -> List<Bytes>
! ApplicationError | HostInputError | OutOfMemoryError
? &mut HostInput | &mut Allocator {
  let mut arguments = List<Bytes>.make()
  let mut at = usize.add(0, 2)
  while at < count {
    run List<Bytes>.append(&mut arguments, run argumentAt(at, count))
    at = at + usize.ONE
  }
  return move arguments
}

// Reads the arguments after `init`; a malformed command line reports the usage.
effect fn initRequest(count: usize) -> InitCommand
! ApplicationError | HostInputError | OutOfMemoryError
? &mut HostInput | &mut Allocator {
  let arguments = run commandArguments(count)
  let parsed = run Effect.result(ProjectCommands.parseInit(List<Bytes>.asSlice(&arguments)))
  return match move parsed {
    Result<InitCommand, InvalidProjectCommand | OutOfMemoryError>.Success {value} => move value
    Result<InitCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {error} => match move error {
      InvalidProjectCommand invalid => run invalidCommand(b"init", move invalid)
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// Reads the arguments after `run`; a malformed command line reports the usage.
effect fn runRequest(count: usize) -> RunCommand
! ApplicationError | HostInputError | OutOfMemoryError
? &mut HostInput | &mut Allocator {
  let arguments = run commandArguments(count)
  let parsed = run Effect.result(ProjectCommands.parseRun(List<Bytes>.asSlice(&arguments)))
  return match move parsed {
    Result<RunCommand, InvalidProjectCommand | OutOfMemoryError>.Success {value} => move value
    Result<RunCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {error} => match move error {
      InvalidProjectCommand invalid => run invalidCommand(b"run", move invalid)
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// The overview that `silk help` and `--help` print, and that a malformed command line repeats:
// one line for each command, project commands first.
fn usage() -> &'static [u8] {
  return b"usage: silk <command> [options]\n\nProject commands:\n  init           Create a package or a workspace\n  build          Build the package or the workspace members\n  run            Build the package and run it\n  test           Run the package's tests\n  check          Report errors without building\n  format         Format Silk source files\n  clean          Remove the build directory\n  add            Add a path dependency\n  remove         Remove a dependency\n\nTools:\n  doc            Write the package's documentation as JSON\n  doctest        Check and run the examples in documentation comments\n  doc-reference  Write the standard library reference pages\n  lsp            Start the language server\n  help           Show this help, or the options of one command\n\nOptions:\n  -h, --help     Show this help\n  -v, --version  Show the Silk version\n\nRun `silk help <command>` to see the options of a command.\n"
}

// Every command's synopsis, one `silk <command> ...` line each, that `silk help <command>` and
// `silk <command> --help` select from. The single-file `build` and `test` forms come last, after
// the project forms a new user needs.
fn synopsis() -> &'static [u8] {
  return b"silk init [path] [--name <name>] [--lib | --workspace]\nsilk build [--manifest-path <path>] [--package <name>]... [--workspace] [--target <host|triple>]... [--release] [--optimization <profile>] [--profile <name>] [--profile-input <json>] [--stdlib <directory>] [--clang <path>] [--progress auto|live|plain|never] [--quiet] [--timings]\nsilk run [--manifest-path <path>] [--package <name>] [--target <host|triple>] [--release] [--optimization <profile>] [--profile <name>] [--profile-input <json>] [--stdlib <directory>] [--clang <path>] [--progress auto|live|plain|never] [--quiet] [arguments...] [-- arguments...]\nsilk test [--manifest-path <path>] [--package <name>]... [--workspace] [--target <host|triple>] [--release] [--optimization <profile>] [--profile <name>] [--profile-input <json>] [--stdlib <directory>] [--clang <path>] [--root <path>] [--file <path>] [--filter <text>] [--timeout <seconds>] [--no-cache]\nsilk check [--manifest-path <path>] [--package <name>]... [--workspace] [--target <host|triple>]... [--release] [--optimization <profile>] [--profile <name>] [--profile-input <json>] [--stdlib <directory>] [--progress auto|live|plain|never] [--quiet] [--timings] [--json] [--replay <script> [--differential]]\nsilk format [paths] [--check] [--manifest-path <path>]\nsilk clean [--manifest-path <path>]\nsilk add <path> [--name <name>] [--manifest-path <path>]\nsilk remove <name> [--manifest-path <path>]\nsilk doc [--manifest-path <path> | --stdlib] [--output <json>] [--include-private] [--target <triple>] [--stdlib-root <directory>]\nsilk doctest [--manifest-path <path>] [--target <triple>] [--stdlib-root <directory>]\nsilk doctest (--input <json> | --stdlib) [--source-root <directory>] [--target <triple>] [--stdlib-root <directory>]\nsilk doc-reference [--stdlib-root <directory>] --output <directory> [--check]\nsilk lsp [--stdlib <directory>]\nsilk help [command]\nsilk --help | --version\nsilk build <source> -o <output> [--emit final|llvm-ir|llvm-bitcode|assembly|object] [--target <triple>] [--clang <path>] [--stdlib <directory>] [--optimization none|speed] [--debug true|false] [--stats]\nsilk test <root> -o <executable> [--stdlib <directory>] [--filter <text>] [--file <path>] [--timeout <seconds>] [--optimization none|speed] [--debug true|false] [--no-cache]\n"
}

// The lines of the synopsis that start `silk <command> `, as `silk <command> --help` prints them:
// empty when the synopsis has none.
effect fn commandUsage(command: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let text = synopsis()
  let mut lines = Bytes.make()
  let mut start = usize.ZERO
  while start < text.length {
    let mut end = start
    while end < text.length && text[end] != 10 { end = end + usize.ONE }
    let mut at = start
    while at < end && text[at] == 32 { at = at + usize.ONE }
    let named = at + usize.add(0, 5) + command.length
    if named <= end && same(Slice.view<u8>(text, at, usize.add(0, 5)), b"silk ")
      && same(Slice.view<u8>(text, at + usize.add(0, 5), command.length), command)
      && (named == end || text[named] == 32) {
      if Bytes.length(&lines) == usize.ZERO {
        run Bytes.append(&mut lines, b"usage: ")
      } else {
        run Bytes.append(&mut lines, b"       ")
      }
      run Bytes.append(&mut lines, Slice.view<u8>(text, at, end - at))
      run Bytes.append(&mut lines, b"\n")
    }
    start = end + usize.ONE
  }
  return move lines
}

// Whether the command at argument 1 has no source operand, which makes it a project command: no
// further argument, or an option next, since a source file never begins with `-`.
effect fn projectForm(count: usize) -> bool ! ApplicationError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  if count == usize.add(0, 2) {
    return true
  }
  let first = run argumentAt(usize.add(0, 2), count)
  let text = Bytes.asSlice(&first)
  return text.length > usize.ZERO && text[usize.ZERO] == 45
}

/// Reads `build <source> -o <output> [--emit <stage>] [--target <triple>] [--clang <path>] [--stats]`,
/// `test <root> -o <output> [--filter <text>] [--file <path>] [--no-cache]`, and dump modes. A build's
/// form and stage come from its package manifest; `--emit` replaces the stage with one of the
/// `[build].stage` spellings.
effect fn request() -> Request
! ApplicationError | InitialProfileProblem | HostInputError | OutOfMemoryError
? &mut HostInput | &mut Allocator {
  let count = run HostInput.argumentCount()
  if count == usize.add(0, 2) {
    let only = run argumentAt(usize.ONE, count)
    let flag = Bytes.asSlice(&only)
    if same(flag, b"--help") || same(flag, b"-h") {
      return Request.Help
    }
    if same(flag, b"--version") || same(flag, b"-v") {
      return Request.Version
    }
  }
  if count >= usize.add(0, 2) {
    let command = run argumentAt(usize.ONE, count)
    if same(Bytes.asSlice(&command), b"run") {
      return Request.Run {command: run runRequest(count)}
    }
    if same(Bytes.asSlice(&command), b"init") {
      return Request.Init {command: run initRequest(count)}
    }
    if same(Bytes.asSlice(&command), b"add") {
      let arguments = run commandArguments(count)
      let parsed = run Effect.result(ProjectCommands.parseAdd(List<Bytes>.asSlice(&arguments)))
      return match move parsed {
        Result<AddCommand, InvalidProjectCommand | OutOfMemoryError>.Success {value} => Request.Add {command: move value}
        Result<AddCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {error} => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"add", move invalid)
          OutOfMemoryError exhausted => { fail move exhausted }
        }
      }
    }
    if same(Bytes.asSlice(&command), b"remove") {
      let arguments = run commandArguments(count)
      let parsed = run Effect.result(ProjectCommands.parseRemove(List<Bytes>.asSlice(&arguments)))
      return match move parsed {
        Result<RemoveCommand, InvalidProjectCommand | OutOfMemoryError>.Success {value} => Request.Remove {command: move value}
        Result<RemoveCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {error} => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"remove", move invalid)
          OutOfMemoryError exhausted => { fail move exhausted }
        }
      }
    }
    if same(Bytes.asSlice(&command), b"clean") {
      let arguments = run commandArguments(count)
      let parsed = run Effect.result(ProjectCommands.parseClean(List<Bytes>.asSlice(&arguments)))
      return match move parsed {
        Result<CleanCommand, InvalidProjectCommand | OutOfMemoryError>.Success {value} => Request.Clean {command: move value}
        Result<CleanCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {error} => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"clean", move invalid)
          OutOfMemoryError exhausted => { fail move exhausted }
        }
      }
    }
    if same(Bytes.asSlice(&command), b"check") {
      let arguments = run commandArguments(count)
      let parsed = run Effect.result(ProjectCommands.parseCheck(List<Bytes>.asSlice(&arguments)))
      return match move parsed {
        Result<CheckCommand, InvalidProjectCommand | OutOfMemoryError>.Success {value} => Request.Check {command: move value}
        Result<CheckCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {error} => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"check", move invalid)
          OutOfMemoryError exhausted => { fail move exhausted }
        }
      }
    }
    // `build` without a source file builds the project; a source file never begins with `-`.
    if same(Bytes.asSlice(&command), b"build") {
      if run projectForm(count) {
        let arguments = run commandArguments(count)
        let parsed = run Effect.result(ProjectCommands.parseBuild(List<Bytes>.asSlice(&arguments)))
        return match move parsed {
          Result<BuildCommand, InvalidProjectCommand | OutOfMemoryError>.Success {value} => Request.ProjectBuild {command: move value}
          Result<BuildCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {error} => match move error {
            InvalidProjectCommand invalid => run invalidCommand(b"build", move invalid)
            OutOfMemoryError exhausted => { fail move exhausted }
          }
        }
      }
    }
    // `test` without a discovery root tests the project.
    if same(Bytes.asSlice(&command), b"test") {
      if run projectForm(count) {
        let arguments = run commandArguments(count)
        let parsed = run Effect.result(ProjectCommands.parseTest(List<Bytes>.asSlice(&arguments)))
        return match move parsed {
          Result<TestCommand, InvalidProjectCommand | OutOfMemoryError>.Success {value} => Request.ProjectTest {command: move value}
          Result<TestCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {error} => match move error {
            InvalidProjectCommand invalid => run invalidCommand(b"test", move invalid)
            OutOfMemoryError exhausted => { fail move exhausted }
          }
        }
      }
    }
  }
  if count == usize.add(0, 2) {
    let source = run argumentAt(usize.ONE, count)
    return Request.Dump {source: move source, hir: false}
  }
  if count >= usize.add(0, 5) {
    let mode = run argumentAt(usize.ONE, count)
    let source = run argumentAt(usize.add(0, 2), count)
    let selector = run argumentAt(usize.add(0, 3), count)
    let output = run argumentAt(usize.add(0, 4), count)
    let testing = same(Bytes.asSlice(&mode), b"test")
    if (!testing && !same(Bytes.asSlice(&mode), b"build")) || !same(Bytes.asSlice(&selector), b"-o") {
      return run invalidArgumentCount(count)
    }
    let mut filter = Option<Bytes>.none()
    let mut file = Option<Bytes>.none()
    let mut timeout = Option<Bytes>.none()
    let mut noCache = false
    let mut stats = false
    let mut standardLibrary = Option<Bytes>.none()
    let mut clang = Option<Bytes>.none()
    let mut input = ProfileInput.make()
    let target = hostTarget()
    input.target = Option<Bytes>.some(run Bytes.copy(Target.name(&target)))
    input.optimization = Option<Bytes>.some(run Bytes.copy(b"speed"))
    input.debug = Option<bool>.some(false)
    let mut hasStdlib = false
    let mut hasOptimization = false
    let mut hasDebug = false
    let mut hasEmit = false
    let mut hasTarget = false
    let mut stage = Option<Stage>.none()
    let mut at = usize.add(0, 5)
    while at < count {
      let selector = run argumentAt(at, count)
      // `--no-cache` builds the test runner again instead of reusing an unchanged one (TEST-008).
      if testing && same(Bytes.asSlice(&selector), b"--no-cache") && !noCache {
        noCache = true
        at = at + usize.ONE
        continue
      }
      // The build's counters go to standard error after it finishes.
      if !testing && same(Bytes.asSlice(&selector), b"--stats") && !stats {
        stats = true
        at = at + usize.ONE
        continue
      }
      if at + usize.ONE >= count {
        return run invalidArgumentCount(count)
      }
      let value = run argumentAt(at + usize.ONE, count)
      if testing && same(Bytes.asSlice(&selector), b"--filter") && !hasFilter(&filter) {
        filter = Option<Bytes>.some(move value)
      } else if testing && same(Bytes.asSlice(&selector), b"--file") && !hasFilter(&file) {
        file = Option<Bytes>.some(move value)
      } else if testing && same(Bytes.asSlice(&selector), b"--timeout") && !hasFilter(&timeout) && ProjectCommands.isSeconds(Bytes.asSlice(&value)) {
        timeout = Option<Bytes>.some(move value)
      } else if same(Bytes.asSlice(&selector), b"--emit") && !hasEmit && !testing {
        stage = match move Projects.stageNamed(Bytes.asSlice(&value)) {
          Option<Stage>.Some {value: named} => Option<Stage>.some(named)
          Option<Stage>.None => run invalidArgumentCount(count)
        }
        hasEmit = true
      } else if same(Bytes.asSlice(&selector), b"--target") && !hasTarget && !testing {
        input.target = Option<Bytes>.some(move value)
        hasTarget = true
      } else if same(Bytes.asSlice(&selector), b"--clang") && !hasFilter(&clang) && !testing && Bytes.asSlice(&value).length > usize.ZERO {
        clang = Option<Bytes>.some(move value)
      } else if same(Bytes.asSlice(&selector), b"--stdlib") && !hasStdlib {
        standardLibrary = Option<Bytes>.some(move value)
        hasStdlib = true
      } else if same(Bytes.asSlice(&selector), b"--optimization") && !hasOptimization {
        input.optimization = Option<Bytes>.some(move value)
        hasOptimization = true
      } else if same(Bytes.asSlice(&selector), b"--debug") && !hasDebug {
        if same(Bytes.asSlice(&value), b"true") {
          input.debug = Option<bool>.some(true)
        } else if same(Bytes.asSlice(&value), b"false") {
          input.debug = Option<bool>.some(false)
        } else {
          return run invalidBuildProfile()
        }
        hasDebug = true
      } else {
        return run invalidArgumentCount(count)
      }
      at = at + usize.add(0, 2)
    }
    if testing {
      // A test build is always the runner's executable, whatever its manifest selects.
      input.artifact = Option<Bytes>.some(run Bytes.copy(Projects.profileArtifact(Form.Executable)))
      let initial = run InitialProfile.freeze(&input)
      if Target.id(InitialProfile.target(&initial)) != Target.id(&target) {
        return run invalidBuildProfile()
      }
      return Request.Test {source: move source, output: move output, standardLibrary: move standardLibrary,
        profile: move initial, filter: move filter, file: move file, timeout: move timeout, noCache: noCache}
    }
    return Request.Build {
      source: move source, output: move output, stage: move stage, standardLibrary: move standardLibrary,
      input: move input, stats: stats, clang: move clang,
    }
  }
  if count != usize.add(0, 3) {
    return run invalidArgumentCount(count)
  }
  let mode = run argumentAt(usize.ONE, count)
  if !selectsHir(Bytes.asSlice(&mode)) {
    drop mode
    return run invalidArgumentCount(count)
  }
  drop mode
  let source = run argumentAt(usize.add(0, 2), count)
  return Request.Dump {source: move source, hir: true}
}

effect fn lex<'source>(lexer: &mut Lexer<'source>) -> List<Token>
! OutOfMemoryError
? &mut Allocator {
  let mut tokens = List<Token>.make()
  while true {
    let taken = run Stream.take(&mut lexer)
    if let Option<Token>.Some {value} = move taken {
      run List<Token>.append(&mut tokens, move value)
    } else {
      break
    }
  }
  return move tokens
}

static if Intrinsic.targetOperatingSystem() == "darwin" {
  fn hostTarget() -> Target {
    return Target.forId(TargetId.Aarch64AppleDarwin)
  }
} else {
  static if Intrinsic.targetArchitecture() == "aarch64" {
    fn hostTarget() -> Target {
      return Target.forId(TargetId.Aarch64UnknownLinuxGnu)
    }
  } else {
    fn hostTarget() -> Target {
      return Target.forId(TargetId.X8664UnknownLinuxGnu)
    }
  }
}

fn originalGapReason(gap: &Gap) -> Option<RejectionCode> {
  return match &gap.source {
    GapSource.Diagnostic {diagnostic} => Option<RejectionCode>.some(Shared<Rejection>.with<RejectionCode>(
      &diagnostic, fn(value: &Rejection) -> RejectionCode { return value.code }))
    _ => Option<RejectionCode>.none()
  }
}

// The module whose source a gap is located in.
fn gapModule(gap: &Gap) -> ModuleId {
  return match &gap.source {
    GapSource.Declaration {declaration, ..} => Shared<DeclarationId>.with<ModuleId>(&declaration,
      fn(value: &DeclarationId) -> ModuleId { return ModuleId.copy(DeclarationId.moduleId(value)) })
    GapSource.Relative {declaration, ..} => Shared<DeclarationId>.with<ModuleId>(&declaration,
      fn(value: &DeclarationId) -> ModuleId { return ModuleId.copy(DeclarationId.moduleId(value)) })
    GapSource.Generated {declaration} => Shared<DeclarationId>.with<ModuleId>(&declaration,
      fn(value: &DeclarationId) -> ModuleId { return ModuleId.copy(DeclarationId.moduleId(value)) })
    GapSource.Diagnostic {diagnostic} => Shared<Rejection>.with<ModuleId>(&diagnostic,
      fn(value: &Rejection) -> ModuleId { return ModuleId.copy(&value.module) })
  }
}

// One human line per gap, as a refusal prints: `path:line:col: unsupported[<reason>] not supported
// by the native compiler yet`, naming the refusal that became the gap or else the gap itself.
effect fn gapLines(sources: &ModuleSources, gaps: &[Shared<Gap>], reported: &[ReportedSite], root: &[u8]) -> Bytes
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut lines = Bytes.make()
  let mut written = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < gaps.length {
    let code = Shared<Gap>.with<GapCode>(&gaps[at], fn(gap: &Gap) -> GapCode { return gap.code })
    let span = Shared<Gap>.with<Span>(&gaps[at], fn(gap: &Gap) -> Span { return Gap.span(gap) })
    let module = Shared<Gap>.with<ModuleId>(&gaps[at], gapModule)
    let mut line = Bytes.make()
    run appendLocation(&mut line, sources, &module, span, root, false)
    let original = Shared<Gap>.with<Option<RejectionCode>>(&gaps[at], originalGapReason)
    // A gap that carries a refusal already printed at the same site adds nothing.
    let mut printed = false
    if let Option<RejectionCode>.Some {value: reason} = &original {
      let mut earlier = usize.ZERO
      while earlier < reported.length {
        if reported[earlier].code == reason && reported[earlier].span.start == span.start && reported[earlier].span.end == span.end
          && ModuleId.equals(&reported[earlier].module, &module) {
          printed = true
        }
        earlier = earlier + usize.ONE
      }
    }
    match move original {
      Option<RejectionCode>.Some {value: reason} => {
        if reason == RejectionCode.Unsupported {
          run Bytes.append(&mut line, b": unsupported: this construct is not supported by the native compiler yet\n")
        } else {
          run Bytes.append(&mut line, b": unsupported[")
          run Bytes.append(&mut line, Rejection.name(reason))
          run Bytes.append(&mut line, b"] not supported by the native compiler yet\n")
        }
      }
      Option<RejectionCode>.None => {
        run Bytes.append(&mut line, b": unsupported[")
        run Bytes.append(&mut line, Gap.name(code))
        run Bytes.append(&mut line, b"] not supported by the native compiler yet\n")
      }
    }
    let mut seen = false
    let previous = List<Bytes>.asSlice(&written)
    let mut earlier = usize.ZERO
    while earlier < previous.length {
      if same(Bytes.asSlice(&previous[earlier]), Bytes.asSlice(&line)) { seen = true }
      earlier = earlier + usize.ONE
    }
    if !seen && !printed {
      run Bytes.append(&mut lines, Bytes.asSlice(&line))
      run List<Bytes>.append(&mut written, move line)
    }
    at = at + usize.ONE
  }
  return move lines
}

effect fn gapSummary(gaps: &[Shared<Gap>]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut message = run Bytes.copy(b"SILK_UNSUPPORTED_JSON={\"gaps\":[")
  let mut at = usize.ZERO
  while at < gaps.length {
    if at > usize.ZERO {
      run Bytes.append(&mut message, b",")
    }
    let code = Shared<Gap>.with<GapCode>(
      &gaps[at],
      fn(gap: &Gap) -> GapCode {
        return gap.code
      },
    )
    let span = Shared<Gap>.with<Span>(
      &gaps[at],
      fn(gap: &Gap) -> Span {
        return Gap.span(gap)
      },
    )
    let owner = Shared<Gap>.with<Shared<DeclarationId>>(
      &gaps[at],
      fn(gap: &Gap) -> Shared<DeclarationId> {
        return Shared<DeclarationId>.clone(&gap.owner)
      },
    )
    let key = run InstanceKey.named(&owner)
    let symbol = run InstanceKey.runtimeName(&key)
    run Bytes.append(&mut message, b"{\"code\":\"")
    run Bytes.append(&mut message, Gap.name(code))
    run Bytes.append(&mut message, b"\",\"reason\":\"Not supported by this compiler yet: ")
    let original = Shared<Gap>.with<Option<RejectionCode>>(&gaps[at], originalGapReason)
    match move original {
      Option<RejectionCode>.Some {value: reason} => { run Bytes.append(&mut message, Rejection.name(reason)) }
      Option<RejectionCode>.None => { run Bytes.append(&mut message, Gap.name(code)) }
    }
    run Bytes.append(&mut message, b"; reached in ")
    run Bytes.append(&mut message, Bytes.asSlice(&symbol))
    run Bytes.append(&mut message, b" at bytes ")
    run JsonText.appendDecimal(&mut message, span.start)
    run Bytes.append(&mut message, b"-")
    run JsonText.appendDecimal(&mut message, span.end)
    let gap = Shared<Gap>.with<Gap>(&gaps[at], fn(value: &Gap) -> Gap { return Gap.copy(value) })
    let sourcePath = run Gap.sourcePath(&gap)
    run Bytes.append(&mut message, b"\",\"source\":{\"module\":")
    run JsonText.appendString(&mut message, Bytes.asSlice(&sourcePath))
    run Bytes.append(&mut message, b",\"span\":{\"start\":")
    run JsonText.appendDecimal(&mut message, span.start)
    run Bytes.append(&mut message, b",\"end\":")
    run JsonText.appendDecimal(&mut message, span.end)
    run Bytes.append(&mut message, b"}}}")
    at = at + usize.ONE
  }
  run Bytes.append(&mut message, b"]}\n")
  return move message
}

fn diagnosticStatus(diagnostic: &Shared<Rejection>) -> i32 {
  let code = Shared<Rejection>.with<RejectionCode>(diagnostic, fn(value: &Rejection) -> RejectionCode { return value.code })
  if Rejections.stableCode(code).length == usize.ZERO { return 2 }
  return 1
}

effect fn rejectionSummary(diagnostic: &Shared<Rejection>) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let code = Shared<Rejection>.with<RejectionCode>(diagnostic, fn(rejection: &Rejection) -> RejectionCode {
    return rejection.code
  })
  let span = Shared<Rejection>.with<Span>(diagnostic, fn(rejection: &Rejection) -> Span {
    return rejection.span
  })
  let catalogCode = Rejections.stableCode(code)
  if catalogCode.length == usize.ZERO {
    let module = Shared<Rejection>.with<ModuleId>(diagnostic, fn(value: &Rejection) -> ModuleId {
      return ModuleId.copy(&value.module)
    })
    let path = run ModuleId.copyPath(&module)
    let mut refusal = run Bytes.copy(b"SILK_UNSUPPORTED_JSON={\"gaps\":[{\"code\":")
    run JsonText.appendString(&mut refusal, Rejection.name(code))
    run Bytes.append(&mut refusal, b",\"reason\":\"")
    if code == RejectionCode.IdentityUnavailable {
      run Bytes.append(&mut refusal, b"Identity unavailable in this revision")
    } else {
      run Bytes.append(&mut refusal, b"Not supported by this compiler yet: ")
      run Bytes.append(&mut refusal, Rejection.name(code))
    }
    run Bytes.append(&mut refusal, b"\",\"source\":{\"module\":")
    run JsonText.appendString(&mut refusal, Bytes.asSlice(&path))
    run Bytes.append(&mut refusal, b",\"span\":{\"start\":")
    run JsonText.appendDecimal(&mut refusal, span.start)
    run Bytes.append(&mut refusal, b",\"end\":")
    run JsonText.appendDecimal(&mut refusal, span.end)
    run Bytes.append(&mut refusal, b"}}}]}\n")
    return move refusal
  }
  let mut message = run Bytes.copy(b"SILK_BUILD_ERROR={\"code\":\"")
  run Bytes.append(&mut message, catalogCode)
  run Bytes.append(&mut message, b"\",\"span\":{\"start\":")
  run JsonText.appendDecimal(&mut message, span.start)
  run Bytes.append(&mut message, b",\"end\":")
  run JsonText.appendDecimal(&mut message, span.end)
  // The rejected source's logical module, which may be an imported or standard-library module.
  let module = Shared<Rejection>.with<ModuleId>(diagnostic, fn(rejection: &Rejection) -> ModuleId {
    return ModuleId.copy(&rejection.module)
  })
  let path = run ModuleId.copyPath(&module)
  run Bytes.append(&mut message, b"},\"module\":")
  run JsonText.appendString(&mut message, Bytes.asSlice(&path))
  run Bytes.append(&mut message, b"}\n")
  return move message
}

effect fn writeOutput(bytes: &[u8]) -> () ! WriterError {
  let mut stdout = StdoutWriter.make()
  return run Writer.writeAll(bytes)
    |> Effect.provideMut<Writer>(&mut stdout)
}

// Writes each format outcome's line: unchanged and formatted files on standard output, and drift,
// damage and failures on standard error, as the TypeScript CLI writes them.
effect fn reportFormat(outcomes: &[FileOutcome]) -> () ! WriterError | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < outcomes.length {
    let text = run FormatCommand.line(&outcomes[at])
    if FormatCommand.toStandardOutput(&outcomes[at]) {
      run writeOutput(Bytes.asSlice(&text))
    } else {
      run writeError(Bytes.asSlice(&text))
    }
    at = at + usize.ONE
  }
  return ()
}

// A path relative to `display` when it lies under it, else the absolute path, never `../` steps.
effect fn shownPath(display: &Path, path: &Path) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let relative = run CommandPath.relative(display, path)
  let spelled = Bytes.asSlice(&relative)
  let outside = spelled.length >= 2 && spelled[0] == 46 && spelled[1] == 46 && (spelled.length == 2 || spelled[2] == 47)
  if outside || spelled.length == usize.ZERO { return run Bytes.copy(Path.rawBytes(path)) }
  return move relative
}

// Writes the TypeScript CLI's line for one compiled artifact on standard output:
// `Compiled <source> -> <output> (llvm, <target>, <n> symbols)`, with both paths relative to
// `display` when they lie under it and absolute otherwise.
effect fn reportCompiled(display: &Path, source: &Path, output: &Path, target: &Target, symbols: usize) -> ()
! WriterError | OutOfMemoryError ? &mut Allocator {
  let mut line = run Bytes.copy(b"Compiled ")
  let from = run shownPath(display, source)
  run Bytes.append(&mut line, Bytes.asSlice(&from))
  run Bytes.append(&mut line, b" -> ")
  let to = run shownPath(display, output)
  run Bytes.append(&mut line, Bytes.asSlice(&to))
  run Bytes.append(&mut line, b" (llvm, ")
  run Bytes.append(&mut line, Target.name(target))
  run Bytes.append(&mut line, b", ")
  run JsonText.appendDecimal(&mut line, symbols)
  run Bytes.append(&mut line, b" symbols)\n")
  run writeOutput(Bytes.asSlice(&line))
}

// Writes a refused platform supply as the TypeScript CLI does: `<code>: <subject> (<origin>)`, the
// correction, and any tool output.
effect fn reportSupply(refused: &SupplyError) -> () ! WriterError | OutOfMemoryError ? &mut Allocator {
  let mut text = run Bytes.copy(refused.code)
  run Bytes.append(&mut text, b": ")
  run Bytes.append(&mut text, Bytes.asSlice(&refused.subject))
  run Bytes.append(&mut text, b" (")
  run Bytes.append(&mut text, Bytes.asSlice(&refused.origin))
  run Bytes.append(&mut text, b")\n")
  run Bytes.append(&mut text, Bytes.asSlice(&refused.correction))
  run Bytes.append(&mut text, b"\n")
  if Bytes.length(&refused.detail) > usize.ZERO {
    run Bytes.append(&mut text, Bytes.asSlice(&refused.detail))
    run Bytes.append(&mut text, b"\n")
  }
  run writeError(Bytes.asSlice(&text))
}

effect fn writeError(bytes: &[u8]) -> () ! WriterError {
  let mut stderr = StderrWriter.make()
  return run Writer.writeAll(bytes)
    |> Effect.provideMut<Writer>(&mut stderr)
}

/// Compiles the completed LLVM text into `form` at `stage` and writes it to `output`.
///
/// An executable's final stage links the declared inputs and the C libraries for the host. Every
/// other form or stage is compiled for its target with the profile's relocation model and needs no
/// linker. An object's final stage merges declared objects and archives by a relocatable link; a
/// static library's final stage archives its compiled object beside the declared objects. Each
/// refuses any other declared input; an intermediate stage takes no declared inputs.
///
/// Two commands that build one package at once write the same `output`, so each makes its files in a
/// new directory of its own beside it, renames the finished output over `output`, and removes the
/// directory.
effect fn compileIr(ir: &Bytes, units: &[CodegenUnit], packs: &[BuildRecord.PackBody], output: &Path, form: Form, stage: Stage, optimization: &[u8], debug: bool, relocation: &[u8],
  profileFlags: &[Bytes], target: &Target, supply: &Option<Supply>, linkInputs: &[NativeLinkInput], selectedClang: &Option<Bytes>,
  world: &WasiTools.World, started: bool, progress: &mut Progress) -> i32
! FileError | ProcessError | HostInputError | InvalidNativeLinkInput | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let parent = match move run Path.parent(output) {
    Option<Path>.Some {value} => move value
    Option<Path>.None => run Path.fromBytes(Path.rawBytes(output))
  }
  let scratch = run FileSystem.createTemporaryDirectory(&parent, b".silk-")
  let use = effect fn(resource: &mut Path) -> i32
  ! FileError | ProcessError | HostInputError | InvalidNativeLinkInput | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
    return run compileIrIn(&resource.*, ir, units, packs, output, form, stage, optimization, debug, relocation, profileFlags, target, supply,
      linkInputs, selectedClang, world, started, &mut progress.*)
  }
  let release = effect fn(resource: &mut Path) -> () ? &mut FileSystem | &mut Allocator {
    let removed = run Effect.result(FileSystem.removeDirectoryRecursively(&resource.*))
    drop removed
    return ()
  }
  return run Effect.useReleaseNonParking(move scratch, move use, move release)
}

// Compiles as `compileIr` does, with the intermediate files in `scratch` under the output's name,
// which Clang records in the object.
effect fn compileIrIn(scratch: &Path, ir: &Bytes, units: &[CodegenUnit], packs: &[BuildRecord.PackBody], output: &Path, form: Form, stage: Stage, optimization: &[u8], debug: bool,
  relocation: &[u8], profileFlags: &[Bytes], target: &Target, supply: &Option<Supply>, linkInputs: &[NativeLinkInput],
  selectedClang: &Option<Bytes>, world: &WasiTools.World, started: bool, progress: &mut Progress) -> i32
! FileError | ProcessError | HostInputError | InvalidNativeLinkInput | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let outputName = Path.rawBytes(output)
  let mut nameStart = outputName.length
  while nameStart > usize.ZERO && outputName[nameStart - usize.ONE] != 47 { nameStart = nameStart - usize.ONE }
  // The output itself is made here too, then renamed over `output`.
  let mut stem = run Bytes.copy(Path.rawBytes(scratch))
  run Bytes.append(&mut stem, b"/")
  run Bytes.append(&mut stem, Slice.view<u8>(outputName, nameStart, outputName.length - nameStart))
  let staged = run Path.fromBytes(Bytes.asSlice(&stem))
  let mut intermediate = run Bytes.copy(Bytes.asSlice(&stem))
  run Bytes.append(&mut intermediate, b".silk.bc")
  let irPath = run Path.fromBytes(Bytes.asSlice(&intermediate))
  // A static library's single compiled member is written beside the IR, then removed.
  let mut memberBytes = run Bytes.copy(Bytes.asSlice(&stem))
  run Bytes.append(&mut memberBytes, b".silk.o")
  let member = run Path.fromBytes(Bytes.asSlice(&memberBytes))
  let mut named = Option<&[u8]>.none()
  if let Option<Bytes>.Some {value} = &selectedClang.* { named = Option<&[u8]>.some(Bytes.asSlice(&value)) }
  let clang = match move run NativeToolchain.compiler(move named) {
    Option<Path>.Some {value} => move value
    Option<Path>.None => {
      run Progress.clear(&mut progress.*)
      if let Option<Bytes>.Some {value: missing} = &selectedClang.* {
        run writeError(b"silk: cannot find ")
        run writeError(Bytes.asSlice(&missing))
        run writeError(b" on PATH; pass --clang the path of the Clang executable\n")
      } else {
        run writeError(b"silk: cannot find clang on PATH; set SILK_CLANG or pass --clang the path of the Clang executable\n")
      }
      return 2
    }
  }
  // Where `clang` came from, so a failure to start it names its source.
  let mut origin: &[u8] = b"from --clang"
  if let Option<Bytes>.None = &selectedClang.* {
    origin = b"found on PATH"
    if let Option<Bytes>.Some {value: _} = move run HostInput.variableNamed("SILK_CLANG") { origin = b"from SILK_CLANG" }
  }
  let mut process = run NativeToolchain.request(&clang)
  let final = stage == Stage.Final
  let linked = final && form == Form.Executable
  let merged = final && form == Form.Object && linkInputs.length > usize.ZERO
  let archive = final && form == Form.StaticLibrary
  // A wasm32 executable links freestanding: no libc, no entry, and the source runtime beside the IR.
  let freestanding = linked && same(Target.objectFormat(target), b"wasm")
  let mut runtimeBytes = run Bytes.copy(Bytes.asSlice(&stem))
  run Bytes.append(&mut runtimeBytes, b".silk-runtime.c")
  let runtimePath = run Path.fromBytes(Bytes.asSlice(&runtimeBytes))
  let mut componentBytes = run Bytes.copy(Bytes.asSlice(&stem))
  run Bytes.append(&mut componentBytes, b".component.wasm")
  let componentPath = run Path.fromBytes(Bytes.asSlice(&componentBytes))
  if freestanding {
    let mut selected = run Bytes.copy(b"--target=")
    run Bytes.append(&mut selected, Target.llvmTriple(target))
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&selected))
    run ChildProcess.addArgument(&mut process, "-nostdlib")
    run ChildProcess.addArgument(&mut process, "-Wl,--no-entry")
    // The backend's `main` wrapper carries no export attribute; see LlvmCode's export names.
    if same(Target.operatingSystem(target), b"wasi") {
      if started { run ChildProcess.addArgument(&mut process, "-Wl,--export=_start") }
      run ChildProcess.addArgument(&mut process, "-DSILK_WASI=1")
      if Target.id(target) == TargetId.Wasm32Wasip2 {
        run ChildProcess.addArgument(&mut process, "-DSILK_WASI_COMPONENT=1")
      }
    } else {
      run ChildProcess.addArgument(&mut process, "-Wl,--export=main")
    }
  }
  if !linked {
    // The IR names no triple, so a cross-target output states its target to Clang.
    let mut selected = run Bytes.copy(b"--target=")
    run Bytes.append(&mut selected, Target.llvmTriple(target))
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&selected))
    if merged {
      run ChildProcess.addArgument(&mut process, "-r")
      run ChildProcess.addArgument(&mut process, "-nostdlib")
    } else if stage == Stage.Assembly {
      run ChildProcess.addArgument(&mut process, "-S")
    } else {
      run ChildProcess.addArgument(&mut process, "-c")
      if stage == Stage.LlvmBitcode { run ChildProcess.addArgument(&mut process, "-emit-llvm") }
    }
    if same(relocation, b"pic") {
      run ChildProcess.addArgument(&mut process, "-fPIC")
    } else {
      run ChildProcess.addArgument(&mut process, "-fno-pic")
    }
  }
  // The flags that decide the code Clang writes, which each codegen unit's compile shares.
  let mut common = List<Bytes>.make()
  if same(optimization, b"speed") {
    run List<Bytes>.append(&mut common, run Bytes.copy(b"-O2"))
  } else {
    run List<Bytes>.append(&mut common, run Bytes.copy(b"-O0"))
  }
  if debug {
    run List<Bytes>.append(&mut common, run Bytes.copy(b"-g"))
  }
  let mut flag = usize.ZERO
  while flag < profileFlags.length {
    run List<Bytes>.append(&mut common, run Bytes.copy(Bytes.asSlice(&profileFlags[flag])))
    flag = flag + usize.ONE
  }
  // A link uses its resolved supply, never ambient SDK, sysroot or linker settings.
  if let Option<Supply>.Some {value: selected} = &supply.* {
    if selected.darwin {
      run List<Bytes>.append(&mut common, run Bytes.copy(b"-isysroot"))
      run List<Bytes>.append(&mut common, run Bytes.copy(Path.rawBytes(&selected.root)))
      let mut minimum = run Bytes.copy(b"-mmacosx-version-min=")
      run Bytes.append(&mut minimum, Bytes.asSlice(&selected.deployment))
      run List<Bytes>.append(&mut common, move minimum)
    } else {
      let mut sysroot = run Bytes.copy(b"--sysroot=")
      run Bytes.append(&mut sysroot, Path.rawBytes(&selected.root))
      run List<Bytes>.append(&mut common, move sysroot)
    }
    if let Option<Path>.Some {value: installation} = &selected.support {
      let mut gcc = run Bytes.copy(b"--gcc-install-dir=")
      run Bytes.append(&mut gcc, Path.rawBytes(&installation))
      run List<Bytes>.append(&mut common, move gcc)
    }
    if let Option<Path>.Some {value: tool} = &selected.linker {
      let mut ldPath = run Bytes.copy(b"--ld-path=")
      run Bytes.append(&mut ldPath, Path.rawBytes(&tool))
      run List<Bytes>.append(&mut common, move ldPath)
    }
  }
  let shared = List<Bytes>.asSlice(&common)
  flag = usize.ZERO
  while flag < shared.length {
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&shared[flag]))
    flag = flag + usize.ONE
  }
  // A split build links the cached object of each codegen unit instead of compiling the module.
  let mut objects = List<Path>.make()
  if units.length > usize.ZERO {
    objects = match move run compileUnits(scratch, &clang, origin, shared, units, packs, output, &mut progress.*) {
      UnitBuild.Objects {paths} => move paths
      UnitBuild.Failed {status} => { return status }
    }
  } else {
    run ChildProcess.addArgument(&mut process, "-x")
    run ChildProcess.addArgument(&mut process, "ir")
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&intermediate))
  }
  if freestanding {
    run ChildProcess.addArgument(&mut process, "-x")
    run ChildProcess.addArgument(&mut process, "c")
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&runtimeBytes))
  }
  // Restore extension-based input kinds so declared objects and archives are not read as IR.
  run ChildProcess.addArgument(&mut process, "-x")
  run ChildProcess.addArgument(&mut process, "none")
  let linkedObjects = List<Path>.asSlice(&objects)
  flag = usize.ZERO
  while flag < linkedObjects.length {
    run ChildProcess.addArgumentBytes(&mut process, Path.rawBytes(&linkedObjects[flag]))
    flag = flag + usize.ONE
  }
  run ChildProcess.addArgument(&mut process, "-o")
  let mut archiver = Option<ProcessRequest>.none()
  if archive {
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&memberBytes))
    // `rcsD`: replace members, create the archive, write its symbol index, and zero member times.
    let mut request = run NativeToolchain.archiver(&clang)
    run ChildProcess.addArgument(&mut request, "rcsD")
    run ChildProcess.addArgumentBytes(&mut request, Bytes.asSlice(&stem))
    run ChildProcess.addArgumentBytes(&mut request, Bytes.asSlice(&memberBytes))
    let mut declared = usize.ZERO
    while declared < linkInputs.length {
      run NativeLinkInputs.appendArchiveMember(&linkInputs[declared], &mut request)
      declared = declared + usize.ONE
    }
    archiver = Option<ProcessRequest>.some(move request)
  } else {
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&stem))
  }
  if final && !archive {
    // Declared inputs precede the C libraries so their own references to libc and libm resolve.
    let mut input = usize.ZERO
    while input < linkInputs.length {
      if !linked && !NativeLinkInputs.relocatable(&linkInputs[input]) {
        run NativeLinkInputs.invalid(b"an object artifact merges only declared objects and static archives")
      }
      run NativeLinkInputs.appendArguments(&linkInputs[input], target, &mut process)
      input = input + usize.ONE
    }
  }
  if linked && !freestanding {
    run ChildProcess.addArgument(&mut process, "-lc")
    run ChildProcess.addArgument(&mut process, "-lm")
  }
  // The link consumes the supply only while its selected files keep the bytes resolution read.
  if let Option<Supply>.Some {value: selected} = &supply.* {
    let checked = run Effect.result(PlatformSupplies.validate(&selected))
    match move checked {
      Result<(), SupplyError | OutOfMemoryError>.Success {value: _} => {}
      Result<(), SupplyError | OutOfMemoryError>.Failure {error} => match move error {
        SupplyError changed => {
          run Progress.clear(&mut progress.*)
          run reportSupply(&changed)
          return 2
        }
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
  }
  // An executable links again only when its command or its output changed since the link its
  // stamp records. A split build's command names its cached objects; a whole module and the wasm
  // runtime source are named by their digests. Anything else read from outside the build (a
  // declared input, an archive, the wasip2 component tools) relinks every time.
  let stamped = linked && !archive && linkInputs.length == usize.ZERO && Target.id(target) != TargetId.Wasm32Wasip2
  let mut command = run linkCommand(&process, Bytes.asSlice(&stem))
  if units.length == usize.ZERO { run appendDigest(&mut command, ContentHash.of(Bytes.asSlice(ir))) }
  if freestanding { run appendDigest(&mut command, ContentHash.of(WasmRuntime.source())) }
  let unitDirectory = run CodegenCache.directoryFor(output)
  let use = effect fn(resource: &mut Path) -> i32
  ! FileError | ProcessError | HostInputError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
    if stamped && run CodegenCache.linkedBy(&unitDirectory, Bytes.asSlice(&command), output) { return 0 }
    run CodegenCache.forgetLink(&unitDirectory)
    if units.length == usize.ZERO {
      if let ClangVersion.Failed {status} = run probeClang(&clang, origin, &mut progress.*) { return status }
      let bitcode = run Bitcode.compile(Bytes.asSlice(ir))
      run FileSystem.writeFile(&resource.*, Bytes.asSlice(&bitcode))
    }
    if freestanding { run FileSystem.writeFile(&runtimePath, WasmRuntime.source()) }
    // A Clang that cannot start fails this target, which reports as any failed target does.
    let compiled = match move run Effect.result(submitted(&process, &mut progress.*)) {
      Result<i32, ProcessError | OutOfMemoryError | WriterError>.Success {value} => value
      Result<i32, ProcessError | OutOfMemoryError | WriterError>.Failure {error} => match move error {
        ProcessError unstarted => {
          drop unstarted
          run Progress.clear(&mut progress.*)
          run writeError(b"silk: cannot run the C compiler ")
          run writeError(Path.rawBytes(&clang))
          run writeError(b" (")
          run writeError(origin)
          run writeError(b"); set SILK_CLANG or pass --clang the path of the Clang executable\n")
          return 2
        }
        OutOfMemoryError exhausted => { fail move exhausted }
        WriterError broken => { fail move broken }
      }
    }
    if compiled != 0 { return compiled }
    if units.length > usize.ZERO { run CodegenCache.prune(&unitDirectory, linkedObjects) }
    if let Option<ProcessRequest>.Some {value: archiving} = &archiver {
      let archived = run submitted(&archiving, &mut progress.*)
      if archived != 0 { return archived }
    }
    // Component construction completes before the output is published.
    let mut publication = &staged
    if linked && Target.id(target) == TargetId.Wasm32Wasip2 {
      let converted = run WasiTools.component(&staged, &componentPath, world, started)
      if converted != 0 { return converted }
      publication = &componentPath
    }
    // One rename, so a command running `output` meanwhile finds the old file or the new one.
    let published = run HostRename.replaceFile(publication, output)
    if !published {
      run Progress.clear(&mut progress.*)
      run writeError(b"silk: cannot write ")
      run writeError(Path.rawBytes(output))
      run writeError(b"\n")
      return 2
    }
    if stamped { run CodegenCache.recordLink(&unitDirectory, Bytes.asSlice(&command), output) }
    return 0
  }
  let release = effect fn(resource: &mut Path) -> () ? &mut FileSystem {
    run removeQuietly(&resource.*)
    if archive { run removeQuietly(&member) }
    if freestanding { run removeQuietly(&runtimePath) }
    run removeQuietly(&componentPath)
    return ()
  }
  return run Effect.useReleaseNonParking(move irPath, move use, move release)
}

// Appends `digest` to a link command on a line of its own.
effect fn appendDigest(command: &mut Bytes, digest: ContentHash) -> () ! OutOfMemoryError ? &mut Allocator {
  run Bytes.append(&mut command.*, b"\n")
  run appendDecimal(&mut command.*, u64.toUsize(digest.high))
  run Bytes.append(&mut command.*, b" ")
  run appendDecimal(&mut command.*, u64.toUsize(digest.low))
}

// Whether the file at `path` holds exactly `expected`; false when it cannot be read.
effect fn holds(path: &Path, expected: &[u8]) -> bool ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  return match move run Effect.result(FileSystem.readFile(path)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success {value} => same(Bytes.asSlice(&value), expected)
    Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => {
        drop failure
        return false
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// What decides the output `process` links: its program, its arguments but the scratch name
// `staged` it writes to, its environment and its working directory.
effect fn linkCommand(process: &ProcessRequest, staged: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut command = run Bytes.copy(ChildProcess.program(process))
  run Bytes.append(&mut command, b"\n")
  let arguments = ChildProcess.arguments(process)
  let mut start = usize.ZERO
  while start < arguments.length {
    let mut end = start
    while end < arguments.length && arguments[end] != 0 { end = end + usize.ONE }
    if end < arguments.length { end = end + usize.ONE }
    let entry = Slice.view<u8>(arguments, start, end - start)
    // A file in the scratch directory is named by its suffix alone, since that directory is fresh
    // for every link; the staged output itself is left out.
    if entry.length > staged.length && same(Slice.view<u8>(entry, usize.ZERO, staged.length), staged) {
      if entry.length != staged.length + usize.ONE {
        run Bytes.append(&mut command, Slice.view<u8>(entry, staged.length, entry.length - staged.length))
      }
    } else {
      run Bytes.append(&mut command, entry)
    }
    start = end
  }
  run Bytes.append(&mut command, b"\n")
  run Bytes.append(&mut command, ChildProcess.environment(process))
  run Bytes.append(&mut command, b"\n")
  run Bytes.append(&mut command, ChildProcess.workingDirectory(process))
  return move command
}

// The objects of a split build's codegen units, or the status of a compile that failed after
// writing why.
union UnitBuild {
  Objects {paths: List<Path>},
  Failed {status: i32},
}

// Clang's `--version` output, or the status of a build that cannot use it after writing why.
union ClangVersion {
  Answered {output: Bytes},
  Failed {status: i32},
}

// Asks `clang`, from `origin`, for its version. The backend writes LLVM 22 bitcode, which older
// Clang misreads (Clang 18's optimizer crashes on its lifetime markers), so an older one is refused.
effect fn probeClang(clang: &Path, origin: &[u8], progress: &mut Progress) -> ClangVersion
! FileError | ProcessError | HostInputError | OutOfMemoryError | WriterError ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let mut version = run NativeToolchain.request(clang)
  run ChildProcess.addArgument(&mut version, "--version")
  let probed = match move run Effect.result(ChildProcess.submit(&version)) {
    Result<ProcessOutcome, ProcessError | OutOfMemoryError>.Success {value} => move value
    Result<ProcessOutcome, ProcessError | OutOfMemoryError>.Failure {error} => match move error {
      ProcessError unstarted => {
        drop unstarted
        return ClangVersion.Failed {status: run unstartedClang(clang, origin, &mut progress.*)}
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let mut answered = false
  if let Option<i32>.Some {value} = move ChildProcess.exitCode(&probed) { answered = value == 0 }
  if !answered { return ClangVersion.Failed {status: run unstartedClang(clang, origin, &mut progress.*)} }
  let output = ChildProcess.outputBytes(&probed)
  if let Option<usize>.Some {value: major} = clangMajor(output) {
    if major < usize.add(0, 22) {
      run Progress.clear(&mut progress.*)
      let mut message = run Bytes.copy(b"silk: Silk builds need Clang 22 or newer, but ")
      run Bytes.append(&mut message, Path.rawBytes(clang))
      run Bytes.append(&mut message, b" (")
      run Bytes.append(&mut message, origin)
      run Bytes.append(&mut message, b") is Clang ")
      run appendDecimal(&mut message, major)
      run Bytes.append(&mut message, b"; set SILK_CLANG or pass --clang the path of a newer Clang\n")
      run writeError(Bytes.asSlice(&message))
      return ClangVersion.Failed {status: 2}
    }
  }
  return ClangVersion.Answered {output: run Bytes.copy(output)}
}

// Writes that `clang`, from `origin`, cannot run, and answers the failed build's status.
effect fn unstartedClang(clang: &Path, origin: &[u8], progress: &mut Progress) -> i32 ! WriterError {
  run Progress.clear(&mut progress.*)
  run writeError(b"silk: cannot run the C compiler ")
  run writeError(Path.rawBytes(clang))
  run writeError(b" (")
  run writeError(origin)
  run writeError(b"); set SILK_CLANG or pass --clang the path of the Clang executable\n")
  return 2
}

// Compiles each codegen unit whose object the cache beside `output` lacks, on worker threads, with
// its IR in `scratch`, and answers every unit's object. `origin` says where `clang` came from, for
// the error when it cannot start.
effect fn compileUnits(scratch: &Path, clang: &Path, origin: &[u8], common: &[Bytes], units: &[CodegenUnit], packs: &[BuildRecord.PackBody],
  output: &Path,
  progress: &mut Progress) -> UnitBuild
! FileError | ProcessError | HostInputError | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  // An object is reused only for the same Clang, flags and unit text.
  let probed = match move run probeClang(clang, origin, &mut progress.*) {
    ClangVersion.Answered {output: answer} => move answer
    ClangVersion.Failed {status} => { return UnitBuild.Failed {status: status} }
  }
  let mut identity = run Bytes.copy(Path.rawBytes(clang))
  run Bytes.append(&mut identity, b"\n")
  run Bytes.append(&mut identity, Bytes.asSlice(&probed))
  let mut at = usize.ZERO
  while at < common.length {
    run Bytes.append(&mut identity, b"\n")
    run Bytes.append(&mut identity, Bytes.asSlice(&common[at]))
    at = at + usize.ONE
  }
  let directory = run CodegenCache.directoryFor(output)
  let placed = run CodegenCache.place(&directory, Bytes.asSlice(&identity), units)
  let objects = List<Path>.asSlice(&placed.objects)
  let missing = List<usize>.asSlice(&placed.missing)
  let mut jobs = List<CodegenCache.Job>.make()
  // Keep each command and input to rerun a failed one here, where its errors are written.
  let mut kept = List<List<Bytes>>.make()
  let mut inputs = List<Path>.make()
  let mut sizes = List<usize>.make()
  at = usize.ZERO
  while at < missing.length {
    // A unit is written under its object's name: Clang records the file name in the object, which
    // then reads the same for the same fragments whichever build compiles it.
    let objectBytes = Path.rawBytes(&objects[missing[at]])
    let mut slash = objectBytes.length
    while slash > usize.ZERO && objectBytes[slash - usize.ONE] != 47 { slash = slash - usize.ONE }
    let mut name = run Bytes.copy(Slice.view<u8>(objectBytes, slash, objectBytes.length - slash - 2))
    run Bytes.append(&mut name, b".bc")
    let ir = run Path.joinBytes(scratch, Bytes.asSlice(&name))
    let mut fragments = run Bytes.copy(Bytes.asSlice(&units[missing[at]].head))
    run Bytes.append(&mut fragments, unitBody(&units[missing[at]], packs))
    run List<usize>.append(&mut sizes, Bytes.length(&fragments))
    let mut command = List<Bytes>.make()
    run List<Bytes>.append(&mut command, run Bytes.copy(Path.rawBytes(clang)))
    run List<Bytes>.append(&mut command, run Bytes.copy(b"-c"))
    run List<Bytes>.append(&mut command, run Bytes.copy(b"-Wno-unused-command-line-argument"))
    let mut flag = usize.ZERO
    while flag < common.length {
      run List<Bytes>.append(&mut command, run Bytes.copy(Bytes.asSlice(&common[flag])))
      flag = flag + usize.ONE
    }
    run List<Bytes>.append(&mut command, run Bytes.copy(b"-x"))
    run List<Bytes>.append(&mut command, run Bytes.copy(b"ir"))
    run List<Bytes>.append(&mut command, run Bytes.copy(Path.rawBytes(&ir)))
    run List<Bytes>.append(&mut command, run Bytes.copy(b"-o"))
    let partial = run CodegenCache.pending(&objects[missing[at]])
    run List<Bytes>.append(&mut command, run Bytes.copy(Path.rawBytes(&partial)))
    let mut copied = List<Bytes>.make()
    let parts = List<Bytes>.asSlice(&command)
    let mut part = usize.ZERO
    while part < parts.length {
      run List<Bytes>.append(&mut copied, run Bytes.copy(Bytes.asSlice(&parts[part])))
      part = part + usize.ONE
    }
    run List<List<Bytes>>.append(&mut kept, move copied)
    run List<CodegenCache.Job>.append(&mut jobs, CodegenCache.Job {fragments: move fragments, input: run Bytes.copy(Path.rawBytes(&ir)),
      command: move command})
    run List<Path>.append(&mut inputs, move ir)
    at = at + usize.ONE
  }
  // Without threads, each unit compiles below, one at a time.
  let mut statuses = List<i32>.make()
  match move run Effect.result(CodegenCache.runAll(move jobs, List<usize>.asSlice(&sizes), NativeThread.processorCount())) {
    Result<List<i32>, OutOfMemoryError | SpawnError>.Success {value} => { statuses = move value }
    Result<List<i32>, OutOfMemoryError | SpawnError>.Failure {error} => match move error {
      SpawnError unstarted => { drop unstarted }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  at = usize.ZERO
  while at < missing.length {
    let mut status: i32 = -1
    if at < List<i32>.length(&statuses) { status = List<i32>.get(&statuses, at) }
    if status != 0 || !run CodegenCache.publish(&objects[missing[at]]) {
      // A worker that failed early may not have written the input.
      let mut fragments = run Bytes.copy(Bytes.asSlice(&units[missing[at]].head))
      run Bytes.append(&mut fragments, unitBody(&units[missing[at]], packs))
      let bitcode = run Bitcode.compile(Bytes.asSlice(&fragments))
      run FileSystem.writeFile(&List<Path>.asSlice(&inputs)[at], Bytes.asSlice(&bitcode))
      let parts = List<Bytes>.asSlice(&List<List<Bytes>>.asSlice(&kept)[at])
      let mut request = run NativeToolchain.request(clang)
      let mut part = usize.ONE
      while part < parts.length {
        run ChildProcess.addArgumentBytes(&mut request, Bytes.asSlice(&parts[part]))
        part = part + usize.ONE
      }
      let rerun = match move run Effect.result(submitted(&request, &mut progress.*)) {
        Result<i32, ProcessError | OutOfMemoryError | WriterError>.Success {value} => value
        Result<i32, ProcessError | OutOfMemoryError | WriterError>.Failure {error} => match move error {
          ProcessError unstarted => {
            drop unstarted
            return UnitBuild.Failed {status: run unstartedClang(clang, origin, &mut progress.*)}
          }
          OutOfMemoryError exhausted => { fail move exhausted }
          WriterError broken => { fail move broken }
        }
      }
      if rerun != 0 || !run CodegenCache.publish(&objects[missing[at]]) {
        if rerun == 0 {
          run Progress.clear(&mut progress.*)
          run writeError(b"silk: cannot write ")
          run writeError(Path.rawBytes(&objects[missing[at]]))
          run writeError(b"\n")
        }
        return UnitBuild.Failed {status: 1}
      }
    }
    at = at + usize.ONE
  }
  return UnitBuild.Objects {paths: move placed.objects}
}

// Whether `flags` holds `flag`.
fn hasFlag(flags: &[Bytes], flag: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < flags.length {
    if same(Bytes.asSlice(&flags[at]), flag) { return true }
    at = at + usize.ONE
  }
  return false
}

// The major version in Clang's `--version` output (`clang version 18.1.3 ...`), or `None` when the
// output names none.
fn clangMajor(output: &[u8]) -> Option<usize> {
  let marker = b"clang version "
  let mut start = usize.ZERO
  while start + marker.length <= output.length {
    let mut matched = true
    let mut at = usize.ZERO
    while matched && at < marker.length {
      if output[start + at] != marker[at] { matched = false }
      at = at + usize.ONE
    }
    if matched {
      let mut digit = start + marker.length
      let mut major = usize.ZERO
      let mut digits = usize.ZERO
      while digit < output.length && output[digit] >= 48 && output[digit] <= 57 {
        major = major * usize.add(0, 10) + u8.toUsize(output[digit] - 48)
        digits = digits + usize.ONE
        digit = digit + usize.ONE
      }
      if digits == usize.ZERO { return Option<usize>.none() }
      return Option<usize>.some(major)
    }
    start = start + usize.ONE
  }
  return Option<usize>.none()
}

// Runs one native tool: 0 when it exits successfully, else 1 after forwarding its diagnostics.
effect fn submitted(process: &ProcessRequest, progress: &mut Progress) -> i32
! ProcessError | OutOfMemoryError | WriterError
? &mut ChildProcess | &mut Allocator {
  let outcome = run ChildProcess.submit(process)
  if let Option<i32>.Some {value} = move ChildProcess.exitCode(&outcome) {
    if value == 0 { return 0 }
  }
  run Progress.clear(&mut progress.*)
  run writeError(ChildProcess.errorBytes(&outcome))
  return 1
}

/// A finished compilation: its process status, or for a test build that linked, the identities
/// of the discovered tests in catalog order.
union Compiled {
  Finished {status: i32},
  Tests {identities: List<Bytes>},
}

// How a command writes the language rejections and refusals of one analysis.
union DiagnosticFormat {
  /// One `SILK_BUILD_ERROR=` or `SILK_UNSUPPORTED_JSON=` line each, for the build harnesses.
  Machine,
  /// `path:line:col: error[CODE] message`, as the TypeScript CLI prints it, with each path
  /// relative to the directory `root` when it lies under it (see [`diagnosticRoot`]) and absolute
  /// otherwise, or always absolute when `root` is empty.
  Human {root: Bytes},
  /// One JSON object per line, naming the analysis `target`.
  Json {target: Bytes},
}

// The analysis state a build or check holds once its profile is assembled.
union Prepared {
  Ready {analysis: Analysis},
  Finished {status: i32},
}

// The path `path` holds, borrowed.
fn borrowedPath(path: &Option<Path>) -> Option<&Path> {
  return match &path.* {
    Option<Path>.Some {value} => Option<&Path>.some(&value)
    Option<Path>.None => Option<&Path>.none()
  }
}

// Loads the program rooted at `sourcePath` (within `manifest`'s package when given), publishes
// every module reachable through imports, and assembles the final profile with `bindings`. A test
// analysis is rooted at the bundled runner. A refused profile is reported in `format` and answers
// its status instead, appended to `out`.
effect fn prepare(sourcePath: &Path, manifest: Option<&Path>, standardLibrary: Option<Path>, profile: &InitialProfile, bindings: List<Supplied>, testing: bool, revisable: bool, alias: Option<&[u8]>, imports: Option<&Path>, compiler: &Option<Bytes>, format: &DiagnosticFormat, out: &mut Bytes, progress: &mut Progress) -> Prepared
! ApplicationError | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  // A refused binding names its manifest, which `sources` takes over.
  let mut manifestFile = Bytes.make()
  if let Option<&Path>.Some {value} = &manifest { manifestFile = run Bytes.copy(Path.rawBytes(value)) }
  // The bindings are moved into assembly; a refused one is named from these copies.
  let boundParameters = run boundNames(&bindings, true)
  let boundModules = run boundNames(&bindings, false)
  let boundTiers = run tiersOf(&bindings)
  run Progress.begin(&mut progress.*, ProgressPhase.Load, usize.ZERO)
  // A package that cannot be loaded, such as one whose exports name no module, ends its load
  // row as failed and is reported here, so its unit still ends with its own `Failed` line.
  // A cached build reads an unchanged file's imports from the summaries the last load left below
  // `imports`, instead of parsing the file before the store needs it.
  let mut summaries = Option<ImportSummaries>.none()
  if let Option<&Path>.Some {value: directory} = &imports {
    if let Option<Bytes>.Some {value: stamped} = &compiler.* {
      summaries = Option<ImportSummaries>.some(run SemanticCache.openImports(directory, Bytes.asSlice(&stamped)))
    }
  }
  let attempted = run Effect.result(Analyses.open(sourcePath, move manifest, move standardLibrary, profile, move bindings, testing, revisable, move alias, move summaries))
  let opened = match move attempted {
    Result<Opened, FileError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
    Result<Opened, FileError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError>.Failure {error} => {
      run Progress.refuse(&mut progress.*, usize.ONE)
      return Prepared.Finished {status: run report(move error)}
    }
  }
  return match move opened {
    Opened.Ready {analysis: ready} => {
      let mut analysis = move ready
      if let Option<&Path>.Some {value: directory} = &imports {
        if let Option<ImportSummaries>.Some {value: held} = move ModuleSourceFiles.takeSummaries(&mut analysis.sources) {
          run SemanticCache.saveImports(directory, &held)
        }
      }
      // CI sets SILK_VERIFY_MIR so every build and check it runs also verifies the lowered MIR.
      if let Option<Bytes>.Some {value: _} = move run HostInput.variableNamed("SILK_VERIFY_MIR") {
        Semantic.selectMirVerification(&mut analysis.store)
      }
      if Progress.enabled(&progress.*) {
        let mut loaded = Bytes.make()
        run Progress.appendCount(&mut loaded, ModuleSourceFiles.loadedCount(&analysis.sources))
        run Bytes.append(&mut loaded, b" modules, ")
        run Progress.appendCount(&mut loaded, List<ModuleId>.length(&analysis.rootPackage))
        run Bytes.append(&mut loaded, b" in package")
        run Progress.end(&mut progress.*, Bytes.asSlice(&loaded))
      }
      return Prepared.Ready {analysis: move analysis}
    }
    Opened.InvalidProfile => run invalidBuildProfile()
    Opened.Refused {sources, store, refusal} => {
      // The refusal and the syntax errors read so far are its problems.
      let syntax = run Semantic.syntaxRejections(&store)
      run Progress.refuse(&mut progress.*, usize.ONE + List<Shared<Rejection>>.length(&syntax))
      return run refusedProfile(&sources, &store, move refusal, List<Bytes>.asSlice(&boundParameters),
      List<Bytes>.asSlice(&boundModules), List<Tier>.asSlice(&boundTiers), Bytes.asSlice(&manifestFile), format, &mut out.*)
    }
  }
}

// Reports why the final profile was refused, after the syntax errors of the modules read so far,
// and answers the status.
effect fn refusedProfile(sources: &ModuleSources, store: &Semantic, refusal: Refusal, boundParameters: &[Bytes], boundModules: &[Bytes], boundTiers: &[Tier], manifestFile: &[u8], format: &DiagnosticFormat, out: &mut Bytes) -> Prepared
! FileError | OutOfMemoryError | WriterError
? &mut FileSystem | &mut Allocator {
  match move refusal {
    // A rejected `param` declaration is reported where it is written, after the syntax errors
    // of the modules read so far, which it would otherwise hide.
    Refusal.ParameterRejected {rejection} => {
      let syntaxStatus = run reportedSyntax(store, sources, format, &mut out.*)
      return Prepared.Finished {status: worse(syntaxStatus, run reportRejection(sources, &rejection, format, &mut out.*))}
    }
    Refusal.Shape {problem} => {
      run writeError(b"silk: error[SEM0214] invalid package parameter declaration: ")
      run writeError(shapeProblemText(problem))
      run writeError(b"\n")
    }
    Refusal.DefaultRejected {rejection} => {
      let syntaxStatus = run reportedSyntax(store, sources, format, &mut out.*)
      return Prepared.Finished {status: worse(syntaxStatus, run reportRejection(sources, &rejection, format, &mut out.*))}
    }
    Refusal.Profile {problem} => {
      run writeError(b"silk: error[SEM0214] invalid package parameter profile: ")
      run writeError(profileProblemText(problem))
      run writeError(b"\n")
    }
    Refusal.Binding {error: refused} => {
      let line = run bindingProblem(&refused, boundParameters, boundModules, boundTiers, manifestFile)
      run writeError(Bytes.asSlice(&line))
    }
    Refusal.InputMismatch => {
      run writeError(b"silk: invalid package parameter profile\n")
    }
  }
  return Prepared.Finished {status: worse(1, run reportedSyntax(store, sources, format, &mut out.*))}
}

// Appends the syntax errors of every module parsed so far to `out` in `format` and answers their
// worst status, 0 when there are none. A build refused before analysis still reports them.
effect fn reportedSyntax(store: &Semantic, sources: &ModuleSources, format: &DiagnosticFormat, out: &mut Bytes) -> i32
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let syntax = run Semantic.syntaxRejections(store)
  let malformed = List<Shared<Rejection>>.asSlice(&syntax)
  let mut status = 0
  let mut at = usize.ZERO
  while at < malformed.length {
    status = worse(status, run reportRejection(sources, &malformed[at], format, &mut out.*))
    at = at + usize.ONE
  }
  return status
}

// The line that reports a refused package-parameter binding: the binding's parameter and module,
// located at the line of `manifest` whose `[config]` key writes it when one does.
effect fn bindingProblem(refused: &BindingError, parameters: &[Bytes], modules: &[Bytes], tiers: &[Tier], manifest: &[u8]) -> Bytes
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut line = Bytes.make()
  let mut parameter = Bytes.make()
  let mut module = Bytes.make()
  let mut tier = Tier.Project
  if refused.ordinal < parameters.length && refused.ordinal < modules.length && refused.ordinal < tiers.length {
    parameter = run Bytes.copy(Bytes.asSlice(&parameters[refused.ordinal]))
    module = run Bytes.copy(Bytes.asSlice(&modules[refused.ordinal]))
    tier = tiers[refused.ordinal]
  }
  if manifest.length > usize.ZERO {
    run Bytes.append(&mut line, manifest)
    let manifestPath = run Path.fromBytes(manifest)
    let read = run Effect.result(FileSystem.readFile(&manifestPath))
    match move read {
      Result<Bytes, FileError | OutOfMemoryError>.Success {value: text} => {
        let parsed = run Effect.result(Toml.parse(Bytes.asSlice(&text)))
        if let Result<TomlValue, TomlError | OutOfMemoryError>.Success {value: document} = move parsed {
          if let Option<Bytes>.Some {value: key} = move run configKey(&document, Bytes.asSlice(&module), Bytes.asSlice(&parameter), tier) {
            let found = ManifestText.keyLine(Bytes.asSlice(&text), Bytes.asSlice(&key))
            if found > usize.ZERO {
              run Bytes.append(&mut line, b":")
              run JsonText.appendDecimal(&mut line, found)
            }
          }
        }
      }
      Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
        FileError unreadable => { drop unreadable }
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
    run Bytes.append(&mut line, b": ")
  } else {
    run Bytes.append(&mut line, b"silk: ")
  }
  run Bytes.append(&mut line, b"error[SEM0214] invalid package parameter binding: ")
  let reason: &'static [u8] = match refused.code {
    BindingIssue.ProhibitedProvenance => b"the binding of `{p}` has a secret, physical or runtime origin"
    BindingIssue.UnknownParameter => b"module `{m}` declares no package parameter `{p}`"
    BindingIssue.PrivateParameter => b"package parameter `{p}` is not `pub`, so it cannot be bound"
    BindingIssue.WrongType => b"the value bound to `{p}` does not have its parameter's type"
    BindingIssue.SameTierConflict => b"package parameter `{p}` is bound more than once"
  }
  let mut at = usize.ZERO
  while at < reason.length {
    if at + 2 < reason.length && reason[at] == 123 && reason[at + 2] == 125 && reason[at + 1] == 112 {
      run Bytes.append(&mut line, Bytes.asSlice(&parameter))
      at = at + 3
    } else if at + 2 < reason.length && reason[at] == 123 && reason[at + 2] == 125 && reason[at + 1] == 109 {
      run Bytes.append(&mut line, Bytes.asSlice(&module))
      at = at + 3
    } else {
      run Bytes.append(&mut line, &[reason[at]])
      at = at + usize.ONE
    }
  }
  run Bytes.append(&mut line, b"\n")
  return move line
}

// The `[config]` key of `document` that binds `parameter` of `module` (as `main.silk`): under
// `[config]` for a project-tier binding, else under the first profile whose `config` writes it.
// `None` when the manifest writes no such key, as for a `--profile-input` binding.
effect fn configKey(document: &TomlValue, module: &[u8], parameter: &[u8], tier: Tier) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  if module.length < 5 || parameter.length == usize.ZERO { return Option<Bytes>.none() }
  let mut path = run Bytes.copy(b"config.")
  let stem = Slice.view<u8>(module, usize.ZERO, module.length - 5)
  let mut at = usize.ZERO
  while at < stem.length {
    if stem[at] == 47 { run Bytes.append(&mut path, b".") } else { run Bytes.append(&mut path, &[stem[at]]) }
    at = at + usize.ONE
  }
  run Bytes.append(&mut path, b".")
  run Bytes.append(&mut path, parameter)
  if tier == Tier.Project {
    if writesKey(document, Bytes.asSlice(&path)) { return Option<Bytes>.some(move path) }
    return Option<Bytes>.none()
  }
  let profiles = match move Toml.field(document, "profiles") {
    Option<&TomlValue>.Some {value} => value
    Option<&TomlValue>.None => { return Option<Bytes>.none() }
  }
  if let TomlValue.Table {entries, kind: _} = &profiles.* {
    let boxed = Box<List<TomlChild>>.get(&entries)
    let children = List<TomlChild>.asSlice(&boxed[0])
    let mut index = usize.ZERO
    while index < children.length {
      if let TomlChild.Member {entry} = &children[index] {
        if writesKey(&entry.value, Bytes.asSlice(&path)) {
          let mut key = run Bytes.copy(b"profiles.")
          run Bytes.append(&mut key, String.ownedUtf8Bytes(&entry.key))
          run Bytes.append(&mut key, b".")
          run Bytes.append(&mut key, Bytes.asSlice(&path))
          return Option<Bytes>.some(move key)
        }
      }
      index = index + usize.ONE
    }
  }
  return Option<Bytes>.none()
}

// Whether `table` holds the dotted key `path`.
fn writesKey(table: &TomlValue, path: &[u8]) -> bool {
  let mut current = table
  let mut start = usize.ZERO
  while start <= path.length {
    let mut end = start
    while end < path.length && path[end] != 46 { end = end + usize.ONE }
    let segment = Slice.view<u8>(path, start, end - start)
    current = match move Toml.field(current, unsafe String.fromUtf8Unchecked(segment)) {
      Option<&TomlValue>.Some {value} => value
      Option<&TomlValue>.None => { return false }
    }
    start = end + usize.ONE
  }
  return true
}

// The tier of each binding, in binding order.
effect fn tiersOf(bindings: &List<Supplied>) -> List<Tier> ! OutOfMemoryError ? &mut Allocator {
  let mut tiers = List<Tier>.make()
  let supplied = List<Supplied>.asSlice(bindings)
  let mut at = usize.ZERO
  while at < supplied.length {
    run List<Tier>.append(&mut tiers, supplied[at].tier)
    at = at + usize.ONE
  }
  return move tiers
}

// The parameter (or, when not `parameters`, module) each binding names, in binding order.
effect fn boundNames(bindings: &List<Supplied>, parameters: bool) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut names = List<Bytes>.make()
  let supplied = List<Supplied>.asSlice(bindings)
  let mut at = usize.ZERO
  while at < supplied.length {
    if parameters {
      run List<Bytes>.append(&mut names, run Bytes.copy(Bytes.asSlice(&supplied[at].parameter)))
    } else {
      run List<Bytes>.append(&mut names, run Bytes.copy(Bytes.asSlice(&supplied[at].module)))
    }
    at = at + usize.ONE
  }
  return move names
}

// Why the root package's `param` declarations cannot form a parameter schema.
fn shapeProblemText(problem: ShapeProblem) -> &'static [u8] {
  return match problem {
    ShapeProblem.InvalidHeader => b"a parameter must be a module-level `param name: Type = default` with a default value"
    ShapeProblem.UnsupportedType => b"a parameter's type is not supported for package parameters"
    ShapeProblem.InvalidExtent => b"a parameter's array extent is invalid"
    ShapeProblem.RecursiveShape => b"a parameter's type is recursive"
    ShapeProblem.InvalidMember => b"a parameter's type has a member that cannot be a parameter"
  }
}

// Why the selected parameter values cannot form the build's final profile.
fn profileProblemText(problem: ProfileProblem) -> &'static [u8] {
  return match problem {
    ProfileProblem.MissingParameter => b"a parameter has neither a default nor a binding"
    ProfileProblem.DuplicateParameter => b"a parameter is bound more than once"
    ProfileProblem.UnknownParameter => b"a binding names no declared parameter"
    ProfileProblem.WrongType => b"a default or binding has the wrong type"
    ProfileProblem.InvalidShape => b"a value does not fit its parameter's type"
    ProfileProblem.PredicateNotChecked => b"a parameter's `where` predicate could not be checked"
    ProfileProblem.ResourceSafetyNotChecked => b"enum, struct, union and optional parameter types are not supported yet"
  }
}

// The Clang arguments of the profile facts LLVM text does not carry: each selected CPU feature, a
// CPU model other than the default, a large code model, and for a linked executable a static,
// non-position-independent link.
effect fn clangProfileFlags(profile: &InitialProfile, maxMemory: Option<usize>, target: &Target, linked: bool) -> List<Bytes>
! OutOfMemoryError ? &mut Allocator {
  let mut flags = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < Target.featureCount(target) {
    let feature = Target.feature(target, at)
    let selected = match move InitialProfile.contains(profile, b"cpu-features", feature) {
      Option<bool>.Some {value} => value
      Option<bool>.None => false
    }
    if selected {
      let mut enabled = run Bytes.copy(b"+")
      run Bytes.append(&mut enabled, feature)
      run List<Bytes>.append(&mut flags, run Bytes.copy(b"-Xclang"))
      run List<Bytes>.append(&mut flags, run Bytes.copy(b"-target-feature"))
      run List<Bytes>.append(&mut flags, run Bytes.copy(b"-Xclang"))
      run List<Bytes>.append(&mut flags, move enabled)
    }
    at = at + usize.ONE
  }
  if let Option<&[u8]>.Some {value: cpu} = move InitialProfile.text(profile, b"cpu") {
    if !same(cpu, Target.defaultCpu(target)) {
      let mut architecture = run Bytes.copy(b"-march=")
      run Bytes.append(&mut architecture, cpu)
      run List<Bytes>.append(&mut flags, move architecture)
    }
  }
  if let Option<&[u8]>.Some {value: model} = move InitialProfile.text(profile, b"code-model") {
    if same(model, b"large") { run List<Bytes>.append(&mut flags, run Bytes.copy(b"-mcmodel=large")) }
  }
  if same(Target.objectFormat(target), b"wasm") {
    run wasmProfileFlags(&mut flags, profile, move maxMemory, linked)
    return move flags
  }
  if let Option<&[u8]>.Some {value: link} = move InitialProfile.text(profile, b"link") {
    // A static executable is never position independent, so its code is not either.
    if linked && same(link, b"static") {
      run List<Bytes>.append(&mut flags, run Bytes.copy(b"-static"))
      run List<Bytes>.append(&mut flags, run Bytes.copy(b"-fno-pic"))
    }
  }
  return move flags
}

// The wasm32 flags of a profile. Every profile compiles with bulk memory, which the runtime's copies
// and fills need and Clang's generic wasm CPU enables only from Clang 19. A multi-threaded profile
// also compiles with atomics, and links one shared memory the host imports into every thread's
// instance, with the wasi-threads entry exported. A shared memory needs a maximum, which
// `max-memory` sets and is otherwise 1 GiB; a module with its own memory has a maximum only when
// `maxMemory` sets one.
effect fn wasmProfileFlags(flags: &mut List<Bytes>, profile: &InitialProfile, maxMemory: Option<usize>, linked: bool) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut threaded = false
  if let Option<&[u8]>.Some {value: threading} = move InitialProfile.text(profile, b"threading") {
    threaded = same(threading, b"multi")
  }
  run List<Bytes>.append(&mut flags.*, run Bytes.copy(b"-mbulk-memory"))
  if threaded { run List<Bytes>.append(&mut flags.*, run Bytes.copy(b"-matomics")) }
  if !linked { return () }
  // A 1 MiB main stack, the size the runtime gives each new thread.
  run List<Bytes>.append(&mut flags.*, run Bytes.copy(b"-Wl,-z,stack-size=1048576"))
  let mut limit = move maxMemory
  if threaded {
    run List<Bytes>.append(&mut flags.*, run Bytes.copy(b"-Wl,--shared-memory"))
    run List<Bytes>.append(&mut flags.*, run Bytes.copy(b"-Wl,--import-memory"))
    run List<Bytes>.append(&mut flags.*, run Bytes.copy(b"-Wl,--export=wasi_thread_start"))
    if let Option<usize>.None = &limit { limit = Option<usize>.some(usize.add(0, 1073741824)) }
  }
  if let Option<usize>.Some {value: bytes} = move limit {
    let mut flag = run Bytes.copy(b"-Wl,--max-memory=")
    run appendDecimal(&mut flag, bytes)
    run List<Bytes>.append(&mut flags.*, move flag)
  }
  return ()
}

// Gives up `value` without dropping it, for a process about to exit: what it owns is left for the
// exit to return.
effect fn abandonValue<T>(value: T) -> () ! OutOfMemoryError ? &mut Allocator {
  let layout = Layout.of<T>()
  let recipe = Allocator.allocate(move layout)
  let allocation = run recipe
  unsafe {
    let mut buffer = RawBuffer.from<T>(move allocation, usize.ONE)
    Slot.write<T>(RawBuffer.slot<T>(&mut buffer, usize.ZERO), move value)
  }
  return ()
}

// Appends `value` in decimal.
effect fn appendDecimal(text: &mut Bytes, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 { run appendDecimal(&mut text.*, usize.divide(value, 10)) }
  return run Bytes.append(&mut text.*, &[usize.toU8(48 + usize.remainder(value, 10))])
}

effect fn build(sourcePath: &Path, manifest: Option<&Path>, cacheDirectory: Option<&Path>, output: &Path, display: &Path, form: Form, stage: Stage, standardLibrary: Option<Path>, profile: InitialProfile, maxMemory: Option<usize>, bindings: List<Supplied>, supplyRequest: &SupplyRequest, testing: bool, stats: bool, clang: &Option<Bytes>, heading: &Option<Bytes>, alias: Option<&[u8]>, abandon: bool, progress: &mut Progress) -> Compiled
! ApplicationError | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  let zone = Profiler.zone(b"build")
  let target = Target.forId(Target.id(InitialProfile.target(&profile)))
  let mut world = WasiTools.World {wit: Option<Path>.none(), name: Bytes.make()}
  if Target.id(&target) == TargetId.Wasm32Wasip2 {
    let directory = match move run Path.parent(sourcePath) {
      Option<Path>.Some {value} => move value
      Option<Path>.None => { fail InvalidSourceRoot {} }
    }
    let mut selectedManifest = Option<Bytes>.none()
    if let Option<&Path>.Some {value: path} = &manifest {
      selectedManifest = Option<Bytes>.some(run Bytes.copy(Path.rawBytes(path)))
    }
    if let Option<Project>.Some {value: project} = move run locateProject(&directory, &selectedManifest) {
      if testing { world = run WasiTools.commandWorld(&standardLibrary) }
      else { world = run WasiTools.world(&project, &standardLibrary) }
    } else { return Compiled.Finished {status: 2} }
  }
  let optimization = match move InitialProfile.text(&profile, b"optimization") {
    Option<&[u8]>.Some {value} => run Bytes.copy(value)
    Option<&[u8]>.None => run invalidBuildProfile()
  }
  let debug = match move InitialProfile.flag(&profile, b"debug") {
    Option<bool>.Some {value} => value
    Option<bool>.None => run invalidBuildProfile()
  }
  let relocation = match move InitialProfile.text(&profile, b"relocation") {
    Option<&[u8]>.Some {value} => run Bytes.copy(value)
    Option<&[u8]>.None => run invalidBuildProfile()
  }
  let libc = match move InitialProfile.text(&profile, b"libc") {
    Option<&[u8]>.Some {value} => run Bytes.copy(value)
    Option<&[u8]>.None => run invalidBuildProfile()
  }
  let deployment = match move InitialProfile.text(&profile, b"deployment") {
    Option<&[u8]>.Some {value} => run Bytes.copy(value)
    Option<&[u8]>.None => Bytes.make()
  }
  let profileFlags = run clangProfileFlags(&profile, move maxMemory, &target, form == Form.Executable && stage == Stage.Final)
  let mut refused = Bytes.make()
  // Whether this build's `[<target>]` heading has been written before its diagnostics.
  let mut headed = false
  // A project build notes each body it could not borrow-check. Both forms print diagnostics as
  // `check` does; under SILK_RECEIPTS the single-source form instead writes borrow-check counts
  // as receipts and diagnostics as `SILK_BUILD_ERROR` records for the corpus harness and
  // self-build.
  let receipts = match &manifest {
    Option<&Path>.Some {..} => false
    Option<&Path>.None => true
  }
  // The single-source borrow-check counts are receipts for the corpus harness and the self-build,
  // which set SILK_RECEIPTS; without it a successful build prints only its own output.
  let mut counted = false
  if receipts {
    if let Option<Bytes>.Some {value} = move run HostInput.variableNamed("SILK_RECEIPTS") {
      counted = Bytes.length(&value) > usize.ZERO
    }
  }
  let mut root = Bytes.make()
  if let Option<&Path>.Some {value} = &manifest { root = run diagnosticRoot(value) }
  let mut machine = DiagnosticFormat.Human {root: move root}
  if counted { machine = DiagnosticFormat.Machine }
  // A project build checks on a revisable store that reads and writes the cache file `silk check`
  // keeps for the same target and profile, so an unchanged module's checks are reused and the
  // last build's record replays (see `Semantic.replayBuild`).
  let mut compiler = Option<Bytes>.none()
  if let Option<&Path>.Some {..} = &cacheDirectory { compiler = run CacheStamp.compiler() }
  let mut revisable = false
  if let Option<Bytes>.Some {..} = &compiler { revisable = true }
  let mut imports = Option<&Path>.none()
  if let Option<&Path>.Some {value: directory} = &cacheDirectory { imports = Option<&Path>.some(directory) }
  // The cache file is read and decoded while the sources load.
  let mut prefetched = Option<SemanticCache.Prefetch>.none()
  if let Option<&Path>.Some {value: directory} = &cacheDirectory {
    if revisable { prefetched = run SemanticCache.prefetch(directory, true) }
  }
  let prepared = run prepare(sourcePath, move manifest, move standardLibrary, &profile, move bindings, testing, revisable, move alias, move imports, &compiler, &machine, &mut refused, &mut progress.*)
  run writeHeaded(heading, &mut headed, Bytes.asSlice(&refused), &mut progress.*)
  let analysis = match move prepared {
    Prepared.Ready {analysis} => move analysis
    Prepared.Finished {status} => { return Compiled.Finished {status: status} }
  }
  let Analysis {sources, store: analyzed, request: requested, rootPackage, checked, identity, runtime} = move analysis
  let mut store = move analyzed
  let mut request = move requested
  let mut cache = Option<CacheFile>.none()
  if let Option<&Path>.Some {value: directory} = &cacheDirectory {
    if let Option<Bytes>.Some {value: stamped} = &compiler {
      cache = run SemanticCache.openPrefetched(&mut store, &request, directory, Bytes.asSlice(&stamped), false, true, move prefetched)
    }
  }
  let selectedRuntime: Option<&ModuleId> = match &runtime {
    Option<ModuleId>.Some {value} => Option<&ModuleId>.some(&value)
    Option<ModuleId>.None => Option<&ModuleId>.none()
  }
  let analyzing = Profiler.zone(b"buildArtifact")
  Semantic.selectProgress(&mut store, Intrinsic.replace(progress.*, Progress.off()))
  // A debug executable compiles each codegen unit apart, so an edit recompiles only the units it
  // changes (see `compileUnits`); an optimized one stays one module for cross-module inlining.
  let split = form == Form.Executable && stage == Stage.Final && same(Bytes.asSlice(&optimization), b"none")
    && !same(Target.objectFormat(&target), b"wasm")
  Semantic.selectCodegenUnits(&mut store, split)
  // Clang compiles anything but `speed` at -O0 (see `compileIrIn`).
  Semantic.selectFastPathIr(&mut store, !same(Bytes.asSlice(&optimization), b"speed"))
  let compiled = run Semantic.buildArtifact(&mut store, &mut request, move selectedRuntime, List<ModuleId>.asSlice(&rootPackage),
    List<ModuleId>.asSlice(&checked), staticClosureNodes)
  progress.* = Semantic.takeProgress(&mut store)
  drop analyzing
  // A reached module's selected imports are checked whole as well, used or not (IMPORT-003). They
  // are checked before the cache image is written, so it holds each module whose imports are clean.
  let importRejected = run Semantic.importRejections(&mut store, &mut request)
  // A build's units are the packs its cache keeps; the image written next names them, and no
  // others are needed after it.
  // A copy of the process writes the image while the units compile and link, and the build
  // returns without waiting for it.
  if let Option<CacheFile>.Some {value: file} = &cache {
    if let BackendBuild.Module {units, ..} = &compiled { run SemanticCache.storePacks(&file, List<CodegenUnit>.asSlice(&units)) }
    run SemanticCache.saveDetached(&mut store, &file)
    if let BackendBuild.Module {units, ..} = &compiled { run SemanticCache.prunePacks(&file, List<CodegenUnit>.asSlice(&units)) }
    if let Option<&Path>.Some {value: directory} = &cacheDirectory { run saveParsed(directory, &sources, &store) }
  }
  let packs = run Semantic.takePacks(&mut store)
  // The walk leaves its last phase open: emission when it reached it, else checking.
  match &compiled {
    BackendBuild.Module {..} => {
      run Progress.end(&mut progress.*, b"")
      run Progress.borrowRow(&mut progress.*)
    }
    BackendBuild.Unsupported {gaps} => { run Progress.refuse(&mut progress.*, List<Shared<Gap>>.length(&gaps)) }
    BackendBuild.Rejected {further, ..} => { run Progress.refuse(&mut progress.*, usize.ONE + List<Shared<Rejection>>.length(&further)) }
  }
  if stats {
    run writeStatistics(&Semantic.statistics(&store))
    run writeDeferredTemplates(Semantic.deferredStaticTemplates(&store))
  }
  let missed = ModuleSourceFiles.missedModule(&sources, Semantic.sourceEvents(&store))
  if missed != usize.MAX {
    let mut message = run Bytes.copy(b"silk: internal error: the build read ")
    let event = &Semantic.sourceEvents(&store)[missed]
    run ModuleId.appendPackage(&event.module, &mut message)
    run Bytes.append(&mut message, b":")
    run ModuleId.appendPath(&event.module, &mut message)
    run Bytes.append(&mut message, b" outside its preloaded import graph\n")
    run writeError(Bytes.asSlice(&message))
    return Compiled.Finished {status: 1}
  }
  // A loaded module is parsed whole: its syntax errors reject the build even where no declaration
  // of it was demanded (MODULE-004), before any artifact is written.
  let syntax = run Semantic.syntaxRejections(&store)
  let malformed = List<Shared<Rejection>>.asSlice(&syntax)
  if malformed.length > usize.ZERO {
    let mut at = usize.ZERO
    let mut failureStatus = 2
    while at < malformed.length {
      if diagnosticStatus(&malformed[at]) == 1 { failureStatus = 1 }
      run writeRejection(heading, &mut headed, &sources, &malformed[at], &machine, &mut progress.*)
      at = at + usize.ONE
    }
    return Compiled.Finished {status: failureStatus}
  }
  let mut imported = Bytes.make()
  let mut reportedImports = List<ReportedSite>.make()
  let importStatus = run reportedImportRejections(List<Shared<Rejection>>.asSlice(&importRejected), &sources, &machine, &mut imported, &mut reportedImports)
  run writeHeaded(heading, &mut headed, Bytes.asSlice(&imported), &mut progress.*)
  if importStatus != 0 { return Compiled.Finished {status: importStatus} }
  let mut status = 0
  match move compiled {
    BackendBuild.Module {text, unchecked, plan, units: assembled} => {
      let mut units = move assembled
      // Emit zero too: absence of a receipt cannot distinguish a fully checked build from a
      // missing measurement. The corpus harness records this line for every successful program.
      if counted { run writeBorrowGap(b"SILK_GAP borrow-check: ", List<usize>.asSlice(&unchecked)) }
      // The emitted count covers only reached instances. Every root-package body was checked as
      // well, reached or not, so its unchecked count shows a body no build path reaches, and each
      // such body of a build is named, so the corpus harness can tell which diagnostics it covers.
      // A test runner's thousands of bodies would only bury its results, so it keeps the count.
      if counted { run writeRootBorrowGap(Semantic.uncheckedRootBodies(&store), !testing) }
      // With --stats, name each counted body, so two compilers' lists can be diffed.
      if stats {
        let bodies = run EmissionPlan.uncheckedBodies(&plan)
        let lines = List<Bytes>.asSlice(&bodies)
        let mut line = usize.ZERO
        while line < lines.length {
          let mut text = run Bytes.copy(b"silk-stats unchecked\t")
          run Bytes.append(&mut text, Bytes.asSlice(&lines[line]))
          run Bytes.append(&mut text, b"\n")
          run writeError(Bytes.asSlice(&text))
          line = line + usize.ONE
        }
      }
      // A debug build names each content-derived symbol beside its output; the IR is unchanged.
      if debug {
        let mut mapPath = run Bytes.copy(Path.rawBytes(output))
        run Bytes.append(&mut mapPath, b".symbols")
        let mapFile = run Path.fromBytes(Bytes.asSlice(&mapPath))
        let map = run EmissionPlan.symbolMap(&plan)
        // An unchanged map is left alone, so a build that changes nothing writes nothing.
        if !run holds(&mapFile, Bytes.asSlice(&map)) { run FileSystem.writeFile(&mapFile, Bytes.asSlice(&map)) }
      }
      if stage == Stage.LlvmIr {
        let printed = run BitcodeText.printFragments(Bytes.asSlice(&text))
        run FileSystem.writeFile(output, Bytes.asSlice(&printed))
        if receipts { run reportCompiled(display, sourcePath, output, &target, EmissionPlan.symbolCount(&plan)) }
        return Compiled.Finished {status: 0}
      }
      // Without a runtime nothing starts the program but a C `main` the application exports or a
      // declared link input defines, so a link that would miss it is refused before Clang runs.
      let started = match &runtime {
        Option<ModuleId>.Some {..} => true
        Option<ModuleId>.None => false
      }
      // Units that only the cache asked for are not compiled apart.
      if !split { units = List<CodegenUnit>.make() }
      if form == Form.Executable && stage == Stage.Final && !started && !same(Target.objectFormat(&target), b"wasm") &&
        ModuleSourceFiles.nativeLinkInputs(&sources).length == usize.ZERO && !definesMain(Bytes.asSlice(&text))
        && !unitsDefineMain(List<CodegenUnit>.asSlice(&units), List<BuildRecord.PackBody>.asSlice(&packs)) {
        run writeHeaded(heading, &mut headed, b"silk: an executable built with runtime = { kind = \"none\" } has no `main`; export one, as `export \"C\" fn start() -> i32 as \"main\"` does, or select a runtime\n", &mut progress.*)
        return Compiled.Finished {status: 2}
      }
      // Only a link consumes a platform supply; compiling to an object or an intermediate stage
      // needs no SDK, so a cross-target object never runs discovery.
      let mut supply = Option<Supply>.none()
      if form == Form.Executable && stage == Stage.Final {
        let resolved = run Effect.result(PlatformSupplies.resolve(&target, &hostTarget(), Bytes.asSlice(&libc), Bytes.asSlice(&deployment), supplyRequest))
        supply = match move resolved {
          Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Success {value} => move value
          Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Failure {error} => match move error {
            SupplyError unavailable => {
              run reportSupply(&unavailable)
              return Compiled.Finished {status: 2}
            }
            FileError failed => { fail move failed }
            HostInputError failed => { fail move failed }
            OutOfMemoryError exhausted => { fail move exhausted }
          }
        }
      }
      let linking = Profiler.zone(b"compileIr")
      run Progress.begin(&mut progress.*, ProgressPhase.Link, usize.ZERO)
      run Progress.show(&mut progress.*, b"clang")
      status = run compileIr(
        &text, List<CodegenUnit>.asSlice(&units), List<BuildRecord.PackBody>.asSlice(&packs), output, form, stage, Bytes.asSlice(&optimization), debug, Bytes.asSlice(&relocation),
        List<Bytes>.asSlice(&profileFlags), &target,
        &supply, ModuleSourceFiles.nativeLinkInputs(&sources), clang, &world, started, &mut progress.*,
      )
      if status == 0 {
        run Progress.end(&mut progress.*, b"clang")
      } else {
        run Progress.refuse(&mut progress.*, usize.ZERO)
      }
      if status == 0 {
        if receipts { run reportCompiled(display, sourcePath, output, &target, EmissionPlan.symbolCount(&plan)) }
      }
    }
    BackendBuild.Unsupported {gaps} => {
      // The single-source form keeps the machine record the corpus harness parses.
      let mut message = Bytes.make()
      if receipts {
        message = run gapSummary(List<Shared<Gap>>.asSlice(&gaps))
      } else {
        let unreported = List<ReportedSite>.make()
        message = run gapLines(&sources, List<Shared<Gap>>.asSlice(&gaps), List<ReportedSite>.asSlice(&unreported), humanRoot(&machine))
      }
      run writeHeaded(heading, &mut headed, Bytes.asSlice(&message), &mut progress.*)
      status = 2
    }
    BackendBuild.Rejected {first, further, gaps} => {
      // Every refusal the walk reached, first one first, then the gaps reached beside them.
      status = diagnosticStatus(&first)
      let reported = match move run entryRejection(&mut store, &mut request, &sources, &identity, &runtime, &first) {
        Option<Shared<Rejection>>.Some {value} => move value
        Option<Shared<Rejection>>.None => move first
      }
      let mut written = List<ReportedSite>.make()
      run record(&mut written, &reported)
      run writeRejection(heading, &mut headed, &sources, &reported, &machine, &mut progress.*)
      let others = List<Shared<Rejection>>.asSlice(&further)
      let mut at = usize.ZERO
      while at < others.length {
        if diagnosticStatus(&others[at]) == 1 { status = 1 }
        let other = match move run entryRejection(&mut store, &mut request, &sources, &identity, &runtime, &others[at]) {
          Option<Shared<Rejection>>.Some {value} => move value
          Option<Shared<Rejection>>.None => Shared<Rejection>.clone(&others[at])
        }
        run record(&mut written, &other)
        run writeRejection(heading, &mut headed, &sources, &other, &machine, &mut progress.*)
        at = at + usize.ONE
      }
      if List<Shared<Gap>>.length(&gaps) > usize.ZERO {
        let mut summary = Bytes.make()
        if receipts {
          summary = run gapSummary(List<Shared<Gap>>.asSlice(&gaps))
        } else {
          summary = run gapLines(&sources, List<Shared<Gap>>.asSlice(&gaps), List<ReportedSite>.asSlice(&written), humanRoot(&machine))
        }
        run writeHeaded(heading, &mut headed, Bytes.asSlice(&summary), &mut progress.*)
      }
    }
  }
  if !testing || status != 0 {
    if !abandon { return Compiled.Finished {status: status} }
    // The process exits right after this build, and its exit returns the store's pages at once,
    // so they are not freed one by one first.
    run abandonValue(move store)
    run abandonValue(move sources)
    run abandonValue(move packs)
    return Compiled.Finished {status: status}
  }
  // The linked runner iterates this same catalog; its identities bind the plan (TEST-004).
  let catalog = match move run Semantic.demandTests(&mut store, &mut request) {
    Result<Shared<TestCatalog>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<TestCatalog>, Shared<Rejection>>.Failure {error} => {
      run writeRejection(heading, &mut headed, &sources, &error, &machine, &mut progress.*)
      return Compiled.Finished {status: diagnosticStatus(&error)}
    }
  }
  // Discovery reaches the test modules, whose selected imports are checked like the build's.
  let mut discovered = Bytes.make()
  let discoveredImports = run Semantic.importRejections(&mut store, &mut request)
  let discoveredImportStatus = run reportedImportRejections(List<Shared<Rejection>>.asSlice(&discoveredImports), &sources, &machine, &mut discovered, &mut reportedImports)
  run writeHeaded(heading, &mut headed, Bytes.asSlice(&discovered), &mut progress.*)
  if discoveredImportStatus != 0 { return Compiled.Finished {status: discoveredImportStatus} }
  return Compiled.Tests {identities: run Semantic.testIdentities(&catalog)}
}

// Appends selected import refusals to `out`; 0 when absent, 1 for a language rejection, 2 for
// uncoded coverage.
effect fn reportedImportRejections(listed: &[Shared<Rejection>], sources: &ModuleSources, format: &DiagnosticFormat, out: &mut Bytes, seen: &mut List<ReportedSite>) -> i32
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut status = 0
  let mut at = usize.ZERO
  while at < listed.length {
    // Each name an import selects answers for the same module path, so one refused module is
    // reached once per name; it is reported once.
    if !run repeated(&mut seen.*, &listed[at]) {
      let current = run reportRejection(sources, &listed[at], format, &mut out.*)
      if status != 1 { status = current }
    }
    at = at + usize.ONE
  }
  return status
}

// The code and location of one reported diagnostic.
struct ReportedSite {
  code: RejectionCode,
  module: ModuleId,
  span: Span,
  /// For a dependency cycle, a key of its members independent of where the cycle was entered;
  /// zero otherwise. Every member of one cycle reports it, at its own reference.
  cycle: u64,
}

// The order-independent member key of a dependency cycle (SEM0223), or zero.
fn cycleKey(value: &Rejection) -> u64 {
  if value.code != RejectionCode.Cycle { return 0 }
  let path = List<Shared<DeclarationId>>.asSlice(&value.path)
  if path.length < 3 { return 0 }
  let mut key: u64 = 0
  let mut at = usize.ZERO
  while at + usize.ONE < path.length {
    key = u64.wrappingAdd(key, Shared<DeclarationId>.with<u64>(&path[at], DeclarationId.hash))
    at = at + usize.ONE
  }
  return key
}

// Whether `diagnostic` has the code and location of one in `seen`, or is another member's report
// of the same cycle; otherwise it is recorded there.
effect fn repeated(seen: &mut List<ReportedSite>, diagnostic: &Shared<Rejection>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let site = Shared<Rejection>.with<ReportedSite>(diagnostic, fn(value: &Rejection) -> ReportedSite {
    return ReportedSite {code: value.code, module: ModuleId.copy(&value.module), span: value.span, cycle: cycleKey(value)}
  })
  let listed = List<ReportedSite>.asSlice(&seen.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].code == site.code && listed[at].span.start == site.span.start && listed[at].span.end == site.span.end
      && ModuleId.equals(&listed[at].module, &site.module) {
      return true
    }
    if site.cycle != 0 && listed[at].code == site.code && listed[at].cycle == site.cycle { return true }
    at = at + usize.ONE
  }
  run List<ReportedSite>.append(&mut seen.*, move site)
  return false
}

// Whether the fragments `ir` define the C symbol `main`.
fn definesMain(ir: &[u8]) -> bool {
  return Bitcode.definesFunction(ir, b"main")
}

// Whether a unit of `units` defines `main`, reading a stored unit's body from `packs`.
fn unitsDefineMain(units: &[CodegenUnit], packs: &[BuildRecord.PackBody]) -> bool {
  let mut at = usize.ZERO
  while at < units.length {
    if definesMain(unitBody(&units[at], packs)) { return true }
    at = at + usize.ONE
  }
  return false
}

// The body of `unit`: its own, or the stored pack body of its digest in `packs`.
fn unitBody<'a>(unit: &'a CodegenUnit, packs: &'a [BuildRecord.PackBody]) -> &'a [u8] {
  if !unit.stored { return Bytes.asSlice(&unit.body) }
  let mut at = usize.ZERO
  while at < packs.length {
    if ContentHash.equals(packs[at].digest, unit.digest) { return Bytes.asSlice(&packs[at].bytes) }
    at = at + usize.ONE
  }
  return CompilerBug.panic(b"a stored codegen unit has no pack body")
}

// Records the code and location of `diagnostic` as printed.
effect fn record(seen: &mut List<ReportedSite>, diagnostic: &Shared<Rejection>) -> () ! OutOfMemoryError ? &mut Allocator {
  let site = Shared<Rejection>.with<ReportedSite>(diagnostic, fn(value: &Rejection) -> ReportedSite {
    return ReportedSite {code: value.code, module: ModuleId.copy(&value.module), span: value.span, cycle: cycleKey(value)}
  })
  run List<ReportedSite>.append(&mut seen.*, move site)
  return ()
}

// Writes `rejection` to standard error in `format`, headed as [`writeHeaded`] heads diagnostics.
effect fn writeRejection(heading: &Option<Bytes>, headed: &mut bool, sources: &ModuleSources, rejection: &Shared<Rejection>, format: &DiagnosticFormat, progress: &mut Progress) -> ()
! FileError | OutOfMemoryError | WriterError ? &mut FileSystem | &mut Allocator {
  let mut line = Bytes.make()
  let reported = run reportRejection(sources, rejection, format, &mut line)
  run writeHeaded(heading, &mut headed.*, Bytes.asSlice(&line), &mut progress.*)
}

// Writes diagnostics to standard error. When `heading` names a target, a `[<target>]` line comes
// before the first of them, as `silk check` heads a target's diagnostics; nothing is written for
// none, so a build without diagnostics prints no heading. A live progress line still on screen,
// as a compact report keeps it between phases, is cleared first so they do not run together.
effect fn writeHeaded(heading: &Option<Bytes>, headed: &mut bool, diagnostics: &[u8], progress: &mut Progress) -> () ! WriterError {
  if diagnostics.length == usize.ZERO { return () }
  run Progress.clear(&mut progress.*)
  if let Option<Bytes>.Some {value: target} = &heading.* {
    if !headed.* {
      run writeError(b"[")
      run writeError(Bytes.asSlice(&target))
      run writeError(b"]\n")
      headed.* = true
    }
  }
  run writeError(diagnostics)
}

// The runtime's refusal of the application's `main`, reported at the entry's `main` instead of
// inside the runtime source: SEM0225 when `rejection` is located in the selected `runtime` and is
// one an absent, private or ill-shaped `main` produces there; otherwise none.
effect fn entryRejection(store: &mut Semantic, request: &mut SemanticRequest, sources: &ModuleSources, entry: &ModuleId, runtime: &Option<ModuleId>, rejection: &Shared<Rejection>) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator | &mut Types {
  let mut code = Shared<Rejection>.with<RejectionCode>(rejection, fn(value: &Rejection) -> RejectionCode { return value.code })
  let mut module = Shared<Rejection>.with<ModuleId>(rejection, fn(value: &Rejection) -> ModuleId { return ModuleId.copy(&value.module) })
  // A `main` result such as `string` needs a lifetime only because it borrows, and no lifetime makes
  // it a result a runtime starts, so its SEM0210 is reported as the runtime's refusal of that result.
  if code == RejectionCode.AmbiguousLifetime && ModuleId.equals(&module, entry) {
    if let Option<ModuleId>.Some {value: selected} = &runtime.* {
      let span = Shared<Rejection>.with<Span>(rejection, fn(value: &Rejection) -> Span { return value.span })
      if run inMainResult(&mut store.*, &mut request.*, sources, entry, span) {
        code = RejectionCode.MissingConformance
        module = ModuleId.copy(&selected)
      }
    }
  }
  let located = match &runtime.* {
    Option<ModuleId>.Some {value} => ModuleId.equals(&module, &value)
    Option<ModuleId>.None => false
  }
  if !located { return Option<Shared<Rejection>>.none() }
  let mut problem = Bytes.make()
  // A runtime that accepts one `main` shape, such as silk/native_start_sync's i32 Effect requiring
  // HostInput, refuses another where it adapts the result or supplies the requirement.
  // Only a standard-library runtime is trusted to fail this way for no reason but `main`'s shape: in
  // a runtime the package writes itself, these are ordinary errors of that runtime and stay as they are.
  let adapted = code == RejectionCode.TypeArgumentInference || code == RejectionCode.MissingProvidedKey || code == RejectionCode.IncompatibleUnionConversion
  let standard = ModuleId.withPath<bool>(&module, fn(path: &[u8]) -> bool {
    return path.length > 5 && path[0] == 115 && path[1] == 105 && path[2] == 108 && path[3] == 107 && path[4] == 47
  })
  if adapted && !standard { return Option<Shared<Rejection>>.none() }
  if adapted {
    run Bytes.append(&mut problem, b"has a result or requirement the selected runtime `")
    // The runtime as the manifest selects it: its module path without the source extension.
    let mut path = run ModuleId.copyPath(&module)
    let spelled = Bytes.asSlice(&path)
    let length = spelled.length
    let extension = length > 5 && spelled[length - 5] == 46 && spelled[length - 4] == 115 && spelled[length - 3] == 105
      && spelled[length - 2] == 108 && spelled[length - 1] == 107
    if extension { Bytes.truncate(&mut path, length - 5) }
    run Bytes.append(&mut problem, Bytes.asSlice(&path))
    run Bytes.append(&mut problem, b"` cannot start")
  } else if code == RejectionCode.MissingConformance && !ModuleId.withPath<bool>(&module, fn(path: &[u8]) -> bool {
    return same(path, b"silk/native_start.silk")
  }) {
    // Each runtime lists the `main` results it starts; name the selected one's, not the hosted list.
    let wasm = ModuleId.withPath<bool>(&module, fn(path: &[u8]) -> bool { return same(path, b"silk/wasm_start.silk") })
    if wasm {
      run Bytes.append(&mut problem, b"has a result the selected runtime `silk/wasm_start` cannot start; it accepts i32, (), or an Effect producing () with no requirements")
    } else {
      run Bytes.append(&mut problem, b"has a result the selected runtime `")
      let mut path = run ModuleId.copyPath(&module)
      let length = Bytes.length(&path)
      if length > 5 { Bytes.truncate(&mut path, length - 5) }
      run Bytes.append(&mut problem, Bytes.asSlice(&path))
      run Bytes.append(&mut problem, b"` cannot start")
    }
  } else {
    let fixed: &'static [u8] = match code {
      RejectionCode.UnknownImportedMember => b"is missing: the entry module must declare `pub fn main`, or a library package sets `kind = \"library\"` under `[package]` in silk.toml"
      RejectionCode.PrivateMember => b"must be `pub`"
      RejectionCode.RedundantCall => b"must take no parameters"
      RejectionCode.CallArity => b"must take no parameters"
      RejectionCode.UnsatisfiedExecutableProperty => b"may park, but the selected runtime starts it without a scheduler, so it must not park"
      RejectionCode.MissingConformance => b"has a result the selected runtime cannot start; the default runtime accepts i32, (), or an Effect producing () or i32 that requires at most `&mut HostInput` and whose errors all implement `Debug`"
      _ => { return Option<Shared<Rejection>>.none() }
    }
    run Bytes.append(&mut problem, fixed)
  }
  let mut moved = run Rejections.make(RejectionCode.InvalidEntryPoint, entry, run entryMainSpan(&mut store.*, &mut request.*, sources, entry))
  run List<MessageArgument>.append(&mut moved.arguments, MessageArgument {name: run Bytes.copy(b"problem"), value: move problem})
  return Option<Shared<Rejection>>.some(run Shared<Rejection>.make(move moved))
}

// Whether `span` lies in the result of `entry`'s module-level `main`: after its name and its `->`,
// before its body.
effect fn inMainResult(store: &mut Semantic, request: &mut SemanticRequest, sources: &ModuleSources, entry: &ModuleId, span: Span) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator | &mut Types {
  let name = run entryMainSpan(&mut store.*, &mut request.*, sources, entry)
  if name.end == usize.ZERO || span.start < name.end { return false }
  let text = match move run moduleSource(sources, entry) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return false }
  }
  let source = Bytes.asSlice(&text)
  if span.start > source.length { return false }
  let mut arrow = false
  let mut at = name.end
  while at < span.start {
    if source[at] == 123 { return false }
    if source[at] == 45 && at + usize.ONE < span.start && source[at + usize.ONE] == 62 { arrow = true }
    at = at + usize.ONE
  }
  return arrow
}

// The name span of `entry`'s module-level `main` function; the module start when it has none.
effect fn entryMainSpan(store: &mut Semantic, request: &mut SemanticRequest, sources: &ModuleSources, entry: &ModuleId) -> Span
! Cycle | InvalidModulePath | RevisionMismatch | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator | &mut Types {
  let text = match move run moduleSource(sources, entry) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return Span.make(usize.ZERO, usize.ZERO) }
  }
  let inventory = run Semantic.demandSourceInventory(&mut store.*, &mut request.*, entry)
  if let SourceInventory.Present {syntax, ..} = &inventory {
    let functions = List<NamedFunction>.asSlice(&syntax.functions)
    let source = Bytes.asSlice(&text)
    let mut at = usize.ZERO
    while at < functions.length {
      let name = functions[at].nameSpan
      let topLevel = match &functions[at].declaration.parent {
        Option<usize>.Some {..} => false
        Option<usize>.None => true
      }
      if topLevel && name.end <= source.length && name.end - name.start == 4
        && source[name.start] == 109 && source[name.start + 1] == 97 && source[name.start + 2] == 105 && source[name.start + 3] == 110 {
        return name
      }
      at = at + usize.ONE
    }
  }
  return Span.make(usize.ZERO, usize.ZERO)
}

// The source file and text of `module`, when the analysis reads it from disk.
effect fn moduleSource(sources: &ModuleSources, module: &ModuleId) -> Option<Bytes>
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let location = run ModuleSourceFiles.sourceLocation(sources, module)
  return match &location.path {
    Option<Path>.Some {value} => {
      let read = run Effect.result(FileSystem.readFile(&value))
      return match move read {
        Result<Bytes, FileError | OutOfMemoryError>.Success {value: text} => Option<Bytes>.some(move text)
        Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
          FileError unreadable => {
            drop unreadable
            return Option<Bytes>.none()
          }
          OutOfMemoryError exhausted => { fail move exhausted }
        }
      }
    }
    Option<Path>.None => Option<Bytes>.none()
  }
}

// Appends `path:line:col` for `span` in `module`, `path:?:?` when its source cannot be read.
// The path a diagnostic in `module` names: its source file, else its logical path.
// The file of `module` as a diagnostic names it: relative to `root` when it lies under it, else
// absolute, as `--json` always names it.
effect fn displayPath(sources: &ModuleSources, module: &ModuleId, root: &[u8]) -> Bytes
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let location = run ModuleSourceFiles.sourceLocation(sources, module)
  return match &location.path {
    Option<Path>.Some {value} => {
      if root.length == usize.ZERO { return run Bytes.copy(Path.rawBytes(&value)) }
      let directory = run Path.fromBytes(root)
      return run shownPath(&directory, &value)
    }
    Option<Path>.None => run ModuleId.copyPath(module)
  }
}

// The directory a human diagnostic names its files from: the root of the workspace that lists the
// package at `manifest`, or else that package's own directory, so `silk build` in a workspace
// prints `glob/src/Glob.silk:1:1`. Files outside it, such as the standard library's, stay absolute.
// A single-source build has no manifest and keeps absolute paths.
effect fn diagnosticRoot(manifest: &Path) -> Bytes
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let directory = match move run Path.parent(manifest) {
    Option<Path>.Some {value} => move value
    Option<Path>.None => { return Bytes.make() }
  }
  let workspace = match move run Projects.enclosingWorkspace(&directory) {
    Option<Path>.Some {value} => move value
    Option<Path>.None => { return run Bytes.copy(Path.rawBytes(&directory)) }
  }
  let workspaceDirectory = match move run Path.parent(&workspace) {
    Option<Path>.Some {value} => move value
    Option<Path>.None => { return run Bytes.copy(Path.rawBytes(&directory)) }
  }
  // A workspace above the package that does not list it, such as a repository's own, is not its root.
  if same(Path.rawBytes(&workspaceDirectory), Path.rawBytes(&directory)) || run listedMember(&workspace, &directory) {
    return run Bytes.copy(Path.rawBytes(&workspaceDirectory))
  }
  return run Bytes.copy(Path.rawBytes(&directory))
}

// Whether the workspace at `manifest` lists `member`; a manifest that cannot be read lists nothing.
effect fn listedMember(manifest: &Path, member: &Path) -> bool ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  return match move run Effect.result(Projects.listsMember(manifest, member)) {
    Result<bool, ProjectError | FileError | OutOfMemoryError>.Success {value} => value
    Result<bool, ProjectError | FileError | OutOfMemoryError>.Failure {error} => match move error {
      ProjectError unread => {
        drop unread
        return false
      }
      FileError unread => {
        drop unread
        return false
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// The root a human `format` names its paths from; empty, for absolute paths, in the machine and
// JSON formats.
fn humanRoot(format: &DiagnosticFormat) -> &[u8] {
  if let DiagnosticFormat.Human {root} = &format.* { return Bytes.asSlice(&root) }
  return b""
}

effect fn appendLocation(line: &mut Bytes, sources: &ModuleSources, module: &ModuleId, span: Span, root: &[u8], json: bool) -> ()
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let path = run displayPath(sources, module, root)
  let text = run moduleSource(sources, module)
  if json {
    run Bytes.append(&mut line.*, b"\"path\":")
    run JsonText.appendString(&mut line.*, Bytes.asSlice(&path))
    if let Option<Bytes>.Some {value} = &text {
      let position = Reports.position(Bytes.asSlice(&value), span.start)
      run Bytes.append(&mut line.*, b",\"line\":")
      run JsonText.appendDecimal(&mut line.*, position.line)
      run Bytes.append(&mut line.*, b",\"column\":")
      run JsonText.appendDecimal(&mut line.*, position.column)
    } else {
      run Bytes.append(&mut line.*, b",\"line\":null,\"column\":null")
    }
    run Bytes.append(&mut line.*, b",\"start\":")
    run JsonText.appendDecimal(&mut line.*, span.start)
    run Bytes.append(&mut line.*, b",\"end\":")
    run JsonText.appendDecimal(&mut line.*, span.end)
    return ()
  }
  run Bytes.append(&mut line.*, Bytes.asSlice(&path))
  if let Option<Bytes>.Some {value} = &text {
    let position = Reports.position(Bytes.asSlice(&value), span.start)
    run Bytes.append(&mut line.*, b":")
    run JsonText.appendDecimal(&mut line.*, position.line)
    run Bytes.append(&mut line.*, b":")
    run JsonText.appendDecimal(&mut line.*, position.column)
  } else {
    run Bytes.append(&mut line.*, b":?:?")
  }
}

// Appends one `--json` diagnostic line: the target, then the rendered parts in the bootstrap's
// field order.
effect fn appendJson(out: &mut Bytes, target: &[u8], rendered: &RenderedDiagnostic) -> () ! OutOfMemoryError ? &mut Allocator {
  run Bytes.append(&mut out.*, b"{\"target\":")
  run JsonText.appendString(&mut out.*, target)
  run Bytes.append(&mut out.*, b",\"code\":")
  run JsonText.appendString(&mut out.*, Bytes.asSlice(&rendered.code))
  run Bytes.append(&mut out.*, b",\"severity\":")
  run JsonText.appendString(&mut out.*, Bytes.asSlice(&rendered.severity))
  run Bytes.append(&mut out.*, b",\"path\":")
  run JsonText.appendString(&mut out.*, Bytes.asSlice(&rendered.path))
  run Bytes.append(&mut out.*, b",\"line\":")
  run JsonText.appendDecimal(&mut out.*, rendered.line)
  run Bytes.append(&mut out.*, b",\"column\":")
  run JsonText.appendDecimal(&mut out.*, rendered.column)
  run Bytes.append(&mut out.*, b",\"start\":")
  run JsonText.appendDecimal(&mut out.*, rendered.start)
  run Bytes.append(&mut out.*, b",\"end\":")
  run JsonText.appendDecimal(&mut out.*, rendered.end)
  run Bytes.append(&mut out.*, b",\"message\":")
  if let Option<Bytes>.Some {value: message} = &rendered.message {
    run JsonText.appendString(&mut out.*, Bytes.asSlice(&message))
  } else {
    run Bytes.append(&mut out.*, b"null")
  }
  run Bytes.append(&mut out.*, b",\"notes\":[")
  let notes = List<Bytes>.asSlice(&rendered.notes)
  let mut at = usize.ZERO
  while at < notes.length {
    if at > usize.ZERO { run Bytes.append(&mut out.*, b",") }
    run JsonText.appendString(&mut out.*, Bytes.asSlice(&notes[at]))
    at = at + usize.ONE
  }
  run Bytes.append(&mut out.*, b"],\"related\":[")
  let related = List<RelatedLocation>.asSlice(&rendered.related)
  at = usize.ZERO
  while at < related.length {
    if at > usize.ZERO { run Bytes.append(&mut out.*, b",") }
    run Bytes.append(&mut out.*, b"{\"path\":")
    run JsonText.appendString(&mut out.*, Bytes.asSlice(&related[at].path))
    run Bytes.append(&mut out.*, b",\"line\":")
    run JsonText.appendDecimal(&mut out.*, related[at].line)
    run Bytes.append(&mut out.*, b",\"column\":")
    run JsonText.appendDecimal(&mut out.*, related[at].column)
    run Bytes.append(&mut out.*, b",\"start\":")
    run JsonText.appendDecimal(&mut out.*, related[at].start)
    run Bytes.append(&mut out.*, b",\"end\":")
    run JsonText.appendDecimal(&mut out.*, related[at].end)
    run Bytes.append(&mut out.*, b",\"label\":")
    if let Option<Bytes>.Some {value: label} = &related[at].label {
      run JsonText.appendString(&mut out.*, Bytes.asSlice(&label))
    } else {
      run Bytes.append(&mut out.*, b"null")
    }
    run Bytes.append(&mut out.*, b"}")
    at = at + usize.ONE
  }
  run Bytes.append(&mut out.*, b"]}\n")
}

// The note for an import of `written`, a missing module, from `importer` when a file names it in
// other letter case: `did you mean util.Math?` for `util.math` beside `util/Math.silk`. Module paths
// match file names exactly on every host, so the import is refused even where the filesystem
// ignores case. Failing that, a file one typo away is offered: `did you mean geo.shapes?` for
// `geo.shape` beside `geo/shapes.silk`.
effect fn caseVariantNote(sources: &ModuleSources, importer: &ModuleId, written: &[u8]) -> Option<Bytes>
! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut dotted = Bytes.make()
  let mut path = Bytes.make()
  let mut segments = usize.ONE
  let mut at = usize.ZERO
  while at < written.length {
    let byte = written[at]
    if byte == 46 {
      segments = segments + usize.ONE
      run Bytes.append(&mut dotted, b".")
      run Bytes.append(&mut path, b"/")
    } else if byte != 32 && byte != 9 && byte != 10 && byte != 13 {
      run Bytes.append(&mut dotted, &[byte])
      run Bytes.append(&mut path, &[byte])
    }
    at = at + usize.ONE
  }
  run Bytes.append(&mut path, b".silk")
  let graph = run ModuleSourceFiles.packageGraph(sources)
  let target = match move run Effect.result(PackageGraph.target(&graph, importer, Bytes.asSlice(&path))) {
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success {value} => move value
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure {error} => match move error {
      InvalidModulePath {} => { return Option<Bytes>.none() }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let mut found = run ModuleSourceFiles.caseVariant(sources, &target)
  let caseOnly = match &found { Option<Bytes>.Some {..} => true Option<Bytes>.None => false }
  if !caseOnly { found = run ModuleSourceFiles.nearVariant(sources, &target) }
  // A module that moved within its package, such as `helper` to `util/helper`, is found by name.
  if let Option<Bytes>.None = &found { found = run ModuleSourceFiles.movedVariant(sources, &target) }
  let variant = match move found {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return Option<Bytes>.none() }
  }
  // The file's logical path replaces the import's segments that spell the target's path; a
  // dependency's name before them stays as written.
  let spelled = Bytes.asSlice(&variant)
  let targetPath = run ModuleId.copyPath(&target)
  let mut kept = segments
  at = usize.ZERO
  while at < Bytes.length(&targetPath) {
    if Bytes.asSlice(&targetPath)[at] == 47 { kept = kept - usize.ONE }
    at = at + usize.ONE
  }
  kept = kept - usize.ONE
  let mut note = run Bytes.copy(b"did you mean `")
  let prefix = Bytes.asSlice(&dotted)
  at = usize.ZERO
  while kept > usize.ZERO && at < prefix.length {
    run Bytes.append(&mut note, &[prefix[at]])
    if prefix[at] == 46 { kept = kept - usize.ONE }
    at = at + usize.ONE
  }
  let end = spelled.length - 5
  at = usize.ZERO
  while at < end {
    if spelled[at] == 47 {
      run Bytes.append(&mut note, b".")
    } else {
      run Bytes.append(&mut note, &[spelled[at]])
    }
    at = at + usize.ONE
  }
  if caseOnly {
    run Bytes.append(&mut note, b"`? Module paths match file names exactly, including letter case")
  } else {
    run Bytes.append(&mut note, b"`?")
  }
  return Option<Bytes>.some(move note)
}

// Appends one rejection or refusal to `out` in `format` and answers its status: 1 for a language
// rejection, 2 for a construct this compiler does not support yet.
effect fn reportRejection(sources: &ModuleSources, diagnostic: &Shared<Rejection>, format: &DiagnosticFormat, out: &mut Bytes) -> i32
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let status = diagnosticStatus(diagnostic)
  let target = match &format.* {
    DiagnosticFormat.Machine => {
      let message = run rejectionSummary(diagnostic)
      run Bytes.append(&mut out.*, Bytes.asSlice(&message))
      return status
    }
    DiagnosticFormat.Human {..} => Option<&[u8]>.none()
    DiagnosticFormat.Json {target} => Option<&[u8]>.some(Bytes.asSlice(&target))
  }
  let code = Shared<Rejection>.with<RejectionCode>(diagnostic, fn(value: &Rejection) -> RejectionCode { return value.code })
  let span = Shared<Rejection>.with<Span>(diagnostic, fn(value: &Rejection) -> Span { return value.span })
  let module = Shared<Rejection>.with<ModuleId>(diagnostic, fn(value: &Rejection) -> ModuleId { return ModuleId.copy(&value.module) })
  // A related site at the diagnostic's own position adds nothing.
  let related = Shared<Rejection>.with<Option<RelatedSite>>(diagnostic, fn(value: &Rejection) -> Option<RelatedSite> {
    return match &value.related {
      Option<RelatedSite>.Some {value: site} => {
        if ModuleId.equals(&site.module, &value.module) && site.span.start == value.span.start { return Option<RelatedSite>.none() }
        return Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(&site.module), span: site.span})
      }
      Option<RelatedSite>.None => Option<RelatedSite>.none()
    }
  })
  // A catalog diagnostic in a module read from disk renders as the bootstrap CLI prints it.
  if let Option<Bytes>.Some {value: text} = move run moduleSource(sources, &module) {
    let path = run displayPath(sources, &module, humanRoot(format))
    if let Option<RenderedDiagnostic>.Some {value: fields} = move run Reports.fields(diagnostic, Bytes.asSlice(&text), Bytes.asSlice(&path)) {
      let mut rendered = move fields
      // The report locates only a related site of the diagnostic's own module; a site in another
      // module, such as the library body a call reached, is located in that module's source here.
      if let Option<RelatedSite>.Some {value: site} = &related {
        if !ModuleId.equals(&site.module, &module) {
          if let Option<Bytes>.Some {value: relatedText} = move run moduleSource(sources, &site.module) {
            let position = Reports.position(Bytes.asSlice(&relatedText), site.span.start)
            let relatedPath = run displayPath(sources, &site.module, humanRoot(format))
            run List<RelatedLocation>.append(&mut rendered.related, RelatedLocation {
              path: move relatedPath,
              line: position.line,
              column: position.column,
              start: site.span.start,
              end: site.span.end,
              label: Option<Bytes>.none(),
            })
          }
        }
      }
      if code == RejectionCode.MissingModule && span.end <= Bytes.length(&text) && span.start < span.end {
        let written = Slice.view<u8>(Bytes.asSlice(&text), span.start, span.end - span.start)
        if let Option<Bytes>.Some {value: note} = move run caseVariantNote(sources, &module, written) {
          run List<Bytes>.append(&mut rendered.notes, move note)
        }
      }
      if let DiagnosticFormat.Json {target: targetName} = &format.* {
        run appendJson(&mut out.*, Bytes.asSlice(&targetName), &rendered)
      } else {
        let line = run Reports.text(&rendered)
        run Bytes.append(&mut out.*, Bytes.asSlice(&line))
        run Bytes.append(&mut out.*, b"\n")
      }
      return status
    }
  }
  // A refusal has no catalog code; it names the unsupported construct instead.
  let mut name = Rejections.stableCode(code)
  if name.length == usize.ZERO { name = Rejection.name(code) }
  let mut line = Bytes.make()
  if let Option<&[u8]>.Some {value: targetName} = move target {
    run Bytes.append(&mut line, b"{\"target\":")
    run JsonText.appendString(&mut line, targetName)
    run Bytes.append(&mut line, b",\"code\":")
    run JsonText.appendString(&mut line, name)
    if status == 1 {
      run Bytes.append(&mut line, b",\"severity\":\"error\",")
    } else {
      run Bytes.append(&mut line, b",\"severity\":\"unsupported\",")
    }
    run appendLocation(&mut line, sources, &module, span, b"", true)
    run Bytes.append(&mut line, b",\"message\":null,\"notes\":[],\"related\":[")
    if let Option<RelatedSite>.Some {value: site} = &related {
      run Bytes.append(&mut line, b"{")
      run appendLocation(&mut line, sources, &site.module, site.span, b"", true)
      run Bytes.append(&mut line, b",\"label\":null}")
    }
    run Bytes.append(&mut line, b"]}\n")
  } else {
    run appendLocation(&mut line, sources, &module, span, humanRoot(format), false)
    if status == 1 {
      run Bytes.append(&mut line, b": error[")
      run Bytes.append(&mut line, name)
      run Bytes.append(&mut line, b"]\n")
    } else if same(name, b"Unsupported") {
      run Bytes.append(&mut line, b": unsupported: this construct is not supported by the native compiler yet\n")
    } else {
      run Bytes.append(&mut line, b": unsupported[")
      run Bytes.append(&mut line, name)
      run Bytes.append(&mut line, b"] not supported by the native compiler yet\n")
    }
    if let Option<RelatedSite>.Some {value: site} = &related {
      run Bytes.append(&mut line, b"  note: ")
      run appendLocation(&mut line, sources, &site.module, site.span, humanRoot(format), false)
      run Bytes.append(&mut line, b": related location\n")
    }
  }
  run Bytes.append(&mut out.*, Bytes.asSlice(&line))
  return status
}

// The key a reused test runner (or, under another `kind`, a reused project build, see
// `reusedBuild`) must have been built under: the compiler, the profile, the roots
// and paths the build starts from, and the toolchain settings it reads from the environment. Every
// file the build reads is checked separately (`BuildInputs`). There is none, so nothing is reused,
// for a compiler without an identity or a build with profile bindings, which may hold secrets that
// must not reach the disk.
effect fn testBuildKey(kind: &[u8], sourcePath: &Path, manifest: &Option<&Path>, output: &Path, display: &Path, standardLibrary: &Option<Path>,
  profile: &InitialProfile, bindings: &List<Supplied>, clang: &Option<Bytes>) -> Option<Bytes>
! HostInputError | OutOfMemoryError ? &mut FileSystem | &mut HostInput | &mut Allocator {
  if List<Supplied>.length(bindings) != usize.ZERO { return Option<Bytes>.none() }
  let compiler = match move run CacheStamp.compiler() {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return Option<Bytes>.none() }
  }
  let mut key = run Bytes.copy(kind)
  run RuntimeEncoding.field(&mut key, Bytes.asSlice(&compiler))
  let mut identity = Bytes.make()
  run InitialProfile.appendIdentity(profile, &mut identity)
  run RuntimeEncoding.field(&mut key, Bytes.asSlice(&identity))
  run RuntimeEncoding.field(&mut key, Path.rawBytes(sourcePath))
  run RuntimeEncoding.field(&mut key, Path.rawBytes(output))
  run RuntimeEncoding.field(&mut key, Path.rawBytes(display))
  match &manifest.* {
    Option<&Path>.Some {value} => run RuntimeEncoding.field(&mut key, Path.rawBytes(value))
    Option<&Path>.None => run RuntimeEncoding.field(&mut key, b"")
  }
  match &standardLibrary.* {
    Option<Path>.Some {value} => run RuntimeEncoding.field(&mut key, Path.rawBytes(&value))
    Option<Path>.None => run RuntimeEncoding.field(&mut key, b"")
  }
  match &clang.* {
    Option<Bytes>.Some {value} => run RuntimeEncoding.field(&mut key, Bytes.asSlice(&value))
    Option<Bytes>.None => run RuntimeEncoding.field(&mut key, b"")
  }
  if Target.id(InitialProfile.target(profile)) == TargetId.Wasm32Wasip2 {
    match move run Effect.result(WasiTools.identity()) {
      Result<Bytes, FileError | HostInputError | OutOfMemoryError>.Success {value} => run RuntimeEncoding.field(&mut key, Bytes.asSlice(&value))
      Result<Bytes, FileError | HostInputError | OutOfMemoryError>.Failure {error} => match move error {
        FileError unavailable => { drop unavailable return Option<Bytes>.none() }
        HostInputError unavailable => { fail move unavailable }
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
  }
  let variables = ["SILK_CLANG", "SILK_LLVM_AR", "PATH", "SDKROOT", "DEVELOPER_DIR", "SILK_WASM_TOOLS", "SILK_WASI_ADAPTER", "SILK_WASI_REACTOR_ADAPTER",
    "SILK_VERIFY_MIR"]
  let mut at = usize.ZERO
  while at < 9 {
    match move run HostInput.variableNamed(variables[at]) {
      Option<Bytes>.Some {value} => {
        run RuntimeEncoding.field(&mut key, b"=")
        run RuntimeEncoding.field(&mut key, Bytes.asSlice(&value))
      }
      Option<Bytes>.None => run RuntimeEncoding.field(&mut key, b"")
    }
    at = at + usize.ONE
  }
  return Option<Bytes>.some(move key)
}

// What a reused runner needs besides its executable: the digest of that executable, then the
// catalog identities in order.
effect fn testBuildPayload(executable: &[u8], identities: &List<Bytes>) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let digest = ContentHash.of(executable)
  let mut payload = Bytes.make()
  run RuntimeEncoding.word(&mut payload, digest.high)
  run RuntimeEncoding.word(&mut payload, digest.low)
  let listed = List<Bytes>.asSlice(identities)
  run RuntimeEncoding.word(&mut payload, usize.toU64(listed.length))
  let mut at = usize.ZERO
  while at < listed.length {
    run RuntimeEncoding.field(&mut payload, Bytes.asSlice(&listed[at]))
    at = at + usize.ONE
  }
  return move payload
}

// The big-endian word `RuntimeEncoding.word` wrote at `offset`.
fn readWord(bytes: &[u8], offset: usize) -> u64 {
  let mut value: u64 = 0
  let mut at = usize.ZERO
  while at < 8 {
    value = u64.bitOr(u64.shiftLeft(value, 8), u8.toU64(bytes[offset + at]))
    at = at + usize.ONE
  }
  return value
}

// The catalog of the runner at `output` when the record beside it shows that a build under `key`
// would read exactly what the one that made it read, and the runner is the one it made.
effect fn reusedTests(record: &Path, key: &Option<Bytes>, output: &Path) -> Option<List<Bytes>>
! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let expected = match &key.* {
    Option<Bytes>.Some {value} => Bytes.asSlice(&value)
    Option<Bytes>.None => { return Option<List<Bytes>>.none() }
  }
  let stored = match move run Effect.result(FileSystem.readFile(record)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success {value} => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => { drop failure return Option<List<Bytes>>.none() }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let payload = match move run BuildInputs.unchanged(Bytes.asSlice(&stored), expected) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return Option<List<Bytes>>.none() }
  }
  let executable = match move run Effect.result(FileSystem.readFile(output)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success {value} => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => { drop failure return Option<List<Bytes>>.none() }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let digest = ContentHash.of(Bytes.asSlice(&executable))
  let bytes = Bytes.asSlice(&payload)
  if bytes.length < 24 || readWord(bytes, 0) != digest.high || readWord(bytes, 8) != digest.low { return Option<List<Bytes>>.none() }
  let count = readWord(bytes, 16)
  let mut identities = List<Bytes>.make()
  let mut at: usize = 24
  let mut index: u64 = 0
  while index < count {
    if bytes.length - at < 8 { return Option<List<Bytes>>.none() }
    let length = u64.toUsize(readWord(bytes, at))
    at = at + 8
    if length > bytes.length - at { return Option<List<Bytes>>.none() }
    run List<Bytes>.append(&mut identities, run Bytes.copy(Slice.view<u8>(bytes, at, length)))
    at = at + length
    index = index + 1
  }
  if at != bytes.length { return Option<List<Bytes>>.none() }
  return Option<List<Bytes>>.some(move identities)
}

// The record of the files a project build read, beside its artifact.
effect fn reuseRecordFor(output: &Path) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
  let mut named = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut named, b".inputs")
  return run Path.fromBytes(Bytes.asSlice(&named))
}

// `key`, naming the memory limit `maxMemory` too when there is one.
effect fn withMemoryLimit(key: Option<Bytes>, maxMemory: &Option<usize>) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut keyed = match move key {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return Option<Bytes>.none() }
  }
  if let Option<usize>.Some {value: limit} = &maxMemory.* {
    run RuntimeEncoding.field(&mut keyed, b"max-memory")
    run RuntimeEncoding.word(&mut keyed, usize.toU64(limit))
  }
  return Option<Bytes>.some(move keyed)
}

// The symbol map a debug build writes beside its artifact.
effect fn symbolMapFor(output: &Path) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
  let mut named = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut named, b".symbols")
  return run Path.fromBytes(Bytes.asSlice(&named))
}

// Whether the artifact `output` is what a build under `key` would make: the last build recorded at
// `record` ran under the same key, every file it read reads the same, and `output` still has the
// digest it linked.
effect fn reusedBuild(record: &Path, key: &Option<Bytes>, output: &Path) -> bool
! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let expected = match &key.* {
    Option<Bytes>.Some {value} => Bytes.asSlice(&value)
    Option<Bytes>.None => { return false }
  }
  let stored = match move run Effect.result(FileSystem.readFile(record)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success {value} => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => { drop failure return false }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let payload = match move run BuildInputs.unchanged(Bytes.asSlice(&stored), expected) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return false }
  }
  let executable = match move run Effect.result(FileSystem.readFile(output)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success {value} => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => { drop failure return false }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let digest = ContentHash.of(Bytes.asSlice(&executable))
  let bytes = Bytes.asSlice(&payload)
  return bytes.length == 16 && readWord(bytes, 0) == digest.high && readWord(bytes, 8) == digest.low
}

// Records at `record` what `recorder` saw a successful build read, for `reusedBuild`. Only an
// executable whose link the codegen cache stamped is recorded: any other link reads inputs from
// outside the build (a declared archive, the wasip2 component tools) that no record notes.
effect fn recordBuild(record: &Path, key: &[u8], recorder: &BuildInputs.Recorder, output: &Path) -> ()
! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let units = match move run Effect.result(CodegenCache.directoryFor(output)) {
    Result<Path, FileError | OutOfMemoryError>.Success {value} => move value
    Result<Path, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => { drop failure return () }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  if !run CodegenCache.stamped(&units) { return () }
  let executable = run Effect.result(FileSystem.readFile(output))
  if let Result<Bytes, FileError | OutOfMemoryError>.Success {value} = &executable {
    let digest = ContentHash.of(Bytes.asSlice(&value))
    let mut payload = Bytes.make()
    run RuntimeEncoding.word(&mut payload, digest.high)
    run RuntimeEncoding.word(&mut payload, digest.low)
    let encoded = run BuildInputs.encode(key, Bytes.asSlice(&payload), recorder)
    // Without the record the next build runs; it never changes this one.
    let written = run Effect.result(FileSystem.writeFile(record, Bytes.asSlice(&encoded)))
    drop written
  }
  drop executable
}

// One invocation nonce: no two runs share a plan, so a stale receipt never binds a new run.
effect fn testNonce(output: &[u8], digest: &[u8]) -> [u8; 32] {
  let mut clock = OsSystemClock.make()
  let now = run SystemClock.now()
    |> Effect.provideMut<SystemClock>(&mut clock)
  let mut state = Sha256.make()
  Sha256.update(&mut state, b"silk-test-nonce")
  let stamp = [i64.toU64(SystemClock.seconds(&now)), i64.toU64(SystemClock.nanoseconds(&now))]
  let mut at = usize.ZERO
  while at < 2 {
    let mut shift = usize.ZERO
    while shift < 8 {
      let byte = [u64.toU8(u64.bitAnd(u64.shiftRight(stamp[at], usize.toU64(shift * 8)), 255))]
      Sha256.update(&mut state, &byte)
      shift = shift + usize.ONE
    }
    at = at + usize.ONE
  }
  Sha256.update(&mut state, output)
  Sha256.update(&mut state, digest)
  return state.finish()
}

effect fn removeQuietly(path: &Path) -> () ? &mut FileSystem {
  let removed = run Effect.result(FileSystem.removeFile(path))
  drop removed
  return ()
}

// Builds the bundled runner for the discovery root `sourcePath` (within `manifest`'s package when
// given), runs it with an uncached plan, and returns its status once its receipt is admitted: 0 or
// 1 from the runner, 2 for an operational failure, or the raw status of an abnormal exit
// (TEST-007, TEST-008). `matched` becomes true when the admitted receipt selected a test.
// `timeout` is each test's limit in seconds, 60 when absent and none when 0.
effect fn test(sourcePath: &Path, manifest: Option<&Path>, output: &Path, display: &Path, request: &SupplyRequest, standardLibrary: Option<Path>, profile: InitialProfile,
  bindings: List<Supplied>, filter: Option<Bytes>, file: Option<Bytes>, timeout: &Option<Bytes>, clang: &Option<Bytes>, noCache: bool, matched: &mut bool) -> i32
! ApplicationError | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Writer | &mut Types {
  let wasi = same(Target.operatingSystem(InitialProfile.target(&profile)), b"wasi")
  // An unchanged project reuses the runner it built last time, whatever the filters select;
  // `--no-cache` builds it again (TEST-008).
  let mut recordBytes = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut recordBytes, b".inputs")
  let recordPath = run Path.fromBytes(Bytes.asSlice(&recordBytes))
  let key = run testBuildKey(b"silk-test-runner-1", sourcePath, &manifest, output, display, &standardLibrary, &profile, &bindings, clang)
  let mut identities = List<Bytes>.make()
  let mut reused = Option<List<Bytes>>.none()
  if !noCache { reused = run reusedTests(&recordPath, &key, output) }
  if let Option<List<Bytes>>.Some {value} = move reused {
    identities = move value
  } else {
    run removeQuietly(&recordPath)
    let mut recorder = run BuildInputs.recorder()
    // Clang fills the codegen cache after the build looked for its objects; recorded, the next run
    // would find them changed and build once more.
    let units = run CodegenCache.directoryFor(output)
    run BuildInputs.exclude(&mut recorder, &units)
    // Clang links the runner too, and a debug build reads the old one to see whether linking can
    // be skipped; the record checks the runner by its digest instead.
    run BuildInputs.exclude(&mut recorder, output)
    // A debug runner's symbol map is read only to leave an unchanged one alone.
    let mut mapBytes = run Bytes.copy(Path.rawBytes(output))
    run Bytes.append(&mut mapBytes, b".symbols")
    run BuildInputs.exclude(&mut recorder, &run Path.fromBytes(Bytes.asSlice(&mapBytes)))
    let mut silent = Progress.off()
    let built = run build(sourcePath, move manifest, Option<&Path>.none(), output, display, Form.Executable, Stage.Final, move standardLibrary, move profile, Option<usize>.none(), move bindings, request, true, false, clang, &Option<Bytes>.none(), Option<&[u8]>.none(), false, &mut silent)
      |> Effect.provideMut<FileSystem>(&mut recorder)
    let catalog = match move built {
      Compiled.Finished {status} => { return status }
      Compiled.Tests {identities: listed} => move listed
    }
    if let Option<Bytes>.Some {value: stamped} = &key {
      if BuildInputs.complete(&recorder) {
        let executable = run Effect.result(FileSystem.readFile(output))
        if let Result<Bytes, FileError | OutOfMemoryError>.Success {value} = &executable {
          let payload = run testBuildPayload(Bytes.asSlice(&value), &catalog)
          let record = run BuildInputs.encode(Bytes.asSlice(&stamped), Bytes.asSlice(&payload), &recorder)
          // Without the record the next run builds again; it never changes this run.
          let written = run Effect.result(FileSystem.writeFile(&recordPath, Bytes.asSlice(&record)))
          drop written
        }
        drop executable
      }
    }
    identities = move catalog
  }
  let digest = TestRun.catalogDigest(List<Bytes>.asSlice(&identities))
  let nonce = run testNonce(Path.rawBytes(output), &digest)
  let plan = run TestRun.uncachedPlan(&nonce, &digest, usize.toU64(List<Bytes>.length(&identities)))
  let mut planBytes = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut planBytes, b".plan")
  let planPath = run Path.fromBytes(Bytes.asSlice(&planBytes))
  let mut receiptBytes = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut receiptBytes, b".receipt")
  let receiptPath = run Path.fromBytes(Bytes.asSlice(&receiptBytes))
  let mut progressBytes = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut progressBytes, b".progress")
  let progressPath = run Path.fromBytes(Bytes.asSlice(&progressBytes))
  run removeQuietly(&receiptPath)
  run removeQuietly(&progressPath)
  run FileSystem.writeFile(&planPath, Bytes.asSlice(&plan))
  let limit = match &timeout.* {
    Option<Bytes>.Some {value} => Bytes.asSlice(&value)
    Option<Bytes>.None => b"60"
  }
  let mut status = 2
  let mut running = true
  while running {
    let mut previousProgress = Bytes.make()
    if wasi && run FileSystem.exists(&progressPath) { previousProgress = run FileSystem.readFile(&progressPath) }
    let mut process = run ChildProcess.request(output)
    if wasi {
      process = match move run WasiTools.request(output, limit, Option<&Path>.none()) {
        Option<ProcessRequest>.Some {value} => move value
        Option<ProcessRequest>.None => { return 2 }
      }
    }
    if let Option<Bytes>.Some {value} = &file {
      run ChildProcess.addArgument(&mut process, "--file")
      run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&value))
    }
    if let Option<Bytes>.Some {value} = &filter {
      run ChildProcess.addArgument(&mut process, "--filter")
      run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&value))
    }
    run ChildProcess.addArgument(&mut process, "--silk-test-plan")
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&planBytes))
    run ChildProcess.addArgument(&mut process, "--silk-test-result")
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&receiptBytes))
    run ChildProcess.addArgument(&mut process, "--silk-test-progress")
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&progressBytes))
    run ChildProcess.addArgument(&mut process, "--silk-test-timeout")
    run ChildProcess.addArgumentBytes(&mut process, limit)
    let outcome = run ChildProcess.submit(&process)
    run Writer.writeAll(ChildProcess.outputBytes(&outcome))
    run writeError(ChildProcess.errorBytes(&outcome))
    status = 2
    running = false
    if let Option<i32>.Some {value} = move ChildProcess.exitCode(&outcome) {
      status = value
      // A WASI trap exits Wasmtime with a nonzero status instead of terminating it by signal.
      if wasi && status != 0 && run FileSystem.exists(&progressPath) {
        let nextProgress = run FileSystem.readFile(&progressPath)
        running = !same(Bytes.asSlice(&previousProgress), Bytes.asSlice(&nextProgress))
      }
    } else if let Option<i32>.Some {value: signal} = move ChildProcess.terminatingSignal(&outcome) {
      status = 128 + signal
      // The runner's alarm, SIGALRM on Linux and macOS, ends a test that outlives its limit.
      if signal == 14 {
        run writeError(b"silk test: the test did not finish within ")
        run writeError(limit)
        run writeError(b" s; pass --timeout <seconds> to change the limit, or 0 for none\n")
      }
      // A test that stops the runner, such as with a trap, leaves the progress record naming it.
      // A new runner reports that test as failed and continues after it; each restart moves past
      // one test, so the loop ends.
      running = run FileSystem.exists(&progressPath)
    }
  }
  if status >= 0 && status <= 1 {
    let received = run Effect.result(FileSystem.readFile(&receiptPath))
    let mut admitted = false
    if let Result<Bytes, FileError | OutOfMemoryError>.Success {value} = &received {
      if let Option<TestRun.Counts>.Some {value: counts} = move TestRun.admitReceipt(Bytes.asSlice(&plan), Bytes.asSlice(&value), status) {
        admitted = true
        if counts.selected != 0 { matched.* = true }
      }
    }
    drop received
    if !admitted {
      run writeError(b"silk test: the test runner did not write a valid receipt\n")
      status = 2
    }
  }
  run removeQuietly(&planPath)
  run removeQuietly(&receiptPath)
  run removeQuietly(&progressPath)
  return status
}

// Writes one project failure as the TypeScript CLI words it.
effect fn reportProject(problem: &ProjectError) -> () ! WriterError {
  return match &problem.* {
    ProjectError.ManifestNotFound {start} => {
      run writeError(b"No silk.toml found from ")
      run writeError(Path.rawBytes(&start))
      run writeError(b"; run `silk init` to create a package here, or `silk init <name>` for a new folder\n")
    }
    ProjectError.Uninspectable {path} => {
      run writeError(b"Cannot inspect ")
      run writeError(Path.rawBytes(&path))
      run writeError(b" while discovering a Silk project\n")
    }
    ProjectError.Unreadable {manifest} => {
      run writeError(b"Cannot read Silk project manifest ")
      run writeError(Path.rawBytes(&manifest))
      run writeError(b"\n")
    }
    ProjectError.InvalidProfile {manifest, line, code, subject} => run reportProfile(&manifest, line, code, Bytes.asSlice(&subject))
    ProjectError.InvalidManifest {manifest, line, detail} => {
      run writeManifestLocation(&manifest, line)
      run writeError(Bytes.asSlice(&detail))
      run writeError(b"\n")
    }
  }
}

// Builds `sourcePath` in the form and stage its nearest project manifest selects, as the TypeScript
// CLI does; `stage` replaces the manifest's stage. Only the host target links an executable.
//
// The `Compiled` line shows paths relative to `working`, the directory the user named them from.
effect fn buildSource(working: &Path, sourcePath: &Path, output: &Path, stage: Option<Stage>, standardLibrary: Option<Path>,
  input: ProfileInput, stats: bool, clang: &Option<Bytes>) -> i32
! ApplicationError | InitialProfileProblem | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  let directory = match move run Path.parent(sourcePath) {
    Option<Path>.Some {value} => move value
    Option<Path>.None => { fail InvalidSourceRoot {} }
  }
  let project = match move run locateProject(&directory, &Option<Bytes>.none()) {
    Option<Project>.Some {value} => move value
    Option<Project>.None => { return 2 }
  }
  let form = Projects.form(&project)
  let selected = match move stage {
    Option<Stage>.Some {value} => value
    Option<Stage>.None => Projects.stage(&project)
  }
  if form == Form.Library {
    run writeError(b"A library package makes no artifact; check it with `silk check`\n")
    return 2
  }
  // A shared library needs hidden visibility for its non-exported definitions; it is not native yet.
  if form == Form.SharedLibrary {
    run writeError(b"SILK_GAP artifact-form: the ")
    run writeError(Projects.formSpelling(form))
    run writeError(b" form is not native yet\n")
    return 2
  }
  let mut configured = move input
  configured.artifact = Option<Bytes>.some(run Bytes.copy(Projects.profileArtifact(form)))
  let profile = run InitialProfile.freeze(&configured)
  let host = hostTarget()
  if form == Form.Executable && selected == Stage.Final && !linksOn(InitialProfile.target(&profile), &host) {
    return run invalidBuildProfile()
  }
  let automatic = SupplyRequest.Automatic
  let mut silent = Progress.off()
  let built = run build(sourcePath, Option<&Path>.none(), Option<&Path>.none(), output, working, form, selected, move standardLibrary, move profile, Option<usize>.none(), List<Supplied>.make(), &automatic, false, stats, clang, &Option<Bytes>.none(), Option<&[u8]>.none(), true, &mut silent)
  return match move built {
    Compiled.Finished {status} => status
    Compiled.Tests {identities} => {
      drop identities
      return 2
    }
  }
}

// The manifest `--manifest-path` names, or else the nearest one at or above `working`.
effect fn manifestFor(working: &Path, manifestPath: &Option<Bytes>) -> Path
! ApplicationError | ProjectError | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  return match &manifestPath.* {
    Option<Bytes>.Some {value} => run pathArgument(working, Bytes.asSlice(&value))
    Option<Bytes>.None => run Projects.discover(working)
  }
}

effect fn discoveredProject(working: &Path, manifestPath: &Option<Bytes>) -> Project
! ApplicationError | ProjectError | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let manifest = run manifestFor(working, manifestPath)
  return run Projects.load(&manifest)
}

// The projects one building command runs over, and whether they were selected as workspace
// members, which groups each one's report under a header.
struct Selection {
  projects: List<Project>,
  members: bool,
}

// Writes the member names of `workspace`, comma-separated, after `prefix`.
effect fn writeMemberNames(prefix: &[u8], workspace: &Workspace) -> () ! WriterError | OutOfMemoryError ? &mut Allocator {
  let listed = List<Member>.asSlice(&workspace.members)
  let mut line = run Bytes.copy(prefix)
  let mut at = usize.ZERO
  while at < listed.length {
    if at > usize.ZERO { run Bytes.append(&mut line, b", ") }
    run Bytes.append(&mut line, Bytes.asSlice(&listed[at].name))
    at = at + usize.ONE
  }
  if listed.length == usize.ZERO { run Bytes.append(&mut line, b"none") }
  run Bytes.append(&mut line, b"\n")
  run writeError(Bytes.asSlice(&line))
}

// Selects the projects a building command runs over. Without `--package` or `--workspace` it is
// the located project alone, unless its manifest only defines a workspace, which selects every
// member. `--package` names members of the located workspace, or of the one enclosing the located
// project, and `--workspace` selects all of them; a workspace's own package comes first. A member
// whose root module is missing is skipped with a note unless `--package` names it. A selection that
// cannot be made is reported and answers `None`.
effect fn selected(working: &Path, options: &ProjectOptions) -> Option<Selection>
! ApplicationError | ProjectError | FileError | OutOfMemoryError | WriterError ? &mut FileSystem | &mut Allocator {
  let manifest = run manifestFor(working, &options.manifestPath)
  let packages = List<Bytes>.asSlice(&options.packages)
  let explicit = packages.length > usize.ZERO
  let mut found = run Projects.workspace(&manifest)
  let virtual = match &found {
    Option<Workspace>.Some {value} => !value.packaged
    Option<Workspace>.None => false
  }
  let mut projects = List<Project>.make()
  if !explicit && !options.workspace && !virtual {
    run List<Project>.append(&mut projects, run Projects.load(&manifest))
    return Option<Selection>.some(Selection {projects: move projects, members: false})
  }
  if let Option<Workspace>.None = &found {
    if let Option<Path>.Some {value: directory} = move run Path.parent(&manifest) {
      if let Option<Path>.Some {value: enclosing} = move run Projects.enclosingWorkspace(&directory) {
        found = run Projects.workspace(&enclosing)
      }
    }
  }
  let workspace = match move found {
    Option<Workspace>.Some {value} => move value
    Option<Workspace>.None => {
      run writeError(b"silk: --package and --workspace select workspace members, but ")
      run writeError(Path.rawBytes(&manifest))
      run writeError(b" is not in a workspace\n")
      return Option<Selection>.none()
    }
  }
  let listed = List<Member>.asSlice(&workspace.members)
  if explicit {
    let mut at = usize.ZERO
    while at < packages.length {
      let wanted = Bytes.asSlice(&packages[at])
      let mut index = usize.ZERO
      while index < listed.length && !same(Bytes.asSlice(&listed[index].name), wanted) {
        index = index + usize.ONE
      }
      if index < listed.length {
        if !listed[index].rooted {
          run writeError(b"silk: workspace member `")
          run writeError(wanted)
          run writeError(b"` has no root module (its [package].main file is missing), so project commands cannot build it\n")
          return Option<Selection>.none()
        }
        let member = run Path.join(&listed[index].directory, "silk.toml")
        run List<Project>.append(&mut projects, run Projects.load(&member))
      } else {
        let mut rootPackage = false
        if workspace.packaged {
          let root = run Projects.load(&workspace.manifest)
          if same(Projects.name(&root), wanted) {
            rootPackage = true
            run List<Project>.append(&mut projects, move root)
          }
        }
        if !rootPackage {
          run writeError(b"silk: the workspace at ")
          run writeError(Path.rawBytes(&workspace.manifest))
          run writeError(b" has no package named `")
          run writeError(wanted)
          run writeError(b"`\n")
          run writeMemberNames(b"silk: its members are: ", &workspace)
          return Option<Selection>.none()
        }
      }
      at = at + usize.ONE
    }
    return Option<Selection>.some(Selection {projects: move projects, members: true})
  }
  if workspace.packaged {
    run List<Project>.append(&mut projects, run Projects.load(&workspace.manifest))
  }
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].rooted {
      let member = run Path.join(&listed[at].directory, "silk.toml")
      run List<Project>.append(&mut projects, run Projects.load(&member))
    } else {
      run writeError(b"Skipping ")
      run writeError(Bytes.asSlice(&listed[at].name))
      run writeError(b": its root module ([package].main) is missing\n")
      if listed[at].library {
        run writeError(b"  help: its source root has lib.silk; a library sets `kind = \"library\"` and `exports = [\"lib\"]` under [package]\n")
      }
    }
    at = at + usize.ONE
  }
  return Option<Selection>.some(Selection {projects: move projects, members: true})
}

// `selected`, reporting a manifest that cannot be used.
effect fn selectProjects(working: &Path, options: &ProjectOptions) -> Option<Selection>
! ApplicationError | FileError | OutOfMemoryError | WriterError ? &mut FileSystem | &mut Allocator {
  let attempted = run Effect.result(selected(working, options))
  return match move attempted {
    Result<Option<Selection>, ApplicationError | ProjectError | FileError | OutOfMemoryError | WriterError>.Success {value} => move value
    Result<Option<Selection>, ApplicationError | ProjectError | FileError | OutOfMemoryError | WriterError>.Failure {error} => match move error {
      ProjectError problem => {
        run reportProject(&problem)
        return Option<Selection>.none()
      }
      ApplicationError application => { fail move application }
      FileError file => { fail move file }
      OutOfMemoryError exhausted => { fail move exhausted }
      WriterError written => { fail move written }
    }
  }
}

// Writes the header that groups one workspace member's report: `Package <name> (<directory>)`.
effect fn writePackageHeader(project: &Project) -> () ! WriterError | OutOfMemoryError ? &mut Allocator | &mut Writer {
  let mut line = run Bytes.copy(b"Package ")
  run Bytes.append(&mut line, Projects.name(project))
  run Bytes.append(&mut line, b" (")
  run Bytes.append(&mut line, Path.rawBytes(Projects.directory(project)))
  run Bytes.append(&mut line, b")\n")
  run Writer.writeAll(Bytes.asSlice(&line))
}

// Writes `Workspace summary: <n> packages succeeded, <m> failed` after a workspace run.
effect fn writeWorkspaceSummary(succeeded: usize, total: usize) -> () ! WriterError | OutOfMemoryError ? &mut Allocator | &mut Writer {
  let mut summary = run Bytes.copy(b"Workspace summary: ")
  run JsonText.appendDecimal(&mut summary, succeeded)
  if succeeded == usize.ONE {
    run Bytes.append(&mut summary, b" package succeeded, ")
  } else {
    run Bytes.append(&mut summary, b" packages succeeded, ")
  }
  run JsonText.appendDecimal(&mut summary, total - succeeded)
  run Bytes.append(&mut summary, b" failed\n")
  run Writer.writeAll(Bytes.asSlice(&summary))
}

// Loads the project that `--manifest-path` names, or else the one whose manifest is nearest above
// `working`; when there is none it reports why and answers `None`.
effect fn locateProject(working: &Path, manifestPath: &Option<Bytes>) -> Option<Project>
! ApplicationError | FileError | OutOfMemoryError | WriterError ? &mut FileSystem | &mut Allocator {
  let located = run Effect.result(discoveredProject(working, manifestPath))
  return match move located {
    Result<Project, ApplicationError | ProjectError | FileError | OutOfMemoryError>.Success {value} => Option<Project>.some(move value)
    Result<Project, ApplicationError | ProjectError | FileError | OutOfMemoryError>.Failure {error} => match move error {
      ProjectError problem => {
        run reportProject(&problem)
        return Option<Project>.none()
      }
      ApplicationError application => { fail move application }
      FileError file => { fail move file }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// The output directory `clean` removes: the located project's, or the workspace's when the
// manifest only defines a workspace.
effect fn cleanedOutput(working: &Path, manifestPath: &Option<Bytes>) -> Path
! ApplicationError | ProjectError | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let manifest = run manifestFor(working, manifestPath)
  if let Option<Workspace>.Some {value: workspace} = move run Projects.workspace(&manifest) {
    if !workspace.packaged {
      return move workspace.outputDirectory
    }
  }
  let project = run Projects.load(&manifest)
  return run Path.fromBytes(Path.rawBytes(Projects.outputDirectory(&project)))
}

// Removes the project's output directory, or says there is nothing to clean: status 0, or 2 when
// it cannot.
effect fn cleanProject(working: &Path, command: CleanCommand) -> i32
! ApplicationError | FileError | OutOfMemoryError | WriterError ? &mut FileSystem | &mut Allocator | &mut Writer {
  let located = run Effect.result(cleanedOutput(working, &command.manifestPath))
  let directory = match move located {
    Result<Path, ApplicationError | ProjectError | FileError | OutOfMemoryError>.Success {value} => move value
    Result<Path, ApplicationError | ProjectError | FileError | OutOfMemoryError>.Failure {error} => match move error {
      ProjectError problem => {
        run reportProject(&problem)
        return 2
      }
      ApplicationError application => { fail move application }
      FileError file => { fail move file }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let output = Path.rawBytes(&directory)
  let directoryExists = run CommandPath.exists(output, true)
  let fileExists = run CommandPath.exists(output, false)
  if !directoryExists && !fileExists {
    run Writer.writeAll(b"Nothing to clean: ")
    run Writer.writeAll(output)
    run Writer.writeAll(b" does not exist\n")
    return 0
  }
  // A copy of an earlier build may still be writing its cache there.
  run SemanticCache.settle(&directory)
  let removed = run Effect.result(Projects.removeOutput(&directory))
  return match move removed {
    Result<(), FileError | OutOfMemoryError>.Success {value: _} => {
      run Writer.writeAll(b"Removed ")
      run Writer.writeAll(output)
      run Writer.writeAll(b"\n")
      return 0
    }
    Result<(), FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => {
        drop failure
        run writeError(b"Cannot remove build directory ")
        run writeError(output)
        run writeError(b"\n")
        return 2
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// One attempted project compilation.
struct ProjectArtifact {
  status: i32,
  target: Target,
  path: Path,
}

// Writes `value` in decimal.
effect fn writeDecimal(value: usize) -> () ! WriterError {
  if value >= 10 { run writeDecimal(usize.divide(value, 10)) }
  return run writeError(&[usize.toU8(48 + usize.remainder(value, 10))])
}

// Writes `Invalid Silk project manifest <manifest>:<line>: `, without the line when it is zero.
// Writes a refused dependency: at the manifest line that is at fault, as other manifest errors are,
// or with `silk: invalid` when no manifest line is.
effect fn writeDependency(invalid: &InvalidDependency) -> () ! WriterError {
  if Bytes.asSlice(&invalid.manifest).length > usize.ZERO {
    run writeError(b"Invalid Silk project manifest ")
    run writeError(Bytes.asSlice(&invalid.manifest))
    if invalid.line > usize.ZERO {
      run writeError(b":")
      run writeDecimal(invalid.line)
    }
    run writeError(b": ")
  } else {
    run writeError(b"silk: invalid ")
  }
  run writeError(Bytes.asSlice(&invalid.detail))
  return run writeError(b"\n")
}

effect fn writeManifestLocation(manifest: &Path, line: usize) -> () ! WriterError {
  run writeError(b"Invalid Silk project manifest ")
  run writeError(Path.rawBytes(manifest))
  if line > usize.ZERO {
    run writeError(b":")
    run writeDecimal(line)
  }
  return run writeError(b": ")
}

// Writes a refused profile or binding of the manifest `manifest` at `line`: an unknown field or a
// value the native compiler cannot honor yet in words, else the TypeScript `<code>: <subject>`.
effect fn reportProfile(manifest: &Path, line: usize, code: ProfileCode, subject: &[u8]) -> () ! WriterError {
  run writeManifestLocation(manifest, line)
  return run writeProfileReason(code, subject)
}

// Writes why a profile or binding was refused, as [`reportProfile`] words it after its location.
effect fn writeProfileReason(code: ProfileCode, subject: &[u8]) -> () ! WriterError {
  match code {
    ProfileCode.UnknownField => {
      run writeError(subject)
      run writeError(b" is not a supported field")
    }
    ProfileCode.NotNative => {
      run writeError(subject)
      run writeError(b" is not supported by the native compiler yet")
    }
    _ => {
      run writeError(ProjectProfiles.codeName(code))
      run writeError(b": ")
      run writeError(subject)
    }
  }
  return run writeError(b"\n")
}

// Writes the TypeScript refusal of `--release` with another `--optimization`.
effect fn reportOptimizationConflict(options: &ProjectOptions) -> () ! WriterError {
  run writeError(b"--release conflicts with --optimization ")
  if let Option<Bytes>.Some {value} = &options.optimization {
    run writeError(Bytes.asSlice(&value))
  }
  run writeError(b"\n")
}

// Plans the project's compilations (see `driver/ProjectPlan`), or answers `None` after reporting
// why there are none as the TypeScript CLI words it.
effect fn projectPlans(project: &Project, options: &ProjectOptions, fallback: &[Bytes]) -> Option<List<ProjectPlan>>
! TomlError | OutOfMemoryError | WriterError ? &mut Allocator {
  let planned = run Effect.result(ProjectPlans.make(project, options, fallback, hostTarget()))
  return match move planned {
    Result<List<ProjectPlan>, PlanError | TomlError | OutOfMemoryError>.Success {value} => Option<List<ProjectPlan>>.some(move value)
    Result<List<ProjectPlan>, PlanError | TomlError | OutOfMemoryError>.Failure {error} => match move error {
      PlanError problem => {
        match move problem {
          PlanError.ConflictingSelection => run writeError(b"Named/full profiles conflict with target and optimization flags\n")
          PlanError.UnknownTarget {selector} => {
            run writeError(b"Unsupported target ")
            run writeError(Bytes.asSlice(&selector))
            run writeError(b"\n")
          }
          PlanError.Profile {code, subject, key} => {
            // A refused `--profile-input` field is the command line's, not the manifest's.
            let named = Bytes.asSlice(&key)
            let flag = b"--profile-input"
            if named.length >= flag.length && same(Slice.view<u8>(named, usize.ZERO, flag.length), flag) {
              run writeError(b"Invalid --profile-input: ")
              run writeProfileReason(code, Bytes.asSlice(&subject))
            } else {
              run reportProfile(Projects.manifest(project), Projects.line(project, named), code, Bytes.asSlice(&subject))
            }
          }
          PlanError.InvalidProfileInput => run writeError(b"Invalid --profile-input JSON\n")
        }
        return Option<List<ProjectPlan>>.none()
      }
      TomlError malformed => { fail move malformed }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// Builds one planned compilation into `<output-dir>/llvm/<target>/<profile>/`, where the profile
// directory is the named project profile the plan builds, or else `debug`, `release` or
// `release-with-debug` from the plan's optimization and debug information, in the form and stage the manifest selects and with the file name
// `Projects.artifact` gives. A plan whose profile names no artifact takes the manifest's form.
// Only the host target links an executable, and a shared library is not native yet.
fn silentProgress() -> ProgressSettings {
  return ProgressSettings {display: ProgressDisplay.Off, color: false, width: 80, quiet: false, compact: false, position: 0, units: 0, timings: false}
}

// How `build`, `check` and `run` report progress on standard error, from `--progress`, `--quiet`,
// SILK_PROGRESS and NO_COLOR. `--progress` wins over SILK_PROGRESS; `auto`, the default, redraws a
// live line only when standard error is a terminal that understands cursor movement, and writes
// plain lines otherwise. A command over several `units` shows one line per finished unit.
effect fn progressSettings(options: &ProjectOptions, units: usize) -> ProgressSettings
! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let mut chosen = run Bytes.copy(b"auto")
  if let Option<Bytes>.Some {value} = move run HostInput.variableNamed("SILK_PROGRESS") {
    if ProjectCommands.isProgressDisplay(Bytes.asSlice(&value)) { chosen = move value }
  }
  if let Option<Bytes>.Some {value} = &options.progress { chosen = run Bytes.copy(Bytes.asSlice(&value)) }
  let mut display = ProgressDisplay.Plain
  if same(Bytes.asSlice(&chosen), b"never") {
    display = ProgressDisplay.Off
  } else if same(Bytes.asSlice(&chosen), b"live") {
    display = ProgressDisplay.Live
  } else if same(Bytes.asSlice(&chosen), b"auto") && run NativeDescriptor.isTerminal(2) {
    display = ProgressDisplay.Live
    if let Option<Bytes>.Some {value: terminal} = move run HostInput.variableNamed("TERM") {
      if same(Bytes.asSlice(&terminal), b"dumb") { display = ProgressDisplay.Plain }
    }
  }
  let mut color = true
  if let Option<Bytes>.Some {value} = move run HostInput.variableNamed("NO_COLOR") {
    color = Bytes.length(&value) == usize.ZERO
  }
  let mut width: usize = 80
  if let Option<Bytes>.Some {value: columns} = move run HostInput.variableNamed("COLUMNS") {
    let digits = Bytes.asSlice(&columns)
    let mut parsed = usize.ZERO
    let mut at = usize.ZERO
    while at < digits.length && at < 5 && digits[at] >= 48 && digits[at] <= 57 {
      parsed = parsed * 10 + u8.toUsize(digits[at] - 48)
      at = at + usize.ONE
    }
    if at == digits.length && parsed >= 20 { width = parsed }
  }
  return ProgressSettings {display: display, color: color, width: width, quiet: options.quiet, compact: units > usize.ONE, position: 0, units: units, timings: options.timings}
}

// Starts one unit's progress report: `<verb> <package> (<target>, <profile>)`.
effect fn startProgress(settings: &ProgressSettings, verb: &[u8], project: &Project, target: &Target, profile: &[u8]) -> Progress
! OutOfMemoryError ? &mut Allocator {
  let mut detail = run Bytes.copy(Target.name(target))
  if profile.length > usize.ZERO {
    run Bytes.append(&mut detail, b", ")
    run Bytes.append(&mut detail, profile)
  }
  return run Progress.start(settings, verb, Projects.name(project), Bytes.asSlice(&detail))
}

// After several packages: `Finished 3 packages in <time>` or `Failed 1 of 3 packages in <time>`.
effect fn writeUnitsSummary(settings: &ProgressSettings, started: Progress, succeeded: usize, total: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut whole = move started
  let mut what = Bytes.make()
  if succeeded < total {
    run Progress.appendCount(&mut what, total - succeeded)
    run Bytes.append(&mut what, b" of ")
  }
  run Progress.appendCount(&mut what, total)
  if total == usize.ONE {
    run Bytes.append(&mut what, b" package")
  } else {
    run Bytes.append(&mut what, b" packages")
  }
  run Progress.finish(&mut whole, Bytes.asSlice(&what), succeeded == total)
}

// The reporter that times a whole multi-package command; it writes only its final line.
effect fn unitsProgress(settings: &ProgressSettings) -> Progress ! OutOfMemoryError ? &mut Allocator {
  let whole = ProgressSettings {display: settings.display, color: settings.color, width: settings.width, quiet: true, compact: false, position: 0, units: 0, timings: false}
  return run Progress.start(&whole, b"", b"", b"")
}

effect fn buildProjectTarget(project: &Project, plan: ProjectPlan, standardLibrary: &Option<Path>, clang: &Option<Bytes>, headed: bool, abandon: bool, settings: &ProgressSettings) -> ProjectArtifact
! ApplicationError | InitialProfileProblem | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  // A library is Silk source for other packages: building it checks it and makes no artifact.
  if Projects.form(project) == Form.Library {
    return run checkTarget(project, move plan, standardLibrary, false, false, settings)
  }
  let ProjectPlan {input: planned, bindings, name: profileNamed, maxMemory} = move plan
  let form = Projects.form(project)
  let stage = Projects.stage(project)
  let mut input = move planned
  if let Option<Bytes>.None = &input.artifact {
    input.artifact = Option<Bytes>.some(run Bytes.copy(Projects.profileArtifact(form)))
  }
  let profile = run InitialProfile.freeze(&input)
  let target = Target.forId(Target.id(InitialProfile.target(&profile)))
  let optimization = match move InitialProfile.text(&profile, b"optimization") {
    Option<&[u8]>.Some {value} => value
    Option<&[u8]>.None => run invalidBuildProfile()
  }
  let debug = match move InitialProfile.flag(&profile, b"debug") {
    Option<bool>.Some {value} => value
    Option<bool>.None => run invalidBuildProfile()
  }
  let profileName = run Projects.profileDirectory(&profileNamed, optimization, debug)
  let path = run Projects.artifact(project, Target.name(&target), Bytes.asSlice(&profileName))
  if form == Form.SharedLibrary {
    run writeError(b"SILK_GAP artifact-form: the ")
    run writeError(Projects.formSpelling(form))
    run writeError(b" form is not native yet\n")
    return ProjectArtifact {status: 2, target: target, path: move path}
  }
  if form == Form.Executable && stage == Stage.Final && !linksOn(&target, &hostTarget()) {
    run writeError(b"Cannot link an executable for target ")
    run writeError(Target.name(&target))
    run writeError(b" on host ")
    run writeError(Target.name(&hostTarget()))
    run writeError(b"\n")
    return ProjectArtifact {status: 2, target: target, path: move path}
  }
  if let Option<Path>.Some {value: directory} = move run Path.parent(&path) {
    run FileSystem.createDirectoriesRecursively(&directory)
  }
  let library = match &standardLibrary.* {
    Option<Path>.Some {value} => Option<Path>.some(run Path.fromBytes(Path.rawBytes(&value)))
    Option<Path>.None => Option<Path>.none()
  }
  // A headed build names its target before its diagnostics, as `silk check` does.
  let mut heading = Option<Bytes>.none()
  if headed { heading = Option<Bytes>.some(run Bytes.copy(Target.name(&target))) }
  let mut progress = run startProgress(settings, b"Compiling", project, &target, Bytes.asSlice(&profileName))
  let cacheHome = run SemanticCache.directory(Projects.outputDirectory(project), Projects.name(project))
  // An executable whose last build read the same files as this one would is reused as it is, so a
  // build that changes nothing reads its inputs and nothing else (`reusedBuild`).
  let record = run reuseRecordFor(&path)
  let mut key = Option<Bytes>.none()
  if form == Form.Executable && stage == Stage.Final {
    let manifestPath = Option<&Path>.some(Projects.manifest(project))
    key = run testBuildKey(b"silk-build-1", Projects.entry(project), &manifestPath, &path, Projects.directory(project), standardLibrary, &profile,
      &bindings, clang)
    let current = move key
    key = run withMemoryLimit(move current, &maxMemory)
  }
  let mut reused = false
  if let Option<Bytes>.Some {..} = &key { reused = run reusedBuild(&record, &key, &path) }
  let mut built = Compiled.Finished {status: 0}
  if !reused {
    run removeQuietly(&record)
    let mut recorder = run BuildInputs.recorder()
    // The caches beside the artifact are the build's own, and the record checks the artifact by
    // its digest.
    run BuildInputs.exclude(&mut recorder, &run CodegenCache.directoryFor(&path))
    if let Option<Path>.Some {value: cached} = &cacheHome { run BuildInputs.exclude(&mut recorder, &cached) }
    run BuildInputs.exclude(&mut recorder, &path)
    run BuildInputs.exclude(&mut recorder, &run symbolMapFor(&path))
    run BuildInputs.exclude(&mut recorder, &record)
    built = run build(Projects.entry(project), Option<&Path>.some(Projects.manifest(project)),
      borrowedPath(&cacheHome), &path, Projects.directory(project), form, stage, move library, move profile, move maxMemory, move bindings, Projects.supply(project), false, false, clang, &heading, Option<&[u8]>.none(), abandon, &mut progress)
      |> Effect.provideMut<FileSystem>(&mut recorder)
    let succeeded = match &built {
      Compiled.Finished {status} => status == 0
      Compiled.Tests {..} => false
    }
    if let Option<Bytes>.Some {value: stamped} = &key {
      if succeeded && BuildInputs.complete(&recorder) { run recordBuild(&record, Bytes.asSlice(&stamped), &recorder, &path) }
    }
  }
  if Progress.enabled(&progress) {
    let finished = match &built {
      Compiled.Finished {status} => status == 0
      Compiled.Tests {..} => false
    }
    // A finished build names its artifact; a failed one names the package.
    let mut shown = run Bytes.copy(Projects.name(project))
    if finished {
      // Named from the working directory, as the `Compiled` line names its paths.
      let workingDirectory = run HostInput.workingDirectory()
      let working = run Path.fromBytes(Bytes.asSlice(&workingDirectory))
      shown = run shownPath(&working, &path)
    }
    run Progress.finish(&mut progress, Bytes.asSlice(&shown), finished)
  }
  return match move built {
    Compiled.Finished {status} => ProjectArtifact {status: status, target: target, path: move path}
    Compiled.Tests {identities} => {
      drop identities
      return ProjectArtifact {status: 2, target: target, path: move path}
    }
  }
}

// The `--clang` selection: a path resolves against the working directory; a bare name is searched
// on PATH when the build runs Clang. Absent without `--clang`, for SILK_CLANG or the PATH search.
effect fn clangFor(working: &Path, configured: &Option<Bytes>) -> Option<Bytes>
! ApplicationError | OutOfMemoryError ? &mut Allocator {
  return match &configured.* {
    Option<Bytes>.Some {value} => {
      if CommandPath.contains(Bytes.asSlice(&value), 47) {
        let resolved = run pathArgument(working, Bytes.asSlice(&value))
        return Option<Bytes>.some(run Bytes.copy(Path.rawBytes(&resolved)))
      }
      return Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&value)))
    }
    Option<Bytes>.None => Option<Bytes>.none()
  }
}

// The standard-library root: the `--stdlib` argument resolved against the working directory, or
// else the library installed beside this compiler (`<prefix>/lib/silk/stdlib`), when there is one.
effect fn standardLibraryFor(working: &Path, configured: &Option<Bytes>) -> Option<Path>
! ApplicationError | HostInputError | OutOfMemoryError ? &mut FileSystem | &mut HostInput | &mut Allocator {
  if let Option<Bytes>.Some {value} = &configured.* {
    let written = run pathArgument(working, Bytes.asSlice(&value))
    // A linked library is read at its real directory, so every spelling of it names one root.
    let mut directory = move written
    if let Option<Bytes>.Some {value: real} = move run CommandPath.canonical(Path.rawBytes(&directory)) {
      if let Option<Path>.Some {value: resolved} = move run CommandPath.pathOf(Bytes.asSlice(&real)) { directory = move resolved }
    }
    // Every standard library carries its runtime catalog; without one the build would only find
    // that it selects no runtime (ARTIFACT-001).
    let mut catalog = run Bytes.copy(Path.rawBytes(&directory))
    run Bytes.append(&mut catalog, b"/compositions.json")
    if !run CommandPath.exists(Bytes.asSlice(&catalog), false) {
      let missing = !run CommandPath.exists(Path.rawBytes(&directory), true)
      fail ApplicationError.NotStandardLibrary {directory: run Bytes.copy(Path.rawBytes(&directory)), missing: missing}
    }
    return Option<Path>.some(move directory)
  }
  let invoked = match move run HostInput.argument(usize.ZERO) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return Option<Path>.none() }
  }
  let searchPath = run HostInput.variableNamed("PATH")
  return match &searchPath {
    Option<Bytes>.Some {value} => run InstalledCompiler.standardLibrary(working, Bytes.asSlice(&invoked), Option<&[u8]>.some(Bytes.asSlice(&value)))
    Option<Bytes>.None => run InstalledCompiler.standardLibrary(working, Bytes.asSlice(&invoked), Option<&[u8]>.none())
  }
}

// Builds every planned compilation of the project in order; each reports its progress on standard
// error. The status is 2 when any compilation failed operationally,
// else 1 when any build was refused, else 0.
effect fn buildProject(working: &Path, command: BuildCommand) -> i32
! ApplicationError | InitialProfileProblem | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let BuildCommand {options} = move command
  if ProjectCommands.conflicting(&options) {
    run reportOptimizationConflict(&options)
    return 2
  }
  let selection = match move run selectProjects(working, &options) {
    Option<Selection>.Some {value} => move value
    Option<Selection>.None => { return 2 }
  }
  let standardLibrary = run standardLibraryFor(working, &options.standardLibrary)
  let clang = run clangFor(working, &options.clang)
  let projects = List<Project>.asSlice(&selection.projects)
  let mut settings = run progressSettings(&options, projects.length)
  let whole = run unitsProgress(&settings)
  let mut status = 0
  let mut succeeded = usize.ZERO
  let mut at = usize.ZERO
  while at < projects.length {
    if selection.members { settings.position = at + usize.ONE }
    let built = run memberStatus(run Effect.result(buildOne(&projects[at], &options, &standardLibrary, &clang, &settings, at + usize.ONE == projects.length)))
    if built == 0 { succeeded = succeeded + usize.ONE }
    status = worse(status, built)
    at = at + usize.ONE
  }
  if selection.members { run writeUnitsSummary(&settings, move whole, succeeded, projects.length) }
  return status
}

// The status of one selected project's command. A failure that stops it, such as an invalid
// dependency, is reported here and counts as status 1, so the remaining workspace members still
// run and the workspace summary is still written.
effect fn memberStatus(outcome: Result<i32, ApplicationError | InitialProfileProblem | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError>) -> i32 ! WriterError {
  return match move outcome {
    Result<i32, ApplicationError | InitialProfileProblem | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError>.Success {value} => value
    Result<i32, ApplicationError | InitialProfileProblem | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError>.Failure {error} => {
      let reported = run report(move error)
      drop reported
      return 1
    }
  }
}

// Builds one project's planned compilations, as `buildProject` does for each selected project.
// One package's settings: compact when the command spans several packages or this package plans
// several targets.
fn unitSettings(packages: &ProgressSettings, targets: usize) -> ProgressSettings {
  return ProgressSettings {display: packages.display, color: packages.color, width: packages.width, quiet: packages.quiet,
    compact: packages.compact || targets > usize.ONE, position: packages.position, units: packages.units, timings: packages.timings}
}

effect fn buildOne(project: &Project, options: &ProjectOptions, standardLibrary: &Option<Path>, clang: &Option<Bytes>, packages: &ProgressSettings, last: bool) -> i32
! ApplicationError | InitialProfileProblem | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let mut plans = match move run projectPlans(project, options, Projects.targets(project)) {
    Option<List<ProjectPlan>>.Some {value} => move value
    Option<List<ProjectPlan>>.None => { return 2 }
  }
  let settings = unitSettings(packages, List<ProjectPlan>.length(&plans))
  let mut attempts = List<ProjectArtifact>.make()
  while List<ProjectPlan>.length(&plans) > usize.ZERO {
    let plan = List<ProjectPlan>.remove(&mut plans, usize.ZERO)
    run List<ProjectArtifact>.append(&mut attempts, run buildProjectTarget(project, move plan, standardLibrary, clang, true, last && List<ProjectPlan>.length(&plans) == usize.ZERO, &settings))
  }
  // Each attempt has reported itself on standard error, so only the status is left to combine.
  let attempted = List<ProjectArtifact>.asSlice(&attempts)
  let mut status = 0
  let mut at = usize.ZERO
  while at < attempted.length {
    if attempted[at].status != 0 {
      if attempted[at].status == 2 || status == 2 { status = 2 } else { status = 1 }
    }
    at = at + usize.ONE
  }
  return status
}

// Writes one target's diagnostics to standard error: after a `[<target>]` header in the human
// format, as the TypeScript `silk check` does, and only when there are any.
effect fn writeDiagnostics(target: &Target, json: bool, diagnostics: &Bytes, progress: &mut Progress) -> () ! WriterError {
  if Bytes.length(diagnostics) == usize.ZERO {
    return ()
  }
  // A compact report keeps its live line between phases; it is cleared before the diagnostics.
  run Progress.clear(&mut progress.*)
  if !json {
    run writeError(b"[")
    run writeError(Target.name(target))
    run writeError(b"]\n")
  }
  run writeError(Bytes.asSlice(diagnostics))
}

// Analyzes the project for one planned compilation without producing an artifact: every
// root-package declaration is checked, used or not (MODULE-004), with the syntax of every loaded
// module and the imports of every reached one. Diagnostics go to standard error in `format`,
// after a `[<target>]` header in the human format, as the TypeScript `silk check` writes them.
// The status is 0, 1 when a declaration is rejected, or 2 for an unsupported construct.
effect fn checkTarget(project: &Project, plan: ProjectPlan, standardLibrary: &Option<Path>, json: bool, roots: bool, settings: &ProgressSettings) -> ProjectArtifact
! ApplicationError | InitialProfileProblem | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  let ProjectPlan {input: planned, bindings, name: _, maxMemory: unlimited} = move plan
  drop unlimited
  let mut input = move planned
  if let Option<Bytes>.None = &input.artifact {
    input.artifact = Option<Bytes>.some(run Bytes.copy(Projects.profileArtifact(Projects.form(project))))
  }
  let profile = run InitialProfile.freeze(&input)
  let target = Target.forId(Target.id(InitialProfile.target(&profile)))
  let path = run Path.fromBytes(Path.rawBytes(Projects.manifest(project)))
  let library = match &standardLibrary.* {
    Option<Path>.Some {value} => Option<Path>.some(run Path.fromBytes(Path.rawBytes(&value)))
    Option<Path>.None => Option<Path>.none()
  }
  let mut format = DiagnosticFormat.Human {root: run diagnosticRoot(Projects.manifest(project))}
  if json { format = DiagnosticFormat.Json {target: run Bytes.copy(Target.name(&target))} }
  let mut out = Bytes.make()
  let mut progress = run startProgress(settings, b"Checking", project, &target, b"")
  // A compiler that can stamp a cache checks on a revisable store, whose module checks the next
  // check reuses from the project's cache file.
  let compiler = run CacheStamp.compiler()
  let mut revisable = false
  if let Option<Bytes>.Some {..} = &compiler { revisable = true }
  let cacheHome = run SemanticCache.directory(Projects.outputDirectory(project), Projects.name(project))
  // The cache file is read and decoded while the sources load.
  let mut prefetched = Option<SemanticCache.Prefetch>.none()
  if let Option<Bytes>.Some {..} = &compiler {
    if let Option<Path>.Some {value: directory} = &cacheHome { prefetched = run SemanticCache.prefetch(&directory, false) }
  }
  let prepared = run prepare(Projects.entry(project), Option<&Path>.some(Projects.manifest(project)), move library, &profile, move bindings, false, revisable, Option<&[u8]>.none(), borrowedPath(&cacheHome), &compiler, &format, &mut out, &mut progress)
  let analysis = match move prepared {
    Prepared.Ready {analysis} => move analysis
    Prepared.Finished {status} => {
      run writeDiagnostics(&target, json, &out, &mut progress)
      run Progress.finish(&mut progress, Projects.name(project), status == 0)
      return ProjectArtifact {status: status, target: target, path: move path}
    }
  }
  let Analysis {sources, store: analyzed, request: requested, rootPackage: _, checked: sweptModules, identity, runtime} = move analysis
  let mut store = move analyzed
  let mut request = move requested
  let mut cache = Option<CacheFile>.none()
  if let Option<Bytes>.Some {value: stamped} = &compiler {
    if let Option<Path>.Some {value: directory} = &cacheHome {
      cache = run SemanticCache.openPrefetched(&mut store, &request, &directory, Bytes.asSlice(&stamped), false, false, move prefetched)
    }
  }
  let mut status = 0
  let mut checkedModules = List<ModuleId>.length(&sweptModules)
  if let Option<ModuleId>.Some {..} = &runtime { checkedModules = checkedModules + usize.ONE }
  run Progress.begin(&mut progress, ProgressPhase.Check, checkedModules)
  Semantic.selectProgress(&mut store, move progress)
  // A diagnostic several answers reach, such as an import's refused module or a `main` result the
  // runtime and the sweep both refuse, prints once.
  let mut seen = List<ReportedSite>.make()
  // An executable's runtime is checked against the application too, so `check` reports a `main`
  // the runtime cannot start, as `build` does. Only those refusals are reported from it.
  if let Option<ModuleId>.Some {value: selected} = &runtime {
    let mut started = List<ModuleId>.make()
    run List<ModuleId>.append(&mut started, ModuleId.copy(&selected))
    let entered = run Semantic.checkDeclarations(&mut store, &mut request, List<ModuleId>.asSlice(&started), &runtime)
    let refused = List<Shared<Rejection>>.asSlice(&entered.rejections)
    let mut refusal = usize.ZERO
    while refusal < refused.length {
      if let Option<Shared<Rejection>>.Some {value: moved} = move run entryRejection(&mut store, &mut request, &sources, &identity, &runtime, &refused[refusal]) {
        if !run repeated(&mut seen, &moved) {
          status = worse(status, run reportRejection(&sources, &moved, &format, &mut out))
        }
      }
      refusal = refusal + usize.ONE
    }
  }
  let checked = run Semantic.checkDeclarations(&mut store, &mut request, List<ModuleId>.asSlice(&sweptModules), &runtime)
  progress = Semantic.takeProgress(&mut store)
  let syntax = run Semantic.syntaxRejections(&store)
  let malformed = List<Shared<Rejection>>.asSlice(&syntax)
  let mut at = usize.ZERO
  while at < malformed.length {
    if !run repeated(&mut seen, &malformed[at]) {
      status = worse(status, run reportRejection(&sources, &malformed[at], &format, &mut out))
    }
    at = at + usize.ONE
  }
  let importRejected = run Semantic.importRejections(&mut store, &mut request)
  status = worse(status, run reportedImportRejections(List<Shared<Rejection>>.asSlice(&importRejected), &sources, &format, &mut out, &mut seen))
  // Malformed syntax leaves later phases without a complete tree, so their refusals of the
  // recovered constructs are not reported next to the syntax errors that caused them.
  let parsed = malformed.length == usize.ZERO
  let rejected = List<Shared<Rejection>>.asSlice(&checked.rejections)
  at = usize.ZERO
  while at < rejected.length {
    if parsed || diagnosticStatus(&rejected[at]) == 1 {
      // A `main` result no runtime starts is reported as the runtime's refusal (SEM0225).
      let shown = match move run entryRejection(&mut store, &mut request, &sources, &identity, &runtime, &rejected[at]) {
        Option<Shared<Rejection>>.Some {value} => move value
        Option<Shared<Rejection>>.None => Shared<Rejection>.clone(&rejected[at])
      }
      if !run repeated(&mut seen, &shown) {
        status = worse(status, run reportRejection(&sources, &shown, &format, &mut out))
      }
    }
    at = at + usize.ONE
  }
  if parsed && List<Shared<Gap>>.length(&checked.gaps) > usize.ZERO {
    // `--json` keeps the machine record; the human format names each gap's location.
    let mut message = Bytes.make()
    if json {
      message = run gapSummary(List<Shared<Gap>>.asSlice(&checked.gaps))
    } else {
      message = run gapLines(&sources, List<Shared<Gap>>.asSlice(&checked.gaps), List<ReportedSite>.asSlice(&seen), humanRoot(&format))
    }
    run Bytes.append(&mut out, Bytes.asSlice(&message))
    status = 2
  }
  if roots {
    let compared = run CheckRoots.compare(&mut store, &mut request, List<ModuleId>.asSlice(&sweptModules), &runtime, rejected)
    run Bytes.append(&mut out, Bytes.asSlice(&compared.report))
    if compared.differences > usize.ZERO {
      status = worse(status, 1)
    }
  }
  if let Option<CacheFile>.Some {value: file} = &cache {
    run SemanticCache.save(&mut store, &file)
    if let Option<Path>.Some {value: directory} = &cacheHome { run saveParsed(&directory, &sources, &store) }
  }
  if status == 0 {
    run Progress.end(&mut progress, b"")
    run Progress.borrowRow(&mut progress)
  } else {
    run Progress.refuse(&mut progress, List<ReportedSite>.length(&seen))
  }
  run writeDiagnostics(&target, json, &out, &mut progress)
  run Progress.finish(&mut progress, Projects.name(project), status == 0)
  return ProjectArtifact {status: status, target: target, path: move path}
}

// Reads the edit script of `check --replay`, or writes why it cannot and answers none.
effect fn replayScript(path: &Path) -> Option<List<Edit>>
! FileError | WriterError | OutOfMemoryError
? &mut FileSystem | &mut Allocator {
  let text = run FileSystem.readFile(path)
  let parsed = match move run Effect.result(Toml.parse(Bytes.asSlice(&text))) {
    Result<TomlValue, TomlError | OutOfMemoryError>.Success {value} => move value
    Result<TomlValue, TomlError | OutOfMemoryError>.Failure {error} => match move error {
      TomlError malformed => {
        drop malformed
        run writeReplayRefusal(path, b"it is not valid TOML")
        return Option<List<Edit>>.none()
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  return match move run Effect.result(EditReplays.read(&parsed)) {
    Result<List<Edit>, InvalidReplayScript | OutOfMemoryError>.Success {value} => Option<List<Edit>>.some(move value)
    Result<List<Edit>, InvalidReplayScript | OutOfMemoryError>.Failure {error} => match move error {
      InvalidReplayScript invalid => {
        run writeReplayRefusal(path, Bytes.asSlice(&invalid.detail))
        return Option<List<Edit>>.none()
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

effect fn writeReplayRefusal(path: &Path, reason: &[u8]) -> () ! WriterError | OutOfMemoryError ? &mut Allocator {
  let mut line = run Bytes.copy(b"silk: invalid replay script ")
  run Bytes.append(&mut line, Path.rawBytes(path))
  run Bytes.append(&mut line, b": ")
  run Bytes.append(&mut line, reason)
  run Bytes.append(&mut line, b"\n")
  run writeError(Bytes.asSlice(&line))
}

// The microseconds from `start` to `end` on one monotonic timeline.
fn elapsedMicroseconds(start: &Instant, end: &Instant) -> usize {
  let seconds = SystemClock.seconds(end) - SystemClock.seconds(start)
  let nanoseconds = SystemClock.nanoseconds(end) - SystemClock.nanoseconds(start)
  return i64.toUsize(seconds * 1000000 + nanoseconds / 1000)
}

// Demands what `check` does of the root package and answers the rejections it reached: its
// declarations' and every parsed module's syntax errors.
// Drops what a long-lived store and request no longer need after a check, as the language
// server does: the request's roots and the lowered MIR no answer names.
effect fn releaseReplayed(store: &mut Semantic, request: &mut SemanticRequest) -> () ! OutOfMemoryError ? &mut Allocator {
  SemanticRequest.forgetRoots(&mut request.*)
  drop run Semantic.releaseStaleMir(&mut store.*, &request.*)
  return ()
}

effect fn replayCheck(store: &mut Semantic, request: &mut SemanticRequest, roots: &[ModuleId], runtime: &Option<ModuleId>) -> List<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let zone = Profiler.zone(b"replayCheck")
  if let Option<ModuleId>.Some {value: selected} = &runtime.* {
    let mut started = List<ModuleId>.make()
    run List<ModuleId>.append(&mut started, ModuleId.copy(&selected))
    let entered = run Semantic.checkDeclarations(&mut store.*, &mut request.*, List<ModuleId>.asSlice(&started), runtime)
    drop entered
  }
  let checked = run Semantic.checkDeclarations(&mut store.*, &mut request.*, roots, runtime)
  let syntax = run Semantic.syntaxRejections(&store.*)
  drop zone
  let mut reached = List<Shared<Rejection>>.make()
  let declared = List<Shared<Rejection>>.asSlice(&checked.rejections)
  let mut at = usize.ZERO
  while at < declared.length {
    run List<Shared<Rejection>>.append(&mut reached, Shared<Rejection>.clone(&declared[at]))
    at = at + usize.ONE
  }
  let malformed = List<Shared<Rejection>>.asSlice(&syntax)
  at = usize.ZERO
  while at < malformed.length {
    run List<Shared<Rejection>>.append(&mut reached, Shared<Rejection>.clone(&malformed[at]))
    at = at + usize.ONE
  }
  return move reached
}

// A rejection as the differential check compares it: `<module> <code> <start>-<end>`.
effect fn rejectionSite(rejection: &Shared<Rejection>) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut site = Bytes.make()
  let code = Shared<Rejection>.with<RejectionCode>(rejection, fn(held: &Rejection) -> RejectionCode { return held.code })
  let span = Shared<Rejection>.with<Span>(rejection, fn(held: &Rejection) -> Span { return held.span })
  let path = Shared<Rejection>.with<ModuleId>(rejection, fn(held: &Rejection) -> ModuleId { return ModuleId.copy(&held.module) })
  run ModuleId.appendPath(&path, &mut site)
  run Bytes.append(&mut site, b" ")
  run Bytes.append(&mut site, Rejections.stableCode(code))
  run Bytes.append(&mut site, b" ")
  run JsonText.appendDecimal(&mut site, span.start)
  run Bytes.append(&mut site, b"-")
  run JsonText.appendDecimal(&mut site, span.end)
  return move site
}

effect fn rejectionSites(rejections: &[Shared<Rejection>]) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut sites = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < rejections.length {
    run List<Bytes>.append(&mut sites, run rejectionSite(&rejections[at]))
    at = at + usize.ONE
  }
  return move sites
}

// Writes one `silk-replay-differential step=<n> only=<store> <site>` line for each site `sites`
// holds more often than `others`, and answers how many it wrote.
effect fn writeUnmatched(step: usize, store: &[u8], sites: &[Bytes], others: &[Bytes]) -> usize
! WriterError | OutOfMemoryError
? &mut Allocator | &mut Writer {
  let mut matched = List<bool>.make()
  let mut at = usize.ZERO
  while at < others.length {
    run List<bool>.append(&mut matched, false)
    at = at + usize.ONE
  }
  let mut unmatched = usize.ZERO
  at = usize.ZERO
  while at < sites.length {
    let mut found = false
    let mut other = usize.ZERO
    while other < others.length && !found {
      if !List<bool>.get(&matched, other) && same(Bytes.asSlice(&sites[at]), Bytes.asSlice(&others[other])) {
        List<bool>.set(&mut matched, other, true)
        found = true
      }
      other = other + usize.ONE
    }
    if !found {
      let mut line = run Bytes.copy(b"silk-replay-differential step=")
      run JsonText.appendDecimal(&mut line, step)
      run Bytes.append(&mut line, b" only=")
      run Bytes.append(&mut line, store)
      run Bytes.append(&mut line, b" ")
      run Bytes.append(&mut line, Bytes.asSlice(&sites[at]))
      run Bytes.append(&mut line, b"\n")
      run Writer.writeAll(Bytes.asSlice(&line))
      unmatched = unmatched + usize.ONE
    }
    at = at + usize.ONE
  }
  return unmatched
}

// Checks `revision` in a fresh one-shot store configured as `prepare` configures the revisable
// one, and compares its rejections with the revised store's `revised` by module, code and span.
// Writes one `silk-replay-differential step=<n> rejections=<count> differences=<count>` line after
// a line per rejection only one store reached, and answers whether they agree.
effect fn compareOneShot(step: usize, revision: &Revision, sources: &ModuleSources, revised: &Semantic, target: Target,
  identity: &ModuleId, roots: &[ModuleId], runtime: &Option<ModuleId>, reached: &[Shared<Rejection>]) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | WriterError | OutOfMemoryError
? &mut Allocator | &mut Types | &mut Writer {
  let zone = Profiler.zone(b"replayOneShot")
  let mut profile = Option<FinalProfile>.none()
  if let Option<&FinalProfile>.Some {value} = move Semantic.profile(revised) {
    profile = Option<FinalProfile>.some(run FinalProfile.copy(value))
  }
  let mut store = Semantic.oneShot(run Revision.copy(revision), target, move profile)
  Semantic.selectPackages(&mut store, run ModuleSourceFiles.packageGraph(sources))
  if let Option<&ExecutionStorage>.Some {value: storage} = move ModuleSourceFiles.executionStorage(sources) {
    Semantic.selectExecutionStorage(&mut store, run ExecutionStorage.copy(storage))
  }
  Semantic.selectRetention(&mut store, run ModuleSourceFiles.retention(sources))
  let mut request = SemanticRequest.forApplication(ModuleId.copy(identity))
  run SemanticRequest.registerSchemaModule(&mut request, identity)
  let expected = run replayCheck(&mut store, &mut request, roots, runtime)
  drop zone
  let revisedSites = run rejectionSites(reached)
  let freshSites = run rejectionSites(List<Shared<Rejection>>.asSlice(&expected))
  let onlyRevised = run writeUnmatched(step, b"revised", List<Bytes>.asSlice(&revisedSites), List<Bytes>.asSlice(&freshSites))
  let onlyFresh = run writeUnmatched(step, b"one-shot", List<Bytes>.asSlice(&freshSites), List<Bytes>.asSlice(&revisedSites))
  let differences = onlyRevised + onlyFresh
  let mut line = run Bytes.copy(b"silk-replay-differential step=")
  run JsonText.appendDecimal(&mut line, step)
  run Bytes.append(&mut line, b" rejections=")
  run JsonText.appendDecimal(&mut line, List<Bytes>.length(&freshSites))
  run Bytes.append(&mut line, b" differences=")
  run JsonText.appendDecimal(&mut line, differences)
  run Bytes.append(&mut line, b"\n")
  run Writer.writeAll(Bytes.asSlice(&line))
  return differences == usize.ZERO
}

// Writes one replay step: `silk-replay step=<n> kind=<kind> module=<path>`, then the demand and
// graph counters the step added, its rejection count and its wall time.
effect fn writeReplayStep(step: usize, kind: &[u8], module: &[u8], before: &Statistics, after: &Statistics, rejections: usize, updateMicroseconds: usize, checkMicroseconds: usize) -> ()
! WriterError | OutOfMemoryError
? &mut Allocator | &mut Writer {
  let mut line = run Bytes.copy(b"silk-replay step=")
  run JsonText.appendDecimal(&mut line, step)
  run Bytes.append(&mut line, b" kind=")
  run Bytes.append(&mut line, kind)
  run Bytes.append(&mut line, b" module=")
  run Bytes.append(&mut line, module)
  run Bytes.append(&mut line, b" demands=")
  run JsonText.appendDecimal(&mut line, after.demands - before.demands)
  run Bytes.append(&mut line, b" hits=")
  run JsonText.appendDecimal(&mut line, after.hits - before.hits)
  run Bytes.append(&mut line, b" units-run=")
  run JsonText.appendDecimal(&mut line, after.runs - before.runs)
  if let Option<GraphCounters>.Some {value: graphAfter} = &after.graph {
    if let Option<GraphCounters>.Some {value: graphBefore} = &before.graph {
      run Bytes.append(&mut line, b" marked-outdated=")
      run JsonText.appendDecimal(&mut line, graphAfter.markedOutdated - graphBefore.markedOutdated)
      run Bytes.append(&mut line, b" fingerprinted=")
      run JsonText.appendDecimal(&mut line, graphAfter.fingerprinted - graphBefore.fingerprinted)
      run Bytes.append(&mut line, b" unchanged=")
      run JsonText.appendDecimal(&mut line, graphAfter.unchanged - graphBefore.unchanged)
      run Bytes.append(&mut line, b" verified=")
      run JsonText.appendDecimal(&mut line, graphAfter.verified - graphBefore.verified)
      run Bytes.append(&mut line, b" graph-units=")
      run JsonText.appendDecimal(&mut line, graphAfter.units)
      run Bytes.append(&mut line, b" graph-bytes=")
      run JsonText.appendDecimal(&mut line, graphAfter.bytes)
    }
  }
  run Bytes.append(&mut line, b" answers=")
  run JsonText.appendDecimal(&mut line, after.answers)
  run Bytes.append(&mut line, b" mir-functions=")
  run JsonText.appendDecimal(&mut line, after.mirFunctions)
  run Bytes.append(&mut line, b" rejections=")
  run JsonText.appendDecimal(&mut line, rejections)
  run Bytes.append(&mut line, b" update-us=")
  run JsonText.appendDecimal(&mut line, updateMicroseconds)
  run Bytes.append(&mut line, b" check-us=")
  run JsonText.appendDecimal(&mut line, checkMicroseconds)
  run Bytes.append(&mut line, b"\n")
  run Writer.writeAll(Bytes.asSlice(&line))
}

// Writes one `silk-replay-run step=<n> <unit>` line for each unit a traced replay step ran, then
// forgets the step's events.
effect fn writeReplayRuns(step: usize, store: &mut Semantic) -> ()
! Cycle | WriterError | OutOfMemoryError
? &mut Allocator | &mut Writer {
  let mut started = List<usize>.make()
  let events = Semantic.eventLog(&store.*)
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.Start { run List<usize>.append(&mut started, events[at].key) }
    at = at + usize.ONE
  }
  let units = List<usize>.asSlice(&started)
  at = usize.ZERO
  while at < units.length {
    let mut line = run Bytes.copy(b"silk-replay-run step=")
    run JsonText.appendDecimal(&mut line, step)
    run Bytes.append(&mut line, b" ")
    run Bytes.append(&mut line, Bytes.asSlice(&run Semantic.unitName(&mut store.*, units[at])))
    run Bytes.append(&mut line, b"\n")
    run Writer.writeAll(Bytes.asSlice(&line))
    at = at + usize.ONE
  }
  let causes = Semantic.staleCauses(&store.*)
  let mut copied = List<StaleCause>.make()
  at = usize.ZERO
  while at < causes.length {
    run List<StaleCause>.append(&mut copied, StaleCause {unit: causes[at].unit, dependee: causes[at].dependee})
    at = at + usize.ONE
  }
  let listedCauses = List<StaleCause>.asSlice(&copied)
  at = usize.ZERO
  while at < listedCauses.length {
    let mut line = run Bytes.copy(b"silk-replay-stale step=")
    run JsonText.appendDecimal(&mut line, step)
    run Bytes.append(&mut line, b" ")
    run Bytes.append(&mut line, Bytes.asSlice(&run Semantic.unitName(&mut store.*, listedCauses[at].unit)))
    run Bytes.append(&mut line, b" <- ")
    run Bytes.append(&mut line, Bytes.asSlice(&run Semantic.dependeeName(&mut store.*, listedCauses[at].dependee)))
    run Bytes.append(&mut line, b"\n")
    run Writer.writeAll(Bytes.asSlice(&line))
    at = at + usize.ONE
  }
  Semantic.trace(&mut store.*, true)
}

// Writes why edit `step` of a replay could not be applied.
effect fn writeReplayStop(step: usize, module: &[u8], reason: &[u8]) -> () ! WriterError | OutOfMemoryError ? &mut Allocator {
  let mut line = run Bytes.copy(b"silk: replay edit ")
  run JsonText.appendDecimal(&mut line, step)
  run Bytes.append(&mut line, b" (")
  run Bytes.append(&mut line, module)
  run Bytes.append(&mut line, b"): ")
  run Bytes.append(&mut line, reason)
  run Bytes.append(&mut line, b"\n")
  run writeError(Bytes.asSlice(&line))
}

// Replays `edits` against one planned compilation of the project. It checks the root package in a
// revisable store as `check` does, then applies each edit to the store's revision, updates the
// store and checks again, writing one `silk-replay` line per step with what that step demanded;
// step 0 is the first check. It reports no diagnostics: a rejection only counts. An edit that
// does not apply stops the replay with status 2. When `differential`, each step also checks the
// same revision in a fresh one-shot store; any rejection only one of them reaches is a
// reconciliation bug, and the replay then ends with status 1.
effect fn replayTarget(project: &Project, plan: ProjectPlan, standardLibrary: &Option<Path>, edits: &[Edit], differential: bool) -> i32
! ApplicationError | InitialProfileProblem | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let ProjectPlan {input: planned, bindings, name: _, maxMemory: unlimited} = move plan
  drop unlimited
  let mut input = move planned
  if let Option<Bytes>.None = &input.artifact {
    input.artifact = Option<Bytes>.some(run Bytes.copy(Projects.profileArtifact(Projects.form(project))))
  }
  let profile = run InitialProfile.freeze(&input)
  let target = Target.forId(Target.id(InitialProfile.target(&profile)))
  let library = match &standardLibrary.* {
    Option<Path>.Some {value} => Option<Path>.some(run Path.fromBytes(Path.rawBytes(&value)))
    Option<Path>.None => Option<Path>.none()
  }
  let format = DiagnosticFormat.Human {root: run diagnosticRoot(Projects.manifest(project))}
  let mut out = Bytes.make()
  // A replay reports its own lines, so it shows no progress.
  let mut progress = run startProgress(&silentProgress(), b"Replaying", project, &target, b"")
  let prepared = run prepare(Projects.entry(project), Option<&Path>.some(Projects.manifest(project)), move library, &profile, move bindings, false, true, Option<&[u8]>.none(), Option<&Path>.none(), &Option<Bytes>.none(), &format, &mut out, &mut progress)
  let analysis = match move prepared {
    Prepared.Ready {analysis} => move analysis
    Prepared.Finished {status} => {
      run writeDiagnostics(&target, false, &out, &mut progress)
      return status
    }
  }
  let Analysis {sources, store: analyzed, request: requested, rootPackage: _, checked, identity, runtime} = move analysis
  let mut store = move analyzed
  let mut request = move requested
  let mut roots = move checked
  let mut current = run ModuleSourceFiles.revision(&sources)
  let mut listRuns = false
  if let Option<Bytes>.Some {..} = move run HostInput.variableNamed("SILK_REPLAY_RUNS") { listRuns = true }
  let mut clock = OsMonotonicClock.make()
  let mut before = Semantic.statistics(&store)
  let started = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
  let mut reached = run replayCheck(&mut store, &mut request, List<ModuleId>.asSlice(&roots), &runtime)
  let checked = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
  run releaseReplayed(&mut store, &mut request)
  let mut after = Semantic.statistics(&store)
  run writeReplayStep(usize.ZERO, b"initial", b"-", &before, &after, List<Shared<Rejection>>.length(&reached), usize.ZERO,
    elapsedMicroseconds(&started, &checked))
  if listRuns { Semantic.trace(&mut store, true) }
  let mut agreed = true
  if differential {
    agreed = run compareOneShot(usize.ZERO, &current, &sources, &store, target, &identity, List<ModuleId>.asSlice(&roots), &runtime,
      List<Shared<Rejection>>.asSlice(&reached))
    HeapRelease.release()
  }
  let mut step = usize.ZERO
  while step < edits.length {
    let edit = &edits[step]
    step = step + usize.ONE
    let module = run ModuleSourceFiles.module(&sources, Bytes.asSlice(&edit.module))
    let observed = run Revision.observe(&current, &module)
    let content = match move run Observation.copyContent(&observed) {
      Option<Bytes>.Some {value} => move value
      Option<Bytes>.None => {
        run writeReplayStop(step, Bytes.asSlice(&edit.module), b"the module is not in the loaded program")
        return 2
      }
    }
    if edit.kind == EditKind.Rename {
      let renamed = run ModuleSourceFiles.module(&sources, Bytes.asSlice(&edit.to))
      let removed = run Revision.publish(&current, &module, &Option<Bytes>.none())
      current = run Revision.publish(&removed, &renamed, &Option<Bytes>.some(move content))
      let mut kept = List<ModuleId>.make()
      while List<ModuleId>.length(&roots) > usize.ZERO {
        let root = List<ModuleId>.remove(&mut roots, usize.ZERO)
        if ModuleId.equals(&root, &module) {
          run List<ModuleId>.append(&mut kept, ModuleId.copy(&renamed))
        } else {
          run List<ModuleId>.append(&mut kept, move root)
        }
      }
      roots = move kept
    } else {
      let edited = match move run EditReplays.apply(Bytes.asSlice(&content), edit) {
        Option<Bytes>.Some {value} => move value
        Option<Bytes>.None => {
          run writeReplayStop(step, Bytes.asSlice(&edit.module), b"its find text does not occur exactly once")
          return 2
        }
      }
      current = run Revision.publish(&current, &module, &Option<Bytes>.some(move edited))
    }
    before = move after
    let updating = Profiler.zone(b"replayUpdate")
    let updateStarted = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
    run Semantic.update(&mut store, run Revision.copy(&current))
    let updated = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
    drop updating
    reached = run replayCheck(&mut store, &mut request, List<ModuleId>.asSlice(&roots), &runtime)
    let finished = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
    run releaseReplayed(&mut store, &mut request)
    after = Semantic.statistics(&store)
    run writeReplayStep(step, EditReplays.kindName(edit.kind), Bytes.asSlice(&edit.module), &before, &after,
      List<Shared<Rejection>>.length(&reached), elapsedMicroseconds(&updateStarted, &updated), elapsedMicroseconds(&updated, &finished))
    if listRuns { run writeReplayRuns(step, &mut store) }
    if differential {
      let matches = run compareOneShot(step, &current, &sources, &store, target, &identity, List<ModuleId>.asSlice(&roots), &runtime,
        List<Shared<Rejection>>.asSlice(&reached))
      agreed = agreed && matches
      // The fresh store is dropped; its pages are needed for the next step's.
      HeapRelease.release()
    }
  }
  if !agreed { return 1 }
  return 0
}

// Writes one borrow-check gap line: `<prefix>3 bodies not borrow-checked (awaiting 3;
// ...)`, the total and then each reason with bodies, per `uncheckedReason`.
effect fn writeBorrowGap(prefix: &[u8], counts: &[usize]) -> () ! OutOfMemoryError | WriterError ? &mut Allocator {
  let mut total = usize.ZERO
  let mut at = usize.ZERO
  while at < counts.length {
    total = total + counts[at]
    at = at + usize.ONE
  }
  let mut message = run Bytes.copy(prefix)
  run JsonText.appendDecimal(&mut message, total)
  run Bytes.append(&mut message, b" bodies not borrow-checked (")
  let mut listed = false
  at = usize.ZERO
  while at < counts.length {
    if counts[at] > usize.ZERO {
      if listed {
        run Bytes.append(&mut message, b", ")
      }
      run Bytes.append(&mut message, String.utf8Bytes(uncheckedReasonName(at)))
      run Bytes.append(&mut message, b" ")
      run JsonText.appendDecimal(&mut message, counts[at])
      listed = true
    }
    at = at + usize.ONE
  }
  if !listed { run Bytes.append(&mut message, b"all checked") }
  run Bytes.append(&mut message, b"; native borrow checking is roadmap step 14)\n")
  run writeError(Bytes.asSlice(&message))
}

// Writes the root-package count line, then, when `named`, one `SILK_GAP borrow-check body:
// <module> <start>-<end> <reason> <codes>` line per unchecked concrete root-package body, by the
// byte offsets of its body block, with the comma-separated catalog codes the checks it left open
// report, or `-` when it left none of them open.
effect fn writeRootBorrowGap(bodies: &[UncheckedBody], named: bool) -> () ! OutOfMemoryError | WriterError ? &mut Allocator {
  let mut counts = List<usize>.make()
  let mut at = usize.ZERO
  while at < uncheckedReasonCount() {
    run List<usize>.append(&mut counts, usize.ZERO)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < bodies.length {
    let mut slots = List<usize>.asMutSlice(&mut counts)
    slots[bodies[at].reason] = slots[bodies[at].reason] + usize.ONE
    at = at + usize.ONE
  }
  run writeBorrowGap(b"SILK_GAP borrow-check root-package: ", List<usize>.asSlice(&counts))
  if !named { return () }
  at = usize.ZERO
  while at < bodies.length {
    let mut line = run Bytes.copy(b"SILK_GAP borrow-check body: ")
    let path = run ModuleId.copyPath(&bodies[at].module)
    run Bytes.append(&mut line, Bytes.asSlice(&path))
    run Bytes.append(&mut line, b" ")
    run JsonText.appendDecimal(&mut line, bodies[at].block.start)
    run Bytes.append(&mut line, b"-")
    run JsonText.appendDecimal(&mut line, bodies[at].block.end)
    run Bytes.append(&mut line, b" ")
    run Bytes.append(&mut line, String.utf8Bytes(uncheckedReasonName(bodies[at].reason)))
    run Bytes.append(&mut line, b" ")
    let skipped = run uncheckedBodyCodes()
    let codes = List<RejectionCode>.asSlice(&skipped)
    if codes.length == usize.ZERO { run Bytes.append(&mut line, b"-") }
    let mut code = usize.ZERO
    while code < codes.length {
      if code > usize.ZERO { run Bytes.append(&mut line, b",") }
      run Bytes.append(&mut line, Rejections.stableCode(codes[code]))
      code = code + usize.ONE
    }
    run Bytes.append(&mut line, b"\n")
    run writeError(Bytes.asSlice(&line))
    at = at + usize.ONE
  }
}

// The combined status of two outcomes: 2 dominates 1, which dominates 0. Any other status, such as
// an abnormal exit's, counts as 2.
fn worse(left: i32, right: i32) -> i32 {
  if left < 0 || left > 1 || right < 0 || right > 1 { return 2 }
  if left == 1 || right == 1 { return 1 }
  return 0
}

// Analyzes every planned compilation of the project in order and writes one `check <target>:`
// line per target and a `Check summary` on standard output, as the TypeScript `silk check` does.
effect fn checkProject(working: &Path, command: CheckCommand) -> i32
! ApplicationError | InitialProfileProblem | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let CheckCommand {options, json, roots, replay: script, differential} = move command
  if ProjectCommands.conflicting(&options) {
    run reportOptimizationConflict(&options)
    return 2
  }
  let selection = match move run selectProjects(working, &options) {
    Option<Selection>.Some {value} => move value
    Option<Selection>.None => { return 2 }
  }
  let standardLibrary = run standardLibraryFor(working, &options.standardLibrary)
  let mut edits = Option<List<Edit>>.none()
  if let Option<Bytes>.Some {value} = &script {
    let path = run pathArgument(working, Bytes.asSlice(&value))
    edits = match move run replayScript(&path) {
      Option<List<Edit>>.Some {value: read} => Option<List<Edit>>.some(move read)
      Option<List<Edit>>.None => { return 2 }
    }
  }
  let projects = List<Project>.asSlice(&selection.projects)
  // JSON diagnostics share standard error, so a JSON check reports no progress.
  let mut settings = silentProgress()
  let mut replaying = false
  if let Option<List<Edit>>.Some {..} = &edits { replaying = true }
  if !json && !replaying { settings = run progressSettings(&options, projects.length) }
  let whole = run unitsProgress(&settings)
  let mut status = 0
  let mut succeeded = usize.ZERO
  let mut at = usize.ZERO
  while at < projects.length {
    if selection.members { settings.position = at + usize.ONE }
    let checked = run memberStatus(run Effect.result(checkOne(&projects[at], &options, &standardLibrary, json, roots, &settings, &edits, differential)))
    if checked == 0 { succeeded = succeeded + usize.ONE }
    status = worse(status, checked)
    at = at + usize.ONE
  }
  if selection.members { run writeUnitsSummary(&settings, move whole, succeeded, projects.length) }
  return status
}

// Checks one project's planned compilations, as `checkProject` does for each selected project.
effect fn checkOne(project: &Project, options: &ProjectOptions, standardLibrary: &Option<Path>, json: bool, roots: bool, packages: &ProgressSettings, edits: &Option<List<Edit>>, differential: bool) -> i32
! ApplicationError | InitialProfileProblem | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let mut plans = match move run projectPlans(project, options, Projects.targets(project)) {
    Option<List<ProjectPlan>>.Some {value} => move value
    Option<List<ProjectPlan>>.None => { return 2 }
  }
  if let Option<List<Edit>>.Some {value: script} = &edits.* {
    let mut replayed = 0
    while List<ProjectPlan>.length(&plans) > usize.ZERO {
      let plan = List<ProjectPlan>.remove(&mut plans, usize.ZERO)
      replayed = worse(replayed, run replayTarget(project, move plan, standardLibrary, List<Edit>.asSlice(&script), differential))
    }
    return replayed
  }
  let settings = unitSettings(packages, List<ProjectPlan>.length(&plans))
  let mut attempts = List<ProjectArtifact>.make()
  while List<ProjectPlan>.length(&plans) > usize.ZERO {
    let plan = List<ProjectPlan>.remove(&mut plans, usize.ZERO)
    run List<ProjectArtifact>.append(&mut attempts, run checkTarget(project, move plan, standardLibrary, json, roots, &settings))
  }
  // Each attempt has reported itself on standard error, so only the status is left to combine.
  let attempted = List<ProjectArtifact>.asSlice(&attempts)
  let mut status = 0
  let mut at = usize.ZERO
  while at < attempted.length {
    status = worse(status, attempted[at].status)
    at = at + usize.ONE
  }
  return status
}

// Builds the project's executable for the host, then replaces this process with it. `run` ignores
// `[build].targets`: it builds the named profile, else the first `--target`, else the host, and a
// foreign target is refused before building. A project that cannot be loaded or run is status 2;
// a refused build keeps the build's status.
effect fn runProject(working: &Path, command: RunCommand) -> i32
! ApplicationError | InitialProfileProblem | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  let RunCommand {options, arguments} = move command
  if ProjectCommands.conflicting(&options) {
    run reportOptimizationConflict(&options)
    return 2
  }
  let mut selection = match move run selectProjects(working, &options) {
    Option<Selection>.Some {value} => move value
    Option<Selection>.None => { return 2 }
  }
  // Without `--package`, a workspace's libraries are passed over: it has one program to run when
  // exactly one selected member is an executable.
  if selection.members && List<Bytes>.length(&options.packages) == usize.ZERO {
    let mut runnable = List<Project>.make()
    while List<Project>.length(&selection.projects) > usize.ZERO {
      let candidate = List<Project>.remove(&mut selection.projects, usize.ZERO)
      if Projects.runnable(&candidate) {
        run List<Project>.append(&mut runnable, move candidate)
      }
    }
    selection.projects = move runnable
  }
  if List<Project>.length(&selection.projects) != usize.ONE {
    run writeError(b"silk: `run` runs one package; pass --package <name> to choose a workspace member\n")
    return 2
  }
  let project = List<Project>.remove(&mut selection.projects, usize.ZERO)
  if !Projects.runnable(&project) {
    run writeError(b"Cannot run ")
    run writeError(Projects.formSpelling(Projects.form(&project)))
    run writeError(b" artifact\n")
    return 2
  }
  let host = [run Bytes.copy(b"host")]
  let hostSelector: &[Bytes] = &host
  let mut plans = match move run projectPlans(&project, &options, hostSelector) {
    Option<List<ProjectPlan>>.Some {value} => move value
    Option<List<ProjectPlan>>.None => { return 2 }
  }
  let plan = List<ProjectPlan>.remove(&mut plans, usize.ZERO)
  let planned = match &plan.input.target {
    Option<Bytes>.Some {value} => Target.resolve(Bytes.asSlice(&value))
    Option<Bytes>.None => Option<Target>.none()
  }
  let target = match move planned {
    Option<Target>.Some {value} => value
    Option<Target>.None => run invalidBuildProfile()
  }
  if Target.id(&target) != Target.id(&hostTarget()) && !same(Target.operatingSystem(&target), b"wasi") {
    run writeError(b"Cannot run target ")
    run writeError(Target.name(&target))
    run writeError(b" on host ")
    run writeError(Target.name(&hostTarget()))
    run writeError(b"\n")
    return 2
  }
  let standardLibrary = run standardLibraryFor(working, &options.standardLibrary)
  let clang = run clangFor(working, &options.clang)
  // The build reports its progress on standard error as `silk build` does, its `Finished` or
  // `Failed` line included, so standard output carries only the program's own output.
  let settings = run progressSettings(&options, usize.ONE)
  let built = run buildProjectTarget(&project, move plan, &standardLibrary, &clang, true, false, &settings)
  if built.status != 0 {
    return built.status
  }
  if same(Target.operatingSystem(&target), b"wasi") { return run WasiTools.replace(&built.path, List<Bytes>.asSlice(&arguments)) }
  let failure = run ProcessImage.replace(&built.path, List<Bytes>.asSlice(&arguments))
  drop failure
  run writeError(b"Cannot run compiled program ")
  run writeError(Path.rawBytes(&built.path))
  run writeError(b"\n")
  return 2
}

// Selects the source file `written` names, relative to the project directory, for a test run:
// its project-relative path, or `None` after reporting why it cannot be selected as the
// TypeScript `SourceEntry.select` words it.
effect fn testSource(project: &Project, written: &[u8]) -> Option<Bytes>
! ApplicationError | OutOfMemoryError | WriterError ? &mut Allocator {
  let path = run pathArgument(Projects.directory(project), written)
  return match move run Projects.selectSource(project, &path) {
    SourceSelection.Module {relative} => Option<Bytes>.some(move relative)
    SourceSelection.Outside {sourceRoot} => {
      run writeError(b"Source entry ")
      run writeError(Path.rawBytes(&path))
      run writeError(b" is outside source root ")
      run writeError(Path.rawBytes(&sourceRoot))
      run writeError(b"\n")
      return Option<Bytes>.none()
    }
    SourceSelection.NotModule => {
      run writeError(b"Source entry ")
      run writeError(Path.rawBytes(&path))
      run writeError(b" must be a canonical relative path ending in .silk\n")
      return Option<Bytes>.none()
    }
  }
}

// Builds the project's test runner for the host and runs the selected tests, as the TypeScript
// `silk test` does. Discovery starts at `--root`, else at the root module; `--file` and
// `--filter` select tests at run time. The runner is always a final executable, whatever the
// manifest's form and stage, at `<output-dir>/test/llvm/<target>/<profile>/<name>`. A project,
// selection or plan that cannot be used is status 2; otherwise the status is the test run's.
effect fn testProject(working: &Path, command: TestCommand) -> i32
! ApplicationError | InitialProfileProblem | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let TestCommand {options, root, file, filter, timeout, noCache} = move command
  if ProjectCommands.conflicting(&options) {
    run reportOptimizationConflict(&options)
    return 2
  }
  let selection = match move run selectProjects(working, &options) {
    Option<Selection>.Some {value} => move value
    Option<Selection>.None => { return 2 }
  }
  let projects = List<Project>.asSlice(&selection.projects)
  let narrowed = hasFilter(&root) || hasFilter(&file)
  if narrowed && projects.length != usize.ONE {
    run writeError(b"silk: --root and --file name files of one package; pass --package <name> to choose a workspace member\n")
    return 2
  }
  let mut status = 0
  let mut succeeded = usize.ZERO
  let mut matched = false
  let mut at = usize.ZERO
  while at < projects.length {
    if selection.members { run writePackageHeader(&projects[at]) }
    let tested = run memberStatus(run Effect.result(testOne(working, &projects[at], &options, &root, &file, &filter, &timeout, noCache, &mut matched)))
    if tested == 0 { succeeded = succeeded + usize.ONE }
    status = worse(status, tested)
    at = at + usize.ONE
  }
  if selection.members { run writeWorkspaceSummary(succeeded, projects.length) }
  // A selection fails only when it matches no test in any selected package.
  if status == 0 && (hasFilter(&file) || hasFilter(&filter)) && !matched {
    run reportUnmatched()
    return 1
  }
  return status
}

// A selection that matches nothing verified nothing, so it fails instead of passing.
effect fn reportUnmatched() -> () ! WriterError {
  return run writeError(b"silk test: no tests matched the --file or --filter selection\n")
}

effect fn copyOption(value: &Option<Bytes>) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  return match &value.* {
    Option<Bytes>.Some {value: present} => Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&present)))
    Option<Bytes>.None => Option<Bytes>.none()
  }
}

// Builds one project's test runner and runs its selected tests, as `testProject` does for each
// selected project. `matched` becomes true when the run selected a test.
effect fn testOne(working: &Path, project: &Project, options: &ProjectOptions, root: &Option<Bytes>, file: &Option<Bytes>, filter: &Option<Bytes>, timeout: &Option<Bytes>, noCache: bool, matched: &mut bool) -> i32
! ApplicationError | InitialProfileProblem | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let mut discovery = run Path.fromBytes(Path.rawBytes(Projects.entry(project)))
  if let Option<Bytes>.Some {value} = &root.* {
    if let Option<Bytes>.None = move run testSource(project, Bytes.asSlice(&value)) {
      return 2
    }
    discovery = run pathArgument(Projects.directory(project), Bytes.asSlice(&value))
  }
  let mut selectedFile = Option<Bytes>.none()
  if let Option<Bytes>.Some {value} = &file.* {
    selectedFile = match move run testSource(project, Bytes.asSlice(&value)) {
      Option<Bytes>.Some {value: relative} => Option<Bytes>.some(move relative)
      Option<Bytes>.None => { return 2 }
    }
  }
  let host = [run Bytes.copy(b"host")]
  let hostSelector: &[Bytes] = &host
  let mut plans = match move run projectPlans(project, options, hostSelector) {
    Option<List<ProjectPlan>>.Some {value} => move value
    Option<List<ProjectPlan>>.None => { return 2 }
  }
  let plan = List<ProjectPlan>.remove(&mut plans, usize.ZERO)
  let ProjectPlan {input: planned, bindings, name: profileNamed, maxMemory: unlimited} = move plan
  drop unlimited
  let mut input = move planned
  input.artifact = Option<Bytes>.some(run Bytes.copy(Projects.profileArtifact(Form.Executable)))
  let profile = run InitialProfile.freeze(&input)
  let target = Target.forId(Target.id(InitialProfile.target(&profile)))
  if Target.id(&target) != Target.id(&hostTarget()) && !same(Target.operatingSystem(&target), b"wasi") {
    run writeError(b"Cannot run target ")
    run writeError(Target.name(&target))
    run writeError(b" on host ")
    run writeError(Target.name(&hostTarget()))
    run writeError(b"\n")
    return 2
  }
  let optimization = match move InitialProfile.text(&profile, b"optimization") {
    Option<&[u8]>.Some {value} => value
    Option<&[u8]>.None => run invalidBuildProfile()
  }
  let debug = match move InitialProfile.flag(&profile, b"debug") {
    Option<bool>.Some {value} => value
    Option<bool>.None => run invalidBuildProfile()
  }
  let profileName = run Projects.profileDirectory(&profileNamed, optimization, debug)
  let output = run Projects.testExecutable(project, Target.name(&target), Bytes.asSlice(&profileName))
  if let Option<Path>.Some {value: directory} = move run Path.parent(&output) {
    run FileSystem.createDirectoriesRecursively(&directory)
  }
  let standardLibrary = run standardLibraryFor(working, &options.standardLibrary)
  let clang = run clangFor(working, &options.clang)
  return run test(&discovery, Option<&Path>.some(Projects.manifest(project)), &output, Projects.directory(project), Projects.supply(project), move standardLibrary, move profile,
    move bindings, run copyOption(filter), move selectedFile, timeout, &clang, noCache, &mut matched.*)
}

// Writes one refused initialization as the TypeScript CLI words it.
effect fn reportInitialization(problem: &InitializationError) -> () ! WriterError {
  return match &problem.* {
    InitializationError.InvalidPackageName {name, derived} => {
      if derived {
        run writeError(b"Cannot derive a portable package name from ")
        run writeError(Bytes.asSlice(&name))
        run writeError(b"; pass --name\n")
      } else {
        run writeError(b"Package name ")
        run writeError(Bytes.asSlice(&name))
        run writeError(b" must start with a lowercase letter and contain only lowercase letters, digits, or hyphens\n")
      }
    }
    InitializationError.ExistingFile {path} => {
      run writeError(b"Refusing to overwrite existing project file ")
      run writeError(Path.rawBytes(&path))
      run writeError(b"\n")
    }
    InitializationError.SourceNotDirectory {path} => {
      run writeError(b"Managed source path ")
      run writeError(Path.rawBytes(&path))
      run writeError(b" is not a directory\n")
    }
    InitializationError.AncestorNotDirectory {path} => {
      run writeError(b"Initialization path ancestor ")
      run writeError(Path.rawBytes(&path))
      run writeError(b" is not a directory\n")
    }
    InitializationError.Failed {path} => {
      run writeError(b"Cannot initialize Silk project at ")
      run writeError(Path.rawBytes(&path))
      run writeError(b"\n")
    }
  }
}

// Lists the package in `directory` as a member of the nearest workspace above it, unless that
// workspace already lists it, and checks the edited workspace before keeping the edit.
effect fn joinWorkspace(directory: &Path) -> ()
! ProjectError | ManifestEditRefused | FileError | OutOfMemoryError | WriterError
? &mut FileSystem | &mut Allocator | &mut Writer {
  let parent = match move run Path.parent(directory) {
    Option<Path>.Some {value} => move value
    Option<Path>.None => { return () }
  }
  let manifest = match move run Projects.enclosingWorkspace(&parent) {
    Option<Path>.Some {value} => move value
    Option<Path>.None => { return () }
  }
  if run Projects.listsMember(&manifest, directory) {
    return ()
  }
  let workspaceDirectory = match move run Path.parent(&manifest) {
    Option<Path>.Some {value} => move value
    Option<Path>.None => { return () }
  }
  let entry = run CommandPath.relative(&workspaceDirectory, directory)
  let previous = run FileSystem.readFile(&manifest)
  let edited = run ManifestEdits.addMember(Bytes.asSlice(&previous), Bytes.asSlice(&entry))
  run FileSystem.writeFile(&manifest, Bytes.asSlice(&edited))
  let checked = run Effect.result(Projects.workspace(&manifest))
  if let Result<Option<Workspace>, ProjectError | FileError | OutOfMemoryError>.Failure {error} = move checked {
    run FileSystem.writeFile(&manifest, Bytes.asSlice(&previous))
    fail move error
  }
  run Writer.writeAll(b"Added ")
  run Writer.writeAll(Bytes.asSlice(&entry))
  run Writer.writeAll(b" to the workspace members in ")
  run Writer.writeAll(Path.rawBytes(&manifest))
  run Writer.writeAll(b"\n")
}

// Creates a project in the selected directory, recording this compiler's release as its
// `silk-version`, and reports it: status 0, or 2 when refused. A package created inside a
// workspace becomes one of its members.
effect fn initProject(working: &Path, command: InitCommand) -> i32
! ApplicationError | FileError | OutOfMemoryError | WriterError
? &mut FileSystem | &mut Allocator | &mut Writer {
  let InitCommand {path, name, kind} = move command
  let directory = match move path {
    Option<Bytes>.Some {value} => run pathArgument(working, Bytes.asSlice(&value))
    Option<Bytes>.None => run Path.fromBytes(Path.rawBytes(working))
  }
  let initialized = run Effect.result(ProjectInitializers.create(&directory, move name, kind, ReleaseVersion.value()))
  return match move initialized {
    Result<Initialized, InitializationError | OutOfMemoryError>.Success {value} => {
      if kind == InitKind.Workspace {
        run Writer.writeAll(b"Initialized Silk workspace at ")
        run Writer.writeAll(Path.rawBytes(&value.directory))
        run Writer.writeAll(b"\nInitialized Silk project ")
        run Writer.writeAll(Bytes.asSlice(&value.name))
        run Writer.writeAll(b" at ")
        run Writer.writeAll(Path.rawBytes(&value.package))
        run Writer.writeAll(b"\nRun it with `silk run` from the workspace root\n")
        return 0
      }
      run Writer.writeAll(b"Initialized Silk project ")
      run Writer.writeAll(Bytes.asSlice(&value.name))
      run Writer.writeAll(b" at ")
      run Writer.writeAll(Path.rawBytes(&value.directory))
      run Writer.writeAll(b"\n")
      let joined = run Effect.result(joinWorkspace(&value.directory))
      return match move joined {
        Result<(), ProjectError | ManifestEditRefused | FileError | OutOfMemoryError | WriterError>.Success {value: _} => 0
        Result<(), ProjectError | ManifestEditRefused | FileError | OutOfMemoryError | WriterError>.Failure {error} => match move error {
          ProjectError problem => {
            run writeError(b"silk: the project was created, but its workspace was left unchanged:\n")
            run reportProject(&problem)
            return 2
          }
          ManifestEditRefused refused => {
            run writeError(b"silk: the project was created, but it could not be added to its workspace: ")
            run writeError(Bytes.asSlice(&refused.detail))
            run writeError(b"\n")
            return 2
          }
          FileError file => { fail move file }
          OutOfMemoryError exhausted => { fail move exhausted }
          WriterError written => { fail move written }
        }
      }
    }
    Result<Initialized, InitializationError | OutOfMemoryError>.Failure {error} => match move error {
      InitializationError problem => {
        run reportInitialization(&problem)
        return 2
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// The `[package]` table of `document`, or a failure naming `manifest` when it has none.
effect fn packageTable<'a>(manifest: &Path, document: &'a TomlValue) -> &'a TomlValue
! ProjectError | FileError | OutOfMemoryError ? &mut Allocator {
  return match move Toml.field(document, "package") {
    Option<&TomlValue>.Some {value} => value
    Option<&TomlValue>.None => {
      fail ProjectError.InvalidManifest {
        manifest: run Path.fromBytes(Path.rawBytes(manifest)),
        line: usize.ZERO,
        detail: run Bytes.copy(b"dependencies belong to a package, and this manifest has no [package] table"),
      }
    }
  }
}

// Whether the `[dependencies]` table of `document` has an entry named `name`.
fn hasDependency(document: &TomlValue, name: &[u8]) -> bool {
  return match move String.fromUtf8(name) {
    Result<string, InvalidUtf8>.Success {value} => match move Toml.fieldAt(Toml.field(document, "dependencies"), value) {
      Option<&TomlValue>.Some {value: _} => true
      Option<&TomlValue>.None => false
    }
    Result<string, InvalidUtf8>.Failure {error: _} => false
  }
}

// A dependency name derived from a package name: each `-` becomes `_`.
effect fn dependencyName(package: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut name = run Bytes.copy(package)
  let bytes = Bytes.asMutSlice(&mut name)
  let mut at = usize.ZERO
  while at < bytes.length {
    if bytes[at] == 45 { bytes[at] = 95 }
    at = at + usize.ONE
  }
  return move name
}

effect fn refusedDependency(name: &[u8], reason: &[u8]) -> never ! InvalidDependency | OutOfMemoryError ? &mut Allocator {
  let mut detail = run Bytes.copy(b"dependency `")
  run Bytes.append(&mut detail, name)
  run Bytes.append(&mut detail, b"`: ")
  run Bytes.append(&mut detail, reason)
  fail InvalidDependency {detail: move detail, manifest: Bytes.make(), line: usize.ZERO}
}

// Refuses a dependency `path` whose manifest only defines a workspace, naming its members, since
// a dependency is one package and the workspace's own manifest is not at fault.
effect fn notWorkspace(path: &[u8], document: &TomlValue) -> () ! InvalidDependency | OutOfMemoryError ? &mut Allocator {
  if let Option<&TomlValue>.Some {value: _} = move Toml.field(document, "package") {
    return ()
  }
  let members = match move Toml.fieldAt(Toml.field(document, "workspace"), "members") {
    Option<&TomlValue>.Some {value} => value
    Option<&TomlValue>.None => { return () }
  }
  let mut reason = run Bytes.copy(b"it is a workspace; add one of its members")
  let mut at = usize.ZERO
  while true {
    let member = match move Toml.asString(Toml.item(members, at)) {
      Option<string>.Some {value} => String.utf8Bytes(value)
      Option<string>.None => { break }
    }
    if at == usize.ZERO { run Bytes.append(&mut reason, b": ") } else { run Bytes.append(&mut reason, b", ") }
    run Bytes.append(&mut reason, member)
    at = at + usize.ONE
  }
  if at == usize.ZERO { run Bytes.append(&mut reason, b"; it lists none yet") }
  run refusedDependency(path, Bytes.asSlice(&reason))
}

// A package as `Packages.load` takes it for the root of a build: its `name@version` identity and
// the directory its modules resolve below.
struct RootPackage {
  identity: Bytes,
  sourceRoot: Path,
}

// The root-package inputs of the package whose manifest is `document`, in `directory`: its
// identity and `[package].source` (driver/ManifestFields).
effect fn rootPackage(directory: &Path, document: &TomlValue) -> RootPackage ! FileError | OutOfMemoryError ? &mut Allocator {
  let sourceRoot = run ManifestFields.sourceRoot(directory, document)
  let mut identity = Bytes.make()
  if let Option<&[u8]>.Some {value: owner} = move ManifestFields.packageText(document, "name") {
    run Bytes.append(&mut identity, owner)
  }
  run Bytes.append(&mut identity, b"@")
  run Bytes.append(&mut identity, ManifestFields.version(document))
  return RootPackage {identity: move identity, sourceRoot: move sourceRoot}
}

// Adds the package at `command.path` to the located manifest's `[dependencies]`, by the path
// from the manifest's directory, under `--name` or else its package name with `-` spelled `_`.
// The edited manifest's dependencies are loaded and checked before it is written.
effect fn addedDependency(working: &Path, command: AddCommand) -> ()
! ApplicationError | ProjectError | InvalidDependency | ManifestEditRefused | FileError | OutOfMemoryError | WriterError
? &mut FileSystem | &mut Allocator | &mut Writer {
  let AddCommand {path, name, manifestPath} = move command
  let manifest = run manifestFor(working, &manifestPath)
  let document = run Projects.parsed(&manifest)
  drop run packageTable(&manifest, &document)
  let directory = match move run Path.parent(&manifest) {
    Option<Path>.Some {value} => move value
    Option<Path>.None => run Path.root()
  }
  let dependency = run pathArgument(working, Bytes.asSlice(&path))
  let dependencyManifest = run Path.join(&dependency, "silk.toml")
  let dependencyDocument = run Projects.parsed(&dependencyManifest)
  run notWorkspace(Bytes.asSlice(&path), &dependencyDocument)
  let dependencyPackage = run packageTable(&dependencyManifest, &dependencyDocument)
  let packageName = match move Toml.asString(Toml.field(dependencyPackage, "name")) {
    Option<string>.Some {value} => String.utf8Bytes(value)
    Option<string>.None => {
      fail ProjectError.InvalidManifest {manifest: move dependencyManifest, line: usize.ZERO, detail: run Bytes.copy(b"missing [package] name")}
    }
  }
  let named = match move name {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => run dependencyName(packageName)
  }
  let dependencyKey = Bytes.asSlice(&named)
  if hasDependency(&document, dependencyKey) {
    return run refusedDependency(dependencyKey, b"the package already has a dependency of that name")
  }
  let relative = run CommandPath.relative(&directory, &dependency)
  if Bytes.length(&relative) == usize.ZERO {
    return run refusedDependency(dependencyKey, b"a package cannot depend on itself")
  }
  let mut value = run Bytes.copy(b"{ path = ")
  let quotedPath = run ManifestEdits.quoted(Bytes.asSlice(&relative))
  run Bytes.append(&mut value, Bytes.asSlice(&quotedPath))
  if !same(dependencyKey, packageName) {
    let quotedPackage = run ManifestEdits.quoted(packageName)
    run Bytes.append(&mut value, b", package = ")
    run Bytes.append(&mut value, Bytes.asSlice(&quotedPackage))
  }
  run Bytes.append(&mut value, b" }")
  let previous = run FileSystem.readFile(&manifest)
  let next = run ManifestEdits.addDependency(Bytes.asSlice(&previous), dependencyKey, Bytes.asSlice(&value))
  let edited = match move run Effect.result(Toml.parse(Bytes.asSlice(&next))) {
    Result<TomlValue, TomlError | OutOfMemoryError>.Success {value: parsed} => move parsed
    Result<TomlValue, TomlError | OutOfMemoryError>.Failure {error} => match move error {
      TomlError malformed => {
        drop malformed
        fail ManifestEditRefused {detail: run Bytes.copy(b"the edited manifest would not be valid TOML")}
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  // A package that already reaches this one through its dependencies would close a cycle.
  let reached = run rootPackage(&dependency, &dependencyDocument)
  let reachable = run PackageSources.load(&dependency, &dependencyDocument, Bytes.asSlice(&reached.identity), &reached.sourceRoot)
  let root = run rootPackage(&directory, &document)
  if let Option<&Path>.Some {value: _} = move PackageSources.dependencyRoot(&reachable, Bytes.asSlice(&root.identity)) {
    let mut reason = run Bytes.copy(Bytes.asSlice(&reached.identity))
    run Bytes.append(&mut reason, b" already depends on ")
    run Bytes.append(&mut reason, Bytes.asSlice(&root.identity))
    run Bytes.append(&mut reason, b", directly or through other packages, so adding it would form a cycle")
    return run refusedDependency(dependencyKey, Bytes.asSlice(&reason))
  }
  let checked = run PackageSources.load(&directory, &edited, Bytes.asSlice(&root.identity), &root.sourceRoot)
  drop checked
  run FileSystem.writeFile(&manifest, Bytes.asSlice(&next))
  run Writer.writeAll(b"Added dependency ")
  run Writer.writeAll(dependencyKey)
  run Writer.writeAll(b" = ")
  run Writer.writeAll(Bytes.asSlice(&value))
  run Writer.writeAll(b" to ")
  run Writer.writeAll(Path.rawBytes(&manifest))
  run Writer.writeAll(b"\n")
}

// Removes dependency `command.name` from the located manifest.
effect fn removedDependency(working: &Path, command: RemoveCommand) -> ()
! ApplicationError | ProjectError | InvalidDependency | ManifestEditRefused | FileError | OutOfMemoryError | WriterError
? &mut FileSystem | &mut Allocator | &mut Writer {
  let RemoveCommand {name, manifestPath} = move command
  let manifest = run manifestFor(working, &manifestPath)
  let document = run Projects.parsed(&manifest)
  let package = run packageTable(&manifest, &document)
  drop package
  if !hasDependency(&document, Bytes.asSlice(&name)) {
    return run refusedDependency(Bytes.asSlice(&name), b"the package has no dependency of that name")
  }
  let previous = run FileSystem.readFile(&manifest)
  let next = run ManifestEdits.removeDependency(Bytes.asSlice(&previous), Bytes.asSlice(&name))
  run FileSystem.writeFile(&manifest, Bytes.asSlice(&next))
  run Writer.writeAll(b"Removed dependency ")
  run Writer.writeAll(Bytes.asSlice(&name))
  run Writer.writeAll(b" from ")
  run Writer.writeAll(Path.rawBytes(&manifest))
  run Writer.writeAll(b"\n")
}

// Reports one failed `add` or `remove`, answering its status: 0, or 2 when refused.
effect fn reportedEdit(outcome: Result<(), ApplicationError | ProjectError | InvalidDependency | ManifestEditRefused | FileError | OutOfMemoryError | WriterError>) -> i32
! ApplicationError | FileError | OutOfMemoryError | WriterError {
  return match move outcome {
    Result<(), ApplicationError | ProjectError | InvalidDependency | ManifestEditRefused | FileError | OutOfMemoryError | WriterError>.Success {value: _} => 0
    Result<(), ApplicationError | ProjectError | InvalidDependency | ManifestEditRefused | FileError | OutOfMemoryError | WriterError>.Failure {error} => match move error {
      ProjectError problem => {
        run reportProject(&problem)
        return 2
      }
      InvalidDependency invalid => {
        run writeDependency(&invalid)
        return 2
      }
      ManifestEditRefused refused => {
        run writeError(b"silk: cannot edit the manifest: ")
        run writeError(Bytes.asSlice(&refused.detail))
        run writeError(b"\n")
        return 2
      }
      ApplicationError application => { fail move application }
      FileError file => { fail move file }
      OutOfMemoryError exhausted => { fail move exhausted }
      WriterError written => { fail move written }
    }
  }
}

/// Resolves one command-line path, naming the rejected argument when no path can spell it.
effect fn pathArgument(working: &Path, argument: &[u8]) -> Path
! ApplicationError | OutOfMemoryError ? &mut Allocator {
  let resolved = run Effect.result(CommandPath.resolve(working, argument))
  return match move resolved {
    Result<Path, FileError | OutOfMemoryError>.Success {value} => move value
    Result<Path, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError invalid => {
        drop invalid
        fail ApplicationError.InvalidPath {argument: run Bytes.copy(argument)}
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// `silk doctest`: in a package, checks every example, then builds and runs each one that declares a
// `main`; the model-file and standard-library forms only check theirs.
effect fn doctest() -> i32
! ApplicationError | InitialProfileProblem | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let mut packages = match move run Effect.result(DocumentationCommand.packageExamples()) {
    Result<Option<List<PackageExamples>>, DocumentationError>.Success {value} => match move value {
      Option<List<PackageExamples>>.Some {value: found} => move found
      Option<List<PackageExamples>>.None => { return run DocumentationCommand.runHost(b"doctest") }
    }
    Result<Option<List<PackageExamples>>, DocumentationError>.Failure {error} => { return run DocumentationCommand.failed(b"doctest", move error) }
  }
  // At a workspace root each member's results follow a heading, and the command fails when any
  // example fails or no member has one.
  let listed = List<PackageExamples>.asMutSlice(&mut packages)
  let mut total = Summary {collected: 0, passed: 0, skipped: 0, failed: 0}
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].member { run DocumentationCommand.heading(&listed[at].package) }
    let summary = run runExamples(&listed[at].package, &listed[at].libraryRoot, &mut listed[at].outcomes)
    DocumentationCommand.combine(&mut total, &summary)
    at = at + usize.ONE
  }
  return Doctest.status(&total)
}

// Builds and runs each pending example of `package`, and reports every example as it is resolved,
// so a build's diagnostics come just before its example's result line.
effect fn runExamples(package: &Project, libraryRoot: &Path, outcomes: &mut List<Outcome>) -> Summary
! ApplicationError | InitialProfileProblem | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  // An example imports the package by the name its dependents write, with `_` for each `-`.
  let mut alias = run Bytes.copy(Projects.name(package))
  let letters = Bytes.asMutSlice(&mut alias)
  let mut letter = usize.ZERO
  while letter < letters.length {
    if letters[letter] == 45 { letters[letter] = 95 }
    letter = letter + usize.ONE
  }
  // The example's source sits beside the package's own modules, under a name none of them has.
  let mut entry = run Path.join(Projects.sourceRoot(package), "doctest_example.silk")
  let mut suffix: usize = 2
  while run FileSystem.exists(&entry) {
    let mut name = run Bytes.copy(b"doctest_example_")
    run JsonText.appendDecimal(&mut name, suffix)
    run Bytes.append(&mut name, b".silk")
    entry = run Path.joinBytes(Projects.sourceRoot(package), Bytes.asSlice(&name))
    suffix = suffix + 1
  }
  let directory = run Path.join(Projects.outputDirectory(package), "doctest")
  run FileSystem.createDirectoriesRecursively(&directory)
  let output = run Path.join(&directory, "example")
  let options = ProjectCommands.options()
  let host = [run Bytes.copy(b"host")]
  let listed = List<Outcome>.asMutSlice(&mut outcomes.*)
  let mut summary = Summary {collected: listed.length, passed: 0, skipped: 0, failed: 0}
  let mut at = usize.ZERO
  while at < listed.length {
    let mut pending = Option<Bytes>.none()
    if let Verdict.Pending {code} = &listed[at].verdict { pending = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&code))) }
    if let Option<Bytes>.Some {value} = move pending {
      listed[at].verdict = run runExample(package, &options, &host, libraryRoot, &entry, &output, Bytes.asSlice(&alias), Bytes.asSlice(&value))
    }
    run Doctest.writeOutcome(&mut summary, &listed[at])
    at = at + usize.ONE
  }
  run Doctest.writeSummary(&summary)
  return move summary
}

effect fn exampleFailure(reason: &[u8]) -> Verdict ! OutOfMemoryError ? &mut Allocator {
  return Verdict.Failed {reason: run Bytes.copy(reason), details: Bytes.make()}
}

// Builds one example as the entry of `package` for the host, with the package's default profile,
// then runs it in the package directory. Status 0 passes; the build's diagnostics are on standard
// error, and a failing program's output follows its result line.
effect fn runExample(package: &Project, options: &ProjectOptions, host: &[Bytes], libraryRoot: &Path, entry: &Path, output: &Path, alias: &[u8], code: &[u8]) -> Verdict
! ApplicationError | InitialProfileProblem | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  let mut plans = match move run projectPlans(package, options, host) {
    Option<List<ProjectPlan>>.Some {value} => move value
    Option<List<ProjectPlan>>.None => { return run exampleFailure(b"the package has no build profile for this host") }
  }
  let plan = List<ProjectPlan>.remove(&mut plans, usize.ZERO)
  let ProjectPlan {input: planned, bindings, name: _, maxMemory} = move plan
  let mut input = move planned
  input.artifact = Option<Bytes>.some(run Bytes.copy(Projects.profileArtifact(Form.Executable)))
  let profile = run InitialProfile.freeze(&input)
  let target = Target.forId(Target.id(InitialProfile.target(&profile)))
  if Target.id(&target) != Target.id(&hostTarget()) && !same(Target.operatingSystem(&target), b"wasi") {
    let mut reason = run Bytes.copy(b"the package builds for ")
    run Bytes.append(&mut reason, Target.name(&target))
    run Bytes.append(&mut reason, b", which cannot run on this host; mark the example no_run")
    return Verdict.Failed {reason: move reason, details: Bytes.make()}
  }
  let library = Option<Path>.some(run Path.fromBytes(Path.rawBytes(libraryRoot)))
  let mut files = run ExampleSources.make(entry, code)
  let mut silent = Progress.off()
  let built = run build(entry, Option<&Path>.some(Projects.manifest(package)), Option<&Path>.none(), output, Projects.directory(package), Form.Executable, Stage.Final, move library, move profile, move maxMemory, move bindings, Projects.supply(package), false, false, &Option<Bytes>.none(), &Option<Bytes>.none(), Option<&[u8]>.some(alias), false, &mut silent)
    |> Effect.provideMut<FileSystem>(&mut files)
  let status = match move built {
    Compiled.Finished {status} => status
    Compiled.Tests {identities} => {
      drop identities
      return run exampleFailure(b"the example did not build")
    }
  }
  if status != 0 { return run exampleFailure(b"the example did not build") }
  let mut request = run ChildProcess.requestWithin(output, Projects.directory(package))
  if same(Target.operatingSystem(&target), b"wasi") {
    request = match move run WasiTools.request(output, b"0", Option<&Path>.some(Projects.directory(package))) {
      Option<ProcessRequest>.Some { value } => move value
      Option<ProcessRequest>.None => { return run exampleFailure(b"the WASI runtime is unavailable") }
    }
  }
  let outcome = run ChildProcess.submit(&request)
  let mut details = run Bytes.copy(ChildProcess.outputBytes(&outcome))
  run Bytes.append(&mut details, ChildProcess.errorBytes(&outcome))
  if Bytes.length(&details) > usize.ZERO && Bytes.asSlice(&details)[Bytes.length(&details) - usize.ONE] != 10 {
    run Bytes.append(&mut details, b"\n")
  }
  let mut reason = Bytes.make()
  if let Option<i32>.Some {value} = move ChildProcess.exitCode(&outcome) {
    if value == 0 { return Verdict.Passed }
    run Bytes.append(&mut reason, b"the example exited with status ")
    run JsonText.appendDecimal(&mut reason, i32.toUsize(value))
  } else if let Option<i32>.Some {value: signal} = move ChildProcess.terminatingSignal(&outcome) {
    run Bytes.append(&mut reason, b"the example stopped on signal ")
    run JsonText.appendDecimal(&mut reason, i32.toUsize(signal))
  } else {
    run Bytes.append(&mut reason, b"the example did not finish")
  }
  return Verdict.Failed {reason: move reason, details: move details}
}

effect fn program() -> i32
! ApplicationError | InitialProfileProblem | HostInputError | OutOfMemoryError | FileError | WriterError | ProcessError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch
? &mut HostInput | &mut Allocator | &mut Writer | &mut Types {
  let captured = run Effect.result(HostInput.argument(usize.ONE))
  let selector = match move captured {
    Result<Option<Bytes>, HostInputError | OutOfMemoryError>.Success {value: argument} => move argument
    Result<Option<Bytes>, HostInputError | OutOfMemoryError>.Failure {error: _} => {
      let mut diagnostics = StderrWriter.make()
      let reported = run Effect.result(Writer.writeAll(b"silk: cannot read command argument\n")
        |> Effect.provideMut<Writer>(&mut diagnostics))
      drop reported
      return 2
    }
  }
  if let Option<Bytes>.Some {value} = move selector {
    let selected = Bytes.asSlice(&value)
    // `silk <command> --help` prints that command's usage; the documentation commands print their
    // own.
    let documentation = same(selected, b"doc") || same(selected, b"doctest") || same(selected, b"doc-reference")
    let count = run HostInput.argumentCount()
    // `silk help` prints the overview, and `silk help <command>` that command's synopsis.
    if same(selected, b"help") && count <= usize.add(0, 3) {
      let mut stdout = StdoutWriter.make()
      if count == usize.add(0, 2) {
        run Writer.writeAll(usage()) |> Effect.provideMut<Writer>(&mut stdout)
        return 0
      }
      let named = run argumentAt(usize.add(0, 2), count)
      let lines = run commandUsage(Bytes.asSlice(&named))
      if Bytes.length(&lines) > usize.ZERO {
        run Writer.writeAll(Bytes.asSlice(&lines)) |> Effect.provideMut<Writer>(&mut stdout)
        return 0
      }
      run writeError(b"silk: unknown command `")
      run writeError(Bytes.asSlice(&named))
      run writeError(b"`\n")
      run writeError(usage())
      return 2
    }
    if !documentation && count == usize.add(0, 3) {
      let flag = run argumentAt(usize.add(0, 2), usize.add(0, 3))
      if same(Bytes.asSlice(&flag), b"--help") || same(Bytes.asSlice(&flag), b"-h") {
        let lines = run commandUsage(selected)
        if Bytes.length(&lines) > usize.ZERO {
          let mut stdout = StdoutWriter.make()
          run Writer.writeAll(Bytes.asSlice(&lines)) |> Effect.provideMut<Writer>(&mut stdout)
          return 0
        }
      }
    }
    if same(selected, b"lsp") && (count == usize.add(0, 2) || count == usize.add(0, 4)) {
      // The server reads the standard library `--stdlib <directory>` names, or else the one
      // installed beside the compiler, when there is one.
      let mut configured = Option<Bytes>.none()
      if count == usize.add(0, 4) {
        let flag = run argumentAt(usize.add(0, 2), count)
        if !same(Bytes.asSlice(&flag), b"--stdlib") {
          return run invalidArgumentCount(count)
        }
        configured = Option<Bytes>.some(run argumentAt(usize.add(0, 3), count))
      }
      let workingDirectory = run HostInput.workingDirectory()
      let working = run Path.fromBytes(Bytes.asSlice(&workingDirectory))
      let mut files = run OsFileSystem.make("/")
      let standardLibrary = run standardLibraryFor(&working, &configured)
        |> Effect.provideMut<FileSystem>(&mut files)
      return run LspCommand.runHost(move standardLibrary, hostTarget())
    }
    if same(selected, b"doctest") {
      let mut files = run OsFileSystem.make("/")
      let mut process = OsChildProcess.make()
      return run doctest()
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    if same(selected, b"doc") || same(selected, b"doctest") || same(selected, b"doc-reference") {
      let mut files = run OsFileSystem.make("/")
      return run DocumentationCommand.runHost(selected)
        |> Effect.provideMut<FileSystem>(&mut files)
    }
    if same(Bytes.asSlice(&value), b"format") {
      let mut diagnostics = StderrWriter.make()
      let initialized = run Effect.result(OsFileSystem.make("/"))
      let mut files = match move initialized {
        Result<OsFileSystem, OutOfMemoryError>.Success {value: provider} => move provider
        Result<OsFileSystem, OutOfMemoryError>.Failure {error: _} => {
          let reported = run Effect.result(Writer.writeAll(b"silk format: cannot initialize filesystem\n")
            |> Effect.provideMut<Writer>(&mut diagnostics))
          drop reported
          return 2
        }
      }
      let ran = run FormatCommand.runHost()
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<Writer>(&mut diagnostics)
      let reported = run Effect.result(reportFormat(List<FileOutcome>.asSlice(&ran.outcomes)))
      if let Result<(), WriterError | OutOfMemoryError>.Failure {error: _} = move reported { return 2 }
      return ran.status
    }
  }
  let command = run request()
  let workingDirectory = run HostInput.workingDirectory()
  let validated = match move HostInput.text(Bytes.asSlice(&workingDirectory)) {
    Result<string, InvalidUtf8>.Success {value: _} => ()
    Result<string, InvalidUtf8>.Failure {error: _} => run invalidWorkingDirectoryEncoding()
  }
  let mut files = run OsFileSystem.make("/")
  let working = run Path.fromBytes(Bytes.asSlice(&workingDirectory))
  return match move command {
    Request.Build {source, output, stage, standardLibrary: configured, input, stats, clang} => {
      let sourcePath = run pathArgument(&working, Bytes.asSlice(&source))
      let outputPath = run pathArgument(&working, Bytes.asSlice(&output))
      let selectedClang = run clangFor(&working, &clang)
      let standardLibrary = run standardLibraryFor(&working, &configured)
        |> Effect.provideMut<FileSystem>(&mut files)
      let mut process = OsChildProcess.make()
      return run buildSource(&working, &sourcePath, &outputPath, move stage, move standardLibrary, move input, stats, &selectedClang)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.Test {source, output, standardLibrary: configured, profile, filter, file, timeout, noCache} => {
      let sourcePath = run pathArgument(&working, Bytes.asSlice(&source))
      let outputPath = run pathArgument(&working, Bytes.asSlice(&output))
      let standardLibrary = run standardLibraryFor(&working, &configured)
        |> Effect.provideMut<FileSystem>(&mut files)
      let mut process = OsChildProcess.make()
      let display = match move run Path.parent(&sourcePath) {
        Option<Path>.Some {value} => move value
        Option<Path>.None => run Path.root()
      }
      // The runner builds in the source's package, found and refused as `silk build <source>` does.
      let located = run locateProject(&display, &Option<Bytes>.none())
        |> Effect.provideMut<FileSystem>(&mut files)
      if let Option<Project>.None = &located { return 2 }
      drop located
      let automatic = SupplyRequest.Automatic
      let selecting = hasFilter(&filter) || hasFilter(&file)
      let mut matched = false
      let status = run test(&sourcePath, Option<&Path>.none(), &outputPath, &display, &automatic, move standardLibrary, move profile, List<Supplied>.make(), move filter, move file, &timeout, &Option<Bytes>.none(), noCache, &mut matched)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
      if status == 0 && selecting && !matched {
        run reportUnmatched()
        return 1
      }
      return status
    }
    Request.Run {command: invocation} => {
      let mut process = OsChildProcess.make()
      return run runProject(&working, move invocation)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.Clean {command: invocation} => {
      return run cleanProject(&working, move invocation)
        |> Effect.provideMut<FileSystem>(&mut files)
    }
    Request.Add {command: invocation} => {
      let outcome = run Effect.result(addedDependency(&working, move invocation)
        |> Effect.provideMut<FileSystem>(&mut files))
      return run reportedEdit(move outcome)
    }
    Request.Remove {command: invocation} => {
      let outcome = run Effect.result(removedDependency(&working, move invocation)
        |> Effect.provideMut<FileSystem>(&mut files))
      return run reportedEdit(move outcome)
    }
    Request.Check {command: invocation} => {
      let mut process = OsChildProcess.make()
      return run checkProject(&working, move invocation)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.ProjectBuild {command: invocation} => {
      let mut process = OsChildProcess.make()
      return run buildProject(&working, move invocation)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.ProjectTest {command: invocation} => {
      let mut process = OsChildProcess.make()
      return run testProject(&working, move invocation)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.Help => {
      let mut stdout = StdoutWriter.make()
      run Writer.writeAll(usage()) |> Effect.provideMut<Writer>(&mut stdout)
      return 0
    }
    Request.Version => {
      let mut stdout = StdoutWriter.make()
      run Writer.writeAll(b"silk v") |> Effect.provideMut<Writer>(&mut stdout)
      run Writer.writeAll(ReleaseVersion.value()) |> Effect.provideMut<Writer>(&mut stdout)
      run Writer.writeAll(b"\n") |> Effect.provideMut<Writer>(&mut stdout)
      return 0
    }
    Request.Init {command: invocation} => {
      return run initProject(&working, move invocation)
        |> Effect.provideMut<FileSystem>(&mut files)
    }
    Request.Dump {source: argument, hir: dumpHir} => {
      let path = run pathArgument(&working, Bytes.asSlice(&argument))
      // A lone word that names no file and no Silk source is a mistyped command, not a dump.
      let written = Bytes.asSlice(&argument)
      let sourceLike = CommandPath.contains(written, 47)
        || (written.length > usize.add(0, 5) && same(Slice.view<u8>(written, written.length - usize.add(0, 5), usize.add(0, 5)), b".silk"))
      let present = run CommandPath.exists(Path.rawBytes(&path), false)
        |> Effect.provideMut<FileSystem>(&mut files)
      if !present {
        // A path-like word names a missing source; a bare word is a mistyped command. Both are
        // usage errors, status 2, with the word the user wrote.
        if dumpHir || sourceLike {
          run writeError(b"silk: no such source file `")
          run writeError(written)
          run writeError(b"`; a lone argument is a command or a Silk source file to dump\n")
        } else {
          run writeError(b"silk: unknown command `")
          run writeError(written)
          run writeError(b"`\n")
        }
        run writeError(usage())
        return 2
      }
      let source = run FileSystem.readFile(&path)
        |> Effect.provideMut<FileSystem>(&mut files)
      let mut lexer = Lexer.make(Bytes.asSlice(&source))
      let tokens = run lex(&mut lexer)
      let tree = run Parser.parse(move source, move tokens)
      if dumpHir {
        let module = run Lower.lower(&tree)
        run Hir.write(&module)
        run Fingerprint.writeFingerprints(&module)
        run Hir.writeViolations(&module)
        return 0
      }
      run SyntaxTree.write(&tree)
      return 0
    }
  }
}

/// Names one portable file operation code for a failure report.
fn fileOperationName(code: i32) -> &'static [u8] {
  if code == 0 { return b"read" }
  if code == 1 { return b"write" }
  if code == 2 { return b"inspect" }
  if code == 3 { return b"list" }
  if code == 4 { return b"create directory" }
  if code == 5 { return b"remove" }
  if code == 6 { return b"remove directory" }
  if code == 7 { return b"resolve path" }
  return b"create temporary directory"
}

/// Names one portable file failure reason code for a failure report.
fn fileReasonName(code: i32) -> &'static [u8] {
  if code == 0 { return b"not found" }
  if code == 1 { return b"already exists" }
  if code == 2 { return b"permission denied" }
  if code == 3 { return b"invalid path" }
  if code == 4 { return b"wrong file type" }
  if code == 5 { return b"directory not empty" }
  if code == 6 { return b"no space left" }
  if code == 7 { return b"too large" }
  if code == 8 { return b"unsupported" }
  return b"other failure"
}

/// Writes one line naming a failure that escaped the command, so no failure exits silently.
///
/// The synchronous native startup maps an unhandled failure to status 1 without a report, so the
/// command reports its own failures before returning that status.
///
/// The status is 2 for a command line that does not parse, as for every usage error, else 1.
effect fn report(failure: ApplicationError | InitialProfileProblem | HostInputError | OutOfMemoryError | FileError | WriterError | ProcessError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch) -> i32 ! WriterError {
  match move failure {
    ApplicationError application => match move application {
      ApplicationError.InvalidArgumentCount {actual: _} => {
        run writeError(usage())
        return 2
      }
      ApplicationError.InvalidCommand {message} => {
        run writeError(Bytes.asSlice(&message))
        return 2
      }
      ApplicationError.InvalidWorkingDirectoryEncoding => run writeError(b"silk: the working directory is not UTF-8\n")
      ApplicationError.InvalidBuildProfile => run writeError(b"silk: invalid build profile\n")
      ApplicationError.InvalidPath {argument} => {
        run writeError(b"silk: invalid path argument: ")
        run writeError(Bytes.asSlice(&argument))
        run writeError(b"\n")
      }
      ApplicationError.NotStandardLibrary {directory, missing} => {
        run writeError(b"silk: --stdlib ")
        run writeError(Bytes.asSlice(&directory))
        if missing {
          run writeError(b" is not a standard library directory: it does not exist\n")
        } else {
          run writeError(b" is not a standard library directory: it has no compositions.json\n")
        }
      }
    }
    InitialProfileProblem problem => {
      drop problem
      run writeError(b"silk: invalid build profile\n")
    }
    HostInputError ignored => run writeError(b"silk: cannot read host input\n")
    OutOfMemoryError ignored => run writeError(b"silk: out of memory\n")
    FileError file => {
      run writeError(b"silk: cannot ")
      run writeError(fileOperationName(file.operation.code))
      run writeError(b": ")
      run writeError(fileReasonName(file.reason.code))
      run writeError(b"\n")
    }
    WriterError ignored => run writeError(b"silk: cannot write output\n")
    ProcessError ignored => run writeError(b"silk: cannot run the C compiler\n")
    InvalidModulePath ignored => run writeError(b"silk: invalid module path\n")
    InvalidSourceRoot ignored => run writeError(b"silk: invalid source root\n")
    InvalidDependency invalid => {
      // A refused dependency is a manifest error like the others.
      run writeDependency(&invalid)
      return 2
    }
    MissingManifest missing => {
      run writeError(b"silk: no silk.toml in ")
      run writeError(Path.rawBytes(&missing.directory))
      run writeError(b" or any parent directory; a build needs a package manifest\n")
    }
    InvalidBuildComposition ignored => run writeError(b"silk: the build selects no single runtime (ARTIFACT-001)\n")
    MissingStandardLibrary ignored => run writeError(b"silk: no standard library found: install it as lib/silk/stdlib beside the compiler's bin directory, or pass --stdlib <directory>\n")
    InvalidNativeLinkInput invalid => {
      run writeError(b"silk: invalid native link input: ")
      run writeError(Bytes.asSlice(&invalid.detail))
      run writeError(b"\n")
    }
    TomlError ignored => run writeError(b"silk: invalid TOML manifest\n")
    RegistrationClosed ignored => run writeError(b"silk: internal error: query registration closed\n")
    ConflictingPackageSource ignored => run writeError(b"silk: conflicting package sources\n")
    Cycle ignored => run writeError(b"silk: internal error: query cycle\n")
    RevisionMismatch ignored => run writeError(b"silk: internal error: source revision mismatch\n")
  }
  return 1
}

pub effect fn main() -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let mut output = StdoutWriter.make()
  let outcome = run Effect.result(
    program()
      |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
      |> Effect.provideMut<Writer>(&mut output),
  )
  return match move outcome {
    Result<i32, ApplicationError | InitialProfileProblem | HostInputError | OutOfMemoryError | FileError | WriterError | ProcessError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch>.Success {value} => value
    Result<i32, ApplicationError | InitialProfileProblem | HostInputError | OutOfMemoryError | FileError | WriterError | ProcessError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch>.Failure {error} => {
      return match move run Effect.result(report(move error)) {
        Result<i32, WriterError>.Success {value} => value
        Result<i32, WriterError>.Failure {error: _} => 1
      }
    }
  }
}
