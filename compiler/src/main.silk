// The overview that `silk help` and `--help` print, and that a malformed command line repeats:
// one line for each command, project commands first.
fn usage() -> &'static [u8] {
  return b"usage: silk <command> [options]\n\nProject commands:\n  init           Create a package or a workspace\n  build          Build the package or the workspace members\n  run            Build the package and run it\n  debug          Build the package and run it under a debugger\n  test           Run the package's tests\n  task           Run one of the package's tasks, written in src/tasks.silk\n  plan           Write compilation requests for editors and tools\n  check          Report errors without building\n  hash           Print a digest of everything a build reads\n  format         Format Silk source and TOML files\n  clean          Remove the build directory\n  pack           Check the package and write its release archives and checksums\n  add            Add a dependency on a package directory or a package archive URL\n  fetch          Fetch all declared dependencies for offline work\n  remove         Remove a dependency\n\nTools:\n  resolve        Resolve a compilation definition into an explicit request\n  package-path   Resolve a dependency's explicitly included file\n  compile        Compile an explicit TOML request\n  graph          Run a build graph described by a task program\n  request-schema Write the compilation request JSON Schema\n  manifest-schema Write the package manifest JSON Schema\n  doc            Write the package's documentation as JSON\n  doctest        Check and run the examples in documentation comments\n  doc-reference  Write the standard library reference pages\n  lsp            Start the language server\n  dump           Print a source file's tokens, syntax tree, HIR or MIR\n  help           Show this help, or the options of one command\n\nOptions:\n  -h, --help     Show this help\n  -v, --version  Show the Silk version\n\nRun `silk help <command>` to see the options of a command.\n"
}

// The synopsis of every command that `silk.cli` does not describe, one `silk <command> ...` line
// each, that `silk help <command>` and `silk <command> --help` select from. The single-file
// `build` and `test` forms follow the help of the project forms.
fn synopsis() -> &'static [u8] {
  return b"silk help [command]\nsilk --help | --version\n"
}

// The lines of the synopsis that start `silk <command> `, as `silk <command> --help` prints them:
// empty when the synopsis has none.
effect fn commandUsage(command: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let text = synopsis()
  let mut lines = Bytes.make()
  let mut start = usize.ZERO
  while start < text.length {
    let mut end = start
    while end < text.length && text[end] != 10 {
      end = end + usize.ONE
    }
    let mut at = start
    while at < end && text[at] == 32 {
      at = at + usize.ONE
    }
    let named = at + usize.add(0, 5) + command.length
    if named <= end && same(Slice.view<u8>(text, at, usize.add(0, 5)), b"silk ")
      && same(Slice.view<u8>(text, at + usize.add(0, 5), command.length), command)
      && (named == end || text[named] == 32) {
      if Bytes.length(&lines) == usize.ZERO {
        run Bytes.append(&mut lines, b"usage: ")
      } else {
        run Bytes.append(&mut lines, b"       ")
      }
      run Bytes.append(&mut lines, Slice.view<u8>(text, at, end - at))
      run Bytes.append(&mut lines, b"\n")
    }
    start = end + usize.ONE
  }
  return move lines
}

// Writes the help of `command`: a project command's options, then the synopsis lines of its other
// forms; with `json`, the project command's help as one JSON object. Returns `false`, and writes
// nothing, for a command with no such help.
effect fn writeCommandHelp(command: &[u8], json: bool) -> bool
  ! OutOfMemoryError | WriterError
  ? &mut Allocator | &mut Writer {
  if json {
    return run ProjectCommands.writeHelp(command, true)
  }
  let lines = run commandUsage(command)
  if same(command, b"format") {
    run FormatCommand.writeHelp()
    return true
  }
  if same(command, b"doc") || same(command, b"doctest") || same(command, b"doc-reference") {
    run DocumentationCommand.writeHelp(command)
    return true
  }
  let described = run ProjectCommands.writeHelp(command, false)
  if described && Bytes.length(&lines) > usize.ZERO {
    run Writer.writeAll(b"\n")
  }
  run Writer.writeAll(Bytes.asSlice(&lines))
  return described || Bytes.length(&lines) > usize.ZERO
}

// Whether the command at argument 1 has no source operand, which makes it a project command: no
// further argument, or an option next, since a source file never begins with `-`.
effect fn projectForm(count: usize) -> bool
  ! ApplicationError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  if count == usize.add(0, 2) {
    return true
  }
  let first = run argumentAt(usize.add(0, 2), count)
  let text = Bytes.asSlice(&first)
  return text.length > usize.ZERO && text[usize.ZERO] == 45
}

/// Reads `build <source> -o <output> [--emit <stage>] [--target <triple>] [--clang <path>] [--stats]`,
/// `test <root> -o <output> [--filter <text>] [--file <path>] [--no-cache]`, and dump modes. A build's
/// source-file form is an executable; `--emit` selects its final or intermediate output.
effect fn request() -> Request
  ! ApplicationError | InitialProfileProblem | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let count = run HostInput.argumentCount()
  if count == usize.add(0, 2) {
    let only = run argumentAt(usize.ONE, count)
    let flag = Bytes.asSlice(&only)
    if same(flag, b"--help") || same(flag, b"-h") {
      return Request.Help
    }
    if same(flag, b"--version") || same(flag, b"-v") {
      return Request.Version
    }
  }
  if count >= usize.add(0, 2) {
    let command = run argumentAt(usize.ONE, count)
    if same(Bytes.asSlice(&command), b"request-schema") {
      let arguments = run commandArguments(count)
      return match move run Effect.result(ProjectCommands.parseRequestSchema(arguments.asSlice())) {
        Result<ProjectCommands.RequestSchema, InvalidProjectCommand | OutOfMemoryError>.Success {
          ..
        } => Request.Schema { kind: SchemaKind.Request }
        Result<ProjectCommands.RequestSchema, InvalidProjectCommand | OutOfMemoryError>.Failure {
          error
        } => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"request-schema", move invalid)
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    if same(Bytes.asSlice(&command), b"manifest-schema") {
      let arguments = run commandArguments(count)
      return match move run Effect.result(
        ProjectCommands.parseManifestSchema(arguments.asSlice()),
      ) {
        Result<ProjectCommands.ManifestSchema, InvalidProjectCommand | OutOfMemoryError>.Success {
          ..
        } => Request.Schema { kind: SchemaKind.Manifest }
        Result<ProjectCommands.ManifestSchema, InvalidProjectCommand | OutOfMemoryError>.Failure {
          error
        } => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"manifest-schema", move invalid)
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    if same(Bytes.asSlice(&command), b"plan") {
      let arguments = run commandArguments(count)
      return match move run Effect.result(ProjectCommands.parsePlan(arguments.asSlice())) {
        Result<ProjectCommands.Plan, InvalidProjectCommand | OutOfMemoryError>.Success {
          value
        } => Request.Plan { command: move value }
        Result<ProjectCommands.Plan, InvalidProjectCommand | OutOfMemoryError>.Failure {
          error
        } => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"plan", move invalid)
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    if same(Bytes.asSlice(&command), b"fetch") {
      let arguments = run commandArguments(count)
      return match move run Effect.result(ProjectCommands.parseFetch(arguments.asSlice())) {
        Result<ProjectCommands.Fetch, InvalidProjectCommand | OutOfMemoryError>.Success {
          value
        } => Request.Fetch { command: move value }
        Result<ProjectCommands.Fetch, InvalidProjectCommand | OutOfMemoryError>.Failure {
          error
        } => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"fetch", move invalid)
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    if same(Bytes.asSlice(&command), b"package-path") {
      let arguments = run commandArguments(count)
      return match move run Effect.result(ProjectCommands.parsePackagePath(arguments.asSlice())) {
        Result<ProjectCommands.PackagePath, InvalidProjectCommand | OutOfMemoryError>.Success {
          value
        } => Request.PackagePath { command: move value }
        Result<ProjectCommands.PackagePath, InvalidProjectCommand | OutOfMemoryError>.Failure {
          error
        } => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"package-path", move invalid)
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    if same(Bytes.asSlice(&command), b"resolve") {
      let arguments = run commandArguments(count)
      return match move run Effect.result(ProjectCommands.parseResolve(arguments.asSlice())) {
        Result<ProjectCommands.Resolve, InvalidProjectCommand | OutOfMemoryError>.Success {
          value
        } => Request.Resolve { command: move value }
        Result<ProjectCommands.Resolve, InvalidProjectCommand | OutOfMemoryError>.Failure {
          error
        } => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"resolve", move invalid)
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    if same(Bytes.asSlice(&command), b"graph") {
      let arguments = run commandArguments(count)
      return match move run Effect.result(ProjectCommands.parseGraph(arguments.asSlice())) {
        Result<ProjectCommands.Graph, InvalidProjectCommand | OutOfMemoryError>.Success {
          value
        } => Request.Graph { command: move value }
        Result<ProjectCommands.Graph, InvalidProjectCommand | OutOfMemoryError>.Failure {
          error
        } => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"graph", move invalid)
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    if same(Bytes.asSlice(&command), b"compile") {
      let arguments = run commandArguments(count)
      return match move run Effect.result(ProjectCommands.parseCompile(arguments.asSlice())) {
        Result<ProjectCommands.Compile, InvalidProjectCommand | OutOfMemoryError>.Success {
          value
        } => Request.Compile {
          file: move value.request,
          ignoreWarnings: value.ignoreWarnings,
          progress: value.progress,
        }
        Result<ProjectCommands.Compile, InvalidProjectCommand | OutOfMemoryError>.Failure {
          error
        } => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"compile", move invalid)
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    if same(Bytes.asSlice(&command), b"run") {
      return Request.Run { command: run runRequest(count) }
    }
    if same(Bytes.asSlice(&command), b"debug") {
      return Request.Run { command: run debugRequest(count) }
    }
    if same(Bytes.asSlice(&command), b"task") {
      return Request.Task { command: run taskRequest(count) }
    }
    if same(Bytes.asSlice(&command), b"init") {
      return Request.Init { command: run initRequest(count) }
    }
    if same(Bytes.asSlice(&command), b"dump") {
      return run dumpRequest(count)
    }
    if same(Bytes.asSlice(&command), b"add") {
      let arguments = run commandArguments(count)
      let parsed = run Effect.result(ProjectCommands.parseAdd(List<Bytes>.asSlice(&arguments)))
      return match move parsed {
        Result<AddCommand, InvalidProjectCommand | OutOfMemoryError>.Success {
          value
        } => Request.Add { command: move value }
        Result<AddCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {
          error
        } => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"add", move invalid)
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    if same(Bytes.asSlice(&command), b"remove") {
      let arguments = run commandArguments(count)
      let parsed = run Effect.result(ProjectCommands.parseRemove(List<Bytes>.asSlice(&arguments)))
      return match move parsed {
        Result<RemoveCommand, InvalidProjectCommand | OutOfMemoryError>.Success {
          value
        } => Request.Remove { command: move value }
        Result<RemoveCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {
          error
        } => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"remove", move invalid)
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    if same(Bytes.asSlice(&command), b"clean") {
      let arguments = run commandArguments(count)
      let parsed = run Effect.result(ProjectCommands.parseClean(List<Bytes>.asSlice(&arguments)))
      return match move parsed {
        Result<CleanCommand, InvalidProjectCommand | OutOfMemoryError>.Success {
          value
        } => Request.Clean { command: move value }
        Result<CleanCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {
          error
        } => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"clean", move invalid)
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    if same(Bytes.asSlice(&command), b"sandbox-exec") {
      return Request.Sandbox { arguments: run commandArguments(count) }
    }
    if same(Bytes.asSlice(&command), b"pack") {
      let arguments = run commandArguments(count)
      let parsed = run Effect.result(ProjectCommands.parsePack(List<Bytes>.asSlice(&arguments)))
      return match move parsed {
        Result<PackCommand, InvalidProjectCommand | OutOfMemoryError>.Success {
          value
        } => Request.Pack { command: move value }
        Result<PackCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {
          error
        } => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"pack", move invalid)
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    if same(Bytes.asSlice(&command), b"hash") {
      let arguments = run commandArguments(count)
      let parsed = run Effect.result(ProjectCommands.parseHash(List<Bytes>.asSlice(&arguments)))
      return match move parsed {
        Result<HashCommand, InvalidProjectCommand | OutOfMemoryError>.Success {
          value
        } => Request.Hash { command: move value }
        Result<HashCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {
          error
        } => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"hash", move invalid)
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    if same(Bytes.asSlice(&command), b"check") {
      let arguments = run commandArguments(count)
      let parsed = run Effect.result(ProjectCommands.parseCheck(List<Bytes>.asSlice(&arguments)))
      return match move parsed {
        Result<CheckCommand, InvalidProjectCommand | OutOfMemoryError>.Success { value } => {
          run relaxVersions(&value.options)
          return Request.Check { command: move value }
        }
        Result<CheckCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {
          error
        } => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"check", move invalid)
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }

    // `build` without a source file builds the project; a source file never begins with `-`.
    if same(Bytes.asSlice(&command), b"build") {
      if run projectForm(count) {
        let arguments = run commandArguments(count)
        let parsed = run Effect.result(ProjectCommands.parseBuild(List<Bytes>.asSlice(&arguments)))
        return match move parsed {
          Result<BuildCommand, InvalidProjectCommand | OutOfMemoryError>.Success { value } => {
            run relaxVersions(&value.options)
            return Request.ProjectBuild { command: move value }
          }
          Result<BuildCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {
            error
          } => match move error {
            InvalidProjectCommand invalid => run invalidCommand(b"build", move invalid)
            OutOfMemoryError exhausted => {
              fail move exhausted
            }
          }
        }
      }
    }

    // `test` without a discovery root tests the project.
    if same(Bytes.asSlice(&command), b"test") {
      if run projectForm(count) {
        let arguments = run commandArguments(count)
        let parsed = run Effect.result(ProjectCommands.parseTest(List<Bytes>.asSlice(&arguments)))
        return match move parsed {
          Result<TestCommand, InvalidProjectCommand | OutOfMemoryError>.Success { value } => {
            run relaxVersions(&value.options)
            return Request.ProjectTest { command: move value }
          }
          Result<TestCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {
            error
          } => match move error {
            InvalidProjectCommand invalid => run invalidCommand(b"test", move invalid)
            OutOfMemoryError exhausted => {
              fail move exhausted
            }
          }
        }
      }
    }
  }
  if count >= usize.add(0, 3) {
    let mode = run argumentAt(usize.ONE, count)
    let testing = same(Bytes.asSlice(&mode), b"test")
    if testing || same(Bytes.asSlice(&mode), b"build") {
      let arguments = run commandArguments(count)
      let target = hostTarget()
      let mut input = ProfileInput.make()
      input.target = Option<Bytes>.some(run Bytes.copy(Target.name(&target)))
      input.optimization = Option<Bytes>.some(run Bytes.copy(b"speed"))
      input.debug = Option<bool>.some(false)
      if testing {
        let tested = match move run Effect.result(
          ProjectCommands.parseSourceTest(List<Bytes>.asSlice(&arguments)),
        ) {
          Result<SourceTestCommand, InvalidProjectCommand | OutOfMemoryError>.Success {
            value
          } => move value
          Result<SourceTestCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {
            error
          } => match move error {
            InvalidProjectCommand invalid => run invalidCommand(b"test", move invalid)
            OutOfMemoryError exhausted => {
              fail move exhausted
            }
          }
        }
        if let Option<Bytes>.Some { value } = move tested.optimization {
          input.optimization = Option<Bytes>.some(move value)
        }
        if let Option<Bytes>.Some { value } = &tested.debug {
          input.debug = Option<bool>.some(same(Bytes.asSlice(&value), b"true"))
        }

        // A test build is always the runner's executable, whatever its manifest selects.
        input.artifact = Option<Bytes>.some(
          run Bytes.copy(Projects.profileArtifact(Form.Executable)),
        )
        let initial = run InitialProfile.freeze(&input)
        if Target.id(InitialProfile.target(&initial)) != Target.id(&target) {
          return run invalidBuildProfile()
        }
        return Request.Test {
          source: move tested.root,
          output: move tested.output,
          standardLibrary: move tested.standardLibrary,
          profile: move initial,
          filter: move tested.filter,
          file: move tested.file,
          timeout: move tested.timeout,
          noCache: tested.noCache,
          ignoreWarnings: tested.ignoreWarnings,
        }
      }
      let built = match move run Effect.result(
        ProjectCommands.parseSourceBuild(List<Bytes>.asSlice(&arguments)),
      ) {
        Result<SourceBuildCommand, InvalidProjectCommand | OutOfMemoryError>.Success {
          value
        } => move value
        Result<SourceBuildCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {
          error
        } => match move error {
          InvalidProjectCommand invalid => run invalidCommand(b"build", move invalid)
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
      if let Option<Bytes>.Some { value } = move built.target {
        input.target = Option<Bytes>.some(move value)
      }
      if let Option<Bytes>.Some { value } = move built.optimization {
        input.optimization = Option<Bytes>.some(move value)
      }
      if let Option<Bytes>.Some { value } = &built.debug {
        input.debug = Option<bool>.some(same(Bytes.asSlice(&value), b"true"))
      }
      input.backend = move built.backend
      let mut stage = Option<Stage>.none()
      if let Option<Bytes>.Some { value } = &built.emit {
        stage = Projects.stageNamed(Bytes.asSlice(&value))
      }
      return Request.Build {
        source: move built.source,
        output: move built.output,
        stage: move stage,
        standardLibrary: move built.standardLibrary,
        input: move input,
        stats: built.stats,
        clang: move built.clang,
        mir: MirListing.Off,
        ignoreWarnings: built.ignoreWarnings,
      }
    }
  }

  // A lone word is a mistyped command.
  if count == usize.add(0, 2) {
    let word = run argumentAt(usize.ONE, count)
    let mut message = run Bytes.copy(b"silk: unknown command `")
    run Bytes.append(&mut message, Bytes.asSlice(&word))
    run Bytes.append(&mut message, b"`\n")
    run Bytes.append(&mut message, usage())
    fail ApplicationError.InvalidCommand { message: move message }
  }
  return run invalidArgumentCount(count)
}

/// Reads `dump tokens|syntax|hir <source>` and `dump mir <source> [--all] [--target <triple>]
/// [--stdlib <directory>] [--optimization none|speed|size] [--debug true|false]`. The MIR form is a
/// single-source build of the source's package for the target that lists the lowered functions on
/// standard output: those declared in the package, or with `--all`, every reached one.
effect fn dumpRequest(count: usize) -> Request
  ! ApplicationError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let arguments = run commandArguments(count)
  let dumped = match move run Effect.result(
    ProjectCommands.parseDump(List<Bytes>.asSlice(&arguments)),
  ) {
    Result<DumpCommand, InvalidProjectCommand | OutOfMemoryError>.Success { value } => move value
    Result<DumpCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {
      error
    } => match move error {
      InvalidProjectCommand invalid => run invalidCommand(b"dump", move invalid)
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let named = Bytes.asSlice(&dumped.stage)
  let source = move dumped.source
  if same(named, b"tokens") {
    return Request.Dump { stage: Dumped.Tokens, source: move source }
  }
  if same(named, b"syntax") {
    return Request.Dump { stage: Dumped.Syntax, source: move source }
  }
  if same(named, b"hir") {
    return Request.Dump { stage: Dumped.Hir, source: move source }
  }
  let mut input = ProfileInput.make()
  let target = hostTarget()
  input.target = Option<Bytes>.some(run Bytes.copy(Target.name(&target)))
  input.optimization = Option<Bytes>.some(run Bytes.copy(b"speed"))
  input.debug = Option<bool>.some(false)
  let mut listing = MirListing.Root
  if dumped.all {
    listing = MirListing.All
  }
  if let Option<Bytes>.Some { value } = move dumped.target {
    input.target = Option<Bytes>.some(move value)
  }
  if let Option<Bytes>.Some { value } = move dumped.optimization {
    input.optimization = Option<Bytes>.some(move value)
  }
  if let Option<Bytes>.Some { value } = &dumped.debug {
    input.debug = Option<bool>.some(same(Bytes.asSlice(&value), b"true"))
  }
  let standardLibrary = move dumped.standardLibrary

  // The listing replaces the artifact, so the build stops at IR, which needs no linker.
  let output = run Bytes.copy(Bytes.asSlice(&source))
  return Request.Build {
    source: move source,
    output: move output,
    stage: Option<Stage>.some(Stage.LlvmIr),
    standardLibrary: move standardLibrary,
    input: move input,
    stats: false,
    clang: Option<Bytes>.none(),
    mir: listing,
    ignoreWarnings: true,
  }
}

effect fn lex<'source>(lexer: &mut Lexer<'source>) -> List<Token>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut tokens = List<Token>.make()
  while true {
    let taken = run Stream.take(&mut lexer)
    if let Option<Token>.Some { value } = move taken {
      run List<Token>.append(&mut tokens, move value)
    } else {
      break
    }
  }
  return move tokens
}

static if Intrinsic.targetOperatingSystem() == "darwin" {
  static if Intrinsic.targetArchitecture() == "x86_64" {
    fn hostTarget() -> Target {
      return Target.forId(TargetId.X8664AppleDarwin)
    }
  } else {
    fn hostTarget() -> Target {
      return Target.forId(TargetId.Aarch64AppleDarwin)
    }
  }
} else static if Intrinsic.targetOperatingSystem() == "windows" {
  fn hostTarget() -> Target {
    return Target.forId(TargetId.X8664PcWindowsMsvc)
  }
} else {
  static if Intrinsic.targetArchitecture() == "aarch64" {
    fn hostTarget() -> Target {
      return Target.forId(TargetId.Aarch64UnknownLinuxGnu)
    }
  } else {
    fn hostTarget() -> Target {
      return Target.forId(TargetId.X8664UnknownLinuxGnu)
    }
  }
}

fn originalGapReason(gap: &Gap) -> Option<RejectionCode> {
  return match &gap.source {
    GapSource.Diagnostic { diagnostic } => Option<RejectionCode>.some(
      Shared<Rejection>.with<RejectionCode>(
        &diagnostic,
        |value: &Rejection| -> RejectionCode {
          return value.code
        },
      ),
    )
    _ => Option<RejectionCode>.none()
  }
}

// The module whose source a gap is located in.
fn gapModule(gap: &Gap) -> ModuleId {
  return match &gap.source {
    GapSource.Declaration { declaration, .. } => Interned<DeclarationId>.with<ModuleId>(
      &declaration,
      |value: &DeclarationId| -> ModuleId {
        return ModuleId.copy(DeclarationId.moduleId(value))
      },
    )
    GapSource.Relative { declaration, .. } => Interned<DeclarationId>.with<ModuleId>(
      &declaration,
      |value: &DeclarationId| -> ModuleId {
        return ModuleId.copy(DeclarationId.moduleId(value))
      },
    )
    GapSource.Generated { declaration } => Interned<DeclarationId>.with<ModuleId>(
      &declaration,
      |value: &DeclarationId| -> ModuleId {
        return ModuleId.copy(DeclarationId.moduleId(value))
      },
    )
    GapSource.Diagnostic { diagnostic } => Shared<Rejection>.with<ModuleId>(
      &diagnostic,
      |value: &Rejection| -> ModuleId {
        return ModuleId.copy(&value.module)
      },
    )
  }
}

// One human line per gap, as a refusal prints: `path:line:col: unsupported[<reason>] not supported
// by the native compiler yet`, naming the refusal that became the gap or else the gap itself.
effect fn gapLines(
  sources: &ModuleSources,
  gaps: &[Shared<Gap>],
  reported: &[ReportedSite],
  root: &[u8],
) -> Bytes
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut lines = Bytes.make()
  let mut written = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < gaps.length {
    let code = Shared<Gap>.with<GapCode>(
      &gaps[at],
      |gap: &Gap| -> GapCode {
        return gap.code
      },
    )
    let span = Shared<Gap>.with<Span>(
      &gaps[at],
      |gap: &Gap| -> Span {
        return Gap.span(gap)
      },
    )
    let module = Shared<Gap>.with<ModuleId>(&gaps[at], gapModule)
    let mut line = Bytes.make()
    run appendLocation(&mut line, sources, &module, span, root, false)
    let original = Shared<Gap>.with<Option<RejectionCode>>(&gaps[at], originalGapReason)

    // A gap that carries a refusal already printed at the same site adds nothing.
    let mut printed = false
    if let Option<RejectionCode>.Some { value: reason } = &original {
      let mut earlier = usize.ZERO
      while earlier < reported.length {
        if reported[earlier].code == reason && reported[earlier].span.start == span.start
          && reported[earlier].span.end == span.end
          && ModuleId.equals(&reported[earlier].module, &module) {
          printed = true
        }
        earlier = earlier + usize.ONE
      }
    }
    match move original {
      Option<RejectionCode>.Some { value: reason } => {
        if Rejections.internal(reason) {
          run appendInternalError(&mut line, Rejection.name(reason))
        } else {
          run Bytes.append(&mut line, b": unsupported[")
          run Bytes.append(&mut line, Rejection.name(reason))
          run Bytes.append(&mut line, b"] not supported by the native compiler yet\n")
        }
      }
      Option<RejectionCode>.None => {
        if Gap.internal(code) {
          run appendInternalError(&mut line, Gap.name(code))
        } else {
          run Bytes.append(&mut line, b": unsupported[")
          run Bytes.append(&mut line, Gap.name(code))
          run Bytes.append(&mut line, b"] not supported by the native compiler yet\n")
        }
      }
    }
    let mut seen = false
    let previous = List<Bytes>.asSlice(&written)
    let mut earlier = usize.ZERO
    while earlier < previous.length {
      if same(Bytes.asSlice(&previous[earlier]), Bytes.asSlice(&line)) {
        seen = true
      }
      earlier = earlier + usize.ONE
    }
    if !seen && !printed {
      run Bytes.append(&mut lines, Bytes.asSlice(&line))
      run List<Bytes>.append(&mut written, move line)
    }
    at = at + usize.ONE
  }
  return move lines
}

// Ends a located line with an internal compiler error naming the violated invariant: a form an
// earlier phase should never have produced, which is a compiler bug and not a missing feature.
effect fn appendInternalError(line: &mut Bytes, name: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run Bytes.append(&mut line.*, b": internal compiler error[")
  run Bytes.append(&mut line.*, name)
  run Bytes.append(&mut line.*, b"]: this is a compiler bug, please report it\n")
  return ()
}

effect fn gapSummary(gaps: &[Shared<Gap>]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut message = run Bytes.copy(b"SILK_UNSUPPORTED_JSON={\"gaps\":[")
  let mut at = usize.ZERO
  while at < gaps.length {
    if at > usize.ZERO {
      run Bytes.append(&mut message, b",")
    }
    let code = Shared<Gap>.with<GapCode>(
      &gaps[at],
      |gap: &Gap| -> GapCode {
        return gap.code
      },
    )
    let span = Shared<Gap>.with<Span>(
      &gaps[at],
      |gap: &Gap| -> Span {
        return Gap.span(gap)
      },
    )
    let owner = Shared<Gap>.with<Interned<DeclarationId>>(
      &gaps[at],
      |gap: &Gap| -> Interned<DeclarationId> {
        return Interned<DeclarationId>.clone(&gap.owner)
      },
    )
    let key = run InstanceKey.named(&owner)
    let symbol = run InstanceKey.runtimeName(&key)
    run Bytes.append(&mut message, b"{\"code\":\"")
    run Bytes.append(&mut message, Gap.name(code))
    run Bytes.append(&mut message, b"\",\"reason\":\"")
    let original = Shared<Gap>.with<Option<RejectionCode>>(&gaps[at], originalGapReason)
    match move original {
      Option<RejectionCode>.Some { value: reason } => {
        run Bytes.append(&mut message, refusalReason(Rejections.internal(reason)))
        run Bytes.append(&mut message, Rejection.name(reason))
      }
      Option<RejectionCode>.None => {
        run Bytes.append(&mut message, refusalReason(Gap.internal(code)))
        run Bytes.append(&mut message, Gap.name(code))
      }
    }
    run Bytes.append(&mut message, b"; reached in ")
    run Bytes.append(&mut message, Bytes.asSlice(&symbol))
    run Bytes.append(&mut message, b" at bytes ")
    run JsonText.appendDecimal(&mut message, span.start)
    run Bytes.append(&mut message, b"-")
    run JsonText.appendDecimal(&mut message, span.end)
    let gap = Shared<Gap>.with<Gap>(
      &gaps[at],
      |value: &Gap| -> Gap {
        return Gap.copy(value)
      },
    )
    let sourcePath = run Gap.sourcePath(&gap)
    run Bytes.append(&mut message, b"\",\"source\":{\"module\":")
    run JsonText.appendString(&mut message, Bytes.asSlice(&sourcePath))
    run Bytes.append(&mut message, b",\"span\":{\"start\":")
    run JsonText.appendDecimal(&mut message, span.start)
    run Bytes.append(&mut message, b",\"end\":")
    run JsonText.appendDecimal(&mut message, span.end)
    run Bytes.append(&mut message, b"}}}")
    at = at + usize.ONE
  }
  run Bytes.append(&mut message, b"]}\n")
  return move message
}

// The machine-readable reason text of a refusal, before its name: an internal compiler error or a
// construct this compiler does not support yet.
fn refusalReason(internal: bool) -> &'static [u8] {
  if internal {
    return b"Internal compiler error: "
  }
  return b"Not supported by this compiler yet: "
}

// Whether `warning` names a binding inside the span of one of the errors `refused`, such as an
// import that does not resolve, which reports its error rather than that nothing uses it.
fn refusedAt(warning: &Shared<Rejection>, refused: &[Shared<Rejection>]) -> bool {
  let site = Shared<Rejection>.with<Span>(
    warning,
    |value: &Rejection| -> Span {
      return value.span
    },
  )
  let mut at = usize.ZERO
  while at < refused.length {
    let inside = Shared<Rejection>.with<bool>(
      &refused[at],
      |value: &Rejection| -> bool {
        return value.span.start <= site.start && site.end <= value.span.end
          && Shared<Rejection>.with<bool>(
            warning,
            |other: &Rejection| -> bool {
              return ModuleId.equals(&other.module, &value.module)
            },
          )
      },
    )
    if inside {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Whether `modules` lists `module`.
fn listedModule(modules: &[ModuleId], module: &ModuleId) -> bool {
  let mut at = usize.ZERO
  while at < modules.length {
    if ModuleId.equals(&modules[at], module) { return true }
    at = at + usize.ONE
  }
  return false
}

// The unused locals and imports (SEM0255, MOD0007) of the root package and of the dependencies
// read by a `path` from the author's own tree, without an import that can serve calls that never
// spell it, such as an interface whose operations method syntax finds. A git or archive
// dependency's warnings are its author's to fix.
effect fn unusedReported(store: &mut Semantic, sources: &ModuleSources, rootPackage: &[ModuleId]) -> List<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator | &mut Types {
  let mut modules = List<ModuleId>.make()
  let mut root = usize.ZERO
  while root < rootPackage.length {
    run List<ModuleId>.append(&mut modules, ModuleId.copy(&rootPackage[root]))
    root = root + usize.ONE
  }
  let mut local = run ModuleSourceFiles.loadedLocalDependencyModules(sources)
  while List<ModuleId>.length(&local) > usize.ZERO {
    let module = List<ModuleId>.remove(&mut local, usize.ZERO)
    if !listedModule(List<ModuleId>.asSlice(&modules), &module) { run List<ModuleId>.append(&mut modules, move module) }
  }
  let found = run ModuleSourceFiles.unusedWarnings(sources, List<ModuleId>.asSlice(&modules))
  let listed = List<Shared<Rejection>>.asSlice(&found)
  let mut reported = List<Shared<Rejection>>.make()
  let mut dependencies = List<SemanticDependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  let mut at = usize.ZERO
  while at < listed.length {
    let code = Shared<Rejection>.with<RejectionCode>(
      &listed[at],
      |value: &Rejection| -> RejectionCode {
        return value.code
      },
    )
    let mut kept = true
    if code == RejectionCode.UnusedImport {
      let module = Shared<Rejection>.with<ModuleId>(
        &listed[at],
        |value: &Rejection| -> ModuleId {
          return ModuleId.copy(&value.module)
        },
      )
      let span = Shared<Rejection>.with<Span>(
        &listed[at],
        |value: &Rejection| -> Span {
          return value.span
        },
      )
      if let Option<Bytes>.Some { value: text } = move run moduleSource(sources, &module) {
        if span.start <= span.end && span.end <= Bytes.length(&text) {
          let name = Slice.view<u8>(Bytes.asSlice(&text), span.start, span.end - span.start)
          kept = !run StaticPort.importServesCalls(&mut port, &module, name)
        }
      }
    }
    if kept {
      run List<Shared<Rejection>>.append(&mut reported, Shared<Rejection>.clone(&listed[at]))
    }
    at = at + usize.ONE
  }
  return move reported
}

// The line after the warnings that failed a command, naming the option that allows them.
fn warningsRefused() -> &'static [u8] {
  return b"silk: warnings fail this command; fix them, or pass --ignore-warnings to allow them\n"
}

// The exit status a diagnostic sets: 1 for an error, 2 for a compiler refusal, which has no
// catalog code, and 0 for a warning.
fn diagnosticStatus(diagnostic: &Shared<Rejection>) -> i32 {
  let code = Shared<Rejection>.with<RejectionCode>(
    diagnostic,
    |value: &Rejection| -> RejectionCode {
      return value.code
    },
  )
  return match Rejections.catalogCode(code) {
    Option<Code>.Some { value } => match Catalog.severity(value) {
      Severity.Error => 1
      Severity.Warning => 0
    }
    Option<Code>.None => 2
  }
}

effect fn rejectionSummary(diagnostic: &Shared<Rejection>) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let code = Shared<Rejection>.with<RejectionCode>(
    diagnostic,
    |rejection: &Rejection| -> RejectionCode {
      return rejection.code
    },
  )
  let span = Shared<Rejection>.with<Span>(
    diagnostic,
    |rejection: &Rejection| -> Span {
      return rejection.span
    },
  )
  let catalogCode = Rejections.stableCode(code)
  if catalogCode.length == usize.ZERO {
    let module = Shared<Rejection>.with<ModuleId>(
      diagnostic,
      |value: &Rejection| -> ModuleId {
        return ModuleId.copy(&value.module)
      },
    )
    let path = run ModuleId.copyPath(&module)
    let mut refusal = run Bytes.copy(b"SILK_UNSUPPORTED_JSON={\"gaps\":[{\"code\":")
    run JsonText.appendString(&mut refusal, Rejection.name(code))
    run Bytes.append(&mut refusal, b",\"reason\":\"")
    run Bytes.append(&mut refusal, refusalReason(Rejections.internal(code)))
    run Bytes.append(&mut refusal, Rejection.name(code))
    run Bytes.append(&mut refusal, b"\",\"source\":{\"module\":")
    run JsonText.appendString(&mut refusal, Bytes.asSlice(&path))
    run Bytes.append(&mut refusal, b",\"span\":{\"start\":")
    run JsonText.appendDecimal(&mut refusal, span.start)
    run Bytes.append(&mut refusal, b",\"end\":")
    run JsonText.appendDecimal(&mut refusal, span.end)
    run Bytes.append(&mut refusal, b"}}}]}\n")
    return move refusal
  }
  let mut message = run Bytes.copy(b"SILK_BUILD_ERROR={\"code\":\"")
  run Bytes.append(&mut message, catalogCode)
  run Bytes.append(&mut message, b"\",\"span\":{\"start\":")
  run JsonText.appendDecimal(&mut message, span.start)
  run Bytes.append(&mut message, b",\"end\":")
  run JsonText.appendDecimal(&mut message, span.end)

  // The rejected source's logical module, which may be an imported or standard-library module.
  let module = Shared<Rejection>.with<ModuleId>(
    diagnostic,
    |rejection: &Rejection| -> ModuleId {
      return ModuleId.copy(&rejection.module)
    },
  )
  let path = run ModuleId.copyPath(&module)
  run Bytes.append(&mut message, b"},\"module\":")
  run JsonText.appendString(&mut message, Bytes.asSlice(&path))
  run Bytes.append(&mut message, b"}\n")
  return move message
}

effect fn writeOutput(bytes: &[u8]) -> ()
  ! WriterError {
  let mut stdout = StdoutWriter.make()
  return run Writer.writeAll(bytes) |> Effect.provideMut<Writer>(&mut stdout)
}

// Writes each format outcome's line: unchanged and formatted files on standard output, and drift,
// damage and failures on standard error, as the TypeScript CLI writes them.
effect fn reportFormat(outcomes: &[FileOutcome]) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Allocator {
  let mut at = usize.ZERO
  while at < outcomes.length {
    let text = run FormatCommand.line(&outcomes[at])
    if FormatCommand.toStandardOutput(&outcomes[at]) {
      run writeOutput(Bytes.asSlice(&text))
    } else {
      run writeError(Bytes.asSlice(&text))
    }
    at = at + usize.ONE
  }
  return ()
}

// A path relative to `display` when it lies under it, else the absolute path, never `../` steps.
effect fn shownPath(display: &Path, path: &Path) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let relative = run CommandPath.relative(display, path)
  let spelled = Bytes.asSlice(&relative)
  let outside = spelled.length >= 2 && spelled[0] == 46 && spelled[1] == 46
    && (spelled.length == 2 || spelled[2] == 47)
  if outside || spelled.length == usize.ZERO {
    return run Bytes.copy(Path.rawBytes(path))
  }
  return move relative
}

// Writes the TypeScript CLI's line for one compiled artifact on standard output:
// `Compiled <source> -> <output> (<backend>, <target>, <n> symbols)`, with both paths relative to
// `display` when they lie under it and absolute otherwise.
effect fn reportCompiled(
  display: &Path,
  source: &Path,
  output: &Path,
  target: &Target,
  symbols: usize,
  backend: &[u8],
) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Allocator {
  let mut line = run Bytes.copy(b"Compiled ")
  let from = run shownPath(display, source)
  run Bytes.append(&mut line, Bytes.asSlice(&from))
  run Bytes.append(&mut line, b" -> ")
  let to = run shownPath(display, output)
  run Bytes.append(&mut line, Bytes.asSlice(&to))
  run Bytes.append(&mut line, b" (")
  run Bytes.append(&mut line, backend)
  run Bytes.append(&mut line, b", ")
  run Bytes.append(&mut line, Target.name(target))
  run Bytes.append(&mut line, b", ")
  run JsonText.appendDecimal(&mut line, symbols)
  run Bytes.append(&mut line, b" symbols)\n")
  run writeOutput(Bytes.asSlice(&line))
}

// Writes a refused platform supply as the TypeScript CLI does: `<code>: <subject> (<origin>)`, the
// correction, and any tool output.
effect fn reportSupply(refused: &SupplyError) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Allocator {
  let mut text = run Bytes.copy(refused.code)
  run Bytes.append(&mut text, b": ")
  run Bytes.append(&mut text, Bytes.asSlice(&refused.subject))
  run Bytes.append(&mut text, b" (")
  run Bytes.append(&mut text, Bytes.asSlice(&refused.origin))
  run Bytes.append(&mut text, b")\n")
  run Bytes.append(&mut text, Bytes.asSlice(&refused.correction))
  run Bytes.append(&mut text, b"\n")
  if Bytes.length(&refused.detail) > usize.ZERO {
    run Bytes.append(&mut text, Bytes.asSlice(&refused.detail))
    run Bytes.append(&mut text, b"\n")
  }
  run writeError(Bytes.asSlice(&text))
}

effect fn writeError(bytes: &[u8]) -> ()
  ! WriterError {
  let mut stderr = StderrWriter.make()
  return run Writer.writeAll(bytes) |> Effect.provideMut<Writer>(&mut stderr)
}

/// Compiles the completed LLVM text into `form` at `stage` and writes it to `output`.
///
/// An executable's final stage links the declared inputs and the C libraries for the host. Every
/// other form or stage is compiled for its target with the profile's relocation model and needs no
/// linker. An object's final stage merges declared objects and archives by a relocatable link; a
/// static library's final stage archives its compiled object beside the declared objects. Each
/// refuses any other declared input; an intermediate stage takes no declared inputs.
///
/// Two commands that build one package at once write the same `output`, so each makes its files in a
/// new directory of its own beside it, renames the finished output over `output`, and removes the
/// directory.
///
/// With `printed`, a `wasm-text` build, the linked core module's text (`WasmText.print`) is
/// written in place of the module, and a wasip2 build makes no component.
effect fn compileIr(
  ir: &Bytes,
  debugInfo: &[u8],
  unitLines: Option<&EmissionPlan>,
  sources: &ModuleSources,
  functionNames: &FunctionNames,
  units: &[CodegenUnit],
  packs: &[BuildRecord.PackBody],
  output: &Path,
  form: Form,
  stage: Stage,
  optimization: &[u8],
  debug: bool,
  relocation: &[u8],
  libc: &[u8],
  profileFlags: &[Bytes],
  target: &Target,
  supply: &Option<Supply>,
  linkInputs: &[NativeLinkInput],
  functionOrder: Option<&Path>,
  symbolMap: &[u8],
  selectedClang: &Option<Bytes>,
  world: &WasiTools.World,
  started: bool,
  printed: bool,
  explicit: Option<&CompilationRequest>,
  progress: &mut Progress,
) -> i32
  ! FileError
    | ProcessError
    | HostInputError
    | InvalidNativeLinkInput
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let parent = match move run Path.parent(output) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Path.fromBytes(Path.rawBytes(output))
  }

  // The caches beside `output` (its codegen units' objects, its native sources' objects and its
  // link stamp) are pruned and replaced by each build, so the commands take turns on the lock
  // file beside it: a build that waited finds the output the other one linked.
  let mut lockName = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut lockName, b".lock")
  let lock = run Path.fromBytes(Bytes.asSlice(&lockName))
  let held = run DetachedWriter.hold(&lock)
  let scratch = run FileSystem.createTemporaryDirectory(&parent, b".silk-")
  let use = effect |resource: &mut Path| -> i32
    ! FileError
      | ProcessError
      | HostInputError
      | InvalidNativeLinkInput
      | OutOfMemoryError
      | WriterError
    ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
    return run compileIrIn(
      &resource.*,
      ir,
      debugInfo,
      unitLines,
      sources,
      functionNames,
      units,
      packs,
      output,
      form,
      stage,
      optimization,
      debug,
      relocation,
      libc,
      profileFlags,
      target,
      supply,
      linkInputs,
      functionOrder,
      symbolMap,
      selectedClang,
      world,
      started,
      printed,
      explicit,
      &mut progress.*,
    )
  }
  let release = effect |resource: &mut Path| -> ()
    ? &mut FileSystem | &mut Allocator {
    let removed = run Effect.result(FileSystem.removeDirectoryRecursively(&resource.*))
    drop removed
    return ()
  }
  let status = run Effect.useReleaseNonParking(move scratch, move use, move release)
  drop held
  return status
}

// The line tables of `module`, as `DebugInfo.encode` writes them: a subprogram for each function
// whose location markers name lines (`MirFunction.lines`), at the first of them, in its
// declaration's module, which is one source file. The markers count lines from the declaration's
// first token, and the plan says where that token is now (`EmissionPlan.identityOrigin`).
effect fn debugInfoOf(
  plan: &EmissionPlan,
  sources: &ModuleSources,
  module: &BitcodeModule,
  optimized: bool,
) -> Bytes
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let marked = run BitcodeModule.markedFunctions(module)
  let mut modules = List<ModuleId>.make()
  let mut files = List<Bytes>.make()
  let mut functions = List<DebugFunction>.make()
  let listed = List<MarkedFunction>.asSlice(&marked)
  let mut at = usize.ZERO
  while at < listed.length {
    let identity = EmissionPlan.identityOfSymbol(plan, Bytes.asSlice(&listed[at].symbol))
    if identity != usize.MAX {
      let declaration = EmissionPlan.identityDeclaration(plan, identity)
      let owner = DeclarationId.moduleId(declaration)
      let known = List<ModuleId>.asSlice(&modules)
      let mut file = usize.ZERO
      while file < known.length && !ModuleId.equals(&known[file], owner) {
        file = file + usize.ONE
      }
      if file == known.length {
        let location = run ModuleSourceFiles.sourceLocation(sources, owner)
        let mut path = Bytes.make()
        if let Option<Path>.Some { value: found } = &location.path {
          path = run Bytes.copy(Path.rawBytes(&found))
        }
        run List<ModuleId>.append(&mut modules, ModuleId.copy(owner))
        run List<Bytes>.append(&mut files, move path)
      }
      let origin = EmissionPlan.identityOrigin(plan, identity)
      run List<DebugFunction>.append(
        &mut functions,
        DebugFunction {
          symbol: run Bytes.copy(Bytes.asSlice(&listed[at].symbol)),
          name: run MirNames.declarationName(declaration),
          file: file,
          line: u64.shiftRight(absolutePlace(origin, u64.shiftLeft(listed[at].line, 24)), 24),
          origin: origin,
        },
      )
    }
    at = at + usize.ONE
  }

  // A function's site labels are counted from the same token (`Bitcode.siteName`).
  let mut sites = List<SiteOrigin>.make()
  let named = run BitcodeModule.siteSymbols(module)
  let symbols = List<Bytes>.asSlice(&named)
  at = usize.ZERO
  while at < symbols.length {
    let identity = EmissionPlan.identityOfSymbol(plan, Bytes.asSlice(&symbols[at]))
    if identity != usize.MAX {
      run List<SiteOrigin>.append(
        &mut sites,
        SiteOrigin {
          symbol: run Bytes.copy(Bytes.asSlice(&symbols[at])),
          origin: EmissionPlan.identityOrigin(plan, identity),
        },
      )
    }
    at = at + usize.ONE
  }
  let info = DebugInfo {
    producer: run Bytes.copy(b"silk"),
    directory: Bytes.make(),
    optimized: optimized,
    files: move files,
    functions: move functions,
    sites: move sites,
  }
  return run DebugInfo.encode(&info)
}

// The source name of each emitted function, as a trap report names its frames: `main.pick`, or
// `main.Buffer.drop` for the drop glue of `main.Buffer`. A helper an instance needs is named after
// its declaration.
effect fn readableNames(plan: &EmissionPlan) -> FunctionNames
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut names = FunctionNames.make()
  let count = EmissionPlan.symbolCount(plan)
  let mut at = usize.ZERO
  while at < count {
    let mut name = run MirNames.declarationName(EmissionPlan.identityDeclaration(plan, at))
    if same(EmissionPlan.identityFamily(plan, at), b"drop") {
      run Bytes.append(&mut name, b".drop")
    }
    run FunctionNames.add(&mut names, EmissionPlan.identitySymbol(plan, at), Bytes.asSlice(&name))
    at = at + usize.ONE
  }
  return move names
}

// Compiles as `compileIr` does, with the intermediate files in `scratch` under the output's name,
// which Clang records in the object.
// Optimize defining-package units before merging them. The final conversion disables LLVM
// passes, preserving each unit's chosen pipeline and its function-level codegen attributes.
effect fn compileIntermediateUnits(
  scratch: &Path,
  clang: &Path,
  units: &[CodegenUnit],
  packs: &[BuildRecord.PackBody],
  lines: Option<&EmissionPlan>,
  sources: &ModuleSources,
  flags: &[Bytes],
  target: &Target,
  stage: Stage,
  staged: &Path,
  output: &Path,
  progress: &mut Progress,
) -> i32
  ! FileError | ProcessError | HostInputError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let linker = run NativeToolchain.companion(clang, "llvm-link")
  let mut merge = run NativeToolchain.request(&linker)
  let merged = if stage == Stage.LlvmBitcode {
    run Path.fromBytes(Path.rawBytes(staged))
  } else {
    run Path.join(scratch, "merged.bc")
  }
  run ChildProcess.addArgument(&mut merge, "-o")
  run NativeToolchain.addPathArgument(&mut merge, &merged)
  let mut at: usize = 0
  while at < units.length {
    let unit = &units[at]
    let mut name = Bytes.make()
    run appendDecimal(&mut name, at)
    run name.append(b".bc")
    let input = run Path.joinBytes(scratch, name.asSlice())
    run name.append(b".optimized.bc")
    let optimized = run Path.joinBytes(scratch, name.asSlice())
    let mut fragments = run Bytes.copy(unit.head.asSlice())
    run fragments.append(unitBody(unit, packs))
    let debug = run unitDebugInfo(lines, sources, fragments.asSlice(), unit)
    let bytes = if debug.length() > 0 {
      run Bitcode.compileDebug(fragments.asSlice(), debug.asSlice())
    } else {
      run Bitcode.compile(fragments.asSlice())
    }
    run FileSystem.writeFile(&input, bytes.asSlice())
    let mut compile = run NativeToolchain.request(clang)
    run ChildProcess.addArgument(&mut compile, "-c")
    run ChildProcess.addArgument(&mut compile, "-emit-llvm")
    run ChildProcess.addArgument(&mut compile, "-Wno-unused-command-line-argument")
    let mut triple = run Bytes.copy(b"--target=")
    run triple.append(Target.llvmTriple(target))
    run ChildProcess.addArgumentBytes(&mut compile, triple.asSlice())
    let selected = run PackageCodegen.flags(
      flags,
      unit,
      same(Target.objectFormat(target), b"wasm"),
      same(Target.architecture(target), b"x86_64"),
    )
    let listed = selected.asSlice()
    let mut flag: usize = 0
    while flag < listed.length {
      run ChildProcess.addArgumentBytes(&mut compile, listed[flag].asSlice())
      flag = flag + 1
    }
    run ChildProcess.addArgument(&mut compile, "-x")
    run ChildProcess.addArgument(&mut compile, "ir")
    run NativeToolchain.addPathArgument(&mut compile, &input)
    run ChildProcess.addArgument(&mut compile, "-o")
    run NativeToolchain.addPathArgument(&mut compile, &optimized)
    let status = run submitted(&compile, &mut progress.*)
    if status != 0 {
      return status
    }
    run NativeToolchain.addPathArgument(&mut merge, &optimized)
    at = at + 1
  }
  let mergedStatus = run submitted(&merge, &mut progress.*)
  if mergedStatus != 0 {
    return mergedStatus
  }
  if stage != Stage.LlvmBitcode {
    let mut convert = run NativeToolchain.request(clang)
    run ChildProcess.addArgument(
      &mut convert,
      if stage == Stage.Object {
        "-c"
      } else {
        "-S"
      },
    )
    if stage == Stage.LlvmIr {
      run ChildProcess.addArgument(&mut convert, "-emit-llvm")
    }
    let mut triple = run Bytes.copy(b"--target=")
    run triple.append(Target.llvmTriple(target))
    run ChildProcess.addArgumentBytes(&mut convert, triple.asSlice())
    let mut flag: usize = 0
    while flag < flags.length {
      run ChildProcess.addArgumentBytes(&mut convert, flags[flag].asSlice())
      flag = flag + 1
    }
    run ChildProcess.addArgument(&mut convert, "-Xclang")
    run ChildProcess.addArgument(&mut convert, "-disable-llvm-passes")
    run NativeToolchain.addPathArgument(&mut convert, &merged)
    run ChildProcess.addArgument(&mut convert, "-o")
    run NativeToolchain.addPathArgument(&mut convert, staged)
    let status = run submitted(&convert, &mut progress.*)
    if status != 0 {
      return status
    }
  }
  if !run HostRename.replaceFile(staged, output) {
    run writeError(b"silk: cannot publish the intermediate output\n")
    return 2
  }
  return 0
}

effect fn compileIrIn(
  scratch: &Path,
  ir: &Bytes,
  debugInfo: &[u8],
  unitLines: Option<&EmissionPlan>,
  sources: &ModuleSources,
  functionNames: &FunctionNames,
  requestedUnits: &[CodegenUnit],
  packs: &[BuildRecord.PackBody],
  output: &Path,
  form: Form,
  stage: Stage,
  optimization: &[u8],
  debug: bool,
  relocation: &[u8],
  libc: &[u8],
  profileFlags: &[Bytes],
  target: &Target,
  supply: &Option<Supply>,
  linkInputs: &[NativeLinkInput],
  functionOrder: Option<&Path>,
  symbolMap: &[u8],
  selectedClang: &Option<Bytes>,
  world: &WasiTools.World,
  started: bool,
  printed: bool,
  explicit: Option<&CompilationRequest>,
  progress: &mut Progress,
) -> i32
  ! FileError
    | ProcessError
    | HostInputError
    | InvalidNativeLinkInput
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let outputName = Path.rawBytes(output)
  let mut nameStart = outputName.length
  while nameStart > usize.ZERO && outputName[nameStart - usize.ONE] != 47 {
    nameStart = nameStart - usize.ONE
  }

  // The output itself is made here too, then renamed over `output`.
  let mut stem = run Bytes.copy(Path.rawBytes(scratch))
  run Bytes.append(&mut stem, b"/")
  run Bytes.append(&mut stem, Slice.view<u8>(outputName, nameStart, outputName.length - nameStart))
  let staged = run Path.fromBytes(Bytes.asSlice(&stem))
  let mut intermediate = run Bytes.copy(Bytes.asSlice(&stem))
  run Bytes.append(&mut intermediate, b".silk.bc")
  let irPath = run Path.fromBytes(Bytes.asSlice(&intermediate))

  // A static library's single compiled member is written beside the IR, then removed.
  let mut memberBytes = run Bytes.copy(Bytes.asSlice(&stem))
  run Bytes.append(&mut memberBytes, b".silk.o")
  let member = run Path.fromBytes(Bytes.asSlice(&memberBytes))
  let mut named = Option<&[u8]>.none()
  if let Option<Bytes>.Some { value } = &selectedClang.* {
    named = Option<&[u8]>.some(Bytes.asSlice(&value))
  }
  let clang = match move run NativeToolchain.compiler(move named) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      run Progress.clear(&mut progress.*)
      if let Option<Bytes>.Some { value: missing } = &selectedClang.* {
        run writeError(b"silk: cannot find ")
        run writeError(Bytes.asSlice(&missing))
        run writeError(b" on PATH; pass --clang the path of the Clang executable\n")
      } else {
        run writeError(
          b"silk: cannot find clang on PATH; set SILK_CLANG or pass --clang the path of the Clang executable\n",
        )
      }
      return 2
    }
  }

  // Where `clang` came from, so a failure to start it names its source.
  let mut origin: &[u8] = b"from --clang"
  if let Option<Bytes>.None = &selectedClang.* {
    origin = b"found on PATH"
    if bundledClang(Path.rawBytes(&clang)) {
      origin = b"bundled with Silk"
    }
    if let Option<Bytes>.Some { .. } = move run HostInput.variableNamed("SILK_CLANG") {
      origin = b"from SILK_CLANG"
    }
  }
  if stage != Stage.Final && PackageCodegen.configured(requestedUnits) {
    return run compileIntermediateUnits(
      scratch,
      &clang,
      requestedUnits,
      packs,
      unitLines,
      sources,
      profileFlags,
      target,
      stage,
      &staged,
      output,
      &mut progress.*,
    )
  }
  let mut process = run NativeToolchain.request(&clang)
  let final = stage == Stage.Final
  let library = form == Form.SharedLibrary
  let linked = final && (form == Form.Executable || library)
  let windows = linked && same(Target.operatingSystem(target), b"windows")
  if windows {
    run WindowsLink.configure(&mut process, &clang, library)
  }

  // A dynamically linked glibc executable that declares no link inputs and names no platform
  // supply links against Silk's glibc 2.28 stubs and startup code (`LinuxLink`) on any host, with
  // no sysroot, GCC installation or libgcc. Its link inputs, or a static glibc link, need the
  // target's own libraries: the host's own on a native link, or an explicit supply's sysroot.
  let linux = linked && same(Target.operatingSystem(target), b"linux")
  let mut explicitSupply = false
  if let Option<Supply>.Some { .. } = &supply.* {
    explicitSupply = true
  }
  let mut staticLink = false
  let mut scanned = usize.ZERO
  while scanned < profileFlags.length {
    if same(Bytes.asSlice(&profileFlags[scanned]), b"-static") {
      staticLink = true
    }
    scanned = scanned + usize.ONE
  }
  let minimumClang = clangMinimum(profileFlags)
  let glibcStubbed = linux && !library && !explicitSupply && same(libc, b"gnu") && !staticLink
    && linkInputs.length == usize.ZERO
  let crossTarget = Target.id(target) != Target.id(&hostTarget())
  if linux && !explicitSupply && !glibcStubbed && crossTarget {
    run Progress.clear(&mut progress.*)
    run writeError(b"silk: cannot link an executable for ")
    run writeError(Target.name(target))
    run writeError(b" without a sysroot: ")
    if linkInputs.length > usize.ZERO {
      run writeError(b"its declared link inputs need the target's libraries")
    } else if staticLink {
      run writeError(b"a static glibc link needs the target's static libraries")
    } else {
      run writeError(b"only libc = \"gnu\" links without one")
    }
    run writeError(b".\nDeclare Compilation.platform with target = \"")
    run writeError(Target.name(target))
    run writeError(b"\", root = \"<sysroot>\", linker = \"<ld.lld>\" }\n")
    return 2
  }
  let merged = final
    && ((form == Form.Object
      && (linkInputs.length > usize.ZERO || requestedUnits.length > usize.ZERO))
      || (form == Form.StaticLibrary && requestedUnits.length > usize.ZERO))
  let archive = final && form == Form.StaticLibrary

  // A wasm32 executable links freestanding: no libc and no entry. The stdlib's wasm support
  // modules define what a C runtime would.
  let freestanding = linked && same(Target.objectFormat(target), b"wasm")
  let mut componentBytes = run Bytes.copy(Bytes.asSlice(&stem))
  run Bytes.append(&mut componentBytes, b".component.wasm")
  let componentPath = run Path.fromBytes(Bytes.asSlice(&componentBytes))
  if freestanding {
    run ChildProcess.addArgument(&mut process, "-nostdlib")
    run ChildProcess.addArgument(&mut process, "-Wl,--no-entry")

    // The backend's `main` wrapper carries no export attribute; see LlvmCode's export names.
    if same(Target.operatingSystem(target), b"wasi") {
      if started {
        run ChildProcess.addArgument(&mut process, "-Wl,--export=_start")
      }
    } else {
      let mut command = true
      if let Option<&CompilationRequest>.Some { value } = explicit {
        if let Option<RequestWasm>.Some { value: wasm } = &value.wasm {
          command = wasm.executionModel.view() == "command"
        }
      }
      if command {
        run ChildProcess.addArgument(&mut process, "-Wl,--export=main")
      }
    }

    // Without debug information, a module carries nothing a person reads in its `name` section,
    // whose symbols are content-derived, and the linker may write each code relocation at its
    // shortest LEB128 instead of the padded five bytes. The site module of a UI library shrank by
    // 6% and 10% gzipped.
    if !debug {
      run ChildProcess.addArgument(&mut process, "-Wl,--strip-all")
      run ChildProcess.addArgument(&mut process, "-Wl,--compress-relocations")
    }
  }
  if !linked {
    // The IR names no triple, so a cross-target output states its target to Clang.
    let mut selected = run Bytes.copy(b"--target=")
    run Bytes.append(&mut selected, Target.llvmTriple(target))
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&selected))
    if merged {
      run ChildProcess.addArgument(&mut process, "-r")
      run ChildProcess.addArgument(&mut process, "-nostdlib")
    } else if stage == Stage.Assembly {
      run ChildProcess.addArgument(&mut process, "-S")
    } else {
      run ChildProcess.addArgument(&mut process, "-c")
      if stage == Stage.LlvmBitcode {
        run ChildProcess.addArgument(&mut process, "-emit-llvm")
      }
    }

    // COFF x64 uses image-relative relocations; Clang rejects the ELF PIC switch.
    if !same(Target.operatingSystem(target), b"windows") {
      if same(relocation, b"pic") {
        run ChildProcess.addArgument(&mut process, "-fPIC")
      } else {
        run ChildProcess.addArgument(&mut process, "-fno-pic")
      }
    }
  }

  // A Linux or macOS executable places the functions its package's `[native].function-order`
  // lists first, in that order, so code that runs together shares pages. A wasm32 module has no
  // pages to share and ignores it.
  let darwin = same(Target.objectFormat(target), b"macho")
  if linked && library && !freestanding {
    run ChildProcess.addArgument(
      &mut process,
      if darwin {
        "-dynamiclib"
      } else {
        "-shared"
      },
    )
  }
  if linked {
    if let Option<&CompilationRequest>.Some { value: request } = explicit {
      let configured = run CompilationPlatform.link(&mut process, &clang, scratch, request, library)
      if configured != 0 {
        return configured
      }
    }
  }
  let mut ordering = Option<Bytes>.none()
  if linked && !freestanding && !windows {
    if let Option<&Path>.Some { value: listed } = &functionOrder {
      match move run Effect.result(FileSystem.readFile(listed)) {
        Result<Bytes, FileError | OutOfMemoryError>.Success { value: written } => {
          // A file that lists no symbol orders nothing, so it changes neither the code nor the link.
          let resolved = run FunctionOrder.resolve(Bytes.asSlice(&written), symbolMap, darwin)
          // Entries that name nothing this build emits order nothing; many of them mean the file
          // is stale, which a link alone would not show.
          if resolved.unmatched > usize.ZERO {
            run Progress.clear(&mut progress.*)
            let mut note = run Bytes.copy(b"silk: note: ")
            run appendDecimal(&mut note, resolved.unmatched)
            run Bytes.append(&mut note, b" of ")
            run appendDecimal(&mut note, resolved.entries)
            run Bytes.append(&mut note, b" entries in ")
            run Bytes.append(&mut note, Path.rawBytes(listed))
            run Bytes.append(&mut note, b" name no function of this build; list declarations as the third column of the .symbols file spells them, such as `app:src/main.silk::main`, to keep the order across compiler and dependency changes\n")
            run writeError(Bytes.asSlice(&note))
          }
          if Bytes.length(&resolved.order) > usize.ZERO { ordering = Option<Bytes>.some(move resolved.order) }
        }
        Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
          FileError failure => {
            drop failure
            run Progress.clear(&mut progress.*)
            run writeError(b"silk: cannot read the function order file ")
            run writeError(Path.rawBytes(listed))
            run writeError(b" that [native].function-order names\n")
            return 2
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
  }
  let ordered = match &ordering {
    Option<Bytes>.Some { .. } => true
    Option<Bytes>.None => false
  }
  let mut orderBytes = run Bytes.copy(Bytes.asSlice(&stem))
  run Bytes.append(&mut orderBytes, b".order")
  let orderPath = run Path.fromBytes(Bytes.asSlice(&orderBytes))

  // The flags that decide the code Clang writes, which each codegen unit's compile shares.
  let mut common = List<Bytes>.make()

  // The `-mllvm` options among them, which a ThinLTO link passes on to the code generator it runs.
  let mut backendOptions = List<Bytes>.make()

  // Split codegen units are compiled by separate Clang requests before the final link.
  // The IR names no triple, so every link and its units state the target to Clang; a
  // cross link would otherwise build for Clang's default triple.
  if linked || requestedUnits.length > usize.ZERO {
    let mut selected = run Bytes.copy(b"--target=")
    run Bytes.append(&mut selected, Target.llvmTriple(target))
    run List<Bytes>.append(&mut common, move selected)
  }
  if library && !windows {
    run common.append(run Bytes.copy(b"-fPIC"))
  }

  // An ELF linker orders whole sections, so each function gets its own; Mach-O orders symbols.
  if ordered && !darwin {
    run List<Bytes>.append(&mut common, run Bytes.copy(b"-ffunction-sections"))
  }
  run OptimizationFlags.append(
    &mut common,
    &mut backendOptions,
    optimization,
    same(Target.objectFormat(target), b"wasm"),
    same(Target.architecture(target), b"x86_64"),
  )
  if debug {
    run List<Bytes>.append(&mut common, run Bytes.copy(b"-g"))
  }
  let mut flag = usize.ZERO
  while flag < profileFlags.length {
    run List<Bytes>.append(&mut common, run Bytes.copy(Bytes.asSlice(&profileFlags[flag])))
    flag = flag + usize.ONE
  }

  // The profile's features reach Clang as `-Xclang -target-feature -Xclang +name`, which only the
  // units' compiles see, so a ThinLTO link generates code for them too.
  let mut features = Bytes.make()
  flag = usize.ZERO
  while flag + usize.add(0, 2) < profileFlags.length {
    if same(Bytes.asSlice(&profileFlags[flag]), b"-target-feature") {
      if Bytes.length(&features) > usize.ZERO {
        run Bytes.append(&mut features, b",")
      }
      run Bytes.append(&mut features, Bytes.asSlice(&profileFlags[flag + usize.add(0, 2)]))
    }
    flag = flag + usize.ONE
  }

  // Clang passes an ELF link the CPU itself; `ld64.lld` hears of it only as an option.
  if darwin {
    flag = usize.ZERO
    while flag < profileFlags.length {
      let named = Bytes.asSlice(&profileFlags[flag])
      if named.length > usize.add(0, 6) && same(Slice.view<u8>(named, 0, 6), b"-mcpu=") {
        run List<Bytes>.append(&mut backendOptions, run Bytes.copy(named))
      }
      flag = flag + usize.ONE
    }
  }

  // A wasm32 profile's features are Clang options (`wasmProfileFlags`), which the link's code
  // generator hears of the same way.
  if freestanding {
    if hasFlag(profileFlags, b"-mbulk-memory") {
      if Bytes.length(&features) > usize.ZERO {
        run Bytes.append(&mut features, b",")
      }
      run Bytes.append(&mut features, b"+bulk-memory")
    }
    if hasFlag(profileFlags, b"-matomics") {
      if Bytes.length(&features) > usize.ZERO {
        run Bytes.append(&mut features, b",")
      }
      run Bytes.append(&mut features, b"+atomics")
    }
  }
  if Bytes.length(&features) > usize.ZERO {
    let mut attributes = run Bytes.copy(b"-mattr=")
    run Bytes.append(&mut attributes, Bytes.asSlice(&features))
    run List<Bytes>.append(&mut backendOptions, move attributes)
  }

  // Clang calls libgcc's `__aarch64_*` atomics helpers when it finds a GCC installation on the
  // host; a stubbed link has no libgcc, so its atomics are always inline.
  if glibcStubbed && same(Target.architecture(target), b"aarch64") {
    run List<Bytes>.append(&mut common, run Bytes.copy(b"-mno-outline-atomics"))
  }

  // A link uses its resolved supply, never ambient SDK, sysroot or linker settings.
  let mut stubbed = false
  if let Option<Supply>.Some { value: selected } = &supply.* {
    stubbed = selected.stub
    if selected.darwin {
      // Silk's libSystem stub is no SDK, so a stubbed link names no SDK root.
      if !selected.stub {
        run List<Bytes>.append(&mut common, run Bytes.copy(b"-isysroot"))
        run List<Bytes>.append(&mut common, run NativeToolchain.pathBytes(&selected.root))
      }
      let mut minimum = run Bytes.copy(b"-mmacosx-version-min=")
      run Bytes.append(&mut minimum, Bytes.asSlice(&selected.deployment))
      run List<Bytes>.append(&mut common, move minimum)
    } else {
      let mut sysroot = run Bytes.copy(b"--sysroot=")
      let hostRoot = run NativeToolchain.pathBytes(&selected.root)
      run Bytes.append(&mut sysroot, Bytes.asSlice(&hostRoot))
      run List<Bytes>.append(&mut common, move sysroot)
    }
    if let Option<Path>.Some { value: installation } = &selected.support {
      let mut gcc = run Bytes.copy(b"--gcc-install-dir=")
      let hostInstallation = run NativeToolchain.pathBytes(&installation)
      run Bytes.append(&mut gcc, Bytes.asSlice(&hostInstallation))
      run List<Bytes>.append(&mut common, move gcc)
    }
    if let Option<Path>.Some { value: tool } = &selected.linker {
      let mut ldPath = run Bytes.copy(b"--ld-path=")
      let hostLinker = run NativeToolchain.pathBytes(&tool)
      run Bytes.append(&mut ldPath, Bytes.asSlice(&hostLinker))
      run List<Bytes>.append(&mut common, move ldPath)
    }
  }
  let shared = List<Bytes>.asSlice(&common)
  flag = usize.ZERO
  while flag < shared.length {
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&shared[flag]))
    flag = flag + usize.ONE
  }

  // A Linux executable links with the lld installed beside Clang when there is one: it links the
  // compiler in a third of the time the system linker takes. A macOS executable for another
  // architecture or host, or against Silk's libSystem stub, links with `ld64.lld`, which needs no
  // Apple toolchain; a native one with an SDK keeps Apple's `ld` for now. A supply's own linker
  // wins over both.
  let mut supplied = false
  if let Option<Supply>.Some { value: selected } = &supply.* {
    if let Option<Path>.Some { .. } = &selected.linker {
      supplied = true
    }
  }
  let crossDarwin = darwin && (Target.id(target) != Target.id(&hostTarget()) || stubbed)

  // An optimized executable's codegen units compile for ThinLTO, which lld links: a native macOS
  // one then links with the `ld64.lld` installed beside Clang too. Without lld the whole module
  // compiles as one instead, since units without the link's cross-unit inlining run much slower.
  let thinWanted = requestedUnits.length > usize.ZERO && same(optimization, b"speed") && linked
    && !windows
    && !supplied
    && !PackageCodegen.configured(requestedUnits)
  let lld = linked && !freestanding && !supplied
    && (same(Target.operatingSystem(target), b"linux") || crossDarwin || darwin && thinWanted)
  let mut lldName: &[u8] = b"/ld.lld"
  if darwin {
    lldName = b"/ld64.lld"
  }

  // Clang's version is asked once: it stamps a split build's objects, and it names where Clang is
  // installed.
  let mut probed = Option<Bytes>.none()

  // Native translation units compile only for a final output, which links or archives them.
  let compilesSources = final && NativeLinkInputs.hasSources(linkInputs)

  // The glibc stubs are cached by the Clang that builds them, so a stubbed link asks too.
  if requestedUnits.length > usize.ZERO || lld || compilesSources || glibcStubbed {
    match move run probeClang(&clang, origin, minimumClang, &mut progress.*) {
      ClangVersion.Answered { output: answer } => {
        probed = Option<Bytes>.some(move answer)
      }
      ClangVersion.Failed { status } => {
        return status
      }
    }
  }

  // The options that select the program's linker, with which the glibc stub libraries link too.
  let mut stubLinker = List<Bytes>.make()
  let mut thinLinked = false
  // Whether the link names lld, which alone folds identical functions.
  let mut folding = false
  if lld {
    let mut installed = false
    if let Option<Bytes>.Some { value: answer } = &probed {
      if let Option<Bytes>.Some { value: linker } = move run installedLld(
        Bytes.asSlice(&answer),
        lldName,
      ) {
        let mut ldPath = run Bytes.copy(b"--ld-path=")
        run Bytes.append(&mut ldPath, Bytes.asSlice(&linker))
        run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&ldPath))
        run List<Bytes>.append(&mut stubLinker, move ldPath)
        installed = true
      }
    }

    // The system linker may not order symbols, so an ordered link asks for lld on PATH instead.
    // A cross macOS or Linux link always names lld: Clang passes `ld64.lld` its own flags, and
    // another host's system linker cannot link for Linux.
    if ordered && !installed || crossDarwin || glibcStubbed && crossTarget && !installed {
      run ChildProcess.addArgument(&mut process, "-fuse-ld=lld")
      run List<Bytes>.append(&mut stubLinker, run Bytes.copy(b"-fuse-ld=lld"))
      installed = true
    }
    thinLinked = thinWanted && installed
    folding = installed
  }
  // An optimized Linux link drops the sections nothing reaches, and lld folds functions whose
  // code is identical and whose address nothing compares: a windowed app's host lost 3% of its
  // size. The ThinLTO link gives each function its own section, so the gain is largest there.
  if linux && (same(optimization, b"speed") || same(optimization, b"size")) {
    run ChildProcess.addArgument(&mut process, "-Wl,--gc-sections")
    if folding { run ChildProcess.addArgument(&mut process, "-Wl,--icf=safe") }
  }

  // Clang links a wasm32 module with wasm-ld, which joins ThinLTO units as lld does.
  if thinWanted && freestanding {
    thinLinked = true
  }

  // The glibc stubs and startup code are kept in the codegen cache, named by a digest of the Clang
  // and linker that build them and of their text, so a link rebuilds them only when one changes.
  let mut glibcStubs = run Path.root()
  if glibcStubbed {
    let mut stubIdentity = run Bytes.copy(Path.rawBytes(&clang))
    run Bytes.append(&mut stubIdentity, b"\n")
    if let Option<Bytes>.Some { value: answer } = &probed {
      run Bytes.append(&mut stubIdentity, Bytes.asSlice(&answer))
    }
    let stubCache = run CodegenCache.directoryFor(output)
    glibcStubs = run LinuxLink.stubDirectory(
      &stubCache,
      Bytes.asSlice(&stubIdentity),
      List<Bytes>.asSlice(&stubLinker),
      target,
    )
  }
  let noUnits = List<CodegenUnit>.make()
  let mut units = requestedUnits
  if thinWanted && !thinLinked {
    units = List<CodegenUnit>.asSlice(&noUnits)
    // One module optimizes on one thread: a large program's build goes from a minute or two to
    // several, so say why rather than leave `codegen-units` looking ignored.
    run Progress.clear(&mut progress.*)
    let mut note = run Bytes.copy(b"silk: note: this build is one module, not its profile's codegen units, because there is no ")
    run Bytes.append(&mut note, Slice.view<u8>(lldName, usize.ONE, lldName.length - usize.ONE))
    run Bytes.append(&mut note, b" beside the Clang ")
    run Bytes.append(&mut note, origin)
    run Bytes.append(&mut note, b" (")
    run Bytes.append(&mut note, Path.rawBytes(&clang))
    run Bytes.append(&mut note, b"), so it optimizes on one thread; use a Clang with lld in its directory, or unset SILK_CLANG for the LLVM bundled with Silk\n")
    run writeError(Bytes.asSlice(&note))
  }

  // A ThinLTO link optimizes and generates each unit's code again, on as many threads as the host
  // has, after importing what the unit calls from the others. Its cache keeps each unit's result
  // for the same unit and imports, so an edit regenerates only the units it reaches.
  let mut unitFlags = List<Bytes>.make()
  flag = usize.ZERO
  while flag < shared.length {
    run List<Bytes>.append(&mut unitFlags, run Bytes.copy(Bytes.asSlice(&shared[flag])))
    flag = flag + usize.ONE
  }
  if thinLinked {
    run List<Bytes>.append(&mut unitFlags, run Bytes.copy(b"-flto=thin"))
    run ChildProcess.addArgument(&mut process, "-flto=thin")
    let options = List<Bytes>.asSlice(&backendOptions)
    let mut option = usize.ZERO

    // `-Xlinker` keeps an option whole: `-Wl,` would split `-mattr=+a,+b` at its commas.
    while option < options.length {
      run ChildProcess.addArgument(&mut process, "-Xlinker")
      run ChildProcess.addArgument(&mut process, "-mllvm")
      run ChildProcess.addArgument(&mut process, "-Xlinker")
      run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&options[option]))
      option = option + usize.ONE
    }
    let unitCache = run CodegenCache.directoryFor(output)
    let mut cached = Bytes.make()
    if darwin {
      cached = run Bytes.copy(b"-Wl,-cache_path_lto,")
    } else {
      cached = run Bytes.copy(b"-Wl,--thinlto-cache-dir=")
    }
    let cacheRoot = run NativeToolchain.pathBytes(&unitCache)
    run Bytes.append(&mut cached, Bytes.asSlice(&cacheRoot))
    run Bytes.append(&mut cached, b"/thinlto")
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&cached))

    // A few builds' worth of the units' results; the link removes the oldest past that.
    run ChildProcess.addArgument(&mut process, "-Wl,--thinlto-cache-policy=cache_size_files=64")
  }
  if ordered {
    run ChildProcess.addArgument(&mut process, "-Xlinker")
    if darwin {
      run ChildProcess.addArgument(&mut process, "-order_file")
    } else {
      run ChildProcess.addArgument(&mut process, "--symbol-ordering-file")
    }
    run ChildProcess.addArgument(&mut process, "-Xlinker")
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&orderBytes))
  }

  // A split build links the cached object of each codegen unit instead of compiling the module.
  let mut objects = List<Path>.make()
  if let Option<Bytes>.Some { value: answer } = &probed {
    if units.length > usize.ZERO {
      objects = match move run compileUnits(
        scratch,
        &clang,
        origin,
        Bytes.asSlice(&answer),
        List<Bytes>.asSlice(&unitFlags),
        units,
        packs,
        unitLines,
        sources,
        target,
        output,
        &mut progress.*,
      ) {
        UnitBuild.Objects { paths } => move paths
        UnitBuild.Failed { status } => {
          return status
        }
      }
    }
  }

  // The archives the declared inputs name are fetched into the archive store first.
  if final && linkInputs.length > usize.ZERO {
    if let Option<Bytes>.Some { value: failure } = move run NativeArchives.ensure(
      ModuleSourceFiles.archives(sources),
      linkInputs,
    ) {
      run Progress.clear(&mut progress.*)
      run writeError(b"silk: ")
      run writeError(Bytes.asSlice(&failure))
      run writeError(b"\n")
      return 2
    }
  }

  // Declared sources compile into cached objects that take their place among the link inputs.
  let mut compiledInputs = List<NativeLinkInput>.make()
  let mut nativeInputs = linkInputs
  let mut nativeHeaders = Option<ContentHash>.none()
  if compilesSources {
    let mut base = List<Bytes>.make()
    if !linked {
      let mut selected = run Bytes.copy(b"--target=")
      run Bytes.append(&mut selected, Target.llvmTriple(target))
      run List<Bytes>.append(&mut base, move selected)
    }
    if !linked && !same(Target.operatingSystem(target), b"windows") {
      if same(relocation, b"pic") {
        run List<Bytes>.append(&mut base, run Bytes.copy(b"-fPIC"))
      } else {
        run List<Bytes>.append(&mut base, run Bytes.copy(b"-fno-pic"))
      }
    }
    flag = usize.ZERO
    while flag < shared.length {
      run List<Bytes>.append(&mut base, run Bytes.copy(Bytes.asSlice(&shared[flag])))
      flag = flag + usize.ONE
    }
    let mut identity = Bytes.make()
    if let Option<Bytes>.Some { value: answer } = &probed {
      run Bytes.append(&mut identity, Bytes.asSlice(&answer))
    }
    if let Option<Supply>.Some { value: selected } = &supply.* {
      let read = List<SupplyFile>.asSlice(&selected.files)
      let mut file = usize.ZERO
      while file < read.length {
        let digest: &[u8] = &read[file].digest
        run appendDigest(&mut identity, ContentHash.of(digest))
        file = file + usize.ONE
      }
    }
    let cache = run NativeCompile.directoryFor(output)
    match move run NativeCompile.compile(
      linkInputs,
      &cache,
      &clang,
      Bytes.asSlice(&identity),
      List<Bytes>.asSlice(&base),
    ) {
      NativeBuild.Linked { inputs, diagnostics, headers } => {
        nativeHeaders = Option<ContentHash>.some(headers)
        if Bytes.length(&diagnostics) > usize.ZERO {
          run Progress.clear(&mut progress.*)
          run writeError(Bytes.asSlice(&diagnostics))
        }
        compiledInputs = move inputs
      }
      NativeBuild.Failed { diagnostics } => {
        run Progress.clear(&mut progress.*)
        run writeError(Bytes.asSlice(&diagnostics))
        return 1
      }
    }
    nativeInputs = List<NativeLinkInput>.asSlice(&compiledInputs)
  }

  // A native executable built as one optimized module compiles it to an object cached by the
  // module's digest, then links that object: an unchanged module, as in a build whose only change
  // is a link input, links in seconds instead of being optimized again. A debug module keeps the
  // one-step compile and link, which gathers its DWARF on macOS.
  let irDigest = ContentHash.of(Bytes.asSlice(ir))
  let mut wholeObject = Option<Path>.none()
  if units.length == usize.ZERO && linked && !freestanding && !windows && !debug
    && debugInfo.length == usize.ZERO {
    if let Option<Bytes>.None = &probed {
      match move run probeClang(&clang, origin, minimumClang, &mut progress.*) {
        ClangVersion.Answered { output: answer } => {
          probed = Option<Bytes>.some(move answer)
        }
        ClangVersion.Failed { status } => {
          return status
        }
      }
    }
    let mut identity = run Bytes.copy(Path.rawBytes(&clang))
    if let Option<Bytes>.Some { value: answer } = &probed {
      run Bytes.append(&mut identity, b"\n")
      run Bytes.append(&mut identity, Bytes.asSlice(&answer))
    }
    flag = usize.ZERO
    while flag < shared.length {
      run Bytes.append(&mut identity, b"\n")
      run Bytes.append(&mut identity, Bytes.asSlice(&shared[flag]))
      flag = flag + usize.ONE
    }
    let directory = run CodegenCache.directoryFor(output)
    let object = run CodegenCache.wholeObject(&directory, Bytes.asSlice(&identity), irDigest)
    run NativeToolchain.addPathArgument(&mut process, &object)
    wholeObject = Option<Path>.some(move object)
  } else if units.length == usize.ZERO {
    run ChildProcess.addArgument(&mut process, "-x")
    run ChildProcess.addArgument(&mut process, "ir")
    run NativeToolchain.addPathArgument(&mut process, &irPath)
  }

  // Restore extension-based input kinds so declared objects and archives are not read as IR.
  run ChildProcess.addArgument(&mut process, "-x")
  run ChildProcess.addArgument(&mut process, "none")
  let linkedObjects = List<Path>.asSlice(&objects)
  let mut indirectFiles = false
  static if Intrinsic.targetOperatingSystem() == "windows" {
    indirectFiles = windows
  }
  let mut fileArguments = Bytes.make()
  let mut fileGroup: usize = 0
  flag = usize.ZERO
  while flag < linkedObjects.length {
    if indirectFiles {
      let path = run NativeToolchain.pathBytes(&linkedObjects[flag])
      run Bytes.append(&mut fileArguments, Bytes.asSlice(&path))
      run Bytes.append(&mut fileArguments, b"\0")
    } else {
      run NativeToolchain.addPathArgument(&mut process, &linkedObjects[flag])
    }
    flag = flag + usize.ONE
  }
  run ChildProcess.addArgument(&mut process, "-o")
  let mut archiver = Option<ProcessRequest>.none()
  if archive {
    run NativeToolchain.addPathArgument(&mut process, &member)

    // `rcsD`: replace members, create the archive, write its symbol index, and zero member times.
    let mut request = run NativeToolchain.archiver(&clang)
    run ChildProcess.addArgument(&mut request, "rcsD")
    run NativeToolchain.addPathArgument(&mut request, &staged)
    run NativeToolchain.addPathArgument(&mut request, &member)
    let mut declared = usize.ZERO
    while declared < nativeInputs.length {
      run NativeLinkInputs.appendArchiveMember(&nativeInputs[declared], &mut request)
      declared = declared + usize.ONE
    }
    static if Intrinsic.targetOperatingSystem() == "windows" {
      let tool = run Path.fromBytes(ChildProcess.program(&request))
      let response = run Path.join(scratch, "archive.rsp")
      request = run NativeToolchain.responseFile(&tool, &response, ChildProcess.arguments(&request))
    }
    archiver = Option<ProcessRequest>.some(move request)
  } else {
    run NativeToolchain.addPathArgument(&mut process, &staged)
  }
  if final && !archive {
    // Declared inputs precede the C libraries so their own references to libc and libm resolve.
    let mut input = usize.ZERO
    while input < nativeInputs.length {
      if !linked && !NativeLinkInputs.relocatable(&nativeInputs[input]) {
        run NativeLinkInputs.invalid(
          b"an object artifact merges only declared objects and static archives",
        )
      }
      let mut path = Option<&Path>.none()
      if indirectFiles {
        path = NativeLinkInputs.file(&nativeInputs[input])
      }
      if let Option<&Path>.Some { value } = path {
        let native = run NativeToolchain.pathBytes(value)
        run Bytes.append(&mut fileArguments, Bytes.asSlice(&native))
        run Bytes.append(&mut fileArguments, b"\0")
      } else {
        if indirectFiles {
          run WindowsLink.appendFiles(
            &mut process,
            scratch,
            Bytes.asSlice(&fileArguments),
            fileGroup,
          )
          fileArguments = Bytes.make()
          fileGroup = fileGroup + 1
        }
        run NativeLinkInputs.appendArguments(&nativeInputs[input], target, stubbed, &mut process)
      }
      input = input + usize.ONE
    }
  }
  if indirectFiles {
    run WindowsLink.appendFiles(&mut process, scratch, Bytes.asSlice(&fileArguments), fileGroup)
  }
  if windows {
    let prepared = run WindowsLink.prepare(&mut process, &clang, scratch)
    if prepared != 0 {
      return prepared
    }
  }

  // Silk's libSystem stub is libc and libm too, as libSystem is on macOS.
  if linked && stubbed {
    run DarwinLink.prepare(&mut process, scratch)
  } else if glibcStubbed {
    run LinuxLink.configure(&mut process, &glibcStubs, target)
  } else if linked && !freestanding && !windows {
    run ChildProcess.addArgument(&mut process, "-lc")
    run ChildProcess.addArgument(&mut process, "-lm")
  }

  // Its code is not position independent either (`clangProfileFlags`).
  if linked && !library && fixedAddress(relocation, target) {
    run ChildProcess.addArgument(&mut process, "-no-pie")
  }

  // The link consumes the supply only while its selected files keep the bytes resolution read.
  if let Option<Supply>.Some { value: selected } = &supply.* {
    let checked = run Effect.result(PlatformSupplies.validate(&selected))
    match move checked {
      Result<(), SupplyError | OutOfMemoryError>.Success { .. } => {}
      Result<(), SupplyError | OutOfMemoryError>.Failure { error } => match move error {
        SupplyError changed => {
          run Progress.clear(&mut progress.*)
          run reportSupply(&changed)
          return 2
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
  }

  // An executable links again only when its command or its output changed since the link its
  // stamp records. A split build's command names its cached objects; a whole module is named by
  // its digest. Anything else read from outside the build (a
  // declared input, an archive, the wasip2 component tools) relinks every time.
  // Objects compiled from native translation units are named by the digest of what they compile from, so
  // the command names them as it names a split build's objects.
  let stamped = linked && !windows && !archive && NativeLinkInputs.onlySources(linkInputs)
    && Target.id(target) != TargetId.Wasm32Wasip2
  let mut command = run linkCommand(&process, Bytes.asSlice(&stem))
  if units.length == usize.ZERO {
    run appendDigest(&mut command, irDigest)
  }
  if debugInfo.length > usize.ZERO {
    run appendDigest(&mut command, ContentHash.of(debugInfo))
  }

  // A renamed function changes the published names even when its symbol stays the same.
  if FunctionNames.length(functionNames) > usize.ZERO {
    run appendDigest(&mut command, FunctionNames.digest(functionNames))
  }

  // A stubbed macOS link reads Silk's libSystem stub in place of an SDK's.
  if linked && stubbed {
    let stub = run DarwinLink.libSystem()
    run appendDigest(&mut command, ContentHash.of(Bytes.asSlice(&stub)))
  }
  if let Option<&CompilationRequest>.Some { value: request } = explicit {
    if let Option<RequestMacOS>.Some { value: macos } = &request.macos {
      if let Option<String>.Some { value: entitlements } = &macos.entitlements {
        let path = run Path.make(entitlements.view())
        let contents = run FileSystem.readFile(&path)
        run appendDigest(&mut command, ContentHash.of(contents.asSlice()))
      }
    }
  }
  if let Option<ContentHash>.Some { value: headers } = &nativeHeaders {
    run appendDigest(&mut command, headers)
  }

  // The glibc stubs' directory, which the command names, is named by a digest of their text.
  // The command names a supply's root, linker and deployment, but not the bytes of the SDK files
  // it read, so a replaced SDK at the same path relinks, natively or across hosts alike.
  if let Option<Supply>.Some { value: selected } = &supply.* {
    let read = List<SupplyFile>.asSlice(&selected.files)
    let mut file = usize.ZERO
    while file < read.length {
      let digest: &[u8] = &read[file].digest
      run appendDigest(&mut command, ContentHash.of(digest))
      file = file + usize.ONE
    }
  }

  // A browser module's DWARF and source map are published beside it (`splitDebug`).
  let splitting = same(Target.objectFormat(target), b"wasm")
    && same(Target.operatingSystem(target), b"freestanding")
    && FunctionNames.length(functionNames) > usize.ZERO
  if splitting {
    run Bytes.append(&mut command, b" split-debug")
  }
  if printed {
    run Bytes.append(&mut command, b" wasm-text")
  }
  if let Option<Bytes>.Some { value: order } = &ordering {
    run appendDigest(&mut command, ContentHash.of(Bytes.asSlice(&order)))
  }
  let unitDirectory = run CodegenCache.directoryFor(output)
  static if Intrinsic.targetOperatingSystem() == "windows" {
    // Keep the full arguments in the cache identity above. A split build's object paths can
    // exceed CreateProcessW's command-line limit even when every individual path is valid.
    let response = run Path.join(scratch, "clang.rsp")
    process = run NativeToolchain.responseFile(&clang, &response, ChildProcess.arguments(&process))
  }
  let use = effect |resource: &mut Path| -> i32
    ! FileError | ProcessError | HostInputError | OutOfMemoryError | WriterError
    ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
    if stamped && run CodegenCache.linkedBy(&unitDirectory, Bytes.asSlice(&command), output) {
      if !splitting {
        return 0
      }
      if run debugFilesExist(output) {
        return 0
      }
    }
    run CodegenCache.forgetLink(&unitDirectory)
    if let Option<Path>.Some { value: object } = &wholeObject {
      if !run FileSystem.exists(&object) {
        let optimized = run optimizeModule(
          &clang,
          origin,
          ir,
          &resource.*,
          &object,
          &unitDirectory,
          List<Bytes>.asSlice(&common),
          &mut progress.*,
        )
        if optimized != 0 {
          return optimized
        }
      }
    } else if units.length == usize.ZERO {
      if let Option<Bytes>.None = &probed {
        if let ClangVersion.Failed { status } = run probeClang(
          &clang,
          origin,
          minimumClang,
          &mut progress.*,
        ) {
          return status
        }
      }
      let mut bitcode = Bytes.make()
      if debugInfo.length == usize.ZERO {
        bitcode = run Bitcode.compileProgram(Bytes.asSlice(ir))
      } else {
        bitcode = run Bitcode.compileProgramDebug(Bytes.asSlice(ir), debugInfo)
      }
      run FileSystem.writeFile(&resource.*, Bytes.asSlice(&bitcode))
    }
    if let Option<Bytes>.Some { value: order } = &ordering {
      run FileSystem.writeFile(&orderPath, Bytes.asSlice(&order))
    }
    if glibcStubbed {
      let built = run LinuxLink.build(
        &clang,
        List<Bytes>.asSlice(&stubLinker),
        &glibcStubs,
        Bytes.asSlice(&stem),
        target,
      )
      if built != 0 {
        return built
      }
    }

    // A Clang that cannot start fails this target, which reports as any failed target does.
    let compiled = match move run Effect.result(submitted(&process, &mut progress.*)) {
      Result<i32, ProcessError | OutOfMemoryError | WriterError>.Success { value } => value
      Result<i32, ProcessError | OutOfMemoryError | WriterError>.Failure {
        error
      } => match move error {
        ProcessError unstarted => {
          drop unstarted
          run Progress.clear(&mut progress.*)
          run writeError(b"silk: cannot run the C compiler ")
          run writeError(Path.rawBytes(&clang))
          run writeError(b" (")
          run writeError(origin)
          run writeError(b"); set SILK_CLANG or pass --clang the path of the Clang executable\n")
          return 2
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
        WriterError broken => {
          fail move broken
        }
      }
    }
    if compiled != 0 {
      return compiled
    }
    if units.length > usize.ZERO {
      run CodegenCache.prune(&unitDirectory, linkedObjects)
    }
    if let Option<Path>.Some { value: object } = &wholeObject {
      let mut kept = List<Path>.make()
      run List<Path>.append(&mut kept, run Path.fromBytes(Path.rawBytes(&object)))
      run CodegenCache.prune(&unitDirectory, List<Path>.asSlice(&kept))
    }

    // Engines print the name section in their traces, so a debug module names its functions as
    // the source does, before a component wraps it.
    if freestanding && FunctionNames.length(functionNames) > usize.ZERO {
      let module = run FileSystem.readFile(&staged)
      if let Option<Bytes>.Some { value: renamed } = move run WasmNames.rename(
        Bytes.asSlice(&module),
        functionNames,
      ) {
        run FileSystem.writeFile(&staged, Bytes.asSlice(&renamed))
      }
      if splitting {
        run splitDebug(
          &staged,
          output,
          Slice.view<u8>(outputName, nameStart, outputName.length - nameStart),
        )
      }
    }
    if let Option<ProcessRequest>.Some { value: archiving } = &archiver {
      let archived = run submitted(&archiving, &mut progress.*)
      if archived != 0 {
        return archived
      }
    }

    // A `wasm-text` build publishes the core module's text.
    if printed {
      let module = run FileSystem.readFile(&staged)
      match move run printedModule(Bytes.asSlice(&module)) {
        Option<Bytes>.Some { value: printedText } => run FileSystem.writeFile(
          &staged,
          Bytes.asSlice(&printedText),
        )
        Option<Bytes>.None => {
          run Progress.clear(&mut progress.*)
          return 2
        }
      }
    }

    // Component construction completes before the output is published.
    let mut publication = &staged
    if linked && Target.id(target) == TargetId.Wasm32Wasip2 && !printed {
      let converted = run WasiTools.component(&staged, &componentPath, world, started)
      if converted != 0 {
        return converted
      }
      publication = &componentPath
    }
    if linked && darwin {
      if let Option<&CompilationRequest>.Some { value: request } = explicit {
        let signed = run CompilationPlatform.sign(publication, request)
        if signed != 0 {
          return signed
        }
      }
    }

    // One rename, so a command running `output` meanwhile finds the old file or the new one.
    let published = run HostRename.replaceFile(publication, output)
    if !published {
      run Progress.clear(&mut progress.*)
      run writeError(b"silk: cannot write ")
      run writeError(Path.rawBytes(output))
      run writeError(b"\n")
      return 2
    }

    // Clang compiling and linking a debug build in one step on macOS gathers its DWARF into a
    // `.dSYM` bundle beside the linked file, since the object that held it is gone after the link.
    // The bundle moves beside `output` too, or a debugger finds neither names nor lines.
    if linked && darwin && debug {
      run publishDebugBundle(&staged, output)
    }
    if stamped {
      run CodegenCache.recordLink(&unitDirectory, Bytes.asSlice(&command), output)
    }
    return 0
  }
  let release = effect |resource: &mut Path| -> ()
    ? &mut FileSystem {
    run removeQuietly(&resource.*)
    if archive {
      run removeQuietly(&member)
    }
    run removeQuietly(&componentPath)
    return ()
  }
  return run Effect.useReleaseNonParking(move irPath, move use, move release)
}

// Appends `digest` to a link command on a line of its own.
effect fn appendDigest(command: &mut Bytes, digest: ContentHash) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run Bytes.append(&mut command.*, b"\n")
  run appendDecimal64(&mut command.*, digest.high)
  run Bytes.append(&mut command.*, b" ")
  run appendDecimal64(&mut command.*, digest.low)
}

// The bytes of the file at `path`, or none when it cannot be read.
effect fn readable(path: &[u8]) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let parsed = match move run CommandPath.pathOf(path) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return Option<Bytes>.none()
    }
  }
  return match move run Effect.result(FileSystem.readFile(&parsed)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => Option<Bytes>.some(move value)
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        drop failure
        return Option<Bytes>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// Whether the files `splitDebug` writes beside `output` exist.
effect fn debugFilesExist(output: &Path) -> bool
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut debugPath = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut debugPath, b".debug.wasm")
  let mut mapPath = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut mapPath, b".map")
  let debugFile = run Path.fromBytes(Bytes.asSlice(&debugPath))
  if !run FileSystem.exists(&debugFile) {
    return false
  }
  let mapFile = run Path.fromBytes(Bytes.asSlice(&mapPath))
  return run FileSystem.exists(&mapFile)
}

// A browser module ships without its DWARF: the staged module `staged`, published as `output`
// named `name`, keeps its code and names `<name>.debug.wasm`, the module with its DWARF, for
// Chrome, and `<name>.map`, a source map with each source's text, for Firefox and Safari. Both are
// written beside `output` before the module is published.
effect fn splitDebug(staged: &Path, output: &Path, name: &[u8]) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let module = run FileSystem.readFile(staged)
  let mut debugName = run Bytes.copy(name)
  run Bytes.append(&mut debugName, b".debug.wasm")
  let mut mapName = run Bytes.copy(name)
  run Bytes.append(&mut mapName, b".map")
  let mut debugPath = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut debugPath, b".debug.wasm")
  let debugFile = run Path.fromBytes(Bytes.asSlice(&debugPath))
  let mut mapPath = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut mapPath, b".map")
  let mapFile = run Path.fromBytes(Bytes.asSlice(&mapPath))
  let parts = match move run WasmDebug.split(
    Bytes.asSlice(&module),
    Bytes.asSlice(&debugName),
    Bytes.asSlice(&mapName),
  ) {
    Option<WasmDebug.Split>.Some { value } => move value
    Option<WasmDebug.Split>.None => {
      // A module whose lines cannot be read keeps its DWARF, and no older files describe it.
      run removeQuietly(&debugFile)
      run removeQuietly(&mapFile)
      return ()
    }
  }
  let mut contents = List<Option<Bytes>>.make()
  let sources = LineTable.paths(&parts.lines)
  let mut at = usize.ZERO
  while at < sources.length {
    run List<Option<Bytes>>.append(&mut contents, run readable(Bytes.asSlice(&sources[at])))
    at = at + usize.ONE
  }
  let map = run WasmDebug.sourceMap(&parts.lines, List<Option<Bytes>>.asSlice(&contents))
  run FileSystem.writeFile(&debugFile, Bytes.asSlice(&module))
  run FileSystem.writeFile(&mapFile, Bytes.asSlice(&map))
  run FileSystem.writeFile(staged, Bytes.asSlice(&parts.module))
}

// Whether the file at `path` holds exactly `expected`; false when it cannot be read.
effect fn holds(path: &Path, expected: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  return match move run Effect.result(FileSystem.readFile(path)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => same(
      Bytes.asSlice(&value),
      expected,
    )
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        drop failure
        return false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// What decides the output `process` links: its program, its arguments but the scratch name
// `staged` it writes to, its environment and its working directory.
effect fn linkCommand(process: &ProcessRequest, staged: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut command = run Bytes.copy(ChildProcess.program(process))
  run Bytes.append(&mut command, b"\n")
  let arguments = ChildProcess.arguments(process)
  let mut start = usize.ZERO
  while start < arguments.length {
    let mut end = start
    while end < arguments.length && arguments[end] != 0 {
      end = end + usize.ONE
    }
    if end < arguments.length {
      end = end + usize.ONE
    }
    let entry = Slice.view<u8>(arguments, start, end - start)

    // A file in the scratch directory is named by its suffix alone, since that directory is fresh
    // for every link; the staged output itself is left out.
    if entry.length > staged.length
      && same(Slice.view<u8>(entry, usize.ZERO, staged.length), staged) {
      if entry.length != staged.length + usize.ONE {
        run Bytes.append(
          &mut command,
          Slice.view<u8>(entry, staged.length, entry.length - staged.length),
        )
      }
    } else {
      run Bytes.append(&mut command, entry)
    }
    start = end
  }
  run Bytes.append(&mut command, b"\n")
  run Bytes.append(&mut command, ChildProcess.environment(process))
  run Bytes.append(&mut command, b"\n")
  run Bytes.append(&mut command, ChildProcess.workingDirectory(process))
  return move command
}

// The objects of a split build's codegen units, or the status of a compile that failed after
// writing why.
union UnitBuild {
  Objects { paths: List<Path> },
  Failed { status: i32 },
}

// Whether `clang` is the Clang a release installs beside its compiler (`BundledLlvm`).
fn bundledClang(clang: &[u8]) -> bool {
  let mut suffix: &[u8] = b"/lib/silk/llvm/bin/clang"
  static if Intrinsic.targetOperatingSystem() == "windows" {
    suffix = b"/lib/silk/llvm/bin/clang.exe"
  }
  return clang.length >= suffix.length
    && same(Slice.view<u8>(clang, clang.length - suffix.length, suffix.length), suffix)
}

// The lld driver `name` (`/ld.lld` or `/ld64.lld`) in the directory Clang's `--version` output
// names as its installation, when it is there.
effect fn installedLld(version: &[u8], name: &[u8]) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let label = b"InstalledDir: "
  let mut start = usize.ZERO
  while start < version.length {
    let mut end = start
    while end < version.length && version[end] != 10 {
      end = end + usize.ONE
    }
    let line = Slice.view<u8>(version, start, end - start)
    if line.length > label.length && same(Slice.view<u8>(line, usize.ZERO, label.length), label) {
      let mut linker = run Bytes.copy(
        Slice.view<u8>(line, label.length, line.length - label.length),
      )
      run Bytes.append(&mut linker, name)
      let path = match move run Effect.result(Path.fromBytes(Bytes.asSlice(&linker))) {
        Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
        Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
          FileError failure => {
            drop failure
            return Option<Bytes>.none()
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
      let mut found = false
      match move run Effect.result(FileSystem.exists(&path)) {
        Result<bool, FileError>.Success { value } => {
          found = value
        }
        Result<bool, FileError>.Failure { error } => {
          drop error
        }
      }
      if !found {
        return Option<Bytes>.none()
      }
      return Option<Bytes>.some(move linker)
    }
    start = end + usize.ONE
  }
  return Option<Bytes>.none()
}

// Clang's `--version` output, or the status of a build that cannot use it after writing why.
union ClangVersion {
  Answered { output: Bytes },
  Failed { status: i32 },
}

// The oldest Clang major version that compiles a program given `profileFlags` correctly. The
// backend writes LLVM 22 bitcode, which older Clang misreads (Clang 18's optimizer crashes on its
// lifetime markers). Clang 22's x86 backend also miscompiles AVX-512 mask code: its EVEX
// compression folds `vpmov*2m` into `vmovmsk*` while a later instruction still reads the mask
// register (llvm/llvm-project#198220, fixed in Clang 23). Those instructions exist for 128- and
// 256-bit vectors only with avx512vl and avx512dq or avx512bw, which `cpu.model = "native"` turns
// on for recent x86 CPUs, so such a build needs Clang 23.
fn clangMinimum(profileFlags: &[Bytes]) -> usize {
  let mut lengths = false
  let mut masks = false
  let mut at = usize.ZERO
  while at < profileFlags.length {
    let flag = Bytes.asSlice(&profileFlags[at])
    if same(flag, b"+avx512vl") {
      lengths = true
    }
    if same(flag, b"+avx512dq") || same(flag, b"+avx512bw") {
      masks = true
    }
    at = at + usize.ONE
  }
  if lengths && masks {
    return usize.add(0, 23)
  }
  return usize.add(0, 22)
}

// Asks `clang`, from `origin`, for its version, and refuses one older than `minimum`
// (`clangMinimum`).
effect fn probeClang(
  clang: &Path,
  origin: &[u8],
  minimum: usize,
  progress: &mut Progress,
) -> ClangVersion
  ! FileError | ProcessError | HostInputError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let mut version = run NativeToolchain.request(clang)
  run ChildProcess.addArgument(&mut version, "--version")
  let probed = match move run Effect.result(ChildProcess.submit(&version)) {
    Result<ProcessOutcome, ProcessError | OutOfMemoryError>.Success { value } => move value
    Result<ProcessOutcome, ProcessError | OutOfMemoryError>.Failure { error } => match move error {
      ProcessError unstarted => {
        drop unstarted
        return ClangVersion.Failed { status: run unstartedClang(clang, origin, &mut progress.*) }
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let mut answered = false
  if let Option<i32>.Some { value } = move ChildProcess.exitCode(&probed) {
    answered = value == 0
  }
  if !answered {
    return ClangVersion.Failed { status: run unstartedClang(clang, origin, &mut progress.*) }
  }
  let output = ChildProcess.outputBytes(&probed)
  if let Option<usize>.Some { value: major } = clangMajor(output) {
    if major < minimum {
      run Progress.clear(&mut progress.*)
      let mut message = run Bytes.copy(b"silk: ")
      if minimum > usize.add(0, 22) {
        run Bytes.append(&mut message, b"builds with avx512vl and avx512dq or avx512bw need Clang ")
      } else {
        run Bytes.append(&mut message, b"Silk builds need Clang ")
      }
      run appendDecimal(&mut message, minimum)
      run Bytes.append(&mut message, b" or newer, but ")
      run Bytes.append(&mut message, Path.rawBytes(clang))
      run Bytes.append(&mut message, b" (")
      run Bytes.append(&mut message, origin)
      run Bytes.append(&mut message, b") is Clang ")
      run appendDecimal(&mut message, major)
      run Bytes.append(&mut message, b"; set SILK_CLANG or pass --clang the path of a newer Clang\n")
      run writeError(Bytes.asSlice(&message))
      return ClangVersion.Failed { status: 2 }
    }
  }
  return ClangVersion.Answered { output: run Bytes.copy(output) }
}

// Writes that `clang`, from `origin`, cannot run, and answers the failed build's status.
effect fn unstartedClang(clang: &Path, origin: &[u8], progress: &mut Progress) -> i32
  ! WriterError {
  run Progress.clear(&mut progress.*)
  run writeError(b"silk: cannot run the C compiler ")
  run writeError(Path.rawBytes(clang))
  run writeError(b" (")
  run writeError(origin)
  run writeError(b"); set SILK_CLANG or pass --clang the path of the Clang executable\n")
  return 2
}

// The line tables of the unit made of `fragments` (`debugInfoOf`), or nothing without a `plan`
// to name its functions.
effect fn unitDebugInfo(
  plan: Option<&EmissionPlan>,
  sources: &ModuleSources,
  fragments: &[u8],
  unit: &CodegenUnit,
) -> Bytes
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  if !unit.debug.unwrapOr(true) {
    return Bytes.make()
  }
  if let Option<&EmissionPlan>.Some { value } = plan {
    let mut module = BitcodeModule.make()
    run BitcodeModule.mergeAll(&mut module, fragments)
    let optimized = match &unit.optimization {
      Option<Bytes>.Some { value: mode } => mode.asSlice() != b"none"
      Option<Bytes>.None => false
    }
    return run debugInfoOf(value, sources, &module, optimized)
  }
  return Bytes.make()
}

// Compiles the whole module `ir`, encoded as bitcode to `input`, to the cached `object` with the
// shared code `flags`, and answers Clang's status. Clang optimizes the whole program here, so the
// step shows as its own `optimize` phase before the link resumes, measured against the time it
// took last that the output's cache `directory` records.
effect fn optimizeModule(
  clang: &Path,
  origin: &[u8],
  ir: &Bytes,
  input: &Path,
  object: &Path,
  directory: &Path,
  flags: &[Bytes],
  progress: &mut Progress,
) -> i32
  ! FileError | ProcessError | HostInputError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  run Progress.retitle(&mut progress.*, ProgressPhase.Optimize)
  let mut subject = run Bytes.copy(b"clang")
  if let Option<u64>.Some { value: last } = run CodegenCache.lastOptimize(directory) {
    Progress.expect(&mut progress.*, last)
    run Bytes.append(&mut subject, b" (last ")
    run Progress.appendDuration(&mut subject, last)
    run Bytes.append(&mut subject, b")")
  }
  run Progress.show(&mut progress.*, Bytes.asSlice(&subject))
  let began = run Progress.stamp()
  let bitcode = run Bitcode.compileProgram(Bytes.asSlice(ir))
  run FileSystem.writeFile(input, Bytes.asSlice(&bitcode))
  drop bitcode
  let partial = run CodegenCache.pending(object, b"")
  let mut request = run NativeToolchain.request(clang)
  run ChildProcess.addArgument(&mut request, "-c")
  run ChildProcess.addArgument(&mut request, "-Wno-unused-command-line-argument")
  let mut flag = usize.ZERO
  while flag < flags.length {
    run ChildProcess.addArgumentBytes(&mut request, Bytes.asSlice(&flags[flag]))
    flag = flag + usize.ONE
  }
  run ChildProcess.addArgument(&mut request, "-x")
  run ChildProcess.addArgument(&mut request, "ir")
  run NativeToolchain.addPathArgument(&mut request, input)
  run ChildProcess.addArgument(&mut request, "-o")
  run NativeToolchain.addPathArgument(&mut request, &partial)
  let compiled = match move run Effect.result(submitted(&request, &mut progress.*)) {
    Result<i32, ProcessError | OutOfMemoryError | WriterError>.Success { value } => value
    Result<i32, ProcessError | OutOfMemoryError | WriterError>.Failure {
      error
    } => match move error {
      ProcessError unstarted => {
        drop unstarted
        return run unstartedClang(clang, origin, &mut progress.*)
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      WriterError broken => {
        fail move broken
      }
    }
  }
  if compiled != 0 {
    return compiled
  }
  let ended = run Progress.stamp()
  run CodegenCache.recordOptimize(directory, ended - began)
  if !run CodegenCache.publish(object, b"") {
    run Progress.clear(&mut progress.*)
    run writeError(b"silk: cannot write ")
    run writeError(Path.rawBytes(object))
    run writeError(b"\n")
    return 2
  }
  run Progress.end(&mut progress.*, b"clang")
  run Progress.begin(&mut progress.*, ProgressPhase.Link, usize.ZERO)
  run Progress.show(&mut progress.*, b"clang")
  return 0
}

// Compiles each codegen unit whose object the cache beside `output` lacks, on worker threads, with
// its IR in `scratch`, and answers every unit's object. `origin` says where `clang` came from, for
// the error when it cannot start.
effect fn compileUnits(
  scratch: &Path,
  clang: &Path,
  origin: &[u8],
  probed: &[u8],
  common: &[Bytes],
  units: &[CodegenUnit],
  packs: &[BuildRecord.PackBody],
  unitLines: Option<&EmissionPlan>,
  sources: &ModuleSources,
  target: &Target,
  output: &Path,
  progress: &mut Progress,
) -> UnitBuild
  ! FileError | ProcessError | HostInputError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  // An object is reused only for the same Clang, flags and unit text.
  let mut identity = run Bytes.copy(Path.rawBytes(clang))
  run Bytes.append(&mut identity, b"\n")
  run Bytes.append(&mut identity, probed)
  let mut at = usize.ZERO
  while at < common.length {
    run Bytes.append(&mut identity, b"\n")
    run Bytes.append(&mut identity, Bytes.asSlice(&common[at]))
    at = at + usize.ONE
  }

  // A unit's line tables come from its own text and where its declarations start, which names
  // its object too (`CodegenUnit.origins`), so here only whether it has them keys its object.
  if let Option<&EmissionPlan>.Some { .. } = unitLines {
    run Bytes.append(&mut identity, b"\nline-tables")
  }

  // Units without exports read the same in every program that holds them, so the outputs of one
  // directory share their objects. A release unit's exports are not part of its name, so those
  // stay beside their own output.
  let mut directory = run CodegenCache.directoryFor(output)
  let mut tag = Bytes.make()
  let mut sharing = false
  if !exporting(units) {
    if let Option<Path>.Some { value: store } = move run CodegenCache.sharedFor(output) {
      directory = move store
      tag = run CodegenCache.tagOf(output)
      sharing = true
    }
  }
  let mut placed = run CodegenCache.place(&directory, Bytes.asSlice(&identity), units)
  if sharing {
    // Listed before they are looked for: another build's prune then keeps them.
    run CodegenCache.claim(&directory, Bytes.asSlice(&tag), List<Path>.asSlice(&placed.objects))
    placed = run CodegenCache.place(&directory, Bytes.asSlice(&identity), units)
  }
  let objects = List<Path>.asSlice(&placed.objects)
  let missing = List<usize>.asSlice(&placed.missing)
  let mut jobs = List<CodegenCache.Job>.make()

  // Keep each command and input to rerun a failed one here, where its errors are written.
  let mut kept = List<List<Bytes>>.make()
  let mut inputs = List<Path>.make()
  let mut sizes = List<usize>.make()
  at = usize.ZERO
  while at < missing.length {
    // A unit is written under its object's name: Clang records the file name in the object, which
    // then reads the same for the same fragments whichever build compiles it.
    let objectBytes = Path.rawBytes(&objects[missing[at]])
    let mut slash = objectBytes.length
    while slash > usize.ZERO && objectBytes[slash - usize.ONE] != 47 {
      slash = slash - usize.ONE
    }
    let mut name = run Bytes.copy(
      Slice.view<u8>(objectBytes, slash, objectBytes.length - slash - 2),
    )
    run Bytes.append(&mut name, b".bc")
    let ir = run Path.joinBytes(scratch, Bytes.asSlice(&name))
    let mut fragments = run Bytes.copy(Bytes.asSlice(&units[missing[at]].head))
    run Bytes.append(&mut fragments, unitBody(&units[missing[at]], packs))
    let debug = run unitDebugInfo(
      unitLines,
      sources,
      Bytes.asSlice(&fragments),
      &units[missing[at]],
    )
    run List<usize>.append(&mut sizes, Bytes.length(&fragments))
    let mut command = List<Bytes>.make()
    run List<Bytes>.append(&mut command, run Bytes.copy(Path.rawBytes(clang)))
    run List<Bytes>.append(&mut command, run Bytes.copy(b"-c"))
    run List<Bytes>.append(&mut command, run Bytes.copy(b"-Wno-unused-command-line-argument"))
    let selectedFlags = run PackageCodegen.flags(
      common,
      &units[missing[at]],
      same(Target.objectFormat(target), b"wasm"),
      same(Target.architecture(target), b"x86_64"),
    )
    let selected = selectedFlags.asSlice()
    let mut flag = usize.ZERO
    while flag < selected.length {
      run List<Bytes>.append(&mut command, run Bytes.copy(selected[flag].asSlice()))
      flag = flag + usize.ONE
    }
    run List<Bytes>.append(&mut command, run Bytes.copy(b"-x"))
    run List<Bytes>.append(&mut command, run Bytes.copy(b"ir"))
    run List<Bytes>.append(&mut command, run NativeToolchain.pathBytes(&ir))
    run List<Bytes>.append(&mut command, run Bytes.copy(b"-o"))
    let partial = run CodegenCache.pending(&objects[missing[at]], Bytes.asSlice(&tag))
    run List<Bytes>.append(&mut command, run NativeToolchain.pathBytes(&partial))
    let mut copied = List<Bytes>.make()
    let parts = List<Bytes>.asSlice(&command)
    let mut part = usize.ZERO
    while part < parts.length {
      run List<Bytes>.append(&mut copied, run Bytes.copy(Bytes.asSlice(&parts[part])))
      part = part + usize.ONE
    }
    run List<List<Bytes>>.append(&mut kept, move copied)
    let mut request = run NativeToolchain.request(clang)
    part = usize.ONE
    while part < parts.length {
      run ChildProcess.addArgumentBytes(&mut request, Bytes.asSlice(&parts[part]))
      part = part + usize.ONE
    }
    let mut exports = Option<Bytes>.none()
    if let Option<Bytes>.Some { value: listed } = &units[missing[at]].exports {
      exports = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&listed)))
    }
    run List<CodegenCache.Job>.append(
      &mut jobs,
      CodegenCache.Job {
        fragments: move fragments,
        debug: move debug,
        exports: move exports,
        input: run Bytes.copy(Path.rawBytes(&ir)),
        request: move request,
      },
    )
    run List<Path>.append(&mut inputs, move ir)
    at = at + usize.ONE
  }

  // Without threads, each unit compiles below, one at a time. The workers' Clang runs report
  // nothing, so a ticker keeps the live line moving until they all end.
  let mut statuses = List<i32>.make()
  let ticker = run Progress.tick(&mut progress.*)
  let ran = run Effect.result(
    CodegenCache.runAll(move jobs, List<usize>.asSlice(&sizes), NativeThread.processorCount()),
  )
  drop ticker
  match move ran {
    Result<List<i32>, OutOfMemoryError | SpawnError>.Success { value } => {
      statuses = move value
    }
    Result<List<i32>, OutOfMemoryError | SpawnError>.Failure { error } => match move error {
      SpawnError unstarted => {
        drop unstarted
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  at = usize.ZERO
  while at < missing.length {
    let mut status: i32 = -1
    if at < List<i32>.length(&statuses) {
      status = List<i32>.get(&statuses, at)
    }
    if status != 0 || !run CodegenCache.publish(&objects[missing[at]], Bytes.asSlice(&tag)) {
      // A worker that failed early may not have written the input.
      let mut fragments = run Bytes.copy(Bytes.asSlice(&units[missing[at]].head))
      run Bytes.append(&mut fragments, unitBody(&units[missing[at]], packs))
      let debug = run unitDebugInfo(
        unitLines,
        sources,
        Bytes.asSlice(&fragments),
        &units[missing[at]],
      )
      let mut bitcode = Bytes.make()
      if Bytes.length(&debug) == usize.ZERO {
        bitcode = run Bitcode.compile(Bytes.asSlice(&fragments))
      } else {
        bitcode = run Bitcode.compileDebug(Bytes.asSlice(&fragments), Bytes.asSlice(&debug))
      }
      run FileSystem.writeFile(&List<Path>.asSlice(&inputs)[at], Bytes.asSlice(&bitcode))
      let parts = List<Bytes>.asSlice(&List<List<Bytes>>.asSlice(&kept)[at])
      let mut request = run NativeToolchain.request(clang)
      let mut part = usize.ONE
      while part < parts.length {
        run ChildProcess.addArgumentBytes(&mut request, Bytes.asSlice(&parts[part]))
        part = part + usize.ONE
      }
      let rerun = match move run Effect.result(submitted(&request, &mut progress.*)) {
        Result<i32, ProcessError | OutOfMemoryError | WriterError>.Success { value } => value
        Result<i32, ProcessError | OutOfMemoryError | WriterError>.Failure {
          error
        } => match move error {
          ProcessError unstarted => {
            drop unstarted
            return UnitBuild.Failed { status: run unstartedClang(clang, origin, &mut progress.*) }
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
          WriterError broken => {
            fail move broken
          }
        }
      }
      if rerun != 0 || !run CodegenCache.publish(&objects[missing[at]], Bytes.asSlice(&tag)) {
        if rerun == 0 {
          run Progress.clear(&mut progress.*)
          run writeError(b"silk: cannot write ")
          run writeError(Path.rawBytes(&objects[missing[at]]))
          run writeError(b"\n")
        }
        return UnitBuild.Failed { status: 1 }
      }
    }
    at = at + usize.ONE
  }
  if sharing && missing.length > usize.ZERO {
    run CodegenCache.pruneShared(&directory, Bytes.asSlice(&tag))
  }
  return UnitBuild.Objects { paths: move placed.objects }
}

// Whether any of `units` keeps a list of exported functions, as a release unit does.
fn exporting(units: &[CodegenUnit]) -> bool {
  let mut at = usize.ZERO
  while at < units.length {
    if let Option<Bytes>.Some { .. } = &units[at].exports {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Whether `flags` holds `flag`.
fn hasFlag(flags: &[Bytes], flag: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < flags.length {
    if same(Bytes.asSlice(&flags[at]), flag) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// The major version in Clang's `--version` output (`clang version 18.1.3 ...`), or `None` when the
// output names none.
fn clangMajor(output: &[u8]) -> Option<usize> {
  let marker = b"clang version "
  let mut start = usize.ZERO
  while start + marker.length <= output.length {
    let mut matched = true
    let mut at = usize.ZERO
    while matched && at < marker.length {
      if output[start + at] != marker[at] {
        matched = false
      }
      at = at + usize.ONE
    }
    if matched {
      let mut digit = start + marker.length
      let mut major = usize.ZERO
      let mut digits = usize.ZERO
      while digit < output.length && output[digit] >= 48 && output[digit] <= 57 {
        major = major * usize.add(0, 10) + u8.toUsize(output[digit] - 48)
        digits = digits + usize.ONE
        digit = digit + usize.ONE
      }
      if digits == usize.ZERO {
        return Option<usize>.none()
      }
      return Option<usize>.some(major)
    }
    start = start + usize.ONE
  }
  return Option<usize>.none()
}

// Runs one native tool: 0 when it exits successfully, else 1 after forwarding its diagnostics.
effect fn submitted(process: &ProcessRequest, progress: &mut Progress) -> i32
  ! ProcessError | OutOfMemoryError | WriterError
  ? &mut ChildProcess | &mut Allocator {
  // The child reports nothing while it runs, so a ticker keeps the live line moving until it ends.
  let ticker = run Progress.tick(&mut progress.*)
  let outcome = run ChildProcess.submit(process)
  drop ticker
  if let Option<i32>.Some { value } = move ChildProcess.exitCode(&outcome) {
    if value == 0 {
      return 0
    }
  }
  run Progress.clear(&mut progress.*)
  run writeError(ChildProcess.errorBytes(&outcome))
  return 1
}

/// A finished compilation: its process status, or for a test build that linked, the identities
/// of the discovered tests in catalog order.
union Compiled {
  Finished { status: i32 },
  Tests { identities: List<Bytes> },
}

// How a command writes the language rejections and refusals of one analysis.
union DiagnosticFormat {
  /// One `SILK_BUILD_ERROR=` or `SILK_UNSUPPORTED_JSON=` line each, for the build harnesses.
  Machine,
  /// `path:line:col: error[CODE] message`, as the TypeScript CLI prints it, with each path
  /// relative to the directory `root` when it lies under it (see [`diagnosticRoot`]) and absolute
  /// otherwise, or always absolute when `root` is empty.
  Human { root: Bytes },
  /// One JSON object per line, naming the analysis `target`.
  Json { target: Bytes },
}

// The analysis state a build or check holds once its profile is assembled.
union Prepared {
  Ready { analysis: Analysis },
  Finished { status: i32 },
}

// The path `path` holds, borrowed.
fn borrowedPath(path: &Option<Path>) -> Option<&Path> {
  return match &path.* {
    Option<Path>.Some { value } => Option<&Path>.some(&value)
    Option<Path>.None => Option<&Path>.none()
  }
}

// Loads the program rooted at `sourcePath` (within `manifest`'s package when given), publishes
// every module reachable through imports, and assembles the final profile with `bindings`. A test
// analysis is rooted at the bundled runner. A refused profile is reported in `format` and answers
// its status instead, appended to `out`. The files `snapshot` holds are not read again, and the
// files the load reads are left there for the next load of the run.
effect fn prepare(
  sourcePath: &Path,
  manifest: Option<&Path>,
  standardLibrary: Option<Path>,
  profile: &InitialProfile,
  bindings: List<Supplied>,
  testing: bool,
  mode: StoreMode,
  alias: Option<&[u8]>,
  imports: Option<&Path>,
  compiler: &Option<Bytes>,
  snapshot: &mut SourceSnapshot,
  format: &DiagnosticFormat,
  out: &mut Bytes,
  progress: &mut Progress,
  explicit: Option<&CompilationRequest>,
  definition: Option<&CompilationDefinition>,
  unsandboxedTools: bool,
  task: bool,
  versions: Versions,
) -> Prepared
  ! ApplicationError
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  // A refused binding names its manifest, which `sources` takes over.
  let mut manifestFile = Bytes.make()
  if let Option<&Path>.Some { value } = &manifest {
    manifestFile = run Bytes.copy(Path.rawBytes(value))
  }

  // The bindings are moved into assembly; a refused one is named from these copies.
  let mut boundParameters = run boundNames(&bindings, true)
  let mut boundModules = run boundNames(&bindings, false)
  if let Option<&CompilationDefinition>.Some { value } = definition {
    let packages = value.packages.entries()
    let mut package = usize.ZERO
    while package < packages.length {
      let parameters = packages[package].value.parameters.asSlice()
      let mut at = usize.ZERO
      while at < parameters.length {
        run boundParameters.append(run Bytes.copy(String.ownedUtf8Bytes(&parameters[at].name)))
        run boundModules.append(run Bytes.copy(String.ownedUtf8Bytes(&parameters[at].module)))
        at = at + usize.ONE
      }
      package = package + usize.ONE
    }
  }
  run Progress.begin(&mut progress.*, ProgressPhase.Load, usize.ZERO)

  // A package that cannot be loaded, such as one whose exports name no module, ends its load
  // row as failed and is reported here, so its unit still ends with its own `Failed` line.
  // A cached build reads an unchanged file's imports from the summaries the last load left below
  // `imports`, instead of parsing the file before the store needs it.
  let mut summaries = Option<ImportSummaries>.none()
  if let Option<&Path>.Some { value: directory } = &imports {
    if let Option<Bytes>.Some { value: stamped } = &compiler.* {
      summaries = Option<ImportSummaries>.some(
        run SemanticCache.openImports(directory, Bytes.asSlice(&stamped)),
      )
    }
  }

  // Git dependencies are fetched into the checkout store before loading, which only reads it.
  let attempted = if let Option<&CompilationRequest>.Some { value: request } = explicit {
    run Effect.result<
      Opened,
      HostInputError
        | FileError
        | InvalidModulePath
        | InvalidSourceRoot
        | InvalidDependency
        | MissingManifest
        | InvalidBuildComposition
        | MissingStandardLibrary
        | InvalidNativeLinkInput
        | TomlError
        | RegistrationClosed
        | ConflictingPackageSource
        | Cycle
        | RevisionMismatch
        | OutOfMemoryError
    >(
      Analyses.openRequest(
        request,
        profile,
        move bindings,
        mode,
        move summaries,
        Option<SourceSnapshot>.some(Intrinsic.replace(snapshot.*, ModuleSourceFiles.snapshot())),
      ),
    )
  } else {
    let checkoutStore = run GitCheckouts.store()
    run Effect.result<
      Opened,
      HostInputError
        | FileError
        | InvalidModulePath
        | InvalidSourceRoot
        | InvalidDependency
        | MissingManifest
        | InvalidBuildComposition
        | MissingStandardLibrary
        | InvalidNativeLinkInput
        | TomlError
        | RegistrationClosed
        | ConflictingPackageSource
        | Cycle
        | RevisionMismatch
        | OutOfMemoryError
    >(
      Analyses.open(
        sourcePath,
        move manifest,
        move standardLibrary,
        borrowedPath(&checkoutStore),
        profile,
        move bindings,
        testing,
        mode,
        move alias,
        move summaries,
        Option<SourceSnapshot>.some(Intrinsic.replace(snapshot.*, ModuleSourceFiles.snapshot())),
        definition,
        unsandboxedTools,
        task,
        versions,
      ),
    )
  }
  let opened = match move attempted {
    Result<
      Opened,
      HostInputError
        | FileError
        | InvalidModulePath
        | InvalidSourceRoot
        | InvalidDependency
        | MissingManifest
        | InvalidBuildComposition
        | MissingStandardLibrary
        | InvalidNativeLinkInput
        | TomlError
        | RegistrationClosed
        | ConflictingPackageSource
        | Cycle
        | RevisionMismatch
        | OutOfMemoryError
    >.Success {
      value
    } => move value
    Result<
      Opened,
      HostInputError
        | FileError
        | InvalidModulePath
        | InvalidSourceRoot
        | InvalidDependency
        | MissingManifest
        | InvalidBuildComposition
        | MissingStandardLibrary
        | InvalidNativeLinkInput
        | TomlError
        | RegistrationClosed
        | ConflictingPackageSource
        | Cycle
        | RevisionMismatch
        | OutOfMemoryError
    >.Failure {
      error
    } => {
      run Progress.refuse(&mut progress.*, usize.ONE)
      return Prepared.Finished { status: run report(move error) }
    }
  }
  return match move opened {
    Opened.Ready { analysis: ready } => {
      let mut analysis = move ready
      let notes = ModuleSourceFiles.versionNotes(&analysis.sources)
      let mut note = usize.ZERO
      while note < notes.length {
        run writeError(b"silk: warning: --ignore-silk-version builds ")
        run writeError(Bytes.asSlice(&notes[note]))
        run writeError(b"\n")
        note = note + usize.ONE
      }

      if let Option<SourceSnapshot>.Some { value: held } = move ModuleSourceFiles.takeSnapshot(
        &mut analysis.sources,
      ) {
        snapshot.* = move held
      }
      if let Option<&Path>.Some { value: directory } = &imports {
        if let Option<ImportSummaries>.Some { value: held } = move ModuleSourceFiles.takeSummaries(
          &mut analysis.sources,
        ) {
          run SemanticCache.saveImports(directory, &held)
        }
      }

      // CI sets SILK_VERIFY_MIR so every build and check it runs also verifies the lowered MIR.
      if let Option<Bytes>.Some { .. } = move run HostInput.variableNamed("SILK_VERIFY_MIR") {
        Semantic.selectMirVerification(&mut analysis.store)
      }
      if Progress.enabled(&progress.*) {
        let mut loaded = Bytes.make()
        run Progress.appendCount(&mut loaded, ModuleSourceFiles.loadedCount(&analysis.sources))
        run Bytes.append(&mut loaded, b" modules, ")
        run Progress.appendCount(&mut loaded, List<ModuleId>.length(&analysis.rootPackage))
        run Bytes.append(&mut loaded, b" in package")
        run Progress.end(&mut progress.*, Bytes.asSlice(&loaded))
      }
      return Prepared.Ready { analysis: move analysis }
    }
    Opened.InvalidProfile => run invalidBuildProfile()
    Opened.PlanRefused { sources, store, rejection, file, reason } => {
      // The build.silk's syntax errors and the rejection that refused its plan, then why.
      run Progress.refuse(&mut progress.*, usize.ONE)
      run writeError(b"silk: ")
      run writeError(Bytes.asSlice(&file))
      run writeError(b": build.silk computes no plan: ")
      run writeError(Bytes.asSlice(&reason))
      run writeError(b"\n")
      let mut status = worse(1, run reportedSyntax(&store, &sources, format, &mut out.*))
      if let Option<Shared<Rejection>>.Some { value } = &rejection {
        status = worse(status, run reportRejection(&sources, &value, format, &mut out.*))
      }
      return Prepared.Finished { status: status }
    }
    Opened.Refused { sources, store, refusal } => {
      // The refusal and the syntax errors read so far are its problems.
      let syntax = run Semantic.syntaxRejections(&store)
      run Progress.refuse(&mut progress.*, usize.ONE + List<Shared<Rejection>>.length(&syntax))
      return run refusedProfile(
        &sources,
        &store,
        move refusal,
        List<Bytes>.asSlice(&boundParameters),
        List<Bytes>.asSlice(&boundModules),
        Bytes.asSlice(&manifestFile),
        format,
        &mut out.*,
      )
    }
  }
}

// Reports why the final profile was refused, after the syntax errors of the modules read so far,
// and answers the status.
effect fn refusedProfile(
  sources: &ModuleSources,
  store: &Semantic,
  refusal: Refusal,
  boundParameters: &[Bytes],
  boundModules: &[Bytes],
  manifestFile: &[u8],
  format: &DiagnosticFormat,
  out: &mut Bytes,
) -> Prepared
  ! FileError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut Allocator {
  match move refusal {
    // A rejected `param` declaration is reported where it is written, after the syntax errors
    // of the modules read so far, which it would otherwise hide.
    Refusal.ParameterRejected { rejection } => {
      let syntaxStatus = run reportedSyntax(store, sources, format, &mut out.*)
      return Prepared.Finished {
        status: worse(syntaxStatus, run reportRejection(sources, &rejection, format, &mut out.*)),
      }
    }
    Refusal.Shape { problem } => {
      run writeError(b"silk: error[SEM0214] invalid package parameter declaration: ")
      run writeError(shapeProblemText(problem))
      run writeError(b"\n")
    }
    Refusal.DefaultRejected { rejection } => {
      let syntaxStatus = run reportedSyntax(store, sources, format, &mut out.*)
      return Prepared.Finished {
        status: worse(syntaxStatus, run reportRejection(sources, &rejection, format, &mut out.*)),
      }
    }
    Refusal.Profile { problem } => {
      run writeError(b"silk: error[SEM0214] invalid package parameters: ")
      run writeError(profileProblemText(problem))
      run writeError(b"\n")
    }
    Refusal.Binding { error: refused } => {
      let line = run bindingProblem(&refused, boundParameters, boundModules, manifestFile)
      run writeError(Bytes.asSlice(&line))
    }
    Refusal.InputMismatch => {
      run writeError(b"silk: invalid package parameters\n")
    }
  }
  return Prepared.Finished {
    status: worse(1, run reportedSyntax(store, sources, format, &mut out.*)),
  }
}

// Appends the syntax errors of every module parsed so far to `out` in `format` and answers their
// worst status, 0 when there are none. A build refused before analysis still reports them.
effect fn reportedSyntax(
  store: &Semantic,
  sources: &ModuleSources,
  format: &DiagnosticFormat,
  out: &mut Bytes,
) -> i32
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let syntax = run Semantic.syntaxRejections(store)
  let malformed = List<Shared<Rejection>>.asSlice(&syntax)
  let mut status = 0
  let mut at = usize.ZERO
  while at < malformed.length {
    status = worse(status, run reportRejection(sources, &malformed[at], format, &mut out.*))
    at = at + usize.ONE
  }
  return status
}

// Reports the declaring module and parameter of a refused typed binding.
effect fn bindingProblem(
  refused: &BindingError,
  parameters: &[Bytes],
  modules: &[Bytes],
  manifest: &[u8],
) -> Bytes
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut line = Bytes.make()
  let mut parameter = Bytes.make()
  let mut module = Bytes.make()
  if refused.ordinal < parameters.length && refused.ordinal < modules.length {
    parameter = run Bytes.copy(parameters[refused.ordinal].asSlice())
    module = run Bytes.copy(modules[refused.ordinal].asSlice())
  }
  if manifest.length > usize.ZERO {
    run line.append(manifest)
    run line.append(b": ")
  } else {
    run line.append(b"silk: ")
  }
  run Bytes.append(&mut line, b"error[SEM0214] invalid package parameter binding: ")
  let reason: &'static [u8] = match refused.code {
    BindingIssue.ProhibitedProvenance => b"the binding of `{p}` has a secret, physical or runtime origin"
    BindingIssue.UnknownParameter => b"module `{m}` declares no package parameter `{p}`"
    BindingIssue.PrivateParameter => b"package parameter `{p}` is not `pub`, so it cannot be bound"
    BindingIssue.WrongType => b"the value bound to `{p}` does not have its parameter's type"
    BindingIssue.SameTierConflict => b"package parameter `{p}` is bound more than once"
  }
  let mut at = usize.ZERO
  while at < reason.length {
    if at + 2 < reason.length && reason[at] == 123 && reason[at + 2] == 125
      && reason[at + 1] == 112 {
      run Bytes.append(&mut line, Bytes.asSlice(&parameter))
      at = at + 3
    } else if at + 2 < reason.length && reason[at] == 123 && reason[at + 2] == 125
      && reason[at + 1] == 109 {
      run Bytes.append(&mut line, Bytes.asSlice(&module))
      at = at + 3
    } else {
      run Bytes.append(&mut line, &[reason[at]])
      at = at + usize.ONE
    }
  }
  run Bytes.append(&mut line, b"\n")
  return move line
}

// The parameter (or, when not `parameters`, module) each binding names, in binding order.
effect fn boundNames(bindings: &List<Supplied>, parameters: bool) -> List<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut names = List<Bytes>.make()
  let supplied = List<Supplied>.asSlice(bindings)
  let mut at = usize.ZERO
  while at < supplied.length {
    if parameters {
      run List<Bytes>.append(&mut names, run Bytes.copy(Bytes.asSlice(&supplied[at].parameter)))
    } else {
      run List<Bytes>.append(&mut names, run Bytes.copy(Bytes.asSlice(&supplied[at].module)))
    }
    at = at + usize.ONE
  }
  return move names
}

// Why the root package's `param` declarations cannot form a parameter schema.
fn shapeProblemText(problem: ShapeProblem) -> &'static [u8] {
  return match problem {
    ShapeProblem.InvalidHeader => b"a parameter must be a module-level `param name: Type = default` with a default value"
    ShapeProblem.UnsupportedType => b"a parameter's type is not supported for package parameters"
    ShapeProblem.InvalidExtent => b"a parameter's array extent is invalid"
    ShapeProblem.RecursiveShape => b"a parameter's type is recursive"
    ShapeProblem.InvalidMember => b"a parameter's type has a member that cannot be a parameter"
  }
}

// Why the selected parameter values cannot form the build's final profile.
fn profileProblemText(problem: ProfileProblem) -> &'static [u8] {
  return match problem {
    ProfileProblem.MissingParameter => b"a parameter has neither a default nor a binding"
    ProfileProblem.DuplicateParameter => b"a parameter is bound more than once"
    ProfileProblem.UnknownParameter => b"a binding names no declared parameter"
    ProfileProblem.WrongType => b"a default or binding has the wrong type"
    ProfileProblem.InvalidShape => b"a value does not fit its parameter's type"
    ProfileProblem.PredicateNotChecked => b"a parameter's `where` predicate could not be checked"
    ProfileProblem.ResourceSafetyNotChecked => b"enum, struct, union and optional parameter types are not supported yet"
  }
}

// The Clang arguments of the profile facts LLVM text does not carry: each selected CPU feature, a
// CPU model other than the default, a large code model, and for a linked executable a static,
// non-position-independent link, or code that is not position independent when the profile's
// relocation is static. `compileIrIn` links such an executable without PIE.
// Profile-guided optimization (#2568). SILK_PROFILE_GENERATE names the directory an instrumented
// build writes its raw profiles to, and SILK_PROFILE_USE the merged `.profdata` (from
// `llvm-profdata merge`) an optimized build reads. Clang reads the profile itself, so its digest
// joins the flags as an unused define: a new profile then recompiles every codegen unit and relinks.
effect fn appendProfileGuidance(flags: &mut List<Bytes>) -> ()
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut FileSystem | &mut HostInput | &mut Allocator {
  let mut guided = false
  if let Option<Bytes>.Some { value: directory } = move run HostInput.variableNamed(
    "SILK_PROFILE_GENERATE",
  ) {
    let mut flag = run Bytes.copy(b"-fprofile-generate=")
    run Bytes.append(&mut flag, Bytes.asSlice(&directory))
    run List<Bytes>.append(&mut flags.*, move flag)
    guided = true
  }
  if let Option<Bytes>.Some { value: recorded } = move run HostInput.variableNamed(
    "SILK_PROFILE_USE",
  ) {
    let mut flag = run Bytes.copy(b"-fprofile-use=")
    run Bytes.append(&mut flag, Bytes.asSlice(&recorded))
    run List<Bytes>.append(&mut flags.*, move flag)

    // Code the training run never reached, or that changed since, is expected, not a problem.
    run List<Bytes>.append(&mut flags.*, run Bytes.copy(b"-Wno-profile-instr-unprofiled"))
    run List<Bytes>.append(&mut flags.*, run Bytes.copy(b"-Wno-profile-instr-out-of-date"))
    let path = run Path.fromBytes(Bytes.asSlice(&recorded))
    let mut define = run Bytes.copy(b"-DSILK_PROFILE_DIGEST=")
    match move run Effect.result(FileSystem.readFile(&path)) {
      Result<Bytes, FileError | OutOfMemoryError>.Success { value } => {
        let digest = ContentHash.of(Bytes.asSlice(&value))
        run appendDecimal64(&mut define, digest.high)
        run Bytes.append(&mut define, b"_")
        run appendDecimal64(&mut define, digest.low)
      }
      Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
        // Clang reports the missing profile itself.
        FileError failure => {
          drop failure
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    run List<Bytes>.append(&mut flags.*, move define)
    guided = true
  }
  if guided {
    run List<Bytes>.append(&mut flags.*, run Bytes.copy(b"-Wno-unused-command-line-argument"))
  }
  return ()
}

effect fn clangProfileFlags(
  profile: &InitialProfile,
  maxMemory: Option<u64>,
  stackSize: Option<u64>,
  target: &Target,
  linked: bool,
) -> List<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut flags = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < Target.featureCount(target) {
    let feature = Target.feature(target, at)
    let selected = match move InitialProfile.contains(profile, b"cpu-features", feature) {
      Option<bool>.Some { value } => value
      Option<bool>.None => false
    }
    if selected {
      let mut enabled = run Bytes.copy(b"+")
      run Bytes.append(&mut enabled, feature)
      run List<Bytes>.append(&mut flags, run Bytes.copy(b"-Xclang"))
      run List<Bytes>.append(&mut flags, run Bytes.copy(b"-target-feature"))
      run List<Bytes>.append(&mut flags, run Bytes.copy(b"-Xclang"))
      run List<Bytes>.append(&mut flags, move enabled)
    }
    at = at + usize.ONE
  }

  // A native build always names its CPU. Clang would otherwise pick its own for the triple
  // (`apple-m1` on macOS), which a ThinLTO link's code generator does not know: the units would be
  // optimized for more than the link generates code for, and code a function compiles for its
  // `features` would be inlined into callers that cannot select it.
  if !same(Target.objectFormat(target), b"wasm") {
    let mut cpu = Target.defaultCpu(target)
    if let Option<&[u8]>.Some { value } = move InitialProfile.text(profile, b"cpu") {
      cpu = value
    }
    let mut architecture = Bytes.make()
    if same(Target.architecture(target), b"aarch64") {
      architecture = run Bytes.copy(b"-mcpu=")
    } else {
      architecture = run Bytes.copy(b"-march=")
    }
    run Bytes.append(&mut architecture, cpu)
    run List<Bytes>.append(&mut flags, move architecture)
  }
  if let Option<&[u8]>.Some { value: model } = move InitialProfile.text(profile, b"code-model") {
    if same(model, b"large") {
      run List<Bytes>.append(&mut flags, run Bytes.copy(b"-mcmodel=large"))
    }
  }
  if same(Target.objectFormat(target), b"wasm") {
    run wasmProfileFlags(&mut flags, profile, move maxMemory, move stackSize, linked)
    return move flags
  }
  if !linked {
    return move flags
  }
  let mut fixed = false
  if let Option<&[u8]>.Some { value: relocation } = move InitialProfile.text(
    profile,
    b"relocation",
  ) {
    fixed = fixedAddress(relocation, target)
  }
  if let Option<&[u8]>.Some { value: link } = move InitialProfile.text(profile, b"link") {
    // A static executable is never position independent, so its code is not either.
    if same(link, b"static") {
      run List<Bytes>.append(&mut flags, run Bytes.copy(b"-static"))
      fixed = true
    }
  }
  if fixed {
    run List<Bytes>.append(&mut flags, run Bytes.copy(b"-fno-pic"))
  }
  return move flags
}

// Whether a Linux executable built with `relocation` loads at a fixed address; macOS loads every
// executable position independent, whatever the profile says. Position-independent
// code reaches a jump table through a base address it loads first, and that base competes for
// registers with the values of the loop around the switch: a bytecode interpreter's dispatch runs
// about 9% fewer instructions without it.
fn fixedAddress(relocation: &[u8], target: &Target) -> bool {
  return same(relocation, b"static") && same(Target.operatingSystem(target), b"linux")
}

// The wasm32 flags of a profile. Every profile compiles with bulk memory, which inline copies and
// fills need and Clang's generic wasm CPU enables only from Clang 19. A multi-threaded profile
// also compiles with atomics, and links one shared memory the host imports into every thread's
// instance, with the wasi-threads entry exported. A shared memory needs a maximum, which
// `max-memory` sets and is otherwise 1 GiB; a module with its own memory has a maximum only when
// `maxMemory` sets one. The main stack is `stackSize` bytes, which `stack-size` sets and is
// otherwise 1 MiB, the size the runtime gives each new thread.
effect fn wasmProfileFlags(
  flags: &mut List<Bytes>,
  profile: &InitialProfile,
  maxMemory: Option<u64>,
  stackSize: Option<u64>,
  linked: bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut threaded = false
  if let Option<&[u8]>.Some { value: threading } = move InitialProfile.text(profile, b"threading") {
    threaded = same(threading, b"multi")
  }
  run List<Bytes>.append(&mut flags.*, run Bytes.copy(b"-mbulk-memory"))
  if threaded {
    run List<Bytes>.append(&mut flags.*, run Bytes.copy(b"-matomics"))
  }
  if !linked {
    return ()
  }
  let mut stack = run Bytes.copy(b"-Wl,-z,stack-size=")
  let stackBytes = match move stackSize {
    Option<u64>.Some { value } => value
    Option<u64>.None => WasmLink.defaultStackSize()
  }
  run appendDecimal64(&mut stack, stackBytes)
  run List<Bytes>.append(&mut flags.*, move stack)
  let mut limit = move maxMemory
  if threaded {
    run List<Bytes>.append(&mut flags.*, run Bytes.copy(b"-Wl,--shared-memory"))
    run List<Bytes>.append(&mut flags.*, run Bytes.copy(b"-Wl,--import-memory"))
    run List<Bytes>.append(&mut flags.*, run Bytes.copy(b"-Wl,--export=wasi_thread_start"))
    if let Option<u64>.None = &limit {
      limit = Option<u64>.some(1073741824)
    }
  }
  if let Option<u64>.Some { value: bytes } = move limit {
    let mut flag = run Bytes.copy(b"-Wl,--max-memory=")
    run appendDecimal64(&mut flag, bytes)
    run List<Bytes>.append(&mut flags.*, move flag)
  }
  return ()
}

// The text of the linked `module` for a `wasm-text` build (`WasmText.print`), or none after
// reporting why the printer refused it.
effect fn printedModule(module: &[u8]) -> Option<Bytes>
  ! OutOfMemoryError | WriterError
  ? &mut Allocator {
  let _printing = Profiler.zone(b"printWasmText")
  return match move run WasmText.print(module) {
    Printed.Text { text } => Option<Bytes>.some(move text)
    Printed.Refused { offset, detail } => {
      let mut message = run Bytes.copy(
        b"silk: cannot print the linked module as WebAssembly text: ",
      )
      run Bytes.append(&mut message, Bytes.asSlice(&detail))
      run Bytes.append(&mut message, b" (byte ")
      run appendDecimal64(&mut message, usize.toU64(offset))
      run Bytes.append(&mut message, b")\n")
      run writeError(Bytes.asSlice(&message))
      Option<Bytes>.none()
    }
  }
}

// What a direct link needs from the profile.
struct DirectSettings {
  // The memory's maximum in bytes, or 0 for the default.
  maxMemory: u64,
  // The main stack's size in bytes, or 0 for the default.
  stackSize: u64,
  // `threading = "multi"`: a shared memory and atomics (`WasmLink.Options`).
  threaded: bool,
  // A wasip2 component is a command, started through `_start`, rather than a reactor.
  command: bool,
  // A `wasm-text` build: the core module's text is written in place of the module.
  printed: bool,
}

// Wraps the core `module` in a wasip2 component (`WasiTools.component`) and publishes it at
// `output` in one rename; answers the tools' status.
effect fn publishComponent(
  module: &[u8],
  output: &Path,
  world: &WasiTools.World,
  command: bool,
) -> i32
  ! FileError | WriterError | OutOfMemoryError | HostInputError | ProcessError
  ? &mut FileSystem | &mut Allocator | &mut HostInput | &mut ChildProcess {
  let mut coreName = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut coreName, b".core.wasm")
  let core = run Path.fromBytes(Bytes.asSlice(&coreName))
  let mut componentName = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut componentName, b".component.wasm")
  let staged = run Path.fromBytes(Bytes.asSlice(&componentName))
  run FileSystem.writeFile(&core, module)
  let status = run WasiTools.component(&core, &staged, world, command)
  run removeQuietly(&core)
  if status != 0 {
    run removeQuietly(&staged)
    return status
  }
  if !run HostRename.replaceFile(&staged, output) {
    run removeQuietly(&staged)
    run writeError(b"silk: cannot write ")
    run writeError(Path.rawBytes(output))
    run writeError(b"\n")
    return 2
  }
  return 0
}

// Links the program `text` with the direct backend and writes the module to `output`, or refuses
// what it cannot build yet; answers the build's status.
effect fn linkDirect(
  text: &Bytes,
  output: &Path,
  target: &Target,
  form: Form,
  stage: Stage,
  settings: DirectSettings,
  world: &WasiTools.World,
  explicit: Option<&CompilationRequest>,
  compiler: &Option<Bytes>,
  functionNames: &FunctionNames,
  plan: &EmissionPlan,
  sources: &ModuleSources,
  heading: &Option<Bytes>,
  headed: &mut bool,
  progress: &mut Progress,
) -> i32
  ! FileError | WriterError | OutOfMemoryError | HostInputError | ProcessError
  ? &mut FileSystem | &mut Allocator | &mut HostInput | &mut ChildProcess {
  if (form != Form.Executable && form != Form.SharedLibrary) || stage != Stage.Final {
    run writeHeaded(
      heading,
      &mut headed.*,
      b"silk: the direct backend builds linked wasm32 modules only; use --backend llvm for this output\n",
      &mut progress.*,
    )
    return 2
  }
  let maxMemory = settings.maxMemory
  let stackSize = settings.stackSize
  let threaded = settings.threaded

  // A wasip2 component wraps the Preview 1 core module the link writes, as an LLVM build's does.
  // A `wasm-text` build prints the core module.
  let component = Target.id(target) == TargetId.Wasm32Wasip2 && !settings.printed
  let _linking = Profiler.zone(b"linkDirect")
  let wasi = same(Target.operatingSystem(target), b"wasi")

  // A debug build names its functions as the source does (`WasmNames`).
  let named = FunctionNames.length(functionNames) > usize.ZERO
  let mut options = WasmLink.Options {
    wasi: wasi,
    maxMemory: maxMemory,
    stackSize: stackSize,
    named: named,
    threaded: threaded,
    wide: Target.pointerBits(target) == 64,
    importMemory: threaded,
    sharedMemory: threaded,
    exportTable: false,
    command: settings.command,
  }
  if let Option<&CompilationRequest>.Some { value: request } = explicit {
    if let Option<RequestWasm>.Some { value } = &request.wasm {
      options.importMemory = value.importMemory
      options.sharedMemory = value.sharedMemory
      options.exportTable = value.exportTable
      options.command = value.executionModel.view() == "command"
    }
  }
  let units = run CodegenCache.directoryFor(output)
  match move run Effect.result(WasmLink.link(Bytes.asSlice(text), options)) {
    Result<Linked, Unsupported | OutOfMemoryError>.Success { value } => {
      let mut module = move value.output
      if named {
        if let Option<Bytes>.Some { value: renamed } = move run WasmNames.rename(
          Bytes.asSlice(&module),
          functionNames,
        ) {
          module = move renamed
        }
      }

      // A debug browser module maps its code to the source in `<output>.map` (`WasmDebug`), as
      // the LLVM backend's does.
      if named && same(Target.operatingSystem(target), b"freestanding") && !settings.printed {
        let outputName = Path.rawBytes(output)
        let mut nameStart = outputName.length
        while nameStart > usize.ZERO && outputName[nameStart - usize.ONE] != 47 {
          nameStart = nameStart - usize.ONE
        }
        let mut mapName = run Bytes.copy(
          Slice.view<u8>(outputName, nameStart, outputName.length - nameStart),
        )
        run Bytes.append(&mut mapName, b".map")
        let mut mapPath = run Bytes.copy(outputName)
        run Bytes.append(&mut mapPath, b".map")
        let map = run directSourceMap(
          List<u64>.asSlice(&value.lines),
          List<Bytes>.asSlice(&value.symbols),
          plan,
          sources,
        )
        run FileSystem.writeFile(&run Path.fromBytes(Bytes.asSlice(&mapPath)), Bytes.asSlice(&map))
        run WasmDebug.appendMapUrl(&mut module, Bytes.asSlice(&mapName))
      }
      if settings.printed {
        module = match move run printedModule(Bytes.asSlice(&module)) {
          Option<Bytes>.Some { value: printedText } => move printedText
          Option<Bytes>.None => {
            return 2
          }
        }
      }
      if component {
        let status = run publishComponent(Bytes.asSlice(&module), output, world, settings.command)
        if status != 0 {
          return status
        }
        // An unchanged module is left alone, so a build that changes nothing writes nothing.
      } else if !run holds(output, Bytes.asSlice(&module)) {
        run FileSystem.writeFile(output, Bytes.asSlice(&module))
      }

      // The link reads nothing outside the build, so the build can be recorded for reuse
      // (`recordBuild`), and no other backend's stamp stays to describe this output. A component
      // also reads the WASI tools, so it relinks every time.
      if component {
        run CodegenCache.forgetLink(&units)
        return 0
      }
      let mut command = run Bytes.copy(b"silk direct link ")
      run Bytes.append(&mut command, Target.name(target))
      if threaded {
        run Bytes.append(&mut command, b" threads")
      }
      if settings.printed {
        run Bytes.append(&mut command, b" wasm-text")
      }
      run CodegenCache.recordLink(&units, Bytes.asSlice(&command), output)
      return 0
    }
    Result<Linked, Unsupported | OutOfMemoryError>.Failure { error } => match move error {
      Unsupported refused => {
        let mut message = run Bytes.copy(
          b"silk: the direct backend cannot build this program yet: ",
        )
        run Bytes.append(&mut message, Bytes.asSlice(&refused.detail))
        run Bytes.append(&mut message, b"\n")
        run writeHeaded(heading, &mut headed.*, Bytes.asSlice(&message), &mut progress.*)
        return 2
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// The source map of a direct link's `lines` (`WasmLink.Linked`): each body's places in the file of
// the module that declares it, with each file's text.
effect fn directSourceMap(
  lines: &[u64],
  bodies: &[Bytes],
  plan: &EmissionPlan,
  sources: &ModuleSources,
) -> Bytes
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut table = LineTable.make()
  let mut modules = List<ModuleId>.make()
  let mut files = List<usize>.make()

  // The source of the body each row is in, found once per body.
  let mut lastBody = u64.MAX
  let mut source = usize.MAX

  // Where the body's declaration starts, which its places are counted from.
  let mut origin: u64 = 0
  let mut at = usize.ZERO
  while at + 2 < lines.length {
    if lines[at + usize.ONE] != lastBody {
      lastBody = lines[at + usize.ONE]
      source = usize.MAX
      origin = 0
      let identity = EmissionPlan.identityOfSymbol(
        plan,
        Bytes.asSlice(&bodies[u64.toUsize(lastBody)]),
      )
      if identity != usize.MAX {
        origin = EmissionPlan.identityOrigin(plan, identity)
        let owner = DeclarationId.moduleId(EmissionPlan.identityDeclaration(plan, identity))
        let known = List<ModuleId>.asSlice(&modules)
        let mut file = usize.ZERO
        while file < known.length && !ModuleId.equals(&known[file], owner) {
          file = file + usize.ONE
        }
        if file == known.length {
          let location = run ModuleSourceFiles.sourceLocation(sources, owner)
          let mut path = Bytes.make()
          if let Option<Path>.Some { value: found } = &location.path {
            path = run Bytes.copy(Path.rawBytes(&found))
          }
          run List<ModuleId>.append(&mut modules, ModuleId.copy(owner))
          run List<usize>.append(
            &mut files,
            run LineTable.addSource(&mut table, Bytes.asSlice(&path)),
          )
        }
        source = List<usize>.get(&files, file)
      }
    }
    let place = absolutePlace(origin, lines[at + 2])
    if source == usize.MAX || place == 0 {
      run LineTable.addRow(&mut table, u64.toUsize(lines[at]), usize.ZERO, usize.ZERO, usize.ZERO)
    } else {
      run LineTable.addRow(
        &mut table,
        u64.toUsize(lines[at]),
        source,
        u64.toUsize(u64.shiftRight(place, 24)),
        u64.toUsize(place & 16777215),
      )
    }
    at = at + 3
  }
  let mut contents = List<Option<Bytes>>.make()
  let paths = LineTable.paths(&table)
  at = usize.ZERO
  while at < paths.length {
    run List<Option<Bytes>>.append(&mut contents, run readable(Bytes.asSlice(&paths[at])))
    at = at + usize.ONE
  }
  return run WasmDebug.sourceMap(&table, List<Option<Bytes>>.asSlice(&contents))
}

// Gives up `value` without dropping it, for a process about to exit: what it owns is left for the
// exit to return.
effect fn abandonValue<T>(value: T) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let layout = Layout.of<T>()
  let recipe = Allocator.allocate(move layout)
  let allocation = run recipe
  unsafe {
    let mut buffer = RawBuffer.from<T>(move allocation, usize.ONE)
    Slot.write<T>(RawBuffer.slot<T>(&mut buffer, usize.ZERO), move value)
  }
  return ()
}

// Appends `value` in decimal.
effect fn appendDecimal64(text: &mut Bytes, value: u64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value >= 10 {
    run appendDecimal64(&mut text.*, value / 10)
  }
  return run Bytes.append(&mut text.*, &[u64.toU8(48 + value % 10)])
}

effect fn appendDecimal(text: &mut Bytes, value: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value >= 10 {
    run appendDecimal(&mut text.*, usize.divide(value, 10))
  }
  return run Bytes.append(&mut text.*, &[usize.toU8(48 + usize.remainder(value, 10))])
}

// Writes to standard output the listing of each function `store` lowered: those declared in the
// package of `rootPackage`, or with `all`, every one.
effect fn writeMir(store: &Semantic, rootPackage: &[ModuleId], all: bool) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Allocator {
  let emitted = Semantic.emittedMir(store)
  let mut text = Bytes.make()
  let mut at = usize.ZERO
  while at < emitted.length {
    let index = emitted[at]
    at = at + usize.ONE
    let function = match move Semantic.mirAt(store, index) {
      Option<&MirFunction>.Some { value } => value
      Option<&MirFunction>.None => {
        continue
      }
    }
    if !all {
      if rootPackage.length == usize.ZERO {
        continue
      }
      let declaration = DeclarationId.copyShared(&InstanceKey.identity(&function.key))
      if !ModuleId.samePackage(DeclarationId.moduleId(&declaration), &rootPackage[usize.ZERO]) {
        continue
      }
    }
    run MirText.append(function, &mut text)
  }
  let mut stdout = StdoutWriter.make()
  return run Writer.writeAll(Bytes.asSlice(&text)) |> Effect.provideMut<Writer>(&mut stdout)
}

// How many copies of the process a cold build shares its walk between (`Semantic.shareWalks`):
// one per processor the process may run on that the memory holds a build for, and no more than
// eight. `SILK_WALK_WORKERS` names another count; one shares nothing.
effect fn walkWorkers() -> usize
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  if let Option<Bytes>.Some { value: named } = move run HostInput.variableNamed(
    "SILK_WALK_WORKERS",
  ) {
    let digits = Bytes.asSlice(&named)
    let mut count = usize.ZERO
    let mut at = usize.ZERO
    while at < digits.length && at < 4 && digits[at] >= 48 && digits[at] <= 57 {
      count = count * 10 + u8.toUsize(digits[at] - 48)
      at = at + usize.ONE
    }
    if at > usize.ZERO && at == digits.length {
      return count
    }
  }

  // Each copy holds what it lowers; the whole build's memory bounds them together.
  let jobs = run MemberChecks.jobs(MemberChecks.CHECK_BYTES / 4)
  if jobs > 8 {
    return 8
  }
  return jobs
}

effect fn build(
  sourcePath: &Path,
  manifest: Option<&Path>,
  cacheDirectory: Option<&Path>,
  output: &Path,
  display: &Path,
  form: Form,
  requestedStage: Stage,
  standardLibrary: Option<Path>,
  profile: InitialProfile,
  maxMemory: Option<u64>,
  stackSize: Option<u64>,
  bindings: List<Supplied>,
  supplyRequest: &SupplyRequest,
  testing: bool,
  stats: bool,
  clang: &Option<Bytes>,
  heading: &Option<Bytes>,
  alias: Option<&[u8]>,
  knownCompiler: Option<Bytes>,
  abandon: bool,
  progress: &mut Progress,
  warned: &mut Bytes,
  mir: MirListing,
  ignoreWarnings: bool,
  shareWalk: bool,
  incoming: Option<&CompilationRequest>,
  unsandboxedTools: bool,
  publication: Option<Path>,
  task: bool,
  versions: Versions,
) -> Compiled
  ! ApplicationError
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  let _zone = Profiler.zone(b"build")
  let target = Target.forId(Target.id(InitialProfile.target(&profile)))

  // A `wasm-text` build links its module as a final build does, then writes the module's text
  // (`WasmText.print`) in place of its bytes.
  let printed = requestedStage == Stage.WasmText
  let mut stage = requestedStage
  if printed {
    if form != Form.Executable || !same(Target.objectFormat(&target), b"wasm") {
      run writeError(b"silk: --emit wasm-text needs a wasm32 or wasm64 executable\n")
      return Compiled.Finished { status: 2 }
    }
    stage = Stage.Final
  }
  let mut world = WasiTools.World { wit: Option<Path>.none(), name: Bytes.make() }
  if Target.id(&target) == TargetId.Wasm32Wasip2 {
    if let Option<&CompilationRequest>.Some { value: request } = incoming {
      if let Option<RequestWasm>.Some { value: wasm } = &request.wasm {
        if let Option<String>.Some { value: wit } = &wasm.wit {
          world.wit = Option<Path>.some(run Path.make(wit.view()))
        }
        if let Option<String>.Some { value: name } = &wasm.world {
          world.name = run Bytes.copy(String.ownedUtf8Bytes(&name))
        }
      }
      if world.name.length() == usize.ZERO || world.wit.isNone() {
        run writeError(
          b"silk: a component compilation request must supply wasm.wit and wasm.world\n",
        )
        return Compiled.Finished { status: 2 }
      }
    } else if manifest.isNone() {
      world = run WasiTools.commandWorld(&standardLibrary)
    } else {
      let directory = match move run Path.parent(sourcePath) {
        Option<Path>.Some { value } => move value
        Option<Path>.None => {
          fail InvalidSourceRoot {}
        }
      }
      let mut selectedManifest = Option<Bytes>.none()
      if let Option<&Path>.Some { value: path } = &manifest {
        selectedManifest = Option<Bytes>.some(run Bytes.copy(Path.rawBytes(path)))
      }
      if let Option<Project>.Some { value: project } = move run locateProject(
        &directory,
        &selectedManifest,
      ) {
        if testing {
          world = run WasiTools.commandWorld(&standardLibrary)
        } else {
          world = run WasiTools.world(&project, &standardLibrary)
        }
      } else {
        return Compiled.Finished { status: 2 }
      }
    }
  }
  let optimization = match move InitialProfile.text(&profile, b"optimization") {
    Option<&[u8]>.Some { value } => run Bytes.copy(value)
    Option<&[u8]>.None => run invalidBuildProfile()
  }
  let debug = match move InitialProfile.flag(&profile, b"debug") {
    Option<bool>.Some { value } => value
    Option<bool>.None => run invalidBuildProfile()
  }
  let relocation = match move InitialProfile.text(&profile, b"relocation") {
    Option<&[u8]>.Some { value } => run Bytes.copy(value)
    Option<&[u8]>.None => run invalidBuildProfile()
  }
  let libc = match move InitialProfile.text(&profile, b"libc") {
    Option<&[u8]>.Some { value } => run Bytes.copy(value)
    Option<&[u8]>.None => run invalidBuildProfile()
  }
  let deployment = match move InitialProfile.text(&profile, b"deployment") {
    Option<&[u8]>.Some { value } => run Bytes.copy(value)
    Option<&[u8]>.None => Bytes.make()
  }

  // The direct backend lowers each instance to wasm itself (`WasmLower`) and writes the module
  // (`WasmLink`), without LLVM.
  let direct = match move InitialProfile.text(&profile, b"backend") {
    Option<&[u8]>.Some { value } => same(value, b"direct")
    Option<&[u8]>.None => false
  }
  let mut directLimit: u64 = 0
  if let Option<u64>.Some { value: limit } = &maxMemory {
    directLimit = limit
  }
  let mut directStack: u64 = 0
  if let Option<u64>.Some { value: bytes } = &stackSize {
    directStack = bytes
  }
  let directThreads = match move InitialProfile.text(&profile, b"threading") {
    Option<&[u8]>.Some { value } => same(value, b"multi")
    Option<&[u8]>.None => false
  }
  let capturedMaxMemory = maxMemory
  let capturedStackSize = stackSize
  let mut profileFlags = run clangProfileFlags(
    &profile,
    move maxMemory,
    move stackSize,
    &target,
    (form == Form.Executable || form == Form.SharedLibrary) && stage == Stage.Final,
  )
  if !same(Target.objectFormat(&target), b"wasm") {
    run appendProfileGuidance(&mut profileFlags)
  }
  if same(Target.objectFormat(&target), b"wasm") {
    if let Option<&CompilationRequest>.Some { value: request } = incoming {
      if let Option<RequestWasm>.Some { value } = &request.wasm {
        if value.sharedMemory && !hasFlag(profileFlags.asSlice(), b"-matomics") {
          run profileFlags.append(run Bytes.copy(b"-matomics"))
        }
        if stage == Stage.Final {
          if value.importMemory && !hasFlag(profileFlags.asSlice(), b"-Wl,--import-memory") {
            run profileFlags.append(run Bytes.copy(b"-Wl,--import-memory"))
          }
          if value.sharedMemory && !hasFlag(profileFlags.asSlice(), b"-Wl,--shared-memory") {
            run profileFlags.append(run Bytes.copy(b"-Wl,--shared-memory"))
            if capturedMaxMemory.isNone() {
              run profileFlags.append(run Bytes.copy(b"-Wl,--max-memory=1073741824"))
            }
          }
          if value.exportTable {
            run profileFlags.append(run Bytes.copy(b"-Wl,--export-table"))
          }
        }
      }
    }
  }
  let mut refused = Bytes.make()

  // Whether this build's `[<target>]` heading has been written before its diagnostics.
  let mut headed = false

  // A project build notes each body it could not borrow-check. Both forms print diagnostics as
  // `check` does; under SILK_RECEIPTS the single-source form instead writes borrow-check counts
  // as receipts and diagnostics as `SILK_BUILD_ERROR` records for the corpus harness and
  // self-build.
  let receipts = match &manifest {
    Option<&Path>.Some { .. } => false
    Option<&Path>.None => true
  }

  // The single-source borrow-check counts are receipts for the corpus harness and the self-build,
  // which set SILK_RECEIPTS; without it a successful build prints only its own output.
  let mut counted = false
  if receipts {
    if let Option<Bytes>.Some { value } = move run HostInput.variableNamed("SILK_RECEIPTS") {
      counted = Bytes.length(&value) > usize.ZERO
    }
  }
  let mut root = Bytes.make()
  if let Option<&Path>.Some { value } = &manifest {
    root = run diagnosticRoot(value)
  }
  let mut machine = DiagnosticFormat.Human { root: move root }
  if counted {
    machine = DiagnosticFormat.Machine
  }

  // A project build records dependencies for the cache file `silk check`
  // keeps for the same target and profile, so an unchanged module's checks are reused and the
  // last build's record replays (see `Semantic.replayBuild`).
  // The compiler's identity, read once: a caller that already read it passes it as `knownCompiler`.
  let mut compiler = move knownCompiler
  if let Option<&Path>.Some { .. } = &cacheDirectory {
    if let Option<Bytes>.None = &compiler {
      compiler = run CacheStamp.compiler()
    }
  } else {
    compiler = Option<Bytes>.none()
  }
  let mut mode = StoreMode.Transient
  if let Option<Bytes>.Some { .. } = &compiler {
    mode = StoreMode.Cached
  }
  let mut imports = Option<&Path>.none()
  if let Option<&Path>.Some { value: directory } = &cacheDirectory {
    imports = Option<&Path>.some(directory)
  }

  // The cache file is read and decoded while the sources load.
  let mut prefetched = Option<SemanticCache.Prefetch>.none()
  if let Option<&Path>.Some { value: directory } = &cacheDirectory {
    if mode == StoreMode.Cached {
      let mut identity = Bytes.make()
      run InitialProfile.appendIdentity(&profile, &mut identity)
      prefetched = run SemanticCache.prefetch(directory, true, Bytes.asSlice(&identity))
    }
  }
  let mut snapshot = ModuleSourceFiles.snapshot()
  let prepared = run prepare(
    sourcePath,
    move manifest,
    move standardLibrary,
    &profile,
    move bindings,
    testing,
    mode,
    move alias,
    move imports,
    &compiler,
    &mut snapshot,
    &machine,
    &mut refused,
    &mut progress.*,
    incoming,
    Option<&CompilationDefinition>.none(),
    unsandboxedTools,
    task,
    versions,
  )
  run writeHeaded(heading, &mut headed, Bytes.asSlice(&refused), &mut progress.*)
  let mut analysis = match move prepared {
    Prepared.Ready { analysis } => move analysis
    Prepared.Finished { status } => {
      return Compiled.Finished { status: status }
    }
  }
  let mut capturedRequest = Option<CompilationRequest>.none()
  if let Option<&CompilationRequest>.None = incoming {
    let directory = match move publication {
      Option<Path>.Some { value } => move value
      Option<Path>.None => {
        let parent = match move run Path.parent(output) {
          Option<Path>.Some { value } => move value
          Option<Path>.None => {
            fail InvalidSourceRoot {}
          }
        }
        run Path.join(&parent, "requests")
      }
    }
    let emit = match requestedStage {
      Stage.Final => "final"
      Stage.LlvmIr => "llvm-ir"
      Stage.LlvmBitcode => "llvm-bitcode"
      Stage.Assembly => "assembly"
      Stage.Object => "object"
      Stage.WasmText => "wasm-text"
    }
    let name = run RequestCapture.artifactLabel(output, &profile, testing, emit)
    let optimization = match move InitialProfile.text(&profile, b"optimization") {
      Option<&[u8]>.Some { value } => value
      Option<&[u8]>.None => {
        fail InvalidSourceRoot {}
      }
    }
    let filename = run CompilationRequest.requestFileName(
      name.view(),
      unsafe Intrinsic.stringFromUtf8Unchecked(Target.name(&target)),
      unsafe Intrinsic.stringFromUtf8Unchecked(optimization),
    )
    let mut generatedName = run String.copy(filename.view())
    run generatedName.append(".sources")
    let generated = run Path.join(&directory, generatedName.view())
    let mut captured = run RequestCapture.make(
      &analysis.sources,
      sourcePath,
      output,
      &generated,
      &profile,
      capturedMaxMemory,
      capturedStackSize,
      testing,
      emit,
    )
    run RequestCapture.platform(&mut captured, supplyRequest)
    if Target.id(&target) == TargetId.Wasm32Wasip2 {
      run RequestCapture.wasm(&mut captured, &world)
    }
    run RequestParameters.capture(
      &mut captured,
      &analysis.sources,
      &mut analysis.store,
      &mut analysis.request,
    )
    let path = run Path.join(&directory, filename.view())
    if let Option<Bytes>.Some { value: failure } = move run NativeArchives.ensure(
      ModuleSourceFiles.archives(&analysis.sources),
      ModuleSourceFiles.nativeLinkInputs(&analysis.sources),
    ) {
      run writeError(failure.asSlice())
      return Compiled.Finished { status: 2 }
    }
    if !run capturePlatform(&mut captured, &profile) {
      return Compiled.Finished { status: 2 }
    }
    run RequestCapture.write(&captured, &path)
    capturedRequest = Option<CompilationRequest>.some(move captured)
  }

  // Every frontend supplies the same resolved request to code generation. Reuse the parsed
  // analysis that produced it instead of loading and checking the identical graph a second time.
  let resolvedCompilation = match &capturedRequest {
    Option<CompilationRequest>.Some { value } => &value
    Option<CompilationRequest>.None => match incoming {
      Option<&CompilationRequest>.Some { value } => value
      Option<&CompilationRequest>.None => {
        fail InvalidSourceRoot {}
      }
    }
  }
  let explicit = Option<&CompilationRequest>.some(resolvedCompilation)
  let capturedSupply = run requestSupply(resolvedCompilation)
  let Analysis {
    sources,
    store: analyzed,
    request: requested,
    rootPackage,
    checked,
    identity,
    runtime
  } = move analysis
  let mut store = move analyzed
  let mut request = move requested
  let mut cache = Option<CacheFile>.none()

  // The cache directories of the packages an executable loads, which its build record is filed
  // under for the next program that loads them (`SemanticCache.rememberBuild`).
  let mut loadedCaches = List<Path>.make()
  if let Option<&Path>.Some { value: directory } = &cacheDirectory {
    if let Option<Bytes>.Some { value: stamped } = &compiler {
      // A package's cache directory is `cache/<package>` below the output directory.
      let mut dependencies = List<Path>.make()
      if let Option<Path>.Some { value: caches } = move run Path.parent(directory) {
        if let Option<Path>.Some { value: outputDirectory } = move run Path.parent(&caches) {
          dependencies = run dependencyCaches(&outputDirectory, &sources)
          if let Option<ModuleId>.Some { .. } = &runtime {
            loadedCaches = run packageCaches(&outputDirectory, &sources)
          }
        }
      }
      run Progress.begin(&mut progress.*, ProgressPhase.Cache, usize.ZERO)
      cache = run SemanticCache.openPrefetched(
        &mut store,
        &request,
        directory,
        Bytes.asSlice(&stamped),
        false,
        true,
        move prefetched,
        List<Path>.asSlice(&dependencies),
        List<Path>.asSlice(&loadedCaches),
      )
      run endCacheRow(&mut progress.*, &cache)
    }
  }
  let selectedRuntime: Option<&ModuleId> = match &runtime {
    Option<ModuleId>.Some { value } => Option<&ModuleId>.some(&value)
    Option<ModuleId>.None => Option<&ModuleId>.none()
  }
  let analyzing = Profiler.zone(b"buildArtifact")
  let costing = Progress.costing(&progress.*)
  Semantic.selectProgress(&mut store, Intrinsic.replace(progress.*, Progress.off()))

  // A debug executable compiles each codegen unit apart, so an edit recompiles only the units it
  // changes (see `compileUnits`); an optimized one stays one module for cross-module inlining.
  // A wasm executable splits the same way: Clang generated the whole 172 MB module of a UI page
  // on one thread in 85 s after any edit. The direct backend writes its own module.
  let packageCodegen = PackageCodegen.separate(explicit)
  let lineTables = PackageCodegen.lines(explicit, debug)
  let split = !direct
    && (packageCodegen
      || (stage == Stage.Final && form == Form.Executable
        && same(Bytes.asSlice(&optimization), b"none")))
  Semantic.selectCodegenUnits(&mut store, split)

  // Clang compiles anything but `speed` at -O0 (see `compileIrIn`).
  Semantic.selectFastPathIr(&mut store, same(Bytes.asSlice(&optimization), b"none"))

  // A test runner records which functions each test executes, so `silk test` can skip a passing
  // test none of whose functions changed (TEST-008). A build without content digests, such as a
  // one-shot build, still keeps the table, with zero digests, so the runner records nothing.
  Semantic.selectCoverage(&mut store, testing && LlvmCode.seenSection(&target).isSome())
  Semantic.selectInlining(&mut store, !same(Bytes.asSlice(&optimization), b"none"))
  Semantic.selectDirect(
    &mut store,
    direct,
    directThreads,
    same(Bytes.asSlice(&optimization), b"size"),
  )

  // A debug build's line tables come from the lines its location markers carry, counted from
  // where each declaration starts, which the cache keeps per module.
  Semantic.selectLineTables(&mut store, lineTables)
  if let Option<&CompilationRequest>.Some { value } = explicit {
    Semantic.selectPackageCodegen(&mut store, run PackageCodegen.lowering(value), debug)
  }
  if debug {
    if let Option<&Path>.Some { value: directory } = &cacheDirectory {
      if let Option<Bytes>.Some { value: stamped } = &compiler {
        run SemanticCache.openOrigins(&mut store, directory, Bytes.asSlice(&stamped))
      }
    }
  }

  // `--costs` charges each instance as one walk lowers it. Members built side by side already
  // fill the processors, so each lowers in its one process.
  Semantic.selectCosts(&mut store, costing)
  if shareWalk && !costing {
    Semantic.shareWalks(&mut store, run walkWorkers(), 2000)
  }
  let compiled = run Semantic.buildArtifact(
    &mut store,
    &mut request,
    move selectedRuntime,
    List<ModuleId>.asSlice(&rootPackage),
    List<ModuleId>.asSlice(&checked),
    staticClosureNodes,
  )
  progress.* = Semantic.takeProgress(&mut store)
  if costing {
    // Module paths are read from the entry's directory; the report names them as diagnostics do.
    let mut prefix = Bytes.make()
    if let Option<Path>.Some { value: entryDirectory } = move run Path.parent(sourcePath) {
      prefix = run shownPath(display, &entryDirectory)
      run Bytes.append(&mut prefix, b"/")
    }
    let costs = run Semantic.costReport(&mut store, 15, Bytes.asSlice(&prefix))
    run Progress.keepReport(&mut progress.*, Bytes.asSlice(&costs))
  }
  drop analyzing

  // A reached module's selected imports are checked whole as well, used or not (IMPORT-003). They
  // are checked before the cache image is written, so it holds each module whose imports are clean.
  let importRejected = run Semantic.importRejections(&mut store, &mut request)

  // A build's units are the packs its cache keeps; the image written next names them, and no
  // others are needed after it.
  // A copy of the process writes the image while the units compile and link, and the build
  // returns without waiting for it.
  if let Option<CacheFile>.Some { value: file } = &cache {
    let mut built = Option<&[CodegenUnit]>.none()
    if let BackendBuild.Module { units, .. } = &compiled {
      run SemanticCache.storePacks(&file, &store, List<CodegenUnit>.asSlice(&units))
      built = Option<&[CodegenUnit]>.some(List<CodegenUnit>.asSlice(&units))
    }
    let recorded = match &built {
      Option<&[CodegenUnit]>.Some { .. } => true
      Option<&[CodegenUnit]>.None => false
    }
    run SemanticCache.saveDetached(&mut store, &file, move built)
    if recorded {
      run SemanticCache.rememberBuild(&file, List<Path>.asSlice(&loadedCaches))
    }
    if let Option<&Path>.Some { value: directory } = &cacheDirectory {
      run saveParsed(directory, &file, &sources, &store)
    }
  }
  if debug {
    if let Option<&Path>.Some { value: directory } = &cacheDirectory {
      if let Option<Bytes>.Some { value: stamped } = &compiler {
        run SemanticCache.saveOrigins(&store, directory, Bytes.asSlice(&stamped))
      }
    }
  }
  let packs = run Semantic.takePacks(&mut store)

  // The walk leaves its last phase open: emission when it reached it, else checking.
  match &compiled {
    BackendBuild.Module { .. } => {
      run Progress.end(&mut progress.*, b"")
      run Progress.borrowRow(&mut progress.*)
    }
    BackendBuild.Unsupported { gaps } => {
      run Progress.refuse(&mut progress.*, List<Shared<Gap>>.length(&gaps))
    }
    BackendBuild.Rejected { further, .. } => {
      run Progress.refuse(&mut progress.*, usize.ONE + List<Shared<Rejection>>.length(&further))
    }
  }
  if stats {
    run writeStatistics(&Semantic.statistics(&store))
    run writeDeferredTemplates(Semantic.deferredStaticTemplates(&store))
  }
  let missed = ModuleSourceFiles.missedModule(&sources, Semantic.sourceEvents(&store))
  if missed != usize.MAX {
    let mut message = run Bytes.copy(b"silk: internal error: the build read ")
    let event = &Semantic.sourceEvents(&store)[missed]
    run ModuleId.appendPackage(&event.module, &mut message)
    run Bytes.append(&mut message, b":")
    run ModuleId.appendPath(&event.module, &mut message)
    run Bytes.append(&mut message, b" outside its preloaded import graph\n")
    run writeError(Bytes.asSlice(&message))
    return Compiled.Finished { status: 1 }
  }

  // A loaded module is parsed whole: its syntax errors reject the build even where no declaration
  // of it was demanded (MODULE-004), before any artifact is written.
  let syntax = run Semantic.syntaxRejections(&store)
  let malformed = List<Shared<Rejection>>.asSlice(&syntax)
  if malformed.length > usize.ZERO {
    let mut at = usize.ZERO
    let mut failureStatus = 2
    while at < malformed.length {
      if diagnosticStatus(&malformed[at]) == 1 {
        failureStatus = 1
      }
      run writeRejection(heading, &mut headed, &sources, &malformed[at], &machine, &mut progress.*)
      at = at + usize.ONE
    }
    return Compiled.Finished { status: failureStatus }
  }
  let mut imported = Bytes.make()
  let mut reportedImports = List<ReportedSite>.make()
  let importStatus = run reportedImportRejections(
    List<Shared<Rejection>>.asSlice(&importRejected),
    &sources,
    &machine,
    &mut imported,
    &mut reportedImports,
  )
  run writeHeaded(heading, &mut headed, Bytes.asSlice(&imported), &mut progress.*)
  if importStatus != 0 {
    return Compiled.Finished { status: importStatus }
  }
  let mut status = 0
  match move compiled {
    BackendBuild.Module { text, unchecked, plan, units: assembled } => {
      // `silk dump mir` lists the checked, lowered functions in place of the artifact.
      if mir != MirListing.Off {
        run writeMir(&store, List<ModuleId>.asSlice(&rootPackage), mir == MirListing.All)
        return Compiled.Finished { status: 0 }
      }
      let mut units = move assembled
      if packageCodegen {
        if let Option<&CompilationRequest>.Some { value } = explicit {
          run PackageCodegen.configure(&mut units, value)
        }
      }

      // The unused bindings of the root package and its path dependencies are warnings, shown when
      // the build otherwise succeeds; the corpus harness's records leave them out. A warning fails
      // the build unless `--ignore-warnings` allows it, before any artifact is written.
      if !counted {
        let warnings = run unusedReported(
          &mut store,
          &sources,
          List<ModuleId>.asSlice(&rootPackage),
        )
        let listed = List<Shared<Rejection>>.asSlice(&warnings)
        let mut at = usize.ZERO
        while at < listed.length {
          let _reported = run reportRejection(&sources, &listed[at], &machine, &mut warned.*)
          at = at + usize.ONE
        }

        // The declaration check's warnings, such as a `&mut` requirement only read (SEM0254).
        let checkedWarnings = Semantic.checkedBuildWarnings(&store)
        at = usize.ZERO
        while at < checkedWarnings.length {
          let _reported = run reportRejection(
            &sources,
            &checkedWarnings[at],
            &machine,
            &mut warned.*,
          )
          at = at + usize.ONE
        }
        run writeHeaded(heading, &mut headed, Bytes.asSlice(&warned.*), &mut progress.*)
        if !ignoreWarnings && Bytes.length(&warned.*) > usize.ZERO {
          run writeError(warningsRefused())
          return Compiled.Finished { status: 1 }
        }
      }
      if let Option<&CompilationRequest>.Some { value: compilation } = explicit {
        if let Option<String>.Some { value: header } = &compilation.header {
          let contents = run CHeader.render(&mut store, &mut request, &plan)
          let destination = run Path.make(header.view())
          if let Option<Path>.Some { value: parent } = move run Path.parent(&destination) {
            run FileSystem.createDirectoriesRecursively(&parent)
          }
          run FileSystem.writeFile(&destination, contents.asSlice())
        }
      }

      // Emit zero too: absence of a receipt cannot distinguish a fully checked build from a
      // missing measurement. The corpus harness records this line for every successful program.
      if counted {
        run writeBorrowGap(b"SILK_GAP borrow-check: ", List<usize>.asSlice(&unchecked))
      }

      // The emitted count covers only reached instances. Every root-package body was checked as
      // well, reached or not, so its unchecked count shows a body no build path reaches, and each
      // such body of a build is named, so the corpus harness can tell which diagnostics it covers.
      // A test runner's thousands of bodies would only bury its results, so it keeps the count.
      if counted {
        run writeRootBorrowGap(Semantic.uncheckedRootBodies(&store), !testing)
      }

      // With --stats, name each counted body, so two compilers' lists can be diffed.
      if stats {
        let bodies = run EmissionPlan.uncheckedBodies(&plan)
        let lines = List<Bytes>.asSlice(&bodies)
        let mut line = usize.ZERO
        while line < lines.length {
          let mut text = run Bytes.copy(b"silk-stats unchecked\t")
          run Bytes.append(&mut text, Bytes.asSlice(&lines[line]))
          run Bytes.append(&mut text, b"\n")
          run writeError(Bytes.asSlice(&text))
          line = line + usize.ONE
        }
      }

      // A debug wasm executable names its functions as the source does (`WasmNames`).
      let mut functionNames = FunctionNames.make()
      if debug && stage == Stage.Final && form == Form.Executable
        && same(Target.objectFormat(&target), b"wasm") {
        functionNames = run readableNames(&plan)
      }

      // A debug build of the whole program also carries line tables, which the direct backend
      // does not write.
      let mut debugInfo = Bytes.make()
      if debug && !split && stage != Stage.LlvmIr && !direct {
        let module = run Bitcode.programModule(Bytes.asSlice(&text))
        debugInfo = run debugInfoOf(
          &plan,
          &sources,
          &module,
          !same(Bytes.asSlice(&optimization), b"none"),
        )
      }

      // Without a runtime nothing starts the program but a C `main` the application exports or a
      // declared link input defines, so a link that would miss it is refused before Clang runs.
      let started = match &runtime {
        Option<ModuleId>.Some { .. } => true
        Option<ModuleId>.None => false
      }

      // The direct backend's text is wasm fragments, which only its own link reads.
      if direct {
        let directStatus = run linkDirect(
          &text,
          output,
          &target,
          form,
          stage,
          DirectSettings {
            maxMemory: directLimit,
            stackSize: directStack,
            threaded: directThreads,
            command: started,
            printed: printed,
          },
          &world,
          explicit,
          &compiler,
          &functionNames,
          &plan,
          &sources,
          heading,
          &mut headed,
          &mut progress.*,
        )
        if directStatus == 0 && receipts {
          run reportCompiled(
            display,
            sourcePath,
            output,
            &target,
            EmissionPlan.symbolCount(&plan),
            b"direct",
          )
        }
        return Compiled.Finished { status: directStatus }
      }
      if stage == Stage.LlvmIr && !packageCodegen {
        let mut printed = Bytes.make()
        if debug {
          // A debug build's IR shows the line tables its objects carry.
          let mut module = run Bitcode.programModule(Bytes.asSlice(&text))
          let lines = run debugInfoOf(
            &plan,
            &sources,
            &module,
            !same(Bytes.asSlice(&optimization), b"none"),
          )
          printed = run BitcodeText.printDebug(&mut module, Bytes.asSlice(&lines))
        } else {
          printed = run BitcodeText.printProgram(Bytes.asSlice(&text))
        }
        run FileSystem.writeFile(output, Bytes.asSlice(&printed))
        if receipts {
          run reportCompiled(
            display,
            sourcePath,
            output,
            &target,
            EmissionPlan.symbolCount(&plan),
            b"llvm",
          )
        }
        return Compiled.Finished { status: 0 }
      }

      // Units that only the cache asked for are not compiled apart.
      if !split {
        units = List<CodegenUnit>.make()
      }

      // An optimized executable stays one module unless its profile's `codegen-units` asks for
      // more. Then it splits by its call graph (`ReleaseUnits`), so Clang optimizes the units on
      // several threads and a ThinLTO link joins them. One module is the default because the
      // split costs run time: silkjs ran 10% slower in 16 units (regexp 26%, startup 16%) and
      // grew from 25 to 33 MB, while the compiler built 3x faster. A build with line tables stays
      // one module, whose tables `debugInfo` holds.
      if !split && form == Form.Executable && stage == Stage.Final
        && same(Bytes.asSlice(&optimization), b"speed")
        && !debug {
        let requested = u64.toUsize(InitialProfile.unitCount(&profile))
        if requested > usize.ONE {
          let partitioning = Profiler.zone(b"releaseUnits")
          // The source edited with the program: the root package's and its path dependencies'.
          let mut edited = run ModuleSourceFiles.loadedRootModules(&sources)
          let mut local = run ModuleSourceFiles.loadedLocalDependencyModules(&sources)
          while List<ModuleId>.length(&local) > usize.ZERO {
            run List<ModuleId>.append(&mut edited, List<ModuleId>.remove(&mut local, usize.ZERO))
          }
          units = run ReleaseUnits.partition(Bytes.asSlice(&text), requested, &plan, List<ModuleId>.asSlice(&edited))
          drop partitioning
        }
      }
      if form == Form.Executable && stage == Stage.Final && !started
        && !same(Target.objectFormat(&target), b"wasm")
        && ModuleSourceFiles.nativeLinkInputs(&sources).length == usize.ZERO
        && !definesMain(Bytes.asSlice(&text))
        && !unitsDefineMain(
          List<CodegenUnit>.asSlice(&units),
          List<BuildRecord.PackBody>.asSlice(&packs),
        ) {
        run writeHeaded(
          heading,
          &mut headed,
          b"silk: an executable built with runtime = { kind = \"none\" } has no `main`; export one, as `export \"C\" fn start() -> i32 as \"main\"` does, or select a runtime\n",
          &mut progress.*,
        )
        return Compiled.Finished { status: 2 }
      }

      // Only a link consumes a platform supply; compiling to an object or an intermediate stage
      // needs no SDK, so a cross-target object never runs discovery.
      let mut supply = Option<Supply>.none()
      if (form == Form.Executable || form == Form.SharedLibrary) && stage == Stage.Final {
        let resolved = run Effect.result(
          PlatformSupplies.resolve(
            &target,
            &hostTarget(),
            Bytes.asSlice(&libc),
            Bytes.asSlice(&deployment),
            ModuleSourceFiles.nativeLinkInputs(&sources).length > usize.ZERO,
            &capturedSupply,
          ),
        )
        supply = match move resolved {
          Result<
            Option<Supply>,
            SupplyError | FileError | HostInputError | OutOfMemoryError
          >.Success {
            value
          } => move value
          Result<
            Option<Supply>,
            SupplyError | FileError | HostInputError | OutOfMemoryError
          >.Failure {
            error
          } => match move error {
            SupplyError unavailable => {
              run reportSupply(&unavailable)
              return Compiled.Finished { status: 2 }
            }
            FileError failed => {
              fail move failed
            }
            HostInputError failed => {
              fail move failed
            }
            OutOfMemoryError exhausted => {
              fail move exhausted
            }
          }
        }
      }
      let _linking = Profiler.zone(b"compileIr")
      run Progress.begin(&mut progress.*, ProgressPhase.Link, usize.ZERO)
      run Progress.show(&mut progress.*, b"clang")

      // A link input the target cannot link fails this package's link, like a linker error.
      // A split debug build makes each compiled unit's line tables from its own text.
      let mut unitLines = Option<&EmissionPlan>.none()
      if lineTables && split {
        unitLines = Option<&EmissionPlan>.some(&plan)
      }
      let symbolMap = run EmissionPlan.symbolMap(&plan)
      let linked = run Effect.result(
        compileIr(
          &text,
          Bytes.asSlice(&debugInfo),
          unitLines,
          &sources,
          &functionNames,
          List<CodegenUnit>.asSlice(&units),
          List<BuildRecord.PackBody>.asSlice(&packs),
          output,
          form,
          stage,
          Bytes.asSlice(&optimization),
          lineTables,
          Bytes.asSlice(&relocation),
          Bytes.asSlice(&libc),
          List<Bytes>.asSlice(&profileFlags),
          &target,
          &supply,
          ModuleSourceFiles.nativeLinkInputs(&sources),
          ModuleSourceFiles.functionOrder(&sources),
          Bytes.asSlice(&symbolMap),
          clang,
          &world,
          started,
          printed,
          explicit,
          &mut progress.*,
        ),
      )
      match move linked {
        Result<
          i32,
          FileError
            | ProcessError
            | HostInputError
            | InvalidNativeLinkInput
            | OutOfMemoryError
            | WriterError
        >.Success {
          value
        } => {
          status = value
        }
        Result<
          i32,
          FileError
            | ProcessError
            | HostInputError
            | InvalidNativeLinkInput
            | OutOfMemoryError
            | WriterError
        >.Failure {
          error
        } => match move error {
          InvalidNativeLinkInput invalid => {
            let mut message = run Bytes.copy(b"silk: invalid native link input: ")
            run Bytes.append(&mut message, Bytes.asSlice(&invalid.detail))
            run Bytes.append(&mut message, b"\n")
            run writeHeaded(heading, &mut headed, Bytes.asSlice(&message), &mut progress.*)
            status = 1
          }
          FileError failed => {
            fail move failed
          }
          ProcessError failed => {
            fail move failed
          }
          HostInputError failed => {
            fail move failed
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
          WriterError failed => {
            fail move failed
          }
        }
      }

      // Every published artifact has its content-derived symbols named beside it, so a frame an
      // optimized program's backtrace or a profiler shows by symbol leads to its declaration. An
      // unchanged map is left alone, so a build that changes nothing writes nothing.
      if status == 0 {
        let mapFile = run symbolMapFor(output)
        if !run holds(&mapFile, Bytes.asSlice(&symbolMap)) { run FileSystem.writeFile(&mapFile, Bytes.asSlice(&symbolMap)) }
      }
      if status == 0 {
        run Progress.end(&mut progress.*, b"clang")
      } else {
        run Progress.refuse(&mut progress.*, usize.ZERO)
      }
      if status == 0 {
        if receipts {
          run reportCompiled(
            display,
            sourcePath,
            output,
            &target,
            EmissionPlan.symbolCount(&plan),
            b"llvm",
          )
        }
      }

      // A process about to exit leaves the program's text and plan to the exit, as the store below.
      if abandon {
        run abandonValue(move plan)
        run abandonValue(move text)
        run abandonValue(move units)
      }
    }
    BackendBuild.Unsupported { gaps } => {
      // The single-source form keeps the machine record the corpus harness parses.
      let mut message = Bytes.make()
      if receipts {
        message = run gapSummary(List<Shared<Gap>>.asSlice(&gaps))
      } else {
        let unreported = List<ReportedSite>.make()
        message = run gapLines(
          &sources,
          List<Shared<Gap>>.asSlice(&gaps),
          List<ReportedSite>.asSlice(&unreported),
          humanRoot(&machine),
        )
      }
      run writeHeaded(heading, &mut headed, Bytes.asSlice(&message), &mut progress.*)
      status = 2
    }
    BackendBuild.Rejected { first, further, gaps } => {
      // Every refusal the walk reached, first one first, then the gaps reached beside them.
      status = diagnosticStatus(&first)
      let reported = match move run entryRejection(
        &mut store,
        &mut request,
        &sources,
        &identity,
        &runtime,
        &first,
      ) {
        Option<Shared<Rejection>>.Some { value } => move value
        Option<Shared<Rejection>>.None => move first
      }
      let mut written = List<ReportedSite>.make()
      run record(&mut written, &reported)
      run writeRejection(heading, &mut headed, &sources, &reported, &machine, &mut progress.*)
      let others = List<Shared<Rejection>>.asSlice(&further)
      let mut at = usize.ZERO
      while at < others.length {
        if diagnosticStatus(&others[at]) == 1 {
          status = 1
        }
        let other = match move run entryRejection(
          &mut store,
          &mut request,
          &sources,
          &identity,
          &runtime,
          &others[at],
        ) {
          Option<Shared<Rejection>>.Some { value } => move value
          Option<Shared<Rejection>>.None => Shared<Rejection>.clone(&others[at])
        }

        // A refusal each instance of a generic body reaches, such as a `compileError` at the
        // caller's literal, prints once for its site, with the first instance's related call.
        if !run repeated(&mut written, &other) {
          run writeRejection(heading, &mut headed, &sources, &other, &machine, &mut progress.*)
        }
        at = at + usize.ONE
      }
      if List<Shared<Gap>>.length(&gaps) > usize.ZERO {
        let mut summary = Bytes.make()
        if receipts {
          summary = run gapSummary(List<Shared<Gap>>.asSlice(&gaps))
        } else {
          summary = run gapLines(
            &sources,
            List<Shared<Gap>>.asSlice(&gaps),
            List<ReportedSite>.asSlice(&written),
            humanRoot(&machine),
          )
        }
        run writeHeaded(heading, &mut headed, Bytes.asSlice(&summary), &mut progress.*)
      }
    }
  }
  if !testing || status != 0 {
    if !abandon {
      return Compiled.Finished { status: status }
    }

    // The process exits right after this build, and its exit returns the store's pages at once,
    // so they are not freed one by one first.
    run abandonValue(move store)
    run abandonValue(move sources)
    run abandonValue(move packs)
    run abandonValue(move cache)
    run abandonValue(move request)
    return Compiled.Finished { status: status }
  }

  // The linked runner iterates this same catalog; its identities bind the plan (TEST-004).
  let catalog = match move run Semantic.demandTests(&mut store, &mut request) {
    Result<Shared<TestCatalog>, Shared<Rejection>>.Success { value } => move value
    Result<Shared<TestCatalog>, Shared<Rejection>>.Failure { error } => {
      run writeRejection(heading, &mut headed, &sources, &error, &machine, &mut progress.*)
      return Compiled.Finished { status: diagnosticStatus(&error) }
    }
  }

  // Discovery reaches the test modules, whose selected imports are checked like the build's.
  let mut discovered = Bytes.make()
  let discoveredImports = run Semantic.importRejections(&mut store, &mut request)
  let discoveredImportStatus = run reportedImportRejections(
    List<Shared<Rejection>>.asSlice(&discoveredImports),
    &sources,
    &machine,
    &mut discovered,
    &mut reportedImports,
  )
  run writeHeaded(heading, &mut headed, Bytes.asSlice(&discovered), &mut progress.*)
  if discoveredImportStatus != 0 {
    return Compiled.Finished { status: discoveredImportStatus }
  }
  return Compiled.Tests { identities: run Semantic.testIdentities(&catalog) }
}

// Appends selected import refusals to `out`; 0 when absent, 1 for a language rejection, 2 for
// uncoded coverage.
effect fn reportedImportRejections(
  listed: &[Shared<Rejection>],
  sources: &ModuleSources,
  format: &DiagnosticFormat,
  out: &mut Bytes,
  seen: &mut List<ReportedSite>,
) -> i32
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut status = 0
  let mut at = usize.ZERO
  while at < listed.length {
    // Each name an import selects answers for the same module path, so one refused module is
    // reached once per name; it is reported once.
    if !run repeated(&mut seen.*, &listed[at]) {
      let current = run reportRejection(sources, &listed[at], format, &mut out.*)
      if status != 1 {
        status = current
      }
    }
    at = at + usize.ONE
  }
  return status
}

// The code and location of one reported diagnostic.
struct ReportedSite {
  code: RejectionCode,
  module: ModuleId,
  span: Span,
  /// For a dependency cycle, a key of its members independent of where the cycle was entered;
  /// zero otherwise. Every member of one cycle reports it, at its own reference.
  cycle: u64,
}

// The order-independent member key of a dependency cycle (SEM0223), or zero.
fn cycleKey(value: &Rejection) -> u64 {
  if value.code != RejectionCode.Cycle {
    return 0
  }
  let path = List<Interned<DeclarationId>>.asSlice(&value.path)
  if path.length < 3 {
    return 0
  }
  let mut key: u64 = 0
  let mut at = usize.ZERO
  while at + usize.ONE < path.length {
    key = u64.wrappingAdd(key, Interned<DeclarationId>.with<u64>(&path[at], DeclarationId.hash))
    at = at + usize.ONE
  }
  return key
}

// Whether `diagnostic` has the code and location of one in `seen`, or is another member's report
// of the same cycle; otherwise it is recorded there.
effect fn repeated(seen: &mut List<ReportedSite>, diagnostic: &Shared<Rejection>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let site = Shared<Rejection>.with<ReportedSite>(
    diagnostic,
    |value: &Rejection| -> ReportedSite {
      return ReportedSite {
        code: value.code,
        module: ModuleId.copy(&value.module),
        span: value.span,
        cycle: cycleKey(value),
      }
    },
  )
  let listed = List<ReportedSite>.asSlice(&seen.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].code == site.code && listed[at].span.start == site.span.start
      && listed[at].span.end == site.span.end
      && ModuleId.equals(&listed[at].module, &site.module) {
      return true
    }
    if site.cycle != 0 && listed[at].code == site.code && listed[at].cycle == site.cycle {
      return true
    }
    at = at + usize.ONE
  }
  run List<ReportedSite>.append(&mut seen.*, move site)
  return false
}

// Whether the fragments `ir` define the C symbol `main`.
fn definesMain(ir: &[u8]) -> bool {
  return Bitcode.definesFunction(ir, b"main")
}

// Whether a unit of `units` defines `main`, reading a stored unit's body from `packs`.
fn unitsDefineMain(units: &[CodegenUnit], packs: &[BuildRecord.PackBody]) -> bool {
  let mut at = usize.ZERO
  while at < units.length {
    if definesMain(unitBody(&units[at], packs)) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// The body of `unit`: its own, or the stored pack body of its digest in `packs`.
fn unitBody<'a>(unit: &'a CodegenUnit, packs: &'a [BuildRecord.PackBody]) -> &'a [u8] {
  if !unit.stored {
    return Bytes.asSlice(&unit.body)
  }
  let mut at = usize.ZERO
  while at < packs.length {
    if ContentHash.equals(packs[at].digest, unit.digest) {
      return Bytes.asSlice(&packs[at].bytes)
    }
    at = at + usize.ONE
  }
  return CompilerBug.panic(b"a stored codegen unit has no pack body")
}

// Records the code and location of `diagnostic` as printed.
effect fn record(seen: &mut List<ReportedSite>, diagnostic: &Shared<Rejection>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let site = Shared<Rejection>.with<ReportedSite>(
    diagnostic,
    |value: &Rejection| -> ReportedSite {
      return ReportedSite {
        code: value.code,
        module: ModuleId.copy(&value.module),
        span: value.span,
        cycle: cycleKey(value),
      }
    },
  )
  run List<ReportedSite>.append(&mut seen.*, move site)
  return ()
}

// Writes `rejection` to standard error in `format`, headed as [`writeHeaded`] heads diagnostics.
effect fn writeRejection(
  heading: &Option<Bytes>,
  headed: &mut bool,
  sources: &ModuleSources,
  rejection: &Shared<Rejection>,
  format: &DiagnosticFormat,
  progress: &mut Progress,
) -> ()
  ! FileError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut Allocator {
  let mut line = Bytes.make()
  let _reported = run reportRejection(sources, rejection, format, &mut line)
  run writeHeaded(heading, &mut headed.*, Bytes.asSlice(&line), &mut progress.*)
}

// Writes diagnostics to standard error. When `heading` names a target, a `[<target>]` line comes
// before the first of them, as `silk check` heads a target's diagnostics; nothing is written for
// none, so a build without diagnostics prints no heading. A live progress line still on screen,
// as a compact report keeps it between phases, is cleared first so they do not run together.
effect fn writeHeaded(
  heading: &Option<Bytes>,
  headed: &mut bool,
  diagnostics: &[u8],
  progress: &mut Progress,
) -> ()
  ! WriterError {
  if diagnostics.length == usize.ZERO {
    return ()
  }
  run Progress.clear(&mut progress.*)
  if let Option<Bytes>.Some { value: target } = &heading.* {
    if !headed.* {
      run writeError(b"[")
      run writeError(Bytes.asSlice(&target))
      run writeError(b"]\n")
      headed.* = true
    }
  }
  run writeError(diagnostics)
}

// The runtime's refusal of the application's `main`, reported at the entry's `main` instead of
// inside the runtime source: SEM0225 when `rejection` is located in the selected `runtime` and is
// one an absent, private or ill-shaped `main` produces there; otherwise none.
effect fn entryRejection(
  store: &mut Semantic,
  request: &mut SemanticRequest,
  sources: &ModuleSources,
  entry: &ModuleId,
  runtime: &Option<ModuleId>,
  rejection: &Shared<Rejection>,
) -> Option<Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator | &mut Types {
  let mut code = Shared<Rejection>.with<RejectionCode>(
    rejection,
    |value: &Rejection| -> RejectionCode {
      return value.code
    },
  )
  let mut module = Shared<Rejection>.with<ModuleId>(
    rejection,
    |value: &Rejection| -> ModuleId {
      return ModuleId.copy(&value.module)
    },
  )

  // A `main` result such as `string` needs a lifetime only because it borrows, and no lifetime makes
  // it a result a runtime starts, so its SEM0210 is reported as the runtime's refusal of that result.
  if code == RejectionCode.AmbiguousLifetime && ModuleId.equals(&module, entry) {
    if let Option<ModuleId>.Some { value: selected } = &runtime.* {
      let span = Shared<Rejection>.with<Span>(
        rejection,
        |value: &Rejection| -> Span {
          return value.span
        },
      )
      if run inMainResult(&mut store.*, &mut request.*, sources, entry, span) {
        code = RejectionCode.MissingConformance
        module = ModuleId.copy(&selected)
      }
    }
  }
  let located = match &runtime.* {
    Option<ModuleId>.Some { value } => ModuleId.equals(&module, &value)
    Option<ModuleId>.None => false
  }
  if !located {
    return Option<Shared<Rejection>>.none()
  }
  let mut problem = Bytes.make()

  // A runtime that accepts one `main` shape, such as silk/platform/native/start_sync's i32 Effect requiring
  // HostInput, refuses another where it adapts the result or supplies the requirement.
  // Only a standard-library runtime is trusted to fail this way for no reason but `main`'s shape: in
  // a runtime the package writes itself, these are ordinary errors of that runtime and stay as they are.
  let adapted = code == RejectionCode.TypeArgumentInference
    || code == RejectionCode.MissingProvidedKey
    || code == RejectionCode.IncompatibleUnionConversion
  let standard = ModuleId.withPath<bool>(
    &module,
    |path: &[u8]| -> bool {
      return path.length > 5 && path[0] == 115 && path[1] == 105 && path[2] == 108 && path[3] == 107
        && path[4] == 47
    },
  )
  if adapted && !standard {
    return Option<Shared<Rejection>>.none()
  }
  if adapted {
    run Bytes.append(&mut problem, b"has a result or requirement the selected runtime `")

    // The runtime as the manifest selects it: its module path without the source extension.
    let mut path = run ModuleId.copyPath(&module)
    let spelled = Bytes.asSlice(&path)
    let length = spelled.length
    let extension = length > 5 && spelled[length - 5] == 46 && spelled[length - 4] == 115
      && spelled[length - 3] == 105
      && spelled[length - 2] == 108
      && spelled[length - 1] == 107
    if extension {
      Bytes.truncate(&mut path, length - 5)
    }
    run Bytes.append(&mut problem, Bytes.asSlice(&path))
    run Bytes.append(&mut problem, b"` cannot start")
  } else if code == RejectionCode.MissingConformance
    && !ModuleId.withPath<bool>(
      &module,
      |path: &[u8]| -> bool {
        return same(path, b"silk/platform/native/start.silk")
      },
    ) {
    // Each runtime lists the `main` results it starts; name the selected one's, not the hosted list.
    let wasm = ModuleId.withPath<bool>(
      &module,
      |path: &[u8]| -> bool {
        return same(path, b"silk/platform/wasm/start.silk")
      },
    )
    if wasm {
      run Bytes.append(
        &mut problem,
        b"has a result the selected runtime `silk/platform/wasm/start` cannot start; it accepts i32, (), or an Effect producing () with no requirements",
      )
    } else {
      run Bytes.append(&mut problem, b"has a result the selected runtime `")
      let mut path = run ModuleId.copyPath(&module)
      let length = Bytes.length(&path)
      if length > 5 {
        Bytes.truncate(&mut path, length - 5)
      }
      run Bytes.append(&mut problem, Bytes.asSlice(&path))
      run Bytes.append(&mut problem, b"` cannot start")
    }
  } else {
    let fixed: &'static [u8] = match code {
      RejectionCode.UnknownImportedMember => b"is missing: the entry module must declare `pub fn main`, or a library package sets `kind = \"library\"` under `[package]` in silk.toml"
      RejectionCode.PrivateMember => b"must be `pub`"
      RejectionCode.RedundantCall => b"must take no parameters"
      RejectionCode.CallArity => b"must take no parameters"
      RejectionCode.UnsatisfiedExecutableProperty => b"may park, but the selected runtime starts it without a scheduler, so it must not park"
      RejectionCode.MissingConformance => b"has a result the selected runtime cannot start; the default runtime accepts i32, (), or an Effect producing () or i32 that requires at most `&mut HostInput` and whose errors all implement `Debug`"
      _ => {
        return Option<Shared<Rejection>>.none()
      }
    }
    run Bytes.append(&mut problem, fixed)
  }
  let mut moved = run Rejections.make(
    RejectionCode.InvalidEntryPoint,
    entry,
    run entryMainSpan(&mut store.*, &mut request.*, sources, entry),
  )
  run List<MessageArgument>.append(
    &mut moved.arguments,
    MessageArgument { name: run Bytes.copy(b"problem"), value: move problem },
  )
  return Option<Shared<Rejection>>.some(run Shared<Rejection>.make(move moved))
}

// Whether `span` lies in the result of `entry`'s module-level `main`: after its name and its `->`,
// before its body.
effect fn inMainResult(
  store: &mut Semantic,
  request: &mut SemanticRequest,
  sources: &ModuleSources,
  entry: &ModuleId,
  span: Span,
) -> bool
  ! Cycle | InvalidModulePath | RevisionMismatch | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator | &mut Types {
  let name = run entryMainSpan(&mut store.*, &mut request.*, sources, entry)
  if name.end == usize.ZERO || span.start < name.end {
    return false
  }
  let text = match move run moduleSource(sources, entry) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return false
    }
  }
  let source = Bytes.asSlice(&text)
  if span.start > source.length {
    return false
  }
  let mut arrow = false
  let mut at = name.end
  while at < span.start {
    if source[at] == 123 {
      return false
    }
    if source[at] == 45 && at + usize.ONE < span.start && source[at + usize.ONE] == 62 {
      arrow = true
    }
    at = at + usize.ONE
  }
  return arrow
}

// The name span of `entry`'s module-level `main` function; the module start when it has none.
effect fn entryMainSpan(
  store: &mut Semantic,
  request: &mut SemanticRequest,
  sources: &ModuleSources,
  entry: &ModuleId,
) -> Span
  ! Cycle | InvalidModulePath | RevisionMismatch | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator | &mut Types {
  let text = match move run moduleSource(sources, entry) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return Span.make(usize.ZERO, usize.ZERO)
    }
  }
  let inventory = run Semantic.demandSourceInventory(&mut store.*, &mut request.*, entry)
  if let SourceInventory.Present { syntax, .. } = &inventory {
    let functions = List<NamedFunction>.asSlice(&syntax.functions)
    let source = Bytes.asSlice(&text)
    let mut at = usize.ZERO
    while at < functions.length {
      let name = functions[at].nameSpan
      let topLevel = match &functions[at].declaration.parent {
        Option<usize>.Some { .. } => false
        Option<usize>.None => true
      }
      if topLevel && name.end <= source.length && name.end - name.start == 4
        && source[name.start] == 109
        && source[name.start + 1] == 97
        && source[name.start + 2] == 105
        && source[name.start + 3] == 110 {
        return name
      }
      at = at + usize.ONE
    }
  }
  return Span.make(usize.ZERO, usize.ZERO)
}

// The source file and text of `module`, when the analysis reads it from disk.
effect fn moduleSource(sources: &ModuleSources, module: &ModuleId) -> Option<Bytes>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let location = run ModuleSourceFiles.sourceLocation(sources, module)
  return match &location.path {
    Option<Path>.Some { value } => {
      let read = run Effect.result(FileSystem.readFile(&value))
      return match move read {
        Result<Bytes, FileError | OutOfMemoryError>.Success { value: text } => Option<Bytes>.some(
          move text,
        )
        Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
          FileError unreadable => {
            drop unreadable
            return Option<Bytes>.none()
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    Option<Path>.None => Option<Bytes>.none()
  }
}

// Appends `path:line:col` for `span` in `module`, `path:?:?` when its source cannot be read.
// The path a diagnostic in `module` names: its source file, else its logical path.
// The file of `module` as a diagnostic names it: relative to `root` when it lies under it, else
// absolute, as `--json` always names it.
effect fn displayPath(sources: &ModuleSources, module: &ModuleId, root: &[u8]) -> Bytes
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let location = run ModuleSourceFiles.sourceLocation(sources, module)
  return match &location.path {
    Option<Path>.Some { value } => {
      if root.length == usize.ZERO {
        return run Bytes.copy(Path.rawBytes(&value))
      }
      let directory = run Path.fromBytes(root)
      return run shownPath(&directory, &value)
    }
    Option<Path>.None => run ModuleId.copyPath(module)
  }
}

// The directory a human diagnostic names its files from: the root of the workspace that lists the
// package at `manifest`, or else that package's own directory, so `silk build` in a workspace
// prints `glob/src/Glob.silk:1:1`. Files outside it, such as the standard library's, stay absolute.
// A single-source build has no manifest and keeps absolute paths.
effect fn diagnosticRoot(manifest: &Path) -> Bytes
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let directory = match move run Path.parent(manifest) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return Bytes.make()
    }
  }
  let workspace = match move run Projects.enclosingWorkspace(&directory) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return run Bytes.copy(Path.rawBytes(&directory))
    }
  }
  let workspaceDirectory = match move run Path.parent(&workspace) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return run Bytes.copy(Path.rawBytes(&directory))
    }
  }

  // A workspace above the package that does not list it, such as a repository's own, is not its root.
  if same(Path.rawBytes(&workspaceDirectory), Path.rawBytes(&directory))
    || run listedMember(&workspace, &directory) {
    return run Bytes.copy(Path.rawBytes(&workspaceDirectory))
  }
  return run Bytes.copy(Path.rawBytes(&directory))
}

// Whether the workspace at `manifest` lists `member`; a manifest that cannot be read lists nothing.
effect fn listedMember(manifest: &Path, member: &Path) -> bool
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  return match move run Effect.result(Projects.listsMember(manifest, member)) {
    Result<bool, ProjectError | FileError | OutOfMemoryError>.Success { value } => value
    Result<bool, ProjectError | FileError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      ProjectError unread => {
        drop unread
        return false
      }
      FileError unread => {
        drop unread
        return false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// The root a human `format` names its paths from; empty, for absolute paths, in the machine and
// JSON formats.
fn humanRoot(format: &DiagnosticFormat) -> &[u8] {
  if let DiagnosticFormat.Human { root } = &format.* {
    return Bytes.asSlice(&root)
  }
  return b""
}

effect fn appendLocation(
  line: &mut Bytes,
  sources: &ModuleSources,
  module: &ModuleId,
  span: Span,
  root: &[u8],
  json: bool,
) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let path = run displayPath(sources, module, root)
  let text = run moduleSource(sources, module)
  if json {
    run Bytes.append(&mut line.*, b"\"path\":")
    run JsonText.appendString(&mut line.*, Bytes.asSlice(&path))
    if let Option<Bytes>.Some { value } = &text {
      let position = Reports.position(Bytes.asSlice(&value), span.start)
      run Bytes.append(&mut line.*, b",\"line\":")
      run JsonText.appendDecimal(&mut line.*, position.line)
      run Bytes.append(&mut line.*, b",\"column\":")
      run JsonText.appendDecimal(&mut line.*, position.column)
    } else {
      run Bytes.append(&mut line.*, b",\"line\":null,\"column\":null")
    }
    run Bytes.append(&mut line.*, b",\"start\":")
    run JsonText.appendDecimal(&mut line.*, span.start)
    run Bytes.append(&mut line.*, b",\"end\":")
    run JsonText.appendDecimal(&mut line.*, span.end)
    return ()
  }
  run Bytes.append(&mut line.*, Bytes.asSlice(&path))
  if let Option<Bytes>.Some { value } = &text {
    let position = Reports.position(Bytes.asSlice(&value), span.start)
    run Bytes.append(&mut line.*, b":")
    run JsonText.appendDecimal(&mut line.*, position.line)
    run Bytes.append(&mut line.*, b":")
    run JsonText.appendDecimal(&mut line.*, position.column)
  } else {
    run Bytes.append(&mut line.*, b":?:?")
  }
}

// Appends one `--json` diagnostic line: the target, then the rendered parts in the bootstrap's
// field order.
effect fn appendJson(out: &mut Bytes, target: &[u8], rendered: &RenderedDiagnostic) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run Bytes.append(&mut out.*, b"{\"target\":")
  run JsonText.appendString(&mut out.*, target)
  run Bytes.append(&mut out.*, b",\"code\":")
  run JsonText.appendString(&mut out.*, Bytes.asSlice(&rendered.code))
  run Bytes.append(&mut out.*, b",\"severity\":")
  run JsonText.appendString(&mut out.*, Bytes.asSlice(&rendered.severity))
  run Bytes.append(&mut out.*, b",\"path\":")
  run JsonText.appendString(&mut out.*, Bytes.asSlice(&rendered.path))
  run Bytes.append(&mut out.*, b",\"line\":")
  run JsonText.appendDecimal(&mut out.*, rendered.line)
  run Bytes.append(&mut out.*, b",\"column\":")
  run JsonText.appendDecimal(&mut out.*, rendered.column)
  run Bytes.append(&mut out.*, b",\"start\":")
  run JsonText.appendDecimal(&mut out.*, rendered.start)
  run Bytes.append(&mut out.*, b",\"end\":")
  run JsonText.appendDecimal(&mut out.*, rendered.end)
  run Bytes.append(&mut out.*, b",\"message\":")
  if let Option<Bytes>.Some { value: message } = &rendered.message {
    run JsonText.appendString(&mut out.*, Bytes.asSlice(&message))
  } else {
    run Bytes.append(&mut out.*, b"null")
  }
  run Bytes.append(&mut out.*, b",\"notes\":[")
  let notes = List<Bytes>.asSlice(&rendered.notes)
  let mut at = usize.ZERO
  while at < notes.length {
    if at > usize.ZERO {
      run Bytes.append(&mut out.*, b",")
    }
    run JsonText.appendString(&mut out.*, Bytes.asSlice(&notes[at]))
    at = at + usize.ONE
  }
  run Bytes.append(&mut out.*, b"],\"related\":[")
  let related = List<RelatedLocation>.asSlice(&rendered.related)
  at = usize.ZERO
  while at < related.length {
    if at > usize.ZERO {
      run Bytes.append(&mut out.*, b",")
    }
    run Bytes.append(&mut out.*, b"{\"path\":")
    run JsonText.appendString(&mut out.*, Bytes.asSlice(&related[at].path))
    run Bytes.append(&mut out.*, b",\"line\":")
    run JsonText.appendDecimal(&mut out.*, related[at].line)
    run Bytes.append(&mut out.*, b",\"column\":")
    run JsonText.appendDecimal(&mut out.*, related[at].column)
    run Bytes.append(&mut out.*, b",\"start\":")
    run JsonText.appendDecimal(&mut out.*, related[at].start)
    run Bytes.append(&mut out.*, b",\"end\":")
    run JsonText.appendDecimal(&mut out.*, related[at].end)
    run Bytes.append(&mut out.*, b",\"label\":")
    if let Option<Bytes>.Some { value: label } = &related[at].label {
      run JsonText.appendString(&mut out.*, Bytes.asSlice(&label))
    } else {
      run Bytes.append(&mut out.*, b"null")
    }
    run Bytes.append(&mut out.*, b"}")
    at = at + usize.ONE
  }
  run Bytes.append(&mut out.*, b"]}\n")
}

// The note for an import of `written`, a missing module, from `importer` when a file names it in
// other letter case: `did you mean util.Math?` for `util.math` beside `util/Math.silk`. Module paths
// match file names exactly on every host, so the import is refused even where the filesystem
// ignores case. Failing that, a file one typo away is offered: `did you mean geo.shapes?` for
// `geo.shape` beside `geo/shapes.silk`.
effect fn caseVariantNote(sources: &ModuleSources, importer: &ModuleId, written: &[u8]) -> Option<
  Bytes
>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut dotted = Bytes.make()
  let mut path = Bytes.make()
  let mut segments = usize.ONE
  let mut at = usize.ZERO
  while at < written.length {
    let byte = written[at]
    if byte == 46 {
      segments = segments + usize.ONE
      run Bytes.append(&mut dotted, b".")
      run Bytes.append(&mut path, b"/")
    } else if byte != 32 && byte != 9 && byte != 10 && byte != 13 {
      run Bytes.append(&mut dotted, &[byte])
      run Bytes.append(&mut path, &[byte])
    }
    at = at + usize.ONE
  }
  run Bytes.append(&mut path, b".silk")
  let graph = run ModuleSourceFiles.packageGraph(sources)
  let target = match move run Effect.result(
    PackageGraph.target(&graph, importer, Bytes.asSlice(&path)),
  ) {
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success { value } => move value
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure { error } => match move error {
      InvalidModulePath {} => {
        return Option<Bytes>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let mut found = run ModuleSourceFiles.caseVariant(sources, &target)
  let caseOnly = match &found {
    Option<Bytes>.Some { .. } => true
    Option<Bytes>.None => false
  }
  if !caseOnly {
    found = run ModuleSourceFiles.nearVariant(sources, &target)
  }

  // A module that moved within its package, such as `helper` to `util/helper`, is found by name.
  if let Option<Bytes>.None = &found {
    found = run ModuleSourceFiles.movedVariant(sources, &target)
  }
  let variant = match move found {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return Option<Bytes>.none()
    }
  }

  // The file's logical path replaces the import's segments that spell the target's path; a
  // dependency's name before them stays as written.
  let spelled = Bytes.asSlice(&variant)
  let targetPath = run ModuleId.copyPath(&target)
  let mut kept = segments
  at = usize.ZERO
  while at < Bytes.length(&targetPath) {
    if Bytes.asSlice(&targetPath)[at] == 47 {
      kept = kept - usize.ONE
    }
    at = at + usize.ONE
  }
  kept = kept - usize.ONE
  let mut note = run Bytes.copy(b"did you mean `")
  let prefix = Bytes.asSlice(&dotted)
  at = usize.ZERO
  while kept > usize.ZERO && at < prefix.length {
    run Bytes.append(&mut note, &[prefix[at]])
    if prefix[at] == 46 {
      kept = kept - usize.ONE
    }
    at = at + usize.ONE
  }
  let end = spelled.length - 5
  at = usize.ZERO
  while at < end {
    if spelled[at] == 47 {
      run Bytes.append(&mut note, b".")
    } else {
      run Bytes.append(&mut note, &[spelled[at]])
    }
    at = at + usize.ONE
  }
  if caseOnly {
    run Bytes.append(&mut note, b"`? Module paths match file names exactly, including letter case")
  } else {
    run Bytes.append(&mut note, b"`?")
  }
  return Option<Bytes>.some(move note)
}

// Appends one rejection or refusal to `out` in `format` and answers its status: 1 for a language
// rejection, 2 for a construct this compiler does not support yet.
effect fn reportRejection(
  sources: &ModuleSources,
  diagnostic: &Shared<Rejection>,
  format: &DiagnosticFormat,
  out: &mut Bytes,
) -> i32
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let status = diagnosticStatus(diagnostic)
  let target = match &format.* {
    DiagnosticFormat.Machine => {
      let message = run rejectionSummary(diagnostic)
      run Bytes.append(&mut out.*, Bytes.asSlice(&message))
      return status
    }
    DiagnosticFormat.Human { .. } => Option<&[u8]>.none()
    DiagnosticFormat.Json { target } => Option<&[u8]>.some(Bytes.asSlice(&target))
  }
  let code = Shared<Rejection>.with<RejectionCode>(
    diagnostic,
    |value: &Rejection| -> RejectionCode {
      return value.code
    },
  )
  let span = Shared<Rejection>.with<Span>(
    diagnostic,
    |value: &Rejection| -> Span {
      return value.span
    },
  )
  let module = Shared<Rejection>.with<ModuleId>(
    diagnostic,
    |value: &Rejection| -> ModuleId {
      return ModuleId.copy(&value.module)
    },
  )

  // A related site at the diagnostic's own position adds nothing.
  let related = Shared<Rejection>.with<Option<RelatedSite>>(
    diagnostic,
    |value: &Rejection| -> Option<RelatedSite> {
      return match &value.related {
        Option<RelatedSite>.Some { value: site } => {
          if ModuleId.equals(&site.module, &value.module) && site.span.start == value.span.start {
            return Option<RelatedSite>.none()
          }
          return Option<RelatedSite>.some(
            RelatedSite { module: ModuleId.copy(&site.module), span: site.span },
          )
        }
        Option<RelatedSite>.None => Option<RelatedSite>.none()
      }
    },
  )

  // A catalog diagnostic in a module read from disk renders as the bootstrap CLI prints it.
  if let Option<Bytes>.Some { value: text } = move run moduleSource(sources, &module) {
    let path = run displayPath(sources, &module, humanRoot(format))
    if let Option<RenderedDiagnostic>.Some { value: fields } = move run Reports.fields(
      diagnostic,
      Bytes.asSlice(&text),
      Bytes.asSlice(&path),
    ) {
      let mut rendered = move fields

      // The report locates only a related site of the diagnostic's own module; a site in another
      // module, such as the library body a call reached, is located in that module's source here.
      if let Option<RelatedSite>.Some { value: site } = &related {
        if !ModuleId.equals(&site.module, &module) {
          if let Option<Bytes>.Some { value: relatedText } = move run moduleSource(
            sources,
            &site.module,
          ) {
            let position = Reports.position(Bytes.asSlice(&relatedText), site.span.start)
            let relatedPath = run displayPath(sources, &site.module, humanRoot(format))
            let mut label = Option<Bytes>.none()
            if let Option<Code>.Some { value: catalogued } = Rejections.catalogCode(code) {
              label = run Reports.relatedLabel(catalogued, diagnostic)
            }
            run List<RelatedLocation>.append(
              &mut rendered.related,
              RelatedLocation {
                path: move relatedPath,
                line: position.line,
                column: position.column,
                start: site.span.start,
                end: site.span.end,
                label: move label,
              },
            )
          }
        }
      }
      if code == RejectionCode.MissingModule && span.end <= Bytes.length(&text)
        && span.start < span.end {
        let written = Slice.view<u8>(Bytes.asSlice(&text), span.start, span.end - span.start)
        if let Option<Bytes>.Some { value: note } = move run caseVariantNote(
          sources,
          &module,
          written,
        ) {
          run List<Bytes>.append(&mut rendered.notes, move note)
        }
      }
      if let DiagnosticFormat.Json { target: targetName } = &format.* {
        run appendJson(&mut out.*, Bytes.asSlice(&targetName), &rendered)
      } else {
        let line = run Reports.text(&rendered)
        run Bytes.append(&mut out.*, Bytes.asSlice(&line))
        run Bytes.append(&mut out.*, b"\n")
      }
      return status
    }
  }

  // A refusal has no catalog code; it names the unsupported construct instead.
  let mut name = Rejections.stableCode(code)
  if name.length == usize.ZERO {
    name = Rejection.name(code)
  }
  let mut line = Bytes.make()
  if let Option<&[u8]>.Some { value: targetName } = move target {
    run Bytes.append(&mut line, b"{\"target\":")
    run JsonText.appendString(&mut line, targetName)
    run Bytes.append(&mut line, b",\"code\":")
    run JsonText.appendString(&mut line, name)
    if status == 1 {
      run Bytes.append(&mut line, b",\"severity\":\"error\",")
    } else if Rejections.internal(code) {
      run Bytes.append(&mut line, b",\"severity\":\"internal\",")
    } else {
      run Bytes.append(&mut line, b",\"severity\":\"unsupported\",")
    }
    run appendLocation(&mut line, sources, &module, span, b"", true)
    run Bytes.append(&mut line, b",\"message\":null,\"notes\":[],\"related\":[")
    if let Option<RelatedSite>.Some { value: site } = &related {
      run Bytes.append(&mut line, b"{")
      run appendLocation(&mut line, sources, &site.module, site.span, b"", true)
      run Bytes.append(&mut line, b",\"label\":null}")
    }
    run Bytes.append(&mut line, b"]}\n")
  } else {
    run appendLocation(&mut line, sources, &module, span, humanRoot(format), false)
    if status == 1 {
      run Bytes.append(&mut line, b": error[")
      run Bytes.append(&mut line, name)
      run Bytes.append(&mut line, b"]\n")
    } else if Rejections.internal(code) {
      run appendInternalError(&mut line, name)
    } else {
      run Bytes.append(&mut line, b": unsupported[")
      run Bytes.append(&mut line, name)
      run Bytes.append(&mut line, b"] not supported by the native compiler yet\n")
    }
    if let Option<RelatedSite>.Some { value: site } = &related {
      run Bytes.append(&mut line, b"  note: ")
      run appendLocation(&mut line, sources, &site.module, site.span, humanRoot(format), false)
      run Bytes.append(&mut line, b": related location\n")
    }
  }
  run Bytes.append(&mut out.*, Bytes.asSlice(&line))
  return status
}

// The key a reused test runner (or, under another `kind`, a reused project build, see
// `reusedBuild`) must have been built under: the compiler, the profile, the roots
// and paths the build starts from, and the toolchain settings it reads from the environment. Every
// file the build reads is checked separately (`BuildInputs`). There is none, so nothing is reused,
// for a compiler without an identity or a build with profile bindings, which may hold secrets that
// must not reach the disk.
effect fn testBuildKey(
  kind: &[u8],
  sourcePath: &Path,
  manifest: &Option<&Path>,
  output: &Path,
  display: &Path,
  standardLibrary: &Option<Path>,
  profile: &InitialProfile,
  bindings: &List<Supplied>,
  clang: &Option<Bytes>,
  stamped: &Option<Bytes>,
  unsandboxedTools: bool,
) -> Option<Bytes>
  ! HostInputError | OutOfMemoryError
  ? &mut FileSystem | &mut HostInput | &mut Allocator {
  if List<Supplied>.length(bindings) != usize.ZERO {
    return Option<Bytes>.none()
  }
  let compiler = match &stamped.* {
    Option<Bytes>.Some { value } => Bytes.asSlice(&value)
    Option<Bytes>.None => {
      return Option<Bytes>.none()
    }
  }
  let mut key = run Bytes.copy(kind)
  run RuntimeEncoding.field(
    &mut key,
    if unsandboxedTools {
      b"unsandboxed"
    } else {
      b"sandboxed"
    },
  )
  run RuntimeEncoding.field(&mut key, compiler)
  let mut identity = Bytes.make()
  run InitialProfile.appendIdentity(profile, &mut identity)
  run RuntimeEncoding.field(&mut key, Bytes.asSlice(&identity))
  run RuntimeEncoding.field(&mut key, Path.rawBytes(sourcePath))
  run RuntimeEncoding.field(&mut key, Path.rawBytes(output))
  run RuntimeEncoding.field(&mut key, Path.rawBytes(display))
  match &manifest.* {
    Option<&Path>.Some { value } => run RuntimeEncoding.field(&mut key, Path.rawBytes(value))
    Option<&Path>.None => run RuntimeEncoding.field(&mut key, b"")
  }
  match &standardLibrary.* {
    Option<Path>.Some { value } => run RuntimeEncoding.field(&mut key, Path.rawBytes(&value))
    Option<Path>.None => run RuntimeEncoding.field(&mut key, b"")
  }
  match &clang.* {
    Option<Bytes>.Some { value } => run RuntimeEncoding.field(&mut key, Bytes.asSlice(&value))
    Option<Bytes>.None => run RuntimeEncoding.field(&mut key, b"")
  }
  if Target.id(InitialProfile.target(profile)) == TargetId.Wasm32Wasip2 {
    match move run Effect.result(WasiTools.identity()) {
      Result<Bytes, FileError | HostInputError | OutOfMemoryError>.Success {
        value
      } => run RuntimeEncoding.field(&mut key, Bytes.asSlice(&value))
      Result<Bytes, FileError | HostInputError | OutOfMemoryError>.Failure {
        error
      } => match move error {
        FileError unavailable => {
          drop unavailable
          return Option<Bytes>.none()
        }
        HostInputError unavailable => {
          fail move unavailable
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
  }
  let variables = [
    "SILK_CLANG",
    "SILK_LLVM_AR",
    "PATH",
    "SDKROOT",
    "DEVELOPER_DIR",
    "SILK_WASM_TOOLS",
    "SILK_WASI_ADAPTER",
    "SILK_WASI_REACTOR_ADAPTER",
    "SILK_VERIFY_MIR",
    "SILK_PROFILE_GENERATE",
    "SILK_PROFILE_USE",
  ]
  let mut at = usize.ZERO
  while at < variables.length {
    match move run HostInput.variableNamed(variables[at]) {
      Option<Bytes>.Some { value } => {
        run RuntimeEncoding.field(&mut key, b"=")
        run RuntimeEncoding.field(&mut key, Bytes.asSlice(&value))
      }
      Option<Bytes>.None => run RuntimeEncoding.field(&mut key, b"")
    }
    at = at + usize.ONE
  }
  return Option<Bytes>.some(move key)
}

// What a reused runner needs besides its executable: the digest of that executable, then the
// catalog identities in order.
effect fn testBuildPayload(executable: &[u8], identities: &List<Bytes>) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let digest = ContentHash.of(executable)
  let mut payload = Bytes.make()
  run RuntimeEncoding.word(&mut payload, digest.high)
  run RuntimeEncoding.word(&mut payload, digest.low)
  let listed = List<Bytes>.asSlice(identities)
  run RuntimeEncoding.word(&mut payload, usize.toU64(listed.length))
  let mut at = usize.ZERO
  while at < listed.length {
    run RuntimeEncoding.field(&mut payload, Bytes.asSlice(&listed[at]))
    at = at + usize.ONE
  }
  return move payload
}

// The big-endian word `RuntimeEncoding.word` wrote at `offset`.
fn readWord(bytes: &[u8], offset: usize) -> u64 {
  let mut value: u64 = 0
  let mut at = usize.ZERO
  while at < 8 {
    value = u64.bitOr(u64.shiftLeft(value, 8), u8.toU64(bytes[offset + at]))
    at = at + usize.ONE
  }
  return value
}

// The catalog of the runner at `output` when the record beside it shows that a build under `key`
// would read exactly what the one that made it read, and the runner is the one it made.
effect fn reusedTests(record: &Path, key: &Option<Bytes>, output: &Path) -> Option<List<Bytes>>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let expected = match &key.* {
    Option<Bytes>.Some { value } => Bytes.asSlice(&value)
    Option<Bytes>.None => {
      return Option<List<Bytes>>.none()
    }
  }
  let stored = match move run Effect.result(FileSystem.readFile(record)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        drop failure
        return Option<List<Bytes>>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let payload = match move run BuildInputs.unchanged(Bytes.asSlice(&stored), expected) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return Option<List<Bytes>>.none()
    }
  }
  let executable = match move run Effect.result(FileSystem.readFile(output)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        drop failure
        return Option<List<Bytes>>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let digest = ContentHash.of(Bytes.asSlice(&executable))
  let bytes = Bytes.asSlice(&payload)
  if bytes.length < 24 || readWord(bytes, 0) != digest.high || readWord(bytes, 8) != digest.low {
    return Option<List<Bytes>>.none()
  }
  let count = readWord(bytes, 16)
  let mut identities = List<Bytes>.make()
  let mut at: usize = 24
  let mut index: u64 = 0
  while index < count {
    if bytes.length - at < 8 {
      return Option<List<Bytes>>.none()
    }
    let length = u64.toUsize(readWord(bytes, at))
    at = at + 8
    if length > bytes.length - at {
      return Option<List<Bytes>>.none()
    }
    run List<Bytes>.append(&mut identities, run Bytes.copy(Slice.view<u8>(bytes, at, length)))
    at = at + length
    index = index + 1
  }
  if at != bytes.length {
    return Option<List<Bytes>>.none()
  }
  return Option<List<Bytes>>.some(move identities)
}

// The record of the files a project build read, beside its artifact.
effect fn reuseRecordFor(output: &Path) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut named = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut named, b".inputs")
  return run Path.fromBytes(Bytes.asSlice(&named))
}

// `key`, naming the memory limit `maxMemory` and the main stack `stackSize` too when they are set.
effect fn withMemoryLimit(
  key: Option<Bytes>,
  maxMemory: &Option<u64>,
  stackSize: &Option<u64>,
) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut keyed = match move key {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return Option<Bytes>.none()
    }
  }
  if let Option<u64>.Some { value: limit } = &maxMemory.* {
    run RuntimeEncoding.field(&mut keyed, b"max-memory")
    run RuntimeEncoding.word(&mut keyed, limit)
  }
  if let Option<u64>.Some { value: bytes } = &stackSize.* {
    run RuntimeEncoding.field(&mut keyed, b"stack-size")
    run RuntimeEncoding.word(&mut keyed, bytes)
  }
  return Option<Bytes>.some(move keyed)
}

// The symbol map a build writes beside its artifact.
effect fn symbolMapFor(output: &Path) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut named = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut named, b".symbols")
  return run Path.fromBytes(Bytes.asSlice(&named))
}

// The `.dSYM` bundle a macOS debug build keeps beside `output`.
effect fn debugBundleFor(output: &Path) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut named = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut named, b".dSYM")
  return run Path.fromBytes(Bytes.asSlice(&named))
}

// Replaces the `.dSYM` bundle beside `output` with the one Clang wrote beside `staged`, when it
// wrote one; a link of separately compiled units writes none, as the units' objects keep the DWARF.
effect fn publishDebugBundle(staged: &Path, output: &Path) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let made = run debugBundleFor(staged)
  let mut found = false
  match move run Effect.result(FileSystem.exists(&made)) {
    Result<bool, FileError>.Success { value } => {
      found = value
    }
    Result<bool, FileError>.Failure { error } => {
      drop error
    }
  }
  if !found {
    return ()
  }
  let kept = run debugBundleFor(output)
  let removed = run Effect.result(FileSystem.removeDirectoryRecursively(&kept))
  drop removed
  let _moved = run HostRename.replaceFile(&made, &kept)
  return ()
}

// The warnings the last build printed, when the artifact `output` is what a build under `key`
// would make: the last build recorded at `record` ran under the same key, every file it read reads
// the same, and `output` still has the digest it linked. None when the build must run.
effect fn reusedBuild(record: &Path, key: &Option<Bytes>, output: &Path) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let expected = match &key.* {
    Option<Bytes>.Some { value } => Bytes.asSlice(&value)
    Option<Bytes>.None => {
      return Option<Bytes>.none()
    }
  }
  let stored = match move run Effect.result(FileSystem.readFile(record)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        drop failure
        return Option<Bytes>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let payload = match move run BuildInputs.unchanged(Bytes.asSlice(&stored), expected) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return Option<Bytes>.none()
    }
  }
  let executable = match move run Effect.result(FileSystem.readFile(output)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        drop failure
        return Option<Bytes>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let digest = ContentHash.of(Bytes.asSlice(&executable))
  let bytes = Bytes.asSlice(&payload)
  if bytes.length < 16 || readWord(bytes, 0) != digest.high || readWord(bytes, 8) != digest.low {
    return Option<Bytes>.none()
  }
  return Option<Bytes>.some(run Bytes.copy(Slice.view<u8>(bytes, 16, bytes.length - 16)))
}

// Records at `record` what `recorder` saw a successful build read, and the `warnings` it printed,
// for `reusedBuild`. Only an executable whose link the codegen cache stamped is recorded: any
// other link reads inputs from outside the build (a declared archive, the wasip2 component tools)
// that no record notes.
effect fn recordBuild(
  record: &Path,
  key: &[u8],
  recorder: &BuildInputs.Recorder,
  output: &Path,
  warnings: &[u8],
) -> ()
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let units = match move run Effect.result(CodegenCache.directoryFor(output)) {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        drop failure
        return ()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  if !run CodegenCache.stamped(&units) {
    return ()
  }
  let executable = run Effect.result(FileSystem.readFile(output))
  if let Result<Bytes, FileError | OutOfMemoryError>.Success { value } = &executable {
    let digest = ContentHash.of(Bytes.asSlice(&value))
    let mut payload = Bytes.make()
    run RuntimeEncoding.word(&mut payload, digest.high)
    run RuntimeEncoding.word(&mut payload, digest.low)
    run Bytes.append(&mut payload, warnings)
    let encoded = run BuildInputs.encode(key, Bytes.asSlice(&payload), recorder)

    // Without the record the next build runs; it never changes this one.
    let written = run Effect.result(FileSystem.writeFile(record, Bytes.asSlice(&encoded)))
    drop written
  }
  drop executable
}

// One invocation nonce: no two runs share a plan, so a stale receipt never binds a new run.
effect fn testNonce(output: &[u8], digest: &[u8]) -> [u8; 32] {
  let mut clock = OsSystemClock.make()
  let now = run SystemClock.now() |> Effect.provideMut<SystemClock>(&mut clock)
  let mut state = Sha256.make()
  Sha256.update(&mut state, b"silk-test-nonce")
  let stamp = [i64.toU64(SystemClock.seconds(&now)), i64.toU64(SystemClock.nanoseconds(&now))]
  let mut at = usize.ZERO
  while at < 2 {
    let mut shift = usize.ZERO
    while shift < 8 {
      let byte = [u64.toU8(u64.bitAnd(u64.shiftRight(stamp[at], usize.toU64(shift * 8)), 255))]
      Sha256.update(&mut state, &byte)
      shift = shift + usize.ONE
    }
    at = at + usize.ONE
  }
  Sha256.update(&mut state, output)
  Sha256.update(&mut state, digest)
  return state.finish()
}

effect fn removeQuietly(path: &Path) -> ()
  ? &mut FileSystem {
  let removed = run Effect.result(FileSystem.removeFile(path))
  drop removed
  return ()
}

// Builds the bundled runner for the discovery root `sourcePath` (within `manifest`'s package when
// given), runs it with an uncached plan, and returns its status once its receipt is admitted: 0 or
// 1 from the runner, 2 for an operational failure, or the raw status of an abnormal exit
// (TEST-007, TEST-008). `matched` becomes true when the admitted receipt selected a test.
// `timeout` is each test's limit in seconds, 60 when absent and none when 0. The runner's build keeps its
// semantic cache in `cacheHome`, when given, and reports its phases on `progress`.
effect fn test(
  sourcePath: &Path,
  manifest: Option<&Path>,
  output: &Path,
  display: &Path,
  request: &SupplyRequest,
  standardLibrary: Option<Path>,
  profile: InitialProfile,
  bindings: List<Supplied>,
  filter: Option<Bytes>,
  file: Option<Bytes>,
  timeout: &Option<Bytes>,
  clang: &Option<Bytes>,
  noCache: bool,
  matched: &mut bool,
  ignoreWarnings: bool,
  cacheHome: Option<Path>,
  progress: Progress,
  unsandboxedTools: bool,
  versions: Versions,
) -> i32
  ! ApplicationError
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Writer | &mut Types {
  let wasi = same(Target.operatingSystem(InitialProfile.target(&profile)), b"wasi")

  // A WASI trap's frames are located relative to the root source's directory, which DWARF names
  // by its canonical path.
  let parent = match move run Path.parent(sourcePath) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Path.fromBytes(b".")
  }
  let sourceDirectory = match move run HostPath.canonicalBytes(Path.rawBytes(&parent)) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => run Bytes.copy(Path.rawBytes(&parent))
  }

  // An unchanged project reuses the runner it built last time, whatever the filters select;
  // `--no-cache` builds it again (TEST-008).
  let mut recordBytes = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut recordBytes, b".inputs")
  let recordPath = run Path.fromBytes(Bytes.asSlice(&recordBytes))
  let key = run testBuildKey(
    b"silk-test-runner-1",
    sourcePath,
    &manifest,
    output,
    display,
    &standardLibrary,
    &profile,
    &bindings,
    clang,
    &run CacheStamp.compiler(),
    unsandboxedTools,
  )
  let mut identities = List<Bytes>.make()
  let mut reused = Option<List<Bytes>>.none()
  let mut report = move progress
  if !noCache {
    reused = run reusedTests(&recordPath, &key, output)
  }
  if let Option<List<Bytes>>.Some { value } = move reused {
    identities = move value
  } else {
    run removeQuietly(&recordPath)
    let mut recorder = run BuildInputs.recorder()

    // Clang fills the codegen cache after the build looked for its objects; recorded, the next run
    // would find them changed and build once more.
    let units = run CodegenCache.directoryFor(output)
    run BuildInputs.exclude(&mut recorder, &units)
    if let Option<Path>.Some { value: store } = &run CodegenCache.sharedFor(output) {
      run BuildInputs.exclude(&mut recorder, &store)
    }
    run BuildInputs.exclude(&mut recorder, &run NativeCompile.directoryFor(output))
    let mut publication = Option<Path>.none()
    if let Option<&Path>.Some { value } = &manifest {
      let loaded = run Effect.result(Projects.load(value))
      if let Result<Project, ProjectError | FileError | OutOfMemoryError>.Success {
        value: project
      } = move loaded {
        publication = Option<Path>.some(
          run Path.join(Projects.outputDirectory(&project), "requests"),
        )
        run BuildInputs.exclude(
          &mut recorder,
          &run Path.join(Projects.outputDirectory(&project), "steps"),
        )
      }
    }
    if let Option<Path>.None = &publication {
      if let Option<Path>.Some { value } = move run Path.parent(output) {
        publication = Option<Path>.some(run Path.join(&value, "requests"))
      }
    }
    if let Option<Path>.Some { value } = &publication {
      run BuildInputs.exclude(&mut recorder, &value)
    }

    // Clang links the runner too, and a debug build reads the old one to see whether linking can
    // be skipped; the record checks the runner by its digest instead.
    run BuildInputs.exclude(&mut recorder, output)

    // The runner's exchange files and records change each run; a C source beside them would have
    // the build read them, and their digests would change the tests key every time.
    let sidecars = [".plan", ".receipt", ".progress", ".tests", ".tests.key", ".inputs"]
    let mut sidecar = usize.ZERO
    while sidecar < sidecars.length {
      let mut named = run Bytes.copy(Path.rawBytes(output))
      run Bytes.append(&mut named, String.utf8Bytes(sidecars[sidecar]))
      run BuildInputs.exclude(&mut recorder, &run Path.fromBytes(Bytes.asSlice(&named)))
      sidecar = sidecar + usize.ONE
    }

    // A runner's symbol map is read only to leave an unchanged one alone, and its debug bundle is
    // replaced, not read.
    run BuildInputs.exclude(&mut recorder, &run symbolMapFor(output))
    run BuildInputs.exclude(&mut recorder, &run debugBundleFor(output))

    // The runner's semantic cache is the build's own, as a program's is.
    if let Option<Path>.Some { value: cached } = &cacheHome {
      run BuildInputs.exclude(&mut recorder, &cached)
      if let Option<Path>.Some { value: caches } = move run Path.parent(&cached) {
        run BuildInputs.exclude(&mut recorder, &caches)
      }
    }
    let mut warned = Bytes.make()
    let built = run build(
      sourcePath,
      move manifest,
      borrowedPath(&cacheHome),
      output,
      display,
      Form.Executable,
      Stage.Final,
      move standardLibrary,
      move profile,
      Option<u64>.none(),
      Option<u64>.none(),
      move bindings,
      request,
      true,
      false,
      clang,
      &Option<Bytes>.none(),
      Option<&[u8]>.none(),
      Option<Bytes>.none(),
      false,
      &mut report,
      &mut warned,
      MirListing.Off,
      ignoreWarnings,
      true,
      Option<&CompilationRequest>.none(),
      unsandboxedTools,
      move publication,
      false,
      versions,
    )
      |> Effect.provideMut<FileSystem>(&mut recorder)
    let catalog = match move built {
      Compiled.Finished { status } => {
        run Progress.finish(&mut report, Path.rawBytes(output), false)
        return status
      }
      Compiled.Tests { identities: listed } => move listed
    }
    if let Option<Bytes>.Some { value: stamped } = &key {
      if BuildInputs.complete(&recorder) {
        let executable = run Effect.result(FileSystem.readFile(output))
        if let Result<Bytes, FileError | OutOfMemoryError>.Success { value } = &executable {
          let payload = run testBuildPayload(Bytes.asSlice(&value), &catalog)
          let record = run BuildInputs.encode(
            Bytes.asSlice(&stamped),
            Bytes.asSlice(&payload),
            &recorder,
          )

          // Without the record the next run builds again; it never changes this run.
          let written = run Effect.result(FileSystem.writeFile(&recordPath, Bytes.asSlice(&record)))
          drop written
        }
        drop executable
      }
    }
    identities = move catalog
  }
  run Progress.finish(&mut report, Path.rawBytes(output), true)
  let digest = TestRun.catalogDigest(List<Bytes>.asSlice(&identities))
  let nonce = run testNonce(Path.rawBytes(output), &digest)
  let plan = run TestRun.plan(&nonce, &digest, usize.toU64(List<Bytes>.length(&identities)))
  let mut planBytes = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut planBytes, b".plan")
  let planPath = run Path.fromBytes(Bytes.asSlice(&planBytes))
  let mut receiptBytes = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut receiptBytes, b".receipt")
  let receiptPath = run Path.fromBytes(Bytes.asSlice(&receiptBytes))
  let mut progressBytes = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut progressBytes, b".progress")
  let progressPath = run Path.fromBytes(Bytes.asSlice(&progressBytes))
  run removeQuietly(&receiptPath)
  run removeQuietly(&progressPath)
  run FileSystem.writeFile(&planPath, Bytes.asSlice(&plan))
  let limit = match &timeout.* {
    Option<Bytes>.Some { value } => Bytes.asSlice(&value)
    Option<Bytes>.None => b"60"
  }

  // The runner skips a test that passed in the last run when it would execute the same functions
  // on the same inputs (TEST-008). Its record holds the digests of the functions, which do not
  // name the compiler, Clang or the build's options, so the record is kept only while the runner's
  // build key, which names them, stays the same, with the time limit and the files besides Silk
  // sources the build read, such as the C sources it links; `--no-cache` removes it, so every
  // selected test runs.
  let mut testsBytes = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut testsBytes, b".tests")
  let testsPath = run Path.fromBytes(Bytes.asSlice(&testsBytes))
  let mut testsKeyBytes = run Bytes.copy(Bytes.asSlice(&testsBytes))
  run Bytes.append(&mut testsKeyBytes, b".key")
  let testsKeyPath = run Path.fromBytes(Bytes.asSlice(&testsKeyBytes))
  let mut recording = false
  let mut testsKey = Option<Bytes>.none()
  if !noCache && !wasi {
    if let Option<Bytes>.Some { value: built } = &key {
      let stored = run Effect.result(FileSystem.readFile(&recordPath))
      if let Result<Bytes, FileError | OutOfMemoryError>.Success { value: record } = &stored {
        if let Option<ContentHash>.Some { value: foreign } = BuildInputs.foreignDigest(
          Bytes.asSlice(&record),
        ) {
          let mut extended = run Bytes.copy(Bytes.asSlice(&built))
          run RuntimeEncoding.field(&mut extended, limit)
          run RuntimeEncoding.field(&mut extended, &ContentHash.digits(foreign))
          testsKey = Option<Bytes>.some(move extended)
        }
      }
      drop stored
    }
    if let Option<Bytes>.Some { value: stamped } = &testsKey {
      recording = true
      let kept = run Effect.result(FileSystem.readFile(&testsKeyPath))
      let mut sameKey = false
      if let Result<Bytes, FileError | OutOfMemoryError>.Success { value: previous } = &kept {
        sameKey = same(Bytes.asSlice(&previous), Bytes.asSlice(&stamped))
      }
      drop kept
      if !sameKey {
        run removeQuietly(&testsPath)
        let written = run Effect.result(
          FileSystem.writeFile(&testsKeyPath, Bytes.asSlice(&stamped)),
        )
        drop written
      }
    }
  }
  if !recording {
    run removeQuietly(&testsPath)
  }
  let mut status = 2
  let mut running = true
  while running {
    let mut previousProgress = Bytes.make()
    if wasi && run FileSystem.exists(&progressPath) {
      previousProgress = run FileSystem.readFile(&progressPath)
    }
    let mut process = run ChildProcess.request(output)

    // The test runs with an empty environment, but on Windows Winsock and the system's DLLs find
    // their files through `SystemRoot`: without it every socket fails with WSAEPROVIDERFAILEDINIT.
    static if Intrinsic.targetOperatingSystem() == "windows" {
      if let Option<Bytes>.Some { value } = move run HostInput.variableNamed("SystemRoot") {
        run ChildProcess.setVariableBytes(&mut process, b"SystemRoot", Bytes.asSlice(&value))
      }
    }
    if wasi {
      process = match move run WasiTools.request(output, limit, Option<&Path>.none()) {
        Option<ProcessRequest>.Some { value } => move value
        Option<ProcessRequest>.None => {
          return 2
        }
      }
    }
    if let Option<Bytes>.Some { value } = &file {
      run ChildProcess.addArgument(&mut process, "--file")
      run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&value))
    }
    if let Option<Bytes>.Some { value } = &filter {
      run ChildProcess.addArgument(&mut process, "--filter")
      run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&value))
    }
    run ChildProcess.addArgument(&mut process, "--silk-test-plan")
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&planBytes))
    run ChildProcess.addArgument(&mut process, "--silk-test-result")
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&receiptBytes))
    run ChildProcess.addArgument(&mut process, "--silk-test-progress")
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&progressBytes))
    run ChildProcess.addArgument(&mut process, "--silk-test-timeout")
    run ChildProcess.addArgumentBytes(&mut process, limit)
    if recording {
      run ChildProcess.addArgument(&mut process, "--silk-test-record")
      run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&testsBytes))
    }
    let outcome = run ChildProcess.submit(&process)
    run Writer.writeAll(ChildProcess.outputBytes(&outcome))

    // Wasmtime's report of a trap becomes the frames under the test, as a native trap's would.
    let mut trap = Option<WasmTrace.Trap>.none()
    if wasi {
      trap = run WasmTrace.frames(
        ChildProcess.errorBytes(&outcome),
        ChildProcess.outputBytes(&outcome),
        b"    ",
        Bytes.asSlice(&sourceDirectory),
      )
    }
    if let Option<WasmTrace.Trap>.Some { value: trapped } = &trap {
      run writeError(Bytes.asSlice(&trapped.output))
      if WasmTrace.interrupted(&trapped) {
        run writeError(b"silk test: the test did not finish within ")
        run writeError(limit)
        run writeError(b" s; pass --timeout <seconds> to change the limit, or 0 for none\n")
      } else if !WasmTrace.reported(&trapped) {
        run Writer.writeAll(b"    fatal trap: ")
        run Writer.writeAll(Bytes.asSlice(&trapped.reason))
        run Writer.writeAll(b"\n")
      }
      run Writer.writeAll(Bytes.asSlice(&trapped.frames))
    } else {
      run writeError(ChildProcess.errorBytes(&outcome))
    }
    status = 2
    running = false
    if let Option<i32>.Some { value } = move ChildProcess.exitCode(&outcome) {
      status = value

      // A WASI trap exits Wasmtime with a nonzero status instead of terminating it by signal.
      if wasi && status != 0 && run FileSystem.exists(&progressPath) {
        let nextProgress = run FileSystem.readFile(&progressPath)
        running = !same(Bytes.asSlice(&previousProgress), Bytes.asSlice(&nextProgress))
      }
    } else if let Option<i32>.Some { value: signal } = move ChildProcess.terminatingSignal(
      &outcome,
    ) {
      status = 128 + signal

      // The runner's alarm, SIGALRM on Linux and macOS, ends a test that outlives its limit.
      if signal == 14 {
        run writeError(b"silk test: the test did not finish within ")
        run writeError(limit)
        run writeError(b" s; pass --timeout <seconds> to change the limit, or 0 for none\n")
      }

      // A test that stops the runner, such as with a trap, leaves the progress record naming it.
      // A new runner reports that test as failed and continues after it; each restart moves past
      // one test, so the loop ends.
      running = run FileSystem.exists(&progressPath)
    }
  }
  if status >= 0 && status <= 1 {
    let received = run Effect.result(FileSystem.readFile(&receiptPath))
    let mut admitted = false
    if let Result<Bytes, FileError | OutOfMemoryError>.Success { value } = &received {
      if let Option<TestRun.Counts>.Some { value: counts } = move TestRun.admitReceipt(
        Bytes.asSlice(&plan),
        Bytes.asSlice(&value),
        status,
      ) {
        admitted = true
        if counts.selected != 0 {
          matched.* = true
        }
      }
    }
    drop received
    if !admitted {
      run writeError(b"silk test: the test runner did not write a valid receipt\n")
      status = 2
    }
  }
  run removeQuietly(&planPath)
  run removeQuietly(&receiptPath)
  run removeQuietly(&progressPath)
  return status
}

// Writes one project failure as the TypeScript CLI words it.
effect fn reportProject(problem: &ProjectError) -> ()
  ! WriterError {
  return match &problem.* {
    ProjectError.ManifestNotFound { start } => {
      run writeError(b"No silk.toml found from ")
      run writeError(Path.rawBytes(&start))
      run writeError(
        b"; run `silk init` to create a package here, or `silk init <name>` for a new folder\n",
      )
    }
    ProjectError.Uninspectable { path } => {
      run writeError(b"Cannot inspect ")
      run writeError(Path.rawBytes(&path))
      run writeError(b" while discovering a Silk project\n")
    }
    ProjectError.Unreadable { manifest } => {
      run writeError(b"Cannot read Silk project manifest ")
      run writeError(Path.rawBytes(&manifest))
      run writeError(b"\n")
    }
    ProjectError.InvalidManifest { manifest, line, detail } => {
      run writeManifestLocation(&manifest, line)
      run writeError(Bytes.asSlice(&detail))
      run writeError(b"\n")
    }
  }
}

// Builds one standalone executable package from the source and explicit CLI options.
// Project manifests never participate; dependencies and library shapes use a request.
//
// The `Compiled` line shows paths relative to `working`, the directory the user named them from.
effect fn buildSource(
  working: &Path,
  sourcePath: &Path,
  output: &Path,
  stage: Option<Stage>,
  standardLibrary: Option<Path>,
  input: ProfileInput,
  stats: bool,
  clang: &Option<Bytes>,
  mir: MirListing,
  ignoreWarnings: bool,
) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  let form = Form.Executable
  let selected = match move stage {
    Option<Stage>.Some { value } => value
    Option<Stage>.None => Stage.Final
  }
  let mut configured = move input
  configured.artifact = Option<Bytes>.some(run Bytes.copy(Projects.profileArtifact(form)))
  let profile = run InitialProfile.freeze(&configured)
  let host = hostTarget()
  let automaticSupply = SupplyRequest.Automatic
  let supplyRequest = &automaticSupply
  if form == Form.Executable && selected == Stage.Final
    && !(run linksOn(InitialProfile.target(&profile), &host, supplyRequest)) {
    run refuseCrossLink(InitialProfile.target(&profile), &host)
    return 2
  }
  let mut silent = Progress.off()
  let mut warned = Bytes.make()
  let built = run build(
    sourcePath,
    Option<&Path>.none(),
    Option<&Path>.none(),
    output,
    working,
    form,
    selected,
    move standardLibrary,
    move profile,
    Option<u64>.none(),
    Option<u64>.none(),
    List<Supplied>.make(),
    supplyRequest,
    false,
    stats,
    clang,
    &Option<Bytes>.none(),
    Option<&[u8]>.none(),
    Option<Bytes>.none(),
    true,
    &mut silent,
    &mut warned,
    mir,
    ignoreWarnings,
    true,
    Option<&CompilationRequest>.none(),
    false,
    Option<Path>.none(),
    false,
    run versionPolicy(false),
  )
  return match move built {
    Compiled.Finished { status } => status
    Compiled.Tests { identities } => {
      drop identities
      return 2
    }
  }
}

// The manifest `--manifest-path` names, or else the nearest one at or above `working`.
effect fn manifestFor(working: &Path, manifestPath: &Option<Bytes>) -> Path
  ! ApplicationError | ProjectError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  return match &manifestPath.* {
    Option<Bytes>.Some { value } => run pathArgument(working, Bytes.asSlice(&value))
    Option<Bytes>.None => run Projects.discover(working)
  }
}

effect fn discoveredProject(working: &Path, manifestPath: &Option<Bytes>) -> Project
  ! ApplicationError | ProjectError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let manifest = run manifestFor(working, manifestPath)
  return run Projects.load(&manifest)
}

// The projects one building command runs over, and whether they were selected as workspace
// members, which groups each one's report under a header.
struct Selection {
  projects: List<Project>,
  members: bool,
}

// Writes the member names of `workspace`, comma-separated, after `prefix`.
effect fn writeMemberNames(prefix: &[u8], workspace: &Workspace) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Allocator {
  let listed = List<Member>.asSlice(&workspace.members)
  let mut line = run Bytes.copy(prefix)
  let mut at = usize.ZERO
  while at < listed.length {
    if at > usize.ZERO {
      run Bytes.append(&mut line, b", ")
    }
    run Bytes.append(&mut line, Bytes.asSlice(&listed[at].name))
    at = at + usize.ONE
  }
  if listed.length == usize.ZERO {
    run Bytes.append(&mut line, b"none")
  }
  run Bytes.append(&mut line, b"\n")
  run writeError(Bytes.asSlice(&line))
}

// Selects the projects a building command runs over. Without `--package` or `--workspace` it is
// the located project alone, unless its manifest only defines a workspace, which selects every
// member. `--package` names members of the located workspace, or of the one enclosing the located
// project, and `--workspace` selects all of them; a workspace's own package comes first. A member
// whose root module is missing is skipped with a note unless `--package` names it. A selection that
// cannot be made is reported and answers `None`.
effect fn selected(working: &Path, options: &ProjectOptions) -> Option<Selection>
  ! ApplicationError | ProjectError | FileError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut Allocator {
  let manifest = run manifestFor(working, &options.manifestPath)
  let packages = List<Bytes>.asSlice(&options.packages)
  let explicit = packages.length > usize.ZERO
  let mut found = run Projects.workspace(&manifest)
  let virtual = match &found {
    Option<Workspace>.Some { value } => !value.packaged
    Option<Workspace>.None => false
  }
  let mut projects = List<Project>.make()
  if !explicit && !options.workspace && !virtual {
    run List<Project>.append(&mut projects, run Projects.load(&manifest))
    return Option<Selection>.some(Selection { projects: move projects, members: false })
  }
  if let Option<Workspace>.None = &found {
    if let Option<Path>.Some { value: directory } = move run Path.parent(&manifest) {
      if let Option<Path>.Some { value: enclosing } = move run Projects.enclosingWorkspace(
        &directory,
      ) {
        found = run Projects.workspace(&enclosing)
      }
    }
  }
  let workspace = match move found {
    Option<Workspace>.Some { value } => move value
    Option<Workspace>.None => {
      run writeError(b"silk: --package and --workspace select workspace members, but ")
      run writeError(Path.rawBytes(&manifest))
      run writeError(b" is not in a workspace\n")
      return Option<Selection>.none()
    }
  }
  let listed = List<Member>.asSlice(&workspace.members)
  if explicit {
    let mut at = usize.ZERO
    while at < packages.length {
      let wanted = Bytes.asSlice(&packages[at])
      let mut index = usize.ZERO
      while index < listed.length && !same(Bytes.asSlice(&listed[index].name), wanted) {
        index = index + usize.ONE
      }
      if index < listed.length {
        if !listed[index].rooted {
          run writeError(b"silk: workspace member `")
          run writeError(wanted)
          run writeError(
            b"` has no root module (its [package].main file is missing), so project commands cannot build it\n",
          )
          return Option<Selection>.none()
        }
        let member = run Path.join(&listed[index].directory, "silk.toml")
        run List<Project>.append(&mut projects, run Projects.loadMember(&member, &workspace))
      } else {
        let mut rootPackage = false
        if workspace.packaged {
          let root = run Projects.loadMember(&workspace.manifest, &workspace)
          if same(Projects.name(&root), wanted) {
            rootPackage = true
            run List<Project>.append(&mut projects, move root)
          }
        }
        if !rootPackage {
          run writeError(b"silk: the workspace at ")
          run writeError(Path.rawBytes(&workspace.manifest))
          run writeError(b" has no package named `")
          run writeError(wanted)
          run writeError(b"`\n")
          run writeMemberNames(b"silk: its members are: ", &workspace)
          return Option<Selection>.none()
        }
      }
      at = at + usize.ONE
    }
    return Option<Selection>.some(Selection { projects: move projects, members: true })
  }
  if workspace.packaged {
    run List<Project>.append(
      &mut projects,
      run Projects.loadMember(&workspace.manifest, &workspace),
    )
  }
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].rooted {
      let member = run Path.join(&listed[at].directory, "silk.toml")
      run List<Project>.append(&mut projects, run Projects.loadMember(&member, &workspace))
    } else {
      run writeError(b"Skipping ")
      run writeError(Bytes.asSlice(&listed[at].name))
      run writeError(b": its root module ([package].main) is missing\n")
      if listed[at].library {
        run writeError(
          b"  help: its source root has lib.silk; a library sets `kind = \"library\"` and `exports = [\"lib\"]` under [package]\n",
        )
      }
    }
    at = at + usize.ONE
  }
  return Option<Selection>.some(Selection { projects: move projects, members: true })
}

// Names each override that a selected package's silk.local.toml writes, once, because the file
// changes what the command reads without any manifest saying so. A command a tasks program runs,
// which finds `SILK_PROJECT_ROOT` set, leaves that to the command that started the program.
effect fn noteOverrides(projects: &[Project]) -> ()
  ! HostInputError | WriterError | OutOfMemoryError
  ? &mut FileSystem | &mut HostInput | &mut Allocator {
  if let Option<Bytes>.Some { .. } = move run HostInput.variableNamed("SILK_PROJECT_ROOT") {
    return ()
  }
  let mut written = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < projects.length {
    let notes = run PackageSources.overrideNotes(Projects.directory(&projects[at]))
    let listed = notes.asSlice()
    let mut note = usize.ZERO
    while note < listed.length {
      let mut known = false
      let seen = written.asSlice()
      let mut earlier = usize.ZERO
      while earlier < seen.length {
        if same(seen[earlier].asSlice(), listed[note].asSlice()) {
          known = true
        }
        earlier = earlier + usize.ONE
      }
      if !known {
        run writeError(b"silk: note: ")
        run writeError(listed[note].asSlice())
        run writeError(b"\n")
        run written.append(run Bytes.copy(listed[note].asSlice()))
      }
      note = note + usize.ONE
    }
    at = at + usize.ONE
  }
}

// `selected`, reporting a manifest that cannot be used.
effect fn selectProjects(working: &Path, options: &ProjectOptions) -> Option<Selection>
  ! ApplicationError | FileError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut Allocator {
  let attempted = run Effect.result(selected(working, options))
  return match move attempted {
    Result<
      Option<Selection>,
      ApplicationError | ProjectError | FileError | OutOfMemoryError | WriterError
    >.Success {
      value
    } => move value
    Result<
      Option<Selection>,
      ApplicationError | ProjectError | FileError | OutOfMemoryError | WriterError
    >.Failure {
      error
    } => match move error {
      ProjectError problem => {
        run reportProject(&problem)
        return Option<Selection>.none()
      }
      ApplicationError application => {
        fail move application
      }
      FileError file => {
        fail move file
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      WriterError written => {
        fail move written
      }
    }
  }
}

// Writes the header that groups one workspace member's report: `Package <name> (<directory>)`.
effect fn writePackageHeader(project: &Project) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Allocator | &mut Writer {
  let mut line = run Bytes.copy(b"Package ")
  run Bytes.append(&mut line, Projects.name(project))
  run Bytes.append(&mut line, b" (")
  run Bytes.append(&mut line, Path.rawBytes(Projects.directory(project)))
  run Bytes.append(&mut line, b")\n")
  run Writer.writeAll(Bytes.asSlice(&line))
}

// Writes `Workspace summary: <n> packages succeeded, <m> failed` after a workspace run.
effect fn writeWorkspaceSummary(succeeded: usize, total: usize) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Allocator | &mut Writer {
  let mut summary = run Bytes.copy(b"Workspace summary: ")
  run JsonText.appendDecimal(&mut summary, succeeded)
  if succeeded == usize.ONE {
    run Bytes.append(&mut summary, b" package succeeded, ")
  } else {
    run Bytes.append(&mut summary, b" packages succeeded, ")
  }
  run JsonText.appendDecimal(&mut summary, total - succeeded)
  run Bytes.append(&mut summary, b" failed\n")
  run Writer.writeAll(Bytes.asSlice(&summary))
}

// Loads the project that `--manifest-path` names, or else the one whose manifest is nearest above
// `working`; when there is none it reports why and answers `None`.
effect fn locateProject(working: &Path, manifestPath: &Option<Bytes>) -> Option<Project>
  ! ApplicationError | FileError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut Allocator {
  let located = run Effect.result(discoveredProject(working, manifestPath))
  return match move located {
    Result<Project, ApplicationError | ProjectError | FileError | OutOfMemoryError>.Success {
      value
    } => Option<Project>.some(move value)
    Result<Project, ApplicationError | ProjectError | FileError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      ProjectError problem => {
        run reportProject(&problem)
        return Option<Project>.none()
      }
      ApplicationError application => {
        fail move application
      }
      FileError file => {
        fail move file
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// The output directory `clean` removes: the located project's, or the workspace's when the
// manifest only defines a workspace.
effect fn cleanedOutput(working: &Path, manifestPath: &Option<Bytes>) -> Path
  ! ApplicationError | ProjectError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let manifest = run manifestFor(working, manifestPath)
  if let Option<Workspace>.Some { value: workspace } = move run Projects.workspace(&manifest) {
    if !workspace.packaged {
      return move workspace.outputDirectory
    }
  }
  let project = run Projects.load(&manifest)
  return run Path.fromBytes(Path.rawBytes(Projects.outputDirectory(&project)))
}

// Removes the project's output directory, or says there is nothing to clean: status 0, or 2 when
// it cannot.
effect fn cleanProject(working: &Path, command: CleanCommand) -> i32
  ! ApplicationError | FileError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut Allocator | &mut Writer {
  let located = run Effect.result(cleanedOutput(working, &command.manifestPath))
  let directory = match move located {
    Result<Path, ApplicationError | ProjectError | FileError | OutOfMemoryError>.Success {
      value
    } => move value
    Result<Path, ApplicationError | ProjectError | FileError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      ProjectError problem => {
        run reportProject(&problem)
        return 2
      }
      ApplicationError application => {
        fail move application
      }
      FileError file => {
        fail move file
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let output = Path.rawBytes(&directory)
  let directoryExists = run CommandPath.exists(output, true)
  let fileExists = run CommandPath.exists(output, false)
  if !directoryExists && !fileExists {
    run Writer.writeAll(b"Nothing to clean: ")
    run Writer.writeAll(output)
    run Writer.writeAll(b" does not exist\n")
    return 0
  }

  // A copy of an earlier build may still be writing its cache there.
  run SemanticCache.settle(&directory)
  let removed = run Effect.result(Projects.removeOutput(&directory))
  return match move removed {
    Result<(), FileError | OutOfMemoryError>.Success { .. } => {
      run Writer.writeAll(b"Removed ")
      run Writer.writeAll(output)
      run Writer.writeAll(b"\n")
      return 0
    }
    Result<(), FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        drop failure
        run writeError(b"Cannot remove build directory ")
        run writeError(output)
        run writeError(b"\n")
        return 2
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// One attempted project compilation.
struct ProjectArtifact {
  status: i32,
  target: Target,
  path: Path,
}

// Writes `value` in decimal.
effect fn writeDecimal(value: usize) -> ()
  ! WriterError {
  if value >= 10 {
    run writeDecimal(usize.divide(value, 10))
  }
  return run writeError(&[usize.toU8(48 + usize.remainder(value, 10))])
}

// Writes `Invalid Silk project manifest <manifest>:<line>: `, without the line when it is zero.
// Writes a refused dependency: at the manifest line that is at fault, as other manifest errors are,
// or with `silk: invalid` when no manifest line is.
effect fn writeDependency(invalid: &InvalidDependency) -> ()
  ! WriterError {
  if Bytes.asSlice(&invalid.manifest).length > usize.ZERO {
    run writeError(b"Invalid Silk project manifest ")
    run writeError(Bytes.asSlice(&invalid.manifest))
    if invalid.line > usize.ZERO {
      run writeError(b":")
      run writeDecimal(invalid.line)
    }
    run writeError(b": ")
  } else {
    run writeError(b"silk: invalid ")
  }
  run writeError(Bytes.asSlice(&invalid.detail))
  return run writeError(b"\n")
}

effect fn writeManifestLocation(manifest: &Path, line: usize) -> ()
  ! WriterError {
  run writeError(b"Invalid Silk project manifest ")
  run writeError(Path.rawBytes(manifest))
  if line > usize.ZERO {
    run writeError(b":")
    run writeDecimal(line)
  }
  return run writeError(b": ")
}

// Plans the project's compilations (see `driver/ProjectPlan`), or answers `None` after reporting
// why there are none as the TypeScript CLI words it.
effect fn projectPlans(options: &ProjectOptions) -> Option<List<ProjectPlan>>
  ! TomlError | OutOfMemoryError | WriterError
  ? &mut Allocator {
  return run reportedPlans(run Effect.result(ProjectPlans.make(options, hostTarget())))
}

effect fn reportedPlans(
  planned: Result<List<ProjectPlan>, PlanError | TomlError | OutOfMemoryError>,
) -> Option<List<ProjectPlan>>
  ! TomlError | OutOfMemoryError | WriterError
  ? &mut Allocator {
  return match move planned {
    Result<List<ProjectPlan>, PlanError | TomlError | OutOfMemoryError>.Success { value } => Option<
      List<ProjectPlan>
    >.some(move value)
    Result<List<ProjectPlan>, PlanError | TomlError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      PlanError problem => {
        match move problem {
          PlanError.UnknownTarget { selector } => {
            run writeError(b"Unsupported target ")
            run writeError(Bytes.asSlice(&selector))
            run writeError(b"\n")
          }
        }
        return Option<List<ProjectPlan>>.none()
      }
      TomlError malformed => {
        fail move malformed
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// Builds one planned compilation into `<output-dir>/llvm/<target>/<profile>/`, where the profile
// directory is the named project profile the plan builds, or else `debug`, `release` or
// `release-with-debug` from the plan's optimization and debug information, in the form and stage the manifest selects and with the file name
// `Projects.artifact` gives. A plan whose profile names no artifact takes the manifest's form.
// An executable requires a supported link supply, and a shared library is not native yet.
fn silentProgress() -> ProgressSettings {
  return ProgressSettings {
    display: ProgressDisplay.Off,
    color: false,
    width: 80,
    quiet: false,
    compact: false,
    position: 0,
    units: 0,
    timings: false,
    costs: false,
  }
}

effect fn progressTerminal() -> bool {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return run WindowsConsole.enableAnsi(2)
  } else {
    return run NativeDescriptor.isTerminal(2)
  }
}

// How `build`, `check` and `run` report progress on standard error, from `--progress`, `--quiet`,
// SILK_PROGRESS and NO_COLOR. `--progress` wins over SILK_PROGRESS; `auto`, the default, redraws a
// live line only when standard error is a terminal that understands cursor movement, and writes
// plain lines otherwise. A command over several `units` shows one line per finished unit.
effect fn progressSettings(options: &ProjectOptions, units: usize) -> ProgressSettings
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  return run progressSettingsFor(&options.progress, options.quiet, options.timings, units)
}

// `progressSettings` for a command that takes these options one by one.
effect fn progressSettingsFor(
  progress: &Option<Bytes>,
  quiet: bool,
  timings: bool,
  units: usize,
) -> ProgressSettings
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let mut chosen = run Bytes.copy(b"auto")
  if let Option<Bytes>.Some { value } = move run HostInput.variableNamed("SILK_PROGRESS") {
    if ProjectCommands.isProgressDisplay(Bytes.asSlice(&value)) {
      chosen = move value
    }
  }
  if let Option<Bytes>.Some { value } = &progress.* {
    chosen = run Bytes.copy(Bytes.asSlice(&value))
  }
  let mut display = ProgressDisplay.Plain
  if same(Bytes.asSlice(&chosen), b"never") {
    display = ProgressDisplay.Off
  } else if same(Bytes.asSlice(&chosen), b"live") {
    static if Intrinsic.targetOperatingSystem() == "windows" {
      let _enabled = run WindowsConsole.enableAnsi(2)
    }
    display = ProgressDisplay.Live
  } else if same(Bytes.asSlice(&chosen), b"auto") && run progressTerminal() {
    display = ProgressDisplay.Live
    if let Option<Bytes>.Some { value: terminal } = move run HostInput.variableNamed("TERM") {
      if same(Bytes.asSlice(&terminal), b"dumb") {
        display = ProgressDisplay.Plain
      }
    }
  }
  let mut color = true
  if let Option<Bytes>.Some { value } = move run HostInput.variableNamed("NO_COLOR") {
    color = Bytes.length(&value) == usize.ZERO
  }
  let mut width: usize = 80
  if let Option<Bytes>.Some { value: columns } = move run HostInput.variableNamed("COLUMNS") {
    let digits = Bytes.asSlice(&columns)
    let mut parsed = usize.ZERO
    let mut at = usize.ZERO
    while at < digits.length && at < 5 && digits[at] >= 48 && digits[at] <= 57 {
      parsed = parsed * 10 + u8.toUsize(digits[at] - 48)
      at = at + usize.ONE
    }
    if at == digits.length && parsed >= 20 {
      width = parsed
    }
  }
  return ProgressSettings {
    display: display,
    color: color,
    width: width,
    quiet: quiet,
    compact: units > usize.ONE,
    position: 0,
    units: units,
    timings: timings,
    costs: false,
  }
}

// Starts one unit's progress report: `<verb> <package> (<target>, <profile>)`.
effect fn startProgress(
  settings: &ProgressSettings,
  verb: &[u8],
  project: &Project,
  target: &Target,
  profile: &[u8],
) -> Progress
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut detail = run Bytes.copy(Target.name(target))
  if profile.length > usize.ZERO {
    run Bytes.append(&mut detail, b", ")
    run Bytes.append(&mut detail, profile)
  }
  return run Progress.start(settings, verb, Projects.name(project), Bytes.asSlice(&detail))
}

// After several packages: `Finished 3 packages in <time>` or `Failed 1 of 3 packages in <time>`.
effect fn writeUnitsSummary(
  settings: &ProgressSettings,
  started: Progress,
  succeeded: usize,
  total: usize,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut whole = move started
  let mut what = Bytes.make()
  if succeeded < total {
    run Progress.appendCount(&mut what, total - succeeded)
    run Bytes.append(&mut what, b" of ")
  }
  run Progress.appendCount(&mut what, total)
  if total == usize.ONE {
    run Bytes.append(&mut what, b" package")
  } else {
    run Bytes.append(&mut what, b" packages")
  }
  run Progress.finish(&mut whole, Bytes.asSlice(&what), succeeded == total)
}

// The reporter that times a whole multi-package command; it writes only its final line.
effect fn unitsProgress(settings: &ProgressSettings) -> Progress
  ! OutOfMemoryError
  ? &mut Allocator {
  let whole = ProgressSettings {
    display: settings.display,
    color: settings.color,
    width: settings.width,
    quiet: true,
    compact: false,
    position: 0,
    units: 0,
    timings: false,
    costs: false,
  }
  return run Progress.start(&whole, b"", b"", b"")
}

effect fn buildProjectTarget(
  project: &Project,
  plan: ProjectPlan,
  standardLibrary: &Option<Path>,
  clang: &Option<Bytes>,
  headed: bool,
  abandon: bool,
  settings: &ProgressSettings,
  compiler: &Option<Bytes>,
  ignoreWarnings: bool,
  shareWalk: bool,
  versions: Versions,
) -> ProjectArtifact
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  // The profile may build another artifact from another root module than the package's own.
  let form = ProjectPlans.form(&plan, project)

  // A library is Silk source for other packages: building it checks it and makes no artifact.
  if form == Form.Library {
    return run checkTarget(
      project,
      move plan,
      standardLibrary,
      false,
      false,
      false,
      abandon,
      settings,
      compiler,
      ignoreWarnings,
      &mut ModuleSourceFiles.snapshot(),
      versions,
    )
  }
  let entry = run Path.fromBytes(Path.rawBytes(ProjectPlans.entry(&plan, project)))
  run requireRootModule(project, &entry)
  let ProjectPlan {
    input: planned,
    bindings,
    task,
    maxMemory,
    stackSize,
    entry: _,
    unsandboxedTools
  } = move plan
  let stage = Stage.Final
  let mut input = move planned
  if let Option<Bytes>.None = &input.artifact {
    input.artifact = Option<Bytes>.some(run Bytes.copy(Projects.profileArtifact(form)))
  }
  let profile = run InitialProfile.freeze(&input)
  let target = Target.forId(Target.id(InitialProfile.target(&profile)))
  let optimization = match move InitialProfile.text(&profile, b"optimization") {
    Option<&[u8]>.Some { value } => value
    Option<&[u8]>.None => run invalidBuildProfile()
  }

  let profileName = Projects.mode(optimization)

  let path = if task {
    // Each package's tasks program has its own directory: one task may run another package's
    // tasks in the same workspace, and Windows cannot replace an executable while it runs.
    let tasks = run Path.join(Projects.outputDirectory(project), "steps/tasks")
    let packageDirectory = run Path.joinBytes(&tasks, Projects.name(project))
    let targetDirectory = run Path.joinBytes(&packageDirectory, Target.name(&target))
    run Path.join(
      &targetDirectory,
      if same(Target.operatingSystem(&target), b"windows") {
        "tasks.exe"
      } else {
        "tasks"
      },
    )
  } else {
    run Projects.artifactAs(project, form, Target.name(&target), profileName)
  }
  if form == Form.Executable && stage == Stage.Final
    && !(run linksOn(&target, &hostTarget(), &SupplyRequest.Automatic)) {
    run refuseCrossLink(&target, &hostTarget())
    return ProjectArtifact { status: 2, target: target, path: move path }
  }
  if let Option<Path>.Some { value: directory } = move run Path.parent(&path) {
    run FileSystem.createDirectoriesRecursively(&directory)
  }
  let library = match &standardLibrary.* {
    Option<Path>.Some { value } => Option<Path>.some(run Path.fromBytes(Path.rawBytes(&value)))
    Option<Path>.None => Option<Path>.none()
  }

  // A headed build names its target before its diagnostics, as `silk check` does.
  let mut heading = Option<Bytes>.none()
  if headed {
    heading = Option<Bytes>.some(run Bytes.copy(Target.name(&target)))
  }
  let mut progress = if task {
    // The task program is not the package's artifact, which its own build reports.
    let mut subject = run Bytes.copy(Projects.name(project))
    run Bytes.append(&mut subject, b" tasks")
    let mut detail = run Bytes.copy(Target.name(&target))
    run Bytes.append(&mut detail, b", ")
    run Bytes.append(&mut detail, profileName)
    run Progress.start(settings, b"Compiling", Bytes.asSlice(&subject), Bytes.asSlice(&detail))
  } else {
    run startProgress(settings, b"Compiling", project, &target, profileName)
  }
  let cacheHome = if task {
    run SemanticCache.directory(
      &run Path.join(Projects.outputDirectory(project), "steps/tasks"),
      Projects.name(project),
    )
  } else {
    run SemanticCache.directory(Projects.outputDirectory(project), Projects.name(project))
  }

  // An executable whose last build read the same files as this one would is reused as it is, so a
  // build that changes nothing reads its inputs and nothing else (`reusedBuild`).
  let record = run reuseRecordFor(&path)
  let mut key = Option<Bytes>.none()

  // The compiler's identity (`compiler`, from `CacheStamp.compiler`), which keys the reuse record and stamps the cache.
  let mut stamp = Option<Bytes>.none()
  let mut wanted = form == Form.Executable && stage == Stage.Final
  if let Option<Path>.Some { .. } = &cacheHome {
    wanted = true
  }
  if wanted {
    if let Option<Bytes>.Some { value } = &compiler.* {
      stamp = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&value)))
    }
  }
  if form == Form.Executable && stage == Stage.Final {
    let manifestPath = Option<&Path>.some(Projects.manifest(project))
    key = run testBuildKey(
      b"silk-build-1",
      &entry,
      &manifestPath,
      &path,
      Projects.directory(project),
      standardLibrary,
      &profile,
      &bindings,
      clang,
      &stamp,
      unsandboxedTools,
    )
    let current = move key
    key = run withMemoryLimit(move current, &maxMemory, &stackSize)
  }
  let mut reused = false
  let mut built = Compiled.Finished { status: 0 }

  // `--costs` charges what a walk lowers, so its build lowers everything: it reuses no artifact
  // and reads no semantic cache.
  let costing = Progress.costing(&progress)
  if costing {
    key = Option<Bytes>.none()
  }
  if let Option<Bytes>.Some { .. } = &key {
    // A reused build prints the warnings the build that made it printed, which an
    // `--ignore-warnings` build recorded, and fails for them as that build would have without it.
    if let Option<Bytes>.Some { value: warnings } = move run reusedBuild(&record, &key, &path) {
      reused = true
      let mut headed = false
      run writeHeaded(&heading, &mut headed, Bytes.asSlice(&warnings), &mut progress)
      if !ignoreWarnings && Bytes.length(&warnings) > usize.ZERO {
        run writeError(warningsRefused())
        built = Compiled.Finished { status: 1 }
      }
    }
  }
  let mut warned = Bytes.make()
  if !reused {
    run removeQuietly(&record)
    let mut recorder = run BuildInputs.recorder()

    // The caches beside the artifact are the build's own, and the record checks the artifact by
    // its digest.
    run BuildInputs.exclude(&mut recorder, &run CodegenCache.directoryFor(&path))
    if let Option<Path>.Some { value: store } = &run CodegenCache.sharedFor(&path) {
      run BuildInputs.exclude(&mut recorder, &store)
    }
    run BuildInputs.exclude(&mut recorder, &run NativeCompile.directoryFor(&path))
    run BuildInputs.exclude(
      &mut recorder,
      &run Path.join(Projects.outputDirectory(project), "steps"),
    )
    if task {
      if let Option<Path>.Some { value } = move run Path.parent(&path) {
        run BuildInputs.exclude(&mut recorder, &run Path.join(&value, "requests"))
      }
    }
    run BuildInputs.exclude(
      &mut recorder,
      &run Path.join(Projects.outputDirectory(project), "requests"),
    )
    if let Option<Path>.Some { value: cached } = &cacheHome {
      run BuildInputs.exclude(&mut recorder, &cached)

      // Its parent holds only package caches. The first build that saves one makes it, so a
      // recorded look at it would find the next build changed.
      if let Option<Path>.Some { value: caches } = move run Path.parent(&cached) {
        run BuildInputs.exclude(&mut recorder, &caches)
      }
    }
    run BuildInputs.exclude(&mut recorder, &path)
    run BuildInputs.exclude(&mut recorder, &run symbolMapFor(&path))
    run BuildInputs.exclude(&mut recorder, &run debugBundleFor(&path))
    run BuildInputs.exclude(&mut recorder, &record)
    let mut semanticCache = borrowedPath(&cacheHome)
    if costing {
      semanticCache = Option<&Path>.none()
    }
    built = run build(
      &entry,
      Option<&Path>.some(Projects.manifest(project)),
      semanticCache,
      &path,
      Projects.directory(project),
      form,
      stage,
      move library,
      move profile,
      move maxMemory,
      move stackSize,
      move bindings,
      &SupplyRequest.Automatic,
      false,
      false,
      clang,
      &heading,
      Option<&[u8]>.none(),
      move stamp,
      abandon,
      &mut progress,
      &mut warned,
      MirListing.Off,
      ignoreWarnings,
      shareWalk,
      Option<&CompilationRequest>.none(),
      unsandboxedTools,
      if task {
        Option<Path>.none()
      } else {
        Option<Path>.some(run Path.join(Projects.outputDirectory(project), "requests"))
      },
      task,
      versions,
    )
      |> Effect.provideMut<FileSystem>(&mut recorder)
    let succeeded = match &built {
      Compiled.Finished { status } => status == 0
      Compiled.Tests { .. } => false
    }
    if let Option<Bytes>.Some { value: stamped } = &key {
      if succeeded && BuildInputs.complete(&recorder) {
        run recordBuild(&record, Bytes.asSlice(&stamped), &recorder, &path, Bytes.asSlice(&warned))
      }
    }
  }
  if Progress.enabled(&progress) {
    let finished = match &built {
      Compiled.Finished { status } => status == 0
      Compiled.Tests { .. } => false
    }

    // A finished build names its artifact; a failed one names the package.
    let mut shown = run Bytes.copy(Projects.name(project))
    if finished {
      // Named from the working directory, as the `Compiled` line names its paths.
      let workingDirectory = run HostInput.workingDirectory()
      let working = run CommandPath.fromHost(Bytes.asSlice(&workingDirectory))
      shown = run shownPath(&working, &path)
    }
    run Progress.finish(&mut progress, Bytes.asSlice(&shown), finished)
  }
  return match move built {
    Compiled.Finished { status } => ProjectArtifact {
      status: status,
      target: target,
      path: move path,
    }
    Compiled.Tests { identities } => {
      drop identities
      return ProjectArtifact { status: 2, target: target, path: move path }
    }
  }
}

// The `--clang` selection: a path resolves against the working directory; a bare name is searched
// on PATH when the build runs Clang. Absent without `--clang`, for SILK_CLANG or the PATH search.
effect fn clangFor(working: &Path, configured: &Option<Bytes>) -> Option<Bytes>
  ! ApplicationError | OutOfMemoryError
  ? &mut Allocator {
  return match &configured.* {
    Option<Bytes>.Some { value } => {
      if CommandPath.hasDirectory(Bytes.asSlice(&value)) {
        let resolved = run pathArgument(working, Bytes.asSlice(&value))
        return Option<Bytes>.some(run Bytes.copy(Path.rawBytes(&resolved)))
      }
      return Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&value)))
    }
    Option<Bytes>.None => Option<Bytes>.none()
  }
}

// The standard-library root: the `--stdlib` argument resolved against the working directory, or
// else the library installed beside this compiler (`<prefix>/lib/silk/stdlib`), when there is one.
effect fn standardLibraryFor(working: &Path, configured: &Option<Bytes>) -> Option<Path>
  ! ApplicationError | HostInputError | OutOfMemoryError
  ? &mut FileSystem | &mut HostInput | &mut Allocator {
  if let Option<Bytes>.Some { value } = &configured.* {
    let written = run pathArgument(working, Bytes.asSlice(&value))

    // A linked library is read at its real directory, so every spelling of it names one root.
    let mut directory = move written
    if let Option<Bytes>.Some { value: real } = move run HostPath.canonicalBytes(
      Path.rawBytes(&directory),
    ) {
      if let Option<Path>.Some { value: resolved } = move run CommandPath.pathOf(
        Bytes.asSlice(&real),
      ) {
        directory = move resolved
      }
    }

    // Every standard library carries its runtime catalog; without one the build would only find
    // that it selects no runtime (ARTIFACT-001).
    let mut catalog = run Bytes.copy(Path.rawBytes(&directory))
    run Bytes.append(&mut catalog, b"/compositions.json")
    if !run CommandPath.exists(Bytes.asSlice(&catalog), false) {
      let missing = !run CommandPath.exists(Path.rawBytes(&directory), true)
      fail ApplicationError.NotStandardLibrary {
        directory: run Bytes.copy(Path.rawBytes(&directory)),
        missing: missing,
      }
    }
    return Option<Path>.some(move directory)
  }
  let invoked = match move run HostInput.argument(usize.ZERO) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return Option<Path>.none()
    }
  }
  let searchPath = run HostInput.variableNamed("PATH")
  return match &searchPath {
    Option<Bytes>.Some { value } => run InstalledCompiler.standardLibrary(
      working,
      Bytes.asSlice(&invoked),
      Option<&[u8]>.some(Bytes.asSlice(&value)),
    )
    Option<Bytes>.None => run InstalledCompiler.standardLibrary(
      working,
      Bytes.asSlice(&invoked),
      Option<&[u8]>.none(),
    )
  }
}

// Builds every planned compilation of the project in order; each reports its progress on standard
// error. The status is 2 when any compilation failed operationally,
// else 1 when any build was refused, else 0.
// Builds the selected package through its command graph.
// `noting` names the overrides of silk.local.toml first; `silk task` already has when it
// falls back to this command.

effect fn buildProject(working: &Path, command: BuildCommand, noting: bool) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let BuildCommand { options, costs } = move command
  let selection = match move run selectProjects(working, &options) {
    Option<Selection>.Some { value } => move value
    Option<Selection>.None => {
      return 2
    }
  }
  if noting {
    run noteOverrides(List<Project>.asSlice(&selection.projects))
  }
  let standardLibrary = run standardLibraryFor(working, &options.standardLibrary)
  let clang = run clangFor(working, &options.clang)
  let projects = List<Project>.asSlice(&selection.projects)
  let mut settings = run progressSettings(&options, projects.length)
  settings.costs = costs
  let whole = run unitsProgress(&settings)

  // The compiler's identity hashes the whole executable, so a workspace reads it once for every member.
  let compiler = run CacheStamp.compiler()
  let mut status = 0
  let mut succeeded = usize.ZERO
  let mut at = usize.ZERO

  // Members build side by side in copies of the process, each after the members it depends on;
  // with `--costs` each reports in turn.
  let mut jobs = usize.ONE
  if projects.length > usize.ONE && !costs {
    jobs = run MemberChecks.jobs(MemberChecks.BUILD_BYTES)
  }
  if jobs > usize.ONE {
    let order = run dependencyOrder(projects)
    if run copiesMembers() {
      let work = MemberWork.Build { clang: move clang }
      let built = run runSideBySide(
        &work,
        projects,
        List<usize>.asSlice(&order),
        jobs,
        selection.members,
        &options,
        &standardLibrary,
        &settings,
        &compiler,
      )
      if selection.members {
        run writeUnitsSummary(&settings, move whole, built.succeeded, projects.length)
      }
      return built.status
    }
    if let Option<SideBySide>.Some { value: built } = move run runInProcesses(
      projects,
      List<usize>.asSlice(&order),
      jobs,
      false,
      false,
    ) {
      if selection.members {
        run writeUnitsSummary(&settings, move whole, built.succeeded, projects.length)
      }
      return built.status
    }
  }
  while at < projects.length {
    if selection.members {
      settings.position = at + usize.ONE
    }
    let built = run memberStatus(
      run Effect.result(
        buildOne(
          &projects[at],
          &options,
          &standardLibrary,
          &clang,
          &settings,
          at + usize.ONE == projects.length,
          &compiler,
          true,
        ),
      ),
    )
    if built == 0 {
      succeeded = succeeded + usize.ONE
    }
    status = worse(status, built)
    at = at + usize.ONE
  }
  if selection.members {
    run writeUnitsSummary(&settings, move whole, succeeded, projects.length)
  }
  return status
}

// The status of one selected project's command. A failure that stops it, such as an invalid
// dependency, is reported here and counts as status 1, so the remaining workspace members still
// run and the workspace summary is still written.
effect fn memberStatus(
  outcome: Result<
    i32,
    ApplicationError
      | InitialProfileProblem
      | FileError
      | ProcessError
      | HostInputError
      | InvalidModulePath
      | InvalidSourceRoot
      | InvalidDependency
      | MissingManifest
      | InvalidBuildComposition
      | MissingStandardLibrary
      | InvalidNativeLinkInput
      | TomlError
      | RegistrationClosed
      | ConflictingPackageSource
      | Cycle
      | RevisionMismatch
      | OutOfMemoryError
      | WriterError
  >,
) -> i32
  ! WriterError {
  return match move outcome {
    Result<
      i32,
      ApplicationError
        | InitialProfileProblem
        | FileError
        | ProcessError
        | HostInputError
        | InvalidModulePath
        | InvalidSourceRoot
        | InvalidDependency
        | MissingManifest
        | InvalidBuildComposition
        | MissingStandardLibrary
        | InvalidNativeLinkInput
        | TomlError
        | RegistrationClosed
        | ConflictingPackageSource
        | Cycle
        | RevisionMismatch
        | OutOfMemoryError
        | WriterError
    >.Success {
      value
    } => value
    Result<
      i32,
      ApplicationError
        | InitialProfileProblem
        | FileError
        | ProcessError
        | HostInputError
        | InvalidModulePath
        | InvalidSourceRoot
        | InvalidDependency
        | MissingManifest
        | InvalidBuildComposition
        | MissingStandardLibrary
        | InvalidNativeLinkInput
        | TomlError
        | RegistrationClosed
        | ConflictingPackageSource
        | Cycle
        | RevisionMismatch
        | OutOfMemoryError
        | WriterError
    >.Failure {
      error
    } => {
      let reported = run report(move error)
      drop reported
      return 1
    }
  }
}

// Builds one project's planned compilations, as `buildProject` does for each selected project.
// One package's settings: compact when the command spans several packages or this package plans
// several targets.
fn unitSettings(packages: &ProgressSettings, targets: usize) -> ProgressSettings {
  return ProgressSettings {
    display: packages.display,
    color: packages.color,
    width: packages.width,
    quiet: packages.quiet,
    compact: packages.compact || targets > usize.ONE,
    position: packages.position,
    units: packages.units,
    timings: packages.timings,
    costs: packages.costs,
  }
}

effect fn buildOne(
  project: &Project,
  options: &ProjectOptions,
  standardLibrary: &Option<Path>,
  clang: &Option<Bytes>,
  packages: &ProgressSettings,
  last: bool,
  compiler: &Option<Bytes>,
  shareWalk: bool,
) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let mut plans = match move run projectPlans(options) {
    Option<List<ProjectPlan>>.Some { value } => move value
    Option<List<ProjectPlan>>.None => {
      return 2
    }
  }
  let settings = unitSettings(packages, List<ProjectPlan>.length(&plans))
  let mut attempts = List<ProjectArtifact>.make()
  while List<ProjectPlan>.length(&plans) > usize.ZERO {
    let plan = List<ProjectPlan>.remove(&mut plans, usize.ZERO)
    run List<ProjectArtifact>.append(
      &mut attempts,
      run buildProjectTarget(
        project,
        move plan,
        standardLibrary,
        clang,
        true,
        last && List<ProjectPlan>.length(&plans) == usize.ZERO,
        &settings,
        compiler,
        options.ignoreWarnings,
        shareWalk,
        run versionPolicy(options.ignoreSilkVersion),
      ),
    )
  }

  // Each attempt has reported itself on standard error, so only the status is left to combine.
  let attempted = List<ProjectArtifact>.asSlice(&attempts)
  let mut status = 0
  let mut at = usize.ZERO
  while at < attempted.length {
    if attempted[at].status != 0 {
      if attempted[at].status == 2 || status == 2 {
        status = 2
      } else {
        status = 1
      }
    }
    at = at + usize.ONE
  }
  return status
}

// Writes one target's diagnostics to standard error: after a `[<target>]` header in the human
// format, as the TypeScript `silk check` does, and only when there are any.
effect fn writeDiagnostics(
  target: &Target,
  json: bool,
  diagnostics: &Bytes,
  progress: &mut Progress,
) -> ()
  ! WriterError {
  if Bytes.length(diagnostics) == usize.ZERO {
    return ()
  }

  // A compact report keeps its live line between phases; it is cleared before the diagnostics.
  run Progress.clear(&mut progress.*)
  if !json {
    run writeError(b"[")
    run writeError(Target.name(target))
    run writeError(b"]\n")
  }
  run writeError(Bytes.asSlice(diagnostics))
}

// Analyzes the project for one planned compilation without producing an artifact: every
// root-package declaration is checked, used or not (MODULE-004), with the syntax of every loaded
// module and the imports of every reached one. Diagnostics go to standard error in `format`,
// after a `[<target>]` header in the human format, as the TypeScript `silk check` writes them.
// The status is 0, 1 when a declaration is rejected, or 2 for an unsupported construct.
// The cache directories of the packages `sources`' own package depends on directly, below the
// output directory `output`, which a workspace shares among its members. A dependency's check
// sweeps the packages it depends on, so its own image holds theirs.
effect fn dependencyCaches(output: &Path, sources: &ModuleSources) -> List<Path>
  ! OutOfMemoryError
  ? &mut Allocator {
  let graph = run ModuleSourceFiles.packageGraph(sources)
  let names = run PackageGraph.directDependencies(&graph, ModuleSourceFiles.entry(sources))
  let listed = List<Bytes>.asSlice(&names)
  let mut directories = List<Path>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    if let Option<Path>.Some { value } = move run SemanticCache.directory(
      output,
      Bytes.asSlice(&listed[at]),
    ) {
      run List<Path>.append(&mut directories, move value)
    }
    at = at + usize.ONE
  }
  return move directories
}

// The cache directories, below the output directory `output`, of every package `sources` loads
// besides its own and the standard library.
effect fn packageCaches(output: &Path, sources: &ModuleSources) -> List<Path>
  ! OutOfMemoryError
  ? &mut Allocator {
  let graph = run ModuleSourceFiles.packageGraph(sources)
  let names = run PackageGraph.dependencyPackages(&graph)
  let listed = List<Bytes>.asSlice(&names)
  let mut directories = List<Path>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    if let Option<Path>.Some { value } = move run SemanticCache.directory(
      output,
      Bytes.asSlice(&listed[at]),
    ) {
      run List<Path>.append(&mut directories, move value)
    }
    at = at + usize.ONE
  }
  return move directories
}

// Ends the `cache` row of a build or check that opened `cache`, naming the module checks the
// store reused from the file and the ones it must run again: `258 checks reused, 2 stale`. The
// row's time is the wait for a write of the file that an earlier command left running, the rest
// of reading it, and adopting it.
effect fn endCacheRow(progress: &mut Progress, cache: &Option<CacheFile>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !Progress.enabled(&progress.*) {
    return ()
  }
  let mut reused = usize.ZERO
  let mut stale = usize.ZERO
  if let Option<CacheFile>.Some { value: file } = &cache.* {
    reused = file.adopted.roots
    stale = file.adopted.stale
  }
  let mut detail = Bytes.make()
  if reused == usize.ZERO && stale == usize.ZERO {
    run Bytes.append(&mut detail, b"nothing to reuse")
  } else {
    run Progress.appendCount(&mut detail, reused)
    if reused == usize.ONE {
      run Bytes.append(&mut detail, b" check reused")
    } else {
      run Bytes.append(&mut detail, b" checks reused")
    }
    if stale > usize.ZERO {
      run Bytes.append(&mut detail, b", ")
      run Progress.appendCount(&mut detail, stale)
      run Bytes.append(&mut detail, b" stale")
    }
  }
  run Progress.end(&mut progress.*, Bytes.asSlice(&detail))
}

effect fn checkTarget(
  project: &Project,
  plan: ProjectPlan,
  standardLibrary: &Option<Path>,
  json: bool,
  roots: bool,
  serve: bool,
  abandon: bool,
  settings: &ProgressSettings,
  compiler: &Option<Bytes>,
  ignoreWarnings: bool,
  snapshot: &mut SourceSnapshot,
  versions: Versions,
) -> ProjectArtifact
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  let entry = run Path.fromBytes(Path.rawBytes(ProjectPlans.entry(&plan, project)))
  run requireRootModule(project, &entry)
  let ProjectPlan {
    input: planned,
    bindings,
    task: tasksCheck,
    maxMemory: unlimited,
    stackSize: _,
    entry: _,
    unsandboxedTools
  } = move plan
  drop unlimited
  let mut input = move planned
  if let Option<Bytes>.None = &input.artifact {
    input.artifact = Option<Bytes>.some(
      run Bytes.copy(Projects.profileArtifact(Projects.form(project))),
    )
  }
  let profile = run InitialProfile.freeze(&input)
  let target = Target.forId(Target.id(InitialProfile.target(&profile)))
  let path = run Path.fromBytes(Path.rawBytes(Projects.manifest(project)))
  let library = match &standardLibrary.* {
    Option<Path>.Some { value } => Option<Path>.some(run Path.fromBytes(Path.rawBytes(&value)))
    Option<Path>.None => Option<Path>.none()
  }
  let mut format = DiagnosticFormat.Human { root: run diagnosticRoot(Projects.manifest(project)) }
  if json {
    format = DiagnosticFormat.Json { target: run Bytes.copy(Target.name(&target)) }
  }
  let mut out = Bytes.make()
  let mut progress = run startProgress(settings, b"Checking", project, &target, b"")

  // The last check of a run first asks a server that an earlier check of the same project left
  // behind (`CheckServer`); without one, it leaves one behind itself.
  let mut serving = Option<Bytes>.none()
  let mut serverKey = Bytes.make()

  // `SILK_CHECK_SERVER_TIMINGS` makes a server end each report with where its time went.
  let mut serverTimings = false
  if let Option<Bytes>.Some { .. } = move run HostInput.variableNamed("SILK_CHECK_SERVER_TIMINGS") {
    serverTimings = true
  }
  if serve && abandon && !roots {
    if let Option<Bytes>.Some { value: stamped } = &compiler.* {
      if let Option<Bytes>.Some { value: socket } = move run checkServerSocket(
        Bytes.asSlice(&stamped),
        project,
        &profile,
        standardLibrary,
        json,
        ignoreWarnings,
        match versions {
          Versions.Relaxed => true
          _ => false
        },
        &mut serverKey,
      ) {
        if let Option<CheckServer.Answer>.Some { value: answered } = move run CheckServer.ask(
          Bytes.asSlice(&socket),
          Bytes.asSlice(&serverKey),
        ) {
          run Bytes.append(&mut out, Bytes.asSlice(&answered.report))
          if answered.status == 0 {
            run Progress.end(&mut progress, b"")
            run Progress.borrowRow(&mut progress)
          } else {
            run Progress.refuse(&mut progress, answered.reported)
          }
          run writeDiagnostics(&target, json, &out, &mut progress)
          run Progress.finish(&mut progress, Projects.name(project), answered.status == 0)
          return ProjectArtifact { status: answered.status, target: target, path: move path }
        }
        serving = Option<Bytes>.some(move socket)
      }
    }
  }

  // A compiler that can stamp a cache records dependencies for the next command without
  // retaining answer fingerprints for source edits in this process. A check that leaves a server
  // behind retains them, so the server reruns only what an edit reaches.
  let mut mode = StoreMode.Transient
  if let Option<Bytes>.Some { .. } = &compiler.* {
    mode = StoreMode.Cached
  }
  if let Option<Bytes>.Some { .. } = &serving {
    mode = StoreMode.Revisable
  }
  // The tasks program keeps a cache of its own, so it and the package's check do not evict each
  // other's checks.
  let mut cacheName = run Bytes.copy(Projects.name(project))
  if tasksCheck {
    run Bytes.append(&mut cacheName, b".tasks")
  }
  let cacheHome = run SemanticCache.directory(
    Projects.outputDirectory(project),
    Bytes.asSlice(&cacheName),
  )

  // The cache file is read and decoded while the sources load.
  let mut prefetched = Option<SemanticCache.Prefetch>.none()
  if let Option<Bytes>.Some { .. } = &compiler.* {
    if let Option<Path>.Some { value: directory } = &cacheHome {
      let mut identity = Bytes.make()
      run InitialProfile.appendIdentity(&profile, &mut identity)
      prefetched = run SemanticCache.prefetch(&directory, false, Bytes.asSlice(&identity))
    }
  }
  let prepared = run prepare(
    &entry,
    Option<&Path>.some(Projects.manifest(project)),
    move library,
    &profile,
    move bindings,
    false,
    mode,
    Option<&[u8]>.none(),
    borrowedPath(&cacheHome),
    compiler,
    &mut snapshot.*,
    &format,
    &mut out,
    &mut progress,
    Option<&CompilationRequest>.none(),
    Option<&CompilationDefinition>.none(),
    unsandboxedTools,
    false,
    versions,
  )
  let analysis = match move prepared {
    Prepared.Ready { analysis } => move analysis
    Prepared.Finished { status } => {
      run writeDiagnostics(&target, json, &out, &mut progress)
      run Progress.finish(&mut progress, Projects.name(project), status == 0)
      return ProjectArtifact { status: status, target: target, path: move path }
    }
  }
  let Analysis {
    sources: loaded,
    store: analyzed,
    request: requested,
    rootPackage,
    checked: sweptModules,
    identity,
    runtime
  } = move analysis
  let mut sources = move loaded
  let mut store = move analyzed
  let mut request = move requested
  let mut cache = Option<CacheFile>.none()

  // The cache directories of the packages an executable loads, which its runtime walk is filed under.
  let mut loadedCaches = List<Path>.make()
  if let Option<Bytes>.Some { value: stamped } = &compiler.* {
    if let Option<Path>.Some { value: directory } = &cacheHome {
      let dependencies = run dependencyCaches(Projects.outputDirectory(project), &sources)
      if let Option<ModuleId>.Some { .. } = &runtime {
        loadedCaches = run packageCaches(Projects.outputDirectory(project), &sources)
      }
      run Progress.begin(&mut progress, ProgressPhase.Cache, usize.ZERO)
      cache = run SemanticCache.openPrefetched(
        &mut store,
        &request,
        &directory,
        Bytes.asSlice(&stamped),
        false,
        false,
        move prefetched,
        List<Path>.asSlice(&dependencies),
        List<Path>.asSlice(&loadedCaches),
      )
      run endCacheRow(&mut progress, &cache)
    }
  }
  let passed = run checkPass(
    &mut store,
    &mut request,
    &sources,
    &sweptModules,
    &rootPackage,
    &identity,
    &runtime,
    &format,
    json,
    roots,
    ignoreWarnings,
    &cache,
    &cacheHome,
    &loadedCaches,
    true,
    &mut out,
    &mut progress,
  )
  let status = passed.status
  if status == 0 {
    run Progress.end(&mut progress, b"")
    run Progress.borrowRow(&mut progress)
  } else {
    run Progress.refuse(&mut progress, passed.reported)
  }
  run writeDiagnostics(&target, json, &out, &mut progress)
  run Progress.finish(&mut progress, Projects.name(project), status == 0)

  // A store that reused the cache's checks holds them resting on nothing, so an edit would never
  // reach them; and while the cache answers, a check by itself is about as fast as a server's. So
  // only a check the cache could not answer leaves a server behind (silk-lang/silk#3116).
  let reused = match &cache {
    Option<CacheFile>.Some { value } => value.adopted.roots > usize.ZERO
    Option<CacheFile>.None => false
  }
  if let Option<Bytes>.Some { value: socket } = &serving {
    // The check has reported; a copy of the process stays behind with its store and answers the
    // next checks of this project, and this process exits as before.
    if !reused && CheckServer.detach() {
      run serveChecks(
        Bytes.asSlice(&socket),
        Bytes.asSlice(&serverKey),
        &mut store,
        &mut request,
        &mut sources,
        &identity,
        &runtime,
        &format,
        json,
        ignoreWarnings,
        &cache,
        &cacheHome,
        &loadedCaches,
        serverTimings,
      )
      CheckServer.exit(0)
    }
  }
  if abandon {
    // The process exits right after this check, and its exit returns the store's pages at once,
    // so they are not freed one by one first.
    run abandonValue(move store)
    run abandonValue(move sources)
    run abandonValue(move request)
    run abandonValue(move cache)
  }
  return ProjectArtifact { status: status, target: target, path: move path }
}

// The socket of the server that answers checks of `project` with this compiler, profile and
// options, with the key a client sends it written onto `key`; none when checks are not served:
// on hosts without Unix sockets.
effect fn checkServerSocket(
  compiler: &[u8],
  project: &Project,
  profile: &InitialProfile,
  standardLibrary: &Option<Path>,
  json: bool,
  ignoreWarnings: bool,
  relaxed: bool,
  key: &mut Bytes,
) -> Option<Bytes>
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  if !CheckServer.supported() {
    return Option<Bytes>.none()
  }
  run RuntimeEncoding.field(&mut key.*, b"silk-check-server 1")
  run RuntimeEncoding.field(&mut key.*, compiler)
  run RuntimeEncoding.field(&mut key.*, Path.rawBytes(Projects.manifest(project)))
  let mut identity = Bytes.make()
  run InitialProfile.appendIdentity(profile, &mut identity)
  run RuntimeEncoding.field(&mut key.*, Bytes.asSlice(&identity))
  match &standardLibrary.* {
    Option<Path>.Some { value } => run RuntimeEncoding.field(&mut key.*, Path.rawBytes(&value))
    Option<Path>.None => run RuntimeEncoding.field(&mut key.*, b"")
  }
  let mut flags: u64 = 0
  if json {
    flags = flags + 1
  }
  if ignoreWarnings {
    flags = flags + 2
  }
  if relaxed {
    flags = flags + 4
  }
  run RuntimeEncoding.word(&mut key.*, flags)

  // The environment a check reads (a tool, the registry home, a debug switch) is part of what it
  // answers, so a client with another environment asks another server.
  let read: [string; 17] = [
    "PATH",
    "HOME",
    "SILK_HOME",
    "SILK_CLANG",
    "SILK_LLVM_AR",
    "SILK_COMPILER",
    "SILK_OFFLINE",
    "SILK_PROFILE_USE",
    "SILK_PROFILE_GENERATE",
    "SILK_VERIFY_MIR",
    "SILK_WALK_WORKERS",
    "SILK_CHECK_SERVER_TIMINGS",
    "SDKROOT",
    "DEVELOPER_DIR",
    "NO_COLOR",
    "TERM",
    "COLUMNS",
  ]
  let mut at = usize.ZERO
  while at < 17 {
    match move run HostInput.variableNamed(read[at]) {
      Option<Bytes>.Some { value } => {
        run RuntimeEncoding.word(&mut key.*, 1)
        run RuntimeEncoding.field(&mut key.*, Bytes.asSlice(&value))
      }
      Option<Bytes>.None => run RuntimeEncoding.word(&mut key.*, 0)
    }
    at = at + usize.ONE
  }
  let runtimeDirectory = run HostInput.variableNamed("XDG_RUNTIME_DIR")
  let mut socket = match move run CheckServer.directory(&runtimeDirectory) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return Option<Bytes>.none()
    }
  }
  run Bytes.append(&mut socket, b"/silk-check-")
  let digits = ContentHash.digits(ContentHash.of(Bytes.asSlice(&key.*)))
  run Bytes.append(&mut socket, Slice.view<u8>(&digits, usize.ZERO, 24))
  run Bytes.append(&mut socket, b".sock")
  return Option<Bytes>.some(move socket)
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Answers the checks of clients that send `key` on the socket at `socket` from the store the
// first check left, until no client comes for a while, the program's shape changes (a manifest or
// the root package's list of files), or the computer has less memory to spare than the server
// holds (`CheckServer.crowded`). Before each check it reads the changed sources into the store,
// which reruns only the units they reach.
effect fn serveChecks(
  socket: &[u8],
  key: &[u8],
  store: &mut Semantic,
  request: &mut SemanticRequest,
  sources: &mut ModuleSources,
  identity: &ModuleId,
  runtime: &Option<ModuleId>,
  format: &DiagnosticFormat,
  json: bool,
  ignoreWarnings: bool,
  cache: &Option<CacheFile>,
  cacheHome: &Option<Path>,
  loadedCaches: &List<Path>,
  timings: bool,
) -> ()
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator | &mut Types {
  let mut clock = OsMonotonicClock.make()
  let listener = run CheckServer.listenAt(socket)
  if listener < 0 {
    return ()
  }
  let shape = run programShape(&sources.*)
  run releaseReplayed(&mut store.*, &mut request.*)
  let mut checked = usize.ZERO

  // Whether the server leaves because the program changed shape or went away.
  let mut reshaped = false

  // Whether the server leaves because the computer needs its memory back.
  let mut crowded = false
  let mut idle = 0
  while true {
    let client = CheckServer.next(listener, CheckServer.WATCH_MILLISECONDS)
    if client == CheckServer.TIMED_OUT {
      idle = idle + CheckServer.WATCH_MILLISECONDS
      if idle >= CheckServer.IDLE_MILLISECONDS {
        break
      }
      if !ContentHash.equals(run programShape(&sources.*), shape) {
        reshaped = true
        break
      }
      if run CheckServer.crowded() {
        crowded = true
        break
      }
      continue
    }
    if client < 0 {
      break
    }
    idle = 0

    // A check would grow a store the computer has no room for; the client checks by itself.
    if run CheckServer.crowded() {
      CheckServer.decline(client)
      crowded = true
      break
    }
    let asked = match move run CheckServer.request(client) {
      Option<Bytes>.Some { value } => move value
      Option<Bytes>.None => {
        CheckServer.decline(client)
        continue
      }
    }
    if !sameBytes(Bytes.asSlice(&asked), key) {
      CheckServer.decline(client)
      continue
    }

    // A changed manifest or a file added to or removed from the root package changes what the
    // program is; the client checks it afresh and leaves a new server behind.
    let started = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
    let now = run programShape(&sources.*)
    if !ContentHash.equals(now, shape) {
      CheckServer.decline(client)
      reshaped = true
      break
    }
    let refreshed = run Effect.result(ModuleSourceFiles.refreshFromDisk(&mut sources.*))
    if let Result<usize, FileError | InvalidModulePath | OutOfMemoryError>.Failure {
      ..
    } = &refreshed {
      CheckServer.decline(client)
      break
    }

    // What the check sweeps follows the imports of the texts just read: a module an edit newly
    // imports is swept, and one no import reaches any longer is not, as a fresh check would load.
    let rootPackage = run ModuleSourceFiles.loadedRootModules(&sources.*)
    let sweptModules = run ModuleSourceFiles.checkedModules(&sources.*)
    let refreshedAt = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
    run Semantic.update(&mut store.*, run ModuleSourceFiles.revision(&sources.*))
    let updatedAt = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
    let mut out = Bytes.make()
    let mut progress = Progress.off()
    let passed = run Effect.result(
      checkPass(
        &mut store.*,
        &mut request.*,
        &sources.*,
        &sweptModules,
        &rootPackage,
        identity,
        runtime,
        format,
        json,
        false,
        ignoreWarnings,
        cache,
        cacheHome,
        loadedCaches,
        false,
        &mut out,
        &mut progress,
      ),
    )
    match move passed {
      Result<
        PassResult,
        ApplicationError
          | FileError
          | InvalidModulePath
          | Cycle
          | RevisionMismatch
          | OutOfMemoryError
          | WriterError
      >.Success {
        value
      } => {
        if timings {
          let checkedAt = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
          run Bytes.append(&mut out, b"silk-check-server refresh-us=")
          run JsonText.appendDecimal(&mut out, elapsedMicroseconds(&started, &refreshedAt))
          run Bytes.append(&mut out, b" update-us=")
          run JsonText.appendDecimal(&mut out, elapsedMicroseconds(&refreshedAt, &updatedAt))
          run Bytes.append(&mut out, b" check-us=")
          run JsonText.appendDecimal(&mut out, elapsedMicroseconds(&updatedAt, &checkedAt))
          run Bytes.append(&mut out, b"\n")
        }
        run CheckServer.answer(client, value.status, value.reported, Bytes.asSlice(&out))
      }
      Result<
        PassResult,
        ApplicationError
          | FileError
          | InvalidModulePath
          | Cycle
          | RevisionMismatch
          | OutOfMemoryError
          | WriterError
      >.Failure {
        error
      } => {
        drop error
        CheckServer.decline(client)
        break
      }
    }
    run releaseReplayed(&mut store.*, &mut request.*)
    checked = checked + usize.ONE
  }
  run CheckServer.remove(socket)

  // The checks it answered are written once, as it leaves, for the next process to read. A server
  // that leaves because the program changed shape writes nothing: its answers describe a program
  // that is gone, the next check writes its own cache, and a removed project is not written back.
  // One that leaves for want of memory writes nothing either, so it gives the memory back at once.
  if checked > usize.ZERO && !reshaped && !crowded {
    drop run Effect.result(
      saveCheckCache(&mut store.*, &sources.*, runtime, cache, cacheHome, loadedCaches),
    )
  }
  return ()
}

// A digest of what decides the program's shape beyond its sources: the manifest of each package
// it loads and of each workspace one takes shared dependencies from, and the names of the files in
// the root package's module directory.
effect fn programShape(sources: &ModuleSources) -> ContentHash
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut stream = ContentHash.stream()
  let mut at = usize.ZERO
  while at < ModuleSourceFiles.packageCount(sources) {
    let read = run Effect.result(readManifestAt(ModuleSourceFiles.packageDirectoryAt(sources, at)))
    match move read {
      Result<Bytes, FileError | OutOfMemoryError>.Success { value } => {
        let digest = ContentHash.of(Bytes.asSlice(&value))
        ContentHash.appendWord(&mut stream, digest.high, 8)
        ContentHash.appendWord(&mut stream, digest.low, 8)
      }
      Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
        FileError missing => {
          drop missing
          ContentHash.appendByte(&mut stream, 0)
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    at = at + usize.ONE
  }

  // A workspace's shared dependencies and a silk.local.toml decide what the packages load.
  let workspaces = ModuleSourceFiles.graphFiles(sources)
  let mut workspace = usize.ZERO
  while workspace < workspaces.length {
    if let Result<Bytes, FileError | OutOfMemoryError>.Success { value } = move run Effect.result(
      readFileAt(Bytes.asSlice(&workspaces[workspace])),
    ) {
      let digest = ContentHash.of(Bytes.asSlice(&value))
      ContentHash.appendWord(&mut stream, digest.high, 8)
      ContentHash.appendWord(&mut stream, digest.low, 8)
    } else {
      ContentHash.appendByte(&mut stream, 0)
    }
    workspace = workspace + usize.ONE
  }
  run appendListing(&mut stream, ModuleSourceFiles.moduleRoot(sources))
  return ContentHash.finish(move stream)
}

effect fn readFileAt(path: &[u8]) -> Bytes
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  return run FileSystem.readFile(&run Path.fromBytes(path))
}

effect fn readManifestAt(directory: &Path) -> Bytes
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let manifest = run Path.joinBytes(directory, b"silk.toml")
  return run FileSystem.readFile(&manifest)
}

// Appends the names and kinds below `directory` to `stream`, depth first.
effect fn appendListing(stream: &mut HashStream, directory: &Path) -> ()
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let listed = run Effect.result(FileSystem.listDirectory(directory))
  let entries = match move listed {
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success { value } => move value
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      FileError missing => {
        drop missing
        return ()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let children = List<DirectoryEntry>.asSlice(&entries)
  let mut at = usize.ZERO
  while at < children.length {
    ContentHash.append(&mut stream.*, Path.rawBytes(&children[at].path))
    ContentHash.appendByte(&mut stream.*, i32.toU8(children[at].kind.code))
    if children[at].kind.code == 1 {
      run appendListing(&mut stream.*, &children[at].path)
    }
    at = at + usize.ONE
  }
}

// One check of the analyzed root package: what it reports goes onto `out`, and the answer names
// its status and how many sites it reported. A long-lived check (`CheckServer`) runs it again on
// the same store after each update.
effect fn checkPass(
  store: &mut Semantic,
  request: &mut SemanticRequest,
  sources: &ModuleSources,
  sweptModules: &List<ModuleId>,
  rootPackage: &List<ModuleId>,
  identity: &ModuleId,
  runtime: &Option<ModuleId>,
  format: &DiagnosticFormat,
  json: bool,
  roots: bool,
  ignoreWarnings: bool,
  cache: &Option<CacheFile>,
  cacheHome: &Option<Path>,
  loadedCaches: &List<Path>,
  save: bool,
  out: &mut Bytes,
  progress: &mut Progress,
) -> PassResult
  ! ApplicationError
    | FileError
    | InvalidModulePath
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut Allocator | &mut Types {
  let mut status = 0
  let mut checkedModules = List<ModuleId>.length(&sweptModules.*)
  if let Option<ModuleId>.Some { .. } = &runtime.* {
    checkedModules = checkedModules + usize.ONE
  }
  run Progress.begin(&mut progress.*, ProgressPhase.Check, checkedModules)
  Semantic.selectProgress(&mut store.*, Intrinsic.replace(progress.*, Progress.off()))

  // A diagnostic several answers reach, such as an import's refused module or a `main` result the
  // runtime and the sweep both refuse, prints once.
  let mut seen = List<ReportedSite>.make()

  // An executable's runtime is checked against the application too, so `check` reports a `main`
  // the runtime cannot start, as `build` does. Only those refusals are reported from it: what its
  // own declarations refuse, then what the declarations' walk from its roots refuses inside it.
  let mut entered = List<Shared<Rejection>>.make()
  if let Option<ModuleId>.Some { value: selected } = &runtime.* {
    let swept = run Semantic.checkRuntime(&mut store.*, &mut request.*, &selected)
    let found = List<Shared<Rejection>>.asSlice(&swept.rejections)
    let mut at = usize.ZERO
    while at < found.length {
      run List<Shared<Rejection>>.append(&mut entered, Shared<Rejection>.clone(&found[at]))
      at = at + usize.ONE
    }
  }
  let checked = run Semantic.checkDeclarations(
    &mut store.*,
    &mut request.*,
    List<ModuleId>.asSlice(&sweptModules.*),
    &runtime.*,
  )
  let walked = Semantic.runtimeRefusals(&store.*)
  let mut walkedAt = usize.ZERO
  while walkedAt < walked.length {
    run List<Shared<Rejection>>.append(&mut entered, Shared<Rejection>.clone(&walked[walkedAt]))
    walkedAt = walkedAt + usize.ONE
  }
  let refused = List<Shared<Rejection>>.asSlice(&entered)
  let mut refusal = usize.ZERO
  while refusal < refused.length {
    if let Option<Shared<Rejection>>.Some { value: moved } = move run entryRejection(
      &mut store.*,
      &mut request.*,
      &sources.*,
      &identity.*,
      &runtime.*,
      &refused[refusal],
    ) {
      if !run repeated(&mut seen, &moved) {
        status = worse(status, run reportRejection(&sources.*, &moved, &format.*, &mut out.*))
      }
    }
    refusal = refusal + usize.ONE
  }
  progress.* = Semantic.takeProgress(&mut store.*)

  // A store a server keeps still holds modules an edit stopped importing; what they refuse is not
  // reported, as a fresh check would not read them.
  let reach = run ModuleSourceFiles.reached(&sources.*)
  let syntax = run reachedRejections(&reach, run Semantic.syntaxRejections(&store.*))
  let malformed = List<Shared<Rejection>>.asSlice(&syntax)
  let mut at = usize.ZERO
  while at < malformed.length {
    if !run repeated(&mut seen, &malformed[at]) {
      status = worse(status, run reportRejection(&sources.*, &malformed[at], &format.*, &mut out.*))
    }
    at = at + usize.ONE
  }
  let importRejected = run reachedRejections(
    &reach,
    run Semantic.importRejections(&mut store.*, &mut request.*),
  )
  status = worse(
    status,
    run reportedImportRejections(
      List<Shared<Rejection>>.asSlice(&importRejected),
      &sources.*,
      &format.*,
      &mut out.*,
      &mut seen,
    ),
  )

  // Malformed syntax leaves later phases without a complete tree, so their refusals of the
  // recovered constructs are not reported next to the syntax errors that caused them.
  let parsed = malformed.length == usize.ZERO
  let mut warned = false
  let rejected = List<Shared<Rejection>>.asSlice(&checked.rejections)
  at = usize.ZERO
  while at < rejected.length {
    if parsed || diagnosticStatus(&rejected[at]) == 1 {
      // A `main` result no runtime starts is reported as the runtime's refusal (SEM0225).
      let shown = match move run entryRejection(
        &mut store.*,
        &mut request.*,
        &sources.*,
        &identity.*,
        &runtime.*,
        &rejected[at],
      ) {
        Option<Shared<Rejection>>.Some { value } => move value
        Option<Shared<Rejection>>.None => Shared<Rejection>.clone(&rejected[at])
      }
      if !run repeated(&mut seen, &shown) {
        if diagnosticStatus(&shown) == 0 {
          warned = true
        }
        status = worse(status, run reportRejection(&sources.*, &shown, &format.*, &mut out.*))
      }
    }
    at = at + usize.ONE
  }

  // The unused bindings of the root package and its path dependencies are warnings too.
  if parsed {
    let warnings = run unusedReported(
      &mut store.*,
      &sources.*,
      List<ModuleId>.asSlice(&rootPackage.*),
    )
    let listed = List<Shared<Rejection>>.asSlice(&warnings)
    at = usize.ZERO
    while at < listed.length {
      if !refusedAt(&listed[at], List<Shared<Rejection>>.asSlice(&importRejected))
        && !refusedAt(&listed[at], rejected) {
        warned = true
        drop run reportRejection(&sources.*, &listed[at], &format.*, &mut out.*)
      }
      at = at + usize.ONE
    }
  }

  // A warning fails the check as an error does, unless `--ignore-warnings` allows it. The closing
  // line names the option only when the warnings are all that failed it.
  if warned && !ignoreWarnings {
    if status == 0 && !json {
      run Bytes.append(&mut out.*, warningsRefused())
    }
    status = worse(status, 1)
  }
  if parsed && List<Shared<Gap>>.length(&checked.gaps) > usize.ZERO {
    // `--json` keeps the machine record; the human format names each gap's location.
    let mut message = Bytes.make()
    if json {
      message = run gapSummary(List<Shared<Gap>>.asSlice(&checked.gaps))
    } else {
      message = run gapLines(
        &sources.*,
        List<Shared<Gap>>.asSlice(&checked.gaps),
        List<ReportedSite>.asSlice(&seen),
        humanRoot(&format.*),
      )
    }
    run Bytes.append(&mut out.*, Bytes.asSlice(&message))
    status = 2
  }
  if roots {
    let compared = run CheckRoots.compare(
      &mut store.*,
      &mut request.*,
      List<ModuleId>.asSlice(&sweptModules.*),
      &runtime.*,
      rejected,
    )
    run Bytes.append(&mut out.*, Bytes.asSlice(&compared.report))
    if compared.differences > usize.ZERO {
      status = worse(status, 1)
    }
  }

  // A copy of the process writes the image, and the check returns without waiting for it.
  if save {
    run saveCheckCache(&mut store.*, &sources.*, runtime, cache, cacheHome, loadedCaches)
  }
  run abandonValue(move checked)
  return PassResult { status: status, reported: List<ReportedSite>.length(&seen) }
}

// The rejections of `found` in the modules `reach` holds.
effect fn reachedRejections(reach: &Reach, found: List<Shared<Rejection>>) -> List<
  Shared<Rejection>
>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut kept = move found
  let mut at = usize.ZERO
  while at < List<Shared<Rejection>>.length(&kept) {
    let inside = Shared<Rejection>.with<bool>(
      &List<Shared<Rejection>>.asSlice(&kept)[at],
      |value: &Rejection| -> bool {
        return ModuleSourceFiles.reaches(reach, &value.module)
      },
    )
    if inside {
      at = at + usize.ONE
    } else {
      drop List<Shared<Rejection>>.remove(&mut kept, at)
    }
  }
  return move kept
}

// Writes the image of `store`'s checks for the next process, in a copy of this one.
effect fn saveCheckCache(
  store: &mut Semantic,
  sources: &ModuleSources,
  runtime: &Option<ModuleId>,
  cache: &Option<CacheFile>,
  cacheHome: &Option<Path>,
  loadedCaches: &List<Path>,
) -> ()
  ! FileError | Cycle | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator | &mut Types {
  if let Option<CacheFile>.Some { value: file } = &cache.* {
    run SemanticCache.saveDetached(&mut store.*, &file, Option<&[CodegenUnit]>.none())
    if let Option<ModuleId>.Some { .. } = &runtime.* {
      run SemanticCache.rememberRuntime(&file, List<Path>.asSlice(&loadedCaches.*))
    }
    if let Option<Path>.Some { value: directory } = &cacheHome.* {
      run saveParsed(&directory, &file, &sources.*, &store.*)
    }
  }
}

// What one `checkPass` found: its status and how many sites it reported.
struct PassResult {
  status: i32,
  reported: usize,
}

// Reads the edit script of `check --replay`, or writes why it cannot and answers none.
effect fn replayScript(path: &Path) -> Option<List<Edit>>
  ! FileError | WriterError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let text = run FileSystem.readFile(path)
  let parsed = match move run Effect.result(Toml.parse(Bytes.asSlice(&text))) {
    Result<TomlValue, TomlError | OutOfMemoryError>.Success { value } => move value
    Result<TomlValue, TomlError | OutOfMemoryError>.Failure { error } => match move error {
      TomlError malformed => {
        drop malformed
        run writeReplayRefusal(path, b"it is not valid TOML")
        return Option<List<Edit>>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  return match move run Effect.result(EditReplays.read(&parsed)) {
    Result<List<Edit>, InvalidReplayScript | OutOfMemoryError>.Success { value } => Option<
      List<Edit>
    >.some(move value)
    Result<List<Edit>, InvalidReplayScript | OutOfMemoryError>.Failure {
      error
    } => match move error {
      InvalidReplayScript invalid => {
        run writeReplayRefusal(path, Bytes.asSlice(&invalid.detail))
        return Option<List<Edit>>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn writeReplayRefusal(path: &Path, reason: &[u8]) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Allocator {
  let mut line = run Bytes.copy(b"silk: invalid replay script ")
  run Bytes.append(&mut line, Path.rawBytes(path))
  run Bytes.append(&mut line, b": ")
  run Bytes.append(&mut line, reason)
  run Bytes.append(&mut line, b"\n")
  run writeError(Bytes.asSlice(&line))
}

// The microseconds from `start` to `end` on one monotonic timeline.
fn elapsedMicroseconds(start: &Instant, end: &Instant) -> usize {
  let seconds = SystemClock.seconds(end) - SystemClock.seconds(start)
  let nanoseconds = SystemClock.nanoseconds(end) - SystemClock.nanoseconds(start)
  return i64.toUsize(seconds * 1000000 + nanoseconds / 1000)
}

// Demands what `check` does of the root package and answers the rejections it reached: its
// declarations' and every parsed module's syntax errors.
// Drops what a long-lived store and request no longer need after a check, as the language
// server does: the request's roots and the lowered MIR no answer names.
effect fn releaseReplayed(store: &mut Semantic, request: &mut SemanticRequest) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  SemanticRequest.forgetRoots(&mut request.*)
  drop run Semantic.releaseStaleMir(&mut store.*, &request.*)
  return ()
}

effect fn replayCheck(
  store: &mut Semantic,
  request: &mut SemanticRequest,
  roots: &[ModuleId],
  runtime: &Option<ModuleId>,
) -> List<Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let zone = Profiler.zone(b"replayCheck")
  if let Option<ModuleId>.Some { value: selected } = &runtime.* {
    let entered = run Semantic.checkRuntime(&mut store.*, &mut request.*, &selected)
    drop entered
  }
  let checked = run Semantic.checkDeclarations(&mut store.*, &mut request.*, roots, runtime)
  let syntax = run Semantic.syntaxRejections(&store.*)
  drop zone
  let mut reached = List<Shared<Rejection>>.make()
  let declared = List<Shared<Rejection>>.asSlice(&checked.rejections)
  let mut at = usize.ZERO
  while at < declared.length {
    run List<Shared<Rejection>>.append(&mut reached, Shared<Rejection>.clone(&declared[at]))
    at = at + usize.ONE
  }
  let malformed = List<Shared<Rejection>>.asSlice(&syntax)
  at = usize.ZERO
  while at < malformed.length {
    run List<Shared<Rejection>>.append(&mut reached, Shared<Rejection>.clone(&malformed[at]))
    at = at + usize.ONE
  }
  return move reached
}

// A rejection as the differential check compares it: `<module> <code> <start>-<end>`.
effect fn rejectionSite(rejection: &Shared<Rejection>) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut site = Bytes.make()
  let code = Shared<Rejection>.with<RejectionCode>(
    rejection,
    |held: &Rejection| -> RejectionCode {
      return held.code
    },
  )
  let span = Shared<Rejection>.with<Span>(
    rejection,
    |held: &Rejection| -> Span {
      return held.span
    },
  )
  let path = Shared<Rejection>.with<ModuleId>(
    rejection,
    |held: &Rejection| -> ModuleId {
      return ModuleId.copy(&held.module)
    },
  )
  run ModuleId.appendPath(&path, &mut site)
  run Bytes.append(&mut site, b" ")
  run Bytes.append(&mut site, Rejections.stableCode(code))
  run Bytes.append(&mut site, b" ")
  run JsonText.appendDecimal(&mut site, span.start)
  run Bytes.append(&mut site, b"-")
  run JsonText.appendDecimal(&mut site, span.end)
  return move site
}

effect fn rejectionSites(rejections: &[Shared<Rejection>]) -> List<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut sites = run List<Bytes>.makeWithCapacity(rejections.length)
  let mut at = usize.ZERO
  while at < rejections.length {
    run List<Bytes>.append(&mut sites, run rejectionSite(&rejections[at]))
    at = at + usize.ONE
  }
  return move sites
}

// Writes one `silk-replay-differential step=<n> only=<store> <site>` line for each site `sites`
// holds more often than `others`, and answers how many it wrote.
effect fn writeUnmatched(step: usize, store: &[u8], sites: &[Bytes], others: &[Bytes]) -> usize
  ! WriterError | OutOfMemoryError
  ? &mut Allocator | &mut Writer {
  let mut matched = run List<bool>.makeWithCapacity(others.length)
  let mut at = usize.ZERO
  while at < others.length {
    run List<bool>.append(&mut matched, false)
    at = at + usize.ONE
  }
  let mut unmatched = usize.ZERO
  at = usize.ZERO
  while at < sites.length {
    let mut found = false
    let mut other = usize.ZERO
    while other < others.length && !found {
      if !List<bool>.get(&matched, other)
        && same(Bytes.asSlice(&sites[at]), Bytes.asSlice(&others[other])) {
        List<bool>.set(&mut matched, other, true)
        found = true
      }
      other = other + usize.ONE
    }
    if !found {
      let mut line = run Bytes.copy(b"silk-replay-differential step=")
      run JsonText.appendDecimal(&mut line, step)
      run Bytes.append(&mut line, b" only=")
      run Bytes.append(&mut line, store)
      run Bytes.append(&mut line, b" ")
      run Bytes.append(&mut line, Bytes.asSlice(&sites[at]))
      run Bytes.append(&mut line, b"\n")
      run Writer.writeAll(Bytes.asSlice(&line))
      unmatched = unmatched + usize.ONE
    }
    at = at + usize.ONE
  }
  return unmatched
}

// Checks `revision` in a fresh one-shot store configured as `prepare` configures the revisable
// one, and compares its rejections with the revised store's `revised` by module, code and span.
// Writes one `silk-replay-differential step=<n> rejections=<count> differences=<count>` line after
// a line per rejection only one store reached, and answers whether they agree.
effect fn compareOneShot(
  step: usize,
  revision: &Revision,
  sources: &ModuleSources,
  revised: &Semantic,
  target: Target,
  identity: &ModuleId,
  roots: &[ModuleId],
  runtime: &Option<ModuleId>,
  reached: &[Shared<Rejection>],
) -> bool
  ! Cycle
    | InvalidModulePath
    | RevisionMismatch
    | RegistrationClosed
    | ConflictingPackageSource
    | WriterError
    | OutOfMemoryError
  ? &mut Allocator | &mut Types | &mut Writer {
  let zone = Profiler.zone(b"replayOneShot")
  let mut profile = Option<FinalProfile>.none()
  if let Option<&FinalProfile>.Some { value } = move Semantic.profile(revised) {
    profile = Option<FinalProfile>.some(run FinalProfile.copy(value))
  }
  let mut store = Semantic.oneShot(run Revision.copy(revision), target, move profile)
  Semantic.selectPackages(&mut store, run ModuleSourceFiles.packageGraph(sources))
  if let Option<&ExecutionStorage>.Some {
    value: storage
  } = move ModuleSourceFiles.executionStorage(sources) {
    Semantic.selectExecutionStorage(&mut store, run ExecutionStorage.copy(storage))
  }
  Semantic.selectRetention(&mut store, run ModuleSourceFiles.retention(sources))
  let supported = ModuleSourceFiles.support(sources)
  let hosted = ModuleSourceFiles.supportHosted(sources)
  let mut supportAt = usize.ZERO
  while supportAt < supported.length {
    run Semantic.selectSupport(&mut store, ModuleId.copy(&supported[supportAt]), hosted[supportAt])
    supportAt = supportAt + usize.ONE
  }
  let mut request = SemanticRequest.forApplication(ModuleId.copy(identity))
  run SemanticRequest.registerSchemaModule(&mut request, identity)
  let expected = run replayCheck(&mut store, &mut request, roots, runtime)
  drop zone
  let revisedSites = run rejectionSites(reached)
  let freshSites = run rejectionSites(List<Shared<Rejection>>.asSlice(&expected))
  let onlyRevised = run writeUnmatched(
    step,
    b"revised",
    List<Bytes>.asSlice(&revisedSites),
    List<Bytes>.asSlice(&freshSites),
  )
  let onlyFresh = run writeUnmatched(
    step,
    b"one-shot",
    List<Bytes>.asSlice(&freshSites),
    List<Bytes>.asSlice(&revisedSites),
  )
  let differences = onlyRevised + onlyFresh
  let mut line = run Bytes.copy(b"silk-replay-differential step=")
  run JsonText.appendDecimal(&mut line, step)
  run Bytes.append(&mut line, b" rejections=")
  run JsonText.appendDecimal(&mut line, List<Bytes>.length(&freshSites))
  run Bytes.append(&mut line, b" differences=")
  run JsonText.appendDecimal(&mut line, differences)
  run Bytes.append(&mut line, b"\n")
  run Writer.writeAll(Bytes.asSlice(&line))
  return differences == usize.ZERO
}

// Writes one replay step: `silk-replay step=<n> kind=<kind> module=<path>`, then the demand and
// graph counters the step added, its rejection count and its wall time.
effect fn writeReplayStep(
  step: usize,
  kind: &[u8],
  module: &[u8],
  before: &Statistics,
  after: &Statistics,
  rejections: usize,
  updateMicroseconds: usize,
  checkMicroseconds: usize,
) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Allocator | &mut Writer {
  let mut line = run Bytes.copy(b"silk-replay step=")
  run JsonText.appendDecimal(&mut line, step)
  run Bytes.append(&mut line, b" kind=")
  run Bytes.append(&mut line, kind)
  run Bytes.append(&mut line, b" module=")
  run Bytes.append(&mut line, module)
  run Bytes.append(&mut line, b" demands=")
  run JsonText.appendDecimal(&mut line, after.demands - before.demands)
  run Bytes.append(&mut line, b" hits=")
  run JsonText.appendDecimal(&mut line, after.hits - before.hits)
  run Bytes.append(&mut line, b" units-run=")
  run JsonText.appendDecimal(&mut line, after.runs - before.runs)
  if let Option<GraphCounters>.Some { value: graphAfter } = &after.graph {
    if let Option<GraphCounters>.Some { value: graphBefore } = &before.graph {
      run Bytes.append(&mut line, b" marked-outdated=")
      run JsonText.appendDecimal(&mut line, graphAfter.markedOutdated - graphBefore.markedOutdated)
      run Bytes.append(&mut line, b" fingerprinted=")
      run JsonText.appendDecimal(&mut line, graphAfter.fingerprinted - graphBefore.fingerprinted)
      run Bytes.append(&mut line, b" unchanged=")
      run JsonText.appendDecimal(&mut line, graphAfter.unchanged - graphBefore.unchanged)
      run Bytes.append(&mut line, b" verified=")
      run JsonText.appendDecimal(&mut line, graphAfter.verified - graphBefore.verified)
      run Bytes.append(&mut line, b" graph-units=")
      run JsonText.appendDecimal(&mut line, graphAfter.units)
      run Bytes.append(&mut line, b" graph-bytes=")
      run JsonText.appendDecimal(&mut line, graphAfter.bytes)
    }
  }
  run Bytes.append(&mut line, b" answers=")
  run JsonText.appendDecimal(&mut line, after.answers)
  run Bytes.append(&mut line, b" mir-functions=")
  run JsonText.appendDecimal(&mut line, after.mirFunctions)
  run Bytes.append(&mut line, b" rejections=")
  run JsonText.appendDecimal(&mut line, rejections)
  run Bytes.append(&mut line, b" update-us=")
  run JsonText.appendDecimal(&mut line, updateMicroseconds)
  run Bytes.append(&mut line, b" check-us=")
  run JsonText.appendDecimal(&mut line, checkMicroseconds)
  run Bytes.append(&mut line, b"\n")
  run Writer.writeAll(Bytes.asSlice(&line))
}

// Writes one `silk-replay-run step=<n> <unit>` line for each unit a traced replay step ran, then
// forgets the step's events.
effect fn writeReplayRuns(step: usize, store: &mut Semantic) -> ()
  ! Cycle | WriterError | OutOfMemoryError
  ? &mut Allocator | &mut Writer {
  let mut started = List<usize>.make()
  let events = Semantic.eventLog(&store.*)
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.Start {
      run List<usize>.append(&mut started, events[at].key)
    }
    at = at + usize.ONE
  }
  let units = List<usize>.asSlice(&started)
  at = usize.ZERO
  while at < units.length {
    let mut line = run Bytes.copy(b"silk-replay-run step=")
    run JsonText.appendDecimal(&mut line, step)
    run Bytes.append(&mut line, b" ")
    run Bytes.append(&mut line, Bytes.asSlice(&run Semantic.unitName(&mut store.*, units[at])))
    run Bytes.append(&mut line, b"\n")
    run Writer.writeAll(Bytes.asSlice(&line))
    at = at + usize.ONE
  }
  let causes = Semantic.staleCauses(&store.*)
  let mut copied = run List<StaleCause>.makeWithCapacity(causes.length)
  at = usize.ZERO
  while at < causes.length {
    run List<StaleCause>.append(
      &mut copied,
      StaleCause { unit: causes[at].unit, dependee: causes[at].dependee },
    )
    at = at + usize.ONE
  }
  let listedCauses = List<StaleCause>.asSlice(&copied)
  at = usize.ZERO
  while at < listedCauses.length {
    let mut line = run Bytes.copy(b"silk-replay-stale step=")
    run JsonText.appendDecimal(&mut line, step)
    run Bytes.append(&mut line, b" ")
    run Bytes.append(
      &mut line,
      Bytes.asSlice(&run Semantic.unitName(&mut store.*, listedCauses[at].unit)),
    )
    run Bytes.append(&mut line, b" <- ")
    run Bytes.append(
      &mut line,
      Bytes.asSlice(&run Semantic.dependeeName(&mut store.*, listedCauses[at].dependee)),
    )
    run Bytes.append(&mut line, b"\n")
    run Writer.writeAll(Bytes.asSlice(&line))
    at = at + usize.ONE
  }
  Semantic.trace(&mut store.*, true)
}

// Writes why edit `step` of a replay could not be applied.
effect fn writeReplayStop(step: usize, module: &[u8], reason: &[u8]) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Allocator {
  let mut line = run Bytes.copy(b"silk: replay edit ")
  run JsonText.appendDecimal(&mut line, step)
  run Bytes.append(&mut line, b" (")
  run Bytes.append(&mut line, module)
  run Bytes.append(&mut line, b"): ")
  run Bytes.append(&mut line, reason)
  run Bytes.append(&mut line, b"\n")
  run writeError(Bytes.asSlice(&line))
}

// Replays `edits` against one planned compilation of the project. It checks the root package in a
// revisable store, then applies each edit to the store's revision, updates the
// store and checks again, writing one `silk-replay` line per step with what that step demanded;
// step 0 is the first check. It reports no diagnostics: a rejection only counts. An edit that
// does not apply stops the replay with status 2. When `differential`, each step also checks the
// same revision in a fresh one-shot store; any rejection only one of them reaches is a
// reconciliation bug, and the replay then ends with status 1.
effect fn replayTarget(
  project: &Project,
  plan: ProjectPlan,
  standardLibrary: &Option<Path>,
  edits: &[Edit],
  differential: bool,
  versions: Versions,
) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let entry = run Path.fromBytes(Path.rawBytes(ProjectPlans.entry(&plan, project)))
  let ProjectPlan {
    input: planned,
    bindings,
    task: _,
    maxMemory: unlimited,
    stackSize: _,
    entry: _,
    unsandboxedTools
  } = move plan
  drop unlimited
  let mut input = move planned
  if let Option<Bytes>.None = &input.artifact {
    input.artifact = Option<Bytes>.some(
      run Bytes.copy(Projects.profileArtifact(Projects.form(project))),
    )
  }
  let profile = run InitialProfile.freeze(&input)
  let target = Target.forId(Target.id(InitialProfile.target(&profile)))
  let library = match &standardLibrary.* {
    Option<Path>.Some { value } => Option<Path>.some(run Path.fromBytes(Path.rawBytes(&value)))
    Option<Path>.None => Option<Path>.none()
  }
  let format = DiagnosticFormat.Human { root: run diagnosticRoot(Projects.manifest(project)) }
  let mut out = Bytes.make()

  // A replay reports its own lines, so it shows no progress.
  let mut progress = run startProgress(&silentProgress(), b"Replaying", project, &target, b"")
  let prepared = run prepare(
    &entry,
    Option<&Path>.some(Projects.manifest(project)),
    move library,
    &profile,
    move bindings,
    false,
    StoreMode.Revisable,
    Option<&[u8]>.none(),
    Option<&Path>.none(),
    &Option<Bytes>.none(),
    &mut ModuleSourceFiles.snapshot(),
    &format,
    &mut out,
    &mut progress,
    Option<&CompilationRequest>.none(),
    Option<&CompilationDefinition>.none(),
    unsandboxedTools,
    false,
    versions,
  )
  let analysis = match move prepared {
    Prepared.Ready { analysis } => move analysis
    Prepared.Finished { status } => {
      run writeDiagnostics(&target, false, &out, &mut progress)
      return status
    }
  }
  let Analysis {
    sources,
    store: analyzed,
    request: requested,
    rootPackage: _,
    checked,
    identity,
    runtime
  } = move analysis
  let mut store = move analyzed
  let mut request = move requested
  let mut roots = move checked
  let mut current = run ModuleSourceFiles.revision(&sources)
  let mut listRuns = false
  if let Option<Bytes>.Some { .. } = move run HostInput.variableNamed("SILK_REPLAY_RUNS") {
    listRuns = true
  }
  let mut clock = OsMonotonicClock.make()
  let mut before = Semantic.statistics(&store)
  let started = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
  let mut reached = run replayCheck(
    &mut store,
    &mut request,
    List<ModuleId>.asSlice(&roots),
    &runtime,
  )
  let checked = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
  run releaseReplayed(&mut store, &mut request)
  let mut after = Semantic.statistics(&store)
  run writeReplayStep(
    usize.ZERO,
    b"initial",
    b"-",
    &before,
    &after,
    List<Shared<Rejection>>.length(&reached),
    usize.ZERO,
    elapsedMicroseconds(&started, &checked),
  )
  if listRuns {
    Semantic.trace(&mut store, true)
  }
  let mut agreed = true
  if differential {
    agreed = run compareOneShot(
      usize.ZERO,
      &current,
      &sources,
      &store,
      target,
      &identity,
      List<ModuleId>.asSlice(&roots),
      &runtime,
      List<Shared<Rejection>>.asSlice(&reached),
    )
    HeapRelease.release()
  }
  let mut step = usize.ZERO
  while step < edits.length {
    let edit = &edits[step]
    step = step + usize.ONE
    let mut module = run ModuleSourceFiles.module(&sources, Bytes.asSlice(&edit.module))
    if edit.kind == EditKind.Embedded {
      module = run ModuleSourceFiles.embeddedFile(&sources, Bytes.asSlice(&edit.module))
    }
    let observed = run Revision.observe(&current, &module)
    let content = match move run Observation.copyContent(&observed) {
      Option<Bytes>.Some { value } => move value
      Option<Bytes>.None => {
        run writeReplayStop(
          step,
          Bytes.asSlice(&edit.module),
          b"the module is not in the loaded program",
        )
        return 2
      }
    }
    if edit.kind == EditKind.Rename {
      let renamed = run ModuleSourceFiles.module(&sources, Bytes.asSlice(&edit.to))
      let removed = run Revision.publish(&current, &module, &Option<Bytes>.none())
      current = run Revision.publish(&removed, &renamed, &Option<Bytes>.some(move content))
      let mut kept = List<ModuleId>.make()
      while List<ModuleId>.length(&roots) > usize.ZERO {
        let root = List<ModuleId>.remove(&mut roots, usize.ZERO)
        if ModuleId.equals(&root, &module) {
          run List<ModuleId>.append(&mut kept, ModuleId.copy(&renamed))
        } else {
          run List<ModuleId>.append(&mut kept, move root)
        }
      }
      roots = move kept
    } else {
      let edited = match move run EditReplays.apply(Bytes.asSlice(&content), edit) {
        Option<Bytes>.Some { value } => move value
        Option<Bytes>.None => {
          run writeReplayStop(
            step,
            Bytes.asSlice(&edit.module),
            b"its find text does not occur exactly once",
          )
          return 2
        }
      }
      current = run Revision.publish(&current, &module, &Option<Bytes>.some(move edited))
    }
    before = move after
    let updating = Profiler.zone(b"replayUpdate")
    let updateStarted = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
    run Semantic.update(&mut store, run Revision.copy(&current))
    let updated = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
    drop updating
    reached = run replayCheck(&mut store, &mut request, List<ModuleId>.asSlice(&roots), &runtime)
    let finished = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
    run releaseReplayed(&mut store, &mut request)
    after = Semantic.statistics(&store)
    run writeReplayStep(
      step,
      EditReplays.kindName(edit.kind),
      Bytes.asSlice(&edit.module),
      &before,
      &after,
      List<Shared<Rejection>>.length(&reached),
      elapsedMicroseconds(&updateStarted, &updated),
      elapsedMicroseconds(&updated, &finished),
    )
    if listRuns {
      run writeReplayRuns(step, &mut store)
    }
    if differential {
      let matches = run compareOneShot(
        step,
        &current,
        &sources,
        &store,
        target,
        &identity,
        List<ModuleId>.asSlice(&roots),
        &runtime,
        List<Shared<Rejection>>.asSlice(&reached),
      )
      agreed = agreed && matches

      // The fresh store is dropped; its pages are needed for the next step's.
      HeapRelease.release()
    }
  }
  if !agreed {
    return 1
  }
  return 0
}

// Writes one borrow-check gap line: `<prefix>3 bodies not borrow-checked (awaiting 3;
// ...)`, the total and then each reason with bodies, per `uncheckedReason`.
effect fn writeBorrowGap(prefix: &[u8], counts: &[usize]) -> ()
  ! OutOfMemoryError | WriterError
  ? &mut Allocator {
  let mut total = usize.ZERO
  let mut at = usize.ZERO
  while at < counts.length {
    total = total + counts[at]
    at = at + usize.ONE
  }
  let mut message = run Bytes.copy(prefix)
  run JsonText.appendDecimal(&mut message, total)
  run Bytes.append(&mut message, b" bodies not borrow-checked (")
  let mut listed = false
  at = usize.ZERO
  while at < counts.length {
    if counts[at] > usize.ZERO {
      if listed {
        run Bytes.append(&mut message, b", ")
      }
      run Bytes.append(&mut message, String.utf8Bytes(uncheckedReasonName(at)))
      run Bytes.append(&mut message, b" ")
      run JsonText.appendDecimal(&mut message, counts[at])
      listed = true
    }
    at = at + usize.ONE
  }
  if !listed {
    run Bytes.append(&mut message, b"all checked")
  }
  run Bytes.append(&mut message, b"; native borrow checking is roadmap step 14)\n")
  run writeError(Bytes.asSlice(&message))
}

// Writes the root-package count line, then, when `named`, one `SILK_GAP borrow-check body:
// <module> <start>-<end> <reason> <codes>` line per unchecked concrete root-package body, by the
// byte offsets of its body block, with the comma-separated catalog codes the checks it left open
// report, or `-` when it left none of them open.
effect fn writeRootBorrowGap(bodies: &[UncheckedBody], named: bool) -> ()
  ! OutOfMemoryError | WriterError
  ? &mut Allocator {
  let mut counts = List<usize>.make()
  let mut at = usize.ZERO
  while at < uncheckedReasonCount() {
    run List<usize>.append(&mut counts, usize.ZERO)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < bodies.length {
    let mut slots = List<usize>.asMutSlice(&mut counts)
    slots[bodies[at].reason] = slots[bodies[at].reason] + usize.ONE
    at = at + usize.ONE
  }
  run writeBorrowGap(b"SILK_GAP borrow-check root-package: ", List<usize>.asSlice(&counts))
  if !named {
    return ()
  }
  at = usize.ZERO
  while at < bodies.length {
    let mut line = run Bytes.copy(b"SILK_GAP borrow-check body: ")
    let path = run ModuleId.copyPath(&bodies[at].module)
    run Bytes.append(&mut line, Bytes.asSlice(&path))
    run Bytes.append(&mut line, b" ")
    run JsonText.appendDecimal(&mut line, bodies[at].block.start)
    run Bytes.append(&mut line, b"-")
    run JsonText.appendDecimal(&mut line, bodies[at].block.end)
    run Bytes.append(&mut line, b" ")
    run Bytes.append(&mut line, String.utf8Bytes(uncheckedReasonName(bodies[at].reason)))
    run Bytes.append(&mut line, b" ")
    let skipped = run uncheckedBodyCodes()
    let codes = List<RejectionCode>.asSlice(&skipped)
    if codes.length == usize.ZERO {
      run Bytes.append(&mut line, b"-")
    }
    let mut code = usize.ZERO
    while code < codes.length {
      if code > usize.ZERO {
        run Bytes.append(&mut line, b",")
      }
      run Bytes.append(&mut line, Rejections.stableCode(codes[code]))
      code = code + usize.ONE
    }
    run Bytes.append(&mut line, b"\n")
    run writeError(Bytes.asSlice(&line))
    at = at + usize.ONE
  }
}

// The combined status of two outcomes: 2 dominates 1, which dominates 0. Any other status, such as
// an abnormal exit's, counts as 2.
fn worse(left: i32, right: i32) -> i32 {
  if left < 0 || left > 1 || right < 0 || right > 1 {
    return 2
  }
  if left == 1 || right == 1 {
    return 1
  }
  return 0
}

// Analyzes every planned compilation of the project in order and writes one `check <target>:`
// line per target and a `Check summary` on standard output, as the TypeScript `silk check` does.
effect fn checkProject(working: &Path, command: CheckCommand) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let CheckCommand { options, json, roots, replay: script, differential, noServer } = move command
  let selection = match move run selectProjects(working, &options) {
    Option<Selection>.Some { value } => move value
    Option<Selection>.None => {
      return 2
    }
  }
  run noteOverrides(List<Project>.asSlice(&selection.projects))
  let standardLibrary = run standardLibraryFor(working, &options.standardLibrary)
  let mut edits = Option<List<Edit>>.none()
  if let Option<Bytes>.Some { value } = &script {
    let path = run pathArgument(working, Bytes.asSlice(&value))
    edits = match move run replayScript(&path) {
      Option<List<Edit>>.Some { value: read } => Option<List<Edit>>.some(move read)
      Option<List<Edit>>.None => {
        return 2
      }
    }
  }
  let projects = List<Project>.asSlice(&selection.projects)
  let order = run dependencyOrder(projects)

  // JSON diagnostics share standard error, so a JSON check reports no progress.
  let mut settings = silentProgress()
  let mut replaying = false
  if let Option<List<Edit>>.Some { .. } = &edits {
    replaying = true
  }
  if !json && !replaying {
    settings = run progressSettings(&options, projects.length)
  }
  let whole = run unitsProgress(&settings)

  // The compiler's identity hashes the whole executable, so a workspace reads it once for every member.
  let compiler = run CacheStamp.compiler()

  // Members share the packages they depend on, so each source file is read once for all of them.
  let mut snapshot = ModuleSourceFiles.snapshot()
  let mut status = 0
  let mut succeeded = usize.ZERO
  let mut at = usize.ZERO

  // A check of one package leaves a check server behind (`CheckServer`). A workspace check leaves
  // none: each member's server would hold its whole store, and a workspace of many members would
  // fill the machine's memory with them.
  let serve = !noServer && projects.length == usize.ONE

  // Members check side by side in copies of the process, except in a replay, which compares one
  // run's steps.
  let mut jobs = usize.ONE
  if !replaying && projects.length > usize.ONE {
    jobs = run MemberChecks.jobs(MemberChecks.CHECK_BYTES)
  }
  if jobs > usize.ONE {
    if run copiesMembers() {
      let work = MemberWork.Check { json: json, roots: roots, serve: serve }
      let checked = run runSideBySide(
        &work,
        projects,
        List<usize>.asSlice(&order),
        jobs,
        selection.members,
        &options,
        &standardLibrary,
        &settings,
        &compiler,
      )
      status = checked.status
      succeeded = checked.succeeded
      at = projects.length
    } else if let Option<SideBySide>.Some { value: checked } = move run runInProcesses(
      projects,
      List<usize>.asSlice(&order),
      jobs,
      true,
      true,
    ) {
      status = checked.status
      succeeded = checked.succeeded
      at = projects.length
    }
  }
  while at < projects.length {
    if selection.members {
      settings.position = at + usize.ONE
    }
    let member = List<usize>.get(&order, at)

    // Each member interns its own applications: no type outlives its check, so a long workspace
    // check does not keep every earlier member's keys.
    let mut memberTypes = TypeTable.make()
    let checked = run memberStatus(
      run Effect.result(
        checkOne(
          &projects[member],
          &options,
          &standardLibrary,
          json,
          roots,
          serve,
          &settings,
          &edits,
          differential,
          at + usize.ONE == projects.length,
          &compiler,
          &mut snapshot,
        )
          |> Effect.provideMut<Types>(&mut memberTypes),
      ),
    )
    drop memberTypes

    // The member's store is gone; hand its free pages back before the next member allocates.
    HeapRelease.release()
    if checked == 0 {
      succeeded = succeeded + usize.ONE
    }
    status = worse(status, checked)
    at = at + usize.ONE
  }
  if selection.members {
    run writeUnitsSummary(&settings, move whole, succeeded, projects.length)
  }
  return status
}

// What a side-by-side run of members ended with: the combined status and how many succeeded.
struct SideBySide {
  status: i32,
  succeeded: usize,
}

// Whether a side-by-side run copies the process for each member (`MemberChecks`) instead of
// starting a compiler process for it (`MemberProcesses`). SILK_MEMBER_PROCESSES asks for processes
// on a host that could copy, so the path a host without copies takes can be run anywhere.
effect fn copiesMembers() -> bool
  ! OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  if !MemberChecks.COPIES {
    return false
  }
  return match move run Effect.result(HostInput.variableNamed("SILK_MEMBER_PROCESSES")) {
    Result<Option<Bytes>, HostInputError | OutOfMemoryError>.Success { value } => !Option<
      Bytes
    >.isSome(&value)
    Result<Option<Bytes>, HostInputError | OutOfMemoryError>.Failure { error } => match move error {
      HostInputError unread => {
        drop unread
        return true
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// The command that runs this command again for one member: this compiler and its arguments, with
// `manifest` in place of the workspace selection, in this process's environment. `quiet` adds
// `--no-server`, which a check of one member of many takes. None when the system does not name
// the compiler or its arguments cannot be read.
effect fn memberCommand(manifest: &Path, quiet: bool) -> Option<ProcessRequest>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut HostInput | &mut Allocator {
  let named = match move run CacheStamp.executablePath() {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return Option<ProcessRequest>.none()
    }
  }
  let built = run Effect.result(memberRequest(Bytes.asSlice(&named), manifest, quiet))
  return match move built {
    Result<ProcessRequest, FileError | HostInputError | OutOfMemoryError>.Success {
      value
    } => Option<ProcessRequest>.some(move value)
    Result<ProcessRequest, FileError | HostInputError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      FileError unnamed => {
        drop unnamed
        return Option<ProcessRequest>.none()
      }
      HostInputError unread => {
        drop unread
        return Option<ProcessRequest>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn memberRequest(compiler: &[u8], manifest: &Path, quiet: bool) -> ProcessRequest
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let program = run Path.fromBytes(compiler)
  let mut request = run ChildProcess.request(&program)
  let written = run HostInput.arguments()
  let arguments = List<Bytes>.asSlice(&written)
  let mut silenced = false
  let mut at = usize.ONE
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    at = at + usize.ONE
    if same(argument, b"--workspace") {
      continue
    }
    if same(argument, b"--package") || same(argument, b"-p") || same(argument, b"--manifest-path") {
      at = at + usize.ONE
      continue
    }
    if selects(argument, b"--package=") || selects(argument, b"--manifest-path=") {
      continue
    }
    if same(argument, b"--no-server") {
      silenced = true
    }
    run ChildProcess.addArgumentBytes(&mut request, argument)
  }
  run ChildProcess.addArgument(&mut request, "--manifest-path")
  run ChildProcess.addArgumentBytes(&mut request, Path.rawBytes(manifest))
  if quiet && !silenced {
    run ChildProcess.addArgument(&mut request, "--no-server")
  }
  let names = run HostInput.variableNames()
  let listed = List<Bytes>.asSlice(&names)
  at = usize.ZERO
  while at < listed.length {
    if let Option<Bytes>.Some { value } = move run HostInput.variable(Bytes.asSlice(&listed[at])) {
      run ChildProcess.setVariableBytes(
        &mut request,
        Bytes.asSlice(&listed[at]),
        Bytes.asSlice(&value),
      )
    }
    at = at + usize.ONE
  }
  return move request
}

// Whether `argument` starts with `option`.
fn selects(argument: &[u8], option: &[u8]) -> bool {
  return argument.length >= option.length
    && same(Slice.view(argument, usize.ZERO, option.length), option)
}

// Checks or builds `projects`, visited in `order`, up to `jobs` at a time, each in a compiler
// process of its own (`MemberProcesses`): what a host that cannot copy its process does in place
// of `runSideBySide`. The members whose dependencies have finished run together, then the ones
// those were holding back, so each finds the caches the members it depends on wrote. Each
// member's report is written in `order`. None, with nothing run, when no process can start.
effect fn runInProcesses(
  projects: &[Project],
  order: &[usize],
  jobs: usize,
  quiet: bool,
  siblings: bool,
) -> Option<SideBySide>
  ! WriterError | OutOfMemoryError
  ? &mut FileSystem | &mut HostInput | &mut Allocator | &mut Writer {
  let needs = run memberNeeds(projects)
  let reached = run reachedMembers(List<List<usize>>.asSlice(&needs))

  // Per member, by its place in `order`: 0 waiting, 1 in the group that runs now, 2 finished.
  let mut state = List<usize>.make()
  run List<usize>.appendRepeated(&mut state, usize.ZERO, order.length)
  let mut result = SideBySide { status: 0, succeeded: usize.ZERO }
  let mut written = usize.ZERO
  let mut reports = List<Option<MemberFinished>>.make()
  let mut filled = usize.ZERO
  while filled < order.length {
    run List<Option<MemberFinished>>.append(&mut reports, Option<MemberFinished>.none())
    filled = filled + usize.ONE
  }
  while written < order.length {
    let mut ready = List<usize>.make()
    let mut next = usize.ZERO
    while next < order.length {
      if List<usize>.get(&state, next) == usize.ZERO
        && finishedNeeds(
          List<List<usize>>.asSlice(&needs),
          order,
          List<usize>.asSlice(&state),
          next,
        )
        && !(siblings
          && awaitsSibling(
            projects,
            order,
            List<List<bool>>.asSlice(&reached),
            List<usize>.asSlice(&state),
            next,
          )) {
        run List<usize>.append(&mut ready, next)
        List<usize>.set(&mut state, next, usize.ONE)
      }
      next = next + usize.ONE
    }

    // A dependency cycle leaves members waiting on each other: run the first waiting one.
    if List<usize>.length(&ready) == usize.ZERO {
      let mut first = written
      while List<usize>.get(&state, first) != usize.ZERO {
        first = first + usize.ONE
      }
      run List<usize>.append(&mut ready, first)
    }
    let places = List<usize>.asSlice(&ready)
    let mut requests = List<ProcessRequest>.make()
    let mut at = usize.ZERO
    while at < places.length {
      match move run memberCommand(Projects.manifest(&projects[order[places[at]]]), quiet) {
        Option<ProcessRequest>.Some { value } => {
          run List<ProcessRequest>.append(&mut requests, move value)
        }
        Option<ProcessRequest>.None => {
          // Only the first command can be the one that finds no compiler to start.
          return Option<SideBySide>.none()
        }
      }
      at = at + usize.ONE
    }
    let mut finished = match move run Effect.result(MemberProcesses.runAll(move requests, jobs)) {
      Result<List<MemberFinished>, OutOfMemoryError | SpawnError>.Success { value } => move value
      Result<List<MemberFinished>, OutOfMemoryError | SpawnError>.Failure {
        error
      } => match move error {
        SpawnError unstarted => {
          drop unstarted
          if written == usize.ZERO && List<usize>.get(&state, usize.ZERO) == usize.ZERO {
            return Option<SideBySide>.none()
          }
          List<MemberFinished>.make()
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    at = usize.ZERO
    while at < places.length {
      List<usize>.set(&mut state, places[at], 2)
      let mut report = MemberFinished { status: 2, output: Bytes.make(), errors: Bytes.make() }
      if List<MemberFinished>.length(&finished) > usize.ZERO {
        report = List<MemberFinished>.remove(&mut finished, usize.ZERO)
      }
      let slots = List<Option<MemberFinished>>.asMutSlice(&mut reports)
      slots[places[at]] = Option<MemberFinished>.some(move report)
      at = at + usize.ONE
    }

    // Write the reports of the finished members that follow the ones written, in order.
    while written < order.length && List<usize>.get(&state, written) == 2 {
      let slots = List<Option<MemberFinished>>.asMutSlice(&mut reports)
      let taken = Intrinsic.replace(slots[written], Option<MemberFinished>.none())
      let mut checked = 2
      if let Option<MemberFinished>.Some { value: report } = move taken {
        run writeOutput(Bytes.asSlice(&report.output))
        run writeError(Bytes.asSlice(&report.errors))
        checked = report.status
      }
      if checked == 0 {
        result.succeeded = result.succeeded + usize.ONE
      }
      result.status = worse(result.status, checked)
      written = written + usize.ONE
    }
  }
  return Option<SideBySide>.some(move result)
}

// What each member of a side-by-side run does: check it, or build it with `clang`.
union MemberWork {
  Check { json: bool, roots: bool, serve: bool },
  Build { clang: Option<Bytes> },
}

// Checks or builds (`work`) `projects`, visited in `order`, up to `jobs` at a time, each in a copy
// of the process (`MemberChecks`). A member starts once every member it depends on has finished, so
// it finds the caches their runs wrote, and each member's report is written in `order` once it
// finishes. A copy that cannot start runs its member here.
effect fn runSideBySide(
  work: &MemberWork,
  projects: &[Project],
  order: &[usize],
  jobs: usize,
  members: bool,
  options: &ProjectOptions,
  standardLibrary: &Option<Path>,
  settings: &ProgressSettings,
  compiler: &Option<Bytes>,
) -> SideBySide
  ! WriterError | OutOfMemoryError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Writer {
  let needs = run memberNeeds(projects)
  let reached = run reachedMembers(List<List<usize>>.asSlice(&needs))
  let siblings = match &work.* {
    MemberWork.Check { .. } => true
    MemberWork.Build { .. } => true
  }

  // A copy writes its live line's redraws into its file too: replayed, they end on the lines a
  // terminal shows after a run of one member at a time.
  let mut copied = ProgressSettings {
    display: settings.display,
    color: settings.color,
    width: settings.width,
    quiet: settings.quiet,
    compact: settings.compact,
    position: settings.position,
    units: settings.units,
    timings: settings.timings,
    costs: settings.costs,
  }

  // Per member, by its place in `order`: 0 waiting, 1 running, 2 finished.
  let mut state = List<usize>.make()
  run List<usize>.appendRepeated(&mut state, usize.ZERO, order.length)
  let mut statuses = List<i32>.make()
  run List<i32>.appendRepeated(&mut statuses, 0, order.length)
  let mut processes = List<i32>.make()
  run List<i32>.appendRepeated(&mut processes, -1, order.length)
  let mut signaled = List<bool>.make()
  run List<bool>.appendRepeated(&mut signaled, false, order.length)
  let mut outputs = List<Option<MemberCapture>>.make()
  let mut filled = usize.ZERO
  while filled < order.length {
    run List<Option<MemberCapture>>.append(&mut outputs, Option<MemberCapture>.none())
    filled = filled + usize.ONE
  }
  let mut running = usize.ZERO
  let mut written = usize.ZERO
  let mut result = SideBySide { status: 0, succeeded: usize.ZERO }
  while written < order.length {
    // Start every member whose dependencies have finished, in order, while a job is free.
    let mut next = usize.ZERO
    while next < order.length && running < jobs {
      if List<usize>.get(&state, next) == usize.ZERO
        && finishedNeeds(
          List<List<usize>>.asSlice(&needs),
          order,
          List<usize>.asSlice(&state),
          next,
        )
        && !(siblings
          && awaitsSibling(
            projects,
            order,
            List<List<bool>>.asSlice(&reached),
            List<usize>.asSlice(&state),
            next,
          )) {
        if members {
          copied.position = next + usize.ONE
        }
        List<usize>.set(&mut state, next, usize.ONE)
        match move MemberChecks.start() {
          MemberStart.Original { process, captured } => {
            List<i32>.set(&mut processes, next, process)
            let slots = List<Option<MemberCapture>>.asMutSlice(&mut outputs)
            slots[next] = Option<MemberCapture>.some(move captured)
            running = running + usize.ONE
          }
          MemberStart.Copy => {
            let checked = run runMember(
              work,
              &projects[order[next]],
              options,
              standardLibrary,
              &copied,
              true,
              compiler,
              false,
            )
            MemberChecks.exit(checked)
          }
          MemberStart.Here => {
            List<i32>.set(
              &mut statuses,
              next,
              run runMember(
                work,
                &projects[order[next]],
                options,
                standardLibrary,
                &copied,
                false,
                compiler,
                false,
              ),
            )
            List<usize>.set(&mut state, next, 2)
          }
        }
      }
      next = next + usize.ONE
    }

    // A dependency cycle leaves members waiting on each other: start the first waiting one.
    if running == usize.ZERO && List<usize>.get(&state, written) == usize.ZERO {
      let mut first = written
      while List<usize>.get(&state, first) != usize.ZERO {
        first = first + usize.ONE
      }
      List<usize>.set(&mut state, first, 2)
      List<i32>.set(
        &mut statuses,
        first,
        run runMember(
          work,
          &projects[order[first]],
          options,
          standardLibrary,
          &copied,
          false,
          compiler,
          false,
        ),
      )
    }
    if running > usize.ZERO {
      match move MemberChecks.waitAny() {
        Option<MemberExit>.Some { value: exited } => {
          let mut at = usize.ZERO
          while at < order.length {
            if List<i32>.get(&processes, at) == exited.process
              && List<usize>.get(&state, at) == usize.ONE {
              List<usize>.set(&mut state, at, 2)
              List<i32>.set(&mut statuses, at, exited.status)
              List<bool>.set(&mut signaled, at, exited.signaled)
              running = running - usize.ONE
            }
            at = at + usize.ONE
          }
        }
        Option<MemberExit>.None => {
          // No copy is left to wait for: count the running ones as failed.
          let mut at = usize.ZERO
          while at < order.length {
            if List<usize>.get(&state, at) == usize.ONE {
              List<usize>.set(&mut state, at, 2)
              List<i32>.set(&mut statuses, at, 2)
            }
            at = at + usize.ONE
          }
          running = usize.ZERO
        }
      }
    }

    // Write the reports of the finished members that follow the ones written, in order.
    while written < order.length && List<usize>.get(&state, written) == 2 {
      let slots = List<Option<MemberCapture>>.asMutSlice(&mut outputs)
      let taken = Intrinsic.replace(slots[written], Option<MemberCapture>.none())
      if let Option<MemberCapture>.Some { value: captured } = move taken {
        MemberChecks.replay(&captured)
        drop captured
      }

      // A copy that a signal ended wrote no report of its own end.
      if List<bool>.get(&signaled, written) {
        run writeError(b"Failed ")
        run writeError(Projects.name(&projects[order[written]]))
        run writeError(
          b": its compiler process was stopped by a signal, such as the system running out of memory\n",
        )
      }
      let checked = List<i32>.get(&statuses, written)
      if checked == 0 {
        result.succeeded = result.succeeded + usize.ONE
      }
      result.status = worse(result.status, checked)
      written = written + usize.ONE
    }
  }
  return move result
}

// Runs `work` on one member; its status. A member that is `last` leaves its store for the exit to
// free.
effect fn runMember(
  work: &MemberWork,
  project: &Project,
  options: &ProjectOptions,
  standardLibrary: &Option<Path>,
  settings: &ProgressSettings,
  last: bool,
  compiler: &Option<Bytes>,
  shareWalk: bool,
) -> i32
  ! WriterError | OutOfMemoryError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Writer {
  return match &work.* {
    MemberWork.Check { json, roots, serve } => run checkMember(
      project,
      options,
      standardLibrary,
      json,
      roots,
      serve,
      settings,
      &Option<List<Edit>>.none(),
      last,
      compiler,
    )
    MemberWork.Build { clang } => run buildMember(
      project,
      options,
      standardLibrary,
      &clang,
      settings,
      last,
      compiler,
      shareWalk,
    )
  }
}

// Builds one member as the workspace loop does, with its own type table; its status, with any
// error reported.
effect fn buildMember(
  project: &Project,
  options: &ProjectOptions,
  standardLibrary: &Option<Path>,
  clang: &Option<Bytes>,
  settings: &ProgressSettings,
  last: bool,
  compiler: &Option<Bytes>,
  shareWalk: bool,
) -> i32
  ! WriterError | OutOfMemoryError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Writer {
  let mut memberTypes = TypeTable.make()
  let built = run memberStatus(
    run Effect.result(
      buildOne(project, options, standardLibrary, clang, settings, last, compiler, shareWalk)
        |> Effect.provideMut<Types>(&mut memberTypes),
    ),
  )
  drop memberTypes
  HeapRelease.release()
  return built
}

// Checks one member as the workspace loop does, with its own type table; its status, with any
// error reported. A member that is `last` leaves its store for the exit to free.
effect fn checkMember(
  project: &Project,
  options: &ProjectOptions,
  standardLibrary: &Option<Path>,
  json: bool,
  roots: bool,
  serve: bool,
  settings: &ProgressSettings,
  edits: &Option<List<Edit>>,
  last: bool,
  compiler: &Option<Bytes>,
) -> i32
  ! WriterError | OutOfMemoryError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Writer {
  let mut memberTypes = TypeTable.make()
  let mut snapshot = ModuleSourceFiles.snapshot()
  let checked = run memberStatus(
    run Effect.result(
      checkOne(
        project,
        options,
        standardLibrary,
        json,
        roots,
        serve,
        settings,
        edits,
        false,
        last,
        compiler,
        &mut snapshot,
      )
        |> Effect.provideMut<Types>(&mut memberTypes),
    ),
  )
  drop memberTypes
  HeapRelease.release()
  return checked
}

// Whether every member that the member at `place` of `order` depends on has finished, by `state`.
fn finishedNeeds(needs: &[List<usize>], order: &[usize], state: &[usize], place: usize) -> bool {
  let listed = List<usize>.asSlice(&needs[order[place]])
  let mut at = usize.ZERO
  while at < listed.length {
    let mut other = usize.ZERO
    while other < order.length {
      if order[other] == listed[at] && state[other] != 2 {
        return false
      }
      other = other + usize.ONE
    }
    at = at + usize.ONE
  }
  return true
}

// For each member, whether it reaches each other member through `needs`, directly or not.
effect fn reachedMembers(needs: &[List<usize>]) -> List<List<bool>>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut reached = List<List<bool>>.make()
  let mut at = usize.ZERO
  while at < needs.length {
    let mut row = List<bool>.make()
    run List<bool>.appendRepeated(&mut row, false, needs.length)
    let mut pending = List<usize>.make()
    run List<usize>.append(&mut pending, at)
    while true {
      let from = match move List<usize>.pop(&mut pending) {
        Option<usize>.Some { value } => value
        Option<usize>.None => {
          break
        }
      }
      let listed = List<usize>.asSlice(&needs[from])
      let mut next = usize.ZERO
      while next < listed.length {
        if !List<bool>.get(&row, listed[next]) {
          List<bool>.set(&mut row, listed[next], true)
          run List<usize>.append(&mut pending, listed[next])
        }
        next = next + usize.ONE
      }
    }
    run List<List<bool>>.append(&mut reached, move row)
    at = at + usize.ONE
  }
  return move reached
}

// How many members both `left` and `right` reach.
fn sharedMembers(reached: &[List<bool>], left: usize, right: usize) -> usize {
  let first = List<bool>.asSlice(&reached[left])
  let second = List<bool>.asSlice(&reached[right])
  let mut shared = usize.ZERO
  let mut at = usize.ZERO
  while at < first.length {
    if first[at] && second[at] {
      shared = shared + usize.ONE
    }
    at = at + usize.ONE
  }
  return shared
}

// Whether the member at `place` of `order` is an executable that should start later: an
// executable's first check walks everything its program reaches, and starts from the walk of a
// sibling executable that finished before it (`SemanticCache.openPrefetched`). So it waits while
// an executable is running and none has finished that shares as many members with it, and then
// starts from that one's walk instead of walking the same bodies beside it. Two executables that
// share no member still share the standard library. `state` is 1 for a running member and 2 for
// a finished one.
fn awaitsSibling(
  projects: &[Project],
  order: &[usize],
  reached: &[List<bool>],
  state: &[usize],
  place: usize,
) -> bool {
  if Projects.form(&projects[order[place]]) != Form.Executable {
    return false
  }

  // One more than the members shared, so zero is no executable at all.
  let mut finished = usize.ZERO
  let mut running = usize.ZERO
  let mut other = usize.ZERO
  while other < order.length {
    if other != place && state[other] != usize.ZERO
      && Projects.form(&projects[order[other]]) == Form.Executable {
      let shared = sharedMembers(reached, order[place], order[other]) + usize.ONE
      if state[other] == 2 {
        if shared > finished {
          finished = shared
        }
      } else if shared > running {
        running = shared
      }
    }
    other = other + usize.ONE
  }
  return running > finished
}

// For each of `projects`, the others among them it reaches by path, directly or through packages
// that are not members; a manifest that no longer parses reaches none, and its own check reports it.
effect fn memberNeeds(projects: &[Project]) -> List<List<usize>>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut directories = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < projects.length {
    match move run HostPath.canonicalBytes(Path.rawBytes(Projects.directory(&projects[at]))) {
      Option<Bytes>.Some { value } => {
        run List<Bytes>.append(&mut directories, move value)
      }
      Option<Bytes>.None => {
        run List<Bytes>.append(
          &mut directories,
          run Bytes.copy(Path.rawBytes(Projects.directory(&projects[at]))),
        )
      }
    }
    at = at + usize.ONE
  }
  let known = List<Bytes>.asSlice(&directories)
  let mut needs = List<List<usize>>.make()
  at = usize.ZERO
  while at < projects.length {
    let mut named = List<usize>.make()
    let parsed = match move run Effect.result(Projects.document(&projects[at])) {
      Result<TomlValue, TomlError | OutOfMemoryError>.Success { value } => Option<TomlValue>.some(
        move value,
      )
      Result<TomlValue, TomlError | OutOfMemoryError>.Failure { error } => match move error {
        TomlError failure => {
          drop failure
          Option<TomlValue>.none()
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    if let Option<TomlValue>.Some { value: document } = &parsed {
      let reached = run PackageSources.pathDependencies(
        Projects.directory(&projects[at]),
        &document,
      )
      let listed = List<Bytes>.asSlice(&reached)
      let mut other = usize.ZERO
      while other < projects.length {
        if other != at && listedPath(listed, Bytes.asSlice(&known[other])) {
          run List<usize>.append(&mut named, other)
        }
        other = other + usize.ONE
      }
    }
    run List<List<usize>>.append(&mut needs, move named)
    at = at + usize.ONE
  }
  return move needs
}

fn listedPath(listed: &[Bytes], path: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < listed.length {
    if same(Bytes.asSlice(&listed[at]), path) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Checks one project's planned compilations, as `checkProject` does for each selected project.
// The order a check visits `projects`: each after the selected packages it depends on, and
// otherwise as listed, so a package checked for the first time finds the caches its
// dependencies' checks just wrote (`dependencyCaches`).
effect fn dependencyOrder(projects: &[Project]) -> List<usize>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut order = List<usize>.make()
  let mut state = List<usize>.make()
  run List<usize>.appendRepeated(&mut state, usize.ZERO, projects.length)
  let mut at = usize.ZERO
  while at < projects.length {
    run visitInOrder(projects, at, &mut state, &mut order)
    at = at + usize.ONE
  }
  return move order
}

// Appends `at` to `order` after the projects it depends on; `state` marks each project unseen
// (0), being visited (1) or placed (2), so a dependency cycle keeps the listed order.
effect fn visitInOrder(
  projects: &[Project],
  at: usize,
  state: &mut List<usize>,
  order: &mut List<usize>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if List<usize>.get(&state.*, at) != usize.ZERO {
    return ()
  }
  List<usize>.set(&mut state.*, at, usize.ONE)

  // A manifest that no longer parses orders as listed; its own check reports it.
  let parsed = match move run Effect.result(Projects.document(&projects[at])) {
    Result<TomlValue, TomlError | OutOfMemoryError>.Success { value } => Option<TomlValue>.some(
      move value,
    )
    Result<TomlValue, TomlError | OutOfMemoryError>.Failure { error } => match move error {
      TomlError failure => {
        drop failure
        Option<TomlValue>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  if let Option<TomlValue>.Some { value: document } = &parsed {
    let mut other = usize.ZERO
    while other < projects.length {
      let name = run dependencyName(Projects.name(&projects[other]))
      if other != at && hasDependency(&document, Bytes.asSlice(&name)) {
        run visitInOrder(projects, other, &mut state.*, &mut order.*)
      }
      other = other + usize.ONE
    }
  }
  List<usize>.set(&mut state.*, at, 2)
  run List<usize>.append(&mut order.*, at)
}

effect fn checkOne(
  project: &Project,
  options: &ProjectOptions,
  standardLibrary: &Option<Path>,
  json: bool,
  roots: bool,
  serve: bool,
  packages: &ProgressSettings,
  edits: &Option<List<Edit>>,
  differential: bool,
  last: bool,
  compiler: &Option<Bytes>,
  snapshot: &mut SourceSnapshot,
) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let mut plans = match move run projectPlans(options) {
    Option<List<ProjectPlan>>.Some { value } => move value
    Option<List<ProjectPlan>>.None => {
      return 2
    }
  }
  if let Option<List<Edit>>.Some { value: script } = &edits.* {
    let mut replayed = 0
    while List<ProjectPlan>.length(&plans) > usize.ZERO {
      let plan = List<ProjectPlan>.remove(&mut plans, usize.ZERO)
      replayed = worse(
        replayed,
        run replayTarget(
          project,
          move plan,
          standardLibrary,
          List<Edit>.asSlice(&script),
          differential,
          run versionPolicy(options.ignoreSilkVersion),
        ),
      )
    }
    return replayed
  }
  // The package's tasks program, checked for this machine as `silk task` builds it. It goes first
  // so the package's own last check can still answer from a check server.
  let tasks = run Path.join(Projects.sourceRoot(project), "tasks.silk")
  let mut tasksPlan = Option<ProjectPlan>.none()
  if run FileSystem.exists(&tasks) {
    let mut host = ProjectCommands.options()
    host.standardLibrary = run copyOption(&options.standardLibrary)
    host.clang = run copyOption(&options.clang)
    if let Option<List<ProjectPlan>>.Some { value: hostPlans } = move run projectPlans(&host) {
      let mut found = move hostPlans
      if found.length() > usize.ZERO {
        let mut plan = found.remove(usize.ZERO)
        plan.input.artifact = Option<Bytes>.some(run Bytes.copy(b"executable"))
        plan.entry = Option<Path>.some(move tasks)
        plan.task = true
        tasksPlan = Option<ProjectPlan>.some(move plan)
      }
    }
  }
  let mut checks = List<ProjectPlan>.length(&plans)
  if tasksPlan.isSome() {
    checks = checks + usize.ONE
  }
  let settings = unitSettings(packages, checks)
  let mut attempts = List<ProjectArtifact>.make()
  if let Option<ProjectPlan>.Some { value: plan } = move tasksPlan {
    run List<ProjectArtifact>.append(
      &mut attempts,
      run checkTarget(
        project,
        move plan,
        standardLibrary,
        json,
        roots,
        false,
        false,
        &settings,
        compiler,
        options.ignoreWarnings,
        &mut snapshot.*,
        run versionPolicy(options.ignoreSilkVersion),
      ),
    )
  }
  while List<ProjectPlan>.length(&plans) > usize.ZERO {
    let plan = List<ProjectPlan>.remove(&mut plans, usize.ZERO)
    let abandon = last && List<ProjectPlan>.length(&plans) == usize.ZERO
    run List<ProjectArtifact>.append(
      &mut attempts,
      run checkTarget(
        project,
        move plan,
        standardLibrary,
        json,
        roots,
        serve,
        abandon,
        &settings,
        compiler,
        options.ignoreWarnings,
        &mut snapshot.*,
        run versionPolicy(options.ignoreSilkVersion),
      ),
    )
  }

  // Each attempt has reported itself on standard error, so only the status is left to combine.
  let attempted = List<ProjectArtifact>.asSlice(&attempts)
  let mut status = 0
  let mut at = usize.ZERO
  while at < attempted.length {
    status = worse(status, attempted[at].status)
    at = at + usize.ONE
  }
  return status
}

// Prints, for each selected project, the SHA-256 of everything a build of it reads: the compiler,
// each planned profile, and each file, look and listing that loading its program notes, with the
// paths relative to the project root, the standard library (`<std>`) or the Silk home (`<home>`).
// Loading reads only the modules reachable from the program's roots, so the hash names its import
// tree and not every file in the directory. With `--list` it prints the text it hashes instead.
// A load that fails still hashes what it read: the same inputs fail the same way.
effect fn hashProject(working: &Path, command: HashCommand) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let HashCommand { options, list, json, root, test } = move command
  let selection = match move run selectProjects(working, &options) {
    Option<Selection>.Some { value } => move value
    Option<Selection>.None => {
      return 2
    }
  }
  let standardLibrary = run standardLibraryFor(working, &options.standardLibrary)
  let mut compilerLine = run Bytes.copy(b"compiler ")
  run Bytes.append(&mut compilerLine, ReleaseVersion.value())
  let compiler = run CacheStamp.compiler()
  match &compiler {
    Option<Bytes>.Some { value: identity } => {
      run Bytes.append(&mut compilerLine, b" ")
      run appendDigestHex(&mut compilerLine, ContentHash.of(Bytes.asSlice(&identity)))
    }

    // Two development compilers would hash alike: the hash would not name the compiler.
    Option<Bytes>.None => {
      run writeError(
        b"silk: this compiler cannot read its own executable, so it has no identity to hash\n",
      )
      return 2
    }
  }
  run Bytes.append(&mut compilerLine, b"\n")

  // The Clang a build would use, by its first `--version` line, which names its release and commit
  // but not where it is installed.
  run Bytes.append(&mut compilerLine, b"clang ")
  run appendClangIdentity(&mut compilerLine, &run clangFor(working, &options.clang))
  run Bytes.append(&mut compilerLine, b"\n")

  // Profile-guided optimization reads its data file during code generation.
  if let Option<Bytes>.Some { value: data } = move run HostInput.variableNamed("SILK_PROFILE_USE") {
    run Bytes.append(&mut compilerLine, b"profile-use ")
    let read = run Effect.result(
      FileSystem.readFile(&run pathArgument(working, Bytes.asSlice(&data))),
    )
    match move read {
      Result<Bytes, FileError | OutOfMemoryError>.Success { value } => run appendDigestHex(
        &mut compilerLine,
        ContentHash.of(Bytes.asSlice(&value)),
      )
      Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
        FileError unread => {
          drop unread
          run Bytes.append(&mut compilerLine, b"missing")
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    run Bytes.append(&mut compilerLine, b"\n")
  }
  if let Option<Bytes>.Some { .. } = move run HostInput.variableNamed("SILK_PROFILE_GENERATE") {
    run Bytes.append(&mut compilerLine, b"profile-generate\n")
  }
  let mut home = Option<Path>.none()
  if let Option<Path>.Some { value: checkouts } = move run GitCheckouts.store() {
    home = run Path.parent(&checkouts)
  }
  let projects = List<Project>.asSlice(&selection.projects)
  let mut status = 0
  let mut document = run Bytes.copy(b"{\"packages\":[")
  let mut written = usize.ZERO
  let mut at = usize.ZERO
  while at < projects.length {
    let mut memberTypes = TypeTable.make()
    let hashed = run Effect.result(
      projectInputs(
        &projects[at],
        &options,
        &root,
        test,
        &standardLibrary,
        &home,
        &compiler,
        Bytes.asSlice(&compilerLine),
        run versionPolicy(options.ignoreSilkVersion),
      )
        |> Effect.provideMut<Types>(&mut memberTypes),
    )
    drop memberTypes
    HeapRelease.release()
    let hashedProject = match move hashed {
      Result<
        Option<HashedProject>,
        ApplicationError
          | InitialProfileProblem
          | FileError
          | ProcessError
          | HostInputError
          | InvalidModulePath
          | InvalidSourceRoot
          | InvalidDependency
          | MissingManifest
          | InvalidBuildComposition
          | MissingStandardLibrary
          | InvalidNativeLinkInput
          | TomlError
          | RegistrationClosed
          | ConflictingPackageSource
          | Cycle
          | RevisionMismatch
          | OutOfMemoryError
          | WriterError
      >.Success {
        value
      } => match move value {
        Option<HashedProject>.Some { value: listed } => move listed
        Option<HashedProject>.None => {
          status = worse(status, 1)
          at = at + usize.ONE
          continue
        }
      }
      Result<
        Option<HashedProject>,
        ApplicationError
          | InitialProfileProblem
          | FileError
          | ProcessError
          | HostInputError
          | InvalidModulePath
          | InvalidSourceRoot
          | InvalidDependency
          | MissingManifest
          | InvalidBuildComposition
          | MissingStandardLibrary
          | InvalidNativeLinkInput
          | TomlError
          | RegistrationClosed
          | ConflictingPackageSource
          | Cycle
          | RevisionMismatch
          | OutOfMemoryError
          | WriterError
      >.Failure {
        error
      } => {
        status = worse(status, run report(move error))
        at = at + usize.ONE
        continue
      }
    }
    let HashedProject { text, artifacts } = move hashedProject
    if list {
      if projects.length > usize.ONE {
        let mut header = run Bytes.copy(b"# ")
        run Bytes.append(&mut header, Projects.name(&projects[at]))
        run Bytes.append(&mut header, b"\n")
        run writeOutput(Bytes.asSlice(&header))
      }
      run writeOutput(Bytes.asSlice(&text))
    } else if json {
      if written > usize.ZERO {
        run Bytes.append(&mut document, b",")
      }
      written = written + usize.ONE
      run Bytes.append(&mut document, b"{\"name\":")
      run JsonText.appendString(&mut document, Projects.name(&projects[at]))
      run Bytes.append(&mut document, b",\"directory\":")
      run JsonText.appendString(&mut document, Path.rawBytes(Projects.directory(&projects[at])))
      run Bytes.append(&mut document, b",\"hash\":\"")
      run appendSha256Hex(&mut document, Bytes.asSlice(&text))
      run Bytes.append(&mut document, b"\",\"artifacts\":[")
      let paths = List<Bytes>.asSlice(&artifacts)
      let mut one = usize.ZERO
      while one < paths.length {
        if one > usize.ZERO {
          run Bytes.append(&mut document, b",")
        }
        run JsonText.appendString(&mut document, Bytes.asSlice(&paths[one]))
        one = one + usize.ONE
      }
      run Bytes.append(&mut document, b"]}")
    } else {
      let mut line = Bytes.make()
      run appendSha256Hex(&mut line, Bytes.asSlice(&text))
      if projects.length > usize.ONE {
        run Bytes.append(&mut line, b"  ")
        run Bytes.append(&mut line, Projects.name(&projects[at]))
      }
      run Bytes.append(&mut line, b"\n")
      run writeOutput(Bytes.asSlice(&line))
    }
    at = at + usize.ONE
  }
  if json {
    run Bytes.append(&mut document, b"]}\n")
    run writeOutput(Bytes.asSlice(&document))
  }
  return status
}

// `silk pack`: for each selected package that is released (`[package].publish` is not `false`),
// checks its manifest and source as `silk check` does, then writes `<name>-<version>.tar.gz` to
// `--output` or `build/package` and prints its path and SHA-256. A workspace selection skips
// unreleased members; a package selected by name or alone that is not released is refused. With
// `--list` it prints the files each archive would hold and writes nothing.
effect fn packProject(working: &Path, command: PackCommand) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let PackCommand {
    options: chosen,
    list,
    output,
    json,
    bin,
    sign,
    newKey,
    verify,
    key
  } = move command
  let mut options = move chosen
  if let Option<Bytes>.Some { value: keyPath } = &newKey {
    let mut random = OsRandom.make()
    return run newSigningKey(&run pathArgument(working, Bytes.asSlice(&keyPath)))
      |> Effect.provideMut<Random>(&mut random)
  }
  if let Option<Bytes>.Some { value: releaseDirectory } = &verify {
    return run verifyRelease(working, Bytes.asSlice(&releaseDirectory), &key)
  }

  // `--list` writes nothing, so it reads no key.
  let signer = if list {
    Option<MinisignSecretKey>.none()
  } else {
    match move run signingKey(working, &sign) {
      Option<Option<MinisignSecretKey>>.Some { value } => move value
      Option<Option<MinisignSecretKey>>.None => {
        return 2
      }
    }
  }
  let selection = match move run selectProjects(working, &options) {
    Option<Selection>.Some { value } => move value
    Option<Selection>.None => {
      return 2
    }
  }
  let standardLibrary = run standardLibraryFor(working, &options.standardLibrary)
  let compiler = run CacheStamp.compiler()
  let mut snapshot = ModuleSourceFiles.snapshot()
  let settings = silentProgress()
  let noEdits = Option<List<Edit>>.none()

  // A workspace or `--workspace` packs its released members; naming a package asks for that one.
  let named = List<Bytes>.length(&options.packages) > usize.ZERO
  let projects = List<Project>.asSlice(&selection.projects)
  let mut status = 0
  let mut packedCount = usize.ZERO
  let mut document = run Bytes.copy(b"{\"archives\":[")
  let mut sums = List<SumsFile>.make()
  let clang = run clangFor(working, &options.clang)

  // A package whose manifest has `[pack.binary]` ships binaries as `--bin` does: optimized
  // unless a profile or optimization is chosen.
  if !bin && !list
    && !ProjectCommands.optimizationSelected(
      (run commandArguments(run HostInput.argumentCount())).asSlice(),
    ) {
    let mut one = usize.ZERO
    while one < projects.length {
      if Projects.form(&projects[one]) == Form.Executable
        && PackArchives.packsBinaries(&run Projects.document(&projects[one])) {
        options.standard.optimize = Optimize.Speed
      }
      one = one + usize.ONE
    }
  }
  let mut at = usize.ZERO
  while at < projects.length {
    let project = &projects[at]
    at = at + usize.ONE
    let manifest = run Projects.document(project)
    if !PackArchives.publishes(&manifest) {
      if selection.members && !named {
        continue
      }
      let mut line = run Bytes.copy(b"silk pack: ")
      run Bytes.append(&mut line, Projects.name(project))
      run Bytes.append(&mut line, b" sets publish = false in [package], so it is not packed\n")
      run writeError(Bytes.asSlice(&line))
      status = worse(status, 1)
      continue
    }
    let listed = run Effect.result(packFiles(project))
    let files = match move listed {
      Result<List<Bytes>, PackRefused | FileError | TomlError | OutOfMemoryError>.Success {
        value
      } => move value
      Result<List<Bytes>, PackRefused | FileError | TomlError | OutOfMemoryError>.Failure {
        error
      } => match move error {
        PackRefused refused => {
          run reportPackRefused(project, &refused)
          status = worse(status, 1)
          continue
        }
        FileError failure => {
          fail move failure
        }
        TomlError malformed => {
          fail move malformed
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    if list {
      if projects.length > usize.ONE {
        let mut header = run Bytes.copy(b"# ")
        run Bytes.append(&mut header, Projects.name(project))
        run Bytes.append(&mut header, b"\n")
        run writeOutput(Bytes.asSlice(&header))
      }
      let names = List<Bytes>.asSlice(&files)
      let mut one = usize.ZERO
      while one < names.length {
        let mut line = run Bytes.copy(Bytes.asSlice(&names[one]))
        run Bytes.append(&mut line, b"\n")
        run writeOutput(Bytes.asSlice(&line))
        one = one + usize.ONE
      }
      continue
    }

    // The snapshot is shared by the members, so only what this check adds is this package's.
    let embeddedBefore = ModuleSourceFiles.snapshotEmbedded(&snapshot).length
    let mut memberTypes = TypeTable.make()
    let checked = run memberStatus(
      run Effect.result(
        checkOne(
          project,
          &options,
          &standardLibrary,
          false,
          false,
          false,
          &settings,
          &noEdits,
          false,
          true,
          &compiler,
          &mut snapshot,
        )
          |> Effect.provideMut<Types>(&mut memberTypes),
      ),
    )
    drop memberTypes
    HeapRelease.release()
    if checked != 0 {
      status = worse(status, checked)
      continue
    }
    let embeddedReads = ModuleSourceFiles.snapshotEmbedded(&snapshot)
    let made = run Effect.result(
      checkedArchive(
        project,
        List<Bytes>.asSlice(&files),
        Slice.view<EmbeddedRead>(
          embeddedReads,
          embeddedBefore,
          embeddedReads.length - embeddedBefore,
        ),
      ),
    )
    let packed = match move made {
      Result<Packed, PackRefused | FileError | TomlError | OutOfMemoryError>.Success {
        value
      } => move value
      Result<Packed, PackRefused | FileError | TomlError | OutOfMemoryError>.Failure {
        error
      } => match move error {
        PackRefused refused => {
          run reportPackRefused(project, &refused)
          status = worse(status, 1)
          continue
        }
        FileError failure => {
          fail move failure
        }
        TomlError malformed => {
          fail move malformed
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    let directory = match &output {
      Option<Bytes>.Some { value } => run pathArgument(working, Bytes.asSlice(&value))
      Option<Bytes>.None => run Path.join(Projects.outputDirectory(project), "package")
    }
    run FileSystem.createDirectoriesRecursively(&directory)
    let mut label = run Bytes.copy(Projects.name(project))
    run Bytes.append(&mut label, b" ")
    run Bytes.append(&mut label, ManifestFields.version(&manifest))
    let WrittenAsset { path, digest } = run writeAsset(
      &directory,
      Bytes.asSlice(&packed.fileName),
      Bytes.asSlice(&packed.bytes),
      Bytes.asSlice(&label),
      &signer,
      &mut sums,
    )

    // The documentation sits beside the archive, a release asset of its own that a build of the
    // archive never reads.
    let mut documentationPath = Option<Path>.none()
    if let Option<Path>.Some { value: library } = &standardLibrary {
      let mut documentationTypes = TypeTable.make()
      let documented = run Effect.result(
        DocumentationCommand.packageDocumentation(
          project,
          run Path.fromBytes(Path.rawBytes(&library)),
        )
          |> Effect.provideMut<Types>(&mut documentationTypes),
      )
      drop documentationTypes
      HeapRelease.release()
      match move documented {
        Result<Bytes, DocumentationError>.Success { value: encoded } => {
          let mut name = run Bytes.copy(Bytes.asSlice(&packed.stem))
          run Bytes.append(&mut name, b".docs.json")
          let written = run writeAsset(
            &directory,
            Bytes.asSlice(&name),
            Bytes.asSlice(&encoded),
            Bytes.asSlice(&label),
            &signer,
            &mut sums,
          )
          documentationPath = Option<Path>.some(move written.path)
        }
        Result<Bytes, DocumentationError>.Failure { error } => {
          status = worse(status, run DocumentationCommand.failed(b"pack", move error))
          continue
        }
      }
    }

    // Binaries come from an executable; a library's archive is its only release asset.
    let mut binaries = List<WrittenBinary>.make()
    if (bin || (!list && PackArchives.packsBinaries(&manifest)))
      && Projects.form(project) == Form.Executable {
      let PackedBinaries { status: built, archives } = run packBinaries(
        project,
        &options,
        List<Bytes>.asSlice(&files),
        &directory,
        &standardLibrary,
        &clang,
        &compiler,
        Bytes.asSlice(&label),
        &signer,
        &mut sums,
      )
      status = worse(status, built)
      binaries = move archives
    }

    // The object is written without `--json` too, for scripts that read the pack summary.
    if packedCount > usize.ZERO {
      run Bytes.append(&mut document, b",")
    }
    run Bytes.append(&mut document, b"{\"name\":")
    run JsonText.appendString(&mut document, Projects.name(project))
    run Bytes.append(&mut document, b",\"version\":")
    run JsonText.appendString(&mut document, ManifestFields.version(&manifest))
    run Bytes.append(&mut document, b",\"path\":")
    run JsonText.appendString(&mut document, Path.rawBytes(&path))
    run Bytes.append(&mut document, b",\"sha256\":")
    run JsonText.appendString(&mut document, Bytes.asSlice(&digest))
    run Bytes.append(&mut document, b",\"documentation\":")
    match &documentationPath {
      Option<Path>.Some { value: written } => run JsonText.appendString(
        &mut document,
        Path.rawBytes(&written),
      )
      Option<Path>.None => run Bytes.append(&mut document, b"null")
    }
    run Bytes.append(&mut document, b",\"files\":[")
    let names = List<Bytes>.asSlice(&files)
    let mut one = usize.ZERO
    while one < names.length {
      if one > usize.ZERO {
        run Bytes.append(&mut document, b",")
      }
      run JsonText.appendString(&mut document, Bytes.asSlice(&names[one]))
      one = one + usize.ONE
    }
    run Bytes.append(&mut document, b"],\"binaries\":[")
    let built = List<WrittenBinary>.asSlice(&binaries)
    let mut each = usize.ZERO
    while each < built.length {
      if each > usize.ZERO {
        run Bytes.append(&mut document, b",")
      }
      run Bytes.append(&mut document, b"{\"platform\":")
      run JsonText.appendString(&mut document, Bytes.asSlice(&built[each].platform))
      run Bytes.append(&mut document, b",\"path\":")
      run JsonText.appendString(&mut document, Path.rawBytes(&built[each].path))
      run Bytes.append(&mut document, b",\"sha256\":")
      run JsonText.appendString(&mut document, Bytes.asSlice(&built[each].digest))
      run Bytes.append(&mut document, b"}")
      each = each + usize.ONE
    }
    run Bytes.append(&mut document, b"]}")
    if !json {
      let mut line = run Bytes.copy(b"wrote ")
      run Bytes.append(&mut line, Path.rawBytes(&path))
      run Bytes.append(&mut line, b" (")
      run appendCount(&mut line, packed.files)
      run Bytes.append(
        &mut line,
        if packed.files == usize.ONE {
          b" file, "
        } else {
          b" files, "
        },
      )
      run appendCount(&mut line, Bytes.length(&packed.bytes))
      run Bytes.append(&mut line, b" bytes)\nsha256 ")
      run Bytes.append(&mut line, Bytes.asSlice(&digest))
      run Bytes.append(&mut line, b"\n")
      if let Option<Path>.Some { value: written } = &documentationPath {
        run Bytes.append(&mut line, b"wrote ")
        run Bytes.append(&mut line, Path.rawBytes(&written))
        run Bytes.append(&mut line, b"\n")
      }
      let built = List<WrittenBinary>.asSlice(&binaries)
      let mut each = usize.ZERO
      while each < built.length {
        run Bytes.append(&mut line, b"wrote ")
        run Bytes.append(&mut line, Path.rawBytes(&built[each].path))
        run Bytes.append(&mut line, b" (")
        run appendCount(&mut line, built[each].size)
        run Bytes.append(&mut line, b" bytes)\nsha256 ")
        run Bytes.append(&mut line, Bytes.asSlice(&built[each].digest))
        run Bytes.append(&mut line, b"\n")
        each = each + usize.ONE
      }
      run writeOutput(Bytes.asSlice(&line))
    }
    packedCount = packedCount + usize.ONE
  }

  // Each output directory gets a `SHA256SUMS` of every asset this run wrote there.
  let listed = List<SumsFile>.asSlice(&sums)
  let mut one = usize.ZERO
  while one < listed.length {
    let sumsPath = run Path.join(&listed[one].directory, "SHA256SUMS")
    run FileSystem.writeFile(&sumsPath, Bytes.asSlice(&listed[one].text))
    if let Option<MinisignSecretKey>.Some { value: secret } = &signer {
      run writeSignature(&sumsPath, Bytes.asSlice(&listed[one].text), b"SHA256SUMS", &secret)
    }
    one = one + usize.ONE
  }
  run Bytes.append(&mut document, b"]}\n")
  if json {
    run writeOutput(Bytes.asSlice(&document))
  }
  return status
}

// The `SHA256SUMS` text `silk pack` writes in one output directory, in `sha256sum` format.
struct SumsFile {
  directory: Path,
  text: Bytes,
}

// One file `silk pack` wrote, and its SHA-256 in lowercase hexadecimal.
struct WrittenAsset {
  path: Path,
  digest: Bytes,
}

// One binary archive `silk pack --bin` wrote: its `<target>[-<profile>]` platform, path, SHA-256
// and size.
struct WrittenBinary {
  platform: Bytes,
  path: Path,
  digest: Bytes,
  size: usize,
}

// The binary archives `silk pack --bin` wrote for one package, and the worst build status.
struct PackedBinaries {
  status: i32,
  archives: List<WrittenBinary>,
}

// Writes `content` to `directory`/`name`, signs it with `signer` in `<name>.minisig` with the
// trusted comment `<label> <name>`, and adds its line to the directory's `SHA256SUMS`.
effect fn writeAsset(
  directory: &Path,
  name: &[u8],
  content: &[u8],
  label: &[u8],
  signer: &Option<MinisignSecretKey>,
  sums: &mut List<SumsFile>,
) -> WrittenAsset
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let path = run Path.joinBytes(directory, name)
  run FileSystem.writeFile(&path, content)
  if let Option<MinisignSecretKey>.Some { value: secret } = &signer.* {
    let mut comment = run Bytes.copy(label)
    run Bytes.append(&mut comment, b" ")
    run Bytes.append(&mut comment, name)
    run writeSignature(&path, content, Bytes.asSlice(&comment), &secret)
  }
  let mut digest = Bytes.make()
  run appendSha256Hex(&mut digest, content)
  let mut line = run Bytes.copy(Bytes.asSlice(&digest))
  run Bytes.append(&mut line, b"  ")
  run Bytes.append(&mut line, name)
  run Bytes.append(&mut line, b"\n")
  let files = List<SumsFile>.asMutSlice(&mut sums.*)
  let mut at = usize.ZERO
  while at < files.length {
    if same(Path.rawBytes(&files[at].directory), Path.rawBytes(directory)) {
      run Bytes.append(&mut files[at].text, Bytes.asSlice(&line))
      return WrittenAsset { path: move path, digest: move digest }
    }
    at = at + usize.ONE
  }
  run List<SumsFile>.append(
    &mut sums.*,
    SumsFile { directory: run Path.fromBytes(Path.rawBytes(directory)), text: move line },
  )
  return WrittenAsset { path: move path, digest: move digest }
}

// Writes the minisign signature of the file `path` holding `content` to `<path>.minisig`.
effect fn writeSignature(
  path: &Path,
  content: &[u8],
  comment: &[u8],
  secret: &MinisignSecretKey,
) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let signature = match move run Minisign.sign(secret, content, comment) {
    Result<Bytes, MinisignError>.Success { value } => move value

    // Names of packed files hold no line break and stay far below the comment limit.
    Result<Bytes, MinisignError>.Failure { .. } => {
      fail OutOfMemoryError {}
    }
  }
  let mut signed = run Bytes.copy(Path.rawBytes(path))
  run Bytes.append(&mut signed, b".minisig")
  return run FileSystem.writeFile(
    &run Path.fromBytes(Bytes.asSlice(&signed)),
    Bytes.asSlice(&signature),
  )
}

// The key `silk pack` signs with: the minisign secret key file `--sign` names, else the key text
// of `SILK_SIGNING_KEY`, decrypted with `SILK_SIGNING_PASSWORD` when it is encrypted. `Some(None)`
// signs nothing; `None` after reporting why the key cannot be read.
effect fn signingKey(working: &Path, named: &Option<Bytes>) -> Option<Option<MinisignSecretKey>>
  ! ApplicationError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut HostInput | &mut Allocator {
  let text = match &named.* {
    Option<Bytes>.Some { value } => run FileSystem.readFile(
      &run pathArgument(working, Bytes.asSlice(&value)),
    )
    Option<Bytes>.None => match move run HostInput.variableNamed("SILK_SIGNING_KEY") {
      Option<Bytes>.Some { value } => move value
      Option<Bytes>.None => {
        return Option<Option<MinisignSecretKey>>.some(Option<MinisignSecretKey>.none())
      }
    }
  }
  let password = run HostInput.variableNamed("SILK_SIGNING_PASSWORD")
  let given = match &password {
    Option<Bytes>.Some { value } => Option<&[u8]>.some(Bytes.asSlice(&value))
    Option<Bytes>.None => Option<&[u8]>.none()
  }
  return match move run Minisign.secretKey(Bytes.asSlice(&text), given) {
    Result<MinisignSecretKey, MinisignError>.Success { value } => Option<
      Option<MinisignSecretKey>
    >.some(Option<MinisignSecretKey>.some(move value))
    Result<MinisignSecretKey, MinisignError>.Failure { error } => {
      let mut line = run Bytes.copy(b"silk pack: cannot sign: ")
      run Bytes.append(&mut line, Minisign.describe(error))
      if error == MinisignError.PasswordRequired {
        run Bytes.append(&mut line, b"; set SILK_SIGNING_PASSWORD")
      }
      run Bytes.append(&mut line, b"\n")
      run writeError(Bytes.asSlice(&line))
      Option<Option<MinisignSecretKey>>.none()
    }
  }
}

// `silk pack --verify <directory>`: checks the release files in `directory` as `PackVerify`
// describes, against the minisign public key file `--key` names or `minisign.pub` in the working
// directory. Prints each verified file; 1 after naming every fault, 2 without a usable key.
effect fn verifyRelease(working: &Path, named: &[u8], keyFile: &Option<Bytes>) -> i32
  ! ApplicationError | FileError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut Allocator | &mut Writer {
  let keyPath = match &keyFile.* {
    Option<Bytes>.Some { value } => run pathArgument(working, Bytes.asSlice(&value))
    Option<Bytes>.None => run Path.joinBytes(working, b"minisign.pub")
  }
  let keyText = match move run Effect.result(FileSystem.readFile(&keyPath)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError unread => {
        drop unread
        let mut line = run Bytes.copy(b"silk pack: cannot read the public key ")
        run Bytes.append(&mut line, Path.rawBytes(&keyPath))
        if Option<Bytes>.isNone(&keyFile.*) {
          run Bytes.append(&mut line, b"; name the key file with --key")
        }
        run Bytes.append(&mut line, b"\n")
        run writeError(Bytes.asSlice(&line))
        return 2
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let signer = match Minisign.key(PackVerifies.publicKeyLine(Bytes.asSlice(&keyText))) {
    Result<MinisignKey, MinisignError>.Success { value } => move value
    Result<MinisignKey, MinisignError>.Failure { error } => {
      let mut line = run Bytes.copy(b"silk pack: ")
      run Bytes.append(&mut line, Path.rawBytes(&keyPath))
      run Bytes.append(&mut line, b": ")
      run Bytes.append(&mut line, Minisign.describe(error))
      run Bytes.append(&mut line, b"\n")
      run writeError(Bytes.asSlice(&line))
      return 2
    }
  }
  let directory = run pathArgument(working, named)
  let Verified { files, faults } = run PackVerifies.verify(&directory, &signer)
  let verified = List<Bytes>.asSlice(&files)
  let mut lines = Bytes.make()
  let mut at = usize.ZERO
  while at < verified.length {
    run Bytes.append(&mut lines, b"verified ")
    run Bytes.append(&mut lines, Bytes.asSlice(&verified[at]))
    run Bytes.append(&mut lines, b"\n")
    at = at + usize.ONE
  }
  run writeOutput(Bytes.asSlice(&lines))
  let found = List<Bytes>.asSlice(&faults)
  if found.length == usize.ZERO {
    return 0
  }
  let mut refused = Bytes.make()
  let mut one = usize.ZERO
  while one < found.length {
    run Bytes.append(&mut refused, b"silk pack: ")
    run Bytes.append(&mut refused, Bytes.asSlice(&found[one]))
    run Bytes.append(&mut refused, b"\n")
    one = one + usize.ONE
  }
  run writeError(Bytes.asSlice(&refused))
  return 1
}

// `silk pack --new-key <path>`: writes a new minisign secret key to `path`, encrypted with
// `SILK_SIGNING_PASSWORD` when it is set, and its public key to `path` with `.key` replaced by, or
// else followed by, `.pub`. Refuses to replace either file.
effect fn newSigningKey(path: &Path) -> i32
  ! FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut HostInput | &mut Allocator | &mut Writer | &mut Random {
  let secretPath = Path.rawBytes(path)
  let mut publicText = Bytes.make()
  if secretPath.length > 4 && same(Slice.view<u8>(secretPath, secretPath.length - 4, 4), b".key") {
    run Bytes.append(&mut publicText, Slice.view<u8>(secretPath, usize.ZERO, secretPath.length - 4))
  } else {
    run Bytes.append(&mut publicText, secretPath)
  }
  run Bytes.append(&mut publicText, b".pub")
  let publicPath = run Path.fromBytes(Bytes.asSlice(&publicText))
  let secretExists = run FileSystem.exists(path)
  let publicExists = run FileSystem.exists(&publicPath)
  if secretExists || publicExists {
    let mut line = run Bytes.copy(b"silk pack: ")
    run Bytes.append(
      &mut line,
      if secretExists {
        secretPath
      } else {
        Bytes.asSlice(&publicText)
      },
    )
    run Bytes.append(&mut line, b" already exists; remove it or choose another path\n")
    run writeError(Bytes.asSlice(&line))
    return 2
  }
  let secret = run MinisignSecretKey.generate()
  let password = run HostInput.variableNamed("SILK_SIGNING_PASSWORD")
  let given = match &password {
    Option<Bytes>.Some { value } => Option<&[u8]>.some(Bytes.asSlice(&value))
    Option<Bytes>.None => Option<&[u8]>.none()
  }
  if let Option<Path>.Some { value: directory } = move run Path.parent(path) {
    run FileSystem.createDirectoriesRecursively(&directory)
  }
  run FileSystem.writeFile(path, Bytes.asSlice(&run Minisign.secretKeyFile(&secret, given)))
  run FileSystem.writeFile(&publicPath, Bytes.asSlice(&run Minisign.publicKeyFile(&secret)))
  let mut line = run Bytes.copy(b"wrote ")
  run Bytes.append(&mut line, secretPath)
  if Option<Bytes>.isNone(&password) {
    run Bytes.append(&mut line, b" (not encrypted; set SILK_SIGNING_PASSWORD to encrypt it)")
  }
  run Bytes.append(&mut line, b"\nwrote ")
  run Bytes.append(&mut line, Bytes.asSlice(&publicText))
  run Bytes.append(&mut line, b"\nkey id ")
  run Bytes.append(&mut line, &secret.idText())
  run Bytes.append(&mut line, b"\npublic key ")
  run Bytes.append(&mut line, &secret.publicKeyText())
  run Bytes.append(&mut line, b"\n")
  run writeOutput(Bytes.asSlice(&line))
  return 0
}

// `silk pack --bin` for one executable package: builds each planned target as `silk build` does
// and writes its binary archive (see `PackArchive.binaryArchive`) to `directory`, named by target.
effect fn packBinaries(
  project: &Project,
  options: &ProjectOptions,
  files: &[Bytes],
  directory: &Path,
  standardLibrary: &Option<Path>,
  clang: &Option<Bytes>,
  compiler: &Option<Bytes>,
  label: &[u8],
  signer: &Option<MinisignSecretKey>,
  sums: &mut List<SumsFile>,
) -> PackedBinaries
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let mut archives = List<WrittenBinary>.make()
  let mut plans = match move run projectPlans(options) {
    Option<List<ProjectPlan>>.Some { value } => move value
    Option<List<ProjectPlan>>.None => {
      return PackedBinaries { status: 2, archives: move archives }
    }
  }
  let packages = run progressSettings(options, usize.ONE)
  let settings = unitSettings(&packages, List<ProjectPlan>.length(&plans))
  let mut status = 0
  while List<ProjectPlan>.length(&plans) > usize.ZERO {
    let plan = List<ProjectPlan>.remove(&mut plans, usize.ZERO)
    let artifact = run buildProjectTarget(
      project,
      move plan,
      standardLibrary,
      clang,
      true,
      false,
      &settings,
      compiler,
      options.ignoreWarnings,
      true,
      Versions.Checked,
    )
    if artifact.status != 0 {
      status = worse(status, artifact.status)
      continue
    }
    let mut platform = run Bytes.copy(Target.name(&artifact.target))
    let made = run Effect.result(
      packedBinary(
        project,
        Target.name(&artifact.target),
        Bytes.asSlice(&platform),
        &artifact.path,
        files,
      ),
    )
    let packed = match move made {
      Result<Packed, PackRefused | FileError | TomlError | OutOfMemoryError>.Success {
        value
      } => move value
      Result<Packed, PackRefused | FileError | TomlError | OutOfMemoryError>.Failure {
        error
      } => match move error {
        PackRefused refused => {
          run reportPackRefused(project, &refused)
          status = worse(status, 1)
          continue
        }
        FileError failure => {
          fail move failure
        }
        TomlError malformed => {
          fail move malformed
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    let WrittenAsset { path, digest } = run writeAsset(
      directory,
      Bytes.asSlice(&packed.fileName),
      Bytes.asSlice(&packed.bytes),
      label,
      signer,
      &mut sums.*,
    )
    run List<WrittenBinary>.append(
      &mut archives,
      WrittenBinary {
        platform: move platform,
        path: move path,
        digest: move digest,
        size: Bytes.length(&packed.bytes),
      },
    )
  }
  return PackedBinaries { status: status, archives: move archives }
}

// One target's binary archive, written as the manifest's `[pack.binary]` says for `target`.
effect fn packedBinary(
  project: &Project,
  target: &[u8],
  platform: &[u8],
  executable: &Path,
  files: &[Bytes],
) -> Packed
  ! PackRefused | FileError | TomlError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let layout = run PackArchives.binaryLayout(project, target)
  return run PackArchives.binaryArchive(project, platform, executable, files, &layout)
}

// The files of `project`'s archive, after checking its manifest can be packed.
effect fn packFiles(project: &Project) -> List<Bytes>
  ! PackRefused | FileError | TomlError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  // The manifest is checked as the archive writes it out: with its workspace's `silk-version` and
  // the dependencies it takes from the workspace.
  let text = run PackArchives.manifestText(project)
  let packed = run Toml.parse(Bytes.asSlice(&text))
  run PackArchives.checkManifest(&packed)
  return run PackArchives.files(project)
}

// The archive of `project` holding `files`, once it holds each file in `reads`, which the check
// of the package read as embedded.
effect fn checkedArchive(project: &Project, files: &[Bytes], reads: &[EmbeddedRead]) -> Packed
  ! PackRefused | FileError | TomlError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  run PackArchives.checkEmbedded(files, reads)
  return run PackArchives.archive(project, files)
}

effect fn reportPackRefused(project: &Project, refused: &PackRefused) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Allocator {
  let mut line = run Bytes.copy(b"silk pack: ")
  run Bytes.append(&mut line, Projects.name(project))
  run Bytes.append(&mut line, b": ")
  run Bytes.append(&mut line, Bytes.asSlice(&refused.detail))
  run Bytes.append(&mut line, b"\n")
  return run writeError(Bytes.asSlice(&line))
}

// Appends `value` in decimal.
effect fn appendCount(out: &mut Bytes, value: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value >= usize.add(0, 10) {
    run appendCount(&mut out.*, usize.divide(value, usize.add(0, 10)))
  }
  let digit: [u8; 1] = [usize.toU8(usize.add(0, 48) + usize.remainder(value, usize.add(0, 10)))]
  return run Bytes.append(&mut out.*, &digit)
}

// What `silk hash` reads for one project: the text it digests, and the artifact each planned build
// writes (none for a library, whose build only checks it).
struct HashedProject {
  text: Bytes,
  artifacts: List<Bytes>,
}

// Appends the SHA-256 of `bytes` in lowercase hexadecimal.
effect fn appendSha256Hex(out: &mut Bytes, bytes: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let digest = Sha256.hash(bytes)
  let mut byte = usize.ZERO
  while byte < 32 {
    run appendHexByte(&mut out.*, digest[byte])
    byte = byte + usize.ONE
  }
  return ()
}

// The text `silk hash` digests for `project`: a version line, `compilerLine`, one `profile` line
// per planned compilation, then every input loading the program read (`BuildInputs.inputLines`).
// None when the project plans no compilation or its load fails, after reporting why.
effect fn projectInputs(
  project: &Project,
  options: &ProjectOptions,
  root: &Option<Bytes>,
  testing: bool,
  standardLibrary: &Option<Path>,
  home: &Option<Path>,
  compiler: &Option<Bytes>,
  compilerLine: &[u8],
  versions: Versions,
) -> Option<HashedProject>
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  // `--test` plans what `silk test` builds: the host, as an executable with the test runner.
  let listed = run projectPlans(options)
  let mut plans = match move listed {
    Option<List<ProjectPlan>>.Some { value } => move value
    Option<List<ProjectPlan>>.None => {
      return Option<HashedProject>.none()
    }
  }
  if testing && List<ProjectPlan>.length(&plans) > usize.ONE {
    while List<ProjectPlan>.length(&plans) > usize.ONE {
      let extra = List<ProjectPlan>.remove(&mut plans, usize.ONE)
      drop extra
    }
  }

  // `--root` loads another root module of the package, as `test --root` does.
  let mut rootEntry = Option<Path>.none()
  let mut text = run Bytes.copy(b"silk-hash 1\n")
  if let Option<Bytes>.Some { value } = &root.* {
    let relative = match move run testSource(project, Bytes.asSlice(&value)) {
      Option<Bytes>.Some { value: named } => move named
      Option<Bytes>.None => {
        return Option<HashedProject>.none()
      }
    }
    rootEntry = Option<Path>.some(
      run pathArgument(Projects.directory(project), Bytes.asSlice(&value)),
    )
    run Bytes.append(&mut text, b"root ")
    run Bytes.append(&mut text, Bytes.asSlice(&relative))
    run Bytes.append(&mut text, b"\n")
  }
  if testing {
    run Bytes.append(&mut text, b"test\n")
  }
  let mut artifacts = List<Bytes>.make()
  run Bytes.append(&mut text, compilerLine)
  let mut recorder = run BuildInputs.recorder()

  // The build directory holds outputs and caches, never inputs.
  run BuildInputs.exclude(&mut recorder, Projects.outputDirectory(project))

  // Members of one project share what they read, so each file is read once for every plan.
  let mut snapshot = ModuleSourceFiles.snapshot()
  let settings = silentProgress()
  while List<ProjectPlan>.length(&plans) > usize.ZERO {
    let plan = List<ProjectPlan>.remove(&mut plans, usize.ZERO)
    let form = ProjectPlans.form(&plan, project)
    let entry = match &rootEntry {
      Option<Path>.Some { value } => run Path.fromBytes(Path.rawBytes(&value))
      Option<Path>.None => run Path.fromBytes(Path.rawBytes(ProjectPlans.entry(&plan, project)))
    }
    let ProjectPlan {
      input: planned,
      bindings,
      task: _,
      maxMemory: unlimited,
      stackSize: _,
      entry: _,
      unsandboxedTools
    } = move plan
    drop unlimited
    let mut input = move planned
    if testing {
      input.artifact = Option<Bytes>.some(run Bytes.copy(Projects.profileArtifact(Form.Executable)))
    } else if let Option<Bytes>.None = &input.artifact {
      input.artifact = Option<Bytes>.some(run Bytes.copy(Projects.profileArtifact(form)))
    }
    let profile = run InitialProfile.freeze(&input)
    let target = Target.forId(Target.id(InitialProfile.target(&profile)))
    let mut identity = Bytes.make()
    run InitialProfile.appendIdentity(&profile, &mut identity)
    run Bytes.append(&mut text, b"profile ")
    run Bytes.append(&mut text, Target.name(&target))
    run Bytes.append(&mut text, b" ")
    run appendDigestHex(&mut text, ContentHash.of(Bytes.asSlice(&identity)))
    run Bytes.append(&mut text, b"\n")
    if !testing && form != Form.Library {
      if let Option<&[u8]>.Some { value: optimization } = move InitialProfile.text(
        &profile,
        b"optimization",
      ) {
        let artifact = run Projects.artifactAs(
          project,
          form,
          Target.name(&target),
          Projects.mode(optimization),
        )
        run artifacts.append(run Bytes.copy(Path.rawBytes(&artifact)))
      }
    }
    let library = match &standardLibrary.* {
      Option<Path>.Some { value } => Option<Path>.some(run Path.fromBytes(Path.rawBytes(&value)))
      Option<Path>.None => Option<Path>.none()
    }
    let format = DiagnosticFormat.Human { root: run diagnosticRoot(Projects.manifest(project)) }
    let mut out = Bytes.make()
    let mut progress = run startProgress(&settings, b"Hashing", project, &target, b"")

    // No import summaries: saving them writes the cache and looks at its parent directories.
    let prepared = run prepare(
      &entry,
      Option<&Path>.some(Projects.manifest(project)),
      move library,
      &profile,
      move bindings,
      testing,
      StoreMode.Transient,
      Option<&[u8]>.none(),
      Option<&Path>.none(),
      compiler,
      &mut snapshot,
      &format,
      &mut out,
      &mut progress,
      Option<&CompilationRequest>.none(),
      Option<&CompilationDefinition>.none(),
      unsandboxedTools,
      false,
      versions,
    )
      |> Effect.provideMut<FileSystem>(&mut recorder)

    // A load that fails is reported and hashes nothing, so a cache never keys a broken load, such as
    // one whose git fetch failed.
    if let Prepared.Finished { status } = &prepared {
      run writeError(Bytes.asSlice(&out))
      if status != 0 {
        return Option<HashedProject>.none()
      }
    }

    // Native sources are read by Clang during a build, not by loading; read them here so they are noted.
    if let Prepared.Ready { analysis } = &prepared {
      run NativeCompile.readInputs(ModuleSourceFiles.nativeLinkInputs(&analysis.sources))
        |> Effect.provideMut<FileSystem>(&mut recorder)
    }
    drop prepared
    drop out
  }
  let mut anchors = List<BuildInputs.Anchor>.make()
  if let Option<Path>.Some { value } = &standardLibrary.* {
    run List<BuildInputs.Anchor>.append(
      &mut anchors,
      BuildInputs.Anchor {
        directory: run Bytes.copy(Path.rawBytes(&value)),
        label: run Bytes.copy(b"<std>"),
      },
    )
  }
  if let Option<Path>.Some { value } = &home.* {
    run List<BuildInputs.Anchor>.append(
      &mut anchors,
      BuildInputs.Anchor {
        directory: run Bytes.copy(Path.rawBytes(&value)),
        label: run Bytes.copy(b"<home>"),
      },
    )
  }
  run List<BuildInputs.Anchor>.append(
    &mut anchors,
    BuildInputs.Anchor {
      directory: run diagnosticRoot(Projects.manifest(project)),
      label: Bytes.make(),
    },
  )
  run Bytes.append(
    &mut text,
    Bytes.asSlice(
      &run BuildInputs.inputLines(&recorder, List<BuildInputs.Anchor>.asSlice(&anchors)),
    ),
  )
  return Option<HashedProject>.some(HashedProject { text: move text, artifacts: move artifacts })
}

// Appends the first line of `clang --version` for the Clang a build selects (`--clang`, then
// `SILK_CLANG`, then `PATH`), or `none` when there is none or it does not answer.
effect fn appendClangIdentity(out: &mut Bytes, selected: &Option<Bytes>) -> ()
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let mut named = Option<&[u8]>.none()
  if let Option<Bytes>.Some { value } = &selected.* {
    named = Option<&[u8]>.some(Bytes.asSlice(&value))
  }
  let clang = match move run NativeToolchain.compiler(move named) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return run Bytes.append(&mut out.*, b"none")
    }
  }
  let mut request = run NativeToolchain.request(&clang)
  run ChildProcess.addArgument(&mut request, "--version")
  let probed = match move run Effect.result(ChildProcess.submit(&request)) {
    Result<ProcessOutcome, ProcessError | OutOfMemoryError>.Success { value } => move value
    Result<ProcessOutcome, ProcessError | OutOfMemoryError>.Failure { error } => match move error {
      ProcessError unstarted => {
        drop unstarted
        return run Bytes.append(&mut out.*, b"none")
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let output = ChildProcess.outputBytes(&probed)
  let mut end = usize.ZERO
  while end < output.length && output[end] != 10 && output[end] != 13 {
    end = end + usize.ONE
  }
  if end == usize.ZERO {
    return run Bytes.append(&mut out.*, b"none")
  }
  return run Bytes.append(&mut out.*, Slice.view<u8>(output, usize.ZERO, end))
}

effect fn appendDigestHex(out: &mut Bytes, digest: ContentHash) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let words = [digest.high, digest.low]
  let mut at = usize.ZERO
  while at < 2 {
    let mut shift = usize.ZERO
    while shift < 8 {
      run appendHexByte(
        &mut out.*,
        u64.toU8(u64.bitAnd(u64.shiftRight(words[at], usize.toU64((7 - shift) * 8)), 255)),
      )
      shift = shift + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn appendHexByte(out: &mut Bytes, byte: u8) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let digits = b"0123456789abcdef"
  let pair: [u8; 2] = [digits[u8.toUsize(byte / 16)], digits[u8.toUsize(byte % 16)]]
  return run Bytes.append(&mut out.*, &pair)
}

// Normalizes selection options before dispatching the same task command used by `silk task`.
effect fn taskAlias(working: &Path, name: &[u8], arguments: &[Bytes]) -> Option<i32>
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let mut own = List<Bytes>.make()
  let mut forwarded = List<Bytes>.make()
  run forwarded.append(run Bytes.copy(name))
  let mut at: usize = 0
  let mut literal = false
  while at < arguments.length {
    let word = arguments[at].asSlice()
    if same(word, b"--") {
      literal = true
    }
    // The compiler's own options stay with the compiler, so a tasks program reads only its own;
    // the compilations its graph runs honor them through the environment `tasksEnvironment` sets.
    let selection = same(word, b"--manifest-path") || same(word, b"--stdlib")
      || same(word, b"--clang")
      || same(word, b"--package")
      || same(word, b"-p")
      || same(word, b"--backend")
      || same(word, b"--progress")
    let switch = same(word, b"--workspace") || same(word, b"--quiet") || same(word, b"-q")
      || same(word, b"--timings")
      || same(word, b"--ignore-warnings")
      || selects(word, b"--manifest-path=")
      || selects(word, b"--stdlib=")
      || selects(word, b"--clang=")
      || selects(word, b"--package=")
      || selects(word, b"--backend=")
      || selects(word, b"--progress=")
    if !literal && selection {
      if at + 1 >= arguments.length {
        return Option<i32>.none()
      }
      run own.append(run Bytes.copy(word))
      run own.append(run Bytes.copy(arguments[at + 1].asSlice()))
      at = at + 2
    } else if !literal && switch {
      run own.append(run Bytes.copy(word))
      at = at + 1
    } else {
      run forwarded.append(run Bytes.copy(word))
      at = at + 1
    }
  }
  while forwarded.length() > 0 {
    run own.append(forwarded.remove(0))
  }
  let parsed = match move run Effect.result(ProjectCommands.parseTask(own.asSlice())) {
    Result<TaskCommand, InvalidProjectCommand | OutOfMemoryError>.Success { value } => move value
    Result<TaskCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {
      error
    } => match move error {
      InvalidProjectCommand invalid => {
        run writeError(invalid.reason.asSlice())
        run writeError(b"\n")
        return Option<i32>.some(2)
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  return Option<i32>.some(run taskProject(working, move parsed))
}

effect fn taskProject(working: &Path, command: TaskCommand) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let TaskCommand { options, arguments: named, help, json } = move command
  if help && json {
    return run taskHelpJson(working, &options)
  }
  if help {
    return run taskHelp(working, &options)
  }
  let mut arguments = move named
  if arguments.length() == 0 {
    run arguments.append(run Bytes.copy(b"--help"))
  }
  let name = arguments.asSlice()[0].asSlice()
  let builtin = same(name, b"build") || same(name, b"run") || same(name, b"test")
    || same(name, b"plan")
  let mut selection = match move run selectProjects(working, &options) {
    Option<Selection>.Some { value } => move value
    Option<Selection>.None => {
      return 2
    }
  }
  run noteOverrides(List<Project>.asSlice(&selection.projects))
  if !builtin && (selection.members || selection.projects.length() != 1) {
    run writeError(
      b"silk: a custom task needs one package; pass --manifest-path <package>/silk.toml\n",
    )
    return 2
  }
  if same(name, b"run") && selection.members && options.packages.length() == 0 {
    let mut runnable = List<Project>.make()
    while selection.projects.length() > 0 {
      let project = selection.projects.remove(0)
      if Projects.runnable(&project) {
        run runnable.append(move project)
      }
    }
    selection.projects = move runnable
  }
  if same(name, b"run") && selection.projects.length() != 1 {
    run writeError(b"silk: `run` needs one executable; pass --package <name>\n")
    return 2
  }
  let planning = same(name, b"plan") && !ProjectCommands.asksHelp(arguments.asSlice())
  let mut previous = List<RequestCapture.Snapshot>.make()
  if planning {
    let projects = selection.projects.asSlice()
    let mut at: usize = 0
    while at < projects.length {
      let directory = run Path.join(Projects.outputDirectory(&projects[at]), "requests")
      run RequestCapture.snapshot(&mut previous, &directory)
      at = at + 1
    }
  }
  if planning {
    if !run ProcessImage.setVariable(b"SILK_PLAN_PENDING", b"1") {
      return 2
    }
  }
  let mut sets = List<RequestCapture.Set>.make()
  let mut tests = TestSelection {
    multiplePackages: selection.projects.length() > 1,
    filtered: false,
    matched: false,
  }
  let mut status = 0
  while selection.projects.length() > 0 {
    let project = selection.projects.remove(0)
    let selected = run taskOptions(&project, &options)
    let result = match move run Effect.result(
      taskForProject(working, &project, &selected, arguments.asSlice(), builtin, &mut tests),
    ) {
      Result.Success { value } => value
      Result.Failure { error } => {
        if planning {
          let _reset = run ProcessImage.setVariable(b"SILK_PLAN_PENDING", b"0")
          run RequestCapture.restore(previous.asSlice())
        }
        fail move error
      }
    }
    if status == 0 {
      status = result
    }
    if planning && result == 0 {
      let directory = run Path.join(Projects.outputDirectory(&project), "requests")
      if let Result.Failure { error } = move run Effect.result(
        RequestCapture.collect(&mut sets, &directory, ".pending-plan.json"),
      ) {
        let _reset = run ProcessImage.setVariable(b"SILK_PLAN_PENDING", b"0")
        run RequestCapture.restore(previous.asSlice())
        fail move error
      }
    }
  }
  if planning {
    if !run ProcessImage.setVariable(b"SILK_PLAN_PENDING", b"0") {
      run RequestCapture.restore(previous.asSlice())
      return 2
    }
  }
  if status == 0 {
    if let Result.Failure { error } = move run Effect.result(
      RequestCapture.publishSets(move sets, "plan.json"),
    ) {
      run RequestCapture.restore(previous.asSlice())
      fail move error
    }
  } else if planning {
    run RequestCapture.restore(previous.asSlice())
  }
  return run finishTestSelection(status, &tests)
}

// The options of one package's task run: `options`, for the manifest of `project`.
effect fn taskOptions(project: &Project, options: &ProjectOptions) -> ProjectOptions
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut selected = ProjectCommands.options()
  selected.manifestPath = Option<Bytes>.some(
    run Bytes.copy(Path.rawBytes(Projects.manifest(project))),
  )
  selected.standardLibrary = run copyOption(&options.standardLibrary)
  selected.clang = run copyOption(&options.clang)
  selected.backend = run copyOption(&options.backend)
  selected.progress = run copyOption(&options.progress)
  selected.quiet = options.quiet
  selected.timings = options.timings
  selected.ignoreWarnings = options.ignoreWarnings
  return move selected
}

// The package `options` select when it has a tasks program, for the help of `silk task`: none
// outside a package, for a workspace selection, or without src/tasks.silk.
effect fn tasksPackage(working: &Path, options: &ProjectOptions) -> Option<Project>
  ! ApplicationError | FileError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut Allocator {
  let found = match move run Effect.result(selected(working, options)) {
    Result<
      Option<Selection>,
      ApplicationError | ProjectError | FileError | OutOfMemoryError | WriterError
    >.Success {
      value
    } => move value
    Result<
      Option<Selection>,
      ApplicationError | ProjectError | FileError | OutOfMemoryError | WriterError
    >.Failure {
      error
    } => match move error {
      ProjectError problem => {
        drop problem
        return Option<Project>.none()
      }
      ApplicationError application => {
        fail move application
      }
      FileError file => {
        fail move file
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      WriterError written => {
        fail move written
      }
    }
  }
  let mut selection = match move found {
    Option<Selection>.Some { value } => move value
    Option<Selection>.None => {
      return Option<Project>.none()
    }
  }
  if selection.members || selection.projects.length() != 1 {
    return Option<Project>.none()
  }
  let project = selection.projects.remove(0)
  let source = run Path.join(Projects.sourceRoot(&project), "tasks.silk")
  if !run FileSystem.exists(&source) {
    return Option<Project>.none()
  }
  return Option<Project>.some(move project)
}

// Writes the help of `silk task`, then the package's tasks with their options, which its tasks
// program writes for `--help`. Outside a package, or in one with no tasks program, only the
// command's own help is written.
effect fn taskHelp(working: &Path, options: &ProjectOptions) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let mut stdout = StdoutWriter.make()
  drop run writeCommandHelp(b"task", false) |> Effect.provideMut<Writer>(&mut stdout)
  let project = match move run tasksPackage(working, options) {
    Option<Project>.Some { value } => move value
    Option<Project>.None => {
      return 0
    }
  }
  run Writer.writeAll(b"\n") |> Effect.provideMut<Writer>(&mut stdout)
  let chosen = run taskOptions(&project, options)
  let mut tests = TestSelection { multiplePackages: false, filtered: false, matched: false }
  let mut arguments = List<Bytes>.make()
  run arguments.append(run Bytes.copy(b"--help"))
  return run taskForProject(working, &project, &chosen, arguments.asSlice(), false, &mut tests)
}

// Writes the help of `silk task` as one JSON object whose `commands` are the package's tasks, from
// its tasks program's `--help=json`; empty outside a package or without a tasks program.
effect fn taskHelpJson(working: &Path, options: &ProjectOptions) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let mut counter = Output.Counter { length: usize.ZERO }
  drop run ProjectCommands.writeHelp(b"task", true) |> Effect.provideMut<Writer>(&mut counter)
  let mut own = run Output.make(counter.length)
  drop run ProjectCommands.writeHelp(b"task", true) |> Effect.provideMut<Writer>(&mut own)

  // The command's own object ends `"commands":[]}` and a line break; the tasks go in that list.
  let text = Bytes.asSlice(&own.bytes)
  let mut stdout = StdoutWriter.make()
  run Writer.writeAll(Slice.view<u8>(text, usize.ZERO, own.length - usize.add(0, 3)))
    |> Effect.provideMut<Writer>(&mut stdout)
  if let Option<Project>.Some { value: project } = move run tasksPackage(working, options) {
    let chosen = run taskOptions(&project, options)
    let program = match move run tasksProgram(working, &project, &chosen) {
      Option<Path>.Some { value } => move value
      Option<Path>.None => {
        return 2
      }
    }
    let mut request = run ChildProcess.requestWithin(&program, Projects.directory(&project))
    run ChildProcess.addArgument(&mut request, "--help=json")
    let outcome = run ChildProcess.submit(&request)
    run writeError(ChildProcess.errorBytes(&outcome))
    let mut answered = false
    if let Option<i32>.Some { value } = move ChildProcess.exitCode(&outcome) {
      answered = value == 0
    }
    if !answered {
      run writeError(b"silk: the tasks program could not write its help\n")
      return 2
    }
    match tasksList(ChildProcess.outputBytes(&outcome)) {
      Option<&[u8]>.Some { value } => {
        run Writer.writeAll(value) |> Effect.provideMut<Writer>(&mut stdout)
      }
      Option<&[u8]>.None => {
        run writeError(b"silk: the tasks program wrote help that is not a command object\n")
        return 2
      }
    }
  }
  run Writer.writeAll(b"]}\n") |> Effect.provideMut<Writer>(&mut stdout)
  return 0
}

// The items of the `commands` list of `help`, a tasks program's `--help=json` object, without the
// brackets: the text between the first `"commands":[` and the `]}` that ends the object.
fn tasksList(help: &[u8]) -> Option<&[u8]> {
  let key = b"\"commands\":["
  let mut end = help.length
  while end > usize.ZERO && (help[end - usize.ONE] == 10 || help[end - usize.ONE] == 13) {
    end = end - usize.ONE
  }
  if end < usize.add(0, 2) || help[end - usize.ONE] != 125 || help[end - usize.add(0, 2)] != 93 {
    return Option<&[u8]>.none()
  }
  let mut at = usize.ZERO
  while at + key.length <= end {
    if same(Slice.view<u8>(help, at, key.length), key) {
      let from = at + key.length
      if from > end - usize.add(0, 2) {
        return Option<&[u8]>.none()
      }
      return Option<&[u8]>.some(Slice.view<u8>(help, from, end - usize.add(0, 2) - from))
    }
    at = at + usize.ONE
  }
  return Option<&[u8]>.none()
}

effect fn taskForProject(
  working: &Path,
  project: &Project,
  options: &ProjectOptions,
  arguments: &[Bytes],
  builtin: bool,
  tests: &mut TestSelection,
) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  // Without a tasks program every reserved command is the built-in. The language server sets
  // SILK_PLAN_BUILTIN=1 when it found no `Plan` variant, so its plan never starts project code.
  if builtin {
    let source = run Path.join(Projects.sourceRoot(project), "tasks.silk")
    if !run FileSystem.exists(&source) {
      return run taskFallback(working, options, arguments, &mut tests.*)
    }
    if same(arguments[0].asSlice(), b"plan") {
      if let Option<Bytes>.Some { value } = move run HostInput.variableNamed("SILK_PLAN_BUILTIN") {
        if same(value.asSlice(), b"1") {
          return run taskFallback(working, options, arguments, &mut tests.*)
        }
      }
    }
  }
  let program = match move run tasksProgram(working, project, options) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return 2
    }
  }
  if !run tasksEnvironment(working, project, options) {
    return 2
  }

  // `Task.main` creates this file instead of running anything when the tasks have no variant for a
  // reserved command, and the built-in takes over.
  let mut marker = run Bytes.copy(Path.rawBytes(&program))
  run marker.append(b".builtin")
  let handBack = run Path.fromBytes(marker.asSlice())
  if run FileSystem.exists(&handBack) {
    run FileSystem.removeFile(&handBack)
  }
  let offered = if builtin {
    marker.asSlice()
  } else {
    b""
  }
  if !run ProcessImage.setVariable(b"SILK_TASK_BUILTIN", offered) {
    run writeError(b"silk: cannot set the tasks program's environment\n")
    return 2
  }
  let status = match move run TaskRun.wait(&program, arguments, Projects.directory(project)) {
    Option<i32>.Some { value } => value
    Option<i32>.None => {
      run writeError(b"silk: cannot run the tasks program\n")
      return 2
    }
  }
  if builtin && status == 0 && run FileSystem.exists(&handBack) {
    run FileSystem.removeFile(&handBack)
    drop run ProcessImage.setVariable(b"SILK_TASK_BUILTIN", b"")
    return run taskFallback(working, options, arguments, &mut tests.*)
  }

  // A custom Test command owns its selection and reports failure through its exit status.
  if same(arguments[0].asSlice(), b"test") {
    tests.matched = true
  }
  return status
}

// Builds the project's tasks program for this machine with the standard library, Clang and progress
// display `given` selects, and answers the program's path; none after reporting why it cannot.
effect fn tasksProgram(working: &Path, project: &Project, given: &ProjectOptions) -> Option<Path>
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  let mut options = ProjectCommands.options()
  options.standardLibrary = run copyOption(&given.standardLibrary)
  options.clang = run copyOption(&given.clang)
  options.backend = run copyOption(&given.backend)
  options.progress = run copyOption(&given.progress)
  options.quiet = given.quiet
  options.ignoreWarnings = given.ignoreWarnings
  let mut plans = match move run projectPlans(&options) {
    Option<List<ProjectPlan>>.Some { value } => move value
    Option<List<ProjectPlan>>.None => {
      return Option<Path>.none()
    }
  }
  let mut plan = List<ProjectPlan>.remove(&mut plans, usize.ZERO)
  plan.input.artifact = Option<Bytes>.some(run Bytes.copy(b"executable"))
  plan.entry = Option<Path>.some(run Path.join(Projects.sourceRoot(project), "tasks.silk"))
  plan.task = true
  let entry = ProjectPlans.entry(&plan, project)
  if !run FileSystem.exists(entry) {
    run writeError(b"silk: no tasks: ")
    run writeError(Path.rawBytes(entry))
    run writeError(b" does not exist; write the tasks there\n")
    return Option<Path>.none()
  }
  let standardLibrary = run standardLibraryFor(working, &options.standardLibrary)
  let clang = run clangFor(working, &options.clang)

  // The build reports on standard error as `silk run` does, so standard output is the task's own.
  let settings = run progressSettings(&options, usize.ONE)
  let built = run buildProjectTarget(
    project,
    move plan,
    &standardLibrary,
    &clang,
    true,
    false,
    &settings,
    &run CacheStamp.compiler(),
    options.ignoreWarnings,
    true,
    run versionPolicy(given.ignoreSilkVersion),
  )
  if built.status != 0 {
    return Option<Path>.none()
  }
  return Option<Path>.some(move built.path)
}

// Sets what the tasks program reads in its environment, for itself and every program it starts:
// `SILK_PROJECT_ROOT`, the package directory; `SILK_INVOCATION_DIRECTORY`, where the command was
// typed; and `SILK_COMPILER`, this compiler.
effect fn tasksEnvironment(working: &Path, project: &Project, options: &ProjectOptions) -> bool
  ! ApplicationError | HostInputError | WriterError | OutOfMemoryError
  ? &mut FileSystem | &mut HostInput | &mut Allocator {
  let invoked = match move run HostInput.argument(usize.ZERO) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => Bytes.make()
  }
  let searchPath = run HostInput.variableNamed("PATH")
  let compiler = match &searchPath {
    Option<Bytes>.Some { value } => run InstalledCompiler.executable(
      working,
      Bytes.asSlice(&invoked),
      Option<&[u8]>.some(Bytes.asSlice(&value)),
    )
    Option<Bytes>.None => run InstalledCompiler.executable(
      working,
      Bytes.asSlice(&invoked),
      Option<&[u8]>.none(),
    )
  }
  let mut prepared = run ProcessImage.setVariable(
    b"SILK_PROJECT_ROOT",
    Path.rawBytes(Projects.directory(project)),
  )
  prepared = prepared
    && run ProcessImage.setVariable(b"SILK_INVOCATION_DIRECTORY", Path.rawBytes(working))
  if let Option<Bytes>.Some { value } = &compiler {
    prepared = prepared && run ProcessImage.setVariable(b"SILK_COMPILER", Bytes.asSlice(&value))
  }
  if let Option<Path>.Some { value } = move run standardLibraryFor(
    working,
    &options.standardLibrary,
  ) {
    prepared = prepared && run ProcessImage.setVariable(b"SILK_STDLIB", Path.rawBytes(&value))
  }
  if let Option<Bytes>.Some { value } = move run clangFor(working, &options.clang) {
    prepared = prepared && run ProcessImage.setVariable(b"SILK_CLANG", value.asSlice())
  }

  // The compiler's own options, for the compilations the tasks program's graph runs.
  if let Option<Bytes>.Some { value } = &options.backend {
    prepared = prepared && run ProcessImage.setVariable(b"SILK_BACKEND", value.asSlice())
  }
  if let Option<Bytes>.Some { value } = &options.progress {
    prepared = prepared && run ProcessImage.setVariable(b"SILK_PROGRESS", value.asSlice())
  }
  if options.quiet {
    prepared = prepared && run ProcessImage.setVariable(b"SILK_QUIET", b"1")
  }
  if options.timings {
    prepared = prepared && run ProcessImage.setVariable(b"SILK_TIMINGS", b"1")
  }
  if options.ignoreWarnings {
    prepared = prepared && run ProcessImage.setVariable(b"SILK_IGNORE_WARNINGS", b"1")
  }
  if !prepared {
    run writeError(b"silk: cannot set the tasks program's environment\n")
  }
  return prepared
}

// Builds and launches the selected executable, preserving its exit status.
// `noting` names the overrides of silk.local.toml first; `silk task` already has when it
// falls back to this command.
effect fn runProject(working: &Path, command: RunCommand, noting: bool) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  let RunCommand { options, arguments, coredump, debugger } = move command
  let mut selection = match move run selectProjects(working, &options) {
    Option<Selection>.Some { value } => move value
    Option<Selection>.None => {
      return 2
    }
  }
  if noting {
    run noteOverrides(List<Project>.asSlice(&selection.projects))
  }

  // Without `--package`, a workspace's libraries are passed over: it has one program to run when
  // exactly one selected member is an executable.
  if selection.members && List<Bytes>.length(&options.packages) == usize.ZERO {
    let mut runnable = List<Project>.make()
    while List<Project>.length(&selection.projects) > usize.ZERO {
      let candidate = List<Project>.remove(&mut selection.projects, usize.ZERO)
      if Projects.runnable(&candidate) {
        run List<Project>.append(&mut runnable, move candidate)
      }
    }
    selection.projects = move runnable
  }
  if List<Project>.length(&selection.projects) != usize.ONE {
    if Option<Bytes>.isSome(&debugger) {
      run writeError(
        b"silk: `debug` runs one package; pass --package <name> to choose a workspace member\n",
      )
    } else {
      run writeError(
        b"silk: `run` runs one package; pass --package <name> to choose a workspace member\n",
      )
    }
    return 2
  }
  let project = List<Project>.remove(&mut selection.projects, usize.ZERO)
  let mut plans = match move run projectPlans(&options) {
    Option<List<ProjectPlan>>.Some { value } => move value
    Option<List<ProjectPlan>>.None => {
      return 2
    }
  }
  let plan = List<ProjectPlan>.remove(&mut plans, usize.ZERO)

  // The profile chooses the artifact, so a library's profile can build a program to run.
  let form = ProjectPlans.form(&plan, &project)
  if form != Form.Executable {
    run writeError(b"Cannot run ")
    run writeError(Projects.formSpelling(form))
    run writeError(b" artifact\n")
    return 2
  }
  let planned = match &plan.input.target {
    Option<Bytes>.Some { value } => Target.resolve(Bytes.asSlice(&value))
    Option<Bytes>.None => Option<Target>.none()
  }
  let target = match move planned {
    Option<Target>.Some { value } => value
    Option<Target>.None => run invalidBuildProfile()
  }
  let wasi = same(Target.operatingSystem(&target), b"wasi")
  if !wasi && Option<Bytes>.isSome(&coredump) {
    run writeError(
      b"silk: `--coredump` needs a WASI target; a native program dumps core as the system configures\n",
    )
    return 2
  }

  // Wasmtime separates its `-D` options with commas, so the path cannot hold one.
  if let Option<Bytes>.Some { value: path } = &coredump {
    let bytes = Bytes.asSlice(&path)
    let mut at = usize.ZERO
    while at < bytes.length && bytes[at] != 44 {
      at = at + usize.ONE
    }
    if at < bytes.length {
      run writeError(b"silk: the `--coredump` path cannot contain a comma\n")
      return 2
    }
  }
  if Target.id(&target) != Target.id(&hostTarget()) && !wasi {
    run writeError(b"Cannot run target ")
    run writeError(Target.name(&target))
    run writeError(b" on host ")
    run writeError(Target.name(&hostTarget()))
    run writeError(b"\n")
    return 2
  }
  let standardLibrary = run standardLibraryFor(working, &options.standardLibrary)
  let clang = run clangFor(working, &options.clang)

  // The build reports its progress on standard error as `silk build` does, its `Finished` or
  // `Failed` line included, so standard output carries only the program's own output.
  let settings = run progressSettings(&options, usize.ONE)
  let built = run buildProjectTarget(
    &project,
    move plan,
    &standardLibrary,
    &clang,
    true,
    false,
    &settings,
    &run CacheStamp.compiler(),
    options.ignoreWarnings,
    true,
    run versionPolicy(options.ignoreSilkVersion),
  )
  if built.status != 0 {
    return built.status
  }
  if wasi {
    return run WasiTools.replace(&built.path, List<Bytes>.asSlice(&arguments), &coredump, &debugger)
  }
  if Option<Bytes>.isSome(&debugger) {
    return run debugNative(&built.path, List<Bytes>.asSlice(&arguments))
  }
  let failure = run ProcessImage.replace(
    &built.path,
    List<Bytes>.asSlice(&arguments),
    Option<&Path>.none(),
  )
  drop failure
  run writeError(b"Cannot run compiled program ")
  run writeError(Path.rawBytes(&built.path))
  run writeError(b"\n")
  return 2
}

// Replaces the compiler with LLDB on the built program, its arguments passed after `--`. LLDB is
// `SILK_LLDB`, else `lldb` on PATH. A `string` is a pointer and a length, and LLDB would show the
// pointer as a C string running past the length, so a Python summary shows its bytes instead.
effect fn debugNative(program: &Path, arguments: &[Bytes]) -> i32
  ! FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut FileSystem | &mut Allocator {
  let debugger = match move run WasiTools.tool("SILK_LLDB", b"lldb") {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      run writeError(b"silk: `debug` needs lldb on PATH or SILK_LLDB\n")
      return 2
    }
  }
  let mut command = List<Bytes>.make()
  run List<Bytes>.append(&mut command, run Bytes.copy(b"-o"))
  run List<Bytes>.append(&mut command, run Bytes.copy(stringSummary()))
  run List<Bytes>.append(&mut command, run Bytes.copy(b"-o"))
  run List<Bytes>.append(
    &mut command,
    run Bytes.copy(b"type summary add -x '^string(<.+>)?$' -F silk_string"),
  )
  run List<Bytes>.append(&mut command, run Bytes.copy(b"--"))
  run List<Bytes>.append(&mut command, run NativeToolchain.pathBytes(program))
  let mut at = usize.ZERO
  while at < arguments.length {
    run List<Bytes>.append(&mut command, run Bytes.copy(Bytes.asSlice(&arguments[at])))
    at = at + usize.ONE
  }
  let failure = run ProcessImage.replace(
    &debugger,
    List<Bytes>.asSlice(&command),
    Option<&Path>.none(),
  )
  drop failure
  run writeError(b"silk: cannot start lldb\n")
  return 2
}

// The LLDB command defining `silk_string`, which shows up to 1024 bytes of a `string` as a quoted
// UTF-8 string, `...` after it when there are more.
fn stringSummary() -> &'static [u8] {
  return b"script def silk_string(value, internal): length = value.GetChildMemberWithName('length').GetValueAsUnsigned(); error = lldb.SBError(); bytes = value.GetProcess().ReadMemory(value.GetChildMemberWithName('pointer').GetValueAsUnsigned(), min(length, 1024), error) if length else b''; return '<unreadable>' if length and not error.Success() else __import__('json').dumps(bytes.decode('utf-8', 'replace'), ensure_ascii=False) + ('...' if length > 1024 else '')"
}

// Selects the source file `written` names, relative to the project directory, for a test run:
// its project-relative path, or `None` after reporting why it cannot be selected as the
// TypeScript `SourceEntry.select` words it.
effect fn testSource(project: &Project, written: &[u8]) -> Option<Bytes>
  ! ApplicationError | OutOfMemoryError | WriterError
  ? &mut Allocator {
  let path = run pathArgument(Projects.directory(project), written)
  return match move run Projects.selectSource(project, &path) {
    SourceSelection.Module { relative } => Option<Bytes>.some(move relative)
    SourceSelection.Outside { sourceRoot } => {
      run writeError(b"Source entry ")
      run writeError(Path.rawBytes(&path))
      run writeError(b" is outside source root ")
      run writeError(Path.rawBytes(&sourceRoot))
      run writeError(b"\n")
      return Option<Bytes>.none()
    }
    SourceSelection.NotModule => {
      run writeError(b"Source entry ")
      run writeError(Path.rawBytes(&path))
      run writeError(b" must be a canonical relative path ending in .silk\n")
      return Option<Bytes>.none()
    }
  }
}

// Filter matching is aggregated across the entire task selection, including built-in member tests.
struct TestSelection {
  multiplePackages: bool,
  filtered: bool,
  matched: bool,
}

// Builds and runs the selected packages' test runners. File selections require one package;
// a name filter may match tests in any member of the encompassing task selection.
// `noting` names the overrides of silk.local.toml first; `silk task` already has when it
// falls back to this command.
effect fn testProject(
  working: &Path,
  command: TestCommand,
  tests: &mut TestSelection,
  noting: bool,
) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let TestCommand { options, root, file, filter, timeout, noCache } = move command
  let selection = match move run selectProjects(working, &options) {
    Option<Selection>.Some { value } => move value
    Option<Selection>.None => {
      return 2
    }
  }
  if noting {
    run noteOverrides(List<Project>.asSlice(&selection.projects))
  }
  let projects = List<Project>.asSlice(&selection.projects)
  let narrowed = hasFilter(&root) || hasFilter(&file)
  if narrowed && (projects.length != usize.ONE || tests.multiplePackages) {
    run writeError(
      b"silk: --root and --file name files of one package; pass --package <name> to choose a workspace member\n",
    )
    return 2
  }
  let mut status = 0
  let mut succeeded = usize.ZERO
  tests.filtered = tests.filtered || hasFilter(&file) || hasFilter(&filter)
  let mut at = usize.ZERO
  while at < projects.length {
    if selection.members {
      run writePackageHeader(&projects[at])
    }
    let tested = run memberStatus(
      run Effect.result(
        testOne(
          working,
          &projects[at],
          &options,
          &root,
          &file,
          &filter,
          &timeout,
          noCache,
          &mut tests.matched,
        ),
      ),
    )
    if tested == 0 {
      succeeded = succeeded + usize.ONE
    }
    status = worse(status, tested)
    at = at + usize.ONE
  }
  if selection.members {
    run writeWorkspaceSummary(succeeded, projects.length)
  }

  return status
}

// A selection that matches nothing verified nothing, so it fails instead of passing.
effect fn finishTestSelection(status: i32, tests: &TestSelection) -> i32
  ! WriterError {
  if status == 0 && tests.filtered && !tests.matched {
    run reportUnmatched()
    return 1
  }
  return status
}

effect fn reportUnmatched() -> ()
  ! WriterError {
  return run writeError(b"silk test: no tests matched the --file or --filter selection\n")
}

effect fn copyOption(value: &Option<Bytes>) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value.* {
    Option<Bytes>.Some { value: present } => Option<Bytes>.some(
      run Bytes.copy(Bytes.asSlice(&present)),
    )
    Option<Bytes>.None => Option<Bytes>.none()
  }
}

// Builds one project's test runner and runs its selected tests, as `testProject` does for each
// selected project. `matched` becomes true when the run selected a test.
effect fn testOne(
  working: &Path,
  project: &Project,
  options: &ProjectOptions,
  root: &Option<Bytes>,
  file: &Option<Bytes>,
  filter: &Option<Bytes>,
  timeout: &Option<Bytes>,
  noCache: bool,
  matched: &mut bool,
) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let mut rootEntry = Option<Path>.none()
  if let Option<Bytes>.Some { value } = &root.* {
    if let Option<Bytes>.None = move run testSource(project, Bytes.asSlice(&value)) {
      return 2
    }
    rootEntry = Option<Path>.some(
      run pathArgument(Projects.directory(project), Bytes.asSlice(&value)),
    )
  }
  let mut selectedFile = Option<Bytes>.none()
  if let Option<Bytes>.Some { value } = &file.* {
    selectedFile = match move run testSource(project, Bytes.asSlice(&value)) {
      Option<Bytes>.Some { value: relative } => Option<Bytes>.some(move relative)
      Option<Bytes>.None => {
        return 2
      }
    }
  }
  let mut plans = match move run projectPlans(options) {
    Option<List<ProjectPlan>>.Some { value } => move value
    Option<List<ProjectPlan>>.None => {
      return 2
    }
  }
  let plan = List<ProjectPlan>.remove(&mut plans, usize.ZERO)

  // Tests are found from `--root`, else the profile's root module, else the package's.
  let discovery = match move rootEntry {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Path.fromBytes(Path.rawBytes(ProjectPlans.entry(&plan, project)))
  }
  let ProjectPlan {
    input: planned,
    bindings,
    task: _,
    maxMemory: unlimited,
    stackSize: _,
    entry: _,
    unsandboxedTools
  } = move plan
  drop unlimited
  let mut input = move planned
  input.artifact = Option<Bytes>.some(run Bytes.copy(Projects.profileArtifact(Form.Executable)))
  let profile = run InitialProfile.freeze(&input)
  let target = Target.forId(Target.id(InitialProfile.target(&profile)))
  if Target.id(&target) != Target.id(&hostTarget())
    && !same(Target.operatingSystem(&target), b"wasi") {
    run writeError(b"Cannot run target ")
    run writeError(Target.name(&target))
    run writeError(b" on host ")
    run writeError(Target.name(&hostTarget()))
    run writeError(b"\n")
    return 2
  }
  let optimization = match move InitialProfile.text(&profile, b"optimization") {
    Option<&[u8]>.Some { value } => value
    Option<&[u8]>.None => run invalidBuildProfile()
  }

  let profileName = Projects.mode(optimization)
  let output = run Projects.testExecutable(project, Target.name(&target), profileName)
  if let Option<Path>.Some { value: directory } = move run Path.parent(&output) {
    run FileSystem.createDirectoriesRecursively(&directory)
  }
  let standardLibrary = run standardLibraryFor(working, &options.standardLibrary)
  let clang = run clangFor(working, &options.clang)

  // The runner keeps a semantic cache of its own beside the package's: a program's build prunes
  // the definitions its own units do not name, so one directory would serve only the last of the two.
  let mut cacheName = run Bytes.copy(Projects.name(project))
  run Bytes.append(&mut cacheName, b"@tests")
  let cacheHome = run SemanticCache.directory(
    Projects.outputDirectory(project),
    Bytes.asSlice(&cacheName),
  )
  let settings = run progressSettings(options, usize.ONE)
  let mut detail = run Bytes.copy(Target.name(&target))
  run Bytes.append(&mut detail, b", ")
  run Bytes.append(&mut detail, profileName)
  let mut subject = run Bytes.copy(Projects.name(project))
  run Bytes.append(&mut subject, b" tests")
  let progress = run Progress.start(
    &settings,
    b"Compiling",
    Bytes.asSlice(&subject),
    Bytes.asSlice(&detail),
  )
  return run test(
    &discovery,
    Option<&Path>.some(Projects.manifest(project)),
    &output,
    Projects.directory(project),
    &SupplyRequest.Automatic,
    move standardLibrary,
    move profile,
    move bindings,
    run copyOption(filter),
    move selectedFile,
    timeout,
    &clang,
    noCache,
    &mut matched.*,
    options.ignoreWarnings,
    move cacheHome,
    move progress,
    unsandboxedTools,
    run versionPolicy(options.ignoreSilkVersion),
  )
}

// Writes one refused initialization as the TypeScript CLI words it.
effect fn reportInitialization(problem: &InitializationError) -> ()
  ! WriterError {
  return match &problem.* {
    InitializationError.InvalidPackageName { name, derived } => {
      if derived {
        run writeError(b"Cannot derive a portable package name from ")
        run writeError(Bytes.asSlice(&name))
        run writeError(b"; pass --name\n")
      } else {
        run writeError(b"Package name ")
        run writeError(Bytes.asSlice(&name))
        run writeError(
          b" must start with a lowercase letter and contain only lowercase letters, digits, or hyphens\n",
        )
      }
    }
    InitializationError.ExistingFile { path } => {
      run writeError(b"Refusing to overwrite existing project file ")
      run writeError(Path.rawBytes(&path))
      run writeError(b"\n")
    }
    InitializationError.SourceNotDirectory { path } => {
      run writeError(b"Managed source path ")
      run writeError(Path.rawBytes(&path))
      run writeError(b" is not a directory\n")
    }
    InitializationError.AncestorNotDirectory { path } => {
      run writeError(b"Initialization path ancestor ")
      run writeError(Path.rawBytes(&path))
      run writeError(b" is not a directory\n")
    }
    InitializationError.Failed { path } => {
      run writeError(b"Cannot initialize Silk project at ")
      run writeError(Path.rawBytes(&path))
      run writeError(b"\n")
    }
  }
}

// Lists the package in `directory` as a member of the nearest workspace above it, unless that
// workspace already lists it, and checks the edited workspace before keeping the edit. Prints
// `Added <member> to the <name> workspace`, colored when `color`.
effect fn joinWorkspace(directory: &Path, color: bool) -> ()
  ! ProjectError | ManifestEditRefused | FileError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut Allocator | &mut Writer {
  let parent = match move run Path.parent(directory) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return ()
    }
  }
  let manifest = match move run Projects.enclosingWorkspace(&parent) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return ()
    }
  }
  if run Projects.listsMember(&manifest, directory) {
    return ()
  }
  let workspaceDirectory = match move run Path.parent(&manifest) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return ()
    }
  }
  let entry = run CommandPath.relative(&workspaceDirectory, directory)
  let previous = run FileSystem.readFile(&manifest)
  let edited = run ManifestEdits.addMember(Bytes.asSlice(&previous), Bytes.asSlice(&entry))
  run FileSystem.writeFile(&manifest, Bytes.asSlice(&edited))
  let checked = run Effect.result(Projects.workspace(&manifest))
  if let Result<Option<Workspace>, ProjectError | FileError | OutOfMemoryError>.Failure {
    error
  } = move checked {
    run FileSystem.writeFile(&manifest, Bytes.asSlice(&previous))
    fail move error
  }
  let mut line = run Bytes.copy(b"  ")
  run painted(&mut line, color, b"\x1b[1;32m", b"Added")
  run Bytes.append(&mut line, b" ")
  run painted(&mut line, color, b"\x1b[1m", Bytes.asSlice(&entry))
  run Bytes.append(&mut line, b" to the ")
  if let Option<string>.Some { value } = Path.name(&workspaceDirectory) {
    run Bytes.append(&mut line, String.utf8Bytes(value))
    run Bytes.append(&mut line, b" ")
  }
  run Bytes.append(&mut line, b"workspace\n")
  run Writer.writeAll(Bytes.asSlice(&line))
}

// Lists the package created in `directory` as a member of the nearest workspace above it and
// reports what happened, colored when `color`: status 0, or 2 when the workspace was left
// unchanged.
effect fn joinedWorkspace(directory: &Path, color: bool) -> i32
  ! FileError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut Allocator | &mut Writer {
  let joined = run Effect.result(joinWorkspace(directory, color))
  return match move joined {
    Result<
      (),
      ProjectError | ManifestEditRefused | FileError | OutOfMemoryError | WriterError
    >.Success {
      ..
    } => 0
    Result<
      (),
      ProjectError | ManifestEditRefused | FileError | OutOfMemoryError | WriterError
    >.Failure {
      error
    } => match move error {
      ProjectError problem => {
        run writeError(b"silk: the project was created, but its workspace was left unchanged:\n")
        run reportProject(&problem)
        return 2
      }
      ManifestEditRefused refused => {
        run writeError(
          b"silk: the project was created, but it could not be added to its workspace: ",
        )
        run writeError(Bytes.asSlice(&refused.detail))
        run writeError(b"\n")
        return 2
      }
      FileError file => {
        fail move file
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      WriterError written => {
        fail move written
      }
    }
  }
}

// Creates a project in the selected directory, recording this compiler's release as its
// `silk-version`, and reports it: status 0, or 2 when refused. A package created inside a
// workspace becomes one of its members. A package without `--template` is the official `default`
// template; `--template minimal`, `--lib` and `--workspace` are written without fetching anything.
effect fn initProject(working: &Path, command: InitCommand) -> i32
  ! ApplicationError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Writer {
  let InitCommand { path, name, kind, template, list, arguments, unsandboxed } = move command
  if list {
    return run listTemplates(&template)
  }
  let directory = match move path {
    Option<Bytes>.Some { value } => run pathArgument(working, Bytes.asSlice(&value))
    Option<Bytes>.None => run Path.fromBytes(Path.rawBytes(working))
  }

  // A package comes from the official `default` template unless the command names another one;
  // `minimal`, like `--lib` and `--workspace`, is written by the compiler itself, offline.
  let mut chosen = move template
  if kind == InitKind.Executable {
    if let Option<Bytes>.None = &chosen {
      chosen = Option<Bytes>.some(run Bytes.copy(Templates.defaultTemplate()))
    }
  }
  if let Option<Bytes>.Some { value: written } = move chosen {
    if !same(Bytes.asSlice(&written), Templates.minimalTemplate()) {
      return run initTemplate(
        working,
        &directory,
        move name,
        Bytes.asSlice(&written),
        List<Bytes>.asSlice(&arguments),
        unsandboxed,
      )
    }
  }
  let initialized = run Effect.result(
    ProjectInitializers.create(
      &directory,
      move name,
      kind,
      ManifestFields.withoutMetadata(ReleaseVersion.value()),
    ),
  )
  return match move initialized {
    Result<Initialized, InitializationError | OutOfMemoryError>.Success { value } => {
      let color = run initColor()
      let mut line = run Bytes.copy(b"  ")
      run painted(&mut line, color, b"\x1b[1;32m", b"Created")
      if kind == InitKind.Workspace {
        // `value.name` is the starter member's, so the workspace is named by its directory.
        let place = run createdPlace(working, &value.directory, b"")
        run Bytes.append(&mut line, b" workspace ")
        run painted(&mut line, color, b"\x1b[1m", Bytes.asSlice(&place))
        run Bytes.append(&mut line, b" with package ")
        run painted(&mut line, color, b"\x1b[1m", Bytes.asSlice(&value.name))
        run Bytes.append(&mut line, b"\n")
        run Writer.writeAll(Bytes.asSlice(&line))
        let steps = run Templates.defaultNextSteps(false)
        run writeNextSteps(working, &value.directory, List<NextStep>.asSlice(&steps), color)
        return 0
      }
      let place = run createdPlace(working, &value.directory, Bytes.asSlice(&value.name))
      if kind == InitKind.Library {
        run Bytes.append(&mut line, b" library ")
        run painted(&mut line, color, b"\x1b[1m", Bytes.asSlice(&place))
      } else {
        run Bytes.append(&mut line, b" ")
        run painted(&mut line, color, b"\x1b[1m", Bytes.asSlice(&place))
        run Bytes.append(&mut line, b" from the ")
        run Bytes.append(&mut line, Templates.minimalTemplate())
        run Bytes.append(&mut line, b" template")
      }
      run Bytes.append(&mut line, b"\n")
      run Writer.writeAll(Bytes.asSlice(&line))
      let status = run joinedWorkspace(&value.directory, color)
      if status == 0 {
        let steps = run Templates.defaultNextSteps(kind == InitKind.Library)
        run writeNextSteps(working, &value.directory, List<NextStep>.asSlice(&steps), color)
      }
      return status
    }
    Result<Initialized, InitializationError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      InitializationError problem => {
        run reportInitialization(&problem)
        return 2
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// Prints the templates of the directory `written` names, or of the official examples: each one's
// name and description, then how to use one. Status 0, 2 for a malformed template, or 1 when it
// cannot be fetched or names no directory.
effect fn listTemplates(written: &Option<Bytes>) -> i32
  ! FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Writer {
  let mut spec = run Templates.official()
  if let Option<Bytes>.Some { value } = &written.* {
    spec = match move run Effect.result(Templates.parse(Bytes.asSlice(&value))) {
      Result<TemplateSpec, TemplateRefused | OutOfMemoryError>.Success {
        value: parsed
      } => move parsed
      Result<TemplateSpec, TemplateRefused | OutOfMemoryError>.Failure {
        error
      } => match move error {
        TemplateRefused refused => {
          run writeError(Bytes.asSlice(&refused.detail))
          run writeError(b"\n")
          return 2
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
  }
  let store = match move run GitCheckouts.store() {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      run writeError(
        b"silk: templates are fetched below SILK_HOME, or HOME when it is unset, and neither names an absolute directory\n",
      )
      return 2
    }
  }
  let listing = match move run Effect.result(Templates.list(&store, &spec)) {
    Result<TemplateListing, TemplateRefused | HostInputError | OutOfMemoryError>.Success {
      value
    } => move value
    Result<TemplateListing, TemplateRefused | HostInputError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      TemplateRefused refused => {
        run writeError(Bytes.asSlice(&refused.detail))
        run writeError(b"\n")
        return 1
      }
      HostInputError input => {
        fail move input
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let shown = run Templates.spelled(&spec)
  let templates = List<TemplateListed>.asSlice(&listing.templates)
  if templates.length == usize.ZERO {
    run Writer.writeAll(b"No templates in ")
    run Writer.writeAll(Bytes.asSlice(&shown))
    run Writer.writeAll(b": no directory holds a silk.toml\n")
    return 0
  }
  run Writer.writeAll(b"Templates in ")
  run Writer.writeAll(Bytes.asSlice(&shown))
  run Writer.writeAll(b" (")
  run Writer.writeAll(Bytes.asSlice(&listing.commit))
  run Writer.writeAll(b"):\n")
  let mut width = usize.ZERO
  let mut at = usize.ZERO
  while at < templates.length {
    let length = Bytes.length(&templates[at].name)
    if length > width {
      width = length
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < templates.length {
    run Writer.writeAll(b"  ")
    run Writer.writeAll(Bytes.asSlice(&templates[at].name))
    if let Option<Bytes>.Some { value } = &templates[at].description {
      let mut pad = Bytes.length(&templates[at].name)
      while pad < width + usize.add(0, 2) {
        run Writer.writeAll(b" ")
        pad = pad + usize.ONE
      }
      run Writer.writeAll(Bytes.asSlice(&value))
    }
    run Writer.writeAll(b"\n")
    at = at + usize.ONE
  }
  run Writer.writeAll(b"Create a project from one with `silk init <path> --template <name>`\n")
  return 0
}

// Creates a project in `directory` from the template `written` and reports it, with what its
// `[[post-init]]` entries printed: status 0, 2 when the template or the directory is refused, or 1
// when fetching it or one of its entries failed.
effect fn initTemplate(
  working: &Path,
  directory: &Path,
  name: Option<Bytes>,
  written: &[u8],
  arguments: &[Bytes],
  unsandboxed: bool,
) -> i32
  ! FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Writer {
  let spec = match move run Effect.result(Templates.parse(written)) {
    Result<TemplateSpec, TemplateRefused | OutOfMemoryError>.Success { value } => move value
    Result<TemplateSpec, TemplateRefused | OutOfMemoryError>.Failure { error } => match move error {
      TemplateRefused refused => {
        run writeError(Bytes.asSlice(&refused.detail))
        run writeError(b"\n")
        return 2
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let store = match move run GitCheckouts.store() {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      run writeError(
        b"silk: templates are fetched below SILK_HOME, or HOME when it is unset, and neither names an absolute directory\n",
      )
      return 2
    }
  }
  let made = run Effect.result(
    Templates.create(
      &store,
      &spec,
      directory,
      move name,
      ManifestFields.withoutMetadata(ReleaseVersion.value()),
      arguments,
      unsandboxed,
    ),
  )
  let created = match move made {
    Result<
      TemplateCreated,
      InitializationError | TemplateRefused | HostInputError | OutOfMemoryError
    >.Success {
      value
    } => move value
    Result<
      TemplateCreated,
      InitializationError | TemplateRefused | HostInputError | OutOfMemoryError
    >.Failure {
      error
    } => match move error {
      InitializationError problem => {
        run reportInitialization(&problem)
        return 2
      }
      TemplateRefused refused => {
        run writeError(Bytes.asSlice(&refused.detail))
        run writeError(b"\n")
        return 1
      }
      HostInputError input => {
        fail move input
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  run Writer.writeAll(Bytes.asSlice(&created.output))
  run writeError(Bytes.asSlice(&created.errors))
  let color = run initColor()
  let mut line = run Bytes.copy(b"  ")
  run painted(&mut line, color, b"\x1b[1;32m", b"Created")
  let place = match &created.name {
    Option<Bytes>.Some { value } => {
      run Bytes.append(&mut line, b" ")
      run createdPlace(working, &created.directory, Bytes.asSlice(&value))
    }
    Option<Bytes>.None => {
      run Bytes.append(&mut line, b" workspace ")
      run createdPlace(working, &created.directory, b"")
    }
  }
  run painted(&mut line, color, b"\x1b[1m", Bytes.asSlice(&place))
  run Bytes.append(&mut line, b" from the ")
  let label = run Templates.label(&spec)
  run Bytes.append(&mut line, Bytes.asSlice(&label))
  run Bytes.append(&mut line, b" template ")
  // A short commit identifies the template's revision; the full hash is not needed to read it.
  let mut revision = run Bytes.copy(b"(")
  let commit = Bytes.asSlice(&created.commit)
  let mut shown: usize = 7
  if commit.length < shown {
    shown = commit.length
  }
  run Bytes.append(&mut revision, Slice.view<u8>(commit, usize.ZERO, shown))
  run Bytes.append(&mut revision, b")")
  run painted(&mut line, color, b"\x1b[2m", Bytes.asSlice(&revision))
  run Bytes.append(&mut line, b"\n")
  run Writer.writeAll(Bytes.asSlice(&line))
  let mut status = 0
  if let Option<Bytes>.Some { .. } = &created.name {
    status = run joinedWorkspace(&created.directory, color)
  }
  if status == 0 {
    run writeNextSteps(
      working,
      &created.directory,
      List<NextStep>.asSlice(&created.nextSteps),
      color,
    )
  }
  return status
}

// Whether `silk init` colors what it prints: standard output is a terminal that understands escape
// codes, TERM is not `dumb` and NO_COLOR is unset or empty.
effect fn initColor() -> bool
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    if !run WindowsConsole.enableAnsi(1) {
      return false
    }
  } else {
    if !run NativeDescriptor.isTerminal(1) {
      return false
    }
  }
  if let Option<Bytes>.Some { value } = move run HostInput.variableNamed("TERM") {
    if same(Bytes.asSlice(&value), b"dumb") {
      return false
    }
  }
  if let Option<Bytes>.Some { value } = move run HostInput.variableNamed("NO_COLOR") {
    return Bytes.length(&value) == usize.ZERO
  }
  return true
}

// Appends `text` to `line`, in the color the escape `code` opens when `color`.
effect fn painted(line: &mut Bytes, color: bool, code: &[u8], text: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if color {
    run Bytes.append(&mut line.*, code)
  }
  run Bytes.append(&mut line.*, text)
  if color {
    run Bytes.append(&mut line.*, b"\x1b[0m")
  }
  return ()
}

// How `silk init` names the project it created in `directory`: its path relative to the working
// directory, or `name`, or else the directory's own name, when it is the working directory.
effect fn createdPlace(working: &Path, directory: &Path, name: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let place = run CommandPath.relative(working, directory)
  if Bytes.length(&place) > usize.ZERO {
    return move place
  }
  if name.length > usize.ZERO {
    return run Bytes.copy(name)
  }
  return match move Path.name(directory) {
    Option<string>.Some { value } => run Bytes.copy(String.utf8Bytes(value))
    Option<string>.None => run Bytes.copy(Path.rawBytes(directory))
  }
}

// Whether `byte` needs no quoting in a POSIX shell word.
fn shellPlain(byte: u8) -> bool {
  return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57)
    || byte == 45 || byte == 46 || byte == 47 || byte == 95 || byte == 43 || byte == 64
    || byte == 58 || byte == 44
}

// The number of characters in the UTF-8 `text`, for lining up columns.
fn columns(text: &[u8]) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < text.length {
    if text[at] < 128 || text[at] >= 192 {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

// Prints what to run next in the project created at `directory`, under `Next steps:`: `cd` into it,
// unless it is the working directory, then each of `steps`, its description dimmed in a column
// beside it. Colored when `color`; prints nothing when `steps` is empty.
effect fn writeNextSteps(working: &Path, directory: &Path, steps: &[NextStep], color: bool) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Allocator | &mut Writer {
  if steps.length == usize.ZERO {
    return ()
  }
  let mut text = run Bytes.copy(b"\n  ")
  run painted(&mut text, color, b"\x1b[1m", b"Next steps:")
  run Bytes.append(&mut text, b"\n")
  let place = run CommandPath.relative(working, directory)
  let spelled = Bytes.asSlice(&place)
  if spelled.length > usize.ZERO {
    run Bytes.append(&mut text, b"    cd ")
    let mut plain = true
    let mut at = usize.ZERO
    while at < spelled.length {
      if !shellPlain(spelled[at]) {
        plain = false
      }
      at = at + usize.ONE
    }
    if plain {
      run Bytes.append(&mut text, spelled)
    } else {
      // Single quotes keep every byte; a quote itself closes, escapes and reopens them.
      run Bytes.append(&mut text, b"'")
      at = usize.ZERO
      while at < spelled.length {
        if spelled[at] == 39 {
          run Bytes.append(&mut text, b"'\\''")
        } else {
          run Bytes.append(&mut text, Slice.view<u8>(spelled, at, usize.ONE))
        }
        at = at + usize.ONE
      }
      run Bytes.append(&mut text, b"'")
    }
    run Bytes.append(&mut text, b"\n")
  }
  let mut width = usize.ZERO
  let mut step = usize.ZERO
  while step < steps.length {
    if let Option<Bytes>.Some { .. } = &steps[step].description {
      let length = columns(Bytes.asSlice(&steps[step].command))
      if length > width {
        width = length
      }
    }
    step = step + usize.ONE
  }
  step = usize.ZERO
  while step < steps.length {
    run Bytes.append(&mut text, b"    ")
    run Bytes.append(&mut text, Bytes.asSlice(&steps[step].command))
    if let Option<Bytes>.Some { value } = &steps[step].description {
      let mut pad = columns(Bytes.asSlice(&steps[step].command))
      while pad < width + usize.add(0, 3) {
        run Bytes.append(&mut text, b" ")
        pad = pad + usize.ONE
      }
      run painted(&mut text, color, b"\x1b[2m", Bytes.asSlice(&value))
    }
    run Bytes.append(&mut text, b"\n")
    step = step + usize.ONE
  }
  run Writer.writeAll(Bytes.asSlice(&text))
  return ()
}

// The `[package]` table of `document`, or a failure naming `manifest` when it has none.
effect fn packageTable<'a>(manifest: &Path, document: &'a TomlValue) -> &'a TomlValue
  ! ProjectError | FileError | OutOfMemoryError
  ? &mut Allocator {
  return match move Toml.field(document, "package") {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      fail ProjectError.InvalidManifest {
        manifest: run Path.fromBytes(Path.rawBytes(manifest)),
        line: usize.ZERO,
        detail: run Bytes.copy(
          b"dependencies belong to a package, and this manifest has no [package] table",
        ),
      }
    }
  }
}

// Whether the `[dependencies]` table of `document` has an entry named `name`.
fn hasDependency(document: &TomlValue, name: &[u8]) -> bool {
  return match move String.fromUtf8(name) {
    Result<string, InvalidUtf8>.Success { value } => match move Toml.fieldAt(
      Toml.field(document, "dependencies"),
      value,
    ) {
      Option<&TomlValue>.Some { .. } => true
      Option<&TomlValue>.None => false
    }
    Result<string, InvalidUtf8>.Failure { .. } => false
  }
}

// A dependency name derived from a package name: each `-` becomes `_`.
effect fn dependencyName(package: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut name = run Bytes.copy(package)
  let bytes = Bytes.asMutSlice(&mut name)
  let mut at = usize.ZERO
  while at < bytes.length {
    if bytes[at] == 45 {
      bytes[at] = 95
    }
    at = at + usize.ONE
  }
  return move name
}

effect fn refusedDependency(name: &[u8], reason: &[u8]) -> never
  ! InvalidDependency | OutOfMemoryError
  ? &mut Allocator {
  let mut detail = run Bytes.copy(b"dependency `")
  run Bytes.append(&mut detail, name)
  run Bytes.append(&mut detail, b"`: ")
  run Bytes.append(&mut detail, reason)
  fail InvalidDependency { detail: move detail, manifest: Bytes.make(), line: usize.ZERO }
}

// Refuses a dependency `path` whose manifest only defines a workspace, naming its members, since
// a dependency is one package and the workspace's own manifest is not at fault.
effect fn notWorkspace(path: &[u8], document: &TomlValue) -> ()
  ! InvalidDependency | OutOfMemoryError
  ? &mut Allocator {
  if let Option<&TomlValue>.Some { .. } = move Toml.field(document, "package") {
    return ()
  }
  let members = match move Toml.fieldAt(Toml.field(document, "workspace"), "members") {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      return ()
    }
  }
  let mut reason = run Bytes.copy(b"it is a workspace; add one of its members")
  let mut at = usize.ZERO
  while true {
    let member = match move Toml.asString(Toml.item(members, at)) {
      Option<string>.Some { value } => String.utf8Bytes(value)
      Option<string>.None => {
        break
      }
    }
    if at == usize.ZERO {
      run Bytes.append(&mut reason, b": ")
    } else {
      run Bytes.append(&mut reason, b", ")
    }
    run Bytes.append(&mut reason, member)
    at = at + usize.ONE
  }
  if at == usize.ZERO {
    run Bytes.append(&mut reason, b"; it lists none yet")
  }
  run refusedDependency(path, Bytes.asSlice(&reason))
}

// A package as `Packages.load` takes it for the root of a build: its `name@version` identity and
// the directory its modules resolve below.
struct RootPackage {
  identity: Bytes,
  sourceRoot: Path,
}

// The root-package inputs of the package whose manifest is `document`, in `directory`: its
// identity and `[package].source` (driver/ManifestFields).
effect fn rootPackage(directory: &Path, document: &TomlValue) -> RootPackage
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let sourceRoot = run ManifestFields.sourceRoot(directory, document)
  let mut identity = Bytes.make()
  if let Option<&[u8]>.Some { value: owner } = move ManifestFields.packageText(document, "name") {
    run Bytes.append(&mut identity, owner)
  }
  run Bytes.append(&mut identity, b"@")
  run Bytes.append(&mut identity, ManifestFields.version(document))
  return RootPackage { identity: move identity, sourceRoot: move sourceRoot }
}

// Adds the package at `command.path` to the located manifest's `[dependencies]`, by the path
// from the manifest's directory, under `--name` or else its package name with `-` spelled `_`. A
// URL instead names the package's archive: it is downloaded into the archive store and added by
// its URL and SHA-256.
// The edited manifest's dependencies are loaded and checked before it is written.
effect fn addedDependency(working: &Path, command: AddCommand, store: Option<&Path>) -> ()
  ! ApplicationError
    | ProjectError
    | InvalidDependency
    | ManifestEditRefused
    | FileError
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut HostInput | &mut Allocator | &mut Writer {
  let AddCommand { path, sha256: expected, name, manifestPath } = move command
  let manifest = run manifestFor(working, &manifestPath)
  let document = run Projects.parsed(&manifest)
  drop run packageTable(&manifest, &document)
  let directory = match move run Path.parent(&manifest) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Path.root()
  }

  // A URL names a package archive: it is downloaded into the archive store and pinned by its
  // SHA-256, as a build would fetch it.
  let archived = PackageSources.isArchiveUrl(Bytes.asSlice(&path))
  let mut digest = Bytes.make()
  let dependency = if archived {
    let url = Bytes.asSlice(&path)
    let body = match move run Effect.result(NativeArchives.retrieve(url)) {
      Result<Result<Bytes, Bytes>, FileError | HostInputError | OutOfMemoryError>.Success {
        value
      } => match move value {
        Result<Bytes, Bytes>.Success { value: content } => move content
        Result<Bytes, Bytes>.Failure { error } => {
          let mut reason = run Bytes.copy(b"cannot fetch ")
          run Bytes.append(&mut reason, url)
          run Bytes.append(&mut reason, b": ")
          run Bytes.append(&mut reason, Bytes.asSlice(&error))
          run refusedDependency(url, Bytes.asSlice(&reason))
        }
      }
      Result<Result<Bytes, Bytes>, FileError | HostInputError | OutOfMemoryError>.Failure {
        error
      } => match move error {
        FileError failure => {
          fail move failure
        }
        HostInputError unread => {
          drop unread
          run refusedDependency(
            url,
            b"the proxy or certificate settings in the environment cannot be read",
          )
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    digest = run NativeArchives.sha256Hex(Bytes.asSlice(&body))
    if let Option<Bytes>.Some { value: pinned } = &expected {
      if !same(Bytes.asSlice(&pinned), Bytes.asSlice(&digest)) {
        let mut reason = run Bytes.copy(b"the archive has SHA-256 ")
        run Bytes.append(&mut reason, Bytes.asSlice(&digest))
        run Bytes.append(&mut reason, b", not the ")
        run Bytes.append(&mut reason, Bytes.asSlice(&pinned))
        run Bytes.append(&mut reason, b" --sha256 expects")
        run refusedDependency(url, Bytes.asSlice(&reason))
      }
    }
    let checkouts = match &store {
      Option<&Path>.Some { value } => value
      Option<&Path>.None => run refusedDependency(
        url,
        b"there is no archive store to download it into: set SILK_HOME or HOME",
      )
    }
    let extracted = match move run PackageSources.archiveDirectory(
      checkouts,
      Bytes.asSlice(&digest),
    ) {
      Option<Path>.Some { value } => move value
      Option<Path>.None => run refusedDependency(
        url,
        b"there is no archive store to download it into: set SILK_HOME or HOME",
      )
    }

    // The digest names the content, so an archive already in the store is the same one.
    let mut markerText = run Bytes.copy(Path.rawBytes(&extracted))
    run Bytes.append(&mut markerText, b".fetched")
    let marker = run Path.fromBytes(Bytes.asSlice(&markerText))
    let present = run FileSystem.exists(&marker)
    if !present {
      if let Option<Bytes>.Some { value: failure } = move run NativeArchives.store(
        url,
        url,
        Bytes.asSlice(&body),
        &extracted,
        usize.ZERO,
      ) {
        run refusedDependency(url, Bytes.asSlice(&failure))
      }
    }
    run PackageSources.archiveRoot(move extracted)
  } else {
    if let Option<Bytes>.Some { .. } = &expected {
      run refusedDependency(
        Bytes.asSlice(&path),
        b"--sha256 checks an archive URL; a package directory has no archive",
      )
    }
    run pathArgument(working, Bytes.asSlice(&path))
  }
  let dependencyManifest = run Path.join(&dependency, "silk.toml")
  let dependencyDocument = run Projects.parsed(&dependencyManifest)
  run notWorkspace(Bytes.asSlice(&path), &dependencyDocument)
  let dependencyPackage = run packageTable(&dependencyManifest, &dependencyDocument)
  let packageName = match move Toml.asString(Toml.field(dependencyPackage, "name")) {
    Option<string>.Some { value } => String.utf8Bytes(value)
    Option<string>.None => {
      fail ProjectError.InvalidManifest {
        manifest: move dependencyManifest,
        line: usize.ZERO,
        detail: run Bytes.copy(b"missing [package] name"),
      }
    }
  }
  let named = match move name {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => run dependencyName(packageName)
  }
  let dependencyKey = Bytes.asSlice(&named)
  if hasDependency(&document, dependencyKey) {
    return run refusedDependency(
      dependencyKey,
      b"the package already has a dependency of that name",
    )
  }
  let mut value = Bytes.make()
  if archived {
    run Bytes.append(&mut value, b"{ url = ")
    run Bytes.append(&mut value, Bytes.asSlice(&run ManifestEdits.quoted(Bytes.asSlice(&path))))
    run Bytes.append(&mut value, b", sha256 = ")
    run Bytes.append(&mut value, Bytes.asSlice(&run ManifestEdits.quoted(Bytes.asSlice(&digest))))
  } else {
    let relative = run CommandPath.relative(&directory, &dependency)
    if Bytes.length(&relative) == usize.ZERO {
      return run refusedDependency(dependencyKey, b"a package cannot depend on itself")
    }
    run Bytes.append(&mut value, b"{ path = ")
    let quotedPath = run ManifestEdits.quoted(Bytes.asSlice(&relative))
    run Bytes.append(&mut value, Bytes.asSlice(&quotedPath))
  }
  if !same(dependencyKey, packageName) {
    let quotedPackage = run ManifestEdits.quoted(packageName)
    run Bytes.append(&mut value, b", package = ")
    run Bytes.append(&mut value, Bytes.asSlice(&quotedPackage))
  }
  run Bytes.append(&mut value, b" }")
  let previous = run FileSystem.readFile(&manifest)
  let next = run ManifestEdits.addDependency(
    Bytes.asSlice(&previous),
    dependencyKey,
    Bytes.asSlice(&value),
  )
  let edited = match move run Effect.result(Toml.parse(Bytes.asSlice(&next))) {
    Result<TomlValue, TomlError | OutOfMemoryError>.Success { value: parsed } => move parsed
    Result<TomlValue, TomlError | OutOfMemoryError>.Failure { error } => match move error {
      TomlError malformed => {
        drop malformed
        fail ManifestEditRefused {
          detail: run Bytes.copy(b"the edited manifest would not be valid TOML"),
        }
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }

  // A package that already reaches this one through its dependencies would close a cycle.
  let reached = run rootPackage(&dependency, &dependencyDocument)
  let mut reachable = run PackageSources.load(
    &dependency,
    move dependencyDocument,
    Bytes.asSlice(&reached.identity),
    &reached.sourceRoot,
    store,
    run ModuleSourceFiles.archiveContext(store, Target.name(&hostTarget())),
    Versions.Checked,
  )
  run PackageSources.requireAll(&mut reachable)
  let root = run rootPackage(&directory, &document)
  if let Option<&Path>.Some { .. } = move PackageSources.dependencyRoot(
    &reachable,
    Bytes.asSlice(&root.identity),
  ) {
    let mut reason = run Bytes.copy(Bytes.asSlice(&reached.identity))
    run Bytes.append(&mut reason, b" already depends on ")
    run Bytes.append(&mut reason, Bytes.asSlice(&root.identity))
    run Bytes.append(
      &mut reason,
      b", directly or through other packages, so adding it would form a cycle",
    )
    return run refusedDependency(dependencyKey, Bytes.asSlice(&reason))
  }
  let mut checked = run PackageSources.load(
    &directory,
    move edited,
    Bytes.asSlice(&root.identity),
    &root.sourceRoot,
    store,
    run ModuleSourceFiles.archiveContext(store, Target.name(&hostTarget())),
    Versions.Checked,
  )
  run PackageSources.requireAll(&mut checked)
  drop checked
  run FileSystem.writeFile(&manifest, Bytes.asSlice(&next))
  run Writer.writeAll(b"Added dependency ")
  run Writer.writeAll(dependencyKey)
  run Writer.writeAll(b" = ")
  run Writer.writeAll(Bytes.asSlice(&value))
  run Writer.writeAll(b" to ")
  run Writer.writeAll(Path.rawBytes(&manifest))
  run Writer.writeAll(b"\n")
}

// Removes dependency `command.name` from the located manifest.
effect fn removedDependency(working: &Path, command: RemoveCommand) -> ()
  ! ApplicationError
    | ProjectError
    | InvalidDependency
    | ManifestEditRefused
    | FileError
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut Allocator | &mut Writer {
  let RemoveCommand { name, manifestPath } = move command
  let manifest = run manifestFor(working, &manifestPath)
  let document = run Projects.parsed(&manifest)
  let package = run packageTable(&manifest, &document)
  drop package
  if !hasDependency(&document, Bytes.asSlice(&name)) {
    return run refusedDependency(
      Bytes.asSlice(&name),
      b"the package has no dependency of that name",
    )
  }
  let previous = run FileSystem.readFile(&manifest)
  let next = run ManifestEdits.removeDependency(Bytes.asSlice(&previous), Bytes.asSlice(&name))
  run FileSystem.writeFile(&manifest, Bytes.asSlice(&next))
  run Writer.writeAll(b"Removed dependency ")
  run Writer.writeAll(Bytes.asSlice(&name))
  run Writer.writeAll(b" from ")
  run Writer.writeAll(Path.rawBytes(&manifest))
  run Writer.writeAll(b"\n")
}

// Reports one failed `add` or `remove`, answering its status: 0, or 2 when refused.
effect fn reportedEdit(
  outcome: Result<
    (),
    ApplicationError
      | ProjectError
      | InvalidDependency
      | ManifestEditRefused
      | FileError
      | OutOfMemoryError
      | WriterError
  >,
) -> i32
  ! ApplicationError | FileError | OutOfMemoryError | WriterError {
  return match move outcome {
    Result<
      (),
      ApplicationError
        | ProjectError
        | InvalidDependency
        | ManifestEditRefused
        | FileError
        | OutOfMemoryError
        | WriterError
    >.Success {
      ..
    } => 0
    Result<
      (),
      ApplicationError
        | ProjectError
        | InvalidDependency
        | ManifestEditRefused
        | FileError
        | OutOfMemoryError
        | WriterError
    >.Failure {
      error
    } => match move error {
      ProjectError problem => {
        run reportProject(&problem)
        return 2
      }
      InvalidDependency invalid => {
        run writeDependency(&invalid)
        return 2
      }
      ManifestEditRefused refused => {
        run writeError(b"silk: cannot edit the manifest: ")
        run writeError(Bytes.asSlice(&refused.detail))
        run writeError(b"\n")
        return 2
      }
      ApplicationError application => {
        fail move application
      }
      FileError file => {
        fail move file
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      WriterError written => {
        fail move written
      }
    }
  }
}

/// Resolves one command-line path, naming the rejected argument when no path can spell it.
effect fn pathArgument(working: &Path, argument: &[u8]) -> Path
  ! ApplicationError | OutOfMemoryError
  ? &mut Allocator {
  let resolved = run Effect.result(CommandPath.resolve(working, argument))
  return match move resolved {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError invalid => {
        drop invalid
        fail ApplicationError.InvalidPath { argument: run Bytes.copy(argument) }
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// `silk doctest`: in a package, checks every example, then builds and runs each one that declares a
// `main`; the model-file and standard-library forms only check theirs.
effect fn doctest() -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  let mut packages = match move run Effect.result(DocumentationCommand.packageExamples()) {
    Result<Option<List<PackageExamples>>, DocumentationError>.Success {
      value
    } => match move value {
      Option<List<PackageExamples>>.Some { value: found } => move found
      Option<List<PackageExamples>>.None => {
        return run DocumentationCommand.runHost(b"doctest")
      }
    }
    Result<Option<List<PackageExamples>>, DocumentationError>.Failure { error } => {
      return run DocumentationCommand.failed(b"doctest", move error)
    }
  }

  // At a workspace root each member's results follow a heading, and the command fails when any
  // example fails or no member has one.
  let listed = List<PackageExamples>.asMutSlice(&mut packages)
  let mut total = Summary { collected: 0, passed: 0, skipped: 0, failed: 0 }
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].member {
      run DocumentationCommand.heading(&listed[at].package)
    }
    let summary = run runExamples(
      &listed[at].package,
      &listed[at].libraryRoot,
      &mut listed[at].outcomes,
    )
    DocumentationCommand.combine(&mut total, &summary)
    at = at + usize.ONE
  }
  return Doctest.status(&total)
}

// Builds and runs each pending example of `package`, and reports every example as it is resolved,
// so a build's diagnostics come just before its example's result line.
effect fn runExamples(
  package: &Project,
  libraryRoot: &Path,
  outcomes: &mut List<Outcome>,
) -> Summary
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  // An example imports the package by the name its dependents write, with `_` for each `-`.
  let mut alias = run Bytes.copy(Projects.name(package))
  let letters = Bytes.asMutSlice(&mut alias)
  let mut letter = usize.ZERO
  while letter < letters.length {
    if letters[letter] == 45 {
      letters[letter] = 95
    }
    letter = letter + usize.ONE
  }

  // The example's source sits beside the package's own modules, under a name none of them has.
  let mut entry = run Path.join(Projects.sourceRoot(package), "doctest_example.silk")
  let mut suffix: usize = 2
  while run FileSystem.exists(&entry) {
    let mut name = run Bytes.copy(b"doctest_example_")
    run JsonText.appendDecimal(&mut name, suffix)
    run Bytes.append(&mut name, b".silk")
    entry = run Path.joinBytes(Projects.sourceRoot(package), Bytes.asSlice(&name))
    suffix = suffix + 1
  }
  let directory = run Path.join(Projects.outputDirectory(package), "doctest")
  run FileSystem.createDirectoriesRecursively(&directory)
  let output = run Path.join(&directory, "example")
  let options = ProjectCommands.options()
  let listed = List<Outcome>.asMutSlice(&mut outcomes.*)
  let mut summary = Summary { collected: listed.length, passed: 0, skipped: 0, failed: 0 }
  let mut at = usize.ZERO
  while at < listed.length {
    let mut pending = Option<Bytes>.none()
    if let Verdict.Pending { code } = &listed[at].verdict {
      pending = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&code)))
    }
    if let Option<Bytes>.Some { value } = move pending {
      listed[at].verdict = run runExample(
        package,
        &options,
        libraryRoot,
        &entry,
        &output,
        Bytes.asSlice(&alias),
        Bytes.asSlice(&value),
      )
    }
    run Doctest.writeOutcome(&mut summary, &listed[at])
    at = at + usize.ONE
  }
  run Doctest.writeSummary(&summary)
  return move summary
}

effect fn exampleFailure(reason: &[u8]) -> Verdict
  ! OutOfMemoryError
  ? &mut Allocator {
  return Verdict.Failed { reason: run Bytes.copy(reason), details: Bytes.make() }
}

// Builds one example as the entry of `package` for the host, with the package's default profile,
// then runs it in the package directory. Status 0 passes; the build's diagnostics are on standard
// error, and a failing program's output follows its result line.
effect fn runExample(
  package: &Project,
  options: &ProjectOptions,
  libraryRoot: &Path,
  entry: &Path,
  output: &Path,
  alias: &[u8],
  code: &[u8],
) -> Verdict
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  let mut plans = match move run projectPlans(options) {
    Option<List<ProjectPlan>>.Some { value } => move value
    Option<List<ProjectPlan>>.None => {
      return run exampleFailure(b"the package has no compilation for this host")
    }
  }
  let plan = List<ProjectPlan>.remove(&mut plans, usize.ZERO)
  let ProjectPlan {
    input: planned,
    bindings,
    task: _,
    maxMemory,
    stackSize,
    entry: _,
    unsandboxedTools
  } = move plan
  let mut input = move planned
  input.artifact = Option<Bytes>.some(run Bytes.copy(Projects.profileArtifact(Form.Executable)))
  let profile = run InitialProfile.freeze(&input)
  let target = Target.forId(Target.id(InitialProfile.target(&profile)))
  if Target.id(&target) != Target.id(&hostTarget())
    && !same(Target.operatingSystem(&target), b"wasi") {
    let mut reason = run Bytes.copy(b"the package builds for ")
    run Bytes.append(&mut reason, Target.name(&target))
    run Bytes.append(&mut reason, b", which cannot run on this host; mark the example no_run")
    return Verdict.Failed { reason: move reason, details: Bytes.make() }
  }
  let library = Option<Path>.some(run Path.fromBytes(Path.rawBytes(libraryRoot)))
  let mut files = run ExampleSources.make(entry, code)
  let mut silent = Progress.off()
  let mut warned = Bytes.make()
  let built = run build(
    entry,
    Option<&Path>.some(Projects.manifest(package)),
    Option<&Path>.none(),
    output,
    Projects.directory(package),
    Form.Executable,
    Stage.Final,
    move library,
    move profile,
    move maxMemory,
    move stackSize,
    move bindings,
    &SupplyRequest.Automatic,
    false,
    false,
    &Option<Bytes>.none(),
    &Option<Bytes>.none(),
    Option<&[u8]>.some(alias),
    Option<Bytes>.none(),
    false,
    &mut silent,
    &mut warned,
    MirListing.Off,
    false,
    true,
    Option<&CompilationRequest>.none(),
    unsandboxedTools,
    Option<Path>.none(),
    false,
    run versionPolicy(false),
  )
    |> Effect.provideMut<FileSystem>(&mut files)
  let status = match move built {
    Compiled.Finished { status } => status
    Compiled.Tests { identities } => {
      drop identities
      return run exampleFailure(b"the example did not build")
    }
  }
  if status != 0 {
    return run exampleFailure(b"the example did not build")
  }
  let mut request = run ChildProcess.requestWithin(output, Projects.directory(package))
  if same(Target.operatingSystem(&target), b"wasi") {
    request = match move run WasiTools.request(
      output,
      b"0",
      Option<&Path>.some(Projects.directory(package)),
    ) {
      Option<ProcessRequest>.Some { value } => move value
      Option<ProcessRequest>.None => {
        return run exampleFailure(b"the WASI runtime is unavailable")
      }
    }
  }
  let outcome = run ChildProcess.submit(&request)
  let mut details = run Bytes.copy(ChildProcess.outputBytes(&outcome))
  run Bytes.append(&mut details, ChildProcess.errorBytes(&outcome))
  if Bytes.length(&details) > usize.ZERO
    && Bytes.asSlice(&details)[Bytes.length(&details) - usize.ONE] != 10 {
    run Bytes.append(&mut details, b"\n")
  }
  let mut reason = Bytes.make()
  if let Option<i32>.Some { value } = move ChildProcess.exitCode(&outcome) {
    if value == 0 {
      return Verdict.Passed
    }
    run Bytes.append(&mut reason, b"the example exited with status ")
    run JsonText.appendDecimal(&mut reason, i32.toUsize(value))
  } else if let Option<i32>.Some { value: signal } = move ChildProcess.terminatingSignal(&outcome) {
    run Bytes.append(&mut reason, b"the example stopped on signal ")
    run JsonText.appendDecimal(&mut reason, i32.toUsize(signal))
  } else {
    run Bytes.append(&mut reason, b"the example did not finish")
  }
  return Verdict.Failed { reason: move reason, details: move details }
}

effect fn program() -> i32
  ! ApplicationError
    | InitialProfileProblem
    | HostInputError
    | OutOfMemoryError
    | FileError
    | WriterError
    | ProcessError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
  ? &mut HostInput | &mut Allocator | &mut Writer | &mut Types {
  let captured = run Effect.result(HostInput.argument(usize.ONE))
  let selector = match move captured {
    Result<Option<Bytes>, HostInputError | OutOfMemoryError>.Success {
      value: argument
    } => move argument
    Result<Option<Bytes>, HostInputError | OutOfMemoryError>.Failure { .. } => {
      let mut diagnostics = StderrWriter.make()
      let reported = run Effect.result(
        Writer.writeAll(b"silk: cannot read command argument\n")
          |> Effect.provideMut<Writer>(&mut diagnostics),
      )
      drop reported
      return 2
    }
  }
  if let Option<Bytes>.Some { value } = move selector {
    let selected = Bytes.asSlice(&value)

    // `silk <command> --help` prints that command's usage; the documentation commands print their
    // own.
    let documentation = same(selected, b"doc") || same(selected, b"doctest")
      || same(selected, b"doc-reference")
    let count = run HostInput.argumentCount()
    let aliased = same(selected, b"run") || same(selected, b"plan")
      || ((same(selected, b"build") || same(selected, b"test")) && run projectForm(count))
    if aliased {
      let arguments = run commandArguments(count)
      let workingText = run HostInput.workingDirectory()
      let working = run CommandPath.fromHost(workingText.asSlice())
      let mut files = run MachineFileSystem.make()
      let mut processes = OsChildProcess.make()
      let mut stdout = StdoutWriter.make()
      let selectedTask = run taskAlias(&working, selected, arguments.asSlice())
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut processes)
        |> Effect.provideMut<Writer>(&mut stdout)
      if let Option<i32>.Some { value: status } = move selectedTask {
        return status
      }
    }

    // `silk help` prints the overview, and `silk help <command>` that command's synopsis.
    if same(selected, b"help") && count <= usize.add(0, 3) {
      let mut stdout = StdoutWriter.make()
      if count == usize.add(0, 2) {
        run Writer.writeAll(usage()) |> Effect.provideMut<Writer>(&mut stdout)
        return 0
      }
      let named = run argumentAt(usize.add(0, 2), count)
      if run writeCommandHelp(Bytes.asSlice(&named), false) |> Effect.provideMut<Writer>(&mut stdout) {
        return 0
      }
      run writeError(b"silk: unknown command `")
      run writeError(Bytes.asSlice(&named))
      run writeError(b"`\n")
      run writeError(usage())
      return 2
    }
    // `silk task --help` also lists the package's tasks, so the task command answers it.
    if !documentation && !same(selected, b"task") && count == usize.add(0, 3) {
      let flag = run argumentAt(usize.add(0, 2), usize.add(0, 3))
      let json = same(Bytes.asSlice(&flag), b"--help=json")
      if same(Bytes.asSlice(&flag), b"--help") || same(Bytes.asSlice(&flag), b"-h") || json {
        let mut stdout = StdoutWriter.make()
        if run writeCommandHelp(selected, json) |> Effect.provideMut<Writer>(&mut stdout) {
          return 0
        }
      }
    }

    // A project command answers `--help` anywhere before `--`.
    if count > usize.add(0, 3)
      && (ProjectCommands.writesHelp(selected) || same(selected, b"format")) {
      let arguments = run commandArguments(count)
      if ProjectCommands.asksHelp(List<Bytes>.asSlice(&arguments)) {
        let json = ProjectCommands.asksHelpJson(List<Bytes>.asSlice(&arguments))
        let mut stdout = StdoutWriter.make()
        if run writeCommandHelp(selected, json) |> Effect.provideMut<Writer>(&mut stdout) {
          return 0
        }
      }
    }
    if same(selected, b"lsp") {
      // The server reads the standard library `--stdlib <directory>` names, or else the one
      // installed beside the compiler, when there is one.
      let arguments = run commandArguments(count)
      let configured = match move run Effect.result(
        ProjectCommands.parseLsp(List<Bytes>.asSlice(&arguments)),
      ) {
        Result<Option<Bytes>, InvalidProjectCommand | OutOfMemoryError>.Success {
          value: standardLibrary
        } => move standardLibrary
        Result<Option<Bytes>, InvalidProjectCommand | OutOfMemoryError>.Failure {
          error
        } => match move error {
          InvalidProjectCommand invalid => {
            let mut message = run Bytes.copy(b"silk lsp: ")
            run Bytes.append(&mut message, Bytes.asSlice(&invalid.reason))
            run Bytes.append(&mut message, b"\nRun `silk help lsp` for its options.\n")
            run writeError(Bytes.asSlice(&message))
            return 2
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
      let workingDirectory = run HostInput.workingDirectory()
      let working = run CommandPath.fromHost(Bytes.asSlice(&workingDirectory))
      let mut files = run MachineFileSystem.make()
      let standardLibrary = run standardLibraryFor(&working, &configured)
        |> Effect.provideMut<FileSystem>(&mut files)
      let store = run GitCheckouts.store()
      return run LspCommand.runHost(move standardLibrary, move store, hostTarget())
    }
    if same(selected, b"doctest") {
      let mut files = run MachineFileSystem.make()
      let mut process = OsChildProcess.make()
      return run doctest()
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    if same(selected, b"doc") || same(selected, b"doctest") || same(selected, b"doc-reference") {
      let mut files = run MachineFileSystem.make()
      let mut process = OsChildProcess.make()
      return run DocumentationCommand.runHost(selected)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    if same(Bytes.asSlice(&value), b"format") {
      let mut diagnostics = StderrWriter.make()
      let initialized = run Effect.result(MachineFileSystem.make())
      let mut files = match move initialized {
        Result<MachineFileSystem, OutOfMemoryError>.Success { value: provider } => move provider
        Result<MachineFileSystem, OutOfMemoryError>.Failure { .. } => {
          let reported = run Effect.result(
            Writer.writeAll(b"silk format: cannot initialize filesystem\n")
              |> Effect.provideMut<Writer>(&mut diagnostics),
          )
          drop reported
          return 2
        }
      }
      let ran = run FormatCommand.runHost()
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<Writer>(&mut diagnostics)
      let reported = run Effect.result(reportFormat(List<FileOutcome>.asSlice(&ran.outcomes)))
      if let Result<(), WriterError | OutOfMemoryError>.Failure { .. } = move reported {
        return 2
      }
      return ran.status
    }
  }
  let command = run request()
  let workingDirectory = run HostInput.workingDirectory()
  let mut files = run MachineFileSystem.make()
  let working = run CommandPath.fromHost(Bytes.asSlice(&workingDirectory))
  return match move command {
    Request.Schema { kind } => {
      let shapes = match kind {
        SchemaKind.Request => run Schemas.shape<CompilationRequest>()
        SchemaKind.Manifest => run Schemas.shape<PackageManifest>()
      }
      let mut stdout = StdoutWriter.make()
      let result = run Effect.result(
        JsonSchemas.write(&shapes, JsonSchemaOptions.of(JsonSchemaDialect.Standard))
          |> Effect.provideMut<Writer>(&mut stdout),
      )
      return match move result {
        Result<bool, JsonSchemaError | WriterError | OutOfMemoryError>.Success {
          value
        } => if value {
          0
        } else {
          1
        }
        Result<bool, JsonSchemaError | WriterError | OutOfMemoryError>.Failure {
          error
        } => match move error {
          JsonSchemaError _invalid => {
            run writeError(b"silk: cannot describe the requested schema\n")
            return 2
          }
          WriterError failed => {
            fail move failed
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    Request.Plan { command: invocation } => {
      let mut process = OsChildProcess.make()
      return run planProject(&working, move invocation.options, "plan.json")
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.Fetch { command: invocation } => {
      let mut process = OsChildProcess.make()
      return run fetchProject(&working, move invocation)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.PackagePath { command: invocation } => {
      let mut process = OsChildProcess.make()
      return run packagePath(&working, move invocation)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.Resolve { command: resolveCommand } => {
      let mut process = OsChildProcess.make()
      return run resolveDefinition(&working, move resolveCommand)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.Graph { command: described } => {
      let description = run pathArgument(&working, described.description.asSlice())
      let outcome = run pathArgument(&working, described.outcome.asSlice())
      // The graph's steps report their own progress; this reports what the graph made.
      let mut settings = run progressSettingsFor(&Option<Bytes>.none(), false, false, usize.ONE)
      settings.quiet = true
      let mut progress = run Progress.start(&settings, b"", b"", b"")
      let served = run GraphHost.serve(&description, &outcome)
        |> Effect.provideMut<FileSystem>(&mut files)
      let made = served.artifacts.asSlice()
      let mut at = usize.ZERO
      while at < made.length {
        let shown = run shownPath(&working, &run Path.make(made[at].view()))
        run Progress.finishPart(&mut progress, Bytes.asSlice(&shown))
        at = at + usize.ONE
      }
      return served.status
    }
    Request.Compile { file, ignoreWarnings, progress } => {
      let mut process = OsChildProcess.make()
      return run compileRequest(&working, &file, ignoreWarnings, progress)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.Build {
      source,
      output,
      stage,
      standardLibrary: configured,
      input,
      stats,
      clang,
      mir,
      ignoreWarnings
    } => {
      let sourcePath = run pathArgument(&working, Bytes.asSlice(&source))
      let outputPath = run pathArgument(&working, Bytes.asSlice(&output))
      let selectedClang = run clangFor(&working, &clang)
      let standardLibrary = run standardLibraryFor(&working, &configured)
        |> Effect.provideMut<FileSystem>(&mut files)
      let mut process = OsChildProcess.make()
      return run buildSource(
        &working,
        &sourcePath,
        &outputPath,
        move stage,
        move standardLibrary,
        move input,
        stats,
        &selectedClang,
        mir,
        ignoreWarnings,
      )
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.Test {
      source,
      output,
      standardLibrary: configured,
      profile,
      filter,
      file,
      timeout,
      noCache,
      ignoreWarnings
    } => {
      let sourcePath = run pathArgument(&working, Bytes.asSlice(&source))
      let outputPath = run pathArgument(&working, Bytes.asSlice(&output))
      let standardLibrary = run standardLibraryFor(&working, &configured)
        |> Effect.provideMut<FileSystem>(&mut files)
      let mut process = OsChildProcess.make()
      let display = match move run Path.parent(&sourcePath) {
        Option<Path>.Some { value } => move value
        Option<Path>.None => run Path.root()
      }
      let automatic = SupplyRequest.Automatic
      let selecting = hasFilter(&filter) || hasFilter(&file)
      let mut matched = false
      let status = run test(
        &sourcePath,
        Option<&Path>.none(),
        &outputPath,
        &display,
        &automatic,
        move standardLibrary,
        move profile,
        List<Supplied>.make(),
        move filter,
        move file,
        &timeout,
        &Option<Bytes>.none(),
        noCache,
        &mut matched,
        ignoreWarnings,
        Option<Path>.none(),
        Progress.off(),
        false,
        run versionPolicy(false),
      )
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
      if status == 0 && selecting && !matched {
        run reportUnmatched()
        return 1
      }
      return status
    }
    Request.Run { command: invocation } => {
      let mut process = OsChildProcess.make()
      return run runProject(&working, move invocation, true)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.Task { command: invocation } => {
      let mut process = OsChildProcess.make()
      return run taskProject(&working, move invocation)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.Clean { command: invocation } => {
      return run cleanProject(&working, move invocation)
        |> Effect.provideMut<FileSystem>(&mut files)
    }
    Request.Sandbox { arguments } => {
      return run sandboxed(List<Bytes>.asSlice(&arguments))
    }
    Request.Add { command: invocation } => {
      let store = run GitCheckouts.store()
      let outcome = run Effect.result(
        addedDependency(&working, move invocation, borrowedPath(&store))
          |> Effect.provideMut<FileSystem>(&mut files),
      )
      return run reportedEdit(move outcome)
    }
    Request.Remove { command: invocation } => {
      let outcome = run Effect.result(
        removedDependency(&working, move invocation) |> Effect.provideMut<FileSystem>(&mut files),
      )
      return run reportedEdit(move outcome)
    }
    Request.Check { command: invocation } => {
      let mut process = OsChildProcess.make()
      return run checkProject(&working, move invocation)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.Pack { command: invocation } => {
      let mut process = OsChildProcess.make()
      return run packProject(&working, move invocation)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.Hash { command: invocation } => {
      let mut process = OsChildProcess.make()
      return run hashProject(&working, move invocation)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.ProjectBuild { command: invocation } => {
      let mut process = OsChildProcess.make()
      return run buildProject(&working, move invocation, true)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.ProjectTest { command: invocation } => {
      let mut process = OsChildProcess.make()
      let mut tests = TestSelection { multiplePackages: false, filtered: false, matched: false }
      let status = run testProject(&working, move invocation, &mut tests, true)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
      return run finishTestSelection(status, &tests)
    }
    Request.Help => {
      let mut stdout = StdoutWriter.make()
      run Writer.writeAll(usage()) |> Effect.provideMut<Writer>(&mut stdout)
      return 0
    }
    Request.Version => {
      let mut stdout = StdoutWriter.make()
      run Writer.writeAll(b"silk v") |> Effect.provideMut<Writer>(&mut stdout)
      run Writer.writeAll(ReleaseVersion.value()) |> Effect.provideMut<Writer>(&mut stdout)
      run Writer.writeAll(b"\n") |> Effect.provideMut<Writer>(&mut stdout)
      return 0
    }
    Request.Init { command: invocation } => {
      let mut process = OsChildProcess.make()
      return run initProject(&working, move invocation)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.Dump { stage, source: argument } => {
      let path = run pathArgument(&working, Bytes.asSlice(&argument))
      let present = run CommandPath.exists(Path.rawBytes(&path), false)
        |> Effect.provideMut<FileSystem>(&mut files)
      if !present {
        run writeError(b"silk dump: no such source file `")
        run writeError(Bytes.asSlice(&argument))
        run writeError(b"`\n")
        return 2
      }
      let source = run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
      let mut lexer = Lexer.make(Bytes.asSlice(&source))
      let tokens = run lex(&mut lexer)
      let tree = run Parser.parse(move source, move tokens)
      match stage {
        Dumped.Tokens => run SyntaxTree.writeTokens(&tree)
        Dumped.Syntax => run SyntaxTree.write(&tree)
        Dumped.Hir => {
          let module = run Lower.lower(&tree)
          run Hir.write(&module)
          run Fingerprint.writeFingerprints(&module)
          run Hir.writeViolations(&module)
        }
      }
      return 0
    }
  }
}

/// Names one portable file operation code for a failure report.
fn fileOperationName(code: i32) -> &'static [u8] {
  if code == 0 {
    return b"read"
  }
  if code == 1 {
    return b"write"
  }
  if code == 2 {
    return b"inspect"
  }
  if code == 3 {
    return b"list"
  }
  if code == 4 {
    return b"create directory"
  }
  if code == 5 {
    return b"remove"
  }
  if code == 6 {
    return b"remove directory"
  }
  if code == 7 {
    return b"resolve path"
  }
  return b"create temporary directory"
}

/// Names one portable file failure reason code for a failure report.
fn fileReasonName(code: i32) -> &'static [u8] {
  if code == 0 {
    return b"not found"
  }
  if code == 1 {
    return b"already exists"
  }
  if code == 2 {
    return b"permission denied"
  }
  if code == 3 {
    return b"invalid path"
  }
  if code == 4 {
    return b"wrong file type"
  }
  if code == 5 {
    return b"directory not empty"
  }
  if code == 6 {
    return b"no space left"
  }
  if code == 7 {
    return b"too large"
  }
  if code == 8 {
    return b"unsupported"
  }
  return b"other failure"
}

/// Writes one line naming a failure that escaped the command, so no failure exits silently.
///
/// The synchronous native startup maps an unhandled failure to status 1 without a report, so the
/// command reports its own failures before returning that status.
///
/// The status is 2 for a command line that does not parse, as for every usage error, else 1.
effect fn report(
  failure: ApplicationError
    | InitialProfileProblem
    | HostInputError
    | OutOfMemoryError
    | FileError
    | WriterError
    | ProcessError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch,
) -> i32
  ! WriterError {
  match move failure {
    ApplicationError application => match move application {
      ApplicationError.InvalidArgumentCount { .. } => {
        run writeError(usage())
        return 2
      }
      ApplicationError.InvalidCommand { message } => {
        run writeError(Bytes.asSlice(&message))
        return 2
      }
      ApplicationError.InvalidBuildProfile => run writeError(b"silk: invalid compilation settings\n")
      ApplicationError.InvalidPath { argument } => {
        run writeError(b"silk: invalid path argument: ")
        run writeError(Bytes.asSlice(&argument))
        run writeError(b"\n")
      }
      ApplicationError.MissingRootModule { package, path, tasks } => {
        run writeError(b"silk: package `")
        run writeError(Bytes.asSlice(&package))
        run writeError(b"` has no root module: ")
        run writeError(Bytes.asSlice(&path))
        run writeError(b" does not exist\n")
        if tasks {
          run writeError(
            b"The package has a tasks program instead: `silk task` lists its tasks, and `silk task <name>` runs one.\n",
          )
        } else {
          run writeError(
            b"Write that file, or set `main` under [package] in silk.toml to the module to build.\n",
          )
        }
      }
      ApplicationError.NotStandardLibrary { directory, missing } => {
        run writeError(b"silk: --stdlib ")
        run writeError(Bytes.asSlice(&directory))
        if missing {
          run writeError(b" is not a standard library directory: it does not exist\n")
        } else {
          run writeError(b" is not a standard library directory: it has no compositions.json\n")
        }
      }
    }
    InitialProfileProblem problem => {
      run writeError(b"silk: invalid compilation settings: ")
      run writeError(
        match problem.kind {
          ProblemKind.InvalidInput => b"InvalidInput: "
          ProblemKind.UnsupportedCombination => b"UnsupportedCombination: "
        },
      )
      run writeError(InitialProfileProblem.subject(&problem))
      run writeError(b"\n")
    }
    HostInputError _ignored => run writeError(b"silk: cannot read host input\n")
    OutOfMemoryError _ignored => run writeError(b"silk: out of memory\n")
    FileError file => {
      run writeError(b"silk: cannot ")
      run writeError(fileOperationName(file.operation.code))
      run writeError(b": ")
      run writeError(fileReasonName(file.reason.code))
      run writeError(b"\n")
    }
    WriterError _ignored => run writeError(b"silk: cannot write output\n")
    ProcessError _ignored => run writeError(b"silk: cannot run the C compiler\n")
    InvalidModulePath _ignored => run writeError(b"silk: invalid module path\n")
    InvalidSourceRoot _ignored => run writeError(b"silk: invalid source root\n")
    InvalidDependency invalid => {
      // A refused dependency is a manifest error like the others.
      run writeDependency(&invalid)
      return 2
    }
    MissingManifest missing => {
      run writeError(b"silk: no silk.toml in ")
      run writeError(Path.rawBytes(&missing.directory))
      run writeError(b" or any parent directory; a build needs a package manifest\n")
    }
    InvalidBuildComposition invalid => {
      if Bytes.length(&invalid.detail) == usize.ZERO {
        run writeError(b"silk: the build selects no single runtime (ARTIFACT-001)\n")
      } else {
        run writeError(b"silk: ")
        run writeError(Bytes.asSlice(&invalid.detail))
        run writeError(b" (ARTIFACT-001)\n")
      }
    }
    MissingStandardLibrary _ignored => run writeError(
      b"silk: no standard library found: install it as lib/silk/stdlib beside the compiler's bin directory, or pass --stdlib <directory>\n",
    )
    InvalidNativeLinkInput invalid => {
      run writeError(b"silk: invalid native link input: ")
      run writeError(Bytes.asSlice(&invalid.detail))
      run writeError(b"\n")
    }
    TomlError _ignored => run writeError(b"silk: invalid TOML manifest\n")
    RegistrationClosed _ignored => run writeError(
      b"silk: internal error: query registration closed\n",
    )
    ConflictingPackageSource _ignored => run writeError(b"silk: conflicting package sources\n")
    Cycle _ignored => run writeError(b"silk: internal error: query cycle\n")
    RevisionMismatch _ignored => run writeError(b"silk: internal error: source revision mismatch\n")
  }
  return 1
}

pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let mut output = StdoutWriter.make()
  let outcome = run Effect.result(
    program()
      |> Effect.provideMut<Types>(&mut typeTable)
      |> Effect.provideMut<Allocator>(&mut allocator)
      |> Effect.provideMut<Writer>(&mut output),
  )

  // The table's keys share types all over the heap; dropping them would only touch every page
  // the exit returns anyway, and after a detached cache writer forked, copy each one.
  drop run Effect.result(
    abandonValue<TypeTable>(move typeTable) |> Effect.provideMut<Allocator>(&mut allocator),
  )
  return match move outcome {
    Result<
      i32,
      ApplicationError
        | InitialProfileProblem
        | HostInputError
        | OutOfMemoryError
        | FileError
        | WriterError
        | ProcessError
        | InvalidModulePath
        | InvalidSourceRoot
        | InvalidDependency
        | MissingManifest
        | InvalidBuildComposition
        | MissingStandardLibrary
        | InvalidNativeLinkInput
        | TomlError
        | RegistrationClosed
        | ConflictingPackageSource
        | Cycle
        | RevisionMismatch
    >.Success {
      value
    } => value
    Result<
      i32,
      ApplicationError
        | InitialProfileProblem
        | HostInputError
        | OutOfMemoryError
        | FileError
        | WriterError
        | ProcessError
        | InvalidModulePath
        | InvalidSourceRoot
        | InvalidDependency
        | MissingManifest
        | InvalidBuildComposition
        | MissingStandardLibrary
        | InvalidNativeLinkInput
        | TomlError
        | RegistrationClosed
        | ConflictingPackageSource
        | Cycle
        | RevisionMismatch
    >.Failure {
      error
    } => {
      return match move run Effect.result(report(move error)) {
        Result<i32, WriterError>.Success { value } => value
        Result<i32, WriterError>.Failure { .. } => 1
      }
    }
  }
}

// Reads standard input only for the explicit `--request -` form.
effect fn requestInput() -> Bytes
  ! ApplicationError | OutOfMemoryError
  ? &mut Allocator {
  let mut input = OsStandardInput.make()
  let mut bytes = Bytes.make()
  let mut buffer: [u8; 8192] = [0; 8192]
  while true {
    let read = run Effect.result(
      StandardInput.read(&mut buffer) |> Effect.provideMut<StandardInput>(&mut input),
    )
    let outcome = match move read {
      Result<ReadOutcome, StreamReadError>.Success { value } => move value
      Result<ReadOutcome, StreamReadError>.Failure { .. } => {
        fail ApplicationError.InvalidCommand {
          message: run Bytes.copy(b"silk compile: cannot read standard input\n"),
        }
      }
    }
    if StandardInput.isEndOfInput(&outcome) {
      break
    }
    run bytes.append(Slice.view<u8>(&buffer, usize.ZERO, StandardInput.count(&outcome)))
  }
  return move bytes
}

effect fn requestSupply(request: &CompilationRequest) -> SupplyRequest
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut supply = SupplyRequest.Builtin
  if let Option<RequestPlatform>.Some { value } = &request.platform {
    let mut support = List<SupplyInstallation>.make()
    let installations = List<RequestInstallation>.asSlice(&value.support)
    let mut at = usize.ZERO
    while at < installations.length {
      run support.append(
        SupplyInstallation {
          root: run Path.make(installations[at].root.view()),
          target: run Bytes.copy(String.ownedUtf8Bytes(&installations[at].target)),
          origin: run Bytes.copy(b"compilation request"),
        },
      )
      at = at + usize.ONE
    }
    supply = SupplyRequest.Explicit {
      target: run Bytes.copy(String.ownedUtf8Bytes(&request.profile.target)),
      root: run Path.make(value.sysroot.view()),
      linker: run Path.make(value.linker.view()),
      origin: run Bytes.copy(b"compilation request"),
      support: move support,
    }
  }
  return move supply
}

effect fn compileRequest(working: &Path, file: &Bytes, ignoreWarnings: bool, reported: bool) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  let bytes = if same(file.asSlice(), b"-") {
    run requestInput()
  } else {
    run FileSystem.readFile(&run pathArgument(working, file.asSlice()))
  }
  let request = match move run Effect.result(
    SchemaToml.decode<CompilationRequest>(bytes.asSlice()),
  ) {
    Result<CompilationRequest, SchemaError | OutOfMemoryError>.Success { value } => move value
    Result<CompilationRequest, SchemaError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      SchemaError problem => {
        let mut stderr = StderrWriter.make()
        run SchemaReport.writeOne(
          &problem,
          bytes.asSlice(),
          "compilation request",
          ReportOptions.line(),
        )
          |> Effect.provideMut<Writer>(&mut stderr)
        return 2
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let profile = run CompilationRequests.profile(&request)
  let bindings = run CompilationRequests.bindings(&request)
  let source = run Path.make(request.root.view())
  let output = run Path.make(request.output.view())
  let library = Option<Path>.some(run Path.make(request.stdlib.view()))
  let form = if request.artifact.view() == "loadable-module" {
    Form.SharedLibrary
  } else if request.artifact.view() == "static-archive" {
    Form.StaticLibrary
  } else if request.artifact.view() == "object" {
    Form.Object
  } else {
    Form.Executable
  }
  let stage = if request.emit.view() == "llvm-ir" {
    Stage.LlvmIr
  } else if request.emit.view() == "llvm-bitcode" {
    Stage.LlvmBitcode
  } else if request.emit.view() == "assembly" {
    Stage.Assembly
  } else if request.emit.view() == "object" {
    Stage.Object
  } else if request.emit.view() == "wasm-text" {
    Stage.WasmText
  } else {
    Stage.Final
  }
  let supply = run requestSupply(&request)

  // A tasks program's graph runs this for `silk build`, which passes its own options through the
  // environment (`tasksEnvironment`).
  let warningsIgnored = ignoreWarnings || run environmentSwitch(b"SILK_IGNORE_WARNINGS")
  let mut shown = reported
  if let Option<Bytes>.Some { value } = move run HostInput.variableNamed("SILK_PROGRESS") {
    if same(value.asSlice(), b"never") { shown = false }
  }
  let mut progress = Progress.off()
  if shown {
    // A build graph's compile step shares standard error with `silk build`, so the line is redrawn
    // live on a terminal and written as plain rows otherwise, as `silk build` chooses.
    let settings = run progressSettingsFor(
      &Option<Bytes>.none(),
      run environmentSwitch(b"SILK_QUIET"),
      run environmentSwitch(b"SILK_TIMINGS"),
      usize.ONE,
    )
    let mut detail = run Bytes.copy(String.ownedUtf8Bytes(&request.profile.target))
    run Bytes.append(&mut detail, b", ")
    run Bytes.append(
      &mut detail,
      if request.profile.optimization.view() == "none" {
        b"dev"
      } else if request.profile.optimization.view() == "size" {
        b"size"
      } else {
        b"release"
      },
    )
    progress = run Progress.start(
      &settings,
      b"Compiling",
      String.ownedUtf8Bytes(&request.name),
      Bytes.asSlice(&detail),
    )
  }
  let mut warned = Bytes.make()

  // A build graph compiles into its step's directory, which changes with every edit. The program
  // builds where the steps keep it across edits instead, with the cache `silk build` keeps, so an
  // edit recompiles and relinks only what it changed; the step gets a copy.
  let mut kept = Option<Path>.none()
  if request.artifact.view() != "test" { kept = run graphOutput(&output) }
  let mut cacheHome = Option<Path>.none()
  let mut built = run Path.fromBytes(Path.rawBytes(&output))
  if let Option<Path>.Some { value: root } = &kept {
    cacheHome = run SemanticCache.directory(&root, String.ownedUtf8Bytes(&request.name))
    built = run keptArtifact(&root, &request)
    if let Option<Path>.Some { value: directory } = move run Path.parent(&built) {
      run FileSystem.createDirectoriesRecursively(&directory)
    }
  }
  let compiled = run build(
    &source,
    Option<&Path>.none(),
    borrowedPath(&cacheHome),
    &built,
    working,
    form,
    stage,
    move library,
    move profile,
    request.profile.maxMemory,
    request.profile.stackSize,
    move bindings,
    &supply,
    request.artifact.view() == "test",
    false,
    &Option<Bytes>.none(),
    &Option<Bytes>.none(),
    Option<&[u8]>.none(),
    Option<Bytes>.none(),
    false,
    &mut progress,
    &mut warned,
    MirListing.Off,
    warningsIgnored,
    true,
    Option<&CompilationRequest>.some(&request),
    false,
    Option<Path>.none(),
    false,
    run versionPolicy(false),
  )
  let status = match move compiled {
    Compiled.Finished { status: answered } => answered
    Compiled.Tests { .. } => 0
  }
  if status != 0 {
    run Progress.finish(&mut progress, String.ownedUtf8Bytes(&request.name), false)
  } else if kept.isSome() && run FileSystem.exists(&built) {
    match move run Effect.result(Publish.artifact(&built, &output)) {
      Result<(), AtomicWriteError | FileError | OutOfMemoryError>.Success { .. } => ()
      Result<(), AtomicWriteError | FileError | OutOfMemoryError>.Failure { error } => match move error {
        AtomicWriteError failure => {
          drop failure
          run writeError(b"silk: cannot copy the compiled program into its build step\n")
          return 1
        }
        FileError failure => { fail move failure }
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
  }
  return status
}

// The output directory of the build graph whose step writes `output`: the parent of the `steps`
// directory above it. None for a path no graph step holds.
effect fn graphOutput(output: &Path) -> Option<Path> ! FileError | OutOfMemoryError ? &mut Allocator {
  let mut at = run Path.fromBytes(Path.rawBytes(output))
  while true {
    let parent = match move run Path.parent(&at) {
      Option<Path>.Some { value } => move value
      Option<Path>.None => { return Option<Path>.none() }
    }
    if Path.rawBytes(&parent) == Path.rawBytes(&at) { return Option<Path>.none() }
    if let Option<string>.Some { value } = Path.name(&parent) {
      if value == "steps" { return run Path.parent(&parent) }
    }
    at = move parent
  }
  return Option<Path>.none()
}

// Where a graph's compilation keeps its program between steps:
// `<output>/steps/compilations/<target>/<dev|size|release>/<artifact>`.
effect fn keptArtifact(root: &Path, request: &CompilationRequest) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mode = if request.profile.optimization.view() == "none" {
    "dev"
  } else if request.profile.optimization.view() == "size" {
    "size"
  } else {
    "release"
  }
  let name = run Requests.artifactName(
    request.name.view(),
    request.artifact.view(),
    request.emit.view(),
    request.profile.target.view(),
  )
  let kept = run Path.join(&run Path.join(root, "steps"), "compilations")
  let target = run Path.join(&kept, request.profile.target.view())
  return run Path.join(&run Path.join(&target, mode), name.view())
}

// Whether the environment variable `name` is `1`.
effect fn environmentSwitch(name: &[u8]) -> bool
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  return match move run HostInput.variable(name) {
    Option<Bytes>.Some { value } => same(value.asSlice(), b"1")
    Option<Bytes>.None => false
  }
}

// A definition spells its paths as its author's host does, such as `D:\\work\\main.silk`. The request
// holds machine paths, so each is resolved against the working directory like a path argument.
effect fn definitionPath(working: &Path, written: &String) -> String
  ! ApplicationError | FileError | OutOfMemoryError
  ? &mut Allocator {
  let path = run pathArgument(working, String.ownedUtf8Bytes(written))
  return run RequestText.copy(Path.rawBytes(&path))
}

effect fn definitionPaths(working: &Path, definition: &mut CompilationDefinition) -> ()
  ! ApplicationError | FileError | OutOfMemoryError
  ? &mut Allocator {
  if let Option<String>.Some { value } = &definition.settings.root {
    definition.settings.root = Option<String>.some(run definitionPath(working, &value))
  }
  if let Option<String>.Some { value } = &definition.settings.native.functionOrder {
    definition.settings.native.functionOrder = Option<String>.some(
      run definitionPath(working, &value),
    )
  }
  let sources = definition.settings.native.sources.asMutSlice()
  let mut at = usize.ZERO
  while at < sources.length {
    sources[at].path = run definitionPath(working, &sources[at].path)
    let include = sources[at].include.asMutSlice()
    let mut directory = usize.ZERO
    while directory < include.length {
      include[directory] = run definitionPath(working, &include[directory])
      directory = directory + usize.ONE
    }
    at = at + usize.ONE
  }
  let links = definition.settings.native.link.asMutSlice()
  at = usize.ZERO
  while at < links.length {
    let kind = links[at].kind.view()
    if kind == "object" || kind == "archive" || kind == "linker-script" || kind == "search-path"
      || kind == "framework-search-path" {
      links[at].value = run definitionPath(working, &links[at].value)
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn resolveDefinition(working: &Path, command: ProjectCommands.Resolve) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  let definitionFile = run pathArgument(working, command.definition.asSlice())
  let bytes = run FileSystem.readFile(&definitionFile)
  let definition = match move run Effect.result(
    SchemaToml.decode<CompilationDefinition>(bytes.asSlice()),
  ) {
    Result<CompilationDefinition, SchemaError | OutOfMemoryError>.Success { value } => move value
    Result<CompilationDefinition, SchemaError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      SchemaError problem => {
        let mut stderr = StderrWriter.make()
        run SchemaReport.writeOne(
          &problem,
          bytes.asSlice(),
          "compilation definition",
          ReportOptions.line(),
        )
          |> Effect.provideMut<Writer>(&mut stderr)
        return 2
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let mut converted = move definition
  run definitionPaths(working, &mut converted)

  // `silk build --backend` reaches a tasks program's compilations here, unless the graph chose one.
  if converted.settings.profile.backend.isNone() {
    if let Option<Bytes>.Some { value } = move run HostInput.variableNamed("SILK_BACKEND") {
      if value.length() > usize.ZERO {
        converted.settings.profile.backend = Option<String>.some(run RequestText.copy(value.asSlice()))
      }
    }
  }
  let output = run pathArgument(working, command.output.asSlice())
  let artifact = match move command.artifact {
    Option<Bytes>.Some { value } => Option<Path>.some(run pathArgument(working, value.asSlice()))
    Option<Bytes>.None => Option<Path>.none()
  }
  return run resolveCompilation(
    working,
    move converted,
    &output,
    move artifact,
    command.unsandboxedTools,
    run versionPolicy(false),
  )
}

effect fn capturePlatform(request: &mut CompilationRequest, profile: &InitialProfile) -> bool
  ! FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut ChildProcess | &mut FileSystem | &mut HostInput | &mut Allocator {
  if request.platform.isNone() && request.emit.view() == "final" {
    let target = InitialProfile.target(profile)
    let deployment = match move InitialProfile.text(profile, b"deployment") {
      Option<&[u8]>.Some { value } => value
      Option<&[u8]>.None => b""
    }
    let supply = match move run Effect.result(
      PlatformSupplies.resolve(
        target,
        &hostTarget(),
        String.ownedUtf8Bytes(&request.profile.libc),
        deployment,
        request.native.sources.length() > 0 || request.native.link.length() > 0,
        &SupplyRequest.Automatic,
      ),
    ) {
      Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Success {
        value
      } => move value
      Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Failure {
        error
      } => match move error {
        SupplyError unavailable => {
          run reportSupply(&unavailable)
          return false
        }
        FileError failed => {
          fail move failed
        }
        HostInputError failed => {
          fail move failed
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    if let Option<Supply>.Some { value } = &supply {
      if !value.stub {
        let clang = match move run NativeToolchain.compiler(Option<&[u8]>.none()) {
          Option<Path>.Some { value: selected } => move selected
          Option<Path>.None => {
            run writeError(b"silk: resolving an SDK requires a native toolchain\n")
            return false
          }
        }
        let mut linker = run NativeToolchain.companion(
          &clang,
          if value.darwin {
            "ld64.lld"
          } else {
            "ld.lld"
          },
        )
        if let Option<Path>.Some { value: selected } = &value.linker {
          linker = run Path.fromBytes(Path.rawBytes(&selected))
        } else if value.darwin && !(run FileSystem.exists(&linker)) {
          linker = run Path.make("/usr/bin/ld")
        }
        let mut support = List<RequestInstallation>.make()
        if let Option<Path>.Some { value: selected } = &value.support {
          run support.append(
            RequestInstallation {
              target: run String.copy(request.profile.target.view()),
              root: run RequestText.copy(Path.rawBytes(&selected)),
            },
          )
        }
        request.platform = Option<RequestPlatform>.some(
          RequestPlatform {
            sysroot: run RequestText.copy(Path.rawBytes(&value.root)),
            linker: run RequestText.copy(Path.rawBytes(&linker)),
            support: move support,
          },
        )
      }
    }
  }
  return true
}

effect fn resolveCompilation(
  working: &Path,
  definition: CompilationDefinition,
  output: &Path,
  artifactPath: Option<Path>,
  unsandboxedTools: bool,
  versions: Versions,
) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  let manifest = Option<Bytes>.some(run Bytes.copy(String.ownedUtf8Bytes(&definition.manifest)))
  let project = match move run locateProject(working, &manifest) {
    Option<Project>.Some { value } => move value
    Option<Project>.None => {
      return 2
    }
  }
  let profile = run CompilationDefinitions.profile(
    &definition,
    Target.name(&hostTarget()),
    Projects.profileArtifact(Projects.form(&project)),
  )
  let mut configuredLibrary = Option<Bytes>.none()
  if let Option<String>.Some { value } = &definition.stdlib {
    configuredLibrary = Option<Bytes>.some(run Bytes.copy(String.ownedUtf8Bytes(&value)))
  }
  let library = run standardLibraryFor(working, &configuredLibrary)
  let testing = match &definition.artifact {
    Option<String>.Some { value } => value.view() == "test"
    Option<String>.None => false
  }
  let mut progress = Progress.off()
  let mut diagnostic = Bytes.make()
  let mut format = DiagnosticFormat.Human { root: run diagnosticRoot(Projects.manifest(&project)) }
  if let Option<Bytes>.Some { value } = move run HostInput.variableNamed("SILK_RECEIPTS") {
    if value.length() > 0 {
      format = DiagnosticFormat.Machine
    }
  }
  // A graph resolves its compilation again after each edit. The load reads unchanged files'
  // imports from the cache its compilation keeps (`compileRequest`) instead of parsing them.
  let mut imports = Option<Path>.none()
  let mut stamp = Option<Bytes>.none()
  if let Option<Path>.Some { value: root } = move run graphOutput(output) {
    let name = match &definition.name {
      Option<String>.Some { value } => String.ownedUtf8Bytes(&value)
      Option<String>.None => Projects.name(&project)
    }
    imports = run SemanticCache.directory(&root, name)
    if imports.isSome() { stamp = run CacheStamp.compiler() }
  }
  let prepared = run prepare(
    Projects.entry(&project),
    Option<&Path>.some(Projects.manifest(&project)),
    move library,
    &profile,
    List<Supplied>.make(),
    testing,
    StoreMode.Transient,
    Option<&[u8]>.none(),
    borrowedPath(&imports),
    &stamp,
    &mut ModuleSourceFiles.snapshot(),
    &format,
    &mut diagnostic,
    &mut progress,
    Option<&CompilationRequest>.none(),
    Option<&CompilationDefinition>.some(&definition),
    unsandboxedTools,
    false,
    versions,
  )
  run writeError(diagnostic.asSlice())
  let mut analysis = match move prepared {
    Prepared.Ready { analysis } => move analysis
    Prepared.Finished { status } => {
      return status
    }
  }
  let directory = match move run Path.parent(output) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      fail InvalidSourceRoot {}
    }
  }
  let mut sourcesPath = run RequestText.copy(Path.rawBytes(output))
  run sourcesPath.append(".sources")
  let generated = run Path.make(sourcesPath.view())
  let artifact = match move artifactPath {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Path.join(&directory, "artifact")
  }
  let source = match &definition.settings.root {
    Option<String>.Some { value } => run Path.make(value.view())
    Option<String>.None => run Path.fromBytes(Path.rawBytes(Projects.entry(&project)))
  }
  let emit = match &definition.settings.emit {
    Option<String>.Some { value } => value.view()
    Option<String>.None => "final"
  }
  let mut request = run RequestCapture.make(
    &analysis.sources,
    &source,
    &artifact,
    &generated,
    &profile,
    definition.settings.profile.maxMemory,
    definition.settings.profile.stackSize,
    testing,
    emit,
  )
  if !definition.name.isSome() {
    request.name = run RequestText.copy(Projects.name(&project))
  }
  if let Option<Bytes>.Some { value: failure } = move run NativeArchives.ensure(
    ModuleSourceFiles.archives(&analysis.sources),
    ModuleSourceFiles.nativeLinkInputs(&analysis.sources),
  ) {
    run writeError(b"silk resolve: ")
    run writeError(failure.asSlice())
    run writeError(b"\n")
    return 2
  }
  if Target.id(InitialProfile.target(&profile)) == TargetId.Wasm32Wasip2 {
    let mut library = Option<Path>.none()
    if let Option<&Path>.Some { value } = move ModuleSourceFiles.standardLibrary(
      &analysis.sources,
    ) {
      library = Option<Path>.some(run Path.fromBytes(Path.rawBytes(value)))
    }
    let world = if testing {
      run WasiTools.commandWorld(&library)
    } else {
      run WasiTools.world(&project, &library)
    }
    run RequestCapture.wasm(&mut request, &world)
  }
  run RequestParameters.capture(
    &mut request,
    &analysis.sources,
    &mut analysis.store,
    &mut analysis.request,
  )
  run CompilationDefinitions.finish(&mut request, move definition)
  if !run capturePlatform(&mut request, &profile) {
    return 2
  }
  run RequestCapture.write(&request, output)
  return 0
}

effect fn planProject(working: &Path, options: ProjectOptions, indexName: string) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types {
  let selection = match move run selectProjects(working, &options) {
    Option<Selection>.Some { value } => move value
    Option<Selection>.None => {
      return 2
    }
  }
  let projects = selection.projects.asSlice()
  let mut sets = List<RequestCapture.Set>.make()
  let mut status = 0
  let mut at: usize = 0
  while at < projects.length {
    let project = &projects[at]
    let mut plans = match move run projectPlans(&options) {
      Option<List<ProjectPlan>>.Some { value } => move value
      Option<List<ProjectPlan>>.None => {
        return 2
      }
    }
    let mut requests = List<String>.make()
    let directory = run Path.join(Projects.outputDirectory(project), "requests")
    while plans.length() > 0 {
      let plan = plans.remove(0)
      let initial = run InitialProfile.freeze(&plan.input)
      let target = Target.name(InitialProfile.target(&initial))
      let mut settings = DefinitionSettings.make()
      settings.profile.target = Option<String>.some(run RequestText.copy(target))
      if let Option<Bytes>.Some { value } = &plan.input.optimization {
        settings.profile.optimization = Option<String>.some(run RequestText.copy(value.asSlice()))
      }
      settings.profile.debug = plan.input.debug
      if let Option<Bytes>.Some { value } = &plan.input.backend {
        settings.profile.backend = Option<String>.some(run RequestText.copy(value.asSlice()))
      }
      let mut library = Option<String>.none()
      if let Option<Bytes>.Some { value } = &options.standardLibrary {
        let path = run pathArgument(working, value.asSlice())
        library = Option<String>.some(run RequestText.copy(Path.rawBytes(&path)))
      }
      let definition = CompilationDefinition {
        manifest: run RequestText.copy(Path.rawBytes(Projects.manifest(project))),
        name: Option<String>.none(),
        artifact: Option<String>.none(),
        stdlib: move library,
        settings: move settings,
        packages: Dictionary<DefinitionPackage>.make(),
      }
      let optimization = match move InitialProfile.text(&initial, b"optimization") {
        Option<&[u8]>.Some { value } => value
        Option<&[u8]>.None => b"none"
      }
      let name = run CompilationRequest.requestFileName(
        unsafe Intrinsic.stringFromUtf8Unchecked(Projects.name(project)),
        unsafe Intrinsic.stringFromUtf8Unchecked(target),
        unsafe Intrinsic.stringFromUtf8Unchecked(optimization),
      )
      let output = run Path.join(&directory, name.view())
      run requests.append(move name)
      let mode = Projects.mode(optimization)
      let artifact = run Projects.artifact(project, target, mode)
      status = worse(
        status,
        run resolveCompilation(
          working,
          move definition,
          &output,
          Option<Path>.some(move artifact),
          options.standard.unsandboxedTools,
          run versionPolicy(options.ignoreSilkVersion),
        ),
      )
    }
    run RequestCapture.extend(&mut sets, &directory, move requests)
    at = at + 1
  }
  if status == 0 {
    run RequestCapture.publishSets(move sets, indexName)
  }
  return status
}

effect fn taskFallback(
  working: &Path,
  options: &ProjectOptions,
  arguments: &[Bytes],
  tests: &mut TestSelection,
) -> i32
  ! ApplicationError
    | InitialProfileProblem
    | FileError
    | ProcessError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Types | &mut Writer {
  if ProjectCommands.asksHelp(Slice.view(arguments, 1, arguments.length - 1)) {
    let json = ProjectCommands.asksHelpJson(Slice.view(arguments, 1, arguments.length - 1))
    drop run writeCommandHelp(arguments[0].asSlice(), json)
    return 0
  }
  let mut forwarded = List<Bytes>.make()
  if let Option<Bytes>.Some { value } = &options.manifestPath {
    run forwarded.append(run Bytes.copy(b"--manifest-path"))
    run forwarded.append(run Bytes.copy(value.asSlice()))
  }
  if let Option<Bytes>.Some { value } = &options.standardLibrary {
    run forwarded.append(run Bytes.copy(b"--stdlib"))
    run forwarded.append(run Bytes.copy(value.asSlice()))
  }
  if let Option<Bytes>.Some { value } = &options.clang {
    run forwarded.append(run Bytes.copy(b"--clang"))
    run forwarded.append(run Bytes.copy(value.asSlice()))
  }
  if let Option<Bytes>.Some { value } = &options.backend {
    run forwarded.append(run Bytes.copy(b"--backend"))
    run forwarded.append(run Bytes.copy(value.asSlice()))
  }
  if let Option<Bytes>.Some { value } = &options.progress {
    run forwarded.append(run Bytes.copy(b"--progress"))
    run forwarded.append(run Bytes.copy(value.asSlice()))
  }
  if options.quiet {
    run forwarded.append(run Bytes.copy(b"--quiet"))
  }
  if options.ignoreWarnings {
    run forwarded.append(run Bytes.copy(b"--ignore-warnings"))
  }
  if options.workspace {
    run forwarded.append(run Bytes.copy(b"--workspace"))
  }
  let packages = options.packages.asSlice()
  let mut package: usize = 0
  while package < packages.length {
    run forwarded.append(run Bytes.copy(b"--package"))
    run forwarded.append(run Bytes.copy(packages[package].asSlice()))
    package = package + 1
  }
  let mut at: usize = 1
  while at < arguments.length {
    run forwarded.append(run Bytes.copy(arguments[at].asSlice()))
    at = at + 1
  }
  let name = arguments[0].asSlice()
  if same(name, b"build") {
    let parsed = match move run Effect.result(ProjectCommands.parseBuild(forwarded.asSlice())) {
      Result<BuildCommand, InvalidProjectCommand | OutOfMemoryError>.Success { value } => move value
      Result<BuildCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {
        error
      } => match move error {
        InvalidProjectCommand invalid => {
          run writeError(invalid.reason.asSlice())
          run writeError(b"\n")
          return 2
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    return run buildProject(working, move parsed, false)
  }
  if same(name, b"run") {
    let parsed = match move run Effect.result(ProjectCommands.parseRun(forwarded.asSlice())) {
      Result<RunCommand, InvalidProjectCommand | OutOfMemoryError>.Success { value } => move value
      Result<RunCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {
        error
      } => match move error {
        InvalidProjectCommand invalid => {
          run writeError(invalid.reason.asSlice())
          run writeError(b"\n")
          return 2
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    return run runProject(working, move parsed, false)
  }
  if same(name, b"test") {
    let parsed = match move run Effect.result(ProjectCommands.parseTest(forwarded.asSlice())) {
      Result<TestCommand, InvalidProjectCommand | OutOfMemoryError>.Success { value } => move value
      Result<TestCommand, InvalidProjectCommand | OutOfMemoryError>.Failure {
        error
      } => match move error {
        InvalidProjectCommand invalid => {
          run writeError(invalid.reason.asSlice())
          run writeError(b"\n")
          return 2
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    return run testProject(working, move parsed, &mut tests.*, false)
  }
  if same(name, b"plan") {
    let parsed = match move run Effect.result(ProjectCommands.parsePlan(forwarded.asSlice())) {
      Result<ProjectCommands.Plan, InvalidProjectCommand | OutOfMemoryError>.Success {
        value
      } => move value
      Result<ProjectCommands.Plan, InvalidProjectCommand | OutOfMemoryError>.Failure {
        error
      } => match move error {
        InvalidProjectCommand invalid => {
          run writeError(invalid.reason.asSlice())
          run writeError(b"\n")
          return 2
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    return run planProject(working, move parsed.options, ".pending-plan.json")
  }
  return 2
}

effect fn packagePath(working: &Path, command: ProjectCommands.PackagePath) -> i32
  ! ApplicationError
    | FileError
    | HostInputError
    | InvalidDependency
    | InvalidNativeLinkInput
    | TomlError
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator | &mut Writer {
  let manifest = run pathArgument(working, command.manifest.asSlice())
  let directory = match move run Path.parent(&manifest) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return 2
    }
  }
  let contents = run FileSystem.readFile(&manifest)
  let document = run Toml.parse(contents.asSlice())
  let root = run rootPackage(&directory, &document)
  let store = run GitCheckouts.store()
  let mut packages = run PackageSources.load(
    &directory,
    move document,
    root.identity.asSlice(),
    &root.sourceRoot,
    borrowedPath(&store),
    run ModuleSourceFiles.archiveContext(borrowedPath(&store), Target.name(&hostTarget())),
    run versionPolicy(false),
  )
  let path = run PackageSources.includedPath(
    &mut packages,
    command.dependency.asSlice(),
    command.path.asSlice(),
  )
  let mut encoded = Bytes.make()
  run JsonText.appendString(&mut encoded, Path.rawBytes(&path))
  run encoded.append(b"\n")
  let mut stdout = StdoutWriter.make()
  run Writer.writeAll(encoded.asSlice()) |> Effect.provideMut<Writer>(&mut stdout)
  return 0
}

effect fn fetchManifest(manifest: &Path, store: &Path) -> ()
  ! FileError | HostInputError | InvalidDependency | TomlError | OutOfMemoryError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let contents = run FileSystem.readFile(manifest)
  let document = run Toml.parse(contents.asSlice())
  if let Option<Path>.Some { value: directory } = move run Path.parent(manifest) {
    run PackageSources.fetch(&directory, &document, store)
  }
}

effect fn fetchProject(working: &Path, command: ProjectCommands.Fetch) -> i32
  ! ApplicationError
    | FileError
    | HostInputError
    | InvalidDependency
    | TomlError
    | OutOfMemoryError
    | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let discovered = run Effect.result(manifestFor(working, &command.manifestPath))
  let manifest = match move discovered {
    Result<Path, ApplicationError | ProjectError | FileError | OutOfMemoryError>.Success {
      value
    } => move value
    Result<Path, ApplicationError | ProjectError | FileError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      ProjectError problem => {
        run reportProject(&problem)
        return 2
      }
      ApplicationError failed => {
        fail move failed
      }
      FileError failed => {
        fail move failed
      }
      OutOfMemoryError failed => {
        fail move failed
      }
    }
  }
  let store = match move run GitCheckouts.store() {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      run writeError(b"silk fetch: SILK_HOME or HOME must name an absolute directory\n")
      return 2
    }
  }
  let workspace = match move run Effect.result(Projects.workspace(&manifest)) {
    Result<Option<Workspace>, ProjectError | FileError | OutOfMemoryError>.Success {
      value
    } => move value
    Result<Option<Workspace>, ProjectError | FileError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      ProjectError problem => {
        run reportProject(&problem)
        return 2
      }
      FileError failed => {
        fail move failed
      }
      OutOfMemoryError failed => {
        fail move failed
      }
    }
  }
  run fetchManifest(&manifest, &store)
  if let Option<Workspace>.Some { value } = &workspace {
    let members = value.members.asSlice()
    let mut at: usize = 0
    while at < members.length {
      let member = run Path.join(&members[at].directory, "silk.toml")
      run fetchManifest(&member, &store)
      at = at + 1
    }
  }
  return 0
}
