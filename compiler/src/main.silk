/// A command-line contract failure before source reading begins.
pub union ApplicationError {
  InvalidArgumentCount {pub actual: usize},
  InvalidWorkingDirectoryEncoding,
  InvalidBuildProfile,
}

effect fn invalidArgumentCount(actual: usize) -> never ! ApplicationError {
  fail ApplicationError.InvalidArgumentCount {actual: actual}
}

effect fn invalidWorkingDirectoryEncoding() -> never ! ApplicationError {
  fail ApplicationError.InvalidWorkingDirectoryEncoding
}

/// The requested final artifact. LLVM text is the completed backend answer, before linking.
enum BuildOutput {
  Executable,
  LlvmIr,
}

/// One parsed command line: the source file to read and the requested artifact or dump.
union Request {
  Dump {source: Bytes, hir: bool},
  Build {source: Bytes, output: Bytes, kind: BuildOutput, standardLibrary: Option<Bytes>, profile: FinalProfile},
}

/// Reports whether `argument` spells the `hir` mode selector.
fn selectsHir(argument: &[u8]) -> bool {
  let wanted = String.utf8Bytes("hir")
  if argument.length != wanted.length {
    return false
  }
  let mut index = usize.ZERO
  while index < argument.length {
    if argument[index] != wanted[index] {
      return false
    }
    index = index + usize.ONE
  }
  return true
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn argumentAt(index: usize, count: usize) -> Bytes
! ApplicationError | HostInputError | OutOfMemoryError
? &mut HostInput | &mut Allocator {
  let found = run HostInput.argument(index)
  return match move found {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => run invalidArgumentCount(count)
  }
}

effect fn invalidBuildProfile() -> never ! ApplicationError {
  fail ApplicationError.InvalidBuildProfile
}

/// Reads `build <source> -o <output> [--emit executable|llvm-ir]` and dump modes.
effect fn request() -> Request
! ApplicationError | InitialProfileProblem | HostInputError | OutOfMemoryError
? &mut HostInput | &mut Allocator {
  let count = run HostInput.argumentCount()
  if count == usize.add(0, 2) {
    let source = run argumentAt(usize.ONE, count)
    return Request.Dump {source: move source, hir: false}
  }
  if count >= usize.add(0, 5) {
    let mode = run argumentAt(usize.ONE, count)
    let source = run argumentAt(usize.add(0, 2), count)
    let selector = run argumentAt(usize.add(0, 3), count)
    let output = run argumentAt(usize.add(0, 4), count)
    if !same(Bytes.asSlice(&mode), b"build") || !same(Bytes.asSlice(&selector), b"-o") {
      return run invalidArgumentCount(count)
    }
    let mut standardLibrary = Option.none<Bytes>()
    let mut input = ProfileInput.make()
    let target = hostTarget()
    input.target = Option.some<Bytes>(run Bytes.copy(Target.name(&target)))
    input.optimization = Option.some<Bytes>(run Bytes.copy(b"speed"))
    input.debug = Option.some<bool>(false)
    let mut hasStdlib = false
    let mut hasOptimization = false
    let mut hasDebug = false
    let mut hasEmit = false
    let mut kind = BuildOutput.Executable
    let mut at = usize.add(0, 5)
    while at < count {
      if at + usize.ONE >= count {
        return run invalidArgumentCount(count)
      }
      let selector = run argumentAt(at, count)
      let value = run argumentAt(at + usize.ONE, count)
      if same(Bytes.asSlice(&selector), b"--emit") && !hasEmit {
        if same(Bytes.asSlice(&value), b"llvm-ir") {
          kind = BuildOutput.LlvmIr
        } else if !same(Bytes.asSlice(&value), b"executable") {
          return run invalidArgumentCount(count)
        }
        hasEmit = true
      } else if same(Bytes.asSlice(&selector), b"--stdlib") && !hasStdlib {
        standardLibrary = Option.some<Bytes>(move value)
        hasStdlib = true
      } else if same(Bytes.asSlice(&selector), b"--optimization") && !hasOptimization {
        input.optimization = Option.some<Bytes>(move value)
        hasOptimization = true
      } else if same(Bytes.asSlice(&selector), b"--debug") && !hasDebug {
        if same(Bytes.asSlice(&value), b"true") {
          input.debug = Option.some<bool>(true)
        } else if same(Bytes.asSlice(&value), b"false") {
          input.debug = Option.some<bool>(false)
        } else {
          return run invalidBuildProfile()
        }
        hasDebug = true
      } else {
        return run invalidArgumentCount(count)
      }
      at = at + usize.add(0, 2)
    }
    let initial = run InitialProfile.freeze(&input)
    let schemas = Vector.make<RegisteredShape>()
    let published = run FinalProfile.publish(
      move initial, Vector.asSlice<RegisteredShape>(&schemas), Vector.make<ProfileEntry>(),
    )
    let profile = match move published {
      Result<FinalProfile, FinalProfileProblem>.Success {value} => move value
      Result<FinalProfile, FinalProfileProblem>.Failure {error: _} => run invalidBuildProfile()
    }
    return Request.Build {
      source: move source, output: move output, standardLibrary: move standardLibrary,
      profile: move profile, kind: kind,
    }
  }
  if count != usize.add(0, 3) {
    return run invalidArgumentCount(count)
  }
  let mode = run argumentAt(usize.ONE, count)
  if !selectsHir(Bytes.asSlice(&mode)) {
    drop mode
    return run invalidArgumentCount(count)
  }
  drop mode
  let source = run argumentAt(usize.add(0, 2), count)
  return Request.Dump {source: move source, hir: true}
}

effect fn lex<'source>(lexer: &mut Lexer<'source>) -> Vector<Token>
! OutOfMemoryError
? &mut Allocator {
  let mut tokens = Vector.make<Token>()
  while true {
    let taken = run Stream.take(lexer)
    if let Option<Token>.Some {value} = move taken {
      run Vector.append<Token>(&mut tokens, move value)
    } else {
      break
    }
  }
  return move tokens
}

static if Intrinsic.targetOperatingSystem() == "darwin" {
  fn hostTarget() -> Target {
    return Target.forId(TargetId.Aarch64AppleDarwin)
  }
} else {
  static if Intrinsic.targetArchitecture() == "aarch64" {
    fn hostTarget() -> Target {
      return Target.forId(TargetId.Aarch64UnknownLinuxGnu)
    }
  } else {
    fn hostTarget() -> Target {
      return Target.forId(TargetId.X8664UnknownLinuxGnu)
    }
  }
}

effect fn gapSummary(gaps: &[Shared<Gap>]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut message = run Bytes.copy(b"SILK_UNSUPPORTED_JSON={\"gaps\":[")
  let mut at = usize.ZERO
  while at < gaps.length {
    if at > usize.ZERO {
      run Bytes.append(&mut message, b",")
    }
    let code = Shared.with<Gap, GapCode>(
      &gaps[at],
      fn(gap: &Gap) -> GapCode {
        return gap.code
      },
    )
    let span = Shared.with<Gap, Span>(
      &gaps[at],
      fn(gap: &Gap) -> Span {
        return Gap.span(gap)
      },
    )
    let owner = Shared.with<Gap, Shared<DeclarationId>>(
      &gaps[at],
      fn(gap: &Gap) -> Shared<DeclarationId> {
        return Shared.clone<DeclarationId>(&gap.owner)
      },
    )
    let key = run InstanceKey.named(&owner)
    let symbol = run InstanceKey.runtimeName(&key)
    run Bytes.append(&mut message, b"{\"code\":\"")
    run Bytes.append(&mut message, Gap.name(code))
    run Bytes.append(&mut message, b"\",\"reason\":\"Reached in ")
    run Bytes.append(&mut message, Bytes.asSlice(&symbol))
    run Bytes.append(&mut message, b" at bytes ")
    run JsonText.appendDecimal(&mut message, span.start)
    run Bytes.append(&mut message, b"-")
    run JsonText.appendDecimal(&mut message, span.end)
    let gap = Shared.with<Gap, Gap>(&gaps[at], fn(value: &Gap) -> Gap { return Gap.copy(value) })
    let sourcePath = run Gap.sourcePath(&gap)
    run Bytes.append(&mut message, b"\",\"source\":{\"module\":")
    run JsonText.appendString(&mut message, Bytes.asSlice(&sourcePath))
    run Bytes.append(&mut message, b",\"span\":{\"start\":")
    run JsonText.appendDecimal(&mut message, span.start)
    run Bytes.append(&mut message, b",\"end\":")
    run JsonText.appendDecimal(&mut message, span.end)
    run Bytes.append(&mut message, b"}}}")
    at = at + usize.ONE
  }
  run Bytes.append(&mut message, b"]}\n")
  return move message
}

effect fn rejectionSummary(diagnostic: &Shared<Rejection>) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let code = Shared.with<Rejection, RejectionCode>(diagnostic, fn(rejection: &Rejection) -> RejectionCode {
    return rejection.code
  })
  let span = Shared.with<Rejection, Span>(diagnostic, fn(rejection: &Rejection) -> Span {
    return rejection.span
  })
  let mut message = run Bytes.copy(b"SILK_BUILD_ERROR={\"code\":\"")
  run Bytes.append(&mut message, Rejection.name(code))
  run Bytes.append(&mut message, b"\",\"span\":{\"start\":")
  run JsonText.appendDecimal(&mut message, span.start)
  run Bytes.append(&mut message, b",\"end\":")
  run JsonText.appendDecimal(&mut message, span.end)
  // The rejected source's logical module, which may be an imported or standard-library module.
  let length = Shared.with<Rejection, usize>(diagnostic, fn(rejection: &Rejection) -> usize {
    return ModuleId.logicalPath(&rejection.module).length
  })
  let mut path = run Bytes.zeroed(length)
  let target = Bytes.asMutSlice(&mut path)
  let mut at = usize.ZERO
  while at < length {
    target[at] = Shared.with<Rejection, u8>(diagnostic, fn(rejection: &Rejection) -> u8 { return ModuleId.logicalPath(&rejection.module)[at] })
    at = at + usize.ONE
  }
  run Bytes.append(&mut message, b"},\"module\":")
  run JsonText.appendString(&mut message, Bytes.asSlice(&path))
  run Bytes.append(&mut message, b"}\n")
  return move message
}

effect fn writeError(bytes: &[u8]) -> () ! WriterError {
  let mut stderr = StderrWriter.make()
  return run Writer.writeAll(bytes)
    |> Effect.provideMut<Writer>(&mut stderr)
}

effect fn compileIr(ir: &Bytes, output: &Path, outputArgument: &[u8], optimization: &[u8], debug: bool, target: &Target, linkInputs: &[NativeLinkInput]) -> i32
! FileError | ProcessError | HostInputError | InvalidNativeLinkInput | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let mut intermediate = run Bytes.copy(outputArgument)
  run Bytes.append(&mut intermediate, b".silkc.ll")
  let mut portableIntermediate = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut portableIntermediate, b".silkc.ll")
  let irPath = run Path.fromBytes(Bytes.asSlice(&portableIntermediate))
  let configured = run HostInput.variableNamed("SILKC_CLANG")
  let clang = match move configured {
    Option<Bytes>.Some {value} => run Path.fromBytes(Bytes.asSlice(&value))
    Option<Bytes>.None => run Path.make("/usr/bin/clang")
  }
  let mut process = run ChildProcess.request(&clang)
  let mut optimizationFlag: &[u8] = b"-O0"
  if same(optimization, b"speed") {
    optimizationFlag = b"-O2"
  }
  run ChildProcess.addArgument(&mut process, optimizationFlag)
  if debug {
    run ChildProcess.addArgument(&mut process, b"-g")
  }
  run ChildProcess.addArgument(&mut process, b"-x")
  run ChildProcess.addArgument(&mut process, b"ir")
  run ChildProcess.addArgument(&mut process, Bytes.asSlice(&intermediate))
  // Restore extension-based input kinds so declared objects and archives are not read as IR.
  run ChildProcess.addArgument(&mut process, b"-x")
  run ChildProcess.addArgument(&mut process, b"none")
  run ChildProcess.addArgument(&mut process, b"-o")
  run ChildProcess.addArgument(&mut process, outputArgument)
  // Declared inputs precede the C libraries so their own references to libc and libm resolve.
  let mut input = usize.ZERO
  while input < linkInputs.length {
    run NativeLinkInputs.appendArguments(&linkInputs[input], target, &mut process)
    input = input + usize.ONE
  }
  run ChildProcess.addArgument(&mut process, b"-lc")
  run ChildProcess.addArgument(&mut process, b"-lm")
  let use = effect fn(resource: &mut Path) -> i32
  ! FileError | ProcessError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut Allocator {
    run FileSystem.writeFile(&resource.*, Bytes.asSlice(ir))
    let outcome = run ChildProcess.submit(&process)
    return match move ChildProcess.exitCode(&outcome) {
      Option<i32>.Some {value} => {
        if value == 0 {
          return 0
        }
        run writeError(ChildProcess.errorBytes(&outcome))
        return 1
      }
      Option<i32>.None => {
        run writeError(ChildProcess.errorBytes(&outcome))
        return 1
      }
    }
  }
  let release = effect fn(resource: &mut Path) -> () ? &mut FileSystem {
    let removed = run Effect.result(FileSystem.removeFile(&resource.*))
    drop removed
    return ()
  }
  return run Effect.useReleaseNonParking(move irPath, move use, move release)
}

// Builds from the selected runtime's C exports, or from the generated C entry of `main` when the
// package selects no runtime.
effect fn buildRoots(store: &mut Semantic, request: &mut SemanticRequest, application: &ModuleId, runtime: &Option<ModuleId>) -> BackendBuild
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  return match &runtime.* {
    Option<ModuleId>.Some {value} => run Semantic.buildRuntime(&mut store.*, &mut request.*, &value, staticClosureNodes)
    Option<ModuleId>.None => run Semantic.buildMain(&mut store.*, &mut request.*, application, staticClosureNodes)
  }
}

effect fn build(sourcePath: &Path, output: &Path, outputArgument: &[u8], kind: BuildOutput, standardLibrary: Option<Path>, profile: FinalProfile) -> i32
! ApplicationError | FileError | ProcessError | HostInputError | InvalidModulePath | InvalidSourceRoot | InvalidBuildComposition | InvalidNativeLinkInput | TomlError | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let mut sources = run ModuleSourceFiles.make(sourcePath, move standardLibrary)
  let identity = run ModuleId.copy(ModuleSourceFiles.entry(&sources))
  let runtime = match move ModuleSourceFiles.runtime(&sources) {
    Option<&ModuleId>.Some {value} => Option.some<ModuleId>(run ModuleId.copy(value))
    Option<&ModuleId>.None => Option.none<ModuleId>()
  }
  let target = FinalProfile.target(&profile)
  let optimization = match move FinalProfile.text(&profile, b"optimization") {
    Option<&[u8]>.Some {value} => run Bytes.copy(value)
    Option<&[u8]>.None => run invalidBuildProfile()
  }
  let debug = match move FinalProfile.flag(&profile, b"debug") {
    Option<bool>.Some {value} => value
    Option<bool>.None => run invalidBuildProfile()
  }
  let mut store = Semantic.make(run ModuleSourceFiles.revision(&sources), target, Option.some<FinalProfile>(move profile))
  let mut request = SemanticRequest.forApplication(run ModuleId.copy(&identity))
  let mut compiled = run buildRoots(&mut store, &mut request, &identity, &runtime)
  while run ModuleSourceFiles.publishObserved(&mut sources, Semantic.sourceEvents(&store)) {
    Semantic.revise(&mut store, run ModuleSourceFiles.revision(&sources))
    request = SemanticRequest.forApplication(run ModuleId.copy(&identity))
    compiled = run buildRoots(&mut store, &mut request, &identity, &runtime)
  }
  return match move compiled {
    BackendBuild.Module {text, uncheckedBodies, ..} => {
      if uncheckedBodies > usize.ZERO {
        let mut message = run Bytes.copy(b"SILK_GAP borrow-check: ")
        run JsonText.appendDecimal(&mut message, uncheckedBodies)
        run Bytes.append(
          &mut message,
          b" bodies not borrow-checked (native borrow checking is roadmap step 14)\n",
        )
        run writeError(Bytes.asSlice(&message))
      }
      if kind == BuildOutput.LlvmIr {
        run FileSystem.writeFile(output, Bytes.asSlice(&text))
        return 0
      }
      return run compileIr(
        &text, output, outputArgument, Bytes.asSlice(&optimization), debug, &target,
        ModuleSourceFiles.nativeLinkInputs(&sources),
      )
    }
    BackendBuild.Unsupported {gaps} => {
      let message = run gapSummary(Vector.asSlice<Shared<Gap>>(&gaps))
      run writeError(Bytes.asSlice(&message))
      return 2
    }
    BackendBuild.Rejected {first, further, gaps} => {
      // Every refusal the walk reached, first one first, then the gaps reached beside them.
      let message = run rejectionSummary(&first)
      run writeError(Bytes.asSlice(&message))
      let others = Vector.asSlice<Shared<Rejection>>(&further)
      let mut at = usize.ZERO
      while at < others.length {
        let next = run rejectionSummary(&others[at])
        run writeError(Bytes.asSlice(&next))
        at = at + usize.ONE
      }
      if Vector.length<Shared<Gap>>(&gaps) > usize.ZERO {
        let summary = run gapSummary(Vector.asSlice<Shared<Gap>>(&gaps))
        run writeError(Bytes.asSlice(&summary))
      }
      return 1
    }
  }
}

effect fn fileArgument(base: &Path, argument: &[u8]) -> Path
! FileError | OutOfMemoryError ? &mut Allocator {
  if argument.length > usize.ZERO && argument[usize.ZERO] == 47 {
    return run Path.fromBytes(argument)
  }
  return run Path.joinBytes(base, argument)
}

effect fn program() -> i32
! ApplicationError | InitialProfileProblem | HostInputError | OutOfMemoryError | FileError | WriterError | ProcessError | InvalidModulePath | InvalidSourceRoot | InvalidBuildComposition | InvalidNativeLinkInput | TomlError | Cycle | RevisionMismatch
? &mut HostInput | &mut Allocator | &mut Writer {
  let captured = run Effect.result(HostInput.argument(usize.ONE))
  let selector = match move captured {
    Result<Option<Bytes>, HostInputError | OutOfMemoryError>.Success {value: argument} => move argument
    Result<Option<Bytes>, HostInputError | OutOfMemoryError>.Failure {error: _} => {
      let mut diagnostics = StderrWriter.make()
      let reported = run Effect.result(Writer.writeAll(b"silkc: cannot read command argument\n")
        |> Effect.provideMut<Writer>(&mut diagnostics))
      drop reported
      return 2
    }
  }
  if let Option<Bytes>.Some {value} = move selector {
    if same(Bytes.asSlice(&value), b"format") {
      let mut diagnostics = StderrWriter.make()
      let initialized = run Effect.result(OsFileSystem.make(b"/"))
      let mut files = match move initialized {
        Result<OsFileSystem, OutOfMemoryError>.Success {value: provider} => move provider
        Result<OsFileSystem, OutOfMemoryError>.Failure {error: _} => {
          let reported = run Effect.result(Writer.writeAll(b"silkc format: cannot initialize filesystem\n")
            |> Effect.provideMut<Writer>(&mut diagnostics))
          drop reported
          return 2
        }
      }
      return run FormatCommand.runHost()
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<Writer>(&mut diagnostics)
    }
  }
  let command = run request()
  let workingDirectory = run HostInput.workingDirectory()
  let validated = match move HostInput.text(Bytes.asSlice(&workingDirectory)) {
    Result<string, InvalidUtf8>.Success {value: _} => ()
    Result<string, InvalidUtf8>.Failure {error: _} => run invalidWorkingDirectoryEncoding()
  }
  let mut files = run OsFileSystem.make(b"/")
  let working = run Path.fromBytes(Bytes.asSlice(&workingDirectory))
  return match move command {
    Request.Build {source, output, kind, standardLibrary: configured, profile} => {
      let sourcePath = run fileArgument(&working, Bytes.asSlice(&source))
      let outputPath = run fileArgument(&working, Bytes.asSlice(&output))
      let standardLibrary = match move configured {
        Option<Bytes>.Some {value} => Option.some<Path>(run fileArgument(&working, Bytes.asSlice(&value)))
        Option<Bytes>.None => Option.none<Path>()
      }
      let mut process = OsChildProcess.make()
      return run build(&sourcePath, &outputPath, Bytes.asSlice(&output), kind, move standardLibrary, move profile)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.Dump {source: argument, hir: dumpHir} => {
      let path = run fileArgument(&working, Bytes.asSlice(&argument))
      let source = run FileSystem.readFile(&path)
        |> Effect.provideMut<FileSystem>(&mut files)
      let mut lexer = Lexer.make(Bytes.asSlice(&source))
      let tokens = run lex(&mut lexer)
      let tree = run Parser.parse(move source, move tokens)
      if dumpHir {
        let module = run Lower.lower(&tree)
        run Hir.write(&module)
        run Fingerprint.writeFingerprints(&module)
        run Hir.writeViolations(&module)
        return 0
      }
      run SyntaxTree.write(&tree)
      return 0
    }
  }
}

pub effect fn main() -> i32
! ApplicationError | InitialProfileProblem | HostInputError | OutOfMemoryError | FileError | WriterError | ProcessError | InvalidModulePath | InvalidSourceRoot | InvalidBuildComposition | InvalidNativeLinkInput | TomlError | Cycle | RevisionMismatch
? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut output = StdoutWriter.make()
  return run program()
    |> Effect.provideMut<Allocator>(&mut allocator)
    |> Effect.provideMut<Writer>(&mut output)
}
