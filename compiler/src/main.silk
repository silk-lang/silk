effect fn appendDecimal(output: &mut Bytes, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut reversed = Vector.make<u8>()
  let mut remaining = usize.toU64(value)
  if remaining == 0 {
    return run Bytes.append(&mut output.*, b"0")
  }
  while remaining > 0 {
    run Vector.append<u8>(&mut reversed, u64.toU8(48 + u64.remainder(remaining, 10)))
    remaining = u64.divide(remaining, 10)
  }
  let digits = Vector.asSlice<u8>(&reversed)
  let mut at = digits.length
  while at > usize.ZERO {
    at = at - usize.ONE
    run Bytes.append(&mut output.*, &[digits[at]])
  }
  return ()
}

/// A command-line contract failure before source reading begins.
pub union ApplicationError {
  InvalidArgumentCount {pub actual: usize},
  InvalidWorkingDirectoryEncoding,
}

effect fn invalidArgumentCount(actual: usize) -> never ! ApplicationError {
  fail ApplicationError.InvalidArgumentCount {actual: actual}
}

effect fn invalidWorkingDirectoryEncoding() -> never ! ApplicationError {
  fail ApplicationError.InvalidWorkingDirectoryEncoding
}

/// One parsed command line: the source file to read and which dump to print.
union Request {
  Dump {source: Bytes, hir: bool},
  Build {source: Bytes, output: Bytes},
}

/// Reports whether `argument` spells the `hir` mode selector.
fn selectsHir(argument: &[u8]) -> bool {
  let wanted = String.utf8Bytes("hir")
  if argument.length != wanted.length {
    return false
  }
  let mut index = usize.ZERO
  while index < argument.length {
    if argument[index] != wanted[index] {
      return false
    }
    index = index + usize.ONE
  }
  return true
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn argumentAt(index: usize, count: usize) -> Bytes
! ApplicationError | HostInputError | OutOfMemoryError
? &mut HostInput | &mut Allocator {
  let found = run HostInput.argument(index)
  return match move found {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => run invalidArgumentCount(count)
  }
}

/// Reads the command line: `<file>` dumps the syntax tree, `hir <file>` dumps the lowered module.
effect fn request() -> Request
! ApplicationError | HostInputError | OutOfMemoryError
? &mut HostInput | &mut Allocator {
  let count = run HostInput.argumentCount()
  if count == usize.add(0, 2) {
    let source = run argumentAt(usize.ONE, count)
    return Request.Dump {source: move source, hir: false}
  }
  if count == usize.add(0, 5) {
    let mode = run argumentAt(usize.ONE, count)
    let source = run argumentAt(usize.add(0, 2), count)
    let selector = run argumentAt(usize.add(0, 3), count)
    let output = run argumentAt(usize.add(0, 4), count)
    if !same(Bytes.asSlice(&mode), b"build") || !same(Bytes.asSlice(&selector), b"-o") {
      return run invalidArgumentCount(count)
    }
    return Request.Build {source: move source, output: move output}
  }
  if count != usize.add(0, 3) {
    return run invalidArgumentCount(count)
  }
  let mode = run argumentAt(usize.ONE, count)
  if !selectsHir(Bytes.asSlice(&mode)) {
    drop mode
    return run invalidArgumentCount(count)
  }
  drop mode
  let source = run argumentAt(usize.add(0, 2), count)
  return Request.Dump {source: move source, hir: true}
}

effect fn lex<'source>(lexer: &mut Lexer<'source>) -> Vector<Token>
! OutOfMemoryError
? &mut Allocator {
  let mut tokens = Vector.make<Token>()
  while true {
    let taken = run Stream.take(lexer)
    if let Option<Token>.Some {value} = move taken {
      run Vector.append<Token>(&mut tokens, move value)
    } else {
      break
    }
  }
  return move tokens
}

static if Intrinsic.targetOperatingSystem() == "darwin" {
  fn hostTarget() -> Target {
    return Target.forId(TargetId.Aarch64AppleDarwin)
  }
} else {
  static if Intrinsic.targetArchitecture() == "aarch64" {
    fn hostTarget() -> Target {
      return Target.forId(TargetId.Aarch64UnknownLinuxGnu)
    }
  } else {
    fn hostTarget() -> Target {
      return Target.forId(TargetId.X8664UnknownLinuxGnu)
    }
  }
}

effect fn gapSummary(gaps: &[Shared<Gap>]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut message = run Bytes.copy(b"SILK_UNSUPPORTED_JSON={\"gaps\":[")
  let mut at = usize.ZERO
  while at < gaps.length {
    if at > usize.ZERO {
      run Bytes.append(&mut message, b",")
    }
    let code = Shared.with<Gap, GapCode>(
      &gaps[at],
      fn(gap: &Gap) -> GapCode {
        return gap.code
      },
    )
    let span = Shared.with<Gap, Span>(
      &gaps[at],
      fn(gap: &Gap) -> Span {
        return gap.span
      },
    )
    let owner = Shared.with<Gap, Shared<DeclarationId>>(
      &gaps[at],
      fn(gap: &Gap) -> Shared<DeclarationId> {
        return Shared.clone<DeclarationId>(&gap.owner)
      },
    )
    let key = InstanceKey.Function {declaration: move owner}
    let symbol = run InstanceKey.symbol(&key)
    run Bytes.append(&mut message, b"{\"code\":\"")
    run Bytes.append(&mut message, Gap.name(code))
    run Bytes.append(&mut message, b"\",\"reason\":\"Reached in ")
    run Bytes.append(&mut message, Bytes.asSlice(&symbol))
    run Bytes.append(&mut message, b" at bytes ")
    run appendDecimal(&mut message, span.start)
    run Bytes.append(&mut message, b"-")
    run appendDecimal(&mut message, span.end)
    run Bytes.append(&mut message, b"\"}")
    at = at + usize.ONE
  }
  run Bytes.append(&mut message, b"]}\n")
  return move message
}

effect fn writeError(bytes: &[u8]) -> () ! WriterError {
  let mut stderr = StderrWriter.make()
  return run Writer.writeAll(bytes)
    |> Effect.provideMut<Writer>(&mut stderr)
}

effect fn compileIr(ir: &Bytes, output: &Path, outputArgument: &[u8]) -> i32
! FileError | ProcessError | HostInputError | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let mut intermediate = run Bytes.copy(outputArgument)
  run Bytes.append(&mut intermediate, b".silkc.ll")
  let mut portableIntermediate = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut portableIntermediate, b".silkc.ll")
  let irPath = run Path.fromBytes(Bytes.asSlice(&portableIntermediate))
  let configured = run HostInput.variableNamed("SILKC_CLANG")
  let clang = match move configured {
    Option<Bytes>.Some {value} => run Path.fromBytes(Bytes.asSlice(&value))
    Option<Bytes>.None => run Path.make("/usr/bin/clang")
  }
  let mut process = run ChildProcess.request(&clang)
  run ChildProcess.addArgument(&mut process, b"-x")
  run ChildProcess.addArgument(&mut process, b"ir")
  run ChildProcess.addArgument(&mut process, Bytes.asSlice(&intermediate))
  run ChildProcess.addArgument(&mut process, b"-o")
  run ChildProcess.addArgument(&mut process, outputArgument)
  let use = effect fn(resource: &mut Path) -> i32
  ! FileError | ProcessError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut Allocator {
    run FileSystem.writeFile(&resource.*, Bytes.asSlice(ir))
    let outcome = run ChildProcess.submit(&process)
    return match move ChildProcess.exitCode(&outcome) {
      Option<i32>.Some {value} => {
        if value == 0 {
          return 0
        }
        run writeError(ChildProcess.errorBytes(&outcome))
        return 1
      }
      Option<i32>.None => {
        run writeError(ChildProcess.errorBytes(&outcome))
        return 1
      }
    }
  }
  let release = effect fn(resource: &mut Path) -> () ? &mut FileSystem {
    let removed = run Effect.result(FileSystem.removeFile(&resource.*))
    drop removed
    return ()
  }
  return run Effect.useReleaseNonParking(move irPath, move use, move release)
}

effect fn build(sourcePath: &Path, output: &Path, outputArgument: &[u8]) -> i32
! FileError | ProcessError | HostInputError | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | WriterError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let source = run FileSystem.readFile(sourcePath)
  let identity = run ModuleId.make(b"file", b"executable", b"main.silk")
  let content = Option.some<Bytes>(move source)
  let initial = Revision.make()
  let revision = run Revision.publish(&initial, &identity, &content)
  let mut store = Semantic.make(move revision, hostTarget())
  let mut request = SemanticRequest.make()
  let compiled = run Semantic.buildMain(&mut store, &mut request, &identity)
  return match move compiled {
    BackendBuild.Module {text, uncheckedBodies} => {
      if uncheckedBodies > usize.ZERO {
        let mut message = run Bytes.copy(b"SILK_GAP borrow-check: ")
        run appendDecimal(&mut message, uncheckedBodies)
        run Bytes.append(
          &mut message,
          b" bodies not borrow-checked (native borrow checking is roadmap step 14)\n",
        )
        run writeError(Bytes.asSlice(&message))
      }
      return run compileIr(&text, output, outputArgument)
    }
    BackendBuild.Unsupported {gaps} => {
      let message = run gapSummary(Vector.asSlice<Shared<Gap>>(&gaps))
      run writeError(Bytes.asSlice(&message))
      return 2
    }
    BackendBuild.Rejected {diagnostic: _} => {
      run writeError(b"SILK_BUILD_ERROR=semantic-rejection\n")
      return 1
    }
  }
}

effect fn program() -> i32
! ApplicationError | HostInputError | OutOfMemoryError | FileError | WriterError | ProcessError | InvalidModulePath | Cycle | RevisionMismatch
? &mut HostInput | &mut Allocator | &mut Writer {
  let command = run request()
  let workingDirectory = run HostInput.workingDirectory()
  let validated = match move HostInput.text(Bytes.asSlice(&workingDirectory)) {
    Result<string, InvalidUtf8>.Success {value: _} => ()
    Result<string, InvalidUtf8>.Failure {error: _} => run invalidWorkingDirectoryEncoding()
  }
  let mut files = run OsFileSystem.make(Bytes.asSlice(&workingDirectory))
  let root = run Path.root()
  return match move command {
    Request.Build {source, output} => {
      let sourcePath = run Path.joinUtf8(&root, Bytes.asSlice(&source))
      let outputPath = run Path.joinUtf8(&root, Bytes.asSlice(&output))
      let mut process = OsChildProcess.make()
      return run build(&sourcePath, &outputPath, Bytes.asSlice(&output))
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut process)
    }
    Request.Dump {source: argument, hir: dumpHir} => {
      let path = run Path.joinUtf8(&root, Bytes.asSlice(&argument))
      let source = run FileSystem.readFile(&path)
        |> Effect.provideMut<FileSystem>(&mut files)
      let mut lexer = Lexer.make(Bytes.asSlice(&source))
      let tokens = run lex(&mut lexer)
      let tree = run Parser.parse(move source, move tokens)
      if dumpHir {
        let module = run Lower.lower(&tree)
        run Hir.write(&module)
        run Fingerprint.writeFingerprints(&module)
        run Hir.writeViolations(&module)
        return 0
      }
      run SyntaxTree.write(&tree)
      return 0
    }
  }
}

pub effect fn main() -> i32
! ApplicationError | HostInputError | OutOfMemoryError | FileError | WriterError | ProcessError | InvalidModulePath | Cycle | RevisionMismatch
? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut output = StdoutWriter.make()
  return run program()
    |> Effect.provideMut<Allocator>(&mut allocator)
    |> Effect.provideMut<Writer>(&mut output)
}
