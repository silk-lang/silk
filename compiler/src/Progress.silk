//! Live compilation progress on standard error.
//!
//! A build or check names its unit with a heading, then opens one phase at a time: `load`, `check`,
//! `codegen` and `link`. Each phase counts its work and, when it ends, leaves one summary row with
//! its time. Borrow checking runs inside the check and codegen walks, so its bodies and time are
//! accumulated beside them and reported as a row of their own.
//!
//! On a terminal the open phase is one status line redrawn in place, at most every 50 ms. Otherwise
//! each row is written once, as plain text, when its phase ends. An `off` reporter writes nothing
//! and reads no clock, so the single-source form the corpus harness drives stays silent.

import diagnostic.JsonText
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.num.i64
import silk.collections.list { List }
import silk.platform.native.clock { NativeClock }
import silk.platform.native.descriptor { NativeDescriptor }
import silk.collections.slice { Slice }
import silk.system.system_clock { SystemClock }
import silk.num.u64
import silk.num.usize

/// How progress reaches standard error.
pub enum Display {
  /// Nothing is written.
  Off,
  /// One line per finished phase, without escape codes.
  Plain,
  /// A status line redrawn in place, with color unless `color` is off.
  Live,
}

/// A top-level phase of one compilation unit.
pub enum Phase {
  Load,
  Check,
  Codegen,
  Link,
}

/// How progress is shown, chosen once per command.
pub struct Settings {
  pub display: Display,
  pub color: bool,
  /// The terminal width the live line must fit in.
  pub width: usize,
  /// Whether only the final line is written.
  pub quiet: bool,
  /// Whether the command compiles several units, so a terminal shows one line per finished unit.
  pub compact: bool,
  /// The unit's position among `units` for the live line's `[2/5]`, or zero for none.
  pub position: usize,
  pub units: usize,
  /// Whether each unit lists its slowest modules, bodies and functions, as `--timings` asks.
  pub timings: bool,
}

/// One item of a slowest list: what took `nanos`.
struct Slow {
  nanos: u64,
  name: Bytes,
}

// How many items each slowest list keeps.
const slowestKept: usize = 5

/// The progress of one compilation unit.
pub struct Progress {
  display: Display,
  color: bool,

  /// Whether only the final line is written.
  quiet: bool,

  /// The terminal width the live line must fit in.
  width: usize,
  phase: Phase,
  open: bool,
  count: usize,
  total: usize,
  subject: Bytes,
  started: u64,
  phaseStarted: u64,
  drawnAt: u64,
  frame: usize,

  /// Whether a live line is on screen, so the next write clears it first.
  shown: bool,

  /// Whether finished phases leave no row and the unit ends in one line, as `compact` asks.
  compact: bool,
  /// The live line's unit label, such as `[2/5] core`, in compact mode.
  label: Bytes,
  /// The heading a compact unit writes when it ends, and its visible width.
  heading: Bytes,
  headingWidth: usize,
  /// The problems of the phase that failed.
  problems: usize,

  /// Whether the slowest lists are kept, with the item of the open phase being timed.
  timings: bool,
  timed: Bytes,
  timedFrom: u64,
  // Whether a `clock` reading waits for its `bill`, so nested work is billed once.
  billing: bool,
  slowestChecks: List<Slow>,
  slowestBodies: List<Slow>,
  slowestFunctions: List<Slow>,
  bodies: usize,
  borrowNanos: u64,
  borrowFrom: u64,
  borrowLast: u64,
}

// Redraws closer together than this are skipped.
const redrawNanos: u64 = 50000000

impl Progress {
  /// A reporter that writes nothing.
  pub fn off() -> Progress {
    return Progress {
      display: Display.Off,
      color: false,
      quiet: false,
      width: 80,
      phase: Phase.Load,
      open: false,
      count: 0,
      total: 0,
      subject: Bytes.make(),
      started: 0,
      phaseStarted: 0,
      drawnAt: 0,
      frame: 0,
      shown: false,
      compact: false,
      label: Bytes.make(),
      heading: Bytes.make(),
      headingWidth: 0,
      problems: 0,
      timings: false,
      timed: Bytes.make(),
      timedFrom: 0,
      billing: false,
      slowestChecks: List<Slow>.make(),
      slowestBodies: List<Slow>.make(),
      slowestFunctions: List<Slow>.make(),
      bodies: 0,
      borrowNanos: 0,
      borrowFrom: 0,
      borrowLast: 0,
    }
  }

  /// Starts reporting one unit: writes `<verb> <name> (<detail>)`, such as
  /// `Compiling hello (x86_64-unknown-linux-gnu, debug)`. A compact unit on a terminal keeps that
  /// heading for the one line it writes when it ends.
  pub effect fn start(settings: &Settings, verb: &[u8], name: &[u8], detail: &[u8]) -> Progress
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut progress = Progress.off()
    let display = settings.display
    if display == Display.Off {
      return move progress
    }
    progress.display = display
    progress.color = settings.color && display == Display.Live
    progress.width = settings.width
    progress.quiet = settings.quiet
    progress.compact = settings.compact && display == Display.Live && !settings.timings
    progress.timings = settings.timings && !settings.quiet
    progress.started = run now()
    if settings.quiet {
      return move progress
    }
    if progress.compact {
      if settings.position > usize.ZERO {
        run Bytes.append(&mut progress.label, b"[")
        run JsonText.appendDecimal(&mut progress.label, settings.position)
        run Bytes.append(&mut progress.label, b"/")
        run JsonText.appendDecimal(&mut progress.label, settings.units)
        run Bytes.append(&mut progress.label, b"] ")
      }
      run Bytes.append(&mut progress.label, name)
    }
    let mut line = Bytes.make()
    if display == Display.Live {
      run Bytes.append(&mut line, b"  ")
    }
    run Progress.paint(&progress, &mut line, b"\x1b[1;32m", verb)
    run Bytes.append(&mut line, b" ")
    run Progress.paint(&progress, &mut line, b"\x1b[1m", name)
    if detail.length > usize.ZERO {
      run Bytes.append(&mut line, b" ")
      let mut wrapped = run Bytes.copy(b"(")
      run Bytes.append(&mut wrapped, detail)
      run Bytes.append(&mut wrapped, b")")
      run Progress.paint(&progress, &mut line, b"\x1b[2m", Bytes.asSlice(&wrapped))
    }
    if progress.compact {
      progress.headingWidth = 3 + verb.length + name.length
      if detail.length > usize.ZERO {
        progress.headingWidth = progress.headingWidth + 3 + detail.length
      }
      progress.heading = move line
      return move progress
    }
    run Bytes.append(&mut line, b"\n")
    run write(Bytes.asSlice(&line))
    return move progress
  }

  /// Whether anything is written.
  pub fn enabled(self: &Progress) -> bool {
    return self.display != Display.Off
  }

  /// Opens `phase`, whose work is `total` items, or an unknown amount when `total` is zero. A phase
  /// still open ends first, as `end` with no detail ends it.
  pub effect fn begin(self: &mut Progress, phase: Phase, total: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.display == Display.Off {
      return ()
    }
    if self.open {
      run Progress.end(&mut self.*, b"")
    }
    self.phase = phase
    self.open = true
    self.count = 0
    self.total = total
    Bytes.clear(&mut self.subject)
    self.phaseStarted = run now()
    run Progress.draw(&mut self.*)
  }

  /// Counts one finished item of the open phase.
  pub effect fn advance(self: &mut Progress) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.display == Display.Off {
      return ()
    }
    self.count = self.count + usize.ONE
    if self.display == Display.Live && run Progress.due(&self.*) {
      run Progress.draw(&mut self.*)
    }
  }

  /// Whether a redraw is due, so a caller builds the subject text only when it will be shown.
  pub effect fn due(self: &Progress) -> bool {
    if self.display != Display.Live {
      return false
    }
    let current = run now()
    return current - self.drawnAt >= redrawNanos
  }

  /// Names what the open phase is working on and redraws.
  pub effect fn show(self: &mut Progress, subject: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.display != Display.Live {
      return ()
    }
    Bytes.clear(&mut self.subject)
    run Bytes.append(&mut self.subject, subject)
    if run Progress.due(&self.*) {
      run Progress.draw(&mut self.*)
    }
  }

  /// Ends the open phase with a `✓` row described by `detail`, or by its count, such as
  /// `97 modules`, when `detail` is empty.
  pub effect fn end(self: &mut Progress, detail: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if detail.length > usize.ZERO {
      return run Progress.close(&mut self.*, detail, true)
    }
    let counted = run Progress.counted(&self.*)
    return run Progress.close(&mut self.*, Bytes.asSlice(&counted), true)
  }

  /// Ends the open phase with a `✗` row: its count and, when there are any, its `problems`.
  pub effect fn refuse(self: &mut Progress, problems: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut detail = run Progress.counted(&self.*)
    if problems > usize.ZERO {
      if Bytes.length(&detail) > usize.ZERO {
        run Bytes.append(&mut detail, b", ")
      }
      run Progress.appendCount(&mut detail, problems)
      if problems == usize.ONE {
        run Bytes.append(&mut detail, b" error")
      } else {
        run Bytes.append(&mut detail, b" errors")
      }
    }
    self.problems = problems
    return run Progress.close(&mut self.*, Bytes.asSlice(&detail), false)
  }

  /// Whether a phase is open.
  pub fn running(self: &Progress) -> bool {
    return self.open
  }

  /// Marks the start of one body's borrow check.
  pub effect fn enterBorrowCheck(self: &mut Progress) -> () {
    if self.display == Display.Off {
      return ()
    }
    self.borrowFrom = run now()
  }

  /// Marks the end of the borrow check `enterBorrowCheck` started.
  pub effect fn leaveBorrowCheck(self: &mut Progress) -> () {
    if self.display == Display.Off {
      return ()
    }
    self.bodies = self.bodies + usize.ONE
    let current = run now()
    self.borrowLast = current - self.borrowFrom
    self.borrowNanos = self.borrowNanos + self.borrowLast
  }

  /// Whether the slowest lists are kept, so callers name each item only when they are.
  pub fn timing(self: &Progress) -> bool {
    return self.timings
  }

  /// Starts timing `name`, the open phase's next module or function; the previous one's time ends.
  pub effect fn timeItem(self: &mut Progress, name: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.timings {
      return ()
    }
    run Progress.settle(&mut self.*)
    run Bytes.append(&mut self.timed, name)
    self.timedFrom = run now()
  }

  /// Ends the time of the item `timeItem` started, so work after the open phase's last module or
  /// function is not counted as that item's.
  pub effect fn endItem(self: &mut Progress) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run Progress.settle(&mut self.*)
  }

  /// A reading for [`bill`], or zero when the slowest lists are not kept or a reading already
  /// waits for its `bill`.
  pub effect fn clock(self: &mut Progress) -> u64 {
    if !self.timings || self.billing || self.phase != Phase.Check {
      return 0
    }
    self.billing = true
    return run now()
  }

  /// Counts the time since `started`, a [`clock`] reading, as the module `name`'s rather than the
  /// timed module's: work on `name`'s declarations that the timed module's check was first to need.
  pub effect fn bill(self: &mut Progress, name: &[u8], started: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if started == 0 {
      return ()
    }
    self.billing = false
    let current = run now()
    let nanos = current - started
    if Bytes.length(&self.timed) > usize.ZERO {
      self.timedFrom = self.timedFrom + nanos
    }
    run keep(&mut self.slowestChecks, nanos, name)
  }

  /// Records the time of the borrow check `leaveBorrowCheck` just ended against `name`.
  pub effect fn timeBorrowCheck(self: &mut Progress, name: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.timings {
      return ()
    }
    run keep(&mut self.slowestBodies, self.borrowLast, name)
  }

  /// Writes the borrow-check row for the bodies checked so far, when there are any, and starts a
  /// new count.
  pub effect fn borrowRow(self: &mut Progress) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.display == Display.Off || self.bodies == usize.ZERO {
      return ()
    }
    let mut detail = Bytes.make()
    run Progress.appendCount(&mut detail, self.bodies)
    if self.bodies == usize.ONE {
      run Bytes.append(&mut detail, b" body")
    } else {
      run Bytes.append(&mut detail, b" bodies")
    }
    let nanos = self.borrowNanos
    run Progress.row(&mut self.*, b"borrow ", Bytes.asSlice(&detail), nanos, true)
    self.bodies = 0
    self.borrowNanos = 0
  }

  /// Clears the live line before other standard-error output, such as diagnostics.
  pub effect fn clear(self: &mut Progress) -> () {
    if self.shown {
      run write(b"\r\x1b[2K")
      self.shown = false
    }
  }

  /// Writes the final line: `Finished <what> in <time>` or `Failed <what> in <time>`.
  pub effect fn finish(self: &mut Progress, what: &[u8], succeeded: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.display == Display.Off {
      return ()
    }
    run Progress.clear(&mut self.*)
    if self.compact {
      return run Progress.finishCompact(&mut self.*, succeeded)
    }
    if self.timings {
      run Progress.writeSlowest(&self.*, b"Slowest modules to check", &self.slowestChecks)
      run Progress.writeSlowest(&self.*, b"Slowest bodies to borrow-check", &self.slowestBodies)
      run Progress.writeSlowest(&self.*, b"Slowest functions to emit", &self.slowestFunctions)
    }
    let mut line = Bytes.make()
    let live = self.display == Display.Live
    if succeeded {
      if live {
        run Bytes.append(&mut line, b"   ")
      }
      run Progress.paint(&self.*, &mut line, b"\x1b[1;32m", b"Finished")
    } else {
      if live {
        run Bytes.append(&mut line, b"     ")
      }
      run Progress.paint(&self.*, &mut line, b"\x1b[1;31m", b"Failed")
    }
    run Bytes.append(&mut line, b" ")
    run Bytes.append(&mut line, what)
    run Bytes.append(&mut line, b" ")
    run Progress.paint(&self.*, &mut line, b"\x1b[2m", b"in")
    run Bytes.append(&mut line, b" ")
    let mut elapsed = Bytes.make()
    let current = run now()
    run Progress.appendDuration(&mut elapsed, current - self.started)
    run Progress.paint(&self.*, &mut line, b"\x1b[1m", Bytes.asSlice(&elapsed))
    run Bytes.append(&mut line, b"\n")
    run write(Bytes.asSlice(&line))
    self.display = Display.Off
  }

  // Ends the timed item of the open phase, keeping it when it is among the slowest.
  effect fn settle(self: &mut Progress) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.timings || Bytes.length(&self.timed) == usize.ZERO {
      return ()
    }
    let current = run now()
    let nanos = current - self.timedFrom
    if self.phase == Phase.Check {
      run keep(&mut self.slowestChecks, nanos, Bytes.asSlice(&self.timed))
    } else if self.phase == Phase.Codegen {
      run keep(&mut self.slowestFunctions, nanos, Bytes.asSlice(&self.timed))
    }
    Bytes.clear(&mut self.timed)
  }

  // Writes `title` and the items of `slowest`, slowest first: `     0.41s  src/server/routes.silk`.
  effect fn writeSlowest(self: &Progress, title: &[u8], slowest: &List<Slow>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let items = List<Slow>.asSlice(slowest)
    if items.length == usize.ZERO {
      return ()
    }
    let mut text = Bytes.make()
    run Bytes.append(&mut text, b"  ")
    run Progress.paint(self, &mut text, b"\x1b[1m", title)
    run Bytes.append(&mut text, b"\n")
    let mut written = List<bool>.make()
    let mut at = usize.ZERO
    while at < items.length {
      run List<bool>.append(&mut written, false)
      at = at + usize.ONE
    }
    let mut round = usize.ZERO
    while round < items.length {
      let mut slowest = usize.MAX
      let mut candidate = usize.ZERO
      while candidate < items.length {
        if !List<bool>.get(&written, candidate) && (slowest == usize.MAX || items[candidate].nanos > items[slowest].nanos) {
          slowest = candidate
        }
        candidate = candidate + usize.ONE
      }
      let marks = List<bool>.asMutSlice(&mut written)
      marks[slowest] = true
      let mut elapsed = Bytes.make()
      run Progress.appendFineDuration(&mut elapsed, items[slowest].nanos)
      run Bytes.append(&mut text, b"     ")
      let mut pad = Bytes.length(&elapsed)
      while pad < 8 {
        run Bytes.append(&mut text, b" ")
        pad = pad + usize.ONE
      }
      run Progress.paint(self, &mut text, b"\x1b[2m", Bytes.asSlice(&elapsed))
      run Bytes.append(&mut text, b"  ")
      run Bytes.append(&mut text, Bytes.asSlice(&items[slowest].name))
      run Bytes.append(&mut text, b"\n")
      round = round + usize.ONE
    }
    run write(Bytes.asSlice(&text))
  }

  // Writes a compact unit's one line: its heading, `✓` or `✗` with its problems, and its time.
  effect fn finishCompact(self: &mut Progress, succeeded: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut line = run Bytes.copy(Bytes.asSlice(&self.heading))
    let mut used = self.headingWidth
    while used < 58 {
      run Bytes.append(&mut line, b" ")
      used = used + usize.ONE
    }
    run Bytes.append(&mut line, b"  ")
    if succeeded {
      run Progress.paint(&self.*, &mut line, b"\x1b[32m", b"\xE2\x9C\x93")
    } else {
      let mut failed = run Bytes.copy(b"\xE2\x9C\x97")
      if self.problems > usize.ZERO {
        run Bytes.append(&mut failed, b" ")
        run Progress.appendCount(&mut failed, self.problems)
        if self.problems == usize.ONE {
          run Bytes.append(&mut failed, b" error")
        } else {
          run Bytes.append(&mut failed, b" errors")
        }
      }
      run Progress.paint(&self.*, &mut line, b"\x1b[31m", Bytes.asSlice(&failed))
    }
    run Bytes.append(&mut line, b"  ")
    let mut elapsed = Bytes.make()
    let current = run now()
    run Progress.appendDuration(&mut elapsed, current - self.started)
    run Progress.paint(&self.*, &mut line, b"\x1b[2m", Bytes.asSlice(&elapsed))
    run Bytes.append(&mut line, b"\n")
    run write(Bytes.asSlice(&line))
    self.display = Display.Off
  }

  /// Appends `text[start..end]`, such as an implementation header written over several lines, as
  /// it reads on one line: each run of blanks becomes one space, none follows an opening bracket or
  /// precedes a closing one or a comma, and a trailing comma before a closing bracket is dropped.
  pub effect fn appendFolded(out: &mut Bytes, text: &[u8], start: usize, end: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut space = false
    let mut at = start
    while at < end && at < text.length {
      let byte = text[at]
      at = at + usize.ONE
      if byte == 32 || byte == 9 || byte == 10 || byte == 13 {
        space = true
        continue
      }
      let closing = byte == 62 || byte == 41 || byte == 93
      let length = Bytes.length(&out.*)
      let mut opened = true
      if length > usize.ZERO {
        let last = Bytes.asSlice(&out.*)[length - usize.ONE]
        if closing && last == 44 { Bytes.truncate(&mut out.*, length - usize.ONE) }
        opened = last == 60 || last == 40 || last == 91
      }
      if space && !opened && !closing && byte != 44 { run Bytes.append(&mut out.*, b" ") }
      space = false
      run Bytes.append(&mut out.*, &[byte])
    }
  }

  /// Appends `value` in decimal with comma thousands separators, as `4,812`.
  pub effect fn appendCount(out: &mut Bytes, value: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut digits = Bytes.make()
    run JsonText.appendDecimal(&mut digits, value)
    let text = Bytes.asSlice(&digits)
    let mut at = usize.ZERO
    while at < text.length {
      if at > usize.ZERO && usize.remainder(text.length - at, 3) == usize.ZERO {
        run Bytes.append(&mut out.*, b",")
      }
      run Bytes.append(&mut out.*, Slice.view<u8>(text, at, usize.ONE))
      at = at + usize.ONE
    }
  }

  /// Appends a duration in nanoseconds as `0.12s` below a minute and `2m 05s` from a minute on.
  pub effect fn appendDuration(out: &mut Bytes, nanos: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let hundredths = u64.divide(nanos, 10000000)
    let seconds = u64.divide(hundredths, 100)
    if seconds >= 60 {
      run JsonText.appendDecimal(&mut out.*, u64.toUsize(u64.divide(seconds, 60)))
      run Bytes.append(&mut out.*, b"m ")
      let rest = u64.remainder(seconds, 60)
      if rest < 10 {
        run Bytes.append(&mut out.*, b"0")
      }
      run JsonText.appendDecimal(&mut out.*, u64.toUsize(rest))
      return run Bytes.append(&mut out.*, b"s")
    }
    run JsonText.appendDecimal(&mut out.*, u64.toUsize(seconds))
    run Bytes.append(&mut out.*, b".")
    let fraction = u64.remainder(hundredths, 100)
    if fraction < 10 {
      run Bytes.append(&mut out.*, b"0")
    }
    run JsonText.appendDecimal(&mut out.*, u64.toUsize(fraction))
    return run Bytes.append(&mut out.*, b"s")
  }

  /// Appends a duration in nanoseconds as `0.42ms` or `12.3ms` below a second, else as
  /// `appendDuration` does.
  pub effect fn appendFineDuration(out: &mut Bytes, nanos: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if nanos >= 1000000000 {
      return run Progress.appendDuration(&mut out.*, nanos)
    }
    if nanos < 10000000 {
      let hundredths = u64.divide(nanos, 10000)
      run JsonText.appendDecimal(&mut out.*, u64.toUsize(u64.divide(hundredths, 100)))
      run Bytes.append(&mut out.*, b".")
      let fraction = u64.remainder(hundredths, 100)
      if fraction < 10 {
        run Bytes.append(&mut out.*, b"0")
      }
      run JsonText.appendDecimal(&mut out.*, u64.toUsize(fraction))
      return run Bytes.append(&mut out.*, b"ms")
    }
    let tenths = u64.divide(nanos, 100000)
    run JsonText.appendDecimal(&mut out.*, u64.toUsize(u64.divide(tenths, 10)))
    run Bytes.append(&mut out.*, b".")
    run JsonText.appendDecimal(&mut out.*, u64.toUsize(u64.remainder(tenths, 10)))
    return run Bytes.append(&mut out.*, b"ms")
  }

  /// The name a phase's rows and status line use, padded to one width.
  pub fn phaseName(phase: Phase) -> &'static [u8] {
    return match phase {
      Phase.Load => b"load   "
      Phase.Check => b"check  "
      Phase.Codegen => b"codegen"
      Phase.Link => b"link   "
    }
  }

  // The open phase's count with its unit, such as `97 modules`; empty for a phase that counts nothing.
  effect fn counted(self: &Progress) -> Bytes
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = Bytes.make()
    let unit = unitName(self.phase, self.count != usize.ONE)
    if unit.length == usize.ZERO {
      return move text
    }
    run Progress.appendCount(&mut text, self.count)
    run Bytes.append(&mut text, b" ")
    run Bytes.append(&mut text, unit)
    return move text
  }

  effect fn close(self: &mut Progress, detail: &[u8], succeeded: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.display == Display.Off || !self.open {
      return ()
    }
    run Progress.settle(&mut self.*)
    self.open = false
    let current = run now()
    let name = Progress.phaseName(self.phase)
    let nanos = current - self.phaseStarted
    run Progress.row(&mut self.*, name, detail, nanos, succeeded)
  }

  // Writes one summary row: `✓ check    97 modules            1.91s`.
  effect fn row(self: &mut Progress, name: &[u8], detail: &[u8], nanos: u64, succeeded: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.quiet || self.compact {
      return ()
    }
    run Progress.clear(&mut self.*)
    let line = run Progress.rowLine(&self.*, name, detail, nanos, succeeded)
    run write(Bytes.asSlice(&line))
    if self.open {
      run Progress.draw(&mut self.*)
    }
  }

  /// The row a plain display writes for a finished phase: `  check    97 modules   1.91s`, or
  /// `  link     failed   0.00s` for a failed phase with nothing to count.
  pub effect fn plainRow(name: &[u8], detail: &[u8], nanos: u64, succeeded: bool) -> Bytes
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut plain = Progress.off()
    plain.display = Display.Plain
    return run Progress.rowLine(&plain, name, detail, nanos, succeeded)
  }

  // The text of one summary row, ending in a newline.
  effect fn rowLine(self: &Progress, name: &[u8], detail: &[u8], nanos: u64, succeeded: bool) -> Bytes
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut line = Bytes.make()
    if self.display == Display.Live {
      run Bytes.append(&mut line, b"     ")
      if succeeded {
        run Progress.paint(&self.*, &mut line, b"\x1b[32m", b"\xE2\x9C\x93")
      } else {
        run Progress.paint(&self.*, &mut line, b"\x1b[31m", b"\xE2\x9C\x97")
      }
      run Bytes.append(&mut line, b" ")
      run Progress.paint(&self.*, &mut line, b"\x1b[36m", name)
      run Bytes.append(&mut line, b"  ")
    } else {
      run Bytes.append(&mut line, b"  ")
      run Bytes.append(&mut line, name)
      run Bytes.append(&mut line, b"  ")
      // A failed phase with nothing to count, such as a link, says only `failed`.
      if !succeeded && detail.length > usize.ZERO {
        run Bytes.append(&mut line, b"failed: ")
      } else if !succeeded {
        run Bytes.append(&mut line, b"failed")
      }
    }
    run Bytes.append(&mut line, detail)
    let mut used = detail.length
    if !succeeded && self.display != Display.Live {
      used = used + 6
      if detail.length > usize.ZERO {
        used = used + 2
      }
    }
    // A detail too long for the column still keeps one space before the time.
    if used >= 34 {
      run Bytes.append(&mut line, b" ")
    }
    while used < 34 {
      run Bytes.append(&mut line, b" ")
      used = used + usize.ONE
    }
    let mut elapsed = Bytes.make()
    run Progress.appendDuration(&mut elapsed, nanos)
    run Progress.paint(&self.*, &mut line, b"\x1b[2m", Bytes.asSlice(&elapsed))
    run Bytes.append(&mut line, b"\n")
    return move line
  }

  // Redraws the live line: spinner, phase, bar when the total is known, count, subject and elapsed
  // time, cut to the terminal width.
  effect fn draw(self: &mut Progress) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.display != Display.Live || !self.open || self.quiet {
      return ()
    }
    let at = run now()
    self.drawnAt = at
    self.frame = self.frame + usize.ONE
    let spinner = [
      b"\xE2\xA0\x8B",
      b"\xE2\xA0\x99",
      b"\xE2\xA0\xB9",
      b"\xE2\xA0\xB8",
      b"\xE2\xA0\xBC",
      b"\xE2\xA0\xB4",
      b"\xE2\xA0\xA6",
      b"\xE2\xA0\xA7",
      b"\xE2\xA0\x87",
      b"\xE2\xA0\x8F"
    ]
    let mut line = run Bytes.copy(b"\r\x1b[2K  ")
    run Progress.paint(&self.*, &mut line, b"\x1b[33m", spinner[usize.remainder(self.frame, 10)])
    run Bytes.append(&mut line, b" ")
    let label = Bytes.asSlice(&self.label)
    if label.length > usize.ZERO {
      run Progress.paint(&self.*, &mut line, b"\x1b[1m", label)
      run Bytes.append(&mut line, b" ")
    }
    let name = Progress.phaseName(self.phase)
    run Progress.paint(&self.*, &mut line, b"\x1b[36m", name)

    // Visible columns so far: two spaces, the spinner, a space, the unit label and the phase name.
    let mut columns = 4 + name.length
    if label.length > usize.ZERO {
      columns = columns + label.length + usize.ONE
    }
    if self.total > usize.ZERO {
      run Bytes.append(&mut line, b"  ")
      let mut bounded = self.count
      if bounded > self.total {
        bounded = self.total
      }
      let filled = usize.divide(bounded * 22, self.total)
      let mut cell = usize.ZERO
      let mut bar = Bytes.make()
      while cell < filled {
        run Bytes.append(&mut bar, b"\xE2\x94\x81")
        cell = cell + usize.ONE
      }
      run Progress.paint(&self.*, &mut line, b"\x1b[32m", Bytes.asSlice(&bar))
      let mut rest = Bytes.make()
      while cell < 22 {
        run Bytes.append(&mut rest, b"\xE2\x94\x81")
        cell = cell + usize.ONE
      }
      run Progress.paint(&self.*, &mut line, b"\x1b[2m", Bytes.asSlice(&rest))
      columns = columns + 24
    }
    let unit = unitName(self.phase, self.count != usize.ONE || self.total > usize.ZERO)
    if unit.length > usize.ZERO {
      let mut counted = Bytes.make()
      run Progress.appendCount(&mut counted, self.count)
      if self.total > usize.ZERO {
        run Bytes.append(&mut counted, b"/")
        run Progress.appendCount(&mut counted, self.total)
      }
      run Bytes.append(&mut counted, b" ")
      run Bytes.append(&mut counted, unit)
      run Bytes.append(&mut line, b"  ")
      run Progress.paint(&self.*, &mut line, b"\x1b[1m", Bytes.asSlice(&counted))
      columns = columns + 2 + Bytes.length(&counted)
    }
    let mut elapsed = run Bytes.copy(b"  ")
    run Progress.appendDuration(&mut elapsed, at - self.started)
    columns = columns + Bytes.length(&elapsed)
    let subject = Bytes.asSlice(&self.subject)
    if subject.length > usize.ZERO && columns + 3 < self.width {
      let room = self.width - columns - 3
      run Bytes.append(&mut line, b"  ")
      if subject.length <= room {
        run Progress.paint(&self.*, &mut line, b"\x1b[2m", subject)
      } else {
        run Progress.paint(
          &self.*,
          &mut line,
          b"\x1b[2m",
          Slice.view<u8>(subject, usize.ZERO, room)
        )
      }
    }
    run Progress.paint(&self.*, &mut line, b"\x1b[2m", Bytes.asSlice(&elapsed))
    run write(Bytes.asSlice(&line))
    self.shown = true
  }

  // Appends `text` in the color `code` opens, when color is on.
  effect fn paint(self: &Progress, line: &mut Bytes, code: &[u8], text: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.color {
      run Bytes.append(&mut line.*, code)
    }
    run Bytes.append(&mut line.*, text)
    if self.color {
      run Bytes.append(&mut line.*, b"\x1b[0m")
    }
  }
}

// The unit a phase counts, singular and plural; none for a load or link, which count nothing.
fn unitName(phase: Phase, plural: bool) -> &'static [u8] {
  if phase == Phase.Link || phase == Phase.Load {
    return b""
  }
  if phase == Phase.Codegen {
    if plural {
      return b"functions"
    }
    return b"function"
  }
  if plural {
    return b"modules"
  }
  return b"module"
}

// Monotonic nanoseconds.
effect fn now() -> u64 {
  let instant = run NativeClock.now(true)
  return i64.toU64(SystemClock.seconds(&instant)) * 1000000000
    + i64.toU64(SystemClock.nanoseconds(&instant))
}

// Writes to standard error; progress output never fails a build, so a failed write is dropped.
effect fn write(bytes: &[u8]) -> () {
  let mut error = 0
  let written = run NativeDescriptor.writeAll(2, bytes, &mut error)
  return ()
}

// Whether two item names are the same bytes.
fn sameName(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Keeps `name`, which took `nanos`, in `slowest` when the list has room or it is slower than the
// fastest item kept.
effect fn keep(slowest: &mut List<Slow>, nanos: u64, name: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  // A module billed for work another module's check needed adds its own check's time.
  let mut kept = List<Slow>.asMutSlice(&mut slowest.*)
  let mut named = usize.ZERO
  while named < kept.length {
    if sameName(Bytes.asSlice(&kept[named].name), name) {
      kept[named].nanos = kept[named].nanos + nanos
      return ()
    }
    named = named + usize.ONE
  }
  let items = List<Slow>.asSlice(&slowest.*)
  if items.length >= slowestKept {
    let mut fastest = usize.ZERO
    let mut at = usize.ONE
    while at < items.length {
      if items[at].nanos < items[fastest].nanos {
        fastest = at
      }
      at = at + usize.ONE
    }
    if items[fastest].nanos >= nanos {
      return ()
    }
    let dropped = List<Slow>.remove(&mut slowest.*, fastest)
    drop dropped
  }
  run List<Slow>.append(&mut slowest.*, Slow {nanos: nanos, name: run Bytes.copy(name)})
}
