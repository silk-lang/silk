//! Independent source-level extraction contracts: admission, attachment, privacy and links.

import documentation.Model {Document, Item, Link, Module, Project, equal}
import documentation.Project as Extraction {Error}
import semantic.DeclarationId {DeclarationId}
import semantic.FinalProfile {Entry, FinalProfile, Problem as FinalProblem}
import semantic.InitialProfile {InitialProfile, Input, Problem as ProfileProblem}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.ProfileBinding {RegisteredShape}
import semantic.Query {Cycle}
import semantic.Rejection {Rejection, RejectionCode}
import semantic.Semantic {Request, Semantic}
import semantic.SourceIndex {RevisionMismatch}
import semantic.SourceRevision {Revision}
import semantic.Target {Id, Target}
import semantic.Types {TypeTable, Types}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.mem.shared {Shared}
import silk.text.string {String}
import silk.testing.testing {AssertionError, Testing}
import silk.num.usize
import silk.collections.list {List}

fn findItem(items: &[Item], name: &[u8]) -> usize {
  let mut at = usize.ZERO
  while at < items.length {
    if equal(Bytes.asSlice(&items[at].name), name) { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn documentationIs(item: &Item, text: &[u8]) -> bool {
  if let Option<Document>.Some {value} = &item.documentation { return equal(Bytes.asSlice(&value.markdown), text) }
  return false
}

fn noDocumentation(item: &Item) -> bool {
  return match &item.documentation { Option<Document>.None => true _ => false }
}

fn linksTo(document: &Document, spelling: &[u8], identity: &[u8]) -> bool {
  let links = List<Link>.asSlice(&document.links)
  let mut at = usize.ZERO
  while at < links.length {
    if equal(Bytes.asSlice(&links[at].spelling), spelling) && equal(Bytes.asSlice(&links[at].target), identity) { return true }
    at = at + usize.ONE
  }
  return false
}

// True when `spelling` was recorded as ambiguous between exactly `first` and `second`, in either order.
effect fn ambiguousBetween(document: &Document, spelling: &[u8], first: &[u8], second: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let ambiguous = List<Link>.asSlice(&document.ambiguous)
  let mut forward = run Bytes.copy(b"`")
  run Bytes.append(&mut forward, first)
  run Bytes.append(&mut forward, b"` or `")
  run Bytes.append(&mut forward, second)
  run Bytes.append(&mut forward, b"`")
  let mut backward = run Bytes.copy(b"`")
  run Bytes.append(&mut backward, second)
  run Bytes.append(&mut backward, b"` or `")
  run Bytes.append(&mut backward, first)
  run Bytes.append(&mut backward, b"`")
  let mut at = usize.ZERO
  while at < ambiguous.length {
    if equal(Bytes.asSlice(&ambiguous[at].spelling), spelling) {
      let target = Bytes.asSlice(&ambiguous[at].target)
      return equal(target, Bytes.asSlice(&forward)) || equal(target, Bytes.asSlice(&backward))
    }
    at = at + usize.ONE
  }
  return false
}

effect fn attachmentClaims() -> ()
! Error | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let root = run ModuleId.make(b"memory", b"docs", b"root.silk")
  let dependency = run ModuleId.sibling(&root, b"other.silk")
  let authored = Option<Bytes>.some(run Bytes.copy(String.utf8Bytes("""//! API [`Renamed`] and [`library.Remote`], but not [`library.Secret`].
//! Cases [`Ready`] and [`Found`] resolve, but [`Shared`] is ambiguous and [`Ghost`] is invisible.
//! [`make`] is local; [`library.Remote.make`] is explicit. [`remoteOnly`] and [`importedField`] stay unresolved.
//! [`clash`] is locally ambiguous even though an imported enum also has that case.
import other as library
pub import other {Remote as Renamed}
import other {State, State as StateAlias, OtherState, Payload}
static if false { import other {HiddenState} }
pub struct Holder {pub Remote: u32}
pub import other {Remote}
pub const ANSWER: u32 = 42
pub param LIMIT: u32 = 9 where LIMIT > 0
export "C" static counter: i32 = 0
/// First line.
/// Second line.
pub struct Visible {
  /// Public field.
  pub field: u32,
  /// Hidden field.
  hidden: u32,
}
/// Detached by a blank line.

pub fn detached() -> u32 { return missingBodyName }
@inlineNever
@nonParking
pub fn directed() -> u32 { return directedBodyName }
/// Detached by a normal comment.
// ordinary comment
pub fn ordinary() -> u32 { return anotherMissingBodyName }
//// Not a documentation marker.
pub fn fourSlashes() {}
/// Hidden declaration.
struct Hidden {}
/// A function with a parameter.
pub fn documented(/// Not line-leading.
  input: u32
) -> u32 { return unknownBodyName }
/// Owner documentation.
impl Visible {
  /// Reads [`field`] and [`Self`].
  pub fn read(self: &Self) -> u32 { return missing }
  pub fn make() -> Self { return uncheckedLocalBody }
  pub fn clash() -> u32 { return uncheckedLocalBody }
}
impl Holder {
  pub fn clash() -> u32 { return uncheckedLocalBody }
}
/// Both [`make`] and [`Maker.make`] refer to this contract's operation.
pub interface Maker {
  fn make() -> Visible
}
""")))
  let imported = Option<Bytes>.some(run Bytes.copy(String.utf8Bytes("""/// Imported type.
pub struct Remote {pub importedField: u32}
impl Remote {
  pub fn make() -> Self { return uncheckedImportedBody }
  pub fn remoteOnly() -> u32 { return uncheckedImportedBody }
}
struct Secret {}
pub enum State {Ready, Shared, clash}
pub enum OtherState {Shared}
pub enum HiddenState {Ready}
pub enum Unseen {Ghost}
pub union Payload {Found}
""")))
  let initial = run Revision.publish(&Revision.make(), &root, &authored)
  let revision = run Revision.publish(&initial, &dependency, &imported)
  let mut store = Semantic.oneShot(move revision, Target.forId(Id.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut roots = List<ModuleId>.make()
  run List<ModuleId>.append(&mut roots, ModuleId.copy(&root))
  run List<ModuleId>.append(&mut roots, ModuleId.copy(&dependency))
  let mut paths = List<Bytes>.make()
  run List<Bytes>.append(&mut paths, run Bytes.copy(b"root.silk"))
  run List<Bytes>.append(&mut paths, run Bytes.copy(b"other.silk"))
  let public = run Extraction.extract(&mut store, List<ModuleId>.asSlice(&roots), List<Bytes>.asSlice(&paths), b"x86_64-unknown-linux-gnu", b"fixture", false)
  let private = run Extraction.extract(&mut store, List<ModuleId>.asSlice(&roots), List<Bytes>.asSlice(&paths), b"x86_64-unknown-linux-gnu", b"fixture", true)
  drop store
  let modules = List<Module>.asSlice(&public.modules)
  let items = List<Item>.asSlice(&modules[0].items)
  let visible = findItem(items, b"Visible")
  let field = findItem(items, b"field")
  let detached = findItem(items, b"detached")
  let ordinary = findItem(items, b"ordinary")
  let four = findItem(items, b"fourSlashes")
  let read = findItem(items, b"read")
  run Testing.expect(visible != usize.MAX && field != usize.MAX && detached != usize.MAX && ordinary != usize.MAX && four != usize.MAX && read != usize.MAX, "all selected public kinds are emitted")
  run Testing.expect(findItem(items, b"Hidden") == usize.MAX && findItem(items, b"hidden") == usize.MAX, "default extraction excludes private declarations and fields")
  let privateItems = List<Item>.asSlice(&List<Module>.asSlice(&private.modules)[0].items)
  run Testing.expect(findItem(privateItems, b"Hidden") != usize.MAX && findItem(privateItems, b"hidden") != usize.MAX, "include-private changes visibility, not source admission")
  run Testing.expect(documentationIs(&items[visible], b"First line.\nSecond line."), "only one marker and optional space are stripped")
  run Testing.expect(noDocumentation(&items[detached]) && noDocumentation(&items[ordinary]) && noDocumentation(&items[four]), "blank lines, ordinary comments and four slashes do not attach")
  run Testing.expect(equal(Bytes.asSlice(&items[detached].signature), b"pub fn detached() -> u32"), "authored signatures exclude unchecked bodies")
  run Testing.expect(equal(Bytes.asSlice(&items[visible].signature), b"pub struct Visible"), "container signatures cannot leak private fields")
  let directed = findItem(items, b"directed")
  run Testing.expect(directed != usize.MAX && equal(Bytes.asSlice(&items[directed].signature), b"@nonParking\npub fn directed() -> u32"), "signatures keep the directives a caller must know and drop hints")
  run Testing.expect(equal(Bytes.asSlice(&items[read].kind), b"Method"), "inherent receiver functions are methods")
  let answer = findItem(items, b"ANSWER")
  let limit = findItem(items, b"LIMIT")
  let counter = findItem(privateItems, b"counter")
  run Testing.expect(answer != usize.MAX && limit != usize.MAX && counter != usize.MAX, "initializer-bearing declarations are retained")
  run Testing.expect(equal(Bytes.asSlice(&items[answer].signature), b"pub const ANSWER: u32"), "constant initializers are absent from source-authored headers")
  run Testing.expect(equal(Bytes.asSlice(&items[limit].signature), b"pub param LIMIT: u32"), "package defaults and validation bodies are absent from headers")
  run Testing.expect(equal(Bytes.asSlice(&privateItems[counter].signature), b"export \"C\" static counter: i32"), "exported static initializers are absent from headers")
  let mut remoteFields = usize.ZERO
  let mut remoteAliases = usize.ZERO
  let mut at = usize.ZERO
  while at < items.length {
    if equal(Bytes.asSlice(&items[at].name), b"Remote") {
      if equal(Bytes.asSlice(&items[at].kind), b"Field") { remoteFields = remoteFields + usize.ONE }
      if equal(Bytes.asSlice(&items[at].kind), b"Alias") { remoteAliases = remoteAliases + usize.ONE }
    }
    at = at + usize.ONE
  }
  run Testing.expect(remoteFields == usize.ONE && remoteAliases == usize.ONE, "a descendant name cannot suppress a module-level public import")
  if let Option<Document>.Some {value} = &items[visible].documentation {
    let lines = List<usize>.asSlice(&value.lineStarts)
    run Testing.expect(lines.length == 2 && lines[0] == value.source.start + 4 && lines[1] == lines[0] + 16, "normalized lines map to exact original content bytes")
  } else { run Testing.expect(false, "the attached block exists") }
  if let Option<Document>.Some {value} = &items[read].documentation {
    run Testing.expect(linksTo(&value, b"field", Bytes.asSlice(&items[field].id)) && linksTo(&value, b"Self", Bytes.asSlice(&items[visible].id)), "inherent comments resolve in their semantic owner's scope")
  } else { run Testing.expect(false, "method documentation is attached") }
  let remoteItems = List<Item>.asSlice(&modules[1].items)
  let remote = findItem(remoteItems, b"Remote")
  let alias = findItem(items, b"Renamed")
  run Testing.expect(remote != usize.MAX && alias != usize.MAX, "public imports publish a local binding")
  run Testing.expect(!equal(Bytes.asSlice(&items[alias].id), Bytes.asSlice(&remoteItems[remote].id)) && equal(Bytes.asSlice(&items[alias].kind), b"Alias"), "an import publication has its own canonical identity, distinct from the declaration it links")
  let ready = findItem(remoteItems, b"Ready")
  let found = findItem(remoteItems, b"Found")
  run Testing.expect(ready != usize.MAX && found != usize.MAX, "the imported enum and union cases are emitted")
  let localMake = findItem(items, b"make")
  let importedMake = findItem(remoteItems, b"make")
  run Testing.expect(localMake != usize.MAX && importedMake != usize.MAX, "both modules expose the same associated member spelling")
  let maker = findItem(items, b"Maker")
  let mut contractMake = usize.MAX
  at = usize.ZERO
  while at < items.length {
    if equal(Bytes.asSlice(&items[at].name), b"make") {
      if let Option<usize>.Some {value: parent} = &items[at].parent {
        if parent == maker { contractMake = at }
      }
    }
    at = at + usize.ONE
  }
  run Testing.expect(maker != usize.MAX && contractMake != usize.MAX, "the competing interface operation is retained")
  if let Option<Document>.Some {value} = &items[maker].documentation {
    run Testing.expect(linksTo(&value, b"make", Bytes.asSlice(&items[contractMake].id)) && linksTo(&value, b"Maker.make", Bytes.asSlice(&items[contractMake].id)), "owner-scoped and qualified links retain the interface operation despite an inherent member with the same spelling")
  } else { run Testing.expect(false, "interface documentation is retained") }
  if let Option<Document>.Some {value} = &modules[0].documentation {
    run Testing.expect(linksTo(&value, b"Renamed", Bytes.asSlice(&remoteItems[remote].id)) && linksTo(&value, b"library.Remote", Bytes.asSlice(&remoteItems[remote].id)), "selected member aliases and namespace aliases resolve canonically")
    run Testing.expect(linksTo(&value, b"Ready", Bytes.asSlice(&remoteItems[ready].id)) && linksTo(&value, b"Found", Bytes.asSlice(&remoteItems[found].id)), "bare imported enum and union cases link to canonical child identities despite owner aliases")
    run Testing.expect(linksTo(&value, b"make", Bytes.asSlice(&items[localMake].id)), "a local associated member wins over imported owners with the same member spelling")
    run Testing.expect(linksTo(&value, b"library.Remote.make", Bytes.asSlice(&remoteItems[importedMake].id)), "an explicit namespace-qualified imported method still resolves")
    run Testing.expect(List<Link>.length(&value.links) == 6, "imported methods and fields are not bare candidates and local ambiguity cannot fall through to imported cases")
    run Testing.expect(run ambiguousBetween(&value, b"clash", b"Visible.clash", b"Holder.clash"), "a locally ambiguous bare member records both candidate owners for the warning")
  } else { run Testing.expect(false, "module documentation is retained") }
  let privateModules = List<Module>.asSlice(&private.modules)
  if let Option<Document>.Some {value} = &privateModules[0].documentation {
    run Testing.expect(List<Link>.length(&value.links) == 6, "include-private does not change imported namespace visibility or bare-member precedence")
  } else { run Testing.expect(false, "private extraction retains module documentation") }
  return ()
}

test effect fn documentationAttachmentPrivacyAndCanonicalAliases() -> ()
! Error | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run attachmentClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn conditionalProfile(debug: bool) -> FinalProfile
! Error | ProfileProblem | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut input = Input.make()
  input.target = Option<Bytes>.some(run Bytes.copy(b"x86_64-unknown-linux-gnu"))
  input.debug = Option<bool>.some(debug)
  let profile = run FinalProfile.publish(run InitialProfile.freeze(&input), List<RegisteredShape>.asSlice(&List<RegisteredShape>.make()), List<Entry>.make(), List<DeclarationId>.asSlice(&List<DeclarationId>.make()))
  return match move profile {
    Result<FinalProfile, FinalProblem>.Success {value} => move value
    Result<FinalProfile, FinalProblem>.Failure {error: _} => { fail Error.InvalidSources }
  }
}

effect fn conditionalClaims() -> ()
! Error | ProfileProblem | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let root = run ModuleId.make(b"memory", b"docs", b"conditional.silk")
  let source = Option<Bytes>.some(run Bytes.copy(String.utf8Bytes("""//! The profile selects [`Selected`].
//!
//! @category  Profile surfaces 
static if Intrinsic.profileFlag("debug") {
  /// Debug-only surface.
  pub struct Selected {pub debug: u32}
} else {
  /// Release-only surface.
  pub enum Selected {Release}
}
static if false {
  /// Never admitted, even with private documentation enabled.
  pub fn absent() { return unknown }
}
""")))
  let revision = run Revision.publish(&Revision.make(), &root, &source)
  let mut roots = List<ModuleId>.make()
  run List<ModuleId>.append(&mut roots, ModuleId.copy(&root))
  let mut paths = List<Bytes>.make()
  run List<Bytes>.append(&mut paths, run Bytes.copy(b"conditional.silk"))
  let target = Target.forId(Id.X8664UnknownLinuxGnu)
  let mut debug = Semantic.oneShot(run Revision.copy(&revision), target, Option<FinalProfile>.some(run conditionalProfile(true)))
  let mut release = Semantic.oneShot(move revision, target, Option<FinalProfile>.some(run conditionalProfile(false)))
  let debugProject = run Extraction.extract(&mut debug, List<ModuleId>.asSlice(&roots), List<Bytes>.asSlice(&paths), Target.name(&target), b"debug", true)
  let releaseProject = run Extraction.extract(&mut release, List<ModuleId>.asSlice(&roots), List<Bytes>.asSlice(&paths), Target.name(&target), b"release", true)
  let debugModule = &List<Module>.asSlice(&debugProject.modules)[0]
  let releaseModule = &List<Module>.asSlice(&releaseProject.modules)[0]
  let debugItems = List<Item>.asSlice(&debugModule.items)
  let releaseItems = List<Item>.asSlice(&releaseModule.items)
  let debugSelected = findItem(debugItems, b"Selected")
  let releaseSelected = findItem(releaseItems, b"Selected")
  run Testing.expect(debugSelected != usize.MAX && releaseSelected != usize.MAX, "each final profile admits its own declaration")
  run Testing.expect(equal(Bytes.asSlice(&debugItems[debugSelected].kind), b"Struct") && equal(Bytes.asSlice(&releaseItems[releaseSelected].kind), b"Enum"), "profile selection changes the emitted surface")
  run Testing.expect(findItem(debugItems, b"absent") == usize.MAX && findItem(releaseItems, b"absent") == usize.MAX, "include-private cannot admit inactive source")
  run Testing.expect(!equal(Bytes.asSlice(&debugItems[debugSelected].id), Bytes.asSlice(&releaseItems[releaseSelected].id)), "distinct canonical declarations never collide by spelling")
  if let Option<Document>.Some {value} = &debugModule.documentation {
    run Testing.expect(equal(Bytes.asSlice(&value.markdown), b"The profile selects [`Selected`].") && List<usize>.length(&value.lineStarts) == usize.ONE, "the category line and its blank separator leave the module markdown")
  }
  let category = match &debugModule.category { Option<Bytes>.Some {value} => equal(Bytes.asSlice(&value), b"Profile surfaces") Option<Bytes>.None => false }
  run Testing.expect(category, "a final @category line names the trimmed module category")
  if let Option<Document>.Some {value} = &debugModule.documentation { run Testing.expect(linksTo(&value, b"Selected", Bytes.asSlice(&debugItems[debugSelected].id)), "debug link selects debug declaration") }
  else { run Testing.expect(false, "debug module comment exists") }
  if let Option<Document>.Some {value} = &releaseModule.documentation { run Testing.expect(linksTo(&value, b"Selected", Bytes.asSlice(&releaseItems[releaseSelected].id)), "release link selects release declaration") }
  else { run Testing.expect(false, "release module comment exists") }
  return ()
}

test effect fn documentationFinalProfileSelectsSurfaceAndLinks() -> ()
! Error | ProfileProblem | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run conditionalClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

// Each mode changes an independently retained JSON string; the valid mode preserves multibyte
// prose. Invalid comment bytes are legal lexer trivia, so these failures belong to extraction.
effect fn invalidTextCase(mode: usize) -> ()
! Error | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let root = run ModuleId.make(b"memory", b"docs", b"text.silk")
  let mut source = run Bytes.copy(String.utf8Bytes("""/// Doc é.X.
pub fn sample( // Header Y.
  value: u32
) -> u32 { return unknown }
"""))
  let mut path = run Bytes.copy(b"path.silk")
  let mut target = run Bytes.copy(b"x86_64-unknown-linux-gnu")
  let mut profile = run Bytes.copy(b"fixture")
  let mut expectedField = b"markdown"
  let mut expectedOffset = usize.ZERO
  if mode < 2 {
    let bytes = Bytes.asMutSlice(&mut source)
    let mut marker: u8 = 89
    if mode == usize.ZERO { marker = 88 }
    while expectedOffset < bytes.length && bytes[expectedOffset] != marker { expectedOffset = expectedOffset + usize.ONE }
    run Testing.expect(expectedOffset < bytes.length, "the corruption marker is present in the authored fixture")
    bytes[expectedOffset] = 255
    if mode == usize.ONE { expectedField = b"signature" }
  } else if mode == 2 {
    let bytes = Bytes.asMutSlice(&mut path)
    bytes[usize.ONE] = 255
    expectedField = b"sourcePath"
    expectedOffset = usize.ONE
  } else if mode == 3 {
    let bytes = Bytes.asMutSlice(&mut target)
    bytes[usize.ZERO] = 255
    expectedField = b"target"
  } else if mode == 4 {
    let bytes = Bytes.asMutSlice(&mut profile)
    bytes[usize.ZERO] = 255
    expectedField = b"profile"
  }
  let revision = run Revision.publish(&Revision.make(), &root, &Option<Bytes>.some(move source))
  let mut store = Semantic.oneShot(move revision, Target.forId(Id.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut roots = List<ModuleId>.make()
  run List<ModuleId>.append(&mut roots, ModuleId.copy(&root))
  let mut paths = List<Bytes>.make()
  run List<Bytes>.append(&mut paths, move path)
  let extracted = run Effect.result(Extraction.extract(&mut store, List<ModuleId>.asSlice(&roots), List<Bytes>.asSlice(&paths), Bytes.asSlice(&target), Bytes.asSlice(&profile), false))
  match move extracted {
    Result<Project, Error | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError>.Success {value} => {
      run Testing.expect(mode == 5, "invalid retained UTF-8 cannot produce a successful documentation model")
      let items = List<Item>.asSlice(&List<Module>.asSlice(&value.modules)[0].items)
      let sample = findItem(items, b"sample")
      run Testing.expect(sample != usize.MAX && documentationIs(&items[sample], String.utf8Bytes("Doc é.X.")), "valid multibyte documentation remains byte-for-byte intact")
    }
    Result<Project, Error | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      Error failure => match move failure {
        Error.InvalidText {sourcePath, field, offset} => {
          run Testing.expect(mode < 5 && equal(field, expectedField) && offset == expectedOffset, "invalid text identifies the retained field and exact offending byte")
          let mut pathMatches = equal(Bytes.asSlice(&sourcePath), Bytes.asSlice(&List<Bytes>.asSlice(&paths)[0]))
          if mode == 3 || mode == 4 { pathMatches = Bytes.length(&sourcePath) == usize.ZERO }
          run Testing.expect(pathMatches, "invalid source text retains its raw source-path diagnostic identity")
        }
        _ => { run Testing.expect(false, "malformed retained text must fail with InvalidText, not a syntax or semantic rejection") }
      }
      InvalidModulePath failure => { fail move failure }
      Cycle failure => { fail move failure }
      RevisionMismatch failure => { fail move failure }
      OutOfMemoryError failure => { fail move failure }
    }
  }
  return ()
}

effect fn invalidTextClaims() -> ()
! Error | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let mut mode = usize.ZERO
  while mode < 6 {
    run invalidTextCase(mode)
    mode = mode + usize.ONE
  }
  return ()
}

test effect fn documentationRejectsInvalidRetainedUtf8() -> ()
! Error | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run invalidTextClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn irrelevantImportClaims() -> ()
! Error | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let root = run ModuleId.make(b"memory", b"docs", b"api/root.silk")
  let qualified = run ModuleId.sibling(&root, b"api/qualified.silk")
  let platform = run ModuleId.sibling(&root, b"platform.silk")
  let prose = Option<Bytes>.some(run Bytes.copy(String.utf8Bytes("""//! Plain module prose without symbol references.
import platform {Unavailable}
/// Plain item prose without symbol references.
pub struct Visible {}
""")))
  let dotted = Option<Bytes>.some(run Bytes.copy(String.utf8Bytes("""//! An unresolved qualified reference [`missing.member`] is not a bare-member lookup.
import platform {Unavailable}
pub struct Other {}
""")))
  let platformSource = Option<Bytes>.some(run Bytes.copy(String.utf8Bytes("""static if Intrinsic.targetPointerBits() == 64 {
  pub struct Unavailable {}
}
""")))
  let first = run Revision.publish(&Revision.make(), &root, &prose)
  let second = run Revision.publish(&first, &qualified, &dotted)
  let revision = run Revision.publish(&second, &platform, &platformSource)
  let target = Target.forId(Id.Wasm32UnknownUnknown)
  let mut store = Semantic.oneShot(move revision, target, Option<FinalProfile>.none())
  let mut roots = List<ModuleId>.make()
  run List<ModuleId>.append(&mut roots, ModuleId.copy(&root))
  run List<ModuleId>.append(&mut roots, ModuleId.copy(&qualified))
  let mut paths = List<Bytes>.make()
  run List<Bytes>.append(&mut paths, run Bytes.copy(b"api/root.silk"))
  run List<Bytes>.append(&mut paths, run Bytes.copy(b"api/qualified.silk"))
  let extracted = run Extraction.extract(&mut store, List<ModuleId>.asSlice(&roots), List<Bytes>.asSlice(&paths), Target.name(&target), b"wasm", true)
  let modules = List<Module>.asSlice(&extracted.modules)
  run Testing.expect(modules.length == 2, "irrelevant private imports do not enroll a link-resolution demand")
  run Testing.expect(equal(Bytes.asSlice(&modules[0].name), b"api/root") && equal(Bytes.asSlice(&modules[1].name), b"api/qualified"), "documentation module identities preserve canonical path separators")
  let items = List<Item>.asSlice(&modules[0].items)
  let visible = findItem(items, b"Visible")
  run Testing.expect(visible != usize.MAX && documentationIs(&items[visible], b"Plain item prose without symbol references."), "plain item docs survive unavailable private imported names")
  if let Option<Document>.Some {value} = &modules[0].documentation {
    run Testing.expect(List<Link>.length(&value.links) == usize.ZERO, "plain module prose has no link work")
  } else { run Testing.expect(false, "plain module prose is retained") }
  if let Option<Document>.Some {value} = &modules[1].documentation {
    run Testing.expect(List<Link>.length(&value.links) == usize.ZERO, "an unresolved dotted name does not discover unrelated owners")
  } else { run Testing.expect(false, "qualified-reference prose is retained") }
  // Negative control: the import really is unavailable in this same store/profile. Project
  // validation still rejects it when requested explicitly; extraction did not suppress a failure.
  let mut request = Request.forApplication(ModuleId.copy(&root))
  let rejected = run Semantic.moduleImportRejections(&mut store, &mut request, &root)
  let rejections = List<Shared<Rejection>>.asSlice(&rejected)
  run Testing.expect(rejections.length == usize.ONE, "strict project import validation retains the unavailable member")
  let unavailable = Shared<Rejection>.with<bool>(&rejections[0], fn(rejection: &Rejection) -> bool {
    return rejection.code == RejectionCode.UnknownImportedMember
  })
  run Testing.expect(unavailable, "the control reaches the missing selected import, not an unrelated failure")
  return ()
}

test effect fn documentationDefersIrrelevantImportsAndKeepsCanonicalModulePaths() -> ()
! Error | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run irrelevantImportClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}
