//! Independent byte-for-byte oracles for native Markdown preservation, exact fenced examples,
//! source mapping, and canonical identity links. These need no compiler subprocess.
import documentation.Markdown
import documentation.MarkdownBlocks
import documentation.Model { Document, Project, Module, Item, Link, Source }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.option { Option }
import silk.text.string { String }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize
import silk.collections.list { List }

// A source comment starts at byte 100, line 7; each normalized line loses four marker bytes.
effect fn document(text: &[u8]) -> Document ! OutOfMemoryError ? &mut Allocator {
  let mut starts = List<usize>.make()
  run List<usize>.append(&mut starts, 100)
  let mut at = usize.ZERO
  let mut lines = usize.ZERO
  while at < text.length {
    if text[at] == 10 {
      lines = lines + usize.ONE
      run List<usize>.append(&mut starts, 100 + at + usize.ONE + lines * 4)
    }
    at = at + usize.ONE
  }
  return Document { markdown: run Bytes.copy(text), source: Source { start: 100, end: 100 + text.length + lines * 4, line: 7 }, lineStarts: move starts, links: List<Link>.make(), ambiguous: List<Link>.make() }
}
fn emptyProject() -> Project { return Project { target: Bytes.make(), profile: Bytes.make(), modules: List<Module>.make() } }

effect fn fences() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let input = """
# Examples

## Boundary
````silk
```
let x = 1
````

> ~~~silk,ignore,unknown
> let y = 2
> ~~~

    ```silk
    not an example
    ```

- ```silk,ignore
  let z = 3
  ```
"""
  let doc = run document(MarkdownBlocks.trim(String.utf8Bytes(input)))
  let examples = run Markdown.examples(&doc)
  let values = List<Markdown.Example>.asSlice(&examples)
  run Testing.expect(values.length == 3, "nested fences are examples but fence-looking indented code is not")
  run Testing.expect(MarkdownBlocks.same(Bytes.asSlice(&values[0].code), b"""```
let x = 1"""), "a shorter internal fence cannot close a longer opener")
  run Testing.expect(!values[0].invalid && !values[0].ignored, "plain Silk executes")
  run Testing.expect(values[1].invalid && values[1].ignored, "unknown attributes remain invalid when ignore is also present")
  run Testing.expect(MarkdownBlocks.same(Bytes.asSlice(&values[1].info), b"silk,ignore,unknown") && MarkdownBlocks.same(Bytes.asSlice(&values[1].code), b"let y = 2"), "quote prefixes are structural, not example code")
  run Testing.expect(values[2].ignored && !values[2].invalid && MarkdownBlocks.same(Bytes.asSlice(&values[2].code), b"let z = 3"), "list indentation is removed exactly once")
  // The first fence starts on normalized line four: byte offset 24 plus three removed markers.
  run Testing.expect(values[0].source.line == 10 && values[0].source.start == 136 && values[0].source.end == 175, "example source covers opening through closing fence in original comment bytes")
  let unfinished = run document(b"""```silk ignore
let x = 1
""")
  let open = run Markdown.examples(&unfinished)
  let last = List<Markdown.Example>.asSlice(&open)
  run Testing.expect(last.length == usize.ONE && last[0].invalid && MarkdownBlocks.same(Bytes.asSlice(&last[0].code), b"let x = 1"), "unterminated fences close at document end and full info attributes are not discarded")
}
test effect fn exactFencesAndSourcePositions() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fences() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn links() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let mut doc = run document(b"""# Details

See [`target`] and [`missing`].

```text
[`target`]
```
""")
  run List<Link>.append(&mut doc.links, Link { spelling: run Bytes.copy(b"target"), target: run Bytes.copy(b"pkg/B::target") })
  let mut project = emptyProject()
  run List<Module>.append(&mut project.modules, Module { name: run Bytes.copy(b"pkg/A"), sourcePath: Bytes.make(), documentation: Option<Document>.none(), category: Option<Bytes>.none(), items: List<Item>.make() })
  let mut items = List<Item>.make()
  run List<Item>.append(&mut items, Item { id: run Bytes.copy(b"pkg/B::target"), kind: run Bytes.copy(b"Function"), name: run Bytes.copy(b"target"), visibility: run Bytes.copy(b"Public"), signature: Bytes.make(), source: Source { start: 0, end: 0, line: 1 }, parent: Option<usize>.none(), documentation: Option<Document>.none() })
  run List<Module>.append(&mut project.modules, Module { name: run Bytes.copy(b"pkg/B"), sourcePath: Bytes.make(), documentation: Option<Document>.none(), category: Option<Bytes>.none(), items: move items })
  let reference = run Markdown.reference(&doc, &project, 0, 2)
  run Testing.expect(MarkdownBlocks.same(Bytes.asSlice(&reference), b"""### Details

See [`target`](./b.md#target) and `missing`.

```text
[`target`]
```
"""), "reference adjusts headings and resolved identities without touching fence contents")
  let found = run Markdown.symbols(&doc)
  let values = List<Markdown.Symbol>.asSlice(&found)
  run Testing.expect(values.length == 2 && MarkdownBlocks.same(Bytes.asSlice(&values[0].spelling), b"target"), "semantic links exclude code blocks")
  let escaped = run document(b"\\[`not`] [`explicit`](https://example.test) `[`code`]` and [`yes`]")
  let escapedFound = run Markdown.symbols(&escaped)
  run Testing.expect(List<Markdown.Symbol>.asSlice(&escapedFound).length == usize.ONE, "escaped brackets, explicit links and inline code never become semantic links")
  let references = run document(b"""[label][id] and ![alt](https://image.test) and [`explicit`][id]
[`shortcut`] and ![`image`] and [`collapsed`][]

[id]: https://reference.test "Title"
[`shortcut`]: https://shortcut.test
[`image`]: https://image-shortcut.test
[`collapsed`]: https://collapsed.test
""")
  let rendered = run Markdown.reference(&references, &project, 0, 0)
  run Testing.expect(MarkdownBlocks.same(Bytes.asSlice(&rendered), Bytes.asSlice(&references.markdown)), "authored reference definitions and image links pass through unchanged")
  let referenceSymbols = run Markdown.symbols(&references)
  run Testing.expect(List<Markdown.Symbol>.asSlice(&referenceSymbols).length == usize.ZERO, "full, collapsed, shortcut and image reference links are not semantic code links")
}
test effect fn canonicalLinksAndAuthoredReference() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run links() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn structure() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let input = b"""Heading
=======

> Quote with \\*literal\\* and &#65;.
>
> - first
> - second

3. third
4. fourth

---

    <code> & literal

hard  
break
"""
  let doc = run document(input)
  let project = emptyProject()
  let rendered = run Markdown.reference(&doc, &project, 0, 2)
  let expected = b"""### Heading

> Quote with \\*literal\\* and &#65;.
>
> - first
> - second

3. third
4. fourth

---

    <code> & literal

hard  
break
"""
  run Testing.expect(MarkdownBlocks.same(Bytes.asSlice(&rendered), expected), "heading adjustment preserves authored quotes, lists, escapes, entities, indented code and hard breaks")
  let multiline = run document(b"""  A  summary
with\tmultiple spaces.  
""")
  let summary = run Markdown.summary(&multiline)
  run Testing.expect(MarkdownBlocks.same(Bytes.asSlice(&summary), b"A summary with multiple spaces."), "index summaries collapse whitespace to one line without a prose policy")
  let authored = run Markdown.reference(&multiline, &project, 0, 0)
  run Testing.expect(MarkdownBlocks.same(Bytes.asSlice(&authored), Bytes.asSlice(&multiline.markdown)), "summary normalization does not alter the authored reference body")
}
effect fn item(kind: &[u8], name: &[u8], parent: Option<usize>) -> Item ! OutOfMemoryError ? &mut Allocator {
  return Item { id: run Bytes.copy(name), kind: run Bytes.copy(kind), name: run Bytes.copy(name), visibility: run Bytes.copy(b"Public"), signature: Bytes.make(), source: Source { start: 0, end: 0, line: 1 }, parent: move parent, documentation: Option<Document>.none() }
}
effect fn anchors() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let mut items = List<Item>.make()
  run List<Item>.append(&mut items, run item(b"Union", b"Error", Option<usize>.none()))
  run List<Item>.append(&mut items, run item(b"UnionVariant", b"Invalid", Option<usize>.some(0)))
  run List<Item>.append(&mut items, run item(b"Implementation", b"Drop for silk.mem.box.Box<T>", Option<usize>.none()))
  run List<Item>.append(&mut items, run item(b"Operation", b"drop", Option<usize>.some(2)))
  run List<Item>.append(&mut items, run item(b"Implementation", b"Drop for Box<T>", Option<usize>.none()))
  run List<Item>.append(&mut items, run item(b"Operation", b"drop", Option<usize>.some(4)))
  run List<Item>.append(&mut items, run item(b"Implementation", b"Box<T>", Option<usize>.none()))
  run List<Item>.append(&mut items, run item(b"Method", b"make", Option<usize>.some(6)))
  run List<Item>.append(&mut items, run item(b"Implementation", b"", Option<usize>.none()))
  let listed = List<Item>.asSlice(&items)
  let variant = run Markdown.anchor(listed, 1)
  let implementation = run Markdown.anchor(listed, 2)
  let first = run Markdown.anchor(listed, 3)
  let second = run Markdown.anchor(listed, 4)
  let repeated = run Markdown.anchor(listed, 5)
  let inherent = run Markdown.anchor(listed, 6)
  let method = run Markdown.anchor(listed, 7)
  let unnamed = run Markdown.anchor(listed, 8)
  run Testing.expect(MarkdownBlocks.same(Bytes.asSlice(&variant), b"Error.Invalid") && MarkdownBlocks.same(Bytes.asSlice(&first), b"Box.impl.Drop.drop"), "anchors spell the item's owner path within its module")
  run Testing.expect(MarkdownBlocks.same(Bytes.asSlice(&implementation), b"Box.impl.Drop") && MarkdownBlocks.same(Bytes.asSlice(&inherent), b"Box.impl") && MarkdownBlocks.same(Bytes.asSlice(&method), b"Box.impl.make"), "implementation anchors name the owner type and the implemented interface")
  run Testing.expect(MarkdownBlocks.same(Bytes.asSlice(&second), b"Box.impl.Drop-2") && MarkdownBlocks.same(Bytes.asSlice(&repeated), b"Box.impl.Drop.drop-2"), "repeated owner paths are numbered in source order")
  run Testing.expect(MarkdownBlocks.same(Bytes.asSlice(&unnamed), b"impl"), "an implementation without a named owner keeps the bare impl anchor")
}
test effect fn referencePreservesAuthoredContainers() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run structure() |> Effect.provideMut<Allocator>(&mut allocator)
  run anchors() |> Effect.provideMut<Allocator>(&mut allocator)
}
