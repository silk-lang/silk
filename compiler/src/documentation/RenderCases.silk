//! Behavioral contracts for the native JSON and profile-aware Markdown reference boundaries.
import documentation.Model {Project, Module, Item, Document, DecodeError}
import documentation.Model
import documentation.Reference {File, Group, ManifestEntry, RenderError}
import documentation.Reference
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.option {Option}
import silk.result {Result}
import silk.slice {Slice}
import silk.testing {AssertionError, Testing}
import silk.usize
import silk.vector {Vector}

fn contains(source: &[u8], needle: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at <= source.length {
    if needle.length <= source.length - at && Model.equal(Slice.view(source, at, needle.length), needle) { return true }
    at = at + usize.ONE
  }
  return false
}

fn content<'a>(files: &'a [File], path: &[u8]) -> &'a [u8] {
  let mut at = usize.ZERO
  while at < files.length {
    if Model.equal(Bytes.asSlice(&files[at].path), path) { return Bytes.asSlice(&files[at].content) }
    at = at + usize.ONE
  }
  return b""
}

effect fn wrap(modules: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut result = run Bytes.copy(b"{\"schema\":\"silk-documentation\",\"experimental\":true,\"version\":1,\"target\":\"aarch64-apple-darwin\",\"profile\":\"darwin\",\"modules\":[")
  run Bytes.append(&mut result, modules)
  run Bytes.append(&mut result, b"]}")
  return move result
}

effect fn rejects(input: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let decoded = run Effect.result(Model.decode(input))
  return match move decoded {
    Result<Project, DecodeError | OutOfMemoryError>.Success { value: _ } => false
    Result<Project, DecodeError | OutOfMemoryError>.Failure { error } => match move error {
      DecodeError invalid => { drop invalid
        return true }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

effect fn modelBoundary() -> () ! AssertionError<'static> | DecodeError | OutOfMemoryError ? &mut Allocator {
  let raw = run wrap(b"{\"name\":\"silk/a\",\"sourcePath\":\"a.silk\",\"documentation\":{\"markdown\":\"Hello \\\"world\\\".\\nSecond\",\"source\":{\"start\":4,\"end\":40,\"line\":2},\"links\":[],\"lineStarts\":[8,28]},\"items\":[{\"id\":\"a:owner\",\"kind\":\"Struct\",\"name\":\"Owner\",\"visibility\":\"Public\",\"signature\":\"pub struct Owner {}\",\"source\":{\"start\":41,\"end\":100,\"line\":5}},{\"id\":\"a:field\",\"kind\":\"Field\",\"name\":\"field\",\"visibility\":\"Inherited\",\"signature\":\"field: i32\",\"source\":{\"start\":60,\"end\":70,\"line\":6},\"parent\":0}]}")
  let project = run Model.decode(Bytes.asSlice(&raw))
  let encoded = run Model.encode(&project)
  let decoded = run Model.decode(Bytes.asSlice(&encoded))
  let module = &Vector<Module>.asSlice(&decoded.modules)[0]
  let items = Vector<Item>.asSlice(&module.items)
  run Testing.expect(Model.equal(Bytes.asSlice(&module.name), b"silk/a") && items.length == 2, "JSON roundtrip retains module identity and item count")
  run Testing.expect(Model.equal(Bytes.asSlice(&items[1].signature), b"field: i32") && items[1].source.start == 60, "JSON roundtrip preserves nested declaration signature and byte location")
  let parent = match &items[1].parent { Option<usize>.None => false Option<usize>.Some { value } => value == usize.ZERO }
  run Testing.expect(parent, "JSON parent index survives roundtrip")
  let docs = match &module.documentation {
    Option<Document>.None => false
    Option<Document>.Some { value } => Model.equal(Bytes.asSlice(&value.markdown), b"Hello \"world\".\nSecond") && Vector<usize>.asSlice(&value.lineStarts)[1] == 28
  }
  run Testing.expect(docs, "JSON escaped strings and original source line map survive roundtrip")

  let invalidRoots = [
    b"{}",
    b"{\"schema\":\"silk-documentation\",\"experimental\":true,\"version\":2,\"target\":\"x\",\"profile\":\"p\",\"modules\":[]}",
    b"{\"schema\":\"silk-documentation\",\"experimental\":true,\"version\":1,\"target\":\"x\",\"profile\":\"p\",\"modules\":[],\"surprise\":0}",
    b"{\"schema\":\"silk-documentation\",\"experimental\":true,\"version\":1,\"target\":\"x\",\"profile\":\"p\",\"modules\":[],\"modules\":[]}",
    b"{\"schema\":\"silk-documentation\",\"experimental\":true,\"version\":1,\"target\":\"x\",\"profile\":\"p\",\"modules\":[]} null",
  ]
  let mut at = usize.ZERO
  while at < invalidRoots.length {
    run Testing.expect(run rejects(invalidRoots[at]), "strict JSON rejects unsupported, extra, duplicate, missing and trailing input")
    at = at + usize.ONE
  }
  let invalidModules = [
    b"{\"name\":\"a\",\"sourcePath\":\"a.silk\",\"items\":[],\"documentation\":null}",
    b"{\"name\":\"a\",\"sourcePath\":\"a.silk\",\"items\":[]},{\"name\":\"a\",\"sourcePath\":\"b.silk\",\"items\":[]}",
    b"{\"name\":\"a\",\"sourcePath\":\"a.silk\",\"items\":[],\"documentation\":{\"markdown\":\"two\\nlines\",\"source\":{\"start\":0,\"end\":30,\"line\":1},\"links\":[],\"lineStarts\":[0]}}",
    b"{\"name\":\"a\",\"sourcePath\":\"a.silk\",\"items\":[],\"documentation\":{\"markdown\":\"two\\nlines\",\"source\":{\"start\":0,\"end\":30,\"line\":1},\"links\":[],\"lineStarts\":[10,5]}}",
    b"{\"name\":\"a\",\"sourcePath\":\"a.silk\",\"items\":[{\"id\":\"a:x\",\"kind\":\"Function\",\"name\":\"x\",\"visibility\":\"Public\",\"signature\":\"fn x()\",\"source\":{\"start\":8,\"end\":1,\"line\":1}}]}",
    b"{\"name\":\"a\",\"sourcePath\":\"a.silk\",\"items\":[{\"id\":\"a:x\",\"kind\":\"Function\",\"name\":\"x\",\"visibility\":\"Public\",\"signature\":\"fn x()\",\"source\":{\"start\":0,\"end\":1,\"line\":0}}]}",
    b"{\"name\":\"a\",\"sourcePath\":\"a.silk\",\"items\":[{\"id\":\"a:x\",\"kind\":\"Function\",\"name\":\"x\",\"visibility\":\"Public\",\"signature\":\"fn x()\",\"source\":{\"start\":0,\"end\":18446744073709551616,\"line\":1}}]}",
    b"{\"name\":\"a\",\"sourcePath\":\"a.silk\",\"items\":[{\"id\":\"a:x\",\"kind\":\"Function\",\"name\":\"x\",\"visibility\":\"Public\",\"signature\":\"fn x()\",\"source\":{\"start\":0,\"end\":10,\"line\":1},\"parent\":0}]}",
    b"{\"name\":\"a\",\"sourcePath\":\"a.silk\",\"items\":[{\"id\":\"a:x\",\"kind\":\"Struct\",\"name\":\"x\",\"visibility\":\"Public\",\"signature\":\"struct x\",\"source\":{\"start\":0,\"end\":10,\"line\":1}},{\"id\":\"a:y\",\"kind\":\"Field\",\"name\":\"y\",\"visibility\":\"Inherited\",\"signature\":\"y: i32\",\"source\":{\"start\":11,\"end\":12,\"line\":1},\"parent\":0}]}",
  ]
  at = usize.ZERO
  while at < invalidModules.length {
    let value = run wrap(invalidModules[at])
    run Testing.expect(run rejects(Bytes.asSlice(&value)), "strict model rejects invalid documents, parent indices and source ranges")
    at = at + usize.ONE
  }
}

test effect fn nativeDocumentationJsonBoundary() -> () ! AssertionError<'static> | DecodeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run modelBoundary() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn profileProject(second: bool) -> Project ! DecodeError | OutOfMemoryError ? &mut Allocator {
  let mut raw = run wrap(b"{\"name\":\"silk/a_b\",\"sourcePath\":\"a.silk\",\"documentation\":{\"markdown\":\"See [`B`].\\n\\n```text\\n(./b.md#declaration-62)\\n(./silk-doc-link-1.md#declaration-62)\\n```\\n\\n[authored](./b.md#declaration-62)\",\"source\":{\"start\":0,\"end\":300,\"line\":1},\"links\":[{\"spelling\":\"B\",\"target\":\"b\"}],\"lineStarts\":[0,20,25,40,80,130,140,150]},\"items\":[{\"id\":\"a\",\"kind\":\"Function\",\"name\":\"a_b\",\"visibility\":\"Public\",\"signature\":\"pub fn a_b() -> ()\",\"source\":{\"start\":301,\"end\":400,\"line\":10}}]}")
  // Construct the second module before closing the outer array, keeping fixture text independent
  // of the encoder under test.
  let original = Bytes.asSlice(&raw)
  let mut combined = run Bytes.copy(Slice.view(original, usize.ZERO, original.length - 2))
  run Bytes.append(&mut combined, b",{\"name\":\"silk/b\",\"sourcePath\":\"b.silk\",\"items\":[{\"id\":\"b\",\"kind\":\"Struct\",\"name\":\"B\",\"visibility\":\"Public\",\"signature\":")
  if second { run Bytes.append(&mut combined, b"\"pub struct B { value: i64 }\"") } else { run Bytes.append(&mut combined, b"\"pub struct B { value: i32 }\"") }
  run Bytes.append(&mut combined, b",\"source\":{\"start\":0,\"end\":80,\"line\":1}}]}]}")
  let mut project = run Model.decode(Bytes.asSlice(&combined))
  if second { project.profile = run Bytes.copy(b"linux-no-libc")
    project.target = run Bytes.copy(b"x86_64-unknown-linux") }
  return move project
}

effect fn manifest() -> Vector<ManifestEntry> ! OutOfMemoryError ? &mut Allocator {
  let mut entries = Vector<ManifestEntry>.make()
  run Vector<ManifestEntry>.append(&mut entries, ManifestEntry { module: run Bytes.copy(b"silk/a_b"), namespace: Option<Bytes>.some(run Bytes.copy(b"a_b")) })
  run Vector<ManifestEntry>.append(&mut entries, ManifestEntry { module: run Bytes.copy(b"silk/b"), namespace: Option<Bytes>.none() })
  return move entries
}

effect fn references() -> () ! AssertionError<'static> | DecodeError | RenderError | OutOfMemoryError ? &mut Allocator {
  let first = run profileProject(false)
  let second = run profileProject(true)
  let manifest = run manifest()
  let mut groups = Vector<Group>.make()
  run Vector<Group>.append(&mut groups, run Reference.capture(&first, Vector<ManifestEntry>.asSlice(&manifest)))
  run Vector<Group>.append(&mut groups, run Reference.capture(&second, Vector<ManifestEntry>.asSlice(&manifest)))
  let files = run Reference.merge(Vector<Group>.asSlice(&groups), Vector<ManifestEntry>.asSlice(&manifest))
  let listed = Vector<File>.asSlice(&files)
  let firstPage = content(listed, b"a-b.md")
  let secondPage = content(listed, b"a-b.profile-2.md")
  run Testing.expect(contains(firstPage, b"# `silk/a_b`") && contains(firstPage, b"`import silk.a_b { a_b }`") && contains(firstPage, b"## `a_b`"), "reference code spans preserve underscore spelling in module/import/item identities")
  run Testing.expect(contains(firstPage, b"[`B`](./b.md#B)") && contains(secondPage, b"[`B`](./b.profile-2.md#B)"), "a shared-looking source page splits when resolved links point at different profile variants")
  run Testing.expect(contains(secondPage, b"```text\n(./b.md#declaration-62)\n(./silk-doc-link-1.md#declaration-62)\n```") && contains(secondPage, b"[authored](./b.md#declaration-62)"), "profile merging preserves authored links and code including marker-looking literals")
  run Testing.expect(contains(content(listed, b"b.profile-2.md"), b"value: i64") && contains(content(listed, b"index.md"), b"linux-no-libc") && contains(content(listed, b"index.md"), b"x86_64-unknown-linux"), "all profile surfaces and target identities remain published")
  run Testing.expect(!contains(content(listed, b"b.md"), b"Import as") && contains(content(listed, b"index.md"), b") | Not applicable |"), "modules without a recommended namespace remain documented without fabricated import guidance")
  let collisionRaw = run wrap(b"{\"name\":\"one/x\",\"sourcePath\":\"x.silk\",\"items\":[]},{\"name\":\"two/x\",\"sourcePath\":\"y.silk\",\"items\":[]}")
  let collision = run Model.decode(Bytes.asSlice(&collisionRaw))
  let mut entries = Vector<ManifestEntry>.make()
  run Vector<ManifestEntry>.append(&mut entries, ManifestEntry { module: run Bytes.copy(b"one/x"), namespace: Option<Bytes>.some(run Bytes.copy(b"x")) })
  run Vector<ManifestEntry>.append(&mut entries, ManifestEntry { module: run Bytes.copy(b"two/x"), namespace: Option<Bytes>.some(run Bytes.copy(b"y")) })
  let result = run Effect.result(Reference.capture(&collision, Vector<ManifestEntry>.asSlice(&entries)))
  let refused = match move result {
    Result<Group, RenderError | OutOfMemoryError>.Success { value: _ } => false
    Result<Group, RenderError | OutOfMemoryError>.Failure { error } => match move error {
      RenderError rejected => true
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(refused, "reference path collisions fail instead of overwriting")
}

test effect fn nativeReferenceProfilesPreserveLinksAndAuthoredCode() -> () ! AssertionError<'static> | DecodeError | RenderError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run references() |> Effect.provideMut<Allocator>(&mut allocator)
}

