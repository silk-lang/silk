//! Native documentation workflows and their stable 0/1/2 command statuses.

import diagnostic.JsonText
import documentation.Doctest
import documentation.Doctest {Outcome, Summary}
import documentation.Markdown
import documentation.FileSet
import documentation.Model {Project, DecodeError, Document, Item, Link, Module}
import documentation.Model
import documentation.Project as Extraction {Error as ExtractionError}
import documentation.Reference {File, Group, ManifestEntry, RenderError}
import documentation.Reference
import documentation.Session as Sessions {Error as SessionError, Failure, Library}
import semantic.ModuleId {ModuleId}
import semantic.Target {Target, Id as TargetId}
import semantic.Types {Types}
import semantic.Rejection {Rejection}
import silk.format {Format}
import driver.Project as Projects {Member, Project as Package, ProjectError, Workspace}
import driver.CommandPath
import driver.InstalledCompiler
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.system.filesystem {FileSystem, FileError, Path}
import silk.system.host_input {HostInput, HostInputError}
import silk.option {Option}
import silk.core.result {Result}
import silk.mem.shared {Shared}
import silk.collections.list {List}
import silk.io.writer_native {StderrWriter}
import silk.io.writer {Writer, WriterError}

/// One native documentation workflow.
pub enum Kind { Doc, Doctest, Reference }

/// Parsed command options. `--stdlib` is always boolean; `--stdlib-root` is always a path.
pub struct Command {
  pub kind: Kind,
  pub manifest: Option<Bytes>,
  pub input: Option<Bytes>,
  pub output: Option<Bytes>,
  pub target: Option<Bytes>,
  pub libraryRoot: Option<Bytes>,
  pub sourceRoot: Option<Bytes>,
  pub stdlib: bool,
  pub includePrivate: bool,
  pub check: bool,
  pub help: bool,
}

/// Typed failures from source, model, renderer, process-input and output boundaries.
pub type Error = SessionError | DecodeError | RenderError | HostInputError | WriterError

pub fn present(value: &Option<Bytes>) -> bool { return match &value.* { Option<Bytes>.Some {..} => true Option<Bytes>.None => false } }

effect fn option(slot: &mut Option<Bytes>, arguments: &[Bytes], at: &mut usize) -> () ! Failure | OutOfMemoryError ? &mut Allocator {
  if present(&slot.*) || at.* + 1 >= arguments.length { fail Failure {message: b"duplicate option or missing option value", status: 2} }
  at.* = at.* + 1
  let value = Bytes.asSlice(&arguments[at.*])
  if value.length == 0 || value[0] == 45 { fail Failure {message: b"missing option value (use ./ for paths beginning with a dash)", status: 2} }
  slot.* = Option<Bytes>.some(run Bytes.copy(value))
}

/// Parses only the selected workflow's flags; paths never ambiguously consume `--stdlib`.
pub effect fn make(selector: &[u8], arguments: &[Bytes]) -> Command ! Failure | OutOfMemoryError ? &mut Allocator {
  let mut kind = Kind.Doc
  if Sessions.same(selector, b"doctest") { kind = Kind.Doctest }
  else if Sessions.same(selector, b"doc-reference") { kind = Kind.Reference }
  else if !Sessions.same(selector, b"doc") { fail Failure {message: b"unknown documentation command", status: 2} }
  let mut command = Command {kind: kind, manifest: Option<Bytes>.none(), input: Option<Bytes>.none(), output: Option<Bytes>.none(), target: Option<Bytes>.none(), libraryRoot: Option<Bytes>.none(), sourceRoot: Option<Bytes>.none(), stdlib: false, includePrivate: false, check: false, help: false}
  let mut at: usize = 0
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    if Sessions.same(argument, b"--help") || Sessions.same(argument, b"-h") { command.help = true }
    else if Sessions.same(argument, b"--manifest-path") && (kind == Kind.Doc || kind == Kind.Doctest) { run option(&mut command.manifest, arguments, &mut at) }
    else if (Sessions.same(argument, b"--input") || Sessions.same(argument, b"-i")) && kind == Kind.Doctest { run option(&mut command.input, arguments, &mut at) }
    else if (Sessions.same(argument, b"--output") || Sessions.same(argument, b"-o")) && kind != Kind.Doctest { run option(&mut command.output, arguments, &mut at) }
    else if Sessions.same(argument, b"--target") && kind != Kind.Reference { run option(&mut command.target, arguments, &mut at) }
    else if Sessions.same(argument, b"--stdlib-root") { run option(&mut command.libraryRoot, arguments, &mut at) }
    else if Sessions.same(argument, b"--source-root") && kind == Kind.Doctest { run option(&mut command.sourceRoot, arguments, &mut at) }
    else if Sessions.same(argument, b"--stdlib") && (kind == Kind.Doc || kind == Kind.Doctest) { command.stdlib = true }
    else if Sessions.same(argument, b"--include-private") && kind == Kind.Doc { command.includePrivate = true }
    else if Sessions.same(argument, b"--check") && kind == Kind.Reference { command.check = true }
    else { fail Failure {message: b"unknown option for documentation command", status: 2} }
    at = at + 1
  }
  if command.help { return move command }
  if command.stdlib && (present(&command.input) || present(&command.manifest)) { fail Failure {message: b"--stdlib conflicts with --input and --manifest-path", status: 2} }
  if present(&command.input) && present(&command.manifest) { fail Failure {message: b"--input conflicts with --manifest-path", status: 2} }
  if kind == Kind.Reference && !present(&command.output) { fail Failure {message: b"doc-reference requires --output", status: 2} }
  return move command
}

static if Intrinsic.targetOperatingSystem() == "darwin" {
  fn host() -> Target { return Target.forId(TargetId.Aarch64AppleDarwin) }
} else {
  static if Intrinsic.targetArchitecture() == "aarch64" {
    fn host() -> Target { return Target.forId(TargetId.Aarch64UnknownLinuxGnu) }
  } else {
    fn host() -> Target { return Target.forId(TargetId.X8664UnknownLinuxGnu) }
  }
}

fn selected<'a>(value: &'a Option<Bytes>, fallback: &'a [u8]) -> &'a [u8] {
  return match &value.* { Option<Bytes>.Some {value: written} => Bytes.asSlice(&written) Option<Bytes>.None => fallback }
}

effect fn libraryPath(command: &Command, working: &Path, executable: &[u8]) -> Path ! Error ? &mut HostInput | &mut FileSystem | &mut Allocator {
  if let Option<Bytes>.Some {value} = &command.libraryRoot { return run CommandPath.resolve(working, Bytes.asSlice(&value)) }
  let search = run HostInput.variable(b"PATH")
  let borrowed = match &search { Option<Bytes>.Some {value} => Option<&[u8]>.some(Bytes.asSlice(&value)) Option<Bytes>.None => Option<&[u8]>.none() }
  return match move run InstalledCompiler.standardLibrary(working, executable, move borrowed) {
    Option<Path>.Some {value} => move value
    Option<Path>.None => { fail Failure {message: b"no installed standard library; pass --stdlib-root <directory>", status: 2} }
  }
}

// The name of the package whose manifest is nearest above `root`, so examples import its modules
// by that name; none when no package manifest is found there.
effect fn packageName(root: &Path) -> Option<Bytes> ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let found = run Effect.result(Projects.discover(root))
  let manifest = match move found {
    Result<Path, ProjectError | FileError | OutOfMemoryError>.Success {value} => move value
    Result<Path, ProjectError | FileError | OutOfMemoryError>.Failure {error} => match move error {
      ProjectError missing => {
        drop missing
        return Option<Bytes>.none()
      }
      FileError unreadable => {
        drop unreadable
        return Option<Bytes>.none()
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let loaded = run Effect.result(Projects.load(&manifest))
  return match move loaded {
    Result<Package, ProjectError | FileError | OutOfMemoryError>.Success {value} => Option<Bytes>.some(run Bytes.copy(Projects.name(&value)))
    Result<Package, ProjectError | FileError | OutOfMemoryError>.Failure {error} => match move error {
      ProjectError invalid => {
        drop invalid
        return Option<Bytes>.none()
      }
      FileError unreadable => {
        drop unreadable
        return Option<Bytes>.none()
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

effect fn loadModel(command: &Command, working: &Path) -> Project ! Error ? &mut FileSystem | &mut Allocator {
  let input = run CommandPath.resolve(working, selected(&command.input, b""))
  let bytes = run FileSystem.readFile(&input)
  return run Model.decode(Bytes.asSlice(&bytes))
}

effect fn doctestModel(command: &Command, library: &Library, working: &Path) -> Project
! Error ? &mut FileSystem | &mut Allocator | &mut Types {
  if command.stdlib {
    let hostTarget = host()
    let target = selected(&command.target, Target.name(&hostTarget))
    return run Sessions.extractLibrary(library, target, target, false, true)
  }
  return run loadModel(command, working)
}

effect fn reference(command: &Command, library: &Library, working: &Path) -> i32 ! Error ? &mut FileSystem | &mut Allocator | &mut Types | &mut Writer {
  let targets: [&[u8]; 8] = [b"aarch64-apple-darwin", b"aarch64-unknown-linux-gnu", b"aarch64-unknown-linux-gnu", b"x86_64-unknown-linux-gnu", b"x86_64-unknown-linux-gnu", b"wasm32-unknown-unknown", b"wasm32-wasip1", b"wasm32-wasip2"]
  let mut groups = List<Group>.make()
  let manifest = List<ManifestEntry>.asSlice(&library.manifest)
  let mut at: usize = 0
  while at < targets.length {
    let noLibc = at == 2 || at == 4
    let mut name = run Bytes.copy(targets[at])
    if noLibc { run Bytes.append(&mut name, b"-no-libc") }
    let project = run Sessions.extractLibrary(library, targets[at], Bytes.asSlice(&name), noLibc, false)
    // Capture owns only rendered files. The project and semantic session die each iteration.
    run List<Group>.append(&mut groups, run Reference.capture(&project, manifest))
    at = at + 1
  }
  let files = run Reference.merge(List<Group>.asSlice(&groups), manifest)
  let output = run CommandPath.resolve(working, selected(&command.output, b""))
  return run FileSet.apply(&output, List<File>.asSlice(&files), command.check)
}

// Appends one warning for each link of `document`, in the module at `path`, that names nothing
// or names several declarations.
effect fn appendUnresolved(out: &mut Bytes, path: &[u8], document: &Document) -> () ! OutOfMemoryError ? &mut Allocator {
  let symbols = run Markdown.symbols(document)
  let listed = List<Markdown.Symbol>.asSlice(&symbols)
  let resolved = List<Link>.asSlice(&document.links)
  let mut at: usize = 0
  while at < listed.length {
    let spelling = Bytes.asSlice(&listed[at].spelling)
    let mut found = false
    let mut link: usize = 0
    while link < resolved.length {
      if Sessions.same(Bytes.asSlice(&resolved[link].spelling), spelling) { found = true }
      link = link + 1
    }
    if !found {
      let ambiguous = List<Link>.asSlice(&document.ambiguous)
      let mut candidates = ambiguous.length
      let mut entry: usize = 0
      while entry < ambiguous.length {
        if Sessions.same(Bytes.asSlice(&ambiguous[entry].spelling), spelling) { candidates = entry break }
        entry = entry + 1
      }
      run Bytes.append(&mut out.*, b"warning: ")
      run Bytes.append(&mut out.*, path)
      run Bytes.append(&mut out.*, b":")
      run JsonText.appendDecimal(&mut out.*, listed[at].source.line)
      run Bytes.append(&mut out.*, b": documentation link [`")
      run Bytes.append(&mut out.*, spelling)
      if candidates < ambiguous.length {
        run Bytes.append(&mut out.*, b"`] is ambiguous: it could name ")
        run Bytes.append(&mut out.*, Bytes.asSlice(&ambiguous[candidates].target))
        run Bytes.append(&mut out.*, b"; qualify it with the owner, and until then it stays plain code\n")
      } else {
        run Bytes.append(&mut out.*, b"`] names no declaration and stays plain code\n")
      }
    }
    at = at + 1
  }
}

/// One warning line for each documentation link of `project` that resolves to no declaration.
pub effect fn unresolvedLinks(project: &Project) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut out = Bytes.make()
  let modules = List<Module>.asSlice(&project.modules)
  let mut at: usize = 0
  while at < modules.length {
    let path = Bytes.asSlice(&modules[at].sourcePath)
    if let Option<Document>.Some {value} = &modules[at].documentation { run appendUnresolved(&mut out, path, &value) }
    let items = List<Item>.asSlice(&modules[at].items)
    let mut item: usize = 0
    while item < items.length {
      if let Option<Document>.Some {value} = &items[item].documentation { run appendUnresolved(&mut out, path, &value) }
      item = item + 1
    }
    at = at + 1
  }
  return move out
}

// Extracts one package's documentation model and publishes it at `destination`.
effect fn documentPackage(command: &Command, package: &Package, libraryRoot: Path, destination: &Path) -> ()
! Error ? &mut HostInput | &mut FileSystem | &mut Allocator | &mut Writer | &mut Types {
  let mut session = run Sessions.package(package, Option<Path>.some(move libraryRoot), &command.target, host())
  let project = run Sessions.extractPackage(&mut session, command.includePrivate)
  // A broken link only stays plain code in the output, so it is named on standard error.
  let warnings = run unresolvedLinks(&project)
  if Bytes.length(&warnings) > 0 {
    let mut stderr = StderrWriter.make()
    run Writer.writeAll(Bytes.asSlice(&warnings)) |> Effect.provideMut<Writer>(&mut stderr)
  }
  let bytes = run Model.encode(&project)
  run FileSet.publish(destination, Bytes.asSlice(&bytes))
  run Writer.writeAll(b"Documentation: ")
  run Writer.writeAll(Path.rawBytes(destination))
  run Writer.writeAll(b"\n")
}

/// One package's checked examples. With running, each runnable example is left pending for the
/// caller to build against `package` and run.
pub struct PackageExamples {
  pub outcomes: List<Outcome>,
  pub package: Package,
  pub libraryRoot: Path,
  /// Whether the package is one member of a workspace whose root was selected, so its results
  /// follow a heading that names it.
  pub member: bool,
}

/// Whether `command` checks the examples of a package rather than a model file or the standard
/// library.
pub fn packageDoctest(command: &Command) -> bool {
  return command.kind == Kind.Doctest && !command.help && !command.stdlib && !present(&command.input)
}

// Checks the examples of the package at the discovered or named manifest, extracting its
// documentation in memory and resolving its imports against its own source root. A manifest that
// only defines a workspace checks each member with a `[package].root`, in dependency order.
// Examples run only on the host, so `running` holds only without a foreign `--target`.
effect fn doctestPackages(command: &Command, libraryRoot: &Path, working: &Path, running: bool) -> List<PackageExamples>
! Error ? &mut HostInput | &mut FileSystem | &mut Allocator | &mut Writer | &mut Types {
  let manifest = match &command.manifest {
    Option<Bytes>.Some {value} => run CommandPath.resolve(working, Bytes.asSlice(&value))
    Option<Bytes>.None => run Projects.discover(working)
  }
  let mut packages = List<PackageExamples>.make()
  if let Option<Workspace>.Some {value: workspace} = move run Projects.workspace(&manifest) {
    if !workspace.packaged {
      let members = List<Member>.asSlice(&workspace.members)
      let mut at: usize = 0
      while at < members.length {
        if members[at].rooted {
          let member = run Path.join(&members[at].directory, "silk.toml")
          let package = run Projects.load(&member)
          run List<PackageExamples>.append(&mut packages, run doctestPackage(command, move package, libraryRoot, running, true))
        }
        at = at + 1
      }
      return move packages
    }
  }
  let package = run Projects.load(&manifest)
  run List<PackageExamples>.append(&mut packages, run doctestPackage(command, move package, libraryRoot, running, false))
  return move packages
}

effect fn doctestPackage(command: &Command, package: Package, libraryRoot: &Path, running: bool, member: bool) -> PackageExamples
! Error ? &mut HostInput | &mut FileSystem | &mut Allocator | &mut Writer | &mut Types {
  let library = run Sessions.library(libraryRoot)
  let copied = run Path.fromBytes(Path.rawBytes(libraryRoot))
  let mut session = run Sessions.package(&package, Option<Path>.some(move copied), &command.target, host())
  let project = run Sessions.extractPackage(&mut session, false)
  let mut revision = move library.revision
  let root = Projects.sourceRoot(&package)
  let owner = run ModuleId.make(b"file", b"documentation", b"doctest/example.silk")
  run Sessions.publishTree(&mut revision, root, root, &owner)
  let name = Option<Bytes>.some(run Bytes.copy(Projects.name(&package)))
  let hostTarget = host()
  let runs = running && Sessions.same(selected(&command.target, Target.name(&hostTarget)), Target.name(&hostTarget))
  let outcomes = run Doctest.collect(&project, &revision, &command.target, &name, runs)
  return PackageExamples {outcomes: move outcomes, package: move package, libraryRoot: run Path.fromBytes(Path.rawBytes(libraryRoot)), member: member}
}

/// Adds one package's counts to the workspace's, so a member with no examples fails the command
/// only when no member has any.
pub fn combine(total: &mut Summary, summary: &Summary) -> () {
  total.collected = total.collected + summary.collected
  total.passed = total.passed + summary.passed
  total.skipped = total.skipped + summary.skipped
  total.failed = total.failed + summary.failed
}

/// Writes the line that names a workspace member before its results.
pub effect fn heading(package: &Package) -> () ! WriterError ? &mut Writer {
  run Writer.writeAll(b"Package ")
  run Writer.writeAll(Projects.name(package))
  run Writer.writeAll(b"\n")
}

/// Reads `silk doctest`'s arguments and, when they select a package or a workspace's members,
/// checks their examples and leaves each one with a `main` pending for the caller to build and
/// run; none for the other forms, which [`runHost`] serves.
pub effect fn packageExamples() -> Option<List<PackageExamples>>
! Error ? &mut HostInput | &mut FileSystem | &mut Allocator | &mut Writer | &mut Types {
  let mut arguments = run HostInput.arguments()
  if List<Bytes>.length(&arguments) < 2 { fail Failure {message: b"missing command arguments", status: 2} }
  let executable = List<Bytes>.remove(&mut arguments, 0)
  drop List<Bytes>.remove(&mut arguments, 0)
  let command = run make(b"doctest", List<Bytes>.asSlice(&arguments))
  if !packageDoctest(&command) { return Option<List<PackageExamples>>.none() }
  let directory = run HostInput.workingDirectory()
  let working = run Path.fromBytes(Bytes.asSlice(&directory))
  let libraryRoot = run libraryPath(&command, &working, Bytes.asSlice(&executable))
  return Option<List<PackageExamples>>.some(run doctestPackages(&command, &libraryRoot, &working, true))
}

/// Reports `error` from the `selector` command as [`runHost`] does and answers its status.
pub effect fn failed(selector: &[u8], error: Error) -> i32 ! never ? &mut Writer | &mut Allocator {
  return match move run Effect.result(report(selector, move error)) {
    Result<i32, WriterError | OutOfMemoryError>.Success {value} => value
    Result<i32, WriterError | OutOfMemoryError>.Failure {error: _} => 2
  }
}

/// Executes an already parsed request against host services, with no bootstrap process.
pub effect fn execute(command: &Command, working: &Path, executable: &[u8]) -> i32
! Error ? &mut HostInput | &mut FileSystem | &mut Allocator | &mut Writer | &mut Types {
  if command.help {
    run Writer.writeAll(b"silk doc [--manifest-path PATH] [-o JSON] [--include-private] [--target TARGET] [--stdlib] [--stdlib-root PATH]\nsilk doctest [--manifest-path PATH] [--target TARGET] [--stdlib-root PATH]\nsilk doctest (--stdlib | -i JSON) [--source-root PATH] [--target TARGET] [--stdlib-root PATH]\nsilk doc-reference [--stdlib-root PATH] -o DIRECTORY [--check]\n")
    return 0
  }
  let libraryRoot = run libraryPath(command, working, executable)
  if command.kind == Kind.Doc && !command.stdlib {
    let manifest = match &command.manifest {
      Option<Bytes>.Some {value} => run CommandPath.resolve(working, Bytes.asSlice(&value))
      Option<Bytes>.None => run Projects.discover(working)
    }
    // A manifest that only defines a workspace documents each member whose root module exists, to
    // `<output-dir>/documentation/<name>.json` below the workspace's shared output directory.
    if let Option<Workspace>.Some {value: workspace} = move run Projects.workspace(&manifest) {
      if !workspace.packaged {
        if present(&command.output) {
          fail Failure {message: b"--output names one file; at a workspace root, pass --manifest-path <member>/silk.toml", status: 2}
        }
        let directory = run Path.join(&workspace.outputDirectory, "documentation")
        let members = List<Member>.asSlice(&workspace.members)
        let mut at: usize = 0
        while at < members.length {
          if members[at].rooted {
            let member = run Path.join(&members[at].directory, "silk.toml")
            let package = run Projects.load(&member)
            let mut file = run Bytes.copy(Bytes.asSlice(&members[at].name))
            run Bytes.append(&mut file, b".json")
            let destination = run Path.joinBytes(&directory, Bytes.asSlice(&file))
            let library = run Path.fromBytes(Path.rawBytes(&libraryRoot))
            run documentPackage(command, &package, move library, &destination)
          }
          at = at + 1
        }
        return 0
      }
    }
    let package = run Projects.load(&manifest)
    let destination = match &command.output {
      Option<Bytes>.Some {value} => run CommandPath.resolve(Projects.directory(&package), Bytes.asSlice(&value))
      Option<Bytes>.None => run Path.join(Projects.outputDirectory(&package), "documentation.json")
    }
    run documentPackage(command, &package, move libraryRoot, &destination)
    return 0
  }
  if packageDoctest(command) {
    let packages = run doctestPackages(command, &libraryRoot, working, false)
    let listed = List<PackageExamples>.asSlice(&packages)
    let mut total = Summary {collected: 0, passed: 0, skipped: 0, failed: 0}
    let mut at: usize = 0
    while at < listed.length {
      if listed[at].member { run heading(&listed[at].package) }
      let summary = run Doctest.report(List<Outcome>.asSlice(&listed[at].outcomes))
      combine(&mut total, &summary)
      at = at + 1
    }
    return Doctest.status(&total)
  }
  let library = run Sessions.library(&libraryRoot)
  if command.kind == Kind.Reference { return run reference(command, &library, working) }
  if command.kind == Kind.Doctest {
    let project = run doctestModel(command, &library, working)
    let mut revision = move library.revision
    let mut package = Option<Bytes>.none()
    if let Option<Bytes>.Some {value} = &command.sourceRoot {
      let root = run CommandPath.resolve(working, Bytes.asSlice(&value))
      let owner = run ModuleId.make(b"file", b"documentation", b"doctest/example.silk")
      run Sessions.publishTree(&mut revision, &root, &root, &owner)
      package = run packageName(&root)
    }
    let summary = run Doctest.execute(&project, &revision, &command.target, &package)
    return Doctest.status(&summary)
  }
  let hostTarget = host()
  let target = selected(&command.target, Target.name(&hostTarget))
  let project = run Sessions.extractLibrary(&library, target, target, false, command.includePrivate)
  let bytes = run Model.encode(&project)
  let destination = run CommandPath.resolve(working, selected(&command.output, b"documentation.json"))
  run FileSet.publish(&destination, Bytes.asSlice(&bytes))
  return 0
}

effect fn fromHost(selector: &[u8]) -> i32 ! Error
? &mut HostInput | &mut FileSystem | &mut Allocator | &mut Writer | &mut Types {
  let mut arguments = run HostInput.arguments()
  if List<Bytes>.length(&arguments) < 2 { fail Failure {message: b"missing command arguments", status: 2} }
  let executable = List<Bytes>.remove(&mut arguments, 0)
  drop List<Bytes>.remove(&mut arguments, 0)
  let command = run make(selector, List<Bytes>.asSlice(&arguments))
  let directory = run HostInput.workingDirectory()
  let working = run Path.fromBytes(Bytes.asSlice(&directory))
  return run execute(&command, &working, Bytes.asSlice(&executable))
}

// Names the command that failed, as `silk doctest: ` or `silk doc: `.
effect fn prefix(selector: &[u8]) -> () ! WriterError ? &mut Writer {
  run Writer.writeAll(b"silk ")
  run Writer.writeAll(selector)
  run Writer.writeAll(b": ")
}

effect fn report(selector: &[u8], error: Error) -> i32 ! WriterError | OutOfMemoryError ? &mut Writer | &mut Allocator {
  let mut status: i32 = 2
  match move error {
    Failure value => { run prefix(selector) run Writer.writeAll(value.message) status = value.status }
    DecodeError value => { run prefix(selector) run Writer.writeAll(value.message) }
    RenderError value => { run prefix(selector) run Writer.writeAll(value.message) status = 1 }
    ExtractionError value => {
      status = 1
      match move value {
        ExtractionError.Rejected {rejection} => {
          run prefix(selector)
          let module = Shared<Rejection>.with<ModuleId>(&rejection, fn(value: &Rejection) -> ModuleId { return ModuleId.copy(&value.module) })
          let path = run ModuleId.copyPath(&module)
          let start = Shared<Rejection>.with<usize>(&rejection, fn(value: &Rejection) -> usize { return value.span.start })
          run Writer.writeAll(Bytes.asSlice(&path))
          run Writer.writeAll(b" at byte ")
          run Format.display<usize>(&start)
          run Writer.writeAll(b": ")
          let name = Shared<Rejection>.with<&'static [u8]>(&rejection, fn(value: &Rejection) -> &'static [u8] { return Rejection.name(value.code) })
          run Writer.writeAll(name)
        }
        // A rendered rejection stands alone, as `silk check` prints it.
        ExtractionError.Reported {text} => { run Writer.writeAll(Bytes.asSlice(&text)) }
        ExtractionError.MissingSource => { run prefix(selector) run Writer.writeAll(b"documentation source missing") status = 2 }
        ExtractionError.InvalidSources => { run prefix(selector) run Writer.writeAll(b"invalid documentation source mapping") }
        ExtractionError.InvalidText {sourcePath, field, offset} => {
          status = 2
          run prefix(selector)
          run Writer.writeAll(Bytes.asSlice(&sourcePath))
          run Writer.writeAll(b": invalid UTF-8 in ")
          run Writer.writeAll(field)
          run Writer.writeAll(b" at byte ")
          run Format.display<usize>(&offset)
        }
      }
    }
    OutOfMemoryError value => { drop value run prefix(selector) run Writer.writeAll(b"allocation failure") }
    FileError value => {
      run prefix(selector)
      run Writer.writeAll(b"filesystem operation ")
      run Format.display<i32>(&value.operation.code)
      run Writer.writeAll(b" failed (reason ")
      run Format.display<i32>(&value.reason.code)
      run Writer.writeAll(b")")
    }
    HostInputError value => { drop value run prefix(selector) run Writer.writeAll(b"cannot read process arguments or working directory") }
    ProjectError value => {
      run prefix(selector)
      match move value {
        ProjectError.InvalidManifest {manifest, line: _, detail} => {
          run Writer.writeAll(b"invalid project manifest ")
          run Writer.writeAll(Path.rawBytes(&manifest))
          run Writer.writeAll(b": ")
          run Writer.writeAll(Bytes.asSlice(&detail))
        }
        ProjectError.ManifestNotFound {start} => {
          run Writer.writeAll(b"no silk.toml found from ")
          run Writer.writeAll(Path.rawBytes(&start))
        }
        _ => { run Writer.writeAll(b"invalid project, target, profile, source, or compiler analysis") }
      }
    }
    WriterError value => { fail move value }
    _ => { run prefix(selector) run Writer.writeAll(b"invalid project, target, profile, source, or compiler analysis") }
  }
  run Writer.writeAll(b"\n")
  return status
}

/// Runs the native command, containing every typed failure as stable success/failure/input status.
pub effect fn runHost(selector: &[u8]) -> i32 ! never
? &mut HostInput | &mut FileSystem | &mut Allocator | &mut Writer | &mut Types {
  return match move run Effect.result(fromHost(selector)) {
    Result<i32, Error>.Success {value} => value
    Result<i32, Error>.Failure {error} => {
      return match move run Effect.result(report(selector, move error)) {
        Result<i32, WriterError | OutOfMemoryError>.Success {value} => value
        Result<i32, WriterError | OutOfMemoryError>.Failure {error: _} => 2
      }
    }
  }
}
