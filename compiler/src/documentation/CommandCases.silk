//! Documentation flags and read-only reference checks at their production boundaries.

import documentation.Command as Commands {Command}
import documentation.FileSet
import documentation.Reference {File}
import documentation.Session as Sessions {Failure, same, Error}
import documentation.Project {Error as ExtractionError}
import documentation.Model {Project as DocProject, Document as DocDocument, Item as DocItem, Link as DocLink, Module as DocModule, Source as DocSource}
import driver.Project as Projects
import semantic.ModuleId {ModuleId}
import semantic.Target {Target, Id as TargetId}
import semantic.Types {TypeTable, Types}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.system.filesystem {AtomicWriteError, Durability, FileSystem, FileError, FileInfo, DirectoryInfo, DirectoryEntry, Path, PublicationPolicy}
import silk.option {Option}
import silk.core.result {Result}
import silk.testing.testing {Testing, AssertionError}
import silk.collections.list {List}
import silk.io.writer {Writer, WriterError}

effect fn words(values: &[&[u8]]) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<Bytes>.make()
  let mut at: usize = 0
  while at < values.length { run List<Bytes>.append(&mut result, run Bytes.copy(values[at])) at = at + 1 }
  return move result
}

effect fn rejects(selector: &[u8], values: &[&[u8]]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let arguments = run words(values)
  return match move run Effect.result(Commands.make(selector, List<Bytes>.asSlice(&arguments))) {
    Result<Command, Failure | OutOfMemoryError>.Success {value: _} => false
    Result<Command, Failure | OutOfMemoryError>.Failure {error} => match move error {
      Failure value => value.status == 2
      OutOfMemoryError value => { fail move value }
    }
  }
}

effect fn flags() -> () ! Failure | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let arguments = run words(&[b"--stdlib", b"--stdlib-root", b"/working/stdlib", b"--target", b"wasm32-unknown-unknown"])
  let command = run Commands.make(b"doctest", List<Bytes>.asSlice(&arguments))
  let rooted = match &command.libraryRoot { Option<Bytes>.Some {value} => same(Bytes.asSlice(&value), b"/working/stdlib") Option<Bytes>.None => false }
  run Testing.expect(command.stdlib && rooted, "boolean stdlib mode and source-root path are independent options")
  run Testing.expect(run rejects(b"doctest", &[b"--stdlib", b"-i", b"input.json"]), "competing doctest inputs are usage failures")
  run Testing.expect(run rejects(b"doctest", &[b"--stdlib", b"/old/ambiguous/path"]), "a path never becomes a boolean stdlib value")
  let bare = run Commands.make(b"doctest", &[])
  run Testing.expect(!bare.stdlib && !Commands.present(&bare.input), "bare doctest checks the package around the working directory")
  let named = run words(&[b"--manifest-path", b"member/silk.toml"])
  let member = run Commands.make(b"doctest", List<Bytes>.asSlice(&named))
  run Testing.expect(Commands.present(&member.manifest), "doctest takes the package's manifest path")
  run Testing.expect(run rejects(b"doctest", &[b"-i", b"input.json", b"--manifest-path", b"silk.toml"]), "a model file and a manifest are competing doctest inputs")
  run Testing.expect(run rejects(b"doctest", &[b"--stdlib", b"--manifest-path", b"silk.toml"]), "the standard library and a manifest are competing doctest inputs")
  run Testing.expect(run rejects(b"doc-reference", &[b"--check"]), "reference output is required")
  run Testing.expect(run rejects(b"doc", &[b"--output", b"a", b"--output", b"b"]), "duplicate valued options are refused")
  run Testing.expect(run rejects(b"doc-reference", &[b"-o", b"out", b"--target", b"wasm32-unknown-unknown"]), "reference always checks all admitted profiles")
  let reference = run words(&[b"--stdlib-root", b"lib", b"-o", b"out", b"--check"])
  let checked = run Commands.make(b"doc-reference", List<Bytes>.asSlice(&reference))
  run Testing.expect(checked.check, "reference check mode is parsed")
}

test effect fn documentationFlagsHaveUnambiguousInputsAndUsageStatus() -> () ! Failure | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run flags() |> Effect.provideMut<Allocator>(&mut allocator)
}

struct Files {
  mutations: usize,
  entry: &'static [u8],
}
impl Files {
  effect fn readFile(self: &mut Self, path: &Path) -> Bytes ! FileError | OutOfMemoryError ? &mut Allocator {
    if same(Path.rawBytes(path), b"/project/silk.toml") { return run Bytes.copy(manifest()) }
    if same(Path.rawBytes(path), b"/project/main.silk") { return run Bytes.copy(self.entry) }
    if same(Path.rawBytes(path), b"/project/helper.silk") { return run Bytes.copy(b"pub param required: u32\npub struct Thing {}\n") }
    if same(Path.rawBytes(path), b"/out/stale.md") { return run Bytes.copy(b"old") }
    if same(Path.rawBytes(path), b"/out/same.md") { return run Bytes.copy(b"same") }
    fail FileSystem.error(FileSystem.readFileOperation(), FileSystem.notFound())
  }
  effect fn writeFile(self: &mut Self, path: &Path, bytes: &[u8]) -> () ! FileError { self.mutations = self.mutations + 1 }
  effect fn writeFileAtomic(self: &mut Self, path: &Path, bytes: &[u8], policy: PublicationPolicy, durability: Durability) -> () ! AtomicWriteError { self.mutations = self.mutations + 1 }
  effect fn stat(self: &mut Self, path: &Path) -> FileInfo | DirectoryInfo ! FileError { return FileSystem.directoryInfo() }
  effect fn listDirectory(self: &mut Self, path: &Path) -> List<DirectoryEntry> ! FileError | OutOfMemoryError ? &mut Allocator {
    let mut entries = List<DirectoryEntry>.make()
    run List<DirectoryEntry>.append(&mut entries, FileSystem.directoryEntry(run Path.make("/out/stale.md"), FileSystem.file()))
    run List<DirectoryEntry>.append(&mut entries, FileSystem.directoryEntry(run Path.make("/out/same.md"), FileSystem.file()))
    run List<DirectoryEntry>.append(&mut entries, FileSystem.directoryEntry(run Path.make("/out/obsolete.md"), FileSystem.file()))
    run List<DirectoryEntry>.append(&mut entries, FileSystem.directoryEntry(run Path.make("/out/keep.txt"), FileSystem.file()))
    return move entries
  }
  effect fn createDirectory(self: &mut Self, path: &Path) -> () ! FileError { self.mutations = self.mutations + 1 }
  effect fn removeFile(self: &mut Self, path: &Path) -> () ! FileError { self.mutations = self.mutations + 1 }
  effect fn removeDirectory(self: &mut Self, path: &Path) -> () ! FileError { self.mutations = self.mutations + 1 }
  effect fn createTemporaryDirectory(self: &mut Self, path: &Path, prefix: &[u8]) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    self.mutations = self.mutations + 1
    fail FileSystem.error(FileSystem.createTemporaryDirectoryOperation(), FileSystem.unsupported())
  }
}
impl FileSystem for Files {
  readFile: Files.readFile
  writeFile: Files.writeFile
  createFile: Files.writeFile
  writeFileAtomic: Files.writeFileAtomic
  syncDirectory: Files.createDirectory
  stat: Files.stat
  listDirectory: Files.listDirectory
  createDirectory: Files.createDirectory
  removeFile: Files.removeFile
  removeDirectory: Files.removeDirectory
  createTemporaryDirectory: Files.createTemporaryDirectory
}

struct Output {
  missing: bool,
  stale: bool,
  extra: bool,
  unexpected: bool,
}
impl Output {
  effect fn writeAll(self: &mut Self, bytes: &[u8]) -> () ! WriterError {
    if same(bytes, b" is missing") { self.missing = true }
    if same(bytes, b" is stale") { self.stale = true }
    if same(bytes, b" is extra or renamed") { self.extra = true }
    if same(bytes, b"/out/keep.txt") || same(bytes, b"/out/same.md") { self.unexpected = true }
  }
  effect fn flush(self: &mut Self) -> () ! WriterError {}
}
impl Writer for Output {
  writeAll: Output.writeAll
  flush: Output.flush
}

effect fn readOnly() -> () ! Failure | FileError | OutOfMemoryError | WriterError | AssertionError<'static> ? &mut Allocator {
  let mut files = Files {mutations: 0, entry: b""}
  let mut output = Output {missing: false, stale: false, extra: false, unexpected: false}
  let root = run Path.make("/out")
  let mut expected = List<File>.make()
  run List<File>.append(&mut expected, File {path: run Bytes.copy(b"missing.md"), content: run Bytes.copy(b"new")})
  run List<File>.append(&mut expected, File {path: run Bytes.copy(b"stale.md"), content: run Bytes.copy(b"new")})
  run List<File>.append(&mut expected, File {path: run Bytes.copy(b"same.md"), content: run Bytes.copy(b"same")})
  let status = run FileSet.apply(&root, List<File>.asSlice(&expected), true)
    |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Writer>(&mut output)
  run Testing.expect(status == 1 && files.mutations == 0, "check detects drift without any write, directory creation or deletion")
  run Testing.expect(output.missing && output.stale && output.extra && !output.unexpected, "missing stale and extra pages are distinct; unchanged pages and unrelated files are ignored")
}

test effect fn referenceCheckReportsMissingStaleExtraWithoutMutation() -> () ! Failure | FileError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run readOnly() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn manifest() -> &'static [u8] {
  return b"[package]\nname = \"documentation-case\"\nversion = \"0.1.0\"\nsource = \".\"\n"
}

effect fn importAndSchemaBoundaries() -> () ! Error | AssertionError<'static> ? &mut Allocator | &mut Types {
  let path = run Path.make("/project/silk.toml")
  let project = run Projects.decode(&path, manifest())
  let mut files = Files {mutations: 0, entry: b"import helper {Thing}\n"}
  let mut session = run Sessions.package(&project, Option<Path>.none(), &Option<Bytes>.none(), Target.forId(TargetId.Wasm32UnknownUnknown))
    |> Effect.provideMut<FileSystem>(&mut files)
  run Testing.expect(List<ModuleId>.length(&session.roots) == 2, "the imported module remains an extraction root without registering its unused required parameter")
  drop run Sessions.extractPackage(&mut session, false) |> Effect.provideMut<FileSystem>(&mut files)
  files.entry = b"import absent {Thing}\n"
  let mut missing = run Sessions.package(&project, Option<Path>.none(), &Option<Bytes>.none(), Target.forId(TargetId.Wasm32UnknownUnknown))
    |> Effect.provideMut<FileSystem>(&mut files)
  let absent = run Effect.result(Sessions.extractPackage(&mut missing, false)) |> Effect.provideMut<FileSystem>(&mut files)
  let absentRejected = match move absent {
    Result<DocProject, Error>.Success {value: _} => false
    Result<DocProject, Error>.Failure {error} => match move error {
      ExtractionError value => match move value {
        ExtractionError.Reported {text} => same(Bytes.asSlice(&text), b"main.silk:1:8: error[MOD0001] Unknown module absent")
        _ => false
      }
      _ => false
    }
  }
  run Testing.expect(absentRejected, "an unused private import of a missing module prevents documentation publication, reported as silk check reports it")
  files.entry = b"import helper {AbsentMember}\n"
  let mut wrongMember = run Sessions.package(&project, Option<Path>.none(), &Option<Bytes>.none(), Target.forId(TargetId.Wasm32UnknownUnknown))
    |> Effect.provideMut<FileSystem>(&mut files)
  let invalid = run Effect.result(Sessions.extractPackage(&mut wrongMember, false)) |> Effect.provideMut<FileSystem>(&mut files)
  let memberRejected = match move invalid {
    Result<DocProject, Error>.Success {value: _} => false
    Result<DocProject, Error>.Failure {error} => match move error {
      ExtractionError value => match move value { ExtractionError.Reported {text: _} => true _ => false }
      _ => false
    }
  }
  run Testing.expect(memberRejected && files.mutations == 0, "an unused private import of a missing member fails without writes")
}

test effect fn projectDocumentationValidatesPrivateImportsWithEntryOnlySchemas() -> () ! Error | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run importAndSchemaBoundaries() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn unresolvedLinkWarnings() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut items = List<DocItem>.make()
  let mut documentation = DocDocument {
    markdown: run Bytes.copy(b"Uses [`Known`] and [`Nope`] and [`size`].\n"),
    source: DocSource {start: 0, end: 30, line: 3}, links: List<DocLink>.make(), lineStarts: List<usize>.make(), ambiguous: List<DocLink>.make(),
  }
  run List<DocLink>.append(&mut documentation.links, DocLink {spelling: run Bytes.copy(b"Known"), target: run Bytes.copy(b"known")})
  run List<DocLink>.append(&mut documentation.ambiguous, DocLink {spelling: run Bytes.copy(b"size"), target: run Bytes.copy(b"`A.size` or `B.size`")})
  run List<DocItem>.append(&mut items, DocItem {
    id: run Bytes.copy(b"f"), kind: run Bytes.copy(b"function"), name: run Bytes.copy(b"f"), visibility: run Bytes.copy(b"pub"),
    signature: Bytes.make(), source: DocSource {start: 0, end: 30, line: 3}, parent: Option<usize>.none(),
    documentation: Option<DocDocument>.some(move documentation),
  })
  let mut modules = List<DocModule>.make()
  run List<DocModule>.append(&mut modules, DocModule {name: run Bytes.copy(b"lib"), sourcePath: run Bytes.copy(b"src/lib.silk"), documentation: Option<DocDocument>.none(), category: Option<Bytes>.none(), items: move items})
  let project = DocProject {target: Bytes.make(), profile: Bytes.make(), modules: move modules}
  let warnings = run Commands.unresolvedLinks(&project)
  run Testing.expect(
    same(Bytes.asSlice(&warnings), b"warning: src/lib.silk:3: documentation link [`Nope`] names no declaration and stays plain code\nwarning: src/lib.silk:3: documentation link [`size`] is ambiguous: it could name `A.size` or `B.size`; qualify it with the owner, and until then it stays plain code\n"),
    "an unresolved link is warned about at its module and line, and an ambiguous one names its candidates",
  )
}

test effect fn unresolvedDocumentationLinksAreWarned() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run unresolvedLinkWarnings() |> Effect.provideMut<Allocator>(&mut allocator)
}
