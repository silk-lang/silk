//! Sequential, source-located checks of complete authored documentation modules.

import documentation.Markdown {Example}
import documentation.Markdown
import documentation.Model {Project, Module, Item, Document}
import documentation.Session as Sessions {Error, Failure}
import diagnostic.JsonText
import diagnostic.Report
import semantic.ModuleId {ModuleId}
import semantic.PackageGraph {PackageGraph}
import semantic.SourceRevision {Revision, Observation}
import semantic.Semantic {Semantic, Request, UncheckedDeclaration}
import semantic.InitialProfile {InitialProfile}
import semantic.FinalProfile {FinalProfile}
import semantic.ProfileBinding {Supplied}
import semantic.Target {Target}
import semantic.Types {Types}
import semantic.Rejection {Rejection, RejectionCode}
import lexer.Span {Span}
import backend.Gap {Gap}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.core.result {Result}
import silk.core.option {Option}
import silk.mem.shared {Shared}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.io.writer {Writer, WriterError}

/// The semantic outcome of one complete module, never an executable or synthesized wrapper.
pub struct Checked {
  pub passed: bool,
  pub diagnostics: Bytes,
}

/// Counts distinguish an empty run from a verified run.
pub struct Summary {
  pub collected: usize,
  pub passed: usize,
  pub skipped: usize,
  pub failed: usize,
}

/// Explicit target takes precedence over model target, then the portable WebAssembly default.
pub fn target<'a>(explicit: &'a Option<Bytes>, project: &'a Project) -> &'a [u8] {
  if let Option<Bytes>.Some {value} = &explicit.* { return Bytes.asSlice(&value) }
  if Bytes.length(&project.target) != 0 { return Bytes.asSlice(&project.target) }
  return b"wasm32-unknown-unknown"
}

/// Empty and failing runs are status 1; a run containing only explicit opt-outs is reported skipped.
pub fn status(summary: &Summary) -> i32 {
  if summary.collected == 0 || summary.failed > 0 { return 1 }
  return 0
}

// One written rejection's code and location, so a rejection several analyses report is written once.
struct Written {
  code: RejectionCode,
  module: ModuleId,
  span: Span,
}

fn writtenOf(value: &Rejection) -> Written {
  return Written {code: value.code, module: ModuleId.copy(&value.module), span: value.span}
}

effect fn diagnostics(out: &mut Bytes, written: &mut List<Written>, rejections: &[Shared<Rejection>], base: &Revision, example: &ModuleId, code: &[u8]) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut at: usize = 0
  while at < rejections.length {
    let site = Shared<Rejection>.with<Written>(&rejections[at], writtenOf)
    let seen = List<Written>.asSlice(&written.*)
    let mut repeated = false
    let mut earlier: usize = 0
    while earlier < seen.length {
      if seen[earlier].code == site.code && ModuleId.equals(&seen[earlier].module, &site.module)
        && seen[earlier].span.start == site.span.start && seen[earlier].span.end == site.span.end {
        repeated = true
      }
      earlier = earlier + 1
    }
    drop seen
    if repeated {
      at = at + 1
      continue
    }
    run List<Written>.append(&mut written.*, move site)
    let module = Shared<Rejection>.with<ModuleId>(&rejections[at], fn(value: &Rejection) -> ModuleId { return ModuleId.copy(&value.module) })
    let actualExample = ModuleId.equals(&module, example)
    let mut imported = Bytes.make()
    let mut path = Bytes.make()
    if !actualExample {
      let observed = run Revision.observe(base, &module)
      if let Option<Bytes>.Some {value} = move run Observation.copyContent(&observed) { imported = move value }
      path = run ModuleId.copyPath(&module)
    }
    let rendered = match actualExample {
      _ if actualExample => run Report.render(&rejections[at], code, b"example")
      _ => run Report.render(&rejections[at], Bytes.asSlice(&imported), Bytes.asSlice(&path))
    }
    if let Option<Bytes>.Some {value} = move rendered {
      run Bytes.append(&mut out.*, Bytes.asSlice(&value))
    } else {
      let name = Shared<Rejection>.with<&'static [u8]>(&rejections[at], fn(value: &Rejection) -> &'static [u8] { return Rejection.name(value.code) })
      run Bytes.append(&mut out.*, name)
    }
    run Bytes.append(&mut out.*, b"\n")
    at = at + 1
  }
}

/// Checks every declaration and import in `code`, with no entry-function demand.
pub effect fn check(base: &Revision, code: &[u8], selectedTarget: &[u8]) -> Checked
! Error ? &mut Allocator | &mut Types {
  return run checkIn(base, code, selectedTarget, &Option<Bytes>.none())
}

/// Checks `code` as [`check`] does, where `package`, when given, names the documented package:
/// an example imports the package's modules by that name, as its users do, or by their paths.
pub effect fn checkIn(base: &Revision, code: &[u8], selectedTarget: &[u8], package: &Option<Bytes>) -> Checked
! Error ? &mut Allocator | &mut Types {
  let identity = run ModuleId.make(b"file", b"documentation", b"doctest/example.silk")
  let content = Option<Bytes>.some(run Bytes.copy(code))
  let revision = run Revision.publish(base, &identity, &content)
  let initial = run Sessions.profile(selectedTarget, false)
  let machine = Target.forId(Target.id(InitialProfile.target(&initial)))
  let mut store = Semantic.oneShot(move revision, machine, Option<FinalProfile>.none())
  let mut graph = PackageGraph.make(&identity)
  if let Option<Bytes>.Some {value: name} = &package.* {
    // A dependent imports a hyphenated package by its name with underscores, so examples do too.
    let mut spelling = run Bytes.copy(Bytes.asSlice(&name))
    let letters = Bytes.asMutSlice(&mut spelling)
    let mut at: usize = 0
    while at < letters.length {
      if letters[at] == 45 { letters[at] = 95 }
      at = at + 1
    }
    run PackageGraph.depend(&mut graph, b"documentation", Bytes.asSlice(&spelling), b"documentation")
  }
  Semantic.selectPackages(&mut store, move graph)
  let mut request = Request.make()
  let configured = run Effect.result(Sessions.configure(&mut store, &mut request, &[ModuleId.copy(&identity)], move initial, List<Supplied>.make()))
  if let Result<(), Error>.Failure {error} = move configured {
    match &error {
      Failure rejected => {
        let mut message = run Bytes.copy(rejected.message)
        run Bytes.append(&mut message, b"\n")
        return Checked {passed: false, diagnostics: move message}
      }
      _ => {}
    }
    fail move error
  }
  let checked = run Semantic.checkDeclarations(&mut store, &mut request, &[ModuleId.copy(&identity)], &Option<ModuleId>.none())
  let imports = run Semantic.importRejections(&mut store, &mut request)
  let syntax = run Semantic.syntaxRejections(&store)
  let mut message = Bytes.make()
  let mut written = List<Written>.make()
  run diagnostics(&mut message, &mut written, List<Shared<Rejection>>.asSlice(&syntax), base, &identity, code)
  run diagnostics(&mut message, &mut written, List<Shared<Rejection>>.asSlice(&imports), base, &identity, code)
  run diagnostics(&mut message, &mut written, List<Shared<Rejection>>.asSlice(&checked.rejections), base, &identity, code)
  if List<Shared<Gap>>.length(&checked.gaps) > 0 {
    run Bytes.append(&mut message, b"compiler cannot completely check this example\n")
  }
  if List<UncheckedDeclaration>.length(&checked.unchecked) > 0 {
    run Bytes.append(&mut message, b"example contains bodies not completely borrow-checked\n")
  }
  let passed = Bytes.length(&message) == 0
  return Checked {passed: passed, diagnostics: move message}
}

/// What became of one example. `Pending` holds the code of a checked example with a `main` that
/// is still to be built and run; [`report`] counts one that was never resolved as failed.
pub union Verdict {
  Passed,
  /// `reason` ends the result line when it is not empty; `details`, such as checker diagnostics
  /// or the program's output, follow on lines of their own.
  Failed {pub reason: Bytes, pub details: Bytes},
  Skipped,
  Pending {pub code: Bytes},
}

/// One example's source location, as `path:line (byte offset)`, and what became of it.
pub struct Outcome {
  pub location: Bytes,
  pub verdict: Verdict,
}

/// Whether `code` declares a `main` at the start of a line, which makes the example a program.
pub fn runnable(code: &[u8]) -> bool {
  let mut at: usize = 0
  while at < code.length {
    let mut start = at
    if Sessions.same(slice(code, start, 4), b"pub ") { start = start + 4 }
    if Sessions.same(slice(code, start, 7), b"effect ") { start = start + 7 }
    if Sessions.same(slice(code, start, 8), b"fn main(") { return true }
    while at < code.length && code[at] != 10 { at = at + 1 }
    at = at + 1
  }
  return false
}

fn slice(code: &[u8], start: usize, length: usize) -> &[u8] {
  if start + length > code.length { return b"" }
  return Slice.view<u8>(code, start, length)
}

effect fn document(outcomes: &mut List<Outcome>, source: &[u8], doc: &Document, base: &Revision, selectedTarget: &[u8], package: &Option<Bytes>, running: bool) -> ()
! Error ? &mut Allocator | &mut Types {
  let examples = run Markdown.examples(doc)
  let listed = List<Example>.asSlice(&examples)
  let mut at: usize = 0
  while at < listed.length {
    let example = &listed[at]
    let mut location = run Bytes.copy(source)
    run Bytes.append(&mut location, b":")
    run JsonText.appendDecimal(&mut location, example.source.line)
    run Bytes.append(&mut location, b" (byte ")
    run JsonText.appendDecimal(&mut location, example.source.start)
    run Bytes.append(&mut location, b")")
    // Validate all attributes before honoring ignore: misspelled opt-outs must fail.
    let mut verdict = Verdict.Skipped
    if example.invalid {
      let mut message = run Bytes.copy(b"unknown Silk fence attribute: ")
      run Bytes.append(&mut message, Bytes.asSlice(&example.info))
      verdict = Verdict.Failed {reason: move message, details: Bytes.make()}
    } else if !example.ignored {
      let checked = run checkIn(base, Bytes.asSlice(&example.code), selectedTarget, package)
      if !checked.passed {
        verdict = Verdict.Failed {reason: Bytes.make(), details: move checked.diagnostics}
      } else if running && !example.noRun && runnable(Bytes.asSlice(&example.code)) {
        verdict = Verdict.Pending {code: run Bytes.copy(Bytes.asSlice(&example.code))}
      } else {
        verdict = Verdict.Passed
      }
    }
    run List<Outcome>.append(&mut outcomes.*, Outcome {location: move location, verdict: move verdict})
    at = at + 1
  }
}

/// Checks examples in module/declaration source order, writing nothing. `package` names the
/// documented package, as [`checkIn`] takes it. With `running`, a checked example that declares a
/// `main`, unless marked `no_run`, is left `Pending` for the caller to build and run.
pub effect fn collect(project: &Project, base: &Revision, explicitTarget: &Option<Bytes>, package: &Option<Bytes>, running: bool) -> List<Outcome>
! Error ? &mut Allocator | &mut Types {
  let selectedTarget = target(explicitTarget, project)
  // Validate even an empty document's requested target rather than returning accidental success.
  drop run Sessions.profile(selectedTarget, false)
  let mut outcomes = List<Outcome>.make()
  let modules = List<Module>.asSlice(&project.modules)
  let mut moduleAt: usize = 0
  while moduleAt < modules.length {
    let module = &modules[moduleAt]
    if let Option<Document>.Some {value} = &module.documentation {
      run document(&mut outcomes, Bytes.asSlice(&module.sourcePath), &value, base, selectedTarget, package, running)
    }
    let items = List<Item>.asSlice(&module.items)
    let mut itemAt: usize = 0
    while itemAt < items.length {
      if let Option<Document>.Some {value} = &items[itemAt].documentation {
        run document(&mut outcomes, Bytes.asSlice(&module.sourcePath), &value, base, selectedTarget, package, running)
      }
      itemAt = itemAt + 1
    }
    moduleAt = moduleAt + 1
  }
  return move outcomes
}

/// Checks examples as [`collect`] does, without running any, and reports them.
pub effect fn execute(project: &Project, base: &Revision, explicitTarget: &Option<Bytes>, package: &Option<Bytes>) -> Summary
! Error | WriterError ? &mut Allocator | &mut Types | &mut Writer {
  let outcomes = run collect(project, base, explicitTarget, package, false)
  return run report(List<Outcome>.asSlice(&outcomes))
}

/// Writes one line for each outcome, in order, then the summary.
pub effect fn report(outcomes: &[Outcome]) -> Summary ! OutOfMemoryError | WriterError ? &mut Allocator | &mut Writer {
  let mut summary = Summary {collected: outcomes.length, passed: 0, skipped: 0, failed: 0}
  let mut at: usize = 0
  while at < outcomes.length {
    run writeOutcome(&mut summary, &outcomes[at])
    at = at + 1
  }
  run writeSummary(&summary)
  return move summary
}

/// Writes `outcome`'s result line, and any details after it, and counts it in `summary`.
pub effect fn writeOutcome(summary: &mut Summary, outcome: &Outcome) -> () ! WriterError ? &mut Writer {
  run Writer.writeAll(Bytes.asSlice(&outcome.location))
  match &outcome.verdict {
    Verdict.Passed => {
      summary.passed = summary.passed + 1
      run Writer.writeAll(b": PASSED\n")
    }
    Verdict.Skipped => {
      summary.skipped = summary.skipped + 1
      run Writer.writeAll(b": SKIPPED\n")
    }
    Verdict.Failed {reason, details} => {
      summary.failed = summary.failed + 1
      run Writer.writeAll(b": FAILED")
      if Bytes.length(&reason) > 0 {
        run Writer.writeAll(b": ")
        run Writer.writeAll(Bytes.asSlice(&reason))
      }
      run Writer.writeAll(b"\n")
      run Writer.writeAll(Bytes.asSlice(&details))
    }
    Verdict.Pending {..} => {
      summary.failed = summary.failed + 1
      run Writer.writeAll(b": FAILED: the example was not run\n")
    }
  }
}

/// Writes the counts line, and says so when nothing was collected.
pub effect fn writeSummary(summary: &Summary) -> () ! OutOfMemoryError | WriterError ? &mut Allocator | &mut Writer {
  let mut text = run Bytes.copy(b"Doctest: ")
  run JsonText.appendDecimal(&mut text, summary.collected)
  run Bytes.append(&mut text, b" collected, ")
  run JsonText.appendDecimal(&mut text, summary.passed)
  run Bytes.append(&mut text, b" passed, ")
  run JsonText.appendDecimal(&mut text, summary.skipped)
  run Bytes.append(&mut text, b" skipped, ")
  run JsonText.appendDecimal(&mut text, summary.failed)
  run Bytes.append(&mut text, b" failed.\n")
  if summary.collected == 0 { run Bytes.append(&mut text, b"No Silk examples collected; nothing was verified.\n") }
  run Writer.writeAll(Bytes.asSlice(&text))
}
