//! Native doctests prove module semantics, attribute ordering, target precedence, and empty runs.

import documentation.Doctest
import documentation.Doctest {Outcome, Verdict}
import documentation.Model {Project, Module, Item, Document, Source, Link}
import documentation.Session {Error, same}
import semantic.SourceRevision {Revision}
import semantic.ModuleId {ModuleId}
import silk.collections.slice {Slice}
import semantic.Types {TypeTable, Types}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.option {Option}
import silk.testing.testing {Testing, AssertionError}
import silk.collections.list {List}
import silk.io.writer {Writer, WriterError}

effect fn completeModules() -> () ! Error | AssertionError<'static> ? &mut Allocator | &mut Types {
  let base = Revision.make()
  let valid = run Doctest.check(&base, b"const answer: i32 = 42\n", b"wasm32-unknown-unknown")
  run Testing.expect(valid.passed, "a declaration-only complete module needs no main or generated wrapper")
  let rejected = run Doctest.check(&base, b"const answer: i32 = true\n", b"wasm32-unknown-unknown")
  run Testing.expect(!rejected.passed && Bytes.length(&rejected.diagnostics) > 0, "semantic type failures are not mistaken for successful parsing")
  let fragment = run Doctest.check(&base, b"return 42\n", b"wasm32-unknown-unknown")
  run Testing.expect(!fragment.passed, "a statement fragment is not silently wrapped into a function")
  let missing = run Doctest.check(&base, b"import absent {Thing}\n", b"wasm32-unknown-unknown")
  run Testing.expect(!missing.passed, "an unresolved unused import prevents a successful example")
}

test effect fn doctestsCheckCompleteModulesWithoutExecutableRoots() -> () ! Error | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run completeModules() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn contains(bytes: &[u8], wanted: &[u8]) -> bool {
  let mut at: usize = 0
  while at + wanted.length <= bytes.length {
    if same(Slice.view<u8>(bytes, at, wanted.length), wanted) { return true }
    at = at + 1
  }
  return false
}

effect fn importedDiagnostics() -> () ! Error | AssertionError<'static> ? &mut Allocator | &mut Types {
  let helper = run ModuleId.make(b"file", b"documentation", b"helper.silk")
  let source = Option<Bytes>.some(run Bytes.copy(b"// first line\n// second line\nimport absent {Missing}\npub struct Thing {}\n"))
  let base = run Revision.publish(&Revision.make(), &helper, &source)
  let checked = run Doctest.check(&base, b"import helper {Thing}\n", b"wasm32-unknown-unknown")
  run Testing.expect(!checked.passed && contains(Bytes.asSlice(&checked.diagnostics), b"helper.silk:3:"), "an imported-module rejection uses the imported source's path and line, not clamped example bytes")
  run Testing.expect(!contains(Bytes.asSlice(&checked.diagnostics), b"example:"), "only rejections owned by the example receive the example label")
}

test effect fn doctestDiagnosticsUseImportedSourceLocations() -> () ! Error | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run importedDiagnostics() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

struct Output {
  firstLocation: bool,
  invalid: bool,
  skipped: bool,
  empty: bool,
  sequence: usize,
}
impl Output {
  effect fn writeAll(self: &mut Self, bytes: &[u8]) -> () ! WriterError {
    if same(bytes, b"library.silk:41 (byte 100)") { self.firstLocation = true }
    if same(bytes, b"unknown Silk fence attribute: silk,ignore,typo") { self.invalid = true self.sequence = 1 }
    if same(bytes, b": SKIPPED\n") { self.skipped = self.sequence == 1 self.sequence = 2 }
    if same(bytes, b"Doctest: 0 collected, 0 passed, 0 skipped, 0 failed.\nNo Silk examples collected; nothing was verified.\n") { self.empty = true }
  }
  effect fn flush(self: &mut Self) -> () ! WriterError {}
}
impl Writer for Output {
  writeAll: Output.writeAll
  flush: Output.flush
}

effect fn ordering() -> () ! Error | WriterError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let mut modules = List<Module>.make()
  let documentation = Document {
    markdown: run Bytes.copy(b"```silk,ignore,typo\nnot a module\n```\n\n```silk,ignore\nnot a module\n```\n"),
    source: Source {start: 100, end: 200, line: 41}, links: List<Link>.make(), lineStarts: List<usize>.make(), ambiguous: List<Link>.make(),
  }
  run List<Module>.append(&mut modules, Module {name: run Bytes.copy(b"library"), sourcePath: run Bytes.copy(b"library.silk"), documentation: Option<Document>.some(move documentation), category: Option<Bytes>.none(), items: List<Item>.make()})
  let mut project = Project {target: run Bytes.copy(b"wasm32-unknown-unknown"), profile: Bytes.make(), modules: move modules}
  let none = Option<Bytes>.none()
  let explicit = Option<Bytes>.some(run Bytes.copy(b"x86_64-unknown-linux-gnu"))
  run Testing.expect(same(Doctest.target(&explicit, &project), b"x86_64-unknown-linux-gnu"), "explicit target wins over the model")
  run Testing.expect(same(Doctest.target(&none, &project), b"wasm32-unknown-unknown"), "model target is used without an override")
  project.target = Bytes.make()
  run Testing.expect(same(Doctest.target(&none, &project), b"wasm32-unknown-unknown"), "absent target uses the portable default")
  let mut output = Output {firstLocation: false, invalid: false, skipped: false, empty: false, sequence: 0}
  let summary = run Doctest.execute(&project, &Revision.make(), &none, &none) |> Effect.provideMut<Writer>(&mut output)
  run Testing.expect(summary.collected == 2 && summary.failed == 1 && summary.skipped == 1 && summary.passed == 0, "unknown attributes fail before ignore while a valid ignore never compiles its fragment")
  run Testing.expect(output.firstLocation && output.invalid && output.skipped, "results retain original byte and line and report sequentially")
  run Testing.expect(Doctest.status(&summary) == 1, "a failing example selects status one")
  let empty = Project {target: Bytes.make(), profile: Bytes.make(), modules: List<Module>.make()}
  let emptySummary = run Doctest.execute(&empty, &Revision.make(), &none, &none) |> Effect.provideMut<Writer>(&mut output)
  run Testing.expect(emptySummary.collected == 0 && Doctest.status(&emptySummary) == 1 && output.empty, "an empty collection explicitly reports nothing verified, never false success")
}

test effect fn doctestsRejectUnknownIgnoredAttributesAndReportSourceOrder() -> () ! Error | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run ordering() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn occurrences(bytes: &[u8], wanted: &[u8]) -> usize {
  let mut count: usize = 0
  let mut at: usize = 0
  while at + wanted.length <= bytes.length {
    if same(Slice.view<u8>(bytes, at, wanted.length), wanted) { count = count + 1 }
    at = at + 1
  }
  return count
}

effect fn packageImports() -> () ! Error | AssertionError<'static> ? &mut Allocator | &mut Types {
  let library = run ModuleId.make(b"file", b"documentation", b"lib.silk")
  let source = Option<Bytes>.some(run Bytes.copy(b"pub struct Circle {}\n"))
  let base = run Revision.publish(&Revision.make(), &library, &source)
  let named = Option<Bytes>.some(run Bytes.copy(b"shapes"))
  let checked = run Doctest.checkIn(&base, b"import shapes.lib {Circle}\n", b"wasm32-unknown-unknown", &named)
  run Testing.expect(checked.passed, "an example imports the documented package's module by the package name")
  let local = run Doctest.checkIn(&base, b"import lib {Circle}\n", b"wasm32-unknown-unknown", &named)
  run Testing.expect(local.passed, "an example still imports the module by its path below the source root")
  let missing = run Doctest.check(&base, b"import absent {Thing}\n", b"wasm32-unknown-unknown")
  run Testing.expect(occurrences(Bytes.asSlice(&missing.diagnostics), b"MOD0001") == 1, "a rejection several analyses report is written once")
}

test effect fn doctestsImportTheirPackageByNameAndReportEachRejectionOnce() -> () ! Error | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run packageImports() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn hyphenatedImports() -> () ! Error | AssertionError<'static> ? &mut Allocator | &mut Types {
  let library = run ModuleId.make(b"file", b"documentation", b"lib.silk")
  let source = Option<Bytes>.some(run Bytes.copy(b"pub struct Circle {}\n"))
  let base = run Revision.publish(&Revision.make(), &library, &source)
  let named = Option<Bytes>.some(run Bytes.copy(b"round-shapes"))
  let checked = run Doctest.checkIn(&base, b"import round_shapes.lib {Circle}\n", b"wasm32-unknown-unknown", &named)
  run Testing.expect(checked.passed, "an example imports a hyphenated package by the name its dependents write")
}

test effect fn doctestsImportAHyphenatedPackageWithUnderscores() -> () ! Error | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run hyphenatedImports() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn programsAreExamplesThatDeclareMain() -> () ! AssertionError<'static> {
  run Testing.expect(Doctest.runnable(b"import lib {x}\n\npub fn main() -> i32 {\n  return 0\n}\n"), "a public main makes a program")
  run Testing.expect(Doctest.runnable(b"pub effect fn main() -> i32 ! WriterError {\n  return 0\n}\n"), "an effectful main makes a program")
  run Testing.expect(Doctest.runnable(b"fn main() -> i32 {\n  return 0\n}"), "a private main is still meant to run, and its build says it must be public")
  run Testing.expect(!Doctest.runnable(b"pub fn mainly() -> i32 {\n  return 0\n}\n// fn main() is not here\n"), "neither another name nor a comment declares main")
}

fn pending(outcome: &Outcome) -> bool {
  return match &outcome.verdict { Verdict.Pending {..} => true _ => false }
}

fn passed(outcome: &Outcome) -> bool {
  return match &outcome.verdict { Verdict.Passed => true _ => false }
}

effect fn runnableExamples() -> () ! Error | AssertionError<'static> ? &mut Allocator | &mut Types {
  let mut modules = List<Module>.make()
  let documentation = Document {
    markdown: run Bytes.copy(b"```silk\npub fn main() -> i32 {\n  return 0\n}\n```\n\n```silk,no_run\npub fn main() -> i32 {\n  return 1\n}\n```\n\n```silk\nconst answer: i32 = 42\n```\n"),
    source: Source {start: 0, end: 10, line: 1}, links: List<Link>.make(), lineStarts: List<usize>.make(), ambiguous: List<Link>.make(),
  }
  run List<Module>.append(&mut modules, Module {name: run Bytes.copy(b"library"), sourcePath: run Bytes.copy(b"library.silk"), documentation: Option<Document>.some(move documentation), category: Option<Bytes>.none(), items: List<Item>.make()})
  let project = Project {target: run Bytes.copy(b"wasm32-unknown-unknown"), profile: Bytes.make(), modules: move modules}
  let none = Option<Bytes>.none()
  let running = run Doctest.collect(&project, &Revision.make(), &none, &none, true)
  let listed = List<Outcome>.asSlice(&running)
  run Testing.expect(listed.length == 3 && pending(&listed[0]), "a checked example with main is left for the caller to run")
  run Testing.expect(passed(&listed[1]), "a no_run example only compiles")
  run Testing.expect(passed(&listed[2]), "an example without main only compiles")
  let checking = run Doctest.collect(&project, &Revision.make(), &none, &none, false)
  run Testing.expect(passed(&List<Outcome>.asSlice(&checking)[0]), "without running, every checked example passes")
}

test effect fn doctestsLeaveProgramsPendingUnlessNoRun() -> () ! Error | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run runnableExamples() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}
