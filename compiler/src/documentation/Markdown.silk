//! Authored Markdown reference generation, semantic code links, and exact fenced examples.
//! Transient block boundaries protect code and raw text without rendering or normalizing prose.
import documentation.Model { Document, Item, Project, Source }
import documentation.MarkdownBlocks { Block }
import documentation.MarkdownBlocks
import documentation.MarkdownInline
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.slice { Slice }
import silk.usize
import silk.list { List }

pub struct Example {
  pub code: Bytes,
  pub info: Bytes,
  pub source: Source,
  pub ignored: bool,
  /// `silk,no_run`: the example is checked and never built or run.
  pub noRun: bool,
  pub invalid: bool,
}
pub struct Symbol {
  pub spelling: Bytes,
  pub source: Source,
}

/// Maps a normalized Markdown byte range to its original module byte range and one-based line.
pub fn source(document: &Document, start: usize, end: usize) -> Source {
  let text = Bytes.asSlice(&document.markdown)
  let starts = List<usize>.asSlice(&document.lineStarts)
  let mut line = usize.ZERO
  let mut lineStart = usize.ZERO
  let mut at = usize.ZERO
  while at < start && at < text.length {
    if text[at] == 10 {
      line = line + usize.ONE
      lineStart = at + usize.ONE
    }
    at = at + usize.ONE
  }
  let firstLine = line
  let mut mappedStart = document.source.start + start
  if line < starts.length { mappedStart = starts[line] + start - lineStart }
  // A half-open end immediately after a newline belongs to the preceding source line, not to
  // the next stripped comment prefix. Map the last covered byte, then advance one byte.
  while at < end && at + usize.ONE < end && at < text.length {
    if text[at] == 10 {
      line = line + usize.ONE
      lineStart = at + usize.ONE
    }
    at = at + usize.ONE
  }
  let mut mappedEnd = document.source.start + end
  if line < starts.length { mappedEnd = starts[line] + end - lineStart }
  return Source { start: mappedStart, end: mappedEnd, line: document.source.line + firstLine }
}
/// The language word of a complete, trimmed fence info string.
pub fn language(info: &[u8]) -> &[u8] {
  let mut end = usize.ZERO
  while end < info.length && !MarkdownBlocks.space(info[end]) && info[end] != 44 { end = end + usize.ONE }
  return Slice.view<u8>(info, 0, end)
}
/// Whether the first fence-info word denotes Silk, independently of its attributes.
pub fn silk(info: &[u8]) -> bool { return MarkdownBlocks.equalFold(language(info), b"silk") }
fn attribute(info: &[u8], wanted: &[u8]) -> bool {
  let mut at = language(info).length
  while at < info.length {
    if info[at] == 44 { at = at + usize.ONE }
    let start = at
    while at < info.length && info[at] != 44 { at = at + usize.ONE }
    if MarkdownBlocks.same(MarkdownBlocks.trim(Slice.view<u8>(info, start, at - start)), wanted) { return true }
  }
  return false
}
fn invalidAttributes(info: &[u8]) -> bool {
  let mut at = language(info).length
  while at < info.length {
    if info[at] != 44 { return true }
    at = at + usize.ONE
    let start = at
    while at < info.length && info[at] != 44 { at = at + usize.ONE }
    let value = MarkdownBlocks.trim(Slice.view<u8>(info, start, at - start))
    if value.length > usize.ZERO && !MarkdownBlocks.same(value, b"ignore") && !MarkdownBlocks.same(value, b"no_run") { return true }
  }
  return false
}
/// Collects every Silk fence in source order, including fences in quotes and lists. Unknown
/// attributes remain invalid even when `ignore` is also present. Code excludes the fence newline.
pub effect fn examples(document: &Document) -> List<Example> ! OutOfMemoryError ? &mut Allocator {
  let tree = run MarkdownBlocks.parse(Bytes.asSlice(&document.markdown))
  let blocks = List<Block>.asSlice(&tree)
  let mut result = List<Example>.make()
  let mut at = usize.ZERO
  while at < blocks.length {
    let block = &blocks[at]
    let info = Bytes.asSlice(&block.info)
    if block.kind == MarkdownBlocks.CODE && silk(info) {
      run List<Example>.append(&mut result, Example {
        code: run Bytes.copy(Bytes.asSlice(&block.text)), info: run Bytes.copy(info),
        source: source(document, block.start, block.end), ignored: attribute(info, b"ignore"), noRun: attribute(info, b"no_run"), invalid: invalidAttributes(info),
      })
    }
    at = at + usize.ONE
  }
  return move result
}
/// The readable page-local anchor of one module item; see `MarkdownInline.anchor`.
pub effect fn anchor(items: &[Item], index: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator { return run MarkdownInline.anchor(items, index) }
/// Returns the reference page filename for a module: its whole path below the library root.
pub effect fn moduleFile(name: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator { return run MarkdownInline.moduleFile(name) }

/// Returns the first top-level paragraph on one whitespace-normalized line for the reference
/// index. Body generation remains byte-authored; this does not enforce a prose policy.
pub effect fn summary(document: &Document) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let parsed = run MarkdownBlocks.parse(Bytes.asSlice(&document.markdown))
  let blocks = List<Block>.asSlice(&parsed)
  let mut at = usize.ZERO
  while at < blocks.length {
    if blocks[at].parent == usize.MAX && (blocks[at].kind == MarkdownBlocks.RAW || blocks[at].kind == MarkdownBlocks.PARAGRAPH) {
      let text = Bytes.asSlice(&blocks[at].text)
      let mut output = Bytes.make()
      let mut pending = false
      let mut byte = usize.ZERO
      while byte < text.length {
        if MarkdownBlocks.space(text[byte]) {
          pending = Bytes.length(&output) > usize.ZERO
        } else {
          if pending { run Bytes.append(&mut output, b" ") }
          pending = false
          run Bytes.append(&mut output, Slice.view<u8>(text, byte, 1))
        }
        byte = byte + usize.ONE
      }
      return move output
    }
    at = at + usize.ONE
  }
  return Bytes.make()
}
/// Returns semantic code links with original-module byte positions. Explicit Markdown links,
/// escaped brackets, and code blocks/spans are not semantic links.
pub effect fn symbols(document: &Document) -> List<Symbol> ! OutOfMemoryError ? &mut Allocator {
  let parsed = run MarkdownBlocks.parse(Bytes.asSlice(&document.markdown))
  let blocks = List<Block>.asSlice(&parsed)
  let definitions = run MarkdownInline.definitions(blocks)
  let raw = Bytes.asSlice(&document.markdown)
  let mut output = List<Symbol>.make()
  let mut at = usize.ZERO
  while at < blocks.length {
    let block = &blocks[at]
    if block.kind == MarkdownBlocks.PARAGRAPH || block.kind == MarkdownBlocks.HEADING {
      // Scan the authored range, rather than the joined paragraph: container prefixes and removed
      // doc-comment markers must not move the source positions of links on continuation lines.
      let found = run MarkdownInline.symbols(Slice.view<u8>(raw, block.start, block.end - block.start), List<Bytes>.asSlice(&definitions))
      let links = List<MarkdownInline.Symbol>.asSlice(&found)
      let mut l = usize.ZERO
      while l < links.length {
        run List<Symbol>.append(&mut output, Symbol { spelling: run Bytes.copy(Bytes.asSlice(&links[l].spelling)), source: source(document, block.start + links[l].start, block.start + links[l].end) })
        l = l + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return move output
}

/// Preserves authored Markdown spelling except heading depth and resolved semantic links. Code
/// and raw definitions are copied byte-for-byte, including fence lengths and info strings.
pub effect fn referenceWithPaths(document: &Document, project: &Project, moduleIndex: usize, headingOffset: usize, pages: &[Bytes]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let text = Bytes.asSlice(&document.markdown)
  let parsed = run MarkdownBlocks.parse(text)
  let blocks = List<Block>.asSlice(&parsed)
  let definitions = run MarkdownInline.definitions(blocks)
  let mut output = Bytes.make()
  let mut cursor = usize.ZERO
  let mut at = usize.ZERO
  while at < blocks.length {
    let block = &blocks[at]
    if block.kind != MarkdownBlocks.PARAGRAPH && block.kind != MarkdownBlocks.HEADING {
      at = at + usize.ONE
      continue
    }
    if block.start < cursor {
      at = at + usize.ONE
      continue
    }
    run Bytes.append(&mut output, Slice.view<u8>(text, cursor, block.start - cursor))
    if block.kind == MarkdownBlocks.HEADING {
      let mut depth = block.depth + headingOffset
      if depth > 6 { depth = 6 }
      let mut n = usize.ZERO
      while n < depth {
        run Bytes.append(&mut output, b"#")
        n = n + usize.ONE
      }
      run Bytes.append(&mut output, b" ")
      run MarkdownInline.reference(Bytes.asSlice(&block.text), List<Bytes>.asSlice(&definitions), document, project, moduleIndex, pages, &mut output)
    } else {
      run MarkdownInline.reference(Slice.view<u8>(text, block.start, block.end - block.start), List<Bytes>.asSlice(&definitions), document, project, moduleIndex, pages, &mut output)
    }
    cursor = block.end
    at = at + usize.ONE
  }
  run Bytes.append(&mut output, Slice.view<u8>(text, cursor, text.length - cursor))
  return move output
}

/// Rewrites headings and semantic links using the default native module filenames.
pub effect fn reference(document: &Document, project: &Project, moduleIndex: usize, headingOffset: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let pages = List<Bytes>.make()
  return run referenceWithPaths(document, project, moduleIndex, headingOffset, List<Bytes>.asSlice(&pages))
}
