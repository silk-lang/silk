/// A rejected documentation request or profile, with its CLI exit class.
pub struct Failure {
  pub message: &'static [u8],
  pub status: i32,
}

/// Failures from native source loading, profile assembly, and extraction.
pub type Error = Failure | FileError | OutOfMemoryError | JsonError | TomlError | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | RegistrationClosed | ConflictingPackageSource | Cycle | RevisionMismatch | Problem | ProjectError | PlanError | ExtractionError | InvalidProjectCommand

/// One immutable standard-library input shared by sequential profile sessions.
pub struct Library {
  pub revision: Revision,
  pub roots: List<ModuleId>,
  pub paths: List<Bytes>,
  pub manifest: List<ManifestEntry>,
}

/// One fully assembled semantic session. Dropping it releases all semantic caches.
pub struct Session {
  pub target: Target,
  pub store: Semantic,
  pub request: Request,
  pub roots: List<ModuleId>,
  pub paths: List<Bytes>,
  /// Where each module's source lives, so a rejection can be reported against its file.
  pub sources: ModuleSources,
  /// The directory reported paths are relative to: the package's own.
  pub display: Path,
}

/// Exact byte comparison used by command input and output contracts.
pub fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut at: usize = 0
  while at < a.length { if a[at] != b[at] { return false } at = at + 1 }
  return true
}

fn silkFile(path: &[u8]) -> bool {
  return path.length >= 5 && same(Slice.view<u8>(path, path.length - 5, 5), b".silk")
}

/// Publishes a source directory in deterministic filesystem order, without parsing bodies.
pub effect fn publishTree(revision: &mut Revision, base: &Path, directory: &Path, owner: &ModuleId) -> ()
! FileError | InvalidModulePath | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let entries = run FileSystem.listDirectory(directory)
  let listed = List<DirectoryEntry>.asSlice(&entries)
  let mut at: usize = 0
  while at < listed.length {
    let entry = &listed[at]
    if entry.kind.code == FileSystem.directory().code {
      run publishTree(&mut revision.*, base, &entry.path, owner)
    } else if silkFile(Path.rawBytes(&entry.path)) {
      let relative = run CommandPath.relative(base, &entry.path)
      let identity = run ModuleId.sibling(owner, Bytes.asSlice(&relative))
      let content = Option<Bytes>.some(run FileSystem.readFile(&entry.path))
      revision.* = run Revision.publish(&revision.*, &identity, &content)
    }
    at = at + 1
  }
}

effect fn text(value: &Value, key: string) -> Bytes ! Failure | OutOfMemoryError ? &mut Allocator {
  return match move Json.asString(Json.field(value, key)) {
    Option<string>.Some {value: decoded} => run Bytes.copy(String.utf8Bytes(decoded))
    Option<string>.None => { fail Failure {message: b"invalid standard-library manifest", status: 2} }
  }
}

/// Loads the installed or explicitly selected source distribution, including intrinsic modules.
pub effect fn library(root: &Path) -> Library ! Error ? &mut FileSystem | &mut Allocator {
  let manifestPath = run Path.join(root, "manifest.json")
  let contents = run FileSystem.readFile(&manifestPath)
  let json = run Json.parse(Bytes.asSlice(&contents))
  let entries = match &json {
    Value.Array {values} => List<JsonChild>.asSlice(&Box<List<JsonChild>>.get(&values)[0])
    _ => { fail Failure {message: b"standard-library manifest must be an array", status: 2} }
  }
  let owner = run ModuleId.make(b"file", b"documentation", b"stdlib.silk")
  let mut revision = Revision.make()
  run publishTree(&mut revision, root, root, &owner)
  let mut roots = List<ModuleId>.make()
  let mut paths = List<Bytes>.make()
  let mut manifest = List<ManifestEntry>.make()
  let mut at: usize = 0
  while at < entries.length {
    let entry = match &entries[at] {
      JsonChild.Item {value} => &value
      _ => { fail Failure {message: b"invalid standard-library manifest entry", status: 2} }
    }
    let module = run text(entry, "module")
    let path = run text(entry, "path")
    let mut namespace = Option<Bytes>.none()
    if let Option<&Value>.Some {value: _} = move Json.field(entry, "namespace") {
      namespace = Option<Bytes>.some(run text(entry, "namespace"))
    }
    let identity = run ModuleId.sibling(&owner, Bytes.asSlice(&path))
    if !Revision.presents(&revision, &identity) {
      fail Failure {message: b"standard-library manifest source is missing", status: 2}
    }
    run List<ModuleId>.append(&mut roots, move identity)
    let absolute = run Path.joinBytes(root, Bytes.asSlice(&path))
    run List<Bytes>.append(&mut paths, run Bytes.copy(Path.rawBytes(&absolute)))
    run List<ManifestEntry>.append(&mut manifest, ManifestEntry {module: move module, namespace: move namespace})
    at = at + 1
  }
  if entries.length == 0 { fail Failure {message: b"empty standard-library manifest", status: 2} }
  return Library {revision: move revision, roots: move roots, paths: move paths, manifest: move manifest}
}

/// Creates explicit target facts; `noLibc` selects the additional raw Linux reference profile.
pub effect fn profile(target: &[u8], noLibc: bool) -> InitialProfile ! Problem | OutOfMemoryError ? &mut Allocator {
  let mut input = Input.make()
  input.target = Option<Bytes>.some(run Bytes.copy(target))
  if noLibc { input.libc = Option<Bytes>.some(run Bytes.copy(b"none")) }
  return run InitialProfile.freeze(&input)
}

/// Assembles registered package schemas before any profile-dependent declaration extraction.
pub effect fn configure(store: &mut Semantic, request: &mut Request, roots: &[ModuleId], initial: InitialProfile, supplied: List<Supplied>) -> ()
! Error ? &mut Allocator | &mut Types {
  let mut at: usize = 0
  while at < roots.length {
    run Request.registerSchemaModule(&mut request.*, &roots[at])
    at = at + 1
  }
  let target = Target.forId(Target.id(InitialProfile.target(&initial)))
  let shapes = match move run registered(&mut store.*, &mut request.*, &target) {
    Result<Registered, ShapeProblem>.Success {value} => move value
    Result<Registered, ShapeProblem>.Failure {error: _} => { fail Failure {message: b"invalid documentation profile schemas", status: 1} }
  }
  let final = match move run assemble(move initial, &mut store.*, &mut request.*, &shapes, move supplied) {
    Result<FinalProfile, AssemblyProblem>.Success {value} => move value
    Result<FinalProfile, AssemblyProblem>.Failure {error: _} => { fail Failure {message: b"invalid documentation parameter profile", status: 1} }
  }
  run Semantic.reviseProfile(&mut store.*, Option<FinalProfile>.some(move final))
}

/// Extracts one standard-library profile without retaining semantic state between profiles.
pub effect fn extractLibrary(library: &Library, target: &[u8], identity: &[u8], noLibc: bool, includePrivate: bool) -> Project
! Error ? &mut Allocator | &mut Types {
  let initial = run profile(target, noLibc)
  let machine = Target.forId(Target.id(InitialProfile.target(&initial)))
  let mut store = Semantic.oneShot(run Revision.copy(&library.revision), machine, Option<FinalProfile>.none())
  let roots = List<ModuleId>.asSlice(&library.roots)
  Semantic.selectPackages(&mut store, PackageGraph.make(&roots[0]))
  let mut request = Request.make()
  run configure(&mut store, &mut request, roots, move initial, List<Supplied>.make())
  return run Extraction.extract(&mut store, roots, List<Bytes>.asSlice(&library.paths), target, identity, includePrivate)
}

/// Loads a project's own source closure using the same package graph and profile planner as build.
pub effect fn package(project: &Package, library: Option<Path>, store: Option<&Path>, targetOverride: &Option<Bytes>, host: Target) -> Session
! Error ? &mut FileSystem | &mut Allocator | &mut Types {
  let empty = List<Bytes>.make()
  let parsed = run ProjectCommands.parseBuild(List<Bytes>.asSlice(&empty))
  let mut options = move parsed.options
  if let Option<Bytes>.Some {value} = &targetOverride.* {
    run List<Bytes>.append(&mut options.targets, run Bytes.copy(Bytes.asSlice(&value)))
  }
  let mut plans = run Plans.make(project, &options, Projects.targets(project), host)
  if List<ProjectPlan>.length(&plans) != 1 { fail Failure {message: b"documentation requires one target; pass --target", status: 2} }
  let plan = List<ProjectPlan>.remove(&mut plans, 0)
  let initial = run InitialProfile.freeze(&plan.input)
  let target = Target.forId(Target.id(InitialProfile.target(&initial)))
  let libc = match move InitialProfile.text(&initial, b"libc") {
    Option<&[u8]>.Some {value} => value
    Option<&[u8]>.None => { fail Failure {message: b"missing libc profile fact", status: 2} }
  }
  let mut sources = run Sources.makeInPackage(Projects.entry(project), Projects.manifest(project), move library, store, Target.name(&target), libc, false, Selection.None)
  let identity = ModuleId.copy(Sources.entry(&sources))
  // A module the package exports is documented even when its root imports none of it.
  let mut preloaded = List<ModuleId>.make()
  run List<ModuleId>.append(&mut preloaded, ModuleId.copy(&identity))
  let mut exported = run Sources.exportedModules(&sources)
  while List<ModuleId>.length(&exported) > 0 {
    run List<ModuleId>.append(&mut preloaded, List<ModuleId>.remove(&mut exported, 0))
  }
  run Sources.preload(&mut sources, List<ModuleId>.asSlice(&preloaded))
  let roots = run Sources.loadedRootModules(&sources)
  let mut paths = List<Bytes>.make()
  let listed = List<ModuleId>.asSlice(&roots)
  let mut at: usize = 0
  while at < listed.length {
    let location = run Sources.sourceLocation(&sources, &listed[at])
    let path = match move location.path {
      Option<Path>.Some {value} => move value
      Option<Path>.None => { fail Failure {message: b"documentation source has no filesystem path", status: 2} }
    }
    run List<Bytes>.append(&mut paths, run Bytes.copy(Path.rawBytes(&path)))
    at = at + 1
  }
  let mut store = Semantic.oneShot(run Sources.revision(&sources), target, Option<FinalProfile>.none())
  Semantic.selectPackages(&mut store, run Sources.packageGraph(&sources))
  let mut request = Request.forApplication(ModuleId.copy(&identity))
  run configure(&mut store, &mut request, &[ModuleId.copy(&identity)], move initial, move plan.bindings)
  return Session {target: target, store: move store, request: move request, roots: move roots, paths: move paths, sources: move sources,
    display: run Path.fromBytes(Path.rawBytes(Projects.directory(project)))}
}

// Fails with `rejection` as `silk check` prints it, its file relative to the package directory
// when it lies under it; a module with no readable file, or a rejection with no catalog code,
// fails with the bare rejection.
effect fn reject(session: &Session, rejection: Shared<Rejection>) -> never
! Error ? &mut FileSystem | &mut Allocator {
  let module = Shared<Rejection>.with<ModuleId>(&rejection, fn(value: &Rejection) -> ModuleId { return ModuleId.copy(&value.module) })
  let location = run Sources.sourceLocation(&session.sources, &module)
  let path = match move location.path {
    Option<Path>.Some {value} => move value
    Option<Path>.None => { fail ExtractionError.Rejected {rejection: move rejection} }
  }
  let text = match move run Effect.result(FileSystem.readFile(&path)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success {value} => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError unreadable => {
        drop unreadable
        fail ExtractionError.Rejected {rejection: move rejection}
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let relative = run CommandPath.relative(&session.display, &path)
  let spelled = Bytes.asSlice(&relative)
  let outside = spelled.length == 0 || (spelled.length >= 2 && spelled[0] == 46 && spelled[1] == 46 && (spelled.length == 2 || spelled[2] == 47))
  let mut rendered = Option<Bytes>.none()
  if outside {
    rendered = run Report.render(&rejection, Bytes.asSlice(&text), Path.rawBytes(&path))
  } else {
    rendered = run Report.render(&rejection, Bytes.asSlice(&text), spelled)
  }
  if let Option<Bytes>.Some {value} = move rendered { fail ExtractionError.Reported {text: move value} }
  fail ExtractionError.Rejected {rejection: move rejection}
}

/// Rejects every loaded module's active imports before publishing extracted documentation.
/// This validates private and unused imports without demanding ordinary function bodies.
pub effect fn validateImports(session: &mut Session) -> () ! Error ? &mut FileSystem | &mut Allocator | &mut Types {
  let mut rejected = run Semantic.importRejections(&mut session.store, &mut session.request)
  if List<Shared<Rejection>>.length(&rejected) > 0 {
    run reject(&session.*, List<Shared<Rejection>>.remove(&mut rejected, 0))
  }
}

/// Extracts a project's source closure and rejects invalid private or unused imports. A rejection
/// is reported as `silk check` reports it.
pub effect fn extractPackage(session: &mut Session, includePrivate: bool) -> Project
! Error ? &mut FileSystem | &mut Allocator | &mut Types {
  let extracted = run Effect.result(Extraction.extract(&mut session.store, List<ModuleId>.asSlice(&session.roots),
    List<Bytes>.asSlice(&session.paths), Target.name(&session.target), Target.name(&session.target), includePrivate))
  let project = match move extracted {
    Result<Project, ExtractionError | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
    Result<Project, ExtractionError | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      ExtractionError failure => {
        if let ExtractionError.Rejected {rejection} = &failure { run reject(&session.*, Shared<Rejection>.clone(&rejection)) }
        fail move failure
      }
      Cycle failure => { fail move failure }
      InvalidModulePath failure => { fail move failure }
      RevisionMismatch failure => { fail move failure }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run validateImports(&mut session.*)
  return move project
}
