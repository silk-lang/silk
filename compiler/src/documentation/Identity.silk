//! Owned printable identities derived from canonical semantic declaration content.

import semantic.DeclarationId {DeclarationId}
import semantic.ModuleId {ModuleId}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.collections.slice {Slice}
import silk.num.u8
import silk.num.usize

/// Encodes every canonical identity byte, including package, owner kinds and occurrences.
pub effect fn declaration(identity: &DeclarationId) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut content = Bytes.make()
  run DeclarationId.appendContent(identity, &mut content)
  let mut result = run Bytes.copy(b"declaration:")
  run hex(&mut result, Bytes.asSlice(&content))
  return move result
}

/// Appends a deterministic hexadecimal encoding without hashing away identity information.
pub effect fn hex(result: &mut Bytes, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let digits = b"0123456789abcdef"
  let mut at = usize.ZERO
  while at < bytes.length {
    run Bytes.append(&mut result.*, Slice.view<u8>(digits, u8.toUsize(bytes[at] / 16), usize.ONE))
    run Bytes.append(&mut result.*, Slice.view<u8>(digits, u8.toUsize(bytes[at] % 16), usize.ONE))
    at = at + usize.ONE
  }
  return ()
}

/// A structural child is identified by its canonical parent, category and authored name.
pub effect fn child(parent: &[u8], kind: &[u8], name: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut result = run Bytes.copy(parent)
  run Bytes.append(&mut result, b"/")
  run Bytes.append(&mut result, kind)
  run Bytes.append(&mut result, b":")
  run hex(&mut result, name)
  return move result
}

/// Converts a canonical logical source path to its extension-free documentation module name.
pub effect fn module(identity: &ModuleId) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut result = run ModuleId.copyPath(identity)
  let length = Bytes.length(&result)
  if length >= 5 { Bytes.truncate(&mut result, length - 5) }
  return move result
}
