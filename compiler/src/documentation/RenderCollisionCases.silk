//! Canonical reference anchors reject duplicated identities before any files are published.
import documentation.Model {Project, Module, Item, DecodeError}
import documentation.Model
import documentation.Reference {Group, ManifestEntry, RenderError}
import documentation.Reference
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.option {Option}
import silk.core.result {Result}
import silk.testing.testing {AssertionError, Testing}
import silk.collections.list {List}

effect fn anchorCollision() -> () ! AssertionError<'static> | DecodeError | OutOfMemoryError ? &mut Allocator {
  let mut project = run Model.decode(b"{\"schema\":\"silk-documentation\",\"experimental\":true,\"version\":1,\"target\":\"x\",\"profile\":\"p\",\"modules\":[{\"name\":\"silk/dupe\",\"sourcePath\":\"dupe.silk\",\"items\":[{\"id\":\"first\",\"kind\":\"Function\",\"name\":\"first\",\"visibility\":\"Public\",\"signature\":\"pub fn first()\",\"source\":{\"start\":0,\"end\":20,\"line\":1}},{\"id\":\"second\",\"kind\":\"Function\",\"name\":\"second\",\"visibility\":\"Public\",\"signature\":\"pub fn second()\",\"source\":{\"start\":21,\"end\":40,\"line\":2}}]}]}")
  let modules = List<Module>.asMutSlice(&mut project.modules)
  let items = List<Item>.asMutSlice(&mut modules[0].items)
  items[1].id = run Bytes.copy(b"first")
  drop items
  drop modules
  let mut manifest = List<ManifestEntry>.make()
  run List<ManifestEntry>.append(&mut manifest, ManifestEntry { module: run Bytes.copy(b"silk/dupe"), namespace: Option<Bytes>.some(run Bytes.copy(b"dupe")) })
  let captured = run Effect.result(Reference.capture(&project, List<ManifestEntry>.asSlice(&manifest)))
  let rejected = match move captured {
    Result<Group, RenderError | OutOfMemoryError>.Success { value: _ } => false
    Result<Group, RenderError | OutOfMemoryError>.Failure { error } => match move error {
      RenderError collision => true
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(rejected, "direct owned-model callers cannot publish two declarations at the same canonical anchor")
}

test effect fn nativeReferenceRejectsAnchorCollisions() -> () ! AssertionError<'static> | DecodeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run anchorCollision() |> Effect.provideMut<Allocator>(&mut allocator)
}
