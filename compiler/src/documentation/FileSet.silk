//! Compare complete generated output before publication, retaining old pages on validation failure.

import documentation.Publication
import documentation.Reference {File}
import documentation.Session {same, Failure}
import driver.CommandPath
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.system.filesystem {FileSystem, FileError, Path, DirectoryEntry}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.collections.slice {Slice}
import silk.collections.list {List}
import silk.io.writer {Writer, WriterError}

/// The independently observable comparison of a generated file with its current bytes.
pub enum Difference { Unchanged, Missing, Stale }

/// Compares without creating, truncating, or deleting anything.
pub fn difference(expected: &[u8], actual: &Option<Bytes>) -> Difference {
  return match &actual.* {
    Option<Bytes>.None => Difference.Missing
    Option<Bytes>.Some {value} => { if same(expected, Bytes.asSlice(&value)) { return Difference.Unchanged } return Difference.Stale }
  }
}

/// Reads an optional file, preserving errors other than absence.
pub effect fn optional(path: &Path) -> Option<Bytes> ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  return match move run Effect.result(FileSystem.readFile(path)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success {value} => Option<Bytes>.some(move value)
    Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError value => { if value.reason.code == FileSystem.notFound().code { return Option<Bytes>.none() } fail move value }
      OutOfMemoryError value => { fail move value }
    }
  }
}

/// Creates parents, then atomically replaces exactly one complete generated file.
pub effect fn publish(path: &Path, bytes: &[u8]) -> () ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  if let Option<Path>.Some {value} = move run Path.parent(path) { run FileSystem.createDirectoriesRecursively(&value) }
  run Publication.publish(Path.rawBytes(path), bytes)
}

fn markdown(path: &[u8]) -> bool { return path.length >= 3 && same(Slice.view<u8>(path, path.length - 3, 3), b".md") }

fn contains(files: &[File], name: &[u8]) -> bool {
  let mut at: usize = 0
  while at < files.length { if same(Bytes.asSlice(&files[at].path), name) { return true } at = at + 1 }
  return false
}

/// Validates collision-free relative output names before making any filesystem changes.
pub effect fn validate(files: &[File]) -> () ! Failure {
  let mut at: usize = 0
  while at < files.length {
    let name = Bytes.asSlice(&files[at].path)
    if name.length == 0 || name[0] == 47 { fail Failure {message: b"invalid generated output path", status: 2} }
    let mut start: usize = 0
    let mut byte: usize = 0
    while byte <= name.length {
      if byte == name.length || name[byte] == 47 {
        let segment = Slice.view<u8>(name, start, byte - start)
        if segment.length == 0 || same(segment, b".") || same(segment, b"..") { fail Failure {message: b"unsafe generated output path", status: 2} }
        start = byte + 1
      } else if name[byte] == 92 || name[byte] == 0 { fail Failure {message: b"unsafe generated output path", status: 2} }
      byte = byte + 1
    }
    let mut other: usize = 0
    while other < at {
      if same(name, Bytes.asSlice(&files[other].path)) { fail Failure {message: b"generated output path collision", status: 1} }
      other = other + 1
    }
    at = at + 1
  }
}

effect fn note(path: &Path, message: &[u8]) -> () ! WriterError ? &mut Writer {
  run Writer.writeAll(Path.rawBytes(path))
  run Writer.writeAll(message)
  run Writer.writeAll(b"\n")
}

/// Checks missing/stale/extra Markdown files without writes, or publishes all validated files
/// before removing obsolete Markdown pages. Unrelated non-Markdown files are never removed.
pub effect fn apply(root: &Path, files: &[File], check: bool) -> i32
! Failure | FileError | OutOfMemoryError | WriterError ? &mut FileSystem | &mut Allocator | &mut Writer {
  run validate(files)
  let mut extras = List<Path>.make()
  let listed = run Effect.result(FileSystem.listDirectory(root))
  let mut entries = List<DirectoryEntry>.make()
  match move listed {
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success {value} => { entries = move value }
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError value => { if value.reason.code != FileSystem.notFound().code { fail move value } }
      OutOfMemoryError value => { fail move value }
    }
  }
  let actual = List<DirectoryEntry>.asSlice(&entries)
  let mut listedAt: usize = 0
  while listedAt < actual.length {
    if actual[listedAt].kind.code == FileSystem.file().code && markdown(Path.rawBytes(&actual[listedAt].path)) {
      let relative = run CommandPath.relative(root, &actual[listedAt].path)
      if !contains(files, Bytes.asSlice(&relative)) { run List<Path>.append(&mut extras, run Path.fromBytes(Path.rawBytes(&actual[listedAt].path))) }
    }
    listedAt = listedAt + 1
  }
  let mut status: i32 = 0
  let mut at: usize = 0
  while at < files.length {
    let destination = run Path.joinBytes(root, Bytes.asSlice(&files[at].path))
    if check {
      let actual = run optional(&destination)
      match difference(Bytes.asSlice(&files[at].content), &actual) {
        Difference.Unchanged => {}
        Difference.Missing => { status = 1 run note(&destination, b" is missing") }
        Difference.Stale => { status = 1 run note(&destination, b" is stale") }
      }
    } else { run publish(&destination, Bytes.asSlice(&files[at].content)) }
    at = at + 1
  }
  let obsolete = List<Path>.asSlice(&extras)
  at = 0
  while at < obsolete.length {
    if check { status = 1 run note(&obsolete[at], b" is extra or renamed") }
    else { run FileSystem.removeFile(&obsolete[at]) }
    at = at + 1
  }
  return status
}
