//! Owned documentation interchange records and strict versioned JSON boundary.
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.mem.box {Box}
import silk.text.string {String}
import silk.json.value {Json, Value, JsonChild}
import silk.json.scanner {JsonError}
import silk.core.effect {Effect}
import silk.core.result {Result}
import silk.collections.slice {Slice}
import silk.num.usize
import silk.num.u64
import diagnostic.JsonText

/// Original module byte offsets and a one-based source line.
pub struct Source {
  pub start: usize,
  pub end: usize,
  pub line: usize,
}
/// One semantically resolved symbol spelling and canonical documentation identity.
pub struct Link {
  pub spelling: Bytes,
  pub target: Bytes,
}
/// Normalized authored Markdown with exact original-line byte mapping.
pub struct Document {
  pub markdown: Bytes,
  pub source: Source,
  pub links: List<Link>,
  pub lineStarts: List<usize>,
  /// Link spellings that matched several declarations; each target holds the candidate list
  /// shown in the warning. Not serialized: only the extracting command reports it.
  pub ambiguous: List<Link>,
}
/// An owned declaration in depth-first source order; a parent always precedes its child.
pub struct Item {
  pub id: Bytes,
  pub kind: Bytes,
  pub name: Bytes,
  pub visibility: Bytes,
  pub signature: Bytes,
  pub source: Source,
  pub parent: Option<usize>,
  pub documentation: Option<Document>,
}
/// A selected source module without a retained syntax tree or semantic store.
pub struct Module {
  pub name: Bytes,
  pub sourcePath: Bytes,
  pub documentation: Option<Document>,
  /// The `@category` name from the module header, used to group modules on reference pages.
  pub category: Option<Bytes>,
  pub items: List<Item>,
}
/// One target/profile's complete documentation surface.
pub struct Project {
  pub target: Bytes,
  pub profile: Bytes,
  pub modules: List<Module>,
}
pub struct DecodeError { pub message: &'static [u8] }

/// Compares byte strings without allocation.
pub fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn containsZero(value: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < value.length {
    if value[at] == 0 { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn required<'a>(value: &'a Value, key: string) -> &'a Value ! DecodeError {
  return match move Json.field(value, key) {
    Option<&'a Value>.Some { value: found } => found
    Option<&'a Value>.None => { fail DecodeError { message: b"Missing documentation field" } }
  }
}

effect fn text(value: &Value) -> Bytes ! DecodeError | OutOfMemoryError ? &mut Allocator {
  return match &value.* {
    Value.String { text: present } => run Bytes.copy(String.ownedUtf8Bytes(&present))
    _ => { fail DecodeError { message: b"Expected documentation string" } }
  }
}

effect fn fieldText(value: &Value, key: string) -> Bytes ! DecodeError | OutOfMemoryError ? &mut Allocator {
  return run text(run required(value, key))
}

effect fn number(value: &Value) -> usize ! DecodeError {
  let parsed = Json.asU64(Option<&Value>.some(value))
  return match move parsed {
    Option<u64>.Some { value: present } => {
      if present > usize.toU64(usize.MAX) { fail DecodeError { message: b"Documentation integer out of bounds" } }
      return u64.toUsize(present)
    }
    _ => { fail DecodeError { message: b"Expected nonnegative documentation integer" } }
  }
}

effect fn children<'a>(value: &'a Value) -> &'a [JsonChild] ! DecodeError {
  return match &value.* {
    Value.Array { values } => List<JsonChild>.asSlice(&Box<List<JsonChild>>.get(&values)[0])
    _ => { fail DecodeError { message: b"Expected documentation array" } }
  }
}

effect fn child<'a>(value: &'a JsonChild) -> &'a Value ! DecodeError {
  return match &value.* {
    JsonChild.Item { value: present } => &present
    _ => { fail DecodeError { message: b"Expected documentation array element" } }
  }
}

effect fn keys(value: &Value, allowed: &[string]) -> () ! DecodeError {
  match &value.* {
    Value.Object { entries } => {
      let entries = List<JsonChild>.asSlice(&Box<List<JsonChild>>.get(&entries)[0])
      let mut at = usize.ZERO
      while at < entries.length {
        match &entries[at] {
          JsonChild.Member { entry } => {
            let mut found = false
            let mut key = usize.ZERO
            while key < allowed.length {
              if equal(String.ownedUtf8Bytes(&entry.key), String.utf8Bytes(allowed[key])) { found = true }
              key = key + usize.ONE
            }
            if !found { fail DecodeError { message: b"Unknown documentation field" } }
          }
          _ => { fail DecodeError { message: b"Invalid documentation object" } }
        }
        at = at + usize.ONE
      }
    }
    _ => { fail DecodeError { message: b"Expected documentation object" } }
  }
  return ()
}

effect fn source(value: &Value) -> Source ! DecodeError {
  run keys(value, &["start", "end", "line"])
  let start = run number(run required(value, "start"))
  let end = run number(run required(value, "end"))
  let line = run number(run required(value, "line"))
  if end < start || line == usize.ZERO { fail DecodeError { message: b"Invalid documentation source range" } }
  return Source { start: start, end: end, line: line }
}

effect fn document(value: &Value) -> Document ! DecodeError | OutOfMemoryError ? &mut Allocator {
  run keys(value, &["markdown", "source", "links", "lineStarts"])
  let markdown = run fieldText(value, "markdown")
  let location = run source(run required(value, "source"))
  let mut links = List<Link>.make()
  let rawLinks = run children(run required(value, "links"))
  let mut at = usize.ZERO
  while at < rawLinks.length {
    let entry = run child(&rawLinks[at])
    run keys(entry, &["spelling", "target"])
    let spelling = run fieldText(entry, "spelling")
    let target = run fieldText(entry, "target")
    if Bytes.asSlice(&spelling).length == usize.ZERO || Bytes.asSlice(&target).length == usize.ZERO || containsZero(Bytes.asSlice(&target)) { fail DecodeError { message: b"Invalid documentation link" } }
    run List<Link>.append(&mut links, Link { spelling: move spelling, target: move target })
    at = at + usize.ONE
  }
  let rawLines = run children(run required(value, "lineStarts"))
  let mut lineStarts = List<usize>.make()
  at = usize.ZERO
  let mut previous = location.start
  while at < rawLines.length {
    let offset = run number(run child(&rawLines[at]))
    if offset < location.start || offset > location.end || (at > usize.ZERO && offset <= previous) { fail DecodeError { message: b"Invalid documentation line map" } }
    run List<usize>.append(&mut lineStarts, offset)
    previous = offset
    at = at + usize.ONE
  }
  let bytes = Bytes.asSlice(&markdown)
  let mut lines = usize.ONE
  at = usize.ZERO
  while at < bytes.length {
    if bytes[at] == 10 { lines = lines + usize.ONE }
    at = at + usize.ONE
  }
  if rawLines.length != lines { fail DecodeError { message: b"Documentation line map length mismatch" } }
  if lines - usize.ONE > usize.MAX - location.line { fail DecodeError { message: b"Documentation line number out of bounds" } }
  let offsets = List<usize>.asSlice(&lineStarts)
  let mut lineIndex = usize.ZERO
  let mut lineStart = usize.ZERO
  at = usize.ZERO
  while at <= bytes.length {
    if at == bytes.length || bytes[at] == 10 {
      let mut limit = location.end
      if lineIndex + usize.ONE < offsets.length { limit = offsets[lineIndex + usize.ONE] }
      if at - lineStart > limit - offsets[lineIndex] { fail DecodeError { message: b"Documentation line exceeds source range" } }
      lineIndex = lineIndex + usize.ONE
      lineStart = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return Document { markdown: move markdown, source: move location, links: move links, lineStarts: move lineStarts, ambiguous: List<Link>.make() }
}

effect fn optionalDocument(value: &Value) -> Option<Document> ! DecodeError | OutOfMemoryError ? &mut Allocator {
  return match move Json.field(value, "documentation") {
    Option<&Value>.None => Option<Document>.none()
    Option<&Value>.Some { value: present } => Option<Document>.some(run document(present))
  }
}

fn validKind(value: &[u8]) -> bool {
  let names = [b"Function", b"Struct", b"Enum", b"EnumMember", b"Union", b"UnionVariant", b"Service", b"Interface", b"Constant", b"Role", b"Alias", b"Parameter", b"TypeParameter", b"Field", b"Implementation", b"Operation", b"Method", b"AssociatedFunction"]
  let mut at = usize.ZERO
  while at < names.length {
    if equal(value, names[at]) { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn module(value: &Value) -> Module ! DecodeError | OutOfMemoryError ? &mut Allocator {
  run keys(value, &["name", "sourcePath", "documentation", "category", "items"])
  let name = run fieldText(value, "name")
  let path = run fieldText(value, "sourcePath")
  if Bytes.asSlice(&name).length == usize.ZERO || containsZero(Bytes.asSlice(&name)) || containsZero(Bytes.asSlice(&path)) { fail DecodeError { message: b"Invalid documentation module identity" } }
  let documentation = run optionalDocument(value)
  let mut category = Option<Bytes>.none()
  if let Option<&Value>.Some { value: present } = move Json.field(value, "category") {
    let spelling = run text(present)
    let bytes = Bytes.asSlice(&spelling)
    let mut at = usize.ZERO
    while at < bytes.length {
      if bytes[at] == 0 || bytes[at] == 10 || bytes[at] == 13 { fail DecodeError { message: b"Invalid documentation category" } }
      at = at + usize.ONE
    }
    if bytes.length == usize.ZERO { fail DecodeError { message: b"Invalid documentation category" } }
    drop bytes
    category = Option<Bytes>.some(move spelling)
  }
  let rawItems = run children(run required(value, "items"))
  let mut items = List<Item>.make()
  let mut at = usize.ZERO
  while at < rawItems.length {
    let entry = run child(&rawItems[at])
    run keys(entry, &["id", "kind", "name", "visibility", "signature", "source", "parent", "documentation"])
    let id = run fieldText(entry, "id")
    let kind = run fieldText(entry, "kind")
    let itemName = run fieldText(entry, "name")
    let visibility = run fieldText(entry, "visibility")
    let signature = run fieldText(entry, "signature")
    let location = run source(run required(entry, "source"))
    if Bytes.asSlice(&id).length == usize.ZERO || containsZero(Bytes.asSlice(&id)) || !validKind(Bytes.asSlice(&kind)) { fail DecodeError { message: b"Invalid documentation item identity or kind" } }
    if !equal(Bytes.asSlice(&visibility), b"Public") && !equal(Bytes.asSlice(&visibility), b"Private") && !equal(Bytes.asSlice(&visibility), b"Inherited") { fail DecodeError { message: b"Invalid documentation visibility" } }
    let prior = List<Item>.asSlice(&items)
    if at > usize.ZERO && location.start < prior[at - usize.ONE].source.start { fail DecodeError { message: b"Documentation items are not in source order" } }
    let mut earlier = usize.ZERO
    while earlier < prior.length {
      if equal(Bytes.asSlice(&prior[earlier].id), Bytes.asSlice(&id)) { fail DecodeError { message: b"Duplicate documentation item identity" } }
      earlier = earlier + usize.ONE
    }
    let mut parent = Option<usize>.none()
    if let Option<&Value>.Some { value: present } = move Json.field(entry, "parent") {
      let index = run number(present)
      if index >= at { fail DecodeError { message: b"Documentation parent must precede child" } }
      if location.start < prior[index].source.start || location.end > prior[index].source.end || location.line < prior[index].source.line { fail DecodeError { message: b"Documentation child outside parent source" } }
      let mut cursor = at - usize.ONE
      while cursor != index {
        match &prior[cursor].parent {
          Option<usize>.None => { fail DecodeError { message: b"Documentation items are not depth first" } }
          Option<usize>.Some { value: ancestor } => { cursor = ancestor }
        }
      }
      parent = Option<usize>.some(index)
    }
    drop prior
    let docs = run optionalDocument(entry)
    run List<Item>.append(&mut items, Item { id: move id, kind: move kind, name: move itemName, visibility: move visibility, signature: move signature, source: move location, parent: move parent, documentation: move docs })
    at = at + usize.ONE
  }
  return Module { name: move name, sourcePath: move path, documentation: move documentation, category: move category, items: move items }
}

/// Decodes exactly one version-one document, rejecting unknown keys and invalid ownership ranges.
pub effect fn decode(input: &[u8]) -> Project ! DecodeError | OutOfMemoryError ? &mut Allocator {
  let parsed = run Effect.result(Json.parse(input))
  let root = match move parsed {
    Result<Value, JsonError | OutOfMemoryError>.Success { value } => move value
    Result<Value, JsonError | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError exhausted => { fail move exhausted }
      JsonError invalid => {
        drop invalid
        fail DecodeError { message: b"Invalid documentation JSON" }
      }
    }
  }
  run keys(&root, &["schema", "experimental", "version", "target", "profile", "modules"])
  let schema = run fieldText(&root, "schema")
  let version = run number(run required(&root, "version"))
  if !equal(Bytes.asSlice(&schema), b"silk-documentation") || version != usize.ONE { fail DecodeError { message: b"Unsupported documentation schema" } }
  let experimental = run required(&root, "experimental")
  match &experimental.* {
    Value.Bool { value } => { if !value { fail DecodeError { message: b"Expected experimental documentation" } } }
    _ => { fail DecodeError { message: b"Expected experimental documentation" } }
  }
  let target = run fieldText(&root, "target")
  let profile = run fieldText(&root, "profile")
  let rawModules = run children(run required(&root, "modules"))
  let mut modules = List<Module>.make()
  let mut at = usize.ZERO
  while at < rawModules.length {
    let entry = run module(run child(&rawModules[at]))
    let prior = List<Module>.asSlice(&modules)
    let mut earlier = usize.ZERO
    while earlier < prior.length {
      if equal(Bytes.asSlice(&prior[earlier].name), Bytes.asSlice(&entry.name)) { fail DecodeError { message: b"Duplicate documentation module" } }
      earlier = earlier + usize.ONE
    }
    drop prior
    run List<Module>.append(&mut modules, move entry)
    at = at + usize.ONE
  }
  return Project { target: move target, profile: move profile, modules: move modules }
}

effect fn writeSource(output: &mut Bytes, value: &Source) -> () ! OutOfMemoryError ? &mut Allocator {
  run Bytes.append(&mut output.*, b"{\"start\":")
  run JsonText.appendDecimal(&mut output.*, value.start)
  run Bytes.append(&mut output.*, b",\"end\":")
  run JsonText.appendDecimal(&mut output.*, value.end)
  run Bytes.append(&mut output.*, b",\"line\":")
  run JsonText.appendDecimal(&mut output.*, value.line)
  return run Bytes.append(&mut output.*, b"}")
}

effect fn writeDocument(output: &mut Bytes, value: &Option<Document>) -> () ! OutOfMemoryError ? &mut Allocator {
  match &value.* {
    Option<Document>.None => {}
    Option<Document>.Some { value: doc } => {
      run Bytes.append(&mut output.*, b",\"documentation\":{\"markdown\":")
      run JsonText.appendString(&mut output.*, Bytes.asSlice(&doc.markdown))
      run Bytes.append(&mut output.*, b",\"source\":")
      run writeSource(&mut output.*, &doc.source)
      run Bytes.append(&mut output.*, b",\"links\":[")
      let links = List<Link>.asSlice(&doc.links)
      let mut at = usize.ZERO
      while at < links.length {
        if at > usize.ZERO { run Bytes.append(&mut output.*, b",") }
        run Bytes.append(&mut output.*, b"{\"spelling\":")
        run JsonText.appendString(&mut output.*, Bytes.asSlice(&links[at].spelling))
        run Bytes.append(&mut output.*, b",\"target\":")
        run JsonText.appendString(&mut output.*, Bytes.asSlice(&links[at].target))
        run Bytes.append(&mut output.*, b"}")
        at = at + usize.ONE
      }
      run Bytes.append(&mut output.*, b"],\"lineStarts\":[")
      let starts = List<usize>.asSlice(&doc.lineStarts)
      at = usize.ZERO
      while at < starts.length {
        if at > usize.ZERO { run Bytes.append(&mut output.*, b",") }
        run JsonText.appendDecimal(&mut output.*, starts[at])
        at = at + usize.ONE
      }
      run Bytes.append(&mut output.*, b"]}")
    }
  }
  return ()
}

/// Serializes owned records in stable schema order without building another JSON tree.
pub effect fn encode(project: &Project) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut output = run Bytes.copy(b"{\"schema\":\"silk-documentation\",\"experimental\":true,\"version\":1,\"target\":")
  run JsonText.appendString(&mut output, Bytes.asSlice(&project.target))
  run Bytes.append(&mut output, b",\"profile\":")
  run JsonText.appendString(&mut output, Bytes.asSlice(&project.profile))
  run Bytes.append(&mut output, b",\"modules\":[")
  let modules = List<Module>.asSlice(&project.modules)
  let mut at = usize.ZERO
  while at < modules.length {
    if at > usize.ZERO { run Bytes.append(&mut output, b",") }
    let module = &modules[at]
    run Bytes.append(&mut output, b"{\"name\":")
    run JsonText.appendString(&mut output, Bytes.asSlice(&module.name))
    run Bytes.append(&mut output, b",\"sourcePath\":")
    run JsonText.appendString(&mut output, Bytes.asSlice(&module.sourcePath))
    run writeDocument(&mut output, &module.documentation)
    if let Option<Bytes>.Some { value: category } = &module.category {
      run Bytes.append(&mut output, b",\"category\":")
      run JsonText.appendString(&mut output, Bytes.asSlice(&category))
    }
    run Bytes.append(&mut output, b",\"items\":[")
    let items = List<Item>.asSlice(&module.items)
    let mut index = usize.ZERO
    while index < items.length {
      if index > usize.ZERO { run Bytes.append(&mut output, b",") }
      let item = &items[index]
      run Bytes.append(&mut output, b"{\"id\":")
      run JsonText.appendString(&mut output, Bytes.asSlice(&item.id))
      run Bytes.append(&mut output, b",\"kind\":")
      run JsonText.appendString(&mut output, Bytes.asSlice(&item.kind))
      run Bytes.append(&mut output, b",\"name\":")
      run JsonText.appendString(&mut output, Bytes.asSlice(&item.name))
      run Bytes.append(&mut output, b",\"visibility\":")
      run JsonText.appendString(&mut output, Bytes.asSlice(&item.visibility))
      run Bytes.append(&mut output, b",\"signature\":")
      run JsonText.appendString(&mut output, Bytes.asSlice(&item.signature))
      run Bytes.append(&mut output, b",\"source\":")
      run writeSource(&mut output, &item.source)
      match &item.parent {
        Option<usize>.None => {}
        Option<usize>.Some { value } => {
          run Bytes.append(&mut output, b",\"parent\":")
          run JsonText.appendDecimal(&mut output, value)
        }
      }
      run writeDocument(&mut output, &item.documentation)
      run Bytes.append(&mut output, b"}")
      index = index + usize.ONE
    }
    run Bytes.append(&mut output, b"]}")
    at = at + usize.ONE
  }
  run Bytes.append(&mut output, b"]}\n")
  return move output
}
