//! Source-token attachment and byte-exact Markdown origin maps for documentation extraction.

import documentation.Model {Document, Link, Source}
import documentation.Model
import lexer.Span {Span}
import lexer.Token {Token, TokenKind, kind as tokenKind, span as tokenSpan}
import parser.SyntaxTree {SyntaxTree}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.option {Option}
import silk.collections.slice {Slice}
import silk.num.usize
import silk.collections.list {List}

/// Indexes physical source lines once, treating CRLF as one line break.
pub effect fn lines(source: &[u8]) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<usize>.make()
  run List<usize>.append(&mut result, usize.ZERO)
  let mut at = usize.ZERO
  while at < source.length {
    if source[at] == 13 || source[at] == 10 {
      if source[at] == 13 && at + usize.ONE < source.length && source[at + usize.ONE] == 10 { at = at + usize.ONE }
      run List<usize>.append(&mut result, at + usize.ONE)
    }
    at = at + usize.ONE
  }
  return move result
}

/// Converts a retained half-open byte span to the public source record.
pub fn source(span: Span, starts: &[usize]) -> Source {
  let mut low = usize.ZERO
  let mut high = starts.length
  while low < high {
    let middle = low + (high - low) / 2
    if starts[middle] <= span.start { low = middle + usize.ONE } else { high = middle }
  }
  return Source {start: span.start, end: span.end, line: low}
}

fn breaks(bytes: &[u8], span: Span) -> usize {
  let mut count = usize.ZERO
  let mut at = span.start
  while at < span.end {
    if bytes[at] == 13 || bytes[at] == 10 {
      count = count + usize.ONE
      if bytes[at] == 13 && at + usize.ONE < span.end && bytes[at + usize.ONE] == 10 { at = at + usize.ONE }
    }
    at = at + usize.ONE
  }
  return count
}

fn startsLine(bytes: &[u8], start: usize) -> bool {
  let mut at = start
  while at > usize.ZERO {
    at = at - usize.ONE
    if bytes[at] == 13 || bytes[at] == 10 { return true }
    if bytes[at] != 32 && bytes[at] != 9 { return false }
  }
  return true
}

effect fn normalized(tree: &SyntaxTree, first: usize, last: usize, starts: &[usize]) -> Document
! OutOfMemoryError ? &mut Allocator {
  let tokens = List<Token>.asSlice(&tree.tokens)
  let bytes = Bytes.asSlice(&tree.source)
  let mut markdown = Bytes.make()
  let mut origins = List<usize>.make()
  let mut at = first
  while at <= last {
    let span = tokenSpan(tokens[at])
    let mut start = span.start + 3
    if start < span.end && bytes[start] == 32 { start = start + usize.ONE }
    run List<usize>.append(&mut origins, start)
    if at != first { run Bytes.append(&mut markdown, b"\n") }
    run Bytes.append(&mut markdown, Slice.view<u8>(bytes, start, span.end - start))
    at = at + 2
  }
  return Document {markdown: move markdown, source: source(Span {start: tokenSpan(tokens[first]).start, end: tokenSpan(tokens[last]).end}, starts), links: List<Link>.make(), lineStarts: move origins, ambiguous: List<Link>.make()}
}

/// Finds only an immediately preceding, line-leading `///` block. Blank lines, ordinary
/// comments and trailing comments break attachment. Lexer tokens exclude `////` already.
pub effect fn declaration(tree: &SyntaxTree, start: usize, starts: &[usize]) -> Option<Document>
! OutOfMemoryError ? &mut Allocator {
  let tokens = List<Token>.asSlice(&tree.tokens)
  let bytes = Bytes.asSlice(&tree.source)
  let mut low = usize.ZERO
  let mut high = tokens.length
  while low < high {
    let middle = low + (high - low) / 2
    if tokenSpan(tokens[middle]).start < start { low = middle + usize.ONE } else { high = middle }
  }
  if low < 2 { return Option<Document>.none() }
  let whitespace = tokens[low - usize.ONE]
  if tokenKind(whitespace) != TokenKind.Whitespace || breaks(bytes, tokenSpan(whitespace)) != usize.ONE { return Option<Document>.none() }
  let last = low - 2
  if tokenKind(tokens[last]) != TokenKind.DocComment || !startsLine(bytes, tokenSpan(tokens[last]).start) { return Option<Document>.none() }
  let mut first = last
  while first >= 2 {
    if tokenKind(tokens[first - usize.ONE]) != TokenKind.Whitespace || breaks(bytes, tokenSpan(tokens[first - usize.ONE])) != usize.ONE { break }
    if tokenKind(tokens[first - 2]) != TokenKind.DocComment { break }
    if !startsLine(bytes, tokenSpan(tokens[first - 2]).start) { return Option<Document>.none() }
    first = first - 2
  }
  return Option<Document>.some(run normalized(tree, first, last, starts))
}

/// Reads the contiguous `//!` block that starts the file, never an inner module comment.
pub effect fn module(tree: &SyntaxTree, starts: &[usize]) -> Option<Document>
! OutOfMemoryError ? &mut Allocator {
  let tokens = List<Token>.asSlice(&tree.tokens)
  let bytes = Bytes.asSlice(&tree.source)
  if tokens.length == usize.ZERO || tokenKind(tokens[usize.ZERO]) != TokenKind.ModuleDocComment { return Option<Document>.none() }
  let mut last = usize.ZERO
  while last + 2 < tokens.length {
    if tokenKind(tokens[last + usize.ONE]) != TokenKind.Whitespace || breaks(bytes, tokenSpan(tokens[last + usize.ONE])) != usize.ONE { break }
    if tokenKind(tokens[last + 2]) != TokenKind.ModuleDocComment || !startsLine(bytes, tokenSpan(tokens[last + 2]).start) { break }
    last = last + 2
  }
  return Option<Document>.some(run normalized(tree, usize.ZERO, last, starts))
}

fn blank(bytes: &[u8], start: usize, end: usize) -> bool {
  let mut at = start
  while at < end {
    if bytes[at] != 32 && bytes[at] != 9 && bytes[at] != 13 && bytes[at] != 10 { return false }
    at = at + usize.ONE
  }
  return true
}

/// Takes a final `@category Name` line, and the blank line before it, out of a module header.
/// Returns the trimmed name. A header without that final line is left unchanged.
pub effect fn category(documentation: &mut Option<Document>) -> Option<Bytes>
! OutOfMemoryError ? &mut Allocator {
  let mut name = Option<Bytes>.none()
  let mut markdown = Option<Bytes>.none()
  let mut lines = usize.ZERO
  let mut found = false
  if let Option<Document>.Some {value} = &documentation.* {
    let bytes = Bytes.asSlice(&value.markdown)
    let mut lineStart = bytes.length
    while lineStart > usize.ZERO && bytes[lineStart - usize.ONE] != 10 { lineStart = lineStart - usize.ONE }
    let tag = b"@category"
    let mut at = lineStart + tag.length
    if at < bytes.length && Model.equal(Slice.view<u8>(bytes, lineStart, tag.length), tag) && (bytes[at] == 32 || bytes[at] == 9) {
      while at < bytes.length && (bytes[at] == 32 || bytes[at] == 9) { at = at + usize.ONE }
      let mut end = bytes.length
      while end > at && (bytes[end - usize.ONE] == 32 || bytes[end - usize.ONE] == 9 || bytes[end - usize.ONE] == 13) { end = end - usize.ONE }
      if end > at {
        name = Option<Bytes>.some(run Bytes.copy(Slice.view<u8>(bytes, at, end - at)))
        found = true
        lines = List<usize>.length(&value.lineStarts) - usize.ONE
        let mut cut = usize.ZERO
        if lineStart > usize.ZERO { cut = lineStart - usize.ONE }
        let mut previous = cut
        while previous > usize.ZERO && bytes[previous - usize.ONE] != 10 { previous = previous - usize.ONE }
        if lines > usize.ONE && blank(bytes, previous, cut) {
          lines = lines - usize.ONE
          cut = previous - usize.ONE
        }
        if lines == usize.ZERO || blank(bytes, usize.ZERO, cut) { lines = usize.ZERO } else { markdown = Option<Bytes>.some(run Bytes.copy(Slice.view<u8>(bytes, usize.ZERO, cut))) }
      }
    }
  }
  if let Option<Bytes>.Some {value: text} = move markdown {
    if let Option<Document>.Some {value} = &mut documentation.* {
      value.markdown = move text
      List<usize>.truncate(&mut value.lineStarts, lines)
    }
  } else if found {
    documentation.* = Option<Document>.none()
  }
  return move name
}
