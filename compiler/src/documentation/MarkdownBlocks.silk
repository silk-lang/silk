//! Markdown block boundaries needed for heading/link rewriting and fenced-example extraction.
//! Containers borrow authored line ranges; flat parent indexes avoid recursively owned trees.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.num.usize
import silk.collections.list { List }

pub struct Line {
  pub start: usize,
  pub end: usize,
}
pub struct Block {
  pub kind: usize,
  pub parent: usize,
  pub start: usize,
  pub end: usize,
  pub depth: usize,
  pub text: Bytes,
  pub info: Bytes,
}

// Paragraph, heading, code, quote, unordered list, ordered list, list item, rule, definition.
pub const PARAGRAPH: usize = 0
pub const HEADING: usize = 1
pub const CODE: usize = 2
pub const QUOTE: usize = 3
pub const UNORDERED: usize = 4
pub const ORDERED: usize = 5
pub const ITEM: usize = 6
pub const RULE: usize = 7
pub const DEFINITION: usize = 8
pub const RAW: usize = 9

pub fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut i = usize.ZERO
  while i < a.length {
    if a[i] != b[i] { return false }
    i = i + usize.ONE
  }
  return true
}
pub fn space(c: u8) -> bool { return c == 32 || c == 9 || c == 10 || c == 13 }
pub fn lower(c: u8) -> u8 {
  if c >= 65 && c <= 90 { return c + 32 }
  return c
}
pub fn equalFold(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut i = usize.ZERO
  while i < a.length {
    if lower(a[i]) != lower(b[i]) { return false }
    i = i + usize.ONE
  }
  return true
}
pub fn trim(a: &[u8]) -> &[u8] {
  let mut start = usize.ZERO
  let mut end = a.length
  while start < end && space(a[start]) { start = start + usize.ONE }
  while end > start && space(a[end - usize.ONE]) { end = end - usize.ONE }
  return Slice.view<u8>(a, start, end - start)
}
pub fn view<'a>(text: &'a [u8], line: &Line) -> &'a [u8] {
  return Slice.view<u8>(text, line.start, line.end - line.start)
}
pub effect fn lines(text: &[u8]) -> List<Line> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<Line>.make()
  let mut start = usize.ZERO
  let mut i = usize.ZERO
  while i < text.length {
    if text[i] == 10 || text[i] == 13 {
      run List<Line>.append(&mut result, Line { start: start, end: i })
      if text[i] == 13 && i + usize.ONE < text.length && text[i + usize.ONE] == 10 { i = i + usize.ONE }
      start = i + usize.ONE
    }
    i = i + usize.ONE
  }
  if start < text.length { run List<Line>.append(&mut result, Line { start: start, end: text.length }) }
  return move result
}
fn indent(text: &[u8]) -> usize {
  let mut i = usize.ZERO
  while i < text.length && text[i] == 32 { i = i + usize.ONE }
  return i
}
fn runLength(text: &[u8], at: usize, marker: u8) -> usize {
  let mut end = at
  while end < text.length && text[end] == marker { end = end + usize.ONE }
  return end - at
}
// A nonzero fence width denotes a valid opener. Backticks in backtick info invalidate it.
fn fence(text: &[u8]) -> usize {
  let at = indent(text)
  if at > 3 || at == text.length || (text[at] != 96 && text[at] != 126) { return usize.ZERO }
  let width = runLength(text, at, text[at])
  if width < 3 { return usize.ZERO }
  if text[at] == 96 {
    let mut i = at + width
    while i < text.length {
      if text[i] == 96 { return usize.ZERO }
      i = i + usize.ONE
    }
  }
  return width
}
fn heading(text: &[u8]) -> usize {
  let at = indent(text)
  if at > 3 || at == text.length { return usize.ZERO }
  let depth = runLength(text, at, 35)
  if depth == usize.ZERO || depth > 6 { return usize.ZERO }
  if at + depth < text.length && !space(text[at + depth]) { return usize.ZERO }
  return depth
}
fn setext(text: &[u8]) -> usize {
  let at = indent(text)
  if at > 3 || at == text.length { return usize.ZERO }
  let marker = text[at]
  if marker != 61 && marker != 45 { return usize.ZERO }
  let width = runLength(text, at, marker)
  if trim(Slice.view<u8>(text, at + width, text.length - at - width)).length != usize.ZERO { return usize.ZERO }
  if marker == 61 { return usize.ONE }
  return 2
}
fn rule(text: &[u8]) -> bool {
  let at = indent(text)
  if at > 3 || at == text.length { return false }
  let marker = text[at]
  if marker != 42 && marker != 45 && marker != 95 { return false }
  let mut count = usize.ZERO
  let mut i = at
  while i < text.length {
    if text[i] == marker { count = count + usize.ONE }
    else if text[i] != 32 && text[i] != 9 { return false }
    i = i + usize.ONE
  }
  return count >= 3
}
struct Marker {
  width: usize,
  number: usize,
  ordered: bool,
  byte: u8,
}
fn marker(text: &[u8]) -> Marker {
  let empty = Marker { width: 0, number: 0, ordered: false, byte: 0 }
  let at = indent(text)
  if at > 3 || at == text.length { return move empty }
  let mut end = at
  let mut number = usize.ZERO
  let mut ordered = false
  if text[at] == 45 || text[at] == 43 || text[at] == 42 { end = end + usize.ONE }
  else {
    while end < text.length && text[end] >= 48 && text[end] <= 57 && end - at < 9 {
      number = number * 10 + Intrinsic.u8ToUsize(text[end] - 48)
      end = end + usize.ONE
    }
    if end == at || end == text.length || (text[end] != 46 && text[end] != 41) { return move empty }
    ordered = true
    end = end + usize.ONE
  }
  let byte = text[end - usize.ONE]
  if end < text.length && text[end] != 32 && text[end] != 9 { return move empty }
  let markerEnd = end
  while end < text.length && (text[end] == 32 || text[end] == 9) { end = end + usize.ONE }
  if end - markerEnd > 4 { end = markerEnd + usize.ONE }
  return Marker { width: end, number: number, ordered: ordered, byte: byte }
}
fn quote(text: &[u8]) -> usize {
  let at = indent(text)
  if at > 3 || at == text.length || text[at] != 62 { return usize.ZERO }
  let mut end = at + usize.ONE
  if end < text.length && (text[end] == 32 || text[end] == 9) { end = end + usize.ONE }
  return end
}
fn definitionPrefix(text: &[u8]) -> usize {
  let value = trim(text)
  if value.length < 4 || value[0] != 91 { return usize.ZERO }
  let mut i = usize.ONE
  while i + usize.ONE < value.length && i <= 1000 {
    if value[i] == 92 {
      i = i + 2
      continue
    }
    if value[i] == 91 { return usize.ZERO }
    if value[i] == 93 && value[i + usize.ONE] == 58 {
      if trim(Slice.view<u8>(value, 1, i - usize.ONE)).length == usize.ZERO { return usize.ZERO }
      return i + 2
    }
    i = i + usize.ONE
  }
  return usize.ZERO
}
fn definition(text: &[u8]) -> bool {
  let value = trim(text)
  let prefix = definitionPrefix(value)
  if prefix == usize.ZERO { return false }
  let rest = trim(Slice.view<u8>(value, prefix, value.length - prefix))
  if rest.length == usize.ZERO { return false }
  let mut at = usize.ZERO
  if rest[0] == 60 {
    at = usize.ONE
    while at < rest.length && rest[at] != 62 {
      if rest[at] == 60 || rest[at] == 10 { return false }
      if rest[at] == 92 && at + usize.ONE < rest.length { at = at + usize.ONE }
      at = at + usize.ONE
    }
    if at == rest.length { return false }
    at = at + usize.ONE
  } else {
    let mut depth = usize.ZERO
    while at < rest.length && !space(rest[at]) {
      if rest[at] == 92 && at + usize.ONE < rest.length {
        at = at + 2
        continue
      }
      if rest[at] == 60 { return false }
      if rest[at] == 40 { depth = depth + usize.ONE }
      if rest[at] == 41 {
        if depth == usize.ZERO { return false }
        depth = depth - usize.ONE
      }
      at = at + usize.ONE
    }
    if depth != usize.ZERO { return false }
  }
  let tail = trim(Slice.view<u8>(rest, at, rest.length - at))
  if tail.length == usize.ZERO { return true }
  if tail.length < 2 { return false }
  let mut closing = tail[0]
  if closing == 40 { closing = 41 }
  else if closing != 34 && closing != 39 { return false }
  return tail[tail.length - usize.ONE] == closing
}
fn starts(text: &[u8], prefix: &[u8]) -> bool {
  return text.length >= prefix.length && equalFold(Slice.view<u8>(text, 0, prefix.length), prefix)
}
fn containsFold(text: &[u8], value: &[u8]) -> bool {
  let mut i = usize.ZERO
  while i + value.length <= text.length {
    if equalFold(Slice.view<u8>(text, i, value.length), value) { return true }
    i = i + usize.ONE
  }
  return false
}
fn rawEnd(text: &[u8]) -> &'static [u8] {
  let line = trim(text)
  if starts(line, b"<!--") { return b"-->" }
  if starts(line, b"<?") { return b"?>" }
  if starts(line, b"<![CDATA[") { return b"]]>" }
  if line.length > 2 && line[0] == 60 && line[1] == 33 && line[2] >= 65 && line[2] <= 90 { return b">" }
  if starts(line, b"<script") { return b"</script>" }
  if starts(line, b"<pre") { return b"</pre>" }
  if starts(line, b"<style") { return b"</style>" }
  if starts(line, b"<textarea") { return b"</textarea>" }
  return b""
}
fn rawBlock(text: &[u8]) -> bool {
  if indent(text) > 3 { return false }
  let line = trim(text)
  if rawEnd(line).length > usize.ZERO { return true }
  if line.length < 3 || line[0] != 60 { return false }
  let mut start = usize.ONE
  if line[start] == 47 { start = start + usize.ONE }
  let mut end = start
  while end < line.length && ((lower(line[end]) >= 97 && lower(line[end]) <= 122) || (line[end] >= 48 && line[end] <= 57)) { end = end + usize.ONE }
  if end == start || end == line.length || (!space(line[end]) && line[end] != 47 && line[end] != 62) { return false }
  let names = b"address|article|aside|base|basefont|blockquote|body|caption|center|col|colgroup|dd|details|dialog|dir|div|dl|dt|fieldset|figcaption|figure|footer|form|frame|frameset|h1|h2|h3|h4|h5|h6|head|header|hr|html|iframe|legend|li|link|main|menu|menuitem|nav|noframes|ol|optgroup|option|p|param|search|section|summary|table|tbody|td|tfoot|th|thead|title|tr|track|ul|"
  let name = Slice.view<u8>(line, start, end - start)
  let mut at = usize.ZERO
  start = usize.ZERO
  while at < names.length {
    if names[at] == 124 {
      if equalFold(name, Slice.view<u8>(names, start, at - start)) { return true }
      start = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}
// Complete custom HTML tags form type-seven HTML blocks only at a block boundary; unlike
// block-level tags they cannot interrupt an existing paragraph.
fn completeTag(text: &[u8]) -> bool {
  if indent(text) > 3 { return false }
  let value = trim(text)
  if value.length < 3 || value[0] != 60 || value[value.length - usize.ONE] != 62 { return false }
  let mut at = usize.ONE
  if value[at] == 47 { at = at + usize.ONE }
  if lower(value[at]) < 97 || lower(value[at]) > 122 { return false }
  at = at + usize.ONE
  while at < value.length && ((lower(value[at]) >= 97 && lower(value[at]) <= 122) || (value[at] >= 48 && value[at] <= 57) || value[at] == 45) { at = at + usize.ONE }
  if at == value.length || (!space(value[at]) && value[at] != 47 && value[at] != 62) { return false }
  let mut quote: u8 = 0
  while at < value.length {
    if quote != 0 {
      if value[at] == quote { quote = 0 }
    } else if value[at] == 34 || value[at] == 39 { quote = value[at] }
    else if value[at] == 62 { return at + usize.ONE == value.length }
    at = at + usize.ONE
  }
  return false
}
fn interrupts(text: &[u8]) -> bool {
  if trim(text).length == usize.ZERO || fence(text) > usize.ZERO || heading(text) > usize.ZERO || rule(text) || quote(text) > usize.ZERO || rawBlock(text) { return true }
  let item = marker(text)
  return item.width > usize.ZERO && (!item.ordered || item.number == usize.ONE)
}
effect fn add(result: &mut List<Block>, kind: usize, parent: usize, start: usize, end: usize, depth: usize, text: Bytes, info: Bytes) -> usize ! OutOfMemoryError ? &mut Allocator {
  let index = List<Block>.asSlice(&result.*).length
  run List<Block>.append(&mut result.*, Block { kind: kind, parent: parent, start: start, end: end, depth: depth, text: move text, info: move info })
  return index
}
effect fn parseLines(text: &[u8], input: &[Line], parent: usize, result: &mut List<Block>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut i = usize.ZERO
  while i < input.length {
    let line = view(text, &input[i])
    if trim(line).length == usize.ZERO {
      i = i + usize.ONE
      continue
    }
    let width = fence(line)
    if width > usize.ZERO {
      let lead = indent(line)
      let markerByte = line[lead]
      let info = run Bytes.copy(trim(Slice.view<u8>(line, lead + width, line.length - lead - width)))
      let mut code = Bytes.make()
      let mut j = i + usize.ONE
      let mut end = input[i].end
      let mut count = usize.ZERO
      while j < input.length {
        let next = view(text, &input[j])
        let nextLead = indent(next)
        let closeWidth = runLength(next, nextLead, markerByte)
        if nextLead <= 3 && closeWidth >= width && trim(Slice.view<u8>(next, nextLead + closeWidth, next.length - nextLead - closeWidth)).length == usize.ZERO {
          end = input[j].end
          j = j + usize.ONE
          break
        }
        let mut remove = nextLead
        if remove > lead { remove = lead }
        if count > usize.ZERO { run Bytes.append(&mut code, b"\n") }
        run Bytes.append(&mut code, Slice.view<u8>(next, remove, next.length - remove))
        count = count + usize.ONE
        end = input[j].end
        j = j + usize.ONE
      }
      drop run add(&mut result.*, CODE, parent, input[i].start + lead, end, 0, move code, move info)
      i = j
      continue
    }
    let depth = heading(line)
    if depth > usize.ZERO {
      let lead = indent(line)
      let body = trim(Slice.view<u8>(line, lead + depth, line.length - lead - depth))
      let mut end = body.length
      while end > usize.ZERO && body[end - usize.ONE] == 35 { end = end - usize.ONE }
      if end > usize.ZERO && end < body.length && space(body[end - usize.ONE]) { end = end - usize.ONE }
      else { end = body.length }
      drop run add(&mut result.*, HEADING, parent, input[i].start, input[i].end, depth, run Bytes.copy(trim(Slice.view<u8>(body, 0, end))), Bytes.make())
      i = i + usize.ONE
      continue
    }
    if rule(line) {
      drop run add(&mut result.*, RULE, parent, input[i].start, input[i].end, 0, Bytes.make(), Bytes.make())
      i = i + usize.ONE
      continue
    }
    if rawBlock(line) || completeTag(line) {
      let closing = rawEnd(line)
      let mut body = Bytes.make()
      let mut j = i
      while j < input.length {
        let next = view(text, &input[j])
        if closing.length == usize.ZERO && trim(next).length == usize.ZERO { break }
        if j > i { run Bytes.append(&mut body, b"\n") }
        run Bytes.append(&mut body, next)
        j = j + usize.ONE
        if closing.length > usize.ZERO && containsFold(next, closing) { break }
      }
      drop run add(&mut result.*, RAW, parent, input[i].start, input[j - usize.ONE].end, 0, move body, Bytes.make())
      i = j
      continue
    }
    if quote(line) > usize.ZERO {
      let container = run add(&mut result.*, QUOTE, parent, input[i].start, input[i].end, 0, Bytes.make(), Bytes.make())
      let mut nested = List<Line>.make()
      let mut j = i
      let mut previousBlank = false
      while j < input.length {
        let next = view(text, &input[j])
        let prefix = quote(next)
        if prefix == usize.ZERO && (previousBlank || interrupts(next)) { break }
        run List<Line>.append(&mut nested, Line { start: input[j].start + prefix, end: input[j].end })
        previousBlank = trim(Slice.view<u8>(next, prefix, next.length - prefix)).length == usize.ZERO
        j = j + usize.ONE
      }
      run parseLines(text, List<Line>.asSlice(&nested), container, &mut result.*)
      let mut quoteBlocks = List<Block>.asMutSlice(&mut result.*)
      quoteBlocks[container].end = input[j - usize.ONE].end
      i = j
      continue
    }
    let first = marker(line)
    if first.width > usize.ZERO {
      let mut kind = UNORDERED
      if first.ordered { kind = ORDERED }
      let container = run add(&mut result.*, kind, parent, input[i].start, input[i].end, 0, Bytes.make(), Bytes.make())
      let mut j = i
      while j < input.length {
        let current = marker(view(text, &input[j]))
        if current.width == usize.ZERO || current.ordered != first.ordered || current.byte != first.byte { break }
        let item = run add(&mut result.*, ITEM, container, input[j].start, input[j].end, 0, Bytes.make(), Bytes.make())
        let mut nested = List<Line>.make()
        run List<Line>.append(&mut nested, Line { start: input[j].start + current.width, end: input[j].end })
        j = j + usize.ONE
        let mut blank = false
        while j < input.length {
          let next = view(text, &input[j])
          let lead = indent(next)
          if trim(next).length == usize.ZERO {
            run List<Line>.append(&mut nested, Line { start: input[j].end, end: input[j].end })
            blank = true
          } else if lead >= current.width {
            run List<Line>.append(&mut nested, Line { start: input[j].start + current.width, end: input[j].end })
            blank = false
          } else {
            if blank || interrupts(next) { break }
            run List<Line>.append(&mut nested, Line { start: input[j].start, end: input[j].end })
          }
          j = j + usize.ONE
        }
        run parseLines(text, List<Line>.asSlice(&nested), item, &mut result.*)
        let mut itemBlocks = List<Block>.asMutSlice(&mut result.*)
        itemBlocks[item].end = input[j - usize.ONE].end
      }
      let mut listBlocks = List<Block>.asMutSlice(&mut result.*)
      listBlocks[container].end = input[j - usize.ONE].end
      i = j
      continue
    }
    if indent(line) >= 4 || line[0] == 9 {
      let mut code = Bytes.make()
      let mut j = i
      let mut lastContent = usize.ZERO
      while j < input.length {
        let next = view(text, &input[j])
        let lead = indent(next)
        let empty = trim(next).length == usize.ZERO
        if !empty && lead < 4 && next[0] != 9 { break }
        if j > i { run Bytes.append(&mut code, b"\n") }
        if !empty {
          let mut remove = usize.ONE
          if lead >= 4 { remove = 4 }
          run Bytes.append(&mut code, Slice.view<u8>(next, remove, next.length - remove))
          lastContent = Bytes.length(&code)
        }
        j = j + usize.ONE
      }
      let value = run Bytes.copy(Slice.view<u8>(Bytes.asSlice(&code), 0, lastContent))
      drop run add(&mut result.*, CODE, parent, input[i].start, input[j - usize.ONE].end, 0, move value, Bytes.make())
      i = j
      continue
    }
    let prefix = definitionPrefix(line)
    if prefix > usize.ZERO {
      let mut authored = run Bytes.copy(trim(line))
      let mut j = i + usize.ONE
      if !definition(Bytes.asSlice(&authored)) && trim(Slice.view<u8>(trim(line), prefix, trim(line).length - prefix)).length == usize.ZERO && j < input.length {
        run Bytes.append(&mut authored, b"\n")
        run Bytes.append(&mut authored, trim(view(text, &input[j])))
        j = j + usize.ONE
      }
      if definition(Bytes.asSlice(&authored)) {
        if j < input.length {
          let title = trim(view(text, &input[j]))
          if title.length >= 2 && (title[0] == 34 || title[0] == 39 || title[0] == 40) {
            let mut candidate = run Bytes.copy(Bytes.asSlice(&authored))
            run Bytes.append(&mut candidate, b"\n")
            run Bytes.append(&mut candidate, title)
            if definition(Bytes.asSlice(&candidate)) {
              authored = move candidate
              j = j + usize.ONE
            }
          }
        }
        drop run add(&mut result.*, DEFINITION, parent, input[i].start, input[j - usize.ONE].end, 0, move authored, Bytes.make())
        i = j
        continue
      }
    }
    let mut body = Bytes.make()
    run Bytes.append(&mut body, Slice.view<u8>(line, indent(line), line.length - indent(line)))
    let mut j = i + usize.ONE
    let mut headingDepth = usize.ZERO
    while j < input.length {
      let next = view(text, &input[j])
      let underline = setext(next)
      if underline > usize.ZERO {
        headingDepth = underline
        j = j + usize.ONE
        break
      }
      if interrupts(next) { break }
      run Bytes.append(&mut body, b"\n")
      run Bytes.append(&mut body, Slice.view<u8>(next, indent(next), next.length - indent(next)))
      j = j + usize.ONE
    }
    let mut kind = PARAGRAPH
    if headingDepth > usize.ZERO { kind = HEADING }
    drop run add(&mut result.*, kind, parent, input[i].start, input[j - usize.ONE].end, headingDepth, move body, Bytes.make())
    i = j
  }
}
/// Parses normalized Markdown into source-ordered blocks with parent indexes.
pub effect fn parse(text: &[u8]) -> List<Block> ! OutOfMemoryError ? &mut Allocator {
  let input = run lines(text)
  let mut result = List<Block>.make()
  run parseLines(text, List<Line>.asSlice(&input), usize.MAX, &mut result)
  return move result
}
