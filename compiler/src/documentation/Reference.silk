//! Deterministic standard-library pages and compact, profile-aware page merging.
import documentation.Model {Project, Module, Item, Document}
import documentation.Model
import documentation.Markdown
import diagnostic.JsonText
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.option {Option}
import silk.collections.slice {Slice}
import silk.num.usize

/// One relative output filename and its complete deterministic bytes.
pub struct File {
  pub path: Bytes,
  pub content: Bytes,
}
/// A standard-library module and its optional recommended import namespace.
pub struct ManifestEntry {
  pub module: Bytes,
  pub namespace: Option<Bytes>,
}
/// Compact capture of one profile. Only merge output is publishable: captured pages carry
/// private link markers which are resolved after all profile surfaces are known.
pub struct Group {
  pub profile: Bytes,
  pub target: Bytes,
  pub files: List<File>,
  pub counts: List<usize>,
  pub linkPaths: List<Bytes>,
  pub summaries: List<Bytes>,
  /// Each module's `@category` name, or empty bytes for an uncategorized module.
  pub categories: List<Bytes>,
}
pub struct RenderError { pub message: &'static [u8] }

/// Whether an item and every containing declaration are published on reference pages.
pub fn visible(items: &[Item], index: usize) -> bool {
  let mut cursor = index
  while true {
    let item = &items[cursor]
    if Model.equal(Bytes.asSlice(&item.visibility), b"Private") { return false }
    if Model.equal(Bytes.asSlice(&item.kind), b"Parameter") || Model.equal(Bytes.asSlice(&item.kind), b"TypeParameter") {
      if let Option<Document>.None = &item.documentation { return false }
    }
    match &item.parent {
      Option<usize>.None => { return true }
      Option<usize>.Some { value } => { cursor = value }
    }
  }
  return false
}

fn count(module: &Module) -> usize {
  let items = List<Item>.asSlice(&module.items)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < items.length {
    if let Option<usize>.None = &items[at].parent {
      if Model.equal(Bytes.asSlice(&items[at].visibility), b"Public") { count = count + usize.ONE }
    }
    at = at + usize.ONE
  }
  return count
}

effect fn moduleIndex(project: &Project, name: &[u8]) -> usize ! RenderError {
  let modules = List<Module>.asSlice(&project.modules)
  let mut at = usize.ZERO
  while at < modules.length {
    if Model.equal(Bytes.asSlice(&modules[at].name), name) { return at }
    at = at + usize.ONE
  }
  fail RenderError { message: b"Reference manifest module is missing" }
}

effect fn prepareFiles(project: &Project, manifest: &[ManifestEntry]) -> List<File> ! RenderError | OutOfMemoryError ? &mut Allocator {
  let modules = List<Module>.asSlice(&project.modules)
  let mut files = List<File>.make()
  let mut at = usize.ZERO
  while at < manifest.length {
    let index = run moduleIndex(project, Bytes.asSlice(&manifest[at].module))
    let file = run Markdown.moduleFile(Bytes.asSlice(&manifest[at].module))
    if Model.equal(Bytes.asSlice(&file), b"index.md") { fail RenderError { message: b"Reference module path collides with index" } }
    let mut earlier = usize.ZERO
    while earlier < at {
      let previous = &List<File>.asSlice(&files)[earlier].path
      if Model.equal(Bytes.asSlice(&file), Bytes.asSlice(&previous)) { fail RenderError { message: b"Reference module path collision" } }
      earlier = earlier + usize.ONE
    }
    let items = List<Item>.asSlice(&modules[index].items)
    let mut item = usize.ZERO
    while item < items.length {
      earlier = usize.ZERO
      while earlier < item {
        if Model.equal(Bytes.asSlice(&items[item].id), Bytes.asSlice(&items[earlier].id)) { fail RenderError { message: b"Reference declaration anchor collision" } }
        earlier = earlier + usize.ONE
      }
      item = item + usize.ONE
    }
    run List<File>.append(&mut files, File {path: move file, content: Bytes.make()})
    at = at + usize.ONE
  }
  return move files
}

effect fn appendDocs(output: &mut Bytes, docs: &Option<Document>, project: &Project, index: usize, depth: usize, paths: &[Bytes]) -> () ! OutOfMemoryError ? &mut Allocator {
  if let Option<Document>.Some { value } = &docs.* {
    let prose = run Markdown.referenceWithPaths(&value, project, index, depth, paths)
    run Bytes.append(&mut output.*, Bytes.asSlice(&prose))
    run Bytes.append(&mut output.*, b"\n\n")
  }
  return ()
}

effect fn inlineCode(output: &mut Bytes, value: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut longest = usize.ZERO
  let mut current = usize.ZERO
  let mut at = usize.ZERO
  while at < value.length {
    if value[at] == 96 {
      current = current + usize.ONE
      if current > longest { longest = current }
    } else { current = usize.ZERO }
    at = at + usize.ONE
  }
  let delimiter = longest + usize.ONE
  at = usize.ZERO
  while at < delimiter {
    run Bytes.append(&mut output.*, b"`")
    at = at + usize.ONE
  }
  let pad = value.length > usize.ZERO && (value[0] == 96 || value[value.length - usize.ONE] == 96 || value[0] == 32 || value[value.length - usize.ONE] == 32)
  if pad { run Bytes.append(&mut output.*, b" ") }
  at = usize.ZERO
  while at < value.length {
    if value[at] == 10 || value[at] == 13 { run Bytes.append(&mut output.*, b" ") }
    else { run Bytes.append(&mut output.*, &[value[at]]) }
    at = at + usize.ONE
  }
  if pad { run Bytes.append(&mut output.*, b" ") }
  at = usize.ZERO
  while at < delimiter {
    run Bytes.append(&mut output.*, b"`")
    at = at + usize.ONE
  }
  return ()
}

effect fn fence(output: &mut Bytes, signature: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut longest = usize.ONE + usize.ONE
  let mut current = usize.ZERO
  let mut at = usize.ZERO
  while at < signature.length {
    if signature[at] == 96 {
      current = current + usize.ONE
      if current > longest { longest = current }
    } else { current = usize.ZERO }
    at = at + usize.ONE
  }
  let length = longest + usize.ONE
  at = usize.ZERO
  while at < length {
    run Bytes.append(&mut output.*, b"`")
    at = at + usize.ONE
  }
  run Bytes.append(&mut output.*, b"silk\n")
  run Bytes.append(&mut output.*, signature)
  run Bytes.append(&mut output.*, b"\n")
  at = usize.ZERO
  while at < length {
    run Bytes.append(&mut output.*, b"`")
    at = at + usize.ONE
  }
  return run Bytes.append(&mut output.*, b"\n\n")
}

fn primitive(name: &[u8]) -> bool {
  let names = [b"bool", b"char", b"f32", b"f64", b"i8", b"i16", b"i32", b"i64", b"isize", b"u8", b"u16", b"u32", b"u64", b"usize"]
  let mut at = usize.ZERO
  while at < names.length {
    if Model.equal(name, names[at]) { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn page(project: &Project, entry: &ManifestEntry, index: usize, paths: &[Bytes]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let module = &List<Module>.asSlice(&project.modules)[index]
  let items = List<Item>.asSlice(&module.items)
  let mut output = run Bytes.copy(b"# ")
  run inlineCode(&mut output, Bytes.asSlice(&module.name))
  run Bytes.append(&mut output, b"\n\n<!-- Generated by silk doc-reference. Do not edit by hand. -->\n\n")
  run appendDocs(&mut output, &module.documentation, project, index, usize.ONE, paths)
  let publicCount = count(module)
  if publicCount > usize.ZERO {
    if let Option<Bytes>.Some {value: namespace} = &entry.namespace {
      run Bytes.append(&mut output, b"Import as ")
      run inlineCode(&mut output, Bytes.asSlice(&namespace))
      run Bytes.append(&mut output, b" with ")
      let mut statement = run Bytes.copy(b"import ")
      let name = Bytes.asSlice(&module.name)
      let mut at = usize.ZERO
      while at < name.length {
        if name[at] == 47 { run Bytes.append(&mut statement, b".") } else { run Bytes.append(&mut statement, Slice.view(name, at, usize.ONE)) }
        at = at + usize.ONE
      }
      let mut direct = false
      at = usize.ZERO
      while at < items.length {
        if Model.equal(Bytes.asSlice(&items[at].visibility), b"Public") && Model.equal(Bytes.asSlice(&items[at].name), Bytes.asSlice(&namespace)) { direct = true }
        at = at + usize.ONE
      }
      if !primitive(Bytes.asSlice(&namespace)) {
        if direct { run Bytes.append(&mut statement, b" { ") } else { run Bytes.append(&mut statement, b" as ") }
        run Bytes.append(&mut statement, Bytes.asSlice(&namespace))
        if direct { run Bytes.append(&mut statement, b" }") }
      }
      run inlineCode(&mut output, Bytes.asSlice(&statement))
      run Bytes.append(&mut output, b".\n\n")
    }
  }
  run Bytes.append(&mut output, b"Public declarations: ")
  run JsonText.appendDecimal(&mut output, publicCount)
  run Bytes.append(&mut output, b".\n\n")
  let mut at = usize.ZERO
  let mut any = false
  while at < items.length {
    if visible(items, at) {
      any = true
      let item = &items[at]
      let anchor = run Markdown.anchor(items, at)
      run Bytes.append(&mut output, b"<a id=\"")
      run Bytes.append(&mut output, Bytes.asSlice(&anchor))
      run Bytes.append(&mut output, b"\"></a>\n\n")
      let mut depth = usize.ONE + usize.ONE
      let mut cursor = at
      while true {
        match &items[cursor].parent {
          Option<usize>.None => { break }
          Option<usize>.Some { value } => {
            if depth < 6 { depth = depth + usize.ONE }
            cursor = value
          }
        }
      }
      let mut hash = usize.ZERO
      while hash < depth {
        run Bytes.append(&mut output, b"#")
        hash = hash + usize.ONE
      }
      run Bytes.append(&mut output, b" ")
      let kind = Bytes.asSlice(&item.kind)
      if Model.equal(kind, b"Parameter") || Model.equal(kind, b"Field") || Model.equal(kind, b"Operation") || Model.equal(kind, b"Implementation") || Model.equal(kind, b"Method") {
        run Bytes.append(&mut output, kind)
        run Bytes.append(&mut output, b" ")
      }
      if Model.equal(kind, b"TypeParameter") { run Bytes.append(&mut output, b"Type parameter ") }
      if Model.equal(kind, b"AssociatedFunction") { run Bytes.append(&mut output, b"Associated function ") }
      run inlineCode(&mut output, Bytes.asSlice(&item.name))
      run Bytes.append(&mut output, b"\n\n")
      run fence(&mut output, Bytes.asSlice(&item.signature))
      run appendDocs(&mut output, &item.documentation, project, index, depth, paths)
    }
    at = at + usize.ONE
  }
  if !any { run Bytes.append(&mut output, b"This module declares no public items.\n") }
  return move output
}

fn contains(source: &[u8], needle: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at <= source.length {
    if starts(source, at, needle) { return true }
    at = at + usize.ONE
  }
  return false
}

fn documentContains(document: &Option<Document>, needle: &[u8]) -> bool {
  return match &document.* {
    Option<Document>.None => false
    Option<Document>.Some { value } => contains(Bytes.asSlice(&value.markdown), needle)
  }
}

fn markerUsed(project: &Project, manifest: &[ManifestEntry], needle: &[u8]) -> bool {
  if contains(Bytes.asSlice(&project.profile), needle) || contains(Bytes.asSlice(&project.target), needle) { return true }
  let modules = List<Module>.asSlice(&project.modules)
  let mut at = usize.ZERO
  while at < manifest.length {
    if let Option<Bytes>.Some {value} = &manifest[at].namespace {
      if contains(Bytes.asSlice(&value), needle) { return true }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < modules.length {
    let module = &modules[at]
    if contains(Bytes.asSlice(&module.name), needle) || documentContains(&module.documentation, needle) { return true }
    let items = List<Item>.asSlice(&module.items)
    let mut item = usize.ZERO
    while item < items.length {
      if contains(Bytes.asSlice(&items[item].name), needle) || contains(Bytes.asSlice(&items[item].id), needle) || contains(Bytes.asSlice(&items[item].signature), needle) || documentContains(&items[item].documentation, needle) { return true }
      item = item + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

/// Captures owned page bytes and private link markers, allowing immediate semantic-store release.
pub effect fn capture(project: &Project, manifest: &[ManifestEntry]) -> Group ! RenderError | OutOfMemoryError ? &mut Allocator {
  let mut files = run prepareFiles(project, manifest)
  let mut marker = run Bytes.copy(b"silk-doc-link-")
  while markerUsed(project, manifest, Bytes.asSlice(&marker)) { run Bytes.append(&mut marker, b"-") }
  let mut linkPaths = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < manifest.length {
    let mut path = run Bytes.copy(Bytes.asSlice(&marker))
    run JsonText.appendDecimal(&mut path, at)
    run Bytes.append(&mut path, b".md")
    run List<Bytes>.append(&mut linkPaths, move path)
    at = at + usize.ONE
  }
  let modules = List<Module>.asSlice(&project.modules)
  let mut paths = List<Bytes>.make()
  at = usize.ZERO
  while at < modules.length {
    let mut selected = Bytes.make()
    let mut entry = usize.ZERO
    while entry < manifest.length {
      if Model.equal(Bytes.asSlice(&modules[at].name), Bytes.asSlice(&manifest[entry].module)) {
        selected = run Bytes.copy(Bytes.asSlice(&List<Bytes>.asSlice(&linkPaths)[entry]))
        break
      }
      entry = entry + usize.ONE
    }
    run List<Bytes>.append(&mut paths, move selected)
    at = at + usize.ONE
  }
  let mut counts = List<usize>.make()
  let mut summaries = List<Bytes>.make()
  let mut categories = List<Bytes>.make()
  at = usize.ZERO
  while at < manifest.length {
    let index = run moduleIndex(project, Bytes.asSlice(&manifest[at].module))
    let content = run page(project, &manifest[at], index, List<Bytes>.asSlice(&paths))
    let capturedFiles = List<File>.asMutSlice(&mut files)
    capturedFiles[at].content = move content
    run List<usize>.append(&mut counts, count(&modules[index]))
    let summary = match &modules[index].documentation {
      Option<Document>.None => Bytes.make()
      Option<Document>.Some { value } => run Markdown.summary(&value)
    }
    run List<Bytes>.append(&mut summaries, move summary)
    let category = match &modules[index].category {
      Option<Bytes>.None => Bytes.make()
      Option<Bytes>.Some { value } => run Bytes.copy(Bytes.asSlice(&value))
    }
    run List<Bytes>.append(&mut categories, move category)
    at = at + usize.ONE
  }
  return Group { profile: run Bytes.copy(Bytes.asSlice(&project.profile)), target: run Bytes.copy(Bytes.asSlice(&project.target)), files: move files, counts: move counts, linkPaths: move linkPaths, summaries: move summaries, categories: move categories }
}

effect fn variantPath(base: &[u8], variant: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  if variant == usize.ZERO { return run Bytes.copy(base) }
  let mut result = run Bytes.copy(Slice.view(base, usize.ZERO, base.length - 3))
  run Bytes.append(&mut result, b".profile-")
  run JsonText.appendDecimal(&mut result, variant + usize.ONE)
  run Bytes.append(&mut result, b".md")
  return move result
}

fn starts(source: &[u8], at: usize, value: &[u8]) -> bool {
  return value.length <= source.length - at && Model.equal(Slice.view(source, at, value.length), value)
}

effect fn linked(source: &[u8], markers: &[Bytes], paths: &[Bytes], profile: usize, width: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut result = Bytes.make()
  let mut at = usize.ZERO
  while at < source.length {
    let mut replaced = false
    if starts(source, at, b"(./") {
      let mut target = usize.ZERO
      while target < width {
        let file = Bytes.asSlice(&markers[target])
        if starts(source, at + 3, file) && at + 3 + file.length < source.length && source[at + 3 + file.length] == 35 {
          run Bytes.append(&mut result, b"(./")
          run Bytes.append(&mut result, Bytes.asSlice(&paths[profile * width + target]))
          at = at + 3 + file.length
          replaced = true
          break
        }
        target = target + usize.ONE
      }
    }
    if !replaced {
      run Bytes.append(&mut result, &[source[at]])
      at = at + usize.ONE
    }
  }
  return move result
}

// Escapes Markdown punctuation so authored text stays literal inside a table cell.
effect fn escaped(output: &mut Bytes, text: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut byte = usize.ZERO
  while byte < text.length {
    if text[byte] == 124 || text[byte] == 92 || text[byte] == 96 || text[byte] == 42 || text[byte] == 95 || text[byte] == 91 || text[byte] == 93 || text[byte] == 60 || text[byte] == 62 { run Bytes.append(&mut output.*, b"\\") }
    run Bytes.append(&mut output.*, &[text[byte]])
    byte = byte + usize.ONE
  }
  return ()
}

/// Merges identical profile pages, splitting further whenever their outgoing link targets differ.
pub effect fn merge(groups: &[Group], manifest: &[ManifestEntry]) -> List<File> ! RenderError | OutOfMemoryError ? &mut Allocator {
  let width = manifest.length
  let mut paths = List<Bytes>.make()
  let mut owners = List<usize>.make()
  let mut group = usize.ZERO
  while group < groups.length {
    let files = List<File>.asSlice(&groups[group].files)
    if files.length != width || List<usize>.length(&groups[group].counts) != width || List<Bytes>.length(&groups[group].linkPaths) != width || List<Bytes>.length(&groups[group].summaries) != width || List<Bytes>.length(&groups[group].categories) != width { fail RenderError { message: b"Reference profile manifest mismatch" } }
    let mut entry = usize.ZERO
    while entry < width {
      run List<Bytes>.append(&mut paths, run Bytes.copy(Bytes.asSlice(&files[entry].path)))
      run List<usize>.append(&mut owners, usize.ZERO)
      entry = entry + usize.ONE
    }
    group = group + usize.ONE
  }
  // Partition refinement terminates: pages only split, never rejoin. Include the prior owner
  // in comparison to prevent a link cycle from oscillating between two equivalent partitions.
  let mut changed = true
  while changed {
    changed = false
    let mut nextPaths = List<Bytes>.make()
    let mut nextOwners = List<usize>.make()
    let mut rendered = List<Bytes>.make()
    group = usize.ZERO
    while group < groups.length {
      let files = List<File>.asSlice(&groups[group].files)
      let mut entry = usize.ZERO
      while entry < width {
        let content = run linked(Bytes.asSlice(&files[entry].content), List<Bytes>.asSlice(&groups[group].linkPaths), List<Bytes>.asSlice(&paths), group, width)
        let mut owner = group
        let mut earlier = usize.ZERO
        let oldOwners = List<usize>.asSlice(&owners)
        while earlier < group {
          if oldOwners[earlier * width + entry] == oldOwners[group * width + entry] && Model.equal(Bytes.asSlice(&content), Bytes.asSlice(&List<Bytes>.asSlice(&rendered)[earlier * width + entry])) {
            owner = earlier
            break
          }
          earlier = earlier + usize.ONE
        }
        let mut variant = usize.ZERO
        if owner == group {
          earlier = usize.ZERO
          while earlier < group {
            if List<usize>.asSlice(&nextOwners)[earlier * width + entry] == earlier { variant = variant + usize.ONE }
            earlier = earlier + usize.ONE
          }
        }
        let mut path = Bytes.make()
        if owner == group {
          path = run variantPath(Bytes.asSlice(&files[entry].path), variant)
        } else {
          path = run Bytes.copy(Bytes.asSlice(&List<Bytes>.asSlice(&nextPaths)[owner * width + entry]))
        }
        if owner != oldOwners[group * width + entry] || !Model.equal(Bytes.asSlice(&path), Bytes.asSlice(&List<Bytes>.asSlice(&paths)[group * width + entry])) { changed = true }
        run List<Bytes>.append(&mut nextPaths, move path)
        run List<usize>.append(&mut nextOwners, owner)
        run List<Bytes>.append(&mut rendered, move content)
        entry = entry + usize.ONE
      }
      group = group + usize.ONE
    }
    paths = move nextPaths
    owners = move nextOwners
  }
  let mut result = List<File>.make()
  let mut index = run Bytes.copy(b"# Silk standard library\n\n<!-- Generated by silk doc-reference. Do not edit by hand. -->\n\nEach page describes the selected source API for the listed profiles. Distinct surfaces have separate pages.\n\n| Module | Category | Import namespace | Profiles | Public declarations | Summary |\n| --- | --- | --- | --- | ---: | --- |\n")
  let mut entry = usize.ZERO
  while entry < width {
    group = usize.ZERO
    while group < groups.length {
      if List<usize>.asSlice(&owners)[group * width + entry] == group {
        let path = &List<Bytes>.asSlice(&paths)[group * width + entry]
        let mut availability = Bytes.make()
        let mut profile = usize.ZERO
        while profile < groups.length {
          if List<usize>.asSlice(&owners)[profile * width + entry] == group {
            if Bytes.length(&availability) > usize.ZERO { run Bytes.append(&mut availability, b", ") }
            run inlineCode(&mut availability, Bytes.asSlice(&groups[profile].profile))
          }
          profile = profile + usize.ONE
        }
        let files = List<File>.asSlice(&groups[group].files)
        let mut content = run linked(Bytes.asSlice(&files[entry].content), List<Bytes>.asSlice(&groups[group].linkPaths), List<Bytes>.asSlice(&paths), group, width)
        let category = Bytes.asSlice(&List<Bytes>.asSlice(&groups[group].categories)[entry])
        if category.length > usize.ZERO {
          run Bytes.append(&mut content, b"\nCategory: ")
          run escaped(&mut content, category)
          run Bytes.append(&mut content, b".\n")
        }
        run Bytes.append(&mut content, b"\nProfiles: ")
        run Bytes.append(&mut content, Bytes.asSlice(&availability))
        run Bytes.append(&mut content, b".\n")
        run List<File>.append(&mut result, File { path: run Bytes.copy(Bytes.asSlice(path)), content: move content })
        run Bytes.append(&mut index, b"| [")
        run inlineCode(&mut index, Bytes.asSlice(&manifest[entry].module))
        run Bytes.append(&mut index, b"](./")
        run Bytes.append(&mut index, Bytes.asSlice(path))
        run Bytes.append(&mut index, b") | ")
        run escaped(&mut index, category)
        run Bytes.append(&mut index, b" | ")
        if let Option<Bytes>.Some {value} = &manifest[entry].namespace {
          run inlineCode(&mut index, Bytes.asSlice(&value))
        } else { run Bytes.append(&mut index, b"Not applicable") }
        run Bytes.append(&mut index, b" | ")
        run Bytes.append(&mut index, Bytes.asSlice(&availability))
        run Bytes.append(&mut index, b" | ")
        run JsonText.appendDecimal(&mut index, List<usize>.asSlice(&groups[group].counts)[entry])
        run Bytes.append(&mut index, b" | ")
        run escaped(&mut index, Bytes.asSlice(&List<Bytes>.asSlice(&groups[group].summaries)[entry]))
        run Bytes.append(&mut index, b" |\n")
      }
      group = group + usize.ONE
    }
    entry = entry + usize.ONE
  }
  run Bytes.append(&mut index, b"\nProfile identities:\n\n")
  group = usize.ZERO
  while group < groups.length {
    run Bytes.append(&mut index, b"- ")
    run inlineCode(&mut index, Bytes.asSlice(&groups[group].profile))
    run Bytes.append(&mut index, b": target ")
    run inlineCode(&mut index, Bytes.asSlice(&groups[group].target))
    run Bytes.append(&mut index, b".\n")
    group = group + usize.ONE
  }
  run Bytes.append(&mut index, b"\n## See also\n\n- [Tutorial](../tutorial.md)\n- [Language reference](../../reference/)\n- [Diagnostic index](../diagnostics.md)\n")
  run List<File>.append(&mut result, File { path: run Bytes.copy(b"index.md"), content: move index })
  return move result
}

/// Renders one profile through the same collision and link rules as multi-profile generation.
pub effect fn render(project: &Project, manifest: &[ManifestEntry]) -> List<File> ! RenderError | OutOfMemoryError ? &mut Allocator {
  let group = run capture(project, manifest)
  return run merge(&[move group], manifest)
}
