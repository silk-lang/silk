//! Semantic code-link scanning and Markdown-only identity rewriting. All other inline spelling
//! remains authored text; this actor does not render HTML or interpret prose formatting.
import diagnostic.JsonText
import documentation.MarkdownBlocks
import documentation.Model { Document, Project, Link, Module, Item }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.option { Option }
import silk.collections.slice { Slice }
import silk.num.usize
import silk.collections.list { List }

pub struct Symbol {
  pub spelling: Bytes,
  pub start: usize,
  pub end: usize,
}

effect fn byte(output: &mut Bytes, value: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let one: [u8; 1] = [value]
  run Bytes.append(&mut output.*, &one)
}
fn count(text: &[u8], start: usize, c: u8) -> usize {
  let mut end = start
  while end < text.length && text[end] == c { end = end + usize.ONE }
  return end - start
}
fn escaped(text: &[u8], at: usize) -> bool {
  let mut i = at
  while i > usize.ZERO && text[i - usize.ONE] == 92 { i = i - usize.ONE }
  return (at - i) % 2 == usize.ONE
}
fn codeEnd(text: &[u8], at: usize, width: usize) -> usize {
  let mut i = at + width
  while i < text.length {
    if text[i] == 96 {
      let size = count(text, i, 96)
      if size == width { return i }
      i = i + size
    } else { i = i + usize.ONE }
  }
  return text.length
}
effect fn codeValue(text: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut value = Bytes.make()
  let mut i = usize.ZERO
  let mut nonspace = false
  while i < text.length {
    let mut c = text[i]
    if c == 10 || c == 13 { c = 32 }
    if c != 32 { nonspace = true }
    run byte(&mut value, c)
    i = i + usize.ONE
  }
  let bytes = Bytes.asSlice(&value)
  if nonspace && bytes.length >= 2 && bytes[0] == 32 && bytes[bytes.length - usize.ONE] == 32 {
    return run Bytes.copy(Slice.view<u8>(bytes, 1, bytes.length - 2))
  }
  return move value
}
fn identifierByte(c: u8) -> bool {
  return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}
// Appends the bare name of the type written in `text[start..end]`: `Box` for `silk.mem.box.Box<T>`.
effect fn typeName(output: &mut Bytes, text: &[u8], start: usize, end: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut first = start
  while first < end && !identifierByte(text[first]) { first = first + usize.ONE }
  let mut last = first
  let mut i = first
  while i < end && (identifierByte(text[i]) || text[i] == 46) {
    if text[i] == 46 { last = i + usize.ONE }
    i = i + usize.ONE
  }
  run Bytes.append(&mut output.*, Slice.view<u8>(text, last, i - last))
  return ()
}
// Appends one item's path segment: its name's identifier bytes, or for an implementation its
// owner type and `impl`, then the implemented interface: `Box.impl` or `Box.impl.Drop`.
effect fn segment(output: &mut Bytes, item: &Item) -> () ! OutOfMemoryError ? &mut Allocator {
  let name = Bytes.asSlice(&item.name)
  if MarkdownBlocks.same(Bytes.asSlice(&item.kind), b"Implementation") {
    let mut split = usize.MAX
    let mut at = usize.ZERO
    while split == usize.MAX && at + 5 <= name.length {
      if MarkdownBlocks.same(Slice.view<u8>(name, at, 5), b" for ") { split = at }
      at = at + usize.ONE
    }
    let mut owner = usize.ZERO
    if split != usize.MAX { owner = split + 5 }
    let before = Bytes.length(&output.*)
    run typeName(&mut output.*, name, owner, name.length)
    if Bytes.length(&output.*) > before { run byte(&mut output.*, 46) }
    run Bytes.append(&mut output.*, b"impl")
    if split != usize.MAX {
      let mark = Bytes.length(&output.*)
      run byte(&mut output.*, 46)
      run typeName(&mut output.*, name, usize.ZERO, split)
      if Bytes.length(&output.*) == mark + usize.ONE { Bytes.truncate(&mut output.*, mark) }
    }
    return ()
  }
  let mut i = usize.ZERO
  while i < name.length {
    let c = name[i]
    if identifierByte(c) { run byte(&mut output.*, c) }
    i = i + usize.ONE
  }
  return ()
}
// The item's owner path within its module, such as `AesGcmError.InvalidTag` or `impl.drop`.
effect fn path(items: &[Item], index: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut chain = List<usize>.make()
  let mut cursor = index
  while true {
    run List<usize>.append(&mut chain, cursor)
    match &items[cursor].parent {
      Option<usize>.None => { break }
      Option<usize>.Some { value } => { cursor = value }
    }
  }
  let owners = List<usize>.asSlice(&chain)
  let mut output = Bytes.make()
  let mut at = owners.length
  while at > usize.ZERO {
    at = at - usize.ONE
    run segment(&mut output, &items[owners[at]])
    if at > usize.ZERO { run byte(&mut output, 46) }
  }
  return move output
}
/// A readable page-local anchor: the item's owner path, suffixed `-2`, `-3`, ... when earlier items
/// in the same module share it, so overloads and repeated implementations stay distinct.
pub effect fn anchor(items: &[Item], index: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut output = run path(items, index)
  let mut repeats = usize.ONE
  let mut earlier = usize.ZERO
  while earlier < index {
    let previous = run path(items, earlier)
    if MarkdownBlocks.same(Bytes.asSlice(&previous), Bytes.asSlice(&output)) { repeats = repeats + usize.ONE }
    earlier = earlier + usize.ONE
  }
  if repeats > usize.ONE {
    run byte(&mut output, 45)
    run JsonText.appendDecimal(&mut output, repeats)
  }
  return move output
}
// The page of a module is named by its whole path below the library root, so `silk/simd/x86` is
// `arch-x86.md`: every segment after the first, lowercased, with each run of other bytes as one `-`.
pub effect fn moduleFile(name: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut start = usize.ZERO
  let mut i = usize.ZERO
  while i < name.length {
    if name[i] == 47 {
      start = i + usize.ONE
      break
    }
    i = i + usize.ONE
  }
  let mut output = Bytes.make()
  let mut separator = false
  i = start
  while i < name.length {
    let c = MarkdownBlocks.lower(name[i])
    if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
      if separator && Bytes.length(&output) > usize.ZERO { run byte(&mut output, 45) }
      run byte(&mut output, c)
      separator = false
    } else { separator = true }
    i = i + usize.ONE
  }
  run Bytes.append(&mut output, b".md")
  return move output
}
fn published(items: &[Item], index: usize) -> bool {
  let mut at = index
  while at < items.length {
    if MarkdownBlocks.same(Bytes.asSlice(&items[at].visibility), b"Private") { return false }
    if MarkdownBlocks.same(Bytes.asSlice(&items[at].kind), b"Parameter") || MarkdownBlocks.same(Bytes.asSlice(&items[at].kind), b"TypeParameter") {
      match &items[at].documentation {
        Option<Document>.None => { return false }
        Option<Document>.Some { value: _ } => {}
      }
    }
    match &items[at].parent {
      Option<usize>.None => { return true }
      Option<usize>.Some { value } => { at = value }
    }
  }
  return false
}
effect fn location(document: &Document, project: &Project, moduleIndex: usize, pages: &[Bytes], spelling: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let links = List<Link>.asSlice(&document.links)
  let mut l = usize.ZERO
  while l < links.length {
    if MarkdownBlocks.same(Bytes.asSlice(&links[l].spelling), spelling) {
      let modules = List<Module>.asSlice(&project.modules)
      let mut current = moduleIndex
      if current >= modules.length { current = usize.ZERO }
      let mut pass = usize.ZERO
      while pass < modules.length {
        let mut m = current
        if pass > usize.ZERO {
          m = pass - usize.ONE
          if m >= current { m = m + usize.ONE }
        }
        let items = List<Item>.asSlice(&modules[m].items)
        let mut n = usize.ZERO
        while n < items.length {
          if MarkdownBlocks.same(Bytes.asSlice(&items[n].id), Bytes.asSlice(&links[l].target)) && published(items, n) {
            if pages.length > usize.ZERO && (m >= pages.length || Bytes.length(&pages[m]) == usize.ZERO) {
              n = n + usize.ONE
              continue
            }
            let mut output = Bytes.make()
            if m != moduleIndex {
              run Bytes.append(&mut output, b"./")
              if m < pages.length { run Bytes.append(&mut output, Bytes.asSlice(&pages[m])) }
              else {
                let filename = run moduleFile(Bytes.asSlice(&modules[m].name))
                run Bytes.append(&mut output, Bytes.asSlice(&filename))
              }
            }
            run byte(&mut output, 35)
            let id = run anchor(items, n)
            run Bytes.append(&mut output, Bytes.asSlice(&id))
            return move output
          }
          n = n + usize.ONE
        }
        pass = pass + usize.ONE
      }
    }
    l = l + usize.ONE
  }
  return Bytes.make()
}
fn destinationEnd(text: &[u8], at: usize) -> usize {
  let mut i = at
  while i < text.length && MarkdownBlocks.space(text[i]) { i = i + usize.ONE }
  if i < text.length && text[i] == 60 {
    i = i + usize.ONE
    while i < text.length && text[i] != 62 && text[i] != 10 {
      if text[i] == 92 && i + usize.ONE < text.length { i = i + usize.ONE }
      i = i + usize.ONE
    }
    if i == text.length || text[i] != 62 { return at }
    i = i + usize.ONE
  } else {
    let mut depth = usize.ZERO
    while i < text.length {
      if text[i] == 92 && i + usize.ONE < text.length {
        i = i + 2
        continue
      }
      if text[i] == 40 { depth = depth + usize.ONE }
      if text[i] == 41 {
        if depth == usize.ZERO { break }
        depth = depth - usize.ONE
      }
      if MarkdownBlocks.space(text[i]) { break }
      i = i + usize.ONE
    }
    if depth != usize.ZERO { return at }
  }
  let beforeSpace = i
  while i < text.length && MarkdownBlocks.space(text[i]) { i = i + usize.ONE }
  if i > beforeSpace && i < text.length && (text[i] == 34 || text[i] == 39 || text[i] == 40) {
    let mut close = text[i]
    if close == 40 { close = 41 }
    i = i + usize.ONE
    while i < text.length && (text[i] != close || escaped(text, i)) { i = i + usize.ONE }
    if i == text.length { return at }
    i = i + usize.ONE
    while i < text.length && MarkdownBlocks.space(text[i]) { i = i + usize.ONE }
  }
  if i == text.length || text[i] != 41 { return at }
  return i + usize.ONE
}
fn bracketEnd(text: &[u8], at: usize) -> usize {
  let mut depth = usize.ONE
  let mut i = at + usize.ONE
  while i < text.length {
    if text[i] == 92 {
      i = i + 2
      continue
    }
    if text[i] == 96 {
      let width = count(text, i, 96)
      let end = codeEnd(text, i, width)
      if end < text.length {
        i = end + width
        continue
      }
    }
    if text[i] == 91 { depth = depth + usize.ONE }
    if text[i] == 93 {
      depth = depth - usize.ONE
      if depth == usize.ZERO { return i }
    }
    i = i + usize.ONE
  }
  return text.length
}
effect fn normalizedLabel(text: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut output = Bytes.make()
  let mut i = usize.ZERO
  let mut pending = false
  while i < text.length {
    if MarkdownBlocks.space(text[i]) { pending = Bytes.length(&output) > usize.ZERO }
    else {
      if pending { run byte(&mut output, 32) }
      pending = false
      run byte(&mut output, MarkdownBlocks.lower(text[i]))
    }
    i = i + usize.ONE
  }
  return move output
}
/// Collects normalized reference labels from the caller's already parsed document blocks.
pub effect fn definitions(blocks: &[MarkdownBlocks.Block]) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut labels = List<Bytes>.make()
  let mut i = usize.ZERO
  while i < blocks.length {
    if blocks[i].kind == MarkdownBlocks.DEFINITION {
      let text = Bytes.asSlice(&blocks[i].text)
      let close = bracketEnd(text, 0)
      if close + usize.ONE < text.length && text[close + usize.ONE] == 58 {
        run List<Bytes>.append(&mut labels, run normalizedLabel(Slice.view<u8>(text, 1, close - usize.ONE)))
      }
    }
    i = i + usize.ONE
  }
  return move labels
}
fn labelMatches(normalized: &[u8], authored: &[u8]) -> bool {
  let mut at = usize.ZERO
  let mut matched = usize.ZERO
  let mut pending = false
  while at < authored.length {
    if MarkdownBlocks.space(authored[at]) { pending = matched > usize.ZERO }
    else {
      if pending {
        if matched >= normalized.length || normalized[matched] != 32 { return false }
        matched = matched + usize.ONE
      }
      pending = false
      if matched >= normalized.length || normalized[matched] != MarkdownBlocks.lower(authored[at]) { return false }
      matched = matched + usize.ONE
    }
    at = at + usize.ONE
  }
  return matched == normalized.length
}
fn referenceDefined(definitions: &[Bytes], label: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < definitions.length {
    if labelMatches(Bytes.asSlice(&definitions[at]), label) { return true }
    at = at + usize.ONE
  }
  return false
}
fn rawTagEnd(text: &[u8], at: usize) -> usize {
  if at + usize.ONE == text.length { return at }
  let next = text[at + usize.ONE]
  if !(next >= 65 && next <= 90) && !(next >= 97 && next <= 122) && next != 47 && next != 33 && next != 63 { return at }
  let mut quote: u8 = 0
  let mut i = at + usize.ONE
  while i < text.length {
    if quote != 0 {
      if text[i] == quote { quote = 0 }
    } else if text[i] == 34 || text[i] == 39 { quote = text[i] }
    else if text[i] == 62 { return i + usize.ONE }
    i = i + usize.ONE
  }
  return at
}
/// Rewrites semantic links only, preserving all other authored Markdown byte-for-byte.
pub effect fn reference(text: &[u8], definitions: &[Bytes], document: &Document, project: &Project, moduleIndex: usize, pages: &[Bytes], output: &mut Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  let found = run symbols(text, definitions)
  let links = List<Symbol>.asSlice(&found)
  let mut cursor = usize.ZERO
  let mut at = usize.ZERO
  while at < links.length {
    let link = &links[at]
    run Bytes.append(&mut output.*, Slice.view<u8>(text, cursor, link.start - cursor))
    let target = run location(document, project, moduleIndex, pages, Bytes.asSlice(&link.spelling))
    let linked = Bytes.length(&target) > usize.ZERO
    if linked { run byte(&mut output.*, 91) }
    run Bytes.append(&mut output.*, Slice.view<u8>(text, link.start + usize.ONE, link.end - link.start - 2))
    if linked {
      run Bytes.append(&mut output.*, b"](")
      run Bytes.append(&mut output.*, Bytes.asSlice(&target))
      run byte(&mut output.*, 41)
    }
    cursor = link.end
    at = at + usize.ONE
  }
  run Bytes.append(&mut output.*, Slice.view<u8>(text, cursor, text.length - cursor))
}
/// Finds semantic code links, excluding escaped punctuation, code spans and explicit links.
pub effect fn symbols(text: &[u8], definitions: &[Bytes]) -> List<Symbol> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<Symbol>.make()
  let mut i = usize.ZERO
  while i < text.length {
    if text[i] == 92 {
      i = i + 2
      continue
    }
    if text[i] == 96 {
      let width = count(text, i, 96)
      let end = codeEnd(text, i, width)
      if end < text.length {
        i = end + width
        continue
      }
    }
    if text[i] == 60 {
      let end = rawTagEnd(text, i)
      if end > i {
        i = end
        continue
      }
    }
    if text[i] == 91 {
      let close = bracketEnd(text, i)
      if close < text.length {
        if close + usize.ONE < text.length && text[close + usize.ONE] == 40 {
          let end = destinationEnd(text, close + 2)
          if end > close + 2 {
            i = end
            continue
          }
        }
        let label = Slice.view<u8>(text, i + usize.ONE, close - i - usize.ONE)
        if close + usize.ONE < text.length && text[close + usize.ONE] == 91 {
          let end = bracketEnd(text, close + usize.ONE)
          if end < text.length {
            let mut key = label
            if end > close + 2 { key = Slice.view<u8>(text, close + 2, end - close - 2) }
            if referenceDefined(definitions, key) {
              i = end + usize.ONE
              continue
            }
          }
        }
        if referenceDefined(definitions, label) {
          i = close + usize.ONE
          continue
        }
        if label.length >= 2 && label[0] == 96 {
          let width = count(label, 0, 96)
          let end = codeEnd(label, 0, width)
          if end + width == label.length {
            run List<Symbol>.append(&mut result, Symbol { spelling: run codeValue(Slice.view<u8>(label, width, end - width)), start: i, end: close + usize.ONE })
            i = close + usize.ONE
            continue
          }
        }
      }
    }
    i = i + usize.ONE
  }
  return move result
}
