//! Shared byte-preserving JSON text encoding used by production and diagnostic reports.

import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.vector {Vector}
import silk.usize
import silk.u64
import silk.u8

pub effect fn appendDecimal(output: &mut Bytes, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut reversed = Vector.make<u8>()
  let mut remaining = usize.toU64(value)
  if remaining == 0 {
    return run Bytes.append(&mut output.*, b"0")
  }
  while remaining > 0 {
    run Vector.append<u8>(&mut reversed, u64.toU8(48 + u64.remainder(remaining, 10)))
    remaining = u64.divide(remaining, 10)
  }
  let digits = Vector.asSlice<u8>(&reversed)
  let mut at = digits.length
  while at > usize.ZERO {
    at = at - usize.ONE
    run Bytes.append(&mut output.*, &[digits[at]])
  }
  return ()
}

// Module paths are authored UTF-8 bytes. Preserve their text while escaping JSON syntax and
// control bytes so even unusual valid filenames retain machine-readable gap locations.
pub effect fn appendString(output: &mut Bytes, text: &[u8]) -> ()
! OutOfMemoryError ? &mut Allocator {
  let digits = b"0123456789abcdef"
  run Bytes.append(&mut output.*, b"\"")
  let mut at = usize.ZERO
  while at < text.length {
    let byte = text[at]
    if byte == 34 || byte == 92 {
      let escaped: [u8; 2] = [92, byte]
      run Bytes.append(&mut output.*, &escaped)
    } else if byte < 32 {
      let value = u8.toU64(byte)
      let high = u64.toUsize(u64.divide(value, 16))
      let low = u64.toUsize(u64.remainder(value, 16))
      let escaped: [u8; 6] = [92, 117, 48, 48, digits[high], digits[low]]
      run Bytes.append(&mut output.*, &escaped)
    } else {
      run Bytes.append(&mut output.*, &[byte])
    }
    at = at + usize.ONE
  }
  return run Bytes.append(&mut output.*, b"\"")
}

