//! Renders a catalog diagnostic exactly as the bootstrap CLI prints it.
//!
//! # When to use
//! Use [`render`] for the human line of one rejection and [`fields`] for a machine-readable record
//! of the same diagnostic. Both are pure over the rejection and its module's source bytes.
//!
//! # Details
//! The line is `path:line:column: error[CODE] message`, followed by one `  note: ...` line per
//! note. The line is one more than the number of line feeds before the primary span's start; the
//! column is the 1-based UTF-8 byte column. Related spans are not printed, as in the bootstrap.
//!
//! A message is the code's catalog template with every hole filled. Native rejections do not yet
//! carry every value a template names; when a hole cannot be filled, or the code chooses among
//! several templates, the message is the code's catalog meaning instead, so no line is left blank.

import diagnostic.Catalog as Catalog { Code }
import diagnostic.JsonText { appendDecimal }
import lexer.Span { Span }
import semantic.DeclarationId { DeclarationId }
import semantic.ModuleId { ModuleId }
import semantic.StaticExecution { Diagnostic as StaticDiagnostic }
import semantic.Rejection as Rejections { MessageArgument, RelatedSite, Rejection, RejectionCode }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.option { Option }
import silk.shared { Shared }
import silk.string { String }
import silk.u8
import silk.usize
import silk.list { List }

/// A 1-based line and byte column in a source text.
pub struct Position {
  pub line: usize,
  pub column: usize,
}

/// One located site related to a diagnostic.
pub struct RelatedLocation {
  pub path: Bytes,
  pub line: usize,
  pub column: usize,
  pub start: usize,
  pub end: usize,
  pub label: Option<Bytes>,
}

/// The located parts of one catalog diagnostic.
pub struct RenderedDiagnostic {
  pub code: Bytes,
  pub severity: Bytes,
  pub path: Bytes,
  pub line: usize,
  pub column: usize,
  pub start: usize,
  pub end: usize,

  /// The filled catalog message, or the code's catalog meaning when a hole cannot be filled.
  pub message: Option<Bytes>,
  pub notes: List<Bytes>,
  pub related: List<RelatedLocation>,
}

/// The position of byte `offset` in `source`, clamped to the source's length.
pub fn position(source: &[u8], offset: usize) -> Position {
  let mut bounded = offset
  if bounded > source.length {
    bounded = source.length
  }
  let mut line = usize.ONE
  let mut lineStart = usize.ZERO
  let mut at = usize.ZERO
  while at < bounded {
    if source[at] == 10 {
      line = line + usize.ONE
      lineStart = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return Position { line: line, column: bounded - lineStart + usize.ONE }
}

// The hole a code fills with the source text of its primary span, if any. A code joins this list
// only once its native span is shown to cover exactly the text the bootstrap interpolates.
fn spanArgument(code: Code) -> Option<string<'static>> {
  return match code {
    Code.UnknownType => Option<string<'static>>.some("spelling")
    Code.DuplicateDeclarationName => Option<string<'static>>.some("spelling")
    Code.DuplicateFieldName => Option<string<'static>>.some("spelling")
    Code.UnknownFunction => Option<string<'static>>.some("spelling")
    Code.DuplicateParameterName => Option<string<'static>>.some("spelling")
    Code.UnknownValueReference => Option<string<'static>>.some("spelling")
    Code.UnknownActor => Option<string<'static>>.some("spelling")
    Code.ExpectedType => Option<string<'static>>.some("spelling")
    Code.DuplicateTypeParameter => Option<string<'static>>.some("spelling")
    Code.DuplicateEnumMemberName => Option<string<'static>>.some("spelling")
    Code.UnsupportedEnumRepresentation => Option<string<'static>>.some("spelling")
    Code.DuplicateUnionVariant => Option<string<'static>>.some("spelling")
    Code.UnknownLifetime => Option<string<'static>>.some("spelling")
    Code.GenericParameterKindMismatch => Option<string<'static>>.some("spelling")
    Code.ReferenceMatchSubject => Option<string<'static>>.some("spelling")
    Code.RebindingName => Option<string<'static>>.some("spelling")
    Code.PatternBindingConflict => Option<string<'static>>.some("spelling")
    Code.TransferOutsideLoop => Option<string<'static>>.some("transfer")
    _ => Option<string<'static>>.none()
  }
}

// The hole a code fills with the binding that roots its primary span's place, such as `b` in
// `move b.v` or `a` in `a[0]`. A code joins this list only once the bootstrap is shown to
// interpolate that root binding at every span shape native reports for it.
fn rootArgument(code: Code) -> Option<string<'static>> {
  return match code {
    Code.ExplicitMoveRequired => Option<string<'static>>.some("spelling")
    Code.UseAfterMove => Option<string<'static>>.some("spelling")
    Code.MatchBorrowEscape => Option<string<'static>>.some("spelling")
    Code.GuardConsumesPattern => Option<string<'static>>.some("spelling")
    Code.ImmutableAssignment => Option<string<'static>>.some("spelling")
    Code.ExclusiveBorrowRequiresMutable => Option<string<'static>>.some("spelling")
    Code.InvalidReborrow => Option<string<'static>>.some("spelling")
    Code.ConflictingViewLoan => Option<string<'static>>.some("spelling")
    Code.OwnerAccessDuringLoan => Option<string<'static>>.some("spelling")
    Code.ExpiredLifetime => Option<string<'static>>.some("spelling")
    Code.InvalidCallableInvocationAccess => Option<string<'static>>.some("spelling")
    Code.ExecutableBorrowEscape => Option<string<'static>>.some("spelling")
    _ => Option<string<'static>>.none()
  }
}

// Appends the value of the hole spelled `template[start..end]` to `output`: a named argument the
// producer supplied, or else the span text of a code listed by [`spanArgument`] or the root binding
// of a code listed by [`rootArgument`]. False when the rejection carries none of them.
effect fn appendArgument(
  output: &mut Bytes,
  code: Code,
  template: &[u8],
  start: usize,
  end: usize,
  rejection: &Shared<Rejection>,
  source: &[u8],
  span: Span
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  // The shared rejection is read through pure accessors; the bytes are appended outside them.
  let supplied = Shared<Rejection>.with<usize>(rejection, fn(value: &Rejection) -> usize {
    let listed = List<MessageArgument>.asSlice(&value.arguments)
    let mut at = usize.ZERO
    while at < listed.length {
      if spells(template, start, end, Bytes.asSlice(&listed[at].name)) { return at }
      at = at + usize.ONE
    }
    return usize.MAX
  })
  if supplied != usize.MAX {
    let length = Shared<Rejection>.with<usize>(rejection, fn(value: &Rejection) -> usize {
      let listed = List<MessageArgument>.asSlice(&value.arguments)
      return Bytes.length(&listed[supplied].value)
    })
    let mut copied = usize.ZERO
    while copied < length {
      let byte = Shared<Rejection>.with<u8>(rejection, fn(value: &Rejection) -> u8 {
        let listed = List<MessageArgument>.asSlice(&value.arguments)
        return Bytes.asSlice(&listed[supplied].value)[copied]
      })
      run Bytes.append(&mut output.*, &[byte])
      copied = copied + usize.ONE
    }
    return true
  }
  if let Option<string<'static>>.Some { value: spanned } = move spanArgument(code) {
    if spells(template, start, end, String.utf8Bytes(spanned)) && span.end <= source.length && oneName(source, span) {
      let mut at = span.start
      while at < span.end {
        run Bytes.append(&mut output.*, &[source[at]])
        at = at + usize.ONE
      }
      return true
    }
  }
  // A wrong type-argument count names the generic written before the list and both counts. A
  // rejection that recorded no counts keeps the catalog meaning.
  if code == Code.TypeArgumentArity {
    let expected = Shared<Rejection>.with<usize>(rejection, fn(value: &Rejection) -> usize { return value.expected })
    let actual = Shared<Rejection>.with<usize>(rejection, fn(value: &Rejection) -> usize { return value.supplied })
    if expected == actual { return false }
    if spells(template, start, end, b"expected") {
      run appendDecimal(&mut output.*, expected)
      return true
    }
    if spells(template, start, end, b"actual") {
      run appendDecimal(&mut output.*, actual)
      return true
    }
    if spells(template, start, end, b"expectedWord") {
      if expected != usize.ONE { run Bytes.append(&mut output.*, b"s") }
      return true
    }
    if spells(template, start, end, b"actualVerb") {
      if actual == usize.ONE { run Bytes.append(&mut output.*, b"was") } else { run Bytes.append(&mut output.*, b"were") }
      return true
    }
    if spells(template, start, end, b"target") {
      let named = arityTarget(source, span)
      if named.start == named.end { return false }
      let mut at = named.start
      while at < named.end {
        run Bytes.append(&mut output.*, &[source[at]])
        at = at + usize.ONE
      }
      return true
    }
  }
  // Braces on a unit variant name the variant as written before them, `Event.Close` in `Event.Close {}`.
  if code == Code.UnitVariantPayloadPattern && spells(template, start, end, b"variant") && span.end <= source.length {
    let mut stop = span.start
    while stop < span.end && source[stop] != 123 { stop = stop + usize.ONE }
    while stop > span.start && (source[stop - usize.ONE] == 32 || source[stop - usize.ONE] == 9) { stop = stop - usize.ONE }
    if stop == span.start || stop == span.end { return false }
    let mut at = span.start
    while at < stop {
      if source[at] == 10 || source[at] == 13 { return false }
      run Bytes.append(&mut output.*, &[source[at]])
      at = at + usize.ONE
    }
    return true
  }
  if code == Code.MissingUnsafeBoundary && spells(template, start, end, b"operation") {
    let operation = run unsafeOperation(source, span)
    if Bytes.length(&operation) == usize.ZERO { return false }
    run Bytes.append(&mut output.*, Bytes.asSlice(&operation))
    return true
  }
  // An undecodable literal says which escape breaks which rule.
  if code == Code.InvalidStaticLiteral && spells(template, start, end, b"detail") {
    let detail = run literalDetail(source, span)
    if Bytes.length(&detail) == usize.ZERO { return false }
    run Bytes.append(&mut output.*, Bytes.asSlice(&detail))
    return true
  }
  // A C static assigned from Silk is named as written.
  if code == Code.InvalidAssignmentPlace && spells(template, start, end, b"spelling") {
    return run appendSpanned(&mut output.*, b"expression", usize.ZERO, 10, source, span)
  }
  if code == Code.NonAliasResolutionCycle && spells(template, start, end, b"members") {
    let members = run cycleMembers(rejection)
    if Bytes.length(&members) == usize.ZERO { return false }
    run Bytes.append(&mut output.*, Bytes.asSlice(&members))
    return true
  }
  // An Effect run inside a held local-shared access names the run as written, without `run`.
  if code == Code.LocalSharedAccessEscape && spells(template, start, end, b"effect") {
    let mut from = span.start
    if span.end <= source.length && span.end >= from + 4 && spells(source, from, from + 4, b"run ") { from = from + 4 }
    return run appendSpanned(&mut output.*, b"expression", usize.ZERO, 10, source, Span.make(from, span.end))
  }
  // A static evaluation fault names the expression it stopped in, and a call of an ordinary fn
  // names the callee as written before its arguments, `plain` in `plain()`.
  if code == Code.StaticPhaseViolation {
    // An arithmetic fault is located at its operator and keeps the whole expression as its origin,
    // unless the report moved it to a call in this module.
    let mut named = span
    if spells(template, start, end, b"expression") {
      named = Shared<Rejection>.with<Span>(rejection, fn(value: &Rejection) -> Span {
        if let Option<StaticDiagnostic>.Some {value: failure} = &value.staticFailure {
          if failure.span.start == value.span.start && failure.span.end == value.span.end {
            if let Option<Span>.Some {value: origin} = &failure.origin { return origin }
          }
        }
        return value.span
      })
    }
    return run appendSpanned(&mut output.*, template, start, end, source, named)
  }
  // A use after a move through a method call names the moved receiver, `counter` in `counter.peek()`.
  if code == Code.UseAfterMove && spells(template, start, end, b"spelling") && span.end <= source.length {
    let receiver = methodReceiver(source, span)
    if receiver.end > receiver.start {
      run appendRoot(&mut output.*, source, receiver, false, false)
      return true
    }
  }
  // Unexpected tokens fill their hole with the quoted tokens when they are short and on one line.
  if spells(template, start, end, b"encountered") && span.end <= source.length && span.start < span.end && span.end - span.start <= 32 {
    let mut quoted = Bytes.make()
    run Bytes.append(&mut quoted, b"`")
    let mut at = span.start
    while at < span.end {
      if source[at] == 10 || source[at] == 13 { return false }
      run Bytes.append(&mut quoted, &[source[at]])
      at = at + usize.ONE
    }
    run Bytes.append(&mut quoted, b"`")
    run Bytes.append(&mut output.*, Bytes.asSlice(&quoted))
    return true
  }
  // `c.drop()` names its receiver, `c`, in the `drop c` it suggests.
  if code == Code.UnknownActorOperation && spells(template, start, end, b"receiver") && span.end <= source.length {
    let receiver = methodReceiver(source, span)
    if receiver.end == receiver.start { return false }
    run appendRoot(&mut output.*, source, receiver, true, false)
    return true
  }
  // A loop whose iterations disagree on what is moved names the binding its related move moves,
  // `outer` in `move outer`.
  if code == Code.IncompatibleLoopHeader && spells(template, start, end, b"spelling") {
    let site = Shared<Rejection>.with<Option<Span>>(rejection, fn(value: &Rejection) -> Option<Span> {
      return match &value.related {
        Option<RelatedSite>.Some {value: related} => {
          if ModuleId.equals(&related.module, &value.module) { return Option<Span>.some(related.span) }
          return Option<Span>.none()
        }
        Option<RelatedSite>.None => Option<Span>.none()
      }
    })
    if let Option<Span>.Some {value: moved} = move site {
      if moved.end <= source.length {
        let rootStart = placeStart(source, moved)
        let rootEnd = nameEnd(source, rootStart, moved.end)
        if rootEnd > rootStart && placeText(source, rootEnd, moved.end) {
          run appendRoot(&mut output.*, source, Span.make(rootStart, moved.end), true, true)
          return true
        }
      }
    }
    return false
  }
  // An expired borrow names the binding its related borrow is of, `x` in `&x`, or a temporary.
  if code == Code.ExpiredLifetime && spells(template, start, end, b"referent") {
    let site = Shared<Rejection>.with<Option<Span>>(rejection, fn(value: &Rejection) -> Option<Span> {
      return match &value.related {
        Option<RelatedSite>.Some {value: related} => {
          if ModuleId.equals(&related.module, &value.module) { return Option<Span>.some(related.span) }
          return Option<Span>.none()
        }
        Option<RelatedSite>.None => Option<Span>.none()
      }
    })
    if let Option<Span>.Some {value: borrowed} = move site {
      if borrowed.end <= source.length {
        // A method call borrows its receiver, `board` in `board.longest()`.
        let receiver = methodReceiver(source, borrowed)
        if receiver.end > receiver.start {
          run appendRoot(&mut output.*, source, receiver, false, true)
          return true
        }
        let rootStart = placeStart(source, borrowed)
        let rootEnd = nameEnd(source, rootStart, borrowed.end)
        if rootEnd > rootStart && placeText(source, rootEnd, borrowed.end) {
          run Bytes.append(&mut output.*, b"`")
          let mut at = rootStart
          while at < rootEnd {
            run Bytes.append(&mut output.*, &[source[at]])
            at = at + usize.ONE
          }
          run Bytes.append(&mut output.*, b"`")
          return true
        }
        // A borrow of a literal or another expression borrows a temporary.
        if rootStart > borrowed.start {
          run Bytes.append(&mut output.*, b"a temporary value")
          return true
        }
        return false
      }
    }
  }
  // A struct literal names its type as written, the text before its `{`, such as `P` in `P { x: 0 }`.
  if code == Code.MissingStructInitializer && spells(template, start, end, b"literal") && span.end <= source.length {
    let mut brace = span.start
    while brace < span.end && source[brace] != 123 && source[brace] != 10 { brace = brace + usize.ONE }
    let mut stop = brace
    while stop > span.start && blank(source[stop - usize.ONE]) { stop = stop - usize.ONE }
    if brace < span.end && source[brace] == 123 && stop > span.start {
      let mut at = span.start
      while at < stop {
        run Bytes.append(&mut output.*, &[source[at]])
        at = at + usize.ONE
      }
      return true
    }
  }
  // An assignment that consumes its own destination names the destination place, the text before
  // its `=`, such as `request` in `request = request.timeoutSeconds(5)`.
  if code == Code.OverlappingAssignment && spells(template, start, end, b"spelling") && span.end <= source.length {
    let targetEnd = assignmentTargetEnd(source, span)
    if targetEnd > span.start {
      let mut at = span.start
      while at < targetEnd {
        run Bytes.append(&mut output.*, &[source[at]])
        at = at + usize.ONE
      }
      return true
    }
  }
  if let Option<string<'static>>.Some { value: rooted } = move rootArgument(code) {
    if spells(template, start, end, String.utf8Bytes(rooted)) && span.end <= source.length {
      // A method call that borrows its receiver names the receiver, not the method.
      if receiverBorrowed(code) {
        let receiver = methodReceiver(source, span)
        if receiver.end > receiver.start {
          run appendRoot(&mut output.*, source, receiver, wholePlace(code), false)
          return true
        }
      }
      let rootStart = placeStart(source, span)
      let mut rootEnd = nameEnd(source, rootStart, span.end)
      if rootEnd > rootStart && (rootEnd == span.end || source[rootEnd] == 46 || source[rootEnd] == 91) && placeText(source, rootEnd, span.end) {
        // A move names the whole place moved, such as `r.*`; other codes name its root binding.
        if wholePlace(code) { rootEnd = span.end }
        let mut at = rootStart
        while at < rootEnd {
          run Bytes.append(&mut output.*, &[source[at]])
          at = at + usize.ONE
        }
        return true
      }
    }
  }
  return false
}

// Whether `code` reports a method call at the call when the receiver it borrows is the subject.
fn receiverBorrowed(code: Code) -> bool {
  return match code {
    Code.ExclusiveBorrowRequiresMutable => true
    Code.InvalidReborrow => true
    Code.ConflictingViewLoan => true
    Code.OwnerAccessDuringLoan => true
    _ => false
  }
}

// The receiver place of a method call span, `board` in `board.add(1)` or before the `add` of it;
// an empty span when `span` is no method call on a place. A capitalized receiver is a type.
fn methodReceiver(source: &[u8], span: Span) -> Span {
  let none = Span.make(span.start, span.start)
  let nameStart = placeStart(source, span)
  let nameStop = nameEnd(source, nameStart, span.end)
  if nameStop == nameStart { return none }
  // The method name alone, right after its receiver's `.`.
  if nameStart > usize.ZERO && source[nameStart - usize.ONE] == 46 {
    if nameStop >= source.length || source[nameStop] != 40 { return none }
    let dot = nameStart - usize.ONE
    let mut first = dot
    while first > usize.ZERO && placeByte(source[first - usize.ONE]) { first = first - usize.ONE }
    return receiverPlace(source, first, dot)
  }
  // A whole call: the place text runs up to its `(`, and its last `.` comes before the method.
  let mut open = nameStop
  while open < span.end && placeByte(source[open]) { open = open + usize.ONE }
  if open >= span.end || source[open] != 40 { return none }
  let mut dot = open
  while dot > nameStop && source[dot - usize.ONE] != 46 { dot = dot - usize.ONE }
  if dot == nameStop { return none }
  return receiverPlace(source, nameStart, dot - usize.ONE)
}

// `source[first..last]` when it is a place rooted at a lowercase binding; an empty span otherwise.
fn receiverPlace(source: &[u8], first: usize, last: usize) -> Span {
  let stop = nameEnd(source, first, last)
  if stop == first || (source[first] >= 65 && source[first] <= 90) || !placeText(source, stop, last) {
    return Span.make(first, first)
  }
  return Span.make(first, last)
}

// Appends the root binding of the place `source[place]`, or the whole place when `whole`, in
// backticks when `quoted`.
effect fn appendRoot(output: &mut Bytes, source: &[u8], place: Span, whole: bool, quoted: bool)
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut stop = place.end
  if !whole { stop = nameEnd(source, place.start, place.end) }
  if quoted { run Bytes.append(&mut output.*, b"`") }
  let mut at = place.start
  while at < stop {
    run Bytes.append(&mut output.*, &[source[at]])
    at = at + usize.ONE
  }
  if quoted { run Bytes.append(&mut output.*, b"`") }
}

// Whether `byte` can continue a place: a name, a field or dereference `.`, `*`, or an index bracket.
fn placeByte(byte: u8) -> bool {
  let letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
  let digit = byte >= 48 && byte <= 57
  return letter || digit || byte == 46 || byte == 42 || byte == 91 || byte == 93
}

// Where the place in `source[span]` starts: after a leading `move` or `drop` keyword, or the `&` or
// `&mut` of a borrow, and its whitespace.
fn placeStart(source: &[u8], span: Span) -> usize {
  if span.start < span.end && source[span.start] == 38 {
    let mut at = span.start + usize.ONE
    while at < span.end && blank(source[at]) { at = at + usize.ONE }
    let word = nameEnd(source, at, span.end)
    if spells(source, at, word, b"mut") && word < span.end && blank(source[word]) {
      at = word
      while at < span.end && blank(source[at]) { at = at + usize.ONE }
    }
    return at
  }
  let keyword = nameEnd(source, span.start, span.end)
  if (spells(source, span.start, keyword, b"move") || spells(source, span.start, keyword, b"drop")) && keyword < span.end
    && blank(source[keyword]) {
    let mut at = keyword
    while at < span.end && blank(source[at]) { at = at + usize.ONE }
    return at
  }
  return span.start
}

// Whether `source[start..end]` continues a place past its root binding: only field, dereference
// and literal index projections, so a call or operator span is never mistaken for a place.
fn placeText(source: &[u8], start: usize, end: usize) -> bool {
  let mut at = start
  while at < end {
    let byte = source[at]
    let letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
    let digit = byte >= 48 && byte <= 57
    if !letter && !digit && byte != 46 && byte != 42 && byte != 91 && byte != 93 { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether `code` names the whole moved place rather than its root binding.
fn wholePlace(code: Code) -> bool {
  return match code {
    Code.ExplicitMoveRequired => true
    Code.UseAfterMove => true
    Code.ConflictingViewLoan => true
    Code.OwnerAccessDuringLoan => true
    _ => false
  }
}

// The end of the place an assignment span starts with, when only blanks and a single `=` follow it;
// `span.start` otherwise.
fn assignmentTargetEnd(source: &[u8], span: Span) -> usize {
  let rootEnd = nameEnd(source, span.start, span.end)
  if rootEnd == span.start { return span.start }
  let mut end = rootEnd
  while end < span.end && !blank(source[end]) && source[end] != 61 { end = end + usize.ONE }
  if !placeText(source, rootEnd, end) { return span.start }
  let mut at = end
  while at < span.end && blank(source[at]) { at = at + usize.ONE }
  if at >= span.end || source[at] != 61 { return span.start }
  if at + usize.ONE < span.end && source[at + usize.ONE] == 61 { return span.start }
  return end
}

fn blank(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 10 || byte == 13
}

// The end of the identifier starting at `start`, bounded by `limit`; `start` when none starts there.
fn nameEnd(source: &[u8], start: usize, limit: usize) -> usize {
  let mut at = start
  while at < limit {
    let byte = source[at]
    let letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
    let digit = byte >= 48 && byte <= 57
    if !letter && !(digit && at > start) { return at }
    at = at + usize.ONE
  }
  return at
}

// Whether `source[span]` is one identifier or lifetime spelling, the only text a span argument
// may contribute; any wider span leaves the message unfilled.
// The name a type-argument list applies: the last name before the first `<` or `(` in `span`, as
// `pick` in `Pick.pick<i32, i32>(...)`, or the whole span when it is one name. Empty when there is
// none on the span's line.
fn arityTarget(source: &[u8], span: Span) -> Span {
  if span.start >= span.end || span.end > source.length { return Span.make(usize.ZERO, usize.ZERO) }
  let mut stop = span.start
  while stop < span.end && source[stop] != 60 && source[stop] != 40 {
    if source[stop] == 10 || source[stop] == 13 { return Span.make(usize.ZERO, usize.ZERO) }
    stop = stop + usize.ONE
  }
  while stop > span.start && (source[stop - usize.ONE] == 32 || source[stop - usize.ONE] == 9) { stop = stop - usize.ONE }
  let mut first = stop
  while first > span.start && nameByte(source[first - usize.ONE]) { first = first - usize.ONE }
  if first < stop && source[first] >= 48 && source[first] <= 57 { return Span.make(usize.ZERO, usize.ZERO) }
  return Span.make(first, stop)
}

fn nameByte(byte: u8) -> bool {
  return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 || (byte >= 48 && byte <= 57)
}

fn oneName(source: &[u8], span: Span) -> bool {
  if span.start >= span.end { return false }
  let mut at = span.start
  if source[at] == 39 { at = at + usize.ONE }
  if at >= span.end { return false }
  while at < span.end {
    let byte = source[at]
    let letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
    let digit = byte >= 48 && byte <= 57
    if !letter && !(digit && at > span.start) { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether `text[start..end]` spells `name`.
fn spells(text: &[u8], start: usize, end: usize, name: &[u8]) -> bool {
  if end - start != name.length {
    return false
  }
  let mut at = usize.ZERO
  while at < name.length {
    if text[start + at] != name[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// The filled message of `code` for `rejection` at `span`, or the code's catalog meaning when the
/// code chooses among several templates or a hole has no value.
pub effect fn message(code: Code, rejection: &Shared<Rejection>, source: &[u8], span: Span) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  if let Option<Bytes>.Some { value } = move run filled(code, rejection, source, span) {
    return Option<Bytes>.some(move value)
  }
  return Option<Bytes>.some(run meaningMessage(code))
}

/// The catalog meaning of `code` as a message: its leading "Stable code for" wording dropped, its
/// first letter capitalized and its final period removed.
pub effect fn meaningMessage(code: Code) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let meaning = String.utf8Bytes(Catalog.meaning(code))
  let mut start = usize.ZERO
  if startsWith(meaning, b"Stable diagnostic code for ") {
    start = 27
  } else if startsWith(meaning, b"Stable code for ") {
    start = 16
  }
  let mut end = meaning.length
  if end > start && meaning[end - usize.ONE] == 46 { end = end - usize.ONE }
  let mut output = Bytes.make()
  let mut at = start
  while at < end {
    let mut byte = meaning[at]
    if at == start && byte >= 97 && byte <= 122 { byte = byte - 32 }
    run Bytes.append(&mut output, &[byte])
    at = at + usize.ONE
  }
  return move output
}

// The text at `span` for a SEM0176 hole: the callee as written before its arguments for
// `function`, the whole span for `expression`; false for another hole, or for text longer than
// 80 bytes or one line.
effect fn appendSpanned(output: &mut Bytes, template: &[u8], start: usize, end: usize, source: &[u8], span: Span) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if span.end > source.length || span.end <= span.start || span.end - span.start > 80 { return false }
  let mut stop = span.end
  if spells(template, start, end, b"function") {
    stop = span.start
    while stop < span.end && source[stop] != 40 && source[stop] != 60 { stop = stop + usize.ONE }
    if stop == span.start || stop == span.end { return false }
  } else if !spells(template, start, end, b"expression") {
    return false
  }
  let mut at = span.start
  while at < stop {
    if source[at] == 10 || source[at] == 13 { return false }
    run Bytes.append(&mut output.*, &[source[at]])
    at = at + usize.ONE
  }
  return true
}

// The unsafe operation at `span` as a fix can quote it: a call as its callee and `(...)`, as
// `qsort(...)`, or other short text as written; empty when it spans lines or is long.
// Why the literal at `span` does not decode, from its first escape that breaks a rule: an unknown
// escape, a malformed `\x` or `\u{...}`, a surrogate, a value above U+10FFFF, or a byte string
// value above 0xFF. A text literal whose escapes are all well formed spells bytes that are not
// UTF-8. Empty when the text says nothing more, as for a raw literal.
effect fn literalDetail(source: &[u8], span: Span) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut detail = Bytes.make()
  if span.end > source.length || span.start >= span.end { return move detail }
  if source[span.start] == 114 { return move detail }
  let bytes = source[span.start] == 98
  let mut at = span.start
  while at < span.end {
    if source[at] != 92 {
      at = at + usize.ONE
      continue
    }
    let escapeStart = at
    let mut kind: u8 = 0
    if at + usize.ONE < span.end { kind = source[at + usize.ONE] }
    if kind == 110 || kind == 114 || kind == 116 || kind == 48 || kind == 34 || kind == 92 || kind == 39 {
      at = at + 2
      continue
    }
    if kind == 120 {
      if at + 3 < span.end && hexValue(source[at + 2]) < 16 && hexValue(source[at + 3]) < 16 {
        at = at + 4
        continue
      }
      run Bytes.append(&mut detail, b"`\\x` needs two hex digits, as in `\\x41`")
      return move detail
    }
    if kind != 117 {
      run Bytes.append(&mut detail, b"`")
      run appendEscapeText(&mut detail, source, escapeStart, escapeStart + 2, span.end)
      run Bytes.append(&mut detail, b"` is not an escape; the escapes are `\\n`, `\\r`, `\\t`, `\\0`, `\\\\`, `\\\"`, `\\'`, `\\xNN`, and `\\u{...}`")
      return move detail
    }
    // `\u{...}`: one to six hex digits in braces.
    let mut cursor = at + 2
    let mut value: u64 = 0
    let mut digits = usize.ZERO
    let mut wellFormed = cursor < span.end && source[cursor] == 123
    if wellFormed {
      cursor = cursor + usize.ONE
      while cursor < span.end && source[cursor] != 125 && hexValue(source[cursor]) < 16 && digits < 6 {
        value = value * 16 + u8.toU64(hexValue(source[cursor]))
        digits = digits + usize.ONE
        cursor = cursor + usize.ONE
      }
      wellFormed = digits > usize.ZERO && cursor < span.end && source[cursor] == 125
    }
    if !wellFormed {
      run Bytes.append(&mut detail, b"`\\u` needs one to six hex digits in braces, as in `\\u{1F600}`")
      return move detail
    }
    let escapeEnd = cursor + usize.ONE
    if value >= 55296 && value <= 57343 {
      run Bytes.append(&mut detail, b"`")
      run appendEscapeText(&mut detail, source, escapeStart, escapeEnd, span.end)
      run Bytes.append(&mut detail, b"` is a UTF-16 surrogate, which is not a Unicode scalar value")
      return move detail
    }
    if value > 1114111 {
      run Bytes.append(&mut detail, b"`")
      run appendEscapeText(&mut detail, source, escapeStart, escapeEnd, span.end)
      run Bytes.append(&mut detail, b"` is above `\\u{10FFFF}`, the largest Unicode scalar value")
      return move detail
    }
    if bytes && value > 255 {
      run Bytes.append(&mut detail, b"`")
      run appendEscapeText(&mut detail, source, escapeStart, escapeEnd, span.end)
      run Bytes.append(&mut detail, b"` is not a byte; a byte string holds values up to `\\u{FF}`, also written `\\xFF`")
      return move detail
    }
    at = escapeEnd
  }
  if !bytes && source[span.start] != 39 {
    run Bytes.append(&mut detail, b"its escapes spell bytes that are not valid UTF-8; write a character as `\\u{...}`, or use a byte string `b\"...\"`")
  }
  return move detail
}

// Appends `source[from..to]`, cut at `limit`, as one escape's text.
effect fn appendEscapeText(output: &mut Bytes, source: &[u8], from: usize, to: usize, limit: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = from
  while at < to && at < limit {
    run Bytes.append(&mut output.*, &[source[at]])
    at = at + usize.ONE
  }
  return ()
}

// The value of the hex digit `byte`, or 255.
fn hexValue(byte: u8) -> u8 {
  if byte >= 48 && byte <= 57 { return byte - 48 }
  if byte >= 97 && byte <= 102 { return byte - 87 }
  if byte >= 65 && byte <= 70 { return byte - 55 }
  return 255
}

effect fn unsafeOperation(source: &[u8], span: Span) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  if span.end > source.length || span.end <= span.start { return move text }
  let mut stop = span.start
  while stop < span.end && source[stop] != 40 { stop = stop + usize.ONE }
  let call = stop < span.end
  if stop - span.start > 60 { return move text }
  let mut at = span.start
  while at < stop {
    if source[at] == 10 || source[at] == 13 { return Bytes.make() }
    run Bytes.append(&mut text, &[source[at]])
    at = at + usize.ONE
  }
  if call { run Bytes.append(&mut text, b"(...)") }
  return move text
}

// The members of a dependency cycle as `A` and `B`, or `A`, `B` and `C`, in path order; empty when
// the path has fewer than two members or one has no name.
effect fn cycleMembers(rejection: &Shared<Rejection>) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let count = Shared<Rejection>.with<usize>(rejection, fn(value: &Rejection) -> usize {
    return List<Shared<DeclarationId>>.length(&value.path)
  })
  let mut members = Bytes.make()
  if count < 3 { return move members }
  let mut at = usize.ZERO
  while at + usize.ONE < count {
    let member = Shared<Rejection>.with<DeclarationId>(rejection, fn(value: &Rejection) -> DeclarationId {
      return DeclarationId.copyShared(&List<Shared<DeclarationId>>.asSlice(&value.path)[at])
    })
    let owners = DeclarationId.ownerCount(&member)
    if owners == usize.ZERO || !DeclarationId.ownerNamed(&member, owners - usize.ONE) { return Bytes.make() }
    if at > usize.ZERO {
      if at + 2 == count { run Bytes.append(&mut members, b" and ") } else { run Bytes.append(&mut members, b", ") }
    }
    run Bytes.append(&mut members, b"`")
    let name = run DeclarationId.copyOwnerName(&member, owners - usize.ONE)
    run Bytes.append(&mut members, Bytes.asSlice(&name))
    run Bytes.append(&mut members, b"`")
    at = at + usize.ONE
  }
  return move members
}

// Codes whose first template is the general one: a rejection that chooses none fills it, and only
// a narrower case chooses another.
fn firstByDefault(code: Code) -> bool {
  return match code {
    Code.AssignmentTypeMismatch => true
    Code.ExecutableBorrowEscape => true
    Code.StaticPhaseViolation => true
    Code.NonAliasResolutionCycle => true
    Code.InvalidAssignmentPlace => true
    Code.MissingUnsafeBoundary => true
    Code.ArgumentTypeMismatch => true
    Code.UnprovenConformance => true
    Code.UnknownActorOperation => true
    Code.ProjectionOnNonStruct => true
    Code.IndexOnNonArray => true
    Code.EnumDiscriminantOutOfRange => true
    Code.PartialMove => true
    _ => false
  }
}

fn startsWith(text: &[u8], prefix: &[u8]) -> bool {
  return text.length >= prefix.length && spells(text, usize.ZERO, prefix.length, prefix)
}

// The filled template of `code`; none when the code chooses among several templates or a hole has
// no value.
effect fn filled(code: Code, rejection: &Shared<Rejection>, source: &[u8], span: Span) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  // Template 0 of unexpected tokens is the general one, whose hole the span's text fills.
  let general = match code {
    Code.UnexpectedTokens => true
    _ => false
  }
  // A code with several templates fills the one its rejection chose with a `template` argument.
  let mut choice = usize.ZERO
  if Catalog.templateCount(code) != usize.ONE && !general {
    let chosen = Shared<Rejection>.with<usize>(rejection, fn(value: &Rejection) -> usize {
      let listed = List<MessageArgument>.asSlice(&value.arguments)
      let mut at = usize.ZERO
      while at < listed.length {
        let name = Bytes.asSlice(&listed[at].name)
        let digits = Bytes.asSlice(&listed[at].value)
        // A template ordinal is one or two decimal digits.
        if spells(name, usize.ZERO, name.length, b"template") && digits.length >= usize.ONE && digits.length <= 2 {
          let mut chosen = usize.ZERO
          let mut digit = usize.ZERO
          while digit < digits.length {
            if digits[digit] < 48 || digits[digit] > 57 { return usize.MAX }
            chosen = chosen * 10 + u8.toUsize(digits[digit] - 48)
            digit = digit + usize.ONE
          }
          return chosen
        }
        at = at + usize.ONE
      }
      return usize.MAX
    })
    if chosen == usize.MAX && firstByDefault(code) {
      choice = usize.ZERO
    } else if chosen >= Catalog.templateCount(code) {
      return Option<Bytes>.none()
    } else {
      choice = chosen
    }
  }
  // A missing `unsafe` names the operation; a read of a name can only go in a block.
  if code == Code.MissingUnsafeBoundary {
    let operation = run unsafeOperation(source, span)
    if Bytes.length(&operation) == usize.ZERO { return Option<Bytes>.none() }
    let mut call = false
    let text = Bytes.asSlice(&operation)
    let mut at = usize.ZERO
    while at < text.length {
      if text[at] == 40 || text[at] == 32 { call = true }
      at = at + usize.ONE
    }
    if call { choice = 0 } else { choice = 1 }
  }
  // A dependency cycle whose members all have names lists them.
  if code == Code.NonAliasResolutionCycle {
    let members = run cycleMembers(rejection)
    if Bytes.length(&members) != usize.ZERO { choice = 1 }
  }
  // An unexpected `as` is almost always a cast written as in Rust or Swift; the cast template
  // names the conversion functions instead.
  if general && span.start <= span.end && span.end <= source.length && spells(source, span.start, span.end, b"as") {
    choice = 4
  }
  let template = String.utf8Bytes(Catalog.template(code, choice))
  let mut output = Bytes.make()
  let mut at = usize.ZERO
  while at < template.length {
    let byte = template[at]
    let next = at + usize.ONE

    // `{{` and `}}` spell literal braces; `{name}` is a hole.
    if (byte == 123 || byte == 125) && next < template.length && template[next] == byte {
      run Bytes.append(&mut output, &[byte])
      at = next + usize.ONE
    } else if byte == 123 {
      let mut close = next
      while close < template.length && template[close] != 125 {
        close = close + usize.ONE
      }
      if
        !run appendArgument(&mut output, code, template, next, close, rejection, source, span) {
        return Option<Bytes>.none()
      }
      at = close + usize.ONE
    } else {
      run Bytes.append(&mut output, &[byte])
      at = next
    }
  }
  return Option<Bytes>.some(move output)
}

// The located scalar parts of a rejection, copied out of its shared record.
struct Subject {
  code: RejectionCode,
  module: ModuleId,
  span: Span,
  related: Option<RelatedSite>,
}

fn subjectOf(value: &Rejection) -> Subject {
  let related = match &value.related {
    Option<RelatedSite>.Some { value: site } => Option<RelatedSite>.some(RelatedSite { module: ModuleId.copy(&site.module), span: site.span })
    Option<RelatedSite>.None => Option<RelatedSite>.none()
  }
  return Subject { code: value.code, module: ModuleId.copy(&value.module), span: value.span, related: move related }
}

/// The located parts of `rejection` in its module's `source`, displayed at `path`; none for a
/// compiler refusal, which has no catalog code.
pub effect fn fields(
  rejection: &Shared<Rejection>,
  source: &[u8],
  path: &[u8]
) -> Option<RenderedDiagnostic>
  ! OutOfMemoryError
  ? &mut Allocator {
  let subject = Shared<Rejection>.with<Subject>(rejection, subjectOf)
  let code = match move Rejections.catalogCode(subject.code) {
    Option<Code>.Some { value } => value
    Option<Code>.None => {
      return Option<RenderedDiagnostic>.none()
    }
  }
  let at = position(source, subject.span.start)
  let mut related = List<RelatedLocation>.make()

  // Only a site in the same module has a source to locate it in, and a site at the diagnostic's
  // own line and column adds nothing.
  if let Option<RelatedSite>.Some { value: site } = &subject.related {
    let relatedAt = position(source, site.span.start)
    if ModuleId.equals(&site.module, &subject.module) && (relatedAt.line != at.line || relatedAt.column != at.column) {
      run List<
        RelatedLocation
      >.append(
        &mut related,
        RelatedLocation {
          path: run Bytes.copy(path),
          line: relatedAt.line,
          column: relatedAt.column,
          start: site.span.start,
          end: site.span.end,
          label: run relatedLabel(code),
        }
      )
    }
  }
  return Option<
    RenderedDiagnostic
  >.some(
    RenderedDiagnostic {
      code: run Bytes.copy(String.utf8Bytes(Catalog.spelling(code))),
      severity: run Bytes.copy(b"error"),
      path: run Bytes.copy(path),
      line: at.line,
      column: at.column,
      start: subject.span.start,
      end: subject.span.end,
      message: run message(code, rejection, source, subject.span),
      notes: run notesOf(rejection),
      related: move related,
    }
  )
}

// The `note` arguments of `rejection`, in order; each renders as its own note line.
effect fn notesOf(rejection: &Shared<Rejection>) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let count = Shared<Rejection>.with<usize>(rejection, fn(value: &Rejection) -> usize {
    return List<MessageArgument>.length(&value.arguments)
  })
  let mut notes = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < count {
    let length = Shared<Rejection>.with<usize>(rejection, fn(value: &Rejection) -> usize {
      let listed = List<MessageArgument>.asSlice(&value.arguments)
      let name = Bytes.asSlice(&listed[at].name)
      if !spells(name, usize.ZERO, name.length, b"note") { return usize.MAX }
      return Bytes.length(&listed[at].value)
    })
    if length != usize.MAX {
      let mut note = Bytes.make()
      let mut byte = usize.ZERO
      while byte < length {
        let next = Shared<Rejection>.with<u8>(rejection, fn(value: &Rejection) -> u8 {
          return Bytes.asSlice(&List<MessageArgument>.asSlice(&value.arguments)[at].value)[byte]
        })
        run Bytes.append(&mut note, &[next])
        byte = byte + usize.ONE
      }
      run List<Bytes>.append(&mut notes, move note)
    }
    at = at + usize.ONE
  }
  return move notes
}

/// The bootstrap CLI text of `rejection`, without a trailing line feed; none for a refusal.
pub effect fn render(rejection: &Shared<Rejection>, source: &[u8], path: &[u8]) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let rendered = match move run fields(rejection, source, path) {
    Option<RenderedDiagnostic>.Some { value } => move value
    Option<RenderedDiagnostic>.None => {
      return Option<Bytes>.none()
    }
  }
  return Option<Bytes>.some(run text(&rendered))
}

// What a code's related site is, where a plain "related location" would leave the reader guessing.
effect fn relatedLabel(code: Code) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  return match code {
    Code.ConflictingViewLoan => Option<Bytes>.some(run Bytes.copy(b"the earlier borrow starts here"))
    Code.OwnerAccessDuringLoan => Option<Bytes>.some(run Bytes.copy(b"the borrow starts here"))
    Code.ExpiredLifetime => Option<Bytes>.some(run Bytes.copy(b"the borrow starts here"))
    _ => Option<Bytes>.none()
  }
}

/// The bootstrap CLI text of `rendered`, without a trailing line feed.
pub effect fn text(rendered: &RenderedDiagnostic) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut output = Bytes.make()
  run Bytes.append(&mut output, Bytes.asSlice(&rendered.path))
  run Bytes.append(&mut output, b":")
  run appendDecimal(&mut output, rendered.line)
  run Bytes.append(&mut output, b":")
  run appendDecimal(&mut output, rendered.column)
  run Bytes.append(&mut output, b": ")
  run Bytes.append(&mut output, Bytes.asSlice(&rendered.severity))
  run Bytes.append(&mut output, b"[")
  run Bytes.append(&mut output, Bytes.asSlice(&rendered.code))
  run Bytes.append(&mut output, b"]")
  if let Option<Bytes>.Some { value: text } = &rendered.message {
    run Bytes.append(&mut output, b" ")
    run Bytes.append(&mut output, Bytes.asSlice(&text))
  }
  let notes = List<Bytes>.asSlice(&rendered.notes)
  let mut at = usize.ZERO
  while at < notes.length {
    run Bytes.append(&mut output, b"\n  note: ")
    run Bytes.append(&mut output, Bytes.asSlice(&notes[at]))
    at = at + usize.ONE
  }
  // Each related site follows as a located note, as the JSON format lists it under `related`.
  let related = List<RelatedLocation>.asSlice(&rendered.related)
  at = usize.ZERO
  while at < related.length {
    run Bytes.append(&mut output, b"\n  note: ")
    run Bytes.append(&mut output, Bytes.asSlice(&related[at].path))
    run Bytes.append(&mut output, b":")
    run appendDecimal(&mut output, related[at].line)
    run Bytes.append(&mut output, b":")
    run appendDecimal(&mut output, related[at].column)
    run Bytes.append(&mut output, b": ")
    match &related[at].label {
      Option<Bytes>.Some { value: label } => { run Bytes.append(&mut output, Bytes.asSlice(&label)) }
      Option<Bytes>.None => { run Bytes.append(&mut output, b"related location") }
    }
    at = at + usize.ONE
  }
  return move output
}
