//! Renders a catalog diagnostic exactly as the bootstrap CLI prints it.
//!
//! # When to use
//! Use [`render`] for the human line of one rejection and [`fields`] for a machine-readable record
//! of the same diagnostic. Both are pure over the rejection and its module's source bytes.
//!
//! # Details
//! The line is `path:line:column: error[CODE] message`, followed by one `  note: ...` line per
//! note. The line is one more than the number of line feeds before the primary span's start; the
//! column is the 1-based UTF-8 byte column. Related spans are not printed, as in the bootstrap.
//!
//! A message is the code's catalog template with every hole filled. Native rejections do not yet
//! carry every value a template names; a template with a hole the rejection cannot fill renders
//! no message rather than wording that differs from the catalog.

import diagnostic.Catalog as Catalog { Code }
import diagnostic.JsonText { appendDecimal }
import lexer.Span { Span }
import semantic.ModuleId { ModuleId }
import semantic.Rejection as Rejections { MessageArgument, RelatedSite, Rejection, RejectionCode }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.option { Option }
import silk.shared { Shared }
import silk.string { String }
import silk.usize
import silk.vector { Vector }

/// A 1-based line and byte column in a source text.
pub struct Position {
  pub line: usize
  pub column: usize
}

/// One located site related to a diagnostic.
pub struct RelatedLocation {
  pub path: Bytes
  pub line: usize
  pub column: usize
  pub start: usize
  pub end: usize
  pub label: Option<Bytes>
}

/// The located parts of one catalog diagnostic.
pub struct RenderedDiagnostic {
  pub code: Bytes
  pub severity: Bytes
  pub path: Bytes
  pub line: usize
  pub column: usize
  pub start: usize
  pub end: usize

  /// The filled catalog message; none while the rejection cannot fill every hole of its template.
  pub message: Option<Bytes>
  pub notes: Vector<Bytes>
  pub related: Vector<RelatedLocation>
}

/// The position of byte `offset` in `source`, clamped to the source's length.
pub fn position(source: &[u8], offset: usize) -> Position {
  let mut bounded = offset
  if bounded > source.length {
    bounded = source.length
  }
  let mut line = usize.ONE
  let mut lineStart = usize.ZERO
  let mut at = usize.ZERO
  while at < bounded {
    if source[at] == 10 {
      line = line + usize.ONE
      lineStart = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return Position { line: line, column: bounded - lineStart + usize.ONE }
}

// The hole a code fills with the source text of its primary span, if any. A code joins this list
// only once its native span is shown to cover exactly the text the bootstrap interpolates.
fn spanArgument(code: Code) -> Option<string<'static>> {
  return match code {
    Code.UnknownType => Option<string<'static>>.some("spelling")
    Code.DuplicateDeclarationName => Option<string<'static>>.some("spelling")
    Code.DuplicateFieldName => Option<string<'static>>.some("spelling")
    Code.UnknownFunction => Option<string<'static>>.some("spelling")
    Code.DuplicateParameterName => Option<string<'static>>.some("spelling")
    Code.UnknownValueReference => Option<string<'static>>.some("spelling")
    Code.UnknownActor => Option<string<'static>>.some("spelling")
    Code.ExpectedType => Option<string<'static>>.some("spelling")
    Code.DuplicateTypeParameter => Option<string<'static>>.some("spelling")
    Code.DuplicateEnumMemberName => Option<string<'static>>.some("spelling")
    Code.DuplicateUnionVariant => Option<string<'static>>.some("spelling")
    Code.UnknownLifetime => Option<string<'static>>.some("spelling")
    Code.ExplicitMoveRequired => Option<string<'static>>.some("spelling")
    _ => Option<string<'static>>.none()
  }
}

// Appends the value of the hole spelled `template[start..end]` to `output`: a named argument the
// producer supplied, or else the span text of a code listed by [`spanArgument`]. False when the
// rejection carries neither.
effect fn appendArgument(
  output: &mut Bytes,
  code: Code,
  template: &[u8],
  start: usize,
  end: usize,
  rejection: &Shared<Rejection>,
  source: &[u8],
  span: Span
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  // The shared rejection is read through pure accessors; the bytes are appended outside them.
  let supplied = Shared<Rejection>.with<usize>(rejection, fn(value: &Rejection) -> usize {
    let listed = Vector<MessageArgument>.asSlice(&value.arguments)
    let mut at = usize.ZERO
    while at < listed.length {
      if spells(template, start, end, Bytes.asSlice(&listed[at].name)) { return at }
      at = at + usize.ONE
    }
    return usize.MAX
  })
  if supplied != usize.MAX {
    let length = Shared<Rejection>.with<usize>(rejection, fn(value: &Rejection) -> usize {
      let listed = Vector<MessageArgument>.asSlice(&value.arguments)
      return Bytes.length(&listed[supplied].value)
    })
    let mut copied = usize.ZERO
    while copied < length {
      let byte = Shared<Rejection>.with<u8>(rejection, fn(value: &Rejection) -> u8 {
        let listed = Vector<MessageArgument>.asSlice(&value.arguments)
        return Bytes.asSlice(&listed[supplied].value)[copied]
      })
      run Bytes.append(&mut output.*, &[byte])
      copied = copied + usize.ONE
    }
    return true
  }
  if let Option<string<'static>>.Some { value: spanned } = move spanArgument(code) {
    if spells(template, start, end, String.utf8Bytes(spanned)) && span.end <= source.length && oneName(source, span) {
      let mut at = span.start
      while at < span.end {
        run Bytes.append(&mut output.*, &[source[at]])
        at = at + usize.ONE
      }
      return true
    }
  }
  return false
}

// Whether `source[span]` is one identifier or lifetime spelling, the only text a span argument
// may contribute; any wider span leaves the message unfilled.
fn oneName(source: &[u8], span: Span) -> bool {
  if span.start >= span.end { return false }
  let mut at = span.start
  if source[at] == 39 { at = at + usize.ONE }
  if at >= span.end { return false }
  while at < span.end {
    let byte = source[at]
    let letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
    let digit = byte >= 48 && byte <= 57
    if !letter && !(digit && at > span.start) { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether `text[start..end]` spells `name`.
fn spells(text: &[u8], start: usize, end: usize, name: &[u8]) -> bool {
  if end - start != name.length {
    return false
  }
  let mut at = usize.ZERO
  while at < name.length {
    if text[start + at] != name[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// The filled message of `code` for `rejection` at `span`; none when the code chooses among several
/// templates or a hole has no value.
pub effect fn message(code: Code, rejection: &Shared<Rejection>, source: &[u8], span: Span) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  if Catalog.templateCount(code) != usize.ONE {
    return Option<Bytes>.none()
  }
  let template = String.utf8Bytes(Catalog.template(code, usize.ZERO))
  let mut output = Bytes.make()
  let mut at = usize.ZERO
  while at < template.length {
    let byte = template[at]
    let next = at + usize.ONE

    // `{{` and `}}` spell literal braces; `{name}` is a hole.
    if (byte == 123 || byte == 125) && next < template.length && template[next] == byte {
      run Bytes.append(&mut output, &[byte])
      at = next + usize.ONE
    } else if byte == 123 {
      let mut close = next
      while close < template.length && template[close] != 125 {
        close = close + usize.ONE
      }
      if
        !run appendArgument(&mut output, code, template, next, close, rejection, source, span) {
        return Option<Bytes>.none()
      }
      at = close + usize.ONE
    } else {
      run Bytes.append(&mut output, &[byte])
      at = next
    }
  }
  return Option<Bytes>.some(move output)
}

// The located scalar parts of a rejection, copied out of its shared record.
struct Subject {
  code: RejectionCode
  module: ModuleId
  span: Span
  related: Option<RelatedSite>
}

fn subjectOf(value: &Rejection) -> Subject {
  let related = match &value.related {
    Option<RelatedSite>.Some { value: site } => Option<RelatedSite>.some(RelatedSite { module: ModuleId.copy(&site.module), span: site.span })
    Option<RelatedSite>.None => Option<RelatedSite>.none()
  }
  return Subject { code: value.code, module: ModuleId.copy(&value.module), span: value.span, related: move related }
}

/// The located parts of `rejection` in its module's `source`, displayed at `path`; none for a
/// compiler refusal, which has no catalog code.
pub effect fn fields(
  rejection: &Shared<Rejection>,
  source: &[u8],
  path: &[u8]
) -> Option<RenderedDiagnostic>
  ! OutOfMemoryError
  ? &mut Allocator {
  let subject = Shared<Rejection>.with<Subject>(rejection, subjectOf)
  let code = match move Rejections.catalogCode(subject.code) {
    Option<Code>.Some { value } => value
    Option<Code>.None => {
      return Option<RenderedDiagnostic>.none()
    }
  }
  let at = position(source, subject.span.start)
  let mut related = Vector<RelatedLocation>.make()

  // Only a site in the same module has a source to locate it in.
  if let Option<RelatedSite>.Some { value: site } = &subject.related {
    if ModuleId.equals(&site.module, &subject.module) {
      let relatedAt = position(source, site.span.start)
      run Vector<
        RelatedLocation
      >.append(
        &mut related,
        RelatedLocation {
          path: run Bytes.copy(path),
          line: relatedAt.line,
          column: relatedAt.column,
          start: site.span.start,
          end: site.span.end,
          label: Option<Bytes>.none(),
        }
      )
    }
  }
  return Option<
    RenderedDiagnostic
  >.some(
    RenderedDiagnostic {
      code: run Bytes.copy(String.utf8Bytes(Catalog.spelling(code))),
      severity: run Bytes.copy(b"error"),
      path: run Bytes.copy(path),
      line: at.line,
      column: at.column,
      start: subject.span.start,
      end: subject.span.end,
      message: run message(code, rejection, source, subject.span),
      notes: Vector<Bytes>.make(),
      related: move related,
    }
  )
}

/// The bootstrap CLI text of `rejection`, without a trailing line feed; none for a refusal.
pub effect fn render(rejection: &Shared<Rejection>, source: &[u8], path: &[u8]) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let rendered = match move run fields(rejection, source, path) {
    Option<RenderedDiagnostic>.Some { value } => move value
    Option<RenderedDiagnostic>.None => {
      return Option<Bytes>.none()
    }
  }
  let mut output = Bytes.make()
  run Bytes.append(&mut output, Bytes.asSlice(&rendered.path))
  run Bytes.append(&mut output, b":")
  run appendDecimal(&mut output, rendered.line)
  run Bytes.append(&mut output, b":")
  run appendDecimal(&mut output, rendered.column)
  run Bytes.append(&mut output, b": ")
  run Bytes.append(&mut output, Bytes.asSlice(&rendered.severity))
  run Bytes.append(&mut output, b"[")
  run Bytes.append(&mut output, Bytes.asSlice(&rendered.code))
  run Bytes.append(&mut output, b"]")
  if let Option<Bytes>.Some { value: text } = &rendered.message {
    run Bytes.append(&mut output, b" ")
    run Bytes.append(&mut output, Bytes.asSlice(&text))
  }
  let notes = Vector<Bytes>.asSlice(&rendered.notes)
  let mut at = usize.ZERO
  while at < notes.length {
    run Bytes.append(&mut output, b"\n  note: ")
    run Bytes.append(&mut output, Bytes.asSlice(&notes[at]))
    at = at + usize.ONE
  }
  return Option<Bytes>.some(move output)
}
