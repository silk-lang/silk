fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn contains(text: &[u8], needle: &[u8]) -> bool {
  if text.length < needle.length { return false }
  let mut at = usize.ZERO
  while at <= text.length - needle.length {
    let mut byte = usize.ZERO
    let mut matches = true
    while byte < needle.length {
      if text[at + byte] != needle[byte] { matches = false }
      byte = byte + usize.ONE
    }
    if matches { return true }
    at = at + usize.ONE
  }
  return false
}

test effect fn jsonTextPreservesUtf8ControlBytesAndDecimal() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run textClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn textClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut output = Bytes.make()
  let text: [u8; 8] = [34, 92, 0, 10, 31, 195, 169, 65]
  run JsonText.appendString(&mut output, &text)
  run Testing.expect(same(Bytes.asSlice(&output), b"\"\\\"\\\\\\u0000\\u000a\\u001f\xc3\xa9A\""), "JSON retains UTF8 while escaping quote, slash and every control byte")
  let mut decimal = Bytes.make()
  run JsonText.appendDecimal(&mut decimal, usize.ZERO)
  run Bytes.append(&mut decimal, b",")
  run JsonText.appendDecimal(&mut decimal, 123456789)
  run Testing.expect(same(Bytes.asSlice(&decimal), b"0,123456789"), "the production decimal recipe preserves zero and digit order")
  return ()
}

effect fn fixture() -> Semantic ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let id = run ModuleId.make(b"memory", b"codec", b"result.silk")
  let source = Option<Bytes>.some(run Bytes.copy(b"struct A {}\nstruct B {}\nimpl A { fn same() -> i32 { return 1 } }\nimpl B { fn same() -> i32 { return 2 } }\ninterface Contract { fn absent() -> i32 }\nfn refused() -> i32 { return missing }\nstatic if false { fn inactive() -> i32 { return 3 } }\n"))
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  return Semantic.oneShot(move revision, Target.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
}

test effect fn strictCodecKeepsActualPhaseAndIndependentEligibility() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run phaseClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn phaseClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let mut semantic = run fixture()
  let id = run ModuleId.make(b"memory", b"codec", b"result.silk")
  let mut request = Request.make()
  let inventory = run Semantic.demandSourceInventory(&mut semantic, &mut request, &id)
  let mut methods = usize.ZERO
  let mut previous = Bytes.make()
  let mut noBody = false
  let mut inactive = false
  let mut refused = false
  if let SourceInventory.Present {syntax, observation, sourceDigest, availability, ..} = &inventory {
    let functions = List<NamedFunction>.asSlice(&syntax.functions)
    let states = List<Result<bool, Shared<Rejection>>>.asSlice(&availability)
    let digest = Option<[u8; 32]>.some(sourceDigest)
    let mut at = usize.ZERO
    while at < functions.length {
      let f = &functions[at]
      let signature = run Semantic.demandSignatureOf(&mut semantic, &mut request, &f.declaration.identity)
      if DeclarationId.named(&f.declaration.identity, b"same") {
        let body = run Semantic.demandBodyOf(&mut semantic, &mut request, &f.declaration.identity)
        let correct = Shared<Result<Answer, NoRejection>>.with<bool>(&signature, fn(answer: &Result<Answer, NoRejection>) -> bool {
          let fact = StrictInventoryResult.classifyAnswer(Phase.Signature, answer)
          let wrong = StrictInventoryResult.classifyAnswer(Phase.Body, answer)
          return same(StrictInventoryResult.factName(&fact), b"signature") && same(StrictInventoryResult.factName(&wrong), b"wrong-value")
        })
        let correctBody = Shared<Result<Answer, NoRejection>>.with<bool>(&body, fn(answer: &Result<Answer, NoRejection>) -> bool {
          let fact = StrictInventoryResult.classifyAnswer(Phase.Body, answer)
          let wrong = StrictInventoryResult.classifyAnswer(Phase.Signature, answer)
          return same(StrictInventoryResult.factName(&fact), b"body") && same(StrictInventoryResult.factName(&wrong), b"wrong-value")
        })
        let row = run StrictInventoryResult.queryOne(&mut semantic, &mut request, f, &observation, &digest, &states[at], Phase.Body)
        run Testing.expect(contains(Bytes.asSlice(&row), b"{\"schema\":\"silk.strict-inventory\",\"version\":1,\"record\":\"function\"") && correct && correctBody && contains(Bytes.asSlice(&row), b"\"kind\":\"body\"") && contains(Bytes.asSlice(&row), b"\"borrow_status\":\"not-checked\"") && contains(Bytes.asSlice(&row), b"\"occurrence\":0"), "only the requested actual phase is a fact and a body retains its native checking limit")
        if methods != usize.ZERO { run Testing.expect(!same(Bytes.asSlice(&previous), Bytes.asSlice(&row)), "same-named methods keep distinct complete canonical owner chains") }
        previous = move row
        methods = methods + usize.ONE
      } else if DeclarationId.named(&f.declaration.identity, b"absent") {
        let row = run StrictInventoryResult.queryOne(&mut semantic, &mut request, f, &observation, &digest, &states[at], Phase.Signature)
        let body = run StrictInventoryResult.queryOne(&mut semantic, &mut request, f, &observation, &digest, &states[at], Phase.Body)
        noBody = contains(Bytes.asSlice(&row), b"\"eligibility\":\"no-body\",\"has_body\":false,\"fact\":{\"kind\":\"signature\"") && contains(Bytes.asSlice(&body), b"\"eligibility\":\"no-body\",\"has_body\":false,\"fact\":{\"kind\":\"not-demanded\"}")
      } else if DeclarationId.named(&f.declaration.identity, b"inactive") {
        let row = run StrictInventoryResult.queryOne(&mut semantic, &mut request, f, &observation, &digest, &states[at], Phase.Body)
        inactive = contains(Bytes.asSlice(&row), b"\"eligibility\":\"inactive\",\"has_body\":true,\"fact\":{\"kind\":\"not-demanded\"}")
      } else if DeclarationId.named(&f.declaration.identity, b"refused") {
        let row = run StrictInventoryResult.queryOne(&mut semantic, &mut request, f, &observation, &digest, &states[at], Phase.Body)
        refused = contains(Bytes.asSlice(&row), b"\"kind\":\"rejected\",\"code\":\"SEM0006\"") && contains(Bytes.asSlice(&row), b"\"module\":{\"origin\":\"memory\",\"package\":\"codec\",\"path\":\"result.silk\"}")
      }
      at = at + usize.ONE
    }
  }
  run Testing.expect(methods == 2 && noBody && inactive && refused, "no-body keeps a real Signature beside an undemanded Body; inactive declarations are not demanded and rejected queries are not Body evidence")
  return ()
}

test effect fn strictCodecPreservesUnsupportedOriginalSourceAndQueryErrors() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run refusalClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn refusalClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let mut semantic = run fixture()
  let id = run ModuleId.make(b"memory", b"codec", b"result.silk")
  let mut request = Request.make()
  let inventory = run Semantic.demandSourceInventory(&mut semantic, &mut request, &id)
  let mut tested = false
  if let SourceInventory.Present {syntax, observation, sourceDigest, availability, ..} = &inventory {
    let functions = List<NamedFunction>.asSlice(&syntax.functions)
    let states = List<Result<bool, Shared<Rejection>>>.asSlice(&availability)
    let digest = Option<[u8; 32]>.some(sourceDigest)
    let first = &functions[usize.ZERO]
    let owner = run Shared<DeclarationId>.make(DeclarationId.copy(&first.declaration.identity))
    let foreignId = run ModuleId.make(b"imported", b"other", b"foreign.silk")
    let foreignUnit = run SourceUnit.parse(&foreignId, usize.ONE, run Bytes.copy(b"fn original() {}"))
    let foreignIndex = run ModuleIndex.build(&foreignUnit, false)
    let copiedForeign = run ModuleIndex.copyFunctionInventory(&foreignIndex, &foreignUnit)
    let foreignSyntax = match move copiedForeign {
      Option<FunctionInventory>.Some {value} => move value
      Option<FunctionInventory>.None => { run Testing.expect(false, "a valid foreign source has a copied census")
        return () }
    }
    let foreignFunctions = List<NamedFunction>.asSlice(&foreignSyntax.functions)
    let original = run Shared<DeclarationId>.make(DeclarationId.copy(&foreignFunctions[usize.ZERO].declaration.identity))
    let gap = run Shared<Gap>.make(Gap {code: GapCode.TypedForm, owner: Shared<DeclarationId>.clone(&owner),
      source: GapSource.Declaration {declaration: Shared<DeclarationId>.clone(&original), span: Span.make(7, 15)}})
    let unsupported = Outcome.Success {value: Value.Unsupported {gap: move gap}}
    let classified = StrictInventoryResult.classify(Phase.Body, &unsupported)
    let wrongOutcome = Outcome.Success {value: Value.Condition {holds: true}}
    let wrong = StrictInventoryResult.classify(Phase.Signature, &wrongOutcome)
    let failure = Result<Answer, NoRejection>.failResult(NoRejection {})
    let queryError = StrictInventoryResult.classifyAnswer(Phase.Body, &failure)
    let mut row = Bytes.make()
    run StrictInventoryResult.appendRecord(&mut row, first, &observation, &digest, Phase.Body, Eligibility.Eligible, &classified)
    run Testing.expect(same(StrictInventoryResult.factName(&classified), b"unsupported") && same(StrictInventoryResult.factName(&wrong), b"wrong-value") && same(StrictInventoryResult.factName(&queryError), b"query-error") && contains(Bytes.asSlice(&row), b"\"kind\":\"unsupported\",\"coverage_reason\":\"typed-form\",\"module\":"), "Unsupported inside Success is retained as a gap, not a Body fact; unrelated values and query failures are explicit")
    run Testing.expect(contains(Bytes.asSlice(&row), b"\"module\":{\"origin\":\"imported\",\"package\":\"other\",\"path\":\"foreign.silk\"},\"span\":{\"start\":7,\"end\":15}"), "a gap retains its original imported source rather than the inventory subject or reached owner")
    let refusal = run Shared<Rejection>.make(run Rejections.make(RejectionCode.IntrinsicUnavailable, &foreignId, Span.make(7, 15)))
    let mut refusals = List<Shared<Rejection>>.make()
    run List<Shared<Rejection>>.append(&mut refusals, move refusal)
    let refusedOutcome = Outcome.Rejected {diagnostics: move refusals, partial: Option<Shared<TypedBody>>.none()}
    let refusedFact = StrictInventoryResult.classify(Phase.Body, &refusedOutcome)
    let mut refusalRow = Bytes.make()
    run StrictInventoryResult.appendRecord(&mut refusalRow, first, &observation, &digest, Phase.Body, Eligibility.Eligible, &refusedFact)
    run Testing.expect(same(StrictInventoryResult.factName(&refusedFact), b"unsupported")
      && contains(Bytes.asSlice(&refusalRow), b"\"kind\":\"unsupported\",\"reason\":\"IntrinsicUnavailable\"")
      && !contains(Bytes.asSlice(&refusalRow), b"\"code\":")
      && contains(Bytes.asSlice(&refusalRow), b"\"path\":\"foreign.silk\""),
      "an unimplemented semantic feature is an uncoded refusal retaining its internal reason and original module")
    let generated = run Shared<Gap>.make(Gap.relative(GapCode.TypedForm, &original, Location.generated()))
    let generatedFact = Fact.Unsupported {gap: move generated}
    let mut generatedRow = Bytes.make()
    run StrictInventoryResult.appendRecord(&mut generatedRow, first, &observation, &digest, Phase.Body, Eligibility.Eligible, &generatedFact)
    run Testing.expect(contains(Bytes.asSlice(&generatedRow), b"\"module\":{\"origin\":\"imported\",\"package\":\"other\",\"path\":\"foreign.silk\"},\"span\":{\"start\":0,\"end\":0}"),
      "a generated gap preserves its owning module and explicit absent authored position")
    let anchor = match move Anchor.of(&foreignUnit.authored, &foreignUnit.locations, foreignFunctions[usize.ZERO].declaration.local) {
      Option<Anchor>.Some {value} => move value
      Option<Anchor>.None => {return run Testing.expect(false, "the authored gap has a source anchor")}
    }
    let located = Gap.relative(GapCode.TypedForm, &original, Anchor.location(&anchor, Span.make(3, 11)))
    let placed = run Shared<Gap>.make(Gap.anchored(move located, &anchor))
    let placedFact = Fact.Unsupported {gap: move placed}
    let mut placedRow = Bytes.make()
    run StrictInventoryResult.appendRecord(&mut placedRow, first, &observation, &digest, Phase.Body, Eligibility.Eligible, &placedFact)
    run Testing.expect(contains(Bytes.asSlice(&placedRow), b"\"module\":{\"origin\":\"imported\",\"package\":\"other\",\"path\":\"foreign.silk\"},\"span\":{\"start\":3,\"end\":11}"),
      "a token-located gap is placed at its exact authored name before serialization")
    let mut at = usize.ZERO
    let mut propagated = false
    while at < functions.length {
      if DeclarationId.named(&functions[at].declaration.identity, b"refused") {
        let answer = run Semantic.demandBodyOf(&mut semantic, &mut request, &functions[at].declaration.identity)
        let diagnostic = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer,
          fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> {
            if let Result<Answer, NoRejection>.Success {value: completed} = &value.* {
              if let Outcome.Rejected {..} = &completed.outcome { return Outcome.cause(&completed.outcome) }
            }
            return Option<Shared<Rejection>>.none()
          })
        if let Option<Shared<Rejection>>.Some {value} = &diagnostic {
          let propagatedGap = run Shared<Gap>.make(Gap.fromRejection(GapCode.TypedForm, &original, &value))
          let fact = Fact.Unsupported {gap: move propagatedGap}
          let mut output = Bytes.make()
          run StrictInventoryResult.appendRecord(&mut output, first, &observation, &digest, Phase.Body, Eligibility.Eligible, &fact)
          propagated = contains(Bytes.asSlice(&output), b"\"kind\":\"unsupported\",\"coverage_reason\":\"typed-form\",\"module\":{\"origin\":\"memory\",\"package\":\"codec\",\"path\":\"result.silk\"}") && contains(Bytes.asSlice(&output), b"\"diagnostic_code\":\"SEM0006\"")
        }
      }
      at = at + usize.ONE
    }
    run Testing.expect(propagated, "propagated gaps preserve the rejection's original module and diagnostic code without duplicate JSON keys")
    let absent = run Revision.observe(&Revision.make(), &id)
    let absentDigest = Option<[u8; 32]>.none()
    let missing = run StrictInventoryResult.queryOne(&mut semantic, &mut request, first, &absent, &absentDigest, &states[usize.ZERO], Phase.Body)
    run Testing.expect(contains(Bytes.asSlice(&missing), b"\"present\":false,\"sha256\":null") && contains(Bytes.asSlice(&missing), b"\"eligibility\":\"missing-source\"") && contains(Bytes.asSlice(&missing), b"\"kind\":\"query-error\""), "absence cannot produce a successful phase fact or a fabricated digest")
    tested = true
  }
  run Testing.expect(tested, "unsupported/query-error controls use a real copied V01 subject")
  return ()
}

test effect fn strictCodecFooterStatesCoverageWithoutStageSuccess() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run footerClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn footerClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut partial = Bytes.make()
  run StrictInventoryResult.appendFooter(&mut partial, 2, 3, true)
  run Testing.expect(same(Bytes.asSlice(&partial), b"{\"schema\":\"silk.strict-inventory\",\"version\":1,\"record\":\"footer\",\"records\":2,\"expected_records\":3,\"coverage_complete\":false}\n"), "the versioned footer retains incomplete coverage")
  let mut interrupted = Bytes.make()
  run StrictInventoryResult.appendFooter(&mut interrupted, 3, 3, false)
  run Testing.expect(contains(Bytes.asSlice(&interrupted), b"\"coverage_complete\":false"), "matching counts cannot hide an unfinished collector")
  let mut finished = Bytes.make()
  run StrictInventoryResult.appendFooter(&mut finished, 3, 3, true)
  run Testing.expect(contains(Bytes.asSlice(&finished), b"\"coverage_complete\":true") && !contains(Bytes.asSlice(&finished), b"success"), "coverage is not a compiler-stage success flag")
  return ()
}

// Rendering a catalog diagnostic as the bootstrap CLI prints it (diagnostic.Report).

fn sameReportBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Appends `template` with its one `{...}` hole replaced by `value`.
effect fn appendFilled(output: &mut Bytes, template: &[u8], value: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < template.length {
    if template[at] == 123 {
      run Bytes.append(&mut output.*, value)
      while template[at] != 125 { at = at + usize.ONE }
    } else {
      run Bytes.append(&mut output.*, &[template[at]])
    }
    at = at + usize.ONE
  }
  return ()
}

// Appends `template` with its first hole replaced by `first` and its second by `second`.
effect fn appendFilledArguments(output: &mut Bytes, template: &[u8], first: &[u8], second: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut holes = usize.ZERO
  let mut at = usize.ZERO
  while at < template.length {
    if template[at] == 123 {
      if holes == usize.ZERO { run Bytes.append(&mut output.*, first) } else { run Bytes.append(&mut output.*, second) }
      holes = holes + usize.ONE
      while template[at] != 125 { at = at + usize.ONE }
    } else {
      run Bytes.append(&mut output.*, &[template[at]])
    }
    at = at + usize.ONE
  }
  return ()
}

// Renders the way `silk check` does: the caller forwards the `&Shared<Rejection>` it borrows from
// the store to both `fields` and `render`. None unless `fields` also fills the message.
effect fn forwardedRender(rejection: &Shared<Rejection>, source: &[u8], path: &[u8]) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let filled = match move run Report.fields(rejection, source, path) {
    Option<Report.RenderedDiagnostic>.Some { value } => match &value.message {
      Option<Bytes>.Some { .. } => true
      Option<Bytes>.None => false
    }
    Option<Report.RenderedDiagnostic>.None => false
  }
  if !filled { return Option<Bytes>.none() }
  return run Report.render(rejection, source, path)
}

// `prefix` followed by the catalog meaning of `code`, as a line whose template cannot be filled.
effect fn meaningLine(prefix: &[u8], code: Code) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut line = Bytes.make()
  run Bytes.append(&mut line, prefix)
  let meaning = run Report.meaningMessage(code)
  run Bytes.append(&mut line, Bytes.asSlice(&meaning))
  return move line
}

fn renders(rendered: &Option<Bytes>, expected: &[u8]) -> bool {
  return match &rendered.* {
    Option<Bytes>.Some { value } => sameReportBytes(Bytes.asSlice(&value), expected)
    Option<Bytes>.None => false
  }
}

test effect fn misplacedPropertyNamesBothForeignLinkages() -> ()
  ! AssertionError<'static> {
  // `export "C"` functions take `@naked` and `@noReturn` too (stdlib platform/linux/start.silk's `entry`).
  let message = String.utf8Bytes(Catalog.template(Code.MisplacedDirective, usize.ZERO))
  run Testing.expect(
    contains(message, b"only to `extern \"C\"` or `export \"C\"` functions"),
    "SEM0236 names both foreign linkages that take the foreign directives"
  )
}

test effect fn positionsCountLineFeedsAndUtf8Bytes() -> ()
  ! AssertionError<'static> {
  let source = "a\nbé c\n"
  let bytes = String.utf8Bytes(source)
  let first = Report.position(bytes, usize.ZERO)
  let afterAccent = Report.position(bytes, 5)
  let clamped = Report.position(bytes, 99)
  run Testing.expect(
    first.line == usize.ONE && first.column == usize.ONE,
    "offset 0 is line 1, column 1"
  )
  run Testing.expect(
    afterAccent.line == 2 && afterAccent.column == 4,
    "the column counts the two UTF-8 bytes of the accented letter"
  )
  run Testing.expect(
    clamped.line == 3 && clamped.column == usize.ONE,
    "an offset past the end is clamped"
  )
}

test effect fn rendersTheCatalogLineOrOnlyTheCode() -> ()
  ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run renderClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn renderClaims() -> ()
  ! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let module = run ModuleId.make(b"project", b"probe", b"Main")
  let source = String.utf8Bytes("fn f() -> () {\n  1 = 2\n}\n")

  // A template without holes renders its complete catalog wording.
  let place = run Rejections.make(RejectionCode.InvalidAssignmentPlace, &module, Span.make(17, 18))
  let mut expected = Bytes.make()
  run Bytes.append(&mut expected, b"src/Main.silk:2:3: error[SEM0036] ")
  run Bytes.append(
    &mut expected,
    String.utf8Bytes(Catalog.template(Code.InvalidAssignmentPlace, usize.ZERO))
  )
  let placeShared = run Shared<Rejection>.make(move place)
  run Testing.expect(
    renders(&run Report.render(&placeShared, source, b"src/Main.silk"), Bytes.asSlice(&expected)),
    "a hole-free template renders the bootstrap line"
  )

  // A template whose hole the rejection cannot fill renders the code's catalog meaning.
  let unknown = run Rejections.make(RejectionCode.UnknownName, &module, Span.make(17, 18))
  let unknownShared = run Shared<Rejection>.make(move unknown)
  let unknownLine = run meaningLine(b"src/Main.silk:2:3: error[SEM0006] ", Code.UnknownValueReference)
  run Testing.expect(
    renders(&run Report.render(&unknownShared, source, b"src/Main.silk"), Bytes.asSlice(&unknownLine)),
    "an unfilled hole renders the catalog meaning rather than an empty message"
  )

  // A name at the span fills a `{spelling}` hole; the expected text comes from the catalog.
  let named = String.utf8Bytes("fn f() -> i32 { return missing }\n")
  let unknownName = run Rejections.make(RejectionCode.UnknownName, &module, Span.make(23, 30))
  let mut filled = Bytes.make()
  run Bytes.append(&mut filled, b"src/Main.silk:1:24: error[SEM0006] ")
  run appendFilled(&mut filled, String.utf8Bytes(Catalog.template(Code.UnknownValueReference, usize.ZERO)), b"missing")
  let unknownNameShared = run Shared<Rejection>.make(move unknownName)
  run Testing.expect(
    renders(&run Report.render(&unknownNameShared, named, b"src/Main.silk"), Bytes.asSlice(&filled)),
    "a span covering exactly one name fills the spelling hole",
  )
  let repeatedSource = String.utf8Bytes("fn twice() -> i32 { return 0 }\nfn twice() -> i32 { return 1 }\n")
  let repeated = run Rejections.make(RejectionCode.DuplicateDeclarationName, &module, Span.make(34, 39))
  let mut repeatedLine = Bytes.make()
  run Bytes.append(&mut repeatedLine, b"src/Main.silk:2:4: error[SEM0003] ")
  run appendFilled(&mut repeatedLine, String.utf8Bytes(Catalog.template(Code.DuplicateDeclarationName, usize.ZERO)), b"twice")
  let wideHeader = run Rejections.make(RejectionCode.DuplicateDeclarationName, &module, Span.make(31, 49))
  let repeatedShared = run Shared<Rejection>.make(move repeated)
  let wideHeaderShared = run Shared<Rejection>.make(move wideHeader)
  run Testing.expect(
    renders(&run Report.render(&repeatedShared, repeatedSource, b"src/Main.silk"), Bytes.asSlice(&repeatedLine))
      && renders(
        &run Report.render(&wideHeaderShared, repeatedSource, b"src/Main.silk"),
        Bytes.asSlice(&run meaningLine(b"src/Main.silk:2:1: error[SEM0003] ", Code.DuplicateDeclarationName))
      ),
    "a repeated declaration name fills its spelling hole; a header-wide span renders the meaning",
  )
  // A related site in the same module follows the line as a located note.
  let mut relocated = run Rejections.make(RejectionCode.DuplicateDeclarationName, &module, Span.make(34, 39))
  relocated.related = Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(&module), span: Span.make(3, 8)})
  let relocatedShared = run Shared<Rejection>.make(move relocated)
  let mut relatedLine = run Bytes.copy(Bytes.asSlice(&repeatedLine))
  run Bytes.append(&mut relatedLine, b"\n  note: src/Main.silk:1:4: related location")
  run Testing.expect(
    renders(&run Report.render(&relocatedShared, repeatedSource, b"src/Main.silk"), Bytes.asSlice(&relatedLine)),
    "a related site renders as a located note after the diagnostic line",
  )
  // A related site at the diagnostic's own line and column adds no note.
  let mut samePlace = run Rejections.make(RejectionCode.DuplicateDeclarationName, &module, Span.make(34, 39))
  samePlace.related = Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(&module), span: Span.make(34, 36)})
  let samePlaceShared = run Shared<Rejection>.make(move samePlace)
  run Testing.expect(
    renders(&run Report.render(&samePlaceShared, repeatedSource, b"src/Main.silk"), Bytes.asSlice(&repeatedLine)),
    "a related site at the diagnostic's own position renders no note",
  )
  // A place span fills a `{spelling}` hole past a leading `move`: a move names the whole place and
  // an assignment its root binding; a span that is not a place renders the meaning.
  let places = String.utf8Bytes("fn f() -> i32 { take(move b.v) a[0] = 1 return take(c) }\n")
  let moved = run Rejections.make(RejectionCode.UseAfterMove, &module, Span.make(21, 29))
  let assigned = run Rejections.make(RejectionCode.ImmutableAssignment, &module, Span.make(31, 35))
  let called = run Rejections.make(RejectionCode.ExplicitMoveRequired, &module, Span.make(47, 54))
  let mut movedLine = Bytes.make()
  run Bytes.append(&mut movedLine, b"src/Main.silk:1:22: error[OWN0001] ")
  run appendFilled(&mut movedLine, String.utf8Bytes(Catalog.template(Code.UseAfterMove, usize.ZERO)), b"b.v")
  let mut assignedLine = Bytes.make()
  run Bytes.append(&mut assignedLine, b"src/Main.silk:1:32: error[SEM0035] ")
  run appendFilled(&mut assignedLine, String.utf8Bytes(Catalog.template(Code.ImmutableAssignment, usize.ZERO)), b"a")
  let movedShared = run Shared<Rejection>.make(move moved)
  let assignedShared = run Shared<Rejection>.make(move assigned)
  let calledShared = run Shared<Rejection>.make(move called)
  run Testing.expect(
    renders(&run Report.render(&movedShared, places, b"src/Main.silk"), Bytes.asSlice(&movedLine))
      && renders(&run Report.render(&assignedShared, places, b"src/Main.silk"), Bytes.asSlice(&assignedLine))
      && renders(
        &run Report.render(&calledShared, places, b"src/Main.silk"),
        Bytes.asSlice(&run meaningLine(b"src/Main.silk:1:48: error[OWN0003] ", Code.ExplicitMoveRequired))
      ),
    "a place span fills the spelling hole with its place or root binding; a call span renders the meaning",
  )
  // Arguments the producer supplies fill holes by name.
  let mut typed = run Rejections.make(RejectionCode.ReturnTypeMismatch, &module, Span.make(17, 18))
  run List<MessageArgument>.append(&mut typed.arguments, MessageArgument {name: run Bytes.copy(b"expected"), value: run Bytes.copy(b"bool")})
  run List<MessageArgument>.append(&mut typed.arguments, MessageArgument {name: run Bytes.copy(b"actual"), value: run Bytes.copy(b"i32")})
  let mut returned = Bytes.make()
  run Bytes.append(&mut returned, b"src/Main.silk:2:3: error[SEM0129] ")
  run appendFilledArguments(&mut returned, String.utf8Bytes(Catalog.template(Code.ReturnTypeMismatch, usize.ZERO)), b"bool", b"i32")
  let typedShared = run Shared<Rejection>.make(move typed)
  run Testing.expect(
    renders(&run forwardedRender(&typedShared, source, b"src/Main.silk"), Bytes.asSlice(&returned)),
    "named arguments fill their holes through a forwarded shared rejection",
  )
  // A code with several templates fills the one its `template` argument chooses (SEM0195).
  let mut collision = run Rejections.make(RejectionCode.InvalidInherentMember, &module, Span.make(17, 18))
  run List<MessageArgument>.append(&mut collision.arguments, MessageArgument {name: run Bytes.copy(b"collidesWith"), value: run Bytes.copy(b"field")})
  run List<MessageArgument>.append(&mut collision.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"2")})
  run List<MessageArgument>.append(&mut collision.arguments, MessageArgument {name: run Bytes.copy(b"owner"), value: run Bytes.copy(b"Point")})
  run List<MessageArgument>.append(&mut collision.arguments, MessageArgument {name: run Bytes.copy(b"member"), value: run Bytes.copy(b"x")})
  let collisionShared = run Shared<Rejection>.make(move collision)
  let mut mapping = run Rejections.make(RejectionCode.InvalidInherentMember, &module, Span.make(17, 18))
  run List<MessageArgument>.append(&mut mapping.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"0")})
  run List<MessageArgument>.append(&mut mapping.arguments, MessageArgument {name: run Bytes.copy(b"owner"), value: run Bytes.copy(b"Point")})
  run List<MessageArgument>.append(&mut mapping.arguments, MessageArgument {name: run Bytes.copy(b"member"), value: run Bytes.copy(b"origin")})
  let mappingShared = run Shared<Rejection>.make(move mapping)
  let unchosen = run Rejections.make(RejectionCode.InvalidInherentMember, &module, Span.make(17, 18))
  let unchosenShared = run Shared<Rejection>.make(move unchosen)
  let unchosenLine = run meaningLine(b"src/Main.silk:2:3: error[SEM0195] ", Code.InvalidInherentMember)
  run Testing.expect(
    renders(&run Report.render(&collisionShared, source, b"src/Main.silk"), b"src/Main.silk:2:3: error[SEM0195] Point.x collides with the field x of Point")
      && renders(&run Report.render(&mappingShared, source, b"src/Main.silk"),
        b"src/Main.silk:2:3: error[SEM0195] impl Point cannot map origin to another declaration; only a conformance maps operations")
      && renders(&run Report.render(&unchosenShared, source, b"src/Main.silk"), Bytes.asSlice(&unchosenLine)),
    "a chosen template fills its holes; without a choice the catalog meaning renders",
  )
  // A refusal has no catalog code and is not a catalog diagnostic.
  let refusal = run Rejections.make(RejectionCode.Unsupported, &module, Span.make(17, 18))
  let refusalShared = run Shared<Rejection>.make(move refusal)
  let refused = match move run Report.render(&refusalShared, source, b"src/Main.silk") {
    Option<Bytes>.Some { .. } => false
    Option<Bytes>.None => true
  }
  run Testing.expect(refused, "a refusal does not render as a catalog diagnostic")
}

test effect fn fieldsLocateTheSameModuleRelatedSite() -> ()
  ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run relatedClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn relatedClaims() -> ()
  ! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let module = run ModuleId.make(b"project", b"probe", b"Main")
  let other = run ModuleId.make(b"project", b"probe", b"Other")
  let source = String.utf8Bytes("struct A {}\nstruct A {}\n")
  let mut local = run Rejections.make(
    RejectionCode.DuplicateDeclarationName,
    &module,
    Span.make(19, 20)
  )
  local.related = Option<
    RelatedSite
  >.some(RelatedSite { module: ModuleId.copy(&module), span: Span.make(7, 8) })
  let mut foreign = run Rejections.make(
    RejectionCode.DuplicateDeclarationName,
    &module,
    Span.make(19, 20)
  )
  foreign.related = Option<
    RelatedSite
  >.some(RelatedSite { module: ModuleId.copy(&other), span: Span.make(7, 8) })
  let mut located = false
  let localShared = run Shared<Rejection>.make(move local)
  if let Option<Report.RenderedDiagnostic>.Some {
    value
  } = move run Report.fields(&localShared, source, b"src/Main.silk") {
    let related = List<Report.RelatedLocation>.asSlice(&value.related)
    located = value.line == 2 && value.column == 8 && related.length == usize.ONE
      && related[0].line == usize.ONE
      && related[0].column == 8
      && related[0].start == 7
      && related[0].end == 8
  }
  let foreignShared = run Shared<Rejection>.make(move foreign)
  let unlocated = match move run Report.fields(&foreignShared, source, b"src/Main.silk") {
    Option<Report.RenderedDiagnostic>.Some {
      value
    } => List<Report.RelatedLocation>.length(&value.related) == usize.ZERO
    Option<Report.RenderedDiagnostic>.None => false
  }
  run Testing.expect(
    located && unlocated,
    "a related site in the same module is located; one in another module needs that module's source"
  )
}
