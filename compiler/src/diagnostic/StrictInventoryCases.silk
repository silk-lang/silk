//! Executable source-provider controls for the shipped strict census.
import diagnostic.StrictInventory
import diagnostic.StrictInventoryResult as Codec {SweepPins, Fact, Phase}
import diagnostic_main as Entry
import driver.ModuleSources as Sources {InvalidBuildComposition, InvalidSourceRoot}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.Semantic {Semantic}
import semantic.Target {Target, Id as TargetId}
import semantic.FinalProfile {FinalProfile}
import semantic.InitialProfile {Problem as InitialProblem}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.filesystem {FileSystem, FileError, Path}
import silk.json_value {Json}
import silk.json_scanner {JsonError}
import silk.option {Option}
import silk.os_filesystem {OsFileSystem}
import silk.sha2 {Sha256}
import silk.testing {Testing, AssertionError}
import silk.toml_scanner {TomlError}
import silk.usize

fn contains(text: &[u8], needle: &[u8]) -> bool {
  if text.length < needle.length { return false }
  let mut at = usize.ZERO
  while at <= text.length - needle.length {
    let mut matches = true
    let mut byte = usize.ZERO
    while byte < needle.length {
      if text[at + byte] != needle[byte] { matches = false }
      byte = byte + usize.ONE
    }
    if matches { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn write(root: &Path, name: string, source: &[u8]) -> ()
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let path = run Path.join(root, name)
  return run FileSystem.writeFile(&path, source)
}

effect fn pins() -> SweepPins ! OutOfMemoryError ? &mut Allocator {
  return SweepPins {producerFile: run Bytes.copy(b"/diagnostic-test"), producerDigest: Sha256.hash(b"separate diagnostic producer"), seedReceipt: run Bytes.copy(b"{\"fixture\":true}"), seedDigest: Sha256.hash(b"{\"fixture\":true}"), optimization: run Bytes.copy(b"speed"), debug: false}
}

test effect fn strictSweepPublishesUnusedImportsAndCyclesBeforeFinalIndependentPhases() -> ()
! FileError | InvalidModulePath | InvalidSourceRoot | InvalidBuildComposition | TomlError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make(b"/") |> Effect.provideMut<Allocator>(&mut allocator)
  return run closureClaims() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn closureClaims() -> ()
! FileError | InvalidModulePath | InvalidSourceRoot | InvalidBuildComposition | TomlError | OutOfMemoryError | AssertionError<'static>
? &mut FileSystem | &mut Allocator {
  let parent = run Path.make("/tmp")
  let temp = run FileSystem.temporaryDirectory(&parent, "silk-strict-closure-")
  let root = &temp.path
  run write(root, "main.silk", b"import child\nstruct A {}\nstruct B {}\nimpl A { fn same() -> i32 { return 1 } }\nimpl B { fn same() -> i32 { return 2 } }\ninterface Contract { fn absent() -> i32 }\nfn refused() -> i32 { return missing }\nstatic if false { fn inactive() -> i32 { return 3 } }\n")
  run write(root, "child.silk", b"import main\nimport unused\nfn child() -> i32 { return 4 }\n")
  run write(root, "unused.silk", b"fn unused() -> i32 { return 5 }\n")
  let source = run Path.join(root, "main.silk")
  let mut sources = run Sources.make(&source, Option.none<Path>())
  let mut semantic = Semantic.make(run Sources.revision(&sources), Target.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let sweep = run StrictInventory.collect(&mut sources, &mut semantic)
  let encoded = run StrictInventory.encode(&sweep, &sources, &run pins())
  let text = Bytes.asSlice(&encoded)
  run Testing.expect(sweep.complete && !sweep.strictSuccess && sweep.functions == 7 && sweep.records == 14 && sweep.passes >= 2 && StrictInventory.exitCode(&sweep) == 2,
    "three canonical import-cycle modules publish before a complete seven-function two-phase census, whose real refusals stay red")
  run Testing.expect(contains(text, b"\"coverage_complete\":true,\"strict_success\":false,\"modules\":3,\"functions\":7,\"records\":14,\"expected_records\":14") && !contains(text, b"MissingModule"),
    "transient missing import results are discarded only after actual bytes arrive; final counts are exact")
  run Testing.expect(contains(text, b"\"name\":\"A\"") && contains(text, b"\"name\":\"B\"") && contains(text, b"\"eligibility\":\"no-body\"") && contains(text, b"\"eligibility\":\"inactive\"") && contains(text, b"\"phase\":\"body\",\"eligibility\":\"eligible\",\"has_body\":true,\"fact\":{\"kind\":\"rejected\""),
    "same-named owners remain separate; Body refusal, inactivity and no-body metadata survive independent Signature facts")
  run FileSystem.release(move temp)
  return ()
}

test effect fn strictSweepEntryAndPackageIdentityOverrideSpellingWithoutInventingIds() -> ()
! FileError | InvalidModulePath | InvalidSourceRoot | InvalidBuildComposition | TomlError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make(b"/") |> Effect.provideMut<Allocator>(&mut allocator)
  return run identityClaims() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn identityClaims() -> ()
! FileError | InvalidModulePath | InvalidSourceRoot | InvalidBuildComposition | TomlError | OutOfMemoryError | AssertionError<'static>
? &mut FileSystem | &mut Allocator {
  let parent = run Path.make("/tmp")
  let temp = run FileSystem.temporaryDirectory(&parent, "silk-strict-identity-")
  run write(&temp.path, "silk.toml", b"[package]\nname = \"fixture\"\nroot = \"main.silk\"\n")
  let silk = run Path.join(&temp.path, "silk")
  run FileSystem.createDirectory(&silk)
  run write(&silk, "entry.silk", b"fn present() -> i32 { return 1 }\n")
  let source = run Path.join(&silk, "entry.silk")
  let sources = run Sources.make(&source, Option.none<Path>())
  let entry = Sources.entry(&sources)
  let foreignPackage = run ModuleId.make(ModuleId.sourceOrigin(entry), b"different-package", ModuleId.logicalPath(entry))
  let foreignOrigin = run ModuleId.make(b"different-origin", ModuleId.packageIdentity(entry), ModuleId.logicalPath(entry))
  let library = run ModuleId.make(ModuleId.sourceOrigin(entry), ModuleId.packageIdentity(entry), b"silk/library.silk")
  let location = run Sources.sourceLocation(&sources, entry)
  let correctPath = match &location.path { Option<Path>.Some {value} => Path.rawBytes(&value).length == Path.rawBytes(&source).length && contains(Path.rawBytes(&value), Path.rawBytes(&source)) _ => false }
  run Testing.expect(StrictInventory.compilerSubject(&sources, entry) && correctPath && !StrictInventory.compilerSubject(&sources, &foreignPackage) && !StrictInventory.compilerSubject(&sources, &foreignOrigin) && !StrictInventory.compilerSubject(&sources, &library),
    "the direct entry remains a compiler subject even under silk/; same-path foreign origin/package and same-package stdlib route remain distinct")
  run FileSystem.release(move temp)
  return ()
}

test effect fn strictSweepLaterBodyPublicationRestartsEarlierPhaseFacts() -> ()
! FileError | InvalidModulePath | InvalidSourceRoot | InvalidBuildComposition | TomlError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make(b"/") |> Effect.provideMut<Allocator>(&mut allocator)
  return run laterClaims() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn laterClaims() -> ()
! FileError | InvalidModulePath | InvalidSourceRoot | InvalidBuildComposition | TomlError | OutOfMemoryError | AssertionError<'static>
? &mut FileSystem | &mut Allocator {
  let parent = run Path.make("/tmp")
  let temp = run FileSystem.temporaryDirectory(&parent, "silk-strict-later-")
  run write(&temp.path, "main.silk", b"import helper as Helper\nfn earlier() -> u32 { return 1 }\nfn later() -> () { let value: Helper.Item }\n")
  run write(&temp.path, "helper.silk", b"import dependency as Dependency\npub struct Item {member: Dependency.Item}\npub static fn value() -> u32 { return 7 }\n")
  run write(&temp.path, "dependency.silk", b"pub struct Item {value: u32}\npub static fn value() -> u32 { return 7 }\n")
  let source = run Path.join(&temp.path, "main.silk")
  let mut sources = run Sources.make(&source, Option.none<Path>())
  let mut semantic = Semantic.make(run Sources.revision(&sources), Target.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let sweep = run StrictInventory.collect(&mut sources, &mut semantic)
  let encoded = run StrictInventory.encode(&sweep, &sources, &run pins())
  run Testing.expect(sweep.complete && sweep.functions == 4 && sweep.records == 8 && sweep.passes >= 2 && sweep.phasePublications > usize.ZERO && !contains(Bytes.asSlice(&encoded), b"MissingModule"),
    "a later Body local type publishes a nested nominal dependency after earlier Signature/Body facts; only a fresh globally stable pass is retained")
  run FileSystem.release(move temp)
  return ()
}

test effect fn strictSweepMissingRequiredSourceNeverSealsCompleteCounts() -> ()
! FileError | InvalidModulePath | InvalidSourceRoot | InvalidBuildComposition | TomlError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make(b"/") |> Effect.provideMut<Allocator>(&mut allocator)
  return run missingClaims() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn missingClaims() -> ()
! FileError | InvalidModulePath | InvalidSourceRoot | InvalidBuildComposition | TomlError | OutOfMemoryError | AssertionError<'static>
? &mut FileSystem | &mut Allocator {
  let parent = run Path.make("/tmp")
  let temp = run FileSystem.temporaryDirectory(&parent, "silk-strict-missing-")
  run write(&temp.path, "main.silk", b"import absent\nfn present() -> i32 { return 1 }\n")
  let source = run Path.join(&temp.path, "main.silk")
  let mut sources = run Sources.make(&source, Option.none<Path>())
  let mut semantic = Semantic.make(run Sources.revision(&sources), Target.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let sweep = run StrictInventory.collect(&mut sources, &mut semantic)
  let encoded = run StrictInventory.encode(&sweep, &sources, &run pins())
  run Testing.expect(!sweep.complete && StrictInventory.exitCode(&sweep) == 3 && contains(Bytes.asSlice(&encoded), b"\"status\":\"missing-source\"") && contains(Bytes.asSlice(&encoded), b"\"record\":\"import\"") && contains(Bytes.asSlice(&encoded), b"\"modules\":null,\"functions\":null"),
    "permanent absent imports preserve original import rejection and exact absent module mapping without complete counts")
  run FileSystem.release(move temp)
  return ()
}

test effect fn strictSweepLibraryInputsDoNotBecomeCompilerPhaseSubjects() -> ()
! FileError | InvalidModulePath | InvalidSourceRoot | InvalidBuildComposition | TomlError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make(b"/") |> Effect.provideMut<Allocator>(&mut allocator)
  return run libraryClaims() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn libraryClaims() -> ()
! FileError | InvalidModulePath | InvalidSourceRoot | InvalidBuildComposition | TomlError | OutOfMemoryError | AssertionError<'static>
? &mut FileSystem | &mut Allocator {
  let parent = run Path.make("/tmp")
  let temp = run FileSystem.temporaryDirectory(&parent, "silk-strict-library-")
  let library = run Path.join(&temp.path, "silk")
  run FileSystem.createDirectory(&library)
  run write(&temp.path, "main.silk", b"import silk.library\nfn present() -> i32 { return 1 }\n")
  run write(&library, "library.silk", b"fn libraryOnly() -> i32 { return missing }\n")
  let source = run Path.join(&temp.path, "main.silk")
  let libraryRoot = run Path.fromBytes(Path.rawBytes(&temp.path))
  let mut sources = run Sources.make(&source, Option.some<Path>(move libraryRoot))
  let mut semantic = Semantic.make(run Sources.revision(&sources), Target.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let sweep = run StrictInventory.collect(&mut sources, &mut semantic)
  let encoded = run StrictInventory.encode(&sweep, &sources, &run pins())
  run Testing.expect(sweep.complete && sweep.strictSuccess && sweep.functions == 1 && sweep.records == 2 && StrictInventory.exitCode(&sweep) == 0 && contains(Bytes.asSlice(&encoded), b"\"role\":\"stdlib-input\"") && !contains(Bytes.asSlice(&encoded), b"\"name\":\"libraryOnly\""),
    "library source SHA and canonical module are inputs while only compiler modules contribute phase subjects")
  run FileSystem.release(move temp)
  return ()
}

test effect fn strictSweepUsesExactReceiptBooleanAndRejectsGenericSuccess() -> ()
! JsonError | Entry.InvalidInventoryInput | InitialProblem | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run profileClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn profileClaims() -> ()
! JsonError | Entry.InvalidInventoryInput | InitialProblem | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let receipt = run Json.parse(b"{\"profile\":{\"target\":\"x86_64-unknown-linux-gnu\",\"optimization\":\"speed\",\"debug\":true}}")
  let profile = run Entry.profile(&receipt)
  let flag = FinalProfile.flag(&profile, b"debug")
  run Testing.expect(Option.unwrapOr<bool>(move flag, false) && !StrictInventory.successful(&Fact.WrongValue, Phase.Body) && !StrictInventory.successful(&Fact.QueryError {code: b"cycle"}, Phase.Signature),
    "the consumed explicit debug=true survives instead of silently becoming the speed/debug=false CLI default; wrong values and cycles never succeed")
  return ()
}
