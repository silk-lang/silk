    Code.ContractRowInference => {
      if choice == 1 {
        return "Requirement row does not contain &mut {capability}@{role}"
      }
      if choice == 2 {
        return "Requirement row does not contain &{capability}@{role}"
      }
      if choice == 3 {
        return "Requirement {capability} has role {actual}, expected {expected}"
      }
      if choice == 4 {
        return "Requirement {capability}@{role} has access {actual}, expected {expected}"
      }
      if choice == 5 {
        return "Requirement row remainder is ambiguous across {parameters}"
      }
      if choice == 6 {
        return "Requirement row specialization is not finite and concrete"
      }
      return "Failure type does not contain selected member {member}"
    }
