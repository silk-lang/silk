/// The one-line meaning of `code`; empty where the bootstrap documents none.
pub fn meaning(code: Code) -> string<'static> {
  return match code {
    Code.WordLiteralOutOfRange => "Stable code for an exact `usize` or `isize` literal outside the selected target word."
    Code.UnsupportedBytes => "Stable diagnostic code for a maximal unsupported byte region."
    Code.UnknownLiteralModifier => "Stable code for an identifier-like modifier outside the closed literal vocabulary."
    Code.UnterminatedStaticLiteral => "Stable code for a literal whose matching closing delimiter is absent."
    Code.MissingBaseDigits => "Stable code for an integer-literal base prefix that no digit follows."
    Code.InvalidDigitSeparator => "Stable code for a number-literal digit separator outside a position between two digits."
    Code.MissingExponentDigits => "Stable code for a float-literal exponent marker that no exponent digit follows."
    Code.CharacterLiteralScalarCount => "Stable code for a character literal that denotes a number of scalars other than one."
    Code.InvalidDurationAmount => "Stable code for a duration component amount that is not a whole decimal integer."
    Code.UnknownDurationUnit => "Stable code for an identifier-like suffix outside the duration unit vocabulary."
    Code.RepeatedDurationUnit => "Stable code for a duration unit repeated within one compact literal."
    Code.OutOfOrderDurationUnit => "Stable code for duration components that do not descend from larger to smaller units."
    Code.SubordinateDurationOutOfRange => "Stable code for a subordinate duration component outside its canonical field bound."
    Code.UnknownModule => "Stable code for an import naming a module absent from the supplied sources."
    Code.SelfImport => "Stable code for an import redundantly naming its own containing module."
    Code.UseAfterMove => "Stable code for a use of a binding after its consuming move."
    Code.PartialMove => ""
    Code.ExplicitMoveRequired => ""
    Code.OverlappingAssignment => ""
    Code.IncompatibleLoopHeader => ""
    Code.MatchBorrowEscape => ""
    Code.ExclusiveMatchRequiresMutable => ""
    Code.GuardConsumesPattern => ""
    Code.InvalidMatchScrutineePlace => ""
    Code.ConflictingViewLoan => ""
    Code.OwnerAccessDuringLoan => ""
    Code.BorrowedMove => ""
    Code.StoredCallableInvocationAccess => "Stable code for invoking a stored callable through too weak an aggregate receiver access."
    Code.StoredEffectRunAccess => "Stable code for running a stored Effect through too weak an aggregate receiver access."
    Code.LocalSharedAccessEscape => "Stable code for an access-scoped local-shared borrow escaping or crossing suspension."
    Code.ExecutableBorrowEscape => "Stable code for returning a callable or Effect that borrows storage owned by the returning function."
    Code.ExpiredLifetime => "A borrowed value is used beyond the validity of its referent."
    Code.MissingToken => "Stable code for one required token that is absent at its insertion position."
    Code.UnexpectedTokens => "Stable code for one maximal region of unexpected concrete tokens."
    Code.ReservedTemplateSyntax => "Stable code for a primary-expression template start reserved for future support."
    Code.ReservedImportBinding => "Stable code for an import whose reserved final path segment cannot form an implicit binding."
    Code.ExpressionNestingLimitExceeded => "Stable code for an expression child beyond the parser's supported nesting depth."
    Code.UnknownType => "Stable code for a present return-type name that is not a bootstrap built-in."
    Code.IntegerOutOfRange => "Stable code for a literal outside its selected integer range."
    Code.DuplicateDeclarationName => "Stable code for a present declaration name repeated after its first occurrence."
    Code.UnknownFunction => "Stable code for a present call name with no matching top-level declaration."
    Code.DuplicateParameterName => "Stable code for a present parameter name repeated after its first occurrence."
    Code.UnknownValueReference => "Stable code for a present value name with no matching local declaration."
    Code.WrongCallArity => "Stable code for a uniquely resolved call with the wrong number of arguments."
    Code.RebindingName => "Stable code for a binding whose name repeats a parameter or an earlier binding."
    Code.UnknownActor => "Stable code for a qualified call naming an unknown built-in actor."
    Code.UnknownActorOperation => "Stable code for a known actor called with an unknown operation name."
    Code.ConditionNotBool => "Stable code for a conditional whose condition is not `bool`."
    Code.ArgumentTypeMismatch => "Stable code for a call argument whose type mismatches its parameter."
    Code.UnknownImportedMember => ""
    Code.InaccessibleImportedMember => ""
    Code.BindingConflict => ""
    Code.DuplicateFieldName => ""
    Code.ExpectedType => ""
    Code.PrivateTypeExposure => ""
    Code.InlineRecursiveAggregate => ""
    Code.InaccessibleStructConstruction => ""
    Code.UnknownStructField => ""
    Code.DuplicateStructInitializer => ""
    Code.MissingStructInitializer => ""
    Code.StructFieldTypeMismatch => ""
    Code.ProjectionOnNonStruct => ""
    Code.UnknownProjectedField => ""
    Code.InaccessibleProjectedField => ""
    Code.EmptyArrayNeedsContext => ""
    Code.ArrayElementTypeMismatch => ""
    Code.ArrayLengthMismatch => ""
    Code.IndexOnNonArray => ""
    Code.IndexNotUsize => ""
    Code.IndexOutOfBounds => ""
    Code.ImmutableAssignment => ""
    Code.InvalidAssignmentPlace => ""
    Code.AssignmentTypeMismatch => ""
    Code.TransferOutsideLoop => ""
    Code.InvalidUnionMember => ""
    Code.IncompatibleUnionConversion => ""
    Code.MatchScrutineeNotNominal => ""
    Code.MatchMemberNotInScrutinee => ""
    Code.UnreachableMatchArm => ""
    Code.IncompleteMatch => ""
    Code.MatchGuardNotBool => ""
    Code.MissingPatternField => ""
    Code.DuplicatePatternField => ""
    Code.PatternBindingConflict => ""
    Code.IncompatibleMatchResults => ""
    Code.DuplicateTypeParameter => ""
    Code.TypeArgumentArity => ""
    Code.TypeArgumentInference => ""
    Code.PolymorphicRecursion => ""
    Code.InvalidBorrowOperand => "Stable code for an operand that cannot form a borrowed view."
    Code.ExclusiveBorrowRequiresMutable => ""
    Code.InvalidReborrow => "Stable code for an exclusive reborrow of a shared reference or slice."
    Code.ImplicitSliceDecay => ""
    Code.UsizeNegative => "Stable code for a negative decimal literal contextualized as unsigned `usize`."
    Code.InvalidFailureType => "Stable code for a type that cannot inhabit an Effect failure channel."
    Code.FailureChannelOnOrdinary => "Stable code for a failure channel attached to an ordinary function."
    Code.FailOutsideEffect => ""
    Code.UndeclaredFailure => ""
    Code.RunNonEffect => ""
    Code.UnhandledEffectFailures => ""
    Code.InvalidEffectHandler => ""
    Code.MutableEffectRecipe => ""
    Code.InvalidRequirementType => "Stable code for a non-concrete or non-nominal capability in a requirement row."
    Code.UnhandledEffectRequirements => ""
    Code.InvalidEffectProvision => ""
    Code.NonCallableApplication => ""
    Code.IncompatibleCallableSignature => ""
    Code.InvalidCallableInvocationAccess => ""
    Code.RedundantUnaryEmptyCall => ""
    Code.CallableIdentityErasure => ""
    Code.UnknownOwnedCallableReturn => ""
    Code.MissingUnsafeBoundary => "Stable code for a raw storage operation outside lexical unsafe authority."
    Code.InvalidConformance => "Stable code for an invalid source-declared capability implementation."
    Code.InvalidDropHook => "Stable code for a Drop implementation outside the compiler-sealed hook contract."
    Code.InvalidStaticLiteral => "Stable code for malformed escapes, invalid UTF-8, or non-byte literal values."
    Code.InvalidConstant => "Stable code for a typed constant whose type or literal is outside the constant contract."
    Code.ExpressionStatementResult => "Stable code for an expression statement whose result cannot be intentionally ignored."
    Code.GenericParameterKindMismatch => "Stable code for using a generic binder in a value, failure-row, or requirement-row position of another kind."
    Code.ContractRowInference => "Stable code for a failure or requirement row that cannot be finitely decomposed."
    Code.InvalidServiceDeclaration => "Stable code for storage, bodies, or defaults inside a source service contract."
    Code.IntrinsicTargetUnavailable => "Stable code for one reachable intrinsic unavailable on the requested execution target."
    Code.InvalidFloatLiteral => "Stable code for a float literal spelling no floating-point value can represent."
    Code.AmbiguousBoundOperation => "Stable code for a bound operation call whose receiver names more than one bounded parameter."
    Code.UninferredTypeParameter => "Stable code for one named type parameter left undetermined by an explicit prefix and the arguments."
    Code.TypeArgumentConflict => "Stable code for an explicit type argument contradicting the type its value arguments imply."
    Code.UnlowerableBoundWitness => "Stable code for a bound operation whose selected witness has no lowering."
    Code.StoredCallableConstruction => "Stable code for constructing an aggregate that stores a bare callable value."
    Code.ConflictingInitializerRepresentation => "Stable code for the first struct initializer that contradicts an inferred representation."
    Code.DivergentRepresentationJoin => "Stable code for the first exact representation that diverges at a static value join."
    Code.IncompatibleRepresentationBound => "Stable code for a representation argument whose contract cannot satisfy its required bound."
    Code.StoredRepresentedEffectConstruction => "Stable code for storing a represented Effect before its runtime layout is supported."
    Code.UnresolvedExactRepresentationItem => "Stable code for a `typeof` item that resolves to no declaration in scope."
    Code.AmbiguousExactRepresentationItem => "Stable code for a `typeof` item whose name belongs to more than one declaration."
    Code.UncallableExactRepresentationItem => "Stable code for a `typeof` item that names something other than an ordinary callable."
    Code.OpenExactRepresentationItem => "Stable code for a `typeof` item whose generic parameters are not all supplied."
    Code.PrivateExactRepresentationLeak => "Stable code for a public contract exposing the exact identity of a private item."
    Code.DivergentOpaqueRealization => "Stable code for one opaque producer specialization yielding multiple exact identities."
    Code.OpaqueRealizationCycle => "Stable code for an opaque family whose representation evidence contains no local construction."
    Code.InlineOpaqueLayoutCycle => "Stable code for an opaque realization whose inline captures contain that same family."
    Code.InvalidOpaqueResultBinder => "Stable code for an opaque result binder whose bound is not callable or Effect representation."
    Code.MissingOpaqueRealization => "Stable code for an opaque producer whose reachable returns establish no representation."
    Code.BodylessOpaqueResult => "Stable code for an opaque result declared where no producer body can establish its identity."
    Code.OverlappingConformance => "Stable code for two conformance heads that may name one provider under one interface."
    Code.NonTerminatingConformance => "Stable code for a conformance requirement that does not descend toward a base witness."
    Code.UnprovenConformance => "Stable code for a concrete specialization whose conditional requirements cannot be proved."
    Code.NonConcreteSpecialization => "Stable code for a complete application that reaches the instance frontier with open rows or evidence."
    Code.ProviderNoMatch => "Stable code for a provider that matches no member of its concrete source requirement row."
    Code.JointProviderSelectionConflict => "Stable code for provider relations sharing a selector but retaining disjoint candidate sets."
    Code.ProviderAmbiguity => "Stable code for provider selection that retains more than one common requirement member."
    Code.SelectedRowCardinality => "Stable code for an explicitly or independently selected row that is not exactly one member."
    Code.ProviderConformanceAmbiguity => "Stable code for a surviving provider candidate with more than one conformance witness."
    Code.InvalidProviderConformance => "Stable code for a surviving provider candidate whose conformance mapping is invalid."
    Code.ReturnTypeMismatch => "Stable code for an explicit return whose value violates the declaration result."
    Code.MissingReturn => "Stable code for a reachable non-unit function fallthrough."
    Code.ProviderAccessMismatch => "Stable code for a provider whose key matches but whose access cannot satisfy the requirement."
    Code.NonFiniteEffectJoin => "Stable code for an Effect join whose alternatives cannot be represented as a finite composite."
    Code.RefutableLetPattern => "Stable code for a refutable pattern in an unconditional local binding."
    Code.OperatorNotApplicable => "Stable code for operator syntax whose operator interface has no conformance accepting its operands."
    Code.AmbiguousOperator => "Stable code for operator syntax matched by more than one conformance of its operator interface."
    Code.MisplacedUnsafeAcknowledgement => "Stable code for an unsafe acknowledgement that does not complete an unsafe invocation."
    Code.LocalSharedLayoutMismatch => "Stable code for a statically known allocation/layout specialization mismatch."
    Code.UnsatisfiedExecutableProperty => "Stable code for a concrete executable that fails one sealed static-property obligation."
    Code.InvalidExecutablePropertyConjunct => "Stable code for an ordinary capability conjoined with one exact executable bound."
    Code.ExecutionLayoutMismatch => "Stable code for a statically known execution-package allocation/layout mismatch."
    Code.InvalidMutableParameter => "Stable code for `mut` where no mutable owned parameter storage exists."
    Code.DeferredCallableMutation => "Stable code for mutating an outer callable from a deferred effect recipe."
    Code.EmptyEnum => "Stable code for a scalar enum with no declared members."
    Code.UnsupportedEnumRepresentation => "Stable code for a scalar enum representation outside the fixed-width integer set."
    Code.DuplicateEnumMemberName => "Stable code for a scalar enum member name repeated after its first declaration."
    Code.DuplicateEnumDiscriminant => "Stable code for a scalar enum discriminant repeated after its first declaration."
    Code.EnumDiscriminantOutOfRange => "Stable code for an explicit scalar enum discriminant outside its representation range."
    Code.EnumImplicitDiscriminantOverflow => "Stable code for an implicit scalar enum successor outside its representation range."
    Code.UnsignedEnumNegativeDiscriminant => "Stable code for a negative discriminant under an unsigned scalar enum representation."
    Code.UnknownEnumMember => "Stable code for a member missing from a resolved scalar enum."
    Code.WrongEnumMember => "Stable code for a canonical member used through or required by another enum."
    Code.EnumIntegerMismatch => "Stable code for implicit mixing between a scalar enum and an integer."
    Code.CrossEnumEquality => "Stable code for equality between distinct canonical scalar enums."
    Code.EnumOrdering => "Stable code for direct ordering of scalar enum values."
    Code.IncompleteEnumMatch => "Stable code for a scalar enum match that leaves canonical members uncovered."
    Code.DuplicateEnumMatchArm => "Stable code for a repeated unguarded scalar enum member arm."
    Code.EnumMatchArmAfterWildcard => "Stable code for a scalar enum arm following an unguarded wildcard."
    Code.ForeignEnumPattern => "Stable code for a scalar enum pattern naming a member of another enum."
    Code.IntegerPatternAgainstEnum => "Stable code for an integer literal pattern used against a scalar enum."
    Code.EffectBlockReturnMismatch => "Stable code for effect-block return sites whose success types disagree."
    Code.EmptyNominalUnion => "Stable code for a nominal union declaration with no variants."
    Code.DuplicateUnionVariant => "Stable code for a repeated variant name within one nominal union."
    Code.EmptyUnionVariant => "Stable code for a named-field variant whose braces contain no field."
    Code.UnknownUnionVariant => "Stable code for a variant selector absent from its resolved nominal union."
    Code.ExpectedNominalUnion => "Stable code for a variant qualifier that does not name a nominal union."
    Code.InvalidNominalUnionConstruction => "Stable code for construction through an incomplete nominal union declaration."
    Code.DurationOutOfRange => "Stable code for a duration literal whose exact nanosecond total exceeds `u64`."
    Code.InvalidReferentProjection => "Stable code for postfix referent projection whose subject is not a reference."
    Code.TupleArityMismatch => "Stable code for positional construction with the wrong number of tuple elements."
    Code.ContextualAggregateKindMismatch => "Stable code for using tuple syntax with a named struct or record syntax with a tuple."
    Code.AnonymousAggregateJoinMismatch => "Stable code for attempting to join distinct anonymous aggregate occurrences."
    Code.PositionalFieldConstruction => "Stable code for attempting named-field construction of a positional aggregate."
    Code.StaticPhaseViolation => "Stable code for crossing from static evaluation into unavailable runtime work."
    Code.SelectedCompileError => "Stable code for a selected source-requested compile failure."
    Code.StaticEvaluationCycle => "Stable code for a cycle in one demanded static application."
    Code.StaticStepLimit => "Stable code for exhausting the static evaluator's deterministic step budget."
    Code.StaticCallDepthLimit => "Stable code for exhausting the static evaluator's logical call-depth budget."
    Code.StaticRetainedValueLimit => "Stable code for exhausting the static evaluator's retained-value budget."
    Code.StaticResidualGrowthLimit => "Stable code for exhausting the static evaluator's residual-growth budget."
    Code.CyclicTypeAlias => "Stable code for a type alias whose target resolves back through the alias itself."
    Code.TypeAliasParameters => "Stable code for a generic type alias parameter that is bounded, of an unsupported kind, or unused."
    Code.UnsupportedForeignAbi => "Stable code for a foreign function whose ABI string is not \"C\"."
    Code.ForeignFunctionRequiresUnsafe => "Stable code for a foreign function declared without the mandatory unsafe qualifier."
    Code.ForeignTypeNotAdmitted => "Stable code for a foreign parameter or result type outside the C-compatible scalar subset."
    Code.ForeignDeclarationRestriction => "Stable code for Silk-only contract syntax retained on a foreign function declaration."
    Code.ForeignFunctionNotFirstClass => "Stable code for using a foreign function as a first-class value rather than calling it."
    Code.InvalidForeignSymbol => "Stable code for a native symbol that is not an ASCII identifier."
    Code.ReservedForeignSymbol => "Stable code for a native symbol the compiler reserves for its own runtime or entry."
    Code.ConflictingForeignSignature => "Stable code for two reachable declarations of one symbol with different C signatures."
    Code.ForeignFunctionTargetUnavailable => "Stable code for one reachable foreign call unavailable on the requested execution surface."
    Code.InvalidInherentHead => "Stable code for an inherent impl head that is not the whole family of a module-local nominal."
    Code.InvalidInherentMember => "Stable code for an inherent impl member that cannot be an associated member."
    Code.DuplicateInherentMember => "Stable code for two inherent members of one owner sharing a name."
    Code.ImportedInherentMember => "Stable code for a selective import naming an inherent member as if it were a root declaration."
    Code.AssociatedFunctionOnValue => "Stable code for an associated function called on a value as though it had a receiver."
    Code.NestedAnonymousCallable => "Stable code for nesting one anonymous callable body inside another in the first language slice."
    Code.AmbiguousReceiverOperation => "Stable code for a receiver operation declared by more than one bound of one type parameter."
    Code.ExportSuspends => "Stable code for an `export \"C\"` function whose body may suspend."
    Code.AmbiguousSuppliedOperation => "Stable code for a receiver operation supplied by more than one of the receiver's conformances."
    Code.SuppliedOperationValue => "Stable code for naming a conformance-supplied receiver operation as a value instead of calling it."
    Code.GenericCLayoutRecord => "Stable code for a C-layout record that declares type parameters."
    Code.UnsupportedCLayoutField => "Stable code for a C-layout record field outside the closed C object subset."
    Code.InvalidForeignCallback => "Stable code for a value that cannot become an exact noncapturing C callback address."
    Code.ForeignStaticTargetUnavailable => "Stable code for reachable C data on an execution surface without native symbol linkage."
    Code.UnknownLifetime => "An explicit lifetime does not name a binder in its lexical header scope."
    Code.AmbiguousLifetimeElision => "An omitted output region has no unique declaration-level input relationship."
    Code.InvalidLifetimeBinder => "A lifetime binder or outlives bound has an unsupported declaration shape."
    Code.UnsatisfiedLifetimeBound => ""
    Code.UnsatisfiedTypeOutlives => ""
    Code.InvalidConfiguration => "Stable code for rejected profile inputs, package schemas, defaults, or predicates."
    Code.InvalidPointerQualifier => "Stable code for invalid raw-pointer alignment, address space, or qualifier conversion."
    Code.InvalidDiagnosticObserver => "A diagnostic observer callback lacks a complete direct-execution proof."
    Code.MissingDiagnosticContext => "Terminal observation is provably outside a selected failure handler."
    Code.InvalidTestDeclaration => "A `test` qualifier marks a function outside the finite executable test contract."
    Code.UnsupportedLowering => "Emitted code references a function instance whose valid body native lowering does not support yet."
    Code.RegionSelectiveConformance => "A sealed Drop or Copy head names `'static`, repeats one region, or bounds a region."
    Code.OwnerArgumentPlacement => "A member list follows an unwritten owner whose parameters the member uses (GEN-008)."
    Code.NamespaceQualifiedType => "Stable code for a namespace-qualified type named where a value is required (NAME-005)."
    Code.NonAliasResolutionCycle => "A non-alias resolution dependency cycle prevents resolving a declaration or value."
    Code.UnitVariantPayloadPattern => "A unit nominal-union variant is written with a braced payload pattern (PATT-021)."
  }
}

/// The number of complete message templates `code` can report.
