    Code.MisplacedDirective => "Stable code for a known directive written on a declaration that does not take it."
    Code.InvalidAtomicOperation => "Stable code for an atomic intrinsic call whose memory order or element type the operation does not admit."
    Code.ModuleQualifiedType => "Stable code for a type named through a module import in a value position."
    Code.InvalidVectorShape => "Stable code for a SIMD vector or mask shape, or SIMD operation type arguments or shuffle indices, that are not admitted."
    Code.OptionalExclusiveRequirement => "Stable code for a requirement on an optional service with exclusive access."
    Code.UnavailableArchOperation => "Stable code for an architecture intrinsic whose target or CPU feature the profile does not select."
    Code.UnknownFunctionFeature => "Stable code for a function `@features` entry that is not a CPU feature of the target."
    Code.FeatureFunctionRequiresUnsafe => "Stable code for a function with `features` that is not declared `unsafe`."
    Code.ForeignVectorUnavailable => "Stable code for a C signature vector that the target's C ABI passes in no vector register the profile selects."
    Code.UnspecializedLiteral => "Stable code for an anonymous function or `effect {}` block that native compilation cannot specialize yet: one in a `static for` body, or one run from a function with `static` parameters."
    Code.ModeBeforeTypeName => "Stable code for `mut` or `once` written before a type name other than `Effect`, such as `f: mut F`."
    Code.ConstantOverflow => "Stable code for runtime integer arithmetic over constant operands whose result is outside its type, so it always traps."
    Code.ConstantDivisionByZero => "Stable code for integer `/` or `%` whose right operand is the constant zero, so it always traps."
    Code.StaticArgumentsThroughCall => "Stable code for a call to a function with `static` parameters through an interface operation or method-call syntax where its static arguments cannot be selected yet, such as in a `static fn`."
    Code.ConflictingDirective => "Stable code for two directives on one declaration that cannot be written together: the same directive twice, or two of the inline hints `@inline`, `@inlineAlways`, `@inlineNever` and `@cold`."
  }
}

/// The number of complete message templates `code` can report.
pub fn templateCount(code: Code) -> usize {
  return match code {
    Code.UnsupportedBytes => usize.ONE
    Code.UnknownLiteralModifier => usize.ONE
    Code.UnterminatedStaticLiteral => usize.ONE
    Code.MissingBaseDigits => usize.ONE
    Code.InvalidDigitSeparator => usize.ONE
    Code.MissingExponentDigits => usize.ONE
    Code.CharacterLiteralScalarCount => usize.ONE
    Code.InvalidDurationAmount => usize.ONE
    Code.UnknownDurationUnit => usize.ONE
    Code.RepeatedDurationUnit => usize.ONE
    Code.OutOfOrderDurationUnit => usize.ONE
    Code.SubordinateDurationOutOfRange => usize.ONE
    Code.InvalidBaseDigit => usize.ONE
    Code.LiteralTypeSuffix => 2
    Code.UnknownModule => usize.ONE
    Code.SelfImport => usize.ONE
    Code.InternalModule => usize.ONE
    Code.ReservedModule => usize.ONE
    Code.AmbiguousModule => usize.ONE
    Code.BarrelSpelling => usize.ONE
    Code.UseAfterMove => usize.ONE
    Code.PartialMove => 2
    Code.ExplicitMoveRequired => 4
