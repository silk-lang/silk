    Code.UseAfterMove => Phase.Ownership
    Code.PartialMove => Phase.Ownership
    Code.ExplicitMoveRequired => Phase.Ownership
    Code.OverlappingAssignment => Phase.Ownership
    Code.IncompatibleLoopHeader => Phase.Ownership
    Code.MatchBorrowEscape => Phase.Ownership
    Code.ExclusiveMatchRequiresMutable => Phase.Ownership
    Code.GuardConsumesPattern => Phase.Ownership
    Code.InvalidMatchScrutineePlace => Phase.Ownership
    Code.ConflictingViewLoan => Phase.Ownership
    Code.OwnerAccessDuringLoan => Phase.Ownership
    Code.BorrowedMove => Phase.Ownership
