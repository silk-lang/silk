//! The diagnostic catalog: every stable code with its phase, meaning and message templates.
//!
//! # When to use
//! Use [`Code`] to name a reported condition. A producer chooses one code; a renderer fills the
//! chosen template's holes and never invents other wording.
//!
//! # Details
//! This catalog is the authoritative wording. `compiler/scripts/DiagnosticCatalog.mjs` checks that
//! every code has a unique spelling, a meaning and nonempty templates, and that every code has a
//! native producer or an explicit coverage gap. A template writes a hole as `{name}` and a literal
//! brace as `{{` or `}}`; a producer selects one of a code's templates by ordinal.

import silk.num.usize

/// The compiler phase that reports a code.
pub enum Phase {
  Lexical,
  Parser,
  Module,
  Semantic,
  Ownership,
}

/// One stable diagnostic code. Members are named after the bootstrap's code constants.
pub enum (u16) Code {
  /// LEX0001: Stable diagnostic code for a maximal unsupported byte region.
  UnsupportedBytes,
  /// LEX0002: Stable code for an identifier-like modifier outside the closed literal vocabulary.
  UnknownLiteralModifier,
  /// LEX0003: Stable code for a literal whose matching closing delimiter is absent.
  UnterminatedStaticLiteral,
  /// LEX0004: Stable code for an integer-literal base prefix that no digit follows.
  MissingBaseDigits,
  /// LEX0005: Stable code for a number-literal digit separator outside a position between two digits.
  InvalidDigitSeparator,
  /// LEX0006: Stable code for a float-literal exponent marker that no exponent digit follows.
  MissingExponentDigits,
  /// LEX0007: Stable code for a character literal that denotes a number of scalars other than one.
  CharacterLiteralScalarCount,
  /// LEX0008: Stable code for a duration component amount that is not a whole decimal integer.
  InvalidDurationAmount,
  /// LEX0009: Stable code for an identifier-like suffix outside the duration unit vocabulary.
  UnknownDurationUnit,
  /// LEX0010: Stable code for a duration unit repeated within one compact literal.
  RepeatedDurationUnit,
  /// LEX0011: Stable code for duration components that do not descend from larger to smaller units.
  OutOfOrderDurationUnit,
  /// LEX0012: Stable code for a subordinate duration component outside its canonical field bound.
  SubordinateDurationOutOfRange,
  /// LEX0013: Stable code for a digit or letter in a base-prefixed integer literal that is not a digit of its base.
  InvalidBaseDigit,
  /// LEX0014: Stable code for a numeric literal written with a type suffix such as `u8`, which Silk spells as a type annotation.
  LiteralTypeSuffix,
  /// MOD0001: Stable code for an import naming a module absent from the supplied sources.
  UnknownModule,
  /// MOD0002: Stable code for an import redundantly naming its own containing module.
  SelfImport,
  /// MOD0003: Stable code for an import of another package's module that its manifest does not export.
  InternalModule,
  /// MOD0004: Stable code for an import of the reserved `Intrinsic` module or a module below it other than `Intrinsic.application`; intrinsics are written `Intrinsic.<name>` without an import.
  ReservedModule,
  /// MOD0005: Stable code for an import path that names both a module file and a directory's `mod.silk` barrel file.
  AmbiguousModule,
  /// MOD0006: Stable code for an import that names a directory's `mod.silk` barrel file by its file name instead of the directory's path.
  BarrelSpelling,
  /// OWN0001: Stable code for a use of a binding after its consuming move.
  UseAfterMove,
  /// OWN0002
  PartialMove,
  /// OWN0003
  ExplicitMoveRequired,
  /// OWN0004
  OverlappingAssignment,
  /// OWN0005
  IncompatibleLoopHeader,
  /// OWN0006
  MatchBorrowEscape,
  /// OWN0007
  ExclusiveMatchRequiresMutable,
  /// OWN0008
  GuardConsumesPattern,
  /// OWN0009
  InvalidMatchScrutineePlace,
  /// OWN0010
  ConflictingViewLoan,
  /// OWN0011
  OwnerAccessDuringLoan,
  /// OWN0012
  BorrowedMove,
  /// OWN0014: Stable code for invoking a stored callable through too weak an aggregate receiver access.
  StoredCallableInvocationAccess,
  /// OWN0015: Stable code for running a stored Effect through too weak an aggregate receiver access.
  StoredEffectRunAccess,
  /// OWN0016: Stable code for an access-scoped local-shared borrow escaping or crossing suspension.
  LocalSharedAccessEscape,
  /// OWN0018: Stable code for returning a callable or Effect that borrows storage owned by the returning function.
  ExecutableBorrowEscape,
  /// OWN0019: A borrowed value is used beyond the validity of its referent.
  ExpiredLifetime,
  /// PAR0001: Stable code for one required token that is absent at its insertion position.
  MissingToken,
  /// PAR0002: Stable code for one maximal region of unexpected concrete tokens.
  UnexpectedTokens,
  /// PAR0003: Stable code for a primary-expression template start reserved for future support.
  ReservedTemplateSyntax,
  /// PAR0004: Stable code for an import whose reserved final path segment cannot form an implicit binding.
  ReservedImportBinding,
  /// PAR0005: Stable code for code nested deeper than the compiler supports.
  ExpressionNestingLimitExceeded,
  /// PAR0006: Stable code for a statement spelled `loop { ... }`, which Silk writes as `while true`.
  LoopStatement,
  /// PAR0007: Stable code for a type spelled `?T`, which Silk writes as `Option<T>`.
  OptionalTypeSyntax,
  /// PAR0008: Stable code for a type spelled `(A, B)`, which Silk declares as a named `tuple`.
  TupleTypeSyntax,
  /// PAR0009: Stable code for an `if` used as a value without a final `else`.
  IfExpression,
  /// PAR0010: Stable code for a spelling from another language that Silk writes differently, such
  /// as `+=`, `++`, `for ... in`, `var` or `c ? a : b`.
  ForeignSpelling,
  /// PAR0011: Stable code for a `with` clause after a declaration header, which Silk writes as
  /// directives before the declaration.
  WithClause,
  /// SEM0001: Stable code for a present return-type name that is not a bootstrap built-in.
  UnknownType,
  /// SEM0002: Stable code for a literal outside its selected integer range.
  IntegerOutOfRange,
  /// SEM0003: Stable code for a present declaration name repeated after its first occurrence.
  DuplicateDeclarationName,
  /// SEM0004: Stable code for a present call name with no matching top-level declaration.
  UnknownFunction,
  /// SEM0005: Stable code for a present parameter name repeated after its first occurrence.
  DuplicateParameterName,
  /// SEM0006: Stable code for a present value name with no matching local declaration.
  UnknownValueReference,
  /// SEM0007: Stable code for a uniquely resolved call with the wrong number of arguments.
  WrongCallArity,
  /// SEM0008: Stable code for a `let` whose name repeats an earlier binding in the same block; a body may rebind a parameter.
  RebindingName,
  /// SEM0009: Stable code for a qualified call naming an unknown built-in actor.
  UnknownActor,
  /// SEM0010: Stable code for a known actor called with an unknown operation name.
  UnknownActorOperation,
  /// SEM0011: Stable code for a conditional whose condition is not `bool`.
  ConditionNotBool,
  /// SEM0012: Stable code for a call argument whose type mismatches its parameter.
  ArgumentTypeMismatch,
  /// SEM0014
  UnknownImportedMember,
  /// SEM0015
  InaccessibleImportedMember,
  /// SEM0016
  BindingConflict,
  /// SEM0017
  DuplicateFieldName,
  /// SEM0018
  ExpectedType,
  /// SEM0019
  PrivateTypeExposure,
  /// SEM0020
  InlineRecursiveAggregate,
  /// SEM0021
  InaccessibleStructConstruction,
  /// SEM0022
  UnknownStructField,
  /// SEM0023
  DuplicateStructInitializer,
  /// SEM0024
  MissingStructInitializer,
  /// SEM0025
  StructFieldTypeMismatch,
  /// SEM0026
  ProjectionOnNonStruct,
  /// SEM0027
  UnknownProjectedField,
  /// SEM0028
  InaccessibleProjectedField,
  /// SEM0029
  EmptyArrayNeedsContext,
  /// SEM0030
  ArrayElementTypeMismatch,
  /// SEM0031
  ArrayLengthMismatch,
  /// SEM0032
  IndexOnNonArray,
  /// SEM0033
  IndexNotUsize,
  /// SEM0034
  IndexOutOfBounds,
  /// SEM0035
  ImmutableAssignment,
  /// SEM0036
  InvalidAssignmentPlace,
  /// SEM0037
  AssignmentTypeMismatch,
  /// SEM0038
  TransferOutsideLoop,
  /// SEM0039
  InvalidUnionMember,
  /// SEM0040
  IncompatibleUnionConversion,
  /// SEM0042
  MatchMemberNotInScrutinee,
  /// SEM0043
  UnreachableMatchArm,
  /// SEM0044
  IncompleteMatch,
  /// SEM0045
  MatchGuardNotBool,
  /// SEM0046
  MissingPatternField,
  /// SEM0047
  DuplicatePatternField,
  /// SEM0048
  PatternBindingConflict,
  /// SEM0049
  IncompatibleMatchResults,
  /// SEM0050
  DuplicateTypeParameter,
  /// SEM0051
  TypeArgumentArity,
  /// SEM0052
  TypeArgumentInference,
  /// SEM0053
  PolymorphicRecursion,
  /// SEM0056: Stable code for an operand that cannot form a borrowed view.
  InvalidBorrowOperand,
  /// SEM0057
  ExclusiveBorrowRequiresMutable,
  /// SEM0058: Stable code for an exclusive reborrow of a shared reference or slice.
  InvalidReborrow,
  /// SEM0059
  ImplicitSliceDecay,
  /// SEM0060: Stable code for a negative decimal literal contextualized as unsigned `usize`.
  UsizeNegative,
  /// SEM0061: Stable code for a type that cannot inhabit an Effect failure channel.
  InvalidFailureType,
  /// SEM0062: Stable code for a failure channel attached to an ordinary function.
  FailureChannelOnOrdinary,
  /// SEM0063
  FailOutsideEffect,
  /// SEM0064
  UndeclaredFailure,
  /// SEM0065
  RunNonEffect,
  /// SEM0066
  UnhandledEffectFailures,
  /// SEM0067
  InvalidEffectHandler,
  /// SEM0068
  MutableEffectRecipe,
  /// SEM0070: Stable code for a non-concrete or non-nominal capability in a requirement row.
  InvalidRequirementType,
  /// SEM0071
  UnhandledEffectRequirements,
  /// SEM0075
  NonCallableApplication,
  /// SEM0076
  IncompatibleCallableSignature,
  /// SEM0077
  InvalidCallableInvocationAccess,
  /// SEM0078
  RedundantUnaryEmptyCall,
  /// SEM0080
  CallableIdentityErasure,
  /// SEM0081
  UnknownOwnedCallableReturn,
  /// SEM0082: Stable code for a raw storage operation outside lexical unsafe authority.
  MissingUnsafeBoundary,
  /// SEM0083: Stable code for an invalid source-declared capability implementation.
  InvalidConformance,
  /// SEM0084: Stable code for a Drop implementation outside the compiler-sealed hook contract.
  InvalidDropHook,
  /// SEM0085: Stable code for malformed escapes, invalid UTF-8, or non-byte literal values.
  InvalidStaticLiteral,
  /// SEM0086: Stable code for a typed constant whose type or literal is outside the constant contract.
  InvalidConstant,
  /// SEM0087: Stable code for an expression statement whose result cannot be intentionally ignored.
  ExpressionStatementResult,
  /// SEM0088: Stable code for using a generic binder in a value, failure-row, or requirement-row position of another kind.
  GenericParameterKindMismatch,
  /// SEM0089: Stable code for a failure or requirement row that cannot be finitely decomposed.
  ContractRowInference,
  /// SEM0090: Stable code for storage or another non-operation member inside an interface or service.
  InvalidServiceDeclaration,
  /// SEM0093: Stable code for one reachable intrinsic unavailable on the requested execution target.
  IntrinsicTargetUnavailable,
  /// SEM0095: Stable code for a float literal spelling no floating-point value can represent.
  InvalidFloatLiteral,
  /// SEM0097: Stable code for a bound operation call whose receiver names more than one bounded parameter.
  AmbiguousBoundOperation,
  /// SEM0099: Stable code for one named type parameter left undetermined by an explicit prefix and the arguments.
  UninferredTypeParameter,
  /// SEM0100: Stable code for an explicit type argument contradicting the type its value arguments imply.
  TypeArgumentConflict,
  /// SEM0101: Stable code for a bound operation whose selected witness has no lowering.
  UnlowerableBoundWitness,
  /// SEM0103: Stable code for constructing an aggregate that stores a bare callable value.
  StoredCallableConstruction,
  /// SEM0104: Stable code for the first struct initializer that contradicts an inferred representation.
  ConflictingInitializerRepresentation,
  /// SEM0105: Stable code for the first exact representation that diverges at a static value join.
  DivergentRepresentationJoin,
  /// SEM0106: Stable code for a representation argument whose contract cannot satisfy its required bound.
  IncompatibleRepresentationBound,
  /// SEM0107: Stable code for storing a represented Effect before its runtime layout is supported.
  StoredRepresentedEffectConstruction,
  /// SEM0108: Stable code for a `typeof` item that resolves to no declaration in scope.
  UnresolvedExactRepresentationItem,
  /// SEM0109: Stable code for a `typeof` item whose name belongs to more than one declaration.
  AmbiguousExactRepresentationItem,
  /// SEM0110: Stable code for a `typeof` item that names something other than an ordinary callable.
  UncallableExactRepresentationItem,
  /// SEM0111: Stable code for a `typeof` item whose generic parameters are not all supplied.
  OpenExactRepresentationItem,
  /// SEM0112: Stable code for a public contract exposing the exact identity of a private item.
  PrivateExactRepresentationLeak,
  /// SEM0113: Stable code for one opaque producer specialization yielding multiple exact identities.
  DivergentOpaqueRealization,
  /// SEM0114: Stable code for an opaque family whose representation evidence contains no local construction.
  OpaqueRealizationCycle,
  /// SEM0115: Stable code for an opaque realization whose inline captures contain that same family.
  InlineOpaqueLayoutCycle,
  /// SEM0116: Stable code for an opaque result binder whose bound is not callable or Effect representation.
  InvalidOpaqueResultBinder,
  /// SEM0117: Stable code for an opaque producer whose reachable returns establish no representation.
  MissingOpaqueRealization,
  /// SEM0118: Stable code for an opaque result declared where no producer body can establish its identity.
  BodylessOpaqueResult,
  /// SEM0119: Stable code for two conformance heads that may name one provider under one interface.
  OverlappingConformance,
  /// SEM0120: Stable code for a conformance requirement that does not descend toward a base witness.
  NonTerminatingConformance,
  /// SEM0121: Stable code for a concrete specialization whose conditional requirements cannot be proved.
  UnprovenConformance,
  /// SEM0122: Stable code for a complete application that reaches the instance frontier with open rows or evidence.
  NonConcreteSpecialization,
  /// SEM0123: Stable code for a provider that matches no member of its concrete source requirement row.
  ProviderNoMatch,
  /// SEM0124: Stable code for provider relations sharing a selector but retaining disjoint candidate sets.
  JointProviderSelectionConflict,
  /// SEM0125: Stable code for provider selection that retains more than one common requirement member.
  ProviderAmbiguity,
  /// SEM0126: Stable code for an explicitly or independently selected row that is not exactly one member.
  SelectedRowCardinality,
  /// SEM0127: Stable code for a surviving provider candidate with more than one conformance witness.
  ProviderConformanceAmbiguity,
  /// SEM0128: Stable code for a surviving provider candidate whose conformance mapping is invalid.
  InvalidProviderConformance,
  /// SEM0129: Stable code for an explicit return whose value violates the declaration result.
  ReturnTypeMismatch,
  /// SEM0130: Stable code for a reachable non-unit function fallthrough.
  MissingReturn,
  /// SEM0131: Stable code for a provider whose key matches but whose access cannot satisfy the requirement.
  ProviderAccessMismatch,
  /// SEM0132: Stable code for an Effect join whose alternatives cannot be represented as a finite composite.
  NonFiniteEffectJoin,
  /// SEM0133: Stable code for a refutable pattern in an unconditional local binding.
  RefutableLetPattern,
  /// SEM0135: Stable code for operator syntax whose operator interface has no conformance accepting its operands.
  OperatorNotApplicable,
  /// SEM0136: Stable code for operator syntax matched by more than one conformance of its operator interface.
  AmbiguousOperator,
  /// SEM0137: Stable code for an unsafe acknowledgement that does not complete an unsafe invocation.
  MisplacedUnsafeAcknowledgement,
  /// SEM0138: Stable code for a statically known allocation/layout specialization mismatch.
  LocalSharedLayoutMismatch,
  /// SEM0139: Stable code for a concrete executable that fails one sealed static-property obligation.
  UnsatisfiedExecutableProperty,
  /// SEM0141: Stable code for an ordinary capability conjoined with one exact executable bound.
  InvalidExecutablePropertyConjunct,
  /// SEM0142: Stable code for a statically known execution-package allocation/layout mismatch.
  ExecutionLayoutMismatch,
  /// SEM0143: Stable code for `mut` where no mutable owned parameter storage exists.
  InvalidMutableParameter,
  /// SEM0145: Stable code for mutating an outer callable from a deferred effect recipe.
  DeferredCallableMutation,
  /// SEM0146: Stable code for a scalar enum with no declared members.
  EmptyEnum,
  /// SEM0147: Stable code for a scalar enum representation outside the fixed-width integer set.
  UnsupportedEnumRepresentation,
  /// SEM0148: Stable code for a scalar enum member name repeated after its first declaration.
  DuplicateEnumMemberName,
  /// SEM0149: Stable code for a scalar enum discriminant repeated after its first declaration.
  DuplicateEnumDiscriminant,
  /// SEM0150: Stable code for an explicit scalar enum discriminant outside its representation range.
  EnumDiscriminantOutOfRange,
  /// SEM0151: Stable code for an implicit scalar enum successor outside its representation range.
  EnumImplicitDiscriminantOverflow,
  /// SEM0152: Stable code for a negative discriminant under an unsigned scalar enum representation.
  UnsignedEnumNegativeDiscriminant,
  /// SEM0153: Stable code for a member missing from a resolved scalar enum.
  UnknownEnumMember,
  /// SEM0154: Stable code for a canonical member used through or required by another enum.
  WrongEnumMember,
  /// SEM0155: Stable code for implicit mixing between a scalar enum and an integer.
  EnumIntegerMismatch,
  /// SEM0156: Stable code for equality between distinct canonical scalar enums.
  CrossEnumEquality,
  /// SEM0157: Stable code for direct ordering of scalar enum values.
  EnumOrdering,
  /// SEM0158: Stable code for a scalar enum match that leaves canonical members uncovered.
  IncompleteEnumMatch,
  /// SEM0159: Stable code for a repeated unguarded scalar enum member arm.
  DuplicateEnumMatchArm,
  /// SEM0160: Stable code for a scalar enum arm following an unguarded wildcard.
  EnumMatchArmAfterWildcard,
  /// SEM0161: Stable code for a scalar enum pattern naming a member of another enum.
  ForeignEnumPattern,
  /// SEM0162: Stable code for an integer literal pattern used against a scalar enum.
  IntegerPatternAgainstEnum,
  /// SEM0163: Stable code for effect-block return sites whose success types disagree.
  EffectBlockReturnMismatch,
  /// SEM0164: Stable code for a nominal union declaration with no variants.
  EmptyNominalUnion,
  /// SEM0165: Stable code for a repeated variant name within one nominal union.
  DuplicateUnionVariant,
  /// SEM0166: Stable code for a named-field variant whose braces contain no field.
  EmptyUnionVariant,
  /// SEM0167: Stable code for a variant selector absent from its resolved nominal union.
  UnknownUnionVariant,
  /// SEM0168: Stable code for a variant qualifier that does not name a nominal union.
  ExpectedNominalUnion,
  /// SEM0169: Stable code for construction through an incomplete nominal union declaration.
  InvalidNominalUnionConstruction,
  /// SEM0170: Stable code for a duration literal whose exact nanosecond total exceeds `u64`.
  DurationOutOfRange,
  /// SEM0171: Stable code for postfix referent projection whose subject is not a reference.
  InvalidReferentProjection,
  /// SEM0172: Stable code for positional construction with the wrong number of tuple elements.
  TupleArityMismatch,
  /// SEM0173: Stable code for using tuple syntax with a named struct or record syntax with a tuple.
  ContextualAggregateKindMismatch,
  /// SEM0174: Stable code for attempting to join distinct anonymous aggregate occurrences.
  AnonymousAggregateJoinMismatch,
  /// SEM0175: Stable code for attempting named-field construction of a positional aggregate.
  PositionalFieldConstruction,
  /// SEM0176: Stable code for crossing from static evaluation into unavailable runtime work.
  StaticPhaseViolation,
  /// SEM0177: Stable code for a selected source-requested compile failure.
  SelectedCompileError,
  /// SEM0178: Stable code for a cycle in one demanded static application.
  StaticEvaluationCycle,
  /// SEM0179: Stable code for exhausting the static evaluator's deterministic step budget.
  StaticStepLimit,
  /// SEM0180: Stable code for exhausting the static evaluator's logical call-depth budget.
  StaticCallDepthLimit,
  /// SEM0181: Stable code for exhausting the static evaluator's retained-value budget.
  StaticRetainedValueLimit,
  /// SEM0182: Stable code for exhausting the static evaluator's residual-growth budget.
  StaticResidualGrowthLimit,
  /// SEM0183: Stable code for a type alias whose target resolves back through the alias itself.
  CyclicTypeAlias,
  /// SEM0184: Stable code for a generic type alias parameter that is bounded, of an unsupported kind, or unused.
  TypeAliasParameters,
  /// SEM0185: Stable code for a foreign function whose ABI string is not "C".
  UnsupportedForeignAbi,
  /// SEM0186: Stable code for a foreign function declared without the mandatory unsafe qualifier.
  ForeignFunctionRequiresUnsafe,
  /// SEM0187: Stable code for a foreign parameter or result type outside the C-compatible scalar subset.
  ForeignTypeNotAdmitted,
  /// SEM0188: Stable code for Silk-only contract syntax retained on a foreign or exported C function declaration.
  ForeignDeclarationRestriction,
  /// SEM0189: Stable code for using a foreign function as a first-class value rather than calling it.
  ForeignFunctionNotFirstClass,
  /// SEM0190: Stable code for a native symbol that is not an ASCII identifier.
  InvalidForeignSymbol,
  /// SEM0191: Stable code for a native symbol the compiler reserves for its own runtime or entry.
  ReservedForeignSymbol,
  /// SEM0192: Stable code for two reachable declarations of one symbol with different C signatures.
  ConflictingForeignSignature,
  /// SEM0193: Stable code for one reachable foreign call unavailable on the requested execution surface.
  ForeignFunctionTargetUnavailable,
  /// SEM0194: Stable code for an inherent impl head that is not the whole family of a module-local nominal.
  InvalidInherentHead,
  /// SEM0195: Stable code for an inherent impl member that cannot be an associated member.
  InvalidInherentMember,
  /// SEM0196: Stable code for two inherent members of one owner sharing a name.
  DuplicateInherentMember,
  /// SEM0197: Stable code for a selective import naming an inherent member as if it were a root declaration.
  ImportedInherentMember,
  /// SEM0198: Stable code for an associated function called on a value as though it had a receiver.
  AssociatedFunctionOnValue,
  /// SEM0200: Stable code for a receiver operation declared by more than one bound of one type parameter.
  AmbiguousReceiverOperation,
  /// SEM0201: Stable code for an `export "C"` function whose body may suspend.
  ExportSuspends,
  /// SEM0202: Stable code for a receiver operation supplied by more than one of the receiver's conformances.
  AmbiguousSuppliedOperation,
  /// SEM0203: Stable code for naming a conformance-supplied receiver operation as a value instead of calling it.
  SuppliedOperationValue,
  /// SEM0205: Stable code for a C-layout record that declares type parameters.
  GenericCLayoutRecord,
  /// SEM0206: Stable code for a C-layout record field outside the closed C object subset.
  UnsupportedCLayoutField,
  /// SEM0207: Stable code for a value that cannot become an exact noncapturing C callback address.
  InvalidForeignCallback,
  /// SEM0208: Stable code for reachable C data on an execution surface without native symbol linkage.
  ForeignStaticTargetUnavailable,
  /// SEM0209: An explicit lifetime does not name a binder in its lexical header scope.
  UnknownLifetime,
  /// SEM0210: An omitted output region has no unique declaration-level input relationship.
  AmbiguousLifetimeElision,
  /// SEM0211: A lifetime binder or outlives bound has an unsupported declaration shape.
  InvalidLifetimeBinder,
  /// SEM0212
  UnsatisfiedLifetimeBound,
  /// SEM0213
  UnsatisfiedTypeOutlives,
  /// SEM0214: Stable code for rejected profile inputs, package schemas, defaults, or predicates.
  InvalidConfiguration,
  /// SEM0215: Stable code for invalid raw-pointer alignment, address space, or qualifier conversion.
  InvalidPointerQualifier,
  /// SEM0216: A diagnostic observer callback lacks a complete direct-execution proof.
  InvalidDiagnosticObserver,
  /// SEM0217: Terminal observation is provably outside a selected failure handler.
  MissingDiagnosticContext,
  /// SEM0218: A `test` qualifier marks a function outside the finite executable test contract.
  InvalidTestDeclaration,
  /// SEM0219: Emitted code references a function instance whose valid body native lowering does not support yet.
  UnsupportedLowering,
  /// SEM0220: A sealed Drop or Copy head names `'static`, repeats one region, or bounds a region.
  RegionSelectiveConformance,
  /// SEM0221: A member list follows an unwritten owner whose parameters the member uses (GEN-008).
  OwnerArgumentPlacement,
  /// SEM0222: Stable code for a namespace-qualified type named where a value is required (NAME-005).
  NamespaceQualifiedType,
  /// SEM0223: A non-alias resolution dependency cycle prevents resolving a declaration or value.
  NonAliasResolutionCycle,
  /// SEM0224: A unit nominal-union variant is written with a braced payload pattern.
  UnitVariantPayloadPattern,
  /// SEM0225: Stable code for a program entry `main` that the selected runtime cannot start.
  InvalidEntryPoint,
  /// SEM0233: A written requirement row names one service-role key with both shared and exclusive access.
  ConflictingRequirementAccess,
  /// SEM0226: Stable code for a match whose scrutinee is a reference rather than the value it refers to.
  ReferenceMatchSubject,
  /// SEM0234: Stable code for a call that does not prove a `?S in R` requirement-row premise of its callee.
  UnprovedRequirementPremise,
  /// SEM0235: Stable code for a directive, or a directive argument, that the language does not define.
  UnknownDirective,
  /// SEM0236: Stable code for a known directive written on a declaration that does not take it.
  MisplacedDirective,
  /// SEM0237: Stable code for an atomic intrinsic call whose memory order or element type the operation does not admit.
  InvalidAtomicOperation,
  /// SEM0238: Stable code for a type named through a module import in a value position.
  ModuleQualifiedType,
  /// SEM0239: Stable code for a SIMD vector or mask shape, or SIMD operation type arguments or shuffle indices, that are not admitted.
  InvalidVectorShape,
  /// SEM0240: Stable code for a requirement on an optional service with exclusive access.
  OptionalExclusiveRequirement,
  /// SEM0241: Stable code for an architecture intrinsic whose target or CPU feature the profile does not select.
  UnavailableArchOperation,
  /// SEM0242: Stable code for a function `@features` entry that is not a CPU feature of the target.
  UnknownFunctionFeature,
  /// SEM0243: Stable code for a function with `features` that is not declared `unsafe`.
  FeatureFunctionRequiresUnsafe,
  /// SEM0244: Stable code for a C signature vector that the target's C ABI passes in no vector register the profile selects.
  ForeignVectorUnavailable,
  /// SEM0245: Stable code for an anonymous function or `effect {}` block that native compilation cannot specialize yet: one in a `static for` body, or one run from a function with `static` parameters.
  UnspecializedLiteral,
  /// SEM0246: Stable code for `mut` or `once` written before a type name other than `Effect`, such as `f: mut F`.
  ModeBeforeTypeName,
  /// SEM0247: Stable code for runtime integer arithmetic over constant operands whose result is outside its type, so it always traps.
  ConstantOverflow,
  /// SEM0248: Stable code for integer `/` or `%` whose right operand is the constant zero, so it always traps.
  ConstantDivisionByZero,
  /// SEM0249: Stable code for a call to a function with `static` parameters through an interface operation or method-call syntax where its static arguments cannot be selected yet, such as in a `static fn`.
  StaticArgumentsThroughCall,
  /// SEM0250: Stable code for two directives on one declaration that cannot be written together: the same directive twice, or two of the inline hints `@inline`, `@inlineAlways`, `@inlineNever` and `@cold`.
  ConflictingDirective,
}

/// The stable spelling of `code`, such as `SEM0006`.
pub fn spelling(code: Code) -> string<'static> {
  return match code {
    Code.UnsupportedBytes => "LEX0001"
