    Code.InvalidStaticLiteral => "Invalid static literal: {detail}"
    Code.InvalidConstant => "Invalid constant: {detail}"
    Code.ExpressionStatementResult => {
      if choice == 1 {
        return "`let _ = ...` does not discard a value in Silk; to drop a result on purpose, write `drop` before the expression, as in `drop compute()`"
      }
      if choice == 2 {
        return "This match is a statement, so the last value of its arm block is ignored; use the match as a value, as in `let x = match ...`, or `drop` this value"
      }
      if choice == 4 {
        return "This `if` is a statement, so the last value of its branch block is ignored; with a final `else`, use the `if` as a value, as in `let x = if ...`, or `drop` this value"
      }
      // An unrun Effect's {actual} already says how to run or drop it.
      if choice == 3 {
        return "Expression statement produces {actual}, but only () or never may be ignored"
      }
      return "Expression statement produces {actual}, but only () or never may be ignored; write `drop` before it to discard the value"
    }
    Code.GenericParameterKindMismatch => "Generic parameter {spelling} has kind {actual}, expected {expected}"
    Code.ContractRowInference => {
      if choice == 1 {
        return "Requirement row does not contain &mut {capability}@{role}"
      }
      if choice == 2 {
        return "Requirement row does not contain &{capability}@{role}"
      }
      if choice == 3 {
        return "Requirement {capability} has role {actual}, expected {expected}"
