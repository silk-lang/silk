/// The message template of `code` at `choice`, an ordinal below [`templateCount`]; the first
/// template past the last.
pub fn template(code: Code, choice: usize) -> string<'static> {
  return match code {
    Code.UnsupportedBytes => "Unsupported byte sequence"
    Code.UnknownLiteralModifier => "Unknown static-literal modifier: {modifier}"
    Code.UnterminatedStaticLiteral => "Unterminated {subject} literal"
    Code.MissingBaseDigits => "Base-{radix} integer literal without digits"
    Code.InvalidDigitSeparator => "Digit separator must sit between two digits"
    Code.MissingExponentDigits => "Float literal exponent must have at least one digit"
    Code.CharacterLiteralScalarCount => "Character literal must hold exactly one Unicode scalar, but holds {scalars}"
    Code.InvalidDurationAmount => "Duration components require whole decimal amounts"
    Code.UnknownDurationUnit => "Unknown duration unit {spelling}"
    Code.RepeatedDurationUnit => "Duration unit {unit} may appear only once"
    Code.OutOfOrderDurationUnit => "Duration unit {unit} must not follow {previous}"
    Code.SubordinateDurationOutOfRange => "Subordinate {unit} component {amount} exceeds {maximum}"
    Code.InvalidBaseDigit => "Base-{radix} integer literal contains {digit}, which is not a base-{radix} digit"
    Code.LiteralTypeSuffix => {
      if choice == 1 {
        return "Numeric literals take no type suffix such as {suffix}; `{amount}` is a float literal, which integer type `{type}` cannot hold, so write a float type as an annotation instead, as in `let value: f64 = {amount}`"
      }
      return "Numeric literals take no type suffix such as {suffix}; write the type as an annotation instead, as in `let value: {type} = {amount}`"
    }
    Code.UnknownModule => "Unknown module {module}"
    Code.SelfImport => "Module {module} imports itself"
    Code.InternalModule => "Module {module} is not exported by package {package}"
    Code.ReservedModule => "Module {module} cannot be imported: `Intrinsic` is reserved for compiler intrinsics, which are written `Intrinsic.<name>` without an import"
    Code.AmbiguousModule => "Module {module} names both `{file}` and `{barrel}`; remove or rename one of them"
    Code.BarrelSpelling => "Module {module} names a `mod.silk` file, which is imported by the path of its directory without `.mod`"
    Code.UseAfterMove => "{spelling} was moved and cannot be used again"
    Code.PartialMove => {
      if choice == 1 {
        return "{owner} has a Drop hook, so no part of it can be moved out; move or borrow the whole value, or read a Copy part"
      }
      return "This place crosses a boundary that does not support partial moves"
    }
    Code.ExplicitMoveRequired => {
      if choice == 1 {
        return "`{spelling}` is a `&mut` reference: lend it again with `&mut {spelling}` (a reborrow), or write `move {spelling}` to give it away"
      }
      if choice == 2 {
        return "`match {spelling}` moves `{spelling}`; write `match move {spelling}` to take it apart, or `match &{spelling}` to look at it"
      }
      if choice == 3 {
        return "`match {spelling}` would move `{spelling}` out of a borrow, which cannot give it away; write `match &{spelling}` to look at it"
      }
      return "Moving {spelling} requires an explicit move"
    }
    Code.OverlappingAssignment => "`{spelling}` is consumed while computing its own replacement; move it out first with `let current = move {spelling}`, then assign `{spelling}` from `current`"
    Code.IncompatibleLoopHeader => "{spelling} is moved inside this loop, so the next iteration would use it after the move; create it inside the loop, or leave the loop right after moving it"
    Code.MatchBorrowEscape => "Borrowed pattern binding {spelling} cannot escape its match arm"
    Code.ExclusiveMatchRequiresMutable => "Exclusive match requires mutable binding {spelling}"
    Code.GuardConsumesPattern => "Match guard cannot consume pattern binding {spelling}"
    Code.InvalidMatchScrutineePlace => "{access} match requires a complete binding place"
    Code.ConflictingViewLoan => "{requested} borrow of `{spelling}` conflicts with an earlier {existing} borrow of it that is still in use; use that borrow for the last time before this one"
    Code.OwnerAccessDuringLoan => "{access} `{spelling}` while a borrow of it is still in use; use that borrow for the last time before this"
    Code.BorrowedMove => "A non-Copy value cannot be moved out through a borrowed-view place"
    Code.StoredCallableInvocationAccess => "Cannot invoke field {field} of {aggregate} through {receiver} aggregate access: {contract} requires {required} access to the whole aggregate"
    Code.StoredEffectRunAccess => "Cannot run field {field} of {aggregate} through {receiver} aggregate access: {contract} requires {required} access to the whole aggregate"
    Code.LocalSharedAccessEscape => {
      if choice == 1 {
        return "Local-shared access cannot invoke an external readiness callback while its exclusive borrow is live"
      }
      if choice == 2 {
        return "`{effect}` runs an Effect while a local-shared access such as `Shared.withMut` holds its exclusive borrow; take what you need out of the value, return it, and run the Effect after the access returns"
      }
      return "Local-shared access cannot suspend while its exclusive borrow is live"
    }
    Code.ExecutableBorrowEscape => {
      if choice == 1 {
        return "The returned callable borrows `{spelling}`, a local of this function; move it into the callable instead, which makes the result a `once fn<'static>`"
      }
      return "{executable} cannot escape with a {access} borrow of local {spelling}"
    }
    Code.ExpiredLifetime => "`{spelling}` is used after {referent}, which it borrows, ended or was replaced"
    Code.MissingToken => "Expected {Token}"
    Code.UnexpectedTokens => {
      if choice == 1 {
        return "Unexpected {encountered}; expected {expectation}"
      }
      if choice == 2 {
        return "Unexpected {encountered} while parsing a statement"
      }
      if choice == 3 {
        return "Unexpected {encountered} while parsing a {context}"
      }
      if choice == 4 {
        return "Silk has no `as` cast; convert with a function of the source type, such as `usize.toI32(count)`, or `usize.checkedToI32(count)` for an `Option` when the value may not fit"
      }
      return "Unexpected {encountered}; expected valid syntax"
    }
    Code.ReservedTemplateSyntax => "Template syntax is reserved but not implemented"
    Code.ReservedImportBinding => "Reserved module segment {spelling} requires an explicit alias or selected-member list"
    Code.ExpressionNestingLimitExceeded => "Expression nesting exceeds the supported limit of {limit}"
    Code.LoopStatement => "`loop` is not a Silk keyword; write an unbounded loop as `while true {{ ... }}`"
    Code.OptionalTypeSyntax => "`?T` is not a Silk type; write an optional type as `Option<T>`"
    Code.TupleTypeSyntax => "Silk has no anonymous tuple types; declare one with a name, as in `tuple Pair(i32, i32)`, and write `Pair`"
    Code.IfExpression => "An `if` used as a value needs a final `else` branch, so that every path produces a value; add `else {{ ... }}`, or write the `if` as a statement"
    Code.ForeignSpelling => {
      if choice == 1 { return "Silk has no `++` or `--`; write `x = x + 1`" }
      if choice == 2 { return "Silk has no `for ... in` loop; count with `while`, as in `let mut i = 0` and `while i < 10 {{ ... i = i + 1 }}`" }
      if choice == 3 { return "`var` is not a Silk keyword; declare a binding you reassign with `let mut`" }
      if choice == 4 { return "Silk has no `c ? a : b`; write an `if` with a final `else` as the value, as in `if c {{ a }} else {{ b }}`" }
      if choice == 5 { return "`return` is a statement, so it cannot be a match arm's value; write the arm as a block, as in `=> {{ return 1 }}`" }
      if choice == 6 { return "A field pattern cannot match a literal; bind the field and compare it in a guard, as in `Item {{ kind, .. }} if kind == 3 =>`" }
      if choice == 7 { return "Match arms are not separated by commas; remove the `,`" }
      if choice == 8 { return "A pattern that takes the whole value names its type, as in `i32 value`, or is `_`" }
      if choice == 9 { return "Silk has no prefix `*`; a dereference follows the value, as in `n.* = n.* + 1`" }
      if choice == 10 {
        return "Silk has no bare blocks; move these statements into a helper function, whose locals end when it returns"
      }
      if choice == 11 {
        return "Silk has no `<<` or `>>`; shift with the functions of the value's type, as in `i32.shiftLeft(value, count)` or `i32.shiftRight(value, count)`"
      }
      if choice == 12 {
        return "A tuple's elements have no field names; build it by position, as in `Pair(first, second)`"
      }
      return "Silk has no compound assignment; write `x = x + 1` instead of `x += 1`"
    }
    Code.WithClause => {
      if choice == 1 { return "Silk has no `with` clauses; write `@inline` on the line before the declaration" }
      if choice == 2 { return "Silk has no `with` clauses; write `@inlineAlways` on the line before the declaration" }
      if choice == 3 { return "Silk has no `with` clauses; write `@inlineNever` on the line before the declaration" }
      if choice == 4 { return "Silk has no `with` clauses; write `@cold` on the line before the declaration" }
      if choice == 5 { return "Silk has no `with` clauses; write `@nonParking` on the line before the declaration" }
      if choice == 6 {
        return "Silk has no `with` clauses; write the fields of `Intrinsic.foreign(...)` as directives before the declaration: its facts as `@foreign(...)`, its callbacks as `@callbacks(...)`, `@threadCallbacks(...)`, `@deferredCallbacks(...)` or `@invokesDeferredCallbacks`, and a WebAssembly module and name as `as \"module#name\"` after the signature"
      }
      if choice == 7 {
        return "Silk has no `with` clauses; write the fields of `Intrinsic.machine(...)` as directives before the declaration: `@features(...)`, `@naked` or `@noReturn`"
      }
      return "Silk has no `with` clauses; write directives such as `@inline` on the line before the declaration"
    }
    Code.UnknownType => "Unknown type {spelling}"
    Code.IntegerOutOfRange => "Integer literal {spelling} is outside the {type} range, {minimum} through {maximum}"
    Code.DuplicateDeclarationName => "Duplicate declaration name {spelling}"
    Code.UnknownFunction => "Unknown function {spelling}"
    Code.DuplicateParameterName => "Duplicate parameter name {spelling}"
    Code.UnknownValueReference => "Unknown value {spelling}"
    Code.WrongCallArity => "Expected {expectedCount} {expectedCountWord} but received {actualCount}"
    Code.RebindingName => "Cannot rebind {spelling}"
    Code.UnknownActor => "Unknown name {spelling}"
    Code.UnknownActorOperation => {
      if choice == 1 { return "A string has no methods; call `{call}` instead, with `import silk.text.string {{ String }}`" }
      if choice == 2 { return "Enum members have no `value` method; read the backing value with `{enumName}.value(member)`" }
      if choice == 3 {
        return "`drop` is not a method; write `drop {receiver}` to end the value early, which runs its Drop hook, if it has one"
      }
      return "{actor} has no {member}"
    }
    Code.ConditionNotBool => "Condition must be bool, found {actual}"
    Code.ArgumentTypeMismatch => {
      if choice == 1 {
        return "This parameter takes a C function pointer, and a Silk fn has no C address; pass an `export \"C\" fn` here"
      }
      if choice == 2 { return "This parameter takes a borrow, and this argument is {actual}; write `&` before it" }
      return "Expected {expected} but received {actual}"
    }
    Code.UnknownImportedMember => "Module {module} has no member {spelling}"
    Code.InaccessibleImportedMember => {
      if choice == 1 {
        return "`{spelling}` is not declared in {module}, which only imports it; import it from {origin}"
      }
      return "`{spelling}` is private to {module}; mark it `pub` there to use it here"
    }
    Code.BindingConflict => "Multiple bindings claim {spelling}; rename one with `as`, as in `import a.b as other` or `import a.b {{ {spelling} as other }}`"
    Code.DuplicateFieldName => "Duplicate field name {spelling}"
    Code.ExpectedType => "Expected a type, found {spelling}"
    Code.PrivateTypeExposure => "Public declaration exposes private type {type}"
    Code.InlineRecursiveAggregate => "Inline recursive aggregate layout: {members}"
    Code.InaccessibleStructConstruction => "Cannot construct {type} here because it has fields private to its module; call a function that module provides to build one"
    Code.UnknownStructField => "{type} has no field {field}"
    Code.DuplicateStructInitializer => "Field {field} is initialized more than once"
    Code.MissingStructInitializer => {
      if choice == 1 { return "`{literal} {{ ... }}` omits {missing}" }
      return "Missing initializer for {type}.{field}"
    }
    Code.StructFieldTypeMismatch => "Field {field} expects {expected} but received {actual}"
    Code.ProjectionOnNonStruct => {
      if choice == 1 {
        return "A string has no fields; call the `silk.text.string` functions on it, as in `String.byteLength(text)` for its length in bytes"
      }
      return "Cannot project a field from {actual}"
    }
    Code.UnknownProjectedField => {
      if choice == 1 { return "{type} has no field `{field}`; its element count is `.length`" }
      if choice == 2 { return "{type} has no element `{field}`; it has {count}, {positions}" }
      return "{type} has no field {field}"
    }
    Code.InaccessibleProjectedField => {
      if choice == 1 {
        return "Field `{field}` of {type} is private; read it with `{accessor}(&value)` instead"
      }
      if choice == 2 {
        return "Field `{field}` of {type} is private to the module that declares it"
      }
      if choice == 3 {
        return "Pattern names private field `{field}` of variant `{variant}`; skip it with `..`, or mark it `pub {field}` to use it outside its module"
      }
      if choice == 4 {
        return "Pattern names private field `{field}` of variant `{variant}`, which is private to the module that declares it; skip it with `..`"
      }
      return "Field `{field}` of {type} is private; mark it `pub {field}` to use it outside its module"
    }
    Code.EmptyArrayNeedsContext => "An empty array literal needs an expected Array type"
    Code.ArrayElementTypeMismatch => "This element is {actual}, but the array holds {expected}"
    Code.ArrayLengthMismatch => "Array literal expects {expected} elements but received {actual}"
    Code.IndexOnNonArray => {
      if choice == 1 {
        return "A string cannot be indexed, because a character can take more than one byte; read a byte with `String.utf8Bytes(text)[i]`, or step through characters with `String.nextScalar`"
      }
      return "Cannot index {actual}"
    }
    Code.IndexNotUsize => "Array index must be usize, found {actual}"
    Code.IndexOutOfBounds => "Array index {index} is outside length {length}"
    Code.ImmutableAssignment => "Cannot assign through immutable binding {spelling}"
    Code.InvalidAssignmentPlace => {
      if choice == 1 { return "`{spelling}` is a C static, which Silk code can read but not assign" }
      if choice == 2 {
        return "`Intrinsic.replace` takes the place to replace, not a borrow of it; drop the `&mut`, as in `Intrinsic.replace(slot, value)`"
      }
      return "Assignment requires a writable binding, field, or indexed place"
    }
    Code.AssignmentTypeMismatch => {
      if choice == 1 {
        return "Every function and closure has its own type, so a binding that holds one cannot be assigned a different one"
      }
      return "Assignment expected {expected} but received {actual}"
    }
    Code.TransferOutsideLoop => "{transfer} is only valid inside a loop"
    Code.InvalidUnionMember => "Structural union members must be detached ordinary values with finite storage, found {type}"
    Code.IncompatibleUnionConversion => {
