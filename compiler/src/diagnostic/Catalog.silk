      return "{feature} is not a CPU feature of {target}; `@features` lists text literals from the target's catalog"
    }
    Code.FeatureFunctionRequiresUnsafe => "{name} enables CPU features, so it must be declared `unsafe fn`; each caller proves the CPU has them"
    Code.ForeignVectorUnavailable => "{type} crosses the C boundary in one vector register, {requirement}"
    Code.UnspecializedLiteral => {
      if choice == 1 {
        return "{literal} cannot run inside {function} yet: the native compiler does not specialize it for each argument of a `static` parameter; move the code that builds and runs it into a named function without `static` parameters and call that from {function}"
      }
      return "{literal} inside a `static for` body is not supported by the native compiler yet: every unrolled iteration would share its one declaration; move the code that builds and runs it into a named function and call that from the loop body"
    }
    Code.ModeBeforeTypeName => {
      if choice == 1 {
        return "`once {name}` is not a type: `once` before a type name only marks `Effect<...>`; a callable type writes it before `fn`, as in `once fn() -> T`"
      }
      return "`mut {name}` is not a type: `mut` before a type name only marks `Effect<...>`; to let a parameter change, write `mut` before its name, as in `mut f: {name}`"
    }
    Code.ConstantOverflow => {
      if choice == 1 {
        return "{operation} is outside the {type} range, {minimum} through {maximum}, so it always traps"
      }
      if choice == 2 {
        return "{operation} always traps: {dividend} / -1 is outside the {type} range, {minimum} through {maximum}"
      }
      return "{operation} is {value}, outside the {type} range, {minimum} through {maximum}, so it always traps"
    }
    Code.ConstantDivisionByZero => {
      if choice == 1 {
        return "Remainder by zero always traps: the right operand of `%` is the constant 0"
      }
      return "Division by zero always traps: the right operand of `/` is the constant 0"
    }
    Code.StaticArgumentsThroughCall => {
      if choice == 1 {
        return "A method with `static` parameters cannot receive its static arguments here yet; call it from the body of a runtime function"
      }
      return "An interface operation with `static` parameters cannot receive its static arguments here yet; call it from the body of a runtime function"
    }
    Code.ConflictingDirective => {
      if choice == 1 {
        return "`@{second}` cannot be written with `@{first}`: a function takes at most one of `@inline`, `@inlineAlways`, `@inlineNever` and `@cold`"
      }
      return "`@{second}` is written twice on this declaration; keep one"
    }
  }
}
