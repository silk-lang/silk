/// The phase that reports `code`.
pub fn phase(code: Code) -> Phase {
  return match code {
    Code.WordLiteralOutOfRange => Phase.Layout
    Code.UnsupportedBytes => Phase.Lexical
    Code.UnknownLiteralModifier => Phase.Lexical
    Code.UnterminatedStaticLiteral => Phase.Lexical
    Code.MissingBaseDigits => Phase.Lexical
