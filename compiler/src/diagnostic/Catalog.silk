    Code.StoredEffectRunAccess => Phase.Ownership
    Code.LocalSharedAccessEscape => Phase.Ownership
    Code.ExecutableBorrowEscape => Phase.Ownership
    Code.ExpiredLifetime => Phase.Ownership
    Code.MissingToken => Phase.Parser
    Code.UnexpectedTokens => Phase.Parser
    Code.ReservedTemplateSyntax => Phase.Parser
    Code.ReservedImportBinding => Phase.Parser
    Code.ExpressionNestingLimitExceeded => Phase.Parser
    Code.UnknownType => Phase.Semantic
