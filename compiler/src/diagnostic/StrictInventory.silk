//! Strict, read-only named-function census over actual immutable source publications.
//! The diagnostic producer is bootstrap-built; the unmodified compiler entry is only its target.

import semantic.Types {Types}
import diagnostic.StrictInventoryResult as Codec {Phase, Fact, Eligibility, SweepPins}
import driver.ModuleSources as Sources {ModuleSources}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.ModuleIndex {NamedFunction}
import semantic.DeclarationId {DeclarationId}
import semantic.SourceRevision {Observation, Revision}
import semantic.PackageGraph {PackageGraph}
import semantic.SourceIndex {Event, EventKind, NoRejection, RevisionMismatch}
import semantic.Semantic {Semantic, Request, SourceInventory, InventoryImport, Answer, Outcome, Value}
import semantic.Query {Cycle}
import semantic.Target {Target, Id as TargetId}
import semantic.FinalProfile {FinalProfile}
import semantic.Rejection {Rejection}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.system.filesystem {Path, FileError, FileSystem}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.mem.shared {Shared}
import silk.crypto.sha2 {Sha256}
import silk.num.usize
import silk.collections.list {List}

pub struct ModuleSweep {
  pub module: ModuleId,
  pub inventory: Option<SourceInventory>,
  pub status: &'static [u8],
  pub signatures: List<Fact>,
  pub bodies: List<Fact>,
}

pub struct Sweep {
  pub modules: List<ModuleSweep>,
  pub complete: bool,
  pub strictSuccess: bool,
  pub functions: usize,
  pub records: usize,
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

pub fn compilerSubject(sources: &ModuleSources, module: &ModuleId) -> bool {
  let entry = Sources.entry(sources)
  return Sources.compilerProvider(sources, module) && ModuleId.sameOrigin(entry, module) && ModuleId.samePackage(entry, module)
}

effect fn addModule(modules: &mut List<ModuleId>, id: &ModuleId) -> ()
! OutOfMemoryError ? &mut Allocator {
  let listed = List<ModuleId>.asSlice(&modules.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if ModuleId.equals(&listed[at], id) { return () }
    at = at + usize.ONE
  }
  return run List<ModuleId>.append(&mut modules.*, ModuleId.copy(id))
}

// SourceRead identities include an import target even when its Namespace answer rejects.
effect fn addObserved(modules: &mut List<ModuleId>, store: &Semantic) -> ()
! OutOfMemoryError ? &mut Allocator {
  let events = Semantic.sourceEvents(&store.*)
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.SourceRead && !run unchosenCandidate(events, &events[at]) {
      run addModule(&mut modules.*, &events[at].module)
    }
    at = at + usize.ONE
  }
  return ()
}

// Whether `read` is an absent file an import path could have named but did not (MODULE-007): an
// absent barrel `mod.silk`, which is the usual case, or an absent module file whose directory's
// barrel the same store found present. Neither is a missing source.
effect fn unchosenCandidate(events: &[Event], read: &Event) -> bool ! OutOfMemoryError ? &mut Allocator {
  if read.present { return false }
  if ModuleId.withPath<bool>(&read.module, PackageGraph.isBarrel) { return true }
  let path = run ModuleId.copyPath(&read.module)
  let barrelPath = run PackageGraph.barrelPath(Bytes.asSlice(&path))
  let origin = run ModuleId.copyOrigin(&read.module)
  let package = run ModuleId.copyPackage(&read.module)
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.SourceRead && events[at].present
      && ModuleId.matches(&events[at].module, Bytes.asSlice(&origin), Bytes.asSlice(&package), Bytes.asSlice(&barrelPath)) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// The namespace module an import answer names; the copy shares the module's components.
fn namespaceModule(answer: &Result<Answer, NoRejection>) -> Option<ModuleId> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Namespace {module, ..}} = &value.outcome {
      return Option<ModuleId>.some(ModuleId.copy(&module))
    }
  }
  return Option<ModuleId>.none()
}

fn isNamespace(answer: &Result<Answer, NoRejection>) -> bool {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome { Outcome.Success {value: Value.Namespace {..}} => true _ => false }
    _ => false
  }
}

effect fn addImports(modules: &mut List<ModuleId>, inventory: &SourceInventory) -> ()
! OutOfMemoryError ? &mut Allocator {
  if let SourceInventory.Present {imports, ..} = &inventory.* {
    let written = List<InventoryImport>.asSlice(&imports)
    let mut at = usize.ZERO
    while at < written.length {
      let answer = &written[at].answer
      let namespace = Shared<Result<Answer, NoRejection>>.with<Option<ModuleId>>(answer, namespaceModule)
      if let Option<ModuleId>.Some {value: target} = move namespace {
        run addModule(&mut modules.*, &target)
      }
      at = at + usize.ONE
    }
  }
  return ()
}

effect fn demandPhase(store: &mut Semantic, request: &mut Request, declaration: &DeclarationId, phase: Phase)
-> Shared<Result<Answer, NoRejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if phase == Phase.Signature { return run Semantic.demandSignatureOf(&mut store.*,&mut request.*, declaration) }
  let body = run Semantic.demandBodyOf(&mut store.*,&mut request.*, declaration)
  // A typed body's record also reports its named instance's MIR refusal, so one sweep exposes
  // lowering gaps across every function instead of only the build's reached frontier.
  let typed = Shared<Result<Answer, NoRejection>>.with<bool>(&body, fn(answer: &Result<Answer, NoRejection>) -> bool {
    let fact = Codec.classifyAnswer(Phase.Body, answer)
    return match &fact { Fact.Body {..} => true _ => false }
  })
  if !typed { return move body }
  let lowered = match move run Semantic.demandMirOf(&mut store.*,&mut request.*, declaration) {
    Option<Shared<Result<Answer, NoRejection>>>.Some {value} => move value
    Option<Shared<Result<Answer, NoRejection>>>.None => { return move body }
  }
  let refused = Shared<Result<Answer, NoRejection>>.with<bool>(&lowered, fn(answer: &Result<Answer, NoRejection>) -> bool {
    let fact = Codec.classifyAnswer(Phase.Body, answer)
    return match &fact { Fact.Rejected {..} => true Fact.Refused {..} => true Fact.Unsupported {..} => true _ => false }
  })
  if refused { return move lowered }
  return move body
}

effect fn phase(store: &mut Semantic, entry: &ModuleId, declaration: &DeclarationId, eligibility: Eligibility, selected: Phase) -> Fact
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !Codec.demanded(eligibility, selected) { return Fact.NotDemanded }
  let mut request = Request.forApplication(ModuleId.copy(entry))
  let result = run Effect.result(demandPhase(&mut store.*, &mut request, declaration, selected))
  return match move result {
    Result<Shared<Result<Answer, NoRejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} =>
      Shared<Result<Answer, NoRejection>>.with<Fact>(&value, fn(answer: &Result<Answer, NoRejection>) -> Fact { return Codec.classifyAnswer(selected, answer) })
    Result<Shared<Result<Answer, NoRejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      Cycle {} => Fact.QueryError {code: b"cycle"}
      InvalidModulePath {} => Fact.QueryError {code: b"invalid-module-path"}
      RevisionMismatch {} => Fact.QueryError {code: b"revision-mismatch"}
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

pub fn successful(fact: &Fact, phase: Phase) -> bool {
  return match &fact.* { Fact.Signature {..} => phase == Phase.Signature Fact.Body {..} => phase == Phase.Body _ => false }
}

/// Strict success needs evidence for each demanded phase; an undemanded phase is not a refusal.
pub fn accepted(fact: &Fact, eligibility: Eligibility, phase: Phase) -> bool {
  return !Codec.demanded(eligibility, phase) || successful(fact, phase)
}

/// Sweeps the whole program in one pass over a store opened after the program is preloaded.
///
/// # Details
///
/// Every authored import is traversed. Only compiler modules contribute named phase subjects. A
/// failed phase cannot suppress the other phase; neither request reuses a prior Request root set.
/// A module the store read outside the preloaded program leaves coverage incomplete.
pub effect fn collect(sources: &mut ModuleSources, profile: Option<FinalProfile>) -> Sweep
! FileError | InvalidModulePath | OutOfMemoryError ? &mut FileSystem | &mut Allocator | &mut Types {
  let entry = ModuleId.copy(Sources.entry(&sources.*))
  run Sources.preloadProgram(&mut sources.*, &entry)
  let mut store = Semantic.oneShot(run Sources.revision(&sources.*), Target.forId(TargetId.X8664UnknownLinuxGnu), move profile)
  Semantic.selectPackages(&mut store, run Sources.packageGraph(&sources.*))
  let mut queue = List<ModuleId>.make()
  run addModule(&mut queue, &entry)
  let mut sweep = Sweep {modules: List<ModuleSweep>.make(), complete: true, strictSuccess: true, functions: usize.ZERO, records: usize.ZERO}
  let mut at = usize.ZERO
  while at < List<ModuleId>.length(&queue) {
    let queued = List<ModuleId>.asSlice(&queue)
    let id = ModuleId.copy(&queued[at])
    let mut request = Request.forApplication(ModuleId.copy(&entry))
    let result = run Effect.result(Semantic.demandSourceInventory(&mut store, &mut request, &id))
    let mut module = ModuleSweep {module: move id, inventory: Option<SourceInventory>.none(), status: b"present", signatures: List<Fact>.make(), bodies: List<Fact>.make()}
    match move result {
      Result<SourceInventory, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => {
        run addImports(&mut queue, &value)
        // Every selected import member is checked whether or not a use demands it (IMPORT-003).
        let checked = run Effect.result(Semantic.moduleImportRejections(&mut store, &mut request, &module.module))
        match move checked {
          Result<List<Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value: rejected} => {
            if List<Shared<Rejection>>.length(&rejected) > usize.ZERO { sweep.strictSuccess = false }
          }
          Result<List<Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => {
            match move error {
              Cycle {} => { sweep.complete = false }
              InvalidModulePath {} => { sweep.complete = false }
              RevisionMismatch {} => { sweep.complete = false }
              OutOfMemoryError exhausted => { fail move exhausted }
            }
          }
        }
        if let SourceInventory.Present {syntax, availability, imports, ..} = &value {
          let written = List<InventoryImport>.asSlice(&imports)
          let mut index = usize.ZERO
          while index < written.length {
            if !Shared<Result<Answer, NoRejection>>.with<bool>(&written[index].answer, isNamespace) { sweep.strictSuccess = false }
            index = index + usize.ONE
          }
          if compilerSubject(&sources.*, &module.module) {
            if syntax.excludedDamaged > usize.ZERO { sweep.strictSuccess = false }
            let functions = List<NamedFunction>.asSlice(&syntax.functions)
            let states = List<Result<bool, Shared<Rejection>>>.asSlice(&availability)
            index = usize.ZERO
            while index < functions.length {
              let eligibility = Codec.eligibilityOf(&functions[index], &states[index])
              let signature = run phase(&mut store, &entry, &functions[index].declaration.identity, eligibility, Phase.Signature)
              let body = run phase(&mut store, &entry, &functions[index].declaration.identity, eligibility, Phase.Body)
              if !accepted(&signature, eligibility, Phase.Signature) || !accepted(&body, eligibility, Phase.Body) { sweep.strictSuccess = false }
              run List<Fact>.append(&mut module.signatures, move signature)
              run List<Fact>.append(&mut module.bodies, move body)
              sweep.functions = sweep.functions + usize.ONE
              sweep.records = sweep.records + 2
              index = index + usize.ONE
            }
          }
        } else {
          module.status = b"missing-source"
          sweep.complete = false
        }
        module.inventory = Option<SourceInventory>.some(move value)
      }
      Result<SourceInventory, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => {
        sweep.complete = false
        module.status = match move error {
          Cycle {} => b"inventory-cycle"
          InvalidModulePath {} => b"invalid-module-path"
          RevisionMismatch {} => b"revision-mismatch"
          OutOfMemoryError exhausted => { fail move exhausted }
        }
      }
    }
    run addObserved(&mut queue, &store)
    run List<ModuleSweep>.append(&mut sweep.modules, move module)
    at = at + usize.ONE
  }
  if Sources.missedSource(&sources.*, Semantic.sourceEvents(&store)) { sweep.complete = false }
  return move sweep
}

pub fn exitCode(sweep: &Sweep) -> i32 {
  if !sweep.complete { return 3 }
  if !sweep.strictSuccess { return 2 }
  return 0
}

// The normalized source-file prefix orders compiler providers before stdlib providers.
// Canonical identity remains a final tie-breaker, never a substitute for the source mapping.
fn compareSources(sources: &ModuleSources, left: &ModuleId, right: &ModuleId) -> i32 {
  let leftCompiler = Sources.compilerProvider(sources, left)
  let rightCompiler = Sources.compilerProvider(sources, right)
  if leftCompiler && !rightCompiler { return -1 }
  if !leftCompiler && rightCompiler { return 1 }
  let path = ModuleId.comparePath(left, right)
  if path != 0 { return path }
  let leftSubject = compilerSubject(sources, left)
  let rightSubject = compilerSubject(sources, right)
  if leftSubject && !rightSubject { return -1 }
  if !leftSubject && rightSubject { return 1 }
  return ModuleId.compare(left, right)
}

/// Rows are serialized only after the complete closure has settled. The sorted module records
/// are the digest domain: normalized source_file/role/presence/raw SHA, including absent/library inputs.
pub effect fn encode(sweep: &Sweep, sources: &ModuleSources, pins: &SweepPins) -> Bytes
! FileError | OutOfMemoryError ? &mut Allocator {
  let revision = run Sources.revision(&sources.*)
  let number = Revision.revisionNumber(&revision)
  let mut output = Bytes.make()
  let mut digest = Sha256.make()
  let modules = List<ModuleSweep>.asSlice(&sweep.modules)
  // Canonical ordering without mutating retained inventories or depending on discovery order.
  let mut previous = Option<usize>.none()
  let mut emitted = usize.ZERO
  while emitted < modules.length {
    let mut next = Option<usize>.none()
    let mut at = usize.ZERO
    while at < modules.length {
      let mut after = true
      if let Option<usize>.Some {value} = &previous { after = compareSources(sources, &modules[at].module, &modules[value].module) > 0 }
      if after {
        match &next { Option<usize>.None => { next = Option<usize>.some(at) } Option<usize>.Some {value} => { if compareSources(sources, &modules[at].module, &modules[value].module) < 0 { next = Option<usize>.some(at) } } }
      }
      at = at + usize.ONE
    }
    let selected = match move next { Option<usize>.Some {value} => value Option<usize>.None => { break } }
    let module = &modules[selected]
    let observation = run Revision.observe(&revision, &module.module)
    let content = run Observation.copyContent(&observation)
    let hash = match &content { Option<Bytes>.Some {value} => Option<[u8; 32]>.some(Sha256.hash(Bytes.asSlice(&value))) Option<Bytes>.None => Option<[u8; 32]>.none() }
    let location = run Sources.sourceLocation(sources, &module.module)
    let path = match &location.path { Option<Path>.Some {value} => Path.rawBytes(&value) Option<Path>.None => b"" }
    let subject = compilerSubject(sources, &module.module)
    let mut sourceRole: &[u8] = b"stdlib-input"
    if Sources.compilerProvider(sources, &module.module) { sourceRole = b"other-input" }
    if subject { sourceRole = b"compiler-subject" }
    let mut functions = usize.ZERO
    let mut anonymous = usize.ZERO
    let mut damaged = usize.ZERO
    if let Option<SourceInventory>.Some {value: SourceInventory.Present {syntax, ..}} = &module.inventory {
      functions = List<NamedFunction>.length(&syntax.functions)
      anonymous = syntax.excludedAnonymous
      damaged = syntax.excludedDamaged
    }
    let mut relative = run Bytes.copy(b"stdlib/")
    if Sources.compilerProvider(sources, &module.module) { relative = run Bytes.copy(b"compiler/src/") }
    run ModuleId.appendPath(&module.module, &mut relative)
    let mut row = Bytes.make()
    run Codec.appendModuleRecord(&mut row, &module.module, Bytes.asSlice(&relative), path, sourceRole, &observation, &hash, number, functions, anonymous, damaged, module.status)
    // Physical roots, canonical audit identities and revision/publication order are excluded
    // from the reproducible input observation digest; final revision stays in emitted rows.
    let mut input = Bytes.make()
    run Codec.appendInputObservation(&mut input, Bytes.asSlice(&relative), sourceRole, Observation.isPresent(&observation), &hash)
    Sha256.update(&mut digest, Bytes.asSlice(&input))
    run Bytes.append(&mut output, Bytes.asSlice(&row))
    if let Option<SourceInventory>.Some {value: SourceInventory.Present {syntax, availability, imports, ..}} = &module.inventory {
      let written = List<InventoryImport>.asSlice(&imports)
      at = usize.ZERO
      while at < written.length {
        if !Shared<Result<Answer, NoRejection>>.with<bool>(&written[at].answer, isNamespace) {
          let fact = Shared<Result<Answer, NoRejection>>.with<Fact>(&written[at].answer, fn(answer: &Result<Answer, NoRejection>) -> Fact { return Codec.classifyAnswer(Phase.Signature, answer) })
          run Codec.appendImportRecord(&mut output, &written[at].declaration, &fact)
        }
        at = at + usize.ONE
      }
      if subject {
        let subjects = List<NamedFunction>.asSlice(&syntax.functions)
        let states = List<Result<bool, Shared<Rejection>>>.asSlice(&availability)
        let signatures = List<Fact>.asSlice(&module.signatures)
        let bodies = List<Fact>.asSlice(&module.bodies)
        at = usize.ZERO
        while at < subjects.length {
          run Codec.appendObservedRecord(&mut output, &subjects[at], &observation, &hash, Phase.Signature, Codec.eligibilityOf(&subjects[at], &states[at]), &signatures[at], Option<usize>.some(number))
          run Codec.appendObservedRecord(&mut output, &subjects[at], &observation, &hash, Phase.Body, Codec.eligibilityOf(&subjects[at], &states[at]), &bodies[at], Option<usize>.some(number))
          at = at + usize.ONE
        }
      }
    }
    previous = Option<usize>.some(selected)
    emitted = emitted + usize.ONE
  }
  run Codec.appendSweepFooter(&mut output, modules.length, sweep.functions, sweep.records, number, Sha256.finish(move digest), sweep.complete, sweep.strictSuccess, pins)
  return move output
}
