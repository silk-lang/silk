//! Strict, read-only named-function census over actual immutable source publications.
//! The diagnostic producer is bootstrap-built; the unmodified compiler entry is only its target.

import diagnostic.StrictInventoryResult as Codec {Phase, Fact, Eligibility, SweepPins}
import driver.ModuleSources as Sources {ModuleSources}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.ModuleIndex {NamedFunction}
import semantic.DeclarationId {DeclarationId}
import semantic.SourceRevision {Observation, Revision}
import semantic.SourceIndex {EventKind, NoRejection, RevisionMismatch}
import semantic.Semantic {Semantic, Request, SourceInventory, InventoryImport, Answer, Outcome, Value}
import semantic.Query {Cycle}
import semantic.Rejection {Rejection}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.filesystem {Path, FileError, FileSystem}
import silk.option {Option}
import silk.result {Result}
import silk.shared {Shared}
import silk.sha2 {Sha256}
import silk.usize
import silk.vector {Vector}

pub struct ModuleSweep {
  pub module: ModuleId
  pub inventory: Option<SourceInventory>
  pub status: &'static [u8]
  pub signatures: Vector<Fact>
  pub bodies: Vector<Fact>
}

pub struct Sweep {
  pub modules: Vector<ModuleSweep>
  pub complete: bool
  pub strictSuccess: bool
  pub functions: usize
  pub records: usize
  pub passes: usize
  pub phasePublications: usize
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

pub fn compilerSubject(sources: &ModuleSources, module: &ModuleId) -> bool {
  let entry = Sources.entry(sources)
  return Sources.compilerProvider(sources, module) && same(ModuleId.sourceOrigin(entry), ModuleId.sourceOrigin(module)) && same(ModuleId.packageIdentity(entry), ModuleId.packageIdentity(module))
}

effect fn addModule(modules: &mut Vector<ModuleId>, id: &ModuleId) -> ()
! OutOfMemoryError ? &mut Allocator {
  let listed = Vector.asSlice<ModuleId>(&modules.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if ModuleId.equals(&listed[at], id) { return () }
    at = at + usize.ONE
  }
  return run Vector.append<ModuleId>(&mut modules.*, run ModuleId.copy(id))
}

// SourceRead identities include an import target even when its Namespace answer rejects.
effect fn addObserved(modules: &mut Vector<ModuleId>, store: &Semantic) -> ()
! OutOfMemoryError ? &mut Allocator {
  let events = Semantic.sourceEvents(&store.*)
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.SourceRead { run addModule(&mut modules.*, &events[at].module) }
    at = at + usize.ONE
  }
  return ()
}

effect fn addPublished(modules: &mut Vector<ModuleId>, sources: &ModuleSources) -> ()
! OutOfMemoryError ? &mut Allocator {
  let published = Sources.observedModules(sources)
  let mut at = usize.ZERO
  while at < published.length {
    run addModule(&mut modules.*, &published[at])
    at = at + usize.ONE
  }
  return ()
}

fn namespaceLength(answer: &Result<Answer, NoRejection>, part: usize) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Namespace {module, ..}} = &value.outcome {
      if part == 0 { return ModuleId.sourceOrigin(&module).length }
      if part == 1 { return ModuleId.packageIdentity(&module).length }
      return ModuleId.logicalPath(&module).length
    }
  }
  return usize.ZERO
}

effect fn namespacePart(answer: &Shared<Result<Answer, NoRejection>>, part: usize) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let length = Shared.with<Result<Answer, NoRejection>, usize>(answer, fn(value: &Result<Answer, NoRejection>) -> usize { return namespaceLength(value, part) })
  let mut bytes = run Bytes.zeroed(length)
  let output = Bytes.asMutSlice(&mut bytes)
  let mut at = usize.ZERO
  while at < length {
    output[at] = Shared.with<Result<Answer, NoRejection>, u8>(answer, fn(answer: &Result<Answer, NoRejection>) -> u8 {
      if let Result<Answer, NoRejection>.Success {value} = &answer.* {
        if let Outcome.Success {value: Value.Namespace {module, ..}} = &value.outcome {
          if part == 0 { return ModuleId.sourceOrigin(&module)[at] }
          if part == 1 { return ModuleId.packageIdentity(&module)[at] }
          return ModuleId.logicalPath(&module)[at]
        }
      }
      return 0
    })
    at = at + usize.ONE
  }
  return move bytes
}

fn isNamespace(answer: &Result<Answer, NoRejection>) -> bool {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome { Outcome.Success {value: Value.Namespace {..}} => true _ => false }
    _ => false
  }
}

effect fn addImports(modules: &mut Vector<ModuleId>, inventory: &SourceInventory) -> ()
! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  if let SourceInventory.Present {imports, ..} = &inventory.* {
    let written = Vector.asSlice<InventoryImport>(&imports)
    let mut at = usize.ZERO
    while at < written.length {
      let answer = &written[at].answer
      if Shared.with<Result<Answer, NoRejection>, bool>(answer, isNamespace) {
        let target = run ModuleId.fromParts(run namespacePart(answer, 0), run namespacePart(answer, 1), run namespacePart(answer, 2))
        run addModule(&mut modules.*, &target)
      }
      at = at + usize.ONE
    }
  }
  return ()
}

effect fn stabilize(sources: &mut ModuleSources, store: &mut Semantic) -> bool
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let before = run Sources.revision(&sources.*)
  let published = run Sources.publishObserved(&mut sources.*, Semantic.sourceEvents(&store.*))
  drop published
  let after = run Sources.revision(&sources.*)
  let changed = Revision.revisionNumber(&before) != Revision.revisionNumber(&after)
  if changed { Semantic.revise(&mut store.*, move after) }
  return changed
}

effect fn demandPhase(store: &mut Semantic, request: &mut Request, declaration: &DeclarationId, phase: Phase)
-> Shared<Result<Answer, NoRejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if phase == Phase.Signature { return run Semantic.demandSignatureOf(&mut store.*,&mut request.*, declaration) }
  let body = run Semantic.demandBodyOf(&mut store.*,&mut request.*, declaration)
  // A typed body's record also reports its named instance's MIR refusal, so one sweep exposes
  // lowering gaps across every function instead of only the build's reached frontier.
  let typed = Shared.with<Result<Answer, NoRejection>, bool>(&body, fn(answer: &Result<Answer, NoRejection>) -> bool {
    let fact = Codec.classifyAnswer(Phase.Body, answer)
    return match &fact { Fact.Body {..} => true _ => false }
  })
  if !typed { return move body }
  let lowered = match move run Semantic.demandMirOf(&mut store.*,&mut request.*, declaration) {
    Option<Shared<Result<Answer, NoRejection>>>.Some {value} => value
    Option<Shared<Result<Answer, NoRejection>>>.None => { return move body }
  }
  let refused = Shared.with<Result<Answer, NoRejection>, bool>(&lowered, fn(answer: &Result<Answer, NoRejection>) -> bool {
    let fact = Codec.classifyAnswer(Phase.Body, answer)
    return match &fact { Fact.Rejected {..} => true Fact.Unsupported {..} => true _ => false }
  })
  if refused { return move lowered }
  return move body
}

effect fn phase(sources: &mut ModuleSources, store: &mut Semantic, entry: &ModuleId, declaration: &DeclarationId, selected: Phase, publications: &mut usize) -> Fact
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let before = run Sources.revision(&sources.*)
  let mut request = Request.forApplication(run ModuleId.copy(entry))
  let mut result = run Effect.result(demandPhase(&mut store.*, &mut request, declaration, selected))
  while run stabilize(&mut sources.*,&mut store.*) {
    request = Request.forApplication(run ModuleId.copy(entry))
    result = run Effect.result(demandPhase(&mut store.*, &mut request, declaration, selected))
  }
  let after = run Sources.revision(&sources.*)
  if Revision.revisionNumber(&before) != Revision.revisionNumber(&after) { publications.* = publications.* + usize.ONE }
  return match move result {
    Result<Shared<Result<Answer, NoRejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} =>
      Shared.with<Result<Answer, NoRejection>, Fact>(&value, fn(answer: &Result<Answer, NoRejection>) -> Fact { return Codec.classifyAnswer(selected, answer) })
    Result<Shared<Result<Answer, NoRejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      Cycle {} => Fact.QueryError {code: b"cycle"}
      InvalidModulePath {} => Fact.QueryError {code: b"invalid-module-path"}
      RevisionMismatch {} => Fact.QueryError {code: b"revision-mismatch"}
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

pub fn successful(fact: &Fact, phase: Phase) -> bool {
  return match &fact.* { Fact.Signature {..} => phase == Phase.Signature Fact.Body {..} => phase == Phase.Body _ => false }
}

/// Every authored import is traversed. Only compiler modules contribute named phase subjects.
/// A failed phase cannot suppress the other phase; neither request reuses a prior Request root set.
effect fn collectPass(sources: &mut ModuleSources, store: &mut Semantic) -> Sweep
! FileError | InvalidModulePath | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let entry = run ModuleId.copy(Sources.entry(&sources.*))
  let mut queue = Vector.make<ModuleId>()
  run addModule(&mut queue, &entry)
  run addPublished(&mut queue, &sources.*)
  let mut sweep = Sweep {modules: Vector.make<ModuleSweep>(), complete: true, strictSuccess: true, functions: usize.ZERO, records: usize.ZERO, passes: usize.ONE, phasePublications: usize.ZERO}
  let mut at = usize.ZERO
  while at < Vector.length<ModuleId>(&queue) {
    let queued = Vector.asSlice<ModuleId>(&queue)
    let id = run ModuleId.copy(&queued[at])
    let mut request = Request.forApplication(run ModuleId.copy(&entry))
    let mut result = run Effect.result(Semantic.demandSourceInventory(&mut store.*, &mut request, &id))
    while run stabilize(&mut sources.*,&mut store.*) {
      request = Request.forApplication(run ModuleId.copy(&entry))
      result = run Effect.result(Semantic.demandSourceInventory(&mut store.*, &mut request, &id))
    }
    let mut module = ModuleSweep {module: move id, inventory: Option.none<SourceInventory>(), status: b"present", signatures: Vector.make<Fact>(), bodies: Vector.make<Fact>()}
    match move result {
      Result<SourceInventory, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => {
        run addImports(&mut queue, &value)
        if let SourceInventory.Present {syntax, imports, ..} = &value {
          let written = Vector.asSlice<InventoryImport>(&imports)
          let mut index = usize.ZERO
          while index < written.length {
            if !Shared.with<Result<Answer, NoRejection>, bool>(&written[index].answer, isNamespace) { sweep.strictSuccess = false }
            index = index + usize.ONE
          }
          if compilerSubject(&sources.*, &module.module) {
            if syntax.excludedDamaged > usize.ZERO { sweep.strictSuccess = false }
            let functions = Vector.asSlice<NamedFunction>(&syntax.functions)
            index = usize.ZERO
            while index < functions.length {
              let signature = run phase(&mut sources.*,&mut store.*, &entry, &functions[index].declaration.identity, Phase.Signature, &mut sweep.phasePublications)
              let body = run phase(&mut sources.*,&mut store.*, &entry, &functions[index].declaration.identity, Phase.Body, &mut sweep.phasePublications)
              if !successful(&signature, Phase.Signature) || !successful(&body, Phase.Body) { sweep.strictSuccess = false }
              run Vector.append<Fact>(&mut module.signatures, move signature)
              run Vector.append<Fact>(&mut module.bodies, move body)
              sweep.functions = sweep.functions + usize.ONE
              sweep.records = sweep.records + 2
              index = index + usize.ONE
            }
          }
        } else {
          module.status = b"missing-source"
          sweep.complete = false
        }
        module.inventory = Option.some<SourceInventory>(move value)
      }
      Result<SourceInventory, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => {
        sweep.complete = false
        module.status = match move error {
          Cycle {} => b"inventory-cycle"
          InvalidModulePath {} => b"invalid-module-path"
          RevisionMismatch {} => b"revision-mismatch"
          OutOfMemoryError exhausted => { fail move exhausted }
        }
      }
    }
    run addObserved(&mut queue, &store.*)
    run addPublished(&mut queue, &sources.*)
    run Vector.append<ModuleSweep>(&mut sweep.modules, move module)
    at = at + usize.ONE
  }
  return move sweep
}

/// A final row belongs to a complete pass that published no source mappings. Earlier passes
/// are discarded, including Signature facts completed before a later Body discovered sources.
pub effect fn collect(sources: &mut ModuleSources, store: &mut Semantic) -> Sweep
! FileError | InvalidModulePath | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut passes = usize.ZERO
  let mut before = run Sources.revision(&sources.*)
  let mut sweep = run collectPass(&mut sources.*, &mut store.*)
  let mut publications = sweep.phasePublications
  let mut after = run Sources.revision(&sources.*)
  passes = passes + usize.ONE
  while Revision.revisionNumber(&before) != Revision.revisionNumber(&after) {
    before = move after
    sweep = run collectPass(&mut sources.*, &mut store.*)
    publications = publications + sweep.phasePublications
    after = run Sources.revision(&sources.*)
    passes = passes + usize.ONE
  }
  sweep.passes = passes
  sweep.phasePublications = publications
  return move sweep
}

pub fn exitCode(sweep: &Sweep) -> i32 {
  if !sweep.complete { return 3 }
  if !sweep.strictSuccess { return 2 }
  return 0
}

fn eligibility(function: &NamedFunction, state: &Result<bool, Shared<Rejection>>) -> Eligibility {
  return match &state.* {
    Result<bool, Shared<Rejection>>.Failure {..} => Eligibility.ConditionRejected
    Result<bool, Shared<Rejection>>.Success {value} => {
      if !value { return Eligibility.Inactive }
      if !function.hasBody { return Eligibility.NoBody }
      return Eligibility.Eligible
    }
  }
}

fn compareBytes(left: &[u8], right: &[u8]) -> i32 {
  let mut at = usize.ZERO
  while at < left.length && at < right.length {
    if left[at] < right[at] { return -1 }
    if left[at] > right[at] { return 1 }
    at = at + usize.ONE
  }
  if left.length < right.length { return -1 }
  if left.length > right.length { return 1 }
  return 0
}

// The normalized source-file prefix orders compiler providers before stdlib providers.
// Canonical identity remains a final tie-breaker, never a substitute for the source mapping.
fn compareSources(sources: &ModuleSources, left: &ModuleId, right: &ModuleId) -> i32 {
  let leftCompiler = Sources.compilerProvider(sources, left)
  let rightCompiler = Sources.compilerProvider(sources, right)
  if leftCompiler && !rightCompiler { return -1 }
  if !leftCompiler && rightCompiler { return 1 }
  let path = compareBytes(ModuleId.logicalPath(left), ModuleId.logicalPath(right))
  if path != 0 { return path }
  let leftSubject = compilerSubject(sources, left)
  let rightSubject = compilerSubject(sources, right)
  if leftSubject && !rightSubject { return -1 }
  if !leftSubject && rightSubject { return 1 }
  return ModuleId.compare(left, right)
}

/// Rows are serialized only after the complete closure has settled. The sorted module records
/// are the digest domain: normalized source_file/role/presence/raw SHA, including absent/library inputs.
pub effect fn encode(sweep: &Sweep, sources: &ModuleSources, pins: &SweepPins) -> Bytes
! FileError | OutOfMemoryError ? &mut Allocator {
  let revision = run Sources.revision(&sources.*)
  let number = Revision.revisionNumber(&revision)
  let mut output = Bytes.make()
  let mut digest = Sha256.make()
  let modules = Vector.asSlice<ModuleSweep>(&sweep.modules)
  // Canonical ordering without mutating retained inventories or depending on discovery order.
  let mut previous = Option.none<usize>()
  let mut emitted = usize.ZERO
  while emitted < modules.length {
    let mut next = Option.none<usize>()
    let mut at = usize.ZERO
    while at < modules.length {
      let mut after = true
      if let Option<usize>.Some {value} = &previous { after = compareSources(sources, &modules[at].module, &modules[value].module) > 0 }
      if after {
        match &next { Option<usize>.None => { next = Option.some<usize>(at) } Option<usize>.Some {value} => { if compareSources(sources, &modules[at].module, &modules[value].module) < 0 { next = Option.some<usize>(at) } } }
      }
      at = at + usize.ONE
    }
    let selected = match move next { Option<usize>.Some {value} => value Option<usize>.None => { break } }
    let module = &modules[selected]
    let observation = run Revision.observe(&revision, &module.module)
    let content = run Observation.copyContent(&observation)
    let hash = match &content { Option<Bytes>.Some {value} => Option.some<[u8; 32]>(Sha256.hash(Bytes.asSlice(&value))) Option<Bytes>.None => Option.none<[u8; 32]>() }
    let location = run Sources.sourceLocation(sources, &module.module)
    let path = match &location.path { Option<Path>.Some {value} => Path.rawBytes(&value) Option<Path>.None => b"" }
    let subject = compilerSubject(sources, &module.module)
    let mut sourceRole: &[u8] = b"stdlib-input"
    if Sources.compilerProvider(sources, &module.module) { sourceRole = b"other-input" }
    if subject { sourceRole = b"compiler-subject" }
    let mut functions = usize.ZERO
    let mut anonymous = usize.ZERO
    let mut damaged = usize.ZERO
    if let Option<SourceInventory>.Some {value: SourceInventory.Present {syntax, ..}} = &module.inventory {
      functions = Vector.length<NamedFunction>(&syntax.functions)
      anonymous = syntax.excludedAnonymous
      damaged = syntax.excludedDamaged
    }
    let mut relative = run Bytes.copy(b"packages/compiler/stdlib/")
    if Sources.compilerProvider(sources, &module.module) { relative = run Bytes.copy(b"compiler/src/") }
    run Bytes.append(&mut relative, ModuleId.logicalPath(&module.module))
    let mut row = Bytes.make()
    run Codec.appendModuleRecord(&mut row, &module.module, Bytes.asSlice(&relative), path, sourceRole, &observation, &hash, number, functions, anonymous, damaged, module.status)
    // Physical roots, canonical audit identities and revision/publication order are excluded
    // from the reproducible input observation digest; final revision stays in emitted rows.
    let mut input = Bytes.make()
    run Codec.appendInputObservation(&mut input, Bytes.asSlice(&relative), sourceRole, Observation.isPresent(&observation), &hash)
    Sha256.update(&mut digest, Bytes.asSlice(&input))
    run Bytes.append(&mut output, Bytes.asSlice(&row))
    if let Option<SourceInventory>.Some {value: SourceInventory.Present {syntax, availability, imports, ..}} = &module.inventory {
      let written = Vector.asSlice<InventoryImport>(&imports)
      at = usize.ZERO
      while at < written.length {
        if !Shared.with<Result<Answer, NoRejection>, bool>(&written[at].answer, isNamespace) {
          let fact = Shared.with<Result<Answer, NoRejection>, Fact>(&written[at].answer, fn(answer: &Result<Answer, NoRejection>) -> Fact { return Codec.classifyAnswer(Phase.Signature, answer) })
          run Codec.appendImportRecord(&mut output, &written[at].declaration, &fact)
        }
        at = at + usize.ONE
      }
      if subject {
        let subjects = Vector.asSlice<NamedFunction>(&syntax.functions)
        let states = Vector.asSlice<Result<bool, Shared<Rejection>>>(&availability)
        let signatures = Vector.asSlice<Fact>(&module.signatures)
        let bodies = Vector.asSlice<Fact>(&module.bodies)
        at = usize.ZERO
        while at < subjects.length {
          run Codec.appendObservedRecord(&mut output, &subjects[at], &observation, &hash, Phase.Signature, eligibility(&subjects[at], &states[at]), &signatures[at], Option.some<usize>(number))
          run Codec.appendObservedRecord(&mut output, &subjects[at], &observation, &hash, Phase.Body, eligibility(&subjects[at], &states[at]), &bodies[at], Option.some<usize>(number))
          at = at + usize.ONE
        }
      }
    }
    previous = Option.some<usize>(selected)
    emitted = emitted + usize.ONE
  }
  run Codec.appendSweepFooter(&mut output, modules.length, sweep.functions, sweep.records, number, sweep.passes, sweep.phasePublications, Sha256.finish(move digest), sweep.complete, sweep.strictSuccess, pins)
  return move output
}
