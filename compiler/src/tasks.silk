//! This repository's tasks, run with `silk task <name>` from `compiler/`.

import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, Exited, ProcessError, ProcessOutcome }
import silk.system.filesystem { DirectoryEntry, FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }
import silk.num.usize

union Tasks {
  CheckRoots { pub stdlib: String },
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "The Silk repository's tasks")
      |> Command.variant(
        "CheckRoots",
        "Run `silk check --roots` on every corpus program, each as a one-module package, and list the programs whose module check roots disagree with the whole-package check",
      )
      |> Command.option("stdlib", Opt.about("The standard library directory") |> Opt.default("../stdlib"))
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.CheckRoots { stdlib } => run checkRoots(String.utf8Bytes(String.view(&stdlib)))
    }
  }
}

pub effect fn main() -> i32 ? &mut HostInput {
  return run Task.main<Tasks>()
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn startsWith(text: &[u8], prefix: &[u8]) -> bool {
  return text.length >= prefix.length && same(Slice.view<u8>(text, usize.ZERO, prefix.length), prefix)
}

fn endsWith(text: &[u8], suffix: &[u8]) -> bool {
  return text.length >= suffix.length && same(Slice.view<u8>(text, text.length - suffix.length, suffix.length), suffix)
}

// Compares, for every corpus program, the module check roots `silk check --roots` reports with the
// whole-package check, and fails when any program differs.
effect fn checkRoots(stdlib: &[u8]) -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let root = run Task.root()
  let corpus = run Path.resolveBytes(&root, b"../corpus")
  let library = run Path.resolveBytes(&root, stdlib)
  let compiler = match move run HostInput.variableNamed("SILK_COMPILER") {
    Option<Bytes>.Some { value } => run Path.fromBytes(Bytes.asSlice(&value))
    Option<Bytes>.None => run Task.abort("SILK_COMPILER is not set; run this with `silk task check-roots`")
  }
  let mut cases = List<Path>.make()
  run programs(&corpus, &mut cases)
  let scratch = run FileSystem.temporaryDirectory(&run Path.make("/tmp"), "check-roots-")
  let mut out = StdoutWriter.make()
  let listed = List<Path>.asSlice(&cases)
  let mut compared = usize.ZERO
  let mut differing = usize.ZERO
  let mut at = usize.ZERO
  while at < listed.length {
    let report = run checkOne(&compiler, &library, &listed[at], &scratch.path, at)
    let lines = Bytes.asSlice(&report)
    let mut start = usize.ZERO
    let mut summary = false
    let mut agrees = false
    let mut only = Bytes.make()
    while start < lines.length {
      let mut end = start
      while end < lines.length && lines[end] != 10 { end = end + usize.ONE }
      let line = Slice.view<u8>(lines, start, end - start)
      if startsWith(line, b"silk-check-roots modules=") {
        summary = true
        agrees = endsWith(line, b" differences=0")
      }
      if startsWith(line, b"silk-check-roots only=") {
        run Bytes.append(&mut only, line)
        run Bytes.append(&mut only, b"\n")
      }
      start = end + usize.ONE
    }
    if summary {
      compared = compared + usize.ONE
      if !agrees {
        differing = differing + usize.ONE
        run Writer.writeAll(b"differs: ") |> Effect.provideMut<Writer>(&mut out)
        run Writer.writeAll(Path.rawBytes(&listed[at])) |> Effect.provideMut<Writer>(&mut out)
        run Writer.writeAll(b"\n") |> Effect.provideMut<Writer>(&mut out)
        run Writer.writeAll(Bytes.asSlice(&only)) |> Effect.provideMut<Writer>(&mut out)
      }
    }
    at = at + usize.ONE
  }
  run FileSystem.releaseIgnored(move scratch)
  let mut line = run Bytes.copy(b"check-roots: ")
  run appendCount(&mut line, compared)
  run Bytes.append(&mut line, b" programs compared\n")
  run Writer.writeAll(Bytes.asSlice(&line)) |> Effect.provideMut<Writer>(&mut out)
  if differing > usize.ZERO { run Task.abort("some programs' check roots differ from the whole-package check") }
}

// The directories below `directory` that hold a `main.silk`, each a corpus program.
effect fn programs(directory: &Path, found: &mut List<Path>) -> () ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let entries = run FileSystem.listDirectory(directory)
  let listed = List<DirectoryEntry>.asSlice(&entries)
  let mut at = usize.ZERO
  while at < listed.length {
    let entry = &listed[at]
    if entry.kind.code == 0 && endsWith(Path.rawBytes(&entry.path), b"/main.silk") {
      run List<Path>.append(&mut found.*, run Path.fromBytes(Path.rawBytes(directory)))
    }
    if entry.kind.code == 1 { run programs(&entry.path, &mut found.*) }
    at = at + usize.ONE
  }
}

// Copies the program in `program` into a new directory below `scratch` as a one-module package,
// checks it with `--roots`, and answers what the check wrote on standard error.
effect fn checkOne(compiler: &Path, library: &Path, program: &Path, scratch: &Path, index: usize) -> Bytes
  ! ProcessError | FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let mut name = run Bytes.copy(b"case-")
  run appendCount(&mut name, index)
  let work = run Path.joinBytes(scratch, Bytes.asSlice(&name))
  run FileSystem.createDirectory(&work)
  run copyTree(program, &work)
  let manifest = run Path.join(&work, "silk.toml")
  run FileSystem.writeFile(&manifest, b"[package]\nname = \"corpus-case\"\nversion = \"0.1.0\"\nsource = \".\"\n")
  let mut request = run ChildProcess.requestWithin(compiler, &work)
  run ChildProcess.addArgument(&mut request, "check")
  run ChildProcess.addArgument(&mut request, "--roots")
  run ChildProcess.addArgument(&mut request, "--stdlib")
  run ChildProcess.addArgumentBytes(&mut request, Path.rawBytes(library))
  let names: [string; 3] = ["PATH", "HOME", "SILK_CLANG"]
  let mut at = usize.ZERO
  while at < names.length {
    if let Option<Bytes>.Some { value } = move run HostInput.variableNamed(names[at]) {
      run ChildProcess.setVariableBytes(&mut request, String.utf8Bytes(names[at]), Bytes.asSlice(&value))
    }
    at = at + usize.ONE
  }
  let ProcessOutcome { value } = move run ChildProcess.submit(&request)
  return match move value {
    Exited outcome => {
      let Exited { code: _, output, errors } = move outcome
      drop output
      move errors
    }
    _ => Bytes.make()
  }
}

// Copies the files below `from` into the directory `to`, leaving out `outcome.json`, the corpus
// program's expected result.
effect fn copyTree(from: &Path, to: &Path) -> () ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let entries = run FileSystem.listDirectory(from)
  let listed = List<DirectoryEntry>.asSlice(&entries)
  let mut at = usize.ZERO
  while at < listed.length {
    let entry = &listed[at]
    let whole = Path.rawBytes(&entry.path)
    let base = Slice.view<u8>(whole, Path.rawBytes(from).length + usize.ONE, whole.length - Path.rawBytes(from).length - usize.ONE)
    let target = run Path.joinBytes(to, base)
    if entry.kind.code == 1 {
      run FileSystem.createDirectory(&target)
      run copyTree(&entry.path, &target)
    } else if entry.kind.code == 0 && !same(base, b"outcome.json") {
      let contents = run FileSystem.readFile(&entry.path)
      run FileSystem.writeFile(&target, Bytes.asSlice(&contents))
    }
    at = at + usize.ONE
  }
}

effect fn appendCount(text: &mut Bytes, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 { run appendCount(&mut text.*, value / 10) }
  let digit = [usize.toU8(48 + value % 10)]
  run Bytes.append(&mut text.*, &digit)
}
