//! Progress counts and durations read the same in every row.

import Progress { Progress }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.testing { AssertionError, Testing }
import silk.u64
import silk.usize

effect fn same(left: &Bytes, right: &[u8]) -> bool {
  let bytes = Bytes.asSlice(left)
  if bytes.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < bytes.length {
    if bytes[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn counted(value: usize) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = Bytes.make()
  run Progress.appendCount(&mut text, value)
  return move text
}

effect fn timed(nanos: u64) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = Bytes.make()
  run Progress.appendDuration(&mut text, nanos)
  return move text
}

// Whether `value` formats as `expected`, as a count or, with `duration`, as nanoseconds.
effect fn reads(value: u64, duration: bool, expected: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = Bytes.make()
  if duration {
    text = run timed(value)
  } else {
    text = run counted(u64.toUsize(value))
  }
  return run same(&text, expected)
}

// Whether `nanos` formats as `expected` with millisecond precision.
effect fn readsFine(nanos: u64, expected: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = Bytes.make()
  run Progress.appendFineDuration(&mut text, nanos)
  return run same(&text, expected)
}

effect fn formatting() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let small = run reads(0, false, b"0")
  let below = run reads(999, false, b"999")
  let thousands = run reads(4812, false, b"4,812")
  let millions = run reads(1234567, false, b"1,234,567")
  run Testing.expect(small && below && thousands && millions, "counts group thousands with commas")
  let zero = run reads(0, true, b"0.00s")
  let fraction = run reads(120000000, true, b"0.12s")
  let seconds = run reads(3960000000, true, b"3.96s")
  let edge = run reads(59999999999, true, b"59.99s")
  run Testing.expect(
    zero && fraction && seconds && edge,
    "durations below a minute keep two decimals"
  )
  let minute = run reads(60000000000, true, b"1m 00s")
  let minutes = run reads(125000000000, true, b"2m 05s")
  run Testing.expect(minute && minutes, "durations from a minute on read as minutes and seconds")
  let fine = run readsFine(420000, b"0.42ms")
  let millis = run readsFine(12340000, b"12.3ms")
  let whole = run readsFine(1500000000, b"1.50s")
  run Testing.expect(fine && millis && whole, "fine durations read in milliseconds below a second")
}

test effect fn progressFormatting() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run formatting() |> Effect.provideMut<Allocator>(&mut allocator)
}
