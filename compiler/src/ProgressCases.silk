//! Progress counts and durations read the same in every row.

import Progress { Progress }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.testing.testing { AssertionError, Testing }
import silk.num.u64
import silk.num.usize

effect fn same(left: &Bytes, right: &[u8]) -> bool {
  let bytes = Bytes.asSlice(left)
  if bytes.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < bytes.length {
    if bytes[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn counted(value: usize) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = Bytes.make()
  run Progress.appendCount(&mut text, value)
  return move text
}

effect fn timed(nanos: u64) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = Bytes.make()
  run Progress.appendDuration(&mut text, nanos)
  return move text
}

// Whether `value` formats as `expected`, as a count or, with `duration`, as nanoseconds.
effect fn reads(value: u64, duration: bool, expected: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = Bytes.make()
  if duration {
    text = run timed(value)
  } else {
    text = run counted(u64.toUsize(value))
  }
  return run same(&text, expected)
}

// Whether `nanos` formats as `expected` with millisecond precision.
effect fn readsFine(nanos: u64, expected: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = Bytes.make()
  run Progress.appendFineDuration(&mut text, nanos)
  return run same(&text, expected)
}

effect fn formatting() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let small = run reads(0, false, b"0")
  let below = run reads(999, false, b"999")
  let thousands = run reads(4812, false, b"4,812")
  let millions = run reads(1234567, false, b"1,234,567")
  run Testing.expect(small && below && thousands && millions, "counts group thousands with commas")
  let zero = run reads(0, true, b"0.00s")
  let fraction = run reads(120000000, true, b"0.12s")
  let seconds = run reads(3960000000, true, b"3.96s")
  let edge = run reads(59999999999, true, b"59.99s")
  run Testing.expect(
    zero && fraction && seconds && edge,
    "durations below a minute keep two decimals"
  )
  let minute = run reads(60000000000, true, b"1m 00s")
  let minutes = run reads(125000000000, true, b"2m 05s")
  run Testing.expect(minute && minutes, "durations from a minute on read as minutes and seconds")
  let fine = run readsFine(420000, b"0.42ms")
  let millis = run readsFine(12340000, b"12.3ms")
  let whole = run readsFine(1500000000, b"1.50s")
  run Testing.expect(fine && millis && whole, "fine durations read in milliseconds below a second")
}

test effect fn progressFormatting() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run formatting() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Whether the plain row for `detail` reads `expected`.
effect fn rowReads(name: &[u8], detail: &[u8], succeeded: bool, expected: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let line = run Progress.plainRow(name, detail, 120000000, succeeded)
  return run same(&line, expected)
}

effect fn rows() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let counted = run rowReads(b"check  ", b"97 modules", true, b"  check    97 modules                        0.12s\n")
  run Testing.expect(counted, "a row pads its detail to one column before the time")
  let refused = run rowReads(b"check  ", b"2 modules, 1 error", false, b"  check    failed: 2 modules, 1 error        0.12s\n")
  run Testing.expect(refused, "a failed row names its detail after `failed:`")
  let bare = run rowReads(b"link   ", b"", false, b"  link     failed                            0.12s\n")
  run Testing.expect(bare, "a failed row with nothing to count says only `failed`")
  let full = run rowReads(b"load   ", b"1,234 modules, 1,000 in package xy", true, b"  load     1,234 modules, 1,000 in package xy 0.12s\n")
  let over = run rowReads(b"load   ", b"12,345 modules, 10,000 in package", false, b"  load     failed: 12,345 modules, 10,000 in package 0.12s\n")
  run Testing.expect(full && over, "a detail as wide as the column keeps one space before the time")
}

test effect fn progressRows() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run rows() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Whether `text` folded onto one line reads `expected`.
effect fn foldsTo(text: &[u8], expected: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut folded = Bytes.make()
  run Progress.appendFolded(&mut folded, text, usize.ZERO, text.length)
  return run same(&folded, expected)
}

effect fn folding() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let lines = run foldsTo(b" EntryResult<\n  Effect<'env; () ! E>,\n> for Application<\n  Effect<'env; () ! E>,\n>\n", b"EntryResult<Effect<'env; () ! E>> for Application<Effect<'env; () ! E>>")
  run Testing.expect(lines, "a header over several lines reads as on one, without its trailing commas")
  let spaced = run foldsTo(b"Drop  for\tPair<A,\n  B>", b"Drop for Pair<A, B>")
  run Testing.expect(spaced, "each run of blanks between words becomes one space")
}

test effect fn progressFoldsHeaders() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run folding() |> Effect.provideMut<Allocator>(&mut allocator)
}
