//! Tracy zones around compiler work.
//!
//! An ordinary build leaves `enabled` false: a zone is an empty value and the compiler declares
//! and calls nothing. `compiler/profiling/build-tracy.sh` builds a staged copy with `enabled` set
//! and the Tracy client linked, so each zone becomes a Tracy zone that ends when the value drops.

/// Whether this build links the Tracy client. Only the Tracy build script changes it.
const enabled: bool = false

static if enabled {
  import silk.ownership {Drop}
  import silk.pointer {Pointer}

  // `compiler/profiling/silk_tracy.c`: Tracy's C zone context packed into one word.
  unsafe extern "C" fn silk_tracy_zone_begin(name: ?[*]const u8, size: usize) -> u64
  with Intrinsic.foreign(noCapture: ("name",))
  unsafe extern "C" fn silk_tracy_zone_end(zone: u64) -> ()

  /// One open Tracy zone; dropping it ends the zone.
  pub struct Zone {
    context: u64
  }

  impl Drop for Zone {
    fn drop(self: &mut Zone) -> () {
      unsafe silk_tracy_zone_end(self.context)
      return ()
    }
  }

  /// Opens a zone called `name` that lasts until the returned value drops.
  pub fn zone(name: &[u8]) -> Zone {
    return Zone {context: unsafe silk_tracy_zone_begin(Pointer.fromSlice<u8>(name), name.length)}
  }
} else {
  /// One open Tracy zone; dropping it ends the zone.
  pub struct Zone {}

  /// Opens a zone called `name` that lasts until the returned value drops.
  pub fn zone(name: &[u8]) -> Zone {
    return Zone {}
  }
}
