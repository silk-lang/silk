//! Recoverable import-declaration grammar for the self-hosted parser.
//!
//! # When to use
//!
//! Use [`parseImportDeclaration`] when the current significant token starts `import` or
//! `pub import` syntax.
//!
//! # Details
//!
//! An import declaration contains a dotted path. It can also contain a declaration alias, a member
//! list, or both. A member can have its own alias. A trailing comma is valid in a member list.
//!
//! Path segments accept identifiers and keyword spellings because module path segments are
//! contextual. Member names and alias names require identifier tokens.
//!
//! Each grammar rule appends its child nodes before its parent node. The declaration result
//! therefore contains stable identities into the shared flat node array.
//!
//! # Gotchas
//!
//! A public import requires a member list. If that list is absent, the parser inserts a missing
//! left-brace element and reports a diagnostic.
//!
//! A keyword-spelled final path segment cannot become the implicit namespace binding. Without an
//! alias or member list, the parser reports `ReservedImportBinding` at that segment (IMPORT-007).

import lexer.Span {Span}
import lexer.Token {Token, TokenKind, kind, span}
import parser.Diagnostic {Diagnostic}
import parser.Element {Element}
import parser.Node {Node, NodeKind, elementsOf}
import parser.NodeId {NodeId}
import parser.Grammar
import parser.ParseState {State}
import parser.ParseState
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.option {Option}
import silk.num.usize
import silk.collections.list {List}

fn isImportSegment(tokenKind: TokenKind) -> bool {
  return match tokenKind {
    TokenKind.Identifier => true
    TokenKind.PubKeyword => true
    TokenKind.StructKeyword => true
    TokenKind.EnumKeyword => true
    TokenKind.UnionKeyword => true
    TokenKind.TypeKeyword => true
    TokenKind.ServiceKeyword => true
    TokenKind.InterfaceKeyword => true
    TokenKind.RoleKeyword => true
    TokenKind.EffectKeyword => true
    TokenKind.FnKeyword => true
    TokenKind.RunKeyword => true
    TokenKind.FailKeyword => true
    TokenKind.DropKeyword => true
    TokenKind.UnsafeKeyword => true
    TokenKind.ImplKeyword => true
    TokenKind.ForKeyword => true
    TokenKind.ReturnKeyword => true
    TokenKind.ImportKeyword => true
    TokenKind.AsKeyword => true
    TokenKind.LetKeyword => true
    TokenKind.ConstKeyword => true
    TokenKind.MutKeyword => true
    TokenKind.OnceKeyword => true
    TokenKind.MoveKeyword => true
    TokenKind.MatchKeyword => true
    TokenKind.IfKeyword => true
    TokenKind.ElseKeyword => true
    TokenKind.WhileKeyword => true
    TokenKind.BreakKeyword => true
    TokenKind.ContinueKeyword => true
    TokenKind.TrueKeyword => true
    TokenKind.FalseKeyword => true
    _ => false
  }
}

// The span of a completed import path's final segment when that segment is a reserved word.
fn reservedFinalSegment(state: &State, path: NodeId) -> Option<Span> {
  let nodes = List<Node>.asSlice(&state.nodes)
  let node = &nodes[path.index]
  let elements = elementsOf(&state.elements, node)
  let count = elements.length
  if count == usize.ZERO {
    return Option<Span>.none()
  }
  let last = elements[count - usize.ONE]
  if let Element.Token {id} = last {
    let token = List<Token>.get(&state.tokens, id.index)
    if kind(token) != TokenKind.Identifier {
      return Option<Span>.some(span(token))
    }
  }
  return Option<Span>.none()
}

effect fn parseImportAlias(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let start = ParseState.insertionSpan(&state.*)
  let mut elements = List<Element>.make()
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.AsKeyword)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  return run ParseState.finish(&mut state.*, move elements, NodeKind.ImportAlias, start)
}

effect fn parseImportPath(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let start = ParseState.insertionSpan(&state.*)
  let mut elements = List<Element>.make()
  let following = ParseState.peek(&state.*, 1)
  let startsNextDeclaration = Grammar.declarationStart(&state.*) && following != TokenKind.Dot && following != TokenKind.AsKeyword && following != TokenKind.LeftBrace && following != TokenKind.EndOfFile
  if ParseState.hasCurrent(&state.*) && isImportSegment(ParseState.currentKind(&state.*)) && !startsNextDeclaration {
    run ParseState.consume(&mut state.*, &mut elements)
  } else {
    run ParseState.missing(&mut state.*, &mut elements, TokenKind.Identifier)
  }
  while ParseState.currentKind(&state.*) == TokenKind.Dot {
    run ParseState.consume(&mut state.*, &mut elements)
    if ParseState.hasCurrent(&state.*) && isImportSegment(ParseState.currentKind(&state.*)) {
      run ParseState.consume(&mut state.*, &mut elements)
    } else {
      run ParseState.missing(&mut state.*, &mut elements, TokenKind.Identifier)
      break
    }
  }
  return run ParseState.finish(&mut state.*, move elements, NodeKind.ImportPath, start)
}

effect fn parseImportMember(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let start = ParseState.insertionSpan(&state.*)
  let mut elements = List<Element>.make()
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  if ParseState.currentKind(&state.*) == TokenKind.AsKeyword {
    run ParseState.attach(&mut elements, run parseImportAlias(&mut state.*))
  }
  return run ParseState.finish(&mut state.*, move elements, NodeKind.ImportMember, start)
}

effect fn parseImportMemberList(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let start = ParseState.insertionSpan(&state.*)
  let mut elements = List<Element>.make()
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.LeftBrace)
  let mut parsedMember = false

  while ParseState.currentKind(&state.*) != TokenKind.RightBrace && ParseState.currentKind(&state.*) != TokenKind.EndOfFile && !Grammar.declarationStart(
    &state.*,
  ) {
    if ParseState.currentKind(&state.*) == TokenKind.Identifier {
      run ParseState.attach(&mut elements, run parseImportMember(&mut state.*))
      parsedMember = true
    } else {
      let errorStart = ParseState.insertionSpan(&state.*)
      let mut unexpected = List<Element>.make()
      run ParseState.unexpected(&mut state.*, &mut unexpected)
      run ParseState.attach(
        &mut elements,
        run ParseState.finish(&mut state.*, move unexpected, NodeKind.Error, errorStart),
      )
    }

    if ParseState.currentKind(&state.*) == TokenKind.Comma {
      run ParseState.consume(&mut state.*, &mut elements)
      if ParseState.currentKind(&state.*) == TokenKind.RightBrace {
        break
      }
    } else if ParseState.currentKind(&state.*) == TokenKind.Identifier {
      run ParseState.missing(&mut state.*, &mut elements, TokenKind.Comma)
    } else {
      break
    }
  }

  if !parsedMember {
    run ParseState.attach(&mut elements, run parseImportMember(&mut state.*))
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightBrace)
  return run ParseState.finish(&mut state.*, move elements, NodeKind.ImportMemberList, start)
}

/// Parses one import declaration and appends its nodes to the shared flat node array.
///
/// # When to use
///
/// Use when the current significant tokens start `import` or `pub import`. The returned node identity can
/// become a direct element of the source-file root.
///
/// # Details
///
/// The operation parses the import keyword and one dotted path. It then parses an optional
/// declaration alias and an optional member list. Each member can contain an optional alias.
///
/// Child nodes are complete before the import-declaration node is appended. Syntax problems add
/// diagnostics to the parse state and missing-token or error elements to the node.
///
/// # Gotchas
///
/// If the declaration starts with `pub` and has no member list, the result contains a missing
/// left-brace element. The operation does not consume a token for that inserted element.
pub effect fn parseImportDeclaration(state: &mut State) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let start = ParseState.insertionSpan(&state.*)
  let mut elements = List<Element>.make()
  let mut isPublic = false
  let mut hasMembers = false

  if ParseState.currentKind(&state.*) == TokenKind.PubKeyword {
    isPublic = true
    run ParseState.consume(&mut state.*, &mut elements)
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.ImportKeyword)
  let path = run parseImportPath(&mut state.*)
  let reserved = reservedFinalSegment(&state.*, path)
  run ParseState.attach(&mut elements, path)
  let hasAlias = ParseState.currentKind(&state.*) == TokenKind.AsKeyword

  if hasAlias {
    run ParseState.attach(&mut elements, run parseImportAlias(&mut state.*))
  }

  if ParseState.currentKind(&state.*) == TokenKind.LeftBrace {
    hasMembers = true
    run ParseState.attach(&mut elements, run parseImportMemberList(&mut state.*))
  }

  if isPublic && !hasMembers {
    run ParseState.missing(&mut state.*, &mut elements, TokenKind.LeftBrace)
  }
  // IMPORT-007: a reserved final segment may not become the implicit namespace binding.
  if let Option<Span>.Some {value: segment} = move reserved {
    if !hasAlias && !hasMembers {
      run List<Diagnostic>.append(
        &mut state.diagnostics,
        Diagnostic.ReservedImportBinding {span: segment},
      )
    }
  }

  return run ParseState.finish(&mut state.*, move elements, NodeKind.ImportDeclaration, start)
}
