//! Pattern grammar shared by match arms, conditional bindings, and destructuring declarations.
//!
//! Whole-value bindings, nominal fields, applied variants, enum members, integer cases, and `_`
//! remain distinct node kinds. Field shorthand is retained as a token, not an invented binding.
import lexer.Token {TokenKind}
import parser.Node {NodeKind}
import parser.Element {Element}
import parser.NodeId {NodeId}
import parser.ParseState {State}
import parser.ParseState
import parser.Type
import parser.Lookahead
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize
import silk.collections.list {List}
import parser.Diagnostic {Diagnostic, Habit}

/// Parses the parent type and member name of an applied variant or operation selector.
pub effect fn selector(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = run ParseState.wrap(run Type.named(&mut state.*))
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Dot)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  return run ParseState.complete(&mut state.*, move elements, NodeKind.AppliedMemberSelector)
}

effect fn field(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  if ParseState.currentKind(&state.*) == TokenKind.DotDot {
    run ParseState.consume(&mut state.*, &mut elements)
    return run ParseState.complete(&mut state.*, move elements, NodeKind.RestPattern)
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  if ParseState.currentKind(&state.*) == TokenKind.Colon {
    run ParseState.consume(&mut state.*, &mut elements)
    let value = ParseState.currentKind(&state.*)
    if Lookahead.record(&state.*) || Lookahead.appliedMember(&state.*) || Lookahead.enumMember(&state.*) {
      run ParseState.attach(&mut elements, run parse(&mut state.*))
    } else if value != TokenKind.Identifier && value != TokenKind.Comma && value != TokenKind.RightBrace && value != TokenKind.FatArrow
      && value != TokenKind.LeftBrace && value != TokenKind.EndOfFile && !ParseState.lineBreakBefore(&state.*) {
      // A literal, as in `kind: 3`, is one diagnostic that names the guard form; the literal stays
      // inside the error so the rest of the pattern parses.
      let span = ParseState.spanAt(&state.*, 0)
      let mut literal = List<Element>.make()
      run ParseState.optional(&mut state.*, &mut literal, TokenKind.Minus)
      run ParseState.consume(&mut state.*, &mut literal)
      run List<Diagnostic>.append(&mut state.diagnostics, Diagnostic.ForeignSpelling {habit: Habit.FieldLiteral, span: span})
      run ParseState.attach(&mut elements, run ParseState.complete(&mut state.*, move literal, NodeKind.ErrorPattern))
    } else {
      run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
    }
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.PatternField)
}

effect fn fields(state: &mut State, initial: List<Element>, kind: NodeKind) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let mut elements = move initial
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.LeftBrace)
  while ParseState.currentKind(&state.*) == TokenKind.Identifier || ParseState.currentKind(&state.*) == TokenKind.DotDot {
    run ParseState.attach(&mut elements, run field(&mut state.*))
    if ParseState.currentKind(&state.*) == TokenKind.RightBrace {
      break
    }
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.Comma)
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightBrace)
  return run ParseState.complete(&mut state.*, move elements, kind)
}

/// Parses one complete pattern, stopping before its guard, initializer, or arm separator.
///
/// Invalid starts become error patterns. A missing pattern does not consume the delimiter owned
/// by its enclosing rule, allowing the remainder of the arm or binding to stay navigable.
pub effect fn parse(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  if !ParseState.affordable(&state.*, ParseState.PATTERN_COST) {
    return run ParseState.nestingError(&mut state.*)
  }
  let cost = state.stackCost
  state.stackCost = usize.add(cost, ParseState.PATTERN_COST)
  let node = run parseInner(&mut state.*)
  state.stackCost = cost
  return node
}

effect fn parseInner(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let kind = ParseState.currentKind(&state.*)
  let mut elements = List<Element>.make()
  if ParseState.word(&state.*, "_") {
    run ParseState.consume(&mut state.*, &mut elements)
    return run ParseState.complete(&mut state.*, move elements, NodeKind.UniversalPattern)
  }
  if kind == TokenKind.DecimalInteger || (kind == TokenKind.Minus && ParseState.peek(&state.*, 1) == TokenKind.DecimalInteger) {
    run ParseState.optional(&mut state.*, &mut elements, TokenKind.Minus)
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.DecimalInteger)
    return run ParseState.complete(&mut state.*, move elements, NodeKind.IntegerPattern)
  }
  if Lookahead.appliedMember(&state.*) {
    let selected = run ParseState.wrap(run selector(&mut state.*))
    if ParseState.currentKind(&state.*) == TokenKind.LeftBrace {
      return run fields(&mut state.*, move selected, NodeKind.UnionVariantPattern)
    }
    return run ParseState.complete(&mut state.*, move selected, NodeKind.UnionVariantPattern)
  }
  if Lookahead.enumMember(&state.*) {
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.consume(&mut state.*, &mut elements)
    return run ParseState.complete(&mut state.*, move elements, NodeKind.EnumMemberPattern)
  }
  // A bare name, as in `stock => stock`, is one diagnostic that names the binding form.
  if kind == TokenKind.Identifier && (ParseState.peek(&state.*, 1) == TokenKind.FatArrow || ParseState.peek(&state.*, 1) == TokenKind.IfKeyword) {
    let span = ParseState.spanAt(&state.*, 0)
    run ParseState.consume(&mut state.*, &mut elements)
    run List<Diagnostic>.append(&mut state.diagnostics, Diagnostic.ForeignSpelling {habit: Habit.BarePattern, span: span})
    return run ParseState.complete(&mut state.*, move elements, NodeKind.ErrorPattern)
  }
  if kind == TokenKind.Identifier || kind == TokenKind.LeftBracket || ((kind == TokenKind.MutKeyword || kind == TokenKind.OnceKeyword) && ParseState.peek(
    &state.*,
    1,
  ) == TokenKind.Identifier) {
    let mut typed = run ParseState.wrap(run Type.primary(&mut state.*))
    if ParseState.currentKind(&state.*) == TokenKind.Identifier {
      run ParseState.consume(&mut state.*, &mut typed)
      return run ParseState.complete(&mut state.*, move typed, NodeKind.BindingPattern)
    }
    return run fields(&mut state.*, move typed, NodeKind.NominalPattern)
  }
  // A raw pointer member binds whole, as in `*mut Node node =>`; a pointer has no fields.
  if kind == TokenKind.Star || Type.nullablePointer(&state.*) {
    let mut typed = run ParseState.wrap(run Type.primary(&mut state.*))
    run ParseState.expect(&mut state.*, &mut typed, TokenKind.Identifier)
    return run ParseState.complete(&mut state.*, move typed, NodeKind.BindingPattern)
  }
  if kind == TokenKind.FatArrow || kind == TokenKind.Equals || kind == TokenKind.RightBrace || kind == TokenKind.EndOfFile || kind == TokenKind.IfKeyword {
    run ParseState.missing(&mut state.*, &mut elements, TokenKind.Identifier)
  } else {
    run ParseState.unexpected(&mut state.*, &mut elements)
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.ErrorPattern)
}
