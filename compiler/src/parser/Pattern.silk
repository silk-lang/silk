//! Pattern grammar shared by match arms, conditional bindings, and destructuring declarations.
//!
//! Whole-value bindings, nominal fields, applied variants, enum members, integer cases, and `_`
//! remain distinct node kinds. Field shorthand is retained as a token, not an invented binding.
import lexer.Token {TokenKind}
import parser.Node {NodeKind}
import parser.ParseState {State, ElementsResult, NodeResult}
import parser.ParseState
import parser.Type
import parser.Lookahead
import silk.allocator {Allocator, OutOfMemoryError}
import silk.usize

/// Parses the parent type and member name of an applied variant or operation selector.
pub effect fn selector(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run ParseState.wrap(run Type.named(move initial))
  let afterDot = run move p
    |> ParseState.expect(TokenKind.Dot)
  p = move afterDot
  let afterIdentifier = run move p
    |> ParseState.expect(TokenKind.Identifier)
  p = move afterIdentifier
  return run move p
    |> ParseState.complete(NodeKind.AppliedMemberSelector)
}

effect fn field(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  if ParseState.currentKind(&initial) == TokenKind.DotDot {
    return run ParseState.complete(run ParseState.consume(ParseState.begin(move initial)), NodeKind.RestPattern)
  }
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.Identifier)
  if ParseState.currentKind(&p.state) == TokenKind.Colon {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    if Lookahead.record(&p.state) || Lookahead.appliedMember(&p.state) || Lookahead.enumMember(&p.state) {
      let attached = run ParseState.attach(move p.elements, run parse(move p.state))
      p = move attached
    } else {
      let afterIdentifier = run move p
        |> ParseState.expect(TokenKind.Identifier)
      p = move afterIdentifier
    }
  }
  return run move p
    |> ParseState.complete(NodeKind.PatternField)
}

effect fn fields(initial: ElementsResult, kind: NodeKind) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  let mut p = run move initial
    |> ParseState.expect(TokenKind.LeftBrace)
  while ParseState.currentKind(&p.state) == TokenKind.Identifier || ParseState.currentKind(&p.state) == TokenKind.DotDot {
    let attached = run ParseState.attach(move p.elements, run field(move p.state))
    p = move attached
    if ParseState.currentKind(&p.state) == TokenKind.RightBrace {
      break
    }
    let afterComma = run move p
      |> ParseState.expect(TokenKind.Comma)
    p = move afterComma
  }
  let afterRightBrace = run move p
    |> ParseState.expect(TokenKind.RightBrace)
  p = move afterRightBrace
  return run move p
    |> ParseState.complete(kind)
}

/// Parses one complete pattern, stopping before its guard, initializer, or arm separator.
///
/// Invalid starts become error patterns. A missing pattern does not consume the delimiter owned
/// by its enclosing rule, allowing the remainder of the arm or binding to stay navigable.
pub effect fn parse(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  if initial.depth >= ParseState.NESTING_LIMIT {
    return run move initial
      |> ParseState.nestingError
  }
  let depth = initial.depth
  let mut state = move initial
  state.depth = usize.add(depth, 1)
  let mut result = run parseInner(move state)
  result.state.depth = depth
  return move result
}

effect fn parseInner(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let kind = ParseState.currentKind(&initial)
  if ParseState.word(&initial, "_") {
    return run ParseState.complete(run ParseState.consume(ParseState.begin(move initial)), NodeKind.UniversalPattern)
  }
  if kind == TokenKind.DecimalInteger || (kind == TokenKind.Minus && ParseState.peek(&initial, 1) == TokenKind.DecimalInteger) {
    let mut p = run move initial
      |> ParseState.begin
      |> ParseState.optional(TokenKind.Minus)
    let afterDecimalInteger = run move p
      |> ParseState.expect(TokenKind.DecimalInteger)
    p = move afterDecimalInteger
    return run move p
      |> ParseState.complete(NodeKind.IntegerPattern)
  }
  if Lookahead.appliedMember(&initial) {
    let p = run ParseState.wrap(run selector(move initial))
    if ParseState.currentKind(&p.state) == TokenKind.LeftBrace {
      return run fields(move p, NodeKind.UnionVariantPattern)
    }
    return run move p
      |> ParseState.complete(NodeKind.UnionVariantPattern)
  }
  if Lookahead.enumMember(&initial) {
    let mut p = run move initial
      |> ParseState.begin
      |> ParseState.consume
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    let consumed2 = run move p
      |> ParseState.consume
    p = move consumed2
    return run move p
      |> ParseState.complete(NodeKind.EnumMemberPattern)
  }
  if kind == TokenKind.Identifier || kind == TokenKind.LeftBracket || ((kind == TokenKind.MutKeyword || kind == TokenKind.OnceKeyword) && ParseState.peek(
    &initial,
    1,
  ) == TokenKind.Identifier) {
    let mut p = run ParseState.wrap(run Type.primary(move initial))
    if ParseState.currentKind(&p.state) == TokenKind.Identifier {
      let consumed3 = run move p
        |> ParseState.consume
      p = move consumed3
      return run move p
        |> ParseState.complete(NodeKind.BindingPattern)
    }
    return run fields(move p, NodeKind.NominalPattern)
  }
  let mut p = ParseState.begin(move initial)
  if kind == TokenKind.FatArrow || kind == TokenKind.Equals || kind == TokenKind.RightBrace || kind == TokenKind.EndOfFile || kind == TokenKind.IfKeyword {
    let afterIdentifier = run move p
      |> ParseState.missing(TokenKind.Identifier)
    p = move afterIdentifier
  } else {
    let advanced = run move p
      |> ParseState.unexpected
    p = move advanced
  }
  return run move p
    |> ParseState.complete(NodeKind.ErrorPattern)
}
