//! Parser tests kept beside the self-hosted parser and discovered through the HIR lowering root.

import lexer.Lexer {Lexer}
import lexer.Token {Token, TokenKind}
import parser.Diagnostic {Diagnostic}
import parser.Element {Element}
import parser.Node {Node, NodeKind}
import parser.Parser
import parser.SyntaxTree {SyntaxTree}
import Stream {Stream}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.option {Option}
import silk.string {String}
import silk.testing {AssertionError, Testing}
import silk.usize
import silk.vector {Vector}

/// Lexes and parses `source` with the provided allocator.
pub effect fn parseWithAllocator(source: string<'static>) -> SyntaxTree
! OutOfMemoryError
? &mut Allocator {
  let bytes = run Bytes.copy(String.utf8Bytes(source))
  let mut lexer = Lexer.make(Bytes.asSlice(&bytes))
  let mut tokens = Vector.make<Token>()
  while true {
    let taken = run Stream.take(&mut lexer)
    if let Option<Token>.Some {value} = move taken {
      run Vector.append<Token>(&mut tokens, move value)
    } else {
      break
    }
  }
  return run Parser.parse(move bytes, move tokens)
}

effect fn parseSource(source: string<'static>) -> SyntaxTree ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run parseWithAllocator(source)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

fn nodeTextEquals(tree: &SyntaxTree, node: &Node, text: string<'static>) -> bool {
  let source = Bytes.asSlice(&tree.source)
  let expected = String.utf8Bytes(text)
  if node.span.end - node.span.start != expected.length {
    return false
  }
  let mut offset = usize.ZERO
  while offset < expected.length {
    if source[node.span.start + offset] != expected[offset] {
      return false
    }
    offset = offset + usize.ONE
  }
  return true
}

fn intactNode(tree: &SyntaxTree, node: &Node) -> bool {
  if node.kind == NodeKind.Error || node.kind == NodeKind.ErrorStatement || node.kind == NodeKind.ErrorPattern {
    return false
  }
  let elements = Vector.asSlice<Element>(&node.elements)
  let nodes = Vector.asSlice<Node>(&tree.nodes)
  let mut index = usize.ZERO
  while index < elements.length {
    match elements[index] {
      Element.Node {id} => {
        if !intactNode(tree, &nodes[id.index]) {
          return false
        }
      }
      Element.MissingToken {expected: ignoredExpected, span: ignoredSpan} => {
        return false
      }
      Element.Token {id: ignoredId} => {}
    }
    index = index + usize.ONE
  }
  return true
}

fn hasNode(tree: &SyntaxTree, kind: NodeKind, text: string<'static>) -> bool {
  let nodes = Vector.asSlice<Node>(&tree.nodes)
  let mut index = usize.ZERO
  while index < nodes.length {
    let node = &nodes[index]
    if node.kind == kind && nodeTextEquals(tree, node, text) && intactNode(tree, node) {
      return true
    }
    index = index + usize.ONE
  }
  return false
}

fn hasMissingTokenAt(tree: &SyntaxTree, token: TokenKind, offset: usize) -> bool {
  let diagnostics = Vector.asSlice<Diagnostic>(&tree.diagnostics)
  let mut index = usize.ZERO
  while index < diagnostics.length {
    if let Diagnostic.MissingToken {expected, span} = diagnostics[index] {
      if expected == token && span.start == offset && span.end == offset {
        return true
      }
    }
    index = index + usize.ONE
  }
  return false
}

effect fn acceptedWithWitness(source: string<'static>, kind: NodeKind, text: string<'static>) -> ()
! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(source)
  run Testing.expect(Vector.length<Diagnostic>(&tree.diagnostics) == usize.ZERO, "valid syntax")
  run Testing.expect(hasNode(&tree, kind, text), "expected syntax node")
}

effect fn recoveredWithWitness(source: string<'static>, kind: NodeKind, text: string<'static>) -> ()
! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(source)
  run Testing.expect(
    Vector.length<Diagnostic>(&tree.diagnostics) > usize.ZERO,
    "syntax problem diagnosed",
  )
  run Testing.expect(hasNode(&tree, kind, text), "valid syntax survives recovery")
}

test effect fn nestedCallSiblings() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource("fn main() -> i32 { return combine(identity(1), identity(2)) }")
  run Testing.expect(
    Vector.length<Diagnostic>(&tree.diagnostics) == usize.ZERO,
    "valid nested calls",
  )
  run Testing.expect(hasNode(&tree, NodeKind.CallExpression, "identity(1)"), "first call survives")
  run Testing.expect(hasNode(&tree, NodeKind.CallExpression, "identity(2)"), "second call survives")
}

test effect fn effectEnvironmentIntersection() -> () ! OutOfMemoryError | AssertionError<'static> {
  return run acceptedWithWitness(
    "effect<'call & 'env> fn work(value: Effect<'call & 'env; i32>) -> i32 { return 1 }",
    NodeKind.FunctionDeclaration,
    "effect<'call & 'env> fn work(value: Effect<'call & 'env; i32>) -> i32 { return 1 }",
  )
}

test effect fn contextualTestQualifiers() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    """test fn plain() {}
pub test effect fn effectful() -> () ! i32 { fail 1 }
static if true { test fn selected() {} } else { test fn inactive() {} }
fn test() {}
fn use(test: i32) -> i32 { return test }""",
  )
  run Testing.expect(
    Vector.length<Diagnostic>(&tree.diagnostics) == usize.ZERO,
    "valid contextual test qualifiers",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "test fn plain() {}"),
    "plain test declaration",
  )
  run Testing.expect(
    hasNode(
      &tree,
      NodeKind.FunctionDeclaration,
      "pub test effect fn effectful() -> () ! i32 { fail 1 }",
    ),
    "effectful test declaration",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "fn test() {}"),
    "test stays an identifier",
  )
}

test effect fn moduleCallArgument() -> () ! OutOfMemoryError | AssertionError<'static> {
  return run acceptedWithWitness(
    "fn write(module: i32, name: i32, ok: bool) -> i32 { return module } fn main(module: i32) -> i32 { return write(module, 1, true) }",
    NodeKind.CallExpression,
    "write(module, 1, true)",
  )
}

test effect fn appliedProviderConstraint() -> () ! OutOfMemoryError | AssertionError<'static> {
  return run acceptedWithWitness(
    "fn use<P, A>() -> () where &mut P provides &Service<A> from &mut Service<A> { return () }",
    NodeKind.ProviderConstraint,
    "&mut P provides &Service<A> from &mut Service<A>",
  )
}

test effect fn implementationHeadWhereClause() -> () ! OutOfMemoryError | AssertionError<'static> {
  return run acceptedWithWitness(
    "impl<'p, P> Port for Wrap<'p, P> where &mut P provides &Source from &mut Source { value: Wrap.value }",
    NodeKind.WhereClause,
    "where &mut P provides &Source from &mut Source",
  )
}

test effect fn serviceOperationProperty() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    "service Logger { effect fn log() -> () with Intrinsic.nonParking() } fn after() -> i32 { return 1 }",
  )
  run Testing.expect(
    Vector.length<Diagnostic>(&tree.diagnostics) == usize.ZERO,
    "valid service property",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionPropertyClause, "with Intrinsic.nonParking()"),
    "property survives",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "fn after() -> i32 { return 1 }"),
    "following declaration survives",
  )
}

test effect fn missingParameterCommaRecovers() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    """fn damaged(value: i32 next: i32) -> () {}
fn later() -> i32 { return 7 }""",
  )
  run Testing.expect(
    Vector.length<Diagnostic>(&tree.diagnostics) > usize.ZERO,
    "missing comma diagnosed",
  )
  run Testing.expect(
    hasMissingTokenAt(&tree, TokenKind.Comma, String.byteLength("fn damaged(value: i32 ")),
    "missing comma inserted before next parameter",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.ParameterDeclaration, "next: i32"),
    "later parameter survives",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "fn later() -> i32 { return 7 }"),
    "following function survives",
  )
}

test effect fn unsupportedAnonymousEnvironmentRecovers() -> ()
! OutOfMemoryError | AssertionError<'static> {
  return run recoveredWithWitness(
    """fn damaged() -> () { let use = effect<'call> fn() -> () {} }
fn later() -> i32 { return 7 }""",
    NodeKind.FunctionDeclaration,
    "fn later() -> i32 { return 7 }",
  )
}

test effect fn serviceOperationCloseRecovers() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    """service Logger {
  effect fn broken(message: &[u8] -> ()
  fn enabled() -> bool
}
fn later() -> i32 { return 7 }""",
  )
  run Testing.expect(
    Vector.length<Diagnostic>(&tree.diagnostics) > usize.ZERO,
    "service operation diagnosed",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.ServiceOperation, "fn enabled() -> bool"),
    "next operation survives",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "fn later() -> i32 { return 7 }"),
    "following function survives",
  )
}

test effect fn structFieldCommaReportsAuthoredSyntax() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let source = """
struct Pair {
  first: i32,
  second: i32
}
"""
  let tree = run parseWithAllocator(source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let diagnostics = Vector.asSlice<Diagnostic>(&tree.diagnostics)
  let bytes = String.utf8Bytes(source)
  let mut comma = usize.ZERO
  while comma < bytes.length && bytes[comma] != 44 {
    comma = comma + usize.ONE
  }
  let mut authored = false
  if diagnostics.length == usize.ONE {
    if let Diagnostic.UnexpectedToken {actual, span} = diagnostics[usize.ZERO] {
      authored = actual == TokenKind.Comma && span.start == comma && span.end == comma + usize.ONE
    }
  }
  run Testing.expect(authored, "struct declaration comma reports its exact unexpected-token span")
  return ()
}
