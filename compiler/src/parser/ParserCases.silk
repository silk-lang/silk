//! Parser tests kept beside the self-hosted parser and discovered through the HIR lowering root.

import lexer.Lexer {Lexer}
import lexer.Token {Token, TokenKind}
import parser.Diagnostic {Diagnostic, Habit}
import parser.Element {Element}
import parser.Node {Node, NodeKind, elementsOf}
import parser.Parser
import parser.SyntaxTree {SyntaxTree}
import Stream {Stream}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.option {Option}
import silk.text.string {String}
import silk.testing.testing {AssertionError, Testing}
import silk.num.usize
import silk.collections.list {List}

/// Lexes and parses `source` with the provided allocator.
pub effect fn parseWithAllocator(source: string<'static>) -> SyntaxTree
! OutOfMemoryError
? &mut Allocator {
  let bytes = run Bytes.copy(String.utf8Bytes(source))
  let mut lexer = Lexer.make(Bytes.asSlice(&bytes))
  let mut tokens = List<Token>.make()
  while true {
    let taken = run Stream.take(&mut lexer)
    if let Option<Token>.Some {value} = move taken {
      run List<Token>.append(&mut tokens, move value)
    } else {
      break
    }
  }
  return run Parser.parse(move bytes, move tokens)
}

effect fn parseSource(source: string<'static>) -> SyntaxTree ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run parseWithAllocator(source)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

fn nodeTextEquals(tree: &SyntaxTree, node: &Node, text: string<'static>) -> bool {
  let source = Bytes.asSlice(&tree.source)
  let expected = String.utf8Bytes(text)
  if node.span.end - node.span.start != expected.length {
    return false
  }
  let mut offset = usize.ZERO
  while offset < expected.length {
    if source[node.span.start + offset] != expected[offset] {
      return false
    }
    offset = offset + usize.ONE
  }
  return true
}

fn intactNode(tree: &SyntaxTree, node: &Node) -> bool {
  if node.kind == NodeKind.Error || node.kind == NodeKind.ErrorStatement || node.kind == NodeKind.ErrorPattern {
    return false
  }
  let elements = elementsOf(&tree.elements, node)
  let nodes = List<Node>.asSlice(&tree.nodes)
  let mut index = usize.ZERO
  while index < elements.length {
    match elements[index] {
      Element.Node {id} => {
        if !intactNode(tree, &nodes[id.index]) {
          return false
        }
      }
      Element.MissingToken {expected: ignoredExpected, span: ignoredSpan} => {
        return false
      }
      Element.Token {id: ignoredId} => {}
    }
    index = index + usize.ONE
  }
  return true
}

fn hasNode(tree: &SyntaxTree, kind: NodeKind, text: string<'static>) -> bool {
  let nodes = List<Node>.asSlice(&tree.nodes)
  let mut index = usize.ZERO
  while index < nodes.length {
    let node = &nodes[index]
    if node.kind == kind && nodeTextEquals(tree, node, text) && intactNode(tree, node) {
      return true
    }
    index = index + usize.ONE
  }
  return false
}

// Like [`hasNode`], for a node that keeps an error region, such as the `var` of a recovered binding.
fn hasRecoveredNode(tree: &SyntaxTree, kind: NodeKind, text: string<'static>) -> bool {
  let nodes = List<Node>.asSlice(&tree.nodes)
  let mut index = usize.ZERO
  while index < nodes.length {
    if nodes[index].kind == kind && nodeTextEquals(tree, &nodes[index], text) { return true }
    index = index + usize.ONE
  }
  return false
}

fn hasMissingTokenAt(tree: &SyntaxTree, token: TokenKind, offset: usize) -> bool {
  let diagnostics = List<Diagnostic>.asSlice(&tree.diagnostics)
  let mut index = usize.ZERO
  while index < diagnostics.length {
    if let Diagnostic.MissingToken {expected, span} = diagnostics[index] {
      if expected == token && span.start == offset && span.end == offset {
        return true
      }
    }
    index = index + usize.ONE
  }
  return false
}

effect fn acceptedWithWitness(source: string<'static>, kind: NodeKind, text: string<'static>) -> ()
! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(source)
  run Testing.expect(List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO, "valid syntax")
  run Testing.expect(hasNode(&tree, kind, text), "expected syntax node")
}

effect fn recoveredWithWitness(source: string<'static>, kind: NodeKind, text: string<'static>) -> ()
! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(source)
  run Testing.expect(
    List<Diagnostic>.length(&tree.diagnostics) > usize.ZERO,
    "syntax problem diagnosed",
  )
  run Testing.expect(hasNode(&tree, kind, text), "valid syntax survives recovery")
}

test effect fn nestedCallSiblings() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource("fn main() -> i32 { return combine(identity(1), identity(2)) }")
  run Testing.expect(
    List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO,
    "valid nested calls",
  )
  run Testing.expect(hasNode(&tree, NodeKind.CallExpression, "identity(1)"), "first call survives")
  run Testing.expect(hasNode(&tree, NodeKind.CallExpression, "identity(2)"), "second call survives")
}

test effect fn comparisonsAroundGroupsStayComparisons() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource("""fn f(x: i64, y: i64) -> bool {
  let a = x < y && y > (x + 1)
  let b = pick(x < y, x, y) > (y)
  let c = (x < y) && (y > (x + 1))
  let d = x < y || y > (x)
  return make<i64>(x) > y
}""")
  run Testing.expect(List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO, "every comparison parses")
  run Testing.expect(
    hasNode(&tree, NodeKind.InfixExpression, "x < y && y > (x + 1)") && hasNode(&tree, NodeKind.InfixExpression, "y > (x + 1)"),
    "`&&` ends a generic suffix scan, so `x < y` and `y > (x + 1)` stay comparisons",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.InfixExpression, "pick(x < y, x, y) > (y)") && hasNode(&tree, NodeKind.InfixExpression, "(x < y) && (y > (x + 1))"),
    "a closing parenthesis the suffix did not open ends the scan",
  )
  run Testing.expect(hasNode(&tree, NodeKind.CallExpression, "make<i64>(x)"), "a balanced generic suffix before arguments is still a call")
}

test effect fn tupleTypeReportsOnce() -> () ! OutOfMemoryError | AssertionError<'static> {
  let source = """fn pair() -> (i32, i32) { return (1, 2) }
fn after() -> i32 { return 3 }"""
  let tree = run parseSource(source)
  let diagnostics = List<Diagnostic>.asSlice(&tree.diagnostics)
  let mut reported = false
  if diagnostics.length == usize.ONE {
    if let Diagnostic.TupleTypeSyntax {span} = diagnostics[usize.ZERO] {
      reported = span.start == offsetIn(source, "(i32, i32)") && span.end == span.start + 10
    }
  }
  run Testing.expect(reported, "an anonymous tuple type reports PAR0008 once over the parenthesized list")
  run Testing.expect(
    hasNode(&tree, NodeKind.ReturnStatement, "return (1, 2)") && hasNode(&tree, NodeKind.FunctionDeclaration, "fn after() -> i32 { return 3 }"),
    "the body and the following declaration stay intact",
  )
}

test effect fn constantStructLiteralInitializer() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource("const ORIGIN: Point = Point {x: 0, y: 0}\npub const PAIR: Pair<i32> = Pair<i32> {first: 1, second: 2}\nfn f() -> () {}")
  run Testing.expect(List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO, "a struct literal initializes a constant")
  run Testing.expect(
    hasNode(&tree, NodeKind.StructLiteralExpression, "Point {x: 0, y: 0}")
      && hasNode(&tree, NodeKind.StructLiteralExpression, "Pair<i32> {first: 1, second: 2}"),
    "the literal belongs to the constant's initializer",
  )
}

test effect fn leadingByteOrderMark() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource("\u{FEFF}pub fn main() -> i32 { return 0 }")
  run Testing.expect(List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO,
    "a UTF-8 byte order mark at the start of a file is whitespace, as editors that write one expect")
  let marked = run parseSource("fn f() -> () {}\n\u{FEFF}fn g() -> () {}")
  run Testing.expect(List<Diagnostic>.length(&marked.diagnostics) > usize.ZERO,
    "a byte order mark anywhere else is still an unsupported byte sequence")
}

test effect fn ifUsedAsExpression() -> () ! OutOfMemoryError | AssertionError<'static> {
  let valued = run parseSource("fn f(found: bool) -> () {\n  let first = if found { 1 } else if !found { 2 } else { 3 }\n}")
  run Testing.expect(List<Diagnostic>.length(&valued.diagnostics) == usize.ZERO,
    "an `if` whose else chain ends in a final `else` is an expression")
  let nested = run parseSource("fn f(found: bool) -> () {\n  let first = twice(if found { 1 } else { 2 }, [if found { 3 } else { 4 }, 5])\n}")
  run Testing.expect(List<Diagnostic>.length(&nested.diagnostics) == usize.ZERO,
    "an `if` expression is a call argument and an array element like any other expression")
  let tree = run parseSource("fn f(found: bool) -> () {\n  let first = if found { 1 } else if !found { 2 }\n}")
  let diagnostics = List<Diagnostic>.asSlice(&tree.diagnostics)
  run Testing.expect(diagnostics.length == usize.ONE, "an `if` value without a final `else` reports one diagnostic, not a cascade")
  if diagnostics.length == usize.ONE {
    let mut named = false
    if let Diagnostic.IfExpression {span} = diagnostics[0] { named = span.end - span.start == 2 }
    run Testing.expect(named, "the diagnostic at the `if` keyword says the `if` needs a final `else`")
  }
}

// One habit from another language in a body: exactly one diagnostic, naming `habit` at `width` bytes.
effect fn reportsHabit(body: string<'static>, habit: Habit, width: usize) -> bool ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run habitReported(body, habit, width) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn habitReported(body: string<'static>, habit: Habit, width: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut source = run Bytes.copy(b"fn f(c: bool) -> i32 {\n  let mut i = 0\n  ")
  run Bytes.append(&mut source, String.utf8Bytes(body))
  run Bytes.append(&mut source, b"\n  return i\n}\nfn after() -> i32 { return 3 }")
  let tree = run parseBytes(move source)
  let diagnostics = List<Diagnostic>.asSlice(&tree.diagnostics)
  if diagnostics.length != usize.ONE { return false }
  if let Diagnostic.ForeignSpelling {habit: reported, span} = diagnostics[0] {
    return reported == habit && span.end - span.start == width && hasNode(&tree, NodeKind.FunctionDeclaration, "fn after() -> i32 { return 3 }")
  }
  return false
}

test effect fn habitsFromOtherLanguages() -> () ! OutOfMemoryError | AssertionError<'static> {
  run Testing.expect(run reportsHabit("i += 1", Habit.CompoundAssignment, 2), "`+=` names `i = i + 1`")
  run Testing.expect(run reportsHabit("i *= 2 + 1", Habit.CompoundAssignment, 2), "every compound assignment reports once")
  run Testing.expect(run reportsHabit("i++", Habit.Increment, 2), "a postfix `++` names `i = i + 1`")
  run Testing.expect(run reportsHabit("i--", Habit.Increment, 2), "a postfix `--` too")
  run Testing.expect(run reportsHabit("for n in 0..10 {\n    i = i + n\n  }", Habit.ForIn, 3), "`for ... in` names `while`")
  run Testing.expect(run reportsHabit("var x = 0", Habit.Var, 3), "`var` names `let mut`")
  run Testing.expect(run reportsHabit("i = c ? 1 : 2", Habit.Conditional, 1), "`c ? a : b` names an `if` value")
  run Testing.expect(run reportsHabit("*p = *p + 1", Habit.PrefixDereference, 1), "a C-style `*p` names `p.*` once per line")
  run Testing.expect(run reportsHabit("i = *p", Habit.PrefixDereference, 1), "a prefix `*` in a value names `p.*` too")
  run Testing.expect(run reportsHabit("{\n    let scoped = 1\n  }", Habit.BareBlock, 1), "a bare block names a helper function")
  run Testing.expect(run reportsHabit("i = (-8 >> 1)", Habit.Shift, 2), "`>>` names `shiftRight`")
  run Testing.expect(run reportsHabit("i = i << 2", Habit.Shift, 2), "`<<` names `shiftLeft`")
  run Testing.expect(run reportsHabit("i = Pair { 0: 3, 1: 10 }", Habit.TupleFields, 2), "tuple elements as fields name the positional form")
  let plain = run parseSource("fn f(i: i32, var: i32) -> i32 {\n  let x = i - -1\n  let y = i - -var\n  return x + y\n}")
  run Testing.expect(List<Diagnostic>.length(&plain.diagnostics) == usize.ZERO,
    "spaced unary operators and a binding named `var` stay ordinary Silk")
  let declared = run parseSource("fn f() -> i32 {\n  var x: i32 = 0\n  return x\n}")
  run Testing.expect(List<Diagnostic>.length(&declared.diagnostics) == usize.ONE
      && hasRecoveredNode(&declared, NodeKind.BindingStatement, "var x: i32 = 0"),
    "`var x = ...` stays a binding of `x`, so later uses of `x` resolve")
}

test effect fn vectorAndMaskTypes() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource("fn f(lanes: simd<u8, 4 * 4>, flags: mask<16>, simd: u8) -> &[simd<f32, 4>] { return simd(mask) }")
  run Testing.expect(List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO, "valid vector and mask types")
  run Testing.expect(hasNode(&tree, NodeKind.VectorType, "simd<u8, 4 * 4>") && hasNode(&tree, NodeKind.MaskType, "mask<16>"),
    "a lane count is a static expression")
  run Testing.expect(hasNode(&tree, NodeKind.VectorType, "simd<f32, 4>"), "a vector nests inside another type")
  run Testing.expect(hasNode(&tree, NodeKind.CallExpression, "simd(mask)"),
    "`simd` and `mask` stay ordinary names unless `<` follows them in a type")
}

test effect fn referencesToFixedArrays() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource("fn f<'a>(values: &'a mut [i32; 2], index: usize, view: &[u8]) -> i32 { return 0 }")
  run Testing.expect(List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO, "valid array references")
  run Testing.expect(
    hasNode(&tree, NodeKind.ReferenceType, "&'a mut [i32; 2]") && hasNode(&tree, NodeKind.FixedArrayType, "[i32; 2]"),
    "a semicolon inside the brackets makes a reference to a fixed array",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.ParameterDeclaration, "index: usize") && hasNode(&tree, NodeKind.SliceType, "&[u8]"),
    "the following parameters and a slice type stay intact",
  )
  let nested = run parseSource("fn g(rows: &[&[[u8; 3]; 4]]) -> i32 { return 0 }")
  run Testing.expect(List<Diagnostic>.length(&nested.diagnostics) == usize.ZERO, "valid nested slice and array references")
  run Testing.expect(
    hasNode(&nested, NodeKind.SliceType, "&[&[[u8; 3]; 4]]") && hasNode(&nested, NodeKind.ReferenceType, "&[[u8; 3]; 4]")
      && hasNode(&nested, NodeKind.FixedArrayType, "[[u8; 3]; 4]"),
    "the token after the element type decides between a slice and a fixed array at each level",
  )
}

test effect fn repeatedArraysRetainExpressionOperandsAndOrdinaryArrays() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    """fn arrays() {
  let repeated = [make(1); size + 2]
  let nested = [[7; 0]; 1]
  let empty = []
  let ordinary = [1, 2,]
}
""",
  )
  run Testing.expect(List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO, "array forms parse without damage")
  run Testing.expect(hasNode(&tree, NodeKind.ArrayRepeatExpression, "[make(1); size + 2]"), "repeat syntax owns both expression operands")
  run Testing.expect(hasNode(&tree, NodeKind.CallExpression, "make(1)"), "the value remains a call")
  run Testing.expect(hasNode(&tree, NodeKind.InfixExpression, "size + 2"), "the count retains expression precedence")
  run Testing.expect(hasNode(&tree, NodeKind.ArrayRepeatExpression, "[[7; 0]; 1]"), "repeat expressions nest")
  run Testing.expect(hasNode(&tree, NodeKind.ArrayLiteralExpression, "[]"), "empty arrays remain ordinary arrays")
  return run Testing.expect(hasNode(&tree, NodeKind.ArrayLiteralExpression, "[1, 2,]"), "ordinary trailing commas remain accepted")
}

effect fn rejectedArrayRepeat(source: string<'static>, expected: TokenKind, prefix: string<'static>) -> ()
! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(source)
  run Testing.expect(
    hasMissingTokenAt(&tree, expected, String.byteLength(prefix)),
    "malformed repeat reports the required token at its authored boundary",
  )
  return run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "fn later() {}"),
    "malformed repeat preserves the next declaration",
  )
}

test effect fn repeatedArraysDiagnoseMissingAndExtraOperands() -> ()
! OutOfMemoryError | AssertionError<'static> {
  run rejectedArrayRepeat(
    """fn damaged() { let a = [; 2] }
fn later() {}
""",
    TokenKind.Identifier,
    "fn damaged() { let a = [",
  )
  run rejectedArrayRepeat(
    """fn damaged() { let a = [7; ] }
fn later() {}
""",
    TokenKind.Identifier,
    "fn damaged() { let a = [7; ",
  )
  run rejectedArrayRepeat(
    """fn damaged() { let a = [7;
fn later() {}
""",
    TokenKind.Identifier,
    """fn damaged() { let a = [7;
""",
  )
  run rejectedArrayRepeat(
    """fn damaged() { let a = [7; 2, 3] }
fn later() {}
""",
    TokenKind.RightBracket,
    "fn damaged() { let a = [7; 2",
  )
  return run rejectedArrayRepeat(
    """fn damaged() { let a = [7, 8; 2] }
fn later() {}
""",
    TokenKind.Comma,
    "fn damaged() { let a = [7, 8",
  )
}

test effect fn effectEnvironmentIntersection() -> () ! OutOfMemoryError | AssertionError<'static> {
  return run acceptedWithWitness(
    "effect<'call & 'env> fn work(value: Effect<'call & 'env; i32>) -> i32 { return 1 }",
    NodeKind.FunctionDeclaration,
    "effect<'call & 'env> fn work(value: Effect<'call & 'env; i32>) -> i32 { return 1 }",
  )
}

test effect fn contextualTestQualifiers() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    """test fn plain() {}
pub test effect fn effectful() -> () ! i32 { fail 1 }
static if true { test fn selected() {} } else { test fn inactive() {} }
fn test() {}
fn use(test: i32) -> i32 { return test }""",
  )
  run Testing.expect(
    List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO,
    "valid contextual test qualifiers",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "test fn plain() {}"),
    "plain test declaration",
  )
  run Testing.expect(
    hasNode(
      &tree,
      NodeKind.FunctionDeclaration,
      "pub test effect fn effectful() -> () ! i32 { fail 1 }",
    ),
    "effectful test declaration",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "fn test() {}"),
    "test stays an identifier",
  )
}

test effect fn patternWhileStatement() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    "fn drain(queue: &mut Queue) -> () { while let Option<i32>.Some { value } = move run pop(&mut queue.*) { drop value } }",
  )
  run Testing.expect(List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO, "valid while let")
  run Testing.expect(
    hasNode(
      &tree,
      NodeKind.PatternWhileStatement,
      "while let Option<i32>.Some { value } = move run pop(&mut queue.*) { drop value }",
    ),
    "the loop keeps its pattern, subject, and body",
  )
  run Testing.expect(hasNode(&tree, NodeKind.UnionVariantPattern, "Option<i32>.Some { value }"), "the pattern survives")
}

test effect fn patternWhileMissingEqualsRecovers() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    """fn damaged(value: Option) -> () { while let Option.Some { found } value { drop found } }
fn later() -> i32 { return 7 }""",
  )
  run Testing.expect(
    hasMissingTokenAt(&tree, TokenKind.Equals, String.byteLength("fn damaged(value: Option) -> () { while let Option.Some { found } ")),
    "the missing `=` is inserted after the pattern",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "fn later() -> i32 { return 7 }"),
    "following function survives",
  )
}

test effect fn moduleCallArgument() -> () ! OutOfMemoryError | AssertionError<'static> {
  return run acceptedWithWitness(
    "fn write(module: i32, name: i32, ok: bool) -> i32 { return module } fn main(module: i32) -> i32 { return write(module, 1, true) }",
    NodeKind.CallExpression,
    "write(module, 1, true)",
  )
}

test effect fn appliedProviderConstraint() -> () ! OutOfMemoryError | AssertionError<'static> {
  return run acceptedWithWitness(
    "fn use<P, A>() -> () where &mut P provides &Service<A> from &mut Service<A> { return () }",
    NodeKind.ProviderConstraint,
    "&mut P provides &Service<A> from &mut Service<A>",
  )
}

test effect fn implementationHeadWhereClause() -> () ! OutOfMemoryError | AssertionError<'static> {
  return run acceptedWithWitness(
    "impl<'p, P> Port for Wrap<'p, P> where &mut P provides &Source from &mut Source { value: Wrap.value }",
    NodeKind.WhereClause,
    "where &mut P provides &Source from &mut Source",
  )
}

test effect fn serviceOperationProperty() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    "service Logger { effect fn log() -> () with Intrinsic.nonParking() } fn after() -> i32 { return 1 }",
  )
  run Testing.expect(
    List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO,
    "valid service property",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionPropertyClause, "with Intrinsic.nonParking()"),
    "property survives",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "fn after() -> i32 { return 1 }"),
    "following declaration survives",
  )
}

test effect fn directivesLeadDeclarations() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    """@inline @nonParking
fn hinted() -> i32 { return 1 }
@foreign(memory: "read", noCapture: ("left", "right"))
unsafe extern "C" fn read(left: ?*const u8, right: ?*const u8) -> i32
service Clock { @nonParking effect fn now() -> u64 }
impl Clock for Fixed { @inline effect fn now() -> u64 { return 0 } }
type Compare = @foreign(memory: "none") extern "C" fn(i32, i32) -> i32""",
  )
  run Testing.expect(List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO, "valid directives")
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "@inline @nonParking\nfn hinted() -> i32 { return 1 }"),
    "a function owns the directives before it",
  )
  run Testing.expect(hasNode(&tree, NodeKind.Directive, "@foreign(memory: \"read\", noCapture: (\"left\", \"right\"))"), "named literal arguments")
  run Testing.expect(hasNode(&tree, NodeKind.DirectiveArgument, "noCapture: (\"left\", \"right\")"), "a tuple of literals is one argument")
  run Testing.expect(hasNode(&tree, NodeKind.ServiceOperation, "@nonParking effect fn now() -> u64"), "an operation owns its directive")
  run Testing.expect(hasNode(&tree, NodeKind.Directive, "@inline"), "a member function owns its directive")
  run Testing.expect(
    hasNode(&tree, NodeKind.ForeignFunctionType, "@foreign(memory: \"none\") extern \"C\" fn(i32, i32) -> i32"),
    "a foreign function type owns its directive",
  )
}

test effect fn directiveArgumentsAreLiterals() -> () ! OutOfMemoryError | AssertionError<'static> {
  let named = run parseSource("@features(LIMIT) fn f() -> i32 { return 1 }")
  run Testing.expect(List<Diagnostic>.length(&named.diagnostics) > usize.ZERO, "a name is no directive argument")
  let called = run parseSource("@features(make()) fn f() -> i32 { return 1 }")
  run Testing.expect(List<Diagnostic>.length(&called.diagnostics) > usize.ZERO, "a call is no directive argument")
  run acceptedWithWitness("@features(\"avx2\", \"bmi2\") fn f() -> i32 { return 1 }", NodeKind.Directive, "@features(\"avx2\", \"bmi2\")")
}

test effect fn directiveBeforeImportIsMisplaced() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource("@inline\nimport silk.collections.list {List}\nfn after() -> i32 { return 1 }")
  let diagnostics = List<Diagnostic>.asSlice(&tree.diagnostics)
  let mut atDirective = false
  if diagnostics.length > usize.ZERO {
    if let Diagnostic.UnexpectedToken {actual, span} = diagnostics[usize.ZERO] {
      atDirective = actual == TokenKind.At && span.start == usize.ZERO
    }
  }
  run Testing.expect(atDirective, "a directive before an import is reported at its `@`")
  run Testing.expect(hasNode(&tree, NodeKind.FunctionDeclaration, "fn after() -> i32 { return 1 }"), "the next declaration survives")
}

test effect fn roleMarkerIsHash() -> () ! OutOfMemoryError | AssertionError<'static> {
  return run acceptedWithWitness("fn read(value: &Port #Reader) -> () { return () }", NodeKind.ReferenceType, "&Port #Reader")
}

test effect fn missingParameterCommaRecovers() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    """fn damaged(value: i32 next: i32) -> () {}
fn later() -> i32 { return 7 }""",
  )
  run Testing.expect(
    List<Diagnostic>.length(&tree.diagnostics) > usize.ZERO,
    "missing comma diagnosed",
  )
  run Testing.expect(
    hasMissingTokenAt(&tree, TokenKind.Comma, String.byteLength("fn damaged(value: i32 ")),
    "missing comma inserted before next parameter",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.ParameterDeclaration, "next: i32"),
    "later parameter survives",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "fn later() -> i32 { return 7 }"),
    "following function survives",
  )
}

test effect fn missingBodyBraceReportsOnce() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    """fn escaped(byte: u8) -> u8
  if byte == 98 {
    return 8
  }
  return byte
}
fn later() -> i32 { return 7 }""",
  )
  run Testing.expect(
    List<Diagnostic>.length(&tree.diagnostics) == 1,
    "the missing brace is the only diagnostic",
  )
  run Testing.expect(
    hasMissingTokenAt(&tree, TokenKind.LeftBrace, String.byteLength("fn escaped(byte: u8) -> u8\n  ")),
    "missing body brace diagnosed",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "fn later() -> i32 { return 7 }"),
    "following function survives",
  )
}

test effect fn missingParameterCloseReportsOnce() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    """fn damaged(value: i32 {}
fn later() -> i32 { return 7 }""",
