test effect fn structFieldCommaReportsAuthoredSyntax() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let source = """
struct Pair {
  first: i32,
  second: i32
}
"""
  let tree = run parseWithAllocator(source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let diagnostics = List<Diagnostic>.asSlice(&tree.diagnostics)
  let bytes = String.utf8Bytes(source)
  let mut comma = usize.ZERO
  while comma < bytes.length && bytes[comma] != 44 {
    comma = comma + usize.ONE
  }
  let mut authored = false
  if diagnostics.length == usize.ONE {
    if let Diagnostic.UnexpectedToken {actual, span} = diagnostics[usize.ZERO] {
      authored = actual == TokenKind.Comma && span.start == comma && span.end == comma + usize.ONE
    }
  }
  run Testing.expect(authored, "struct declaration comma reports its exact unexpected-token span")
  return ()
}

test effect fn aliasBoundListReportsFirstPlusOnce() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let source = "type Both = A + B + C\nfn later() -> i32 { return 7 }\n"
  let tree = run parseWithAllocator(source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let diagnostics = List<Diagnostic>.asSlice(&tree.diagnostics)
  let mut plus = usize.ZERO
  let bytes = String.utf8Bytes(source)
  while plus < bytes.length && bytes[plus] != 43 {
    plus = plus + usize.ONE
  }
  let mut reported = false
  if diagnostics.length == usize.ONE {
    if let Diagnostic.UnexpectedToken {actual, span} = diagnostics[usize.ZERO] {
      reported = actual == TokenKind.Plus && span.start == plus && span.end == plus + usize.ONE
    }
  }
  run Testing.expect(reported, "an alias bound list reports its first plus once")
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "fn later() -> i32 { return 7 }"),
    "the declaration after the alias survives",
  )
  return ()
}

fn offsetIn(source: string<'static>, text: string<'static>) -> usize {
  let bytes = String.utf8Bytes(source)
  let wanted = String.utf8Bytes(text)
  let mut start = usize.ZERO
  while start + wanted.length <= bytes.length {
    let mut at = usize.ZERO
    while at < wanted.length && bytes[start + at] == wanted[at] {
      at = at + usize.ONE
    }
    if at == wanted.length {
      return start
    }
    start = start + usize.ONE
  }
  return usize.MAX
}

fn reservedTemplateAt(diagnostic: Diagnostic, start: usize, length: usize) -> bool {
  if let Diagnostic.ReservedTemplate {span} = diagnostic {
    return span.start == start && span.end == start + length
  }
  return false
}

test effect fn reservedTemplateStartsKeepFollowingSyntax() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let source = """pub fn element() -> i32 { return <Button /> return 1 }
pub fn fragment() -> i32 { return <> return 2 }
pub fn after() -> i32 { return 3 }"""
  let tree = run parseSource(source)
  let diagnostics = List<Diagnostic>.asSlice(&tree.diagnostics)
  run Testing.expect(
    diagnostics.length == 2 && reservedTemplateAt(diagnostics[0], offsetIn(source, "<Button />"), 10)
      && reservedTemplateAt(diagnostics[1], offsetIn(source, "<>"), 2),
    "an element or fragment start reports PAR0003 over exactly the skipped template tokens",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.ReturnStatement, "return 1") && hasNode(&tree, NodeKind.ReturnStatement, "return 2")
      && hasNode(&tree, NodeKind.FunctionDeclaration, "pub fn after() -> i32 { return 3 }"),
    "template recovery stops before the following statement and declaration",
  )
}

test effect fn reservedFinalImportSegmentNeedsAnExplicitBinding() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let source = """import silk.effect
import silk.effect { Effect }
import silk.effect as effects
import silk.effect.inner
"""
  let tree = run parseSource(source)
  let diagnostics = List<Diagnostic>.asSlice(&tree.diagnostics)
  let mut reported = false
  if diagnostics.length == usize.ONE {
    if let Diagnostic.ReservedImportBinding {span} = diagnostics[usize.ZERO] {
      reported = span.start == offsetIn(source, "effect") && span.end == span.start + 6
    }
  }
  run Testing.expect(reported, "only the unbound reserved final segment reports PAR0004 at that segment (IMPORT-007)")
}

// A program built at run time and the byte offset of the token its nesting limit names.
struct Built {
  source: Bytes
  at: usize
}

effect fn parseBytes(source: Bytes) -> SyntaxTree ! OutOfMemoryError ? &mut Allocator {
  let mut lexer = Lexer.make(Bytes.asSlice(&source))
  let mut tokens = List<Token>.make()
  while true {
    let taken = run Stream.take(&mut lexer)
    if let Option<Token>.Some {value} = move taken {
      run List<Token>.append(&mut tokens, move value)
    } else {
      break
    }
  }
  return run Parser.parse(move source, move tokens)
}

effect fn repeat(output: &mut Bytes, text: string<'static>, count: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < count {
    run Bytes.append(&mut output.*, String.utf8Bytes(text))
    at = at + usize.ONE
  }
  return ()
}

// `depth` nested copies of `open` around `inner`, closed by `close`, inside `main`. `at` is where
// `inner` starts.
effect fn nested(head: string<'static>, open: string<'static>, inner: string<'static>, close: string<'static>,
  depth: usize, tail: string<'static>) -> Built ! OutOfMemoryError ? &mut Allocator {
  let mut source = run Bytes.copy(String.utf8Bytes(head))
  run repeat(&mut source, open, depth)
  let at = Bytes.length(&source)
  run Bytes.append(&mut source, String.utf8Bytes(inner))
  run repeat(&mut source, close, depth)
  run Bytes.append(&mut source, String.utf8Bytes(tail))
  return Built {source: move source, at: at}
}

// `count` copies of `step` in sequence; `at` is where `last` starts, the start of the final step.
effect fn chained(head: string<'static>, step: string<'static>, count: usize, last: usize, tail: string<'static>) -> Built
! OutOfMemoryError ? &mut Allocator {
  let mut source = run Bytes.copy(String.utf8Bytes(head))
  run repeat(&mut source, step, usize.subtract(count, usize.ONE))
  let at = Bytes.length(&source) + last
  run Bytes.append(&mut source, String.utf8Bytes(step))
  run Bytes.append(&mut source, String.utf8Bytes(tail))
  return Built {source: move source, at: at}
}

// Whether `tree` has no diagnostic at all.
fn clean(tree: &SyntaxTree) -> bool {
  return List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO
}

// Whether the first diagnostic of `tree` is the only nesting limit and starts at `start`.
fn limitedAt(tree: &SyntaxTree, start: usize) -> bool {
  let listed = List<Diagnostic>.asSlice(&tree.diagnostics)
  let mut limits = usize.ZERO
  let mut at = usize.ZERO
  while at < listed.length {
    if let Diagnostic.NestingLimit {..} = listed[at] { limits = limits + usize.ONE }
    at = at + usize.ONE
  }
  if limits != usize.ONE || listed.length == usize.ZERO { return false }
  if let Diagnostic.NestingLimit {limit: ignoredLimit, span} = listed[0] { return span.start == start }
  return false
}

// Parses `deepest`, which must be clean, and `beyond`, one unit past the limit, which must report
// exactly one nesting limit at its recorded token.
effect fn boundary(deepest: Built, beyond: Built) -> bool ! OutOfMemoryError ? &mut Allocator {
  let at = beyond.at
  let accepted = run parseBytes(move deepest.source)
  let rejected = run parseBytes(move beyond.source)
  return clean(&accepted) && limitedAt(&rejected, at)
}

test effect fn nestingBudgetBoundaries() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run nestingBudgetClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nestingBudgetClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let head = "pub fn main() -> i32 {\n  let zero = 0\n  return "
  // EXPR-006: 256 grouped children; the 257th is rejected at its first token, as in the bootstrap.
  run Testing.expect(run boundary(run nested(head, "(", "zero", ")", 256, "\n}\n"), run nested(head, "(", "zero", ")", 257, "\n}\n")),
    "256 grouped children are accepted and the 257th is rejected at its first token (EXPR-006)")
  run Testing.expect(run boundary(run nested(head, "-", "zero", "", 134, "\n}\n"), run nested(head, "-", "zero", "", 135, "\n}\n")),
    "134 prefix operands fit the native stack budget and the 135th is rejected at its first token")
  run Testing.expect(run boundary(run chained("pub fn main() -> i32 {\n  let zero = 0\n  return zero", " + zero", 135, 3, "\n}\n"),
    run chained("pub fn main() -> i32 {\n  let zero = 0\n  return zero", " + zero", 136, 3, "\n}\n")),
    "135 chained operators fit the budget and the 136th operator's operand is rejected")
  let body = "pub fn main() -> i32 {\n"
  let rest = "\n  return 1\n}\n"
  run Testing.expect(run boundary(run levels(body, "while true ", "{", " ", "return 0 ", "} ", 59, rest),
    run levels(body, "while true ", "{", " ", "return 0 ", "} ", 60, rest)),
    "59 nested blocks fit the budget and the 60th block is rejected at its brace")
  run Testing.expect(run boundary(run levels(body, "if true ", "{", " ", "return 0 ", "} ", 44, rest),
    run levels(body, "if true ", "{", " ", "return 0 ", "} ", 45, rest)),
    "44 nested if statements fit the budget and the 45th block is rejected at its brace")
  let arms = "pub fn main() -> i32 {\n  let flag = false\n  "
  run Testing.expect(run boundary(run levels(arms, "return (match flag { _ => ", "{", " ", "return 0", " } })", 43, "\n}\n"),
    run levels(arms, "return (match flag { _ => ", "{", " ", "return 0", " } })", 44, "\n}\n")),
    "43 nested match arms inside grouped children fit the budget and the 44th arm block is rejected at its brace")
  run Testing.expect(run boundary(run nested("struct Box<T> { value: T }\nfn keep(boxed: ", "Box<", "i32", ">", 255, ") -> i32 { return 0 }\n"),
    run nested("struct Box<T> { value: T }\nfn keep(boxed: ", "Box<", "i32", ">", 256, ") -> i32 { return 0 }\n")),
    "255 nested types fit the budget and the 256th is rejected at its first token")
  return ()
}

// `depth` nested levels, each `before`, `mark` and `after`, around `inner`, each closed by `close`.
// `at` is where the last level's `mark` starts.
effect fn levels(head: string<'static>, before: string<'static>, mark: string<'static>, after: string<'static>,
  inner: string<'static>, close: string<'static>, depth: usize, tail: string<'static>) -> Built
! OutOfMemoryError ? &mut Allocator {
  let mut source = run Bytes.copy(String.utf8Bytes(head))
  let mut at = usize.ZERO
  let mut level = usize.ZERO
  while level < depth {
    run Bytes.append(&mut source, String.utf8Bytes(before))
    at = Bytes.length(&source)
    run Bytes.append(&mut source, String.utf8Bytes(mark))
    run Bytes.append(&mut source, String.utf8Bytes(after))
    level = level + usize.ONE
  }
  run Bytes.append(&mut source, String.utf8Bytes(inner))
  run repeat(&mut source, close, depth)
  run Bytes.append(&mut source, String.utf8Bytes(tail))
  return Built {source: move source, at: at}
}
