//! Parser tests kept beside the self-hosted parser and discovered through the HIR lowering root.

import lexer.Lexer {Lexer}
import lexer.Token {Token, TokenKind}
import parser.Diagnostic {Diagnostic}
import parser.Element {Element}
import parser.Node {Node, NodeKind}
import parser.Parser
import parser.SyntaxTree {SyntaxTree}
import Stream {Stream}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.option {Option}
import silk.string {String}
import silk.testing {AssertionError, Testing}
import silk.usize
import silk.list {List}

/// Lexes and parses `source` with the provided allocator.
pub effect fn parseWithAllocator(source: string<'static>) -> SyntaxTree
! OutOfMemoryError
? &mut Allocator {
  let bytes = run Bytes.copy(String.utf8Bytes(source))
  let mut lexer = Lexer.make(Bytes.asSlice(&bytes))
  let mut tokens = List<Token>.make()
  while true {
    let taken = run Stream.take(&mut lexer)
    if let Option<Token>.Some {value} = move taken {
      run List<Token>.append(&mut tokens, move value)
    } else {
      break
    }
  }
  return run Parser.parse(move bytes, move tokens)
}

effect fn parseSource(source: string<'static>) -> SyntaxTree ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run parseWithAllocator(source)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

fn nodeTextEquals(tree: &SyntaxTree, node: &Node, text: string<'static>) -> bool {
  let source = Bytes.asSlice(&tree.source)
  let expected = String.utf8Bytes(text)
  if node.span.end - node.span.start != expected.length {
    return false
  }
  let mut offset = usize.ZERO
  while offset < expected.length {
    if source[node.span.start + offset] != expected[offset] {
      return false
    }
    offset = offset + usize.ONE
  }
  return true
}

fn intactNode(tree: &SyntaxTree, node: &Node) -> bool {
  if node.kind == NodeKind.Error || node.kind == NodeKind.ErrorStatement || node.kind == NodeKind.ErrorPattern {
    return false
  }
  let elements = List<Element>.asSlice(&node.elements)
  let nodes = List<Node>.asSlice(&tree.nodes)
  let mut index = usize.ZERO
  while index < elements.length {
    match elements[index] {
      Element.Node {id} => {
        if !intactNode(tree, &nodes[id.index]) {
          return false
        }
      }
      Element.MissingToken {expected: ignoredExpected, span: ignoredSpan} => {
        return false
      }
      Element.Token {id: ignoredId} => {}
    }
    index = index + usize.ONE
  }
  return true
}

fn hasNode(tree: &SyntaxTree, kind: NodeKind, text: string<'static>) -> bool {
  let nodes = List<Node>.asSlice(&tree.nodes)
  let mut index = usize.ZERO
  while index < nodes.length {
    let node = &nodes[index]
    if node.kind == kind && nodeTextEquals(tree, node, text) && intactNode(tree, node) {
      return true
    }
    index = index + usize.ONE
  }
  return false
}

fn hasMissingTokenAt(tree: &SyntaxTree, token: TokenKind, offset: usize) -> bool {
  let diagnostics = List<Diagnostic>.asSlice(&tree.diagnostics)
  let mut index = usize.ZERO
  while index < diagnostics.length {
    if let Diagnostic.MissingToken {expected, span} = diagnostics[index] {
      if expected == token && span.start == offset && span.end == offset {
        return true
      }
    }
    index = index + usize.ONE
  }
  return false
}

effect fn acceptedWithWitness(source: string<'static>, kind: NodeKind, text: string<'static>) -> ()
! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(source)
  run Testing.expect(List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO, "valid syntax")
  run Testing.expect(hasNode(&tree, kind, text), "expected syntax node")
}

effect fn recoveredWithWitness(source: string<'static>, kind: NodeKind, text: string<'static>) -> ()
! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(source)
  run Testing.expect(
    List<Diagnostic>.length(&tree.diagnostics) > usize.ZERO,
    "syntax problem diagnosed",
  )
  run Testing.expect(hasNode(&tree, kind, text), "valid syntax survives recovery")
}

test effect fn nestedCallSiblings() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource("fn main() -> i32 { return combine(identity(1), identity(2)) }")
  run Testing.expect(
    List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO,
    "valid nested calls",
  )
  run Testing.expect(hasNode(&tree, NodeKind.CallExpression, "identity(1)"), "first call survives")
  run Testing.expect(hasNode(&tree, NodeKind.CallExpression, "identity(2)"), "second call survives")
}

test effect fn referencesToFixedArrays() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource("fn f<'a>(values: &'a mut [i32; 2], index: usize, view: &[u8]) -> i32 { return 0 }")
  run Testing.expect(List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO, "valid array references")
  run Testing.expect(
    hasNode(&tree, NodeKind.ReferenceType, "&'a mut [i32; 2]") && hasNode(&tree, NodeKind.FixedArrayType, "[i32; 2]"),
    "a semicolon inside the brackets makes a reference to a fixed array",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.ParameterDeclaration, "index: usize") && hasNode(&tree, NodeKind.SliceType, "&[u8]"),
    "the following parameters and a slice type stay intact",
  )
}

test effect fn repeatedArraysRetainExpressionOperandsAndOrdinaryArrays() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    """fn arrays() {
  let repeated = [make(1); size + 2]
  let nested = [[7; 0]; 1]
  let empty = []
  let ordinary = [1, 2,]
}
""",
  )
  run Testing.expect(List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO, "array forms parse without damage")
  run Testing.expect(hasNode(&tree, NodeKind.ArrayRepeatExpression, "[make(1); size + 2]"), "repeat syntax owns both expression operands")
  run Testing.expect(hasNode(&tree, NodeKind.CallExpression, "make(1)"), "the value remains a call")
  run Testing.expect(hasNode(&tree, NodeKind.InfixExpression, "size + 2"), "the count retains expression precedence")
  run Testing.expect(hasNode(&tree, NodeKind.ArrayRepeatExpression, "[[7; 0]; 1]"), "repeat expressions nest")
  run Testing.expect(hasNode(&tree, NodeKind.ArrayLiteralExpression, "[]"), "empty arrays remain ordinary arrays")
  return run Testing.expect(hasNode(&tree, NodeKind.ArrayLiteralExpression, "[1, 2,]"), "ordinary trailing commas remain accepted")
}

effect fn rejectedArrayRepeat(source: string<'static>, expected: TokenKind, prefix: string<'static>) -> ()
! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(source)
  run Testing.expect(
    hasMissingTokenAt(&tree, expected, String.byteLength(prefix)),
    "malformed repeat reports the required token at its authored boundary",
  )
  return run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "fn later() {}"),
    "malformed repeat preserves the next declaration",
  )
}

test effect fn repeatedArraysDiagnoseMissingAndExtraOperands() -> ()
! OutOfMemoryError | AssertionError<'static> {
  run rejectedArrayRepeat(
    """fn damaged() { let a = [; 2] }
fn later() {}
""",
    TokenKind.Identifier,
    "fn damaged() { let a = [",
  )
  run rejectedArrayRepeat(
    """fn damaged() { let a = [7; ] }
fn later() {}
""",
    TokenKind.Identifier,
    "fn damaged() { let a = [7; ",
  )
  run rejectedArrayRepeat(
    """fn damaged() { let a = [7;
fn later() {}
""",
    TokenKind.Identifier,
    """fn damaged() { let a = [7;
""",
  )
  run rejectedArrayRepeat(
    """fn damaged() { let a = [7; 2, 3] }
fn later() {}
""",
    TokenKind.RightBracket,
    "fn damaged() { let a = [7; 2",
  )
  return run rejectedArrayRepeat(
    """fn damaged() { let a = [7, 8; 2] }
fn later() {}
""",
    TokenKind.Comma,
    "fn damaged() { let a = [7, 8",
  )
}

test effect fn effectEnvironmentIntersection() -> () ! OutOfMemoryError | AssertionError<'static> {
  return run acceptedWithWitness(
    "effect<'call & 'env> fn work(value: Effect<'call & 'env; i32>) -> i32 { return 1 }",
    NodeKind.FunctionDeclaration,
    "effect<'call & 'env> fn work(value: Effect<'call & 'env; i32>) -> i32 { return 1 }",
  )
}

test effect fn contextualTestQualifiers() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    """test fn plain() {}
pub test effect fn effectful() -> () ! i32 { fail 1 }
static if true { test fn selected() {} } else { test fn inactive() {} }
fn test() {}
fn use(test: i32) -> i32 { return test }""",
  )
  run Testing.expect(
    List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO,
    "valid contextual test qualifiers",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "test fn plain() {}"),
    "plain test declaration",
  )
  run Testing.expect(
    hasNode(
      &tree,
      NodeKind.FunctionDeclaration,
      "pub test effect fn effectful() -> () ! i32 { fail 1 }",
    ),
    "effectful test declaration",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "fn test() {}"),
    "test stays an identifier",
  )
}

test effect fn patternWhileStatement() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    "fn drain(queue: &mut Queue) -> () { while let Option<i32>.Some { value } = move run pop(&mut queue.*) { drop value } }",
  )
  run Testing.expect(List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO, "valid while let")
  run Testing.expect(
    hasNode(
      &tree,
      NodeKind.PatternWhileStatement,
      "while let Option<i32>.Some { value } = move run pop(&mut queue.*) { drop value }",
    ),
    "the loop keeps its pattern, subject, and body",
  )
  run Testing.expect(hasNode(&tree, NodeKind.UnionVariantPattern, "Option<i32>.Some { value }"), "the pattern survives")
}

test effect fn patternWhileMissingEqualsRecovers() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    """fn damaged(value: Option) -> () { while let Option.Some { found } value { drop found } }
fn later() -> i32 { return 7 }""",
  )
  run Testing.expect(
    hasMissingTokenAt(&tree, TokenKind.Equals, String.byteLength("fn damaged(value: Option) -> () { while let Option.Some { found } ")),
    "the missing `=` is inserted after the pattern",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "fn later() -> i32 { return 7 }"),
    "following function survives",
  )
}

