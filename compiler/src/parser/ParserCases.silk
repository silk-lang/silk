test effect fn serviceOperationProperty() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    "service Logger { effect fn log() -> () with Intrinsic.nonParking() } fn after() -> i32 { return 1 }",
  )
  run Testing.expect(
    List<Diagnostic>.length(&tree.diagnostics) == usize.ZERO,
    "valid service property",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionPropertyClause, "with Intrinsic.nonParking()"),
    "property survives",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "fn after() -> i32 { return 1 }"),
    "following declaration survives",
  )
}

test effect fn missingParameterCommaRecovers() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    """fn damaged(value: i32 next: i32) -> () {}
fn later() -> i32 { return 7 }""",
  )
  run Testing.expect(
    List<Diagnostic>.length(&tree.diagnostics) > usize.ZERO,
    "missing comma diagnosed",
  )
  run Testing.expect(
    hasMissingTokenAt(&tree, TokenKind.Comma, String.byteLength("fn damaged(value: i32 ")),
    "missing comma inserted before next parameter",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.ParameterDeclaration, "next: i32"),
    "later parameter survives",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "fn later() -> i32 { return 7 }"),
    "following function survives",
  )
}

test effect fn missingBodyBraceReportsOnce() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    """fn escaped(byte: u8) -> u8
  if byte == 98 {
    return 8
  }
  return byte
}
fn later() -> i32 { return 7 }""",
  )
  run Testing.expect(
    List<Diagnostic>.length(&tree.diagnostics) == 1,
    "the missing brace is the only diagnostic",
  )
  run Testing.expect(
    hasMissingTokenAt(&tree, TokenKind.LeftBrace, String.byteLength("fn escaped(byte: u8) -> u8\n  ")),
    "missing body brace diagnosed",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "fn later() -> i32 { return 7 }"),
    "following function survives",
  )
}

test effect fn missingParameterCloseReportsOnce() -> () ! OutOfMemoryError | AssertionError<'static> {
  let tree = run parseSource(
    """fn damaged(value: i32 {}
fn later() -> i32 { return 7 }""",
  )
  run Testing.expect(
    List<Diagnostic>.length(&tree.diagnostics) == 1,
    "an unclosed parameter list reports one diagnostic",
  )
  run Testing.expect(
    hasMissingTokenAt(&tree, TokenKind.RightParenthesis, String.byteLength("fn damaged(value: i32 ")),
    "missing parenthesis diagnosed",
  )
  run Testing.expect(
    hasNode(&tree, NodeKind.FunctionDeclaration, "fn later() -> i32 { return 7 }"),
    "following function survives",
  )
}

