//! Statement and block grammar, including local recovery at declaration and match-arm boundaries.
//!
//! Each block owns its braces and direct statements. Conditions disable unparenthesized nominal
//! records so the following brace stays with the block. Function/effect bodies receive an implicit
//! unit return when no syntactic terminal is present; ordinary nested blocks do not.
import lexer.Span {Span}
import lexer.Token
import lexer.Token {TokenKind}
import parser.Diagnostic {Diagnostic, Habit}
import parser.Node {Node, NodeKind, elementsOf}
import parser.NodeId {NodeId}
import parser.Element {Element}
import parser.ParseState {State}
import parser.ParseState
import parser.Grammar
import parser.Type
import parser.Expression
import parser.Pattern
import parser.Lookahead
import silk.allocator {Allocator, OutOfMemoryError}
import silk.list {List}
import silk.usize

effect fn binding(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.consume(&mut state.*, &mut elements)
  let mut nodeKind = NodeKind.BindingStatement
  let kind = ParseState.currentKind(&state.*)
  let ordinary = kind == TokenKind.MutKeyword || kind == TokenKind.StaticKeyword || kind == TokenKind.Equals || (kind == TokenKind.Identifier && !ParseState.word(
    &state.*,
    "_",
  ) && (ParseState.peek(&state.*, 1) == TokenKind.Colon || ParseState.peek(&state.*, 1) == TokenKind.Equals))
  if ordinary {
    if kind == TokenKind.MutKeyword || kind == TokenKind.StaticKeyword {
      run ParseState.consume(&mut state.*, &mut elements)
    }
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
    if ParseState.currentKind(&state.*) == TokenKind.Colon {
      run ParseState.consume(&mut state.*, &mut elements)
      run ParseState.attach(&mut elements, run Type.parse(&mut state.*))
    }
  } else {
    run ParseState.attach(&mut elements, run Pattern.parse(&mut state.*))
    nodeKind = NodeKind.PatternBindingStatement
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Equals)
  run ParseState.attach(&mut elements, run Expression.parse(&mut state.*, true))
  return run ParseState.complete(&mut state.*, move elements, nodeKind)
}

pub effect fn conditional(state: &mut State, isStatic: bool) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  if !ParseState.affordable(&state.*, ParseState.CONDITIONAL_COST) {
    return run ParseState.nestingError(&mut state.*)
  }
  let cost = state.stackCost
  state.stackCost = usize.add(cost, ParseState.CONDITIONAL_COST)
  let node = run conditionalInner(&mut state.*, isStatic)
  state.stackCost = cost
  return node
}

effect fn conditionalInner(state: &mut State, isStatic: bool) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let mut elements = List<Element>.make()
  if isStatic {
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.StaticKeyword)
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.IfKeyword)
  let pattern = !isStatic && ParseState.currentKind(&state.*) == TokenKind.LetKeyword
  if pattern {
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.attach(&mut elements, run Pattern.parse(&mut state.*))
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.Equals)
  }
  run ParseState.attach(&mut elements, run Expression.parse(&mut state.*, false))
  run ParseState.attach(&mut elements, run block(&mut state.*, false, false))
  if ParseState.currentKind(&state.*) == TokenKind.ElseKeyword {
    run ParseState.consume(&mut state.*, &mut elements)
    if !isStatic && ParseState.currentKind(&state.*) == TokenKind.IfKeyword {
      run ParseState.attach(&mut elements, run conditional(&mut state.*, false))
    } else {
      run ParseState.attach(&mut elements, run block(&mut state.*, false, false))
    }
  }
  if isStatic {
    return run ParseState.complete(&mut state.*, move elements, NodeKind.StaticConditionalStatement)
  }
  if pattern {
    return run ParseState.complete(&mut state.*, move elements, NodeKind.PatternConditionalStatement)
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.ConditionalStatement)
}

/// Whether conditional `id` ends every `else if` link in an `else` block, so that each path
/// selects a branch. A damaged or nesting-limited conditional is not one.
pub fn selectsValue(state: &State, id: NodeId) -> bool {
  let nodes = List<Node>.asSlice(&state.nodes)
  let node = &nodes[id.index]
  if node.kind != NodeKind.ConditionalStatement && node.kind != NodeKind.PatternConditionalStatement {
    return false
  }
  let elements = elementsOf(&state.elements, node)
  let mut otherwise = false
  let mut index: usize = 0
  while index < elements.length {
    match elements[index] {
      Element.Token {id: token} => {
        if Token.kind(List<Token.Token>.get(&state.tokens, token.index)) == TokenKind.ElseKeyword { otherwise = true }
      }
      Element.Node {id: child} => {
        if otherwise {
          if nodes[child.index].kind == NodeKind.Block { return true }
          return selectsValue(state, child)
        }
      }
      _ => ()
    }
    index = index + 1
  }
  return false
}

effect fn staticFor(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.consume(&mut state.*, &mut elements)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.ForKeyword)
  if ParseState.word(&state.*, "in") {
    run ParseState.missing(&mut state.*, &mut elements, TokenKind.Identifier)
  } else {
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  }
  run ParseState.contextual(&mut state.*, &mut elements, "in")
  run ParseState.attach(&mut elements, run Expression.parse(&mut state.*, false))
  run ParseState.attach(&mut elements, run block(&mut state.*, false, false))
  return run ParseState.complete(&mut state.*, move elements, NodeKind.StaticForStatement)
}

effect fn whileStatement(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.consume(&mut state.*, &mut elements)
  let pattern = ParseState.currentKind(&state.*) == TokenKind.LetKeyword
  if pattern {
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.attach(&mut elements, run Pattern.parse(&mut state.*))
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.Equals)
  }
  run ParseState.attach(&mut elements, run Expression.parse(&mut state.*, false))
  run ParseState.attach(&mut elements, run block(&mut state.*, false, false))
  if pattern {
    return run ParseState.complete(&mut state.*, move elements, NodeKind.PatternWhileStatement)
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.WhileStatement)
}

effect fn transfer(state: &mut State, kind: NodeKind) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.consume(&mut state.*, &mut elements)
  return run ParseState.complete(&mut state.*, move elements, kind)
}

effect fn valueStatement(state: &mut State, kind: NodeKind) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.consume(&mut state.*, &mut elements)
  if kind == NodeKind.ReturnStatement && ParseState.currentKind(&state.*) == TokenKind.RightBrace {
    run ParseState.attach(
      &mut elements,
      run ParseState.complete(&mut state.*, List<Element>.make(), NodeKind.UnitExpression),
    )
  } else {
    if kind == NodeKind.FailStatement {
      run ParseState.optional(&mut state.*, &mut elements, TokenKind.MoveKeyword)
    }
    run ParseState.attach(&mut elements, run Expression.parse(&mut state.*, true))
  }
  return run ParseState.complete(&mut state.*, move elements, kind)
}

// `loop { ... }` is not Silk: one diagnostic at the word replaces an unknown-type cascade, and
// the skipped body stays inside the error statement.
effect fn loopStatement(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.consume(&mut state.*, &mut elements)
  run ParseState.attach(&mut elements, run block(&mut state.*, false, false))
  let error = run ParseState.complete(&mut state.*, move elements, NodeKind.Error)
  let start = List<Node>.asSlice(&state.nodes)[error.index].span.start
  run List<Diagnostic>.append(&mut state.diagnostics, Diagnostic.LoopStatement {span: Span.make(start, start + 4)})
  return run ParseState.complete(&mut state.*, run ParseState.wrap(error), NodeKind.ErrorStatement)
}

// `var x = 0` is not Silk, but its intent is plain: one diagnostic at `var` names `let mut`, and the
// statement stays a binding of `x` behind an error region holding `var`, so later uses of `x` resolve
// instead of each reporting an unknown value.
effect fn foreignBinding(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let span = ParseState.spanAt(&state.*, 0)
  let mut stray = List<Element>.make()
  run ParseState.consume(&mut state.*, &mut stray)
  let mut elements = run ParseState.wrap(run ParseState.complete(&mut state.*, move stray, NodeKind.Error))
  run ParseState.consume(&mut state.*, &mut elements)
  if ParseState.currentKind(&state.*) == TokenKind.Colon {
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.attach(&mut elements, run Type.parse(&mut state.*))
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Equals)
  run ParseState.attach(&mut elements, run Expression.parse(&mut state.*, true))
  run List<Diagnostic>.append(&mut state.diagnostics, Diagnostic.ForeignSpelling {habit: Habit.Var, span: span})
  return run ParseState.complete(&mut state.*, move elements, NodeKind.BindingStatement)
}

// `for i in 0..10 { ... }` and other `var` forms are not Silk: one diagnostic at the keyword names the Silk
// form, and the rest of the statement stays inside the error statement so nothing after it cascades.
effect fn foreignStatement(state: &mut State, habit: Habit) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let span = ParseState.spanAt(&state.*, 0)
  let mut elements = List<Element>.make()
  run ParseState.consume(&mut state.*, &mut elements)
  if habit == Habit.ForIn {
    while true {
      let kind = ParseState.currentKind(&state.*)
      if kind == TokenKind.LeftBrace || kind == TokenKind.RightBrace || kind == TokenKind.EndOfFile { break }
      run ParseState.consume(&mut state.*, &mut elements)
    }
    if ParseState.currentKind(&state.*) == TokenKind.LeftBrace {
      run ParseState.attach(&mut elements, run block(&mut state.*, false, false))
    }
  } else {
    while true {
      let kind = ParseState.currentKind(&state.*)
      if kind == TokenKind.Equals || kind == TokenKind.RightBrace || kind == TokenKind.EndOfFile || ParseState.lineBreakBefore(&state.*) { break }
      run ParseState.consume(&mut state.*, &mut elements)
    }
    if ParseState.currentKind(&state.*) == TokenKind.Equals {
      run ParseState.consume(&mut state.*, &mut elements)
      run ParseState.attach(&mut elements, run Expression.parse(&mut state.*, true))
    }
  }
  run List<Diagnostic>.append(&mut state.diagnostics, Diagnostic.ForeignSpelling {habit: habit, span: span})
  let error = run ParseState.complete(&mut state.*, move elements, NodeKind.Error)
  return run ParseState.complete(&mut state.*, run ParseState.wrap(error), NodeKind.ErrorStatement)
}

/// A `return` written as a match arm's value, as in `=> return 1`: one PAR0010 that names the block
/// form, with the statement kept inside the error so nothing after it cascades.
pub effect fn armStatement(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let span = ParseState.spanAt(&state.*, 0)
  let elements = run ParseState.wrap(run parse(&mut state.*))
  run List<Diagnostic>.append(&mut state.diagnostics, Diagnostic.ForeignSpelling {habit: Habit.ArmStatement, span: span})
  return run ParseState.complete(&mut state.*, move elements, NodeKind.Error)
}

/// Parses one ordinary statement; an expression followed by `=` becomes an assignment.
///
/// Assignment-place legality belongs to semantic analysis. Parsing the left side once avoids
/// speculative state copies and discarded node allocations.
pub effect fn parse(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let kind = ParseState.currentKind(&state.*)
  if kind == TokenKind.LetKeyword {
    return run binding(&mut state.*)
  }
  if kind == TokenKind.IfKeyword {
    return run conditional(&mut state.*, false)
  }
  if kind == TokenKind.StaticKeyword && ParseState.peek(&state.*, 1) == TokenKind.IfKeyword {
    return run conditional(&mut state.*, true)
  }
  if kind == TokenKind.StaticKeyword && ParseState.peek(&state.*, 1) == TokenKind.ForKeyword {
    return run staticFor(&mut state.*)
  }
  if kind == TokenKind.WhileKeyword {
    return run whileStatement(&mut state.*)
  }
  if kind == TokenKind.BreakKeyword {
    return run transfer(&mut state.*, NodeKind.BreakStatement)
  }
  if kind == TokenKind.ContinueKeyword {
    return run transfer(&mut state.*, NodeKind.ContinueStatement)
  }
  if kind == TokenKind.ReturnKeyword {
    return run valueStatement(&mut state.*, NodeKind.ReturnStatement)
  }
  if kind == TokenKind.FailKeyword {
    return run valueStatement(&mut state.*, NodeKind.FailStatement)
  }
  if kind == TokenKind.DropKeyword {
    return run valueStatement(&mut state.*, NodeKind.DropStatement)
  }
  if kind == TokenKind.UnsafeKeyword && ParseState.peek(&state.*, 1) == TokenKind.LeftBrace {
    let mut elements = List<Element>.make()
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.attach(&mut elements, run block(&mut state.*, false, false))
    return run ParseState.complete(&mut state.*, move elements, NodeKind.UnsafeStatement)
  }
  if kind == TokenKind.Identifier && ParseState.word(&state.*, "loop") && ParseState.peek(&state.*, 1) == TokenKind.LeftBrace {
    return run loopStatement(&mut state.*)
  }
  if kind == TokenKind.ForKeyword {
    return run foreignStatement(&mut state.*, Habit.ForIn)
  }
  if kind == TokenKind.Identifier && ParseState.word(&state.*, "var") && ParseState.peek(&state.*, 1) == TokenKind.Identifier {
    let follower = ParseState.peek(&state.*, 2)
    if follower == TokenKind.Equals || follower == TokenKind.Colon {
      return run foreignBinding(&mut state.*)
    }
    return run foreignStatement(&mut state.*, Habit.Var)
  }
  // A bare block `{ ... }`, as other languages scope a value, is one PAR0010 at its `{`; the block
  // stays inside the error statement so nothing after it cascades.
  if kind == TokenKind.LeftBrace {
    let span = ParseState.spanAt(&state.*, 0)
    let mut elements = List<Element>.make()
    run ParseState.attach(&mut elements, run block(&mut state.*, false, false))
    run List<Diagnostic>.append(&mut state.diagnostics, Diagnostic.ForeignSpelling {habit: Habit.BareBlock, span: span})
    let error = run ParseState.complete(&mut state.*, move elements, NodeKind.Error)
    return run ParseState.complete(&mut state.*, run ParseState.wrap(error), NodeKind.ErrorStatement)
  }
  // A statement opening with `*`, as in `*n = 1`, is parsed so its prefix dereference is named.
  if Grammar.expressionStart(kind) || kind == TokenKind.Star {
    let mut elements = run ParseState.wrap(run Expression.parse(&mut state.*, true))
    if ParseState.currentKind(&state.*) == TokenKind.Equals {
      run ParseState.consume(&mut state.*, &mut elements)
      run ParseState.attach(&mut elements, run Expression.parse(&mut state.*, true))
      return run ParseState.complete(&mut state.*, move elements, NodeKind.AssignmentStatement)
    }
    return run ParseState.complete(&mut state.*, move elements, NodeKind.ExpressionStatement)
  }
  let mut errorElements = List<Element>.make()
  run ParseState.unexpected(&mut state.*, &mut errorElements)
  let error = run ParseState.complete(&mut state.*, move errorElements, NodeKind.Error)
  return run ParseState.complete(&mut state.*, run ParseState.wrap(error), NodeKind.ErrorStatement)
}

fn terminates(state: &State, id: NodeId) -> bool {
  let nodes = List<Node>.asSlice(&state.nodes)
  let node = &nodes[id.index]
  if node.kind == NodeKind.ReturnStatement || node.kind == NodeKind.FailStatement {
    return true
  }
  if node.kind != NodeKind.Block && node.kind != NodeKind.UnsafeStatement && node.kind != NodeKind.ConditionalStatement {
    return false
  }
  let mut branches: usize = 0
  let mut index: usize = 0
  let elements = elementsOf(&state.elements, node)
  while index < elements.length {
    if let Element.Node {id: child} = elements[index] {
      if terminates(state, child) {
        if node.kind != NodeKind.ConditionalStatement {
          return true
        }
        branches = usize.add(branches, 1)
      }
    }
    index = usize.add(index, 1)
  }
  return branches == 2
}

/// Parses a brace-delimited statement block with bounded, local recovery.
///
/// `terminal` requests an implicit unit return when needed. `matchArm` preserves a recognizable
/// following arm when this block is missing its closing brace. A missing opening brace produces an
/// empty recovered block with one diagnostic and leaves the next declaration/statement for its
/// owner.
pub effect fn block(state: &mut State, terminal: bool, matchArm: bool) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  if !ParseState.affordable(&state.*, ParseState.BLOCK_COST) {
    return run ParseState.nestingError(&mut state.*)
  }
  let cost = state.stackCost
  state.stackCost = usize.add(cost, ParseState.BLOCK_COST)
  let node = run blockInner(&mut state.*, terminal, matchArm)
  state.stackCost = cost
  return node
}

effect fn blockInner(state: &mut State, terminal: bool, matchArm: bool) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let opened = ParseState.currentKind(&state.*) == TokenKind.LeftBrace
  let mut elements = List<Element>.make()
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.LeftBrace)
  let mut terminated = false
  if opened {
    while !Grammar.blockEnd(&state.*) && !(matchArm && Lookahead.arm(&state.*)) {
      let before = state.index
      let statement = run parse(&mut state.*)
      if terminates(&state.*, statement) {
        terminated = true
      }
      run ParseState.attach(&mut elements, statement)
      if state.index == before {
        run ParseState.unexpected(&mut state.*, &mut elements)
      }
    }
  }
  if terminal && !terminated {
    let unit = run ParseState.complete(&mut state.*, List<Element>.make(), NodeKind.UnitExpression)
    let statement = run ParseState.complete(&mut state.*, run ParseState.wrap(unit), NodeKind.ReturnStatement)
    run ParseState.attach(&mut elements, statement)
  }
  if opened {
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightBrace)
  } else {
    // A `}` here closes an enclosing construct; the missing `{` already reported this position.
    run ParseState.missing(&mut state.*, &mut elements, TokenKind.RightBrace)
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.Block)
}
