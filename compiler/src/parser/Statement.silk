//! Statement and block grammar, including local recovery at declaration and match-arm boundaries.
//!
//! Each block owns its braces and direct statements. Conditions disable unparenthesized nominal
//! records so the following brace stays with the block. Function/effect bodies receive an implicit
//! unit return when no syntactic terminal is present; ordinary nested blocks do not.
import lexer.Token {TokenKind}
import parser.Node {Node, NodeKind}
import parser.NodeId {NodeId}
import parser.Element {Element}
import parser.ParseState {State, NodeResult}
import parser.ParseState
import parser.Grammar
import parser.Type
import parser.Expression
import parser.Pattern
import parser.Lookahead
import silk.allocator {Allocator, OutOfMemoryError}
import silk.vector {Vector}
import silk.usize

effect fn binding(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.consume
  let mut nodeKind = NodeKind.BindingStatement
  let kind = ParseState.currentKind(&p.state)
  let ordinary = kind == TokenKind.MutKeyword || kind == TokenKind.StaticKeyword || kind == TokenKind.Equals || (kind == TokenKind.Identifier && !ParseState.word(
    &p.state,
    "_",
  ) && (ParseState.peek(&p.state, 1) == TokenKind.Colon || ParseState.peek(&p.state, 1) == TokenKind.Equals))
  if ordinary {
    if kind == TokenKind.MutKeyword || kind == TokenKind.StaticKeyword {
      let consumed = run move p
        |> ParseState.consume
      p = move consumed
    }
    let afterIdentifier = run move p
      |> ParseState.expect(TokenKind.Identifier)
    p = move afterIdentifier
    if ParseState.currentKind(&p.state) == TokenKind.Colon {
      let consumed2 = run move p
        |> ParseState.consume
      p = move consumed2
      let withTypesParse = run ParseState.attach(move p.elements, run Type.parse(move p.state))
      p = move withTypesParse
    }
  } else {
    let withPatternsParse = run ParseState.attach(move p.elements, run Pattern.parse(move p.state))
    p = move withPatternsParse
    nodeKind = NodeKind.PatternBindingStatement
  }
  let afterEquals = run move p
    |> ParseState.expect(TokenKind.Equals)
  p = move afterEquals
  let withExpressionsParse = run ParseState.attach(
    move p.elements,
    run Expression.parse(move p.state, true),
  )
  p = move withExpressionsParse
  return run move p
    |> ParseState.complete(nodeKind)
}

effect fn conditional(initial: State, isStatic: bool) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  if initial.depth >= ParseState.NESTING_LIMIT {
    return run move initial
      |> ParseState.nestingError
  }
  let depth = initial.depth
  let mut state = move initial
  state.depth = usize.add(depth, 1)
  let mut result = run conditionalInner(move state, isStatic)
  result.state.depth = depth
  return move result
}

effect fn conditionalInner(initial: State, isStatic: bool) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  let mut p = ParseState.begin(move initial)
  if isStatic {
    let afterStaticKeyword = run move p
      |> ParseState.expect(TokenKind.StaticKeyword)
    p = move afterStaticKeyword
  }
  let afterIfKeyword = run move p
    |> ParseState.expect(TokenKind.IfKeyword)
  p = move afterIfKeyword
  let pattern = !isStatic && ParseState.currentKind(&p.state) == TokenKind.LetKeyword
  if pattern {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    let withPatternsParse = run ParseState.attach(move p.elements, run Pattern.parse(move p.state))
    p = move withPatternsParse
    let afterEquals = run move p
      |> ParseState.expect(TokenKind.Equals)
    p = move afterEquals
  }
  let withExpressionsParse = run ParseState.attach(
    move p.elements,
    run Expression.parse(move p.state, false),
  )
  p = move withExpressionsParse
  let attached = run ParseState.attach(move p.elements, run block(move p.state, false, false))
  p = move attached
  if ParseState.currentKind(&p.state) == TokenKind.ElseKeyword {
    let consumed2 = run move p
      |> ParseState.consume
    p = move consumed2
    if !isStatic && ParseState.currentKind(&p.state) == TokenKind.IfKeyword {
      let attached2 = run ParseState.attach(move p.elements, run conditional(move p.state, false))
      p = move attached2
    } else {
      let attached3 = run ParseState.attach(move p.elements, run block(move p.state, false, false))
      p = move attached3
    }
  }
  if isStatic {
    return run move p
      |> ParseState.complete(NodeKind.StaticConditionalStatement)
  }
  if pattern {
    return run move p
      |> ParseState.complete(NodeKind.PatternConditionalStatement)
  }
  return run move p
    |> ParseState.complete(NodeKind.ConditionalStatement)
}

effect fn staticFor(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.consume
  let afterForKeyword = run move p
    |> ParseState.expect(TokenKind.ForKeyword)
  p = move afterForKeyword
  if ParseState.word(&p.state, "in") {
    let afterIdentifier = run move p
      |> ParseState.missing(TokenKind.Identifier)
    p = move afterIdentifier
  } else {
    let afterIdentifier2 = run move p
      |> ParseState.expect(TokenKind.Identifier)
    p = move afterIdentifier2
  }
  let advanced = run move p
    |> ParseState.contextual("in")
  p = move advanced
  let withExpressionsParse = run ParseState.attach(
    move p.elements,
    run Expression.parse(move p.state, false),
  )
  p = move withExpressionsParse
  let attached = run ParseState.attach(move p.elements, run block(move p.state, false, false))
  p = move attached
  return run move p
    |> ParseState.complete(NodeKind.StaticForStatement)
}

effect fn whileStatement(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.consume
  let withExpressionsParse = run ParseState.attach(
    move p.elements,
    run Expression.parse(move p.state, false),
  )
  p = move withExpressionsParse
  let attached = run ParseState.attach(move p.elements, run block(move p.state, false, false))
  p = move attached
  return run move p
    |> ParseState.complete(NodeKind.WhileStatement)
}

effect fn transfer(initial: State, kind: NodeKind) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  return run ParseState.complete(run ParseState.consume(ParseState.begin(move initial)), kind)
}

effect fn valueStatement(initial: State, kind: NodeKind) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.consume
  if kind == NodeKind.ReturnStatement && ParseState.currentKind(&p.state) == TokenKind.RightBrace {
    let attached = run ParseState.attach(
      move p.elements,
      run ParseState.complete(ParseState.begin(move p.state), NodeKind.UnitExpression),
    )
    p = move attached
  } else {
    if kind == NodeKind.FailStatement {
      let afterMoveKeyword = run move p
        |> ParseState.optional(TokenKind.MoveKeyword)
      p = move afterMoveKeyword
    }
    let withExpressionsParse = run ParseState.attach(
      move p.elements,
      run Expression.parse(move p.state, true),
    )
    p = move withExpressionsParse
  }
  return run move p
    |> ParseState.complete(kind)
}

/// Parses one ordinary statement; an expression followed by `=` becomes an assignment.
///
/// Assignment-place legality belongs to semantic analysis. Parsing the left side once avoids
/// speculative state copies and discarded node allocations.
pub effect fn parse(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let kind = ParseState.currentKind(&initial)
  if kind == TokenKind.LetKeyword {
    return run binding(move initial)
  }
  if kind == TokenKind.IfKeyword {
    return run conditional(move initial, false)
  }
  if kind == TokenKind.StaticKeyword && ParseState.peek(&initial, 1) == TokenKind.IfKeyword {
    return run conditional(move initial, true)
  }
  if kind == TokenKind.StaticKeyword && ParseState.peek(&initial, 1) == TokenKind.ForKeyword {
    return run staticFor(move initial)
  }
  if kind == TokenKind.WhileKeyword {
    return run whileStatement(move initial)
  }
  if kind == TokenKind.BreakKeyword {
    return run transfer(move initial, NodeKind.BreakStatement)
  }
  if kind == TokenKind.ContinueKeyword {
    return run transfer(move initial, NodeKind.ContinueStatement)
  }
  if kind == TokenKind.ReturnKeyword {
    return run valueStatement(move initial, NodeKind.ReturnStatement)
  }
  if kind == TokenKind.FailKeyword {
    return run valueStatement(move initial, NodeKind.FailStatement)
  }
  if kind == TokenKind.DropKeyword {
    return run valueStatement(move initial, NodeKind.DropStatement)
  }
  if kind == TokenKind.UnsafeKeyword && ParseState.peek(&initial, 1) == TokenKind.LeftBrace {
    let mut p = run move initial
      |> ParseState.begin
      |> ParseState.consume
    let attached = run ParseState.attach(move p.elements, run block(move p.state, false, false))
    p = move attached
    return run move p
      |> ParseState.complete(NodeKind.UnsafeStatement)
  }
  if Grammar.expressionStart(kind) {
    let mut p = run ParseState.wrap(run Expression.parse(move initial, true))
    if ParseState.currentKind(&p.state) == TokenKind.Equals {
      let consumed = run move p
        |> ParseState.consume
      p = move consumed
      let withExpressionsParse = run ParseState.attach(
        move p.elements,
        run Expression.parse(move p.state, true),
      )
      p = move withExpressionsParse
      return run move p
        |> ParseState.complete(NodeKind.AssignmentStatement)
    }
    return run move p
      |> ParseState.complete(NodeKind.ExpressionStatement)
  }
  let error = run ParseState.complete(run ParseState.unexpected(ParseState.begin(move initial)), NodeKind.Error)
  return run ParseState.complete(run ParseState.wrap(move error), NodeKind.ErrorStatement)
}

fn terminates(state: &State, id: NodeId) -> bool {
  let nodes = Vector<Node>.asSlice(&state.nodes)
  let node = &nodes[id.index]
  if node.kind == NodeKind.ReturnStatement || node.kind == NodeKind.FailStatement {
    return true
  }
  if node.kind != NodeKind.Block && node.kind != NodeKind.UnsafeStatement && node.kind != NodeKind.ConditionalStatement {
    return false
  }
  let mut branches: usize = 0
  let mut index: usize = 0
  while index < Vector<Element>.length(&node.elements) {
    if let Element.Node {id: child} = Vector<Element>.get(&node.elements, index) {
      if terminates(state, child) {
        if node.kind != NodeKind.ConditionalStatement {
          return true
        }
        branches = usize.add(branches, 1)
      }
    }
    index = usize.add(index, 1)
  }
  return branches == 2
}

/// Parses a brace-delimited statement block with bounded, local recovery.
///
/// `terminal` requests an implicit unit return when needed. `matchArm` preserves a recognizable
/// following arm when this block is missing its closing brace. Missing opening braces produce an
/// empty recovered block and leave the next declaration/statement for its owner.
pub effect fn block(initial: State, terminal: bool, matchArm: bool) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  if initial.depth >= ParseState.NESTING_LIMIT {
    return run move initial
      |> ParseState.nestingError
  }
  let depth = initial.depth
  let mut state = move initial
  state.depth = usize.add(depth, 1)
  let mut result = run blockInner(move state, terminal, matchArm)
  result.state.depth = depth
  return move result
}

effect fn blockInner(initial: State, terminal: bool, matchArm: bool) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  let opened = ParseState.currentKind(&initial) == TokenKind.LeftBrace
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.LeftBrace)
  let mut terminated = false
  if opened {
    while !Grammar.blockEnd(&p.state) && !(matchArm && Lookahead.arm(&p.state)) {
      let before = p.state.index
      let statement = run parse(move p.state)
      let statementId = statement.node
      if terminates(&statement.state, statementId) {
        terminated = true
      }
      let attached = run ParseState.attach(move p.elements, move statement)
      p = move attached
      if p.state.index == before {
        let advanced = run move p
          |> ParseState.unexpected
        p = move advanced
      }
    }
  }
  if terminal && !terminated {
    let unit = run move p.state
      |> ParseState.begin
      |> ParseState.complete(NodeKind.UnitExpression)
    let statement = run ParseState.complete(run ParseState.wrap(move unit), NodeKind.ReturnStatement)
    let attached2 = run ParseState.attach(move p.elements, move statement)
    p = move attached2
  }
  let afterRightBrace = run move p
    |> ParseState.expect(TokenKind.RightBrace)
  p = move afterRightBrace
  return run move p
    |> ParseState.complete(NodeKind.Block)
}
