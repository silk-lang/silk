//! Syntax problems recorded while the parser preserves a usable partial tree.
//!
//! # When to use
//!
//! Use [`Diagnostic`] to report malformed syntax without discarding valid nodes from the same
//! source file.
//!
//! # Details
//!
//! A diagnostic describes an absent required token, unexpected source, excessive nesting, reserved
//! template syntax, or a reserved implicit import binding. Parser operations append diagnostics in
//! discovery order. Each diagnostic owns the token kind and span needed for a source report.
//!
//! Diagnostics do not stop parsing. A compiler can stop at its first diagnostic, while a tool can
//! continue with unaffected nodes.

import diagnostic.Catalog {Code}
import lexer.Span {Span}
import lexer.Token {TokenKind}
import silk.ownership {Copy}

/// One syntax or stack-safety problem attached to a parser result.
///
/// # Details
///
/// Each variant contains a source span. A missing token uses a zero-width insertion span. An
/// unexpected token uses the span of the source token that recovery consumed.
pub union Diagnostic {
  /// A required grammar token that was absent at a zero-width insertion point.
  MissingToken {
    /// The token kind that the active grammar rule required.
    pub expected: TokenKind,
    /// The zero-width byte span where the parser inserted the conceptual token.
    pub span: Span,
  },
  /// A source token that could not start or continue the active grammar rule.
  UnexpectedToken {
    /// The kind of the source token that recovery consumed.
    pub actual: TokenKind,
    /// The half-open byte span of the consumed source token.
    pub span: Span,
  },
  /// Recursive grammar nesting exceeded the parser's stack-safety bound.
  NestingLimit {
    /// Maximum number of simultaneously active recursive grammar rules.
    pub limit: usize,
    /// Source position at which the over-deep branch began.
    pub span: Span,
  },
  /// A primary expression began reserved template syntax, such as `<Button />` or `<>`.
  ReservedTemplate {
    /// The half-open byte span of the skipped template tokens.
    pub span: Span,
  },
  /// A reserved word ends an import path that has neither an alias nor a member list, so the
  /// import would bind a reserved spelling.
  ReservedImportBinding {
    /// The half-open byte span of the reserved final path segment.
    pub span: Span,
  },
  /// A statement began `loop {`; Silk has no `loop` keyword and writes it `while true {`.
  LoopStatement {
    /// The half-open byte span of the `loop` word.
    pub span: Span,
  },
  /// A type began `?T`; Silk writes an optional type as `Option<T>`.
  OptionalTypeSyntax {
    /// The half-open byte span of the `?`.
    pub span: Span,
  },
  /// A type was written `(A, B)`; Silk has no anonymous tuple type and names one with `tuple`.
  TupleTypeSyntax {
    /// The half-open byte span from the `(` through the `)`.
    pub span: Span,
  },
  /// An `if` without a final `else` was used where a value is expected.
  IfExpression {
    /// The half-open byte span of the `if` keyword.
    pub span: Span,
  },
  /// A spelling from another language that Silk writes differently, such as `x += 1`.
  ForeignSpelling {
    /// Which spelling was written.
    pub habit: Habit,
    /// The half-open byte span of the spelling's operator or keyword.
    pub span: Span,
  },
}

/// A spelling another language accepts and Silk writes differently (PAR0010). Its order is the
/// order of the catalog's templates.
pub enum Habit {
  /// `x += 1` and the other compound assignments.
  CompoundAssignment,
  /// `x++` or `x--`.
  Increment,
  /// `for i in 0..10 { }`.
  ForIn,
  /// `var x = 0`.
  Var,
  /// `c ? a : b`.
  Conditional,
  /// `pattern => return value`: a statement as a match arm's value.
  ArmStatement,
  /// `Variant { field: 3 }`: a literal where a field pattern binds.
  FieldLiteral,
  /// `pattern => value,`: a comma between match arms.
  ArmComma,
  /// `name => value`: a bare name as a whole-value pattern.
  BarePattern,
  /// `*n`: a prefix dereference, which Silk writes `n.*`.
  PrefixDereference,
  /// `{ ... }`: a bare block as a statement.
  BareBlock,
  /// `x << n` or `x >> n`: a shift operator.
  Shift,
  /// `Pair { 0: a, 1: b }`: tuple elements written as fields.
  TupleFields,
}

impl Habit {
  /// The catalog template that names this spelling's Silk form.
  pub fn template(habit: Habit) -> usize {
    return match habit {
      Habit.CompoundAssignment => 0
      Habit.Increment => 1
      Habit.ForIn => 2
      Habit.Var => 3
      Habit.Conditional => 4
      Habit.ArmStatement => 5
      Habit.FieldLiteral => 6
      Habit.ArmComma => 7
      Habit.BarePattern => 8
      Habit.PrefixDereference => 9
      Habit.BareBlock => 10
      Habit.Shift => 11
      Habit.TupleFields => 12
    }
  }
}

impl Copy for Diagnostic {}

impl Diagnostic {
  /// The stable diagnostic code of this syntax problem.
  pub fn code(diagnostic: Diagnostic) -> Code {
    return match move diagnostic {
      Diagnostic.MissingToken {..} => Code.MissingToken
      Diagnostic.UnexpectedToken {..} => Code.UnexpectedTokens
      Diagnostic.NestingLimit {..} => Code.ExpressionNestingLimitExceeded
      Diagnostic.ReservedTemplate {..} => Code.ReservedTemplateSyntax
      Diagnostic.ReservedImportBinding {..} => Code.ReservedImportBinding
      Diagnostic.LoopStatement {..} => Code.LoopStatement
      Diagnostic.OptionalTypeSyntax {..} => Code.OptionalTypeSyntax
      Diagnostic.TupleTypeSyntax {..} => Code.TupleTypeSyntax
      Diagnostic.IfExpression {..} => Code.IfExpression
      Diagnostic.ForeignSpelling {..} => Code.ForeignSpelling
    }
  }
}
