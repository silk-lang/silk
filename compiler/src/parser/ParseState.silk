//! Parser state and primitive operations for the flat parser.
//!
//! # When to use
//!
//! Use [`State`] in a grammar module that consumes tokens and builds nodes. Start one unfinished
//! node with an empty element list. Add token elements with [`consume`] or [`expect`]. Complete the
//! node with [`finish`] or [`complete`], which answers its [`NodeId`].
//!
//! # Details
//!
//! Each grammar operation borrows the one parse state exclusively, so a nesting level holds only
//! its own locals on the stack, never a copy of the state.
//!
//! The token cursor addresses the original token array. Lookups skip trivia, but the state keeps
//! all tokens. Completed nodes stay in one array. A completed node never changes its index.
//!
//! # Gotchas
//!
//! [`consume`] and [`unexpected`] require a current source token. Use [`hasCurrent`] when the input
//! can end before that operation. [`expect`] is safe at conceptual end-of-file because it inserts a
//! missing-token element.

import lexer.Span {Span}
import lexer.Token {Token, TokenKind, kind, span}
import parser.Diagnostic {Diagnostic}
import parser.Element {Element, TokenId}
import parser.Node {Node, NodeKind}
import parser.NodeId {NodeId}
import parser.SyntaxTree {SyntaxTree}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.string {String}
import silk.usize
import silk.list {List}

/// Maximum number of active parent-to-child expression edges (EXPR-006).
pub const EXPRESSION_LIMIT: usize = 256

/// The native stack budget for active nested constructs, in units of about one kilobyte.
///
/// # Details
///
/// The parser charges each active construct its measured stack cost in the whole compiler, not
/// only in parsing, and reports `NestingLimit` before it enters one beyond this budget. The budget
/// is half of an 8 MB main stack, so every mix of constructs keeps a 2x margin. It is a native
/// guard beside EXPR-006, which alone bounds grouped children and prefix operands at 256. Alone,
/// 1018 chained operators, 408 field or index links, 291 method call links, 204 nested calls, 170
/// nested array or tuple literals, 681 nested blocks, 454 nested `if` statements, 1355 `else if`
/// links, 408 nested anonymous functions, 254 nested `match` expressions or 511 nested types fit;
/// deeper mixes the reference accepts are rejected.
/// The costs were measured with stack lifetime markers, which let a frame reuse the slots of
/// temporaries and named locals whose lives have ended.
pub const STACK_BUDGET: usize = 4096

/// The cost of one expression child edge, such as a call argument, element, field or operand.
/// A nested call, the deepest of these, measures about 17.
pub const EXPRESSION_COST: usize = 20

/// The cost of one element of an array or tuple literal, or one record field initializer; a
/// nested array or tuple literal measures about 21.
pub const AGGREGATE_COST: usize = 24

/// The cost of one field, referent or index link after the first in a postfix chain such as
/// `a.b.c`, measured at about 9.
pub const PROJECTION_COST: usize = 10

/// The cost of one call link after the first in a postfix chain such as `a.f().g()`; with its
/// member link, a method call measures about 11.
pub const CALL_COST: usize = 4

/// The cost of grouping parentheses' contents, which later phases lower in place.
pub const GROUP_COST: usize = 2

/// The cost of one prefix operand: `-`, `!`, `~`, `&`, `move`, `unsafe` or `run`. A reference,
/// the deepest of these, measures about 4.
pub const PREFIX_COST: usize = 6

/// The cost of one operator in a left-nested infix chain, which later phases lower without
/// recursing once per operator, measured at about 3.4. A pipeline stage costs an expression edge.
pub const CHAIN_COST: usize = 4

/// The cost of one nested block, including function, `if`, loop, arm and effect bodies; a nested
/// loop measures about 5.
pub const BLOCK_COST: usize = 6

/// The cost of one anonymous function or effect expression beyond its block; a nested anonymous
/// function measures about 8.
pub const CALLABLE_COST: usize = 4

/// The cost of one `if` beyond its block, paid by each link of an `else if` chain, which
/// measures about 2.3.
pub const CONDITIONAL_COST: usize = 3

/// The cost of one `match` expression beyond its arms' blocks.
pub const MATCH_COST: usize = 8

/// The cost of one nested type. Its stack measures about 4 on x86-64 and aarch64 Linux, but 1023
/// nested types overflowed the 8 MB main stack on aarch64 macOS, so the charge is twice that.
pub const TYPE_COST: usize = 8

/// The cost of one nested pattern.
pub const PATTERN_COST: usize = 16

/// Whether entering a construct of `cost` stays within the stack budget.
pub fn affordable(state: &State, cost: usize) -> bool {
  return usize.add(state.stackCost, cost) <= STACK_BUDGET
}

/// All mutable data for one parse, borrowed exclusively by each grammar operation.
///
/// # Details
///
/// The token array does not change after construction. The node and diagnostic arrays grow in
/// discovery order. The cursor can point to trivia because significant-token operations skip
/// trivia when they read it.
pub struct State {
  /// Original bytes used to recognize contextual identifiers without allocating strings.
  pub source: Bytes,
  /// The complete lexer output in source order, including trivia and an optional end token.
  pub tokens: List<Token>,
  /// Completed nodes in append order, where each array index is a stable node identity.
  pub nodes: List<Node>,
  /// The direct elements of every completed node, each node's run stored contiguously.
  pub elements: List<Element>,
  /// Syntax diagnostics in the order in which grammar operations detect them.
  pub diagnostics: List<Diagnostic>,
  /// The raw token position from which the next significant-token search starts.
  pub index: usize,
  /// The summed stack cost of the active nested constructs; siblings restore their parent's.
  pub stackCost: usize,
  /// Active expression child edges (EXPR-006). A block nested inside an expression keeps counting
  /// from its enclosing expression, so expressions inside it share one bound with their ancestors.
  pub expressionDepth: usize,
}

fn isTrivia(tokenKind: TokenKind) -> bool {
  return match tokenKind {
    TokenKind.Whitespace => true
    TokenKind.LineComment => true
    TokenKind.DocComment => true
    TokenKind.ModuleDocComment => true
    _ => false
  }
}

fn significantIndex(state: &State) -> usize {
  let mut index = state.index
  while index < List<Token>.length(&state.tokens) {
    let token = List<Token>.get(&state.tokens, index)
    if !(token
      |> kind
      |> isTrivia) {
      return index
    }
    index = usize.add(index, usize.ONE)
  }
  return index
}

fn elementSpan(state: &State, element: Element) -> Span {
  return match move element {
    Element.Node {id} => List<Node>.asSlice(&state.nodes)[id.index].span
    Element.Token {id} => &state.tokens
      |> List<Token>.get(id.index)
      |> span
    Element.MissingToken {expected: ignoredExpected, span} => span
  }
}

/// Creates empty parser state at the start of one token array.
///
/// # Details
///
/// The returned state owns `tokens`. Its node and diagnostic arrays are empty. Its raw token cursor
/// is zero.
pub fn make(source: Bytes, tokens: List<Token>) -> State {
  return State {
    source: move source,
    tokens: move tokens,
    nodes: List<Node>.make(),
    elements: List<Element>.make(),
    diagnostics: List<Diagnostic>.make(),
    index: usize.ZERO,
    stackCost: 0,
    expressionDepth: 0,
  }
}

/// Sizes the node and element storage for the tokens: a node for about every two tokens, and a
/// little more than one element for each, so a large file's parse does not copy them as they grow.
pub effect fn reserveForTokens(state: &mut State) -> () ! OutOfMemoryError ? &mut Allocator {
  let tokens = List<Token>.length(&state.tokens)
  run List<Node>.reserveExact(&mut state.nodes, tokens / 2 + 16)
  return run List<Element>.reserveExact(&mut state.elements, tokens / 4 * 5 + 16)
}

/// Reports whether a significant token exists at or after the raw cursor.
///
/// # Details
///
/// The search skips whitespace and comment tokens. An explicit end-of-file token counts as a
/// current significant token.
pub fn hasCurrent(state: &State) -> bool {
  return significantIndex(state) < List<Token>.length(&state.tokens)
}

/// Returns the next significant token kind, or conceptual end-of-file when none remains.
///
/// # Details
///
/// The operation does not change the cursor. It skips whitespace and comments during the lookup.
/// If the token array has no next significant token, it returns `TokenKind.EndOfFile`.
pub fn currentKind(state: &State) -> TokenKind {
  let index = significantIndex(state)
  if List<Token>.length(&state.tokens) <= index {
    return TokenKind.EndOfFile
  }
  return &state.tokens
    |> List<Token>.get(index)
    |> kind
}

/// Returns the zero-width source span for a missing token at the current position.
///
/// # Details
///
/// If a significant token remains, the span is at that token's start. At physical input end, the
/// span is at the final token's end. An empty token array produces the span `0..0`.
///
/// The operation does not change parser state.
pub fn insertionSpan(state: &State) -> Span {
  let index = significantIndex(state)
  if index < List<Token>.length(&state.tokens) {
    let tokenSpan = &state.tokens
      |> List<Token>.get(index)
      |> span
    return Span.make(tokenSpan.start, tokenSpan.start)
  }
  let length = List<Token>.length(&state.tokens)
  if length == usize.ZERO {
    return Span.make(usize.ZERO, usize.ZERO)
  }
  let finalSpan = &state.tokens
    |> List<Token>.get(usize.subtract(length, usize.ONE))
    |> span
  return Span.make(finalSpan.end, finalSpan.end)
}

/// Consumes the next significant token and appends its token identity to an unfinished node.
///
/// # Details
///
/// The cursor moves to one position after the consumed token. Skipped trivia stays in the token
/// array and does not become an element of this node.
///
/// # Gotchas
///
/// A source token must exist at or after the cursor. If physical input can end, call [`hasCurrent`]
/// before this operation or use [`expect`].
pub effect fn consume(state: &mut State, elements: &mut List<Element>) -> () ! OutOfMemoryError ? &mut Allocator {
  let index = significantIndex(&state.*)
  state.index = usize.add(index, usize.ONE)
  return run List<Element>.append(&mut elements.*, Element.Token {id: TokenId {index: index}})
}

/// Appends one missing-token element and its matching diagnostic without consuming input.
///
/// # Details
///
/// The element and diagnostic use the same expected token kind and zero-width insertion span. The
/// parser cursor does not move, so the current source token remains available for recovery. When a
/// missing token was already reported at this position, only the element is added: one damaged
/// position reports one diagnostic.
pub effect fn missing(state: &mut State, elements: &mut List<Element>, expected: TokenKind) -> ()
! OutOfMemoryError
? &mut Allocator {
  let missingSpan = insertionSpan(&state.*)
  if !reportedHere(&state.*) {
    run List<Diagnostic>.append(
      &mut state.diagnostics,
      Diagnostic.MissingToken {expected: expected, span: missingSpan},
    )
  }
  return run List<Element>.append(
    &mut elements.*,
    Element.MissingToken {expected: expected, span: missingSpan},
  )
}

/// Consumes the expected token, or inserts a missing-token element at the current position.
///
/// # Details
///
/// If the current significant token has `expected`, this operation behaves like [`consume`]. In all
/// other cases, it behaves like [`missing`] and does not consume the current token.
///
/// # Gotchas
///
/// A mismatched source token stays current. The calling grammar must consume it or select another
/// recovery action before a loop repeats.
pub effect fn expect(state: &mut State, elements: &mut List<Element>, expected: TokenKind) -> ()
! OutOfMemoryError
? &mut Allocator {
  if hasCurrent(&state.*) && currentKind(&state.*) == expected {
    return run consume(&mut state.*, &mut elements.*)
  }
  return run missing(&mut state.*, &mut elements.*, expected)
}

/// Consumes the comma between two list items and reports whether the list continues.
///
/// # Details
///
/// `another` tells whether the current token can start the next item. A missing comma before such
/// a token is reported and the list continues; before any other token the list ends there, so the
/// list's closing delimiter reports the damage once instead of a comma and a delimiter both.
pub effect fn separator(state: &mut State, elements: &mut List<Element>, another: bool) -> bool
! OutOfMemoryError
? &mut Allocator {
  if hasCurrent(&state.*) && currentKind(&state.*) == TokenKind.Comma {
    run consume(&mut state.*, &mut elements.*)
    return true
  }
  if another {
    run missing(&mut state.*, &mut elements.*, TokenKind.Comma)
    return true
  }
  return false
}

/// Reports whether the latest diagnostic is a missing token inserted at the current token.
///
/// # When to use
///
/// Recovery that skips the current token checks this first: the missing token already reported
/// the damage at this position, so the skipped token needs no second diagnostic.
pub fn reportedHere(state: &State) -> bool {
  let count = List<Diagnostic>.length(&state.diagnostics)
  if count == usize.ZERO {
    return false
  }
  if let Diagnostic.MissingToken {expected: ignoredExpected, span: missingSpan} = List<Diagnostic>.get(&state.diagnostics, count - usize.ONE) {
    return missingSpan.start == insertionSpan(state).start
  }
  return false
}

/// Consumes one significant token and records it as unexpected syntax.
///
/// # When to use
///
/// Use for recovery when the current token cannot belong to the active grammar rule. The cursor
/// advances by one significant token, which gives a recovery loop forward progress.
///
/// # Details
///
/// The operation adds an unexpected-token diagnostic and a normal token element. The element keeps
/// the damaged source available in the resulting tree.
///
/// # Gotchas
///
/// A source token must exist at or after the cursor. Call [`hasCurrent`] first when physical input
/// can end.
pub effect fn unexpected(state: &mut State, elements: &mut List<Element>) -> ()
! OutOfMemoryError
? &mut Allocator {
  let index = significantIndex(&state.*)
  let token = List<Token>.get(&state.tokens, index)
  run List<Diagnostic>.append(
    &mut state.diagnostics,
    Diagnostic.UnexpectedToken {actual: kind(token), span: span(token)},
  )
  state.index = usize.add(index, usize.ONE)
  return run List<Element>.append(&mut elements.*, Element.Token {id: TokenId {index: index}})
}

// Copies a completed node's elements into the shared element array and returns where they start.
effect fn storeElements(state: &mut State, elements: List<Element>) -> usize
! OutOfMemoryError
? &mut Allocator {
  let first = List<Element>.length(&state.elements)
  let values = List<Element>.asSlice(&elements)
  run List<Element>.reserve(&mut state.elements, values.length)
  let mut index = usize.ZERO
  while index < values.length {
    run List<Element>.append(&mut state.elements, values[index])
    index = usize.add(index, usize.ONE)
  }
  return first
}

/// Appends one completed node and returns its stable array identity.
///
/// # Details
///
/// The operation stores the node after all child nodes that are already in `elements`. The new
/// node identity is the node array length before the append.
///
/// For a nonempty element list, the node span starts at the first element and ends at the last
/// element. For an empty list, the node uses `emptySpan`.
///
/// # Gotchas
///
/// Elements must occur in source order. Each child node and token identity must belong to the
/// returned state. This operation does not validate those conditions.
pub effect fn finish(state: &mut State, elements: List<Element>, nodeKind: NodeKind, emptySpan: Span) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let length = List<Element>.length(&elements)
  let mut nodeSpan = emptySpan
  if usize.ZERO < length {
    let first = elementSpan(&state.*, List<Element>.get(&elements, usize.ZERO))
    let last = elementSpan(
      &state.*,
      List<Element>.get(&elements, usize.subtract(length, usize.ONE)),
    )
    nodeSpan = Span.make(first.start, last.end)
  }
  let node = NodeId {index: List<Node>.length(&state.nodes)}
  let firstElement = run storeElements(&mut state.*, move elements)
  run List<Node>.append(
    &mut state.nodes,
    Node {kind: nodeKind, span: nodeSpan, firstElement: firstElement, elementCount: length},
  )
  return node
}

/// Appends the source-file root for a completed top-level element list.
///
/// # Details
///
/// The root starts at byte zero and ends at the current insertion position. Its kind is
/// `NodeKind.SourceFile`. The returned identity is the root's index in the node array.
///
/// # Gotchas
///
/// Call this operation after the top-level grammar has represented end-of-file in `elements`.
/// This operation does not add or validate an end-of-file element.
pub effect fn finishSourceFile(state: &mut State, elements: List<Element>) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let node = NodeId {index: List<Node>.length(&state.nodes)}
  let sourceEnd = insertionSpan(&state.*).end
  let elementCount = List<Element>.length(&elements)
  let firstElement = run storeElements(&mut state.*, move elements)
  run List<Node>.append(
    &mut state.nodes,
    Node {
      kind: NodeKind.SourceFile,
      span: Span.make(usize.ZERO, sourceEnd),
      firstElement: firstElement,
      elementCount: elementCount,
    },
  )
  return node
}

/// Converts completed parser state and a source-file node identity into the final syntax tree.
///
/// # Details
///
/// The result takes ownership of the token, node, and diagnostic arrays. It uses `root` as the
/// root identity. The parser cursor is no longer part of the result.
///
/// # Gotchas
///
/// The operation does not verify that `root` identifies a source-file node. Call
/// [`finishSourceFile`] before this operation.
pub fn intoSyntaxTree(state: State, root: NodeId) -> SyntaxTree {
  let State {source, tokens, nodes, elements, diagnostics, index: ignoredIndex, stackCost: ignoredStackCost,
    expressionDepth: ignoredExpressionDepth} = move state
  return SyntaxTree {
    source: move source,
    tokens: move tokens,
    nodes: move nodes,
    elements: move elements,
    root: root,
    diagnostics: move diagnostics,
  }
}

/// Peeks by a zero-based significant-token offset without consuming source or allocating.
///
/// Trivia never contributes to the offset. Positions past the token array return end-of-file.
pub fn peek(state: &State, offset: usize) -> TokenKind {
  let mut index = significantIndex(state)
  let mut remaining = offset
  while index < List<Token>.length(&state.tokens) {
    let candidate = &state.tokens
      |> List<Token>.get(index)
      |> kind
    if !isTrivia(candidate) {
      if remaining == 0 {
        return candidate
      }
      remaining = usize.subtract(remaining, 1)
    }
    index = usize.add(index, 1)
  }
  return TokenKind.EndOfFile
}

/// Tests a contextual identifier at one significant-token offset against its exact source spelling.
///
/// Keywords remain lexer tokens; words such as `where` are identifiers outside their grammar slot.
/// The supplied source and token spans must describe the same file.
pub fn wordAt(state: &State, expected: string, offset: usize) -> bool {
  let mut tokenIndex = significantIndex(state)
  let mut remaining = offset
  while tokenIndex < List<Token>.length(&state.tokens) {
    let candidate = &state.tokens
      |> List<Token>.get(tokenIndex)
      |> kind
    if !isTrivia(candidate) {
      if remaining == usize.ZERO {
        break
      }
      remaining = usize.subtract(remaining, usize.ONE)
    }
    tokenIndex = usize.add(tokenIndex, usize.ONE)
  }
  if tokenIndex >= List<Token>.length(&state.tokens) {
    return false
  }
  let tokenKind = &state.tokens
    |> List<Token>.get(tokenIndex)
    |> kind
  if tokenKind != TokenKind.Identifier {
    return false
  }
  let location = &state.tokens
    |> List<Token>.get(tokenIndex)
    |> span
  let bytes = Bytes.asSlice(&state.source)
  let text = String.utf8Bytes(expected)
  if location.end > bytes.length || usize.subtract(location.end, location.start) != text.length {
    return false
  }
  let mut index: usize = 0
  while index < text.length {
    if bytes[usize.add(location.start, index)] != text[index] {
      return false
    }
    index = usize.add(index, 1)
  }
  return true
}

/// Tests the current contextual identifier against its exact source spelling.
pub fn word(state: &State, expected: string) -> bool {
  return wordAt(state, expected, usize.ZERO)
}

/// Reports whether skipped trivia contains a line feed before the next significant token.
///
/// Index projections use this boundary to avoid consuming a following array pattern as a suffix.
pub fn lineBreakBefore(state: &State) -> bool {
  let end = insertionSpan(state).start
  let mut index = end
  if state.index < List<Token>.length(&state.tokens) {
    let tokenIndex = state.index
    let location = &state.tokens
      |> List<Token>.get(tokenIndex)
      |> span
    index = location.start
  }
  let bytes = Bytes.asSlice(&state.source)
  while index < end && index < bytes.length {
    if bytes[index] == 10 {
      return true
    }
    index = usize.add(index, 1)
  }
  return false
}

/// The source span of the significant token at `offset`, or the insertion span past the input.
pub fn spanAt(state: &State, offset: usize) -> Span {
  let mut index = significantIndex(state)
  let mut remaining = offset
  while index < List<Token>.length(&state.tokens) {
    let candidate = List<Token>.get(&state.tokens, index)
    if !isTrivia(kind(candidate)) {
      if remaining == usize.ZERO { return span(candidate) }
      remaining = usize.subtract(remaining, usize.ONE)
    }
    index = usize.add(index, usize.ONE)
  }
  return insertionSpan(state)
}

/// Whether the significant tokens at `offset` and `offset + 1` touch, with nothing between them,
/// as the `+` and `=` of `+=` do.
pub fn touching(state: &State, offset: usize) -> bool {
  return spanAt(state, offset).end == spanAt(state, usize.add(offset, usize.ONE)).start
}

/// Whether a line feed separates the significant tokens at `offset` and `offset + 1`.
pub fn lineBreakAfter(state: &State, offset: usize) -> bool {
  let bytes = Bytes.asSlice(&state.source)
  let mut index = spanAt(state, offset).end
  let end = spanAt(state, usize.add(offset, usize.ONE)).start
  while index < end && index < bytes.length {
    if bytes[index] == 10 { return true }
    index = usize.add(index, usize.ONE)
  }
  return false
}

/// Attaches an already completed child to a parent element list. No node payload is copied.
pub effect fn attach(elements: &mut List<Element>, node: NodeId) -> () ! OutOfMemoryError ? &mut Allocator {
  return run List<Element>.append(&mut elements.*, Element.Node {id: node})
}

/// Starts a parent whose first element is an existing completed node.
pub effect fn wrap(node: NodeId) -> List<Element> ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run List<Element>.append(&mut elements, Element.Node {id: node})
  return move elements
}

/// Consumes an optional token, leaving the unfinished node unchanged when it is absent.
pub effect fn optional(state: &mut State, elements: &mut List<Element>, expected: TokenKind) -> ()
! OutOfMemoryError
? &mut Allocator {
  if currentKind(&state.*) == expected {
    return run consume(&mut state.*, &mut elements.*)
  }
  return ()
}

/// Completes a node, using the current insertion point only when its element list is empty.
pub effect fn complete(state: &mut State, elements: List<Element>, kind: NodeKind) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let empty = insertionSpan(&state.*)
  return run finish(&mut state.*, move elements, kind, empty)
}

/// Reads the kind of a completed node without moving its element storage.
pub fn nodeKind(state: &State, node: NodeId) -> NodeKind {
  return List<Node>.asSlice(&state.nodes)[node.index].kind
}

/// Appends a fragment's direct elements to a saved parent without introducing a wrapper node.
pub effect fn extend(elements: &mut List<Element>, children: List<Element>) -> ()
! OutOfMemoryError
? &mut Allocator {
  let mut index: usize = 0
  while index < List<Element>.length(&children) {
    run List<Element>.append(&mut elements.*, List<Element>.get(&children, index))
    index = usize.add(index, 1)
  }
  return ()
}

/// Expects a contextual word without accepting an unrelated identifier in that grammar slot.
pub effect fn contextual(state: &mut State, elements: &mut List<Element>, expected: string) -> ()
! OutOfMemoryError
? &mut Allocator {
  if word(&state.*, expected) {
    return run consume(&mut state.*, &mut elements.*)
  }
  return run missing(&mut state.*, &mut elements.*, TokenKind.Identifier)
}

/// Skips an over-deep branch iteratively, leaving unmatched enclosing delimiters untouched.
///
/// The error node owns every skipped significant token. This recovery path never recursively
/// invokes grammar rules, even when the input contains thousands of nested delimiters.
pub effect fn nestingError(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  let location = insertionSpan(&state.*)
  run List<Diagnostic>.append(
    &mut state.diagnostics,
    Diagnostic.NestingLimit {limit: STACK_BUDGET, span: location},
  )
  let mut closing = List<TokenKind>.make()
  while currentKind(&state.*) != TokenKind.EndOfFile {
    let kind = currentKind(&state.*)
    let length = List<TokenKind>.length(&closing)
    // A named function cannot belong to an expression or type, even if damaged source left
    // delimiters open. Anonymous fn(...) and effect {...} remain part of the skipped branch.
    if (kind == TokenKind.FnKeyword && peek(&state.*, 1) == TokenKind.Identifier) || (kind == TokenKind.EffectKeyword && peek(
      &state.*,
      1,
    ) == TokenKind.FnKeyword && peek(&state.*, 2) == TokenKind.Identifier) || kind == TokenKind.PubKeyword {
      break
    }
    if length == 0 && (kind == TokenKind.RightParenthesis || kind == TokenKind.RightBracket || kind == TokenKind.RightBrace || kind == TokenKind.Comma || kind == TokenKind.FatArrow || kind == TokenKind.LetKeyword || kind == TokenKind.ReturnKeyword || kind == TokenKind.PubKeyword) {
      break
    }
    if kind == TokenKind.LeftParenthesis {
      run List<TokenKind>.append(&mut closing, TokenKind.RightParenthesis)
    } else if kind == TokenKind.LeftBracket {
      run List<TokenKind>.append(&mut closing, TokenKind.RightBracket)
    } else if kind == TokenKind.LeftBrace {
      run List<TokenKind>.append(&mut closing, TokenKind.RightBrace)
    } else if kind == TokenKind.RightParenthesis || kind == TokenKind.RightBracket || kind == TokenKind.RightBrace {
      if length == 0 || List<TokenKind>.get(&closing, usize.subtract(length, 1)) != kind {
        break
      }
      List<TokenKind>.truncate(&mut closing, usize.subtract(length, 1))
    }
    run consume(&mut state.*, &mut elements)
  }
  return run complete(&mut state.*, move elements, NodeKind.Error)
}

/// Skips one expression child beyond its nesting budget, as EXPR-006 recovers it.
///
/// The diagnostic names the child's first significant token. The scan never recurses: it keeps
/// one stack of open delimiters and stops at the first owner boundary of the enclosing expression
/// (a separator, closing delimiter, statement or declaration keyword, or a `{` that cannot open a
/// record here), leaving that boundary to the ordinary parser.
pub effect fn expressionNestingError(state: &mut State, limit: usize, allowRecord: bool) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let mut elements = List<Element>.make()
  let first = significantIndex(&state.*)
  let firstSpan = &state.tokens
    |> List<Token>.get(first)
    |> span
  let mut closing = List<TokenKind>.make()
  let mut significantConsumed = false
  while currentKind(&state.*) != TokenKind.EndOfFile {
    let kind = currentKind(&state.*)
    let length = List<TokenKind>.length(&closing)
    if length == 0 && significantConsumed && (overBudgetBoundary(kind) || (kind == TokenKind.LeftBrace && !allowRecord)) {
      break
    }
    if kind == TokenKind.RightParenthesis || kind == TokenKind.RightBracket || kind == TokenKind.RightBrace {
      if length == 0 || List<TokenKind>.get(&closing, usize.subtract(length, 1)) != kind {
        break
      }
      List<TokenKind>.truncate(&mut closing, usize.subtract(length, 1))
    } else if kind == TokenKind.LeftParenthesis {
      run List<TokenKind>.append(&mut closing, TokenKind.RightParenthesis)
    } else if kind == TokenKind.LeftBracket {
      run List<TokenKind>.append(&mut closing, TokenKind.RightBracket)
    } else if kind == TokenKind.LeftBrace {
      run List<TokenKind>.append(&mut closing, TokenKind.RightBrace)
    }
    significantConsumed = true
    run consume(&mut state.*, &mut elements)
  }
  run List<Diagnostic>.append(&mut state.diagnostics, Diagnostic.NestingLimit {limit: limit, span: firstSpan})
  return run complete(&mut state.*, move elements, NodeKind.Error)
}

// Where an over-budget expression's scan stops when no delimiter it opened is still open.
fn overBudgetBoundary(kind: TokenKind) -> bool {
  return match kind {
    TokenKind.Comma => true
    TokenKind.Semicolon => true
    TokenKind.RightParenthesis => true
    TokenKind.RightBracket => true
    TokenKind.RightBrace => true
    TokenKind.FatArrow => true
    TokenKind.LetKeyword => true
    TokenKind.ConstKeyword => true
    TokenKind.IfKeyword => true
    TokenKind.WhileKeyword => true
    TokenKind.BreakKeyword => true
    TokenKind.ContinueKeyword => true
    TokenKind.ReturnKeyword => true
    TokenKind.FailKeyword => true
    TokenKind.DropKeyword => true
    TokenKind.ElseKeyword => true
    TokenKind.PubKeyword => true
    TokenKind.StructKeyword => true
    TokenKind.TupleKeyword => true
    TokenKind.EnumKeyword => true
    TokenKind.UnionKeyword => true
    TokenKind.TypeKeyword => true
    TokenKind.ExternKeyword => true
    TokenKind.ExportKeyword => true
    TokenKind.FnKeyword => true
    TokenKind.EffectKeyword => true
    TokenKind.ImportKeyword => true
    TokenKind.ImplKeyword => true
    TokenKind.ServiceKeyword => true
    TokenKind.InterfaceKeyword => true
    TokenKind.RoleKeyword => true
    TokenKind.EndOfFile => true
    _ => false
  }
}
