//! Directives: `@name` or `@name(argument, ...)`, written before a declaration or a foreign
//! function type.
//!
//! An argument is `name: literal` or a bare literal, and the grammar admits only text, integer and
//! bool literals and parenthesized tuples of them, so a directive can never name a value, a type or
//! a function. Which directives exist, where each one applies and what it takes are semantic
//! questions answered by `hir.Directive`.
import lexer.Token {TokenKind}
import parser.Element {Element}
import parser.Node {Node, NodeKind}
import parser.Diagnostic {Diagnostic}
import lexer.Span {Span}
import parser.NodeId {NodeId}
import parser.ParseState {State}
import parser.ParseState
import parser.Expression
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.list {List}
import silk.num.usize

// Whether `kind` begins a directive literal.
fn literalStart(state: &State) -> bool {
  let kind = ParseState.currentKind(state)
  return kind == TokenKind.TextLiteral || kind == TokenKind.InvalidStaticLiteral || kind == TokenKind.DecimalInteger
    || kind == TokenKind.TrueKeyword || kind == TokenKind.FalseKeyword || kind == TokenKind.LeftParenthesis
    || (kind == TokenKind.Minus && ParseState.peek(state, 1) == TokenKind.DecimalInteger)
    || (kind == TokenKind.Dot && ParseState.peek(state, 1) == TokenKind.LeftParenthesis)
}

// One literal: text, an integer, a bool, or a tuple of literals, `(a, b)` or `.(a)`.
effect fn literal(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let kind = ParseState.currentKind(&state.*)
  if kind == TokenKind.LeftParenthesis { return run grouped(&mut state.*, false) }
  if kind == TokenKind.Dot { return run grouped(&mut state.*, true) }
  if kind == TokenKind.TrueKeyword || kind == TokenKind.FalseKeyword {
    return run Expression.literal(&mut state.*, NodeKind.BooleanLiteralExpression)
  }
  if kind == TokenKind.TextLiteral || kind == TokenKind.InvalidStaticLiteral {
    return run Expression.literal(&mut state.*, NodeKind.StaticTextLiteralExpression)
  }
  return run Expression.literal(&mut state.*, NodeKind.IntegerLiteralExpression)
}

// A dotted `.(a)` list is a tuple whatever its length; a parenthesized one needs a comma.
effect fn grouped(state: &mut State, dotted: bool) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  if !ParseState.affordable(&state.*, ParseState.AGGREGATE_COST) {
    return run ParseState.nestingError(&mut state.*)
  }
  let cost = state.stackCost
  state.stackCost = usize.add(cost, ParseState.AGGREGATE_COST)
  let mut elements = List<Element>.make()
  if dotted { run ParseState.consume(&mut state.*, &mut elements) }
  run ParseState.consume(&mut state.*, &mut elements)
  if ParseState.currentKind(&state.*) == TokenKind.RightParenthesis {
    run ParseState.consume(&mut state.*, &mut elements)
    state.stackCost = cost
    return run ParseState.complete(&mut state.*, move elements, NodeKind.UnitExpression)
  }
  run value(&mut state.*, &mut elements)
  let isTuple = dotted || ParseState.currentKind(&state.*) == TokenKind.Comma
  while ParseState.currentKind(&state.*) == TokenKind.Comma {
    run ParseState.consume(&mut state.*, &mut elements)
    if ParseState.currentKind(&state.*) == TokenKind.RightParenthesis { break }
    run value(&mut state.*, &mut elements)
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightParenthesis)
  state.stackCost = cost
  if isTuple {
    return run ParseState.complete(&mut state.*, move elements, NodeKind.TupleLiteralExpression)
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.GroupedExpression)
}

// Attaches one literal, or reports what stands in its place: a missing literal before a closing
// parenthesis or a comma, and any other token, such as a name or an operator, as unexpected.
effect fn value(state: &mut State, elements: &mut List<Element>) -> () ! OutOfMemoryError ? &mut Allocator {
  if literalStart(&state.*) { return run ParseState.attach(&mut elements.*, run literal(&mut state.*)) }
  let kind = ParseState.currentKind(&state.*)
  if kind == TokenKind.RightParenthesis || kind == TokenKind.Comma || kind == TokenKind.EndOfFile {
    return run ParseState.missing(&mut state.*, &mut elements.*, TokenKind.TextLiteral)
  }
  return run ParseState.unexpected(&mut state.*, &mut elements.*)
}

effect fn argument(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  if ParseState.currentKind(&state.*) == TokenKind.Identifier && ParseState.peek(&state.*, 1) == TokenKind.Colon {
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.consume(&mut state.*, &mut elements)
  }
  run value(&mut state.*, &mut elements)
  return run ParseState.complete(&mut state.*, move elements, NodeKind.DirectiveArgument)
}

/// Parses one `@name` or `@name(argument, ...)` directive; the current token is `@`.
pub effect fn directive(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.consume(&mut state.*, &mut elements)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  if ParseState.currentKind(&state.*) == TokenKind.LeftParenthesis {
    run ParseState.consume(&mut state.*, &mut elements)
    while ParseState.currentKind(&state.*) != TokenKind.RightParenthesis && ParseState.currentKind(&state.*) != TokenKind.EndOfFile {
      let before = state.index
      run ParseState.attach(&mut elements, run argument(&mut state.*))
      if state.index == before || ParseState.currentKind(&state.*) != TokenKind.Comma { break }
      run ParseState.consume(&mut state.*, &mut elements)
    }
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightParenthesis)
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.Directive)
}

/// Parses every consecutive directive into `elements`, the start of the declaration or foreign
/// function type they describe.
pub effect fn list(state: &mut State, elements: &mut List<Element>) -> () ! OutOfMemoryError ? &mut Allocator {
  while ParseState.currentKind(&state.*) == TokenKind.At {
    run ParseState.attach(&mut elements.*, run directive(&mut state.*))
  }
  return ()
}

/// Completes `leading`, directives that describe nothing that takes one, as one damaged region and
/// reports its first `@` as unexpected.
pub effect fn misplaced(state: &mut State, leading: List<Element>) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  if let Element.Node {id} = List<Element>.get(&leading, usize.ZERO) {
    let span = List<Node>.asSlice(&state.nodes)[id.index].span
    run List<Diagnostic>.append(&mut state.diagnostics, Diagnostic.UnexpectedToken {actual: TokenKind.At, span: Span.make(span.start, span.start + usize.ONE)})
  }
  return run ParseState.complete(&mut state.*, move leading, NodeKind.Error)
}
