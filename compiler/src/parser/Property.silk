//! Leftover `with Namespace.operation(name: value, ...)` clauses, which Silk now writes as
//! directives before the declaration.
import lexer.Token {TokenKind}
import parser.Diagnostic {Diagnostic, Replacement}
import parser.Element {Element}
import parser.Node {Node, NodeKind}
import parser.NodeId {NodeId}
import parser.ParseState {State}
import parser.ParseState
import parser.Expression
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.list {List}

// The directives that replace the clause starting at the current `with`.
fn replacement(state: &State) -> Replacement {
  if !ParseState.wordAt(state, "Intrinsic", 1) || ParseState.peek(state, 2) != TokenKind.Dot { return Replacement.Unknown }
  if ParseState.wordAt(state, "inline", 3) { return Replacement.Inline }
  if ParseState.wordAt(state, "inlineAlways", 3) { return Replacement.InlineAlways }
  if ParseState.wordAt(state, "inlineNever", 3) { return Replacement.InlineNever }
  if ParseState.wordAt(state, "cold", 3) { return Replacement.Cold }
  if ParseState.wordAt(state, "nonParking", 3) { return Replacement.NonParking }
  if ParseState.wordAt(state, "foreign", 3) { return Replacement.Foreign }
  if ParseState.wordAt(state, "machine", 3) { return Replacement.Machine }
  return Replacement.Unknown
}

/// Parses one `with Namespace.operation(name: value, ...)` clause into a damaged region and reports
/// the directives that replace it (PAR0011).
pub effect fn clause(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let replaced = replacement(&state.*)
  let mut elements = List<Element>.make()
  run ParseState.contextual(&mut state.*, &mut elements, "with")
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Dot)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.LeftParenthesis)
  while ParseState.currentKind(&state.*) == TokenKind.Identifier {
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.Colon)
    run ParseState.attach(&mut elements, run Expression.parse(&mut state.*, false))
    if ParseState.currentKind(&state.*) != TokenKind.Comma {
      break
    }
    run ParseState.consume(&mut state.*, &mut elements)
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightParenthesis)
  let node = run ParseState.complete(&mut state.*, move elements, NodeKind.Error)
  let span = List<Node>.asSlice(&state.nodes)[node.index].span
  run List<Diagnostic>.append(&mut state.diagnostics, Diagnostic.WithClause {replacement: replaced, span: span})
  return node
}

/// Appends every consecutive leftover `with` clause to an unfinished declaration or foreign type.
pub effect fn list(state: &mut State, elements: &mut List<Element>) -> () ! OutOfMemoryError ? &mut Allocator {
  while ParseState.word(&state.*, "with") {
    run ParseState.attach(&mut elements.*, run clause(&mut state.*))
  }
  return ()
}
