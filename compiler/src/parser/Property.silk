//! Sealed declaration-property syntax, retained for later owner and literal validation.
import lexer.Token {TokenKind}
import parser.Element {Element}
import parser.Node {NodeKind}
import parser.NodeId {NodeId}
import parser.ParseState {State}
import parser.ParseState
import parser.Expression
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.list {List}

effect fn property(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Colon)
  run ParseState.attach(&mut elements, run Expression.parse(&mut state.*, false))
  return run ParseState.complete(&mut state.*, move elements, NodeKind.FunctionProperty)
}

/// Parses one `with Namespace.operation(name: value, ...)` clause without interpreting it.
pub effect fn clause(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.contextual(&mut state.*, &mut elements, "with")
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Dot)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.LeftParenthesis)
  while ParseState.currentKind(&state.*) == TokenKind.Identifier {
    run ParseState.attach(&mut elements, run property(&mut state.*))
    if ParseState.currentKind(&state.*) != TokenKind.Comma {
      break
    }
    run ParseState.consume(&mut state.*, &mut elements)
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightParenthesis)
  return run ParseState.complete(&mut state.*, move elements, NodeKind.FunctionPropertyClause)
}

/// Appends all consecutive property clauses to an unfinished declaration or foreign type.
pub effect fn list(state: &mut State, elements: &mut List<Element>) -> () ! OutOfMemoryError ? &mut Allocator {
  while ParseState.word(&state.*, "with") {
    run ParseState.attach(&mut elements.*, run clause(&mut state.*))
  }
  return ()
}
