//! Expression grammar with precedence climbing and iterative postfix construction.
//!
//! Prefix operands, calls, projections, record literals, and pipelines produce flat nodes whose
//! edges refer to earlier array entries. `allowRecord` is false in conditions and match subjects:
//! the next brace belongs to the statement or match, not to a nominal constructor.
import lexer.Token {TokenKind}
import parser.Diagnostic {Diagnostic}
import parser.Node {Node, NodeKind}
import parser.ParseState {State, ElementsResult, NodeResult}
import parser.ParseState
import parser.Grammar
import parser.Type
import parser.Pattern
import parser.Lookahead
import parser.Statement
import silk.allocator {Allocator, OutOfMemoryError}
import silk.usize
import silk.vector {Vector}

effect fn literal(initial: State, nodeKind: NodeKind) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  let negative = ParseState.currentKind(&initial) == TokenKind.Minus
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.consume
  if negative && nodeKind == NodeKind.IntegerLiteralExpression && ParseState.currentKind(&p.state) == TokenKind.DecimalInteger {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
  } else if negative && nodeKind == NodeKind.FloatingLiteralExpression && ParseState.currentKind(&p.state) == TokenKind.DecimalFloat {
    let consumed2 = run move p
      |> ParseState.consume
    p = move consumed2
  }
  return run move p
    |> ParseState.complete(nodeKind)
}

effect fn field(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.Identifier)
  let afterColon = run move p
    |> ParseState.expect(TokenKind.Colon)
  p = move afterColon
  let attached = run ParseState.attach(move p.elements, run parse(move p.state, true))
  p = move attached
  return run move p
    |> ParseState.complete(NodeKind.StructFieldInitializer)
}

effect fn recordFields(initial: ElementsResult, kind: NodeKind) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  let mut p = run move initial
    |> ParseState.expect(TokenKind.LeftBrace)
  while ParseState.currentKind(&p.state) == TokenKind.Identifier {
    let attached = run ParseState.attach(move p.elements, run field(move p.state))
    p = move attached
    if ParseState.currentKind(&p.state) == TokenKind.RightBrace {
      break
    }
    let afterComma = run move p
      |> ParseState.expect(TokenKind.Comma)
    p = move afterComma
  }
  let afterRightBrace = run move p
    |> ParseState.expect(TokenKind.RightBrace)
  p = move afterRightBrace
  return run move p
    |> ParseState.complete(kind)
}

effect fn identifier(initial: State, allowRecord: bool) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  if Lookahead.appliedMember(&initial) {
    let p = run ParseState.wrap(run Pattern.selector(move initial))
    if allowRecord && ParseState.currentKind(&p.state) == TokenKind.LeftBrace {
      return run recordFields(move p, NodeKind.AppliedMemberExpression)
    }
    return run move p
      |> ParseState.complete(NodeKind.AppliedMemberExpression)
  }
  if allowRecord && Lookahead.record(&initial) {
    return run recordFields(
      run ParseState.wrap(run Type.named(move initial)),
      NodeKind.StructLiteralExpression,
    )
  }
  let identifier = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.Identifier)
  return run move identifier
    |> ParseState.complete(NodeKind.IdentifierExpression)
}

effect fn grouped(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.consume
  if ParseState.currentKind(&p.state) == TokenKind.RightParenthesis {
    return run ParseState.complete(run ParseState.consume(move p), NodeKind.UnitExpression)
  }
  let attached = run ParseState.attach(move p.elements, run parse(move p.state, true))
  p = move attached
  let isTuple = ParseState.currentKind(&p.state) == TokenKind.Comma
  while ParseState.currentKind(&p.state) == TokenKind.Comma {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    if ParseState.currentKind(&p.state) == TokenKind.RightParenthesis {
      break
    }
    let before = p.state.index
    let attached2 = run ParseState.attach(move p.elements, run parse(move p.state, true))
    p = move attached2
    if p.state.index == before {
      break
    }
  }
  let afterRightParenthesis = run move p
    |> ParseState.expect(TokenKind.RightParenthesis)
  p = move afterRightParenthesis
  if isTuple {
    return run move p
      |> ParseState.complete(NodeKind.TupleLiteralExpression)
  }
  return run move p
    |> ParseState.complete(NodeKind.GroupedExpression)
}

effect fn array(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.consume
  while Grammar.expressionStart(ParseState.currentKind(&p.state)) && !Grammar.blockEnd(&p.state) {
    let before = p.state.index
    let attached = run ParseState.attach(move p.elements, run parse(move p.state, true))
    p = move attached
    if p.state.index == before || ParseState.currentKind(&p.state) == TokenKind.RightBracket {
      break
    }
    let afterComma = run move p
      |> ParseState.expect(TokenKind.Comma)
    p = move afterComma
  }
  let afterRightBracket = run move p
    |> ParseState.expect(TokenKind.RightBracket)
  p = move afterRightBracket
  return run move p
    |> ParseState.complete(NodeKind.ArrayLiteralExpression)
}

effect fn arguments(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.LeftParenthesis)
  while Grammar.expressionStart(ParseState.currentKind(&p.state)) && !Grammar.blockEnd(&p.state) {
    let before = p.state.index
    let attached = run ParseState.attach(move p.elements, run parse(move p.state, true))
    p = move attached
    if p.state.index == before || ParseState.currentKind(&p.state) == TokenKind.RightParenthesis {
      break
    }
    let afterComma = run move p
      |> ParseState.expect(TokenKind.Comma)
    p = move afterComma
  }
  let afterRightParenthesis = run move p
    |> ParseState.expect(TokenKind.RightParenthesis)
  p = move afterRightParenthesis
  return run move p
    |> ParseState.complete(NodeKind.ArgumentList)
}

/// Extends a completed expression with calls and place projections without recursive left nesting.
///
/// A generic suffix is consumed only when balanced angles are followed by an argument list.
/// Indexing cannot cross a line break; other projections and calls can.
pub effect fn postfix(initial: NodeResult) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut result = move initial
  while true {
    let kind = ParseState.currentKind(&result.state)
    if kind == TokenKind.Less && Lookahead.afterAngles(&result.state, 0) == TokenKind.LeftParenthesis {
      let mut p = run move result
        |> ParseState.wrap
      let withTypesArguments = run ParseState.attach(
        move p.elements,
        run Type.arguments(move p.state, true),
      )
      p = move withTypesArguments
      let attached = run ParseState.attach(move p.elements, run arguments(move p.state))
      p = move attached
      let completed = run move p
        |> ParseState.complete(NodeKind.CallExpression)
      result = move completed
    } else if kind == TokenKind.LeftParenthesis {
      let mut p = run move result
        |> ParseState.wrap
      let attached2 = run ParseState.attach(move p.elements, run arguments(move p.state))
      p = move attached2
      let completed2 = run move p
        |> ParseState.complete(NodeKind.CallExpression)
      result = move completed2
    } else if kind == TokenKind.Dot {
      let mut p = run ParseState.consume(run ParseState.wrap(move result))
      let member = ParseState.currentKind(&p.state)
      let mut nodeKind = NodeKind.FieldProjectionExpression
      if member == TokenKind.Star {
        let consumed = run move p
          |> ParseState.consume
        p = move consumed
        nodeKind = NodeKind.ReferentProjectionExpression
      } else if member == TokenKind.DecimalInteger {
        let consumed2 = run move p
          |> ParseState.consume
        p = move consumed2
        nodeKind = NodeKind.OrdinalProjectionExpression
      } else if member == TokenKind.DropKeyword {
        let consumed3 = run move p
          |> ParseState.consume
        p = move consumed3
      } else {
        let afterIdentifier = run move p
          |> ParseState.expect(TokenKind.Identifier)
        p = move afterIdentifier
      }
      let completed3 = run move p
        |> ParseState.complete(nodeKind)
      result = move completed3
    } else if kind == TokenKind.LeftBracket && !ParseState.lineBreakBefore(&result.state) {
      let mut p = run ParseState.consume(run ParseState.wrap(move result))
      let attached3 = run ParseState.attach(move p.elements, run parse(move p.state, true))
      p = move attached3
      let afterRightBracket = run move p
        |> ParseState.expect(TokenKind.RightBracket)
      p = move afterRightBracket
      let completed4 = run move p
        |> ParseState.complete(NodeKind.IndexProjectionExpression)
      result = move completed4
    } else {
      break
    }
  }
  return move result
}

effect fn anonymous(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.optional(TokenKind.EffectKeyword)
  let afterFnKeyword = run move p
    |> ParseState.expect(TokenKind.FnKeyword)
  p = move afterFnKeyword
  let withTypesParameterList = run ParseState.attach(move p.elements, run Type.parameterList(move p.state))
  p = move withTypesParameterList
  let withTypesResult = run ParseState.attach(move p.elements, run Type.result(move p.state))
  p = move withTypesResult
  if ParseState.currentKind(&p.state) == TokenKind.Bang {
    let withTypesFailureRow = run ParseState.attach(move p.elements, run Type.failureRow(move p.state))
    p = move withTypesFailureRow
  }
  if ParseState.currentKind(&p.state) == TokenKind.Question {
    let withTypesRequirementRow = run ParseState.attach(
      move p.elements,
      run Type.requirementRow(move p.state),
    )
    p = move withTypesRequirementRow
  }
  let withStatementsBlock = run ParseState.attach(
    move p.elements,
    run Statement.block(move p.state, true, false),
  )
  p = move withStatementsBlock
  return run move p
    |> ParseState.complete(NodeKind.AnonymousCallableExpression)
}

effect fn matchAccess(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = ParseState.begin(move initial)
  if ParseState.word(&p.state, "place") && ParseState.peek(&p.state, 1) == TokenKind.Identifier {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
  } else if ParseState.currentKind(&p.state) == TokenKind.MoveKeyword {
    let consumed2 = run move p
      |> ParseState.consume
    p = move consumed2
  } else if ParseState.currentKind(&p.state) == TokenKind.Ampersand {
    let consumed3 = run move p
      |> ParseState.consume
    p = move consumed3
    let afterMutKeyword = run move p
      |> ParseState.optional(TokenKind.MutKeyword)
    p = move afterMutKeyword
  }
  return run move p
    |> ParseState.complete(NodeKind.MatchAccess)
}

effect fn arm(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run ParseState.wrap(run Pattern.parse(move initial))
  if ParseState.currentKind(&p.state) == TokenKind.IfKeyword {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    let attached = run ParseState.attach(move p.elements, run parse(move p.state, false))
    p = move attached
  }
  let afterFatArrow = run move p
    |> ParseState.expect(TokenKind.FatArrow)
  p = move afterFatArrow
  if ParseState.currentKind(&p.state) == TokenKind.LeftBrace {
    let withStatementsBlock = run ParseState.attach(
      move p.elements,
      run Statement.block(move p.state, false, true),
    )
    p = move withStatementsBlock
  } else {
    let attached2 = run ParseState.attach(move p.elements, run parse(move p.state, true))
    p = move attached2
  }
  return run move p
    |> ParseState.complete(NodeKind.MatchArm)
}

effect fn matchExpression(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.consume
  let attached = run ParseState.attach(move p.elements, run matchAccess(move p.state))
  p = move attached
  let attached2 = run ParseState.attach(move p.elements, run parse(move p.state, false))
  p = move attached2
  let afterLeftBrace = run move p
    |> ParseState.expect(TokenKind.LeftBrace)
  p = move afterLeftBrace
  while !Grammar.blockEnd(&p.state) {
    let before = p.state.index
    let attached3 = run ParseState.attach(move p.elements, run arm(move p.state))
    p = move attached3
    if p.state.index == before {
      let advanced = run move p
        |> ParseState.unexpected
      p = move advanced
    }
  }
  let afterRightBrace = run move p
    |> ParseState.expect(TokenKind.RightBrace)
  p = move afterRightBrace
  return run move p
    |> ParseState.complete(NodeKind.MatchExpression)
}

effect fn compileErrorExpression(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.consume
  let afterLeftParenthesis = run move p
    |> ParseState.expect(TokenKind.LeftParenthesis)
  p = move afterLeftParenthesis
  let attached = run ParseState.attach(move p.elements, run parse(move p.state, true))
  p = move attached
  let afterRightParenthesis = run move p
    |> ParseState.expect(TokenKind.RightParenthesis)
  p = move afterRightParenthesis
  return run move p
    |> ParseState.complete(NodeKind.CompileErrorExpression)
}

// `<` followed by `>`, a lifetime, or a type start begins reserved template syntax.
fn reservedTemplateStart(state: &State) -> bool {
  let next = ParseState.peek(state, 1)
  return ParseState.currentKind(state) == TokenKind.Less
    && (next == TokenKind.Greater || next == TokenKind.Lifetime || Grammar.typeStart(next))
}

// Tokens that end skipped template syntax outside its own delimiters.
fn reservedTemplateBoundary(kind: TokenKind) -> bool {
  return match kind {
    TokenKind.Comma => true
    TokenKind.RightParenthesis => true
    TokenKind.RightBracket => true
    TokenKind.RightBrace => true
    TokenKind.LetKeyword => true
    TokenKind.StaticKeyword => true
    TokenKind.IfKeyword => true
    TokenKind.WhileKeyword => true
    TokenKind.BreakKeyword => true
    TokenKind.ContinueKeyword => true
    TokenKind.ReturnKeyword => true
    TokenKind.ElseKeyword => true
    TokenKind.PubKeyword => true
    TokenKind.StructKeyword => true
    TokenKind.TupleKeyword => true
    TokenKind.EnumKeyword => true
    TokenKind.UnionKeyword => true
    TokenKind.TypeKeyword => true
    TokenKind.ExternKeyword => true
    TokenKind.ExportKeyword => true
    TokenKind.FnKeyword => true
    TokenKind.ImportKeyword => true
    TokenKind.EndOfFile => true
    _ => false
  }
}

// Skips reserved template syntax into one error node: up to and including the first `>` outside
// nested delimiters, or up to a statement or declaration boundary. Following syntax stays intact.
effect fn reservedTemplate(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = ParseState.begin(move initial)
  let mut braces: usize = 0
  let mut brackets: usize = 0
  let mut parentheses: usize = 0
  let mut first = true
  while ParseState.hasCurrent(&p.state) {
    let kind = ParseState.currentKind(&p.state)
    let nested = braces > 0 || brackets > 0 || parentheses > 0
    if !first && !nested && reservedTemplateBoundary(kind) {
      break
    }
    let consumed = run ParseState.consume(move p)
    p = move consumed
    first = false
    if kind == TokenKind.LeftBrace {
      braces = braces + 1
    } else if kind == TokenKind.RightBrace && braces > 0 {
      braces = braces - 1
    } else if kind == TokenKind.LeftBracket {
      brackets = brackets + 1
    } else if kind == TokenKind.RightBracket && brackets > 0 {
      brackets = brackets - 1
    } else if kind == TokenKind.LeftParenthesis {
      parentheses = parentheses + 1
    } else if kind == TokenKind.RightParenthesis && parentheses > 0 {
      parentheses = parentheses - 1
    }
    if kind == TokenKind.Greater && braces == 0 && brackets == 0 && parentheses == 0 {
      break
    }
  }
  let mut result = run ParseState.complete(move p, NodeKind.Error)
  let skipped = Vector<Node>.asSlice(&result.state.nodes)[result.node.index].span
  run Vector<Diagnostic>.append(&mut result.state.diagnostics, Diagnostic.ReservedTemplate {span: skipped})
  return move result
}

effect fn primary(initial: State, allowRecord: bool) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  let kind = ParseState.currentKind(&initial)
  if kind == TokenKind.Identifier {
    return run identifier(move initial, allowRecord)
  }
  if kind == TokenKind.DecimalInteger {
    return run literal(move initial, NodeKind.IntegerLiteralExpression)
  }
  if kind == TokenKind.DecimalFloat {
    return run literal(move initial, NodeKind.FloatingLiteralExpression)
  }
  if kind == TokenKind.Minus && ParseState.peek(&initial, 1) == TokenKind.DecimalInteger {
    return run literal(move initial, NodeKind.IntegerLiteralExpression)
  }
  if kind == TokenKind.Minus && ParseState.peek(&initial, 1) == TokenKind.DecimalFloat {
    return run literal(move initial, NodeKind.FloatingLiteralExpression)
  }
  if kind == TokenKind.DurationLiteral || kind == TokenKind.InvalidDurationLiteral {
    return run literal(move initial, NodeKind.DurationLiteralExpression)
  }
  if kind == TokenKind.TextLiteral || kind == TokenKind.ByteStringLiteral || kind == TokenKind.InvalidStaticLiteral {
    return run literal(move initial, NodeKind.StaticTextLiteralExpression)
  }
  if kind == TokenKind.CharLiteral {
    return run literal(move initial, NodeKind.CharacterLiteralExpression)
  }
  if kind == TokenKind.TrueKeyword || kind == TokenKind.FalseKeyword {
    return run literal(move initial, NodeKind.BooleanLiteralExpression)
  }
  if kind == TokenKind.LeftParenthesis {
    return run grouped(move initial)
  }
  if kind == TokenKind.LeftBracket {
    return run array(move initial)
  }
  if kind == TokenKind.Dot && ParseState.peek(&initial, 1) == TokenKind.LeftBrace {
    return run recordFields(
      run ParseState.consume(ParseState.begin(move initial)),
      NodeKind.ContextualRecordLiteralExpression,
    )
  }
  if kind == TokenKind.LeftBrace && allowRecord {
    let p = run ParseState.wrap(run Type.path(move initial))
    return run recordFields(move p, NodeKind.StructLiteralExpression)
  }
  if kind == TokenKind.FnKeyword || (kind == TokenKind.EffectKeyword && ParseState.peek(&initial, 1) == TokenKind.FnKeyword) {
    return run anonymous(move initial)
  }
  if kind == TokenKind.EffectKeyword {
    let mut p = run move initial
      |> ParseState.begin
      |> ParseState.consume
    let withStatementsBlock = run ParseState.attach(
      move p.elements,
      run Statement.block(move p.state, true, false),
    )
    p = move withStatementsBlock
    return run move p
      |> ParseState.complete(NodeKind.EffectExpression)
  }
  if kind == TokenKind.MatchKeyword {
    return run matchExpression(move initial)
  }
  if kind == TokenKind.CompileErrorKeyword {
    return run compileErrorExpression(move initial)
  }
  if kind == TokenKind.RunKeyword {
    let mut p = run move initial
      |> ParseState.begin
      |> ParseState.consume
    let attached = run ParseState.attach(move p.elements, run parse(move p.state, allowRecord))
    p = move attached
    return run move p
      |> ParseState.complete(NodeKind.RunExpression)
  }
  if kind == TokenKind.MoveKeyword || kind == TokenKind.Ampersand || kind == TokenKind.UnsafeKeyword {
    let mut p = run move initial
      |> ParseState.begin
      |> ParseState.consume
    let mut nodeKind = NodeKind.MoveExpression
    if kind == TokenKind.Ampersand {
      let afterMutKeyword = run move p
        |> ParseState.optional(TokenKind.MutKeyword)
      p = move afterMutKeyword
      nodeKind = NodeKind.BorrowExpression
    } else if kind == TokenKind.UnsafeKeyword {
      nodeKind = NodeKind.UnsafeExpression
    }
    let attached2 = run ParseState.attach(move p.elements, run infix(move p.state, 11, allowRecord))
    p = move attached2
    return run move p
      |> ParseState.complete(nodeKind)
  }
  if kind == TokenKind.Minus || kind == TokenKind.Bang || kind == TokenKind.Tilde {
    let mut p = run move initial
      |> ParseState.begin
      |> ParseState.consume
    let attached3 = run ParseState.attach(move p.elements, run infix(move p.state, 11, allowRecord))
    p = move attached3
    return run move p
      |> ParseState.complete(NodeKind.PrefixExpression)
  }
  if reservedTemplateStart(&initial) {
    return run reservedTemplate(move initial)
  }
  let mut p = ParseState.begin(move initial)
  if kind == TokenKind.Invalid || kind == TokenKind.Less {
    let advanced = run move p
      |> ParseState.unexpected
    p = move advanced
  } else {
    let afterIdentifier = run move p
      |> ParseState.missing(TokenKind.Identifier)
    p = move afterIdentifier
  }
  return run move p
    |> ParseState.complete(NodeKind.Error)
}

effect fn infix(initial: State, minimum: usize, allowRecord: bool) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  if initial.depth >= ParseState.NESTING_LIMIT {
    return run move initial
      |> ParseState.nestingError
  }
  let depth = initial.depth
  let mut state = move initial
  state.depth = usize.add(depth, 1)
  let mut result = run infixInner(move state, minimum, allowRecord)
  result.state.depth = depth
  return move result
}

effect fn infixInner(initial: State, minimum: usize, allowRecord: bool) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  let mut left = run postfix(run primary(move initial, allowRecord))
  let mut nonAssociative: usize = 0
  while true {
    let kind = ParseState.currentKind(&left.state)
    let precedence = Grammar.precedence(kind)
    if precedence < minimum || precedence == 0 || precedence == nonAssociative {
      break
    }
    let mut p = run ParseState.consume(run ParseState.wrap(move left))
    let attached = run ParseState.attach(
      move p.elements,
      run infix(move p.state, usize.add(precedence, 1), allowRecord),
    )
    p = move attached
    if kind == TokenKind.PipeGreater {
      let completed = run move p
        |> ParseState.complete(NodeKind.PipelineExpression)
      left = move completed
    } else {
      let completed2 = run move p
        |> ParseState.complete(NodeKind.InfixExpression)
      left = move completed2
    }
    if precedence == 4 || precedence == 5 {
      nonAssociative = precedence
    }
  }
  return move left
}

/// Parses one expression, including all postfixes and operators up to its enclosing delimiter.
///
/// `allowRecord` controls brace ownership in conditions. Syntax diagnostics stay in the state;
/// allocation failure is the only effect failure. The result's node is already in the flat array.
pub effect fn parse(initial: State, allowRecord: bool) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  return run infix(move initial, 1, allowRecord)
}
