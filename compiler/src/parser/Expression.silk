//! Expression grammar with precedence climbing and iterative postfix construction.
//!
//! Prefix operands, calls, projections, record literals, and pipelines produce flat nodes whose
//! edges refer to earlier array entries. `allowRecord` is false in conditions and match subjects:
//! the next brace belongs to the statement or match, not to a nominal constructor.
import lexer.Span {Span}
import lexer.Token {TokenKind}
import parser.Diagnostic {Diagnostic, Habit}
import parser.Element {Element}
import parser.Node {Node, NodeKind}
import parser.NodeId {NodeId}
import parser.ParseState {State}
import parser.ParseState
import parser.Grammar
import parser.Type
import parser.Pattern
import parser.Lookahead
import parser.Statement
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.usize
import silk.list {List}

pub effect fn literal(state: &mut State, nodeKind: NodeKind) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let negative = ParseState.currentKind(&state.*) == TokenKind.Minus
  let mut elements = List<Element>.make()
  run ParseState.consume(&mut state.*, &mut elements)
  if negative && nodeKind == NodeKind.IntegerLiteralExpression && ParseState.currentKind(&state.*) == TokenKind.DecimalInteger {
    run ParseState.consume(&mut state.*, &mut elements)
  } else if negative && nodeKind == NodeKind.FloatingLiteralExpression && ParseState.currentKind(&state.*) == TokenKind.DecimalFloat {
    run ParseState.consume(&mut state.*, &mut elements)
  }
  return run ParseState.complete(&mut state.*, move elements, nodeKind)
}

effect fn field(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Colon)
  run ParseState.attach(&mut elements, run child(&mut state.*, 1, true, ParseState.AGGREGATE_COST))
  return run ParseState.complete(&mut state.*, move elements, NodeKind.StructFieldInitializer)
}

effect fn recordFields(state: &mut State, initial: List<Element>, kind: NodeKind) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let mut elements = move initial
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.LeftBrace)
  // `Pair { 0: a, 1: b }` names tuple elements as fields: one diagnostic names the positional
  // form, and the braces join the error node so nothing else reports.
  if ParseState.currentKind(&state.*) == TokenKind.DecimalInteger && ParseState.peek(&state.*, 1) == TokenKind.Colon {
    let span = Span.make(ParseState.spanAt(&state.*, 0).start, ParseState.spanAt(&state.*, 1).end)
    let mut depth: usize = 0
    while ParseState.currentKind(&state.*) != TokenKind.EndOfFile {
      let current = ParseState.currentKind(&state.*)
      if current == TokenKind.RightBrace && depth == 0 { break }
      if current == TokenKind.LeftBrace || current == TokenKind.LeftParenthesis || current == TokenKind.LeftBracket { depth = depth + 1 }
      if (current == TokenKind.RightBrace || current == TokenKind.RightParenthesis || current == TokenKind.RightBracket) && depth > 0 {
        depth = depth - 1
      }
      run ParseState.consume(&mut state.*, &mut elements)
    }
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightBrace)
    run List<Diagnostic>.append(&mut state.diagnostics, Diagnostic.ForeignSpelling {habit: Habit.TupleFields, span: span})
    return run ParseState.complete(&mut state.*, move elements, NodeKind.Error)
  }
  while ParseState.currentKind(&state.*) == TokenKind.Identifier {
    run ParseState.attach(&mut elements, run field(&mut state.*))
    if ParseState.currentKind(&state.*) == TokenKind.RightBrace {
      break
    }
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.Comma)
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightBrace)
  return run ParseState.complete(&mut state.*, move elements, kind)
}

effect fn identifier(state: &mut State, allowRecord: bool) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  if Lookahead.appliedMember(&state.*) {
    let selected = run ParseState.wrap(run Pattern.selector(&mut state.*))
    if allowRecord && ParseState.currentKind(&state.*) == TokenKind.LeftBrace {
      return run recordFields(&mut state.*, move selected, NodeKind.AppliedMemberExpression)
    }
    return run ParseState.complete(&mut state.*, move selected, NodeKind.AppliedMemberExpression)
  }
  if allowRecord && Lookahead.record(&state.*) {
    let named = run ParseState.wrap(run Type.named(&mut state.*))
    return run recordFields(&mut state.*, move named, NodeKind.StructLiteralExpression)
  }
  let mut elements = List<Element>.make()
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  return run ParseState.complete(&mut state.*, move elements, NodeKind.IdentifierExpression)
}

effect fn grouped(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.consume(&mut state.*, &mut elements)
  if ParseState.currentKind(&state.*) == TokenKind.RightParenthesis {
    run ParseState.consume(&mut state.*, &mut elements)
    return run ParseState.complete(&mut state.*, move elements, NodeKind.UnitExpression)
  }
  // Grouping lowers in place, but a tuple's elements are aggregate fields.
  let mut charge = ParseState.GROUP_COST
  if Lookahead.tupleLiteral(&state.*) {
    charge = ParseState.AGGREGATE_COST
  }
  run ParseState.attach(&mut elements, run child(&mut state.*, 1, true, charge))
  let isTuple = ParseState.currentKind(&state.*) == TokenKind.Comma
  while ParseState.currentKind(&state.*) == TokenKind.Comma {
    run ParseState.consume(&mut state.*, &mut elements)
    if ParseState.currentKind(&state.*) == TokenKind.RightParenthesis {
      break
    }
    let before = state.index
    run ParseState.attach(&mut elements, run child(&mut state.*, 1, true, ParseState.AGGREGATE_COST))
    if state.index == before {
      break
    }
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightParenthesis)
  if isTuple {
    return run ParseState.complete(&mut state.*, move elements, NodeKind.TupleLiteralExpression)
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.GroupedExpression)
}

effect fn array(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.consume(&mut state.*, &mut elements)
  let mut first = true
  while (Grammar.expressionStart(ParseState.currentKind(&state.*)) || (first && ParseState.currentKind(&state.*) == TokenKind.Semicolon)) && !Grammar.blockEnd(&state.*) {
    let before = state.index
    run ParseState.attach(&mut elements, run child(&mut state.*, 1, true, ParseState.AGGREGATE_COST))
    if first && ParseState.currentKind(&state.*) == TokenKind.Semicolon {
      run ParseState.consume(&mut state.*, &mut elements)
      if Grammar.blockEnd(&state.*) {
        let mut missing = List<Element>.make()
        run ParseState.missing(&mut state.*, &mut missing, TokenKind.Identifier)
        run ParseState.attach(&mut elements, run ParseState.complete(&mut state.*, move missing, NodeKind.Error))
      } else {
        run ParseState.attach(&mut elements, run child(&mut state.*, 1, true, ParseState.AGGREGATE_COST))
      }
      run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightBracket)
      return run ParseState.complete(&mut state.*, move elements, NodeKind.ArrayRepeatExpression)
    }
    first = false
    if state.index == before || ParseState.currentKind(&state.*) == TokenKind.RightBracket {
      break
    }
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.Comma)
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightBracket)
  return run ParseState.complete(&mut state.*, move elements, NodeKind.ArrayLiteralExpression)
}

effect fn arguments(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.LeftParenthesis)
  while Grammar.expressionStart(ParseState.currentKind(&state.*)) && !Grammar.blockEnd(&state.*) {
    let before = state.index
    run ParseState.attach(&mut elements, run child(&mut state.*, 1, true, ParseState.EXPRESSION_COST))
    if state.index == before || ParseState.currentKind(&state.*) == TokenKind.RightParenthesis {
      break
    }
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.Comma)
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightParenthesis)
  return run ParseState.complete(&mut state.*, move elements, NodeKind.ArgumentList)
}

/// Extends a completed expression with calls and place projections without recursive left nesting.
///
/// A generic suffix is consumed only when balanced angles are followed by an argument list.
/// Indexing cannot cross a line break; other projections and calls can.
///
/// Later phases lower each link around its receiver, so every link after the first is charged
/// its stack cost while the chain is parsed. A link beyond the budget is reported and the rest of
/// the expression is skipped, as an over-deep child is.
pub effect fn postfix(state: &mut State, initial: NodeId) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut result = initial
  let cost = state.stackCost
  let mut links: usize = 0
  while true {
    let kind = ParseState.currentKind(&state.*)
    let calling = kind == TokenKind.LeftParenthesis || (kind == TokenKind.Less && Lookahead.afterAngles(&state.*, 0) == TokenKind.LeftParenthesis)
    let linking = calling || kind == TokenKind.Dot || (kind == TokenKind.LeftBracket && !ParseState.lineBreakBefore(&state.*))
    if linking && links > 0 {
      let mut charge = ParseState.PROJECTION_COST
      if calling {
        charge = ParseState.CALL_COST
      }
      // The link's own index or argument children must fit too, so one diagnostic covers it.
      if !ParseState.affordable(&state.*, usize.add(charge, ParseState.EXPRESSION_COST)) {
        let mut elements = run ParseState.wrap(result)
        run ParseState.attach(&mut elements, run ParseState.expressionNestingError(&mut state.*, ParseState.STACK_BUDGET, true))
        result = run ParseState.complete(&mut state.*, move elements, NodeKind.Error)
        break
      }
      state.stackCost = usize.add(state.stackCost, charge)
    }
    links = usize.add(links, 1)
    if kind == TokenKind.Less && Lookahead.afterAngles(&state.*, 0) == TokenKind.LeftParenthesis {
      let mut elements = run ParseState.wrap(result)
      run ParseState.attach(&mut elements, run Type.arguments(&mut state.*, true))
      run ParseState.attach(&mut elements, run arguments(&mut state.*))
      result = run ParseState.complete(&mut state.*, move elements, NodeKind.CallExpression)
    } else if kind == TokenKind.LeftParenthesis {
      let mut elements = run ParseState.wrap(result)
      run ParseState.attach(&mut elements, run arguments(&mut state.*))
      result = run ParseState.complete(&mut state.*, move elements, NodeKind.CallExpression)
    } else if kind == TokenKind.Dot {
      let mut elements = run ParseState.wrap(result)
      run ParseState.consume(&mut state.*, &mut elements)
      let member = ParseState.currentKind(&state.*)
      let mut nodeKind = NodeKind.FieldProjectionExpression
      if member == TokenKind.Star {
        run ParseState.consume(&mut state.*, &mut elements)
        nodeKind = NodeKind.ReferentProjectionExpression
      } else if member == TokenKind.DecimalInteger {
        run ParseState.consume(&mut state.*, &mut elements)
        nodeKind = NodeKind.OrdinalProjectionExpression
      } else if member == TokenKind.DropKeyword {
        run ParseState.consume(&mut state.*, &mut elements)
      } else {
        run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
      }
      result = run ParseState.complete(&mut state.*, move elements, nodeKind)
    } else if kind == TokenKind.LeftBracket && !ParseState.lineBreakBefore(&state.*) {
      let mut elements = run ParseState.wrap(result)
      run ParseState.consume(&mut state.*, &mut elements)
      run ParseState.attach(&mut elements, run child(&mut state.*, 1, true, ParseState.EXPRESSION_COST))
      run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightBracket)
      result = run ParseState.complete(&mut state.*, move elements, NodeKind.IndexProjectionExpression)
    } else {
      break
    }
  }
  state.stackCost = cost
  return result
}

// An anonymous function charges its cost beyond its block over its whole signature too, so one that
// does not fit is skipped from its `fn` with one diagnostic, before its parameter or result types.
// An anonymous function is refused at its `fn` when its signature's types would not fit either,
// so a function too deep for the budget is reported once, where it starts.
effect fn anonymous(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  if !ParseState.affordable(&state.*, usize.add(ParseState.CALLABLE_COST, ParseState.TYPE_COST)) {
    return run ParseState.nestingError(&mut state.*)
  }
  let cost = state.stackCost
  state.stackCost = usize.add(cost, ParseState.CALLABLE_COST)
  let node = run anonymousInner(&mut state.*)
  state.stackCost = cost
  return node
}

effect fn anonymousInner(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.optional(&mut state.*, &mut elements, TokenKind.EffectKeyword)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.FnKeyword)
  run ParseState.attach(&mut elements, run Type.parameterList(&mut state.*))
  run ParseState.attach(&mut elements, run Type.result(&mut state.*))
  if ParseState.currentKind(&state.*) == TokenKind.Bang {
    run ParseState.attach(&mut elements, run Type.failureRow(&mut state.*))
  }
  if ParseState.currentKind(&state.*) == TokenKind.Question {
    run ParseState.attach(&mut elements, run Type.requirementRow(&mut state.*))
  }
  run ParseState.attach(&mut elements, run Statement.block(&mut state.*, true, false))
  return run ParseState.complete(&mut state.*, move elements, NodeKind.AnonymousCallableExpression)
}

// The body of an effect expression, charged beyond its block.
effect fn callableBody(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  if !ParseState.affordable(&state.*, ParseState.CALLABLE_COST) {
    return run ParseState.nestingError(&mut state.*)
  }
  let cost = state.stackCost
  state.stackCost = usize.add(cost, ParseState.CALLABLE_COST)
  let node = run Statement.block(&mut state.*, true, false)
  state.stackCost = cost
  return node
}

effect fn matchAccess(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  if ParseState.word(&state.*, "place") && ParseState.peek(&state.*, 1) == TokenKind.Identifier {
    run ParseState.consume(&mut state.*, &mut elements)
  } else if ParseState.currentKind(&state.*) == TokenKind.MoveKeyword {
    run ParseState.consume(&mut state.*, &mut elements)
  } else if ParseState.currentKind(&state.*) == TokenKind.Ampersand {
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.optional(&mut state.*, &mut elements, TokenKind.MutKeyword)
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.MatchAccess)
}

effect fn arm(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = run ParseState.wrap(run Pattern.parse(&mut state.*))
  if ParseState.currentKind(&state.*) == TokenKind.IfKeyword {
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.attach(&mut elements, run child(&mut state.*, 1, false, ParseState.EXPRESSION_COST))
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.FatArrow)
  if ParseState.currentKind(&state.*) == TokenKind.LeftBrace {
    run ParseState.attach(&mut elements, run Statement.block(&mut state.*, false, true))
  } else if ParseState.currentKind(&state.*) == TokenKind.ReturnKeyword {
    run ParseState.attach(&mut elements, run Statement.armStatement(&mut state.*))
  } else {
    run ParseState.attach(&mut elements, run child(&mut state.*, 1, true, ParseState.EXPRESSION_COST))
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.MatchArm)
}

// A `match` charges its own stack cost on top of its arms' blocks.
effect fn matchExpression(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  if !ParseState.affordable(&state.*, ParseState.MATCH_COST) {
    return run ParseState.nestingError(&mut state.*)
  }
  let cost = state.stackCost
  state.stackCost = usize.add(cost, ParseState.MATCH_COST)
  let node = run matchInner(&mut state.*)
  state.stackCost = cost
  return node
}

effect fn matchInner(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.consume(&mut state.*, &mut elements)
  run ParseState.attach(&mut elements, run matchAccess(&mut state.*))
  run ParseState.attach(&mut elements, run child(&mut state.*, 1, false, ParseState.EXPRESSION_COST))
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.LeftBrace)
  while !Grammar.blockEnd(&state.*) {
    // A comma after an arm, as in `Kind.Fruit => 1,`, is one diagnostic; the next arm parses as usual.
    if ParseState.currentKind(&state.*) == TokenKind.Comma {
      let span = ParseState.spanAt(&state.*, 0)
      let mut separator = List<Element>.make()
      run ParseState.consume(&mut state.*, &mut separator)
      run List<Diagnostic>.append(&mut state.diagnostics, Diagnostic.ForeignSpelling {habit: Habit.ArmComma, span: span})
      run ParseState.attach(&mut elements, run ParseState.complete(&mut state.*, move separator, NodeKind.Error))
      continue
    }
    let before = state.index
    run ParseState.attach(&mut elements, run arm(&mut state.*))
    if state.index == before {
      run ParseState.unexpected(&mut state.*, &mut elements)
    }
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightBrace)
  return run ParseState.complete(&mut state.*, move elements, NodeKind.MatchExpression)
}

effect fn compileErrorExpression(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.consume(&mut state.*, &mut elements)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.LeftParenthesis)
  run ParseState.attach(&mut elements, run child(&mut state.*, 1, true, ParseState.EXPRESSION_COST))
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightParenthesis)
  return run ParseState.complete(&mut state.*, move elements, NodeKind.CompileErrorExpression)
}

// `<` followed by `>`, a lifetime, or a type start begins reserved template syntax.
fn reservedTemplateStart(state: &State) -> bool {
  let next = ParseState.peek(state, 1)
  return ParseState.currentKind(state) == TokenKind.Less
    && (next == TokenKind.Greater || next == TokenKind.Lifetime || Grammar.typeStart(next))
}

// Tokens that end skipped template syntax outside its own delimiters.
fn reservedTemplateBoundary(kind: TokenKind) -> bool {
  return match kind {
    TokenKind.Comma => true
    TokenKind.RightParenthesis => true
    TokenKind.RightBracket => true
    TokenKind.RightBrace => true
    TokenKind.LetKeyword => true
    TokenKind.StaticKeyword => true
    TokenKind.IfKeyword => true
    TokenKind.WhileKeyword => true
    TokenKind.BreakKeyword => true
    TokenKind.ContinueKeyword => true
    TokenKind.ReturnKeyword => true
    TokenKind.ElseKeyword => true
    TokenKind.PubKeyword => true
    TokenKind.StructKeyword => true
    TokenKind.TupleKeyword => true
    TokenKind.EnumKeyword => true
    TokenKind.UnionKeyword => true
    TokenKind.TypeKeyword => true
    TokenKind.ExternKeyword => true
    TokenKind.ExportKeyword => true
    TokenKind.FnKeyword => true
    TokenKind.ImportKeyword => true
    TokenKind.EndOfFile => true
    _ => false
  }
}

// Skips reserved template syntax into one error node: up to and including the first `>` outside
// nested delimiters, or up to a statement or declaration boundary. Following syntax stays intact.
effect fn reservedTemplate(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  let mut braces: usize = 0
  let mut brackets: usize = 0
  let mut parentheses: usize = 0
  let mut first = true
  while ParseState.hasCurrent(&state.*) {
    let kind = ParseState.currentKind(&state.*)
    let nested = braces > 0 || brackets > 0 || parentheses > 0
    if !first && !nested && reservedTemplateBoundary(kind) {
      break
    }
    run ParseState.consume(&mut state.*, &mut elements)
    first = false
    if kind == TokenKind.LeftBrace {
      braces = braces + 1
    } else if kind == TokenKind.RightBrace && braces > 0 {
      braces = braces - 1
    } else if kind == TokenKind.LeftBracket {
      brackets = brackets + 1
    } else if kind == TokenKind.RightBracket && brackets > 0 {
      brackets = brackets - 1
    } else if kind == TokenKind.LeftParenthesis {
      parentheses = parentheses + 1
    } else if kind == TokenKind.RightParenthesis && parentheses > 0 {
      parentheses = parentheses - 1
    }
    if kind == TokenKind.Greater && braces == 0 && brackets == 0 && parentheses == 0 {
      break
    }
  }
  let node = run ParseState.complete(&mut state.*, move elements, NodeKind.Error)
  let skipped = List<Node>.asSlice(&state.nodes)[node.index].span
  run List<Diagnostic>.append(&mut state.diagnostics, Diagnostic.ReservedTemplate {span: skipped})
  return node
}

effect fn primary(state: &mut State, allowRecord: bool) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let kind = ParseState.currentKind(&state.*)
  if kind == TokenKind.Identifier {
    return run identifier(&mut state.*, allowRecord)
  }
  if kind == TokenKind.DecimalInteger {
    return run literal(&mut state.*, NodeKind.IntegerLiteralExpression)
  }
  if kind == TokenKind.DecimalFloat {
    return run literal(&mut state.*, NodeKind.FloatingLiteralExpression)
  }
  if kind == TokenKind.Minus && ParseState.peek(&state.*, 1) == TokenKind.DecimalInteger {
    return run literal(&mut state.*, NodeKind.IntegerLiteralExpression)
  }
  if kind == TokenKind.Minus && ParseState.peek(&state.*, 1) == TokenKind.DecimalFloat {
    return run literal(&mut state.*, NodeKind.FloatingLiteralExpression)
  }
  if kind == TokenKind.DurationLiteral || kind == TokenKind.InvalidDurationLiteral {
    return run literal(&mut state.*, NodeKind.DurationLiteralExpression)
  }
  if kind == TokenKind.TextLiteral || kind == TokenKind.ByteStringLiteral || kind == TokenKind.InvalidStaticLiteral {
    return run literal(&mut state.*, NodeKind.StaticTextLiteralExpression)
  }
  if kind == TokenKind.CharLiteral {
    return run literal(&mut state.*, NodeKind.CharacterLiteralExpression)
  }
  if kind == TokenKind.TrueKeyword || kind == TokenKind.FalseKeyword {
    return run literal(&mut state.*, NodeKind.BooleanLiteralExpression)
  }
  if kind == TokenKind.LeftParenthesis {
    return run grouped(&mut state.*)
  }
  if kind == TokenKind.LeftBracket {
    return run array(&mut state.*)
  }
  if kind == TokenKind.Dot && ParseState.peek(&state.*, 1) == TokenKind.LeftBrace {
    let mut dotted = List<Element>.make()
    run ParseState.consume(&mut state.*, &mut dotted)
    return run recordFields(&mut state.*, move dotted, NodeKind.ContextualRecordLiteralExpression)
  }
  if kind == TokenKind.LeftBrace && allowRecord {
    let typed = run ParseState.wrap(run Type.path(&mut state.*))
    return run recordFields(&mut state.*, move typed, NodeKind.StructLiteralExpression)
  }
  if kind == TokenKind.FnKeyword || (kind == TokenKind.EffectKeyword && ParseState.peek(&state.*, 1) == TokenKind.FnKeyword) {
    return run anonymous(&mut state.*)
  }
  let mut elements = List<Element>.make()
  if kind == TokenKind.EffectKeyword {
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.attach(&mut elements, run callableBody(&mut state.*))
    return run ParseState.complete(&mut state.*, move elements, NodeKind.EffectExpression)
  }
  if kind == TokenKind.MatchKeyword {
    return run matchExpression(&mut state.*)
  }
  // An `if` whose `else` chain ends in a block is a value (IF-002). Without a final `else` some
  // path produces nothing: one diagnostic at the word replaces a missing-value cascade, and the
  // parsed conditional stays inside the error expression.
  if kind == TokenKind.IfKeyword {
    let conditional = run Statement.conditional(&mut state.*, false)
    if Statement.selectsValue(&state.*, conditional) { return conditional }
    run ParseState.attach(&mut elements, conditional)
    let error = run ParseState.complete(&mut state.*, move elements, NodeKind.Error)
    let start = List<Node>.asSlice(&state.nodes)[error.index].span.start
    run List<Diagnostic>.append(&mut state.diagnostics, Diagnostic.IfExpression {span: Span.make(start, start + 2)})
    return error
  }
  if kind == TokenKind.CompileErrorKeyword {
    return run compileErrorExpression(&mut state.*)
  }
  if kind == TokenKind.RunKeyword {
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.attach(&mut elements, run child(&mut state.*, 1, allowRecord, ParseState.PREFIX_COST))
    return run ParseState.complete(&mut state.*, move elements, NodeKind.RunExpression)
  }
  if kind == TokenKind.MoveKeyword || kind == TokenKind.Ampersand || kind == TokenKind.UnsafeKeyword {
    run ParseState.consume(&mut state.*, &mut elements)
    let mut nodeKind = NodeKind.MoveExpression
    if kind == TokenKind.Ampersand {
      run ParseState.optional(&mut state.*, &mut elements, TokenKind.MutKeyword)
      nodeKind = NodeKind.BorrowExpression
    } else if kind == TokenKind.UnsafeKeyword {
      nodeKind = NodeKind.UnsafeExpression
    }
    run ParseState.attach(&mut elements, run child(&mut state.*, 11, allowRecord, ParseState.PREFIX_COST))
    return run ParseState.complete(&mut state.*, move elements, nodeKind)
  }
  if kind == TokenKind.Minus || kind == TokenKind.Bang || kind == TokenKind.Tilde {
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.attach(&mut elements, run child(&mut state.*, 11, allowRecord, ParseState.PREFIX_COST))
    return run ParseState.complete(&mut state.*, move elements, NodeKind.PrefixExpression)
  }
  // A C-style `*n` keeps its operand inside one error expression, so nothing after it cascades.
  if kind == TokenKind.Star {
    let star = ParseState.spanAt(&state.*, 0)
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.attach(&mut elements, run child(&mut state.*, 11, allowRecord, ParseState.PREFIX_COST))
    if !dereferencedOnLine(&state.*, star) {
      run List<Diagnostic>.append(&mut state.diagnostics, Diagnostic.ForeignSpelling {habit: Habit.PrefixDereference, span: star})
    }
    return run ParseState.complete(&mut state.*, move elements, NodeKind.Error)
  }
  if reservedTemplateStart(&state.*) {
    return run reservedTemplate(&mut state.*)
  }
  if kind == TokenKind.Invalid || kind == TokenKind.Less {
    run ParseState.unexpected(&mut state.*, &mut elements)
  } else {
    run ParseState.missing(&mut state.*, &mut elements, TokenKind.Identifier)
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.Error)
}

// Parses one child expression edge (EXPR-006): grouped contents, operands, pipeline targets,
// indexes, arguments, elements, initializers and `match` children. A child beyond the expression
// limit, or beyond the native stack budget, is skipped without recursion when it starts an
// expression; any other token is left to the ordinary grammar.
effect fn child(state: &mut State, minimum: usize, allowRecord: bool, charge: usize) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let kind = ParseState.currentKind(&state.*)
  let start = Grammar.expressionStart(kind) || kind == TokenKind.Less
  if start && state.expressionDepth >= ParseState.EXPRESSION_LIMIT {
    return run ParseState.expressionNestingError(&mut state.*, ParseState.EXPRESSION_LIMIT, allowRecord)
  }
  if start && !ParseState.affordable(&state.*, charge) {
    return run ParseState.expressionNestingError(&mut state.*, ParseState.STACK_BUDGET, allowRecord)
  }
  let depth = state.expressionDepth
  let cost = state.stackCost
  state.expressionDepth = usize.add(depth, 1)
  state.stackCost = usize.add(cost, charge)
  let node = run infix(&mut state.*, minimum, allowRecord)
  state.expressionDepth = depth
  state.stackCost = cost
  return node
}

effect fn infix(state: &mut State, minimum: usize, allowRecord: bool) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let operand = run primary(&mut state.*, allowRecord)
  let mut left = run postfix(&mut state.*, operand)
  let mut nonAssociative: usize = 0
  // A chain's operands are siblings for EXPR-006, but each infix operator still costs the checker
  // a little stack, charged to the native budget. A pipeline stage nests its input one edge
  // deeper and counts as an explicitly nested call would.
  let depth = state.expressionDepth
  let cost = state.stackCost
  while true {
    let kind = ParseState.currentKind(&state.*)
    let precedence = Grammar.precedence(kind)
    // Spellings other languages accept get one diagnostic that names the Silk form: `x += 1`,
    // `x++` at the end of a line, and `c ? a : b`.
    if precedence >= 6 && ParseState.peek(&state.*, 1) == TokenKind.Equals && ParseState.touching(&state.*, 0) {
      left = run foreign(&mut state.*, left, Habit.CompoundAssignment, 2, allowRecord)
      break
    }
    if (kind == TokenKind.Plus || kind == TokenKind.Minus) && ParseState.peek(&state.*, 1) == kind && ParseState.touching(&state.*, 0)
      && (ParseState.lineBreakAfter(&state.*, 1) || closer(ParseState.peek(&state.*, 2))) {
      left = run foreign(&mut state.*, left, Habit.Increment, 2, allowRecord)
      break
    }
    if kind == TokenKind.Question && !ParseState.lineBreakBefore(&state.*) {
      left = run foreign(&mut state.*, left, Habit.Conditional, 1, allowRecord)
      break
    }
    // `value as T` is a cast as Rust and Swift write it: one PAR0002 at `as`, whose template names
    // the conversion functions, and the target type joins the error node so nothing else reports.
    if kind == TokenKind.AsKeyword && !ParseState.lineBreakBefore(&state.*) {
      let at = ParseState.spanAt(&state.*, 0)
      let mut elements = run ParseState.wrap(left)
      run ParseState.consume(&mut state.*, &mut elements)
      run ParseState.attach(&mut elements, run Type.parse(&mut state.*))
      run List<Diagnostic>.append(&mut state.diagnostics, Diagnostic.UnexpectedToken {actual: kind, span: at})
      left = run ParseState.complete(&mut state.*, move elements, NodeKind.Error)
      continue
    }
    // `>>` ends a shift only where a comparison could stand: in `mask<N>` the lane count stops
    // above the comparisons, and its `>` closes the type.
    if (kind == TokenKind.Less || kind == TokenKind.Greater) && precedence >= minimum && ParseState.peek(&state.*, 1) == kind
      && ParseState.touching(&state.*, 0) {
      left = run foreign(&mut state.*, left, Habit.Shift, 2, allowRecord)
      break
    }
    if precedence < minimum || precedence == 0 || precedence == nonAssociative {
      break
    }
    // A line that starts with `-` and reaches `=>` is the next match arm's negative pattern, as in
    // `-1 => 2`, never a subtraction from the arm before it.
    if kind == TokenKind.Minus && ParseState.lineBreakBefore(&state.*) && nextArm(&state.*) {
      break
    }
    // A line that starts with a `*` touching its operand, as in `*p = 1`, is a C-style dereference
    // opening the next statement, never a product with the line before.
    if kind == TokenKind.Star && ParseState.lineBreakBefore(&state.*) && ParseState.touching(&state.*, 0) {
      break
    }
    let mut elements = run ParseState.wrap(left)
    run ParseState.consume(&mut state.*, &mut elements)
    let right = run child(&mut state.*, usize.add(precedence, 1), allowRecord, ParseState.EXPRESSION_COST)
    run ParseState.attach(&mut elements, right)
    if kind == TokenKind.PipeGreater {
      left = run ParseState.complete(&mut state.*, move elements, NodeKind.PipelineExpression)
    } else {
      left = run ParseState.complete(&mut state.*, move elements, NodeKind.InfixExpression)
    }
    if ParseState.nodeKind(&state.*, right) == NodeKind.Error {
      break
    }
    if kind == TokenKind.PipeGreater {
      state.expressionDepth = usize.add(state.expressionDepth, 1)
      state.stackCost = usize.add(state.stackCost, ParseState.EXPRESSION_COST)
    } else {
      state.stackCost = usize.add(state.stackCost, ParseState.CHAIN_COST)
    }
    if precedence == 4 || precedence == 5 {
      nonAssociative = precedence
    }
  }
  state.expressionDepth = depth
  state.stackCost = cost
  return left
}

// Whether the line the current token starts reaches `=>` within a pattern's few tokens.
fn nextArm(state: &State) -> bool {
  let mut offset = usize.ONE
  while offset < 8 {
    if ParseState.lineBreakAfter(state, usize.subtract(offset, usize.ONE)) { return false }
    let kind = ParseState.peek(state, offset)
    if kind == TokenKind.FatArrow { return true }
    if kind == TokenKind.EndOfFile { return false }
    offset = usize.add(offset, usize.ONE)
  }
  return false
}

// Whether the last syntax problem is a prefix `*` earlier on the line of `star`, so that
// `*n = *n + 1` is reported once.
fn dereferencedOnLine(state: &State, star: Span) -> bool {
  let reported = List<Diagnostic>.asSlice(&state.diagnostics)
  if reported.length == usize.ZERO { return false }
  let earlier = match reported[usize.subtract(reported.length, usize.ONE)] {
    Diagnostic.ForeignSpelling {habit, span} if habit == Habit.PrefixDereference => span
    _ => { return false }
  }
  let text = Bytes.asSlice(&state.source)
  if earlier.end > star.start || star.start > text.length { return false }
  let mut at = earlier.end
  while at < star.start {
    if text[at] == 10 { return false }
    at = usize.add(at, usize.ONE)
  }
  return true
}

// Whether `kind` ends the expression a postfix `++` would close, as in `f(i++)` or `{ i++ }`.
fn closer(kind: TokenKind) -> bool {
  return kind == TokenKind.RightParenthesis || kind == TokenKind.RightBrace || kind == TokenKind.RightBracket || kind == TokenKind.Semicolon || kind == TokenKind.Comma || kind == TokenKind.EndOfFile
}

// Reports one spelling from another language at its `count` operator tokens, then keeps what it
// applies to, `left` and any operands, inside one error expression so nothing after it cascades.
effect fn foreign(state: &mut State, left: NodeId, habit: Habit, count: usize, allowRecord: bool) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let start = ParseState.spanAt(&state.*, 0).start
  let end = ParseState.spanAt(&state.*, usize.subtract(count, 1)).end
  let mut elements = run ParseState.wrap(left)
  let mut at: usize = 0
  while at < count {
    run ParseState.consume(&mut state.*, &mut elements)
    at = usize.add(at, 1)
  }
  if habit == Habit.CompoundAssignment || habit == Habit.Conditional || habit == Habit.Shift {
    run ParseState.attach(&mut elements, run parse(&mut state.*, allowRecord))
  }
  if habit == Habit.Conditional && ParseState.currentKind(&state.*) == TokenKind.Colon {
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.attach(&mut elements, run parse(&mut state.*, allowRecord))
  }
  run List<Diagnostic>.append(&mut state.diagnostics, Diagnostic.ForeignSpelling {habit: habit, span: Span.make(start, end)})
  return run ParseState.complete(&mut state.*, move elements, NodeKind.Error)
}

/// Parses the lane count of a `simd<T, N>` or `mask<N>` type: an expression that binds tighter than
/// every comparison, so the type's closing `>` is never read as an operator.
pub effect fn lanes(state: &mut State) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  return run infix(&mut state.*, 6, false)
}

/// Parses one expression, including all postfixes and operators up to its enclosing delimiter.
///
/// `allowRecord` controls brace ownership in conditions. Syntax diagnostics stay in the state;
/// allocation failure is the only effect failure. The result's node is already in the flat array.
pub effect fn parse(state: &mut State, allowRecord: bool) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  return run infix(&mut state.*, 1, allowRecord)
}
