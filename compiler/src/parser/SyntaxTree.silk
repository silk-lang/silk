    NodeKind.RequirementRow => "RequirementRow"
    NodeKind.Requirement => "Requirement"
    NodeKind.RowWithout => "RowWithout"
    NodeKind.WhereClause => "WhereClause"
    NodeKind.MembershipConstraint => "MembershipConstraint"
    NodeKind.ProviderConstraint => "ProviderConstraint"
    NodeKind.ParameterList => "ParameterList"
    NodeKind.ParameterDeclaration => "ParameterDeclaration"
    NodeKind.ReturnType => "ReturnType"
    NodeKind.Block => "Block"
    NodeKind.ExpressionStatement => "ExpressionStatement"
    NodeKind.ErrorStatement => "ErrorStatement"
    NodeKind.BindingStatement => "BindingStatement"
    NodeKind.PatternBindingStatement => "PatternBindingStatement"
    NodeKind.AssignmentStatement => "AssignmentStatement"
    NodeKind.ConditionalStatement => "ConditionalStatement"
    NodeKind.StaticConditionalStatement => "StaticConditionalStatement"
    NodeKind.StaticForStatement => "StaticForStatement"
    NodeKind.PatternConditionalStatement => "PatternConditionalStatement"
