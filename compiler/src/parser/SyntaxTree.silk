    NodeKind.FailStatement => "FailStatement"
    NodeKind.DropStatement => "DropStatement"
    NodeKind.UnsafeStatement => "UnsafeStatement"
    NodeKind.UnsafeExpression => "UnsafeExpression"
    NodeKind.CompileErrorExpression => "CompileErrorExpression"
    NodeKind.IntegerLiteralExpression => "IntegerLiteralExpression"
    NodeKind.DurationLiteralExpression => "DurationLiteralExpression"
    NodeKind.FloatingLiteralExpression => "FloatingLiteralExpression"
    NodeKind.StaticTextLiteralExpression => "StaticTextLiteralExpression"
