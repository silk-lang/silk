effect fn writeSpan(span: Span) -> () ! WriterError ? &mut Writer {
  run Format.display(&span.start)
  run Writer.writeString("..")
  return run Format.display(&span.end)
}

effect fn writeIndent(depth: usize) -> () ! WriterError ? &mut Writer {
  let mut at = usize.ZERO
  while at < depth {
    run Writer.writeString("  ")
    at = at + usize.ONE
  }
  return ()
}

// Writes token `index` as `Kind start..end "text"` and, for an invalid token, the lexical
// diagnostic the lexer recovers for it on the following line.
effect fn writeToken(tree: &SyntaxTree, index: usize, depth: usize) -> () ! WriterError ? &mut Writer {
  let token = List<Token>.get(&tree.tokens, index)
  let span = tokenSpan(token)
  let kind = tokenKind(token)
  run Writer.writeString(expectedTokenName(kind))
  run Writer.writeString(" ")
  run writeSpan(span)
  run Writer.writeString(" ")
  let source = Bytes.asSlice(&tree.source)
  run writeQuoted(Slice.view<u8>(source, span.start, span.end - span.start))
  run Writer.writeString("\n")
  let invalid = kind == TokenKind.InvalidDurationLiteral || kind == TokenKind.InvalidStaticLiteral
    || kind == TokenKind.Invalid
  if !invalid { return () }
  if let Option<LexicalDiagnostic>.Some {value} = move failureAt(source, span.start) {
    run writeIndent(depth + usize.ONE)
    run LexicalDiagnostic.write(move value)
  }
  return ()
}

// Writes node `index` at `depth`, then each of its elements one level deeper: a child node in
// the same form, a token with its text, and a missing token with its expected kind.
effect fn writeNode(tree: &SyntaxTree, index: usize, depth: usize) -> () ! WriterError ? &mut Writer {
  let nodes = List<Node>.asSlice(&tree.nodes)
  let node = &nodes[index]
  run writeIndent(depth)
  run Writer.writeString(nodeKindName(node.kind))
  run Writer.writeString(" ")
  run writeSpan(node.span)
  run Writer.writeString("\n")
  let elements = elementsOf(&tree.elements, node)
  let mut elementIndex = usize.ZERO
  while elementIndex < elements.length {
    match elements[elementIndex] {
      Element.Node {id} => run writeNode(tree, id.index, depth + usize.ONE)
      Element.Token {id} => {
        run writeIndent(depth + usize.ONE)
        run writeToken(tree, id.index, depth + usize.ONE)
      }
      Element.MissingToken {expected, span} => {
        run writeIndent(depth + usize.ONE)
        run Writer.writeString("missing ")
        run Writer.writeString(expectedTokenName(expected))
        run Writer.writeString(" ")
        run writeSpan(span)
        run Writer.writeString("\n")
      }
    }
    elementIndex = usize.add(elementIndex, usize.ONE)
  }
  return ()
}

effect fn writeDiagnostic(diagnostic: Diagnostic, index: usize) -> () ! WriterError ? &mut Writer {
  run Writer.writeString("#")
  run Format.display(&index)
  run Writer.writeString(" ")
  return match move diagnostic {
    Diagnostic.MissingToken {expected, span} => {
      run Writer.writeString("MissingToken ")
      run Writer.writeString(expectedTokenName(expected))
      run Writer.writeString(" ")
      run writeSpan(span)
      run Writer.writeString("\n")
    }
    Diagnostic.UnexpectedToken {actual, span} => {
      run Writer.writeString("UnexpectedToken ")
      run Writer.writeString(expectedTokenName(actual))
      run Writer.writeString(" ")
      run writeSpan(span)
      run Writer.writeString("\n")
    }
    Diagnostic.NestingLimit {limit, span} => {
      run Writer.writeString("NestingLimit ")
      run Format.display(&limit)
      run Writer.writeString(" ")
      run writeSpan(span)
      run Writer.writeString("\n")
    }
    Diagnostic.ReservedTemplate {span} => {
      run Writer.writeString("ReservedTemplate - ")
      run writeSpan(span)
      run Writer.writeString("\n")
    }
    Diagnostic.ReservedImportBinding {span} => {
      run Writer.writeString("ReservedImportBinding - ")
      run writeSpan(span)
      run Writer.writeString("\n")
    }
    Diagnostic.LoopStatement {span} => {
      run Writer.writeString("LoopStatement - ")
      run writeSpan(span)
      run Writer.writeString("\n")
    }
    Diagnostic.OptionalTypeSyntax {span} => {
      run Writer.writeString("OptionalTypeSyntax - ")
      run writeSpan(span)
      run Writer.writeString("\n")
    }
    Diagnostic.TupleTypeSyntax {span} => {
      run Writer.writeString("TupleTypeSyntax - ")
      run writeSpan(span)
      run Writer.writeString("\n")
    }
    Diagnostic.IfExpression {span} => {
      run Writer.writeString("IfExpression - ")
      run writeSpan(span)
      run Writer.writeString("\n")
    }
    Diagnostic.ForeignSpelling {habit: _, span} => {
      run Writer.writeString("ForeignSpelling - ")
      run writeSpan(span)
      run Writer.writeString("\n")
    }
    Diagnostic.WithClause {replacement: _, span} => {
      run Writer.writeString("WithClause - ")
      run writeSpan(span)
      run Writer.writeString("\n")
    }
  }
}

/// Writes the syntax tree indented by nesting, then the syntax diagnostics.
///
/// # When to use
///
/// Use to inspect parser output, as `silk dump syntax` does.
///
/// # Details
///
/// Each node is one line, `Kind start..end`, with its direct elements on the lines after it,
/// indented one level deeper. A token element is `Kind start..end "text"`, a missing token is
/// `missing Kind start..start`, and an invalid token is followed by its lexical diagnostic.
/// Whitespace and comments are not elements, so they appear only in [`writeTokens`]. Spans are
/// byte offsets into the source. The final section lists the parser diagnostics.
///
/// # Gotchas
///
/// This format is for humans and is not a stable serialization format. A writer failure
/// preserves any output prefix that the writer accepted.
pub effect fn write(tree: &SyntaxTree) -> () ! WriterError ? &mut Writer {
  run writeNode(tree, tree.root.index, usize.ZERO)
  run Writer.writeString("\ndiagnostics ")
  run Format.display(&List<Diagnostic>.length(&tree.diagnostics))
  run Writer.writeString("\n")
  let mut diagnosticIndex = usize.ZERO
  while diagnosticIndex < List<Diagnostic>.length(&tree.diagnostics) {
    run writeDiagnostic(List<Diagnostic>.get(&tree.diagnostics, diagnosticIndex), diagnosticIndex)
    diagnosticIndex = usize.add(diagnosticIndex, usize.ONE)
  }
  return ()
}

/// Writes every token the lexer produced, one per line, as `#index Kind start..end "text"`.
///
/// # When to use
///
/// Use to inspect lexer output, as `silk dump tokens` does.
///
/// # Details
///
/// The list includes whitespace and comments, in source order, and ends with the end-of-file
/// token. Spans are byte offsets into the source, and the text is quoted with `"`, `\` and line
/// breaks escaped. An invalid token is followed by the lexical diagnostic the lexer recovers for
/// it, indented on the next line.
///
/// # Gotchas
///
/// This format is for humans and is not a stable serialization format.
pub effect fn writeTokens(tree: &SyntaxTree) -> () ! WriterError ? &mut Writer {
  let mut index = usize.ZERO
  while index < List<Token>.length(&tree.tokens) {
    run Writer.writeString("#")
    run Format.display(&index)
    run Writer.writeString(" ")
    run writeToken(tree, index, usize.ZERO)
    index = usize.add(index, usize.ONE)
  }
  return ()
}
