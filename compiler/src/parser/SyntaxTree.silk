//! One recoverable syntax result backed by separate flat token and node arrays.
//!
//! # When to use
//!
//! Use [`SyntaxTree`] as the parser output for semantic analysis, compiler diagnostics, and source
//! tools that must continue after malformed syntax.
//!
//! # Details
//!
//! Tokens remain in their original lexer order, including whitespace and comments. Node elements
//! refer to significant tokens by token index. The parser does not copy token payloads into nodes.
//!
//! Nodes occupy one postorder array. A child node has a lower index than its parent. The root
//! identity selects the source-file node, which is the final node appended by the parser.
//!
//! Diagnostics and recovered syntax exist in the same result. Missing tokens are conceptual node
//! elements. Unexpected source remains available through error nodes and token identities.
//!
//! # Gotchas
//!
//! Every node and token identity is local to this value. Copying an identity into another syntax
//! tree does not preserve its meaning.

import lexer.Span {Span}
import lexer.Lexer {failureAt}
import lexer.LexicalDiagnostic {LexicalDiagnostic}
import lexer.Token {Token, TokenKind, kind as tokenKind, span as tokenSpan, writeQuoted}
import parser.Diagnostic {Diagnostic}
import parser.Element {Element}
import parser.Node {Node, NodeKind, elementsOf}
import parser.NodeId {NodeId}
import silk.text.format {Format}
import silk.collections.bytes {Bytes}
import silk.collections.slice {Slice}
import silk.core.option {Option}
import silk.num.usize
import silk.collections.list {List}
import silk.io.writer {Writer, WriterError}

/// Owns all token storage, node storage, root identity, and diagnostics for one source file.
///
/// # Details
///
/// Consumers resolve a node identity by indexing `nodes`. They resolve a token identity by
/// indexing `tokens`. A diagnostic does not invalidate an unrelated node or token.
pub struct SyntaxTree {
  /// Original source bytes addressed by token and node spans.
  pub source: Bytes,
  /// The complete lexer output in source order, including trivia.
  pub tokens: List<Token>,
  /// The postorder flat node storage addressed by [`NodeId`].
  pub nodes: List<Node>,
  /// The direct elements of every node, addressed by each node's element range.
  pub elements: List<Element>,
  /// The identity of the source-file node that owns all top-level elements.
  pub root: NodeId,
  /// Syntax diagnostics in parser discovery order.
  pub diagnostics: List<Diagnostic>,
}

fn nodeKindName(kind: NodeKind) -> string<'static> {
  return match kind {
    NodeKind.SourceFile => "SourceFile"
    NodeKind.ImportDeclaration => "ImportDeclaration"
    NodeKind.StaticConditionalDeclaration => "StaticConditionalDeclaration"
    NodeKind.DeclarationGroup => "DeclarationGroup"
    NodeKind.ImportPath => "ImportPath"
    NodeKind.ImportAlias => "ImportAlias"
    NodeKind.ImportMemberList => "ImportMemberList"
    NodeKind.ImportMember => "ImportMember"
    NodeKind.StructDeclaration => "StructDeclaration"
    NodeKind.TupleDeclaration => "TupleDeclaration"
    NodeKind.EnumDeclaration => "EnumDeclaration"
    NodeKind.EnumMember => "EnumMember"
    NodeKind.UnionDeclaration => "UnionDeclaration"
    NodeKind.UnionVariant => "UnionVariant"
    NodeKind.UnionVariantField => "UnionVariantField"
    NodeKind.AppliedMemberSelector => "AppliedMemberSelector"
    NodeKind.AppliedMemberExpression => "AppliedMemberExpression"
    NodeKind.UnionVariantPattern => "UnionVariantPattern"
    NodeKind.ServiceDeclaration => "ServiceDeclaration"
    NodeKind.InterfaceDeclaration => "InterfaceDeclaration"
    NodeKind.RoleDeclaration => "RoleDeclaration"
    NodeKind.RequirementSelector => "RequirementSelector"
    NodeKind.ServiceOperation => "ServiceOperation"
    NodeKind.ServiceInvalidMember => "ServiceInvalidMember"
    NodeKind.ConstantDeclaration => "ConstantDeclaration"
    NodeKind.PackageParameterDeclaration => "PackageParameterDeclaration"
    NodeKind.PackageParameterValidation => "PackageParameterValidation"
    NodeKind.TypeAliasDeclaration => "TypeAliasDeclaration"
    NodeKind.StructField => "StructField"
    NodeKind.ImplDeclaration => "ImplDeclaration"
    NodeKind.ImplOperation => "ImplOperation"
    NodeKind.TypeParameterList => "TypeParameterList"
    NodeKind.TypeParameter => "TypeParameter"
    NodeKind.LifetimeParameter => "LifetimeParameter"
    NodeKind.LifetimeType => "LifetimeType"
