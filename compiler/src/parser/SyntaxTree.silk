fn expectedTokenName(kind: TokenKind) -> string<'static> {
  return match kind {
    TokenKind.Whitespace => "Whitespace"
    TokenKind.LineComment => "LineComment"
    TokenKind.DocComment => "DocComment"
    TokenKind.ModuleDocComment => "ModuleDocComment"
    TokenKind.Identifier => "Identifier"
    TokenKind.Lifetime => "Lifetime"
    TokenKind.DecimalInteger => "DecimalInteger"
    TokenKind.DecimalFloat => "DecimalFloat"
    TokenKind.DurationLiteral => "DurationLiteral"
    TokenKind.InvalidDurationLiteral => "InvalidDurationLiteral"
    TokenKind.TextLiteral => "TextLiteral"
    TokenKind.ByteStringLiteral => "ByteStringLiteral"
    TokenKind.CharLiteral => "CharLiteral"
    TokenKind.InvalidStaticLiteral => "InvalidStaticLiteral"
    TokenKind.StaticKeyword => "StaticKeyword"
    TokenKind.CompileErrorKeyword => "CompileErrorKeyword"
    TokenKind.PubKeyword => "PubKeyword"
    TokenKind.StructKeyword => "StructKeyword"
    TokenKind.TupleKeyword => "TupleKeyword"
    TokenKind.EnumKeyword => "EnumKeyword"
    TokenKind.UnionKeyword => "UnionKeyword"
    TokenKind.TypeKeyword => "TypeKeyword"
    TokenKind.ServiceKeyword => "ServiceKeyword"
    TokenKind.InterfaceKeyword => "InterfaceKeyword"
    TokenKind.RoleKeyword => "RoleKeyword"
    TokenKind.EffectKeyword => "EffectKeyword"
    TokenKind.FnKeyword => "FnKeyword"
    TokenKind.RunKeyword => "RunKeyword"
    TokenKind.FailKeyword => "FailKeyword"
    TokenKind.DropKeyword => "DropKeyword"
    TokenKind.UnsafeKeyword => "UnsafeKeyword"
    TokenKind.ExternKeyword => "ExternKeyword"
    TokenKind.ExportKeyword => "ExportKeyword"
    TokenKind.ImplKeyword => "ImplKeyword"
    TokenKind.ForKeyword => "ForKeyword"
    TokenKind.ReturnKeyword => "ReturnKeyword"
    TokenKind.ImportKeyword => "ImportKeyword"
    TokenKind.AsKeyword => "AsKeyword"
    TokenKind.LetKeyword => "LetKeyword"
    TokenKind.ConstKeyword => "ConstKeyword"
    TokenKind.ParamKeyword => "ParamKeyword"
    TokenKind.MutKeyword => "MutKeyword"
    TokenKind.OnceKeyword => "OnceKeyword"
    TokenKind.MoveKeyword => "MoveKeyword"
    TokenKind.MatchKeyword => "MatchKeyword"
    TokenKind.IfKeyword => "IfKeyword"
    TokenKind.ElseKeyword => "ElseKeyword"
