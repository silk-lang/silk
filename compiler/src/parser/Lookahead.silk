//! Non-allocating lookahead for ambiguous angle brackets, array brackets, nominal constructors, and
//! match arms.
//!
//! Lookahead never appends nodes or diagnostics. A failed scan leaves the real parser untouched.
import lexer.Token {TokenKind}
import parser.ParseState {State}
import parser.ParseState
import silk.usize

/// Finds the token following a balanced generic suffix at the given significant-token offset.
///
/// Returns end-of-file for an incomplete suffix or an expression-only token. This distinguishes
/// `f<T>(x)` from `a < b` without speculative node allocation.
pub fn afterAngles(state: &State, start: usize) -> TokenKind {
  if ParseState.peek(state, start) != TokenKind.Less {
    return TokenKind.EndOfFile
  }
  let mut index = start
  let mut depth: usize = 0
  while true {
    let kind = ParseState.peek(state, index)
    if kind == TokenKind.EndOfFile {
      return kind
    }
    if kind == TokenKind.Less {
      depth = usize.add(depth, 1)
    } else if kind == TokenKind.Greater {
      depth = usize.subtract(depth, 1)
      if depth == 0 {
        return ParseState.peek(state, usize.add(index, 1))
      }
    } else if kind == TokenKind.Equals || kind == TokenKind.FatArrow || kind == TokenKind.LeftBrace || kind == TokenKind.RightBrace || kind == TokenKind.LetKeyword || kind == TokenKind.ReturnKeyword || kind == TokenKind.Plus || kind == TokenKind.Minus || kind == TokenKind.EqualEqual {
      return TokenKind.EndOfFile
    }
    index = usize.add(index, 1)
  }
  return TokenKind.EndOfFile
}

/// Reports a fixed-array type `[T; N]` starting at the current left bracket.
///
/// A semicolon at the bracket's own depth before its closing bracket makes it an array. This
/// distinguishes `&[T; N]`, a reference to an array, from the slice type `&[T]`.
pub fn fixedArray(state: &State) -> bool {
  if ParseState.currentKind(state) != TokenKind.LeftBracket {
    return false
  }
  let mut index: usize = 1
  let mut depth: usize = 0
  while true {
    let kind = ParseState.peek(state, index)
    if kind == TokenKind.EndOfFile || kind == TokenKind.LeftBrace || kind == TokenKind.RightBrace {
      return false
    }
    if kind == TokenKind.LeftBracket || kind == TokenKind.LeftParenthesis {
      depth = usize.add(depth, 1)
    } else if kind == TokenKind.RightParenthesis {
      if depth == 0 {
        return false
      }
      depth = usize.subtract(depth, 1)
    } else if kind == TokenKind.RightBracket {
      if depth == 0 {
        return false
      }
      depth = usize.subtract(depth, 1)
    } else if kind == TokenKind.Semicolon && depth == 0 {
      return true
    }
    index = usize.add(index, 1)
  }
  return false
}

/// Returns the offset after an identifier path of at most two segments.
pub fn afterPath(state: &State) -> usize {
  if ParseState.peek(state, 1) == TokenKind.Dot && ParseState.peek(state, 2) == TokenKind.Identifier {
    return 3
  }
  return 1
}

/// Reports an applied parent followed by a member selector, as in `Option<T>.Some`.
pub fn appliedMember(state: &State) -> bool {
  return ParseState.currentKind(state) == TokenKind.Identifier && afterAngles(state, afterPath(state)) == TokenKind.Dot
}

/// Reports a nominal record constructor at expression or nested-pattern position.
pub fn record(state: &State) -> bool {
  if ParseState.currentKind(state) != TokenKind.Identifier {
    return false
  }
  let offset = afterPath(state)
  return ParseState.peek(state, offset) == TokenKind.LeftBrace || afterAngles(state, offset) == TokenKind.LeftBrace
}

/// Reports a bare qualified unit member pattern, as in `Choice.None`.
pub fn enumMember(state: &State) -> bool {
  return ParseState.currentKind(state) == TokenKind.Identifier &&
    ParseState.peek(state, 1) == TokenKind.Dot &&
    ParseState.peek(state, 2) == TokenKind.Identifier &&
    ParseState.peek(state, 3) != TokenKind.LeftBrace &&
    ParseState.peek(state, 3) != TokenKind.Less &&
    ParseState.peek(state, 3) != TokenKind.Identifier
}

/// Reports a following match arm separator before a statement boundary.
///
/// Nested record patterns are balanced. The check is used only while recovering a missing arm
/// block terminator; normal expression parsing does not consume or inspect subsequent arms.
pub fn arm(state: &State) -> bool {
  let first = ParseState.currentKind(state)
  if first != TokenKind.Identifier && first != TokenKind.DecimalInteger && first != TokenKind.Minus {
    return false
  }
  let mut index: usize = 0
  let mut braces: usize = 0
  while true {
    let kind = ParseState.peek(state, index)
    if kind == TokenKind.EndOfFile {
      return false
    }
    if braces == 0 {
      if kind == TokenKind.FatArrow {
        return true
      }
      if kind == TokenKind.Equals || kind == TokenKind.RightBrace || kind == TokenKind.LetKeyword || kind == TokenKind.ReturnKeyword || kind == TokenKind.WhileKeyword || kind == TokenKind.PubKeyword || kind == TokenKind.Comma {
        return false
      }
    }
    if kind == TokenKind.LeftBrace {
      braces = usize.add(braces, 1)
    }
    if kind == TokenKind.RightBrace {
      if braces == 0 {
        return false
      }
      braces = usize.subtract(braces, 1)
    }
    index = usize.add(index, 1)
  }
  return false
}
