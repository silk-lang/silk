//! Non-allocating lookahead for ambiguous angle brackets, array brackets, nominal constructors, and
//! match arms.
//!
//! Lookahead never appends nodes or diagnostics. A failed scan leaves the real parser untouched.
import lexer.Token {TokenKind}
import parser.Grammar
import parser.ParseState {State}
import parser.ParseState
import silk.num.usize

/// Finds the token following a balanced generic suffix at the given significant-token offset.
///
/// Returns end-of-file for an incomplete suffix or an expression-only token. This distinguishes
/// `f<T>(x)` from `a < b` without speculative node allocation. A closing parenthesis or bracket
/// the suffix did not open, or `&&` and `||`, ends the scan, so `a < b && c > (d)` and
/// `f(a < b) > (c)` stay comparisons.
pub fn afterAngles(state: &State, start: usize) -> TokenKind {
  let end = anglesEnd(state, start)
  if end == usize.MAX {
    return TokenKind.EndOfFile
  }
  return ParseState.peek(state, usize.add(end, 1))
}

/// Finds the significant-token offset of the `>` that closes a balanced generic suffix opened at
/// `start`, or `usize.MAX` for an incomplete suffix or one holding an expression-only token.
pub fn anglesEnd(state: &State, start: usize) -> usize {
  if ParseState.peek(state, start) != TokenKind.Less {
    return usize.MAX
  }
  let mut index = start
  let mut depth: usize = 0
  let mut groups: usize = 0
  while true {
    let kind = ParseState.peek(state, index)
    if kind == TokenKind.EndOfFile {
      return usize.MAX
    }
    if kind == TokenKind.Less {
      depth = usize.add(depth, 1)
    } else if kind == TokenKind.Greater {
      depth = usize.subtract(depth, 1)
      if depth == 0 {
        return index
      }
    } else if kind == TokenKind.LeftParenthesis || kind == TokenKind.LeftBracket {
      groups = usize.add(groups, 1)
    } else if kind == TokenKind.RightParenthesis || kind == TokenKind.RightBracket {
      if groups == 0 {
        return usize.MAX
      }
      groups = usize.subtract(groups, 1)
    } else if kind == TokenKind.Equals || kind == TokenKind.FatArrow || kind == TokenKind.LeftBrace || kind == TokenKind.RightBrace || kind == TokenKind.LetKeyword || kind == TokenKind.ReturnKeyword || kind == TokenKind.Plus || kind == TokenKind.Minus || kind == TokenKind.EqualEqual || kind == TokenKind.AmpersandAmpersand || kind == TokenKind.PipePipe {
      return usize.MAX
    }
    index = usize.add(index, 1)
  }
  return usize.MAX
}

/// Reports a generic suffix at the current `<` that instantiates a named function as a value, as
/// in `let entry: extern "C" fn(i32) -> i32 = scaled<Two>`.
///
/// The balanced angles must end the expression: the token after them cannot begin an operand, as
/// a closing delimiter, a comma or a statement keyword cannot, or it starts a new line. An
/// operand on the same line, as in `a < b > c`, leaves both angles comparisons; an argument list
/// makes a call; a second `>` is a shift.
pub fn instantiation(state: &State) -> bool {
  let end = anglesEnd(state, 0)
  if end == usize.MAX {
    return false
  }
  let next = ParseState.peek(state, usize.add(end, 1))
  if next == TokenKind.LeftParenthesis || next == TokenKind.Dot || next == TokenKind.LeftBrace
    || next == TokenKind.Less || next == TokenKind.Greater {
    return false
  }
  return !Grammar.expressionStart(next) || ParseState.lineBreakAfter(state, end)
}

/// Reports a tuple literal at the current left parenthesis: a comma at the parenthesis's own depth
/// before its closing parenthesis.
pub fn tupleLiteral(state: &State) -> bool {
  let mut index: usize = 1
  let mut depth: usize = 0
  while true {
    let kind = ParseState.peek(state, index)
    if kind == TokenKind.EndOfFile {
      return false
    }
    if kind == TokenKind.LeftParenthesis || kind == TokenKind.LeftBracket || kind == TokenKind.LeftBrace {
      depth = usize.add(depth, 1)
    } else if kind == TokenKind.RightParenthesis || kind == TokenKind.RightBracket || kind == TokenKind.RightBrace {
      if depth == 0 {
        return false
      }
      depth = usize.subtract(depth, 1)
    } else if kind == TokenKind.Comma && depth == 0 {
      return true
    }
    index = usize.add(index, 1)
  }
  return false
}

/// Returns the offset after an identifier path of at most two segments.
pub fn afterPath(state: &State) -> usize {
  if ParseState.peek(state, 1) == TokenKind.Dot && ParseState.peek(state, 2) == TokenKind.Identifier {
    return 3
  }
  return 1
}

/// Reports an applied parent followed by a member selector, as in `Option<T>.Some`.
pub fn appliedMember(state: &State) -> bool {
  return ParseState.currentKind(state) == TokenKind.Identifier && afterAngles(state, afterPath(state)) == TokenKind.Dot
}

/// Reports `Union.[variant] {`, a variant chosen by a static descriptor.
pub fn variantSelect(state: &State) -> bool {
  return ParseState.currentKind(state) == TokenKind.Identifier && ParseState.peek(state, 1) == TokenKind.Dot
    && ParseState.peek(state, 2) == TokenKind.LeftBracket
}

/// Reports a nominal record constructor at expression or nested-pattern position.
pub fn record(state: &State) -> bool {
  if ParseState.currentKind(state) != TokenKind.Identifier {
    return false
  }
  let offset = afterPath(state)
  return ParseState.peek(state, offset) == TokenKind.LeftBrace || afterAngles(state, offset) == TokenKind.LeftBrace
}

/// Reports a bare qualified unit member pattern, as in `Choice.None`.
pub fn enumMember(state: &State) -> bool {
  return ParseState.currentKind(state) == TokenKind.Identifier &&
    ParseState.peek(state, 1) == TokenKind.Dot &&
    ParseState.peek(state, 2) == TokenKind.Identifier &&
    ParseState.peek(state, 3) != TokenKind.LeftBrace &&
    ParseState.peek(state, 3) != TokenKind.Less &&
    ParseState.peek(state, 3) != TokenKind.Identifier
}

/// Reports a following match arm separator before a statement boundary.
///
/// Nested record patterns are balanced. The check is used only while recovering a missing arm
/// block terminator; normal expression parsing does not consume or inspect subsequent arms.
pub fn arm(state: &State) -> bool {
  let first = ParseState.currentKind(state)
  if first != TokenKind.Identifier && first != TokenKind.DecimalInteger && first != TokenKind.Minus {
    return false
  }
  let mut index: usize = 0
  let mut braces: usize = 0
  while true {
    let kind = ParseState.peek(state, index)
    if kind == TokenKind.EndOfFile {
      return false
    }
    if braces == 0 {
      if kind == TokenKind.FatArrow {
        return true
      }
      if kind == TokenKind.Equals || kind == TokenKind.RightBrace || kind == TokenKind.LetKeyword || kind == TokenKind.ReturnKeyword || kind == TokenKind.WhileKeyword || kind == TokenKind.PubKeyword || kind == TokenKind.Comma {
        return false
      }
    }
    if kind == TokenKind.LeftBrace {
      braces = usize.add(braces, 1)
    }
    if kind == TokenKind.RightBrace {
      if braces == 0 {
        return false
      }
      braces = usize.subtract(braces, 1)
    }
    index = usize.add(index, 1)
  }
  return false
}
