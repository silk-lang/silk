//! Top-level and member declarations for the self-hosted compiler.
//!
//! Dispatch examines complete modifier prefixes: `pub` by itself never implies an import.
//! Related nominal declarations share header parsing while their member grammars remain separate.
//! Native headers and sealed properties are retained for semantic validation, not interpreted here.
import lexer.Token {TokenKind}
import parser.Node {NodeKind}
import parser.ParseState {State, ElementsResult, NodeResult}
import parser.ParseState
import parser.Import {parseImportDeclaration}
import parser.Type
import parser.Expression
import parser.Statement
import parser.Property
import parser.Grammar
import silk.allocator {Allocator, OutOfMemoryError}
import silk.usize

effect fn nominalHeader(initial: State, keyword: TokenKind) -> ElementsResult
! OutOfMemoryError
? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.optional(TokenKind.PubKeyword)
  if keyword == TokenKind.StructKeyword && ParseState.currentKind(&p.state) == TokenKind.ExternKeyword {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    let afterTextLiteral = run move p
      |> ParseState.expect(TokenKind.TextLiteral)
    p = move afterTextLiteral
  }
  let advanced = run move p
    |> ParseState.expect(keyword)
  p = move advanced
  if keyword == TokenKind.EnumKeyword && ParseState.currentKind(&p.state) == TokenKind.LeftParenthesis {
    let consumed2 = run move p
      |> ParseState.consume
    p = move consumed2
    let withTypesParse = run ParseState.attach(move p.elements, run Type.parse(move p.state))
    p = move withTypesParse
    let afterRightParenthesis = run move p
      |> ParseState.expect(TokenKind.RightParenthesis)
    p = move afterRightParenthesis
  }
  let afterIdentifier = run move p
    |> ParseState.expect(TokenKind.Identifier)
  p = move afterIdentifier
  if ParseState.currentKind(&p.state) == TokenKind.Less {
    let withTypesParameters = run ParseState.attach(
      move p.elements,
      run Type.parameters(move p.state, false),
    )
    p = move withTypesParameters
  }
  return move p
}

effect fn field(initial: State, kind: NodeKind) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.optional(TokenKind.PubKeyword)
  let afterIdentifier = run move p
    |> ParseState.expect(TokenKind.Identifier)
  p = move afterIdentifier
  let afterColon = run move p
    |> ParseState.expect(TokenKind.Colon)
  p = move afterColon
  if ParseState.currentKind(&p.state) == TokenKind.Identifier && ParseState.peek(&p.state, 1) == TokenKind.Colon {
    let missing = run ParseState.complete(
      run ParseState.missing(ParseState.begin(move p.state), TokenKind.Identifier),
      NodeKind.TypePath,
    )
    let attached = run ParseState.attach(move p.elements, move missing)
    p = move attached
  } else {
    let withTypesParse = run ParseState.attach(move p.elements, run Type.parse(move p.state))
    p = move withTypesParse
  }
  return run move p
    |> ParseState.complete(kind)
}

effect fn structDeclaration(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run nominalHeader(move initial, TokenKind.StructKeyword)
  let afterLeftBrace = run move p
    |> ParseState.expect(TokenKind.LeftBrace)
  p = move afterLeftBrace
  while !Grammar.declarationStart(&p.state) && (ParseState.currentKind(&p.state) == TokenKind.Identifier || ParseState.currentKind(
    &p.state,
  ) == TokenKind.PubKeyword) {
    let attached = run ParseState.attach(
      move p.elements,
      run field(move p.state, NodeKind.StructField),
    )
    p = move attached
    if ParseState.currentKind(&p.state) == TokenKind.Comma {
      // Declaration fields are whitespace-separated. Consume and diagnose the authored comma
      // while retaining subsequent fields, rather than silently truncating the record.
      let recovered = run ParseState.unexpected(move p)
      p = move recovered
    }
  }
  let afterRightBrace = run move p
    |> ParseState.expect(TokenKind.RightBrace)
  p = move afterRightBrace
  return run move p
    |> ParseState.complete(NodeKind.StructDeclaration)
}

effect fn tupleDeclaration(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run nominalHeader(move initial, TokenKind.TupleKeyword)
  let afterLeftParenthesis = run move p
    |> ParseState.expect(TokenKind.LeftParenthesis)
  p = move afterLeftParenthesis
  while Grammar.typeStart(ParseState.currentKind(&p.state)) {
    let before = p.state.index
    let withTypesParse = run ParseState.attach(move p.elements, run Type.parse(move p.state))
    p = move withTypesParse
    if p.state.index == before || ParseState.currentKind(&p.state) == TokenKind.RightParenthesis {
      break
    }
    let afterComma = run move p
      |> ParseState.expect(TokenKind.Comma)
    p = move afterComma
  }
  let afterRightParenthesis = run move p
    |> ParseState.expect(TokenKind.RightParenthesis)
  p = move afterRightParenthesis
  return run move p
    |> ParseState.complete(NodeKind.TupleDeclaration)
}

effect fn enumMember(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.Identifier)
  if ParseState.currentKind(&p.state) == TokenKind.Equals {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    let mut literal = run move p.state
      |> ParseState.begin
      |> ParseState.optional(TokenKind.Minus)
    let afterDecimalInteger = run move literal
      |> ParseState.expect(TokenKind.DecimalInteger)
    literal = move afterDecimalInteger
    let attached = run ParseState.attach(
      move p.elements,
      run ParseState.complete(move literal, NodeKind.IntegerLiteralExpression),
    )
    p = move attached
  }
  return run move p
    |> ParseState.complete(NodeKind.EnumMember)
}

effect fn variant(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.Identifier)
  if ParseState.currentKind(&p.state) == TokenKind.LeftBrace {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    // An immediately closing brace is an empty field block, not a damaged field: `Empty {}` is a
    // variant that wrote braces and declared nothing. Only a field-starting token enters the loop.
    while !Grammar.declarationStart(&p.state) && (ParseState.currentKind(&p.state) == TokenKind.Identifier || ParseState.currentKind(
      &p.state,
    ) == TokenKind.PubKeyword) {
      let attached2 = run ParseState.attach(
        move p.elements,
        run field(move p.state, NodeKind.UnionVariantField),
      )
      p = move attached2
      if ParseState.currentKind(&p.state) == TokenKind.RightBrace {
        break
      }
      let afterComma = run move p
        |> ParseState.expect(TokenKind.Comma)
      p = move afterComma
    }
    let afterRightBrace = run move p
      |> ParseState.expect(TokenKind.RightBrace)
    p = move afterRightBrace
  }
  return run move p
    |> ParseState.complete(NodeKind.UnionVariant)
}

effect fn sumDeclaration(initial: State, isUnion: bool) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  let mut keyword = TokenKind.EnumKeyword
  if isUnion {
    keyword = TokenKind.UnionKeyword
  }
  let mut p = run nominalHeader(move initial, keyword)
  let afterLeftBrace = run move p
    |> ParseState.expect(TokenKind.LeftBrace)
  p = move afterLeftBrace
  while ParseState.currentKind(&p.state) == TokenKind.Identifier {
    if isUnion {
      let attached = run ParseState.attach(move p.elements, run variant(move p.state))
      p = move attached
    } else {
      let attached2 = run ParseState.attach(move p.elements, run enumMember(move p.state))
      p = move attached2
    }
    if ParseState.currentKind(&p.state) == TokenKind.RightBrace {
      break
    }
    let afterComma = run move p
      |> ParseState.expect(TokenKind.Comma)
    p = move afterComma
  }
  let afterRightBrace = run move p
    |> ParseState.expect(TokenKind.RightBrace)
  p = move afterRightBrace
  if isUnion {
    return run move p
      |> ParseState.complete(NodeKind.UnionDeclaration)
  }
  return run move p
    |> ParseState.complete(NodeKind.EnumDeclaration)
}

effect fn alias(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run nominalHeader(move initial, TokenKind.TypeKeyword)
  let afterEquals = run move p
    |> ParseState.expect(TokenKind.Equals)
  p = move afterEquals
  let withTypesParse = run ParseState.attach(move p.elements, run Type.parse(move p.state))
  p = move withTypesParse
  return run move p
    |> ParseState.complete(NodeKind.TypeAliasDeclaration)
}

effect fn constant(initial: State, parameter: bool) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  let mut keyword = TokenKind.ConstKeyword
  if parameter {
    keyword = TokenKind.ParamKeyword
  }
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.optional(TokenKind.PubKeyword)
  let advanced = run move p
    |> ParseState.expect(keyword)
  p = move advanced
  let afterIdentifier = run move p
    |> ParseState.expect(TokenKind.Identifier)
  p = move afterIdentifier
  let afterColon = run move p
    |> ParseState.expect(TokenKind.Colon)
  p = move afterColon
  let withTypesParse = run ParseState.attach(move p.elements, run Type.parse(move p.state))
  p = move withTypesParse
  if !parameter || ParseState.currentKind(&p.state) == TokenKind.Equals {
    let afterEquals = run move p
      |> ParseState.expect(TokenKind.Equals)
    p = move afterEquals
    let withExpressionsParse = run ParseState.attach(
      move p.elements,
      run Expression.parse(move p.state, false),
    )
    p = move withExpressionsParse
  }
  if parameter && ParseState.word(&p.state, "where") {
    let mut validation = run move p.state
      |> ParseState.begin
      |> ParseState.consume
    let attached = run ParseState.attach(
      move validation.elements,
      run Expression.parse(move validation.state, false),
    )
    validation = move attached
    let attached2 = run ParseState.attach(
      move p.elements,
      run ParseState.complete(move validation, NodeKind.PackageParameterValidation),
    )
    p = move attached2
  }
  if parameter {
    return run move p
      |> ParseState.complete(NodeKind.PackageParameterDeclaration)
  }
  return run move p
    |> ParseState.complete(NodeKind.ConstantDeclaration)
}

effect fn operator(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.consume
  let kind = ParseState.currentKind(&p.state)
  if Grammar.precedence(kind) > 0 || kind == TokenKind.Bang || kind == TokenKind.Tilde || kind == TokenKind.Equals || kind == TokenKind.RunKeyword {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
  } else {
    let afterStar = run move p
      |> ParseState.missing(TokenKind.Star)
    p = move afterStar
  }
  return run move p
    |> ParseState.complete(NodeKind.OperatorMarker)
}

effect fn functionPrefix(initial: State, operation: bool) -> ElementsResult
! OutOfMemoryError
? &mut Allocator {
  let mut p = ParseState.begin(move initial)
  if operation && ParseState.word(&p.state, "operator") {
    let attached = run ParseState.attach(move p.elements, run operator(move p.state))
    p = move attached
  }
  let afterPubKeyword = run move p
    |> ParseState.optional(TokenKind.PubKeyword)
  p = move afterPubKeyword
  if !operation && ParseState.word(&p.state, "test") {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
  }
  let afterStaticKeyword = run move p
    |> ParseState.optional(TokenKind.StaticKeyword)
  p = move afterStaticKeyword
  let afterUnsafeKeyword = run move p
    |> ParseState.optional(TokenKind.UnsafeKeyword)
  p = move afterUnsafeKeyword
  return move p
}

effect fn functionName(initial: ElementsResult, allowDrop: bool) -> ElementsResult
! OutOfMemoryError
? &mut Allocator {
  let mut p = move initial
  if ParseState.currentKind(&p.state) == TokenKind.EffectKeyword {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    if ParseState.currentKind(&p.state) == TokenKind.Less {
      let withTypesEnvironment = run ParseState.attach(
        move p.elements,
        run Type.environment(move p.state, true),
      )
      p = move withTypesEnvironment
    }
  }
  let afterFnKeyword = run move p
    |> ParseState.expect(TokenKind.FnKeyword)
  p = move afterFnKeyword
  if allowDrop && ParseState.currentKind(&p.state) == TokenKind.DropKeyword {
    let consumed2 = run move p
      |> ParseState.consume
    p = move consumed2
  } else {
    let afterIdentifier = run move p
      |> ParseState.expect(TokenKind.Identifier)
    p = move afterIdentifier
  }
  return run Type.contract(move p)
}

effect fn symbol(initial: ElementsResult) -> ElementsResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = move initial
  if ParseState.currentKind(&p.state) == TokenKind.AsKeyword {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    let afterTextLiteral = run move p
      |> ParseState.expect(TokenKind.TextLiteral)
    p = move afterTextLiteral
  }
  return move p
}

effect fn functionDeclaration(initial: State, operation: bool, allowDrop: bool) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  let mut p = run functionPrefix(move initial, operation)
  let marker = ParseState.currentKind(&p.state)
  let foreign = marker == TokenKind.ExternKeyword
  let exported = marker == TokenKind.ExportKeyword
  if foreign || exported {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    let afterTextLiteral = run move p
      |> ParseState.expect(TokenKind.TextLiteral)
    p = move afterTextLiteral
  }
  let advanced = run functionName(move p, allowDrop)
  p = move advanced
  if foreign || exported {
    let advanced2 = run symbol(move p)
    p = move advanced2
  }
  let advanced3 = run Property.list(move p)
  p = move advanced3
  if (!foreign && !operation) || ParseState.currentKind(&p.state) == TokenKind.LeftBrace {
    let attached = run ParseState.attach(
      move p.elements,
      run Statement.block(move p.state, !operation, false),
    )
    p = move attached
  }
  if operation {
    return run move p
      |> ParseState.complete(NodeKind.ServiceOperation)
  }
  if foreign {
    return run move p
      |> ParseState.complete(NodeKind.ForeignFunctionDeclaration)
  }
  return run move p
    |> ParseState.complete(NodeKind.FunctionDeclaration)
}

fn operationStart(state: &State) -> bool {
  let kind = ParseState.currentKind(state)
  return kind == TokenKind.FnKeyword || kind == TokenKind.EffectKeyword || kind == TokenKind.UnsafeKeyword || ParseState.word(
    state,
    "operator",
  )
}

effect fn serviceDeclaration(initial: State, isInterface: bool) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  let mut keyword = TokenKind.ServiceKeyword
  if isInterface {
    keyword = TokenKind.InterfaceKeyword
  }
  let mut p = run nominalHeader(move initial, keyword)
  let afterLeftBrace = run move p
    |> ParseState.expect(TokenKind.LeftBrace)
  p = move afterLeftBrace
  while ParseState.currentKind(&p.state) != TokenKind.RightBrace && ParseState.currentKind(&p.state) != TokenKind.EndOfFile {
    if operationStart(&p.state) {
      let attached = run ParseState.attach(
        move p.elements,
        run functionDeclaration(move p.state, true, false),
      )
      p = move attached
    } else {
      if Grammar.declarationStart(&p.state) {
        break
      }
      let error = run ParseState.complete(
        run ParseState.unexpected(ParseState.begin(move p.state)),
        NodeKind.ServiceInvalidMember,
      )
      let attached2 = run ParseState.attach(move p.elements, move error)
      p = move attached2
    }
  }
  let afterRightBrace = run move p
    |> ParseState.expect(TokenKind.RightBrace)
  p = move afterRightBrace
  if isInterface {
    return run move p
      |> ParseState.complete(NodeKind.InterfaceDeclaration)
  }
  return run move p
    |> ParseState.complete(NodeKind.ServiceDeclaration)
}

effect fn implOperation(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.Identifier)
  let afterColon = run move p
    |> ParseState.expect(TokenKind.Colon)
  p = move afterColon
  let withTypesPath = run ParseState.attach(move p.elements, run Type.path(move p.state))
  p = move withTypesPath
  return run move p
    |> ParseState.complete(NodeKind.ImplOperation)
}

effect fn implementation(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.consume
  if ParseState.currentKind(&p.state) == TokenKind.Less {
    let withTypesParameters = run ParseState.attach(
      move p.elements,
      run Type.parameters(move p.state, false),
    )
    p = move withTypesParameters
  }
  let withTypesParse = run ParseState.attach(move p.elements, run Type.parse(move p.state))
  p = move withTypesParse
  if ParseState.currentKind(&p.state) == TokenKind.ForKeyword {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    let withTypesParse2 = run ParseState.attach(move p.elements, run Type.parse(move p.state))
    p = move withTypesParse2
  }
  if ParseState.word(&p.state, "where") {
    let withWhere = run ParseState.attach(move p.elements, run Type.whereClause(move p.state))
    p = move withWhere
  }
  let afterLeftBrace = run move p
    |> ParseState.expect(TokenKind.LeftBrace)
  p = move afterLeftBrace
  while ParseState.currentKind(&p.state) == TokenKind.Identifier || ParseState.currentKind(&p.state) == TokenKind.PubKeyword || ParseState.currentKind(
    &p.state,
  ) == TokenKind.StaticKeyword || operationStart(&p.state) {
    if ParseState.currentKind(&p.state) == TokenKind.Identifier && !Grammar.testFunctionStart(
      &p.state,
      usize.ZERO,
    ) {
      let attached = run ParseState.attach(move p.elements, run implOperation(move p.state))
      p = move attached
    } else {
      let before = p.state.index
      let attached2 = run ParseState.attach(
        move p.elements,
        run functionDeclaration(move p.state, false, true),
      )
      p = move attached2
      if p.state.index == before {
        break
      }
    }
  }
  let afterRightBrace = run move p
    |> ParseState.expect(TokenKind.RightBrace)
  p = move afterRightBrace
  return run move p
    |> ParseState.complete(NodeKind.ImplDeclaration)
}

effect fn foreignStatic(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let imported = ParseState.currentKind(&initial) == TokenKind.UnsafeKeyword
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.optional(TokenKind.UnsafeKeyword)
  if imported {
    let afterExternKeyword = run move p
      |> ParseState.expect(TokenKind.ExternKeyword)
    p = move afterExternKeyword
  } else {
    let afterExportKeyword = run move p
      |> ParseState.expect(TokenKind.ExportKeyword)
    p = move afterExportKeyword
  }
  let afterTextLiteral = run move p
    |> ParseState.expect(TokenKind.TextLiteral)
  p = move afterTextLiteral
  let afterStaticKeyword = run move p
    |> ParseState.expect(TokenKind.StaticKeyword)
  p = move afterStaticKeyword
  let afterIdentifier = run move p
    |> ParseState.expect(TokenKind.Identifier)
  p = move afterIdentifier
  let afterColon = run move p
    |> ParseState.expect(TokenKind.Colon)
  p = move afterColon
  let withTypesParse = run ParseState.attach(move p.elements, run Type.parse(move p.state))
  p = move withTypesParse
  let advanced = run symbol(move p)
  p = move advanced
  if imported {
    let advanced2 = run Property.list(move p)
    p = move advanced2
    return run move p
      |> ParseState.complete(NodeKind.ForeignStaticDeclaration)
  }
  let afterEquals = run move p
    |> ParseState.expect(TokenKind.Equals)
  p = move afterEquals
  let withExpressionsParse = run ParseState.attach(
    move p.elements,
    run Expression.parse(move p.state, false),
  )
  p = move withExpressionsParse
  return run move p
    |> ParseState.complete(NodeKind.ExportStaticDeclaration)
}

effect fn group(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let opened = ParseState.currentKind(&initial) == TokenKind.LeftBrace
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.LeftBrace)
  if opened {
    while ParseState.currentKind(&p.state) != TokenKind.RightBrace && ParseState.currentKind(
      &p.state,
    ) != TokenKind.ElseKeyword && ParseState.currentKind(&p.state) != TokenKind.EndOfFile {
      let before = p.state.index
      let attached = run ParseState.attach(move p.elements, run parse(move p.state))
      p = move attached
      if p.state.index == before {
        let advanced = run move p
          |> ParseState.unexpected
        p = move advanced
      }
    }
  }
  let afterRightBrace = run move p
    |> ParseState.expect(TokenKind.RightBrace)
  p = move afterRightBrace
  return run move p
    |> ParseState.complete(NodeKind.DeclarationGroup)
}

effect fn staticConditional(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  if initial.depth >= ParseState.NESTING_LIMIT {
    return run move initial
      |> ParseState.nestingError
  }
  let depth = initial.depth
  let mut state = move initial
  state.depth = usize.add(depth, 1)
  let mut result = run staticConditionalInner(move state)
  result.state.depth = depth
  return move result
}

effect fn staticConditionalInner(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.consume
  let afterIfKeyword = run move p
    |> ParseState.expect(TokenKind.IfKeyword)
  p = move afterIfKeyword
  let withExpressionsParse = run ParseState.attach(
    move p.elements,
    run Expression.parse(move p.state, false),
  )
  p = move withExpressionsParse
  let attached = run ParseState.attach(move p.elements, run group(move p.state))
  p = move attached
  if ParseState.currentKind(&p.state) == TokenKind.ElseKeyword {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    if ParseState.currentKind(&p.state) == TokenKind.StaticKeyword {
      let attached2 = run ParseState.attach(move p.elements, run staticConditional(move p.state))
      p = move attached2
    } else {
      let attached3 = run ParseState.attach(move p.elements, run group(move p.state))
      p = move attached3
    }
  }
  return run move p
    |> ParseState.complete(NodeKind.StaticConditionalDeclaration)
}

/// Parses a declaration selected from its significant-token prefix, preserving damaged regions.
///
/// Public fields are not declaration starts. Foreign static headers are recognized before
/// ordinary function headers, and static conditionals own nested declaration groups.
pub effect fn parse(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let kind = ParseState.currentKind(&initial)
  let mut head = kind
  let mut offset: usize = 0
  if kind == TokenKind.PubKeyword {
    head = ParseState.peek(&initial, 1)
    offset = 1
  }
  if kind == TokenKind.StaticKeyword && ParseState.peek(&initial, 1) == TokenKind.IfKeyword {
    return run staticConditional(move initial)
  }
  if (kind == TokenKind.UnsafeKeyword && ParseState.peek(&initial, 1) == TokenKind.ExternKeyword && ParseState.peek(
    &initial,
    3,
  ) == TokenKind.StaticKeyword) || (kind == TokenKind.ExportKeyword && ParseState.peek(&initial, 2) == TokenKind.StaticKeyword) {
    return run foreignStatic(move initial)
  }
  if head == TokenKind.ImportKeyword {
    return run parseImportDeclaration(move initial)
  }
  if head == TokenKind.ConstKeyword {
    return run constant(move initial, false)
  }
  if head == TokenKind.ParamKeyword {
    return run constant(move initial, true)
  }
  if head == TokenKind.StructKeyword || (head == TokenKind.ExternKeyword && ((offset == 0 && ParseState.peek(
    &initial,
    2,
  ) == TokenKind.StructKeyword) || (offset == 1 && ParseState.peek(&initial, 3) == TokenKind.StructKeyword))) {
    return run structDeclaration(move initial)
  }
  if head == TokenKind.TupleKeyword {
    return run tupleDeclaration(move initial)
  }
  if head == TokenKind.EnumKeyword {
    return run sumDeclaration(move initial, false)
  }
  if head == TokenKind.UnionKeyword {
    return run sumDeclaration(move initial, true)
  }
  if head == TokenKind.TypeKeyword {
    return run alias(move initial)
  }
  if head == TokenKind.ServiceKeyword {
    return run serviceDeclaration(move initial, false)
  }
  if head == TokenKind.InterfaceKeyword {
    return run serviceDeclaration(move initial, true)
  }
  if head == TokenKind.RoleKeyword {
    return run ParseState.complete(
      run nominalHeader(move initial, TokenKind.RoleKeyword),
      NodeKind.RoleDeclaration,
    )
  }
  if head == TokenKind.ImplKeyword {
    return run implementation(move initial)
  }
  if ParseState.word(&initial, "module") {
    let mut p = run move initial
      |> ParseState.begin
      |> ParseState.consume
    let withPropertiesClause = run ParseState.attach(
      move p.elements,
      run Property.clause(move p.state),
    )
    p = move withPropertiesClause
    return run move p
      |> ParseState.complete(NodeKind.ModulePropertyDeclaration)
  }
  if Grammar.testFunctionStart(&initial, offset) || head == TokenKind.FnKeyword || head == TokenKind.EffectKeyword || head == TokenKind.UnsafeKeyword || head == TokenKind.ExternKeyword || head == TokenKind.ExportKeyword || head == TokenKind.StaticKeyword {
    return run functionDeclaration(move initial, false, false)
  }
  return run ParseState.complete(
    run ParseState.unexpected(ParseState.begin(move initial)),
    NodeKind.Error,
  )
}
