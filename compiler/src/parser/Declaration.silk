//! Top-level and member declarations for the self-hosted compiler.
//!
//! Dispatch examines complete modifier prefixes: `pub` by itself never implies an import.
//! Related nominal declarations share header parsing while their member grammars remain separate.
//! Native headers and sealed properties are retained for semantic validation, not interpreted here.
import lexer.Token {TokenKind}
import parser.Node {NodeKind}
import parser.Element {Element}
import parser.NodeId {NodeId}
import parser.ParseState {State}
import parser.ParseState
import parser.Import {parseImportDeclaration}
import parser.Type
import parser.Expression
import parser.Statement
import parser.Property
import parser.Directive
import parser.Grammar
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize
import silk.collections.list {List}

effect fn nominalHeader(state: &mut State, keyword: TokenKind, leading: List<Element>) -> List<Element>
! OutOfMemoryError
? &mut Allocator {
  let mut elements = move leading
  run ParseState.optional(&mut state.*, &mut elements, TokenKind.PubKeyword)
  if keyword == TokenKind.StructKeyword && ParseState.currentKind(&state.*) == TokenKind.ExternKeyword {
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.TextLiteral)
  }
  run ParseState.expect(&mut state.*, &mut elements, keyword)
  if keyword == TokenKind.EnumKeyword && ParseState.currentKind(&state.*) == TokenKind.LeftParenthesis {
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.attach(&mut elements, run Type.parse(&mut state.*))
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightParenthesis)
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  if ParseState.currentKind(&state.*) == TokenKind.Less {
    run ParseState.attach(&mut elements, run Type.parameters(&mut state.*, false))
  }
  return move elements
}

effect fn field(state: &mut State, kind: NodeKind) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.optional(&mut state.*, &mut elements, TokenKind.PubKeyword)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Colon)
  if ParseState.currentKind(&state.*) == TokenKind.Identifier && ParseState.peek(&state.*, 1) == TokenKind.Colon {
    let mut absent = List<Element>.make()
    run ParseState.missing(&mut state.*, &mut absent, TokenKind.Identifier)
    let missing = run ParseState.complete(&mut state.*, move absent, NodeKind.TypePath)
    run ParseState.attach(&mut elements, missing)
  } else {
    run ParseState.attach(&mut elements, run Type.parse(&mut state.*))
  }
  return run ParseState.complete(&mut state.*, move elements, kind)
}

// Whether the current token begins a struct field.
fn fieldStart(state: &State) -> bool {
  let kind = ParseState.currentKind(state)
  return !Grammar.declarationStart(state) && (kind == TokenKind.Identifier || kind == TokenKind.PubKeyword)
}

effect fn structDeclaration(state: &mut State, leading: List<Element>) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = run nominalHeader(&mut state.*, TokenKind.StructKeyword, move leading)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.LeftBrace)
  while fieldStart(&state.*) {
    run ParseState.attach(&mut elements, run field(&mut state.*, NodeKind.StructField))
    // Fields are separated by commas, as a union variant's are, and a trailing comma is allowed.
    let another = fieldStart(&state.*)
    if !(run ParseState.separator(&mut state.*, &mut elements, another)) {
      break
    }
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightBrace)
  return run ParseState.complete(&mut state.*, move elements, NodeKind.StructDeclaration)
}

effect fn tupleDeclaration(state: &mut State, leading: List<Element>) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = run nominalHeader(&mut state.*, TokenKind.TupleKeyword, move leading)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.LeftParenthesis)
  while Grammar.typeStart(ParseState.currentKind(&state.*)) {
    let before = state.index
    run ParseState.attach(&mut elements, run Type.parse(&mut state.*))
    if state.index == before {
      break
    }
    let another = Grammar.typeStart(ParseState.currentKind(&state.*))
    if !(run ParseState.separator(&mut state.*, &mut elements, another)) {
      break
    }
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightParenthesis)
  return run ParseState.complete(&mut state.*, move elements, NodeKind.TupleDeclaration)
}

effect fn enumMember(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  if ParseState.currentKind(&state.*) == TokenKind.Equals {
    run ParseState.consume(&mut state.*, &mut elements)
    let mut literal = List<Element>.make()
    run ParseState.optional(&mut state.*, &mut literal, TokenKind.Minus)
    run ParseState.expect(&mut state.*, &mut literal, TokenKind.DecimalInteger)
    run ParseState.attach(
      &mut elements,
      run ParseState.complete(&mut state.*, move literal, NodeKind.IntegerLiteralExpression),
    )
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.EnumMember)
}

effect fn variant(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  if ParseState.currentKind(&state.*) == TokenKind.LeftBrace {
    run ParseState.consume(&mut state.*, &mut elements)
    // An immediately closing brace is an empty field block, not a damaged field: `Empty {}` is a
    // variant that wrote braces and declared nothing. Only a field-starting token enters the loop.
    while !Grammar.declarationStart(&state.*) && (ParseState.currentKind(&state.*) == TokenKind.Identifier || ParseState.currentKind(
      &state.*,
    ) == TokenKind.PubKeyword) {
      run ParseState.attach(&mut elements, run field(&mut state.*, NodeKind.UnionVariantField))
      let next = !Grammar.declarationStart(&state.*) && (ParseState.currentKind(&state.*) == TokenKind.Identifier || ParseState.currentKind(
        &state.*,
      ) == TokenKind.PubKeyword)
      if !(run ParseState.separator(&mut state.*, &mut elements, next)) {
        break
      }
    }
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightBrace)
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.UnionVariant)
}

effect fn sumDeclaration(state: &mut State, isUnion: bool, leading: List<Element>) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let mut keyword = TokenKind.EnumKeyword
  if isUnion {
    keyword = TokenKind.UnionKeyword
  }
  let mut elements = run nominalHeader(&mut state.*, keyword, move leading)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.LeftBrace)
  while ParseState.currentKind(&state.*) == TokenKind.Identifier {
    if isUnion {
      run ParseState.attach(&mut elements, run variant(&mut state.*))
    } else {
      run ParseState.attach(&mut elements, run enumMember(&mut state.*))
    }
    let another = ParseState.currentKind(&state.*) == TokenKind.Identifier
    if !(run ParseState.separator(&mut state.*, &mut elements, another)) {
      break
    }
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightBrace)
  if isUnion {
    return run ParseState.complete(&mut state.*, move elements, NodeKind.UnionDeclaration)
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.EnumDeclaration)
}

effect fn alias(state: &mut State, leading: List<Element>) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = run nominalHeader(&mut state.*, TokenKind.TypeKeyword, move leading)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Equals)
  run ParseState.attach(&mut elements, run Type.parse(&mut state.*))
  // An alias names one type or interface, so `type Both = A + B` is a bound list outside a generic
  // parameter list. Only the first `+` is reported; the rest of the tail stays in the tree.
  let mut reported = false
  while ParseState.currentKind(&state.*) == TokenKind.Plus {
    if reported {
      run ParseState.consume(&mut state.*, &mut elements)
    } else {
      run ParseState.unexpected(&mut state.*, &mut elements)
      reported = true
    }
    run ParseState.attach(&mut elements, run Type.parse(&mut state.*))
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.TypeAliasDeclaration)
}

effect fn constant(state: &mut State, parameter: bool, leading: List<Element>) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let mut keyword = TokenKind.ConstKeyword
  if parameter {
    keyword = TokenKind.ParamKeyword
  }
  let mut elements = move leading
  run ParseState.optional(&mut state.*, &mut elements, TokenKind.PubKeyword)
  run ParseState.expect(&mut state.*, &mut elements, keyword)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  // An unannotated constant parses whole; semantic analysis names the missing annotation once.
  if parameter || ParseState.currentKind(&state.*) != TokenKind.Equals {
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.Colon)
    run ParseState.attach(&mut elements, run Type.parse(&mut state.*))
  }
  if !parameter || ParseState.currentKind(&state.*) == TokenKind.Equals {
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.Equals)
    // An initializer may be a struct literal, as in `const ORIGIN: Point = Point {x: 0, y: 0}`.
    run ParseState.attach(&mut elements, run Expression.parse(&mut state.*, true))
  }
  if parameter && ParseState.word(&state.*, "where") {
    let mut validation = List<Element>.make()
    run ParseState.consume(&mut state.*, &mut validation)
    run ParseState.attach(&mut validation, run Expression.parse(&mut state.*, false))
    run ParseState.attach(
      &mut elements,
      run ParseState.complete(&mut state.*, move validation, NodeKind.PackageParameterValidation),
    )
  }
  if parameter {
    return run ParseState.complete(&mut state.*, move elements, NodeKind.PackageParameterDeclaration)
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.ConstantDeclaration)
}

effect fn functionPrefix(state: &mut State, operation: bool, leading: List<Element>) -> List<Element>
! OutOfMemoryError
? &mut Allocator {
  let mut elements = move leading
  run ParseState.optional(&mut state.*, &mut elements, TokenKind.PubKeyword)
  if !operation && ParseState.word(&state.*, "test") {
    run ParseState.consume(&mut state.*, &mut elements)
  }
  run ParseState.optional(&mut state.*, &mut elements, TokenKind.StaticKeyword)
  run ParseState.optional(&mut state.*, &mut elements, TokenKind.UnsafeKeyword)
  return move elements
}

effect fn functionName(state: &mut State, elements: &mut List<Element>, allowDrop: bool) -> ()
! OutOfMemoryError
? &mut Allocator {
  if ParseState.currentKind(&state.*) == TokenKind.EffectKeyword {
    run ParseState.consume(&mut state.*, &mut elements.*)
    if ParseState.currentKind(&state.*) == TokenKind.Less {
      run ParseState.attach(&mut elements.*, run Type.environment(&mut state.*, true))
    }
  }
  run ParseState.expect(&mut state.*, &mut elements.*, TokenKind.FnKeyword)
  if allowDrop && ParseState.currentKind(&state.*) == TokenKind.DropKeyword {
    run ParseState.consume(&mut state.*, &mut elements.*)
  } else {
    run ParseState.expect(&mut state.*, &mut elements.*, TokenKind.Identifier)
  }
  run Type.contract(&mut state.*, &mut elements.*)
  return ()
}

effect fn symbol(state: &mut State, elements: &mut List<Element>) -> ()
! OutOfMemoryError
? &mut Allocator {
  if ParseState.currentKind(&state.*) == TokenKind.AsKeyword {
    run ParseState.consume(&mut state.*, &mut elements.*)
    run ParseState.expect(&mut state.*, &mut elements.*, TokenKind.TextLiteral)
  }
  return ()
}

effect fn functionDeclaration(state: &mut State, operation: bool, allowDrop: bool, leading: List<Element>) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let mut elements = run functionPrefix(&mut state.*, operation, move leading)
  let marker = ParseState.currentKind(&state.*)
  let foreign = marker == TokenKind.ExternKeyword
  let exported = marker == TokenKind.ExportKeyword
  if foreign || exported {
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.TextLiteral)
  }
  run functionName(&mut state.*, &mut elements, allowDrop)
  if foreign || exported {
    run symbol(&mut state.*, &mut elements)
  }
  run Property.list(&mut state.*, &mut elements)
  if (!foreign && !operation) || ParseState.currentKind(&state.*) == TokenKind.LeftBrace {
    run ParseState.attach(&mut elements, run Statement.block(&mut state.*, !operation, false))
  }
  if operation {
    return run ParseState.complete(&mut state.*, move elements, NodeKind.ServiceOperation)
  }
  if foreign {
    return run ParseState.complete(&mut state.*, move elements, NodeKind.ForeignFunctionDeclaration)
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.FunctionDeclaration)
}

fn operationStart(state: &State) -> bool {
  let kind = ParseState.currentKind(state)
  return kind == TokenKind.At || kind == TokenKind.FnKeyword || kind == TokenKind.EffectKeyword || kind == TokenKind.UnsafeKeyword || kind == TokenKind.StaticKeyword
}

effect fn serviceDeclaration(state: &mut State, isInterface: bool, leading: List<Element>) -> NodeId
! OutOfMemoryError
? &mut Allocator {
  let mut keyword = TokenKind.ServiceKeyword
  if isInterface {
    keyword = TokenKind.InterfaceKeyword
  }
  let mut elements = run nominalHeader(&mut state.*, keyword, move leading)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.LeftBrace)
  while ParseState.currentKind(&state.*) != TokenKind.RightBrace && ParseState.currentKind(&state.*) != TokenKind.EndOfFile {
    if operationStart(&state.*) {
      let mut operationLeading = List<Element>.make()
      run Directive.list(&mut state.*, &mut operationLeading)
      run ParseState.attach(&mut elements, run functionDeclaration(&mut state.*, true, false, move operationLeading))
    } else {
      if Grammar.declarationStart(&state.*) {
        break
      }
      let mut invalid = List<Element>.make()
      run ParseState.unexpected(&mut state.*, &mut invalid)
      let error = run ParseState.complete(&mut state.*, move invalid, NodeKind.ServiceInvalidMember)
      run ParseState.attach(&mut elements, error)
    }
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightBrace)
  if isInterface {
    return run ParseState.complete(&mut state.*, move elements, NodeKind.InterfaceDeclaration)
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.ServiceDeclaration)
}

effect fn implOperation(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Colon)
  run ParseState.attach(&mut elements, run Type.path(&mut state.*))
  return run ParseState.complete(&mut state.*, move elements, NodeKind.ImplOperation)
}

effect fn implementation(state: &mut State, leading: List<Element>) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = move leading
  run ParseState.consume(&mut state.*, &mut elements)
  if ParseState.currentKind(&state.*) == TokenKind.Less {
    run ParseState.attach(&mut elements, run Type.parameters(&mut state.*, false))
  }
  run ParseState.attach(&mut elements, run Type.parse(&mut state.*))
  if ParseState.currentKind(&state.*) == TokenKind.ForKeyword {
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.attach(&mut elements, run Type.parse(&mut state.*))
  }
  if ParseState.word(&state.*, "where") {
    run ParseState.attach(&mut elements, run Type.whereClause(&mut state.*))
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.LeftBrace)
  while ParseState.currentKind(&state.*) == TokenKind.Identifier || ParseState.currentKind(&state.*) == TokenKind.PubKeyword || ParseState.currentKind(
    &state.*,
  ) == TokenKind.StaticKeyword || operationStart(&state.*) {
    if ParseState.currentKind(&state.*) == TokenKind.Identifier && !Grammar.testFunctionStart(
      &state.*,
      usize.ZERO,
    ) {
      run ParseState.attach(&mut elements, run implOperation(&mut state.*))
    } else {
      let before = state.index
      let mut memberLeading = List<Element>.make()
      run Directive.list(&mut state.*, &mut memberLeading)
      run ParseState.attach(&mut elements, run functionDeclaration(&mut state.*, false, true, move memberLeading))
      if state.index == before {
        break
      }
    }
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightBrace)
  return run ParseState.complete(&mut state.*, move elements, NodeKind.ImplDeclaration)
}

effect fn foreignStatic(state: &mut State, leading: List<Element>) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let imported = ParseState.currentKind(&state.*) == TokenKind.UnsafeKeyword
  let mut elements = move leading
  run ParseState.optional(&mut state.*, &mut elements, TokenKind.UnsafeKeyword)
  if imported {
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.ExternKeyword)
  } else {
    run ParseState.expect(&mut state.*, &mut elements, TokenKind.ExportKeyword)
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.TextLiteral)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.StaticKeyword)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Identifier)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Colon)
  run ParseState.attach(&mut elements, run Type.parse(&mut state.*))
  run symbol(&mut state.*, &mut elements)
  if imported {
    run Property.list(&mut state.*, &mut elements)
    return run ParseState.complete(&mut state.*, move elements, NodeKind.ForeignStaticDeclaration)
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.Equals)
  run ParseState.attach(&mut elements, run Expression.parse(&mut state.*, false))
  return run ParseState.complete(&mut state.*, move elements, NodeKind.ExportStaticDeclaration)
}

effect fn group(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let opened = ParseState.currentKind(&state.*) == TokenKind.LeftBrace
  let mut elements = List<Element>.make()
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.LeftBrace)
  if opened {
    while ParseState.currentKind(&state.*) != TokenKind.RightBrace && ParseState.currentKind(
      &state.*,
    ) != TokenKind.ElseKeyword && ParseState.currentKind(&state.*) != TokenKind.EndOfFile {
      let before = state.index
      run ParseState.attach(&mut elements, run parse(&mut state.*))
      if state.index == before {
        run ParseState.unexpected(&mut state.*, &mut elements)
      }
    }
  }
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.RightBrace)
  return run ParseState.complete(&mut state.*, move elements, NodeKind.DeclarationGroup)
}

effect fn staticConditional(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  if !ParseState.affordable(&state.*, ParseState.BLOCK_COST) {
    return run ParseState.nestingError(&mut state.*)
  }
  let cost = state.stackCost
  state.stackCost = usize.add(cost, ParseState.BLOCK_COST)
  let node = run staticConditionalInner(&mut state.*)
  state.stackCost = cost
  return node
}

effect fn staticConditionalInner(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut elements = List<Element>.make()
  run ParseState.consume(&mut state.*, &mut elements)
  run ParseState.expect(&mut state.*, &mut elements, TokenKind.IfKeyword)
  run ParseState.attach(&mut elements, run Expression.parse(&mut state.*, false))
  run ParseState.attach(&mut elements, run group(&mut state.*))
  if ParseState.currentKind(&state.*) == TokenKind.ElseKeyword {
    run ParseState.consume(&mut state.*, &mut elements)
    if ParseState.currentKind(&state.*) == TokenKind.StaticKeyword {
      run ParseState.attach(&mut elements, run staticConditional(&mut state.*))
    } else {
      run ParseState.attach(&mut elements, run group(&mut state.*))
    }
  }
  return run ParseState.complete(&mut state.*, move elements, NodeKind.StaticConditionalDeclaration)
}

/// Parses a declaration selected from its significant-token prefix, preserving damaged regions.
///
/// Public fields are not declaration starts. Foreign static headers are recognized before
/// ordinary function headers, and static conditionals own nested declaration groups.
pub effect fn parse(state: &mut State) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut leading = List<Element>.make()
  run Directive.list(&mut state.*, &mut leading)
  let kind = ParseState.currentKind(&state.*)
  let mut head = kind
  let mut offset: usize = 0
  if kind == TokenKind.PubKeyword {
    head = ParseState.peek(&state.*, 1)
    offset = 1
  }
  let conditional = kind == TokenKind.StaticKeyword && ParseState.peek(&state.*, 1) == TokenKind.IfKeyword
  if List<Element>.length(&leading) > usize.ZERO && (conditional || head == TokenKind.ImportKeyword) {
    // An import or a static conditional is no declaration a directive can describe.
    return run Directive.misplaced(&mut state.*, move leading)
  }
  if conditional {
    drop leading
    return run staticConditional(&mut state.*)
  }
  if (kind == TokenKind.UnsafeKeyword && ParseState.peek(&state.*, 1) == TokenKind.ExternKeyword && ParseState.peek(
    &state.*,
    3,
  ) == TokenKind.StaticKeyword) || (kind == TokenKind.ExportKeyword && ParseState.peek(&state.*, 2) == TokenKind.StaticKeyword) {
    return run foreignStatic(&mut state.*, move leading)
  }
  if head == TokenKind.ImportKeyword {
    drop leading
    return run parseImportDeclaration(&mut state.*)
  }
  if head == TokenKind.ConstKeyword {
    return run constant(&mut state.*, false, move leading)
  }
  if head == TokenKind.ParamKeyword {
    return run constant(&mut state.*, true, move leading)
  }
  if head == TokenKind.StructKeyword || (head == TokenKind.ExternKeyword && ((offset == 0 && ParseState.peek(
    &state.*,
    2,
  ) == TokenKind.StructKeyword) || (offset == 1 && ParseState.peek(&state.*, 3) == TokenKind.StructKeyword))) {
    return run structDeclaration(&mut state.*, move leading)
  }
  if head == TokenKind.TupleKeyword {
    return run tupleDeclaration(&mut state.*, move leading)
  }
  if head == TokenKind.EnumKeyword {
    return run sumDeclaration(&mut state.*, false, move leading)
  }
  if head == TokenKind.UnionKeyword {
    return run sumDeclaration(&mut state.*, true, move leading)
  }
  if head == TokenKind.TypeKeyword {
    return run alias(&mut state.*, move leading)
  }
  if head == TokenKind.ServiceKeyword {
    return run serviceDeclaration(&mut state.*, false, move leading)
  }
  if head == TokenKind.InterfaceKeyword {
    return run serviceDeclaration(&mut state.*, true, move leading)
  }
  if head == TokenKind.RoleKeyword {
    let header = run nominalHeader(&mut state.*, TokenKind.RoleKeyword, move leading)
    return run ParseState.complete(&mut state.*, move header, NodeKind.RoleDeclaration)
  }
  if head == TokenKind.ImplKeyword {
    return run implementation(&mut state.*, move leading)
  }
  if ParseState.word(&state.*, "module") {
    let mut elements = move leading
    run ParseState.consume(&mut state.*, &mut elements)
    run ParseState.attach(&mut elements, run Property.clause(&mut state.*))
    return run ParseState.complete(&mut state.*, move elements, NodeKind.ModulePropertyDeclaration)
  }
  if Grammar.testFunctionStart(&state.*, offset) || head == TokenKind.FnKeyword || head == TokenKind.EffectKeyword || head == TokenKind.UnsafeKeyword || head == TokenKind.ExternKeyword || head == TokenKind.ExportKeyword || head == TokenKind.StaticKeyword {
    return run functionDeclaration(&mut state.*, false, false, move leading)
  }
  if List<Element>.length(&leading) > usize.ZERO {
    return run Directive.misplaced(&mut state.*, move leading)
  }
  drop leading
  let mut invalid = List<Element>.make()
  run recover(&mut state.*, &mut invalid)
  return run ParseState.complete(&mut state.*, move invalid, NodeKind.Error)
}

// Reports the current token as unexpected, unless a missing token already reported this
// position, then skips to the next declaration that starts a line outside any brackets, so one
// damaged region reports one diagnostic.
effect fn recover(state: &mut State, elements: &mut List<Element>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut depth = nesting(ParseState.currentKind(&state.*), usize.ZERO)
  if ParseState.reportedHere(&state.*) {
    run ParseState.consume(&mut state.*, &mut elements.*)
  } else {
    run ParseState.unexpected(&mut state.*, &mut elements.*)
  }
  while true {
    let kind = ParseState.currentKind(&state.*)
    if kind == TokenKind.EndOfFile {
      break
    }
    if depth == usize.ZERO && ParseState.lineBreakBefore(&state.*) && (Grammar.declarationStart(&state.*) || ParseState.word(&state.*, "module")) {
      break
    }
    depth = nesting(kind, depth)
    run ParseState.consume(&mut state.*, &mut elements.*)
  }
  return ()
}

// The bracket depth after `kind`; a closing bracket at depth zero closes nothing.
fn nesting(kind: TokenKind, depth: usize) -> usize {
  if kind == TokenKind.LeftBrace || kind == TokenKind.LeftParenthesis || kind == TokenKind.LeftBracket {
    return depth + usize.ONE
  }
  if (kind == TokenKind.RightBrace || kind == TokenKind.RightParenthesis || kind == TokenKind.RightBracket) && depth > usize.ZERO {
    return depth - usize.ONE
  }
  return depth
}
