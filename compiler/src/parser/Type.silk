//! Type grammar: named and applied types, lifetimes, callable contracts, rows, and constraints.
//!
//! Rules consume ownership-threaded state and append completed children before their parent.
//! Type parsing stops before declaration bodies and list delimiters. Missing syntax becomes
//! missing-token elements; enclosing list loops retain responsibility for forward progress.
import lexer.Token {TokenKind}
import parser.Node {NodeKind}
import parser.ParseState {State, ElementsResult, NodeResult}
import parser.ParseState
import parser.Grammar
import parser.Property
import parser.Expression
import silk.allocator {Allocator, OutOfMemoryError}
import silk.usize

/// Parses a one- or two-segment nominal type path, without its generic arguments.
pub effect fn path(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let path = run move initial
    |> ParseState.begin
    |> pathElements
  return run move path
    |> ParseState.complete(NodeKind.TypePath)
}

effect fn pathElements(initial: ElementsResult) -> ElementsResult
! OutOfMemoryError
? &mut Allocator {
  let mut p = run move initial
    |> ParseState.expect(TokenKind.Identifier)
  if ParseState.currentKind(&p.state) == TokenKind.Dot {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    let afterIdentifier = run move p
      |> ParseState.expect(TokenKind.Identifier)
    p = move afterIdentifier
  }
  return move p
}

effect fn lifetime(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let lifetime = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.Lifetime)
  return run move lifetime
    |> ParseState.complete(NodeKind.LifetimeType)
}

/// Parses a named type and its optional type arguments.
pub effect fn named(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let result = run path(move initial)
  if ParseState.currentKind(&result.state) != TokenKind.Less {
    return move result
  }
  let mut p = run move result
    |> ParseState.wrap
  let attached = run ParseState.attach(move p.elements, run arguments(move p.state, false))
  p = move attached
  return run move p
    |> ParseState.complete(NodeKind.AppliedType)
}

fn nullablePointer(state: &State) -> bool {
  return ParseState.currentKind(state) == TokenKind.Question && (ParseState.peek(state, 1) == TokenKind.Star || (ParseState.peek(
    state,
    1,
  ) == TokenKind.LeftBracket && ParseState.peek(state, 2) == TokenKind.Star))
}

fn hasEffectEnvironment(state: &State) -> bool {
  if ParseState.currentKind(state) == TokenKind.Semicolon {
    return true
  }
  let mut offset: usize = 0
  if ParseState.peek(state, offset) != TokenKind.Lifetime {
    return false
  }
  offset = usize.add(offset, usize.ONE)
  while ParseState.peek(state, offset) == TokenKind.Ampersand && ParseState.peek(
    state,
    usize.add(offset, usize.ONE),
  ) == TokenKind.Lifetime {
    offset = usize.add(offset, 2)
  }
  return ParseState.peek(state, offset) == TokenKind.Semicolon
}

/// Parses `<...>` arguments for a type or a call, retaining lifetime and row slots.
///
/// `call` selects call-owned arguments, including role selectors. Type-owned arguments additionally
/// admit an environment before `;` and failure/requirement rows before the closing angle.
pub effect fn arguments(initial: State, call: bool) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.Less)
  if !call && hasEffectEnvironment(&p.state) {
    let mut environment = run move p.state
      |> ParseState.begin
      |> ParseState.expect(TokenKind.Lifetime)
    while ParseState.currentKind(&environment.state) == TokenKind.Ampersand {
      let afterAmpersand = run move environment
        |> ParseState.consume
      environment = move afterAmpersand
      let afterMember = run move environment
        |> ParseState.expect(TokenKind.Lifetime)
      environment = move afterMember
    }
    let afterSemicolon = run move environment
      |> ParseState.expect(TokenKind.Semicolon)
    environment = move afterSemicolon
    let attached = run ParseState.attach(
      move p.elements,
      run ParseState.complete(move environment, NodeKind.EffectEnvironment),
    )
    p = move attached
  }
  if ParseState.currentKind(&p.state) == TokenKind.Greater {
    let afterIdentifier = run move p
      |> ParseState.missing(TokenKind.Identifier)
    p = move afterIdentifier
  }
  while ParseState.currentKind(&p.state) != TokenKind.Greater && ParseState.currentKind(&p.state) != TokenKind.EndOfFile {
    let kind = ParseState.currentKind(&p.state)
    if kind == TokenKind.Bang || (kind == TokenKind.Question && !nullablePointer(&p.state)) {
      break
    }
    if kind != TokenKind.Lifetime && !Grammar.typeStart(kind) {
      break
    }
    let before = p.state.index
    let mut argument = ParseState.begin(move p.state)
    if kind == TokenKind.Lifetime {
      let attached2 = run ParseState.attach(
        move argument.elements,
        run lifetime(move argument.state),
      )
      argument = move attached2
    } else {
      let attached3 = run ParseState.attach(move argument.elements, run parse(move argument.state))
      argument = move attached3
    }
    if call && ParseState.word(&argument.state, "at") {
      let consumed = run move argument
        |> ParseState.consume
      argument = move consumed
      let attached4 = run ParseState.attach(move argument.elements, run path(move argument.state))
      argument = move attached4
      let attached5 = run ParseState.attach(
        move p.elements,
        run ParseState.complete(move argument, NodeKind.RequirementSelector),
      )
      p = move attached5
    } else {
      // A normal argument is already complete: splice the one child without an extra wrapper.
      let advanced = run ParseState.extend(move p.elements, move argument)
      p = move advanced
    }
    if p.state.index == before {
      break
    }
    if ParseState.currentKind(&p.state) != TokenKind.Comma {
      break
    }
    let consumed2 = run move p
      |> ParseState.consume
    p = move consumed2
  }
  if !call && ParseState.currentKind(&p.state) == TokenKind.Bang {
    let attached6 = run ParseState.attach(move p.elements, run failureRow(move p.state))
    p = move attached6
  }
  if !call && ParseState.currentKind(&p.state) == TokenKind.Question {
    let attached7 = run ParseState.attach(move p.elements, run requirementRow(move p.state))
    p = move attached7
  }
  let afterGreater = run move p
    |> ParseState.expect(TokenKind.Greater)
  p = move afterGreater
  if call {
    return run move p
      |> ParseState.complete(NodeKind.CallTypeArgumentList)
  }
  return run move p
    |> ParseState.complete(NodeKind.TypeArgumentList)
}

// `use` is contextual only in a callable's outer `for` list, never in a declaration generic list.
effect fn typeParameter(initial: State, binders: bool) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let invocationUse = binders && ParseState.word(&initial, "use")
  let isLifetime = invocationUse || ParseState.currentKind(&initial) == TokenKind.Lifetime
  let isRow = !invocationUse && ParseState.currentKind(&initial) == TokenKind.Question
  let mut p = ParseState.begin(move initial)
  if invocationUse {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
  } else {
    let afterQuestion = run move p
      |> ParseState.optional(TokenKind.Question)
    p = move afterQuestion
  }
  if isLifetime {
    let afterLifetime = run move p
      |> ParseState.expect(TokenKind.Lifetime)
    p = move afterLifetime
  } else {
    let afterIdentifier = run move p
      |> ParseState.expect(TokenKind.Identifier)
    p = move afterIdentifier
  }
  if !isRow && ParseState.currentKind(&p.state) == TokenKind.Colon {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    while true {
      if ParseState.currentKind(&p.state) == TokenKind.Lifetime {
        let attached = run ParseState.attach(move p.elements, run lifetime(move p.state))
        p = move attached
      } else {
        let attached2 = run ParseState.attach(move p.elements, run parse(move p.state))
        p = move attached2
      }
      if ParseState.currentKind(&p.state) != TokenKind.Plus {
        break
      }
      let consumed2 = run move p
        |> ParseState.consume
      p = move consumed2
    }
  }
  if isLifetime {
    return run move p
      |> ParseState.complete(NodeKind.LifetimeParameter)
  }
  return run move p
    |> ParseState.complete(NodeKind.TypeParameter)
}

/// Parses declaration binders or a higher-ranked callable lifetime binder list.
pub effect fn parameters(initial: State, binders: bool) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.Less)
  if ParseState.currentKind(&p.state) == TokenKind.Greater {
    let afterIdentifier = run move p
      |> ParseState.missing(TokenKind.Identifier)
    p = move afterIdentifier
  }
  while ParseState.currentKind(&p.state) == TokenKind.Identifier || ParseState.currentKind(&p.state) == TokenKind.Lifetime || ParseState.currentKind(
    &p.state,
  ) == TokenKind.Question {
    let attached = run ParseState.attach(move p.elements, run typeParameter(move p.state, binders))
    p = move attached
    if ParseState.currentKind(&p.state) != TokenKind.Comma {
      break
    }
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
  }
  let afterGreater = run move p
    |> ParseState.expect(TokenKind.Greater)
  p = move afterGreater
  if binders {
    return run move p
      |> ParseState.complete(NodeKind.LifetimeBinderList)
  }
  return run move p
    |> ParseState.complete(NodeKind.TypeParameterList)
}

/// Parses the explicit lifetime environment after `fn` or `effect`.
pub effect fn environment(initial: State, effectEnvironment: bool) -> NodeResult
! OutOfMemoryError
? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.Less)
  let afterLifetime = run move p
    |> ParseState.expect(TokenKind.Lifetime)
  p = move afterLifetime
  while effectEnvironment && ParseState.currentKind(&p.state) == TokenKind.Ampersand {
    let afterAmpersand = run move p
      |> ParseState.consume
    p = move afterAmpersand
    let afterMember = run move p
      |> ParseState.expect(TokenKind.Lifetime)
    p = move afterMember
  }
  let afterGreater = run move p
    |> ParseState.expect(TokenKind.Greater)
  p = move afterGreater
  if effectEnvironment {
    return run move p
      |> ParseState.complete(NodeKind.EffectEnvironment)
  }
  return run move p
    |> ParseState.complete(NodeKind.CallableEnvironment)
}

effect fn callable(initial: ElementsResult) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let foreign = ParseState.currentKind(&initial.state) == TokenKind.ExternKeyword
  let mut p = move initial
  if foreign {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    let afterTextLiteral = run move p
      |> ParseState.expect(TokenKind.TextLiteral)
    p = move afterTextLiteral
  }
  let afterUnsafeKeyword = run move p
    |> ParseState.optional(TokenKind.UnsafeKeyword)
  p = move afterUnsafeKeyword
  let afterMutKeyword = run move p
    |> ParseState.optional(TokenKind.MutKeyword)
  p = move afterMutKeyword
  let afterOnceKeyword = run move p
    |> ParseState.optional(TokenKind.OnceKeyword)
  p = move afterOnceKeyword
  let afterFnKeyword = run move p
    |> ParseState.expect(TokenKind.FnKeyword)
  p = move afterFnKeyword
  if ParseState.currentKind(&p.state) == TokenKind.Less {
    let attached = run ParseState.attach(move p.elements, run environment(move p.state, false))
    p = move attached
  }
  let afterLeftParenthesis = run move p
    |> ParseState.expect(TokenKind.LeftParenthesis)
  p = move afterLeftParenthesis
  while Grammar.typeStart(ParseState.currentKind(&p.state)) {
    let before = p.state.index
    let attached2 = run ParseState.attach(move p.elements, run parse(move p.state))
    p = move attached2
    if p.state.index == before || ParseState.currentKind(&p.state) != TokenKind.Comma {
      break
    }
    let consumed2 = run move p
      |> ParseState.consume
    p = move consumed2
  }
  let afterRightParenthesis = run move p
    |> ParseState.expect(TokenKind.RightParenthesis)
  p = move afterRightParenthesis
  let afterArrow = run move p
    |> ParseState.expect(TokenKind.Arrow)
  p = move afterArrow
  let attached3 = run ParseState.attach(move p.elements, run parse(move p.state))
  p = move attached3
  if foreign {
    let advanced = run Property.list(move p)
    p = move advanced
    return run move p
      |> ParseState.complete(NodeKind.ForeignFunctionType)
  }
  return run move p
    |> ParseState.complete(NodeKind.CallableType)
}

effect fn pointer(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.optional(TokenKind.Question)
  let many = ParseState.currentKind(&p.state) == TokenKind.LeftBracket
  if many {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
  }
  let afterStar = run move p
    |> ParseState.expect(TokenKind.Star)
  p = move afterStar
  if many {
    let afterRightBracket = run move p
      |> ParseState.expect(TokenKind.RightBracket)
    p = move afterRightBracket
  }
  if ParseState.currentKind(&p.state) == TokenKind.MutKeyword {
    let consumed2 = run move p
      |> ParseState.consume
    p = move consumed2
  } else {
    let afterConstKeyword = run move p
      |> ParseState.expect(TokenKind.ConstKeyword)
    p = move afterConstKeyword
  }
  while (ParseState.word(&p.state, "align") || ParseState.word(&p.state, "addrspace")) && ParseState.peek(
    &p.state,
    1,
  ) == TokenKind.LeftParenthesis {
    let mut q = run move p.state
      |> ParseState.begin
      |> ParseState.consume
    let afterLeftParenthesis = run move q
      |> ParseState.expect(TokenKind.LeftParenthesis)
    q = move afterLeftParenthesis
    let afterDecimalInteger = run move q
      |> ParseState.expect(TokenKind.DecimalInteger)
    q = move afterDecimalInteger
    let afterRightParenthesis = run move q
      |> ParseState.expect(TokenKind.RightParenthesis)
    q = move afterRightParenthesis
    let withPComplete = run ParseState.attach(
      move p.elements,
      run ParseState.complete(move q, NodeKind.PointerQualifier),
    )
    p = move withPComplete
  }
  let attached = run ParseState.attach(move p.elements, run primary(move p.state))
  p = move attached
  return run move p
    |> ParseState.complete(NodeKind.PointerType)
}

effect fn reference(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.consume
  let afterLifetime = run move p
    |> ParseState.optional(TokenKind.Lifetime)
  p = move afterLifetime
  let afterMutKeyword = run move p
    |> ParseState.optional(TokenKind.MutKeyword)
  p = move afterMutKeyword
  if ParseState.currentKind(&p.state) == TokenKind.LeftBracket {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    let attached = run ParseState.attach(move p.elements, run parse(move p.state))
    p = move attached
    let afterRightBracket = run move p
      |> ParseState.expect(TokenKind.RightBracket)
    p = move afterRightBracket
    return run move p
      |> ParseState.complete(NodeKind.SliceType)
  }
  let attached2 = run ParseState.attach(move p.elements, run primary(move p.state))
  p = move attached2
  if ParseState.currentKind(&p.state) == TokenKind.At {
    let consumed2 = run move p
      |> ParseState.consume
    p = move consumed2
    let afterIdentifier = run move p
      |> ParseState.expect(TokenKind.Identifier)
    p = move afterIdentifier
  }
  return run move p
    |> ParseState.complete(NodeKind.ReferenceType)
}

effect fn bracketed(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.consume
  let attached = run ParseState.attach(move p.elements, run parse(move p.state))
  p = move attached
  let afterSemicolon = run move p
    |> ParseState.expect(TokenKind.Semicolon)
  p = move afterSemicolon
  let attachedLength = run ParseState.attach(move p.elements, run Expression.parse(move p.state, false))
  p = move attachedLength
  let afterRightBracket = run move p
    |> ParseState.expect(TokenKind.RightBracket)
  p = move afterRightBracket
  return run move p
    |> ParseState.complete(NodeKind.FixedArrayType)
}

effect fn parenthesized(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.consume
  let unit = ParseState.currentKind(&p.state) == TokenKind.RightParenthesis
  if !unit {
    let attached = run ParseState.attach(move p.elements, run parse(move p.state))
    p = move attached
  }
  let afterRightParenthesis = run move p
    |> ParseState.expect(TokenKind.RightParenthesis)
  p = move afterRightParenthesis
  if unit {
    return run move p
      |> ParseState.complete(NodeKind.UnitType)
  }
  return run move p
    |> ParseState.complete(NodeKind.ParenthesizedType)
}

effect fn rowOperandMember(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  if ParseState.currentKind(&initial) == TokenKind.Ampersand {
    return run requirement(move initial)
  }
  let result = run primary(move initial)
  if !ParseState.word(&result.state, "at") {
    return move result
  }
  let mut p = run ParseState.consume(run ParseState.wrap(move result))
  let attached = run ParseState.attach(move p.elements, run path(move p.state))
  p = move attached
  return run move p
    |> ParseState.complete(NodeKind.Requirement)
}

effect fn rowOperand(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let first = run rowOperandMember(move initial)
  if ParseState.currentKind(&first.state) != TokenKind.Pipe {
    return move first
  }
  let mut p = run move first
    |> ParseState.wrap
  while ParseState.currentKind(&p.state) == TokenKind.Pipe {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    let attached = run ParseState.attach(move p.elements, run rowOperandMember(move p.state))
    p = move attached
  }
  return run move p
    |> ParseState.complete(NodeKind.UnionType)
}

effect fn without(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.consume
  let afterLess = run move p
    |> ParseState.expect(TokenKind.Less)
  p = move afterLess
  let attached = run ParseState.attach(move p.elements, run rowOperand(move p.state))
  p = move attached
  let afterComma = run move p
    |> ParseState.expect(TokenKind.Comma)
  p = move afterComma
  let attached2 = run ParseState.attach(move p.elements, run rowOperand(move p.state))
  p = move attached2
  let afterGreater = run move p
    |> ParseState.expect(TokenKind.Greater)
  p = move afterGreater
  return run move p
    |> ParseState.complete(NodeKind.RowWithout)
}

// An applied type owns its mode token; a bare path owns that token directly. Delay completing
// the path until the following token selects the shape, so neither case leaves an orphan node.
effect fn modeQualified(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.consume
  let subject = run pathElements(ParseState.begin(move p.state))
  if ParseState.currentKind(&subject.state) != TokenKind.Less {
    let combined = run ParseState.extend(move p.elements, move subject)
    return run move combined
      |> ParseState.complete(NodeKind.TypePath)
  }
  let attached = run ParseState.attach(
    move p.elements,
    run ParseState.complete(move subject, NodeKind.TypePath),
  )
  p = move attached
  let withArguments = run ParseState.attach(move p.elements, run arguments(move p.state, false))
  return run move withArguments
    |> ParseState.complete(NodeKind.AppliedType)
}

/// Parses a type without a following union separator.
///
/// References and pointers bind to one primary. Parentheses explicitly admit a union subject.
pub effect fn primary(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  if initial.depth >= ParseState.NESTING_LIMIT {
    return run move initial
      |> ParseState.nestingError
  }
  let depth = initial.depth
  let mut state = move initial
  state.depth = usize.add(depth, 1)
  let mut result = run primaryInner(move state)
  result.state.depth = depth
  return move result
}

effect fn primaryInner(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let kind = ParseState.currentKind(&initial)
  if kind == TokenKind.ForKeyword {
    let mut p = run move initial
      |> ParseState.begin
      |> ParseState.consume
    let attached = run ParseState.attach(move p.elements, run parameters(move p.state, true))
    p = move attached
    return run callable(move p)
  }
  if ParseState.word(&initial, "Without") && ParseState.peek(&initial, 1) == TokenKind.Less {
    return run without(move initial)
  }
  if ParseState.word(&initial, "typeof") && ParseState.peek(&initial, 1) == TokenKind.LeftParenthesis {
    let mut p = run move initial
      |> ParseState.begin
      |> ParseState.consume
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    let attached2 = run ParseState.attach(move p.elements, run named(move p.state))
    p = move attached2
    let afterRightParenthesis = run move p
      |> ParseState.expect(TokenKind.RightParenthesis)
    p = move afterRightParenthesis
    return run move p
      |> ParseState.complete(NodeKind.ExactRepresentationType)
  }
  if (kind == TokenKind.MutKeyword || kind == TokenKind.OnceKeyword) && ParseState.peek(&initial, 1) == TokenKind.Identifier {
    return run modeQualified(move initial)
  }
  if kind == TokenKind.ExternKeyword || kind == TokenKind.UnsafeKeyword || kind == TokenKind.FnKeyword || kind == TokenKind.MutKeyword || kind == TokenKind.OnceKeyword {
    return run callable(ParseState.begin(move initial))
  }
  if kind == TokenKind.Star || nullablePointer(&initial) || (kind == TokenKind.LeftBracket && ParseState.peek(
    &initial,
    1,
  ) == TokenKind.Star) {
    return run pointer(move initial)
  }
  if kind == TokenKind.Ampersand {
    return run reference(move initial)
  }
  if kind == TokenKind.LeftBracket {
    return run bracketed(move initial)
  }
  if kind == TokenKind.LeftParenthesis {
    return run parenthesized(move initial)
  }
  return run named(move initial)
}

/// Parses a union of primary types, returning the sole member directly when there is no `|`.
pub effect fn parse(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let first = run primary(move initial)
  if ParseState.currentKind(&first.state) != TokenKind.Pipe {
    return move first
  }
  let mut p = run move first
    |> ParseState.wrap
  while ParseState.currentKind(&p.state) == TokenKind.Pipe {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    let attached = run ParseState.attach(move p.elements, run primary(move p.state))
    p = move attached
  }
  return run move p
    |> ParseState.complete(NodeKind.UnionType)
}

/// Parses an arrow and result type, including a contextual opaque result binder.
pub effect fn result(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.Arrow)
  if ParseState.word(&p.state, "some") && ParseState.peek(&p.state, 1) == TokenKind.Less {
    let mut opaque = run move p.state
      |> ParseState.begin
      |> ParseState.consume
    let attached = run ParseState.attach(
      move opaque.elements,
      run parameters(move opaque.state, false),
    )
    opaque = move attached
    let attached2 = run ParseState.attach(move opaque.elements, run parse(move opaque.state))
    opaque = move attached2
    let attached3 = run ParseState.attach(
      move p.elements,
      run ParseState.complete(move opaque, NodeKind.OpaqueResultType),
    )
    p = move attached3
  } else {
    let attached4 = run ParseState.attach(move p.elements, run parse(move p.state))
    p = move attached4
  }
  return run move p
    |> ParseState.complete(NodeKind.ReturnType)
}

/// Parses `!` followed by the failure union; semantic row validation happens later.
pub effect fn failureRow(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.Bang)
  let attached = run ParseState.attach(move p.elements, run parse(move p.state))
  p = move attached
  return run move p
    |> ParseState.complete(NodeKind.FailureRow)
}

effect fn requirement(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.Ampersand)
  let afterMutKeyword = run move p
    |> ParseState.optional(TokenKind.MutKeyword)
  p = move afterMutKeyword
  let attached = run ParseState.attach(move p.elements, run primary(move p.state))
  p = move attached
  if ParseState.word(&p.state, "at") {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
    let attached2 = run ParseState.attach(move p.elements, run path(move p.state))
    p = move attached2
  }
  return run move p
    |> ParseState.complete(NodeKind.Requirement)
}

/// Parses a requirement row containing borrowed services, row names, or `Without` expressions.
pub effect fn requirementRow(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.Question)
  while true {
    if ParseState.currentKind(&p.state) == TokenKind.Ampersand {
      let attached = run ParseState.attach(move p.elements, run requirement(move p.state))
      p = move attached
    } else if ParseState.word(&p.state, "Without") && ParseState.peek(&p.state, 1) == TokenKind.Less {
      let withSubtraction = run ParseState.attach(move p.elements, run parse(move p.state))
      p = move withSubtraction
    } else {
      let attached2 = run ParseState.attach(move p.elements, run primary(move p.state))
      p = move attached2
    }
    if ParseState.currentKind(&p.state) != TokenKind.Pipe {
      break
    }
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
  }
  return run move p
    |> ParseState.complete(NodeKind.RequirementRow)
}

effect fn constraint(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run ParseState.wrap(run parse(move initial))
  let membership = ParseState.word(&p.state, "in")
  if membership {
    let advanced = run move p
      |> ParseState.contextual("in")
    p = move advanced
  } else {
    let advanced2 = run move p
      |> ParseState.contextual("provides")
    p = move advanced2
  }
  let attached = run ParseState.attach(move p.elements, run parse(move p.state))
  p = move attached
  if membership {
    return run move p
      |> ParseState.complete(NodeKind.MembershipConstraint)
  }
  let advanced3 = run move p
    |> ParseState.contextual("from")
  p = move advanced3
  let attached2 = run ParseState.attach(move p.elements, run parse(move p.state))
  p = move attached2
  return run move p
    |> ParseState.complete(NodeKind.ProviderConstraint)
}

/// Parses a contextual `where` clause with comma-separated membership/provider constraints.
pub effect fn whereClause(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.Identifier)
  while true {
    let attached = run ParseState.attach(move p.elements, run constraint(move p.state))
    p = move attached
    if ParseState.currentKind(&p.state) != TokenKind.Comma {
      break
    }
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
  }
  return run move p
    |> ParseState.complete(NodeKind.WhereClause)
}

effect fn parameter(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = ParseState.begin(move initial)
  if ParseState.currentKind(&p.state) == TokenKind.StaticKeyword || ParseState.currentKind(&p.state) == TokenKind.MutKeyword {
    let consumed = run move p
      |> ParseState.consume
    p = move consumed
  }
  let afterIdentifier = run move p
    |> ParseState.expect(TokenKind.Identifier)
  p = move afterIdentifier
  let afterColon = run move p
    |> ParseState.expect(TokenKind.Colon)
  p = move afterColon
  let attached = run ParseState.attach(move p.elements, run parse(move p.state))
  p = move attached
  return run move p
    |> ParseState.complete(NodeKind.ParameterDeclaration)
}

/// Parses named callable parameters and the optional trailing C-variadic marker.
pub effect fn parameterList(initial: State) -> NodeResult ! OutOfMemoryError ? &mut Allocator {
  let mut p = run move initial
    |> ParseState.begin
    |> ParseState.expect(TokenKind.LeftParenthesis)
  while ParseState.currentKind(&p.state) == TokenKind.Identifier || ParseState.currentKind(&p.state) == TokenKind.StaticKeyword || ParseState.currentKind(
    &p.state,
  ) == TokenKind.MutKeyword || ParseState.currentKind(&p.state) == TokenKind.Ellipsis {
    if ParseState.currentKind(&p.state) == TokenKind.Ellipsis {
      let consumed = run move p
        |> ParseState.consume
      p = move consumed
      break
    }
    if ParseState.currentKind(&p.state) == TokenKind.StaticKeyword && ParseState.peek(&p.state, 1) == TokenKind.FnKeyword {
      break
    }
    let attached = run ParseState.attach(move p.elements, run parameter(move p.state))
    p = move attached
    if ParseState.currentKind(&p.state) == TokenKind.RightParenthesis {
      break
    }
    let afterComma = run move p
      |> ParseState.expect(TokenKind.Comma)
    p = move afterComma
  }
  let afterRightParenthesis = run move p
    |> ParseState.expect(TokenKind.RightParenthesis)
  p = move afterRightParenthesis
  return run move p
    |> ParseState.complete(NodeKind.ParameterList)
}

/// Appends the shared generic/parameter/result/row/constraint suffix of a callable declaration.
pub effect fn contract(initial: ElementsResult) -> ElementsResult
! OutOfMemoryError
? &mut Allocator {
  let mut p = move initial
  if ParseState.currentKind(&p.state) == TokenKind.Less {
    let attached = run ParseState.attach(move p.elements, run parameters(move p.state, false))
    p = move attached
  }
  let attached2 = run ParseState.attach(move p.elements, run parameterList(move p.state))
  p = move attached2
  if ParseState.currentKind(&p.state) == TokenKind.Arrow {
    let attached3 = run ParseState.attach(move p.elements, run result(move p.state))
    p = move attached3
  }
  if ParseState.currentKind(&p.state) == TokenKind.Bang {
    let attached4 = run ParseState.attach(move p.elements, run failureRow(move p.state))
    p = move attached4
  }
  if ParseState.currentKind(&p.state) == TokenKind.Question {
    let attached5 = run ParseState.attach(move p.elements, run requirementRow(move p.state))
    p = move attached5
  }
  if ParseState.word(&p.state, "where") {
    let attached6 = run ParseState.attach(move p.elements, run whereClause(move p.state))
    p = move attached6
  }
  return move p
}
