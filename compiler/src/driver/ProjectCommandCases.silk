//! Project command lines separate the compiler's options from the program's arguments.

import driver.ProjectCommand as ProjectCommands { Build, Clean, Init, InvalidProjectCommand, Run }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.option { Option }
import silk.result { Result }
import silk.testing { AssertionError, Testing }
import silk.usize
import silk.vector { Vector }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn words(values: &[&[u8]]) -> Vector<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut owned = Vector<Bytes>.make()
  let mut at = usize.ZERO
  while at < values.length {
    run Vector<Bytes>.append(&mut owned, run Bytes.copy(values[at]))
    at = at + usize.ONE
  }
  return move owned
}

fn forwards(command: &Run, expected: &[&[u8]]) -> bool {
  let actual = Vector<Bytes>.asSlice(&command.arguments)
  if actual.length != expected.length {
    return false
  }
  let mut at = usize.ZERO
  while at < actual.length {
    if
      !same(Bytes.asSlice(&actual[at]), expected[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn parsedRun(values: &[&[u8]]) -> Run
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let arguments = run words(values)
  return run ProjectCommands.parseRun(Vector<Bytes>.asSlice(&arguments))
}

effect fn rejected(values: &[&[u8]]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let parsed = run Effect.result(parsedRun(values))
  return match move parsed {
    Result<Run, InvalidProjectCommand | OutOfMemoryError>.Success { value: _ } => false
    Result<Run, InvalidProjectCommand | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProjectCommand {} => true
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn runPolicy() -> ()
  ! AssertionError<'static> | InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let nothing = Vector<Bytes>.make()
  let empty = run ProjectCommands.parseRun(Vector<Bytes>.asSlice(&nothing))
  let noLibrary = match &empty.options.standardLibrary {
    Option<Bytes>.Some { .. } => false
    Option<Bytes>.None => true
  }
  run Testing.expect(
    noLibrary && Vector<Bytes>.length(&empty.arguments) == usize.ZERO && !empty.options.release
      && Vector<Bytes>.length(&empty.options.targets) == usize.ZERO,
    "a bare run selects no options and forwards nothing"
  )
  let mixed = run parsedRun(
    &[
      b"first", b"--stdlib", b"/lib", b"--release", b"--target", b"host", b"-", b"--manifest-path",
      b"app/silk.toml", b"--target", b"x86_64-unknown-linux-gnu", b"--", b"--stdlib", b"--", b"x",
    ]
  )
  let library = match &mixed.options.standardLibrary {
    Option<Bytes>.Some { value } => same(Bytes.asSlice(&value), b"/lib")
    Option<Bytes>.None => false
  }
  let targets = Vector<Bytes>.asSlice(&mixed.options.targets)
  run Testing.expect(
    library && mixed.options.release && holds(&mixed.options.manifestPath, b"app/silk.toml")
      && targets.length == 2 && same(Bytes.asSlice(&targets[0]), b"host")
      && same(Bytes.asSlice(&targets[1]), b"x86_64-unknown-linux-gnu"),
    "project options are read before --, and --target repeats in order"
  )
  run Testing.expect(
    forwards(&mixed, &[b"first", b"-", b"--stdlib", b"--", b"x"]),
    "plain arguments and everything after the first -- reach the program in order"
  )
  let unknown = run rejected(&[b"--release-mode"])
  let repeated = run rejected(&[b"--stdlib", b"/a", b"--stdlib", b"/b"])
  let missing = run rejected(&[b"--stdlib"])
  let manifests = run rejected(&[b"--manifest-path", b"a", b"--manifest-path", b"b"])
  let releases = run rejected(&[b"--release", b"--release"])
  run Testing.expect(
    unknown && repeated && missing && manifests && releases,
    "unknown, repeated and valueless options are refused"
  )
}

test effect fn runCommandLinesSeparateProgramArguments() -> ()
  ! AssertionError<'static> | InvalidProjectCommand | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run runPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn holds(value: &Option<Bytes>, expected: &[u8]) -> bool {
  return match &value.* {
    Option<Bytes>.Some { value: text } => same(Bytes.asSlice(&text), expected)
    Option<Bytes>.None => false
  }
}

fn missing(value: &Option<Bytes>) -> bool {
  return match &value.* {
    Option<Bytes>.Some { .. } => false
    Option<Bytes>.None => true
  }
}

effect fn parsedInit(values: &[&[u8]]) -> Init
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let arguments = run words(values)
  return run ProjectCommands.parseInit(Vector<Bytes>.asSlice(&arguments))
}

effect fn initRejected(values: &[&[u8]]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let parsed = run Effect.result(parsedInit(values))
  return match move parsed {
    Result<Init, InvalidProjectCommand | OutOfMemoryError>.Success { value: _ } => false
    Result<Init, InvalidProjectCommand | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProjectCommand {} => true
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn initPolicy() -> ()
  ! AssertionError<'static> | InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let nothing = Vector<Bytes>.make()
  let bare = run ProjectCommands.parseInit(Vector<Bytes>.asSlice(&nothing))
  run Testing.expect(
    missing(&bare.path) && missing(&bare.name),
    "a bare init selects the working directory and derives the name"
  )
  let both = run parsedInit(&[b"--name", b"hello", b"apps/hello"])
  run Testing.expect(
    holds(&both.path, b"apps/hello") && holds(&both.name, b"hello"),
    "the directory and name may come in either order"
  )
  let paths = run initRejected(&[b"a", b"b"])
  let names = run initRejected(&[b"--name", b"a", b"--name", b"b"])
  let valueless = run initRejected(&[b"--name"])
  let unknown = run initRejected(&[b"--force"])
  run Testing.expect(
    paths && names && valueless && unknown,
    "a second directory or name, a valueless name and unknown options are refused"
  )
  let cleanArguments = run words(&[b"--manifest-path", b"app/silk.toml"])
  let clean = run ProjectCommands.parseClean(Vector<Bytes>.asSlice(&cleanArguments))
  let positional = run words(&[b"build"])
  let refused = run Effect.result(ProjectCommands.parseClean(Vector<Bytes>.asSlice(&positional)))
  let cleanRefused = match move refused {
    Result<Clean, InvalidProjectCommand | OutOfMemoryError>.Success { value: _ } => false
    Result<Clean, InvalidProjectCommand | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProjectCommand {} => true
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  run Testing.expect(
    holds(&clean.manifestPath, b"app/silk.toml") && cleanRefused,
    "clean takes only a manifest path"
  )
  let buildArguments = run words(&[b"--target", b"host", b"--release"])
  let built = run ProjectCommands.parseBuild(Vector<Bytes>.asSlice(&buildArguments))
  let stray = run words(&[b"--release", b"main.silk"])
  let strayRefused = match move run Effect.result(ProjectCommands.parseBuild(Vector<Bytes>.asSlice(&stray))) {
    Result<Build, InvalidProjectCommand | OutOfMemoryError>.Success { value: _ } => false
    Result<Build, InvalidProjectCommand | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProjectCommand {} => true
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  run Testing.expect(
    built.options.release && Vector<Bytes>.length(&built.options.targets) == 1 && strayRefused,
    "a project build takes options only"
  )
}

test effect fn initCommandLinesNameOneProject() -> ()
  ! AssertionError<'static> | InvalidProjectCommand | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run initPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}
