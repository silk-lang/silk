//! Project command lines separate the compiler's options from the program's arguments.

import driver.ProjectCommand as ProjectCommands { Add, Build, Check, Clean, Init, InvalidProjectCommand, Remove, Run, Test }
import driver.ProjectInitializer { Kind }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize
import silk.collections.list { List }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn words(values: &[&[u8]]) -> List<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut owned = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < values.length {
    run List<Bytes>.append(&mut owned, run Bytes.copy(values[at]))
    at = at + usize.ONE
  }
  return move owned
}

fn forwards(command: &Run, expected: &[&[u8]]) -> bool {
  let actual = List<Bytes>.asSlice(&command.arguments)
  if actual.length != expected.length {
    return false
  }
  let mut at = usize.ZERO
  while at < actual.length {
    if
      !same(Bytes.asSlice(&actual[at]), expected[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn parsedRun(values: &[&[u8]]) -> Run
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let arguments = run words(values)
  return run ProjectCommands.parseRun(List<Bytes>.asSlice(&arguments))
}

effect fn rejected(values: &[&[u8]]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let parsed = run Effect.result(parsedRun(values))
  return match move parsed {
    Result<Run, InvalidProjectCommand | OutOfMemoryError>.Success { value: _ } => false
    Result<Run, InvalidProjectCommand | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProjectCommand invalid => true
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn runPolicy() -> ()
  ! AssertionError<'static> | InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let nothing = List<Bytes>.make()
  let empty = run ProjectCommands.parseRun(List<Bytes>.asSlice(&nothing))
  let noLibrary = match &empty.options.standardLibrary {
    Option<Bytes>.Some { .. } => false
    Option<Bytes>.None => true
  }
  run Testing.expect(
    noLibrary && List<Bytes>.length(&empty.arguments) == usize.ZERO && !empty.options.release
      && List<Bytes>.length(&empty.options.targets) == usize.ZERO,
    "a bare run selects no options and forwards nothing"
  )
  let mixed = run parsedRun(
    &[
      b"first", b"--stdlib", b"/lib", b"--release", b"--target", b"host", b"-", b"--manifest-path",
      b"app/silk.toml", b"--profile", b"fast", b"--target", b"x86_64-unknown-linux-gnu", b"--", b"--stdlib",
      b"--", b"x",
    ]
  )
  let library = match &mixed.options.standardLibrary {
    Option<Bytes>.Some { value } => same(Bytes.asSlice(&value), b"/lib")
    Option<Bytes>.None => false
  }
  let targets = List<Bytes>.asSlice(&mixed.options.targets)
  run Testing.expect(
    library && mixed.options.release && holds(&mixed.options.manifestPath, b"app/silk.toml")
      && holds(&mixed.options.profile, b"fast") && targets.length == 2 && same(Bytes.asSlice(&targets[0]), b"host")
      && same(Bytes.asSlice(&targets[1]), b"x86_64-unknown-linux-gnu"),
    "project options are read before --, and --target repeats in order"
  )
  run Testing.expect(
    forwards(&mixed, &[b"first", b"-", b"--stdlib", b"--", b"x"]),
    "plain arguments and everything after the first -- reach the program in order"
  )
  let supplied = run parsedRun(&[b"--profile-input", b"{}"])
  run Testing.expect(holds(&supplied.options.profileInput, b"{}"), "--profile-input keeps its JSON text")
  let inputs = run rejected(&[b"--profile-input", b"{}", b"--profile-input", b"{}"])
  run Testing.expect(inputs, "a repeated --profile-input is refused")
  let checkArguments = run words(&[b"--json", b"--target", b"host"])
  let checking = run ProjectCommands.parseCheck(List<Bytes>.asSlice(&checkArguments))
  let twice = run words(&[b"--json", b"--json"])
  let repeatedJson = match move run Effect.result(ProjectCommands.parseCheck(List<Bytes>.asSlice(&twice))) {
    Result<Check, InvalidProjectCommand | OutOfMemoryError>.Success { value: _ } => false
    Result<Check, InvalidProjectCommand | OutOfMemoryError>.Failure { error: _ } => true
  }
  run Testing.expect(
    checking.json && List<Bytes>.length(&checking.options.targets) == 1 && repeatedJson,
    "check takes the build options and one --json"
  )
  let rootArguments = run words(&[b"--roots", b"--json"])
  let rooted = run ProjectCommands.parseCheck(List<Bytes>.asSlice(&rootArguments))
  run Testing.expect(rooted.roots && rooted.json && !checking.roots, "check takes one --roots beside --json")
  let replayArguments = run words(&[b"--replay", b"edits.toml"])
  let replaying = run ProjectCommands.parseCheck(List<Bytes>.asSlice(&replayArguments))
  let replayTwice = run words(&[b"--replay", b"a.toml", b"--replay", b"b.toml"])
  let repeatedReplay = match move run Effect.result(ProjectCommands.parseCheck(List<Bytes>.asSlice(&replayTwice))) {
    Result<Check, InvalidProjectCommand | OutOfMemoryError>.Success { value: _ } => false
    Result<Check, InvalidProjectCommand | OutOfMemoryError>.Failure { error: _ } => true
  }
  run Testing.expect(
    holds(&replaying.replay, b"edits.toml") && missing(&checking.replay) && repeatedReplay,
    "check takes one --replay script"
  )
  let differentialArguments = run words(&[b"--replay", b"edits.toml", b"--differential"])
  let comparing = run ProjectCommands.parseCheck(List<Bytes>.asSlice(&differentialArguments))
  let alone = run words(&[b"--differential"])
  let withoutReplay = match move run Effect.result(ProjectCommands.parseCheck(List<Bytes>.asSlice(&alone))) {
    Result<Check, InvalidProjectCommand | OutOfMemoryError>.Success { value: _ } => false
    Result<Check, InvalidProjectCommand | OutOfMemoryError>.Failure { error: _ } => true
  }
  run Testing.expect(
    comparing.differential && !replaying.differential && withoutReplay,
    "--differential compares a replay and needs one"
  )
  let testArguments = run words(
    &[b"--filter", b"Parse", b"--no-cache", b"--root", b"src/lib.silk", b"--release", b"--file", b"src/a.silk", b"--timeout", b"5"]
  )
  let testing = run ProjectCommands.parseTest(List<Bytes>.asSlice(&testArguments))
  let filters = run words(&[b"--filter", b"a", b"--filter", b"b"])
  let repeatedFilter = match move run Effect.result(ProjectCommands.parseTest(List<Bytes>.asSlice(&filters))) {
    Result<Test, InvalidProjectCommand | OutOfMemoryError>.Success { value: _ } => false
    Result<Test, InvalidProjectCommand | OutOfMemoryError>.Failure { error: _ } => true
  }
  let positional = run words(&[b"src/main.silk"])
  let positionalTest = match move run Effect.result(ProjectCommands.parseTest(List<Bytes>.asSlice(&positional))) {
    Result<Test, InvalidProjectCommand | OutOfMemoryError>.Success { value: _ } => false
    Result<Test, InvalidProjectCommand | OutOfMemoryError>.Failure { error: _ } => true
  }
  let fractional = run words(&[b"--timeout", b"1.5"])
  let fractionalTimeout = match move run Effect.result(ProjectCommands.parseTest(List<Bytes>.asSlice(&fractional))) {
    Result<Test, InvalidProjectCommand | OutOfMemoryError>.Success { value: _ } => false
    Result<Test, InvalidProjectCommand | OutOfMemoryError>.Failure { error: _ } => true
  }
  run Testing.expect(
    testing.noCache && testing.options.release && holds(&testing.root, b"src/lib.silk")
      && holds(&testing.file, b"src/a.silk") && holds(&testing.filter, b"Parse") && holds(&testing.timeout, b"5")
      && repeatedFilter && positionalTest && fractionalTimeout,
    "test takes the build options and one each of --root, --file, --filter, --timeout in whole seconds and --no-cache"
  )
  let tuned = run parsedRun(&[b"--optimization", b"release-with-debug"])
  let releasing = run parsedRun(&[b"--release", b"--optimization", b"release"])
  let contradicting = run parsedRun(&[b"--optimization", b"debug", b"--release"])
  let tunedProfile = match move ProjectCommands.optimizationProfile(&tuned.options) {
    Option<&[u8]>.Some { value } => same(value, b"release-with-debug")
    Option<&[u8]>.None => false
  }
  let releaseProfile = match move ProjectCommands.optimizationProfile(&releasing.options) {
    Option<&[u8]>.Some { value } => same(value, b"release")
    Option<&[u8]>.None => false
  }
  run Testing.expect(
    tunedProfile && releaseProfile && !ProjectCommands.conflicting(&tuned.options)
      && !ProjectCommands.conflicting(&releasing.options) && ProjectCommands.conflicting(&contradicting.options),
    "--optimization names a profile, and --release agrees only with release"
  )
  let unknown = run rejected(&[b"--release-mode"])
  let repeated = run rejected(&[b"--stdlib", b"/a", b"--stdlib", b"/b"])
  let missing = run rejected(&[b"--stdlib"])
  let manifests = run rejected(&[b"--manifest-path", b"a", b"--manifest-path", b"b"])
  let releases = run rejected(&[b"--release", b"--release"])
  let profiles = run rejected(&[b"--profile", b"a", b"--profile", b"b"])
  let optimizations = run rejected(&[b"--optimization", b"speed"])
  run Testing.expect(
    unknown && repeated && missing && manifests && releases && profiles && optimizations,
    "unknown, repeated and valueless options are refused"
  )
}

test effect fn runCommandLinesSeparateProgramArguments() -> ()
  ! AssertionError<'static> | InvalidProjectCommand | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run runPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn holds(value: &Option<Bytes>, expected: &[u8]) -> bool {
  return match &value.* {
    Option<Bytes>.Some { value: text } => same(Bytes.asSlice(&text), expected)
    Option<Bytes>.None => false
  }
}

fn missing(value: &Option<Bytes>) -> bool {
  return match &value.* {
    Option<Bytes>.Some { .. } => false
    Option<Bytes>.None => true
  }
}

effect fn parsedInit(values: &[&[u8]]) -> Init
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let arguments = run words(values)
  return run ProjectCommands.parseInit(List<Bytes>.asSlice(&arguments))
}

effect fn initRejected(values: &[&[u8]]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let parsed = run Effect.result(parsedInit(values))
  return match move parsed {
    Result<Init, InvalidProjectCommand | OutOfMemoryError>.Success { value: _ } => false
    Result<Init, InvalidProjectCommand | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProjectCommand invalid => true
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn initPolicy() -> ()
  ! AssertionError<'static> | InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let nothing = List<Bytes>.make()
  let bare = run ProjectCommands.parseInit(List<Bytes>.asSlice(&nothing))
  run Testing.expect(
    missing(&bare.path) && missing(&bare.name),
    "a bare init selects the working directory and derives the name"
  )
  let both = run parsedInit(&[b"--name", b"hello", b"apps/hello"])
  run Testing.expect(
    holds(&both.path, b"apps/hello") && holds(&both.name, b"hello"),
    "the directory and name may come in either order"
  )
  let paths = run initRejected(&[b"a", b"b"])
  let names = run initRejected(&[b"--name", b"a", b"--name", b"b"])
  let valueless = run initRejected(&[b"--name"])
  let unknown = run initRejected(&[b"--force"])
  run Testing.expect(
    paths && names && valueless && unknown,
    "a second directory or name, a valueless name and unknown options are refused"
  )
  let cleanArguments = run words(&[b"--manifest-path", b"app/silk.toml"])
  let clean = run ProjectCommands.parseClean(List<Bytes>.asSlice(&cleanArguments))
  let positional = run words(&[b"build"])
  let refused = run Effect.result(ProjectCommands.parseClean(List<Bytes>.asSlice(&positional)))
  let cleanRefused = match move refused {
    Result<Clean, InvalidProjectCommand | OutOfMemoryError>.Success { value: _ } => false
    Result<Clean, InvalidProjectCommand | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProjectCommand invalid => true
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  run Testing.expect(
    holds(&clean.manifestPath, b"app/silk.toml") && cleanRefused,
    "clean takes only a manifest path"
  )
  let buildArguments = run words(&[b"--target", b"host", b"--release"])
  let built = run ProjectCommands.parseBuild(List<Bytes>.asSlice(&buildArguments))
  let stray = run words(&[b"--release", b"main.silk"])
  let strayRefused = match move run Effect.result(ProjectCommands.parseBuild(List<Bytes>.asSlice(&stray))) {
    Result<Build, InvalidProjectCommand | OutOfMemoryError>.Success { value: _ } => false
    Result<Build, InvalidProjectCommand | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProjectCommand invalid => true
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  run Testing.expect(
    built.options.release && List<Bytes>.length(&built.options.targets) == 1 && strayRefused,
    "a project build takes options only"
  )
}

effect fn workspacePolicy() -> ()
  ! AssertionError<'static> | InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let library = run parsedInit(&[b"--lib", b"libs/math"])
  let workspace = run parsedInit(&[b"--workspace"])
  run Testing.expect(
    library.kind == Kind.Library && holds(&library.path, b"libs/math") && workspace.kind == Kind.Workspace,
    "init creates a library with --lib and a workspace with --workspace"
  )
  let plain = run parsedInit(&[b"app"])
  let both = run initRejected(&[b"--lib", b"--workspace"])
  let named = run parsedInit(&[b"--workspace", b"--name", b"store"])
  let starter = match &named.name {
    Option<Bytes>.Some { value } => same(Bytes.asSlice(&value), b"store")
    Option<Bytes>.None => false
  }
  run Testing.expect(
    plain.kind == Kind.Executable && both && named.kind == Kind.Workspace && starter,
    "init kinds exclude each other, and --name names a workspace's starter member"
  )
  let selecting = run words(&[b"-p", b"app", b"--package", b"math", b"--workspace"])
  let built = run ProjectCommands.parseBuild(List<Bytes>.asSlice(&selecting))
  let packages = List<Bytes>.asSlice(&built.options.packages)
  run Testing.expect(
    packages.length == 2 && same(Bytes.asSlice(&packages[0]), b"app") && same(Bytes.asSlice(&packages[1]), b"math")
      && built.options.workspace,
    "--package and -p repeat in order, and --workspace selects every member"
  )
  let running = run parsedRun(&[b"-p", b"app", b"input.txt"])
  run Testing.expect(
    List<Bytes>.length(&running.options.packages) == 1 && forwards(&running, &[b"input.txt"]),
    "run takes --package before the program's arguments"
  )
  let addArguments = run words(&[b"../libs/math", b"--name", b"numbers", b"--manifest-path", b"app/silk.toml"])
  let added = run ProjectCommands.parseAdd(List<Bytes>.asSlice(&addArguments))
  let bareAdd = run words(&[b"../libs/math"])
  let derived = run ProjectCommands.parseAdd(List<Bytes>.asSlice(&bareAdd))
  run Testing.expect(
    same(Bytes.asSlice(&added.path), b"../libs/math") && holds(&added.name, b"numbers")
      && holds(&added.manifestPath, b"app/silk.toml") && missing(&derived.name),
    "add takes one package directory, an optional name and a manifest path"
  )
  let pathless = List<Bytes>.make()
  let addRefused = match move run Effect.result(ProjectCommands.parseAdd(List<Bytes>.asSlice(&pathless))) {
    Result<Add, InvalidProjectCommand | OutOfMemoryError>.Success { value: _ } => false
    Result<Add, InvalidProjectCommand | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProjectCommand invalid => true
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let removeArguments = run words(&[b"math"])
  let removed = run ProjectCommands.parseRemove(List<Bytes>.asSlice(&removeArguments))
  let twoNames = run words(&[b"math", b"numbers"])
  let removeRefused = match move run Effect.result(ProjectCommands.parseRemove(List<Bytes>.asSlice(&twoNames))) {
    Result<Remove, InvalidProjectCommand | OutOfMemoryError>.Success { value: _ } => false
    Result<Remove, InvalidProjectCommand | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProjectCommand invalid => true
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  run Testing.expect(
    addRefused && same(Bytes.asSlice(&removed.name), b"math") && missing(&removed.manifestPath) && removeRefused,
    "add needs a path, and remove takes exactly one dependency name"
  )
}

test effect fn workspaceCommandLinesSelectMembersAndEditManifests() -> ()
  ! AssertionError<'static> | InvalidProjectCommand | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run workspacePolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn initCommandLinesNameOneProject() -> ()
  ! AssertionError<'static> | InvalidProjectCommand | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run initPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn clangPolicy() -> ()
  ! AssertionError<'static> | InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let ran = run parsedRun(&[b"--clang", b"/opt/llvm/bin/clang", b"first"])
  let building = run words(&[b"--clang", b"clang-22"])
  let built = run ProjectCommands.parseBuild(List<Bytes>.asSlice(&building))
  let testing = run words(&[b"--no-cache", b"--clang", b"./clang"])
  let tested = run ProjectCommands.parseTest(List<Bytes>.asSlice(&testing))
  run Testing.expect(
    holds(&ran.options.clang, b"/opt/llvm/bin/clang") && forwards(&ran, &[b"first"])
      && holds(&built.options.clang, b"clang-22") && holds(&tested.options.clang, b"./clang"),
    "build, run and test take --clang as SILK_CLANG is honored"
  )
  let unset = run parsedRun(&[b"first"])
  let repeated = run rejected(&[b"--clang", b"a", b"--clang", b"b"])
  let empty = run rejected(&[b"--clang", b""])
  let valueless = run rejected(&[b"--clang"])
  run Testing.expect(missing(&unset.options.clang) && repeated && empty && valueless,
    "--clang is absent by default, and a repeated, empty or valueless --clang is refused")
}

test effect fn projectCommandLinesSelectClang() -> ()
  ! AssertionError<'static> | InvalidProjectCommand | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run clangPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

// The reason a parse gave for refusing its command line, or empty when it accepted it.
effect fn because<T>(outcome: Result<T, InvalidProjectCommand | OutOfMemoryError>) -> Bytes ! OutOfMemoryError {
  return match move outcome {
    Result<T, InvalidProjectCommand | OutOfMemoryError>.Success { value: _ } => Bytes.make()
    Result<T, InvalidProjectCommand | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProjectCommand invalid => move invalid.reason
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// The reason `command` gives for refusing `values`, or empty when it accepts them.
effect fn reason(command: &[u8], values: &[&[u8]]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let arguments = run words(values)
  let given = List<Bytes>.asSlice(&arguments)
  if same(command, b"check") {
    return run because<Check>(run Effect.result(ProjectCommands.parseCheck(given)))
  }
  if same(command, b"init") {
    return run because<Init>(run Effect.result(ProjectCommands.parseInit(given)))
  }
  if same(command, b"add") {
    return run because<Add>(run Effect.result(ProjectCommands.parseAdd(given)))
  }
  return run because<Run>(run Effect.result(ProjectCommands.parseRun(given)))
}

effect fn refusals(command: &[u8], values: &[&[u8]], expected: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let given = run reason(command, values)
  return same(Bytes.asSlice(&given), expected)
}

effect fn reasonPolicy() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  run Testing.expect(
    run refusals(b"check", &[b"--relase"], b"unknown option `--relase`; did you mean `--release`?"),
    "a misspelled option names the closest known option"
  )
  run Testing.expect(
    run refusals(b"run", &[b"--frobnicate"], b"unknown option `--frobnicate`"),
    "an option close to none is named alone"
  )
  run Testing.expect(
    run refusals(b"check", &[b"--release", b"--release"], b"`--release` is given more than once"),
    "a repeated flag is named"
  )
  run Testing.expect(
    run refusals(b"run", &[b"--stdlib"], b"`--stdlib` needs a value"),
    "an option without its value is named"
  )
  run Testing.expect(
    run refusals(b"run", &[b"--progress", b"loud"], b"`--progress` takes auto, live, plain or never"),
    "a value an option does not take names the values it does"
  )
  run Testing.expect(
    run refusals(b"run", &[b"--progress", b"plain", b"--progress", b"never"], b"`--progress` is given more than once"),
    "a repeated option with a value is named"
  )
  run Testing.expect(
    run refusals(b"check", &[b"--differential"], b"`--differential` needs `--replay <script>`"),
    "--differential without --replay says what it needs"
  )
  run Testing.expect(
    run refusals(b"init", &[b"--lib", b"--workspace"], b"`--lib` and `--workspace` cannot be combined: choose a library package or a workspace"),
    "--lib with --workspace says they exclude each other"
  )
  run Testing.expect(
    run refusals(b"init", &[b"a", b"b"], b"unexpected argument `b`"),
    "a second directory is named"
  )
  run Testing.expect(
    run refusals(b"add", &[b"--name", b"tools"], b"missing the directory of the package to add"),
    "add without a directory says so"
  )
}

test effect fn refusedCommandLinesSayWhy() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run reasonPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}
