//! The dependencies a workspace declares once for its members: `[workspace.dependencies]`.
//!
//! # Details
//! A workspace's root manifest may hold a `[workspace.dependencies]` table whose entries are
//! written as `[dependencies]` entries are. A member takes one by name with
//! `name = { workspace = true }` in its own `[dependencies]` or in a profile's, so a pin that many
//! members share is written, and changed, in one place (PACKAGE-008). The entry is read as if the
//! member had written it, except that a `path` resolves against the workspace root's directory.
//!
//! The workspace of a package is the nearest manifest at or above its directory that has a
//! `[workspace]` table and either sits in that directory or lists it in `members`.

import driver.CommandPath
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.box {Box}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.system.filesystem {FileError, FileSystem, Path}
import silk.text.string {String}
import silk.toml.scanner {TomlError}
import silk.toml.value {Toml, TomlChild, Value as TomlValue}
import silk.num.usize

/// The workspace a package belongs to, read for the dependencies it shares with its members.
pub struct Shared {
  // The directory holding the workspace's root manifest, which a shared `path` resolves against.
  directory: Path,
  // The workspace's root manifest.
  manifest: Path,
  document: TomlValue,
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

/// Whether `text` is a manifest-relative directory: nonempty, relative, without NUL, and never
/// climbing above the manifest's directory at any component. `/` and `\` both separate components.
pub fn isContainedDirectory(text: &[u8]) -> bool {
  if text.length == usize.ZERO || text[usize.ZERO] == 47 || text[usize.ZERO] == 92 {
    return false
  }

  // A drive-letter prefix such as `C:/` is absolute on Windows.
  let second = usize.ONE + usize.ONE
  if text.length > second && text[usize.ONE] == 58 && (text[second] == 47 || text[second] == 92) {
    return false
  }
  let mut depth = usize.ZERO
  let mut start = usize.ZERO
  let mut at = usize.ZERO
  while at <= text.length {
    let boundary = at == text.length || text[at] == 47 || text[at] == 92
    if at < text.length && text[at] == 0 {
      return false
    }
    if boundary {
      let length = at - start
      if length == 2 && text[start] == 46 && text[start + usize.ONE] == 46 {
        if depth == usize.ZERO {
          return false
        }
        depth = depth - usize.ONE
      } else if length > usize.ZERO && !(length == usize.ONE && text[start] == 46) {
        depth = depth + usize.ONE
      }
      start = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return true
}

/// Whether some `members` entry of the `[workspace]` table `workspace`, whose manifest sits in
/// `directory`, could name the directory `target`, judged from the entries alone: a `dir/*` entry
/// names every child of `dir`. A malformed list counts as listing it, so that whoever reads the
/// workspace next reports the list rather than passing the workspace over.
pub effect fn lists(directory: &Path, workspace: &TomlValue, target: &Path) -> bool
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let listed = match move Toml.field(workspace, "members") {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      return true
    }
  }
  let array = match &listed.* {
    TomlValue.Array { .. } => true
    _ => false
  }
  if !array {
    return true
  }
  let mut at = usize.ZERO
  while true {
    let item = match move Toml.item(listed, at) {
      Option<&TomlValue>.Some { value } => value
      Option<&TomlValue>.None => {
        break
      }
    }
    let entry = match move Toml.asString(Option<&TomlValue>.some(item)) {
      Option<string>.Some { value } => String.utf8Bytes(value)
      Option<string>.None => {
        return true
      }
    }
    let suffix = usize.ONE + usize.ONE
    let wildcard = entry.length > suffix && entry[entry.length - usize.ONE] == 42 && entry[entry.length - suffix] == 47
    let mut written = entry
    if wildcard {
      written = Slice.view<u8>(entry, usize.ZERO, entry.length - suffix)
    }
    if !isContainedDirectory(written) {
      return true
    }
    let base = run CommandPath.resolve(directory, written)
    if wildcard {
      if let Option<Path>.Some { value: parent } = move run Path.parent(target) {
        if same(Path.rawBytes(&parent), Path.rawBytes(&base)) {
          return true
        }
      }
    } else if same(Path.rawBytes(&base), Path.rawBytes(target)) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

/// Whether the dependency entry `entry` takes its fields from the workspace: it writes a
/// `workspace` field, as `{ workspace = true }` does.
pub fn inherits(entry: &TomlValue) -> bool {
  return match move Toml.field(entry, "workspace") {
    Option<&TomlValue>.Some {..} => true
    Option<&TomlValue>.None => false
  }
}

/// Whether the dependency entry `entry` writes `workspace = true` and no other field, the only
/// spelling that takes an entry from the workspace.
pub fn inheritsOnly(entry: &TomlValue) -> bool {
  let children = match &entry.* {
    TomlValue.Table {entries, kind: _} => List<TomlChild>.asSlice(&Box<List<TomlChild>>.get(&entries)[0])
    _ => { return false }
  }
  if children.length != usize.ONE { return false }
  if let Option<&TomlValue>.Some {value: flag} = move Toml.field(entry, "workspace") {
    if let TomlValue.Boolean {value} = &flag.* { return value }
  }
  return false
}

/// The workspace of the package in `directory`: the nearest manifest at or above it that has a
/// `[workspace]` table and either sits in `directory` or lists it in `members`. The search stops
/// after the directory `bound`, the root of the checkout a fetched package was read from, when
/// one is given. A manifest on the way that cannot be read or parsed is passed over.
pub effect fn of(directory: &Path, bound: &Option<Path>) -> Option<Shared>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut current = run Path.fromBytes(Path.rawBytes(directory))
  while true {
    let candidate = run Path.join(&current, "silk.toml")
    if let Result<Bytes, FileError | OutOfMemoryError>.Success {value: contents} = move run Effect.result(FileSystem.readFile(&candidate)) {
      if let Result<TomlValue, TomlError | OutOfMemoryError>.Success {value: document} = move run Effect.result(Toml.parse(Bytes.asSlice(&contents))) {
        let mut found = false
        if let Option<&TomlValue>.Some {value: workspace} = move Toml.field(&document, "workspace") {
          found = same(Path.rawBytes(&current), Path.rawBytes(directory))
          if !found { found = run lists(&current, workspace, directory) }
        }
        if found {
          return Option<Shared>.some(Shared {directory: move current, manifest: move candidate, document: move document})
        }
      }
    }
    if let Option<Path>.Some {value: root} = &bound.* {
      if same(Path.rawBytes(&root), Path.rawBytes(&current)) { break }
    }
    match move run CommandPath.parent(&current) {
      Option<Path>.Some {value} => { current = move value }
      Option<Path>.None => { break }
    }
  }
  return Option<Shared>.none()
}

/// The directory holding the workspace's root manifest, which the `path` of a shared entry
/// resolves against.
pub fn directory(self: &Shared) -> &Path {
  return &self.directory
}

/// The workspace's root manifest, the silk.toml that writes `[workspace.dependencies]`.
pub fn manifest(self: &Shared) -> &Path {
  return &self.manifest
}

/// The entry `[workspace.dependencies]` writes for `name`, or `None` when the table is missing or
/// has no such entry.
pub fn find<'a>(self: &'a Shared, name: &[u8]) -> Option<&'a TomlValue> {
  let table = match move Toml.fieldAt(Toml.field(&self.document, "workspace"), "dependencies") {
    Option<&TomlValue>.Some {value} => value
    Option<&TomlValue>.None => { return Option<&'a TomlValue>.none() }
  }
  let children = match &table.* {
    TomlValue.Table {entries, kind: _} => List<TomlChild>.asSlice(&Box<List<TomlChild>>.get(&entries)[0])
    _ => { return Option<&'a TomlValue>.none() }
  }
  let mut at = usize.ZERO
  while at < children.length {
    if let TomlChild.Member {entry: written} = &children[at] {
      if same(String.ownedUtf8Bytes(&written.key), name) { return Option<&'a TomlValue>.some(&written.value) }
    }
    at = at + usize.ONE
  }
  return Option<&'a TomlValue>.none()
}

/// The entry that dependency `name`, written as `entry`, is read from: `entry` itself, or the one
/// `[workspace.dependencies]` of `shared` writes for `name` when `entry` takes it from the
/// workspace. `None` when it does and no workspace, or no such entry, is there to take it from.
pub fn source<'a>(shared: &'a Option<Shared>, name: &[u8], entry: &'a TomlValue) -> Option<&'a TomlValue> {
  if !inherits(entry) { return Option<&'a TomlValue>.some(entry) }
  return match &shared.* {
    Option<Shared>.Some {value} => find(&value, name)
    Option<Shared>.None => Option<&'a TomlValue>.none()
  }
}

/// The directory a `path` of dependency entry `entry` resolves against: the workspace root's when
/// `entry` takes its fields from the workspace `shared`, else `directory`, its own manifest's.
pub fn base<'a>(shared: &'a Option<Shared>, entry: &TomlValue, directory: &'a Path) -> &'a Path {
  if inherits(entry) {
    if let Option<Shared>.Some {value} = &shared.* { return &value.directory }
  }
  return directory
}
