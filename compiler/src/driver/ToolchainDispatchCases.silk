//! `silk` replaces itself with the toolchain a command selects, stays when that is the running
//! compiler or a local build, and exits 3 when the selected toolchain is not installed.

import driver.ToolchainCommand as ToolchainCommands { Context }
import driver.ToolchainDispatch as ToolchainDispatch { Action, Dispatch }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.filesystem { FileError, FileSystem, Path }
import silk.list { List }
import silk.option { Option }
import silk.os_filesystem { OsFileSystem }
import silk.result { Result }
import silk.testing { AssertionError, Testing }
import silk.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn temporaryRoot() -> &'static [u8] {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return b"/private/tmp"
  } else {
    return b"/tmp"
  }
}

effect fn write(root: &Path, relative: string, text: &[u8]) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let path = run Path.join(root, relative)
  run FileSystem.writeFileWithParents(&path, text)
}

// The decision for `words` run in `working` by a compiler of version `running`, with
// `SILK_TOOLCHAIN` set to `environment` when it is not empty.
effect fn decided(
  working: &Path,
  home: &Path,
  running: &[u8],
  environment: &[u8],
  words: &[&[u8]]
) -> Dispatch
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut selected = Option<Bytes>.none()
  if environment.length > usize.ZERO {
    selected = Option<Bytes>.some(run Bytes.copy(environment))
  }
  let context = Context {
    working: run Path.fromBytes(Path.rawBytes(working)),
    home: Option<Path>.some(run Path.fromBytes(Path.rawBytes(home))),
    running: run Bytes.copy(running),
    runningExecutable: Option<Bytes>.some(run Bytes.copy(b"/usr/local/bin/silk")),
    environment: move selected,
  }
  let mut arguments = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < words.length {
    run List<Bytes>.append(&mut arguments, run Bytes.copy(words[at]))
    at = at + usize.ONE
  }
  return run ToolchainDispatch.decide(&context, List<Bytes>.asSlice(&arguments))
}

// Whether `decision` replaces the process with `home`'s toolchain `name`, skipping `skip` arguments.
effect fn replaces(decision: &Dispatch, home: &Path, name: &[u8], skip: usize) -> bool
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut expected = run Bytes.copy(Path.rawBytes(home))
  run Bytes.append(&mut expected, b"/toolchains/")
  run Bytes.append(&mut expected, name)
  run Bytes.append(&mut expected, b"/bin/silk")
  return decision.action == Action.Replace
    && same(Bytes.asSlice(&decision.executable), Bytes.asSlice(&expected))
    && same(Bytes.asSlice(&decision.version), name) && decision.skip == skip
}

effect fn dispatches(root: &Path) -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let home = run Path.join(root, "home")
  run write(&home, "toolchains/0.1.0-dev.4+892d3bee6c53/bin/silk", b"")
  run write(&home, "toolchains/0.1.0-dev.6+1aed5da1a342/bin/silk", b"")
  run write(
    root,
    "app/silk.toml",
    b"[package]\nname = \"app\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.4\"\nroot = \"main.silk\"\n"
  )
  run write(
    root,
    "missing/silk.toml",
    b"[package]\nname = \"missing\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.5\"\nroot = \"main.silk\"\n"
  )
  let app = run Path.join(root, "app")
  let missing = run Path.join(root, "missing")
  let pinned = run decided(&app, &home, b"0.1.0-dev.6+1aed5da1a342", b"", &[b"build"])
  run Testing.expect(
    run replaces(&pinned, &home, b"0.1.0-dev.4+892d3bee6c53", usize.ZERO),
    "a project's pin replaces a compiler of another version with the installed toolchain"
  )
  let current = run decided(&app, &home, b"0.1.0-dev.4+892d3bee6c53", b"", &[b"build"])
  let replaced = run decided(
    &app,
    &home,
    b"0.1.0-dev.4+892d3bee6c53",
    b"0.1.0-dev.4+892d3bee6c53",
    &[b"build"]
  )
  run Testing.expect(
    current.action == Action.Stay && replaced.action == Action.Stay,
    "the pinned compiler, and the replacement SILK_TOOLCHAIN names, run the command themselves"
  )
  let local = run decided(&app, &home, b"0.0.0", b"", &[b"build"])
  let opted = run decided(&app, &home, b"0.1.0-dev.6+1aed5da1a342", b"local", &[b"build"])
  let managing = run decided(&missing, &home, b"0.1.0-dev.6+1aed5da1a342", b"", &[b"toolchain", b"list"])
  run Testing.expect(
    local.action == Action.Stay && opted.action == Action.Stay && managing.action == Action.Stay,
    "local builds, SILK_TOOLCHAIN=local and `silk toolchain` ignore the pin"
  )
  let requested = run decided(&app, &home, b"0.0.0", b"local", &[b"+0.1.0-dev.6", b"build"])
  run Testing.expect(
    run replaces(&requested, &home, b"0.1.0-dev.6+1aed5da1a342", usize.ONE),
    "+<version> selects a toolchain from any compiler, and the replacement does not see it"
  )
  let absent = run decided(&missing, &home, b"0.1.0-dev.6+1aed5da1a342", b"", &[b"build"])
  run Testing.expect(
    absent.action == Action.Exit && absent.status == ToolchainCommands.NOT_INSTALLED,
    "a missing pinned toolchain exits 3"
  )
}

effect fn isolatedDispatches() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut files = run OsFileSystem.make(temporaryRoot())
  let parent = run Path.root()
  let root = run FileSystem.createTemporaryDirectory(&parent, b"silk-dispatch-")
    |> Effect.provideMut<FileSystem>(&mut files)
  let attempted = run Effect.result(dispatches(&root)) |> Effect.provideMut<FileSystem>(&mut files)
  let cleaned = run Effect.result(FileSystem.removeDirectoryRecursively(&root))
    |> Effect.provideMut<FileSystem>(&mut files)
  drop cleaned
  match move attempted {
    Result<(), AssertionError<'static> | FileError | OutOfMemoryError>.Success { value } => {}
    Result<(), AssertionError<'static> | FileError | OutOfMemoryError>.Failure { error } => {
      fail move error
    }
  }
}

test effect fn toolchainDispatchFollowsTheSelection() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run isolatedDispatches() |> Effect.provideMut<Allocator>(&mut allocator)
}
