//! Cache mode resolution precedence, size parsing/formatting, scope-key isolation, and sharded
//! path layout.

import driver.CacheLayout
import driver.CacheLayout { CacheMode, CachePolicy, CacheSelection, InvalidCacheOption }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.filesystem_native { OsFileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.testing.testing { AssertionError, Testing }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn temporaryParent() -> string<'static> {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return "/private/tmp"
  } else {
    return "/tmp"
  }
}

effect fn ignoreCleanup(error: FileError | OutOfMemoryError) -> () {
  drop error
  return ()
}

effect fn cleanup(path: &Path) -> ()
  ? &mut FileSystem | &mut Allocator {
  return run Effect.catchAll(FileSystem.removeDirectoryRecursively(path), ignoreCleanup)
}

struct FakeHost {
  silkHome: Option<Bytes>,
  home: Option<Bytes>,
  cacheMode: Option<Bytes>,
  cacheDir: Option<Bytes>,
  maxSize: Option<Bytes>,
  maxAgeDays: Option<Bytes>,
}

impl FakeHost {
  fn empty() -> FakeHost {
    return FakeHost {
      silkHome: Option<Bytes>.none(),
      home: Option<Bytes>.none(),
      cacheMode: Option<Bytes>.none(),
      cacheDir: Option<Bytes>.none(),
      maxSize: Option<Bytes>.none(),
      maxAgeDays: Option<Bytes>.none(),
    }
  }

  effect fn argumentCount(self: &mut Self) -> usize
    ! HostInputError {
    return usize.ZERO
  }

  effect fn argument(self: &mut Self, index: usize) -> Option<Bytes>
    ! HostInputError | OutOfMemoryError
    ? &mut Allocator {
    return Option<Bytes>.none()
  }

  effect fn workingDirectory(self: &mut Self) -> Bytes
    ! HostInputError | OutOfMemoryError
    ? &mut Allocator {
    return run Bytes.copy(b"/work")
  }

  effect fn variableNames(self: &mut Self) -> List<Bytes>
    ! HostInputError | OutOfMemoryError
    ? &mut Allocator {
    return List<Bytes>.make()
  }

  effect fn variable(self: &mut Self, name: &[u8]) -> Option<Bytes>
    ! HostInputError | OutOfMemoryError
    ? &mut Allocator {
    if same(name, b"SILK_HOME") {
      return match &self.silkHome {
        Option<Bytes>.Some { value } => Option<Bytes>.some(run Bytes.copy(value.asSlice()))
        Option<Bytes>.None => Option<Bytes>.none()
      }
    }
    if same(name, b"HOME") || same(name, b"USERPROFILE") {
      return match &self.home {
        Option<Bytes>.Some { value } => Option<Bytes>.some(run Bytes.copy(value.asSlice()))
        Option<Bytes>.None => Option<Bytes>.none()
      }
    }
    if same(name, b"SILK_CACHE_MODE") {
      return match &self.cacheMode {
        Option<Bytes>.Some { value } => Option<Bytes>.some(run Bytes.copy(value.asSlice()))
        Option<Bytes>.None => Option<Bytes>.none()
      }
    }
    if same(name, b"SILK_CACHE_DIR") {
      return match &self.cacheDir {
        Option<Bytes>.Some { value } => Option<Bytes>.some(run Bytes.copy(value.asSlice()))
        Option<Bytes>.None => Option<Bytes>.none()
      }
    }
    if same(name, b"SILK_CACHE_MAX_SIZE") {
      return match &self.maxSize {
        Option<Bytes>.Some { value } => Option<Bytes>.some(run Bytes.copy(value.asSlice()))
        Option<Bytes>.None => Option<Bytes>.none()
      }
    }
    if same(name, b"SILK_CACHE_MAX_AGE_DAYS") {
      return match &self.maxAgeDays {
        Option<Bytes>.Some { value } => Option<Bytes>.some(run Bytes.copy(value.asSlice()))
        Option<Bytes>.None => Option<Bytes>.none()
      }
    }
    return Option<Bytes>.none()
  }
}

impl HostInput for FakeHost {
  argumentCount: FakeHost.argumentCount

  argument: FakeHost.argument

  workingDirectory: FakeHost.workingDirectory

  variable: FakeHost.variable

  variableNames: FakeHost.variableNames
}

fn hasSize(parsed: Option<u64>, expected: u64) -> bool {
  return match parsed {
    Option<u64>.Some { value } => value == expected
    Option<u64>.None => false
  }
}

fn isSharedMode(mode: CacheMode) -> bool {
  return match mode {
    CacheMode.Shared => true
    CacheMode.Workspace => false
  }
}

fn rootMatches(policy: &CachePolicy, expected: &[u8]) -> bool {
  return match &policy.sharedRoot {
    Option<Path>.Some { value } => same(Path.rawBytes(&value), expected)
    Option<Path>.None => false
  }
}

effect fn sizeAndPathCases() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut Allocator {
  run Testing.expect(
    hasSize(CacheLayout.parseSize(b"0"), 0) && hasSize(CacheLayout.parseSize(b"1048576"), 1048576)
      && hasSize(CacheLayout.parseSize(b"256K"), 262144)
      && hasSize(CacheLayout.parseSize(b"512M"), 536870912)
      && hasSize(CacheLayout.parseSize(b"10G"), 10737418240)
      && hasSize(CacheLayout.parseSize(b"2GiB"), 2147483648)
      && hasSize(CacheLayout.parseSize(b"1T"), 1099511627776)
      && CacheLayout.parseSize(b"").isNone()
      && CacheLayout.parseSize(b"abc").isNone()
      && CacheLayout.parseSize(b"-10M").isNone()
      && CacheLayout.parseSize(b"10X").isNone(),
    "parseSize accepts plain bytes and binary unit suffixes and rejects invalid strings",
  )

  let formattedB = run CacheLayout.formatSize(500)
  let formattedK = run CacheLayout.formatSize(2048)
  let formattedM = run CacheLayout.formatSize(536870912)
  let formattedG = run CacheLayout.formatSize(10737418240)
  run Testing.expect(
    same(formattedB.asSlice(), b"500 B") && same(formattedK.asSlice(), b"2.0 KiB")
      && same(formattedM.asSlice(), b"512.0 MiB")
      && same(formattedG.asSlice(), b"10.0 GiB"),
    "formatSize formats byte counts into readable units",
  )

  let dirA = run Path.make("/projects/one/app")
  let dirB = run Path.make("/projects/two/app")
  let scopeA = run CacheLayout.scopeKey(b"app", &dirA, b"")
  let scopeB = run CacheLayout.scopeKey(b"app", &dirB, b"")
  let scopeTasks = run CacheLayout.scopeKey(b"app", &dirA, b".tasks")
  let scopeTests = run CacheLayout.scopeKey(b"app", &dirA, b"@tests")
  run Testing.expect(
    !same(scopeA.asSlice(), scopeB.asSlice()) && !same(scopeA.asSlice(), scopeTasks.asSlice())
      && !same(scopeA.asSlice(), scopeTests.asSlice())
      && !same(scopeTasks.asSlice(), scopeTests.asSlice()),
    "scopeKey isolates packages with the same name in different directories and variants",
  )

  let base = run Path.make("/cache/v1/objects")
  let sharded = run CacheLayout.shardedPath(&base, b"ab123456.o")
  let shortPath = run CacheLayout.shardedPath(&base, b"x")
  run Testing.expect(
    same(Path.rawBytes(&sharded), b"/cache/v1/objects/ab/ab123456.o")
      && same(Path.rawBytes(&shortPath), b"/cache/v1/objects/x"),
    "shardedPath places hex names under two-character shard subdirectories",
  )
}

effect fn resolutionCases(root: &Path) -> ()
  ! AssertionError<'static> | FileError | HostInputError | InvalidCacheOption | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let silkHome = run Path.join(root, "silk-home")
  let settings = run Path.join(&silkHome, "settings.toml")
  let working = run Path.join(root, "work")
  run FileSystem.createDirectoriesRecursively(&silkHome)
  run FileSystem.createDirectoriesRecursively(&working)

  // 1. Default without settings.toml: shared under $SILK_HOME/cache/v1.
  let mut host = FakeHost.empty()
  host.silkHome = Option<Bytes>.some(run Bytes.copy(Path.rawBytes(&silkHome)))
  let expectedDefault = run Path.join(&silkHome, "cache/v1")
  let defaultPolicy = run CacheLayout.resolve(&working, &CacheLayout.noSelection())
    |> Effect.provideMut<HostInput>(&mut host)
  run Testing.expect(
    isSharedMode(defaultPolicy.mode) && rootMatches(&defaultPolicy, Path.rawBytes(&expectedDefault))
      && defaultPolicy.maxBytes == CacheLayout.DEFAULT_MAX_BYTES
      && defaultPolicy.maxAgeDays == CacheLayout.DEFAULT_MAX_AGE_DAYS
      && defaultPolicy.keptCompilers == CacheLayout.DEFAULT_SHARED_COMPILERS,
    "default resolves to shared mode under $SILK_HOME/cache/v1 with default limits",
  )

  // 2. Fallback to workspace mode when no home directory is available.
  let mut noHome = FakeHost.empty()
  let fallback = run CacheLayout.resolve(&working, &CacheLayout.noSelection())
    |> Effect.provideMut<HostInput>(&mut noHome)
  run Testing.expect(
    !isSharedMode(fallback.mode) && fallback.sharedRoot.isNone(),
    "without SILK_HOME or HOME, cache mode falls back to workspace",
  )

  // 3. settings.toml [cache] overrides defaults.
  let customSettingsDir = run Path.join(root, "from-settings")
  let mut toml = run Bytes.copy(b"[cache]\nmode = \"workspace\"\ndir = \"")
  run Bytes.append(&mut toml, Path.rawBytes(&customSettingsDir))
  run Bytes.append(&mut toml, b"\"\nmax-size = \"2G\"\nmax-age-days = 14\nkept-compilers = 7\n")
  run FileSystem.writeFile(&settings, toml.asSlice())
  let fromSettings = run CacheLayout.resolve(&working, &CacheLayout.noSelection())
    |> Effect.provideMut<HostInput>(&mut host)
  run Testing.expect(
    !isSharedMode(fromSettings.mode) && fromSettings.maxBytes == 2147483648
      && fromSettings.maxAgeDays == 14
      && fromSettings.keptCompilers == 7,
    "settings.toml [cache] overrides mode and limits",
  )

  // 4. Environment overrides settings.toml.
  let envDir = run Path.join(root, "from-env")
  let envExpected = run Path.join(&envDir, "v1")
  host.cacheDir = Option<Bytes>.some(run Bytes.copy(Path.rawBytes(&envDir)))
  host.maxSize = Option<Bytes>.some(run Bytes.copy(b"512M"))
  host.maxAgeDays = Option<Bytes>.some(run Bytes.copy(b"7"))
  let fromEnv = run CacheLayout.resolve(&working, &CacheLayout.noSelection())
    |> Effect.provideMut<HostInput>(&mut host)
  run Testing.expect(
    isSharedMode(fromEnv.mode) && rootMatches(&fromEnv, Path.rawBytes(&envExpected))
      && fromEnv.maxBytes == 536870912
      && fromEnv.maxAgeDays == 7,
    "SILK_CACHE_DIR implies shared mode and env limits override settings.toml",
  )

  // 5. SILK_CACHE_MODE=workspace overrides SILK_CACHE_DIR, while CLI --cache-dir overrides env.
  host.cacheMode = Option<Bytes>.some(run Bytes.copy(b"workspace"))
  let envWorkspace = run CacheLayout.resolve(&working, &CacheLayout.noSelection())
    |> Effect.provideMut<HostInput>(&mut host)
  run Testing.expect(
    !isSharedMode(envWorkspace.mode),
    "SILK_CACHE_MODE=workspace overrides SILK_CACHE_DIR",
  )

  let cliDir = run Path.join(root, "from-cli")
  let cliExpected = run Path.join(&cliDir, "v1")
  let cliSelection = CacheSelection {
    mode: Option<Bytes>.none(),
    dir: Option<Bytes>.some(run Bytes.copy(Path.rawBytes(&cliDir))),
  }
  let fromCli = run CacheLayout.resolve(&working, &cliSelection)
    |> Effect.provideMut<HostInput>(&mut host)
  run Testing.expect(
    isSharedMode(fromCli.mode) && rootMatches(&fromCli, Path.rawBytes(&cliExpected)),
    "CLI --cache-dir overrides SILK_CACHE_MODE=workspace",
  )

  // 6. Conflicting --cache-mode workspace and --cache-dir is rejected.
  let conflict = CacheSelection {
    mode: Option<Bytes>.some(run Bytes.copy(b"workspace")),
    dir: Option<Bytes>.some(run Bytes.copy(Path.rawBytes(&cliDir))),
  }
  let rejectedConflict = match move run Effect.result(
    CacheLayout.resolve(&working, &conflict) |> Effect.provideMut<HostInput>(&mut host),
  ) {
    Result<CachePolicy, InvalidCacheOption | HostInputError | OutOfMemoryError>.Success {
      ..
    } => false
    Result<CachePolicy, InvalidCacheOption | HostInputError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      InvalidCacheOption _bad => true
      HostInputError failed => {
        fail move failed
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  run Testing.expect(rejectedConflict, "--cache-mode workspace with --cache-dir is refused")

  // 7. Unknown --cache-mode is rejected.
  let invalidMode = CacheSelection {
    mode: Option<Bytes>.some(run Bytes.copy(b"global")),
    dir: Option<Bytes>.none(),
  }
  let rejectedMode = match move run Effect.result(
    CacheLayout.resolve(&working, &invalidMode) |> Effect.provideMut<HostInput>(&mut host),
  ) {
    Result<CachePolicy, InvalidCacheOption | HostInputError | OutOfMemoryError>.Success {
      ..
    } => false
    Result<CachePolicy, InvalidCacheOption | HostInputError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      InvalidCacheOption _bad => true
      HostInputError failed => {
        fail move failed
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  run Testing.expect(rejectedMode, "unknown --cache-mode value is refused")
}

effect fn exercise() -> ()
  ! AssertionError<'static> | FileError | HostInputError | InvalidCacheOption | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  run sizeAndPathCases()
  let parent = run Path.make(temporaryParent())
  let temporary = run FileSystem.temporaryDirectory(&parent, "silk-cache-layout-case")
  return run Effect.ensuring(resolutionCases(&temporary.path), cleanup(&temporary.path))
}

test effect fn cacheLayoutPrecedenceAndHelpers() -> ()
  ! AssertionError<'static> | FileError | HostInputError | InvalidCacheOption | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make("/") |> Effect.provideMut<Allocator>(&mut allocator)
  return run exercise()
    |> Effect.provideMut<FileSystem>(&mut files)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
