//! The direct backend's code cache: every body a build translated, by the content hash of the
//! fragment that defines it, so the next build translates only the fragments that changed.
//!
//! # Details
//! A translated body depends on nothing but its fragment (`WasmCode.translate` leaves every
//! placement to a relocation), so equal fragment bytes give an equal translation. The cache is
//! the file `code` in the output's cache directory (`CodegenCache.directoryFor`), written whole
//! after each link that changed what it holds. It starts
//! with the compiler's identity: a file another compiler wrote is ignored, as is one that does not
//! decode.

import backend.WasmCode {Relocation, RelocationKind, Translated}
import backend.WasmModule
import semantic.ContentHash {ContentHash}
import semantic.InternIndex {InternIndex}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.ownership {Copy}
import silk.collections.slice {Slice}
import silk.num.u64
import silk.num.u8
import silk.num.usize

fn magic() -> &'static [u8] { return b"silk-wasm-code-1" }

/// The bodies one fragment defines: `count` of them from `first` in the cache's bodies.
struct Entry {
  hash: ContentHash,
  first: usize,
  count: usize,
}

impl Copy for Entry {}

/// The translated bodies of one build, by fragment.
pub struct CodeCache {
  entries: List<Entry>,
  bodies: List<Translated>,
  lookup: InternIndex,
}

impl CodeCache {
  /// A cache holding nothing.
  pub fn make() -> CodeCache {
    return CodeCache {entries: List<Entry>.make(), bodies: List<Translated>.make(), lookup: InternIndex.make()}
  }

  /// The number of fragments the cache holds.
  pub fn fragments(self: &Self) -> usize { return List<Entry>.length(&self.entries) }

  /// The position of the fragment hashed `hash`, or `usize.MAX`.
  pub fn find(self: &Self, hash: ContentHash) -> usize {
    let mut at = InternIndex.first(&self.lookup, hash.low)
    while at != usize.MAX {
      if ContentHash.equals(List<Entry>.get(&self.entries, at).hash, hash) { return at }
      at = InternIndex.after(&self.lookup, at)
    }
    return usize.MAX
  }

  /// The bodies of the fragment at `position`.
  pub fn bodiesOf(self: &Self, position: usize) -> &[Translated] {
    let entry = List<Entry>.get(&self.entries, position)
    return Slice.view<Translated>(List<Translated>.asSlice(&self.bodies), entry.first, entry.count)
  }

  /// Every body, in fragment order.
  pub fn allBodies(self: &Self) -> &[Translated] { return List<Translated>.asSlice(&self.bodies) }

  /// Starts the fragment hashed `hash`: the bodies appended until the next start are its own.
  pub effect fn start(self: &mut Self, hash: ContentHash) -> () ! OutOfMemoryError ? &mut Allocator {
    run List<Entry>.append(&mut self.entries, Entry {hash: hash, first: List<Translated>.length(&self.bodies), count: usize.ZERO})
    return run InternIndex.record(&mut self.lookup, hash.low)
  }

  /// Appends a body of the fragment started last.
  pub effect fn append(self: &mut Self, body: Translated) -> () ! OutOfMemoryError ? &mut Allocator {
    run List<Translated>.append(&mut self.bodies, move body)
    let last = List<Entry>.length(&self.entries) - usize.ONE
    let mut entry = List<Entry>.get(&self.entries, last)
    entry.count = entry.count + usize.ONE
    List<Entry>.set(&mut self.entries, last, entry)
    return ()
  }

  /// The cache file's bytes, for the compiler `identity`.
  pub effect fn encode(self: &Self, identity: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut out = run Bytes.copy(magic())
    run WasmModule.name(&mut out, identity)
    let entries = List<Entry>.asSlice(&self.entries)
    run WasmModule.index(&mut out, entries.length)
    let bodies = List<Translated>.asSlice(&self.bodies)
    let mut at = usize.ZERO
    while at < entries.length {
      run WasmModule.littleEndian(&mut out, entries[at].hash.high, 8)
      run WasmModule.littleEndian(&mut out, entries[at].hash.low, 8)
      run WasmModule.index(&mut out, entries[at].count)
      let mut body = entries[at].first
      while body < entries[at].first + entries[at].count {
        run encodeBody(&mut out, &bodies[body])
        body = body + usize.ONE
      }
      at = at + usize.ONE
    }
    return move out
  }

  /// The cache `bytes` hold for the compiler `identity`, or an empty one when they hold none.
  pub effect fn decode(bytes: &[u8], identity: &[u8]) -> CodeCache ! OutOfMemoryError ? &mut Allocator {
    let mut cache = CodeCache.make()
    let header = magic()
    if bytes.length < header.length || !same(Slice.view<u8>(bytes, usize.ZERO, header.length), header) { return move cache }
    let mut at = header.length
    let written = readName(bytes, &mut at)
    if at > bytes.length || !same(written, identity) { return move cache }
    let entries = readCount(bytes, &mut at)
    let mut entry = usize.ZERO
    while entry < entries && at <= bytes.length {
      let high = readWord(bytes, &mut at)
      let low = readWord(bytes, &mut at)
      let count = readCount(bytes, &mut at)
      run CodeCache.start(&mut cache, ContentHash {high: high, low: low})
      let mut body = usize.ZERO
      while body < count && at <= bytes.length {
        run CodeCache.append(&mut cache, run decodeBody(bytes, &mut at))
        body = body + usize.ONE
      }
      if at > bytes.length { return CodeCache.make() }
      entry = entry + usize.ONE
    }
    if at != bytes.length { return CodeCache.make() }
    return move cache
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

// The readers below leave `at` past the end of `bytes` once they run out, and answer zero.

fn readUnsigned(bytes: &[u8], at: &mut usize) -> u64 {
  let mut value: u64 = 0
  let mut shift: u64 = 0
  while at.* < bytes.length && shift < 64 {
    let byte = bytes[at.*]
    at.* = at.* + usize.ONE
    value = value | u64.shiftLeft(u8.toU64(byte & 127), shift)
    if (byte & 128) == 0 { return value }
    shift = shift + 7
  }
  at.* = bytes.length + usize.ONE
  return 0
}

// A count or index, which cannot exceed the bytes left.
fn readCount(bytes: &[u8], at: &mut usize) -> usize {
  let value = readUnsigned(bytes, &mut at.*)
  if at.* > bytes.length || value > usize.toU64(bytes.length) {
    at.* = bytes.length + usize.ONE
    return usize.ZERO
  }
  return u64.toUsize(value)
}

fn readWord(bytes: &[u8], at: &mut usize) -> u64 {
  if at.* > bytes.length || bytes.length - at.* < 8 {
    at.* = bytes.length + usize.ONE
    return 0
  }
  let mut value: u64 = 0
  let mut index: usize = 8
  while index > usize.ZERO {
    index = index - usize.ONE
    value = u64.shiftLeft(value, 8) | u8.toU64(bytes[at.* + index])
  }
  at.* = at.* + 8
  return value
}

fn readName<'a>(bytes: &'a [u8], at: &mut usize) -> &'a [u8] {
  let length = readCount(bytes, &mut at.*)
  if at.* > bytes.length || bytes.length - at.* < length {
    at.* = bytes.length + usize.ONE
    return Slice.view<u8>(bytes, usize.ZERO, usize.ZERO)
  }
  let name = Slice.view<u8>(bytes, at.*, length)
  at.* = at.* + length
  return name
}

effect fn readNames(bytes: &[u8], at: &mut usize) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let count = readCount(bytes, &mut at.*)
  let mut names = run List<Bytes>.makeWithCapacity(count)
  let mut index = usize.ZERO
  while index < count && at.* <= bytes.length {
    run List<Bytes>.append(&mut names, run Bytes.copy(readName(bytes, &mut at.*)))
    index = index + usize.ONE
  }
  return move names
}

effect fn decodeBody(bytes: &[u8], at: &mut usize) -> Translated ! OutOfMemoryError ? &mut Allocator {
  let symbol = run Bytes.copy(readName(bytes, &mut at.*))
  let signature = readCount(bytes, &mut at.*)
  let entry = run Bytes.copy(readName(bytes, &mut at.*))
  let count = readCount(bytes, &mut at.*)
  let mut relocations = run List<Relocation>.makeWithCapacity(count)
  let mut index = usize.ZERO
  while index < count && at.* <= bytes.length {
    let offset = readCount(bytes, &mut at.*)
    let code = readUnsigned(bytes, &mut at.*)
    let target = readCount(bytes, &mut at.*)
    let addend = readUnsigned(bytes, &mut at.*)
    let mut kind = RelocationKind.Call
    if code == 1 { kind = RelocationKind.Signature }
    else if code == 2 { kind = RelocationKind.Address }
    else if code == 3 { kind = RelocationKind.WideAddress }
    else if code != 0 { at.* = bytes.length + usize.ONE }
    run List<Relocation>.append(&mut relocations, Relocation {offset: offset, kind: kind, target: target, addend: addend})
    index = index + usize.ONE
  }
  let symbols = run readNames(bytes, &mut at.*)
  let signatures = run readNames(bytes, &mut at.*)
  let places = readCount(bytes, &mut at.*)
  let mut locations = run List<u64>.makeWithCapacity(places)
  index = usize.ZERO
  while index < places && at.* <= bytes.length {
    run List<u64>.append(&mut locations, readUnsigned(bytes, &mut at.*))
    index = index + usize.ONE
  }
  let decoded = Translated {symbol: move symbol, signature: signature, entry: move entry, relocations: move relocations,
    symbols: move symbols, signatures: move signatures, locations: move locations}
  // A relocation must name what the body lists, inside its entry, in order.
  if at.* <= bytes.length && !valid(&decoded) { at.* = bytes.length + usize.ONE }
  return move decoded
}

// Whether `body`'s indices stay inside what it lists, so the link can trust a decoded body.
fn valid(body: &Translated) -> bool {
  if body.signature >= List<Bytes>.length(&body.signatures) { return false }
  let relocations = List<Relocation>.asSlice(&body.relocations)
  let mut previous = usize.ZERO
  let mut at = usize.ZERO
  while at < relocations.length {
    let relocation = relocations[at]
    if relocation.offset < previous || relocation.offset > Bytes.length(&body.entry) { return false }
    let mut limit = List<Bytes>.length(&body.symbols)
    if let RelocationKind.Signature = relocation.kind { limit = List<Bytes>.length(&body.signatures) }
    if relocation.target >= limit { return false }
    previous = relocation.offset
    at = at + usize.ONE
  }
  // Locations come in pairs, by offset, inside the entry.
  let locations = List<u64>.asSlice(&body.locations)
  if locations.length % 2 != usize.ZERO { return false }
  let mut last: u64 = 0
  at = usize.ZERO
  while at < locations.length {
    if locations[at] < last || locations[at] > usize.toU64(Bytes.length(&body.entry)) { return false }
    last = locations[at]
    at = at + 2
  }
  return true
}

// One body: its symbol, signature, entry, relocations, symbols and signatures.
effect fn encodeBody(out: &mut Bytes, body: &Translated) -> () ! OutOfMemoryError ? &mut Allocator {
  run WasmModule.name(&mut out.*, Bytes.asSlice(&body.symbol))
  run WasmModule.index(&mut out.*, body.signature)
  run WasmModule.name(&mut out.*, Bytes.asSlice(&body.entry))
  let relocations = List<Relocation>.asSlice(&body.relocations)
  run WasmModule.index(&mut out.*, relocations.length)
  let mut at = usize.ZERO
  while at < relocations.length {
    run WasmModule.index(&mut out.*, relocations[at].offset)
    run WasmModule.byte(&mut out.*, kindCode(relocations[at].kind))
    run WasmModule.index(&mut out.*, relocations[at].target)
    run WasmModule.unsigned(&mut out.*, relocations[at].addend)
    at = at + usize.ONE
  }
  run encodeNames(&mut out.*, List<Bytes>.asSlice(&body.symbols))
  run encodeNames(&mut out.*, List<Bytes>.asSlice(&body.signatures))
  let locations = List<u64>.asSlice(&body.locations)
  run WasmModule.index(&mut out.*, locations.length)
  at = usize.ZERO
  while at < locations.length {
    run WasmModule.unsigned(&mut out.*, locations[at])
    at = at + usize.ONE
  }
  return ()
}

effect fn encodeNames(out: &mut Bytes, names: &[Bytes]) -> () ! OutOfMemoryError ? &mut Allocator {
  run WasmModule.index(&mut out.*, names.length)
  let mut at = usize.ZERO
  while at < names.length {
    run WasmModule.name(&mut out.*, Bytes.asSlice(&names[at]))
    at = at + usize.ONE
  }
  return ()
}

fn kindCode(kind: RelocationKind) -> u8 {
  return match kind {
    RelocationKind.Call => 0
    RelocationKind.Signature => 1
    RelocationKind.Address => 2
    RelocationKind.WideAddress => 3
  }
}

/// A copy of `body`.
pub effect fn copy(body: &Translated) -> Translated ! OutOfMemoryError ? &mut Allocator {
  let mut relocations = run List<Relocation>.makeWithCapacity(List<Relocation>.length(&body.relocations))
  run List<Relocation>.appendSlice(&mut relocations, List<Relocation>.asSlice(&body.relocations))
  return Translated {symbol: run Bytes.copy(Bytes.asSlice(&body.symbol)), signature: body.signature,
    entry: run Bytes.copy(Bytes.asSlice(&body.entry)), relocations: move relocations,
    symbols: run copyNames(List<Bytes>.asSlice(&body.symbols)), signatures: run copyNames(List<Bytes>.asSlice(&body.signatures)),
    locations: run copyWords(List<u64>.asSlice(&body.locations))}
}

effect fn copyWords(words: &[u64]) -> List<u64> ! OutOfMemoryError ? &mut Allocator {
  let mut copies = run List<u64>.makeWithCapacity(words.length)
  run List<u64>.appendSlice(&mut copies, words)
  return move copies
}

effect fn copyNames(names: &[Bytes]) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut copies = run List<Bytes>.makeWithCapacity(names.length)
  let mut at = usize.ZERO
  while at < names.length {
    run List<Bytes>.append(&mut copies, run Bytes.copy(Bytes.asSlice(&names[at])))
    at = at + usize.ONE
  }
  return move copies
}
