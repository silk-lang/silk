//! Installed Silk toolchains, and which one a command started in a directory runs.
//!
//! Toolchains live in `$SILK_HOME/toolchains/<version>` (`SILK_HOME` defaults to `~/.silk`), each
//! laid out as its release archive unpacks: `bin/silk` beside `lib/silk/stdlib`. A project pins one
//! with `silk-version`: `[workspace].silk-version` covers the workspace and its members, otherwise
//! the nearest manifest's `[package].silk-version` applies. `0.0.0`, the version of a compiler
//! built from source, pins nothing.
//!
//! The first of these selects the version: `silk +<version>`, `SILK_TOOLCHAIN`, the project's pin,
//! `default` in `$SILK_HOME/settings.toml`, and the running compiler.

import driver.Project as Projects { ProjectError }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.filesystem { DirectoryEntry, DirectoryInfo, FileError, FileInfo, FileSystem, Path }
import silk.host_input { HostInput, HostInputError }
import silk.list { List }
import silk.option { Option }
import silk.result { Result }
import silk.slice { Slice }
import silk.string { String }
import silk.toml_scanner { TomlError }
import silk.toml_value { Toml, Value as TomlValue }
import silk.u8
import silk.usize

/// Where the selected version came from.
pub enum Origin {
  /// `silk +<version>` on the command line.
  CommandLine,
  /// The `SILK_TOOLCHAIN` environment variable.
  Environment,
  /// `[workspace].silk-version` of the enclosing workspace.
  Workspace,
  /// `[package].silk-version` of the nearest manifest.
  Package,
  /// `default` in `$SILK_HOME/settings.toml`.
  Default,
  /// Nothing else selected a version, so the running compiler runs.
  Running,
}

/// The version a command runs with, and why.
pub struct Selection {
  pub version: Bytes
  pub origin: Origin

  /// The manifest that pins the version, for `Workspace` and `Package`.
  pub manifest: Option<Path>
}

/// The spelling of `origin` in messages and JSON.
pub fn originName(origin: Origin) -> &'static [u8] {
  return match origin {
    Origin.CommandLine => b"command-line"
    Origin.Environment => b"environment"
    Origin.Workspace => b"workspace"
    Origin.Package => b"package"
    Origin.Default => b"default"
    Origin.Running => b"running"
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// The length of `version` before its `+` build metadata.
fn coreLength(version: &[u8]) -> usize {
  let mut at = usize.ZERO
  while at < version.length && version[at] != 43 {
    at = at + usize.ONE
  }
  return at
}

/// Whether `version` pins nothing: `0.0.0`, the version of a compiler built from source, with or
/// without build metadata.
pub fn unpinned(version: &[u8]) -> bool {
  return same(Slice.view<u8>(version, usize.ZERO, coreLength(version)), b"0.0.0")
}

/// Whether the pin `requested` names the toolchain `installed`: the same version, or, when
/// `requested` has no build metadata, the same version before `installed`'s.
pub fn matches(requested: &[u8], installed: &[u8]) -> bool {
  if same(requested, installed) {
    return true
  }
  let core = coreLength(requested)
  if core != requested.length {
    return false
  }
  return core == coreLength(installed)
    && same(requested, Slice.view<u8>(installed, usize.ZERO, core))
}

// Compares two dot-separated pre-release identifier lists by SemVer precedence.
fn comparePrerelease(left: &[u8], right: &[u8]) -> i32 {
  let mut l = usize.ZERO
  let mut r = usize.ZERO
  while l < left.length && r < right.length {
    let mut le = l
    while le < left.length && left[le] != 46 {
      le = le + usize.ONE
    }
    let mut re = r
    while re < right.length && right[re] != 46 {
      re = re + usize.ONE
    }
    let order = compareIdentifier(Slice.view<u8>(left, l, le - l), Slice.view<u8>(right, r, re - r))
    if order != 0 {
      return order
    }
    l = le + usize.ONE
    r = re + usize.ONE
  }
  if l < left.length {
    return 1
  }
  if r < right.length {
    return -1
  }
  return 0
}

fn numeric(identifier: &[u8]) -> bool {
  if identifier.length == usize.ZERO {
    return false
  }
  let mut at = usize.ZERO
  while at < identifier.length {
    if identifier[at] < 48 || identifier[at] > 57 {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Numeric identifiers compare by value (shorter is smaller, as there are no leading zeros) and
// sort before alphanumeric ones, which compare by bytes.
fn compareIdentifier(left: &[u8], right: &[u8]) -> i32 {
  let leftNumeric = numeric(left)
  let rightNumeric = numeric(right)
  if leftNumeric && !rightNumeric {
    return -1
  }
  if rightNumeric && !leftNumeric {
    return 1
  }
  if leftNumeric && left.length != right.length {
    if left.length < right.length {
      return -1
    }
    return 1
  }
  let mut at = usize.ZERO
  while at < left.length && at < right.length {
    if left[at] != right[at] {
      if left[at] < right[at] {
        return -1
      }
      return 1
    }
    at = at + usize.ONE
  }
  if left.length < right.length {
    return -1
  }
  if left.length > right.length {
    return 1
  }
  return 0
}

/// Compares two semantic versions by precedence: negative, zero or positive. Build metadata is
/// ignored.
pub fn compare(left: &[u8], right: &[u8]) -> i32 {
  let leftCore = Slice.view<u8>(left, usize.ZERO, coreLength(left))
  let rightCore = Slice.view<u8>(right, usize.ZERO, coreLength(right))
  let mut leftDash = usize.ZERO
  while leftDash < leftCore.length && leftCore[leftDash] != 45 {
    leftDash = leftDash + usize.ONE
  }
  let mut rightDash = usize.ZERO
  while rightDash < rightCore.length && rightCore[rightDash] != 45 {
    rightDash = rightDash + usize.ONE
  }
  let order = comparePrerelease(
    Slice.view<u8>(leftCore, usize.ZERO, leftDash),
    Slice.view<u8>(rightCore, usize.ZERO, rightDash)
  )
  if order != 0 {
    return order
  }
  let leftPre = leftDash < leftCore.length
  let rightPre = rightDash < rightCore.length
  if leftPre && !rightPre {
    return -1
  }
  if rightPre && !leftPre {
    return 1
  }
  if !leftPre {
    return 0
  }
  return comparePrerelease(
    Slice.view<u8>(leftCore, leftDash + usize.ONE, leftCore.length - leftDash - usize.ONE),
    Slice.view<u8>(rightCore, rightDash + usize.ONE, rightCore.length - rightDash - usize.ONE),
  )
}

/// `$SILK_HOME`, or `$HOME/.silk`; `None` when neither names an absolute directory.
pub effect fn home() -> Option<Path>
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let mut chosen = run HostInput.variableNamed("SILK_HOME")
  let mut suffix = false
  if let Option<Bytes>.None = &chosen {
    chosen = run HostInput.variableNamed("HOME")
    suffix = true
  }
  let mut text = match move chosen {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return Option<Path>.none()
    }
  }
  let written = Bytes.asSlice(&text)
  if written.length == usize.ZERO || written[usize.ZERO] != 47 {
    return Option<Path>.none()
  }

  // A trailing separator would make an empty component.
  let mut end = written.length
  while end > usize.ONE && written[end - usize.ONE] == 47 {
    end = end - usize.ONE
  }
  let mut trimmed = run Bytes.copy(Slice.view<u8>(written, usize.ZERO, end))
  if suffix {
    if end > usize.ONE {
      run Bytes.append(&mut trimmed, b"/")
    }
    run Bytes.append(&mut trimmed, b".silk")
  }
  drop text
  return match move run Effect.result(Path.fromBytes(Bytes.asSlice(&trimmed))) {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => Option<Path>.some(move value)
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError invalid => {
        drop invalid
        return Option<Path>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

/// The directory that holds the toolchain named `name` below `home`.
pub effect fn directory(home: &Path, name: &[u8]) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let toolchains = run Path.join(home, "toolchains")
  return run Path.joinBytes(&toolchains, name)
}

/// The compiler executable of the toolchain named `name` below `home`.
pub effect fn executable(home: &Path, name: &[u8]) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let root = run directory(home, name)
  let bin = run Path.join(&root, "bin")
  return run Path.join(&bin, "silk")
}

effect fn isFile(path: &Path) -> bool
  ! OutOfMemoryError
  ? &mut FileSystem {
  return match move run Effect.result(FileSystem.stat(path)) {
    Result<FileInfo | DirectoryInfo, FileError>.Success { value } => match move value {
      FileInfo file => true
      DirectoryInfo folder => false
    }
    Result<FileInfo | DirectoryInfo, FileError>.Failure { error } => {
      drop error
      return false
    }
  }
}

/// The names of the toolchains installed below `home`, newest version first. A directory counts
/// when its name is a semantic version and it holds `bin/silk`; temporary install directories
/// start with `.` and never count.
pub effect fn installed(home: &Path) -> List<Bytes>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut names = List<Bytes>.make()
  let toolchains = run Path.join(home, "toolchains")
  let listed = match move run Effect.result(FileSystem.listDirectory(&toolchains)) {
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success { value } => move value
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      FileError missing => {
        drop missing
        return move names
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let entries = List<DirectoryEntry>.asSlice(&listed)
  let mut at = usize.ZERO
  while at < entries.length {
    let path = Path.rawBytes(&entries[at].path)
    let mut start = path.length
    while start > usize.ZERO && path[start - usize.ONE] != 47 {
      start = start - usize.ONE
    }
    let name = Slice.view<u8>(path, start, path.length - start)
    if Projects.isSemanticVersion(name) {
      let compiler = run executable(home, name)
      if run isFile(&compiler) {
        // Insert newest first.
        let mut position = usize.ZERO
        let sorted = List<Bytes>.asSlice(&names)
        while position < sorted.length && compare(Bytes.asSlice(&sorted[position]), name) >= 0 {
          position = position + usize.ONE
        }
        run List<Bytes>.insert(&mut names, position, run Bytes.copy(name))
      }
    }
    at = at + usize.ONE
  }
  return move names
}

/// The installed toolchain the pin `version` names, if any.
pub effect fn find(home: &Path, version: &[u8]) -> Option<Bytes>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let names = run installed(home)
  let listed = List<Bytes>.asSlice(&names)
  let mut at = usize.ZERO
  while at < listed.length {
    if matches(version, Bytes.asSlice(&listed[at])) {
      return Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&listed[at])))
    }
    at = at + usize.ONE
  }
  return Option<Bytes>.none()
}

/// The parsed `$SILK_HOME/settings.toml`, or `None` when it is missing or not TOML.
effect fn settings(home: &Path) -> Option<TomlValue>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let path = run Path.join(home, "settings.toml")
  let text = match move run Effect.result(FileSystem.readFile(&path)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError missing => {
        drop missing
        return Option<TomlValue>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  return match move run Effect.result(Toml.parse(Bytes.asSlice(&text))) {
    Result<TomlValue, TomlError | OutOfMemoryError>.Success { value } => Option<TomlValue>.some(
      move value
    )
    Result<TomlValue, TomlError | OutOfMemoryError>.Failure { error } => match move error {
      TomlError invalid => {
        drop invalid
        return Option<TomlValue>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

/// `default` in `$SILK_HOME/settings.toml`, when it is a semantic version.
pub effect fn defaultVersion(home: &Path) -> Option<Bytes>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let document = match move run settings(home) {
    Option<TomlValue>.Some { value } => move value
    Option<TomlValue>.None => {
      return Option<Bytes>.none()
    }
  }
  return match move Toml.asString(Toml.field(&document, "default")) {
    Option<string>.Some { value } => {
      let written = String.utf8Bytes(value)
      if !Projects.isSemanticVersion(written) {
        return Option<Bytes>.none()
      }
      return Option<Bytes>.some(run Bytes.copy(written))
    }
    Option<string>.None => Option<Bytes>.none()
  }
}

/// Whether `auto-install = true` is in `$SILK_HOME/settings.toml`.
pub effect fn autoInstall(home: &Path) -> bool
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let document = match move run settings(home) {
    Option<TomlValue>.Some { value } => move value
    Option<TomlValue>.None => {
      return false
    }
  }
  return match move Toml.field(&document, "auto-install") {
    Option<&TomlValue>.Some { value } => match &value.* {
      TomlValue.Boolean { value: enabled } => enabled
      _ => false
    }
    Option<&TomlValue>.None => false
  }
}

/// Writes `default = "<version>"` to `$SILK_HOME/settings.toml`, keeping `auto-install`.
pub effect fn setDefault(home: &Path, version: &[u8]) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let automatic = run autoInstall(home)
  let mut text = run Bytes.copy(b"# Written by `silk toolchain default`.\ndefault = \"")
  run Bytes.append(&mut text, version)
  run Bytes.append(&mut text, b"\"\n")
  if automatic {
    run Bytes.append(&mut text, b"auto-install = true\n")
  }
  let path = run Path.join(home, "settings.toml")
  run FileSystem.writeFileWithParents(&path, Bytes.asSlice(&text))
}

// The `silk-version` string of `table` when it is present and a semantic version.
effect fn versionIn(table: Option<&TomlValue>) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move Toml.asString(Toml.fieldAt(move table, "silk-version")) {
    Option<string>.Some { value } => {
      let written = String.utf8Bytes(value)
      if !Projects.isSemanticVersion(written) {
        return Option<Bytes>.none()
      }
      return Option<Bytes>.some(run Bytes.copy(written))
    }
    Option<string>.None => Option<Bytes>.none()
  }
}

// Parses `manifest`, or `None` when it cannot be read or parsed: the compiler that runs will then
// report the problem itself.
effect fn document(manifest: &Path) -> Option<TomlValue>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  return match move run Effect.result(Projects.parsed(manifest)) {
    Result<TomlValue, ProjectError | OutOfMemoryError>.Success { value } => Option<TomlValue>.some(
      move value
    )
    Result<TomlValue, ProjectError | OutOfMemoryError>.Failure { error } => match move error {
      ProjectError unusable => {
        drop unusable
        return Option<TomlValue>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

/// The pin of the project around `start`, if it has one other than `0.0.0`.
///
/// The nearest manifest at or above `start` decides. When a workspace at or above it pins a
/// version and lists it (or is it), the workspace's pin wins; otherwise the manifest's own
/// `[package].silk-version` applies.
pub effect fn pinned(start: &Path) -> Option<Selection>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let nearest = match move run Effect.result(Projects.discover(start)) {
    Result<Path, ProjectError | FileError | OutOfMemoryError>.Success { value } => move value
    Result<Path, ProjectError | FileError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      ProjectError absent => {
        drop absent
        return Option<Selection>.none()
      }
      FileError unreadable => {
        drop unreadable
        return Option<Selection>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let directory = match move run Path.parent(&nearest) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return Option<Selection>.none()
    }
  }
  let mut enclosing = Option<Path>.none()
  match move run Effect.result(Projects.enclosingWorkspace(&directory)) {
    Result<Option<Path>, FileError | OutOfMemoryError>.Success { value } => {
      enclosing = move value
    }
    Result<Option<Path>, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError unreadable => {
        drop unreadable
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  if let Option<Path>.Some { value: workspace } = move enclosing {
    if let Option<TomlValue>.Some { value: parsed } = move run document(&workspace) {
      if let Option<Bytes>.Some { value: version } = move run versionIn(
        Toml.field(&parsed, "workspace")
      ) {
        let covers = same(Path.rawBytes(&workspace), Path.rawBytes(&nearest))
          || run listed(&workspace, &directory)
        if covers && !unpinned(Bytes.asSlice(&version)) {
          return Option<Selection>.some(
            Selection {
              version: move version,
              origin: Origin.Workspace,
              manifest: Option<Path>.some(move workspace),
            }
          )
        }
      }
    }
  }
  let parsed = match move run document(&nearest) {
    Option<TomlValue>.Some { value } => move value
    Option<TomlValue>.None => {
      return Option<Selection>.none()
    }
  }
  return match move run versionIn(Toml.field(&parsed, "package")) {
    Option<Bytes>.Some { value } => {
      if unpinned(Bytes.asSlice(&value)) {
        return Option<Selection>.none()
      }
      return Option<Selection>.some(
        Selection {
          version: move value,
          origin: Origin.Package,
          manifest: Option<Path>.some(move nearest),
        }
      )
    }
    Option<Bytes>.None => Option<Selection>.none()
  }
}

// Whether the workspace at `manifest` lists the member at `member`; an unreadable workspace lists
// nothing.
effect fn listed(manifest: &Path, member: &Path) -> bool
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  return match move run Effect.result(Projects.listsMember(manifest, member)) {
    Result<bool, ProjectError | FileError | OutOfMemoryError>.Success { value } => value
    Result<bool, ProjectError | FileError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      ProjectError unusable => {
        drop unusable
        return false
      }
      FileError unreadable => {
        drop unreadable
        return false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

/// Selects the version for a command started in `start`, by the rules in the module comment.
/// `requested` is a `+<version>` argument and `environment` the `SILK_TOOLCHAIN` value; `running`
/// is the running compiler's version.
pub effect fn select(
  start: &Path,
  requested: Option<&[u8]>,
  environment: Option<&[u8]>,
  home: Option<&Path>,
  running: &[u8]
) -> Selection
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if let Option<&[u8]>.Some { value } = move requested {
    return Selection {
      version: run Bytes.copy(value),
      origin: Origin.CommandLine,
      manifest: Option<Path>.none()
    }
  }
  if let Option<&[u8]>.Some { value } = move environment {
    if value.length > usize.ZERO {
      return Selection {
        version: run Bytes.copy(value),
        origin: Origin.Environment,
        manifest: Option<Path>.none()
      }
    }
  }
  if let Option<Selection>.Some { value } = move run pinned(start) {
    return move value
  }
  if let Option<&Path>.Some { value: root } = move home {
    if let Option<Bytes>.Some { value } = move run defaultVersion(root) {
      return Selection {
        version: move value,
        origin: Origin.Default,
        manifest: Option<Path>.none()
      }
    }
  }
  return Selection {
    version: run Bytes.copy(running),
    origin: Origin.Running,
    manifest: Option<Path>.none()
  }
}
