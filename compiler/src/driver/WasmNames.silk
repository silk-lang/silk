//! Gives the functions of a linked wasm module readable names in its `name` section.
//!
//! # When to use
//! A debug build of a wasm executable calls [`rename`] on the linked core module before it is
//! published or wrapped into a component. Engines print the `name` section's function names in
//! their traces, so a trap then reads `main.pick` instead of a content-derived symbol.
//!
//! # Details
//! Symbols stay content-derived, so objects and the codegen cache do not change; only the
//! function-names subsection (id 1) of the custom `name` section is rewritten. A `$enter` or
//! `$step` function takes its function's readable name with the suffix kept, a function whose
//! name is not in the table otherwise keeps its name, and every other section and subsection is
//! copied unchanged.
import semantic.ContentHash {ContentHash}
import semantic.InternIndex {InternIndex}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.collections.slice {Slice}
import silk.num.u8
import silk.num.usize
import silk.collections.list {List}

/// Readable names by symbol, filled with [`FunctionNames.add`].
pub struct FunctionNames {
  symbols: List<Bytes>,
  names: List<Bytes>,
  index: InternIndex,
}

impl FunctionNames {
  /// An empty table. It allocates nothing until the first [`FunctionNames.add`].
  pub fn make() -> FunctionNames {
    return FunctionNames {symbols: List<Bytes>.make(), names: List<Bytes>.make(), index: InternIndex.make()}
  }

  /// Names the function `symbol` as `name`. The first name added for a symbol wins.
  pub effect fn add(self: &mut Self, symbol: &[u8], name: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    run InternIndex.record(&mut self.index, InternIndex.hashBytes(0, symbol))
    run List<Bytes>.append(&mut self.symbols, run Bytes.copy(symbol))
    run List<Bytes>.append(&mut self.names, run Bytes.copy(name))
  }

  /// The digest of every symbol and name, in the order they were added.
  pub fn digest(self: &Self) -> ContentHash {
    let symbols = List<Bytes>.asSlice(&self.symbols)
    let names = List<Bytes>.asSlice(&self.names)
    let mut stream = ContentHash.stream()
    let mut at = usize.ZERO
    while at < symbols.length {
      ContentHash.appendWord(&mut stream, usize.toU64(Bytes.length(&symbols[at])), 4)
      ContentHash.append(&mut stream, Bytes.asSlice(&symbols[at]))
      ContentHash.appendWord(&mut stream, usize.toU64(Bytes.length(&names[at])), 4)
      ContentHash.append(&mut stream, Bytes.asSlice(&names[at]))
      at = at + usize.ONE
    }
    return ContentHash.finish(move stream)
  }

  /// The number of names added.
  pub fn length(self: &Self) -> usize { return List<Bytes>.length(&self.symbols) }

  /// The name added for `symbol`, or none.
  pub fn lookup(self: &Self, symbol: &[u8]) -> Option<&[u8]> {
    let symbols = List<Bytes>.asSlice(&self.symbols)
    let mut at = InternIndex.first(&self.index, InternIndex.hashBytes(0, symbol))
    while at != usize.MAX {
      if same(Bytes.asSlice(&symbols[at]), symbol) {
        return Option<&[u8]>.some(Bytes.asSlice(&List<Bytes>.asSlice(&self.names)[at]))
      }
      at = InternIndex.after(&self.index, at)
    }
    return Option<&[u8]>.none()
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

/// A read position in a module; `failed` is set once a read runs past `end` or a number is
/// malformed.
pub struct Reader {
  pub at: usize,
  pub end: usize,
  pub failed: bool,
}

/// The byte at the reader's position, or 0 with `failed` set past `end`.
pub fn readByte(bytes: &[u8], reader: &mut Reader) -> u8 {
  if reader.at >= reader.end {
    reader.failed = true
    return 0
  }
  let value = bytes[reader.at]
  reader.at = reader.at + usize.ONE
  return value
}

/// An unsigned LEB128 number of at most 32 bits.
pub fn readNumber(bytes: &[u8], reader: &mut Reader) -> usize {
  let mut value = usize.ZERO
  let mut shift = usize.ZERO
  while true {
    let byte = readByte(bytes, &mut reader.*)
    if reader.failed { return usize.ZERO }
    value = value | usize.shiftLeft(u8.toUsize(byte) & 127, shift)
    if (byte & 128) == 0 { return value }
    shift = shift + 7
    if shift > 28 {
      reader.failed = true
      return usize.ZERO
    }
  }
  return value
}

/// Appends `value` as an unsigned LEB128 number.
pub effect fn appendNumber(output: &mut Bytes, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut rest = value
  while true {
    let low = usize.toU8(rest & 127)
    rest = usize.shiftRight(rest, 7)
    if rest == usize.ZERO {
      run Bytes.append(&mut output.*, &[low])
      return ()
    }
    run Bytes.append(&mut output.*, &[low | 128])
  }
}

/// Appends a section or subsection: its id, its length and `payload`.
pub effect fn appendPart(output: &mut Bytes, id: u8, payload: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run Bytes.append(&mut output.*, &[id])
  run appendNumber(&mut output.*, payload.length)
  run Bytes.append(&mut output.*, payload)
}

// The function-names subsection `bytes[start..end]` with each listed function renamed, or none when
// it is malformed.
effect fn renamedFunctions(bytes: &[u8], start: usize, end: usize, names: &FunctionNames) -> Option<Bytes>
! OutOfMemoryError ? &mut Allocator {
  let mut reader = Reader {at: start, end: end, failed: false}
  let count = readNumber(bytes, &mut reader)
  let mut output = Bytes.make()
  run appendNumber(&mut output, count)
  let mut entry = usize.ZERO
  while entry < count && !reader.failed {
    let function = readNumber(bytes, &mut reader)
    let length = readNumber(bytes, &mut reader)
    if reader.failed || length > reader.end - reader.at { return Option<Bytes>.none() }
    let name = Slice.view<u8>(bytes, reader.at, length)
    reader.at = reader.at + length
    run appendNumber(&mut output, function)
    let mut chosen = name
    let mut suffix = Slice.view<u8>(name, name.length, usize.ZERO)
    if let Option<&[u8]>.Some {value} = names.lookup(name) { chosen = value }
    else {
      // A suspending function's `$enter` and `$step` keep their suffix after its readable name.
      let split = suffixStart(name)
      if split != usize.MAX {
        if let Option<&[u8]>.Some {value} = names.lookup(Slice.view<u8>(name, usize.ZERO, split)) {
          chosen = value
          suffix = Slice.view<u8>(name, split, name.length - split)
        }
      }
    }
    run appendNumber(&mut output, chosen.length + suffix.length)
    run Bytes.append(&mut output, chosen)
    run Bytes.append(&mut output, suffix)
    entry = entry + usize.ONE
  }
  if reader.failed || reader.at != end { return Option<Bytes>.none() }
  return Option<Bytes>.some(move output)
}

// Where the `$` suffix of `name` starts, such as `$step` in `silk_<hash>$step`, or `usize.MAX`.
fn suffixStart(name: &[u8]) -> usize {
  let mut at = name.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if name[at] == 36 { return at }
  }
  return usize.MAX
}

// The payload of the `name` section `bytes[start..end]` after its section name, with the
// function-names subsection renamed, or none when it is malformed.
effect fn renamedNameSection(bytes: &[u8], start: usize, end: usize, names: &FunctionNames) -> Option<Bytes>
! OutOfMemoryError ? &mut Allocator {
  let mut reader = Reader {at: start, end: end, failed: false}
  let mut output = Bytes.make()
  while reader.at < end {
    let id = readByte(bytes, &mut reader)
    let length = readNumber(bytes, &mut reader)
    if reader.failed || length > end - reader.at { return Option<Bytes>.none() }
    let body = reader.at
    reader.at = reader.at + length
    if id == 1 {
      let renamed = match move run renamedFunctions(bytes, body, body + length, names) {
        Option<Bytes>.Some {value} => move value
        Option<Bytes>.None => { return Option<Bytes>.none() }
      }
      run appendPart(&mut output, id, Bytes.asSlice(&renamed))
    } else {
      run appendPart(&mut output, id, Slice.view<u8>(bytes, body, length))
    }
  }
  return Option<Bytes>.some(move output)
}

/// The wasm module `module` with the functions `names` lists renamed in its `name` section, or
/// none when `module` is not a well-formed core module or has no `name` section.
pub effect fn rename(module: &[u8], names: &FunctionNames) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let header = b"\x00asm\x01\x00\x00\x00"
  if module.length < header.length || !same(Slice.view<u8>(module, usize.ZERO, header.length), header) {
    return Option<Bytes>.none()
  }
  let mut reader = Reader {at: header.length, end: module.length, failed: false}
  let mut output = run Bytes.copy(header)
  let mut renamed = false
  while reader.at < module.length {
    let start = reader.at
    let id = readByte(module, &mut reader)
    let length = readNumber(module, &mut reader)
    if reader.failed || length > module.length - reader.at { return Option<Bytes>.none() }
    let body = reader.at
    let end = body + length
    reader.at = end
    let mut copied = true
    if id == 0 {
      let mut inner = Reader {at: body, end: end, failed: false}
      let nameLength = readNumber(module, &mut inner)
      if inner.failed || nameLength > end - inner.at { return Option<Bytes>.none() }
      if same(Slice.view<u8>(module, inner.at, nameLength), b"name") {
        let contents = inner.at + nameLength
        let rewritten = match move run renamedNameSection(module, contents, end, names) {
          Option<Bytes>.Some {value} => move value
          Option<Bytes>.None => { return Option<Bytes>.none() }
        }
        let mut payload = Bytes.make()
        run appendNumber(&mut payload, nameLength)
        run Bytes.append(&mut payload, b"name")
        run Bytes.append(&mut payload, Bytes.asSlice(&rewritten))
        run appendPart(&mut output, 0, Bytes.asSlice(&payload))
        copied = false
        renamed = true
      }
    }
    if copied { run Bytes.append(&mut output, Slice.view<u8>(module, start, end - start)) }
  }
  if !renamed { return Option<Bytes>.none() }
  return Option<Bytes>.some(move output)
}
