//! Runs the tool steps of a package's `build.silk` plan (driver/BuildPlan): a program of the package
//! that writes declared outputs into a directory of its own below the build directory.
//!
//! A step runs in the build tool sandbox (driver/ToolSandbox) when the host has one: it reads the
//! system's programs and libraries, its program and its declared inputs, writes only its output
//! directory, which is also its working directory, and opens no TCP connection. Its key digests
//! its program, arguments, inputs and outputs; a step whose key and outputs are unchanged since
//! its last run does not run again.

import driver.BuildPlan {Tool}
import driver.CommandPath
import diagnostic.JsonText
import semantic.ContentHash {ContentHash, Stream as HashStream}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.system.child_process {ChildProcess, ProcessError, ProcessOutcome, ProcessRequest}
import silk.core.effect {Effect}
import silk.system.filesystem {DirectoryEntry, FileError, FileSystem, Path}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.num.i32
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// What running one step answers.
pub union Ran {
  /// Its outputs are current: it ran and wrote them, or nothing it reads changed.
  Current,
  /// It cannot run or failed; `reason` says why, with what it printed.
  Refused { pub reason: Bytes },
}

// The system directories a sandboxed step reads: programs, libraries, their configuration and the
// device and process files every program expects.
fn systemDirectories() -> [&'static [u8]; 7] {
  return [b"/usr", b"/bin", b"/lib", b"/lib64", b"/etc", b"/dev", b"/proc"]
}

// Whether `path` is a relative path below the package: not empty, no leading `/`, and no empty,
// `.` or `..` segment.
fn contained(path: &[u8]) -> bool {
  if path.length == usize.ZERO || path[usize.ZERO] == 47 { return false }
  let mut start = usize.ZERO
  let mut at = usize.ZERO
  while at <= path.length {
    if at == path.length || path[at] == 47 || path[at] == 92 {
      let length = at - start
      if length == usize.ZERO { return false }
      if length == usize.ONE && path[start] == 46 { return false }
      if length == usize.add(0, 2) && path[start] == 46 && path[start + usize.ONE] == 46 { return false }
      start = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return true
}

effect fn refused(tool: &Tool, detail: &[u8]) -> Ran ! OutOfMemoryError ? &mut Allocator {
  let mut reason = run Bytes.copy(b"its tool step `")
  run Bytes.append(&mut reason, Bytes.asSlice(&tool.name))
  run Bytes.append(&mut reason, b"` ")
  run Bytes.append(&mut reason, detail)
  return Ran.Refused { reason: move reason }
}

// Adds the bytes of the file or directory tree at `path` to `stream`; a missing path adds a marker.
effect fn digestTree(stream: &mut HashStream, path: &Path) -> () ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let read = run Effect.result(FileSystem.readFile(path))
  match move read {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => {
      ContentHash.appendWord(&mut stream.*, usize.toU64(Bytes.length(&value)), usize.add(0, 8))
      ContentHash.append(&mut stream.*, Bytes.asSlice(&value))
      return ()
    }
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError unread => { drop unread }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let listed = run Effect.result(FileSystem.listDirectory(path))
  match move listed {
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success { value } => {
      let children = List<DirectoryEntry>.asSlice(&value)
      let mut at = usize.ZERO
      while at < children.length {
        ContentHash.append(&mut stream.*, Path.rawBytes(&children[at].path))
        run digestTree(&mut stream.*, &children[at].path)
        at = at + usize.ONE
      }
    }
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError unread => {
        drop unread
        ContentHash.append(&mut stream.*, b"missing")
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  return ()
}

effect fn appendHex(out: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let digits = b"0123456789abcdef"
  let mut place: u64 = 1152921504606846976
  while place > 0 {
    let digit = u64.toUsize((value / place) % 16)
    run Bytes.append(&mut out.*, &[digits[digit]])
    place = place / 16
  }
  return ()
}

effect fn readOptional(path: &Path) -> Option<Bytes> ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  return match move run Effect.result(FileSystem.readFile(path)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => Option<Bytes>.some(move value)
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError unread => {
        drop unread
        Option<Bytes>.none()
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

/// Runs `tool` of the package in `directory`, writing below `output`; sandboxed by `sandbox` (the
/// compiler that runs `sandbox-exec`) when given, otherwise directly.
pub effect fn execute(tool: &Tool, directory: &Path, output: &Path, sandbox: Option<&Path>) -> Ran
! FileError | OutOfMemoryError ? &mut FileSystem | &mut ChildProcess | &mut Allocator {
  if !contained(Bytes.asSlice(&tool.program)) {
    return run refused(tool, b"names its program with a path that is not relative to the package")
  }
  let inputs = List<Bytes>.asSlice(&tool.inputs)
  let outputs = List<Bytes>.asSlice(&tool.outputs)
  let mut at = usize.ZERO
  while at < inputs.length {
    if !contained(Bytes.asSlice(&inputs[at])) {
      return run refused(tool, b"names an input with a path that is not relative to the package")
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < outputs.length {
    if !contained(Bytes.asSlice(&outputs[at])) {
      return run refused(tool, b"names an output with a path that is not relative to its output directory")
    }
    at = at + usize.ONE
  }
  let program = run Path.joinBytes(directory, Bytes.asSlice(&tool.program))
  let programBytes = match move run readOptional(&program) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      let mut detail = run Bytes.copy(b"names program ")
      run Bytes.append(&mut detail, Bytes.asSlice(&tool.program))
      run Bytes.append(&mut detail, b", which the package does not have")
      return run refused(tool, Bytes.asSlice(&detail))
    }
  }
  // The key: what the step reads, and whether it runs sandboxed.
  let mut stream = ContentHash.stream()
  ContentHash.append(&mut stream, Bytes.asSlice(&programBytes))
  let arguments = List<Bytes>.asSlice(&tool.arguments)
  at = usize.ZERO
  while at < arguments.length {
    ContentHash.append(&mut stream, b"\0argument\0")
    ContentHash.append(&mut stream, Bytes.asSlice(&arguments[at]))
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < inputs.length {
    ContentHash.append(&mut stream, b"\0input\0")
    ContentHash.append(&mut stream, Bytes.asSlice(&inputs[at]))
    run digestTree(&mut stream, &run Path.joinBytes(directory, Bytes.asSlice(&inputs[at])))
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < outputs.length {
    ContentHash.append(&mut stream, b"\0output\0")
    ContentHash.append(&mut stream, Bytes.asSlice(&outputs[at]))
    at = at + usize.ONE
  }
  if let Option<&Path>.Some { value: _ } = &sandbox { ContentHash.append(&mut stream, b"\0sandboxed") }
  let digest = ContentHash.finish(move stream)
  let mut key = Bytes.make()
  run appendHex(&mut key, digest.high)
  run appendHex(&mut key, digest.low)
  let keyFile = run Path.join(output, ".silk-tool-key")
  let mut current = false
  if let Option<Bytes>.Some { value: recorded } = move run readOptional(&keyFile) {
    current = same(Bytes.asSlice(&recorded), Bytes.asSlice(&key))
    at = usize.ZERO
    while current && at < outputs.length {
      current = run FileSystem.exists(&run Path.joinBytes(output, Bytes.asSlice(&outputs[at])))
      at = at + usize.ONE
    }
  }
  if current { return Ran.Current }
  // A step starts from an empty output directory, so no output of an earlier run survives it.
  if run FileSystem.exists(output) { run FileSystem.removeDirectoryRecursively(output) }
  let temporary = run Path.join(output, ".tmp")
  run FileSystem.createDirectoriesRecursively(&temporary)
  let mut request = match &sandbox {
    Option<&Path>.Some { value: compiler } => {
      let mut sandboxed = run ChildProcess.requestWithin(compiler, output)
      run ChildProcess.addArgumentBytes(&mut sandboxed, b"sandbox-exec")
      let system = systemDirectories()
      let mut place = usize.ZERO
      while place < usize.add(0, 7) {
        run ChildProcess.addArgumentBytes(&mut sandboxed, b"--read")
        run ChildProcess.addArgumentBytes(&mut sandboxed, system[place])
        place = place + usize.ONE
      }
      run ChildProcess.addArgumentBytes(&mut sandboxed, b"--read")
      run ChildProcess.addArgumentBytes(&mut sandboxed, Path.rawBytes(&program))
      place = usize.ZERO
      while place < inputs.length {
        run ChildProcess.addArgumentBytes(&mut sandboxed, b"--read")
        run ChildProcess.addArgumentBytes(&mut sandboxed, Path.rawBytes(&run Path.joinBytes(directory, Bytes.asSlice(&inputs[place]))))
        place = place + usize.ONE
      }
      run ChildProcess.addArgumentBytes(&mut sandboxed, b"--write")
      run ChildProcess.addArgumentBytes(&mut sandboxed, Path.rawBytes(output))
      run ChildProcess.addArgumentBytes(&mut sandboxed, b"--write")
      run ChildProcess.addArgumentBytes(&mut sandboxed, b"/dev/null")
      run ChildProcess.addArgumentBytes(&mut sandboxed, b"--")
      run ChildProcess.addArgumentBytes(&mut sandboxed, Path.rawBytes(&program))
      move sandboxed
    }
    Option<&Path>.None => run ChildProcess.requestWithin(&program, output)
  }
  at = usize.ZERO
  while at < arguments.length {
    run ChildProcess.addArgumentBytes(&mut request, Bytes.asSlice(&arguments[at]))
    at = at + usize.ONE
  }
  run ChildProcess.setVariable(&mut request, "PATH", "/usr/local/bin:/usr/bin:/bin")
  run ChildProcess.setVariableBytes(&mut request, b"HOME", Path.rawBytes(output))
  run ChildProcess.setVariableBytes(&mut request, b"TMPDIR", Path.rawBytes(&temporary))
  run ChildProcess.setVariable(&mut request, "SILK_TOOL", "1")
  run ChildProcess.setVariableBytes(&mut request, b"SILK_PACKAGE_DIR", Path.rawBytes(directory))
  let finished = match move run Effect.result(ChildProcess.submit(&request)) {
    Result<ProcessOutcome, ProcessError | OutOfMemoryError>.Success { value } => move value
    Result<ProcessOutcome, ProcessError | OutOfMemoryError>.Failure { error } => match move error {
      ProcessError unstarted => {
        drop unstarted
        return run refused(tool, b"cannot start its program")
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let mut status: i32 = -1
  if let Option<i32>.Some { value } = move ChildProcess.exitCode(&finished) { status = value }
  if status != 0 {
    let mut detail = run Bytes.copy(b"failed with status ")
    if status >= 0 { run JsonText.appendDecimal(&mut detail, i32.toUsize(status)) } else { run Bytes.append(&mut detail, b"-1") }
    let printed = ChildProcess.errorBytes(&finished)
    let written = ChildProcess.outputBytes(&finished)
    if printed.length + written.length > usize.ZERO {
      run Bytes.append(&mut detail, b":\n")
      run Bytes.append(&mut detail, written)
      run Bytes.append(&mut detail, printed)
    }
    return run refused(tool, Bytes.asSlice(&detail))
  }
  at = usize.ZERO
  while at < outputs.length {
    if !run FileSystem.exists(&run Path.joinBytes(output, Bytes.asSlice(&outputs[at]))) {
      let mut detail = run Bytes.copy(b"did not write its declared output ")
      run Bytes.append(&mut detail, Bytes.asSlice(&outputs[at]))
      return run refused(tool, Bytes.asSlice(&detail))
    }
    at = at + usize.ONE
  }
  run FileSystem.writeFile(&keyFile, Bytes.asSlice(&key))
  return Ran.Current
}

/// Whether `outputs` declares `path`.
pub fn declares(outputs: &[Bytes], path: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < outputs.length {
    if same(Bytes.asSlice(&outputs[at]), path) { return true }
    at = at + usize.ONE
  }
  return false
}

/// The compiler executable, which runs `sandbox-exec`; none when it cannot be found.
pub effect fn compiler() -> Option<Path> ! FileError | OutOfMemoryError ? &mut Allocator {
  if let Option<Bytes>.Some { value } = move run CommandPath.canonical(b"/proc/self/exe") {
    return Option<Path>.some(run Path.fromBytes(Bytes.asSlice(&value)))
  }
  return Option<Path>.none()
}
