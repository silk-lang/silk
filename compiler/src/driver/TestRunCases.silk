//! Per-test exchange and completed-pass records agree byte for byte with the bundled runner and the
//! bootstrap: a per-test plan the runner's own receipt encoder answers is admitted only with
//! matching identities, dispositions, counts and status, and a pass record is reused only for its
//! exact identity (TEST-008).

import driver.TestResult as TestResults { Lookup, Miss }
import driver.TestRun as TestRuns { Action, Disposition, PerTestReceipt, PlanEntry, ReceiptEntry }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.filesystem { FileError, FileSystem, Path }
import silk.option { Option }
import silk.os_filesystem { OsFileSystem }
import silk.slice { Slice }
import silk.test_exchange as TestExchange
import silk.testing { AssertionError, Testing }
import silk.usize
import silk.vector { Vector }

// `count` copies of `byte`.
effect fn filled(byte: u8, count: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  let mut at = usize.ZERO
  while at < count {
    run Bytes.append(&mut text, &[byte])
    at = at + usize.ONE
  }
  return move text
}

// A 64-digit identity made of `digit`.
effect fn identity(digit: u8) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  return run filled(digit, 64)
}

// Three discovered tests: an eligible one planned cached, an eligible one to execute, and an
// ineligible one to execute.
effect fn entries() -> Vector<PlanEntry> ! OutOfMemoryError ? &mut Allocator {
  let mut listed = Vector<PlanEntry>.make()
  run Vector<PlanEntry>.append(&mut listed, PlanEntry {
    declaration: run Bytes.copy(b"project:a/function=one#0"), execution: Option<Bytes>.some(run identity(97)), action: Action.Cached,
  })
  run Vector<PlanEntry>.append(&mut listed, PlanEntry {
    declaration: run Bytes.copy(b"project:a/function=two#0"), execution: Option<Bytes>.some(run identity(98)), action: Action.Execute,
  })
  run Vector<PlanEntry>.append(&mut listed, PlanEntry {
    declaration: run Bytes.copy(b"project:a/function=three#0"), execution: Option<Bytes>.none(), action: Action.Execute,
  })
  return move listed
}

// The receipt the runner writes for `plan` after selecting the first two entries: a cached pass
// with `first`, then `second` with the given dispositions, and `status`.
effect fn receipt(plan: &[u8], first: u8, second: u8, status: u32) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let one = run identity(97)
  let two = run identity(98)
  let mut writing = run TestExchange.beginReceipt(plan, true, 2)
  run TestExchange.appendResult(&mut writing, 0, b"project:a/function=one#0", Bytes.asSlice(&one), first)
  run TestExchange.appendResult(&mut writing, 1, b"project:a/function=two#0", Bytes.asSlice(&two), second)
  let mut cached: u64 = 0
  if first == 0 { cached = 1 }
  let mut failed: u64 = 0
  if second == 2 { failed = 1 }
  return run TestExchange.finishReceipt(move writing, 3, 2, cached, 2 - cached, 2 - failed, failed, status)
}

fn admitted(outcome: &Option<PerTestReceipt>) -> bool {
  return match &outcome.* {
    Option<PerTestReceipt>.Some {..} => true
    Option<PerTestReceipt>.None => false
  }
}

effect fn exchangePolicy() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let listed = run entries()
  let planned = Vector<PlanEntry>.asSlice(&listed)
  run Testing.expect(TestRuns.selectsPerTest(planned), "a small catalog fits the per-test bound")
  let nonce = run filled(7, 32)
  let plan = run TestRuns.perTestPlan(Bytes.asSlice(&nonce), planned)
  let written = run receipt(Bytes.asSlice(&plan), 0, 2, 1)
  let accepted = run TestRuns.admitPerTestReceipt(Bytes.asSlice(&plan), planned, Bytes.asSlice(&written), 1)
  let mut matched = false
  if let Option<PerTestReceipt>.Some {value} = &accepted {
    let found = Vector<ReceiptEntry>.asSlice(&value.entries)
    matched = found.length == 2 && found[0].disposition == Disposition.Cached && found[1].disposition == Disposition.Failed
      && value.counts.cached == 1 && value.counts.executed == 1 && value.counts.passed == 1 && value.counts.failed == 1
  }
  run Testing.expect(matched, "the runner's receipt for a per-test plan is admitted with its dispositions and counts")
  let executing = run receipt(Bytes.asSlice(&plan), 1, 1, 0)
  let executedCached = run TestRuns.admitPerTestReceipt(Bytes.asSlice(&plan), planned, Bytes.asSlice(&executing), 0)
  let wrongStatus = run TestRuns.admitPerTestReceipt(Bytes.asSlice(&plan), planned, Bytes.asSlice(&written), 0)
  let otherNonce = run filled(8, 32)
  let otherPlan = run TestRuns.perTestPlan(Bytes.asSlice(&otherNonce), planned)
  let foreign = run receipt(Bytes.asSlice(&otherPlan), 0, 1, 0)
  let unbound = run TestRuns.admitPerTestReceipt(Bytes.asSlice(&plan), planned, Bytes.asSlice(&foreign), 0)
  run Testing.expect(!admitted(&executedCached) && !admitted(&wrongStatus) && !admitted(&unbound),
    "a receipt that executes a cached test, disagrees with the process status, or answers another plan is refused")
  let mut huge = Vector<PlanEntry>.make()
  let long = run filled(120, 5000)
  run Vector<PlanEntry>.append(&mut huge, PlanEntry {declaration: move long, execution: Option<Bytes>.none(), action: Action.Execute})
  run Testing.expect(!TestRuns.selectsPerTest(Vector<PlanEntry>.asSlice(&huge)), "directions beyond the per-test bound select an uncached run")
}

test effect fn perTestExchangeAgreesWithTheRunner() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run exchangePolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn missing(found: &Lookup) -> bool {
  return match &found.* {
    Lookup.Miss {reason: Miss.Missing} => true
    _ => false
  }
}

fn invalid(found: &Lookup) -> bool {
  return match &found.* {
    Lookup.Miss {reason: Miss.InvalidRecord} => true
    _ => false
  }
}

fn hit(found: &Lookup) -> bool {
  return match &found.* {
    Lookup.Hit => true
    _ => false
  }
}

// Native filesystem fixtures need the physical temporary root: /tmp is a symlink on Darwin.
effect fn temporaryParent() -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return run Path.make("/private/tmp")
  } else {
    return run Path.make("/tmp")
  }
}

effect fn recordPolicy() -> () ! AssertionError<'static> | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let one = run identity(97)
  let two = run identity(98)
  let record = run TestResults.encodePass(Bytes.asSlice(&one))
  let own = run TestResults.decodePass(Bytes.asSlice(&one), Bytes.asSlice(&record))
  let other = run TestResults.decodePass(Bytes.asSlice(&two), Bytes.asSlice(&record))
  run Testing.expect(
    own && !other && !TestResults.validIdentity(b"ABC") && TestResults.validIdentity(Bytes.asSlice(&one)),
    "a pass record admits only its own lowercase 64-digit identity"
  )
  let parent = run temporaryParent()
  let temp = run FileSystem.temporaryDirectory(&parent, "silk-test-results-")
  let absent = run TestResults.lookup(&temp.path, Bytes.asSlice(&one))
  let path = run TestResults.recordPath(&temp.path, Bytes.asSlice(&one))
  run FileSystem.writeFileWithParents(&path, Bytes.asSlice(&record))
  let present = run TestResults.lookup(&temp.path, Bytes.asSlice(&one))
  let torn = Slice.view<u8>(Bytes.asSlice(&record), usize.ZERO, Bytes.length(&record) - 2)
  run FileSystem.writeFile(&path, torn)
  let damaged = run TestResults.lookup(&temp.path, Bytes.asSlice(&one))
  run Testing.expect(missing(&absent) && hit(&present) && invalid(&damaged),
    "an absent record misses, an exact record hits, and a torn one is an invalid record, never a pass")
  run FileSystem.release(move temp)
}

test effect fn passRecordsAreReusedOnlyForTheirIdentity() -> () ! AssertionError<'static> | FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make(b"/") |> Effect.provideMut<Allocator>(&mut allocator)
  return run recordPolicy() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
}
