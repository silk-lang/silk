//! Resolves optional compilation settings through the compiler's target policy.

import driver.ModuleSources as Sources { ModuleSources }
import driver.Packages { InvalidDependency }
import driver.CompilationRequest as Requests
import semantic.ProfileBinding { Supplied, Provenance, Tier }
import silk.toml.value { Toml, Value as TomlValue, TomlChild }
import silk.build.request { Request, ParameterValue }
import silk.build.definition { Definition }
import semantic.InitialProfile { InitialProfile, Input, Selection, Problem }
import silk.mem.box { Box }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.num.usize

/// Freezes explicit source settings, using the host and package artifact for unspecified fields.
pub effect fn profile(definition: &Definition, host: &[u8], artifact: &[u8]) -> InitialProfile
  ! Problem | OutOfMemoryError
  ? &mut Allocator {
  let supplied = &definition.settings.profile
  let mut input = Input.make()
  input.target = run optional(&supplied.target)
  if !input.target.isSome() {
    input.target = Option<Bytes>.some(run Bytes.copy(host))
  }
  input.cpu = run optional(&supplied.cpu)
  input.cpuFeatures = run texts(&supplied.cpuFeatures)
  input.deployment = run optional(&supplied.deployment)
  input.libc = run optional(&supplied.libc)
  input.artifact = run optional(&definition.artifact)
  if let Option<String>.Some { value } = &definition.artifact {
    if value.view() == "test" {
      input.artifact = Option<Bytes>.some(run Bytes.copy(b"executable"))
    }
  }
  if !input.artifact.isSome() {
    input.artifact = Option<Bytes>.some(run Bytes.copy(artifact))
  }
  input.entry = run selection(&supplied.entry)
  input.runtime = run selection(&supplied.runtime)
  input.link = run optional(&supplied.link)
  input.codeModel = run optional(&supplied.codeModel)
  input.relocation = run optional(&supplied.relocation)
  input.optimization = run optional(&supplied.optimization)
  input.debug = supplied.debug
  input.safety = run optional(&supplied.safety)
  input.threading = run optional(&supplied.threading)
  input.sanitizers = run texts(&supplied.sanitizers)
  input.unwind = run optional(&supplied.unwind)
  input.backend = run optional(&supplied.backend)
  input.codegenUnits = supplied.codegenUnits
  return run Requests.freeze(&input)
}

effect fn optional(value: &Option<String>) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value.* {
    Option<String>.Some { value: text } => Option<Bytes>.some(
      run Bytes.copy(String.ownedUtf8Bytes(&text)),
    )
    Option<String>.None => Option<Bytes>.none()
  }
}

effect fn texts(value: &Option<List<String>>) -> List<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = List<Bytes>.make()
  if let Option<List<String>>.Some { value: items } = &value.* {
    let listed = items.asSlice()
    let mut at = usize.ZERO
    while at < listed.length {
      run result.append(run Bytes.copy(String.ownedUtf8Bytes(&listed[at])))
      at = at + usize.ONE
    }
  }
  return move result
}

effect fn selection(value: &Option<String>) -> Selection
  ! OutOfMemoryError
  ? &mut Allocator {
  if let Option<String>.Some { value: text } = &value.* {
    if text.view() == "default" {
      return Selection.Default
    }
    if text.view() == "none" {
      return Selection.None
    }
    return Selection.Named { name: run Bytes.copy(String.ownedUtf8Bytes(&text)) }
  }
  return Selection.Default
}

/// Adds physical backend inputs after source facts and package parameters have been resolved.
pub effect fn finish(request: &mut Request, definition: Definition) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let selected = definition.packages.entries()
  let mut at = usize.ZERO
  while at < selected.length {
    let configured = &selected[at]
    if !configured.value.excluded {
      let root = &request.packages.asSlice()[0]
      let mut identity = String.make()
      if configured.key.view() == "self" {
        identity = run String.copy(root.name.view())
        run identity.append("@")
        run identity.append(root.version.view())
      } else {
        let dependencies = root.dependencies.asSlice()
        let mut index = usize.ZERO
        while index < dependencies.length {
          if dependencies[index].name.view() == configured.key.view() {
            identity = run String.copy(dependencies[index].package.view())
          }
          index = index + usize.ONE
        }
      }
      let packages = request.packages.asMutSlice()
      let mut index = usize.ZERO
      while index < packages.length {
        let package = &mut packages[index]
        let mut name = run String.copy(package.name.view())
        run name.append("@")
        run name.append(package.version.view())
        if name.view() == identity.view() {
          if let Option<String>.Some { value } = &configured.value.optimization {
            package.optimization = Option<String>.some(run String.copy(value.view()))
          }
          package.debug = configured.value.debug
          let bindings = configured.value.parameters.asSlice()
          let parameters = package.parameters.asMutSlice()
          let mut parameter = usize.ZERO
          while parameter < parameters.length {
            let mut binding = usize.ZERO
            while binding < bindings.length {
              if parameters[parameter].name.view() == bindings[binding].name.view()
                && parameters[parameter].module.view() == bindings[binding].module.view() {
                parameters[parameter].suppliedPath = bindings[binding].suppliedPath
              }
              binding = binding + usize.ONE
            }
            parameter = parameter + usize.ONE
          }
        }
        index = index + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  if let Option<String>.Some { value } = move definition.name {
    request.name = move value
  }
  if let Option<String>.Some { value } = move definition.artifact {
    request.artifact = move value
  }
  let settings = move definition.settings
  request.platform = move settings.platform
  request.windows = move settings.windows
  request.macos = move settings.macos
  if settings.wasm.isSome() {
    request.wasm = move settings.wasm
  }
  request.header = move settings.header
  request.importLibrary = move settings.importLibrary
  request.runner = move settings.runner
  if settings.native.functionOrder.isSome() {
    request.native.functionOrder = move settings.native.functionOrder
  }
  run request.native.sources.appendList(move settings.native.sources)
  run request.native.link.appendList(move settings.native.link)
}

/// Resolves declared aliases and converts explicit parameter values before profile assembly.
pub effect fn bindings(
  definition: &Definition,
  sources: &ModuleSources,
  plan: Option<&[u8]>,
) -> List<Supplied>
  ! InvalidDependency | OutOfMemoryError
  ? &mut Allocator {
  let mut result = List<Supplied>.make()
  let packages = definition.packages.entries()
  let mut at = usize.ZERO
  while at < packages.length {
    let selected = &packages[at]
    if selected.value.excluded {
      at = at + usize.ONE
      continue
    }
    let identity = match move run Sources.selectedPackage(
      sources,
      String.ownedUtf8Bytes(&selected.key),
    ) {
      Option<Bytes>.Some { value } => move value
      Option<Bytes>.None => {
        at = at + 1
        continue
      }
    }
    let parameters = selected.value.parameters.asSlice()
    let mut parameter = usize.ZERO
    while parameter < parameters.length {
      let supplied = &parameters[parameter]
      let selectedPlan = match plan {
        Option<&[u8]>.Some { value } => sameBytes(identity.asSlice(), value)
          && supplied.module.view() == "build.silk"
        Option<&[u8]>.None => supplied.module.view() != "build.silk"
      }
      if !selectedPlan {
        parameter = parameter + 1
        continue
      }
      run result.append(
        Supplied {
          package: run Bytes.copy(identity.asSlice()),
          module: run Bytes.copy(String.ownedUtf8Bytes(&supplied.module)),
          parameter: run Bytes.copy(String.ownedUtf8Bytes(&supplied.name)),
          value: run Requests.bindingValue(&supplied.value),
          provenance: Provenance.Literal,
          tier: Tier.Override,
        },
      )
      parameter = parameter + usize.ONE
    }
    at = at + usize.ONE
  }
  return move result
}

/// Removes explicitly excluded aliases before fetching or loading their packages.
pub effect fn exclude(document: &mut TomlValue, definition: &Definition) -> ()
  ! InvalidDependency | OutOfMemoryError
  ? &mut Allocator {
  let overrides = definition.packages.entries()
  let mut at = usize.ZERO
  while at < overrides.length {
    let selected = &overrides[at]
    if selected.key.view() != "self"
      && !Toml.fieldAt(Toml.field(&document.*, "dependencies"), selected.key.view()).isSome() {
      let mut detail = run Bytes.copy(b"undeclared package alias in compilation: ")
      run detail.append(String.ownedUtf8Bytes(&selected.key))
      fail InvalidDependency {
        detail: move detail,
        manifest: run Bytes.copy(String.ownedUtf8Bytes(&definition.manifest)),
        line: usize.ZERO,
      }
    }
    if selected.value.excluded {
      let alias = selected.key.view()
      let exists = Toml.fieldAt(Toml.field(&document.*, "dependencies"), alias).isSome()
      if alias == "self" || !exists {
        let mut detail = run Bytes.copy(b"cannot exclude undeclared dependency: ")
        run detail.append(String.ownedUtf8Bytes(&selected.key))
        fail InvalidDependency {
          detail: move detail,
          manifest: run Bytes.copy(String.ownedUtf8Bytes(&definition.manifest)),
          line: usize.ZERO,
        }
      }
      if let TomlValue.Table { entries, .. } = &mut document.* {
        let members = Box<List<TomlChild>>.getMut(&mut entries)[0].asMutSlice()
        let mut member = usize.ZERO
        while member < members.length {
          if let TomlChild.Member { entry } = &mut members[member] {
            if entry.key.view() == "dependencies" {
              if let TomlValue.Table { entries: dependencyEntries, .. } = &mut entry.value {
                let dependencies = &mut Box<List<TomlChild>>.getMut(&mut dependencyEntries)[0]
                let mut dependency = usize.ZERO
                while dependency < dependencies.length() {
                  let remove = match &dependencies.asSlice()[dependency] {
                    TomlChild.Member { entry: item } => item.key.view() == alias
                    TomlChild.Item { .. } => false
                  }
                  if remove {
                    drop dependencies.remove(dependency)
                    break
                  }
                  dependency = dependency + usize.ONE
                }
              }
            }
          }
          member = member + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + 1
  }
  return true
}

/// Carries only explicitly supplied host paths into the isolated package-plan graph.
pub effect fn suppliedPaths(definition: &Definition, sources: &ModuleSources, owner: &[u8]) -> List<
  String
>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = List<String>.make()
  let packages = definition.packages.entries()
  let mut at: usize = 0
  while at < packages.length {
    let selected = &packages[at]
    if !selected.value.excluded {
      if let Option<Bytes>.Some { value: identity } = move run Sources.selectedPackage(
        sources,
        String.ownedUtf8Bytes(&selected.key),
      ) {
        if sameBytes(identity.asSlice(), owner) {
          let parameters = selected.value.parameters.asSlice()
          let mut parameter: usize = 0
          while parameter < parameters.length {
            let supplied = &parameters[parameter]
            if supplied.suppliedPath && supplied.module.view() == "build.silk" {
              if let ParameterValue.Text { value } = &supplied.value {
                run result.append(run String.copy(value.view()))
              }
            }
            parameter = parameter + 1
          }
        }
      }
    }
    at = at + 1
  }
  return move result
}
