//! Physical generation tokens and native lifetime pins refuse stale cache publication.
import driver.CachePublication as Publication {Published, Refusal}
import semantic.CacheGeneration as Generations {Generation, Selection, Placement, Certificate}
import semantic.CacheSegments as Segments {Descriptor, SealedSegment, Observation, Reference, Node, Edge, Root}
import semantic.CacheView as Views {View}
import semantic.RuntimeEncoding
import CompilerBug
import semantic.ContentHash {ContentHash}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.mem.frozen {Frozen}
import silk.core.result {Result}
import silk.num.u32
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.system.filesystem {Path, FileSystem, FileError, AtomicWriteError}
import silk.system.filesystem_machine {MachineFileSystem}
import silk.testing.testing {Testing, AssertionError}
import silk.num.usize

fn digest(value: u64) -> ContentHash { return ContentHash {high: 19, low: value} }

effect fn pointerClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let bytes = run Publication.pointer(digest(1), digest(2))
  let value = Publication.readPointer(Bytes.asSlice(&bytes), digest(1))
  run Testing.expect(match move value { Option<ContentHash>.Some {value: got} => ContentHash.equals(got, digest(2)) _ => false },
    "a sealed pointer authenticates its generation and namespace")
  run Testing.expect(match move Publication.readPointer(Bytes.asSlice(&bytes), digest(3)) {
    Option<ContentHash>.None => true _ => false }, "a pointer cannot cross a cleaned cache incarnation")
  let mut changed = run Bytes.copy(Bytes.asSlice(&bytes))
  let writable = Bytes.asMutSlice(&mut changed)
  writable[writable.length - usize.ONE] = if writable[writable.length - usize.ONE] == 0 { 1 } else { 0 }
  drop writable
  run Testing.expect(match move Publication.readPointer(Bytes.asSlice(&changed), digest(1)) {
    Option<ContentHash>.None => true _ => false }, "a malformed seal cannot select a generation")
  let absent = Publication.Token {incarnation: digest(1), present: false, physical: digest(0)}
  let present = Publication.Token {incarnation: digest(1), present: true, physical: digest(0)}
  run Testing.expect(!Publication.sameToken(absent, present), "absence differs from every present physical packet")
}

test effect fn generationPointerBindsPhysicalStateAndIncarnation() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run pointerClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn physicalClaims(directory: &mut Path) -> ()
! FileError | AtomicWriteError | OutOfMemoryError | AssertionError<'static>
? &mut FileSystem | &mut Allocator {
  let namespace = run Publication.initialize(&directory.*, digest(1))
  run Testing.expect(match move namespace { Option<ContentHash>.Some {value} => ContentHash.equals(value, digest(1)) _ => false },
    "first initialization establishes the namespace")
  let initial = match move run Publication.snapshot(&directory.*, b"stamp") {
    Option<Publication.Snapshot>.Some {value} => move value
    _ => { return run Testing.expect(false, "an empty initialized namespace has a physical snapshot") }
  }
  let scoped = run Publication.namespacePath(&directory.*, digest(1))
  let current = run Path.join(&scoped, "current")
  run FileSystem.writeFileAtomic(&current, b"malformed-current", FileSystem.replaceExisting(), FileSystem.buffered())
  let mut bad = match move run Publication.snapshot(&directory.*, b"stamp") {
    Option<Publication.Snapshot>.Some {value} => move value
    _ => { return run Testing.expect(false, "malformed contents still retain the expected physical token") }
  }
  run Testing.expect(bad.expected.present && !Publication.sameToken(initial.expected, bad.expected),
    "refused semantic content does not masquerade as an absent prior generation")
  run Testing.expect(match move Publication.takeGeneration(&mut bad) { Option<Generation>.None => true _ => false },
    "a malformed current packet confers no semantic authority")
  run Testing.expect(match move run Publication.begin(&directory.*, initial.expected) {
    Option<Publication.Writer>.None => true _ => false }, "a stale writer cannot overwrite an intervening publication")
  let accepted = run Publication.begin(&directory.*, bad.expected)
  run Testing.expect(match &accepted { Option<Publication.Writer>.Some {..} => true _ => false },
    "the exact physical token permits repair of refused cache metadata")
  drop accepted
  let path = run Path.join(&directory.*, "incarnation")
  run FileSystem.removeFile(&path)
  drop run Publication.initialize(&directory.*, digest(3))
  run Testing.expect(match move run Publication.begin(&directory.*, bad.expected) {
    Option<Publication.Writer>.None => true _ => false }, "clean and recreation invalidate every old writer token")
  let pinPath = run Publication.pinPath(&directory.*, digest(8))
  let pinned = run Publication.pin(&pinPath)
  run Testing.expect(match &pinned { Option<Publication.Lease>.Some {..} => true _ => false }, "the generation is pinned")
  run Testing.expect(match move run Publication.tryRetire(&pinPath) {
    Option<Publication.Lease>.None => true _ => false }, "a live reader prevents reclamation without blocking")
  drop pinned
  run Testing.expect(match move run Publication.tryRetire(&pinPath) {
    Option<Publication.Lease>.Some {..} => true _ => false }, "reclamation can acquire the pin after its last owner closes")
}

effect fn nativeClaims() -> () ! FileError | AtomicWriteError | OutOfMemoryError | AssertionError<'static>
? &mut FileSystem | &mut Allocator {
  let temporary = run Path.fromBytes(b"/tmp")
  let directory = run FileSystem.createTemporaryDirectory(&temporary, b"silk-cache-generation-")
  let use = effect fn(path: &mut Path) -> () ! FileError | AtomicWriteError | OutOfMemoryError | AssertionError<'static>
    ? &mut FileSystem | &mut Allocator { return run physicalClaims(&mut path.*) }
  let release = effect fn(path: &mut Path) -> () ? &mut FileSystem | &mut Allocator {
    drop run Effect.result(FileSystem.removeDirectoryRecursively(&path.*))
  }
  return run Effect.useReleaseNonParking(move directory, move use, move release)
}

test effect fn generationPinsAndPhysicalCompareExchangePreserveReaders() -> ()
! FileError | AtomicWriteError | OutOfMemoryError | AssertionError<'static> {
  static if Intrinsic.targetOperatingSystem() == "linux" || Intrinsic.targetOperatingSystem() == "darwin" {
    let mut allocator = Allocator.systemAllocatorProvider()
    let mut files = run MachineFileSystem.make() |> Effect.provideMut<Allocator>(&mut allocator)
    return run nativeClaims() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
  } else { return () }
}


// One real sealed answer with an independently stored native pack. The packet has ordinary
// source evidence so these tests exercise the same admitted View used by the driver boundary.
effect fn publishedView(pack: ContentHash, answer: &[u8]) -> View
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut builder = run Segments.make(1, b"publication-test")
  run List<Observation>.append(&mut builder.leaves, Observation {key: run Bytes.copy(b"module"), digest: digest(71),
    text: digest(0), position: usize.MAX, file: Option<Reference>.none(), selector: u32.MAX, input: false})
  let mut edges = List<Edge>.make()
  run List<Edge>.append(&mut edges, Edge {node: false, target: Reference {segment: 0, index: 0}})
  run List<Node>.append(&mut builder.nodes, Node {edges: move edges})
  let mut packs = List<ContentHash>.make()
  run List<ContentHash>.append(&mut packs, pack)
  run List<Root>.append(&mut builder.roots, Root {key: run Bytes.copy(b"build"), node: Reference {segment: 0, index: 0},
    answer: run Bytes.copy(answer), packs: move packs})
  let sealed = match move run Segments.seal(move builder, &[]) {
    Option<SealedSegment>.Some {value} => move value
    Option<SealedSegment>.None => { return CompilerBug.panic(b"publication fixture segment must seal") }
  }
  let descriptor = Segments.descriptor(&sealed)
  let mut catalog = List<Descriptor>.make()
  run List<Descriptor>.append(&mut catalog, descriptor)
  let mut owners = List<Frozen<SealedSegment>>.make()
  run List<Frozen<SealedSegment>>.append(&mut owners, run Frozen<SealedSegment>.make(move sealed))
  let mut selections = List<Selection>.make()
  run List<Selection>.append(&mut selections, Selection {segment: descriptor.digest, roots: run Bytes.copy(&[1])})
  let generation = Generation {stamp: run Bytes.copy(b"publication-test"), catalog: move catalog,
    selections: move selections, placements: List<Placement>.make(), certificate: Option<Certificate>.none()}
  return match move run Views.make(move generation, move owners) {
    Option<View>.Some {value} => move value
    Option<View>.None => CompilerBug.panic(b"publication fixture generation must admit")
  }
}
effect fn openSnapshot(root: &Path) -> Publication.Snapshot
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  return match move run Publication.snapshot(root, b"publication-test") {
    Option<Publication.Snapshot>.Some {value} => move value
    Option<Publication.Snapshot>.None => CompilerBug.panic(b"initialized publication fixture must open")
  }
}
effect fn beginWriter(root: &Path, expected: Publication.Token) -> Publication.Writer
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  return match move run Publication.begin(root, expected) {
    Option<Publication.Writer>.Some {value} => move value
    Option<Publication.Writer>.None => CompilerBug.panic(b"fixture expected token must be current")
  }
}
effect fn expectPublished(result: Published) -> () ! AssertionError<'static> {
  match move result {
    Published.Committed {warning, ..} => {
      run Testing.expect(match &warning { Option<AtomicWriteError>.None => true _ => false }, "ordinary publication completes without an atomic-write warning")
    }
    Published.Refused {..} => { run Testing.expect(false, "complete admitted resources publish") }
  }
}
effect fn publicationLifecycle(root: &mut Path) -> ()
! FileError | AtomicWriteError | OutOfMemoryError | AssertionError<'static>
? &mut FileSystem | &mut Allocator {
  let namespace = digest(83)
  drop run Publication.initialize(&root.*, namespace)
  let scoped = run Publication.namespacePath(&root.*, namespace)
  let bytes = b"native-pack-body"
  let pack = ContentHash.of(bytes)
  let view = run publishedView(pack, b"emission-answer")
  let original = run openSnapshot(&root.*)
  run expectPublished(run Publication.publish(run beginWriter(&root.*, original.expected), &original, &view,
    &[Publication.Pack {digest: pack, bytes: bytes}], 1048576))
  run Testing.expect(match move run Publication.begin(&root.*, original.expected) {
    Option<Publication.Writer>.None => true _ => false }, "a writer from the original empty snapshot cannot replace the build")
  let mut buildSnapshot = run openSnapshot(&root.*)
  let loaded = match move run Publication.load(&mut buildSnapshot) {
    Option<View>.Some {value} => move value
    Option<View>.None => { return run Testing.expect(false, "the committed generation loads as a sealed view") }
  }
  // A check contributes no emitted units. Its admitted selected build answer must still retain
  // the prior pack; publication must not derive liveness from today's empty unit list.
  run expectPublished(run Publication.publish(run beginWriter(&root.*, buildSnapshot.expected), &buildSnapshot, &loaded, &[], 1048576))
  let mut afterCheck = run openSnapshot(&root.*)
  let checkView = match move run Publication.load(&mut afterCheck) {
    Option<View>.Some {value} => move value
    Option<View>.None => { return run Testing.expect(false, "check publication preserves the admitted build answer") }
  }
  match move run Publication.readPack(&mut afterCheck, pack) {
    Option<Bytes>.Some {value} => { run Testing.expect(RuntimeEncoding.equals(Bytes.asSlice(&value), bytes), "build after check reads the original selected pack") }
    Option<Bytes>.None => { return run Testing.expect(false, "build pack survives a check without emitted units") }
  }
  let packPath = run Publication.packPath(&scoped, pack)
  run FileSystem.writeFileAtomic(&packPath, b"broken", FileSystem.replaceExisting(), FileSystem.buffered())
  run Testing.expect(match move run Publication.readPack(&mut afterCheck, pack) { Option<Bytes>.None => true _ => false },
    "on-demand pack authentication refuses corrupt external content")
  let refused = run Publication.publish(run beginWriter(&root.*, afterCheck.expected), &afterCheck, &checkView, &[], 1048576)
  run Testing.expect(match &refused { Published.Refused {reason: Refusal.MissingPack} => true _ => false },
    "a known-bad pack cannot use previously admitted presence to publish")
  run expectPublished(run Publication.publish(run beginWriter(&root.*, afterCheck.expected), &afterCheck, &checkView,
    &[Publication.Pack {digest: pack, bytes: bytes}], 1048576))
  let repaired = run FileSystem.readFile(&packPath)
  run Testing.expect(RuntimeEncoding.equals(Bytes.asSlice(&repaired), bytes), "explicit repaired bytes replace a corrupt same-name object")
  let segmentDigest = Segments.descriptor(Frozen<SealedSegment>.get(&Views.segments(&loaded)[0])).digest
  let segmentPath = run Publication.segmentPath(&scoped, segmentDigest)
  run FileSystem.writeFileAtomic(&segmentPath, b"broken-segment", FileSystem.replaceExisting(), FileSystem.buffered())
  let mut invalid = run openSnapshot(&root.*)
  run Testing.expect(match move run Publication.load(&mut invalid) { Option<View>.None => true _ => false },
    "a subsequent reader cannot borrow old validation for corrupt same-name segment bytes")
}

effect fn reservationAndFailure(root: &mut Path) -> ()
! FileError | AtomicWriteError | OutOfMemoryError | AssertionError<'static>
? &mut FileSystem | &mut Allocator {
  let namespace = digest(97)
  drop run Publication.initialize(&root.*, namespace)
  let scoped = run Publication.namespacePath(&root.*, namespace)
  let bytes = b"reserved-pack"
  let pack = ContentHash.of(bytes)
  let view = run publishedView(pack, b"selected-answer")
  let original = run openSnapshot(&root.*)
  let refused = run Publication.publish(run beginWriter(&root.*, original.expected), &original, &view,
    &[Publication.Pack {digest: pack, bytes: bytes}], 0)
  run Testing.expect(match &refused { Published.Refused {reason: Refusal.Space} => true _ => false },
    "space refusal precedes every object write")
  let packPath = run Publication.packPath(&scoped, pack)
  run Testing.expect(!(run FileSystem.exists(&packPath)), "refused reservation creates no native pack")
  let packet = match move run Generations.encode(Views.generation(&view)) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return run Testing.expect(false, "valid view has an encodable descriptor") }
  }
  let descriptorPath = run Publication.generationPath(&scoped, ContentHash.of(Bytes.asSlice(&packet)))
  // Cause a real I/O refusal after segment/pack staging, before current-pointer publication.
  run FileSystem.createDirectoriesRecursively(&descriptorPath)
  let failed = run Effect.result(Publication.publish(run beginWriter(&root.*, original.expected), &original, &view,
    &[Publication.Pack {digest: pack, bytes: bytes}], 1048576))
  run Testing.expect(match &failed {
    Result<Published, FileError | AtomicWriteError | OutOfMemoryError>.Failure {..} => true _ => false },
    "a descriptor-path I/O failure is reported after staging")
  let afterFailure = run openSnapshot(&root.*)
  run Testing.expect(Publication.sameToken(original.expected, afterFailure.expected), "failed descriptor staging leaves the complete prior current pointer unchanged")
  run Testing.expect(run FileSystem.exists(&packPath), "staged objects remain available; failure never deletes possibly reachable bytes")
  run FileSystem.removeDirectoryRecursively(&descriptorPath)
  run expectPublished(run Publication.publish(run beginWriter(&root.*, original.expected), &original, &view,
    &[Publication.Pack {digest: pack, bytes: bytes}], 1048576))
  let current = run openSnapshot(&root.*)
  let spacePath = run Path.join(&scoped, "space")
  run FileSystem.writeFileAtomic(&spacePath, b"bad-accounting", FileSystem.replaceExisting(), FileSystem.buffered())
  let refusedAccounting = run Publication.publish(run beginWriter(&root.*, current.expected), &current, &view,
    &[Publication.Pack {digest: pack, bytes: bytes}], 1048576)
  run Testing.expect(match &refusedAccounting { Published.Refused {reason: Refusal.Accounting} => true _ => false },
    "malformed accounting cannot reset already retained physical debt to zero")
}

effect fn publicationClaims(failure: bool) -> ()
! FileError | AtomicWriteError | OutOfMemoryError | AssertionError<'static>
? &mut FileSystem | &mut Allocator {
  let temporary = run Path.fromBytes(b"/tmp")
  let root = run FileSystem.createTemporaryDirectory(&temporary, b"silk-cache-publication-")
  let use = effect fn(path: &mut Path) -> () ! FileError | AtomicWriteError | OutOfMemoryError | AssertionError<'static>
    ? &mut FileSystem | &mut Allocator {
    if failure { return run reservationAndFailure(&mut path.*) }
    return run publicationLifecycle(&mut path.*)
  }
  let release = effect fn(path: &mut Path) -> () ? &mut FileSystem | &mut Allocator {
    drop run Effect.result(FileSystem.removeDirectoryRecursively(&path.*))
  }
  return run Effect.useReleaseNonParking(move root, move use, move release)
}

test effect fn generationPublicationRetainsSelectedPacksAndRepairsFreshCollisions() -> ()
! FileError | AtomicWriteError | OutOfMemoryError | AssertionError<'static> {
  static if Intrinsic.targetOperatingSystem() == "linux" || Intrinsic.targetOperatingSystem() == "darwin" {
    let mut allocator = Allocator.systemAllocatorProvider()
    let mut files = run MachineFileSystem.make() |> Effect.provideMut<Allocator>(&mut allocator)
    return run publicationClaims(false) |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
  } else { return () }
}

test effect fn generationPublicationReservesBeforeStagingAndPreservesPriorOnFailure() -> ()
! FileError | AtomicWriteError | OutOfMemoryError | AssertionError<'static> {
  static if Intrinsic.targetOperatingSystem() == "linux" || Intrinsic.targetOperatingSystem() == "darwin" {
    let mut allocator = Allocator.systemAllocatorProvider()
    let mut files = run MachineFileSystem.make() |> Effect.provideMut<Allocator>(&mut allocator)
    return run publicationClaims(true) |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
  } else { return () }
}
