//! Structural decoding of evaluated constants into owned driver data.
//!
//! The decoder reads ordinary static values without knowing any source library actor. Record
//! fields and union variants retain declaration order; immutable borrows become owned values.

import semantic.StaticValue as Values { Value }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.reflect { Reflect, unionKind }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.box { Box }
import silk.mem.interned { Interned }
import silk.text.string { String, InvalidUtf8 }
import silk.num.u64
import silk.num.usize

/// An evaluated constant does not have the requested structural shape.
pub struct InvalidStaticData {}

/// An owned representation of an evaluated constant, decoded without running source code.
pub interface StaticDecode {
  /// Reads the exact field and variant structure of this type.
  effect fn read(data: &Interned<Value>) -> Self ! InvalidStaticData | OutOfMemoryError ? &mut Allocator {
    return run derived<Self>(data)
  }
}

/// Decodes a value with an explicit owned destination type.
pub effect fn read<T: StaticDecode>(data: &Interned<Value>) -> T
! InvalidStaticData | OutOfMemoryError ? &mut Allocator {
  let value: T = run StaticDecode.read(data)
  return move value
}

/// Follows immutable static borrows, retaining the referent rather than its source address.
pub fn dereference(data: &Interned<Value>) -> Interned<Value> {
  let mut current = Interned<Value>.clone(data)
  while true {
    let borrowed = Interned<Value>.with<Option<Interned<Value>>>(&current, Values.borrowTarget)
    match move borrowed {
      Option<Interned<Value>>.Some {value} => { current = move value }
      Option<Interned<Value>>.None => { return move current }
    }
  }
}

effect fn field<Owner, T: StaticDecode>(data: &[Interned<Value>], static member: Intrinsic.Field<Owner, T>, cursor: &mut usize) -> T
! InvalidStaticData | OutOfMemoryError ? &mut Allocator {
  let index = cursor.*
  cursor.* = cursor.* + 1
  if index >= data.length { fail InvalidStaticData {} }
  return run read<T>(&data[index])
}

static fn fieldCount<T>() -> usize {
  let mut count: usize = 0
  static for member in Reflect.fields<T>() { count = count + 1 }
  return count
}

static fn variantCount<T>(variant: Intrinsic.Variant<T>) -> usize {
  let mut count: usize = 0
  static for member in Reflect.variantFields(variant) { count = count + 1 }
  return count
}

effect fn derived<T: StaticDecode>(data: &Interned<Value>) -> T
! InvalidStaticData | OutOfMemoryError ? &mut Allocator {
  let owned = dereference(data)
  let value = Interned<Value>.get(&owned)
  if let Value.Aggregate {variant, fields, ..} = &value.* {
    let listed = fields.asSlice()
    static if Reflect.typeKind(Reflect.typeOf<T>()) == unionKind {
      if let Option<usize>.Some {value: tag} = &variant {
        let mut index: usize = 0
        static for selected in Reflect.variants<T>() {
          if tag == index {
            if listed.length != variantCount<T>(selected) { fail InvalidStaticData {} }
            let mut cursor: usize = 0
            return T.[selected] { static for member in Reflect.variantFields(selected) { [member]: run field(listed, member, &mut cursor) } }
          }
          index = index + 1
        }
      }
    } else {
      if variant.isNone() && listed.length == fieldCount<T>() {
        let mut cursor: usize = 0
        return T { static for member in Reflect.fields<T>() { [member]: run field(listed, member, &mut cursor) } }
      }
    }
  }
  fail InvalidStaticData {}
}

impl StaticDecode for String {
  effect fn read(data: &Interned<Value>) -> Self ! InvalidStaticData | OutOfMemoryError ? &mut Allocator {
    if let Option<Bytes>.Some {value} = move run Values.textBytes(data) {
      return match move run String.copyUtf8(value.asSlice()) {
        Result<String, InvalidUtf8>.Success {value: text} => move text
        Result<String, InvalidUtf8>.Failure {..} => { fail InvalidStaticData {} }
      }
    }
    fail InvalidStaticData {}
  }
}

impl StaticDecode for bool {
  effect fn read(data: &Interned<Value>) -> Self ! InvalidStaticData | OutOfMemoryError ? &mut Allocator {
    let owned = dereference(data)
    if let Value.Boolean {value} = &Interned<Value>.get(&owned).* { return value }
    fail InvalidStaticData {}
  }
}

impl StaticDecode for u64 {
  effect fn read(data: &Interned<Value>) -> Self ! InvalidStaticData | OutOfMemoryError ? &mut Allocator {
    let owned = dereference(data)
    if let Option<u64>.Some {value} = Values.unsignedMagnitude(Interned<Value>.get(&owned)) { return value }
    fail InvalidStaticData {}
  }
}

impl StaticDecode for usize {
  effect fn read(data: &Interned<Value>) -> Self ! InvalidStaticData | OutOfMemoryError ? &mut Allocator {
    let value = run read<u64>(data)
    if value > usize.toU64(usize.MAX) { fail InvalidStaticData {} }
    return u64.toUsize(value)
  }
}

impl<T: StaticDecode> StaticDecode for Option<T> {}

impl<T: StaticDecode> StaticDecode for Box<T> {
  effect fn read(data: &Interned<Value>) -> Self ! InvalidStaticData | OutOfMemoryError ? &mut Allocator {
    return run Box<T>.make(run read<T>(data))
  }
}

impl<T: StaticDecode> StaticDecode for List<T> {
  effect fn read(data: &Interned<Value>) -> Self ! InvalidStaticData | OutOfMemoryError ? &mut Allocator {
    let owned = dereference(data)
    let value = Interned<Value>.get(&owned)
    if let Value.Sequence {elements, ..} = &value.* { return run elementsOf<T>(elements.asSlice()) }
    if let Value.Aggregate {fields, variant: Option<usize>.None, ..} = &value.* { return run elementsOf<T>(fields.asSlice()) }
    fail InvalidStaticData {}
  }
}

effect fn elementsOf<T: StaticDecode>(elements: &[Interned<Value>]) -> List<T>
! InvalidStaticData | OutOfMemoryError ? &mut Allocator {
  let mut result = run List<T>.makeWithCapacity(elements.length)
  let mut at: usize = 0
  while at < elements.length {
    run result.append(run read<T>(&elements[at]))
    at = at + 1
  }
  return move result
}
