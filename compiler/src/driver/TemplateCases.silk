//! Template names: one segment is an official example, two a repository root, more a directory
//! inside it, and `@` a revision.

import driver.Template as Templates { Spec, TemplateRefused }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Whether `written` parses to the repository `owner/repository`, `directory` and `revision`, and
// reads back as `shown`.
effect fn names(written: &[u8], owner: &[u8], repository: &[u8], directory: &[u8], revision: &[u8], shown: &[u8]) -> bool
  ! TemplateRefused | OutOfMemoryError
  ? &mut Allocator {
  let spec = run Templates.parse(written)
  let picked = match &spec.revision {
    Option<Bytes>.Some { value } => same(Bytes.asSlice(&value), revision)
    Option<Bytes>.None => revision.length == usize.ZERO
  }
  let spelled = run Templates.spelled(&spec)
  return same(Bytes.asSlice(&spec.owner), owner) && same(Bytes.asSlice(&spec.repository), repository)
    && same(Bytes.asSlice(&spec.directory), directory) && picked && same(Bytes.asSlice(&spelled), shown)
}

effect fn refused(written: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move run Effect.result(Templates.parse(written)) {
    Result<Spec, TemplateRefused | OutOfMemoryError>.Success { .. } => false
    Result<Spec, TemplateRefused | OutOfMemoryError>.Failure { error } => match move error {
      TemplateRefused _refused => true
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn templatePolicy() -> ()
  ! AssertionError<'static> | TemplateRefused | OutOfMemoryError
  ? &mut Allocator {
  let official = run names(b"ui", b"silk-lang", b"examples", b"ui", b"", b"silk-lang/examples/ui")
  let pinned = run names(b"ui@feature/x", b"silk-lang", b"examples", b"ui", b"feature/x", b"silk-lang/examples/ui@feature/x")
  let root = run names(b"julia-script/starter", b"julia-script", b"starter", b"", b"", b"julia-script/starter")
  let nested = run names(b"a/b.c/apps/cli@v1.2", b"a", b"b.c", b"apps/cli", b"v1.2", b"a/b.c/apps/cli@v1.2")
  run Testing.expect(official && pinned && root && nested, "one segment is an official example, two a root, more a directory")
  let example = run Templates.parse(b"ui")
  let url = run Templates.url(&example)
  run Testing.expect(same(Bytes.asSlice(&url), b"https://github.com/silk-lang/examples.git"), "an official example comes from silk-lang/examples")
  let empty = run refused(b"")
  let trailing = run refused(b"a/b/")
  let dots = run refused(b"a/b/../c")
  let owner = run refused(b"-a/b")
  let revision = run refused(b"ui@")
  let refspec = run refused(b"ui@main:other")
  let option = run refused(b"ui@-c")
  run Testing.expect(
    empty && trailing && dots && owner && revision && refspec && option,
    "empty segments, dot segments, option-like owners and revisions git would misread are refused"
  )
}

test effect fn templatesNameARepositoryDirectoryAndRevision() -> ()
  ! AssertionError<'static> | TemplateRefused | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run templatePolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}
