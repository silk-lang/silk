//! Replacing the compiler's process with a built program.
//!
//! `silkc run` hands the terminal to the program it built: the program inherits standard input,
//! output and error, the environment and the working directory, and its exit status or terminating
//! signal becomes the command's own. `silk.child_process` closes a child's input, starts it with an
//! empty environment and captures its output, so this boundary calls POSIX `execv` directly.

import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.filesystem { Path }
import silk.pointer { Pointer }
import silk.usize
import silk.vector { Vector }

unsafe extern "C" fn execv(
  path: ?[*] const u8,
  arguments: ?[*] const ?[*] const u8
) -> i32 with Intrinsic .foreign (noCapture: ("path", "arguments"))

/// The program could not replace this process: `execv` refused it, or an argument contains NUL.
pub struct ReplacementFailure {}

fn containsNul(value: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < value.length {
    if value[at] == 0 {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

effect fn terminated(value: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copy = run Bytes.copy(value)
  let ending: [u8; 1] = [0]
  run Bytes.append(&mut copy, &ending)
  return move copy
}

fn nullBytes() -> ?[*] const u8 {
  unsafe {
    return Intrinsic.pointerRequalify<?*mut u8, ?[*] const u8>(Pointer.null<u8>())
  }
}

/// Replaces this process with `program`, passing its path as argument zero and then `arguments`
/// unchanged. It returns only when the program could not start.
pub effect fn replace(program: &Path, arguments: &[Bytes]) -> ReplacementFailure
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut owned = Vector<Bytes>.make()
  run Vector<Bytes>.append(&mut owned, run terminated(Path.rawBytes(program)))
  let mut at = usize.ZERO
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    if containsNul(argument) {
      return ReplacementFailure {}
    }
    run Vector<Bytes>.append(&mut owned, run terminated(argument))
    at = at + usize.ONE
  }
  let entries = Vector<Bytes>.asSlice(&owned)
  let mut pointers = Vector<?[*] const u8>.make()
  at = usize.ZERO
  while at < entries.length {
    run Vector<
      ?[*] const u8
    >.append(&mut pointers, Pointer.fromSlice<u8>(Bytes.asSlice(&entries[at])))
    at = at + usize.ONE
  }
  run Vector<?[*] const u8>.append(&mut pointers, nullBytes())
  let refused = unsafe execv(
    Pointer.fromSlice<u8>(Bytes.asSlice(&entries[usize.ZERO])),
    Pointer.fromSlice<?[*] const u8>(Vector<?[*] const u8>.asSlice(&pointers)),
  )
  return ReplacementFailure {}
}
