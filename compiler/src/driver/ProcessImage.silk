//! Replacing the compiler's process with a built program.
//!
//! `silk run` hands the terminal to the program it built: the program inherits standard input,
//! output and error, the environment and the working directory, and its exit status or terminating
//! signal becomes the command's own. `silk.system.child_process` closes a child's input, starts it with an
//! empty environment and captures its output, so this boundary calls POSIX `execv` directly.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.system.filesystem { Path }
import silk.mem.pointer { Pointer }
import silk.num.usize
import silk.collections.list { List }

@foreign(noCapture: ("path", "arguments"))
unsafe extern "C" fn execv(
  path: ?[*]const u8,
  arguments: ?[*]const ?[*]const u8
) -> i32

@foreign(noCapture: ("name", "value"))
unsafe extern "C" fn setenv(name: ?[*]const u8, value: ?[*]const u8, overwrite: i32) -> i32

/// Sets the environment variable `name` to `value` for the program that replaces this process,
/// unless the environment already has `name`. Returns false when it could not be set, or `name`
/// or `value` contains NUL.
pub effect fn setVariableDefault(name: &[u8], value: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if containsNul(name) || containsNul(value) { return false }
  let ownedName = run terminated(name)
  let ownedValue = run terminated(value)
  let status = unsafe setenv(Pointer.fromSlice<u8>(Bytes.asSlice(&ownedName)), Pointer.fromSlice<u8>(Bytes.asSlice(&ownedValue)), 0)
  return status == 0
}

/// The program could not replace this process: `execv` refused it, or an argument contains NUL.
pub struct ReplacementFailure {}

fn containsNul(value: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < value.length {
    if value[at] == 0 {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

effect fn terminated(value: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copy = run Bytes.copy(value)
  let ending: [u8; 1] = [0]
  run Bytes.append(&mut copy, &ending)
  return move copy
}

fn nullBytes() -> ?[*]const u8 {
  unsafe {
    return Intrinsic.pointerRequalify<?*mut u8, ?[*]const u8>(Pointer.null<u8>())
  }
}

/// Replaces this process with `program`, passing its path as argument zero and then `arguments`
/// unchanged. It returns only when the program could not start.
pub effect fn replace(program: &Path, arguments: &[Bytes]) -> ReplacementFailure
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut owned = List<Bytes>.make()
  run List<Bytes>.append(&mut owned, run terminated(Path.rawBytes(program)))
  let mut at = usize.ZERO
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    if containsNul(argument) {
      return ReplacementFailure {}
    }
    run List<Bytes>.append(&mut owned, run terminated(argument))
    at = at + usize.ONE
  }
  let entries = List<Bytes>.asSlice(&owned)
  let mut pointers = run List<?[*]const u8>.makeWithCapacity(entries.length)
  at = usize.ZERO
  while at < entries.length {
    run List<?[*]const u8>.append(&mut pointers, Pointer.fromSlice<u8>(Bytes.asSlice(&entries[at])))
    at = at + usize.ONE
  }
  run List<?[*]const u8>.append(&mut pointers, nullBytes())
  let refused = unsafe execv(
    Pointer.fromSlice<u8>(Bytes.asSlice(&entries[usize.ZERO])),
    Pointer.fromSlice<?[*]const u8>(List<?[*]const u8>.asSlice(&pointers)),
  )
  return ReplacementFailure {}
}
