//! Target selectors resolve `host` and canonical names, in order and without repeats.

import driver.TargetSelector as TargetSelectors { UnknownTarget }
import semantic.Target { Id as TargetId, Target }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.result { Result }
import silk.testing { AssertionError, Testing }
import silk.usize
import silk.vector { Vector }

effect fn words(values: &[&[u8]]) -> Vector<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut owned = Vector<Bytes>.make()
  let mut at = usize.ZERO
  while at < values.length {
    run Vector<Bytes>.append(&mut owned, run Bytes.copy(values[at]))
    at = at + usize.ONE
  }
  return move owned
}

effect fn selectorPolicy() -> ()
  ! AssertionError<'static> | UnknownTarget | OutOfMemoryError
  ? &mut Allocator {
  let host = Target.forId(TargetId.Aarch64UnknownLinuxGnu)
  let selectors = run words(&[b"x86_64-unknown-linux-gnu", b"host", b"aarch64-unknown-linux-gnu", b"x86_64-unknown-linux-gnu"])
  let resolved = run TargetSelectors.resolveAll(Vector<Bytes>.asSlice(&selectors), host)
  let targets = Vector<Target>.asSlice(&resolved)
  run Testing.expect(
    targets.length == 2 && Target.id(&targets[0]) == TargetId.X8664UnknownLinuxGnu
      && Target.id(&targets[1]) == TargetId.Aarch64UnknownLinuxGnu,
    "host resolves to the host target and a repeated target keeps its first position"
  )
  run Testing.expect(
    TargetSelectors.isSelector(b"host") && TargetSelectors.isSelector(b"wasm32-unknown-unknown")
      && !TargetSelectors.isSelector(b"Host") && !TargetSelectors.isSelector(b"x86_64"),
    "only host and canonical names are selectors"
  )
  let unknown = run words(&[b"host", b"mips"])
  let refused = match move run Effect.result(TargetSelectors.resolveAll(Vector<Bytes>.asSlice(&unknown), host)) {
    Result<Vector<Target>, UnknownTarget | OutOfMemoryError>.Success { value: _ } => false
    Result<Vector<Target>, UnknownTarget | OutOfMemoryError>.Failure { error } => match move error {
      UnknownTarget {..} => true
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  run Testing.expect(refused, "an unknown selector is refused")
}

test effect fn targetSelectorsResolveInOrder() -> ()
  ! AssertionError<'static> | UnknownTarget | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run selectorPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}
