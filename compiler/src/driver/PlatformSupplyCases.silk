//! A macOS SDK comes from SDKROOT or host-only xcrun discovery, and is validated before any link;
//! an explicit project supply replaces discovery, and a managed one is refused. Every host input,
//! file and tool run is supplied by fakes.

import driver.PlatformSupply as PlatformSupplies { Installation, Request, Supply, SupplyError, SupplyFile }
import semantic.Target { Target }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.system.child_process { ChildProcess, ProcessError, ProcessOutcome, ProcessRequest }
import silk.core.effect { Effect }
import silk.system.filesystem { AtomicWriteError, DirectoryEntry, DirectoryInfo, Durability, FileError, FileInfo, FileSystem, Path, PublicationPolicy }
import silk.system.host_input { HostInput, HostInputError }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.text.string { String }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize
import silk.collections.list { List }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// The host environment: which of SDKROOT and DEVELOPER_DIR are set.
struct Environment {
  sdkRoot: Option<Bytes>,
  developer: bool,
}

// The tool runner: the xcrun answer, and what it was asked.
struct Runner {
  xcrunStatus: i32,
  runs: usize,
  arguments: Bytes,
  environment: Bytes,
}

// One resolution's host: its environment and its tool runner.
struct Host {
  input: Environment,
  runner: Runner,
}

fn host() -> Host {
  return Host {
    input: Environment { sdkRoot: Option<Bytes>.none(), developer: false },
    runner: Runner { xcrunStatus: 0, runs: 0, arguments: Bytes.make(), environment: Bytes.make() },
  }
}

impl Environment {
  effect fn argumentCount(self: &mut Self) -> usize ! HostInputError {
    return 0
  }

  effect fn argument(self: &mut Self, index: usize) -> Option<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator {
    return Option<Bytes>.none()
  }

  effect fn workingDirectory(self: &mut Self) -> Bytes ! HostInputError | OutOfMemoryError ? &mut Allocator {
    return run Bytes.copy(b"/working")
  }

  effect fn variable(self: &mut Self, name: &[u8]) -> Option<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator {
    if same(name, b"SDKROOT") {
      return match &self.sdkRoot {
        Option<Bytes>.Some { value } => Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&value)))
        Option<Bytes>.None => Option<Bytes>.none()
      }
    }
    if same(name, b"DEVELOPER_DIR") {
      if self.developer {
        return Option<Bytes>.some(run Bytes.copy(b"/Applications/Xcode.app/Contents/Developer"))
      }
      return Option<Bytes>.none()
    }
    if same(name, b"PATH") {
      return Option<Bytes>.some(run Bytes.copy(b"/missing:/usr/bin"))
    }
    // No other ambient variable may select or alter the supply.
    fail HostInput.inputFailure()
  }
}

impl Runner {
  effect fn execute(self: &mut Self, request: &ProcessRequest) -> ProcessOutcome ! ProcessError | OutOfMemoryError ? &mut Allocator {
    self.runs = self.runs + usize.ONE
    self.arguments = run Bytes.copy(ChildProcess.arguments(request))
    self.environment = run Bytes.copy(ChildProcess.environment(request))
    if !same(ChildProcess.program(request), b"/usr/bin/xcrun") {
      fail ChildProcess.failure(ChildProcess.spawnOperation(), ChildProcess.notFound())
    }
    if self.xcrunStatus != 0 {
      return ChildProcess.exited(self.xcrunStatus, Bytes.make(), run Bytes.copy(b"xcrun: error: SDK \"macosx\" cannot be located\n"))
    }
    return ChildProcess.exited(0, run Bytes.copy(b"/sdk/Good.sdk\n"), Bytes.make())
  }
}

impl HostInput for Environment {
  argumentCount: Environment.argumentCount
  argument: Environment.argument
  workingDirectory: Environment.workingDirectory
  variable: Environment.variable
}

impl ChildProcess for Runner {
  execute: Runner.execute
}

// The SDKs on disk; `changed` rewrites the libSystem contract after resolution.
struct Disk {
  changed: bool,
}

impl Disk {
  effect fn readFile(self: &mut Self, path: &Path) -> Bytes ! FileError | OutOfMemoryError ? &mut Allocator {
    let name = Path.rawBytes(path)
    if same(name, b"/sdk/Good.sdk/SDKSettings.json") {
      return run Bytes.copy(String.utf8Bytes("""
{"CanonicalName":"macosx15.5","CustomProperties":{"KERNEL_EXTENSION_HEADER_SEARCH_PATHS":"$(KERNEL_FRAMEWORK)/PrivateHeaders $(KERNEL_FRAMEWORK_HEADERS)"},"DefaultDeploymentTarget":"15.5","DefaultProperties":{"DEFAULT_KEXT_INSTALL_PATH":"$(SYSTEM_LIBRARY_DIR)/Extensions","PLATFORM_NAME":"macosx"},"DisplayName":"macOS 15.5","IsBaseSDK":"YES","MaximumDeploymentTarget":"15.5.99","MinimalDisplayName":"15.5","SupportedTargets":{"iosmac":{"Archs":["x86_64","arm64","arm64e"],"MinimumDeploymentTarget":"13.1"},"macosx":{"Archs":["x86_64","x86_64h","arm64","arm64e"],"BuildVersionPlatformID":"1","ClangRuntimeLibraryPlatformName":"osx","DefaultDeploymentTarget":"15.5","DeploymentTargetSettingName":"MACOSX_DEPLOYMENT_TARGET","MaximumDeploymentTarget":"15.5.99","MinimumDeploymentTarget":"10.13","ValidDeploymentTargets":["10.13","10.14","11.0","12.0","13.0","14.0","15.0","15.5"]}},"Version":"15.5","VersionMap":{"iOSMac_macOS":{"13.1":"10.15"},"macOS_iOSMac":{"10.15":"13.1"}}}
"""))
    }
    if same(name, b"/sdk/Intel.sdk/SDKSettings.json") {
      return run Bytes.copy(String.utf8Bytes("""
{"Version": "13.0", "SupportedTargets": {"macosx": {"Archs": ["x86_64"]}}}
"""))
    }
    if same(name, b"/sdk/Good.sdk/usr/lib/libSystem.tbd") || same(name, b"/sdk/Intel.sdk/usr/lib/libSystem.tbd") {
      if self.changed {
        return run Bytes.copy(b"targets: [ arm64-macos ]\ninstall-name: '/usr/lib/libSystem.B.dylib'\n")
      }
      return run Bytes.copy(b"targets: [ x86_64-macos, arm64-macos ]\ninstall-name: '/usr/lib/libSystem.B.dylib'\n")
    }
    if same(name, b"/usr/bin/xcrun") {
      return run Bytes.copy(b"xcrun executable")
    }
    if same(name, b"/tools/ld.lld") {
      return run Bytes.copy(b"linker executable")
    }
    fail FileSystem.error(FileSystem.readFileOperation(), FileSystem.notFound())
  }

  effect fn writeFile(self: &mut Self, path: &Path, bytes: &[u8]) -> () ! FileError {
    fail FileSystem.error(FileSystem.writeFileOperation(), FileSystem.unsupported())
  }

  effect fn createFile(self: &mut Self, path: &Path, bytes: &[u8]) -> () ! FileError {
    fail FileSystem.error(FileSystem.createFileOperation(), FileSystem.unsupported())
  }

  effect fn writeFileAtomic(
    self: &mut Self,
    path: &Path,
    bytes: &[u8],
    policy: PublicationPolicy,
    durability: Durability,
  ) -> () ! AtomicWriteError {
    fail AtomicWriteError {
      published: false,
      cause: FileSystem.error(FileSystem.writeFileAtomicOperation(), FileSystem.unsupported()),
      cleanupError: Option<FileError>.None,
      stagingName: Bytes.make(),
    }
  }

  effect fn syncDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    fail FileSystem.error(FileSystem.syncDirectoryOperation(), FileSystem.unsupported())
  }

  effect fn stat(self: &mut Self, path: &Path) -> FileInfo | DirectoryInfo ! FileError {
    if same(Path.rawBytes(path), b"/usr/bin/xcrun") || same(Path.rawBytes(path), b"/tools/ld.lld") {
      return FileSystem.fileInfo(0)
    }
    fail FileSystem.error(FileSystem.statOperation(), FileSystem.notFound())
  }

  effect fn listDirectory(self: &mut Self, path: &Path) -> List<DirectoryEntry> ! FileError | OutOfMemoryError ? &mut Allocator {
    fail FileSystem.error(FileSystem.listDirectoryOperation(), FileSystem.unsupported())
  }

  effect fn createDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    fail FileSystem.error(FileSystem.createDirectoryOperation(), FileSystem.unsupported())
  }

  effect fn removeFile(self: &mut Self, path: &Path) -> () ! FileError {
    fail FileSystem.error(FileSystem.removeFileOperation(), FileSystem.unsupported())
  }

  effect fn removeDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    fail FileSystem.error(FileSystem.removeDirectoryOperation(), FileSystem.unsupported())
  }

  effect fn createTemporaryDirectory(self: &mut Self, path: &Path, prefix: &[u8]) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    fail FileSystem.error(FileSystem.createTemporaryDirectoryOperation(), FileSystem.unsupported())
  }
}

impl FileSystem for Disk {
  readFile: Disk.readFile
  writeFile: Disk.writeFile
  createFile: Disk.createFile
  writeFileAtomic: Disk.writeFileAtomic
  syncDirectory: Disk.syncDirectory
  stat: Disk.stat
  listDirectory: Disk.listDirectory
  createDirectory: Disk.createDirectory
  removeFile: Disk.removeFile
  removeDirectory: Disk.removeDirectory
  createTemporaryDirectory: Disk.createTemporaryDirectory
}

fn darwin() -> Target {
  return match move Target.resolve(b"aarch64-apple-darwin") {
    Option<Target>.Some { value } => value
    Option<Target>.None => Target.forId(Target.id(&linux()))
  }
}

fn linux() -> Target {
  return match move Target.resolve(b"x86_64-unknown-linux-gnu") {
    Option<Target>.Some { value } => value
    Option<Target>.None => Target.forId(Target.id(&darwin()))
  }
}

// One automatic resolution against `machine` on `onHost`, with `deployment`, through the fake host
// and disk.
effect fn attempt(machine: &Target, onHost: &Target, deployment: &[u8], provider: &mut Host) -> Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>
  ? &mut Allocator {
  let automatic = Request.Automatic
  return run requested(machine, onHost, deployment, &automatic, &mut provider.*)
}

// One resolution of `request` against `machine` on `onHost`, through the fake host and disk.
effect fn requested(machine: &Target, onHost: &Target, deployment: &[u8], request: &Request, provider: &mut Host) -> Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>
  ? &mut Allocator {
  let mut disk = Disk { changed: false }
  return run Effect.result(
    PlatformSupplies.resolve(machine, onHost, b"system", deployment, request)
      |> Effect.provideMut<HostInput>(&mut provider.input)
      |> Effect.provideMut<ChildProcess>(&mut provider.runner)
      |> Effect.provideMut<FileSystem>(&mut disk)
  )
}

// The code of a refused resolution, empty when it succeeded or failed otherwise.
fn refusal(outcome: &Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>) -> &'static [u8] {
  return match &outcome.* {
    Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Failure { error } => match &error {
      SupplyError refused => refused.code
      _ => b""
    }
    Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Success { .. } => b""
  }
}

effect fn supplyPolicy() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let mac = darwin()
  let other = linux()

  let mut plain = host()
  let none = run attempt(&other, &other, b"", &mut plain)
  let noSupply = match &none {
    Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Success { value } => match &value {
      Option<Supply>.Some { .. } => false
      Option<Supply>.None => true
    }
    Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Failure { .. } => false
  }
  run Testing.expect(noSupply && plain.runner.runs == 0, "a GNU/Linux target resolves no SDK and runs no tool")

  let mut explicit = host()
  explicit.input.sdkRoot = Option<Bytes>.some(run Bytes.copy(b"/sdk/Good.sdk"))
  let fromEnvironment = run attempt(&mac, &other, b"", &mut explicit)
  let environmentOk = match &fromEnvironment {
    Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Success { value } => match &value {
      Option<Supply>.Some { value: supply } => same(Path.rawBytes(&supply.root), b"/sdk/Good.sdk")
        && same(Bytes.asSlice(&supply.origin), b"SDKROOT") && same(Bytes.asSlice(&supply.deployment), b"11.0.0")
        && same(Bytes.asSlice(&supply.version), b"15.5") && List<SupplyFile>.length(&supply.files) == 2
      Option<Supply>.None => false
    }
    Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Failure { .. } => false
  }
  run Testing.expect(
    environmentOk && explicit.runner.runs == 0,
    "a valid SDKROOT is the SDK, with the default 11.0.0 deployment, for any target and without discovery"
  )

  let mut relative = host()
  relative.input.sdkRoot = Option<Bytes>.some(run Bytes.copy(b"sdk/Good.sdk"))
  let relativeOutcome = run attempt(&mac, &mac, b"", &mut relative)
  let mut missing = host()
  missing.input.sdkRoot = Option<Bytes>.some(run Bytes.copy(b"/sdk/Missing.sdk"))
  let missingOutcome = run attempt(&mac, &mac, b"", &mut missing)
  let mut intel = host()
  intel.input.sdkRoot = Option<Bytes>.some(run Bytes.copy(b"/sdk/Intel.sdk"))
  let intelOutcome = run attempt(&mac, &mac, b"", &mut intel)
  run Testing.expect(
    same(refusal(&relativeOutcome), b"InvalidConfiguration") && same(refusal(&missingOutcome), b"StorageFailed")
      && same(refusal(&intelOutcome), b"TargetMismatch") && relative.runner.runs == 0 && missing.runner.runs == 0 && intel.runner.runs == 0,
    "an invalid SDKROOT fails and never falls back to discovery"
  )

  let mut early = host()
  early.input.sdkRoot = Option<Bytes>.some(run Bytes.copy(b"/sdk/Good.sdk"))
  let earlyOutcome = run attempt(&mac, &mac, b"10.15", &mut early)
  let mut late = host()
  late.input.sdkRoot = Option<Bytes>.some(run Bytes.copy(b"/sdk/Good.sdk"))
  let lateOutcome = run attempt(&mac, &mac, b"16.0", &mut late)
  run Testing.expect(
    same(refusal(&earlyOutcome), b"DeploymentMismatch") && same(refusal(&lateOutcome), b"DeploymentMismatch"),
    "a deployment below 11.0.0 or above the SDK's maximum is refused, never raised"
  )

  let mut discovering = host()
  discovering.input.developer = true
  let discovered = run attempt(&mac, &mac, b"14.0", &mut discovering)
  let mut discoveredOk = false
  if let Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Success { value } = &discovered {
    if let Option<Supply>.Some { value: supply } = &value {
      let developer = match &supply.developerDirectory {
        Option<Bytes>.Some { value: directory } => same(Bytes.asSlice(&directory), b"/Applications/Xcode.app/Contents/Developer")
        Option<Bytes>.None => false
      }
      let files = List<SupplyFile>.asSlice(&supply.files)
      let recorded = files.length == 3 && same(Path.rawBytes(&files[0].path), b"/usr/bin/xcrun")
        && same(files[0].purpose, b"support") && same(files[1].purpose, b"metadata") && same(files[2].purpose, b"stub")
      discoveredOk = developer && recorded && same(Path.rawBytes(&supply.root), b"/sdk/Good.sdk")
        && same(Bytes.asSlice(&supply.origin), b"SDK discovery") && same(Bytes.asSlice(&supply.deployment), b"14.0")
    }
  }
  run Testing.expect(discoveredOk, "without SDKROOT the host target discovers its SDK through xcrun")
  run Testing.expect(
    discovering.runner.runs == 1 && same(Bytes.asSlice(&discovering.runner.arguments), b"--sdk\0macosx\0--show-sdk-path\0")
      && same(Bytes.asSlice(&discovering.runner.environment), b"PATH=/missing:/usr/bin\0DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer\0"),
    "discovery runs the first xcrun on PATH with exactly PATH and DEVELOPER_DIR"
  )

  let mut foreign = host()
  let foreignOutcome = run attempt(&mac, &other, b"", &mut foreign)
  let mut broken = host()
  broken.runner.xcrunStatus = 1
  let brokenOutcome = run attempt(&mac, &mac, b"", &mut broken)
  run Testing.expect(
    same(refusal(&foreignOutcome), b"HostMismatch") && foreign.runner.runs == 0
      && same(refusal(&brokenOutcome), b"QueryFailed") && broken.runner.runs == 1,
    "discovery runs only for the host target, and a failed query refuses the build"
  )

  let mut environment = Environment { sdkRoot: Option<Bytes>.some(run Bytes.copy(b"/sdk/Good.sdk")), developer: false }
  let mut runner = Runner { xcrunStatus: 0, runs: 0, arguments: Bytes.make(), environment: Bytes.make() }
  let mut disk = Disk { changed: false }
  let automatic = Request.Automatic
  let resolved = run Effect.result(
    PlatformSupplies.resolve(&mac, &mac, b"system", b"", &automatic)
      |> Effect.provideMut<HostInput>(&mut environment)
      |> Effect.provideMut<ChildProcess>(&mut runner)
      |> Effect.provideMut<FileSystem>(&mut disk)
  )
  let mut unchanged = false
  let mut rejected = false
  if let Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Success { value } = &resolved {
    if let Option<Supply>.Some { value: supply } = &value {
      let first = run Effect.result(PlatformSupplies.validate(&supply) |> Effect.provideMut<FileSystem>(&mut disk))
      unchanged = match &first {
        Result<(), SupplyError | OutOfMemoryError>.Success { .. } => true
        Result<(), SupplyError | OutOfMemoryError>.Failure { .. } => false
      }
      disk.changed = true
      let second = run Effect.result(PlatformSupplies.validate(&supply) |> Effect.provideMut<FileSystem>(&mut disk))
      rejected = match &second {
        Result<(), SupplyError | OutOfMemoryError>.Failure { error } => match &error {
          SupplyError changed => same(changed.code, b"ChangedInput") && same(Bytes.asSlice(&changed.subject), b"/sdk/Good.sdk/usr/lib/libSystem.tbd")
          _ => false
        }
        Result<(), SupplyError | OutOfMemoryError>.Success { .. } => false
      }
    }
  }
  run Testing.expect(unchanged && rejected, "a link consumes the supply only while its selected files keep their recorded bytes")
}

// An explicit request for `target` with `root`, linker `linker` and `support` installations.
effect fn explicit(target: &[u8], root: &[u8], linker: &[u8], support: List<Installation>) -> Request ! FileError | OutOfMemoryError ? &mut Allocator {
  return Request.Explicit {
    target: run Bytes.copy(target),
    root: run Path.fromBytes(root),
    linker: run Path.fromBytes(linker),
    origin: run Bytes.copy(b"silk.toml:native.platform-supply"),
    support: move support,
  }
}

effect fn installation(root: &[u8], target: &[u8]) -> Installation ! FileError | OutOfMemoryError ? &mut Allocator {
  return Installation { root: run Path.fromBytes(root), target: run Bytes.copy(target), origin: run Bytes.copy(b"gcc") }
}

effect fn explicitPolicy() -> () ! AssertionError<'static> | FileError | OutOfMemoryError ? &mut Allocator {
  let mac = darwin()
  let other = linux()

  let sdkRequest = run explicit(b"aarch64-apple-darwin", b"/sdk/Good.sdk", b"/tools/ld.lld", List<Installation>.make())
  let mut ambient = host()
  ambient.input.sdkRoot = Option<Bytes>.some(run Bytes.copy(b"/sdk/Intel.sdk"))
  let fromProject = run requested(&mac, &other, b"", &sdkRequest, &mut ambient)
  let mut projectOk = false
  if let Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Success { value } = &fromProject {
    if let Option<Supply>.Some { value: supply } = &value {
      let linked = match &supply.linker {
        Option<Path>.Some { value: linker } => same(Path.rawBytes(&linker), b"/tools/ld.lld")
        Option<Path>.None => false
      }
      let files = List<SupplyFile>.asSlice(&supply.files)
      projectOk = linked && supply.darwin && same(Path.rawBytes(&supply.root), b"/sdk/Good.sdk")
        && same(Bytes.asSlice(&supply.origin), b"silk.toml:native.platform-supply")
        && files.length == 3 && same(files[0].purpose, b"linker")
    }
  }
  run Testing.expect(
    projectOk && ambient.runner.runs == 0,
    "an explicit macOS supply is the SDK and linker for a foreign host, ignoring SDKROOT and never discovering"
  )

  let mut support = List<Installation>.make()
  run List<Installation>.append(&mut support, run installation(b"/gcc/13", b"x86_64-unknown-linux-gnu"))
  let sysrootRequest = run explicit(b"x86_64-unknown-linux-gnu", b"/sysroot", b"/tools/ld.lld", move support)
  let mut gnu = host()
  let fromSysroot = run requested(&other, &mac, b"", &sysrootRequest, &mut gnu)
  let mut sysrootOk = false
  if let Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Success { value } = &fromSysroot {
    if let Option<Supply>.Some { value: supply } = &value {
      let supported = match &supply.support {
        Option<Path>.Some { value: directory } => same(Path.rawBytes(&directory), b"/gcc/13")
        Option<Path>.None => false
      }
      sysrootOk = supported && !supply.darwin && same(Path.rawBytes(&supply.root), b"/sysroot")
    }
  }
  run Testing.expect(sysrootOk && gnu.runner.runs == 0, "an explicit GNU/Linux supply names its sysroot, compiler support and linker")

  let mut wrongSupport = List<Installation>.make()
  run List<Installation>.append(&mut wrongSupport, run installation(b"/gcc/13", b"aarch64-unknown-linux-gnu"))
  let mismatchedSupport = run explicit(b"x86_64-unknown-linux-gnu", b"/sysroot", b"/tools/ld.lld", move wrongSupport)
  let mut supportHost = host()
  let supportOutcome = run requested(&other, &other, b"", &mismatchedSupport, &mut supportHost)
  let mut foreignHost = host()
  let foreignOutcome = run requested(&mac, &mac, b"", &sysrootRequest, &mut foreignHost)
  run Testing.expect(
    same(refusal(&foreignOutcome), b"TargetMismatch") && same(refusal(&supportOutcome), b"TargetMismatch"),
    "an explicit supply or its compiler support for another target is refused"
  )

  let missingLinker = run explicit(b"aarch64-apple-darwin", b"/sdk/Good.sdk", b"/tools/missing", List<Installation>.make())
  let mut linkerHost = host()
  let linkerOutcome = run requested(&mac, &mac, b"", &missingLinker, &mut linkerHost)
  let managed = Request.Managed { name: run Bytes.copy(b"silk-sdk") }
  let mut managedHost = host()
  let managedOutcome = run requested(&mac, &mac, b"", &managed, &mut managedHost)
  run Testing.expect(
    same(refusal(&linkerOutcome), b"MissingCapability") && same(refusal(&managedOutcome), b"UnsupportedProvider")
      && linkerHost.runner.runs == 0 && managedHost.runner.runs == 0,
    "a missing explicit linker and a managed supply are refused without discovery"
  )
}

test effect fn projectSuppliesReplaceDiscovery() -> () ! AssertionError<'static> | FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run explicitPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn macosSdksComeFromSdkrootOrHostDiscovery() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run supplyPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}
