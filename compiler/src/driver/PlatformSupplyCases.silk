//! A macOS SDK comes from SDKROOT or host-only xcrun discovery, and is validated before any link,
//! with every host input, file and tool run supplied by fakes.

import driver.PlatformSupply as PlatformSupplies { Supply, SupplyError }
import semantic.Target { Target }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.child_process { ChildProcess, ProcessError, ProcessOutcome, ProcessRequest }
import silk.effect { Effect }
import silk.filesystem { DirectoryEntry, DirectoryInfo, FileError, FileInfo, FileSystem, Path }
import silk.host_input { HostInput, HostInputError }
import silk.option { Option }
import silk.result { Result }
import silk.string { String }
import silk.testing { AssertionError, Testing }
import silk.usize
import silk.vector { Vector }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// The host environment: which of SDKROOT and DEVELOPER_DIR are set.
struct Environment {
  sdkRoot: Option<Bytes>
  developer: bool
}

// The tool runner: the xcrun answer, and what it was asked.
struct Runner {
  xcrunStatus: i32
  runs: usize
  arguments: Bytes
  environment: Bytes
}

// One resolution's host: its environment and its tool runner.
struct Host {
  input: Environment
  runner: Runner
}

fn host() -> Host {
  return Host {
    input: Environment { sdkRoot: Option<Bytes>.none(), developer: false },
    runner: Runner { xcrunStatus: 0, runs: 0, arguments: Bytes.make(), environment: Bytes.make() },
  }
}

impl Environment {
  effect fn argumentCount(self: &mut Self) -> usize ! HostInputError {
    return 0
  }

  effect fn argument(self: &mut Self, index: usize) -> Option<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator {
    return Option<Bytes>.none()
  }

  effect fn workingDirectory(self: &mut Self) -> Bytes ! HostInputError | OutOfMemoryError ? &mut Allocator {
    return run Bytes.copy(b"/working")
  }

  effect fn variable(self: &mut Self, name: &[u8]) -> Option<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator {
    if same(name, b"SDKROOT") {
      return match &self.sdkRoot {
        Option<Bytes>.Some { value } => Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&value)))
        Option<Bytes>.None => Option<Bytes>.none()
      }
    }
    if same(name, b"DEVELOPER_DIR") {
      if self.developer {
        return Option<Bytes>.some(run Bytes.copy(b"/Applications/Xcode.app/Contents/Developer"))
      }
      return Option<Bytes>.none()
    }
    if same(name, b"PATH") {
      return Option<Bytes>.some(run Bytes.copy(b"/missing:/usr/bin"))
    }
    // No other ambient variable may select or alter the supply.
    fail HostInput.inputFailure()
  }
}

impl Runner {
  effect fn execute(self: &mut Self, request: &ProcessRequest) -> ProcessOutcome ! ProcessError | OutOfMemoryError ? &mut Allocator {
    self.runs = self.runs + usize.ONE
    self.arguments = run Bytes.copy(ChildProcess.arguments(request))
    self.environment = run Bytes.copy(ChildProcess.environment(request))
    if !same(ChildProcess.program(request), b"/usr/bin/xcrun") {
      fail ChildProcess.failure(ChildProcess.spawnOperation(), ChildProcess.notFound())
    }
    if self.xcrunStatus != 0 {
      return ChildProcess.exited(self.xcrunStatus, Bytes.make(), run Bytes.copy(b"xcrun: error: SDK \"macosx\" cannot be located\n"))
    }
    return ChildProcess.exited(0, run Bytes.copy(b"/sdk/Good.sdk\n"), Bytes.make())
  }
}

impl HostInput for Environment {
  argumentCount: Environment.argumentCount
  argument: Environment.argument
  workingDirectory: Environment.workingDirectory
  variable: Environment.variable
}

impl ChildProcess for Runner {
  execute: Runner.execute
}

struct Disk {}

impl Disk {
  effect fn readFile(self: &mut Self, path: &Path) -> Bytes ! FileError | OutOfMemoryError ? &mut Allocator {
    let name = Path.rawBytes(path)
    if same(name, b"/sdk/Good.sdk/SDKSettings.json") {
      return run Bytes.copy(String.utf8Bytes("""
{"Version": "15.5", "SupportedTargets": {"macosx": {"Archs": ["x86_64", "arm64"], "MinimumDeploymentTarget": "10.13", "MaximumDeploymentTarget": "15.5.99"}}}
"""))
    }
    if same(name, b"/sdk/Intel.sdk/SDKSettings.json") {
      return run Bytes.copy(String.utf8Bytes("""
{"Version": "13.0", "SupportedTargets": {"macosx": {"Archs": ["x86_64"]}}}
"""))
    }
    if same(name, b"/sdk/Good.sdk/usr/lib/libSystem.tbd") || same(name, b"/sdk/Intel.sdk/usr/lib/libSystem.tbd") {
      return run Bytes.copy(b"targets: [ x86_64-macos, arm64-macos ]\ninstall-name: '/usr/lib/libSystem.B.dylib'\n")
    }
    fail FileSystem.error(FileSystem.readFileOperation(), FileSystem.notFound())
  }

  effect fn writeFile(self: &mut Self, path: &Path, bytes: &[u8]) -> () ! FileError {
    fail FileSystem.error(FileSystem.writeFileOperation(), FileSystem.unsupported())
  }

  effect fn stat(self: &mut Self, path: &Path) -> FileInfo | DirectoryInfo ! FileError {
    if same(Path.rawBytes(path), b"/usr/bin/xcrun") {
      return FileSystem.fileInfo(0)
    }
    fail FileSystem.error(FileSystem.statOperation(), FileSystem.notFound())
  }

  effect fn listDirectory(self: &mut Self, path: &Path) -> Vector<DirectoryEntry> ! FileError | OutOfMemoryError ? &mut Allocator {
    fail FileSystem.error(FileSystem.listDirectoryOperation(), FileSystem.unsupported())
  }

  effect fn createDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    fail FileSystem.error(FileSystem.createDirectoryOperation(), FileSystem.unsupported())
  }

  effect fn removeFile(self: &mut Self, path: &Path) -> () ! FileError {
    fail FileSystem.error(FileSystem.removeFileOperation(), FileSystem.unsupported())
  }

  effect fn removeDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    fail FileSystem.error(FileSystem.removeDirectoryOperation(), FileSystem.unsupported())
  }

  effect fn createTemporaryDirectory(self: &mut Self, path: &Path, prefix: &[u8]) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    fail FileSystem.error(FileSystem.createTemporaryDirectoryOperation(), FileSystem.unsupported())
  }
}

impl FileSystem for Disk {
  readFile: Disk.readFile
  writeFile: Disk.writeFile
  stat: Disk.stat
  listDirectory: Disk.listDirectory
  createDirectory: Disk.createDirectory
  removeFile: Disk.removeFile
  removeDirectory: Disk.removeDirectory
  createTemporaryDirectory: Disk.createTemporaryDirectory
}

fn darwin() -> Target {
  return match move Target.resolve(b"aarch64-apple-darwin") {
    Option<Target>.Some { value } => value
    Option<Target>.None => Target.forId(Target.id(&linux()))
  }
}

fn linux() -> Target {
  return match move Target.resolve(b"x86_64-unknown-linux-gnu") {
    Option<Target>.Some { value } => value
    Option<Target>.None => Target.forId(Target.id(&darwin()))
  }
}

// One resolution against `machine` on `onHost`, with `deployment`, through the fake host and disk.
effect fn attempt(machine: &Target, onHost: &Target, deployment: &[u8], provider: &mut Host) -> Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>
  ? &mut Allocator {
  let mut disk = Disk {}
  return run Effect.result(
    PlatformSupplies.resolve(machine, onHost, b"system", deployment)
      |> Effect.provideMut<HostInput>(&mut provider.input)
      |> Effect.provideMut<ChildProcess>(&mut provider.runner)
      |> Effect.provideMut<FileSystem>(&mut disk)
  )
}

// The code of a refused resolution, empty when it succeeded or failed otherwise.
fn refusal(outcome: &Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>) -> &'static [u8] {
  return match &outcome.* {
    Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Failure { error } => match &error {
      SupplyError refused => refused.code
      _ => b""
    }
    Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Success { .. } => b""
  }
}

effect fn supplyPolicy() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let mac = darwin()
  let other = linux()

  let mut plain = host()
  let none = run attempt(&other, &other, b"", &mut plain)
  let noSupply = match &none {
    Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Success { value } => match &value {
      Option<Supply>.Some { .. } => false
      Option<Supply>.None => true
    }
    Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Failure { .. } => false
  }
  run Testing.expect(noSupply && plain.runner.runs == 0, "a GNU/Linux target resolves no SDK and runs no tool")

  let mut explicit = host()
  explicit.input.sdkRoot = Option<Bytes>.some(run Bytes.copy(b"/sdk/Good.sdk"))
  let fromEnvironment = run attempt(&mac, &other, b"", &mut explicit)
  let environmentOk = match &fromEnvironment {
    Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Success { value } => match &value {
      Option<Supply>.Some { value: supply } => same(Path.rawBytes(&supply.root), b"/sdk/Good.sdk")
        && same(Bytes.asSlice(&supply.origin), b"SDKROOT") && same(Bytes.asSlice(&supply.deployment), b"11.0.0")
        && same(Bytes.asSlice(&supply.version), b"15.5")
      Option<Supply>.None => false
    }
    Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Failure { .. } => false
  }
  run Testing.expect(
    environmentOk && explicit.runner.runs == 0,
    "a valid SDKROOT is the SDK, with the default 11.0.0 deployment, for any target and without discovery"
  )

  let mut relative = host()
  relative.input.sdkRoot = Option<Bytes>.some(run Bytes.copy(b"sdk/Good.sdk"))
  let relativeOutcome = run attempt(&mac, &mac, b"", &mut relative)
  let mut missing = host()
  missing.input.sdkRoot = Option<Bytes>.some(run Bytes.copy(b"/sdk/Missing.sdk"))
  let missingOutcome = run attempt(&mac, &mac, b"", &mut missing)
  let mut intel = host()
  intel.input.sdkRoot = Option<Bytes>.some(run Bytes.copy(b"/sdk/Intel.sdk"))
  let intelOutcome = run attempt(&mac, &mac, b"", &mut intel)
  run Testing.expect(
    same(refusal(&relativeOutcome), b"InvalidConfiguration") && same(refusal(&missingOutcome), b"InvalidConfiguration")
      && same(refusal(&intelOutcome), b"TargetMismatch") && relative.runner.runs == 0 && missing.runner.runs == 0 && intel.runner.runs == 0,
    "an invalid SDKROOT fails and never falls back to discovery"
  )

  let mut early = host()
  early.input.sdkRoot = Option<Bytes>.some(run Bytes.copy(b"/sdk/Good.sdk"))
  let earlyOutcome = run attempt(&mac, &mac, b"10.15", &mut early)
  let mut late = host()
  late.input.sdkRoot = Option<Bytes>.some(run Bytes.copy(b"/sdk/Good.sdk"))
  let lateOutcome = run attempt(&mac, &mac, b"16.0", &mut late)
  run Testing.expect(
    same(refusal(&earlyOutcome), b"DeploymentMismatch") && same(refusal(&lateOutcome), b"DeploymentMismatch"),
    "a deployment below 11.0.0 or above the SDK's maximum is refused, never raised"
  )

  let mut discovering = host()
  discovering.input.developer = true
  let discovered = run attempt(&mac, &mac, b"14.0", &mut discovering)
  let mut discoveredOk = false
  if let Result<Option<Supply>, SupplyError | FileError | HostInputError | OutOfMemoryError>.Success { value } = &discovered {
    if let Option<Supply>.Some { value: supply } = &value {
      let developer = match &supply.developerDirectory {
        Option<Bytes>.Some { value: directory } => same(Bytes.asSlice(&directory), b"/Applications/Xcode.app/Contents/Developer")
        Option<Bytes>.None => false
      }
      discoveredOk = developer && same(Path.rawBytes(&supply.root), b"/sdk/Good.sdk")
        && same(Bytes.asSlice(&supply.origin), b"SDK discovery") && same(Bytes.asSlice(&supply.deployment), b"14.0")
    }
  }
  run Testing.expect(discoveredOk, "without SDKROOT the host target discovers its SDK through xcrun")
  run Testing.expect(
    discovering.runner.runs == 1 && same(Bytes.asSlice(&discovering.runner.arguments), b"--sdk\0macosx\0--show-sdk-path\0")
      && same(Bytes.asSlice(&discovering.runner.environment), b"PATH=/missing:/usr/bin\0DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer\0"),
    "discovery runs the first xcrun on PATH with exactly PATH and DEVELOPER_DIR"
  )

  let mut foreign = host()
  let foreignOutcome = run attempt(&mac, &other, b"", &mut foreign)
  let mut broken = host()
  broken.runner.xcrunStatus = 1
  let brokenOutcome = run attempt(&mac, &mac, b"", &mut broken)
  run Testing.expect(
    same(refusal(&foreignOutcome), b"HostMismatch") && foreign.runner.runs == 0
      && same(refusal(&brokenOutcome), b"InvalidConfiguration") && broken.runner.runs == 1,
    "discovery runs only for the host target, and a failed query refuses the build"
  )
}

test effect fn macosSdksComeFromSdkrootOrHostDiscovery() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run supplyPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}
