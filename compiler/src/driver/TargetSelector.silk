//! Target selectors in project commands and `[build].targets`: `host` or a canonical target name.

import semantic.Target { Target }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.option { Option }
import silk.usize
import silk.vector { Vector }

/// A selector that names no supported target.
pub struct UnknownTarget {
  pub selector: Bytes
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// Whether `selector` is `host` or a canonical target name.
pub fn isSelector(selector: &[u8]) -> bool {
  if same(selector, b"host") {
    return true
  }
  return match move Target.resolve(selector) {
    Option<Target>.Some { .. } => true
    Option<Target>.None => false
  }
}

/// Resolves one selector: `host` names `host`, any other text must be a canonical target name.
pub fn resolve(selector: &[u8], host: Target) -> Option<Target> {
  if same(selector, b"host") {
    return Option<Target>.some(host)
  }
  return Target.resolve(selector)
}

/// Resolves every selector in order, keeping the first occurrence of each target.
pub effect fn resolveAll(selectors: &[Bytes], host: Target) -> Vector<Target>
  ! UnknownTarget | OutOfMemoryError
  ? &mut Allocator {
  let mut targets = Vector<Target>.make()
  let mut at = usize.ZERO
  while at < selectors.length {
    let selected = match move resolve(Bytes.asSlice(&selectors[at]), host) {
      Option<Target>.Some { value } => value
      Option<Target>.None => {
        fail UnknownTarget { selector: run Bytes.copy(Bytes.asSlice(&selectors[at])) }
      }
    }
    let seen = Vector<Target>.asSlice(&targets)
    let mut repeated = false
    let mut index = usize.ZERO
    while index < seen.length {
      if Target.id(&seen[index]) == Target.id(&selected) {
        repeated = true
      }
      index = index + usize.ONE
    }
    if !repeated {
      run Vector<Target>.append(&mut targets, selected)
    }
    at = at + usize.ONE
  }
  return move targets
}
