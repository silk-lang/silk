//! Host tools for WASI component construction and command execution.

import driver.CommandPath
import semantic.ContentHash { ContentHash }
import semantic.RuntimeEncoding
import driver.NativeToolchain
import driver.ProcessImage
import driver.Project as Projects { Project }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.system.child_process { ChildProcess, ProcessRequest, ProcessError }
import silk.system.filesystem { DirectoryEntry, DirectoryInfo, FileInfo, FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.text.string { String }
import silk.toml.scanner { TomlError }
import silk.toml.value { Toml }
import silk.io.writer { Writer, WriterError }

/// The WIT package and world whose canonical ABI describes a component's core module.
pub struct World {
  pub wit: Option<Path>,
  pub name: Bytes,
}

/// Selects the bundled WASI interfaces unless the package declares `[component].wit` and `world`.
pub effect fn world(project: &Project, library: &Option<Path>) -> World
  ! FileError | TomlError | OutOfMemoryError
  ? &mut Allocator {
  let document = run Projects.document(project)
  if let Option<string>.Some {value: wit} = move Toml.asString(Toml.fieldAt(Toml.field(&document, "component"), "wit")) {
    let name = Option<string>.unwrapOr(Toml.asString(Toml.fieldAt(Toml.field(&document, "component"), "world")), "")
    return World {wit: Option<Path>.some(run CommandPath.resolve(Projects.directory(project), String.utf8Bytes(wit))), name: run Bytes.copy(String.utf8Bytes(name))}
  }
  return run commandWorld(library)
}

/// The bundled command world used by command applications and generated test runners.
pub effect fn commandWorld(library: &Option<Path>) -> World ! FileError | OutOfMemoryError ? &mut Allocator {
  let mut wit = Option<Path>.none()
  if let Option<Path>.Some {value: root} = &library.* { wit = Option<Path>.some(run Path.join(&root, "wit")) }
  return World {wit: move wit, name: run Bytes.copy(b"command")}
}

/// Resolves an explicit tool override or a tool on PATH.
pub effect fn tool(variable: string, fallback: &[u8]) -> Option<Path>
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut FileSystem | &mut Allocator {
  let configured = run HostInput.variableNamed(variable)
  let mut hostSelection = Bytes.make()
  let mut selected = Option<&[u8]>.some(fallback)
  // An empty variable is unset, as a shell's `VAR= silk ...` means.
  if let Option<Bytes>.Some { value } = &configured {
    if Bytes.length(&value) != 0 {
      if CommandPath.hasDirectory(Bytes.asSlice(&value)) {
        let hostPath = run CommandPath.fromHost(Bytes.asSlice(&value))
        hostSelection = run Bytes.copy(Path.rawBytes(&hostPath))
        selected = Option<&[u8]>.some(Bytes.asSlice(&hostSelection))
      } else {
        selected = Option<&[u8]>.some(Bytes.asSlice(&value))
      }
    }
  }
  let path = match move run NativeToolchain.compiler(move selected) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return Option<Path>.none()
    }
  }
  return match move run CommandPath.canonical(Path.rawBytes(&path)) {
    Option<Bytes>.Some { value } => Option<Path>.some(run Path.fromBytes(Bytes.asSlice(&value)))
    Option<Bytes>.None => Option<Path>.none()
  }
}

/// Builds a Preview 2 command component from a Preview 1 core module.
/// The command adapter comes from `SILK_WASI_ADAPTER`; `SILK_WASM_TOOLS` selects wasm-tools.
pub effect fn component(core: &Path, output: &Path, world: &World, command: bool) -> i32
  ! FileError | HostInputError | OutOfMemoryError | ProcessError | WriterError
  ? &mut HostInput | &mut FileSystem | &mut ChildProcess | &mut Allocator {
  let executable = match move run tool("SILK_WASM_TOOLS", b"wasm-tools") {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      run report("silk: wasm32-wasip2 needs wasm-tools on PATH or SILK_WASM_TOOLS\n")
      return 2
    }
  }
  let mut adapterVariable = "SILK_WASI_REACTOR_ADAPTER"
  if command { adapterVariable = "SILK_WASI_ADAPTER" }
  let adapter = run HostInput.variableNamed(adapterVariable)
  if command {
    if let Option<Bytes>.None = &adapter {
      run report(
        "silk: wasm32-wasip2 needs SILK_WASI_ADAPTER pointing to wasi_snapshot_preview1.command.wasm\n"
      )
      return 2
    }
  }
  let mut embeddedName = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut embeddedName, b".typed-core.wasm")
  let embedded = run Path.fromBytes(Bytes.asSlice(&embeddedName))
  let mut input = core
  if let Option<Path>.Some {value: wit} = &world.wit {
    run recordWit(&wit)
    let mut embed = run NativeToolchain.request(&executable)
    run ChildProcess.addArgument(&mut embed, "component")
    run ChildProcess.addArgument(&mut embed, "embed")
    run NativeToolchain.addPathArgument(&mut embed, &wit)
    run NativeToolchain.addPathArgument(&mut embed, core)
    run ChildProcess.addArgument(&mut embed, "--world")
    run ChildProcess.addArgumentBytes(&mut embed, Bytes.asSlice(&world.name))
    run ChildProcess.addArgument(&mut embed, "-o")
    run NativeToolchain.addPathArgument(&mut embed, &embedded)
    let result = run ChildProcess.submit(&embed)
    run reportBytes(ChildProcess.errorBytes(&result))
    let status = Option<i32>.unwrapOr(ChildProcess.exitCode(&result), 2)
    if status != 0 { return status }
    input = &embedded
  }
  let mut process = run NativeToolchain.request(&executable)
  run ChildProcess.addArgument(&mut process, "component")
  run ChildProcess.addArgument(&mut process, "new")
  run NativeToolchain.addPathArgument(&mut process, input)
  if let Option<Bytes>.Some {value: path} = &adapter {
    let adapterPath = run canonicalInput(Bytes.asSlice(&path))
    run ChildProcess.addArgument(&mut process, "--adapt")
    let mut adaptation = run Bytes.copy(b"wasi_snapshot_preview1=")
    let hostAdapter = run NativeToolchain.pathBytes(&adapterPath)
    run Bytes.append(&mut adaptation, Bytes.asSlice(&hostAdapter))
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&adaptation))
  }
  run ChildProcess.addArgument(&mut process, "-o")
  run NativeToolchain.addPathArgument(&mut process, output)
  let result = run ChildProcess.submit(&process)
  run reportBytes(ChildProcess.errorBytes(&result))
  return Option<i32>.unwrapOr(ChildProcess.exitCode(&result), 2)
}

// wasm-tools reads WIT outside the compiler's FileSystem service. Read the same tree through the
// service so test-runner reuse observes additions, removals, and edits to component dependencies.
effect fn recordWit(path: &Path) -> () ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  match move run FileSystem.stat(path) {
    FileInfo {..} => { let bytes = run FileSystem.readFile(path) drop bytes }
    DirectoryInfo {} => {
      let entries = run FileSystem.listDirectory(path)
      let listed = List<DirectoryEntry>.asSlice(&entries)
      let mut at: usize = 0
      while at < listed.length { run recordWit(&listed[at].path) at = at + 1 }
    }
  }
}

/// Starts a WASI command using Wasmtime. The guest receives `working` as `/`, or the current
/// directory when absent. `SILK_WASMTIME` selects the runtime executable. A trap's trace has the
/// source location of each frame (`WASMTIME_BACKTRACE_DETAILS=1`), unless the environment sets it.
pub effect fn request(program: &Path, timeout: &[u8], working: Option<&Path>) -> Option<
  ProcessRequest
>
  ! FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut FileSystem | &mut Allocator {
  let executable = match move run tool("SILK_WASMTIME", b"wasmtime") {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      run report("silk: running WASI needs wasmtime on PATH or SILK_WASMTIME\n")
      return Option<ProcessRequest>.none()
    }
  }
  let mut process = run NativeToolchain.request(&executable)
  // Each frame of a trap's trace gets the file, line and column of a module's DWARF, unless the
  // user's environment says otherwise.
  let details = run HostInput.variableNamed("WASMTIME_BACKTRACE_DETAILS")
  if Option<Bytes>.isNone(&details) {
    run ChildProcess.setVariableBytes(&mut process, b"WASMTIME_BACKTRACE_DETAILS", b"1")
  }
  run ChildProcess.addArgument(&mut process, "run")
  run ChildProcess.addArgument(&mut process, "--dir")
  let mut root = match move working {
    Option<&Path>.Some { value } => run NativeToolchain.pathBytes(value)
    Option<&Path>.None => run Bytes.copy(b".")
  }
  run Bytes.append(&mut root, b"::/")
  run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&root))

  // Test receipts use absolute host paths; grant only their output directory under the same guest path.
  if let Option<Path>.Some { value: directory } = move run Path.parent(program) {
    let mut mapping = run NativeToolchain.pathBytes(&directory)
    run Bytes.append(&mut mapping, b"::")
    run Bytes.append(&mut mapping, Path.rawBytes(&directory))
    run ChildProcess.addArgument(&mut process, "--dir")
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&mapping))
  }
  if !(timeout.length == 1 && timeout[0] == 48) {
    let mut deadline = run Bytes.copy(b"timeout=")
    run Bytes.append(&mut deadline, timeout)
    run ChildProcess.addArgument(&mut process, "-W")
    run ChildProcess.addArgumentBytes(&mut process, Bytes.asSlice(&deadline))
  }
  run NativeToolchain.addPathArgument(&mut process, program)
  return Option<ProcessRequest>.some(move process)
}

/// Replaces the compiler with Wasmtime, preserving the terminal and command exit status.
/// The guest receives the current directory as `/`; arguments retain their original bytes. A trap's
/// trace has the source location of each frame, unless `WASMTIME_BACKTRACE_DETAILS` is set.
/// With `coredump`, Wasmtime writes a core dump there after a trap (`-D coredump=`). With
/// `debugger`, Wasmtime waits for LLDB on that port, or `address:port` (`-g`), before it starts.
pub effect fn replace(program: &Path, arguments: &[Bytes], coredump: &Option<Bytes>, debugger: &Option<Bytes>) -> i32
  ! FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut FileSystem | &mut Allocator {
  let executable = match move run tool("SILK_WASMTIME", b"wasmtime") {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      run report("silk: running WASI needs wasmtime on PATH or SILK_WASMTIME\n")
      return 2
    }
  }
  let mut command = List<Bytes>.make()
  run List<Bytes>.append(&mut command, run Bytes.copy(b"run"))
  run List<Bytes>.append(&mut command, run Bytes.copy(b"--dir"))
  run List<Bytes>.append(&mut command, run Bytes.copy(b".::/"))
  if let Option<Bytes>.Some {value: path} = &coredump.* {
    let mut option = run Bytes.copy(b"coredump=")
    let target = run Path.fromBytes(Bytes.asSlice(&path))
    let hostTarget = run NativeToolchain.pathBytes(&target)
    run Bytes.append(&mut option, Bytes.asSlice(&hostTarget))
    run List<Bytes>.append(&mut command, run Bytes.copy(b"-D"))
    run List<Bytes>.append(&mut command, move option)
  }
  if let Option<Bytes>.Some {value: port} = &debugger.* {
    run List<Bytes>.append(&mut command, run Bytes.copy(b"-g"))
    run List<Bytes>.append(&mut command, run Bytes.copy(Bytes.asSlice(&port)))
  }
  run List<Bytes>.append(&mut command, run NativeToolchain.pathBytes(program))
  let mut at: usize = 0
  while at < arguments.length {
    run List<Bytes>.append(&mut command, run Bytes.copy(Bytes.asSlice(&arguments[at])))
    at = at + 1
  }
  // Each frame of a trap's trace gets the file, line and column of a module's DWARF, unless the
  // environment already chooses.
  let _detailed = run ProcessImage.setVariableDefault(b"WASMTIME_BACKTRACE_DETAILS", b"1")
  let failed = run ProcessImage.replace(&executable, List<Bytes>.asSlice(&command))
  drop failed
  run report("silk: cannot start the WASI runtime\n")
  return 2
}

import silk.io.writer_native { StderrWriter }
import silk.core.effect { Effect }
import silk.text.string { String }

effect fn report(value: string) -> ()
  ! WriterError {
  return run reportBytes(String.utf8Bytes(value))
}

effect fn reportBytes(value: &[u8]) -> ()
  ! WriterError {
  let mut writer = StderrWriter.make()
  return run Writer.writeAll(value) |> Effect.provideMut<Writer>(&mut writer)
}

effect fn canonicalInput(path: &[u8]) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let resolved = match move run CommandPath.canonical(path) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      fail FileSystem.error(FileSystem.readFileOperation(), FileSystem.notFound())
    }
  }
  return run Path.fromBytes(Bytes.asSlice(&resolved))
}

/// The canonical paths and content digests of the component builder and selected adapters.
/// A changed executable, adapter, or symbolic-link destination changes the test-build identity.
pub effect fn identity() -> Bytes
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut FileSystem | &mut Allocator {
  let executable = match move run tool("SILK_WASM_TOOLS", b"wasm-tools") {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      fail FileSystem.error(FileSystem.readFileOperation(), FileSystem.notFound())
    }
  }
  let adapter = match move run HostInput.variableNamed("SILK_WASI_ADAPTER") {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      fail FileSystem.error(FileSystem.readFileOperation(), FileSystem.notFound())
    }
  }
  let adapterPath = run canonicalInput(Bytes.asSlice(&adapter))
  let paths = [&executable, &adapterPath]
  let mut result = Bytes.make()
  let mut at: usize = 0
  while at < 2 {
    let path = paths[at]
    let bytes = run FileSystem.readFile(path)
    let digest = ContentHash.of(Bytes.asSlice(&bytes))
    run RuntimeEncoding.field(&mut result, Path.rawBytes(path))
    run RuntimeEncoding.word(&mut result, digest.high)
    run RuntimeEncoding.word(&mut result, digest.low)
    at = at + 1
  }
  if let Option<Bytes>.Some {value: reactor} = move run HostInput.variableNamed("SILK_WASI_REACTOR_ADAPTER") {
    let path = run canonicalInput(Bytes.asSlice(&reactor))
    let bytes = run FileSystem.readFile(&path)
    let digest = ContentHash.of(Bytes.asSlice(&bytes))
    run RuntimeEncoding.field(&mut result, Path.rawBytes(&path))
    run RuntimeEncoding.word(&mut result, digest.high)
    run RuntimeEncoding.word(&mut result, digest.low)
  }
  return move result
}
