//! Reports what a command does outside a compilation unit to the file `SILK_EVENTS` names.
//!
//! A unit reports its phases through its `Progress`. A fetch belongs to no unit, so it is
//! reported here. `silk.build.events` describes the file and its events.

import silk.build.events { BuildEvent, BuildEvents, Fetch }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput, HostInputError }
import silk.num.usize

/// Reports that the command starts to fetch `source`, when `SILK_EVENTS` names a file. Call it
/// before the fetch, so a fetch that fails is reported too.
pub effect fn fetching(source: Fetch) -> ()
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  if let Option<Bytes>.Some { value } = move run HostInput.variableNamed(BuildEvents.variable()) {
    if Bytes.length(&value) > usize.ZERO {
      drop run BuildEvents.append(Bytes.asSlice(&value), &BuildEvent.Fetching { source: source })
    }
  }
  return ()
}
