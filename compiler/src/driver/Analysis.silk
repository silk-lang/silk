//! Opens a program for semantic analysis: loads its sources, configures a semantic store and
//! assembles the final profile. `silk build`, `silk check` and the language server share it; each
//! reports a refusal its own way.

import silk.system.host_input { HostInput, HostInputError }
import driver.CompilationDefinition as Definitions
import silk.build.definition { Definition }
import silk.text.string { String }
import silk.build.request { Request as CompilationRequest }
import Profiler
import driver.BuildPlan as BuildPlans { Resolved }
import driver.PlanData { Plan }
import driver.StaticDecode { InvalidStaticData }
import silk.build.step { StepFailure, StepError }
import silk.concurrency.thread_native { SpawnError }
import silk.concurrency.fiber { Cancelled }
import silk.core.effect { Effect }
import driver.NativeLinkInput as NativeLinkInputs
import driver.ImportSummaries { ImportSummaries }
import driver.ModuleSources as ModuleSourceFiles {
  InvalidBuildComposition,
  InvalidSourceRoot,
  MissingManifest,
  MissingStandardLibrary,
  ModuleSources,
  SourceSnapshot,
}
import driver.NativeLinkInput { InvalidNativeLinkInput, PlannedNative }
import driver.Packages { InvalidDependency }
import semantic.ExecutionStorage { ExecutionStorage }
import semantic.FinalProfile { FinalProfile, Problem as ProfileProblem }
import semantic.InitialProfile { InitialProfile }
import semantic.ModuleId { InvalidModulePath, ModuleId }
import semantic.ProfileAssembly { AssemblyProblem, assemble as assembleProfile }
import semantic.ProfileBinding { BindingError, Supplied }
import semantic.ProfileShape {
  Problem as ShapeProblem,
  Refusal as ShapeRefusal,
  Registered,
  registeredOrRefused as registeredShapes,
}
import semantic.Query { Cycle }
import semantic.Rejection { Rejection }
import semantic.Semantic {
  ConflictingPackageSource,
  InitializerData,
  initializerData,
  RegistrationClosed,
  Request as SemanticRequest,
  Semantic,
  StoreMode,
}
import semantic.SourceIndex { RevisionMismatch }
import semantic.Target { Target }
import semantic.Types { Types }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.mem.shared { Shared }
import silk.mem.box { Box }
import silk.toml.scanner { TomlError }
import silk.toml.value { Toml, Value as TomlValue, TomlChild }
import silk.system.child_process { ChildProcess }
import silk.num.usize

/// A program ready for semantic analysis.
pub struct Analysis {
  pub sources: ModuleSources,
  pub store: Semantic,
  pub request: SemanticRequest,
  pub rootPackage: List<ModuleId>,
  /// The root package's modules, then the dependency packages' modules: what a check sweeps.
  pub checked: List<ModuleId>,
  pub identity: ModuleId,
  /// The selected runtime, absent for a library or object form without one.
  pub runtime: Option<ModuleId>,
}

/// Why the final profile could not be assembled.
pub union Refusal {
  /// A `param` declaration is rejected where it is written.
  ParameterRejected { pub rejection: Shared<Rejection> },
  /// A `param` declaration has an invalid shape.
  Shape { pub problem: ShapeProblem },
  /// A parameter's default is rejected where it is written.
  DefaultRejected { pub rejection: Shared<Rejection> },
  /// The assembled profile is invalid.
  Profile { pub problem: ProfileProblem },
  /// A supplied binding is refused.
  Binding { pub error: BindingError },
  /// The bindings do not match the profile input.
  InputMismatch,
}

/// The program, or the store and sources read so far with why its profile was refused; their
/// syntax errors are still worth reporting.
pub union Opened {
  Ready { pub analysis: Analysis },
  /// The initial profile names no `libc` or no `artifact`.
  InvalidProfile,
  Refused { pub sources: ModuleSources, pub store: Semantic, pub refusal: Refusal },
  /// A package's `build.silk` (`file`) computes no plan: the sources and store that evaluated it,
  /// and the rejection that refused its `PLAN`, absent when it declares none or invalid data that
  /// `silk.build.plan` writes.
  PlanRefused {
    pub sources: ModuleSources,
    pub store: Semantic,
    pub rejection: Option<Shared<Rejection>>,
    pub file: Bytes,
    pub reason: Bytes,
  },
}

// What evaluating one `build.silk` answers.
union Evaluated {
  Planned { plan: Plan },
  Refused {
    sources: ModuleSources,
    store: Semantic,
    rejection: Option<Shared<Rejection>>,
    reason: Bytes
  },
}

/// Loads the program rooted at `sourcePath` (within `manifest`'s package when given), publishes
/// every module reachable through imports, and assembles the final profile with `bindings`. A test
/// analysis is rooted at the bundled runner. The store mode selects transient, persistent-cache, or
/// in-process revision evidence. Only `Revisable` permits `Semantic.update`. With
/// `summaries`, a file they name is not parsed for its imports (`ModuleSources.useSummaries`). With
/// `snapshot`, a file it holds is not read again (`ModuleSources.useSnapshot`).
pub effect fn open(
  sourcePath: &Path,
  manifest: Option<&Path>,
  standardLibrary: Option<Path>,
  store: Option<&Path>,
  profile: &InitialProfile,
  bindings: List<Supplied>,
  testing: bool,
  mode: StoreMode,
  alias: Option<&[u8]>,
  summaries: Option<ImportSummaries>,
  snapshot: Option<SourceSnapshot>,
  definition: Option<&Definition>,
  unsandboxedTools: bool,
  task: bool,
) -> Opened
  ! HostInputError
    | FileError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
  ? &mut HostInput | &mut FileSystem | &mut ChildProcess | &mut Allocator | &mut Types {
  let target = Target.forId(Target.id(InitialProfile.target(profile)))
  let libc = match move InitialProfile.text(profile, b"libc") {
    Option<&[u8]>.Some { value } => run Bytes.copy(value)
    Option<&[u8]>.None => {
      return Opened.InvalidProfile
    }
  }
  let artifact = match move InitialProfile.text(profile, b"artifact") {
    Option<&[u8]>.Some { value } => value
    Option<&[u8]>.None => {
      return Opened.InvalidProfile
    }
  }
  let executable = same(artifact, b"executable")
  let linked = executable || same(artifact, b"loadable-module")
  let mut selectedRoot = Option<Path>.none()
  if let Option<&Definition>.Some { value } = definition {
    if let Option<String>.Some { value: root } = &value.settings.root {
      selectedRoot = Option<Path>.some(run Path.make(root.view()))
    }
  }
  let root = match &selectedRoot {
    Option<Path>.Some { value } => Option<&Path>.some(&value)
    Option<Path>.None => Option<&Path>.none()
  }
  let library = run copiedLibrary(&standardLibrary)
  let mut ownedManifest = Option<Path>.none()
  let mut sources = match move manifest {
    Option<&Path>.Some { value } => {
      ownedManifest = Option<Path>.some(run Path.fromBytes(Path.rawBytes(value)))
      run ModuleSourceFiles.makeInPackage(
        sourcePath,
        value,
        move standardLibrary,
        store,
        Target.name(&target),
        Bytes.asSlice(&libc),
        executable,
        linked,
        run InitialProfile.runtimeRequest(profile),
        root,
        definition,
      )
    }
    Option<&Path>.None => run ModuleSourceFiles.standalone(
      sourcePath,
      move standardLibrary,
      Target.name(&target),
      Bytes.asSlice(&libc),
      executable,
      run InitialProfile.runtimeRequest(profile),
    )
  }
  if let Option<&Definition>.Some { value } = definition {
    let owner = run Bytes.copy(ModuleSourceFiles.packageIdentityAt(&sources, usize.ZERO))
    let modules = value.settings.modules.asSlice()
    let mut at = usize.ZERO
    while at < modules.length {
      run ModuleSourceFiles.addGeneratedFile(&mut sources, owner.asSlice(), &modules[at])
      at = at + usize.ONE
    }
  }
  if let Option<ImportSummaries>.Some { value } = move summaries {
    ModuleSourceFiles.useSummaries(&mut sources, move value)
  }
  if let Option<SourceSnapshot>.Some { value } = move snapshot {
    ModuleSourceFiles.useSnapshot(&mut sources, move value)
  }

  // Evaluate a reached package before following imports from its generated modules.
  // Each package's `build.silk` is evaluated first; its plan adds modules and `[native]` entries.
  if let Option<Path>.Some { value: manifestPath } = &ownedManifest {
    let rootDirectory = match move run Path.parent(&manifestPath) {
      Option<Path>.Some { value } => move value
      Option<Path>.None => {
        fail InvalidSourceRoot {}
      }
    }
    let mut at = usize.ZERO
    // A tasks program holds back its own package's native plan until it reaches one of the
    // package's modules besides the entry, the way a dependency's applies only once reached.
    let mut heldNative = Option<PlannedNative>.none()
    let mut heldDependencies = List<String>.make()
    if task {
      ModuleSourceFiles.loadEntryOnly(&mut sources)
    }
    while true {
      let policy = run toolPolicy(&manifestPath, &sources)
      while at < ModuleSourceFiles.packageCount(&sources) {
        let directory = run Path.fromBytes(
          Path.rawBytes(ModuleSourceFiles.packageDirectoryAt(&sources, at)),
        )
        let owner = run Bytes.copy(ModuleSourceFiles.packageIdentityAt(&sources, at))
        let buildFile = run Path.join(&directory, "build.silk")
        if run FileSystem.exists(&buildFile) {
          let mut planBindings = List<Supplied>.make()
          let mut suppliedPaths = List<String>.make()
          if let Option<&Definition>.Some { value } = definition {
            planBindings = run Definitions.bindings(
              value,
              &sources,
              Option<&[u8]>.some(owner.asSlice()),
            )
            suppliedPaths = run Definitions.suppliedPaths(value, &sources, owner.asSlice())
          }
          let evaluated = run evaluatePlan(
            &buildFile,
            &directory,
            ModuleSourceFiles.packageIdentityAt(&sources, at),
            run copiedLibrary(&library),
            profile,
            &target,
            Bytes.asSlice(&libc),
            move planBindings,
          )
          match move evaluated {
            Evaluated.Planned { plan: evaluatedPlan } => {
              let mut allowed = at == usize.ZERO
              let listed = policy.allowed.asSlice()
              let mut permission: usize = 0
              while permission < listed.length {
                if same(
                  listed[permission].asSlice(),
                  ModuleSourceFiles.packageIdentityAt(&sources, at),
                ) {
                  allowed = true
                }
                permission = permission + 1
              }
              let cache = run Path.join(&rootDirectory, "build/steps")
              let execution = run Effect.result(
                BuildPlans.execute(
                  &evaluatedPlan,
                  &directory,
                  &cache,
                  allowed,
                  move suppliedPaths,
                  unsandboxedTools,
                  ModuleSourceFiles.packageArchivesAt(&sources, at),
                ),
              )
              let plan = match move execution {
                Result<Resolved, StepFailure | SpawnError | Cancelled>.Success {
                  value
                } => move value
                Result<Resolved, StepFailure | SpawnError | Cancelled>.Failure { error } => {
                  let reason = match move error {
                    OutOfMemoryError exhausted => {
                      fail move exhausted
                    }
                    FileError failure => {
                      fail move failure
                    }
                    StepError { message } => run Bytes.copy(String.ownedUtf8Bytes(&message))
                    _ => run Bytes.copy(
                      b"the package build graph failed while executing its declared steps",
                    )
                  }
                  let empty = Semantic.oneShot(
                    run ModuleSourceFiles.revision(&sources),
                    Target.forId(Target.id(&target)),
                    Option<FinalProfile>.none(),
                  )
                  return Opened.PlanRefused {
                    sources: move sources,
                    store: move empty,
                    rejection: Option<Shared<Rejection>>.none(),
                    file: run Bytes.copy(Path.rawBytes(&buildFile)),
                    reason: move reason,
                  }
                }
              }
              if task && at == usize.ZERO {
                heldNative = Option<PlannedNative>.some(run NativeLinkInputs.planned(&plan.native))
                heldDependencies = move plan.dependencies
              } else {
                run ModuleSourceFiles.applyNativePlan(
                  &mut sources,
                  at,
                  run NativeLinkInputs.planned(&plan.native),
                  linked,
                )
                if let Option<Bytes>.Some { value: name } = move run demandLinked(
                  &mut sources,
                  at,
                  plan.dependencies.asSlice(),
                ) {
                  let empty = Semantic.oneShot(
                    run ModuleSourceFiles.revision(&sources),
                    Target.forId(Target.id(&target)),
                    Option<FinalProfile>.none(),
                  )
                  let mut reason = run Bytes.copy(b"Plan.linkDependency names `")
                  run reason.append(name.asSlice())
                  run reason.append(b"`, which the package's manifest does not declare")
                  return Opened.PlanRefused {
                    sources: move sources,
                    store: move empty,
                    rejection: Option<Shared<Rejection>>.none(),
                    file: run Bytes.copy(Path.rawBytes(&buildFile)),
                    reason: move reason,
                  }
                }
              }
              let modules = plan.modules.asSlice()
              let mut moduleAt: usize = 0
              while moduleAt < modules.length {
                run ModuleSourceFiles.addGeneratedFile(
                  &mut sources,
                  owner.asSlice(),
                  &modules[moduleAt],
                )
                moduleAt = moduleAt + 1
              }
            }
            Evaluated.Refused { sources: planSources, store: planStore, rejection, reason } => {
              return Opened.PlanRefused {
                sources: move planSources,
                store: move planStore,
                rejection: move rejection,
                file: run Bytes.copy(Path.rawBytes(&buildFile)),
                reason: move reason,
              }
            }
          }
        }
        at = at + usize.ONE
      }
      let application = if testing {
        run ModuleSourceFiles.module(&sources, b"silk/testing/runner.silk")
      } else {
        ModuleId.copy(ModuleSourceFiles.entry(&sources))
      }
      run ModuleSourceFiles.preloadProgram(&mut sources, &application)
      if heldNative.isSome() && run reachesPackageModule(&sources) {
        if let Option<PlannedNative>.Some { value: held } = Intrinsic.replace(
          heldNative,
          Option<PlannedNative>.none(),
        ) {
          run ModuleSourceFiles.applyNativePlan(&mut sources, usize.ZERO, move held, linked)
        }
        // The root's plan was checked when the package was evaluated on its own terms.
        drop run demandLinked(&mut sources, usize.ZERO, heldDependencies.asSlice())
      }
      if !run ModuleSourceFiles.resolveDependencies(&mut sources) {
        break
      }
    }
  } else {
    let application = ModuleId.copy(ModuleSourceFiles.entry(&sources))
    while true {
      run ModuleSourceFiles.preloadProgram(&mut sources, &application)
      if !run ModuleSourceFiles.resolveDependencies(&mut sources) {
        break
      }
    }
  }
  if let Option<&[u8]>.Some { value } = move alias {
    run ModuleSourceFiles.aliasRoot(&mut sources, value)
  }
  let mut supplied = move bindings
  if let Option<&Definition>.Some { value } = definition {
    run supplied.appendList(run Definitions.bindings(value, &sources, Option<&[u8]>.none()))
  }
  return run analyze(
    move sources,
    profile,
    move supplied,
    testing,
    mode,
    Option<ImportSummaries>.none(),
    Option<SourceSnapshot>.none(),
    target,
  )
}

// Demands each dependency `names` lists for the package at `owner`, and answers the first one the
// package does not declare, or none.
effect fn demandLinked(sources: &mut ModuleSources, owner: usize, names: &[String]) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at = usize.ZERO
  while at < names.length {
    if !run ModuleSourceFiles.demandLinked(&mut sources.*, owner, String.utf8Bytes(names[at].view())) {
      return Option<Bytes>.some(run Bytes.copy(String.utf8Bytes(names[at].view())))
    }
    at = at + usize.ONE
  }
  return Option<Bytes>.none()
}

// Whether the program reaches a module of the root package other than its entry.
effect fn reachesPackageModule(sources: &ModuleSources) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let loaded = run ModuleSourceFiles.loadedRootModules(sources)
  let modules = List<ModuleId>.asSlice(&loaded)
  let entry = ModuleSourceFiles.entry(sources)
  let mut at = usize.ZERO
  while at < modules.length {
    if !ModuleId.equals(&modules[at], entry) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// The dependency tool steps the root package authorizes.
struct ToolPolicy {
  allowed: List<Bytes>,
}

effect fn toolPolicy(manifest: &Path, sources: &ModuleSources) -> ToolPolicy
  ! FileError | TomlError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let text = run FileSystem.readFile(manifest)
  let document = run Toml.parse(text.asSlice())
  let mut policy = ToolPolicy { allowed: List<Bytes>.make() }
  if let Option<&TomlValue>.Some { value: dependencies } = move Toml.field(
    &document,
    "dependencies",
  ) {
    if let TomlValue.Table { entries, .. } = &dependencies.* {
      let listed = Box<List<TomlChild>>.get(&entries)[0].asSlice()
      let mut at: usize = 0
      while at < listed.length {
        if let TomlChild.Member { entry } = &listed[at] {
          if let Option<&TomlValue>.Some { value: flag } = move Toml.field(&entry.value, "tools") {
            if let TomlValue.Boolean { value: allowed } = &flag.* {
              if allowed {
                if let Option<Bytes>.Some {
                  value: identity
                } = move run ModuleSourceFiles.selectedPackage(
                  sources,
                  String.ownedUtf8Bytes(&entry.key),
                ) {
                  run policy.allowed.append(move identity)
                }
              }
            }
          }
        }
        at = at + 1
      }
    }
  }
  return move policy
}

// A copy of the standard library directory.
effect fn copiedLibrary(library: &Option<Path>) -> Option<Path>
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  if let Option<Path>.Some { value } = &library.* {
    return Option<Path>.some(run Path.fromBytes(Path.rawBytes(&value)))
  }
  return Option<Path>.none()
}

// Evaluates the `build.silk` at `buildFile` of the package in `directory` on its own and reads the
// plan its `PLAN` constant holds.
effect fn evaluatePlan(
  buildFile: &Path,
  directory: &Path,
  package: &[u8],
  standardLibrary: Option<Path>,
  profile: &InitialProfile,
  target: &Target,
  libc: &[u8],
  bindings: List<Supplied>,
) -> Evaluated
  ! FileError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator | &mut Types {
  let scriptSources = run ModuleSourceFiles.makeBuildScript(
    buildFile,
    directory,
    package,
    move standardLibrary,
    Target.name(target),
    libc,
  )
  let opened = run analyze(
    move scriptSources,
    profile,
    move bindings,
    false,
    StoreMode.Transient,
    Option<ImportSummaries>.none(),
    Option<SourceSnapshot>.none(),
    Target.forId(Target.id(target)),
  )
  let declared = run declaresPlan(buildFile)
  let shape = b"it must declare `pub const PLAN: Plan` built with silk.build.plan"
  return match move opened {
    Opened.Ready { analysis } => {
      let Analysis {
        sources: planSources,
        store,
        request,
        rootPackage: _,
        checked: _,
        identity,
        runtime: _
      } = move analysis
      let mut evaluating = move store
      if !declared {
        return Evaluated.Refused {
          sources: move planSources,
          store: move evaluating,
          rejection: Option<Shared<Rejection>>.none(),
          reason: run Bytes.copy(shape),
        }
      }
      let mut asked = move request
      let answer = run Semantic.demandInitializer(
        &mut evaluating,
        &mut asked,
        &identity,
        BuildPlans.constantName(),
      )
      match move initializerData(&answer) {
        InitializerData.Data { value: data } => {
          let decoded = run Effect.result(BuildPlans.read(&data))
          match move decoded {
            Result<Plan, InvalidStaticData | OutOfMemoryError>.Success { value } => {
              return Evaluated.Planned { plan: move value }
            }
            Result<Plan, InvalidStaticData | OutOfMemoryError>.Failure {
              error
            } => match move error {
              OutOfMemoryError exhausted => {
                fail move exhausted
              }
              InvalidStaticData {} => {}
            }
          }
          return Evaluated.Refused {
            sources: move planSources,
            store: move evaluating,
            rejection: Option<Shared<Rejection>>.none(),
            reason: run Bytes.copy(
              b"`PLAN` is not a plan; build it from `Plan.empty()` with silk.build.plan",
            ),
          }
        }
        InitializerData.Refused { rejection } => Evaluated.Refused {
          sources: move planSources,
          store: move evaluating,
          rejection: move rejection,
          reason: run Bytes.copy(b"its `PLAN` cannot be evaluated"),
        }
      }
    }
    Opened.Refused { sources, store, refusal } => {
      drop refusal
      return Evaluated.Refused {
        sources: move sources,
        store: move store,
        rejection: Option<Shared<Rejection>>.none(),
        reason: run Bytes.copy(shape),
      }
    }
    Opened.PlanRefused { sources, store, rejection, file, reason } => {
      drop file
      return Evaluated.Refused {
        sources: move sources,
        store: move store,
        rejection: move rejection,
        reason: move reason,
      }
    }
    Opened.InvalidProfile => {
      fail InvalidSourceRoot {}
    }
  }
}

// Whether the `build.silk` at `buildFile` names `PLAN` at all; one that does not is refused
// without the evaluation's unknown-name rejection.
effect fn declaresPlan(buildFile: &Path) -> bool
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let text = run FileSystem.readFile(buildFile)
  let bytes = Bytes.asSlice(&text)
  let name = BuildPlans.constantName()
  let mut at = usize.ZERO
  while at + name.length <= bytes.length {
    if same(Slice.view<u8>(bytes, at, name.length), name) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Publishes every module of `sources` reachable from its roots into a new store and assembles the
// final profile.
effect fn analyze(
  sources: ModuleSources,
  profile: &InitialProfile,
  bindings: List<Supplied>,
  testing: bool,
  mode: StoreMode,
  summaries: Option<ImportSummaries>,
  snapshot: Option<SourceSnapshot>,
  target: Target,
) -> Opened
  ! FileError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidBuildComposition
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator | &mut Types {
  let mut sources = move sources
  let identity = ModuleId.copy(ModuleSourceFiles.entry(&sources))
  let mut runtime = Option<ModuleId>.none()
  if let Option<&ModuleId>.Some { value } = move ModuleSourceFiles.runtime(&sources) {
    runtime = Option<ModuleId>.some(ModuleId.copy(value))
  }

  // A test build's application is the bundled runner; the source file is its discovery root.
  let mut application = ModuleId.copy(&identity)
  if testing {
    application = run ModuleSourceFiles.module(&sources, b"silk/testing/runner.silk")
  }

  // One build sees the whole program: every module reachable through imports from the build's
  // roots is published before semantic analysis starts.
  if let Option<ImportSummaries>.Some { value } = move summaries {
    ModuleSourceFiles.useSummaries(&mut sources, move value)
  }
  if let Option<SourceSnapshot>.Some { value } = move snapshot {
    ModuleSourceFiles.useSnapshot(&mut sources, move value)
  }
  let loading = Profiler.zone(b"preloadProgram")
  run ModuleSourceFiles.preloadProgram(&mut sources, &application)
  let mut parameterModules = List<ModuleId>.make()
  let supplied = List<Supplied>.asSlice(&bindings)
  let mut suppliedAt = usize.ZERO
  while suppliedAt < supplied.length {
    run List<ModuleId>.append(
      &mut parameterModules,
      run ModuleId.make(
        b"file",
        Bytes.asSlice(&supplied[suppliedAt].package),
        Bytes.asSlice(&supplied[suppliedAt].module),
      ),
    )
    suppliedAt = suppliedAt + usize.ONE
  }
  run ModuleSourceFiles.preload(&mut sources, List<ModuleId>.asSlice(&parameterModules))
  drop loading
  let rootPackage = run ModuleSourceFiles.loadedRootModules(&sources)
  let checked = run ModuleSourceFiles.checkedModules(&sources)
  let revision = run ModuleSourceFiles.revision(&sources)
  let mut store = Semantic.oneShot(move revision, target, Option<FinalProfile>.none())
  if mode == StoreMode.Revisable {
    store = Semantic.make(
      run ModuleSourceFiles.revision(&sources),
      target,
      Option<FinalProfile>.none(),
    )
  } else if mode == StoreMode.Cached {
    store = Semantic.cached(
      run ModuleSourceFiles.revision(&sources),
      target,
      Option<FinalProfile>.none(),
    )
  }
  Semantic.offerParsed(&mut store, ModuleSourceFiles.takeParsed(&mut sources))
  let claimFree = ModuleSourceFiles.takeClaimFree(&mut sources)
  run Semantic.offerClaimFree(&mut store, List<ModuleId>.asSlice(&claimFree))
  Semantic.selectPackages(&mut store, run ModuleSourceFiles.packageGraph(&sources))
  if let Option<&ExecutionStorage>.Some {
    value: storage
  } = move ModuleSourceFiles.executionStorage(&sources) {
    Semantic.selectExecutionStorage(&mut store, run ExecutionStorage.copy(storage))
  }
  Semantic.selectRetention(&mut store, run ModuleSourceFiles.retention(&sources))
  let supported = ModuleSourceFiles.support(&sources)
  let hosted = ModuleSourceFiles.supportHosted(&sources)
  let mut supportAt = usize.ZERO
  while supportAt < supported.length {
    run Semantic.selectSupport(&mut store, ModuleId.copy(&supported[supportAt]), hosted[supportAt])
    supportAt = supportAt + usize.ONE
  }
  if testing {
    Semantic.selectDiscovery(
      &mut store,
      ModuleId.copy(&identity),
      run Bytes.copy(ModuleSourceFiles.moduleDirectory(&sources)),
    )
    Semantic.selectDiscoveryExports(&mut store, run ModuleSourceFiles.exportedModules(&sources))
  }
  let mut request = SemanticRequest.forApplication(ModuleId.copy(&application))
  run SemanticRequest.registerSchemaModule(&mut request, &identity)
  let registered = List<ModuleId>.asSlice(&parameterModules)
  let mut registeredAt = usize.ZERO
  while registeredAt < registered.length {
    run SemanticRequest.registerSchemaModule(&mut request, &registered[registeredAt])
    registeredAt = registeredAt + usize.ONE
  }
  let shapes = run registeredShapes(&mut store, &mut request, &target)
  let assembled = match move shapes {
    Result<Registered, ShapeRefusal>.Success { value } => run assembleProfile(
      run InitialProfile.copy(profile),
      &mut store,
      &mut request,
      &value,
      move bindings,
    )
    Result<Registered, ShapeRefusal>.Failure { error } => {
      let refusal = match move error {
        ShapeRefusal.Rejected { rejection } => Refusal.ParameterRejected {
          rejection: move rejection,
        }
        ShapeRefusal.Shape { problem } => Refusal.Shape { problem: problem }
      }
      return Opened.Refused { sources: move sources, store: move store, refusal: move refusal }
    }
  }
  match move assembled {
    Result<FinalProfile, AssemblyProblem>.Success { value } => {
      run Semantic.reviseProfile(&mut store, Option<FinalProfile>.some(move value))
    }
    Result<FinalProfile, AssemblyProblem>.Failure { error } => {
      let refusal = match move error {
        AssemblyProblem.Default { rejection } => Refusal.DefaultRejected {
          rejection: move rejection,
        }
        AssemblyProblem.Profile { error: problem } => Refusal.Profile { problem: problem }
        AssemblyProblem.Binding { error: refused } => Refusal.Binding { error: move refused }
        AssemblyProblem.InputMismatch => Refusal.InputMismatch
      }
      return Opened.Refused { sources: move sources, store: move store, refusal: move refusal }
    }
  }
  return Opened.Ready {
    analysis: Analysis {
      sources: move sources,
      store: move store,
      request: move request,
      rootPackage: move rootPackage,
      checked: move checked,
      identity: move identity,
      runtime: move runtime,
    },
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + 1
  }
  return true
}

/// Analyzes exactly the sources a compilation request supplies; it never evaluates a package build plan.
pub effect fn openRequest(
  request: &CompilationRequest,
  profile: &InitialProfile,
  bindings: List<Supplied>,
  mode: StoreMode,
  summaries: Option<ImportSummaries>,
  snapshot: Option<SourceSnapshot>,
) -> Opened
  ! FileError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidBuildComposition
    | InvalidNativeLinkInput
    | InvalidDependency
    | MissingManifest
    | MissingStandardLibrary
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator | &mut Types {
  let sources = run ModuleSourceFiles.fromRequest(request)
  return run analyze(
    move sources,
    profile,
    move bindings,
    request.artifact.view() == "test",
    mode,
    move summaries,
    move snapshot,
    Target.forId(Target.id(InitialProfile.target(profile))),
  )
}
