//! Opens a program for semantic analysis: loads its sources, configures a semantic store and
//! assembles the final profile. `silk build`, `silk check` and the language server share it; each
//! reports a refusal its own way.

import Profiler
import driver.BuildPlan as BuildPlans { Plan }
import driver.ImportSummaries { ImportSummaries }
import driver.ModuleSources as ModuleSourceFiles {
  InvalidBuildComposition,
  InvalidSourceRoot,
  MissingManifest,
  MissingStandardLibrary,
  ModuleSources,
}
import driver.NativeLinkInput { InvalidNativeLinkInput, PlannedNative }
import driver.ToolSandbox
import driver.ToolStep as ToolSteps { Ran as ToolRun }
import driver.Packages { InvalidDependency }
import semantic.ExecutionStorage { ExecutionStorage }
import semantic.FinalProfile { FinalProfile, Problem as ProfileProblem }
import semantic.InitialProfile { InitialProfile }
import semantic.ModuleId { InvalidModulePath, ModuleId }
import semantic.ProfileAssembly { AssemblyProblem, assemble as assembleProfile }
import semantic.ProfileBinding { BindingError, Supplied }
import semantic.ProfileShape {
  Problem as ShapeProblem,
  Refusal as ShapeRefusal,
  Registered,
  registeredOrRefused as registeredShapes,
}
import semantic.Query { Cycle }
import semantic.Rejection { Rejection }
import semantic.Semantic {
  ConflictingPackageSource,
  InitializerText,
  initializerText,
  RegistrationClosed,
  Request as SemanticRequest,
  Semantic,
}
import semantic.SourceIndex { RevisionMismatch }
import semantic.Target { Target }
import semantic.Types { Types }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.mem.shared { Shared }
import silk.toml.scanner { TomlError }
import silk.toml.value { Toml, Value as TomlValue }
import silk.system.child_process { ChildProcess }
import silk.io.writer_native { StderrWriter }
import silk.io.writer { Writer }
import silk.core.effect { Effect }
import silk.text.string { String }
import silk.num.usize

/// A program ready for semantic analysis.
pub struct Analysis {
  pub sources: ModuleSources,
  pub store: Semantic,
  pub request: SemanticRequest,
  pub rootPackage: List<ModuleId>,
  /// The root package's modules, then the dependency packages' modules: what a check sweeps.
  pub checked: List<ModuleId>,
  pub identity: ModuleId,
  /// The selected runtime, absent for a library or object form without one.
  pub runtime: Option<ModuleId>,
}

/// Why the final profile could not be assembled.
pub union Refusal {
  /// A `param` declaration is rejected where it is written.
  ParameterRejected { pub rejection: Shared<Rejection> },
  /// A `param` declaration has an invalid shape.
  Shape { pub problem: ShapeProblem },
  /// A parameter's default is rejected where it is written.
  DefaultRejected { pub rejection: Shared<Rejection> },
  /// The assembled profile is invalid.
  Profile { pub problem: ProfileProblem },
  /// A supplied binding is refused.
  Binding { pub error: BindingError },
  /// The bindings do not match the profile input.
  InputMismatch,
}

/// The program, or the store and sources read so far with why its profile was refused; their
/// syntax errors are still worth reporting.
pub union Opened {
  Ready { pub analysis: Analysis },
  /// The initial profile names no `libc` or no `artifact`.
  InvalidProfile,
  Refused { pub sources: ModuleSources, pub store: Semantic, pub refusal: Refusal },
  /// A package's `build.silk` (`file`) computes no plan: the sources and store that evaluated it,
  /// and the rejection that refused its `PLAN`, absent when it declares none or not as text that
  /// `silk.build.plan` writes.
  PlanRefused {
    pub sources: ModuleSources,
    pub store: Semantic,
    pub rejection: Option<Shared<Rejection>>,
    pub file: Bytes,
    pub reason: Bytes,
  },
}

// What evaluating one `build.silk` answers.
union Evaluated {
  Planned { plan: Plan },
  Refused { sources: ModuleSources, store: Semantic, rejection: Option<Shared<Rejection>>, reason: Bytes },
}

/// Loads the program rooted at `sourcePath` (within `manifest`'s package when given), publishes
/// every module reachable through imports, and assembles the final profile with `bindings`. A test
/// analysis is rooted at the bundled runner. A revisable store, opened with `Semantic.make`, can
/// later take a new revision through `Semantic.update`; otherwise the store is one-shot. With
/// `summaries`, a file they name is not parsed for its imports (`ModuleSources.useSummaries`).
pub effect fn open(
  sourcePath: &Path,
  manifest: Option<&Path>,
  standardLibrary: Option<Path>,
  store: Option<&Path>,
  profile: &InitialProfile,
  bindings: List<Supplied>,
  testing: bool,
  revisable: bool,
  alias: Option<&[u8]>,
  summaries: Option<ImportSummaries>,
) -> Opened
  ! FileError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
  ? &mut FileSystem | &mut ChildProcess | &mut Allocator | &mut Types {
  let target = Target.forId(Target.id(InitialProfile.target(profile)))
  let libc = match move InitialProfile.text(profile, b"libc") {
    Option<&[u8]>.Some { value } => run Bytes.copy(value)
    Option<&[u8]>.None => {
      return Opened.InvalidProfile
    }
  }
  let executable = match move InitialProfile.text(profile, b"artifact") {
    Option<&[u8]>.Some { value } => same(value, b"executable")
    Option<&[u8]>.None => {
      return Opened.InvalidProfile
    }
  }
  let library = run copiedLibrary(&standardLibrary)
  let mut ownedManifest = Option<Path>.none()
  let mut sources = match move manifest {
    Option<&Path>.Some { value } => {
      ownedManifest = Option<Path>.some(run Path.fromBytes(Path.rawBytes(value)))
      run ModuleSourceFiles.makeInPackage(
        sourcePath,
        value,
        move standardLibrary,
        store,
        Target.name(&target),
        Bytes.asSlice(&libc),
        executable,
        run InitialProfile.runtimeRequest(profile)
      )
    }
    Option<&Path>.None => run ModuleSourceFiles.make(
      sourcePath,
      move standardLibrary,
      store,
      Target.name(&target),
      Bytes.asSlice(&libc),
      executable,
      run InitialProfile.runtimeRequest(profile)
    )
  }
  // Each package's `build.silk` is evaluated first; its plan adds modules and `[native]` entries.
  if let Option<Path>.Some { value: manifestPath } = &ownedManifest {
    let mut plans = List<PlannedNative>.make()
    let mut generated = List<Plan>.make()
    let mut owners = List<Bytes>.make()
    let mut native = false
    let policy = run toolPolicy(&manifestPath)
    let rootDirectory = match move run Path.parent(&manifestPath) {
      Option<Path>.Some { value } => move value
      Option<Path>.None => { fail InvalidSourceRoot {} }
    }
    let mut at = usize.ZERO
    while at < ModuleSourceFiles.packageCount(&sources) {
      let directory = ModuleSourceFiles.packageDirectoryAt(&sources, at)
      let buildFile = run Path.join(directory, "build.silk")
      if run FileSystem.exists(&buildFile) {
        let evaluated = run evaluatePlan(
          &buildFile,
          directory,
          ModuleSourceFiles.packageIdentityAt(&sources, at),
          run copiedLibrary(&library),
          profile,
          &target,
          Bytes.asSlice(&libc)
        )
        match move evaluated {
          Evaluated.Planned { plan: evaluatedPlan } => {
            let mut plan = move evaluatedPlan
            let refusedTools = run runTools(
              &mut plan,
              ModuleSourceFiles.packageIdentityAt(&sources, at),
              at == usize.ZERO,
              directory,
              &rootDirectory,
              &policy
            )
            if let Option<Bytes>.Some { value: toolReason } = move refusedTools {
              let empty = Semantic.oneShot(run ModuleSourceFiles.revision(&sources), Target.forId(Target.id(&target)), Option<FinalProfile>.none())
              return Opened.PlanRefused {
                sources: move sources,
                store: move empty,
                rejection: Option<Shared<Rejection>>.none(),
                file: run Bytes.copy(Path.rawBytes(&buildFile)),
                reason: move toolReason,
              }
            }
            // A generated module never shadows a file of the package.
            let root = ModuleSourceFiles.packageSourceRootAt(&sources, at)
            let modules = List<BuildPlans.Generated>.asSlice(&plan.modules)
            let mut moduleAt = usize.ZERO
            while moduleAt < modules.length {
              let mut fileName = run Bytes.copy(Bytes.asSlice(&modules[moduleAt].name))
              run Bytes.append(&mut fileName, b".silk")
              let written = run Path.joinBytes(root, Bytes.asSlice(&fileName))
              if run FileSystem.exists(&written) {
                let mut reason = run Bytes.copy(b"its module `")
                run Bytes.append(&mut reason, Bytes.asSlice(&modules[moduleAt].name))
                run Bytes.append(&mut reason, b"` would shadow the package's file ")
                run Bytes.append(&mut reason, Path.rawBytes(&written))
                let empty = Semantic.oneShot(run ModuleSourceFiles.revision(&sources), Target.forId(Target.id(&target)), Option<FinalProfile>.none())
                return Opened.PlanRefused {
                  sources: move sources,
                  store: move empty,
                  rejection: Option<Shared<Rejection>>.none(),
                  file: run Bytes.copy(Path.rawBytes(&buildFile)),
                  reason: move reason,
                }
              }
              moduleAt = moduleAt + usize.ONE
            }
            if plan.entries > usize.ZERO {
              native = true
              run List<PlannedNative>.append(&mut plans, PlannedNative {
                directory: run Path.fromBytes(Path.rawBytes(directory)),
                file: run Path.fromBytes(Path.rawBytes(&buildFile)),
                text: run Bytes.copy(Bytes.asSlice(&plan.native)),
              })
            }
            run List<Bytes>.append(&mut owners, run Bytes.copy(ModuleSourceFiles.packageIdentityAt(&sources, at)))
            run List<Plan>.append(&mut generated, move plan)
          }
          Evaluated.Refused { sources: planSources, store: planStore, rejection, reason } => {
            return Opened.PlanRefused {
              sources: move planSources,
              store: move planStore,
              rejection: move rejection,
              file: run Bytes.copy(Path.rawBytes(&buildFile)),
              reason: move reason,
            }
          }
        }
      }
      at = at + usize.ONE
    }
    if native {
      sources = run ModuleSourceFiles.makePlanned(
        sourcePath,
        &manifestPath,
        run copiedLibrary(&library),
        store,
        Target.name(&target),
        Bytes.asSlice(&libc),
        executable,
        run InitialProfile.runtimeRequest(profile),
        move plans
      )
    }
    let planned = List<Plan>.asSlice(&generated)
    let mut planAt = usize.ZERO
    while planAt < planned.length {
      let modules = List<BuildPlans.Generated>.asSlice(&planned[planAt].modules)
      let mut moduleAt = usize.ZERO
      while moduleAt < modules.length {
        run ModuleSourceFiles.addGenerated(
          &mut sources,
          Bytes.asSlice(&List<Bytes>.asSlice(&owners)[planAt]),
          Bytes.asSlice(&modules[moduleAt].name),
          run Bytes.copy(Bytes.asSlice(&modules[moduleAt].source))
        )
        moduleAt = moduleAt + usize.ONE
      }
      planAt = planAt + usize.ONE
    }
  }
  if let Option<&[u8]>.Some { value } = move alias {
    run ModuleSourceFiles.aliasRoot(&mut sources, value)
  }
  return run analyze(move sources, profile, move bindings, testing, revisable, move summaries, target)
}

// What the root manifest's `[build]` table lets tool steps do: the dependencies whose steps run
// (`tools`), and whether steps run without a sandbox on a host that has none (`unsandboxed-tools`).
struct ToolPolicy {
  allowed: List<Bytes>,
  unsandboxed: bool,
}

effect fn toolPolicy(manifest: &Path) -> ToolPolicy ! FileError | TomlError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let text = run FileSystem.readFile(manifest)
  let document = run Toml.parse(Bytes.asSlice(&text))
  let mut policy = ToolPolicy { allowed: List<Bytes>.make(), unsandboxed: false }
  if let Option<&TomlValue>.Some { value: listed } = move Toml.fieldAt(Toml.field(&document, "build"), "tools") {
    let mut item = usize.ZERO
    while true {
      let named = match move Toml.item(listed, item) {
        Option<&TomlValue>.Some { value } => value
        Option<&TomlValue>.None => { break }
      }
      if let Option<string>.Some { value: name } = move Toml.asString(Option<&TomlValue>.some(named)) {
        run List<Bytes>.append(&mut policy.allowed, run Bytes.copy(String.utf8Bytes(name)))
      }
      item = item + usize.ONE
    }
  }
  if let Option<&TomlValue>.Some { value: flag } = move Toml.fieldAt(Toml.field(&document, "build"), "unsandboxed-tools") {
    if let TomlValue.Boolean { value } = &flag.* { policy.unsandboxed = value }
  }
  return move policy
}

// The name of the package `identity` (`name@version`).
fn packageName(identity: &[u8]) -> &[u8] {
  let mut at = usize.ZERO
  while at < identity.length && identity[at] != 64 { at = at + usize.ONE }
  return Slice.view<u8>(identity, usize.ZERO, at)
}

effect fn warn(line: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut stderr = StderrWriter.make()
  let written = run Effect.result(Writer.writeAll(line) |> Effect.provideMut<Writer>(&mut stderr))
  drop written
}

// Runs the tool steps of the plan of package `identity` in `directory` (the root package when
// `root`) below `<rootDirectory>/build/tools/<name>/<step>`, and adds the modules they produce to
// `plan.modules`. Answers why they cannot run, if they cannot.
effect fn runTools(plan: &mut Plan, identity: &[u8], root: bool, directory: &Path, rootDirectory: &Path, policy: &ToolPolicy) -> Option<Bytes>
! FileError | OutOfMemoryError ? &mut FileSystem | &mut ChildProcess | &mut Allocator {
  let tools = List<BuildPlans.Tool>.asSlice(&plan.tools)
  let produced = List<BuildPlans.ToolModule>.asSlice(&plan.toolModules)
  if tools.length == usize.ZERO && produced.length == usize.ZERO { return Option<Bytes>.none() }
  let name = packageName(identity)
  let mut allowed = root
  let listed = List<Bytes>.asSlice(&policy.allowed)
  let mut at = usize.ZERO
  while at < listed.length {
    if same(Bytes.asSlice(&listed[at]), name) { allowed = true }
    at = at + usize.ONE
  }
  if !allowed {
    let mut reason = run Bytes.copy(b"its tool steps run only when the root manifest lists \"")
    run Bytes.append(&mut reason, name)
    run Bytes.append(&mut reason, b"\" in [build].tools")
    return Option<Bytes>.some(move reason)
  }
  let mut compiler = Option<Path>.none()
  if ToolSandbox.supported() { compiler = run ToolSteps.compiler() }
  let mut sandboxed = false
  if let Option<Path>.Some { value: _ } = &compiler { sandboxed = true }
  if !sandboxed && !policy.unsandboxed {
    return Option<Bytes>.some(run Bytes.copy(b"this host has no sandbox for build tools (Linux 6.7 with Landlock); set [build].unsandboxed-tools = true in the root manifest to run them without one"))
  }
  let outputs = run Path.joinBytes(rootDirectory, b"build/tools")
  let mut packageOutputs = run Path.joinBytes(&outputs, name)
  at = usize.ZERO
  while at < tools.length {
    if !sandboxed {
      let mut line = run Bytes.copy(b"silk: warning: running build tool `")
      run Bytes.append(&mut line, Bytes.asSlice(&tools[at].name))
      run Bytes.append(&mut line, b"` of ")
      run Bytes.append(&mut line, name)
      run Bytes.append(&mut line, b" without a sandbox ([build].unsandboxed-tools)\n")
      run warn(Bytes.asSlice(&line))
    }
    let stepOutput = run Path.joinBytes(&packageOutputs, Bytes.asSlice(&tools[at].name))
    let mut sandbox = Option<&Path>.none()
    if let Option<Path>.Some { value } = &compiler { sandbox = Option<&Path>.some(&value) }
    match move run ToolSteps.execute(&tools[at], directory, &stepOutput, move sandbox) {
      ToolRun.Current => {}
      ToolRun.Refused { reason } => { return Option<Bytes>.some(move reason) }
    }
    at = at + usize.ONE
  }
  let mut modules = List<BuildPlans.Generated>.make()
  at = usize.ZERO
  while at < produced.length {
    let mut found = false
    let mut step = usize.ZERO
    while step < tools.length {
      if same(Bytes.asSlice(&tools[step].name), Bytes.asSlice(&produced[at].step)) {
        if ToolSteps.declares(List<Bytes>.asSlice(&tools[step].outputs), Bytes.asSlice(&produced[at].output)) { found = true }
      }
      step = step + usize.ONE
    }
    if !found {
      let mut reason = run Bytes.copy(b"its module `")
      run Bytes.append(&mut reason, Bytes.asSlice(&produced[at].name))
      run Bytes.append(&mut reason, b"` names an output that no tool step declares")
      return Option<Bytes>.some(move reason)
    }
    let stepOutput = run Path.joinBytes(&packageOutputs, Bytes.asSlice(&produced[at].step))
    let file = run Path.joinBytes(&stepOutput, Bytes.asSlice(&produced[at].output))
    run List<BuildPlans.Generated>.append(&mut modules, BuildPlans.Generated {
      name: run Bytes.copy(Bytes.asSlice(&produced[at].name)),
      source: run FileSystem.readFile(&file),
    })
    at = at + usize.ONE
  }
  let mut moved = move modules
  while true {
    match move List<BuildPlans.Generated>.pop(&mut moved) {
      Option<BuildPlans.Generated>.Some { value } => run List<BuildPlans.Generated>.append(&mut plan.modules, move value)
      Option<BuildPlans.Generated>.None => { break }
    }
  }
  return Option<Bytes>.none()
}

// A copy of the standard library directory.
effect fn copiedLibrary(library: &Option<Path>) -> Option<Path> ! FileError | OutOfMemoryError ? &mut Allocator {
  if let Option<Path>.Some { value } = &library.* {
    return Option<Path>.some(run Path.fromBytes(Path.rawBytes(&value)))
  }
  return Option<Path>.none()
}

// Evaluates the `build.silk` at `buildFile` of the package in `directory` on its own and reads the
// plan its `PLAN` constant holds.
effect fn evaluatePlan(buildFile: &Path, directory: &Path, package: &[u8], standardLibrary: Option<Path>, profile: &InitialProfile, target: &Target, libc: &[u8]) -> Evaluated
  ! FileError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator | &mut Types {
  let scriptSources = run ModuleSourceFiles.makeBuildScript(buildFile, directory, package, move standardLibrary, Target.name(target), libc)
  let opened = run analyze(move scriptSources, profile, List<Supplied>.make(), false, false, Option<ImportSummaries>.none(), Target.forId(Target.id(target)))
  let declared = run declaresPlan(buildFile)
  let shape = b"it must declare `pub const PLAN: string` built with silk.build.plan"
  return match move opened {
    Opened.Ready { analysis } => {
      let Analysis { sources: planSources, store, request, rootPackage: _, checked: _, identity, runtime: _ } = move analysis
      let mut evaluating = move store
      if !declared {
        return Evaluated.Refused {
          sources: move planSources,
          store: move evaluating,
          rejection: Option<Shared<Rejection>>.none(),
          reason: run Bytes.copy(shape),
        }
      }
      let mut asked = move request
      let answer = run Semantic.demandInitializer(&mut evaluating, &mut asked, &identity, BuildPlans.constantName())
      match move run initializerText(&answer) {
        InitializerText.Text { bytes } => {
          if let Option<Plan>.Some { value } = move run BuildPlans.read(Bytes.asSlice(&bytes)) {
            return Evaluated.Planned { plan: move value }
          }
          return Evaluated.Refused {
            sources: move planSources,
            store: move evaluating,
            rejection: Option<Shared<Rejection>>.none(),
            reason: run Bytes.copy(b"`PLAN` is not a plan; build it from `Plan.empty()` with silk.build.plan"),
          }
        }
        InitializerText.Refused { rejection } => Evaluated.Refused {
          sources: move planSources,
          store: move evaluating,
          rejection: move rejection,
          reason: run Bytes.copy(b"its `PLAN` cannot be evaluated"),
        }
      }
    }
    Opened.Refused { sources, store, refusal } => {
      drop refusal
      return Evaluated.Refused {
        sources: move sources,
        store: move store,
        rejection: Option<Shared<Rejection>>.none(),
        reason: run Bytes.copy(shape),
      }
    }
    Opened.PlanRefused { sources, store, rejection, file, reason } => {
      drop file
      return Evaluated.Refused { sources: move sources, store: move store, rejection: move rejection, reason: move reason }
    }
    Opened.InvalidProfile => { fail InvalidSourceRoot {} }
  }
}

// Whether the `build.silk` at `buildFile` names `PLAN` at all; one that does not is refused
// without the evaluation's unknown-name rejection.
effect fn declaresPlan(buildFile: &Path) -> bool ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let text = run FileSystem.readFile(buildFile)
  let bytes = Bytes.asSlice(&text)
  let name = BuildPlans.constantName()
  let mut at = usize.ZERO
  while at + name.length <= bytes.length {
    if same(Slice.view<u8>(bytes, at, name.length), name) { return true }
    at = at + usize.ONE
  }
  return false
}

// Publishes every module of `sources` reachable from its roots into a new store and assembles the
// final profile.
effect fn analyze(sources: ModuleSources, profile: &InitialProfile, bindings: List<Supplied>, testing: bool, revisable: bool, summaries: Option<ImportSummaries>, target: Target) -> Opened
  ! FileError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidBuildComposition
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator | &mut Types {
  let mut sources = move sources
  let identity = ModuleId.copy(ModuleSourceFiles.entry(&sources))
  let mut runtime = Option<ModuleId>.none()
  if let Option<&ModuleId>.Some { value } = move ModuleSourceFiles.runtime(&sources) {
    runtime = Option<ModuleId>.some(ModuleId.copy(value))
  }
  // A test build's application is the bundled runner; the source file is its discovery root.
  let mut application = ModuleId.copy(&identity)
  if testing {
    application = run ModuleSourceFiles.module(&sources, b"silk/testing/runner.silk")
  }
  // One build sees the whole program: every module reachable through imports from the build's
  // roots is published before semantic analysis starts.
  if let Option<ImportSummaries>.Some { value } = move summaries {
    ModuleSourceFiles.useSummaries(&mut sources, move value)
  }
  let loading = Profiler.zone(b"preloadProgram")
  run ModuleSourceFiles.preloadProgram(&mut sources, &application)
  drop loading
  let rootPackage = run ModuleSourceFiles.loadedRootModules(&sources)
  let mut checked = List<ModuleId>.make()
  let mut ownAt = usize.ZERO
  while ownAt < List<ModuleId>.length(&rootPackage) {
    run List<ModuleId>.append(&mut checked, ModuleId.copy(&List<ModuleId>.asSlice(&rootPackage)[ownAt]))
    ownAt = ownAt + usize.ONE
  }
  let dependencies = run ModuleSourceFiles.loadedDependencyModules(&sources)
  let listed = List<ModuleId>.asSlice(&dependencies)
  let mut dependencyAt = usize.ZERO
  while dependencyAt < listed.length {
    run List<ModuleId>.append(&mut checked, ModuleId.copy(&listed[dependencyAt]))
    dependencyAt = dependencyAt + usize.ONE
  }
  let revision = run ModuleSourceFiles.revision(&sources)
  let mut store = Semantic.oneShot(move revision, target, Option<FinalProfile>.none())
  if revisable {
    store = Semantic.make(run ModuleSourceFiles.revision(&sources), target, Option<FinalProfile>.none())
  }
  Semantic.offerParsed(&mut store, ModuleSourceFiles.takeParsed(&mut sources))
  let claimFree = ModuleSourceFiles.takeClaimFree(&mut sources)
  run Semantic.offerClaimFree(&mut store, List<ModuleId>.asSlice(&claimFree))
  Semantic.selectPackages(&mut store, run ModuleSourceFiles.packageGraph(&sources))
  if let Option<&ExecutionStorage>.Some { value: storage } = move ModuleSourceFiles.executionStorage(&sources) {
    Semantic.selectExecutionStorage(&mut store, run ExecutionStorage.copy(storage))
  }
  Semantic.selectRetention(&mut store, run ModuleSourceFiles.retention(&sources))
  if testing {
    Semantic.selectDiscovery(
      &mut store,
      ModuleId.copy(&identity),
      run Bytes.copy(ModuleSourceFiles.moduleDirectory(&sources))
    )
    Semantic.selectDiscoveryExports(&mut store, run ModuleSourceFiles.exportedModules(&sources))
  }
  let mut request = SemanticRequest.forApplication(ModuleId.copy(&application))
  run SemanticRequest.registerSchemaModule(&mut request, &identity)
  let shapes = run registeredShapes(&mut store, &mut request, &target)
  let assembled = match move shapes {
    Result<Registered, ShapeRefusal>.Success { value } => run assembleProfile(
      run InitialProfile.copy(profile),
      &mut store,
      &mut request,
      &value,
      move bindings
    )
    Result<Registered, ShapeRefusal>.Failure { error } => {
      let refusal = match move error {
        ShapeRefusal.Rejected { rejection } => Refusal.ParameterRejected { rejection: move rejection }
        ShapeRefusal.Shape { problem } => Refusal.Shape { problem: problem }
      }
      return Opened.Refused { sources: move sources, store: move store, refusal: move refusal }
    }
  }
  match move assembled {
    Result<FinalProfile, AssemblyProblem>.Success { value } => {
      run Semantic.reviseProfile(&mut store, Option<FinalProfile>.some(move value))
    }
    Result<FinalProfile, AssemblyProblem>.Failure { error } => {
      let refusal = match move error {
        AssemblyProblem.Default { rejection } => Refusal.DefaultRejected { rejection: move rejection }
        AssemblyProblem.Profile { error: problem } => Refusal.Profile { problem: problem }
        AssemblyProblem.Binding { error: refused } => Refusal.Binding { error: move refused }
        AssemblyProblem.InputMismatch => Refusal.InputMismatch
      }
      return Opened.Refused { sources: move sources, store: move store, refusal: move refusal }
    }
  }
  return Opened.Ready {
    analysis: Analysis {
      sources: move sources,
      store: move store,
      request: move request,
      rootPackage: move rootPackage,
      checked: move checked,
      identity: move identity,
      runtime: move runtime,
    },
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + 1
  }
  return true
}
