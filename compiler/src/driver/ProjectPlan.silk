//! The compilations a project command plans: one logical profile each, with the bindings it supplies.
//!
//! This follows the TypeScript `BuildBatch.make`. A full profile (`--profile-input`, JSON) or a
//! named one (`--profile`, else `[build].profile` when neither `--target` nor `--profile-input` is
//! given) is one compilation with its own target and optimization, and conflicts with `--target`,
//! `--release` and `--optimization`; selecting both is refused. Otherwise each
//! selected target is one compilation: the `--target` selectors, else the command's fallback, with
//! the optimization profile the options select. `--release` (or `--optimization release`) builds
//! the manifest's `[profiles.release]` when it declares one, once per `--target` given, else as
//! `--profile release` does. Every compilation receives the project-tier `[config]`, then the
//! selected profile's own.

import driver.Project as Projects { Form, Project }
import driver.CommandPath
import silk.system.filesystem { FileError, Path }
import driver.ProjectCommand as ProjectCommands { Options }
import driver.ProjectProfile as ProjectProfiles { Code, InvalidProfile, Profile }
import driver.TargetSelector as TargetSelectors { UnknownTarget }
import semantic.InitialProfile { Input as ProfileInput }
import semantic.ProfileBinding { Supplied }
import semantic.Target { Target }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.json.scanner { JsonError }
import silk.json.value { Json, Value as JsonValue }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.toml.scanner { TomlError }
import silk.toml.value { Toml, Value as TomlValue }
import silk.text.string { String }
import silk.num.usize
import silk.collections.list { List }

/// One planned compilation: its logical profile, not yet frozen, and the bindings it supplies.
pub struct ProjectPlan {
  /// The logical profile.
  pub input: ProfileInput,
  /// Project-tier bindings (`[config]`), then the selected profile's own.
  pub bindings: List<Supplied>,
  /// The named project profile this plan builds, as written; none for an optimization or a full
  /// `--profile-input` plan.
  pub name: Option<Bytes>,
  /// The wasm32 memory limit the profile sets, in bytes; see `Profile.maxMemory`.
  pub maxMemory: Option<u64>,
  /// The wasm32 main stack the profile sets, in bytes; see `Profile.stackSize`.
  pub stackSize: Option<u64>,
  /// The root module the named profile's `main` selects, resolved below the source root; none
  /// for the package's own `[package].main`.
  pub entry: Option<Path>,
}

/// The name of the profile `silk task` builds. Undeclared, it is an executable for the host
/// rooted at `tasks.silk`; a `[profiles.tasks]` table keeps those defaults for what it leaves out.
pub fn tasksProfile() -> &'static [u8] {
  return b"tasks"
}

/// The root module `plan` builds: its profile's `main`, else the package's.
pub fn entry<'a>(plan: &'a ProjectPlan, project: &'a Project) -> &'a Path {
  if let Option<Path>.Some { value } = &plan.entry { return &value }
  return Projects.entry(project)
}

/// The artifact form `plan` builds: the form its profile's `artifact` names, else the one
/// `[package].kind` gives. A library's own `static-archive` stays a library, which links nothing.
pub fn form(plan: &ProjectPlan, project: &Project) -> Form {
  let kind = Projects.form(project)
  let written = match &plan.input.artifact {
    Option<Bytes>.Some { value } => Bytes.asSlice(&value)
    Option<Bytes>.None => { return kind }
  }
  if same(written, Projects.profileArtifact(kind)) { return kind }
  if same(written, b"executable") { return Form.Executable }
  if same(written, b"loadable-module") { return Form.SharedLibrary }
  if same(written, b"static-archive") { return Form.StaticLibrary }
  if same(written, b"object") { return Form.Object }
  return kind
}

/// Why a project command has no plan.
pub union PlanError {
  /// A named profile was combined with `--target` or an optimization flag.
  ConflictingSelection,
  /// A target selector names no supported target.
  UnknownTarget { pub selector: Bytes },
  /// A profile or binding was refused with the TypeScript code and subject; `key` is the dotted
  /// manifest key it names, or empty.
  Profile { pub code: Code, pub subject: Bytes, pub key: Bytes },
  /// `--profile-input` is not JSON.
  InvalidProfileInput,
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn refused(problem: InvalidProfile) -> never ! PlanError {
  let InvalidProfile { code, subject, key } = move problem
  fail PlanError.Profile { code: code, subject: move subject, key: move key }
}

// The root module `profiles.<name>.main` names below `project`'s source root, or none when the
// profile writes no `main`. The `tasks` profile defaults to `tasks.silk`.
effect fn profileEntry(project: &Project, document: &TomlValue, name: &[u8]) -> Option<Path>
  ! PlanError | OutOfMemoryError
  ? &mut Allocator {
  let mut key = run Bytes.copy(b"profiles.")
  run Bytes.append(&mut key, name)
  run Bytes.append(&mut key, b".main")
  let table = ProjectProfiles.table(document, name)
  let main = match move table {
    Option<&TomlValue>.Some { value } => Toml.field(value, "main")
    Option<&TomlValue>.None => Option<&TomlValue>.none()
  }
  let written = match move main {
    Option<&TomlValue>.Some { value } => match move Toml.asString(Option<&TomlValue>.some(value)) {
      Option<string>.Some { value: spelled } => String.utf8Bytes(spelled)
      Option<string>.None => run refusedMain(move key)
    }
    Option<&TomlValue>.None => {
      if !same(name, tasksProfile()) { return Option<Path>.none() }
      b"tasks.silk"
    }
  }
  let resolved = match move run Effect.result(CommandPath.resolve(Projects.sourceRoot(project), written)) {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError _invalid => run refusedMain(move key)
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  if !Projects.below(Projects.sourceRoot(project), &resolved) || written.length == usize.ZERO { run refusedMain(move key) }
  return Option<Path>.some(move resolved)
}

effect fn refusedMain(key: Bytes) -> never ! PlanError | OutOfMemoryError ? &mut Allocator {
  let mut subject = run Bytes.copy(Bytes.asSlice(&key))
  run Bytes.append(&mut subject, b" must name a module below the source root")
  fail PlanError.Profile { code: Code.InvalidInput, subject: move subject, key: move key }
}

// The profile `name` selects, with its bindings.
effect fn named(document: &TomlValue, name: &[u8]) -> ProjectPlan
  ! PlanError | OutOfMemoryError
  ? &mut Allocator {
  let selected = run Effect.result(ProjectProfiles.select(document, name))
  return match move selected {
    Result<Profile, InvalidProfile | OutOfMemoryError>.Success { value } => {
      let Profile { input, bindings, maxMemory, stackSize } = move value
      return ProjectPlan {
        input: move input, bindings: move bindings, name: Option<Bytes>.some(run Bytes.copy(name)), maxMemory: move maxMemory, stackSize: move stackSize,
        entry: Option<Path>.none(),
      }
    }
    Result<Profile, InvalidProfile | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProfile problem => run refused(move problem)
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// The full profile the JSON text `written` describes, with the project bindings.
effect fn supplied(document: &TomlValue, written: &[u8]) -> ProjectPlan
  ! PlanError | OutOfMemoryError
  ? &mut Allocator {
  let parsed = run Effect.result(Json.parse(written))
  let json = match move parsed {
    Result<JsonValue, JsonError | OutOfMemoryError>.Success { value } => move value
    Result<JsonValue, JsonError | OutOfMemoryError>.Failure { error } => match move error {
      JsonError malformed => {
        drop malformed
        fail PlanError.InvalidProfileInput
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let decoded = run Effect.result(ProjectProfiles.fromInput(document, &json))
  return match move decoded {
    Result<Profile, InvalidProfile | OutOfMemoryError>.Success { value } => {
      let Profile { input, bindings, maxMemory, stackSize } = move value
      return ProjectPlan { input: move input, bindings: move bindings, name: Option<Bytes>.none(), maxMemory: move maxMemory, stackSize: move stackSize, entry: Option<Path>.none() }
    }
    Result<Profile, InvalidProfile | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProfile problem => run refused(move problem)
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// The project-tier bindings of one target-selected compilation.
effect fn projectBindings(document: &TomlValue) -> List<Supplied>
  ! PlanError | OutOfMemoryError
  ? &mut Allocator {
  let decoded = run Effect.result(ProjectProfiles.projectBindings(document))
  return match move decoded {
    Result<List<Supplied>, InvalidProfile | OutOfMemoryError>.Success { value } => move value
    Result<List<Supplied>, InvalidProfile | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProfile problem => run refused(move problem)
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// The targets `selectors` name in order, `host` for `host`.
effect fn targets(selectors: &[Bytes], host: Target) -> List<Target>
  ! PlanError | OutOfMemoryError
  ? &mut Allocator {
  let resolved = run Effect.result(TargetSelectors.resolveAll(selectors, host))
  return match move resolved {
    Result<List<Target>, UnknownTarget | OutOfMemoryError>.Success { value } => move value
    Result<List<Target>, UnknownTarget | OutOfMemoryError>.Failure { error } => match move error {
      UnknownTarget unknown => {
        let UnknownTarget { selector } = move unknown
        fail PlanError.UnknownTarget { selector: move selector }
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

/// Plans `project`'s compilations for `options`; `fallback` holds the selectors used when neither
/// `--target` nor a named profile selects any, and `host` is the compiler's host target.
pub effect fn make(project: &Project, options: &Options, fallback: &[Bytes], host: Target) -> List<ProjectPlan>
  ! PlanError | TomlError | OutOfMemoryError
  ? &mut Allocator {
  return run withBackend(options, run selected(project, options, fallback, host, Option<&[u8]>.none()))
}

/// The plans `silk test` builds: as [`make`], but a project that declares `[profiles.test]` tests
/// with it when the command line chooses no profile, target or optimization.
pub effect fn makeForTests(project: &Project, options: &Options, fallback: &[Bytes], host: Target) -> List<ProjectPlan>
  ! PlanError | TomlError | OutOfMemoryError
  ? &mut Allocator {
  return run withBackend(options, run selected(project, options, fallback, host, Option<&[u8]>.some(testProfile())))
}

/// The profile `silk test` uses when the manifest declares it.
pub fn testProfile() -> &'static [u8] { return b"test" }

effect fn withBackend(options: &Options, planned: List<ProjectPlan>) -> List<ProjectPlan> ! OutOfMemoryError ? &mut Allocator {
  let mut plans = move planned
  // `--backend` picks the code generator of every planned profile, whatever the profile writes.
  if let Option<Bytes>.Some { value: backend } = &options.backend {
    let listed = List<ProjectPlan>.asMutSlice(&mut plans)
    let mut at = usize.ZERO
    while at < listed.length {
      listed[at].input.backend = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&backend)))
      at = at + usize.ONE
    }
  }
  return move plans
}

effect fn selected(project: &Project, options: &Options, fallback: &[Bytes], host: Target, implicit: Option<&[u8]>) -> List<ProjectPlan>
  ! PlanError | TomlError | OutOfMemoryError
  ? &mut Allocator {
  let document = run Projects.document(project)
  let mut plans = List<ProjectPlan>.make()
  let targeted = List<Bytes>.length(&options.targets) > usize.ZERO
  let mut full = Option<ProjectPlan>.none()
  if let Option<Bytes>.Some { value: written } = &options.profileInput {
    full = Option<ProjectPlan>.some(run supplied(&document, Bytes.asSlice(&written)))
  }
  let overridden = match &full {
    Option<ProjectPlan>.Some { .. } => true
    Option<ProjectPlan>.None => false
  }
  let optimizationProfile = ProjectCommands.optimizationProfile(options)
  let optimized = match &optimizationProfile {
    Option<&[u8]>.Some { .. } => true
    Option<&[u8]>.None => false
  }
  let mut name = Option<Bytes>.none()
  if let Option<Bytes>.Some { value } = &options.profile {
    name = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&value)))
  } else if !targeted && !overridden {
    let mut declared = false
    if let Option<&[u8]>.Some { value: preferred } = move implicit {
      if !optimized && ProjectProfiles.declares(&document, preferred) {
        name = Option<Bytes>.some(run Bytes.copy(preferred))
        declared = true
      }
    }
    if !declared {
      if let Option<&[u8]>.Some { value } = move Projects.defaultProfile(project) {
        name = Option<Bytes>.some(run Bytes.copy(value))
      }
    }
  }
  let naming = match &name {
    Option<Bytes>.Some { .. } => true
    Option<Bytes>.None => false
  }
  if (naming || overridden) && (targeted || optimized) {
    fail PlanError.ConflictingSelection
  }
  if naming && overridden {
    fail PlanError.Profile {
      code: Code.ConflictingBindings,
      subject: run Bytes.copy(b"profile selection modes"),
      key: Bytes.make(),
    }
  }
  if let Option<ProjectPlan>.Some { value } = move full {
    run List<ProjectPlan>.append(&mut plans, move value)
    return move plans
  }
  if let Option<Bytes>.Some { value: chosen } = move name {
    let picked = Bytes.asSlice(&chosen)
    let tasks = same(picked, tasksProfile())
    let mut plan = run named(&document, picked)
    // The tasks profile is a program for the host unless its table says otherwise.
    if tasks {
      if let Option<Bytes>.None = &plan.input.artifact { plan.input.artifact = Option<Bytes>.some(run Bytes.copy(b"executable")) }
    }
    plan.entry = run profileEntry(project, &document, picked)
    run List<ProjectPlan>.append(&mut plans, move plan)
    return move plans
  }
  // `debug` (the default) is unoptimized; `release` drops debug information.
  let mut optimization: &[u8] = b"none"
  let mut debug = true
  let mut releasing = false
  if let Option<&[u8]>.Some { value: chosen } = move optimizationProfile {
    if !same(chosen, b"debug") {
      optimization = b"speed"
    }
    debug = !same(chosen, b"release")
    releasing = same(chosen, b"release")
  }
  // `release` builds the manifest's own `[profiles.release]` when it declares one, as
  // `--profile release` does; each `--target` then replaces the table's target.
  let declared = releasing && ProjectProfiles.declares(&document, b"release")
  if declared && !targeted {
    let mut plan = run named(&document, b"release")
    plan.entry = run profileEntry(project, &document, b"release")
    run List<ProjectPlan>.append(&mut plans, move plan)
    return move plans
  }
  let mut selected = run targets(List<Bytes>.asSlice(&options.targets), host)
  if !targeted {
    selected = run targets(fallback, host)
  }
  let chosenTargets = List<Target>.asSlice(&selected)
  let mut at = usize.ZERO
  while at < chosenTargets.length {
    if declared {
      let mut plan = run named(&document, b"release")
      plan.entry = run profileEntry(project, &document, b"release")
      plan.input.target = Option<Bytes>.some(run Bytes.copy(Target.name(&chosenTargets[at])))
      run List<ProjectPlan>.append(&mut plans, move plan)
      at = at + usize.ONE
      continue
    }
    let mut input = ProfileInput.make()
    input.target = Option<Bytes>.some(run Bytes.copy(Target.name(&chosenTargets[at])))
    input.optimization = Option<Bytes>.some(run Bytes.copy(optimization))
    input.debug = Option<bool>.some(debug)
    let bindings = run projectBindings(&document)
    run List<ProjectPlan>.append(&mut plans, ProjectPlan {
      input: move input, bindings: move bindings, name: Option<Bytes>.none(), maxMemory: Option<u64>.none(), stackSize: Option<u64>.none(),
      entry: Option<Path>.none(),
    })
    at = at + usize.ONE
  }
  return move plans
}
