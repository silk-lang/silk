//! The compilations a project command plans: one logical profile each, with the bindings it supplies.
//!
//! This follows the TypeScript `BuildBatch.make`. A full profile (`--profile-input`, JSON) or a
//! named one (`--profile`, else `[build].profile` when neither `--target` nor `--profile-input` is
//! given) is one compilation with its own target and optimization, and conflicts with `--target`,
//! `--release` and `--optimization`; selecting both is refused. Otherwise each
//! selected target is one compilation: the `--target` selectors, else the command's fallback, with
//! the optimization profile the options select. Every compilation receives the project-tier
//! `[build].bindings`, then the selected profile's own.

import driver.Project as Projects { Project }
import driver.ProjectCommand as ProjectCommands { Options }
import driver.ProjectProfile as ProjectProfiles { Code, InvalidProfile, Profile }
import driver.TargetSelector as TargetSelectors { UnknownTarget }
import semantic.InitialProfile { Input as ProfileInput }
import semantic.ProfileBinding { Supplied }
import semantic.Target { Target }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.json_scanner { JsonError }
import silk.json_value { Json, Value as JsonValue }
import silk.option { Option }
import silk.result { Result }
import silk.toml_scanner { TomlError }
import silk.toml_value { Value as TomlValue }
import silk.usize
import silk.vector { Vector }

/// One planned compilation: its logical profile, not yet frozen, and the bindings it supplies.
pub struct ProjectPlan {
  /// The logical profile.
  pub input: ProfileInput
  /// Project-tier bindings, then the selected profile's own.
  pub bindings: Vector<Supplied>
}

/// Why a project command has no plan.
pub union PlanError {
  /// A named profile was combined with `--target` or an optimization flag.
  ConflictingSelection,
  /// A target selector names no supported target.
  UnknownTarget { pub selector: Bytes },
  /// A profile or binding was refused with the TypeScript code and subject.
  Profile { pub code: Code, pub subject: Bytes },
  /// `--profile-input` is not JSON.
  InvalidProfileInput,
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn refused(problem: InvalidProfile) -> never ! PlanError {
  let InvalidProfile { code, subject } = move problem
  fail PlanError.Profile { code: code, subject: move subject }
}

// The profile `name` selects, with its bindings.
effect fn named(document: &TomlValue, name: &[u8]) -> ProjectPlan
  ! PlanError | OutOfMemoryError
  ? &mut Allocator {
  let selected = run Effect.result(ProjectProfiles.select(document, name))
  return match move selected {
    Result<Profile, InvalidProfile | OutOfMemoryError>.Success { value } => {
      let Profile { input, bindings } = move value
      return ProjectPlan { input: move input, bindings: move bindings }
    }
    Result<Profile, InvalidProfile | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProfile problem => run refused(move problem)
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// The full profile the JSON text `written` describes, with the project bindings.
effect fn supplied(document: &TomlValue, written: &[u8]) -> ProjectPlan
  ! PlanError | OutOfMemoryError
  ? &mut Allocator {
  let parsed = run Effect.result(Json.parse(written))
  let json = match move parsed {
    Result<JsonValue, JsonError | OutOfMemoryError>.Success { value } => move value
    Result<JsonValue, JsonError | OutOfMemoryError>.Failure { error } => match move error {
      JsonError malformed => {
        drop malformed
        fail PlanError.InvalidProfileInput
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let decoded = run Effect.result(ProjectProfiles.fromInput(document, &json))
  return match move decoded {
    Result<Profile, InvalidProfile | OutOfMemoryError>.Success { value } => {
      let Profile { input, bindings } = move value
      return ProjectPlan { input: move input, bindings: move bindings }
    }
    Result<Profile, InvalidProfile | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProfile problem => run refused(move problem)
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// The project-tier bindings of one target-selected compilation.
effect fn projectBindings(document: &TomlValue) -> Vector<Supplied>
  ! PlanError | OutOfMemoryError
  ? &mut Allocator {
  let decoded = run Effect.result(ProjectProfiles.projectBindings(document))
  return match move decoded {
    Result<Vector<Supplied>, InvalidProfile | OutOfMemoryError>.Success { value } => move value
    Result<Vector<Supplied>, InvalidProfile | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProfile problem => run refused(move problem)
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// The targets `selectors` name in order, `host` for `host`.
effect fn targets(selectors: &[Bytes], host: Target) -> Vector<Target>
  ! PlanError | OutOfMemoryError
  ? &mut Allocator {
  let resolved = run Effect.result(TargetSelectors.resolveAll(selectors, host))
  return match move resolved {
    Result<Vector<Target>, UnknownTarget | OutOfMemoryError>.Success { value } => move value
    Result<Vector<Target>, UnknownTarget | OutOfMemoryError>.Failure { error } => match move error {
      UnknownTarget unknown => {
        let UnknownTarget { selector } = move unknown
        fail PlanError.UnknownTarget { selector: move selector }
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

/// Plans `project`'s compilations for `options`; `fallback` holds the selectors used when neither
/// `--target` nor a named profile selects any, and `host` is the compiler's host target.
pub effect fn make(project: &Project, options: &Options, fallback: &[Bytes], host: Target) -> Vector<ProjectPlan>
  ! PlanError | TomlError | OutOfMemoryError
  ? &mut Allocator {
  let document = run Projects.document(project)
  let mut plans = Vector<ProjectPlan>.make()
  let targeted = Vector<Bytes>.length(&options.targets) > usize.ZERO
  let mut full = Option<ProjectPlan>.none()
  if let Option<Bytes>.Some { value: written } = &options.profileInput {
    full = Option<ProjectPlan>.some(run supplied(&document, Bytes.asSlice(&written)))
  }
  let overridden = match &full {
    Option<ProjectPlan>.Some { .. } => true
    Option<ProjectPlan>.None => false
  }
  let mut name = Option<Bytes>.none()
  if let Option<Bytes>.Some { value } = &options.profile {
    name = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&value)))
  } else if !targeted && !overridden {
    if let Option<&[u8]>.Some { value } = move Projects.defaultProfile(project) {
      name = Option<Bytes>.some(run Bytes.copy(value))
    }
  }
  let optimizationProfile = ProjectCommands.optimizationProfile(options)
  let optimized = match &optimizationProfile {
    Option<&[u8]>.Some { .. } => true
    Option<&[u8]>.None => false
  }
  let naming = match &name {
    Option<Bytes>.Some { .. } => true
    Option<Bytes>.None => false
  }
  if (naming || overridden) && (targeted || optimized) {
    fail PlanError.ConflictingSelection
  }
  if naming && overridden {
    fail PlanError.Profile { code: Code.ConflictingBindings, subject: run Bytes.copy(b"profile selection modes") }
  }
  if let Option<ProjectPlan>.Some { value } = move full {
    run Vector<ProjectPlan>.append(&mut plans, move value)
    return move plans
  }
  if let Option<Bytes>.Some { value: chosen } = move name {
    run Vector<ProjectPlan>.append(&mut plans, run named(&document, Bytes.asSlice(&chosen)))
    return move plans
  }
  let mut selected = run targets(Vector<Bytes>.asSlice(&options.targets), host)
  if !targeted {
    selected = run targets(fallback, host)
  }
  // `debug` (the default) is unoptimized; `release` drops debug information.
  let mut optimization: &[u8] = b"none"
  let mut debug = true
  if let Option<&[u8]>.Some { value: chosen } = move optimizationProfile {
    if !same(chosen, b"debug") {
      optimization = b"speed"
    }
    debug = !same(chosen, b"release")
  }
  let chosenTargets = Vector<Target>.asSlice(&selected)
  let mut at = usize.ZERO
  while at < chosenTargets.length {
    let mut input = ProfileInput.make()
    input.target = Option<Bytes>.some(run Bytes.copy(Target.name(&chosenTargets[at])))
    input.optimization = Option<Bytes>.some(run Bytes.copy(optimization))
    input.debug = Option<bool>.some(debug)
    let bindings = run projectBindings(&document)
    run Vector<ProjectPlan>.append(&mut plans, ProjectPlan { input: move input, bindings: move bindings })
    at = at + usize.ONE
  }
  return move plans
}
