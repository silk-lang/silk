//! Built-in command compilations. Project customization belongs to tasks.silk.

import driver.Project as Projects { Form, Project }
import driver.ProjectCommand { Options }
import driver.TargetSelector as TargetSelectors { UnknownTarget }
import semantic.InitialProfile { Input as ProfileInput }
import semantic.ProfileBinding { Supplied }
import semantic.Target { Target }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.system.filesystem { Path }
import silk.toml.scanner { TomlError }
import silk.num.usize

/// An internal command's explicit compilation settings.
pub struct ProjectPlan {
  pub input: ProfileInput,
  pub bindings: List<Supplied>,
  pub task: bool,
  pub maxMemory: Option<u64>,
  pub stackSize: Option<u64>,
  pub entry: Option<Path>,
  pub unsandboxedTools: bool,
}

/// A target selector that names no supported target.
pub union PlanError {
  UnknownTarget { pub selector: Bytes }
}

pub fn entry<'a>(plan: &'a ProjectPlan, project: &'a Project) -> &'a Path {
  if let Option<Path>.Some { value } = &plan.entry {
    return &value
  }
  return Projects.entry(project)
}

pub fn form(plan: &ProjectPlan, project: &Project) -> Form {
  let kind = Projects.form(project)
  let written = match &plan.input.artifact {
    Option<Bytes>.Some { value } => Bytes.asSlice(&value)
    Option<Bytes>.None => {
      return kind
    }
  }
  if same(written, Projects.profileArtifact(kind)) {
    return kind
  }
  if same(written, b"executable") {
    return Form.Executable
  }
  if same(written, b"loadable-module") {
    return Form.SharedLibrary
  }
  if same(written, b"static-archive") {
    return Form.StaticLibrary
  }
  if same(written, b"object") {
    return Form.Object
  }
  return kind
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn targets(selectors: &[Bytes], host: Target) -> List<Target>
  ! PlanError | OutOfMemoryError
  ? &mut Allocator {
  let resolved = run Effect.result(TargetSelectors.resolveAll(selectors, host))
  return match move resolved {
    Result<List<Target>, UnknownTarget | OutOfMemoryError>.Success { value } => move value
    Result<List<Target>, UnknownTarget | OutOfMemoryError>.Failure { error } => match move error {
      UnknownTarget unknown => {
        let UnknownTarget { selector } = move unknown
        fail PlanError.UnknownTarget { selector: move selector }
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

/// Makes the built-in compilation for each selected target.
pub effect fn make(options: &Options, host: Target) -> List<ProjectPlan>
  ! PlanError | TomlError | OutOfMemoryError
  ? &mut Allocator {
  let mut plans = List<ProjectPlan>.make()
  let optimization = String.utf8Bytes(options.standard.optimize.text())
  let debug = options.standard.debugInfo()
  let mut requested = List<Bytes>.make()
  let requestedTargets = options.standard.target.asSlice()
  let mut targetAt: usize = 0
  while targetAt < requestedTargets.length {
    run requested.append(run Bytes.copy(String.ownedUtf8Bytes(&requestedTargets[targetAt])))
    targetAt = targetAt + 1
  }
  if requested.length() == 0 {
    run requested.append(run Bytes.copy(b"host"))
  }
  let selectors = requested.asSlice()
  let selected = run targets(selectors, host)
  let listed = selected.asSlice()
  let mut at: usize = 0
  while at < listed.length {
    let mut input = ProfileInput.make()
    input.target = Option<Bytes>.some(run Bytes.copy(Target.name(&listed[at])))
    input.optimization = Option<Bytes>.some(run Bytes.copy(optimization))
    input.debug = Option<bool>.some(debug)
    if let Option<Bytes>.Some { value } = &options.backend {
      input.backend = Option<Bytes>.some(run Bytes.copy(value.asSlice()))
    }
    run plans.append(
      ProjectPlan {
        input: move input,
        bindings: List<Supplied>.make(),
        task: false,
        maxMemory: Option<u64>.none(),
        stackSize: Option<u64>.none(),
        entry: Option<Path>.none(),
        unsandboxedTools: options.standard.unsandboxedTools,
      },
    )
    at = at + 1
  }
  return move plans
}
