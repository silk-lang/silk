//! A cache stamp names the running compiler, and an image written under another compiler's stamp
//! reads as nothing.

import driver.CacheStamp
import semantic.CacheImage
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.Query {Cycle}
import semantic.Semantic {Request, Semantic}
import semantic.SemanticCaseSupport {makeSemantic, module, present}
import semantic.SourceIndex {RevisionMismatch}
import semantic.SourceRevision {Revision}
import semantic.Types {TypeTable, Types}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.system.filesystem {FileSystem}
import silk.system.filesystem_native {OsFileSystem}
import silk.option {Option}
import silk.testing.testing {AssertionError, Testing}
import silk.num.usize

test effect fn imagesDoNotOutliveTheirCompiler() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make("/") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut typeTable = TypeTable.make()
  return run stampClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<FileSystem>(&mut files)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn stampClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut FileSystem | &mut Types {
  let compiler = match move run CacheStamp.compiler() {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => {
      // A development build on a system that names no executable keeps no cache.
      return ()
    }
  }
  let again = run CacheStamp.compiler()
  run Testing.expect(holds(&again, Bytes.asSlice(&compiler)), "the running compiler's identity is the same each time")

  let app = run module("app.silk")
  let revision = run Revision.publish(&Revision.make(), &app, &run present("pub fn main() -> i32 {\n  return 0\n}\n"))
  let mut store = makeSemantic(move revision)
  let mut request = Request.make()
  drop run Semantic.checkModule(&mut store, &mut request, &app, &Option<ModuleId>.none())
  let stamp = run CacheStamp.stamp(&store, Bytes.asSlice(&compiler))
  let image = run Semantic.cacheImage(&mut store)
  let written = run CacheImage.encode(&image, Bytes.asSlice(&stamp))
  let read = run CacheImage.decode(Bytes.asSlice(&written), Bytes.asSlice(&stamp))
  run Testing.expect(isSome(&read), "an image reads back under the stamp it was written with")

  let other = run CacheStamp.stamp(&store, b"another compiler")
  let stale = run CacheImage.decode(Bytes.asSlice(&written), Bytes.asSlice(&other))
  run Testing.expect(!isSome(&stale), "an image from another compiler reads as nothing")
  return ()
}

fn isSome(value: &Option<CacheImage.Image>) -> bool {
  return match &value.* {
    Option<CacheImage.Image>.Some {..} => true
    Option<CacheImage.Image>.None => false
  }
}

fn holds(value: &Option<Bytes>, expected: &[u8]) -> bool {
  return match &value.* {
    Option<Bytes>.Some {value: found} => same(Bytes.asSlice(&found), expected)
    Option<Bytes>.None => false
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}
