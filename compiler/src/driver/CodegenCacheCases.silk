//! An output's cache keeps how long Clang last took to optimize its whole module, and a missing or
//! damaged record reads as nothing.

import driver.CodegenCache
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.effect {Effect}
import silk.system.filesystem {FileError, FileSystem, Path}
import silk.core.option {Option}
import silk.system.filesystem_native {OsFileSystem}
import silk.testing.testing {AssertionError, Testing}

effect fn ignoreCleanup(error: FileError | OutOfMemoryError) -> () { return () }

effect fn cleanup(path: &Path) -> () ? &mut FileSystem | &mut Allocator {
  return run Effect.catchAll(FileSystem.removeDirectoryRecursively(path), ignoreCleanup)
}

fn reads(record: Option<u64>, expected: u64) -> bool {
  return match record {
    Option<u64>.Some { value } => value == expected
    Option<u64>.None => false
  }
}

fn missing(record: Option<u64>) -> bool {
  return match record {
    Option<u64>.Some { value: _ } => false
    Option<u64>.None => true
  }
}

effect fn claims(directory: &Path) -> () ! FileError | OutOfMemoryError | AssertionError<'static> ? &mut FileSystem | &mut Allocator {
  run Testing.expect(missing(run CodegenCache.lastOptimize(directory)), "an output Clang never optimized has no time")
  run CodegenCache.recordOptimize(directory, 0)
  run Testing.expect(reads(run CodegenCache.lastOptimize(directory), 0), "a time of zero reads back")
  run CodegenCache.recordOptimize(directory, 33004917250)
  run Testing.expect(reads(run CodegenCache.lastOptimize(directory), 33004917250), "the latest time replaces the one before")
  let record = run Path.join(directory, "optimize-time")
  run FileSystem.writeFile(&record, b"33s")
  run Testing.expect(missing(run CodegenCache.lastOptimize(directory)), "a damaged record reads as nothing")
  return ()
}

effect fn exercise() -> () ! FileError | OutOfMemoryError | AssertionError<'static> ? &mut FileSystem | &mut Allocator {
  let parent = run Path.make(temporaryParent())
  let temporary = run FileSystem.temporaryDirectory(&parent, "silk-codegen-cache-case")
  return run Effect.ensuring(claims(&temporary.path), cleanup(&temporary.path))
}

fn temporaryParent() -> string<'static> {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return "/private/tmp" }
  else { return "/tmp" }
}

test effect fn optimizeTimesReadBackUntilDamaged() -> () ! FileError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make("/") |> Effect.provideMut<Allocator>(&mut allocator)
  return run exercise() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
}
