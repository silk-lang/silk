//! A host filesystem with one extra source file, so a documentation example builds as a module of
//! the package it documents without being written into that package.

import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.system.filesystem {AtomicWriteError, DirectoryEntry, DirectoryInfo, Durability, FileError, FileInfo, FileSystem, Path, PublicationPolicy}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.system.filesystem_machine {MachineFileSystem}

/// The host filesystem, where `path` reads as `content` and is listed in its directory.
pub struct ExampleSource {
  native: MachineFileSystem,
  path: Path,
  content: Bytes,
}

/// The host filesystem with `content` at `path`, which should name no existing file.
pub effect fn make(path: &Path, content: &[u8]) -> ExampleSource ! FileError | OutOfMemoryError ? &mut Allocator {
  let native = run MachineFileSystem.make()
  return ExampleSource {native: move native, path: run Path.fromBytes(Path.rawBytes(path)), content: run Bytes.copy(content)}
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

impl FileSystem for ExampleSource {
  effect fn readFile(self: &mut Self, path: &Path) -> Bytes ! FileError | OutOfMemoryError ? &mut Allocator {
    if same(Path.rawBytes(path), Path.rawBytes(&self.path)) { return run Bytes.copy(Bytes.asSlice(&self.content)) }
    return run FileSystem.readFile(path) |> Effect.provideMut<FileSystem>(&mut self.native)
  }
  effect fn writeFile(self: &mut Self, path: &Path, bytes: &[u8]) -> () ! FileError {
    return run FileSystem.writeFile(path, bytes) |> Effect.provideMut<FileSystem>(&mut self.native)
  }
  effect fn createFile(self: &mut Self, path: &Path, bytes: &[u8]) -> () ! FileError {
    return run FileSystem.createFile(path, bytes) |> Effect.provideMut<FileSystem>(&mut self.native)
  }
  effect fn writeFileAtomic(self: &mut Self, path: &Path, bytes: &[u8], policy: PublicationPolicy, durability: Durability) -> () ! AtomicWriteError {
    return run FileSystem.writeFileAtomic(path, bytes, move policy, move durability) |> Effect.provideMut<FileSystem>(&mut self.native)
  }
  effect fn syncDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    return run FileSystem.syncDirectory(path) |> Effect.provideMut<FileSystem>(&mut self.native)
  }
  effect fn stat(self: &mut Self, path: &Path) -> FileInfo | DirectoryInfo ! FileError {
    if same(Path.rawBytes(path), Path.rawBytes(&self.path)) { return FileSystem.fileInfo(Bytes.length(&self.content)) }
    return run FileSystem.stat(path) |> Effect.provideMut<FileSystem>(&mut self.native)
  }
  effect fn listDirectory(self: &mut Self, path: &Path) -> List<DirectoryEntry> ! FileError | OutOfMemoryError ? &mut Allocator {
    let mut listed = run FileSystem.listDirectory(path) |> Effect.provideMut<FileSystem>(&mut self.native)
    if let Option<Path>.Some {value: parent} = move run Path.parent(&self.path) {
      if same(Path.rawBytes(path), Path.rawBytes(&parent)) {
        run List<DirectoryEntry>.append(&mut listed, FileSystem.directoryEntry(run Path.fromBytes(Path.rawBytes(&self.path)), FileSystem.file()))
      }
    }
    return move listed
  }
  effect fn createDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    return run FileSystem.createDirectory(path) |> Effect.provideMut<FileSystem>(&mut self.native)
  }
  effect fn removeFile(self: &mut Self, path: &Path) -> () ! FileError {
    return run FileSystem.removeFile(path) |> Effect.provideMut<FileSystem>(&mut self.native)
  }
  effect fn removeDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    return run FileSystem.removeDirectory(path) |> Effect.provideMut<FileSystem>(&mut self.native)
  }
  effect fn createTemporaryDirectory(self: &mut Self, parent: &Path, prefix: &[u8]) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    return run FileSystem.createTemporaryDirectory(parent, prefix) |> Effect.provideMut<FileSystem>(&mut self.native)
  }
}
