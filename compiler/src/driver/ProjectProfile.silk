//! Named project profiles and package-parameter bindings from a project manifest.
//!
//! `[profiles.<name>]` tables hold complete logical profiles (`target` is required) with optional
//! profile-tier `bindings`; `[build].profile` names the default one and `[build].bindings` holds
//! project-tier bindings that every build receives. This mirrors the TypeScript
//! `ProjectProfile.catalog`, `ProjectProfile.decode`, `CompilationProfile.decode` and
//! `ConfigurationValue.decode`: a manifest load validates the whole catalog, and a build decodes
//! the selected profile again. Refusals carry the TypeScript `<code>: <subject>` pair. A full
//! profile can also arrive as JSON (`--profile-input`), with the same fields and bindings.

import semantic.InitialProfile {
  Field as ProfileField,
  InitialProfile,
  Input as ProfileInput,
  Problem as InitialProfileProblem,
  ProblemKind,
  Selection as ProfileSelection,
}
import semantic.ProfileBinding {
  Field as BindingField,
  Input as BindingInput,
  Provenance,
  Supplied,
  Tier,
}
import silk.allocator { Allocator, OutOfMemoryError }
import silk.box { Box }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.option { Option }
import silk.result { Result }
import silk.slice { Slice }
import silk.string { String }
import silk.json_value { JsonChild, Value as JsonValue }
import silk.toml_value { TableKind, Toml, TomlChild, TomlEntry, Value as TomlValue }
import silk.u8
import silk.usize
import silk.list { List }

/// The configuration error class of a refused profile or binding, as the TypeScript codes name it.
pub enum Code {
  /// A value is absent, malformed or outside its domain.
  InvalidInput,
  /// A value is in its domain but the selected target cannot use it.
  UnsupportedCombination,
  /// A binding's provenance may not enter a build.
  ForbiddenProvenance,
  /// More than one profile selection mode was requested.
  ConflictingBindings,
  /// A profile table names a field profiles do not have; `subject` is the field.
  UnknownField,
  /// A valid value the native compiler cannot honor yet, refused rather than ignored.
  NotNative,
}

/// A profile catalog, profile or binding that a build cannot use.
pub struct InvalidProfile {
  /// The error class.
  pub code: Code
  /// The refused input, such as `profiles.fast.cpu.model` or `profiles.fast.libc = "gnu"`.
  pub subject: Bytes
  /// The dotted manifest key the refusal names, such as `profiles.fast.libc`, or empty when it
  /// names none.
  pub key: Bytes
}

/// One selected profile: its logical input and the bindings it supplies.
pub struct Profile {
  /// The logical profile, not yet frozen.
  pub input: ProfileInput
  /// Project-tier bindings followed by the profile's own.
  pub bindings: List<Supplied>
  /// The most linear memory a wasm32 module may grow to, in bytes, when `maxMemory` sets it. Only
  /// the final link reads it, so it stays out of the frozen profile that source specialization
  /// keys on.
  pub maxMemory: Option<usize>
}

// The deepest binding value the TypeScript decoder admits.
fn maximumDepth() -> usize {
  return usize.add(0, 128)
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn refuse(code: Code, subject: &[u8]) -> never ! InvalidProfile | OutOfMemoryError ? &mut Allocator {
  fail InvalidProfile { code: code, subject: run Bytes.copy(subject), key: Bytes.make() }
}

// The dotted path `path`, a `.` and `name`.
effect fn below(path: &[u8], name: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut joined = run Bytes.copy(path)
  run Bytes.append(&mut joined, b".")
  run Bytes.append(&mut joined, name)
  return move joined
}

// Appends `value` to `out` in decimal.
effect fn appendDecimal(out: &mut Bytes, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= usize.add(0, 10) {
    run appendDecimal(&mut out.*, usize.divide(value, usize.add(0, 10)))
  }
  let digit: [u8; 1] = [usize.toU8(usize.add(0, 48) + usize.remainder(value, usize.add(0, 10)))]
  return run Bytes.append(&mut out.*, &digit)
}

// Refuses `subject` with `code`, naming the manifest key `key`.
effect fn refuseAt(code: Code, subject: &[u8], key: &[u8]) -> never ! InvalidProfile | OutOfMemoryError ? &mut Allocator {
  fail InvalidProfile { code: code, subject: run Bytes.copy(subject), key: run Bytes.copy(key) }
}

effect fn invalid(subject: &[u8]) -> never ! InvalidProfile | OutOfMemoryError ? &mut Allocator {
  return run refuse(Code.InvalidInput, subject)
}

/// The TypeScript spelling of `code`.
pub fn codeName(code: Code) -> &'static [u8] {
  return match code {
    Code.InvalidInput => b"InvalidInput"
    Code.UnsupportedCombination => b"UnsupportedCombination"
    Code.ForbiddenProvenance => b"ForbiddenProvenance"
    Code.ConflictingBindings => b"ConflictingBindings"
    Code.UnknownField => b"InvalidInput"
    Code.NotNative => b"Unsupported"
  }
}

fn isTable(value: &TomlValue) -> bool {
  return match &value.* {
    TomlValue.Table { .. } => true
    _ => false
  }
}

fn isArray(value: &TomlValue) -> bool {
  return match &value.* {
    TomlValue.Array { .. } => true
    _ => false
  }
}

// The number of members of a table; zero for another value kind.
fn keyCount(table: &TomlValue) -> usize {
  return match &table.* {
    TomlValue.Table { entries, kind: _ } => {
      let boxed = Box<List<TomlChild>>.get(&entries)
      return List<TomlChild>.length(&boxed[0])
    }
    _ => usize.ZERO
  }
}

// The member of a table at `index`, or `None` past its end or for another value kind.
fn memberAt<'a>(table: &'a TomlValue, index: usize) -> Option<&'a TomlChild> {
  return match &table.* {
    TomlValue.Table { entries, kind: _ } => {
      let boxed = Box<List<TomlChild>>.get(&entries)
      let children = List<TomlChild>.asSlice(&boxed[0])
      if index >= children.length {
        return Option<&'a TomlChild>.none()
      }
      return Option<&'a TomlChild>.some(&children[index])
    }
    _ => Option<&'a TomlChild>.none()
  }
}

// The key of a table member, or `None` for an array item.
fn memberKey<'a>(child: &'a TomlChild) -> Option<&'a [u8]> {
  return match &child.* {
    TomlChild.Member { entry } => Option<&'a [u8]>.some(String.ownedUtf8Bytes(&entry.key))
    TomlChild.Item { value: _ } => Option<&'a [u8]>.none()
  }
}

// The value of a table member, or `None` for an array item.
fn memberValue<'a>(child: &'a TomlChild) -> Option<&'a TomlValue> {
  return match &child.* {
    TomlChild.Member { entry } => Option<&'a TomlValue>.some(&entry.value)
    TomlChild.Item { value: _ } => Option<&'a TomlValue>.none()
  }
}

// The first key of `table` that is not one of `allowed`, or `None` when every key is.
fn unknownKey<'a>(table: &'a TomlValue, allowed: &[&[u8]]) -> Option<&'a [u8]> {
  let mut at = usize.ZERO
  while at < keyCount(table) {
    if let Option<&TomlChild>.Some { value: child } = move memberAt(table, at) {
      if let Option<&[u8]>.Some { value: key } = move memberKey(child) {
        let mut found = false
        let mut index = usize.ZERO
        while index < allowed.length {
          if same(key, allowed[index]) {
            found = true
          }
          index = index + usize.ONE
        }
        if !found {
          return Option<&'a [u8]>.some(key)
        }
      }
    }
    at = at + usize.ONE
  }
  return Option<&'a [u8]>.none()
}

// The value of the member of `table` named `name`, or `None`.
fn member<'a>(table: &'a TomlValue, name: &[u8]) -> Option<&'a TomlValue> {
  let mut at = usize.ZERO
  while at < keyCount(table) {
    if let Option<&TomlChild>.Some { value: child } = move memberAt(table, at) {
      if let Option<&[u8]>.Some { value: key } = move memberKey(child) {
        if same(key, name) {
          return memberValue(child)
        }
      }
    }
    at = at + usize.ONE
  }
  return Option<&'a TomlValue>.none()
}

// Whether every key of `table` is one of `allowed`.
fn onlyKeys(table: &TomlValue, allowed: &[&[u8]]) -> bool {
  let mut at = usize.ZERO
  while at < keyCount(table) {
    let mut found = false
    if let Option<&TomlChild>.Some { value: child } = move memberAt(table, at) {
      if let Option<&[u8]>.Some { value: key } = move memberKey(child) {
        let mut index = usize.ZERO
        while index < allowed.length {
          if same(key, allowed[index]) {
            found = true
          }
          index = index + usize.ONE
        }
      }
    }
    if !found {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn text<'a>(value: Option<&'a TomlValue>) -> Option<&'a [u8]> {
  return match move Toml.asString(move value) {
    Option<string<'a>>.Some { value: written } => Option<&'a [u8]>.some(String.utf8Bytes(written))
    Option<string<'a>>.None => Option<&'a [u8]>.none()
  }
}

fn hasValue(value: &Option<&TomlValue>) -> bool {
  return match &value.* {
    Option<&TomlValue>.Some { .. } => true
    Option<&TomlValue>.None => false
  }
}

fn hasText(value: &Option<&[u8]>) -> bool {
  return match &value.* {
    Option<&[u8]>.Some { .. } => true
    Option<&[u8]>.None => false
  }
}

// An optional string field: absent is `None`, another value kind refuses `subject`.
effect fn optionalText(table: &TomlValue, name: string, subject: &[u8]) -> Option<Bytes>
  ! InvalidProfile | OutOfMemoryError
  ? &mut Allocator {
  let field = Toml.field(table, name)
  if !hasValue(&field) {
    return Option<Bytes>.none()
  }
  return match move text(move field) {
    Option<&[u8]>.Some { value: written } => Option<Bytes>.some(run Bytes.copy(written))
    Option<&[u8]>.None => run invalid(subject)
  }
}

// An optional array of strings: absent is empty, anything else but strings refuses `subject`.
effect fn textSet(source: Option<&TomlValue>, subject: &[u8]) -> List<Bytes>
  ! InvalidProfile | OutOfMemoryError
  ? &mut Allocator {
  let mut values = List<Bytes>.make()
  let listed = match move source {
    Option<&TomlValue>.None => {
      return move values
    }
    Option<&TomlValue>.Some { value: present } => present
  }
  if !isArray(listed) {
    return run invalid(subject)
  }
  let mut at = usize.ZERO
  while true {
    let item = match move Toml.item(listed, at) {
      Option<&TomlValue>.Some { value: element } => element
      Option<&TomlValue>.None => {
        break
      }
    }
    match move text(Option<&TomlValue>.some(item)) {
      Option<&[u8]>.Some { value: written } => run List<Bytes>.append(&mut values, run Bytes.copy(written))
      Option<&[u8]>.None => run invalid(subject)
    }
    at = at + usize.ONE
  }
  return move values
}

// An entry or runtime request: absent is the default, else `{ kind = "default" | "none" }` or
// `{ kind = "named", name = "..." }`. `freeze` validates the name's spelling.
effect fn selection(source: Option<&TomlValue>, subject: &[u8]) -> ProfileSelection
  ! InvalidProfile | OutOfMemoryError
  ? &mut Allocator {
  let table = match move source {
    Option<&TomlValue>.None => {
      return ProfileSelection.Default
    }
    Option<&TomlValue>.Some { value: present } => present
  }
  if !isTable(table) {
    return run invalid(subject)
  }
  let kind = match move text(Toml.field(table, "kind")) {
    Option<&[u8]>.Some { value: written } => written
    Option<&[u8]>.None => run invalid(subject)
  }
  let kindOnly: [&[u8]; 1] = [b"kind"]
  let namedKeys: [&[u8]; 2] = [b"kind", b"name"]
  let mut unknown = Option<&[u8]>.none()
  if same(kind, b"default") || same(kind, b"none") {
    unknown = unknownKey(table, &kindOnly)
  } else if same(kind, b"named") {
    unknown = unknownKey(table, &namedKeys)
  }
  if let Option<&[u8]>.Some { value: key } = move unknown {
    let mut field = run Bytes.copy(subject)
    run Bytes.append(&mut field, b".")
    run Bytes.append(&mut field, key)
    return run refuse(Code.UnknownField, Bytes.asSlice(&field))
  }
  if same(kind, b"default") && keyCount(table) == usize.ONE {
    return ProfileSelection.Default
  }
  if same(kind, b"none") && keyCount(table) == usize.ONE {
    return ProfileSelection.None
  }
  if same(kind, b"named") && keyCount(table) == usize.add(0, 2) {
    if let Option<&[u8]>.Some { value: name } = move text(Toml.field(table, "name")) {
      return ProfileSelection.Named { name: run Bytes.copy(name) }
    }
  }
  return run invalid(subject)
}

// The TypeScript subject of a rejected `freeze` field.
fn fieldSubject(field: ProfileField) -> &'static [u8] {
  return match field {
    ProfileField.Target => b"target"
    ProfileField.Cpu => b"cpu.model"
    ProfileField.CpuFeatures => b"cpu.features"
    ProfileField.Deployment => b"deployment"
    ProfileField.Libc => b"libc"
    ProfileField.Artifact => b"artifact"
    ProfileField.Entry => b"entry"
    ProfileField.Link => b"link"
    ProfileField.CodeModel => b"codeModel"
    ProfileField.Relocation => b"relocation"
    ProfileField.Optimization => b"optimization"
    ProfileField.Safety => b"safety"
    ProfileField.Threading => b"threading"
    ProfileField.Sanitizers => b"sanitizers"
    ProfileField.Unwind => b"unwind"
    ProfileField.Runtime => b"runtime"
  }
}

// Reads one profile table's logical fields; `bindings` is read separately.
effect fn logical(table: &TomlValue) -> ProfileInput
  ! InvalidProfile | OutOfMemoryError
  ? &mut Allocator {
  let allowed: [&[u8]; 18] = [
    b"target", b"cpu", b"deployment", b"libc", b"artifact", b"entry", b"link", b"codeModel",
    b"relocation", b"optimization", b"debug", b"safety", b"threading", b"sanitizers", b"unwind",
    b"runtime", b"bindings", b"maxMemory",
  ]
  if let Option<&[u8]>.Some { value: key } = move unknownKey(table, &allowed) {
    return run refuse(Code.UnknownField, key)
  }
  let mut input = ProfileInput.make()
  let target = match move text(Toml.field(table, "target")) {
    Option<&[u8]>.Some { value } => run Bytes.copy(value)
    Option<&[u8]>.None => run invalid(b"target")
  }
  input.target = Option<Bytes>.some(move target)
  if let Option<&TomlValue>.Some { value: cpu } = move Toml.field(table, "cpu") {
    let cpuFields: [&[u8]; 2] = [b"model", b"features"]
    if !isTable(cpu) {
      return run invalid(b"cpu")
    }
    if let Option<&[u8]>.Some { value: key } = move unknownKey(cpu, &cpuFields) {
      let mut field = run Bytes.copy(b"cpu.")
      run Bytes.append(&mut field, key)
      return run refuse(Code.UnknownField, Bytes.asSlice(&field))
    }
    if hasValue(&Toml.field(cpu, "model")) {
      let model = match move text(Toml.field(cpu, "model")) {
        Option<&[u8]>.Some { value } => run Bytes.copy(value)
        Option<&[u8]>.None => run refuse(Code.UnsupportedCombination, b"cpu.model")
      }
      input.cpu = Option<Bytes>.some(move model)
    }
    input.cpuFeatures = run textSet(Toml.field(cpu, "features"), b"cpu.features")
  }
  input.deployment = run optionalText(table, "deployment", b"deployment")
  input.libc = run optionalText(table, "libc", b"libc")
  input.artifact = run optionalText(table, "artifact", b"artifact")
  input.entry = run selection(Toml.field(table, "entry"), b"entry")
  input.link = run optionalText(table, "link", b"link")
  input.codeModel = run optionalText(table, "codeModel", b"codeModel")
  input.relocation = run optionalText(table, "relocation", b"relocation")
  input.optimization = run optionalText(table, "optimization", b"optimization")
  if let Option<&TomlValue>.Some { value: debug } = move Toml.field(table, "debug") {
    input.debug = match &debug.* {
      TomlValue.Boolean { value } => Option<bool>.some(value)
      _ => run invalid(b"debug")
    }
  }
  input.safety = run optionalText(table, "safety", b"safety")
  input.threading = run optionalText(table, "threading", b"threading")
  input.sanitizers = run textSet(Toml.field(table, "sanitizers"), b"sanitizers")
  input.unwind = run optionalText(table, "unwind", b"unwind")
  input.runtime = run selection(Toml.field(table, "runtime"), b"runtime")
  // `freeze` owns the target-dependent checks; a valid profile is decoded again when selected.
  let frozen = run Effect.result(InitialProfile.freeze(&input))
  match move frozen {
    Result<InitialProfile, InitialProfileProblem | OutOfMemoryError>.Success { value } => {
      drop value
    }
    Result<InitialProfile, InitialProfileProblem | OutOfMemoryError>.Failure { error } => match move error {
      InitialProfileProblem problem => {
        let code = match problem.kind {
          ProblemKind.InvalidInput => Code.InvalidInput
          ProblemKind.UnsupportedCombination => Code.UnsupportedCombination
        }
        return run refuse(code, fieldSubject(problem.field))
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  if let Option<&[u8]>.Some { value: field } = move nativeGap(&input) {
    return run refuse(Code.NotNative, field)
  }
  return move input
}

fn writes(value: &Option<Bytes>, spelling: &[u8]) -> bool {
  return match &value.* {
    Option<Bytes>.Some { value: written } => same(Bytes.asSlice(&written), spelling)
    Option<Bytes>.None => false
  }
}

// The first valid field the native compiler cannot honor yet, as a non-default value: sanitizers
// need instrumented code, native unwinding needs unwind tables, the large code model is only
// built for x86_64, an entry selection needs a composition that names one, and no library reads
// the unchecked safety policy or, outside wasm32, the multi-threading one. The native build
// applies `cpu`, `link` and `codeModel`.
fn nativeGap(input: &ProfileInput) -> Option<&'static [u8]> {
  if List<Bytes>.length(&input.sanitizers) > usize.ZERO {
    return Option<&'static [u8]>.some(b"sanitizers")
  }
  if writes(&input.unwind, b"native") {
    return Option<&'static [u8]>.some(b"unwind")
  }
  // AArch64 Clang admits the large code model only for code that is not position independent,
  // and Darwin not at all.
  let mut x86 = false
  if let Option<Bytes>.Some { value: target } = &input.target {
    let written = Bytes.asSlice(&target)
    x86 = written.length > usize.add(0, 6) && same(Slice.view<u8>(written, usize.ZERO, usize.add(0, 7)), b"x86_64-")
  }
  let mut wasm = false
  if let Option<Bytes>.Some {value: target} = &input.target {
    wasm = same(Bytes.asSlice(&target), b"wasm32-unknown-unknown")
  }
  if writes(&input.codeModel, b"large") && !x86 {
    return Option<&'static [u8]>.some(b"codeModel")
  }
  if writes(&input.safety, b"unchecked") {
    return Option<&'static [u8]>.some(b"safety")
  }
  // Only wasm32 reads the threading policy: `multi` selects its wasi-threads profile.
  if writes(&input.threading, b"multi") && !wasm {
    return Option<&'static [u8]>.some(b"threading")
  }
  return match &input.entry {
    ProfileSelection.Default => Option<&'static [u8]>.none()
    _ => Option<&'static [u8]>.some(b"entry")
  }
}

fn exactKeys(table: &TomlValue, expected: &[&[u8]]) -> bool {
  return keyCount(table) == expected.length && onlyKeys(table, expected)
}

// Whether `value` is an exact decimal integer of at most 21 bytes, as the TypeScript decoder admits.
fn isDecimal(value: &[u8]) -> bool {
  if value.length == usize.ZERO || value.length > usize.add(0, 21) {
    return false
  }
  let mut start = usize.ZERO
  if value[usize.ZERO] == 45 {
    start = usize.ONE
  }
  if start == value.length {
    return false
  }
  if value[start] == 48 && value.length > start + usize.ONE {
    return false
  }
  let mut at = start
  while at < value.length {
    if value[at] < 48 || value[at] > 57 {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Decodes one portable binding value: a table whose `kind` selects its exact shape.
// `shown` is the value's path below a binding, as `value.value`, and `located` the same path from
// the binding's index, as `0.value.value`; an unknown field is named and located below them.
effect fn bindingValue(source: &TomlValue, depth: usize, shown: &[u8], located: &[u8]) -> BindingInput
  ! InvalidProfile | OutOfMemoryError
  ? &mut Allocator {
  let subject = b"configuration value"
  if depth > maximumDepth() || !isTable(source) {
    return run invalid(subject)
  }
  let kind = match move text(Toml.field(source, "kind")) {
    Option<&[u8]>.Some { value: written } => written
    Option<&[u8]>.None => run invalid(subject)
  }
  let withValue: [&[u8]; 2] = [b"kind", b"value"]
  let enumFields: [&[u8]; 3] = [b"kind", b"type", b"member"]
  let kindField: [&[u8]; 1] = [b"kind"]
  let arrayFields: [&[u8]; 2] = [b"kind", b"values"]
  let recordFields: [&[u8]; 2] = [b"kind", b"fields"]
  let mut unknown = Option<&[u8]>.none()
  if same(kind, b"integer") || same(kind, b"boolean") || same(kind, b"string") || same(kind, b"some") {
    unknown = unknownKey(source, &withValue)
  } else if same(kind, b"enum") {
    unknown = unknownKey(source, &enumFields)
  } else if same(kind, b"none") {
    unknown = unknownKey(source, &kindField)
  } else if same(kind, b"array") {
    unknown = unknownKey(source, &arrayFields)
  } else if same(kind, b"record") {
    unknown = unknownKey(source, &recordFields)
  }
  if let Option<&[u8]>.Some { value: key } = move unknown {
    let field = run below(shown, key)
    let at = run below(located, key)
    return run refuseAt(Code.UnknownField, Bytes.asSlice(&field), Bytes.asSlice(&at))
  }
  if same(kind, b"integer") {
    let decimal = match move text(Toml.field(source, "value")) {
      Option<&[u8]>.Some { value: written } => written
      Option<&[u8]>.None => run invalid(subject)
    }
    if !exactKeys(source, &withValue) || !isDecimal(decimal) {
      return run invalid(subject)
    }
    if same(decimal, b"-0") {
      return BindingInput.Integer { decimal: run Bytes.copy(b"0") }
    }
    return BindingInput.Integer { decimal: run Bytes.copy(decimal) }
  }
  if same(kind, b"boolean") {
    if exactKeys(source, &withValue) {
      if let Option<&TomlValue>.Some { value: present } = move Toml.field(source, "value") {
        if let TomlValue.Boolean { value: flag } = &present.* {
          return BindingInput.Boolean { value: flag }
        }
      }
    }
    return run invalid(subject)
  }
  if same(kind, b"string") {
    if exactKeys(source, &withValue) {
      if let Option<&[u8]>.Some { value: written } = move text(Toml.field(source, "value")) {
        return BindingInput.String { text: run Bytes.copy(written) }
      }
    }
    return run invalid(subject)
  }
  if same(kind, b"enum") {
    let enumKeys: [&[u8]; 3] = [b"kind", b"type", b"member"]
    let nominal = text(Toml.field(source, "type"))
    let member = text(Toml.field(source, "member"))
    if exactKeys(source, &enumKeys) {
      if let Option<&[u8]>.Some { value: typeName } = move nominal {
        if let Option<&[u8]>.Some { value: memberName } = move member {
          if typeName.length > usize.ZERO && memberName.length > usize.ZERO {
            return BindingInput.Enum { nominal: run Bytes.copy(typeName), member: run Bytes.copy(memberName) }
          }
        }
      }
    }
    return run invalid(subject)
  }
  if same(kind, b"none") {
    if keyCount(source) == usize.ONE {
      return BindingInput.None
    }
    return run invalid(subject)
  }
  if same(kind, b"some") {
    if exactKeys(source, &withValue) {
      if let Option<&TomlValue>.Some { value: inner } = move Toml.field(source, "value") {
        let innerShown = run below(shown, b"value")
        let innerLocated = run below(located, b"value")
        let decoded = run bindingValue(inner, depth + usize.ONE, Bytes.asSlice(&innerShown), Bytes.asSlice(&innerLocated))
        return BindingInput.Some { value: run Box<BindingInput>.make(move decoded) }
      }
    }
    return run invalid(subject)
  }
  if same(kind, b"array") {
    let arrayKeys: [&[u8]; 2] = [b"kind", b"values"]
    let listed = match move Toml.field(source, "values") {
      Option<&TomlValue>.Some { value: present } => present
      Option<&TomlValue>.None => run invalid(subject)
    }
    if !exactKeys(source, &arrayKeys) || !isArray(listed) {
      return run invalid(subject)
    }
    let mut values = List<Box<BindingInput>>.make()
    let mut at = usize.ZERO
    while true {
      let item = match move Toml.item(listed, at) {
        Option<&TomlValue>.Some { value: element } => element
        Option<&TomlValue>.None => {
          break
        }
      }
      let mut itemShown = run below(shown, b"values")
      run Bytes.append(&mut itemShown, b".")
      run appendDecimal(&mut itemShown, at)
      let mut itemLocated = run below(located, b"values")
      run Bytes.append(&mut itemLocated, b".")
      run appendDecimal(&mut itemLocated, at)
      let decoded = run bindingValue(item, depth + usize.ONE, Bytes.asSlice(&itemShown), Bytes.asSlice(&itemLocated))
      run List<Box<BindingInput>>.append(&mut values, run Box<BindingInput>.make(move decoded))
      at = at + usize.ONE
    }
    return BindingInput.Array { values: move values }
  }
  if same(kind, b"record") {
    let recordKeys: [&[u8]; 2] = [b"kind", b"fields"]
    let table = match move Toml.field(source, "fields") {
      Option<&TomlValue>.Some { value: present } => present
      Option<&TomlValue>.None => run invalid(subject)
    }
    if !exactKeys(source, &recordKeys) || !isTable(table) {
      return run invalid(subject)
    }
    let mut fields = List<BindingField>.make()
    let mut at = usize.ZERO
    while at < keyCount(table) {
      let child = match move memberAt(table, at) {
        Option<&TomlChild>.Some { value: present } => present
        Option<&TomlChild>.None => run invalid(subject)
      }
      let name = match move memberKey(child) {
        Option<&[u8]>.Some { value: key } => key
        Option<&[u8]>.None => run invalid(subject)
      }
      let field = match move memberValue(child) {
        Option<&TomlValue>.Some { value: present } => present
        Option<&TomlValue>.None => run invalid(subject)
      }
      let mut fieldShown = run below(shown, b"fields")
      run Bytes.append(&mut fieldShown, b".")
      run Bytes.append(&mut fieldShown, name)
      let mut fieldLocated = run below(located, b"fields")
      run Bytes.append(&mut fieldLocated, b".")
      run Bytes.append(&mut fieldLocated, name)
      let decoded = run bindingValue(field, depth + usize.ONE, Bytes.asSlice(&fieldShown), Bytes.asSlice(&fieldLocated))
      run List<BindingField>.append(&mut fields, BindingField {
        name: run Bytes.copy(name),
        value: run Box<BindingInput>.make(move decoded),
      })
      at = at + usize.ONE
    }
    return BindingInput.Record { fields: move fields }
  }
  return run invalid(subject)
}

// Decodes one binding's origin into a public provenance.
// `located` is the binding's index, which locates an unknown origin field.
effect fn provenance(binding: &TomlValue, located: &[u8]) -> Provenance
  ! InvalidProfile | OutOfMemoryError
  ? &mut Allocator {
  let origin = match move Toml.field(binding, "origin") {
    Option<&TomlValue>.Some { value: present } => present
    Option<&TomlValue>.None => run refuseField(Code.InvalidInput,
      b"origin is missing; write origin = { source = \"silk.toml\", provenance = \"literal\" }", located, b"")
  }
  if !isTable(origin) {
    return run refuseField(Code.InvalidInput,
      b"origin must be a table such as { source = \"silk.toml\", provenance = \"literal\" }", located, b"origin")
  }
  let originKeys: [&[u8]; 3] = [b"source", b"provenance", b"translator"]
  if let Option<&[u8]>.Some { value: key } = move unknownKey(origin, &originKeys) {
    let field = run below(b"origin", key)
    let mut at = run below(located, b"origin")
    run Bytes.append(&mut at, b".")
    run Bytes.append(&mut at, key)
    return run refuseAt(Code.UnknownField, Bytes.asSlice(&field), Bytes.asSlice(&at))
  }
  let source = text(Toml.field(origin, "source"))
  let kind = text(Toml.field(origin, "provenance"))
  if !hasText(&source) {
    let mut at: &[u8] = b"origin"
    if hasValue(&Toml.field(origin, "source")) {
      at = b"origin.source"
    }
    return run refuseField(Code.InvalidInput, b"origin.source must be a non-empty string", located, at)
  }
  let spelled = match move kind {
    Option<&[u8]>.Some { value } => value
    Option<&[u8]>.None => {
      if hasValue(&Toml.field(origin, "provenance")) {
        return run refuseField(Code.InvalidInput, b"origin.provenance must be a string", located, b"origin.provenance")
      }
      return run refuseField(Code.InvalidInput, b"origin.provenance is missing", located, b"origin")
    }
  }
  let translator = Toml.field(origin, "translator")
  let translated = text(Toml.field(origin, "translator"))
  if hasValue(&translator) && !hasText(&translated) {
    return run refuseField(Code.InvalidInput, b"origin.translator must be a non-empty string", located, b"origin.translator")
  }
  let mut named = run Bytes.copy(b"origin.provenance = \"")
  run Bytes.append(&mut named, spelled)
  run Bytes.append(&mut named, b"\"")
  if same(spelled, b"literal") {
    // Only a public translation names its translator; a literal value would drop it.
    if hasValue(&translator) {
      let mut at = run below(located, b"origin")
      run Bytes.append(&mut at, b".translator")
      return run refuseAt(
        Code.InvalidInput,
        b"origin.translator: only provenance \"translated-public\" names a translator",
        Bytes.asSlice(&at)
      )
    }
    return Provenance.Literal
  }
  if same(spelled, b"translated-public") {
    return match move translated {
      Option<&[u8]>.Some { value } => Provenance.TranslatedPublic { translator: run Bytes.copy(value) }
      // A public translation without a translator identity is not public.
      Option<&[u8]>.None => {
        run Bytes.append(&mut named, b" needs origin.translator")
        return run refuseField(Code.ForbiddenProvenance, Bytes.asSlice(&named), located, b"origin.provenance")
      }
    }
  }
  if same(spelled, b"secret") || same(spelled, b"physical-supply") || same(spelled, b"runtime") {
    run Bytes.append(&mut named, b" cannot be bound in a manifest")
    return run refuseField(Code.ForbiddenProvenance, Bytes.asSlice(&named), located, b"origin.provenance")
  }
  run Bytes.append(&mut named, b" is not literal, translated-public, secret, physical-supply or runtime")
  return run refuseField(Code.InvalidInput, Bytes.asSlice(&named), located, b"origin.provenance")
}

// Refuses `subject` with `code`, located at the binding `located` (its index) or, when `field` is
// not empty, at that field of it.
effect fn refuseField(code: Code, subject: &[u8], located: &[u8], field: &[u8]) -> never
  ! InvalidProfile | OutOfMemoryError
  ? &mut Allocator {
  let mut at = run Bytes.copy(located)
  if field.length > usize.ZERO {
    run Bytes.append(&mut at, b".")
    run Bytes.append(&mut at, field)
  }
  return run refuseAt(code, subject, Bytes.asSlice(&at))
}

// Refuses the binding at index `located` whose identity field `name` is missing or not a string:
// a missing one at the binding, a mistyped one at its own line.
effect fn identity(binding: &TomlValue, name: &[u8], located: &[u8]) -> never
  ! InvalidProfile | OutOfMemoryError
  ? &mut Allocator {
  let mut subject = run Bytes.copy(name)
  if hasValue(&member(binding, name)) {
    run Bytes.append(&mut subject, b" must be a string")
    return run refuseField(Code.InvalidInput, Bytes.asSlice(&subject), located, name)
  }
  run Bytes.append(&mut subject, b" is missing; a binding names its package, module and parameter")
  return run refuseField(Code.InvalidInput, Bytes.asSlice(&subject), located, b"")
}

// Decodes an optional array of binding tables into supplied bindings of `tier`.
effect fn bindings(source: Option<&TomlValue>, tier: Tier) -> List<Supplied>
  ! InvalidProfile | OutOfMemoryError
  ? &mut Allocator {
  let mut supplied = List<Supplied>.make()
  let listed = match move source {
    Option<&TomlValue>.None => {
      return move supplied
    }
    Option<&TomlValue>.Some { value: present } => present
  }
  if !isArray(listed) {
    return run invalid(b"bindings")
  }
  let identityKeys: [&[u8]; 5] = [b"package", b"module", b"parameter", b"value", b"origin"]
  let mut at = usize.ZERO
  while true {
    let item = match move Toml.item(listed, at) {
      Option<&TomlValue>.Some { value: element } => element
      Option<&TomlValue>.None => {
        break
      }
    }
    if !isTable(item) {
      return run invalid(b"binding")
    }
    let mut index = Bytes.make()
    run appendDecimal(&mut index, at)
    if let Option<&[u8]>.Some { value: key } = move unknownKey(item, &identityKeys) {
      let located = run below(Bytes.asSlice(&index), key)
      return run refuseAt(Code.UnknownField, key, Bytes.asSlice(&located))
    }
    let origin = run provenance(item, Bytes.asSlice(&index))
    let package = text(Toml.field(item, "package"))
    let module = text(Toml.field(item, "module"))
    let parameter = text(Toml.field(item, "parameter"))
    let packageName = match move package {
      Option<&[u8]>.Some { value: written } => written
      Option<&[u8]>.None => run identity(item, b"package", Bytes.asSlice(&index))
    }
    let moduleName = match move module {
      Option<&[u8]>.Some { value: written } => written
      Option<&[u8]>.None => run identity(item, b"module", Bytes.asSlice(&index))
    }
    let parameterName = match move parameter {
      Option<&[u8]>.Some { value: written } => written
      Option<&[u8]>.None => run identity(item, b"parameter", Bytes.asSlice(&index))
    }
    let written = match move Toml.field(item, "value") {
      Option<&TomlValue>.Some { value: present } => present
      Option<&TomlValue>.None => run refuseField(Code.InvalidInput, b"value is missing", Bytes.asSlice(&index), b"")
    }
    let valueLocated = run below(Bytes.asSlice(&index), b"value")
    let decoded = run bindingValue(written, usize.ZERO, b"value", Bytes.asSlice(&valueLocated))
    // A manifest names a module logically, as `[build].composition` does; its native identity is
    // the module's path relative to the package.
    let mut modulePath = run Bytes.copy(moduleName)
    run Bytes.append(&mut modulePath, b".silk")
    run List<Supplied>.append(&mut supplied, Supplied {
      package: run Bytes.copy(packageName),
      module: move modulePath,
      parameter: run Bytes.copy(parameterName),
      value: move decoded,
      provenance: move origin,
      tier: tier,
    })
    at = at + usize.ONE
  }
  return move supplied
}

// Whether `name` is a profile name: an ASCII letter, then letters, digits, `_` or `-`.
fn isProfileName(name: &[u8]) -> bool {
  if name.length == usize.ZERO {
    return false
  }
  let mut at = usize.ZERO
  while at < name.length {
    let char = name[at]
    let letter = char >= 65 && char <= 90 || char >= 97 && char <= 122
    let digit = char >= 48 && char <= 57
    if !letter && (at == usize.ZERO || !digit && char != 95 && char != 45) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// The project-tier bindings of `[build].bindings`.
pub effect fn projectBindings(document: &TomlValue) -> List<Supplied>
  ! InvalidProfile | OutOfMemoryError
  ? &mut Allocator {
  let decoded = run Effect.result(bindings(Toml.fieldAt(Toml.field(document, "build"), "bindings"), Tier.Project))
  return match move decoded {
    Result<List<Supplied>, InvalidProfile | OutOfMemoryError>.Success { value } => move value
    Result<List<Supplied>, InvalidProfile | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProfile problem => run located(b"build.bindings", Option<&TomlValue>.none(), move problem)
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// The value of the dotted field `path`, such as `cpu.model`, of `table`, or `None`.
fn fieldValue<'a>(table: &'a TomlValue, path: &[u8]) -> Option<&'a TomlValue> {
  let mut dot = usize.ZERO
  while dot < path.length && path[dot] != 46 {
    dot = dot + usize.ONE
  }
  let head = match move member(table, Slice.view<u8>(path, usize.ZERO, dot)) {
    Option<&'a TomlValue>.Some { value } => value
    Option<&'a TomlValue>.None => {
      return Option<&'a TomlValue>.none()
    }
  }
  if dot == path.length {
    return Option<&'a TomlValue>.some(head)
  }
  return member(head, Slice.view<u8>(path, dot + usize.ONE, path.length - dot - usize.ONE))
}

// Fails with `problem` located at the manifest key `prefix`. With the profile `table` the refusal
// names one of its fields, which joins `prefix` (a string value is quoted after it, as in
// `profiles.fast.libc = "gnu"`); without one, the refusal names an input of the bindings at `prefix`,
// or the unknown binding field that joins it.
effect fn located(prefix: &[u8], table: Option<&TomlValue>, problem: InvalidProfile) -> never
  ! InvalidProfile | OutOfMemoryError
  ? &mut Allocator {
  let InvalidProfile { code, subject, key: entry } = move problem
  let named = Bytes.asSlice(&subject)
  let mut key = run Bytes.copy(prefix)
  let profile = match move table {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      // A binding's unknown field is its own key below the bindings, as `build.bindings.extra`,
      // located by the binding's index when the refusal names one, as `build.bindings.0.extra`.
      if code == Code.UnknownField {
        let mut described = run Bytes.copy(prefix)
        run Bytes.append(&mut described, b".")
        run Bytes.append(&mut described, named)
        run Bytes.append(&mut key, b".")
        if Bytes.length(&entry) > usize.ZERO {
          run Bytes.append(&mut key, Bytes.asSlice(&entry))
        } else {
          run Bytes.append(&mut key, named)
        }
        fail InvalidProfile { code: code, subject: move described, key: move key }
      }
      let mut described = run Bytes.copy(prefix)
      run Bytes.append(&mut described, b": ")
      run Bytes.append(&mut described, named)
      // A refusal that names the binding's field is located there.
      if Bytes.length(&entry) > usize.ZERO {
        run Bytes.append(&mut key, b".")
        run Bytes.append(&mut key, Bytes.asSlice(&entry))
      }
      fail InvalidProfile { code: code, subject: move described, key: move key }
    }
  }
  run Bytes.append(&mut key, b".")
  run Bytes.append(&mut key, named)
  let mut described = run Bytes.copy(Bytes.asSlice(&key))
  if code != Code.UnknownField {
    if let Option<&[u8]>.Some { value: written } = move text(fieldValue(profile, named)) {
      run Bytes.append(&mut described, b" = \"")
      run Bytes.append(&mut described, written)
      run Bytes.append(&mut described, b"\"")
    }
  }
  fail InvalidProfile { code: code, subject: move described, key: move key }
}

/// Validates the manifest's profile catalog and project bindings and answers the default profile
/// name, `[build].profile`, when there is one.
pub effect fn catalog(document: &TomlValue) -> Option<Bytes>
  ! InvalidProfile | OutOfMemoryError
  ? &mut Allocator {
  if let Option<&TomlValue>.Some { value: table } = move Toml.field(document, "profiles") {
    if !isTable(table) {
      return run refuseAt(Code.InvalidInput, b"profiles", b"profiles")
    }
  }
  let defaultField = Toml.fieldAt(Toml.field(document, "build"), "profile")
  let defaultName = text(Toml.fieldAt(Toml.field(document, "build"), "profile"))
  if hasValue(&defaultField) && !hasText(&defaultName) {
    return run refuseAt(Code.InvalidInput, b"build.profile", b"build.profile")
  }
  let mut found = false
  if let Option<&TomlValue>.Some { value: table } = move Toml.field(document, "profiles") {
    let mut at = usize.ZERO
    while at < keyCount(table) {
      let child = match move memberAt(table, at) {
        Option<&TomlChild>.Some { value: present } => present
        Option<&TomlChild>.None => run invalid(b"profile name")
      }
      let name = match move memberKey(child) {
        Option<&[u8]>.Some { value: key } => key
        Option<&[u8]>.None => run invalid(b"profile name")
      }
      let mut prefix = run Bytes.copy(b"profiles.")
      run Bytes.append(&mut prefix, name)
      if !isProfileName(name) {
        let mut described = run Bytes.copy(Bytes.asSlice(&prefix))
        run Bytes.append(&mut described, b": a profile name is an ASCII letter, then letters, digits, `_` or `-`")
        return run refuseAt(Code.InvalidInput, Bytes.asSlice(&described), Bytes.asSlice(&prefix))
      }
      let profile = match move memberValue(child) {
        Option<&TomlValue>.Some { value: present } => present
        Option<&TomlValue>.None => run invalid(b"profile")
      }
      let decoded = run decode(Bytes.asSlice(&prefix), profile)
      drop decoded
      if let Option<&[u8]>.Some { value: chosen } = &defaultName {
        if same(chosen, name) {
          found = true
        }
      }
      at = at + usize.ONE
    }
  }
  let mut selected = Option<Bytes>.none()
  if let Option<&[u8]>.Some { value: chosen } = move defaultName {
    if !found {
      let mut described = run Bytes.copy(b"build.profile = \"")
      run Bytes.append(&mut described, chosen)
      run Bytes.append(&mut described, b"\" names no [profiles.")
      run Bytes.append(&mut described, chosen)
      run Bytes.append(&mut described, b"] table")
      return run refuseAt(Code.InvalidInput, Bytes.asSlice(&described), b"build.profile")
    }
    selected = Option<Bytes>.some(run Bytes.copy(chosen))
  }
  let project = run projectBindings(document)
  drop project
  return move selected
}

// Decodes one profile table with its profile-tier bindings.
// Decodes one profile table, written at the manifest key `prefix`, with its profile-tier bindings.
// A refusal names the field or binding input at its key.
effect fn decode(prefix: &[u8], table: &TomlValue) -> Profile
  ! InvalidProfile | OutOfMemoryError
  ? &mut Allocator {
  if !isTable(table) {
    return run refuseAt(Code.InvalidInput, prefix, prefix)
  }
  let mut bindingsKey = run Bytes.copy(prefix)
  run Bytes.append(&mut bindingsKey, b".bindings")
  let own = match move run Effect.result(bindings(Toml.field(table, "bindings"), Tier.Override)) {
    Result<List<Supplied>, InvalidProfile | OutOfMemoryError>.Success { value } => move value
    Result<List<Supplied>, InvalidProfile | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProfile problem => run located(Bytes.asSlice(&bindingsKey), Option<&TomlValue>.none(), move problem)
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let input = match move run Effect.result(logical(table)) {
    Result<ProfileInput, InvalidProfile | OutOfMemoryError>.Success { value } => move value
    Result<ProfileInput, InvalidProfile | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProfile problem => run located(prefix, Option<&TomlValue>.some(table), move problem)
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let maxMemory = match move run Effect.result(memoryLimit(table, &input)) {
    Result<Option<usize>, InvalidProfile | OutOfMemoryError>.Success { value } => move value
    Result<Option<usize>, InvalidProfile | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProfile problem => run located(prefix, Option<&TomlValue>.some(table), move problem)
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  return Profile { input: move input, bindings: move own, maxMemory: move maxMemory }
}

// The `maxMemory` field: a whole number of bytes, or of `KiB`, `MiB` or `GiB`, that is a positive
// multiple of the 64 KiB wasm page and at most the 4 GiB a wasm32 address reaches. Only wasm32
// links a memory limit, so another target refuses it.
effect fn memoryLimit(table: &TomlValue, input: &ProfileInput) -> Option<usize>
  ! InvalidProfile | OutOfMemoryError
  ? &mut Allocator {
  let field = run optionalText(table, "maxMemory", b"maxMemory")
  if let Option<Bytes>.None = &field {
    return Option<usize>.none()
  }
  let written = match move field {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => run invalid(b"maxMemory")
  }
  let mut wasm = false
  if let Option<Bytes>.Some { value: target } = &input.target {
    wasm = same(Bytes.asSlice(&target), b"wasm32-unknown-unknown")
  }
  if !wasm {
    return run refuse(Code.UnsupportedCombination, b"maxMemory")
  }
  let spelled = Bytes.asSlice(&written)
  let mut digits = spelled.length
  let mut scale = usize.ONE
  if spelled.length > usize.add(0, 3) {
    let unit = Slice.view<u8>(spelled, spelled.length - usize.add(0, 3), usize.add(0, 3))
    if same(unit, b"KiB") { scale = usize.add(0, 1024) }
    if same(unit, b"MiB") { scale = usize.add(0, 1048576) }
    if same(unit, b"GiB") { scale = usize.add(0, 1073741824) }
    if scale != usize.ONE { digits = spelled.length - usize.add(0, 3) }
  }
  let limit = usize.add(0, 4294967296)
  if digits == usize.ZERO || digits > usize.add(0, 10) {
    return run invalid(b"maxMemory")
  }
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < digits {
    let digit = spelled[at]
    if digit < 48 || digit > 57 {
      return run invalid(b"maxMemory")
    }
    count = count * 10 + u8.toUsize(digit - 48)
    at = at + usize.ONE
  }
  if count == usize.ZERO || count > limit / scale {
    return run invalid(b"maxMemory")
  }
  let bytes = count * scale
  if bytes % usize.add(0, 65536) != usize.ZERO {
    return run invalid(b"maxMemory")
  }
  return Option<usize>.some(bytes)
}

/// The profile `[profiles.<name>]` declares, with the project bindings before its own, as the
/// TypeScript `ProjectProfile.select` orders them; an unknown name refuses `unknown profile <name>`.
pub effect fn select(document: &TomlValue, name: &[u8]) -> Profile
  ! InvalidProfile | OutOfMemoryError
  ? &mut Allocator {
  let mut supplied = run projectBindings(document)
  if let Option<&TomlValue>.Some { value: profiles } = move Toml.field(document, "profiles") {
    let mut at = usize.ZERO
    while at < keyCount(profiles) {
      if let Option<&TomlChild>.Some { value: child } = move memberAt(profiles, at) {
        if let Option<&[u8]>.Some { value: key } = move memberKey(child) {
          if same(key, name) {
            if let Option<&TomlValue>.Some { value: table } = move memberValue(child) {
              let mut prefix = run Bytes.copy(b"profiles.")
              run Bytes.append(&mut prefix, name)
              let Profile { input, bindings: own, maxMemory } = move run decode(Bytes.asSlice(&prefix), table)
              let mut remaining = move own
              while List<Supplied>.length(&remaining) > usize.ZERO {
                run List<Supplied>.append(&mut supplied, List<Supplied>.remove(&mut remaining, usize.ZERO))
              }
              return Profile { input: move input, bindings: move supplied, maxMemory: move maxMemory }
            }
          }
        }
      }
      at = at + usize.ONE
    }
  }
  let mut subject = run Bytes.copy(b"unknown profile ")
  run Bytes.append(&mut subject, name)
  run Bytes.append(&mut subject, b": the manifest has no [profiles.")
  run Bytes.append(&mut subject, name)
  run Bytes.append(&mut subject, b"] table")
  fail InvalidProfile { code: Code.InvalidInput, subject: move subject, key: Bytes.make() }
}

// Rebuilds a JSON value as the TOML value the decoders read. Objects become tables and arrays stay
// arrays. No profile or binding field takes a JSON number or null, so both become a float holding
// their lexeme, a kind every decoder refuses under the field's own subject, as the TypeScript
// decoders refuse them.
effect fn fromJson(value: &JsonValue, depth: usize) -> TomlValue
  ! InvalidProfile | OutOfMemoryError
  ? &mut Allocator {
  if depth > maximumDepth() {
    return run invalid(b"profile")
  }
  return match &value.* {
    JsonValue.Null => TomlValue.Float { text: run String.copy("null") }
    JsonValue.Bool { value: flag } => TomlValue.Boolean { value: flag }
    JsonValue.Number { text } => TomlValue.Float { text: run String.copy(String.view(&text)) }
    JsonValue.String { text } => TomlValue.String { text: run String.copy(String.view(&text)) }
    JsonValue.Array { values } => {
      let boxed = Box<List<JsonChild>>.get(&values)
      let children = List<JsonChild>.asSlice(&boxed[0])
      let mut items = List<TomlChild>.make()
      let mut at = usize.ZERO
      while at < children.length {
        if let JsonChild.Item { value: element } = &children[at] {
          let converted = run fromJson(&element, depth + usize.ONE)
          run List<TomlChild>.append(&mut items, TomlChild.Item { value: move converted })
        }
        at = at + usize.ONE
      }
      return TomlValue.Array { values: run Box<List<TomlChild>>.make(move items), tables: false }
    }
    JsonValue.Object { entries } => {
      let boxed = Box<List<JsonChild>>.get(&entries)
      let children = List<JsonChild>.asSlice(&boxed[0])
      let mut members = List<TomlChild>.make()
      let mut at = usize.ZERO
      while at < children.length {
        if let JsonChild.Member { entry } = &children[at] {
          let converted = run fromJson(&entry.value, depth + usize.ONE)
          run List<TomlChild>.append(&mut members, TomlChild.Member {
            entry: TomlEntry { key: run String.copy(String.view(&entry.key)), value: move converted },
          })
        }
        at = at + usize.ONE
      }
      return TomlValue.Table { entries: run Box<List<TomlChild>>.make(move members), kind: TableKind.Inline }
    }
  }
}

/// The full profile a JSON object describes, as `--profile-input` supplies it, with the project
/// bindings before its own, as the TypeScript `ProjectProfile.select` orders an override's.
pub effect fn fromInput(document: &TomlValue, input: &JsonValue) -> Profile
  ! InvalidProfile | OutOfMemoryError
  ? &mut Allocator {
  let table = run fromJson(input, usize.ZERO)
  let Profile { input: logicalInput, bindings: own, maxMemory } = move run decode(b"--profile-input", &table)
  let mut supplied = run projectBindings(document)
  let mut remaining = move own
  while List<Supplied>.length(&remaining) > usize.ZERO {
    run List<Supplied>.append(&mut supplied, List<Supplied>.remove(&mut remaining, usize.ZERO))
  }
  return Profile { input: move logicalInput, bindings: move supplied, maxMemory: move maxMemory }
}
