//! The Linux link stubs: version scripts per architecture, stub definitions and link options.

import driver.LinuxLink
import semantic.Target {Id as TargetId, Target}
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.system.child_process { ChildProcess }
import silk.core.effect { Effect }
import silk.system.filesystem { FileError, Path }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn contains(text: &[u8], wanted: &[u8]) -> bool {
  if wanted.length > text.length { return false }
  let mut at = usize.ZERO
  while at + wanted.length <= text.length {
    if same(Slice.view<u8>(text, at, wanted.length), wanted) { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn scripts() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let unwinder = run LinuxLink.versionScript(b"libgcc_s.so.1", true)
  run Testing.expect(
    same(Bytes.asSlice(&unwinder), b"GCC_3.0 {\n  global:\n    _Unwind_GetRegionStart;\n  local:\n    *;\n};\nGCC_3.3 {\n  global:\n    _Unwind_Backtrace;\n} GCC_3.0;\n"),
    "the first version node hides every other symbol and later nodes inherit the one before"
  )
  let x86 = run LinuxLink.versionScript(b"libc.so.6", false)
  let arm = run LinuxLink.versionScript(b"libc.so.6", true)
  run Testing.expect(
    contains(Bytes.asSlice(&x86), b"GLIBC_2.2.5 {\n") && contains(Bytes.asSlice(&x86), b"    arch_prctl;\n")
      && !contains(Bytes.asSlice(&arm), b"GLIBC_2.2.5") && contains(Bytes.asSlice(&arm), b"GLIBC_2.17 {\n")
      && !contains(Bytes.asSlice(&arm), b"    arch_prctl;\n") && contains(Bytes.asSlice(&arm), b"    ___brk_addr;\n"),
    "aarch64 versions start at GLIBC_2.17 and each architecture exports only its own symbols"
  )
  run Testing.expect(
    contains(Bytes.asSlice(&x86), b"GLIBC_2.28") && !contains(Bytes.asSlice(&x86), b"GLIBC_2.29")
      && !contains(Bytes.asSlice(&arm), b"GLIBC_2.29") && !contains(Bytes.asSlice(&x86), b"    pthread_create;\n"),
    "the libc stub stops at glibc 2.28, where threads still live in libpthread"
  )
}

effect fn stubs() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let c = run LinuxLink.stubSource(b"libc.so.6", false)
  let threads = run LinuxLink.stubSource(b"libpthread.so.0", true)
  run Testing.expect(
    contains(Bytes.asSlice(&c), b".type environ, %object\n.size environ, 8\nenviron:\n.zero 8\n")
      && contains(Bytes.asSlice(&c), b".type malloc, %function\nmalloc:\n")
      && !contains(Bytes.asSlice(&c), b"pthread_create") && contains(Bytes.asSlice(&threads), b"pthread_create:\n"),
    "a stub library defines its own functions as labels and its data objects with their sizes"
  )
}

effect fn options() -> () ! AssertionError<'static> | FileError | OutOfMemoryError ? &mut Allocator {
  let clang = run Path.make("/tools/clang")
  let mut process = run ChildProcess.request(&clang)
  run LinuxLink.configure(&mut process, b"/scratch/app", &Target.forId(TargetId.Aarch64UnknownLinuxGnu))
  run Testing.expect(
    same(ChildProcess.arguments(&process), b"-nostdlib\0-Xlinker\0--dynamic-linker=/lib/ld-linux-aarch64.so.1\0/scratch/app.silk-start.o\0-Xlinker\0--as-needed\0/scratch/app.silk-glibc-libc.so.6\0/scratch/app.silk-glibc-libpthread.so.0\0/scratch/app.silk-glibc-libm.so.6\0/scratch/app.silk-glibc-libdl.so.2\0/scratch/app.silk-glibc-libgcc_s.so.1\0-Xlinker\0--no-as-needed\0"),
    "a stubbed link starts with Silk's own entry and needs a stub library only when it is used"
  )
}

test effect fn linuxStubVersionScriptsFollowTheGlibcBaseline() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run scripts() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn linuxStubLibrariesDefineTheirOwnSymbols() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run stubs() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn linuxStubbedLinksUseSilkStartupAndStubs() -> () ! AssertionError<'static> | FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run options() |> Effect.provideMut<Allocator>(&mut allocator)
}
