//! A check server gives its memory back when the computer has less to spare than it holds.

import driver.CheckServer
import silk.core.option { Option }
import silk.system.system_info { MemoryInfo, MemoryLimit }
import silk.testing.testing { AssertionError, Testing }

// 8 GiB of physical memory with `available` bytes a new allocation can get, and no control group.
fn machine(available: u64) -> MemoryInfo {
  return MemoryInfo { total: 8589934592, free: available, available: available, limit: Option<MemoryLimit>.none() }
}

test effect fn aServerLeavesWhenTheComputerHasLessToSpareThanItHolds() -> () ! AssertionError<'static> {
  let resident: u64 = 3758096384
  run Testing.expect(!CheckServer.crowding(machine(4294967296), resident),
    "a server stays while the computer can still give a new allocation more than the server holds")
  run Testing.expect(CheckServer.crowding(machine(2147483648), resident),
    "a server leaves once the computer's available memory is less than it holds")
  // In a container the control group's limit, not the computer's free memory, is what runs out.
  let mut contained = machine(6442450944)
  contained.limit = Option<MemoryLimit>.some(MemoryLimit { bytes: 6442450944, used: 4294967296 })
  run Testing.expect(CheckServer.crowding(contained, resident),
    "a server leaves once its control group has less left under its limit than the server holds")
  return ()
}
