//! The LLVM a Silk release installs beside its compiler.
//!
//! A release keeps one multicall LLVM executable at `<prefix>/lib/silk/llvm/bin/llvm` (`llvm.exe`
//! on Windows), beside `<prefix>/bin/silkc`. It holds Clang, lld and llvm-ar, and runs the tool its
//! own file name names, so every tool Silk or Clang starts is a link to it in the same directory:
//! a symbolic link on Unix, a hard link on Windows. The archive carries no links (a ZIP cannot),
//! so the first build that uses the installation makes the missing ones.

import driver.CommandPath
import driver.InstalledCompiler
static if Intrinsic.targetOperatingSystem() == "windows" { import silk.platform.windows.host_path as WindowsHostPath }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.core.option { Option }
import silk.text.string { String }
import silk.num.usize

static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.collections.list { List }
  import silk.mem.pointer { Pointer }
  @foreign(noCapture: ("newName", "existing", "security"))
  unsafe extern "C" fn CreateHardLinkW(newName: ?[*]const u16, existing: ?[*]const u16, security: ?*mut u8) -> i32
} else static if Intrinsic.targetOperatingSystem() == "linux" || Intrinsic.targetOperatingSystem() == "darwin" {
  import silk.mem.pointer { Pointer }
  @foreign(noCapture: ("target", "path"))
  unsafe extern "C" fn symlink(target: ?[*]const u8, path: ?[*]const u8) -> i32
}

/// Every name Silk or Clang runs an LLVM tool by.
const TOOLS: [string<'static>; 7] = ["clang", "ld.lld", "ld64.lld", "wasm-ld", "lld-link", "llvm-ar", "llvm-dlltool"]

/// The LLVM installation directory a release keeps for the compiler at `executable`, an absolute
/// path: `<prefix>/lib/silk/llvm` for `<prefix>/bin/<name>`. `None` when the path has no prefix.
pub effect fn directoryBeside(executable: &[u8]) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let library = match move run InstalledCompiler.libraryBeside(executable) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => { return Option<Bytes>.none() }
  }
  // `<prefix>/lib/silk/stdlib` less `stdlib`.
  let text = Bytes.asSlice(&library)
  let mut directory = run Bytes.copy(Slice.view<u8>(text, usize.ZERO, text.length - usize.add(0, 6)))
  run Bytes.append(&mut directory, b"llvm")
  return Option<Bytes>.some(move directory)
}

/// The bundled Clang for the running compiler, with every tool link beside it: `None` when the
/// installation has no bundled LLVM, or when a missing link cannot be made.
pub effect fn clang() -> Option<Path>
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut FileSystem | &mut Allocator {
  let invoked = match move run HostInput.argument(usize.ZERO) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => { return Option<Path>.none() }
  }
  let workingDirectory = run HostInput.workingDirectory()
  let working = run CommandPath.fromHost(Bytes.asSlice(&workingDirectory))
  let searchPath = run HostInput.variableNamed("PATH")
  let executable = match &searchPath {
    Option<Bytes>.Some { value } => run InstalledCompiler.executable(&working, Bytes.asSlice(&invoked), Option<&[u8]>.some(Bytes.asSlice(&value)))
    Option<Bytes>.None => run InstalledCompiler.executable(&working, Bytes.asSlice(&invoked), Option<&[u8]>.none())
  }
  let found = match move executable {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => { return Option<Path>.none() }
  }
  let directory = match move run directoryBeside(Bytes.asSlice(&found)) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => { return Option<Path>.none() }
  }
  let mut bin = run Bytes.copy(Bytes.asSlice(&directory))
  run Bytes.append(&mut bin, b"/bin/")
  let multicall = run toolPath(Bytes.asSlice(&bin), "llvm")
  if !run CommandPath.exists(Bytes.asSlice(&multicall), false) { return Option<Path>.none() }
  let mut at = usize.ZERO
  while at < TOOLS.length {
    let tool = run toolPath(Bytes.asSlice(&bin), TOOLS[at])
    if !run CommandPath.exists(Bytes.asSlice(&tool), false) {
      if !run linkTool(Bytes.asSlice(&multicall), Bytes.asSlice(&tool)) {
        // Another build may have made it meanwhile.
        if !run CommandPath.exists(Bytes.asSlice(&tool), false) { return Option<Path>.none() }
      }
    }
    at = at + usize.ONE
  }
  let clangPath = run toolPath(Bytes.asSlice(&bin), "clang")
  return run CommandPath.pathOf(Bytes.asSlice(&clangPath))
}

// `bin` followed by the tool's file name, with `.exe` on a Windows host.
effect fn toolPath(bin: &[u8], name: string) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut path = run Bytes.copy(bin)
  run Bytes.append(&mut path, String.utf8Bytes(name))
  static if Intrinsic.targetOperatingSystem() == "windows" { run Bytes.append(&mut path, b".exe") }
  return move path
}

// Makes `tool` run the multicall executable at `multicall`, in the same directory: a relative
// symbolic link on Unix, so the installation can move, and a hard link on Windows.
static if Intrinsic.targetOperatingSystem() == "windows" {
  effect fn linkTool(multicall: &[u8], tool: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
    let existing = match move run pathWide(multicall) {
      Option<List<u16>>.Some { value } => move value
      Option<List<u16>>.None => { return false }
    }
    let created = match move run pathWide(tool) {
      Option<List<u16>>.Some { value } => move value
      Option<List<u16>>.None => { return false }
    }
    return unsafe CreateHardLinkW(Pointer.fromSlice(List<u16>.asSlice(&created)), Pointer.fromSlice(List<u16>.asSlice(&existing)), Pointer.null<u8>()) != 0
  }

  effect fn pathWide(text: &[u8]) -> Option<List<u16>> ! OutOfMemoryError ? &mut Allocator {
    let parsed = match move run CommandPath.pathOf(text) {
      Option<Path>.Some { value } => move value
      Option<Path>.None => { return Option<List<u16>>.none() }
    }
    return run WindowsHostPath.wide(&parsed)
  }
} else static if Intrinsic.targetOperatingSystem() == "linux" || Intrinsic.targetOperatingSystem() == "darwin" {
  effect fn linkTool(multicall: &[u8], tool: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
    let _beside = multicall
    let ending: [u8; 1] = [0]
    let mut target = run Bytes.copy(b"llvm")
    run Bytes.append(&mut target, &ending)
    let mut path = run Bytes.copy(tool)
    run Bytes.append(&mut path, &ending)
    return unsafe symlink(Pointer.fromSlice<u8>(Bytes.asSlice(&target)), Pointer.fromSlice<u8>(Bytes.asSlice(&path))) == 0
  }
} else {
  // A host without links, such as WASI, never has a bundled LLVM to run.
  effect fn linkTool(multicall: &[u8], tool: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
    let _beside = multicall
    let _named = tool
    return false
  }
}
