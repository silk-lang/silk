//! Toolchain versions compare and match by SemVer, installed toolchains list newest first, and a
//! command's version comes from `+<version>`, `SILK_TOOLCHAIN`, the project's pin, the default and
//! the running compiler, in that order.

import driver.CommandPath
import driver.NativeHostFiles as HostFileAccess { NativeHostFiles }
import driver.ToolchainCommand as ToolchainCommands { Context, Outcome }
import driver.ToolchainInstall as ToolchainInstall { HostFiles }
import driver.Toolchains as Toolchains { Origin, PinTarget, Selection }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.filesystem { FileError, FileSystem, Path }
import silk.list { List }
import silk.option { Option }
import silk.os_filesystem { OsFileSystem }
import silk.result { Result }
import silk.slice { Slice }
import silk.testing { AssertionError, Testing }
import silk.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn temporaryRoot() -> string<'static> {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return "/private/tmp"
  } else {
    return "/tmp"
  }
}

test effect fn toolchainVersionsCompareAndMatch() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    Toolchains.compare(b"0.1.0-dev.10+aaaa", b"0.1.0-dev.9+bbbb") > 0
      && Toolchains.compare(b"0.1.0", b"0.1.0-dev.9") > 0
      && Toolchains.compare(b"0.2.0-dev.1", b"0.1.0") > 0
      && Toolchains.compare(b"1.0.0+x", b"1.0.0+y") == 0
      && Toolchains.compare(b"0.1.0-alpha", b"0.1.0-alpha.1") < 0
      && Toolchains.compare(b"0.1.0-1", b"0.1.0-alpha") < 0,
    "versions order by SemVer precedence, ignoring build metadata"
  )
  run Testing.expect(
    Toolchains.matches(b"0.1.0-dev.6", b"0.1.0-dev.6+1aed5da1a342")
      && Toolchains.matches(b"0.1.0-dev.6+1aed5da1a342", b"0.1.0-dev.6+1aed5da1a342")
      && !Toolchains.matches(b"0.1.0-dev.6+ffff", b"0.1.0-dev.6+1aed5da1a342")
      && !Toolchains.matches(b"0.1.0-dev.6", b"0.1.0-dev.60+aa"),
    "a pin without build metadata names the release with any; a full pin names only itself"
  )
  run Testing.expect(
    Toolchains.unpinned(b"0.0.0") && Toolchains.unpinned(b"0.0.0+local")
      && !Toolchains.unpinned(b"0.0.1"),
    "0.0.0 pins nothing"
  )
}

effect fn write(root: &Path, relative: string, text: &[u8]) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let path = run Path.join(root, relative)
  run FileSystem.writeFileWithParents(&path, text)
}

effect fn selected(
  start: &Path,
  requested: Option<&[u8]>,
  environment: Option<&[u8]>,
  home: &Path,
  version: &[u8],
  origin: Origin
) -> bool
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let selection = run Toolchains.select(
    start,
    move requested,
    move environment,
    Option<&Path>.some(home),
    b"0.0.0"
  )
  return same(Bytes.asSlice(&selection.version), version) && selection.origin == origin
}

effect fn whichStatus(working: &Path, home: &Path) -> i32
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let context = Context {
    working: run Path.fromBytes(Path.rawBytes(working)),
    home: Option<Path>.some(run Path.fromBytes(Path.rawBytes(home))),
    running: run Bytes.copy(b"0.0.0"),
    runningExecutable: Option<Bytes>.none(),
    environment: Option<Bytes>.none(),
  }
  let arguments = List<Bytes>.make()
  let mut words = move arguments
  run List<Bytes>.append(&mut words, run Bytes.copy(b"which"))
  let mut host = NativeHostFiles.at(temporaryRoot())
  let ran = run ToolchainCommands.execute(&context, List<Bytes>.asSlice(&words))
    |> Effect.provideMut<HostFiles>(&mut host)
  return ran.status
}

fn endsWith(text: &[u8], suffix: &[u8]) -> bool {
  return text.length >= suffix.length
    && same(Slice.view<u8>(text, text.length - suffix.length, suffix.length), suffix)
}

// The file the link at `link`, below the temporary root, resolves to; empty when it resolves to
// nothing.
effect fn linkedTo(link: &Path) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut host = run Bytes.copy(temporaryRoot())
  run Bytes.append(&mut host, Path.rawBytes(link))
  return match move run CommandPath.canonical(Bytes.asSlice(&host)) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => Bytes.make()
  }
}

// Runs `silk toolchain default <version>` with `home`, and returns the exit status.
effect fn makeDefault(working: &Path, home: &Path, version: &[u8]) -> i32
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let context = Context {
    working: run Path.fromBytes(Path.rawBytes(working)),
    home: Option<Path>.some(run Path.fromBytes(Path.rawBytes(home))),
    running: run Bytes.copy(b"0.0.0"),
    runningExecutable: Option<Bytes>.none(),
    environment: Option<Bytes>.none(),
  }
  let mut words = List<Bytes>.make()
  run List<Bytes>.append(&mut words, run Bytes.copy(b"default"))
  run List<Bytes>.append(&mut words, run Bytes.copy(version))
  let mut host = NativeHostFiles.at(temporaryRoot())
  let ran = run ToolchainCommands.execute(&context, List<Bytes>.asSlice(&words))
    |> Effect.provideMut<HostFiles>(&mut host)
  return ran.status
}

effect fn defaults(root: &Path) -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  run write(root, "linked/toolchains/0.2.0+old/bin/silk", b"old")
  run write(root, "linked/toolchains/0.3.0+new/bin/silk", b"new")
  let home = run Path.join(root, "linked")
  let first = run makeDefault(root, &home, b"0.2.0")
  let link = run Path.join(root, "linked/bin/silk")
  let before = run linkedTo(&link)
  let second = run makeDefault(root, &home, b"0.3.0+new")
  let after = run linkedTo(&link)
  let third = run makeDefault(root, &home, b"0.9.0")
  let kept = run linkedTo(&link)
  run Testing.expect(
    first == 0 && second == 0 && third == 0 && endsWith(Bytes.asSlice(&before), b"/toolchains/0.2.0+old/bin/silk")
      && endsWith(Bytes.asSlice(&after), b"/toolchains/0.3.0+new/bin/silk")
      && endsWith(Bytes.asSlice(&kept), b"/toolchains/0.3.0+new/bin/silk"),
    "`default` points bin/silk at an installed default, and leaves it when the default is not installed"
  )
}

effect fn selections(root: &Path) -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let home = run Path.join(root, "home")
  run write(&home, "toolchains/0.1.0-dev.4+892d3bee6c53/bin/silk", b"")
  run write(&home, "toolchains/0.1.0-dev.10+aaaaaaaaaaaa/bin/silk", b"")
  run write(&home, "toolchains/0.1.0-dev.6+1aed5da1a342/bin/silk", b"")
  run write(&home, "toolchains/.0.1.0-dev.7+partial/bin/silk", b"")
  run write(&home, "toolchains/0.1.0-dev.8+nobinary/lib/silk/stdlib/silk/option.silk", b"")
  let names = run Toolchains.installed(&home)
  let listed = List<Bytes>.asSlice(&names)
  run Testing.expect(
    listed.length == 3 && same(Bytes.asSlice(&listed[0]), b"0.1.0-dev.10+aaaaaaaaaaaa")
      && same(Bytes.asSlice(&listed[1]), b"0.1.0-dev.6+1aed5da1a342")
      && same(Bytes.asSlice(&listed[2]), b"0.1.0-dev.4+892d3bee6c53"),
    "installed toolchains list newest first, skipping partial installs and directories without bin/silk"
  )
  let found = match move run Toolchains.find(&home, b"0.1.0-dev.6") {
    Option<Bytes>.Some { value } => same(Bytes.asSlice(&value), b"0.1.0-dev.6+1aed5da1a342")
    Option<Bytes>.None => false
  }
  let absent = match move run Toolchains.find(&home, b"0.1.0-dev.5") {
    Option<Bytes>.Some { value } => false
    Option<Bytes>.None => true
  }
  run Testing.expect(found && absent, "a pin finds the installed release it names, and only that")

  run write(
    root,
    "app/silk.toml",
    b"[package]\nname = \"app\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.4\"\nroot = \"main.silk\"\n"
  )
  run write(root, "app/src/nested/keep", b"")
  run write(
    root,
    "workspace/silk.toml",
    b"[workspace]\nmembers = [\"member\", \"other\"]\nsilk-version = \"0.1.0-dev.6+1aed5da1a342\"\n",
  )
  run write(
    root,
    "workspace/member/silk.toml",
    b"[package]\nname = \"member\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.4\"\nroot = \"main.silk\"\n"
  )
  run write(root, "plain/silk.toml", b"[workspace]\nmembers = [\"inner\"]\n")
  run write(
    root,
    "plain/inner/silk.toml",
    b"[package]\nname = \"inner\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.4\"\nroot = \"main.silk\"\n"
  )
  run write(
    root,
    "workspace/other/silk.toml",
    b"[package]\nname = \"other\"\nversion = \"0.1.0\"\nsilk-version = \"0.0.0\"\nroot = \"main.silk\"\n"
  )
  run write(
    root,
    "workspace/loose/silk.toml",
    b"[package]\nname = \"loose\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.4\"\nroot = \"main.silk\"\n"
  )
  run write(
    root,
    "unpinned/silk.toml",
    b"[package]\nname = \"unpinned\"\nversion = \"0.1.0\"\nsilk-version = \"0.0.0\"\nroot = \"main.silk\"\n"
  )
  let app = run Path.join(root, "app/src/nested")
  let member = run Path.join(root, "workspace/member")
  let loose = run Path.join(root, "workspace/loose")
  let unpinned = run Path.join(root, "unpinned")
  run Testing.expect(
    run selected(
      &app,
      Option<&[u8]>.none(),
      Option<&[u8]>.none(),
      &home,
      b"0.1.0-dev.4",
      Origin.Package
    ),
    "the nearest manifest's package pin applies below it"
  )
  run Testing.expect(
    run selected(
      &member,
      Option<&[u8]>.none(),
      Option<&[u8]>.none(),
      &home,
      b"0.1.0-dev.6+1aed5da1a342",
      Origin.Workspace
    ),
    "a workspace pin wins over its member's own pin"
  )
  run Testing.expect(
    run selected(
      &loose,
      Option<&[u8]>.none(),
      Option<&[u8]>.none(),
      &home,
      b"0.1.0-dev.4",
      Origin.Package
    ),
    "a workspace pin does not cover a package it does not list"
  )
  run Testing.expect(
    run selected(
      &unpinned,
      Option<&[u8]>.none(),
      Option<&[u8]>.none(),
      &home,
      b"0.0.0",
      Origin.Running
    ),
    "a 0.0.0 pin and no default leave the running compiler"
  )
  let environment = run selected(
    &app,
    Option<&[u8]>.none(),
    Option<&[u8]>.some(b"0.1.0-dev.10"),
    &home,
    b"0.1.0-dev.10",
    Origin.Environment
  )
  let commandLine = run selected(
    &app,
    Option<&[u8]>.some(b"0.1.0-dev.6"),
    Option<&[u8]>.some(b"0.1.0-dev.10"),
    &home,
    b"0.1.0-dev.6",
    Origin.CommandLine
  )
  run Testing.expect(
    environment && commandLine,
    "SILK_TOOLCHAIN overrides the pin, and +<version> overrides both"
  )
  let kept = run selected(
    &app,
    Option<&[u8]>.none(),
    Option<&[u8]>.some(b"local"),
    &home,
    b"0.0.0",
    Origin.Environment
  )
  run Testing.expect(kept, "SILK_TOOLCHAIN=local selects the running compiler over the pin")
  run Toolchains.setDefault(&home, b"0.1.0-dev.10")
  let outside = run selected(
    &unpinned,
    Option<&[u8]>.none(),
    Option<&[u8]>.none(),
    &home,
    b"0.1.0-dev.10",
    Origin.Default
  )
  let inside = run selected(
    &app,
    Option<&[u8]>.none(),
    Option<&[u8]>.none(),
    &home,
    b"0.1.0-dev.4",
    Origin.Package
  )
  run Testing.expect(outside && inside, "the default applies outside pinned projects only")
  let installedStatus = run whichStatus(&app, &home)
  run Testing.expect(
    installedStatus == 0,
    "`which` succeeds when the pinned toolchain is installed"
  )
  run write(
    root,
    "missing/silk.toml",
    b"[package]\nname = \"missing\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.5\"\nroot = \"main.silk\"\n"
  )
  let missing = run Path.join(root, "missing")
  let missingStatus = run whichStatus(&missing, &home)
  run Testing.expect(
    missingStatus == ToolchainCommands.NOT_INSTALLED,
    "`which` exits 3 when the pinned toolchain is missing"
  )
  let memberTarget = match move run Toolchains.pinTarget(&loose) {
    Option<PinTarget>.Some { value } => same(value.table, b"package")
    Option<PinTarget>.None => false
  }
  let workspaceTarget = match move run Toolchains.pinTarget(&member) {
    Option<PinTarget>.Some { value } => same(value.table, b"workspace")
      && match &value.previous {
        Option<Bytes>.Some { value: previous } => same(Bytes.asSlice(&previous), b"0.1.0-dev.6+1aed5da1a342")
        Option<Bytes>.None => false
      }
    Option<PinTarget>.None => false
  }
  let packageTarget = match move run Toolchains.pinTarget(&app) {
    Option<PinTarget>.Some { value } => same(value.table, b"package")
    Option<PinTarget>.None => false
  }
  run Testing.expect(
    memberTarget && workspaceTarget && packageTarget,
    "`use` pins the workspace that lists a package, and a package outside one pins itself"
  )
  let inner = run Path.join(root, "plain/inner")
  let innerTarget = match move run Toolchains.pinTarget(&inner) {
    Option<PinTarget>.Some { value } => same(value.table, b"workspace")
      && match &value.previous {
        Option<Bytes>.Some { value: previous } => same(Bytes.asSlice(&previous), b"0.1.0-dev.4")
        Option<Bytes>.None => false
      }
    Option<PinTarget>.None => false
  }
  run Testing.expect(innerTarget, "`use` in a pinned member of an unpinned workspace pins the workspace")
  let workspaceManifest = run Path.join(root, "workspace/silk.toml")
  let memberManifest = run Path.join(root, "workspace/member/silk.toml")
  let pins = run Toolchains.memberPins(&workspaceManifest)
  let pinned = List<Path>.asSlice(&pins)
  run Testing.expect(
    pinned.length == usize.ONE && same(Path.rawBytes(&pinned[usize.ZERO]), Path.rawBytes(&memberManifest)),
    "the members a workspace pin moves are those that pin a version of their own"
  )
}

effect fn selectionsAndDefaults(root: &Path) -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  run selections(root)
  run defaults(root)
}

effect fn isolatedSelections() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut files = run OsFileSystem.make(temporaryRoot())
  let parent = run Path.root()
  let root = run FileSystem.createTemporaryDirectory(&parent, b"silk-toolchains-")
    |> Effect.provideMut<FileSystem>(&mut files)
  let attempted = run Effect.result(selectionsAndDefaults(&root)) |> Effect.provideMut<FileSystem>(&mut files)
  let cleaned = run Effect.result(FileSystem.removeDirectoryRecursively(&root))
    |> Effect.provideMut<FileSystem>(&mut files)
  drop cleaned
  match move attempted {
    Result<(), AssertionError<'static> | FileError | OutOfMemoryError>.Success { value } => {}
    Result<(), AssertionError<'static> | FileError | OutOfMemoryError>.Failure { error } => {
      fail move error
    }
  }
}

test effect fn toolchainSelectionFollowsItsOrder() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run isolatedSelections() |> Effect.provideMut<Allocator>(&mut allocator)
}
