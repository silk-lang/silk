//! Lossless text conversion at the compilation-request boundary.

import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, FileSystem }
import silk.text.string { String, InvalidUtf8 }

/// Copies UTF-8 bytes, refusing host paths that the request's text format cannot represent.
pub effect fn copy(bytes: &[u8]) -> String
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  return match move run String.copyUtf8(bytes) {
    Result<String, InvalidUtf8>.Success { value } => move value
    Result<String, InvalidUtf8>.Failure { .. } => {
      fail FileSystem.error(FileSystem.writeFileOperation(), FileSystem.invalidPath())
    }
  }
}
