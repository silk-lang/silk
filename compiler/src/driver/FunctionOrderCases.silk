//! A function order file resolves symbols and declaration names against the build's symbol map.

import driver.FunctionOrder as FunctionOrder
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.testing.testing { AssertionError, Testing }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

test effect fn declarationNamesOrderEverySymbolOfTheDeclaration() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let map = b"silk_aa\tfunction\tapp@0.2.0:src/main.silk::Parser.next\nsilk_bb\tfunction\tapp:src/main.silk::main\nsilk_cc\tfunction\tapp:src/main.silk::Parser.next\nsilk_dd\tdrop\tapp:src/main.silk::Parser\n"
  let written = b"# startup\napp:src/main.silk::main\n\n  app@0.1.0:src/main.silk::Parser.next  \nsilk_dd\nsilk_gone\napp:src/old.silk::removed\nmemcpy\n"
  let resolved = run FunctionOrder.resolve(written, map, false) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(same(Bytes.asSlice(&resolved.order), b"silk_bb\nsilk_aa\nsilk_cc\nsilk_dd\nsilk_gone\nmemcpy\n"),
    "a declaration expands to its symbols in map order, and a symbol passes through")
  run Testing.expect(resolved.entries == 6, "blank lines and comments are not entries")
  run Testing.expect(resolved.unmatched == 3, "a stale symbol, a removed declaration and a C symbol match nothing in the map")
  let darwin = run FunctionOrder.resolve(b"app:src/main.silk::main\n", map, true) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(same(Bytes.asSlice(&darwin.order), b"_silk_bb\n"), "Darwin symbols carry Mach-O's underscore")
  return ()
}
