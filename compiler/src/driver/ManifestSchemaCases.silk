//! Adapter proof: schema verdicts retain exact TOML source locations and opaque tool policy.

import driver.ManifestSchema as ManifestSchema { Diagnostic }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.testing.testing { AssertionError, Testing }
import silk.text.string { String }
import silk.toml.scanner { TomlError }
import silk.toml.value { Toml }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + 1
  }
  return true
}

// Expected ranges come from literal fixture markers, independently of the source mapper.
fn offset(text: &[u8], marker: &[u8]) -> usize {
  let mut at: usize = 0
  while at + marker.length <= text.length {
    if same(Slice.view<u8>(text, at, marker.length), marker) {
      return at
    }
    at = at + 1
  }
  return usize.MAX
}

effect fn atMarker(text: string, marker: string) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let source = String.utf8Bytes(text)
  let expected = String.utf8Bytes(marker)
  let start = offset(source, expected)
  run Testing.expect(start != usize.MAX, "the independent expected marker exists")
  let diagnostics = run ManifestSchema.diagnose(source)
  let listed = List<Diagnostic>.asSlice(&diagnostics)
  let mut found = false
  let mut at: usize = 0
  while at < listed.length {
    if same(Bytes.asSlice(&listed[at].code), b"MANIFEST_SCHEMA") && listed[at].span.start == start
      && listed[at].span.end == start + expected.length {
      found = true
    }
    at = at + 1
  }
  run Testing.expect(
    found,
    "a schema diagnostic selects the exact offending value or containing table",
  )
}

effect fn sourceRanges() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  // A dotted assignment creates implicit tables, rather than a header scope.
  run atMarker(
    """
"package"."n\\u0061me" = 5
package.version = "0.1.0"
""",
    "5",
  )

  // Quoted dotted headers, escaped key characters and RFC 6901 escapes must not split names.
  run atMarker(
    """
[package]
name = "demo"
version = "0.1.0"
["dependencies"."a.b/~\\u0063"]
path = 7
""",
    "7",
  )

  // A quoted key containing UTF-8 and punctuation is one inline-table member, not dotted syntax.
  run atMarker(
    """
[package]
name = "demo"
version = "0.1.0"
[dependencies]
"é😀.a/~" = { path = 8 }
""",
    "8",
  )

  // Array element diagnostics must not collapse onto the entire array or its first element.
  run atMarker(
    """
[package]
name = "demo"
version = "0.1.0"
authors = ["Julia", 9]
""",
    "9",
  )

  // Array-of-table indices choose the second instance, including under a dotted header.
  run atMarker(
    """
[package]
name = "demo"
version = "0.1.0"
[[unstable.composition.retention]]
module = "main"
declaration = "first"
[[unstable.composition.retention]]
module = 6
declaration = "keep"
""",
    "6",
  )
}

effect fn missingAndSyntax() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  run atMarker(
    """
[package]
version = "0.1.0"
""",
    "[package]",
  )
  run atMarker(
    """
package = { version = "0.1.0" }
""",
    "{ version = \"0.1.0\" }",
  )
  let diagnostics = run ManifestSchema.diagnose(b"[package")
  let listed = List<Diagnostic>.asSlice(&diagnostics)
  run Testing.expect(listed.length == 1, "syntax failure is one diagnostic, not a schema verdict")
  run Testing.expect(
    same(Bytes.asSlice(&listed[0].code), b"TOML") && listed[0].span.start == 8
      && listed[0].span.end == 8,
    "syntax EOF retains the parser offset",
  )
}

effect fn numericAndOpaquePolicy() -> ()
  ! AssertionError<'static> | TomlError | OutOfMemoryError
  ? &mut Allocator {
  // Native archive strip counts must be integers, including exact TOML numeric forms.
  run atMarker(
    """
[package]
name = "demo"
[native.archive.sdk]
url = "https://example.com/sdk.tar.gz"
sha256 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
strip = 1.000000000000000000000000000000000001
""",
    "1.000000000000000000000000000000000001",
  )
  run atMarker(
    """
[package]
name = "demo"
[native.archive.sdk]
url = "https://example.com/sdk.tar.gz"
sha256 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
strip = inf
""",
    "inf",
  )
  let text = String.utf8Bytes(
    """
[package]
name = "demo"
version = "0.1.0"
[tool.any]
values = [nan, +inf, -inf, 1979-05-27, { nested = nan }]
""",
  )
  let document = run Toml.parse(text)
  let diagnostics = run ManifestSchema.validate(text, &document)
  run Testing.expect(
    List<Diagnostic>.length(&diagnostics) == 0,
    "validate reuses parsed TOML, preserves exact radix integers, and never converts opaque tool contents",
  )
  let scalar = run ManifestSchema.diagnose(
    String.utf8Bytes(
      """
tool = nan
[package]
name = "demo"
version = "0.1.0"
""",
    ),
  )
  run Testing.expect(List<Diagnostic>.length(&scalar) == 1, "tool configuration requires a table")
}

test effect fn manifestSchemaRangesFollowTomlStructure() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sourceRanges() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn manifestMissingFieldsAndSyntaxHaveStableRanges() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run missingAndSyntax() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn manifestSchemaKeepsExactNumbersAndOpaqueToolValues() -> ()
  ! AssertionError<'static> | TomlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run numericAndOpaquePolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn mentions(text: &[u8], part: &[u8]) -> bool {
  return offset(text, part) != usize.MAX
}

effect fn wording() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  // An unknown field is reported before an earlier refused value, and names the closest field.
  let typo = String.utf8Bytes(
    """
[package]
name = "demo"
version = "bad"
exprots = ["x"]
""",
  )
  let refused = run ManifestSchema.diagnose(typo)
  let listed = List<Diagnostic>.asSlice(&refused)
  run Testing.expect(listed.length == 2, "the unknown field and the refused version are both reported")
  run Testing.expect(
    listed[0].span.start == offset(typo, b"[\"x\"]")
      && listed[1].span.start == offset(typo, b"\"bad\""),
    "an unknown field comes first, ahead of a refused value written before it",
  )
  run Testing.expect(
    mentions(Bytes.asSlice(&listed[0].message), b"package.exports"),
    "the closest field is suggested by its dotted path",
  )

  // Removed [package].kind and [package].main are both rejected as unknown fields at their values.
  let removedKind = String.utf8Bytes(
    """
[package]
name = "demo"
kind = "library"
""",
  )
  let refusedKind = run ManifestSchema.diagnose(removedKind)
  let listedKind = List<Diagnostic>.asSlice(&refusedKind)
  run Testing.expect(
    listedKind.length == 1 && listedKind[0].span.start == offset(removedKind, b"\"library\""),
    "removed [package].kind is reported as an unknown field at its value",
  )

  let removedMain = String.utf8Bytes(
    """
[package]
name = "demo"
main = "main.silk"
""",
  )
  let refusedMain = run ManifestSchema.diagnose(removedMain)
  let listedMain = List<Diagnostic>.asSlice(&refusedMain)
  run Testing.expect(
    listedMain.length == 1 && listedMain[0].span.start == offset(removedMain, b"\"main.silk\""),
    "removed [package].main is reported as an unknown field at its value",
  )

  // A field already written is not suggested in place of an unknown one.
  let present = String.utf8Bytes(
    """
[package]
name = "demo"
nmae = "x"
""",
  )
  let again = run ManifestSchema.diagnose(present)
  let named = List<Diagnostic>.asSlice(&again)
  run Testing.expect(
    named.length == 1 && !mentions(Bytes.asSlice(&named[0].message), b"did you mean"),
    "a field the manifest already has is not suggested",
  )

  // Removed configuration surfaces are rejected at their containing table.
  run atMarker(
    """
[package]
name = "demo"
[profiles.fast]
optimization = "speed"
""",
    "[profiles.fast]",
  )
  run atMarker(
    """
[package]
name = "demo"
[native]
link = [{library = "ssl"}]
""",
    "[{library = \"ssl\"}]",
  )
  run atMarker(
    """
[package]
name = "demo"
[component]
wit = "wit"
""",
    "[component]",
  )
  run atMarker(
    """
[package]
name = "demo"
[pack.binary]
""",
    "[pack.binary]",
  )
  run atMarker(
    """
[package]
name = "demo"
[native.override.vendor]
path = "../vendor"
""",
    "[native.override.vendor]",
  )
}

test effect fn manifestSchemaWordsFailuresInManifestTerms() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run wording() |> Effect.provideMut<Allocator>(&mut allocator)
}

import silk.build.source { Source }
import silk.schema.schema { Schema }
import silk.schema.json { SchemaJson }
import silk.schema.issue { SchemaError }

struct ManifestCase {
  pub name: String,
  pub valid: bool,
  pub structural: Option<bool>,
  pub toml: String
}

impl Schema for ManifestCase {}

const manifestCases: &'static [u8] = Source.read("fixtures/manifest/cases.json")

effect fn boundaryCases() -> ()
  ! AssertionError<'static> | SchemaError | OutOfMemoryError
  ? &mut Allocator {
  let cases = run SchemaJson.decode<List<ManifestCase>>(manifestCases)
  let listed = cases.asSlice()
  let mut at: usize = 0
  while at < listed.length {
    let diagnostics = run ManifestSchema.diagnose(String.ownedUtf8Bytes(&listed[at].toml))
    run Testing.expect(
      (diagnostics.length() == 0) == listed[at].valid,
      "manifest boundary fixtures agree with the shared typed schema",
    )
    at = at + 1
  }
}

test effect fn manifestBoundaryFixturesUseTypedRelationshipChecks() -> ()
  ! AssertionError<'static> | SchemaError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run boundaryCases() |> Effect.provideMut<Allocator>(&mut allocator)
}
