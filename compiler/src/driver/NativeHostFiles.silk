//! POSIX `chmod` and `rename` for toolchain installs.

import driver.ToolchainInstall as ToolchainInstall { HostFiles }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.filesystem { Path }
import silk.pointer { Pointer }

unsafe extern "C" fn chmod(path: ?[*] const u8, mode: u32) -> i32 with Intrinsic .foreign (noCapture: ("path",))

unsafe extern "C" fn rename(
  oldPath: ?[*] const u8,
  newPath: ?[*] const u8
) -> i32 with Intrinsic .foreign (noCapture: ("oldPath", "newPath"))

/// Host file operations on paths below `root`, the root of the `OsFileSystem` the paths belong to.
pub struct NativeHostFiles {
  pub root: &'static [u8]
}

impl NativeHostFiles {
  // The NUL-terminated host path of `path`.
  effect fn host(self: &Self, path: &Path) -> Bytes
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = Bytes.make()
    let raw = Path.rawBytes(path)
    if !(self.root.length == 1 && self.root[0] == 47) {
      run Bytes.append(&mut text, self.root)
    }
    run Bytes.append(&mut text, raw)
    let ending: [u8; 1] = [0]
    run Bytes.append(&mut text, &ending)
    return move text
  }

  effect fn markExecutable(self: &mut Self, path: &Path) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let target = run self.host(path)
    let status = unsafe chmod(Pointer.fromSlice<u8>(Bytes.asSlice(&target)), 493)
    return status == 0
  }

  effect fn rename(self: &mut Self, from: &Path, to: &Path) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let source = run self.host(from)
    let destination = run self.host(to)
    let status = unsafe rename(
      Pointer.fromSlice<u8>(Bytes.asSlice(&source)),
      Pointer.fromSlice<u8>(Bytes.asSlice(&destination)),
    )
    return status == 0
  }
}

impl HostFiles for NativeHostFiles {
  markExecutable: NativeHostFiles.markExecutable
  rename: NativeHostFiles.rename
}
