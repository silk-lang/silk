//! Completed-pass records for test-result reuse (TEST-008): the bootstrap's `test-results-v1`
//! records beneath `<build.output-dir>/.silk-cache`, keyed by one test's execution identity.
//!
//! # Details
//!
//! A record is the ASCII text `silk-test-result-v1\nidentity:<identity>\noutcome:Passed\n`
//! followed by `integrity:<SHA-256 hex of that prefix>\n`, at most 4096 bytes, exactly as
//! `packages/cli/src/TestResult.ts` writes it. Decoding is strict: anything else, including a torn
//! write, is an invalid record and a miss, never a pass.

import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.filesystem { FileError, FileSystem, Path }
import silk.result { Result }
import silk.sha2 { Sha256 }
import silk.u8
import silk.usize

/// The largest record admitted.
pub const MAXIMUM_BYTES: usize = 4096

/// Why a lookup found no reusable pass.
pub union Miss {
  /// No record exists for the identity.
  Missing,
  /// A record exists but is not this identity's exact pass record.
  InvalidRecord,
  /// The record could not be read.
  StorageFailure { pub error: FileError },
}

/// What a lookup found.
pub union Lookup {
  /// A completed pass for exactly this execution identity.
  Hit,
  /// No reusable pass.
  Miss { pub reason: Miss },
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

/// Whether `identity` is a lowercase 64-digit hexadecimal execution identity.
pub fn validIdentity(identity: &[u8]) -> bool {
  if identity.length != 64 { return false }
  let mut at = usize.ZERO
  while at < identity.length {
    let byte = identity[at]
    if !((byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102)) { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn appendHex(output: &mut Bytes, digest: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let digits = b"0123456789abcdef"
  let mut at = usize.ZERO
  while at < digest.length {
    let pair = [digits[u8.toUsize(u8.shiftRight(digest[at], 4))], digits[u8.toUsize(u8.bitAnd(digest[at], 15))]]
    run Bytes.append(&mut output.*, &pair)
    at = at + usize.ONE
  }
  return ()
}

// The record's integrity-covered prefix for `identity`.
effect fn payload(identity: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = run Bytes.copy(b"silk-test-result-v1\nidentity:")
  run Bytes.append(&mut text, identity)
  run Bytes.append(&mut text, b"\noutcome:Passed\n")
  return move text
}

/// The canonical completed-pass record for `identity`, which must be valid.
pub effect fn encodePass(identity: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut record = run payload(identity)
  let digest = Sha256.hash(Bytes.asSlice(&record))
  run Bytes.append(&mut record, b"integrity:")
  run appendHex(&mut record, &digest)
  run Bytes.append(&mut record, b"\n")
  return move record
}

/// Whether `bytes` is exactly the completed-pass record for `identity`.
pub effect fn decodePass(identity: &[u8], bytes: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  if !validIdentity(identity) || bytes.length > MAXIMUM_BYTES { return false }
  let expected = run encodePass(identity)
  return same(bytes, Bytes.asSlice(&expected))
}

/// The record path for `identity` beneath the build `outputDirectory`:
/// `<output-dir>/.silk-cache/test-results-v1/<identity>`.
pub effect fn recordPath(outputDirectory: &Path, identity: &[u8]) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
  let mut relative = run Bytes.copy(b".silk-cache/test-results-v1/")
  run Bytes.append(&mut relative, identity)
  return run Path.joinBytes(outputDirectory, Bytes.asSlice(&relative))
}

/// Looks up a completed pass for `identity` beneath `outputDirectory`. An absent record is
/// `Missing`; a record that is not this identity's exact pass is `InvalidRecord`; a read failure is
/// `StorageFailure`. None of them is a hit.
pub effect fn lookup(outputDirectory: &Path, identity: &[u8]) -> Lookup
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if !validIdentity(identity) { return Lookup.Miss {reason: Miss.InvalidRecord} }
  let path = match move run Effect.result(recordPath(outputDirectory, identity)) {
    Result<Path, FileError | OutOfMemoryError>.Success {value} => move value
    Result<Path, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => { return Lookup.Miss {reason: Miss.StorageFailure {error: move failure}} }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let read = run Effect.result(FileSystem.readFile(&path))
  let bytes = match move read {
    Result<Bytes, FileError | OutOfMemoryError>.Success {value} => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => {
        if failure.reason.code == FileSystem.notFound().code {
          return Lookup.Miss {reason: Miss.Missing}
        }
        return Lookup.Miss {reason: Miss.StorageFailure {error: move failure}}
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  if run decodePass(identity, Bytes.asSlice(&bytes)) { return Lookup.Hit }
  return Lookup.Miss {reason: Miss.InvalidRecord}
}
