//! The direct backend's link: lays out a whole program as one WebAssembly module, without Clang
//! or `wasm-ld`.
//!
//! # Details
//! The program text is the fragments `WasmLower` emits (`WasmObject.Fragment`), back to back.
//! Their bodies are finished code, so the link only places each function, object and table slot
//! by symbol and writes each relocation a body or an object left. A symbol two fragments define
//! keeps its first definition.
//!
//! The layout matches what `wasm-ld` makes of the same program, so the stdlib's wasm support
//! modules need no second form:
//!
//! - Functions are numbered imports first, then each body in the program's order. A function
//!   whose address is taken gets a slot in table 0, from 1, so a null function pointer traps.
//! - Linear memory holds the stack first, from 16 up to 1 MiB, which `__stack_pointer` (global 0)
//!   starts at, then the data, then the heap from `__heap_base`. The frame table's objects
//!   (`WasmObject.Object.framed`) lie together between `__start_silk_frames` and
//!   `__stop_silk_frames`.
//! - The module exports `memory`, every function its fragment exports, and the entry: `_start`
//!   on WASI, `main` otherwise.
//! - A threaded module (`threading = "multi"`) imports one shared memory as `env.memory` instead.
//!   Its data is a passive segment that the start function `__wasm_init_memory` copies in once,
//!   for the first instance; later instances wait for that copy. Thread-local objects form a
//!   block of their own: the main thread's copy lies in the data, which `__tls_base` (global 1)
//!   starts at, and `__wasm_init_tls` fills a new thread's copy from a second passive segment.
//!   `__tls_size` and `__tls_align` are that block's size and alignment.

import backend.WasmObject
import backend.WasmObject {Fragment, Object, Pointer, Relocation, RelocationKind, Translated, Unsupported}
import semantic.InternIndex {InternIndex}
import backend.WasmModule
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.ownership {Copy}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.num.u64
import silk.num.u8
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

/// The main stack's size in bytes when the profile sets none: 1 MiB, the size the runtime gives
/// each new thread.
pub fn defaultStackSize() -> u64 { return 1048576 }

fn alignUp(value: u64, alignment: u64) -> u64 {
  if alignment <= 1 { return value }
  return (value + alignment - 1) / alignment * alignment
}

/// How a link lays the module out.
pub struct Options {
  /// Export `_start` as the entry instead of `main`.
  pub wasi: bool,
  /// The memory's bound in bytes, or zero for none; a threaded module's is 1 GiB without one.
  pub maxMemory: u64,
  /// The main stack's size in bytes, a multiple of 16, or zero for `defaultStackSize()`. The stack
  /// grows down from this address to zero, and the data starts here.
  pub stackSize: u64,
  /// Add a `name` section naming each function by its symbol, as `wasm-ld` does.
  pub named: bool,
  /// Share the memory between threads, as above.
  pub threaded: bool,
  /// Addresses are 64 bits wide: a 64-bit memory.
  pub wide: bool,
}

impl Copy for Options {}

/// The threaded layout's parts: the thread-local template, the main thread's block, the word the
/// start function's copy claims, and the functions the link writes.
struct Shared {
  threaded: bool,
  template: Bytes,
  mainBlock: u64,
  flag: u64,
  initMemory: usize,
}

/// What a link made: the module's bytes, and where its code comes from.
pub struct Linked {
  pub output: Bytes,
  /// The symbol of each defined body, in the module's order.
  pub symbols: List<Bytes>,
  /// Where the code comes from, by module offset: triples of the offset, the body in `symbols`
  /// and the source place, `line << 24 | column`, or zero where a body starts and no place is
  /// known yet.
  pub lines: List<u64>,
}

/// Symbols, each found by its bytes in the order they were added.
struct Names {
  names: List<Bytes>,
  lookup: InternIndex,
}

impl Names {
  fn make() -> Names { return Names {names: List<Bytes>.make(), lookup: InternIndex.make()} }

  /// The ordinal of `name`, or `usize.MAX`.
  fn find(self: &Self, name: &[u8]) -> usize {
    let mut at = InternIndex.first(&self.lookup, InternIndex.hashBytes(0, name))
    while at != usize.MAX {
      if same(Bytes.asSlice(&List<Bytes>.asSlice(&self.names)[at]), name) { return at }
      at = InternIndex.after(&self.lookup, at)
    }
    return usize.MAX
  }

  /// Adds `name`, which must not be there yet, and answers its ordinal.
  effect fn add(self: &mut Self, name: &[u8]) -> usize ! OutOfMemoryError ? &mut Allocator {
    let ordinal = List<Bytes>.length(&self.names)
    run List<Bytes>.append(&mut self.names, run Bytes.copy(name))
    run InternIndex.record(&mut self.lookup, InternIndex.hashBytes(0, name))
    return ordinal
  }
}

/// Where each symbol lies once the module is laid out.
struct Placement {
  /// Function symbols, each with its function index in `indices` and its table slot, or
  /// `usize.MAX`, in `slots`.
  functions: Names,
  indices: List<usize>,
  slots: List<usize>,
  /// The function index in each table slot from 1; slot 0 stays null.
  table: List<usize>,
  /// Weak functions nothing defines, with their signatures; a call to one reaches a stub.
  weak: Names,
  weakSignatures: List<Bytes>,
  /// The stubs called so far, as ordinals in `weak`, numbered from `firstStub`.
  stubs: List<usize>,
  firstStub: usize,
  /// Object symbols, each with its address, or its offset in the thread-local block.
  objects: Names,
  addresses: List<u64>,
  /// Objects declared weak, which resolve to zero when nothing defines them.
  weakObjects: Names,
  /// The values of the symbols the link defines.
  framesStart: u64,
  framesEnd: u64,
  dataEnd: u64,
  tlsSize: u64,
  tlsAlign: u64,
}

impl Placement {
  /// The address of `name`: an object's, a function's table slot, or a value the link defines.
  effect fn address(self: &mut Self, name: &[u8], user: &[u8]) -> u64 ! Unsupported | OutOfMemoryError ? &mut Allocator {
    let object = self.objects.find(name)
    if object != usize.MAX { return List<u64>.get(&self.addresses, object) }
    let function = self.functions.find(name)
    if function != usize.MAX {
      let existing = List<usize>.get(&self.slots, function)
      if existing != usize.MAX { return usize.toU64(existing) }
      run List<usize>.append(&mut self.table, List<usize>.get(&self.indices, function))
      let slot = List<usize>.length(&self.table)
      List<usize>.set(&mut self.slots, function, slot)
      return usize.toU64(slot)
    }
    if same(name, b"__start_silk_frames") { return self.framesStart }
    if same(name, b"__stop_silk_frames") { return self.framesEnd }
    if same(name, b"__heap_base") || same(name, b"__data_end") { return self.dataEnd }
    if same(name, b"__tls_size") { return self.tlsSize }
    if same(name, b"__tls_align") { return self.tlsAlign }
    // An undefined weak symbol is null, as a function or as an object.
    if self.weak.find(name) != usize.MAX || self.weakObjects.find(name) != usize.MAX { return 0 }
    let mut what = run Bytes.copy(b"a reference to the undefined symbol ")
    run Bytes.append(&mut what, name)
    return run WasmObject.unsupported(Bytes.asSlice(&what), user)
  }

  /// The function index a call to `name` reaches.
  effect fn callee(self: &mut Self, name: &[u8], user: &[u8]) -> usize ! Unsupported | OutOfMemoryError ? &mut Allocator {
    let function = self.functions.find(name)
    if function != usize.MAX { return List<usize>.get(&self.indices, function) }
    let weak = self.weak.find(name)
    if weak != usize.MAX {
      let count = List<usize>.length(&self.stubs)
      let mut at = usize.ZERO
      while at < count {
        if List<usize>.get(&self.stubs, at) == weak { return self.firstStub + at }
        at = at + usize.ONE
      }
      run List<usize>.append(&mut self.stubs, weak)
      return self.firstStub + count
    }
    let mut what = run Bytes.copy(b"a call to the undefined function ")
    run Bytes.append(&mut what, name)
    return run WasmObject.unsupported(Bytes.asSlice(&what), user)
  }
}

// Writes the `size` low bytes of `value` into `image` at `offset`, little end first.
fn writeLittle(image: &mut Bytes, offset: usize, value: u64, size: usize) -> () {
  let slots = Bytes.asMutSlice(&mut image.*)
  let mut byte = usize.ZERO
  while byte < size {
    slots[offset + byte] = u64.wrappingToU8(u64.shiftRight(value, usize.toU64(byte) * 8) & 255)
    byte = byte + usize.ONE
  }
  return ()
}

/// Links the program `text`, the fragments the build emitted back to back, as a WebAssembly
/// module laid out by `options`. A definition the backend refused refuses the link.
pub effect fn link(text: &[u8], options: Options) -> Linked ! Unsupported | OutOfMemoryError ? &mut Allocator {
  let wasi = options.wasi
  let named = options.named
  let threaded = options.threaded
  let wide = options.wide
  let mut maxMemory = options.maxMemory
  if threaded && maxMemory == 0 { maxMemory = 1073741824 }
  // Where the stack ends and the data starts.
  let mut stackTop = options.stackSize
  if stackTop == 0 { stackTop = defaultStackSize() }
  if threaded && wide { run WasmObject.unsupported(b"threads", b"a 64-bit memory") }
  let mut program = Fragment.make()
  run Fragment.readAll(text, &mut program)
  let refused = List<Bytes>.asSlice(&program.refused)
  if refused.length > usize.ZERO {
    fail Unsupported {detail: run Bytes.copy(Bytes.asSlice(&refused[usize.ZERO]))}
  }
  let mut placement = Placement {functions: Names.make(), indices: List<usize>.make(), slots: List<usize>.make(), table: List<usize>.make(),
    weak: Names.make(), weakSignatures: List<Bytes>.make(), stubs: List<usize>.make(), firstStub: usize.ZERO,
    objects: Names.make(), addresses: List<u64>.make(), weakObjects: Names.make(),
    framesStart: stackTop, framesEnd: stackTop, dataEnd: stackTop, tlsSize: 0, tlsAlign: 1}
  // The defined bodies, the first of each symbol's. A threaded module calls `__wasm_init_tls`,
  // which the link writes when nothing defines it.
  let functions = List<WasmObject.Function>.asSlice(&program.functions)
  let mut defined = Names.make()
  let mut bodies = List<usize>.make()
  let mut callsInitTls = false
  let mut at = usize.ZERO
  while at < functions.length {
    let symbol = Bytes.asSlice(&functions[at].body.symbol)
    if defined.find(symbol) == usize.MAX {
      drop run defined.add(symbol)
      run List<usize>.append(&mut bodies, at)
    }
    let used = List<Bytes>.asSlice(&functions[at].body.symbols)
    let mut name = usize.ZERO
    while name < used.length {
      if same(Bytes.asSlice(&used[name]), b"__wasm_init_tls") { callsInitTls = true }
      name = name + usize.ONE
    }
    at = at + usize.ONE
  }
  // Imports first: each function without a body that names a wasm import.
  let imports = List<WasmObject.Import>.asSlice(&program.imports)
  let mut listedImports = List<usize>.make()
  at = usize.ZERO
  while at < imports.length {
    let symbol = Bytes.asSlice(&imports[at].symbol)
    if defined.find(symbol) == usize.MAX && placement.functions.find(symbol) == usize.MAX {
      drop run placement.functions.add(symbol)
      run List<usize>.append(&mut placement.indices, List<usize>.length(&listedImports))
      run List<usize>.append(&mut placement.slots, usize.MAX)
      run List<usize>.append(&mut listedImports, at)
    }
    at = at + usize.ONE
  }
  let importCount = List<usize>.length(&listedImports)
  let listed = List<usize>.asSlice(&bodies)
  at = usize.ZERO
  while at < listed.length {
    drop run placement.functions.add(Bytes.asSlice(&functions[listed[at]].body.symbol))
    run List<usize>.append(&mut placement.indices, importCount + at)
    run List<usize>.append(&mut placement.slots, usize.MAX)
    at = at + usize.ONE
  }
  // A threaded module's own functions follow the bodies: `__wasm_init_tls`, when the code calls
  // it, then the start function.
  let mut written = importCount + listed.length
  let mut initTls = usize.MAX
  let mut initMemory = usize.MAX
  if threaded {
    if callsInitTls && placement.functions.find(b"__wasm_init_tls") == usize.MAX {
      drop run placement.functions.add(b"__wasm_init_tls")
      run List<usize>.append(&mut placement.indices, written)
      run List<usize>.append(&mut placement.slots, usize.MAX)
      initTls = written
      written = written + usize.ONE
    }
    initMemory = written
    written = written + usize.ONE
  }
  placement.firstStub = written
  // Weak functions nothing defines.
  let weak = List<WasmObject.Weak>.asSlice(&program.weak)
  at = usize.ZERO
  while at < weak.length {
    let symbol = Bytes.asSlice(&weak[at].symbol)
    if placement.functions.find(symbol) == usize.MAX && placement.weak.find(symbol) == usize.MAX {
      drop run placement.weak.add(symbol)
      run List<Bytes>.append(&mut placement.weakSignatures, run Bytes.copy(Bytes.asSlice(&weak[at].signature)))
    }
    at = at + usize.ONE
  }
  let weakObjects = List<Bytes>.asSlice(&program.weakObjects)
  at = usize.ZERO
  while at < weakObjects.length {
    if placement.weakObjects.find(Bytes.asSlice(&weakObjects[at])) == usize.MAX {
      drop run placement.weakObjects.add(Bytes.asSlice(&weakObjects[at]))
    }
    at = at + usize.ONE
  }
  // The data: the frame table's entries together, then every other object, the first of each
  // symbol's. A threaded module's thread-local objects are placed in their own block, at offsets
  // from its start.
  let objects = List<Object>.asSlice(&program.objects)
  let mut placed = List<usize>.make()
  let mut cursor = stackTop
  let mut framesStart = u64.MAX
  let mut framesEnd = u64.MAX
  let mut pass = usize.ZERO
  while pass < 2 {
    at = usize.ZERO
    while at < objects.length {
      let object = &objects[at]
      let symbol = Bytes.asSlice(&object.symbol)
      let size = usize.toU64(Bytes.length(&object.image))
      let local = threaded && object.local
      if placement.objects.find(symbol) == usize.MAX {
        if local && pass == usize.ZERO {
          if object.alignment > placement.tlsAlign { placement.tlsAlign = object.alignment }
          placement.tlsSize = alignUp(placement.tlsSize, object.alignment)
          drop run placement.objects.add(symbol)
          run List<u64>.append(&mut placement.addresses, placement.tlsSize)
          run List<usize>.append(&mut placed, at)
          placement.tlsSize = placement.tlsSize + size
        } else if !local && (object.framed == (pass == usize.ZERO)) {
          cursor = alignUp(cursor, object.alignment)
          if object.framed && framesStart == u64.MAX { framesStart = cursor }
          drop run placement.objects.add(symbol)
          run List<u64>.append(&mut placement.addresses, cursor)
          run List<usize>.append(&mut placed, at)
          cursor = cursor + size
          if object.framed { framesEnd = cursor }
        }
      }
      at = at + usize.ONE
    }
    pass = pass + usize.ONE
  }
  if framesStart != u64.MAX {
    placement.framesStart = framesStart
    placement.framesEnd = framesEnd
  }
  // The main thread's thread-local block, then the start function's word, last so the data
  // segment's copy never covers it.
  let tlsSize = placement.tlsSize
  let mut mainBlock: u64 = 0
  let mut flag: u64 = 0
  if threaded {
    mainBlock = alignUp(cursor, placement.tlsAlign)
    cursor = alignUp(mainBlock + tlsSize, 4)
    flag = cursor
    cursor = cursor + 4
  }
  let dataEnd = alignUp(cursor, 16)
  placement.dataEnd = dataEnd
  // The data image, from `stackTop`, and the thread-local template, each object's pointers
  // written in.
  let mut image = run Bytes.zeroed(u64.toUsize(dataEnd - stackTop))
  let mut template = run Bytes.zeroed(u64.toUsize(tlsSize))
  let order = List<usize>.asSlice(&placed)
  let mut pointerWidth = usize.toU64(4)
  if wide { pointerWidth = 8 }
  at = usize.ZERO
  while at < order.length {
    let object = &objects[order[at]]
    let symbol = Bytes.asSlice(&object.symbol)
    let local = threaded && object.local
    let base = List<u64>.get(&placement.addresses, placement.objects.find(symbol))
    let mut offset = base
    if !local { offset = base - stackTop }
    let start = u64.toUsize(offset)
    let bytes = Bytes.asSlice(&object.image)
    let mut byte = usize.ZERO
    if local {
      let slots = Bytes.asMutSlice(&mut template)
      while byte < bytes.length {
        slots[start + byte] = bytes[byte]
        byte = byte + usize.ONE
      }
    } else {
      let slots = Bytes.asMutSlice(&mut image)
      while byte < bytes.length {
        slots[start + byte] = bytes[byte]
        byte = byte + usize.ONE
      }
    }
    let pointers = List<Pointer>.asSlice(&object.pointers)
    let mut pointer = usize.ZERO
    while pointer < pointers.length {
      let resolved = u64.wrappingAdd(run placement.address(Bytes.asSlice(&pointers[pointer].symbol), symbol), pointers[pointer].addend)
      if local { writeLittle(&mut template, start + pointers[pointer].offset, resolved, pointers[pointer].size) }
      else { writeLittle(&mut image, start + pointers[pointer].offset, resolved, pointers[pointer].size) }
      pointer = pointer + usize.ONE
    }
    at = at + usize.ONE
  }
  drop pointerWidth
  // The main thread's block starts as the template.
  if threaded {
    let slots = Bytes.asMutSlice(&mut image)
    let source = Bytes.asSlice(&template)
    let base = u64.toUsize(mainBlock - stackTop)
    let mut byte = usize.ZERO
    while byte < source.length {
      slots[base + byte] = source[byte]
      byte = byte + usize.ONE
    }
  }
  // The function types: the imports', then each body's as the code names them.
  let mut types = Types {encodings: List<Bytes>.make(), lookup: InternIndex.make()}
  let mut importTypes = List<usize>.make()
  let importOrder = List<usize>.asSlice(&listedImports)
  at = usize.ZERO
  while at < importOrder.length {
    run List<usize>.append(&mut importTypes, run types.index(Bytes.asSlice(&imports[importOrder[at]].signature)))
    at = at + usize.ONE
  }
  // The code, each relocation filled in.
  // Triples of an entry, an offset in it and a source place, turned into module offsets once the
  // code section is laid out.
  let mut rows = List<u64>.make()
  let mut entries = run List<Bytes>.makeWithCapacity(listed.length)
  let mut typeIndices = run List<usize>.makeWithCapacity(listed.length)
  let mut symbols = run List<Bytes>.makeWithCapacity(listed.length)
  at = usize.ZERO
  while at < listed.length {
    let body = &functions[listed[at]].body
    run List<usize>.append(&mut typeIndices, run types.index(Bytes.asSlice(&List<Bytes>.asSlice(&body.signatures)[body.signature])))
    // A body's code has no known place until its first location.
    run List<u64>.append(&mut rows, usize.toU64(at))
    run List<u64>.append(&mut rows, 0)
    run List<u64>.append(&mut rows, 0)
    run List<Bytes>.append(&mut entries, run relocated(body, &mut placement, &mut types, &mut rows, at))
    run List<Bytes>.append(&mut symbols, run Bytes.copy(Bytes.asSlice(&body.symbol)))
    at = at + usize.ONE
  }
  // The threaded module's own functions.
  let mut imageUsed = Bytes.length(&image)
  while imageUsed > usize.ZERO && Bytes.asSlice(&image)[imageUsed - usize.ONE] == 0 { imageUsed = imageUsed - usize.ONE }
  if initTls != usize.MAX {
    run List<usize>.append(&mut typeIndices, run types.index(&[0x60, 1, WasmModule.i32Type(), 0]))
    run List<Bytes>.append(&mut entries, run initTlsEntry(tlsSize))
  }
  if initMemory != usize.MAX {
    run List<usize>.append(&mut typeIndices, run types.index(&[0x60, 0, 0]))
    run List<Bytes>.append(&mut entries, run initMemoryEntry(flag, imageUsed, stackTop))
  }
  // A call to a weak function nothing defines calls a stub that traps, as `wasm-ld` makes it.
  let stubbed = List<usize>.asSlice(&placement.stubs)
  at = usize.ZERO
  while at < stubbed.length {
    run List<usize>.append(&mut typeIndices, run types.index(Bytes.asSlice(&List<Bytes>.asSlice(&placement.weakSignatures)[stubbed[at]])))
    run List<Bytes>.append(&mut entries, run Bytes.copy(&[0, WasmModule.opUnreachable(), WasmModule.opEnd()]))
    at = at + usize.ONE
  }
  let mut starts = List<usize>.make()
  let shared = Shared {threaded: threaded, template: move template, mainBlock: mainBlock, flag: flag, initMemory: initMemory}
  let mut importEntries = List<ImportEntry>.make()
  at = usize.ZERO
  while at < importOrder.length {
    let imported = &imports[importOrder[at]]
    run List<ImportEntry>.append(&mut importEntries, ImportEntry {module: run Bytes.copy(Bytes.asSlice(&imported.module)),
      name: run Bytes.copy(Bytes.asSlice(&imported.name)), typeIndex: List<usize>.get(&importTypes, at)})
    at = at + usize.ONE
  }
  // The exports: each body its fragment exports, and the entry.
  let mut entryName: &[u8] = b"main"
  if wasi { entryName = b"_start" }
  let mut exports = List<ExportEntry>.make()
  at = usize.ZERO
  while at < listed.length {
    let function = &functions[listed[at]]
    let mut exported = run Bytes.copy(Bytes.asSlice(&function.exported))
    if Bytes.length(&exported) == usize.ZERO && same(Bytes.asSlice(&function.body.symbol), entryName) { exported = run Bytes.copy(entryName) }
    if Bytes.length(&exported) > usize.ZERO {
      run List<ExportEntry>.append(&mut exports, ExportEntry {name: move exported, function: importCount + at})
    }
    at = at + usize.ONE
  }
  let mut output = run assemble(&placement, List<Bytes>.asSlice(&types.encodings), List<ImportEntry>.asSlice(&importEntries),
    List<ExportEntry>.asSlice(&exports), List<usize>.asSlice(&typeIndices), List<Bytes>.asSlice(&entries), &image, dataEnd, stackTop, wasi, wide,
    maxMemory, &shared, &mut starts)
  // Rows from entry offsets to module offsets, each body's from its entry's start.
  let mut lines = run List<u64>.makeWithCapacity(List<u64>.length(&rows))
  let triples = List<u64>.asSlice(&rows)
  let startOf = List<usize>.asSlice(&starts)
  let mut row = usize.ZERO
  while row < triples.length {
    let entry = u64.toUsize(triples[row])
    run List<u64>.append(&mut lines, usize.toU64(startOf[entry]) + triples[row + usize.ONE])
    run List<u64>.append(&mut lines, usize.toU64(entry))
    run List<u64>.append(&mut lines, triples[row + 2])
    row = row + 3
  }
  if named {
    // Function names, by index: the imports, the bodies, the link's own functions, then the stubs.
    let mut names = Bytes.make()
    let mut own = usize.ZERO
    if initTls != usize.MAX { own = own + usize.ONE }
    if initMemory != usize.MAX { own = own + usize.ONE }
    run WasmModule.index(&mut names, importOrder.length + listed.length + own + stubbed.length)
    let mut index = usize.ZERO
    at = usize.ZERO
    while at < importOrder.length {
      run WasmModule.index(&mut names, index)
      run WasmModule.name(&mut names, Bytes.asSlice(&imports[importOrder[at]].symbol))
      index = index + usize.ONE
      at = at + usize.ONE
    }
    let bodyNames = List<Bytes>.asSlice(&symbols)
    at = usize.ZERO
    while at < bodyNames.length {
      run WasmModule.index(&mut names, index)
      run WasmModule.name(&mut names, Bytes.asSlice(&bodyNames[at]))
      index = index + usize.ONE
      at = at + usize.ONE
    }
    if initTls != usize.MAX {
      run WasmModule.index(&mut names, index)
      run WasmModule.name(&mut names, b"__wasm_init_tls")
      index = index + usize.ONE
    }
    if initMemory != usize.MAX {
      run WasmModule.index(&mut names, index)
      run WasmModule.name(&mut names, b"__wasm_init_memory")
      index = index + usize.ONE
    }
    let weakNames = List<Bytes>.asSlice(&placement.weak.names)
    at = usize.ZERO
    while at < stubbed.length {
      run WasmModule.index(&mut names, index)
      run WasmModule.name(&mut names, Bytes.asSlice(&weakNames[stubbed[at]]))
      index = index + usize.ONE
      at = at + usize.ONE
    }
    let mut section = Bytes.make()
    run WasmModule.name(&mut section, b"name")
    run WasmModule.byte(&mut section, 1)
    run WasmModule.index(&mut section, Bytes.length(&names))
    run Bytes.append(&mut section, Bytes.asSlice(&names))
    run WasmModule.section(&mut output, 0, &section)
  }
  return Linked {output: move output, symbols: move symbols, lines: move lines}
}

/// One import of the module: a host function of type `typeIndex`.
struct ImportEntry {
  module: Bytes,
  name: Bytes,
  typeIndex: usize,
}

/// One exported function, by function index.
struct ExportEntry {
  name: Bytes,
  function: usize,
}

// The `0xFE` atomic access `code` to the `i32` at the constant address on the stack.
effect fn atomicWord(out: &mut Bytes, code: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  run WasmModule.prefixed(&mut out.*, 0xFE, code)
  run WasmModule.index(&mut out.*, 2)
  return run WasmModule.unsigned(&mut out.*, 0)
}

// `__wasm_init_tls(block)`: `__tls_base` becomes `block`, which takes a copy of the thread-local
// template, segment 1.
effect fn initTlsEntry(tlsSize: u64) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut out = Bytes.make()
  run WasmModule.index(&mut out, usize.ZERO)
  run WasmModule.localGet(&mut out, usize.ZERO)
  run WasmModule.globalSet(&mut out, usize.ONE)
  run WasmModule.localGet(&mut out, usize.ZERO)
  run WasmModule.i32Const(&mut out, 0)
  run WasmModule.i32Const(&mut out, tlsSize)
  run WasmModule.prefixed(&mut out, 0xFC, 8)
  run WasmModule.index(&mut out, usize.ONE)
  run WasmModule.byte(&mut out, 0)
  run WasmModule.op(&mut out, WasmModule.opEnd())
  return move out
}

// `__wasm_init_memory`, every instance's start function, as `wasm-ld` writes it: the instance that
// moves the word at `flag` from 0 to 1 copies the data segment's `used` bytes in, sets the word to
// 2 and wakes the others; an instance that finds 1 waits for 2. Each then drops the segment.
effect fn initMemoryEntry(flag: u64, used: usize, stackTop: u64) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut out = Bytes.make()
  run WasmModule.index(&mut out, usize.ZERO)
  run WasmModule.structured(&mut out, WasmModule.opBlock())
  run WasmModule.structured(&mut out, WasmModule.opBlock())
  run WasmModule.structured(&mut out, WasmModule.opBlock())
  run WasmModule.i32Const(&mut out, flag)
  run WasmModule.i32Const(&mut out, 0)
  run WasmModule.i32Const(&mut out, 1)
  run atomicWord(&mut out, 0x48)
  // br_table 0 1 2: 0 copies, 1 waits, 2 is done.
  run WasmModule.op(&mut out, 0x0E)
  run WasmModule.index(&mut out, 2)
  run WasmModule.index(&mut out, usize.ZERO)
  run WasmModule.index(&mut out, usize.ONE)
  run WasmModule.index(&mut out, 2)
  run WasmModule.op(&mut out, WasmModule.opEnd())
  run WasmModule.i32Const(&mut out, stackTop)
  run WasmModule.i32Const(&mut out, 0)
  run WasmModule.i32Const(&mut out, usize.toU64(used))
  run WasmModule.prefixed(&mut out, 0xFC, 8)
  run WasmModule.index(&mut out, usize.ZERO)
  run WasmModule.byte(&mut out, 0)
  run WasmModule.i32Const(&mut out, flag)
  run WasmModule.i32Const(&mut out, 2)
  run atomicWord(&mut out, 0x17)
  run WasmModule.i32Const(&mut out, flag)
  run WasmModule.i32Const(&mut out, u64.MAX)
  run atomicWord(&mut out, 0x00)
  run WasmModule.op(&mut out, WasmModule.opDrop())
  run WasmModule.op(&mut out, WasmModule.opBr())
  run WasmModule.index(&mut out, usize.ONE)
  run WasmModule.op(&mut out, WasmModule.opEnd())
  run WasmModule.i32Const(&mut out, flag)
  run WasmModule.i32Const(&mut out, 1)
  run WasmModule.i64Const(&mut out, u64.MAX)
  run atomicWord(&mut out, 0x01)
  run WasmModule.op(&mut out, WasmModule.opDrop())
  run WasmModule.op(&mut out, WasmModule.opEnd())
  run WasmModule.prefixed(&mut out, 0xFC, 9)
  run WasmModule.index(&mut out, usize.ZERO)
  run WasmModule.op(&mut out, WasmModule.opEnd())
  return move out
}

/// The interned function types: each one's encoding, `0x60`, parameters and results.
struct Types {
  encodings: List<Bytes>,
  lookup: InternIndex,
}

impl Types {
  /// The index of the function type encoded as `encoding`, interning it on first use.
  effect fn index(self: &mut Self, encoding: &[u8]) -> usize ! OutOfMemoryError ? &mut Allocator {
    let hash = InternIndex.hashBytes(0, encoding)
    let mut at = InternIndex.first(&self.lookup, hash)
    while at != usize.MAX {
      if same(Bytes.asSlice(&List<Bytes>.asSlice(&self.encodings)[at]), encoding) { return at }
      at = InternIndex.after(&self.lookup, at)
    }
    let index = List<Bytes>.length(&self.encodings)
    run List<Bytes>.append(&mut self.encodings, run Bytes.copy(encoding))
    run InternIndex.record(&mut self.lookup, hash)
    return index
  }
}

// `body`'s code entry with each relocation's immediate written in.
// Appends to `rows`, as triples of `index`, an offset in the entry and a source place, where each
// of the body's locations lands.
effect fn relocated(body: &Translated, placement: &mut Placement, types: &mut Types, rows: &mut List<u64>, index: usize) -> Bytes
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let symbol = Bytes.asSlice(&body.symbol)
  let names = List<Bytes>.asSlice(&body.symbols)
  let entry = Bytes.asSlice(&body.entry)
  let relocations = List<Relocation>.asSlice(&body.relocations)
  let mut out = run Bytes.makeWithCapacity(entry.length + relocations.length * 3)
  let locations = List<u64>.asSlice(&body.locations)
  let mut located = usize.ZERO
  let mut copied = usize.ZERO
  let mut at = usize.ZERO
  while at < relocations.length {
    let relocation = relocations[at]
    run placeRows(&mut rows.*, index, locations, &mut located, relocation.offset, Bytes.length(&out), copied)
    run Bytes.append(&mut out, Slice.view<u8>(entry, copied, relocation.offset - copied))
    copied = relocation.offset
    match relocation.kind {
      RelocationKind.Call => {
        let callee = run placement.callee(Bytes.asSlice(&names[relocation.target]), symbol)
        run WasmModule.index(&mut out, callee)
      }
      RelocationKind.Signature => {
        let signature = run types.index(Bytes.asSlice(&List<Bytes>.asSlice(&body.signatures)[relocation.target]))
        run WasmModule.index(&mut out, signature)
      }
      RelocationKind.Address => {
        let address = run placement.address(Bytes.asSlice(&names[relocation.target]), symbol)
        let mut low = u64.wrappingAdd(address, relocation.addend) & 4294967295
        if (low & 2147483648) != 0 { low = low | 18446744069414584320 }
        run WasmModule.signed(&mut out, low)
      }
      RelocationKind.WideAddress => {
        let address = run placement.address(Bytes.asSlice(&names[relocation.target]), symbol)
        run WasmModule.signed(&mut out, u64.wrappingAdd(address, relocation.addend))
      }
    }
    at = at + usize.ONE
  }
  run placeRows(&mut rows.*, index, locations, &mut located, entry.length, Bytes.length(&out), copied)
  run Bytes.append(&mut out, Slice.view<u8>(entry, copied, entry.length - copied))
  return move out
}

// Appends a row for each location from `located` up to entry offset `limit`, where the entry's
// bytes from `copied` land in the output from `written`.
effect fn placeRows(rows: &mut List<u64>, index: usize, locations: &[u64], located: &mut usize, limit: usize, written: usize, copied: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  while located.* + usize.ONE < locations.length && locations[located.*] <= usize.toU64(limit) {
    run List<u64>.append(&mut rows.*, usize.toU64(index))
    run List<u64>.append(&mut rows.*, usize.toU64(written) + locations[located.*] - usize.toU64(copied))
    run List<u64>.append(&mut rows.*, locations[located.* + usize.ONE])
    located.* = located.* + 2
  }
  return ()
}

effect fn assemble(placement: &Placement, types: &[Bytes], imports: &[ImportEntry], exported: &[ExportEntry],
  typeIndices: &[usize], entries: &[Bytes], image: &Bytes, dataEnd: u64, stackTop: u64, wasi: bool, wide: bool, maxMemory: u64, shared: &Shared,
  starts: &mut List<usize>) -> Bytes
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut out = Bytes.make()
  run WasmModule.header(&mut out)
  // Types.
  let mut section = Bytes.make()
  run WasmModule.index(&mut section, types.length)
  let mut at = usize.ZERO
  while at < types.length {
    run Bytes.append(&mut section, Bytes.asSlice(&types[at]))
    at = at + usize.ONE
  }
  run WasmModule.section(&mut out, WasmModule.typeSection(), &section)
  // Imports: the functions, then a threaded module's shared memory, bounded as a shared memory
  // must be.
  let pages = (dataEnd + 65535) / 65536
  let mut limit = maxMemory / 65536
  if limit < pages { limit = pages }
  if imports.length > usize.ZERO || shared.threaded {
    section = Bytes.make()
    let mut count = imports.length
    if shared.threaded { count = count + usize.ONE }
    run WasmModule.index(&mut section, count)
    at = usize.ZERO
    while at < imports.length {
      run WasmModule.name(&mut section, Bytes.asSlice(&imports[at].module))
      run WasmModule.name(&mut section, Bytes.asSlice(&imports[at].name))
      run WasmModule.byte(&mut section, 0)
      run WasmModule.index(&mut section, imports[at].typeIndex)
      at = at + usize.ONE
    }
    if shared.threaded {
      run WasmModule.name(&mut section, b"env")
      run WasmModule.name(&mut section, b"memory")
      run WasmModule.byte(&mut section, 2)
      run WasmModule.byte(&mut section, 3)
      run WasmModule.unsigned(&mut section, pages)
      run WasmModule.unsigned(&mut section, limit)
    }
    run WasmModule.section(&mut out, WasmModule.importSection(), &section)
  }
  // Functions.
  section = Bytes.make()
  run WasmModule.index(&mut section, entries.length)
  at = usize.ZERO
  while at < entries.length {
    run WasmModule.index(&mut section, typeIndices[at])
    at = at + usize.ONE
  }
  run WasmModule.section(&mut out, WasmModule.functionSection(), &section)
  // The table, with slot 0 null.
  let table = List<usize>.asSlice(&placement.table)
  section = Bytes.make()
  run WasmModule.index(&mut section, usize.ONE)
  run WasmModule.byte(&mut section, WasmModule.funcrefType())
  run WasmModule.byte(&mut section, 1)
  run WasmModule.index(&mut section, table.length + usize.ONE)
  run WasmModule.index(&mut section, table.length + usize.ONE)
  run WasmModule.section(&mut out, WasmModule.tableSection(), &section)
  // Memory: enough pages for the data, growing up to `maxMemory`; a 64-bit one (flag 4) when
  // addresses are.
  let mut addressFlag: u8 = 0
  if wide { addressFlag = 4 }
  if !shared.threaded {
    section = Bytes.make()
    run WasmModule.index(&mut section, usize.ONE)
    if maxMemory == 0 {
      run WasmModule.byte(&mut section, addressFlag)
      run WasmModule.unsigned(&mut section, pages)
    } else {
      run WasmModule.byte(&mut section, 1 | addressFlag)
      run WasmModule.unsigned(&mut section, pages)
      run WasmModule.unsigned(&mut section, limit)
    }
    run WasmModule.section(&mut out, WasmModule.memorySection(), &section)
  }
  // `__stack_pointer`, then a threaded module's `__tls_base`, the main thread's block.
  section = Bytes.make()
  if shared.threaded { run WasmModule.index(&mut section, 2) } else { run WasmModule.index(&mut section, usize.ONE) }
  if wide {
    run WasmModule.byte(&mut section, WasmModule.i64Type())
    run WasmModule.byte(&mut section, 1)
    run WasmModule.i64Const(&mut section, stackTop)
  } else {
    run WasmModule.byte(&mut section, WasmModule.i32Type())
    run WasmModule.byte(&mut section, 1)
    run WasmModule.i32Const(&mut section, stackTop)
  }
  run WasmModule.op(&mut section, WasmModule.opEnd())
  if shared.threaded {
    run WasmModule.byte(&mut section, WasmModule.i32Type())
    run WasmModule.byte(&mut section, 1)
    run WasmModule.i32Const(&mut section, shared.mainBlock)
    run WasmModule.op(&mut section, WasmModule.opEnd())
  }
  run WasmModule.section(&mut out, WasmModule.globalSection(), &section)
  // Exports.
  let mut exports = Bytes.make()
  let mut exportNames = List<Bytes>.make()
  if !shared.threaded {
    run WasmModule.name(&mut exports, b"memory")
    run WasmModule.byte(&mut exports, 2)
    run WasmModule.index(&mut exports, usize.ZERO)
    run List<Bytes>.append(&mut exportNames, run Bytes.copy(b"memory"))
  }
  at = usize.ZERO
  while at < exported.length {
    let name = Bytes.asSlice(&exported[at].name)
    if !listed(List<Bytes>.asSlice(&exportNames), name) {
      run WasmModule.name(&mut exports, name)
      run WasmModule.byte(&mut exports, 0)
      run WasmModule.index(&mut exports, exported[at].function)
      run List<Bytes>.append(&mut exportNames, run Bytes.copy(name))
    }
    at = at + usize.ONE
  }
  section = Bytes.make()
  run WasmModule.index(&mut section, List<Bytes>.length(&exportNames))
  run Bytes.append(&mut section, Bytes.asSlice(&exports))
  run WasmModule.section(&mut out, WasmModule.exportSection(), &section)
  if shared.threaded {
    section = Bytes.make()
    run WasmModule.index(&mut section, shared.initMemory)
    run WasmModule.section(&mut out, 8, &section)
  }
  // The table's functions, from slot 1.
  if table.length > usize.ZERO {
    section = Bytes.make()
    run WasmModule.index(&mut section, usize.ONE)
    run WasmModule.byte(&mut section, 0)
    run WasmModule.i32Const(&mut section, 1)
    run WasmModule.op(&mut section, WasmModule.opEnd())
    run WasmModule.index(&mut section, table.length)
    at = usize.ZERO
    while at < table.length {
      run WasmModule.index(&mut section, table[at])
      at = at + usize.ONE
    }
    run WasmModule.section(&mut out, WasmModule.elementSection(), &section)
  }
  // A threaded module's two passive segments, which its code names.
  if shared.threaded {
    section = Bytes.make()
    run WasmModule.index(&mut section, 2)
    run WasmModule.section(&mut out, WasmModule.dataCountSection(), &section)
  }
  // The code.
  section = Bytes.make()
  run WasmModule.index(&mut section, entries.length)
  at = usize.ZERO
  while at < entries.length {
    run WasmModule.index(&mut section, Bytes.length(&entries[at]))
    run List<usize>.append(&mut starts.*, Bytes.length(&section))
    run Bytes.append(&mut section, Bytes.asSlice(&entries[at]))
    at = at + usize.ONE
  }
  run WasmModule.section(&mut out, WasmModule.codeSection(), &section)
  // Each entry's start, from its offset in the section to its offset in the module.
  let payload = Bytes.length(&out) - Bytes.length(&section)
  let placed = List<usize>.asMutSlice(&mut starts.*)
  at = usize.ZERO
  while at < placed.length {
    placed[at] = placed[at] + payload
    at = at + usize.ONE
  }
  // The data, without its trailing zeros, which fresh memory already holds.
  let bytes = Bytes.asSlice(image)
  let mut used = bytes.length
  while used > usize.ZERO && bytes[used - usize.ONE] == 0 { used = used - usize.ONE }
  if shared.threaded {
    section = Bytes.make()
    run WasmModule.index(&mut section, 2)
    run WasmModule.byte(&mut section, 1)
    run WasmModule.index(&mut section, used)
    run Bytes.append(&mut section, Slice.view<u8>(bytes, usize.ZERO, used))
    run WasmModule.byte(&mut section, 1)
    run WasmModule.index(&mut section, Bytes.length(&shared.template))
    run Bytes.append(&mut section, Bytes.asSlice(&shared.template))
    run WasmModule.section(&mut out, WasmModule.dataSection(), &section)
  } else if used > usize.ZERO {
    section = Bytes.make()
    run WasmModule.index(&mut section, usize.ONE)
    run WasmModule.byte(&mut section, 0)
    if wide { run WasmModule.i64Const(&mut section, stackTop) } else { run WasmModule.i32Const(&mut section, stackTop) }
    run WasmModule.op(&mut section, WasmModule.opEnd())
    run WasmModule.index(&mut section, used)
    run Bytes.append(&mut section, Slice.view<u8>(bytes, usize.ZERO, used))
    run WasmModule.section(&mut out, WasmModule.dataSection(), &section)
  }
  return move out
}

fn listed(names: &[Bytes], name: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < names.length {
    if same(Bytes.asSlice(&names[at]), name) { return true }
    at = at + usize.ONE
  }
  return false
}
