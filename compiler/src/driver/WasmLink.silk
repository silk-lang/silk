//! The direct backend's link: lays out a whole program as one WebAssembly module, without Clang
//! or `wasm-ld`.
//!
//! # Details
//! Each fragment's bodies are translated alone (`WasmCode.translate`), or taken from the last
//! link's code cache when the fragment's bytes did not change (`WasmCodeCache`). The program's
//! merged declarations place every global, and the link writes each relocation a body left.
//!
//! The layout matches what `wasm-ld` makes of the same program, so the stdlib's wasm support
//! modules need no second form:
//!
//! - Functions are numbered imports first, then each body in the module's order. A function
//!   whose address is taken gets a slot in table 0, from 1, so a null function pointer traps.
//! - Linear memory holds the stack first, from 16 up to 1 MiB, which `__stack_pointer` (global 0)
//!   starts at, then the data, then the heap from `__heap_base`. The objects of section
//!   `silk_frames` lie together between `__start_silk_frames` and `__stop_silk_frames`.
//! - The module exports `memory`, every function `LlvmCode` marks `wasm-export-name`, and the
//!   entry: `_start` on WASI, `main` otherwise.

import backend.Bitcode
import backend.Bitcode {Module}
import backend.WasmCode
import backend.WasmCode {Placement, Relocation, RelocationKind, Translated, Unsupported, Value}
import driver.WasmCodeCache
import driver.WasmCodeCache {CodeCache}
import semantic.ContentHash {ContentHash}
import semantic.InternIndex {InternIndex}
import backend.WasmModule
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.num.u64
import silk.num.u8
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn startsWith(text: &[u8], prefix: &[u8]) -> bool {
  return text.length >= prefix.length && same(Slice.view<u8>(text, usize.ZERO, prefix.length), prefix)
}

/// Where the stack ends and the data starts.
fn stackTop() -> u64 { return 1048576 }

fn alignUp(value: u64, alignment: u64) -> u64 {
  if alignment <= 1 { return value }
  return (value + alignment - 1) / alignment * alignment
}

/// The string attribute `key` at the function position of global `global`'s attributes, if any.
effect fn functionAttribute(module: &Module, global: usize, key: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let list = module.globalAttributes(global)
  if list == 0 { return Bytes.make() }
  let groups = module.listGroups(list)
  let mut at = usize.ZERO
  while at < groups.length {
    if module.groupPosition(groups[at]) == Bitcode.positionFunction() {
      let found = run stringAttribute(module.groupEncoding(groups[at]), key)
      if Bytes.length(&found) > usize.ZERO { return move found }
    }
    at = at + usize.ONE
  }
  return Bytes.make()
}

// The value of string attribute `key` in a group encoding: runs of `[0, kind]`, `[1, kind,
// value]`, `[6, kind, type]`, `[3, key..., 0]` and `[4, key..., 0, value..., 0]`.
effect fn stringAttribute(encoding: &[u64], key: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < encoding.length {
    let kind = encoding[at]
    if kind == 0 {
      at = at + 2
    } else if kind == 1 || kind == 5 || kind == 6 {
      at = at + 3
    } else if kind == 3 || kind == 4 {
      let mut cursor = at + usize.ONE
      let keyStart = cursor
      while cursor < encoding.length && encoding[cursor] != 0 { cursor = cursor + usize.ONE }
      let keyEnd = cursor
      cursor = cursor + usize.ONE
      let mut value = Bytes.make()
      if kind == 4 {
        while cursor < encoding.length && encoding[cursor] != 0 {
          run Bytes.append(&mut value, &[u64.toU8(encoding[cursor])])
          cursor = cursor + usize.ONE
        }
        cursor = cursor + usize.ONE
      }
      if keyEnd - keyStart == key.length {
        let mut matches = true
        let mut index = usize.ZERO
        while index < key.length {
          if encoding[keyStart + index] != u8.toU64(key[index]) { matches = false }
          index = index + usize.ONE
        }
        if matches { return move value }
      }
      at = cursor
    } else {
      return Bytes.make()
    }
  }
  return Bytes.make()
}

/// The byte alignment of object `global`: its explicit one, or its type's.
fn objectAlignment(module: &Module, global: usize) -> u64 {
  let code = module.globalAlignment(global)
  if code == 0 { return WasmCode.alignmentOf(module, module.globalType(global)) }
  return u64.shiftLeft(1, code - 1)
}

struct Import {
  global: usize,
  module: Bytes,
  name: Bytes,
}

/// What a link made: the module's bytes, the code cache for the next link, and how many
/// fragments it translated rather than reused.
pub struct Linked {
  pub output: Bytes,
  pub cache: CodeCache,
  pub translated: usize,
  /// Where the code comes from, by module offset: triples of the offset, the body in the cache's
  /// `allBodies` and the source place, `line << 24 | column`, or zero where a body starts and no
  /// place is known yet.
  pub lines: List<u64>,
}

/// Links the program `fragments`, whose merged module is `module`, as a WebAssembly module. A
/// fragment `previous` holds is not translated again. `wasi` exports `_start` as the entry instead
/// of `main`; `maxMemory` bounds the memory in bytes, or is zero for no bound. `named` adds a
/// `name` section naming each function by its symbol, as `wasm-ld` does.
pub effect fn link(fragments: &[u8], module: &Module, previous: &CodeCache, wasi: bool, maxMemory: u64, named: bool) -> Linked
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let globals = module.globalCount()
  let mut placement = run Placement.make(globals)
  // Imports first: every function without a body that names a wasm import.
  let mut imports = List<Import>.make()
  let mut global = usize.ZERO
  while global < globals {
    if module.isFunction(global) && !module.isDefined(global) && !startsWith(module.globalName(global), b"llvm.") {
      let importModule = run functionAttribute(module, global, b"wasm-import-module")
      let importName = run functionAttribute(module, global, b"wasm-import-name")
      if Bytes.length(&importModule) > usize.ZERO && Bytes.length(&importName) > usize.ZERO {
        List<usize>.set(&mut placement.functions, global, List<Import>.length(&imports))
        run List<Import>.append(&mut imports, Import {global: global, module: move importModule, name: move importName})
      }
    }
    global = global + usize.ONE
  }
  let importCount = List<Import>.length(&imports)
  // Then each fragment's bodies, in order, translated or reused. A function two fragments define
  // keeps its first body, as the merge does.
  let mut cache = CodeCache.make()
  let mut translated = usize.ZERO
  let mut at = usize.ZERO
  while at < fragments.length {
    let end = Bitcode.fragmentEnd(fragments, at)
    let hash = ContentHash.of(Slice.view<u8>(fragments, at, end - at))
    let reused = previous.find(hash)
    run CodeCache.start(&mut cache, hash)
    if reused != usize.MAX {
      let kept = previous.bodiesOf(reused)
      let mut body = usize.ZERO
      while body < kept.length {
        run CodeCache.append(&mut cache, run WasmCodeCache.copy(&kept[body]))
        body = body + usize.ONE
      }
      at = end
    } else {
      let fragment = run Module.read(fragments, &mut at)
      let mut body = usize.ZERO
      while body < fragment.bodyCount() {
        run CodeCache.append(&mut cache, run WasmCode.translate(&fragment, body))
        body = body + usize.ONE
      }
      translated = translated + usize.ONE
    }
  }
  let bodies = cache.allBodies()
  let mut defined = List<usize>.make()
  let mut owners = List<usize>.make()
  at = usize.ZERO
  while at < bodies.length {
    let owner = module.find(Bytes.asSlice(&bodies[at].symbol))
    if owner != usize.MAX && List<usize>.get(&placement.functions, owner) == usize.MAX {
      List<usize>.set(&mut placement.functions, owner, importCount + List<usize>.length(&defined))
      run List<usize>.append(&mut defined, at)
      run List<usize>.append(&mut owners, owner)
    }
    at = at + usize.ONE
  }
  // The data: the frame table's entries together, then every other defined object.
  let mut cursor = stackTop()
  let mut framesStart = u64.MAX
  let mut framesEnd = u64.MAX
  let mut pass = usize.ZERO
  while pass < 2 {
    global = usize.ZERO
    while global < globals {
      if !module.isFunction(global) && module.isDefined(global) && !startsWith(module.globalName(global), b"llvm.") {
        let section = module.globalSection(global)
        let mut framed = false
        let mut metadata = false
        if section != 0 {
          framed = same(module.sectionName(section), b"silk_frames")
          metadata = same(module.sectionName(section), b"llvm.metadata")
        }
        if !metadata && (framed == (pass == usize.ZERO)) {
          cursor = alignUp(cursor, objectAlignment(module, global))
          if framed && framesStart == u64.MAX { framesStart = cursor }
          List<u64>.set(&mut placement.addresses, global, cursor)
          cursor = cursor + WasmCode.sizeOf(module, module.globalType(global))
          if framed { framesEnd = cursor }
        }
      }
      global = global + usize.ONE
    }
    pass = pass + usize.ONE
  }
  if framesStart == u64.MAX {
    framesStart = stackTop()
    framesEnd = stackTop()
  }
  let dataEnd = alignUp(cursor, 16)
  // The symbols the link defines, and weak objects nothing defines.
  global = usize.ZERO
  while global < globals {
    if !module.isFunction(global) && !module.isDefined(global) {
      let name = module.globalName(global)
      if same(name, b"__start_silk_frames") { List<u64>.set(&mut placement.addresses, global, framesStart) }
      else if same(name, b"__stop_silk_frames") { List<u64>.set(&mut placement.addresses, global, framesEnd) }
      else if same(name, b"__heap_base") || same(name, b"__data_end") { List<u64>.set(&mut placement.addresses, global, dataEnd) }
      else if module.globalLinkage(global) == Bitcode.linkExternWeak() { List<u64>.set(&mut placement.addresses, global, 0) }
    }
    global = global + usize.ONE
  }
  // The data image, from `stackTop()`.
  let mut image = run Bytes.zeroed(u64.toUsize(dataEnd - stackTop()))
  global = usize.ZERO
  while global < globals {
    let address = List<u64>.get(&placement.addresses, global)
    if !module.isFunction(global) && module.isDefined(global) && address != u64.MAX && address >= stackTop() {
      let initializer = module.globalInitializer(global)
      if initializer != Bitcode.none() {
        run WasmCode.writeConstant(module, initializer, module.globalType(global), &mut image, u64.toUsize(address - stackTop()), &mut placement,
          module.globalName(global))
      }
    }
    global = global + usize.ONE
  }
  // The function types: the imports', then each body's as the code names them.
  let mut types = Types {encodings: List<Bytes>.make(), lookup: InternIndex.make()}
  let mut importTypes = List<usize>.make()
  let listedImports = List<Import>.asSlice(&imports)
  at = usize.ZERO
  while at < listedImports.length {
    let importGlobal = listedImports[at].global
    let signature = run WasmCode.signatureOf(module, module.globalType(importGlobal), module.globalName(importGlobal))
    run List<usize>.append(&mut importTypes, run types.index(Bytes.asSlice(&signature)))
    at = at + usize.ONE
  }
  // The code, each relocation filled in. A call to a weak function nothing defines calls a stub
  // that traps, as `wasm-ld` makes it.
  let mut stubs = Stubs {globals: List<usize>.make(), first: importCount + List<usize>.length(&defined)}
  let listed = List<usize>.asSlice(&defined)
  // Triples of an entry, an offset in it and a source place, turned into module offsets once the
  // code section is laid out.
  let mut rows = List<u64>.make()
  let mut entries = run List<Bytes>.makeWithCapacity(listed.length)
  let mut typeIndices = run List<usize>.makeWithCapacity(listed.length)
  at = usize.ZERO
  while at < listed.length {
    let body = &bodies[listed[at]]
    run List<usize>.append(&mut typeIndices, run types.index(Bytes.asSlice(&List<Bytes>.asSlice(&body.signatures)[body.signature])))
    // A body's code has no known place until its first location.
    run List<u64>.append(&mut rows, usize.toU64(at))
    run List<u64>.append(&mut rows, 0)
    run List<u64>.append(&mut rows, 0)
    run List<Bytes>.append(&mut entries, run relocated(module, body, &mut placement, &mut types, &mut stubs, &mut rows, at))
    at = at + usize.ONE
  }
  let stubbed = List<usize>.asSlice(&stubs.globals)
  at = usize.ZERO
  while at < stubbed.length {
    let signature = run WasmCode.signatureOf(module, module.globalType(stubbed[at]), module.globalName(stubbed[at]))
    run List<usize>.append(&mut typeIndices, run types.index(Bytes.asSlice(&signature)))
    run List<Bytes>.append(&mut entries, run Bytes.copy(&[0, WasmModule.opUnreachable(), WasmModule.opEnd()]))
    at = at + usize.ONE
  }
  let mut starts = List<usize>.make()
  let mut output = run assemble(module, &placement, List<Bytes>.asSlice(&types.encodings), listedImports, List<usize>.asSlice(&importTypes),
    List<usize>.asSlice(&owners), List<usize>.asSlice(&typeIndices), List<Bytes>.asSlice(&entries), &image, dataEnd, wasi, maxMemory, &mut starts)
  // Rows from entry offsets to module offsets, each body's from its entry's start.
  let mut lines = run List<u64>.makeWithCapacity(List<u64>.length(&rows))
  let triples = List<u64>.asSlice(&rows)
  let startOf = List<usize>.asSlice(&starts)
  let mut row = usize.ZERO
  while row < triples.length {
    let entry = u64.toUsize(triples[row])
    run List<u64>.append(&mut lines, usize.toU64(startOf[entry]) + triples[row + usize.ONE])
    run List<u64>.append(&mut lines, usize.toU64(listed[entry]))
    run List<u64>.append(&mut lines, triples[row + 2])
    row = row + 3
  }
  if named {
    // Function names, by index: the imports, the bodies, then the stubs.
    let mut functions = Bytes.make()
    run WasmModule.index(&mut functions, listedImports.length + listed.length + stubbed.length)
    let mut index = usize.ZERO
    at = usize.ZERO
    while at < listedImports.length {
      run WasmModule.index(&mut functions, index)
      run WasmModule.name(&mut functions, module.globalName(listedImports[at].global))
      index = index + usize.ONE
      at = at + usize.ONE
    }
    at = usize.ZERO
    while at < listed.length {
      run WasmModule.index(&mut functions, index)
      run WasmModule.name(&mut functions, Bytes.asSlice(&bodies[listed[at]].symbol))
      index = index + usize.ONE
      at = at + usize.ONE
    }
    at = usize.ZERO
    while at < stubbed.length {
      run WasmModule.index(&mut functions, index)
      run WasmModule.name(&mut functions, module.globalName(stubbed[at]))
      index = index + usize.ONE
      at = at + usize.ONE
    }
    let mut names = Bytes.make()
    run WasmModule.name(&mut names, b"name")
    run WasmModule.byte(&mut names, 1)
    run WasmModule.index(&mut names, Bytes.length(&functions))
    run Bytes.append(&mut names, Bytes.asSlice(&functions))
    run WasmModule.section(&mut output, 0, &names)
  }
  return Linked {output: move output, cache: move cache, translated: translated, lines: move lines}
}

/// The interned function types: each one's encoding, `0x60`, parameters and results.
struct Types {
  encodings: List<Bytes>,
  lookup: InternIndex,
}

impl Types {
  /// The index of the function type encoded as `encoding`, interning it on first use.
  effect fn index(self: &mut Self, encoding: &[u8]) -> usize ! OutOfMemoryError ? &mut Allocator {
    let hash = InternIndex.hashBytes(0, encoding)
    let mut at = InternIndex.first(&self.lookup, hash)
    while at != usize.MAX {
      if same(Bytes.asSlice(&List<Bytes>.asSlice(&self.encodings)[at]), encoding) { return at }
      at = InternIndex.after(&self.lookup, at)
    }
    let index = List<Bytes>.length(&self.encodings)
    run List<Bytes>.append(&mut self.encodings, run Bytes.copy(encoding))
    run InternIndex.record(&mut self.lookup, hash)
    return index
  }
}

/// The weak functions nothing defines that the code calls, numbered from `first`.
struct Stubs {
  globals: List<usize>,
  first: usize,
}

// The function index a call to global `global` of `module` reaches.
effect fn callee(module: &Module, global: usize, placement: &mut Placement, stubs: &mut Stubs, symbol: &[u8]) -> usize
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let index = List<usize>.get(&placement.functions, global)
  if index != usize.MAX { return index }
  if module.isFunction(global) && module.globalLinkage(global) == Bitcode.linkExternWeak() {
    let stub = stubs.first + List<usize>.length(&stubs.globals)
    run List<usize>.append(&mut stubs.globals, global)
    List<usize>.set(&mut placement.functions, global, stub)
    return stub
  }
  let mut what = run Bytes.copy(b"a call to the undefined function ")
  run Bytes.append(&mut what, module.globalName(global))
  return run WasmCode.unsupported(Bytes.asSlice(&what), symbol)
}

// `body`'s code entry with each relocation's immediate written in.
// Appends to `rows`, as triples of `index`, an offset in the entry and a source place, where each
// of the body's locations lands.
effect fn relocated(module: &Module, body: &Translated, placement: &mut Placement, types: &mut Types, stubs: &mut Stubs, rows: &mut List<u64>,
  index: usize) -> Bytes
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let symbol = Bytes.asSlice(&body.symbol)
  // Each symbol's global, found once.
  let names = List<Bytes>.asSlice(&body.symbols)
  let mut targets = run List<usize>.makeWithCapacity(names.length)
  let mut at = usize.ZERO
  while at < names.length {
    let found = module.find(Bytes.asSlice(&names[at]))
    if found == usize.MAX {
      let mut what = run Bytes.copy(b"a reference to the undefined global ")
      run Bytes.append(&mut what, Bytes.asSlice(&names[at]))
      run WasmCode.unsupported(Bytes.asSlice(&what), symbol)
    }
    run List<usize>.append(&mut targets, found)
    at = at + usize.ONE
  }
  let entry = Bytes.asSlice(&body.entry)
  let relocations = List<Relocation>.asSlice(&body.relocations)
  let mut out = run Bytes.makeWithCapacity(entry.length + relocations.length * 3)
  let locations = List<u64>.asSlice(&body.locations)
  let mut located = usize.ZERO
  let mut copied = usize.ZERO
  at = usize.ZERO
  while at < relocations.length {
    let relocation = relocations[at]
    run placeRows(&mut rows.*, index, locations, &mut located, relocation.offset, Bytes.length(&out), copied)
    run Bytes.append(&mut out, Slice.view<u8>(entry, copied, relocation.offset - copied))
    copied = relocation.offset
    match relocation.kind {
      RelocationKind.Call => {
        run WasmModule.index(&mut out, run callee(module, List<usize>.get(&targets, relocation.target), &mut placement.*, &mut stubs.*, symbol))
      }
      RelocationKind.Signature => {
        run WasmModule.index(&mut out, run types.index(Bytes.asSlice(&List<Bytes>.asSlice(&body.signatures)[relocation.target])))
      }
      RelocationKind.Address => {
        let value = Value {bits: relocation.addend, global: List<usize>.get(&targets, relocation.target)}
        let mut low = run WasmCode.resolvedBits(module, value, &mut placement.*, symbol)
        if (low & 2147483648) != 0 { low = low | 18446744069414584320 }
        run WasmModule.signed(&mut out, low)
      }
      RelocationKind.WideAddress => {
        let value = Value {bits: relocation.addend, global: List<usize>.get(&targets, relocation.target)}
        run WasmModule.signed(&mut out, run WasmCode.resolvedBits(module, value, &mut placement.*, symbol))
      }
    }
    at = at + usize.ONE
  }
  run placeRows(&mut rows.*, index, locations, &mut located, entry.length, Bytes.length(&out), copied)
  run Bytes.append(&mut out, Slice.view<u8>(entry, copied, entry.length - copied))
  return move out
}

// Appends a row for each location from `located` up to entry offset `limit`, where the entry's
// bytes from `copied` land in the output from `written`.
effect fn placeRows(rows: &mut List<u64>, index: usize, locations: &[u64], located: &mut usize, limit: usize, written: usize, copied: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  while located.* + usize.ONE < locations.length && locations[located.*] <= usize.toU64(limit) {
    run List<u64>.append(&mut rows.*, usize.toU64(index))
    run List<u64>.append(&mut rows.*, usize.toU64(written) + locations[located.*] - usize.toU64(copied))
    run List<u64>.append(&mut rows.*, locations[located.* + usize.ONE])
    located.* = located.* + 2
  }
  return ()
}

effect fn assemble(module: &Module, placement: &Placement, types: &[Bytes], imports: &[Import], importTypes: &[usize], owners: &[usize],
  typeIndices: &[usize], entries: &[Bytes], image: &Bytes, dataEnd: u64, wasi: bool, maxMemory: u64, starts: &mut List<usize>) -> Bytes
! Unsupported | OutOfMemoryError ? &mut Allocator {
  let mut out = Bytes.make()
  run WasmModule.header(&mut out)
  // Types.
  let mut section = Bytes.make()
  run WasmModule.index(&mut section, types.length)
  let mut at = usize.ZERO
  while at < types.length {
    run Bytes.append(&mut section, Bytes.asSlice(&types[at]))
    at = at + usize.ONE
  }
  run WasmModule.section(&mut out, WasmModule.typeSection(), &section)
  // Imports.
  if imports.length > usize.ZERO {
    section = Bytes.make()
    run WasmModule.index(&mut section, imports.length)
    at = usize.ZERO
    while at < imports.length {
      run WasmModule.name(&mut section, Bytes.asSlice(&imports[at].module))
      run WasmModule.name(&mut section, Bytes.asSlice(&imports[at].name))
      run WasmModule.byte(&mut section, 0)
      run WasmModule.index(&mut section, importTypes[at])
      at = at + usize.ONE
    }
    run WasmModule.section(&mut out, WasmModule.importSection(), &section)
  }
  // Functions.
  section = Bytes.make()
  run WasmModule.index(&mut section, entries.length)
  at = usize.ZERO
  while at < entries.length {
    run WasmModule.index(&mut section, typeIndices[at])
    at = at + usize.ONE
  }
  run WasmModule.section(&mut out, WasmModule.functionSection(), &section)
  // The table, with slot 0 null.
  let table = List<usize>.asSlice(&placement.table)
  section = Bytes.make()
  run WasmModule.index(&mut section, usize.ONE)
  run WasmModule.byte(&mut section, WasmModule.funcrefType())
  run WasmModule.byte(&mut section, 1)
  run WasmModule.index(&mut section, table.length + usize.ONE)
  run WasmModule.index(&mut section, table.length + usize.ONE)
  run WasmModule.section(&mut out, WasmModule.tableSection(), &section)
  // Memory: enough pages for the data, growing up to `maxMemory`.
  section = Bytes.make()
  run WasmModule.index(&mut section, usize.ONE)
  let pages = (dataEnd + 65535) / 65536
  if maxMemory == 0 {
    run WasmModule.byte(&mut section, 0)
    run WasmModule.unsigned(&mut section, pages)
  } else {
    let mut limit = maxMemory / 65536
    if limit < pages { limit = pages }
    run WasmModule.byte(&mut section, 1)
    run WasmModule.unsigned(&mut section, pages)
    run WasmModule.unsigned(&mut section, limit)
  }
  run WasmModule.section(&mut out, WasmModule.memorySection(), &section)
  // `__stack_pointer`.
  section = Bytes.make()
  run WasmModule.index(&mut section, usize.ONE)
  run WasmModule.byte(&mut section, WasmModule.i32Type())
  run WasmModule.byte(&mut section, 1)
  run WasmModule.i32Const(&mut section, stackTop())
  run WasmModule.op(&mut section, WasmModule.opEnd())
  run WasmModule.section(&mut out, WasmModule.globalSection(), &section)
  // Exports.
  let mut exports = Bytes.make()
  let mut exportNames = List<Bytes>.make()
  run WasmModule.name(&mut exports, b"memory")
  run WasmModule.byte(&mut exports, 2)
  run WasmModule.index(&mut exports, usize.ZERO)
  run List<Bytes>.append(&mut exportNames, run Bytes.copy(b"memory"))
  let mut entryName: &[u8] = b"main"
  if wasi { entryName = b"_start" }
  at = usize.ZERO
  while at < owners.length {
    let global = owners[at]
    let mut exported = run functionAttribute(module, global, b"wasm-export-name")
    if Bytes.length(&exported) == usize.ZERO && same(module.globalName(global), entryName) { exported = run Bytes.copy(entryName) }
    if Bytes.length(&exported) > usize.ZERO && !listed(List<Bytes>.asSlice(&exportNames), Bytes.asSlice(&exported)) {
      run WasmModule.name(&mut exports, Bytes.asSlice(&exported))
      run WasmModule.byte(&mut exports, 0)
      run WasmModule.index(&mut exports, List<usize>.get(&placement.functions, global))
      run List<Bytes>.append(&mut exportNames, move exported)
    }
    at = at + usize.ONE
  }
  section = Bytes.make()
  run WasmModule.index(&mut section, List<Bytes>.length(&exportNames))
  run Bytes.append(&mut section, Bytes.asSlice(&exports))
  run WasmModule.section(&mut out, WasmModule.exportSection(), &section)
  // The table's functions, from slot 1.
  if table.length > usize.ZERO {
    section = Bytes.make()
    run WasmModule.index(&mut section, usize.ONE)
    run WasmModule.byte(&mut section, 0)
    run WasmModule.i32Const(&mut section, 1)
    run WasmModule.op(&mut section, WasmModule.opEnd())
    run WasmModule.index(&mut section, table.length)
    at = usize.ZERO
    while at < table.length {
      run WasmModule.index(&mut section, table[at])
      at = at + usize.ONE
    }
    run WasmModule.section(&mut out, WasmModule.elementSection(), &section)
  }
  // The code.
  section = Bytes.make()
  run WasmModule.index(&mut section, entries.length)
  at = usize.ZERO
  while at < entries.length {
    run WasmModule.index(&mut section, Bytes.length(&entries[at]))
    run List<usize>.append(&mut starts.*, Bytes.length(&section))
    run Bytes.append(&mut section, Bytes.asSlice(&entries[at]))
    at = at + usize.ONE
  }
  run WasmModule.section(&mut out, WasmModule.codeSection(), &section)
  // Each entry's start, from its offset in the section to its offset in the module.
  let payload = Bytes.length(&out) - Bytes.length(&section)
  let placed = List<usize>.asMutSlice(&mut starts.*)
  at = usize.ZERO
  while at < placed.length {
    placed[at] = placed[at] + payload
    at = at + usize.ONE
  }
  // The data, without its trailing zeros, which fresh memory already holds.
  let bytes = Bytes.asSlice(image)
  let mut used = bytes.length
  while used > usize.ZERO && bytes[used - usize.ONE] == 0 { used = used - usize.ONE }
  if used > usize.ZERO {
    section = Bytes.make()
    run WasmModule.index(&mut section, usize.ONE)
    run WasmModule.byte(&mut section, 0)
    run WasmModule.i32Const(&mut section, stackTop())
    run WasmModule.op(&mut section, WasmModule.opEnd())
    run WasmModule.index(&mut section, used)
    run Bytes.append(&mut section, Slice.view<u8>(bytes, usize.ZERO, used))
    run WasmModule.section(&mut out, WasmModule.dataSection(), &section)
  }
  return move out
}

fn listed(names: &[Bytes], name: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < names.length {
    if same(Bytes.asSlice(&names[at]), name) { return true }
    at = at + usize.ONE
  }
  return false
}
