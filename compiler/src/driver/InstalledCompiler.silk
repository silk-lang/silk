//! The running compiler's own installation: its executable and the standard library beside it.
//!
//! An installed compiler keeps its standard library at `<prefix>/lib/silk/stdlib`, beside
//! `<prefix>/bin/silkc`, so commands need no `--stdlib`. The executable is found from argument zero:
//! a path containing `/` names it relative to the working directory, and a bare name is looked up
//! in `PATH` as `execvp` would. POSIX `realpath` then resolves symbolic links, so a compiler linked
//! into another `bin` directory still finds its own library; the portable filesystem does not
//! follow symbolic links itself, so this boundary calls `realpath` directly.

import driver.CommandPath
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.filesystem { DirectoryInfo, FileError, FileInfo, FileSystem, Path }
import silk.option { Option }
import silk.pointer { Pointer }
import silk.result { Result }
import silk.slice { Slice }
import silk.usize
import silk.vector { Vector }

unsafe extern "C" fn realpath(path: ?[*] const u8, resolved: ?[*] mut u8) -> ?[*] mut u8
with Intrinsic.foreign(noCapture: ("path", "resolved"))

// At least PATH_MAX on every supported host (4096 on Linux, 1024 on macOS), so `realpath` never
// writes past the buffer.
fn resolvedCapacity() -> usize {
  return usize.add(0, 4096)
}

fn contains(value: &[u8], wanted: u8) -> bool {
  let mut at = usize.ZERO
  while at < value.length {
    if value[at] == wanted {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

/// The paths a bare command `name` may name, in `PATH` order: each entry of the colon-separated
/// `searchPath` joined with `name`, where an empty entry is the working directory (`.`).
pub effect fn searchCandidates(searchPath: &[u8], name: &[u8]) -> Vector<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut candidates = Vector<Bytes>.make()
  let mut start = usize.ZERO
  let mut at = usize.ZERO
  while at <= searchPath.length {
    if at == searchPath.length || searchPath[at] == 58 {
      let mut candidate = Bytes.make()
      if at == start {
        run Bytes.append(&mut candidate, b".")
      } else {
        run Bytes.append(&mut candidate, Slice.view<u8>(searchPath, start, at - start))
      }
      run Bytes.append(&mut candidate, b"/")
      run Bytes.append(&mut candidate, name)
      run Vector<Bytes>.append(&mut candidates, move candidate)
      start = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return move candidates
}

/// The standard library an installation keeps for the executable at `executable`, an absolute
/// path: `<prefix>/lib/silk/stdlib` for `<prefix>/bin/<name>`. `None` when the path has no prefix.
pub effect fn libraryBeside(executable: &[u8]) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  // Strip the file name, then the `bin` directory, leaving the prefix without a trailing `/`.
  let mut end = executable.length
  let mut separators = usize.ZERO
  while end > usize.ZERO && separators < usize.add(0, 2) {
    end = end - usize.ONE
    if executable[end] == 47 {
      separators = separators + usize.ONE
    }
  }
  if separators < usize.add(0, 2) {
    return Option<Bytes>.none()
  }
  let mut library = run Bytes.copy(Slice.view<u8>(executable, usize.ZERO, end))
  run Bytes.append(&mut library, b"/lib/silk/stdlib")
  return Option<Bytes>.some(move library)
}

fn isNull(answer: ?[*] mut u8) -> bool {
  unsafe {
    return Pointer.isNullMany<u8>(Intrinsic.pointerRequalify<?[*] mut u8, ?[*] const u8>(answer))
  }
}

// The canonical path of `path` with every symbolic link resolved, or `None` when the host cannot
// resolve it.
effect fn canonical(path: &[u8]) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  if contains(path, 0) {
    return Option<Bytes>.none()
  }
  let mut request = run Bytes.copy(path)
  let ending: [u8; 1] = [0]
  run Bytes.append(&mut request, &ending)
  let mut buffer = run Bytes.zeroed(resolvedCapacity())
  let answer = unsafe realpath(
    Pointer.fromSlice<u8>(Bytes.asSlice(&request)),
    Pointer.fromMutSlice<u8>(Bytes.asMutSlice(&mut buffer)),
  )
  if isNull(answer) {
    return Option<Bytes>.none()
  }
  let written = Bytes.asSlice(&buffer)
  let mut length = usize.ZERO
  while length < written.length && written[length] != 0 {
    length = length + usize.ONE
  }
  return Option<Bytes>.some(run Bytes.copy(Slice.view<u8>(written, usize.ZERO, length)))
}

// The path `text` spells, or `None` when no path can spell it.
effect fn pathOf(text: &[u8]) -> Option<Path> ! OutOfMemoryError ? &mut Allocator {
  let parsed = run Effect.result(Path.fromBytes(text))
  return match move parsed {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => Option<Path>.some(move value)
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError invalid => {
        drop invalid
        return Option<Path>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// Whether `text` names an existing directory (`directory`) or regular file; any inspection failure
// answers `false`.
effect fn exists(text: &[u8], directory: bool) -> bool ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let candidate = match move run pathOf(text) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return false
    }
  }
  let inspected = run Effect.result(FileSystem.stat(&candidate))
  return match move inspected {
    Result<FileInfo | DirectoryInfo, FileError>.Success { value } => match move value {
      FileInfo file => !directory
      DirectoryInfo found => directory
    }
    Result<FileInfo | DirectoryInfo, FileError>.Failure { error } => {
      drop error
      return false
    }
  }
}

// The running executable's path as argument zero names it, before symbolic links resolve.
effect fn named(working: &Path, argumentZero: &[u8], searchPath: Option<&[u8]>) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if contains(argumentZero, 47) {
    let resolved = run Effect.result(CommandPath.resolve(working, argumentZero))
    return match move resolved {
      Result<Path, FileError | OutOfMemoryError>.Success { value } => Option<Bytes>.some(run Bytes.copy(Path.rawBytes(&value)))
      Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
        FileError invalid => {
          drop invalid
          return Option<Bytes>.none()
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
  }
  let entries = match move searchPath {
    Option<&[u8]>.Some { value } => value
    Option<&[u8]>.None => {
      return Option<Bytes>.none()
    }
  }
  let candidates = run searchCandidates(entries, argumentZero)
  let listed = Vector<Bytes>.asSlice(&candidates)
  let mut at = usize.ZERO
  while at < listed.length {
    // A PATH entry is often a symbolic link, which the portable filesystem does not follow.
    if let Option<Bytes>.Some { value: resolved } = move run canonical(Bytes.asSlice(&listed[at])) {
      if run exists(Bytes.asSlice(&resolved), false) {
        return Option<Bytes>.some(move resolved)
      }
    }
    at = at + usize.ONE
  }
  return Option<Bytes>.none()
}

/// The standard library installed beside the running compiler, found from `argumentZero` and the
/// `PATH` value `searchPath`; `None` when the executable or an existing library directory cannot be
/// found.
pub effect fn standardLibrary(working: &Path, argumentZero: &[u8], searchPath: Option<&[u8]>) -> Option<Path>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let found = match move run named(working, argumentZero, move searchPath) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return Option<Path>.none()
    }
  }
  let executable = match move run canonical(Bytes.asSlice(&found)) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return Option<Path>.none()
    }
  }
  let library = match move run libraryBeside(Bytes.asSlice(&executable)) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return Option<Path>.none()
    }
  }
  if !run exists(Bytes.asSlice(&library), true) {
    return Option<Path>.none()
  }
  return run pathOf(Bytes.asSlice(&library))
}
