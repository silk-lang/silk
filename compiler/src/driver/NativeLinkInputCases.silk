//! Linker argument boundaries and target restrictions for explicit native inputs.

import driver.NativeLinkInput as Inputs { NativeLinkInput, InvalidNativeLinkInput }
import semantic.Target { Target, Id }
import silk.build.request { Native, NativeSource, LinkInput }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.text.string { String }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess }
import silk.system.filesystem { FileError, Path }
import silk.testing.testing { AssertionError, Testing }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

effect fn input(kind: string, value: string, weak: bool, needed: bool) -> NativeLinkInput
! FileError | InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  return run moded(kind, value, Option<String>.none(), weak, needed)
}

effect fn moded(kind: string, value: string, mode: Option<String>, weak: bool, needed: bool) -> NativeLinkInput
! FileError | InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  let mut links = List<LinkInput>.make()
  run links.append(LinkInput {kind: run String.copy(kind), value: run String.copy(value), mode: move mode, weak: weak, needed: needed})
  let native = Native {sources: List<NativeSource>.make(), link: move links, functionOrder: Option<String>.none()}
  let mut decoded = run Inputs.fromRequest(&native)
  return decoded.remove(0)
}

effect fn linux() -> () ! AssertionError<'static> | FileError | InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  let target = Target.forId(Id.X8664UnknownLinuxGnu)
  let mut command = run ChildProcess.request(&run Path.make("/clang"))
  let path = run input("rpath", "$ORIGIN/lib,one", false, false)
  let library = run input("library", "m", false, true)
  run Inputs.appendArguments(&path, &target, false, &mut command)
  run Inputs.appendArguments(&library, &target, false, &mut command)
  run Testing.expect(same(ChildProcess.arguments(&command),
    b"-Xlinker\0-rpath\0-Xlinker\0$ORIGIN/lib,one\0-Wl,--push-state,--no-as-needed\0-lm\0-Wl,--pop-state\0"),
    "runtime paths remain one argument and needed preserves the surrounding linker state")
  let weak = run input("library", "m", true, false)
  let rejected = run Effect.result(Inputs.appendArguments(&weak, &target, false, &mut command))
  let refused = match move rejected {
    Result<(), FileError | InvalidNativeLinkInput | OutOfMemoryError>.Failure {error} => match move error {
      InvalidNativeLinkInput {..} => true
      _ => false
    }
    Result<(), FileError | InvalidNativeLinkInput | OutOfMemoryError>.Success {..} => false
  }
  run Testing.expect(refused, "Linux must not silently turn a weak library into a required one")
}

effect fn darwin() -> () ! AssertionError<'static> | FileError | InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  let target = Target.forId(Id.Aarch64AppleDarwin)
  let mut command = run ChildProcess.request(&run Path.make("/clang"))
  let search = run input("framework-search-path", "/sdk frameworks", false, false)
  let weak = run input("framework", "Metal", true, false)
  let needed = run input("framework", "AppKit", false, true)
  run Inputs.appendArguments(&search, &target, false, &mut command)
  run Inputs.appendArguments(&weak, &target, false, &mut command)
  run Inputs.appendArguments(&needed, &target, false, &mut command)
  run Testing.expect(same(ChildProcess.arguments(&command),
    b"-F\0/sdk frameworks\0-Xlinker\0-weak_framework\0-Xlinker\0Metal\0-Xlinker\0-needed_framework\0-Xlinker\0AppKit\0"),
    "framework search paths and weak or needed framework names reach ld64 intact")
}

effect fn stamps() -> () ! AssertionError<'static> | FileError | InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  let mut named = List<NativeLinkInput>.make()
  run named.append(run input("framework", "Metal", false, false))
  run named.append(run input("library", "m", false, false))
  run named.append(run input("search-path", "/opt/lib", false, false))
  run named.append(run input("archive", "/store/dawn.a", false, false))
  run Testing.expect(Inputs.stampable(named.asSlice()), "named system libraries and a declared archive keep the link stamp")
  let archived = match Inputs.digested(&named.asSlice()[3]) {
    Option<&Path>.Some {value} => same(Path.rawBytes(value), b"/store/dawn.a")
    Option<&Path>.None => false
  }
  run Testing.expect(archived, "a declared archive is named by its bytes")
  run Testing.expect(Inputs.digested(&named.asSlice()[0]).isNone(), "a framework is named by the command alone")
  run named.append(run moded("library", "z", Option<String>.some(run String.copy("static")), false, false))
  run Testing.expect(!Inputs.stampable(named.asSlice()), "a static library found on a search path links every time")
}

test effect fn nativeLinkInputsKeepTheLinkStampUnlessAStaticLibraryIsSearched() -> ()
! AssertionError<'static> | FileError | InvalidNativeLinkInput | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run stamps() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn linuxNativeLinkInputsPreserveSearchPathsAndLinkerState() -> ()
! AssertionError<'static> | FileError | InvalidNativeLinkInput | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run linux() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn macosNativeLinkInputsPreserveFrameworkPolicies() -> ()
! AssertionError<'static> | FileError | InvalidNativeLinkInput | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run darwin() |> Effect.provideMut<Allocator>(&mut allocator)
}
