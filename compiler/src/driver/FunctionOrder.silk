//! The linker order a package's `[native].function-order` file asks for.
//!
//! Each listed line names a symbol, such as `silk_1f3a...`, or a declaration as the third column of
//! the build's `.symbols` map spells it, such as `app:src/main.silk::Parser.next`. A declaration
//! names every symbol the build emits for it, generic instances and drop glue included, in the
//! map's order. The package's version may be left out (`app@0.1.0:` or `app:`), so the name stays
//! the same across compiler versions and dependency bumps. A symbol is passed through as written.

import semantic.InternIndex {InternIndex}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.core.ownership {Copy}
import silk.num.usize

/// The symbols to place first, one per line, and how many listed entries named nothing.
pub struct Resolved {
  /// One symbol per line, with Mach-O's leading underscore on Darwin.
  pub order: Bytes,
  /// The entries the file lists, blank lines and `#` comments left out.
  pub entries: usize,
  /// The entries that name neither a symbol nor a declaration of this build.
  pub unmatched: usize,
}

struct Line { start: usize, length: usize }
impl Copy for Line {}

// One map row: where its symbol sits in the map text, and its declaration without a version.
struct Row { symbol: Line, declaration: Bytes }

/// Resolves the order file `written` against the build's symbol map `map` (`EmissionPlan.symbolMap`).
pub effect fn resolve(written: &[u8], map: &[u8], darwin: bool) -> Resolved ! OutOfMemoryError ? &mut Allocator {
  let mut rows = List<Row>.make()
  let mut symbols = InternIndex.make()
  let mut declarations = InternIndex.make()
  let mut start = usize.ZERO
  while start < map.length {
    let mut end = start
    while end < map.length && map[end] != 10 { end = end + usize.ONE }
    let firstTab = tabAfter(map, start, end)
    let secondTab = tabAfter(map, firstTab + usize.ONE, end)
    if secondTab < end {
      let symbol = Line {start: start, length: firstTab - start}
      let declaration = run unversioned(Slice.view<u8>(map, secondTab + usize.ONE, end - secondTab - usize.ONE))
      run InternIndex.record(&mut symbols, InternIndex.hashBytes(0, view(map, &symbol)))
      run InternIndex.record(&mut declarations, InternIndex.hashBytes(0, Bytes.asSlice(&declaration)))
      run List<Row>.append(&mut rows, Row {symbol: symbol, declaration: move declaration})
    }
    start = end + usize.ONE
  }
  let listed = List<Row>.asSlice(&rows)
  let mut order = Bytes.make()
  let mut entries = usize.ZERO
  let mut unmatched = usize.ZERO
  start = usize.ZERO
  while start < written.length {
    let mut end = start
    while end < written.length && written[end] != 10 { end = end + usize.ONE }
    let next = end + usize.ONE
    // Tab, carriage return and space.
    while start < end && (written[start] == 9 || written[start] == 13 || written[start] == 32) { start = start + usize.ONE }
    while end > start && (written[end - usize.ONE] == 9 || written[end - usize.ONE] == 13 || written[end - usize.ONE] == 32) { end = end - usize.ONE }
    if end > start && written[start] != 35 {
      entries = entries + usize.ONE
      let entry = Slice.view<u8>(written, start, end - start)
      let mut found = false
      if declarationName(entry) {
        let wanted = run unversioned(entry)
        let mut at = InternIndex.first(&declarations, InternIndex.hashBytes(0, Bytes.asSlice(&wanted)))
        while at != usize.MAX {
          if same(Bytes.asSlice(&listed[at].declaration), Bytes.asSlice(&wanted)) {
            found = true
            run appendSymbol(&mut order, view(map, &listed[at].symbol), darwin)
          }
          at = InternIndex.after(&declarations, at)
        }
      } else {
        let mut at = InternIndex.first(&symbols, InternIndex.hashBytes(0, entry))
        while at != usize.MAX && !found {
          if same(view(map, &listed[at].symbol), entry) { found = true }
          at = InternIndex.after(&symbols, at)
        }
        // A symbol outside the map, such as a C function from a link input, still orders.
        run appendSymbol(&mut order, entry, darwin)
      }
      if !found { unmatched = unmatched + usize.ONE }
    }
    start = next
  }
  return Resolved {order: move order, entries: entries, unmatched: unmatched}
}

// A declaration without the version its package segment carries: `app@0.1.0:main.silk::f` reads
// `app:main.silk::f`, so an order file keeps matching after a version bump.
effect fn unversioned(name: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < name.length && name[at] != 58 {
    if name[at] == 64 {
      let mut colon = at
      while colon < name.length && name[colon] != 58 { colon = colon + usize.ONE }
      let mut kept = run Bytes.copy(Slice.view<u8>(name, usize.ZERO, at))
      run Bytes.append(&mut kept, Slice.view<u8>(name, colon, name.length - colon))
      return move kept
    }
    at = at + usize.ONE
  }
  return run Bytes.copy(name)
}

// A declaration name holds the `::` between its file and its owner path; no symbol does.
fn declarationName(entry: &[u8]) -> bool {
  let mut at = usize.ONE
  while at < entry.length {
    if entry[at - usize.ONE] == 58 && entry[at] == 58 { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn appendSymbol(order: &mut Bytes, symbol: &[u8], darwin: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  if darwin { run Bytes.append(&mut order.*, b"_") }
  run Bytes.append(&mut order.*, symbol)
  run Bytes.append(&mut order.*, b"\n")
  return ()
}

fn tabAfter(text: &[u8], start: usize, end: usize) -> usize {
  let mut at = start
  while at < end && text[at] != 9 { at = at + usize.ONE }
  return at
}

fn view<'a>(text: &'a [u8], line: &Line) -> &'a [u8] {
  return Slice.view<u8>(text, line.start, line.length)
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}
