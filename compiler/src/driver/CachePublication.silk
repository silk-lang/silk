//! Transactions and lifetime pins for immutable semantic-cache generations.
//! A physical token is remembered even when semantic admission refuses the stored generation.
//! Stale writers never replace a different physical generation, and pins do not expire by time.

import semantic.ContentHash {ContentHash}
import semantic.CacheGeneration as Generations {Generation}
import semantic.CacheSegments as Segments {SealedSegment, Descriptor}
import semantic.CacheView as Views {View}
import semantic.InternIndex {InternIndex}
import semantic.RuntimeEncoding as Encoding
import semantic.StableKey
import lexer.Span {Span}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.mem.frozen {Frozen}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.ownership {Copy, Drop}
import silk.core.result {Result}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.pointer {Pointer}
import silk.system.filesystem {Path, FileSystem, FileError, AtomicWriteError}
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// The namespace incarnation and exact physical current-file state observed by a reader.
/// `present` distinguishes an absent file from any present packet, including a malformed one.
pub struct Token {pub incarnation: ContentHash, pub present: bool, pub physical: ContentHash}
impl Copy for Token {}

/// Whether two readers observed the same namespace and physical publication state.
pub fn sameToken(left: Token, right: Token) -> bool {
  return ContentHash.equals(left.incarnation, right.incarnation) && left.present == right.present
    && (!left.present || ContentHash.equals(left.physical, right.physical))
}

fn zero() -> ContentHash { return ContentHash {high: 0, low: 0} }
fn same(left: &[u8], right: &[u8]) -> bool { return Encoding.equals(left, right) }
effect fn wordPair(output: &mut Bytes, value: ContentHash) -> () ! OutOfMemoryError ? &mut Allocator {
  run Encoding.word(&mut output.*, value.high)
  return run Encoding.word(&mut output.*, value.low)
}
fn readPair(bytes: &[u8], reader: &mut StableKey.Reader) -> ContentHash {
  let high = StableKey.readWord(bytes, &mut reader.*)
  let low = StableKey.readWord(bytes, &mut reader.*)
  return ContentHash {high: high, low: low}
}

/// Encodes an atomic pointer to one immutable generation descriptor in its namespace.
pub effect fn pointer(incarnation: ContentHash, generation: ContentHash) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let mut output = Bytes.make()
  run Encoding.field(&mut output, b"silk-generation-current-v1")
  run wordPair(&mut output, incarnation)
  run wordPair(&mut output, generation)
  let seal = ContentHash.of(Bytes.asSlice(&output))
  run wordPair(&mut output, seal)
  return move output
}

/// Authenticates a current pointer and rejects a packet from another cache incarnation.
pub fn readPointer(bytes: &[u8], incarnation: ContentHash) -> Option<ContentHash> {
  if bytes.length > 256 || bytes.length < 16 { return Option<ContentHash>.none() }
  let mut reader = StableKey.reader()
  let magic = StableKey.readField(bytes, &mut reader)
  if StableKey.failed(&reader) || !same(StableKey.view(bytes, magic), b"silk-generation-current-v1") {
    return Option<ContentHash>.none()
  }
  let namespace = readPair(bytes, &mut reader)
  let generation = readPair(bytes, &mut reader)
  let checksum = readPair(bytes, &mut reader)
  if !StableKey.finished(bytes, &reader) || !ContentHash.equals(namespace, incarnation) { return Option<ContentHash>.none() }
  // Encoding.word is fixed width; the final pair seals every preceding byte.
  if !ContentHash.equals(checksum, ContentHash.of(StableKey.view(bytes,
    Span.make(usize.ZERO, bytes.length - 16)))) { return Option<ContentHash>.none() }
  return Option<ContentHash>.some(generation)
}

// Locks are native handles rather than marker files or timestamps. Closing the last inherited
// handle releases the pin, including after process failure. Unsupported hosts refuse safely.
static if Intrinsic.targetOperatingSystem() == "linux" || Intrinsic.targetOperatingSystem() == "darwin" {
  @foreign(noCapture: .("path"))
  unsafe extern "C" fn open(path: ?[*]const u8, flags: i32, ...) -> i32
  unsafe extern "C" fn close(fd: i32) -> i32
  unsafe extern "C" fn flock(fd: i32, operation: i32) -> i32
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    unsafe extern "C" fn __error() -> *mut i32
    unsafe fn currentError() -> i32 { unsafe { return Pointer.read<i32>(__error()) } }
    const CREATE: i32 = 512
    const CLOEXEC: i32 = 16777216
  } else {
    unsafe extern "C" fn __errno_location() -> *mut i32
    unsafe fn currentError() -> i32 { unsafe { return Pointer.read<i32>(__errno_location()) } }
    const CREATE: i32 = 64
    const CLOEXEC: i32 = 524288
  }
  /// A lifetime pin or transaction lock; dropping closes the owned native descriptor.
  pub struct Lease {fd: i32}
  impl Drop for Lease {
    fn drop(self: &mut Lease) -> () {
      let fd = Intrinsic.replace(self.fd, -1)
      if fd >= 0 { drop unsafe close(fd) }
    }
  }
  effect fn acquire(path: &Path, exclusive: bool, wait: bool) -> Option<Lease>
  ! OutOfMemoryError ? &mut Allocator {
    let mut name = run Bytes.copy(Path.rawBytes(path))
    run Bytes.append(&mut name, &[0])
    let fd = unsafe open(Pointer.fromSlice<u8>(Bytes.asSlice(&name)), 2 + CREATE + CLOEXEC, 438)
    if fd < 0 { return Option<Lease>.none() }
    let owned = Lease {fd: fd}
    let operation = (if exclusive { 2 } else { 1 }) + if wait { 0 } else { 4 }
    while true {
      if unsafe flock(fd, operation) == 0 { return Option<Lease>.some(move owned) }
      if unsafe currentError() != 4 { return Option<Lease>.none() }
    }
  }
} else {
  // A platform implementation is required before segmented publication can be enabled there.
  /// A refused-host placeholder; no successful lock can be constructed on this host.
  pub struct Lease {}
  effect fn acquire(path: &Path, exclusive: bool, wait: bool) -> Option<Lease>
  ! OutOfMemoryError ? &mut Allocator {
    drop path
    drop exclusive
    drop wait
    return Option<Lease>.none()
  }
}

/// Takes a shared generation pin. Acquisition is completed under the publication lock.
pub effect fn pin(path: &Path) -> Option<Lease> ! OutOfMemoryError ? &mut Allocator {
  return run acquire(path, false, true)
}
/// Takes the exclusive publication transaction lock; failure refuses the transaction.
pub effect fn transaction(path: &Path) -> Option<Lease> ! OutOfMemoryError ? &mut Allocator {
  return run acquire(path, true, true)
}
/// Tries to retire an old generation without blocking a live reader or writer pin.
/// Pin-file inodes must remain for the whole incarnation, even after resource retirement;
/// unlinking and reopening a pin could split live owners across two unrelated native locks.
pub effect fn tryRetire(path: &Path) -> Option<Lease> ! OutOfMemoryError ? &mut Allocator {
  return run acquire(path, true, false)
}

// Absence is a physical state. Permission or other read errors must not masquerade as absence.
effect fn read(path: &Path) -> Option<Bytes> ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  return match move run Effect.result(FileSystem.readFile(path)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success {value} => Option<Bytes>.some(move value)
    Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError missing => {
        if missing.reason.code == FileSystem.reasonCode(FileSystem.notFound()) { drop missing return Option<Bytes>.none() }
        fail move missing
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

/// A remembered physical publication state. Malformed contents still have a distinct token.
pub effect fn observe(path: &Path, incarnation: ContentHash) -> Token
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  if let Option<Bytes>.Some {value} = move run read(path) {
    return Token {incarnation: incarnation, present: true, physical: ContentHash.of(Bytes.asSlice(&value))}
  }
  return Token {incarnation: incarnation, present: false, physical: zero()}
}

/// Whether a writer's expected physical token is still current while it owns the transaction.
/// The caller obtains `incarnation` from the namespace marker, never from its old snapshot.
pub effect fn current(path: &Path, incarnation: ContentHash, expected: Token) -> bool
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  return sameToken(run observe(path, incarnation), expected)
}

fn hexDigit(value: u64) -> u8 {
  if value < 10 { return u64.toU8(value) + 48 }
  return u64.toU8(value) + 87
}
effect fn named(directory: &Path, prefix: &[u8], digest: ContentHash) -> Path
! FileError | OutOfMemoryError ? &mut Allocator {
  let mut name = run Bytes.copy(prefix)
  let words = [digest.high, digest.low]
  let mut part = usize.ZERO
  while part < 2 {
    let mut digit = usize.ZERO
    while digit < 16 {
      let byte = hexDigit(u64.bitAnd(u64.shiftRight(words[part], usize.toU64((15 - digit) * 4)), 15))
      run Bytes.append(&mut name, &[byte])
      digit = digit + usize.ONE
    }
    part = part + usize.ONE
  }
  return run Path.joinBytes(directory, Bytes.asSlice(&name))
}

/// Names the immutable namespace incarnation. Writers use this exact directory and never
/// recreate it, so clean/recreation cannot redirect an old lock holder into a new namespace.
pub effect fn namespacePath(directory: &Path, incarnation: ContentHash) -> Path
! FileError | OutOfMemoryError ? &mut Allocator { return run named(directory, b"incarnation-", incarnation) }

/// Names an immutable generation descriptor by the digest of its complete encoded bytes.
pub effect fn generationPath(directory: &Path, digest: ContentHash) -> Path
! FileError | OutOfMemoryError ? &mut Allocator { return run named(directory, b"generation-", digest) }
/// Names the lifetime lock for a generation. The lock file is not itself a resource pin.
pub effect fn pinPath(directory: &Path, digest: ContentHash) -> Path
! FileError | OutOfMemoryError ? &mut Allocator { return run named(directory, b"pin-", digest) }

/// Establishes a namespace once. `nonce` must be freshly chosen for a newly created directory;
/// a valid existing incarnation wins concurrent initialization. A malformed marker is refused.
pub effect fn initialize(directory: &Path, nonce: ContentHash) -> Option<ContentHash>
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  run FileSystem.createDirectoriesRecursively(directory)
  if let Option<ContentHash>.Some {value} = move run incarnation(directory) {
    let existing = run namespacePath(directory, value)
    if run FileSystem.exists(&existing) { return Option<ContentHash>.some(value) }
    // Never resurrect an old incarnation directory after clean removed it.
    return Option<ContentHash>.none()
  }
  let markerPath = run Path.join(directory, "incarnation")
  if let Option<Bytes>.Some {value} = move run read(&markerPath) {
    drop value
    return Option<ContentHash>.none()
  }
  let scoped = run namespacePath(directory, nonce)
  run FileSystem.createDirectoriesRecursively(&scoped)
  // Initialize accounting before exposing the namespace. A missing ledger in an existing
  // incarnation is corruption, not permission to start counting from zero.
  let ledgerPath = run Path.join(&scoped, "space")
  let ledger = run spacePacket(nonce, 1024)
  let initialized = run Effect.result(FileSystem.writeFileAtomic(&ledgerPath, Bytes.asSlice(&ledger),
    FileSystem.createNew(), FileSystem.synchronized()))
  match move initialized {
    Result<(), AtomicWriteError>.Success {..} => {}
    Result<(), AtomicWriteError>.Failure {error} => { drop error return Option<ContentHash>.none() }
  }
  let path = run Path.join(directory, "incarnation")
  let mut bytes = Bytes.make()
  run wordPair(&mut bytes, nonce)
  let created = run Effect.result(FileSystem.writeFileAtomic(&path, Bytes.asSlice(&bytes),
    FileSystem.createNew(), FileSystem.buffered()))
  match move created {
    Result<(), AtomicWriteError>.Success {..} => {}
    Result<(), AtomicWriteError>.Failure {error} => { drop error }
  }
  return run incarnation(directory)
}

effect fn incarnation(directory: &Path) -> Option<ContentHash>
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let path = run Path.join(directory, "incarnation")
  let bytes = match move run read(&path) {
    Option<Bytes>.Some {value} => move value
    _ => { return Option<ContentHash>.none() }
  }
  if Bytes.length(&bytes) != 16 { return Option<ContentHash>.none() }
  let mut reader = StableKey.reader()
  let value = readPair(Bytes.asSlice(&bytes), &mut reader)
  if !StableKey.finished(Bytes.asSlice(&bytes), &reader) { return Option<ContentHash>.none() }
  return Option<ContentHash>.some(value)
}

/// A physical snapshot and its generation lifetime pin. A missing or malformed descriptor
/// leaves `takeGeneration` empty without forgetting the physical state expected by a writer.
/// Keep this owner alive while Semantic or any writer borrows the generation's resources.
pub struct Snapshot {
  pub expected: Token,
  generation: Option<Generation>,
  pin: Option<Lease>,
  directory: Path,
  inheritedSegments: Digests,
  inheritedPacks: Digests,
  refusedPacks: Digests,
}

/// Moves the decoded generation into a lazy semantic view while retaining its OS pin.
pub fn takeGeneration(snapshot: &mut Snapshot) -> Option<Generation> {
  return Intrinsic.replace(snapshot.generation, Option<Generation>.none())
}

/// Reads one current pointer and pins its generation before releasing the transaction lock.
/// Immutable segment packets are loaded later while this returned owner remains alive.
pub effect fn snapshot(directory: &Path, stamp: &[u8]) -> Option<Snapshot>
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let namespace = match move run incarnation(directory) {
    Option<ContentHash>.Some {value} => value
    _ => { return Option<Snapshot>.none() }
  }
  let scoped = run namespacePath(directory, namespace)
  let lockPath = run Path.join(&scoped, "transaction.lock")
  let lock = match move run pin(&lockPath) {
    Option<Lease>.Some {value} => move value
    _ => { return Option<Snapshot>.none() }
  }
  let currentPath = run Path.join(&scoped, "current")
  let bytes = run read(&currentPath)
  let mut expected = Token {incarnation: namespace, present: false, physical: zero()}
  let mut identity = Option<ContentHash>.none()
  if let Option<Bytes>.Some {value} = &bytes {
    expected.present = true
    expected.physical = ContentHash.of(Bytes.asSlice(&value))
    identity = readPointer(Bytes.asSlice(&value), namespace)
  }
  let chosen = match move identity {
    Option<ContentHash>.Some {value} => value
    _ => { return Option<Snapshot>.some(Snapshot {expected: expected,
      generation: Option<Generation>.none(), pin: Option<Lease>.none(), directory: move scoped,
      inheritedSegments: digests(), inheritedPacks: digests(), refusedPacks: digests()}) }
  }
  let leasePath = run pinPath(&scoped, chosen)
  let lease = match move run pin(&leasePath) {
    Option<Lease>.Some {value} => move value
    _ => { return Option<Snapshot>.none() }
  }
  // Publication can now proceed; it cannot reclaim this descriptor or its resource union.
  drop lock
  let path = run generationPath(&scoped, chosen)
  let descriptor = match move run read(&path) {
    Option<Bytes>.Some {value} => move value
    _ => { return Option<Snapshot>.some(Snapshot {expected: expected,
      generation: Option<Generation>.none(), pin: Option<Lease>.some(move lease), directory: move scoped,
      inheritedSegments: digests(), inheritedPacks: digests(), refusedPacks: digests()}) }
  }
  let valid = ContentHash.equals(ContentHash.of(Bytes.asSlice(&descriptor)), chosen)
  let generation = if valid { run Generations.decode(Bytes.asSlice(&descriptor), stamp) } else { Option<Generation>.none() }
  return Option<Snapshot>.some(Snapshot {expected: expected, generation: move generation,
    pin: Option<Lease>.some(move lease), directory: move scoped,
    inheritedSegments: digests(), inheritedPacks: digests(), refusedPacks: digests()})
}

/// Exclusive ownership of a publication whose prior physical state has been checked.
/// The source snapshot's separate pin must survive through this writer's completion.
pub struct Writer {directory: Path, expected: Token, lock: Lease}

/// Starts a transaction only if both namespace incarnation and current physical token agree.
/// Lock/read failure or a stale token never falls back to an unlocked write.
pub effect fn begin(directory: &Path, expected: Token) -> Option<Writer>
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let namespace = match move run incarnation(directory) {
    Option<ContentHash>.Some {value} => value
    _ => { return Option<Writer>.none() }
  }
  if !ContentHash.equals(namespace, expected.incarnation) { return Option<Writer>.none() }
  let scoped = run namespacePath(directory, namespace)
  let path = run Path.join(&scoped, "transaction.lock")
  let lock = match move run transaction(&path) {
    Option<Lease>.Some {value} => move value
    _ => { return Option<Writer>.none() }
  }
  let currentPath = run Path.join(&scoped, "current")
  if !(run current(&currentPath, namespace, expected)) { return Option<Writer>.none() }
  return Option<Writer>.some(Writer {directory: move scoped,
    expected: expected, lock: move lock})
}

// The final publication step uses the Writer's bound incarnation path, never a path resolved
// again through the mutable root marker. All immutable resources must already be admitted and
// present before this private operation is reached by the prepared-publication layer.
effect fn publishPointer(writer: &Writer, generation: ContentHash) -> ()
! FileError | AtomicWriteError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let path = run Path.join(&writer.directory, "current")
  let bytes = run pointer(writer.expected.incarnation, generation)
  return run FileSystem.writeFileAtomic(&path, Bytes.asSlice(&bytes), FileSystem.replaceExisting(), FileSystem.buffered())
}

// Only the loader can establish inherited provenance. These small identity sets do not copy
// segment packets, observations, graph nodes, answers, or pack bodies.
struct Digests {values: List<ContentHash>, index: InternIndex}
fn digests() -> Digests { return Digests {values: List<ContentHash>.make(), index: InternIndex.make()} }
fn contains(values: &Digests, digest: ContentHash) -> bool {
  let entries = List<ContentHash>.asSlice(&values.values)
  let mut at = InternIndex.first(&values.index, digest.low)
  while at != usize.MAX {
    if ContentHash.equals(entries[at], digest) { return true }
    at = InternIndex.after(&values.index, at)
  }
  return false
}
effect fn remember(values: &mut Digests, digest: ContentHash) -> () ! OutOfMemoryError ? &mut Allocator {
  if contains(values, digest) { return () }
  run InternIndex.record(&mut values.index, digest.low)
  return run List<ContentHash>.append(&mut values.values, digest)
}

/// The exact sealed segment object in a namespace; its filename digest is the segment seal.
pub effect fn segmentPath(directory: &Path, digest: ContentHash) -> Path
! FileError | OutOfMemoryError ? &mut Allocator { return run named(directory, b"segment-", digest) }
/// A native pack object named by the digest of its full payload.
pub effect fn packPath(directory: &Path, digest: ContentHash) -> Path
! FileError | OutOfMemoryError ? &mut Allocator { return run named(directory, b"pack-", digest) }

/// Loads sealed packets under the snapshot pin and admits their selected authority exactly once.
/// Each packet remains its original owned bytes; no answers or graph payloads are flattened.
/// The returned view may be moved into Semantic while `snapshot` keeps its filesystem pin.
pub effect fn load(snapshot: &mut Snapshot) -> Option<View>
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let generation = match move takeGeneration(&mut snapshot.*) {
    Option<Generation>.Some {value} => move value
    Option<Generation>.None => { return Option<View>.none() }
  }
  let mut owners = List<Frozen<SealedSegment>>.make()
  let catalog = List<Descriptor>.asSlice(&generation.catalog)
  let mut at = usize.ZERO
  while at < catalog.length {
    let path = run segmentPath(&snapshot.directory, catalog[at].digest)
    let bytes = match move run read(&path) {
      Option<Bytes>.Some {value} => move value
      Option<Bytes>.None => { return Option<View>.none() }
    }
    let sealed = match move run Segments.open(move bytes, Bytes.asSlice(&generation.stamp)) {
      Option<SealedSegment>.Some {value} => move value
      Option<SealedSegment>.None => { return Option<View>.none() }
    }
    if !Segments.sameDescriptor(Segments.descriptor(&sealed), catalog[at]) { return Option<View>.none() }
    // This loader runs on the owner thread. Future prefetch must join raw-byte workers before
    // freezing; Frozen handles must never cross a native thread boundary.
    run List<Frozen<SealedSegment>>.append(&mut owners, run Frozen<SealedSegment>.make(move sealed))
    at = at + usize.ONE
  }
  drop catalog
  let view = match move run Views.make(move generation, move owners) {
    Option<View>.Some {value} => move value
    Option<View>.None => { return Option<View>.none() }
  }
  let held = Views.segments(&view)
  let mut knownSegments = digests()
  at = usize.ZERO
  while at < held.length {
    run remember(&mut knownSegments, Segments.descriptor(Frozen<SealedSegment>.get(&held[at])).digest)
    at = at + usize.ONE
  }
  let mut knownPacks = digests()
  let packs = Views.requiredPacks(&view)
  at = usize.ZERO
  while at < packs.length { run remember(&mut knownPacks, packs[at]) at = at + usize.ONE }
  // Commit provenance together only after all allocating validation succeeds. Pack bodies are
  // lazy: protocol publication made them present, and this generation pin prevents reclamation.
  snapshot.inheritedSegments = move knownSegments
  snapshot.inheritedPacks = move knownPacks
  return Option<View>.some(move view)
}

/// Loads one admitted pack on demand. Missing or corrupt external bytes refuse reuse and revoke
/// inherited presence, so a subsequent writer needs repaired bytes for any still-selected answer.
pub effect fn readPack(snapshot: &mut Snapshot, digest: ContentHash) -> Option<Bytes>
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  if !contains(&snapshot.inheritedPacks, digest) { return Option<Bytes>.none() }
  let path = run packPath(&snapshot.directory, digest)
  if let Option<Bytes>.Some {value} = move run read(&path) {
    if ContentHash.equals(ContentHash.of(Bytes.asSlice(&value)), digest) { return Option<Bytes>.some(move value) }
  }
  run remember(&mut snapshot.refusedPacks, digest)
  return Option<Bytes>.none()
}

/// Borrowed new or repaired pack bytes. Publication never copies these payloads.
pub struct Pack<'a> {pub digest: ContentHash, pub bytes: &'a [u8]}

/// A refused transaction leaves the old complete generation and every reachable object intact.
pub enum Refusal {Stale, Invalid, MissingPack, Space, Accounting}
/// A successful pointer may be visible even if the final atomic-write cleanup reported an error.
/// All objects remain retained in either result; no caller should delete them on a later error.
pub union Published {
  Committed {generation: ContentHash, token: Token, warning: Option<AtomicWriteError>},
  Refused {reason: Refusal},
}

// This is an upper bound on stored payload bytes, including retired pinned generations,
// unpublished files and temporary atomic-write payloads. It is not an OS free-space estimate.
// Failed staging retains its reservation. Bounded maintenance may later retire proven-dead
// resources and release their charge; no publication performs an unbounded directory scan.
effect fn spacePacket(incarnation: ContentHash, used: u64) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut bytes = Bytes.make()
  run Encoding.field(&mut bytes, b"silk-generation-space-v1")
  run wordPair(&mut bytes, incarnation)
  run Encoding.word(&mut bytes, used)
  let seal = ContentHash.of(Bytes.asSlice(&bytes))
  run wordPair(&mut bytes, seal)
  return move bytes
}
fn readSpace(bytes: &[u8], incarnation: ContentHash) -> Option<u64> {
  if bytes.length < 16 || bytes.length > 256 { return Option<u64>.none() }
  let mut reader = StableKey.reader()
  let magic = StableKey.readField(bytes, &mut reader)
  let namespace = readPair(bytes, &mut reader)
  let used = StableKey.readWord(bytes, &mut reader)
  let seal = readPair(bytes, &mut reader)
  if !StableKey.finished(bytes, &reader) || !same(StableKey.view(bytes, magic), b"silk-generation-space-v1")
    || !ContentHash.equals(namespace, incarnation)
    || !ContentHash.equals(seal, ContentHash.of(StableKey.view(bytes, Span.make(usize.ZERO, bytes.length - 16)))) {
    return Option<u64>.none()
  }
  return Option<u64>.some(used)
}
fn charge(total: &mut u64, amount: usize) -> bool {
  let added = usize.toU64(amount)
  if total.* > u64.MAX - added { return false }
  total.* = total.* + added
  return true
}
// Missing/malformed ledgers refuse: a current pointer cannot authorize resetting physical debt.
effect fn reserve(writer: &Writer, amount: u64, limit: u64) -> Option<Refusal>
! FileError | AtomicWriteError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let path = run Path.join(&writer.directory, "space")
  let packet = match move run read(&path) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return Option<Refusal>.some(Refusal.Accounting) }
  }
  let used = match move readSpace(Bytes.asSlice(&packet), writer.expected.incarnation) {
    Option<u64>.Some {value} => value
    Option<u64>.None => { return Option<Refusal>.some(Refusal.Accounting) }
  }
  if used > limit || amount > limit - used { return Option<Refusal>.some(Refusal.Space) }
  let next = run spacePacket(writer.expected.incarnation, used + amount)
  // Reserve durably before any new resource is created. A post-rename error aborts staging,
  // preserving the conservative charge even if the ledger itself became visible.
  run FileSystem.writeFileAtomic(&path, Bytes.asSlice(&next), FileSystem.replaceExisting(), FileSystem.synchronized())
  return Option<Refusal>.none()
}

effect fn store(path: &Path, bytes: &[u8]) -> ()
! FileError | AtomicWriteError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  if let Option<Bytes>.Some {value} = move run read(path) {
    if same(Bytes.asSlice(&value), bytes) { return () }
  }
  // A colliding pathname is not proof of valid content. Exact trusted bytes repair corruption;
  // atomic replacement preserves readers of the previous inode and never exposes a short file.
  return run FileSystem.writeFileAtomic(path, bytes, FileSystem.replaceExisting(), FileSystem.buffered())
}
fn offered(packs: &[Pack<'_>], index: &InternIndex, digest: ContentHash) -> usize {
  let mut at = InternIndex.first(index, digest.low)
  while at != usize.MAX {
    if ContentHash.equals(packs[at].digest, digest) { return at }
    at = InternIndex.after(index, at)
  }
  return usize.MAX
}

/// Publishes an already-admitted view under an exclusive expected-prior transaction. The source
/// snapshot remains pinned throughout this call; only fresh sealed objects and offered repairs
/// are written. Pack authority comes from every selected answer, not this invocation's units.
/// `limit` bounds conservatively reserved stored payload bytes, including failed/retired work.
/// No resources are removed here. Maintenance must prove reachability and obtain retirement pins
/// before deleting anything or reducing the reservation ledger.
pub effect fn publish(writer: Writer, source: &Snapshot, view: &View, packs: &[Pack<'_>], limit: u64) -> Published
! FileError | AtomicWriteError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  if !sameToken(writer.expected, source.expected) || !same(Path.rawBytes(&writer.directory), Path.rawBytes(&source.directory)) {
    return Published.Refused {reason: Refusal.Stale}
  }
  let currentPath = run Path.join(&writer.directory, "current")
  if !(run current(&currentPath, writer.expected.incarnation, writer.expected)) { return Published.Refused {reason: Refusal.Stale} }
  let descriptor = match move run Generations.encode(Views.generation(view)) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return Published.Refused {reason: Refusal.Invalid} }
  }
  let identity = ContentHash.of(Bytes.asSlice(&descriptor))
  let pointerBytes = run pointer(writer.expected.incarnation, identity)
  let mut packIndex = InternIndex.make()
  let mut at = usize.ZERO
  while at < packs.length {
    if offered(packs, &packIndex, packs[at].digest) != usize.MAX
      || !ContentHash.equals(ContentHash.of(packs[at].bytes), packs[at].digest) { return Published.Refused {reason: Refusal.Invalid} }
    run InternIndex.record(&mut packIndex, packs[at].digest.low)
    at = at + usize.ONE
  }
  // The constant covers ledger/current atomic temporary packets and descriptor/pin metadata.
  let mut needed: u64 = 1024
  if !charge(&mut needed, Bytes.length(&descriptor)) || !charge(&mut needed, Bytes.length(&pointerBytes)) {
    return Published.Refused {reason: Refusal.Space}
  }
  let held = Views.segments(view)
  at = usize.ZERO
  while at < held.length {
    let segment = Frozen<SealedSegment>.get(&held[at])
    if !contains(&source.inheritedSegments, Segments.descriptor(segment).digest)
      && !charge(&mut needed, Segments.encoded(segment).length) { return Published.Refused {reason: Refusal.Space} }
    at = at + usize.ONE
  }
  let required = Views.requiredPacks(view)
  at = usize.ZERO
  while at < required.length {
    let supplied = offered(packs, &packIndex, required[at])
    if supplied != usize.MAX {
      if !charge(&mut needed, packs[supplied].bytes.length) { return Published.Refused {reason: Refusal.Space} }
    } else if !contains(&source.inheritedPacks, required[at]) || contains(&source.refusedPacks, required[at]) {
      // A selected pack absent from the original admitted snapshot must be supplied or already
      // exist with correct bytes. This path is fresh-only, never an inherited full-pack reread.
      let path = run packPath(&writer.directory, required[at])
      let bytes = match move run read(&path) {
        Option<Bytes>.Some {value} => move value
        Option<Bytes>.None => { return Published.Refused {reason: Refusal.MissingPack} }
      }
      if !ContentHash.equals(ContentHash.of(Bytes.asSlice(&bytes)), required[at]) { return Published.Refused {reason: Refusal.MissingPack} }
    }
    at = at + usize.ONE
  }
  if let Option<Refusal>.Some {value} = move run reserve(&writer, needed, limit) { return Published.Refused {reason: value} }
  at = usize.ZERO
  while at < held.length {
    let segment = Frozen<SealedSegment>.get(&held[at])
    let digest = Segments.descriptor(segment).digest
    if !contains(&source.inheritedSegments, digest) {
      let path = run segmentPath(&writer.directory, digest)
      run store(&path, Segments.encoded(segment))
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < required.length {
    let supplied = offered(packs, &packIndex, required[at])
    if supplied != usize.MAX {
      let path = run packPath(&writer.directory, required[at])
      run store(&path, packs[supplied].bytes)
    }
    at = at + usize.ONE
  }
  let path = run generationPath(&writer.directory, identity)
  run store(&path, Bytes.asSlice(&descriptor))
  let published = run Effect.result(FileSystem.writeFileAtomic(&currentPath, Bytes.asSlice(&pointerBytes),
    FileSystem.replaceExisting(), FileSystem.buffered()))
  let warning = match move published {
    Result<(), AtomicWriteError>.Success {..} => Option<AtomicWriteError>.none()
    Result<(), AtomicWriteError>.Failure {error} => {
      if !error.published { fail move error }
      // The rename completed. Never delete resources or blindly retry publication after this
      // boundary. Verify the visible pointer under the same lock, then report cleanup uncertainty.
      let visible = run observe(&currentPath, writer.expected.incarnation)
      if !visible.present || !ContentHash.equals(visible.physical, ContentHash.of(Bytes.asSlice(&pointerBytes))) { fail move error }
      Option<AtomicWriteError>.some(move error)
    }
  }
  return Published.Committed {generation: identity,
    token: Token {incarnation: writer.expected.incarnation, present: true, physical: ContentHash.of(Bytes.asSlice(&pointerBytes))}, warning: move warning}
}

import silk.system.filesystem_machine {MachineFileSystem}
import silk.testing.testing {Testing, AssertionError}

effect fn recreationDuringTransaction(directory: &mut Path) -> ()
! FileError | OutOfMemoryError | AssertionError<'static> ? &mut FileSystem | &mut Allocator {
  let old = ContentHash {high: 31, low: 37}
  let fresh = ContentHash {high: 41, low: 43}
  drop run initialize(&directory.*, old)
  let opened = match move run snapshot(&directory.*, b"stamp") {
    Option<Snapshot>.Some {value} => move value
    _ => { return run Testing.expect(false, "the initialized namespace has a snapshot") }
  }
  let writer = match move run begin(&directory.*, opened.expected) {
    Option<Writer>.Some {value} => move value
    _ => { return run Testing.expect(false, "the writer owns the old transaction before clean") }
  }
  // The old native lock is still held on its unlinked inode throughout clean and recreation.
  run FileSystem.removeDirectoryRecursively(&directory.*)
  drop run initialize(&directory.*, fresh)
  let stale = run Effect.result(publishPointer(&writer, ContentHash {high: 47, low: 53}))
  run Testing.expect(match &stale {
    Result<(), FileError | AtomicWriteError | OutOfMemoryError>.Failure {..} => true _ => false },
    "a held old lock cannot publish through the newly created namespace path")
  let newDirectory = run namespacePath(&directory.*, fresh)
  let newCurrent = run Path.join(&newDirectory, "current")
  let oldDirectory = run namespacePath(&directory.*, old)
  run Testing.expect(!(run FileSystem.exists(&newCurrent)) && !(run FileSystem.exists(&oldDirectory)),
    "old publication neither touches new current nor resurrects its removed incarnation")
}

effect fn recreationClaims() -> () ! FileError | OutOfMemoryError | AssertionError<'static>
? &mut FileSystem | &mut Allocator {
  let temporary = run Path.fromBytes(b"/tmp")
  let root = run FileSystem.createTemporaryDirectory(&temporary, b"silk-cache-recreation-")
  let use = effect fn(path: &mut Path) -> () ! FileError | OutOfMemoryError | AssertionError<'static>
    ? &mut FileSystem | &mut Allocator { return run recreationDuringTransaction(&mut path.*) }
  let release = effect fn(path: &mut Path) -> () ? &mut FileSystem | &mut Allocator {
    drop run Effect.result(FileSystem.removeDirectoryRecursively(&path.*))
  }
  return run Effect.useReleaseNonParking(move root, move use, move release)
}

test effect fn heldGenerationTransactionCannotPublishIntoRecreatedNamespace() -> ()
! FileError | OutOfMemoryError | AssertionError<'static> {
  static if Intrinsic.targetOperatingSystem() == "linux" || Intrinsic.targetOperatingSystem() == "darwin" {
    let mut allocator = Allocator.systemAllocatorProvider()
    let mut files = run MachineFileSystem.make() |> Effect.provideMut<Allocator>(&mut allocator)
    return run recreationClaims() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
  } else { return () }
}
