//! The imports each source file writes, by the digest of its bytes, kept beside the semantic cache
//! so that loading a program reads an unchanged file's imports without parsing it.
//!
//! # Details
//! A summary holds a file's written import paths, in the order its index lists them, whether it
//! names a member of the sealed declaration catalog, and whether it declares a foreign claim
//! (`Semantic.claimsForeignSymbols`). All are read from syntax alone, so they hold for any file
//! with the same bytes. The file is stamped with the compiler that wrote it and
//! the digest of the catalog it was read against; a different stamp reads as no summaries.
//!
//! Every word is big-endian and every byte run is length-delimited, as `StableKey` reads them.

import semantic.ContentHash {ContentHash}
import semantic.InternIndex {InternIndex}
import semantic.RuntimeEncoding as Encoding
import semantic.StableKey
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.list {List}
import silk.option {Option}
import silk.u64
import silk.usize

// Changes whenever the layout below changes.
const FORMAT: u64 = 1

/// The imports one file writes.
pub struct Summary {
  pub digest: ContentHash,
  /// Whether the file names a member of the sealed declaration catalog.
  pub sealed: bool,
  /// Whether the file declares a function with a foreign linkage or a static.
  pub claims: bool,
  pub paths: List<Bytes>,
}

/// The summaries one load reads and records.
pub struct ImportSummaries {
  // The compiler that wrote the summaries, as `CacheStamp.compiler` names it.
  compiler: Bytes,
  // The digest of the sealed catalog the summaries were read against.
  catalog: ContentHash,
  entries: List<Summary>,
  lookup: InternIndex,
  // Which entries this load found or added; only those are written back.
  used: List<bool>,
  added: bool,
  // The digests of the files the last build's store parsed, which a load parses ahead on threads
  // of its own (`ModuleSources.preload`).
  parsed: List<ContentHash>,
  parsedLookup: InternIndex,
}

/// No summaries, for `compiler`.
pub fn make(compiler: Bytes) -> ImportSummaries {
  return ImportSummaries {compiler: move compiler, catalog: ContentHash {high: 0, low: 0}, entries: List<Summary>.make(),
    lookup: InternIndex.make(), used: List<bool>.make(), added: false, parsed: List<ContentHash>.make(),
    parsedLookup: InternIndex.make()}
}

/// The summaries `bytes` hold when `compiler` wrote them; none when the bytes are malformed or
/// another compiler wrote them.
pub effect fn decode(compiler: Bytes, bytes: &[u8]) -> ImportSummaries ! OutOfMemoryError ? &mut Allocator {
  let mut summaries = make(move compiler)
  let mut reader = StableKey.reader()
  if StableKey.readWord(bytes, &mut reader) != FORMAT { return move summaries }
  let stamp = StableKey.readField(bytes, &mut reader)
  if StableKey.failed(&reader) || !same(StableKey.view(bytes, stamp), Bytes.asSlice(&summaries.compiler)) { return move summaries }
  let catalog = ContentHash {high: StableKey.readWord(bytes, &mut reader), low: StableKey.readWord(bytes, &mut reader)}
  let count = StableKey.readWord(bytes, &mut reader)
  let mut entries = List<Summary>.make()
  let mut at: u64 = 0
  while at < count && !StableKey.failed(&reader) {
    let digest = ContentHash {high: StableKey.readWord(bytes, &mut reader), low: StableKey.readWord(bytes, &mut reader)}
    let sealed = StableKey.readWord(bytes, &mut reader) == 1
    let claims = StableKey.readWord(bytes, &mut reader) == 1
    let written = StableKey.readWord(bytes, &mut reader)
    let mut paths = List<Bytes>.make()
    let mut pathAt: u64 = 0
    while pathAt < written && !StableKey.failed(&reader) {
      let path = StableKey.readField(bytes, &mut reader)
      run List<Bytes>.append(&mut paths, run Bytes.copy(StableKey.view(bytes, path)))
      pathAt = pathAt + 1
    }
    run List<Summary>.append(&mut entries, Summary {digest: digest, sealed: sealed, claims: claims, paths: move paths})
    at = at + 1
  }
  if !StableKey.finished(bytes, &reader) { return move summaries }
  summaries.catalog = catalog
  let listed = List<Summary>.asSlice(&entries)
  at = 0
  while at < count {
    run InternIndex.record(&mut summaries.lookup, listed[u64.toUsize(at)].digest.low)
    run List<bool>.append(&mut summaries.used, false)
    at = at + 1
  }
  summaries.entries = move entries
  return move summaries
}

/// Takes the digests [`encodeParsed`] wrote as the files the last build parsed; malformed bytes
/// name none.
pub effect fn selectParsed(self: &mut ImportSummaries, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut reader = StableKey.reader()
  if StableKey.readWord(bytes, &mut reader) != FORMAT { return () }
  let count = StableKey.readWord(bytes, &mut reader)
  let mut digests = List<ContentHash>.make()
  let mut at: u64 = 0
  while at < count && !StableKey.failed(&reader) {
    run List<ContentHash>.append(&mut digests, ContentHash {high: StableKey.readWord(bytes, &mut reader), low: StableKey.readWord(bytes, &mut reader)})
    at = at + 1
  }
  if !StableKey.finished(bytes, &reader) { return () }
  let listed = List<ContentHash>.asSlice(&digests)
  let mut lookup = InternIndex.make()
  let mut index = usize.ZERO
  while index < listed.length {
    run InternIndex.record(&mut lookup, listed[index].low)
    index = index + usize.ONE
  }
  self.parsed = move digests
  self.parsedLookup = move lookup
}

/// Whether the last build parsed a file whose bytes have digest `digest`.
pub fn wasParsed(self: &ImportSummaries, digest: ContentHash) -> bool {
  let listed = List<ContentHash>.asSlice(&self.parsed)
  let mut at = InternIndex.first(&self.parsedLookup, digest.low)
  while at != usize.MAX {
    if ContentHash.equals(listed[at], digest) { return true }
    at = InternIndex.after(&self.parsedLookup, at)
  }
  return false
}

/// The bytes naming `digests` as the files a build parsed, which [`selectParsed`] reads back.
pub effect fn encodeParsed(digests: &[ContentHash]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut output = Bytes.make()
  run Encoding.word(&mut output, FORMAT)
  run Encoding.word(&mut output, usize.toU64(digests.length))
  let mut at = usize.ZERO
  while at < digests.length {
    run Encoding.word(&mut output, digests[at].high)
    run Encoding.word(&mut output, digests[at].low)
    at = at + usize.ONE
  }
  return move output
}

/// Drops every summary unless they were read against the sealed catalog with digest `catalog`.
pub fn selectCatalog(self: &mut ImportSummaries, catalog: ContentHash) -> () {
  if ContentHash.equals(self.catalog, catalog) { return () }
  self.catalog = catalog
  self.entries = List<Summary>.make()
  self.lookup = InternIndex.make()
  self.used = List<bool>.make()
}

/// A copy of the summary of a file whose bytes have digest `digest`, marked used.
pub effect fn find(self: &mut ImportSummaries, digest: ContentHash) -> Option<Summary> ! OutOfMemoryError ? &mut Allocator {
  let mut at = InternIndex.first(&self.lookup, digest.low)
  while at != usize.MAX {
    let entries = List<Summary>.asSlice(&self.entries)
    if ContentHash.equals(entries[at].digest, digest) {
      let sealed = entries[at].sealed
      let claims = entries[at].claims
      let paths = run copyPaths(List<Bytes>.asSlice(&entries[at].paths))
      List<bool>.set(&mut self.used, at, true)
      return Option<Summary>.some(Summary {digest: digest, sealed: sealed, claims: claims, paths: move paths})
    }
    at = InternIndex.after(&self.lookup, at)
  }
  return Option<Summary>.none()
}

effect fn copyPaths(paths: &[Bytes]) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < paths.length {
    run List<Bytes>.append(&mut copied, run Bytes.copy(Bytes.asSlice(&paths[at])))
    at = at + usize.ONE
  }
  return move copied
}

/// Records the summary of a file whose bytes have digest `digest`.
pub effect fn add(self: &mut ImportSummaries, digest: ContentHash, sealed: bool, claims: bool, paths: &[Bytes]) -> () ! OutOfMemoryError ? &mut Allocator {
  let copied = run copyPaths(paths)
  // Reserve the data slot before publishing its matching index ordinal.
  if List<Summary>.length(&self.entries) == List<Summary>.capacity(&self.entries) {
    run List<Summary>.reserve(&mut self.entries, usize.ONE)
  }
  run InternIndex.record(&mut self.lookup, digest.low)
  run List<Summary>.append(&mut self.entries, Summary {digest: digest, sealed: sealed, claims: claims, paths: move copied})
  run List<bool>.append(&mut self.used, true)
  self.added = true
}

/// Whether the summaries this load used differ from the ones it read: some were added, or some
/// that were read went unused.
pub fn changed(self: &ImportSummaries) -> bool {
  if self.added { return true }
  let used = List<bool>.asSlice(&self.used)
  let mut at = usize.ZERO
  while at < used.length {
    if !used[at] { return true }
    at = at + usize.ONE
  }
  return false
}

/// The bytes of the summaries this load used, which [`decode`] reads back.
pub effect fn encode(self: &ImportSummaries) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let entries = List<Summary>.asSlice(&self.entries)
  let used = List<bool>.asSlice(&self.used)
  let mut kept: u64 = 0
  let mut at = usize.ZERO
  while at < used.length {
    if used[at] { kept = kept + 1 }
    at = at + usize.ONE
  }
  let mut output = Bytes.make()
  run Encoding.word(&mut output, FORMAT)
  run Encoding.field(&mut output, Bytes.asSlice(&self.compiler))
  run Encoding.word(&mut output, self.catalog.high)
  run Encoding.word(&mut output, self.catalog.low)
  run Encoding.word(&mut output, kept)
  at = usize.ZERO
  while at < entries.length {
    if used[at] {
      run Encoding.word(&mut output, entries[at].digest.high)
      run Encoding.word(&mut output, entries[at].digest.low)
      if entries[at].sealed { run Encoding.word(&mut output, 1) } else { run Encoding.word(&mut output, 0) }
      if entries[at].claims { run Encoding.word(&mut output, 1) } else { run Encoding.word(&mut output, 0) }
      let paths = List<Bytes>.asSlice(&entries[at].paths)
      run Encoding.word(&mut output, usize.toU64(paths.length))
      let mut pathAt = usize.ZERO
      while pathAt < paths.length {
        run Encoding.field(&mut output, Bytes.asSlice(&paths[pathAt]))
        pathAt = pathAt + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return move output
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}
