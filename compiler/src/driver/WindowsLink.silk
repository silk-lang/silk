//! The Windows executable's SDK-free import libraries and console link options.

import driver.NativeToolchain
import silk.io.writer_native {StderrWriter}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.system.filesystem {FileSystem, FileError, Path}
import silk.system.host_input {HostInput, HostInputError}
import silk.system.child_process {ChildProcess, ProcessRequest, ProcessError}
import silk.io.writer {Writer, WriterError}
import silk.collections.bytes {Bytes}
import silk.text.string {String}

// Only the current runtime's imports and the backend's memory/probe helpers belong here. LLVM
// generates each import archive from these definitions; no SDK or redistributable library is read.
fn kernel32() -> string<'static> {
  return """
    LIBRARY kernel32.dll
    EXPORTS
      ExitProcess
      GetProcessHeap
      HeapAlloc
      HeapReAlloc
      HeapFree
      GetStdHandle
      GetConsoleMode
      GetLastError
      WriteFile
      WriteConsoleW
      GetCommandLineW
      GetEnvironmentStringsW
      FreeEnvironmentStringsW
      CompareStringOrdinal
      GetCurrentDirectoryW
    """
}

fn ntdll() -> string<'static> {
  return """
    LIBRARY ntdll.dll
    EXPORTS
      memcpy
      memmove
      memset
      memcmp
      __chkstk
    """
}

/// Adds the Windows console entry and disables all implicit C runtime libraries.
/// The linker is the `lld-link` beside `clang`; no Windows SDK is searched.
pub effect fn configure(process: &mut ProcessRequest, clang: &Path) -> ()
! FileError | OutOfMemoryError ? &mut Allocator {
  let linker = run NativeToolchain.companion(clang, "lld-link")
  let mut selection = run Bytes.copy(b"--ld-path=")
  run Bytes.append(&mut selection, Path.rawBytes(&linker))
  run ChildProcess.addArgumentBytes(&mut process.*, Bytes.asSlice(&selection))
  run ChildProcess.addArgument(&mut process.*, "--target=x86_64-pc-windows-msvc")
  run ChildProcess.addArgument(&mut process.*, "-nostdlib")
  run ChildProcess.addArgument(&mut process.*, "-Wl,/nodefaultlib,/subsystem:console,/entry:mainCRTStartup")
}

effect fn library(process: &mut ProcessRequest, clang: &Path, scratch: &Path, name: string, definition: string) -> i32
! FileError | HostInputError | ProcessError | OutOfMemoryError | WriterError
? &mut FileSystem | &mut HostInput | &mut ChildProcess | &mut Allocator {
  let mut stem = run Bytes.copy(String.utf8Bytes(name))
  run Bytes.append(&mut stem, b".def")
  let source = run Path.joinBytes(scratch, Bytes.asSlice(&stem))
  stem = run Bytes.copy(String.utf8Bytes(name))
  run Bytes.append(&mut stem, b".lib")
  let archive = run Path.joinBytes(scratch, Bytes.asSlice(&stem))
  run FileSystem.writeFile(&source, String.utf8Bytes(definition))
  let dlltool = run NativeToolchain.companion(clang, "llvm-dlltool")
  let mut request = run NativeToolchain.request(&dlltool)
  run ChildProcess.addArgument(&mut request, "-m")
  run ChildProcess.addArgument(&mut request, "i386:x86-64")
  run ChildProcess.addArgument(&mut request, "-d")
  run ChildProcess.addArgumentBytes(&mut request, Path.rawBytes(&source))
  run ChildProcess.addArgument(&mut request, "-l")
  run ChildProcess.addArgumentBytes(&mut request, Path.rawBytes(&archive))
  let result = run ChildProcess.submit(&request)
  let mut stderr = StderrWriter.make()
  run Writer.writeAll(ChildProcess.errorBytes(&result)) |> Effect.provideMut<Writer>(&mut stderr)
  let status = Option<i32>.unwrapOr(ChildProcess.exitCode(&result), 2)
  if status == 0 { run ChildProcess.addArgumentBytes(&mut process.*, Path.rawBytes(&archive)) }
  return status
}

/// Writes and builds the minimal import libraries in the build's private scratch directory.
/// Adds each successful archive to `process` and returns the first failed tool's exit status.
pub effect fn prepare(process: &mut ProcessRequest, clang: &Path, scratch: &Path) -> i32
! FileError | HostInputError | ProcessError | OutOfMemoryError | WriterError
? &mut FileSystem | &mut HostInput | &mut ChildProcess | &mut Allocator {
  let status = run library(&mut process.*, clang, scratch, "kernel32", kernel32())
  if status != 0 { return status }
  return run library(&mut process.*, clang, scratch, "ntdll", ntdll())
}
