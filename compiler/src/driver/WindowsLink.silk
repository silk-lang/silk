//! The Windows executable's SDK-free import libraries and console link options.

import driver.NativeToolchain
import silk.io.writer_native {StderrWriter}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.system.filesystem {FileSystem, FileError, Path}
import silk.system.host_input {HostInput, HostInputError}
import silk.system.child_process {ChildProcess, ProcessRequest, ProcessError}
import silk.io.writer {Writer, WriterError}
import silk.collections.bytes {Bytes}
import silk.text.string {String}

// Only the current runtime's imports and the backend's memory/probe helpers belong here. LLVM
// generates each import archive from these definitions; no SDK or redistributable library is read.
fn kernel32() -> string<'static> {
  return """
    LIBRARY kernel32.dll
    EXPORTS
      ExitProcess
      GetProcessHeap
      HeapAlloc
      HeapReAlloc
      HeapFree
      GetStdHandle
      GetConsoleMode
      GetLastError
      WriteFile
      WriteConsoleW
      GetCommandLineW
      GetEnvironmentStringsW
      FreeEnvironmentStringsW
      SetEnvironmentVariableW
      CompareStringOrdinal
      GetCurrentDirectoryW
      QueryPerformanceCounter
      QueryPerformanceFrequency
      GetSystemTimePreciseAsFileTime
      ReadFile
      Sleep
      CreateThread
      WaitForSingleObject
      CloseHandle
      SwitchToThread
      GetActiveProcessorCount
      InitOnceBeginInitialize
      InitOnceComplete
      InitializeCriticalSectionEx
      EnterCriticalSection
      LeaveCriticalSection
      WaitForMultipleObjects
      CreateEventW
      ResetEvent
      CreateNamedPipeW
      ConnectNamedPipe
      CreateFileW
      GetOverlappedResult
      CancelIoEx
      InitializeProcThreadAttributeList
      DeleteProcThreadAttributeList
      UpdateProcThreadAttribute
      CreateProcessW
      CreateJobObjectW
      SetInformationJobObject
      AssignProcessToJobObject
      ResumeThread
      TerminateProcess
      GetExitCodeProcess
    """
}

fn ntdll() -> string<'static> {
  return """
    LIBRARY ntdll.dll
    EXPORTS
      memcpy
      memmove
      memset
      memcmp
      __chkstk
      RtlCaptureStackBackTrace
      RtlLookupFunctionEntry
      NtCreateFile
      NtClose
      NtQueryInformationFile
      NtQueryVolumeInformationFile
      NtSetInformationFile
      NtReadFile
      NtWriteFile
      NtQueryDirectoryFile
    """
}

fn bcryptprimitives() -> string<'static> {
  return """
    LIBRARY bcryptprimitives.dll
    EXPORTS
      ProcessPrng
    """
}

fn synchronization() -> string<'static> {
  return """
    LIBRARY api-ms-win-core-synch-l1-2-0.dll
    EXPORTS
      WaitOnAddress
      WakeByAddressSingle
      WakeByAddressAll
    """
}

/// Adds the Windows console entry and disables all implicit C runtime libraries.
/// The linker is the `lld-link` beside `clang`; no Windows SDK is searched.
pub effect fn configure(process: &mut ProcessRequest, clang: &Path) -> ()
! FileError | OutOfMemoryError ? &mut Allocator {
  let directory = match move run Path.parent(clang) {
    Option<Path>.Some {value} => move value
    Option<Path>.None => run Path.make("/")
  }
  // The MSVC driver ignores --ld-path. Its tool-prefix search and lld selection work on both
  // LLVM hosts and locate lld-link beside the explicitly selected compiler.
  run ChildProcess.addArgument(&mut process.*, "-B")
  run ChildProcess.addArgumentBytes(&mut process.*, Path.rawBytes(&directory))
  run ChildProcess.addArgument(&mut process.*, "-fuse-ld=lld")
  run ChildProcess.addArgument(&mut process.*, "--target=x86_64-pc-windows-msvc")
  run ChildProcess.addArgument(&mut process.*, "-nostdlib")
  run ChildProcess.addArgument(&mut process.*, "-Wl,/nodefaultlib,/subsystem:console,/entry:mainCRTStartup,/include:_tls_used,/stack:8388608")
}

/// The PE loader's static TLS directory and writable module-index slot, without CRT startup.
/// LLVM's thread-local definitions lie between `.tls` and `.tls$ZZZ`. The null callback array
/// requests no dynamic initialization. The linker must retain `_tls_used` with `/include`.
pub fn tlsSource() -> string<'static> {
  return """
    #pragma section(".tls", long, read, write)
    #pragma section(".tls$ZZZ", long, read, write)
    #pragma section(".rdata$T", long, read)
    #pragma section(".silk$A", read, write)
    #pragma section(".silk$Z", read, write)
    __declspec(allocate(".silk$A")) const void *__start_silk_frames[2] = {0, 0};
    __declspec(allocate(".silk$Z")) const void *__stop_silk_frames[2] = {0, 0};
    int _fltused = 0;
    static void *stderr_once = 0;
    static __declspec(align(8)) unsigned char stderr_lock[40] = {0};
    void *const __silk_stderr_once = &stderr_once;
    void *const __silk_stderr_lock = stderr_lock;
    unsigned long _tls_index = 0xffffffffUL;
    __declspec(allocate(".tls")) void *_tls_start = 0;
    __declspec(allocate(".tls$ZZZ")) void *_tls_end = 0;
    static const void *tls_callbacks[] = {0};
    struct SilkTlsDirectory {
      void *start;
      void *end;
      unsigned long *index;
      const void **callbacks;
      unsigned long zero_fill;
      unsigned long characteristics;
    };
    __declspec(allocate(".rdata$T")) const struct SilkTlsDirectory _tls_used = {
      &_tls_start, &_tls_end, &_tls_index, tls_callbacks, 0, 0
    };
    """
}

effect fn tls(process: &mut ProcessRequest, clang: &Path, scratch: &Path) -> i32
! FileError | HostInputError | ProcessError | OutOfMemoryError | WriterError
? &mut FileSystem | &mut HostInput | &mut ChildProcess | &mut Allocator {
  let source = run Path.join(scratch, "silk-tls.c")
  let object = run Path.join(scratch, "silk-tls.obj")
  run FileSystem.writeFile(&source, String.utf8Bytes(tlsSource()))
  let mut request = run NativeToolchain.request(clang)
  run ChildProcess.addArgument(&mut request, "--target=x86_64-pc-windows-msvc")
  run ChildProcess.addArgument(&mut request, "-ffreestanding")
  run ChildProcess.addArgument(&mut request, "-fno-stack-protector")
  run ChildProcess.addArgument(&mut request, "-c")
  run ChildProcess.addArgumentBytes(&mut request, Path.rawBytes(&source))
  run ChildProcess.addArgument(&mut request, "-o")
  run ChildProcess.addArgumentBytes(&mut request, Path.rawBytes(&object))
  let result = run ChildProcess.submit(&request)
  let mut stderr = StderrWriter.make()
  run Writer.writeAll(ChildProcess.errorBytes(&result)) |> Effect.provideMut<Writer>(&mut stderr)
  let status = Option<i32>.unwrapOr(ChildProcess.exitCode(&result), 2)
  if status == 0 { run ChildProcess.addArgumentBytes(&mut process.*, Path.rawBytes(&object)) }
  return status
}

effect fn library(process: &mut ProcessRequest, clang: &Path, scratch: &Path, name: string, definition: string) -> i32
! FileError | HostInputError | ProcessError | OutOfMemoryError | WriterError
? &mut FileSystem | &mut HostInput | &mut ChildProcess | &mut Allocator {
  let mut stem = run Bytes.copy(String.utf8Bytes(name))
  run Bytes.append(&mut stem, b".def")
  let source = run Path.joinBytes(scratch, Bytes.asSlice(&stem))
  stem = run Bytes.copy(String.utf8Bytes(name))
  run Bytes.append(&mut stem, b".lib")
  let archive = run Path.joinBytes(scratch, Bytes.asSlice(&stem))
  run FileSystem.writeFile(&source, String.utf8Bytes(definition))
  let dlltool = run NativeToolchain.companion(clang, "llvm-dlltool")
  let mut request = run NativeToolchain.request(&dlltool)
  run ChildProcess.addArgument(&mut request, "-m")
  run ChildProcess.addArgument(&mut request, "i386:x86-64")
  run ChildProcess.addArgument(&mut request, "-d")
  run ChildProcess.addArgumentBytes(&mut request, Path.rawBytes(&source))
  run ChildProcess.addArgument(&mut request, "-l")
  run ChildProcess.addArgumentBytes(&mut request, Path.rawBytes(&archive))
  let result = run ChildProcess.submit(&request)
  let mut stderr = StderrWriter.make()
  run Writer.writeAll(ChildProcess.errorBytes(&result)) |> Effect.provideMut<Writer>(&mut stderr)
  let status = Option<i32>.unwrapOr(ChildProcess.exitCode(&result), 2)
  if status == 0 { run ChildProcess.addArgumentBytes(&mut process.*, Path.rawBytes(&archive)) }
  return status
}

/// Writes and builds the minimal import libraries in the build's private scratch directory.
/// Adds each successful archive to `process` and returns the first failed tool's exit status.
pub effect fn prepare(process: &mut ProcessRequest, clang: &Path, scratch: &Path) -> i32
! FileError | HostInputError | ProcessError | OutOfMemoryError | WriterError
? &mut FileSystem | &mut HostInput | &mut ChildProcess | &mut Allocator {
  let supported = run tls(&mut process.*, clang, scratch)
  if supported != 0 { return supported }
  let status = run library(&mut process.*, clang, scratch, "kernel32", kernel32())
  if status != 0 { return status }
  let nativeStatus = run library(&mut process.*, clang, scratch, "ntdll", ntdll())
  if nativeStatus != 0 { return nativeStatus }
  let randomStatus = run library(&mut process.*, clang, scratch, "bcryptprimitives", bcryptprimitives())
  if randomStatus != 0 { return randomStatus }
  return run library(&mut process.*, clang, scratch, "synchronization", synchronization())
}
