//! Validation of component WIT selection in package manifests.
import driver.Project as Projects {Project, ProjectError}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.system.filesystem {FileError, Path}
import silk.core.result {Result}
import silk.testing.testing {AssertionError, Testing}
fn same(left: &[u8], right: &[u8]) -> bool {
 if left.length != right.length { return false }
 let mut at: usize = 0
 while at < left.length { if left[at] != right[at] { return false } at = at + 1 }
 return true
}
// Whether `text` is refused as an invalid manifest.
effect fn refused(manifest: &Path, text: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let decoded = run Effect.result(Projects.decode(manifest, text))
  return match move decoded {
    Result<Project, ProjectError | OutOfMemoryError>.Success { value: _ } => false
    Result<Project, ProjectError | OutOfMemoryError>.Failure { error } => match move error {
      ProjectError problem => match move problem {
        ProjectError.InvalidManifest { .. } => true
        _ => false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}


test effect fn componentWorldManifestRequiresContainedWitAndNamedWorld() -> ()
! FileError | ProjectError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let manifest = run Path.make("/work/component/silk.toml") |> Effect.provideMut<Allocator>(&mut allocator)
  let base = b"[package]\nname=\"component\"\nsource=\".\"\n"
  let valid = b"[package]\nname=\"component\"\nsource=\".\"\n[component]\nwit=\"wit/world.wit\"\nworld=\"calculator\"\n"
  let project = run Projects.decode(&manifest, valid) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(same(Projects.name(&project), b"component"), "a WIT file and named world are accepted")
  let invalid = [
    b"[component]\nwit=\"../outside\"\nworld=\"calculator\"\n",
    b"[component]\nwit=\"/absolute\"\nworld=\"calculator\"\n",
    b"[component]\nwit=\"wit\"\nworld=\"\"\n",
    b"[component]\nwit=\"wit\"\n",
    b"[component]\nworld=\"calculator\"\n",
    b"[component]\nwit=\"wit\"\nworld=\"calculator\"\nunknown=true\n"
  ]
  let mut at: usize = 0
  while at < invalid.length {
    let mut text = run Bytes.copy(base) |> Effect.provideMut<Allocator>(&mut allocator)
    run Bytes.append(&mut text, invalid[at]) |> Effect.provideMut<Allocator>(&mut allocator)
    let rejected = run refused(&manifest, Bytes.asSlice(&text)) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(rejected, "invalid WIT selection is an InvalidManifest error")
    at = at + 1
  }
}
