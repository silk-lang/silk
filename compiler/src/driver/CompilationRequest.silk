//! Convert schema-validated compilation requests into compiler inputs without filesystem discovery.

import silk.build.request { Request, ParameterValue, Wasm }
import semantic.InitialProfile { InitialProfile, Input, Selection, Problem, ProblemKind, Field }
import semantic.ProfileBinding {
  Supplied,
  Provenance,
  Tier,
  Input as BindingInput,
  Field as BindingField
}
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.box { Box }
import silk.text.string { String }
import semantic.Target { Target }
import silk.num.usize

/// Freezes the program-wide source facts of an explicit request.
pub effect fn profile(request: &Request) -> InitialProfile
  ! Problem | OutOfMemoryError
  ? &mut Allocator {
  let supplied = &request.profile
  let mut input = Input.make()
  input.target = Option<Bytes>.some(run text(&supplied.target))
  input.cpu = run optional(&supplied.cpu)
  input.cpuFeatures = run texts(&supplied.cpuFeatures)
  input.deployment = run optional(&supplied.deployment)
  input.libc = Option<Bytes>.some(run text(&supplied.libc))
  if request.artifact.view() == "test" {
    input.artifact = Option<Bytes>.some(run Bytes.copy(b"executable"))
  } else {
    input.artifact = Option<Bytes>.some(run text(&request.artifact))
  }
  input.entry = run selection(&supplied.entry)
  input.runtime = run selection(&supplied.runtime)
  if let Option<Wasm>.Some { value } = &request.wasm {
    if value.executionModel.view() == "reactor" {
      if supplied.runtime.view() == "default" {
        input.runtime = Selection.None
      }
      if supplied.entry.view() == "default" {
        input.entry = Selection.None
      }
    }
  }
  input.link = Option<Bytes>.some(run text(&supplied.link))
  input.codeModel = Option<Bytes>.some(run text(&supplied.codeModel))
  input.relocation = Option<Bytes>.some(run text(&supplied.relocation))
  input.optimization = Option<Bytes>.some(run text(&supplied.optimization))
  input.debug = Option<bool>.some(supplied.debug)
  input.safety = Option<Bytes>.some(run text(&supplied.safety))
  input.threading = Option<Bytes>.some(run text(&supplied.threading))
  input.sanitizers = run texts(&supplied.sanitizers)
  input.unwind = Option<Bytes>.some(run text(&supplied.unwind))
  input.backend = Option<Bytes>.some(run text(&supplied.backend))
  input.codegenUnits = supplied.codegenUnits
  return run freeze(&input)
}

effect fn text(value: &String) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  return run Bytes.copy(String.ownedUtf8Bytes(value))
}

effect fn optional(value: &Option<String>) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value.* {
    Option<String>.Some { value: present } => Option<Bytes>.some(run text(&present))
    Option<String>.None => Option<Bytes>.none()
  }
}

effect fn texts(values: &List<String>) -> List<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = List<Bytes>.make()
  let listed = values.asSlice()
  let mut at = usize.ZERO
  while at < listed.length {
    run result.append(run text(&listed[at]))
    at = at + usize.ONE
  }
  return move result
}

effect fn selection(value: &String) -> Selection
  ! OutOfMemoryError
  ? &mut Allocator {
  if value.view() == "default" {
    return Selection.Default
  }
  if value.view() == "none" {
    return Selection.None
  }
  return Selection.Named { name: run text(value) }
}

/// Converts each resolved parameter into its exact typed binding. No source-visible backend overrides are added.
pub effect fn bindings(request: &Request) -> List<Supplied>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = List<Supplied>.make()
  let packages = request.packages.asSlice()
  let mut at = usize.ZERO
  while at < packages.length {
    let package = &packages[at]
    let mut identity = run text(&package.name)
    run identity.append(b"@")
    run identity.append(String.ownedUtf8Bytes(&package.version))
    let parameters = package.parameters.asSlice()
    let mut parameter = usize.ZERO
    while parameter < parameters.length {
      let supplied = &parameters[parameter]
      run result.append(
        Supplied {
          package: run Bytes.copy(identity.asSlice()),
          module: run text(&supplied.module),
          parameter: run text(&supplied.name),
          value: run bindingValue(&supplied.value),
          provenance: Provenance.Literal,
          tier: Tier.Override,
        },
      )
      parameter = parameter + usize.ONE
    }
    at = at + usize.ONE
  }
  return move result
}

/// Converts a typed request parameter into the compiler's binding representation.
pub effect fn bindingValue(input: &ParameterValue) -> BindingInput
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &input.* {
    ParameterValue.Text { value } => BindingInput.String { text: run text(&value) }
    ParameterValue.Boolean { value } => BindingInput.Boolean { value: value }
    ParameterValue.Integer { decimal } => BindingInput.Integer { decimal: run text(&decimal) }
    ParameterValue.Enum { nominal, member } => BindingInput.Enum {
      nominal: run text(&nominal),
      member: run text(&member),
    }
    ParameterValue.None => BindingInput.None
    ParameterValue.Some { value } => BindingInput.Some {
      value: run Box<BindingInput>.make(run bindingValue(&Box<ParameterValue>.get(&value)[0])),
    }
    ParameterValue.Sequence { values } => {
      let mut items = List<Box<BindingInput>>.make()
      let listed = values.asSlice()
      let mut at = usize.ZERO
      while at < listed.length {
        run items.append(run Box<BindingInput>.make(run bindingValue(&listed[at])))
        at = at + usize.ONE
      }
      BindingInput.Array { values: move items }
    }
    ParameterValue.Record { fields } => {
      let mut items = List<BindingField>.make()
      let listed = fields.asSlice()
      let mut at = usize.ZERO
      while at < listed.length {
        run items.append(
          BindingField {
            name: run text(&listed[at].name),
            value: run Box<BindingInput>.make(run bindingValue(&listed[at].value)),
          },
        )
        at = at + usize.ONE
      }
      BindingInput.Record { fields: move items }
    }
  }
}

/// Rejects source settings the current backend cannot implement before selecting native tools.
pub effect fn freeze(input: &Input) -> InitialProfile
  ! Problem | OutOfMemoryError
  ? &mut Allocator {
  let profile = run InitialProfile.freeze(input)
  if input.sanitizers.length() > 0 {
    fail Problem { kind: ProblemKind.UnsupportedCombination, field: Field.Sanitizers }
  }
  if matches(&input.unwind, b"native") {
    fail Problem { kind: ProblemKind.UnsupportedCombination, field: Field.Unwind }
  }
  if matches(&input.safety, b"unchecked") {
    fail Problem { kind: ProblemKind.UnsupportedCombination, field: Field.Safety }
  }
  let target = InitialProfile.target(&profile)
  let format = Target.objectFormat(target)
  if matches(&input.threading, b"multi") && !same(format, b"wasm") {
    fail Problem { kind: ProblemKind.UnsupportedCombination, field: Field.Threading }
  }
  if matches(&input.codeModel, b"large") && !same(Target.architecture(target), b"x86_64") {
    fail Problem { kind: ProblemKind.UnsupportedCombination, field: Field.CodeModel }
  }
  return move profile
}

fn matches(value: &Option<Bytes>, expected: &[u8]) -> bool {
  return match &value.* {
    Option<Bytes>.Some { value: written } => same(written.asSlice(), expected)
    Option<Bytes>.None => false
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + 1
  }
  return true
}
