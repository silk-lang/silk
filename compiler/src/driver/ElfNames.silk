//! Gives the functions of a linked ELF executable readable names in its symbol table.
//!
//! # When to use
//! A build of an ELF executable calls [`rename`] on the linked file before it is published.
//! Profilers and disassemblers such as perf, callgrind and objdump name a function by its `.symtab`
//! entry, so a frame then reads the declaration's name instead of a content-derived symbol.
//!
//! # Details
//! Symbols stay content-derived while the program is compiled and linked, so objects, the codegen
//! cache and `[native].function-order` do not change; only the linked file's static symbol table is
//! rewritten. Its string table is rebuilt with each listed symbol's name in place of the symbol and
//! every other name unchanged, the symbols' name offsets follow, and the new table and the section
//! headers replace the old ones at the end of the file. Loaded memory is untouched: the static
//! symbol table and its strings are never loaded, and the dynamic symbol table keeps its names.
import driver.WasmNames {FunctionNames}
import semantic.InternIndex {InternIndex}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.collections.slice {Slice}
import silk.num.u8
import silk.num.usize

const sectionHeaderSize: usize = 64
const symbolSize: usize = 24
const symbolTableType: usize = 2
const stringTableType: usize = 3
const noBitsType: usize = 8

// The little-endian number of `width` bytes at `at`.
fn number(bytes: &[u8], at: usize, width: usize) -> usize {
  let mut value = usize.ZERO
  let mut index = width
  while index > usize.ZERO {
    index = index - usize.ONE
    value = usize.shiftLeft(value, 8) | u8.toUsize(bytes[at + index])
  }
  return value
}

// Writes `value` as `width` little-endian bytes at `at`.
fn store(bytes: &mut [u8], at: usize, width: usize, value: usize) -> () {
  let mut rest = value
  let mut index = usize.ZERO
  while index < width {
    bytes[at + index] = usize.toU8(rest & 255)
    rest = usize.shiftRight(rest, 8)
    index = index + usize.ONE
  }
}

// Whether `length` bytes from `start` lie within `total` bytes.
fn within(start: usize, length: usize, total: usize) -> bool {
  return start <= total && length <= total - start
}

// The table of names the symbols point into, each name stored once.
struct Strings {
  bytes: Bytes,
  offsets: List<usize>,
  index: InternIndex,
}

// The offset of `name` in `strings`, appending it with its terminating NUL the first time.
effect fn intern(strings: &mut Strings, name: &[u8]) -> usize ! OutOfMemoryError ? &mut Allocator {
  let hash = InternIndex.hashBytes(0, name)
  let offsets = List<usize>.asSlice(&strings.offsets)
  let mut at = InternIndex.first(&strings.index, hash)
  while at != usize.MAX {
    let offset = offsets[at]
    let stored = Bytes.asSlice(&strings.bytes)
    if within(offset, name.length + usize.ONE, stored.length) && stored[offset + name.length] == 0
      && same(Slice.view<u8>(stored, offset, name.length), name) {
      return offset
    }
    at = InternIndex.after(&strings.index, at)
  }
  let offset = Bytes.length(&strings.bytes)
  run InternIndex.record(&mut strings.index, hash)
  run List<usize>.append(&mut strings.offsets, offset)
  run Bytes.append(&mut strings.bytes, name)
  run Bytes.append(&mut strings.bytes, &[0])
  return offset
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

/// The 64-bit little-endian ELF file `image` with every static symbol `names` lists renamed, or
/// none when `image` is not such a file, has no static symbol table, shares that table's strings
/// with another section, or lists none of the symbols.
///
/// # Details
/// A symbol LLVM split off or promoted from a listed one, such as `silk_1f3a.cold.1` or
/// `silk_1f3a.llvm.42`, takes the listed name with its suffix kept. A symbol whose name `names` does
/// not list keeps its name, and the section header string table
/// and the dynamic symbol table are not touched. When the string table and the section headers end
/// the file, as a linker lays them out, the rebuilt table and headers replace them there; otherwise
/// they are appended and the old ones are left unreferenced.
pub effect fn rename(image: &[u8], names: &FunctionNames) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  if image.length < 64 || image[0] != 127 || image[1] != 69 || image[2] != 76 || image[3] != 70 || image[4] != 2 || image[5] != 1 {
    return Option<Bytes>.none()
  }
  let headers = number(image, 40, 8)
  let headerSize = number(image, 58, 2)
  let count = number(image, 60, 2)
  let sectionNames = number(image, 62, 2)
  if headerSize != sectionHeaderSize || count == usize.ZERO || !within(headers, count * sectionHeaderSize, image.length) {
    return Option<Bytes>.none()
  }
  let mut symbols = usize.MAX
  let mut section = usize.ZERO
  while section < count {
    if number(image, headers + section * sectionHeaderSize + 4, 4) == symbolTableType {
      symbols = section
      break
    }
    section = section + usize.ONE
  }
  if symbols == usize.MAX { return Option<Bytes>.none() }
  let symbolHeader = headers + symbols * sectionHeaderSize
  let strings = number(image, symbolHeader + 40, 4)
  if strings == usize.ZERO || strings >= count || strings == sectionNames { return Option<Bytes>.none() }
  let stringHeader = headers + strings * sectionHeaderSize
  if number(image, stringHeader + 4, 4) != stringTableType { return Option<Bytes>.none() }
  section = usize.ZERO
  while section < count {
    if section != symbols && number(image, headers + section * sectionHeaderSize + 40, 4) == strings {
      return Option<Bytes>.none()
    }
    section = section + usize.ONE
  }
  let symbolStart = number(image, symbolHeader + 24, 8)
  let symbolLength = number(image, symbolHeader + 32, 8)
  let stringStart = number(image, stringHeader + 24, 8)
  let stringLength = number(image, stringHeader + 32, 8)
  if number(image, symbolHeader + 56, 8) != symbolSize || symbolLength % symbolSize != usize.ZERO
    || !within(symbolStart, symbolLength, image.length) || !within(stringStart, stringLength, image.length) {
    return Option<Bytes>.none()
  }
  let oldStrings = Slice.view<u8>(image, stringStart, stringLength)
  let mut table = Strings {bytes: run Bytes.copy(&[0]), offsets: List<usize>.make(), index: InternIndex.make()}
  let mut offsets = List<usize>.make()
  let mut renamed = usize.ZERO
  let mut entry = usize.ZERO
  while entry < symbolLength / symbolSize {
    let nameAt = number(image, symbolStart + entry * symbolSize, 4)
    let mut offset = usize.ZERO
    if nameAt != usize.ZERO {
      if nameAt >= oldStrings.length { return Option<Bytes>.none() }
      let mut end = nameAt
      while end < oldStrings.length && oldStrings[end] != 0 { end = end + usize.ONE }
      if end == oldStrings.length { return Option<Bytes>.none() }
      let written = Slice.view<u8>(oldStrings, nameAt, end - nameAt)
      // A part LLVM split off or promoted from a function keeps its suffix, `silk_1f3a.cold.1`.
      let mut stem = usize.ZERO
      while stem < written.length && written[stem] != '.' { stem = stem + usize.ONE }
      if let Option<&[u8]>.Some {value} = move FunctionNames.lookup(names, Slice.view<u8>(written, usize.ZERO, stem)) {
        let mut readable = run Bytes.copy(value)
        run Bytes.append(&mut readable, Slice.view<u8>(written, stem, written.length - stem))
        offset = run intern(&mut table, Bytes.asSlice(&readable))
        renamed = renamed + usize.ONE
      } else {
        offset = run intern(&mut table, written)
      }
    }
    run List<usize>.append(&mut offsets, offset)
    entry = entry + usize.ONE
  }
  if renamed == usize.ZERO { return Option<Bytes>.none() }
  // The old string table and section headers can be replaced in place when nothing else lies at
  // or after the earlier of the two.
  let mut tail = stringStart
  if headers < tail { tail = headers }
  let mut end = stringStart + stringLength
  if headers + count * sectionHeaderSize > end { end = headers + count * sectionHeaderSize }
  let mut replaceable = end == image.length
  let programHeaders = number(image, 32, 8)
  if programHeaders + number(image, 54, 2) * number(image, 56, 2) > tail { replaceable = false }
  section = usize.ZERO
  while section < count {
    let header = headers + section * sectionHeaderSize
    let length = number(image, header + 32, 8)
    if section != strings && number(image, header + 4, 4) != noBitsType && length > usize.ZERO
      && number(image, header + 24, 8) + length > tail {
      replaceable = false
    }
    section = section + usize.ONE
  }
  let mut kept = image.length
  if replaceable { kept = tail }
  let mut output = run Bytes.copy(Slice.view<u8>(image, usize.ZERO, kept))
  let newStrings = Bytes.length(&output)
  run Bytes.append(&mut output, Bytes.asSlice(&table.bytes))
  while Bytes.length(&output) % 8 != usize.ZERO { run Bytes.append(&mut output, &[0]) }
  let newHeaders = Bytes.length(&output)
  run Bytes.append(&mut output, Slice.view<u8>(image, headers, count * sectionHeaderSize))
  let stringsLength = Bytes.length(&table.bytes)
  store(Bytes.asMutSlice(&mut output), 40, 8, newHeaders)
  store(Bytes.asMutSlice(&mut output), newHeaders + strings * sectionHeaderSize + 24, 8, newStrings)
  store(Bytes.asMutSlice(&mut output), newHeaders + strings * sectionHeaderSize + 32, 8, stringsLength)
  let listed = List<usize>.asSlice(&offsets)
  entry = usize.ZERO
  while entry < listed.length {
    store(Bytes.asMutSlice(&mut output), symbolStart + entry * symbolSize, 4, listed[entry])
    entry = entry + usize.ONE
  }
  return Option<Bytes>.some(move output)
}
