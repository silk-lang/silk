//! Configured native compiler invocation and its explicit host-tool environment.

import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.child_process { ChildProcess, ProcessRequest }
import silk.filesystem { FileError, Path }
import silk.host_input { HostInput, HostInputError }
import silk.option { Option }
import silk.string { String }
import silk.usize

/// Starts a Clang request with the configured executable and standard tool environment.
///
/// ChildProcess requests intentionally start with an empty environment. Clang needs PATH to
/// locate the platform linker; temporary-directory, home and locale variables retain the same
/// explicit allowlist as the native-generation harness. Compiler flags and other tool overrides
/// are not inherited.
pub effect fn request() -> ProcessRequest
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let configured = run HostInput.variableNamed("SILKC_CLANG")
  let clang = match move configured {
    Option<Bytes>.Some { value } => run Path.fromBytes(Bytes.asSlice(&value))
    Option<Bytes>.None => run Path.make("/usr/bin/clang")
  }
  let mut process = run ChildProcess.request(&clang)
  let entries = ["PATH", "HOME", "TMPDIR", "TMP", "TEMP", "LANG", "LC_ALL", "LC_CTYPE"]
  let names: &[string<'static>] = &entries
  let mut at = usize.ZERO
  while at < names.length {
    let name = names[at]
    let captured = run HostInput.variableNamed(name)
    match move captured {
      Option<Bytes>.Some { value } => {
        run ChildProcess.setVariable(&mut process, String.utf8Bytes(name), Bytes.asSlice(&value))
      }
      Option<Bytes>.None => {}
    }
    at = at + usize.ONE
  }
  return move process
}
