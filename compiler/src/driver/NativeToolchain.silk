//! Configured native compiler invocation and its explicit host-tool environment.

import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.child_process { ChildProcess, ProcessRequest }
import silk.filesystem { FileError, Path }
import silk.host_input { HostInput, HostInputError }
import silk.option { Option }
import silk.string { String }
import silk.usize

// The configured Clang executable: `SILKC_CLANG`, or else `/usr/bin/clang`.
effect fn clangPath() -> Path
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let configured = run HostInput.variableNamed("SILKC_CLANG")
  return match move configured {
    Option<Bytes>.Some { value } => run Path.fromBytes(Bytes.asSlice(&value))
    Option<Bytes>.None => run Path.make("/usr/bin/clang")
  }
}

/// Starts a Clang request with the configured executable and standard tool environment.
///
/// ChildProcess requests intentionally start with an empty environment. Clang needs PATH to
/// locate the platform linker, and SDKROOT selects the macOS SDK that supplies libc and the system
/// libraries: Apple's `xcrun` shim and an LLVM release clang both read it, and an LLVM release
/// clang has no default SDK without it. The compiler never discovers an SDK itself, so the linked
/// SDK is always an explicit input. Temporary-directory, home and locale variables retain the same
/// explicit allowlist as the native-generation harness. Compiler flags and other tool overrides
/// are not inherited.
pub effect fn request() -> ProcessRequest
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let clang = run clangPath()
  let mut process = run ChildProcess.request(&clang)
  let entries = ["PATH", "SDKROOT", "HOME", "TMPDIR", "TMP", "TEMP", "LANG", "LC_ALL", "LC_CTYPE"]
  let names: &[string<'static>] = &entries
  let mut at = usize.ZERO
  while at < names.length {
    let name = names[at]
    let captured = run HostInput.variableNamed(name)
    match move captured {
      Option<Bytes>.Some { value } => {
        run ChildProcess.setVariable(&mut process, String.utf8Bytes(name), Bytes.asSlice(&value))
      }
      Option<Bytes>.None => {}
    }
    at = at + usize.ONE
  }
  return move process
}

/// Starts an archiver request: `SILKC_AR`, or else the `llvm-ar` beside the configured Clang.
///
/// The archiver reads only its arguments, so the request carries no environment. Reading the
/// archiver beside Clang keeps one explicit LLVM installation the source of every native tool.
pub effect fn archiver() -> ProcessRequest
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let configured = run HostInput.variableNamed("SILKC_AR")
  let archive = match move configured {
    Option<Bytes>.Some { value } => run Path.fromBytes(Bytes.asSlice(&value))
    Option<Bytes>.None => {
      let clang = run clangPath()
      let directory = match move run Path.parent(&clang) {
        Option<Path>.Some { value } => move value
        Option<Path>.None => run Path.make("/")
      }
      run Path.join(&directory, "llvm-ar")
    }
  }
  return run ChildProcess.request(&archive)
}
