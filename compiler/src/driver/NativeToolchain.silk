//! Configured native compiler invocation and its explicit host-tool environment.

import driver.CommandPath
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.system.child_process { ChildProcess, ProcessRequest }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.core.option { Option }
import silk.text.string { String }
import silk.num.usize

/// The Clang executable: `selected`, the `--clang` argument, when given; else `SILK_CLANG` when it
/// is set; else the first `clang` on `PATH`. A selection with a `/` is a path, already resolved
/// against the working directory; a bare name is searched on `PATH`, as the TypeScript CLI spawns
/// its `--clang` value. `None` when no executable is named.
pub effect fn compiler(selected: Option<&[u8]>) -> Option<Path>
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut FileSystem | &mut Allocator {
  if let Option<&[u8]>.Some { value } = move selected {
    if CommandPath.contains(value, 47) {
      return Option<Path>.some(run Path.fromBytes(value))
    }
    return run onPath(value)
  }
  if let Option<Bytes>.Some { value } = move run HostInput.variableNamed("SILK_CLANG") {
    return Option<Path>.some(run Path.fromBytes(Bytes.asSlice(&value)))
  }
  return run onPath(b"clang")
}

// The first executable named `name` on `PATH`, `None` when PATH is unset or holds none.
effect fn onPath(name: &[u8]) -> Option<Path>
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut FileSystem | &mut Allocator {
  let searchPath = match move run HostInput.variableNamed("PATH") {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return Option<Path>.none()
    }
  }
  return match move run CommandPath.search(Bytes.asSlice(&searchPath), name) {
    Option<Bytes>.Some { value } => Option<Path>.some(run Path.fromBytes(Bytes.asSlice(&value)))
    Option<Bytes>.None => Option<Path>.none()
  }
}

/// Starts a Clang request for `clang` with the standard tool environment.
///
/// ChildProcess requests intentionally start with an empty environment. Clang needs PATH to
/// locate the platform linker. A macOS SDK is never ambient: `driver/PlatformSupply` resolves it
/// from SDKROOT or `xcrun` discovery and the compilation passes it as `-isysroot`, so SDKROOT is
/// not forwarded. Temporary-directory, home and locale variables retain the same explicit
/// allowlist as the native-generation harness. Compiler flags and other tool overrides are not
/// inherited.
pub effect fn request(clang: &Path) -> ProcessRequest
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let mut process = run ChildProcess.request(clang)
  let entries = ["PATH", "HOME", "TMPDIR", "TMP", "TEMP", "LANG", "LC_ALL", "LC_CTYPE"]
  let names: &[string<'static>] = &entries
  let mut at = usize.ZERO
  while at < names.length {
    let name = names[at]
    let captured = run HostInput.variableNamed(name)
    match move captured {
      Option<Bytes>.Some { value } => {
        run ChildProcess.setVariableBytes(&mut process, String.utf8Bytes(name), Bytes.asSlice(&value))
      }
      Option<Bytes>.None => {}
    }
    at = at + usize.ONE
  }
  return move process
}

/// Starts an archiver request: `SILK_LLVM_AR`, or else the `llvm-ar` beside `clang`.
///
/// The archiver reads only its arguments, so the request carries no environment. Reading the
/// archiver beside Clang keeps one explicit LLVM installation the source of every native tool.
pub effect fn archiver(clang: &Path) -> ProcessRequest
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let configured = run HostInput.variableNamed("SILK_LLVM_AR")
  if let Option<Bytes>.Some { value } = move configured {
    let named = run Path.fromBytes(Bytes.asSlice(&value))
    return run ChildProcess.request(&named)
  }
  let directory = match move run Path.parent(clang) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Path.make("/")
  }
  let beside = run Path.join(&directory, "llvm-ar")
  return run ChildProcess.request(&beside)
}
