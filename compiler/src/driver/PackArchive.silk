//! The source archive `silk pack` writes: which files of a package it holds, and its bytes.
//!
//! # Details
//! The archive is a gzip-compressed tar file named `<name>-<version>.tar.gz` whose members sit
//! below one top directory `<name>-<version>/`. It holds `silk.toml`, every file below the source
//! root, the files and directories `[package].include` names, and the `README`, `LICENSE`,
//! `LICENCE`, `COPYING` and `CHANGELOG` files at the package root. It never holds the build
//! directory or a file or directory whose name starts with `.`. A symbolic link refuses the
//! package rather than being followed. Members are written in byte order of their paths with the
//! fixed metadata of `TarWriter` and gzip's zero timestamp, so packing the same files gives the
//! same bytes and the same SHA-256 on every host.
//!
//! The archive's `silk.toml` is the package's own, except that each dependency written
//! `{ workspace = true }` is written out as the workspace's `[workspace.dependencies]` has it:
//! whoever downloads the archive has the package, not the workspace around it.
//!
//! A binary archive, one per built target of an executable, holds the executable and the files
//! that document the package. `[pack.binary]` in the manifest says a package ships them and how:
//! `format` is `tar.gz` or `zip`, `layout` is `bin` (the executable in `bin/`) or `flat` (at the
//! top), and `include` adds files and directories at their paths in the package.
//! `[pack.binary.target.<target>]` replaces any of the three for one target.

import driver.ManifestFields
import driver.ModuleSources { EmbeddedRead }
import driver.Project as Projects { Project }
import driver.WorkspaceDependencies as Workspaces { Shared }
import tomledit.ManifestEdit as ManifestEdits { ManifestEditRefused }
import silk.compress.deflate { EncodeError, EncodeWriter, Options as DeflateOptions }
import silk.compress.inflate { Format }
import silk.compress.tar { TarError, TarWriter }
import silk.compress.zip { ZipError, ZipWriter }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.mem.box { Box }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.system.filesystem {
  DirectoryEntry,
  DirectoryInfo,
  FileError,
  FileInfo,
  FileSystem,
  Path
}
import silk.text.string { String }
import silk.toml.scanner { TomlError }
import silk.toml.value { Toml, TomlChild, Value as TomlValue }
import silk.num.usize

/// Why a package cannot be packed, as a sentence such as "path dependency `shared`: an archive
/// cannot carry `../shared`; depend on it by git or url instead".
pub struct PackRefused {
  pub detail: Bytes,
}

/// What `silk pack` writes for one package: the archive's file name and bytes, and how many files
/// it holds.
pub struct Packed {
  /// `<name>-<version>`, the archive's top directory and the start of every file `silk pack`
  /// writes for the package.
  pub stem: Bytes,
  pub fileName: Bytes,
  pub bytes: Bytes,
  pub files: usize,
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn startsWith(text: &[u8], prefix: &[u8]) -> bool {
  return text.length >= prefix.length
    && same(Slice.view<u8>(text, usize.ZERO, prefix.length), prefix)
}

fn bytesBefore(left: &[u8], right: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < left.length && at < right.length {
    if left[at] != right[at] {
      return left[at] < right[at]
    }
    at = at + usize.ONE
  }
  return left.length < right.length
}

effect fn refuse(parts: &[&[u8]]) -> PackRefused
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut detail = Bytes.make()
  let mut at = usize.ZERO
  while at < parts.length {
    run Bytes.append(&mut detail, parts[at])
    at = at + usize.ONE
  }
  return PackRefused { detail: move detail }
}

fn members<'a>(value: &'a TomlValue) -> Option<&'a [TomlChild]> {
  return match &value.* {
    TomlValue.Table { entries, kind: _ } => {
      let boxed = Box<List<TomlChild>>.get(&entries)
      return Option<&'a [TomlChild]>.some(List<TomlChild>.asSlice(&boxed[0]))
    }
    _ => Option<&'a [TomlChild]>.none()
  }
}

// `entry`, a dependency whose fields are all strings, as TOML source: `{ git = "...", rev = "..." }`.
effect fn inlineTable(entry: &TomlValue) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run Bytes.copy(b"{ ")
  let mut written = usize.ZERO
  if let Option<&[TomlChild]>.Some { value: fields } = move members(entry) {
    let mut at = usize.ZERO
    while at < fields.length {
      if let TomlChild.Member { entry: field } = &fields[at] {
        if let Option<string>.Some { value } = move Toml.asString(
          Option<&TomlValue>.some(&field.value),
        ) {
          if written > usize.ZERO {
            run Bytes.append(&mut text, b", ")
          }
          run Bytes.append(&mut text, String.ownedUtf8Bytes(&field.key))
          run Bytes.append(&mut text, b" = ")
          let quoted = run ManifestEdits.quoted(String.utf8Bytes(value))
          run Bytes.append(&mut text, Bytes.asSlice(&quoted))
          written = written + usize.ONE
        }
      }
      at = at + usize.ONE
    }
  }
  run Bytes.append(&mut text, b" }")
  return move text
}

// Names of dependencies whose values come from the workspace.
effect fn inheritedDependencies(document: &TomlValue) -> List<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut names = List<Bytes>.make()
  if let Option<&TomlValue>.Some { value: dependencies } = move Toml.field(
    document,
    "dependencies",
  ) {
    if let Option<&[TomlChild]>.Some { value: children } = move members(dependencies) {
      let mut at = usize.ZERO
      while at < children.length {
        if let TomlChild.Member { entry } = &children[at] {
          if Workspaces.inherits(&entry.value) {
            run names.append(run Bytes.copy(String.ownedUtf8Bytes(&entry.key)))
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return move names
}

/// The `silk.toml` the archive of `project` holds: the package's own, with its workspace's
/// `[workspace].silk-version` written into `[package]` when the workspace pins one, and each
/// dependency written `{ workspace = true }` in `[dependencies]` replaced by the entry of the same
/// name in `[workspace.dependencies]` of the package's workspace.
///
/// # Errors
/// - `PackRefused` when no `silk-version` covers the package, it is `0.0.0`, the package sets one
///   beside its workspace's, an entry taken from the workspace has other fields, no workspace lists
///   the package, the workspace has no entry of that name, or the entry is not written on one
///   line as `name = { workspace = true }`.
/// - `FileError` when the manifest cannot be read.
pub effect fn manifestText(project: &Project) -> Bytes
  ! PackRefused | FileError | TomlError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut text = run FileSystem.readFile(Projects.manifest(project))
  let document = run Toml.parse(Bytes.asSlice(&text))
  let around = run Workspaces.of(Projects.directory(project), &Option<Path>.none())

  // The archive holds the package without its workspace, so it carries the `silk-version` that
  // covers the package, which must name the Silk the package is written for.
  let mut pin = Bytes.make()
  if let Option<&[u8]>.Some { value } = move ManifestFields.packageText(&document, "silk-version") {
    pin = run Bytes.copy(value)
  }
  if let Option<Shared>.Some { value: workspace } = &around {
    if let Option<&[u8]>.Some { value: pinned } = move ManifestFields.workspaceText(
      Workspaces.document(&workspace),
      "silk-version",
    ) {
      if Bytes.length(&pin) > usize.ZERO {
        fail run refuse(
          &[
            b"its silk-version is set by its workspace in ",
            Path.rawBytes(Workspaces.manifest(&workspace)),
            b", which covers every member; remove [package].silk-version here",
          ],
        )
      }
      let quoted = run ManifestEdits.quoted(pinned)
      text = match move run Effect.result(
        ManifestEdits.setValue(
          Bytes.asSlice(&text),
          b"package",
          b"silk-version",
          Bytes.asSlice(&quoted),
        ),
      ) {
        Result<Bytes, ManifestEditRefused | OutOfMemoryError>.Success { value: next } => move next
        Result<Bytes, ManifestEditRefused | OutOfMemoryError>.Failure {
          error
        } => match move error {
          ManifestEditRefused _unplaced => {
            fail run refuse(
              &[b"the workspace's silk-version cannot be written into the archive's [package]"],
            )
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
      pin = run Bytes.copy(pinned)
    }
  }
  if Bytes.length(&pin) == usize.ZERO {
    fail run refuse(
      &[
        b"it has no silk-version; a package archive names the Silk it is written for, so set silk-version in [package], or in its workspace's [workspace]",
      ],
    )
  }
  if same(Bytes.asSlice(&pin), b"0.0.0") {
    fail run refuse(
      &[
        b"its silk-version is 0.0.0, which pins no Silk; set the release it is written for, such as the one `silk --version` names",
      ],
    )
  }
  let inherited = run inheritedDependencies(&document)
  let listed = inherited.asSlice()
  if listed.length == usize.ZERO {
    return move text
  }
  let shared = match move around {
    Option<Shared>.Some { value } => move value
    Option<Shared>.None => {
      fail run refuse(
        &[
          b"a dependency is written { workspace = true }, but no workspace lists this package as a member",
        ],
      )
    }
  }
  let mut at = usize.ZERO
  while at < listed.length {
    let table = b"dependencies"
    let name = listed[at].asSlice()
    let written = match move Workspaces.find(&shared, name) {
      Option<&TomlValue>.Some { value } => value
      Option<&TomlValue>.None => {
        fail run refuse(
          &[
            b"dependency `",
            name,
            b"` is written { workspace = true }, but [workspace.dependencies] of ",
            Path.rawBytes(Workspaces.manifest(&shared)),
            b" has no `",
            name,
            b"`",
          ],
        )
      }
    }
    if Workspaces.inherits(written) {
      fail run refuse(
        &[
          b"dependency `",
          name,
          b"`: an entry of [workspace.dependencies] cannot be workspace = true itself",
        ],
      )
    }
    let value = run inlineTable(written)
    let edited = run Effect.result(
      ManifestEdits.setValue(Bytes.asSlice(&text), table, name, Bytes.asSlice(&value)),
    )
    text = match move edited {
      Result<Bytes, ManifestEditRefused | OutOfMemoryError>.Success { value: next } => move next
      Result<Bytes, ManifestEditRefused | OutOfMemoryError>.Failure { error } => match move error {
        ManifestEditRefused _unplaced => {
          fail run refuse(
            &[
              b"dependency `",
              name,
              b"` cannot be written out for the archive; write it on one line in [",
              table,
              b"], as ",
              name,
              b" = { workspace = true }",
            ],
          )
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    at = at + usize.ONE
  }

  // An entry the edit could not find, such as one in a `[dependencies.<name>]` table, is still
  // taken from the workspace, or the text no longer parses.
  let rewritten = match move run Effect.result(Toml.parse(Bytes.asSlice(&text))) {
    Result<TomlValue, TomlError | OutOfMemoryError>.Success { value } => move value
    Result<TomlValue, TomlError | OutOfMemoryError>.Failure { error } => match move error {
      TomlError _malformed => {
        fail run refuse(
          &[
            b"a dependency written { workspace = true } cannot be written out for the archive; write each on one line, as name = { workspace = true }",
          ],
        )
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let left = run inheritedDependencies(&rewritten)
  let remaining = left.asSlice()
  if remaining.length > usize.ZERO {
    let first = remaining[usize.ZERO].asSlice()
    fail run refuse(
      &[
        b"dependency `",
        first,
        b"` cannot be written out for the archive; write it on one line in [",
        b"dependencies",
        b"], as ",
        first,
        b" = { workspace = true }",
      ],
    )
  }
  return move text
}

/// Checks that the package described by `document`, its manifest as [`manifestText`] writes it for
/// the archive, can be packed: it writes `[package].version`, none of its dependencies is a
/// path dependency, which nobody downloading the archive has, and `[pack.binary]` is written
/// only by an executable.
///
/// # Errors
/// - `PackRefused` naming the first problem.
pub effect fn checkManifest(document: &TomlValue) -> ()
  ! PackRefused | OutOfMemoryError
  ? &mut Allocator {
  if let Option<&[u8]>.None = ManifestFields.packageText(document, "version") {
    fail run refuse(
      &[b"[package] has no version; write one, as version = \"0.1.0\", to name the archive"],
    )
  }

  // Binary archives hold an executable, so the table on any other kind would do nothing.
  if packsBinaries(document) {
    if let Option<string>.Some { value: kind } = move Toml.asString(ManifestFields.kind(document)) {
      if kind != "executable" {
        fail run refuse(
          &[
            b"[pack.binary] archives an executable, and [package].kind is ",
            String.utf8Bytes(kind),
            b"; remove the table",
          ],
        )
      }
    }
  }
  if let Option<&TomlValue>.Some { value: listed } = move Toml.field(document, "dependencies") {
    if let Option<&[TomlChild]>.Some { value: children } = move members(listed) {
      let mut at = usize.ZERO
      while at < children.length {
        if let TomlChild.Member { entry } = &children[at] {
          let local = match move Toml.asString(
            Toml.fieldAt(Option<&TomlValue>.some(&entry.value), "path"),
          ) {
            Option<string>.Some { value } => Option<&[u8]>.some(String.utf8Bytes(value))
            Option<string>.None => Option<&[u8]>.none()
          }

          // A git or url dependency's `path` names a directory inside what it fetches.
          let fetched = match move Toml.fieldAt(Option<&TomlValue>.some(&entry.value), "git") {
            Option<&TomlValue>.Some { .. } => true
            Option<&TomlValue>.None => match move Toml.fieldAt(
              Option<&TomlValue>.some(&entry.value),
              "url",
            ) {
              Option<&TomlValue>.Some { .. } => true
              Option<&TomlValue>.None => false
            }
          }
          if let Option<&[u8]>.Some { value: path } = move local {
            if !fetched {
              fail run refuse(
                &[
                  b"path dependency `",
                  String.ownedUtf8Bytes(&entry.key),
                  b"`: an archive cannot carry ",
                  path,
                  b"; depend on it by git or url instead",
                ],
              )
            }
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return ()
}

/// Whether the package described by `document` is released: true unless `[package].publish` is
/// `false`, as a workspace's examples write.
pub fn publishes(document: &TomlValue) -> bool {
  if let Option<&TomlValue>.Some { value: flag } = move Toml.fieldAt(
    Toml.field(document, "package"),
    "publish",
  ) {
    if let TomlValue.Boolean { value } = &flag.* {
      return value
    }
  }
  return true
}

// `path` relative to `directory`, or none when it is not below it.
fn below<'a>(directory: &Path, path: &'a Path) -> Option<&'a [u8]> {
  let base = Path.rawBytes(directory)
  let whole = Path.rawBytes(path)
  if base.length == usize.ONE {
    if whole.length > usize.ONE {
      return Option<&'a [u8]>.some(Slice.view<u8>(whole, usize.ONE, whole.length - usize.ONE))
    }
    return Option<&'a [u8]>.none()
  }
  if whole.length > base.length + usize.ONE && startsWith(whole, base) && whole[base.length] == 47 {
    return Option<&'a [u8]>.some(
      Slice.view<u8>(whole, base.length + usize.ONE, whole.length - base.length - usize.ONE),
    )
  }
  return Option<&'a [u8]>.none()
}

// The last segment of `path`.
fn lastName(path: &[u8]) -> &[u8] {
  let mut at = path.length
  while at > usize.ZERO {
    if path[at - usize.ONE] == 47 {
      return Slice.view<u8>(path, at, path.length - at)
    }
    at = at - usize.ONE
  }
  return path
}

// Whether a file at the package root, such as `README.md`, documents or licenses the package.
fn documentsPackage(name: &[u8]) -> bool {
  let known: [&[u8]; 5] = [b"README", b"LICENSE", b"LICENCE", b"COPYING", b"CHANGELOG"]
  let mut at = usize.ZERO
  while at < known.length {
    let word = known[at]
    if name.length >= word.length {
      let mut matches = true
      let mut letter = usize.ZERO
      while letter < word.length {
        let mut byte = name[letter]
        if byte >= 97 && byte <= 122 {
          byte = byte - 32
        }
        if byte != word[letter] {
          matches = false
        }
        letter = letter + usize.ONE
      }
      if matches
        && (name.length == word.length || name[word.length] == 46 || name[word.length] == 45
          || name[word.length] == 95) {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Adds `path`, relative to `directory`, to `files` once.
effect fn add(files: &mut List<Bytes>, directory: &Path, path: &Path) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let relative = match move below(directory, path) {
    Option<&[u8]>.Some { value } => value
    Option<&[u8]>.None => {
      return ()
    }
  }

  // A package's silk.local.toml names checkouts on its author's machine, so it never ships.
  if same(relative, b"silk.local.toml") {
    return ()
  }
  let listed = List<Bytes>.asSlice(&files.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if same(Bytes.asSlice(&listed[at]), relative) {
      return ()
    }
    at = at + usize.ONE
  }
  run List<Bytes>.append(&mut files.*, run Bytes.copy(relative))
  return ()
}

// Refuses `relative`, an include entry below `directory`, when any segment of it is a symbolic
// link. A segment that does not exist is left for the caller to report.
effect fn refuseLinks(directory: &Path, relative: &[u8], label: &[u8]) -> ()
  ! PackRefused | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut parent = run Path.fromBytes(Path.rawBytes(directory))
  let mut start = usize.ZERO
  while start < relative.length {
    let mut end = start
    while end < relative.length && relative[end] != 47 {
      end = end + usize.ONE
    }
    let segment = Slice.view<u8>(relative, start, end - start)
    start = end + usize.ONE
    if segment.length == usize.ZERO || same(segment, b".") {
      continue
    }
    let child = run Path.joinBytes(&parent, segment)
    let listed = match move run Effect.result(FileSystem.listDirectory(&parent)) {
      Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success { value } => move value
      Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure {
        error
      } => match move error {
        FileError _missing => {
          return ()
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    let entries = List<DirectoryEntry>.asSlice(&listed)
    let mut at = usize.ZERO
    while at < entries.length {
      if same(Path.rawBytes(&entries[at].path), Path.rawBytes(&child))
        && entries[at].kind.code == FileSystem.entryKindCode(FileSystem.symbolicLink()) {
        fail run refuse(
          &[
            label,
            b" entry ",
            relative,
            b" passes through a symbolic link; an archive holds only files and directories",
          ],
        )
      }
      at = at + usize.ONE
    }
    parent = move child
  }
  return ()
}

// Adds every file below `start` except dot entries and `skip`, refusing a symbolic link.
effect fn walk(files: &mut List<Bytes>, directory: &Path, start: &Path, skip: &Path) -> ()
  ! PackRefused | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let entries = run FileSystem.listDirectory(start)
  let listed = List<DirectoryEntry>.asSlice(&entries)
  let mut at = usize.ZERO
  while at < listed.length {
    let entry = &listed[at]
    at = at + usize.ONE
    let name = lastName(Path.rawBytes(&entry.path))
    if name.length > usize.ZERO && name[usize.ZERO] == 46 {
      continue
    }
    if same(Path.rawBytes(&entry.path), Path.rawBytes(skip)) {
      continue
    }
    let kind = entry.kind.code
    if kind == FileSystem.entryKindCode(FileSystem.symbolicLink()) {
      let shown = match move below(directory, &entry.path) {
        Option<&[u8]>.Some { value } => value
        Option<&[u8]>.None => Path.rawBytes(&entry.path)
      }
      fail run refuse(&[shown, b" is a symbolic link; an archive holds only files and directories"])
    }
    if kind == FileSystem.entryKindCode(FileSystem.directory()) {
      run walk(&mut files.*, directory, &entry.path, skip)
    } else {
      run add(&mut files.*, directory, &entry.path)
    }
  }
  return ()
}

// Whether `relative` is a path below the package directory: not empty or absolute, with no empty,
// `.` or `..` segment and no backslash.
fn contained(relative: &[u8]) -> bool {
  if relative.length == usize.ZERO || relative[usize.ZERO] == 47 {
    return false
  }
  let mut start = usize.ZERO
  let mut at = usize.ZERO
  while at <= relative.length {
    if at < relative.length && (relative[at] == 92 || relative[at] == 0) {
      return false
    }
    if at == relative.length || relative[at] == 47 {
      let length = at - start
      if length == usize.ZERO {
        return false
      }
      if length == usize.ONE && relative[start] == 46 {
        return false
      }
      if length == 2 && relative[start] == 46 && relative[start + usize.ONE] == 46 {
        return false
      }
      start = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return true
}

// Adds the files and directories the manifest array `include` names to `files`. `label` names
// the array in a refusal, such as `[package].include`.
effect fn included(
  files: &mut List<Bytes>,
  project: &Project,
  include: &TomlValue,
  label: &[u8],
) -> ()
  ! PackRefused | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let directory = Projects.directory(project)
  let skip = Projects.outputDirectory(project)
  let mut at = usize.ZERO
  while true {
    let item = match move Toml.item(include, at) {
      Option<&TomlValue>.Some { value } => value
      Option<&TomlValue>.None => {
        break
      }
    }
    at = at + usize.ONE
    let relative = match move Toml.asString(Option<&TomlValue>.some(item)) {
      Option<string>.Some { value } => String.utf8Bytes(value)
      Option<string>.None => {
        continue
      }
    }
    if !contained(relative) {
      fail run refuse(&[label, b" entry ", relative, b" is not a path below the package directory"])
    }

    // `stat` follows links, so each segment of the entry is looked up in its parent first.
    run refuseLinks(directory, relative, label)
    let path = run Path.joinBytes(directory, relative)
    match move run Effect.result(FileSystem.stat(&path)) {
      Result<FileInfo | DirectoryInfo, FileError>.Success { value } => match move value {
        DirectoryInfo _directory => run walk(&mut files.*, directory, &path, skip)
        FileInfo _file => run add(&mut files.*, directory, &path)
      }
      Result<FileInfo | DirectoryInfo, FileError>.Failure { error } => {
        drop error
        fail run refuse(&[label, b" entry ", relative, b" names no file or directory"])
      }
    }
  }
  return ()
}

/// The files `silk pack` puts in the archive of `project`, as paths relative to the package
/// directory, in byte order.
///
/// # Details
/// The list holds `silk.toml`, every file below the source root, every file or directory
/// `[package].include` names, and the `README`, `LICENSE`, `LICENCE`, `COPYING` and `CHANGELOG`
/// files at the package root (any letter case, with or without an extension). Entries whose name
/// starts with `.`, the build directory and the `silk.local.toml` at the package root are left out.
///
/// # Errors
/// - `PackRefused` when the source root is outside the package directory, an `include` entry is
///   not a path below it or names nothing, or a symbolic link would be packed.
/// - `FileError` when a directory cannot be listed.
pub effect fn files(project: &Project) -> List<Bytes>
  ! PackRefused | FileError | TomlError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let directory = Projects.directory(project)
  let skip = Projects.outputDirectory(project)
  let mut files = List<Bytes>.make()
  run add(&mut files, directory, Projects.manifest(project))
  let sourceRoot = Projects.sourceRoot(project)
  if same(Path.rawBytes(sourceRoot), Path.rawBytes(directory)) {
    run walk(&mut files, directory, sourceRoot, skip)
  } else if let Option<&[u8]>.Some { .. } = below(directory, sourceRoot) {
    run walk(&mut files, directory, sourceRoot, skip)
  } else {
    fail run refuse(
      &[b"the source root ", Path.rawBytes(sourceRoot), b" is outside the package directory"],
    )
  }
  let document = run Projects.document(project)
  if let Option<&TomlValue>.Some { value: include } = move Toml.fieldAt(
    Toml.field(&document, "package"),
    "include",
  ) {
    run included(&mut files, project, include, b"[package].include")
  }
  let root = run FileSystem.listDirectory(directory)
  let listed = List<DirectoryEntry>.asSlice(&root)
  let mut at = usize.ZERO
  while at < listed.length {
    let entry = &listed[at]
    at = at + usize.ONE
    if entry.kind.code != FileSystem.entryKindCode(FileSystem.file()) {
      continue
    }
    if documentsPackage(lastName(Path.rawBytes(&entry.path))) {
      run add(&mut files, directory, &entry.path)
    }
  }
  return run sortPaths(move files)
}

/// Refuses `files`, the archive of a package as [`files`] lists it, when the package embeds a
/// file the archive does not hold.
///
/// # Details
/// `reads` are the embedded files the check of the package read and found present. A package that
/// depends on the archive reads each of them from it, so a file left out would build here and
/// fail there. A module the check does not reach, as a test module is, asks for nothing.
///
/// # Errors
/// - `PackRefused` naming the module, the embedded file and the `[package].include` key.
pub effect fn checkEmbedded(files: &[Bytes], reads: &[EmbeddedRead]) -> ()
  ! PackRefused | OutOfMemoryError
  ? &mut Allocator {
  let mut at = usize.ZERO
  while at < reads.length {
    let embedded = Bytes.asSlice(&reads[at].path)
    let mut held = false
    let mut seen = usize.ZERO
    while seen < files.length {
      if same(Bytes.asSlice(&files[seen]), embedded) {
        held = true
      }
      seen = seen + usize.ONE
    }
    if !held {
      fail run refuse(
        &[
          b"module ",
          Bytes.asSlice(&reads[at].reader),
          b" embeds ",
          embedded,
          b", which the archive would not hold; add it to [package].include",
        ],
      )
    }
    at = at + usize.ONE
  }
  return ()
}

// `paths` in byte order, by selection: a package holds few enough files.
effect fn sortPaths(paths: List<Bytes>) -> List<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut rest = move paths
  let mut sorted = List<Bytes>.make()
  while List<Bytes>.length(&rest) > usize.ZERO {
    let listed = List<Bytes>.asSlice(&rest)
    let mut least = usize.ZERO
    let mut at = usize.ONE
    while at < listed.length {
      if bytesBefore(Bytes.asSlice(&listed[at]), Bytes.asSlice(&listed[least])) {
        least = at
      }
      at = at + usize.ONE
    }
    run List<Bytes>.append(&mut sorted, List<Bytes>.remove(&mut rest, least))
  }
  return move sorted
}

/// The archive of `project` holding `files`, paths relative to its package directory as
/// [`files`] lists them.
///
/// # Errors
/// - `PackRefused` when the manifest writes no version or a file's path cannot be stored.
/// - `FileError` when a file cannot be read.
pub effect fn archive(project: &Project, files: &[Bytes]) -> Packed
  ! PackRefused | FileError | TomlError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let document = run Projects.document(project)
  let version = ManifestFields.version(&document)
  let mut top = run Bytes.copy(Projects.name(project))
  run Bytes.append(&mut top, b"-")
  run Bytes.append(&mut top, version)
  let mut writer = TarWriter.make()
  let mut gzip = run compressor()
  let mut at = usize.ZERO
  while at < files.length {
    let relative = Bytes.asSlice(&files[at])
    at = at + usize.ONE
    let path = run Path.joinBytes(Projects.directory(project), relative)

    // The manifest is packed with its workspace dependencies written out.
    let content = if same(Path.rawBytes(&path), Path.rawBytes(Projects.manifest(project))) {
      run manifestText(project)
    } else {
      run FileSystem.readFile(&path)
    }
    let mut member = run Bytes.copy(Bytes.asSlice(&top))
    run Bytes.append(&mut member, b"/")
    run Bytes.append(&mut member, relative)
    run store(
      &mut writer,
      &mut gzip,
      Bytes.asSlice(&member),
      relative,
      Bytes.asSlice(&content),
      false,
    )
  }
  let bytes = run finished(move writer, move gzip)
  let mut fileName = run Bytes.copy(Bytes.asSlice(&top))
  run Bytes.append(&mut fileName, b".tar.gz")
  return Packed { stem: move top, fileName: move fileName, bytes: move bytes, files: files.length }
}

// A `Writer` that keeps a packed archive's gzip stream in memory.
struct Collected {
  bytes: Bytes,
  allocator: SystemAllocator,
}

impl Writer for Collected {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let appended = run Effect.result(
      Bytes.append(&mut self.bytes, value) |> Effect.provideMut<Allocator>(&mut self.allocator),
    )
    match move appended {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { .. } => {
        fail Writer.failure()
      }
    }
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

// The gzip writer a packed archive's tar stream goes through, at the best compression level,
// with the zero timestamp the encoder always writes.
effect fn compressor() -> EncodeWriter<Collected>
  ! OutOfMemoryError
  ? &mut Allocator {
  let sink = Collected { bytes: Bytes.make(), allocator: Allocator.systemAllocatorProvider() }
  let made = run Effect.result(
    EncodeWriter<Collected>.make(move sink, Format.Gzip, DeflateOptions.make(9)),
  )
  return match move made {
    Result<EncodeWriter<Collected>, OutOfMemoryError | EncodeError>.Success { value } => move value
    Result<EncodeWriter<Collected>, OutOfMemoryError | EncodeError>.Failure {
      error
    } => match move error {
      OutOfMemoryError exhausted => {
        fail move exhausted
      }

      // Level 9 is a valid option.
      EncodeError _impossible => {
        fail OutOfMemoryError {}
      }
    }
  }
}

// Adds one file to the archive, refusing a path tar cannot store. `shown` names the file in the
// refusal.
effect fn store(
  writer: &mut TarWriter,
  gzip: &mut EncodeWriter<Collected>,
  member: &[u8],
  shown: &[u8],
  content: &[u8],
  executable: bool,
) -> ()
  ! PackRefused | OutOfMemoryError
  ? &mut Allocator {
  let added = run Effect.result(
    TarWriter.file(&mut writer.*, member, content, executable)
      |> Effect.provideMut<Writer>(&mut gzip.*),
  )
  return match move added {
    Result<(), TarError | WriterError>.Success { .. } => ()
    Result<(), TarError | WriterError>.Failure { error } => match move error {
      TarError _unsafe => {
        fail run refuse(&[shown, b" cannot be stored in a tar archive"])
      }

      // Only the in-memory stream can fail, when it cannot grow.
      WriterError _full => {
        fail OutOfMemoryError {}
      }
    }
  }
}

// Ends the archive and returns its gzip stream.
effect fn finished(writer: TarWriter, gzip: EncodeWriter<Collected>) -> Bytes
  ! OutOfMemoryError {
  let mut stream = move gzip
  let ended = run Effect.result(
    TarWriter.finish(move writer) |> Effect.provideMut<Writer>(&mut stream),
  )
  match move ended {
    Result<(), TarError | WriterError>.Success { .. } => ()

    // Every file got all its content, and only the in-memory stream can fail.
    Result<(), TarError | WriterError>.Failure { .. } => {
      fail OutOfMemoryError {}
    }
  }
  return match move run Effect.result(EncodeWriter<Collected>.finish(move stream)) {
    Result<Collected, WriterError>.Success { value } => move value.bytes
    Result<Collected, WriterError>.Failure { .. } => {
      fail OutOfMemoryError {}
    }
  }
}

/// How one target's binary archive is written: the `[pack.binary]` settings with those of
/// `[pack.binary.target.<target>]` in their place.
pub struct BinaryLayout {
  /// Whether the archive is a ZIP file; otherwise a gzip-compressed tar file.
  pub zip: bool,

  /// Whether the executable sits at the top of the archive; otherwise in `bin/`.
  pub flat: bool,

  /// The files `include` adds, as paths relative to the package directory, in byte order.
  pub include: List<Bytes>,

  /// The manifest array `include` came from, such as `[pack.binary].include`, for a refusal.
  pub label: Bytes,
}

/// Whether the manifest `document` has a `[pack.binary]` table, so `silk pack` writes binary
/// archives without `--bin`.
pub fn packsBinaries(document: &TomlValue) -> bool {
  return Option<&TomlValue>.isSome(&Toml.fieldAt(Toml.field(document, "pack"), "binary"))
}

// `[pack.binary.target.<target>]`, when the manifest writes one.
fn targetTable<'a>(binary: Option<&'a TomlValue>, target: &[u8]) -> Option<&'a TomlValue> {
  if let Option<&TomlValue>.Some { value: targets } = move Toml.fieldAt(binary, "target") {
    if let Option<&[TomlChild]>.Some { value: children } = move members(targets) {
      let mut at = usize.ZERO
      while at < children.length {
        if let TomlChild.Member { entry } = &children[at] {
          if same(String.ownedUtf8Bytes(&entry.key), target) {
            return Option<&'a TomlValue>.some(&entry.value)
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return Option<&'a TomlValue>.none()
}

/// How `project`'s binary archive for `target` is written. A package without `[pack.binary]`
/// gets a tar file with the executable in `bin/` and no added file.
///
/// # Errors
/// - `PackRefused` when an `include` entry is not a path below the package directory, names
///   nothing, or would pack a symbolic link.
/// - `FileError` when a directory cannot be listed.
pub effect fn binaryLayout(project: &Project, target: &[u8]) -> BinaryLayout
  ! PackRefused | FileError | TomlError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let document = run Projects.document(project)
  let binary = Toml.fieldAt(Toml.field(&document, "pack"), "binary")
  let specific = targetTable(binary, target)
  let mut format = Toml.asString(Toml.fieldAt(specific, "format"))
  if Option<string>.isNone(&format) {
    format = Toml.asString(Toml.fieldAt(binary, "format"))
  }
  let mut layout = Toml.asString(Toml.fieldAt(specific, "layout"))
  if Option<string>.isNone(&layout) {
    layout = Toml.asString(Toml.fieldAt(binary, "layout"))
  }
  let mut zip = false
  if let Option<string>.Some { value } = move format {
    zip = value == "zip"
  }
  let mut flat = false
  if let Option<string>.Some { value } = move layout {
    flat = value == "flat"
  }
  let mut include = List<Bytes>.make()
  let mut label = run Bytes.copy(b"[pack.binary].include")
  if let Option<&TomlValue>.Some { value: listed } = move Toml.fieldAt(specific, "include") {
    label = run Bytes.copy(b"[pack.binary.target.")
    run Bytes.append(&mut label, target)
    run Bytes.append(&mut label, b"].include")
    run included(&mut include, project, listed, Bytes.asSlice(&label))
  } else if let Option<&TomlValue>.Some { value: listed } = move Toml.fieldAt(binary, "include") {
    run included(&mut include, project, listed, Bytes.asSlice(&label))
  }
  return BinaryLayout {
    zip: zip,
    flat: flat,
    include: run sortPaths(move include),
    label: move label,
  }
}

// Whether `path` is below the directory `directory`, both relative paths.
fn under(path: &[u8], directory: &[u8]) -> bool {
  return path.length > directory.length && startsWith(path, directory)
    && path[directory.length] == 47
}

// A binary archive being written, in either format.
union ArchiveWriter {
  Tar { writer: TarWriter, gzip: EncodeWriter<Collected> },
  Zip { writer: ZipWriter, bytes: Collected },
}

// Adds one file to a binary archive, refusing a path its format cannot store.
effect fn storeIn(
  archive: &mut ArchiveWriter,
  member: &[u8],
  content: &[u8],
  executable: bool,
) -> ()
  ! PackRefused | OutOfMemoryError
  ? &mut Allocator {
  return match &mut archive.* {
    ArchiveWriter.Tar { writer, gzip } => run store(
      &mut writer,
      &mut gzip,
      member,
      member,
      content,
      executable,
    )
    ArchiveWriter.Zip { writer, bytes } => {
      let added = run Effect.result(
        ZipWriter.file(&mut writer, member, content, executable)
          |> Effect.provideMut<Writer>(&mut bytes),
      )
      match move added {
        Result<(), ZipError | WriterError | OutOfMemoryError>.Success { .. } => ()
        Result<(), ZipError | WriterError | OutOfMemoryError>.Failure {
          error
        } => match move error {
          ZipError reason => {
            fail run refuse(
              &[
                member,
                b" cannot be stored in a ZIP archive: ",
                String.utf8Bytes(ZipError.describe(reason)),
              ],
            )
          }

          // Only the in-memory archive can fail, when it cannot grow.
          WriterError _full => {
            fail OutOfMemoryError {}
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
  }
}

// Ends a binary archive and returns its bytes.
effect fn finishedIn(archive: ArchiveWriter) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  match move archive {
    ArchiveWriter.Tar { writer, gzip } => {
      return run finished(move writer, move gzip)
    }
    ArchiveWriter.Zip { writer, bytes } => {
      let mut collected = move bytes
      let ended = run Effect.result(
        ZipWriter.finish(move writer) |> Effect.provideMut<Writer>(&mut collected),
      )
      match move ended {
        Result<(), ZipError | WriterError | OutOfMemoryError>.Success { .. } => ()

        // An archive of release files is far below the sizes that need ZIP64.
        Result<(), ZipError | WriterError | OutOfMemoryError>.Failure { .. } => {
          fail OutOfMemoryError {}
        }
      }
      let Collected { bytes: written, allocator: _ } = move collected
      return move written
    }
  }
}

/// The binary archive of `project` for one built executable at `executable`: the
/// `<name>-<version>-<platform>.tar.gz` or `.zip` file whose top directory
/// `<name>-<version>-<platform>/` holds the executable, in `bin/` unless `layout` is flat, the
/// `README`, `LICENSE`, `LICENCE`, `COPYING` and `CHANGELOG` files among `files`, the source
/// archive's list, and the files `layout` includes. `platform` is the target name.
///
/// # Errors
/// - `PackRefused` when a path cannot be stored, or an included file is at the executable's
///   path, above it or below it.
/// - `FileError` when a file cannot be read.
pub effect fn binaryArchive(
  project: &Project,
  platform: &[u8],
  executable: &Path,
  files: &[Bytes],
  layout: &BinaryLayout,
) -> Packed
  ! PackRefused | FileError | TomlError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let document = run Projects.document(project)
  let mut top = run Bytes.copy(Projects.name(project))
  run Bytes.append(&mut top, b"-")
  run Bytes.append(&mut top, ManifestFields.version(&document))
  run Bytes.append(&mut top, b"-")
  run Bytes.append(&mut top, platform)
  let mut archive = if layout.zip {
    ArchiveWriter.Zip {
      writer: ZipWriter.make(),
      bytes: Collected { bytes: Bytes.make(), allocator: Allocator.systemAllocatorProvider() },
    }
  } else {
    ArchiveWriter.Tar { writer: TarWriter.make(), gzip: run compressor() }
  }
  let mut count = usize.ZERO
  let program = run FileSystem.readFile(executable)
  let mut placed = Bytes.make()
  if !layout.flat {
    run Bytes.append(&mut placed, b"bin/")
  }
  run Bytes.append(&mut placed, lastName(Path.rawBytes(executable)))
  let mut member = run Bytes.copy(Bytes.asSlice(&top))
  run Bytes.append(&mut member, b"/")
  run Bytes.append(&mut member, Bytes.asSlice(&placed))
  run storeIn(&mut archive, Bytes.asSlice(&member), Bytes.asSlice(&program), true)
  count = count + usize.ONE

  // The documenting files, then the included ones that are not among them.
  let mut added = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < files.length {
    let relative = Bytes.asSlice(&files[at])
    at = at + usize.ONE
    if lastName(relative).length != relative.length || !documentsPackage(relative) {
      continue
    }
    run List<Bytes>.append(&mut added, run Bytes.copy(relative))
  }
  let extra = List<Bytes>.asSlice(&layout.include)
  let mut one = usize.ZERO
  while one < extra.length {
    let relative = Bytes.asSlice(&extra[one])
    one = one + usize.ONE

    // The executable's path, a directory on the way to it, or a file below it cannot be both.
    if same(relative, Bytes.asSlice(&placed)) || under(Bytes.asSlice(&placed), relative)
      || under(relative, Bytes.asSlice(&placed)) {
      fail run refuse(
        &[
          Bytes.asSlice(&layout.label),
          b" holds ",
          relative,
          b", which takes the place of the executable at ",
          Bytes.asSlice(&placed),
          b" in the archive",
        ],
      )
    }
    let mut known = false
    let listed = List<Bytes>.asSlice(&added)
    let mut other = usize.ZERO
    while other < listed.length {
      if same(Bytes.asSlice(&listed[other]), relative) {
        known = true
      }
      other = other + usize.ONE
    }
    if !known {
      run List<Bytes>.append(&mut added, run Bytes.copy(relative))
    }
  }
  let ordered = run sortPaths(move added)
  let members = List<Bytes>.asSlice(&ordered)
  let mut each = usize.ZERO
  while each < members.length {
    let relative = Bytes.asSlice(&members[each])
    each = each + usize.ONE
    let content = run FileSystem.readFile(
      &run Path.joinBytes(Projects.directory(project), relative),
    )
    let mut named = run Bytes.copy(Bytes.asSlice(&top))
    run Bytes.append(&mut named, b"/")
    run Bytes.append(&mut named, relative)
    run storeIn(&mut archive, Bytes.asSlice(&named), Bytes.asSlice(&content), false)
    count = count + usize.ONE
  }
  let bytes = run finishedIn(move archive)
  let mut fileName = run Bytes.copy(Bytes.asSlice(&top))
  run Bytes.append(
    &mut fileName,
    if layout.zip {
      b".zip"
    } else {
      b".tar.gz"
    },
  )
  return Packed { stem: move top, fileName: move fileName, bytes: move bytes, files: count }
}
