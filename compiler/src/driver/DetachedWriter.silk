//! A copy of the compiler that finishes writing a build's cache after the build returns.
//!
//! An edit build's last checks leave a few hundred milliseconds of work on the main thread:
//! assembling and encoding the semantic image the next build reads. POSIX `fork` hands that work to
//! a copy of the process, which shares the store's pages until either side writes them, so the
//! build links and exits without waiting for it. The copy leaves the terminal and its session and
//! reads and writes `/dev/null` in place of standard input, output and error, so nothing that waits
//! for the build's output waits for the copy.
//!
//! The copy holds an exclusive `flock` on the cache file's lock file until it exits. A writer takes
//! that lock before it forks, so two writes of one file never overlap, and a reader waits on it
//! ([`waitFor`]) before it reads the file, so a build never reads an older image than the last
//! build left. On a host without `fork` the write runs in the build itself, holding the same lock.

import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.filesystem {Path}
import silk.ownership {Drop}
import silk.pointer {Pointer}

static if Intrinsic.targetOperatingSystem() == "darwin" || Intrinsic.targetOperatingSystem() == "linux" {
  unsafe extern "C" fn open(path: ?[*]const u8, flags: i32, ...) -> i32 with Intrinsic.foreign(noCapture: ("path",))
  unsafe extern "C" fn close(fd: i32) -> i32
  unsafe extern "C" fn flock(fd: i32, operation: i32) -> i32
  unsafe extern "C" fn fork() -> i32
  unsafe extern "C" fn setsid() -> i32
  unsafe extern "C" fn dup2(from: i32, to: i32) -> i32
  unsafe extern "C" fn _exit(status: i32) -> ()

  static if Intrinsic.targetOperatingSystem() == "darwin" {
    unsafe extern "C" fn __error() -> *mut i32
    unsafe fn currentError() -> i32 {
      unsafe {
        return Pointer.read<i32>(__error())
      }
    }
    const CREATE: i32 = 512
    const CLOEXEC: i32 = 16777216
  } else {
    unsafe extern "C" fn __errno_location() -> *mut i32
    unsafe fn currentError() -> i32 {
      unsafe {
        return Pointer.read<i32>(__errno_location())
      }
    }
    const CREATE: i32 = 64
    const CLOEXEC: i32 = 524288
  }
  const READ_ONLY: i32 = 0
  const READ_WRITE: i32 = 2
  const SHARED: i32 = 1
  const EXCLUSIVE: i32 = 2
  const INTERRUPTED: i32 = 4

  // The NUL-terminated host path of `path`.
  effect fn host(path: &Path) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut text = run Bytes.copy(Path.rawBytes(path))
    let ending: [u8; 1] = [0]
    run Bytes.append(&mut text, &ending)
    return move text
  }

  // Takes `operation`'s lock on `fd`, waiting for it; false when the host refuses the lock.
  fn acquire(fd: i32, operation: i32) -> bool {
    while true {
      if unsafe flock(fd, operation) == 0 { return true }
      if unsafe currentError() != INTERRUPTED { return false }
    }
    return false
  }

  /// The exclusive lock on one cache file's lock file, released when it is dropped.
  pub struct Held {
    fd: i32,
  }

  impl Drop for Held {
    fn drop(self: &mut Held) -> () {
      let fd = Intrinsic.replace(self.fd, -1)
      if fd >= 0 {
        let ignored = unsafe close(fd)
      }
    }
  }

  /// Where the write runs after [`handOff`].
  pub union Handoff {
    /// In the copy. The build returns without writing.
    Original,
    /// This is the copy: write, then call [`finish`].
    Copy {pub held: Held},
    /// No copy could start: write here, then drop the lock.
    Here {pub held: Held},
    /// The lock file could not be opened or locked: write here without it.
    Unlocked,
  }

  /// Takes the exclusive lock on `lock`, waiting for an earlier write of the same file, and forks
  /// a copy of the process to write the file in.
  ///
  /// # Gotchas
  /// Call it on the build's only thread: the copy has no other thread, and a lock another thread
  /// held at the fork stays held in the copy.
  pub effect fn handOff(lock: &Path) -> Handoff ! OutOfMemoryError ? &mut Allocator {
    let path = run host(lock)
    let fd = unsafe open(Pointer.fromSlice<u8>(Bytes.asSlice(&path)), READ_WRITE + CREATE + CLOEXEC, 438)
    if fd < 0 { return Handoff.Unlocked }
    let held = Held {fd: fd}
    if !acquire(fd, EXCLUSIVE) { return Handoff.Unlocked }
    let child = unsafe fork()
    if child < 0 { return Handoff.Here {held: move held} }
    if child > 0 { return Handoff.Original }
    let detached = unsafe setsid()
    let empty = unsafe open(Pointer.fromSlice<u8>(b"/dev/null\0"), READ_WRITE)
    if empty >= 0 {
      let input = unsafe dup2(empty, 0)
      let output = unsafe dup2(empty, 1)
      let errors = unsafe dup2(empty, 2)
      if empty > 2 {
        let closed = unsafe close(empty)
      }
    }
    return Handoff.Copy {held: move held}
  }

  /// Ends the copy [`handOff`] started, without running the build's cleanup.
  pub fn finish(held: Held) -> never {
    unsafe _exit(0)
    // _exit never returns; keep the source contract divergent without a compiler intrinsic.
    return finish(move held)
  }

  /// Waits until no copy is writing the cache file whose lock file is `lock`.
  pub effect fn waitFor(lock: &Path) -> () ! OutOfMemoryError ? &mut Allocator {
    let path = run host(lock)
    let fd = unsafe open(Pointer.fromSlice<u8>(Bytes.asSlice(&path)), READ_ONLY + CLOEXEC)
    if fd < 0 { return () }
    let held = Held {fd: fd}
    let waited = acquire(fd, SHARED)
    drop held
  }
} else {
  /// The lock on one cache file's lock file; this host takes none.
  pub struct Held {}

  /// Where the write runs after [`handOff`].
  pub union Handoff {
    /// In the copy. The build returns without writing.
    Original,
    /// This is the copy: write, then call [`finish`].
    Copy {pub held: Held},
    /// No copy could start: write here, then drop the lock.
    Here {pub held: Held},
    /// The lock file could not be opened or locked: write here without it.
    Unlocked,
  }

  /// This host starts no copy: the write runs in the build.
  pub effect fn handOff(lock: &Path) -> Handoff ! OutOfMemoryError ? &mut Allocator {
    return Handoff.Unlocked
  }

  /// Never reached on this host, which starts no copy.
  pub fn finish(held: Held) -> never {
    return finish(move held)
  }

  /// Returns at once: this host starts no copy to wait for.
  pub effect fn waitFor(lock: &Path) -> () ! OutOfMemoryError ? &mut Allocator {
    return ()
  }
}
