//! A copy of the compiler that finishes writing a build's cache after the build returns.
//!
//! An edit build's last checks leave a few hundred milliseconds of work on the main thread:
//! assembling and encoding the semantic image the next build reads. POSIX `fork` hands that work to
//! a copy of the process, which shares the store's pages until either side writes them, so the
//! build links and exits without waiting for it. The copy leaves the terminal and its session and
//! reads and writes `/dev/null` in place of standard input, output and error, so nothing that waits
//! for the build's output waits for the copy.
//!
//! The copy holds an exclusive `flock` on the cache file's lock file until it exits. A writer takes
//! that lock before it forks, so two writes of one file never overlap, and a reader waits on it
//! ([`waitFor`]) before it reads the file, so a build never reads an older image than the last
//! build left. A write that does not fork holds the same lock. Windows writes in the calling
//! process under a synchronous `LockFileEx` byte-range lock. A detached relaunch would have to
//! reconstruct the live semantic store before assembling its image; native measurements found
//! reconstruction slower than the write it would defer. The opt-in measurement and its limits
//! are recorded in `compiler/fixtures/windows-runtime/CACHE-WRITER.md`. Other hosts without these
//! APIs also write in the process that asked for it.

import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.system.filesystem {Path}
import silk.core.option {Option}
import silk.core.ownership {Drop}
import silk.mem.pointer {Pointer}

static if Intrinsic.targetOperatingSystem() == "darwin" || Intrinsic.targetOperatingSystem() == "linux" {
  @foreign(noCapture: ("path",))
  unsafe extern "C" fn open(path: ?[*]const u8, flags: i32, ...) -> i32
  unsafe extern "C" fn close(fd: i32) -> i32
  unsafe extern "C" fn flock(fd: i32, operation: i32) -> i32
  unsafe extern "C" fn fork() -> i32
  unsafe extern "C" fn setsid() -> i32
  unsafe extern "C" fn dup2(from: i32, to: i32) -> i32
  unsafe extern "C" fn _exit(status: i32) -> ()

  static if Intrinsic.targetOperatingSystem() == "darwin" {
    unsafe extern "C" fn __error() -> *mut i32
    unsafe fn currentError() -> i32 {
      unsafe {
        return Pointer.read<i32>(__error())
      }
    }
    const CREATE: i32 = 512
    const CLOEXEC: i32 = 16777216
  } else {
    unsafe extern "C" fn __errno_location() -> *mut i32
    unsafe fn currentError() -> i32 {
      unsafe {
        return Pointer.read<i32>(__errno_location())
      }
    }
    const CREATE: i32 = 64
    const CLOEXEC: i32 = 524288
  }
  const READ_ONLY: i32 = 0
  const READ_WRITE: i32 = 2
  const SHARED: i32 = 1
  const EXCLUSIVE: i32 = 2
  const INTERRUPTED: i32 = 4

  // The NUL-terminated host path of `path`.
  effect fn host(path: &Path) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut text = run Bytes.copy(Path.rawBytes(path))
    let ending: [u8; 1] = [0]
    run Bytes.append(&mut text, &ending)
    return move text
  }

  // Takes `operation`'s lock on `fd`, waiting for it; false when the host refuses the lock.
  fn acquire(fd: i32, operation: i32) -> bool {
    while true {
      if unsafe flock(fd, operation) == 0 { return true }
      if unsafe currentError() != INTERRUPTED { return false }
    }
    return false
  }

  /// The exclusive lock on one cache file's lock file, released when it is dropped.
  pub struct Held {
    fd: i32,
  }

  impl Drop for Held {
    fn drop(self: &mut Held) -> () {
      let fd = Intrinsic.replace(self.fd, -1)
      if fd >= 0 {
        let ignored = unsafe close(fd)
      }
    }
  }

  /// Where the write runs after [`handOff`].
  pub union Handoff {
    /// In the copy. The build returns without writing.
    Original,
    /// This is the copy: write, then call [`finish`].
    Copy {pub held: Held},
    /// No copy could start: write here, then drop the lock.
    Here {pub held: Held},
  }

  /// Takes the exclusive lock on `lock`, waiting for an earlier write of the same file; none when
  /// the lock file cannot be opened, as before its directory exists, or the host refuses the lock.
  /// Every writer of the file holds it while it writes.
  pub effect fn hold(lock: &Path) -> Option<Held> ! OutOfMemoryError ? &mut Allocator {
    let path = run host(lock)
    let fd = unsafe open(Pointer.fromSlice<u8>(Bytes.asSlice(&path)), READ_WRITE + CREATE + CLOEXEC, 438)
    if fd < 0 { return Option<Held>.none() }
    let held = Held {fd: fd}
    if !acquire(fd, EXCLUSIVE) { return Option<Held>.none() }
    return Option<Held>.some(move held)
  }

  /// Forks a copy of the process to write the file `held` locks, which keeps the lock until it
  /// exits.
  ///
  /// # Gotchas
  /// Call it on the build's only thread: the copy has no other thread, and a lock another thread
  /// held at the fork stays held in the copy. A copy that cannot put `/dev/null` in place of its
  /// standard streams exits at once without writing, since anything waiting on the build's output
  /// would wait for it.
  pub fn handOff(held: Held) -> Handoff {
    let child = unsafe fork()
    if child < 0 { return Handoff.Here {held: move held} }
    if child > 0 { return Handoff.Original }
    let detached = unsafe setsid()
    let empty = unsafe open(Pointer.fromSlice<u8>(b"/dev/null\0"), READ_WRITE)
    if empty < 0 { return finish(move held) }
    let input = unsafe dup2(empty, 0)
    let output = unsafe dup2(empty, 1)
    let errors = unsafe dup2(empty, 2)
    if input < 0 || output < 0 || errors < 0 { return finish(move held) }
    if empty > 2 {
      let closed = unsafe close(empty)
    }
    return Handoff.Copy {held: move held}
  }

  /// Ends the copy [`handOff`] started, without running the build's cleanup.
  pub fn finish(held: Held) -> never {
    unsafe _exit(0)
    // _exit never returns; keep the source contract divergent without a compiler intrinsic.
    return finish(move held)
  }

  /// Waits until no copy is writing the cache file whose lock file is `lock`.
  pub effect fn waitFor(lock: &Path) -> () ! OutOfMemoryError ? &mut Allocator {
    let path = run host(lock)
    let fd = unsafe open(Pointer.fromSlice<u8>(Bytes.asSlice(&path)), READ_ONLY + CLOEXEC)
    if fd < 0 { return () }
    let held = Held {fd: fd}
    let waited = acquire(fd, SHARED)
    drop held
  }
} else {
static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.host_path as WindowsHostPath
  import silk.collections.list {List}
  import silk.num.usize

  extern "C" struct Overlapped {
    internal: usize, transferred: usize, offset: u32, offsetHigh: u32, event: ?*mut u8,
  }
  @foreign(noCapture: ("name", "security"))
  unsafe extern "C" fn CreateFileW(name: ?[*]const u16, access: u32, sharing: u32, security: ?*mut u8, creation: u32, flags: u32, template: ?*mut u8) -> ?*mut u8
  unsafe extern "C" fn CloseHandle(handle: ?*mut u8) -> i32
  @foreign(noCapture: ("overlapped",))
  unsafe extern "C" fn LockFileEx(handle: ?*mut u8, flags: u32, reserved: u32, low: u32, high: u32, overlapped: *mut Overlapped) -> i32
  unsafe extern "C" fn ExitProcess(status: u32) -> ()

  /// A cache lock held on a synchronous Windows file handle; closing the handle releases it.
  pub struct Held { handle: ?*mut u8 }
  impl Drop for Held {
    fn drop(self: &mut Held) -> () { let closed = unsafe CloseHandle(self.handle) }
  }

  /// The process that owns the cache write. Windows writes synchronously under the lock here.
  pub union Handoff {
    /// The writer runs in another process.
    Original,
    /// A copied process owns the lock.
    Copy {pub held: Held},
    /// The calling process owns the lock and writes before returning.
    Here {pub held: Held},
  }

  effect fn acquire(lock: &Path, write: bool) -> Option<Held> ! OutOfMemoryError ? &mut Allocator {
    let name = match move run WindowsHostPath.wide(lock) {
      Option<List<u16>>.Some {value} => move value
      Option<List<u16>>.None => { return Option<Held>.none() }
    }
    let access: u32 = if write { 3221225472 } else { 2147483648 }
    let creation: u32 = if write { 4 } else { 3 }
    // Keep the lock file's identity stable: readers and writers share access, but not deletion.
    let raw = unsafe CreateFileW(Pointer.fromSlice(List<u16>.asSlice(&name)), access, 3,
      Pointer.null<u8>(), creation, 128, Pointer.null<u8>())
    if Pointer.isNull(raw) || Pointer.address(raw) == usize.MAX { return Option<Held>.none() }
    let held = Held {handle: raw}
    let mut position = Overlapped { internal: 0, transferred: 0, offset: 0, offsetHigh: 0, event: Pointer.null<u8>() }
    let flags: u32 = if write { 2 } else { 0 }
    // The handle is synchronous. Omitting FAIL_IMMEDIATELY waits for the prior writer; the
    // OVERLAPPED remains borrowed until completion and no event or pending I/O escapes.
    if unsafe LockFileEx(raw, flags, 0, 1, 0, Pointer.fromMutRef(&mut position)) == 0 { return Option<Held>.none() }
    return Option<Held>.some(move held)
  }

  /// Waits for an exclusive cache lock. Returns None when opening or locking the file fails.
  pub effect fn hold(lock: &Path) -> Option<Held> ! OutOfMemoryError ? &mut Allocator {
    return run acquire(lock, true)
  }

  /// Retains the Windows lock in this process while the cache is written.
  pub fn handOff(held: Held) -> Handoff { return Handoff.Here {held: move held} }

  /// Exits a writer process after releasing its lock.
  pub fn finish(held: Held) -> never {
    drop held
    unsafe ExitProcess(0)
    Intrinsic.trap("ExitProcess returned")
  }

  /// Waits for the cache's writer using a shared byte-range lock, then releases the reader handle.
  /// A missing or inaccessible lock file returns immediately.
  pub effect fn waitFor(lock: &Path) -> () ! OutOfMemoryError ? &mut Allocator {
    let held = run acquire(lock, false)
    drop held
  }
} else {
  /// The lock on one cache file's lock file; this host takes none.
  pub struct Held {}

  /// Where the write runs after [`handOff`].
  pub union Handoff {
    /// In the copy. The build returns without writing.
    Original,
    /// This is the copy: write, then call [`finish`].
    Copy {pub held: Held},
    /// No copy could start: write here, then drop the lock.
    Here {pub held: Held},
  }

  /// None: this host takes no lock, so writes run in the build.
  pub effect fn hold(lock: &Path) -> Option<Held> ! OutOfMemoryError ? &mut Allocator {
    return Option<Held>.none()
  }

  /// This host starts no copy: the write runs here.
  pub fn handOff(held: Held) -> Handoff {
    return Handoff.Here {held: move held}
  }

  /// Never reached on this host, which starts no copy.
  pub fn finish(held: Held) -> never {
    return finish(move held)
  }

  /// Returns at once: this host starts no copy to wait for.
  pub effect fn waitFor(lock: &Path) -> () ! OutOfMemoryError ? &mut Allocator {
    return ()
  }
}

}
