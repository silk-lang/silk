/// The libraries the stubs stand in for, in link order.
pub fn libraries() -> [&'static [u8]; 5] {
  return [b"libc.so.6", b"libpthread.so.0", b"libm.so.6", b"libdl.so.2", b"libgcc_s.so.1"]
}

/// The program entry `_start` and the initializer it hands glibc, with the compiler builtins LLVM
/// calls on these targets. `_start` calls `__libc_start_main`, as glibc's own `crt1.o` does, so
/// neither `crt1.o`, `crti.o`, `crtn.o` nor `crtbegin.o` is needed. The initializer runs the
/// executable's `.init_array`, which glibc before 2.34 leaves to that initializer.
pub fn startSource() -> string<'static> {
  return """
    typedef void (*SilkInitializer)(int, char **, char **);
    extern SilkInitializer __init_array_start[] __attribute__((weak, visibility("hidden")));
    extern SilkInitializer __init_array_end[] __attribute__((weak, visibility("hidden")));
    __attribute__((used, visibility("hidden"))) void silk_gnu_initialize(int count, char **arguments, char **environment) {
      for (SilkInitializer *at = __init_array_start; at < __init_array_end; ++at) (*at)(count, arguments, environment);
    }
    /* C++ objects register destructors against the executable's handle. */
    __attribute__((weak, visibility("hidden"))) void *__dso_handle = &__dso_handle;
    #if defined(__x86_64__)
    __asm__(
      ".text\\n.globl _start\\n.type _start,%function\\n_start:\\n"
      "  xorl %ebp, %ebp\\n"
      "  movq %rdx, %r9\\n"
      "  popq %rsi\\n"
      "  movq %rsp, %rdx\\n"
      "  andq $-16, %rsp\\n"
      "  pushq %rax\\n"
      "  pushq %rsp\\n"
      "  xorl %r8d, %r8d\\n"
      "  leaq silk_gnu_initialize(%rip), %rcx\\n"
      "  leaq main(%rip), %rdi\\n"
      "  call *__libc_start_main@GOTPCREL(%rip)\\n"
      "  hlt\\n"
      ".size _start, .-_start\\n");
    #elif defined(__aarch64__)
    __asm__(
      ".text\\n.globl _start\\n.type _start,%function\\n_start:\\n"
      "  mov x29, #0\\n"
      "  mov x30, #0\\n"
      "  mov x5, x0\\n"
      "  ldr x1, [sp]\\n"
      "  add x2, sp, #8\\n"
      "  mov x6, sp\\n"
      "  adrp x0, main\\n"
      "  add x0, x0, :lo12:main\\n"
      "  adrp x3, silk_gnu_initialize\\n"
      "  add x3, x3, :lo12:silk_gnu_initialize\\n"
      "  mov x4, #0\\n"
      "  bl __libc_start_main\\n"
      "  brk #0\\n"
      ".size _start, .-_start\\n");
    #endif
    """
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

// The words of `line`, split at spaces.
fn word(line: &[u8], start: usize) -> usize {
  let mut end = start
  while end < line.length && line[end] != 32 { end = end + usize.ONE }
  return end
}

// A line of the table as its library, its version for the target and its symbols, or none when
// the line is blank or serves the other architecture.
struct Entry<'a> {
  library: &'a [u8],
  version: &'a [u8],
  symbols: &'a [u8],
}

fn entry<'a>(line: &'a [u8], aarch64: bool) -> Option<Entry<'a>> {
  let mut start = usize.ZERO
  while start < line.length && line[start] == 32 { start = start + usize.ONE }
  if start == line.length { return Option<Entry<'a>>.none() }
  let mut libraryEnd = word(line, start)
  let first = Slice.view<u8>(line, start, libraryEnd - start)
  let x86 = same(first, b"x86_64")
  let arm = same(first, b"aarch64")
  if x86 && aarch64 || arm && !aarch64 { return Option<Entry<'a>>.none() }
  if x86 || arm {
    start = libraryEnd + usize.ONE
    libraryEnd = word(line, start)
  }
  let versionEnd = word(line, libraryEnd + usize.ONE)
  // The version is followed by `:`.
  let mut version = Slice.view<u8>(line, libraryEnd + usize.ONE, versionEnd - libraryEnd - usize.add(0, 2))
  // aarch64 glibc starts at 2.17: on a line for both architectures, every older version is 2.17.
  let prefix = b"GLIBC_"
  if aarch64 && !arm && version.length > prefix.length && same(Slice.view<u8>(version, usize.ZERO, prefix.length), prefix)
    && PlatformSupplies.compareVersions(Slice.view<u8>(version, prefix.length, version.length - prefix.length), b"2.17") < 0 {
    version = b"GLIBC_2.17"
  }
  return Option<Entry<'a>>.some(Entry {
    library: Slice.view<u8>(line, start, libraryEnd - start),
    version: version,
    symbols: Slice.view<u8>(line, versionEnd + usize.ONE, line.length - versionEnd - usize.ONE),
  })
}

fn lineEnd(text: &[u8], start: usize) -> usize {
  let mut end = start
  while end < text.length && text[end] != 10 { end = end + usize.ONE }
  return end
}

// The size after `=` of a data symbol, or zero for a function.
fn objectSize(symbol: &[u8]) -> usize {
  let mut at = usize.ZERO
  while at < symbol.length && symbol[at] != 61 { at = at + usize.ONE }
  let mut size = usize.ZERO
  at = at + usize.ONE
  while at < symbol.length {
    size = size * usize.add(0, 10) + (u8.toUsize(symbol[at]) - usize.add(0, 48))
    at = at + usize.ONE
  }
  return size
}

fn symbolName(symbol: &[u8]) -> &[u8] {
  let mut at = usize.ZERO
  while at < symbol.length && symbol[at] != 61 { at = at + usize.ONE }
  return Slice.view<u8>(symbol, usize.ZERO, at)
}

effect fn appendDecimal(text: &mut Bytes, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= usize.add(0, 10) { run appendDecimal(&mut text.*, value / usize.add(0, 10)) }
  let digit = [usize.toU8(value % usize.add(0, 10)) + 48]
  run Bytes.append(&mut text.*, &digit)
}

/// The assembly that defines each symbol the table lists for `library`, functions as empty labels
/// and data objects with their sizes.
pub effect fn stubSource(library: &[u8], aarch64: bool) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let table = String.utf8Bytes(symbols())
  let mut functions = run Bytes.copy(b".text\n")
  let mut objects = run Bytes.copy(b".data\n")
  let mut start = usize.ZERO
  while start < table.length {
    let end = lineEnd(table, start)
    let mut names: &[u8] = b""
    if let Option<Entry>.Some {value: listed} = entry(Slice.view<u8>(table, start, end - start), aarch64) {
      if same(listed.library, library) { names = listed.symbols }
    }
    if names.length > usize.ZERO {
      let mut at = usize.ZERO
      while at < names.length {
        let close = word(names, at)
        let symbol = Slice.view<u8>(names, at, close - at)
        let name = symbolName(symbol)
        let size = objectSize(symbol)
        if size == usize.ZERO {
          run Bytes.append(&mut functions, b".globl ")
          run Bytes.append(&mut functions, name)
          run Bytes.append(&mut functions, b"\n.type ")
          run Bytes.append(&mut functions, name)
          run Bytes.append(&mut functions, b", %function\n")
          run Bytes.append(&mut functions, name)
          run Bytes.append(&mut functions, b":\n")
        } else {
          run Bytes.append(&mut objects, b".globl ")
          run Bytes.append(&mut objects, name)
          run Bytes.append(&mut objects, b"\n.type ")
          run Bytes.append(&mut objects, name)
          run Bytes.append(&mut objects, b", %object\n.size ")
          run Bytes.append(&mut objects, name)
          run Bytes.append(&mut objects, b", ")
          run appendDecimal(&mut objects, size)
          run Bytes.append(&mut objects, b"\n")
          run Bytes.append(&mut objects, name)
          run Bytes.append(&mut objects, b":\n.zero ")
          run appendDecimal(&mut objects, size)
          run Bytes.append(&mut objects, b"\n")
        }
        at = close + usize.ONE
      }
    }
    start = end + usize.ONE
  }
  run Bytes.append(&mut functions, Bytes.asSlice(&objects))
  return move functions
}

/// The version script of the stub `library`: one node per version the table
/// lists for it, each inheriting the one before, and every other symbol local.
pub effect fn versionScript(library: &[u8], aarch64: bool) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let table = String.utf8Bytes(symbols())
  let mut script = Bytes.make()
  // The version of the open node, and the version that node inherits.
  let mut current = Bytes.make()
  let mut parent = Bytes.make()
  let mut start = usize.ZERO
  while start < table.length {
    let end = lineEnd(table, start)
    if let Option<Entry>.Some {value: listed} = entry(Slice.view<u8>(table, start, end - start), aarch64) {
      if same(listed.library, library) {
        if !same(Bytes.asSlice(&current), listed.version) {
          if Bytes.length(&current) > usize.ZERO {
            run closeNode(&mut script, &parent)
            parent = move current
          }
          run Bytes.append(&mut script, listed.version)
          run Bytes.append(&mut script, b" {\n  global:\n")
          current = run Bytes.copy(listed.version)
        }
        let names = listed.symbols
        let mut at = usize.ZERO
        while at < names.length {
          let close = word(names, at)
          run Bytes.append(&mut script, b"    ")
          run Bytes.append(&mut script, symbolName(Slice.view<u8>(names, at, close - at)))
          run Bytes.append(&mut script, b";\n")
          at = close + usize.ONE
        }
      }
    }
    start = end + usize.ONE
  }
  if Bytes.length(&current) > usize.ZERO { run closeNode(&mut script, &parent) }
  return move script
}

// Ends the open node. The first node, which inherits none, makes every other symbol local.
effect fn closeNode(script: &mut Bytes, parent: &Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
  if Bytes.length(parent) == usize.ZERO {
    run Bytes.append(&mut script.*, b"  local:\n    *;\n};\n")
    return ()
  }
  run Bytes.append(&mut script.*, b"} ")
  run Bytes.append(&mut script.*, Bytes.asSlice(parent))
  run Bytes.append(&mut script.*, b";\n")
}

/// The program interpreter glibc installs for `target`.
pub fn interpreter(target: &Target) -> &'static [u8] {
  if same(Target.architecture(target), b"aarch64") { return b"/lib/ld-linux-aarch64.so.1" }
  return b"/lib64/ld-linux-x86-64.so.2"
}

// The file `<stem><suffix>` in the link's scratch directory. Every file this module writes is
// named after the link's staged output, so the link stamp names it by its suffix alone.
effect fn scratchFile(stem: &[u8], suffix: &[u8]) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
  let mut name = run Bytes.copy(stem)
  run Bytes.append(&mut name, suffix)
  return run Path.fromBytes(Bytes.asSlice(&name))
}

effect fn librarySuffix(library: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut suffix = run Bytes.copy(b".silk-glibc-")
  run Bytes.append(&mut suffix, library)
  return move suffix
}

/// Links without the C compiler's startup files and libraries, with glibc's program interpreter
/// for `target`, and adds the startup object and the stub libraries that `build` writes under
/// `stem`. The stub libraries are needed only when the program uses one of their symbols.
pub effect fn configure(process: &mut ProcessRequest, stem: &[u8], target: &Target) -> ()
! FileError | OutOfMemoryError ? &mut Allocator {
  run ChildProcess.addArgument(&mut process.*, "-nostdlib")
  run ChildProcess.addArgument(&mut process.*, "-Xlinker")
  let mut loader = run Bytes.copy(b"--dynamic-linker=")
  run Bytes.append(&mut loader, interpreter(target))
  run ChildProcess.addArgumentBytes(&mut process.*, Bytes.asSlice(&loader))
  let start = run scratchFile(stem, b".silk-start.o")
  run NativeToolchain.addPathArgument(&mut process.*, &start)
  run ChildProcess.addArgument(&mut process.*, "-Xlinker")
  run ChildProcess.addArgument(&mut process.*, "--as-needed")
  let names = libraries()
  let mut at = usize.ZERO
  while at < names.length {
    let suffix = run librarySuffix(names[at])
    let library = run scratchFile(stem, Bytes.asSlice(&suffix))
    run NativeToolchain.addPathArgument(&mut process.*, &library)
    at = at + usize.ONE
  }
  run ChildProcess.addArgument(&mut process.*, "-Xlinker")
  run ChildProcess.addArgument(&mut process.*, "--no-as-needed")
}

// Runs `request`, copies its error output to standard error, and returns its exit status.
effect fn submitted(request: &ProcessRequest) -> i32
! ProcessError | OutOfMemoryError | WriterError ? &mut ChildProcess | &mut Allocator {
  let result = run ChildProcess.submit(request)
  let mut stderr = StderrWriter.make()
  run Writer.writeAll(ChildProcess.errorBytes(&result)) |> Effect.provideMut<Writer>(&mut stderr)
  return Option<i32>.unwrapOr(ChildProcess.exitCode(&result), 2)
}

effect fn targetArgument(request: &mut ProcessRequest, target: &Target) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut selected = run Bytes.copy(b"--target=")
  run Bytes.append(&mut selected, Target.llvmTriple(target))
  run ChildProcess.addArgumentBytes(&mut request.*, Bytes.asSlice(&selected))
}

/// Writes and builds the startup object and the stub libraries that `configure` named under
/// `stem`. Each stub library is linked by `clang` with `linker`, the options that select the
/// program's own linker. Returns 0, or the exit status of the first tool that failed.
pub effect fn build(clang: &Path, linker: &[Bytes], stem: &[u8], target: &Target) -> i32
! FileError | HostInputError | ProcessError | OutOfMemoryError | WriterError
? &mut FileSystem | &mut HostInput | &mut ChildProcess | &mut Allocator {
  let aarch64 = same(Target.architecture(target), b"aarch64")
  let names = libraries()
  let mut at = usize.ZERO
  while at < names.length {
    let suffix = run librarySuffix(names[at])
    let library = run scratchFile(stem, Bytes.asSlice(&suffix))
    let mut sourceSuffix = run Bytes.copy(Bytes.asSlice(&suffix))
    run Bytes.append(&mut sourceSuffix, b".s")
    let source = run scratchFile(stem, Bytes.asSlice(&sourceSuffix))
    let assembly = run stubSource(names[at], aarch64)
    run FileSystem.writeFile(&source, Bytes.asSlice(&assembly))
    let mut scriptSuffix = run Bytes.copy(Bytes.asSlice(&suffix))
    run Bytes.append(&mut scriptSuffix, b".map")
    let script = run scratchFile(stem, Bytes.asSlice(&scriptSuffix))
    let text = run versionScript(names[at], aarch64)
    run FileSystem.writeFile(&script, Bytes.asSlice(&text))
    let mut request = run NativeToolchain.request(clang)
    run targetArgument(&mut request, target)
    run ChildProcess.addArgument(&mut request, "-nostdlib")
    run ChildProcess.addArgument(&mut request, "-shared")
    let mut flag = usize.ZERO
    while flag < linker.length {
      run ChildProcess.addArgumentBytes(&mut request, Bytes.asSlice(&linker[flag]))
      flag = flag + usize.ONE
    }
    run ChildProcess.addArgument(&mut request, "-Xlinker")
    run ChildProcess.addArgument(&mut request, "-soname")
    run ChildProcess.addArgument(&mut request, "-Xlinker")
    run ChildProcess.addArgumentBytes(&mut request, names[at])
    run ChildProcess.addArgument(&mut request, "-Xlinker")
    let mut versions = run Bytes.copy(b"--version-script=")
    let scriptPath = run NativeToolchain.pathBytes(&script)
    run Bytes.append(&mut versions, Bytes.asSlice(&scriptPath))
    run ChildProcess.addArgumentBytes(&mut request, Bytes.asSlice(&versions))
    run ChildProcess.addArgument(&mut request, "-x")
    run ChildProcess.addArgument(&mut request, "assembler")
    run NativeToolchain.addPathArgument(&mut request, &source)
    run ChildProcess.addArgument(&mut request, "-o")
    run NativeToolchain.addPathArgument(&mut request, &library)
    let status = run submitted(&request)
    if status != 0 { return status }
    at = at + usize.ONE
  }
  let startSourcePath = run scratchFile(stem, b".silk-start.c")
  let startObject = run scratchFile(stem, b".silk-start.o")
  run FileSystem.writeFile(&startSourcePath, String.utf8Bytes(startSource()))
  let mut request = run NativeToolchain.request(clang)
  run targetArgument(&mut request, target)
  run ChildProcess.addArgument(&mut request, "-ffreestanding")
  run ChildProcess.addArgument(&mut request, "-fno-stack-protector")
  // Position-independent code links into both fixed-address and position-independent programs.
  run ChildProcess.addArgument(&mut request, "-fPIC")
  run ChildProcess.addArgument(&mut request, "-O2")
  run ChildProcess.addArgument(&mut request, "-c")
  run NativeToolchain.addPathArgument(&mut request, &startSourcePath)
  run ChildProcess.addArgument(&mut request, "-o")
  run NativeToolchain.addPathArgument(&mut request, &startObject)
  return run submitted(&request)
}
