//! The GNU/Linux executable's link stubs, startup code and compiler builtins. With them any host
//! links a dynamically linked glibc program for x86_64 or aarch64 Linux without a sysroot, a GCC
//! installation or libgcc: the stub libraries stand in for glibc at link time, and the program
//! runs against the real glibc 2.28 or later on the target.

import driver.NativeToolchain
import driver.PlatformSupply as PlatformSupplies
import semantic.Target {Target}
import silk.io.writer_native {StderrWriter}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.system.filesystem {FileSystem, FileError, Path}
import silk.system.host_input {HostInput, HostInputError}
import silk.system.child_process {ChildProcess, ProcessRequest, ProcessError}
import silk.io.writer {Writer, WriterError}
import silk.collections.bytes {Bytes}
import silk.collections.slice {Slice}
import silk.text.string {String}
import silk.num.u8
import silk.num.usize

/// Every symbol glibc 2.28 exports for programs to link, from its x86_64 and aarch64 ABI lists,
/// and the two unwinder functions of `libgcc_s.so.1` that trap reports walk the stack with. Each
/// line names a library, a symbol version and symbols of that version, with `=size` after a data
/// object, so a copy relocation reserves its real size. A line for both architectures gives the
/// x86_64 version: aarch64 glibc starts at 2.17, so an older x86_64 version is `GLIBC_2.17` there.
/// A line that starts with `x86_64` or `aarch64` serves that architecture alone. A symbol newer
/// than glibc 2.28 needs a fallback in the standard library: the stubs never define one.
pub fn symbols() -> string<'static> {
  return """
    libc.so.6 GLIBC_2.2.5: _Exit _IO_2_1_stderr_=224 _IO_2_1_stdin_=224 _IO_2_1_stdout_=224
    libc.so.6 GLIBC_2.2.5: _IO_adjust_column _IO_adjust_wcolumn _IO_default_doallocate
    libc.so.6 GLIBC_2.2.5: _IO_default_finish _IO_default_pbackfail _IO_default_uflow _IO_default_xsgetn
    libc.so.6 GLIBC_2.2.5: _IO_default_xsputn _IO_do_write _IO_doallocbuf _IO_fclose _IO_fdopen _IO_feof
    libc.so.6 GLIBC_2.2.5: _IO_ferror _IO_fflush _IO_fgetpos _IO_fgetpos64 _IO_fgets _IO_file_attach
    libc.so.6 GLIBC_2.2.5: _IO_file_close _IO_file_close_it _IO_file_doallocate _IO_file_finish
    libc.so.6 GLIBC_2.2.5: _IO_file_fopen _IO_file_init _IO_file_jumps=168 _IO_file_open
    libc.so.6 GLIBC_2.2.5: _IO_file_overflow _IO_file_read _IO_file_seek _IO_file_seekoff
    libc.so.6 GLIBC_2.2.5: _IO_file_setbuf _IO_file_stat _IO_file_sync _IO_file_underflow _IO_file_write
    libc.so.6 GLIBC_2.2.5: _IO_file_xsputn _IO_flockfile _IO_flush_all _IO_flush_all_linebuffered
    libc.so.6 GLIBC_2.2.5: _IO_fopen _IO_fprintf _IO_fputs _IO_fread _IO_free_backup_area
    libc.so.6 GLIBC_2.2.5: _IO_free_wbackup_area _IO_fsetpos _IO_fsetpos64 _IO_ftell _IO_ftrylockfile
    libc.so.6 GLIBC_2.2.5: _IO_funlockfile _IO_fwrite _IO_getc _IO_getline _IO_getline_info _IO_gets
    libc.so.6 GLIBC_2.2.5: _IO_init _IO_init_marker _IO_init_wmarker _IO_iter_begin _IO_iter_end
    libc.so.6 GLIBC_2.2.5: _IO_iter_file _IO_iter_next _IO_least_wmarker _IO_link_in _IO_list_all=8
