//! Native tool requests preserve explicit executable and environment policy without host I/O.

import driver.NativeToolchain
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.child_process { ChildProcess, ProcessRequest }
import silk.effect { Effect }
import silk.filesystem { FileError }
import silk.host_input { HostInput, HostInputError }
import silk.option { Option }
import silk.result { Result }
import silk.testing { AssertionError, Testing }
import silk.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

struct Input {
  present: bool
  sdk: bool
  failPath: bool
  archiver: bool
  queries: usize
}

impl Input {
  effect fn argumentCount(self: &mut Self) -> usize
    ! HostInputError {
    return 0
  }

  effect fn argument(self: &mut Self, index: usize) -> Option<Bytes>
    ! HostInputError | OutOfMemoryError
    ? &mut Allocator {
    return Option<Bytes>.none()
  }

  effect fn workingDirectory(self: &mut Self) -> Bytes
    ! HostInputError | OutOfMemoryError
    ? &mut Allocator {
    return run Bytes.copy(b"/working")
  }

  effect fn variable(self: &mut Self, name: &[u8]) -> Option<Bytes>
    ! HostInputError | OutOfMemoryError
    ? &mut Allocator {
    self.queries = self.queries + usize.ONE
    if same(name, b"PATH") && self.failPath {
      fail HostInput.inputFailure()
    }
    if
      !self.present {
      return Option<Bytes>.none()
    }
    if same(name, b"SILKC_CLANG") {
      return Option<Bytes>.some(run Bytes.copy(b"/configured/clang"))
    }
    if same(name, b"SILKC_AR") {
      if self.archiver {
        return Option<Bytes>.some(run Bytes.copy(b"/tools/llvm-ar-22"))
      }
      return Option<Bytes>.none()
    }
    if same(name, b"PATH") {
      return Option<Bytes>.some(run Bytes.copy(b"/tools:/usr/bin"))
    }
    if same(name, b"SDKROOT") {
      if self.sdk {
        return Option<Bytes>.some(run Bytes.copy(b"/sdk/MacOSX.sdk"))
      }
      return Option<Bytes>.none()
    }
    if same(name, b"HOME") {
      return Option<Bytes>.some(Bytes.make())
    }
    if same(name, b"TMPDIR") {
      return Option<Bytes>.some(run Bytes.copy(b"/tmp/\xff"))
    }
    if same(name, b"TMP") || same(name, b"TEMP") || same(name, b"LANG") || same(name, b"LC_ALL")
      || same(name, b"LC_CTYPE") {
      return Option<Bytes>.none()
    }

    // Unexpected ambient variables must not be read, including compiler flags and tool overrides.
    fail HostInput.inputFailure()
  }
}

impl HostInput for Input {
  argumentCount: Input.argumentCount

  argument: Input.argument

  workingDirectory: Input.workingDirectory

  variable: Input.variable
}

effect fn requestPolicy() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let mut input = Input { present: true, sdk: false, failPath: false, archiver: false, queries: 0 }
  let request = run NativeToolchain.request() |> Effect.provideMut<HostInput>(&mut input)
  run Testing.expect(
    same(ChildProcess.program(&request), b"/configured/clang"),
    "configured compiler path is retained"
  )
  run Testing.expect(
    input.queries == 10,
    "only the compiler path and nine standard variables are read"
  )
  run Testing.expect(
    ChildProcess.environmentCount(&request) == 3,
    "unset values are omitted while empty values are retained"
  )
  run Testing.expect(
    same(ChildProcess.environment(&request), b"PATH=/tools:/usr/bin\0HOME=\0TMPDIR=/tmp/\xff\0"),
    "tool environment retains exact bytes and order"
  )
  run Testing.expect(
    ChildProcess.argumentCount(&request) == 0 && !ChildProcess.hasWorkingDirectory(&request),
    "request construction leaves arguments and directory to the caller"
  )
  input.sdk = true
  let sdk = run NativeToolchain.request() |> Effect.provideMut<HostInput>(&mut input)
  run Testing.expect(
    same(
      ChildProcess.environment(&sdk),
      b"PATH=/tools:/usr/bin\0SDKROOT=/sdk/MacOSX.sdk\0HOME=\0TMPDIR=/tmp/\xff\0"
    ),
    "a selected SDK reaches the compiler exactly, and only when the host sets one"
  )
  input.present = false
  let absent = run NativeToolchain.request() |> Effect.provideMut<HostInput>(&mut input)
  run Testing.expect(
    same(ChildProcess.program(&absent), b"/usr/bin/clang")
      && ChildProcess.environmentCount(&absent) == 0,
    "absent host variables select the default compiler and stay absent"
  )
  input.failPath = true
  let failed = run Effect.result(
    NativeToolchain.request() |> Effect.provideMut<HostInput>(&mut input)
  )
  let rejectsFailure = match move failed {
    Result<ProcessRequest, FileError | HostInputError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      HostInputError {} => true
      _ => false
    }
    Result<ProcessRequest, FileError | HostInputError | OutOfMemoryError>.Success {
      value: _
    } => false
  }
  run Testing.expect(
    rejectsFailure,
    "host lookup failure propagates rather than silently losing linker search paths"
  )
}

effect fn archiverPolicy() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let mut input = Input { present: true, sdk: false, failPath: false, archiver: false, queries: 0 }
  let beside = run NativeToolchain.archiver() |> Effect.provideMut<HostInput>(&mut input)
  input.archiver = true
  let configured = run NativeToolchain.archiver() |> Effect.provideMut<HostInput>(&mut input)
  input.present = false
  let fallback = run NativeToolchain.archiver() |> Effect.provideMut<HostInput>(&mut input)
  run Testing.expect(
    same(ChildProcess.program(&beside), b"/configured/llvm-ar")
      && same(ChildProcess.program(&configured), b"/tools/llvm-ar-22")
      && same(ChildProcess.program(&fallback), b"/usr/bin/llvm-ar"),
    "the archiver is SILKC_AR, or else llvm-ar beside the configured or default Clang"
  )
  run Testing.expect(
    ChildProcess.environmentCount(&beside) == 0 && ChildProcess.environmentCount(&configured) == 0
      && ChildProcess.argumentCount(&configured) == 0,
    "an archiver request inherits no environment and leaves its arguments to the caller"
  )
}

test effect fn nativeArchiverRequestsFollowTheConfiguredToolchain() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run archiverPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn nativeCompilerRequestsRetainExplicitToolEnvironment() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run requestPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}
