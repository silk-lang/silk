//! The files one build read, recorded so that a later run can see, without building, that the
//! build would read the same and reuse its output.
//!
//! # Details
//! A [`Recorder`] is the filesystem a build runs on. It forwards each operation to the host
//! filesystem and notes each file the build read with the digest of its contents, each `stat`
//! with its answer, and each directory listing with a digest of its entries. Writes are not
//! noted, nor is anything at or below a file or directory the build made. [`encode`] stores the
//! notes after a key that names everything else the output depends on, such as the compiler,
//! profile and toolchain, and [`unchanged`] checks a stored record against the host filesystem.
//!
//! The record is `SLKBINP1`, the key, the payload, then the notes, each field framed with its
//! byte length as an 8-byte little-endian integer.

import semantic.ContentHash {ContentHash}
import silk.mem.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { AtomicWriteError, DirectoryEntry, DirectoryInfo, Durability, FileError, FileInfo, FileSystem, Path, PublicationPolicy }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.core.result { Result }
import silk.num.i32
import silk.collections.slice { Slice }
import silk.num.u64
import silk.num.u8
import silk.num.usize

const READ: u8 = 1

const STAT: u8 = 2

const LISTING: u8 = 3

// One note. For a read, `first` and `second` are the content digest, or both zero after a failed
// read. For a stat, `first` is 0 after a failure, 1 for a file and 2 for a directory, and `second`
// is a file's length. For a listing, they are the digest of the entries, or both zero after a
// failure.
struct Note {
  kind: u8,
  path: Bytes,
  first: u64,
  second: u64,
}

/// A host filesystem that notes what the build reads.
pub struct Recorder {
  native: MachineFileSystem,
  allocator: SystemAllocator,
  notes: List<Note>,
  // Files and directories the build made itself. They are outputs, so operations on them are not
  // noted: a temporary directory gets a new name each time.
  produced: List<Bytes>,
  // False once a note could not be kept; an incomplete record is never stored.
  complete: bool,
  // The child names of each directory listed, for `inputLines`, which keeps only the names the
  // build could have looked for.
  listed: List<Listed>,
}

// The child names one listing answered.
struct Listed {
  directory: Bytes,
  names: List<Bytes>,
}

/// A recorder over the host filesystem.
pub effect fn recorder() -> Recorder ! OutOfMemoryError ? &mut Allocator {
  let native = run MachineFileSystem.make()
  return Recorder {native: move native, allocator: Allocator.systemAllocatorProvider(), notes: List<Note>.make(), produced: List<Bytes>.make(), complete: true, listed: List<Listed>.make()}
}

/// Whether every operation the build ran could be noted.
pub fn complete(recorder: &Recorder) -> bool { return recorder.complete }

effect fn appendNote(notes: &mut List<Note>, kind: u8, path: &Path, first: u64, second: u64) -> bool ! OutOfMemoryError ? &mut Allocator {
  let listed = List<Note>.asSlice(&notes.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].kind == kind && same(Bytes.asSlice(&listed[at].path), Path.rawBytes(path)) {
      // Conflicting answers within one build cannot authenticate a single input snapshot.
      return listed[at].first == first && listed[at].second == second
    }
    at = at + usize.ONE
  }
  run List<Note>.append(&mut notes.*, Note {kind: kind, path: run Bytes.copy(Path.rawBytes(path)), first: first, second: second})
  return true
}

// Whether `path` is `prefix` or lies below it.
fn within(path: &[u8], prefix: &[u8]) -> bool {
  if path.length < prefix.length || !same(Slice.view<u8>(path, usize.ZERO, prefix.length), prefix) { return false }
  return path.length == prefix.length || path[prefix.length] == 47
}

// Whether `path` is at or below something the build made or the caller excluded.
fn excluded(recorder: &Recorder, path: &Path) -> bool {
  let produced = List<Bytes>.asSlice(&recorder.produced)
  let mut at = usize.ZERO
  while at < produced.length {
    if within(Path.rawBytes(path), Bytes.asSlice(&produced[at])) { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn note(recorder: &mut Recorder, kind: u8, path: &Path, first: u64, second: u64) -> () {
  if excluded(&recorder.*, path) { return () }
  let appended = run Effect.result(appendNote(&mut recorder.notes, kind, path, first, second)
    |> Effect.provideMut<Allocator>(&mut recorder.allocator))
  match move appended {
    Result<bool, OutOfMemoryError>.Success {value} => { if !value { recorder.complete = false } }
    Result<bool, OutOfMemoryError>.Failure {error} => { drop error recorder.complete = false }
  }
  return ()
}

/// Leaves everything at or under `path` out of the record, as the build's own output: a cache that
/// an outside process fills, such as the codegen cache Clang writes, is not an input.
pub effect fn exclude(recorder: &mut Recorder, path: &Path) -> () {
  return run produce(&mut recorder.*, path)
}

effect fn produce(recorder: &mut Recorder, path: &Path) -> () {
  let appended = run Effect.result(appendProduced(&mut recorder.produced, path)
    |> Effect.provideMut<Allocator>(&mut recorder.allocator))
  if let Result<(), OutOfMemoryError>.Failure {error} = move appended {
    drop error
    recorder.complete = false
  }
  return ()
}

effect fn appendProduced(produced: &mut List<Bytes>, path: &Path) -> () ! OutOfMemoryError ? &mut Allocator {
  return run List<Bytes>.append(&mut produced.*, run Bytes.copy(Path.rawBytes(path)))
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn statNote(answer: &(FileInfo | DirectoryInfo)) -> Note {
  return match &answer.* {
    FileInfo {byteLength} => Note {kind: STAT, path: Bytes.make(), first: 1, second: usize.toU64(byteLength)}
    DirectoryInfo {} => Note {kind: STAT, path: Bytes.make(), first: 2, second: 0}
  }
}

// The digest of a listing: each entry's name and kind in listed order. Names, not full paths, so
// the same directory listed in another checkout digests the same.
fn listingDigest(entries: &List<DirectoryEntry>) -> ContentHash {
  let listed = List<DirectoryEntry>.asSlice(entries)
  let mut stream = ContentHash.stream()
  let mut at = usize.ZERO
  while at < listed.length {
    let path = lastSegment(Path.rawBytes(&listed[at].path))
    ContentHash.append(&mut stream, path)
    ContentHash.appendByte(&mut stream, 0)
    ContentHash.appendByte(&mut stream, i32.toU8(listed[at].kind.code))
    at = at + usize.ONE
  }
  return ContentHash.finish(move stream)
}

effect fn keepNames(listed: &mut List<Listed>, path: &Path, entries: &List<DirectoryEntry>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut names = List<Bytes>.make()
  let children = List<DirectoryEntry>.asSlice(entries)
  let mut at = usize.ZERO
  while at < children.length {
    let mut name = run Bytes.copy(lastSegment(Path.rawBytes(&children[at].path)))
    let kind: [u8; 2] = [0, i32.toU8(children[at].kind.code)]
    run Bytes.append(&mut name, &kind)
    run List<Bytes>.append(&mut names, move name)
    at = at + usize.ONE
  }
  return run List<Listed>.append(&mut listed.*, Listed {directory: run Bytes.copy(Path.rawBytes(path)), names: move names})
}

// The part of `path` after its last `/`.
fn lastSegment(path: &[u8]) -> &[u8] {
  let mut at = path.length
  while at > usize.ZERO && path[at - usize.ONE] != 47 { at = at - usize.ONE }
  return Slice.view<u8>(path, at, path.length - at)
}

impl FileSystem for Recorder {
  effect fn readFile(self: &mut Self, path: &Path) -> Bytes ! FileError | OutOfMemoryError ? &mut Allocator {
    let read = run Effect.result(FileSystem.readFile(path) |> Effect.provideMut<FileSystem>(&mut self.native))
    let value = match move read {
      Result<Bytes, FileError | OutOfMemoryError>.Success {value} => move value
      Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => {
        run note(&mut self.*, READ, path, 0, 0)
        match move error {
          FileError failure => { fail move failure }
          OutOfMemoryError exhausted => { fail move exhausted }
        }
      }
    }
    // An excluded file, such as a cache image, is not hashed.
    if excluded(&self.*, path) { return move value }
    let digest = ContentHash.of(Bytes.asSlice(&value))
    run note(&mut self.*, READ, path, digest.high, digest.low)
    return move value
  }
  effect fn writeFile(self: &mut Self, path: &Path, bytes: &[u8]) -> () ! FileError {
    run produce(&mut self.*, path)
    return run FileSystem.writeFile(path, bytes) |> Effect.provideMut<FileSystem>(&mut self.native)
  }
  effect fn createFile(self: &mut Self, path: &Path, bytes: &[u8]) -> () ! FileError {
    run FileSystem.createFile(path, bytes) |> Effect.provideMut<FileSystem>(&mut self.native)
    return run produce(&mut self.*, path)
  }
  effect fn writeFileAtomic(self: &mut Self, path: &Path, bytes: &[u8], policy: PublicationPolicy, durability: Durability) -> () ! AtomicWriteError {
    run produce(&mut self.*, path)
    return run FileSystem.writeFileAtomic(path, bytes, move policy, move durability) |> Effect.provideMut<FileSystem>(&mut self.native)
  }
  effect fn syncDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    return run FileSystem.syncDirectory(path) |> Effect.provideMut<FileSystem>(&mut self.native)
  }
  effect fn stat(self: &mut Self, path: &Path) -> FileInfo | DirectoryInfo ! FileError {
    let answer = run Effect.result(FileSystem.stat(path) |> Effect.provideMut<FileSystem>(&mut self.native))
    let value = match move answer {
      Result<FileInfo | DirectoryInfo, FileError>.Success {value} => move value
      Result<FileInfo | DirectoryInfo, FileError>.Failure {error} => {
        run note(&mut self.*, STAT, path, 0, 0)
        fail move error
      }
    }
    let observed = statNote(&value)
    run note(&mut self.*, STAT, path, observed.first, observed.second)
    return move value
  }
  effect fn listDirectory(self: &mut Self, path: &Path) -> List<DirectoryEntry> ! FileError | OutOfMemoryError ? &mut Allocator {
    let listed = run Effect.result(FileSystem.listDirectory(path) |> Effect.provideMut<FileSystem>(&mut self.native))
    let value = match move listed {
      Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success {value} => move value
      Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure {error} => {
        run note(&mut self.*, LISTING, path, 0, 0)
        match move error {
          FileError failure => { fail move failure }
          OutOfMemoryError exhausted => { fail move exhausted }
        }
      }
    }
    let digest = listingDigest(&value)
    run note(&mut self.*, LISTING, path, digest.high, digest.low)
    if !excluded(&self.*, path) {
      let kept = run Effect.result(keepNames(&mut self.listed, path, &value) |> Effect.provideMut<Allocator>(&mut self.allocator))
      if let Result<(), OutOfMemoryError>.Failure {error} = move kept {
        drop error
        self.complete = false
      }
    }
    return move value
  }
  effect fn createDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    // Only a directory this call made is an output; an existing one may hold inputs.
    run FileSystem.createDirectory(path) |> Effect.provideMut<FileSystem>(&mut self.native)
    return run produce(&mut self.*, path)
  }
  effect fn removeFile(self: &mut Self, path: &Path) -> () ! FileError {
    return run FileSystem.removeFile(path) |> Effect.provideMut<FileSystem>(&mut self.native)
  }
  effect fn removeDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    return run FileSystem.removeDirectory(path) |> Effect.provideMut<FileSystem>(&mut self.native)
  }
  effect fn createTemporaryDirectory(self: &mut Self, parent: &Path, prefix: &[u8]) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    let made = run FileSystem.createTemporaryDirectory(parent, prefix) |> Effect.provideMut<FileSystem>(&mut self.native)
    run produce(&mut self.*, &made)
    return move made
  }
}

effect fn appendWord(output: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut index = usize.ZERO
  while index < 8 {
    let byte = [u64.toU8(u64.bitAnd(u64.shiftRight(value, usize.toU64(index * 8)), 255))]
    run Bytes.append(&mut output.*, &byte)
    index = index + usize.ONE
  }
  return ()
}

effect fn appendField(output: &mut Bytes, value: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run appendWord(&mut output.*, usize.toU64(value.length))
  return run Bytes.append(&mut output.*, value)
}

/// The record of `recorder`'s notes under `key`, carrying `payload` for the caller.
pub effect fn encode(key: &[u8], payload: &[u8], recorder: &Recorder) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut output = run Bytes.copy(b"SLKBINP1")
  run appendField(&mut output, key)
  run appendField(&mut output, payload)
  let notes = List<Note>.asSlice(&recorder.notes)
  run appendWord(&mut output, usize.toU64(notes.length))
  let mut at = usize.ZERO
  while at < notes.length {
    let kind = [notes[at].kind]
    run Bytes.append(&mut output, &kind)
    run appendField(&mut output, Bytes.asSlice(&notes[at].path))
    run appendWord(&mut output, notes[at].first)
    run appendWord(&mut output, notes[at].second)
    at = at + usize.ONE
  }
  return move output
}

// A cursor over a stored record. A read past the end leaves `failed` set and reads as empty.
struct Reader<'a> {
  bytes: &'a [u8],
  at: usize,
  failed: bool,
}

fn readWord(reader: &mut Reader<'_>) -> u64 {
  if reader.failed || reader.bytes.length - reader.at < 8 {
    reader.failed = true
    return 0
  }
  let mut value: u64 = 0
  let mut index = usize.ZERO
  while index < 8 {
    value = u64.bitOr(value, u64.shiftLeft(u8.toU64(reader.bytes[reader.at + index]), usize.toU64(index * 8)))
    index = index + usize.ONE
  }
  reader.at = reader.at + 8
  return value
}

fn readField<'a>(reader: &mut Reader<'a>) -> &'a [u8] {
  let length = readWord(&mut reader.*)
  if reader.failed || u64.toUsize(length) > reader.bytes.length - reader.at {
    reader.failed = true
    return Slice.view<u8>(reader.bytes, usize.ZERO, usize.ZERO)
  }
  let start = reader.at
  reader.at = reader.at + u64.toUsize(length)
  return Slice.view<u8>(reader.bytes, start, u64.toUsize(length))
}

fn readByte(reader: &mut Reader<'_>) -> u8 {
  if reader.failed || reader.at >= reader.bytes.length {
    reader.failed = true
    return 0
  }
  let value = reader.bytes[reader.at]
  reader.at = reader.at + usize.ONE
  return value
}

// Whether the host filesystem still answers one note the way it did.
effect fn holds(kind: u8, path: &Path, first: u64, second: u64) -> bool ? &mut FileSystem | &mut Allocator {
  if kind == READ {
    let read = run Effect.result(FileSystem.readFile(path))
    if let Result<Bytes, FileError | OutOfMemoryError>.Success {value} = &read {
      let digest = ContentHash.of(Bytes.asSlice(&value))
      return digest.high == first && digest.low == second && (first != 0 || second != 0)
    }
    drop read
    return first == 0 && second == 0
  }
  if kind == STAT {
    let answer = run Effect.result(FileSystem.stat(path))
    if let Result<FileInfo | DirectoryInfo, FileError>.Success {value} = &answer {
      let observed = statNote(&value)
      return observed.first == first && observed.second == second
    }
    drop answer
    return first == 0
  }
  if kind == LISTING {
    let listed = run Effect.result(FileSystem.listDirectory(path))
    if let Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success {value} = &listed {
      let digest = listingDigest(&value)
      return digest.high == first && digest.low == second
    }
    drop listed
    return first == 0 && second == 0
  }
  return false
}

/// The payload of `record` when it was stored under `key` and every input it notes still reads
/// the same, otherwise none.
pub effect fn unchanged(record: &[u8], key: &[u8]) -> Option<Bytes> ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  if record.length < 8 || !same(Slice.view<u8>(record, usize.ZERO, 8), b"SLKBINP1") { return Option<Bytes>.none() }
  let mut reader = Reader {bytes: record, at: 8, failed: false}
  let stored = readField(&mut reader)
  if reader.failed || !same(stored, key) { return Option<Bytes>.none() }
  let payload = readField(&mut reader)
  let count = readWord(&mut reader)
  let mut at: u64 = 0
  while at < count && !reader.failed {
    let kind = readByte(&mut reader)
    let text = readField(&mut reader)
    let first = readWord(&mut reader)
    let second = readWord(&mut reader)
    if reader.failed { return Option<Bytes>.none() }
    let path = run Effect.result(Path.fromBytes(text))
    let located = match move path {
      Result<Path, FileError | OutOfMemoryError>.Success {value} => move value
      Result<Path, FileError | OutOfMemoryError>.Failure {error} => match move error {
        FileError failure => { drop failure return Option<Bytes>.none() }
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
    if !run holds(kind, &located, first, second) { return Option<Bytes>.none() }
    at = at + 1
  }
  if reader.failed || reader.at != record.length { return Option<Bytes>.none() }
  return Option<Bytes>.some(run Bytes.copy(payload))
}

/// A directory that [`inputLines`] names the inputs below it from, as `label` then the path
/// relative to `directory`, such as `std/silk/core/option.silk` for the standard library.
pub struct Anchor {
  /// The directory, as the build named it.
  pub directory: Bytes,
  /// The name its inputs are listed under; empty to list them by their relative path alone.
  pub label: Bytes,
}

/// The inputs `recorder` noted, one line each and sorted, with every path below an anchor named
/// from it, so the same inputs in another checkout or on another machine list the same.
///
/// # Details
/// Each line is `<kind> <answer> <path>`: `read <digest>` for a file the build read, as 32
/// hexadecimal digits of its content hash; `stat file:<length>` or `stat directory` for a path it
/// looked at; `list <digest>` for a directory it listed, digesting the entry names and kinds; and
/// `missing` in place of the answer when the look failed. A path below no anchor is written as
/// the build named it. The first anchor that holds a path names it, so a nested anchor is listed
/// before the one that encloses it.
pub effect fn inputLines(recorder: &Recorder, anchors: &[Anchor]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let notes = List<Note>.asSlice(&recorder.notes)
  let mut lines = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < notes.length {
    let note = &notes[at]
    let mut line = Bytes.make()
    if note.kind == READ {
      run Bytes.append(&mut line, b"read ")
      if note.first == 0 && note.second == 0 {
        run Bytes.append(&mut line, b"missing")
      } else {
        run appendHex(&mut line, note.first)
        run appendHex(&mut line, note.second)
      }
    } else if note.kind == STAT {
      run Bytes.append(&mut line, b"stat ")
      if note.first == 1 {
        run Bytes.append(&mut line, b"file:")
        run appendDecimal(&mut line, note.second)
      } else if note.first == 2 {
        run Bytes.append(&mut line, b"directory")
      } else {
        run Bytes.append(&mut line, b"missing")
      }
    } else {
      run Bytes.append(&mut line, b"list ")
      if note.first == 0 && note.second == 0 {
        run Bytes.append(&mut line, b"missing")
      } else {
        let digest = run relevantListing(recorder, Bytes.asSlice(&note.path))
        run appendHex(&mut line, digest.high)
        run appendHex(&mut line, digest.low)
      }
    }
    run Bytes.append(&mut line, b" ")
    run appendAnchored(&mut line, Bytes.asSlice(&note.path), anchors)
    run List<Bytes>.append(&mut lines, move line)
    at = at + usize.ONE
  }
  // Ordered by the path, then the kind: binary insertion into a list of positions.
  let written = List<Bytes>.asSlice(&lines)
  let mut order = List<usize>.make()
  let mut placed = usize.ZERO
  while placed < written.length {
    let ranked = List<usize>.asSlice(&order)
    let mut low = usize.ZERO
    let mut high = ranked.length
    while low < high {
      let middle = low + (high - low) / 2
      if lineBefore(Bytes.asSlice(&written[ranked[middle]]), Bytes.asSlice(&written[placed])) { low = middle + usize.ONE } else { high = middle }
    }
    let one: [usize; 1] = [placed]
    run List<usize>.insertSlice(&mut order, low, &one)
    placed = placed + usize.ONE
  }
  let mut output = Bytes.make()
  let ranked = List<usize>.asSlice(&order)
  let mut moved = usize.ZERO
  while moved < ranked.length {
    run Bytes.append(&mut output, Bytes.asSlice(&written[ranked[moved]]))
    run Bytes.append(&mut output, b"\n")
    moved = moved + usize.ONE
  }
  return move output
}

// The digest of the names in the listing of `directory` that the build could have looked for: those
// equal, once ASCII letters are folded to lower case, to the next component of a path some other
// note names below it. A file added beside the imported ones leaves it unchanged; a file renamed
// to another letter case, which the load refuses, changes it.
effect fn relevantListing(recorder: &Recorder, directory: &[u8]) -> ContentHash ! OutOfMemoryError ? &mut Allocator {
  let mut stream = ContentHash.stream()
  let listings = List<Listed>.asSlice(&recorder.listed)
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < listings.length {
    if same(Bytes.asSlice(&listings[at].directory), directory) { found = at }
    at = at + usize.ONE
  }
  if found == usize.MAX { return ContentHash.finish(move stream) }
  let names = List<Bytes>.asSlice(&listings[found].names)
  let notes = List<Note>.asSlice(&recorder.notes)
  let mut wanted = List<Bytes>.make()
  at = usize.ZERO
  while at < notes.length {
    let path = Bytes.asSlice(&notes[at].path)
    if path.length > directory.length + usize.ONE && within(path, directory) {
      let rest = Slice.view<u8>(path, directory.length + usize.ONE, path.length - directory.length - usize.ONE)
      let mut end = usize.ZERO
      while end < rest.length && rest[end] != 47 { end = end + usize.ONE }
      run List<Bytes>.append(&mut wanted, run Bytes.copy(Slice.view<u8>(rest, usize.ZERO, end)))
    }
    at = at + usize.ONE
  }
  let looked = List<Bytes>.asSlice(&wanted)
  // Listed order is the filesystem's; the kept names are digested in name order.
  let mut kept = List<usize>.make()
  let mut name = usize.ZERO
  while name < names.length {
    let entry = Bytes.asSlice(&names[name])
    let bare = Slice.view<u8>(entry, usize.ZERO, entry.length - 2)
    let mut hit = false
    let mut one = usize.ZERO
    while one < looked.length && !hit {
      hit = sameFolded(bare, Bytes.asSlice(&looked[one]))
      one = one + usize.ONE
    }
    if hit {
      let ranked = List<usize>.asSlice(&kept)
      let mut slot = usize.ZERO
      while slot < ranked.length && bytesBefore(Bytes.asSlice(&names[ranked[slot]]), entry) { slot = slot + usize.ONE }
      let placed: [usize; 1] = [name]
      run List<usize>.insertSlice(&mut kept, slot, &placed)
    }
    name = name + usize.ONE
  }
  let ranked = List<usize>.asSlice(&kept)
  at = usize.ZERO
  while at < ranked.length {
    ContentHash.append(&mut stream, Bytes.asSlice(&names[ranked[at]]))
    ContentHash.appendByte(&mut stream, 10)
    at = at + usize.ONE
  }
  return ContentHash.finish(move stream)
}

fn sameFolded(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    let mut a = left[at]
    let mut b = right[at]
    if a >= 65 && a <= 90 { a = a + 32 }
    if b >= 65 && b <= 90 { b = b + 32 }
    if a != b { return false }
    at = at + usize.ONE
  }
  return true
}

// `path` named from the first anchor that holds it, or as it is.
effect fn appendAnchored(line: &mut Bytes, path: &[u8], anchors: &[Anchor]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < anchors.length {
    let directory = Bytes.asSlice(&anchors[at].directory)
    if directory.length > usize.ZERO && within(path, directory) {
      let label = Bytes.asSlice(&anchors[at].label)
      let mut rest = Slice.view<u8>(path, directory.length, path.length - directory.length)
      if rest.length > usize.ZERO { rest = Slice.view<u8>(rest, usize.ONE, rest.length - usize.ONE) }
      run Bytes.append(&mut line.*, label)
      if label.length > usize.ZERO && rest.length > usize.ZERO { run Bytes.append(&mut line.*, b"/") }
      if label.length == usize.ZERO && rest.length == usize.ZERO { run Bytes.append(&mut line.*, b".") }
      return run Bytes.append(&mut line.*, rest)
    }
    at = at + usize.ONE
  }
  return run Bytes.append(&mut line.*, path)
}

// Whether line `left` sorts before `right`: by the path after the second space, then the whole line.
fn lineBefore(left: &[u8], right: &[u8]) -> bool {
  let leftPath = afterSecondSpace(left)
  let rightPath = afterSecondSpace(right)
  if !same(leftPath, rightPath) { return bytesBefore(leftPath, rightPath) }
  return bytesBefore(left, right)
}

fn afterSecondSpace(line: &[u8]) -> &[u8] {
  let mut spaces = usize.ZERO
  let mut at = usize.ZERO
  while at < line.length {
    if line[at] == 32 {
      spaces = spaces + usize.ONE
      if spaces == 2 { return Slice.view<u8>(line, at + usize.ONE, line.length - at - usize.ONE) }
    }
    at = at + usize.ONE
  }
  return line
}

fn bytesBefore(left: &[u8], right: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < left.length && at < right.length {
    if left[at] != right[at] { return left[at] < right[at] }
    at = at + usize.ONE
  }
  return left.length < right.length
}

effect fn appendHex(output: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let digits = b"0123456789abcdef"
  let mut at = usize.ZERO
  while at < 16 {
    let digit: [u8; 1] = [digits[u64.toUsize(u64.bitAnd(u64.shiftRight(value, usize.toU64((15 - at) * 4)), 15))]]
    run Bytes.append(&mut output.*, &digit)
    at = at + usize.ONE
  }
  return ()
}

effect fn appendDecimal(output: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 { run appendDecimal(&mut output.*, value / 10) }
  let digit: [u8; 1] = [u64.toU8(value % 10) + 48]
  return run Bytes.append(&mut output.*, &digit)
}
