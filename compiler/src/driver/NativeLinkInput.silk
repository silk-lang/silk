//! Native archive pins and resolved typed inputs contributed by package plans and requests.
//! Archive pins select a target variant and root or machine override. Link inputs preserve
//! declaration order and reject compiler flags that load code or introduce undeclared files.

import silk.build.request {
  Native as RequestNative,
  NativeSource as RequestSource,
  LinkInput as RequestLink
}
import driver.RequestText
import diagnostic.JsonText
import driver.ManifestText
import driver.NativeToolchain
import semantic.Target { Target }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.box { Box }
import silk.collections.bytes { Bytes }
import silk.system.child_process { ChildProcess, ProcessRequest }
import silk.core.effect { Effect }
import silk.system.filesystem { FileError, Path }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.text.string { String }
import silk.toml.value { Toml, TomlChild, Value as TomlValue }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.usize
import silk.collections.list { List }

/// A typed native input that violates the request contract or cannot link on its target.
pub struct InvalidNativeLinkInput {
  /// The manifest and entry at fault, when known, and the rule the input breaks.
  pub detail: Bytes,
}

/// Fails with `detail`.
pub effect fn invalid(detail: &[u8]) -> never
  ! InvalidNativeLinkInput | OutOfMemoryError
  ? &mut Allocator {
  fail InvalidNativeLinkInput { detail: run Bytes.copy(detail) }
}

/// How a named library is resolved by the linker.
pub enum Linkage {
  Static,
  Dynamic
}

/// The language of a native translation unit.
pub enum SourceLanguage {
  C,
  ObjectiveC,
  Cxx,
  ObjectiveCxx
}

/// One typed link input. Paths are resolved against the directory of the declaring manifest.
pub union NativeLinkInput {
  Object { pub path: Path },
  StaticArchive { pub path: Path },
  SearchPath { pub path: Path },
  FrameworkSearchPath { path: Path },
  RPath { pub value: Bytes },
  /// The diagnostic origin used when a target cannot link this input.
  LinkerScript { path: Path, entry: Bytes },
  Library { pub name: Bytes, linkage: Linkage, weak: bool, needed: bool, entry: Bytes },
  Framework { name: Bytes, weak: bool, needed: bool, entry: Bytes },
  /// Translation units and their declared flags and include directories, compiled before linking.
  Sources {
    pub language: SourceLanguage,
    pub files: List<Path>,
    pub flags: List<Bytes>,
    pub include: List<Path>,
    pub entry: Bytes
  },
}

/// An object input at `path`, as a compiled source links.
pub fn object(path: Path) -> NativeLinkInput {
  return NativeLinkInput.Object { path: move path }
}

/// A copy of `self`.
pub effect fn copy(self: &NativeLinkInput) -> NativeLinkInput
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &self.* {
    NativeLinkInput.Object { path } => NativeLinkInput.Object { path: run copyPath(&path) }
    NativeLinkInput.StaticArchive { path } => NativeLinkInput.StaticArchive {
      path: run copyPath(&path),
    }
    NativeLinkInput.SearchPath { path } => NativeLinkInput.SearchPath { path: run copyPath(&path) }
    NativeLinkInput.FrameworkSearchPath { path } => NativeLinkInput.FrameworkSearchPath {
      path: run copyPath(&path),
    }
    NativeLinkInput.RPath { value } => NativeLinkInput.RPath {
      value: run Bytes.copy(value.asSlice()),
    }
    NativeLinkInput.LinkerScript { path, entry } => NativeLinkInput.LinkerScript {
      path: run copyPath(&path),
      entry: run Bytes.copy(Bytes.asSlice(&entry)),
    }
    NativeLinkInput.Library { name, linkage, weak, needed, entry } => NativeLinkInput.Library {
      name: run Bytes.copy(Bytes.asSlice(&name)),
      linkage: linkage,
      weak: weak,
      needed: needed,
      entry: run Bytes.copy(Bytes.asSlice(&entry)),
    }
    NativeLinkInput.Framework { name, weak, needed, entry } => NativeLinkInput.Framework {
      name: run Bytes.copy(Bytes.asSlice(&name)),
      weak: weak,
      needed: needed,
      entry: run Bytes.copy(Bytes.asSlice(&entry)),
    }
    NativeLinkInput.Sources { language, files, flags, include, entry } => NativeLinkInput.Sources {
      language: language,
      files: run copyPaths(List<Path>.asSlice(&files)),
      flags: run copyTexts(List<Bytes>.asSlice(&flags)),
      include: run copyPaths(List<Path>.asSlice(&include)),
      entry: run Bytes.copy(Bytes.asSlice(&entry)),
    }
  }
}

effect fn copyPaths(paths: &[Path]) -> List<Path>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copied = List<Path>.make()
  let mut at = usize.ZERO
  while at < paths.length {
    run List<Path>.append(&mut copied, run copyPath(&paths[at]))
    at = at + usize.ONE
  }
  return move copied
}

effect fn copyTexts(texts: &[Bytes]) -> List<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copied = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < texts.length {
    run List<Bytes>.append(&mut copied, run Bytes.copy(Bytes.asSlice(&texts[at])))
    at = at + usize.ONE
  }
  return move copied
}

fn samePaths(left: &[Path], right: &[Path]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !sameText(Path.rawBytes(&left[at]), Path.rawBytes(&right[at])) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn copyPath(path: &Path) -> Path
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move run Effect.result(Path.fromBytes(Path.rawBytes(path))) {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      // The bytes were already a valid path.
      FileError refused => {
        drop refused
        return run Path.root()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

/// Whether two inputs link the same thing: the same file, search path or script, or the same
/// library with the same linkage, or the same framework. A build links such inputs once.
pub fn sameInput(left: &NativeLinkInput, right: &NativeLinkInput) -> bool {
  return match &left.* {
    NativeLinkInput.Object { path } => match &right.* {
      NativeLinkInput.Object { path: other } => sameText(
        Path.rawBytes(&path),
        Path.rawBytes(&other),
      )
      _ => false
    }
    NativeLinkInput.StaticArchive { path } => match &right.* {
      NativeLinkInput.StaticArchive { path: other } => sameText(
        Path.rawBytes(&path),
        Path.rawBytes(&other),
      )
      _ => false
    }
    NativeLinkInput.SearchPath { path } => match &right.* {
      NativeLinkInput.SearchPath { path: other } => sameText(
        Path.rawBytes(&path),
        Path.rawBytes(&other),
      )
      _ => false
    }
    NativeLinkInput.FrameworkSearchPath { path } => match &right.* {
      NativeLinkInput.FrameworkSearchPath { path: other } => sameText(
        Path.rawBytes(&path),
        Path.rawBytes(&other),
      )
      _ => false
    }
    NativeLinkInput.RPath { value } => match &right.* {
      NativeLinkInput.RPath { value: other } => sameText(value.asSlice(), other.asSlice())
      _ => false
    }
    NativeLinkInput.LinkerScript { path, entry: _ } => match &right.* {
      NativeLinkInput.LinkerScript { path: other, entry: _ } => sameText(
        Path.rawBytes(&path),
        Path.rawBytes(&other),
      )
      _ => false
    }
    NativeLinkInput.Library { name, linkage, weak, needed, entry: _ } => match &right.* {
      NativeLinkInput.Library {
        name: other,
        linkage: otherLinkage,
        weak: otherWeak,
        needed: otherNeeded,
        entry: _
      } => weak == otherWeak && needed == otherNeeded && linkage == otherLinkage
        && sameText(Bytes.asSlice(&name), Bytes.asSlice(&other))
      _ => false
    }
    NativeLinkInput.Framework { name, weak, needed, entry: _ } => match &right.* {
      NativeLinkInput.Framework {
        name: other,
        weak: otherWeak,
        needed: otherNeeded,
        entry: _
      } => weak == otherWeak && needed == otherNeeded
        && sameText(Bytes.asSlice(&name), Bytes.asSlice(&other))
      _ => false
    }
    NativeLinkInput.Sources { language, files, .. } => match &right.* {
      NativeLinkInput.Sources { language: otherLanguage, files: otherFiles, .. } => language
        == otherLanguage
        && samePaths(List<Path>.asSlice(&files), List<Path>.asSlice(&otherFiles))
      _ => false
    }
  }
}

fn sameText(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// The number of members of a table, or none for another value kind.
fn memberCount(value: &TomlValue) -> Option<usize> {
  return match &value.* {
    TomlValue.Table { entries, kind: _ } => {
      let boxed = Box<List<TomlChild>>.get(&entries)
      return Option<usize>.some(List<TomlChild>.length(&boxed[0]))
    }
    _ => Option<usize>.none()
  }
}

// A library or framework name: nonempty, not an option, and free of whitespace, NUL and separators.
fn nativeName(text: &[u8]) -> bool {
  if text.length == usize.ZERO || text[usize.ZERO] == 45 {
    return false
  }
  let mut at = usize.ZERO
  while at < text.length {
    let byte = text[at]

    // NUL, tab through carriage return, space, slash and backslash.
    if byte == 0 || (byte >= 9 && byte <= 13) || byte == 32 || byte == 47 || byte == 92 {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// The rule each sources flag follows, for its refusal.

fn startsWith(text: &[u8], prefix: &[u8]) -> bool {
  if text.length < prefix.length {
    return false
  }
  let mut at = usize.ZERO
  while at < prefix.length {
    if text[at] != prefix[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// Whether a native source flag is allowed: a define, warning, language standard,
/// optimization level, debug information or code generation flag, written as one argument, that
/// neither loads code nor names a file for Clang to read or write.
pub fn allowedFlag(flag: &[u8]) -> bool {
  if flag.length < usize.add(0, 2) || flag[usize.ZERO] != 45 {
    return false
  }
  if startsWith(flag, b"-D") || startsWith(flag, b"-U") {
    return flag.length > usize.add(0, 2)
  }
  if sameText(flag, b"-w") || sameText(flag, b"-pedantic") || sameText(flag, b"-pedantic-errors") {
    return true
  }
  if startsWith(flag, b"-W") {
    // `-Wl,`, `-Wa,` and `-Wp,` hand arguments to other tools.
    return flag.length > usize.add(0, 2)
      && !(flag.length >= usize.add(0, 4) && flag[usize.add(0, 3)] == 44)
  }
  if startsWith(flag, b"-std=") {
    return flag.length > usize.add(0, 5)
  }
  if startsWith(flag, b"-O") {
    return flag.length <= usize.add(0, 3)
  }
  if startsWith(flag, b"-g") {
    return true
  }
  if startsWith(flag, b"-m") {
    return !startsWith(flag, b"-mllvm")
  }
  if startsWith(flag, b"-f") {
    let refused: [&[u8]; 14] = [
      b"-fplugin",
      b"-fpass-plugin",
      b"-fprofile-use",
      b"-fprofile-instr-use",
      b"-fprofile-sample-use",
      b"-fprofile-list",
      b"-fprofile-remapping-file",
      b"-fsanitize-ignorelist",
      b"-fsanitize-blacklist",
      b"-fmodules-cache-path",
      b"-fmodule-map-file",
      b"-fmodule-file",
      b"-fprebuilt-module-path",
      b"-fcrash-diagnostics-dir",
    ]
    let mut at = usize.ZERO
    while at < refused.length {
      if startsWith(flag, refused[at]) {
        return false
      }
      at = at + usize.ONE
    }
    return true
  }
  return false
}

/// A `[native.archive.<name>]` a package declares, as selected for one build target.
pub struct Archive {
  /// The name a typed Plan.archivePath reference selects.
  pub name: Bytes,
  /// Where its files are: its directory in the archive store, or an override's directory.
  pub directory: Path,
  /// The URL to fetch it from and its SHA-256 in lowercase hexadecimal; both empty for an
  /// override, which is never fetched.
  pub url: Bytes,
  pub sha256: Bytes,
  /// The leading path segments extraction drops from every member.
  pub strip: usize,
  /// Why a reference to it is refused, when it cannot be used for the target; empty otherwise.
  pub refusal: Bytes,
}

/// A directory that replaces an archive: `[native.override.<name>] path = "<directory>"` in
/// `$SILK_HOME/native-overrides.toml`.
pub struct Override {
  pub name: Bytes,
  pub path: Path,
}

/// What `[native.archive.*]` tables resolve against: the build target's name, the archive store
/// (`$SILK_HOME/archives`), and the machine's overrides (`$SILK_HOME/native-overrides.toml`).
pub struct ArchiveContext {
  pub target: Bytes,
  pub store: Option<Path>,
  pub overrides: List<Override>,
}

/// Resolved native inputs contributed by a package's typed build plan.
pub struct PlannedNative {
  pub inputs: List<NativeLinkInput>,
  pub functionOrder: Option<Path>,
}

/// Converts typed package requirements into compiler inputs without a textual intermediary.
pub effect fn planned(native: &RequestNative) -> PlannedNative
  ! FileError | InvalidNativeLinkInput | OutOfMemoryError
  ? &mut Allocator {
  let mut order = Option<Path>.none()
  if let Option<String>.Some { value } = &native.functionOrder {
    order = Option<Path>.some(run Path.make(value.view()))
  }
  return PlannedNative { inputs: run fromRequest(native), functionOrder: move order }
}

/// A copy of `self`.
pub effect fn copyArchive(self: &Archive) -> Archive
  ! OutOfMemoryError
  ? &mut Allocator {
  return Archive {
    name: run Bytes.copy(Bytes.asSlice(&self.name)),
    directory: run copyPath(&self.directory),
    url: run Bytes.copy(Bytes.asSlice(&self.url)),
    sha256: run Bytes.copy(Bytes.asSlice(&self.sha256)),
    strip: self.strip,
    refusal: run Bytes.copy(Bytes.asSlice(&self.refusal)),
  }
}

/// A copy of `self`.
pub effect fn copyContext(self: &ArchiveContext) -> ArchiveContext
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut store = Option<Path>.none()
  if let Option<Path>.Some { value } = &self.store {
    store = Option<Path>.some(run copyPath(&value))
  }
  let mut overrides = List<Override>.make()
  let listed = List<Override>.asSlice(&self.overrides)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<Override>.append(
      &mut overrides,
      Override {
        name: run Bytes.copy(Bytes.asSlice(&listed[at].name)),
        path: run copyPath(&listed[at].path),
      },
    )
    at = at + usize.ONE
  }
  return ArchiveContext {
    target: run Bytes.copy(Bytes.asSlice(&self.target)),
    store: move store,
    overrides: move overrides,
  }
}

// Whether `text` is an archive name: lowercase letters, digits, `-` and `_`, starting with a letter.
fn archiveName(text: &[u8]) -> bool {
  if text.length == usize.ZERO || text[usize.ZERO] < 97 || text[usize.ZERO] > 122 {
    return false
  }
  let mut at = usize.ZERO
  while at < text.length {
    let byte = text[at]
    let letter = byte >= 97 && byte <= 122
    let digit = byte >= 48 && byte <= 57
    if !letter && !digit && byte != 45 && byte != 95 {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// The members of a table value, or none for another kind.
fn members(value: &TomlValue) -> Option<&[TomlChild]> {
  return match &value.* {
    TomlValue.Table { entries, kind: _ } => {
      let boxed = Box<List<TomlChild>>.get(&entries)
      return Option<&[TomlChild]>.some(List<TomlChild>.asSlice(&boxed[0]))
    }
    _ => Option<&[TomlChild]>.none()
  }
}

// The `<manifest>:<line>: [native.archive.<name>]: ` prefix that names one archive.
effect fn archivePrefix(manifest: &Path, text: &[u8], name: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut key = run Bytes.copy(b"native.archive.")
  run Bytes.append(&mut key, name)
  let line = ManifestText.keyLine(text, Bytes.asSlice(&key))
  let mut detail = run Bytes.copy(Path.rawBytes(manifest))
  if line > usize.ZERO {
    run Bytes.append(&mut detail, b":")
    run JsonText.appendDecimal(&mut detail, line)
  }
  run Bytes.append(&mut detail, b": [native.archive.")
  run Bytes.append(&mut detail, name)
  run Bytes.append(&mut detail, b"]: ")
  return move detail
}

effect fn refuseArchive(manifest: &Path, text: &[u8], name: &[u8], rule: &[u8]) -> never
  ! InvalidNativeLinkInput | OutOfMemoryError
  ? &mut Allocator {
  let mut detail = run archivePrefix(manifest, text, name)
  run Bytes.append(&mut detail, rule)
  fail InvalidNativeLinkInput { detail: move detail }
}

// The rule an archive's fields follow, for a refusal of its shape.
fn archiveRule() -> &'static [u8] {
  return b"an archive has a url (https:// or file:///) and a sha256 (64 hexadecimal digits) and an optional strip, either directly or for each target under targets.<target>"
}

// One fetchable form of an archive: its URL, lowercase SHA-256 and strip count.
struct Variant {
  url: Bytes,
  sha256: Bytes,
  strip: usize,
}

// The variant `table` declares; `nested` allows only url, sha256 and strip.
effect fn variantOf(
  manifest: &Path,
  text: &[u8],
  name: &[u8],
  table: &TomlValue,
  nested: bool,
) -> Variant
  ! InvalidNativeLinkInput | OutOfMemoryError
  ? &mut Allocator {
  let children = match move members(table) {
    Option<&[TomlChild]>.Some { value } => value
    Option<&[TomlChild]>.None => run refuseArchive(manifest, text, name, archiveRule())
  }
  let mut at = usize.ZERO
  while at < children.length {
    if let TomlChild.Member { entry } = &children[at] {
      let key = String.ownedUtf8Bytes(&entry.key)
      let known = sameText(key, b"url") || sameText(key, b"sha256") || sameText(key, b"strip")
        || (!nested && sameText(key, b"targets"))
      if !known {
        run refuseArchive(manifest, text, name, archiveRule())
      }
    }
    at = at + usize.ONE
  }
  let url = match move Toml.asString(Toml.field(table, "url")) {
    Option<string>.Some { value } => String.utf8Bytes(value)
    Option<string>.None => run refuseArchive(manifest, text, name, archiveRule())
  }
  let secure = startsWith(url, b"https://") && url.length > usize.add(0, 8)
  let local = startsWith(url, b"file:///") && url.length > usize.add(0, 8)
  if !secure && !local {
    run refuseArchive(
      manifest,
      text,
      name,
      b"url must be an https:// URL, or a file:/// URL of a local mirror",
    )
  }
  let written = match move Toml.asString(Toml.field(table, "sha256")) {
    Option<string>.Some { value } => String.utf8Bytes(value)
    Option<string>.None => run refuseArchive(manifest, text, name, archiveRule())
  }
  let mut sha256 = Bytes.make()
  let mut valid = written.length == usize.add(0, 64)
  let mut digit = usize.ZERO
  while valid && digit < written.length {
    let mut byte = written[digit]
    if byte >= 65 && byte <= 70 {
      byte = byte + 32
    }
    valid = (byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102)
    let one: [u8; 1] = [byte]
    run Bytes.append(&mut sha256, &one)
    digit = digit + usize.ONE
  }
  if !valid {
    run refuseArchive(manifest, text, name, b"sha256 must be 64 hexadecimal digits")
  }
  let mut strip = usize.ZERO
  if let Option<&TomlValue>.Some { value } = move Toml.field(table, "strip") {
    let mut parsed = false
    if let TomlValue.Integer { text: count } = &value.* {
      let digits = String.ownedUtf8Bytes(&count)
      parsed = digits.length > usize.ZERO && digits.length <= usize.add(0, 2)
      let mut index = usize.ZERO
      while parsed && index < digits.length {
        parsed = digits[index] >= 48 && digits[index] <= 57
        if parsed {
          strip = strip * usize.add(0, 10) + u8.toUsize(digits[index] - 48)
        }
        index = index + usize.ONE
      }
    }
    if !parsed {
      run refuseArchive(
        manifest,
        text,
        name,
        b"strip must be a small nonnegative integer: the leading path segments to drop",
      )
    }
  }
  return Variant { url: run Bytes.copy(url), sha256: move sha256, strip: strip }
}

// The archives `document` declares, selected for `context`'s target (see [`Archive`]). Every
// target's variant is checked whichever the build selects.
pub effect fn archivesOf(
  document: &TomlValue,
  manifest: &Path,
  text: &[u8],
  context: &ArchiveContext,
) -> List<Archive>
  ! InvalidNativeLinkInput | OutOfMemoryError
  ? &mut Allocator {
  let mut archives = List<Archive>.make()
  let declared = match move Toml.fieldAt(Toml.field(document, "native"), "archive") {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      return move archives
    }
  }
  let children = match move members(declared) {
    Option<&[TomlChild]>.Some { value } => value
    Option<&[TomlChild]>.None => {
      let mut detail = run Bytes.copy(Path.rawBytes(manifest))
      run Bytes.append(
        &mut detail,
        b": [native.archive] must be a table of archives, as [native.archive.<name>]",
      )
      fail InvalidNativeLinkInput { detail: move detail }
    }
  }
  let mut at = usize.ZERO
  while at < children.length {
    if let TomlChild.Member { entry } = &children[at] {
      let name = String.ownedUtf8Bytes(&entry.key)
      if !archiveName(name) {
        run refuseArchive(
          manifest,
          text,
          name,
          b"an archive name starts with a lowercase letter and holds lowercase letters, digits, - and _",
        )
      }
      let mut selected = Option<Variant>.none()
      match move Toml.field(&entry.value, "targets") {
        Option<&TomlValue>.Some { value: targets } => {
          if let Option<&TomlValue>.Some { .. } = move Toml.field(&entry.value, "url") {
            run refuseArchive(manifest, text, name, archiveRule())
          }
          let variants = match move members(targets) {
            Option<&[TomlChild]>.Some { value } => value
            Option<&[TomlChild]>.None => run refuseArchive(manifest, text, name, archiveRule())
          }
          let mut variant = usize.ZERO
          while variant < variants.length {
            if let TomlChild.Member { entry: target } = &variants[variant] {
              let checked = run variantOf(manifest, text, name, &target.value, true)
              if sameText(String.ownedUtf8Bytes(&target.key), Bytes.asSlice(&context.target)) {
                selected = Option<Variant>.some(move checked)
              } else {
                drop checked
              }
            }
            variant = variant + usize.ONE
          }
        }
        Option<&TomlValue>.None => {
          selected = Option<Variant>.some(run variantOf(manifest, text, name, &entry.value, false))
        }
      }
      let mut overridden = Option<&Path>.none()
      let overrides = List<Override>.asSlice(&context.overrides)
      let mut index = usize.ZERO
      while index < overrides.length {
        if sameText(Bytes.asSlice(&overrides[index].name), name) {
          overridden = Option<&Path>.some(&overrides[index].path)
        }
        index = index + usize.ONE
      }
      let mut archive = Archive {
        name: run Bytes.copy(name),
        directory: run Path.root(),
        url: Bytes.make(),
        sha256: Bytes.make(),
        strip: usize.ZERO,
        refusal: Bytes.make(),
      }
      if let Option<&Path>.Some { value: path } = move overridden {
        archive.directory = run copyPath(path)
      } else if let Option<Variant>.Some { value: variant } = move selected {
        if let Option<Path>.Some { value: store } = &context.store {
          archive.directory = run copyPath(&store)
          match move run Effect.result(Path.joinBytes(&store, Bytes.asSlice(&variant.sha256))) {
            Result<Path, FileError | OutOfMemoryError>.Success { value } => {
              archive.directory = move value
            }
            Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
              FileError refused => {
                drop refused
              }
              OutOfMemoryError exhausted => {
                fail move exhausted
              }
            }
          }
          archive.url = move variant.url
          archive.sha256 = move variant.sha256
          archive.strip = variant.strip
        } else {
          archive.refusal = run Bytes.copy(
            b"there is no archive store to fetch it into: set SILK_HOME or HOME",
          )
        }
      } else {
        let mut refusal = run Bytes.copy(b"archive ")
        run Bytes.append(&mut refusal, name)
        run Bytes.append(&mut refusal, b" declares no url for target ")
        run Bytes.append(&mut refusal, Bytes.asSlice(&context.target))
        archive.refusal = move refusal
      }
      run List<Archive>.append(&mut archives, move archive)
    }
    at = at + usize.ONE
  }
  return move archives
}

/// Appends the `[native.override.<name>]` tables from the parsed `$SILK_HOME/native-overrides.toml`
/// in `directory` to `overrides`, skipping a name already there. An override's `path` is a
/// directory, absolute or relative to `directory`.
pub effect fn appendOverrides(
  document: &TomlValue,
  manifest: &Path,
  directory: &Path,
  overrides: &mut List<Override>,
) -> ()
  ! InvalidNativeLinkInput | OutOfMemoryError
  ? &mut Allocator {
  let declared = match move Toml.fieldAt(Toml.field(document, "native"), "override") {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      return ()
    }
  }
  let mut rule = run Bytes.copy(Path.rawBytes(manifest))
  run Bytes.append(
    &mut rule,
    b": [native.override.<name>] holds exactly a path, the directory that replaces archive <name>",
  )
  let children = match move members(declared) {
    Option<&[TomlChild]>.Some { value } => value
    Option<&[TomlChild]>.None => {
      fail InvalidNativeLinkInput { detail: move rule }
    }
  }
  let mut at = usize.ZERO
  while at < children.length {
    if let TomlChild.Member { entry } = &children[at] {
      let name = String.ownedUtf8Bytes(&entry.key)
      let count = match move memberCount(&entry.value) {
        Option<usize>.Some { value } => value
        Option<usize>.None => usize.ZERO
      }
      let written = match move Toml.asString(Toml.field(&entry.value, "path")) {
        Option<string>.Some { value } => String.utf8Bytes(value)
        Option<string>.None => {
          fail InvalidNativeLinkInput { detail: move rule }
        }
      }
      if count != usize.ONE || !archiveName(name) || written.length == usize.ZERO {
        fail InvalidNativeLinkInput { detail: move rule }
      }
      let absolute = written.length > usize.ZERO && written[usize.ZERO] == 47
      let resolved = if absolute {
        run Effect.result(Path.fromBytes(written))
      } else {
        run Effect.result(Path.resolveBytes(directory, written))
      }
      let path = match move resolved {
        Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
        Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
          FileError refused => {
            drop refused
            fail InvalidNativeLinkInput { detail: move rule }
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
      let listed = List<Override>.asSlice(&overrides.*)
      let mut known = false
      let mut index = usize.ZERO
      while index < listed.length {
        if sameText(Bytes.asSlice(&listed[index].name), name) {
          known = true
        }
        index = index + usize.ONE
      }
      if known {
        drop path
      } else {
        run List<Override>.append(
          &mut overrides.*,
          Override { name: run Bytes.copy(name), path: move path },
        )
      }
    }
    at = at + usize.ONE
  }
  return ()
}

fn pathBelow(path: &Path, directory: &[u8]) -> bool {
  let bytes = Path.rawBytes(path)
  return bytes.length >= directory.length
    && sameText(Slice.view<u8>(bytes, usize.ZERO, directory.length), directory)
    && (bytes.length == directory.length || bytes[directory.length] == 47)
}

fn anyBelow(paths: &[Path], directory: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < paths.length {
    if pathBelow(&paths[at], directory) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

/// Whether `self` names a file or directory at or below `directory`.
pub fn below(self: &NativeLinkInput, directory: &[u8]) -> bool {
  return match &self.* {
    NativeLinkInput.Object { path } => pathBelow(&path, directory)
    NativeLinkInput.StaticArchive { path } => pathBelow(&path, directory)
    NativeLinkInput.SearchPath { path } => pathBelow(&path, directory)
    NativeLinkInput.FrameworkSearchPath { path } => pathBelow(&path, directory)
    NativeLinkInput.LinkerScript { path, .. } => pathBelow(&path, directory)
    NativeLinkInput.Sources { files, include, .. } => anyBelow(
      List<Path>.asSlice(&files),
      directory,
    )
      || anyBelow(List<Path>.asSlice(&include), directory)
    _ => false
  }
}

/// Whether `inputs` holds a native translation unit, which the build compiles before it links.
pub fn hasSources(inputs: &[NativeLinkInput]) -> bool {
  let mut at = usize.ZERO
  while at < inputs.length {
    if let NativeLinkInput.Sources { .. } = &inputs[at] {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

/// Whether an unchanged link command may skip linking `inputs` again: each is compiled from
/// sources, a file the command names by its bytes ([`digested`]), or a name the command spells
/// out. A static library found by name on a search path is none of these.
pub fn stampable(inputs: &[NativeLinkInput]) -> bool {
  let mut at = usize.ZERO
  while at < inputs.length {
    if let NativeLinkInput.Library { linkage, .. } = &inputs[at] {
      if linkage == Linkage.Static {
        return false
      }
    }
    at = at + usize.ONE
  }
  return true
}

/// The file whose bytes name `self` in a link stamp: a declared object, archive or linker script.
pub fn digested(self: &NativeLinkInput) -> Option<&Path> {
  return match &self.* {
    NativeLinkInput.Object { path } => Option<&Path>.some(&path)
    NativeLinkInput.StaticArchive { path } => Option<&Path>.some(&path)
    NativeLinkInput.LinkerScript { path, .. } => Option<&Path>.some(&path)
    _ => Option<&Path>.none()
  }
}

/// The concrete object or archive file, for linkers that accept grouped file response inputs.
/// Options, search directories, and named libraries have no concrete file here.
pub fn file(self: &NativeLinkInput) -> Option<&Path> {
  return match &self.* {
    NativeLinkInput.Object { path } => Option<&Path>.some(&path)
    NativeLinkInput.StaticArchive { path } => Option<&Path>.some(&path)
    _ => Option<&Path>.none()
  }
}

/// Whether `self` is an object or archive a relocatable link can merge into an object artifact.
pub fn relocatable(self: &NativeLinkInput) -> bool {
  return match &self.* {
    NativeLinkInput.Object { .. } => true
    NativeLinkInput.StaticArchive { .. } => true
    NativeLinkInput.Sources { .. } => true
    _ => false
  }
}

/// Appends `self` as a static library member: only an object is one. Named libraries,
/// frameworks and search paths are for the final link of the program that uses the archive, so
/// they add no member. A declared archive or linker script cannot go inside an archive.
pub effect fn appendArchiveMember(self: &NativeLinkInput, process: &mut ProcessRequest) -> ()
  ! FileError | InvalidNativeLinkInput | OutOfMemoryError
  ? &mut Allocator {
  match &self.* {
    NativeLinkInput.Object { path } => {
      run NativeToolchain.addPathArgument(&mut process.*, &path)
    }
    NativeLinkInput.Sources { entry, .. } => run refuseEntry(
      &entry,
      b"its sources were not compiled before the archive",
    )
    NativeLinkInput.StaticArchive { path } => {
      let mut detail = run Bytes.copy(b"a static archive cannot contain the archive `")
      run Bytes.append(&mut detail, Path.rawBytes(&path))
      run Bytes.append(&mut detail, b"`; link it into the program that uses this archive instead")
      fail InvalidNativeLinkInput { detail: move detail }
    }
    NativeLinkInput.LinkerScript { entry, .. } => run refuseEntry(
      &entry,
      b"a static archive cannot use a linker script; only the final link of a program reads one",
    )
    _ => {}
  }
}

/// Appends the clang driver arguments that link `self` for `target`. `stubbed` is a macOS link
/// against Silk's own libSystem stub, which has no frameworks, so a framework entry is refused.
pub effect fn appendArguments(
  self: &NativeLinkInput,
  target: &Target,
  stubbed: bool,
  process: &mut ProcessRequest,
) -> ()
  ! FileError | InvalidNativeLinkInput | OutOfMemoryError
  ? &mut Allocator {
  let darwin = sameText(Target.operatingSystem(target), b"darwin")
  match &self.* {
    NativeLinkInput.Object { path } => {
      run NativeToolchain.addPathArgument(&mut process.*, &path)
    }
    NativeLinkInput.StaticArchive { path } => {
      run NativeToolchain.addPathArgument(&mut process.*, &path)
    }
    NativeLinkInput.SearchPath { path } => {
      run ChildProcess.addArgument(&mut process.*, "-L")
      run NativeToolchain.addPathArgument(&mut process.*, &path)
    }
    NativeLinkInput.FrameworkSearchPath { path } => {
      if !darwin {
        run invalid(b"framework search paths require a macOS target")
      }
      run ChildProcess.addArgument(&mut process.*, "-F")
      run NativeToolchain.addPathArgument(&mut process.*, &path)
    }
    NativeLinkInput.RPath { value } => {
      if !darwin && !sameText(Target.operatingSystem(target), b"linux") {
        run invalid(b"runtime search paths require a Linux or macOS target")
      }
      run ChildProcess.addArgument(&mut process.*, "-Xlinker")
      run ChildProcess.addArgument(&mut process.*, "-rpath")
      run ChildProcess.addArgument(&mut process.*, "-Xlinker")
      run ChildProcess.addArgumentBytes(&mut process.*, value.asSlice())
    }
    NativeLinkInput.LinkerScript { path, entry } => {
      if !sameText(Target.operatingSystem(target), b"linux") {
        run refuseEntry(&entry, b"a linker-script links only on Linux targets")
      }
      run ChildProcess.addArgument(&mut process.*, "-Xlinker")
      run ChildProcess.addArgument(&mut process.*, "-T")
      run ChildProcess.addArgument(&mut process.*, "-Xlinker")
      run NativeToolchain.addPathArgument(&mut process.*, &path)
    }
    NativeLinkInput.Library { name, linkage, weak, needed, entry } => {
      if weak && !darwin {
        run refuseEntry(&entry, b"weak libraries require a macOS target")
      }
      if (weak || needed) && linkage == Linkage.Static {
        run refuseEntry(&entry, b"weak and needed select dynamic libraries")
      }
      let linux = sameText(Target.operatingSystem(target), b"linux")
      if needed && !darwin && !linux {
        run refuseEntry(&entry, b"needed libraries require a Linux or macOS target")
      }
      let prefix = if weak {
        b"-weak-l"
      } else if needed && darwin {
        b"-needed-l"
      } else {
        b"-l"
      }
      let mut argument = run Bytes.copy(prefix)
      run Bytes.append(&mut argument, Bytes.asSlice(&name))
      if needed && linux {
        run ChildProcess.addArgument(&mut process.*, "-Wl,--push-state,--no-as-needed")
      }
      if linkage == Linkage.Dynamic {
        run ChildProcess.addArgumentBytes(&mut process.*, Bytes.asSlice(&argument))
      } else {
        if darwin {
          run refuseEntry(
            &entry,
            b"a static library links only on Linux targets; macOS links libraries dynamically",
          )
        }
        run ChildProcess.addArgument(&mut process.*, "-Wl,-Bstatic")
        run ChildProcess.addArgumentBytes(&mut process.*, Bytes.asSlice(&argument))
        run ChildProcess.addArgument(&mut process.*, "-Wl,-Bdynamic")
      }
      if needed && linux {
        run ChildProcess.addArgument(&mut process.*, "-Wl,--pop-state")
      }
    }
    NativeLinkInput.Framework { name, weak, needed, entry } => {
      if !darwin {
        let mut detail = run Bytes.copy(Bytes.asSlice(&entry))
        run Bytes.append(&mut detail, b"framework ")
        run Bytes.append(&mut detail, Bytes.asSlice(&name))
        run Bytes.append(&mut detail, b" links only on macOS targets")
        fail InvalidNativeLinkInput { detail: move detail }
      }
      if stubbed {
        let mut detail = run Bytes.copy(Bytes.asSlice(&entry))
        run Bytes.append(&mut detail, b"framework ")
        run Bytes.append(&mut detail, Bytes.asSlice(&name))
        run Bytes.append(
          &mut detail,
          b" needs a macOS SDK; set SDKROOT or supply a platform sysroot in the compilation",
        )
        fail InvalidNativeLinkInput { detail: move detail }
      }
      run ChildProcess.addArgument(&mut process.*, "-Xlinker")
      run ChildProcess.addArgument(
        &mut process.*,
        if weak {
          "-weak_framework"
        } else if needed {
          "-needed_framework"
        } else {
          "-framework"
        },
      )
      run ChildProcess.addArgument(&mut process.*, "-Xlinker")
      run ChildProcess.addArgumentBytes(&mut process.*, Bytes.asSlice(&name))
    }
    NativeLinkInput.Sources { entry, .. } => run refuseEntry(
      &entry,
      b"its sources were not compiled before the link",
    )
  }
  return ()
}

/// Converts resolved request inputs directly to compiler inputs. No manifest or archive store is read.
pub effect fn fromRequest(native: &RequestNative) -> List<NativeLinkInput>
  ! FileError | InvalidNativeLinkInput | OutOfMemoryError
  ? &mut Allocator {
  let mut inputs = List<NativeLinkInput>.make()
  let sources = List<RequestSource>.asSlice(&native.sources)
  let mut at = usize.ZERO
  while at < sources.length {
    let source = &sources[at]
    let languageName = source.language.view()
    if languageName != "c" && languageName != "cpp" && languageName != "objc"
      && languageName != "objcpp" {
      run invalid(b"unsupported native source language")
    }
    let language = if source.language.view() == "c" {
      SourceLanguage.C
    } else if source.language.view() == "cpp" {
      SourceLanguage.Cxx
    } else if source.language.view() == "objc" {
      SourceLanguage.ObjectiveC
    } else {
      SourceLanguage.ObjectiveCxx
    }
    let mut files = List<Path>.make()
    run List<Path>.append(&mut files, run Path.make(source.path.view()))
    let mut flags = List<Bytes>.make()
    let arguments = List<String>.asSlice(&source.flags)
    let mut index = usize.ZERO
    while index < arguments.length {
      if !allowedFlag(String.ownedUtf8Bytes(&arguments[index])) {
        run invalid(flagRule())
      }
      run List<Bytes>.append(&mut flags, run Bytes.copy(String.ownedUtf8Bytes(&arguments[index])))
      index = index + usize.ONE
    }
    let mut include = List<Path>.make()
    let directories = List<String>.asSlice(&source.include)
    index = usize.ZERO
    while index < directories.length {
      run List<Path>.append(&mut include, run Path.make(directories[index].view()))
      index = index + usize.ONE
    }
    run List<NativeLinkInput>.append(
      &mut inputs,
      NativeLinkInput.Sources {
        language: language,
        files: move files,
        flags: move flags,
        include: move include,
        entry: run Bytes.copy(b"request native source: "),
      },
    )
    at = at + usize.ONE
  }
  let linked = List<RequestLink>.asSlice(&native.link)
  at = usize.ZERO
  while at < linked.length {
    let input = &linked[at]
    let value = input.value.view()
    let kind = input.kind.view()
    if (kind == "library" || kind == "framework") && !nativeName(String.utf8Bytes(value)) {
      run invalid(
        b"a native library or framework name must be nonempty, not an option, and contain no whitespace or path separators",
      )
    }
    let item = if kind == "library" {
      let mut linkage = Linkage.Dynamic
      if let Option<String>.Some { value: mode } = &input.mode {
        if mode.view() == "static" {
          linkage = Linkage.Static
        }
      }
      NativeLinkInput.Library {
        name: run Bytes.copy(String.utf8Bytes(value)),
        linkage: linkage,
        weak: input.weak,
        needed: input.needed,
        entry: run Bytes.copy(b"request native library: "),
      }
    } else if kind == "framework" {
      NativeLinkInput.Framework {
        name: run Bytes.copy(String.utf8Bytes(value)),
        weak: input.weak,
        needed: input.needed,
        entry: run Bytes.copy(b"request native framework: "),
      }
    } else if kind == "object" {
      NativeLinkInput.Object { path: run Path.make(value) }
    } else if kind == "archive" {
      NativeLinkInput.StaticArchive { path: run Path.make(value) }
    } else if kind == "search-path" {
      NativeLinkInput.SearchPath { path: run Path.make(value) }
    } else if kind == "framework-search-path" {
      NativeLinkInput.FrameworkSearchPath { path: run Path.make(value) }
    } else if kind == "rpath" {
      NativeLinkInput.RPath { value: run Bytes.copy(String.utf8Bytes(value)) }
    } else if kind == "linker-script" {
      NativeLinkInput.LinkerScript {
        path: run Path.make(value),
        entry: run Bytes.copy(b"request linker script: "),
      }
    } else {
      run invalid(b"unsupported request link input")
    }
    run List<NativeLinkInput>.append(&mut inputs, move item)
    at = at + usize.ONE
  }
  return move inputs
}

effect fn requestTexts(values: &[Bytes]) -> List<String>
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut result = List<String>.make()
  let mut at = usize.ZERO
  while at < values.length {
    run result.append(run RequestText.copy(Bytes.asSlice(&values[at])))
    at = at + usize.ONE
  }
  return move result
}

effect fn paths(values: &[Path]) -> List<String>
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut result = List<String>.make()
  let mut at = usize.ZERO
  while at < values.length {
    run result.append(run RequestText.copy(Path.rawBytes(&values[at])))
    at = at + usize.ONE
  }
  return move result
}

effect fn link(kind: string, value: &[u8], mode: Option<String>) -> RequestLink
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  return RequestLink {
    kind: run String.copy(kind),
    value: run RequestText.copy(value),
    mode: move mode,
    weak: false,
    needed: false,
  }
}

/// Captures ordered native compiler inputs for a compilation request.
pub effect fn toRequest(inputs: &[NativeLinkInput], functionOrder: Option<&Path>) -> RequestNative
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut result = RequestNative {
    sources: List<RequestSource>.make(),
    link: List<RequestLink>.make(),
    functionOrder: Option<String>.none(),
  }
  if let Option<&Path>.Some { value } = move functionOrder {
    result.functionOrder = Option<String>.some(run RequestText.copy(Path.rawBytes(value)))
  }
  let mut at = usize.ZERO
  while at < inputs.length {
    match &inputs[at] {
      NativeLinkInput.Sources { language, files, flags, include, .. } => {
        let languageName = match language {
          SourceLanguage.C => "c"
          SourceLanguage.Cxx => "cpp"
          SourceLanguage.ObjectiveC => "objc"
          SourceLanguage.ObjectiveCxx => "objcpp"
        }
        let listed = files.asSlice()
        let mut file = usize.ZERO
        while file < listed.length {
          run result.sources.append(
            RequestSource {
              path: run RequestText.copy(Path.rawBytes(&listed[file])),
              language: run String.copy(languageName),
              flags: run requestTexts(flags.asSlice()),
              include: run paths(include.asSlice()),
            },
          )
          file = file + usize.ONE
        }
      }
      NativeLinkInput.Object { path } => {
        run result.link.append(run link("object", Path.rawBytes(&path), Option<String>.none()))
      }
      NativeLinkInput.StaticArchive { path } => {
        run result.link.append(run link("archive", Path.rawBytes(&path), Option<String>.none()))
      }
      NativeLinkInput.SearchPath { path } => {
        run result.link.append(run link("search-path", Path.rawBytes(&path), Option<String>.none()))
      }
      NativeLinkInput.FrameworkSearchPath { path } => {
        run result.link.append(
          run link("framework-search-path", Path.rawBytes(&path), Option<String>.none()),
        )
      }
      NativeLinkInput.RPath { value } => {
        run result.link.append(run link("rpath", value.asSlice(), Option<String>.none()))
      }
      NativeLinkInput.LinkerScript { path, .. } => {
        run result.link.append(
          run link("linker-script", Path.rawBytes(&path), Option<String>.none()),
        )
      }
      NativeLinkInput.Framework { name, weak, needed, .. } => {
        let mut captured = run link("framework", name.asSlice(), Option<String>.none())
        captured.weak = weak
        captured.needed = needed
        run result.link.append(move captured)
      }
      NativeLinkInput.Library { name, linkage, weak, needed, .. } => {
        let mode = if linkage == Linkage.Static {
          "static"
        } else {
          "dynamic"
        }
        let mut captured = run link(
          "library",
          name.asSlice(),
          Option<String>.some(run String.copy(mode)),
        )
        captured.weak = weak
        captured.needed = needed
        run result.link.append(move captured)
      }
    }
    at = at + usize.ONE
  }
  return move result
}

effect fn refuseEntry(entry: &Bytes, rule: &[u8]) -> never
  ! InvalidNativeLinkInput | OutOfMemoryError
  ? &mut Allocator {
  let mut detail = run Bytes.copy(Bytes.asSlice(entry))
  run Bytes.append(&mut detail, rule)
  fail InvalidNativeLinkInput { detail: move detail }
}

fn flagRule() -> &'static [u8] {
  return b"sources take defines (-D, -U), warnings (-W, -w, -pedantic), a language standard (-std=), optimization (-O), debug information (-g) and code generation flags (-f, -m), and never a flag that loads code, reads other files or changes tools"
}
