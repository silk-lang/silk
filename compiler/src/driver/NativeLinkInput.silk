//! Native link inputs a package declares in `[native].link`, and their linker spelling, and its
//! `[native].function-order` file.
//!
//! An entry may name the operating systems it links on with `os`, a name or a list of names from
//! `macos`, `linux`, `windows` and `wasi`: `{ framework = "Metal", os = "macos" }` links only on
//! macOS targets, and a build for any other target skips it without refusing it.
//!
//! `[native].sources` entries name C, Objective-C, C++ or Objective-C++ files of the package that
//! the build compiles with Clang ([`NativeCompile`](driver/NativeCompile)) and links as objects
//! ahead of the package's `[native].link` entries. Their flags pass an allowlist, and their files
//! and include directories stay inside the package.

import diagnostic.JsonText
import driver.ManifestFields
import driver.ManifestText
import driver.NativeToolchain
import semantic.Target {Id as TargetId, Target}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.box {Box}
import silk.collections.bytes {Bytes}
import silk.system.child_process {ChildProcess, ProcessRequest}
import silk.core.effect {Effect}
import silk.system.filesystem {FileError, Path}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.text.string {String}
import silk.toml.value {Toml, TomlChild, Value as TomlValue}
import silk.num.usize
import silk.collections.list {List}

/// A `[native].link` entry that is not exactly one object, static-archive,
/// search-path, linker-script or framework value, or one library with a static or dynamic mode;
/// or an input the build target cannot link.
pub struct InvalidNativeLinkInput {
  /// The manifest and entry at fault, when known, and the rule the input breaks.
  pub detail: Bytes,
}

/// Fails with `detail`.
pub effect fn invalid(detail: &[u8]) -> never ! InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  fail InvalidNativeLinkInput {detail: run Bytes.copy(detail)}
}

/// How a named library is resolved by the linker.
pub enum Linkage { Static, Dynamic }

/// The language a `[native].sources` entry's files are written in.
pub enum SourceLanguage { C, ObjectiveC, Cxx, ObjectiveCxx }

/// One typed link input. Paths are resolved against the directory of the declaring manifest.
pub union NativeLinkInput {
  Object {path: Path},
  StaticArchive {path: Path},
  SearchPath {path: Path},
  /// `entry` is the `<manifest>: [native].link[<n>]: ` prefix a refusal at link time
  /// names, as a refusal while reading the manifest does.
  LinkerScript {path: Path, entry: Bytes},
  Library {name: Bytes, linkage: Linkage, entry: Bytes},
  Framework {name: Bytes, entry: Bytes},
  /// A `[native].sources` entry: its files, each a path or a pattern whose last segment holds `*`,
  /// with the flags and include directories they compile with. The build compiles them into
  /// objects before it links (`NativeCompile.compile`).
  Sources {pub language: SourceLanguage, pub files: List<Path>, pub flags: List<Bytes>, pub include: List<Path>, pub entry: Bytes},
}

/// An object input at `path`, as a compiled source links.
pub fn object(path: Path) -> NativeLinkInput {
  return NativeLinkInput.Object {path: move path}
}

/// One `[native].link` entry as declared: its input and the operating systems it links on.
pub struct Declared {
  pub input: NativeLinkInput,
  // A bit per operating system the entry's `os` names (`systemBit`); zero links on every target.
  systems: u8,
}

// The bit an `os` name sets, or zero for a name no target has.
fn systemBit(name: &[u8]) -> u8 {
  if sameText(name, b"macos") { return 1 }
  if sameText(name, b"linux") { return 2 }
  if sameText(name, b"windows") { return 4 }
  if sameText(name, b"wasi") { return 8 }
  return 0
}

// The bit of a target's operating system, as `Target.operatingSystem` spells it; zero for a
// target that no `os` name selects, such as a freestanding browser module.
fn targetBit(target: &Target) -> u8 {
  let system = Target.operatingSystem(target)
  if sameText(system, b"darwin") { return 1 }
  if sameText(system, b"linux") { return 2 }
  if sameText(system, b"windows") { return 4 }
  if sameText(system, b"wasi") { return 8 }
  return 0
}

/// Whether the declared entry links on `target`: it names no `os`, or names `target`'s.
pub fn linksOn(self: &Declared, target: &Target) -> bool {
  if self.systems == 0 { return true }
  return (self.systems & targetBit(target)) != 0
}

/// A copy of `self`.
pub effect fn copy(self: &NativeLinkInput) -> NativeLinkInput ! OutOfMemoryError ? &mut Allocator {
  return match &self.* {
    NativeLinkInput.Object {path} => NativeLinkInput.Object {path: run copyPath(&path)}
    NativeLinkInput.StaticArchive {path} => NativeLinkInput.StaticArchive {path: run copyPath(&path)}
    NativeLinkInput.SearchPath {path} => NativeLinkInput.SearchPath {path: run copyPath(&path)}
    NativeLinkInput.LinkerScript {path, entry} => NativeLinkInput.LinkerScript {path: run copyPath(&path), entry: run Bytes.copy(Bytes.asSlice(&entry))}
    NativeLinkInput.Library {name, linkage, entry} => NativeLinkInput.Library {name: run Bytes.copy(Bytes.asSlice(&name)), linkage: linkage, entry: run Bytes.copy(Bytes.asSlice(&entry))}
    NativeLinkInput.Framework {name, entry} => NativeLinkInput.Framework {name: run Bytes.copy(Bytes.asSlice(&name)), entry: run Bytes.copy(Bytes.asSlice(&entry))}
    NativeLinkInput.Sources {language, files, flags, include, entry} => NativeLinkInput.Sources {language: language,
      files: run copyPaths(List<Path>.asSlice(&files)), flags: run copyTexts(List<Bytes>.asSlice(&flags)),
      include: run copyPaths(List<Path>.asSlice(&include)), entry: run Bytes.copy(Bytes.asSlice(&entry))}
  }
}

effect fn copyPaths(paths: &[Path]) -> List<Path> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<Path>.make()
  let mut at = usize.ZERO
  while at < paths.length {
    run List<Path>.append(&mut copied, run copyPath(&paths[at]))
    at = at + usize.ONE
  }
  return move copied
}

effect fn copyTexts(texts: &[Bytes]) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < texts.length {
    run List<Bytes>.append(&mut copied, run Bytes.copy(Bytes.asSlice(&texts[at])))
    at = at + usize.ONE
  }
  return move copied
}

fn samePaths(left: &[Path], right: &[Path]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if !sameText(Path.rawBytes(&left[at]), Path.rawBytes(&right[at])) { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn copyPath(path: &Path) -> Path ! OutOfMemoryError ? &mut Allocator {
  return match move run Effect.result(Path.fromBytes(Path.rawBytes(path))) {
    Result<Path, FileError | OutOfMemoryError>.Success {value} => move value
    Result<Path, FileError | OutOfMemoryError>.Failure {error} => match move error {
      // The bytes were already a valid path.
      FileError refused => {
        drop refused
        return run Path.root()
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

/// Whether two inputs link the same thing: the same file, search path or script, or the same
/// library with the same linkage, or the same framework. A build links such inputs once.
pub fn sameInput(left: &NativeLinkInput, right: &NativeLinkInput) -> bool {
  return match &left.* {
    NativeLinkInput.Object {path} => match &right.* {
      NativeLinkInput.Object {path: other} => sameText(Path.rawBytes(&path), Path.rawBytes(&other))
      _ => false
    }
    NativeLinkInput.StaticArchive {path} => match &right.* {
      NativeLinkInput.StaticArchive {path: other} => sameText(Path.rawBytes(&path), Path.rawBytes(&other))
      _ => false
    }
    NativeLinkInput.SearchPath {path} => match &right.* {
      NativeLinkInput.SearchPath {path: other} => sameText(Path.rawBytes(&path), Path.rawBytes(&other))
      _ => false
    }
    NativeLinkInput.LinkerScript {path, entry: _} => match &right.* {
      NativeLinkInput.LinkerScript {path: other, entry: _} => sameText(Path.rawBytes(&path), Path.rawBytes(&other))
      _ => false
    }
    NativeLinkInput.Library {name, linkage, entry: _} => match &right.* {
      NativeLinkInput.Library {name: other, linkage: otherLinkage, entry: _} => linkage == otherLinkage && sameText(Bytes.asSlice(&name), Bytes.asSlice(&other))
      _ => false
    }
    NativeLinkInput.Framework {name, entry: _} => match &right.* {
      NativeLinkInput.Framework {name: other, entry: _} => sameText(Bytes.asSlice(&name), Bytes.asSlice(&other))
      _ => false
    }
    NativeLinkInput.Sources {language, files, ..} => match &right.* {
      NativeLinkInput.Sources {language: otherLanguage, files: otherFiles, ..} => language == otherLanguage
        && samePaths(List<Path>.asSlice(&files), List<Path>.asSlice(&otherFiles))
      _ => false
    }
  }
}

fn sameText(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

// The number of members of a table, or none for another value kind.
fn memberCount(value: &TomlValue) -> Option<usize> {
  return match &value.* {
    TomlValue.Table {entries, kind: _} => {
      let boxed = Box<List<TomlChild>>.get(&entries)
      return Option<usize>.some(List<TomlChild>.length(&boxed[0]))
    }
    _ => Option<usize>.none()
  }
}

// A library or framework name: nonempty, not an option, and free of whitespace, NUL and separators.
fn nativeName(text: &[u8]) -> bool {
  if text.length == usize.ZERO || text[usize.ZERO] == 45 { return false }
  let mut at = usize.ZERO
  while at < text.length {
    let byte = text[at]
    // NUL, tab through carriage return, space, slash and backslash.
    if byte == 0 || (byte >= 9 && byte <= 13) || byte == 32 || byte == 47 || byte == 92 { return false }
    at = at + usize.ONE
  }
  return true
}

// The rule every entry follows, for a refusal of its shape.
fn shapeRule() -> &'static [u8] {
  return b"an entry is exactly one object, static-archive, search-path, linker-script or framework value, or one library with mode \"static\" or \"dynamic\", plus an optional os"
}

// The rule an `os` value follows, for its refusal.
fn systemRule() -> &'static [u8] {
  return b"os must be one of \"macos\", \"linux\", \"windows\" and \"wasi\", or a nonempty list of them"
}

// The systems entry `at`'s `os` names, as `systemBit`s; zero when it names none.
effect fn systemsOf(manifest: &Path, at: usize, entry: &TomlValue) -> u8
! InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  let written = match move Toml.field(entry, "os") {
    Option<&TomlValue>.Some {value} => value
    Option<&TomlValue>.None => { return 0 }
  }
  if let Option<string>.Some {value} = move Toml.asString(Option<&TomlValue>.some(written)) {
    let bit = systemBit(String.utf8Bytes(value))
    if bit == 0 { run refuse(manifest, at, systemRule()) }
    return bit
  }
  let listed = match &written.* {
    TomlValue.Array {..} => true
    _ => false
  }
  if !listed { run refuse(manifest, at, systemRule()) }
  let mut systems: u8 = 0
  let mut item = usize.ZERO
  while true {
    let named = match move Toml.item(written, item) {
      Option<&TomlValue>.Some {value} => value
      Option<&TomlValue>.None => { break }
    }
    let bit = match move Toml.asString(Option<&TomlValue>.some(named)) {
      Option<string>.Some {value} => systemBit(String.utf8Bytes(value))
      Option<string>.None => 0
    }
    if bit == 0 { run refuse(manifest, at, systemRule()) }
    systems = systems | bit
    item = item + usize.ONE
  }
  if systems == 0 { run refuse(manifest, at, systemRule()) }
  return systems
}

// The `<manifest>: [native].link[<at>]: ` prefix that names one entry.
effect fn entryPrefix(manifest: &Path, at: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut detail = run Bytes.copy(Path.rawBytes(manifest))
  run Bytes.append(&mut detail, b": [native].link[")
  run JsonText.appendDecimal(&mut detail, at)
  run Bytes.append(&mut detail, b"]: ")
  return move detail
}

// Fails naming entry `at` of `manifest`'s `[native].link`, then `rule`.
effect fn refuse(manifest: &Path, at: usize, rule: &[u8]) -> never ! InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  let mut detail = run entryPrefix(manifest, at)
  run Bytes.append(&mut detail, rule)
  fail InvalidNativeLinkInput {detail: move detail}
}

// Fails with an entry's recorded prefix, then `rule`.
effect fn refuseEntry(entry: &Bytes, rule: &[u8]) -> never ! InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  let mut detail = run Bytes.copy(Bytes.asSlice(entry))
  run Bytes.append(&mut detail, rule)
  fail InvalidNativeLinkInput {detail: move detail}
}

effect fn namedText(manifest: &Path, at: usize, entry: &TomlValue, key: string) -> Bytes
! InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  return match move Toml.asString(Toml.field(entry, key)) {
    Option<string>.Some {value} => {
      let text = String.utf8Bytes(value)
      if !nativeName(text) {
        let mut rule = run Bytes.copy(String.utf8Bytes(key))
        run Bytes.append(&mut rule, b" must be a name: not empty, not starting with -, and without whitespace or path separators")
        run refuse(manifest, at, Bytes.asSlice(&rule))
      }
      return run Bytes.copy(text)
    }
    Option<string>.None => run refuse(manifest, at, shapeRule())
  }
}

// A relative path below `directory`. An absolute, empty, dot or dot-dot spelling is refused, so a
// package links only files it holds, wherever it is built.
effect fn relativePath(manifest: &Path, at: usize, directory: &Path, entry: &TomlValue, key: string) -> Option<Path>
! InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  let written = match move Toml.asString(Toml.field(entry, key)) {
    Option<string>.Some {value} => value
    Option<string>.None => { return Option<Path>.none() }
  }
  return match move run Effect.result(Path.join(directory, written)) {
    Result<Path, FileError | OutOfMemoryError>.Success {value} => Option<Path>.some(move value)
    Result<Path, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError refused => {
        drop refused
        let mut rule = run Bytes.copy(String.utf8Bytes(key))
        run Bytes.append(&mut rule, b" ")
        run Bytes.append(&mut rule, String.utf8Bytes(written))
        run Bytes.append(&mut rule, b" must be a relative path below the manifest's directory, without . or .. segments, so the package names only its own files")
        run refuse(manifest, at, Bytes.asSlice(&rule))
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

effect fn decode(manifest: &Path, at: usize, directory: &Path, entry: &TomlValue, systems: u8) -> NativeLinkInput
! InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  let mut members = match move memberCount(entry) {
    Option<usize>.Some {value} => value
    Option<usize>.None => run refuse(manifest, at, b"an entry must be an inline table")
  }
  if systems != 0 { members = members - usize.ONE }
  if members == usize.add(0, 2) {
    let name = run namedText(manifest, at, entry, "library")
    let mode = match move Toml.asString(Toml.field(entry, "mode")) {
      Option<string>.Some {value} => String.utf8Bytes(value)
      Option<string>.None => run refuse(manifest, at, shapeRule())
    }
    if sameText(mode, b"static") {
      return NativeLinkInput.Library {name: move name, linkage: Linkage.Static, entry: run entryPrefix(manifest, at)}
    }
    if sameText(mode, b"dynamic") {
      return NativeLinkInput.Library {name: move name, linkage: Linkage.Dynamic, entry: run entryPrefix(manifest, at)}
    }
    run refuse(manifest, at, b"a library's mode must be \"static\" or \"dynamic\"")
  }
  if members != usize.ONE { run refuse(manifest, at, shapeRule()) }
  let object = run relativePath(manifest, at, directory, entry, "object")
  if let Option<Path>.Some {value} = move object {
    return NativeLinkInput.Object {path: move value}
  }
  let archive = run relativePath(manifest, at, directory, entry, "static-archive")
  if let Option<Path>.Some {value} = move archive {
    return NativeLinkInput.StaticArchive {path: move value}
  }
  let searched = run relativePath(manifest, at, directory, entry, "search-path")
  if let Option<Path>.Some {value} = move searched {
    return NativeLinkInput.SearchPath {path: move value}
  }
  let script = run relativePath(manifest, at, directory, entry, "linker-script")
  if let Option<Path>.Some {value} = move script {
    return NativeLinkInput.LinkerScript {path: move value, entry: run entryPrefix(manifest, at)}
  }
  let framework = run namedText(manifest, at, entry, "framework")
  return NativeLinkInput.Framework {name: move framework, entry: run entryPrefix(manifest, at)}
}

/// Reads `[native].sources` and then `[native].link` from the parsed `manifest`, whose text is
/// `text`, in `directory`, each in declaration order, with the operating systems each entry links
/// on. A package's compiled sources come first, so the archives and libraries it links resolve
/// their references. A refusal names the manifest, the entry and the rule it breaks; an entry for
/// another system is checked all the same.
pub effect fn read(document: &TomlValue, manifest: &Path, text: &[u8], directory: &Path) -> List<Declared>
! InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  let mut inputs = run readSources(document, manifest, text, directory)
  let declared = match move ManifestFields.linkInputs(document) {
    Option<&TomlValue>.Some {value} => value
    Option<&TomlValue>.None => { return move inputs }
  }
  let listed = match &declared.* {
    TomlValue.Array {..} => true
    _ => false
  }
  if !listed {
    let mut detail = run Bytes.copy(Path.rawBytes(manifest))
    run Bytes.append(&mut detail, b": [native].link must be an array of inline tables")
    fail InvalidNativeLinkInput {detail: move detail}
  }
  let mut at = usize.ZERO
  while true {
    let entry = match move Toml.item(declared, at) {
      Option<&TomlValue>.Some {value} => value
      Option<&TomlValue>.None => { break }
    }
    if let Option<usize>.None = move memberCount(entry) { run refuse(manifest, at, b"an entry must be an inline table") }
    let systems = run systemsOf(manifest, at, entry)
    let input = run decode(manifest, at, directory, entry, systems)
    run List<Declared>.append(&mut inputs, Declared {input: move input, systems: systems})
    at = at + usize.ONE
  }
  return move inputs
}

/// Reads `[native].function-order` from the parsed `manifest` in `directory`: the file, below
/// the manifest's directory, that lists the symbols an executable's link places first, in order.
/// A refusal names the manifest and the rule the value breaks.
pub effect fn functionOrder(document: &TomlValue, manifest: &Path, directory: &Path) -> Option<Path>
! InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  let declared = match move ManifestFields.functionOrder(document) {
    Option<&TomlValue>.Some {value} => value
    Option<&TomlValue>.None => { return Option<Path>.none() }
  }
  let mut detail = run Bytes.copy(Path.rawBytes(manifest))
  run Bytes.append(&mut detail, b": [native].function-order must be a relative path below the manifest's directory, without . or .. segments, so the package names only its own files")
  let written = match move Toml.asString(Option<&TomlValue>.some(declared)) {
    Option<string>.Some {value} => value
    Option<string>.None => { fail InvalidNativeLinkInput {detail: move detail} }
  }
  return match move run Effect.result(Path.join(directory, written)) {
    Result<Path, FileError | OutOfMemoryError>.Success {value} => Option<Path>.some(move value)
    Result<Path, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError refused => {
        drop refused
        fail InvalidNativeLinkInput {detail: move detail}
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// The `<manifest>:<line>: [native].sources[<at>]: ` prefix that names one sources entry; the line
// is left out when the text does not show it.
effect fn sourcesPrefix(manifest: &Path, text: &[u8], at: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut key = run Bytes.copy(b"native.sources.")
  run JsonText.appendDecimal(&mut key, at)
  let line = ManifestText.keyLine(text, Bytes.asSlice(&key))
  let mut detail = run Bytes.copy(Path.rawBytes(manifest))
  if line > usize.ZERO {
    run Bytes.append(&mut detail, b":")
    run JsonText.appendDecimal(&mut detail, line)
  }
  run Bytes.append(&mut detail, b": [native].sources[")
  run JsonText.appendDecimal(&mut detail, at)
  run Bytes.append(&mut detail, b"]: ")
  return move detail
}

// The rule every sources entry follows, for a refusal of its shape.
fn sourcesRule() -> &'static [u8] {
  return b"an entry names its files with exactly one of c, objc, cpp and objcpp, as a path or a list of paths, plus optional flags, include and os"
}

// The rule each sources flag follows, for its refusal.
fn flagRule() -> &'static [u8] {
  return b"sources take defines (-D, -U), warnings (-W, -w, -pedantic), a language standard (-std=), optimization (-O), debug information (-g) and code generation flags (-f, -m), and never a flag that loads code, reads other files or changes tools"
}

fn startsWith(text: &[u8], prefix: &[u8]) -> bool {
  if text.length < prefix.length { return false }
  let mut at = usize.ZERO
  while at < prefix.length {
    if text[at] != prefix[at] { return false }
    at = at + usize.ONE
  }
  return true
}

/// Whether a `[native].sources` flag is allowed: a define, warning, language standard,
/// optimization level, debug information or code generation flag, written as one argument, that
/// neither loads code nor names a file for Clang to read or write.
pub fn allowedFlag(flag: &[u8]) -> bool {
  if flag.length < usize.add(0, 2) || flag[usize.ZERO] != 45 { return false }
  if startsWith(flag, b"-D") || startsWith(flag, b"-U") { return flag.length > usize.add(0, 2) }
  if sameText(flag, b"-w") || sameText(flag, b"-pedantic") || sameText(flag, b"-pedantic-errors") { return true }
  if startsWith(flag, b"-W") {
    // `-Wl,`, `-Wa,` and `-Wp,` hand arguments to other tools.
    return flag.length > usize.add(0, 2) && !(flag.length >= usize.add(0, 4) && flag[usize.add(0, 3)] == 44)
  }
  if startsWith(flag, b"-std=") { return flag.length > usize.add(0, 5) }
  if startsWith(flag, b"-O") { return flag.length <= usize.add(0, 3) }
  if startsWith(flag, b"-g") { return true }
  if startsWith(flag, b"-m") { return !startsWith(flag, b"-mllvm") }
  if startsWith(flag, b"-f") {
    let refused: [&[u8]; 14] = [b"-fplugin", b"-fpass-plugin", b"-fprofile-use", b"-fprofile-instr-use", b"-fprofile-sample-use",
      b"-fprofile-list", b"-fprofile-remapping-file", b"-fsanitize-ignorelist", b"-fsanitize-blacklist", b"-fmodules-cache-path",
      b"-fmodule-map-file", b"-fmodule-file", b"-fprebuilt-module-path", b"-fcrash-diagnostics-dir"]
    let mut at = usize.ZERO
    while at < refused.length {
      if startsWith(flag, refused[at]) { return false }
      at = at + usize.ONE
    }
    return true
  }
  return false
}

// Fails naming sources entry `at`, then `rule`.
effect fn refuseSources(manifest: &Path, text: &[u8], at: usize, rule: &[u8]) -> never ! InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  let mut detail = run sourcesPrefix(manifest, text, at)
  run Bytes.append(&mut detail, rule)
  fail InvalidNativeLinkInput {detail: move detail}
}

// The strings `value` holds: itself when it is one, else its items, which must all be strings;
// none when it is neither, or `nonempty` and an empty list.
effect fn texts(value: &TomlValue, nonempty: bool) -> Option<List<Bytes>> ! OutOfMemoryError ? &mut Allocator {
  let mut found = List<Bytes>.make()
  if let Option<string>.Some {value: written} = move Toml.asString(Option<&TomlValue>.some(value)) {
    run List<Bytes>.append(&mut found, run Bytes.copy(String.utf8Bytes(written)))
    return Option<List<Bytes>>.some(move found)
  }
  let listed = match &value.* {
    TomlValue.Array {..} => true
    _ => false
  }
  if !listed { return Option<List<Bytes>>.none() }
  let mut item = usize.ZERO
  while true {
    let named = match move Toml.item(value, item) {
      Option<&TomlValue>.Some {value: listedItem} => listedItem
      Option<&TomlValue>.None => { break }
    }
    match move Toml.asString(Option<&TomlValue>.some(named)) {
      Option<string>.Some {value: written} => { run List<Bytes>.append(&mut found, run Bytes.copy(String.utf8Bytes(written))) }
      Option<string>.None => { return Option<List<Bytes>>.none() }
    }
    item = item + usize.ONE
  }
  if nonempty && List<Bytes>.length(&found) == usize.ZERO { return Option<List<Bytes>>.none() }
  return Option<List<Bytes>>.some(move found)
}

// The path `written` names below `directory`; `pattern` allows a `*` in its last segment. A path
// that leaves the package is refused, naming `key`.
effect fn packagePath(manifest: &Path, text: &[u8], at: usize, directory: &Path, key: &[u8], written: &[u8], pattern: bool) -> Path
! InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  let mut lastSlash = usize.MAX
  let mut star = usize.MAX
  let mut index = usize.ZERO
  while index < written.length {
    if written[index] == 47 { lastSlash = index }
    if written[index] == 42 && star == usize.MAX { star = index }
    index = index + usize.ONE
  }
  let mut misplaced = star != usize.MAX && !pattern
  if star != usize.MAX && lastSlash != usize.MAX && star < lastSlash { misplaced = true }
  let joined = run Effect.result(Path.joinBytes(directory, written))
  let refusal = match move joined {
    Result<Path, FileError | OutOfMemoryError>.Success {value} => {
      if !misplaced && written.length > usize.ZERO { return move value }
      drop value
      0
    }
    Result<Path, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError refused => { drop refused 0 }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  drop refusal
  let mut rule = run Bytes.copy(key)
  run Bytes.append(&mut rule, b" \"")
  run Bytes.append(&mut rule, written)
  run Bytes.append(&mut rule, b"\" must be a relative path below the manifest's directory, without . or .. segments")
  if pattern { run Bytes.append(&mut rule, b" and with any * in its last segment") }
  run Bytes.append(&mut rule, b", so the package compiles only its own files")
  run refuseSources(manifest, text, at, Bytes.asSlice(&rule))
}

// One `[native].sources` entry.
effect fn decodeSources(manifest: &Path, text: &[u8], at: usize, directory: &Path, entry: &TomlValue) -> NativeLinkInput
! InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  let members = match move memberCount(entry) {
    Option<usize>.Some {value} => value
    Option<usize>.None => run refuseSources(manifest, text, at, b"an entry must be an inline table")
  }
  let keys: [string; 4] = ["c", "objc", "cpp", "objcpp"]
  let languages: [SourceLanguage; 4] = [SourceLanguage.C, SourceLanguage.ObjectiveC, SourceLanguage.Cxx, SourceLanguage.ObjectiveCxx]
  let mut language = SourceLanguage.C
  let mut named = usize.ZERO
  let mut written = Option<&TomlValue>.none()
  let mut languageKey: &[u8] = b"c"
  let mut key = usize.ZERO
  while key < keys.length {
    if let Option<&TomlValue>.Some {value} = move Toml.field(entry, keys[key]) {
      named = named + usize.ONE
      language = languages[key]
      languageKey = String.utf8Bytes(keys[key])
      written = Option<&TomlValue>.some(value)
    }
    key = key + usize.ONE
  }
  if named != usize.ONE { run refuseSources(manifest, text, at, sourcesRule()) }
  let mut known = usize.ONE
  let mut flags = List<Bytes>.make()
  if let Option<&TomlValue>.Some {value} = move Toml.field(entry, "flags") {
    known = known + usize.ONE
    flags = match move run texts(value, false) {
      Option<List<Bytes>>.Some {value: found} => move found
      Option<List<Bytes>>.None => run refuseSources(manifest, text, at, b"flags must be a list of strings")
    }
    let listed = List<Bytes>.asSlice(&flags)
    let mut flag = usize.ZERO
    while flag < listed.length {
      if !allowedFlag(Bytes.asSlice(&listed[flag])) {
        let mut rule = run Bytes.copy(b"flag \"")
        run Bytes.append(&mut rule, Bytes.asSlice(&listed[flag]))
        run Bytes.append(&mut rule, b"\" is not allowed: ")
        run Bytes.append(&mut rule, flagRule())
        run refuseSources(manifest, text, at, Bytes.asSlice(&rule))
      }
      flag = flag + usize.ONE
    }
  }
  let mut include = List<Path>.make()
  if let Option<&TomlValue>.Some {value} = move Toml.field(entry, "include") {
    known = known + usize.ONE
    let directories = match move run texts(value, false) {
      Option<List<Bytes>>.Some {value: found} => move found
      Option<List<Bytes>>.None => run refuseSources(manifest, text, at, b"include must be a list of directories")
    }
    let listed = List<Bytes>.asSlice(&directories)
    let mut item = usize.ZERO
    while item < listed.length {
      run List<Path>.append(&mut include, run packagePath(manifest, text, at, directory, b"include", Bytes.asSlice(&listed[item]), false))
      item = item + usize.ONE
    }
  }
  if let Option<&TomlValue>.Some {..} = move Toml.field(entry, "os") { known = known + usize.ONE }
  if known != members { run refuseSources(manifest, text, at, sourcesRule()) }
  let patterns = match move written {
    Option<&TomlValue>.Some {value} => match move run texts(value, true) {
      Option<List<Bytes>>.Some {value: found} => move found
      Option<List<Bytes>>.None => run refuseSources(manifest, text, at, sourcesRule())
    }
    Option<&TomlValue>.None => run refuseSources(manifest, text, at, sourcesRule())
  }
  let mut files = List<Path>.make()
  let listed = List<Bytes>.asSlice(&patterns)
  let mut item = usize.ZERO
  while item < listed.length {
    run List<Path>.append(&mut files, run packagePath(manifest, text, at, directory, languageKey, Bytes.asSlice(&listed[item]), true))
    item = item + usize.ONE
  }
  return NativeLinkInput.Sources {language: language, files: move files, flags: move flags, include: move include,
    entry: run sourcesPrefix(manifest, text, at)}
}

// The systems sources entry `at` names in `os`, refused as a sources entry.
effect fn sourceSystems(manifest: &Path, text: &[u8], at: usize, entry: &TomlValue) -> u8
! InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  return match move run Effect.result(systemsOf(manifest, at, entry)) {
    Result<u8, InvalidNativeLinkInput | OutOfMemoryError>.Success {value} => value
    Result<u8, InvalidNativeLinkInput | OutOfMemoryError>.Failure {error} => match move error {
      InvalidNativeLinkInput refused => { drop refused run refuseSources(manifest, text, at, systemRule()) }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// Reads `[native].sources` (see [`read`]).
effect fn readSources(document: &TomlValue, manifest: &Path, text: &[u8], directory: &Path) -> List<Declared>
! InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  let mut inputs = List<Declared>.make()
  let declared = match move ManifestFields.nativeSources(document) {
    Option<&TomlValue>.Some {value} => value
    Option<&TomlValue>.None => { return move inputs }
  }
  let listed = match &declared.* {
    TomlValue.Array {..} => true
    _ => false
  }
  if !listed {
    let mut detail = run Bytes.copy(Path.rawBytes(manifest))
    run Bytes.append(&mut detail, b": [native].sources must be an array of inline tables")
    fail InvalidNativeLinkInput {detail: move detail}
  }
  let mut at = usize.ZERO
  while true {
    let entry = match move Toml.item(declared, at) {
      Option<&TomlValue>.Some {value} => value
      Option<&TomlValue>.None => { break }
    }
    if let Option<usize>.None = move memberCount(entry) { run refuseSources(manifest, text, at, b"an entry must be an inline table") }
    let systems = run sourceSystems(manifest, text, at, entry)
    let input = run decodeSources(manifest, text, at, directory, entry)
    run List<Declared>.append(&mut inputs, Declared {input: move input, systems: systems})
    at = at + usize.ONE
  }
  return move inputs
}

/// Whether `inputs` holds a `[native].sources` entry, which the build compiles before it links.
pub fn hasSources(inputs: &[NativeLinkInput]) -> bool {
  let mut at = usize.ZERO
  while at < inputs.length {
    if let NativeLinkInput.Sources {..} = &inputs[at] { return true }
    at = at + usize.ONE
  }
  return false
}

/// Whether every input of `inputs` is a `[native].sources` entry, which the build compiles into
/// objects of its own cache; true for no inputs.
pub fn onlySources(inputs: &[NativeLinkInput]) -> bool {
  let mut at = usize.ZERO
  while at < inputs.length {
    if let NativeLinkInput.Sources {..} = &inputs[at] {} else { return false }
    at = at + usize.ONE
  }
  return true
}

/// The concrete object or archive file, for linkers that accept grouped file response inputs.
/// Options, search directories, and named libraries have no concrete file here.
pub fn file(self: &NativeLinkInput) -> Option<&Path> {
  return match &self.* {
    NativeLinkInput.Object {path} => Option<&Path>.some(&path)
    NativeLinkInput.StaticArchive {path} => Option<&Path>.some(&path)
    _ => Option<&Path>.none()
  }
}

/// Whether `self` is an object or archive a relocatable link can merge into an object artifact.
pub fn relocatable(self: &NativeLinkInput) -> bool {
  return match &self.* {
    NativeLinkInput.Object {..} => true
    NativeLinkInput.StaticArchive {..} => true
    NativeLinkInput.Sources {..} => true
    _ => false
  }
}

/// Appends `self` as a static library member: only an object is one, and a declared archive is
/// never nested inside another, as the TypeScript toolchain plan refuses.
pub effect fn appendArchiveMember(self: &NativeLinkInput, process: &mut ProcessRequest) -> ()
! FileError | InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  match &self.* {
    NativeLinkInput.Object {path} => { run NativeToolchain.addPathArgument(&mut process.*, &path) }
    NativeLinkInput.Sources {entry, ..} => run refuseEntry(&entry, b"its sources were not compiled before the archive")
    _ => run invalid(b"a static library archives only declared objects; declare an archive's objects instead")
  }
}

/// Appends the clang driver arguments that link `self` for `target`. `stubbed` is a macOS link
/// against Silk's own libSystem stub, which has no frameworks, so a framework entry is refused.
pub effect fn appendArguments(self: &NativeLinkInput, target: &Target, stubbed: bool, process: &mut ProcessRequest) -> ()
! FileError | InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  let darwin = sameText(Target.operatingSystem(target), b"darwin")
  match &self.* {
    NativeLinkInput.Object {path} => {
      run NativeToolchain.addPathArgument(&mut process.*, &path)
    }
    NativeLinkInput.StaticArchive {path} => {
      run NativeToolchain.addPathArgument(&mut process.*, &path)
    }
    NativeLinkInput.SearchPath {path} => {
      run ChildProcess.addArgument(&mut process.*, "-L")
      run NativeToolchain.addPathArgument(&mut process.*, &path)
    }
    NativeLinkInput.LinkerScript {path, entry} => {
      if !sameText(Target.operatingSystem(target), b"linux") { run refuseEntry(&entry, b"a linker-script links only on Linux targets") }
      run ChildProcess.addArgument(&mut process.*, "-Xlinker")
      run ChildProcess.addArgument(&mut process.*, "-T")
      run ChildProcess.addArgument(&mut process.*, "-Xlinker")
      run NativeToolchain.addPathArgument(&mut process.*, &path)
    }
    NativeLinkInput.Library {name, linkage, entry} => {
      let mut argument = run Bytes.copy(b"-l")
      run Bytes.append(&mut argument, Bytes.asSlice(&name))
      if linkage == Linkage.Dynamic {
        run ChildProcess.addArgumentBytes(&mut process.*, Bytes.asSlice(&argument))
      } else {
        if darwin { run refuseEntry(&entry, b"a static library links only on Linux targets; macOS links libraries dynamically") }
        run ChildProcess.addArgument(&mut process.*, "-Wl,-Bstatic")
        run ChildProcess.addArgumentBytes(&mut process.*, Bytes.asSlice(&argument))
        run ChildProcess.addArgument(&mut process.*, "-Wl,-Bdynamic")
      }
    }
    NativeLinkInput.Framework {name, entry} => {
      if !darwin {
        let mut detail = run Bytes.copy(Bytes.asSlice(&entry))
        run Bytes.append(&mut detail, b"framework ")
        run Bytes.append(&mut detail, Bytes.asSlice(&name))
        run Bytes.append(&mut detail, b" links only on macOS targets")
        fail InvalidNativeLinkInput {detail: move detail}
      }
      if stubbed {
        let mut detail = run Bytes.copy(Bytes.asSlice(&entry))
        run Bytes.append(&mut detail, b"framework ")
        run Bytes.append(&mut detail, Bytes.asSlice(&name))
        run Bytes.append(&mut detail, b" needs a macOS SDK; set SDKROOT or declare an explicit [native].platform-supply that names one")
        fail InvalidNativeLinkInput {detail: move detail}
      }
      run ChildProcess.addArgument(&mut process.*, "-framework")
      run ChildProcess.addArgumentBytes(&mut process.*, Bytes.asSlice(&name))
    }
    NativeLinkInput.Sources {entry, ..} => run refuseEntry(&entry, b"its sources were not compiled before the link")
  }
  return ()
}
