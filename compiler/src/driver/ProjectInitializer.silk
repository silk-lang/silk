//! Creating a minimal Silk project, as the TypeScript CLI's `silk init` does.
//!
//! Initialization writes `silk.toml`, `src/main.silk` and a `.gitignore` that ignores `/build/`,
//! creating the project directory and its missing ancestors. The manifest also records the
//! creating compiler's release as `[package].silk-version`. A package inside a workspace builds
//! into the workspace's output directory, so it gets no `.gitignore`. A library gets `src/lib.silk` instead,
//! exported and built as a static library, and a workspace gets only a manifest with an empty
//! `[workspace].members` and the `.gitignore`. It never overwrites a manifest or an entry, and a
//! failure part-way removes everything it created and restores a `.gitignore` it changed.

import driver.Project as Projects
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.filesystem { DirectoryInfo, FileError, FileInfo, FileSystem, Path }
import silk.option { Option }
import silk.result { Result }
import silk.string { String }
import silk.usize
import silk.list { List }

/// A project that initialization refuses or could not create; nothing it created remains.
pub union InitializationError {
  /// The package name is not portable; `derived` when it came from the directory's name.
  InvalidPackageName { pub name: Bytes, pub derived: bool },
  /// A project manifest or entry already exists at `path`.
  ExistingFile { pub path: Path },
  /// The `src` path exists and is not a directory.
  SourceNotDirectory { pub path: Path },
  /// The nearest existing ancestor of the project directory is not a directory.
  AncestorNotDirectory { pub path: Path },
  /// A filesystem operation on `path` failed.
  Failed { pub path: Path },
}

/// What initialization creates.
pub enum Kind {
  /// A package whose entry is a program.
  Executable,
  /// A package whose entry is an exported module, built as a static library.
  Library,
  /// A workspace with no members yet.
  Workspace,
}

/// One created project.
pub struct Initialized {
  /// The package name written to the manifest.
  pub name: Bytes

  /// The project directory.
  pub directory: Path
}

/// The manifest initialization writes for package `name`, recording `release`, the creating
/// compiler's release version, as `silk-version`.
pub effect fn manifest(name: &[u8], release: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run Bytes.copy(b"[package]\nname = \"")
  run Bytes.append(&mut text, name)
  run Bytes.append(&mut text, b"\"\nversion = \"0.1.0\"\nsilk-version = \"")
  run Bytes.append(&mut text, release)
  run Bytes.append(&mut text, b"\"\nroot = \"src/main.silk\"\n")
  return move text
}

/// The manifest a library initialization writes for package `name`: its entry `src/lib.silk` is
/// the one exported module, and the package builds as a static library.
pub effect fn libraryManifest(name: &[u8], release: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run Bytes.copy(b"[package]\nname = \"")
  run Bytes.append(&mut text, name)
  run Bytes.append(&mut text, b"\"\nversion = \"0.1.0\"\nsilk-version = \"")
  run Bytes.append(&mut text, release)
  run Bytes.append(&mut text, b"\"\nroot = \"src/lib.silk\"\nsource-root = \"src\"\nexports = [\"lib\"]\n\n[build]\nartifact = \"static-library\"\n")
  return move text
}

/// The manifest a workspace initialization writes.
pub fn workspaceManifest() -> &'static [u8] {
  return b"[workspace]\nmembers = []\n"
}

/// The entry a library initialization writes: one function and its test, in the formatter's
/// canonical layout.
pub fn libraryEntry() -> &'static [u8] {
  return b"import silk.testing { AssertionError, Testing }\n\n/// The sum of `left` and `right`.\npub fn add(left: i32, right: i32) -> i32 {\n  return left + right\n}\n\ntest effect fn addsTwoNumbers() -> ()\n  ! AssertionError<'static> {\n  run Testing.expect(add(2, 3) == 5, \"2 + 3 is 5\")\n}\n"
}

/// The entry initialization writes: a program that logs a greeting, in the formatter's canonical
/// layout.
pub fn entry() -> &'static [u8] {
  return b"import silk.effect { Effect }\nimport silk.logger { LogError }\nimport silk.os_logger { StdoutLogger }\n\npub effect fn main() -> ()\n  ! LogError {\n  let mut logger = StdoutLogger.make()\n\n  run Effect.log(\"Hello, world!\", &()) |> Effect.provideMut(&mut logger)\n}\n"
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Whether one line of `text`, split at `\n` with an optional `\r` before it, is exactly `/build/`.
fn ignoresBuild(text: &[u8]) -> bool {
  let rule = b"/build/"
  let mut start = usize.ZERO
  let mut at = usize.ZERO
  while at <= text.length {
    if at == text.length || text[at] == 10 {
      let mut end = at
      if end > start && text[end - usize.ONE] == 13 && at < text.length {
        end = end - usize.ONE
      }
      if end - start == rule.length {
        let mut matched = true
        let mut offset = usize.ZERO
        while offset < rule.length {
          if text[start + offset] != rule[offset] {
            matched = false
          }
          offset = offset + usize.ONE
        }
        if matched {
          return true
        }
      }
      start = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

/// The `.gitignore` after initialization, or `None` when `previous` already ignores `/build/`.
pub effect fn ignore(previous: &Option<Bytes>) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let text = match &previous.* {
    Option<Bytes>.Some { value } => Bytes.asSlice(&value)
    Option<Bytes>.None => b""
  }
  if text.length == usize.ZERO {
    return Option<Bytes>.some(run Bytes.copy(b"/build/\n"))
  }
  if ignoresBuild(text) {
    return Option<Bytes>.none()
  }
  let mut next = run Bytes.copy(text)
  if text[text.length - usize.ONE] != 10 {
    run Bytes.append(&mut next, b"\n")
  }
  run Bytes.append(&mut next, b"/build/\n")
  return Option<Bytes>.some(move next)
}

effect fn copyPath(path: &Path) -> Path
  ! InitializationError | OutOfMemoryError
  ? &mut Allocator {
  let copied = run Effect.result(Path.fromBytes(Path.rawBytes(path)))
  return match move copied {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError impossible => {
        drop impossible
        fail InitializationError.Failed { path: run Path.root() }
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn failed(path: &Path, error: FileError) -> never
  ! InitializationError | OutOfMemoryError
  ? &mut Allocator {
  drop error
  fail InitializationError.Failed { path: run copyPath(path) }
}

effect fn join(base: &Path, name: string) -> Path
  ! InitializationError | OutOfMemoryError
  ? &mut Allocator {
  let joined = run Effect.result(Path.join(base, name))
  return match move joined {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError invalid => run failed(base, move invalid)
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn exists(path: &Path) -> bool
  ! InitializationError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let found = run Effect.result(FileSystem.exists(path))
  return match move found {
    Result<bool, FileError>.Success { value } => value
    Result<bool, FileError>.Failure { error } => run failed(path, move error)
  }
}

effect fn isDirectory(path: &Path) -> bool
  ! InitializationError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let inspected = run Effect.result(FileSystem.stat(path))
  return match move inspected {
    Result<FileInfo | DirectoryInfo, FileError>.Success { value } => match move value {
      DirectoryInfo directory => true
      FileInfo file => false
    }
    Result<FileInfo | DirectoryInfo, FileError>.Failure { error } => run failed(path, move error)
  }
}

effect fn write(path: &Path, bytes: &[u8]) -> ()
  ! InitializationError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let written = run Effect.result(FileSystem.writeFile(path, bytes))
  return match move written {
    Result<(), FileError>.Success { value } => value
    Result<(), FileError>.Failure { error } => run failed(path, move error)
  }
}

effect fn createDirectory(path: &Path) -> ()
  ! InitializationError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let created = run Effect.result(FileSystem.createDirectory(path))
  return match move created {
    Result<(), FileError>.Success { value } => value
    Result<(), FileError>.Failure { error } => run failed(path, move error)
  }
}

effect fn read(path: &Path) -> Bytes
  ! InitializationError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let contents = run Effect.result(FileSystem.readFile(path))
  return match move contents {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => run failed(path, move failure)
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// What initialization will create, decided before anything is written. A workspace has no source
// directory or entry.
struct Plan {
  directories: List<Path>
  source: Path
  sourceExists: bool
  manifest: Path
  manifestText: Bytes
  entry: Path
  entryText: &'static [u8]
  packaged: bool
  // A workspace member builds into its workspace's output directory, so it needs no `.gitignore`.
  writesIgnore: bool
  ignore: Path
  previousIgnore: Option<Bytes>
}

// Everything created so far, so a failed initialization can undo it.
struct Journal {
  created: List<Path>
  ignore: Path
  previousIgnore: Option<Bytes>
  ignoreChanged: bool
  committed: bool
}

effect fn record(journal: &mut Journal, path: &Path) -> ()
  ! InitializationError | OutOfMemoryError
  ? &mut Allocator {
  run List<Path>.append(&mut journal.created, run copyPath(path))
}

// Removes one created path, a file or a whole directory; a path that is already gone is fine.
effect fn removeCreated(path: &Path) -> ()
  ? &mut FileSystem | &mut Allocator {
  let inspected = run Effect.result(FileSystem.stat(path))
  match move inspected {
    Result<FileInfo | DirectoryInfo, FileError>.Success { value } => match move value {
      DirectoryInfo directory => {
        let removed = run Effect.result(FileSystem.removeDirectoryRecursively(path))
        drop removed
      }
      FileInfo file => {
        let removed = run Effect.result(FileSystem.removeFile(path))
        drop removed
      }
    }
    Result<FileInfo | DirectoryInfo, FileError>.Failure { error } => {
      drop error
    }
  }
  return ()
}

// Whether `directory` sits inside a workspace. A manifest that cannot be read counts as none.
effect fn insideWorkspace(directory: &Path) -> bool
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  return match move run Effect.result(Projects.enclosingWorkspace(directory)) {
    Result<Option<Path>, FileError | OutOfMemoryError>.Success { value } => match move value {
      Option<Path>.Some { value: _ } => true
      Option<Path>.None => false
    }
    Result<Option<Path>, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError unreadable => {
        drop unreadable
        return false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

/// Creates an executable project in `directory`. The package name is `name`, or else the
/// directory's own name, and the manifest records `compilerRelease`, the creating compiler's
/// release version.
pub effect fn initialize(directory: &Path, name: Option<Bytes>, compilerRelease: &[u8]) -> Initialized
  ! InitializationError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  return run create(directory, move name, Kind.Executable, compilerRelease)
}

/// Creates a project of `kind` in `directory`, as `initialize` does. A workspace has no package,
/// so its name is empty and `name` is unused.
pub effect fn create(directory: &Path, name: Option<Bytes>, kind: Kind, compilerRelease: &[u8]) -> Initialized
  ! InitializationError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let packaged = kind != Kind.Workspace
  let derived = match &name {
    Option<Bytes>.Some { .. } => false
    Option<Bytes>.None => true
  }
  let mut packageName = match move name {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => match move Path.name(directory) {
      Option<string>.Some { value } => run Bytes.copy(String.utf8Bytes(value))
      Option<string>.None => Bytes.make()
    }
  }
  if !packaged {
    packageName = Bytes.make()
  } else if
    !Projects.isPackageName(Bytes.asSlice(&packageName)) {
    fail InitializationError.InvalidPackageName { name: move packageName, derived: derived }
  }

  // The missing directories, outermost first, up to the nearest existing ancestor.
  let mut missing = List<Path>.make()
  let mut existing = run copyPath(directory)
  while
    !(run exists(&existing)) {
    run List<Path>.append(&mut missing, run copyPath(&existing))
    match move run Path.parent(&existing) {
      Option<Path>.Some { value } => {
        existing = move value
      }
      Option<Path>.None => {
        break
      }
    }
  }
  if
    !(run isDirectory(&existing)) {
    fail InitializationError.AncestorNotDirectory { path: move existing }
  }
  let mut directories = List<Path>.make()
  while List<Path>.length(&missing) > usize.ZERO {
    if let Option<Path>.Some { value } = move List<Path>.pop(&mut missing) {
      run List<Path>.append(&mut directories, move value)
    }
  }
  let manifestPath = run join(directory, "silk.toml")
  let source = run join(directory, "src")
  let mut entryPath = run join(&source, "main.silk")
  let mut entryText = entry()
  let mut manifestText = run manifest(Bytes.asSlice(&packageName), compilerRelease)
  if kind == Kind.Library {
    entryPath = run join(&source, "lib.silk")
    entryText = libraryEntry()
    manifestText = run libraryManifest(Bytes.asSlice(&packageName), compilerRelease)
  } else if kind == Kind.Workspace {
    manifestText = run Bytes.copy(workspaceManifest())
  }
  let ignorePath = run join(directory, ".gitignore")
  if run exists(&manifestPath) {
    fail InitializationError.ExistingFile { path: move manifestPath }
  }
  if packaged && run exists(&entryPath) {
    fail InitializationError.ExistingFile { path: move entryPath }
  }
  let sourceExists = run exists(&source)
  if packaged && sourceExists && !(run isDirectory(&source)) {
    fail InitializationError.SourceNotDirectory { path: move source }
  }
  let mut previousIgnore = Option<Bytes>.none()
  if run exists(&ignorePath) {
    previousIgnore = Option<Bytes>.some(run read(&ignorePath))
  }
  let plan = Plan {
    directories: move directories,
    source: move source,
    sourceExists: sourceExists,
    manifest: move manifestPath,
    manifestText: move manifestText,
    entry: move entryPath,
    entryText: entryText,
    packaged: packaged,
    writesIgnore: !packaged || !(run insideWorkspace(directory)),
    ignore: run copyPath(&ignorePath),
    previousIgnore: run copyIgnore(&previousIgnore),
  }
  let journal = Journal {
    created: List<Path>.make(),
    ignore: move ignorePath,
    previousIgnore: move previousIgnore,
    ignoreChanged: false,
    committed: false,
  }
  let use = effect fn(state: &mut Journal) -> ()
    ! InitializationError | OutOfMemoryError
    ? &mut FileSystem | &mut Allocator {
    let made = List<Path>.asSlice(&plan.directories)
    let mut at = usize.ZERO
    while at < made.length {
      run record(&mut state.*, &made[at])
      run createDirectory(&made[at])
      at = at + usize.ONE
    }
    if plan.packaged && !plan.sourceExists {
      run record(&mut state.*, &plan.source)
      run createDirectory(&plan.source)
    }
    let previous = &plan.previousIgnore
    let present = match &previous.* {
      Option<Bytes>.Some { .. } => true
      Option<Bytes>.None => false
    }
    if plan.writesIgnore {
      if let Option<Bytes>.Some { value: next } = move run ignore(previous) {
        if present {
          state.ignoreChanged = true
        } else {
          run record(&mut state.*, &plan.ignore)
        }
        run write(&plan.ignore, Bytes.asSlice(&next))
      }
    }
    run record(&mut state.*, &plan.manifest)
    run write(&plan.manifest, Bytes.asSlice(&plan.manifestText))
    if plan.packaged {
      run record(&mut state.*, &plan.entry)
      run write(&plan.entry, plan.entryText)
    }
    state.committed = true
    return ()
  }
  let release = effect fn(state: &mut Journal) -> ()
    ? &mut FileSystem | &mut Allocator {
    if state.committed {
      return ()
    }
    if state.ignoreChanged {
      if let Option<Bytes>.Some { value } = &state.previousIgnore {
        let restored = run Effect.result(FileSystem.writeFile(&state.ignore, Bytes.asSlice(&value)))
        drop restored
      }
    }
    let created = List<Path>.asSlice(&state.created)
    let mut at = created.length
    while at > usize.ZERO {
      at = at - usize.ONE
      run removeCreated(&created[at])
    }
    return ()
  }
  run Effect.useReleaseNonParking(move journal, move use, move release)
  return Initialized { name: move packageName, directory: run copyPath(directory) }
}

effect fn copyIgnore(value: &Option<Bytes>) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value.* {
    Option<Bytes>.Some { value: text } => Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&text)))
    Option<Bytes>.None => Option<Bytes>.none()
  }
}
