//! Compiles a build's `[native].sources` entries into objects with Clang, cached so that a build
//! compiles only the files whose inputs changed.
//!
//! # Details
//! Each source file compiles to an object in the cache directory beside the build output
//! ([`directoryFor`]), named by a digest of everything the compile reads besides headers: the
//! Clang and its version, the target and profile flags, the language, include directories and
//! flags of the entry, and the file's path and contents. Clang reports the package headers the
//! file included (`-MMD`), and a record beside the object keeps each one's digest; the object is
//! reused only while every recorded header still has its digest. System headers are left out:
//! the Clang, target and platform supply in the name already decide them.
//!
//! The build reads every source and header through its filesystem, so the record of what a build
//! read (driver/BuildInputs) sees an edit to any of them, and a build that changes nothing never
//! starts Clang.

import driver.CommandPath
import driver.HostRename
import driver.NativeLinkInput as NativeLinkInputs {InvalidNativeLinkInput, NativeLinkInput, SourceLanguage}
import driver.NativeToolchain
import semantic.ContentHash {ContentHash, Stream}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.system.child_process {ChildProcess, ProcessError}
import silk.core.effect {Effect}
import silk.system.host_input {HostInput, HostInputError}
import silk.system.filesystem {DirectoryEntry, FileError, FileSystem, Path}
import silk.system.filesystem_machine {MachineFileSystem}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.collections.slice {Slice}
import silk.num.u64
import silk.num.usize

/// The outcome of compiling a build's sources: the inputs to link, each `Sources` entry replaced
/// by the objects of its files, or the failed compile's status. `diagnostics` holds what Clang
/// wrote, warnings included. `headers` is the digest of every object's header record: an object's
/// name does not change with its headers, so a link stamp names this too. `cacheable` says whether
/// the artifact may skip native-header validation: raw paths the input recorder cannot represent
/// keep it false, while individual native objects can still reuse their freshly checked headers.
pub union NativeBuild {
  Linked {pub inputs: List<NativeLinkInput>, pub diagnostics: Bytes, pub headers: ContentHash, pub cacheable: bool},
  Failed {pub diagnostics: Bytes},
}

/// The object cache of the build that writes `output`: `<output>.native`.
pub effect fn directoryFor(output: &Path) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
  let mut named = run Bytes.copy(Path.rawBytes(output))
  run Bytes.append(&mut named, b".native")
  return run Path.fromBytes(Bytes.asSlice(&named))
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn appendByte(output: &mut Bytes, byte: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let one: [u8; 1] = [byte]
  return run Bytes.append(&mut output.*, &one)
}

fn hexDigit(value: u64) -> u8 {
  if value < 10 { return u64.toU8(value) + 48 }
  return u64.toU8(value) + 87
}

effect fn appendHex(output: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < 16 {
    run appendByte(&mut output.*, hexDigit(u64.bitAnd(u64.shiftRight(value, usize.toU64((15 - at) * 4)), 15)))
    at = at + usize.ONE
  }
  return ()
}

// The 32 hexadecimal digits that spell `digest`.
effect fn hexOf(digest: ContentHash) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  run appendHex(&mut text, digest.high)
  run appendHex(&mut text, digest.low)
  return move text
}

// The `-x` spelling of a language.
fn languageName(language: SourceLanguage) -> &'static [u8] {
  return match language {
    SourceLanguage.C => b"c"
    SourceLanguage.ObjectiveC => b"objective-c"
    SourceLanguage.Cxx => b"c++"
    SourceLanguage.ObjectiveCxx => b"objective-c++"
  }
}

// The last segment of `path`.
fn lastSegment(path: &[u8]) -> &[u8] {
  let mut start = path.length
  while start > usize.ZERO && path[start - usize.ONE] != 47 { start = start - usize.ONE }
  return Slice.view<u8>(path, start, path.length - start)
}

fn holdsStar(text: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < text.length {
    if text[at] == 42 { return true }
    at = at + usize.ONE
  }
  return false
}

/// Whether `name` matches `pattern`, where each `*` matches any run of bytes. A name that starts
/// with `.` matches only a pattern that does.
pub fn matches(pattern: &[u8], name: &[u8]) -> bool {
  if name.length > usize.ZERO && name[usize.ZERO] == 46 && (pattern.length == usize.ZERO || pattern[usize.ZERO] != 46) { return false }
  // Greedy matching that backtracks to the last `*`.
  let mut p = usize.ZERO
  let mut n = usize.ZERO
  let mut star = usize.MAX
  let mut resume = usize.ZERO
  while n < name.length {
    if p < pattern.length && pattern[p] == 42 {
      star = p
      resume = n
      p = p + usize.ONE
    } else if p < pattern.length && pattern[p] == name[n] {
      p = p + usize.ONE
      n = n + usize.ONE
    } else if star != usize.MAX {
      p = star + usize.ONE
      resume = resume + usize.ONE
      n = resume
    } else {
      return false
    }
  }
  while p < pattern.length && pattern[p] == 42 { p = p + usize.ONE }
  return p == pattern.length
}

// Whether `left` sorts before `right`, byte by byte.
fn before(left: &[u8], right: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < left.length && at < right.length {
    if left[at] != right[at] { return left[at] < right[at] }
    at = at + usize.ONE
  }
  return left.length < right.length
}

// Fails with an entry's prefix, then `rule`.
effect fn refuse(entry: &Bytes, rule: &[u8]) -> never ! InvalidNativeLinkInput | OutOfMemoryError ? &mut Allocator {
  let mut detail = run Bytes.copy(Bytes.asSlice(entry))
  run Bytes.append(&mut detail, rule)
  fail InvalidNativeLinkInput {detail: move detail}
}

// The files `file` names: itself, or for a pattern the files of its directory whose names match
// its last segment, in name order. A pattern that matches nothing is refused.
effect fn expand(file: &Path, entry: &Bytes, files: &mut List<Path>) -> ()
! FileError | InvalidNativeLinkInput | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let written = Path.rawBytes(file)
  let pattern = lastSegment(written)
  if !holdsStar(pattern) {
    run List<Path>.append(&mut files.*, run Path.fromBytes(written))
    return ()
  }
  let directory = run Path.fromBytes(Slice.view<u8>(written, usize.ZERO, written.length - pattern.length - usize.ONE))
  let listed = match move run Effect.result(FileSystem.listDirectory(&directory)) {
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success {value} => move value
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => {
        drop failure
        let mut rule = run Bytes.copy(b"cannot list ")
        run Bytes.append(&mut rule, Path.rawBytes(&directory))
        run Bytes.append(&mut rule, b" for the pattern ")
        run Bytes.append(&mut rule, pattern)
        run refuse(entry, Bytes.asSlice(&rule))
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let mut found = List<Path>.make()
  let entries = List<DirectoryEntry>.asSlice(&listed)
  let mut at = usize.ZERO
  while at < entries.length {
    // Files and links to them; a directory never compiles.
    if entries[at].kind.code != 1 && matches(pattern, lastSegment(Path.rawBytes(&entries[at].path))) {
      run List<Path>.append(&mut found, run Path.fromBytes(Path.rawBytes(&entries[at].path)))
    }
    at = at + usize.ONE
  }
  // Name order, by insertion into a list of positions.
  let candidates = List<Path>.asSlice(&found)
  let mut order = List<usize>.make()
  let mut placed = usize.ZERO
  while placed < candidates.length {
    let mut slot = usize.ZERO
    let ranked = List<usize>.asSlice(&order)
    while slot < ranked.length && before(Path.rawBytes(&candidates[ranked[slot]]), Path.rawBytes(&candidates[placed])) { slot = slot + usize.ONE }
    let one: [usize; 1] = [placed]
    run List<usize>.insertSlice(&mut order, slot, &one)
    placed = placed + usize.ONE
  }
  if candidates.length == usize.ZERO {
    let mut rule = run Bytes.copy(b"the pattern ")
    run Bytes.append(&mut rule, written)
    run Bytes.append(&mut rule, b" matches no file")
    run refuse(entry, Bytes.asSlice(&rule))
  }
  let ranked = List<usize>.asSlice(&order)
  let mut moved = usize.ZERO
  while moved < ranked.length {
    run List<Path>.append(&mut files.*, run Path.fromBytes(Path.rawBytes(&candidates[ranked[moved]])))
    moved = moved + usize.ONE
  }
  return ()
}

// The bytes of the file at `path`, or none when it cannot be read.
effect fn readOptional(path: &Path) -> Option<Bytes> ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  return match move run Effect.result(FileSystem.readFile(path)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success {value} => Option<Bytes>.some(move value)
    Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => { drop failure Option<Bytes>.none() }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// The digest of a header, or `missing` when it cannot be read. Clang can report native
// paths containing `..`; resolving these lexically changes their meaning through symlinks.
// Resolve such names through the host and retain the original name in the header record so
// every native-object validation resolves it again. The input recorder cannot represent that
// raw lookup, so the complete artifact must not bypass this validation on the next build.
effect fn digestOf(path: &[u8], cacheable: &mut bool) -> Bytes ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut resolvedName = Bytes.make()
  let parsed = match move run Effect.result(CommandPath.fromHost(path)) {
    Result<Path, FileError | OutOfMemoryError>.Success {value} => move value
    Result<Path, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => {
        drop failure
        cacheable.* = false
        resolvedName = match move run CommandPath.canonical(path) {
          Option<Bytes>.Some {value} => move value
          Option<Bytes>.None => { return run Bytes.copy(b"missing") }
        }
        match move run Effect.result(Path.fromBytes(Bytes.asSlice(&resolvedName))) {
          Result<Path, FileError | OutOfMemoryError>.Success {value} => move value
          Result<Path, FileError | OutOfMemoryError>.Failure {error: invalidPath} => match move invalidPath {
            FileError invalid => { drop invalid return run Bytes.copy(b"missing") }
            OutOfMemoryError exhausted => { fail move exhausted }
          }
        }
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  return match move run readOptional(&parsed) {
    Option<Bytes>.Some {value} => {
      let mut stream = ContentHash.stream()
      if Bytes.length(&resolvedName) > usize.ZERO {
        // A symlink retarget is significant even when the new header has identical bytes.
        ContentHash.append(&mut stream, b"resolved-native-header")
        ContentHash.appendByte(&mut stream, 0)
        ContentHash.append(&mut stream, Bytes.asSlice(&resolvedName))
        ContentHash.appendByte(&mut stream, 0)
      }
      ContentHash.append(&mut stream, Bytes.asSlice(&value))
      return run hexOf(ContentHash.finish(move stream))
    }
    Option<Bytes>.None => {
      cacheable.* = false
      return run Bytes.copy(b"missing")
    }
  }
}

// Pruning is optional. If an actual native input shares the cache directory, preserve that
// directory's contents even when an authored file has the shape of a cache artifact. Resolve
// symbolic links too; inability to establish that an input is outside the cache disables pruning.
effect fn inputInCache(path: &[u8], cache: &Option<Bytes>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let prefix = match &cache.* {
    Option<Bytes>.Some {value} => Bytes.asSlice(&value)
    Option<Bytes>.None => { return true }
  }
  return match move run CommandPath.canonical(path) {
    Option<Bytes>.Some {value} => {
      let resolved = Bytes.asSlice(&value)
      if resolved.length < prefix.length || !same(Slice.view<u8>(resolved, usize.ZERO, prefix.length), prefix) { return false }
      return resolved.length == prefix.length || resolved[prefix.length] == 47
    }
    Option<Bytes>.None => true
  }
}

// Whether the header record `record` (lines of `<digest> <path>`) still holds: every header it
// names has the digest it records.
effect fn headersUnchanged(record: &[u8], cache: &Option<Bytes>, keepCache: &mut bool, cacheable: &mut bool) -> bool ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut start = usize.ZERO
  while start < record.length {
    let mut end = start
    while end < record.length && record[end] != 10 { end = end + usize.ONE }
    let line = Slice.view<u8>(record, start, end - start)
    if line.length < usize.add(0, 34) || line[usize.add(0, 32)] != 32 { return false }
    let path = Slice.view<u8>(line, usize.add(0, 33), line.length - usize.add(0, 33))
    if !keepCache.* { keepCache.* = run inputInCache(path, cache) }
    let digest = run digestOf(path, &mut cacheable.*)
    if !same(Bytes.asSlice(&digest), Slice.view<u8>(line, usize.ZERO, usize.add(0, 32))) { return false }
    start = end + usize.ONE
  }
  return true
}

/// The files a Make dependency rule `rule` (as Clang's `-MMD` writes it) lists after its
/// target, without the first, which is the source itself.
pub effect fn dependencies(rule: &[u8]) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut found = List<Bytes>.make()
  // The target ends at the first `: `.
  let mut at = usize.ZERO
  while at + usize.ONE < rule.length && !(rule[at] == 58 && (rule[at + usize.ONE] == 32 || rule[at + usize.ONE] == 10)) { at = at + usize.ONE }
  at = at + usize.ONE
  let mut current = Bytes.make()
  let mut listed = usize.ZERO
  while at <= rule.length {
    let mut separator = at == rule.length
    if !separator {
      let byte = rule[at]
      if byte == 92 && at + usize.ONE < rule.length && (rule[at + usize.ONE] == 10 || rule[at + usize.ONE] == 13) {
        // A continued line.
        separator = true
      } else if byte == 92 && at + usize.ONE < rule.length && rule[at + usize.ONE] == 32 {
        run appendByte(&mut current, 32)
        at = at + usize.ONE
      } else if byte == 32 || byte == 9 || byte == 10 || byte == 13 {
        separator = true
      } else {
        run appendByte(&mut current, byte)
      }
    }
    if separator && Bytes.length(&current) > usize.ZERO {
      if listed > usize.ZERO { run List<Bytes>.append(&mut found, move current) } else { drop current }
      current = Bytes.make()
      listed = listed + usize.ONE
    }
    at = at + usize.ONE
  }
  return move found
}

// Compiles `source` (whose contents are `contents`) into `object` unless the cache holds it with
// unchanged headers, and answers Clang's status: 0 when the object is ready.
effect fn compileOne(clang: &Path, base: &[Bytes], language: SourceLanguage, include: &[Path], flags: &[Bytes], source: &Path,
  object: &Path, record: &Path, diagnostics: &mut Bytes, headerDigests: &mut Stream, cacheFiles: &mut MachineFileSystem, cache: &Option<Bytes>, keepCache: &mut bool, cacheable: &mut bool) -> i32
! FileError | ProcessError | HostInputError | OutOfMemoryError ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  if let Option<Bytes>.Some {value: recorded} = move run readOptional(record) |> Effect.provideMut<FileSystem>(&mut cacheFiles.*) {
    let present = run FileSystem.exists(object) |> Effect.provideMut<FileSystem>(&mut cacheFiles.*)
    if present {
      let unchanged = run headersUnchanged(Bytes.asSlice(&recorded), cache, &mut keepCache.*, &mut cacheable.*)
      if unchanged {
        ContentHash.append(&mut headerDigests.*, Bytes.asSlice(&recorded))
        return 0
      }
    }
  }
  let objectBytes = Path.rawBytes(object)
  let mut partialBytes = run Bytes.copy(objectBytes)
  run Bytes.append(&mut partialBytes, b".partial")
  let partial = run Path.fromBytes(Bytes.asSlice(&partialBytes))
  let mut ruleBytes = run Bytes.copy(objectBytes)
  run Bytes.append(&mut ruleBytes, b".d")
  let rule = run Path.fromBytes(Bytes.asSlice(&ruleBytes))
  let mut request = run NativeToolchain.request(clang)
  run ChildProcess.addArgument(&mut request, "-c")
  run ChildProcess.addArgument(&mut request, "-Wno-unused-command-line-argument")
  let mut at = usize.ZERO
  while at < base.length {
    run ChildProcess.addArgumentBytes(&mut request, Bytes.asSlice(&base[at]))
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < include.length {
    run ChildProcess.addArgument(&mut request, "-I")
    run NativeToolchain.addPathArgument(&mut request, &include[at])
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < flags.length {
    run ChildProcess.addArgumentBytes(&mut request, Bytes.asSlice(&flags[at]))
    at = at + usize.ONE
  }
  run ChildProcess.addArgument(&mut request, "-MMD")
  run ChildProcess.addArgument(&mut request, "-MF")
  run NativeToolchain.addPathArgument(&mut request, &rule)
  run ChildProcess.addArgument(&mut request, "-x")
  run ChildProcess.addArgumentBytes(&mut request, languageName(language))
  run NativeToolchain.addPathArgument(&mut request, source)
  run ChildProcess.addArgument(&mut request, "-o")
  run NativeToolchain.addPathArgument(&mut request, &partial)
  let outcome = run ChildProcess.submit(&request)
  run Bytes.append(&mut diagnostics.*, ChildProcess.errorBytes(&outcome))
  let mut status: i32 = 1
  if let Option<i32>.Some {value} = move ChildProcess.exitCode(&outcome) { status = value }
  if status != 0 {
    if status < 0 { status = 1 }
    return status
  }
  // The headers' digests, read before the object is published so a header edited meanwhile
  // compiles again next time.
  let mut headers = Bytes.make()
  if let Option<Bytes>.Some {value: written} = move run readOptional(&rule) |> Effect.provideMut<FileSystem>(&mut cacheFiles.*) {
    let listed = run dependencies(Bytes.asSlice(&written))
    let names = List<Bytes>.asSlice(&listed)
    let mut name = usize.ZERO
    while name < names.length {
      if !keepCache.* { keepCache.* = run inputInCache(Bytes.asSlice(&names[name]), cache) }
      let digest = run digestOf(Bytes.asSlice(&names[name]), &mut cacheable.*)
      run Bytes.append(&mut headers, Bytes.asSlice(&digest))
      run Bytes.append(&mut headers, b" ")
      run Bytes.append(&mut headers, Bytes.asSlice(&names[name]))
      run Bytes.append(&mut headers, b"\n")
      name = name + usize.ONE
    }
    let removed = run Effect.result(FileSystem.removeFile(&rule) |> Effect.provideMut<FileSystem>(&mut cacheFiles.*))
    drop removed
  } else {
    run Bytes.append(&mut diagnostics.*, b"silk: Clang wrote no dependency file for ")
    run Bytes.append(&mut diagnostics.*, Path.rawBytes(source))
    run Bytes.append(&mut diagnostics.*, b"\n")
    return 1
  }
  if !run HostRename.replaceFile(&partial, object) {
    run Bytes.append(&mut diagnostics.*, b"silk: cannot write ")
    run Bytes.append(&mut diagnostics.*, objectBytes)
    run Bytes.append(&mut diagnostics.*, b"\n")
    return 1
  }
  run FileSystem.writeFile(record, Bytes.asSlice(&headers)) |> Effect.provideMut<FileSystem>(&mut cacheFiles.*)
  ContentHash.append(&mut headerDigests.*, Bytes.asSlice(&headers))
  return 0
}

/// Compiles each `Sources` entry of `inputs` into objects in `cache` and answers the inputs with
/// those objects in its place, in order.
///
/// `clang` compiles with `identity` (its version output, and anything else that decides what it
/// writes but that `base` does not spell, such as a platform supply's file digests) and `base`,
/// the target and profile flags every native compile of the build shares.
pub effect fn compile(inputs: &[NativeLinkInput], cache: &Path, clang: &Path, identity: &[u8], base: &[Bytes]) -> NativeBuild
! FileError | ProcessError | HostInputError | InvalidNativeLinkInput | OutOfMemoryError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  // Cache metadata is not an authored input. Keep these operations outside a caller's input
  // recorder, while source expansion and every source/header digest use its filesystem.
  let mut cacheFiles = run MachineFileSystem.make()
  run FileSystem.createDirectoriesRecursively(cache) |> Effect.provideMut<FileSystem>(&mut cacheFiles)
  let canonicalCache = run CommandPath.canonical(Path.rawBytes(cache))
  let mut keepCache = false
  let mut cacheable = true
  let mut shared = run Bytes.copy(b"silk-native-1\n")
  run Bytes.append(&mut shared, Path.rawBytes(clang))
  run Bytes.append(&mut shared, b"\n")
  run Bytes.append(&mut shared, identity)
  let mut at = usize.ZERO
  while at < base.length {
    run Bytes.append(&mut shared, b"\n")
    run Bytes.append(&mut shared, Bytes.asSlice(&base[at]))
    at = at + usize.ONE
  }
  let mut linked = List<NativeLinkInput>.make()
  let mut kept = List<Bytes>.make()
  let mut diagnostics = Bytes.make()
  let mut headerDigests = ContentHash.stream()
  at = usize.ZERO
  while at < inputs.length {
    match &inputs[at] {
      NativeLinkInput.Sources {language, files, flags, include, entry} => {
        let mut expanded = List<Path>.make()
        let declared = List<Path>.asSlice(&files)
        let mut file = usize.ZERO
        while file < declared.length {
          run expand(&declared[file], &entry, &mut expanded)
          file = file + usize.ONE
        }
        // The entry's part of every object's name.
        let mut keyed = run Bytes.copy(Bytes.asSlice(&shared))
        run Bytes.append(&mut keyed, b"\n-x ")
        run Bytes.append(&mut keyed, languageName(language))
        let directories = List<Path>.asSlice(&include)
        let mut directory = usize.ZERO
        while directory < directories.length {
          run Bytes.append(&mut keyed, b"\n-I ")
          run Bytes.append(&mut keyed, Path.rawBytes(&directories[directory]))
          directory = directory + usize.ONE
        }
        let written = List<Bytes>.asSlice(&flags)
        let mut flag = usize.ZERO
        while flag < written.length {
          run Bytes.append(&mut keyed, b"\n")
          run Bytes.append(&mut keyed, Bytes.asSlice(&written[flag]))
          flag = flag + usize.ONE
        }
        let sources = List<Path>.asSlice(&expanded)
        let mut source = usize.ZERO
        while source < sources.length {
          if !keepCache { keepCache = run inputInCache(Path.rawBytes(&sources[source]), &canonicalCache) }
          let contents = match move run readOptional(&sources[source]) {
            Option<Bytes>.Some {value} => move value
            Option<Bytes>.None => {
              let mut rule = run Bytes.copy(b"cannot read the source file ")
              run Bytes.append(&mut rule, Path.rawBytes(&sources[source]))
              run refuse(&entry, Bytes.asSlice(&rule))
            }
          }
          let mut stream = ContentHash.stream()
          ContentHash.append(&mut stream, Bytes.asSlice(&keyed))
          ContentHash.append(&mut stream, b"\n")
          ContentHash.append(&mut stream, Path.rawBytes(&sources[source]))
          ContentHash.append(&mut stream, b"\n")
          ContentHash.append(&mut stream, Bytes.asSlice(&contents))
          let name = run hexOf(ContentHash.finish(move stream))
          let mut objectName = run Bytes.copy(Bytes.asSlice(&name))
          run Bytes.append(&mut objectName, b".o")
          let object = run Path.joinBytes(cache, Bytes.asSlice(&objectName))
          let mut recordName = run Bytes.copy(Bytes.asSlice(&name))
          run Bytes.append(&mut recordName, b".headers")
          let record = run Path.joinBytes(cache, Bytes.asSlice(&recordName))
          let status = run compileOne(clang, base, language, List<Path>.asSlice(&include), written, &sources[source], &object, &record,
            &mut diagnostics, &mut headerDigests, &mut cacheFiles, &canonicalCache, &mut keepCache, &mut cacheable)
          if status != 0 { return NativeBuild.Failed {diagnostics: move diagnostics} }
          run List<Bytes>.append(&mut kept, move name)
          run List<NativeLinkInput>.append(&mut linked, NativeLinkInputs.object(move object))
          source = source + usize.ONE
        }
      }
      _ => {
        if !keepCache { keepCache = NativeLinkInputs.below(&inputs[at], Path.rawBytes(cache)) }
        if !keepCache {
          if let Option<&Path>.Some {value: path} = move NativeLinkInputs.file(&inputs[at]) {
            keepCache = run inputInCache(Path.rawBytes(path), &canonicalCache)
          }
        }
        run List<NativeLinkInput>.append(&mut linked, run NativeLinkInputs.copy(&inputs[at]))
      }
    }
    at = at + usize.ONE
  }
  if !keepCache { run prune(cache, List<Bytes>.asSlice(&kept)) |> Effect.provideMut<FileSystem>(&mut cacheFiles) }
  return NativeBuild.Linked {inputs: move linked, diagnostics: move diagnostics, headers: ContentHash.finish(move headerDigests), cacheable: cacheable}
}

// Whether a name has the exact digest-and-suffix form of this cache's own files. Authored
// sources and headers may share the directory and must never be pruned as cache artifacts.
fn cacheArtifact(name: &[u8]) -> bool {
  if name.length < 34 { return false }
  let mut at = usize.ZERO
  while at < 32 {
    let byte = name[at]
    if !(byte >= 48 && byte <= 57) && !(byte >= 97 && byte <= 102) { return false }
    at = at + usize.ONE
  }
  let suffix = Slice.view<u8>(name, 32, name.length - 32)
  return same(suffix, b".o") || same(suffix, b".headers") || same(suffix, b".o.partial") || same(suffix, b".o.d")
}

// Removes only this cache's objects and records whose digest is no longer in `kept`.
effect fn prune(cache: &Path, kept: &[Bytes]) -> () ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let listed = match move run Effect.result(FileSystem.listDirectory(cache)) {
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success {value} => move value
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => { drop failure return () }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let entries = List<DirectoryEntry>.asSlice(&listed)
  let mut at = usize.ZERO
  while at < entries.length {
    let name = lastSegment(Path.rawBytes(&entries[at].path))
    let mut used = !cacheArtifact(name)
    if !used {
      let digest = Slice.view<u8>(name, usize.ZERO, usize.add(0, 32))
      let mut keep = usize.ZERO
      while keep < kept.length && !used {
        used = same(digest, Bytes.asSlice(&kept[keep]))
        keep = keep + usize.ONE
      }
    }
    if !used {
      let removed = run Effect.result(FileSystem.removeFile(&entries[at].path))
      drop removed
    }
    at = at + usize.ONE
  }
  return ()
}

/// Reads every file that compiling and linking `inputs` can read, so that a recording filesystem
/// (driver/BuildInputs) notes each one without starting Clang: the files of each `Sources` entry,
/// with its patterns expanded, every file below each such file's directory and below the entry's
/// include directories, and each object and static archive. A file that cannot be read is noted as
/// missing. A header reached only through a `..` path or an `-I` flag outside those directories is
/// not read.
pub effect fn readInputs(inputs: &[NativeLinkInput]) -> () ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut at = usize.ZERO
  while at < inputs.length {
    match &inputs[at] {
      NativeLinkInput.Sources {language: _, files, flags: _, include, entry} => {
        let written = List<Path>.asSlice(&files)
        let mut file = usize.ZERO
        while file < written.length {
          let mut expanded = List<Path>.make()
          let attempted = run Effect.result(expand(&written[file], &entry, &mut expanded))
          if let Result<(), FileError | InvalidNativeLinkInput | OutOfMemoryError>.Failure {error} = move attempted {
            match move error {
              FileError failure => { drop failure }
              InvalidNativeLinkInput refused => { drop refused }
              OutOfMemoryError exhausted => { fail move exhausted }
            }
          }
          let found = List<Path>.asSlice(&expanded)
          let mut one = usize.ZERO
          while one < found.length {
            drop run readOptional(&found[one])
            // A quoted `#include` finds headers beside the file first.
            if let Option<Path>.Some {value: beside} = move run Path.parent(&found[one]) { run readTree(&beside) }
            one = one + usize.ONE
          }
          file = file + usize.ONE
        }
        let directories = List<Path>.asSlice(&include)
        let mut directory = usize.ZERO
        while directory < directories.length {
          run readTree(&directories[directory])
          directory = directory + usize.ONE
        }
      }
      _ => {
        if let Option<&Path>.Some {value: file} = move NativeLinkInputs.file(&inputs[at]) { drop run readOptional(file) }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// Reads every file at or below `path`.
effect fn readTree(path: &Path) -> () ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let listed = match move run Effect.result(FileSystem.listDirectory(path)) {
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success {value} => move value
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => {
        drop failure
        drop run readOptional(path)
        return ()
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let children = List<DirectoryEntry>.asSlice(&listed)
  let mut at = usize.ZERO
  while at < children.length {
    if children[at].kind.code == 1 { run readTree(&children[at].path) } else { drop run readOptional(&children[at].path) }
    at = at + usize.ONE
  }
  return ()
}
