//! The macOS executable's SDK-free libSystem stub.
//!
//! A macOS link with no SDK links against a TAPI text stub that Silk writes itself: the install
//! name `/usr/lib/libSystem.B.dylib` and the names of the symbols Silk programs bind there. No SDK
//! file is read or copied. `ld64.lld` reads the stub, and the program binds those symbols in the
//! real libSystem when it runs.

import silk.collections.bytes { Bytes }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileSystem, FileError, Path }
import silk.system.child_process { ChildProcess, ProcessRequest }
import silk.text.string { String }
import driver.NativeToolchain
import silk.num.usize

// The libSystem symbols, in Mach-O spelling, that the standard library, the compiler's runtime
// and LLVM's code bind on both macOS architectures: libc, libm, libdyld, libunwind and the
// compiler-rt builtins (`__divti3` and the like) that libSystem re-exports.
fn shared() -> string<'static> {
  return """
    __NSGetEnviron
    __Unwind_Backtrace
    __Unwind_GetRegionStart
    ___bzero
    ___chkstk_darwin
    ___divti3
    ___error
    ___fixdfti
    ___fixsfti
    ___fixunsdfti
    ___fixunssfti
    ___floattidf
    ___floattisf
    ___floatuntidf
    ___floatuntisf
    ___modti3
    ___muloti4
    ___stack_chk_fail
    ___stack_chk_guard
    ___stderrp
    ___udivti3
    ___ulock_wait
    ___ulock_wake
    ___umodti3
    __exit
    __tlv_bootstrap
    _abort
    _abs
    _accept
    _access
    _arc4random_buf
    _bind
    _bzero
    _calloc
    _ceil
    _ceilf
    _chmod
    _clock_getres
    _clock_gettime
    _close
    _close$NOCANCEL
    _closedir
    _connect
    _dirfd
    _dup2
    _environ
    _execv
    _fabs
    _fabsf
    _fcntl
    _flock
    _flockfile
    _floor
    _floorf
    _fma
    _fmaf
    _fmod
    _fmodf
    _fork
    _free
    _freeaddrinfo
    _fsync
    _ftruncate
    _funlockfile
    _getaddrinfo
    _getcwd
    _getenv
    _getrlimit
    _getsockname
    _getsockopt
    _isatty
    _kill
    _link
    _linkat
    _listen
    _malloc
    _memcmp
    _memcpy
    _memmove
    _memset
    _mkdirat
    _mkstemp
    _nanosleep
    _nearbyint
    _nearbyintf
    _open
    _openat
    _pipe
    _poll
    _posix_spawn
    _posix_spawn_file_actions_addchdir_np
    _posix_spawn_file_actions_addclose
    _posix_spawn_file_actions_adddup2
    _posix_spawn_file_actions_destroy
    _posix_spawn_file_actions_init
    _posix_spawnattr_destroy
    _posix_spawnattr_init
    _posix_spawnattr_setflags
    _pthread_attr_destroy
    _pthread_attr_init
    _pthread_attr_setstacksize
    _pthread_create
    _pthread_join
    _qsort
    _read
    _readlinkat
    _realloc
    _recv
    _rename
    _renameat
    _rint
    _rintf
    _round
    _roundf
    _sched_yield
    _send
    _setenv
    _setsid
    _setsockopt
    _shutdown
    _sigaction
    _sigaltstack
    _socket
    _sqrt
    _sqrtf
    _strlen
    _symlink
    _sysconf
    _sysctlbyname
    _trunc
    _truncf
    _unlink
    _unlinkat
    _waitpid
    _write
    _writev
    dyld_stub_binder
    """
}

// The symbols whose spelling differs by architecture. Intel macOS keeps the legacy 32-bit inode
// layout and `realpath` under the plain names, so Silk binds the `$INODE64` and `$DARWIN_EXTSN`
// variants there; Apple silicon has only the current layouts, under the plain names.
fn intel() -> string<'static> {
  return """
    _fdopendir$INODE64
    _fstat$INODE64
    _fstatat$INODE64
    _readdir$INODE64
    _realpath$DARWIN_EXTSN
    """
}

fn appleSilicon() -> string<'static> {
  return """
    _fdopendir
    _fstat
    _fstatat
    _readdir
    _realpath
    """
}

// Appends the whitespace-separated names of `list` to `text` as a YAML flow sequence.
effect fn appendSymbols(text: &mut Bytes, list: string<'static>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let names = String.utf8Bytes(list)
  run Bytes.append(&mut text.*, b"[ ")
  let mut first = true
  let mut at = usize.ZERO
  while at < names.length {
    while at < names.length && (names[at] == 32 || names[at] == 10 || names[at] == 13) {
      at = at + usize.ONE
    }
    let start = at
    while at < names.length && names[at] != 32 && names[at] != 10 && names[at] != 13 {
      at = at + usize.ONE
    }
    if at > start {
      if !first {
        run Bytes.append(&mut text.*, b", ")
      }
      first = false
      let mut index = start
      while index < at {
        let byte = [names[index]]
        run Bytes.append(&mut text.*, &byte)
        index = index + usize.ONE
      }
    }
  }
  run Bytes.append(&mut text.*, b" ]\n")
}

/// The TAPI v4 text of Silk's libSystem stub: one document for both macOS architectures that
/// names `/usr/lib/libSystem.B.dylib` and the symbols Silk programs bind in it. The text is the
/// same for every link, so its digest identifies the stub.
pub effect fn libSystem() -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run Bytes.copy(
    b"--- !tapi-tbd\ntbd-version: 4\ntargets: [ arm64-macos, x86_64-macos ]\n",
  )
  run Bytes.append(
    &mut text,
    b"install-name: '/usr/lib/libSystem.B.dylib'\ncurrent-version: 1351\nexports:\n",
  )
  run Bytes.append(&mut text, b"  - targets: [ arm64-macos, x86_64-macos ]\n    symbols: ")
  run appendSymbols(&mut text, shared())
  run Bytes.append(&mut text, b"  - targets: [ arm64-macos ]\n    symbols: ")
  run appendSymbols(&mut text, appleSilicon())
  run Bytes.append(&mut text, b"  - targets: [ x86_64-macos ]\n    symbols: ")
  run appendSymbols(&mut text, intel())
  run Bytes.append(&mut text, b"...\n")
  return move text
}

/// Writes the stub to `libSystem.tbd` in the link's private `scratch` directory and links against
/// it alone: no implicit libraries, startup files or SDK search paths.
pub effect fn prepare(process: &mut ProcessRequest, scratch: &Path) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let stub = run Path.join(scratch, "libSystem.tbd")
  let text = run libSystem()
  run FileSystem.writeFile(&stub, Bytes.asSlice(&text))
  run ChildProcess.addArgument(&mut process.*, "-nostdlib")
  run ChildProcess.addArgument(&mut process.*, "-L")
  run NativeToolchain.addPathArgument(&mut process.*, scratch)
  run ChildProcess.addArgument(&mut process.*, "-lSystem")
}
