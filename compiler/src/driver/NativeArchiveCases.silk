// Python zipfile's archive of one member named `top/../../escape`.
fn escapingZip() -> &'static [u8] { return b"\x50\x4b\x03\x04\x14\x00\x00\x00\x00\x00\x1c\x6b\x68\x5d\x83\x16\xdc\x8c\x01\x00\x00\x00\x01\x00\x00\x00\x10\x00\x00\x00\x74\x6f\x70\x2f\x2e\x2e\x2f\x2e\x2e\x2f\x65\x73\x63\x61\x70\x65\x78\x50\x4b\x01\x02\x14\x03\x14\x00\x00\x00\x00\x00\x1c\x6b\x68\x5d\x83\x16\xdc\x8c\x01\x00\x00\x00\x01\x00\x00\x00\x10\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x80\x01\x00\x00\x00\x00\x74\x6f\x70\x2f\x2e\x2e\x2f\x2e\x2e\x2f\x65\x73\x63\x61\x70\x65\x50\x4b\x05\x06\x00\x00\x00\x00\x01\x00\x01\x00\x3e\x00\x00\x00\x2f\x00\x00\x00\x00\x00" }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn temporaryParent() -> &'static [u8] {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return b"/private/tmp" }
  else { return b"/tmp" }
}

effect fn ignoreCleanup(error: FileError | OutOfMemoryError) -> () { return () }

// Whether `path` holds exactly `expected`.
effect fn holds(path: &Path, expected: &[u8]) -> bool ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  return match move run Effect.result(FileSystem.readFile(path)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success {value} => same(Bytes.asSlice(&value), expected)
    Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError _missing => false
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// Extracts `archive` with one segment stripped, and checks the tree it writes, without the link.
effect fn extractsTree(archive: &[u8]) -> bool ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let parent = run Path.fromBytes(temporaryParent())
  let root = run FileSystem.createTemporaryDirectory(&parent, b"silk-native-archive")
  let refused = run NativeArchives.extractArchive(archive, &root, usize.ONE)
  let header = run Path.join(&root, "include/sdk.h")
  let library = run Path.join(&root, "lib/libsdk.a")
  let link = run Path.join(&root, "current")
  let linked = match move run Effect.result(FileSystem.exists(&link)) {
    Result<bool, FileError>.Success {value} => value
    Result<bool, FileError>.Failure {..} => true
  }
  let headerWritten = run holds(&header, b"int sdk(void);\x0a")
  let libraryWritten = run holds(&library, b"archive")
  run Effect.catchAll(FileSystem.removeDirectoryRecursively(&root), ignoreCleanup)
  return Option<Bytes>.isNone(&refused) && headerWritten && libraryWritten && !linked
}

effect fn refusesEscape() -> bool ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let parent = run Path.fromBytes(temporaryParent())
  let root = run FileSystem.createTemporaryDirectory(&parent, b"silk-native-archive")
  let refused = run NativeArchives.extractArchive(escapingZip(), &root, usize.ZERO)
  run Effect.catchAll(FileSystem.removeDirectoryRecursively(&root), ignoreCleanup)
  return Option<Bytes>.isSome(&refused)
}

effect fn exercise() -> () ! FileError | OutOfMemoryError | AssertionError<'static> ? &mut FileSystem | &mut Allocator {
  run Testing.expect(run extractsTree(sdkZip()), "a ZIP archive extracts its files and directories and skips its links")
  run Testing.expect(run extractsTree(sdkTarGz()), "a gzip-compressed tar archive extracts its files and directories and skips its links")
  run Testing.expect(run refusesEscape(), "a ZIP member whose path leaves the archive refuses the archive")
}

test effect fn nativeArchivesExtractZipAndTar() -> () ! FileError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make("/") |> Effect.provideMut<Allocator>(&mut allocator)
  return run exercise() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
}
