//! Shared LLVM optimization policy for program defaults and defining-package overrides.

import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Adds code-generation flags and the corresponding ThinLTO backend options.
pub effect fn append(common: &mut List<Bytes>, backendOptions: &mut List<Bytes>, optimization: &[u8], wasm: bool, x86: bool) -> ()
! OutOfMemoryError ? &mut Allocator {
  if optimization == b"speed" {
    run List<Bytes>.append(&mut common.*, run Bytes.copy(b"-O2"))
    // Tail merging folds the identical tails of match arms into one shared block, so the
    // arms of an interpreter loop jump through common code and lose the branch history
    // that predicts their next dispatch. Keeping the tails apart cost silkjs 14% more code
    // and gave 12% fewer branch mispredicts and 1-2% fewer instructions.
    run List<Bytes>.append(&mut common.*, run Bytes.copy(b"-mllvm"))
    run List<Bytes>.append(&mut common.*, run Bytes.copy(b"-enable-tail-merge=false"))
    run List<Bytes>.append(&mut backendOptions.*, run Bytes.copy(b"-enable-tail-merge=false"))
    // Runtime unrolling turns every loop with an unknown trip count into a four-way body
    // plus a remainder loop. Loops that run a handful of times, such as filling a call
    // frame's few locals, then pay the remainder's setup on every entry: silkjs ran 2-2.5%
    // more instructions on its call-heavy benchmarks with it, and its numeric ones gained
    // nothing.
    run List<Bytes>.append(&mut common.*, run Bytes.copy(b"-mllvm"))
    run List<Bytes>.append(&mut common.*, run Bytes.copy(b"-unroll-runtime=false"))
    run List<Bytes>.append(&mut backendOptions.*, run Bytes.copy(b"-unroll-runtime=false"))
    // Trivial stdlib accessors carry `@inlineAlways` and splice in MIR, so Clang keeps its
    // default inline threshold without the +14% compile-time and +8% code-size overhead of 500.
    // The x86 cmov converter turns a loop's conditional moves back into branches when it guesses
    // they sit on the critical path. A `min` over unpredictable values then mispredicts about
    // half the time: short Damerau-Levenshtein ran 15-20% slower and sorting random u64 26%
    // slower with it. JSON parsing, the HTTP server and the compiler's own build time were
    // unchanged without it.
    if x86 {
      run List<Bytes>.append(&mut common.*, run Bytes.copy(b"-mllvm"))
      run List<Bytes>.append(&mut common.*, run Bytes.copy(b"-x86-cmov-converter=false"))
      run List<Bytes>.append(&mut backendOptions.*, run Bytes.copy(b"-x86-cmov-converter=false"))
    }
  } else if optimization == b"size" {
    // `size` optimizes as hard as Clang can for small code, such as a wasm module to download.
    run List<Bytes>.append(&mut common.*, run Bytes.copy(b"-Oz"))
  } else if wasm {
    // At -O0 LLVM's WebAssembly backend skips register stackifying and local coloring, so every
    // value goes through a local of its own: the lib-ui docs site had 2.97 MB of code. Generating
    // code at -O1 from the same unoptimized IR keeps every variable in the debug information and
    // writes 1.45 MB. No IR pass runs, not even the always-inliner, which at -O0 copied the
    // `alwaysinline` bodies unoptimized into their callers for no gain.
    run List<Bytes>.append(&mut common.*, run Bytes.copy(b"-O1"))
    run List<Bytes>.append(&mut common.*, run Bytes.copy(b"-Xclang"))
    run List<Bytes>.append(&mut common.*, run Bytes.copy(b"-disable-llvm-passes"))
  } else {
    run List<Bytes>.append(&mut common.*, run Bytes.copy(b"-O0"))
  }
}
