}
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { AtomicWriteError, FileError, FileSystem, Path }
import silk.text.string { String }
import silk.num.usize

effect fn fact(profile: &InitialProfile, key: &[u8]) -> String
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  return match move InitialProfile.text(profile, key) {
    Option<&[u8]>.Some { value } => run RequestText.copy(value)
    Option<&[u8]>.None => String.make()
  }
}

effect fn optionalFact(profile: &InitialProfile, key: &[u8]) -> Option<String>
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let value = run fact(profile, key)
  if value.view() == "" {
    return Option<String>.none()
  }
  return Option<String>.some(move value)
}

effect fn texts(values: &[Bytes]) -> List<String>
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut result = List<String>.make()
  let mut at = usize.ZERO
  while at < values.length {
    run result.append(run RequestText.copy(Bytes.asSlice(&values[at])))
    at = at + usize.ONE
  }
  return move result
}

effect fn selection(profile: &InitialProfile, kind: &[u8], name: &[u8]) -> String
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let selected = run fact(profile, kind)
  if selected.view() == "named" {
    return run fact(profile, name)
  }
  return move selected
}

/// Copies normalized program-wide source facts and backend settings.
pub effect fn profile(
  initial: &InitialProfile,
  maxMemory: Option<u64>,
  stackSize: Option<u64>,
) -> Profile
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut debug = false
  if let Option<bool>.Some { value } = move InitialProfile.flag(initial, b"debug") {
    debug = value
  }
  return Profile {
    target: run fact(initial, b"target"),
    cpu: run optionalFact(initial, b"cpu"),
    cpuFeatures: run texts(InitialProfile.members(initial, b"cpu-features")),
    deployment: run optionalFact(initial, b"deployment"),
    libc: run fact(initial, b"libc"),
    entry: run selection(initial, b"entry-kind", b"entry-name"),
    runtime: run selection(initial, b"runtime-kind", b"runtime-name"),
    link: run fact(initial, b"link"),
    codeModel: run fact(initial, b"code-model"),
    relocation: run fact(initial, b"relocation"),
    optimization: run fact(initial, b"optimization"),
    debug: debug,
    safety: run fact(initial, b"safety"),
    threading: run fact(initial, b"threading"),
    sanitizers: run texts(InitialProfile.members(initial, b"sanitizers")),
    unwind: run fact(initial, b"unwind"),
    backend: run fact(initial, b"backend"),
    codegenUnits: Option<u64>.some(InitialProfile.unitCount(initial)),
    maxMemory: move maxMemory,
    stackSize: move stackSize,
  }
}

effect fn module(id: &ModuleId) -> ModuleRef
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let package = run ModuleId.copyPackage(id)
  let path = run ModuleId.copyPath(id)
  return ModuleRef {
    package: run RequestText.copy(package.asSlice()),
    module: run RequestText.copy(path.asSlice()),
  }
}

effect fn selector(id: &ModuleId, name: &[u8]) -> Selector
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let selected = run module(id)
  return Selector {
    package: move selected.package,
    module: move selected.module,
    declaration: run RequestText.copy(name),
  }
}

effect fn binding(value: &Binding) -> Selector
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  return run selector(&value.module, Bytes.asSlice(&value.declaration))
}

effect fn composition(sources: &ModuleSources) -> Composition
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut runtime = Option<ModuleRef>.none()
  if let Option<&ModuleId>.Some { value } = move Sources.runtime(sources) {
    runtime = Option<ModuleRef>.some(run module(value))
  }
  let supported = Sources.support(sources)
  let hosted = Sources.supportHosted(sources)
  let mut support = List<Support>.make()
  let mut at = usize.ZERO
  while at < supported.length {
    run support.append(Support { module: run module(&supported[at]), hosted: hosted[at] })
    at = at + usize.ONE
  }
  let retained = run Sources.retention(sources)
  let roots = retained.asSlice()
  let mut retention = List<Selector>.make()
  at = usize.ZERO
  while at < roots.length {
    run retention.append(run selector(&roots[at].module, Bytes.asSlice(&roots[at].declaration)))
    at = at + usize.ONE
  }
  let mut storage = Option<Storage>.none()
  if let Option<&ExecutionStorage>.Some { value } = move Sources.executionStorage(sources) {
    storage = Option<Storage>.some(
      Storage {
        create: run binding(&value.create),
        acquire: run binding(&value.acquire),
        release: run binding(&value.release),
        destroy: run binding(&value.destroy),
      },
    )
  }
  return Composition {
    runtime: move runtime,
    support: move support,
    retention: move retention,
    storage: move storage,
  }
}

/// Captures loaded source packages, generated files, composition, and native inputs.
pub effect fn make(
  sources: &ModuleSources,
  source: &Path,
  output: &Path,
  generated: &Path,
  initial: &InitialProfile,
  maxMemory: Option<u64>,
  stackSize: Option<u64>,
  testing: bool,
  emit: string,
) -> Request
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let library = match move Sources.standardLibrary(sources) {
    Option<&Path>.Some { value } => run RequestText.copy(Path.rawBytes(value))
    Option<&Path>.None => {
      fail FileSystem.error(FileSystem.writeFileOperation(), FileSystem.invalidPath())
    }
  }
  let mut artifact = run fact(initial, b"artifact")
  if testing {
    artifact = run String.copy("test")
  }
  let name = run artifactLabel(output, initial, testing, emit)
  return Request {
    version: 1,
    name: move name,
    artifact: move artifact,
    root: run RequestText.copy(Path.rawBytes(source)),
    rootModule: run RequestText.copy((run ModuleId.copyPath(Sources.entry(sources))).asSlice()),
    output: run RequestText.copy(Path.rawBytes(output)),
    stdlib: move library,
    profile: run profile(initial, move maxMemory, move stackSize),
    packages: run Sources.requestPackages(sources, generated),
    composition: run composition(sources),
    native: run NativeInputs.toRequest(
      Sources.nativeLinkInputs(sources),
      Sources.functionOrder(sources),
    ),
    emit: run String.copy(emit),
    platform: Option<Platform>.none(),
    windows: Option<Windows>.none(),
    macos: Option<MacOS>.none(),
    wasm: Option<Wasm>.none(),
    header: Option<String>.none(),
    importLibrary: Option<String>.none(),
    runner: Option<Runner>.none(),
  }
}

/// Writes a typed request once its fields are fully resolved, without decoding it again.
pub effect fn write(request: &Request, path: &Path) -> ()
  ! InvalidSourceRoot | FileError | WriterError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let encoded = run Effect.result(encode(request))
  let bytes = match move encoded {
    Result<Bytes, SchemaError | WriterError | OutOfMemoryError>.Success { value } => move value
    Result<Bytes, SchemaError | WriterError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      SchemaError _invalid => {
        fail InvalidSourceRoot {}
      }
      WriterError failed => {
        fail move failed
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  if let Option<Path>.Some { value: parent } = move run Path.parent(path) {
    run FileSystem.createDirectoriesRecursively(&parent)
  }
  run publish(path, bytes.asSlice())
  return ()
}

effect fn encode(request: &Request) -> Bytes
  ! SchemaError | WriterError | OutOfMemoryError
  ? &mut Allocator {
  let mut counter = Counter { length: usize.ZERO }
  run SchemaToml.encode<Request>(request) |> Effect.provideMut<Writer>(&mut counter)
  let mut buffer = run Output.make(counter.length)
  run SchemaToml.encode<Request>(request) |> Effect.provideMut<Writer>(&mut buffer)
  return move buffer.bytes
}

/// Captures an explicitly supplied sysroot, linker, and compiler-support installations.
pub effect fn platform(request: &mut Request, supply: &SupplyRequest) -> ()
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  if let SupplyRequest.Explicit { root, linker, support, .. } = &supply.* {
    let mut installations = List<Installation>.make()
    let listed = support.asSlice()
    let mut at = usize.ZERO
    while at < listed.length {
      run installations.append(
        Installation {
          target: run RequestText.copy(listed[at].target.asSlice()),
          root: run RequestText.copy(Path.rawBytes(&listed[at].root)),
        },
      )
      at = at + usize.ONE
    }
    request.platform = Option<Platform>.some(
      Platform {
        sysroot: run RequestText.copy(Path.rawBytes(&root)),
        linker: run RequestText.copy(Path.rawBytes(&linker)),
        support: move installations,
      },
    )
  }
  return ()
}

/// Captures the WIT path and world selected for a component compilation.
pub effect fn wasm(request: &mut Request, world: &World) -> ()
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut wit = Option<String>.none()
  if let Option<Path>.Some { value } = &world.wit {
    wit = Option<String>.some(run RequestText.copy(Path.rawBytes(&value)))
  }
  request.wasm = Option<Wasm>.some(
    Wasm {
      importMemory: request.profile.threading.view() == "multi",
      sharedMemory: request.profile.threading.view() == "multi",
      exportTable: false,
      executionModel: run String.copy("command"),
      wit: move wit,
      world: Option<String>.some(run RequestText.copy(world.name.asSlice())),
    },
  )
  return ()
}

/// The logical artifact name, without the suffix assigned by the target and emission kind.
pub effect fn artifactLabel(
  output: &Path,
  initial: &InitialProfile,
  testing: bool,
  emit: string,
) -> String
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let name = match move Path.name(output) {
    Option<string>.Some { value } => value
    Option<string>.None => {
      fail FileSystem.error(FileSystem.writeFileOperation(), FileSystem.invalidPath())
    }
  }
  let mut artifact = run fact(initial, b"artifact")
  if testing {
    artifact = run String.copy("test")
  }
  let target = run fact(initial, b"target")
  let suffix = run Requests.artifactName("", artifact.view(), emit, target.view())
  if suffix.view() != "" && String.endsWith(name, suffix.view())
    && String.byteLength(name) > String.byteLength(suffix.view()) {
    return run String.copy(
      String.slice(name, 0, String.byteLength(name) - String.byteLength(suffix.view())),
    )
  }
  return run String.copy(name)
}

/// Publishes the complete editor request set only after every compilation resolved successfully.
effect fn writeSet(directory: &Path, files: List<String>, indexName: string) -> ()
  ! InvalidSourceRoot | FileError | WriterError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let index = RequestSet { version: 1, files: move files }
  let bytes = match move run Effect.result(Encoding.json<RequestSet>(&index)) {
    Result<Bytes, SchemaError | WriterError | OutOfMemoryError>.Success { value } => move value
    Result<Bytes, SchemaError | WriterError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      SchemaError _invalid => {
        fail InvalidSourceRoot {}
      }
      WriterError failure => {
        fail move failure
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let path = run Path.join(directory, indexName)
  return run publish(&path, bytes.asSlice())
}

effect fn publish(path: &Path, bytes: &[u8]) -> ()
  ! FileError
  ? &mut FileSystem {
  let written = run Effect.result(
    FileSystem.writeFileAtomic(path, bytes, FileSystem.replaceExisting(), FileSystem.buffered()),
  )
  if let Result<(), AtomicWriteError>.Failure { error } = move written {
    fail move error.cause
  }
  return ()
}

/// One directory's complete set of requests across selected workspace packages.
pub struct Set {
  pub directory: Path,
  pub files: List<String>,
}

/// Adds a package's requests, rejecting artifact names shared by different packages.
pub effect fn extend(sets: &mut List<Set>, directory: &Path, files: List<String>) -> ()
  ! InvalidSourceRoot | FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut incoming = move files
  let mut at: usize = 0
  while at < sets.length() {
    let found = &mut sets.asMutSlice()[at]
    if samePath(&found.directory, directory) {
      while incoming.length() > 0 {
        let name = incoming.remove(0)
        let listed = found.files.asSlice()
        let mut previous: usize = 0
        while previous < listed.length {
          if listed[previous].view() == name.view() {
            fail InvalidSourceRoot {}
          }
          previous = previous + 1
        }
        run found.files.append(move name)
      }
      return ()
    }
    at = at + 1
  }
  run sets.append(
    Set { directory: run Path.fromBytes(Path.rawBytes(directory)), files: move incoming },
  )
  return ()
}

/// Reads a completed package plan before another package replaces its directory's index.
pub effect fn collect(sets: &mut List<Set>, directory: &Path, indexName: string) -> ()
  ! InvalidSourceRoot | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let path = run Path.join(directory, indexName)
  let bytes = run FileSystem.readFile(&path)
  let index = match move run Effect.result(SchemaJson.decode<RequestSet>(bytes.asSlice())) {
    Result<RequestSet, SchemaError | OutOfMemoryError>.Success { value } => move value
    Result<RequestSet, SchemaError | OutOfMemoryError>.Failure { error } => match move error {
      SchemaError _invalid => {
        fail InvalidSourceRoot {}
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  return run extend(&mut sets.*, directory, move index.files)
}

/// Atomically publishes each complete directory index after every selected package succeeds.
pub effect fn publishSets(sets: List<Set>, indexName: string) -> ()
  ! InvalidSourceRoot | FileError | WriterError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut remaining = move sets
  while remaining.length() > 0 {
    let selected = remaining.remove(0)
    run writeSet(&selected.directory, move selected.files, indexName)
  }
  return ()
}

fn samePath(left: &Path, right: &Path) -> bool {
  let a = Path.rawBytes(left)
  let b = Path.rawBytes(right)
  if a.length != b.length {
    return false
  }
  let mut at: usize = 0
  while at < a.length {
    if a[at] != b[at] {
      return false
    }
    at = at + 1
  }
  return true
}

/// A previous publication retained while all selected workspace plans are evaluated.
struct SavedFile {
  path: Path,
  contents: Bytes,
}

pub struct Snapshot {
  directory: Path,
  files: List<SavedFile>,
}

/// Captures a request directory once, including generated source files referred to by requests.
pub effect fn snapshot(snapshots: &mut List<Snapshot>, directory: &Path) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let listed = snapshots.asSlice()
  let mut at: usize = 0
  while at < listed.length {
    if samePath(&listed[at].directory, directory) {
      return ()
    }
    at = at + 1
  }
  let mut files = List<SavedFile>.make()
  if run FileSystem.exists(directory) {
    run saveFiles(directory, &mut files)
  }
  run snapshots.append(
    Snapshot { directory: run Path.fromBytes(Path.rawBytes(directory)), files: move files },
  )
}

effect fn saveFiles(directory: &Path, files: &mut List<SavedFile>) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let entries = run FileSystem.listDirectory(directory)
  let listed = entries.asSlice()
  let mut at: usize = 0
  while at < listed.length {
    let entry = &listed[at]
    if entry.kind.code == FileSystem.directory().code {
      run saveFiles(&entry.path, &mut files.*)
    } else if entry.kind.code == FileSystem.file().code {
      run files.append(
        SavedFile {
          path: run Path.fromBytes(Path.rawBytes(&entry.path)),
          contents: run FileSystem.readFile(&entry.path),
        },
      )
    }
    at = at + 1
  }
}

/// Restores the last complete request publication after a plan fails.
pub effect fn restore(snapshots: &[Snapshot]) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut at: usize = 0
  while at < snapshots.length {
    let snapshot = &snapshots[at]
    let mut current = List<SavedFile>.make()
    if run FileSystem.exists(&snapshot.directory) {
      run saveFiles(&snapshot.directory, &mut current)
    }
    let old = snapshot.files.asSlice()
    let changed = current.asSlice()
    let mut file: usize = 0
    while file < changed.length {
      let mut previous: usize = 0
      while previous < old.length && !samePath(&old[previous].path, &changed[file].path) {
        previous = previous + 1
      }
      if previous == old.length {
        run FileSystem.removeFile(&changed[file].path)
      }
      file = file + 1
    }
    file = 0
    while file < old.length {
      if let Option<Path>.Some { value: parent } = move run Path.parent(&old[file].path) {
        run FileSystem.createDirectoriesRecursively(&parent)
      }
      run publish(&old[file].path, old[file].contents.asSlice())
      file = file + 1
    }
    at = at + 1
  }
}
