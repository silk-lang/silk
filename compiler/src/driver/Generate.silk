//! The manifest's command hooks: the `[[generate]]` entries `silk generate` runs and the
//! `[[post-init]]` entries `silk init --template` runs.
//!
//! A `[[generate]]` entry names a command and the files it writes:
//!
//! ```toml
//! [[generate]]
//! run = ["scripts/generate-unicode", "--pinned"]
//! outputs = ["src/generated_tables.silk", "src/generated_*.silk"]
//! ```
//!
//! The command runs in the manifest's directory with the caller's environment. A program spelled
//! with a `/` is a path below the manifest's directory; a bare name is searched on `PATH`. Outputs are
//! paths below the manifest's directory; a `*` in the last segment matches any run of bytes. Builds
//! and dependents never run an entry: generated files are committed, and `silk generate --check`
//! fails when one is stale.
//!
//! While a command runs, its declared outputs that already exist are moved aside. An output it then
//! writes with the same bytes is replaced by the moved-aside original, so an unchanged rerun moves
//! no file's modification time and invalidates nothing. `--check` restores every original and
//! removes every new file, so it never changes the tree.
//!
//! A `[[post-init]]` entry of a template's manifest names only a command, `run`, spelled as a
//! `[[generate]]` entry's is. `silk init --template` runs the entries in order in the new project's
//! directory once it has copied the template, then removes them from the new manifest, so they run
//! once. Builds never run one.

import diagnostic.JsonText
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.box {Box}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.collections.slice {Slice}
import silk.text.string {String}
import silk.toml.value {Toml, TomlChild, Value as TomlValue}
import silk.num.usize

/// A `[[generate]]` or `[[post-init]]` entry the manifest refuses: the dotted key that locates it
/// and why.
pub struct InvalidHook {
  pub key: Bytes,
  pub detail: Bytes,
}

/// One `[[generate]]` entry: the command line and the outputs, both as written.
pub struct Entry {
  pub command: List<Bytes>,
  pub outputs: List<Bytes>,
}

/// One `[[post-init]]` entry: the command line as written, the program first.
pub struct PostInit {
  pub command: List<Bytes>,
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn holds(text: &[u8], wanted: u8) -> bool {
  let mut at = usize.ZERO
  while at < text.length {
    if text[at] == wanted { return true }
    at = at + usize.ONE
  }
  return false
}

fn lastSegment(path: &[u8]) -> &[u8] {
  let mut start = path.length
  while start > usize.ZERO && path[start - usize.ONE] != 47 { start = start - usize.ONE }
  return Slice.view<u8>(path, start, path.length - start)
}

// Refuses entry `at` of the array of tables `table`, at its `field` when that is not empty.
effect fn refuse(table: &[u8], at: usize, field: &[u8], detail: &[u8]) -> never ! InvalidHook | OutOfMemoryError ? &mut Allocator {
  let mut key = run Bytes.copy(table)
  run Bytes.append(&mut key, b".")
  run JsonText.appendDecimal(&mut key, at)
  if field.length > usize.ZERO {
    run Bytes.append(&mut key, b".")
    run Bytes.append(&mut key, field)
  }
  let mut text = run Bytes.copy(b"[[")
  run Bytes.append(&mut text, table)
  run Bytes.append(&mut text, b"]][")
  run JsonText.appendDecimal(&mut text, at)
  run Bytes.append(&mut text, b"]: ")
  run Bytes.append(&mut text, detail)
  fail InvalidHook {key: move key, detail: move text}
}

// The first key of `table` that `allowed` does not list.
fn unknownKey<'a>(table: &'a TomlValue, allowed: &[&[u8]]) -> Option<&'a [u8]> {
  return match &table.* {
    TomlValue.Table {entries, kind: _} => {
      let boxed = Box<List<TomlChild>>.get(&entries)
      let children = List<TomlChild>.asSlice(&boxed[0])
      let mut at = usize.ZERO
      while at < children.length {
        if let TomlChild.Member {entry} = &children[at] {
          let key = String.ownedUtf8Bytes(&entry.key)
          let mut known = false
          let mut name = usize.ZERO
          while name < allowed.length {
            if same(key, allowed[name]) { known = true }
            name = name + usize.ONE
          }
          if !known { return Option<&'a [u8]>.some(key) }
        }
        at = at + usize.ONE
      }
      return Option<&'a [u8]>.none()
    }
    _ => Option<&'a [u8]>.none()
  }
}

// The strings of the array `value`, or none when it is not a nonempty array of strings.
effect fn strings(value: Option<&TomlValue>) -> Option<List<Bytes>> ! OutOfMemoryError ? &mut Allocator {
  let array = match move value {
    Option<&TomlValue>.Some {value: found} => found
    Option<&TomlValue>.None => { return Option<List<Bytes>>.none() }
  }
  let listed = match &array.* {
    TomlValue.Array {..} => true
    _ => false
  }
  if !listed { return Option<List<Bytes>>.none() }
  let mut found = List<Bytes>.make()
  let mut item = usize.ZERO
  while true {
    let named = match move Toml.item(array, item) {
      Option<&TomlValue>.Some {value: listedItem} => listedItem
      Option<&TomlValue>.None => { break }
    }
    match move Toml.asString(Option<&TomlValue>.some(named)) {
      Option<string>.Some {value: written} => { run List<Bytes>.append(&mut found, run Bytes.copy(String.utf8Bytes(written))) }
      Option<string>.None => { return Option<List<Bytes>>.none() }
    }
    item = item + usize.ONE
  }
  if List<Bytes>.length(&found) == usize.ZERO { return Option<List<Bytes>>.none() }
  return Option<List<Bytes>>.some(move found)
}

/// Whether `written` is a relative path below a directory: segments separated by `/`, none empty,
/// `.` or `..`, no `\` or NUL, no drive prefix, and a `*` only in the last segment when `pattern`.
pub fn containedPath(written: &[u8], pattern: bool) -> bool {
  if written.length == usize.ZERO || written[usize.ZERO] == 47 { return false }
  if written.length >= usize.add(0, 2) && written[usize.ONE] == 58 { return false }
  let mut start = usize.ZERO
  let mut at = usize.ZERO
  while at <= written.length {
    if at == written.length || written[at] == 47 {
      let segment = Slice.view<u8>(written, start, at - start)
      if segment.length == usize.ZERO || same(segment, b".") || same(segment, b"..") { return false }
      if holds(segment, 42) && (!pattern || at != written.length) { return false }
      start = at + usize.ONE
    } else if written[at] == 92 || written[at] == 0 {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// The entries of the array of tables `table` in `document`, each checked to be a table with no key
// beyond `allowed` and with a valid `run`; empty when the manifest has none.
effect fn hooks<'a>(document: &'a TomlValue, table: string, allowed: &[&[u8]], shape: &[u8]) -> List<&'a TomlValue> ! InvalidHook | OutOfMemoryError ? &mut Allocator {
  let name = String.utf8Bytes(table)
  let mut found = List<&TomlValue>.make()
  let declared = match move Toml.field(document, table) {
    Option<&TomlValue>.Some {value} => value
    Option<&TomlValue>.None => { return move found }
  }
  let listed = match &declared.* {
    TomlValue.Array {..} => true
    _ => false
  }
  if !listed {
    let mut detail = run Bytes.copy(name)
    run Bytes.append(&mut detail, b" must be an array of tables, written as [[")
    run Bytes.append(&mut detail, name)
    run Bytes.append(&mut detail, b"]]")
    fail InvalidHook {key: run Bytes.copy(name), detail: move detail}
  }
  let mut at = usize.ZERO
  while true {
    let entry = match move Toml.item(declared, at) {
      Option<&TomlValue>.Some {value} => value
      Option<&TomlValue>.None => { break }
    }
    let isTable = match &entry.* {
      TomlValue.Table {..} => true
      _ => false
    }
    if !isTable {
      let mut detail = run Bytes.copy(b"an entry must be a table with ")
      run Bytes.append(&mut detail, shape)
      run refuse(name, at, b"", Bytes.asSlice(&detail))
    }
    if let Option<&[u8]>.Some {value: key} = unknownKey(entry, allowed) {
      let mut detail = run Bytes.copy(b"unknown key ")
      run Bytes.append(&mut detail, key)
      run Bytes.append(&mut detail, b"; an entry has only ")
      run Bytes.append(&mut detail, shape)
      run refuse(name, at, key, Bytes.asSlice(&detail))
    }
    run List<&TomlValue>.append(&mut found, entry)
    at = at + usize.ONE
  }
  return move found
}

// The `run` command line of entry `at` of `table`: a nonempty array of strings whose first is a
// bare program name or a contained relative path, and none holds NUL.
effect fn command(table: &[u8], at: usize, entry: &TomlValue) -> List<Bytes> ! InvalidHook | OutOfMemoryError ? &mut Allocator {
  let command = match move run strings(Toml.field(entry, "run")) {
    Option<List<Bytes>>.Some {value} => move value
    Option<List<Bytes>>.None => run refuse(table, at, b"run", b"run must be a nonempty array of strings: the program, then its arguments")
  }
  let words = List<Bytes>.asSlice(&command)
  let program = Bytes.asSlice(&words[usize.ZERO])
  if program.length == usize.ZERO || (holds(program, 47) && !containedPath(program, false)) {
    run refuse(table, at, b"run", b"the program must be a bare name searched on PATH or a relative path below the manifest's directory, without . or .. segments")
  }
  let mut word = usize.ZERO
  while word < words.length {
    if holds(Bytes.asSlice(&words[word]), 0) { run refuse(table, at, b"run", b"an argument must not contain NUL") }
    word = word + usize.ONE
  }
  return move command
}

/// The `[[generate]]` entries of the manifest `document`, in order; empty when it has none. An entry
/// is a table with exactly `run`, a nonempty array of strings that starts with the program, and
/// `outputs`, a nonempty array of contained paths.
pub effect fn entries(document: &TomlValue) -> List<Entry> ! InvalidHook | OutOfMemoryError ? &mut Allocator {
  let allowed: [&[u8]; 2] = [b"run", b"outputs"]
  let tables = run hooks(document, "generate", &allowed, b"run and outputs")
  let listed = List<&TomlValue>.asSlice(&tables)
  let mut found = List<Entry>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    let entry = listed[at]
    let command = run command(b"generate", at, entry)
    let outputs = match move run strings(Toml.field(entry, "outputs")) {
      Option<List<Bytes>>.Some {value} => move value
      Option<List<Bytes>>.None => run refuse(b"generate", at, b"outputs", b"outputs must be a nonempty array of paths")
    }
    let written = List<Bytes>.asSlice(&outputs)
    let mut output = usize.ZERO
    while output < written.length {
      if !containedPath(Bytes.asSlice(&written[output]), true) {
        let mut detail = run Bytes.copy(b"output \"")
        run Bytes.append(&mut detail, Bytes.asSlice(&written[output]))
        run Bytes.append(&mut detail, b"\" must be a relative path below the manifest's directory, without . or .. segments and with any * in its last segment")
        run refuse(b"generate", at, b"outputs", Bytes.asSlice(&detail))
      }
      output = output + usize.ONE
    }
    run List<Entry>.append(&mut found, Entry {command: move command, outputs: move outputs})
    at = at + usize.ONE
  }
  return move found
}

/// The `[[post-init]]` entries of the manifest `document`, in order; empty when it has none. An
/// entry is a table with exactly `run`, a nonempty array of strings that starts with the program: a
/// bare name searched on `PATH` or a relative path below the manifest's directory.
pub effect fn postInit(document: &TomlValue) -> List<PostInit> ! InvalidHook | OutOfMemoryError ? &mut Allocator {
  let allowed: [&[u8]; 1] = [b"run"]
  let tables = run hooks(document, "post-init", &allowed, b"run")
  let listed = List<&TomlValue>.asSlice(&tables)
  let mut found = List<PostInit>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    run List<PostInit>.append(&mut found, PostInit {command: run command(b"post-init", at, listed[at])})
    at = at + usize.ONE
  }
  return move found
}
