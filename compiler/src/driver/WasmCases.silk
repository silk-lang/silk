//! A debug wasm module names its functions as the source does, and Wasmtime's report of a trap
//! becomes the frames of a Silk trap report.

import driver.WasmNames as WasmNames {FunctionNames}
import driver.WasmTrace
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.testing.testing {AssertionError, Testing}
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

test effect fn renamesListedFunctionsAndKeepsOtherSections() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run renameClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn renameClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // A type section, a `name` section with a module name and the function names `silk_aa` and
  // `_start`, then a custom section `x`.
  let input: [u8; 49] = [0, 97, 115, 109, 1, 0, 0, 0, 1, 4, 1, 96, 0, 0, 0, 29, 4, 110, 97, 109, 101, 0, 2, 1, 109,
    1, 18, 2, 0, 7, 115, 105, 108, 107, 95, 97, 97, 1, 6, 95, 115, 116, 97, 114, 116, 0, 2, 1, 120]
  let expected: [u8; 51] = [0, 97, 115, 109, 1, 0, 0, 0, 1, 4, 1, 96, 0, 0, 0, 31, 4, 110, 97, 109, 101, 0, 2, 1, 109,
    1, 20, 2, 0, 9, 109, 97, 105, 110, 46, 112, 105, 99, 107, 1, 6, 95, 115, 116, 97, 114, 116, 0, 2, 1, 120]
  let mut names = FunctionNames.make()
  run FunctionNames.add(&mut names, b"silk_aa", b"main.pick")
  let renamed = run WasmNames.rename(&input, &names)
  match &renamed {
    Option<Bytes>.Some {value} => run Testing.expect(same(Bytes.asSlice(&value), &expected), "only the listed function is renamed")
    Option<Bytes>.None => run Testing.expect(false, "a well-formed module is renamed")
  }
  let truncated = run WasmNames.rename(&[0, 97, 115, 109, 1, 0, 0, 0, 0, 30, 4], &names)
  run Testing.expect(Option<Bytes>.isNone(&truncated), "a section past the end of the module is refused")
}

test effect fn wasmtimeTrapBecomesCallerFrames() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run traceClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn traceClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let error = b"Error: failed to run main module `trap.wasm`\n\nCaused by:\n    0: failed to invoke command default\n    1: error while executing at wasm backtrace:\n    0:   0x184d - trap!main.pick\n                    at /work/main.silk:2:52\n    1:   0x17cd - trap!main.outer\n                    at /work/main.silk:3:67\n                - main.main\n                    at /work/main.silk:5:31\n    2:   0x6482 - trap!silk/platform/wasi/start.invoke\n    3:    0x21e - trap!_start\n    2: wasm trap: wasm `unreachable` instruction executed\n"
  let read = run WasmTrace.frames(error, b"    ", b"/work")
  match &read {
    Option<WasmTrace.Trap>.Some {value} => {
      run Testing.expect(WasmTrace.reported(&value), "Silk's own trap executes unreachable after its report")
      let frames = b"      at main.outer (main.silk:3:67)\n      at main.main (main.silk:5:31)\n"
      run Testing.expect(same(Bytes.asSlice(&value.frames), frames), "callers follow the reported site, without the runtime's frames")
    }
    Option<WasmTrace.Trap>.None => run Testing.expect(false, "a trap's report is read")
  }
  let exhausted = b"    1: error while executing at wasm backtrace:\n    0: deep!main.down\n    1:   0x11a7 - deep!main.down\n    2:   0x11a7 - deep!main.down\n    2: wasm trap: call stack exhausted\n"
  let deep = run WasmTrace.frames(exhausted, b"", b"")
  match &deep {
    Option<WasmTrace.Trap>.Some {value} => {
      run Testing.expect(!WasmTrace.reported(&value), "a host trap has no report of its own")
      run Testing.expect(same(Bytes.asSlice(&value.frames), b"  at main.down\n"), "a host trap keeps its innermost frame, and repeats collapse")
    }
    Option<WasmTrace.Trap>.None => run Testing.expect(false, "a host trap is read")
  }
  let other = run WasmTrace.frames(b"Error: failed to read `missing.wasm`\n", b"", b"")
  run Testing.expect(Option<WasmTrace.Trap>.isNone(&other), "output without a trap is left alone")
}
