//! A debug wasm module names its functions as the source does, Wasmtime's report of a trap
//! becomes the frames of a Silk trap report, and the direct backend's code cache keeps what one
//! compiler translated.

import backend.WasmCode {Relocation, RelocationKind, Translated}
import driver.WasmCodeCache {CodeCache}
import driver.WasmNames as WasmNames {FunctionNames}
import driver.WasmTrace
import semantic.ContentHash {ContentHash}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.testing.testing {AssertionError, Testing}
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

test effect fn renamesListedFunctionsAndKeepsOtherSections() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run renameClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn renameClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // A type section, a `name` section with a module name and the function names `silk_aa` and
  // `_start`, then a custom section `x`.
  let input: [u8; 49] = [0, 97, 115, 109, 1, 0, 0, 0, 1, 4, 1, 96, 0, 0, 0, 29, 4, 110, 97, 109, 101, 0, 2, 1, 109,
    1, 18, 2, 0, 7, 115, 105, 108, 107, 95, 97, 97, 1, 6, 95, 115, 116, 97, 114, 116, 0, 2, 1, 120]
  let expected: [u8; 51] = [0, 97, 115, 109, 1, 0, 0, 0, 1, 4, 1, 96, 0, 0, 0, 31, 4, 110, 97, 109, 101, 0, 2, 1, 109,
    1, 20, 2, 0, 9, 109, 97, 105, 110, 46, 112, 105, 99, 107, 1, 6, 95, 115, 116, 97, 114, 116, 0, 2, 1, 120]
  let mut names = FunctionNames.make()
  run FunctionNames.add(&mut names, b"silk_aa", b"main.pick")
  let renamed = run WasmNames.rename(&input, &names)
  match &renamed {
    Option<Bytes>.Some {value} => run Testing.expect(same(Bytes.asSlice(&value), &expected), "only the listed function is renamed")
    Option<Bytes>.None => run Testing.expect(false, "a well-formed module is renamed")
  }
  let truncated = run WasmNames.rename(&[0, 97, 115, 109, 1, 0, 0, 0, 0, 30, 4], &names)
  run Testing.expect(Option<Bytes>.isNone(&truncated), "a section past the end of the module is refused")
  let stepped = run nameModule(b"silk_aa$step")
  match move run WasmNames.rename(Bytes.asSlice(&stepped), &names) {
    Option<Bytes>.Some {value} => {
      let expected = run nameModule(b"main.pick$step")
      run Testing.expect(same(Bytes.asSlice(&value), Bytes.asSlice(&expected)), "a step function keeps its suffix after the readable name")
    }
    Option<Bytes>.None => run Testing.expect(false, "a module naming a step function is renamed")
  }
}

// A module of only a `name` section naming function 0 `name`.
effect fn nameModule(name: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut functions = Bytes.make()
  run WasmNames.appendNumber(&mut functions, usize.ONE)
  run WasmNames.appendNumber(&mut functions, usize.ZERO)
  run WasmNames.appendNumber(&mut functions, name.length)
  run Bytes.append(&mut functions, name)
  let mut payload = Bytes.make()
  run WasmNames.appendNumber(&mut payload, 4)
  run Bytes.append(&mut payload, b"name")
  run WasmNames.appendPart(&mut payload, 1, Bytes.asSlice(&functions))
  let mut module = run Bytes.copy(b"\x00asm\x01\x00\x00\x00")
  run WasmNames.appendPart(&mut module, 0, Bytes.asSlice(&payload))
  return move module
}

test effect fn wasmtimeTrapBecomesCallerFrames() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run traceClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn traceClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let error = b"checking pick\nError: failed to run main module `trap.wasm`\n\nCaused by:\n    0: failed to invoke command default\n    1: error while executing at wasm backtrace:\n    0:   0x184d - trap!main.pick\n                    at /work/main.silk:2:52\n    1:   0x17cd - trap!main.outer\n                    at /work/main.silk:3:67\n                - main.main\n                    at /work/main.silk:5:31\n    2:   0x6482 - trap!silk/platform/wasi/start.invoke\n    3:    0x21e - trap!_start\n    2: wasm trap: wasm `unreachable` instruction executed\n"
  let read = run WasmTrace.frames(error, b"    fatal trap: index out of bounds\n", b"    ", b"/work")
  match &read {
    Option<WasmTrace.Trap>.Some {value} => {
      run Testing.expect(WasmTrace.reported(&value), "Silk's own trap executes unreachable after its report")
      let frames = b"      at main.outer (main.silk:3:67)\n      at main.main (main.silk:5:31)\n"
      run Testing.expect(same(Bytes.asSlice(&value.frames), frames), "callers follow the reported site, without the runtime's frames")
      run Testing.expect(same(Bytes.asSlice(&value.output), b"checking pick\n"), "the program's own output before the trace is kept")
    }
    Option<WasmTrace.Trap>.None => run Testing.expect(false, "a trap's report is read")
  }
  let exhausted = b"    1: error while executing at wasm backtrace:\n    0: deep!main.down\n    1:   0x11a7 - deep!main.down\n    2:   0x11a7 - deep!main.down\n    2: wasm trap: call stack exhausted\n"
  let deep = run WasmTrace.frames(exhausted, b"", b"", b"")
  match &deep {
    Option<WasmTrace.Trap>.Some {value} => {
      run Testing.expect(!WasmTrace.reported(&value), "a host trap has no report of its own")
      run Testing.expect(same(Bytes.asSlice(&value.frames), b"  at main.down\n"), "a host trap keeps its innermost frame, and repeats collapse")
    }
    Option<WasmTrace.Trap>.None => run Testing.expect(false, "a host trap is read")
  }
  let unreported = run WasmTrace.frames(error, b"", b"", b"/work")
  match &unreported {
    Option<WasmTrace.Trap>.Some {value} => {
      run Testing.expect(!WasmTrace.reported(&value), "an `unreachable` without a report of its own is the host's to report")
      run Testing.expect(same(Bytes.asSlice(&value.frames), b"  at main.pick (main.silk:2:52)\n  at main.outer (main.silk:3:67)\n  at main.main (main.silk:5:31)\n"),
        "an unreported trap keeps its innermost frame")
    }
    Option<WasmTrace.Trap>.None => run Testing.expect(false, "an unreported trap is read")
  }
  let apart = b"    1: error while executing at wasm backtrace:\n    0: x!main.walk\n    1: x!silk/collections/list.each\n    2: x!main.walk\n    2: wasm trap: call stack exhausted\n"
  let walked = run WasmTrace.frames(apart, b"", b"", b"")
  match &walked {
    Option<WasmTrace.Trap>.Some {value} => run Testing.expect(same(Bytes.asSlice(&value.frames), b"  at main.walk\n  at main.walk\n"), "repeats apart from each other stay")
    Option<WasmTrace.Trap>.None => run Testing.expect(false, "a trace with hidden frames is read")
  }
  let other = run WasmTrace.frames(b"Error: failed to read `missing.wasm`\n", b"", b"", b"")
  run Testing.expect(Option<WasmTrace.Trap>.isNone(&other), "output without a trap is left alone")
}

test effect fn codeCacheKeepsBodiesForItsCompilerOnly() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run cacheClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn cacheClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut relocations = List<Relocation>.make()
  run List<Relocation>.append(&mut relocations, Relocation {offset: 3, kind: RelocationKind.Call, target: usize.ZERO, addend: 0})
  run List<Relocation>.append(&mut relocations, Relocation {offset: 5, kind: RelocationKind.Address, target: usize.ONE, addend: 4294967292})
  let mut symbols = List<Bytes>.make()
  run List<Bytes>.append(&mut symbols, run Bytes.copy(b"callee"))
  run List<Bytes>.append(&mut symbols, run Bytes.copy(b"object"))
  let mut signatures = List<Bytes>.make()
  run List<Bytes>.append(&mut signatures, run Bytes.copy(&[96, 0, 0]))
  let body = Translated {symbol: run Bytes.copy(b"caller"), signature: usize.ZERO, entry: run Bytes.copy(&[0, 16, 26, 65, 26, 11]),
    relocations: move relocations, symbols: move symbols, signatures: move signatures, locations: List<u64>.make()}
  let hash = ContentHash.of(b"fragment")
  let mut cache = CodeCache.make()
  run CodeCache.start(&mut cache, hash)
  run CodeCache.append(&mut cache, move body)
  run CodeCache.start(&mut cache, ContentHash.of(b"declarations"))
  let encoded = run CodeCache.encode(&cache, b"compiler")
  let decoded = run CodeCache.decode(Bytes.asSlice(&encoded), b"compiler")
  run Testing.expect(decoded.fragments() == 2, "every fragment comes back, a fragment without bodies too")
  let found = decoded.find(hash)
  run Testing.expect(found != usize.MAX, "a fragment is found by its hash")
  if found != usize.MAX {
    let bodies = decoded.bodiesOf(found)
    run Testing.expect(bodies.length == usize.ONE && same(Bytes.asSlice(&bodies[0].symbol), b"caller"), "the fragment's body comes back")
    if bodies.length == usize.ONE {
      let kept = List<Relocation>.asSlice(&bodies[0].relocations)
      run Testing.expect(kept.length == 2 && kept[1].addend == 4294967292 && kept[1].target == usize.ONE, "its relocations come back")
    }
  }
  run Testing.expect(decoded.find(ContentHash.of(b"other")) == usize.MAX, "an unknown fragment is not found")
  let foreign = run CodeCache.decode(Bytes.asSlice(&encoded), b"another compiler")
  run Testing.expect(foreign.fragments() == usize.ZERO, "another compiler's cache is ignored")
  let cut = run CodeCache.decode(Slice.view<u8>(Bytes.asSlice(&encoded), usize.ZERO, Bytes.length(&encoded) - 3), b"compiler")
  run Testing.expect(cut.fragments() == usize.ZERO, "a truncated cache is ignored")
  // A relocation past its entry would write outside the body.
  let mut far = List<Relocation>.make()
  run List<Relocation>.append(&mut far, Relocation {offset: 50, kind: RelocationKind.Call, target: usize.ZERO, addend: 0})
  let mut callee = List<Bytes>.make()
  run List<Bytes>.append(&mut callee, run Bytes.copy(b"callee"))
  let mut unit = List<Bytes>.make()
  run List<Bytes>.append(&mut unit, run Bytes.copy(&[96, 0, 0]))
  let mut outside = CodeCache.make()
  run CodeCache.start(&mut outside, hash)
  run CodeCache.append(&mut outside, Translated {symbol: run Bytes.copy(b"caller"), signature: usize.ZERO, entry: run Bytes.copy(&[0, 16, 11]),
    relocations: move far, symbols: move callee, signatures: move unit, locations: List<u64>.make()})
  let corrupt = run CodeCache.decode(Bytes.asSlice(&run CodeCache.encode(&outside, b"compiler")), b"compiler")
  run Testing.expect(corrupt.fragments() == usize.ZERO, "a cache whose relocation leaves its entry is ignored")
}
