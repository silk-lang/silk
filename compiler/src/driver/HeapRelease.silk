//! Freed heap pages handed back to the system once a large structure is dropped.
//!
//! glibc keeps the pages of freed chunks, and the free chunks a dropped semantic store leaves
//! between longer-lived allocations are too fragmented for its own trimming to return. A
//! `--differential` replay of the compiler builds and drops one fresh store per step, so without
//! this its resident memory grew by about a gigabyte per step until the process was killed.
//! On other targets this does nothing.

static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" {
  unsafe extern "C" fn malloc_trim(pad: usize) -> i32

  /// Returns every whole free page of the heap to the system.
  pub fn release() -> () {
    let _released = unsafe malloc_trim(0)
    return ()
  }
} else {
  /// Does nothing on this target.
  pub fn release() -> () {
    return ()
  }
}
