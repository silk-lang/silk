//! Command-line path arguments resolved against the working directory, and commands found on
//! `PATH`.
//!
//! `PATH` entries and installed commands often are links, and a command is known by its real
//! path, so this boundary resolves them with POSIX `realpath` directly.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { DirectoryInfo, FileError, FileInfo, FileSystem, Path }
import silk.system.host_input { HostInput }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.text.string { InvalidUtf8 }
import silk.num.usize
import silk.collections.list { List }

unsafe extern "C" fn realpath(path: ?[*]const u8, resolved: ?[*]mut u8) -> ?[*]mut u8
with Intrinsic.foreign(noCapture: ("path", "resolved"))

// At least PATH_MAX on every supported host (4096 on Linux, 1024 on macOS), so `realpath` never
// writes past the buffer.
fn resolvedCapacity() -> usize {
  return usize.add(0, 4096)
}


fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn invalid() -> never ! FileError {
  fail FileSystem.error(FileSystem.pathOperation(), FileSystem.invalidPath())
}

/// Resolves one path argument lexically, as the TypeScript CLI does with `path.resolve`.
///
/// Absolute text resolves from the root and relative text from `working`; `.` and `..`
/// components are normalized without consulting the filesystem. Text that is not UTF-8, has an
/// empty interior component, or climbs above the root fails with the `InvalidPath` reason.
pub effect fn resolve(working: &Path, argument: &[u8]) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let absolute = argument.length > usize.ZERO && argument[usize.ZERO] == 47
  let mut relative = argument
  if absolute {
    relative = Slice.view<u8>(argument, usize.ONE, argument.length - usize.ONE)
  }
  let text = match move HostInput.text(relative) {
    Result<string, InvalidUtf8>.Success { value } => value
    Result<string, InvalidUtf8>.Failure { error: _ } => run invalid()
  }
  if absolute {
    let root = run Path.root()
    return run Path.resolve(&root, text)
  }
  return run Path.resolve(working, text)
}

// The components of the normalized absolute path `path`, as byte ranges `[start, end)`.
effect fn components(path: &[u8]) -> List<[usize; 2]> ! OutOfMemoryError ? &mut Allocator {
  let mut found = List<[usize; 2]>.make()
  let mut start = usize.ZERO
  let mut at = usize.ZERO
  while at <= path.length {
    if at == path.length || path[at] == 47 {
      if at > start {
        run List<[usize; 2]>.append(&mut found, [start, at])
      }
      start = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return move found
}

/// The path of `target` relative to the directory `base`, as the TypeScript CLI's `path.relative`
/// spells it: `/`-separated, with `..` for each component of `base` past their common prefix, and
/// empty when the two are the same path. Both paths are absolute and normalized.
pub effect fn relative(base: &Path, target: &Path) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let from = Path.rawBytes(base)
  let to = Path.rawBytes(target)
  let fromParts = run components(from)
  let toParts = run components(to)
  let left = List<[usize; 2]>.asSlice(&fromParts)
  let right = List<[usize; 2]>.asSlice(&toParts)
  let mut common = usize.ZERO
  while common < left.length && common < right.length
    && same(Slice.view<u8>(from, left[common][0], left[common][1] - left[common][0]),
      Slice.view<u8>(to, right[common][0], right[common][1] - right[common][0])) {
    common = common + usize.ONE
  }
  let mut spelled = Bytes.make()
  let mut at = common
  while at < left.length {
    if Bytes.length(&spelled) > usize.ZERO {
      run Bytes.append(&mut spelled, b"/")
    }
    run Bytes.append(&mut spelled, b"..")
    at = at + usize.ONE
  }
  at = common
  while at < right.length {
    if Bytes.length(&spelled) > usize.ZERO {
      run Bytes.append(&mut spelled, b"/")
    }
    run Bytes.append(&mut spelled, Slice.view<u8>(to, right[at][0], right[at][1] - right[at][0]))
    at = at + usize.ONE
  }
  return move spelled
}

/// Whether `value` contains the byte `wanted`.
pub fn contains(value: &[u8], wanted: u8) -> bool {
  let mut at = usize.ZERO
  while at < value.length {
    if value[at] == wanted {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

/// The paths a bare command `name` may name, in `PATH` order: each entry of the colon-separated
/// `searchPath` joined with `name`, where an empty entry is the working directory (`.`).
pub effect fn searchCandidates(searchPath: &[u8], name: &[u8]) -> List<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut candidates = List<Bytes>.make()
  let mut start = usize.ZERO
  let mut at = usize.ZERO
  while at <= searchPath.length {
    if at == searchPath.length || searchPath[at] == 58 {
      let mut candidate = Bytes.make()
      if at == start {
        run Bytes.append(&mut candidate, b".")
      } else {
        run Bytes.append(&mut candidate, Slice.view<u8>(searchPath, start, at - start))
      }
      run Bytes.append(&mut candidate, b"/")
      run Bytes.append(&mut candidate, name)
      run List<Bytes>.append(&mut candidates, move candidate)
      start = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return move candidates
}

fn isNull(answer: ?[*]mut u8) -> bool {
  unsafe {
    return Pointer.isNullMany<u8>(Intrinsic.pointerRequalify<?[*]mut u8, ?[*]const u8>(answer))
  }
}

/// The canonical path of `path` with every symbolic link resolved, or `None` when the host cannot
/// resolve it.
pub effect fn canonical(path: &[u8]) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  if contains(path, 0) {
    return Option<Bytes>.none()
  }
  let mut request = run Bytes.copy(path)
  let ending: [u8; 1] = [0]
  run Bytes.append(&mut request, &ending)
  let mut buffer = run Bytes.zeroed(resolvedCapacity())
  let answer = unsafe realpath(
    Pointer.fromSlice<u8>(Bytes.asSlice(&request)),
    Pointer.fromMutSlice<u8>(Bytes.asMutSlice(&mut buffer)),
  )
  if isNull(answer) {
    return Option<Bytes>.none()
  }
  let written = Bytes.asSlice(&buffer)
  let mut length = usize.ZERO
  while length < written.length && written[length] != 0 {
    length = length + usize.ONE
  }
  return Option<Bytes>.some(run Bytes.copy(Slice.view<u8>(written, usize.ZERO, length)))
}

/// The path `text` spells, or `None` when no path can spell it.
pub effect fn pathOf(text: &[u8]) -> Option<Path> ! OutOfMemoryError ? &mut Allocator {
  let parsed = run Effect.result(Path.fromBytes(text))
  return match move parsed {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => Option<Path>.some(move value)
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError invalid => {
        drop invalid
        return Option<Path>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

/// Whether `text` names an existing directory (`directory`) or regular file; any inspection
/// failure answers `false`.
pub effect fn exists(text: &[u8], directory: bool) -> bool ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let candidate = match move run pathOf(text) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return false
    }
  }
  let inspected = run Effect.result(FileSystem.stat(&candidate))
  return match move inspected {
    Result<FileInfo | DirectoryInfo, FileError>.Success { value } => match move value {
      FileInfo file => !directory
      DirectoryInfo found => directory
    }
    Result<FileInfo | DirectoryInfo, FileError>.Failure { error } => {
      drop error
      return false
    }
  }
}

/// The first `PATH` candidate for `name` that names a regular file, with its symbolic links
/// resolved; `searchPath` is the colon-separated `PATH` value.
pub effect fn search(searchPath: &[u8], name: &[u8]) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let candidates = run searchCandidates(searchPath, name)
  let listed = List<Bytes>.asSlice(&candidates)
  let mut at = usize.ZERO
  while at < listed.length {
    // A PATH entry is often a symbolic link; the command is known by its real path.
    if let Option<Bytes>.Some { value: resolved } = move run canonical(Bytes.asSlice(&listed[at])) {
      if run exists(Bytes.asSlice(&resolved), false) {
        return Option<Bytes>.some(move resolved)
      }
    }
    at = at + usize.ONE
  }
  return Option<Bytes>.none()
}
