//! Running the tasks program for a `[tasks]` hook, as a child that shares the compiler's terminal.
//!
//! A hook's task inherits standard input, output and error and the compiler's environment, so the
//! variables the compiler sets before it starts are the task's too, and it runs in the package
//! directory. Unix spawns the program and waits for it; Windows starts it with inherited standard
//! handles and waits. WASI has no processes, so a WASI build runs no task.

import driver.GenerateRun
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.system.child_process { ChildProcess }
import silk.system.host_input { HostInput, HostInputError }
import silk.system.filesystem { Path }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.num.u32
static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.process_image as WindowsProcessImage
} else static if Intrinsic.targetOperatingSystem() != "wasi" {
  import silk.system.subprocess { ExitStatus, ExitWatch, SpawnOptions, Stdio, Subprocess, SubprocessError }
}

/// Runs `program` with `arguments` in `directory` and waits for it. Returns its exit status, 128
/// plus the signal's number when a signal ended it, or none when it could not be started.
pub effect fn wait(program: &Path, arguments: &[Bytes], directory: &Path) -> Option<i32>
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return match move run WindowsProcessImage.execute(program, arguments, Option<&Path>.some(directory)) {
      Option<u32>.Some { value } => Option<i32>.some(u32.wrappingToI32(value))
      Option<u32>.None => Option<i32>.none()
    }
  } else {
  static if Intrinsic.targetOperatingSystem() == "wasi" {
    return Option<i32>.none()
  } else {
    let mut request = run ChildProcess.requestWithin(program, directory)
    let mut at: usize = 0
    while at < arguments.length {
      run ChildProcess.addArgumentBytes(&mut request, Bytes.asSlice(&arguments[at]))
      at = at + 1
    }
    run GenerateRun.inherit(&mut request)
    let mut options = SpawnOptions.make()
    run SpawnOptions.setStdio(&mut options, 0, Stdio.inherit(0))
    run SpawnOptions.setStdio(&mut options, 1, Stdio.inherit(1))
    run SpawnOptions.setStdio(&mut options, 2, Stdio.inherit(2))
    let started = run Effect.result(Subprocess.spawn(&request, &options))
    let child = match move started {
      Result<Subprocess, SubprocessError | OutOfMemoryError>.Success { value } => move value
      Result<Subprocess, SubprocessError | OutOfMemoryError>.Failure { error } => match move error {
        SubprocessError _refused => { return Option<i32>.none() }
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
    let ended = run Effect.result(collected(Subprocess.pid(&child)))
    drop child
    return match move ended {
      Result<ExitStatus, SubprocessError>.Success { value } => {
        if value.signaled { Option<i32>.some(128 + value.signal) } else { Option<i32>.some(value.code) }
      }
      Result<ExitStatus, SubprocessError>.Failure { error } => {
        drop error
        Option<i32>.none()
      }
    }
  }
  }
}

static if Intrinsic.targetOperatingSystem() != "windows" && Intrinsic.targetOperatingSystem() != "wasi" {
  // Waits for the child `pid` to end and collects its status.
  effect fn collected(pid: i32) -> ExitStatus ! SubprocessError {
    let watch = run ExitWatch.open(pid)
    return run ExitWatch.collect(&watch)
  }
}
