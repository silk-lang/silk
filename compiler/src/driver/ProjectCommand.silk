//! Project command lines, parsed from the arguments after the command name with `silk.cli`.
//!
//! Each command's `CommandLine` description below is its help text: `silk help <command>` and
//! `silk <command> --help` print it. The building commands (`build`, `check`, `hash`, `run`,
//! `debug` and `test`) share [`Options`]. `run` and `debug` pass every argument that is not one of
//! their options, and every argument after `--`, to the program in order. A manifest that only
//! defines a workspace selects every member by default.

import silk.build.options { Options as BuildOptions, Optimize }
import driver.ProjectInitializer { Kind }
import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.parse { Cli, CliError, Parsed, Variable }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.text.string { String }
import silk.text.format { ParseError }
import silk.num.usize
import silk.num.u64
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.io.writer { Writer, WriterError }

/// A project command line that names an unknown or repeated option or omits an option's value.
pub struct InvalidProjectCommand {
  /// Why the line is refused, such as ``unknown option `--relase`; did you mean `--release`?``.
  pub reason: Bytes,
}

/// The options with which a command records the compiler's own work as a trace. `main` reads
/// them with [`traceOptions`] before the command line is parsed, because the trace covers the
/// whole command; a command's parser admits and checks them.
pub struct TraceOptions {
  /// The file `--trace` names, as written. The compiler appends its trace to it.
  pub trace: Option<Bytes>,

  /// With `--trace-queries`, how many microseconds a semantic query run or a borrow check must
  /// take to be a span of its own; zero makes every one a span.
  pub traceQueries: Option<u64>,

  /// The W3C `traceparent` `--trace-parent` gives: the span of the program that started this
  /// command, under which the command's trace continues.
  pub traceParent: Option<Bytes>,
}

/// The options that select whether reusable caches are shared across the system or kept inside
/// each workspace's build directory.
pub struct CacheOptions {
  /// The cache mode `--cache-mode` selects: `shared` or `workspace`.
  pub cacheMode: Option<Bytes>,

  /// The shared cache directory `--cache-dir` selects, as written; implies `shared` mode.
  pub cacheDir: Option<Bytes>,
}

/// The options shared by the project commands that build.
pub struct Options {
  /// The manifest, as written; absent to discover the nearest one.
  pub manifestPath: Option<Bytes>,

  /// The same target, optimization, debug, and tool authorization options tasks embed.
  pub standard: BuildOptions,

  /// The code generator `--backend` selects for every planned profile: `llvm` or `direct`.
  pub backend: Option<Bytes>,

  /// The standard-library root, as written.
  pub standardLibrary: Option<Bytes>,

  /// The Clang executable `--clang` selects, as written; absent for `SILK_CLANG` or `PATH`.
  pub clang: Option<Bytes>,

  /// The workspace members `--package` selects by package name, as written and in order.
  pub packages: List<Bytes>,

  /// Whether `--workspace` selects every member of the enclosing workspace.
  pub workspace: bool,

  /// The progress display `--progress` selects: `auto`, `live`, `plain` or `never`.
  pub progress: Option<Bytes>,

  /// Whether `--quiet` keeps only the final line of the progress report.
  pub quiet: bool,

  /// Whether `--timings` lists each unit's slowest modules, bodies and functions.
  pub timings: bool,

  /// Whether `--ignore-warnings` lets the command succeed with warnings. Without it, a warning
  /// fails the command as an error does.
  pub ignoreWarnings: bool,

  /// Whether `--ignore-silk-version` builds packages whose `silk-version` this Silk cannot build,
  /// listing each one, instead of refusing them. Their code may not compile or work.
  pub ignoreSilkVersion: bool,

  /// Where and how the command keeps its build and semantic caches.
  pub cache: CacheOptions,

  /// Where and how the command traces the compiler.
  pub tracing: TraceOptions,
}

/// One parsed `build` command line.
pub struct Build {
  pub options: Options,

  /// Whether `--costs` lists the calls in each package whose generated functions cost the most:
  /// how many functions each one asked for, their LLVM text and the static evaluation steps
  /// that ran while they were lowered.
  pub costs: bool,
}

/// One parsed `check` command line.
pub struct Check {
  pub options: Options,

  /// Whether `--json` writes one JSON object per diagnostic instead of the human format.
  pub json: bool,

  /// Whether `--roots` also checks each root module and declaration through the language
  /// server's check roots and compares them with the whole-package check.
  pub roots: bool,

  /// With `--replay <script>`, the edit script replayed against a revisable store instead of
  /// reporting diagnostics.
  pub replay: Option<Bytes>,

  /// Whether `--differential` compares each replay step with a fresh one-shot store.
  pub differential: bool,

  /// Whether `--no-server` checks in this process alone: it asks no check server an earlier check
  /// left behind, and leaves none behind itself.
  pub noServer: bool,
}

/// One parsed `hash` command line.
pub struct Hash {
  pub options: Options,

  /// Whether `--list` writes the hashed listing of inputs instead of the hash.
  pub list: bool,

  /// Whether `--json` writes one JSON object naming each package, its hash and the artifacts its
  /// build writes.
  pub json: bool,

  /// The root module `--root <path>` names in place of the package entry, as `test --root` does.
  pub root: Option<Bytes>,

  /// Whether `--test` hashes what `silk test` builds: the host executable with the test runner.
  pub test: bool,
}

/// One parsed `run` or `debug` command line.
pub struct Run {
  pub options: Options,

  /// The program's own arguments, in order.
  pub arguments: List<Bytes>,

  /// With `run --coredump <path>`, where the WASI runtime writes a core dump after a trap.
  pub coredump: Option<Bytes>,

  /// For `debug`, the debugger connection: the port, or `address:port`, Wasmtime's debugger
  /// listens on for a WASI program, as `--port` wrote it or `1234`. Absent for `run`.
  pub debugger: Option<Bytes>,
}

/// One parsed `test` command line.
pub struct Test {
  pub options: Options,

  /// The discovery root, as written and relative to the project directory; absent for the entry.
  pub root: Option<Bytes>,

  /// The one source file whose tests run, as written and relative to the project directory.
  pub file: Option<Bytes>,

  /// The literal, ASCII case-insensitive test-name substring that selects tests.
  pub filter: Option<Bytes>,

  /// Each test's time limit in seconds, as decimal digits; absent for the default.
  pub timeout: Option<Bytes>,

  /// Whether `--no-cache` builds the test runner again instead of reusing an unchanged one, and runs
  /// the tests even when they passed with nothing changed.
  pub noCache: bool,
}

/// One parsed `pack` command line.
pub struct Pack {
  pub options: Options,

  /// Whether `--list` prints the files each archive would hold instead of writing it.
  pub list: bool,

  /// The directory `--output` names for the archives, as written; absent for `build/package`.
  pub output: Option<Bytes>,

  /// Whether `--json` writes one JSON object naming each archive, its SHA-256 and its files.
  pub json: bool,

  /// Whether `--bin` also builds the executable for each planned target and writes one binary
  /// archive per target.
  pub bin: bool,

  /// The minisign secret key file `--sign` names, as written; absent for `SILK_SIGNING_KEY` or no
  /// signatures.
  pub sign: Option<Bytes>,

  /// Where `--new-key` writes a new minisign secret key, as written; it writes the public key
  /// beside it and packs nothing.
  pub newKey: Option<Bytes>,

  /// The directory of release files `--verify` checks, as written; it packs nothing.
  pub verify: Option<Bytes>,

  /// The minisign public key file `--key` names for `--verify`, as written; absent for
  /// `minisign.pub` in the working directory.
  pub key: Option<Bytes>,
}

/// One parsed `clean` command line.
pub struct Clean {
  /// The manifest, as written; absent to discover the nearest one.
  pub manifestPath: Option<Bytes>,

  /// Whether `--cache` removes the shared system cache instead of the project build directory.
  pub allCache: bool,

  /// Where and how the command locates its cache.
  pub cache: CacheOptions,
}

/// One parsed `cache` command line (`silk cache path|info|prune|clean`).
pub struct Cache {
  /// The action to perform: `path`, `info`, `prune`, or `clean`.
  pub action: Bytes,

  /// Override the maximum size for `prune`, such as `10G` or `512M`.
  pub maxSize: Option<Bytes>,

  /// Override the maximum unused age in days for `prune`.
  pub maxAgeDays: Option<Bytes>,

  /// Where and how the command locates its cache.
  pub cache: CacheOptions,
}

/// One parsed `init` command line.
pub struct Init {
  /// The project directory, as written; absent for the working directory.
  pub path: Option<Bytes>,

  /// The package name, as written; absent to derive it from the directory.
  pub name: Option<Bytes>,

  /// An executable by default, a library with `--lib` or a workspace with `--workspace`.
  pub kind: Kind,

  /// The template given with `--template` or `-t`, as written; absent for a minimal project. With
  /// `list`, the template whose directory to list, absent for the official examples.
  pub template: Option<Bytes>,

  /// Whether `--list` or `-l` lists templates instead of creating a project.
  pub list: bool,

  /// The arguments after `--`, for the template's `[[post-init]]` entries that set `arguments = true`.
  pub arguments: List<Bytes>,

  /// Whether `--unsandboxed-post-init` lets the template's `[[post-init]]` entries run with the
  /// caller's full access on a host with no sandbox.
  pub unsandboxed: bool,
}

/// One parsed `add` command line.
pub struct Add {
  /// The dependency's package directory, or the `https://` or `file:///` URL of its archive, as
  /// written.
  pub path: Bytes,

  /// The SHA-256 `--sha256` expects the archive at a URL to have, as written.
  pub sha256: Option<Bytes>,

  /// The dependency name, as written; absent to use the dependency's package name.
  pub name: Option<Bytes>,

  /// The manifest, as written; absent to discover the nearest one.
  pub manifestPath: Option<Bytes>,
}

/// One parsed `remove` command line.
pub struct Remove {
  /// The dependency name, as written.
  pub name: Bytes,

  /// The manifest, as written; absent to discover the nearest one.
  pub manifestPath: Option<Bytes>,
}

impl CommandLine for TraceOptions {
  static fn command() -> Command<TraceOptions> {
    return Command<TraceOptions>.make("", "")
      |> Command.option(
        "trace",
        Opt.about(
          "Append a trace of the compiler's own work to this file: OTLP JSON lines, or Perfetto packets for a .pftrace file",
        )
          |> Opt.check<Option<Bytes>>(nonempty),
      )
      |> Command.option(
        "traceQueries",
        Opt.about("With --trace, a span for each query run of at least this many microseconds"),
      )
      |> Command.option(
        "traceParent",
        Opt.about("With --trace, the W3C traceparent of the span the trace continues")
          |> Opt.check<Option<Bytes>>(nonempty),
      )
  }
}

impl CommandLine for CacheOptions {
  static fn command() -> Command<CacheOptions> {
    return Command<CacheOptions>.make("", "")
      |> Command.option(
        "cacheMode",
        Opt.about("Where reusable caches live: shared (system-wide) or workspace (inside build/)")
          |> Opt.choice("shared")
          |> Opt.choice("workspace"),
      )
      |> Command.option(
        "cacheDir",
        Opt.about("The shared cache directory; implies --cache-mode shared")
          |> Opt.check<Option<Bytes>>(nonempty),
      )
  }
}

impl CommandLine for Options {
  static fn command() -> Command<Options> {
    return Command<Options>.make("", "")
      |> Command.option("manifestPath", Opt.about("The manifest; without it, the nearest one"))
      |> Command.flatten("standard")
      |> Command.option(
        "backend",
        Opt.about("The code generator")
          |> Opt.choice("llvm")
          |> Opt.choice("direct"),
      )
      |> Command.option(
        "standardLibrary",
        Opt.about("The standard library directory") |> Opt.long("stdlib"),
      )
      |> Command.option(
        "clang",
        Opt.about("The Clang executable; without it, SILK_CLANG or the one on PATH")
          |> Opt.check<Option<Bytes>>(nonempty),
      )
      |> Command.option(
        "packages",
        Opt.about("A workspace member to select, by package name; repeatable")
          |> Opt.long("package")
          |> Opt.short("p"),
      )
      |> Command.option("workspace", Opt.about("Select every workspace member"))
      |> Command.option(
        "progress",
        Opt.about("How to report progress on standard error")
          |> Opt.choice("auto")
          |> Opt.choice("live")
          |> Opt.choice("plain")
          |> Opt.choice("never"),
      )
      |> Command.option(
        "quiet",
        Opt.about("Keep only the final line of the progress report") |> Opt.short("q"),
      )
      |> Command.option(
        "timings",
        Opt.about("List each unit's slowest modules, bodies and functions"),
      )
      |> Command.option("ignoreWarnings", Opt.about("Report warnings without failing the command"))
      |> Command.option(
        "ignoreSilkVersion",
        Opt.about("Build packages written for another Silk anyway; they may not work"),
      )
      |> Command.flatten("cache")
      |> Command.flatten("tracing")
  }
}

impl CommandLine for Build {
  static fn command() -> Command<Build> {
    return Command<Build>.make("silk build", "Build the package or the workspace members")
      |> Command.flatten("options")
      |> Command.option("costs", Opt.about("List the calls whose generated code costs the most"))
  }
}

impl CommandLine for Check {
  static fn command() -> Command<Check> {
    return Command<Check>.make("silk check", "Report errors without building")
      |> Command.flatten("options")
      |> Command.option("json", Opt.about("Write one JSON object per diagnostic"))
      |> Command.option(
        "roots",
        Opt.about("Also check each root module and declaration as the language server does"),
      )
      |> Command.option("replay", Opt.about("Replay an edit script against a revisable store"))
      |> Command.option("differential", Opt.about("Compare each replay step with a fresh store"))
      |> Command.option(
        "noServer",
        Opt.about("Check in this process, without asking or leaving a check server"),
      )
  }
}

impl CommandLine for Hash {
  static fn command() -> Command<Hash> {
    return Command<Hash>.make("silk hash", "Print a digest of everything a build reads")
      |> Command.flatten("options")
      |> Command.option("list", Opt.about("List the hashed inputs instead of the hash"))
      |> Command.option(
        "json",
        Opt.about("Write each package, its hash and the artifacts its build writes, as JSON"),
      )
      |> Command.option(
        "root",
        Opt.about("A root module in place of the package entry, as for silk test"),
      )
      |> Command.option("test", Opt.about("Hash what silk test builds"))
  }
}

impl CommandLine for Pack {
  static fn command() -> Command<Pack> {
    return Command<Pack>.make(
      "silk pack",
      "Check the package and write its release archives and checksums",
    )
      |> Command.flatten("options")
      |> Command.option(
        "list",
        Opt.about("List the files each archive would hold, and write nothing"),
      )
      |> Command.option(
        "output",
        Opt.about("The directory for everything pack writes; without it, build/package"),
      )
      |> Command.option(
        "json",
        Opt.about("Write each archive's path, SHA-256, files and binaries as JSON"),
      )
      |> Command.option(
        "bin",
        Opt.about(
          "Also build each target's executable and archive it, as a release build unless --optimization or --debug says otherwise",
        ),
      )
      |> Command.option(
        "sign",
        Opt.about(
          "Sign every file with this minisign secret key file; without it, the key in SILK_SIGNING_KEY",
        ),
      )
      |> Command.option(
        "newKey",
        Opt.about(
          "Write a new minisign secret key here and its public key as .pub, and pack nothing",
        ),
      )
      |> Command.option(
        "verify",
        Opt.about(
          "Check this directory of release files against SHA256SUMS and their signatures, and pack nothing",
        ),
      )
      |> Command.option(
        "key",
        Opt.about("The minisign public key file for --verify; without it, minisign.pub here"),
      )
  }
}

// One `run` command line.
struct RunLine {
  pub options: Options,
  pub coredump: Option<Bytes>,
  pub arguments: List<Bytes>,
}

impl CommandLine for RunLine {
  static fn command() -> Command<RunLine> {
    return Command<RunLine>.make("silk run", "Build the package and run it")
      |> Command.flatten("options")
      |> Command.option(
        "coredump",
        Opt.about("Where the WASI runtime writes a core dump after a trap"),
      )
      |> Command.arg("arguments", Opt.about("The program's arguments"))
  }
}

// One `dev` command line: as `run`, for its help.
struct DevLine {
  pub options: Options,
  pub arguments: List<Bytes>,
}

impl CommandLine for DevLine {
  static fn command() -> Command<DevLine> {
    return Command<DevLine>.make(
      "silk dev",
      "Build the package and run it, and run it again each time a file in its sources or its manifest changes, until it is stopped. A package whose tasks.silk has a Dev task runs that task instead",
    )
      |> Command.flatten("options")
      |> Command.arg("arguments", Opt.about("The program's arguments"))
  }
}

// The compiler's options of one `task` command line, the ones before the task's name. The task's
// name and arguments only name the rest of the line in the help; `parseTask` splits them off first.
struct TaskLine {
  pub options: Options,
  pub task: List<Bytes>,
}

impl CommandLine for TaskLine {
  static fn command() -> Command<TaskLine> {
    return Command<TaskLine>.make(
      "silk task",
      "Build the package's tasks.silk program and run it from the package directory with the arguments after these options, the task's name first. Without a name, or with --help before it, list the tasks and their options",
    )
      |> Command.flatten("options")
      |> Command.arg("task", Opt.about("The task's name, then its own options and arguments"))
  }
}

// One `debug` command line.
struct DebugLine {
  pub options: Options,
  pub port: Bytes,
  pub arguments: List<Bytes>,
}

impl CommandLine for DebugLine {
  static fn command() -> Command<DebugLine> {
    return Command<DebugLine>.make(
      "silk debug",
      "Build the package and run it under a debugger: LLDB, or for WASI, Wasmtime's debugger stub",
    )
      |> Command.flatten("options")
      |> Command.option(
        "port",
        Opt.about("Where Wasmtime's debugger listens: a port, or address:port")
          |> Opt.default("1234"),
      )
      |> Command.arg("arguments", Opt.about("The program's arguments"))
  }
}

impl CommandLine for Test {
  static fn command() -> Command<Test> {
    return Command<Test>.make("silk test", "Run the package's tests")
      |> Command.flatten("options")
      |> Command.option("root", Opt.about("The discovery root, relative to the project directory"))
      |> Command.option("file", Opt.about("The one source file whose tests run"))
      |> Command.option(
        "filter",
        Opt.about("Run the tests whose names contain this text, in any ASCII case"),
      )
      |> Command.option(
        "timeout",
        Opt.about("Each test's time limit in whole seconds, 60 by default; 0 removes it")
          |> Opt.check<Option<Bytes>>(seconds),
      )
      |> Command.option("noCache", Opt.about("Build and run again even when nothing changed"))
  }
}

impl CommandLine for Clean {
  static fn command() -> Command<Clean> {
    return Command<Clean>.make("silk clean", "Remove the build directory or the shared cache")
      |> Command.option("manifestPath", Opt.about("The manifest; without it, the nearest one"))
      |> Command.option(
        "allCache",
        Opt.about("Remove the shared system cache instead of the project build directory")
          |> Opt.long("cache"),
      )
      |> Command.flatten("cache")
  }
}

impl CommandLine for Cache {
  static fn command() -> Command<Cache> {
    return Command<Cache>.make("silk cache", "Inspect, prune, or clear Silk's shared cache")
      |> Command.arg(
        "action",
        Opt.about("What to do with the cache")
          |> Opt.choice("path")
          |> Opt.choice("info")
          |> Opt.choice("prune")
          |> Opt.choice("clean")
          |> Opt.required,
      )
      |> Command.option(
        "maxSize",
        Opt.about("With prune, target maximum cache size such as 10G or 512M")
          |> Opt.check<Option<Bytes>>(nonempty),
      )
      |> Command.option(
        "maxAgeDays",
        Opt.about("With prune, remove entries unused for at least this many days")
          |> Opt.check<Option<Bytes>>(nonempty),
      )
      |> Command.flatten("cache")
  }
}

// One `init` command line, before `--`.
struct InitLine {
  pub path: Option<Bytes>,
  pub name: Option<Bytes>,
  pub lib: bool,
  pub workspace: bool,
  pub template: Option<Bytes>,
  pub list: bool,
  pub unsandboxedPostInit: bool,
}

impl CommandLine for InitLine {
  static fn command() -> Command<InitLine> {
    return Command<InitLine>.make(
      "silk init",
      "Create a package or a workspace. Arguments after -- go to the template's [[post-init]] entries.",
    )
      |> Command.arg("path", Opt.about("The project directory; without it, the working directory"))
      |> Command.option(
        "name",
        Opt.about("The package name, or a workspace's starter member; without it, the directory's"),
      )
      |> Command.option("lib", Opt.about("Create a library"))
      |> Command.option("workspace", Opt.about("Create a workspace with one starter executable"))
      |> Command.option(
        "template",
        Opt.about("Create the project from a template") |> Opt.short("t"),
      )
      |> Command.option(
        "list",
        Opt.about("List the templates, of the template the path names or the official examples")
          |> Opt.short("l"),
      )
      |> Command.option(
        "unsandboxedPostInit",
        Opt.about("Let [[post-init]] entries run with full access on a host with no sandbox"),
      )
  }
}

impl CommandLine for Add {
  static fn command() -> Command<Add> {
    return Command<Add>.make(
      "silk add",
      "Add a dependency on a package directory or a package archive URL",
    )
      |> Command.arg(
        "path",
        Opt.about(
          "The dependency's package directory, or the https:// or file:/// URL of its archive",
        )
          |> Opt.required,
      )
      |> Command.option(
        "sha256",
        Opt.about("The SHA-256 the archive must have, in lowercase hexadecimal"),
      )
      |> Command.option("name", Opt.about("The dependency name; without it, its package name"))
      |> Command.option("manifestPath", Opt.about("The manifest; without it, the nearest one"))
  }
}

impl CommandLine for Remove {
  static fn command() -> Command<Remove> {
    return Command<Remove>.make("silk remove", "Remove a dependency")
      |> Command.arg("name", Opt.about("The dependency name") |> Opt.required)
      |> Command.option("manifestPath", Opt.about("The manifest; without it, the nearest one"))
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn isOption(argument: &[u8]) -> bool {
  return argument.length > usize.ONE && argument[usize.ZERO] == 45
}

fn nonempty(value: &Option<Bytes>) -> bool {
  return match &value.* {
    Option<Bytes>.Some { value: given } => Bytes.length(&given) > usize.ZERO
    Option<Bytes>.None => true
  }
}

fn seconds(value: &Option<Bytes>) -> bool {
  return match &value.* {
    Option<Bytes>.Some { value: given } => isSeconds(Bytes.asSlice(&given))
    Option<Bytes>.None => true
  }
}

effect fn invalid(first: &[u8], argument: &[u8], last: &[u8]) -> InvalidProjectCommand
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut reason = run Bytes.copy(first)
  run Bytes.append(&mut reason, argument)
  run Bytes.append(&mut reason, last)
  return InvalidProjectCommand { reason: move reason }
}

// `choices`, separated by commas, with the last comma replaced by `or`: `a, b or c`.
effect fn alternatives(choices: string<'static>, reason: &mut Bytes) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(choices)
  let mut last = bytes.length
  let mut at = usize.ZERO
  while at + usize.ONE < bytes.length {
    if bytes[at] == 44 && bytes[at + usize.ONE] == 32 {
      last = at
    }
    at = at + usize.ONE
  }
  if last == bytes.length {
    run Bytes.append(&mut reason, bytes)
    return ()
  }
  run Bytes.append(&mut reason, String.utf8Bytes(String.slice(choices, usize.ZERO, last)))
  run Bytes.append(&mut reason, b" or ")
  run Bytes.append(
    &mut reason,
    String.utf8Bytes(
      String.slice(choices, last + usize.add(0, 2), bytes.length - last - usize.add(0, 2)),
    ),
  )
}

// Why the command line was refused, in the words of `error`.
effect fn refusal(error: &CliError) -> InvalidProjectCommand
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &error.* {
    CliError.UnknownOption { token, suggestion } => {
      let mut reason = run Bytes.copy(b"unknown option `")
      run Bytes.append(&mut reason, String.utf8Bytes(String.view(&token)))
      run Bytes.append(&mut reason, b"`")
      if suggestion != "" {
        run Bytes.append(&mut reason, b"; did you mean `")
        run Bytes.append(&mut reason, String.utf8Bytes(suggestion))
        run Bytes.append(&mut reason, b"`?")
      }
      return InvalidProjectCommand { reason: move reason }
    }
    CliError.Repeated { option } => run invalid(
      b"`",
      String.utf8Bytes(option),
      b"` is given more than once",
    )
    CliError.MissingValue { option } => run invalid(
      b"`",
      String.utf8Bytes(option),
      b"` needs a value",
    )
    CliError.NotAChoice { option, token: _, choices } => {
      let mut reason = run Bytes.copy(b"`")
      run Bytes.append(&mut reason, String.utf8Bytes(option))
      run Bytes.append(&mut reason, b"` takes ")
      run alternatives(choices, &mut reason)
      return InvalidProjectCommand { reason: move reason }
    }
    CliError.InvalidValue { option, token } => {
      if option == "--clang" {
        return run invalid(b"`", b"--clang", b"` needs a path")
      }
      if option == "--timeout" {
        return run invalid(b"`", b"--timeout", b"` takes whole seconds: one to six digits")
      }
      let mut reason = run Bytes.copy(b"`")
      run Bytes.append(&mut reason, String.utf8Bytes(option))
      run Bytes.append(&mut reason, b"` does not take `")
      run Bytes.append(&mut reason, String.utf8Bytes(String.view(&token)))
      run Bytes.append(&mut reason, b"`")
      return InvalidProjectCommand { reason: move reason }
    }
    CliError.UnexpectedValue { option } => run invalid(
      b"`",
      String.utf8Bytes(option),
      b"` takes no value",
    )
    CliError.MissingRequired { option } => {
      if option == "<path>" {
        return run invalid(b"missing the directory of the package to add", b"", b"")
      }
      if option == "<name>" {
        return run invalid(b"missing the name of the dependency to remove", b"", b"")
      }
      return run invalid(b"missing `", String.utf8Bytes(option), b"`")
    }
    CliError.UnexpectedArgument { token } => run invalid(
      b"unexpected argument `",
      String.utf8Bytes(String.view(&token)),
      b"`",
    )
    CliError.MissingCommand { command } => run invalid(
      b"`",
      String.utf8Bytes(command),
      b"` needs a command",
    )
    CliError.UnknownCommand { command: _, token, suggestion } => {
      let mut reason = run Bytes.copy(b"unknown command `")
      run Bytes.append(&mut reason, String.utf8Bytes(String.view(&token)))
      run Bytes.append(&mut reason, b"`")
      if suggestion != "" {
        run Bytes.append(&mut reason, b"; did you mean `")
        run Bytes.append(&mut reason, String.utf8Bytes(suggestion))
        run Bytes.append(&mut reason, b"`?")
      }
      return InvalidProjectCommand { reason: move reason }
    }
  }
}

// Parses `arguments`, the arguments after the command name, into a `T`.
effect fn parsed<T: CommandLine>(arguments: &[Bytes]) -> T
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  // The parser skips the first argument, the program name.
  let mut line = List<Bytes>.make()
  run List<Bytes>.append(&mut line, Bytes.make())
  let mut at = usize.ZERO
  while at < arguments.length {
    run List<Bytes>.append(&mut line, run Bytes.copy(Bytes.asSlice(&arguments[at])))
    at = at + usize.ONE
  }
  let none: [Variable<'static>; 0] = []
  let result = run Cli.parseBytes<T>(List<Bytes>.asSlice(&line), &none)
  return match move result {
    Parsed<T>.Run { value } => move value
    Parsed<T>.Failed { error, .. } => {
      fail run refusal(&error)
    }

    // The caller answers `--help` before it parses, and no project command has `--version`.
    Parsed<T>.Help { .. } => {
      fail run invalid(b"`", b"--help", b"` stands alone")
    }
    Parsed<T>.Version => {
      fail run invalid(b"unknown option `", b"--version", b"`")
    }
  }
}

/// Whether `arguments`, the arguments after a command name, ask for its help: `--help`, `-h` or
/// `--help=json` before any `--`.
pub fn asksHelp(arguments: &[Bytes]) -> bool {
  let mut at = usize.ZERO
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    if same(argument, b"--") {
      return false
    }
    if same(argument, b"--help") || same(argument, b"-h") || same(argument, b"--help=json") {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

/// Whether `arguments`, the arguments after a command name, ask for its help as JSON:
/// `--help=json` before any `--`.
pub fn asksHelpJson(arguments: &[Bytes]) -> bool {
  let mut at = usize.ZERO
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    if same(argument, b"--") {
      return false
    }
    if same(argument, b"--help=json") {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

/// Whether `command`, such as `build`, names a project command, whose help [`writeHelp`] writes.
pub fn writesHelp(command: &[u8]) -> bool {
  if same(command, b"fetch") || same(command, b"package-path") || same(command, b"compile")
    || same(command, b"resolve")
    || same(command, b"graph")
    || same(command, b"request-schema")
    || same(command, b"manifest-schema") {
    return true
  }
  return same(command, b"build") || same(command, b"check") || same(command, b"hash")
    || same(command, b"run")
    || same(command, b"dev")
    || same(command, b"debug")
    || same(command, b"test")
    || same(command, b"init")
    || same(command, b"add")
    || same(command, b"remove")
    || same(command, b"clean")
    || same(command, b"cache")
    || same(command, b"pack")
    || same(command, b"dump")
    || same(command, b"plan")
    || same(command, b"lsp")
}

/// Writes the help text of the project command `command`, such as `build`, or with `json` its help
/// as one JSON object, of the project form only. Returns `false`, and writes nothing, when
/// `command` names no project command.
pub effect fn writeHelp(command: &[u8], json: bool) -> bool
  ! WriterError
  ? &mut Writer {
  if same(command, b"fetch") {
    run help<Fetch>(json)
    return true
  }
  if same(command, b"package-path") {
    run help<PackagePath>(json)
    return true
  }
  if same(command, b"resolve") {
    run help<Resolve>(json)
    return true
  }
  if same(command, b"graph") {
    run help<Graph>(json)
    return true
  }
  if same(command, b"plan") {
    run help<Plan>(json)
    return true
  } else if same(command, b"manifest-schema") {
    run help<ManifestSchema>(json)
    return true
  } else if same(command, b"request-schema") {
    run help<RequestSchema>(json)
    return true
  }
  if same(command, b"compile") {
    run help<Compile>(json)
    return true
  }
  if same(command, b"build") {
    run help<Build>(json)
    if !json {
      run Writer.writeAll(b"\n")
      run Cli.writeHelp<SourceBuild>("")
    }
  } else if same(command, b"check") {
    run help<Check>(json)
  } else if same(command, b"hash") {
    run help<Hash>(json)
  } else if same(command, b"run") {
    run help<RunLine>(json)
  } else if same(command, b"dev") {
    run help<DevLine>(json)
  } else if same(command, b"debug") {
    run help<DebugLine>(json)
  } else if same(command, b"test") {
    run help<Test>(json)
    if !json {
      run Writer.writeAll(b"\n")
      run Cli.writeHelp<SourceTest>("")
    }
  } else if same(command, b"init") {
    run help<InitLine>(json)
  } else if same(command, b"add") {
    run help<Add>(json)
  } else if same(command, b"remove") {
    run help<Remove>(json)
  } else if same(command, b"clean") {
    run help<Clean>(json)
  } else if same(command, b"cache") {
    run help<Cache>(json)
  } else if same(command, b"task") {
    run help<TaskLine>(json)
  } else if same(command, b"pack") {
    run help<Pack>(json)
  } else if same(command, b"dump") {
    run help<Dump>(json)
  } else if same(command, b"lsp") {
    run help<Lsp>(json)
  } else {
    return false
  }
  return true
}

// Writes the help of `T`, as JSON when `json` is set.
effect fn help<T: CommandLine>(json: bool) -> ()
  ! WriterError
  ? &mut Writer {
  if json {
    run Cli.writeHelpJson<T>("")
  } else {
    run Cli.writeHelp<T>("")
  }
}

pub fn options() -> Options {
  return Options {
    manifestPath: Option<Bytes>.none(),
    standard: BuildOptions.make(),
    backend: Option<Bytes>.none(),
    standardLibrary: Option<Bytes>.none(),
    clang: Option<Bytes>.none(),
    packages: List<Bytes>.make(),
    workspace: false,
    progress: Option<Bytes>.none(),
    quiet: false,
    timings: false,
    ignoreWarnings: false,
    ignoreSilkVersion: false,
    cache: unconfiguredCache(),
    tracing: untraced(),
  }
}

pub fn unconfiguredCache() -> CacheOptions {
  return CacheOptions { cacheMode: Option<Bytes>.none(), cacheDir: Option<Bytes>.none() }
}

fn untraced() -> TraceOptions {
  return TraceOptions {
    trace: Option<Bytes>.none(),
    traceQueries: Option<u64>.none(),
    traceParent: Option<Bytes>.none(),
  }
}

// The value of the option `name` when `arguments[at]` gives it: the next argument, or what
// follows `name=` in this one.
fn optionValue<'a>(arguments: &'a [Bytes], at: usize, limit: usize, name: &[u8]) -> Option<
  &'a [u8]
> {
  let word = Bytes.asSlice(&arguments[at])
  if same(word, name) {
    if at + usize.ONE < limit {
      return Option<&'a [u8]>.some(Bytes.asSlice(&arguments[at + usize.ONE]))
    }
    return Option<&'a [u8]>.none()
  }
  if word.length > name.length && word[name.length] == 61
    && same(Slice.view<u8>(word, usize.ZERO, name.length), name) {
    return Option<&'a [u8]>.some(
      Slice.view<u8>(word, name.length + usize.ONE, word.length - name.length - usize.ONE),
    )
  }
  return Option<&'a [u8]>.none()
}

/// The trace options among `arguments`, the ones after the command `command`, read before the
/// command line is parsed: none for a command that has none. Only the compiler's own arguments
/// count, those before a `--` and, for `task`, before the task's name. A value the command's
/// parser will refuse is left out here.
pub effect fn traceOptions(command: &[u8], arguments: &[Bytes]) -> TraceOptions
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut found = untraced()
  let mut limit = usize.ZERO
  if same(command, b"task") {
    limit = taskName(arguments)
  } else if same(command, b"build") || same(command, b"check") || same(command, b"test")
    || same(command, b"run")
    || same(command, b"debug")
    || same(command, b"hash") {
    while limit < arguments.length && !same(Bytes.asSlice(&arguments[limit]), b"--") {
      limit = limit + usize.ONE
    }
  }
  let mut at = usize.ZERO
  while at < limit {
    if let Option<&[u8]>.Some { value } = optionValue(arguments, at, limit, b"--trace") {
      if value.length > usize.ZERO {
        found.trace = Option<Bytes>.some(run Bytes.copy(value))
      }
    }
    if let Option<&[u8]>.Some { value } = optionValue(arguments, at, limit, b"--trace-queries") {
      if let Result<u64, ParseError>.Success { value: microseconds } = u64.parse(
        unsafe Intrinsic.stringFromUtf8Unchecked(value),
      ) {
        found.traceQueries = Option<u64>.some(microseconds)
      }
    }
    if let Option<&[u8]>.Some { value } = optionValue(arguments, at, limit, b"--trace-parent") {
      found.traceParent = Option<Bytes>.some(run Bytes.copy(value))
    }
    at = at + usize.ONE
  }
  return move found
}

/// Whether `value` names a progress display: `auto`, `live`, `plain` or `never`.
pub fn isProgressDisplay(value: &[u8]) -> bool {
  return same(value, b"auto") || same(value, b"live") || same(value, b"plain")
    || same(value, b"never")
}

/// Parses the arguments that follow `build`, which are all options.
pub effect fn parseBuild(arguments: &[Bytes]) -> Build
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  return run parsed<Build>(arguments)
}

/// Parses the arguments that follow `check`: the build options, `--json`, `--roots`,
/// `--replay <script>` and, with a replay, `--differential`.
pub effect fn parseCheck(arguments: &[Bytes]) -> Check
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let checked = run parsed<Check>(arguments)
  if checked.differential {
    if let Option<Bytes>.None = &checked.replay {
      fail run invalid(b"`", b"--differential", b"` needs `--replay <script>`")
    }
  }
  return move checked
}

/// Parses the arguments that follow `hash`: the build options, `--root <path>`, `--test`, and
/// `--list` or `--json`.
pub effect fn parseHash(arguments: &[Bytes]) -> Hash
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let hashed = run parsed<Hash>(arguments)
  if hashed.list && hashed.json {
    fail run invalid(b"`", b"--list", b"` and `--json` cannot be combined")
  }
  return move hashed
}

/// One `silk task` command line: the compiler's options, then the task program's arguments, its
/// task name first.
pub struct Task {
  pub options: Options,

  /// The task program's arguments, from the task's name on; empty to list the tasks.
  pub arguments: List<Bytes>,

  /// Whether `--help`, `-h` or `--help=json` came before the task's name: the compiler's options,
  /// then the tasks.
  pub help: bool,

  /// Whether that help is `--help=json`, one JSON object.
  pub json: bool,
}

/// Parses the arguments that follow `task`. The compiler's options come before the task's name and
/// every argument from the name on is the task program's, so a task's own `--help` reaches it. The
/// task program runs on this host; target and optimization options belong after the task name.
/// Workspace selection dispatches reserved commands independently for each selected package.
pub effect fn parseTask(arguments: &[Bytes]) -> Task
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let split = taskName(arguments)
  let mut own = List<Bytes>.make()
  let mut help = false
  let mut json = false
  let mut at = usize.ZERO
  while at < split {
    let word = Bytes.asSlice(&arguments[at])
    if same(word, b"--help") || same(word, b"-h") {
      help = true
    } else if same(word, b"--help=json") {
      help = true
      json = true
    } else {
      run List<Bytes>.append(&mut own, run Bytes.copy(word))
    }
    at = at + usize.ONE
  }
  let TaskLine { options, task } = move run parsed<TaskLine>(List<Bytes>.asSlice(&own))
  drop task
  if options.standard.target.length() > usize.ZERO {
    fail run invalid(
      b"`",
      b"--target",
      b"` cannot be used with `task`; a task runs on this machine",
    )
  }
  if options.standard.optimize != Optimize.None || options.standard.debug.isSome() {
    fail run invalid(b"`", b"--release", b"` and `--optimization` belong after the task name")
  }
  let mut rest = List<Bytes>.make()
  at = split

  // A `--` before the name only ends the compiler's options.
  if at < arguments.length && same(Bytes.asSlice(&arguments[at]), b"--") {
    at = at + usize.ONE
  }
  while at < arguments.length {
    run List<Bytes>.append(&mut rest, run Bytes.copy(Bytes.asSlice(&arguments[at])))
    at = at + usize.ONE
  }
  return Task { options: move options, arguments: move rest, help: help, json: json }
}

/// Where the task's name is in `arguments`, the arguments after `task`: the first one that is not
/// one of the compiler's options or an option's value, or a `--`; their length when there is none.
pub fn taskName(arguments: &[Bytes]) -> usize {
  let valued: [&[u8]; 12] = [
    b"--trace",
    b"--trace-queries",
    b"--trace-parent",
    b"--manifest-path",
    b"--target",
    b"--optimization",
    b"--backend",
    b"--stdlib",
    b"--clang",
    b"--package",
    b"-p",
    b"--progress",
  ]
  let mut at = usize.ZERO
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    if same(argument, b"--") || argument.length == usize.ZERO || argument[0] != 45 {
      return at
    }
    let mut takesValue = false
    let mut index = usize.ZERO
    while index < valued.length {
      if same(argument, valued[index]) {
        takesValue = true
      }
      index = index + usize.ONE
    }
    at = at + usize.ONE
    if takesValue {
      at = at + usize.ONE
    }
  }
  return arguments.length
}

/// Parses the arguments that follow `run`: the build options, `--coredump <path>` and the
/// program's arguments.
pub effect fn parseRun(arguments: &[Bytes]) -> Run
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let line = run parsed<RunLine>(arguments)
  return Run {
    options: move line.options,
    arguments: move line.arguments,
    coredump: move line.coredump,
    debugger: Option<Bytes>.none(),
  }
}

/// Parses the arguments that follow `debug`: the build options, `--port <[address:]port>` and the
/// program's arguments.
pub effect fn parseDebug(arguments: &[Bytes]) -> Run
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let line = run parsed<DebugLine>(arguments)
  return Run {
    options: move line.options,
    arguments: move line.arguments,
    coredump: Option<Bytes>.none(),
    debugger: Option<Bytes>.some(move line.port),
  }
}

/// Parses the arguments that follow `test`: the build options, `--root`, `--file`, `--filter`,
/// `--timeout` and `--no-cache`.
pub effect fn parseTest(arguments: &[Bytes]) -> Test
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  return run parsed<Test>(arguments)
}

/// Whether `value` is a test time limit: one to six decimal digits, a number of seconds.
pub fn isSeconds(value: &[u8]) -> bool {
  if value.length == usize.ZERO || value.length > 6 {
    return false
  }
  let mut at = usize.ZERO
  while at < value.length {
    if value[at] < 48 || value[at] > 57 {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// Parses the arguments that follow `init`: at most one directory, one `--name`, and one of
/// `--lib`, `--workspace` and `--template <template>` (or `-t <template>`). With `--workspace`,
/// `--name` names the starter member. `--list [template]` (or `-l`) stands alone, first. With a
/// template, the arguments after `--` go to its `[[post-init]]` entries.
pub effect fn parseInit(arguments: &[Bytes]) -> Init
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let mut before = arguments.length
  let mut at = usize.ZERO
  while at < arguments.length && before == arguments.length {
    if same(Bytes.asSlice(&arguments[at]), b"--") {
      before = at
    }
    at = at + usize.ONE
  }
  let mut passed = List<Bytes>.make()
  at = before + usize.ONE
  while at < arguments.length {
    run List<Bytes>.append(&mut passed, run Bytes.copy(Bytes.asSlice(&arguments[at])))
    at = at + usize.ONE
  }
  let line = run parsed<InitLine>(Slice.view<Bytes>(arguments, usize.ZERO, before))
  if line.list {
    let first = Bytes.asSlice(&arguments[usize.ZERO])
    let alone = arguments.length == usize.ONE
      || (arguments.length == usize.add(0, 2) && !isOption(Bytes.asSlice(&arguments[usize.ONE])))
    if !(same(first, b"--list") || same(first, b"-l")) || !alone {
      fail run invalid(
        b"",
        b"`--list`",
        b" takes only the template to list: `silk init --list [template]`",
      )
    }
    return Init {
      path: Option<Bytes>.none(),
      name: Option<Bytes>.none(),
      kind: Kind.Executable,
      template: move line.path,
      list: true,
      arguments: move passed,
      unsandboxed: false,
    }
  }
  let templated = Option<Bytes>.isSome(&line.template)
  if before < arguments.length && !templated {
    fail run invalid(
      b"arguments after ",
      b"`--`",
      b" go to a template's [[post-init]] entries, so they need `--template`",
    )
  }
  if templated && (line.lib || line.workspace) {
    fail run invalid(
      b"",
      b"`--template`",
      b" cannot be combined with `--lib` or `--workspace`: the template decides what it creates",
    )
  }
  if line.lib && line.workspace {
    fail run invalid(
      b"",
      b"`--lib` and `--workspace`",
      b" cannot be combined: choose a library package or a workspace",
    )
  }
  let mut kind = Kind.Executable
  if line.lib {
    kind = Kind.Library
  }
  if line.workspace {
    kind = Kind.Workspace
  }
  return Init {
    path: move line.path,
    name: move line.name,
    kind: kind,
    template: move line.template,
    list: false,
    arguments: move passed,
    unsandboxed: line.unsandboxedPostInit,
  }
}

/// Parses the arguments that follow `add`: one package directory or archive URL, at most one
/// `--name`, `--sha256` and `--manifest-path`.
pub effect fn parseAdd(arguments: &[Bytes]) -> Add
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  return run parsed<Add>(arguments)
}

/// Parses the arguments that follow `remove`: one dependency name and at most one
/// `--manifest-path`.
pub effect fn parseRemove(arguments: &[Bytes]) -> Remove
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  return run parsed<Remove>(arguments)
}

/// Parses the arguments that follow `pack`: the build options, `--list`, `--output <dir>` and
/// `--json`; `--list` and `--json` cannot be combined.
pub effect fn parsePack(arguments: &[Bytes]) -> Pack
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let packed = run parsed<Pack>(arguments)
  if packed.list && packed.json {
    fail run invalid(b"`", b"--list", b"` and `--json` cannot be combined")
  }
  if Option<Bytes>.isSome(&packed.key) && Option<Bytes>.isNone(&packed.verify) {
    fail run invalid(b"`", b"--key", b"` names the public key for `--verify`")
  }
  if Option<Bytes>.isSome(&packed.verify) {
    if packed.list || packed.json || packed.bin || Option<Bytes>.isSome(&packed.output)
      || Option<Bytes>.isSome(&packed.sign)
      || Option<Bytes>.isSome(&packed.newKey) {
      fail run invalid(b"`", b"--verify", b"` packs nothing, so it takes only `--key`")
    }
  }
  let mut chosen = move packed
  if chosen.bin && !optimizationSelected(arguments) {
    chosen.options.standard.optimize = Optimize.Speed
  }
  return move chosen
}

/// Parses the arguments that follow `clean`: `--manifest-path`, `--cache`, and cache options.
pub effect fn parseClean(arguments: &[Bytes]) -> Clean
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  return run parsed<Clean>(arguments)
}

/// Parses the arguments that follow `cache`: `path`, `info`, `prune`, or `clean`.
pub effect fn parseCache(arguments: &[Bytes]) -> Cache
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let parsedCache = run parsed<Cache>(arguments)
  let pruneOnly = Option<Bytes>.isSome(&parsedCache.maxSize)
    || Option<Bytes>.isSome(&parsedCache.maxAgeDays)
  if pruneOnly && !same(Bytes.asSlice(&parsedCache.action), b"prune") {
    fail run invalid(b"--max-size and --max-age-days apply only to `silk cache prune`", b"", b"")
  }
  return move parsedCache
}

/// One parsed single-file `build <source> -o <output>` command line.
pub struct SourceBuild {
  pub source: Bytes,
  pub output: Bytes,
  pub emit: Option<Bytes>,
  pub target: Option<Bytes>,
  pub clang: Option<Bytes>,
  pub standardLibrary: Option<Bytes>,
  pub optimization: Option<Bytes>,
  pub backend: Option<Bytes>,
  pub debug: Option<Bytes>,
  pub stats: bool,
  pub ignoreWarnings: bool,
  pub cache: CacheOptions,
  pub tracing: TraceOptions,
}

impl CommandLine for SourceBuild {
  static fn command() -> Command<SourceBuild> {
    return Command<SourceBuild>.make("silk build", "Build one source file")
      |> Command.arg("source", Opt.about("The source file") |> Opt.required)
      |> Command.option(
        "output",
        Opt.about("Where to write the artifact")
          |> Opt.short("o")
          |> Opt.required,
      )
      |> Command.option(
        "emit",
        Opt.about("The stage to write; without it, the final artifact")
          |> Opt.choice("final")
          |> Opt.choice("llvm-ir")
          |> Opt.choice("llvm-bitcode")
          |> Opt.choice("assembly")
          |> Opt.choice("object")
          |> Opt.choice("wasm-text"),
      )
      |> Command.option("target", Opt.about("The target triple; without it, the host"))
      |> Command.option(
        "clang",
        Opt.about("The Clang executable; without it, SILK_CLANG or the one on PATH")
          |> Opt.check<Option<Bytes>>(nonempty),
      )
      |> Command.option(
        "standardLibrary",
        Opt.about("The standard library directory") |> Opt.long("stdlib"),
      )
      |> Command.option("optimization", Opt.about("none, speed or size; speed by default"))
      |> Command.option(
        "backend",
        Opt.about("The code generator")
          |> Opt.choice("llvm")
          |> Opt.choice("direct"),
      )
      |> Command.option(
        "debug",
        Opt.about("Whether to write debug information")
          |> Opt.choice("true")
          |> Opt.choice("false"),
      )
      |> Command.option("stats", Opt.about("Write the build's counters to standard error"))
      |> Command.option("ignoreWarnings", Opt.about("Report warnings without failing the build"))
      |> Command.flatten("cache")
      |> Command.flatten("tracing")
  }
}

/// One parsed single-file `test <root> -o <executable>` command line.
pub struct SourceTest {
  pub root: Bytes,
  pub output: Bytes,
  pub standardLibrary: Option<Bytes>,
  pub filter: Option<Bytes>,
  pub file: Option<Bytes>,
  pub timeout: Option<Bytes>,
  pub optimization: Option<Bytes>,
  pub debug: Option<Bytes>,
  pub noCache: bool,
  pub ignoreWarnings: bool,
  pub cache: CacheOptions,
  pub tracing: TraceOptions,
}

impl CommandLine for SourceTest {
  static fn command() -> Command<SourceTest> {
    return Command<SourceTest>.make("silk test", "Run the tests below one root module")
      |> Command.arg("root", Opt.about("The discovery root") |> Opt.required)
      |> Command.option(
        "output",
        Opt.about("Where to write the test runner")
          |> Opt.short("o")
          |> Opt.required,
      )
      |> Command.option(
        "standardLibrary",
        Opt.about("The standard library directory") |> Opt.long("stdlib"),
      )
      |> Command.option(
        "filter",
        Opt.about("Run the tests whose names contain this text, in any ASCII case"),
      )
      |> Command.option("file", Opt.about("The one source file whose tests run"))
      |> Command.option(
        "timeout",
        Opt.about("Each test's time limit in whole seconds, 60 by default; 0 removes it")
          |> Opt.check<Option<Bytes>>(seconds),
      )
      |> Command.option("optimization", Opt.about("none, speed or size; speed by default"))
      |> Command.option(
        "debug",
        Opt.about("Whether to write debug information")
          |> Opt.choice("true")
          |> Opt.choice("false"),
      )
      |> Command.option("noCache", Opt.about("Build and run again even when nothing changed"))
      |> Command.option("ignoreWarnings", Opt.about("Report warnings without failing the tests"))
      |> Command.flatten("cache")
      |> Command.flatten("tracing")
  }
}

/// Parses the arguments that follow `build` in the single-file form: a source file and
/// `-o <output>`, then options.
pub effect fn parseSourceBuild(arguments: &[Bytes]) -> SourceBuild
