/// Whether arguments explicitly select an optimization mode, including --release.
pub fn optimizationSelected(arguments: &[Bytes]) -> bool {
  let mut at: usize = 0
  while at < arguments.length {
    let word = arguments[at].asSlice()
    if same(word, b"--") {
      return false
    }
    if same(word, b"--optimization") || same(word, b"--release") {
      return true
    }
    at = at + 1
  }
  return false
}

