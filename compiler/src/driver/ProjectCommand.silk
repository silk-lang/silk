//! Project command lines, parsed from the arguments after the command name.
//!
//! `build [options]` builds the project's targets. `run [options] [arguments...] [-- arguments...]`
//! builds its host executable and runs it: options are read until `--`, and any other argument
//! before it, and every argument after it, is passed to the program in order. The options are
//! `--manifest-path <path>` (no upward discovery), `--target <host|triple>` (repeatable),
//! `--release` and `--stdlib <directory>`.
//!
//! `init [path] [--name <name>]` creates a project in `path`, by default the working directory.
//!
//! `clean [--manifest-path <path>]` removes the project's build output directory.

import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.option { Option }
import silk.usize
import silk.vector { Vector }

/// A project command line that names an unknown or repeated option or omits an option's value.
pub struct InvalidProjectCommand {}

/// The options shared by the project commands that build.
pub struct Options {
  /// The manifest, as written; absent to discover the nearest one.
  pub manifestPath: Option<Bytes>

  /// The target selectors, as written and in order; empty for the command's default.
  pub targets: Vector<Bytes>

  /// Whether `--release` selects the optimized profile without debug information.
  pub release: bool

  /// The standard-library root, as written.
  pub standardLibrary: Option<Bytes>
}

/// One parsed `build` command line.
pub struct Build {
  pub options: Options
}

/// One parsed `run` command line.
pub struct Run {
  pub options: Options

  /// The program's own arguments, in order.
  pub arguments: Vector<Bytes>
}

/// One parsed `clean` command line.
pub struct Clean {
  /// The manifest, as written; absent to discover the nearest one.
  pub manifestPath: Option<Bytes>
}

/// One parsed `init` command line.
pub struct Init {
  /// The project directory, as written; absent for the working directory.
  pub path: Option<Bytes>

  /// The package name, as written; absent to derive it from the directory.
  pub name: Option<Bytes>
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn isOption(argument: &[u8]) -> bool {
  return argument.length > usize.ONE && argument[usize.ZERO] == 45
}

fn present(value: &Option<Bytes>) -> bool {
  return match &value.* {
    Option<Bytes>.Some { .. } => true
    Option<Bytes>.None => false
  }
}

fn options() -> Options {
  return Options {
    manifestPath: Option<Bytes>.none(),
    targets: Vector<Bytes>.make(),
    release: false,
    standardLibrary: Option<Bytes>.none(),
  }
}

// Reads the option at `arguments[at]` with its value, answering how many arguments it used: zero
// when it is not a valid project option here.
effect fn option(selected: &mut Options, arguments: &[Bytes], at: usize) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let argument = Bytes.asSlice(&arguments[at])
  let valued = at + usize.ONE < arguments.length
  if same(argument, b"--release") && !selected.release {
    selected.release = true
    return usize.ONE
  }
  if !valued {
    return usize.ZERO
  }
  let value = Bytes.asSlice(&arguments[at + usize.ONE])
  if same(argument, b"--manifest-path") && !present(&selected.manifestPath) {
    selected.manifestPath = Option<Bytes>.some(run Bytes.copy(value))
  } else if same(argument, b"--stdlib") && !present(&selected.standardLibrary) {
    selected.standardLibrary = Option<Bytes>.some(run Bytes.copy(value))
  } else if same(argument, b"--target") {
    run Vector<Bytes>.append(&mut selected.targets, run Bytes.copy(value))
  } else {
    return usize.ZERO
  }
  return usize.ONE + usize.ONE
}

/// Parses the arguments that follow `build`, which are all options.
pub effect fn parseBuild(arguments: &[Bytes]) -> Build
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let mut selected = options()
  let mut at = usize.ZERO
  while at < arguments.length {
    let used = run option(&mut selected, arguments, at)
    if used == usize.ZERO {
      fail InvalidProjectCommand {}
    }
    at = at + used
  }
  return Build { options: move selected }
}

/// Parses the arguments that follow `run`.
pub effect fn parseRun(arguments: &[Bytes]) -> Run
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let mut selected = options()
  let mut forwarded = Vector<Bytes>.make()
  let mut literal = false
  let mut at = usize.ZERO
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    if literal || !isOption(argument) {
      run Vector<Bytes>.append(&mut forwarded, run Bytes.copy(argument))
      at = at + usize.ONE
      continue
    }
    if same(argument, b"--") {
      literal = true
      at = at + usize.ONE
      continue
    }
    let used = run option(&mut selected, arguments, at)
    if used == usize.ZERO {
      fail InvalidProjectCommand {}
    }
    at = at + used
  }
  return Run { options: move selected, arguments: move forwarded }
}

/// Parses the arguments that follow `init`: at most one directory and one `--name`.
pub effect fn parseInit(arguments: &[Bytes]) -> Init
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let mut path = Option<Bytes>.none()
  let mut name = Option<Bytes>.none()
  let mut at = usize.ZERO
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    at = at + usize.ONE
    if
      !isOption(argument) && !present(&path) {
      path = Option<Bytes>.some(run Bytes.copy(argument))
      continue
    }
    if same(argument, b"--name") && !present(&name) && at < arguments.length {
      name = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&arguments[at])))
      at = at + usize.ONE
      continue
    }
    fail InvalidProjectCommand {}
  }
  return Init { path: move path, name: move name }
}

/// Parses the arguments that follow `clean`: at most one `--manifest-path`.
pub effect fn parseClean(arguments: &[Bytes]) -> Clean
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let mut manifestPath = Option<Bytes>.none()
  let mut at = usize.ZERO
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    if same(argument, b"--manifest-path") && !present(&manifestPath) && at + usize.ONE < arguments.length {
      manifestPath = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&arguments[at + usize.ONE])))
      at = at + usize.ONE + usize.ONE
      continue
    }
    fail InvalidProjectCommand {}
  }
  return Clean { manifestPath: move manifestPath }
}
