//! Project command lines, parsed from the arguments after the command name with `silk.cli`.
//!
//! Each command's `CommandLine` description below is its help text: `silk help <command>` and
//! `silk <command> --help` print it. The building commands (`build`, `check`, `hash`, `run`,
//! `debug` and `test`) share [`Options`]. `run` and `debug` pass every argument that is not one of
//! their options, and every argument after `--`, to the program in order. A manifest that only
//! defines a workspace selects every member by default.

import driver.ProjectInitializer { Kind }
import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.parse { Cli, CliError, Parsed, Variable }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.text.string { String }
import silk.num.usize
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.io.writer { Writer, WriterError }

/// A project command line that names an unknown or repeated option or omits an option's value.
pub struct InvalidProjectCommand {
  /// Why the line is refused, such as ``unknown option `--relase`; did you mean `--release`?``.
  pub reason: Bytes,
}

/// The options shared by the project commands that build.
pub struct Options {
  /// The manifest, as written; absent to discover the nearest one.
  pub manifestPath: Option<Bytes>,

  /// The target selectors, as written and in order; empty for the command's default.
  pub targets: List<Bytes>,

  /// Whether `--release` selects the optimized profile without debug information.
  pub release: bool,

  /// The named project profile `--profile` selects, as written.
  pub profile: Option<Bytes>,

  /// The complete logical profile `--profile-input` supplies as JSON, as written.
  pub profileInput: Option<Bytes>,

  /// The optimization profile `--optimization` selects: `debug`, `release` or `release-with-debug`.
  pub optimization: Option<Bytes>,

  /// The code generator `--backend` selects for every planned profile: `llvm` or `direct`.
  pub backend: Option<Bytes>,

  /// The standard-library root, as written.
  pub standardLibrary: Option<Bytes>,

  /// The Clang executable `--clang` selects, as written; absent for `SILK_CLANG` or `PATH`.
  pub clang: Option<Bytes>,

  /// The workspace members `--package` selects by package name, as written and in order.
  pub packages: List<Bytes>,

  /// Whether `--workspace` selects every member of the enclosing workspace.
  pub workspace: bool,

  /// The progress display `--progress` selects: `auto`, `live`, `plain` or `never`.
  pub progress: Option<Bytes>,

  /// Whether `--quiet` keeps only the final line of the progress report.
  pub quiet: bool,

  /// Whether `--timings` lists each unit's slowest modules, bodies and functions.
  pub timings: bool,
}

/// One parsed `build` command line.
pub struct Build {
  pub options: Options,
}

/// One parsed `check` command line.
pub struct Check {
  pub options: Options,

  /// Whether `--json` writes one JSON object per diagnostic instead of the human format.
  pub json: bool,

  /// Whether `--roots` also checks each root module and declaration through the language
  /// server's check roots and compares them with the whole-package check.
  pub roots: bool,

  /// With `--replay <script>`, the edit script replayed against a revisable store instead of
  /// reporting diagnostics.
  pub replay: Option<Bytes>,

  /// Whether `--differential` compares each replay step with a fresh one-shot store.
  pub differential: bool,
}

/// One parsed `hash` command line.
pub struct Hash {
  pub options: Options,

  /// Whether `--list` writes the hashed listing of inputs instead of the hash.
  pub list: bool,

  /// Whether `--json` writes one JSON object naming each package, its hash and the artifacts its
  /// build writes.
  pub json: bool,

  /// The root module `--root <path>` names in place of the package entry, as `test --root` does.
  pub root: Option<Bytes>,

  /// Whether `--test` hashes what `silk test` builds: the host executable with the test runner.
  pub test: bool,
}

/// One parsed `run` or `debug` command line.
pub struct Run {
  pub options: Options,

  /// The program's own arguments, in order.
  pub arguments: List<Bytes>,

  /// With `run --coredump <path>`, where the WASI runtime writes a core dump after a trap.
  pub coredump: Option<Bytes>,

  /// For `debug`, the debugger connection: the port, or `address:port`, Wasmtime's debugger
  /// listens on for a WASI program, as `--port` wrote it or `1234`. Absent for `run`.
  pub debugger: Option<Bytes>,
}

/// One parsed `test` command line.
pub struct Test {
  pub options: Options,

  /// The discovery root, as written and relative to the project directory; absent for the entry.
  pub root: Option<Bytes>,

  /// The one source file whose tests run, as written and relative to the project directory.
  pub file: Option<Bytes>,

  /// The literal, ASCII case-insensitive test-name substring that selects tests.
  pub filter: Option<Bytes>,

  /// Each test's time limit in seconds, as decimal digits; absent for the default.
  pub timeout: Option<Bytes>,

  /// Whether `--no-cache` builds the test runner again instead of reusing an unchanged one, and runs
  /// the tests even when they passed with nothing changed.
  pub noCache: bool,
}

/// One parsed `clean` command line.
pub struct Clean {
  /// The manifest, as written; absent to discover the nearest one.
  pub manifestPath: Option<Bytes>,
}

/// One parsed `generate` command line.
pub struct Generate {
  /// The manifest, as written; absent to discover the nearest one.
  pub manifestPath: Option<Bytes>,

  /// Whether `--check` reports stale outputs instead of writing them.
  pub check: bool,
}

/// One parsed `init` command line.
pub struct Init {
  /// The project directory, as written; absent for the working directory.
  pub path: Option<Bytes>,

  /// The package name, as written; absent to derive it from the directory.
  pub name: Option<Bytes>,

  /// An executable by default, a library with `--lib` or a workspace with `--workspace`.
  pub kind: Kind,

  /// The template given with `--template` or `-t`, as written; absent for a minimal project. With
  /// `list`, the template whose directory to list, absent for the official examples.
  pub template: Option<Bytes>,

  /// Whether `--list` or `-l` lists templates instead of creating a project.
  pub list: bool,

  /// The arguments after `--`, for the template's `[[post-init]]` entries that set `arguments = true`.
  pub arguments: List<Bytes>,

  /// Whether `--unsandboxed-post-init` lets the template's `[[post-init]]` entries run with the
  /// caller's full access on a host with no sandbox.
  pub unsandboxed: bool,
}

/// One parsed `add` command line.
pub struct Add {
  /// The dependency's package directory, as written.
  pub path: Bytes,

  /// The dependency name, as written; absent to use the dependency's package name.
  pub name: Option<Bytes>,

  /// The manifest, as written; absent to discover the nearest one.
  pub manifestPath: Option<Bytes>,
}

/// One parsed `remove` command line.
pub struct Remove {
  /// The dependency name, as written.
  pub name: Bytes,

  /// The manifest, as written; absent to discover the nearest one.
  pub manifestPath: Option<Bytes>,
}


impl CommandLine for Options {
  static fn command() -> Command<Options> {
    return Command<Options>.make("", "")
      |> Command.option("manifestPath", Opt.about("The manifest; without it, the nearest one"))
      |> Command.option("targets", Opt.about("A target, host or a triple; repeatable") |> Opt.long("target"))
      |> Command.option("release", Opt.about("Optimize without debug information"))
      |> Command.option("profile", Opt.about("A profile the project names"))
      |> Command.option("profileInput", Opt.about("A complete profile, as JSON"))
      |> Command.option(
        "optimization",
        Opt.about("The optimization profile")
          |> Opt.choice("debug")
          |> Opt.choice("release")
          |> Opt.choice("release-with-debug"),
      )
      |> Command.option("backend", Opt.about("The code generator") |> Opt.choice("llvm") |> Opt.choice("direct"))
      |> Command.option("standardLibrary", Opt.about("The standard library directory") |> Opt.long("stdlib"))
      |> Command.option(
        "clang",
        Opt.about("The Clang executable; without it, SILK_CLANG or the one on PATH") |> Opt.check<Option<Bytes>>(nonempty),
      )
      |> Command.option(
        "packages",
        Opt.about("A workspace member to select, by package name; repeatable")
          |> Opt.long("package")
          |> Opt.short("p"),
      )
      |> Command.option("workspace", Opt.about("Select every workspace member"))
      |> Command.option(
        "progress",
        Opt.about("How to report progress on standard error")
          |> Opt.choice("auto")
          |> Opt.choice("live")
          |> Opt.choice("plain")
          |> Opt.choice("never"),
      )
      |> Command.option("quiet", Opt.about("Keep only the final line of the progress report") |> Opt.short("q"))
      |> Command.option("timings", Opt.about("List each unit's slowest modules, bodies and functions"))
  }
}

impl CommandLine for Build {
  static fn command() -> Command<Build> {
    return Command<Build>.make("silk build", "Build the package or the workspace members")
      |> Command.flatten("options")
  }
}

impl CommandLine for Check {
  static fn command() -> Command<Check> {
    return Command<Check>.make("silk check", "Report errors without building")
      |> Command.flatten("options")
      |> Command.option("json", Opt.about("Write one JSON object per diagnostic"))
      |> Command.option("roots", Opt.about("Also check each root module and declaration as the language server does"))
      |> Command.option("replay", Opt.about("Replay an edit script against a revisable store"))
      |> Command.option("differential", Opt.about("Compare each replay step with a fresh store"))
  }
}

impl CommandLine for Hash {
  static fn command() -> Command<Hash> {
    return Command<Hash>.make("silk hash", "Print a digest of everything a build reads")
      |> Command.flatten("options")
      |> Command.option("list", Opt.about("List the hashed inputs instead of the hash"))
      |> Command.option("json", Opt.about("Write each package, its hash and the artifacts its build writes, as JSON"))
      |> Command.option("root", Opt.about("A root module in place of the package entry, as for silk test"))
      |> Command.option("test", Opt.about("Hash what silk test builds"))
  }
}

// One `run` command line.
struct RunLine {
  pub options: Options,
  pub coredump: Option<Bytes>,
  pub arguments: List<Bytes>,
}

impl CommandLine for RunLine {
  static fn command() -> Command<RunLine> {
    return Command<RunLine>.make("silk run", "Build the package and run it")
      |> Command.flatten("options")
      |> Command.option("coredump", Opt.about("Where the WASI runtime writes a core dump after a trap"))
      |> Command.arg("arguments", Opt.about("The program's arguments"))
  }
}

// One `debug` command line.
struct DebugLine {
  pub options: Options,
  pub port: Bytes,
  pub arguments: List<Bytes>,
}

impl CommandLine for DebugLine {
  static fn command() -> Command<DebugLine> {
    return Command<DebugLine>.make("silk debug", "Build the package and run it under a debugger: LLDB, or for WASI, Wasmtime's debugger stub")
      |> Command.flatten("options")
      |> Command.option("port", Opt.about("Where Wasmtime's debugger listens: a port, or address:port") |> Opt.default("1234"))
      |> Command.arg("arguments", Opt.about("The program's arguments"))
  }
}

impl CommandLine for Test {
  static fn command() -> Command<Test> {
    return Command<Test>.make("silk test", "Run the package's tests")
      |> Command.flatten("options")
      |> Command.option("root", Opt.about("The discovery root, relative to the project directory"))
      |> Command.option("file", Opt.about("The one source file whose tests run"))
      |> Command.option("filter", Opt.about("Run the tests whose names contain this text, in any ASCII case"))
      |> Command.option(
        "timeout",
        Opt.about("Each test's time limit in whole seconds, 60 by default; 0 removes it") |> Opt.check<Option<Bytes>>(seconds),
      )
      |> Command.option("noCache", Opt.about("Build and run again even when nothing changed"))
  }
}

impl CommandLine for Clean {
  static fn command() -> Command<Clean> {
    return Command<Clean>.make("silk clean", "Remove the build directory")
      |> Command.option("manifestPath", Opt.about("The manifest; without it, the nearest one"))
  }
}

impl CommandLine for Generate {
  static fn command() -> Command<Generate> {
    return Command<Generate>.make("silk generate", "Run the package's generators, or check their committed output")
      |> Command.option("manifestPath", Opt.about("The manifest; without it, the nearest one"))
      |> Command.option("check", Opt.about("Report stale outputs instead of writing them"))
  }
}

// One `init` command line, before `--`.
struct InitLine {
  pub path: Option<Bytes>,
  pub name: Option<Bytes>,
  pub lib: bool,
  pub workspace: bool,
  pub template: Option<Bytes>,
  pub list: bool,
  pub unsandboxedPostInit: bool,
}

impl CommandLine for InitLine {
  static fn command() -> Command<InitLine> {
    return Command<InitLine>.make(
      "silk init",
      "Create a package or a workspace. Arguments after -- go to the template's [[post-init]] entries.",
    )
      |> Command.arg("path", Opt.about("The project directory; without it, the working directory"))
      |> Command.option("name", Opt.about("The package name, or a workspace's starter member; without it, the directory's"))
      |> Command.option("lib", Opt.about("Create a library"))
      |> Command.option("workspace", Opt.about("Create a workspace with one starter executable"))
      |> Command.option("template", Opt.about("Create the project from a template") |> Opt.short("t"))
      |> Command.option("list", Opt.about("List the templates, of the template the path names or the official examples") |> Opt.short("l"))
      |> Command.option("unsandboxedPostInit", Opt.about("Let [[post-init]] entries run with full access on a host with no sandbox"))
  }
}

impl CommandLine for Add {
  static fn command() -> Command<Add> {
    return Command<Add>.make("silk add", "Add a path dependency")
      |> Command.arg("path", Opt.about("The dependency's package directory") |> Opt.required)
      |> Command.option("name", Opt.about("The dependency name; without it, its package name"))
      |> Command.option("manifestPath", Opt.about("The manifest; without it, the nearest one"))
  }
}

impl CommandLine for Remove {
  static fn command() -> Command<Remove> {
    return Command<Remove>.make("silk remove", "Remove a dependency")
      |> Command.arg("name", Opt.about("The dependency name") |> Opt.required)
      |> Command.option("manifestPath", Opt.about("The manifest; without it, the nearest one"))
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn isOption(argument: &[u8]) -> bool {
  return argument.length > usize.ONE && argument[usize.ZERO] == 45
}

fn nonempty(value: &Option<Bytes>) -> bool {
  return match &value.* {
    Option<Bytes>.Some { value: given } => Bytes.length(&given) > usize.ZERO
    Option<Bytes>.None => true
  }
}

fn seconds(value: &Option<Bytes>) -> bool {
  return match &value.* {
    Option<Bytes>.Some { value: given } => isSeconds(Bytes.asSlice(&given))
    Option<Bytes>.None => true
  }
}

effect fn invalid(first: &[u8], argument: &[u8], last: &[u8]) -> InvalidProjectCommand
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut reason = run Bytes.copy(first)
  run Bytes.append(&mut reason, argument)
  run Bytes.append(&mut reason, last)
  return InvalidProjectCommand { reason: move reason }
}

// `choices`, separated by commas, with the last comma replaced by `or`: `a, b or c`.
effect fn alternatives(choices: string<'static>, reason: &mut Bytes) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(choices)
  let mut last = bytes.length
  let mut at = usize.ZERO
  while at + usize.ONE < bytes.length {
    if bytes[at] == 44 && bytes[at + usize.ONE] == 32 { last = at }
    at = at + usize.ONE
  }
  if last == bytes.length {
    run Bytes.append(&mut reason, bytes)
    return ()
  }
  run Bytes.append(&mut reason, String.utf8Bytes(String.slice(choices, usize.ZERO, last)))
  run Bytes.append(&mut reason, b" or ")
  run Bytes.append(&mut reason, String.utf8Bytes(String.slice(choices, last + usize.add(0, 2), bytes.length - last - usize.add(0, 2))))
}

// Why the command line was refused, in the words of `error`.
effect fn refusal(error: &CliError) -> InvalidProjectCommand
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &error.* {
    CliError.UnknownOption { token, suggestion } => {
      let mut reason = run Bytes.copy(b"unknown option `")
      run Bytes.append(&mut reason, String.utf8Bytes(String.view(&token)))
      run Bytes.append(&mut reason, b"`")
      if suggestion != "" {
        run Bytes.append(&mut reason, b"; did you mean `")
        run Bytes.append(&mut reason, String.utf8Bytes(suggestion))
        run Bytes.append(&mut reason, b"`?")
      }
      return InvalidProjectCommand { reason: move reason }
    }
    CliError.Repeated { option } => run invalid(b"`", String.utf8Bytes(option), b"` is given more than once")
    CliError.MissingValue { option } => run invalid(b"`", String.utf8Bytes(option), b"` needs a value")
    CliError.NotAChoice { option, token: _, choices } => {
      let mut reason = run Bytes.copy(b"`")
      run Bytes.append(&mut reason, String.utf8Bytes(option))
      run Bytes.append(&mut reason, b"` takes ")
      run alternatives(choices, &mut reason)
      return InvalidProjectCommand { reason: move reason }
    }
    CliError.InvalidValue { option, token } => {
      if option == "--clang" { return run invalid(b"`", b"--clang", b"` needs a path") }
      if option == "--timeout" { return run invalid(b"`", b"--timeout", b"` takes whole seconds: one to six digits") }
      let mut reason = run Bytes.copy(b"`")
      run Bytes.append(&mut reason, String.utf8Bytes(option))
      run Bytes.append(&mut reason, b"` does not take `")
      run Bytes.append(&mut reason, String.utf8Bytes(String.view(&token)))
      run Bytes.append(&mut reason, b"`")
      return InvalidProjectCommand { reason: move reason }
    }
    CliError.UnexpectedValue { option } => run invalid(b"`", String.utf8Bytes(option), b"` takes no value")
    CliError.MissingRequired { option } => {
      if option == "<path>" { return run invalid(b"missing the directory of the package to add", b"", b"") }
      if option == "<name>" { return run invalid(b"missing the name of the dependency to remove", b"", b"") }
      return run invalid(b"missing `", String.utf8Bytes(option), b"`")
    }
    CliError.UnexpectedArgument { token } => run invalid(b"unexpected argument `", String.utf8Bytes(String.view(&token)), b"`")
    CliError.MissingCommand { command } => run invalid(b"`", String.utf8Bytes(command), b"` needs a command")
    CliError.UnknownCommand { command: _, token } => run invalid(b"unknown command `", String.utf8Bytes(String.view(&token)), b"`")
  }
}

// Parses `arguments`, the arguments after the command name, into a `T`.
effect fn parsed<T: CommandLine>(arguments: &[Bytes]) -> T
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  // The parser skips the first argument, the program name.
  let mut line = List<Bytes>.make()
  run List<Bytes>.append(&mut line, Bytes.make())
  let mut at = usize.ZERO
  while at < arguments.length {
    run List<Bytes>.append(&mut line, run Bytes.copy(Bytes.asSlice(&arguments[at])))
    at = at + usize.ONE
  }
  let none: [Variable<'static>; 0] = []
  let result = run Cli.parseBytes<T>(List<Bytes>.asSlice(&line), &none)
  return match move result {
    Parsed<T>.Run { value } => move value
    Parsed<T>.Failed { error } => {
      fail run refusal(&error)
    }
    // The caller answers `--help` before it parses, and no project command has `--version`.
    Parsed<T>.Help { command: _ } => {
      fail run invalid(b"`", b"--help", b"` stands alone")
    }
    Parsed<T>.Version => {
      fail run invalid(b"unknown option `", b"--version", b"`")
    }
  }
}

/// Whether `arguments`, the arguments after a command name, ask for its help: `--help` or `-h`
/// before any `--`.
pub fn asksHelp(arguments: &[Bytes]) -> bool {
  let mut at = usize.ZERO
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    if same(argument, b"--") { return false }
    if same(argument, b"--help") || same(argument, b"-h") { return true }
    at = at + usize.ONE
  }
  return false
}

/// Whether `command`, such as `build`, names a project command, whose help [`writeHelp`] writes.
pub fn writesHelp(command: &[u8]) -> bool {
  return same(command, b"build") || same(command, b"check") || same(command, b"hash") || same(command, b"run")
    || same(command, b"debug") || same(command, b"test") || same(command, b"init") || same(command, b"add")
    || same(command, b"remove") || same(command, b"clean") || same(command, b"generate")
}

/// Writes the help text of the project command `command`, such as `build`. Returns `false`, and
/// writes nothing, when `command` names no project command.
pub effect fn writeHelp(command: &[u8]) -> bool
  ! WriterError
  ? &mut Writer {
  if same(command, b"build") {
    run Cli.writeHelp<Build>("")
  } else if same(command, b"check") {
    run Cli.writeHelp<Check>("")
  } else if same(command, b"hash") {
    run Cli.writeHelp<Hash>("")
  } else if same(command, b"run") {
    run Cli.writeHelp<RunLine>("")
  } else if same(command, b"debug") {
    run Cli.writeHelp<DebugLine>("")
  } else if same(command, b"test") {
    run Cli.writeHelp<Test>("")
  } else if same(command, b"init") {
    run Cli.writeHelp<InitLine>("")
  } else if same(command, b"add") {
    run Cli.writeHelp<Add>("")
  } else if same(command, b"remove") {
    run Cli.writeHelp<Remove>("")
  } else if same(command, b"clean") {
    run Cli.writeHelp<Clean>("")
  } else if same(command, b"generate") {
    run Cli.writeHelp<Generate>("")
  } else {
    return false
  }
  return true
}

pub fn options() -> Options {
  return Options {
    manifestPath: Option<Bytes>.none(),
    targets: List<Bytes>.make(),
    release: false,
    profile: Option<Bytes>.none(),
    profileInput: Option<Bytes>.none(),
    optimization: Option<Bytes>.none(),
    backend: Option<Bytes>.none(),
    standardLibrary: Option<Bytes>.none(),
    clang: Option<Bytes>.none(),
    packages: List<Bytes>.make(),
    workspace: false,
    progress: Option<Bytes>.none(),
    quiet: false,
    timings: false,
  }
}

/// Whether `value` names a progress display: `auto`, `live`, `plain` or `never`.
pub fn isProgressDisplay(value: &[u8]) -> bool {
  return same(value, b"auto") || same(value, b"live") || same(value, b"plain") || same(value, b"never")
}

/// The optimization profile the options select: `release` for `--release`, else the
/// `--optimization` choice, else none.
pub fn optimizationProfile(self: &Options) -> Option<&[u8]> {
  if self.release {
    return Option<&[u8]>.some(b"release")
  }
  return match &self.optimization {
    Option<Bytes>.Some { value } => Option<&[u8]>.some(Bytes.asSlice(&value))
    Option<Bytes>.None => Option<&[u8]>.none()
  }
}

/// Whether `--release` contradicts an `--optimization` other than `release`.
pub fn conflicting(self: &Options) -> bool {
  return match &self.optimization {
    Option<Bytes>.Some { value } => self.release && !same(Bytes.asSlice(&value), b"release")
    Option<Bytes>.None => false
  }
}

/// Parses the arguments that follow `build`, which are all options.
pub effect fn parseBuild(arguments: &[Bytes]) -> Build
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  return run parsed<Build>(arguments)
}

/// Parses the arguments that follow `check`: the build options, `--json`, `--roots`,
/// `--replay <script>` and, with a replay, `--differential`.
pub effect fn parseCheck(arguments: &[Bytes]) -> Check
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let checked = run parsed<Check>(arguments)
  if checked.differential {
    if let Option<Bytes>.None = &checked.replay {
      fail run invalid(b"`", b"--differential", b"` needs `--replay <script>`")
    }
  }
  return move checked
}

/// Parses the arguments that follow `hash`: the build options, `--root <path>`, `--test`, and
/// `--list` or `--json`.
pub effect fn parseHash(arguments: &[Bytes]) -> Hash
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let hashed = run parsed<Hash>(arguments)
  if hashed.list && hashed.json { fail run invalid(b"`", b"--list", b"` and `--json` cannot be combined") }
  return move hashed
}

/// Parses the arguments that follow `run`: the build options, `--coredump <path>` and the
/// program's arguments.
pub effect fn parseRun(arguments: &[Bytes]) -> Run
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let line = run parsed<RunLine>(arguments)
  return Run {
    options: move line.options,
    arguments: move line.arguments,
    coredump: move line.coredump,
    debugger: Option<Bytes>.none(),
  }
}

/// Parses the arguments that follow `debug`: the build options, `--port <[address:]port>` and the
/// program's arguments.
pub effect fn parseDebug(arguments: &[Bytes]) -> Run
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let line = run parsed<DebugLine>(arguments)
  return Run {
    options: move line.options,
    arguments: move line.arguments,
    coredump: Option<Bytes>.none(),
    debugger: Option<Bytes>.some(move line.port),
  }
}

/// Parses the arguments that follow `test`: the build options, `--root`, `--file`, `--filter`,
/// `--timeout` and `--no-cache`.
pub effect fn parseTest(arguments: &[Bytes]) -> Test
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  return run parsed<Test>(arguments)
}

/// Whether `value` is a test time limit: one to six decimal digits, a number of seconds.
pub fn isSeconds(value: &[u8]) -> bool {
  if value.length == usize.ZERO || value.length > 6 { return false }
  let mut at = usize.ZERO
  while at < value.length {
    if value[at] < 48 || value[at] > 57 { return false }
    at = at + usize.ONE
  }
  return true
}

/// Parses the arguments that follow `init`: at most one directory, one `--name`, and one of
/// `--lib`, `--workspace` and `--template <template>` (or `-t <template>`). With `--workspace`,
/// `--name` names the starter member. `--list [template]` (or `-l`) stands alone, first. With a
/// template, the arguments after `--` go to its `[[post-init]]` entries.
pub effect fn parseInit(arguments: &[Bytes]) -> Init
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let mut before = arguments.length
  let mut at = usize.ZERO
  while at < arguments.length && before == arguments.length {
    if same(Bytes.asSlice(&arguments[at]), b"--") { before = at }
    at = at + usize.ONE
  }
  let mut passed = List<Bytes>.make()
  at = before + usize.ONE
  while at < arguments.length {
    run List<Bytes>.append(&mut passed, run Bytes.copy(Bytes.asSlice(&arguments[at])))
    at = at + usize.ONE
  }
  let line = run parsed<InitLine>(Slice.view<Bytes>(arguments, usize.ZERO, before))
  if line.list {
    let first = Bytes.asSlice(&arguments[usize.ZERO])
    let alone = arguments.length == usize.ONE
      || (arguments.length == usize.add(0, 2) && !isOption(Bytes.asSlice(&arguments[usize.ONE])))
    if !(same(first, b"--list") || same(first, b"-l")) || !alone {
      fail run invalid(b"", b"`--list`", b" takes only the template to list: `silk init --list [template]`")
    }
    return Init {
      path: Option<Bytes>.none(),
      name: Option<Bytes>.none(),
      kind: Kind.Executable,
      template: move line.path,
      list: true,
      arguments: move passed,
      unsandboxed: false,
    }
  }
  let templated = Option<Bytes>.isSome(&line.template)
  if before < arguments.length && !templated {
    fail run invalid(b"arguments after ", b"`--`", b" go to a template's [[post-init]] entries, so they need `--template`")
  }
  if templated && (line.lib || line.workspace) {
    fail run invalid(b"", b"`--template`", b" cannot be combined with `--lib` or `--workspace`: the template decides what it creates")
  }
  if line.lib && line.workspace {
    fail run invalid(b"", b"`--lib` and `--workspace`", b" cannot be combined: choose a library package or a workspace")
  }
  let mut kind = Kind.Executable
  if line.lib { kind = Kind.Library }
  if line.workspace { kind = Kind.Workspace }
  return Init {
    path: move line.path,
    name: move line.name,
    kind: kind,
    template: move line.template,
    list: false,
    arguments: move passed,
    unsandboxed: line.unsandboxedPostInit,
  }
}

/// Parses the arguments that follow `add`: one package directory, at most one `--name` and at most
/// one `--manifest-path`.
pub effect fn parseAdd(arguments: &[Bytes]) -> Add
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  return run parsed<Add>(arguments)
}

/// Parses the arguments that follow `remove`: one dependency name and at most one
/// `--manifest-path`.
pub effect fn parseRemove(arguments: &[Bytes]) -> Remove
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  return run parsed<Remove>(arguments)
}

/// Parses the arguments that follow `generate`: at most one `--manifest-path` and one `--check`.
pub effect fn parseGenerate(arguments: &[Bytes]) -> Generate
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  return run parsed<Generate>(arguments)
}

/// Parses the arguments that follow `clean`: at most one `--manifest-path`.
pub effect fn parseClean(arguments: &[Bytes]) -> Clean
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  return run parsed<Clean>(arguments)
}
