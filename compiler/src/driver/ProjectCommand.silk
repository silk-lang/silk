/// One parsed `dump <stage> <source>` command line.
pub struct Dump {
  pub stage: Bytes,
  pub source: Bytes,
  pub all: bool,
  pub target: Option<Bytes>,
  pub standardLibrary: Option<Bytes>,
  pub optimization: Option<Bytes>,
  pub debug: Option<Bytes>,
}

impl CommandLine for Dump {
  static fn command() -> Command<Dump> {
    return Command<Dump>.make(
      "silk dump",
      "Print a source file's tokens, syntax tree, HIR or MIR; the options are mir's",
    )
      |> Command.arg(
        "stage",
        Opt.about("What to print")
          |> Opt.choice("tokens")
          |> Opt.choice("syntax")
          |> Opt.choice("hir")
          |> Opt.choice("mir")
          |> Opt.required,
      )
      |> Command.arg("source", Opt.about("The source file") |> Opt.required)
      |> Command.option("all", Opt.about("List every reached function, not only the package's"))
      |> Command.option("target", Opt.about("The target triple; without it, the host"))
      |> Command.option(
        "standardLibrary",
        Opt.about("The standard library directory") |> Opt.long("stdlib"),
      )
      |> Command.option("optimization", Opt.about("none, speed or size; speed by default"))
      |> Command.option(
        "debug",
        Opt.about("Whether to write debug information")
          |> Opt.choice("true")
          |> Opt.choice("false"),
      )
  }
}

/// Parses the arguments that follow `dump`. Only the `mir` stage takes options.
pub effect fn parseDump(arguments: &[Bytes]) -> Dump
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let dumped = run parsed<Dump>(arguments)
  let optioned = dumped.all || Option<Bytes>.isSome(&dumped.target)
    || Option<Bytes>.isSome(&dumped.standardLibrary)
    || Option<Bytes>.isSome(&dumped.optimization)
    || Option<Bytes>.isSome(&dumped.debug)
  if optioned && !same(Bytes.asSlice(&dumped.stage), b"mir") {
    fail run invalid(b"the tokens, syntax and hir stages take no options", b"", b"")
  }
  return move dumped
}

