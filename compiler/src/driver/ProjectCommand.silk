//! Project command lines, parsed from the arguments after the command name.
//!
//! `build [options]` builds the project's targets and `check [options] [--json] [--roots] [--replay <script> [--differential]]`
//! analyzes them. `run [options] [arguments...] [-- arguments...]`
//! builds its host executable and runs it: options are read until `--`, and any other argument
//! before it, and every argument after it, is passed to the program in order. The options are
//! `--manifest-path <path>` (no upward discovery), `--target <host|triple>` (repeatable),
//! `--release`, `--optimization <debug|release|release-with-debug>`, `--profile <name>`,
//! `--profile-input <json>`, `--stdlib <directory>` and `--clang <path>`. `--progress
//! <auto|live|plain|never>` chooses how `build`, `check` and `run` report progress on standard
//! error, and `--quiet` (or `-q`) keeps only their final line. `--timings` lists each unit's
//! slowest modules, bodies and functions.
//!
//! `test [options] [--root <path>] [--file <path>] [--filter <text>] [--timeout <seconds>] [--no-cache]`
//! builds the test runner for the project's host target and runs the selected tests. `--timeout`
//! is each test's time limit, 60 seconds by default; 0 removes the limit.
//!
//! The building commands also take `--package <name>` (or `-p`, repeatable), which selects members
//! of the enclosing workspace by package name, and `--workspace`, which selects every member. A
//! manifest that only defines a workspace selects every member by default.
//!
//! `init [path] [--name <name>] [--lib | --workspace]` creates a project in `path`, by default the
//! working directory: an executable, a library with `--lib`, or a workspace with one starter
//! executable member with `--workspace`.
//!
//! `add <path> [--name <name>] [--manifest-path <path>]` adds the package at `path` as a path
//! dependency, and `remove <name> [--manifest-path <path>]` removes one.
//!
//! `clean [--manifest-path <path>]` removes the project's build output directory.

import driver.ManifestText
import driver.ProjectInitializer { Kind }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.option { Option }
import silk.slice { Slice }
import silk.usize
import silk.list { List }

/// A project command line that names an unknown or repeated option or omits an option's value.
pub struct InvalidProjectCommand {
  /// Why the line is refused, such as ``unknown option `--relase`; did you mean `--release`?``.
  pub reason: Bytes,
}

/// The options shared by the project commands that build.
pub struct Options {
  /// The manifest, as written; absent to discover the nearest one.
  pub manifestPath: Option<Bytes>,

  /// The target selectors, as written and in order; empty for the command's default.
  pub targets: List<Bytes>,

  /// Whether `--release` selects the optimized profile without debug information.
  pub release: bool,

  /// The named project profile `--profile` selects, as written.
  pub profile: Option<Bytes>,

  /// The complete logical profile `--profile-input` supplies as JSON, as written.
  pub profileInput: Option<Bytes>,

  /// The optimization profile `--optimization` selects: `debug`, `release` or `release-with-debug`.
  pub optimization: Option<Bytes>,

  /// The standard-library root, as written.
  pub standardLibrary: Option<Bytes>,

  /// The Clang executable `--clang` selects, as written; absent for `SILK_CLANG` or `PATH`.
  pub clang: Option<Bytes>,

  /// The workspace members `--package` selects by package name, as written and in order.
  pub packages: List<Bytes>,

  /// Whether `--workspace` selects every member of the enclosing workspace.
  pub workspace: bool,

  /// The progress display `--progress` selects: `auto`, `live`, `plain` or `never`.
  pub progress: Option<Bytes>,

  /// Whether `--quiet` keeps only the final line of the progress report.
  pub quiet: bool,

  /// Whether `--timings` lists each unit's slowest modules, bodies and functions.
  pub timings: bool,
}

/// One parsed `build` command line.
pub struct Build {
  pub options: Options,
}

/// One parsed `check` command line.
pub struct Check {
  pub options: Options,

  /// Whether `--json` writes one JSON object per diagnostic instead of the human format.
  pub json: bool,

  /// Whether `--roots` also checks each root module and declaration through the language
  /// server's check roots and compares them with the whole-package check.
  pub roots: bool,

  /// With `--replay <script>`, the edit script replayed against a revisable store instead of
  /// reporting diagnostics.
  pub replay: Option<Bytes>,

  /// Whether `--differential` compares each replay step with a fresh one-shot store.
  pub differential: bool,
}

/// One parsed `run` command line.
pub struct Run {
  pub options: Options,

  /// The program's own arguments, in order.
  pub arguments: List<Bytes>,
}

/// One parsed `test` command line.
pub struct Test {
  pub options: Options,

  /// The discovery root, as written and relative to the project directory; absent for the entry.
  pub root: Option<Bytes>,

  /// The one source file whose tests run, as written and relative to the project directory.
  pub file: Option<Bytes>,

  /// The literal, ASCII case-insensitive test-name substring that selects tests.
  pub filter: Option<Bytes>,

  /// Each test's time limit in seconds, as decimal digits; absent for the default.
  pub timeout: Option<Bytes>,

  /// Whether `--no-cache` builds the test runner again instead of reusing an unchanged one.
  pub noCache: bool,
}

/// One parsed `clean` command line.
pub struct Clean {
  /// The manifest, as written; absent to discover the nearest one.
  pub manifestPath: Option<Bytes>,
}

/// One parsed `init` command line.
pub struct Init {
  /// The project directory, as written; absent for the working directory.
  pub path: Option<Bytes>,

  /// The package name, as written; absent to derive it from the directory.
  pub name: Option<Bytes>,

  /// An executable by default, a library with `--lib` or a workspace with `--workspace`.
  pub kind: Kind,
}

/// One parsed `add` command line.
pub struct Add {
  /// The dependency's package directory, as written.
  pub path: Bytes,

  /// The dependency name, as written; absent to use the dependency's package name.
  pub name: Option<Bytes>,

  /// The manifest, as written; absent to discover the nearest one.
  pub manifestPath: Option<Bytes>,
}

/// One parsed `remove` command line.
pub struct Remove {
  /// The dependency name, as written.
  pub name: Bytes,

  /// The manifest, as written; absent to discover the nearest one.
  pub manifestPath: Option<Bytes>,
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn isOption(argument: &[u8]) -> bool {
  return argument.length > usize.ONE && argument[usize.ZERO] == 45
}

// The options every building command takes, space-separated, with `=` after each that takes a
// value.
fn buildingOptions() -> &'static [u8] {
  return b"--manifest-path= --target= --release --optimization= --profile= --profile-input= --stdlib= --clang= --package= -p= --workspace --progress= --quiet -q --timings"
}

fn smaller(left: usize, right: usize) -> usize {
  if left < right { return left }
  return right
}

effect fn invalid(first: &[u8], argument: &[u8], last: &[u8]) -> InvalidProjectCommand
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut reason = run Bytes.copy(first)
  run Bytes.append(&mut reason, argument)
  run Bytes.append(&mut reason, last)
  return InvalidProjectCommand { reason: move reason }
}

// Why `arguments[at]` is refused by a command whose options `known` lists as `buildingOptions`
// does: an unexpected operand, an unknown option with the closest known spelling, a missing
// value, a value the option does not take, or an option given twice.
effect fn refused(arguments: &[Bytes], at: usize, known: &[u8]) -> InvalidProjectCommand
  ! OutOfMemoryError
  ? &mut Allocator {
  let argument = Bytes.asSlice(&arguments[at])
  if !isOption(argument) {
    return run invalid(b"unexpected argument `", argument, b"`")
  }
  let mut found = false
  let mut valued = false
  let mut closest = Option<Bytes>.none()
  // Only a spelling within two edits, and closer than the argument is long, is suggested.
  let mut closestDistance = smaller(usize.add(0, 3), argument.length / usize.add(0, 2) + usize.ONE)
  let mut start = usize.ZERO
  while start < known.length {
    let mut end = start
    while end < known.length && known[end] != 32 { end = end + usize.ONE }
    let takesValue = known[end - usize.ONE] == 61
    let mut nameEnd = end
    if takesValue { nameEnd = end - usize.ONE }
    let name = Slice.view<u8>(known, start, nameEnd - start)
    if same(name, argument) {
      found = true
      valued = takesValue
    } else {
      let apart = run ManifestText.distance(name, argument)
      if apart < closestDistance {
        closestDistance = apart
        closest = Option<Bytes>.some(run Bytes.copy(name))
      }
    }
    start = end + usize.ONE
  }
  if !found {
    return match move closest {
      Option<Bytes>.Some { value } => {
        let mut reason = run Bytes.copy(b"unknown option `")
        run Bytes.append(&mut reason, argument)
        run Bytes.append(&mut reason, b"`; did you mean `")
        run Bytes.append(&mut reason, Bytes.asSlice(&value))
        run Bytes.append(&mut reason, b"`?")
        return InvalidProjectCommand { reason: move reason }
      }
      Option<Bytes>.None => run invalid(b"unknown option `", argument, b"`")
    }
  }
  if valued && at + usize.ONE >= arguments.length {
    return run invalid(b"`", argument, b"` needs a value")
  }
  if valued {
    let value = Bytes.asSlice(&arguments[at + usize.ONE])
    if same(argument, b"--optimization") && !isOptimizationProfile(value) {
      return run invalid(b"`", argument, b"` takes debug, release or release-with-debug")
    }
    if same(argument, b"--progress") && !isProgressDisplay(value) {
      return run invalid(b"`", argument, b"` takes auto, live, plain or never")
    }
    if same(argument, b"--clang") && value.length == usize.ZERO {
      return run invalid(b"`", argument, b"` needs a path")
    }
  }
  return run invalid(b"`", argument, b"` is given more than once")
}

fn present(value: &Option<Bytes>) -> bool {
  return match &value.* {
    Option<Bytes>.Some { .. } => true
    Option<Bytes>.None => false
  }
}

pub fn options() -> Options {
  return Options {
    manifestPath: Option<Bytes>.none(),
    targets: List<Bytes>.make(),
    release: false,
    profile: Option<Bytes>.none(),
    profileInput: Option<Bytes>.none(),
    optimization: Option<Bytes>.none(),
    standardLibrary: Option<Bytes>.none(),
    clang: Option<Bytes>.none(),
    packages: List<Bytes>.make(),
    workspace: false,
    progress: Option<Bytes>.none(),
    quiet: false,
    timings: false,
  }
}

/// Whether `value` names a progress display: `auto`, `live`, `plain` or `never`.
pub fn isProgressDisplay(value: &[u8]) -> bool {
  return same(value, b"auto") || same(value, b"live") || same(value, b"plain") || same(value, b"never")
}

fn isOptimizationProfile(value: &[u8]) -> bool {
  return same(value, b"debug") || same(value, b"release") || same(value, b"release-with-debug")
}

/// The optimization profile the options select, as the TypeScript `ProjectOptions.resolve` does:
/// `release` for `--release`, else the `--optimization` choice, else none.
pub fn optimizationProfile(self: &Options) -> Option<&[u8]> {
  if self.release {
    return Option<&[u8]>.some(b"release")
  }
  return match &self.optimization {
    Option<Bytes>.Some { value } => Option<&[u8]>.some(Bytes.asSlice(&value))
    Option<Bytes>.None => Option<&[u8]>.none()
  }
}

/// Whether `--release` contradicts an `--optimization` other than `release`.
pub fn conflicting(self: &Options) -> bool {
  return match &self.optimization {
    Option<Bytes>.Some { value } => self.release && !same(Bytes.asSlice(&value), b"release")
    Option<Bytes>.None => false
  }
}

// Reads the option at `arguments[at]` with its value, answering how many arguments it used: zero
// when it is not a valid project option here.
effect fn option(selected: &mut Options, arguments: &[Bytes], at: usize) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let argument = Bytes.asSlice(&arguments[at])
  let valued = at + usize.ONE < arguments.length
  if same(argument, b"--release") && !selected.release {
    selected.release = true
    return usize.ONE
  }
  if same(argument, b"--workspace") && !selected.workspace {
    selected.workspace = true
    return usize.ONE
  }
  if (same(argument, b"--quiet") || same(argument, b"-q")) && !selected.quiet {
    selected.quiet = true
    return usize.ONE
  }
  if same(argument, b"--timings") && !selected.timings {
    selected.timings = true
    return usize.ONE
  }
  if !valued {
    return usize.ZERO
  }
  let value = Bytes.asSlice(&arguments[at + usize.ONE])
  if same(argument, b"--manifest-path") && !present(&selected.manifestPath) {
    selected.manifestPath = Option<Bytes>.some(run Bytes.copy(value))
  } else if same(argument, b"--optimization") && !present(&selected.optimization) && isOptimizationProfile(value) {
    selected.optimization = Option<Bytes>.some(run Bytes.copy(value))
  } else if same(argument, b"--profile-input") && !present(&selected.profileInput) {
    selected.profileInput = Option<Bytes>.some(run Bytes.copy(value))
  } else if same(argument, b"--profile") && !present(&selected.profile) {
    selected.profile = Option<Bytes>.some(run Bytes.copy(value))
  } else if same(argument, b"--stdlib") && !present(&selected.standardLibrary) {
    selected.standardLibrary = Option<Bytes>.some(run Bytes.copy(value))
  } else if same(argument, b"--clang") && !present(&selected.clang) && value.length > usize.ZERO {
    selected.clang = Option<Bytes>.some(run Bytes.copy(value))
  } else if same(argument, b"--progress") && !present(&selected.progress) && isProgressDisplay(value) {
    selected.progress = Option<Bytes>.some(run Bytes.copy(value))
  } else if same(argument, b"--target") {
    run List<Bytes>.append(&mut selected.targets, run Bytes.copy(value))
  } else if same(argument, b"--package") || same(argument, b"-p") {
    run List<Bytes>.append(&mut selected.packages, run Bytes.copy(value))
  } else {
    return usize.ZERO
  }
  return usize.ONE + usize.ONE
}

/// Parses the arguments that follow `build`, which are all options.
pub effect fn parseBuild(arguments: &[Bytes]) -> Build
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let mut selected = options()
  let mut at = usize.ZERO
  while at < arguments.length {
    let used = run option(&mut selected, arguments, at)
    if used == usize.ZERO {
      fail run refused(arguments, at, buildingOptions())
    }
    at = at + used
  }
  return Build { options: move selected }
}

/// Parses the arguments that follow `check`: the build options, `--json`, `--roots`,
/// `--replay <script>` and, with a replay, `--differential`.
pub effect fn parseCheck(arguments: &[Bytes]) -> Check
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let mut selected = options()
  let mut json = false
  let mut roots = false
  let mut replay = Option<Bytes>.none()
  let mut differential = false
  let mut at = usize.ZERO
  while at < arguments.length {
    if same(Bytes.asSlice(&arguments[at]), b"--json") && !json {
      json = true
      at = at + usize.ONE
      continue
    }
    if same(Bytes.asSlice(&arguments[at]), b"--roots") && !roots {
      roots = true
      at = at + usize.ONE
      continue
    }
    if same(Bytes.asSlice(&arguments[at]), b"--replay") {
      if let Option<Bytes>.Some {..} = &replay { fail run invalid(b"`", b"--replay", b"` is given more than once") }
      if at + usize.ONE >= arguments.length { fail run invalid(b"`", b"--replay", b"` needs a value") }
      replay = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&arguments[at + usize.ONE])))
      at = at + usize.add(0, 2)
      continue
    }
    if same(Bytes.asSlice(&arguments[at]), b"--differential") && !differential {
      differential = true
      at = at + usize.ONE
      continue
    }
    let used = run option(&mut selected, arguments, at)
    if used == usize.ZERO {
      let mut known = run Bytes.copy(buildingOptions())
      run Bytes.append(&mut known, b" --json --roots --replay= --differential")
      fail run refused(arguments, at, Bytes.asSlice(&known))
    }
    at = at + used
  }
  if let Option<Bytes>.None = &replay {
    if differential { fail run invalid(b"`", b"--differential", b"` needs `--replay <script>`") }
  }
  return Check { options: move selected, json: json, roots: roots, replay: move replay, differential: differential }
}

/// Parses the arguments that follow `run`.
pub effect fn parseRun(arguments: &[Bytes]) -> Run
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let mut selected = options()
  let mut forwarded = List<Bytes>.make()
  let mut literal = false
  let mut at = usize.ZERO
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    if literal || !isOption(argument) {
      run List<Bytes>.append(&mut forwarded, run Bytes.copy(argument))
      at = at + usize.ONE
      continue
    }
    if same(argument, b"--") {
      literal = true
      at = at + usize.ONE
      continue
    }
    let used = run option(&mut selected, arguments, at)
    if used == usize.ZERO {
      fail run refused(arguments, at, buildingOptions())
    }
    at = at + used
  }
  return Run { options: move selected, arguments: move forwarded }
}

/// Parses the arguments that follow `test`: the build options, `--root`, `--file`, `--filter`
/// and `--no-cache`.
pub effect fn parseTest(arguments: &[Bytes]) -> Test
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let mut selected = options()
  let mut root = Option<Bytes>.none()
  let mut file = Option<Bytes>.none()
  let mut filter = Option<Bytes>.none()
  let mut timeout = Option<Bytes>.none()
  let mut noCache = false
  let mut at = usize.ZERO
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    if same(argument, b"--no-cache") && !noCache {
      noCache = true
      at = at + usize.ONE
      continue
    }
    let valued = at + usize.ONE < arguments.length
    if valued && same(argument, b"--root") && !present(&root) {
      root = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&arguments[at + usize.ONE])))
      at = at + usize.ONE + usize.ONE
      continue
    }
    if valued && same(argument, b"--file") && !present(&file) {
      file = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&arguments[at + usize.ONE])))
      at = at + usize.ONE + usize.ONE
      continue
    }
    if valued && same(argument, b"--filter") && !present(&filter) {
      filter = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&arguments[at + usize.ONE])))
      at = at + usize.ONE + usize.ONE
      continue
    }
    if valued && same(argument, b"--timeout") && !present(&timeout) && isSeconds(Bytes.asSlice(&arguments[at + usize.ONE])) {
      timeout = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&arguments[at + usize.ONE])))
      at = at + usize.ONE + usize.ONE
      continue
    }
    let used = run option(&mut selected, arguments, at)
    if used == usize.ZERO {
      let mut known = run Bytes.copy(buildingOptions())
      run Bytes.append(&mut known, b" --no-cache --root= --file= --filter= --timeout=")
      fail run refused(arguments, at, Bytes.asSlice(&known))
    }
    at = at + used
  }
  return Test { options: move selected, root: move root, file: move file, filter: move filter, timeout: move timeout, noCache: noCache }
}

/// Whether `value` is a test time limit: one to six decimal digits, a number of seconds.
pub fn isSeconds(value: &[u8]) -> bool {
  if value.length == usize.ZERO || value.length > 6 { return false }
  let mut at = usize.ZERO
  while at < value.length {
    if value[at] < 48 || value[at] > 57 { return false }
    at = at + usize.ONE
  }
  return true
}

/// Parses the arguments that follow `init`: at most one directory, one `--name` and one of `--lib`
/// and `--workspace`. With `--workspace`, `--name` names the starter member.
pub effect fn parseInit(arguments: &[Bytes]) -> Init
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let mut path = Option<Bytes>.none()
  let mut name = Option<Bytes>.none()
  let mut kind = Kind.Executable
  let mut at = usize.ZERO
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    at = at + usize.ONE
    if
      !isOption(argument) && !present(&path) {
      path = Option<Bytes>.some(run Bytes.copy(argument))
      continue
    }
    if same(argument, b"--name") && !present(&name) && at < arguments.length {
      name = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&arguments[at])))
      at = at + usize.ONE
      continue
    }
    if same(argument, b"--lib") && kind == Kind.Executable {
      kind = Kind.Library
      continue
    }
    if same(argument, b"--workspace") && kind == Kind.Executable {
      kind = Kind.Workspace
      continue
    }
    let lib = same(argument, b"--lib") && kind == Kind.Workspace
    if lib || (same(argument, b"--workspace") && kind == Kind.Library) {
      fail run invalid(b"", b"`--lib` and `--workspace`", b" cannot be combined: choose a library package or a workspace")
    }
    fail run refused(arguments, at - usize.ONE, b"--name= --lib --workspace")
  }
  return Init { path: move path, name: move name, kind: kind }
}

/// Parses the arguments that follow `add`: one package directory, at most one `--name` and at most
/// one `--manifest-path`.
pub effect fn parseAdd(arguments: &[Bytes]) -> Add
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let mut path = Option<Bytes>.none()
  let mut name = Option<Bytes>.none()
  let mut manifestPath = Option<Bytes>.none()
  let mut at = usize.ZERO
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    at = at + usize.ONE
    if !isOption(argument) && !present(&path) {
      path = Option<Bytes>.some(run Bytes.copy(argument))
      continue
    }
    if same(argument, b"--name") && !present(&name) && at < arguments.length {
      name = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&arguments[at])))
      at = at + usize.ONE
      continue
    }
    if same(argument, b"--manifest-path") && !present(&manifestPath) && at < arguments.length {
      manifestPath = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&arguments[at])))
      at = at + usize.ONE
      continue
    }
    fail run refused(arguments, at - usize.ONE, b"--name= --manifest-path=")
  }
  return match move path {
    Option<Bytes>.Some { value } => Add { path: move value, name: move name, manifestPath: move manifestPath }
    Option<Bytes>.None => {
      fail run invalid(b"missing the directory of the package to add", b"", b"")
    }
  }
}

/// Parses the arguments that follow `remove`: one dependency name and at most one
/// `--manifest-path`.
pub effect fn parseRemove(arguments: &[Bytes]) -> Remove
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let mut name = Option<Bytes>.none()
  let mut manifestPath = Option<Bytes>.none()
  let mut at = usize.ZERO
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    at = at + usize.ONE
    if !isOption(argument) && !present(&name) {
      name = Option<Bytes>.some(run Bytes.copy(argument))
      continue
    }
    if same(argument, b"--manifest-path") && !present(&manifestPath) && at < arguments.length {
      manifestPath = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&arguments[at])))
      at = at + usize.ONE
      continue
    }
    fail run refused(arguments, at - usize.ONE, b"--manifest-path=")
  }
  return match move name {
    Option<Bytes>.Some { value } => Remove { name: move value, manifestPath: move manifestPath }
    Option<Bytes>.None => {
      fail run invalid(b"missing the name of the dependency to remove", b"", b"")
    }
  }
}

/// Parses the arguments that follow `clean`: at most one `--manifest-path`.
pub effect fn parseClean(arguments: &[Bytes]) -> Clean
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let mut manifestPath = Option<Bytes>.none()
  let mut at = usize.ZERO
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    if same(argument, b"--manifest-path") && !present(&manifestPath) && at + usize.ONE < arguments.length {
      manifestPath = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&arguments[at + usize.ONE])))
      at = at + usize.ONE + usize.ONE
      continue
    }
    fail run refused(arguments, at, b"--manifest-path=")
  }
  return Clean { manifestPath: move manifestPath }
}
