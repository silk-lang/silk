//! The memory the running compiler has used.
//!
//! # When to use
//! Call [`peakBytes`] where a report shows how much memory the work so far took: `--timings`
//! writes it beside each finished phase, and `--stats` as a `silk-stats memory` line.
//!
//! # Details
//! The figure is the largest resident memory of this process so far, as `getrusage` keeps it. It
//! never falls, so the value read when a phase ends is the peak of the build up to that phase.
//! Copies of the process a build starts, such as the ones that share a walk, are separate
//! processes and are not in it. A target whose system keeps no such figure reports zero.

static if (Intrinsic.targetOperatingSystem() == "darwin"
  && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")
  && Intrinsic.targetAbi() == "apple")
  || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu"
    && (Intrinsic.targetArchitecture() == "aarch64"
      || Intrinsic.targetArchitecture() == "x86_64")) {
  import silk.core.effect {Effect}
  import silk.core.result {Result}
  import silk.system.system_info {ResourceUsage, SystemInfo, SystemInfoError, UsageScope}
  import silk.system.system_info_native {OsSystemInfo}

  /// The largest resident memory of this process so far, in bytes, or zero when the system does
  /// not report it.
  pub effect fn peakBytes() -> u64 {
    let mut provider = OsSystemInfo.make()
    let read = run Effect.result(SystemInfo.resourceUsage(UsageScope.Process) |> Effect.provideMut<SystemInfo>(&mut provider))
    return match move read {
      Result<ResourceUsage, SystemInfoError>.Success {value} => value.maxResidentBytes
      Result<ResourceUsage, SystemInfoError>.Failure {..} => 0
    }
  }
} else {
  /// The largest resident memory of this process so far, in bytes, or zero when the system does
  /// not report it. This target reports none.
  pub effect fn peakBytes() -> u64 {
    return 0
  }
}
