//! Owned structural representation of a statically evaluated standard build plan.
//!
//! These records retain the field and variant order of silk.build.descriptor and
//! silk.build.plan. StaticDecode replaces immutable static references with owned boxes and text;
//! it never recognizes a source actor or executes a method while decoding.

import driver.StaticDecode { StaticDecode }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.mem.box { Box }
import silk.text.string { String }

pub struct Chain<T> {
  pub previous: Option<Box<Chain<T>>>,
  pub value: T,
}

impl<T: StaticDecode> StaticDecode for Chain<T> {}

pub union Input {
  Source { pub path: String },
  Supplied { pub path: String },
  Archive { pub name: String, pub path: String },
  Output { pub step: Box<Action>, pub name: String },
}

impl StaticDecode for Input {}

pub union Argument {
  Text { pub value: String },
  Input { pub path: Input },
  Output { pub name: String },
  File { pub path: Input },
  Tree { pub path: Input },
}

impl StaticDecode for Argument {}

pub struct Invocation {
  pub program: Input,
  pub arguments: Option<Box<Chain<Argument>>>,
}

impl StaticDecode for Invocation {}

pub struct File {
  pub name: String,
  pub content: String
}

impl StaticDecode for File {}

pub union Action {
  Run { pub invocation: Invocation },
  WriteFiles { pub files: Option<Box<Chain<File>>> },
}

impl StaticDecode for Action {}

pub union Operation {
  Module { pub name: String, pub source: Input },
  Compile {
    pub language: String,
    pub source: Input,
    pub flags: List<String>,
    pub include: Option<Box<Chain<Input>>>,
    pub pattern: Option<String>
  },
  Flag { pub value: String },
  Include { pub path: Input },
  LinkFile { pub kind: String, pub path: Input },
  Link { pub kind: String, pub name: String, pub mode: String, pub weak: bool, pub needed: bool },
  RPath { pub value: String },
  FunctionOrder { pub path: Input },
}

impl StaticDecode for Operation {}

pub struct Plan {
  pub steps: Option<Box<Chain<Operation>>>
}

impl StaticDecode for Plan {}
