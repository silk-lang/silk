//! One Silk project: its manifest, package name, entry, artifact and build output directory.
//!
//! Project commands (`run`) find the nearest `silk.toml` above the working directory, as the
//! TypeScript CLI's `Project.load` does, and place their artifacts below `[build].output-dir`.
//! A package that a `[workspace]` above it lists as a member places them below the workspace's
//! `output-dir` instead, shared by every member (PACKAGE-007).

import silk.allocator { Allocator, OutOfMemoryError }
import silk.box { Box }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.filesystem { DirectoryEntry, DirectoryInfo, FileError, FileInfo, FileSystem, Path }
import silk.option { Option }
import silk.result { Result }
import silk.slice { Slice }
import silk.string { String }
import silk.toml_scanner { TomlError }
import silk.toml_value { Toml, TomlChild, Value as TomlValue }
import silk.usize
import silk.list { List }
import driver.CommandPath
import driver.PlatformSupply as PlatformSupplies { Request as SupplyRequest, SupplyError }
import driver.ProjectProfile as ProjectProfiles { Code as ProfileCode, InvalidProfile }
import driver.TargetSelector

/// A project that cannot be located or whose manifest a project command cannot use.
pub union ProjectError {
  /// No `silk.toml` in the starting directory or any of its parents.
  ManifestNotFound { pub start: Path },
  /// A candidate manifest could not be inspected during discovery.
  Uninspectable { pub path: Path },
  /// The manifest could not be read.
  Unreadable { pub manifest: Path },
  /// The manifest is not TOML or one of its fields is invalid; `detail` names the field, and
  /// `line` is the 1-based manifest line that writes it, or zero when no line is known.
  InvalidManifest { pub manifest: Path, pub line: usize, pub detail: Bytes },
  /// A profile, the profile catalog or a binding is invalid; `subject` names the input, and `line`
  /// is the 1-based manifest line that writes it, or zero when no line is known.
  InvalidProfile { pub manifest: Path, pub line: usize, pub code: ProfileCode, pub subject: Bytes },
}

/// A loaded project manifest with every path resolved against its directory.
pub struct Project {
  manifest: Path
  directory: Path
  name: Bytes
  entry: Path
  sourceRoot: Path
  outputDirectory: Path
  // Whether the manifest sets `[build].output-dir`, which a workspace member may not.
  outputDeclared: bool
  form: Form
  stage: Stage
  targets: List<Bytes>
  text: Bytes
  defaultProfile: Option<Bytes>
  supply: SupplyRequest
}

/// Where a source file selected for a test run lies against the project's source root, the
/// directory of `[package].root`.
pub union SourceSelection {
  /// A source module: its path relative to the project directory, with `/` separators.
  Module { pub relative: Bytes },
  /// The file is not below the source root.
  Outside { pub sourceRoot: Path },
  /// The file's path below the source root is not a canonical module path ending in `.silk`.
  NotModule,
}

/// The final artifact form `[build].artifact` selects (ARTIFACT-001).
pub enum Form {
  Executable,
  SharedLibrary,
  StaticLibrary,
  Object,
}

/// How far `[build].stage` carries the form: its final artifact or one intermediate representation.
pub enum Stage {
  Final,
  LlvmIr,
  LlvmBitcode,
  Assembly,
  Object,
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// Whether `name` is a portable package name: a lowercase letter, then lowercase letters, digits
/// or hyphens. It names the project's artifacts, so it must be one portable file name.
pub fn isPackageName(name: &[u8]) -> bool {
  if name.length == usize.ZERO {
    return false
  }
  if name[usize.ZERO] < 97 || name[usize.ZERO] > 122 {
    return false
  }
  let mut at = usize.ONE
  while at < name.length {
    let byte = name[at]
    let lower = byte >= 97 && byte <= 122
    let digit = byte >= 48 && byte <= 57
    if
      !lower && !digit && byte != 45 {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// A manifest-relative directory: nonempty, relative, without NUL, and never climbing above the
// manifest's directory at any component. `/` and `\` both separate components.
fn isContainedDirectory(text: &[u8]) -> bool {
  if text.length == usize.ZERO || text[usize.ZERO] == 47 || text[usize.ZERO] == 92 {
    return false
  }

  // A drive-letter prefix such as `C:/` is absolute on Windows.
  let second = usize.ONE + usize.ONE
  if text.length > second && text[usize.ONE] == 58 && (text[second] == 47 || text[second] == 92) {
    return false
  }
  let mut depth = usize.ZERO
  let mut start = usize.ZERO
  let mut at = usize.ZERO
  while at <= text.length {
    let boundary = at == text.length || text[at] == 47 || text[at] == 92
    if at < text.length && text[at] == 0 {
      return false
    }
    if boundary {
      let length = at - start
      if length == 2 && text[start] == 46 && text[start + usize.ONE] == 46 {
        if depth == usize.ZERO {
          return false
        }
        depth = depth - usize.ONE
      } else if length > usize.ZERO && !(length == usize.ONE && text[start] == 46) {
        depth = depth + usize.ONE
      }
      start = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return true
}

effect fn invalid(manifest: &Path, detail: &[u8]) -> never
  ! ProjectError | OutOfMemoryError
  ? &mut Allocator {
  fail ProjectError.InvalidManifest {
    manifest: run copyPath(manifest),
    line: usize.ZERO,
    detail: run Bytes.copy(detail)
  }
}

// Fails naming the dotted manifest key `key`, such as `package.description`, which `text` does not
// admit: `<key> is not a supported field`, at the line that writes it.
effect fn unsupportedField(manifest: &Path, text: &[u8], key: &[u8]) -> never
  ! ProjectError | OutOfMemoryError
  ? &mut Allocator {
  let mut detail = run Bytes.copy(key)
  run Bytes.append(&mut detail, b" is not a supported field")
  fail ProjectError.InvalidManifest {
    manifest: run copyPath(manifest),
    line: keyLine(text, key),
    detail: move detail
  }
}

// Whether `byte` is a space, a tab or a carriage return.
fn blank(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 13
}

// `row` without its leading and trailing blanks.
fn trimmed(row: &[u8]) -> &[u8] {
  let mut start = usize.ZERO
  let mut end = row.length
  while start < end && blank(row[start]) {
    start = start + usize.ONE
  }
  while end > start && blank(row[end - usize.ONE]) {
    end = end - usize.ONE
  }
  return Slice.view<u8>(row, start, end - start)
}

// How the written path `table.name` (only `table` when `name` is empty, only `name` when `table`
// is) relates to the dotted key `key`, both compared without blanks: 2 when they are equal, 1 when
// `key` lies inside it, as `package.description` lies inside `package`, and 0 otherwise.
fn pathRelation(table: &[u8], name: &[u8], key: &[u8]) -> usize {
  let mut at = usize.ZERO
  let mut part = usize.ZERO
  while part < usize.add(0, 2) {
    let mut written = table
    if part == usize.ONE {
      written = name
      if table.length > usize.ZERO && name.length > usize.ZERO {
        if at >= key.length || key[at] != 46 {
          return usize.ZERO
        }
        at = at + usize.ONE
      }
    }
    let mut index = usize.ZERO
    while index < written.length {
      // A quoted key, as in `[profiles."1fast"]`, is compared by the name it quotes.
      if !blank(written[index]) && written[index] != 34 && written[index] != 39 {
        if at >= key.length || key[at] != written[index] {
          return usize.ZERO
        }
        at = at + usize.ONE
      }
      index = index + usize.ONE
    }
    part = part + usize.ONE
  }
  if at == usize.ZERO {
    return usize.ZERO
  }
  if at == key.length {
    return usize.add(0, 2)
  }
  if key[at] == 46 {
    return usize.ONE
  }
  return usize.ZERO
}

/// The 1-based line of the manifest `text` that writes the dotted key `key`, such as
/// `profiles.fast.opt`: the first line whose table header and key spell it, else the first line of
/// the innermost table or inline table that holds it, or zero when no line does. A quoted key is
/// read without its quotes; keys inside multi-line values are not recognized.
pub fn keyLine(text: &[u8], key: &[u8]) -> usize {
  let mut table = Slice.view<u8>(text, usize.ZERO, usize.ZERO)
  let mut best = usize.ZERO
  let mut bestDepth = usize.ZERO
  let mut line = usize.ONE
  let mut start = usize.ZERO
  while start < text.length {
    let mut end = start
    while end < text.length && text[end] != 10 {
      end = end + usize.ONE
    }
    let row = trimmed(Slice.view<u8>(text, start, end - start))
    let mut relation = usize.ZERO
    let mut depth = usize.ZERO
    if row.length > usize.ZERO && row[usize.ZERO] == 91 {
      // A `[table]` or `[[array]]` header starts the table its later keys belong to.
      let mut open = usize.ZERO
      while open < row.length && row[open] == 91 {
        open = open + usize.ONE
      }
      let mut close = open
      while close < row.length && row[close] != 93 {
        close = close + usize.ONE
      }
      table = Slice.view<u8>(row, open, close - open)
      relation = pathRelation(table, b"", key)
      depth = table.length
    } else if row.length > usize.ZERO && row[usize.ZERO] != 35 {
      let mut equals = usize.ZERO
      while equals < row.length && row[equals] != 61 {
        equals = equals + usize.ONE
      }
      if equals < row.length {
        let name = Slice.view<u8>(row, usize.ZERO, equals)
        relation = pathRelation(table, name, key)
        depth = table.length + name.length + usize.ONE
      }
    }
    if relation == usize.add(0, 2) {
      return line
    }
    if relation == usize.ONE && depth > bestDepth {
      best = line
      bestDepth = depth
    }
    start = end + usize.ONE
    line = line + usize.ONE
  }
  return best
}

/// The 1-based line of this project's manifest that writes the dotted key `key`, or zero.
pub fn line(self: &Project, key: &[u8]) -> usize {
  return keyLine(Bytes.asSlice(&self.text), key)
}

// Refuses the first member of `table`, written at the dotted manifest path `prefix`, whose key is
// not one of `allowed`.
effect fn onlyFields(manifest: &Path, text: &[u8], table: &TomlValue, prefix: &[u8], allowed: &[&[u8]]) -> ()
  ! ProjectError | OutOfMemoryError
  ? &mut Allocator {
  if let Option<&[u8]>.Some { value: key } = move unsupportedKey(table, allowed) {
    let mut path = Bytes.make()
    if prefix.length > usize.ZERO {
      run Bytes.append(&mut path, prefix)
      run Bytes.append(&mut path, b".")
    }
    run Bytes.append(&mut path, key)
    return run unsupportedField(manifest, text, Bytes.asSlice(&path))
  }
  return ()
}

effect fn copyPath(path: &Path) -> Path
  ! OutOfMemoryError
  ? &mut Allocator {
  let copied = run Effect.result(Path.fromBytes(Path.rawBytes(path)))
  return match move copied {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      // A normalized path always spells a normalized path.
      FileError impossible => {
        drop impossible
        return run Path.root()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// Resolves manifest-relative `text` against `directory`, or reports `detail` for the manifest.
effect fn resolved(manifest: &Path, directory: &Path, text: string, detail: &[u8]) -> Path
  ! ProjectError | OutOfMemoryError
  ? &mut Allocator {
  let attempted = run Effect.result(Path.resolve(directory, text))
  return match move attempted {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError rejected => {
        drop rejected
        return run invalid(manifest, detail)
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// Reads an optional `[build]` text field: `fallback` when absent, or a failure with `detail` when it
// is present but not text.
effect fn buildText<
  'document
>(
  manifest: &Path,
  document: &'document TomlValue,
  name: string,
  fallback: string<'static>,
  detail: &[u8]
) -> string<'document>
  ! ProjectError | OutOfMemoryError
  ? &mut Allocator {
  let field = Toml.fieldAt(Toml.field(document, "build"), name)
  return match move field {
    Option<&TomlValue>.None => fallback
    Option<&TomlValue>.Some { value } => match move Toml.asString(Option<&TomlValue>.some(value)) {
      Option<string>.Some { value: text } => text
      Option<string>.None => run invalid(manifest, detail)
    }
  }
}

// The digits-only identifier `value` has no leading zero.
fn isNumericIdentifier(value: &[u8]) -> bool {
  if value.length == usize.ZERO {
    return false
  }
  let mut at = usize.ZERO
  while at < value.length {
    if value[at] < 48 || value[at] > 57 {
      return false
    }
    at = at + usize.ONE
  }
  return value.length == usize.ONE || value[usize.ZERO] != 48
}

fn isIdentifierByte(byte: u8) -> bool {
  return byte >= 48 && byte <= 57 || byte >= 65 && byte <= 90 || byte >= 97 && byte <= 122 || byte == 45
}

// Whether the dot-separated identifiers of `value` are valid; `prerelease` identifiers that are
// all digits must also have no leading zero.
fn validIdentifiers(value: &[u8], prerelease: bool) -> bool {
  let mut start = usize.ZERO
  let mut at = usize.ZERO
  while at <= value.length {
    if at == value.length || value[at] == 46 {
      if at == start {
        return false
      }
      let mut digits = true
      let mut index = start
      while index < at {
        if !isIdentifierByte(value[index]) {
          return false
        }
        if value[index] < 48 || value[index] > 57 {
          digits = false
        }
        index = index + usize.ONE
      }
      if prerelease && digits && at - start > usize.ONE && value[start] == 48 {
        return false
      }
      start = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return true
}

/// Whether `version` is a semantic version (`MAJOR.MINOR.PATCH`, an optional `-` pre-release and an
/// optional `+` build), as the TypeScript `Project.isSemanticVersion` accepts.
pub fn isSemanticVersion(version: &[u8]) -> bool {
  let mut end = version.length
  let mut at = usize.ZERO
  while at < version.length {
    if version[at] == 43 {
      end = at
      break
    }
    at = at + usize.ONE
  }
  if end < version.length && !validIdentifiers(Slice.view<u8>(version, end + usize.ONE, version.length - end - usize.ONE), false) {
    return false
  }
  let mut coreEnd = end
  at = usize.ZERO
  while at < end {
    if version[at] == 45 {
      coreEnd = at
      break
    }
    at = at + usize.ONE
  }
  if coreEnd < end && !validIdentifiers(Slice.view<u8>(version, coreEnd + usize.ONE, end - coreEnd - usize.ONE), true) {
    return false
  }
  let core = Slice.view<u8>(version, usize.ZERO, coreEnd)
  let mut parts = usize.ZERO
  let mut start = usize.ZERO
  at = usize.ZERO
  while at <= core.length {
    if at == core.length || core[at] == 46 {
      if !isNumericIdentifier(Slice.view<u8>(core, start, at - start)) {
        return false
      }
      parts = parts + usize.ONE
      start = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return parts == usize.add(0, 3)
}

// The first key of the table `table` that is not one of `allowed`.
// Whether `value` is present and anything but an empty array.
fn listsAny(value: Option<&TomlValue>) -> bool {
  return match move value {
    Option<&TomlValue>.Some { value: present } => match move Toml.item(present, usize.ZERO) {
      Option<&TomlValue>.Some { .. } => true
      Option<&TomlValue>.None => match &present.* {
        TomlValue.Array { .. } => false
        _ => true
      }
    }
    Option<&TomlValue>.None => false
  }
}

fn unsupportedKey<'a>(table: &'a TomlValue, allowed: &[&[u8]]) -> Option<&'a [u8]> {
  return match &table.* {
    TomlValue.Table { entries, kind: _ } => {
      let boxed = Box<List<TomlChild>>.get(&entries)
      let children = List<TomlChild>.asSlice(&boxed[0])
      let mut at = usize.ZERO
      while at < children.length {
        if let TomlChild.Member { entry } = &children[at] {
          let key = String.ownedUtf8Bytes(&entry.key)
          let mut known = false
          let mut index = usize.ZERO
          while index < allowed.length {
            if same(key, allowed[index]) {
              known = true
            }
            index = index + usize.ONE
          }
          if !known {
            return Option<&'a [u8]>.some(key)
          }
        }
        at = at + usize.ONE
      }
      return Option<&'a [u8]>.none()
    }
    _ => Option<&'a [u8]>.none()
  }
}

/// Decodes the manifest at `manifest` from its exact bytes. `[package].name` must be a portable
/// package name and `[package].root` names the entry. `[build].output-dir` defaults to `build` and
/// must stay inside the project; `[build].artifact` and `[build].stage` take their manifest
/// spellings and default to `executable` and `final`.
pub effect fn decode(manifest: &Path, text: &[u8]) -> Project
  ! ProjectError | OutOfMemoryError
  ? &mut Allocator {
  let directory = match move run Path.parent(manifest) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run invalid(manifest, b"the manifest path names no file")
  }
  let parsed = run Effect.result(Toml.parse(text))
  let document = match move parsed {
    Result<TomlValue, TomlError | OutOfMemoryError>.Success { value } => move value
    Result<TomlValue, TomlError | OutOfMemoryError>.Failure { error } => match move error {
      TomlError malformed => {
        drop malformed
        return run invalid(manifest, b"the manifest is not valid TOML")
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let packageTable = Toml.field(&document, "package")
  let packaged = match move packageTable {
    Option<&TomlValue>.Some { value } => match &value.* {
      TomlValue.Table { .. } => true
      _ => false
    }
    Option<&TomlValue>.None => false
  }
  if !packaged {
    if let Option<&TomlValue>.Some { value: _ } = move Toml.field(&document, "workspace") {
      return run invalid(manifest, b"this manifest only defines a workspace; run the command in one of its member directories")
    }
    return run invalid(manifest, b"missing [package] table")
  }
  // Each table and field must be one a build reads, so a misspelled `[packge]` or
  // `package.descripton` is refused rather than ignored. `[changes]` belongs to `silk changes`.
  let topKeys: [&[u8]; 6] = [b"package", b"build", b"dependencies", b"profiles", b"workspace", b"changes"]
  run onlyFields(manifest, text, &document, b"", &topKeys)
  if let Option<&TomlValue>.Some { value: package } = move Toml.field(&document, "package") {
    let packageKeys: [&[u8]; 6] = [b"name", b"version", b"root", b"source-root", b"silk-version", b"exports"]
    run onlyFields(manifest, text, package, b"package", &packageKeys)
  }
  if let Option<&TomlValue>.Some { value: dependencies } = move Toml.field(&document, "dependencies") {
    if let TomlValue.Table { entries, kind: _ } = &dependencies.* {
      let boxed = Box<List<TomlChild>>.get(&entries)
      let children = List<TomlChild>.asSlice(&boxed[0])
      let dependencyKeys: [&[u8]; 2] = [b"path", b"package"]
      let mut at = usize.ZERO
      while at < children.length {
        if let TomlChild.Member { entry } = &children[at] {
          let mut prefix = run Bytes.copy(b"dependencies.")
          run Bytes.append(&mut prefix, String.ownedUtf8Bytes(&entry.key))
          run onlyFields(manifest, text, &entry.value, Bytes.asSlice(&prefix), &dependencyKeys)
        }
        at = at + usize.ONE
      }
    }
  }
  let name = match move Toml.asString(Toml.fieldAt(Toml.field(&document, "package"), "name")) {
    Option<string>.Some { value } => String.utf8Bytes(value)
    Option<
      string
    >.None => run invalid(
      manifest,
      b"package.name must start with a lowercase letter and contain only lowercase letters, digits, or hyphens"
    )
  }
  if
    !isPackageName(name) {
    return run invalid(
      manifest,
      b"package.name must start with a lowercase letter and contain only lowercase letters, digits, or hyphens"
    )
  }
  let root = match move Toml.asString(Toml.fieldAt(Toml.field(&document, "package"), "root")) {
    Option<string>.Some { value } => value
    Option<string>.None => run invalid(manifest, b"package.root must be a non-empty string")
  }
  if String.utf8Bytes(root).length == usize.ZERO {
    return run invalid(manifest, b"package.root must be a non-empty string")
  }
  let entry = run resolved(
    manifest,
    &directory,
    root,
    b"package.root must name a file inside the project"
  )
  // Modules resolve below `source-root`, else below the root's directory, and the root must be one.
  let sourceRootDetail = b"package.source-root must be a non-empty string"
  let mut sourceRoot = match move run Path.parent(&entry) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run invalid(manifest, b"package.root must name a file inside the project")
  }
  if let Option<&TomlValue>.Some { value: written } = move Toml.fieldAt(Toml.field(&document, "package"), "source-root") {
    let text = match move Toml.asString(Option<&TomlValue>.some(written)) {
      Option<string>.Some { value } => String.utf8Bytes(value)
      Option<string>.None => run invalid(manifest, sourceRootDetail)
    }
    if text.length == usize.ZERO {
      return run invalid(manifest, sourceRootDetail)
    }
    sourceRoot = match move run Effect.result(CommandPath.resolve(&directory, text)) {
      Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
      Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
        FileError rejected => {
          drop rejected
          return run invalid(manifest, sourceRootDetail)
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
  }
  if !within(Path.rawBytes(&sourceRoot), Path.rawBytes(&entry)) {
    return run invalid(manifest, b"package.root must be a module below the source root")
  }
  // The version is required and must be a complete semantic version, as TypeScript requires.
  let versioned = match move Toml.asString(Toml.fieldAt(Toml.field(&document, "package"), "version")) {
    Option<string>.Some { value } => isSemanticVersion(String.utf8Bytes(value))
    Option<string>.None => false
  }
  if !versioned {
    return run invalid(manifest, b"package.version must be a valid semantic version")
  }
  // `silk-version` records the compiler release that created the project. It is optional, and no
  // build compares it with the running compiler.
  if let Option<&TomlValue>.Some { value: written } = move Toml.fieldAt(Toml.field(&document, "package"), "silk-version") {
    let recorded = match move Toml.asString(Option<&TomlValue>.some(written)) {
      Option<string>.Some { value } => isSemanticVersion(String.utf8Bytes(value))
      Option<string>.None => false
    }
    if !recorded {
      return run invalid(manifest, b"package.silk-version must be a valid semantic version")
    }
  }
  if let Option<&TomlValue>.Some { value: build } = move Toml.field(&document, "build") {
    let table = match &build.* {
      TomlValue.Table { .. } => true
      _ => false
    }
    if !table {
      return run invalid(manifest, b"[build] must be a table")
    }
    let buildKeys: [&[u8]; 10] = [
      b"targets", b"output-dir", b"artifact", b"native-link-inputs", b"platform-supply",
      b"native-bindings", b"stage", b"composition", b"profile", b"bindings",
    ]
    run onlyFields(manifest, text, build, b"build", &buildKeys)
    // This field changes what a build links; until native builds honor it, it is refused rather
    // than ignored.
    if let Option<&TomlValue>.Some { value: _ } = move Toml.field(build, "native-bindings") {
      return run invalid(manifest, b"build.native-bindings is not supported by the native compiler yet")
    }
    // Native requirements change what a build links; until native builds resolve them, a
    // composition naming any is refused rather than built without them.
    if listsAny(Toml.fieldAt(Toml.field(build, "composition"), "requirements")) {
      return run invalid(manifest, b"build.composition.requirements is not supported by the native compiler yet")
    }
    if let Option<&TomlValue>.Some { value: composition } = move Toml.field(build, "composition") {
      let compositionKeys: [&[u8]; 5] = [b"runtimes", b"defaults", b"components", b"retention", b"requirements"]
      run onlyFields(manifest, text, composition, b"build.composition", &compositionKeys)
    }
  }
  let outputDetail = b"build.output-dir must be a non-empty manifest-relative directory that does not escape the project"
  let output = run buildText(manifest, &document, "output-dir", "build", outputDetail)
  if
    !isContainedDirectory(String.utf8Bytes(output)) {
    return run invalid(manifest, outputDetail)
  }
  let outputDirectory = run resolved(manifest, &directory, output, outputDetail)
  let outputDeclared = match move Toml.fieldAt(Toml.field(&document, "build"), "output-dir") {
    Option<&TomlValue>.Some { value: _ } => true
    Option<&TomlValue>.None => false
  }
  let artifactDetail = b"build.artifact must be executable, shared-library, static-library, or object"
  let form = match move formNamed(String.utf8Bytes(
    run buildText(manifest, &document, "artifact", "executable", artifactDetail)
  )) {
    Option<Form>.Some { value } => value
    Option<Form>.None => run invalid(manifest, artifactDetail)
  }
  let stageDetail = b"build.stage is not an admitted emission stage"
  let stage = match move stageNamed(String.utf8Bytes(
    run buildText(manifest, &document, "stage", "final", stageDetail)
  )) {
    Option<Stage>.Some { value } => value
    Option<Stage>.None => run invalid(manifest, stageDetail)
  }
  let targetsDetail = b"build.targets must be a non-empty array of host or canonical target ids"
  let mut targets = List<Bytes>.make()
  match move Toml.fieldAt(Toml.field(&document, "build"), "targets") {
    Option<&TomlValue>.None => {
      run List<Bytes>.append(&mut targets, run Bytes.copy(b"host"))
    }
    Option<&TomlValue>.Some { value: listed } => {
      let array = match &listed.* {
        TomlValue.Array { .. } => true
        _ => false
      }
      if !array {
        return run invalid(manifest, targetsDetail)
      }
      let mut at = usize.ZERO
      while true {
        let item = match move Toml.item(listed, at) {
          Option<&TomlValue>.Some { value } => value
          Option<&TomlValue>.None => {
            break
          }
        }
        let selector = match move Toml.asString(Option<&TomlValue>.some(item)) {
          Option<string>.Some { value } => String.utf8Bytes(value)
          Option<string>.None => run invalid(manifest, targetsDetail)
        }
        if !TargetSelector.isSelector(selector) {
          return run invalid(manifest, targetsDetail)
        }
        run List<Bytes>.append(&mut targets, run Bytes.copy(selector))
        at = at + usize.ONE
      }
      if at == usize.ZERO {
        return run invalid(manifest, targetsDetail)
      }
    }
  }
  let defaultProfile = run profileCatalog(manifest, text, &document)
  let mut supply = SupplyRequest.Automatic
  if let Option<&TomlValue>.Some { value: requested } = move Toml.fieldAt(Toml.field(&document, "build"), "platform-supply") {
    let mut origin = run Bytes.copy(Path.rawBytes(manifest))
    run Bytes.append(&mut origin, b":build.platform-supply")
    let decoded = run Effect.result(PlatformSupplies.decode(requested, &directory, Bytes.asSlice(&origin)))
    supply = match move decoded {
      Result<SupplyRequest, SupplyError | OutOfMemoryError>.Success { value } => move value
      Result<SupplyRequest, SupplyError | OutOfMemoryError>.Failure { error } => match move error {
        SupplyError refused => {
          // The TypeScript manifest error repeats the supply failure's message.
          let mut detail = run Bytes.copy(refused.code)
          run Bytes.append(&mut detail, b": ")
          run Bytes.append(&mut detail, Bytes.asSlice(&refused.subject))
          run Bytes.append(&mut detail, b" (")
          run Bytes.append(&mut detail, Bytes.asSlice(&refused.origin))
          run Bytes.append(&mut detail, b")")
          return run invalid(manifest, Bytes.asSlice(&detail))
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
  }
  return Project {
    manifest: run copyPath(manifest),
    directory: move directory,
    name: run Bytes.copy(name),
    entry: move entry,
    sourceRoot: move sourceRoot,
    outputDirectory: move outputDirectory,
    outputDeclared: outputDeclared,
    form: form,
    stage: stage,
    targets: move targets,
    text: run Bytes.copy(text),
    defaultProfile: move defaultProfile,
    supply: move supply,
  }
}

// Validates the profile catalog and bindings and answers `[build].profile`.
effect fn profileCatalog(manifest: &Path, text: &[u8], document: &TomlValue) -> Option<Bytes>
  ! ProjectError | OutOfMemoryError
  ? &mut Allocator {
  let validated = run Effect.result(ProjectProfiles.catalog(document))
  return match move validated {
    Result<Option<Bytes>, InvalidProfile | OutOfMemoryError>.Success { value } => move value
    Result<Option<Bytes>, InvalidProfile | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProfile refused => {
        let InvalidProfile { code, subject, key } = move refused
        fail ProjectError.InvalidProfile {
          manifest: run copyPath(manifest),
          line: keyLine(text, Bytes.asSlice(&key)),
          code: code,
          subject: move subject,
        }
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

/// Parses the manifest at `manifest`, or fails as an unreadable or invalid manifest.
pub effect fn parsed(manifest: &Path) -> TomlValue
  ! ProjectError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let text = match move run Effect.result(FileSystem.readFile(manifest)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        drop failure
        fail ProjectError.Unreadable { manifest: run copyPath(manifest) }
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  return match move run Effect.result(Toml.parse(Bytes.asSlice(&text))) {
    Result<TomlValue, TomlError | OutOfMemoryError>.Success { value } => move value
    Result<TomlValue, TomlError | OutOfMemoryError>.Failure { error } => match move error {
      TomlError malformed => {
        drop malformed
        return run invalid(manifest, b"the manifest is not valid TOML")
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// Fails naming one `workspace.members` entry of the workspace at `manifest`.
effect fn invalidMember(manifest: &Path, entry: &[u8], reason: &[u8]) -> never
  ! ProjectError | OutOfMemoryError
  ? &mut Allocator {
  let mut detail = run Bytes.copy(b"workspace.members entry `")
  run Bytes.append(&mut detail, entry)
  run Bytes.append(&mut detail, b"` ")
  run Bytes.append(&mut detail, reason)
  return run invalid(manifest, Bytes.asSlice(&detail))
}

// Adds `member` to `members` after checking that it holds a package manifest whose name no
// earlier member has, since members share one output directory.
effect fn addMember(manifest: &Path, entry: &[u8], member: Path, members: &mut List<Member>) -> ()
  ! ProjectError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let earlier = List<Member>.asSlice(&members.*)
  let mut seen = usize.ZERO
  while seen < earlier.length {
    if same(Path.rawBytes(&earlier[seen].directory), Path.rawBytes(&member)) {
      return run invalidMember(manifest, entry, b"names a member that another entry already lists")
    }
    seen = seen + usize.ONE
  }
  let memberManifest = run Path.join(&member, "silk.toml")
  let present = run FileSystem.exists(&memberManifest)
  if !present {
    return run invalidMember(manifest, entry, b"names a directory without a silk.toml")
  }
  let document = run parsed(&memberManifest)
  let name = match move Toml.asString(Toml.fieldAt(Toml.field(&document, "package"), "name")) {
    Option<string>.Some { value } => String.utf8Bytes(value)
    Option<string>.None => run invalidMember(manifest, entry, b"names a manifest without a [package] name")
  }
  let mut at = usize.ZERO
  while at < earlier.length {
    if same(Bytes.asSlice(&earlier[at].name), name) {
      return run invalidMember(manifest, entry, b"names a package whose name another member already has")
    }
    at = at + usize.ONE
  }
  let rooted = match move Toml.fieldAt(Toml.field(&document, "package"), "root") {
    Option<&TomlValue>.Some { value: _ } => true
    Option<&TomlValue>.None => false
  }
  run List<Member>.append(&mut members.*, Member { directory: move member, name: run Bytes.copy(name), rooted: rooted })
  return ()
}

// The member directories `[workspace].members` lists below `directory`. An entry is a directory
// inside the workspace, or one ending in `/*` for each of its child directories (PACKAGE-007).
effect fn members(manifest: &Path, directory: &Path, workspace: &TomlValue) -> List<Member>
  ! ProjectError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let table = match &workspace.* {
    TomlValue.Table { .. } => true
    _ => false
  }
  if !table {
    return run invalid(manifest, b"[workspace] must be a table")
  }
  let workspaceKeys: [&[u8]; 2] = [b"members", b"output-dir"]
  if let Option<&[u8]>.Some { value: _ } = move unsupportedKey(workspace, &workspaceKeys) {
    // The manifest parsed once already; its text locates the key.
    let mut text = Bytes.make()
    match move run Effect.result(FileSystem.readFile(manifest)) {
      Result<Bytes, FileError | OutOfMemoryError>.Success { value } => {
        text = move value
      }
      Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
        FileError failure => {
          drop failure
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    run onlyFields(manifest, Bytes.asSlice(&text), workspace, b"workspace", &workspaceKeys)
  }
  let membersDetail = b"workspace.members must be an array of member directories"
  let listed = match move Toml.field(workspace, "members") {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => run invalid(manifest, membersDetail)
  }
  let array = match &listed.* {
    TomlValue.Array { .. } => true
    _ => false
  }
  if !array {
    return run invalid(manifest, membersDetail)
  }
  let mut found = List<Member>.make()
  let mut at = usize.ZERO
  while true {
    let item = match move Toml.item(listed, at) {
      Option<&TomlValue>.Some { value } => value
      Option<&TomlValue>.None => {
        break
      }
    }
    let entry = match move Toml.asString(Option<&TomlValue>.some(item)) {
      Option<string>.Some { value } => String.utf8Bytes(value)
      Option<string>.None => run invalid(manifest, membersDetail)
    }
    let suffix = usize.ONE + usize.ONE
    let wildcard = entry.length > suffix && entry[entry.length - usize.ONE] == 42 && entry[entry.length - suffix] == 47
    let mut written = entry
    if wildcard {
      written = Slice.view<u8>(entry, usize.ZERO, entry.length - suffix)
    }
    if !isContainedDirectory(written) {
      return run invalidMember(manifest, entry, b"must name a directory inside the workspace")
    }
    let base = run CommandPath.resolve(directory, written)
    if wildcard {
      let listable = run FileSystem.exists(&base)
      if !listable {
        return run invalidMember(manifest, entry, b"names a missing directory")
      }
      let children = match move run Effect.result(FileSystem.listDirectory(&base)) {
        Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success { value } => move value
        Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure { error } => match move error {
          FileError failure => {
            drop failure
            return run invalidMember(manifest, entry, b"names a directory whose children cannot be listed")
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
      let listedChildren = List<DirectoryEntry>.asSlice(&children)
      let prefix = Path.rawBytes(&base).length + usize.ONE
      let mut child = usize.ZERO
      while child < listedChildren.length {
        if listedChildren[child].kind.code == FileSystem.directory().code {
          // Errors name the child, as in `libs/docs`, rather than the whole `libs/*` entry.
          let spelled = Path.rawBytes(&listedChildren[child].path)
          let mut label = run Bytes.copy(written)
          run Bytes.append(&mut label, b"/")
          if spelled.length > prefix {
            run Bytes.append(&mut label, Slice.view<u8>(spelled, prefix, spelled.length - prefix))
          }
          run addMember(manifest, Bytes.asSlice(&label), run copyPath(&listedChildren[child].path), &mut found)
        }
        child = child + usize.ONE
      }
    } else {
      run addMember(manifest, entry, move base, &mut found)
    }
    at = at + usize.ONE
  }
  return move found
}

// Whether some `[workspace].members` entry of the workspace in `directory` could name `target`,
// judged from the entries alone so that a workspace not listing `target` is never validated on its
// behalf. A malformed list counts as listing it, so the error is reported rather than hidden.
effect fn lists(directory: &Path, workspace: &TomlValue, target: &Path) -> bool
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let listed = match move Toml.field(workspace, "members") {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      return true
    }
  }
  let array = match &listed.* {
    TomlValue.Array { .. } => true
    _ => false
  }
  if !array {
    return true
  }
  let mut at = usize.ZERO
  while true {
    let item = match move Toml.item(listed, at) {
      Option<&TomlValue>.Some { value } => value
      Option<&TomlValue>.None => {
        break
      }
    }
    let entry = match move Toml.asString(Option<&TomlValue>.some(item)) {
      Option<string>.Some { value } => String.utf8Bytes(value)
      Option<string>.None => {
        return true
      }
    }
    let suffix = usize.ONE + usize.ONE
    let wildcard = entry.length > suffix && entry[entry.length - usize.ONE] == 42 && entry[entry.length - suffix] == 47
    let mut written = entry
    if wildcard {
      written = Slice.view<u8>(entry, usize.ZERO, entry.length - suffix)
    }
    if !isContainedDirectory(written) {
      return true
    }
    let base = run CommandPath.resolve(directory, written)
    if wildcard {
      if let Option<Path>.Some { value: parent } = move run Path.parent(target) {
        if same(Path.rawBytes(&parent), Path.rawBytes(&base)) {
          return true
        }
      }
    } else if same(Path.rawBytes(&base), Path.rawBytes(target)) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Parses an enclosing manifest, or answers None when it cannot be read or parsed: a manifest other
// than the project's own only matters if it is a workspace listing the project.
effect fn enclosing(manifest: &Path) -> Option<TomlValue>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  return match move run Effect.result(parsed(manifest)) {
    Result<TomlValue, ProjectError | OutOfMemoryError>.Success { value } => Option<TomlValue>.some(move value)
    Result<TomlValue, ProjectError | OutOfMemoryError>.Failure { error } => match move error {
      ProjectError unusable => {
        drop unusable
        return Option<TomlValue>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

/// One workspace member: its directory and package name, and whether its manifest names a
/// `[package].root`, which every project command needs.
pub struct Member {
  pub directory: Path
  pub name: Bytes
  pub rooted: bool
}

/// One workspace: its manifest, directory and shared output directory, and its members in
/// dependency order: each member follows the members it depends on by path, and otherwise they
/// keep the order `[workspace].members` lists them in.
pub struct Workspace {
  pub manifest: Path
  pub directory: Path
  pub outputDirectory: Path
  pub members: List<Member>
  // Whether the manifest also defines a package of its own.
  pub packaged: bool
}

// The output directory `[workspace].output-dir` names below `directory`, by default `build`.
effect fn workspaceOutput(manifest: &Path, directory: &Path, workspace: &TomlValue) -> Path
  ! ProjectError | FileError | OutOfMemoryError
  ? &mut Allocator {
  let outputDetail = b"workspace.output-dir must be a non-empty manifest-relative directory that does not escape the workspace"
  let mut output = run Bytes.copy(b"build")
  if let Option<&TomlValue>.Some { value: written } = move Toml.field(workspace, "output-dir") {
    output = match move Toml.asString(Option<&TomlValue>.some(written)) {
      Option<string>.Some { value } => run Bytes.copy(String.utf8Bytes(value))
      Option<string>.None => run invalid(manifest, outputDetail)
    }
  }
  if !isContainedDirectory(Bytes.asSlice(&output)) {
    return run invalid(manifest, outputDetail)
  }
  return run CommandPath.resolve(directory, Bytes.asSlice(&output))
}

fn holds(indices: &[usize], wanted: usize) -> bool {
  let mut at = usize.ZERO
  while at < indices.length {
    if indices[at] == wanted {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// The indices of the members that member `index` names as path dependencies.
effect fn memberDependencies(listed: &[Member], index: usize) -> List<usize>
  ! ProjectError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut found = List<usize>.make()
  let manifest = run Path.join(&listed[index].directory, "silk.toml")
  let document = run parsed(&manifest)
  let children = match move Toml.field(&document, "dependencies") {
    Option<&TomlValue>.Some { value } => match &value.* {
      TomlValue.Table { entries, kind: _ } => List<TomlChild>.asSlice(&Box<List<TomlChild>>.get(&entries)[0])
      _ => {
        return move found
      }
    }
    Option<&TomlValue>.None => {
      return move found
    }
  }
  let mut at = usize.ZERO
  while at < children.length {
    if let TomlChild.Member { entry } = &children[at] {
      if let Option<string>.Some { value: written } = move Toml.asString(Toml.field(&entry.value, "path")) {
        let resolved = run Effect.result(CommandPath.resolve(&listed[index].directory, String.utf8Bytes(written)))
        if let Result<Path, FileError | OutOfMemoryError>.Success { value: directory } = move resolved {
          let mut other = usize.ZERO
          while other < listed.length {
            if other != index && same(Path.rawBytes(&listed[other].directory), Path.rawBytes(&directory)) {
              run List<usize>.append(&mut found, other)
            }
            other = other + usize.ONE
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return move found
}

// `members` reordered so each follows the members it depends on by path, keeping the listed
// order otherwise. Members in a dependency cycle keep the listed order; loading reports the cycle.
effect fn inDependencyOrder(members: List<Member>) -> List<Member>
  ! ProjectError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let listed = List<Member>.asSlice(&members)
  let mut needs = List<List<usize>>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    run List<List<usize>>.append(&mut needs, run memberDependencies(listed, at))
    at = at + usize.ONE
  }
  let required = List<List<usize>>.asSlice(&needs)
  let mut order = List<usize>.make()
  while List<usize>.length(&order) < listed.length {
    let mut next = usize.MAX
    let mut stuck = usize.MAX
    let mut candidate = usize.ZERO
    while candidate < listed.length && next == usize.MAX {
      if !holds(List<usize>.asSlice(&order), candidate) {
        if stuck == usize.MAX {
          stuck = candidate
        }
        let wanted = List<usize>.asSlice(&required[candidate])
        let mut ready = true
        let mut need = usize.ZERO
        while need < wanted.length {
          if !holds(List<usize>.asSlice(&order), wanted[need]) {
            ready = false
          }
          need = need + usize.ONE
        }
        if ready {
          next = candidate
        }
      }
      candidate = candidate + usize.ONE
    }
    if next == usize.MAX {
      next = stuck
    }
    run List<usize>.append(&mut order, next)
  }
  let placed = List<usize>.asSlice(&order)
  let mut ordered = List<Member>.make()
  at = usize.ZERO
  while at < placed.length {
    let member = &listed[placed[at]]
    run List<Member>.append(&mut ordered, Member {
      directory: run copyPath(&member.directory),
      name: run Bytes.copy(Bytes.asSlice(&member.name)),
      rooted: member.rooted,
    })
    at = at + usize.ONE
  }
  return move ordered
}

/// The workspace the manifest at `manifest` defines, with every member checked, or `None` when it
/// has no `[workspace]` table.
pub effect fn workspace(manifest: &Path) -> Option<Workspace>
  ! ProjectError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let document = run parsed(manifest)
  let table = match move Toml.field(&document, "workspace") {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      return Option<Workspace>.none()
    }
  }
  let directory = match move run Path.parent(manifest) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run invalid(manifest, b"the manifest path names no file")
  }
  let listed = run inDependencyOrder(run members(manifest, &directory, table))
  let output = run workspaceOutput(manifest, &directory, table)
  let packaged = match move Toml.field(&document, "package") {
    Option<&TomlValue>.Some { value: _ } => true
    Option<&TomlValue>.None => false
  }
  return Option<Workspace>.some(Workspace {
    manifest: run copyPath(manifest),
    directory: move directory,
    outputDirectory: move output,
    members: move listed,
    packaged: packaged,
  })
}

/// The nearest manifest at or above `directory` that has a `[workspace]` table. Manifests that
/// cannot be read or parsed on the way are passed over.
pub effect fn enclosingWorkspace(directory: &Path) -> Option<Path>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut current = run copyPath(directory)
  while true {
    let candidate = run Path.join(&current, "silk.toml")
    let present = run FileSystem.exists(&candidate)
    if present {
      if let Option<TomlValue>.Some { value: document } = move run enclosing(&candidate) {
        if let Option<&TomlValue>.Some { value: _ } = move Toml.field(&document, "workspace") {
          return Option<Path>.some(move candidate)
        }
      }
    }
    match move run Path.parent(&current) {
      Option<Path>.Some { value } => {
        current = move value
      }
      Option<Path>.None => {
        break
      }
    }
  }
  return Option<Path>.none()
}

/// Whether some `[workspace].members` entry of the workspace at `manifest` names `member`, judged
/// from the entries alone: a `dir/*` entry names every child of `dir`.
pub effect fn listsMember(manifest: &Path, member: &Path) -> bool
  ! ProjectError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let document = run parsed(manifest)
  let directory = match move run Path.parent(manifest) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run invalid(manifest, b"the manifest path names no file")
  }
  return match move Toml.field(&document, "workspace") {
    Option<&TomlValue>.Some { value } => run lists(&directory, value, member)
    Option<&TomlValue>.None => false
  }
}

// Places `project`'s output below the workspace that lists it as a member, if one encloses it:
// the nearest manifest at or above its directory whose `[workspace]` table lists it.
effect fn joinWorkspace(project: &mut Project) -> ()
  ! ProjectError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut directory = run copyPath(&project.directory)
  while true {
    let candidate = run Path.join(&directory, "silk.toml")
    let present = run FileSystem.exists(&candidate)
    if present {
      if let Option<TomlValue>.Some { value: document } = move run enclosing(&candidate) {
        if let Option<&TomlValue>.Some { value: workspace } = move Toml.field(&document, "workspace") {
          let member = run lists(&directory, workspace, &project.directory)
          if member {
            let listed = run members(&candidate, &directory, workspace)
            let found = List<Member>.asSlice(&listed)
            let mut at = usize.ZERO
            while at < found.length {
              if same(Path.rawBytes(&found[at].directory), Path.rawBytes(&project.directory)) {
                if project.outputDeclared && !same(Path.rawBytes(&candidate), Path.rawBytes(&project.manifest)) {
                  return run invalid(&project.manifest, b"build.output-dir cannot be set in a workspace member; set workspace.output-dir instead")
                }
                project.outputDirectory = run workspaceOutput(&candidate, &directory, workspace)
                return ()
              }
              at = at + usize.ONE
            }
            return ()
          }
        }
      }
    }
    match move run Path.parent(&directory) {
      Option<Path>.Some { value } => {
        directory = move value
      }
      Option<Path>.None => {
        break
      }
    }
  }
  return ()
}

/// Finds the nearest `silk.toml`, beginning at `start` and walking up to the root.
pub effect fn discover(start: &Path) -> Path
  ! ProjectError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut directory = run copyPath(start)
  while true {
    let candidate = run Path.join(&directory, "silk.toml")
    let inspected = run Effect.result(FileSystem.exists(&candidate))
    let found = match move inspected {
      Result<bool, FileError>.Success { value } => value
      Result<bool, FileError>.Failure { error } => {
        drop error
        fail ProjectError.Uninspectable { path: move candidate }
      }
    }
    if found {
      return move candidate
    }
    match move run Path.parent(&directory) {
      Option<Path>.Some { value } => {
        directory = move value
      }
      Option<Path>.None => {
        break
      }
    }
  }
  fail ProjectError.ManifestNotFound { start: run copyPath(start) }
}

/// Reads and decodes the manifest at `manifest`, placing its output in its workspace's when a
/// workspace lists it as a member.
pub effect fn load(manifest: &Path) -> Project
  ! ProjectError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let read = run Effect.result(FileSystem.readFile(manifest))
  let text = match move read {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        drop failure
        fail ProjectError.Unreadable { manifest: run copyPath(manifest) }
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let mut project = run decode(manifest, Bytes.asSlice(&text))
  run joinWorkspace(&mut project)
  return move project
}

/// Borrows the manifest path.
pub fn manifest(self: &Project) -> &Path {
  return &self.manifest
}

/// Borrows the directory that holds the manifest.
pub fn directory(self: &Project) -> &Path {
  return &self.directory
}

/// Borrows the package name.
pub fn name(self: &Project) -> &[u8] {
  return Bytes.asSlice(&self.name)
}

/// Borrows the platform supply `[build].platform-supply` requests: automatic when it names none.
pub fn supply(self: &Project) -> &SupplyRequest {
  return &self.supply
}

/// Borrows the directory modules resolve below: `[package].source-root`, else the entry's directory.
pub fn sourceRoot(self: &Project) -> &Path {
  return &self.sourceRoot
}

// Whether the normalized absolute `path` lies strictly below the directory `root`.
fn within(root: &[u8], path: &[u8]) -> bool {
  let mut prefix = root.length
  if same(root, b"/") {
    prefix = usize.ZERO
  }
  return path.length > prefix + usize.ONE && same(Slice.view<u8>(path, usize.ZERO, prefix), Slice.view<u8>(root, usize.ZERO, prefix))
    && path[prefix] == 47
}

/// Borrows the resolved `[package].root` entry.
pub fn entry(self: &Project) -> &Path {
  return &self.entry
}

/// Borrows the resolved `[build].output-dir`.
pub fn outputDirectory(self: &Project) -> &Path {
  return &self.outputDirectory
}

/// The artifact form `[build].artifact` selects.
pub fn form(self: &Project) -> Form {
  return self.form
}

/// The emission stage `[build].stage` selects.
pub fn stage(self: &Project) -> Stage {
  return self.stage
}

/// The manifest document again; `load` already validated it.
pub effect fn document(self: &Project) -> TomlValue
  ! TomlError | OutOfMemoryError
  ? &mut Allocator {
  return run Toml.parse(Bytes.asSlice(&self.text))
}

/// Borrows `[build].profile`, the profile a build uses when it selects no target or profile.
pub fn defaultProfile(self: &Project) -> Option<&[u8]> {
  return match &self.defaultProfile {
    Option<Bytes>.Some { value } => Option<&[u8]>.some(Bytes.asSlice(&value))
    Option<Bytes>.None => Option<&[u8]>.none()
  }
}

/// Borrows the `[build].targets` selectors, `host` when the manifest names none.
pub fn targets(self: &Project) -> &[Bytes] {
  return List<Bytes>.asSlice(&self.targets)
}

/// Whether the project's final artifact is an executable that `run` can start.
pub fn runnable(self: &Project) -> bool {
  return self.form == Form.Executable && self.stage == Stage.Final
}

/// The form a `[build].artifact` spelling names.
pub fn formNamed(spelling: &[u8]) -> Option<Form> {
  if same(spelling, b"executable") { return Option<Form>.some(Form.Executable) }
  if same(spelling, b"shared-library") { return Option<Form>.some(Form.SharedLibrary) }
  if same(spelling, b"static-library") { return Option<Form>.some(Form.StaticLibrary) }
  if same(spelling, b"object") { return Option<Form>.some(Form.Object) }
  return Option<Form>.none()
}

/// The manifest spelling of `form`.
pub fn formSpelling(form: Form) -> &'static [u8] {
  return match form {
    Form.Executable => b"executable"
    Form.SharedLibrary => b"shared-library"
    Form.StaticLibrary => b"static-library"
    Form.Object => b"object"
  }
}

/// The logical profile artifact of `form` (PROFILE-001), as the TypeScript CLI maps it.
pub fn profileArtifact(form: Form) -> &'static [u8] {
  return match form {
    Form.Executable => b"executable"
    Form.SharedLibrary => b"loadable-module"
    Form.StaticLibrary => b"static-archive"
    Form.Object => b"object"
  }
}

/// The stage a `[build].stage` spelling names.
pub fn stageNamed(spelling: &[u8]) -> Option<Stage> {
  if same(spelling, b"final") { return Option<Stage>.some(Stage.Final) }
  if same(spelling, b"llvm-ir") { return Option<Stage>.some(Stage.LlvmIr) }
  if same(spelling, b"llvm-bitcode") { return Option<Stage>.some(Stage.LlvmBitcode) }
  if same(spelling, b"assembly") { return Option<Stage>.some(Stage.Assembly) }
  if same(spelling, b"object") { return Option<Stage>.some(Stage.Object) }
  return Option<Stage>.none()
}

/// Names the build directory of one logical optimization profile, as the TypeScript CLI does:
/// `debug` without optimization, otherwise `release` or, with debug information, `release-with-debug`.
pub fn profileName(optimization: &[u8], debug: bool) -> &'static [u8] {
  if
    !same(optimization, b"speed") {
    return b"debug"
  }
  if debug {
    return b"release-with-debug"
  }
  return b"release"
}

/// The output directory of a build: the named project profile it builds, as written, or else the
/// optimization profile's [`profileName`], so builds of different named profiles never share a path.
pub effect fn profileDirectory(named: &Option<Bytes>, optimization: &[u8], debug: bool) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  if let Option<Bytes>.Some { value } = &named.* {
    return run Bytes.copy(Bytes.asSlice(&value))
  }
  return run Bytes.copy(profileName(optimization, debug))
}

/// The artifact's path for `target` and `profile`: `<output-dir>/llvm/<target>/<profile>/<file>`,
/// where the file is named as the TypeScript CLI names it. A final stage names the form's file
/// (`<name>`, `lib<name>.so`, `lib<name>.dylib` on macOS, `lib<name>.a` or `<name>.o`), and an
/// intermediate stage names `<name>.ll`, `.bc`, `.s` or `.o`.
pub effect fn artifact(self: &Project, target: &[u8], profile: &[u8]) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let llvm = run Path.join(&self.outputDirectory, "llvm")
  let targeted = run Path.joinBytes(&llvm, target)
  let profiled = run Path.joinBytes(&targeted, profile)
  let name = Bytes.asSlice(&self.name)
  let mut file = Bytes.make()
  let mut suffix: &[u8] = b""
  match self.stage {
    Stage.Final => match self.form {
      Form.Executable => {}
      Form.SharedLibrary => {
        run Bytes.append(&mut file, b"lib")
        suffix = b".so"
        if same(target, b"aarch64-apple-darwin") {
          suffix = b".dylib"
        }
      }
      Form.StaticLibrary => {
        run Bytes.append(&mut file, b"lib")
        suffix = b".a"
      }
      Form.Object => {
        suffix = b".o"
      }
    }
    Stage.LlvmIr => {
      suffix = b".ll"
    }
    Stage.LlvmBitcode => {
      suffix = b".bc"
    }
    Stage.Assembly => {
      suffix = b".s"
    }
    Stage.Object => {
      suffix = b".o"
    }
  }
  run Bytes.append(&mut file, name)
  run Bytes.append(&mut file, suffix)
  return run Path.joinBytes(&profiled, Bytes.asSlice(&file))
}

/// The test runner's path for `target` and `profile`:
/// `<output-dir>/test/llvm/<target>/<profile>/<name>`, beside no build artifact.
pub effect fn testExecutable(self: &Project, target: &[u8], profile: &[u8]) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let tests = run Path.join(&self.outputDirectory, "test")
  let llvm = run Path.join(&tests, "llvm")
  let targeted = run Path.joinBytes(&llvm, target)
  let profiled = run Path.joinBytes(&targeted, profile)
  return run Path.joinBytes(&profiled, Bytes.asSlice(&self.name))
}

// Whether `path` is a canonical module path with the `.silk` extension: `/`-separated segments of
// ASCII letters, digits, `_` and `-`, as the TypeScript `SourceEntry.identify` requires.
fn isModulePath(path: &[u8]) -> bool {
  let extension = b".silk"
  if path.length <= extension.length {
    return false
  }
  let stem = path.length - extension.length
  if !same(Slice.view<u8>(path, stem, extension.length), extension) {
    return false
  }
  let mut segment = usize.ZERO
  let mut at = usize.ZERO
  while at < stem {
    let byte = path[at]
    if byte == 47 {
      if segment == usize.ZERO {
        return false
      }
      segment = usize.ZERO
    } else if (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 || byte == 45 {
      segment = segment + usize.ONE
    } else {
      return false
    }
    at = at + usize.ONE
  }
  return segment > usize.ZERO
}

/// Selects the source file at the absolute, normalized `path` for a test run, as the TypeScript
/// `SourceEntry.select` does against the project's source root.
pub effect fn selectSource(self: &Project, path: &Path) -> SourceSelection
  ! OutOfMemoryError
  ? &mut Allocator {
  let root = Path.rawBytes(&self.sourceRoot)
  let selected = Path.rawBytes(path)
  if !within(root, selected) {
    return SourceSelection.Outside { sourceRoot: run copyPath(&self.sourceRoot) }
  }
  let mut prefix = root.length + usize.ONE
  if same(root, b"/") {
    prefix = usize.ONE
  }
  if !isModulePath(Slice.view<u8>(selected, prefix, selected.length - prefix)) {
    return SourceSelection.NotModule
  }
  return SourceSelection.Module { relative: run CommandPath.relative(&self.directory, path) }
}

/// Removes the output directory and everything below it, or a file in its place; an absent output
/// directory is already clean. Only builds write there, and `decode` keeps it inside the project.
pub effect fn clean(self: &Project) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  return run removeOutput(&self.outputDirectory)
}

/// Removes the output directory `output` and everything below it, or a file in its place; an
/// absent one is already clean.
pub effect fn removeOutput(output: &Path) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let present = run FileSystem.exists(output)
  if !present {
    return ()
  }
  return match move run FileSystem.stat(output) {
    DirectoryInfo directory => run FileSystem.removeDirectoryRecursively(output)
    FileInfo file => run FileSystem.removeFile(output)
  }
}
