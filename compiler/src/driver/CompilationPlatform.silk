//! Platform link inputs from the explicit compilation request.

import driver.NativeToolchain
import silk.build.request { Request, Windows, MacOS }
import silk.core.effect { Effect }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StderrWriter }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileSystem, FileError, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.system.child_process { ChildProcess, ProcessRequest, ProcessError }
import silk.text.string { String }
import silk.collections.bytes { Bytes }
import silk.num.usize

effect fn linker(process: &mut ProcessRequest, prefix: string, value: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut argument = run String.copy(prefix)
  run argument.append(value)
  run ChildProcess.addArgument(&mut process.*, "-Xlinker")
  run ChildProcess.addArgument(&mut process.*, argument.view())
}

/// Adds the request's platform link options and compiles Windows resource scripts with LLVM.
/// Returns a resource compiler's nonzero status without starting the linker.
pub effect fn link(
  process: &mut ProcessRequest,
  clang: &Path,
  scratch: &Path,
  request: &Request,
  shared: bool,
) -> i32
  ! FileError | ProcessError | HostInputError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  if let Option<Windows>.Some { value } = &request.windows {
    if let Option<String>.Some { value: subsystem } = &value.subsystem {
      run linker(&mut process.*, "/subsystem:", subsystem.view())
    }
    if let Option<String>.Some { value: manifest } = &value.manifest {
      run ChildProcess.addArgument(&mut process.*, "-Xlinker")
      run ChildProcess.addArgument(
        &mut process.*,
        if shared {
          "/manifest:embed,id=2"
        } else {
          "/manifest:embed,id=1"
        },
      )
      run linkerPath(&mut process.*, "/manifestinput:", manifest.view())
    }
    let resources = value.resources.asSlice()
    let mut at: usize = 0
    while at < resources.length {
      let source = run Path.make(resources[at].view())
      let text = resources[at].view()
      if String.endsWith(text, ".rc") {
        let directory = run FileSystem.createTemporaryDirectory(scratch, b"resource-")
        let output = run Path.join(&directory, "input.res")
        let tool = run NativeToolchain.companion(clang, "llvm-rc")
        let mut compile = run NativeToolchain.request(&tool)
        if let Option<Path>.Some { value: parent } = move run Path.parent(&source) {
          run ChildProcess.addArgument(&mut compile, "/I")
          run NativeToolchain.addPathArgument(&mut compile, &parent)
        }
        run ChildProcess.addArgument(&mut compile, "/fo")
        run NativeToolchain.addPathArgument(&mut compile, &output)
        run NativeToolchain.addPathArgument(&mut compile, &source)
        let status = run execute(&compile)
        if status != 0 {
          return status
        }
        run NativeToolchain.addPathArgument(&mut process.*, &output)
      } else {
        run NativeToolchain.addPathArgument(&mut process.*, &source)
      }
      at = at + 1
    }
  }
  if let Option<MacOS>.Some { value } = &request.macos {
    if let Option<String>.Some { value: name } = &value.installName {
      run ChildProcess.addArgument(&mut process.*, "-Xlinker")
      run ChildProcess.addArgument(&mut process.*, "-install_name")
      run ChildProcess.addArgument(&mut process.*, "-Xlinker")
      run ChildProcess.addArgument(&mut process.*, name.view())
    }
  }
  if let Option<String>.Some { value } = &request.importLibrary {
    let path = run Path.make(value.view())
    if let Option<Path>.Some { value: parent } = move run Path.parent(&path) {
      run FileSystem.createDirectoriesRecursively(&parent)
    }
    run linkerPath(&mut process.*, "/implib:", value.view())
  }
  return 0
}

/// Signs a completed Mach-O image with the requested entitlements before atomic publication.
pub effect fn sign(output: &Path, request: &Request) -> i32
  ! FileError | ProcessError | HostInputError | OutOfMemoryError | WriterError
  ? &mut ChildProcess | &mut HostInput | &mut Allocator {
  if let Option<MacOS>.Some { value } = &request.macos {
    if let Option<String>.Some { value: entitlements } = &value.entitlements {
      let tool = run Path.make("/usr/bin/codesign")
      let mut process = run NativeToolchain.request(&tool)
      run ChildProcess.addArgument(&mut process, "--force")
      run ChildProcess.addArgument(&mut process, "--sign")
      run ChildProcess.addArgument(&mut process, "-")
      run ChildProcess.addArgument(&mut process, "--entitlements")
      run ChildProcess.addArgument(&mut process, entitlements.view())
      run NativeToolchain.addPathArgument(&mut process, output)
      return run execute(&process)
    }
  }
  return 0
}

// Preserve tool diagnostics while exposing the status to the driver.
effect fn execute(process: &ProcessRequest) -> i32
  ! ProcessError | OutOfMemoryError | WriterError
  ? &mut ChildProcess | &mut Allocator {
  let result = run ChildProcess.submit(process)
  let mut stderr = StderrWriter.make()
  run Writer.writeAll(ChildProcess.errorBytes(&result)) |> Effect.provideMut<Writer>(&mut stderr)
  return Option<i32>.unwrapOr(ChildProcess.exitCode(&result), 2)
}

effect fn linkerPath(process: &mut ProcessRequest, prefix: string, path: string) -> ()
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let native = run NativeToolchain.pathBytes(&run Path.make(path))
  let mut argument = run Bytes.copy(String.utf8Bytes(prefix))
  run argument.append(native.asSlice())
  run ChildProcess.addArgument(&mut process.*, "-Xlinker")
  run ChildProcess.addArgumentBytes(&mut process.*, argument.asSlice())
}
