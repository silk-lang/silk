//! The platform supply one native link consumes, resolved as the platform-supplies reference
//! requires: a project's explicit SDK or sysroot when it names one, else for macOS `SDKROOT` when
//! it is set, else discovery through `xcrun` on a macOS host only.
//!
//! The resolved supply records what was consulted (`SDKROOT` or `DEVELOPER_DIR`, and the
//! discovery query's result), so a later change to the ambient environment cannot change it. An
//! invalid `SDKROOT` fails and never falls back to discovery. Other operating systems need no SDK.

import driver.CommandPath
import semantic.Target { Target }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.box { Box }
import silk.collections.bytes { Bytes }
import silk.system.child_process { ChildProcess, ProcessError, ProcessOutcome }
import silk.core.effect { Effect }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.json.scanner { JsonError }
import silk.json.value { Json, JsonChild, Value as JsonValue }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.crypto.sha2 { Sha256 }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.toml.value { Toml, TomlChild, Value as TomlValue }
import silk.num.u8
import silk.num.usize
import silk.collections.list { List }

/// One GNU compiler-support installation an explicit supply names.
pub struct Installation {
  pub root: Path,
  pub target: Bytes,
  pub origin: Bytes,
}

/// A requested supply: the project's `[native].platform-supply`, or automatic when it names none.
pub union Request {
  /// Discovery for a compatible host target, as when nothing is requested.
  Automatic,
  /// Host discovery, named explicitly.
  Native,
  /// A managed installation: recognized, but not supported.
  Managed { pub name: Bytes },
  /// An installed SDK or sysroot, its linker and its compiler-support installations.
  Explicit { pub target: Bytes, pub root: Path, pub linker: Path, pub origin: Bytes, pub support: List<Installation> },
}

/// One selected supply input, with the SHA-256 of the bytes resolution read.
pub struct SupplyFile {
  pub path: Path,

  /// What the file is to the supply: `support` (a discovery tool), `metadata` or `stub`.
  pub purpose: &'static [u8],

  /// Where the file was selected from, for reporting.
  pub origin: &'static [u8],

  pub digest: [u8; 32],
}

/// One resolved platform supply: a macOS SDK, or an explicit GNU/Linux sysroot.
pub struct Supply {
  /// The SDK root (`-isysroot`) of a macOS target, or the sysroot (`--sysroot`) of a GNU/Linux one.
  pub root: Path,

  /// Whether `root` is a macOS SDK.
  pub darwin: bool,

  /// The compiler-support installation for the target (`--gcc-install-dir`), if one is declared.
  pub support: Option<Path>,

  /// The explicit linker (`--ld-path`), if one is declared.
  pub linker: Option<Path>,

  /// The deployment version, passed to Clang as `-mmacosx-version-min`.
  pub deployment: Bytes,

  /// Where the supply came from: `SDKROOT`, `SDK discovery`, or the explicit request's origin.
  pub origin: Bytes,

  /// The `DEVELOPER_DIR` value discovery forwarded to `xcrun`, if any.
  pub developerDirectory: Option<Bytes>,

  /// The SDK version its `SDKSettings.json` states.
  pub version: Bytes,

  /// Every file resolution read, in reading order: `xcrun` when discovered, `SDKSettings.json` and
  /// `usr/lib/libSystem.tbd`. A link consumes the supply only while these bytes are unchanged.
  pub files: List<SupplyFile>,
}

/// A supply that cannot be resolved, worded as the TypeScript `PlatformSupply` failure:
/// `<code>: <subject> (<origin>)`, then the correction and any tool output.
pub struct SupplyError {
  pub code: &'static [u8],
  pub subject: Bytes,
  pub origin: Bytes,
  pub correction: Bytes,
  pub detail: Bytes,
}

// Whether `value` is a TOML table whose keys are all in `allowed`.
fn exactTable(value: &TomlValue, allowed: &[&[u8]]) -> bool {
  return match &value.* {
    TomlValue.Table { entries, kind: _ } => {
      let boxed = Box<List<TomlChild>>.get(&entries)
      let children = List<TomlChild>.asSlice(&boxed[0])
      let mut at = usize.ZERO
      while at < children.length {
        if let TomlChild.Member { entry } = &children[at] {
          let key = String.ownedUtf8Bytes(&entry.key)
          let mut known = false
          let mut index = usize.ZERO
          while index < allowed.length {
            if same(key, allowed[index]) {
              known = true
            }
            index = index + usize.ONE
          }
          if !known {
            return false
          }
        }
        at = at + usize.ONE
      }
      return true
    }
    _ => false
  }
}

// The text of the string field `name` of `table`, if it is one.
fn textField<'a>(table: &'a TomlValue, name: string) -> Option<&'a [u8]> {
  return match move Toml.asString(Toml.field(table, name)) {
    Option<string>.Some { value } => Option<&'a [u8]>.some(String.utf8Bytes(value))
    Option<string>.None => Option<&'a [u8]>.none()
  }
}

// Whether `target` is a canonical target a native supply can name.
fn supplyTarget(target: &[u8]) -> bool {
  return same(target, b"aarch64-apple-darwin") || same(target, b"x86_64-apple-darwin")
    || same(target, b"x86_64-unknown-linux-gnu") || same(target, b"aarch64-unknown-linux-gnu")
}

effect fn invalidRequest(origin: &[u8]) -> never ! SupplyError | OutOfMemoryError ? &mut Allocator {
  return run failure(b"InvalidConfiguration", b"platform-supply", origin,
    b"Use kind automatic/native, managed with name, or explicit with target/root/linker/origin and optional support installations.", b"")
}

// The path `text` names, relative paths resolving against `directory`.
effect fn suppliedPath(directory: &Path, text: &[u8], origin: &[u8]) -> Path ! SupplyError | OutOfMemoryError ? &mut Allocator {
  let resolved = run Effect.result(CommandPath.resolve(directory, text))
  return match move resolved {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError invalid => {
        drop invalid
        return run invalidRequest(origin)
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

/// Decodes `[native].platform-supply` as the TypeScript `PlatformSupply.decode` does: `kind`
/// `automatic` or `native` alone, `managed` with `name`, or `explicit` with `target`, `root`,
/// `linker`, an optional `origin` (else `origin`) and optional `support` installations of `root`,
/// `target` and `origin`. Paths resolve against the manifest's `directory`.
pub effect fn decode(value: &TomlValue, directory: &Path, origin: &[u8]) -> Request
  ! SupplyError | OutOfMemoryError
  ? &mut Allocator {
  let kindOnly: [&[u8]; 1] = [b"kind"]
  let managedKeys: [&[u8]; 2] = [b"kind", b"name"]
  let explicitKeys: [&[u8]; 6] = [b"kind", b"target", b"root", b"linker", b"origin", b"support"]
  let installationKeys: [&[u8]; 3] = [b"root", b"target", b"origin"]
  let kind = match move textField(value, "kind") {
    Option<&[u8]>.Some { value: text } => text
    Option<&[u8]>.None => run invalidRequest(origin)
  }
  if same(kind, b"automatic") && exactTable(value, &kindOnly) {
    return Request.Automatic
  }
  if same(kind, b"native") && exactTable(value, &kindOnly) {
    return Request.Native
  }
  if same(kind, b"managed") && exactTable(value, &managedKeys) {
    if let Option<&[u8]>.Some { value: name } = move textField(value, "name") {
      return Request.Managed { name: run Bytes.copy(name) }
    }
    return run invalidRequest(origin)
  }
  if !same(kind, b"explicit") || !exactTable(value, &explicitKeys) {
    return run invalidRequest(origin)
  }
  let target = match move textField(value, "target") {
    Option<&[u8]>.Some { value: text } => text
    Option<&[u8]>.None => run invalidRequest(origin)
  }
  if !supplyTarget(target) {
    return run invalidRequest(origin)
  }
  let rootText = match move textField(value, "root") {
    Option<&[u8]>.Some { value: text } => text
    Option<&[u8]>.None => run invalidRequest(origin)
  }
  let linkerText = match move textField(value, "linker") {
    Option<&[u8]>.Some { value: text } => text
    Option<&[u8]>.None => run invalidRequest(origin)
  }
  let mut named = run Bytes.copy(origin)
  if let Option<&TomlValue>.Some { value: _ } = move Toml.field(value, "origin") {
    named = match move textField(value, "origin") {
      Option<&[u8]>.Some { value: text } => run Bytes.copy(text)
      Option<&[u8]>.None => run invalidRequest(origin)
    }
  }
  let mut support = List<Installation>.make()
  if let Option<&TomlValue>.Some { value: listed } = move Toml.field(value, "support") {
    let array = match &listed.* {
      TomlValue.Array { .. } => true
      _ => false
    }
    if !array {
      return run invalidRequest(origin)
    }
    let mut at = usize.ZERO
    while true {
      let item = match move Toml.item(listed, at) {
        Option<&TomlValue>.Some { value: entry } => entry
        Option<&TomlValue>.None => {
          break
        }
      }
      if !exactTable(item, &installationKeys) {
        return run invalidRequest(origin)
      }
      let supportRoot = match move textField(item, "root") {
        Option<&[u8]>.Some { value: text } => text
        Option<&[u8]>.None => run invalidRequest(origin)
      }
      let supportTarget = match move textField(item, "target") {
        Option<&[u8]>.Some { value: text } => text
        Option<&[u8]>.None => run invalidRequest(origin)
      }
      let supportOrigin = match move textField(item, "origin") {
        Option<&[u8]>.Some { value: text } => text
        Option<&[u8]>.None => run invalidRequest(origin)
      }
      if !supplyTarget(supportTarget) {
        return run invalidRequest(origin)
      }
      run List<Installation>.append(&mut support, Installation {
        root: run suppliedPath(directory, supportRoot, origin),
        target: run Bytes.copy(supportTarget),
        origin: run Bytes.copy(supportOrigin),
      })
      at = at + usize.ONE
    }
  }
  return Request.Explicit {
    target: run Bytes.copy(target),
    root: run suppliedPath(directory, rootText, origin),
    linker: run suppliedPath(directory, linkerText, origin),
    origin: move named,
    support: move support,
  }
}

/// The deployment a build uses when its profile names none.
pub fn defaultDeployment() -> &'static [u8] {
  return b"11.0.0"
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn contains(text: &[u8], wanted: &[u8]) -> bool {
  if wanted.length > text.length {
    return false
  }
  let mut at = usize.ZERO
  while at + wanted.length <= text.length {
    if same(Slice.view<u8>(text, at, wanted.length), wanted) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

effect fn failure(code: &'static [u8], subject: &[u8], origin: &[u8], correction: &[u8], detail: &[u8]) -> never
  ! SupplyError | OutOfMemoryError
  ? &mut Allocator {
  fail SupplyError {
    code: code,
    subject: run Bytes.copy(subject),
    origin: run Bytes.copy(origin),
    correction: run Bytes.copy(correction),
    detail: run Bytes.copy(detail),
  }
}

// Whether `version` is one to three dot-separated decimal components.
fn isVersion(version: &[u8]) -> bool {
  if version.length == usize.ZERO {
    return false
  }
  let mut dots = usize.ZERO
  let mut digits = usize.ZERO
  let mut at = usize.ZERO
  while at < version.length {
    let byte = version[at]
    if byte == 46 {
      if digits == usize.ZERO {
        return false
      }
      dots = dots + usize.ONE
      digits = usize.ZERO
    } else if byte >= 48 && byte <= 57 {
      digits = digits + usize.ONE
    } else {
      return false
    }
    at = at + usize.ONE
  }
  return digits > usize.ZERO && dots <= usize.add(0, 2)
}

// The numeric component of `version` at `index`, zero when absent.
fn component(version: &[u8], index: usize) -> usize {
  let mut current = usize.ZERO
  let mut value = usize.ZERO
  let mut at = usize.ZERO
  while at < version.length {
    let byte = version[at]
    if byte == 46 {
      if current == index {
        return value
      }
      current = current + usize.ONE
      value = usize.ZERO
    } else if byte >= 48 && byte <= 57 && current == index {
      value = value * usize.add(0, 10) + (u8.toUsize(byte) - usize.add(0, 48))
    }
    at = at + usize.ONE
  }
  if current == index {
    return value
  }
  return usize.ZERO
}

/// Compares two dotted versions component by component, as the TypeScript `compareVersions`:
/// -1, 0 or 1 as `left` sorts before, equal to or after `right`.
pub fn compareVersions(left: &[u8], right: &[u8]) -> i32 {
  let mut index = usize.ZERO
  while index < usize.add(0, 3) {
    let a = component(left, index)
    let b = component(right, index)
    if a < b {
      return -1
    }
    if a > b {
      return 1
    }
    index = index + usize.ONE
  }
  return 0
}

// The text of `text` without leading and trailing ASCII whitespace.
fn trimmed(text: &[u8]) -> &[u8] {
  let mut start = usize.ZERO
  let mut end = text.length
  while start < end && (text[start] == 32 || text[start] == 10 || text[start] == 13 || text[start] == 9) {
    start = start + usize.ONE
  }
  while end > start && (text[end - usize.ONE] == 32 || text[end - usize.ONE] == 10 || text[end - usize.ONE] == 13 || text[end - usize.ONE] == 9) {
    end = end - usize.ONE
  }
  return Slice.view<u8>(text, start, end - start)
}

// The `SupportedTargets.macosx` table of an SDK's settings.
fn macosTable(settings: &JsonValue) -> Option<&JsonValue> {
  return Json.fieldAt(Json.field(settings, "SupportedTargets"), "macosx")
}

// Whether the JSON array `value` holds the string `wanted`.
fn holdsString(value: Option<&JsonValue>, wanted: &[u8]) -> bool {
  let array = match move value {
    Option<&JsonValue>.Some { value: found } => found
    Option<&JsonValue>.None => {
      return false
    }
  }
  if let JsonValue.Array { values } = &array.* {
    let boxed = Box<List<JsonChild>>.get(&values)
    let children = List<JsonChild>.asSlice(&boxed[0])
    let mut at = usize.ZERO
    while at < children.length {
      if let JsonChild.Item { value: element } = &children[at] {
        if let JsonValue.String { text } = &element {
          if same(String.utf8Bytes(String.view(&text)), wanted) {
            return true
          }
        }
      }
      at = at + usize.ONE
    }
  }
  return false
}

fn digestOf(bytes: &[u8]) -> [u8; 32] {
  let mut state = Sha256.make()
  Sha256.update(&mut state, bytes)
  return state.finish()
}

// Reads one supply input, failing as `StorageFailed` when it cannot be read.
effect fn readInput(path: &Path, origin: &'static [u8]) -> Bytes
  ! SupplyError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let read = run Effect.result(FileSystem.readFile(path))
  return match move read {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError unreadable => {
        drop unreadable
        return run failure(b"StorageFailed", Path.rawBytes(path), origin,
          b"Provide an installed, readable input for this supply.", b"")
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// Reads one supply input through its links and records its target and digest in `files`.
effect fn recorded(files: &mut List<SupplyFile>, path: &Path, purpose: &'static [u8], origin: &'static [u8]) -> Bytes
  ! SupplyError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  // An SDK's contracts are often links, such as `libSystem.tbd` to `libSystem.B.tbd`.
  let canonicalPath = run followed(Path.rawBytes(path))
  let selected = run Path.fromBytes(Bytes.asSlice(&canonicalPath))
  let bytes = run readInput(&selected, origin)
  run List<SupplyFile>.append(&mut files.*, SupplyFile {
    path: move selected,
    purpose: purpose,
    origin: origin,
    digest: digestOf(Bytes.asSlice(&bytes)),
  })
  return move bytes
}

// `path` with its symbolic links resolved, as the TypeScript resolver's `realPath` does: the
// portable filesystem follows none, and SDKs and tools are often links. A path the host cannot resolve
// stays as written, so reading it reports the failure.
effect fn followed(path: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  return match move run CommandPath.canonical(path) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => run Bytes.copy(path)
  }
}

/// Fails as `ChangedInput` when any file the supply selected no longer has the bytes resolution
/// read: a changed input needs a new resolution, never a silently different supply.
pub effect fn validate(self: &Supply) -> ()
  ! SupplyError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let listed = List<SupplyFile>.asSlice(&self.files)
  let mut at = usize.ZERO
  while at < listed.length {
    let bytes = run readInput(&listed[at].path, listed[at].origin)
    let current = digestOf(Bytes.asSlice(&bytes))
    let expected = listed[at].digest
    let mut index = usize.ZERO
    while index < 32 {
      if current[index] != expected[index] {
        return run failure(b"ChangedInput", Path.rawBytes(&listed[at].path), listed[at].origin,
          b"Resolve a new supply snapshot after changing selected inputs.", b"")
      }
      index = index + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// The first `xcrun` on `searchPath` that is a regular file, else the first one a symbolic link
// resolves to.
effect fn located(searchPath: &[u8]) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let candidates = run CommandPath.searchCandidates(searchPath, b"xcrun")
  let listed = List<Bytes>.asSlice(&candidates)
  let mut at = usize.ZERO
  while at < listed.length {
    if run CommandPath.exists(Bytes.asSlice(&listed[at]), false) {
      return Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&listed[at])))
    }
    at = at + usize.ONE
  }
  return run CommandPath.search(searchPath, b"xcrun")
}

// Runs `xcrun --sdk macosx --show-sdk-path` with `PATH` and, when set, `DEVELOPER_DIR`, and
// answers the SDK root it prints.
effect fn discover(developerDirectory: &Option<Bytes>, files: &mut List<SupplyFile>) -> Bytes
  ! SupplyError | FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut FileSystem | &mut ChildProcess | &mut Allocator {
  let searchPath = run HostInput.variableNamed("PATH")
  let xcrun = match &searchPath {
    Option<Bytes>.Some { value } => run located(Bytes.asSlice(&value))
    Option<Bytes>.None => Option<Bytes>.none()
  }
  let tool = match move xcrun {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => run failure(
      b"MissingCapability",
      b"xcrun",
      b"tool selection",
      b"Set an absolute path to an installed executable tool.",
      b""
    )
  }
  let program = run Path.fromBytes(Bytes.asSlice(&tool))
  let discoveryTool = run recorded(&mut files.*, &program, b"support", b"SDK discovery tool")
  drop discoveryTool
  let mut process = run ChildProcess.request(&program)
  run ChildProcess.addArgument(&mut process, "--sdk")
  run ChildProcess.addArgument(&mut process, "macosx")
  run ChildProcess.addArgument(&mut process, "--show-sdk-path")
  if let Option<Bytes>.Some { value } = &searchPath {
    run ChildProcess.setVariableBytes(&mut process, b"PATH", Bytes.asSlice(&value))
  }
  if let Option<Bytes>.Some { value } = &developerDirectory.* {
    run ChildProcess.setVariableBytes(&mut process, b"DEVELOPER_DIR", Bytes.asSlice(&value))
  }
  let ran = run Effect.result(ChildProcess.execute(&process))
  let outcome = match move ran {
    Result<ProcessOutcome, ProcessError | OutOfMemoryError>.Success { value } => move value
    Result<ProcessOutcome, ProcessError | OutOfMemoryError>.Failure { error } => match move error {
      ProcessError failed => {
        drop failed
        return run failure(b"QueryFailed", Bytes.asSlice(&tool), b"native SDK discovery",
          b"Select a runnable compatible tool.", b"")
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let succeeded = match move ChildProcess.exitCode(&outcome) {
    Option<i32>.Some { value } => value == 0
    Option<i32>.None => false
  }
  if !succeeded {
    return run failure(b"QueryFailed", Bytes.asSlice(&tool), b"native SDK discovery",
      b"Inspect the recorded tool output and correct the selected supply.", ChildProcess.errorBytes(&outcome))
  }
  return run Bytes.copy(trimmed(ChildProcess.outputBytes(&outcome)))
}

// Validates the macOS SDK at `root`, selected from `origin`: it must state the target's macOS
// architecture and a version in its `SDKSettings.json`, admit the deployment, and supply that
// architecture's `libSystem` contract. An empty `deployment` is 11.0.0, raised to the SDK's minimum
// when that is later.
effect fn sdk(target: &Target, root: &[u8], origin: Bytes, developerDirectory: Option<Bytes>, deployment: &[u8], linker: Option<Path>, files: List<SupplyFile>) -> Supply
  ! SupplyError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut files = move files
  // Apple spells the architectures `arm64` and `x86_64`, in the settings and in the stubs.
  let mut architecture: &[u8] = b"arm64"
  let mut stubTarget: &[u8] = b"arm64-macos"
  let mut correction: &[u8] = b"Select a macOS SDK that supports arm64."
  if same(Target.architecture(target), b"x86_64") {
    architecture = b"x86_64"
    stubTarget = b"x86_64-macos"
    correction = b"Select a macOS SDK that supports x86_64."
  }
  let text = root
  if text.length == usize.ZERO || text[usize.ZERO] != 47 || same(text, b"/") {
    return run failure(b"InvalidConfiguration", text, Bytes.asSlice(&origin),
      b"Select an absolute macOS SDK directory.", b"")
  }
  let canonicalRoot = run followed(text)
  let directory = run Path.fromBytes(Bytes.asSlice(&canonicalRoot))
  let metadataPath = run Path.join(&directory, "SDKSettings.json")
  let metadata = run recorded(&mut files, &metadataPath, b"metadata", b"SDK metadata")
  let parsed = run Effect.result(Json.parse(Bytes.asSlice(&metadata)))
  let settings = match move parsed {
    Result<JsonValue, JsonError | OutOfMemoryError>.Success { value } => move value
    Result<JsonValue, JsonError | OutOfMemoryError>.Failure { error } => match move error {
      JsonError malformed => {
        drop malformed
        return run failure(b"InvalidConfiguration", Path.rawBytes(&metadataPath), Bytes.asSlice(&origin),
          b"Select an SDK with valid SDKSettings.json.", b"")
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let version = match move Json.asString(Json.field(&settings, "Version")) {
    Option<string>.Some { value } => run Bytes.copy(String.utf8Bytes(value))
    Option<string>.None => Bytes.make()
  }
  if !holdsString(Json.fieldAt(macosTable(&settings), "Archs"), architecture) || !isVersion(Bytes.asSlice(&version)) {
    return run failure(b"TargetMismatch", Path.rawBytes(&metadataPath), Bytes.asSlice(&origin),
      correction, b"")
  }
  let mut requested = run Bytes.copy(deployment)
  if deployment.length == usize.ZERO {
    requested = run Bytes.copy(defaultDeployment())
  }
  let mut maximum = run Bytes.copy(Bytes.asSlice(&version))
  if let Option<string>.Some { value } = move Json.asString(Json.fieldAt(macosTable(&settings), "MaximumDeploymentTarget")) {
    maximum = run Bytes.copy(String.utf8Bytes(value))
  }
  let mut belowMinimum = false
  if let Option<string>.Some { value } = move Json.asString(Json.fieldAt(macosTable(&settings), "MinimumDeploymentTarget")) {
    let minimum = String.utf8Bytes(value)
    if compareVersions(Bytes.asSlice(&requested), minimum) < 0 {
      // An unset deployment follows the SDK: a newer SDK that drops 11.0.0 (Xcode 27 admits
      // 12.0 and later) raises the default to its own minimum. A written one is never raised.
      if deployment.length == usize.ZERO && isVersion(minimum) {
        requested = run Bytes.copy(minimum)
      } else {
        belowMinimum = true
      }
    }
  }
  if compareVersions(Bytes.asSlice(&requested), defaultDeployment()) < 0 || belowMinimum
    || compareVersions(Bytes.asSlice(&requested), Bytes.asSlice(&maximum)) > 0 {
    return run failure(b"DeploymentMismatch", Bytes.asSlice(&requested), Path.rawBytes(&metadataPath),
      b"Choose an SDK admitting the requested deployment; the compiler will not raise it.", b"")
  }
  let systemPath = run Path.join(&directory, "usr/lib/libSystem.tbd")
  let system = run recorded(&mut files, &systemPath, b"stub", b"SDK libSystem contract")
  let contract = Bytes.asSlice(&system)
  if !contains(contract, stubTarget) || !contains(contract, b"/usr/lib/libSystem.B.dylib") {
    return run failure(b"TargetMismatch", Path.rawBytes(&systemPath), b"SDK libSystem contract",
      b"Supply a macOS libSystem contract for the target's architecture.", b"")
  }
  return Supply {
    root: move directory,
    darwin: true,
    support: Option<Path>.none(),
    linker: move linker,
    deployment: move requested,
    origin: move origin,
    developerDirectory: move developerDirectory,
    version: move version,
    files: move files,
  }
}

// Records the explicit linker, which must be an installed file, and returns its path as written.
// The digest is of the file its links lead to, but Clang runs the written path: lld picks its
// flavor from the name it is run by, so `ld64.lld` linking to `lld` must stay `ld64.lld`.
effect fn explicitLinker(linker: &Path, files: &mut List<SupplyFile>) -> Path
  ! SupplyError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let resolved = run followed(Path.rawBytes(linker))
  if !run CommandPath.exists(Bytes.asSlice(&resolved), false) {
    return run failure(b"MissingCapability", Path.rawBytes(linker), b"tool selection",
      b"Set an absolute path to an installed executable tool.", b"")
  }
  let bytes = run recorded(&mut files.*, linker, b"linker", b"selected tool")
  drop bytes
  return run Path.fromBytes(Path.rawBytes(linker))
}

/// Resolves the platform supply a link for `target` on `host` consumes, with the profile's `libc`
/// and `deployment` (empty for the default 11.0.0, or the macOS SDK's minimum when that is
/// later): `None` when the link needs none.
///
/// A managed request is refused. An explicit request must name `target`; it supplies the macOS
/// SDK, or the GNU/Linux sysroot and its compiler-support installation, and its linker. Otherwise
/// a macOS SDK is `SDKROOT` when set, which must be valid and never falls back, else what `xcrun
/// --sdk macosx --show-sdk-path` reports with `DEVELOPER_DIR` forwarded, on a macOS host only; a
/// GNU/Linux target keeps the selected compiler's own sysroot.
pub effect fn resolve(target: &Target, host: &Target, libc: &[u8], deployment: &[u8], request: &Request) -> Option<Supply>
  ! SupplyError | FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut FileSystem | &mut ChildProcess | &mut Allocator {
  let darwin = same(Target.operatingSystem(target), b"darwin")
  match &request.* {
    Request.Managed { name } => {
      return run failure(b"UnsupportedProvider", Bytes.asSlice(&name), b"project", b"Select an installed supply.", b"")
    }
    Request.Explicit { target: named, root, linker, origin, support } => {
      if !same(Bytes.asSlice(&named), Target.name(target)) {
        let mut correction = run Bytes.copy(b"Provide an explicit supply for ")
        run Bytes.append(&mut correction, Target.name(target))
        run Bytes.append(&mut correction, b".")
        return run failure(b"TargetMismatch", Bytes.asSlice(&named), Bytes.asSlice(&origin), Bytes.asSlice(&correction), b"")
      }
      let mut files = List<SupplyFile>.make()
      let selectedLinker = run explicitLinker(&linker, &mut files)
      if darwin {
        return Option<Supply>.some(run sdk(target, Path.rawBytes(&root), run Bytes.copy(Bytes.asSlice(&origin)),
          Option<Bytes>.none(), deployment, Option<Path>.some(move selectedLinker), move files))
      }
      let installations = List<Installation>.asSlice(&support)
      let mut selectedSupport = Option<Path>.none()
      let mut at = usize.ZERO
      while at < installations.length {
        if !same(Bytes.asSlice(&installations[at].target), Target.name(target)) {
          let mut correction = run Bytes.copy(b"Declare support for ")
          run Bytes.append(&mut correction, Target.name(target))
          run Bytes.append(&mut correction, b".")
          return run failure(b"TargetMismatch", Path.rawBytes(&installations[at].root),
            Bytes.asSlice(&installations[at].origin), Bytes.asSlice(&correction), b"")
        }
        if let Option<Path>.None = &selectedSupport {
          selectedSupport = Option<Path>.some(run Path.fromBytes(Path.rawBytes(&installations[at].root)))
        }
        at = at + usize.ONE
      }
      return Option<Supply>.some(Supply {
        root: run Path.fromBytes(Path.rawBytes(&root)),
        darwin: false,
        support: move selectedSupport,
        linker: Option<Path>.some(move selectedLinker),
        deployment: Bytes.make(),
        origin: run Bytes.copy(Bytes.asSlice(&origin)),
        developerDirectory: Option<Bytes>.none(),
        version: Bytes.make(),
        files: move files,
      })
    }
    Request.Automatic => {}
    Request.Native => {}
  }
  if !darwin || same(libc, b"none") {
    return Option<Supply>.none()
  }
  let mut origin = run Bytes.copy(b"SDKROOT")
  let mut developerDirectory = Option<Bytes>.none()
  let mut files = List<SupplyFile>.make()
  let mut root = Bytes.make()
  if let Option<Bytes>.Some { value } = move run HostInput.variableNamed("SDKROOT") {
    root = move value
  } else {
    // One macOS SDK serves every Darwin architecture, so a Mac discovers it for an Intel or Apple
    // silicon target alike; another host has no `xcrun` to ask.
    if !same(Target.operatingSystem(host), b"darwin") {
      return run failure(b"HostMismatch", Target.name(target), b"host",
        b"Provide an explicit supply for the requested target.", b"")
    }
    origin = run Bytes.copy(b"SDK discovery")
    developerDirectory = run HostInput.variableNamed("DEVELOPER_DIR")
    root = run discover(&developerDirectory, &mut files)
  }
  return Option<Supply>.some(run sdk(target, Bytes.asSlice(&root), move origin, move developerDirectory, deployment, Option<Path>.none(), move files))
}
