//! Exports admitted parameter schemas and exact values for compilation requests.

import driver.RequestText
import driver.ModuleSources as Sources { InvalidSourceRoot, ModuleSources }
import documentation.Attached
import documentation.Model { Document }
import semantic.SourceUnit { SourceUnit }
import semantic.DeclarationId { DeclarationId }
import semantic.FinalProfile { FinalProfile, Entry }
import semantic.ModuleId { ModuleId, InvalidModulePath }
import semantic.ParameterSchema { ParameterSchema }
import semantic.ProfileBinding { Shape }
import semantic.ProfileShape as Shapes { Registered, Problem }
import semantic.Query { Cycle }
import semantic.Semantic { Semantic, Request as SemanticRequest, Answer, Outcome, Value }
import semantic.SourceIndex { NoRejection, RevisionMismatch }
import semantic.StaticValue as StaticValues { Value as StaticData, Sign }
import semantic.Type { Type }
import semantic.TypeText
import semantic.Types { Types }
import silk.build.request { Request, Parameter, ParameterValue, ParameterField }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.box { Box }
import silk.mem.interned { Interned }
import silk.mem.shared { Shared }
import silk.system.filesystem { FileError, FileSystem }
import silk.text.string { String }
import silk.num.u64
import silk.num.usize

effect fn decimal(negative: bool, magnitude: u64) -> String
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut reversed: [u8; 20] = [0; 20]
  let mut count = usize.ZERO
  let mut left = magnitude
  while true {
    reversed[count] = u64.toU8(u64.remainder(left, 10) + 48)
    count = count + usize.ONE
    left = u64.divide(left, 10)
    if left == 0 {
      break
    }
  }
  let mut bytes = Bytes.make()
  if negative {
    run bytes.append(b"-")
  }
  while count > usize.ZERO {
    count = count - usize.ONE
    run bytes.append(&[reversed[count]])
  }
  return run RequestText.copy(bytes.asSlice())
}

effect fn value(shape: &Shape, data: &Interned<StaticData>) -> ParameterValue
  ! InvalidSourceRoot | FileError | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let found = Interned<StaticData>.get(data)
  match &shape.* {
    Shape.Boolean => {
      if let StaticData.Boolean { value: flag } = &found.* {
        return ParameterValue.Boolean { value: flag }
      }
    }
    Shape.Integer { .. } => {
      if let StaticData.Integer { sign, magnitude, .. } = &found.* {
        return ParameterValue.Integer { decimal: run decimal(sign == Sign.Negative, magnitude) }
      }
    }
    Shape.String => {
      if let Option<Bytes>.Some { value: bytes } = move run StaticValues.textBytes(data) {
        return ParameterValue.Text { value: run RequestText.copy(bytes.asSlice()) }
      }
    }
    Shape.Enum { canonical, members } => {
      let listed = members.asSlice()
      let mut at = usize.ZERO
      while at < listed.length {
        if run StaticValues.equals(data, &listed[at].value) {
          return ParameterValue.Enum {
            nominal: run RequestText.copy(canonical.asSlice()),
            member: run RequestText.copy(listed[at].name.asSlice()),
          }
        }
        at = at + usize.ONE
      }
    }
    Shape.Optional { absent, present, element, .. } => {
      if let StaticData.Aggregate { variant, fields, .. } = &found.* {
        if let Option<usize>.Some { value: tag } = &variant {
          if tag == absent {
            return ParameterValue.None
          }
          if tag == present && fields.length() == usize.ONE {
            return ParameterValue.Some {
              value: run Box<ParameterValue>.make(
                run value(&Box<Shape>.get(&element)[0], &fields.asSlice()[0]),
              ),
            }
          }
        }
      }
    }
    Shape.Array { element, .. } => {
      if let StaticData.Aggregate { fields, .. } = &found.* {
        let listed = fields.asSlice()
        let mut values = List<ParameterValue>.make()
        let mut at = usize.ZERO
        while at < listed.length {
          run values.append(run value(&Box<Shape>.get(&element)[0], &listed[at]))
          at = at + usize.ONE
        }
        return ParameterValue.Sequence { values: move values }
      }
    }
    Shape.Record { fields: named } => {
      if let StaticData.Aggregate { fields, .. } = &found.* {
        let listed = fields.asSlice()
        let names = named.asSlice()
        let mut values = List<ParameterField>.make()
        let mut at = usize.ZERO
        while at < listed.length {
          run values.append(
            ParameterField {
              name: run RequestText.copy(names[at].name.asSlice()),
              value: run value(&Box<Shape>.get(&names[at].value)[0], &listed[at]),
            },
          )
          at = at + usize.ONE
        }
        return ParameterValue.Record { fields: move values }
      }
    }
  }
  fail InvalidSourceRoot {}
}

struct Header {
  declaration: DeclarationId,
  ty: Interned<Type>,
  hasDefault: bool,
  isPublic: bool,
  start: usize
}

fn header(schema: &ParameterSchema) -> Header {
  return Header {
    declaration: DeclarationId.copy(&schema.declaration),
    ty: Interned<Type>.clone(&schema.ty),
    hasDefault: schema.hasDefault,
    isPublic: schema.isPublic,
    start: schema.span.start,
  }
}

fn defaultValue(answer: &Result<Answer, NoRejection>) -> Option<Interned<StaticData>> {
  if let Result<Answer, NoRejection>.Success { value: result } = &answer.* {
    if let Outcome.Success { value: Value.ParameterDefault { value: data, .. } } = &result.outcome {
      return Option<Interned<StaticData>>.some(Interned<StaticData>.clone(&data))
    }
  }
  return Option<Interned<StaticData>>.none()
}

/// Adds every admitted public parameter, preserving exact enum, integer, aggregate, and optional values.
pub effect fn capture(
  output: &mut Request,
  sources: &ModuleSources,
  store: &mut Semantic,
  request: &mut SemanticRequest,
) -> ()
  ! Cycle | InvalidModulePath | RevisionMismatch | InvalidSourceRoot | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator | &mut Types {
  let profile = match move Semantic.profile(&store.*) {
    Option<&FinalProfile>.Some { value: held } => run FinalProfile.copy(held)
    Option<&FinalProfile>.None => {
      fail InvalidSourceRoot {}
    }
  }
  let target = FinalProfile.target(&profile)
  let registered = match move run Shapes.registered(&mut store.*, &mut request.*, &target) {
    Result<Registered, Problem>.Success { value: found } => move found
    Result<Registered, Problem>.Failure { .. } => {
      fail InvalidSourceRoot {}
    }
  }
  let schemas = registered.schemas.asSlice()
  let mut at = usize.ZERO
  while at < schemas.length {
    let schema = &schemas[at]
    let declared = Shared<ParameterSchema>.with<Header>(&schema.schema, header)
    if !declared.isPublic {
      at = at + usize.ONE
      continue
    }
    let bound = match move FinalProfile.parameter(&profile, &declared.declaration) {
      Option<&Entry>.Some { value: entry } => Interned<StaticData>.clone(&entry.value)
      Option<&Entry>.None => {
        fail InvalidSourceRoot {}
      }
    }
    let identity = DeclarationId.moduleId(&declared.declaration)
    let owner = run ModuleId.copyPackage(identity)
    let module = run ModuleId.copyPath(identity)
    let name = run DeclarationId.copySpelling(&declared.declaration)
    let typeName = match move run TypeText.display(&declared.ty, identity) {
      Option<Bytes>.Some { value: spelling } => run RequestText.copy(spelling.asSlice())
      Option<Bytes>.None => {
        fail InvalidSourceRoot {}
      }
    }
    let mut default = Option<ParameterValue>.none()
    if declared.hasDefault {
      let answer = run Semantic.demandParameterDefault(
        &mut store.*,
        &mut request.*,
        &declared.declaration,
      )
      if let Option<Interned<StaticData>>.Some { value: data } = move Shared<
        Result<Answer, NoRejection>
      >.with<Option<Interned<StaticData>>>(&answer, defaultValue) {
        default = Option<ParameterValue>.some(run value(&schema.shape, &data))
      }
    }
    let mut packageAt = usize.ZERO
    while packageAt < output.packages.length() {
      let package = &output.packages.asSlice()[packageAt]
      let mut full = run String.copy(package.name.view())
      run full.append("@")
      run full.append(package.version.view())
      if full.view() == (run RequestText.copy(owner.asSlice())).view() {
        break
      }
      packageAt = packageAt + usize.ONE
    }
    if packageAt == output.packages.length() {
      fail InvalidSourceRoot {}
    }
    let mut description = String.make()
    if let Option<Bytes>.Some { value: source } = move run Sources.moduleText(sources, identity) {
      let lines = run Attached.lines(source.asSlice())
      let parsed = run SourceUnit.parseSyntax(move source)
      if let Option<Document>.Some { value: document } = move run Attached.declaration(
        &parsed.syntax,
        declared.start,
        lines.asSlice(),
      ) {
        description = run RequestText.copy(document.markdown.asSlice())
      }
    }
    let captured = Parameter {
      name: run RequestText.copy(name.asSlice()),
      module: run RequestText.copy(module.asSlice()),
      typeName: move typeName,
      description: move description,
      required: !declared.hasDefault,
      default: move default,
      value: run value(&schema.shape, &bound),
      suppliedPath: false,
    }
    run List<Parameter>.append(
      &mut output.packages.asMutSlice()[packageAt].parameters,
      move captured,
    )
    at = at + usize.ONE
  }
  return ()
}
