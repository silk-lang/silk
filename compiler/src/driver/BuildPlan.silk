//! The plan a package's `build.silk` computes (`silk.build.plan`): modules it generates and
//! `[native]` entries it adds.
//!
//! `build.silk` declares `pub const PLAN: string`. The driver evaluates it statically, in a store
//! of its own rooted at `build.silk`, and reads the text here. The text starts with `silk-plan 1`;
//! each step is one line, `module <name> <length>` followed by that many source bytes and a line
//! break, or `link { ... }` and `sources { ... }`, an inline table of a `[native].link` or
//! `[native].sources` entry.

import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.collections.slice {Slice}
import silk.num.u8
import silk.num.usize

/// One module a plan generates: its one-segment name and its source.
pub struct Generated {
  pub name: Bytes,
  pub source: Bytes,
}

/// A read plan: its modules, and its `[native]` entries as the text of a TOML document.
pub struct Plan {
  pub modules: List<Generated>,
  pub native: Bytes,
  pub entries: usize,
}

/// The name of the constant a `build.silk` declares.
pub fn constantName() -> &'static [u8] {
  return b"PLAN"
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn startsWith(text: &[u8], prefix: &[u8]) -> bool {
  return text.length >= prefix.length && same(Slice.view<u8>(text, usize.ZERO, prefix.length), prefix)
}

// The end of the line that starts at `at`: the position of its line break, or the text's end.
fn lineEnd(text: &[u8], at: usize) -> usize {
  let mut end = at
  while end < text.length && text[end] != 10 { end = end + usize.ONE }
  return end
}

/// Whether `name` is one module path segment: a letter or `_`, then letters, digits and `_`.
pub fn moduleName(name: &[u8]) -> bool {
  if name.length == usize.ZERO { return false }
  let mut at = usize.ZERO
  while at < name.length {
    let byte = name[at]
    let letter = (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || byte == 95
    let digit = byte >= 48 && byte <= 57
    if !letter && !(digit && at > usize.ZERO) { return false }
    at = at + usize.ONE
  }
  return true
}

/// Reads plan `text`; none when it is not text that `silk.build.plan` writes.
pub effect fn read(text: &[u8]) -> Option<Plan> ! OutOfMemoryError ? &mut Allocator {
  let header = b"silk-plan 1\n"
  if !startsWith(text, header) { return Option<Plan>.none() }
  let mut modules = List<Generated>.make()
  let mut links = Bytes.make()
  let mut sources = Bytes.make()
  let mut entries = usize.ZERO
  let mut at = header.length
  while at < text.length {
    let end = lineEnd(text, at)
    let line = Slice.view<u8>(text, at, end - at)
    if startsWith(line, b"module ") {
      let rest = Slice.view<u8>(line, usize.add(0, 7), line.length - usize.add(0, 7))
      let mut space = usize.ZERO
      while space < rest.length && rest[space] != 32 { space = space + usize.ONE }
      if space == rest.length { return Option<Plan>.none() }
      let name = Slice.view<u8>(rest, usize.ZERO, space)
      let digits = Slice.view<u8>(rest, space + usize.ONE, rest.length - space - usize.ONE)
      if digits.length == usize.ZERO || !moduleName(name) { return Option<Plan>.none() }
      let mut length = usize.ZERO
      let mut digit = usize.ZERO
      while digit < digits.length {
        if digits[digit] < 48 || digits[digit] > 57 { return Option<Plan>.none() }
        length = length * usize.add(0, 10) + u8.toUsize(digits[digit] - 48)
        digit = digit + usize.ONE
      }
      let start = end + usize.ONE
      if start > text.length || length > text.length - start || start + length >= text.length || text[start + length] != 10 {
        return Option<Plan>.none()
      }
      run List<Generated>.append(&mut modules, Generated {
        name: run Bytes.copy(name),
        source: run Bytes.copy(Slice.view<u8>(text, start, length)),
      })
      at = start + length + usize.ONE
      continue
    }
    if startsWith(line, b"link { ") {
      run Bytes.append(&mut links, b"  ")
      run Bytes.append(&mut links, Slice.view<u8>(line, usize.add(0, 5), line.length - usize.add(0, 5)))
      run Bytes.append(&mut links, b",\n")
      entries = entries + usize.ONE
    } else if startsWith(line, b"sources { ") {
      run Bytes.append(&mut sources, b"  ")
      run Bytes.append(&mut sources, Slice.view<u8>(line, usize.add(0, 8), line.length - usize.add(0, 8)))
      run Bytes.append(&mut sources, b",\n")
      entries = entries + usize.ONE
    } else {
      return Option<Plan>.none()
    }
    at = end + usize.ONE
  }
  let mut native = run Bytes.copy(b"[native]\n")
  if Bytes.length(&links) > usize.ZERO {
    run Bytes.append(&mut native, b"link = [\n")
    run Bytes.append(&mut native, Bytes.asSlice(&links))
    run Bytes.append(&mut native, b"]\n")
  }
  if Bytes.length(&sources) > usize.ZERO {
    run Bytes.append(&mut native, b"sources = [\n")
    run Bytes.append(&mut native, Bytes.asSlice(&sources))
    run Bytes.append(&mut native, b"]\n")
  }
  return Option<Plan>.some(Plan {modules: move modules, native: move native, entries: entries})
}
