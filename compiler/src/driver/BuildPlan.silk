//! Decodes pure package requirements and executes their standard steps through the build runner.

import driver.PlanData { Plan, Chain, Operation, Input, Action, Argument, File }
import driver.StaticDecode as StaticDecodes { StaticDecode, InvalidStaticData }
import driver.RequestText
import driver.ToolSandbox as Sandbox
import driver.CacheStamp
import silk.system.host_path as HostPath
import semantic.StaticValue { Value }
import silk.build.run { Run }
import silk.build.write_files { WriteFiles }
import silk.build.step { Deferred, Step, StepHandle, StepFailure, StepError, Key, Make, Runner }
import silk.build.request { Module, Native, NativeSource, LinkInput }
import silk.build.fingerprint as Fingerprint
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.crypto.sha2 { Sha256 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.box { Box }
import silk.mem.interned { Interned }
import silk.schema.schema { Schema }
import silk.schema.json { SchemaJson }
import silk.system.filesystem { FileSystem, FileError, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.concurrency.thread_native { SpawnError }
import silk.concurrency.fiber { Cancelled }
import silk.text.string { String }
import silk.num.usize

pub struct Resolved {
  pub modules: List<Module>,
  pub native: Native,
}
impl Schema for Resolved {}

pub fn constantName() -> &'static [u8] { return b"PLAN" }

pub effect fn read(data: &Interned<Value>) -> Plan ! InvalidStaticData | OutOfMemoryError ? &mut Allocator {
  return run StaticDecodes.read<Plan>(data)
}

// Metadata is separate from deferred paths so the collector's key includes both exact values
// and the content of every resolved input. Path indices preserve declaration order.
struct Requirement {
  pub kind: String,
  pub value: String,
  pub mode: String,
  pub weak: bool,
  pub needed: bool,
  pub path: Option<usize>,
}
impl Schema for Requirement {}
struct Collector { requirements: List<Requirement>, paths: List<Deferred<Path>>, trees: List<bool> }

struct Authority {tools: bool, launcher: Option<Path>, supplied: List<String>}

effect fn input(value: &Input, authority: &Authority) -> Deferred<Path> ! StepFailure ? &mut Allocator {
  return match &value.* {
    Input.Source {path} => run Deferred<Path>.source(path.view())
    Input.Supplied {path} => {
      let canonical = run hostPath(path.view())
      let mut allowed = false
      let supplied = authority.supplied.asSlice()
      let mut at: usize = 0
      while at < supplied.length {
        if contained(String.ownedUtf8Bytes(&supplied[at]), String.ownedUtf8Bytes(&canonical)) { allowed = true }
        at = at + 1
      }
      if !allowed { fail StepError {message: run String.copy("a plan may only read host paths explicitly supplied by its root command")} }
      run Deferred<Path>.external(canonical.view())
    }
    Input.Output {step, name} => {
      let producer = run action(&Box<Action>.get(&step)[0], authority)
      run producer.output(name.view())
    }
  }
}

fn contained(root: &[u8], path: &[u8]) -> bool {
  if path.length < root.length { return false }
  let mut at: usize = 0
  while at < root.length { if root[at] != path[at] { return false } at = at + 1 }
  return path.length == root.length || root.length == 1 || path[root.length] == 47
}

effect fn hostPath(value: string) -> String ! StepFailure ? &mut Allocator {
  let absolute = run Path.make(value)
  let canonical = run HostPath.canonicalBytes(Path.rawBytes(&absolute))
  return match move canonical {
    Option<Bytes>.Some {value: bytes} => run RequestText.copy(bytes.asSlice())
    Option<Bytes>.None => { fail StepError {message: run String.copy("a supplied package path does not exist")} }
  }
}

effect fn files(previous: &Option<Box<Chain<File>>>, current: WriteFiles) -> WriteFiles ! StepFailure ? &mut Allocator {
  if let Option<Box<Chain<File>>>.Some {value} = &previous.* {
    let node = &Box<Chain<File>>.get(&value)[0]
    let earlier = run files(&node.previous, move current)
    return run earlier.text(node.value.name.view(), node.value.content.view())
  }
  return move current
}

effect fn arguments(previous: &Option<Box<Chain<Argument>>>, current: Run, authority: &Authority) -> Run ! StepFailure ? &mut Allocator {
  if let Option<Box<Chain<Argument>>>.Some {value} = &previous.* {
    let node = &Box<Chain<Argument>>.get(&value)[0]
    let earlier = run arguments(&node.previous, move current, authority)
    return match &node.value {
      Argument.Text {value: literal} => run earlier.argument(run Deferred<String>.value(run String.copy(literal.view())))
      Argument.Input {path} => run earlier.inputFile(run input(&path, authority))
      Argument.Output {name} => run earlier.outputFile(name.view())
      Argument.File {path} => run earlier.keyFile(run input(&path, authority))
      Argument.Tree {path} => run earlier.keyTree(run input(&path, authority))
    }
  }
  return move current
}

effect fn action(value: &Action, authority: &Authority) -> StepHandle ! StepFailure ? &mut Allocator {
  return match &value.* {
    Action.WriteFiles {files: declared} => {
      let step = run files(&declared, WriteFiles.make())
      run step.register()
    }
    Action.Run {invocation} => {
      if !authority.tools { fail StepError {message: run String.copy("this dependency is not authorized to run package tools")} }
      let launcher = match &authority.launcher {
        Option<Path>.Some {value: selected} => run RequestText.copy(Path.rawBytes(&selected))
        Option<Path>.None => { fail StepError {message: run String.copy("package tools require a supported operating-system sandbox")} }
      }
      let command = Run.artifact(run input(&invocation.program, authority))
      let described = run arguments(&invocation.arguments, move command, authority)
      let confined = run described.confinedBy(run Deferred<Path>.external(launcher.view()))
      run confined.register()
    }
  }
}

effect fn addPath(collector: &mut Collector, value: &Input, tree: bool, authority: &Authority) -> Option<usize>
! StepFailure ? &mut Allocator {
  let index = collector.paths.length()
  run collector.paths.append(run input(value, authority))
  run collector.trees.append(tree)
  return Option<usize>.some(index)
}

effect fn collect(previous: &Option<Box<Chain<Operation>>>, collector: &mut Collector, authority: &Authority)
-> () ! StepFailure ? &mut Allocator {
  if let Option<Box<Chain<Operation>>>.Some {value} = &previous.* {
    let node = &Box<Chain<Operation>>.get(&value)[0]
    run collect(&node.previous, &mut collector.*, authority)
    let mut requirement = Requirement {kind: String.make(), value: String.make(), mode: String.make(), weak: false, needed: false, path: Option<usize>.none()}
    match &node.value {
      Operation.Module {name, source} => {
        requirement.kind = run String.copy("module")
        requirement.value = run String.copy(name.view())
        requirement.path = run addPath(&mut collector.*, &source, false, authority)
      }
      Operation.Compile {language, source} => {
        requirement.kind = run String.copy("compile")
        requirement.value = run String.copy(language.view())
        requirement.path = run addPath(&mut collector.*, &source, false, authority)
      }
      Operation.Flag {value: flag} => { requirement.kind = run String.copy("flag") requirement.value = run String.copy(flag.view()) }
      Operation.Include {path} => {
        requirement.kind = run String.copy("include")
        requirement.path = run addPath(&mut collector.*, &path, true, authority)
      }
      Operation.LinkFile {kind, path} => {
        requirement.kind = run String.copy(kind.view())
        requirement.path = run addPath(&mut collector.*, &path, kind.view() == "search-path" || kind.view() == "framework-search-path", authority)
      }
      Operation.Link {kind, name, mode, weak, needed} => {
        requirement.kind = run String.copy(kind.view())
        requirement.value = run String.copy(name.view())
        requirement.mode = run String.copy(mode.view())
        requirement.weak = weak
        requirement.needed = needed
      }
      Operation.RPath {value: search} => { requirement.kind = run String.copy("rpath") requirement.value = run String.copy(search.view()) }
      Operation.FunctionOrder {path} => {
        requirement.kind = run String.copy("function-order")
        requirement.path = run addPath(&mut collector.*, &path, false, authority)
      }
    }
    run collector.requirements.append(move requirement)
  }
}

effect fn copyTexts(values: &[String]) -> List<String> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<String>.make()
  let mut at: usize = 0
  while at < values.length { run result.append(run String.copy(values[at].view())) at = at + 1 }
  return move result
}

impl Step for Collector {
  effect fn key(self: &Self, key: &mut Key) -> () ! StepFailure ? &mut Allocator {
    let metadata = run Deferred<List<Requirement>>.value(run copyRequirements(self.requirements.asSlice()))
    run key.value(&metadata)
    let paths = self.paths.asSlice()
    let trees = self.trees.asSlice()
    let mut at: usize = 0
    while at < paths.length {
      if trees[at] { run key.tree(&paths[at]) } else { run key.file(&paths[at]) }
      at = at + 1
    }
  }
  effect fn make(self: &Self, make: &mut Make) -> () ! StepFailure ? &mut Allocator {
    let requirements = self.requirements.asSlice()
    let paths = self.paths.asSlice()
    let mut flags = List<String>.make()
    let mut includes = List<String>.make()
    let mut at: usize = 0
    while at < requirements.length {
      let item = &requirements[at]
      if item.kind.view() == "flag" { run flags.append(run String.copy(item.value.view())) }
      if item.kind.view() == "include" {
        if let Option<usize>.Some {value} = &item.path {
          let resolved = run make.path(&paths[value])
          run includes.append(run RequestText.copy(Path.rawBytes(&resolved)))
        }
      }
      at = at + 1
    }
    let mut result = Resolved {modules: List<Module>.make(), native: Native {sources: List<NativeSource>.make(), link: List<LinkInput>.make(), functionOrder: Option<String>.none()}}
    at = 0
    while at < requirements.length {
      let item = &requirements[at]
      let mut resolved = run String.copy(item.value.view())
      let mut producer = Option<String>.none()
      if let Option<usize>.Some {value} = &item.path {
        let path = run make.path(&paths[value])
        resolved = run RequestText.copy(Path.rawBytes(&path))
        producer = run make.producer(&paths[value])
      }
      let kind = item.kind.view()
      if kind == "module" {
        run result.modules.append(Module {name: run String.copy(item.value.view()), source: move resolved, producer: move producer})
      } else if kind == "compile" {
        run result.native.sources.append(NativeSource {path: move resolved, language: run String.copy(item.value.view()), flags: run copyTexts(flags.asSlice()), include: run copyTexts(includes.asSlice())})
      } else if kind == "function-order" {
        if result.native.functionOrder.isSome() { fail StepError {message: run String.copy("a package plan declares more than one function-order file")} }
        result.native.functionOrder = Option<String>.some(move resolved)
      } else if kind != "flag" && kind != "include" {
        let mode = if item.mode.view() == "" { Option<String>.none() } else { Option<String>.some(run String.copy(item.mode.view())) }
        run result.native.link.append(LinkInput {kind: run String.copy(kind), value: move resolved, mode: move mode, weak: item.weak, needed: item.needed})
      }
      at = at + 1
    }
    return run make.value<Resolved>(&result)
  }
}

effect fn copyRequirements(values: &[Requirement]) -> List<Requirement> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<Requirement>.make()
  let mut at: usize = 0
  while at < values.length {
    let item = &values[at]
    run result.append(Requirement {kind: run String.copy(item.kind.view()), value: run String.copy(item.value.view()), mode: run String.copy(item.mode.view()), weak: item.weak, needed: item.needed, path: item.path})
    at = at + 1
  }
  return move result
}

// Static plans have no ambient argument/environment access. The graph only receives declared data.
struct PlanHost {directory: Bytes}
impl HostInput for PlanHost {
  effect fn argumentCount(self: &mut Self) -> usize ! HostInputError { return 0 }
  effect fn argument(self: &mut Self, index: usize) -> Option<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator { return Option<Bytes>.none() }
  effect fn variable(self: &mut Self, name: &[u8]) -> Option<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator { return Option<Bytes>.none() }
  effect fn variableNames(self: &mut Self) -> List<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator { return List<Bytes>.make() }
  effect fn workingDirectory(self: &mut Self) -> Bytes ! HostInputError | OutOfMemoryError ? &mut Allocator { return run Bytes.copy(self.directory.asSlice()) }
}

pub effect fn execute(plan: &Plan, directory: &Path, cache: &Path, tools: bool, supplied: List<String>) -> Resolved
! StepFailure | SpawnError | Cancelled ? &mut Allocator | &mut FileSystem {
  let launcher = if Sandbox.supported() { run Sandbox.launcher() } else { Option<Path>.none() }
  let mut grants = List<String>.make()
  let suppliedPaths = supplied.asSlice()
  let mut grant: usize = 0
  while grant < suppliedPaths.length {
    run grants.append(run hostPath(suppliedPaths[grant].view()))
    grant = grant + 1
  }
  let authority = Authority {tools: tools, launcher: move launcher, supplied: move grants}
  let mut collector = Collector {requirements: List<Requirement>.make(), paths: List<Deferred<Path>>.make(), trees: List<bool>.make()}
  run collect(&plan.steps, &mut collector, &authority)
  let handle = run Step.register(move collector)
  let executable = match move run silkExecutable() {
    Option<Path>.Some {value} => move value
    Option<Path>.None => { fail StepError {message: run String.copy("cannot identify the compiler executing the package plan")} }
  }
  let mut hash = Sha256.make()
  run Fingerprint.path(&mut hash, &executable, false)
  let identity = hash.finish()
  let runner = run Runner.make(run Path.fromBytes(Path.rawBytes(directory)), run Path.fromBytes(Path.rawBytes(cache)), &identity)
  let mut host = PlanHost {directory: run Bytes.copy(Path.rawBytes(directory))}
  let targets = [move handle]
  let outputs = run runner.execute(&targets, true) |> Effect.provideMut<HostInput>(&mut host)
  let file = run Path.join(&outputs.asSlice()[0], ".value.json")
  let bytes = run FileSystem.readFile(&file)
  return run SchemaJson.decode<Resolved>(bytes.asSlice())
}


effect fn silkExecutable() -> Option<Path> ! FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  return match move run CacheStamp.executablePath() {
    Option<Bytes>.Some {value} => Option<Path>.some(run Path.fromBytes(value.asSlice()))
    Option<Bytes>.None => Option<Path>.none()
  }
}
