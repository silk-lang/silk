//! Command-line paths normalize lexically and reject only text no path can spell.

import driver.CommandPath
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.filesystem { FileError, FileSystem, Path }
import silk.result { Result }
import silk.testing { AssertionError, Testing }
import silk.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn resolves(working: &Path, argument: &[u8], expected: &[u8]) -> bool
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let path = run CommandPath.resolve(working, argument)
  return same(Path.rawBytes(&path), expected)
}

effect fn rejects(working: &Path, argument: &[u8]) -> bool
  ? &mut Allocator {
  let resolved = run Effect.result(CommandPath.resolve(working, argument))
  return match move resolved {
    Result<Path, FileError | OutOfMemoryError>.Success { value: _ } => false
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError invalid => invalid.reason.code == FileSystem.invalidPath().code
      OutOfMemoryError exhausted => false
    }
  }
}

effect fn pathPolicy() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut Allocator {
  let working = run Path.make("/work/compiler")
  let parent = run resolves(&working, b"../packages/compiler/stdlib", b"/work/packages/compiler/stdlib")
  run Testing.expect(parent, "a parent-relative argument resolves against the working directory")
  let inner = run resolves(&working, b"./src/../main.silk", b"/work/compiler/main.silk")
  let trailing = run resolves(&working, b"out/", b"/work/compiler/out")
  let current = run resolves(&working, b".", b"/work/compiler")
  run Testing.expect(
    inner && trailing && current,
    "current-directory components and a trailing separator normalize away"
  )
  let absolute = run resolves(&working, b"/tmp/../opt/x", b"/opt/x")
  let root = run resolves(&working, b"/", b"/")
  run Testing.expect(absolute && root, "absolute arguments normalize from the root")
  let above = run rejects(&working, b"../../..")
  let empty = run rejects(&working, b"a//b")
  let doubled = run rejects(&working, b"//a")
  let encoded = run rejects(&working, b"bad\xff")
  run Testing.expect(
    above && empty && doubled && encoded,
    "climbing above the root, empty components and non-UTF-8 text are invalid paths"
  )
}

test effect fn commandPathsResolveLexically() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run pathPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}
