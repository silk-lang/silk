//! Host rename, which publishes a finished build output in one step.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.system.filesystem { Path }
import silk.mem.pointer { Pointer }
import silk.num.isize
import silk.num.u64
import silk.num.usize
import silk.collections.slice { Slice }
static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.host_path as WindowsHostPath
  import silk.core.option { Option }
  import silk.collections.list { List }
  @foreign(noCapture: ("from", "to"))
  unsafe extern "C" fn MoveFileExW(from: ?[*]const u16, to: ?[*]const u16, flags: u32) -> i32
  @foreign(noCapture: ("path"))
  unsafe extern "C" fn DeleteFileW(path: ?[*]const u16) -> i32
}
static if Intrinsic.targetOperatingSystem() == "wasi" {
  import silk.core.effect { Effect }
  import silk.core.result { Result }
  import silk.system.filesystem { FileError }
  import silk.platform.wasi.filesystem { WasiFileSystem }
}

@foreign(noCapture: ("oldPath", "newPath"))
unsafe extern "C" fn rename(
  oldPath: ?[*]const u8,
  newPath: ?[*]const u8
) -> i32

static if Intrinsic.targetOperatingSystem() != "windows" && Intrinsic.targetOperatingSystem() != "wasi" {
  @foreign(noCapture: ("path"))
  unsafe extern "C" fn chmod(
    path: ?[*]const u8,
    mode: u32
  ) -> i32
  @foreign(noCapture: ("path"))
  unsafe extern "C" fn open(
    path: ?[*]const u8,
    flags: i32,
    ...
  ) -> i32
  @foreign(noCapture: ("buf"))
  unsafe extern "C" fn pwrite(
    fd: i32,
    buf: ?[*]const u8,
    count: usize,
    offset: i64
  ) -> isize
  unsafe extern "C" fn close(fd: i32) -> i32
}

/// One contiguous byte range to write at `offset` inside an existing binary file.
pub struct FilePatch {
  /// Byte offset from the start of the file.
  pub offset: u64,
  /// Replacement bytes to write at `offset`.
  pub bytes: Bytes,
}

/// Result of attempting in-place binary patching via [`pwritePatches`].
pub enum PatchOutcome {
  /// All patch spans were written in place.
  Applied,
  /// Opening or writing failed (for example `ETXTBSY` on a running executable); caller should fall back to atomic replace.
  Busy,
  /// Target platform does not support in-place POSIX `pwrite`.
  Unsupported,
}

// The NUL-terminated host path of `path`.
effect fn host(path: &Path) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run Bytes.copy(Path.rawBytes(path))
  let ending: [u8; 1] = [0]
  run Bytes.append(&mut text, &ending)
  return move text
}

/// Marks `path` executable (`0755`) on POSIX hosts; returns true on hosts without POSIX mode bits.
pub effect fn makeExecutable(path: &Path) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" || Intrinsic.targetOperatingSystem() == "wasi" {
    drop path
    return true
  } else {
    let target = run host(path)
    return unsafe chmod(Pointer.fromSlice<u8>(Bytes.asSlice(&target)), 493) == 0
  }
}

/// Writes every patch span in `patches` directly into the existing file at `path` using POSIX
/// `pwrite`, leaving all untouched bytes intact. Returns [`PatchOutcome.Busy`] if the file cannot
/// be opened or written (such as `ETXTBSY` when the executable is currently running).
pub effect fn pwritePatches(path: &Path, patches: &[FilePatch]) -> PatchOutcome
  ! OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" || Intrinsic.targetOperatingSystem() == "wasi" {
    drop path
    drop patches
    return PatchOutcome.Unsupported
  } else {
    let target = run host(path)
    // `O_RDWR == 2` on both Linux and macOS.
    let fd = unsafe open(Pointer.fromSlice<u8>(Bytes.asSlice(&target)), 2)
    if fd < 0 {
      return PatchOutcome.Busy
    }
    let mut pi = usize.ZERO
    while pi < patches.length {
      let data = Bytes.asSlice(&patches[pi].bytes)
      let mut written = usize.ZERO
      while written < data.length {
        let rem = Slice.view<u8>(data, written, data.length - written)
        let off = u64.toI64(patches[pi].offset + usize.toU64(written))
        let n = unsafe pwrite(fd, Pointer.fromSlice<u8>(rem), rem.length, off)
        if n <= 0 {
          drop unsafe close(fd)
          return PatchOutcome.Busy
        }
        written = written + isize.toUsize(n)
      }
      pi = pi + usize.ONE
    }
    if unsafe close(fd) != 0 {
      return PatchOutcome.Busy
    }
    return PatchOutcome.Applied
  }
}

/// Renames `from` to `to` in one step, replacing a file at `to`; false when that fails.
pub effect fn replaceFile(from: &Path, to: &Path) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let source = match move run WindowsHostPath.wide(from) {
      Option<List<u16>>.Some {value} => move value
      Option<List<u16>>.None => { return false }
    }
    let destination = match move run WindowsHostPath.wide(to) {
      Option<List<u16>>.Some {value} => move value
      Option<List<u16>>.None => { return false }
    }
    // REPLACE_EXISTING, without COPY_ALLOWED: a cross-volume operation must fail atomically.
    if unsafe MoveFileExW(Pointer.fromSlice(List<u16>.asSlice(&source)),
      Pointer.fromSlice(List<u16>.asSlice(&destination)), 1) != 0 {
      return true
    }

    // Windows cannot replace a running executable, such as a tasks program whose task runs `silk
    // test` in its own package, but it can rename one. Move it aside to `<to>.old`, removing the
    // one an earlier publish left once nothing runs it, and publish in its place.
    let named = List<u16>.asSlice(&destination)
    let mut aside = List<u16>.make()
    run List<u16>.appendSlice(&mut aside, Slice.view<u16>(named, 0, named.length - 1))
    run List<u16>.appendSlice(&mut aside, &[46, 111, 108, 100, 0])
    drop unsafe DeleteFileW(Pointer.fromSlice(List<u16>.asSlice(&aside)))
    if unsafe MoveFileExW(Pointer.fromSlice(List<u16>.asSlice(&destination)),
      Pointer.fromSlice(List<u16>.asSlice(&aside)), 0) == 0 {
      return false
    }
    if unsafe MoveFileExW(Pointer.fromSlice(List<u16>.asSlice(&source)),
      Pointer.fromSlice(List<u16>.asSlice(&destination)), 1) != 0 {
      return true
    }

    // Put the old file back so a failed publish leaves `to` as it was.
    drop unsafe MoveFileExW(Pointer.fromSlice(List<u16>.asSlice(&aside)),
      Pointer.fromSlice(List<u16>.asSlice(&destination)), 0)
    return false
  }
  static if Intrinsic.targetOperatingSystem() == "wasi" {
    // The machine namespace of a WASI build is the guest directory preopened as `/`.
    return match run Effect.result(WasiFileSystem.rename(b"/", Path.rawBytes(from), Path.rawBytes(to))) {
      Result<(), FileError>.Success {..} => true
      Result<(), FileError>.Failure {..} => false
    }
  } else {
    let source = run host(from)
    let destination = run host(to)
    let status = unsafe rename(
      Pointer.fromSlice<u8>(Bytes.asSlice(&source)),
      Pointer.fromSlice<u8>(Bytes.asSlice(&destination)),
    )
    return status == 0
  }
}
