//! POSIX `rename`, which publishes a finished build output in one step.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.system.filesystem { Path }
import silk.mem.pointer { Pointer }

unsafe extern "C" fn rename(
  oldPath: ?[*]const u8,
  newPath: ?[*]const u8
) -> i32 with Intrinsic.foreign(noCapture: ("oldPath", "newPath"))

// The NUL-terminated host path of `path`.
effect fn host(path: &Path) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run Bytes.copy(Path.rawBytes(path))
  let ending: [u8; 1] = [0]
  run Bytes.append(&mut text, &ending)
  return move text
}

/// Renames `from` to `to` in one step, replacing a file at `to`; false when that fails.
pub effect fn replaceFile(from: &Path, to: &Path) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let source = run host(from)
  let destination = run host(to)
  let status = unsafe rename(
    Pointer.fromSlice<u8>(Bytes.asSlice(&source)),
    Pointer.fromSlice<u8>(Bytes.asSlice(&destination)),
  )
  return status == 0
}
