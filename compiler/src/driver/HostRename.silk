//! Host rename, which publishes a finished build output in one step.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.system.filesystem { Path }
import silk.mem.pointer { Pointer }
static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.host_path as WindowsHostPath
  import silk.core.option { Option }
  import silk.collections.list { List }
  @foreign(noCapture: ("from", "to"))
  unsafe extern "C" fn MoveFileExW(from: ?[*]const u16, to: ?[*]const u16, flags: u32) -> i32
}

@foreign(noCapture: ("oldPath", "newPath"))
unsafe extern "C" fn rename(
  oldPath: ?[*]const u8,
  newPath: ?[*]const u8
) -> i32

// The NUL-terminated host path of `path`.
effect fn host(path: &Path) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run Bytes.copy(Path.rawBytes(path))
  let ending: [u8; 1] = [0]
  run Bytes.append(&mut text, &ending)
  return move text
}

/// Renames `from` to `to` in one step, replacing a file at `to`; false when that fails.
pub effect fn replaceFile(from: &Path, to: &Path) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let source = match move run WindowsHostPath.wide(from) {
      Option<List<u16>>.Some {value} => move value
      Option<List<u16>>.None => { return false }
    }
    let destination = match move run WindowsHostPath.wide(to) {
      Option<List<u16>>.Some {value} => move value
      Option<List<u16>>.None => { return false }
    }
    // REPLACE_EXISTING, without COPY_ALLOWED: a cross-volume operation must fail atomically.
    return unsafe MoveFileExW(Pointer.fromSlice(List<u16>.asSlice(&source)),
      Pointer.fromSlice(List<u16>.asSlice(&destination)), 1) != 0
  }
  let source = run host(from)
  let destination = run host(to)
  let status = unsafe rename(
    Pointer.fromSlice<u8>(Bytes.asSlice(&source)),
    Pointer.fromSlice<u8>(Bytes.asSlice(&destination)),
  )
  return status == 0
}
