//! Running the toolchain a project pins.
//!
//! Before any command, `silk` selects a version (`Toolchains.select`). When that is not the running
//! compiler, it replaces itself with the installed toolchain and sets `SILK_TOOLCHAIN` to the
//! toolchain's full version, so the replacement selects itself and runs the command. When the
//! selected toolchain is not installed, the command exits 3 and names the install command, unless
//! automatic installs are on (`SILK_AUTO_INSTALL=1` or `auto-install = true` in settings.toml).
//!
//! A compiler built locally (version `0.0.0`) follows only `silk +<version>`, so working on the
//! compiler never runs a toolchain some project pins. `SILK_TOOLCHAIN=local` keeps any compiler on
//! itself, and `silk toolchain` always runs in the compiler it starts in.

import driver.Project as Projects
import driver.ToolchainCommand as ToolchainCommands { Context }
import driver.Toolchains as Toolchains { Origin, Selection }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.filesystem { FileError, FileSystem, Path }
import silk.option { Option }
import silk.slice { Slice }
import silk.usize

/// What `silk` does before running a command.
pub enum Action {
  /// Run the command in this compiler.
  Stay,
  /// Replace this process with `Dispatch.executable`.
  Replace,
  /// Exit with `Dispatch.status`, printing `Dispatch.errors`.
  Exit,
}

/// The decision for one command line.
pub struct Dispatch {
  pub action: Action

  /// The executable to run, for `Replace`.
  pub executable: Bytes

  /// The `SILK_TOOLCHAIN` value the replacement runs with, for `Replace`.
  pub version: Bytes

  /// How many leading arguments the replacement does not receive: 1 for a `+<version>` argument.
  pub skip: usize

  pub status: i32
  pub errors: Bytes

  /// The selected version that is not installed, for `Exit` with status 3.
  pub missing: Bytes
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn stay() -> Dispatch {
  return Dispatch {
    action: Action.Stay,
    executable: Bytes.make(),
    version: Bytes.make(),
    skip: usize.ZERO,
    status: 0,
    errors: Bytes.make(),
    missing: Bytes.make(),
  }
}

effect fn exit(status: i32, errors: Bytes, missing: Bytes) -> Dispatch
  ! OutOfMemoryError
  ? &mut Allocator {
  return Dispatch {
    action: Action.Exit,
    executable: Bytes.make(),
    version: Bytes.make(),
    skip: usize.ZERO,
    status: status,
    errors: move errors,
    missing: move missing,
  }
}

// The text after the leading `+` of `argument`, or `None` when it is not a `+<version>` argument.
fn requestedVersion(argument: &[u8]) -> Option<&[u8]> {
  if argument.length < usize.add(0, 2) || argument[usize.ZERO] != 43 {
    return Option<&[u8]>.none()
  }
  return Option<&[u8]>.some(Slice.view<u8>(argument, usize.ONE, argument.length - usize.ONE))
}

// The message for a selected toolchain that is not installed.
effect fn notInstalled(selected: &Selection) -> Bytes
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let version = Bytes.asSlice(&selected.version)
  let mut errors = run Bytes.copy(b"silk: Silk ")
  run Bytes.append(&mut errors, version)
  run Bytes.append(&mut errors, b" (")
  run ToolchainCommands.because(selected, &mut errors)
  run Bytes.append(&mut errors, b") is not installed.\nInstall it with: ")
  let install = run ToolchainCommands.installCommand(version)
  run Bytes.append(&mut errors, Bytes.asSlice(&install))
  run Bytes.append(&mut errors, b"\n")
  return move errors
}

/// Decides how to run the command line `arguments`, which excludes argument zero.
pub effect fn decide(context: &Context, arguments: &[Bytes]) -> Dispatch
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut requested = Option<&[u8]>.none()
  if arguments.length > usize.ZERO {
    requested = requestedVersion(Bytes.asSlice(&arguments[usize.ZERO]))
  }
  let explicit = match &requested {
    Option<&[u8]>.Some { value } => true
    Option<&[u8]>.None => false
  }
  if let Option<&[u8]>.Some { value } = &requested {
    if !Projects.isSemanticVersion(value) {
      let mut errors = run Bytes.copy(b"silk: `+")
      run Bytes.append(&mut errors, value)
      run Bytes.append(
        &mut errors,
        b"` is not a Silk version; +<version> takes a semantic version such as +0.1.0-dev.6\n"
      )
      return run exit(2, move errors, Bytes.make())
    }
  }
  if !explicit {
    if Toolchains.unpinned(Bytes.asSlice(&context.running)) {
      return stay()
    }
    if arguments.length > usize.ZERO && same(Bytes.asSlice(&arguments[usize.ZERO]), b"toolchain") {
      return stay()
    }
  }
  let mut environment = Option<&[u8]>.none()
  if let Option<Bytes>.Some { value } = &context.environment {
    if same(Bytes.asSlice(&value), b"local") {
      if !explicit {
        return stay()
      }
    } else {
      environment = Option<&[u8]>.some(Bytes.asSlice(&value))
    }
  }
  let home = match &context.home {
    Option<Path>.Some { value } => Option<&Path>.some(&value)
    Option<Path>.None => Option<&Path>.none()
  }
  let selected = run Toolchains.select(
    &context.working,
    move requested,
    move environment,
    move home,
    Bytes.asSlice(&context.running)
  )
  if selected.origin == Origin.Running {
    return stay()
  }
  let current = Toolchains.matches(Bytes.asSlice(&selected.version), Bytes.asSlice(&context.running))
  if current && !explicit {
    return stay()
  }
  let executable = match move run ToolchainCommands.located(context, &selected) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return run exit(
        ToolchainCommands.NOT_INSTALLED,
        run notInstalled(&selected),
        run Bytes.copy(Bytes.asSlice(&selected.version))
      )
    }
  }

  // An installed toolchain that does not report the version it is installed under would select
  // itself again; run the command in it rather than replacing it with itself forever.
  if !explicit {
    if let Option<Bytes>.Some { value } = &context.runningExecutable {
      if same(Bytes.asSlice(&value), Bytes.asSlice(&executable)) {
        return stay()
      }
    }
  }
  let mut skip = usize.ZERO
  if explicit {
    skip = usize.ONE
  }
  let mut version = run Bytes.copy(Bytes.asSlice(&selected.version))
  if !current {
    if let Option<Path>.Some { value: root } = &context.home {
      if let Option<Bytes>.Some { value } = move run Toolchains.find(&root, Bytes.asSlice(&selected.version)) {
        version = move value
      }
    }
  }
  return Dispatch {
    action: Action.Replace,
    executable: move executable,
    version: move version,
    skip: skip,
    status: 0,
    errors: Bytes.make(),
    missing: Bytes.make(),
  }
}
