//! The machine's processes, with each one the compiler runs as a span of its trace.

import Tracing
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.system.child_process {ChildProcess, ProcessError, ProcessOutcome, ProcessRequest}
import silk.system.child_process_native {OsChildProcess}
import silk.trace {SpanKind, Trace}

/// The `ChildProcess` provider of the compiler: the machine's own, with every run under a
/// `process` span that names the program and its exit status. A run is traced wherever it
/// starts, so no caller opens the span itself.
pub struct TracedProcess {
  machine: OsChildProcess,
}

impl TracedProcess {
  /// Returns a provider. It does not allocate or start a process.
  pub fn make() -> TracedProcess {
    return TracedProcess {machine: OsChildProcess.make()}
  }

  effect fn execute(self: &mut TracedProcess, request: &ProcessRequest) -> ProcessOutcome
  ! ProcessError | OutOfMemoryError
  ? &mut Allocator {
    let _traced = Trace.spanOf("process", SpanKind.Client)
    Trace.set("program", &Tracing.leaf(ChildProcess.program(request)))
    let outcome = run ChildProcess.submit(request) |> Effect.provideMut<ChildProcess>(&mut self.machine)
    if let Option<i32>.Some {value} = move ChildProcess.exitCode(&outcome) {
      Trace.set("exit", &value)
    }
    return move outcome
  }
}

impl ChildProcess for TracedProcess {
  execute: TracedProcess.execute
}
