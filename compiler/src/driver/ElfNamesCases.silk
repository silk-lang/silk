//! A linked ELF executable's static symbols take the readable names a build lists, and the rest of
//! the file keeps its meaning.

import driver.ElfNames
import driver.WasmNames {FunctionNames}
import silk.collections.bytes {Bytes}
import silk.collections.slice {Slice}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.testing.testing {AssertionError, Testing}
import silk.num.u8
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn appendNumber(output: &mut Bytes, value: usize, width: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut rest = value
  let mut at = usize.ZERO
  while at < width {
    run Bytes.append(&mut output.*, &[usize.toU8(rest & 255)])
    rest = usize.shiftRight(rest, 8)
    at = at + usize.ONE
  }
}

fn number(bytes: &[u8], at: usize, width: usize) -> usize {
  let mut value = usize.ZERO
  let mut index = width
  while index > usize.ZERO {
    index = index - usize.ONE
    value = usize.shiftLeft(value, 8) | u8.toUsize(bytes[at + index])
  }
  return value
}

effect fn appendSymbol(output: &mut Bytes, name: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  run appendNumber(&mut output.*, name, 4)
  run Bytes.append(&mut output.*, &[18, 0])
  run appendNumber(&mut output.*, usize.ONE, 2)
  run appendNumber(&mut output.*, usize.ZERO, 16)
}

effect fn appendHeader(output: &mut Bytes, name: usize, kind: usize, offset: usize, size: usize, link: usize, entry: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  run appendNumber(&mut output.*, name, 4)
  run appendNumber(&mut output.*, kind, 4)
  run appendNumber(&mut output.*, usize.ZERO, 16)
  run appendNumber(&mut output.*, offset, 8)
  run appendNumber(&mut output.*, size, 8)
  run appendNumber(&mut output.*, link, 4)
  run appendNumber(&mut output.*, usize.ZERO, 12)
  run appendNumber(&mut output.*, entry, 8)
}

// A section-only ELF64 file: a symbol table of the null symbol, `silk_aa`, `_start` and
// `silk_aa.cold.1` (a part LLVM split off `silk_aa`), the
// section names, and the symbols' names, then the four section headers. With `stringsLast` the
// symbols' names end the data, as a linker lays them out; otherwise the section names do.
effect fn image(stringsLast: bool) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let sectionNames = b"\x00.symtab\x00.shstrtab\x00.strtab\x00"
  let symbolNames = b"\x00silk_aa\x00_start\x00silk_aa.cold.1\x00"
  let symbols: usize = 64
  let data = symbols + 96
  let mut namesAt = data
  let mut stringsAt = data + sectionNames.length
  if !stringsLast {
    stringsAt = data
    namesAt = data + symbolNames.length
  }
  let mut headers = data + sectionNames.length + symbolNames.length
  while headers % 8 != usize.ZERO { headers = headers + usize.ONE }
  let mut output = Bytes.make()
  run Bytes.append(&mut output, &[127, 69, 76, 70, 2, 1, 1, 0])
  run appendNumber(&mut output, usize.ZERO, 8)
  run appendNumber(&mut output, 2, 2)
  run appendNumber(&mut output, 62, 2)
  run appendNumber(&mut output, usize.ONE, 4)
  run appendNumber(&mut output, usize.ZERO, 16)
  run appendNumber(&mut output, headers, 8)
  run appendNumber(&mut output, usize.ZERO, 4)
  run appendNumber(&mut output, 64, 2)
  run appendNumber(&mut output, 56, 2)
  run appendNumber(&mut output, usize.ZERO, 2)
  run appendNumber(&mut output, 64, 2)
  run appendNumber(&mut output, 4, 2)
  run appendNumber(&mut output, 2, 2)
  run appendNumber(&mut output, usize.ZERO, 24)
  run appendSymbol(&mut output, usize.ONE)
  run appendSymbol(&mut output, 9)
  run appendSymbol(&mut output, 16)
  if stringsLast {
    run Bytes.append(&mut output, sectionNames)
    run Bytes.append(&mut output, symbolNames)
  } else {
    run Bytes.append(&mut output, symbolNames)
    run Bytes.append(&mut output, sectionNames)
  }
  while Bytes.length(&output) < headers { run Bytes.append(&mut output, &[0]) }
  run appendNumber(&mut output, usize.ZERO, 64)
  run appendHeader(&mut output, usize.ONE, 2, symbols, 96, 3, 24)
  run appendHeader(&mut output, 9, 3, namesAt, sectionNames.length, usize.ZERO, usize.ZERO)
  run appendHeader(&mut output, 19, 3, stringsAt, symbolNames.length, usize.ZERO, usize.ZERO)
  return move output
}

// The name of symbol `entry`, read through the file's own headers.
fn symbolName(file: &[u8], entry: usize) -> &[u8] {
  let headers = number(file, 40, 8)
  let symbols = number(file, headers + 64 + 24, 8)
  let strings = number(file, headers + 3 * 64 + 24, 8)
  let start = strings + number(file, symbols + entry * 24, 4)
  let mut end = start
  while file[end] != 0 { end = end + usize.ONE }
  return Slice.view<u8>(file, start, end - start)
}

// The name of section `section`, read through the section header string table.
fn sectionName(file: &[u8], section: usize) -> &[u8] {
  let headers = number(file, 40, 8)
  let names = number(file, headers + 2 * 64 + 24, 8)
  let start = names + number(file, headers + section * 64, 4)
  let mut end = start
  while file[end] != 0 { end = end + usize.ONE }
  return Slice.view<u8>(file, start, end - start)
}

test effect fn listedSymbolsTakeTheirReadableNames() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run renameClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn renameClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut names = FunctionNames.make()
  run FunctionNames.add(&mut names, b"silk_aa", b"app:src/main.silk::Parser.next")
  run layoutClaims(&names, true)
  run layoutClaims(&names, false)
  let mut unlisted = FunctionNames.make()
  run FunctionNames.add(&mut unlisted, b"silk_bb", b"app:src/main.silk::other")
  let untouched = run image(true)
  run Testing.expect(
    Option<Bytes>.isNone(&run ElfNames.rename(Bytes.asSlice(&untouched), &unlisted))
      && Option<Bytes>.isNone(&run ElfNames.rename(b"\x00asm\x01\x00\x00\x00", &names)),
    "a file that lists none of the symbols, or is not ELF, is left as it is",
  )
}

// The renamed file of an image whose symbol names end its data (`stringsLast`) or do not.
effect fn layoutClaims(names: &FunctionNames, stringsLast: bool) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let original = run image(stringsLast)
  let result = run ElfNames.rename(Bytes.asSlice(&original), names)
  run Testing.expect(Option<Bytes>.isSome(&result), "a listed symbol is renamed")
  let renamed = match move result {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => Bytes.make()
  }
  let file = Bytes.asSlice(&renamed)
  run Testing.expect(
    same(symbolName(file, usize.ONE), b"app:src/main.silk::Parser.next") && same(symbolName(file, 2), b"_start")
      && same(symbolName(file, 3), b"app:src/main.silk::Parser.next.cold.1"),
    "a listed symbol takes its readable name, a part split off it keeps its suffix, and an unlisted one keeps its own",
  )
  run Testing.expect(
    same(sectionName(file, usize.ONE), b".symtab") && same(sectionName(file, 3), b".strtab"),
    "the section names still read through the untouched section header string table",
  )
  let input = Bytes.asSlice(&original)
  let oldStrings = number(input, number(input, 40, 8) + 3 * 64 + 24, 8)
  let newStrings = number(file, number(file, 40, 8) + 3 * 64 + 24, 8)
  run Testing.expect((newStrings == oldStrings) == stringsLast, "trailing symbol names are replaced where they were; others are appended")
}
