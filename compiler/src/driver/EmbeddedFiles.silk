//! The files a module embeds, found by syntax so the build can publish them before semantic
//! analysis reads them.
//!
//! # Details
//! A call reads a file when its callee is `Intrinsic.embed`, `Intrinsic.embedText`, or one of the
//! standard library's `Source.read` and `Source.text`, and its first argument is
//! a string literal. That literal is the path, relative to the package's directory, of a file
//! [`ModuleSources`](driver/ModuleSources) publishes under the module identity of origin `embed`.
//! A path built any other way names no file the build publishes, and the read is refused.

import hir.Hir {HirId, Module, Node}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.collections.slice {Slice}
import silk.num.usize
import silk.collections.list {List}

/// The marker before an embedded path in an import summary's paths: no import path holds a colon.
pub fn marker() -> &'static [u8] { return b"embed:" }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

// The name a `Name` node spells, or none.
fn nameOf(hir: &Module, id: HirId) -> Option<&[u8]> {
  return match Module.node(hir, id) {
    Node.Name {text} => Option<&[u8]>.some(Module.text(hir, text))
    Node.IdentifierExpression {name, ..} => nameOf(hir, name)
    _ => Option<&[u8]>.none()
  }
}

// Whether a callee written as `owner.member` reads a file.
fn reads(owner: &[u8], member: &[u8]) -> bool {
  if same(owner, b"Intrinsic") { return same(member, b"embed") || same(member, b"embedText") }
  if same(owner, b"Source") { return same(member, b"read") || same(member, b"text") }
  return false
}

// Whether `callee` names a call that reads a file: `owner.member` as a field projection or a path.
fn readsFile(hir: &Module, callee: HirId) -> bool {
  return match Module.node(hir, callee) {
    Node.FieldExpression {subject, field} => {
      let owner = match move nameOf(hir, subject) {
        Option<&[u8]>.Some {value} => value
        Option<&[u8]>.None => { return false }
      }
      return match move nameOf(hir, field) {
        Option<&[u8]>.Some {value} => reads(owner, value)
        Option<&[u8]>.None => false
      }
    }
    Node.MemberExpression {selector, ..} => readsFile(hir, selector)
    Node.Path {segments} => {
      if segments.length < 2 { return false }
      let owner = match move nameOf(hir, Module.child(hir, segments, segments.length - 2)) {
        Option<&[u8]>.Some {value} => value
        Option<&[u8]>.None => { return false }
      }
      return match move nameOf(hir, Module.child(hir, segments, segments.length - usize.ONE)) {
        Option<&[u8]>.Some {value} => reads(owner, value)
        Option<&[u8]>.None => false
      }
    }
    _ => false
  }
}

/// Appends to `paths`, after [`marker`], the path each file-reading call in `hir` writes, once each.
pub effect fn append(hir: &Module, paths: &mut List<Bytes>) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = Module.length(hir)
  let mut at = usize.ZERO
  while at < count {
    if let Node.CallExpression {callee, arguments, ..} = Module.node(hir, HirId {index: at}) {
      if arguments.length > usize.ZERO && readsFile(hir, callee) {
        if let Node.TextLiteral {value} = Module.node(hir, Module.child(hir, arguments, usize.ZERO)) {
          let mut written = run Bytes.copy(marker())
          run Bytes.append(&mut written, Module.text(hir, value))
          let listed = List<Bytes>.asSlice(&paths.*)
          let mut known = false
          let mut seen = usize.ZERO
          while seen < listed.length {
            if same(Bytes.asSlice(&listed[seen]), Bytes.asSlice(&written)) { known = true }
            seen = seen + usize.ONE
          }
          if !known { run List<Bytes>.append(&mut paths.*, move written) }
        }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

/// The embedded path a summary path names after [`marker`], or none for an import path.
pub fn embedded(path: &[u8]) -> Option<&[u8]> {
  let prefix = marker()
  if path.length < prefix.length { return Option<&[u8]>.none() }
  let mut at = usize.ZERO
  while at < prefix.length {
    if path[at] != prefix[at] { return Option<&[u8]>.none() }
    at = at + usize.ONE
  }
  return Option<&[u8]>.some(Slice.view<u8>(path, prefix.length, path.length - prefix.length))
}
