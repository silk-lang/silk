//! `silk check --roots`: compares the rejections `silk check` reports, from the module check
//! roots each module keeps (the ones the language server uses too), with one check of the whole
//! package, whose escape walk crosses every module, by module, code and span.

import diagnostic.JsonText
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.Query {Cycle}
import semantic.Rejection as Rejections {Rejection, RejectionCode}
import semantic.Semantic {Request as SemanticRequest, Semantic}
import semantic.SourceIndex {RevisionMismatch}
import semantic.Types {Types}
import lexer.Span {Span}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.mem.shared {Shared}
import silk.num.usize

/// The lines `compare` writes and how many rejections only one side reached.
pub struct Comparison {
  pub report: Bytes,
  pub differences: usize,
}

/// Checks `rootPackage` again with `Semantic.wholePackageCheck` and compares its distinct rejection
/// sites with `roots`, what `Semantic.checkDeclarations` reported for the same package through
/// each module's own check.
///
/// The report holds one `silk-check-roots only=package|roots <module> <code> <start>-<end>` line
/// per site only one side reached, then `silk-check-roots modules=<count> rejections=<count>
/// differences=<count>`.
pub effect fn compare(
  store: &mut Semantic,
  request: &mut SemanticRequest,
  rootPackage: &[ModuleId],
  runtime: &Option<ModuleId>,
  roots: &[Shared<Rejection>],
) -> Comparison
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let whole = run Semantic.wholePackageCheck(&mut store.*, &mut request.*, rootPackage, runtime)
  let mut rooted = List<Bytes>.make()
  run addSites(&mut rooted, roots)
  let mut package = List<Bytes>.make()
  run addSites(&mut package, List<Shared<Rejection>>.asSlice(&whole.rejections))
  let mut report = Bytes.make()
  let onlyPackage = run unmatched(&mut report, b"package", List<Bytes>.asSlice(&package), List<Bytes>.asSlice(&rooted))
  let onlyRoots = run unmatched(&mut report, b"roots", List<Bytes>.asSlice(&rooted), List<Bytes>.asSlice(&package))
  let differences = onlyPackage + onlyRoots
  run Bytes.append(&mut report, b"silk-check-roots modules=")
  run JsonText.appendDecimal(&mut report, rootPackage.length)
  run Bytes.append(&mut report, b" rejections=")
  run JsonText.appendDecimal(&mut report, List<Bytes>.length(&package))
  run Bytes.append(&mut report, b" differences=")
  run JsonText.appendDecimal(&mut report, differences)
  run Bytes.append(&mut report, b"\n")
  return Comparison { report: move report, differences: differences }
}

// Adds each rejection's `<module> <code> <start>-<end>` site to `sites` unless it is listed.
effect fn addSites(sites: &mut List<Bytes>, rejections: &[Shared<Rejection>]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < rejections.length {
    let site = run siteOf(&rejections[at])
    if !listed(List<Bytes>.asSlice(&sites.*), Bytes.asSlice(&site)) {
      run List<Bytes>.append(&mut sites.*, move site)
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn siteOf(rejection: &Shared<Rejection>) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let code = Shared<Rejection>.with<RejectionCode>(rejection, fn(held: &Rejection) -> RejectionCode { return held.code })
  let span = Shared<Rejection>.with<Span>(rejection, fn(held: &Rejection) -> Span { return held.span })
  let module = Shared<Rejection>.with<ModuleId>(rejection, fn(held: &Rejection) -> ModuleId { return ModuleId.copy(&held.module) })
  let mut site = Bytes.make()
  run ModuleId.appendPath(&module, &mut site)
  run Bytes.append(&mut site, b" ")
  run Bytes.append(&mut site, Rejections.stableCode(code))
  run Bytes.append(&mut site, b" ")
  run JsonText.appendDecimal(&mut site, span.start)
  run Bytes.append(&mut site, b"-")
  run JsonText.appendDecimal(&mut site, span.end)
  return move site
}

// Writes one line for each of `sites` that `others` does not list, and answers how many.
effect fn unmatched(report: &mut Bytes, side: &[u8], sites: &[Bytes], others: &[Bytes]) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < sites.length {
    if !listed(others, Bytes.asSlice(&sites[at])) {
      run Bytes.append(&mut report.*, b"silk-check-roots only=")
      run Bytes.append(&mut report.*, side)
      run Bytes.append(&mut report.*, b" ")
      run Bytes.append(&mut report.*, Bytes.asSlice(&sites[at]))
      run Bytes.append(&mut report.*, b"\n")
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn listed(sites: &[Bytes], site: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < sites.length {
    if same(Bytes.asSlice(&sites[at]), site) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}
