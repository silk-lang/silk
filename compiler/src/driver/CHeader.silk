//! C declarations from checked export signatures, before ABI lowering changes their parameters.
import backend.EmissionPlan { EmissionPlan }
import driver.NativeLinkInput { InvalidNativeLinkInput, invalid }
import hir.Hir { Access, OwnerKind }
import semantic.DeclarationId { DeclarationId }
import semantic.ModuleId { InvalidModulePath }
import semantic.Query { Cycle }
import semantic.Semantic { Semantic, Request, Answer, Outcome, Value, Signature }
import semantic.SourceIndex { NoRejection, RevisionMismatch }
import semantic.StaticValue { IntegerType }
import semantic.Type { Type }
import semantic.Types { Types }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.interned { Interned }
import silk.mem.shared { Shared }
import silk.num.u64
import silk.num.usize
import silk.collections.slice { Slice }

type Failure = InvalidNativeLinkInput
  | Cycle
  | InvalidModulePath
  | RevisionMismatch
  | OutOfMemoryError

struct Context {
  types: List<Interned<Type>>,
  names: List<Bytes>,
  forward: Bytes,
  definitions: Bytes
}

/// Writes a self-contained C/C++ header for every authored C export in the emission plan.
/// Aggregate and callback declarations use semantic types, preserving the C source signature.
pub effect fn render(store: &mut Semantic, request: &mut Request, plan: &EmissionPlan) -> Bytes
  ! Failure
  ? &mut Allocator | &mut Types {
  let mut context = Context {
    types: List<Interned<Type>>.make(),
    names: List<Bytes>.make(),
    forward: Bytes.make(),
    definitions: Bytes.make(),
  }
  let mut declarations = Bytes.make()
  let mut at: usize = 0
  while at < plan.symbolCount() {
    if plan.identityFamily(at) == b"export" {
      if !identifier(plan.identitySymbol(at)) {
        run invalid(b"a C header export must have a C/C++ identifier that is not a keyword")
      }
      let answer = run store.demandSignatureOf(&mut request.*, plan.identityDeclaration(at))
      let result = Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(
        &answer,
        |fact: &Result<Answer, NoRejection>| -> Option<Interned<Type>> {
          if let Option<&Signature>.Some { value } = signature(fact) {
            return Option<Interned<Type>>.some(Interned<Type>.clone(&value.result))
          }
          return Option<Interned<Type>>.none()
        },
      )
      let ty = match move result {
        Option<Interned<Type>>.Some { value } => move value
        _ => {
          run invalid(b"cannot read the checked C export signature")
        }
      }
      let resultName = run typeName(&mut context, &mut store.*, &mut request.*, &ty)
      run declarations.append(resultName.asSlice())
      run declarations.append(b" ")
      run declarations.append(plan.identitySymbol(at))
      run declarations.append(b"(")
      let count = Shared<Result<Answer, NoRejection>>.with<usize>(
        &answer,
        |fact: &Result<Answer, NoRejection>| -> usize {
          if let Option<&Signature>.Some { value } = signature(fact) {
            return value.parameters.length()
          }
          return 0
        },
      )
      let mut parameter: usize = 0
      while parameter < count {
        let found = Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(
          &answer,
          |fact: &Result<Answer, NoRejection>| -> Option<Interned<Type>> {
            if let Option<&Signature>.Some { value } = signature(fact) {
              return Option<Interned<Type>>.some(
                Interned<Type>.clone(&value.parameters.asSlice()[parameter]),
              )
            }
            return Option<Interned<Type>>.none()
          },
        )
        let parameterType = match move found {
          Option<Interned<Type>>.Some { value } => move value
          _ => {
            run invalid(b"missing C export parameter")
          }
        }
        if parameter > 0 {
          run declarations.append(b", ")
        }
        let named = run typeName(&mut context, &mut store.*, &mut request.*, &parameterType)
        run declarations.append(named.asSlice())
        run declarations.append(b" p")
        run number(&mut declarations, usize.toU64(parameter))
        parameter = parameter + 1
      }
      let variadic = Shared<Result<Answer, NoRejection>>.with<bool>(
        &answer,
        |fact: &Result<Answer, NoRejection>| -> bool {
          if let Option<&Signature>.Some { value } = signature(fact) {
            return value.isVariadic
          }
          return false
        },
      )
      if variadic {
        run declarations.append(b", ...")
      } else if count == 0 {
        run declarations.append(b"void")
      }
      run declarations.append(b");\n")
    }
    at = at + 1
  }
  let mut output = run Bytes.copy(
    b"#pragma once\n#include <stdint.h>\n#include <stddef.h>\n#include <stdbool.h>\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n",
  )
  run output.append(context.forward.asSlice())
  run output.append(context.definitions.asSlice())
  run output.append(declarations.asSlice())
  run output.append(b"\n#ifdef __cplusplus\n}\n#endif\n")
  return move output
}

fn identifier(value: &[u8]) -> bool {
  if value.length == 0 {
    return false
  }
  let mut at: usize = 0
  while at < value.length {
    let byte = value[at]
    if !((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
      || (at > 0 && byte >= 48 && byte <= 57)) {
      return false
    }
    at = at + 1
  }
  let keywords = b"alignas alignof and and_eq asm atomic_cancel atomic_commit atomic_noexcept auto bitand bitor bool break case catch char char8_t char16_t char32_t class compl concept const consteval constexpr constinit const_cast continue co_await co_return co_yield decltype default delete do double dynamic_cast else enum explicit export extern false float for friend goto if inline int long mutable namespace new noexcept not not_eq nullptr operator or or_eq private protected public register reinterpret_cast requires return short signed sizeof static static_assert static_cast struct switch template this thread_local throw true try typedef typeid typename union unsigned using virtual void volatile wchar_t while xor xor_eq _Alignas _Alignof _Atomic _Bool _Complex _Generic _Imaginary _Noreturn _Static_assert _Thread_local"
  let mut start: usize = 0
  at = 0
  while at <= keywords.length {
    if at == keywords.length || keywords[at] == 32 {
      if Slice.view<u8>(keywords, start, at - start) == value {
        return false
      }
      start = at + 1
    }
    at = at + 1
  }
  return true
}

fn signature(answer: &Result<Answer, NoRejection>) -> Option<&Signature> {
  if let Result<Answer, NoRejection>.Success { value } = &answer.* {
    if let Outcome.Success { value: Value.Signature { signature: held } } = &value.outcome {
      return Option<&Signature>.some(Value.signatureOf(&held))
    }
  }
  return Option<&Signature>.none()
}

fn primitive(name: &[u8]) -> &'static [u8] {
  if name == b"bool" {
    return b"bool"
  }
  if name == b"char" {
    return b"uint32_t"
  }
  if name == b"i8" {
    return b"int8_t"
  }
  if name == b"u8" {
    return b"uint8_t"
  }
  if name == b"i16" {
    return b"int16_t"
  }
  if name == b"u16" {
    return b"uint16_t"
  }
  if name == b"i32" {
    return b"int32_t"
  }
  if name == b"u32" {
    return b"uint32_t"
  }
  if name == b"i64" {
    return b"int64_t"
  }
  if name == b"u64" {
    return b"uint64_t"
  }
  if name == b"usize" {
    return b"uintptr_t"
  }
  if name == b"isize" {
    return b"intptr_t"
  }
  if name == b"f32" {
    return b"float"
  }
  if name == b"f64" {
    return b"double"
  }
  return b""
}

fn representation(kind: IntegerType) -> &'static [u8] {
  return match kind {
    IntegerType.U8 => b"uint8_t"
    IntegerType.U16 => b"uint16_t"
    IntegerType.U32 => b"uint32_t"
    IntegerType.U64 => b"uint64_t"
    IntegerType.I8 => b"int8_t"
    IntegerType.I16 => b"int16_t"
    IntegerType.I32 => b"int32_t"
    IntegerType.I64 => b"int64_t"
    IntegerType.Usize => b"uintptr_t"
    IntegerType.Isize => b"intptr_t"
  }
}

effect fn typeName(
  context: &mut Context,
  store: &mut Semantic,
  request: &mut Request,
  ty: &Interned<Type>,
) -> Bytes
  ! Failure
  ? &mut Allocator | &mut Types {
  match &Interned<Type>.get(ty).* {
    Type.Unit => {
      return run Bytes.copy(b"void")
    }
    Type.Primitive { name } => {
      let spelling = primitive(name.asSlice())
      if spelling.length == 0 {
        run invalid(b"a C header cannot represent this primitive")
      }
      return run Bytes.copy(spelling)
    }
    _ => {}
  }
  let mut at: usize = 0
  while at < context.types.length() {
    if run Type.equalsShared(&context.types.asSlice()[at], ty) {
      return run Bytes.copy(context.names.asSlice()[at].asSlice())
    }
    at = at + 1
  }
  let mut name = run Bytes.copy(b"silk_type_")
  run number(&mut name, Type.hash(ty))
  run context.types.append(Interned<Type>.clone(ty))
  run context.names.append(run Bytes.copy(name.asSlice()))
  let mut definition = Bytes.make()
  match &Interned<Type>.get(ty).* {
    Type.Pointer { pointee, access, .. } => {
      let pointed = run typeName(&mut context.*, &mut store.*, &mut request.*, &pointee)
      run definition.append(b"typedef ")
      run definition.append(pointed.asSlice())
      if access == Access.Shared {
        run definition.append(b" const")
      }
      run definition.append(b" *")
      run definition.append(name.asSlice())
      run definition.append(b";\n")
    }
    Type.Array { element, extent } => {
      let elementName = run typeName(&mut context.*, &mut store.*, &mut request.*, &element)
      run definition.append(b"typedef ")
      run definition.append(elementName.asSlice())
      run definition.append(b" ")
      run definition.append(name.asSlice())
      run definition.append(b"[")
      run definition.append(extent.asSlice())
      run definition.append(b"];\n")
    }
    Type.Vector { element, lanes } => {
      let elementName = run typeName(&mut context.*, &mut store.*, &mut request.*, &element)
      run definition.append(b"typedef ")
      run definition.append(elementName.asSlice())
      run definition.append(b" ")
      run definition.append(name.asSlice())
      run definition.append(b" __attribute__((vector_size(sizeof(")
      run definition.append(elementName.asSlice())
      run definition.append(b") * ")
      run definition.append(lanes.asSlice())
      run definition.append(b")));\n")
    }
    Type.ForeignFunction { signature: callable, .. } => {
      if let Type.Callable { parameters, result, .. } = &Interned<Type>.get(&callable).* {
        let resultName = run typeName(&mut context.*, &mut store.*, &mut request.*, &result)
        run definition.append(b"typedef ")
        run definition.append(resultName.asSlice())
        run definition.append(b" (*")
        run definition.append(name.asSlice())
        run definition.append(b")(")
        let values = parameters.asSlice()
        let mut parameter: usize = 0
        while parameter < values.length {
          if parameter > 0 {
            run definition.append(b", ")
          }
          let parameterName = run typeName(
            &mut context.*,
            &mut store.*,
            &mut request.*,
            &values[parameter],
          )
          run definition.append(parameterName.asSlice())
          parameter = parameter + 1
        }
        if values.length == 0 {
          run definition.append(b"void")
        }
        run definition.append(b");\n")
      } else {
        run invalid(b"a C callback has no callable signature")
      }
    }
    Type.Nominal { declaration, .. } => {
      let module = DeclarationId.moduleId(&declaration)
      let spelled = run DeclarationId.copySpelling(&declaration)
      let members = run store.demandMembers(&mut request.*, module, spelled.asSlice())
      if DeclarationId.kind(&declaration) == OwnerKind.Enumeration {
        let integer = Shared<Result<Answer, NoRejection>>.with<Option<IntegerType>>(
          &members,
          |answer: &Result<Answer, NoRejection>| -> Option<IntegerType> {
            if let Result<Answer, NoRejection>.Success { value } = &answer.* {
              if let Outcome.Success {
                value: Value.Members { enumRepresentation, .. }
              } = &value.outcome {
                return Option<IntegerType>.some(enumRepresentation)
              }
            }
            return Option<IntegerType>.none()
          },
        )
        let represented = match move integer {
          Option<IntegerType>.Some { value } => value
          _ => {
            run invalid(b"cannot read the representation of a C enum")
          }
        }
        run definition.append(b"typedef ")
        run definition.append(representation(represented))
        run definition.append(b" ")
        run definition.append(name.asSlice())
        run definition.append(b";\n")
      } else {
        run context.forward.append(b"typedef struct ")
        run context.forward.append(name.asSlice())
        run context.forward.append(b" ")
        run context.forward.append(name.asSlice())
        run context.forward.append(b";\n")
        let count = Shared<Result<Answer, NoRejection>>.with<usize>(&members, memberCount)
        if count == usize.MAX {
          run invalid(b"cannot read the fields of a C record")
        }
        if count > 0 {
          run definition.append(b"struct ")
          run definition.append(name.asSlice())
          run definition.append(b" {\n")
          let mut field: usize = 0
          while field < count {
            let shape = run store.demandMemberShape(
              &mut request.*,
              module,
              spelled.asSlice(),
              field,
              ty,
            )
            let held = Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(
              &shape,
              memberType,
            )
            let fieldType = match move held {
              Option<Interned<Type>>.Some { value } => move value
              _ => {
                run invalid(b"cannot read the type of a C record field")
              }
            }
            let fieldTypeName = run typeName(
              &mut context.*,
              &mut store.*,
              &mut request.*,
              &fieldType,
            )
            let fieldName = run memberName(&members, field)
            run definition.append(b"  ")
            run definition.append(fieldTypeName.asSlice())
            run definition.append(b" field_")
            run definition.append(fieldName.asSlice())
            run definition.append(b";\n")
            field = field + 1
          }
          run definition.append(b"};\n")
        }
      }
    }
    _ => {
      run invalid(b"a C header requires an admitted C boundary type")
    }
  }
  run context.definitions.append(definition.asSlice())
  return move name
}

fn memberCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success { value } = &answer.* {
    if let Outcome.Success { value: Value.Members { members, .. } } = &value.outcome {
      return members.length()
    }
  }
  return usize.MAX
}

fn memberType(answer: &Result<Answer, NoRejection>) -> Option<Interned<Type>> {
  if let Result<Answer, NoRejection>.Success { value } = &answer.* {
    if let Outcome.Success { value: Value.MemberShape { types } } = &value.outcome {
      if types.length() == 1 {
        return Option<Interned<Type>>.some(Interned<Type>.clone(&types.asSlice()[0]))
      }
    }
  }
  return Option<Interned<Type>>.none()
}

fn memberBytes(answer: &Result<Answer, NoRejection>, field: usize) -> &[u8] {
  if let Result<Answer, NoRejection>.Success { value } = &answer.* {
    if let Outcome.Success { value: Value.Members { members, .. } } = &value.outcome {
      if let Option<Bytes>.Some { value: name } = &members.asSlice()[field].name {
        return name.asSlice()
      }
    }
  }
  return b""
}

effect fn memberName(answer: &Shared<Result<Answer, NoRejection>>, field: usize) -> Bytes
  ! InvalidNativeLinkInput | OutOfMemoryError
  ? &mut Allocator {
  let length = Shared<Result<Answer, NoRejection>>.with<usize>(
    answer,
    |fact: &Result<Answer, NoRejection>| -> usize {
      return memberBytes(fact, field).length
    },
  )
  if length == 0 {
    run invalid(b"a C record field has no name")
  }
  let mut result = Bytes.make()
  let mut at: usize = 0
  while at < length {
    let byte = Shared<Result<Answer, NoRejection>>.with<u8>(
      answer,
      |fact: &Result<Answer, NoRejection>| -> u8 {
        return memberBytes(fact, field)[at]
      },
    )
    run result.append(&[byte])
    at = at + 1
  }
  return move result
}

effect fn number(out: &mut Bytes, value: u64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value >= 10 {
    run number(&mut out.*, value / 10)
  }
  run out.append(&[u64.toU8(value % 10) + 48])
}
