//! Shared locations and defaults for package metadata in a parsed manifest.
//! Package source roots default to src, with conventional main.silk, lib.silk (else the first
//! export), and tests.silk roots.
//! Runtime composition remains under unstable; compilation settings belong to requests.

import driver.CommandPath
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.core.option { Option }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.toml.value { Toml, Value as TomlValue }
import silk.collections.bytes { Bytes }
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// The string `[package].<key>`, when the manifest writes one.
pub fn packageText<'a>(document: &'a TomlValue, key: string) -> Option<&'a [u8]> {
  return match move Toml.asString(Toml.fieldAt(Toml.field(document, "package"), key)) {
    Option<string<'a>>.Some { value } => Option<&'a [u8]>.some(String.utf8Bytes(value))
    Option<string<'a>>.None => Option<&'a [u8]>.none()
  }
}

/// The string `[workspace].<key>`, when the manifest writes one.
pub fn workspaceText<'a>(document: &'a TomlValue, key: string) -> Option<&'a [u8]> {
  return match move Toml.asString(Toml.fieldAt(Toml.field(document, "workspace"), key)) {
    Option<string<'a>>.Some { value } => Option<&'a [u8]>.some(String.utf8Bytes(value))
    Option<string<'a>>.None => Option<&'a [u8]>.none()
  }
}

/// `version` without its `+` build metadata, as `silk init` writes a `silk-version`:
/// `0.1.0-dev.85+45b9e51824ca` is `0.1.0-dev.85`.
pub fn withoutMetadata<'a>(version: &'a [u8]) -> &'a [u8] {
  let mut end = usize.ZERO
  while end < version.length && version[end] != 43 {
    end = end + usize.ONE
  }
  return Slice.view<u8>(version, usize.ZERO, end)
}

/// `[package].version`, or `0.0.0` when the manifest omits it.
pub fn version<'a>(document: &'a TomlValue) -> &'a [u8] {
  return match move packageText(document, "version") {
    Option<&'a [u8]>.Some { value } => value
    Option<&'a [u8]>.None => b"0.0.0"
  }
}

/// The import root: `[package].source`, else `src`, resolved against `directory`.
pub effect fn sourceRoot(directory: &Path, document: &TomlValue) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  if let Option<&[u8]>.Some { value } = move packageText(document, "source") {
    return run CommandPath.resolve(directory, value)
  }
  return run CommandPath.resolve(directory, b"src")
}

/// The module path for the first entry of `[package].exports` below `sourceRoot`, if that file
/// or directory barrel exists on disk: `a.b` resolves to `a/b.silk`, else `a/b/mod.silk`.
pub effect fn firstExport(document: &TomlValue, sourceRoot: &Path) -> Option<Path>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let listed = match move Toml.fieldAt(Toml.field(document, "package"), "exports") {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      return Option<Path>.none()
    }
  }
  let spelled = match move Toml.asString(Toml.item(listed, usize.ZERO)) {
    Option<string>.Some { value } => String.utf8Bytes(value)
    Option<string>.None => {
      return Option<Path>.none()
    }
  }
  if spelled.length == usize.ZERO {
    return Option<Path>.none()
  }

  // `a.b` names `a/b.silk`, else the barrel `a/b/mod.silk` (MODULE-007).
  let mut path = run Bytes.copy(spelled)
  let bytes = Bytes.asMutSlice(&mut path)
  let mut at = usize.ZERO
  while at < bytes.length {
    if bytes[at] == 46 {
      bytes[at] = 47
    }
    at = at + usize.ONE
  }
  let mut file = run Bytes.copy(Bytes.asSlice(&path))
  run Bytes.append(&mut file, b".silk")
  let module = run CommandPath.resolve(sourceRoot, Bytes.asSlice(&file))
  if run FileSystem.exists(&module) {
    return Option<Path>.some(move module)
  }
  run Bytes.append(&mut path, b"/mod.silk")
  let barrel = run CommandPath.resolve(sourceRoot, Bytes.asSlice(&path))
  if run FileSystem.exists(&barrel) {
    return Option<Path>.some(move barrel)
  }
  return Option<Path>.none()
}

/// The runtime composition: `[unstable].composition`.
pub fn composition<'a>(document: &'a TomlValue) -> Option<&'a TomlValue> {
  return Toml.fieldAt(Toml.field(document, "unstable"), "composition")
}

// The end of the leading run of decimal digits in `text` from `start`.
fn digitsEnd(text: &[u8], start: usize) -> usize {
  let mut at = start
  while at < text.length && text[at] >= 48 && text[at] <= 57 {
    at = at + usize.ONE
  }
  return at
}

// Whether the decimal digits `left` spell a smaller number than the digits `right`.
fn below(left: &[u8], right: &[u8]) -> bool {
  let mut a = usize.ZERO
  while a + usize.ONE < left.length && left[a] == 48 {
    a = a + usize.ONE
  }
  let mut b = usize.ZERO
  while b + usize.ONE < right.length && right[b] == 48 {
    b = b + usize.ONE
  }
  if left.length - a != right.length - b {
    return left.length - a < right.length - b
  }
  while a < left.length {
    if left[a] != right[b] {
      return left[a] < right[b]
    }
    a = a + usize.ONE
    b = b + usize.ONE
  }
  return false
}

// One version split into `major.minor.patch`, its prerelease and its build metadata.
struct Parts<'a> {
  major: &'a [u8],
  minor: &'a [u8],
  patch: &'a [u8],
  // `major.minor.patch-prerelease`, without build metadata.
  release: &'a [u8],
  prerelease: bool,
}

fn parts<'a>(version: &'a [u8]) -> Option<Parts<'a>> {
  let majorEnd = digitsEnd(version, usize.ZERO)
  if majorEnd == usize.ZERO || majorEnd >= version.length || version[majorEnd] != 46 {
    return Option<Parts<'a>>.none()
  }
  let minorEnd = digitsEnd(version, majorEnd + usize.ONE)
  if minorEnd == majorEnd + usize.ONE || minorEnd >= version.length || version[minorEnd] != 46 {
    return Option<Parts<'a>>.none()
  }
  let patchEnd = digitsEnd(version, minorEnd + usize.ONE)
  if patchEnd == minorEnd + usize.ONE {
    return Option<Parts<'a>>.none()
  }
  let mut releaseEnd = patchEnd
  while releaseEnd < version.length && version[releaseEnd] != 43 {
    releaseEnd = releaseEnd + usize.ONE
  }
  return Option<Parts<'a>>.some(
    Parts<'a> {
      major: Slice.view<u8>(version, usize.ZERO, majorEnd),
      minor: Slice.view<u8>(version, majorEnd + usize.ONE, minorEnd - majorEnd - usize.ONE),
      patch: Slice.view<u8>(version, minorEnd + usize.ONE, patchEnd - minorEnd - usize.ONE),
      release: Slice.view<u8>(version, usize.ZERO, releaseEnd),
      prerelease: patchEnd < version.length && version[patchEnd] == 45,
    },
  )
}

/// Whether `version` is a prerelease such as a dev build: `major.minor.patch-<label>`.
pub fn isPrerelease(version: &[u8]) -> bool {
  return match move parts(version) {
    Option<Parts>.Some { value } => value.prerelease
    Option<Parts>.None => false
  }
}

/// Whether a compiler of version `running` builds a package whose `silk-version` is `written`
/// (D1 of the manifest design). A `silk-version` names the oldest release a package was written for,
/// within its release line under the caret rule: `0.3.2` accepts 0.3.2 and any later 0.3 release,
/// and `1.2.0` any later 1.x. A prerelease such as a dev release orders before its release, so
/// `0.1.0-dev.90` accepts 0.1.0-dev.90, every later 0.1 dev release and 0.1.0 itself, while a
/// dev compiler never builds a package written for a later one. Build metadata plays no part. A
/// local `0.0.0` compiler builds any package.
pub fn compatible(running: &[u8], written: &[u8]) -> bool {
  if same(running, b"0.0.0") || same(written, b"0.0.0") {
    return true
  }
  let have = match move parts(running) {
    Option<Parts>.Some { value } => move value
    Option<Parts>.None => {
      return false
    }
  }
  let want = match move parts(written) {
    Option<Parts>.Some { value } => move value
    Option<Parts>.None => {
      return false
    }
  }
  if !sameLine(&have, &want) {
    return false
  }
  return !newer(&want, &have)
}

/// Whether `running` and `written` belong to one release line: the same minor version before 1.0,
/// the same major version from 1.0. A version that does not parse shares no line.
pub fn sameReleaseLine(running: &[u8], written: &[u8]) -> bool {
  return match move parts(running) {
    Option<Parts>.Some { value: have } => match move parts(written) {
      Option<Parts>.Some { value: want } => sameLine(&have, &want)
      Option<Parts>.None => false
    }
    Option<Parts>.None => false
  }
}

fn sameLine<'a, 'b>(have: &Parts<'a>, want: &Parts<'b>) -> bool {
  if !same(have.major, want.major) {
    return false
  }
  return !same(want.major, b"0") || same(have.minor, want.minor)
}

// Whether `left` orders after `right` by semantic version precedence, build metadata ignored.
fn newer<'a, 'b>(left: &Parts<'a>, right: &Parts<'b>) -> bool {
  if !same(left.major, right.major) {
    return below(right.major, left.major)
  }
  if !same(left.minor, right.minor) {
    return below(right.minor, left.minor)
  }
  if !same(left.patch, right.patch) {
    return below(right.patch, left.patch)
  }
  if !left.prerelease || !right.prerelease {
    return !left.prerelease && right.prerelease
  }
  return labelAfter(label(left), label(right))
}

// The prerelease label of `version`, after the `-` that follows its patch.
fn label<'a>(version: &Parts<'a>) -> &'a [u8] {
  let start = version.patch.length + version.minor.length + version.major.length + 3
  return Slice.view<u8>(version.release, start, version.release.length - start)
}

// Whether the prerelease label `left` orders after `right`: dot-separated identifiers compared in
// turn, numeric ones by value and before alphanumeric ones, which compare as text; a label that
// runs out first orders first.
fn labelAfter(left: &[u8], right: &[u8]) -> bool {
  let mut a = usize.ZERO
  let mut b = usize.ZERO
  while a < left.length && b < right.length {
    let mut aEnd = a
    while aEnd < left.length && left[aEnd] != 46 {
      aEnd = aEnd + usize.ONE
    }
    let mut bEnd = b
    while bEnd < right.length && right[bEnd] != 46 {
      bEnd = bEnd + usize.ONE
    }
    let one = Slice.view<u8>(left, a, aEnd - a)
    let other = Slice.view<u8>(right, b, bEnd - b)
    if !same(one, other) {
      let oneNumeric = one.length > usize.ZERO && digitsEnd(one, usize.ZERO) == one.length
      let otherNumeric = other.length > usize.ZERO && digitsEnd(other, usize.ZERO) == other.length
      if oneNumeric && otherNumeric {
        return below(other, one)
      }
      if oneNumeric != otherNumeric {
        return otherNumeric
      }
      return textBelow(other, one)
    }
    a = aEnd + usize.ONE
    b = bEnd + usize.ONE
  }
  return a < left.length
}

// Whether `left` sorts before `right` byte by byte.
fn textBelow(left: &[u8], right: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < left.length && at < right.length {
    if left[at] != right[at] {
      return left[at] < right[at]
    }
    at = at + usize.ONE
  }
  return left.length < right.length
}
