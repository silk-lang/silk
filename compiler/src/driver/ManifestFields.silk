//! Where each field of a parsed `silk.toml` lives, so every reader agrees on names and defaults.
//!
//! `[package].source` is the import root (default `src`) and `[package].main` the root module below
//! it (default `main.silk`, or `lib.silk` for a library kind). `[package].kind` says what a build
//! makes, `[package].version` defaults to `0.0.0`, native link inputs and the platform supply live
//! in `[native]`, and the runtime composition in `[unstable]`. Earlier spellings of these fields
//! are refused by driver/Project, which names the replacement.

import driver.CommandPath
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, Path }
import silk.core.option { Option }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.toml.value { TableKind, Toml, TomlChild, TomlEntry, Value as TomlValue }
import silk.mem.box { Box }
import silk.collections.list { List }
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// The string `[package].<key>`, when the manifest writes one.
pub fn packageText<'a>(document: &'a TomlValue, key: string) -> Option<&'a [u8]> {
  return match move Toml.asString(Toml.fieldAt(Toml.field(document, "package"), key)) {
    Option<string<'a>>.Some { value } => Option<&'a [u8]>.some(String.utf8Bytes(value))
    Option<string<'a>>.None => Option<&'a [u8]>.none()
  }
}

/// `[package].version`, or `0.0.0` when the manifest omits it.
pub fn version<'a>(document: &'a TomlValue) -> &'a [u8] {
  return match move packageText(document, "version") {
    Option<&'a [u8]>.Some { value } => value
    Option<&'a [u8]>.None => b"0.0.0"
  }
}

/// What a build of the package makes: `[package].kind`, absent for `executable`.
pub fn kind<'a>(document: &'a TomlValue) -> Option<&'a TomlValue> {
  return Toml.fieldAt(Toml.field(document, "package"), "kind")
}

/// Whether `kind` names one of the library kinds, whose default root module is `lib.silk`.
pub fn isLibraryKind(kind: &[u8]) -> bool {
  return same(kind, b"library") || same(kind, b"static-library") || same(kind, b"shared-library")
}

/// The import root: `[package].source`, else `src`, resolved against `directory`.
pub effect fn sourceRoot(directory: &Path, document: &TomlValue) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  if let Option<&[u8]>.Some { value } = move packageText(document, "source") {
    return run CommandPath.resolve(directory, value)
  }
  return run CommandPath.resolve(directory, b"src")
}

/// The root module: `[package].main` below the source root, else `main.silk` (`lib.silk` for a
/// library kind) below it.
pub effect fn main(document: &TomlValue, sourceRoot: &Path) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  if let Option<&[u8]>.Some { value } = move packageText(document, "main") {
    return run CommandPath.resolve(sourceRoot, value)
  }
  let mut library = false
  if let Option<string>.Some { value } = move Toml.asString(kind(document)) {
    library = isLibraryKind(String.utf8Bytes(value))
  }
  if library {
    return run CommandPath.resolve(sourceRoot, b"lib.silk")
  }
  return run CommandPath.resolve(sourceRoot, b"main.silk")
}

/// The native link inputs: `[native].link`.
pub fn linkInputs<'a>(document: &'a TomlValue) -> Option<&'a TomlValue> {
  return Toml.fieldAt(Toml.field(document, "native"), "link")
}

/// The native sources the build compiles: `[native].sources`.
pub fn nativeSources<'a>(document: &'a TomlValue) -> Option<&'a TomlValue> {
  return Toml.fieldAt(Toml.field(document, "native"), "sources")
}

/// The function ordering file: `[native].function-order`.
pub fn functionOrder<'a>(document: &'a TomlValue) -> Option<&'a TomlValue> {
  return Toml.fieldAt(Toml.field(document, "native"), "function-order")
}

/// The platform supply request: `[native].platform-supply`.
pub fn platformSupply<'a>(document: &'a TomlValue) -> Option<&'a TomlValue> {
  return Toml.fieldAt(Toml.field(document, "native"), "platform-supply")
}

/// The runtime composition: `[unstable].composition`.
pub fn composition<'a>(document: &'a TomlValue) -> Option<&'a TomlValue> {
  return Toml.fieldAt(Toml.field(document, "unstable"), "composition")
}

// The end of the leading run of decimal digits in `text` from `start`.
fn digitsEnd(text: &[u8], start: usize) -> usize {
  let mut at = start
  while at < text.length && text[at] >= 48 && text[at] <= 57 {
    at = at + usize.ONE
  }
  return at
}

// Whether the decimal digits `left` spell a smaller number than the digits `right`.
fn below(left: &[u8], right: &[u8]) -> bool {
  let mut a = usize.ZERO
  while a + usize.ONE < left.length && left[a] == 48 {
    a = a + usize.ONE
  }
  let mut b = usize.ZERO
  while b + usize.ONE < right.length && right[b] == 48 {
    b = b + usize.ONE
  }
  if left.length - a != right.length - b {
    return left.length - a < right.length - b
  }
  while a < left.length {
    if left[a] != right[b] {
      return left[a] < right[b]
    }
    a = a + usize.ONE
    b = b + usize.ONE
  }
  return false
}

// One version split into `major.minor.patch`, its prerelease and its build metadata.
struct Parts<'a> {
  major: &'a [u8],
  minor: &'a [u8],
  patch: &'a [u8],
  // `major.minor.patch-prerelease`, without build metadata.
  release: &'a [u8],
  prerelease: bool,
}

fn parts<'a>(version: &'a [u8]) -> Option<Parts<'a>> {
  let majorEnd = digitsEnd(version, usize.ZERO)
  if majorEnd == usize.ZERO || majorEnd >= version.length || version[majorEnd] != 46 {
    return Option<Parts<'a>>.none()
  }
  let minorEnd = digitsEnd(version, majorEnd + usize.ONE)
  if minorEnd == majorEnd + usize.ONE || minorEnd >= version.length || version[minorEnd] != 46 {
    return Option<Parts<'a>>.none()
  }
  let patchEnd = digitsEnd(version, minorEnd + usize.ONE)
  if patchEnd == minorEnd + usize.ONE {
    return Option<Parts<'a>>.none()
  }
  let mut releaseEnd = patchEnd
  while releaseEnd < version.length && version[releaseEnd] != 43 {
    releaseEnd = releaseEnd + usize.ONE
  }
  return Option<Parts<'a>>.some(Parts<'a> {
    major: Slice.view<u8>(version, usize.ZERO, majorEnd),
    minor: Slice.view<u8>(version, majorEnd + usize.ONE, minorEnd - majorEnd - usize.ONE),
    patch: Slice.view<u8>(version, minorEnd + usize.ONE, patchEnd - minorEnd - usize.ONE),
    release: Slice.view<u8>(version, usize.ZERO, releaseEnd),
    prerelease: patchEnd < version.length && version[patchEnd] == 45,
  })
}

/// Whether `version` is a prerelease such as a dev build: `major.minor.patch-<label>`.
pub fn isPrerelease(version: &[u8]) -> bool {
  return match move parts(version) {
    Option<Parts>.Some { value } => value.prerelease
    Option<Parts>.None => false
  }
}

/// Whether a compiler of version `running` builds a dependency whose `silk-version` is `written`
/// (D1 of the manifest design). A dependency names the release line it was written for, read with
/// the caret rule: `0.3.2` accepts 0.3.2 and later 0.3 patches, and `1.2.0` any later 1.x. A dev or
/// other prerelease version matches only itself (and its build metadata, when written), and a
/// prerelease compiler builds only dependencies written for it. A local `0.0.0` compiler builds
/// any dependency.
pub fn compatible(running: &[u8], written: &[u8]) -> bool {
  if same(running, b"0.0.0") || same(written, b"0.0.0") {
    return true
  }
  let have = match move parts(running) {
    Option<Parts>.Some { value } => move value
    Option<Parts>.None => {
      return false
    }
  }
  let want = match move parts(written) {
    Option<Parts>.Some { value } => move value
    Option<Parts>.None => {
      return false
    }
  }
  if want.prerelease || have.prerelease {
    if want.release.length != written.length {
      return same(running, written)
    }
    return same(have.release, want.release)
  }
  if !same(have.major, want.major) {
    return false
  }
  if same(want.major, b"0") {
    return same(have.minor, want.minor) && !below(have.patch, want.patch)
  }
  if below(have.minor, want.minor) {
    return false
  }
  return !same(have.minor, want.minor) || !below(have.patch, want.patch)
}

/// Adds the dependencies of profile `profile`, `[profiles.<profile>.dependencies]`, to the
/// package's own `[dependencies]` in `document`. A profile's entry replaces the package's entry of
/// the same name. Only the root package's selected profile adds any, so a package read as a
/// dependency never names them.
pub effect fn addProfileDependencies(document: &mut TomlValue, profile: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut added = match move run takeProfileDependencies(&mut document.*, profile) {
    Option<List<TomlChild>>.Some { value } => move value
    Option<List<TomlChild>>.None => { return () }
  }
  let mut own = match move takeMember(&mut document.*, b"dependencies") {
    Option<TomlValue>.Some { value } => match move membersOf(move value) {
      Option<List<TomlChild>>.Some { value: members } => move members
      // A `[dependencies]` that is not a table is refused when the packages load; keep it so.
      Option<List<TomlChild>>.None => { return () }
    }
    Option<TomlValue>.None => List<TomlChild>.make()
  }
  while List<TomlChild>.length(&added) > usize.ZERO {
    let child = List<TomlChild>.remove(&mut added, usize.ZERO)
    if let TomlChild.Member { entry } = &child {
      let name = String.ownedUtf8Bytes(&entry.key)
      let listed = List<TomlChild>.asSlice(&own)
      let mut at = usize.ZERO
      let mut found = Option<usize>.none()
      while at < listed.length {
        if let TomlChild.Member { entry: existing } = &listed[at] {
          if same(String.ownedUtf8Bytes(&existing.key), name) { found = Option<usize>.some(at) }
        }
        at = at + usize.ONE
      }
      if let Option<usize>.Some { value: replaced } = move found {
        let previous = List<TomlChild>.remove(&mut own, replaced)
        drop previous
      }
    }
    run List<TomlChild>.append(&mut own, move child)
  }
  let table = TomlValue.Table { entries: run Box<List<TomlChild>>.make(move own), kind: TableKind.Explicit }
  run appendMember(&mut document.*, "dependencies", move table)
}

// The members of `[profiles.<profile>.dependencies]`, taken out of `document`.
effect fn takeProfileDependencies(document: &mut TomlValue, profile: &[u8]) -> Option<List<TomlChild>> ! OutOfMemoryError ? &mut Allocator {
  if let TomlValue.Table { entries, .. } = &mut document.* {
    let members = Box<List<TomlChild>>.getMut(&mut entries)
    let listed = List<TomlChild>.asMutSlice(&mut members[0])
    let mut at = usize.ZERO
    while at < listed.length {
      if let TomlChild.Member { entry: profiles } = &mut listed[at] {
        if same(String.ownedUtf8Bytes(&profiles.key), b"profiles") {
          if let TomlValue.Table { entries: named, .. } = &mut profiles.value {
            let tables = Box<List<TomlChild>>.getMut(&mut named)
            let profileTables = List<TomlChild>.asMutSlice(&mut tables[0])
            let mut index = usize.ZERO
            while index < profileTables.length {
              if let TomlChild.Member { entry: selected } = &mut profileTables[index] {
                if same(String.ownedUtf8Bytes(&selected.key), profile) {
                  return match move takeMember(&mut selected.value, b"dependencies") {
                    Option<TomlValue>.Some { value } => membersOf(move value)
                    Option<TomlValue>.None => Option<List<TomlChild>>.none()
                  }
                }
              }
              index = index + usize.ONE
            }
          }
        }
      }
      at = at + usize.ONE
    }
  }
  return Option<List<TomlChild>>.none()
}

// Removes member `key` from table `table` and returns its value.
fn takeMember(table: &mut TomlValue, key: &[u8]) -> Option<TomlValue> {
  if let TomlValue.Table { entries, .. } = &mut table.* {
    let members = Box<List<TomlChild>>.getMut(&mut entries)
    let listed = List<TomlChild>.asSlice(&members[0])
    let mut at = usize.ZERO
    let mut found = Option<usize>.none()
    while at < listed.length {
      if let TomlChild.Member { entry } = &listed[at] {
        if same(String.ownedUtf8Bytes(&entry.key), key) { found = Option<usize>.some(at) }
      }
      at = at + usize.ONE
    }
    if let Option<usize>.Some { value: index } = move found {
      let child = List<TomlChild>.remove(&mut members[0], index)
      return match move child {
        TomlChild.Member { entry } => {
          let TomlEntry { key: name, value } = move entry
          drop name
          Option<TomlValue>.some(move value)
        }
        TomlChild.Item { value } => Option<TomlValue>.some(move value)
      }
    }
  }
  return Option<TomlValue>.none()
}

// The members of `value`, when it is a table.
fn membersOf(value: TomlValue) -> Option<List<TomlChild>> {
  return match move value {
    TomlValue.Table { entries, kind: _ } => Option<List<TomlChild>>.some(Box<List<TomlChild>>.into(move entries))
    _ => Option<List<TomlChild>>.none()
  }
}

effect fn appendMember(table: &mut TomlValue, key: string, value: TomlValue) -> () ! OutOfMemoryError ? &mut Allocator {
  if let TomlValue.Table { entries, .. } = &mut table.* {
    let members = Box<List<TomlChild>>.getMut(&mut entries)
    let name = run String.copy(key)
    run List<TomlChild>.append(&mut members[0], TomlChild.Member { entry: TomlEntry { key: move name, value: move value } })
  }
}
