//! The stamp a semantic cache image is written and read under.
//!
//! # When to use
//! Call [`compiler`] once per process and [`stamp`] once the store has its profile. Pass the
//! stamp to `CacheImage.encode` and `CacheImage.decode`; an image whose stamp differs reads as
//! nothing, so a cache never outlives the compiler, target or profile that wrote it.
//!
//! # Details
//! The compiler's identity is its release version and, where the system names the running
//! executable (`/proc/self/exe` on Linux, or the loaded module on Windows), the digest of that executable. A development build
//! reports version `0.0.0` whatever its source, so without the executable's digest it has no
//! identity and keeps no cache. A compiler built for WASI cannot read its own module, so it keeps
//! no cache either.

import ReleaseVersion
import driver.CommandPath
static if Intrinsic.targetOperatingSystem() == "windows" { import silk.platform.windows.host_path as WindowsHostPath }
import semantic.ContentHash {ContentHash}
import semantic.SourceInputs
import semantic.RuntimeEncoding
import semantic.Semantic {Semantic}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.system.filesystem {FileError, FileSystem, Path}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.num.usize

fn development(version: &[u8]) -> bool {
  let unreleased = b"0.0.0"
  if version.length != unreleased.length { return false }
  let mut at = usize.ZERO
  while at < version.length {
    if version[at] != unreleased[at] { return false }
    at = at + usize.ONE
  }
  return true
}

/// The identity of the running compiler, or none for a development build whose executable the
/// system does not name.
pub effect fn compiler() -> Option<Bytes> ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  // A WASI module cannot read its own code: `/proc/self/exe` there names the host runtime.
  static if Intrinsic.targetOperatingSystem() == "wasi" { return Option<Bytes>.none() }
  let version = ReleaseVersion.value()
  let mut identity = Bytes.make()
  run RuntimeEncoding.field(&mut identity, b"silk")
  run RuntimeEncoding.field(&mut identity, version)
  run RuntimeEncoding.field(&mut identity, SourceInputs.bodyPolicy())
  let executable = run Effect.result(executableBytes())
  match move executable {
    Result<Bytes, FileError | OutOfMemoryError>.Success {value} => {
      let digest = ContentHash.of(Bytes.asSlice(&value))
      run RuntimeEncoding.word(&mut identity, digest.high)
      run RuntimeEncoding.word(&mut identity, digest.low)
    }
    Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => {
        drop failure
        if development(version) { return Option<Bytes>.none() }
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  return Option<Bytes>.some(move identity)
}

// The running executable's bytes, independent of argv[0] and PATH.
effect fn executableBytes() -> Bytes ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut named = Option<Bytes>.none()
  static if Intrinsic.targetOperatingSystem() == "windows" {
    named = run WindowsHostPath.executable()
  } else {
    named = run CommandPath.canonical(b"/proc/self/exe")
  }
  let resolved = match move named {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { fail FileSystem.error(FileSystem.readFileOperation(), FileSystem.notFound()) }
  }
  let path = run Path.fromBytes(Bytes.asSlice(&resolved))
  return run FileSystem.readFile(&path)
}

/// The stamp of `store`'s answers under the compiler identity `compiler`: the compiler, then the
/// target and profile the store selected.
pub effect fn stamp(store: &Semantic, compiler: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut stamped = run Bytes.copy(compiler)
  let identity = run Semantic.stampIdentity(store)
  run RuntimeEncoding.field(&mut stamped, Bytes.asSlice(&identity))
  return move stamped
}

/// Whether an image written under `written` comes from the compiler `compiler` names and for the
/// target of `store`, whatever profile wrote it: its check roots then serve `store`
/// (`Semantic.checkRoots`).
pub effect fn sameTarget(store: &Semantic, compiler: &[u8], written: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let target = run Semantic.stampTarget(store)
  // `stamp` appends the identity as one field: an 8-byte length, then the target field it leads with.
  let start = compiler.length + 8
  if written.length < start + Bytes.length(&target) { return false }
  if !sameRun(written, usize.ZERO, compiler) { return false }
  return sameRun(written, start, Bytes.asSlice(&target))
}

fn sameRun(bytes: &[u8], start: usize, expected: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < expected.length {
    if bytes[start + at] != expected[at] { return false }
    at = at + usize.ONE
  }
  return true
}
