//! Scripted source edits for `silk check --replay`, which measures how much of a revisable
//! semantic store each kind of edit invalidates.
//!
//! # Details
//! A script is a TOML file of `[[edit]]` tables applied in order. Each names its `kind` and the
//! root-package `module` it edits, by its path below the package's module directory. A `rename`
//! names the module's new path in `to`; every other kind replaces its `find` text, which must
//! occur exactly once in the module, with `replace`.

import diagnostic.JsonText
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.collections.slice {Slice}
import silk.text.string {String}
import silk.toml.value {Toml, Value as TomlValue}
import silk.num.usize

/// The edit kinds whose invalidation the replay reports.
pub enum Kind {
  /// Whitespace or comments only.
  Trivia,
  /// A token inside a body.
  Body,
  /// A declaration header whose declared type stays the same, such as a renamed parameter.
  HeaderSameType,
  /// A declaration header whose declared type changes.
  HeaderNewType,
  /// A directive added to, removed from or changed on a declaration, such as `@inline`.
  Directive,
  /// A new declaration.
  Add,
  /// A removed declaration.
  Delete,
  /// A module file moved to a new path.
  Rename,
}

/// One scripted edit.
pub struct Edit {
  pub kind: Kind,
  /// The edited module's path below the package's module directory.
  pub module: Bytes,
  /// The text replaced; empty for a rename.
  pub find: Bytes,
  /// The replacing text; empty for a rename.
  pub replace: Bytes,
  /// A rename's new module path; empty for every other kind.
  pub to: Bytes,
}

/// A replay script that is not a list of well-formed `[[edit]]` tables.
pub struct InvalidReplayScript {
  /// The edit at fault, when known, and the rule it breaks.
  pub detail: Bytes,
}

/// The kind's spelling in a script and in the replay's report.
pub fn kindName(kind: Kind) -> &'static [u8] {
  return match kind {
    Kind.Trivia => b"trivia"
    Kind.Body => b"body"
    Kind.HeaderSameType => b"header-same-type"
    Kind.HeaderNewType => b"header-new-type"
    Kind.Directive => b"directive"
    Kind.Add => b"add"
    Kind.Delete => b"delete"
    Kind.Rename => b"rename"
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn kindNamed(name: &[u8]) -> Option<Kind> {
  if same(name, kindName(Kind.Trivia)) { return Option<Kind>.some(Kind.Trivia) }
  if same(name, kindName(Kind.Body)) { return Option<Kind>.some(Kind.Body) }
  if same(name, kindName(Kind.HeaderSameType)) { return Option<Kind>.some(Kind.HeaderSameType) }
  if same(name, kindName(Kind.HeaderNewType)) { return Option<Kind>.some(Kind.HeaderNewType) }
  if same(name, kindName(Kind.Directive)) { return Option<Kind>.some(Kind.Directive) }
  if same(name, kindName(Kind.Add)) { return Option<Kind>.some(Kind.Add) }
  if same(name, kindName(Kind.Delete)) { return Option<Kind>.some(Kind.Delete) }
  if same(name, kindName(Kind.Rename)) { return Option<Kind>.some(Kind.Rename) }
  return Option<Kind>.none()
}

// Fails naming edit `at`, then `rule`.
effect fn refuse(at: usize, rule: &[u8]) -> never ! InvalidReplayScript | OutOfMemoryError ? &mut Allocator {
  let mut detail = run Bytes.copy(b"edit ")
  run JsonText.appendDecimal(&mut detail, at + usize.ONE)
  run Bytes.append(&mut detail, b": ")
  run Bytes.append(&mut detail, rule)
  fail InvalidReplayScript {detail: move detail}
}

// The text of `entry`'s `key`, or none when it is absent; another value kind is refused.
effect fn text(at: usize, entry: &TomlValue, key: string) -> Option<Bytes> ! InvalidReplayScript | OutOfMemoryError ? &mut Allocator {
  if let Option<&TomlValue>.None = move Toml.field(entry, key) { return Option<Bytes>.none() }
  return match move Toml.asString(Toml.field(entry, key)) {
    Option<string>.Some {value} => Option<Bytes>.some(run Bytes.copy(String.utf8Bytes(value)))
    Option<string>.None => {
      let mut rule = run Bytes.copy(String.utf8Bytes(key))
      run Bytes.append(&mut rule, b" must be a string")
      run refuse(at, Bytes.asSlice(&rule))
    }
  }
}

effect fn decode(at: usize, entry: &TomlValue) -> Edit ! InvalidReplayScript | OutOfMemoryError ? &mut Allocator {
  let kind = match move run text(at, entry, "kind") {
    Option<Bytes>.Some {value} => match move kindNamed(Bytes.asSlice(&value)) {
      Option<Kind>.Some {value: named} => named
      Option<Kind>.None => run refuse(at, b"kind must be trivia, body, header-same-type, header-new-type, directive, add, delete or rename")
    }
    Option<Bytes>.None => run refuse(at, b"kind is required")
  }
  let module = match move run text(at, entry, "module") {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => run refuse(at, b"module is required")
  }
  let find = run text(at, entry, "find")
  let replace = run text(at, entry, "replace")
  let to = run text(at, entry, "to")
  if kind == Kind.Rename {
    let renamed = match move to {
      Option<Bytes>.Some {value} => move value
      Option<Bytes>.None => run refuse(at, b"a rename names its new path in to")
    }
    if let Option<Bytes>.Some {..} = &find { run refuse(at, b"a rename has no find or replace") }
    if let Option<Bytes>.Some {..} = &replace { run refuse(at, b"a rename has no find or replace") }
    return Edit {kind: kind, module: move module, find: Bytes.make(), replace: Bytes.make(), to: move renamed}
  }
  if let Option<Bytes>.Some {..} = &to { run refuse(at, b"only a rename names a new path in to") }
  let found = match move find {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => run refuse(at, b"find is required")
  }
  if Bytes.length(&found) == usize.ZERO { run refuse(at, b"find must not be empty") }
  let replacing = match move replace {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => run refuse(at, b"replace is required")
  }
  return Edit {kind: kind, module: move module, find: move found, replace: move replacing, to: Bytes.make()}
}

/// Reads the parsed script `document`'s `[[edit]]` tables in order.
pub effect fn read(document: &TomlValue) -> List<Edit> ! InvalidReplayScript | OutOfMemoryError ? &mut Allocator {
  let mut edits = List<Edit>.make()
  let listed = match move Toml.field(document, "edit") {
    Option<&TomlValue>.Some {value} => value
    Option<&TomlValue>.None => { fail InvalidReplayScript {detail: run Bytes.copy(b"the script has no [[edit]] tables")} }
  }
  let mut at = usize.ZERO
  while true {
    let entry = match move Toml.item(listed, at) {
      Option<&TomlValue>.Some {value} => value
      Option<&TomlValue>.None => { break }
    }
    run List<Edit>.append(&mut edits, run decode(at, entry))
    at = at + usize.ONE
  }
  if at == usize.ZERO { fail InvalidReplayScript {detail: run Bytes.copy(b"edit must be an array of tables")} }
  return move edits
}

// Where `find` starts in `content`, from `from` on, or none.
fn occurrence(content: &[u8], find: &[u8], from: usize) -> Option<usize> {
  if find.length > content.length { return Option<usize>.none() }
  let mut at = from
  while at + find.length <= content.length {
    let mut matched = usize.ZERO
    while matched < find.length && content[at + matched] == find[matched] {
      matched = matched + usize.ONE
    }
    if matched == find.length { return Option<usize>.some(at) }
    at = at + usize.ONE
  }
  return Option<usize>.none()
}

/// The module text after `edit`'s replacement, or none when its `find` text does not occur
/// exactly once in `content`.
pub effect fn apply(content: &[u8], edit: &Edit) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let find = Bytes.asSlice(&edit.find)
  let start = match move occurrence(content, find, usize.ZERO) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Option<Bytes>.none() }
  }
  if let Option<usize>.Some {..} = move occurrence(content, find, start + usize.ONE) { return Option<Bytes>.none() }
  let mut edited = run Bytes.copy(Slice.view<u8>(content, usize.ZERO, start))
  run Bytes.append(&mut edited, Bytes.asSlice(&edit.replace))
  let end = start + find.length
  run Bytes.append(&mut edited, Slice.view<u8>(content, end, content.length - end))
  return Option<Bytes>.some(move edited)
}
