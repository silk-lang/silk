//! Manifest diagnostics from the same typed schema used by task graphs and external tools.

import CompilerBug
import driver.ManifestFields
import driver.ManifestText
import ReleaseVersion
import lexer.Span { Span }
import silk.build.manifest { Manifest }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.usize
import silk.schema.schema { SchemaReader, Schemas }
import silk.schema.shape { Shapes, Shape, ShapeRef }
import silk.schema.path { SchemaPath, PathSegment }
import silk.schema.toml { TomlSchemaReader }
import silk.schema.issue { Issue, IssueReason }
import silk.text.string { String }
import silk.toml.scanner { TomlError, TomlScanner, TomlToken }
import silk.toml.text { TomlText }
import silk.toml.value { Toml, Value as TomlValue }

/// One manifest refusal, with a half-open byte range in the original TOML.
pub struct Diagnostic {
  pub span: Span,
  pub code: Bytes,
  pub message: Bytes
}

/// Parses once and diagnoses syntax or manifest structure, preserving source locations.
pub effect fn diagnose(text: &[u8]) -> List<Diagnostic>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move run Effect.result(Toml.parse(text)) {
    Result<TomlValue, TomlError | OutOfMemoryError>.Success { value } => run validate(text, &value)
    Result<TomlValue, TomlError | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      TomlError problem => {
        let mut result = List<Diagnostic>.make()
        let mut message = Bytes.make()
        run ManifestText.appendTomlReason(&mut message, text, &problem)
        let end = if problem.offset < text.length {
          problem.offset + 1
        } else {
          problem.offset
        }
        run result.append(
          Diagnostic {
            span: Span { start: problem.offset, end: end },
            code: run Bytes.copy(b"TOML"),
            message: move message,
          },
        )
        move result
      }
    }
  }
}

/// Validates a parsed manifest against silk.build.manifest without converting its values to JSON.
/// Opaque tool tables retain arbitrary TOML values. Unknown fields precede invalid values, with
/// each group in source order; missing values select their containing table.
pub effect fn validate(text: &[u8], document: &TomlValue) -> List<Diagnostic>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut reader = TomlSchemaReader.collectingAll(document)
  let read = run Effect.result(Schemas.read<Manifest>(&mut reader))
  match move read {
    Result<Manifest, Issue | OutOfMemoryError>.Success { value } => {
      drop value
    }
    Result<Manifest, Issue | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      Issue issue => {
        if issue.reason != IssueReason.Reported {
          let reported = run Effect.result(SchemaReader.report(&mut reader, issue))
          if let Result<(), Issue | OutOfMemoryError>.Failure { error: failure } = move reported {
            match move failure {
              OutOfMemoryError exhausted => {
                fail move exhausted
              }
              Issue _ => {}
            }
          }
        }
      }
    }
  }
  let errors = reader.intoErrors()
  let mut result = List<Diagnostic>.make()
  if errors.length() == 0 {
    return move result
  }
  let locations = run sourceLocations(text)
  let hint = run versionHint(document)
  let shapes = run Schemas.shape<Manifest>()
  let listed = errors.asSlice()
  let mut problems = List<Problem>.make()
  let mut at: usize = 0
  while at < listed.length {
    let error = &listed[at]
    let pointer = run error.path.pointer()
    let span = location(locations.asSlice(), String.ownedUtf8Bytes(&pointer), text.length)
    let written = run error.path.text()
    let mut message = run Bytes.copy(String.ownedUtf8Bytes(&written))
    let unknown = error.issue.reason == IssueReason.UnexpectedKey
    if unknown {
      run message.append(b" is not a supported field")
      if let Option<String>.Some { value: suggestion } = move run suggest(
        &shapes,
        &error.path,
        document,
      ) {
        run message.append(b"; did you mean ")
        let mut parent = run error.path.copy()
        parent.pop()
        let parentText = run parent.text()
        if parentText.view() != "" {
          run message.append(String.ownedUtf8Bytes(&parentText))
          run message.append(b".")
        }
        run message.append(String.ownedUtf8Bytes(&suggestion))
        run message.append(b"?")
      }
    } else {
      if written.view() != "" {
        run message.append(b": ")
      }
      run message.append(b"expected ")
      run message.append(String.utf8Bytes(error.issue.expected))
      run message.append(b", got ")
      run message.append(String.utf8Bytes(error.issue.found.noun()))
    }
    run message.append(hint.asSlice())
    let rank: usize = if unknown {
      0
    } else {
      1
    }
    let place = placeOf(problems.asSlice(), rank, span.start)
    run problems.insert(place, Problem { rank: rank, span: span, message: move message })
    at = at + 1
  }
  let worded = problems.asSlice()
  at = 0
  while at < worded.length {
    run result.append(
      Diagnostic {
        span: worded[at].span,
        code: run Bytes.copy(b"MANIFEST_SCHEMA"),
        message: run Bytes.copy(worded[at].message.asSlice()),
      },
    )
    at = at + 1
  }
  return move result
}

struct Problem {
  rank: usize,
  span: Span,
  message: Bytes
}

fn placeOf(problems: &[Problem], rank: usize, start: usize) -> usize {
  let mut at: usize = 0
  while at < problems.length {
    if rank < problems[at].rank || (rank == problems[at].rank && start < problems[at].span.start) {
      return at
    }
    at = at + 1
  }
  return at
}

fn concrete(shapes: &Shapes, node: ShapeRef) -> ShapeRef {
  let mut selected = node
  while true {
    match &shapes.get(selected).* {
      Shape.Optional { value } => {
        selected = value
      }
      Shape.Custom { wire, .. } => {
        selected = wire
      }
      _ => {
        return selected
      }
    }
  }
}

// Suggestions come from the typed shape's field names, excluding names already present.
effect fn suggest(shapes: &Shapes, path: &SchemaPath, document: &TomlValue) -> Option<String>
  ! OutOfMemoryError
  ? &mut Allocator {
  let parts = path.segments()
  if parts.length == 0 {
    return Option<String>.none()
  }
  let mut node = shapes.root()
  let mut source = Option<&TomlValue>.some(document)
  let mut at: usize = 0
  while at + 1 < parts.length {
    node = concrete(shapes, node)
    let mut selected = Option<ShapeRef>.none()
    match &parts[at] {
      PathSegment.Index { at: index } => {
        if let Shape.List { element } = &shapes.get(node).* {
          selected = Option<ShapeRef>.some(element)
        }
        if let Option<&TomlValue>.Some { value } = source {
          source = Toml.item(value, index)
        }
      }
      _ => {
        let key = segmentName(&parts[at])
        match &shapes.get(node).* {
          Shape.Dictionary { value } => {
            selected = Option<ShapeRef>.some(value)
          }
          Shape.Object { fields, .. } => {
            let listed = fields.asSlice()
            let mut field: usize = 0
            while field < listed.length {
              if listed[field].wire == key {
                selected = Option<ShapeRef>.some(listed[field].value)
              }
              field = field + 1
            }
          }
          _ => {}
        }
        source = Toml.fieldAt(source, key)
      }
    }
    node = match selected {
      Option<ShapeRef>.Some { value } => value
      Option<ShapeRef>.None => {
        return Option<String>.none()
      }
    }
    at = at + 1
  }
  let mut names = List<&[u8]>.make()
  if let Shape.Object { fields, .. } = &shapes.get(concrete(shapes, node)).* {
    let listed = fields.asSlice()
    let mut field: usize = 0
    while field < listed.length {
      if !Toml.fieldAt(source, listed[field].wire).isSome() {
        run names.append(String.utf8Bytes(listed[field].wire))
      }
      field = field + 1
    }
  }
  let found = run ManifestText.closest(
    String.utf8Bytes(segmentName(&parts[parts.length - 1])),
    names.asSlice(),
  )
  if found == usize.MAX {
    return Option<String>.none()
  }
  let bytes = names.asSlice()[found]
  return Option<String>.some(run String.copy(unsafe Intrinsic.stringFromUtf8Unchecked(bytes)))
}

fn segmentName<'a>(part: &'a PathSegment) -> string<'a> {
  return match &part.* {
    PathSegment.Field { wire, .. } => wire
    PathSegment.Variant { wire, .. } => wire
    PathSegment.Key { name } => name.view()
    PathSegment.Index { .. } => ""
  }
}

effect fn versionHint(document: &TomlValue) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut hint = Bytes.make()
  let mut pin = Toml.asString(Toml.fieldAt(Toml.field(document, "workspace"), "silk-version"))
  if let Option<string>.None = pin {
    pin = Toml.asString(Toml.fieldAt(Toml.field(document, "package"), "silk-version"))
  }
  if let Option<string>.Some { value: written } = move pin {
    let pinned = String.utf8Bytes(written)
    if !ManifestFields.compatible(ReleaseVersion.value(), pinned) {
      run Bytes.append(&mut hint, b"; the manifest pins Silk ")
      run Bytes.append(&mut hint, pinned)
      run Bytes.append(&mut hint, b" with silk-version, and this is Silk ")
      run Bytes.append(&mut hint, ReleaseVersion.value())
      run Bytes.append(&mut hint, b": build it with Silk ")
      run Bytes.append(&mut hint, pinned)
      run Bytes.append(&mut hint, b" (silk use installs it)")
    }
  }
  return move hint
}

struct Location {
  path: Bytes,
  span: Span
}

struct ArrayTable {
  path: Bytes,
  index: usize
}

struct Tokens<'a> {
  scanner: TomlScanner<'a>,
  token: TomlToken,
  start: usize,
  end: usize
}

fn next(tokens: &mut Tokens<'_>) -> () {
  tokens.token = match move TomlScanner.next(&mut tokens.scanner) {
    Result<TomlToken, TomlError>.Success { value } => value
    Result<TomlToken, TomlError>.Failure { .. } => CompilerBug.panic(
      b"validated TOML cannot be tokenized",
    )
  }
  tokens.end = TomlScanner.offset(&tokens.scanner)
  tokens.start = tokens.end
  match tokens.token {
    TomlToken.Text { span } => {
      tokens.start = span.offset
    }
    TomlToken.String { span, .. } => {
      tokens.start = span.offset
    }
    TomlToken.EndOfInput => {}
    _ => {
      if tokens.start > 0 {
        tokens.start = tokens.start - 1
      }
    }
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + 1
  }
  return true
}

fn prefix(parent: &[u8], child: &[u8]) -> bool {
  return parent.length <= child.length && same(parent, Slice.view<u8>(child, 0, parent.length))
    && (parent.length == child.length || child[parent.length] == 47)
}

effect fn segment(path: &mut Bytes, key: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run Bytes.append(&mut path.*, b"/")
  let mut at: usize = 0
  while at < key.length {
    if key[at] == 126 {
      run Bytes.append(&mut path.*, b"~0")
    } else if key[at] == 47 {
      run Bytes.append(&mut path.*, b"~1")
    } else {
      run Bytes.append(&mut path.*, Slice.view<u8>(key, at, 1))
    }
    at = at + 1
  }
}

effect fn indexPath(path: &mut Bytes, index: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run Bytes.append(&mut path.*, b"/")
  run decimal(&mut path.*, index)
}

effect fn decimal(out: &mut Bytes, value: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value >= 10 {
    run decimal(&mut out.*, value / 10)
  }
  let digit = [usize.toU8(value % 10) + 48]
  run Bytes.append(&mut out.*, &digit)
}

// Consume key tokens, not values. The scanner keeps bare dotted keys in one Text token;
// quoted components are decoded with the same TomlText implementation as the TOML parser.
effect fn keys(tokens: &mut Tokens<'_>) -> List<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut parts = List<Bytes>.make()
  while true {
    match tokens.token {
      TomlToken.Text { span } => {
        let text = TomlScanner.slice(&tokens.scanner, span)
        let mut start: usize = 0
        let mut at: usize = 0
        while at <= text.length {
          if at == text.length || text[at] == 46 {
            if at > start {
              run List<Bytes>.append(
                &mut parts,
                run Bytes.copy(Slice.view<u8>(text, start, at - start)),
              )
            }
            start = at + 1
          }
          at = at + 1
        }
      }
      TomlToken.String { span, literal, multiline } => {
        run List<Bytes>.append(
          &mut parts,
          run TomlText.decode(TomlScanner.slice(&tokens.scanner, span), literal, multiline),
        )
      }
      TomlToken.Dot => {}
      _ => {
        return move parts
      }
    }
    next(&mut tokens.*)
  }
}

effect fn remember(locations: &mut List<Location>, path: &[u8], span: Span) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run List<Location>.append(&mut locations.*, Location { path: run Bytes.copy(path), span: span })
}

// A later dotted definition must not replace the source of an already explicit parent table.
effect fn rememberParent(locations: &mut List<Location>, path: &[u8], span: Span) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let existing = List<Location>.asSlice(&locations.*)
  let mut at: usize = 0
  while at < existing.length {
    if same(Bytes.asSlice(&existing[at].path), path) {
      return
    }
    at = at + 1
  }
  run remember(&mut locations.*, path, span)
}

// Records delimiters and scalar token spans, without decoding or reparsing any TOML value.
effect fn valueLocations(tokens: &mut Tokens<'_>, path: &[u8], locations: &mut List<Location>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let start = tokens.start
  let mut end = tokens.end
  match tokens.token {
    TomlToken.ArrayBegin => {
      next(&mut tokens.*)
      let mut index: usize = 0
      while true {
        match tokens.token {
          TomlToken.ArrayEnd => {
            end = tokens.end
            next(&mut tokens.*)
            break
          }
          TomlToken.Newline => {
            next(&mut tokens.*)
          }
          TomlToken.Comma => {
            next(&mut tokens.*)
          }
          TomlToken.EndOfInput => {
            CompilerBug.panic(b"validated TOML array has no closing bracket")
          }
          _ => {
            let mut child = run Bytes.copy(path)
            run indexPath(&mut child, index)
            run valueLocations(&mut tokens.*, Bytes.asSlice(&child), &mut locations.*)
            index = index + 1
          }
        }
      }
    }
    TomlToken.InlineBegin => {
      next(&mut tokens.*)
      while true {
        match tokens.token {
          TomlToken.InlineEnd => {
            end = tokens.end
            next(&mut tokens.*)
            break
          }
          TomlToken.Newline => {
            next(&mut tokens.*)
          }
          TomlToken.Comma => {
            next(&mut tokens.*)
          }
          TomlToken.EndOfInput => {
            CompilerBug.panic(b"validated TOML inline table has no closing brace")
          }
          _ => {
            run assignment(&mut tokens.*, path, &mut locations.*)
          }
        }
      }
    }
    _ => {
      next(&mut tokens.*)
    }
  }
  run remember(&mut locations.*, path, Span { start: start, end: end })
}

effect fn assignment(tokens: &mut Tokens<'_>, table: &[u8], locations: &mut List<Location>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let start = tokens.start
  let parts = run keys(&mut tokens.*)
  let names = List<Bytes>.asSlice(&parts)
  let keyEnd = tokens.start
  let mut path = run Bytes.copy(table)
  let mut at: usize = 0
  while at < names.length {
    run segment(&mut path, Bytes.asSlice(&names[at]))
    if at + 1 < names.length {
      run rememberParent(&mut locations.*, Bytes.asSlice(&path), Span { start: start, end: keyEnd })
    }
    at = at + 1
  }
  match tokens.token {
    TomlToken.Equals => {}
    _ => {
      CompilerBug.panic(b"validated TOML assignment has no equals token")
    }
  }
  next(&mut tokens.*)
  run valueLocations(&mut tokens.*, Bytes.asSlice(&path), &mut locations.*)
}

effect fn sourceLocations(text: &[u8]) -> List<Location>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut tokens = Tokens {
    scanner: TomlScanner.make(text),
    token: TomlToken.EndOfInput,
    start: 0,
    end: 0,
  }
  let mut locations = List<Location>.make()
  let mut arrays = List<ArrayTable>.make()
  let mut table = Bytes.make()
  next(&mut tokens)
  while true {
    match tokens.token {
      TomlToken.EndOfInput => {
        return move locations
      }
      TomlToken.Newline => {
        next(&mut tokens)
      }
      TomlToken.ArrayBegin => {
        let start = tokens.start
        next(&mut tokens)
        let array = match tokens.token {
          TomlToken.ArrayBegin => true
          _ => false
        }
        if array {
          next(&mut tokens)
        }
        let parts = run keys(&mut tokens)
        let mut end = tokens.end
        next(&mut tokens)
        if array {
          end = tokens.end
          next(&mut tokens)
        }
        table = Bytes.make()
        let names = List<Bytes>.asSlice(&parts)
        let mut at: usize = 0
        while at < names.length {
          run segment(&mut table, Bytes.asSlice(&names[at]))
          if at + 1 == names.length {
            run remember(&mut locations, Bytes.asSlice(&table), Span { start: start, end: end })
          } else {
            run rememberParent(
              &mut locations,
              Bytes.asSlice(&table),
              Span { start: start, end: end },
            )
          }
          let mut found = usize.MAX
          let known = List<ArrayTable>.asSlice(&arrays)
          let mut i: usize = 0
          while i < known.length {
            if same(Bytes.asSlice(&known[i].path), Bytes.asSlice(&table)) {
              found = i
              break
            }
            i = i + 1
          }
          if array && at + 1 == names.length {
            if found == usize.MAX {
              found = List<ArrayTable>.length(&arrays)
              run List<ArrayTable>.append(
                &mut arrays,
                ArrayTable { path: run Bytes.copy(Bytes.asSlice(&table)), index: 0 },
              )
            } else {
              let stored = List<ArrayTable>.asMutSlice(&mut arrays)
              stored[found].index = stored[found].index + 1
            }
          }
          if found != usize.MAX {
            let index = List<ArrayTable>.asSlice(&arrays)[found].index
            run indexPath(&mut table, index)
            if at + 1 == names.length {
              run remember(&mut locations, Bytes.asSlice(&table), Span { start: start, end: end })
            } else {
              run rememberParent(
                &mut locations,
                Bytes.asSlice(&table),
                Span { start: start, end: end },
              )
            }
          }
          at = at + 1
        }
      }
      _ => {
        run assignment(&mut tokens, Bytes.asSlice(&table), &mut locations)
      }
    }
  }
}

fn location(locations: &[Location], path: &[u8], length: usize) -> Span {
  let mut best: usize = 0
  let mut span = Span { start: 0, end: length }
  let mut at: usize = 0
  while at < locations.length {
    let candidate = Bytes.asSlice(&locations[at].path)
    if candidate.length >= best && prefix(candidate, path) {
      best = candidate.length
      span = locations[at].span
    }
    at = at + 1
  }
  return span
}
