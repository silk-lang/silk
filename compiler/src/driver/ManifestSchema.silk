//! Structural manifest diagnostics from the embedded Draft 2020-12 schema.
//! TOML syntax uses `TOML`; schema and JSON data-model failures use `MANIFEST_SCHEMA`.
//! The root `tool` member is deliberately excluded before conversion: its TOML values are opaque.

import CompilerBug
import driver.ManifestFields
import driver.ManifestText
import ReleaseVersion
import lexer.Span { Span }
import silk.build.source { Source }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.json.schema { JsonSchema, Draft, Output, JsonSchemaError, Diagnostic as SchemaDiagnostic }
import silk.json.schema_resolver { SchemaResolver, SchemaRegistry, SchemaResolutionError }
import silk.json.schema_value { SchemaValue, ValueError }
import silk.json.value { Json, Value, JsonEntry }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.box { Box }
import silk.num.u8
import silk.num.usize
import silk.text.regex { RegexError }
import silk.text.string { String }
import silk.toml.scanner { TomlError, TomlScanner, TomlToken }
import silk.toml.text { TomlText }
import silk.toml.value { Toml, Value as TomlValue, TomlChild }

/// One user-facing manifest refusal, with a half-open byte range in the original TOML.
/// Existing instance values select their tokens; missing fields select the containing table.
/// `propertyNames` failures select the containing object, as JSON Schema basic output does not
/// identify the offending property. Syntax uses `TOML`, other user invalidity `MANIFEST_SCHEMA`.
pub struct Diagnostic {
  pub span: Span,
  pub code: Bytes,
  pub message: Bytes,
}

/// Parses once and diagnoses syntax or manifest structure. Only allocation failure escapes.
pub effect fn diagnose(text: &[u8]) -> List<Diagnostic> ! OutOfMemoryError ? &mut Allocator {
  let parsed = run Effect.result(Toml.parse(text))
  return match move parsed {
    Result<TomlValue, TomlError | OutOfMemoryError>.Success { value } => run validate(text, &value)
    Result<TomlValue, TomlError | OutOfMemoryError>.Failure { error } => match move error {
      TomlError problem => {
        let mut diagnostics = List<Diagnostic>.make()
        let mut message = Bytes.make()
        run ManifestText.appendTomlReason(&mut message, text, &problem)
        let mut end = problem.offset
        if end < text.length { end = end + 1 }
        run List<Diagnostic>.append(&mut diagnostics, Diagnostic {
          span: Span { start: problem.offset, end: end }, code: run Bytes.copy(b"TOML"), message: move message,
        })
        move diagnostics
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

/// Validates the already parsed `document` corresponding to `text`, without reparsing TOML.
/// Numbers retain their exact spelling and magnitude. Nonfinite numbers outside `tool` are
/// diagnosed as JSON data-model incompatibilities; schema/evaluator faults are compiler bugs.
/// Each failure is worded in the manifest's own terms, such as `package.nmae is not a supported
/// field; did you mean package.name?`. Unknown fields come first, then other refused values, then
/// values that match none of a field's accepted forms; each group keeps source order. Failures
/// inside the alternatives of a field are left out, as only the field's own verdict is certain.
/// When the manifest's `silk-version` pins a Silk this compiler cannot stand in for, each message
/// also says so, since a later Silk may accept what this one refuses.
pub effect fn validate(text: &[u8], document: &TomlValue) -> List<Diagnostic>
  ! OutOfMemoryError ? &mut Allocator {
  let converted = run Effect.result(instance(document))
  let value = match move converted {
    Result<Value, ValueError | OutOfMemoryError>.Success { value } => move value
    Result<Value, ValueError | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError exhausted => { fail move exhausted }
      ValueError problem => { return run conversionDiagnostics(text, problem) }
    }
  }
  let parsed = run Effect.result(SchemaValue.parseToml(Source.read("manifest.schema.toml")))
  let schema = match move parsed {
    Result<Value, TomlError | ValueError | OutOfMemoryError>.Success { value: tree } => move tree
    Result<Value, TomlError | ValueError | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError exhausted => { fail move exhausted }
      _ => CompilerBug.panic(b"embedded manifest schema is not valid TOML")
    }
  }
  let evaluated = run Effect.result(evaluate(&schema, &value))
  let output = match move evaluated {
    Result<Output, JsonSchemaError | SchemaResolutionError | RegexError | OutOfMemoryError>.Success { value: result } => move result
    Result<Output, JsonSchemaError | SchemaResolutionError | RegexError | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError exhausted => { fail move exhausted }
      _ => CompilerBug.panic(b"embedded manifest schema compilation or evaluation failed")
    }
  }
  let mut diagnostics = List<Diagnostic>.make()
  if output.valid { return move diagnostics }
  let locations = run sourceLocations(text)
  let listed = List<Location>.asSlice(&locations)
  let hint = run versionHint(document)
  let errors = List<SchemaDiagnostic>.asSlice(&output.errors)
  let mut problems = List<Problem>.make()
  let mut at: usize = 0
  while at < errors.length {
    let error = &errors[at]
    let keyword = String.utf8Bytes(String.view(&error.keywordLocation))
    if !speculative(keyword) && !aggregate(lastSegment(keyword), String.utf8Bytes(String.view(&error.error))) {
      let path = String.utf8Bytes(String.view(&error.instanceLocation))
      let span = location(listed, path, text.length)
      let mut message = Bytes.make()
      let rank = run word(&mut message, text, span, &schema, &value, error)
      run Bytes.append(&mut message, Bytes.asSlice(&hint))
      let known = List<Problem>.asSlice(&problems)
      if !reported(known, span, Bytes.asSlice(&message)) {
        let place = placeOf(known, rank, span.start)
        run List<Problem>.insert(&mut problems, place, Problem { rank: rank, span: span, message: move message })
      }
    }
    at = at + 1
  }
  let worded = List<Problem>.asSlice(&problems)
  at = 0
  while at < worded.length {
    run List<Diagnostic>.append(&mut diagnostics, Diagnostic {
      span: worded[at].span, code: run Bytes.copy(b"MANIFEST_SCHEMA"), message: run Bytes.copy(Bytes.asSlice(&worded[at].message)),
    })
    at = at + 1
  }
  if List<Diagnostic>.length(&diagnostics) == 0 && errors.length > 0 {
    // Every failure was inside an alternative; report the first as the evaluator words it.
    let path = String.utf8Bytes(String.view(&errors[0].instanceLocation))
    let mut message = Bytes.make()
    run appendPath(&mut message, &value, path)
    run Bytes.append(&mut message, b" is not accepted: ")
    run Bytes.append(&mut message, String.utf8Bytes(String.view(&errors[0].error)))
    run Bytes.append(&mut message, Bytes.asSlice(&hint))
    run List<Diagnostic>.append(&mut diagnostics, Diagnostic {
      span: location(listed, path, text.length), code: run Bytes.copy(b"MANIFEST_SCHEMA"), message: move message,
    })
  }
  return move diagnostics
}

// The compiled schema borrows `schema`; it is dropped before this frame returns.
effect fn evaluate(schema: &Value, instance: &Value) -> Output
  ! JsonSchemaError | SchemaResolutionError | RegexError | OutOfMemoryError ? &mut Allocator {
  let mut registry = SchemaRegistry.make()
  let compiled = run JsonSchema.compile(schema, "https://silklang.org/schemas/manifest",
    JsonSchema.options(Draft.Draft202012)) |> Effect.provideMut<SchemaResolver>(&mut registry)
  return run JsonSchema.validate(&compiled, instance)
}

// One worded failure. Lower ranks are reported first: 0 an unknown field, 1 another refused
// value, 2 a value that matches none of the forms its field accepts.
struct Problem { rank: usize, span: Span, message: Bytes }

// Whether `problems` already holds `message` at `span`, as two failures can word alike.
fn reported(problems: &[Problem], span: Span, message: &[u8]) -> bool {
  let mut at: usize = 0
  while at < problems.length {
    if problems[at].span.start == span.start && problems[at].span.end == span.end
      && same(Bytes.asSlice(&problems[at].message), message) { return true }
    at = at + 1
  }
  return false
}

// Where a problem of `rank` starting at `start` goes in the sorted `problems`.
fn placeOf(problems: &[Problem], rank: usize, start: usize) -> usize {
  let mut at: usize = 0
  while at < problems.length {
    if problems[at].rank > rank || (problems[at].rank == rank && problems[at].span.start > start) { return at }
    at = at + 1
  }
  return problems.length
}

// Whether the keyword at evaluation path `keyword` sits inside one alternative of a `oneOf` or
// `anyOf`. Such a failure only says that alternative did not match, not what is wrong.
fn speculative(keyword: &[u8]) -> bool {
  return contains(keyword, b"/oneOf/") || contains(keyword, b"/anyOf/")
}

// Whether a failure of keyword `last` only collects the failures below it, which are reported on
// their own. `additionalProperties` is a leaf when its subschema is `false`: an unknown field.
fn aggregate(last: &[u8], error: &[u8]) -> bool {
  if same(last, b"additionalProperties") { return !same(error, b"boolean schema is false") }
  return same(last, b"allOf") || same(last, b"$ref") || same(last, b"properties")
    || same(last, b"patternProperties") || same(last, b"items") || same(last, b"prefixItems")
    || same(last, b"then") || same(last, b"else") || same(last, b"if") || same(last, b"propertyNames")
    || same(last, b"dependentSchemas") || same(last, b"contains")
}

fn contains(text: &[u8], part: &[u8]) -> bool {
  let mut at: usize = 0
  while at + part.length <= text.length {
    if same(Slice.view<u8>(text, at, part.length), part) { return true }
    at = at + 1
  }
  return false
}

// The last segment of the JSON Pointer `pointer`, still escaped.
fn lastSegment(pointer: &[u8]) -> &[u8] {
  let mut start = pointer.length
  while start > 0 && pointer[start - 1] != 47 { start = start - 1 }
  return Slice.view<u8>(pointer, start, pointer.length - start)
}

// `pointer` without its last segment.
fn parentPointer(pointer: &[u8]) -> &[u8] {
  let mut end = pointer.length
  while end > 0 && pointer[end - 1] != 47 { end = end - 1 }
  if end == 0 { return pointer }
  return Slice.view<u8>(pointer, 0, end - 1)
}

// The JSON Pointer fragment of the absolute keyword location `absolute`, or empty without one.
fn fragment(absolute: &[u8]) -> &[u8] {
  let mut at: usize = 0
  while at < absolute.length {
    if absolute[at] == 35 { return Slice.view<u8>(absolute, at + 1, absolute.length - at - 1) }
    at = at + 1
  }
  return Slice.view<u8>(absolute, 0, 0)
}

// The member `key` of the object `value`.
fn member<'a>(value: &'a Value, key: &[u8]) -> Option<&'a Value> {
  match &value.* {
    Value.Object { entries } => {
      let members = List<JsonEntry>.asSlice(&entries)
      let mut at: usize = 0
      while at < members.length {
        if same(String.utf8Bytes(String.view(&members[at].key)), key) { return Option<&'a Value>.some(&members[at].value) }
        at = at + 1
      }
    }
    _ => {}
  }
  return Option<&'a Value>.none()
}

// The decimal array index `segment`, or `usize.MAX` when it is not one.
fn index(segment: &[u8]) -> usize {
  if segment.length == 0 || segment.length > 9 { return usize.MAX }
  let mut value: usize = 0
  let mut at: usize = 0
  while at < segment.length {
    if segment[at] < 48 || segment[at] > 57 { return usize.MAX }
    value = value * 10 + u8.toUsize(segment[at] - 48)
    at = at + 1
  }
  return value
}

// The JSON Pointer segment `segment` with `~1` and `~0` decoded.
effect fn unescaped(segment: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut out = Bytes.make()
  let mut at: usize = 0
  while at < segment.length {
    if segment[at] == 126 && at + 1 < segment.length && segment[at + 1] == 49 {
      run Bytes.append(&mut out, b"/")
      at = at + 2
    } else if segment[at] == 126 && at + 1 < segment.length && segment[at + 1] == 48 {
      run Bytes.append(&mut out, b"~")
      at = at + 2
    } else {
      run Bytes.append(&mut out, Slice.view<u8>(segment, at, 1))
      at = at + 1
    }
  }
  return move out
}

// One step down from `value`: the member or element the escaped segment `segment` names.
effect fn child<'a>(value: &'a Value, segment: &[u8]) -> Option<&'a Value> ! OutOfMemoryError ? &mut Allocator {
  match &value.* {
    Value.Array {..} => {
      let at = index(segment)
      if at == usize.MAX { return Option<&'a Value>.none() }
      return Json.item(value, at)
    }
    _ => {
      let key = run unescaped(segment)
      return member(value, Bytes.asSlice(&key))
    }
  }
}

// The value the JSON Pointer `pointer` names below `root`.
effect fn pointed<'a>(root: &'a Value, pointer: &[u8]) -> Option<&'a Value> ! OutOfMemoryError ? &mut Allocator {
  let mut current = root
  let mut start: usize = 1
  if pointer.length == 0 { return Option<&'a Value>.some(current) }
  let mut at: usize = 1
  while at <= pointer.length {
    if at == pointer.length || pointer[at] == 47 {
      match move run child(current, Slice.view<u8>(pointer, start, at - start)) {
        Option<&'a Value>.Some { value } => { current = value }
        Option<&'a Value>.None => { return Option<&'a Value>.none() }
      }
      start = at + 1
    }
    at = at + 1
  }
  return Option<&'a Value>.some(current)
}

// Whether `key` can be written bare in a dotted TOML key.
fn bare(key: &[u8]) -> bool {
  if key.length == 0 { return false }
  let mut at: usize = 0
  while at < key.length {
    let byte = key[at]
    if !(byte >= 48 && byte <= 57 || byte >= 65 && byte <= 90 || byte >= 97 && byte <= 122 || byte == 45 || byte == 95) { return false }
    at = at + 1
  }
  return true
}

// Appends the instance location `pointer` below `root` as the manifest spells it, such as
// `native.link[0].os`, or `manifest` for the whole document.
effect fn appendPath(out: &mut Bytes, root: &Value, pointer: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  if pointer.length == 0 {
    run Bytes.append(&mut out.*, b"manifest")
    return
  }
  let mut current = Option<&Value>.some(root)
  let mut first = true
  let mut start: usize = 1
  let mut at: usize = 1
  while at <= pointer.length {
    if at == pointer.length || pointer[at] == 47 {
      let segment = Slice.view<u8>(pointer, start, at - start)
      let mut element = false
      if let Option<&Value>.Some { value: parent } = current {
        match &parent.* {
          Value.Array {..} => { element = true }
          _ => {}
        }
        current = run child(parent, segment)
      }
      if element {
        run Bytes.append(&mut out.*, b"[")
        run Bytes.append(&mut out.*, segment)
        run Bytes.append(&mut out.*, b"]")
      } else {
        if !first { run Bytes.append(&mut out.*, b".") }
        let key = run unescaped(segment)
        if bare(Bytes.asSlice(&key)) { run Bytes.append(&mut out.*, Bytes.asSlice(&key)) }
        else {
          run Bytes.append(&mut out.*, b"\"")
          run Bytes.append(&mut out.*, Bytes.asSlice(&key))
          run Bytes.append(&mut out.*, b"\"")
        }
      }
      first = false
      start = at + 1
    }
    at = at + 1
  }
}

// Appends a scalar schema value as TOML writes it: a quoted string, a boolean or an integer.
effect fn appendScalar(out: &mut Bytes, value: &Value) -> () ! OutOfMemoryError ? &mut Allocator {
  match &value.* {
    Value.String { text } => {
      run Bytes.append(&mut out.*, b"\"")
      run Bytes.append(&mut out.*, String.utf8Bytes(String.view(&text)))
      run Bytes.append(&mut out.*, b"\"")
    }
    Value.Bool { value: flag } => { run Bytes.append(&mut out.*, if flag { b"true" } else { b"false" }) }
    Value.Number { value: number } => {
      match Json.asUsizeNumber(&number) {
        Option<usize>.Some { value: whole } => { run decimal(&mut out.*, whole) }
        Option<usize>.None => { run Bytes.append(&mut out.*, b"a number") }
      }
    }
    _ => { run Bytes.append(&mut out.*, b"a value") }
  }
}

// Appends the schema type name `name` as TOML calls it, with its article.
effect fn appendType(out: &mut Bytes, name: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  if same(name, b"object") { run Bytes.append(&mut out.*, b"a table") }
  else if same(name, b"array") { run Bytes.append(&mut out.*, b"an array") }
  else if same(name, b"integer") { run Bytes.append(&mut out.*, b"an integer") }
  else if same(name, b"string") { run Bytes.append(&mut out.*, b"a string") }
  else if same(name, b"boolean") { run Bytes.append(&mut out.*, b"a boolean") }
  else if same(name, b"number") { run Bytes.append(&mut out.*, b"a number") }
  else { run Bytes.append(&mut out.*, name) }
}

// Appends each of `values` with `appendScalar`, or each type name with `appendType`, joined as
// `a, b or c`.
effect fn appendChoices(out: &mut Bytes, values: &Value, types: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  match &values.* {
    Value.Array { values: listed } => {
      let items = List<Value>.asSlice(&listed)
      let mut at: usize = 0
      while at < items.length {
        if at > 0 {
          if at + 1 == items.length { run Bytes.append(&mut out.*, b" or ") }
          else { run Bytes.append(&mut out.*, b", ") }
        }
        if types {
          match &items[at] {
            Value.String { text } => { run appendType(&mut out.*, String.utf8Bytes(String.view(&text))) }
            _ => { run appendScalar(&mut out.*, &items[at]) }
          }
        } else { run appendScalar(&mut out.*, &items[at]) }
        at = at + 1
      }
    }
    Value.String { text } => {
      if types { run appendType(&mut out.*, String.utf8Bytes(String.view(&text))) }
      else { run appendScalar(&mut out.*, values) }
    }
    _ => { run appendScalar(&mut out.*, values) }
  }
}

// The `title` of the schema object at `pointer`, or of the alternative or negation it sits in:
// the noun phrase a refusal names, such as `a package name: ...`.
effect fn title<'a>(schema: &'a Value, pointer: &[u8]) -> Option<string<'a>> ! OutOfMemoryError ? &mut Allocator {
  let mut at = pointer
  // The root's own title describes the whole schema, never one failure.
  while at.length > 0 {
    if let Option<&'a Value>.Some { value: node } = move run pointed(schema, at) {
      if let Option<string<'a>>.Some { value: written } = move Json.asString(member(node, b"title")) {
        return Option<string<'a>>.some(written)
      }
    }
    let last = lastSegment(at)
    let parent = parentPointer(at)
    if same(last, b"not") || same(last, b"then") || same(last, b"else") {
      at = parent
    } else if index(last) != usize.MAX && (same(lastSegment(parent), b"allOf") || same(lastSegment(parent), b"anyOf") || same(lastSegment(parent), b"oneOf")) {
      at = parentPointer(parent)
    } else {
      break
    }
  }
  return Option<string<'a>>.none()
}

// Appends `; it is <value>` with the source spelling at `span`, when that is short and one line.
effect fn appendWritten(out: &mut Bytes, text: &[u8], span: Span) -> () ! OutOfMemoryError ? &mut Allocator {
  if span.end <= span.start || span.end > text.length || span.end - span.start > 64 { return }
  let written = Slice.view<u8>(text, span.start, span.end - span.start)
  let mut at: usize = 0
  while at < written.length {
    if written[at] == 10 || written[at] == 13 { return }
    at = at + 1
  }
  run Bytes.append(&mut out.*, b"; it is ")
  run Bytes.append(&mut out.*, written)
}

// Writes the manifest's wording of the schema failure `error` to `out`, and returns its rank.
// `span` is the source range of the failing value in `text`; `instance` is the whole manifest.
effect fn word(out: &mut Bytes, text: &[u8], span: Span, schema: &Value, instance: &Value, error: &SchemaDiagnostic) -> usize
  ! OutOfMemoryError ? &mut Allocator {
  let keyword = String.utf8Bytes(String.view(&error.keywordLocation))
  let path = String.utf8Bytes(String.view(&error.instanceLocation))
  let last = lastSegment(keyword)
  let pointer = fragment(String.utf8Bytes(String.view(&error.absoluteKeywordLocation)))
  let container = parentPointer(pointer)
  let constraint = run pointed(schema, pointer)
  if same(last, b"additionalProperties") {
    run appendPath(&mut out.*, instance, path)
    run Bytes.append(&mut out.*, b" is not a supported field")
    let written = run unescaped(lastSegment(path))
    if let Option<&Value>.Some { value: node } = move run pointed(schema, container) {
      if let Option<&Value>.Some { value: properties } = move member(node, b"properties") {
        if let Option<Bytes>.Some { value: nearest } = move run closest(Bytes.asSlice(&written), properties) {
          run Bytes.append(&mut out.*, b"; did you mean ")
          let parent = parentPointer(path)
          if parent.length > 0 {
            run appendPath(&mut out.*, instance, parent)
            run Bytes.append(&mut out.*, b".")
          }
          run Bytes.append(&mut out.*, Bytes.asSlice(&nearest))
          run Bytes.append(&mut out.*, b"?")
        }
      }
    }
    return 0
  }
  if contains(keyword, b"/propertyNames/") {
    run Bytes.append(&mut out.*, b"a name in ")
    run appendPath(&mut out.*, instance, path)
    run Bytes.append(&mut out.*, b" must be ")
    match move run title(schema, container) {
      Option<string>.Some { value: phrase } => { run Bytes.append(&mut out.*, String.utf8Bytes(phrase)) }
      Option<string>.None => { run Bytes.append(&mut out.*, b"of another form") }
    }
    return 1
  }
  run appendPath(&mut out.*, instance, path)
  if same(last, b"required") {
    run Bytes.append(&mut out.*, b" needs ")
    let mut named = false
    if let Option<&Value>.Some { value: required } = constraint {
      if let Option<&Value>.Some { value: table } = move run pointed(instance, path) {
        match &required.* {
          Value.Array { values } => {
            let keys = List<Value>.asSlice(&values)
            let mut at: usize = 0
            while at < keys.length && !named {
              if let Option<string>.Some { value: key } = move Json.asString(Option<&Value>.some(&keys[at])) {
                if let Option<&Value>.None = member(table, String.utf8Bytes(key)) {
                  run Bytes.append(&mut out.*, String.utf8Bytes(key))
                  named = true
                }
              }
              at = at + 1
            }
          }
          _ => {}
        }
      }
    }
    if !named { run Bytes.append(&mut out.*, b"another field") }
    return 1
  }
  if same(last, b"type") || same(last, b"enum") || same(last, b"const") {
    run Bytes.append(&mut out.*, b" must be ")
    if let Option<&Value>.Some { value: allowed } = constraint {
      run appendChoices(&mut out.*, allowed, same(last, b"type"))
    }
    run appendWritten(&mut out.*, text, span)
    return 1
  }
  if same(last, b"minimum") || same(last, b"maximum") || same(last, b"minItems") || same(last, b"maxItems")
    || same(last, b"minProperties") || same(last, b"maxProperties") {
    let mut bound: usize = usize.MAX
    if let Option<&Value>.Some { value: limit } = constraint {
      match &limit.* {
        Value.Number { value: number } => {
          if let Option<usize>.Some { value: whole } = move Json.asUsizeNumber(&number) { bound = whole }
        }
        _ => {}
      }
    }
    if bound == 0 && (same(last, b"maxItems") || same(last, b"maxProperties")) {
      run Bytes.append(&mut out.*, b" must be ")
      match move run title(schema, container) {
        Option<string>.Some { value: phrase } => { run Bytes.append(&mut out.*, String.utf8Bytes(phrase)) }
        Option<string>.None => { run Bytes.append(&mut out.*, b"empty") }
      }
    } else if same(last, b"minimum") || same(last, b"maximum") {
      run Bytes.append(&mut out.*, if same(last, b"minimum") { b" must be at least " } else { b" must be at most " })
      run decimal(&mut out.*, bound)
      run appendWritten(&mut out.*, text, span)
    } else {
      let fewest = same(last, b"minItems") || same(last, b"minProperties")
      run Bytes.append(&mut out.*, if fewest { b" needs at least " } else { b" takes at most " })
      run decimal(&mut out.*, bound)
      let items = same(last, b"minItems") || same(last, b"maxItems")
      if bound == 1 { run Bytes.append(&mut out.*, if items { b" entry" } else { b" field" }) }
      else { run Bytes.append(&mut out.*, if items { b" entries" } else { b" fields" }) }
    }
    return 1
  }
  let alternatives = same(last, b"oneOf") || same(last, b"anyOf")
  match move run title(schema, container) {
    Option<string>.Some { value: named } => {
      run Bytes.append(&mut out.*, b" must be ")
      run Bytes.append(&mut out.*, String.utf8Bytes(named))
    }
    Option<string>.None => {
      if alternatives { run Bytes.append(&mut out.*, b" matches none of the forms it accepts") }
      else {
        run Bytes.append(&mut out.*, b" is not accepted: ")
        run Bytes.append(&mut out.*, String.utf8Bytes(String.view(&error.error)))
      }
    }
  }
  if !alternatives { run appendWritten(&mut out.*, text, span) }
  return if alternatives { 2 } else { 1 }
}

// The key of `properties` closest to the unknown `written`, within a third of its length in
// edits (at least one): the suggestion for a misspelled field.
effect fn closest(written: &[u8], properties: &Value) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  match &properties.* {
    Value.Object { entries } => {
      let members = List<JsonEntry>.asSlice(&entries)
      let mut names = List<&[u8]>.make()
      let mut at: usize = 0
      while at < members.length {
        run List<&[u8]>.append(&mut names, String.utf8Bytes(String.view(&members[at].key)))
        at = at + 1
      }
      let found = run ManifestText.closest(written, List<&[u8]>.asSlice(&names))
      if found == usize.MAX { return Option<Bytes>.none() }
      return Option<Bytes>.some(run Bytes.copy(List<&[u8]>.asSlice(&names)[found]))
    }
    _ => { return Option<Bytes>.none() }
  }
}

// `; ...` naming the manifest's pinned Silk when this compiler cannot stand in for it, as a later
// Silk may add fields and values this one refuses. Empty for no pin or a compatible one.
effect fn versionHint(document: &TomlValue) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut hint = Bytes.make()
  let mut pin = Toml.asString(Toml.fieldAt(Toml.field(document, "workspace"), "silk-version"))
  if let Option<string>.None = pin { pin = Toml.asString(Toml.fieldAt(Toml.field(document, "package"), "silk-version")) }
  if let Option<string>.Some { value: written } = move pin {
    let pinned = String.utf8Bytes(written)
    if !ManifestFields.compatible(ReleaseVersion.value(), pinned) {
      run Bytes.append(&mut hint, b"; the manifest pins Silk ")
      run Bytes.append(&mut hint, pinned)
      run Bytes.append(&mut hint, b" with silk-version, and this is Silk ")
      run Bytes.append(&mut hint, ReleaseVersion.value())
      run Bytes.append(&mut hint, b": build it with Silk ")
      run Bytes.append(&mut hint, pinned)
      run Bytes.append(&mut hint, b" (silk use installs it)")
    }
  }
  return move hint
}

// Only the manifest-specific opaque member is projected away. All remaining conversion is owned
// by SchemaValue, including exact integers, decimals, and TOML dates and times.
effect fn instance(document: &TomlValue) -> Value ! ValueError | OutOfMemoryError ? &mut Allocator {
  let mut members = List<JsonEntry>.make()
  match &document.* {
    TomlValue.Table { entries, .. } => {
      let boxed = Box<List<TomlChild>>.get(&entries)
      let children = List<TomlChild>.asSlice(&boxed[0])
      let mut at: usize = 0
      while at < children.length {
        match &children[at] {
          TomlChild.Member { entry } => {
            if String.view(&entry.key) != "tool" {
              let value = run SchemaValue.fromToml(&entry.value)
              run List<JsonEntry>.append(&mut members, JsonEntry { key: run String.copy(String.view(&entry.key)), value: move value })
            }
          }
          _ => { fail ValueError.InvalidTomlValue }
        }
        at = at + 1
      }
    }
    _ => { fail ValueError.InvalidTomlValue }
  }
  return Value.Object { entries: move members }
}

struct Location { path: Bytes, span: Span }
struct ArrayTable { path: Bytes, index: usize }
struct Tokens<'a> { scanner: TomlScanner<'a>, token: TomlToken, start: usize, end: usize }

fn next(tokens: &mut Tokens<'_>) -> () {
  tokens.token = match move TomlScanner.next(&mut tokens.scanner) {
    Result<TomlToken, TomlError>.Success { value } => value
    Result<TomlToken, TomlError>.Failure {..} => CompilerBug.panic(b"validated TOML cannot be tokenized")
  }
  tokens.end = TomlScanner.offset(&tokens.scanner)
  tokens.start = tokens.end
  match tokens.token {
    TomlToken.Text { span } => { tokens.start = span.offset }
    TomlToken.String { span, .. } => { tokens.start = span.offset }
    TomlToken.EndOfInput => {}
    _ => { if tokens.start > 0 { tokens.start = tokens.start - 1 } }
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

fn prefix(parent: &[u8], child: &[u8]) -> bool {
  return parent.length <= child.length && same(parent, Slice.view<u8>(child, 0, parent.length))
    && (parent.length == child.length || child[parent.length] == 47)
}

effect fn segment(path: &mut Bytes, key: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run Bytes.append(&mut path.*, b"/")
  let mut at: usize = 0
  while at < key.length {
    if key[at] == 126 { run Bytes.append(&mut path.*, b"~0") }
    else if key[at] == 47 { run Bytes.append(&mut path.*, b"~1") }
    else { run Bytes.append(&mut path.*, Slice.view<u8>(key, at, 1)) }
    at = at + 1
  }
}

effect fn indexPath(path: &mut Bytes, index: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  run Bytes.append(&mut path.*, b"/")
  run decimal(&mut path.*, index)
}

effect fn decimal(out: &mut Bytes, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 { run decimal(&mut out.*, value / 10) }
  let digit = [usize.toU8(value % 10) + 48]
  run Bytes.append(&mut out.*, &digit)
}

// Consume key tokens, not values. The scanner keeps bare dotted keys in one Text token;
// quoted components are decoded with the same TomlText implementation as the TOML parser.
effect fn keys(tokens: &mut Tokens<'_>) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut parts = List<Bytes>.make()
  while true {
    match tokens.token {
      TomlToken.Text { span } => {
        let text = TomlScanner.slice(&tokens.scanner, span)
        let mut start: usize = 0
        let mut at: usize = 0
        while at <= text.length {
          if at == text.length || text[at] == 46 {
            if at > start { run List<Bytes>.append(&mut parts, run Bytes.copy(Slice.view<u8>(text, start, at - start))) }
            start = at + 1
          }
          at = at + 1
        }
      }
      TomlToken.String { span, literal, multiline } => {
        run List<Bytes>.append(&mut parts, run TomlText.decode(TomlScanner.slice(&tokens.scanner, span), literal, multiline))
      }
      TomlToken.Dot => {}
      _ => { return move parts }
    }
    next(&mut tokens.*)
  }
}

effect fn remember(locations: &mut List<Location>, path: &[u8], span: Span) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  run List<Location>.append(&mut locations.*, Location { path: run Bytes.copy(path), span: span })
}

// A later dotted definition must not replace the source of an already explicit parent table.
effect fn rememberParent(locations: &mut List<Location>, path: &[u8], span: Span) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let existing = List<Location>.asSlice(&locations.*)
  let mut at: usize = 0
  while at < existing.length {
    if same(Bytes.asSlice(&existing[at].path), path) { return }
    at = at + 1
  }
  run remember(&mut locations.*, path, span)
}

// Records delimiters and scalar token spans, without decoding or reparsing any TOML value.
effect fn valueLocations(tokens: &mut Tokens<'_>, path: &[u8], locations: &mut List<Location>) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let start = tokens.start
  let mut end = tokens.end
  match tokens.token {
    TomlToken.ArrayBegin => {
      next(&mut tokens.*)
      let mut index: usize = 0
      while true {
        match tokens.token {
          TomlToken.ArrayEnd => {
            end = tokens.end
            next(&mut tokens.*)
            break
          }
          TomlToken.Newline => { next(&mut tokens.*) }
          TomlToken.Comma => { next(&mut tokens.*) }
          TomlToken.EndOfInput => { CompilerBug.panic(b"validated TOML array has no closing bracket") }
          _ => {
            let mut child = run Bytes.copy(path)
            run indexPath(&mut child, index)
            run valueLocations(&mut tokens.*, Bytes.asSlice(&child), &mut locations.*)
            index = index + 1
          }
        }
      }
    }
    TomlToken.InlineBegin => {
      next(&mut tokens.*)
      while true {
        match tokens.token {
          TomlToken.InlineEnd => {
            end = tokens.end
            next(&mut tokens.*)
            break
          }
          TomlToken.Newline => { next(&mut tokens.*) }
          TomlToken.Comma => { next(&mut tokens.*) }
          TomlToken.EndOfInput => { CompilerBug.panic(b"validated TOML inline table has no closing brace") }
          _ => { run assignment(&mut tokens.*, path, &mut locations.*) }
        }
      }
    }
    _ => { next(&mut tokens.*) }
  }
  run remember(&mut locations.*, path, Span { start: start, end: end })
}

effect fn assignment(tokens: &mut Tokens<'_>, table: &[u8], locations: &mut List<Location>) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let start = tokens.start
  let parts = run keys(&mut tokens.*)
  let names = List<Bytes>.asSlice(&parts)
  let keyEnd = tokens.start
  let mut path = run Bytes.copy(table)
  let mut at: usize = 0
  while at < names.length {
    run segment(&mut path, Bytes.asSlice(&names[at]))
    if at + 1 < names.length { run rememberParent(&mut locations.*, Bytes.asSlice(&path), Span { start: start, end: keyEnd }) }
    at = at + 1
  }
  match tokens.token {
    TomlToken.Equals => {}
    _ => { CompilerBug.panic(b"validated TOML assignment has no equals token") }
  }
  next(&mut tokens.*)
  run valueLocations(&mut tokens.*, Bytes.asSlice(&path), &mut locations.*)
}

effect fn sourceLocations(text: &[u8]) -> List<Location> ! OutOfMemoryError ? &mut Allocator {
  let mut tokens = Tokens { scanner: TomlScanner.make(text), token: TomlToken.EndOfInput, start: 0, end: 0 }
  let mut locations = List<Location>.make()
  let mut arrays = List<ArrayTable>.make()
  let mut table = Bytes.make()
  next(&mut tokens)
  while true {
    match tokens.token {
      TomlToken.EndOfInput => { return move locations }
      TomlToken.Newline => { next(&mut tokens) }
      TomlToken.ArrayBegin => {
        let start = tokens.start
        next(&mut tokens)
        let array = match tokens.token { TomlToken.ArrayBegin => true _ => false }
        if array { next(&mut tokens) }
        let parts = run keys(&mut tokens)
        let mut end = tokens.end
        next(&mut tokens)
        if array {
          end = tokens.end
          next(&mut tokens)
        }
        table = Bytes.make()
        let names = List<Bytes>.asSlice(&parts)
        let mut at: usize = 0
        while at < names.length {
          run segment(&mut table, Bytes.asSlice(&names[at]))
          if at + 1 == names.length {
            run remember(&mut locations, Bytes.asSlice(&table), Span { start: start, end: end })
          } else {
            run rememberParent(&mut locations, Bytes.asSlice(&table), Span { start: start, end: end })
          }
          let mut found = usize.MAX
          let known = List<ArrayTable>.asSlice(&arrays)
          let mut i: usize = 0
          while i < known.length {
            if same(Bytes.asSlice(&known[i].path), Bytes.asSlice(&table)) {
              found = i
              break
            }
            i = i + 1
          }
          if array && at + 1 == names.length {
            if found == usize.MAX {
              found = List<ArrayTable>.length(&arrays)
              run List<ArrayTable>.append(&mut arrays, ArrayTable { path: run Bytes.copy(Bytes.asSlice(&table)), index: 0 })
            } else {
              let stored = List<ArrayTable>.asMutSlice(&mut arrays)
              stored[found].index = stored[found].index + 1
            }
          }
          if found != usize.MAX {
            let index = List<ArrayTable>.asSlice(&arrays)[found].index
            run indexPath(&mut table, index)
            if at + 1 == names.length {
              run remember(&mut locations, Bytes.asSlice(&table), Span { start: start, end: end })
            } else {
              run rememberParent(&mut locations, Bytes.asSlice(&table), Span { start: start, end: end })
            }
          }
          at = at + 1
        }
      }
      _ => { run assignment(&mut tokens, Bytes.asSlice(&table), &mut locations) }
    }
  }
}

fn location(locations: &[Location], path: &[u8], length: usize) -> Span {
  let mut best: usize = 0
  let mut span = Span { start: 0, end: length }
  let mut at: usize = 0
  while at < locations.length {
    let candidate = Bytes.asSlice(&locations[at].path)
    if candidate.length >= best && prefix(candidate, path) {
      best = candidate.length
      span = locations[at].span
    }
    at = at + 1
  }
  return span
}

effect fn conversionDiagnostics(text: &[u8], error: ValueError) -> List<Diagnostic>
  ! OutOfMemoryError ? &mut Allocator {
  let locations = run sourceLocations(text)
  let listed = List<Location>.asSlice(&locations)
  let mut diagnostics = List<Diagnostic>.make()
  let mut at: usize = 0
  while at < listed.length {
    let entry = &listed[at]
    let path = Bytes.asSlice(&entry.path)
    let raw = Slice.view<u8>(text, entry.span.start, entry.span.end - entry.span.start)
    if !prefix(b"/tool", path) && (same(raw, b"inf") || same(raw, b"+inf") || same(raw, b"-inf")
      || same(raw, b"nan") || same(raw, b"+nan") || same(raw, b"-nan")) {
      let mut message = run Bytes.copy(path)
      run Bytes.append(&mut message, b": nonfinite TOML numbers are outside the manifest schema's JSON data model")
      run List<Diagnostic>.append(&mut diagnostics, Diagnostic {
        span: entry.span, code: run Bytes.copy(b"MANIFEST_SCHEMA"), message: move message,
      })
    }
    at = at + 1
  }
  if List<Diagnostic>.length(&diagnostics) == 0 {
    let message = match error {
      ValueError.NonFiniteNumber => b"manifest contains a number outside the schema's JSON data model"
      ValueError.InvalidTomlValue => b"manifest TOML tree cannot be represented in the schema's JSON data model"
    }
    run List<Diagnostic>.append(&mut diagnostics, Diagnostic {
      span: Span { start: 0, end: text.length }, code: run Bytes.copy(b"MANIFEST_SCHEMA"), message: run Bytes.copy(message),
    })
  }
  return move diagnostics
}
