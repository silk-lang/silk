//! A build-input record reads as unchanged until a file, answer or listing it noted changes, and
//! ignores what the build made itself. Its input lines name paths from their anchors, so two
//! checkouts of the same inputs list the same, and keep only the listed names a build looked for.

import driver.BuildInputs
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.system.filesystem {FileError, FileSystem, Path}
import silk.core.option {Option}
import silk.system.filesystem_native {OsFileSystem}
import silk.collections.slice {Slice}
import silk.testing.testing {AssertionError, Testing}
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn ignoreCleanup(error: FileError | OutOfMemoryError) -> () { return () }

effect fn cleanup(path: &Path) -> () ? &mut FileSystem | &mut Allocator {
  return run Effect.catchAll(FileSystem.removeDirectoryRecursively(path), ignoreCleanup)
}

// What a build reads in `root`: one file, one missing file, and the directory listing. It also
// makes a temporary directory in `outputs` and lists it, as an output directory.
effect fn build(root: &Path, outputs: &Path) -> () ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let input = run Path.join(root, "input.silk")
  let read = run FileSystem.readFile(&input)
  drop read
  let missing = run Path.join(root, "missing.silk")
  let probed = run Effect.result(FileSystem.stat(&missing))
  drop probed
  let listed = run FileSystem.listDirectory(root)
  drop listed
  let made = run FileSystem.createTemporaryDirectory(outputs, b"output")
  let output = run Path.join(&made, "artifact")
  run FileSystem.writeFile(&output, b"artifact")
  let contents = run FileSystem.listDirectory(&made)
  drop contents
  // An object the codegen cache does not hold yet, which an outside process writes later.
  let cache = run Path.join(outputs, "cache")
  let object = run Path.join(&cache, "unit.o")
  let looked = run Effect.result(FileSystem.stat(&object))
  drop looked
  return ()
}

effect fn holds(record: &[u8], key: &[u8]) -> bool ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  return match move run BuildInputs.unchanged(record, key) {
    Option<Bytes>.Some {value} => same(Bytes.asSlice(&value), b"payload")
    Option<Bytes>.None => false
  }
}

effect fn claims(temporary: &Path) -> () ! FileError | OutOfMemoryError | AssertionError<'static> ? &mut FileSystem | &mut Allocator {
  let root = run Path.join(temporary, "source")
  run FileSystem.createDirectory(&root)
  let outputs = run Path.join(temporary, "build")
  run FileSystem.createDirectory(&outputs)
  let input = run Path.join(&root, "input.silk")
  run FileSystem.writeFile(&input, b"fn first() {}")
  let mut recorder = run BuildInputs.recorder()
  let cache = run Path.join(&outputs, "cache")
  run BuildInputs.exclude(&mut recorder, &cache)
  run build(&root, &outputs) |> Effect.provideMut<FileSystem>(&mut recorder)
  run Testing.expect(BuildInputs.complete(&recorder), "every operation was noted")
  let record = run BuildInputs.encode(b"key", b"payload", &recorder)
  let stored = Bytes.asSlice(&record)
  run Testing.expect(run holds(stored, b"key"), "an untouched build reads as unchanged, though its output directory differs")
  run Testing.expect(!run holds(stored, b"other key"), "another key does not match")
  run FileSystem.writeFile(&input, b"fn second() {}")
  run Testing.expect(!run holds(stored, b"key"), "an edited input is a change")
  run FileSystem.writeFile(&input, b"fn first() {}")
  run Testing.expect(run holds(stored, b"key"), "restoring the input restores the match")
  let missing = run Path.join(&root, "missing.silk")
  run FileSystem.writeFile(&missing, b"")
  run Testing.expect(!run holds(stored, b"key"), "a file that was missing now exists")
  run FileSystem.removeFile(&missing)
  run Testing.expect(run holds(stored, b"key"), "removing it again restores the match")
  run FileSystem.createDirectory(&cache)
  let object = run Path.join(&cache, "unit.o")
  run FileSystem.writeFile(&object, b"object")
  run Testing.expect(run holds(stored, b"key"), "an object written into an excluded cache is no change")
  // A file that changes while a build reads it cannot describe one reusable snapshot, even
  // when it is restored before publication. These writes deliberately bypass the recorder.
  let mut conflicting = run BuildInputs.recorder()
  drop run FileSystem.readFile(&input) |> Effect.provideMut<FileSystem>(&mut conflicting)
  run FileSystem.writeFile(&input, b"fn changed() {}")
  drop run FileSystem.readFile(&input) |> Effect.provideMut<FileSystem>(&mut conflicting)
  run FileSystem.writeFile(&input, b"fn first() {}")
  run Testing.expect(!BuildInputs.complete(&conflicting), "conflicting input observations forbid publication")
  let truncated = Slice.view<u8>(stored, usize.ZERO, stored.length - usize.ONE)
  run Testing.expect(!run holds(truncated, b"key"), "a truncated record never matches")
  return ()
}

// What a load reads in `root`: the listing of `src`, then `src/main.silk`.
effect fn load(root: &Path) -> () ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let source = run Path.join(root, "src")
  let listed = run FileSystem.listDirectory(&source)
  drop listed
  let main = run Path.join(&source, "main.silk")
  let read = run Effect.result(FileSystem.readFile(&main))
  drop read
  return ()
}

// The input lines of a load of `root`, named from it.
effect fn linesOf(root: &Path) -> Bytes ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut recorder = run BuildInputs.recorder()
  run load(root) |> Effect.provideMut<FileSystem>(&mut recorder)
  let anchors = [BuildInputs.Anchor {directory: run Bytes.copy(Path.rawBytes(root)), label: Bytes.make()}]
  return run BuildInputs.inputLines(&recorder, &anchors)
}

effect fn checkout(temporary: &Path, name: string<'static>) -> Path ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let root = run Path.join(temporary, name)
  run FileSystem.createDirectory(&root)
  let source = run Path.join(&root, "src")
  run FileSystem.createDirectory(&source)
  let main = run Path.join(&source, "main.silk")
  run FileSystem.writeFile(&main, b"fn main() {}")
  return move root
}

effect fn lists(temporary: &Path) -> () ! FileError | OutOfMemoryError | AssertionError<'static> ? &mut FileSystem | &mut Allocator {
  let first = run checkout(temporary, "first")
  let second = run checkout(temporary, "second")
  let lines = run linesOf(&first)
  run Testing.expect(same(Bytes.asSlice(&lines), Bytes.asSlice(&run linesOf(&second))), "two checkouts of the same inputs list the same")
  let unrelated = run Path.join(&first, "src/notes.silk")
  run FileSystem.writeFile(&unrelated, b"fn notes() {}")
  run Testing.expect(same(Bytes.asSlice(&lines), Bytes.asSlice(&run linesOf(&first))), "a file nothing looked for is no change")
  let main = run Path.join(&first, "src/main.silk")
  run FileSystem.writeFile(&main, b"fn main() { return }")
  run Testing.expect(!same(Bytes.asSlice(&lines), Bytes.asSlice(&run linesOf(&first))), "an edited input is a change")
  run FileSystem.removeFile(&main)
  let variant = run Path.join(&first, "src/MAIN.silk")
  run FileSystem.writeFile(&variant, b"fn other() {}")
  run Testing.expect(!same(Bytes.asSlice(&lines), Bytes.asSlice(&run linesOf(&first))), "a looked-for name's letter-case variant beside it is a change")
  run FileSystem.removeFile(&variant)
  let renamed = run Path.join(&first, "src/Main.silk")
  run FileSystem.writeFile(&renamed, b"fn main() {}")
  let after = run linesOf(&first)
  run FileSystem.removeFile(&renamed)
  run FileSystem.writeFile(&main, b"fn main() {}")
  let restored = run linesOf(&first)
  run Testing.expect(!same(Bytes.asSlice(&after), Bytes.asSlice(&restored)), "a looked-for name in another letter case is a change")
  run Testing.expect(same(Bytes.asSlice(&lines), Bytes.asSlice(&restored)), "restoring the file restores the lines")
  return ()
}

effect fn exercise() -> () ! FileError | OutOfMemoryError | AssertionError<'static> ? &mut FileSystem | &mut Allocator {
  let parent = run Path.make(temporaryParent())
  let temporary = run FileSystem.temporaryDirectory(&parent, "silk-build-inputs-case")
  return run Effect.ensuring(claims(&temporary.path), cleanup(&temporary.path))
}

effect fn exerciseLines() -> () ! FileError | OutOfMemoryError | AssertionError<'static> ? &mut FileSystem | &mut Allocator {
  let parent = run Path.make(temporaryParent())
  let temporary = run FileSystem.temporaryDirectory(&parent, "silk-build-input-lines-case")
  return run Effect.ensuring(lists(&temporary.path), cleanup(&temporary.path))
}

fn temporaryParent() -> string<'static> {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return "/private/tmp" }
  else { return "/tmp" }
}

test effect fn recordsReadAsUnchangedUntilAnInputChanges() -> () ! FileError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make("/") |> Effect.provideMut<Allocator>(&mut allocator)
  return run exercise() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn inputLinesNameWhatALoadLookedFor() -> () ! FileError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make("/") |> Effect.provideMut<Allocator>(&mut allocator)
  return run exerciseLines() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
}
