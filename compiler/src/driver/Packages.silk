//! The packages one build reads: the root package and every package its `[dependencies]` reach.
//!
//! # Details
//! Each manifest's `[dependencies]` table maps a dependency name to `{ path, package? }`, or to a
//! git dependency `{ git, rev, path?, package? }` (PACKAGE-002). Loading follows those tables depth
//! first from the root package and checks the rules a build relies on: identifier names other than
//! `silk` and `Intrinsic`, a readable manifest at each path, a matching `package` name, no name that
//! is also one of the owner's own top-level modules (PACKAGE-003), no package cycle, and one version
//! and one directory per package name (PACKAGE-004). An entry takes no field but `path`, `git`,
//! `rev` and `package`. A dependency's `[package].exports` must list modules that exist in it
//! (PACKAGE-006).
//!
//! A git dependency reads the package at `path` (the repository root by default) in the checkout
//! of commit `rev` (driver/GitCheckouts). Loading only reads checkouts; [`fetch`] writes the
//! missing ones first. A package read from a checkout reaches other packages by `path` only inside
//! the same checkout, so a commit pins its whole dependency graph.

import driver.CommandPath
import driver.GitCheckouts as Checkouts {FetchFailed}
import driver.ManifestFields
import driver.ManifestText
import ReleaseVersion
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.PackageGraph {PackageGraph}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.box {Box}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.system.child_process {ChildProcess}
import silk.system.filesystem {FileError, FileSystem, Path}
import silk.system.host_input {HostInput, HostInputError}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.collections.slice {Slice}
import silk.text.string {String}
import silk.toml.scanner {TomlError}
import silk.toml.value {Toml, TomlChild, Value as TomlValue}
import silk.num.usize
import silk.collections.list {List}

/// A dependency the build cannot use. `detail` names the dependency and what is wrong with it.
/// `manifest` is the silk.toml that writes the fault and `line` its 1-based line there; `manifest`
/// is empty, and `line` zero, when no manifest line is at fault.
pub struct InvalidDependency {
  pub detail: Bytes,
  pub manifest: Bytes,
  pub line: usize,
}

// One package of the build.
struct Package {
  // `name@version`, the identity its module identities carry.
  identity: Bytes,
  name: Bytes,
  // The directory holding its manifest.
  manifest: Path,
  // The directory its module paths resolve below.
  sourceRoot: Path,
  // The canonical paths, such as `codec/Json.silk`, of the modules other packages may import.
  exports: List<Bytes>,
  // The root of the git checkout it was read from, or `None` for a package outside the store.
  checkout: Option<Path>,
}

// One edge of the graph: package `owner` imports package `package` as `name`.
struct Edge {
  owner: Bytes,
  name: Bytes,
  package: Bytes,
}

/// Every package of one build, the root first, and the dependency names each one declares.
pub struct Packages {
  packages: List<Package>,
  edges: List<Edge>,
  // The git checkout store, or `None` when the command has none and git dependencies are refused.
  store: Option<Path>,
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether `text` is an identifier: an ASCII letter or `_`, then letters, digits or `_`.
fn identifier(text: &[u8]) -> bool {
  if text.length == usize.ZERO { return false }
  let mut at = usize.ZERO
  while at < text.length {
    let byte = text[at]
    let letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
    let digit = byte >= 48 && byte <= 57
    if !letter && !(digit && at > usize.ZERO) { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn copyPath(path: &Path) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
  return run Path.fromBytes(Path.rawBytes(path))
}

// Fails with `dependency <name> of <owner>: <reason>`, at the line of the silk.toml in `directory`
// that writes `dependencies.<name>`, or its `field` unless that is empty.
effect fn invalid(owner: &[u8], name: &[u8], reason: &[u8], directory: &Path, field: &[u8]) -> never
! InvalidDependency | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let manifest = run Path.join(directory, "silk.toml")
  let key = run dependencyKey(name, field)
  let line = run lineIn(&manifest, Bytes.asSlice(&key))
  run invalidAt(owner, name, reason, &manifest, line)
}

// Fails as [`invalid`] does, at `line` of the silk.toml `manifest`.
effect fn invalidAt(owner: &[u8], name: &[u8], reason: &[u8], manifest: &Path, line: usize) -> never
! InvalidDependency | OutOfMemoryError ? &mut Allocator {
  let mut detail = run Bytes.copy(b"dependency `")
  run Bytes.append(&mut detail, name)
  run Bytes.append(&mut detail, b"` of ")
  run Bytes.append(&mut detail, owner)
  run Bytes.append(&mut detail, b": ")
  run Bytes.append(&mut detail, reason)
  fail InvalidDependency {detail: move detail, manifest: run Bytes.copy(Path.rawBytes(manifest)), line: line}
}

// The line of the silk.toml `manifest` that writes the dotted key `key`, or zero when it cannot be
// read. Only refusals call it, so reading the file again costs a successful build nothing.
effect fn lineIn(manifest: &Path, key: &[u8]) -> usize ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  return match move run Effect.result(FileSystem.readFile(manifest)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success {value} => ManifestText.keyLine(Bytes.asSlice(&value), key)
    Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError unread => {
        drop unread
        return usize.ZERO
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// `dependencies.<name>`, then `.<field>` unless `field` is empty: the key a dependency refusal names.
effect fn dependencyKey(name: &[u8], field: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut key = run Bytes.copy(b"dependencies.")
  run Bytes.append(&mut key, name)
  if field.length > usize.ZERO {
    run Bytes.append(&mut key, b".")
    run Bytes.append(&mut key, field)
  }
  return move key
}

// The manifest's `name@version`, or `None` without a name. The version defaults to `0.0.0`.
effect fn identityOf(document: &TomlValue) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let name = match move Toml.asString(Toml.fieldAt(Toml.field(document, "package"), "name")) {
    Option<string>.Some {value} => String.utf8Bytes(value)
    Option<string>.None => { return Option<Bytes>.none() }
  }
  let version = ManifestFields.version(document)
  if name.length == usize.ZERO || version.length == usize.ZERO { return Option<Bytes>.none() }
  let mut identity = run Bytes.copy(name)
  run Bytes.append(&mut identity, b"@")
  run Bytes.append(&mut identity, version)
  return Option<Bytes>.some(move identity)
}

// Whether `sourceRoot` holds a module `name.silk` or a directory `name`, which a dependency of the
// same name would hide (PACKAGE-003).
effect fn shadows(sourceRoot: &Path, name: &[u8]) -> bool ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let directory = run Path.joinBytes(sourceRoot, name)
  let found = run FileSystem.exists(&directory)
  if found { return true }
  let mut file = run Bytes.copy(name)
  run Bytes.append(&mut file, b".silk")
  let module = run Path.joinBytes(sourceRoot, Bytes.asSlice(&file))
  return run FileSystem.exists(&module)
}

// Fails with `exports of <package>: <entry> <reason>`, at the `package.exports` line of the
// silk.toml in `directory`.
effect fn invalidExport(package: &[u8], entry: &[u8], reason: &[u8], directory: &Path) -> never
! InvalidDependency | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let manifest = run Path.join(directory, "silk.toml")
  let line = run lineIn(&manifest, b"package.exports")
  let mut detail = run Bytes.copy(b"exports of ")
  run Bytes.append(&mut detail, package)
  run Bytes.append(&mut detail, b": ")
  run Bytes.append(&mut detail, entry)
  run Bytes.append(&mut detail, b" ")
  run Bytes.append(&mut detail, reason)
  fail InvalidDependency {detail: move detail, manifest: run Bytes.copy(Path.rawBytes(&manifest)), line: line}
}

// The canonical module paths `[package].exports` lists in import spelling (`codec.Json` becomes
// `codec/Json.silk`, or `codec/Json/mod.silk` when that barrel file is the one present), each
// checked to name a module below `sourceRoot` (PACKAGE-006). `directory` holds the manifest.
effect fn exportsOf(package: &[u8], document: &TomlValue, directory: &Path, sourceRoot: &Path) -> List<Bytes>
! InvalidDependency | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut exports = List<Bytes>.make()
  let listed = match move Toml.fieldAt(Toml.field(document, "package"), "exports") {
    Option<&TomlValue>.Some {value} => value
    Option<&TomlValue>.None => { return move exports }
  }
  let array = match &listed.* {
    TomlValue.Array {..} => true
    _ => false
  }
  if !array { run invalidExport(package, b"[package].exports", b"must be an array of module names", directory) }
  let mut at = usize.ZERO
  while true {
    let item = match move Toml.item(listed, at) {
      Option<&TomlValue>.Some {value} => value
      Option<&TomlValue>.None => { return move exports }
    }
    let spelling = match move Toml.asString(Option<&TomlValue>.some(item)) {
      Option<string>.Some {value} => String.utf8Bytes(value)
      Option<string>.None => run invalidExport(package, b"[package].exports", b"must list module names as strings", directory)
    }
    let mut path = Bytes.make()
    let mut start = usize.ZERO
    let mut cursor = usize.ZERO
    while cursor <= spelling.length {
      if cursor == spelling.length || spelling[cursor] == 46 {
        let segment = Slice.view<u8>(spelling, start, cursor - start)
        if !identifier(segment) { run invalidExport(package, spelling, b"is not a module name such as `codec.Json`", directory) }
        if start > usize.ZERO { run Bytes.append(&mut path, b"/") }
        run Bytes.append(&mut path, segment)
        start = cursor + usize.ONE
      }
      cursor = cursor + usize.ONE
    }
    run Bytes.append(&mut path, b".silk")
    // MODULE-007: the entry names the module file or its directory's barrel `mod.silk`.
    if PackageGraph.isBarrel(Bytes.asSlice(&path)) {
      run invalidExport(package, spelling, b"names a `mod.silk` file; list its directory's path without `.mod`", directory)
    }
    let barrel = run PackageGraph.barrelPath(Bytes.asSlice(&path))
    let file = run Path.joinBytes(sourceRoot, Bytes.asSlice(&path))
    let fileFound = run FileSystem.exists(&file)
    let barrelFile = run Path.joinBytes(sourceRoot, Bytes.asSlice(&barrel))
    let barrelFound = run FileSystem.exists(&barrelFile)
    if fileFound && barrelFound {
      run invalidExport(package, spelling, b"names both a module file and its directory's `mod.silk`; remove or rename one of them", directory)
    }
    if !fileFound && !barrelFound { run invalidExport(package, spelling, b"is not a module of the package", directory) }
    if barrelFound {
      run List<Bytes>.append(&mut exports, move barrel)
    } else {
      run List<Bytes>.append(&mut exports, move path)
    }
    at = at + usize.ONE
  }
  return move exports
}

// The members of a table, or `None` for another kind of value.
fn members<'a>(value: &'a TomlValue) -> Option<&'a [TomlChild]> {
  return match &value.* {
    TomlValue.Table {entries, kind: _} => {
      let boxed = Box<List<TomlChild>>.get(&entries)
      return Option<&'a [TomlChild]>.some(List<TomlChild>.asSlice(&boxed[0]))
    }
    _ => Option<&'a [TomlChild]>.none()
  }
}

fn indexOf(packages: &[Package], name: &[u8]) -> usize {
  let mut at = usize.ZERO
  while at < packages.length {
    if same(Bytes.asSlice(&packages[at].name), name) { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn onStack(stack: &[Bytes], identity: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < stack.length {
    if same(Bytes.asSlice(&stack[at]), identity) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether `path` is `root` or a path below it.
fn within(root: &[u8], path: &[u8]) -> bool {
  if path.length < root.length || !same(Slice.view<u8>(path, usize.ZERO, root.length), root) { return false }
  return path.length == root.length || path[root.length] == 47
}

// Whether `written` is a relative path with no `..` segment, so it stays below the directory it
// is joined to.
fn contained(written: &[u8]) -> bool {
  if written.length > usize.ZERO && written[usize.ZERO] == 47 { return false }
  let mut start = usize.ZERO
  let mut cursor = usize.ZERO
  while cursor <= written.length {
    if cursor == written.length || written[cursor] == 47 {
      if cursor - start == usize.add(0, 2) && written[start] == 46 && written[start + usize.ONE] == 46 { return false }
      start = cursor + usize.ONE
    }
    cursor = cursor + usize.ONE
  }
  return true
}

// `path`'s real directory, or `path` itself when it cannot be resolved, so that paths reaching one
// directory through different symbolic links compare equal.
effect fn real(path: Path) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
  return match move run CommandPath.canonical(Path.rawBytes(&path)) {
    Option<Bytes>.Some {value} => run Path.fromBytes(Bytes.asSlice(&value))
    Option<Bytes>.None => move path
  }
}

// Where a dependency's manifest is, and the checkout holding it.
struct Located {
  directory: Path,
  checkout: Option<Path>,
}

// The directory of the manifest the dependency `name` of `owner`, whose entry is `entry`, reads.
// A git dependency's is `path` below the checkout of `rev`, the checkout root by default. A path
// dependency's is `path` from `ownerDirectory`, and must stay inside `ownerCheckout` when the owner
// was read from one.
effect fn locate(packages: &Packages, owner: &[u8], name: &[u8], entry: &TomlValue, ownerDirectory: &Path, ownerCheckout: &Option<Path>) -> Located
! InvalidDependency | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let rev = Toml.field(entry, "rev")
  if let Option<&TomlValue>.Some {value: _} = move Toml.field(entry, "git") {
    let url = match move Toml.asString(Toml.field(entry, "git")) {
      Option<string>.Some {value} => String.utf8Bytes(value)
      Option<string>.None => b""
    }
    if url.length == usize.ZERO {
      run invalid(owner, name, b"git must be the repository URL, as git = \"https://example.com/library.git\"", ownerDirectory, b"git")
    }
    let commit = match move Toml.asString(rev) {
      Option<string>.Some {value} => String.utf8Bytes(value)
      Option<string>.None => run invalid(owner, name, b"a git dependency needs rev, the full hash of the commit to build", ownerDirectory, b"git")
    }
    if !Checkouts.isCommit(commit) {
      run invalid(owner, name, b"rev must be a full commit hash: 40 or 64 lowercase hexadecimal digits", ownerDirectory, b"rev")
    }
    let store = match &packages.store {
      Option<Path>.Some {value} => &value
      Option<Path>.None => run invalid(owner, name, b"this command cannot read git dependencies: neither SILK_HOME nor HOME names a directory for their checkouts", ownerDirectory, b"git")
    }
    let present = run Checkouts.fetched(store, commit)
    if !present {
      let mut reason = run Bytes.copy(b"commit ")
      run Bytes.append(&mut reason, commit)
      run Bytes.append(&mut reason, b" of ")
      run Bytes.append(&mut reason, url)
      run Bytes.append(&mut reason, b" is not fetched yet; silk build, check, test and run fetch it")
      run invalid(owner, name, Bytes.asSlice(&reason), ownerDirectory, b"rev")
    }
    let root = run real(run Checkouts.checkout(store, commit))
    let mut directory = run copyPath(&root)
    if let Option<&TomlValue>.Some {value: _} = move Toml.field(entry, "path") {
      let inner = match move Toml.asString(Toml.field(entry, "path")) {
        Option<string>.Some {value} => String.utf8Bytes(value)
        Option<string>.None => b"/"
      }
      if !contained(inner) {
        run invalid(owner, name, b"path of a git dependency must name a directory inside the repository, relative to its root", ownerDirectory, b"path")
      }
      directory = run real(run Path.joinBytes(&root, inner))
      if !within(Path.rawBytes(&root), Path.rawBytes(&directory)) {
        run invalid(owner, name, b"path of a git dependency must name a directory inside the repository, relative to its root", ownerDirectory, b"path")
      }
    }
    return Located {directory: move directory, checkout: Option<Path>.some(move root)}
  }
  if let Option<&TomlValue>.Some {value: _} = move rev {
    run invalid(owner, name, b"rev pins a git dependency; add git, the repository URL", ownerDirectory, b"rev")
  }
  let written = match move Toml.asString(Toml.field(entry, "path")) {
    Option<string>.Some {value} => String.utf8Bytes(value)
    Option<string>.None => run invalid(owner, name, b"path must name the directory of the dependency's silk.toml", ownerDirectory, b"path")
  }
  // A dependency is read at its real directory, so paths that reach one package through
  // different symbolic links name one directory.
  let directory = run real(run CommandPath.resolve(ownerDirectory, written))
  return match &ownerCheckout.* {
    Option<Path>.Some {value: root} => {
      if !within(Path.rawBytes(&root), Path.rawBytes(&directory)) {
        run invalid(owner, name, b"a package from a git dependency reaches packages by path only inside its own repository", ownerDirectory, b"path")
      }
      return Located {directory: move directory, checkout: Option<Path>.some(run copyPath(&root))}
    }
    Option<Path>.None => Located {directory: move directory, checkout: Option<Path>.none()}
  }
}

/// Fetches into the checkout store `store` (driver/GitCheckouts) every git dependency that the
/// package whose manifest `document` sits in `directory` reaches, directly or through other
/// packages, and that the store lacks. It follows only entries it can read and leaves every other
/// check to [`load`]. A fetch that fails is an invalid dependency naming its `git` line.
pub effect fn fetch(directory: &Path, document: &TomlValue, store: &Path) -> ()
! InvalidDependency | HostInputError | FileError | OutOfMemoryError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let mut seen = List<Bytes>.make()
  run fetchVisit(directory, document, store, &mut seen)
}

effect fn fetchVisit(directory: &Path, document: &TomlValue, store: &Path, seen: &mut List<Bytes>) -> ()
! InvalidDependency | HostInputError | FileError | OutOfMemoryError
? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let children = match move Toml.field(document, "dependencies") {
    Option<&TomlValue>.Some {value} => match move members(value) {
      Option<&[TomlChild]>.Some {value: listed} => listed
      Option<&[TomlChild]>.None => { return () }
    }
    Option<&TomlValue>.None => { return () }
  }
  let mut at = usize.ZERO
  while at < children.length {
    if let TomlChild.Member {entry} = &children[at] {
      let name = String.ownedUtf8Bytes(&entry.key)
      let mut target = Option<Path>.none()
      let url = Toml.asString(Toml.field(&entry.value, "git"))
      let rev = Toml.asString(Toml.field(&entry.value, "rev"))
      let path = Toml.asString(Toml.field(&entry.value, "path"))
      if let Option<string>.Some {value: written} = move url {
        if let Option<string>.Some {value: pinned} = move rev {
          let commit = String.utf8Bytes(pinned)
          if Checkouts.isCommit(commit) {
            let fetched = run Effect.result(Checkouts.fetch(store, String.utf8Bytes(written), commit))
            match move fetched {
              Result<(), FetchFailed | HostInputError | FileError | OutOfMemoryError>.Success {value: _} => {}
              Result<(), FetchFailed | HostInputError | FileError | OutOfMemoryError>.Failure {error} => match move error {
                FetchFailed failure => {
                  let mut reason = run Bytes.copy(b"fetching commit ")
                  run Bytes.append(&mut reason, commit)
                  run Bytes.append(&mut reason, b" of ")
                  run Bytes.append(&mut reason, String.utf8Bytes(written))
                  run Bytes.append(&mut reason, b" failed: ")
                  run Bytes.append(&mut reason, Bytes.asSlice(&failure.detail))
                  let owner = match move run identityOf(document) {
                    Option<Bytes>.Some {value} => move value
                    Option<Bytes>.None => run Bytes.copy(Path.rawBytes(directory))
                  }
                  run invalid(Bytes.asSlice(&owner), name, Bytes.asSlice(&reason), directory, b"git")
                }
                HostInputError unread => { fail move unread }
                FileError unwritten => {
                  let mut reason = run Bytes.copy(b"its checkout cannot be written below ")
                  run Bytes.append(&mut reason, Path.rawBytes(store))
                  drop unwritten
                  let owner = match move run identityOf(document) {
                    Option<Bytes>.Some {value} => move value
                    Option<Bytes>.None => run Bytes.copy(Path.rawBytes(directory))
                  }
                  run invalid(Bytes.asSlice(&owner), name, Bytes.asSlice(&reason), directory, b"git")
                }
                OutOfMemoryError exhausted => { fail move exhausted }
              }
            }
            let root = run Checkouts.checkout(store, commit)
            if let Option<string>.Some {value: inner} = move path {
              if contained(String.utf8Bytes(inner)) {
                target = Option<Path>.some(run Path.joinBytes(&root, String.utf8Bytes(inner)))
              }
            } else {
              target = Option<Path>.some(move root)
            }
          }
        }
      } else if let Option<string>.Some {value: written} = move path {
        target = Option<Path>.some(run CommandPath.resolve(directory, String.utf8Bytes(written)))
      }
      if let Option<Path>.Some {value: found} = move target {
        let resolved = run real(move found)
        if !onStack(List<Bytes>.asSlice(&seen.*), Path.rawBytes(&resolved)) {
          run List<Bytes>.append(&mut seen.*, run Bytes.copy(Path.rawBytes(&resolved)))
          let manifest = run Path.join(&resolved, "silk.toml")
          if let Result<Bytes, FileError | OutOfMemoryError>.Success {value: contents} = move run Effect.result(FileSystem.readFile(&manifest)) {
            if let Result<TomlValue, TomlError | OutOfMemoryError>.Success {value: dependency} = move run Effect.result(Toml.parse(Bytes.asSlice(&contents))) {
              run fetchVisit(&resolved, &dependency, store, &mut seen.*)
            }
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// Loads every dependency the package at `owner` declares in `document`, then theirs.
effect fn visit(packages: &mut Packages, owner: usize, document: &TomlValue, stack: &mut List<Bytes>) -> ()
! InvalidDependency | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let listed = match move Toml.field(document, "dependencies") {
    Option<&TomlValue>.Some {value} => value
    Option<&TomlValue>.None => { return () }
  }
  let listedOwner = List<Package>.asSlice(&packages.packages)
  let ownerIdentity = run Bytes.copy(Bytes.asSlice(&listedOwner[owner].identity))
  let ownerManifest = run copyPath(&listedOwner[owner].manifest)
  let ownerSourceRoot = run copyPath(&listedOwner[owner].sourceRoot)
  let mut ownerCheckout = Option<Path>.none()
  if let Option<Path>.Some {value} = &listedOwner[owner].checkout { ownerCheckout = Option<Path>.some(run copyPath(&value)) }
  let owned = Bytes.asSlice(&ownerIdentity)
  let children = match move members(listed) {
    Option<&[TomlChild]>.Some {value} => value
    Option<&[TomlChild]>.None => {
      let mut detail = run Bytes.copy(b"[dependencies] of ")
      run Bytes.append(&mut detail, owned)
      run Bytes.append(&mut detail, b" must be a table")
      let manifest = run Path.join(&ownerManifest, "silk.toml")
      let line = run lineIn(&manifest, b"dependencies")
      fail InvalidDependency {detail: move detail, manifest: run Bytes.copy(Path.rawBytes(&manifest)), line: line}
    }
  }
  let mut at = usize.ZERO
  while at < children.length {
    if let TomlChild.Member {entry} = &children[at] {
      let name = String.ownedUtf8Bytes(&entry.key)
      if !identifier(name) { run invalid(owned, name, b"a dependency name must be an identifier", &ownerManifest, b"") }
      if same(name, b"silk") || same(name, b"Intrinsic") || same(name, b"self") || same(name, b"silkc") {
        run invalid(owned, name, b"the name is reserved for the toolchain", &ownerManifest, b"")
      }
      let table = match &entry.value {
        TomlValue.Table {..} => true
        _ => false
      }
      if !table { run invalid(owned, name, b"a dependency must be a table such as { path = \"../library\" }", &ownerManifest, b"") }
      if let Option<&[TomlChild]>.Some {value: fields} = move members(&entry.value) {
        let mut field = usize.ZERO
        while field < fields.length {
          if let TomlChild.Member {entry: written} = &fields[field] {
            let key = String.ownedUtf8Bytes(&written.key)
            if !same(key, b"path") && !same(key, b"package") && !same(key, b"git") && !same(key, b"rev") {
              // Other sources and their modifiers are reserved for a later release.
              let reserved = same(key, b"url") || same(key, b"version") || same(key, b"tag")
                || same(key, b"branch") || same(key, b"hash") || same(key, b"optional")
                || same(key, b"workspace")
              let mut reason = run Bytes.copy(key)
              if reserved {
                run Bytes.append(&mut reason, b" is not supported yet; a dependency takes only path, git, rev and package")
                if same(key, b"tag") || same(key, b"branch") {
                  run Bytes.append(&mut reason, b"; pin a git dependency to a full commit hash with rev")
                }
              } else {
                run Bytes.append(&mut reason, b" is not a supported field; a dependency takes only path, git, rev and package")
              }
              run invalid(owned, name, Bytes.asSlice(&reason), &ownerManifest, key)
            }
          }
          field = field + usize.ONE
        }
      }
      let hidden = run shadows(&ownerSourceRoot, name)
      if hidden {
        run invalid(owned, name, b"the name is also a top-level module or directory of this package's source root", &ownerManifest, b"")
      }
      let located = run locate(&packages.*, owned, name, &entry.value, &ownerManifest, &ownerCheckout)
      let Located {directory, checkout} = move located
      let manifest = run Path.join(&directory, "silk.toml")
      let read = run Effect.result(FileSystem.readFile(&manifest))
      let contents = match move read {
        Result<Bytes, FileError | OutOfMemoryError>.Success {value} => move value
        Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
          FileError missing => {
            drop missing
            let mut reason = run Bytes.copy(b"no readable silk.toml at ")
            run Bytes.append(&mut reason, Path.rawBytes(&directory))
            run invalid(owned, name, Bytes.asSlice(&reason), &ownerManifest, b"path")
          }
          OutOfMemoryError exhausted => { fail move exhausted }
        }
      }
      let parsed = run Effect.result(Toml.parse(Bytes.asSlice(&contents)))
      let dependency = match move parsed {
        Result<TomlValue, TomlError | OutOfMemoryError>.Success {value} => move value
        Result<TomlValue, TomlError | OutOfMemoryError>.Failure {error} => match move error {
          TomlError malformed => {
            let mut reason = run Bytes.copy(b"its silk.toml is not valid TOML: ")
            run ManifestText.appendTomlReason(&mut reason, Bytes.asSlice(&contents), &malformed)
            run invalidAt(owned, name, Bytes.asSlice(&reason), &manifest, ManifestText.lineAt(Bytes.asSlice(&contents), malformed.offset))
          }
          OutOfMemoryError exhausted => { fail move exhausted }
        }
      }
      // A dependency's `silk-version` names the release line it was written for (D1).
      if let Option<&[u8]>.Some {value: pinned} = move ManifestFields.packageText(&dependency, "silk-version") {
        if !ManifestFields.compatible(ReleaseVersion.value(), pinned) {
          let mut reason = run Bytes.copy(b"it was written for Silk ")
          run Bytes.append(&mut reason, pinned)
          run Bytes.append(&mut reason, b" (its silk-version), which this Silk ")
          run Bytes.append(&mut reason, ReleaseVersion.value())
          run Bytes.append(&mut reason, b" cannot build")
          if ManifestFields.isPrerelease(ReleaseVersion.value()) || ManifestFields.isPrerelease(pinned) {
            run Bytes.append(&mut reason, b"; a dev release builds only packages written for that same dev release")
          }
          run Bytes.append(&mut reason, b". Build with Silk ")
          run Bytes.append(&mut reason, pinned)
          run Bytes.append(&mut reason, b" (silk set ")
          run Bytes.append(&mut reason, pinned)
          run Bytes.append(&mut reason, b"), or set the dependency's silk-version to ")
          run Bytes.append(&mut reason, ReleaseVersion.value())
          run Bytes.append(&mut reason, b" if it builds with this Silk")
          let line = ManifestText.keyLine(Bytes.asSlice(&contents), b"package.silk-version")
          run invalidAt(owned, name, Bytes.asSlice(&reason), &manifest, line)
        }
      }
      let identity = match move run identityOf(&dependency) {
        Option<Bytes>.Some {value} => move value
        Option<Bytes>.None => run invalidAt(owned, name, b"its silk.toml has no [package] name", &manifest,
          ManifestText.keyLine(Bytes.asSlice(&contents), b"package.name"))
      }
      let packageName = match move Toml.asString(Toml.fieldAt(Toml.field(&dependency, "package"), "name")) {
        Option<string>.Some {value} => String.utf8Bytes(value)
        Option<string>.None => run invalidAt(owned, name, b"its silk.toml has no [package] name", &manifest,
          ManifestText.keyLine(Bytes.asSlice(&contents), b"package.name"))
      }
      if let Option<string>.Some {value: expected} = move Toml.asString(Toml.field(&entry.value, "package")) {
        if !same(String.utf8Bytes(expected), packageName) {
          run invalid(owned, name, b"package does not match the name in the dependency's silk.toml", &ownerManifest, b"package")
        }
      }
      if onStack(List<Bytes>.asSlice(&stack.*), Bytes.asSlice(&identity)) {
        let mut reason = run Bytes.copy(owned)
        run Bytes.append(&mut reason, b" depends on ")
        run Bytes.append(&mut reason, Bytes.asSlice(&identity))
        run Bytes.append(&mut reason, b", which depends on ")
        run Bytes.append(&mut reason, owned)
        run Bytes.append(&mut reason, b" in turn, directly or through other packages, so they form a cycle")
        run invalid(owned, name, Bytes.asSlice(&reason), &ownerManifest, b"")
      }
      let known = indexOf(List<Package>.asSlice(&packages.packages), packageName)
      if known != usize.MAX {
        let listed = List<Package>.asSlice(&packages.packages)
        let sameVersion = same(Bytes.asSlice(&listed[known].identity), Bytes.asSlice(&identity))
        let sameDirectory = same(Path.rawBytes(&listed[known].manifest), Path.rawBytes(&directory))
        if !sameVersion || !sameDirectory {
          run invalid(owned, name, b"the build already has a different version or copy of this package", &ownerManifest, b"")
        }
      } else {
        let sourceRoot = run ManifestFields.sourceRoot(&directory, &dependency)
        let exports = run exportsOf(Bytes.asSlice(&identity), &dependency, &directory, &sourceRoot)
        run List<Package>.append(&mut packages.packages, Package {
          identity: run Bytes.copy(Bytes.asSlice(&identity)), name: run Bytes.copy(packageName),
          manifest: move directory, sourceRoot: move sourceRoot, exports: move exports, checkout: move checkout,
        })
        run List<Bytes>.append(&mut stack.*, run Bytes.copy(Bytes.asSlice(&identity)))
        let added = List<Package>.length(&packages.packages) - usize.ONE
        run visit(&mut packages.*, added, &dependency, &mut stack.*)
        let top = List<Bytes>.length(&stack.*) - usize.ONE
        let finished = List<Bytes>.remove(&mut stack.*, top)
        drop finished
      }
      run List<Edge>.append(&mut packages.edges, Edge {
        owner: run Bytes.copy(owned), name: run Bytes.copy(name), package: move identity,
      })
    }
    at = at + usize.ONE
  }
  return ()
}

/// Loads the root package, whose manifest `document` sits in `manifest` with module identity
/// `identity` and modules below `sourceRoot`, and every package its dependencies reach. Git
/// dependencies read their checkouts in `store` (driver/GitCheckouts) and are refused when it is
/// `None` or lacks the commit; [`fetch`] writes missing checkouts first.
pub effect fn load(manifest: &Path, document: &TomlValue, identity: &[u8], sourceRoot: &Path, store: Option<&Path>) -> Packages
! InvalidDependency | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let name = match move Toml.asString(Toml.fieldAt(Toml.field(document, "package"), "name")) {
    Option<string>.Some {value} => String.utf8Bytes(value)
    Option<string>.None => b""
  }
  let mut kept = Option<Path>.none()
  if let Option<&Path>.Some {value} = move store { kept = Option<Path>.some(run copyPath(value)) }
  let mut packages = Packages {packages: List<Package>.make(), edges: List<Edge>.make(), store: move kept}
  // The root's own exports are part of its public surface, so the build checks them even when its
  // root module imports none of them.
  let exports = run exportsOf(identity, document, manifest, sourceRoot)
  run List<Package>.append(&mut packages.packages, Package {
    identity: run Bytes.copy(identity), name: run Bytes.copy(name), manifest: run copyPath(manifest),
    sourceRoot: run copyPath(sourceRoot), exports: move exports, checkout: Option<Path>.none(),
  })
  let mut stack = List<Bytes>.make()
  run List<Bytes>.append(&mut stack, run Bytes.copy(identity))
  run visit(&mut packages, usize.ZERO, document, &mut stack)
  return move packages
}

/// The package graph of these packages, whose standard-library paths belong to `owner`'s package.
pub effect fn graph(self: &Packages, owner: &ModuleId) -> PackageGraph ! OutOfMemoryError ? &mut Allocator {
  let mut graph = PackageGraph.make(owner)
  let edges = List<Edge>.asSlice(&self.edges)
  let mut at = usize.ZERO
  while at < edges.length {
    run PackageGraph.depend(&mut graph, Bytes.asSlice(&edges[at].owner), Bytes.asSlice(&edges[at].name),
      Bytes.asSlice(&edges[at].package))
    at = at + usize.ONE
  }
  let packages = List<Package>.asSlice(&self.packages)
  let mut packageAt = usize.ZERO
  while packageAt < packages.length {
    let exports = List<Bytes>.asSlice(&packages[packageAt].exports)
    let mut exportAt = usize.ZERO
    while exportAt < exports.length {
      run PackageGraph.publish(&mut graph, Bytes.asSlice(&packages[packageAt].identity), Bytes.asSlice(&exports[exportAt]))
      exportAt = exportAt + usize.ONE
    }
    packageAt = packageAt + usize.ONE
  }
  return move graph
}

/// The canonical paths, such as `codec/Json.silk`, of the modules the root package exports.
pub fn rootExports(self: &Packages) -> &[Bytes] {
  return List<Bytes>.asSlice(&List<Package>.asSlice(&self.packages)[usize.ZERO].exports)
}

/// The module of a dependency whose source root holds the file at `path`, or `None` when no
/// dependency's does or `path` is not a module path below it.
pub effect fn dependencyModule(self: &Packages, path: &[u8]) -> Option<ModuleId> ! OutOfMemoryError ? &mut Allocator {
  let listed = List<Package>.asSlice(&self.packages)
  let mut at = usize.ONE
  while at < listed.length {
    let root = Path.rawBytes(&listed[at].sourceRoot)
    if path.length > root.length + usize.ONE && path[root.length] == 47 && same(Slice.view<u8>(path, usize.ZERO, root.length), root) {
      let logical = Slice.view<u8>(path, root.length + usize.ONE, path.length - root.length - usize.ONE)
      let identified = run Effect.result(ModuleId.make(b"file", Bytes.asSlice(&listed[at].identity), logical))
      return match move identified {
        Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success {value} => Option<ModuleId>.some(move value)
        Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure {error} => match move error {
          InvalidModulePath invalid => Option<ModuleId>.none()
          OutOfMemoryError exhausted => { fail move exhausted }
        }
      }
    }
    at = at + usize.ONE
  }
  return Option<ModuleId>.none()
}

/// The source root of the dependency whose identity is `package`, or `None` for the root package
/// and for an identity no dependency has.
pub fn dependencyRoot(self: &Packages, package: &[u8]) -> Option<&Path> {
  let listed = List<Package>.asSlice(&self.packages)
  let mut at = usize.ONE
  while at < listed.length {
    if same(Bytes.asSlice(&listed[at].identity), package) { return Option<&Path>.some(&listed[at].sourceRoot) }
    at = at + usize.ONE
  }
  return Option<&Path>.none()
}
