/// A dependency the build cannot use. `detail` names the dependency and what is wrong with it.
/// `manifest` is the silk.toml that writes the fault and `line` its 1-based line there; `manifest`
/// is empty, and `line` zero, when no manifest line is at fault.
pub struct InvalidDependency {
  pub detail: Bytes,
  pub manifest: Bytes,
  pub line: usize,
}

// One package of the build.
struct Package {
  // `name@version`, the identity its module identities carry.
  identity: Bytes,
  name: Bytes,
  document: Option<SharedDocument<TomlValue>>,
  // The directory holding its manifest.
  manifest: Path,
  // The directory its module paths resolve below.
  sourceRoot: Path,
  // The canonical paths, such as `codec/Json.silk`, of the modules other packages may import.
  exports: List<Bytes>,
  // The root of the git checkout it was read from, or `None` for a package outside the store.
  checkout: Option<Path>,
  // Native inputs attached after evaluating this reached package's typed plan.
  linkInputs: List<NativeLinkInput>,
  // Its `[native.archive.*]`, selected for the build's target.
  archives: List<Archive>,
}

// One entry of `[overrides]` in silk.local.toml: every dependency on the package `name` reads the
// package in `directory`.
struct LocalOverride {
  name: Bytes,
  // The path as silk.local.toml writes it, which a note repeats.
  written: Bytes,
  // The real directory of the local checkout's silk.toml.
  directory: Path,
  // The line of silk.local.toml that writes it.
  line: usize,
}

// The overrides of one build: the silk.local.toml that writes them, and its entries.
struct Overrides {
  file: Option<Path>,
  entries: List<LocalOverride>,
}

// One edge of the graph: package `owner` imports package `package` as `name`.
struct Edge {
  owner: Bytes,
  name: Bytes,
  package: Bytes,
}

/// How a build holds its packages to their `silk-version`, the Silk each was written for.
pub enum Versions {
  /// A package whose `silk-version` this Silk cannot build is refused.
  Checked,
  /// Such a package is built anyway and listed in `versionNotes` (`--ignore-silk-version`).
  Relaxed,
  /// Pins are not read, as for a package's `build.silk`, which its package's pin covers.
  Unchecked,
}

/// Every package of one build, the root first, and the dependency names each one declares.
pub struct Packages {
  packages: List<Package>,
  edges: List<Edge>,
  // The git checkout store, or `None` when the command has none and git dependencies are refused.
  store: Option<Path>,
  // What dependencies' archives resolve against.
  archiveContext: ArchiveContext,
  // The root package's `silk-version`, which every other package's must fit.
  rootPin: Option<Bytes>,
  // How packages are held to their `silk-version`.
  versions: Versions,
  // One line per package built despite its `silk-version`, under `Versions.Relaxed`.
  versionNotes: List<Bytes>,
  // The files besides the packages' own manifests that decide the graph, each once: the root
  // manifest of each workspace some package took a `[workspace.dependencies]` entry from, and each
  // place a silk.local.toml was looked for, whether or not one is there.
  graphFiles: List<Bytes>,
  // What the root's silk.local.toml overrides.
  overrides: Overrides,
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Whether `text` is an identifier: an ASCII letter or `_`, then letters, digits or `_`.
fn identifier(text: &[u8]) -> bool {
  if text.length == usize.ZERO {
    return false
  }
  let mut at = usize.ZERO
  while at < text.length {
    let byte = text[at]
    let letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
    let digit = byte >= 48 && byte <= 57
    if !letter && !(digit && at > usize.ZERO) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn copyPath(path: &Path) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  return run Path.fromBytes(Path.rawBytes(path))
}

// Fails with `dependency <name> of <owner>: <reason>`, at the line of the silk.toml in `directory`
// that writes `dependencies.<name>`, or its `field` unless that is empty.
effect fn invalid(owner: &[u8], name: &[u8], reason: &[u8], directory: &Path, field: &[u8]) -> never
  ! InvalidDependency | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  run invalidIn(owner, name, reason, directory, b"dependencies", field)
}

// Fails as [`invalid`] does, at the line that writes `<table>.<name>`: `table` is `dependencies`
// for a package's own entry and `workspace.dependencies` for one its workspace shares.
effect fn invalidIn(
  owner: &[u8],
  name: &[u8],
  reason: &[u8],
  directory: &Path,
  table: &[u8],
  field: &[u8],
) -> never
  ! InvalidDependency | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let manifest = run Path.join(directory, "silk.toml")
  let key = run dependencyKey(table, name, field)
  let line = run lineIn(&manifest, Bytes.asSlice(&key))
  run invalidAt(owner, name, reason, &manifest, line)
}

// Fails as [`invalid`] does, at `line` of the silk.toml `manifest`.
effect fn invalidAt(owner: &[u8], name: &[u8], reason: &[u8], manifest: &Path, line: usize) -> never
  ! InvalidDependency | OutOfMemoryError
  ? &mut Allocator {
  let mut detail = run Bytes.copy(b"dependency `")
  run Bytes.append(&mut detail, name)
  run Bytes.append(&mut detail, b"` of ")
  run Bytes.append(&mut detail, owner)
  run Bytes.append(&mut detail, b": ")
  run Bytes.append(&mut detail, reason)
  fail InvalidDependency {
    detail: move detail,
    manifest: run Bytes.copy(Path.rawBytes(manifest)),
    line: line,
  }
}

// The line of the silk.toml `manifest` that writes the dotted key `key`, or zero when it cannot be
// read. Only refusals call it, so reading the file again costs a successful build nothing.
effect fn lineIn(manifest: &Path, key: &[u8]) -> usize
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  return match move run Effect.result(FileSystem.readFile(manifest)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => ManifestText.keyLine(
      Bytes.asSlice(&value),
      key,
    )
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError unread => {
        drop unread
        return usize.ZERO
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// `<table>.<name>`, then `.<field>` unless `field` is empty: the key a dependency refusal names.
effect fn dependencyKey(table: &[u8], name: &[u8], field: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut key = run Bytes.copy(table)
  run Bytes.append(&mut key, b".")
  run Bytes.append(&mut key, name)
  if field.length > usize.ZERO {
    run Bytes.append(&mut key, b".")
    run Bytes.append(&mut key, field)
  }
  return move key
}

// The `silk-version` that applies to one package, and where it is written.
struct Pin {
  version: Option<Bytes>,
  // The silk.toml that writes it, the package's own when nothing does.
  manifest: Path,
  // The dotted key that writes it there.
  key: &'static [u8],
}

// Fails with `<label>: <reason>`, at the line of the silk.toml `manifest` that writes `key`.
effect fn refuse(label: &[u8], reason: &[u8], manifest: &Path, key: &[u8]) -> never
  ! InvalidDependency | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let line = run lineIn(manifest, key)
  let mut detail = run Bytes.copy(label)
  run Bytes.append(&mut detail, b": ")
  run Bytes.append(&mut detail, reason)
  fail InvalidDependency {
    detail: move detail,
    manifest: run Bytes.copy(Path.rawBytes(manifest)),
    line: line,
  }
}

// The `silk-version` of the package `label` names, whose parsed manifest `document` is the
// silk.toml in `directory`: its workspace's `[workspace].silk-version` when the workspace pins one,
// otherwise its own `[package].silk-version`. A package read from a checkout or an archive finds
// its workspace inside `bound` only. A package that sets its own pin beside its workspace's is
// refused, since the workspace's pin covers every member.
effect fn pinOf(label: &[u8], document: &TomlValue, directory: &Path, bound: &Option<Path>) -> Pin
  ! InvalidDependency | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let manifest = run Path.join(directory, "silk.toml")
  let shared = run Workspaces.of(directory, bound)
  if let Option<Shared>.Some { value: workspace } = &shared {
    if let Option<&[u8]>.Some { value: pinned } = move ManifestFields.workspaceText(
      Workspaces.document(&workspace),
      "silk-version",
    ) {
      if let Option<&[u8]>.Some { .. } = move ManifestFields.packageText(document, "silk-version") {
        let mut reason = run Bytes.copy(b"its silk-version is set by its workspace in ")
        run Bytes.append(&mut reason, Path.rawBytes(Workspaces.manifest(&workspace)))
        run Bytes.append(
          &mut reason,
          b", which covers every member; remove [package].silk-version here",
        )
        run refuse(label, Bytes.asSlice(&reason), &manifest, b"package.silk-version")
      }
      return Pin {
        version: Option<Bytes>.some(run Bytes.copy(pinned)),
        manifest: run copyPath(Workspaces.manifest(&workspace)),
        key: b"workspace.silk-version",
      }
    }
  }
  let mut version = Option<Bytes>.none()
  if let Option<&[u8]>.Some { value: pinned } = move ManifestFields.packageText(
    document,
    "silk-version",
  ) {
    version = Option<Bytes>.some(run Bytes.copy(pinned))
  }
  return Pin { version: move version, manifest: move manifest, key: b"package.silk-version" }
}

// Why this compiler cannot build a package whose `silk-version` is `pinned`, or nothing when it
// can. `root` is the root package's pin, which every other package's must fit; it is `None` for
// the root itself.
effect fn pinProblem(pinned: &Option<Bytes>, root: &Option<Bytes>) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let running = ReleaseVersion.value()
  let mut reason = Bytes.make()
  let written = match &pinned.* {
    Option<Bytes>.Some { value } => Bytes.asSlice(&value)
    Option<Bytes>.None => {
      run Bytes.append(&mut reason, b"it has no silk-version; set silk-version = \"")
      run Bytes.append(&mut reason, ManifestFields.withoutMetadata(running))
      run Bytes.append(
        &mut reason,
        b"\" in its [package], or in its workspace's [workspace] to cover every member",
      )
      return move reason
    }
  }
  if !ManifestFields.compatible(running, written) {
    run Bytes.append(&mut reason, b"it is written for Silk ")
    run Bytes.append(&mut reason, written)
    run Bytes.append(&mut reason, b" (its silk-version), which this Silk ")
    run Bytes.append(&mut reason, running)
    run Bytes.append(&mut reason, b" cannot build")
    if ManifestFields.isPrerelease(running) || ManifestFields.isPrerelease(written) {
      run Bytes.append(
        &mut reason,
        b": a dev release builds only packages written for that exact release. Re-pin it to ",
      )
      run Bytes.append(&mut reason, ManifestFields.withoutMetadata(running))
      run Bytes.append(&mut reason, b", or move this project to its Silk with silk set ")
      run Bytes.append(&mut reason, written)
    } else if ManifestFields.compatible(written, running) {
      run Bytes.append(
        &mut reason,
        b": it needs a newer Silk. Move this project to it with silk set ",
      )
      run Bytes.append(&mut reason, written)
    } else {
      run Bytes.append(&mut reason, b": it belongs to another release line. Re-pin it to ")
      run Bytes.append(&mut reason, ManifestFields.withoutMetadata(running))
      run Bytes.append(&mut reason, b" if it builds with this Silk")
    }
    return move reason
  }
  if let Option<Bytes>.Some { value: project } = &root.* {
    if !ManifestFields.compatible(Bytes.asSlice(&project), written) {
      run Bytes.append(&mut reason, b"it is written for Silk ")
      run Bytes.append(&mut reason, written)
      run Bytes.append(&mut reason, b", which the Silk ")
      run Bytes.append(&mut reason, Bytes.asSlice(&project))
      run Bytes.append(
        &mut reason,
        b" this project pins cannot build. Move this project to it with silk set ",
      )
      run Bytes.append(&mut reason, written)
    }
  }
  return move reason
}

// Checks the pin of the package `label` names against this compiler and the root's pin. A refusal
// fails the build, or, under `--ignore-silk-version`, becomes a note and the package builds. A
// compiler built from source, version `0.0.0`, builds every package.
effect fn checkPin(packages: &mut Packages, label: &[u8], pin: &Pin) -> ()
  ! InvalidDependency | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if packages.versions == Versions.Unchecked || same(ReleaseVersion.value(), b"0.0.0") {
    return ()
  }
  let mut reason = run pinProblem(&pin.version, &packages.rootPin)
  if Bytes.length(&reason) == usize.ZERO {
    return ()
  }
  if packages.versions == Versions.Relaxed {
    let mut note = run Bytes.copy(label)
    run Bytes.append(&mut note, b": ")
    run Bytes.append(&mut note, Bytes.asSlice(&reason))
    run List<Bytes>.append(&mut packages.versionNotes, move note)
    return ()
  }
  run Bytes.append(&mut reason, b". --ignore-silk-version builds it anyway, at your own risk")
  run refuse(label, Bytes.asSlice(&reason), &pin.manifest, pin.key)
}

// The manifest's `name@version`, or `None` without a name. The version defaults to `0.0.0`.
effect fn identityOf(document: &TomlValue) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let name = match move Toml.asString(Toml.fieldAt(Toml.field(document, "package"), "name")) {
    Option<string>.Some { value } => String.utf8Bytes(value)
    Option<string>.None => {
      return Option<Bytes>.none()
    }
  }
  let version = ManifestFields.version(document)
  if name.length == usize.ZERO || version.length == usize.ZERO {
    return Option<Bytes>.none()
  }
  let mut identity = run Bytes.copy(name)
  run Bytes.append(&mut identity, b"@")
  run Bytes.append(&mut identity, version)
  return Option<Bytes>.some(move identity)
}

// Whether `sourceRoot` holds a module `name.silk` or a directory `name`, which a dependency of the
// same name would hide (PACKAGE-003).
effect fn shadows(sourceRoot: &Path, name: &[u8]) -> bool
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let directory = run Path.joinBytes(sourceRoot, name)
  let found = run FileSystem.exists(&directory)
  if found {
    return true
  }
  let mut file = run Bytes.copy(name)
  run Bytes.append(&mut file, b".silk")
  let module = run Path.joinBytes(sourceRoot, Bytes.asSlice(&file))
  return run FileSystem.exists(&module)
}

// Fails with `exports of <package>: <entry> <reason>`, at the `package.exports` line of the
// silk.toml in `directory`.
effect fn invalidExport(package: &[u8], entry: &[u8], reason: &[u8], directory: &Path) -> never
  ! InvalidDependency | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let manifest = run Path.join(directory, "silk.toml")
  let line = run lineIn(&manifest, b"package.exports")
  let mut detail = run Bytes.copy(b"exports of ")
  run Bytes.append(&mut detail, package)
  run Bytes.append(&mut detail, b": ")
  run Bytes.append(&mut detail, entry)
  run Bytes.append(&mut detail, b" ")
  run Bytes.append(&mut detail, reason)
  fail InvalidDependency {
    detail: move detail,
    manifest: run Bytes.copy(Path.rawBytes(&manifest)),
    line: line,
  }
}

// The canonical module paths `[package].exports` lists in import spelling (`codec.Json` becomes
// `codec/Json.silk`, or `codec/Json/mod.silk` when that barrel file is the one present), each
// checked to name a module below `sourceRoot` (PACKAGE-006). `directory` holds the manifest.
effect fn exportsOf(
  package: &[u8],
  document: &TomlValue,
  directory: &Path,
  sourceRoot: &Path,
) -> List<Bytes>
  ! InvalidDependency | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut exports = List<Bytes>.make()
  let listed = match move Toml.fieldAt(Toml.field(document, "package"), "exports") {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      return move exports
    }
  }
  let array = match &listed.* {
    TomlValue.Array { .. } => true
    _ => false
  }
  if !array {
    run invalidExport(package, b"[package].exports", b"must be an array of module names", directory)
  }
  let mut at = usize.ZERO
  while true {
    let item = match move Toml.item(listed, at) {
      Option<&TomlValue>.Some { value } => value
      Option<&TomlValue>.None => {
        return move exports
      }
    }
    let spelling = match move Toml.asString(Option<&TomlValue>.some(item)) {
      Option<string>.Some { value } => String.utf8Bytes(value)
      Option<string>.None => run invalidExport(
        package,
        b"[package].exports",
        b"must list module names as strings",
        directory,
      )
    }
    let mut path = Bytes.make()
    let mut start = usize.ZERO
    let mut cursor = usize.ZERO
    while cursor <= spelling.length {
      if cursor == spelling.length || spelling[cursor] == 46 {
        let segment = Slice.view<u8>(spelling, start, cursor - start)
        if !identifier(segment) {
          run invalidExport(
            package,
            spelling,
            b"is not a module name such as `codec.Json`",
            directory,
          )
        }
        if start > usize.ZERO {
          run Bytes.append(&mut path, b"/")
        }
        run Bytes.append(&mut path, segment)
        start = cursor + usize.ONE
      }
      cursor = cursor + usize.ONE
    }
    run Bytes.append(&mut path, b".silk")

    // MODULE-007: the entry names the module file or its directory's barrel `mod.silk`.
    if PackageGraph.isBarrel(Bytes.asSlice(&path)) {
      run invalidExport(
        package,
        spelling,
        b"names a `mod.silk` file; list its directory's path without `.mod`",
        directory,
      )
    }
    let barrel = run PackageGraph.barrelPath(Bytes.asSlice(&path))
    let file = run Path.joinBytes(sourceRoot, Bytes.asSlice(&path))
    let fileFound = run FileSystem.exists(&file)
    let barrelFile = run Path.joinBytes(sourceRoot, Bytes.asSlice(&barrel))
    let barrelFound = run FileSystem.exists(&barrelFile)
    if fileFound && barrelFound {
      run invalidExport(
        package,
        spelling,
        b"names both a module file and its directory's `mod.silk`; remove or rename one of them",
        directory,
      )
    }
    if !fileFound && !barrelFound {
      run invalidExport(package, spelling, b"is not a module of the package", directory)
    }
    if barrelFound {
      run List<Bytes>.append(&mut exports, move barrel)
    } else {
      run List<Bytes>.append(&mut exports, move path)
    }
    at = at + usize.ONE
  }
  return move exports
}

// The members of a table, or `None` for another kind of value.
fn members<'a>(value: &'a TomlValue) -> Option<&'a [TomlChild]> {
  return match &value.* {
    TomlValue.Table { entries, kind: _ } => {
      let boxed = Box<List<TomlChild>>.get(&entries)
      return Option<&'a [TomlChild]>.some(List<TomlChild>.asSlice(&boxed[0]))
    }
    _ => Option<&'a [TomlChild]>.none()
  }
}

fn indexOf(packages: &[Package], name: &[u8]) -> usize {
  let mut at = usize.ZERO
  while at < packages.length {
    if same(Bytes.asSlice(&packages[at].name), name) {
      return at
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn onStack(stack: &[Bytes], identity: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < stack.length {
    if same(Bytes.asSlice(&stack[at]), identity) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Whether `path` is `root` or a path below it.
fn within(root: &[u8], path: &[u8]) -> bool {
  if path.length < root.length || !same(Slice.view<u8>(path, usize.ZERO, root.length), root) {
    return false
  }
  return path.length == root.length || path[root.length] == 47
}

// Whether `written` is a relative path with no `..` segment, so it stays below the directory it
// is joined to.
fn contained(written: &[u8]) -> bool {
  if written.length == usize.ZERO || written[usize.ZERO] == 47 {
    return false
  }
  let mut start = usize.ZERO
  let mut cursor = usize.ZERO
  while cursor <= written.length {
    if cursor == written.length || written[cursor] == 47 {
      if cursor - start == usize.add(0, 2) && written[start] == 46
        && written[start + usize.ONE] == 46 {
        return false
      }
      start = cursor + usize.ONE
    }
    cursor = cursor + usize.ONE
  }
  return true
}

// `path`'s real directory, or `path` itself when it cannot be resolved, so that paths reaching one
// directory through different symbolic links compare equal.
effect fn real(path: Path) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  return match move run HostPath.canonicalBytes(Path.rawBytes(&path)) {
    Option<Bytes>.Some { value } => run Path.fromBytes(Bytes.asSlice(&value))
    Option<Bytes>.None => move path
  }
}

/// Whether `url` is an archive URL a url dependency may name: HTTPS, or a `file://` URL of an
/// absolute path, as a local mirror serves.
pub fn isArchiveUrl(url: &[u8]) -> bool {
  return (startsWith(url, b"https://") && url.length > 8)
    || (startsWith(url, b"file:///") && url.length > 8)
}

fn startsWith(text: &[u8], prefix: &[u8]) -> bool {
  return text.length >= prefix.length
    && same(Slice.view<u8>(text, usize.ZERO, prefix.length), prefix)
}

// Whether `digest` is a SHA-256 in lowercase hexadecimal.
fn isDigest(digest: &[u8]) -> bool {
  if digest.length != 64 {
    return false
  }
  let mut at = usize.ZERO
  while at < digest.length {
    let byte = digest[at]
    if !((byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102)) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// The directory of the archive with SHA-256 `digest` in the archive store beside the checkout
/// store `store` (`$SILK_HOME/archives/<digest>`), or none.
pub effect fn archiveDirectory(store: &Path, digest: &[u8]) -> Option<Path>
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  return match move run Path.parent(store) {
    Option<Path>.Some { value: home } => Option<Path>.some(
      run Path.joinBytes(&run Path.join(&home, "archives"), digest),
    )
    Option<Path>.None => Option<Path>.none()
  }
}

/// The package root of an extracted archive: `directory` when it holds `silk.toml`, else its one
/// entry when that is a directory, as an archive with a top directory such as `name-1.0.0/` holds.
pub effect fn archiveRoot(directory: Path) -> Path
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let manifest = run Path.join(&directory, "silk.toml")
  if let Result<bool, FileError>.Success { value: found } = move run Effect.result(
    FileSystem.exists(&manifest),
  ) {
    if found {
      return move directory
    }
  }
  let listed = run Effect.result(FileSystem.listDirectory(&directory))
  if let Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success {
    value: entries
  } = move listed {
    let children = List<DirectoryEntry>.asSlice(&entries)
    if children.length == usize.ONE
      && children[usize.ZERO].kind.code == FileSystem.entryKindCode(FileSystem.directory()) {
      return run copyPath(&children[usize.ZERO].path)
    }
  }
  return move directory
}

// Where a dependency's manifest is, and the checkout holding it.
struct Located {
  directory: Path,
  checkout: Option<Path>,
  // The package name its entry expects with `package`, when it writes one.
  package: Option<Bytes>,
}

// The package name the dependency entry `entry` writes as `package`, when it does.
effect fn expectedPackage(entry: &TomlValue) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move Toml.asString(Toml.field(entry, "package")) {
    Option<string>.Some { value } => Option<Bytes>.some(run Bytes.copy(String.utf8Bytes(value)))
    Option<string>.None => Option<Bytes>.none()
  }
}

// Validates dependency entries with the public manifest schema, including workspace pins.
effect fn checkFields(
  owner: &[u8],
  name: &[u8],
  entry: &TomlValue,
  directory: &Path,
  table: &[u8],
) -> ()
  ! InvalidDependency | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut reader = TomlSchemaReader.make(entry)
  match move run Effect.result(Schemas.read<Dependency>(&mut reader)) {
    Result<Dependency, Issue | OutOfMemoryError>.Success { value } => {
      drop value
    }
    Result<Dependency, Issue | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      Issue problem => {
        run invalidIn(owner, name, String.utf8Bytes(problem.expected), directory, table, b"")
      }
    }
  }
  return ()
}

// Locates the dependency `name` of `owner`, written as `entry` in the silk.toml in
// `ownerDirectory`. An entry that is `{ workspace = true }` is read from the entry of the same
// name in `[workspace.dependencies]` of `shared`, the owner's workspace, whose `path` resolves
// against the workspace root's directory (PACKAGE-008).
effect fn place(
  packages: &Packages,
  owner: &[u8],
  name: &[u8],
  entry: &TomlValue,
  ownerDirectory: &Path,
  ownerCheckout: &Option<Path>,
  shared: &Option<Shared>,
) -> Located
  ! InvalidDependency | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if !Workspaces.inherits(entry) {
    return run locate(packages, owner, name, entry, ownerDirectory, ownerCheckout, b"dependencies")
  }
  let workspace = match &shared.* {
    Option<Shared>.Some { value } => &value
    Option<Shared>.None => run invalid(
      owner,
      name,
      b"workspace = true takes the entry from [workspace.dependencies], but no workspace lists this package as a member",
      ownerDirectory,
      b"workspace",
    )
  }
  let root = Workspaces.directory(workspace)
  let written = match move Workspaces.find(workspace, name) {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      let mut reason = run Bytes.copy(
        b"workspace = true takes the entry from [workspace.dependencies] of ",
      )
      run Bytes.append(&mut reason, Path.rawBytes(Workspaces.manifest(workspace)))
      run Bytes.append(&mut reason, b", which has no `")
      run Bytes.append(&mut reason, name)
      run Bytes.append(&mut reason, b"`")
      run invalid(owner, name, Bytes.asSlice(&reason), ownerDirectory, b"workspace")
    }
  }
  let table = match &written.* {
    TomlValue.Table { .. } => true
    _ => false
  }
  if !table {
    run invalidIn(
      owner,
      name,
      b"a dependency must be a table such as { path = \"../library\" }",
      root,
      b"workspace.dependencies",
      b"",
    )
  }
  if Workspaces.inherits(written) {
    run invalidIn(
      owner,
      name,
      b"an entry of [workspace.dependencies] is the one members take, so it cannot be workspace = true itself",
      root,
      b"workspace.dependencies",
      b"workspace",
    )
  }
  run checkFields(owner, name, written, root, b"workspace.dependencies")
  return run locate(packages, owner, name, written, root, ownerCheckout, b"workspace.dependencies")
}

// The directory of the manifest the dependency `name` of `owner`, whose entry is `entry`, reads.
// A git dependency's is `path` below the checkout of `rev`, the checkout root by default. A path
// dependency's is `path` from `ownerDirectory`, and must stay inside `ownerCheckout` when the owner
// was read from one. `ownerDirectory` holds the silk.toml that writes `entry` in its table `table`:
// the owner's `dependencies`, or its workspace's `workspace.dependencies`.
effect fn locate(
  packages: &Packages,
  owner: &[u8],
  name: &[u8],
  entry: &TomlValue,
  ownerDirectory: &Path,
  ownerCheckout: &Option<Path>,
  table: &[u8],
) -> Located
  ! InvalidDependency | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if let Option<&TomlValue>.Some { .. } = move Toml.field(entry, "url") {
    let url = match move Toml.asString(Toml.field(entry, "url")) {
      Option<string>.Some { value } => String.utf8Bytes(value)
      Option<string>.None => b""
    }
    if !isArchiveUrl(url) {
      run invalidIn(
        owner,
        name,
        b"url must be an https:// URL of the package's archive, or a file:/// URL, as url = \"https://example.com/library-1.0.0.tar.gz\"",
        ownerDirectory,
        table,
        b"url",
      )
    }
    if let Option<&TomlValue>.Some { .. } = move Toml.field(entry, "git") {
      run invalidIn(
        owner,
        name,
        b"a dependency takes git or url, not both",
        ownerDirectory,
        table,
        b"url",
      )
    }
    let digest = match move Toml.asString(Toml.field(entry, "sha256")) {
      Option<string>.Some { value } => String.utf8Bytes(value)
      Option<string>.None => run invalidIn(
        owner,
        name,
        b"a url dependency needs sha256, the SHA-256 of the archive; silk add <url> writes it",
        ownerDirectory,
        table,
        b"url",
      )
    }
    if !isDigest(digest) {
      run invalidIn(
        owner,
        name,
        b"sha256 must be 64 lowercase hexadecimal digits",
        ownerDirectory,
        table,
        b"sha256",
      )
    }
    let store = match &packages.store {
      Option<Path>.Some { value } => &value
      Option<Path>.None => run invalidIn(
        owner,
        name,
        b"this command cannot read url dependencies: neither SILK_HOME nor HOME (USERPROFILE on Windows) names an absolute directory",
        ownerDirectory,
        table,
        b"url",
      )
    }
    let extracted = match move run archiveDirectory(store, digest) {
      Option<Path>.Some { value } => move value
      Option<Path>.None => run invalidIn(
        owner,
        name,
        b"there is no archive store to read it from: set SILK_HOME or HOME",
        ownerDirectory,
        table,
        b"url",
      )
    }
    let mut fetchedMarker = run Bytes.copy(Path.rawBytes(&extracted))
    run Bytes.append(&mut fetchedMarker, b".fetched")
    let present = match move run Effect.result(
      FileSystem.exists(&run Path.fromBytes(Bytes.asSlice(&fetchedMarker))),
    ) {
      Result<bool, FileError>.Success { value } => value
      Result<bool, FileError>.Failure { error } => {
        drop error
        false
      }
    }
    if !present {
      let mut reason = run Bytes.copy(b"the archive at ")
      run Bytes.append(&mut reason, url)
      run Bytes.append(
        &mut reason,
        b" is not fetched yet; silk build, check, test and run fetch it",
      )
      run invalidIn(owner, name, Bytes.asSlice(&reason), ownerDirectory, table, b"url")
    }
    let root = run real(run archiveRoot(move extracted))
    let mut directory = run copyPath(&root)
    if let Option<&TomlValue>.Some { .. } = move Toml.field(entry, "path") {
      let inner = match move Toml.asString(Toml.field(entry, "path")) {
        Option<string>.Some { value } => String.utf8Bytes(value)
        Option<string>.None => b"/"
      }
      if !contained(inner) {
        run invalidIn(
          owner,
          name,
          b"path of a url dependency must name a directory inside the archive, relative to its root",
          ownerDirectory,
          table,
          b"path",
        )
      }
      directory = run real(run Path.joinBytes(&root, inner))
      if !within(Path.rawBytes(&root), Path.rawBytes(&directory)) {
        run invalidIn(
          owner,
          name,
          b"path of a url dependency must name a directory inside the archive, relative to its root",
          ownerDirectory,
          table,
          b"path",
        )
      }
    }
    return Located {
      directory: move directory,
      checkout: Option<Path>.some(move root),
      package: run expectedPackage(entry),
    }
  }
  if let Option<&TomlValue>.Some { .. } = move Toml.field(entry, "sha256") {
    run invalidIn(
      owner,
      name,
      b"sha256 pins a url dependency; add url, where the archive is",
      ownerDirectory,
      table,
      b"sha256",
    )
  }
  let rev = Toml.field(entry, "rev")
  if let Option<&TomlValue>.Some { .. } = move Toml.field(entry, "git") {
    let url = match move Toml.asString(Toml.field(entry, "git")) {
      Option<string>.Some { value } => String.utf8Bytes(value)
      Option<string>.None => b""
    }
    if !Checkouts.isRepository(url) {
      run invalidIn(
        owner,
        name,
        b"git must be the repository URL or absolute path, as git = \"https://example.com/library.git\"",
        ownerDirectory,
        table,
        b"git",
      )
    }
    let commit = match move Toml.asString(rev) {
      Option<string>.Some { value } => String.utf8Bytes(value)
      Option<string>.None => run invalidIn(
        owner,
        name,
        b"a git dependency needs rev, the full hash of the commit to build",
        ownerDirectory,
        table,
        b"git",
      )
    }
    if !Checkouts.isCommit(commit) {
      run invalidIn(
        owner,
        name,
        b"rev must be a full commit hash: 40 or 64 lowercase hexadecimal digits",
        ownerDirectory,
        table,
        b"rev",
      )
    }
    let store = match &packages.store {
      Option<Path>.Some { value } => &value
      Option<Path>.None => run invalidIn(
        owner,
        name,
        b"this command cannot read git dependencies: neither SILK_HOME nor HOME (USERPROFILE on Windows) names an absolute checkout directory",
        ownerDirectory,
        table,
        b"git",
      )
    }
    let present = run Checkouts.fetched(store, commit)
    if !present {
      let mut reason = run Bytes.copy(b"commit ")
      run Bytes.append(&mut reason, commit)
      run Bytes.append(&mut reason, b" of ")
      run Bytes.append(&mut reason, url)
      run Bytes.append(
        &mut reason,
        b" is not fetched yet; silk build, check, test and run fetch it",
      )
      run invalidIn(owner, name, Bytes.asSlice(&reason), ownerDirectory, table, b"rev")
    }
    let root = run real(run Checkouts.checkout(store, commit))
    let mut directory = run copyPath(&root)
    if let Option<&TomlValue>.Some { .. } = move Toml.field(entry, "path") {
      let inner = match move Toml.asString(Toml.field(entry, "path")) {
        Option<string>.Some { value } => String.utf8Bytes(value)
        Option<string>.None => b"/"
      }
      if !contained(inner) {
        run invalidIn(
          owner,
          name,
          b"path of a git dependency must name a directory inside the repository, relative to its root",
          ownerDirectory,
          table,
          b"path",
        )
      }
      directory = run real(run Path.joinBytes(&root, inner))
      if !within(Path.rawBytes(&root), Path.rawBytes(&directory)) {
        run invalidIn(
          owner,
          name,
          b"path of a git dependency must name a directory inside the repository, relative to its root",
          ownerDirectory,
          table,
          b"path",
        )
      }
    }
    return Located {
      directory: move directory,
      checkout: Option<Path>.some(move root),
      package: run expectedPackage(entry),
    }
  }
  if let Option<&TomlValue>.Some { .. } = move rev {
    run invalidIn(
      owner,
      name,
      b"rev pins a git dependency; add git, the repository URL",
      ownerDirectory,
      table,
      b"rev",
    )
  }
  let written = match move Toml.asString(Toml.field(entry, "path")) {
    Option<string>.Some { value } => String.utf8Bytes(value)
    Option<string>.None => run invalidIn(
      owner,
      name,
      b"path must name the directory of the dependency's silk.toml",
      ownerDirectory,
      table,
      b"path",
    )
  }

  // A dependency is read at its real directory, so paths that reach one package through
  // different symbolic links name one directory.
  let directory = run real(run CommandPath.resolve(ownerDirectory, written))
  return match &ownerCheckout.* {
    Option<Path>.Some { value: root } => {
      if !within(Path.rawBytes(&root), Path.rawBytes(&directory)) {
        run invalidIn(
          owner,
          name,
          b"a package from a git dependency reaches packages by path only inside its own repository",
          ownerDirectory,
          table,
          b"path",
        )
      }
      return Located {
        directory: move directory,
        checkout: Option<Path>.some(run copyPath(&root)),
        package: run expectedPackage(entry),
      }
    }
    Option<Path>.None => Located {
      directory: move directory,
      checkout: Option<Path>.none(),
      package: run expectedPackage(entry),
    }
  }
}

/// Fetches into the checkout store `store` (driver/GitCheckouts) every git dependency that the
/// package whose manifest `document` sits in `directory` reaches, directly or through other
/// packages, and that the store lacks. It follows only entries it can read and leaves every other
/// check to [`load`]. A fetch that fails is an invalid dependency naming its `git` line.
pub effect fn fetch(directory: &Path, document: &TomlValue, store: &Path) -> ()
  ! InvalidDependency | HostInputError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let mut seen = List<Bytes>.make()
  let mut files = List<Bytes>.make()
  let overrides = run readOverrides(directory, &mut files)
  run fetchVisit(
    directory,
    document,
    store,
    &Option<Path>.none(),
    &mut seen,
    Option<&[u8]>.none(),
    List<LocalOverride>.asSlice(&overrides.entries),
  )
}

// `checkout` is the root of the checkout the package in `directory` was fetched into, or `None`
// for a package outside the store.
effect fn fetchVisit(
  directory: &Path,
  document: &TomlValue,
  store: &Path,
  checkout: &Option<Path>,
  seen: &mut List<Bytes>,
  selected: Option<&[u8]>,
  overrides: &[LocalOverride],
) -> ()
  ! InvalidDependency | HostInputError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let children = match move Toml.field(document, "dependencies") {
    Option<&TomlValue>.Some { value } => match move members(value) {
      Option<&[TomlChild]>.Some { value: listed } => listed
      Option<&[TomlChild]>.None => {
        return ()
      }
    }
    Option<&TomlValue>.None => {
      return ()
    }
  }
  let mut shared = Option<Shared>.none()
  if inheriting(children) {
    shared = run Workspaces.of(directory, checkout)
  }
  let mut at = usize.ZERO
  while at < children.length {
    if let TomlChild.Member { entry } = &children[at] {
      let name = String.ownedUtf8Bytes(&entry.key)
      if let Option<&[u8]>.Some { value } = selected {
        if !same(value, name) {
          at = at + 1
          continue
        }
      }

      // An entry taken from the workspace is fetched as the workspace writes it; one that names
      // no workspace entry is left for the load to refuse.
      let source = match move Workspaces.source(&shared, name, &entry.value) {
        Option<&TomlValue>.Some { value } => value
        Option<&TomlValue>.None => {
          at = at + usize.ONE
          continue
        }
      }

      // A failed fetch names the manifest that writes the pin: this package's, or its workspace's.
      let site = Workspaces.base(&shared, &entry.value, directory)
      let table: &[u8] = if Workspaces.inherits(&entry.value) {
        b"workspace.dependencies"
      } else {
        b"dependencies"
      }
      let mut target = Option<Path>.none()

      // The checkout the target was fetched into: its own, or else its owner's.
      let mut inside = Option<Path>.none()
      if let Option<Path>.Some { value: owners } = &checkout.* {
        inside = Option<Path>.some(run copyPath(&owners))
      }
      let url = Toml.asString(Toml.field(source, "git"))
      let rev = Toml.asString(Toml.field(source, "rev"))
      let path = Toml.asString(Toml.field(source, "path"))
      let archive = Toml.asString(Toml.field(source, "url"))
      let digest = Toml.asString(Toml.field(source, "sha256"))

      // An overridden package is read from its local checkout, so nothing is fetched for it.
      let overridden = overrideAt(overrides, requested(&shared, name, &entry.value))
      if overridden != usize.MAX {
        target = Option<Path>.some(run copyPath(&overrides[overridden].directory))
        inside = Option<Path>.none()
      } else if let Option<string>.Some { value: located } = move archive {
        let address = String.utf8Bytes(located)
        if let Option<string>.Some { value: pinned } = move digest {
          let sha = String.utf8Bytes(pinned)

          // An entry that also names git is refused when it is located, before anything is fetched.
          let alsoGit = match &url {
            Option<string>.Some { .. } => true
            Option<string>.None => false
          }
          if isArchiveUrl(address) && isDigest(sha) && !alsoGit {
            if let Option<Path>.Some { value: extracted } = move run archiveDirectory(store, sha) {
              if let Option<Bytes>.Some { value: failure } = move run NativeArchives.ensureOne(
                name,
                address,
                sha,
                &extracted,
                usize.ZERO,
              ) {
                let owner = match move run identityOf(document) {
                  Option<Bytes>.Some { value } => move value
                  Option<Bytes>.None => run Bytes.copy(Path.rawBytes(directory))
                }
                run invalidIn(
                  Bytes.asSlice(&owner),
                  name,
                  Bytes.asSlice(&failure),
                  site,
                  table,
                  b"url",
                )
              }
              let root = run archiveRoot(move extracted)
              inside = Option<Path>.some(run real(run copyPath(&root)))
              if let Option<string>.Some { value: inner } = move path {
                if contained(String.utf8Bytes(inner)) {
                  target = Option<Path>.some(run Path.joinBytes(&root, String.utf8Bytes(inner)))
                }
              } else {
                target = Option<Path>.some(move root)
              }
            }
          }
        }
      } else if let Option<string>.Some { value: written } = move url {
        if let Option<string>.Some { value: pinned } = move rev {
          let commit = String.utf8Bytes(pinned)
          if Checkouts.isCommit(commit) && Checkouts.isRepository(String.utf8Bytes(written)) {
            let fetched = run Effect.result(
              Checkouts.fetch(store, String.utf8Bytes(written), commit),
            )
            match move fetched {
              Result<(), FetchFailed | HostInputError | FileError | OutOfMemoryError>.Success {
                ..
              } => {}
              Result<(), FetchFailed | HostInputError | FileError | OutOfMemoryError>.Failure {
                error
              } => match move error {
                FetchFailed failure => {
                  let mut reason = run Bytes.copy(b"fetching commit ")
                  run Bytes.append(&mut reason, commit)
                  run Bytes.append(&mut reason, b" of ")
                  run Bytes.append(&mut reason, String.utf8Bytes(written))
                  run Bytes.append(&mut reason, b" failed: ")
                  run Bytes.append(&mut reason, Bytes.asSlice(&failure.detail))
                  let owner = match move run identityOf(document) {
                    Option<Bytes>.Some { value } => move value
                    Option<Bytes>.None => run Bytes.copy(Path.rawBytes(directory))
                  }
                  run invalidIn(
                    Bytes.asSlice(&owner),
                    name,
                    Bytes.asSlice(&reason),
                    site,
                    table,
                    b"git",
                  )
                }
                HostInputError unread => {
                  fail move unread
                }
                FileError unwritten => {
                  let mut reason = run Bytes.copy(b"its checkout cannot be written below ")
                  run Bytes.append(&mut reason, Path.rawBytes(store))
                  drop unwritten
                  let owner = match move run identityOf(document) {
                    Option<Bytes>.Some { value } => move value
                    Option<Bytes>.None => run Bytes.copy(Path.rawBytes(directory))
                  }
                  run invalidIn(
                    Bytes.asSlice(&owner),
                    name,
                    Bytes.asSlice(&reason),
                    site,
                    table,
                    b"git",
                  )
                }
                OutOfMemoryError exhausted => {
                  fail move exhausted
                }
              }
            }
            let root = run Checkouts.checkout(store, commit)
            inside = Option<Path>.some(run real(run copyPath(&root)))
            if let Option<string>.Some { value: inner } = move path {
              if contained(String.utf8Bytes(inner)) {
                target = Option<Path>.some(run Path.joinBytes(&root, String.utf8Bytes(inner)))
              }
            } else {
              target = Option<Path>.some(move root)
            }
          }
        }
      } else if let Option<string>.Some { value: written } = move path {
        target = Option<Path>.some(
          run CommandPath.resolve(
            Workspaces.base(&shared, &entry.value, directory),
            String.utf8Bytes(written),
          ),
        )
      }
      if selected.isNone() {
        if let Option<Path>.Some { value: found } = move target {
          let resolved = run real(move found)
          if !onStack(List<Bytes>.asSlice(&seen.*), Path.rawBytes(&resolved)) {
            run List<Bytes>.append(&mut seen.*, run Bytes.copy(Path.rawBytes(&resolved)))
            let manifest = run Path.join(&resolved, "silk.toml")
            if let Result<Bytes, FileError | OutOfMemoryError>.Success {
              value: contents
            } = move run Effect.result(FileSystem.readFile(&manifest)) {
              if let Result<TomlValue, TomlError | OutOfMemoryError>.Success {
                value: dependency
              } = move run Effect.result(Toml.parse(Bytes.asSlice(&contents))) {
                run fetchVisit(
                  &resolved,
                  &dependency,
                  store,
                  &inside,
                  &mut seen.*,
                  Option<&[u8]>.none(),
                  overrides,
                )
              }
            }
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

/// The real directories of the packages that the package in `directory`, whose manifest is
/// `document`, reaches by path, directly or through other packages, each once. A workspace check
/// orders its members by them. Best effort: a git dependency, and a path or manifest that does not
/// read, are passed over.
pub effect fn pathDependencies(directory: &Path, document: &TomlValue) -> List<Bytes>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut reached = List<Bytes>.make()
  run reachPaths(directory, document, &mut reached)
  return move reached
}

// The real directory that `written` names from `directory`.
effect fn realPath(directory: &Path, written: &[u8]) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  return run real(run CommandPath.resolve(directory, written))
}

effect fn reachPaths(directory: &Path, document: &TomlValue, reached: &mut List<Bytes>) -> ()
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let children = match move Toml.field(document, "dependencies") {
    Option<&TomlValue>.Some { value } => match move members(value) {
      Option<&[TomlChild]>.Some { value: listed } => listed
      Option<&[TomlChild]>.None => {
        return ()
      }
    }
    Option<&TomlValue>.None => {
      return ()
    }
  }
  let mut shared = Option<Shared>.none()
  if inheriting(children) {
    if let Result<Option<Shared>, FileError | OutOfMemoryError>.Success {
      value
    } = move run Effect.result(Workspaces.of(directory, &Option<Path>.none())) {
      shared = move value
    }
  }
  let mut at = usize.ZERO
  while at < children.length {
    if let TomlChild.Member { entry } = &children[at] {
      let source = match move Workspaces.source(
        &shared,
        String.ownedUtf8Bytes(&entry.key),
        &entry.value,
      ) {
        Option<&TomlValue>.Some { value } => value
        Option<&TomlValue>.None => {
          at = at + usize.ONE
          continue
        }
      }
      let git = Toml.asString(Toml.field(source, "git"))
      let path = Toml.asString(Toml.field(source, "path"))
      if let Option<string>.Some { value: written } = move path {
        if Option<string>.isNone(&git) {
          let located = run Effect.result(
            realPath(Workspaces.base(&shared, &entry.value, directory), String.utf8Bytes(written)),
          )
          match move located {
            Result<Path, FileError | OutOfMemoryError>.Success { value: resolved } => {
              if !onStack(List<Bytes>.asSlice(&reached.*), Path.rawBytes(&resolved)) {
                run List<Bytes>.append(&mut reached.*, run Bytes.copy(Path.rawBytes(&resolved)))
                if let Result<Path, FileError | OutOfMemoryError>.Success {
                  value: manifest
                } = move run Effect.result(Path.join(&resolved, "silk.toml")) {
                  if let Result<Bytes, FileError | OutOfMemoryError>.Success {
                    value: contents
                  } = move run Effect.result(FileSystem.readFile(&manifest)) {
                    if let Result<TomlValue, TomlError | OutOfMemoryError>.Success {
                      value: dependency
                    } = move run Effect.result(Toml.parse(Bytes.asSlice(&contents))) {
                      run reachPaths(&resolved, &dependency, &mut reached.*)
                    }
                  }
                }
              }
            }
            Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
              FileError failure => {
                drop failure
              }
              OutOfMemoryError exhausted => {
                fail move exhausted
              }
            }
          }
        }
      }
    }
    at = at + usize.ONE
  }
}

// Whether some entry among `children`, the members of a `[dependencies]` table, takes its fields
// from the workspace.
fn inheriting(children: &[TomlChild]) -> bool {
  let mut at = usize.ZERO
  while at < children.length {
    if let TomlChild.Member { entry } = &children[at] {
      if Workspaces.inherits(&entry.value) {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Loads every dependency the package at `owner` declares in `document`, then theirs.
effect fn visit(packages: &mut Packages, owner: usize, document: &TomlValue, selected: &[u8]) -> ()
  ! InvalidDependency | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let listed = match move Toml.field(document, "dependencies") {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      return ()
    }
  }
  let listedOwner = List<Package>.asSlice(&packages.packages)
  let ownerIdentity = run Bytes.copy(Bytes.asSlice(&listedOwner[owner].identity))
  let ownerManifest = run copyPath(&listedOwner[owner].manifest)
  let ownerSourceRoot = run copyPath(&listedOwner[owner].sourceRoot)
  let mut ownerCheckout = Option<Path>.none()
  if let Option<Path>.Some { value } = &listedOwner[owner].checkout {
    ownerCheckout = Option<Path>.some(run copyPath(&value))
  }
  let owned = Bytes.asSlice(&ownerIdentity)
  let children = match move members(listed) {
    Option<&[TomlChild]>.Some { value } => value
    Option<&[TomlChild]>.None => {
      let mut detail = run Bytes.copy(b"[dependencies] of ")
      run Bytes.append(&mut detail, owned)
      run Bytes.append(&mut detail, b" must be a table")
      let manifest = run Path.join(&ownerManifest, "silk.toml")
      let line = run lineIn(&manifest, b"dependencies")
      fail InvalidDependency {
        detail: move detail,
        manifest: run Bytes.copy(Path.rawBytes(&manifest)),
        line: line,
      }
    }
  }

  // The owner's workspace is read once, and only when an entry takes its fields from it.
  let mut shared = Option<Shared>.none()
  if inheriting(children) {
    shared = run Workspaces.of(&ownerManifest, &ownerCheckout)
    if let Option<Shared>.Some { value: workspace } = &shared {
      let read = Path.rawBytes(Workspaces.manifest(&workspace))
      if !onStack(List<Bytes>.asSlice(&packages.graphFiles), read) {
        run List<Bytes>.append(&mut packages.graphFiles, run Bytes.copy(read))
      }
    }
  }
  let mut at = usize.ZERO
  while at < children.length {
    if let TomlChild.Member { entry } = &children[at] {
      let name = String.ownedUtf8Bytes(&entry.key)
      if !same(name, selected) {
        at = at + 1
        continue
      }
      if !identifier(name) {
        run invalid(owned, name, b"a dependency name must be an identifier", &ownerManifest, b"")
      }
      if same(name, b"silk") || same(name, b"Intrinsic") || same(name, b"self")
        || same(name, b"silkc") {
        run invalid(owned, name, b"the name is reserved for the toolchain", &ownerManifest, b"")
      }
      let table = match &entry.value {
        TomlValue.Table { .. } => true
        _ => false
      }
      if !table {
        run invalid(
          owned,
          name,
          b"a dependency must be a table such as { path = \"../library\" }",
          &ownerManifest,
          b"",
        )
      }
      run checkFields(owned, name, &entry.value, &ownerManifest, b"dependencies")
      let hidden = run shadows(&ownerSourceRoot, name)
      if hidden {
        run invalid(
          owned,
          name,
          b"the name is also a top-level module or directory of this package's source root",
          &ownerManifest,
          b"",
        )
      }
      // An override of silk.local.toml replaces the entry wherever it points.
      let wanted = requested(&shared, name, &entry.value)
      let overridden = overrideAt(List<LocalOverride>.asSlice(&packages.overrides.entries), wanted)
      let located = if overridden == usize.MAX {
        run place(
          &packages.*,
          owned,
          name,
          &entry.value,
          &ownerManifest,
          &ownerCheckout,
          &shared,
        )
      } else {
        let chosen = &List<LocalOverride>.asSlice(&packages.overrides.entries)[overridden]
        Located {
          directory: run copyPath(&chosen.directory),
          checkout: Option<Path>.none(),
          package: Option<Bytes>.none(),
        }
      }
      let Located { directory, checkout, package: expected } = move located
      let manifest = run Path.join(&directory, "silk.toml")
      let read = run Effect.result(FileSystem.readFile(&manifest))
      let contents = match move read {
        Result<Bytes, FileError | OutOfMemoryError>.Success { value } => move value
        Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
          FileError missing => {
            drop missing
            let mut reason = run Bytes.copy(b"no readable silk.toml at ")
            run Bytes.append(&mut reason, Path.rawBytes(&directory))
            run invalid(owned, name, Bytes.asSlice(&reason), &ownerManifest, b"path")
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
      let parsed = run Effect.result(Toml.parse(Bytes.asSlice(&contents)))
      let dependency = match move parsed {
        Result<TomlValue, TomlError | OutOfMemoryError>.Success { value } => move value
        Result<TomlValue, TomlError | OutOfMemoryError>.Failure { error } => match move error {
          TomlError malformed => {
            let mut reason = run Bytes.copy(b"its silk.toml is not valid TOML: ")
            run ManifestText.appendTomlReason(&mut reason, Bytes.asSlice(&contents), &malformed)
            run invalidAt(
              owned,
              name,
              Bytes.asSlice(&reason),
              &manifest,
              ManifestText.lineAt(Bytes.asSlice(&contents), malformed.offset),
            )
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }

      // A dependency's `silk-version` names the Silk it was written for (PACKAGE-002).
      let mut label = run Bytes.copy(b"dependency `")
      run Bytes.append(&mut label, name)
      run Bytes.append(&mut label, b"` of ")
      run Bytes.append(&mut label, owned)
      if packages.versions != Versions.Unchecked {
        let pin = run pinOf(Bytes.asSlice(&label), &dependency, &directory, &checkout)
        run checkPin(&mut packages.*, Bytes.asSlice(&label), &pin)
      }
      let identity = match move run identityOf(&dependency) {
        Option<Bytes>.Some { value } => move value
        Option<Bytes>.None => run invalidAt(
          owned,
          name,
          b"its silk.toml has no [package] name",
          &manifest,
          ManifestText.keyLine(Bytes.asSlice(&contents), b"package.name"),
        )
      }
      let packageName = match move Toml.asString(
        Toml.fieldAt(Toml.field(&dependency, "package"), "name"),
      ) {
        Option<string>.Some { value } => String.utf8Bytes(value)
        Option<string>.None => run invalidAt(
          owned,
          name,
          b"its silk.toml has no [package] name",
          &manifest,
          ManifestText.keyLine(Bytes.asSlice(&contents), b"package.name"),
        )
      }
      if overridden != usize.MAX && !same(wanted, packageName) {
        let chosen = &List<LocalOverride>.asSlice(&packages.overrides.entries)[overridden]
        let mut reason = run Bytes.copy(b"silk.local.toml overrides `")
        run Bytes.append(&mut reason, wanted)
        run Bytes.append(&mut reason, b"` with ")
        run Bytes.append(&mut reason, Path.rawBytes(&chosen.directory))
        run Bytes.append(&mut reason, b", whose silk.toml names the package `")
        run Bytes.append(&mut reason, packageName)
        run Bytes.append(&mut reason, b"`")
        let file = match &packages.overrides.file {
          Option<Path>.Some { value } => run copyPath(&value)
          Option<Path>.None => run copyPath(&ownerManifest)
        }
        run overrideRefused(&file, Bytes.asSlice(&reason), chosen.line)
      }
      if let Option<Bytes>.Some { value: named } = &expected {
        if !same(Bytes.asSlice(&named), packageName) {
          run invalid(
            owned,
            name,
            b"package does not match the name in the dependency's silk.toml",
            &ownerManifest,
            b"package",
          )
        }
      }
      if run reaches(&packages.*, Bytes.asSlice(&identity), owned) {
        let mut reason = run Bytes.copy(owned)
        run Bytes.append(&mut reason, b" depends on ")
        run Bytes.append(&mut reason, Bytes.asSlice(&identity))
        run Bytes.append(&mut reason, b", which depends on ")
        run Bytes.append(&mut reason, owned)
        run Bytes.append(
          &mut reason,
          b" in turn, directly or through other packages, so they form a cycle",
        )
        run invalid(owned, name, Bytes.asSlice(&reason), &ownerManifest, b"")
      }
      let known = indexOf(List<Package>.asSlice(&packages.packages), packageName)
      if known != usize.MAX {
        let listed = List<Package>.asSlice(&packages.packages)
        let sameVersion = same(Bytes.asSlice(&listed[known].identity), Bytes.asSlice(&identity))
        let sameDirectory = same(Path.rawBytes(&listed[known].manifest), Path.rawBytes(&directory))
        if !sameVersion || !sameDirectory {
          run invalid(
            owned,
            name,
            b"the build already has a different version or copy of this package",
            &ownerManifest,
            b"",
          )
        }
      } else {
        // Checked as the root manifest is, but after its silk-version, so that a dependency
        // written for another Silk is refused for that first.
        let problems = run ManifestSchemas.validate(Bytes.asSlice(&contents), &dependency)
        let found = List<ManifestSchemas.Diagnostic>.asSlice(&problems)
        if found.length > usize.ZERO {
          let mut reason = run Bytes.copy(b"its silk.toml is invalid: ")
          run Bytes.append(&mut reason, Bytes.asSlice(&found[usize.ZERO].message))
          run invalidAt(
            owned,
            name,
            Bytes.asSlice(&reason),
            &manifest,
            ManifestText.lineAt(Bytes.asSlice(&contents), found[usize.ZERO].span.start),
          )
        }
        let sourceRoot = run ManifestFields.sourceRoot(&directory, &dependency)
        let exports = run exportsOf(Bytes.asSlice(&identity), &dependency, &directory, &sourceRoot)
        let archives = match move run Effect.result(
          NativeLinkInputs.archivesOf(
            &dependency,
            &manifest,
            Bytes.asSlice(&contents),
            &packages.archiveContext,
          ),
        ) {
          Result<List<Archive>, InvalidNativeLinkInput | OutOfMemoryError>.Success {
            value
          } => move value
          Result<List<Archive>, InvalidNativeLinkInput | OutOfMemoryError>.Failure {
            error
          } => match move error {
            InvalidNativeLinkInput refused => {
              let mut reason = run Bytes.copy(b"invalid native link input: ")
              run Bytes.append(&mut reason, Bytes.asSlice(&refused.detail))
              run invalidAt(
                owned,
                name,
                Bytes.asSlice(&reason),
                &manifest,
                ManifestText.keyLine(Bytes.asSlice(&contents), b"native.archive"),
              )
            }
            OutOfMemoryError exhausted => {
              fail move exhausted
            }
          }
        }
        run List<Package>.append(
          &mut packages.packages,
          Package {
            identity: run Bytes.copy(Bytes.asSlice(&identity)),
            name: run Bytes.copy(packageName),
            document: Option<SharedDocument<TomlValue>>.some(
              run SharedDocument<TomlValue>.make(move dependency),
            ),
            manifest: move directory,
            sourceRoot: move sourceRoot,
            exports: move exports,
            checkout: move checkout,
            linkInputs: List<NativeLinkInput>.make(),
            archives: move archives,
          },
        )
      }
      run List<Edge>.append(
        &mut packages.edges,
        Edge { owner: run Bytes.copy(owned), name: run Bytes.copy(name), package: move identity },
      )
    }
    at = at + usize.ONE
  }
  return ()
}

// Fails with `reason`, at `line` of the silk.local.toml `file`.
effect fn overrideRefused(file: &Path, reason: &[u8], line: usize) -> never
  ! InvalidDependency | OutOfMemoryError
  ? &mut Allocator {
  fail InvalidDependency {
    detail: run Bytes.copy(reason),
    manifest: run Bytes.copy(Path.rawBytes(file)),
    line: line,
  }
}

// The contents of the file at `path`, or `None` when it cannot be read, as when there is none.
effect fn readOptional(path: &Path) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  return match move run Effect.result(FileSystem.readFile(path)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => Option<Bytes>.some(move value)
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError missing => {
        drop missing
        Option<Bytes>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// The overrides the silk.local.toml of a build whose root package sits in `directory` writes: the
// file in `directory`, or else the one beside the root manifest of the package's workspace. Each
// place looked in is added to `files`, so that creating the file later changes the build.
effect fn readOverrides(directory: &Path, files: &mut List<Bytes>) -> Overrides
  ! InvalidDependency | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut file = run Path.join(directory, "silk.local.toml")
  run List<Bytes>.append(&mut files.*, run Bytes.copy(Path.rawBytes(&file)))
  let mut read = run readOptional(&file)
  if read.isNone() {
    if let Option<Shared>.Some { value: workspace } = move run Workspaces.of(
      directory,
      &Option<Path>.none(),
    ) {
      let root = Workspaces.directory(&workspace)
      if !same(Path.rawBytes(root), Path.rawBytes(directory)) {
        file = run Path.join(root, "silk.local.toml")
        run List<Bytes>.append(&mut files.*, run Bytes.copy(Path.rawBytes(&file)))
        read = run readOptional(&file)
      }
    }
  }
  let mut entries = List<LocalOverride>.make()
  let contents = match move read {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return Overrides { file: Option<Path>.none(), entries: move entries }
    }
  }
  let text = Bytes.asSlice(&contents)
  let document = match move run Effect.result(Toml.parse(text)) {
    Result<TomlValue, TomlError | OutOfMemoryError>.Success { value } => move value
    Result<TomlValue, TomlError | OutOfMemoryError>.Failure { error } => match move error {
      TomlError malformed => {
        let mut reason = run Bytes.copy(b"silk.local.toml is not valid TOML: ")
        run ManifestText.appendTomlReason(&mut reason, text, &malformed)
        run overrideRefused(
          &file,
          Bytes.asSlice(&reason),
          ManifestText.lineAt(text, malformed.offset),
        )
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let base = match move run Path.parent(&file) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Path.root()
  }
  let top = match move members(&document) {
    Option<&[TomlChild]>.Some { value } => value
    Option<&[TomlChild]>.None => {
      return Overrides { file: Option<Path>.some(move file), entries: move entries }
    }
  }
  let mut at = usize.ZERO
  while at < top.length {
    if let TomlChild.Member { entry } = &top[at] {
      let key = String.ownedUtf8Bytes(&entry.key)
      if !same(key, b"overrides") {
        let mut reason = run Bytes.copy(b"silk.local.toml holds only an [overrides] table, not `")
        run Bytes.append(&mut reason, key)
        run Bytes.append(&mut reason, b"`")
        run overrideRefused(&file, Bytes.asSlice(&reason), ManifestText.keyLine(text, key))
      }
      let listed = match move members(&entry.value) {
        Option<&[TomlChild]>.Some { value } => value
        Option<&[TomlChild]>.None => run overrideRefused(
          &file,
          b"[overrides] must be a table of packages such as lib-css = { path = \"../lib-css\" }",
          ManifestText.keyLine(text, b"overrides"),
        )
      }
      let mut item = usize.ZERO
      while item < listed.length {
        if let TomlChild.Member { entry: written } = &listed[item] {
          let name = String.ownedUtf8Bytes(&written.key)
          let mut dotted = run Bytes.copy(b"overrides.")
          run Bytes.append(&mut dotted, name)
          let line = ManifestText.keyLine(text, Bytes.asSlice(&dotted))
          let mut fields = usize.ZERO
          if let Option<&[TomlChild]>.Some { value: inner } = move members(&written.value) {
            let mut field = usize.ZERO
            while field < inner.length {
              if let TomlChild.Member { .. } = &inner[field] {
                fields = fields + usize.ONE
              }
              field = field + usize.ONE
            }
          }
          let path = match move Toml.asString(Toml.field(&written.value, "path")) {
            Option<string>.Some { value } => String.utf8Bytes(value)
            Option<string>.None => {
              fields = usize.ZERO
              b""
            }
          }
          if fields != usize.ONE || path.length == usize.ZERO {
            let mut reason = run Bytes.copy(b"the override of `")
            run Bytes.append(&mut reason, name)
            run Bytes.append(
              &mut reason,
              b"` must be { path = \"../checkout\" }, the directory of the local checkout's silk.toml",
            )
            run overrideRefused(&file, Bytes.asSlice(&reason), line)
          }
          let checkout = run real(run CommandPath.resolve(&base, path))
          let manifest = run Path.join(&checkout, "silk.toml")
          let found = run FileSystem.exists(&manifest)
          if !found {
            let mut reason = run Bytes.copy(b"the override of `")
            run Bytes.append(&mut reason, name)
            run Bytes.append(&mut reason, b"` names ")
            run Bytes.append(&mut reason, Path.rawBytes(&checkout))
            run Bytes.append(&mut reason, b", which has no silk.toml")
            run overrideRefused(&file, Bytes.asSlice(&reason), line)
          }
          run List<LocalOverride>.append(
            &mut entries,
            LocalOverride {
              name: run Bytes.copy(name),
              written: run Bytes.copy(path),
              directory: move checkout,
              line: line,
            },
          )
        }
        item = item + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return Overrides { file: Option<Path>.some(move file), entries: move entries }
}

// The position in `entries` of the override of package `name`, or `usize.MAX` when none overrides
// it.
fn overrideAt(entries: &[LocalOverride], name: &[u8]) -> usize {
  let mut at = usize.ZERO
  while at < entries.length {
    if same(Bytes.asSlice(&entries[at].name), name) {
      return at
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

/// One line per override that the `silk.local.toml` of a build rooted at the package in
/// `directory` writes, such as `/work/app/silk.local.toml overrides lib-css with ../lib-css`:
/// the file beside the package's manifest, or else beside its workspace's root manifest. Empty
/// when there is no such file, and when it is invalid, which loading the package reports.
pub effect fn overrideNotes(directory: &Path) -> List<Bytes>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut notes = List<Bytes>.make()
  let mut files = List<Bytes>.make()
  let read = run Effect.result(readOverrides(directory, &mut files))
  let overrides = match move read {
    Result<Overrides, InvalidDependency | FileError | OutOfMemoryError>.Success { value } => move value
    Result<Overrides, InvalidDependency | FileError | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      InvalidDependency refused => {
        drop refused
        return move notes
      }
      FileError unread => {
        drop unread
        return move notes
      }
    }
  }
  let file = match &overrides.file {
    Option<Path>.Some { value } => Path.rawBytes(&value)
    Option<Path>.None => {
      return move notes
    }
  }
  let entries = List<LocalOverride>.asSlice(&overrides.entries)
  let mut at = usize.ZERO
  while at < entries.length {
    let mut note = run Bytes.copy(file)
    run Bytes.append(&mut note, b" overrides ")
    run Bytes.append(&mut note, Bytes.asSlice(&entries[at].name))
    run Bytes.append(&mut note, b" with ")
    run Bytes.append(&mut note, Bytes.asSlice(&entries[at].written))
    run List<Bytes>.append(&mut notes, move note)
    at = at + usize.ONE
  }
  return move notes
}

// The package name dependency `name`, written as `entry`, asks for: the `package` its entry, or
// the workspace entry it takes, writes, or else `name` itself. An override matches by it.
fn requested<'a>(shared: &'a Option<Shared>, name: &'a [u8], entry: &'a TomlValue) -> &'a [u8] {
  if let Option<&TomlValue>.Some { value: source } = move Workspaces.source(shared, name, entry) {
    if let Option<string>.Some { value } = move Toml.asString(Toml.field(source, "package")) {
      return String.utf8Bytes(value)
    }
  }
  return name
}

/// Retains the root package and its declared pins without loading any dependencies.
/// `require` resolves aliases as module imports reach them; `requireAll` resolves a metadata graph.
pub effect fn load(
  manifest: &Path,
  document: TomlValue,
  identity: &[u8],
  sourceRoot: &Path,
  store: Option<&Path>,
  archiveContext: ArchiveContext,
  versions: Versions,
) -> Packages
  ! InvalidDependency | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let name = match move Toml.asString(Toml.fieldAt(Toml.field(&document, "package"), "name")) {
    Option<string>.Some { value } => String.utf8Bytes(value)
    Option<string>.None => b""
  }
  let mut kept = Option<Path>.none()
  if let Option<&Path>.Some { value } = move store {
    kept = Option<Path>.some(run copyPath(value))
  }
  let mut packages = Packages {
    packages: List<Package>.make(),
    edges: List<Edge>.make(),
    store: move kept,
    archiveContext: move archiveContext,
    graphFiles: List<Bytes>.make(),
    overrides: Overrides { file: Option<Path>.none(), entries: List<LocalOverride>.make() },
    rootPin: Option<Bytes>.none(),
    versions: versions,
    versionNotes: List<Bytes>.make(),
  }
  packages.overrides = run readOverrides(manifest, &mut packages.graphFiles)

  // The root is held to its own `silk-version` as every dependency is, whichever Silk runs it;
  // every other package's pin must then fit the root's.
  if versions != Versions.Unchecked {
    let pin = run pinOf(identity, &document, manifest, &Option<Path>.none())
    run checkPin(&mut packages, identity, &pin)
    packages.rootPin = move pin.version
  }

  // The root's own exports are part of its public surface, so the build checks them even when its
  // root module imports none of them.
  let exports = run exportsOf(identity, &document, manifest, sourceRoot)
  run List<Package>.append(
    &mut packages.packages,
    Package {
      identity: run Bytes.copy(identity),
      name: run Bytes.copy(name),
      manifest: run copyPath(manifest),
      sourceRoot: run copyPath(sourceRoot),
      exports: move exports,
      document: Option<SharedDocument<TomlValue>>.some(
        run SharedDocument<TomlValue>.make(move document),
      ),
      checkout: Option<Path>.none(),
      linkInputs: List<NativeLinkInput>.make(),
      archives: List<Archive>.make(),
    },
  )
  return move packages
}

/// The package graph of these packages, whose standard-library paths belong to `owner`'s package,
/// the standard library's own.
pub effect fn graph(self: &Packages, owner: &ModuleId) -> PackageGraph
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut graph = PackageGraph.make(owner)
  let edges = List<Edge>.asSlice(&self.edges)
  let mut at = usize.ZERO
  while at < edges.length {
    run PackageGraph.depend(
      &mut graph,
      Bytes.asSlice(&edges[at].owner),
      Bytes.asSlice(&edges[at].name),
      Bytes.asSlice(&edges[at].package),
    )
    at = at + usize.ONE
  }
  let packages = List<Package>.asSlice(&self.packages)
  let mut packageAt = usize.ZERO
  while packageAt < packages.length {
    let exports = List<Bytes>.asSlice(&packages[packageAt].exports)
    let mut exportAt = usize.ZERO
    while exportAt < exports.length {
      run PackageGraph.publish(
        &mut graph,
        Bytes.asSlice(&packages[packageAt].identity),
        Bytes.asSlice(&exports[exportAt]),
      )
      exportAt = exportAt + usize.ONE
    }
    packageAt = packageAt + usize.ONE
  }
  return move graph
}

/// The canonical paths, such as `codec/Json.silk`, of the modules the root package exports.
pub fn rootExports(self: &Packages) -> &[Bytes] {
  return List<Bytes>.asSlice(&List<Package>.asSlice(&self.packages)[usize.ZERO].exports)
}

/// The module of a dependency whose source root holds the file at `path`, or `None` when no
/// dependency's does or `path` is not a module path below it.
pub effect fn dependencyModule(self: &Packages, path: &[u8]) -> Option<ModuleId>
  ! OutOfMemoryError
  ? &mut Allocator {
  let listed = List<Package>.asSlice(&self.packages)
  let mut at = usize.ONE
  while at < listed.length {
    let root = Path.rawBytes(&listed[at].sourceRoot)
    if path.length > root.length + usize.ONE && path[root.length] == 47
      && same(Slice.view<u8>(path, usize.ZERO, root.length), root) {
      let logical = Slice.view<u8>(
        path,
        root.length + usize.ONE,
        path.length - root.length - usize.ONE,
      )
      let identified = run Effect.result(
        ModuleId.make(b"file", Bytes.asSlice(&listed[at].identity), logical),
      )
      return match move identified {
        Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success { value } => Option<
          ModuleId
        >.some(move value)
        Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure {
          error
        } => match move error {
          InvalidModulePath _invalid => Option<ModuleId>.none()
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return Option<ModuleId>.none()
}

/// The source root of the dependency whose identity is `package`, or `None` for the root package
/// and for an identity no dependency has.
pub fn dependencyRoot(self: &Packages, package: &[u8]) -> Option<&Path> {
  let listed = List<Package>.asSlice(&self.packages)
  let mut at = usize.ONE
  while at < listed.length {
    if same(Bytes.asSlice(&listed[at].identity), package) {
      return Option<&Path>.some(&listed[at].sourceRoot)
    }
    at = at + usize.ONE
  }
  return Option<&Path>.none()
}

/// Whether the dependency whose identity is `package` is read by a `path` from the author's own
/// tree, not from a git checkout or a fetched archive. False for the root package and for an
/// identity no dependency has.
pub fn localDependency(self: &Packages, package: &[u8]) -> bool {
  let listed = List<Package>.asSlice(&self.packages)
  let mut at = usize.ONE
  while at < listed.length {
    if same(Bytes.asSlice(&listed[at].identity), package) {
      return match &listed[at].checkout {
        Option<Path>.Some {..} => false
        Option<Path>.None => true
      }
    }
    at = at + usize.ONE
  }
  return false
}

/// The positions of the packages, the root first, with every package before each package it
/// depends on: the order a static link lists their native inputs in, so an archive follows each
/// archive or object that uses it. Packages no dependency path orders keep their load order.
pub effect fn linkOrder(self: &Packages) -> List<usize>
  ! OutOfMemoryError
  ? &mut Allocator {
  // Depth first from the root in declaration order; each package is listed after all it reaches,
  // and the reversed list puts dependents first.
  let listed = List<Package>.asSlice(&self.packages)
  let mut done = List<bool>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    run List<bool>.append(&mut done, false)
    at = at + usize.ONE
  }
  let mut finished = List<usize>.make()
  run finish(&self.*, usize.ZERO, &mut done, &mut finished)
  let mut order = List<usize>.make()
  let reached = List<usize>.asSlice(&finished)
  let mut back = reached.length
  while back > usize.ZERO {
    back = back - usize.ONE
    run List<usize>.append(&mut order, reached[back])
  }
  return move order
}

// Lists every package `package` reaches that `done` does not mark yet, then `package` itself.
effect fn finish(
  self: &Packages,
  package: usize,
  done: &mut List<bool>,
  finished: &mut List<usize>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let marks = List<bool>.asMutSlice(&mut done.*)
  marks[package] = true
  let listed = List<Package>.asSlice(&self.packages)
  let owner = Bytes.asSlice(&listed[package].identity)
  let edges = List<Edge>.asSlice(&self.edges)
  let mut at = usize.ZERO
  while at < edges.length {
    if same(Bytes.asSlice(&edges[at].owner), owner) {
      let mut target = usize.ZERO
      while target < listed.length {
        if same(Bytes.asSlice(&listed[target].identity), Bytes.asSlice(&edges[at].package)) {
          break
        }
        target = target + usize.ONE
      }
      if target < listed.length && !List<bool>.asSlice(&done.*)[target] {
        run finish(&self.*, target, &mut done.*, &mut finished.*)
      }
    }
    at = at + usize.ONE
  }
  run List<usize>.append(&mut finished.*, package)
  return ()
}

/// The archives package `package` declares, selected for the build's target.
pub fn archives(self: &Packages, package: usize) -> &[Archive] {
  return List<Archive>.asSlice(&List<Package>.asSlice(&self.packages)[package].archives)
}

/// The name of package `package`, as `name@version`.
pub fn packageIdentity(self: &Packages, package: usize) -> &[u8] {
  return Bytes.asSlice(&List<Package>.asSlice(&self.packages)[package].identity)
}

/// The directory package `package`'s module paths resolve below.
pub fn sourceRootAt(self: &Packages, package: usize) -> &Path {
  return &List<Package>.asSlice(&self.packages)[package].sourceRoot
}

/// The manifest directory of package `package`.
pub fn directoryAt(self: &Packages, package: usize) -> &Path {
  return &List<Package>.asSlice(&self.packages)[package].manifest
}

/// The files besides the packages' own manifests whose contents decide what the build loads, each
/// once: the root manifest of each workspace whose `[workspace.dependencies]` some package took an
/// entry from, and each place a `silk.local.toml` was looked for, present or not, so that creating
/// one changes the build too.
pub fn graphFiles(self: &Packages) -> &[Bytes] {
  return List<Bytes>.asSlice(&self.graphFiles)
}

/// The number of packages, the root included.
/// One line per package this build reads although its `silk-version` does not fit this Silk,
/// built because of `--ignore-silk-version`: the package and why it would be refused.
pub fn versionNotes(self: &Packages) -> &[Bytes] {
  return self.versionNotes.asSlice()
}

pub fn count(self: &Packages) -> usize {
  return List<Package>.length(&self.packages)
}

pub fn linkInputs(self: &Packages, package: usize) -> &[NativeLinkInput] {
  return List<NativeLinkInput>.asSlice(&List<Package>.asSlice(&self.packages)[package].linkInputs)
}

/// The directory holding the manifest of the package whose identity is `package`, the root's
/// included, or `None` for an identity no package of the build has.
pub fn manifestDirectory(self: &Packages, package: &[u8]) -> Option<&Path> {
  let listed = List<Package>.asSlice(&self.packages)
  let mut at = usize.ZERO
  while at < listed.length {
    if same(Bytes.asSlice(&listed[at].identity), package) {
      return Option<&Path>.some(&listed[at].manifest)
    }
    at = at + usize.ONE
  }
  return Option<&Path>.none()
}

/// Loads the explicit package graph of a compilation request without reading a manifest or fetching a package.
pub effect fn fromRequest(request: &CompilationRequest) -> Packages
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut packages = Packages {
    packages: List<Package>.make(),
    edges: List<Edge>.make(),
    store: Option<Path>.none(),
    archiveContext: ArchiveContext {
      target: run Bytes.copy(String.ownedUtf8Bytes(&request.profile.target)),
      store: Option<Path>.none(),
      overrides: List<NativeLinkInputs.Override>.make(),
    },
    graphFiles: List<Bytes>.make(),
    overrides: Overrides { file: Option<Path>.none(), entries: List<LocalOverride>.make() },
    rootPin: Option<Bytes>.none(),
    versions: Versions.Unchecked,
    versionNotes: List<Bytes>.make(),
  }
  let listed = List<RequestPackage>.asSlice(&request.packages)
  let mut at = usize.ZERO
  while at < listed.length {
    let package = &listed[at]
    let mut identity = run Bytes.copy(String.ownedUtf8Bytes(&package.name))
    run Bytes.append(&mut identity, b"@")
    run Bytes.append(&mut identity, String.ownedUtf8Bytes(&package.version))
    let edges = List<RequestDependency>.asSlice(&package.dependencies)
    let mut edge = usize.ZERO
    while edge < edges.length {
      run List<Edge>.append(
        &mut packages.edges,
        Edge {
          owner: run Bytes.copy(Bytes.asSlice(&identity)),
          name: run Bytes.copy(String.ownedUtf8Bytes(&edges[edge].name)),
          package: run Bytes.copy(String.ownedUtf8Bytes(&edges[edge].package)),
        },
      )
      edge = edge + usize.ONE
    }
    let mut exports = List<Bytes>.make()
    let names = List<String>.asSlice(&package.exports)
    let mut exported = usize.ZERO
    while exported < names.length {
      run List<Bytes>.append(&mut exports, run Bytes.copy(String.ownedUtf8Bytes(&names[exported])))
      exported = exported + usize.ONE
    }
    run List<Package>.append(
      &mut packages.packages,
      Package {
        identity: move identity,
        document: Option<SharedDocument<TomlValue>>.none(),
        name: run Bytes.copy(String.ownedUtf8Bytes(&package.name)),
        manifest: run Path.make(package.directory.view()),
        sourceRoot: run Path.make(package.source.view()),
        exports: move exports,
        checkout: Option<Path>.none(),
        linkInputs: List<NativeLinkInput>.make(),
        archives: List<Archive>.make(),
      },
    )
    at = at + usize.ONE
  }
  return move packages
}

/// Copies the resolved package graph into the compilation wire model.
pub effect fn requestPackages(self: &Packages) -> List<RequestPackage>
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut result = List<RequestPackage>.make()
  let packages = List<Package>.asSlice(&self.packages)
  let edges = List<Edge>.asSlice(&self.edges)
  let mut at = usize.ZERO
  while at < packages.length {
    let package = &packages[at]
    let identity = Bytes.asSlice(&package.identity)
    let name = Bytes.asSlice(&package.name)
    let mut dependencies = List<RequestDependency>.make()
    let mut edge = usize.ZERO
    while edge < edges.length {
      if same(Bytes.asSlice(&edges[edge].owner), identity) {
        run dependencies.append(
          RequestDependency {
            name: run RequestText.copy(Bytes.asSlice(&edges[edge].name)),
            package: run RequestText.copy(Bytes.asSlice(&edges[edge].package)),
          },
        )
      }
      edge = edge + usize.ONE
    }
    let mut exports = List<String>.make()
    let names = List<Bytes>.asSlice(&package.exports)
    let mut exported = usize.ZERO
    while exported < names.length {
      run exports.append(run RequestText.copy(Bytes.asSlice(&names[exported])))
      exported = exported + usize.ONE
    }
    run result.append(
      RequestPackage {
        name: run RequestText.copy(name),
        version: run RequestText.copy(
          Slice.view<u8>(
            identity,
            name.length + usize.ONE,
            identity.length - name.length - usize.ONE,
          ),
        ),
        directory: run RequestText.copy(Path.rawBytes(&package.manifest)),
        source: run RequestText.copy(Path.rawBytes(&package.sourceRoot)),
        dependencies: move dependencies,
        exports: move exports,
        parameters: List<RequestParameter>.make(),
        modules: List<RequestModule>.make(),
        optimization: Option<String>.none(),
        debug: Option<bool>.none(),
      },
    )
    at = at + usize.ONE
  }
  return move result
}

/// Records the root pins already resolved by the manifest loader, for its package plan.
pub effect fn setRootArchives(self: &mut Packages, archives: &[Archive]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let root = &mut self.packages.asMutSlice()[0]
  let mut at: usize = 0
  while at < archives.length {
    run root.archives.append(run NativeLinkInputs.copyArchive(&archives[at]))
    at = at + 1
  }
}

// Whether an existing dependency path would close a cycle at `target`.
effect fn reaches(self: &Packages, source: &[u8], target: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut pending = List<Bytes>.make()
  run pending.append(run Bytes.copy(source))
  let edges = self.edges.asSlice()
  let mut at: usize = 0
  while at < pending.length() {
    let owned = run Bytes.copy(pending.asSlice()[at].asSlice())
    let owner = owned.asSlice()
    if same(owner, target) {
      return true
    }
    let mut edge: usize = 0
    while edge < edges.length {
      if same(edges[edge].owner.asSlice(), owner)
        && !onStack(pending.asSlice(), edges[edge].package.asSlice()) {
        run pending.append(run Bytes.copy(edges[edge].package.asSlice()))
      }
      edge = edge + 1
    }
    at = at + 1
  }
  return false
}

fn ownerIndex(self: &Packages, owner: &[u8]) -> usize {
  let packages = self.packages.asSlice()
  let mut at: usize = 0
  while at < packages.length {
    if same(packages[at].identity.asSlice(), owner) {
      return at
    }
    at = at + 1
  }
  return usize.MAX
}

/// Whether `owner` declares an import alias that has not yet been resolved.
pub fn pending(self: &Packages, owner: &[u8], name: &[u8]) -> bool {
  let edges = self.edges.asSlice()
  let mut at: usize = 0
  while at < edges.length {
    if same(edges[at].owner.asSlice(), owner) && same(edges[at].name.asSlice(), name) {
      return false
    }
    at = at + 1
  }
  let index = ownerIndex(self, owner)
  if index == usize.MAX {
    return false
  }
  if let Option<SharedDocument<TomlValue>>.Some {
    value
  } = &self.packages.asSlice()[index].document {
    if let Option<&TomlValue>.Some { value: dependencies } = move Toml.field(
      SharedDocument<TomlValue>.get(&value),
      "dependencies",
    ) {
      if let Option<&[TomlChild]>.Some { value: children } = move members(dependencies) {
        let mut child: usize = 0
        while child < children.length {
          if let TomlChild.Member { entry } = &children[child] {
            if same(String.ownedUtf8Bytes(&entry.key), name) {
              return true
            }
          }
          child = child + 1
        }
      }
    }
  }
  return false
}

/// Resolves one imported alias, fetching only its own pin. It evaluates no package code.
pub effect fn require(self: &mut Packages, owner: &[u8], name: &[u8]) -> bool
  ! InvalidDependency | HostInputError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  if !pending(&self.*, owner, name) {
    return false
  }
  let index = ownerIndex(&self.*, owner)
  let package = &self.packages.asSlice()[index]
  let document = match &package.document {
    Option<SharedDocument<TomlValue>>.Some { value } => SharedDocument<TomlValue>.clone(&value)
    Option<SharedDocument<TomlValue>>.None => {
      return false
    }
  }
  if let Option<Path>.Some { value: store } = &self.store {
    let mut seen = List<Bytes>.make()
    run fetchVisit(
      &package.manifest,
      SharedDocument<TomlValue>.get(&document),
      &store,
      &package.checkout,
      &mut seen,
      Option<&[u8]>.some(name),
      List<LocalOverride>.asSlice(&self.overrides.entries),
    )
  }
  run visit(&mut self.*, index, SharedDocument<TomlValue>.get(&document), name)
  return true
}

/// Resolves every declared pin for metadata operations such as dependency editing.
/// Compilation uses `require` only for aliases reached by its module imports.
pub effect fn requireAll(self: &mut Packages) -> ()
  ! InvalidDependency | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut at: usize = 0
  while at < self.packages.length() {
    let package = &self.packages.asSlice()[at]
    let owner = run Bytes.copy(package.identity.asSlice())
    let mut names = List<Bytes>.make()
    if let Option<SharedDocument<TomlValue>>.Some { value } = &package.document {
      if let Option<&TomlValue>.Some { value: dependencies } = move Toml.field(
        SharedDocument<TomlValue>.get(&value),
        "dependencies",
      ) {
        if let Option<&[TomlChild]>.Some { value: children } = move members(dependencies) {
          let mut child: usize = 0
          while child < children.length {
            if let TomlChild.Member { entry } = &children[child] {
              run names.append(run Bytes.copy(String.ownedUtf8Bytes(&entry.key)))
            }
            child = child + 1
          }
        }
      }
    }
    let listed = names.asSlice()
    let mut name: usize = 0
    while name < listed.length {
      if pending(&self.*, owner.asSlice(), listed[name].asSlice()) {
        let document = match &self.packages.asSlice()[at].document {
          Option<SharedDocument<TomlValue>>.Some { value } => SharedDocument<TomlValue>.clone(
            &value,
          )
          Option<SharedDocument<TomlValue>>.None => {
            break
          }
        }
        run visit(&mut self.*, at, SharedDocument<TomlValue>.get(&document), listed[name].asSlice())
      }
      name = name + 1
    }
    at = at + 1
  }
}

/// Whether the package `owner` declares `name` in its `[dependencies]`.
pub fn declares(self: &Packages, owner: &[u8], name: &[u8]) -> bool {
  let edges = self.edges.asSlice()
  let mut at: usize = 0
  while at < edges.length {
    if same(edges[at].owner.asSlice(), owner) && same(edges[at].name.asSlice(), name) {
      return true
    }
    at = at + 1
  }
  return pending(self, owner, name)
}

/// Installs the evaluated native inputs of one reached package.
pub fn setNative(self: &mut Packages, owner: usize, inputs: List<NativeLinkInput>) -> () {
  let package = &mut self.packages.asMutSlice()[owner]
  package.linkInputs = move inputs
}

/// A source-file compilation's single package, with no manifest, dependencies, or native pins.
pub effect fn standalone(directory: &Path, target: &[u8]) -> Packages
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut packages = List<Package>.make()
  run packages.append(
    Package {
      identity: run Bytes.copy(b"source@0.0.0"),
      name: run Bytes.copy(b"source"),
      document: Option<SharedDocument<TomlValue>>.none(),
      manifest: run copyPath(directory),
      sourceRoot: run copyPath(directory),
      exports: List<Bytes>.make(),
      checkout: Option<Path>.none(),
      linkInputs: List<NativeLinkInput>.make(),
      archives: List<Archive>.make(),
    },
  )
  return Packages {
    packages: move packages,
    edges: List<Edge>.make(),
    store: Option<Path>.none(),
    archiveContext: ArchiveContext {
      target: run Bytes.copy(target),
      store: Option<Path>.none(),
      overrides: List<NativeLinkInputs.Override>.make(),
    },
    graphFiles: List<Bytes>.make(),
    overrides: Overrides { file: Option<Path>.none(), entries: List<LocalOverride>.make() },
    rootPin: Option<Bytes>.none(),
    versions: Versions.Unchecked,
    versionNotes: List<Bytes>.make(),
  }
}

/// Resolves one root dependency's explicitly included file or directory. The declaration is checked
/// before its canonical path is exposed, and links cannot grant access outside the package.
pub effect fn includedPath(self: &mut Packages, name: &[u8], relative: &[u8]) -> Path
  ! InvalidDependency | HostInputError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let root = &self.packages.asSlice()[0]
  let owner = run Bytes.copy(root.identity.asSlice())
  let directory = run copyPath(&root.manifest)
  if !contained(relative) {
    run invalid(
      owner.asSlice(),
      name,
      b"a package path must stay below the declared dependency",
      &directory,
      b"path",
    )
  }
  let _loaded = run require(&mut self.*, owner.asSlice(), name)
  let edges = self.edges.asSlice()
  let mut package: usize = usize.MAX
  let mut edge: usize = 0
  while edge < edges.length {
    if same(edges[edge].owner.asSlice(), owner.asSlice())
      && same(edges[edge].name.asSlice(), name) {
      package = ownerIndex(&self.*, edges[edge].package.asSlice())
      break
    }
    edge = edge + 1
  }
  if package == usize.MAX {
    run invalid(
      owner.asSlice(),
      name,
      b"the root does not declare this dependency alias",
      &directory,
      b"",
    )
  }
  let selected = &self.packages.asSlice()[package]
  let rootPath = run real(run copyPath(&selected.manifest))
  let requested = run real(run Path.joinBytes(&rootPath, relative))
  if !within(Path.rawBytes(&rootPath), Path.rawBytes(&requested)) {
    run invalid(
      owner.asSlice(),
      name,
      b"the requested path leaves the dependency through a symbolic link",
      &directory,
      b"path",
    )
  }
  let document = match &selected.document {
    Option<SharedDocument<TomlValue>>.Some { value } => SharedDocument<TomlValue>.get(&value)
    Option<SharedDocument<TomlValue>>.None => {
      run invalid(owner.asSlice(), name, b"the dependency has no manifest", &directory, b"")
    }
  }
  if let Option<&TomlValue>.Some { value: include } = move Toml.fieldAt(
    Toml.field(document, "package"),
    "include",
  ) {
    let mut at: usize = 0
    while let Option<&TomlValue>.Some { value } = move Toml.item(include, at) {
      if let Option<string>.Some { value: text } = move Toml.asString(
        Option<&TomlValue>.some(value),
      ) {
        let entry = String.utf8Bytes(text)
        if contained(entry) && (same(relative, entry) || within(entry, relative)) {
          let included = run real(run Path.joinBytes(&rootPath, entry))
          if within(Path.rawBytes(&rootPath), Path.rawBytes(&included))
            && (same(Path.rawBytes(&included), Path.rawBytes(&requested))
              || within(Path.rawBytes(&included), Path.rawBytes(&requested))) {
            if run FileSystem.exists(&requested) {
              return move requested
            }
          }
        }
      }
      at = at + 1
    }
  }
  run invalid(
    owner.asSlice(),
    name,
    b"the requested path is not an existing file or directory listed in package.include",
    &directory,
    b"path",
  )
}
