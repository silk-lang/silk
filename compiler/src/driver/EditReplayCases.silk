//! Replay scripts list edits in order, and an edit replaces text that occurs exactly once.

import driver.EditReplay as EditReplays { Edit, InvalidReplayScript, Kind }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.option { Option }
import silk.core.result { Result }
import silk.testing.testing { AssertionError, Testing }
import silk.toml.scanner { TomlError }
import silk.toml.value { Toml }
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn script(text: &[u8]) -> List<Edit>
  ! InvalidReplayScript | TomlError | OutOfMemoryError
  ? &mut Allocator {
  let document = run Toml.parse(text)
  return run EditReplays.read(&document)
}

effect fn refused(text: &[u8]) -> bool
  ! TomlError | OutOfMemoryError
  ? &mut Allocator {
  return match move run Effect.result(script(text)) {
    Result<List<Edit>, InvalidReplayScript | TomlError | OutOfMemoryError>.Success { value: _ } => false
    Result<List<Edit>, InvalidReplayScript | TomlError | OutOfMemoryError>.Failure { error } => match move error {
      InvalidReplayScript invalid => {
        drop invalid
        return true
      }
      TomlError malformed => {
        fail move malformed
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn applied(content: &[u8], find: &[u8], replace: &[u8]) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let edit = Edit {
    kind: Kind.Body, module: run Bytes.copy(b"m.silk"), find: run Bytes.copy(find),
    replace: run Bytes.copy(replace), to: Bytes.make(),
  }
  return run EditReplays.apply(content, &edit)
}

effect fn scriptPolicy() -> ()
  ! AssertionError<'static> | InvalidReplayScript | TomlError | OutOfMemoryError
  ? &mut Allocator {
  let edits = run script(
    b"[[edit]]\nkind = \"body\"\nmodule = \"a.silk\"\nfind = \"1\"\nreplace = \"2\"\n\n[[edit]]\nkind = \"rename\"\nmodule = \"a.silk\"\nto = \"b.silk\"\n"
  )
  let listed = List<Edit>.asSlice(&edits)
  run Testing.expect(
    listed.length == usize.add(0, 2) && listed[0].kind == Kind.Body && same(Bytes.asSlice(&listed[0].replace), b"2")
      && listed[1].kind == Kind.Rename && same(Bytes.asSlice(&listed[1].to), b"b.silk"),
    "a script lists its edits in order, a rename with its new path"
  )
  let unknown = run refused(b"[[edit]]\nkind = \"move\"\nmodule = \"a.silk\"\nfind = \"1\"\nreplace = \"2\"\n")
  let empty = run refused(b"[[edit]]\nkind = \"body\"\nmodule = \"a.silk\"\nfind = \"\"\nreplace = \"2\"\n")
  let renameText = run refused(b"[[edit]]\nkind = \"rename\"\nmodule = \"a.silk\"\nto = \"b.silk\"\nfind = \"1\"\n")
  let none = run refused(b"title = \"no edits\"\n")
  run Testing.expect(
    unknown && empty && renameText && none,
    "an unknown kind, an empty find, a rename with replacement text and a script without edits are refused"
  )
}

effect fn applyPolicy() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let replaced = match move run applied(b"fn f() -> i32 { return 1 }\n", b"return 1", b"return 2") {
    Option<Bytes>.Some { value } => same(Bytes.asSlice(&value), b"fn f() -> i32 { return 2 }\n")
    Option<Bytes>.None => false
  }
  let missing = match move run applied(b"fn f() {}\n", b"return", b"x") {
    Option<Bytes>.Some { value: _ } => false
    Option<Bytes>.None => true
  }
  let repeated = match move run applied(b"a a\n", b"a", b"b") {
    Option<Bytes>.Some { value: _ } => false
    Option<Bytes>.None => true
  }
  run Testing.expect(
    replaced && missing && repeated,
    "an edit replaces text that occurs exactly once, and is refused when it is absent or repeated"
  )
}

test effect fn replayScriptsListTheirEditsInOrder() -> ()
  ! AssertionError<'static> | InvalidReplayScript | TomlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run scriptPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn replayEditsReplaceTextThatOccursOnce() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run applyPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}
