//! Slim package metadata and built-in target options select default artifacts.

import driver.ManifestFields
import driver.Project as Projects { Form, Project, ProjectError, SourceSelection }
import driver.ProjectCommand as ProjectCommands { Build, InvalidProjectCommand }
import driver.ProjectPlan as ProjectPlans { PlanError, ProjectPlan }
import semantic.InitialProfile { InitialProfile, Problem as InitialProfileProblem }
import semantic.Target { Id as TargetId, Target }
import silk.core.option { Option }
import silk.toml.scanner { TomlError }
import silk.collections.list { List }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.filesystem_native { OsFileSystem }
import silk.core.result { Result }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize

const nativeArm: bool = Intrinsic.targetArchitecture() == "aarch64"

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Whether `text` is refused as an invalid manifest.
effect fn refused(manifest: &Path, text: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let decoded = run Effect.result(Projects.decode(manifest, text))
  return match move decoded {
    Result<Project, ProjectError | OutOfMemoryError>.Success { .. } => false
    Result<Project, ProjectError | OutOfMemoryError>.Failure { error } => match move error {
      ProjectError problem => match move problem {
        ProjectError.InvalidManifest { .. } => true
        _ => false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn manifestPolicy() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError
  ? &mut Allocator {
  let manifest = run Path.make("/work/hello/silk.toml")
  let minimal = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\n",
  )
  run Testing.expect(
    same(Projects.name(&minimal), b"hello")
      && same(Path.rawBytes(Projects.entry(&minimal)), b"/work/hello/src/main.silk")
      && same(Path.rawBytes(Projects.directory(&minimal)), b"/work/hello"),
    "the package name and the root entry resolve against the manifest's directory",
  )
  run Testing.expect(
    same(Path.rawBytes(Projects.outputDirectory(&minimal)), b"/work/hello/build")
      && Projects.runnable(&minimal),
    "the output directory defaults to build and the artifact to a final executable",
  )
  let executable = run Projects.artifact(
    &minimal,
    b"aarch64-unknown-linux-gnu",
    Projects.mode(b"none"),
  )
  run Testing.expect(
    same(Path.rawBytes(&executable), b"/work/hello/build/aarch64-unknown-linux-gnu/dev/hello"),
    "the executable sits at <output-dir>/<target>/<mode>/<name>",
  )
  let runner = run Projects.testExecutable(&minimal, b"x86_64-unknown-linux-gnu", b"release")
  run Testing.expect(
    same(Path.rawBytes(&runner), b"/work/hello/build/x86_64-unknown-linux-gnu/release/hello-tests"),
    "the test runner sits at <output-dir>/<target>/<mode>/<name>-tests",
  )
  let nested = run Path.make("/work/hello/src/parse/lexer_1.silk")
  let module = match move run Projects.selectSource(&minimal, &nested) {
    SourceSelection.Module { relative } => same(Bytes.asSlice(&relative), b"src/parse/lexer_1.silk")
    SourceSelection.Outside { .. } => false
    SourceSelection.NotModule => false
  }
  let beside = run Path.make("/work/hello/tests/a.silk")
  let prefixed = run Path.make("/work/hello/srcx/a.silk")
  let outside = match move run Projects.selectSource(&minimal, &beside) {
    SourceSelection.Outside { sourceRoot } => same(Path.rawBytes(&sourceRoot), b"/work/hello/src")
    SourceSelection.Module { .. } => false
    SourceSelection.NotModule => false
  }
  let sibling = match move run Projects.selectSource(&minimal, &prefixed) {
    SourceSelection.Outside { .. } => true
    SourceSelection.Module { .. } => false
    SourceSelection.NotModule => false
  }
  let mut odd = 0
  let candidates = [
    b"/work/hello/src/a.txt",
    b"/work/hello/src/a b.silk",
    b"/work/hello/src/.silk",
    b"/work/hello/src/a.silk.silk",
  ]
  let mut at = usize.ZERO
  while at < 4 {
    let candidate = run Path.fromBytes(candidates[at])
    if let SourceSelection.NotModule = move run Projects.selectSource(&minimal, &candidate) {
      odd = odd + 1
    }
    at = at + usize.ONE
  }
  run Testing.expect(
    module && outside && sibling && odd == 4,
    "a selected test source must be a canonical .silk module path below the root's directory",
  )
  run Testing.expect(
    same(Projects.mode(b"none"), b"dev") && same(Projects.mode(b"speed"), b"release")
      && same(Projects.mode(b"size"), b"size"),
    "output modes follow the shared optimization choices",
  )

  // Artifact form is chosen by a compilation, independently of package.kind.
  let archive = run Projects.artifactAs(
    &minimal,
    Form.StaticLibrary,
    b"x86_64-unknown-linux-gnu",
    b"release",
  )
  let linux = run Projects.artifactAs(
    &minimal,
    Form.SharedLibrary,
    b"x86_64-unknown-linux-gnu",
    b"dev",
  )
  let darwin = run Projects.artifactAs(
    &minimal,
    Form.SharedLibrary,
    b"aarch64-apple-darwin",
    b"dev",
  )
  run Testing.expect(
    same(Path.rawBytes(&archive), b"/work/hello/build/x86_64-unknown-linux-gnu/release/hello.a")
      && same(Path.rawBytes(&linux), b"/work/hello/build/x86_64-unknown-linux-gnu/dev/hello.so")
      && same(Path.rawBytes(&darwin), b"/work/hello/build/aarch64-apple-darwin/dev/hello.dylib"),
    "compilation artifacts use target-specific library names",
  )
  let windows = run Projects.artifact(&minimal, b"x86_64-pc-windows-msvc", b"dev")
  let windowsTests = run Projects.testExecutable(&minimal, b"x86_64-pc-windows-msvc", b"dev")
  run Testing.expect(
    same(Path.rawBytes(&windows), b"/work/hello/build/x86_64-pc-windows-msvc/dev/hello.exe")
      && same(
        Path.rawBytes(&windowsTests),
        b"/work/hello/build/x86_64-pc-windows-msvc/dev/hello-tests.exe",
      ),
    "built-in commands use the host and Windows executables have .exe",
  )
  let malformed = run refused(&manifest, b"[package\nname = \"hello\"\n")
  let rooted = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \".\"\nmain = \"src/app/main.silk\"\n",
  )
  let testsFile = run Path.make("/work/hello/tests/a.silk")
  let rootedModule = match move run Projects.selectSource(&rooted, &testsFile) {
    SourceSelection.Module { relative } => same(Bytes.asSlice(&relative), b"tests/a.silk")
    SourceSelection.Outside { .. } => false
    SourceSelection.NotModule => false
  }
  let above = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \"..\"\nmain = \"hello/main.silk\"\n",
  )
  let sharedFile = run Path.make("/work/shared/a.silk")
  let aboveModule = match move run Projects.selectSource(&above, &sharedFile) {
    SourceSelection.Module { relative } => same(Bytes.asSlice(&relative), b"../shared/a.silk")
    SourceSelection.Outside { .. } => false
    SourceSelection.NotModule => false
  }
  run Testing.expect(
    same(Path.rawBytes(Projects.sourceRoot(&rooted)), b"/work/hello")
      && same(Path.rawBytes(Projects.sourceRoot(&minimal)), b"/work/hello/src")
      && same(Path.rawBytes(Projects.sourceRoot(&above)), b"/work")
      && rootedModule
      && aboveModule,
    "package.source resolves against the manifest's directory and selects sources below it, relative to the project",
  )
  let besideRoot = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nmain = \"../main.silk\"\n",
  )
  let requirements = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \".\"\n[unstable]\ncomposition = { requirements = [{ kind = \"prebuilt-object\", name = \"support\" }] }\n",
  )
  let retention = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \".\"\n[unstable]\ncomposition = { retention = [{ module = \"support\", declaration = \"keep\" }] }\n",
  )
  let emptyLists = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \".\"\n[unstable]\ncomposition = { requirements = [], retention = [] }\n",
  )
  run Testing.expect(
    requirements && same(Projects.name(&retention), b"hello")
      && same(Projects.name(&emptyLists), b"hello"),
    "a composition naming native requirements is refused until native builds resolve them; retention roots decode",
  )
  let workspaceOnly = run refused(&manifest, b"[workspace]\nmembers = [\"app\"]\n")
  run Testing.expect(
    workspaceOnly,
    "a manifest that only defines a workspace is not a project a command can build",
  )
  run Testing.expect(besideRoot, "package.main must stay below the source root")
  run Testing.expect(
    Projects.isSemanticVersion(b"1.2.3") && Projects.isSemanticVersion(b"0.0.0-alpha.1+build.7")
      && Projects.isSemanticVersion(b"1.0.0-0a.x-y")
      && !Projects.isSemanticVersion(b"01.2.3")
      && !Projects.isSemanticVersion(b"1.2")
      && !Projects.isSemanticVersion(b"1.2.3-01")
      && !Projects.isSemanticVersion(b"1.2.3-")
      && !Projects.isSemanticVersion(b"1.2.3+a..b"),
    "semantic versions follow the TypeScript pattern",
  )
  run Testing.expect(malformed, "malformed TOML is refused")
}

// Whether `text` is refused as an invalid manifest at manifest line `line`.
effect fn refusedAt(manifest: &Path, text: &[u8], line: usize) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let decoded = run Effect.result(Projects.decode(manifest, text))
  return match move decoded {
    Result<Project, ProjectError | OutOfMemoryError>.Success { .. } => false
    Result<Project, ProjectError | OutOfMemoryError>.Failure { error } => match move error {
      ProjectError problem => match move problem {
        ProjectError.InvalidManifest { line: written, .. } => written == line
        _ => false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn fieldPolicy() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError
  ? &mut Allocator {
  let manifest = run Path.make("/work/hello/silk.toml")
  let package = run refusedAt(
    &manifest,
    b"""[package]
    name = "hello"
    descripton = "x"
    """,
    usize.add(0, 3),
  )
  let inline = run refusedAt(
    &manifest,
    b"""[package]
    name = "hello"
    [unstable]
    composition = { runtimes = [
      { name = "a", module = "m" },
      { name = "b", module = "m", bogus = 1 },
    ] }
    """,
    usize.add(0, 6),
  )
  let tabled = run refusedAt(
    &manifest,
    b"""[package]
    name = "hello"
    [[unstable.composition.runtimes]]
    name = "a"
    module = "m"
    [[unstable.composition.runtimes]]
    name = "b"
    module = "m"
    bogus = 1
    """,
    usize.add(0, 9),
  )
  run Testing.expect(
    package && inline && tabled,
    "schema failures become InvalidManifest at the offending key, including repeated array entries",
  )
  let unlisted = run refusedAt(
    &manifest,
    b"""[package]
    name = "hello"
    [unstable]
    composition = { runtimes = [
      { name = "start", module = "m" },
      { name = "other", module = "m" },
    ], defaults = [
      "start",
      "missing",
    ] }
    """,
    usize.add(0, 4),
  )
  let absent = run refusedAt(
    &manifest,
    b"""[package]
    name = "hello"
    [unstable]
    composition = { defaults = ["start"] }
    """,
    usize.add(0, 4),
  )
  run Testing.expect(unlisted && absent, "a default must resolve to a runtime at its entry")
  let accepted = run Projects.decode(
    &manifest,
    b"""[package]
    name = "hello"
    silk-version = "0.1.0"
    source = "."
    main = "main.silk"
    exports = []
    [dependencies]
    lib = { path = "../lib", package = "lib" }
    [release]
    repository = "silk-lang/silk"
    """,
  )
  run Testing.expect(
    same(Projects.name(&accepted), b"hello"),
    "build and release fields reach project decoding",
  )
}

effect fn layoutPolicy() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError
  ? &mut Allocator {
  let manifest = run Path.make("/work/hello/silk.toml")
  let bare = run Projects.decode(&manifest, b"[package]\nname = \"hello_world\"\n")
  run Testing.expect(
    same(Path.rawBytes(Projects.sourceRoot(&bare)), b"/work/hello/src")
      && same(Path.rawBytes(Projects.entry(&bare)), b"/work/hello/src/main.silk")
      && Projects.form(&bare) == Form.Executable
      && Projects.runnable(&bare),
    "a name alone is a package: source src, main main.silk, an executable, version 0.0.0",
  )
  let library = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nkind = \"library\"\nexports = [\"lib\"]\n",
  )
  run Testing.expect(
    same(Path.rawBytes(Projects.entry(&library)), b"/work/hello/src/lib.silk")
      && Projects.form(&library) == Form.Library
      && !Projects.runnable(&library),
    "a library's root module defaults to lib.silk, and a library is not runnable",
  )
  let placed = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nsource = \".\"\nmain = \"app/start.silk\"\nkind = \"library\"\n",
  )
  run Testing.expect(
    same(Path.rawBytes(Projects.sourceRoot(&placed)), b"/work/hello")
      && same(Path.rawBytes(Projects.entry(&placed)), b"/work/hello/app/start.silk")
      && Projects.form(&placed) == Form.Library,
    "main resolves below source, and a library package is checked",
  )
  let described = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\ndescription = \"d\"\nlicense = \"MIT\"\nrepository = \"r\"\nhomepage = \"h\"\nreadme = \"README.md\"\nauthors = [\"a\"]\nkeywords = []\n[tool.editor]\nanything = { goes = 1 }\n[native]\n",
  )
  run Testing.expect(
    same(Projects.name(&described), b"hello"),
    "publishing metadata, [tool] and [native] are accepted",
  )
  run Testing.expect(
    ManifestFields.compatible(b"0.3.4", b"0.3.2") && !ManifestFields.compatible(b"0.3.1", b"0.3.2")
      && !ManifestFields.compatible(b"0.4.0", b"0.3.2")
      && ManifestFields.compatible(b"1.5.0", b"1.2.9")
      && !ManifestFields.compatible(b"2.0.0", b"1.2.0")
      && !ManifestFields.compatible(b"1.2.3", b"1.2.4")
      && ManifestFields.compatible(b"0.0.0", b"0.9.0")
      && ManifestFields.compatible(b"0.3.0", b"0.0.0"),
    "a dependency's silk-version names its release line: same minor before 1.0, same major after, never older",
  )
  run Testing.expect(
    ManifestFields.compatible(b"0.2.0-dev.11+abc", b"0.2.0-dev.11")
      && ManifestFields.compatible(b"0.2.0-dev.11+abc", b"0.2.0-dev.11+abc")
      && !ManifestFields.compatible(b"0.2.0-dev.11+abc", b"0.2.0-dev.11+def")
      && !ManifestFields.compatible(b"0.2.0-dev.12", b"0.2.0-dev.11")
      && !ManifestFields.compatible(b"0.2.0-dev.11", b"0.2.0")
      && !ManifestFields.compatible(b"0.2.0", b"0.2.0-dev.11"),
    "a dev release matches only itself, and a dev compiler builds only dependencies written for it",
  )
  run Testing.expect(
    same(ManifestFields.withoutMetadata(b"0.2.0-dev.11+abc"), b"0.2.0-dev.11")
      && same(ManifestFields.withoutMetadata(b"0.2.0"), b"0.2.0"),
    "a written pin drops the build metadata, which the release's version already identifies",
  )
  run Testing.expect(
    ManifestFields.isPrerelease(b"0.2.0-dev.11+abc") && ManifestFields.isPrerelease(b"0.2.0-dev.11")
      && !ManifestFields.isPrerelease(b"0.2.0")
      && !ManifestFields.isPrerelease(b"0.2.0+abc"),
    "a prerelease is a version with a label after its patch",
  )
}

// Syntax failures retain parser locations when manifest validation is shared.
effect fn valuePolicy() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError
  ? &mut Allocator {
  let manifest = run Path.make("/work/hello/silk.toml")
  let unquoted = run refusedAt(
    &manifest,
    b"""[package]
    name = p
    """,
    usize.add(0, 2),
  )
  let unclosed = run refusedAt(
    &manifest,
    b"""[package
    name = "p"
    """,
    usize.ONE,
  )
  let twice = run refusedAt(
    &manifest,
    b"""[package]
    name = "p"
    name = "q"
    """,
    usize.add(0, 3),
  )
  run Testing.expect(unquoted && unclosed && twice, "invalid TOML is refused at the parser's line")
}

test effect fn manifestValueAndSyntaxErrorsNameTheirLine() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run valuePolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn manifestLayoutUsesSourceMainAndKind() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run layoutPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn unknownManifestFieldsAreRefusedAtTheirLine() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run fieldPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn projectManifestsDecodeAndPlaceArtifacts() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run manifestPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Semantic profile failures retain their code and manifest location.
fn text(value: &Option<Bytes>, expected: &[u8]) -> bool {
  return match &value.* {
    Option<Bytes>.Some { value: written } => same(Bytes.asSlice(&written), expected)
    Option<Bytes>.None => false
  }
}

effect fn hostDefaultPolicy() -> ()
  ! AssertionError<'static>
    | FileError
    | ProjectError
    | PlanError
    | InvalidProjectCommand
    | InitialProfileProblem
    | TomlError
    | OutOfMemoryError
  ? &mut Allocator {
  let none = List<Bytes>.make()
  let Build { options, .. } = move run ProjectCommands.parseBuild(List<Bytes>.asSlice(&none))
  let planned = run ProjectPlans.make(&options, Target.forId(TargetId.Aarch64AppleDarwin))
  let plans = List<ProjectPlan>.asSlice(&planned)
  let unset = match &plans[0].input.libc {
    Option<Bytes>.Some { .. } => false
    Option<Bytes>.None => true
  }
  let profile = run InitialProfile.freeze(&plans[0].input)
  let libc = match move InitialProfile.text(&profile, b"libc") {
    Option<&[u8]>.Some { value } => same(value, b"system")
    Option<&[u8]>.None => false
  }
  run Testing.expect(
    plans.length == 1 && text(&plans[0].input.target, b"aarch64-apple-darwin") && unset && libc
      && Target.id(InitialProfile.target(&profile)) == TargetId.Aarch64AppleDarwin,
    "an unconfigured project plans the host target, whose default libc the frozen profile selects",
  )
}

test effect fn unconfiguredProjectsBuildForTheHost() -> ()
  ! AssertionError<'static>
    | FileError
    | ProjectError
    | PlanError
    | InvalidProjectCommand
    | InitialProfileProblem
    | TomlError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run hostDefaultPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A library writes no `[package].main` and has no `lib.silk`: its first export, a module file or a
// directory's barrel, is its root module. A written `lib.silk` or `main` keeps its root.
effect fn libraryRoots(directory: &Path) -> () ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let manifest = run Path.join(directory, "silk.toml")
  let source = run Path.join(directory, "src")
  run FileSystem.createDirectory(&source)
  run FileSystem.writeFile(&run Path.join(&source, "helper.silk"), b"pub fn one() -> i32 { return 1 }\n")
  run FileSystem.writeFile(&run Path.join(&source, "codec.silk"), b"import helper\n")
  run FileSystem.writeFile(&manifest, b"[package]\nname = \"codec\"\nkind = \"library\"\nexports = [\"codec\", \"helper\"]\n")
  let exported = run Projects.load(&manifest)
  run Testing.expect(endsWith(Path.rawBytes(Projects.entry(&exported)), b"/src/codec.silk"), "a library without lib.silk is rooted at its first export")
  let wire = run Path.join(&source, "wire")
  run FileSystem.createDirectory(&wire)
  run FileSystem.writeFile(&run Path.join(&wire, "mod.silk"), b"pub fn two() -> i32 { return 2 }\n")
  run FileSystem.writeFile(&manifest, b"[package]\nname = \"codec\"\nkind = \"library\"\nexports = [\"wire\"]\n")
  let barrel = run Projects.load(&manifest)
  run Testing.expect(endsWith(Path.rawBytes(Projects.entry(&barrel)), b"/src/wire/mod.silk"), "an exported directory roots the library at its barrel")
  run FileSystem.writeFile(&manifest, b"[package]\nname = \"codec\"\nkind = \"library\"\nmain = \"start.silk\"\nexports = [\"codec\"]\n")
  let named = run Projects.load(&manifest)
  run Testing.expect(endsWith(Path.rawBytes(Projects.entry(&named)), b"/src/start.silk"), "a written main stays the root even when its file is missing")
  run FileSystem.writeFile(&run Path.join(&source, "lib.silk"), b"pub import codec\n")
  run FileSystem.writeFile(&manifest, b"[package]\nname = \"codec\"\nkind = \"library\"\nexports = [\"codec\"]\n")
  let written = run Projects.load(&manifest)
  run Testing.expect(endsWith(Path.rawBytes(Projects.entry(&written)), b"/src/lib.silk"), "a library with lib.silk is rooted there")
  return ()
}

fn endsWith(text: &[u8], suffix: &[u8]) -> bool {
  return text.length >= suffix.length && same(Slice.view<u8>(text, text.length - suffix.length, suffix.length), suffix)
}

fn temporaryParent() -> string<'static> {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return "/private/tmp" }
  else { return "/tmp" }
}

effect fn rootedLibraries() -> () ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let parent = run Path.make(temporaryParent())
  let temporary = run FileSystem.temporaryDirectory(&parent, "silk-library-root-case")
  return run Effect.ensuring(libraryRoots(&temporary.path), cleanup(&temporary.path))
}

effect fn ignoreCleanup(error: FileError | OutOfMemoryError) -> () { return () }

effect fn cleanup(path: &Path) -> () ? &mut FileSystem | &mut Allocator {
  return run Effect.catchAll(FileSystem.removeDirectoryRecursively(path), ignoreCleanup)
}

test effect fn librariesWithoutARootFileAreRootedAtTheirFirstExport() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make("/") |> Effect.provideMut<Allocator>(&mut allocator)
  return run rootedLibraries() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
}
