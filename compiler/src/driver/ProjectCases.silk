//! Project manifests decode the TypeScript CLI's fields and place artifacts below the output directory.

import driver.PlatformSupply { Installation, Request as SupplyRequest }
import driver.Project as Projects { Form, Project, ProjectError, SourceSelection, Stage }
import driver.ProjectCommand as ProjectCommands { Build, InvalidProjectCommand, Options }
import driver.ProjectPlan as ProjectPlans { PlanError, ProjectPlan }
import driver.ProjectProfile as ProjectProfiles { Code, InvalidProfile, Profile }
import semantic.InitialProfile { InitialProfile, Problem as InitialProfileProblem }
import semantic.Target { Id as TargetId, Target }
import semantic.ProfileBinding { Field as RecordField, Input as BindingInput, Provenance, Supplied, Tier }
import silk.box { Box }
import silk.json_scanner { JsonError }
import silk.json_value { Json, Value as JsonValue }
import silk.option { Option }
import silk.toml_scanner { TomlError }
import silk.list { List }
import silk.bytes { Bytes }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.filesystem { FileError, Path }
import silk.result { Result }
import silk.testing { AssertionError, Testing }
import silk.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Whether `text` is refused as an invalid manifest.
effect fn refused(manifest: &Path, text: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let decoded = run Effect.result(Projects.decode(manifest, text))
  return match move decoded {
    Result<Project, ProjectError | OutOfMemoryError>.Success { value: _ } => false
    Result<Project, ProjectError | OutOfMemoryError>.Failure { error } => match move error {
      ProjectError problem => match move problem {
        ProjectError.InvalidManifest { .. } => true
        _ => false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn manifestPolicy() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError
  ? &mut Allocator {
  let manifest = run Path.make("/work/hello/silk.toml")
  let minimal = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nroot = \"src/main.silk\"\n"
  )
  run Testing.expect(
    same(Projects.name(&minimal), b"hello")
      && same(Path.rawBytes(Projects.entry(&minimal)), b"/work/hello/src/main.silk")
      && same(Path.rawBytes(Projects.directory(&minimal)), b"/work/hello"),
    "the package name and the root entry resolve against the manifest's directory"
  )
  run Testing.expect(
    same(Path.rawBytes(Projects.outputDirectory(&minimal)), b"/work/hello/build")
      && Projects.runnable(&minimal),
    "the output directory defaults to build and the artifact to a final executable"
  )
  let executable = run Projects.artifact(
    &minimal,
    b"aarch64-unknown-linux-gnu",
    Projects.profileName(b"none", true)
  )
  run Testing.expect(
    same(
      Path.rawBytes(&executable),
      b"/work/hello/build/llvm/aarch64-unknown-linux-gnu/debug/hello"
    ),
    "the executable sits at <output-dir>/llvm/<target>/<profile>/<name>"
  )
  let runner = run Projects.testExecutable(&minimal, b"x86_64-unknown-linux-gnu", b"release")
  run Testing.expect(
    same(Path.rawBytes(&runner), b"/work/hello/build/test/llvm/x86_64-unknown-linux-gnu/release/hello"),
    "the test runner sits at <output-dir>/test/llvm/<target>/<profile>/<name>"
  )
  let nested = run Path.make("/work/hello/src/parse/lexer_1.silk")
  let module = match move run Projects.selectSource(&minimal, &nested) {
    SourceSelection.Module { relative } => same(Bytes.asSlice(&relative), b"src/parse/lexer_1.silk")
    SourceSelection.Outside { .. } => false
    SourceSelection.NotModule => false
  }
  let beside = run Path.make("/work/hello/tests/a.silk")
  let prefixed = run Path.make("/work/hello/srcx/a.silk")
  let outside = match move run Projects.selectSource(&minimal, &beside) {
    SourceSelection.Outside { sourceRoot } => same(Path.rawBytes(&sourceRoot), b"/work/hello/src")
    SourceSelection.Module { .. } => false
    SourceSelection.NotModule => false
  }
  let sibling = match move run Projects.selectSource(&minimal, &prefixed) {
    SourceSelection.Outside { .. } => true
    SourceSelection.Module { .. } => false
    SourceSelection.NotModule => false
  }
  let mut odd = 0
  let candidates = [b"/work/hello/src/a.txt", b"/work/hello/src/a b.silk", b"/work/hello/src/.silk", b"/work/hello/src/a.silk.silk"]
  let mut at = usize.ZERO
  while at < 4 {
    let candidate = run Path.fromBytes(candidates[at])
    if let SourceSelection.NotModule = move run Projects.selectSource(&minimal, &candidate) {
      odd = odd + 1
    }
    at = at + usize.ONE
  }
  run Testing.expect(
    module && outside && sibling && odd == 4,
    "a selected test source must be a canonical .silk module path below the root's directory"
  )
  run Testing.expect(
    same(Projects.profileName(b"none", false), b"debug")
      && same(Projects.profileName(b"speed", false), b"release")
      && same(Projects.profileName(b"speed", true), b"release-with-debug"),
    "profile directories follow the optimization and debug choices"
  )
  let custom = run Projects.decode(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"a-1\"\nroot = \"main.silk\"\n[build]\noutput-dir = \"out/./x/../artifacts\"\nartifact = \"static-library\"\n"
  )
  run Testing.expect(
    same(Path.rawBytes(Projects.outputDirectory(&custom)), b"/work/hello/out/artifacts")
      && !Projects.runnable(&custom)
      && Projects.form(&custom) == Form.StaticLibrary && Projects.stage(&custom) == Stage.Final,
    "a contained output directory normalizes and a library artifact is not runnable"
  )
  let archive = run Projects.artifact(&custom, b"x86_64-unknown-linux-gnu", b"release")
  let shared = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[build]\nartifact = \"shared-library\"\n"
  )
  let linux = run Projects.artifact(&shared, b"x86_64-unknown-linux-gnu", b"debug")
  let darwin = run Projects.artifact(&shared, b"aarch64-apple-darwin", b"debug")
  run Testing.expect(
    same(Path.rawBytes(&archive), b"/work/hello/out/artifacts/llvm/x86_64-unknown-linux-gnu/release/liba-1.a")
      && same(Path.rawBytes(&linux), b"/work/hello/build/llvm/x86_64-unknown-linux-gnu/debug/libhello.so")
      && same(Path.rawBytes(&darwin), b"/work/hello/build/llvm/aarch64-apple-darwin/debug/libhello.dylib"),
    "library artifacts are named as the TypeScript CLI names them"
  )
  let staged = run Projects.decode(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nroot = \"main.silk\"\n[build]\nstage = \"llvm-ir\"\n"
  )
  run Testing.expect(
    !Projects.runnable(&staged) && Projects.form(&staged) == Form.Executable && Projects.stage(&staged) == Stage.LlvmIr,
    "an intermediate emission stage is not runnable"
  )
  let irFile = run Projects.artifact(&staged, b"x86_64-unknown-linux-gnu", b"debug")
  run Testing.expect(
    same(Path.rawBytes(&irFile), b"/work/hello/build/llvm/x86_64-unknown-linux-gnu/debug/hello.ll"),
    "an intermediate stage names its representation"
  )
  let defaultTargets = Projects.targets(&minimal)
  let targeted = run Projects.decode(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nroot = \"main.silk\"\n[build]\ntargets = [\"x86_64-unknown-linux-gnu\", \"host\"]\n"
  )
  let declared = Projects.targets(&targeted)
  run Testing.expect(
    defaultTargets.length == 1 && same(Bytes.asSlice(&defaultTargets[0]), b"host") && declared.length == 2
      && same(Bytes.asSlice(&declared[0]), b"x86_64-unknown-linux-gnu") && same(Bytes.asSlice(&declared[1]), b"host"),
    "build targets default to the host and keep their declared order"
  )
  let noTargets = run refused(&manifest, b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nroot = \"main.silk\"\n[build]\ntargets = []\n")
  let unknownTarget = run refused(&manifest, b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nroot = \"main.silk\"\n[build]\ntargets = [\"mips\"]\n")
  let scalarTargets = run refused(&manifest, b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nroot = \"main.silk\"\n[build]\ntargets = \"host\"\n")
  run Testing.expect(noTargets && unknownTarget && scalarTargets, "build targets must be a non-empty array of known selectors")
  let names = run refused(&manifest, b"[package]\nversion = \"0.1.0\"\nname = \"Hello\"\nroot = \"main.silk\"\n")
  let leading = run refused(&manifest, b"[package]\nversion = \"0.1.0\"\nname = \"1x\"\nroot = \"main.silk\"\n")
  let unnamed = run refused(&manifest, b"[package]\nversion = \"0.1.0\"\nroot = \"main.silk\"\n")
  run Testing.expect(names && leading && unnamed, "a package name must be portable")
  let rootless = run refused(&manifest, b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\n")
  let emptyRoot = run refused(&manifest, b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nroot = \"\"\n")
  run Testing.expect(rootless && emptyRoot, "a package needs a non-empty root")
  let escaping = run refused(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nroot = \"main.silk\"\n[build]\noutput-dir = \"a/../../b\"\n"
  )
  let absolute = run refused(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nroot = \"main.silk\"\n[build]\noutput-dir = \"/tmp/out\"\n"
  )
  let drive = run refused(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nroot = \"main.silk\"\n[build]\noutput-dir = \"C:\\\\out\"\n"
  )
  let empty = run refused(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nroot = \"main.silk\"\n[build]\noutput-dir = \"\"\n"
  )
  run Testing.expect(
    escaping && absolute && drive && empty,
    "the output directory must stay inside the project"
  )
  let artifact = run refused(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nroot = \"main.silk\"\n[build]\nartifact = \"wasm\"\n"
  )
  let stage = run refused(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nroot = \"main.silk\"\n[build]\nstage = \"binary\"\n"
  )
  let malformed = run refused(&manifest, b"[package\nname = \"hello\"\n")
  let badVersion = run refused(&manifest, b"[package]\nname = \"hello\"\nversion = \"1.0\"\nroot = \"main.silk\"\n")
  let missingVersion = run refused(&manifest, b"[package]\nname = \"hello\"\nroot = \"main.silk\"\n")
  let unknownBuild = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[build]\nlinker = \"ld\"\n"
  )
  let scalarBuild = run refused(&manifest, b"build = 3\n[package]\nname = \"hello\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n")
  let supply = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[build]\nplatform-supply = \"system\"\n"
  )
  let packageless = run refused(&manifest, b"[build]\nstage = \"final\"\n")
  run Testing.expect(
    badVersion && missingVersion && unknownBuild && scalarBuild && supply && packageless,
    "a manifest needs a [package] table and a semantic version, and refuses unknown or unimplemented build fields"
  )
  let recorded = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsilk-version = \"2.7.1-rc.1\"\nroot = \"main.silk\"\n"
  )
  let partialRelease = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsilk-version = \"2.7\"\nroot = \"main.silk\"\n"
  )
  let numericRelease = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsilk-version = 2\nroot = \"main.silk\"\n"
  )
  run Testing.expect(
    !recorded && partialRelease && numericRelease,
    "an optional silk-version records the creating compiler's release as a semantic version"
  )
  let explicit = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[build.platform-supply]\nkind = \"explicit\"\ntarget = \"x86_64-unknown-linux-gnu\"\nroot = \"sysroot\"\nlinker = \"/tools/ld.lld\"\nsupport = [{ root = \"../gcc\", target = \"x86_64-unknown-linux-gnu\", origin = \"gcc 13\" }]\n"
  )
  let mut explicitOk = false
  let explicitSupply = Projects.supply(&explicit)
  if let SupplyRequest.Explicit { target, root, linker, origin, support } = &explicitSupply.* {
    let installations = List<Installation>.asSlice(&support)
    explicitOk = same(Bytes.asSlice(&target), b"x86_64-unknown-linux-gnu")
      && same(Path.rawBytes(&root), b"/work/hello/sysroot") && same(Path.rawBytes(&linker), b"/tools/ld.lld")
      && same(Bytes.asSlice(&origin), b"/work/hello/silk.toml:build.platform-supply") && installations.length == 1
      && same(Path.rawBytes(&installations[0].root), b"/work/gcc")
  }
  let managed = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[build.platform-supply]\nkind = \"managed\"\nname = \"silk-sdk\"\n"
  )
  let mut managedOk = false
  let managedSupply = Projects.supply(&managed)
  if let SupplyRequest.Managed { name } = &managedSupply.* {
    managedOk = same(Bytes.asSlice(&name), b"silk-sdk")
  }
  let mut automaticOk = false
  let minimalSupply = Projects.supply(&minimal)
  if let SupplyRequest.Automatic = &minimalSupply.* {
    automaticOk = true
  }
  run Testing.expect(
    explicitOk && managedOk && automaticOk,
    "a platform-supply table decodes with paths against the manifest's directory, and its absence is automatic"
  )
  let extraKey = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[build.platform-supply]\nkind = \"native\"\nname = \"x\"\n"
  )
  let foreignSupply = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[build.platform-supply]\nkind = \"explicit\"\ntarget = \"wasm32\"\nroot = \"/s\"\nlinker = \"/l\"\n"
  )
  run Testing.expect(extraKey && foreignSupply, "a platform-supply table with extra keys or an unsupported target is refused")
  let rooted = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nroot = \"src/app/main.silk\"\nsource-root = \".\"\n"
  )
  let testsFile = run Path.make("/work/hello/tests/a.silk")
  let rootedModule = match move run Projects.selectSource(&rooted, &testsFile) {
    SourceSelection.Module { relative } => same(Bytes.asSlice(&relative), b"tests/a.silk")
    SourceSelection.Outside { .. } => false
    SourceSelection.NotModule => false
  }
  let above = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\nsource-root = \"..\"\n"
  )
  let sharedFile = run Path.make("/work/shared/a.silk")
  let aboveModule = match move run Projects.selectSource(&above, &sharedFile) {
    SourceSelection.Module { relative } => same(Bytes.asSlice(&relative), b"../shared/a.silk")
    SourceSelection.Outside { .. } => false
    SourceSelection.NotModule => false
  }
  run Testing.expect(
    same(Path.rawBytes(Projects.sourceRoot(&rooted)), b"/work/hello") && same(Path.rawBytes(Projects.sourceRoot(&minimal)), b"/work/hello/src")
      && same(Path.rawBytes(Projects.sourceRoot(&above)), b"/work") && rootedModule && aboveModule,
    "package.source-root resolves against the manifest's directory and selects sources below it, relative to the project"
  )
  let besideRoot = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\nsource-root = \"src\"\n"
  )
  let emptySourceRoot = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\nsource-root = \"\"\n"
  )
  let scalarRoot = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\nsource-root = 3\n"
  )
  let requirements = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[build]\ncomposition = { requirements = [{ kind = \"prebuilt-object\", name = \"support\" }] }\n"
  )
  let retention = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[build]\ncomposition = { retention = [{ module = \"support\", declaration = \"keep\" }] }\n"
  )
  let emptyLists = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n[build]\ncomposition = { requirements = [], retention = [] }\n"
  )
  run Testing.expect(
    requirements && same(Projects.name(&retention), b"hello") && same(Projects.name(&emptyLists), b"hello"),
    "a composition naming native requirements is refused until native builds resolve them; retention roots decode"
  )
  let workspaceOnly = run refused(&manifest, b"[workspace]\nmembers = [\"app\"]\n")
  run Testing.expect(
    workspaceOnly,
    "a manifest that only defines a workspace is not a project a command can build"
  )
  run Testing.expect(
    besideRoot && emptySourceRoot && scalarRoot,
    "package.source-root must be a non-empty string with the root below it"
  )
  run Testing.expect(
    Projects.isSemanticVersion(b"1.2.3") && Projects.isSemanticVersion(b"0.0.0-alpha.1+build.7")
      && Projects.isSemanticVersion(b"1.0.0-0a.x-y") && !Projects.isSemanticVersion(b"01.2.3")
      && !Projects.isSemanticVersion(b"1.2") && !Projects.isSemanticVersion(b"1.2.3-01")
      && !Projects.isSemanticVersion(b"1.2.3-") && !Projects.isSemanticVersion(b"1.2.3+a..b"),
    "semantic versions follow the TypeScript pattern"
  )
  run Testing.expect(
    artifact && stage && malformed,
    "unknown artifacts, stages and malformed TOML are refused"
  )
}

// Whether `text` is refused as an invalid manifest with `detail` at manifest line `line`.
effect fn refusedAt(manifest: &Path, text: &[u8], detail: &[u8], line: usize) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let decoded = run Effect.result(Projects.decode(manifest, text))
  return match move decoded {
    Result<Project, ProjectError | OutOfMemoryError>.Success { value: _ } => false
    Result<Project, ProjectError | OutOfMemoryError>.Failure { error } => match move error {
      ProjectError problem => match move problem {
        ProjectError.InvalidManifest { line: written, detail: refused, .. } => written == line
          && same(Bytes.asSlice(&refused), detail)
        _ => false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn fieldPolicy() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError
  ? &mut Allocator {
  let manifest = run Path.make("/work/hello/silk.toml")
  let header = b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nroot = \"main.silk\"\n"
  let mut topLevel = run Bytes.copy(b"foo = 1\n")
  run Bytes.append(&mut topLevel, header)
  let mut packaged = run Bytes.copy(header)
  run Bytes.append(&mut packaged, b"description = \"x\"\n")
  let mut misspelled = run Bytes.copy(header)
  run Bytes.append(&mut misspelled, b"\n[packge]\nname = \"x\"\n")
  let mut dependency = run Bytes.copy(header)
  run Bytes.append(&mut dependency, b"\n[dependencies]\ngreeting = { path = \"../greeting\", version = \"1\" }\n")
  let mut dependencyTable = run Bytes.copy(header)
  run Bytes.append(&mut dependencyTable, b"[dependencies.greeting]\npath = \"../greeting\"\nversion = \"1\"\n")
  let mut built = run Bytes.copy(header)
  run Bytes.append(&mut built, b"[build]\nartefact = \"object\"\n")
  let top = run refusedAt(&manifest, Bytes.asSlice(&topLevel), b"foo is not a supported field", usize.ONE)
  let package = run refusedAt(&manifest, Bytes.asSlice(&packaged), b"package.description is not a supported field", usize.add(0, 5))
  let table = run refusedAt(&manifest, Bytes.asSlice(&misspelled), b"packge is not a supported field", usize.add(0, 6))
  let inline = run refusedAt(
    &manifest,
    Bytes.asSlice(&dependency),
    b"dependencies.greeting.version is not a supported field",
    usize.add(0, 7)
  )
  let headed = run refusedAt(
    &manifest,
    Bytes.asSlice(&dependencyTable),
    b"dependencies.greeting.version is not a supported field",
    usize.add(0, 7)
  )
  let build = run refusedAt(&manifest, Bytes.asSlice(&built), b"build.artefact is not a supported field", usize.add(0, 6))
  let mut composed = run Bytes.copy(header)
  run Bytes.append(&mut composed, b"[build]\ncomposition = { runtimes = [], defaults = [], bogus = 1 }\n")
  let composition = run refusedAt(
    &manifest,
    Bytes.asSlice(&composed),
    b"build.composition.bogus is not a supported field",
    usize.add(0, 6)
  )
  run Testing.expect(
    top && package && table && inline && headed && build && composition,
    "unknown top-level, [package], dependency, [build] and [build].composition fields are refused at their line"
  )
  let mut known = run Bytes.copy(header)
  run Bytes.append(
    &mut known,
    b"silk-version = \"0.1.0\"\nsource-root = \".\"\nexports = []\n[dependencies]\nlib = { path = \"../lib\", package = \"lib\" }\n[changes]\nrepository = \"silk-lang/silk\"\n"
  )
  let accepted = run Projects.decode(&manifest, Bytes.asSlice(&known))
  run Testing.expect(same(Projects.name(&accepted), b"hello"), "every field a build or `silk changes` reads is accepted")
  let text = b"top = 1\n[a.b]\n  # c = 0\n  c = 2\nd = { e = 3 }\n[[f]]\ng = 4\n"
  run Testing.expect(
    Projects.keyLine(text, b"top") == usize.ONE && Projects.keyLine(text, b"a.b.c") == usize.add(0, 4)
      && Projects.keyLine(text, b"a.b.d.e") == usize.add(0, 5) && Projects.keyLine(text, b"a.b.x") == usize.add(0, 2)
      && Projects.keyLine(text, b"f.g") == usize.add(0, 7) && Projects.keyLine(text, b"missing") == usize.ZERO,
    "a key's line is its own line, else the line of the innermost table holding it"
  )
}

test effect fn unknownManifestFieldsAreRefusedAtTheirLine() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run fieldPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn projectManifestsDecodeAndPlaceArtifacts() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run manifestPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Whether `text` is refused for its profile catalog with `code` and `subject`.
effect fn refusedProfile(manifest: &Path, text: &[u8], code: Code, subject: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let decoded = run Effect.result(Projects.decode(manifest, text))
  return match move decoded {
    Result<Project, ProjectError | OutOfMemoryError>.Success { value: _ } => false
    Result<Project, ProjectError | OutOfMemoryError>.Failure { error } => match move error {
      ProjectError problem => match move problem {
        ProjectError.InvalidProfile { code: refused, subject: named, .. } => refused == code
          && same(Bytes.asSlice(&named), subject)
        _ => false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// Whether selecting `name` refuses it as an unknown profile.
effect fn unknownProfile(project: &Project, name: &[u8]) -> bool
  ! TomlError | OutOfMemoryError
  ? &mut Allocator {
  let document = run Projects.document(project)
  let selected = run Effect.result(ProjectProfiles.select(&document, name))
  return match move selected {
    Result<Profile, InvalidProfile | OutOfMemoryError>.Success { value: _ } => false
    Result<Profile, InvalidProfile | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProfile refused => refused.code == Code.InvalidInput
        && same(Bytes.asSlice(&refused.subject), b"unknown profile missing: the manifest has no [profiles.missing] table")
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

fn integer(value: &BindingInput, expected: &[u8]) -> bool {
  return match &value.* {
    BindingInput.Integer { decimal } => same(Bytes.asSlice(&decimal), expected)
    _ => false
  }
}

effect fn profilePolicy() -> ()
  ! AssertionError<'static> | FileError | ProjectError | InvalidProfile | TomlError | OutOfMemoryError
  ? &mut Allocator {
  let manifest = run Path.make("/work/hello/silk.toml")
  let header = b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nroot = \"main.silk\"\n"
  let mut text = run Bytes.copy(header)
  run Bytes.append(
    &mut text,
    b"[build]\nprofile = \"fast\"\n[[build.bindings]]\npackage = \"hello@0.1.0\"\nmodule = \"main\"\nparameter = \"limit\"\nvalue = { kind = \"integer\", value = \"-0\" }\norigin = { source = \"silk.toml\", provenance = \"literal\" }\n[profiles.fast]\ntarget = \"x86_64-unknown-linux-gnu\"\noptimization = \"speed\"\ndebug = false\ncpu = { features = [\"avx2\"] }\n[[profiles.fast.bindings]]\npackage = \"hello@0.1.0\"\nmodule = \"main\"\nparameter = \"mode\"\nvalue = { kind = \"some\", value = { kind = \"record\", fields = { a = { kind = \"boolean\", value = true } } } }\norigin = { source = \"ci\", provenance = \"translated-public\", translator = \"silk/env\" }\n"
  )
  let project = run Projects.decode(&manifest, Bytes.asSlice(&text))
  let chosen = match move Projects.defaultProfile(&project) {
    Option<&[u8]>.Some { value } => same(value, b"fast")
    Option<&[u8]>.None => false
  }
  run Testing.expect(chosen, "build.profile names the default profile")
  let document = run Projects.document(&project)
  let Profile { input, bindings, maxMemory: unlimited } = move run ProjectProfiles.select(&document, b"fast")
  drop unlimited
  let optimized = match &input.optimization {
    Option<Bytes>.Some { value } => same(Bytes.asSlice(&value), b"speed")
    Option<Bytes>.None => false
  }
  let targeted = match &input.target {
    Option<Bytes>.Some { value } => same(Bytes.asSlice(&value), b"x86_64-unknown-linux-gnu")
    Option<Bytes>.None => false
  }
  let undebugged = match &input.debug {
    Option<bool>.Some { value } => !value
    Option<bool>.None => false
  }
  run Testing.expect(
    optimized && targeted && undebugged && List<Bytes>.length(&input.cpuFeatures) == 1,
    "a named profile carries its logical fields"
  )
  let supplied = List<Supplied>.asSlice(&bindings)
  run Testing.expect(supplied.length == 2, "a named profile adds its bindings to the project's")
  let first = &supplied[0]
  let second = &supplied[1]
  let projectFirst = first.tier == Tier.Project && same(Bytes.asSlice(&first.parameter), b"limit")
    && same(Bytes.asSlice(&first.module), b"main.silk")
    && integer(&first.value, b"0")
  let literal = match &first.provenance {
    Provenance.Literal => true
    _ => false
  }
  let profileSecond = second.tier == Tier.Override && same(Bytes.asSlice(&second.parameter), b"mode")
  let translated = match &second.provenance {
    Provenance.TranslatedPublic { translator } => same(Bytes.asSlice(&translator), b"silk/env")
    _ => false
  }
  let nested = match &second.value {
    BindingInput.Some { value } => match &Box<BindingInput>.get(&value)[0] {
      BindingInput.Record { fields } => List<RecordField>.length(&fields) == 1
      _ => false
    }
    _ => false
  }
  run Testing.expect(
    projectFirst && literal && profileSecond && translated && nested,
    "project bindings precede profile bindings, and -0 decodes as 0"
  )
  let projectOnly = run ProjectProfiles.projectBindings(&document)
  run Testing.expect(List<Supplied>.length(&projectOnly) == 1, "target builds receive only project bindings")
  let unknown = run unknownProfile(&project, b"missing")
  run Testing.expect(unknown, "an unknown profile name is refused")
  let mut badName = run Bytes.copy(header)
  run Bytes.append(&mut badName, b"[profiles.1fast]\ntarget = \"x86_64-unknown-linux-gnu\"\n")
  let mut missingDefault = run Bytes.copy(header)
  run Bytes.append(&mut missingDefault, b"[build]\nprofile = \"slow\"\n")
  let mut extraField = run Bytes.copy(header)
  run Bytes.append(&mut extraField, b"[profiles.fast]\ntarget = \"x86_64-unknown-linux-gnu\"\nspeed = 3\n")
  let mut untargeted = run Bytes.copy(header)
  run Bytes.append(&mut untargeted, b"[profiles.fast]\noptimization = \"speed\"\n")
  let mut wasmLibc = run Bytes.copy(header)
  run Bytes.append(&mut wasmLibc, b"[profiles.web]\ntarget = \"wasm32-unknown-unknown\"\nlibc = \"gnu\"\n")
  let mut secret = run Bytes.copy(header)
  run Bytes.append(
    &mut secret,
    b"[[build.bindings]]\npackage = \"hello@0.1.0\"\nmodule = \"main\"\nparameter = \"key\"\nvalue = { kind = \"string\", value = \"x\" }\norigin = { source = \"env\", provenance = \"secret\" }\n"
  )
  let mut badValue = run Bytes.copy(header)
  run Bytes.append(
    &mut badValue,
    b"[[build.bindings]]\npackage = \"hello@0.1.0\"\nmodule = \"main\"\nparameter = \"n\"\nvalue = { kind = \"integer\", value = \"01\" }\norigin = { source = \"silk.toml\", provenance = \"literal\" }\n"
  )
  let named = run refusedProfile(
    &manifest,
    Bytes.asSlice(&badName),
    Code.InvalidInput,
    b"profiles.1fast: a profile name is an ASCII letter, then letters, digits, `_` or `-`"
  )
  let defaulted = run refusedProfile(
    &manifest,
    Bytes.asSlice(&missingDefault),
    Code.InvalidInput,
    b"build.profile = \"slow\" names no [profiles.slow] table"
  )
  let fields = run refusedProfile(&manifest, Bytes.asSlice(&extraField), Code.UnknownField, b"profiles.fast.speed")
  let target = run refusedProfile(&manifest, Bytes.asSlice(&untargeted), Code.InvalidInput, b"profiles.fast.target")
  let combination = run refusedProfile(
    &manifest,
    Bytes.asSlice(&wasmLibc),
    Code.UnsupportedCombination,
    b"profiles.web.libc = \"gnu\""
  )
  let forbidden = run refusedProfile(&manifest, Bytes.asSlice(&secret), Code.ForbiddenProvenance, b"build.bindings: binding")
  let value = run refusedProfile(&manifest, Bytes.asSlice(&badValue), Code.InvalidInput, b"build.bindings: configuration value")
  let refusals = named && defaulted && fields && target && combination && forbidden && value
  run Testing.expect(refusals, "invalid profiles and bindings are refused with their TypeScript code and their manifest key")
  // Each profile refusal names the manifest line of the key it refuses.
  let fieldLine = run refusedProfileLine(&manifest, Bytes.asSlice(&extraField), usize.add(0, 7))
  let libcLine = run refusedProfileLine(&manifest, Bytes.asSlice(&wasmLibc), usize.add(0, 7))
  let bindingLine = run refusedProfileLine(&manifest, Bytes.asSlice(&badValue), usize.add(0, 5))
  run Testing.expect(fieldLine && libcLine && bindingLine, "profile refusals carry the line of the key they name")
  // A quoted profile name is located at its table, a binding's unknown field is named at its line,
  // and a deployment version, which only a Darwin link reads, is refused on another target.
  let mut quotedName = run Bytes.copy(header)
  run Bytes.append(&mut quotedName, b"[profiles.\"1fast\"]\ntarget = \"x86_64-unknown-linux-gnu\"\n")
  let mut extraBinding = run Bytes.copy(header)
  run Bytes.append(
    &mut extraBinding,
    b"[[build.bindings]]\npackage = \"hello@0.1.0\"\nmodule = \"main\"\nparameter = \"n\"\nvalue = { kind = \"integer\", value = \"1\" }\norigin = { source = \"silk.toml\", provenance = \"literal\" }\nextra = 1\n"
  )
  let mut deployed = run Bytes.copy(header)
  run Bytes.append(&mut deployed, b"[profiles.d]\ntarget = \"x86_64-unknown-linux-gnu\"\ndeployment = \"14.0\"\n")
  let quoted = run refusedProfile(
    &manifest,
    Bytes.asSlice(&quotedName),
    Code.InvalidInput,
    b"profiles.1fast: a profile name is an ASCII letter, then letters, digits, `_` or `-`"
  )
  let quotedLine = run refusedProfileLine(&manifest, Bytes.asSlice(&quotedName), usize.add(0, 5))
  let extra = run refusedProfile(&manifest, Bytes.asSlice(&extraBinding), Code.UnknownField, b"build.bindings.extra")
  let extraLine = run refusedProfileLine(&manifest, Bytes.asSlice(&extraBinding), usize.add(0, 11))
  let deployment = run refusedProfile(
    &manifest,
    Bytes.asSlice(&deployed),
    Code.UnsupportedCombination,
    b"profiles.d.deployment = \"14.0\""
  )
  let deploymentLine = run refusedProfileLine(&manifest, Bytes.asSlice(&deployed), usize.add(0, 7))
  run Testing.expect(
    quoted && quotedLine && extra && extraLine && deployment && deploymentLine,
    "a quoted profile name, a binding's unknown field and a non-Darwin deployment are refused at their line"
  )
  let mut darwin = run Bytes.copy(header)
  run Bytes.append(&mut darwin, b"[profiles.mac]\ntarget = \"aarch64-apple-darwin\"\ndeployment = \"14.0\"\n")
  let deployedOnDarwin = run Projects.decode(&manifest, Bytes.asSlice(&darwin))
  run Testing.expect(same(Projects.name(&deployedOnDarwin), b"hello"), "a Darwin profile takes a deployment version")
  // A valid value the native build cannot honor is refused rather than silently ignored.
  let mut sanitized = run Bytes.copy(header)
  run Bytes.append(&mut sanitized, b"[profiles.asan]\ntarget = \"x86_64-unknown-linux-gnu\"\nsanitizers = [\"address\"]\n")
  let mut unwound = run Bytes.copy(header)
  run Bytes.append(&mut unwound, b"[profiles.u]\ntarget = \"x86_64-unknown-linux-gnu\"\nunwind = \"native\"\n")
  let mut unchecked = run Bytes.copy(header)
  run Bytes.append(&mut unchecked, b"[profiles.u]\ntarget = \"x86_64-unknown-linux-gnu\"\nsafety = \"unchecked\"\n")
  let mut threaded = run Bytes.copy(header)
  run Bytes.append(&mut threaded, b"[profiles.u]\ntarget = \"x86_64-unknown-linux-gnu\"\nthreading = \"multi\"\n")
  let mut entered = run Bytes.copy(header)
  run Bytes.append(&mut entered, b"[profiles.u]\ntarget = \"x86_64-unknown-linux-gnu\"\nentry = { kind = \"named\", name = \"start\" }\n")
  let sanitizers = run refusedProfile(&manifest, Bytes.asSlice(&sanitized), Code.NotNative, b"profiles.asan.sanitizers")
  let unwind = run refusedProfile(&manifest, Bytes.asSlice(&unwound), Code.NotNative, b"profiles.u.unwind = \"native\"")
  let safety = run refusedProfile(&manifest, Bytes.asSlice(&unchecked), Code.NotNative, b"profiles.u.safety = \"unchecked\"")
  let threading = run refusedProfile(&manifest, Bytes.asSlice(&threaded), Code.NotNative, b"profiles.u.threading = \"multi\"")
  let entry = run refusedProfile(&manifest, Bytes.asSlice(&entered), Code.NotNative, b"profiles.u.entry")
  let mut armLarge = run Bytes.copy(header)
  run Bytes.append(&mut armLarge, b"[profiles.arm]\ntarget = \"aarch64-unknown-linux-gnu\"\ncodeModel = \"large\"\n")
  let large = run refusedProfile(&manifest, Bytes.asSlice(&armLarge), Code.NotNative, b"profiles.arm.codeModel = \"large\"")
  run Testing.expect(
    sanitizers && unwind && safety && threading && entry && large,
    "sanitizers, native unwinding, the unchecked and multi-threaded policies, an entry selection and an AArch64 large code model are refused as not native yet"
  )
  let mut applied = run Bytes.copy(header)
  run Bytes.append(
    &mut applied,
    b"[profiles.big]\ntarget = \"x86_64-unknown-linux-gnu\"\ncodeModel = \"large\"\nlink = \"static\"\ncpu = { model = \"x86-64\", features = [\"avx2\"] }\nsafety = \"checked\"\nthreading = \"single\"\nunwind = \"none\"\nentry = { kind = \"default\" }\n"
  )
  let big = run Projects.decode(&manifest, Bytes.asSlice(&applied))
  run Testing.expect(same(Projects.name(&big), b"hello"), "the fields the native build applies, and default values, are accepted")
  // `maxMemory` is a wasm32 link setting: whole 64 KiB pages up to 4 GiB.
  let mut limited = run Bytes.copy(header)
  run Bytes.append(&mut limited, b"[profiles.web]\ntarget = \"wasm32-unknown-unknown\"\nthreading = \"multi\"\nmaxMemory = \"256MiB\"\n")
  let web = run Projects.decode(&manifest, Bytes.asSlice(&limited))
  let webDocument = run Projects.document(&web)
  let Profile { input: webInput, bindings: webBindings, maxMemory } = move run ProjectProfiles.select(&webDocument, b"web")
  drop webInput
  drop webBindings
  let measured = match move maxMemory {
    Option<usize>.Some { value: bytes } => bytes == usize.add(0, 268435456)
    Option<usize>.None => false
  }
  run Testing.expect(measured, "a wasm32 profile's maxMemory is read in bytes")
  let mut native = run Bytes.copy(header)
  run Bytes.append(&mut native, b"[profiles.n]\ntarget = \"x86_64-unknown-linux-gnu\"\nmaxMemory = \"1GiB\"\n")
  let mut partial = run Bytes.copy(header)
  run Bytes.append(&mut partial, b"[profiles.w]\ntarget = \"wasm32-unknown-unknown\"\nmaxMemory = \"100000\"\n")
  let mut huge = run Bytes.copy(header)
  run Bytes.append(&mut huge, b"[profiles.w]\ntarget = \"wasm32-unknown-unknown\"\nmaxMemory = \"5GiB\"\n")
  let nativeLimit = run refusedProfile(&manifest, Bytes.asSlice(&native), Code.UnsupportedCombination, b"profiles.n.maxMemory = \"1GiB\"")
  let partialPage = run refusedProfile(&manifest, Bytes.asSlice(&partial), Code.InvalidInput, b"profiles.w.maxMemory = \"100000\"")
  let tooLarge = run refusedProfile(&manifest, Bytes.asSlice(&huge), Code.InvalidInput, b"profiles.w.maxMemory = \"5GiB\"")
  run Testing.expect(
    nativeLimit && partialPage && tooLarge,
    "maxMemory is refused outside wasm32, off a 64 KiB page, and above 4 GiB"
  )
}

// Whether `text` is refused for its profile catalog at manifest line `line`.
effect fn refusedProfileLine(manifest: &Path, text: &[u8], line: usize) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let decoded = run Effect.result(Projects.decode(manifest, text))
  return match move decoded {
    Result<Project, ProjectError | OutOfMemoryError>.Success { value: _ } => false
    Result<Project, ProjectError | OutOfMemoryError>.Failure { error } => match move error {
      ProjectError problem => match move problem {
        ProjectError.InvalidProfile { line: written, .. } => written == line
        _ => false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// The build options `values` spell.
effect fn buildOptions(values: &[&[u8]]) -> Options
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let mut arguments = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < values.length {
    run List<Bytes>.append(&mut arguments, run Bytes.copy(values[at]))
    at = at + usize.ONE
  }
  let Build { options } = move run ProjectCommands.parseBuild(List<Bytes>.asSlice(&arguments))
  return move options
}

fn host() -> Target {
  return Target.forId(TargetId.X8664UnknownLinuxGnu)
}

// Whether planning `project` for `values` is refused for a conflicting selection.
effect fn conflicting(project: &Project, values: &[&[u8]]) -> bool
  ! InvalidProjectCommand | TomlError | OutOfMemoryError
  ? &mut Allocator {
  let options = run buildOptions(values)
  let fallback = Projects.targets(project)
  let planned = run Effect.result(ProjectPlans.make(project, &options, fallback, host()))
  return match move planned {
    Result<List<ProjectPlan>, PlanError | TomlError | OutOfMemoryError>.Success { value: _ } => false
    Result<List<ProjectPlan>, PlanError | TomlError | OutOfMemoryError>.Failure { error } => match move error {
      PlanError problem => match move problem {
        PlanError.ConflictingSelection => true
        _ => false
      }
      TomlError malformed => {
        fail move malformed
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// Whether planning `project` for `values` is refused as `--profile-input` that is not JSON, or as
// two selection modes.
effect fn refusedInput(project: &Project, values: &[&[u8]], json: bool) -> bool
  ! InvalidProjectCommand | TomlError | OutOfMemoryError
  ? &mut Allocator {
  let options = run buildOptions(values)
  let planned = run Effect.result(ProjectPlans.make(project, &options, Projects.targets(project), host()))
  return match move planned {
    Result<List<ProjectPlan>, PlanError | TomlError | OutOfMemoryError>.Success { value: _ } => false
    Result<List<ProjectPlan>, PlanError | TomlError | OutOfMemoryError>.Failure { error } => match move error {
      PlanError problem => match move problem {
        PlanError.InvalidProfileInput => json
        PlanError.Profile { code, subject, key: _ } => !json && code == Code.ConflictingBindings
          && same(Bytes.asSlice(&subject), b"profile selection modes")
        _ => false
      }
      TomlError malformed => {
        fail move malformed
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

fn text(value: &Option<Bytes>, expected: &[u8]) -> bool {
  return match &value.* {
    Option<Bytes>.Some { value: written } => same(Bytes.asSlice(&written), expected)
    Option<Bytes>.None => false
  }
}

fn flag(value: &Option<bool>, expected: bool) -> bool {
  return match &value.* {
    Option<bool>.Some { value: written } => written == expected
    Option<bool>.None => false
  }
}

effect fn planPolicy() -> ()
  ! AssertionError<'static> | FileError | ProjectError | PlanError | InvalidProjectCommand | TomlError | OutOfMemoryError
  ? &mut Allocator {
  let manifest = run Path.make("/work/hello/silk.toml")
  let project = run Projects.decode(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nroot = \"main.silk\"\n[build]\ntargets = [\"host\", \"aarch64-unknown-linux-gnu\"]\n[[build.bindings]]\npackage = \"hello@0.1.0\"\nmodule = \"main\"\nparameter = \"limit\"\nvalue = { kind = \"integer\", value = \"7\" }\norigin = { source = \"silk.toml\", provenance = \"literal\" }\n[profiles.fast]\ntarget = \"x86_64-unknown-linux-gnu\"\noptimization = \"speed\"\n[[profiles.fast.bindings]]\npackage = \"hello@0.1.0\"\nmodule = \"main\"\nparameter = \"limit\"\nvalue = { kind = \"integer\", value = \"9\" }\norigin = { source = \"silk.toml\", provenance = \"literal\" }\n"
  )
  let fallback = Projects.targets(&project)
  let none = List<Bytes>.make()
  let Build { options: defaults } = move run ProjectCommands.parseBuild(List<Bytes>.asSlice(&none))
  let targeted = run ProjectPlans.make(&project, &defaults, fallback, host())
  let plans = List<ProjectPlan>.asSlice(&targeted)
  run Testing.expect(
    plans.length == 2 && text(&plans[0].input.target, b"x86_64-unknown-linux-gnu")
      && text(&plans[1].input.target, b"aarch64-unknown-linux-gnu")
      && text(&plans[0].input.optimization, b"none") && flag(&plans[0].input.debug, true),
    "without flags each [build].targets selector is one debug compilation"
  )
  run Testing.expect(
    List<Supplied>.length(&plans[0].bindings) == 1 && List<Supplied>.length(&plans[1].bindings) == 1
      && List<Supplied>.asSlice(&plans[1].bindings)[0].tier == Tier.Project,
    "every target compilation receives the project bindings"
  )
  let releasing = run buildOptions(&[b"--release", b"--target", b"host"])
  let released = run ProjectPlans.make(&project, &releasing, fallback, host())
  let release = List<ProjectPlan>.asSlice(&released)
  run Testing.expect(
    release.length == 1 && text(&release[0].input.optimization, b"speed") && flag(&release[0].input.debug, false)
      && List<Supplied>.length(&release[0].bindings) == 1,
    "--release optimizes without debug information and keeps the project bindings"
  )
  let naming = run buildOptions(&[b"--profile", b"fast"])
  let profiled = run ProjectPlans.make(&project, &naming, fallback, host())
  let profile = List<ProjectPlan>.asSlice(&profiled)
  let ordered = List<Supplied>.asSlice(&profile[0].bindings)
  run Testing.expect(
    profile.length == 1 && text(&profile[0].input.optimization, b"speed") && ordered.length == 2
      && ordered[0].tier == Tier.Project && ordered[1].tier == Tier.Override,
    "a named profile is one compilation with the project bindings before its own"
  )
  let plainDirectory = run Projects.profileDirectory(&release[0].name, b"speed", false)
  let namedDirectory = run Projects.profileDirectory(&profile[0].name, b"speed", false)
  run Testing.expect(
    text(&profile[0].name, b"fast") && same(Bytes.asSlice(&plainDirectory), b"release")
      && same(Bytes.asSlice(&namedDirectory), b"fast"),
    "a named profile builds into its own directory, apart from the optimization directories"
  )
  let targetConflict = run conflicting(&project, &[b"--profile", b"fast", b"--target", b"host"])
  let releaseConflict = run conflicting(&project, &[b"--profile", b"fast", b"--release"])
  let optimizationConflict = run conflicting(&project, &[b"--profile", b"fast", b"--optimization", b"debug"])
  run Testing.expect(
    targetConflict && releaseConflict && optimizationConflict,
    "a named profile conflicts with target and optimization flags"
  )
  let fullInput = b"{\"target\":\"x86_64-unknown-linux-gnu\"}"
  let supplying = run buildOptions(&[b"--profile-input", fullInput])
  let supplied = run ProjectPlans.make(&project, &supplying, fallback, host())
  let full = List<ProjectPlan>.asSlice(&supplied)
  let fullConflict = run conflicting(&project, &[b"--profile-input", fullInput, b"--release"])
  let modes = run refusedInput(&project, &[b"--profile", b"fast", b"--profile-input", fullInput], false)
  let malformed = run refusedInput(&project, &[b"--profile-input", b"{"], true)
  run Testing.expect(
    full.length == 1 && List<Supplied>.length(&full[0].bindings) == 1 && fullConflict && modes && malformed,
    "a full profile replaces the default, conflicts like a named one and must be JSON"
  )
  let artifacts = run Projects.decode(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nroot = \"main.silk\"\n[profiles.obj]\ntarget = \"x86_64-unknown-linux-gnu\"\nartifact = \"object\"\n[profiles.exe]\ntarget = \"x86_64-unknown-linux-gnu\"\nartifact = \"executable\"\n"
  )
  let objectOptions = run buildOptions(&[b"--profile", b"obj"])
  let objectPlanned = run Effect.result(ProjectPlans.make(&artifacts, &objectOptions, fallback, host()))
  let mismatched = match move objectPlanned {
    Result<List<ProjectPlan>, PlanError | TomlError | OutOfMemoryError>.Success { value: _ } => false
    Result<List<ProjectPlan>, PlanError | TomlError | OutOfMemoryError>.Failure { error } => match move error {
      PlanError problem => match move problem {
        PlanError.Profile { code, key, .. } => code == Code.UnsupportedCombination
          && same(Bytes.asSlice(&key), b"profiles.obj.artifact") && Projects.line(&artifacts, Bytes.asSlice(&key)) == usize.add(0, 7)
        _ => false
      }
      TomlError invalid => {
        fail move invalid
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let executableOptions = run buildOptions(&[b"--profile", b"exe"])
  let matching = run ProjectPlans.make(&artifacts, &executableOptions, fallback, host())
  run Testing.expect(
    mismatched && List<ProjectPlan>.length(&matching) == 1,
    "a profile artifact must be the form [build].artifact requests, so an object profile of an executable is refused"
  )
}

// A project as `silk init` writes it names no target, libc or profile, so `run` plans the host with
// the host's default libc: on macOS, the `system` libc the standard-library catalog lists.
effect fn hostDefaultPolicy() -> ()
  ! AssertionError<'static> | FileError | ProjectError | PlanError | InvalidProjectCommand | InitialProfileProblem | TomlError | OutOfMemoryError
  ? &mut Allocator {
  let manifest = run Path.make("/work/hello/silk.toml")
  let project = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0\"\nroot = \"src/main.silk\"\n"
  )
  let none = List<Bytes>.make()
  let Build { options } = move run ProjectCommands.parseBuild(List<Bytes>.asSlice(&none))
  let hostSelector = [run Bytes.copy(b"host")]
  let selectors: &[Bytes] = &hostSelector
  let planned = run ProjectPlans.make(&project, &options, selectors, Target.forId(TargetId.Aarch64AppleDarwin))
  let plans = List<ProjectPlan>.asSlice(&planned)
  let unset = match &plans[0].input.libc {
    Option<Bytes>.Some { .. } => false
    Option<Bytes>.None => true
  }
  let profile = run InitialProfile.freeze(&plans[0].input)
  let libc = match move InitialProfile.text(&profile, b"libc") {
    Option<&[u8]>.Some { value } => same(value, b"system")
    Option<&[u8]>.None => false
  }
  run Testing.expect(
    plans.length == 1 && text(&plans[0].input.target, b"aarch64-apple-darwin") && unset && libc
      && Target.id(InitialProfile.target(&profile)) == TargetId.Aarch64AppleDarwin,
    "an unconfigured project plans the host target, whose default libc the frozen profile selects"
  )
}

test effect fn unconfiguredProjectsBuildForTheHost() -> ()
  ! AssertionError<'static> | FileError | ProjectError | PlanError | InvalidProjectCommand | InitialProfileProblem | TomlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run hostDefaultPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn projectPlansCarryProfilesAndBindings() -> ()
  ! AssertionError<'static> | FileError | ProjectError | PlanError | InvalidProjectCommand | TomlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
