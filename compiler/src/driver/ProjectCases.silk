//! Project manifests decode the TypeScript CLI's fields and place artifacts below the output directory.

import driver.ManifestFields
import driver.ManifestText
import driver.PlatformSupply { Installation, Request as SupplyRequest }
import driver.Project as Projects { Form, Project, ProjectError, SourceSelection, Stage }
import driver.ProjectCommand as ProjectCommands { Build, InvalidProjectCommand, Options }
import driver.ProjectPlan as ProjectPlans { PlanError, ProjectPlan }
import driver.ProjectProfile as ProjectProfiles { Code, InvalidProfile, Profile }
import semantic.InitialProfile { InitialProfile, Problem as InitialProfileProblem }
import semantic.Target { Id as TargetId, Target }
import semantic.ProfileBinding { Field as RecordField, Input as BindingInput, Provenance, Supplied, Tier }
import silk.mem.box { Box }
import silk.json.scanner { JsonError }
import silk.json.value { Json, Value as JsonValue }
import silk.core.option { Option }
import silk.toml.scanner { TomlError }
import silk.collections.list { List }
import silk.collections.bytes { Bytes }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.system.filesystem { FileError, Path }
import silk.core.result { Result }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Whether `text` is refused as an invalid manifest.
effect fn refused(manifest: &Path, text: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let decoded = run Effect.result(Projects.decode(manifest, text))
  return match move decoded {
    Result<Project, ProjectError | OutOfMemoryError>.Success { value: _ } => false
    Result<Project, ProjectError | OutOfMemoryError>.Failure { error } => match move error {
      ProjectError problem => match move problem {
        ProjectError.InvalidManifest { .. } => true
        _ => false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn manifestPolicy() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError
  ? &mut Allocator {
  let manifest = run Path.make("/work/hello/silk.toml")
  let minimal = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\n"
  )
  run Testing.expect(
    same(Projects.name(&minimal), b"hello")
      && same(Path.rawBytes(Projects.entry(&minimal)), b"/work/hello/src/main.silk")
      && same(Path.rawBytes(Projects.directory(&minimal)), b"/work/hello"),
    "the package name and the root entry resolve against the manifest's directory"
  )
  run Testing.expect(
    same(Path.rawBytes(Projects.outputDirectory(&minimal)), b"/work/hello/build")
      && Projects.runnable(&minimal),
    "the output directory defaults to build and the artifact to a final executable"
  )
  let executable = run Projects.artifact(
    &minimal,
    b"aarch64-unknown-linux-gnu",
    Projects.profileName(b"none", true)
  )
  run Testing.expect(
    same(
      Path.rawBytes(&executable),
      b"/work/hello/build/llvm/aarch64-unknown-linux-gnu/debug/hello"
    ),
    "the executable sits at <output-dir>/llvm/<target>/<profile>/<name>"
  )
  let runner = run Projects.testExecutable(&minimal, b"x86_64-unknown-linux-gnu", b"release")
  run Testing.expect(
    same(Path.rawBytes(&runner), b"/work/hello/build/test/llvm/x86_64-unknown-linux-gnu/release/hello"),
    "the test runner sits at <output-dir>/test/llvm/<target>/<profile>/<name>"
  )
  let nested = run Path.make("/work/hello/src/parse/lexer_1.silk")
  let module = match move run Projects.selectSource(&minimal, &nested) {
    SourceSelection.Module { relative } => same(Bytes.asSlice(&relative), b"src/parse/lexer_1.silk")
    SourceSelection.Outside { .. } => false
    SourceSelection.NotModule => false
  }
  let beside = run Path.make("/work/hello/tests/a.silk")
  let prefixed = run Path.make("/work/hello/srcx/a.silk")
  let outside = match move run Projects.selectSource(&minimal, &beside) {
    SourceSelection.Outside { sourceRoot } => same(Path.rawBytes(&sourceRoot), b"/work/hello/src")
    SourceSelection.Module { .. } => false
    SourceSelection.NotModule => false
  }
  let sibling = match move run Projects.selectSource(&minimal, &prefixed) {
    SourceSelection.Outside { .. } => true
    SourceSelection.Module { .. } => false
    SourceSelection.NotModule => false
  }
  let mut odd = 0
  let candidates = [b"/work/hello/src/a.txt", b"/work/hello/src/a b.silk", b"/work/hello/src/.silk", b"/work/hello/src/a.silk.silk"]
  let mut at = usize.ZERO
  while at < 4 {
    let candidate = run Path.fromBytes(candidates[at])
    if let SourceSelection.NotModule = move run Projects.selectSource(&minimal, &candidate) {
      odd = odd + 1
    }
    at = at + usize.ONE
  }
  run Testing.expect(
    module && outside && sibling && odd == 4,
    "a selected test source must be a canonical .silk module path below the root's directory"
  )
  run Testing.expect(
    same(Projects.profileName(b"none", false), b"debug")
      && same(Projects.profileName(b"speed", false), b"release")
      && same(Projects.profileName(b"speed", true), b"release-with-debug")
      && same(Projects.profileName(b"size", false), b"release-size")
      && same(Projects.profileName(b"size", true), b"release-size-with-debug"),
    "profile directories follow the optimization and debug choices"
  )
  let custom = run Projects.decode(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"a-1\"\nsource = \".\"\nkind = \"static-library\"\n[build]\noutput-dir = \"out/./x/../artifacts\"\n"
  )
  run Testing.expect(
    same(Path.rawBytes(Projects.outputDirectory(&custom)), b"/work/hello/out/artifacts")
      && !Projects.runnable(&custom)
      && Projects.form(&custom) == Form.StaticLibrary && Projects.stage(&custom) == Stage.Final,
    "a contained output directory normalizes and a library artifact is not runnable"
  )
  let archive = run Projects.artifact(&custom, b"x86_64-unknown-linux-gnu", b"release")
  let shared = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \".\"\nkind = \"shared-library\"\n"
  )
  let linux = run Projects.artifact(&shared, b"x86_64-unknown-linux-gnu", b"debug")
  let darwin = run Projects.artifact(&shared, b"aarch64-apple-darwin", b"debug")
  run Testing.expect(
    same(Path.rawBytes(&archive), b"/work/hello/out/artifacts/llvm/x86_64-unknown-linux-gnu/release/liba-1.a")
      && same(Path.rawBytes(&linux), b"/work/hello/build/llvm/x86_64-unknown-linux-gnu/debug/libhello.so")
      && same(Path.rawBytes(&darwin), b"/work/hello/build/llvm/aarch64-apple-darwin/debug/libhello.dylib"),
    "library artifacts are named as the TypeScript CLI names them"
  )
  let staged = run Projects.decode(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nsource = \".\"\n[build]\nstage = \"llvm-ir\"\n"
  )
  run Testing.expect(
    !Projects.runnable(&staged) && Projects.form(&staged) == Form.Executable && Projects.stage(&staged) == Stage.LlvmIr,
    "an intermediate emission stage is not runnable"
  )
  let irFile = run Projects.artifact(&staged, b"x86_64-unknown-linux-gnu", b"debug")
  run Testing.expect(
    same(Path.rawBytes(&irFile), b"/work/hello/build/llvm/x86_64-unknown-linux-gnu/debug/hello.ll"),
    "an intermediate stage names its representation"
  )
  let defaultTargets = Projects.targets(&minimal)
  let targeted = run Projects.decode(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nsource = \".\"\n[build]\ntargets = [\"x86_64-unknown-linux-gnu\", \"host\"]\n"
  )
  let declared = Projects.targets(&targeted)
  run Testing.expect(
    defaultTargets.length == 1 && same(Bytes.asSlice(&defaultTargets[0]), b"host") && declared.length == 2
      && same(Bytes.asSlice(&declared[0]), b"x86_64-unknown-linux-gnu") && same(Bytes.asSlice(&declared[1]), b"host"),
    "build targets default to the host and keep their declared order"
  )
  let noTargets = run refused(&manifest, b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nsource = \".\"\n[build]\ntargets = []\n")
  let unknownTarget = run refused(&manifest, b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nsource = \".\"\n[build]\ntargets = [\"mips\"]\n")
  let scalarTargets = run refused(&manifest, b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nsource = \".\"\n[build]\ntargets = \"host\"\n")
  run Testing.expect(noTargets && unknownTarget && scalarTargets, "build targets must be a non-empty array of known selectors")
  let names = run refused(&manifest, b"[package]\nversion = \"0.1.0\"\nname = \"Hello\"\nsource = \".\"\n")
  let leading = run refused(&manifest, b"[package]\nversion = \"0.1.0\"\nname = \"1x\"\nsource = \".\"\n")
  let unnamed = run refused(&manifest, b"[package]\nversion = \"0.1.0\"\nsource = \".\"\n")
  let reservedSelf = run refused(&manifest, b"[package]\nversion = \"0.1.0\"\nname = \"self\"\nsource = \".\"\n")
  let reservedSilk = run refused(&manifest, b"[package]\nname = \"silk\"\n")
  let reservedSilkc = run refused(&manifest, b"[package]\nname = \"silkc\"\n")
  let reservedName = reservedSelf && reservedSilk && reservedSilkc
  run Testing.expect(names && leading && unnamed && reservedName, "a package name must be portable and not self, silk or silkc")
  let emptyRoot = run refused(&manifest, b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nsource = \".\"\nmain = \"\"\n")
  run Testing.expect(emptyRoot, "a written root must be a non-empty string")
  let escaping = run refused(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nsource = \".\"\n[build]\noutput-dir = \"a/../../b\"\n"
  )
  let absolute = run refused(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nsource = \".\"\n[build]\noutput-dir = \"/tmp/out\"\n"
  )
  let drive = run refused(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nsource = \".\"\n[build]\noutput-dir = \"C:\\\\out\"\n"
  )
  let empty = run refused(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nsource = \".\"\n[build]\noutput-dir = \"\"\n"
  )
  run Testing.expect(
    escaping && absolute && drive && empty,
    "the output directory must stay inside the project"
  )
  let artifact = run refused(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nsource = \".\"\nkind = \"wasm\"\n"
  )
  let stage = run refused(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nsource = \".\"\n[build]\nstage = \"binary\"\n"
  )
  let malformed = run refused(&manifest, b"[package\nname = \"hello\"\n")
  let badVersion = run refused(&manifest, b"[package]\nname = \"hello\"\nversion = \"1.0\"\nsource = \".\"\n")
  let versionRefused = run refused(&manifest, b"[package]\nname = \"hello\"\nsource = \".\"\n")
  let missingVersion = !versionRefused
  let unknownBuild = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \".\"\n[build]\nlinker = \"ld\"\n"
  )
  let scalarBuild = run refused(&manifest, b"build = 3\n[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \".\"\n")
  let supply = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \".\"\n[native]\nplatform-supply = \"system\"\n"
  )
  let packageless = run refused(&manifest, b"[build]\nstage = \"final\"\n")
  run Testing.expect(
    badVersion && missingVersion && unknownBuild && scalarBuild && supply && packageless,
    "a manifest needs a [package] table, a written version must be semantic, and unknown build fields are refused"
  )
  let recorded = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsilk-version = \"2.7.1-rc.1\"\nsource = \".\"\n"
  )
  let partialRelease = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsilk-version = \"2.7\"\nsource = \".\"\n"
  )
  let numericRelease = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsilk-version = 2\nsource = \".\"\n"
  )
  run Testing.expect(
    !recorded && partialRelease && numericRelease,
    "an optional silk-version records the creating compiler's release as a semantic version"
  )
  let explicit = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \".\"\n[native.platform-supply]\nkind = \"explicit\"\ntarget = \"x86_64-unknown-linux-gnu\"\nroot = \"sysroot\"\nlinker = \"/tools/ld.lld\"\nsupport = [{ root = \"../gcc\", target = \"x86_64-unknown-linux-gnu\", origin = \"gcc 13\" }]\n"
  )
  let mut explicitOk = false
  let explicitSupply = Projects.supply(&explicit)
  if let SupplyRequest.Explicit { target, root, linker, origin, support } = &explicitSupply.* {
    let installations = List<Installation>.asSlice(&support)
    explicitOk = same(Bytes.asSlice(&target), b"x86_64-unknown-linux-gnu")
      && same(Path.rawBytes(&root), b"/work/hello/sysroot") && same(Path.rawBytes(&linker), b"/tools/ld.lld")
      && same(Bytes.asSlice(&origin), b"/work/hello/silk.toml:native.platform-supply") && installations.length == 1
      && same(Path.rawBytes(&installations[0].root), b"/work/gcc")
  }
  let managed = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \".\"\n[native.platform-supply]\nkind = \"managed\"\nname = \"silk-sdk\"\n"
  )
  let mut managedOk = false
  let managedSupply = Projects.supply(&managed)
  if let SupplyRequest.Managed { name } = &managedSupply.* {
    managedOk = same(Bytes.asSlice(&name), b"silk-sdk")
  }
  let mut automaticOk = false
  let minimalSupply = Projects.supply(&minimal)
  if let SupplyRequest.Automatic = &minimalSupply.* {
    automaticOk = true
  }
  run Testing.expect(
    explicitOk && managedOk && automaticOk,
    "a platform-supply table decodes with paths against the manifest's directory, and its absence is automatic"
  )
  let extraKey = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \".\"\n[native.platform-supply]\nkind = \"native\"\nname = \"x\"\n"
  )
  let foreignSupply = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \".\"\n[native.platform-supply]\nkind = \"explicit\"\ntarget = \"wasm32\"\nroot = \"/s\"\nlinker = \"/l\"\n"
  )
  run Testing.expect(extraKey && foreignSupply, "a platform-supply table with extra keys or an unsupported target is refused")
  let rooted = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \".\"\nmain = \"src/app/main.silk\"\n"
  )
  let testsFile = run Path.make("/work/hello/tests/a.silk")
  let rootedModule = match move run Projects.selectSource(&rooted, &testsFile) {
    SourceSelection.Module { relative } => same(Bytes.asSlice(&relative), b"tests/a.silk")
    SourceSelection.Outside { .. } => false
    SourceSelection.NotModule => false
  }
  let above = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \"..\"\nmain = \"hello/main.silk\"\n"
  )
  let sharedFile = run Path.make("/work/shared/a.silk")
  let aboveModule = match move run Projects.selectSource(&above, &sharedFile) {
    SourceSelection.Module { relative } => same(Bytes.asSlice(&relative), b"../shared/a.silk")
    SourceSelection.Outside { .. } => false
    SourceSelection.NotModule => false
  }
  run Testing.expect(
    same(Path.rawBytes(Projects.sourceRoot(&rooted)), b"/work/hello") && same(Path.rawBytes(Projects.sourceRoot(&minimal)), b"/work/hello/src")
      && same(Path.rawBytes(Projects.sourceRoot(&above)), b"/work") && rootedModule && aboveModule,
    "package.source resolves against the manifest's directory and selects sources below it, relative to the project"
  )
  let besideRoot = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nmain = \"../main.silk\"\n"
  )
  let emptySourceRoot = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \"\"\n"
  )
  let scalarRoot = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = 3\n"
  )
  let requirements = run refused(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \".\"\n[unstable]\ncomposition = { requirements = [{ kind = \"prebuilt-object\", name = \"support\" }] }\n"
  )
  let retention = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \".\"\n[unstable]\ncomposition = { retention = [{ module = \"support\", declaration = \"keep\" }] }\n"
  )
  let emptyLists = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \".\"\n[unstable]\ncomposition = { requirements = [], retention = [] }\n"
  )
  run Testing.expect(
    requirements && same(Projects.name(&retention), b"hello") && same(Projects.name(&emptyLists), b"hello"),
    "a composition naming native requirements is refused until native builds resolve them; retention roots decode"
  )
  let workspaceOnly = run refused(&manifest, b"[workspace]\nmembers = [\"app\"]\n")
  run Testing.expect(
    workspaceOnly,
    "a manifest that only defines a workspace is not a project a command can build"
  )
  run Testing.expect(
    besideRoot && emptySourceRoot && scalarRoot,
    "package.source must be a non-empty string with main below it"
  )
  run Testing.expect(
    Projects.isSemanticVersion(b"1.2.3") && Projects.isSemanticVersion(b"0.0.0-alpha.1+build.7")
      && Projects.isSemanticVersion(b"1.0.0-0a.x-y") && !Projects.isSemanticVersion(b"01.2.3")
      && !Projects.isSemanticVersion(b"1.2") && !Projects.isSemanticVersion(b"1.2.3-01")
      && !Projects.isSemanticVersion(b"1.2.3-") && !Projects.isSemanticVersion(b"1.2.3+a..b"),
    "semantic versions follow the TypeScript pattern"
  )
  run Testing.expect(
    artifact && stage && malformed,
    "unknown artifacts, stages and malformed TOML are refused"
  )
}

// Whether `text` is refused as an invalid manifest with `detail` at manifest line `line`.
effect fn refusedAt(manifest: &Path, text: &[u8], detail: &[u8], line: usize) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let decoded = run Effect.result(Projects.decode(manifest, text))
  return match move decoded {
    Result<Project, ProjectError | OutOfMemoryError>.Success { value: _ } => false
    Result<Project, ProjectError | OutOfMemoryError>.Failure { error } => match move error {
      ProjectError problem => match move problem {
        ProjectError.InvalidManifest { line: written, detail: refused, .. } => written == line
          && same(Bytes.asSlice(&refused), detail)
        _ => false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn fieldPolicy() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError
  ? &mut Allocator {
  let manifest = run Path.make("/work/hello/silk.toml")
  let header = b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsource = \".\"\n"
  let mut topLevel = run Bytes.copy(b"foo = 1\n")
  run Bytes.append(&mut topLevel, header)
  let mut packaged = run Bytes.copy(header)
  run Bytes.append(&mut packaged, b"descripton = \"x\"\n")
  let mut misspelled = run Bytes.copy(header)
  run Bytes.append(&mut misspelled, b"\n[packge]\nname = \"x\"\n")
  let mut dependency = run Bytes.copy(header)
  run Bytes.append(&mut dependency, b"\n[dependencies]\ngreeting = { path = \"../greeting\", version = \"1\" }\n")
  let mut dependencyTable = run Bytes.copy(header)
  run Bytes.append(&mut dependencyTable, b"[dependencies.greeting]\npath = \"../greeting\"\nversion = \"1\"\n")
  let mut built = run Bytes.copy(header)
  run Bytes.append(&mut built, b"[build]\nartefact = \"object\"\n")
  let top = run refusedAt(&manifest, Bytes.asSlice(&topLevel), b"foo is not a supported field", usize.ONE)
  let package = run refusedAt(&manifest, Bytes.asSlice(&packaged), b"package.descripton is not a supported field; did you mean package.description?", usize.add(0, 5))
  let table = run refusedAt(&manifest, Bytes.asSlice(&misspelled), b"packge is not a supported field; did you mean package?", usize.add(0, 6))
  let inline = run refusedAt(
    &manifest,
    Bytes.asSlice(&dependency),
    b"dependencies.greeting.version is not supported yet; a dependency takes only path, git, rev and package",
    usize.add(0, 7)
  )
  let headed = run refusedAt(
    &manifest,
    Bytes.asSlice(&dependencyTable),
    b"dependencies.greeting.version is not supported yet; a dependency takes only path, git, rev and package",
    usize.add(0, 7)
  )
  let build = run refusedAt(&manifest, Bytes.asSlice(&built), b"build.artefact is not a supported field", usize.add(0, 6))
  let mut composed = run Bytes.copy(header)
  run Bytes.append(&mut composed, b"[unstable]\ncomposition = { runtimes = [], defaults = [], bogus = 1 }\n")
  let composition = run refusedAt(
    &manifest,
    Bytes.asSlice(&composed),
    b"unstable.composition.bogus is not a supported field",
    usize.add(0, 6)
  )
  run Testing.expect(
    top && package && table && inline && headed && build && composition,
    "unknown top-level, [package], dependency, [build] and [unstable].composition fields are refused at their line"
  )
  // Composition entries take only the fields a build reads, located even inside a multi-line
  // inline array, and the refused `requirements` is located too.
  let mut runtimeEntry = run Bytes.copy(header)
  run Bytes.append(
    &mut runtimeEntry,
    b"[unstable]\ncomposition = { runtimes = [{ name = \"s\", module = \"m\", bogus = 1 }], defaults = [\"s\"] }\n"
  )
  let mut retained = run Bytes.copy(header)
  run Bytes.append(
    &mut retained,
    b"[unstable]\ncomposition = { runtimes = [\n  { name = \"s\", module = \"m\" },\n], retention = [\n  { module = \"m\", declaration = \"d\", extra = 1 },\n] }\n"
  )
  let mut bound = run Bytes.copy(header)
  run Bytes.append(
    &mut bound,
    b"[unstable]\ncomposition = { components = [{ capability = \"execution-storage\", bindings = [{ operation = \"create\", module = \"m\", declaration = \"d\", bogus = 1 }] }] }\n"
  )
  let mut capability = run Bytes.copy(header)
  run Bytes.append(&mut capability, b"[[unstable.composition.components]]\ncapability = \"execution-storage\"\nbogus = 1\n")
  let mut named = run Bytes.copy(header)
  run Bytes.append(&mut named, b"[unstable]\ncomposition = { runtimes = [], defaults = [{ name = \"s\" }] }\n")
  let mut required = run Bytes.copy(header)
  run Bytes.append(&mut required, b"[unstable]\ncomposition = { runtimes = [], requirements = [\"x\"] }\n")
  let mut unlisted = run Bytes.copy(header)
  run Bytes.append(
    &mut unlisted,
    b"[unstable]\ncomposition = { runtimes = [\n  { name = \"start\", module = \"m\" },\n  { name = \"other\", module = \"m\" },\n], defaults = [\n  \"start\",\n  \"missing\",\n] }\n"
  )
  let mut unlistedNone = run Bytes.copy(header)
  run Bytes.append(&mut unlistedNone, b"[unstable]\ncomposition = { defaults = [\"start\"] }\n")
  let runtimeField = run refusedAt(
    &manifest,
    Bytes.asSlice(&runtimeEntry),
    b"unstable.composition.runtimes.bogus is not a supported field",
    usize.add(0, 6)
  )
  let retentionField = run refusedAt(
    &manifest,
    Bytes.asSlice(&retained),
    b"unstable.composition.retention.extra is not a supported field",
    usize.add(0, 9)
  )
  let bindingField = run refusedAt(
    &manifest,
    Bytes.asSlice(&bound),
    b"unstable.composition.components.bindings.bogus is not a supported field",
    usize.add(0, 6)
  )
  let componentField = run refusedAt(
    &manifest,
    Bytes.asSlice(&capability),
    b"unstable.composition.components.bogus is not a supported field",
    usize.add(0, 7)
  )
  let defaultEntry = run refusedAt(
    &manifest,
    Bytes.asSlice(&named),
    b"unstable.composition.defaults entries must be runtime names",
    usize.add(0, 6)
  )
  let requirements = run refusedAt(
    &manifest,
    Bytes.asSlice(&required),
    b"unstable.composition.requirements is not supported by the native compiler yet",
    usize.add(0, 6)
  )
  let unlistedDefault = run refusedAt(
    &manifest,
    Bytes.asSlice(&unlisted),
    b"unstable.composition.defaults entry \"missing\" names no runtime in unstable.composition.runtimes; it lists \"start\", \"other\"",
    usize.add(0, 11)
  )
  let unlistedRuntimes = run refusedAt(
    &manifest,
    Bytes.asSlice(&unlistedNone),
    b"unstable.composition.defaults entry \"start\" names no runtime in unstable.composition.runtimes; it lists none",
    usize.add(0, 6)
  )
  run Testing.expect(unlistedDefault && unlistedRuntimes, "a default that names no listed runtime is refused at its entry")
  run Testing.expect(
    runtimeField && retentionField && bindingField && componentField && defaultEntry && requirements,
    "unknown composition entry fields, a non-name default and requirements are refused at their line"
  )
  // An entry's field is located in that entry, not at an earlier line writing the same name, and
  // the n-th entry by its index; an unsupported capability and platform-supply fields are refused.
  let mut shadowed = run Bytes.copy(header)
  run Bytes.append(
    &mut shadowed,
    b"[unstable]\ncomposition = { retention = [\n  { module = \"m\", declaration = \"d\" },\n], runtimes = [\n  { name = \"s\", module = \"m\", declaration = \"d\" },\n] }\n"
  )
  let mut second = run Bytes.copy(header)
  run Bytes.append(
    &mut second,
    b"[unstable]\ncomposition = { runtimes = [\n  { name = \"a\", module = \"m\" },\n  { name = \"b\", module = \"m\", bogus = 1 },\n] }\n"
  )
  let mut tabled = run Bytes.copy(header)
  run Bytes.append(
    &mut tabled,
    b"[[unstable.composition.runtimes]]\nname = \"a\"\nmodule = \"m\"\n[[unstable.composition.runtimes]]\nname = \"b\"\nmodule = \"m\"\nbogus = 1\n"
  )
  let mut capable = run Bytes.copy(header)
  run Bytes.append(&mut capable, b"[unstable]\ncomposition = { components = [{ capability = \"other\", bindings = [] }] }\n")
  let mut supplied = run Bytes.copy(header)
  run Bytes.append(&mut supplied, b"[native]\nplatform-supply = { kind = \"native\", bogus = 1 }\n")
  let mut supported = run Bytes.copy(header)
  run Bytes.append(
    &mut supported,
    b"[native]\nplatform-supply = { kind = \"explicit\", target = \"x86_64-unknown-linux-gnu\", root = \"r\", linker = \"l\", support = [\n  { root = \"s\", target = \"x86_64-unknown-linux-gnu\", origin = \"o\", bogus = 1 },\n] }\n"
  )
  let shadowedField = run refusedAt(
    &manifest,
    Bytes.asSlice(&shadowed),
    b"unstable.composition.runtimes.declaration is not a supported field",
    usize.add(0, 9)
  )
  let secondField = run refusedAt(
    &manifest,
    Bytes.asSlice(&second),
    b"unstable.composition.runtimes.bogus is not a supported field",
    usize.add(0, 8)
  )
  let tabledField = run refusedAt(
    &manifest,
    Bytes.asSlice(&tabled),
    b"unstable.composition.runtimes.bogus is not a supported field",
    usize.add(0, 11)
  )
  let capabilityValue = run refusedAt(
    &manifest,
    Bytes.asSlice(&capable),
    b"unstable.composition.components.capability = \"other\" is not supported by the native compiler; the only capability is \"execution-storage\"",
    usize.add(0, 6)
  )
  let supplyField = run refusedAt(
    &manifest,
    Bytes.asSlice(&supplied),
    b"native.platform-supply.bogus is not a supported field",
    usize.add(0, 6)
  )
  let supportField = run refusedAt(
    &manifest,
    Bytes.asSlice(&supported),
    b"native.platform-supply.support.bogus is not a supported field",
    usize.add(0, 7)
  )
  run Testing.expect(
    shadowedField && secondField && tabledField && capabilityValue && supplyField && supportField,
    "entry fields are located in their own entry; capabilities and platform-supply fields are checked"
  )
  let mut operated = run Bytes.copy(header)
  run Bytes.append(
    &mut operated,
    b"[unstable]\ncomposition = { components = [{ capability = \"execution-storage\", bindings = [\n  { operation = \"create\", module = \"m\", declaration = \"c\" },\n  { operation = \"frobnicate\", module = \"m\", declaration = \"f\" },\n] }] }\n"
  )
  let operation = run refusedAt(
    &manifest,
    Bytes.asSlice(&operated),
    b"unstable.composition.components.bindings.operation = \"frobnicate\" is not an operation; use create, acquire, release or destroy",
    usize.add(0, 8)
  )
  run Testing.expect(operation, "an unknown execution-storage operation is refused at its line")
  let mut unnamed = run Bytes.copy(header)
  run Bytes.append(
    &mut unnamed,
    b"[unstable]\ncomposition = { components = [{ capability = \"execution-storage\", bindings = [\n  { operation = \"create\", module = \"m\", declaration = \"c\" },\n  { module = \"m\", declaration = \"f\" },\n] }] }\n"
  )
  let mut numbered = run Bytes.copy(header)
  run Bytes.append(
    &mut numbered,
    b"[unstable]\ncomposition = { components = [{ capability = \"execution-storage\", bindings = [\n  { operation = \"create\", module = \"m\", declaration = \"c\" },\n  { operation = 3, module = \"m\", declaration = \"f\" },\n] }] }\n"
  )
  let missingOperation = run refusedAt(
    &manifest,
    Bytes.asSlice(&unnamed),
    b"unstable.composition.components.bindings entry has no operation; use create, acquire, release or destroy",
    usize.add(0, 8)
  )
  let typedOperation = run refusedAt(
    &manifest,
    Bytes.asSlice(&numbered),
    b"unstable.composition.components.bindings.operation must be a string: create, acquire, release or destroy",
    usize.add(0, 8)
  )
  run Testing.expect(missingOperation && typedOperation, "a missing or non-string operation is refused at its entry")
  let mut known = run Bytes.copy(header)
  run Bytes.append(
    &mut known,
    b"silk-version = \"0.1.0\"\nmain = \"main.silk\"\nexports = []\n[dependencies]\nlib = { path = \"../lib\", package = \"lib\" }\n[release]\nrepository = \"silk-lang/silk\"\n"
  )
  let accepted = run Projects.decode(&manifest, Bytes.asSlice(&known))
  run Testing.expect(same(Projects.name(&accepted), b"hello"), "every field a build or `silk change` reads is accepted")
  let text = b"top = 1\n[a.b]\n  # c = 0\n  c = 2\nd = { e = 3 }\n[[f]]\ng = 4\n"
  run Testing.expect(
    ManifestText.keyLine(text, b"top") == usize.ONE && ManifestText.keyLine(text, b"a.b.c") == usize.add(0, 4)
      && ManifestText.keyLine(text, b"a.b.d.e") == usize.add(0, 5) && ManifestText.keyLine(text, b"a.b.x") == usize.add(0, 2)
      && ManifestText.keyLine(text, b"f.g") == usize.add(0, 7) && ManifestText.keyLine(text, b"missing") == usize.ZERO,
    "a key's line is its own line, else the line of the innermost table holding it"
  )
}

effect fn layoutPolicy() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError
  ? &mut Allocator {
  let manifest = run Path.make("/work/hello/silk.toml")
  let bare = run Projects.decode(&manifest, b"[package]\nname = \"hello_world\"\n")
  run Testing.expect(
    same(Path.rawBytes(Projects.sourceRoot(&bare)), b"/work/hello/src")
      && same(Path.rawBytes(Projects.entry(&bare)), b"/work/hello/src/main.silk")
      && Projects.form(&bare) == Form.Executable && Projects.runnable(&bare),
    "a name alone is a package: source src, main main.silk, an executable, version 0.0.0"
  )
  let library = run Projects.decode(&manifest, b"[package]\nname = \"hello\"\nkind = \"library\"\nexports = [\"lib\"]\n")
  run Testing.expect(
    same(Path.rawBytes(Projects.entry(&library)), b"/work/hello/src/lib.silk")
      && Projects.form(&library) == Form.Library && !Projects.runnable(&library),
    "a library's root module defaults to lib.silk, and a library is not runnable"
  )
  let placed = run Projects.decode(&manifest, b"[package]\nname = \"hello\"\nsource = \".\"\nmain = \"app/start.silk\"\nkind = \"static-library\"\n")
  run Testing.expect(
    same(Path.rawBytes(Projects.sourceRoot(&placed)), b"/work/hello")
      && same(Path.rawBytes(Projects.entry(&placed)), b"/work/hello/app/start.silk")
      && Projects.form(&placed) == Form.StaticLibrary,
    "main resolves below source, and kind selects the artifact"
  )
  let escaping = run refused(&manifest, b"[package]\nname = \"hello\"\nmain = \"../main.silk\"\n")
  let emptyMain = run refused(&manifest, b"[package]\nname = \"hello\"\nmain = \"\"\n")
  let scalarSource = run refused(&manifest, b"[package]\nname = \"hello\"\nsource = 3\n")
  let badKind = run refused(&manifest, b"[package]\nname = \"hello\"\nkind = \"binary\"\n")
  run Testing.expect(escaping && emptyMain && scalarSource && badKind, "main stays below source, and source, main and kind must be valid")
  let earlierRoot = run refusedAt(
    &manifest,
    b"[package]\nname = \"hello\"\nroot = \"src/main.silk\"\n",
    b"package.root is an earlier spelling; write package.source for the import root and package.main for the root module below it",
    usize.add(0, 3)
  )
  let earlierSource = run refusedAt(
    &manifest,
    b"[package]\nname = \"hello\"\nsource-root = \"src\"\n",
    b"package.source-root is an earlier spelling; write package.source",
    usize.add(0, 3)
  )
  let earlierKind = run refusedAt(
    &manifest,
    b"[package]\nname = \"hello\"\n[build]\nartifact = \"executable\"\n",
    b"build.artifact is an earlier spelling; write package.kind",
    usize.add(0, 4)
  )
  let earlierLink = run refusedAt(
    &manifest,
    b"[package]\nname = \"hello\"\n[build]\nnative-link-inputs = []\n",
    b"build.native-link-inputs is an earlier spelling; write native.link",
    usize.add(0, 4)
  )
  let earlierSupply = run refusedAt(
    &manifest,
    b"[package]\nname = \"hello\"\n[build]\nplatform-supply = { kind = \"automatic\" }\n",
    b"build.platform-supply is an earlier spelling; write native.platform-supply",
    usize.add(0, 4)
  )
  let earlierComposition = run refusedAt(
    &manifest,
    b"[package]\nname = \"hello\"\n[build]\ncomposition = { runtimes = [] }\n",
    b"build.composition is an earlier spelling; write unstable.composition",
    usize.add(0, 4)
  )
  let earlierBindings = run refusedAt(
    &manifest,
    b"[package]\nname = \"hello\"\n[[build.bindings]]\nparameter = \"n\"\n",
    b"build.bindings is an earlier spelling; write config, as config.main.limit = 42",
    usize.add(0, 3)
  )
  run Testing.expect(
    earlierRoot && earlierSource && earlierKind && earlierLink && earlierSupply && earlierComposition && earlierBindings,
    "an earlier spelling of a field is refused at its line, naming the field that replaced it"
  )
  let reservedTable = run refusedAt(&manifest, b"[package]\nname = \"hello\"\n[dev-dependencies]\nx = { path = \"x\" }\n", b"dev-dependencies is not supported yet", usize.add(0, 3))
  let reservedField = run refusedAt(&manifest, b"[package]\nname = \"hello\"\ninclude = [\"src\"]\n", b"package.include is not supported yet", usize.add(0, 3))
  let reservedSource = run refusedAt(&manifest, b"[package]\nname = \"hello\"\n[dependencies]\nx = { url = \"https://example.com/x.tar.gz\" }\n", b"dependencies.x.url is not supported yet; a dependency takes only path, git, rev and package", usize.add(0, 4))
  let reservedTag = run refusedAt(&manifest, b"[package]\nname = \"hello\"\n[dependencies]\nx = { git = \"/r\", tag = \"v1\" }\n", b"dependencies.x.tag is not supported yet; a dependency takes only path, git, rev and package; pin a git dependency to a full commit hash with rev", usize.add(0, 4))
  run Testing.expect(reservedTable && reservedField && reservedSource && reservedTag, "reserved tables and fields are refused as not supported yet")
  let described = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\ndescription = \"d\"\nlicense = \"MIT\"\nrepository = \"r\"\nhomepage = \"h\"\nreadme = \"README.md\"\nauthors = [\"a\"]\nkeywords = []\n[tool.editor]\nanything = { goes = 1 }\n[native]\nlink = []\nplatform-supply = { kind = \"automatic\" }\n"
  )
  run Testing.expect(same(Projects.name(&described), b"hello"), "publishing metadata, [tool] and [native] are accepted")
  let listedAuthor = run refusedAt(&manifest, b"[package]\nname = \"hello\"\nauthors = \"a\"\n", b"package.authors must be an array of strings", usize.add(0, 3))
  let numberedLicense = run refusedAt(&manifest, b"[package]\nname = \"hello\"\nlicense = 1\n", b"package.license must be a string", usize.add(0, 3))
  let unknownNative = run refusedAt(&manifest, b"[package]\nname = \"hello\"\n[native]\nflags = []\n", b"native.flags is not a supported field", usize.add(0, 4))
  run Testing.expect(listedAuthor && numberedLicense && unknownNative, "metadata has its shape, and [native] takes only its fields")
  run Testing.expect(
    ManifestFields.compatible(b"0.3.4", b"0.3.2") && !ManifestFields.compatible(b"0.3.1", b"0.3.2")
      && !ManifestFields.compatible(b"0.4.0", b"0.3.2") && ManifestFields.compatible(b"1.5.0", b"1.2.9")
      && !ManifestFields.compatible(b"2.0.0", b"1.2.0") && !ManifestFields.compatible(b"1.2.3", b"1.2.4")
      && ManifestFields.compatible(b"0.0.0", b"0.9.0") && ManifestFields.compatible(b"0.3.0", b"0.0.0"),
    "a dependency's silk-version names its release line: same minor before 1.0, same major after, never older"
  )
  run Testing.expect(
    ManifestFields.compatible(b"0.2.0-dev.11+abc", b"0.2.0-dev.11") && ManifestFields.compatible(b"0.2.0-dev.11+abc", b"0.2.0-dev.11+abc")
      && !ManifestFields.compatible(b"0.2.0-dev.11+abc", b"0.2.0-dev.11+def") && !ManifestFields.compatible(b"0.2.0-dev.12", b"0.2.0-dev.11")
      && !ManifestFields.compatible(b"0.2.0-dev.11", b"0.2.0") && !ManifestFields.compatible(b"0.2.0", b"0.2.0-dev.11"),
    "a dev release matches only itself, and a dev compiler builds only dependencies written for it"
  )
  run Testing.expect(
    ManifestFields.isPrerelease(b"0.2.0-dev.11+abc") && ManifestFields.isPrerelease(b"0.2.0-dev.11")
      && !ManifestFields.isPrerelease(b"0.2.0") && !ManifestFields.isPrerelease(b"0.2.0+abc"),
    "a prerelease is a version with a label after its patch"
  )
}

// Value and syntax refusals name the line, echo what was written and give the TOML parser's reason.
effect fn valuePolicy() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError
  ? &mut Allocator {
  let manifest = run Path.make("/work/hello/silk.toml")
  let unquoted = run refusedAt(
    &manifest,
    b"[package]\nname = p\n",
    b"the manifest is not valid TOML: a value must be a quoted string, a number, a boolean, an array or an inline table",
    usize.add(0, 2)
  )
  let unclosed = run refusedAt(
    &manifest,
    b"[package\nname = \"p\"\n",
    b"the manifest is not valid TOML: the line ends before its table header, key or value is complete",
    usize.ONE
  )
  let twice = run refusedAt(
    &manifest,
    b"[package]\nname = \"p\"\nname = \"q\"\n",
    b"the manifest is not valid TOML: `name` is written twice",
    usize.add(0, 3)
  )
  let json = run refusedAt(&manifest, b"{\"package\": {}}\n", b"the manifest is not valid TOML: unexpected `{`", usize.ONE)
  run Testing.expect(unquoted && unclosed && twice && json, "a manifest that is not TOML is refused at the parser's line, with its reason")
  let version = run refusedAt(
    &manifest,
    b"[package]\nname = \"p\"\nversion = \"1.0\"\n",
    b"package.version \"1.0\" is not a semantic version; write MAJOR.MINOR.PATCH, as 1.0.0",
    usize.add(0, 3)
  )
  let worded = run refusedAt(
    &manifest,
    b"[package]\nname = \"p\"\nsilk-version = \"latest\"\n",
    b"package.silk-version \"latest\" is not a semantic version; write MAJOR.MINOR.PATCH, as 1.0.0",
    usize.add(0, 3)
  )
  let numbered = run refusedAt(
    &manifest,
    b"[package]\nname = \"p\"\nversion = 1\n",
    b"package.version must be a string, as \"1.0.0\"",
    usize.add(0, 3)
  )
  run Testing.expect(version && worded && numbered, "a version that is not semantic is echoed at its line, completed when only parts are missing")
  let named = run refusedAt(
    &manifest,
    b"[package]\nname = \"MyApp\"\n",
    b"package.name \"MyApp\" is not a package name: it must start with a lowercase letter and contain only lowercase letters, digits, underscores, or hyphens, and must not be self, silk or silkc",
    usize.add(0, 2)
  )
  let missing = run refusedAt(
    &manifest,
    b"[package]\nversion = \"1.0.0\"\n",
    b"package.name is missing; name the package, as name = \"app\"",
    usize.ONE
  )
  let kind = run refusedAt(
    &manifest,
    b"[package]\nname = \"p\"\nkind = \"lib\"\n",
    b"package.kind \"lib\" is not a package kind; write executable, library, static-library, shared-library, or object",
    usize.add(0, 3)
  )
  run Testing.expect(named && missing && kind, "name and kind refusals echo the value at its line, and a missing name says so")
  let transposed = run refusedAt(
    &manifest,
    b"[package]\nnmae = \"p\"\n",
    b"package.nmae is not a supported field; did you mean package.name?",
    usize.add(0, 2)
  )
  let singular = run refusedAt(
    &manifest,
    b"[package]\nname = \"p\"\n\n[dependency]\nutil = { path = \"../util\" }\n",
    b"dependency is not a supported field; did you mean dependencies?",
    usize.add(0, 4)
  )
  let swapped = run ManifestText.distance(b"nmae", b"name")
  let plural = run ManifestText.distance(b"dependency", b"dependencies")
  let empty = run ManifestText.distance(b"", b"abc")
  run Testing.expect(
    transposed && singular && swapped == usize.ONE && plural == usize.add(0, 3) && empty == usize.add(0, 3),
    "an unknown key close to a supported one names it"
  )
}

test effect fn manifestValueAndSyntaxErrorsNameTheirLine() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run valuePolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn manifestLayoutUsesSourceMainAndKind() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run layoutPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn unknownManifestFieldsAreRefusedAtTheirLine() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run fieldPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn projectManifestsDecodeAndPlaceArtifacts() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run manifestPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Whether `text` is refused for its profile catalog with `code` and `subject`.
effect fn refusedProfile(manifest: &Path, text: &[u8], code: Code, subject: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let decoded = run Effect.result(Projects.decode(manifest, text))
  return match move decoded {
    Result<Project, ProjectError | OutOfMemoryError>.Success { value: _ } => false
    Result<Project, ProjectError | OutOfMemoryError>.Failure { error } => match move error {
      ProjectError problem => match move problem {
        ProjectError.InvalidProfile { code: refused, subject: named, .. } => refused == code
          && same(Bytes.asSlice(&named), subject)
        _ => false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// Whether selecting `name` refuses it as an unknown profile.
effect fn unknownProfile(project: &Project, name: &[u8]) -> bool
  ! TomlError | OutOfMemoryError
  ? &mut Allocator {
  let document = run Projects.document(project)
  let selected = run Effect.result(ProjectProfiles.select(&document, name))
  return match move selected {
    Result<Profile, InvalidProfile | OutOfMemoryError>.Success { value: _ } => false
    Result<Profile, InvalidProfile | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProfile refused => refused.code == Code.InvalidInput
        && same(Bytes.asSlice(&refused.subject), b"unknown profile missing: the manifest has no [profiles.missing] table")
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// Whether `value` is the untagged list `[true, "x", 16]`.
fn untaggedMode(value: &BindingInput) -> bool {
  return match &value.* {
    BindingInput.Array { values } => {
      let listed = List<Box<BindingInput>>.asSlice(&values)
      if listed.length != 3 {
        return false
      }
      let flag = match &Box<BindingInput>.get(&listed[0])[0] {
        BindingInput.Boolean { value: written } => written
        _ => false
      }
      let text = match &Box<BindingInput>.get(&listed[1])[0] {
        BindingInput.String { text: written } => same(Bytes.asSlice(&written), b"x")
        _ => false
      }
      return flag && text && integer(&Box<BindingInput>.get(&listed[2])[0], b"16")
    }
    _ => false
  }
}

fn integer(value: &BindingInput, expected: &[u8]) -> bool {
  return match &value.* {
    BindingInput.Integer { decimal } => same(Bytes.asSlice(&decimal), expected)
    _ => false
  }
}

effect fn profilePolicy() -> ()
  ! AssertionError<'static> | FileError | ProjectError | InvalidProfile | TomlError | OutOfMemoryError
  ? &mut Allocator {
  let manifest = run Path.make("/work/hello/silk.toml")
  let header = b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nsource = \".\"\n"
  let mut text = run Bytes.copy(header)
  run Bytes.append(
    &mut text,
    b"[build]\nprofile = \"fast\"\n[config]\nmain.limit = -0\n[profiles.fast]\ntarget = \"x86_64-unknown-linux-gnu\"\noptimization = \"speed\"\ndebug = false\ncpu = { features = [\"avx2\"] }\nconfig.main.mode = [true, \"x\", 0x10]\n"
  )
  let project = run Projects.decode(&manifest, Bytes.asSlice(&text))
  let chosen = match move Projects.defaultProfile(&project) {
    Option<&[u8]>.Some { value } => same(value, b"fast")
    Option<&[u8]>.None => false
  }
  run Testing.expect(chosen, "build.profile names the default profile")
  let document = run Projects.document(&project)
  let Profile { input, bindings, maxMemory: unlimited } = move run ProjectProfiles.select(&document, b"fast")
  drop unlimited
  let optimized = match &input.optimization {
    Option<Bytes>.Some { value } => same(Bytes.asSlice(&value), b"speed")
    Option<Bytes>.None => false
  }
  let targeted = match &input.target {
    Option<Bytes>.Some { value } => same(Bytes.asSlice(&value), b"x86_64-unknown-linux-gnu")
    Option<Bytes>.None => false
  }
  let undebugged = match &input.debug {
    Option<bool>.Some { value } => !value
    Option<bool>.None => false
  }
  run Testing.expect(
    optimized && targeted && undebugged && List<Bytes>.length(&input.cpuFeatures) == 1,
    "a named profile carries its logical fields"
  )
  let supplied = List<Supplied>.asSlice(&bindings)
  run Testing.expect(supplied.length == 2, "a named profile adds its bindings to the project's")
  let first = &supplied[0]
  let second = &supplied[1]
  let projectFirst = first.tier == Tier.Project && same(Bytes.asSlice(&first.parameter), b"limit")
    && same(Bytes.asSlice(&first.module), b"main.silk")
    && integer(&first.value, b"0")
  let literal = match &first.provenance {
    Provenance.Literal => true
    _ => false
  }
  let profileSecond = second.tier == Tier.Override && same(Bytes.asSlice(&second.parameter), b"mode")
    && same(Bytes.asSlice(&second.module), b"main.silk") && same(Bytes.asSlice(&second.package), b"hello@0.1.0")
  let untagged = untaggedMode(&second.value)
  run Testing.expect(
    projectFirst && literal && profileSecond && untagged,
    "project config precedes profile config, values carry no tags, -0 reads as 0 and 0x10 as 16"
  )
  let projectOnly = run ProjectProfiles.projectBindings(&document)
  run Testing.expect(List<Supplied>.length(&projectOnly) == 1, "target builds receive only project bindings")
  let unknown = run unknownProfile(&project, b"missing")
  run Testing.expect(unknown, "an unknown profile name is refused")
  let mut badName = run Bytes.copy(header)
  run Bytes.append(&mut badName, b"[profiles.1fast]\ntarget = \"x86_64-unknown-linux-gnu\"\n")
  let mut missingDefault = run Bytes.copy(header)
  run Bytes.append(&mut missingDefault, b"[build]\nprofile = \"slow\"\n")
  let mut extraField = run Bytes.copy(header)
  run Bytes.append(&mut extraField, b"[profiles.fast]\ntarget = \"x86_64-unknown-linux-gnu\"\nspeed = 3\n")
  let mut untargeted = run Bytes.copy(header)
  run Bytes.append(&mut untargeted, b"[profiles.fast]\ntarget = 3\noptimization = \"speed\"\n")
  let mut wasmLibc = run Bytes.copy(header)
  run Bytes.append(&mut wasmLibc, b"[profiles.web]\ntarget = \"wasm32-unknown-unknown\"\nlibc = \"gnu\"\n")
  let mut floating = run Bytes.copy(header)
  run Bytes.append(&mut floating, b"[config]\nmain.ratio = 1.5\n")
  let mut unmoduled = run Bytes.copy(header)
  run Bytes.append(&mut unmoduled, b"[config]\nlimit = 3\n")
  let named = run refusedProfile(
    &manifest,
    Bytes.asSlice(&badName),
    Code.InvalidInput,
    b"profiles.1fast: a profile name is an ASCII letter, then letters, digits, `_` or `-`"
  )
  let defaulted = run refusedProfile(
    &manifest,
    Bytes.asSlice(&missingDefault),
    Code.InvalidInput,
    b"build.profile = \"slow\" names no [profiles.slow] table"
  )
  let fields = run refusedProfile(&manifest, Bytes.asSlice(&extraField), Code.UnknownField, b"profiles.fast.speed")
  let target = run refusedProfile(&manifest, Bytes.asSlice(&untargeted), Code.InvalidInput, b"profiles.fast.target")
  let combination = run refusedProfile(
    &manifest,
    Bytes.asSlice(&wasmLibc),
    Code.UnsupportedCombination,
    b"profiles.web.libc = \"gnu\""
  )
  let float = run refusedProfile(
    &manifest,
    Bytes.asSlice(&floating),
    Code.InvalidInput,
    b"config.main.ratio: a package parameter value is an integer, a boolean, a string or an array of them"
  )
  let module = run refusedProfile(
    &manifest,
    Bytes.asSlice(&unmoduled),
    Code.InvalidInput,
    b"config.limit: name the module before the parameter, as config.main.limit"
  )
  let refusals = named && defaulted && fields && target && combination && float && module
  run Testing.expect(refusals, "invalid profiles and config values are refused with their TypeScript code and their manifest key")
  // Each profile refusal names the manifest line of the key it refuses.
  let fieldLine = run refusedProfileLine(&manifest, Bytes.asSlice(&extraField), usize.add(0, 7))
  let libcLine = run refusedProfileLine(&manifest, Bytes.asSlice(&wasmLibc), usize.add(0, 7))
  let configLine = run refusedProfileLine(&manifest, Bytes.asSlice(&floating), usize.add(0, 6))
  run Testing.expect(fieldLine && libcLine && configLine, "profile refusals carry the line of the key they name")
  // A quoted profile name is located at its table, a binding's unknown field is named at its line,
  // and a deployment version, which only a Darwin link reads, is refused on another target.
  let mut quotedName = run Bytes.copy(header)
  run Bytes.append(&mut quotedName, b"[profiles.\"1fast\"]\ntarget = \"x86_64-unknown-linux-gnu\"\n")
  let mut profileBindings = run Bytes.copy(header)
  run Bytes.append(&mut profileBindings, b"[profiles.fast]\ntarget = \"x86_64-unknown-linux-gnu\"\nbindings = []\n")
  let mut deployed = run Bytes.copy(header)
  run Bytes.append(&mut deployed, b"[profiles.d]\ntarget = \"x86_64-unknown-linux-gnu\"\ndeployment = \"14.0\"\n")
  let quoted = run refusedProfile(
    &manifest,
    Bytes.asSlice(&quotedName),
    Code.InvalidInput,
    b"profiles.1fast: a profile name is an ASCII letter, then letters, digits, `_` or `-`"
  )
  let quotedLine = run refusedProfileLine(&manifest, Bytes.asSlice(&quotedName), usize.add(0, 5))
  let earlier = run refusedProfile(
    &manifest,
    Bytes.asSlice(&profileBindings),
    Code.InvalidInput,
    b"profiles.fast.bindings is an earlier spelling; write config"
  )
  let deployment = run refusedProfile(
    &manifest,
    Bytes.asSlice(&deployed),
    Code.UnsupportedCombination,
    b"profiles.d.deployment = \"14.0\""
  )
  let deploymentLine = run refusedProfileLine(&manifest, Bytes.asSlice(&deployed), usize.add(0, 7))
  run Testing.expect(
    quoted && quotedLine && earlier && deployment && deploymentLine,
    "a quoted profile name, a profile's earlier bindings and a non-Darwin deployment are refused"
  )
  // Unknown fields of a profile's entry and runtime tables are named and located.
  let mut entryExtra = run Bytes.copy(header)
  run Bytes.append(&mut entryExtra, b"[profiles.u]\ntarget = \"x86_64-unknown-linux-gnu\"\nentry = { kind = \"default\", bogus = 1 }\n")
  let mut runtimeExtra = run Bytes.copy(header)
  run Bytes.append(&mut runtimeExtra, b"[profiles.u]\ntarget = \"x86_64-unknown-linux-gnu\"\nruntime = { kind = \"none\", bogus = 1 }\n")
  let entryField = run refusedProfile(&manifest, Bytes.asSlice(&entryExtra), Code.UnknownField, b"profiles.u.entry.bogus")
  let entryLine = run refusedProfileLine(&manifest, Bytes.asSlice(&entryExtra), usize.add(0, 7))
  let runtimeField = run refusedProfile(&manifest, Bytes.asSlice(&runtimeExtra), Code.UnknownField, b"profiles.u.runtime.bogus")
  let runtimeLine = run refusedProfileLine(&manifest, Bytes.asSlice(&runtimeExtra), usize.add(0, 7))
  run Testing.expect(
    entryField && entryLine && runtimeField && runtimeLine,
    "unknown entry and runtime fields are named at their line"
  )
  let mut darwin = run Bytes.copy(header)
  run Bytes.append(&mut darwin, b"[profiles.mac]\ntarget = \"aarch64-apple-darwin\"\ndeployment = \"14.0\"\n")
  let deployedOnDarwin = run Projects.decode(&manifest, Bytes.asSlice(&darwin))
  run Testing.expect(same(Projects.name(&deployedOnDarwin), b"hello"), "a Darwin profile takes a deployment version")
  // A valid value the native build cannot honor is refused rather than silently ignored.
  let mut sanitized = run Bytes.copy(header)
  run Bytes.append(&mut sanitized, b"[profiles.asan]\ntarget = \"x86_64-unknown-linux-gnu\"\nsanitizers = [\"address\"]\n")
  let mut unwound = run Bytes.copy(header)
  run Bytes.append(&mut unwound, b"[profiles.u]\ntarget = \"x86_64-unknown-linux-gnu\"\nunwind = \"native\"\n")
  let mut unchecked = run Bytes.copy(header)
  run Bytes.append(&mut unchecked, b"[profiles.u]\ntarget = \"x86_64-unknown-linux-gnu\"\nsafety = \"unchecked\"\n")
  let mut threaded = run Bytes.copy(header)
  run Bytes.append(&mut threaded, b"[profiles.u]\ntarget = \"x86_64-unknown-linux-gnu\"\nthreading = \"multi\"\n")
  let mut entered = run Bytes.copy(header)
  run Bytes.append(&mut entered, b"[profiles.u]\ntarget = \"x86_64-unknown-linux-gnu\"\nentry = { kind = \"named\", name = \"start\" }\n")
  let sanitizers = run refusedProfile(&manifest, Bytes.asSlice(&sanitized), Code.NotNative, b"profiles.asan.sanitizers")
  let unwind = run refusedProfile(&manifest, Bytes.asSlice(&unwound), Code.NotNative, b"profiles.u.unwind = \"native\"")
  let safety = run refusedProfile(&manifest, Bytes.asSlice(&unchecked), Code.NotNative, b"profiles.u.safety = \"unchecked\"")
  let threading = run refusedProfile(&manifest, Bytes.asSlice(&threaded), Code.NotNative, b"profiles.u.threading = \"multi\"")
  let entry = run refusedProfile(&manifest, Bytes.asSlice(&entered), Code.NotNative, b"profiles.u.entry")
  let mut armLarge = run Bytes.copy(header)
  run Bytes.append(&mut armLarge, b"[profiles.arm]\ntarget = \"aarch64-unknown-linux-gnu\"\ncode-model = \"large\"\n")
  let large = run refusedProfile(&manifest, Bytes.asSlice(&armLarge), Code.NotNative, b"profiles.arm.code-model = \"large\"")
  run Testing.expect(
    sanitizers && unwind && safety && threading && entry && large,
    "sanitizers, native unwinding, the unchecked and multi-threaded policies, an entry selection and an AArch64 large code model are refused as not native yet"
  )
  let mut applied = run Bytes.copy(header)
  run Bytes.append(
    &mut applied,
    b"[profiles.big]\ntarget = \"x86_64-unknown-linux-gnu\"\ncode-model = \"large\"\nlink = \"static\"\ncpu = { model = \"x86-64\", features = [\"avx2\"] }\nsafety = \"checked\"\nthreading = \"single\"\nunwind = \"none\"\nentry = { kind = \"default\" }\n"
  )
  let big = run Projects.decode(&manifest, Bytes.asSlice(&applied))
  run Testing.expect(same(Projects.name(&big), b"hello"), "the fields the native build applies, and default values, are accepted")
  // `max-memory` is a wasm32 link setting: whole 64 KiB pages up to 4 GiB.
  let mut limited = run Bytes.copy(header)
  run Bytes.append(&mut limited, b"[profiles.web]\ntarget = \"wasm32-unknown-unknown\"\nthreading = \"multi\"\nmax-memory = \"256MiB\"\n")
  let web = run Projects.decode(&manifest, Bytes.asSlice(&limited))
  let webDocument = run Projects.document(&web)
  let Profile { input: webInput, bindings: webBindings, maxMemory } = move run ProjectProfiles.select(&webDocument, b"web")
  drop webInput
  drop webBindings
  let measured = match move maxMemory {
    Option<usize>.Some { value: bytes } => bytes == usize.add(0, 268435456)
    Option<usize>.None => false
  }
  run Testing.expect(measured, "a wasm32 profile's max-memory is read in bytes")
  let mut native = run Bytes.copy(header)
  run Bytes.append(&mut native, b"[profiles.n]\ntarget = \"x86_64-unknown-linux-gnu\"\nmax-memory = \"1GiB\"\n")
  let mut partial = run Bytes.copy(header)
  run Bytes.append(&mut partial, b"[profiles.w]\ntarget = \"wasm32-unknown-unknown\"\nmax-memory = \"100000\"\n")
  let mut huge = run Bytes.copy(header)
  run Bytes.append(&mut huge, b"[profiles.w]\ntarget = \"wasm32-unknown-unknown\"\nmax-memory = \"5GiB\"\n")
  let nativeLimit = run refusedProfile(&manifest, Bytes.asSlice(&native), Code.UnsupportedCombination, b"profiles.n.max-memory = \"1GiB\"")
  let partialPage = run refusedProfile(&manifest, Bytes.asSlice(&partial), Code.InvalidInput, b"profiles.w.max-memory = \"100000\"")
  let tooLarge = run refusedProfile(&manifest, Bytes.asSlice(&huge), Code.InvalidInput, b"profiles.w.max-memory = \"5GiB\"")
  run Testing.expect(
    nativeLimit && partialPage && tooLarge,
    "max-memory is refused outside wasm32, off a 64 KiB page, and above 4 GiB"
  )
  let mut camelModel = run Bytes.copy(header)
  run Bytes.append(&mut camelModel, b"[profiles.p]\ncodeModel = \"large\"\n")
  let mut camelMemory = run Bytes.copy(header)
  run Bytes.append(&mut camelMemory, b"[profiles.p]\nmaxMemory = \"64MiB\"\n")
  let earlierModel = run refusedProfile(&manifest, Bytes.asSlice(&camelModel), Code.InvalidInput, b"profiles.p.codeModel is an earlier spelling; write code-model")
  let earlierMemory = run refusedProfile(&manifest, Bytes.asSlice(&camelMemory), Code.InvalidInput, b"profiles.p.maxMemory is an earlier spelling; write max-memory")
  run Testing.expect(
    earlierModel && earlierMemory,
    "the earlier codeModel and maxMemory spellings are refused, naming the current ones"
  )
  // `cpu.model = "native"` becomes the host's features; the model stays the default.
  let mut hosted = run Bytes.copy(header)
  run Bytes.append(&mut hosted, b"[profiles.here]\ntarget = \"x86_64-unknown-linux-gnu\"\ncpu = { model = \"native\", features = [\"sse2\"] }\n")
  let here = run Projects.decode(&manifest, Bytes.asSlice(&hosted))
  let hereDocument = run Projects.document(&here)
  let Profile { input: hereInput, bindings: hereBindings, maxMemory: _ } = move run ProjectProfiles.select(&hereDocument, b"here")
  drop hereBindings
  let hereFeatures = List<Bytes>.asSlice(&hereInput.cpuFeatures)
  let mut sse2 = usize.ZERO
  let mut at = usize.ZERO
  while at < hereFeatures.length {
    if same(Bytes.asSlice(&hereFeatures[at]), b"sse2") { sse2 = sse2 + usize.ONE }
    at = at + usize.ONE
  }
  let defaultModel = match &hereInput.cpu {
    Option<Bytes>.Some { value: _ } => false
    Option<Bytes>.None => true
  }
  run Testing.expect(defaultModel && sse2 == usize.ONE, "a native CPU model is the default model plus the host's features, each listed once")
  drop hereInput
  let mut elsewhere = run Bytes.copy(header)
  run Bytes.append(&mut elsewhere, b"[profiles.w]\ntarget = \"wasm32-unknown-unknown\"\ncpu = { model = \"native\" }\n")
  let foreign = run refusedProfile(&manifest, Bytes.asSlice(&elsewhere), Code.UnsupportedCombination, b"profiles.w.cpu.model = \"native\"")
  run Testing.expect(foreign, "a native CPU model is refused for a target other than the compiler's own")
}

// Whether `text` is refused for its profile catalog at manifest line `line`.
effect fn refusedProfileLine(manifest: &Path, text: &[u8], line: usize) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let decoded = run Effect.result(Projects.decode(manifest, text))
  return match move decoded {
    Result<Project, ProjectError | OutOfMemoryError>.Success { value: _ } => false
    Result<Project, ProjectError | OutOfMemoryError>.Failure { error } => match move error {
      ProjectError problem => match move problem {
        ProjectError.InvalidProfile { line: written, .. } => written == line
        _ => false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// The build options `values` spell.
effect fn buildOptions(values: &[&[u8]]) -> Options
  ! InvalidProjectCommand | OutOfMemoryError
  ? &mut Allocator {
  let mut arguments = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < values.length {
    run List<Bytes>.append(&mut arguments, run Bytes.copy(values[at]))
    at = at + usize.ONE
  }
  let Build { options } = move run ProjectCommands.parseBuild(List<Bytes>.asSlice(&arguments))
  return move options
}

fn host() -> Target {
  return Target.forId(TargetId.X8664UnknownLinuxGnu)
}

// Whether planning `project` for `values` is refused for a conflicting selection.
effect fn conflicting(project: &Project, values: &[&[u8]]) -> bool
  ! InvalidProjectCommand | TomlError | OutOfMemoryError
  ? &mut Allocator {
  let options = run buildOptions(values)
  let fallback = Projects.targets(project)
  let planned = run Effect.result(ProjectPlans.make(project, &options, fallback, host()))
  return match move planned {
    Result<List<ProjectPlan>, PlanError | TomlError | OutOfMemoryError>.Success { value: _ } => false
    Result<List<ProjectPlan>, PlanError | TomlError | OutOfMemoryError>.Failure { error } => match move error {
      PlanError problem => match move problem {
        PlanError.ConflictingSelection => true
        _ => false
      }
      TomlError malformed => {
        fail move malformed
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// Whether planning `project` for `values` is refused as `--profile-input` that is not JSON, or as
// two selection modes.
effect fn refusedInput(project: &Project, values: &[&[u8]], json: bool) -> bool
  ! InvalidProjectCommand | TomlError | OutOfMemoryError
  ? &mut Allocator {
  let options = run buildOptions(values)
  let planned = run Effect.result(ProjectPlans.make(project, &options, Projects.targets(project), host()))
  return match move planned {
    Result<List<ProjectPlan>, PlanError | TomlError | OutOfMemoryError>.Success { value: _ } => false
    Result<List<ProjectPlan>, PlanError | TomlError | OutOfMemoryError>.Failure { error } => match move error {
      PlanError problem => match move problem {
        PlanError.InvalidProfileInput => json
        PlanError.Profile { code, subject, key: _ } => !json && code == Code.ConflictingBindings
          && same(Bytes.asSlice(&subject), b"profile selection modes")
        _ => false
      }
      TomlError malformed => {
        fail move malformed
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

fn text(value: &Option<Bytes>, expected: &[u8]) -> bool {
  return match &value.* {
    Option<Bytes>.Some { value: written } => same(Bytes.asSlice(&written), expected)
    Option<Bytes>.None => false
  }
}

fn flag(value: &Option<bool>, expected: bool) -> bool {
  return match &value.* {
    Option<bool>.Some { value: written } => written == expected
    Option<bool>.None => false
  }
}

effect fn planPolicy() -> ()
  ! AssertionError<'static> | FileError | ProjectError | PlanError | InvalidProjectCommand | TomlError | OutOfMemoryError
  ? &mut Allocator {
  let manifest = run Path.make("/work/hello/silk.toml")
  let project = run Projects.decode(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nsource = \".\"\n[build]\ntargets = [\"host\", \"aarch64-unknown-linux-gnu\"]\n[config]\nmain.limit = 7\n[profiles.fast]\ntarget = \"x86_64-unknown-linux-gnu\"\noptimization = \"speed\"\nconfig.main.limit = 9\n"
  )
  let fallback = Projects.targets(&project)
  let none = List<Bytes>.make()
  let Build { options: defaults } = move run ProjectCommands.parseBuild(List<Bytes>.asSlice(&none))
  let targeted = run ProjectPlans.make(&project, &defaults, fallback, host())
  let plans = List<ProjectPlan>.asSlice(&targeted)
  run Testing.expect(
    plans.length == 2 && text(&plans[0].input.target, b"x86_64-unknown-linux-gnu")
      && text(&plans[1].input.target, b"aarch64-unknown-linux-gnu")
      && text(&plans[0].input.optimization, b"none") && flag(&plans[0].input.debug, true),
    "without flags each [build].targets selector is one debug compilation"
  )
  run Testing.expect(
    List<Supplied>.length(&plans[0].bindings) == 1 && List<Supplied>.length(&plans[1].bindings) == 1
      && List<Supplied>.asSlice(&plans[1].bindings)[0].tier == Tier.Project,
    "every target compilation receives the project bindings"
  )
  let releasing = run buildOptions(&[b"--release", b"--target", b"host"])
  let released = run ProjectPlans.make(&project, &releasing, fallback, host())
  let release = List<ProjectPlan>.asSlice(&released)
  run Testing.expect(
    release.length == 1 && text(&release[0].input.optimization, b"speed") && flag(&release[0].input.debug, false)
      && List<Supplied>.length(&release[0].bindings) == 1,
    "--release optimizes without debug information and keeps the project bindings"
  )
  let naming = run buildOptions(&[b"--profile", b"fast"])
  let profiled = run ProjectPlans.make(&project, &naming, fallback, host())
  let profile = List<ProjectPlan>.asSlice(&profiled)
  let ordered = List<Supplied>.asSlice(&profile[0].bindings)
  run Testing.expect(
    profile.length == 1 && text(&profile[0].input.optimization, b"speed") && ordered.length == 2
      && ordered[0].tier == Tier.Project && ordered[1].tier == Tier.Override,
    "a named profile is one compilation with the project bindings before its own"
  )
  let plainDirectory = run Projects.profileDirectory(&release[0].name, b"speed", false)
  let namedDirectory = run Projects.profileDirectory(&profile[0].name, b"speed", false)
  run Testing.expect(
    text(&profile[0].name, b"fast") && same(Bytes.asSlice(&plainDirectory), b"release")
      && same(Bytes.asSlice(&namedDirectory), b"fast"),
    "a named profile builds into its own directory, apart from the optimization directories"
  )
  let targetConflict = run conflicting(&project, &[b"--profile", b"fast", b"--target", b"host"])
  let releaseConflict = run conflicting(&project, &[b"--profile", b"fast", b"--release"])
  let optimizationConflict = run conflicting(&project, &[b"--profile", b"fast", b"--optimization", b"debug"])
  run Testing.expect(
    targetConflict && releaseConflict && optimizationConflict,
    "a named profile conflicts with target and optimization flags"
  )
  let fullInput = b"{\"target\":\"x86_64-unknown-linux-gnu\"}"
  let supplying = run buildOptions(&[b"--profile-input", fullInput])
  let supplied = run ProjectPlans.make(&project, &supplying, fallback, host())
  let full = List<ProjectPlan>.asSlice(&supplied)
  let fullConflict = run conflicting(&project, &[b"--profile-input", fullInput, b"--release"])
  let modes = run refusedInput(&project, &[b"--profile", b"fast", b"--profile-input", fullInput], false)
  let malformed = run refusedInput(&project, &[b"--profile-input", b"{"], true)
  run Testing.expect(
    full.length == 1 && List<Supplied>.length(&full[0].bindings) == 1 && fullConflict && modes && malformed,
    "a full profile replaces the default, conflicts like a named one and must be JSON"
  )
  let artifacts = run Projects.decode(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nsource = \".\"\n[profiles.obj]\ntarget = \"x86_64-unknown-linux-gnu\"\nartifact = \"object\"\n[profiles.exe]\ntarget = \"x86_64-unknown-linux-gnu\"\nartifact = \"executable\"\n"
  )
  let objectOptions = run buildOptions(&[b"--profile", b"obj"])
  let objectPlanned = run Effect.result(ProjectPlans.make(&artifacts, &objectOptions, fallback, host()))
  let mismatched = match move objectPlanned {
    Result<List<ProjectPlan>, PlanError | TomlError | OutOfMemoryError>.Success { value: _ } => false
    Result<List<ProjectPlan>, PlanError | TomlError | OutOfMemoryError>.Failure { error } => match move error {
      PlanError problem => match move problem {
        PlanError.Profile { code, key, .. } => code == Code.UnsupportedCombination
          && same(Bytes.asSlice(&key), b"profiles.obj.artifact") && Projects.line(&artifacts, Bytes.asSlice(&key)) == usize.add(0, 7)
        _ => false
      }
      TomlError invalid => {
        fail move invalid
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let executableOptions = run buildOptions(&[b"--profile", b"exe"])
  let matching = run ProjectPlans.make(&artifacts, &executableOptions, fallback, host())
  run Testing.expect(
    mismatched && List<ProjectPlan>.length(&matching) == 1,
    "a profile artifact must be the form [package].kind requests, so an object profile of an executable is refused"
  )
}

// A project as `silk init` writes it names no target, libc or profile, so `run` plans the host with
// the host's default libc: on macOS, the `system` libc the standard-library catalog lists.
effect fn hostDefaultPolicy() -> ()
  ! AssertionError<'static> | FileError | ProjectError | PlanError | InvalidProjectCommand | InitialProfileProblem | TomlError | OutOfMemoryError
  ? &mut Allocator {
  let manifest = run Path.make("/work/hello/silk.toml")
  let project = run Projects.decode(
    &manifest,
    b"[package]\nname = \"hello\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0\"\n"
  )
  let none = List<Bytes>.make()
  let Build { options } = move run ProjectCommands.parseBuild(List<Bytes>.asSlice(&none))
  let hostSelector = [run Bytes.copy(b"host")]
  let selectors: &[Bytes] = &hostSelector
  let planned = run ProjectPlans.make(&project, &options, selectors, Target.forId(TargetId.Aarch64AppleDarwin))
  let plans = List<ProjectPlan>.asSlice(&planned)
  let unset = match &plans[0].input.libc {
    Option<Bytes>.Some { .. } => false
    Option<Bytes>.None => true
  }
  let profile = run InitialProfile.freeze(&plans[0].input)
  let libc = match move InitialProfile.text(&profile, b"libc") {
    Option<&[u8]>.Some { value } => same(value, b"system")
    Option<&[u8]>.None => false
  }
  run Testing.expect(
    plans.length == 1 && text(&plans[0].input.target, b"aarch64-apple-darwin") && unset && libc
      && Target.id(InitialProfile.target(&profile)) == TargetId.Aarch64AppleDarwin,
    "an unconfigured project plans the host target, whose default libc the frozen profile selects"
  )
}

test effect fn unconfiguredProjectsBuildForTheHost() -> ()
