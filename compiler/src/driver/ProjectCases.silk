// Whether the JSON profile `text` is refused with `code` and `subject`.
effect fn refusedJson(project: &Project, text: &[u8], code: Code, subject: &[u8]) -> bool
  ! JsonError | TomlError | OutOfMemoryError
  ? &mut Allocator {
  let document = run Projects.document(project)
  let json = run Json.parse(text)
  let decoded = run Effect.result(ProjectProfiles.fromInput(&document, &json))
  return match move decoded {
    Result<Profile, InvalidProfile | OutOfMemoryError>.Success { value: _ } => false
    Result<Profile, InvalidProfile | OutOfMemoryError>.Failure { error } => match move error {
      InvalidProfile refused => refused.code == code && same(Bytes.asSlice(&refused.subject), subject)
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn inputPolicy() -> ()
  ! AssertionError<'static> | FileError | ProjectError | InvalidProfile | JsonError | TomlError | OutOfMemoryError
  ? &mut Allocator {
  let manifest = run Path.make("/work/hello/silk.toml")
  let project = run Projects.decode(
    &manifest,
    b"[package]\nversion = \"0.1.0\"\nname = \"hello\"\nsource = \".\"\n[config]\nmain.limit = 7\n"
  )
  let document = run Projects.document(&project)
  let json = run Json.parse(
    b"{\"target\":\"x86_64-unknown-linux-gnu\",\"optimization\":\"speed\",\"cpu\":{\"features\":[\"avx2\"]},\"bindings\":[{\"package\":\"hello@0.1.0\",\"module\":\"main\",\"parameter\":\"limit\",\"value\":{\"kind\":\"array\",\"values\":[{\"kind\":\"none\"}]},\"origin\":{\"source\":\"cli\",\"provenance\":\"literal\"}}]}"
  )
  let Profile { input, bindings, maxMemory: unlimited } = move run ProjectProfiles.fromInput(&document, &json)
  drop unlimited
  let optimized = match &input.optimization {
    Option<Bytes>.Some { value } => same(Bytes.asSlice(&value), b"speed")
    Option<Bytes>.None => false
  }
  let supplied = List<Supplied>.asSlice(&bindings)
  let ordered = supplied.length == 2 && supplied[0].tier == Tier.Project && supplied[1].tier == Tier.Override
  let listed = match &supplied[1].value {
    BindingInput.Array { values } => List<Box<BindingInput>>.length(&values) == 1
    _ => false
  }
  run Testing.expect(
    optimized && List<Bytes>.length(&input.cpuFeatures) == 1 && ordered && listed,
    "a JSON profile decodes as a manifest profile, after the project bindings"
  )
  let numbered = run refusedJson(&project, b"{\"target\":\"x86_64-unknown-linux-gnu\",\"debug\":1}", Code.InvalidInput, b"--profile-input.debug")
  let nulled = run refusedJson(&project, b"{\"target\":\"x86_64-unknown-linux-gnu\",\"cpu\":null}", Code.InvalidInput, b"--profile-input.cpu")
  let scalar = run refusedJson(&project, b"3", Code.InvalidInput, b"--profile-input")
  let integerValue = run refusedJson(
    &project,
    b"{\"target\":\"x86_64-unknown-linux-gnu\",\"bindings\":[{\"package\":\"hello@0.1.0\",\"module\":\"main\",\"parameter\":\"limit\",\"value\":{\"kind\":\"integer\",\"value\":7},\"origin\":{\"source\":\"cli\",\"provenance\":\"literal\"}}]}",
    Code.InvalidInput,
    b"--profile-input.bindings: configuration value"
  )
  run Testing.expect(
    numbered && nulled && scalar && integerValue,
    "JSON numbers and nulls are refused under the field they fill"
  )
  // A JSON profile keeps the tagged bindings transport, so its identity, value and origin are
  // checked in full, and `config` is a manifest field only.
  let identity = b"{\"target\":\"x86_64-unknown-linux-gnu\",\"bindings\":[{\"package\":\"hello@0.1.0\",\"module\":\"main\",\"parameter\":\"n\","
  let literal = b"\"value\":{\"kind\":\"integer\",\"value\":\"1\"},"
  let secret = run boundJson(identity, literal, b"\"origin\":{\"source\":\"env\",\"provenance\":\"secret\"}")
  let badValue = run boundJson(identity, b"\"value\":{\"kind\":\"integer\",\"value\":\"01\"},", b"\"origin\":{\"source\":\"cli\",\"provenance\":\"literal\"}")
  let extraField = run boundJson(identity, literal, b"\"origin\":{\"source\":\"cli\",\"provenance\":\"literal\"},\"extra\":1")
  let originExtra = run boundJson(identity, literal, b"\"origin\":{\"source\":\"cli\",\"provenance\":\"literal\",\"bogus\":1}")
  let valueExtra = run boundJson(
    identity,
    b"\"value\":{\"kind\":\"some\",\"value\":{\"kind\":\"integer\",\"value\":\"1\",\"bogus\":1}},",
    b"\"origin\":{\"source\":\"cli\",\"provenance\":\"literal\"}"
  )
  let translator = run boundJson(identity, literal, b"\"origin\":{\"source\":\"cli\",\"provenance\":\"literal\",\"translator\":\"t\"}")
  let bogus = run boundJson(identity, literal, b"\"origin\":{\"source\":\"cli\",\"provenance\":\"bogus\"}")
  let unprovenanced = run boundJson(identity, literal, b"\"origin\":{\"source\":\"cli\"}")
  let unoriginated = run boundJson(identity, b"\"value\":{\"kind\":\"integer\",\"value\":\"1\"}", b"")
  let emptySource = run boundJson(identity, literal, b"\"origin\":{\"source\":\"\",\"provenance\":\"literal\"}")
  let emptyTranslator = run boundJson(identity, literal, b"\"origin\":{\"source\":\"x\",\"provenance\":\"translated-public\",\"translator\":\"\"}")
  let unknownKind = run boundJson(identity, b"\"value\":{\"kind\":\"float\",\"value\":\"1\"},", b"\"origin\":{\"source\":\"cli\",\"provenance\":\"literal\"}")
  let checks = [
    run refusedJson(&project, Bytes.asSlice(&secret), Code.ForbiddenProvenance, b"--profile-input.bindings: origin.provenance = \"secret\" cannot be bound in a manifest"),
    run refusedJson(&project, Bytes.asSlice(&badValue), Code.InvalidInput, b"--profile-input.bindings: configuration value"),
    run refusedJson(&project, Bytes.asSlice(&extraField), Code.UnknownField, b"--profile-input.bindings.extra"),
    run refusedJson(&project, Bytes.asSlice(&originExtra), Code.UnknownField, b"--profile-input.bindings.origin.bogus"),
    run refusedJson(&project, Bytes.asSlice(&valueExtra), Code.UnknownField, b"--profile-input.bindings.value.value.bogus"),
    run refusedJson(&project, Bytes.asSlice(&translator), Code.InvalidInput, b"--profile-input.bindings: origin.translator: only provenance \"translated-public\" names a translator"),
    run refusedJson(&project, Bytes.asSlice(&bogus), Code.InvalidInput, b"--profile-input.bindings: origin.provenance = \"bogus\" is not literal, translated-public, secret, physical-supply or runtime"),
    run refusedJson(&project, Bytes.asSlice(&unprovenanced), Code.InvalidInput, b"--profile-input.bindings: origin.provenance is missing"),
    run refusedJson(&project, Bytes.asSlice(&unoriginated), Code.InvalidInput, b"--profile-input.bindings: origin is missing; write origin = { source = \"silk.toml\", provenance = \"literal\" }"),
    run refusedJson(&project, Bytes.asSlice(&emptySource), Code.InvalidInput, b"--profile-input.bindings: origin.source must be a non-empty string"),
    run refusedJson(&project, Bytes.asSlice(&emptyTranslator), Code.InvalidInput, b"--profile-input.bindings: origin.translator must be a non-empty string"),
    run refusedJson(&project, Bytes.asSlice(&unknownKind), Code.InvalidInput, b"--profile-input.bindings: value.kind must be integer, boolean, string, enum, none, some, array or record"),
    run refusedJson(
      &project,
      b"{\"target\":\"x86_64-unknown-linux-gnu\",\"bindings\":[{\"module\":\"main\",\"parameter\":\"n\",\"value\":{\"kind\":\"integer\",\"value\":\"1\"},\"origin\":{\"source\":\"cli\",\"provenance\":\"literal\"}}]}",
      Code.InvalidInput,
      b"--profile-input.bindings: package is missing; a binding names its package, module and parameter"
    ),
    run refusedJson(&project, b"{\"target\":\"x86_64-unknown-linux-gnu\",\"config\":{}}", Code.UnknownField, b"--profile-input.config"),
  ]
  let mut at = usize.ZERO
  while at < checks.length {
    run Testing.expect(checks[at], "a JSON profile's tagged bindings are checked in full")
    at = at + usize.ONE
  }
}

// One JSON profile with a single binding: `identity`, then `value`, then `origin` (each with its
// trailing separator, `origin` without one).
effect fn boundJson(identity: &[u8], value: &[u8], origin: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = run Bytes.copy(identity)
  run Bytes.append(&mut text, value)
  run Bytes.append(&mut text, origin)
  run Bytes.append(&mut text, b"}]}")
  return move text
}

