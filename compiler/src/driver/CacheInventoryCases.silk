//! Metadata authority and resumable link retirement for cache inventories.
import CompilerBug
import driver.CacheInventory as Inventory {Draft, Resource, Kind, Cursor}
import semantic.ContentHash {ContentHash}
import semantic.RuntimeEncoding as Encoding
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize
import silk.testing.testing {Testing, AssertionError}

fn resource(high: u64, low: u64, size: u64) -> Resource {
  return Resource {digest: ContentHash {high: high, low: low}, bytes: size}
}
effect fn fixture() -> Draft ! OutOfMemoryError ? &mut Allocator {
  let mut segments = List<Resource>.make()
  run List<Resource>.append(&mut segments, resource(7, 9, 100))
  run List<Resource>.append(&mut segments, resource(7, 2, 200))
  let mut packs = List<Resource>.make()
  run List<Resource>.append(&mut packs, resource(7, 9, 300))
  return Draft {directory: ContentHash.of(b"unique-publication"), generation: run Bytes.copy(b"exact-generation-packet"),
    segments: move segments, packs: move packs}
}
effect fn encoded(draft: &Draft) -> Bytes ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  match move run Inventory.encode(draft) {
    Option<Bytes>.Some {value} => { return move value }
    _ => { run Testing.expect(false, "valid inventory encodes") return CompilerBug.panic(b"unreachable assertion") }
  }
}
effect fn opened(packet: Bytes) -> Inventory.Inventory ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let digest = ContentHash.of(Bytes.asSlice(&packet))
  match move run Inventory.open(move packet, digest) {
    Option<Inventory.Inventory>.Some {value} => { return move value }
    _ => { run Testing.expect(false, "valid inventory authenticates") return CompilerBug.panic(b"unreachable assertion") }
  }
}
effect fn refused(packet: Bytes) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let digest = ContentHash.of(Bytes.asSlice(&packet))
  match move run Inventory.open(move packet, digest) {
    Option<Inventory.Inventory>.None => {}
    _ => { run Testing.expect(false, "rehashed malformed metadata is refused") }
  }
}

test effect fn cacheInventoryPreservesExactResourceAuthority() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run authority() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn authority() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let draft = run fixture()
  let packet = run encoded(&draft)
  let digest = ContentHash.of(Bytes.asSlice(&packet))
  let inventory = run opened(move packet)
  run Testing.expect(ContentHash.equals(Inventory.identity(&inventory), digest)
    && ContentHash.equals(Inventory.nonce(&inventory), draft.directory), "directory nonce and packet identity retain distinct authority")
  run Testing.expect(Encoding.equals(Inventory.generation(&inventory), Bytes.asSlice(&draft.generation)), "generation admission receives the exact packet")
  let segments = Inventory.segments(&inventory)
  let packs = Inventory.packs(&inventory)
  run Testing.expect(segments[0].digest.low == 9 && segments[1].digest.low == 2 && packs[0].digest.low == 9,
    "uniqueness validation preserves order and separate resource namespaces")
  match Inventory.resourceAt(&inventory, 2) {
    Option<Inventory.Item>.Some {value} => {
      run Testing.expect(value.kind == Kind.Pack && value.resource.bytes == 300,
        "a pack link retains its own size even when a segment has the same digest")
    }
    _ => { run Testing.expect(false, "the pack link follows the segment links") }
  }
  match move run Inventory.open(run encoded(&draft), ContentHash.of(b"wrong-packet")) {
    Option<Inventory.Inventory>.None => {}
    _ => { run Testing.expect(false, "a descriptor cannot authenticate another packet") }
  }
}

test effect fn cacheInventoryRejectsAmbiguousAndMalformedPackets() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run malformed() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn malformed() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut draft = run fixture()
  let mut trailing = run encoded(&draft)
  run Bytes.append(&mut trailing, b"extra")
  run refused(move trailing)
  let mut truncated = run encoded(&draft)
  let truncatedEnd = Bytes.length(&truncated) - usize.ONE
  Bytes.truncate(&mut truncated, truncatedEnd)
  run refused(move truncated)
  run List<Resource>.append(&mut draft.segments, resource(7, 9, 999))
  match move run Inventory.encode(&draft) {
    Option<Bytes>.None => {}
    _ => { run Testing.expect(false, "one digest cannot claim two links or payload sizes within a namespace") }
  }
  // Bypass the encoder to test authenticated but malformed on-disk metadata.
  let mut duplicate = Bytes.make()
  run Encoding.field(&mut duplicate, b"silk-cache-inventory-v1")
  run Encoding.word(&mut duplicate, 1)
  run Encoding.word(&mut duplicate, 2)
  run Encoding.field(&mut duplicate, b"generation")
  run Encoding.word(&mut duplicate, 2)
  let mut at = usize.ZERO
  while at < 2 {
    run Encoding.word(&mut duplicate, 7)
    run Encoding.word(&mut duplicate, 9)
    run Encoding.word(&mut duplicate, usize.toU64(at))
    at = at + usize.ONE
  }
  run Encoding.word(&mut duplicate, 0)
  run refused(move duplicate)
  let mut excessive = Bytes.make()
  run Encoding.field(&mut excessive, b"silk-cache-inventory-v1")
  run Encoding.word(&mut excessive, 1)
  run Encoding.word(&mut excessive, 2)
  run Encoding.field(&mut excessive, b"generation")
  run Encoding.word(&mut excessive, 18446744073709551615)
  run refused(move excessive)
}

test effect fn cacheInventoryRetirementCommitsOnlyCompletedBatches() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run retirement() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn retirement() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let draft = run fixture()
  let inventory = run opened(run encoded(&draft))
  let mut cursor = Cursor {next: usize.ZERO}
  let initial = match Inventory.batch(&inventory, cursor, 2) {
    Option<Inventory.Batch>.Some {value} => value
    _ => { return CompilerBug.panic(b"valid retirement batch") }
  }
  run Testing.expect(initial.start == 0 && initial.end == 2 && !initial.done && cursor.next == 0,
    "planning a bounded batch grants no unlink completion")
  let retry = match Inventory.batch(&inventory, cursor, 2) {
    Option<Inventory.Batch>.Some {value} => value
    _ => { return CompilerBug.panic(b"retry retirement batch") }
  }
  run Testing.expect(retry.start == initial.start && retry.end == initial.end, "an interrupted unlink range is retried without skipping links")
  cursor.next = initial.end
  let finalBatch = match Inventory.batch(&inventory, cursor, usize.MAX) {
    Option<Inventory.Batch>.Some {value} => value
    _ => { return CompilerBug.panic(b"final retirement batch") }
  }
  run Testing.expect(finalBatch.start == 2 && finalBatch.end == 3 && finalBatch.done, "large budgets stop at the exact final link without overflow")
  cursor.next = finalBatch.end
  match Inventory.batch(&inventory, cursor, 1) {
    Option<Inventory.Batch>.Some {value} => { run Testing.expect(value.start == value.end && value.done, "completed cursor stays completed") }
    _ => { run Testing.expect(false, "end cursor is valid") }
  }
  match Inventory.batch(&inventory, Cursor {next: 4}, 1) {
    Option<Inventory.Batch>.None => {}
    _ => { run Testing.expect(false, "an invalid cursor cannot authorize resource unlink") }
  }
  match Inventory.batch(&inventory, Cursor {next: 0}, 0) {
    Option<Inventory.Batch>.None => {}
    _ => { run Testing.expect(false, "zero work budget refuses") }
  }
}
