//! Backend settings selected by the package that defines a codegen unit.

import driver.OptimizationFlags
import backend.PackageSettings { PackageSettings }
import backend.CodegenUnits { CodegenUnit }
import silk.build.request { Package, Request }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.num.usize

/// Whether a package's own settings differ from the program's, so its code compiles apart.
///
/// A setting that repeats the program's value, such as `speed` for a dependency of a `--release`
/// build, changes nothing: the program then stays one module, where every call can inline.
fn overrides(selected: &Package, request: &Request) -> bool {
  if let Option<String>.Some {value} = &selected.optimization {
    if String.ownedUtf8Bytes(&value) != String.ownedUtf8Bytes(&request.profile.optimization) { return true }
  }
  if let Option<bool>.Some {value} = &selected.debug {
    if value != request.profile.debug { return true }
  }
  return false
}

/// Whether defining-package settings that differ from the program's require independently
/// compiled units.
pub fn separate(request: Option<&Request>) -> bool {
  if let Option<&Request>.Some {value} = request {
    let packages = value.packages.asSlice()
    let mut at = usize.ZERO
    while at < packages.length {
      if overrides(&packages[at], value) { return true }
      at = at + usize.ONE
    }
  }
  return false
}

/// Whether any package needs source line tables, including the program's default.
pub fn lines(request: Option<&Request>, program: bool) -> bool {
  if program { return true }
  if let Option<&Request>.Some {value} = request {
    let packages = value.packages.asSlice()
    let mut at = usize.ZERO
    while at < packages.length {
      if packages[at].debug.unwrapOr(false) { return true }
      at = at + usize.ONE
    }
  }
  return false
}

/// Applies each defining package's settings, retaining the program defaults for other units.
pub effect fn configure(units: &mut List<CodegenUnit>, request: &Request) -> () ! OutOfMemoryError ? &mut Allocator {
  let listed = units.asMutSlice()
  let packages = request.packages.asSlice()
  let mut at = usize.ZERO
  while at < listed.length {
    let unit = &mut listed[at]
    unit.optimization = Option<Bytes>.some(run Bytes.copy(String.ownedUtf8Bytes(&request.profile.optimization)))
    unit.debug = Option<bool>.some(request.profile.debug)
    let mut package = usize.ZERO
    while package < packages.length {
      let selected = &packages[package]
      let mut identity = run Bytes.copy(String.ownedUtf8Bytes(&selected.name))
      run identity.append(b"@")
      run identity.append(String.ownedUtf8Bytes(&selected.version))
      if identity.asSlice() == unit.owner.asSlice() {
        if let Option<String>.Some {value} = &selected.optimization { unit.optimization = Option<Bytes>.some(run Bytes.copy(String.ownedUtf8Bytes(&value))) }
        if let Option<bool>.Some {value} = &selected.debug { unit.debug = Option<bool>.some(value) }
      }
      package = package + usize.ONE
    }
    at = at + usize.ONE
  }
}

/// Whether a unit has package-specific code-generation settings, which must survive linking.
pub fn configured(units: &[CodegenUnit]) -> bool {
  let mut at = usize.ZERO
  while at < units.length {
    if units[at].optimization.isSome() || units[at].debug.isSome() { return true }
    at = at + usize.ONE
  }
  return false
}

/// Whether any unit compiles with `speed`, which a ThinLTO link then joins.
pub fn anySpeed(units: &[CodegenUnit]) -> bool {
  let mut at = usize.ZERO
  while at < units.length {
    if let Option<Bytes>.Some {value} = &units[at].optimization {
      if value.asSlice() == b"speed" { return true }
    }
    at = at + usize.ONE
  }
  return false
}

/// Replaces program optimization and debug flags with the unit's own values. Only a unit compiled
/// with `speed` keeps `-flto=thin`: the ThinLTO link optimizes every unit it joins at that level.
pub effect fn flags(common: &[Bytes], unit: &CodegenUnit, wasm: bool, x86: bool) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < common.length {
    let flag = common[at].asSlice()
    if unit.optimization.isSome() {
      if flag == b"-O0" || flag == b"-O1" || flag == b"-O2" || flag == b"-O3" || flag == b"-Os" || flag == b"-Oz" {
        at = at + usize.ONE
        continue
      }
      if flag == b"-mllvm" && at + usize.ONE < common.length {
        let option = common[at + usize.ONE].asSlice()
        if option == b"-enable-tail-merge=false" || option == b"-unroll-runtime=false" || option == b"-inline-threshold=500" || option == b"-x86-cmov-converter=false" {
          at = at + 2
          continue
        }
      }
      if flag == b"-Xclang" && at + usize.ONE < common.length && common[at + usize.ONE].asSlice() == b"-disable-llvm-passes" {
        at = at + 2
        continue
      }
    }
    if unit.debug.isSome() && flag == b"-g" { at = at + usize.ONE
      continue }
    if flag == b"-flto=thin" {
      if let Option<Bytes>.Some {value} = &unit.optimization {
        if value.asSlice() != b"speed" { at = at + usize.ONE
          continue }
      }
    }
    run result.append(run Bytes.copy(flag))
    at = at + usize.ONE
  }
  if let Option<Bytes>.Some {value} = &unit.optimization {
    let mut backendOptions = List<Bytes>.make()
    run OptimizationFlags.append(&mut result, &mut backendOptions, value.asSlice(), wasm, x86)
  }
  if unit.debug.unwrapOr(false) { run result.append(run Bytes.copy(b"-g")) }
  return move result
}

/// Copies backend overrides for semantic lowering without changing the source profile.
pub effect fn lowering(request: &Request) -> List<PackageSettings> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<PackageSettings>.make()
  let packages = request.packages.asSlice()
  let mut at = usize.ZERO
  while at < packages.length {
    let selected = &packages[at]
    if overrides(selected, request) {
      let mut identity = run Bytes.copy(String.ownedUtf8Bytes(&selected.name))
      run identity.append(b"@")
      run identity.append(String.ownedUtf8Bytes(&selected.version))
      let mut optimization = Option<Bytes>.none()
      if let Option<String>.Some {value} = &selected.optimization { optimization = Option<Bytes>.some(run Bytes.copy(String.ownedUtf8Bytes(&value))) }
      run result.append(PackageSettings {identity: move identity, optimization: move optimization, debug: selected.debug})
    }
    at = at + usize.ONE
  }
  return move result
}
