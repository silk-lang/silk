/// A manifest without a package name or root, a non-text package version, or an entry outside that
/// root's module directory.
pub struct InvalidSourceRoot {}

/// No `silk.toml` in the entry's directory or any of its parent directories, so the build has no
/// logical package identity.
pub struct MissingManifest {
  /// The entry's directory, where the upward search for a manifest started.
  pub directory: Path,
}

/// A build that selects no single runtime module where it needs one: a `[unstable].composition` whose
/// default runtime candidates name more than one runtime or an unlisted one, an executable whose
/// composition names no default, or, without a composition, an executable whose standard-library
/// catalog lists no runtime for the target and libc, or a selected standard-library runtime that
/// the catalog lists only for other targets (ARTIFACT-001).
pub struct InvalidBuildComposition {
  /// What the selection lacks, or empty for the general message.
  pub detail: Bytes,
}

/// An executable without a `[unstable].composition` takes its runtime from the standard library's
/// composition catalog, but the build names no standard library: neither `--stdlib` nor one
/// installed beside the compiler.
pub struct MissingStandardLibrary {}

/// The owned filesystem roots and separately published module contents for one build.
pub struct ModuleSources {
  root: Path,
  /// The logical package identity, `name` or `name@version` from the manifest. Every module
  /// identity carries it instead of a host path, so a checkout's location never reaches a build.
  package: Bytes,
  /// The module directory relative to its manifest's directory, as `path.relative` spells it, such
  /// as `src` or `../shared`; empty when it is the manifest's directory.
  directory: Bytes,
  standardLibrary: Option<Path>,
  entry: ModuleId,
  entrySource: Path,
  /// The selected runtime source module, whose C exports root the build (ARTIFACT-002). A library
  /// or object form acquires no catalog runtime, so its application's C exports are its roots.
  runtime: Option<ModuleId>,
  /// The composition's execution-storage component, absent when none is selected validly.
  storage: Option<ExecutionStorage>,
  traceDirective: Option<TraceDirective>,
  /// The target support modules whose C exports root executables and loadable modules,
  /// whatever their runtime, such as the C library of a target without one.
  support: List<ModuleId>,
  /// Whether each support module's C exports are also the module's host exports.
  supportHosted: List<bool>,
  /// The composition's explicit retention roots, in manifest order (ARTIFACT-003).
  retention: List<RetentionRoot>,
  /// Native link inputs contributed by the root package plan and, for executables and
  /// loadable modules, every reached dependency plan.
  linkInputs: List<NativeLinkInput>,
  /// The archives of the packages whose inputs it links, selected for the target.
  archives: List<Archive>,
  /// The combined function order contributed by reached package plans.
  functionOrder: Option<Path>,
  /// The root package and every package its dependencies reach (PACKAGE-002).
  packages: Packages,
  pendingDependencies: List<DependencyDemand>,
  /// Which module each import path names, shared with semantic analysis.
  graph: PackageGraph,
  revision: Revision,
  attempted: List<ModuleId>,
  // Child names of the directories read so far, which check the letter case of each source path.
  listings: List<Listing>,
  /// The units `preload` parsed, until `takeParsed` hands them to a store.
  parsed: List<SourceUnit>,
  // The imports of files read before, which spare `preload` the parse of an unchanged file.
  summaries: Option<ImportSummaries>,
  // The modules the last load read and found to declare no foreign claim, for a store's
  // `offerClaimFree`.
  claimFree: List<ModuleId>,
  // Whether a module a load read since a store last took it writes an erased type, for a store's
  // `offerErasure`.
  erased: bool,
  // The digest of each module the last load read with summaries, for `parsedDigests`.
  digests: List<LoadedDigest>,
  // The bindings nothing names in the text last read of each module that has any, for
  // `unusedWarnings`.
  unused: List<ModuleUnused>,
  // The modules the text last read of each module imports, for `reached`.
  imports: List<ModuleImports>,
  // The modules `preloadProgram` loaded the program from, for `reached`; empty before it runs.
  programRoots: List<ModuleId>,
  // Whether `preloadProgram` leaves out the package's exported modules: a tasks program is not the
  // package's library, so it loads only what its entry imports.
  entryOnly: bool,
  /// The modules packages' `build.silk` plans generate (driver/BuildPlan).
  generated: List<GeneratedModule>,
  // The files earlier loads of the run read, which `preload` takes instead of reading them again.
  snapshot: Option<SourceSnapshot>,
}

/// The source files the loads of one run have read, by path, with their digests. A later load in
/// the run takes a file from it instead of reading and hashing the file again, as each member of a
/// workspace check does for the packages it shares with the members before it. A file that
/// changes during the run reads as it did when the run first read it.
///
/// It also notes each file a module of a load's root package embedded and found present, in the
/// order the loads read them, for `silk pack` to hold against the archive it writes.
pub struct SourceSnapshot {
  files: List<SnapshotFile>,
  lookup: InternIndex,
  embedded: List<EmbeddedRead>,
}

/// One embedded file a load read: the logical path of the module that embeds it and the path it
/// writes, which is relative to the directory of the package's manifest.
pub struct EmbeddedRead {
  pub reader: Bytes,
  pub path: Bytes,
}

// One file a snapshot holds: its bytes, or none when it was missing, and their digest.
struct SnapshotFile {
  path: Bytes,
  content: Option<Shared<Bytes>>,
  digest: ContentHash,
}

/// A snapshot that holds no file.
pub fn snapshot() -> SourceSnapshot {
  return SourceSnapshot {
    files: List<SnapshotFile>.make(),
    lookup: InternIndex.make(),
    embedded: List<EmbeddedRead>.make(),
  }
}

/// The embedded files the loads that used `held` read for their root packages, oldest first.
pub fn snapshotEmbedded(held: &SourceSnapshot) -> &[EmbeddedRead] {
  return List<EmbeddedRead>.asSlice(&held.embedded)
}

// A source read: its bytes, or none, and their digest (zero for none, as `Revision` keeps it).
struct SharedSource {
  content: Option<Shared<Bytes>>,
  digest: ContentHash,
}

// The bytes `content` holds, shared, with their digest.
effect fn sharedSource(content: Option<Bytes>) -> SharedSource
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move content {
    Option<Bytes>.Some { value } => {
      let digest = ContentHash.of(Bytes.asSlice(&value))
      SharedSource {
        content: Option<Shared<Bytes>>.some(run Shared<Bytes>.make(move value)),
        digest: digest,
      }
    }
    Option<Bytes>.None => SharedSource {
      content: Option<Shared<Bytes>>.none(),
      digest: ContentHash { high: 0, low: 0 },
    }
  }
}

// The file at `path`, through `snapshot` when there is one.
effect fn snapshotRead(snapshot: &mut Option<SourceSnapshot>, path: &Path) -> SharedSource
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if let Option<SourceSnapshot>.Some { value } = &mut snapshot.* {
    return run heldRead(&mut value, path)
  }
  return run sharedSource(run readOptional(path))
}

// The file at `path`, from `held` when it holds it, and read and kept there otherwise.
effect fn heldRead(held: &mut SourceSnapshot, path: &Path) -> SharedSource
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let named = Path.rawBytes(path)
  let hashed = InternIndex.hashBytes(0, named)
  let files = List<SnapshotFile>.asSlice(&held.files)
  let mut at = InternIndex.first(&held.lookup, hashed)
  while at != usize.MAX {
    if sameText(Bytes.asSlice(&files[at].path), named) {
      let content = match &files[at].content {
        Option<Shared<Bytes>>.Some { value } => Option<Shared<Bytes>>.some(
          Shared<Bytes>.clone(&value),
        )
        Option<Shared<Bytes>>.None => Option<Shared<Bytes>>.none()
      }
      return SharedSource { content: move content, digest: files[at].digest }
    }
    at = InternIndex.after(&held.lookup, at)
  }
  let read = run sharedSource(run readOptional(path))
  let mut kept = Option<Shared<Bytes>>.none()
  if let Option<Shared<Bytes>>.Some { value } = &read.content {
    kept = Option<Shared<Bytes>>.some(Shared<Bytes>.clone(&value))
  }
  run List<SnapshotFile>.append(
    &mut held.files,
    SnapshotFile { path: run Bytes.copy(named), content: move kept, digest: read.digest },
  )
  run InternIndex.record(&mut held.lookup, hashed)
  return move read
}

// A copy of the bytes `shared` holds.
effect fn copyShared(shared: &Shared<Bytes>) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let count = Shared<Bytes>.with<usize>(shared, Bytes.length)
  let mut copied = run Bytes.zeroed(count)
  let target = Bytes.asMutSlice(&mut copied)
  Shared<Bytes>.with<()>(
    shared,
    |bytes: &Bytes| -> () {
      return Slice.copyInto<u8>(move target, usize.ZERO, Bytes.asSlice(bytes))
    },
  )
  return move copied
}

// One generated module: its package identity, its logical path and its source.
struct GeneratedModule {
  package: Bytes,
  path: Bytes,
  source: Bytes,
  file: Option<Path>,
  producer: Option<String>,
}

struct LoadedDigest {
  module: ModuleId,
  digest: ContentHash,
}

// The bindings nothing names in one module.
struct ModuleUnused {
  module: ModuleId,
  found: List<Unused>,
}

// The modules one module's text imports: each file and barrel candidate of its import paths.
struct ModuleImports {
  module: ModuleId,
  targets: List<ModuleId>,
}

/// The modules the program's roots reach through the imports of the texts last read
/// ([`reached`]). A module an edit stopped importing is still loaded, but no longer reached.
pub struct Reach {
  modules: List<ModuleId>,
  lookup: InternIndex,
}

/// Whether `module` is among the modules `reach` holds.
pub fn reaches(reach: &Reach, module: &ModuleId) -> bool {
  let modules = List<ModuleId>.asSlice(&reach.modules)
  let mut at = InternIndex.first(&reach.lookup, ModuleId.hash(module))
  while at != usize.MAX {
    if ModuleId.equals(&modules[at], module) {
      return true
    }
    at = InternIndex.after(&reach.lookup, at)
  }
  return false
}

// Adds `module` to `reach` unless it holds it already, and reports whether it was added.
effect fn reachModule(reach: &mut Reach, module: &ModuleId) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if reaches(&reach.*, module) {
    return false
  }
  run List<ModuleId>.append(&mut reach.modules, ModuleId.copy(module))
  run InternIndex.record(&mut reach.lookup, ModuleId.hash(module))
  return true
}

// A file `preload` parses ahead on a thread of its own: the position of its module among those
// the load read, and its bytes.
// A module of a `preload` wave: its digest, the summary that names its bytes if any, and its
// bytes.
struct WaveModule {
  module: ModuleId,
  digest: ContentHash,
  found: Option<ImportSummary>,
  read: Shared<Bytes>,
}

// Takes wave module `at` out of `wave`, leaving an empty one.
effect fn takeWave(wave: &mut List<WaveModule>, at: usize) -> WaveModule
  ! OutOfMemoryError
  ? &mut Allocator {
  let held = List<WaveModule>.asMutSlice(&mut wave.*)
  let empty = WaveModule {
    module: ModuleId.copy(&held[at].module),
    digest: ContentHash { high: 0, low: 0 },
    found: Option<ImportSummary>.none(),
    read: Shared<Bytes>.clone(&held[at].read),
  }
  return Intrinsic.replace(held[at], move empty)
}

// The syntax of each of `jobs`, at its slot of `count`, parsed on up to `threads` threads beside
// this one, largest first to the lightest share. A slot a thread could not parse is none.
effect fn parseWave(jobs: List<ParseJob>, count: usize, threads: usize) -> List<Option<Parsed>>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut slots = List<Option<Parsed>>.make()
  run List<Option<Parsed>>.reserveExact(&mut slots, count)
  while List<Option<Parsed>>.length(&slots) < count {
    run List<Option<Parsed>>.append(&mut slots, Option<Parsed>.none())
  }
  let mut pending = move jobs
  let mut shares = List<List<ParseJob>>.make()
  let mut loads = List<usize>.make()
  let mut share = usize.ZERO

  // A wave of one file parses here.
  let mut used = threads
  if List<ParseJob>.length(&pending) < 2 {
    used = usize.ZERO
  }
  while share <= used {
    run List<List<ParseJob>>.append(&mut shares, List<ParseJob>.make())
    run List<usize>.append(&mut loads, usize.ZERO)
    share = share + usize.ONE
  }
  while List<ParseJob>.length(&pending) > usize.ZERO {
    let jobs = List<ParseJob>.asSlice(&pending)
    let mut largest = usize.ZERO
    let mut at = usize.ONE
    while at < jobs.length {
      if Bytes.length(&jobs[at].bytes) > Bytes.length(&jobs[largest].bytes) {
        largest = at
      }
      at = at + usize.ONE
    }
    let job = List<ParseJob>.remove(&mut pending, largest)
    let weights = List<usize>.asSlice(&loads)
    let mut lightest = usize.ZERO
    at = usize.ONE
    while at < weights.length {
      if weights[at] < weights[lightest] {
        lightest = at
      }
      at = at + usize.ONE
    }
    let load = List<usize>.get(&loads, lightest) + Bytes.length(&job.bytes)
    List<usize>.set(&mut loads, lightest, load)
    let mut writable = List<List<ParseJob>>.asMutSlice(&mut shares)
    run List<ParseJob>.append(&mut writable[lightest], move job)
  }
  let own = List<List<ParseJob>>.remove(&mut shares, usize.ZERO)
  let mut workers = List<JoinHandle<List<ParsedFile>>>.make()
  while List<List<ParseJob>>.length(&shares) > usize.ZERO {
    let jobs = List<List<ParseJob>>.remove(&mut shares, usize.ZERO)

    // A share no thread takes parses here.
    if List<JoinHandle<List<ParsedFile>>>.length(&workers) < threads {
      run parseAhead(&mut workers, move jobs)
    } else {
      run placeParsed(&mut slots, run parseEach(move jobs))
    }
  }
  run placeParsed(&mut slots, run parseEach(move own))
  while List<JoinHandle<List<ParsedFile>>>.length(&workers) > usize.ZERO {
    let handle = List<JoinHandle<List<ParsedFile>>>.remove(&mut workers, usize.ZERO)
    run placeParsed(&mut slots, handle.join())
  }
  return move slots
}

// Puts each of `files` at its slot of `slots`.
effect fn placeParsed(slots: &mut List<Option<Parsed>>, files: List<ParsedFile>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut held = move files
  while List<ParsedFile>.length(&held) > usize.ZERO {
    let last = List<ParsedFile>.length(&held) - usize.ONE
    let ParsedFile { slot, parsed } = List<ParsedFile>.remove(&mut held, last)
    let mut writable = List<Option<Parsed>>.asMutSlice(&mut slots.*)
    writable[slot] = Option<Parsed>.some(move parsed)
  }
}

struct ParseJob {
  slot: usize,
  // The module's name for the span of its parse, or nothing when the process is not traced.
  name: Bytes,
  bytes: Bytes,
}

// The name of `module` for a span, as `package:path`, or nothing when the process is not traced.
effect fn tracedName(module: &ModuleId) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  if Tracing.on() {
    return run ModuleId.copyPackagePath(module)
  }
  return Bytes.make()
}

// The syntax of the file `name`, under a span that names it.
effect fn parseFile(name: &[u8], bytes: Bytes) -> Parsed ! OutOfMemoryError ? &mut Allocator {
  let _traced = Trace.span("parse.file")
  Trace.set("module", &Tracing.label(name))
  Trace.set("bytes", &Bytes.length(&bytes))
  return run SourceUnit.parseSyntax(move bytes)
}

// What a thread parsed for one `ParseJob`.
struct ParsedFile {
  slot: usize,
  parsed: Parsed,
}

/// The existing filesystem provider selected for one canonical source request.
pub enum ProviderRole {
  Compiler,
  StandardLibrary
}

pub struct SourceLocation {
  pub provider: ProviderRole,
  /// No path exists when a standard-library request has no configured library root.
  pub path: Option<Path>,
}

fn startsWith(bytes: &[u8], prefix: &[u8]) -> bool {
  if bytes.length < prefix.length {
    return false
  }
  let mut at = usize.ZERO
  while at < prefix.length {
    if bytes[at] != prefix[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn readOptional(path: &Path) -> Option<Bytes>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let attempted = run Effect.result(FileSystem.readFile(path))
  return match move attempted {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => Option<Bytes>.some(move value)
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        if failure.reason.code == FileSystem.notFound().code {
          return Option<Bytes>.none()
        }
        run noteUnreadable(path)
        fail move failure
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// Names a source file that cannot be read on standard error, since `FileError` carries no path;
// the failure itself is reported after it.
effect fn noteUnreadable(path: &Path) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut line = run Bytes.copy(b"silk: cannot read ")
  run Bytes.append(&mut line, Path.rawBytes(path))
  run Bytes.append(&mut line, b"\n")
  let mut stderr = StderrWriter.make()
  let written = run Effect.result(
    Writer.writeAll(Bytes.asSlice(&line)) |> Effect.provideMut<Writer>(&mut stderr),
  )
  drop written
}

// The package module directory, the logical path of its selected default runtime source, its
// composition's components table and its declared native link inputs.
struct PackageRoot {
  directory: Path,
  package: Bytes,
  relative: Bytes,
  runtime: RuntimeChoice,
  components: Components,
  retention: List<RetentionRoot>,
  linkInputs: List<NativeLinkInput>,
  archives: List<Archive>,
  functionOrder: Option<Path>,
  packages: Packages,
}

// Where a package's components come from: its own `[unstable].composition`, or the standard
// library catalog when it declares no composition.
union Components {
  Declared { storage: Option<ExecutionStorage>, traceDirective: Option<TraceDirective> },
  Catalog,
}

// The bindings read so far for the selected capability.
struct BindingParts {
  components: usize,
  invalid: bool,
  first: Option<StorageBinding>,
  second: Option<StorageBinding>,
  third: Option<StorageBinding>,
  fourth: Option<StorageBinding>,
}

fn emptyParts() -> BindingParts {
  return BindingParts {
    components: usize.ZERO,
    invalid: false,
    first: Option<StorageBinding>.none(),
    second: Option<StorageBinding>.none(),
    third: Option<StorageBinding>.none(),
    fourth: Option<StorageBinding>.none(),
  }
}

fn present(binding: &Option<StorageBinding>) -> bool {
  return match &binding.* {
    Option<StorageBinding>.Some { .. } => true
    Option<StorageBinding>.None => false
  }
}

const STORAGE_OPERATIONS: [string<'static>; 4] = ["create", "acquire", "release", "destroy"]
const TRACE_OPERATIONS: [string<'static>; 4] = ["enter", "exit", "failed", "cancelled"]

struct FourBindings {
  first: StorageBinding,
  second: StorageBinding,
  third: StorageBinding,
  fourth: StorageBinding,
}

fn asStorage(found: Option<FourBindings>) -> Option<ExecutionStorage> {
  return match move found {
    Option<FourBindings>.Some {value: FourBindings {first, second, third, fourth}} =>
      Option<ExecutionStorage>.some(ExecutionStorage {create: move first, acquire: move second, release: move third, destroy: move fourth})
    Option<FourBindings>.None => Option<ExecutionStorage>.none()
  }
}

fn asTraceDirective(found: Option<FourBindings>) -> Option<TraceDirective> {
  return match move found {
    Option<FourBindings>.Some {value: FourBindings {first, second, third, fourth}} =>
      Option<TraceDirective>.some(TraceDirective {enter: move first, exit: move second, failed: move third, cancelled: move fourth})
    Option<FourBindings>.None => Option<TraceDirective>.none()
  }
}

// The package identity of every standard-library module (PACKAGE-005): the implicit dependency
// `silk`, which every package in a build shares. A package's own identity is `name@version`, so it
// never equals this one.
fn standardPackage() -> &'static [u8] {
  return b"silk"
}

// The package that owns the module at logical path `logical` of the package `package`: the
// standard library for a standard-library path, and `package` otherwise.
fn owningPackage<'a>(package: &'a [u8], logical: &[u8]) -> &'a [u8] {
  if startsWith(logical, b"silk/") || SealedOperators.isPath(logical) {
    return standardPackage()
  }
  return package
}

// Records one binding; an unknown, repeated or unresolvable operation invalidates the component.
effect fn bind(
  parts: &mut BindingParts,
  operations: &[string<'static>; 4],
  package: &[u8],
  operation: &[u8],
  module: &[u8],
  declaration: &[u8],
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut logical = run Bytes.copy(module)
  run Bytes.append(&mut logical, b".silk")
  let resolved = run Effect.result(
    ModuleId.make(
      b"file",
      owningPackage(package, Bytes.asSlice(&logical)),
      Bytes.asSlice(&logical),
    ),
  )
  let identity = match move resolved {
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success { value } => move value
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure { error } => match move error {
      InvalidModulePath {} => {
        parts.invalid = true
        return ()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let binding = Option<StorageBinding>.some(
    StorageBinding { module: move identity, declaration: run Bytes.copy(declaration) },
  )
  if sameText(operation, String.utf8Bytes(operations[0])) && !present(&parts.first) {
    parts.first = move binding
  } else if sameText(operation, String.utf8Bytes(operations[1])) && !present(&parts.second) {
    parts.second = move binding
  } else if sameText(operation, String.utf8Bytes(operations[2])) && !present(&parts.third) {
    parts.third = move binding
  } else if sameText(operation, String.utf8Bytes(operations[3])) && !present(&parts.fourth) {
    parts.fourth = move binding
  } else {
    parts.invalid = true
  }
  return ()
}

// Exactly one execution-storage component with all four operations selects storage.
fn finishBindings(parts: BindingParts) -> Option<FourBindings> {
  let BindingParts { components, invalid, first, second, third, fourth } = move parts
  if components != usize.ONE || invalid {
    return Option<FourBindings>.none()
  }
  if let Option<StorageBinding>.Some { value: created } = move first {
    if let Option<StorageBinding>.Some { value: acquired } = move second {
      if let Option<StorageBinding>.Some { value: released } = move third {
        if let Option<StorageBinding>.Some { value: destroyed } = move fourth {
          return Option<FourBindings>.some(
            FourBindings {
              first: move created,
              second: move acquired,
              third: move released,
              fourth: move destroyed,
            },
          )
        }
      }
    }
  }
  return Option<FourBindings>.none()
}

// Whether every key of the table `value` is one of `allowed`.
fn onlyKeys(value: &TomlValue, allowed: &[&[u8]]) -> bool {
  return match &value.* {
    TomlValue.Table { entries, kind: _ } => {
      let boxed = Box<List<TomlChild>>.get(&entries)
      let children = List<TomlChild>.asSlice(&boxed[0])
      let mut at = usize.ZERO
      while at < children.length {
        if let TomlChild.Member { entry } = &children[at] {
          let key = String.ownedUtf8Bytes(&entry.key)
          let mut known = false
          let mut index = usize.ZERO
          while index < allowed.length {
            if sameText(key, allowed[index]) {
              known = true
            }
            index = index + usize.ONE
          }
          if !known {
            return false
          }
        }
        at = at + usize.ONE
      }
      return true
    }
    _ => false
  }
}

// Whether `text` is an identifier: an ASCII letter or `_`, then letters, digits or `_`.
fn identifier(text: &[u8]) -> bool {
  if text.length == usize.ZERO {
    return false
  }
  let mut at = usize.ZERO
  while at < text.length {
    let byte = text[at]
    let letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
    let digit = byte >= 48 && byte <= 57
    if !letter && !(digit && at > usize.ZERO) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Reads `retention` from a manifest composition: selectors of exactly a canonical `module` and an
// identifier `declaration`, as the TypeScript `ArtifactComposition.decode` admits.
effect fn manifestRetention(composition: &TomlValue, package: &[u8]) -> List<RetentionRoot>
  ! InvalidBuildComposition | OutOfMemoryError
  ? &mut Allocator {
  let mut roots = List<RetentionRoot>.make()
  let listed = match move Toml.field(composition, "retention") {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      return move roots
    }
  }
  let array = match &listed.* {
    TomlValue.Array { .. } => true
    _ => false
  }
  if !array {
    fail InvalidBuildComposition { detail: Bytes.make() }
  }
  let keys: [&[u8]; 2] = [b"module", b"declaration"]
  let mut at = usize.ZERO
  while true {
    let selector = match move Toml.item(listed, at) {
      Option<&TomlValue>.Some { value } => value
      Option<&TomlValue>.None => {
        break
      }
    }
    at = at + usize.ONE
    if !onlyKeys(selector, &keys) {
      fail InvalidBuildComposition { detail: Bytes.make() }
    }
    let module = match move Toml.asString(Toml.field(selector, "module")) {
      Option<string>.Some { value } => String.utf8Bytes(value)
      Option<string>.None => {
        fail InvalidBuildComposition { detail: Bytes.make() }
      }
    }
    let declaration = match move Toml.asString(Toml.field(selector, "declaration")) {
      Option<string>.Some { value } => String.utf8Bytes(value)
      Option<string>.None => {
        fail InvalidBuildComposition { detail: Bytes.make() }
      }
    }
    if !identifier(declaration) {
      fail InvalidBuildComposition { detail: Bytes.make() }
    }
    let mut logical = run Bytes.copy(module)
    run Bytes.append(&mut logical, b".silk")
    let resolved = run Effect.result(
      ModuleId.make(
        b"file",
        owningPackage(package, Bytes.asSlice(&logical)),
        Bytes.asSlice(&logical),
      ),
    )
    let identity = match move resolved {
      Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success { value } => move value
      Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure { error } => match move error {
        InvalidModulePath {} => {
          fail InvalidBuildComposition { detail: Bytes.make() }
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    run List<RetentionRoot>.append(
      &mut roots,
      RetentionRoot { module: move identity, declaration: run Bytes.copy(declaration) },
    )
  }
  return move roots
}

// Reads `components` from a manifest composition.
effect fn manifestBindings(composition: &TomlValue, package: &[u8], selected: &[u8], operations: &[string<'static>; 4]) -> Option<FourBindings>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut parts = emptyParts()
  let listed = match move Toml.field(composition, "components") {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      return Option<FourBindings>.none()
    }
  }
  let mut at = usize.ZERO
  while true {
    let component = match move Toml.item(listed, at) {
      Option<&TomlValue>.Some { value } => value
      Option<&TomlValue>.None => {
        break
      }
    }
    at = at + usize.ONE
    let capability = match move Toml.asString(Toml.field(component, "capability")) {
      Option<string>.Some { value } => String.utf8Bytes(value)
      Option<string>.None => {
        return Option<FourBindings>.none()
      }
    }
    if !sameText(capability, selected) {
      continue
    }
    parts.components = parts.components + usize.ONE
    let bindings = match move Toml.field(component, "bindings") {
      Option<&TomlValue>.Some { value } => value
      Option<&TomlValue>.None => {
        return Option<FourBindings>.none()
      }
    }
    let mut bindingAt = usize.ZERO
    while true {
      let entry = match move Toml.item(bindings, bindingAt) {
        Option<&TomlValue>.Some { value } => value
        Option<&TomlValue>.None => {
          break
        }
      }
      bindingAt = bindingAt + usize.ONE
      let operation = Toml.asString(Toml.field(entry, "operation"))
      let module = Toml.asString(Toml.field(entry, "module"))
      let declaration = Toml.asString(Toml.field(entry, "declaration"))
      if let Option<string>.Some { value: operationText } = move operation {
        if let Option<string>.Some { value: moduleText } = move module {
          if let Option<string>.Some { value: declarationText } = move declaration {
            run bind(
              &mut parts,
              operations,
              package,
              String.utf8Bytes(operationText),
              String.utf8Bytes(moduleText),
              String.utf8Bytes(declarationText),
            )
            continue
          }
        }
      }
      return Option<FourBindings>.none()
    }
  }
  return finishBindings(move parts)
}

fn jsonItem<'a>(value: &'a JsonValue, index: usize) -> Option<&'a JsonValue> {
  return match &value.* {
    JsonValue.Array { values } => {
      let items = List<JsonValue>.asSlice(&values)
      if index >= items.length {
        return Option<&'a JsonValue>.none()
      }
      return Option<&'a JsonValue>.some(&items[index])
    }
    _ => Option<&'a JsonValue>.none()
  }
}

// Parses the standard library's composition catalog, absent when the library has none or it is
// malformed.
effect fn catalog(directory: &Path) -> Option<JsonValue>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let path = run Path.join(directory, "compositions.json")
  let read = run readOptional(&path)
  let contents = match move read {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return Option<JsonValue>.none()
    }
  }
  let parsed = run Effect.result(Json.parse(Bytes.asSlice(&contents)))
  return match move parsed {
    Result<JsonValue, JsonError | OutOfMemoryError>.Success { value } => Option<JsonValue>.some(
      move value,
    )
    Result<JsonValue, JsonError | OutOfMemoryError>.Failure { error } => match move error {
      JsonError malformed => {
        drop malformed
        return Option<JsonValue>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// The support modules the catalog lists for `target`, in catalog order: their logical source
// paths, and whether each one's C exports are also the module's host exports.
effect fn catalogSupport(
  document: &JsonValue,
  target: &[u8],
  paths: &mut List<Bytes>,
  hosted: &mut List<bool>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let listed = match move Json.field(document, "support") {
    Option<&JsonValue>.Some { value } => value
    Option<&JsonValue>.None => {
      return ()
    }
  }
  let mut at = usize.ZERO
  while true {
    let support = match move jsonItem(listed, at) {
      Option<&JsonValue>.Some { value } => value
      Option<&JsonValue>.None => {
        break
      }
    }
    at = at + usize.ONE
    let targets = match move Json.field(support, "targets") {
      Option<&JsonValue>.Some { value } => value
      Option<&JsonValue>.None => {
        continue
      }
    }
    let mut targetAt = usize.ZERO
    while true {
      let named = match move jsonItem(targets, targetAt) {
        Option<&JsonValue>.Some { value } => value
        Option<&JsonValue>.None => {
          break
        }
      }
      targetAt = targetAt + usize.ONE
      let matches = match move Json.asString(Option<&JsonValue>.some(named)) {
        Option<string>.Some { value } => sameText(String.utf8Bytes(value), target)
        Option<string>.None => false
      }
      if !matches {
        continue
      }
      if let Option<string>.Some { value: module } = move Json.asString(
        Json.field(support, "module"),
      ) {
        let mut logical = run Bytes.copy(String.utf8Bytes(module))
        run Bytes.append(&mut logical, b".silk")
        run List<Bytes>.append(&mut paths.*, move logical)
        let mut host = false
        if let Option<&JsonValue>.Some { value: flag } = move Json.field(support, "host-exports") {
          if let JsonValue.Bool { value } = &flag.* {
            host = value
          }
        }
        run List<bool>.append(&mut hosted.*, host)
      }
      break
    }
  }
  return ()
}

// The logical source path of the catalog runtime listed for `target` and `libc`, if any.
effect fn catalogRuntime(
  document: &JsonValue,
  target: &[u8],
  libc: &[u8],
  named: Option<&[u8]>,
) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let listed = match move Json.field(document, "runtimes") {
    Option<&JsonValue>.Some { value } => value
    Option<&JsonValue>.None => {
      return Option<Bytes>.none()
    }
  }
  let mut at = usize.ZERO
  while true {
    let runtime = match move jsonItem(listed, at) {
      Option<&JsonValue>.Some { value } => value
      Option<&JsonValue>.None => {
        break
      }
    }
    at = at + usize.ONE
    let matchesLibc = match move Json.asString(Json.field(runtime, "libc")) {
      Option<string>.Some { value } => sameText(String.utf8Bytes(value), libc)
      Option<string>.None => false
    }
    if !matchesLibc {
      continue
    }
    if let Option<&[u8]>.Some { value: wanted } = &named {
      let matchesName = match move Json.asString(Json.field(runtime, "name")) {
        Option<string>.Some { value } => sameText(String.utf8Bytes(value), wanted)
        Option<string>.None => false
      }
      if !matchesName {
        continue
      }
    }
    let targets = match move Json.field(runtime, "targets") {
      Option<&JsonValue>.Some { value } => value
      Option<&JsonValue>.None => {
        continue
      }
    }
    let mut targetAt = usize.ZERO
    while true {
      let named = match move jsonItem(targets, targetAt) {
        Option<&JsonValue>.Some { value } => value
        Option<&JsonValue>.None => {
          break
        }
      }
      targetAt = targetAt + usize.ONE
      let selected = match move Json.asString(Option<&JsonValue>.some(named)) {
        Option<string>.Some { value } => sameText(String.utf8Bytes(value), target)
        Option<string>.None => false
      }
      if !selected {
        continue
      }
      let module = match move Json.asString(Json.field(runtime, "module")) {
        Option<string>.Some { value } => value
        Option<string>.None => {
          return Option<Bytes>.none()
        }
      }
      let mut logical = run Bytes.copy(String.utf8Bytes(module))
      run Bytes.append(&mut logical, b".silk")
      return Option<Bytes>.some(move logical)
    }
  }
  return Option<Bytes>.none()
}

// A composition may select a standard-library runtime by its module, as `silk/platform/native/start`
// for a `wasm32-wasip1` profile. The catalog lists the targets each such runtime starts; any other
// target is refused here, before its start module fails to compile, and the catalog's runtime for
// the target, if any, is named instead.
effect fn requireRuntimeTarget(
  document: &JsonValue,
  selected: &[u8],
  target: &[u8],
  libc: &[u8],
) -> ()
  ! InvalidBuildComposition | OutOfMemoryError
  ? &mut Allocator {
  let listed = match move Json.field(document, "runtimes") {
    Option<&JsonValue>.Some { value } => value
    Option<&JsonValue>.None => {
      return ()
    }
  }
  let mut catalogued = false
  let mut at = usize.ZERO
  while true {
    let runtime = match move jsonItem(listed, at) {
      Option<&JsonValue>.Some { value } => value
      Option<&JsonValue>.None => {
        break
      }
    }
    at = at + usize.ONE
    let module = match move Json.asString(Json.field(runtime, "module")) {
      Option<string>.Some { value } => String.utf8Bytes(value)
      Option<string>.None => {
        continue
      }
    }
    if selected.length != module.length + 5 || !startsWith(selected, module) {
      continue
    }
    catalogued = true
    let targets = match move Json.field(runtime, "targets") {
      Option<&JsonValue>.Some { value } => value
      Option<&JsonValue>.None => {
        continue
      }
    }
    let mut targetAt = usize.ZERO
    while true {
      let named = match move jsonItem(targets, targetAt) {
        Option<&JsonValue>.Some { value } => value
        Option<&JsonValue>.None => {
          break
        }
      }
      targetAt = targetAt + usize.ONE
      if let Option<string>.Some { value } = move Json.asString(Option<&JsonValue>.some(named)) {
        if sameText(String.utf8Bytes(value), target) {
          return ()
        }
      }
    }
  }
  if !catalogued {
    return ()
  }
  let mut detail = run Bytes.copy(b"the runtime module ")
  run Bytes.append(&mut detail, Slice.view<u8>(selected, usize.ZERO, selected.length - 5))
  run Bytes.append(&mut detail, b" does not support the target ")
  run Bytes.append(&mut detail, target)
  if let Option<Bytes>.Some { value: suggested } = move run catalogRuntime(
    document,
    target,
    libc,
    Option<&[u8]>.none(),
  ) {
    run Bytes.append(&mut detail, b"; list ")
    let path = Bytes.asSlice(&suggested)
    run Bytes.append(&mut detail, Slice.view<u8>(path, usize.ZERO, path.length - 5))
    run Bytes.append(
      &mut detail,
      b" in [unstable.composition].runtimes and select it with `Compilation.runtime` in the root's tasks.silk",
    )
  }
  fail InvalidBuildComposition { detail: move detail }
}

// Reads `components` from the standard library's composition catalog.
effect fn catalogBindings(document: &JsonValue, package: &[u8], selected: &[u8], operations: &[string<'static>; 4]) -> Option<FourBindings>
  ! OutOfMemoryError
  ? &mut Allocator {
  let listed = match move Json.field(document, "components") {
    Option<&JsonValue>.Some { value } => value
    Option<&JsonValue>.None => {
      return Option<FourBindings>.none()
    }
  }
  let mut parts = emptyParts()
  let mut at = usize.ZERO
  while true {
    let component = match move jsonItem(listed, at) {
      Option<&JsonValue>.Some { value } => value
      Option<&JsonValue>.None => {
        break
      }
    }
    at = at + usize.ONE
    let capability = match move Json.asString(Json.field(component, "capability")) {
      Option<string>.Some { value } => String.utf8Bytes(value)
      Option<string>.None => {
        return Option<FourBindings>.none()
      }
    }
    if !sameText(capability, selected) {
      continue
    }
    parts.components = parts.components + usize.ONE
    let bindings = match move Json.field(component, "bindings") {
      Option<&JsonValue>.Some { value } => value
      Option<&JsonValue>.None => {
        return Option<FourBindings>.none()
      }
    }
    let mut bindingAt = usize.ZERO
    while true {
      let entry = match move jsonItem(bindings, bindingAt) {
        Option<&JsonValue>.Some { value } => value
        Option<&JsonValue>.None => {
          break
        }
      }
      bindingAt = bindingAt + usize.ONE
      let operation = Json.asString(Json.field(entry, "operation"))
      let module = Json.asString(Json.field(entry, "module"))
      let declaration = Json.asString(Json.field(entry, "declaration"))
      if let Option<string>.Some { value: operationText } = move operation {
        if let Option<string>.Some { value: moduleText } = move module {
          if let Option<string>.Some { value: declarationText } = move declaration {
            run bind(
              &mut parts,
              operations,
              package,
              String.utf8Bytes(operationText),
              String.utf8Bytes(moduleText),
              String.utf8Bytes(declarationText),
            )
            continue
          }
        }
      }
      return Option<FourBindings>.none()
    }
  }
  return finishBindings(move parts)
}

// Records in `graph` the module paths that `standard` in the standard library's composition catalog
// lists by role, such as `"layout": "silk/mem/layout"`. A role the catalog omits keeps its canonical
// path; one it lists as anything but a path is an invalid catalog.
effect fn catalogRoles(document: &JsonValue, graph: &mut PackageGraph) -> ()
  ! InvalidBuildComposition | OutOfMemoryError
  ? &mut Allocator {
  let listed = match move Json.field(document, "standard") {
    Option<&JsonValue>.Some { value } => value
    Option<&JsonValue>.None => {
      return ()
    }
  }
  run catalogRole(listed, "layout", StandardRole.Layout, &mut graph.*)
  run catalogRole(listed, "option", StandardRole.Option, &mut graph.*)
  run catalogRole(listed, "ops", StandardRole.Ops, &mut graph.*)
  run catalogRole(listed, "equal", StandardRole.Equal, &mut graph.*)
  return run catalogRole(listed, "order", StandardRole.Order, &mut graph.*)
}

effect fn catalogRole(
  listed: &JsonValue,
  name: string,
  which: StandardRole,
  graph: &mut PackageGraph,
) -> ()
  ! InvalidBuildComposition | OutOfMemoryError
  ? &mut Allocator {
  let entry = match move Json.field(listed, name) {
    Option<&JsonValue>.Some { value } => value
    Option<&JsonValue>.None => {
      return ()
    }
  }
  let module = match move Json.asString(Option<&JsonValue>.some(entry)) {
    Option<string>.Some { value } => value
    Option<string>.None => {
      fail InvalidBuildComposition { detail: Bytes.make() }
    }
  }
  if !libraryModulePath(String.utf8Bytes(module)) {
    fail InvalidBuildComposition { detail: Bytes.make() }
  }
  let mut logical = run Bytes.copy(String.utf8Bytes(module))
  run Bytes.append(&mut logical, b".silk")
  return run PackageGraph.assign(&mut graph.*, which, Bytes.asSlice(&logical))
}

// Whether `path` names a module below the library root, such as `silk/mem/layout`: `silk/` and
// then segments that are neither empty, `.` nor `..`.
fn libraryModulePath(path: &[u8]) -> bool {
  if !startsWith(path, b"silk/") {
    return false
  }
  let mut start: usize = 5
  let mut at: usize = 5
  while at <= path.length {
    if at == path.length || path[at] == 47 {
      let length = at - start
      if length == 0 {
        return false
      }
      if length == 1 && path[start] == 46 {
        return false
      }
      if length == 2 && path[start] == 46 && path[start + 1] == 46 {
        return false
      }
      start = at + 1
    }
    at = at + 1
  }
  return true
}

fn sameText(left: &[u8], right: &[u8]) -> bool {
  return left.length == right.length && startsWith(left, right)
}

// How a package selects its runtime: its `[unstable].composition` default, which may be absent for a
// library or object form, or the standard-library catalog when it declares no composition.
union RuntimeChoice {
  Declared { module: Option<Bytes> },
  Catalog,
}

// Resolves `[unstable].composition` for the profile's runtime `request`, `Catalog` when the manifest
// declares none. A `none` request selects no runtime. A named request selects the listed runtime
// of that name. The default request selects the composition's single default candidate, which only
// an executable requires; any other shape is invalid and never falls back to a hosted runtime.
effect fn defaultRuntime(
  document: &TomlValue,
  executable: bool,
  request: &RuntimeRequest,
) -> RuntimeChoice
  ! InvalidBuildComposition | OutOfMemoryError
  ? &mut Allocator {
  let composition = match move ManifestFields.composition(document) {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      return RuntimeChoice.Catalog
    }
  }
  match &request.* {
    RuntimeRequest.None => {
      return RuntimeChoice.Declared { module: Option<Bytes>.none() }
    }
    RuntimeRequest.Named { name } => {
      return RuntimeChoice.Declared {
        module: Option<Bytes>.some(run listedRuntime(composition, Bytes.asSlice(&name))),
      }
    }
    RuntimeRequest.Default => {}
  }
  let defaults = match move Toml.field(composition, "defaults") {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      if executable {
        fail InvalidBuildComposition { detail: Bytes.make() }
      }
      return RuntimeChoice.Declared { module: Option<Bytes>.none() }
    }
  }
  let listed = match &defaults.* {
    TomlValue.Array { .. } => true
    _ => false
  }
  if !listed {
    fail InvalidBuildComposition { detail: Bytes.make() }
  }

  // An executable needs a runtime; an explicit composition never falls back to the catalog.
  if let Option<&TomlValue>.None = move Toml.item(defaults, usize.ZERO) {
    if executable {
      fail InvalidBuildComposition { detail: Bytes.make() }
    }
    return RuntimeChoice.Declared { module: Option<Bytes>.none() }
  }

  // Two default candidates are ambiguous even when both would compile for the target.
  if let Option<&TomlValue>.Some { .. } = move Toml.item(defaults, usize.ONE) {
    fail InvalidBuildComposition { detail: Bytes.make() }
  }
  let selected = match move Toml.asString(Toml.item(defaults, usize.ZERO)) {
    Option<string>.Some { value } => String.utf8Bytes(value)
    Option<string>.None => {
      fail InvalidBuildComposition { detail: Bytes.make() }
    }
  }
  return RuntimeChoice.Declared {
    module: Option<Bytes>.some(run listedRuntime(composition, selected)),
  }
}

// The logical module path of the runtime the composition lists as `selected`. A name the
// composition does not list never falls back to a hosted runtime.
effect fn listedRuntime(composition: &TomlValue, selected: &[u8]) -> Bytes
  ! InvalidBuildComposition | OutOfMemoryError
  ? &mut Allocator {
  let runtimes = match move Toml.field(composition, "runtimes") {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      fail InvalidBuildComposition { detail: Bytes.make() }
    }
  }
  let mut at = usize.ZERO
  while true {
    let descriptor = match move Toml.item(runtimes, at) {
      Option<&TomlValue>.Some { value } => value
      Option<&TomlValue>.None => {
        break
      }
    }
    at = at + usize.ONE
    let named = match move Toml.asString(Toml.field(descriptor, "name")) {
      Option<string>.Some { value } => String.utf8Bytes(value)
      Option<string>.None => {
        fail InvalidBuildComposition { detail: Bytes.make() }
      }
    }
    if sameText(named, selected) {
      let module = match move Toml.asString(Toml.field(descriptor, "module")) {
        Option<string>.Some { value } => String.utf8Bytes(value)
        Option<string>.None => {
          fail InvalidBuildComposition { detail: Bytes.make() }
        }
      }
      let mut logical = run Bytes.copy(module)
      run Bytes.append(&mut logical, b".silk")
      return move logical
    }
  }
  fail InvalidBuildComposition { detail: Bytes.make() }
}

// The manifest's logical package identity: `[package].name`, `@` and `[package].version`, which
// defaults to `0.0.0` (PROFILE-002). Physical checkout paths are not identities.
effect fn packageIdentity(document: &TomlValue) -> Bytes
  ! InvalidSourceRoot | OutOfMemoryError
  ? &mut Allocator {
  let name = match move Toml.asString(Toml.fieldAt(Toml.field(document, "package"), "name")) {
    Option<string>.Some { value } => String.utf8Bytes(value)
    Option<string>.None => {
      fail InvalidSourceRoot {}
    }
  }
  if name.length == usize.ZERO {
    fail InvalidSourceRoot {}
  }
  let version = ManifestFields.version(document)
  if version.length == usize.ZERO {
    fail InvalidSourceRoot {}
  }
  let mut identity = run Bytes.copy(name)
  run Bytes.append(&mut identity, b"@")
  run Bytes.append(&mut identity, version)
  return move identity
}

// Reads the package that the manifest `contents`, read from `manifest` in `directory`, declares.
/// What the archives of a build for `target` resolve against: the archive store beside the git
/// checkout `store` (`$SILK_HOME/archives`), and no overrides yet.
pub effect fn archiveContext(store: Option<&Path>, target: &[u8]) -> ArchiveContext
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut archives = Option<Path>.none()
  if let Option<&Path>.Some { value: checkouts } = move store {
    if let Option<Path>.Some { value: home } = move run Path.parent(checkouts) {
      archives = Option<Path>.some(run Path.join(&home, "archives"))
    }
  }
  return ArchiveContext {
    target: run Bytes.copy(target),
    store: move archives,
    overrides: List<NativeLinkInputs.Override>.make(),
  }
}

// Adds the overrides of the machine's `native-overrides.toml` in the Silk home, beside the archive
// store, to `context`.
effect fn machineOverrides(context: &mut ArchiveContext) -> ()
  ! FileError | TomlError | InvalidNativeLinkInput | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let home = match &context.store {
    Option<Path>.Some { value } => match move run Path.parent(&value) {
      Option<Path>.Some { value: parent } => move parent
      Option<Path>.None => {
        return ()
      }
    }
    Option<Path>.None => {
      return ()
    }
  }
  let file = run Path.join(&home, "native-overrides.toml")
  if let Option<Bytes>.Some { value: contents } = move run readOptional(&file) {
    let document = run Toml.parse(Bytes.asSlice(&contents))
    run NativeLinkInputs.appendOverrides(&document, &file, &home, &mut context.overrides)
  }
  return ()
}

// Refuses an archive name that two packages of the build both declare: one package owns each
// native archive, so two copies of a library never link together.
effect fn refuseSharedArchives(root: &[u8], archives: &[Archive], packages: &Packages) -> ()
  ! InvalidNativeLinkInput | OutOfMemoryError
  ? &mut Allocator {
  let count = PackageSources.count(packages)
  let mut first = usize.ONE
  while first < count {
    run refuseShared(
      root,
      archives,
      PackageSources.packageIdentity(packages, first),
      PackageSources.archives(packages, first),
    )
    let mut second = first + usize.ONE
    while second < count {
      run refuseShared(
        PackageSources.packageIdentity(packages, first),
        PackageSources.archives(packages, first),
        PackageSources.packageIdentity(packages, second),
        PackageSources.archives(packages, second),
      )
      second = second + usize.ONE
    }
    first = first + usize.ONE
  }
  return ()
}

// Refuses an archive name that both `mine`, of package `owner`, and `theirs`, of `other`, declare.
effect fn refuseShared(owner: &[u8], mine: &[Archive], other: &[u8], theirs: &[Archive]) -> ()
  ! InvalidNativeLinkInput | OutOfMemoryError
  ? &mut Allocator {
  let mut left = usize.ZERO
  while left < mine.length {
    let mut right = usize.ZERO
    while right < theirs.length {
      if sameText(Bytes.asSlice(&mine[left].name), Bytes.asSlice(&theirs[right].name)) {
        let mut detail = run Bytes.copy(b"archive ")
        run Bytes.append(&mut detail, Bytes.asSlice(&mine[left].name))
        run Bytes.append(&mut detail, b" is declared by both ")
        run Bytes.append(&mut detail, owner)
        run Bytes.append(&mut detail, b" and ")
        run Bytes.append(&mut detail, other)
        run Bytes.append(
          &mut detail,
          b"; one package owns each archive name, so two copies never link together",
        )
        fail InvalidNativeLinkInput { detail: move detail }
      }
      right = right + usize.ONE
    }
    left = left + usize.ONE
  }
  return ()
}

effect fn packageRoot(
  manifest: &Path,
  directory: &Path,
  contents: &Bytes,
  executable: bool,
  request: &RuntimeRequest,
  store: Option<&Path>,
  target: &[u8],
  definition: Option<&Definition>,
  versions: Versions,
) -> PackageRoot
  ! FileError
    | TomlError
    | InvalidSourceRoot
    | InvalidDependency
    | InvalidBuildComposition
    | InvalidNativeLinkInput
    | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut document = run Toml.parse(Bytes.asSlice(contents))
  if let Option<&Definition>.Some { value } = definition {
    run Definitions.exclude(&mut document, value)
  }
  let identity = run packageIdentity(&document)

  // Modules resolve below `[package].source` (driver/ManifestFields).
  let selected = run ManifestFields.sourceRoot(directory, &document)
  let runtime = run defaultRuntime(&document, executable, request)
  let mut components = Components.Catalog
  let mut retention = List<RetentionRoot>.make()
  if let Option<&TomlValue>.Some { value: composition } = move ManifestFields.composition(
    &document,
  ) {
    components = Components.Declared {
      storage: asStorage(run manifestBindings(composition, Bytes.asSlice(&identity), b"execution-storage", &STORAGE_OPERATIONS)),
      traceDirective: asTraceDirective(run manifestBindings(composition, Bytes.asSlice(&identity), b"trace-directive", &TRACE_OPERATIONS)),
    }
    retention = run manifestRetention(composition, Bytes.asSlice(&identity))
  }

  // The machine's overrides win over the root's, which win over nothing; a dependency's manifest
  // never overrides.
  let mut context = run archiveContext(store, target)
  run machineOverrides(&mut context)
  run NativeLinkInputs.appendOverrides(&document, manifest, directory, &mut context.overrides)
  let archives = run NativeLinkInputs.archivesOf(
    &document,
    manifest,
    Bytes.asSlice(contents),
    &context,
  )
  let relative = run CommandPath.relative(directory, &selected)
  let mut packages = run PackageSources.load(
    directory,
    move document,
    Bytes.asSlice(&identity),
    &selected,
    store,
    move context,
    versions,
  )
  run refuseSharedArchives(Bytes.asSlice(&identity), archives.asSlice(), &packages)
  run PackageSources.setRootArchives(&mut packages, archives.asSlice())
  return PackageRoot {
    directory: move selected,
    package: move identity,
    relative: move relative,
    runtime: move runtime,
    components: move components,
    retention: move retention,
    linkInputs: List<NativeLinkInput>.make(),
    archives: move archives,
    functionOrder: Option<Path>.none(),
    packages: move packages,
  }
}

effect fn sourceRoot(
  source: &Path,
  executable: bool,
  request: &RuntimeRequest,
  store: Option<&Path>,
  target: &[u8],
) -> PackageRoot
  ! FileError
    | TomlError
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | InvalidNativeLinkInput
    | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let parent = run Path.parent(source)
  let mut directory = match move parent {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      fail InvalidSourceRoot {}
    }
  }
  let start = run Path.fromBytes(Path.rawBytes(&directory))
  while true {
    let manifest = run Path.join(&directory, "silk.toml")
    let contents = run readOptional(&manifest)
    if let Option<Bytes>.Some { value } = move contents {
      return run packageRoot(
        &manifest,
        &directory,
        &value,
        executable,
        request,
        store,
        target,
        Option<&Definition>.none(),
        Versions.Checked,
      )
    }
    let parent = run CommandPath.parent(&directory)
    if let Option<Path>.Some { value } = move parent {
      directory = move value
    } else {
      break
    }
  }

  // Without a manifest a build has no logical package identity, and a host path is never one.
  fail MissingManifest { directory: move start }
}

effect fn logicalEntry(root: &Path, source: &Path) -> Bytes
  ! InvalidSourceRoot | OutOfMemoryError
  ? &mut Allocator {
  let mut prefix = run Bytes.copy(Path.rawBytes(root))
  if !Path.isRoot(root) {
    run Bytes.append(&mut prefix, b"/")
  }
  let bytes = Path.rawBytes(source)
  let directory = Bytes.asSlice(&prefix)
  if !startsWith(bytes, directory) || bytes.length <= directory.length {
    fail InvalidSourceRoot {}
  }
  let mut logical = Bytes.make()
  let mut at = directory.length
  while at < bytes.length {
    run Bytes.append(&mut logical, &[bytes[at]])
    at = at + usize.ONE
  }
  return move logical
}

/// Reads the entry and nearest package manifest, including its native link inputs, and selects the
/// runtime the profile's `runtime` request names: by default the manifest composition's default,
/// or else, for an `executable` artifact, the standard-library catalog runtime for `target` and
/// `libc`; a named request selects the composition or catalog runtime of that name; `none` selects
/// no runtime and no catalog component (ARTIFACT-001). A catalog runtime without a standard
/// library is [`MissingStandardLibrary`]. A library or object form acquires no catalog runtime or
/// storage component (ARTIFACT-002). Git dependencies read their checkouts in `store`
/// (driver/GitCheckouts). No imported or runtime module is read here.
pub effect fn make(
  source: &Path,
  standardLibrary: Option<Path>,
  store: Option<&Path>,
  target: &[u8],
  libc: &[u8],
  executable: bool,
  runtime: RuntimeRequest,
) -> ModuleSources
  ! FileError
    | TomlError
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | InvalidModulePath
    | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let located = run sourceRoot(source, executable, &runtime, store, target)
  run refuseReservedModules(source, &located, &standardLibrary)
  return run assemble(
    source,
    move located,
    move standardLibrary,
    target,
    libc,
    executable,
    executable,
    &runtime,
    Option<&Path>.none(),
  )
}

// Refuses a package whose source root holds a module or module directory named `silk` or
// `Intrinsic`: `silk.` imports always name the standard library and `Intrinsic` the compiler's
// intrinsics, so such a module could never be imported. The standard library itself, built as
// the root package, is exempt, as is a reserved directory that holds the entry itself.
effect fn refuseReservedModules(
  source: &Path,
  located: &PackageRoot,
  standardLibrary: &Option<Path>,
) -> ()
  ! InvalidDependency | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if let Option<Path>.Some { value } = &standardLibrary.* {
    if sameText(Path.rawBytes(&located.directory), Path.rawBytes(&value)) {
      return ()
    }
  }

  // Listing the root, rather than probing each name, keeps a root that cannot be listed (or a
  // host that only serves files) from being refused: the import still fails later if it matters.
  let children = match move run Effect.result(FileSystem.listDirectory(&located.directory)) {
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success { value } => move value
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      FileError failure => {
        drop failure
        return ()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let listed = List<DirectoryEntry>.asSlice(&children)
  let prefix = Path.rawBytes(&located.directory).length + usize.ONE
  let mut at = usize.ZERO
  while at < listed.length {
    let child = Path.rawBytes(&listed[at].path)
    let mut reserved = false
    if child.length > prefix && startsWith(child, Path.rawBytes(&located.directory)) {
      let name = Slice.view<u8>(child, prefix, child.length - prefix)
      reserved = sameText(name, b"silk") || sameText(name, b"silk.silk")
        || sameText(name, b"Intrinsic")
        || sameText(name, b"Intrinsic.silk")
    }
    if reserved && !holdsEntry(child, Path.rawBytes(source)) {
      let mut detail = run Bytes.copy(b"module ")
      run Bytes.append(&mut detail, child)
      run Bytes.append(&mut detail, b" of ")
      run Bytes.append(&mut detail, Bytes.asSlice(&located.package))
      run Bytes.append(
        &mut detail,
        b": `silk` and `Intrinsic` are reserved module names (`silk.` imports name the standard library and `Intrinsic` the compiler's intrinsics); rename it",
      )
      fail InvalidDependency { detail: move detail, manifest: Bytes.make(), line: usize.ZERO }
    }
    at = at + usize.ONE
  }
  return ()
}

fn holdsEntry(directory: &[u8], source: &[u8]) -> bool {
  return source.length > directory.length && source[directory.length] == 47
    && startsWith(source, directory)
}

/// Loads `source` in the package declared by `manifest`, with the selected standard library.
/// `executable` enables runtime selection; `linked` includes target support modules and
/// dependency native inputs for executables and loadable modules. `root` overrides the entry
/// source path, and `definition` supplies package settings during resolution.
pub effect fn makeInPackage(
  source: &Path,
  manifest: &Path,
  standardLibrary: Option<Path>,
  store: Option<&Path>,
  target: &[u8],
  libc: &[u8],
  executable: bool,
  linked: bool,
  runtime: RuntimeRequest,
  root: Option<&Path>,
  definition: Option<&Definition>,
  versions: Versions,
) -> ModuleSources
  ! FileError
    | TomlError
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | InvalidModulePath
    | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let directory = match move run Path.parent(manifest) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      fail InvalidSourceRoot {}
    }
  }
  let contents = run FileSystem.readFile(manifest)
  let located = run packageRoot(
    manifest,
    &directory,
    &contents,
    executable,
    &runtime,
    store,
    target,
    definition,
    versions,
  )
  run refuseReservedModules(source, &located, &standardLibrary)
  return run assemble(
    source,
    move located,
    move standardLibrary,
    target,
    libc,
    executable,
    linked,
    &runtime,
    root,
  )
}

/// The sources of a package's `build.silk` at `source`, evaluated on its own: package `package`
/// (`name@version`), whose source root and manifest directory are `directory`, the package's, with no dependencies
/// and no runtime, so its embeds read the package's files.
pub effect fn makeBuildScript(
  source: &Path,
  directory: &Path,
  package: &[u8],
  standardLibrary: Option<Path>,
  target: &[u8],
  libc: &[u8],
) -> ModuleSources
  ! FileError
    | TomlError
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | InvalidModulePath
    | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let manifest = run Path.join(directory, "build.silk")

  // The package identity `name@version` names it, so its diagnostics name the package.
  let mut separator = usize.ZERO
  while separator < package.length && package[separator] != 64 {
    separator = separator + usize.ONE
  }
  let mut contents = run Bytes.copy(b"[package]\nname = \"")
  run Bytes.append(&mut contents, Slice.view<u8>(package, usize.ZERO, separator))
  run Bytes.append(&mut contents, b"\"\nversion = \"")
  if separator < package.length {
    run Bytes.append(
      &mut contents,
      Slice.view<u8>(package, separator + usize.ONE, package.length - separator - usize.ONE),
    )
  } else {
    run Bytes.append(&mut contents, b"0.0.0")
  }
  run Bytes.append(&mut contents, b"\"\nsource = \".\"\n")
  let runtime = RuntimeRequest.None
  let located = run packageRoot(
    &manifest,
    directory,
    &contents,
    false,
    &runtime,
    Option<&Path>.none(),
    target,
    Option<&Definition>.none(),
    Versions.Unchecked,
  )
  return run assemble(
    source,
    move located,
    move standardLibrary,
    target,
    libc,
    false,
    false,
    &runtime,
    Option<&Path>.none(),
  )
}

// The native inputs a build for `target` links: the root's entries that link on it, then, for a
// linked artifact, each dependency's, every dependent before the packages it depends on. An input
// listed more than once (the same file, library or framework) links once, at its last place, so it
// still follows everything that uses it.
effect fn linkedInputs(root: &[NativeLinkInput], packages: &Packages, linked: bool) -> List<
  NativeLinkInput
>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut listed = List<NativeLinkInput>.make()
  run appendLinked(&mut listed, root)
  if linked {
    let order = run PackageSources.linkOrder(packages)
    let positions = List<usize>.asSlice(&order)
    let mut at = usize.ZERO
    while at < positions.length {
      if positions[at] != usize.ZERO {
        run appendLinked(&mut listed, PackageSources.linkInputs(packages, positions[at]))
      }
      at = at + usize.ONE
    }
  }
  let candidates = List<NativeLinkInput>.asSlice(&listed)
  let mut kept = List<NativeLinkInput>.make()
  let mut at = usize.ZERO
  while at < candidates.length {
    let mut later = at + usize.ONE
    let mut repeated = false
    while later < candidates.length {
      if NativeLinkInputs.sameInput(&candidates[at], &candidates[later]) {
        repeated = true
        break
      }
      later = later + usize.ONE
    }
    if !repeated {
      run List<NativeLinkInput>.append(&mut kept, run NativeLinkInputs.copy(&candidates[at]))
    }
    at = at + usize.ONE
  }
  return move kept
}

effect fn appendLinked(listed: &mut List<NativeLinkInput>, declared: &[NativeLinkInput]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at = usize.ZERO
  while at < declared.length {
    run List<NativeLinkInput>.append(&mut listed.*, run NativeLinkInputs.copy(&declared[at]))
    at = at + usize.ONE
  }
  return ()
}

effect fn assemble(
  source: &Path,
  located: PackageRoot,
  standardLibrary: Option<Path>,
  target: &[u8],
  libc: &[u8],
  executable: bool,
  linked: bool,
  request: &RuntimeRequest,
  rootOverride: Option<&Path>,
) -> ModuleSources
  ! FileError
    | InvalidSourceRoot
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidModulePath
    | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let PackageRoot {
    directory: root,
    package,
    relative,
    runtime: declaredRuntime,
    components,
    retention,
    linkInputs,
    archives: rootArchives,
    functionOrder,
    packages
  } = move located
  let mut catalogDocument = Option<JsonValue>.none()
  if let Option<Path>.Some { value: directory } = &standardLibrary {
    catalogDocument = run catalog(&directory)
  }

  // The catalog lists one runtime for an executable's target and libc, by its name; a `none`
  // request selects no runtime and so acquires none of the catalog's components either.
  let mut catalogName = Option<&[u8]>.none()
  let mut catalogued = executable
  match &request.* {
    RuntimeRequest.None => {
      catalogued = false
    }
    RuntimeRequest.Named { name } => {
      if !executable {
        fail InvalidBuildComposition { detail: Bytes.make() }
      }
      catalogName = Option<&[u8]>.some(Bytes.asSlice(&name))
    }
    RuntimeRequest.Default => {}
  }
  let mut storage = Option<ExecutionStorage>.none()
  let mut traceDirective = Option<TraceDirective>.none()
  if let Option<JsonValue>.Some {value: document} = &catalogDocument {
    traceDirective = asTraceDirective(run catalogBindings(&document, standardPackage(), b"trace-directive", &TRACE_OPERATIONS))
  }
  match move components {
    Components.Declared { storage: declared, traceDirective: replacement } => {
      if let Option<TraceDirective>.Some {value} = move replacement { traceDirective = Option<TraceDirective>.some(move value) }
      storage = move declared
    }
    Components.Catalog => {
      if let Option<JsonValue>.Some { value: document } = &catalogDocument {
        if catalogued {
          storage = asStorage(run catalogBindings(&document, Bytes.asSlice(&package), b"execution-storage", &STORAGE_OPERATIONS))
        }
      }
    }
  }
  let mut selectedRuntime = Option<Bytes>.none()
  match move declaredRuntime {
    RuntimeChoice.Declared { module } => {
      selectedRuntime = move module
    }
    RuntimeChoice.Catalog => {
      if catalogued {
        match &catalogDocument {
          Option<JsonValue>.Some { value: document } => {
            match move run catalogRuntime(&document, target, libc, move catalogName) {
              Option<Bytes>.Some { value } => {
                selectedRuntime = Option<Bytes>.some(move value)
              }
              Option<Bytes>.None => {
                fail InvalidBuildComposition { detail: Bytes.make() }
              }
            }
          }
          Option<JsonValue>.None => {
            // Without a library there is no catalog to read; a library without one is invalid.
            if let Option<Path>.None = &standardLibrary {
              fail MissingStandardLibrary {}
            }
            fail InvalidBuildComposition { detail: Bytes.make() }
          }
        }
      }
    }
  }
  if let Option<Bytes>.Some { value: selected } = &selectedRuntime {
    if let Option<JsonValue>.Some { value: document } = &catalogDocument {
      run requireRuntimeTarget(&document, Bytes.asSlice(&selected), target, libc)
    }
  }
  let linkInputs = run linkedInputs(List<NativeLinkInput>.asSlice(&linkInputs), &packages, linked)

  // A build fetches the archives of the packages whose inputs it links.
  let mut archives = List<Archive>.make()
  let ownArchives = List<Archive>.asSlice(&rootArchives)
  let mut own = usize.ZERO
  while own < ownArchives.length {
    run List<Archive>.append(&mut archives, run NativeLinkInputs.copyArchive(&ownArchives[own]))
    own = own + usize.ONE
  }
  if linked {
    let mut dependency = usize.ONE
    while dependency < PackageSources.count(&packages) {
      let theirs = PackageSources.archives(&packages, dependency)
      let mut at = usize.ZERO
      while at < theirs.length {
        run List<Archive>.append(&mut archives, run NativeLinkInputs.copyArchive(&theirs[at]))
        at = at + usize.ONE
      }
      dependency = dependency + usize.ONE
    }
  }
  let logical = run logicalEntry(&root, source)
  if SealedOperators.isPath(Bytes.asSlice(&logical)) {
    fail InvalidSourceRoot {}
  }
  let entry = run ModuleId.make(
    b"file",
    owningPackage(Bytes.asSlice(&package), Bytes.asSlice(&logical)),
    Bytes.asSlice(&logical),
  )

  // Standard-library paths belong to the standard library's own package, which every package
  // shares (PACKAGE-005), so a library module has the same identity whichever package roots the
  // build. The graph takes the owner's origin and package from any of its modules.
  let standard = run ModuleId.make(b"file", standardPackage(), b"silk/core/option.silk")
  let mut graph = run PackageSources.graph(&packages, &standard)
  if let Option<JsonValue>.Some { value: document } = &catalogDocument {
    run catalogRoles(&document, &mut graph)
  }

  // Executables and loadable modules link target support, independently of runtime selection.
  let mut support = List<ModuleId>.make()
  let mut supportHosted = List<bool>.make()
  if linked {
    if let Option<JsonValue>.Some { value: document } = &catalogDocument {
      let mut paths = List<Bytes>.make()
      run catalogSupport(&document, target, &mut paths, &mut supportHosted)
      let listedPaths = List<Bytes>.asSlice(&paths)
      let mut pathAt = usize.ZERO
      while pathAt < listedPaths.length {
        run List<ModuleId>.append(
          &mut support,
          run ModuleId.make(
            b"file",
            owningPackage(Bytes.asSlice(&package), Bytes.asSlice(&listedPaths[pathAt])),
            Bytes.asSlice(&listedPaths[pathAt]),
          ),
        )
        pathAt = pathAt + usize.ONE
      }
    }
  }
  let mut runtime = Option<ModuleId>.none()
  if let Option<Bytes>.Some { value: selected } = &selectedRuntime {
    if SealedOperators.isPath(Bytes.asSlice(&selected)) {
      fail InvalidBuildComposition { detail: Bytes.make() }
    }
    runtime = Option<ModuleId>.some(
      run ModuleId.make(
        b"file",
        owningPackage(Bytes.asSlice(&package), Bytes.asSlice(&selected)),
        Bytes.asSlice(&selected),
      ),
    )
  }
  let entrySource = match rootOverride {
    Option<&Path>.Some { value } => run Path.fromBytes(Path.rawBytes(value))
    Option<&Path>.None => run Path.fromBytes(Path.rawBytes(source))
  }

  // The root module is named on standard error first, since `FileError` carries no path.
  let read = run Effect.result(FileSystem.readFile(&entrySource))
  let content = match move read {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => Option<Bytes>.some(move value)
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        run noteUnreadable(&entrySource)
        fail move failure
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let revision = run Revision.publish(&Revision.make(), &entry, &content)
  let mut attempted = List<ModuleId>.make()
  run List<ModuleId>.append(&mut attempted, ModuleId.copy(&entry))
  return ModuleSources {
    root: move root,
    package: move package,
    directory: move relative,
    standardLibrary: move standardLibrary,
    entry: move entry,
    entrySource: move entrySource,
    runtime: move runtime,
    storage: move storage,
    traceDirective: move traceDirective,
    support: move support,
    supportHosted: move supportHosted,
    retention: move retention,
    linkInputs: move linkInputs,
    archives: move archives,
    functionOrder: move functionOrder,
    packages: move packages,
    pendingDependencies: List<DependencyDemand>.make(),
    graph: move graph,
    revision: move revision,
    attempted: move attempted,
    parsed: List<SourceUnit>.make(),
    summaries: Option<ImportSummaries>.none(),
    snapshot: Option<SourceSnapshot>.none(),
    digests: List<LoadedDigest>.make(),
    unused: List<ModuleUnused>.make(),
    imports: List<ModuleImports>.make(),
    programRoots: List<ModuleId>.make(),
    entryOnly: false,
    generated: List<GeneratedModule>.make(),
    claimFree: List<ModuleId>.make(),
    erased: false,
    listings: List<Listing>.make(),
  }
}

/// Borrows the module directory on disk, which every logical module path of the package is under.
pub fn moduleRoot(self: &ModuleSources) -> &Path {
  return &self.root
}

/// Borrows the standard library directory, which holds the `silk/` modules; none without one.
pub fn standardLibrary(self: &ModuleSources) -> Option<&Path> {
  return match &self.standardLibrary {
    Option<Path>.Some { value } => Option<&Path>.some(&value)
    Option<Path>.None => Option<&Path>.none()
  }
}

/// Borrows the module directory's path relative to the package manifest, such as `src`.
pub fn moduleDirectory(self: &ModuleSources) -> &[u8] {
  return Bytes.asSlice(&self.directory)
}

/// The canonical identity of `logical`, a path such as `silk/testing/runner.silk`, in this package.
pub effect fn module(self: &ModuleSources, logical: &[u8]) -> ModuleId
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
  return run ModuleId.make(b"file", owningPackage(Bytes.asSlice(&self.package), logical), logical)
}

/// The identity of the file at `path` below the package's directory that the package embeds
/// (driver/EmbeddedFiles).
pub effect fn embeddedFile(self: &ModuleSources, path: &[u8]) -> ModuleId
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
  return run ModuleId.make(b"embed", Bytes.asSlice(&self.package), path)
}

/// The module of a dependency package that the file at `path` holds, if one does.
pub effect fn dependencyModule(self: &ModuleSources, path: &[u8]) -> Option<ModuleId>
  ! OutOfMemoryError
  ? &mut Allocator {
  return run PackageSources.dependencyModule(&self.packages, path)
}

/// Replaces the source of a module already read with `content`, as when its file is saved, so later
/// revisions see the new text. A module not yet read is read from its file when first reached.
pub effect fn reread(self: &mut ModuleSources, module: &ModuleId, content: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !attempted(&self.*, module) {
    return ()
  }
  run Revision.publishInPlace(
    &mut self.revision,
    module,
    &Option<Bytes>.some(run Bytes.copy(content)),
  )
  return ()
}

/// Reads every module already read from its file again, as a long-lived check does before each
/// check, and publishes each one whose text changed, appeared or went away into the revision. A
/// module a changed text imports for the first time is read too, and [`unusedWarnings`] then
/// answers from each module's new text. Answers how many changed.
pub effect fn refreshFromDisk(self: &mut ModuleSources) -> usize
  ! FileError | InvalidModulePath | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut changed = List<ModuleId>.make()
  let mut at = usize.ZERO
  while at < List<ModuleId>.length(&self.attempted) {
    let module = ModuleId.copy(&List<ModuleId>.asSlice(&self.attempted)[at])
    at = at + usize.ONE

    // The file alone: a case variant of its name was refused when the module was first read.
    let location = run sourceLocation(&self.*, &module)
    let mut read = match &location.path {
      Option<Path>.Some { value } => run CheckServer.readFile(Path.rawBytes(&value))
      Option<Path>.None => Option<Bytes>.none()
    }

    // A plan generates modules, never the files a package embeds.
    if let Option<Bytes>.None = &read {
      if !embeddedOrigin(&module) {
        read = run generatedSource(&self.*, &module)
      }
    }
    let observed = run Revision.observe(&self.revision, &module)
    let held = run Observation.copyContent(&observed)
    let same = match &read {
      Option<Bytes>.Some { value: now } => match &held {
        Option<Bytes>.Some { value: before } => sameText(
          Bytes.asSlice(&now),
          Bytes.asSlice(&before),
        )
        Option<Bytes>.None => false
      }
      Option<Bytes>.None => match &held {
        Option<Bytes>.Some { .. } => false
        Option<Bytes>.None => true
      }
    }
    if same {
      continue
    }
    run Revision.publishInPlace(&mut self.revision, &module, &read)
    run List<ModuleId>.append(&mut changed, move module)
  }
  let edited = List<ModuleId>.asSlice(&changed)
  at = usize.ZERO
  while at < edited.length {
    // An embedded file is bytes, not source: it imports nothing.
    if embeddedOrigin(&edited[at]) {
      at = at + usize.ONE
      continue
    }
    let observed = run Revision.observe(&self.revision, &edited[at])

    // The warnings of the text it had are gone with that text, whether or not a new one replaces it.
    if let Option<Bytes>.Some { value: text } = move run Observation.copyContent(&observed) {
      let unit = run SourceUnit.parse(
        &edited[at],
        Revision.revisionNumber(&self.revision),
        move text,
      )
      run recordUnused(&mut self.*, &edited[at], run UnusedBindings.find(&unit.authored))
      run preloadUnitImports(&mut self.*, &unit)
    } else {
      run recordUnused(&mut self.*, &edited[at], List<Unused>.make())
    }
    at = at + usize.ONE
  }
  return edited.length
}

// Records `found`, the bindings nothing names in the text of `module` just read, in place of what
// an earlier text of it had.
effect fn recordUnused(self: &mut ModuleSources, module: &ModuleId, found: List<Unused>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at = usize.ZERO
  while at < List<ModuleUnused>.length(&self.unused) {
    if ModuleId.equals(&List<ModuleUnused>.asSlice(&self.unused)[at].module, module) {
      drop List<ModuleUnused>.remove(&mut self.unused, at)
      break
    }
    at = at + usize.ONE
  }
  if List<Unused>.length(&found) == usize.ZERO {
    return ()
  }
  return run List<ModuleUnused>.append(
    &mut self.unused,
    ModuleUnused { module: ModuleId.copy(module), found: move found },
  )
}

/// Lets the root package import its own modules by `name` as well, as a documentation example
/// imports the package it documents by the name its dependents write.
pub effect fn aliasRoot(self: &mut ModuleSources, name: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  return run PackageGraph.depend(
    &mut self.graph,
    Bytes.asSlice(&self.package),
    name,
    Bytes.asSlice(&self.package),
  )
}

/// Copies the package graph that semantic analysis resolves imports through (PACKAGE-002).
pub effect fn packageGraph(self: &ModuleSources) -> PackageGraph
  ! OutOfMemoryError
  ? &mut Allocator {
  return run PackageGraph.copy(&self.graph)
}

/// Borrows the canonical entry identity inside its package's module directory.
pub fn entry(self: &ModuleSources) -> &ModuleId {
  return &self.entry
}

/// Borrows the selected runtime source module, absent for a library or object form without one.
pub fn runtime(self: &ModuleSources) -> Option<&ModuleId> {
  return match &self.runtime {
    Option<ModuleId>.Some { value } => Option<&ModuleId>.some(&value)
    Option<ModuleId>.None => Option<&ModuleId>.none()
  }
}

/// Borrows the target's support modules, none for a target without them or a non-executable form.
pub fn support(self: &ModuleSources) -> &[ModuleId] {
  return List<ModuleId>.asSlice(&self.support)
}

/// Whether each of [`support`]'s modules also exports its C exports to the host.
pub fn supportHosted(self: &ModuleSources) -> &[bool] {
  return List<bool>.asSlice(&self.supportHosted)
}

/// Borrows the package's native link inputs in declaration order.
pub fn nativeLinkInputs(self: &ModuleSources) -> &[NativeLinkInput] {
  return List<NativeLinkInput>.asSlice(&self.linkInputs)
}

/// Borrows the archives of the packages whose native inputs the build links, selected for its target.
pub fn archives(self: &ModuleSources) -> &[Archive] {
  return List<Archive>.asSlice(&self.archives)
}

/// Borrows the combined function-order file contributed by reached package plans.
pub fn functionOrder(self: &ModuleSources) -> Option<&Path> {
  return match &self.functionOrder {
    Option<Path>.Some { value } => Option<&Path>.some(&value)
    Option<Path>.None => Option<&Path>.none()
  }
}

/// Borrows the composition's execution-storage selection, absent when none is selected validly.
/// The composition's explicit retention roots, in manifest order (ARTIFACT-003).
pub effect fn retention(self: &ModuleSources) -> List<RetentionRoot>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copied = List<RetentionRoot>.make()
  let listed = List<RetentionRoot>.asSlice(&self.retention)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<RetentionRoot>.append(&mut copied, run RetentionRoot.copy(&listed[at]))
    at = at + usize.ONE
  }
  return move copied
}

pub fn executionStorage(self: &ModuleSources) -> Option<&ExecutionStorage> {
  return match &self.storage {
    Option<ExecutionStorage>.Some { value } => Option<&ExecutionStorage>.some(&value)
    Option<ExecutionStorage>.None => Option<&ExecutionStorage>.none()
  }
}

/// The source functions used by reached trace directives.
pub fn traceDirective(self: &ModuleSources) -> Option<&TraceDirective> {
  return match &self.traceDirective {
    Option<TraceDirective>.Some {value} => Option<&TraceDirective>.some(&value)
    Option<TraceDirective>.None => Option<&TraceDirective>.none()
  }
}

/// Retains an immutable snapshot whose observations authenticate exact per-file contents.
pub effect fn revision(self: &ModuleSources) -> Revision
  ! OutOfMemoryError
  ? &mut Allocator {
  return run Revision.copy(&self.revision)
}

// Whether `module` names a file a package embeds (driver/EmbeddedFiles): bytes that are read raw
// and are never Silk source, whatever the file holds.
fn embeddedOrigin(module: &ModuleId) -> bool {
  return ModuleId.withOrigin<bool>(
    module,
    |origin: &[u8]| -> bool {
      return sameText(origin, b"embed")
    },
  )
}

fn attempted(self: &ModuleSources, module: &ModuleId) -> bool {
  let modules = List<ModuleId>.asSlice(&self.attempted)
  let mut at = usize.ZERO
  while at < modules.length {
    if ModuleId.equals(&modules[at], module) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

/// Reports the actual provider route. The already-published entry always came from the compiler
/// file even if its logical path starts with silk/. Other requests retain the existing route.
pub fn compilerProvider(self: &ModuleSources, module: &ModuleId) -> bool {
  return ModuleId.equals(&self.entry, module)
    || !ModuleId.withPath<bool>(
      module,
      |path: &[u8]| -> bool {
        return startsWith(path, b"silk/") || SealedOperators.isPath(path)
      },
    )
}

// Whether `module` belongs to the root package: one of its own modules, or, when the selected
// package's module directory is the standard library's directory itself, one of the library's
// modules, which carry the library's identity (`standardPackage`) whichever package roots the
// build. So comparing ModuleId packages alone cannot establish source ownership.
fn rootPackageModule(self: &ModuleSources, module: &ModuleId) -> bool {
  if !ModuleId.sameOrigin(&self.entry, module) {
    return false
  }
  if ModuleId.samePackage(&self.entry, module) && compilerProvider(self, module) {
    return true
  }
  if compilerProvider(self, module) {
    return false
  }
  return match &self.standardLibrary {
    Option<Path>.Some { value } => sameText(Path.rawBytes(&self.root), Path.rawBytes(&value))
    Option<Path>.None => false
  }
}

/// How many modules preloading has published, present or absent.
pub fn loadedCount(self: &ModuleSources) -> usize {
  return List<ModuleId>.length(&self.attempted)
}

/// Copies the present, preloaded modules whose source provider is the selected root package.
/// Missing imports and present dependencies stay outside the root declaration sweep.
pub effect fn loadedRootModules(self: &ModuleSources) -> List<ModuleId>
  ! OutOfMemoryError
  ? &mut Allocator {
  let reach = run reached(self)
  let mut selected = List<ModuleId>.make()
  let published = List<ModuleId>.asSlice(&self.attempted)
  let mut at = usize.ZERO
  while at < published.length {
    if Revision.presents(&self.revision, &published[at]) && rootPackageModule(self, &published[at])
      && reaches(&reach, &published[at]) {
      run List<ModuleId>.append(&mut selected, ModuleId.copy(&published[at]))
    }
    at = at + usize.ONE
  }
  return move selected
}

// Whether `module` is read from a dependency package's own source root rather than the root
// package or the standard library.
fn dependencyPackageModule(self: &ModuleSources, module: &ModuleId) -> bool {
  if embeddedOrigin(module) || !compilerProvider(self, module) {
    return false
  }
  return ModuleId.withPackage<bool>(
    module,
    |package: &[u8]| -> bool {
      return match PackageSources.dependencyRoot(&self.packages, package) {
        Option<&Path>.Some { .. } => true
        Option<&Path>.None => false
      }
    },
  )
}

/// Copies the present, preloaded modules of the dependency packages. A check sweeps them with the
/// root package, so a dependency's errors are reported where they are written, even in bodies the
/// root package never reaches.
pub effect fn loadedDependencyModules(self: &ModuleSources) -> List<ModuleId>
  ! OutOfMemoryError
  ? &mut Allocator {
  let reach = run reached(self)
  let mut selected = List<ModuleId>.make()
  let published = List<ModuleId>.asSlice(&self.attempted)
  let mut at = usize.ZERO
  while at < published.length {
    if Revision.presents(&self.revision, &published[at])
      && dependencyPackageModule(self, &published[at])
      && reaches(&reach, &published[at]) {
      run List<ModuleId>.append(&mut selected, ModuleId.copy(&published[at]))
    }
    at = at + usize.ONE
  }
  return move selected
}

/// Copies the present, preloaded modules of the dependency packages read by a `path` from the
/// author's own tree ([`PackageSources.localDependency`]): the dependencies whose warnings a build
/// or check of the root package reports with its own.
pub effect fn loadedLocalDependencyModules(self: &ModuleSources) -> List<ModuleId> ! OutOfMemoryError ? &mut Allocator {
  let mut selected = List<ModuleId>.make()
  let mut found = run loadedDependencyModules(self)
  while List<ModuleId>.length(&found) > usize.ZERO {
    let module = List<ModuleId>.remove(&mut found, usize.ZERO)
    let local = ModuleId.withPackage<bool>(&module, |package: &[u8]| -> bool { return PackageSources.localDependency(&self.packages, package) })
    if local { run List<ModuleId>.append(&mut selected, move module) }
  }
  return move selected
}

/// Copies the modules a check sweeps: [`loadedRootModules`], then [`loadedDependencyModules`].
pub effect fn checkedModules(self: &ModuleSources) -> List<ModuleId>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut checked = run loadedRootModules(self)
  let mut dependencies = run loadedDependencyModules(self)
  while List<ModuleId>.length(&dependencies) > usize.ZERO {
    run List<ModuleId>.append(&mut checked, List<ModuleId>.remove(&mut dependencies, usize.ZERO))
  }
  return move checked
}

/// Copies the exact filesystem mapping used for publication, without reading source bytes.
pub effect fn sourceLocation(self: &ModuleSources, module: &ModuleId) -> SourceLocation
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  if ModuleId.equals(&self.entry, module) {
    return SourceLocation {
      provider: ProviderRole.Compiler,
      path: Option<Path>.some(run Path.fromBytes(Path.rawBytes(&self.entrySource))),
    }
  }
  let copied = run ModuleId.copyPath(module)
  let logical = Bytes.asSlice(&copied)
  if !embeddedOrigin(module) {
    let owner = run ModuleId.copyPackage(module)
    let mappings = self.generated.asSlice()
    let mut at = usize.ZERO
    while at < mappings.length {
      if sameText(mappings[at].package.asSlice(), owner.asSlice())
        && sameText(mappings[at].path.asSlice(), logical) {
        if let Option<Path>.Some { value } = &mappings[at].file {
          return SourceLocation {
            provider: ProviderRole.Compiler,
            path: Option<Path>.some(run Path.fromBytes(Path.rawBytes(&value))),
          }
        }
      }
      at = at + usize.ONE
    }
  }

  // An embedded file sits below the directory of its package's manifest, not below a source root.
  if embeddedOrigin(module) {
    let package = run ModuleId.copyPackage(module)
    if let Option<&Path>.Some { value: directory } = move PackageSources.manifestDirectory(
      &self.packages,
      Bytes.asSlice(&package),
    ) {
      return SourceLocation {
        provider: ProviderRole.Compiler,
        path: Option<Path>.some(run Path.joinBytes(directory, logical)),
      }
    }
    // A file the standard library embeds sits below the library's directory.
    if sameText(Bytes.asSlice(&package), standardPackage()) {
      if let Option<Path>.Some { value } = &self.standardLibrary {
        return SourceLocation {
          provider: ProviderRole.StandardLibrary,
          path: Option<Path>.some(run Path.joinBytes(&value, logical)),
        }
      }
    }
    return SourceLocation { provider: ProviderRole.Compiler, path: Option<Path>.none() }
  }
  if !compilerProvider(self, module) {
    if let Option<Path>.Some { value } = &self.standardLibrary {
      return SourceLocation {
        provider: ProviderRole.StandardLibrary,
        path: Option<Path>.some(run Path.joinBytes(&value, logical)),
      }
    }
    return SourceLocation { provider: ProviderRole.StandardLibrary, path: Option<Path>.none() }
  }

  // A dependency's modules resolve below that package's own source root.
  let package = run ModuleId.copyPackage(module)
  if let Option<&Path>.Some { value: directory } = move PackageSources.dependencyRoot(
    &self.packages,
    Bytes.asSlice(&package),
  ) {
    return SourceLocation {
      provider: ProviderRole.Compiler,
      path: Option<Path>.some(run Path.joinBytes(directory, logical)),
    }
  }
  return SourceLocation {
    provider: ProviderRole.Compiler,
    path: Option<Path>.some(run Path.joinBytes(&self.root, logical)),
  }
}

// The directory `module`'s logical path is read below, none when its provider has no files.
effect fn sourceDirectory(self: &ModuleSources, module: &ModuleId) -> Option<Path>
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  if !compilerProvider(self, module) {
    if let Option<Path>.Some { value } = &self.standardLibrary {
      return Option<Path>.some(run Path.fromBytes(Path.rawBytes(&value)))
    }
    return Option<Path>.none()
  }
  let package = run ModuleId.copyPackage(module)
  if let Option<&Path>.Some { value: directory } = move PackageSources.dependencyRoot(
    &self.packages,
    Bytes.asSlice(&package),
  ) {
    return Option<Path>.some(run Path.fromBytes(Path.rawBytes(directory)))
  }
  return Option<Path>.some(run Path.fromBytes(Path.rawBytes(&self.root)))
}

// The last component of `path`.
fn lastComponent(path: &[u8]) -> &[u8] {
  let mut start = path.length
  while start > usize.ZERO && path[start - usize.ONE] != 47 {
    start = start - usize.ONE
  }
  return Slice.view<u8>(path, start, path.length - start)
}

// Whether `left` and `right` are the same text once ASCII letters are folded to lower case.
fn sameFolded(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    let mut a = left[at]
    let mut b = right[at]
    if a >= 65 && a <= 90 {
      a = a + 32
    }
    if b >= 65 && b <= 90 {
      b = b + 32
    }
    if a != b {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// The child names of one listed directory.
struct Listing {
  directory: Bytes,
  names: List<Bytes>,
}

// The position in `listings` of `directory`'s child names, listed on first use; none when it
// cannot be listed.
effect fn listingOf(listings: &mut List<Listing>, directory: &[u8]) -> Option<usize>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let known = List<Listing>.asSlice(&listings.*)
  let mut at = usize.ZERO
  while at < known.length {
    if sameText(Bytes.asSlice(&known[at].directory), directory) {
      return Option<usize>.some(at)
    }
    at = at + usize.ONE
  }
  let path = match move run Effect.result(Path.fromBytes(directory)) {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        drop failure
        return Option<usize>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let children = match move run Effect.result(FileSystem.listDirectory(&path)) {
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success { value } => move value
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      FileError failure => {
        drop failure
        return Option<usize>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let listed = List<DirectoryEntry>.asSlice(&children)
  let mut names = run List<Bytes>.makeWithCapacity(listed.length)
  at = usize.ZERO
  while at < listed.length {
    run List<Bytes>.append(
      &mut names,
      run Bytes.copy(lastComponent(Path.rawBytes(&listed[at].path))),
    )
    at = at + usize.ONE
  }
  run List<Listing>.append(
    &mut listings.*,
    Listing { directory: run Bytes.copy(directory), names: move names },
  )
  return Option<usize>.some(List<Listing>.length(&listings.*) - usize.ONE)
}

/// The logical path of the one source file whose path differs from `module`'s only in the case of
/// its letters, such as `util/Math.silk` for `util/math.silk`.
///
/// # Details
///
/// Each directory on the way is listed: a component spelled exactly is kept, and otherwise the
/// single child equal to it up to ASCII letter case is taken. None when the path is spelled
/// exactly, when a component has no such child or more than one, or when a directory cannot be
/// listed.
pub effect fn caseVariant(self: &ModuleSources, module: &ModuleId) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut listings = List<Listing>.make()
  return run caseVariantListed(self, module, &mut listings, false)
}

/// The logical path of the one source file whose path is one typo away from `module`'s in some
/// components, such as `geo/shapes.silk` for `geo/shape.silk`.
///
/// # Details
///
/// Like [`caseVariant`], but a component not spelled exactly takes the single child within one
/// inserted, removed or replaced letter of it, ignoring ASCII letter case.
pub effect fn nearVariant(self: &ModuleSources, module: &ModuleId) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut listings = List<Listing>.make()
  return run caseVariantListed(self, module, &mut listings, true)
}

/// The logical path of the one source file in `module`'s package named like `module`'s last
/// component, such as `util/helper.silk` for `helper.silk` after the file moved.
///
/// # Details
///
/// The package's source directories are searched to a small depth and breadth. None when no file
/// or more than one has that name, or when the only one is `module`'s own path.
pub effect fn movedVariant(self: &ModuleSources, module: &ModuleId) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if ModuleId.equals(&self.entry, module) {
    return Option<Bytes>.none()
  }
  let owner = run ModuleId.copyPackage(module)
  let logicalPath = run ModuleId.copyPath(module)
  let mappings = self.generated.asSlice()
  let mut mapped = usize.ZERO
  while mapped < mappings.length {
    if mappings[mapped].file.isSome()
      && sameText(mappings[mapped].package.asSlice(), owner.asSlice())
      && sameText(mappings[mapped].path.asSlice(), logicalPath.asSlice()) {
      return Option<Bytes>.none()
    }
    mapped = mapped + usize.ONE
  }
  let found = run Effect.result(sourceDirectory(self, module))
  let root = match move found {
    Result<Option<Path>, FileError | OutOfMemoryError>.Success {
      value: Option<Path>.Some { value }
    } => run Bytes.copy(Path.rawBytes(&value))
    Result<Option<Path>, FileError | OutOfMemoryError>.Success { value: Option<Path>.None } => {
      return Option<Bytes>.none()
    }
    Result<Option<Path>, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        drop failure
        return Option<Bytes>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let logical = run ModuleId.copyPath(module)
  let wanted = lastComponent(Bytes.asSlice(&logical))

  // Directories to search, as paths relative to the root, with their depth.
  let mut pending = List<Bytes>.make()
  let mut depths = List<usize>.make()
  run List<Bytes>.append(&mut pending, Bytes.make())
  run List<usize>.append(&mut depths, usize.ZERO)
  let mut matched = Option<Bytes>.none()
  let mut matches = usize.ZERO
  let mut visited = usize.ZERO
  while visited < List<Bytes>.length(&pending) && visited < 256 {
    let relative = run Bytes.copy(Bytes.asSlice(&List<Bytes>.asSlice(&pending)[visited]))
    let depth = List<usize>.asSlice(&depths)[visited]
    visited = visited + usize.ONE
    let mut directory = run Bytes.copy(Bytes.asSlice(&root))
    if Bytes.length(&relative) > usize.ZERO {
      run Bytes.append(&mut directory, b"/")
      run Bytes.append(&mut directory, Bytes.asSlice(&relative))
    }
    let path = match move run Effect.result(Path.fromBytes(Bytes.asSlice(&directory))) {
      Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
      Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
        FileError failure => {
          drop failure
          continue
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    let children = match move run Effect.result(FileSystem.listDirectory(&path)) {
      Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success { value } => move value
      Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure {
        error
      } => match move error {
        FileError failure => {
          drop failure
          continue
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    let listed = List<DirectoryEntry>.asSlice(&children)
    let mut at = usize.ZERO
    while at < listed.length {
      let name = lastComponent(Path.rawBytes(&listed[at].path))
      let mut child = run Bytes.copy(Bytes.asSlice(&relative))
      if Bytes.length(&child) > usize.ZERO {
        run Bytes.append(&mut child, b"/")
      }
      run Bytes.append(&mut child, name)
      if listed[at].kind.code == FileSystem.directory().code {
        if depth < 6 && name.length > usize.ZERO && name[0] != 46 {
          run List<Bytes>.append(&mut pending, move child)
          run List<usize>.append(&mut depths, depth + usize.ONE)
        }
      } else if sameText(name, wanted) {
        matches = matches + usize.ONE
        matched = Option<Bytes>.some(move child)
      }
      at = at + usize.ONE
    }
  }
  if matches != usize.ONE {
    return Option<Bytes>.none()
  }
  if let Option<Bytes>.Some { value } = move matched {
    if sameText(Bytes.asSlice(&value), Bytes.asSlice(&logical)) {
      return Option<Bytes>.none()
    }
    return Option<Bytes>.some(move value)
  }
  return Option<Bytes>.none()
}

// Whether `left` becomes `right` by inserting, removing or replacing at most one letter, ignoring
// ASCII letter case.
fn oneEditApart(left: &[u8], right: &[u8]) -> bool {
  let mut shorter = left
  let mut longer = right
  if left.length > right.length {
    shorter = right
    longer = left
  }
  if longer.length - shorter.length > usize.ONE {
    return false
  }
  let mut at = usize.ZERO
  while at < shorter.length && foldedByte(shorter[at]) == foldedByte(longer[at]) {
    at = at + usize.ONE
  }
  if at == shorter.length {
    return true
  }

  // Past the first difference, the rest must match after skipping one letter of the longer text, or
  // one letter of each when the lengths agree.
  let mut rest = at
  let mut offset = usize.ONE
  if longer.length == shorter.length {
    rest = at + usize.ONE
    offset = usize.ZERO
  }
  while rest < shorter.length {
    if foldedByte(shorter[rest]) != foldedByte(longer[rest + offset]) {
      return false
    }
    rest = rest + usize.ONE
  }
  return true
}

fn foldedByte(byte: u8) -> u8 {
  if byte >= 65 && byte <= 90 {
    return byte + 32
  }
  return byte
}

effect fn caseVariantListed(
  self: &ModuleSources,
  module: &ModuleId,
  listings: &mut List<Listing>,
  near: bool,
) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if ModuleId.equals(&self.entry, module) {
    return Option<Bytes>.none()
  }
  let found = run Effect.result(sourceDirectory(self, module))
  let directory = match move found {
    Result<Option<Path>, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Option<Path>, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        drop failure
        return Option<Bytes>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let mut current = match &directory {
    Option<Path>.Some { value } => run Bytes.copy(Path.rawBytes(&value))
    Option<Path>.None => {
      return Option<Bytes>.none()
    }
  }
  let logical = run ModuleId.copyPath(module)
  let written = Bytes.asSlice(&logical)
  let mut spelled = Bytes.make()
  let mut differs = false
  let mut start = usize.ZERO
  while start < written.length {
    let mut end = start
    while end < written.length && written[end] != 47 {
      end = end + usize.ONE
    }
    let component = Slice.view<u8>(written, start, end - start)
    let index = match move run listingOf(&mut listings.*, Bytes.asSlice(&current)) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Option<Bytes>.none()
      }
    }
    let names = List<Bytes>.asSlice(&List<Listing>.asSlice(&listings.*)[index].names)
    let mut chosen = usize.MAX
    let mut folded = usize.ZERO
    let mut at = usize.ZERO
    while at < names.length {
      let name = Bytes.asSlice(&names[at])
      if sameText(name, component) {
        chosen = at
        folded = usize.ONE
        break
      }
      if sameFolded(name, component) || (near && oneEditApart(name, component)) {
        chosen = at
        folded = folded + usize.ONE
      }
      at = at + usize.ONE
    }
    if chosen == usize.MAX || folded != usize.ONE {
      return Option<Bytes>.none()
    }
    let name = Bytes.asSlice(&names[chosen])
    if !sameText(name, component) {
      differs = true
    }
    if start > usize.ZERO {
      run Bytes.append(&mut spelled, b"/")
    }
    run Bytes.append(&mut spelled, name)
    run Bytes.append(&mut current, b"/")
    run Bytes.append(&mut current, name)
    start = end + usize.ONE
  }
  if !differs {
    return Option<Bytes>.none()
  }
  return Option<Bytes>.some(move spelled)
}

// Reads `module`'s source, absent when no file has its exact path. A case-insensitive filesystem
// also opens a file whose name differs only in letter case; that file is refused, so an import
// resolves the same way on every host. Directory listings are kept for the next read.
effect fn readModule(self: &mut ModuleSources, module: &ModuleId) -> Option<Bytes>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let location = run sourceLocation(&self.*, module)
  let content = match &location.path {
    Option<Path>.Some { value } => run readOptional(&value)
    Option<Path>.None => Option<Bytes>.none()
  }
  if let Option<Bytes>.None = &content {
    if let Option<Bytes>.Some { value: source } = move run generatedSource(&self.*, module) {
      return Option<Bytes>.some(move source)
    }
  }
  if let Option<Bytes>.Some { .. } = &content {
    let mut listings = Intrinsic.replace(self.listings, List<Listing>.make())
    let variant = run caseVariantListed(&self.*, module, &mut listings, false)
    self.listings = move listings
    if let Option<Bytes>.Some { .. } = &variant {
      return Option<Bytes>.none()
    }
  }
  return move content
}

// As [`readModule`], shared, the file taken from the run's snapshot when it holds it.
effect fn readShared(self: &mut ModuleSources, module: &ModuleId) -> SharedSource
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let location = run sourceLocation(&self.*, module)
  let mut read = SharedSource {
    content: Option<Shared<Bytes>>.none(),
    digest: ContentHash { high: 0, low: 0 },
  }
  if let Option<Path>.Some { value } = &location.path {
    read = run snapshotRead(&mut self.snapshot, &value)
  }
  if let Option<Shared<Bytes>>.None = &read.content {
    return run sharedSource(run generatedSource(&self.*, module))
  }
  let mut listings = Intrinsic.replace(self.listings, List<Listing>.make())
  let variant = run caseVariantListed(&self.*, module, &mut listings, false)
  self.listings = move listings
  if let Option<Bytes>.Some { .. } = &variant {
    return SharedSource {
      content: Option<Shared<Bytes>>.none(),
      digest: ContentHash { high: 0, low: 0 },
    }
  }
  return move read
}

/// Reads `module`'s current source: its file, or else the source a `build.silk` plan generates
/// for it; none when it has neither.
pub effect fn moduleText(self: &ModuleSources, module: &ModuleId) -> Option<Bytes>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let location = run sourceLocation(self, module)
  if let Option<Path>.Some { value } = &location.path {
    if let Option<Bytes>.Some { value: content } = move run readOptional(&value) {
      return Option<Bytes>.some(move content)
    }
  }
  return run generatedSource(self, module)
}

// The source a `build.silk` plan generates as `module`, if any.
effect fn generatedSource(self: &ModuleSources, module: &ModuleId) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let listed = List<GeneratedModule>.asSlice(&self.generated)
  if listed.length == usize.ZERO {
    return Option<Bytes>.none()
  }
  let package = run ModuleId.copyPackage(module)
  let path = run ModuleId.copyPath(module)
  let mut at = usize.ZERO
  while at < listed.length {
    if sameText(Bytes.asSlice(&listed[at].package), Bytes.asSlice(&package))
      && sameText(Bytes.asSlice(&listed[at].path), Bytes.asSlice(&path)) {
      return Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&listed[at].source)))
    }
    at = at + usize.ONE
  }
  return Option<Bytes>.none()
}

/// Serves `source` as module `<name>.silk` of the package `package`, as a `build.silk` plan
/// generates it. A file of that name in the package's source root wins, and is refused by the
/// caller beforehand.
pub effect fn addGenerated(
  self: &mut ModuleSources,
  package: &[u8],
  name: &[u8],
  source: Bytes,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut path = run Bytes.copy(name)
  run Bytes.append(&mut path, b".silk")
  run List<GeneratedModule>.append(
    &mut self.generated,
    GeneratedModule {
      package: run Bytes.copy(package),
      path: move path,
      source: move source,
      file: Option<Path>.none(),
      producer: Option<String>.none(),
    },
  )
  return ()
}

/// The package identity and manifest directory of each package of the build, the root first.
pub fn packageCount(self: &ModuleSources) -> usize {
  return PackageSources.count(&self.packages)
}

/// Captures the resolved package graph and publishes generated source beside the request.
pub effect fn requestPackages(self: &ModuleSources, directory: &Path) -> List<RequestPackage>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut packages = run PackageSources.requestPackages(&self.packages)
  let generated = List<GeneratedModule>.asSlice(&self.generated)
  let mut at = usize.ZERO
  while at < generated.length {
    let item = &generated[at]
    let mut packageAt = usize.ZERO
    while packageAt < List<RequestPackage>.length(&packages) {
      if sameText(
        PackageSources.packageIdentity(&self.packages, packageAt),
        Bytes.asSlice(&item.package),
      ) {
        let path = match &item.file {
          Option<Path>.Some { value } => run Path.fromBytes(Path.rawBytes(&value))
          Option<Path>.None => {
            let packageDirectory = run Path.joinBytes(directory, item.package.asSlice())
            let written = run Path.joinBytes(&packageDirectory, item.path.asSlice())
            if let Option<Path>.Some { value: parent } = move run Path.parent(&written) {
              run FileSystem.createDirectoriesRecursively(&parent)
            }
            run FileSystem.writeFile(&written, item.source.asSlice())
            move written
          }
        }
        let producer = match &item.producer {
          Option<String>.Some { value } => Option<String>.some(run String.copy(value.view()))
          Option<String>.None => Option<String>.none()
        }
        let logical = Bytes.asSlice(&item.path)
        run List<RequestModule>.append(
          &mut List<RequestPackage>.asMutSlice(&mut packages)[packageAt].modules,
          RequestModule {
            name: run RequestText.copy(Slice.view<u8>(logical, usize.ZERO, logical.length - 5)),
            source: run RequestText.copy(Path.rawBytes(&path)),
            producer: move producer,
          },
        )
        break
      }
      packageAt = packageAt + usize.ONE
    }
    at = at + usize.ONE
  }
  return move packages
}

/// The identity of package `at` of [`packageCount`].
pub fn packageIdentityAt(self: &ModuleSources, at: usize) -> &[u8] {
  return PackageSources.packageIdentity(&self.packages, at)
}

/// The source root of package `at` of [`packageCount`], which its module paths resolve below.
pub fn packageSourceRootAt(self: &ModuleSources, at: usize) -> &Path {
  return PackageSources.sourceRootAt(&self.packages, at)
}

/// The files besides the packages' own manifests whose contents decide what the build loads, each
/// once: the root manifest of each workspace whose `[workspace.dependencies]` some package took an
/// entry from, and each place a `silk.local.toml` was looked for, present or not.
pub fn graphFiles(self: &ModuleSources) -> &[Bytes] {
  return PackageSources.graphFiles(&self.packages)
}

/// The manifest directory of package `at` of [`packageCount`].
pub fn packageDirectoryAt(self: &ModuleSources, at: usize) -> &Path {
  return PackageSources.directoryAt(&self.packages, at)
}

// Publishes, once, the file `path` that a call in `reader` embeds (driver/EmbeddedFiles): the file
// at `path` below the directory of `reader`'s package manifest, under the module identity of
// origin `embed`, as present bytes or explicit absence. A path that leaves the package names no
// identity and is left to semantic analysis to refuse. The bytes are never parsed.
effect fn publishEmbedded(self: &mut ModuleSources, reader: &ModuleId, path: &[u8]) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let package = run ModuleId.copyPackage(reader)
  let file = match move run Effect.result(ModuleId.make(b"embed", Bytes.asSlice(&package), path)) {
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success { value } => move value
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure { error } => match move error {
      InvalidModulePath {} => {
        return ()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  if attempted(&self.*, &file) {
    return ()
  }
  let mut content = Option<Bytes>.none()

  if compilerProvider(&self.*, reader) {
    if let Option<&Path>.Some { value: directory } = move PackageSources.manifestDirectory(
      &self.packages,
      Bytes.asSlice(&package),
    ) {
      let located = run Path.joinBytes(directory, path)
      content = run readOptional(&located)
    }
  } else {
    // A standard-library module embeds a file of the library, at a path below the library's
    // directory: the library has no manifest in the build that reads it.
    if let Option<Path>.Some { value: library } = &self.standardLibrary {
      let located = run Path.joinBytes(&library, path)
      content = run readOptional(&located)
    }
  }
  if let Option<Bytes>.Some { value: _present } = &content {
    if rootPackageModule(&self.*, reader) {
      if let Option<SourceSnapshot>.Some { value: held } = &mut self.snapshot {
        run List<EmbeddedRead>.append(
          &mut held.embedded,
          EmbeddedRead { reader: run ModuleId.copyPath(reader), path: run Bytes.copy(path) },
        )
      }
    }
  }
  run Revision.publishInPlace(&mut self.revision, &file, &content)
  run List<ModuleId>.append(&mut self.attempted, move file)
  return ()
}

// Publishes `module` once, as present bytes or explicit absence, and returns its bytes.
effect fn publish(
  self: &mut ModuleSources,
  module: &ModuleId,
  sealedContent: &Option<Bytes>,
) -> Option<Shared<Bytes>>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if attempted(&self.*, module) {
    let observed = run Revision.observe(&self.revision, module)
    let copied = run sharedSource(run Observation.copyContent(&observed))
    return move copied.content
  }
  let mut read = SharedSource {
    content: Option<Shared<Bytes>>.none(),
    digest: ContentHash { high: 0, low: 0 },
  }
  if ModuleId.withPath<bool>(module, SealedOperators.isPath) {
    if let Option<Bytes>.Some { value } = &sealedContent.* {
      read = run sharedSource(Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&value))))
    }
  } else {
    read = run readShared(&mut self.*, module)
  }
  let mut published = Option<Shared<Bytes>>.none()
  if let Option<Shared<Bytes>>.Some { value } = &read.content {
    published = Option<Shared<Bytes>>.some(Shared<Bytes>.clone(&value))
  }
  run Revision.publishShared(&mut self.revision, module, move published, read.digest)
  run List<ModuleId>.append(&mut self.attempted, ModuleId.copy(module))
  return move read.content
}

/// Publishes every module reachable from `roots` through written imports, so one semantic build
/// sees the whole program.
///
/// # Details
///
/// Each module is read once, as present bytes or explicit absence, and a present module's imports
/// are read as syntax only. An import path that is not a canonical module path names no module and
/// is left to semantic analysis to reject.
pub effect fn preload(self: &mut ModuleSources, roots: &[ModuleId]) -> ()
  ! FileError | InvalidModulePath | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  // Read and lex the compiler-owned declaration catalog once. Publish those same bytes only
  // when a reachable module names a declared member; project sources cannot supply this catalog.
  let sealedModule = run module(&self.*, SealedOperators.path())
  let sealedContent = run readModule(&mut self.*, &sealedModule)
  let sealedNames = match &sealedContent {
    Option<Bytes>.Some { value } => run SealedOperators.members(Bytes.asSlice(&value))
    Option<Bytes>.None => List<Bytes>.make()
  }
  if let Option<ImportSummaries>.Some { value: summaries } = &mut self.summaries {
    let catalog = match &sealedContent {
      Option<Bytes>.Some { value } => ContentHash.of(Bytes.asSlice(&value))
      Option<Bytes>.None => ContentHash { high: 0, low: 0 }
    }
    Summaries.selectCatalog(&mut summaries, catalog)
  }
  let mut pending = run List<ModuleId>.makeWithCapacity(roots.length)
  let mut at = usize.ZERO
  while at < roots.length {
    run List<ModuleId>.append(&mut pending, ModuleId.copy(&roots[at]))
    at = at + usize.ONE
  }

  // Only the latest load's units wait for a store, so a caller that never takes them holds one
  // program's parse at most.
  List<SourceUnit>.clear(&mut self.parsed)
  List<ModuleId>.clear(&mut self.claimFree)
  List<LoadedDigest>.clear(&mut self.digests)

  // A file the last build's store parsed is parsed again ahead, on threads of their own, while
  // this load reads and parses the rest (see `ImportSummaries.wasParsed`).
  let mut ahead = List<ParseJob>.make()
  let mut workers = List<JoinHandle<List<ParsedFile>>>.make()
  let threads = NativeThread.processorCount() - usize.ONE
  let number = Revision.revisionNumber(&self.revision)
  let mut scanned = List<ModuleId>.make()

  // Modules are taken in the order they were found; a cursor walks the list rather than each
  // removal shifting the thousands of candidates behind it.
  let mut next = usize.ZERO

  // The modules found so far are a wave: each is read in order, the files no summary names are
  // parsed together on the threads, and each wave module's imports are then taken in order. A
  // module's imports land after every module of its wave, as one at a time would take them, so the
  // order is the same.
  while next < List<ModuleId>.length(&pending) {
    let traced = Trace.span("load.wave")
    let waveEnd = List<ModuleId>.length(&pending)
    let mut wave = List<WaveModule>.make()
    let mut misses = List<ParseJob>.make()
    let reading = Trace.span("load.read")
    while next < waveEnd {
      let module = ModuleId.copy(&List<ModuleId>.asSlice(&pending)[next])
      next = next + usize.ONE
      if listed(List<ModuleId>.asSlice(&scanned), &module) {
        continue
      }
      run List<ModuleId>.append(&mut scanned, ModuleId.copy(&module))
      let content = run publish(&mut self.*, &module, &sealedContent)
      if let Option<Shared<Bytes>>.Some { value: read } = move content {
        // A file whose bytes a summary names writes the imports it wrote then, and the store parses
        // it when it first reads it.
        // Its publication hashed the bytes.
        let mut digest = ContentHash { high: 0, low: 0 }
        if let Option<ContentHash>.Some { value } = move Revision.digestAt(
          &self.revision,
          &module,
        ) {
          digest = value
        }
        let mut found = Option<ImportSummary>.none()
        let mut wanted = false
        if let Option<ImportSummaries>.Some { value: summaries } = &mut self.summaries {
          found = run Summaries.find(&mut summaries, digest)
          wanted = Summaries.wasParsed(&summaries, digest)
          run List<LoadedDigest>.append(
            &mut self.digests,
            LoadedDigest { module: ModuleId.copy(&module), digest: digest },
          )
        }
        let hit = match &found {
          Option<ImportSummary>.Some { .. } => true
          _ => false
        }
        if hit && wanted {
          let slot = List<ModuleId>.length(&scanned) - usize.ONE
          run List<ParseJob>.append(
            &mut ahead,
            ParseJob { slot: slot, name: run tracedName(&module), bytes: run copyShared(&read) },
          )
        }

        // The jobs found so far parse while this file does.
        if !hit && List<JoinHandle<List<ParsedFile>>>.length(&workers) < threads {
          run parseAhead(&mut workers, Intrinsic.replace(ahead, List<ParseJob>.make()))
        }
        if !hit {
          run List<ParseJob>.append(
            &mut misses,
            ParseJob {
              slot: List<WaveModule>.length(&wave),
              name: run tracedName(&module),
              bytes: run copyShared(&read),
            },
          )
        }
        run List<WaveModule>.append(
          &mut wave,
          WaveModule { module: move module, digest: digest, found: move found, read: move read },
        )
      }
    }
    drop reading
    let mut free = usize.ZERO
    if List<JoinHandle<List<ParsedFile>>>.length(&workers) < threads {
      free = threads - List<JoinHandle<List<ParsedFile>>>.length(&workers)
    }
    let parsing = Trace.span("load.parse")
    Trace.set("files", &List<ParseJob>.length(&misses))
    let mut syntax = run parseWave(move misses, List<WaveModule>.length(&wave), free)
    drop parsing
    let summarizing = Trace.span("load.imports")
    let mut taken = usize.ZERO
    while taken < List<WaveModule>.length(&wave) {
      let WaveModule { module, digest, found, read } = run takeWave(&mut wave, taken)
      let parsed = Intrinsic.replace(
        List<Option<Parsed>>.asMutSlice(&mut syntax)[taken],
        Option<Parsed>.none(),
      )
      taken = taken + usize.ONE
      let summary = match move found {
        Option<ImportSummary>.Some { value } => move value
        Option<ImportSummary>.None => match move parsed {
          Option<Parsed>.Some { value } => run summaryOf(
            &mut self.*,
            &module,
            move value,
            digest,
            List<Bytes>.asSlice(&sealedNames),
          )

          // A file a thread could not parse is parsed here.
          Option<Parsed>.None => run parsedSummary(
            &mut self.*,
            &module,
            run copyShared(&read),
            digest,
            List<Bytes>.asSlice(&sealedNames),
          )
        }
      }
      if !summary.claims {
        run List<ModuleId>.append(&mut self.claimFree, ModuleId.copy(&module))
      }
      if summary.erased {
        self.erased = true
      }

      // A load that follows an edit reads only the modules the edit newly reaches, so each module
      // replaces its own record and the others keep theirs.
      run recordUnused(
        &mut self.*,
        &module,
        run Summaries.copyUnused(List<Unused>.asSlice(&summary.unused)),
      )
      let mut targets = List<ModuleId>.make()
      if summary.traced { run traceImports(&self.*, &mut targets) }
      if summary.sealed {
        // The path is fixed and compiler-owned; sourceLocation never consults the project tree.
        run List<ModuleId>.append(
          &mut targets,
          run PackageGraph.target(&self.graph, &module, SealedOperators.path()),
        )
      }
      let written = List<Bytes>.asSlice(&summary.paths)
      let mut pathAt = usize.ZERO
      while pathAt < written.length {
        if let Option<&[u8]>.Some { value: embedded } = move EmbeddedFiles.embedded(
          Bytes.asSlice(&written[pathAt]),
        ) {
          run publishEmbedded(&mut self.*, &module, embedded)
          pathAt = pathAt + usize.ONE
          continue
        }
        if SealedOperators.isPath(Bytes.asSlice(&written[pathAt])) {
          pathAt = pathAt + usize.ONE
          continue
        }
        run demandDependency(&mut self.*, &module, Bytes.asSlice(&written[pathAt]))
        run appendCandidates(&self.*, &mut targets, &module, Bytes.asSlice(&written[pathAt]))
        pathAt = pathAt + usize.ONE
      }
      let found = List<ModuleId>.asSlice(&targets)
      pathAt = usize.ZERO
      while pathAt < found.length {
        run List<ModuleId>.append(&mut pending, ModuleId.copy(&found[pathAt]))
        pathAt = pathAt + usize.ONE
      }
      run recordImports(&mut self.*, &module, move targets)
    }
    drop summarizing
    Trace.set("modules", &List<WaveModule>.length(&wave))
    drop traced
    run Tracing.flush()
  }

  // The rest is split between the threads left and this one.
  let mut shares = List<List<ParseJob>>.make()
  let mut share = usize.ZERO
  let mut live = List<JoinHandle<List<ParsedFile>>>.length(&workers)
  if live > threads {
    live = threads
  }
  let free = threads - live
  while share <= free {
    run List<List<ParseJob>>.append(&mut shares, List<ParseJob>.make())
    share = share + usize.ONE
  }
  let mut loads = List<usize>.make()
  while List<usize>.length(&loads) < List<List<ParseJob>>.length(&shares) {
    run List<usize>.append(&mut loads, usize.ZERO)
  }

  // Largest first, each to the lightest share.
  while List<ParseJob>.length(&ahead) > usize.ZERO {
    let jobs = List<ParseJob>.asSlice(&ahead)
    let mut largest = usize.ZERO
    let mut at = usize.ONE
    while at < jobs.length {
      if Bytes.length(&jobs[at].bytes) > Bytes.length(&jobs[largest].bytes) {
        largest = at
      }
      at = at + usize.ONE
    }
    let job = List<ParseJob>.remove(&mut ahead, largest)
    let weights = List<usize>.asSlice(&loads)
    let mut lightest = usize.ZERO
    at = usize.ONE
    while at < weights.length {
      if weights[at] < weights[lightest] {
        lightest = at
      }
      at = at + usize.ONE
    }
    let load = List<usize>.get(&loads, lightest) + Bytes.length(&job.bytes)
    List<usize>.set(&mut loads, lightest, load)
    let mut writable = List<List<ParseJob>>.asMutSlice(&mut shares)
    run List<ParseJob>.append(&mut writable[lightest], move job)
  }
  let own = List<List<ParseJob>>.remove(&mut shares, usize.ZERO)
  while List<List<ParseJob>>.length(&shares) > usize.ZERO {
    run parseAhead(&mut workers, List<List<ParseJob>>.remove(&mut shares, usize.ZERO))
  }
  let mut files = run parseEach(move own)
  while List<JoinHandle<List<ParsedFile>>>.length(&workers) > usize.ZERO {
    let handle = List<JoinHandle<List<ParsedFile>>>.remove(&mut workers, usize.ZERO)
    let mut joined = handle.join()
    while List<ParsedFile>.length(&joined) > usize.ZERO {
      let last = List<ParsedFile>.length(&joined) - usize.ONE
      run List<ParsedFile>.append(&mut files, List<ParsedFile>.remove(&mut joined, last))
    }
  }

  // A store takes each unit by its module and bytes, so their order does not matter.
  while List<ParsedFile>.length(&files) > usize.ZERO {
    let last = List<ParsedFile>.length(&files) - usize.ONE
    let ParsedFile { slot, parsed } = List<ParsedFile>.remove(&mut files, last)
    let unit = run SourceUnit.assemble(&List<ModuleId>.asSlice(&scanned)[slot], number, move parsed)
    run List<SourceUnit>.append(&mut self.parsed, move unit)
  }
  return run Tracing.flush()
}

// Starts parsing `jobs` on a thread of its own. When no thread starts, the store parses each file
// when it first reads it.
effect fn parseAhead(workers: &mut List<JoinHandle<List<ParsedFile>>>, jobs: List<ParseJob>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if List<ParseJob>.length(&jobs) == usize.ZERO {
    return ()
  }
  match move run Effect.result(
    NativeThread.spawn(
      || -> List<ParsedFile> {
        return run parseDetached(move jobs)
      },
    ),
  ) {
    Result<JoinHandle<List<ParsedFile>>, OutOfMemoryError | SpawnError>.Success { value } => {
      run List<JoinHandle<List<ParsedFile>>>.append(&mut workers.*, move value)
    }
    Result<JoinHandle<List<ParsedFile>>, OutOfMemoryError | SpawnError>.Failure {
      error
    } => match move error {
      SpawnError unstarted => {
        drop unstarted
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  return ()
}

// `parseEach` on a thread of its own, with an allocator of its own. A thread that runs out of
// memory parses nothing, and the store parses each file when it first reads it.
effect fn parseDetached(jobs: List<ParseJob>) -> List<ParsedFile> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let parsed = run Effect.result(
    parseEach(move jobs) |> Effect.provideMut<Allocator>(&mut allocator),
  )
  return match move parsed {
    Result<List<ParsedFile>, OutOfMemoryError>.Success { value } => move value
    Result<List<ParsedFile>, OutOfMemoryError>.Failure { error } => {
      drop error
      return List<ParsedFile>.make()
    }
  }
}

effect fn parseEach(jobs: List<ParseJob>) -> List<ParsedFile>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut pending = move jobs
  let mut files = List<ParsedFile>.make()
  while List<ParseJob>.length(&pending) > usize.ZERO {
    let last = List<ParseJob>.length(&pending) - usize.ONE
    let ParseJob { slot, name, bytes } = List<ParseJob>.remove(&mut pending, last)
    run List<ParsedFile>.append(
      &mut files,
      ParsedFile { slot: slot, parsed: run parseFile(Bytes.asSlice(&name), move bytes) },
    )
  }
  return move files
}

/// The digests of the modules the last load read that a store reading `events` parsed, for
/// `SemanticCache.saveParsed`.
pub effect fn parsedDigests(self: &ModuleSources, events: &[Event]) -> List<ContentHash>
  ! OutOfMemoryError
  ? &mut Allocator {
  let loaded = List<LoadedDigest>.asSlice(&self.digests)
  let mut taken = List<bool>.make()
  while List<bool>.length(&taken) < loaded.length {
    run List<bool>.append(&mut taken, false)
  }
  let mut digests = List<ContentHash>.make()
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.SourceRead && events[at].present {
      let mut index = usize.ZERO
      while index < loaded.length {
        if !List<bool>.get(&taken, index)
          && ModuleId.equals(&loaded[index].module, &events[at].module) {
          List<bool>.set(&mut taken, index, true)
          run List<ContentHash>.append(&mut digests, loaded[index].digest)
          break
        }
        index = index + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return move digests
}

// Appends both modules an import of `path` written in `importer` can name (MODULE-007): the module
// file and the barrel `mod.silk` of the directory of that name. Semantic analysis reads whether
// each is present, so both are published. A path that is not a canonical module path names none.
effect fn appendCandidates(
  self: &ModuleSources,
  pending: &mut List<ModuleId>,
  importer: &ModuleId,
  path: &[u8],
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let file = run Effect.result(PackageGraph.target(&self.graph, importer, path))
  match move file {
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success { value } => {
      run List<ModuleId>.append(&mut pending.*, move value)
    }
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure { error } => match move error {
      InvalidModulePath {} => {
        return ()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }

  // A barrel spelled by its own file name is refused, so it names no second file.
  if PackageGraph.isBarrel(path) {
    return ()
  }
  let barrel = run Effect.result(PackageGraph.barrel(&self.graph, importer, path))
  match move barrel {
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success { value } => {
      run List<ModuleId>.append(&mut pending.*, move value)
    }
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure { error } => match move error {
      InvalidModulePath {} => {}
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  return ()
}

// Parses `module`'s `bytes` for `preload`, which hands the unit to the store, and records the
// imports it writes. A file with a diagnostic is parsed on every load, so its syntax errors are
// reported whether or not anything else reads it.
effect fn parsedSummary(
  self: &mut ModuleSources,
  module: &ModuleId,
  bytes: Bytes,
  digest: ContentHash,
  sealedNames: &[Bytes],
) -> ImportSummary
  ! OutOfMemoryError
  ? &mut Allocator {
  return run summaryOf(
    &mut self.*,
    module,
    run SourceUnit.parseSyntax(move bytes),
    digest,
    sealedNames,
  )
}

// The summary of the file of `module` whose syntax is `parsed`, kept as a unit the store takes.
effect fn summaryOf(
  self: &mut ModuleSources,
  module: &ModuleId,
  parsed: Parsed,
  digest: ContentHash,
  sealedNames: &[Bytes],
) -> ImportSummary
  ! OutOfMemoryError
  ? &mut Allocator {
  let unit = run SourceUnit.assemble(module, Revision.revisionNumber(&self.revision), move parsed)
  let sealed = SealedOperators.referenced(&unit.syntax, sealedNames)
  let index = run ModuleIndex.build(&unit, false)
  let mut paths = run ModuleIndex.importPaths(&index, &unit)
  run EmbeddedFiles.append(&unit.authored, &mut paths)
  let claims = Semantic.claimsForeignSymbols(&unit.authored, &index)
  // The import summary records written erased types. An ambient declaration owns its
  // private receiver, but importing its module alone introduces no provider.
  let erased = unit.authored.hasErasedType
  let unused = run UnusedBindings.find(&unit.authored)
  if let Option<ImportSummaries>.Some { value: summaries } = &mut self.summaries {
    if SourceUnit.diagnosticCount(&unit) == usize.ZERO {
      run Summaries.add(
        &mut summaries,
        digest,
        sealed,
        claims,
        erased,
        unit.authored.hasTraceDirective,
        List<Bytes>.asSlice(&paths),
        List<Unused>.asSlice(&unused),
      )
    }
  }
  let traced = unit.authored.hasTraceDirective
  run List<SourceUnit>.append(&mut self.parsed, move unit)
  return ImportSummary {
    digest: digest,
    sealed: sealed,
    claims: claims,
    erased: erased,
    traced: traced,
    paths: move paths,
    unused: move unused,
  }
}

/// Lets `preload` take a file's imports from `summaries` instead of parsing it, and record the
/// imports of each file it parses there.
pub fn useSummaries(self: &mut ModuleSources, summaries: ImportSummaries) -> () {
  self.summaries = Option<ImportSummaries>.some(move summaries)
}

/// Lets `preload` take the files `snapshot` holds instead of reading them, and keep there each file
/// it reads.
pub fn useSnapshot(self: &mut ModuleSources, snapshot: SourceSnapshot) -> () {
  self.snapshot = Option<SourceSnapshot>.some(move snapshot)
}

/// One line per package these sources read although its `silk-version` does not fit this Silk,
/// read because of `--ignore-silk-version`.
pub fn versionNotes(self: &ModuleSources) -> &[Bytes] {
  return PackageSources.versionNotes(&self.packages)
}

/// Takes the snapshot [`useSnapshot`] gave, with the files the last load read.
pub fn takeSnapshot(self: &mut ModuleSources) -> Option<SourceSnapshot> {
  return Intrinsic.replace(self.snapshot, Option<SourceSnapshot>.none())
}

/// Takes the summaries [`useSummaries`] gave, with what the last load recorded.
pub fn takeSummaries(self: &mut ModuleSources) -> Option<ImportSummaries> {
  return Intrinsic.replace(self.summaries, Option<ImportSummaries>.none())
}

/// Takes the modules the last load found to declare no foreign claim, for a store's
/// `offerClaimFree`.
pub fn takeClaimFree(self: &mut ModuleSources) -> List<ModuleId> {
  return Intrinsic.replace(self.claimFree, List<ModuleId>.make())
}

/// Takes whether a module the loads since the last take read writes an erased type, for a store's
/// `offerErasure`. A load reads this from a file's summary or its parse alike, so it holds
/// whichever modules the store goes on to parse.
pub fn takeErasure(self: &mut ModuleSources) -> bool {
  return Intrinsic.replace(self.erased, false)
}

/// The unused-binding warnings (MOD0007, SEM0255) of each of `modules`, module by module in the
/// order given, for the text [`preload`] or [`refreshFromDisk`] last read of it; [`reread`] leaves
/// them as they were. A file's come from its summary when its bytes are unchanged, so a warm load
/// reports them without parsing it.
pub effect fn unusedWarnings(self: &ModuleSources, modules: &[ModuleId]) -> List<Shared<Rejection>>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut warnings = List<Shared<Rejection>>.make()
  let recorded = List<ModuleUnused>.asSlice(&self.unused)
  let mut at = usize.ZERO
  while at < modules.length {
    let mut index = usize.ZERO
    while index < recorded.length {
      if ModuleId.equals(&recorded[index].module, &modules[at]) {
        run Semantics.appendUnusedWarnings(
          &mut warnings,
          &modules[at],
          List<Unused>.asSlice(&recorded[index].found),
        )
        break
      }
      index = index + usize.ONE
    }
    at = at + usize.ONE
  }
  return move warnings
}

/// Takes the units `preload` parsed, for a store's `offerParsed`.
pub fn takeParsed(self: &mut ModuleSources) -> List<SourceUnit> {
  return Intrinsic.replace(self.parsed, List<SourceUnit>.make())
}

/// Publishes, from disk, every module that `text` imports when it is the text of `module`, and
/// everything those import, as [`preload`] does. The language server calls it with an open
/// document's unsaved text, whose imports may name modules no earlier text reached.
pub effect fn preloadImports(self: &mut ModuleSources, module: &ModuleId, text: &[u8]) -> ()
  ! FileError | InvalidModulePath | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let unit = run SourceUnit.parse(
    module,
    Revision.revisionNumber(&self.revision),
    run Bytes.copy(text),
  )
  return run preloadUnitImports(&mut self.*, &unit)
}

// Publishes, from disk, every module that `unit` imports, and everything those import.
effect fn traceImports(self: &ModuleSources, targets: &mut List<ModuleId>) -> () ! OutOfMemoryError ? &mut Allocator {
  if let Option<TraceDirective>.Some {value} = &self.traceDirective {
    run List<ModuleId>.append(&mut targets.*, ModuleId.copy(&value.enter.module))
    if !listed(targets.asSlice(), &value.exit.module) { run targets.append(ModuleId.copy(&value.exit.module)) }
    if !listed(targets.asSlice(), &value.failed.module) { run targets.append(ModuleId.copy(&value.failed.module)) }
    if !listed(targets.asSlice(), &value.cancelled.module) { run targets.append(ModuleId.copy(&value.cancelled.module)) }
  }
}

effect fn preloadUnitImports(self: &mut ModuleSources, unit: &SourceUnit) -> ()
  ! FileError | InvalidModulePath | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let module = &unit.id
  let index = run ModuleIndex.build(unit, false)
  let mut paths = run ModuleIndex.importPaths(&index, unit)
  run EmbeddedFiles.append(&unit.authored, &mut paths)
  let written = List<Bytes>.asSlice(&paths)
  let mut roots = List<ModuleId>.make()
  if unit.authored.hasTraceDirective { run traceImports(&self.*, &mut roots) }
  let mut at = usize.ZERO
  while at < written.length {
    if let Option<&[u8]>.Some { value: embedded } = move EmbeddedFiles.embedded(
      Bytes.asSlice(&written[at]),
    ) {
      run publishEmbedded(&mut self.*, module, embedded)
    } else if !SealedOperators.isPath(Bytes.asSlice(&written[at])) {
      run appendCandidates(&self.*, &mut roots, module, Bytes.asSlice(&written[at]))
    }
    at = at + usize.ONE
  }

  // A module an earlier load already read is published with its imports, so only the modules the
  // text newly reaches are walked; an edit that adds no import reads no other file.
  let mut fresh = List<ModuleId>.make()
  let candidates = List<ModuleId>.asSlice(&roots)
  at = usize.ZERO
  while at < candidates.length {
    if !attempted(&self.*, &candidates[at]) {
      run List<ModuleId>.append(&mut fresh, ModuleId.copy(&candidates[at]))
    }
    at = at + usize.ONE
  }
  run recordImports(&mut self.*, module, move roots)
  if List<ModuleId>.length(&fresh) == usize.ZERO {
    return ()
  }
  return run preload(&mut self.*, List<ModuleId>.asSlice(&fresh))
}

/// Makes `preloadProgram` load only what the program's roots import, without the package's
/// exported modules, as a tasks program does.
pub fn loadEntryOnly(self: &mut ModuleSources) -> () {
  self.entryOnly = true
  return ()
}

/// Publishes the whole program a build of `application` can read: the entry, the application,
/// the runtime when one is selected, the modules the language reads without an import, and
/// everything they import.
pub effect fn preloadProgram(self: &mut ModuleSources, application: &ModuleId) -> ()
  ! FileError | InvalidModulePath | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut roots = List<ModuleId>.make()
  run List<ModuleId>.append(&mut roots, ModuleId.copy(&self.entry))
  run List<ModuleId>.append(&mut roots, ModuleId.copy(application))
  if let Option<ModuleId>.Some { value: runtime } = &self.runtime {
    run List<ModuleId>.append(&mut roots, ModuleId.copy(&runtime))
  }
  let supported = List<ModuleId>.asSlice(&self.support)
  let mut supportAt = usize.ZERO
  while supportAt < supported.length {
    run List<ModuleId>.append(&mut roots, ModuleId.copy(&supported[supportAt]))
    supportAt = supportAt + usize.ONE
  }

  // Layout contracts read the standard library's layout module without an import.
  run List<ModuleId>.append(
    &mut roots,
    run module(&self.*, PackageGraph.standardPath(&self.graph, StandardRole.Layout)),
  )

  // The declared library interfaces remain implicit until the approved alias migration (OP-009).
  // Sealed interfaces are published only when preload sees a reference (INTR-007).
  run List<ModuleId>.append(
    &mut roots,
    run module(&self.*, PackageGraph.standardPath(&self.graph, StandardRole.Ops)),
  )
  run List<ModuleId>.append(
    &mut roots,
    run module(&self.*, PackageGraph.standardPath(&self.graph, StandardRole.Equal)),
  )
  run List<ModuleId>.append(
    &mut roots,
    run module(&self.*, PackageGraph.standardPath(&self.graph, StandardRole.Order)),
  )
  if let Option<ExecutionStorage>.Some { value: storage } = &self.storage {
    run List<ModuleId>.append(&mut roots, ModuleId.copy(&storage.create.module))
    run List<ModuleId>.append(&mut roots, ModuleId.copy(&storage.acquire.module))
    run List<ModuleId>.append(&mut roots, ModuleId.copy(&storage.release.module))
    run List<ModuleId>.append(&mut roots, ModuleId.copy(&storage.destroy.module))
  }
  let retained = List<RetentionRoot>.asSlice(&self.retention)
  let mut at = usize.ZERO
  while at < retained.length {
    run List<ModuleId>.append(&mut roots, ModuleId.copy(&retained[at].module))
    at = at + usize.ONE
  }

  // The package's exported modules are checked even when its root imports none of them.
  if !self.entryOnly {
    let mut exported = run exportedModules(&self.*)
    while List<ModuleId>.length(&exported) > usize.ZERO {
      run List<ModuleId>.append(&mut roots, List<ModuleId>.remove(&mut exported, usize.ZERO))
    }
  }
  run preload(&mut self.*, List<ModuleId>.asSlice(&roots))
  self.programRoots = move roots
  return ()
}

// Records `targets`, the modules the text of `module` just read imports, in place of what an
// earlier text of it imported.
effect fn recordImports(self: &mut ModuleSources, module: &ModuleId, targets: List<ModuleId>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at = usize.ZERO
  while at < List<ModuleImports>.length(&self.imports) {
    if ModuleId.equals(&List<ModuleImports>.asSlice(&self.imports)[at].module, module) {
      drop List<ModuleImports>.remove(&mut self.imports, at)
      break
    }
    at = at + usize.ONE
  }
  return run List<ModuleImports>.append(
    &mut self.imports,
    ModuleImports { module: ModuleId.copy(module), targets: move targets },
  )
}

/// The modules the program's roots reach through the imports of the texts last read, roots
/// included. A module an edit stopped importing is still loaded and stays in the revision, but a
/// check no longer sweeps it or reports its warnings, as a fresh load would not read it. Before
/// `preloadProgram` runs, every loaded module is reached.
pub effect fn reached(self: &ModuleSources) -> Reach
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut reach = Reach { modules: List<ModuleId>.make(), lookup: InternIndex.make() }
  let mut from = List<ModuleId>.asSlice(&self.programRoots)
  if from.length == usize.ZERO {
    from = List<ModuleId>.asSlice(&self.attempted)
  }
  let mut at = usize.ZERO
  while at < from.length {
    drop run reachModule(&mut reach, &from[at])
    at = at + usize.ONE
  }

  // Each module's imports, found by module, once.
  let mut lookup = InternIndex.make()
  let recorded = List<ModuleImports>.asSlice(&self.imports)
  at = usize.ZERO
  while at < recorded.length {
    run InternIndex.record(&mut lookup, ModuleId.hash(&recorded[at].module))
    at = at + usize.ONE
  }
  let mut next = usize.ZERO
  while next < List<ModuleId>.length(&reach.modules) {
    let module = ModuleId.copy(&List<ModuleId>.asSlice(&reach.modules)[next])
    next = next + usize.ONE
    let mut entry = InternIndex.first(&lookup, ModuleId.hash(&module))
    while entry != usize.MAX && !ModuleId.equals(&recorded[entry].module, &module) {
      entry = InternIndex.after(&lookup, entry)
    }
    if entry == usize.MAX {
      continue
    }
    let targets = List<ModuleId>.asSlice(&recorded[entry].targets)
    let mut target = usize.ZERO
    while target < targets.length {
      drop run reachModule(&mut reach, &targets[target])
      target = target + usize.ONE
    }
  }
  return move reach
}

/// The modules the root package's `[package].exports` lists, in manifest order.
pub effect fn exportedModules(self: &ModuleSources) -> List<ModuleId>
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
  let mut modules = List<ModuleId>.make()
  let listed = PackageSources.rootExports(&self.packages)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<ModuleId>.append(
      &mut modules,
      run ModuleId.sibling(&self.entry, Bytes.asSlice(&listed[at])),
    )
    at = at + usize.ONE
  }
  return move modules
}

fn listed(modules: &[ModuleId], module: &ModuleId) -> bool {
  let mut at = usize.ZERO
  while at < modules.length {
    if ModuleId.equals(&modules[at], module) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

/// Reports whether a semantic store read a module this build never published. Preloading
/// publishes every module the store can demand, so this is a driver defect.
pub fn missedSource(self: &ModuleSources, events: &[Event]) -> bool {
  return missedModule(self, events) != usize.MAX
}

/// The event of the first read [`missedSource`] reports, or `usize.MAX`.
pub fn missedModule(self: &ModuleSources, events: &[Event]) -> usize {
  let mut at = usize.ZERO
  while at < events.length {
    let event = &events[at]
    if event.kind == EventKind.SourceRead && !event.present && !attempted(self, &event.module) {
      // Operator discovery observes this implicit source's absence when no module names it.
      if !ModuleId.withPath<bool>(&event.module, SealedOperators.isPath) {
        return at
      }
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

/// One way an import path can go on: a module file it can end at, or a directory it can go on
/// through.
pub struct ImportStep {
  /// The segment, such as `mem` or `allocator`.
  pub name: Bytes,
  /// The module the path names when it ends at this segment; none for a directory, which names
  /// one only through its barrel.
  pub module: Option<ModuleId>,
  /// Whether the segment is a directory, after which the path can go on.
  pub directory: bool,
}

/// What an import path can go on with after its written segments.
pub struct ImportListing {
  /// The segments that can follow, in listing order.
  pub steps: List<ImportStep>,
  /// The barrel module `mod.silk` of the directory the written path names, which the path
  /// itself imports; none when the directory has none.
  pub barrel: Option<ModuleId>,
}

/// The segments an import path written in `importer` can go on with after `written`, its segments
/// joined by `/` such as `silk/mem`, or empty before the first segment.
///
/// # Details
///
/// The written path names the directory that an import of a module below it reads
/// ([`PackageGraph.target`]), so a standard-library path lists the library and a path that starts
/// with a dependency name lists that dependency's source root. Each source file named by an
/// identifier is a step to the module it holds, when `importer` may import that module
/// (PACKAGE-006), and each directory named by an identifier is a step to go on through. Modules a
/// `build.silk` plan generates there are steps too. Before the first segment, each dependency name
/// of `importer`'s package and `silk`, when the build reads a standard library, are directories as
/// well. A directory that cannot be listed gives no steps.
pub effect fn importListing(
  self: &ModuleSources,
  importer: &ModuleId,
  written: &[u8],
) -> ImportListing
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut listing = ImportListing {
    steps: List<ImportStep>.make(),
    barrel: Option<ModuleId>.none(),
  }
  if written.length == usize.ZERO {
    let owner = run ModuleId.copyPackage(importer)
    let names = run PackageGraph.dependencyNames(&self.graph, Bytes.asSlice(&owner))
    let listed = List<Bytes>.asSlice(&names)
    let mut at = usize.ZERO
    while at < listed.length {
      run List<ImportStep>.append(
        &mut listing.steps,
        ImportStep {
          name: run Bytes.copy(Bytes.asSlice(&listed[at])),
          module: Option<ModuleId>.none(),
          directory: true,
        },
      )
      at = at + usize.ONE
    }
    if let Option<Path>.Some { .. } = &self.standardLibrary {
      run List<ImportStep>.append(
        &mut listing.steps,
        ImportStep {
          name: run Bytes.copy(b"silk"),
          module: Option<ModuleId>.none(),
          directory: true,
        },
      )
    }
  }
  let mut probe = run Bytes.copy(written)
  if written.length > usize.ZERO {
    run Bytes.append(&mut probe, b"/")
  }
  run Bytes.append(&mut probe, b"mod.silk")
  let anchor = match move run Effect.result(
    PackageGraph.target(&self.graph, importer, Bytes.asSlice(&probe)),
  ) {
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success { value } => move value
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure { error } => match move error {
      InvalidModulePath {} => {
        return move listing
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let anchorPath = run ModuleId.copyPath(&anchor)

  // The written directory as a logical path prefix, such as `mem/`, in the anchor's package.
  let prefix = Slice.view<u8>(
    Bytes.asSlice(&anchorPath),
    usize.ZERO,
    Bytes.length(&anchorPath) - b"mod.silk".length,
  )
  let located = match move run Effect.result(sourceLocation(self, &anchor)) {
    Result<SourceLocation, FileError | OutOfMemoryError>.Success { value } => move value
    Result<SourceLocation, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        drop failure
        return move listing
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  if let Option<Path>.Some { value: file } = &located.path {
    let raw = Path.rawBytes(&file)
    let directory = Slice.view<u8>(raw, usize.ZERO, raw.length - b"/mod.silk".length)
    let children = run listedChildren(directory)
    let listed = List<Child>.asSlice(&children)
    let mut child = usize.ZERO
    while child < listed.length {
      let name = Bytes.asSlice(&listed[child].name)
      if listed[child].directory {
        if identifier(name) && !stepped(List<ImportStep>.asSlice(&listing.steps), name) {
          run List<ImportStep>.append(
            &mut listing.steps,
            ImportStep {
              name: run Bytes.copy(name),
              module: Option<ModuleId>.none(),
              directory: true,
            },
          )
        }
      } else if sameText(name, b"mod.silk") {
        if run PackageGraph.exported(&self.graph, importer, &anchor) {
          listing.barrel = Option<ModuleId>.some(ModuleId.copy(&anchor))
        }
      } else if name.length > b".silk".length && endsWith(name, b".silk") {
        let stem = Slice.view<u8>(name, usize.ZERO, name.length - b".silk".length)
        run appendModuleStep(self, &mut listing, importer, &anchor, prefix, stem)
      }
      child = child + usize.ONE
    }
  }

  // Generated modules have no file; they sit directly below the package's source root.
  let package = run ModuleId.copyPackage(&anchor)
  let generated = List<GeneratedModule>.asSlice(&self.generated)
  let mut at = usize.ZERO
  while at < generated.length {
    let path = Bytes.asSlice(&generated[at].path)
    if sameText(Bytes.asSlice(&generated[at].package), Bytes.asSlice(&package))
      && startsWith(path, prefix)
      && !holdsSlash(Slice.view<u8>(path, prefix.length, path.length - prefix.length))
      && endsWith(path, b".silk") {
      let stem = Slice.view<u8>(path, prefix.length, path.length - prefix.length - b".silk".length)
      run appendModuleStep(self, &mut listing, importer, &anchor, prefix, stem)
    }
    at = at + usize.ONE
  }
  return move listing
}

// Appends the step to the module file `stem` below `prefix`, in the package of `anchor`, when it
// is named by an identifier, not yet listed, and `importer` may import it.
effect fn appendModuleStep(
  self: &ModuleSources,
  listing: &mut ImportListing,
  importer: &ModuleId,
  anchor: &ModuleId,
  prefix: &[u8],
  stem: &[u8],
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !identifier(stem) {
    return ()
  }
  let mut path = run Bytes.copy(prefix)
  run Bytes.append(&mut path, stem)
  run Bytes.append(&mut path, b".silk")
  let module = match move run Effect.result(ModuleId.sibling(anchor, Bytes.asSlice(&path))) {
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success { value } => move value
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure { error } => match move error {
      InvalidModulePath {} => {
        return ()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  if !run PackageGraph.exported(&self.graph, importer, &module) {
    return ()
  }
  let steps = List<ImportStep>.asMutSlice(&mut listing.steps)
  let mut at = usize.ZERO
  while at < steps.length {
    if sameText(Bytes.asSlice(&steps[at].name), stem) {
      // A directory of the same name: the path can end here or go on.
      if let Option<ModuleId>.None = &steps[at].module {
        steps[at].module = Option<ModuleId>.some(move module)
      }
      return ()
    }
    at = at + usize.ONE
  }
  run List<ImportStep>.append(
    &mut listing.steps,
    ImportStep {
      name: run Bytes.copy(stem),
      module: Option<ModuleId>.some(move module),
      directory: false,
    },
  )
  return ()
}

// One child of a listed directory: its name and whether it is a directory itself.
struct Child {
  name: Bytes,
  directory: bool,
}

// The children of `directory`; empty when it cannot be listed.
effect fn listedChildren(directory: &[u8]) -> List<Child>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut found = List<Child>.make()
  let path = match move run Effect.result(Path.fromBytes(directory)) {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        drop failure
        return move found
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let children = match move run Effect.result(FileSystem.listDirectory(&path)) {
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success { value } => move value
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      FileError failure => {
        drop failure
        return move found
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let listed = List<DirectoryEntry>.asSlice(&children)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<Child>.append(
      &mut found,
      Child {
        name: run Bytes.copy(lastComponent(Path.rawBytes(&listed[at].path))),
        directory: listed[at].kind.code == FileSystem.directory().code,
      },
    )
    at = at + usize.ONE
  }
  return move found
}

fn stepped(steps: &[ImportStep], name: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < steps.length {
    if sameText(Bytes.asSlice(&steps[at].name), name) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn endsWith(text: &[u8], suffix: &[u8]) -> bool {
  return text.length >= suffix.length
    && sameText(Slice.view<u8>(text, text.length - suffix.length, suffix.length), suffix)
}

fn holdsSlash(text: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < text.length {
    if text[at] == 47 {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

/// Opens the exact sources and runtime a compilation request names, without manifest discovery or build-plan evaluation.
pub effect fn fromRequest(request: &CompilationRequest) -> ModuleSources
  ! FileError
    | InvalidSourceRoot
    | InvalidModulePath
    | InvalidNativeLinkInput
    | InvalidBuildComposition
    | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let packages = run PackageSources.fromRequest(request)
  let root = run Path.make(
    List<CompilationRequests.Package>.asSlice(&request.packages)[0].source.view(),
  )
  let package = run Bytes.copy(PackageSources.packageIdentity(&packages, usize.ZERO))
  let relative = run CommandPath.relative(PackageSources.directoryAt(&packages, usize.ZERO), &root)
  let source = run Path.make(request.root.view())
  let logical = run Bytes.copy(String.ownedUtf8Bytes(&request.rootModule))
  let entry = run ModuleId.make(b"file", Bytes.asSlice(&package), Bytes.asSlice(&logical))
  let standardLibrary = Option<Path>.some(run Path.make(request.stdlib.view()))
  let standard = run ModuleId.make(b"file", standardPackage(), b"silk/core/option.silk")
  let mut graph = run PackageSources.graph(&packages, &standard)
  if let Option<Path>.Some { value: library } = &standardLibrary {
    if let Option<JsonValue>.Some { value: document } = move run catalog(&library) {
      run catalogRoles(&document, &mut graph)
    }
  }
  let mut runtime = Option<ModuleId>.none()
  if let Option<CompilationRequests.ModuleRef>.Some { value } = &request.composition.runtime {
    runtime = Option<ModuleId>.some(run requestModule(&value))
  }
  let traceDirective = match &request.composition.traceDirective {
    Option<CompilationRequests.TraceDirective>.Some {value} => Option<TraceDirective>.some(TraceDirective {
      enter: run requestBinding(&value.enter), exit: run requestBinding(&value.exit),
      failed: run requestBinding(&value.failed), cancelled: run requestBinding(&value.cancelled),
    })
    Option<CompilationRequests.TraceDirective>.None => Option<TraceDirective>.none()
  }
  let mut storage = Option<ExecutionStorage>.none()
  if let Option<CompilationRequests.Storage>.Some { value } = &request.composition.storage {
    storage = Option<ExecutionStorage>.some(
      ExecutionStorage {
        create: run requestBinding(&value.create),
        acquire: run requestBinding(&value.acquire),
        release: run requestBinding(&value.release),
        destroy: run requestBinding(&value.destroy),
      },
    )
  }
  let mut support = List<ModuleId>.make()
  let mut supportHosted = List<bool>.make()
  let suppliedSupport = List<CompilationRequests.Support>.asSlice(&request.composition.support)
  let mut at = usize.ZERO
  while at < suppliedSupport.length {
    run List<ModuleId>.append(&mut support, run requestModule(&suppliedSupport[at].module))
    run List<bool>.append(&mut supportHosted, suppliedSupport[at].hosted)
    at = at + usize.ONE
  }
  let mut retention = List<RetentionRoot>.make()
  let suppliedRetention = List<CompilationRequests.Selector>.asSlice(&request.composition.retention)
  at = usize.ZERO
  while at < suppliedRetention.length {
    let binding = run requestBinding(&suppliedRetention[at])
    run List<RetentionRoot>.append(
      &mut retention,
      RetentionRoot { module: move binding.module, declaration: move binding.declaration },
    )
    at = at + usize.ONE
  }
  let linkInputs = run NativeLinkInputs.fromRequest(&request.native)
  let archives = List<Archive>.make()
  let mut functionOrder = Option<Path>.none()
  if let Option<String>.Some { value } = &request.native.functionOrder {
    functionOrder = Option<Path>.some(run Path.make(value.view()))
  }
  let content = Option<Bytes>.some(run FileSystem.readFile(&source))
  let revision = run Revision.publish(&Revision.make(), &entry, &content)
  let mut attempted = List<ModuleId>.make()
  run List<ModuleId>.append(&mut attempted, ModuleId.copy(&entry))
  let mut sources = ModuleSources {
    root: move root,
    package: move package,
    directory: move relative,
    standardLibrary: move standardLibrary,
    entry: move entry,
    entrySource: move source,
    runtime: move runtime,
    storage: move storage,
    traceDirective: move traceDirective,
    support: move support,
    supportHosted: move supportHosted,
    retention: move retention,
    linkInputs: move linkInputs,
    archives: move archives,
    functionOrder: move functionOrder,
    packages: move packages,
    pendingDependencies: List<DependencyDemand>.make(),
    graph: move graph,
    revision: move revision,
    attempted: move attempted,
    parsed: List<SourceUnit>.make(),
    summaries: Option<ImportSummaries>.none(),
    snapshot: Option<SourceSnapshot>.none(),
    digests: List<LoadedDigest>.make(),
    unused: List<ModuleUnused>.make(),
    imports: List<ModuleImports>.make(),
    programRoots: List<ModuleId>.make(),
    entryOnly: false,
    generated: List<GeneratedModule>.make(),
    claimFree: List<ModuleId>.make(),
    erased: false,
    listings: List<Listing>.make(),
  }
  let suppliedPackages = List<CompilationRequests.Package>.asSlice(&request.packages)
  at = usize.ZERO
  while at < suppliedPackages.length {
    let modules = List<CompilationRequests.Module>.asSlice(&suppliedPackages[at].modules)
    let mut generated = usize.ZERO
    while generated < modules.length {
      let identity = run Bytes.copy(PackageSources.packageIdentity(&sources.packages, at))
      run addGeneratedFile(&mut sources, identity.asSlice(), &modules[generated])
      generated = generated + usize.ONE
    }
    at = at + usize.ONE
  }
  return move sources
}

effect fn requestModule(module: &CompilationRequests.ModuleRef) -> ModuleId
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
  return run ModuleId.make(
    b"file",
    String.ownedUtf8Bytes(&module.package),
    String.ownedUtf8Bytes(&module.module),
  )
}

effect fn requestBinding(selector: &CompilationRequests.Selector) -> StorageBinding
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
  return StorageBinding {
    module: run ModuleId.make(
      b"file",
      String.ownedUtf8Bytes(&selector.package),
      String.ownedUtf8Bytes(&selector.module),
    ),
    declaration: run Bytes.copy(String.ownedUtf8Bytes(&selector.declaration)),
  }
}

/// Resolves a root command's package selector through the declared dependency aliases.
pub effect fn selectedPackage(self: &ModuleSources, name: &[u8]) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  if sameText(name, b"self") {
    return Option<Bytes>.some(run Bytes.copy(self.package.asSlice()))
  }
  return run self.graph.dependencyIdentity(self.package.asSlice(), name)
}

/// Adds a generated file with an explicit logical identity, refusing collisions with source modules.
pub effect fn addGeneratedFile(
  self: &mut ModuleSources,
  package: &[u8],
  module: &CompilationRequests.Module,
) -> ()
  ! FileError | InvalidModulePath | InvalidSourceRoot | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut logical = run Bytes.copy(String.ownedUtf8Bytes(&module.name))
  run logical.append(b".silk")
  let identity = run ModuleId.make(b"file", package, logical.asSlice())
  if ModuleId.equals(&identity, &self.entry) {
    fail InvalidSourceRoot {}
  }
  let location = run sourceLocation(&self.*, &identity)
  if let Option<Path>.Some { value } = &location.path {
    if run FileSystem.exists(&value) {
      fail InvalidSourceRoot {}
    }
  }
  let listed = self.generated.asSlice()
  let mut at = usize.ZERO
  while at < listed.length {
    if sameText(listed[at].package.asSlice(), package)
      && sameText(listed[at].path.asSlice(), logical.asSlice()) {
      fail InvalidSourceRoot {}
    }
    at = at + usize.ONE
  }
  let file = run Path.make(module.source.view())
  let source = run FileSystem.readFile(&file)
  let producer = match &module.producer {
    Option<String>.Some { value } => Option<String>.some(run String.copy(value.view()))
    Option<String>.None => Option<String>.none()
  }
  run self.generated.append(
    GeneratedModule {
      package: run Bytes.copy(package),
      path: move logical,
      source: move source,
      file: Option<Path>.some(move file),
      producer: move producer,
    },
  )
}

/// The native archive pins owned by package `at`, after selecting target and overrides.
pub fn packageArchivesAt(self: &ModuleSources, at: usize) -> &[Archive] {
  return PackageSources.archives(&self.packages, at)
}

struct DependencyDemand {
  owner: Bytes,
  name: Bytes
}

/// Demands the dependency `name` of the package at `owner`, as `Plan.linkDependency` names it,
/// so `resolveDependencies` loads it though no import reaches it. Answers false when the package
/// does not declare `name`.
pub effect fn demandLinked(self: &mut ModuleSources, owner: usize, name: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let identity = PackageSources.packageIdentity(&self.packages, owner)
  if !PackageSources.declares(&self.packages, identity, name) {
    return false
  }
  run self.pendingDependencies.append(
    DependencyDemand { owner: run Bytes.copy(identity), name: run Bytes.copy(name) },
  )
  return true
}

effect fn demandDependency(self: &mut ModuleSources, module: &ModuleId, path: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut end: usize = 0
  while end < path.length && path[end] != 47 {
    end = end + 1
  }
  if end == path.length && end >= 5 && sameText(Slice.view<u8>(path, end - 5, 5), b".silk") {
    end = end - 5
  }
  let name = Slice.view<u8>(path, 0, end)
  let owner = run ModuleId.copyPackage(module)
  if !PackageSources.pending(&self.packages, owner.asSlice(), name) {
    return ()
  }
  let listed = self.pendingDependencies.asSlice()
  let mut at: usize = 0
  while at < listed.length {
    if sameText(listed[at].owner.asSlice(), owner.asSlice())
      && sameText(listed[at].name.asSlice(), name) {
      return ()
    }
    at = at + 1
  }
  return run self.pendingDependencies.append(
    DependencyDemand { owner: move owner, name: run Bytes.copy(name) },
  )
}

/// Loads only dependency aliases found by the ordinary module import preloader.
/// Newly loaded packages are returned to the caller before their modules are analyzed, so their
/// static plans can supply generated modules and native inputs first.
pub effect fn resolveDependencies(self: &mut ModuleSources) -> bool
  ! InvalidDependency
    | FileError
    | HostInputError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidBuildComposition
    | InvalidNativeLinkInput
    | OutOfMemoryError
  ? &mut FileSystem | &mut ChildProcess | &mut HostInput | &mut Allocator {
  let pending = Intrinsic.replace(self.pendingDependencies, List<DependencyDemand>.make())
  let listed = pending.asSlice()
  let mut changed = false
  let mut at: usize = 0
  while at < listed.length {
    if run PackageSources.require(
      &mut self.packages,
      listed[at].owner.asSlice(),
      listed[at].name.asSlice(),
    ) {
      changed = true
    }
    at = at + 1
  }
  if changed {
    run refuseSharedArchives(
      self.package.asSlice(),
      PackageSources.archives(&self.packages, 0),
      &self.packages,
    )
    let standard = run ModuleId.make(b"file", standardPackage(), b"silk/core/option.silk")
    self.graph = run PackageSources.graph(&self.packages, &standard)
    if let Option<Path>.Some { value: directory } = &self.standardLibrary {
      if let Option<JsonValue>.Some { value: document } = move run catalog(&directory) {
        run catalogRoles(&document, &mut self.graph)
      }
    }
  }
  return changed
}

/// Attaches the native inputs of one reached package's evaluated plan.
pub effect fn applyNativePlan(
  self: &mut ModuleSources,
  owner: usize,
  plan: PlannedNative,
  linked: bool,
) -> ()
  ! FileError | InvalidNativeLinkInput | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if let Option<Path>.Some { value } = move plan.functionOrder {
    let mut selected = move value
    if let Option<Path>.Some { value: previous } = &self.functionOrder {
      let mut contents = run FileSystem.readFile(&previous)
      run contents.append(b"\n")
      run contents.append((run FileSystem.readFile(&selected)).asSlice())
      let digest = Sha256.hash(contents.asSlice())
      let name = run Fingerprint.name(&digest)
      let root = PackageSources.directoryAt(&self.packages, 0)
      let cache = run Path.join(root, "build/steps/function-order")
      run FileSystem.createDirectoriesRecursively(&cache)
      selected = run Path.join(&cache, name.view())
      run FileSystem.writeFile(&selected, contents.asSlice())
    }
    self.functionOrder = Option<Path>.some(move selected)
  }
  PackageSources.setNative(&mut self.packages, owner, move plan.inputs)
  self.linkInputs = run linkedInputs(
    PackageSources.linkInputs(&self.packages, 0),
    &self.packages,
    linked,
  )
  let mut archives = List<Archive>.make()
  let limit = if linked {
    PackageSources.count(&self.packages)
  } else {
    1
  }
  let mut package: usize = 0
  while package < limit {
    let declared = PackageSources.archives(&self.packages, package)
    let mut at: usize = 0
    while at < declared.length {
      run archives.append(run NativeLinkInputs.copyArchive(&declared[at]))
      at = at + 1
    }
    package = package + 1
  }
  self.archives = move archives
}

/// Opens a source file as one package without discovering a manifest or reading dependency pins.
/// Neighboring imports resolve below the file's directory; executable runtimes come from the
/// selected standard-library catalog.
pub effect fn standalone(
  source: &Path,
  standardLibrary: Option<Path>,
  target: &[u8],
  libc: &[u8],
  executable: bool,
  runtime: RuntimeRequest,
) -> ModuleSources
  ! FileError
    | InvalidSourceRoot
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidModulePath
    | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let directory = match move run Path.parent(source) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      fail InvalidSourceRoot {}
    }
  }
  let packages = run PackageSources.standalone(&directory, target)
  let located = PackageRoot {
    directory: move directory,
    package: run Bytes.copy(b"source@0.0.0"),
    relative: Bytes.make(),
    runtime: RuntimeChoice.Catalog,
    components: Components.Catalog,
    retention: List<RetentionRoot>.make(),
    linkInputs: List<NativeLinkInput>.make(),
    archives: List<Archive>.make(),
    functionOrder: Option<Path>.none(),
    packages: move packages,
  }
  return run assemble(
    source,
    move located,
    move standardLibrary,
    target,
    libc,
    executable,
    executable,
    &runtime,
    Option<&Path>.none(),
  )
}
