/// A manifest without a package name or root, a non-text package version, or an entry outside that
/// root's module directory.
pub struct InvalidSourceRoot {}

/// No `silk.toml` in the entry's directory or any of its parent directories, so the build has no
/// logical package identity.
pub struct MissingManifest {
  /// The entry's directory, where the upward search for a manifest started.
  pub directory: Path,
}

/// A build that selects no single runtime module where it needs one: a `[unstable].composition` whose
/// default runtime candidates name more than one runtime or an unlisted one, an executable whose
/// composition names no default, or, without a composition, an executable whose standard-library
/// catalog lists no runtime for the target and libc (ARTIFACT-001).
pub struct InvalidBuildComposition {}

/// An executable without a `[unstable].composition` takes its runtime from the standard library's
/// composition catalog, but the build names no standard library: neither `--stdlib` nor one
/// installed beside the compiler.
pub struct MissingStandardLibrary {}

/// The owned filesystem roots and separately published module contents for one build.
pub struct ModuleSources {
  root: Path,
  /// The logical package identity, `name` or `name@version` from the manifest. Every module
  /// identity carries it instead of a host path, so a checkout's location never reaches a build.
  package: Bytes,
  /// The module directory relative to its manifest's directory, as `path.relative` spells it, such
  /// as `src` or `../shared`; empty when it is the manifest's directory.
  directory: Bytes,
  standardLibrary: Option<Path>,
  entry: ModuleId,
  /// The selected runtime source module, whose C exports root the build (ARTIFACT-002). A library
  /// or object form acquires no catalog runtime, so its application's C exports are its roots.
  runtime: Option<ModuleId>,
  /// The composition's execution-storage component, absent when none is selected validly.
  storage: Option<ExecutionStorage>,
  /// The composition's explicit retention roots, in manifest order (ARTIFACT-003).
  retention: List<RetentionRoot>,
  /// The manifest's `[native].link`, resolved against its directory.
  linkInputs: List<NativeLinkInput>,
  /// The root package and every package its dependencies reach (PACKAGE-002).
  packages: Packages,
  /// Which module each import path names, shared with semantic analysis.
  graph: PackageGraph,
  revision: Revision,
  attempted: List<ModuleId>,
  // Child names of the directories read so far, which check the letter case of each source path.
  listings: List<Listing>,
  /// The units `preload` parsed, until `takeParsed` hands them to a store.
  parsed: List<SourceUnit>,
  // The imports of files read before, which spare `preload` the parse of an unchanged file.
  summaries: Option<ImportSummaries>,
  // The modules the last load read and found to declare no foreign claim, for a store's
  // `offerClaimFree`.
  claimFree: List<ModuleId>,
  // The digest of each module the last load read with summaries, for `parsedDigests`.
  digests: List<LoadedDigest>,
}

struct LoadedDigest {
  module: ModuleId,
  digest: ContentHash,
}

// A file `preload` parses ahead on a thread of its own: the position of its module among those
// the load read, and its bytes.
struct ParseJob {
  slot: usize,
  bytes: Bytes,
}

// What a thread parsed for one `ParseJob`.
struct ParsedFile {
  slot: usize,
  parsed: Parsed,
}

/// The existing filesystem provider selected for one canonical source request.
pub enum ProviderRole { Compiler, StandardLibrary }

pub struct SourceLocation {
  pub provider: ProviderRole,
  /// No path exists when a standard-library request has no configured library root.
  pub path: Option<Path>,
}

fn startsWith(bytes: &[u8], prefix: &[u8]) -> bool {
  if bytes.length < prefix.length { return false }
  let mut at = usize.ZERO
  while at < prefix.length {
    if bytes[at] != prefix[at] { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn readOptional(path: &Path) -> Option<Bytes>
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let attempted = run Effect.result(FileSystem.readFile(path))
  return match move attempted {
    Result<Bytes, FileError | OutOfMemoryError>.Success {value} => Option<Bytes>.some(move value)
    Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => {
        if failure.reason.code == FileSystem.notFound().code {
          return Option<Bytes>.none()
        }
        run noteUnreadable(path)
        fail move failure
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// Names a source file that cannot be read on standard error, since `FileError` carries no path;
// the failure itself is reported after it.
effect fn noteUnreadable(path: &Path) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut line = run Bytes.copy(b"silk: cannot read ")
  run Bytes.append(&mut line, Path.rawBytes(path))
  run Bytes.append(&mut line, b"\n")
  let mut stderr = StderrWriter.make()
  let written = run Effect.result(Writer.writeAll(Bytes.asSlice(&line)) |> Effect.provideMut<Writer>(&mut stderr))
  drop written
}

// The package module directory, the logical path of its selected default runtime source, its
// composition's components table and its declared native link inputs.
struct PackageRoot {
  directory: Path,
  package: Bytes,
  relative: Bytes,
  runtime: RuntimeChoice,
  components: Components,
  retention: List<RetentionRoot>,
  linkInputs: List<NativeLinkInput>,
  packages: Packages,
}

// Where a package's components come from: its own `[unstable].composition`, or the standard
// library catalog when it declares no composition.
union Components {
  Declared {storage: Option<ExecutionStorage>},
  Catalog,
}

// The bindings read so far for the one `execution-storage` component.
struct StorageParts {
  components: usize,
  invalid: bool,
  create: Option<StorageBinding>,
  acquire: Option<StorageBinding>,
  release: Option<StorageBinding>,
  destroy: Option<StorageBinding>,
}

fn emptyParts() -> StorageParts {
  return StorageParts {
    components: usize.ZERO,
    invalid: false,
    create: Option<StorageBinding>.none(),
    acquire: Option<StorageBinding>.none(),
    release: Option<StorageBinding>.none(),
    destroy: Option<StorageBinding>.none(),
  }
}

fn present(binding: &Option<StorageBinding>) -> bool {
  return match &binding.* {
    Option<StorageBinding>.Some {..} => true
    Option<StorageBinding>.None => false
  }
}

// Records one binding; an unknown, repeated or unresolvable operation invalidates the component.
effect fn bind(parts: &mut StorageParts, package: &[u8], operation: &[u8], module: &[u8], declaration: &[u8]) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut logical = run Bytes.copy(module)
  run Bytes.append(&mut logical, b".silk")
  let resolved = run Effect.result(ModuleId.make(b"file", package, Bytes.asSlice(&logical)))
  let identity = match move resolved {
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success {value} => move value
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure {error} => match move error {
      InvalidModulePath {} => {
        parts.invalid = true
        return ()
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let binding = Option<StorageBinding>.some(StorageBinding {module: move identity, declaration: run Bytes.copy(declaration)})
  if sameText(operation, b"create") && !present(&parts.create) { parts.create = move binding }
  else if sameText(operation, b"acquire") && !present(&parts.acquire) { parts.acquire = move binding }
  else if sameText(operation, b"release") && !present(&parts.release) { parts.release = move binding }
  else if sameText(operation, b"destroy") && !present(&parts.destroy) { parts.destroy = move binding }
  else { parts.invalid = true }
  return ()
}

// Exactly one execution-storage component with all four operations selects storage.
fn finishStorage(parts: StorageParts) -> Option<ExecutionStorage> {
  let StorageParts {components, invalid, create, acquire, release, destroy} = move parts
  if components != usize.ONE || invalid { return Option<ExecutionStorage>.none() }
  if let Option<StorageBinding>.Some {value: created} = move create {
    if let Option<StorageBinding>.Some {value: acquired} = move acquire {
      if let Option<StorageBinding>.Some {value: released} = move release {
        if let Option<StorageBinding>.Some {value: destroyed} = move destroy {
          return Option<ExecutionStorage>.some(
            ExecutionStorage {create: move created, acquire: move acquired, release: move released, destroy: move destroyed},
          )
        }
      }
    }
  }
  return Option<ExecutionStorage>.none()
}

// Whether every key of the table `value` is one of `allowed`.
fn onlyKeys(value: &TomlValue, allowed: &[&[u8]]) -> bool {
  return match &value.* {
    TomlValue.Table {entries, kind: _} => {
      let boxed = Box<List<TomlChild>>.get(&entries)
      let children = List<TomlChild>.asSlice(&boxed[0])
      let mut at = usize.ZERO
      while at < children.length {
        if let TomlChild.Member {entry} = &children[at] {
          let key = String.ownedUtf8Bytes(&entry.key)
          let mut known = false
          let mut index = usize.ZERO
          while index < allowed.length {
            if sameText(key, allowed[index]) { known = true }
            index = index + usize.ONE
          }
          if !known { return false }
        }
        at = at + usize.ONE
      }
      return true
    }
    _ => false
  }
}

// Whether `text` is an identifier: an ASCII letter or `_`, then letters, digits or `_`.
fn identifier(text: &[u8]) -> bool {
  if text.length == usize.ZERO { return false }
  let mut at = usize.ZERO
  while at < text.length {
    let byte = text[at]
    let letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
    let digit = byte >= 48 && byte <= 57
    if !letter && !(digit && at > usize.ZERO) { return false }
    at = at + usize.ONE
  }
  return true
}

// Reads `retention` from a manifest composition: selectors of exactly a canonical `module` and an
// identifier `declaration`, as the TypeScript `ArtifactComposition.decode` admits.
effect fn manifestRetention(composition: &TomlValue, package: &[u8]) -> List<RetentionRoot>
! InvalidBuildComposition | OutOfMemoryError ? &mut Allocator {
  let mut roots = List<RetentionRoot>.make()
  let listed = match move Toml.field(composition, "retention") {
    Option<&TomlValue>.Some {value} => value
    Option<&TomlValue>.None => { return move roots }
  }
  let array = match &listed.* {
    TomlValue.Array {..} => true
    _ => false
  }
  if !array { fail InvalidBuildComposition {} }
  let keys: [&[u8]; 2] = [b"module", b"declaration"]
  let mut at = usize.ZERO
  while true {
    let selector = match move Toml.item(listed, at) {
      Option<&TomlValue>.Some {value} => value
      Option<&TomlValue>.None => { break }
    }
    at = at + usize.ONE
    if !onlyKeys(selector, &keys) { fail InvalidBuildComposition {} }
    let module = match move Toml.asString(Toml.field(selector, "module")) {
      Option<string>.Some {value} => String.utf8Bytes(value)
      Option<string>.None => { fail InvalidBuildComposition {} }
    }
    let declaration = match move Toml.asString(Toml.field(selector, "declaration")) {
      Option<string>.Some {value} => String.utf8Bytes(value)
      Option<string>.None => { fail InvalidBuildComposition {} }
    }
    if !identifier(declaration) { fail InvalidBuildComposition {} }
    let mut logical = run Bytes.copy(module)
    run Bytes.append(&mut logical, b".silk")
    let resolved = run Effect.result(ModuleId.make(b"file", package, Bytes.asSlice(&logical)))
    let identity = match move resolved {
      Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success {value} => move value
      Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure {error} => match move error {
        InvalidModulePath {} => { fail InvalidBuildComposition {} }
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
    run List<RetentionRoot>.append(&mut roots, RetentionRoot {module: move identity, declaration: run Bytes.copy(declaration)})
  }
  return move roots
}

// Reads `components` from a manifest composition.
effect fn manifestStorage(composition: &TomlValue, package: &[u8]) -> Option<ExecutionStorage>
! OutOfMemoryError ? &mut Allocator {
  let mut parts = emptyParts()
  let listed = match move Toml.field(composition, "components") {
    Option<&TomlValue>.Some {value} => value
    Option<&TomlValue>.None => { return Option<ExecutionStorage>.none() }
  }
  let mut at = usize.ZERO
  while true {
    let component = match move Toml.item(listed, at) {
      Option<&TomlValue>.Some {value} => value
      Option<&TomlValue>.None => { break }
    }
    at = at + usize.ONE
    let capability = match move Toml.asString(Toml.field(component, "capability")) {
      Option<string>.Some {value} => String.utf8Bytes(value)
      Option<string>.None => { return Option<ExecutionStorage>.none() }
    }
    if !sameText(capability, b"execution-storage") { continue }
    parts.components = parts.components + usize.ONE
    let bindings = match move Toml.field(component, "bindings") {
      Option<&TomlValue>.Some {value} => value
      Option<&TomlValue>.None => { return Option<ExecutionStorage>.none() }
    }
    let mut bindingAt = usize.ZERO
    while true {
      let entry = match move Toml.item(bindings, bindingAt) {
        Option<&TomlValue>.Some {value} => value
        Option<&TomlValue>.None => { break }
      }
      bindingAt = bindingAt + usize.ONE
      let operation = Toml.asString(Toml.field(entry, "operation"))
      let module = Toml.asString(Toml.field(entry, "module"))
      let declaration = Toml.asString(Toml.field(entry, "declaration"))
      if let Option<string>.Some {value: operationText} = move operation {
        if let Option<string>.Some {value: moduleText} = move module {
          if let Option<string>.Some {value: declarationText} = move declaration {
            run bind(&mut parts, package, String.utf8Bytes(operationText), String.utf8Bytes(moduleText),
              String.utf8Bytes(declarationText))
            continue
          }
        }
      }
      return Option<ExecutionStorage>.none()
    }
  }
  return finishStorage(move parts)
}

fn jsonItem<'a>(value: &'a JsonValue, index: usize) -> Option<&'a JsonValue> {
  return match &value.* {
    JsonValue.Array {values} => {
      let boxed = Box<List<JsonChild>>.get(&values)
      let items = List<JsonChild>.asSlice(&boxed[0])
      if index >= items.length { return Option<&'a JsonValue>.none() }
      return match &items[index] {
        JsonChild.Item {value: item} => Option<&'a JsonValue>.some(&item)
        _ => Option<&'a JsonValue>.none()
      }
    }
    _ => Option<&'a JsonValue>.none()
  }
}

// Parses the standard library's composition catalog, absent when the library has none or it is
// malformed.
effect fn catalog(directory: &Path) -> Option<JsonValue>
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let path = run Path.join(directory, "compositions.json")
  let read = run readOptional(&path)
  let contents = match move read {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return Option<JsonValue>.none() }
  }
  let parsed = run Effect.result(Json.parse(Bytes.asSlice(&contents)))
  return match move parsed {
    Result<JsonValue, JsonError | OutOfMemoryError>.Success {value} => Option<JsonValue>.some(move value)
    Result<JsonValue, JsonError | OutOfMemoryError>.Failure {error} => match move error {
      JsonError malformed => {
        drop malformed
        return Option<JsonValue>.none()
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// The logical source path of the catalog runtime listed for `target` and `libc`, if any.
effect fn catalogRuntime(document: &JsonValue, target: &[u8], libc: &[u8], named: Option<&[u8]>) -> Option<Bytes>
! OutOfMemoryError ? &mut Allocator {
  let listed = match move Json.field(document, "runtimes") {
    Option<&JsonValue>.Some {value} => value
    Option<&JsonValue>.None => { return Option<Bytes>.none() }
  }
  let mut at = usize.ZERO
  while true {
    let runtime = match move jsonItem(listed, at) {
      Option<&JsonValue>.Some {value} => value
      Option<&JsonValue>.None => { break }
    }
    at = at + usize.ONE
    let matchesLibc = match move Json.asString(Json.field(runtime, "libc")) {
      Option<string>.Some {value} => sameText(String.utf8Bytes(value), libc)
      Option<string>.None => false
    }
    if !matchesLibc { continue }
    if let Option<&[u8]>.Some {value: wanted} = &named {
      let matchesName = match move Json.asString(Json.field(runtime, "name")) {
        Option<string>.Some {value} => sameText(String.utf8Bytes(value), wanted)
        Option<string>.None => false
      }
      if !matchesName { continue }
    }
    let targets = match move Json.field(runtime, "targets") {
      Option<&JsonValue>.Some {value} => value
      Option<&JsonValue>.None => { continue }
    }
    let mut targetAt = usize.ZERO
    while true {
      let named = match move jsonItem(targets, targetAt) {
        Option<&JsonValue>.Some {value} => value
        Option<&JsonValue>.None => { break }
      }
      targetAt = targetAt + usize.ONE
      let selected = match move Json.asString(Option<&JsonValue>.some(named)) {
        Option<string>.Some {value} => sameText(String.utf8Bytes(value), target)
        Option<string>.None => false
      }
      if !selected { continue }
      let module = match move Json.asString(Json.field(runtime, "module")) {
        Option<string>.Some {value} => value
        Option<string>.None => { return Option<Bytes>.none() }
      }
      let mut logical = run Bytes.copy(String.utf8Bytes(module))
      run Bytes.append(&mut logical, b".silk")
      return Option<Bytes>.some(move logical)
    }
  }
  return Option<Bytes>.none()
}

// Reads `components` from the standard library's composition catalog.
effect fn catalogStorage(document: &JsonValue, package: &[u8]) -> Option<ExecutionStorage>
! OutOfMemoryError ? &mut Allocator {
  let listed = match move Json.field(document, "components") {
    Option<&JsonValue>.Some {value} => value
    Option<&JsonValue>.None => { return Option<ExecutionStorage>.none() }
  }
  let mut parts = emptyParts()
  let mut at = usize.ZERO
  while true {
    let component = match move jsonItem(listed, at) {
      Option<&JsonValue>.Some {value} => value
      Option<&JsonValue>.None => { break }
    }
    at = at + usize.ONE
    let capability = match move Json.asString(Json.field(component, "capability")) {
      Option<string>.Some {value} => String.utf8Bytes(value)
      Option<string>.None => { return Option<ExecutionStorage>.none() }
    }
    if !sameText(capability, b"execution-storage") { continue }
    parts.components = parts.components + usize.ONE
    let bindings = match move Json.field(component, "bindings") {
      Option<&JsonValue>.Some {value} => value
      Option<&JsonValue>.None => { return Option<ExecutionStorage>.none() }
    }
    let mut bindingAt = usize.ZERO
    while true {
      let entry = match move jsonItem(bindings, bindingAt) {
        Option<&JsonValue>.Some {value} => value
        Option<&JsonValue>.None => { break }
      }
      bindingAt = bindingAt + usize.ONE
      let operation = Json.asString(Json.field(entry, "operation"))
      let module = Json.asString(Json.field(entry, "module"))
      let declaration = Json.asString(Json.field(entry, "declaration"))
      if let Option<string>.Some {value: operationText} = move operation {
        if let Option<string>.Some {value: moduleText} = move module {
          if let Option<string>.Some {value: declarationText} = move declaration {
            run bind(&mut parts, package, String.utf8Bytes(operationText), String.utf8Bytes(moduleText),
              String.utf8Bytes(declarationText))
            continue
          }
        }
      }
      return Option<ExecutionStorage>.none()
    }
  }
  return finishStorage(move parts)
}

// Records in `graph` the module paths that `standard` in the standard library's composition catalog
// lists by role, such as `"layout": "silk/mem/layout"`. A role the catalog omits keeps its canonical
// path; one it lists as anything but a path is an invalid catalog.
effect fn catalogRoles(document: &JsonValue, graph: &mut PackageGraph) -> ()
! InvalidBuildComposition | OutOfMemoryError ? &mut Allocator {
  let listed = match move Json.field(document, "standard") {
    Option<&JsonValue>.Some {value} => value
    Option<&JsonValue>.None => { return () }
  }
  run catalogRole(listed, "layout", StandardRole.Layout, &mut graph.*)
  run catalogRole(listed, "option", StandardRole.Option, &mut graph.*)
  run catalogRole(listed, "ops", StandardRole.Ops, &mut graph.*)
  run catalogRole(listed, "equal", StandardRole.Equal, &mut graph.*)
  return run catalogRole(listed, "order", StandardRole.Order, &mut graph.*)
}

effect fn catalogRole(listed: &JsonValue, name: string, which: StandardRole, graph: &mut PackageGraph) -> ()
! InvalidBuildComposition | OutOfMemoryError ? &mut Allocator {
  let entry = match move Json.field(listed, name) {
    Option<&JsonValue>.Some {value} => value
    Option<&JsonValue>.None => { return () }
  }
  let module = match move Json.asString(Option<&JsonValue>.some(entry)) {
    Option<string>.Some {value} => value
    Option<string>.None => { fail InvalidBuildComposition {} }
  }
  if !libraryModulePath(String.utf8Bytes(module)) { fail InvalidBuildComposition {} }
  let mut logical = run Bytes.copy(String.utf8Bytes(module))
  run Bytes.append(&mut logical, b".silk")
  return run PackageGraph.assign(&mut graph.*, which, Bytes.asSlice(&logical))
}

// Whether `path` names a module below the library root, such as `silk/mem/layout`: `silk/` and
// then segments that are neither empty, `.` nor `..`.
fn libraryModulePath(path: &[u8]) -> bool {
  if !startsWith(path, b"silk/") { return false }
  let mut start: usize = 5
  let mut at: usize = 5
  while at <= path.length {
    if at == path.length || path[at] == 47 {
      let length = at - start
      if length == 0 { return false }
      if length == 1 && path[start] == 46 { return false }
      if length == 2 && path[start] == 46 && path[start + 1] == 46 { return false }
      start = at + 1
    }
    at = at + 1
  }
  return true
}

fn sameText(left: &[u8], right: &[u8]) -> bool {
  return left.length == right.length && startsWith(left, right)
}

// How a package selects its runtime: its `[unstable].composition` default, which may be absent for a
// library or object form, or the standard-library catalog when it declares no composition.
union RuntimeChoice {
  Declared {module: Option<Bytes>},
  Catalog,
}

// Resolves `[unstable].composition` for the profile's runtime `request`, `Catalog` when the manifest
// declares none. A `none` request selects no runtime. A named request selects the listed runtime
// of that name. The default request selects the composition's single default candidate, which only
// an executable requires; any other shape is invalid and never falls back to a hosted runtime.
effect fn defaultRuntime(document: &TomlValue, executable: bool, request: &RuntimeRequest) -> RuntimeChoice
! InvalidBuildComposition | OutOfMemoryError ? &mut Allocator {
  let composition = match move ManifestFields.composition(document) {
    Option<&TomlValue>.Some {value} => value
    Option<&TomlValue>.None => { return RuntimeChoice.Catalog }
  }
  match &request.* {
    RuntimeRequest.None => { return RuntimeChoice.Declared {module: Option<Bytes>.none()} }
    RuntimeRequest.Named {name} => {
      return RuntimeChoice.Declared {module: Option<Bytes>.some(run listedRuntime(composition, Bytes.asSlice(&name)))}
    }
    RuntimeRequest.Default => {}
  }
  let defaults = match move Toml.field(composition, "defaults") {
    Option<&TomlValue>.Some {value} => value
    Option<&TomlValue>.None => {
      if executable { fail InvalidBuildComposition {} }
      return RuntimeChoice.Declared {module: Option<Bytes>.none()}
    }
  }
  let listed = match &defaults.* {
    TomlValue.Array {..} => true
    _ => false
  }
  if !listed { fail InvalidBuildComposition {} }
  // An executable needs a runtime; an explicit composition never falls back to the catalog.
  if let Option<&TomlValue>.None = move Toml.item(defaults, usize.ZERO) {
    if executable { fail InvalidBuildComposition {} }
    return RuntimeChoice.Declared {module: Option<Bytes>.none()}
  }
  // Two default candidates are ambiguous even when both would compile for the target.
  if let Option<&TomlValue>.Some {..} = move Toml.item(defaults, usize.ONE) { fail InvalidBuildComposition {} }
  let selected = match move Toml.asString(Toml.item(defaults, usize.ZERO)) {
    Option<string>.Some {value} => String.utf8Bytes(value)
    Option<string>.None => { fail InvalidBuildComposition {} }
  }
  return RuntimeChoice.Declared {module: Option<Bytes>.some(run listedRuntime(composition, selected))}
}

// The logical module path of the runtime the composition lists as `selected`. A name the
// composition does not list never falls back to a hosted runtime.
effect fn listedRuntime(composition: &TomlValue, selected: &[u8]) -> Bytes
! InvalidBuildComposition | OutOfMemoryError ? &mut Allocator {
  let runtimes = match move Toml.field(composition, "runtimes") {
    Option<&TomlValue>.Some {value} => value
    Option<&TomlValue>.None => { fail InvalidBuildComposition {} }
  }
  let mut at = usize.ZERO
  while true {
    let descriptor = match move Toml.item(runtimes, at) {
      Option<&TomlValue>.Some {value} => value
      Option<&TomlValue>.None => { break }
    }
    at = at + usize.ONE
    let named = match move Toml.asString(Toml.field(descriptor, "name")) {
      Option<string>.Some {value} => String.utf8Bytes(value)
      Option<string>.None => { fail InvalidBuildComposition {} }
    }
    if sameText(named, selected) {
      let module = match move Toml.asString(Toml.field(descriptor, "module")) {
        Option<string>.Some {value} => String.utf8Bytes(value)
        Option<string>.None => { fail InvalidBuildComposition {} }
      }
      let mut logical = run Bytes.copy(module)
      run Bytes.append(&mut logical, b".silk")
      return move logical
    }
  }
  fail InvalidBuildComposition {}
}

// The manifest's logical package identity: `[package].name`, `@` and `[package].version`, which
// defaults to `0.0.0` (PROFILE-002). Physical checkout paths are not identities.
effect fn packageIdentity(document: &TomlValue) -> Bytes
! InvalidSourceRoot | OutOfMemoryError ? &mut Allocator {
  let name = match move Toml.asString(Toml.fieldAt(Toml.field(document, "package"), "name")) {
    Option<string>.Some {value} => String.utf8Bytes(value)
    Option<string>.None => { fail InvalidSourceRoot {} }
  }
  if name.length == usize.ZERO { fail InvalidSourceRoot {} }
  let version = ManifestFields.version(document)
  if version.length == usize.ZERO { fail InvalidSourceRoot {} }
  let mut identity = run Bytes.copy(name)
  run Bytes.append(&mut identity, b"@")
  run Bytes.append(&mut identity, version)
  return move identity
}

// Reads the package that the manifest `contents`, read from `manifest` in `directory`, declares.
effect fn packageRoot(manifest: &Path, directory: &Path, contents: &Bytes, executable: bool, request: &RuntimeRequest) -> PackageRoot
! FileError | TomlError | InvalidSourceRoot | InvalidDependency | InvalidBuildComposition | InvalidNativeLinkInput | OutOfMemoryError
? &mut FileSystem | &mut Allocator {
  let document = run Toml.parse(Bytes.asSlice(contents))
  let identity = run packageIdentity(&document)
  // Modules resolve below `[package].source` (driver/ManifestFields).
  let selected = run ManifestFields.sourceRoot(directory, &document)
  let runtime = run defaultRuntime(&document, executable, request)
  let mut components = Components.Catalog
  let mut retention = List<RetentionRoot>.make()
  if let Option<&TomlValue>.Some {value: composition} = move ManifestFields.composition(&document) {
    components = Components.Declared {storage: run manifestStorage(composition, Bytes.asSlice(&identity))}
    retention = run manifestRetention(composition, Bytes.asSlice(&identity))
  }
  let linkInputs = run NativeLinkInputs.read(&document, manifest, directory)
  let relative = run CommandPath.relative(directory, &selected)
  let packages = run PackageSources.load(directory, &document, Bytes.asSlice(&identity), &selected)
  return PackageRoot {directory: move selected, package: move identity, relative: move relative, runtime: move runtime,
    components: move components, retention: move retention, linkInputs: move linkInputs, packages: move packages}
}

effect fn sourceRoot(source: &Path, executable: bool, request: &RuntimeRequest) -> PackageRoot
! FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | InvalidNativeLinkInput | OutOfMemoryError
? &mut FileSystem | &mut Allocator {
  let parent = run Path.parent(source)
  let mut directory = match move parent {
    Option<Path>.Some {value} => move value
    Option<Path>.None => { fail InvalidSourceRoot {} }
  }
  let start = run Path.fromBytes(Path.rawBytes(&directory))
  while true {
    let manifest = run Path.join(&directory, "silk.toml")
    let contents = run readOptional(&manifest)
    if let Option<Bytes>.Some {value} = move contents {
      return run packageRoot(&manifest, &directory, &value, executable, request)
    }
    let parent = run Path.parent(&directory)
    if let Option<Path>.Some {value} = move parent {
      directory = move value
    } else {
      break
    }
  }
  // Without a manifest a build has no logical package identity, and a host path is never one.
  fail MissingManifest {directory: move start}
}

effect fn logicalEntry(root: &Path, source: &Path) -> Bytes
! InvalidSourceRoot | OutOfMemoryError ? &mut Allocator {
  let mut prefix = run Bytes.copy(Path.rawBytes(root))
  if !Path.isRoot(root) { run Bytes.append(&mut prefix, b"/") }
  let bytes = Path.rawBytes(source)
  let directory = Bytes.asSlice(&prefix)
  if !startsWith(bytes, directory) || bytes.length <= directory.length {
    fail InvalidSourceRoot {}
  }
  let mut logical = Bytes.make()
  let mut at = directory.length
  while at < bytes.length {
    run Bytes.append(&mut logical, &[bytes[at]])
    at = at + usize.ONE
  }
  return move logical
}

/// Reads the entry and nearest package manifest, including its native link inputs, and selects the
/// runtime the profile's `runtime` request names: by default the manifest composition's default,
/// or else, for an `executable` artifact, the standard-library catalog runtime for `target` and
/// `libc`; a named request selects the composition or catalog runtime of that name; `none` selects
/// no runtime and no catalog component (ARTIFACT-001). A catalog runtime without a standard
/// library is [`MissingStandardLibrary`]. A library or object form acquires no catalog runtime or
/// storage component (ARTIFACT-002). No imported or runtime module is read here.
pub effect fn make(source: &Path, standardLibrary: Option<Path>, target: &[u8], libc: &[u8], executable: bool, runtime: RuntimeRequest) -> ModuleSources
! FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError
? &mut FileSystem | &mut Allocator {
  let located = run sourceRoot(source, executable, &runtime)
  run refuseReservedModules(source, &located, &standardLibrary)
  return run assemble(source, move located, move standardLibrary, target, libc, executable, &runtime)
}

// Refuses a package whose source root holds a module or module directory named `silk` or
// `Intrinsic`: `silk.` imports always name the standard library and `Intrinsic` the compiler's
// intrinsics, so such a module could never be imported. The standard library itself, built as
// the root package, is exempt, as is a reserved directory that holds the entry itself.
effect fn refuseReservedModules(source: &Path, located: &PackageRoot, standardLibrary: &Option<Path>) -> ()
! InvalidDependency | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  if let Option<Path>.Some {value} = &standardLibrary.* {
    if sameText(Path.rawBytes(&located.directory), Path.rawBytes(&value)) { return () }
  }
  // Listing the root, rather than probing each name, keeps a root that cannot be listed (or a
  // host that only serves files) from being refused: the import still fails later if it matters.
  let children = match move run Effect.result(FileSystem.listDirectory(&located.directory)) {
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success { value } => move value
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        drop failure
        return ()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let listed = List<DirectoryEntry>.asSlice(&children)
  let prefix = Path.rawBytes(&located.directory).length + usize.ONE
  let mut at = usize.ZERO
  while at < listed.length {
    let child = Path.rawBytes(&listed[at].path)
    let mut reserved = false
    if child.length > prefix && startsWith(child, Path.rawBytes(&located.directory)) {
      let name = Slice.view<u8>(child, prefix, child.length - prefix)
      reserved = sameText(name, b"silk") || sameText(name, b"silk.silk") || sameText(name, b"Intrinsic") || sameText(name, b"Intrinsic.silk")
    }
    if reserved && !holdsEntry(child, Path.rawBytes(source)) {
      let mut detail = run Bytes.copy(b"module ")
      run Bytes.append(&mut detail, child)
      run Bytes.append(&mut detail, b" of ")
      run Bytes.append(&mut detail, Bytes.asSlice(&located.package))
      run Bytes.append(&mut detail, b": `silk` and `Intrinsic` are reserved module names (`silk.` imports name the standard library and `Intrinsic` the compiler's intrinsics); rename it")
      fail InvalidDependency {detail: move detail, manifest: Bytes.make(), line: usize.ZERO}
    }
    at = at + usize.ONE
  }
  return ()
}

fn holdsEntry(directory: &[u8], source: &[u8]) -> bool {
  return source.length > directory.length && source[directory.length] == 47 && startsWith(source, directory)
}

/// Like [`make`], but the package is the one `manifest` declares rather than the nearest manifest
/// above the entry, as a project command's `--manifest-path` selects.
pub effect fn makeInPackage(source: &Path, manifest: &Path, standardLibrary: Option<Path>, target: &[u8], libc: &[u8], executable: bool, runtime: RuntimeRequest) -> ModuleSources
! FileError | TomlError | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | InvalidModulePath | OutOfMemoryError
? &mut FileSystem | &mut Allocator {
  let directory = match move run Path.parent(manifest) {
    Option<Path>.Some {value} => move value
    Option<Path>.None => { fail InvalidSourceRoot {} }
  }
  let contents = run FileSystem.readFile(manifest)
  let located = run packageRoot(manifest, &directory, &contents, executable, &runtime)
  run refuseReservedModules(source, &located, &standardLibrary)
  return run assemble(source, move located, move standardLibrary, target, libc, executable, &runtime)
}

effect fn assemble(source: &Path, located: PackageRoot, standardLibrary: Option<Path>, target: &[u8], libc: &[u8], executable: bool, request: &RuntimeRequest) -> ModuleSources
! FileError | InvalidSourceRoot | InvalidBuildComposition | MissingStandardLibrary | InvalidModulePath | OutOfMemoryError
? &mut FileSystem | &mut Allocator {
  let PackageRoot {directory: root, package, relative, runtime: declaredRuntime, components, retention, linkInputs, packages} = move located
  let mut catalogDocument = Option<JsonValue>.none()
  if let Option<Path>.Some {value: directory} = &standardLibrary {
    catalogDocument = run catalog(&directory)
  }
  // The catalog lists one runtime for an executable's target and libc, by its name; a `none`
  // request selects no runtime and so acquires none of the catalog's components either.
  let mut catalogName = Option<&[u8]>.none()
  let mut catalogued = executable
  match &request.* {
    RuntimeRequest.None => { catalogued = false }
    RuntimeRequest.Named {name} => {
      if !executable { fail InvalidBuildComposition {} }
      catalogName = Option<&[u8]>.some(Bytes.asSlice(&name))
    }
    RuntimeRequest.Default => {}
  }
  let mut storage = Option<ExecutionStorage>.none()
  match move components {
    Components.Declared {storage: declared} => { storage = move declared }
    Components.Catalog => {
      if let Option<JsonValue>.Some {value: document} = &catalogDocument {
        if catalogued { storage = run catalogStorage(&document, Bytes.asSlice(&package)) }
      }
    }
  }
  let mut selectedRuntime = Option<Bytes>.none()
  match move declaredRuntime {
    RuntimeChoice.Declared {module} => { selectedRuntime = move module }
    RuntimeChoice.Catalog => {
      if catalogued {
        match &catalogDocument {
          Option<JsonValue>.Some {value: document} => {
            match move run catalogRuntime(&document, target, libc, move catalogName) {
              Option<Bytes>.Some {value} => { selectedRuntime = Option<Bytes>.some(move value) }
              Option<Bytes>.None => { fail InvalidBuildComposition {} }
            }
          }
          Option<JsonValue>.None => {
            // Without a library there is no catalog to read; a library without one is invalid.
            if let Option<Path>.None = &standardLibrary { fail MissingStandardLibrary {} }
            fail InvalidBuildComposition {}
          }
        }
      }
    }
  }
  let logical = run logicalEntry(&root, source)
  if SealedOperators.isPath(Bytes.asSlice(&logical)) { fail InvalidSourceRoot {} }
  let entry = run ModuleId.make(b"file", Bytes.asSlice(&package), Bytes.asSlice(&logical))
  // Standard-library paths belong to the root package, which every package shares (PACKAGE-005).
  let mut graph = run PackageSources.graph(&packages, &entry)
  if let Option<JsonValue>.Some {value: document} = &catalogDocument {
    run catalogRoles(&document, &mut graph)
  }
  let mut runtime = Option<ModuleId>.none()
  if let Option<Bytes>.Some {value: selected} = &selectedRuntime {
    if SealedOperators.isPath(Bytes.asSlice(&selected)) { fail InvalidBuildComposition {} }
    runtime = Option<ModuleId>.some(run ModuleId.make(b"file", Bytes.asSlice(&package), Bytes.asSlice(&selected)))
  }
  let content = Option<Bytes>.some(run FileSystem.readFile(source))
  let revision = run Revision.publish(&Revision.make(), &entry, &content)
  let mut attempted = List<ModuleId>.make()
  run List<ModuleId>.append(&mut attempted, ModuleId.copy(&entry))
  return ModuleSources {
    root: move root,
    package: move package,
    directory: move relative,
    standardLibrary: move standardLibrary,
    entry: move entry,
    runtime: move runtime,
    storage: move storage,
    retention: move retention,
    linkInputs: move linkInputs,
    packages: move packages,
    graph: move graph,
    revision: move revision,
    attempted: move attempted,
    parsed: List<SourceUnit>.make(),
    summaries: Option<ImportSummaries>.none(),
    digests: List<LoadedDigest>.make(),
    claimFree: List<ModuleId>.make(),
    listings: List<Listing>.make(),
  }
}

/// Borrows the module directory on disk, which every logical module path of the package is under.
pub fn moduleRoot(self: &ModuleSources) -> &Path { return &self.root }

/// Borrows the standard library directory, which holds the `silk/` modules; none without one.
pub fn standardLibrary(self: &ModuleSources) -> Option<&Path> {
  return match &self.standardLibrary {
    Option<Path>.Some {value} => Option<&Path>.some(&value)
    Option<Path>.None => Option<&Path>.none()
  }
}

/// Borrows the module directory's path relative to the package manifest, such as `src`.
pub fn moduleDirectory(self: &ModuleSources) -> &[u8] { return Bytes.asSlice(&self.directory) }

/// The canonical identity of `logical`, a path such as `silk/testing/runner.silk`, in this package.
pub effect fn module(self: &ModuleSources, logical: &[u8]) -> ModuleId ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  return run ModuleId.make(b"file", Bytes.asSlice(&self.package), logical)
}

/// The module of a dependency package that the file at `path` holds, if one does.
pub effect fn dependencyModule(self: &ModuleSources, path: &[u8]) -> Option<ModuleId> ! OutOfMemoryError ? &mut Allocator {
  return run PackageSources.dependencyModule(&self.packages, path)
}

/// Replaces the source of a module already read with `content`, as when its file is saved, so later
/// revisions see the new text. A module not yet read is read from its file when first reached.
pub effect fn reread(self: &mut ModuleSources, module: &ModuleId, content: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  if !attempted(&self.*, module) { return () }
  let next = run Revision.publish(&self.revision, module, &Option<Bytes>.some(run Bytes.copy(content)))
  self.revision = move next
  return ()
}

/// Lets the root package import its own modules by `name` as well, as a documentation example
/// imports the package it documents by the name its dependents write.
pub effect fn aliasRoot(self: &mut ModuleSources, name: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  return run PackageGraph.depend(&mut self.graph, Bytes.asSlice(&self.package), name, Bytes.asSlice(&self.package))
}

/// Copies the package graph that semantic analysis resolves imports through (PACKAGE-002).
pub effect fn packageGraph(self: &ModuleSources) -> PackageGraph ! OutOfMemoryError ? &mut Allocator {
  return run PackageGraph.copy(&self.graph)
}

/// Borrows the canonical entry identity inside its package's module directory.
pub fn entry(self: &ModuleSources) -> &ModuleId { return &self.entry }

/// Borrows the selected runtime source module, absent for a library or object form without one.
pub fn runtime(self: &ModuleSources) -> Option<&ModuleId> {
  return match &self.runtime {
    Option<ModuleId>.Some {value} => Option<&ModuleId>.some(&value)
    Option<ModuleId>.None => Option<&ModuleId>.none()
  }
}

/// Borrows the package's native link inputs in declaration order.
pub fn nativeLinkInputs(self: &ModuleSources) -> &[NativeLinkInput] {
  return List<NativeLinkInput>.asSlice(&self.linkInputs)
}

/// Borrows the composition's execution-storage selection, absent when none is selected validly.
/// The composition's explicit retention roots, in manifest order (ARTIFACT-003).
pub effect fn retention(self: &ModuleSources) -> List<RetentionRoot> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<RetentionRoot>.make()
  let listed = List<RetentionRoot>.asSlice(&self.retention)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<RetentionRoot>.append(&mut copied, run RetentionRoot.copy(&listed[at]))
    at = at + usize.ONE
  }
  return move copied
}

pub fn executionStorage(self: &ModuleSources) -> Option<&ExecutionStorage> {
  return match &self.storage {
    Option<ExecutionStorage>.Some {value} => Option<&ExecutionStorage>.some(&value)
    Option<ExecutionStorage>.None => Option<&ExecutionStorage>.none()
  }
}

/// Retains an immutable snapshot whose observations authenticate exact per-file contents.
pub effect fn revision(self: &ModuleSources) -> Revision ! OutOfMemoryError ? &mut Allocator {
  return run Revision.copy(&self.revision)
}

fn attempted(self: &ModuleSources, module: &ModuleId) -> bool {
  let modules = List<ModuleId>.asSlice(&self.attempted)
  let mut at = usize.ZERO
  while at < modules.length {
    if ModuleId.equals(&modules[at], module) { return true }
    at = at + usize.ONE
  }
  return false
}

/// Reports the actual provider route. The already-published entry always came from the compiler
/// file even if its logical path starts with silk/. Other requests retain the existing route.
pub fn compilerProvider(self: &ModuleSources, module: &ModuleId) -> bool {
  return ModuleId.equals(&self.entry, module) || !ModuleId.withPath<bool>(module, fn(path: &[u8]) -> bool {
    return startsWith(path, b"silk/") || SealedOperators.isPath(path)
  })
}

// A library source belongs to the root package only when the selected package's module directory
// is that same library directory. Imported library modules otherwise inherit the entry's logical
// ModuleId package, so comparing ModuleId packages alone cannot establish source ownership.
fn rootPackageModule(self: &ModuleSources, module: &ModuleId) -> bool {
  if !ModuleId.sameOrigin(&self.entry, module) || !ModuleId.samePackage(&self.entry, module) { return false }
  if compilerProvider(self, module) { return true }
  return match &self.standardLibrary {
    Option<Path>.Some {value} => sameText(Path.rawBytes(&self.root), Path.rawBytes(&value))
    Option<Path>.None => false
  }
}

/// How many modules preloading has published, present or absent.
pub fn loadedCount(self: &ModuleSources) -> usize {
  return List<ModuleId>.length(&self.attempted)
}

/// Copies the present, preloaded modules whose source provider is the selected root package.
/// Missing imports and present dependencies stay outside the root declaration sweep.
pub effect fn loadedRootModules(self: &ModuleSources) -> List<ModuleId> ! OutOfMemoryError ? &mut Allocator {
  let mut selected = List<ModuleId>.make()
  let published = List<ModuleId>.asSlice(&self.attempted)
  let mut at = usize.ZERO
  while at < published.length {
    if Revision.presents(&self.revision, &published[at]) && rootPackageModule(self, &published[at]) {
      run List<ModuleId>.append(&mut selected, ModuleId.copy(&published[at]))
    }
    at = at + usize.ONE
  }
  return move selected
}

// Whether `module` is read from a dependency package's own source root rather than the root
// package or the standard library.
fn dependencyPackageModule(self: &ModuleSources, module: &ModuleId) -> bool {
  if !compilerProvider(self, module) { return false }
  return ModuleId.withPackage<bool>(module, fn(package: &[u8]) -> bool {
    return match PackageSources.dependencyRoot(&self.packages, package) {
      Option<&Path>.Some {..} => true
      Option<&Path>.None => false
    }
  })
}

/// Copies the present, preloaded modules of the dependency packages. A check sweeps them with the
/// root package, so a dependency's errors are reported where they are written, even in bodies the
/// root package never reaches.
pub effect fn loadedDependencyModules(self: &ModuleSources) -> List<ModuleId> ! OutOfMemoryError ? &mut Allocator {
  let mut selected = List<ModuleId>.make()
  let published = List<ModuleId>.asSlice(&self.attempted)
  let mut at = usize.ZERO
  while at < published.length {
    if Revision.presents(&self.revision, &published[at]) && dependencyPackageModule(self, &published[at]) {
      run List<ModuleId>.append(&mut selected, ModuleId.copy(&published[at]))
    }
    at = at + usize.ONE
  }
  return move selected
}

/// Copies the exact filesystem mapping used for publication, without reading source bytes.
pub effect fn sourceLocation(self: &ModuleSources, module: &ModuleId) -> SourceLocation
! FileError | OutOfMemoryError ? &mut Allocator {
  let copied = run ModuleId.copyPath(module)
  let logical = Bytes.asSlice(&copied)
  if !compilerProvider(self, module) {
    if let Option<Path>.Some {value} = &self.standardLibrary {
      return SourceLocation {provider: ProviderRole.StandardLibrary, path: Option<Path>.some(run Path.joinBytes(&value, logical))}
    }
    return SourceLocation {provider: ProviderRole.StandardLibrary, path: Option<Path>.none()}
  }
  // A dependency's modules resolve below that package's own source root.
  let package = run ModuleId.copyPackage(module)
  if let Option<&Path>.Some {value: directory} = move PackageSources.dependencyRoot(&self.packages, Bytes.asSlice(&package)) {
    return SourceLocation {provider: ProviderRole.Compiler, path: Option<Path>.some(run Path.joinBytes(directory, logical))}
  }
  return SourceLocation {provider: ProviderRole.Compiler, path: Option<Path>.some(run Path.joinBytes(&self.root, logical))}
}

// The directory `module`'s logical path is read below, none when its provider has no files.
effect fn sourceDirectory(self: &ModuleSources, module: &ModuleId) -> Option<Path>
! FileError | OutOfMemoryError ? &mut Allocator {
  if !compilerProvider(self, module) {
    if let Option<Path>.Some {value} = &self.standardLibrary {
      return Option<Path>.some(run Path.fromBytes(Path.rawBytes(&value)))
    }
    return Option<Path>.none()
  }
  let package = run ModuleId.copyPackage(module)
  if let Option<&Path>.Some {value: directory} = move PackageSources.dependencyRoot(&self.packages, Bytes.asSlice(&package)) {
    return Option<Path>.some(run Path.fromBytes(Path.rawBytes(directory)))
  }
  return Option<Path>.some(run Path.fromBytes(Path.rawBytes(&self.root)))
}

// The last component of `path`.
fn lastComponent(path: &[u8]) -> &[u8] {
  let mut start = path.length
  while start > usize.ZERO && path[start - usize.ONE] != 47 {
    start = start - usize.ONE
  }
  return Slice.view<u8>(path, start, path.length - start)
}

// Whether `left` and `right` are the same text once ASCII letters are folded to lower case.
fn sameFolded(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    let mut a = left[at]
    let mut b = right[at]
    if a >= 65 && a <= 90 { a = a + 32 }
    if b >= 65 && b <= 90 { b = b + 32 }
    if a != b { return false }
    at = at + usize.ONE
  }
  return true
}

// The child names of one listed directory.
struct Listing {
  directory: Bytes,
  names: List<Bytes>,
}

// The position in `listings` of `directory`'s child names, listed on first use; none when it
// cannot be listed.
effect fn listingOf(listings: &mut List<Listing>, directory: &[u8]) -> Option<usize>
! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let known = List<Listing>.asSlice(&listings.*)
  let mut at = usize.ZERO
  while at < known.length {
    if sameText(Bytes.asSlice(&known[at].directory), directory) { return Option<usize>.some(at) }
    at = at + usize.ONE
  }
  let path = match move run Effect.result(Path.fromBytes(directory)) {
    Result<Path, FileError | OutOfMemoryError>.Success {value} => move value
    Result<Path, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => {
        drop failure
        return Option<usize>.none()
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let children = match move run Effect.result(FileSystem.listDirectory(&path)) {
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success {value} => move value
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => {
        drop failure
        return Option<usize>.none()
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let listed = List<DirectoryEntry>.asSlice(&children)
  let mut names = List<Bytes>.make()
  at = usize.ZERO
  while at < listed.length {
    run List<Bytes>.append(&mut names, run Bytes.copy(lastComponent(Path.rawBytes(&listed[at].path))))
    at = at + usize.ONE
  }
  run List<Listing>.append(&mut listings.*, Listing {directory: run Bytes.copy(directory), names: move names})
  return Option<usize>.some(List<Listing>.length(&listings.*) - usize.ONE)
}

/// The logical path of the one source file whose path differs from `module`'s only in the case of
/// its letters, such as `util/Math.silk` for `util/math.silk`.
///
/// # Details
///
/// Each directory on the way is listed: a component spelled exactly is kept, and otherwise the
/// single child equal to it up to ASCII letter case is taken. None when the path is spelled
/// exactly, when a component has no such child or more than one, or when a directory cannot be
/// listed.
pub effect fn caseVariant(self: &ModuleSources, module: &ModuleId) -> Option<Bytes>
! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut listings = List<Listing>.make()
  return run caseVariantListed(self, module, &mut listings, false)
}

/// The logical path of the one source file whose path is one typo away from `module`'s in some
/// components, such as `geo/shapes.silk` for `geo/shape.silk`.
///
/// # Details
///
/// Like [`caseVariant`], but a component not spelled exactly takes the single child within one
/// inserted, removed or replaced letter of it, ignoring ASCII letter case.
pub effect fn nearVariant(self: &ModuleSources, module: &ModuleId) -> Option<Bytes>
! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut listings = List<Listing>.make()
  return run caseVariantListed(self, module, &mut listings, true)
}

/// The logical path of the one source file in `module`'s package named like `module`'s last
/// component, such as `util/helper.silk` for `helper.silk` after the file moved.
///
/// # Details
///
/// The package's source directories are searched to a small depth and breadth. None when no file
/// or more than one has that name, or when the only one is `module`'s own path.
pub effect fn movedVariant(self: &ModuleSources, module: &ModuleId) -> Option<Bytes>
! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let found = run Effect.result(sourceDirectory(self, module))
  let root = match move found {
    Result<Option<Path>, FileError | OutOfMemoryError>.Success {value: Option<Path>.Some {value}} => run Bytes.copy(Path.rawBytes(&value))
    Result<Option<Path>, FileError | OutOfMemoryError>.Success {value: Option<Path>.None} => { return Option<Bytes>.none() }
    Result<Option<Path>, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => {
        drop failure
        return Option<Bytes>.none()
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let logical = run ModuleId.copyPath(module)
  let wanted = lastComponent(Bytes.asSlice(&logical))
  // Directories to search, as paths relative to the root, with their depth.
  let mut pending = List<Bytes>.make()
  let mut depths = List<usize>.make()
  run List<Bytes>.append(&mut pending, Bytes.make())
  run List<usize>.append(&mut depths, usize.ZERO)
  let mut matched = Option<Bytes>.none()
  let mut matches = usize.ZERO
  let mut visited = usize.ZERO
  while visited < List<Bytes>.length(&pending) && visited < 256 {
    let relative = run Bytes.copy(Bytes.asSlice(&List<Bytes>.asSlice(&pending)[visited]))
    let depth = List<usize>.asSlice(&depths)[visited]
    visited = visited + usize.ONE
    let mut directory = run Bytes.copy(Bytes.asSlice(&root))
    if Bytes.length(&relative) > usize.ZERO {
      run Bytes.append(&mut directory, b"/")
      run Bytes.append(&mut directory, Bytes.asSlice(&relative))
    }
    let path = match move run Effect.result(Path.fromBytes(Bytes.asSlice(&directory))) {
      Result<Path, FileError | OutOfMemoryError>.Success {value} => move value
      Result<Path, FileError | OutOfMemoryError>.Failure {error} => match move error {
        FileError failure => {
          drop failure
          continue
        }
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
    let children = match move run Effect.result(FileSystem.listDirectory(&path)) {
      Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success {value} => move value
      Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure {error} => match move error {
        FileError failure => {
          drop failure
          continue
        }
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
    let listed = List<DirectoryEntry>.asSlice(&children)
    let mut at = usize.ZERO
    while at < listed.length {
      let name = lastComponent(Path.rawBytes(&listed[at].path))
      let mut child = run Bytes.copy(Bytes.asSlice(&relative))
      if Bytes.length(&child) > usize.ZERO { run Bytes.append(&mut child, b"/") }
      run Bytes.append(&mut child, name)
      if listed[at].kind.code == FileSystem.directory().code {
        if depth < 6 && name.length > usize.ZERO && name[0] != 46 {
          run List<Bytes>.append(&mut pending, move child)
          run List<usize>.append(&mut depths, depth + usize.ONE)
        }
      } else if sameText(name, wanted) {
        matches = matches + usize.ONE
        matched = Option<Bytes>.some(move child)
      }
      at = at + usize.ONE
    }
  }
  if matches != usize.ONE { return Option<Bytes>.none() }
  if let Option<Bytes>.Some {value} = move matched {
    if sameText(Bytes.asSlice(&value), Bytes.asSlice(&logical)) { return Option<Bytes>.none() }
    return Option<Bytes>.some(move value)
  }
  return Option<Bytes>.none()
}

// Whether `left` becomes `right` by inserting, removing or replacing at most one letter, ignoring
// ASCII letter case.
fn oneEditApart(left: &[u8], right: &[u8]) -> bool {
  let mut shorter = left
  let mut longer = right
  if left.length > right.length {
    shorter = right
    longer = left
  }
  if longer.length - shorter.length > usize.ONE { return false }
  let mut at = usize.ZERO
  while at < shorter.length && foldedByte(shorter[at]) == foldedByte(longer[at]) { at = at + usize.ONE }
  if at == shorter.length { return true }
  // Past the first difference, the rest must match after skipping one letter of the longer text, or
  // one letter of each when the lengths agree.
  let mut rest = at
  let mut offset = usize.ONE
  if longer.length == shorter.length {
    rest = at + usize.ONE
    offset = usize.ZERO
  }
  while rest < shorter.length {
    if foldedByte(shorter[rest]) != foldedByte(longer[rest + offset]) { return false }
    rest = rest + usize.ONE
  }
  return true
}

fn foldedByte(byte: u8) -> u8 {
  if byte >= 65 && byte <= 90 { return byte + 32 }
  return byte
}

effect fn caseVariantListed(self: &ModuleSources, module: &ModuleId, listings: &mut List<Listing>, near: bool) -> Option<Bytes>
! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let found = run Effect.result(sourceDirectory(self, module))
  let directory = match move found {
    Result<Option<Path>, FileError | OutOfMemoryError>.Success {value} => move value
    Result<Option<Path>, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => {
        drop failure
        return Option<Bytes>.none()
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let mut current = match &directory {
    Option<Path>.Some {value} => run Bytes.copy(Path.rawBytes(&value))
    Option<Path>.None => { return Option<Bytes>.none() }
  }
  let logical = run ModuleId.copyPath(module)
  let written = Bytes.asSlice(&logical)
  let mut spelled = Bytes.make()
  let mut differs = false
  let mut start = usize.ZERO
  while start < written.length {
    let mut end = start
    while end < written.length && written[end] != 47 { end = end + usize.ONE }
    let component = Slice.view<u8>(written, start, end - start)
    let index = match move run listingOf(&mut listings.*, Bytes.asSlice(&current)) {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return Option<Bytes>.none() }
    }
    let names = List<Bytes>.asSlice(&List<Listing>.asSlice(&listings.*)[index].names)
    let mut chosen = usize.MAX
    let mut folded = usize.ZERO
    let mut at = usize.ZERO
    while at < names.length {
      let name = Bytes.asSlice(&names[at])
      if sameText(name, component) {
        chosen = at
        folded = usize.ONE
        break
      }
      if sameFolded(name, component) || (near && oneEditApart(name, component)) {
        chosen = at
        folded = folded + usize.ONE
      }
      at = at + usize.ONE
    }
    if chosen == usize.MAX || folded != usize.ONE { return Option<Bytes>.none() }
    let name = Bytes.asSlice(&names[chosen])
    if !sameText(name, component) { differs = true }
    if start > usize.ZERO { run Bytes.append(&mut spelled, b"/") }
    run Bytes.append(&mut spelled, name)
    run Bytes.append(&mut current, b"/")
    run Bytes.append(&mut current, name)
    start = end + usize.ONE
  }
  if !differs { return Option<Bytes>.none() }
  return Option<Bytes>.some(move spelled)
}

// Reads `module`'s source, absent when no file has its exact path. A case-insensitive filesystem
// also opens a file whose name differs only in letter case; that file is refused, so an import
// resolves the same way on every host. Directory listings are kept for the next read.
effect fn readModule(self: &mut ModuleSources, module: &ModuleId) -> Option<Bytes>
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let location = run sourceLocation(&self.*, module)
  let content = match &location.path {
    Option<Path>.Some {value} => run readOptional(&value)
    Option<Path>.None => Option<Bytes>.none()
  }
  if let Option<Bytes>.Some {..} = &content {
    let mut listings = Intrinsic.replace(self.listings, List<Listing>.make())
    let variant = run caseVariantListed(&self.*, module, &mut listings, false)
    self.listings = move listings
    if let Option<Bytes>.Some {..} = &variant { return Option<Bytes>.none() }
  }
  return move content
}

// Publishes `module` once, as present bytes or explicit absence, and returns its bytes.
effect fn publish(self: &mut ModuleSources, module: &ModuleId, sealedContent: &Option<Bytes>) -> Option<Bytes>
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  if attempted(&self.*, module) {
    let observed = run Revision.observe(&self.revision, module)
    return run Observation.copyContent(&observed)
  }
  let mut content = Option<Bytes>.none()
  if ModuleId.withPath<bool>(module, SealedOperators.isPath) {
    if let Option<Bytes>.Some {value} = &sealedContent.* {
      content = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&value)))
    }
  } else { content = run readModule(&mut self.*, module) }
  let next = run Revision.publish(&self.revision, module, &content)
  self.revision = move next
  run List<ModuleId>.append(&mut self.attempted, ModuleId.copy(module))
  return move content
}

/// Publishes every module reachable from `roots` through written imports, so one semantic build
/// sees the whole program.
///
/// # Details
///
/// Each module is read once, as present bytes or explicit absence, and a present module's imports
/// are read as syntax only. An import path that is not a canonical module path names no module and
/// is left to semantic analysis to reject.
pub effect fn preload(self: &mut ModuleSources, roots: &[ModuleId]) -> ()
! FileError | InvalidModulePath | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  // Read and lex the compiler-owned declaration catalog once. Publish those same bytes only
  // when a reachable module names a declared member; project sources cannot supply this catalog.
  let sealedModule = run ModuleId.sibling(&self.entry, SealedOperators.path())
  let sealedContent = run readModule(&mut self.*, &sealedModule)
  let sealedNames = match &sealedContent {
    Option<Bytes>.Some {value} => run SealedOperators.members(Bytes.asSlice(&value))
    Option<Bytes>.None => List<Bytes>.make()
  }
  if let Option<ImportSummaries>.Some {value: summaries} = &mut self.summaries {
    let catalog = match &sealedContent {
      Option<Bytes>.Some {value} => ContentHash.of(Bytes.asSlice(&value))
      Option<Bytes>.None => ContentHash {high: 0, low: 0}
    }
    Summaries.selectCatalog(&mut summaries, catalog)
  }
  let mut pending = List<ModuleId>.make()
  let mut at = usize.ZERO
  while at < roots.length {
    run List<ModuleId>.append(&mut pending, ModuleId.copy(&roots[at]))
    at = at + usize.ONE
  }
  // Only the latest load's units wait for a store, so a caller that never takes them holds one
  // program's parse at most.
  List<SourceUnit>.clear(&mut self.parsed)
  List<ModuleId>.clear(&mut self.claimFree)
  List<LoadedDigest>.clear(&mut self.digests)
  // A file the last build's store parsed is parsed again ahead, on threads of their own, while
  // this load reads and parses the rest (see `ImportSummaries.wasParsed`).
  let mut ahead = List<ParseJob>.make()
  let mut workers = List<JoinHandle<List<ParsedFile>>>.make()
  let threads = NativeThread.processorCount() - usize.ONE
  let number = Revision.revisionNumber(&self.revision)
  let mut scanned = List<ModuleId>.make()
  while List<ModuleId>.length(&pending) > usize.ZERO {
    let module = List<ModuleId>.remove(&mut pending, usize.ZERO)
    if listed(List<ModuleId>.asSlice(&scanned), &module) { continue }
    run List<ModuleId>.append(&mut scanned, ModuleId.copy(&module))
    let content = run publish(&mut self.*, &module, &sealedContent)
    if let Option<Bytes>.Some {value: read} = move content {
      let mut bytes = move read
      // A file whose bytes a summary names writes the imports it wrote then, and the store parses
      // it when it first reads it.
      let mut digest = ContentHash {high: 0, low: 0}
      let mut found = Option<ImportSummary>.none()
      let mut wanted = false
      if let Option<ImportSummaries>.Some {value: summaries} = &mut self.summaries {
        digest = ContentHash.of(Bytes.asSlice(&bytes))
        found = run Summaries.find(&mut summaries, digest)
        wanted = Summaries.wasParsed(&summaries, digest)
        run List<LoadedDigest>.append(&mut self.digests, LoadedDigest {module: ModuleId.copy(&module), digest: digest})
      }
      let hit = match &found { Option<ImportSummary>.Some {..} => true _ => false }
      if hit && wanted {
        let slot = List<ModuleId>.length(&scanned) - usize.ONE
        run List<ParseJob>.append(&mut ahead, ParseJob {slot: slot, bytes: Intrinsic.replace(bytes, Bytes.make())})
      }
      // The jobs found so far parse while this file does.
      if !hit && List<JoinHandle<List<ParsedFile>>>.length(&workers) < threads {
        run parseAhead(&mut workers, Intrinsic.replace(ahead, List<ParseJob>.make()))
      }
      let summary = match move found {
        Option<ImportSummary>.Some {value} => move value
        Option<ImportSummary>.None => run parsedSummary(&mut self.*, &module, move bytes, digest, List<Bytes>.asSlice(&sealedNames))
      }
      if !summary.claims { run List<ModuleId>.append(&mut self.claimFree, ModuleId.copy(&module)) }
      if summary.sealed {
        // The path is fixed and compiler-owned; sourceLocation never consults the project tree.
        run List<ModuleId>.append(&mut pending, run PackageGraph.target(&self.graph, &module, SealedOperators.path()))
      }
      let written = List<Bytes>.asSlice(&summary.paths)
      let mut pathAt = usize.ZERO
      while pathAt < written.length {
        if SealedOperators.isPath(Bytes.asSlice(&written[pathAt])) {
          pathAt = pathAt + usize.ONE
          continue
        }
        run appendCandidates(&self.*, &mut pending, &module, Bytes.asSlice(&written[pathAt]))
        pathAt = pathAt + usize.ONE
      }
    }
  }
  // The rest is split between the threads left and this one.
  let mut shares = List<List<ParseJob>>.make()
  let mut share = usize.ZERO
  let mut live = List<JoinHandle<List<ParsedFile>>>.length(&workers)
  if live > threads { live = threads }
  let free = threads - live
  while share <= free {
    run List<List<ParseJob>>.append(&mut shares, List<ParseJob>.make())
    share = share + usize.ONE
  }
  let mut loads = List<usize>.make()
  while List<usize>.length(&loads) < List<List<ParseJob>>.length(&shares) { run List<usize>.append(&mut loads, usize.ZERO) }
  // Largest first, each to the lightest share.
  while List<ParseJob>.length(&ahead) > usize.ZERO {
    let jobs = List<ParseJob>.asSlice(&ahead)
    let mut largest = usize.ZERO
    let mut at = usize.ONE
    while at < jobs.length {
      if Bytes.length(&jobs[at].bytes) > Bytes.length(&jobs[largest].bytes) { largest = at }
      at = at + usize.ONE
    }
    let job = List<ParseJob>.remove(&mut ahead, largest)
    let weights = List<usize>.asSlice(&loads)
    let mut lightest = usize.ZERO
    at = usize.ONE
    while at < weights.length {
      if weights[at] < weights[lightest] { lightest = at }
      at = at + usize.ONE
    }
    let load = List<usize>.get(&loads, lightest) + Bytes.length(&job.bytes)
    List<usize>.set(&mut loads, lightest, load)
    let mut writable = List<List<ParseJob>>.asMutSlice(&mut shares)
    run List<ParseJob>.append(&mut writable[lightest], move job)
  }
  let own = List<List<ParseJob>>.remove(&mut shares, usize.ZERO)
  while List<List<ParseJob>>.length(&shares) > usize.ZERO {
    run parseAhead(&mut workers, List<List<ParseJob>>.remove(&mut shares, usize.ZERO))
  }
  let mut files = run parseEach(move own)
  while List<JoinHandle<List<ParsedFile>>>.length(&workers) > usize.ZERO {
    let handle = List<JoinHandle<List<ParsedFile>>>.remove(&mut workers, usize.ZERO)
    let mut joined = handle.join()
    while List<ParsedFile>.length(&joined) > usize.ZERO {
      let last = List<ParsedFile>.length(&joined) - usize.ONE
      run List<ParsedFile>.append(&mut files, List<ParsedFile>.remove(&mut joined, last))
    }
  }
  // A store takes each unit by its module and bytes, so their order does not matter.
  while List<ParsedFile>.length(&files) > usize.ZERO {
    let last = List<ParsedFile>.length(&files) - usize.ONE
    let ParsedFile {slot, parsed} = List<ParsedFile>.remove(&mut files, last)
    let unit = run SourceUnit.assemble(&List<ModuleId>.asSlice(&scanned)[slot], number, move parsed)
    run List<SourceUnit>.append(&mut self.parsed, move unit)
  }
  return ()
}

// Starts parsing `jobs` on a thread of its own. When no thread starts, the store parses each file
// when it first reads it.
effect fn parseAhead(workers: &mut List<JoinHandle<List<ParsedFile>>>, jobs: List<ParseJob>) -> ()
! OutOfMemoryError ? &mut Allocator {
  if List<ParseJob>.length(&jobs) == usize.ZERO { return () }
  match move run Effect.result(NativeThread.spawn(
    fn() -> List<ParsedFile> {
      return run parseDetached(move jobs)
    }
  )) {
    Result<JoinHandle<List<ParsedFile>>, OutOfMemoryError | SpawnError>.Success {value} => {
      run List<JoinHandle<List<ParsedFile>>>.append(&mut workers.*, move value)
    }
    Result<JoinHandle<List<ParsedFile>>, OutOfMemoryError | SpawnError>.Failure {error} => match move error {
      SpawnError unstarted => { drop unstarted }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  return ()
}

// `parseEach` on a thread of its own, with an allocator of its own. A thread that runs out of
// memory parses nothing, and the store parses each file when it first reads it.
effect fn parseDetached(jobs: List<ParseJob>) -> List<ParsedFile> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let parsed = run Effect.result(parseEach(move jobs) |> Effect.provideMut<Allocator>(&mut allocator))
  return match move parsed {
    Result<List<ParsedFile>, OutOfMemoryError>.Success {value} => move value
    Result<List<ParsedFile>, OutOfMemoryError>.Failure {error} => {
      drop error
      return List<ParsedFile>.make()
    }
  }
}

effect fn parseEach(jobs: List<ParseJob>) -> List<ParsedFile> ! OutOfMemoryError ? &mut Allocator {
  let mut pending = move jobs
  let mut files = List<ParsedFile>.make()
  while List<ParseJob>.length(&pending) > usize.ZERO {
    let last = List<ParseJob>.length(&pending) - usize.ONE
    let ParseJob {slot, bytes} = List<ParseJob>.remove(&mut pending, last)
    run List<ParsedFile>.append(&mut files, ParsedFile {slot: slot, parsed: run SourceUnit.parseSyntax(move bytes)})
  }
  return move files
}

/// The digests of the modules the last load read that a store reading `events` parsed, for
/// `SemanticCache.saveParsed`.
pub effect fn parsedDigests(self: &ModuleSources, events: &[Event]) -> List<ContentHash> ! OutOfMemoryError ? &mut Allocator {
  let loaded = List<LoadedDigest>.asSlice(&self.digests)
  let mut taken = List<bool>.make()
  while List<bool>.length(&taken) < loaded.length { run List<bool>.append(&mut taken, false) }
  let mut digests = List<ContentHash>.make()
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.SourceRead && events[at].present {
      let mut index = usize.ZERO
      while index < loaded.length {
        if !List<bool>.get(&taken, index) && ModuleId.equals(&loaded[index].module, &events[at].module) {
          List<bool>.set(&mut taken, index, true)
          run List<ContentHash>.append(&mut digests, loaded[index].digest)
          break
        }
        index = index + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return move digests
}

// Appends both modules an import of `path` written in `importer` can name (MODULE-007): the module
// file and the barrel `mod.silk` of the directory of that name. Semantic analysis reads whether
// each is present, so both are published. A path that is not a canonical module path names none.
effect fn appendCandidates(self: &ModuleSources, pending: &mut List<ModuleId>, importer: &ModuleId, path: &[u8]) -> ()
! OutOfMemoryError ? &mut Allocator {
  let file = run Effect.result(PackageGraph.target(&self.graph, importer, path))
  match move file {
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success {value} => {
      run List<ModuleId>.append(&mut pending.*, move value)
    }
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure {error} => match move error {
      InvalidModulePath {} => { return () }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  // A barrel spelled by its own file name is refused, so it names no second file.
  if PackageGraph.isBarrel(path) { return () }
  let barrel = run Effect.result(PackageGraph.barrel(&self.graph, importer, path))
  match move barrel {
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success {value} => {
      run List<ModuleId>.append(&mut pending.*, move value)
    }
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure {error} => match move error {
      InvalidModulePath {} => {}
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  return ()
}

// Parses `module`'s `bytes` for `preload`, which hands the unit to the store, and records the
// imports it writes. A file with a diagnostic is parsed on every load, so its syntax errors are
// reported whether or not anything else reads it.
effect fn parsedSummary(self: &mut ModuleSources, module: &ModuleId, bytes: Bytes, digest: ContentHash, sealedNames: &[Bytes])
  -> ImportSummary ! OutOfMemoryError ? &mut Allocator {
  let unit = run SourceUnit.parse(module, Revision.revisionNumber(&self.revision), move bytes)
  let sealed = SealedOperators.referenced(&unit.syntax, sealedNames)
  let index = run ModuleIndex.build(&unit, false)
  let paths = run ModuleIndex.importPaths(&index, &unit)
  let claims = Semantic.claimsForeignSymbols(&unit.authored, &index)
  if let Option<ImportSummaries>.Some {value: summaries} = &mut self.summaries {
    if SourceUnit.diagnosticCount(&unit) == usize.ZERO {
      run Summaries.add(&mut summaries, digest, sealed, claims, List<Bytes>.asSlice(&paths))
    }
  }
  run List<SourceUnit>.append(&mut self.parsed, move unit)
  return ImportSummary {digest: digest, sealed: sealed, claims: claims, paths: move paths}
}

/// Lets `preload` take a file's imports from `summaries` instead of parsing it, and record the
/// imports of each file it parses there.
pub fn useSummaries(self: &mut ModuleSources, summaries: ImportSummaries) -> () {
  self.summaries = Option<ImportSummaries>.some(move summaries)
}

/// Takes the summaries [`useSummaries`] gave, with what the last load recorded.
pub fn takeSummaries(self: &mut ModuleSources) -> Option<ImportSummaries> {
  return Intrinsic.replace(self.summaries, Option<ImportSummaries>.none())
}

/// Takes the modules the last load found to declare no foreign claim, for a store's
/// `offerClaimFree`.
pub fn takeClaimFree(self: &mut ModuleSources) -> List<ModuleId> {
  return Intrinsic.replace(self.claimFree, List<ModuleId>.make())
}

/// Takes the units `preload` parsed, for a store's `offerParsed`.
pub fn takeParsed(self: &mut ModuleSources) -> List<SourceUnit> {
  return Intrinsic.replace(self.parsed, List<SourceUnit>.make())
}

/// Publishes, from disk, every module that `text` imports when it is the text of `module`, and
/// everything those import, as [`preload`] does. The language server calls it with an open
/// document's unsaved text, whose imports may name modules no earlier text reached.
pub effect fn preloadImports(self: &mut ModuleSources, module: &ModuleId, text: &[u8]) -> ()
! FileError | InvalidModulePath | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let unit = run SourceUnit.parse(module, Revision.revisionNumber(&self.revision), run Bytes.copy(text))
  let index = run ModuleIndex.build(&unit, false)
  let paths = run ModuleIndex.importPaths(&index, &unit)
  let written = List<Bytes>.asSlice(&paths)
  let mut roots = List<ModuleId>.make()
  let mut at = usize.ZERO
  while at < written.length {
    if !SealedOperators.isPath(Bytes.asSlice(&written[at])) {
      run appendCandidates(&self.*, &mut roots, module, Bytes.asSlice(&written[at]))
    }
    at = at + usize.ONE
  }
  return run preload(&mut self.*, List<ModuleId>.asSlice(&roots))
}

/// Publishes the whole program a build of `application` can read: the entry, the application,
/// the runtime when one is selected, the modules the language reads without an import, and
/// everything they import.
pub effect fn preloadProgram(self: &mut ModuleSources, application: &ModuleId) -> ()
! FileError | InvalidModulePath | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut roots = List<ModuleId>.make()
  run List<ModuleId>.append(&mut roots, ModuleId.copy(&self.entry))
  run List<ModuleId>.append(&mut roots, ModuleId.copy(application))
  if let Option<ModuleId>.Some {value: runtime} = &self.runtime {
    run List<ModuleId>.append(&mut roots, ModuleId.copy(&runtime))
  }
  // Layout contracts read the standard library's layout module without an import.
  run List<ModuleId>.append(&mut roots, run ModuleId.sibling(&self.entry, PackageGraph.standardPath(&self.graph, StandardRole.Layout)))
  // The declared library interfaces remain implicit until the approved alias migration (OP-009).
  // Sealed interfaces are published only when preload sees a reference (INTR-007).
  run List<ModuleId>.append(&mut roots, run ModuleId.sibling(&self.entry, PackageGraph.standardPath(&self.graph, StandardRole.Ops)))
  run List<ModuleId>.append(&mut roots, run ModuleId.sibling(&self.entry, PackageGraph.standardPath(&self.graph, StandardRole.Equal)))
  run List<ModuleId>.append(&mut roots, run ModuleId.sibling(&self.entry, PackageGraph.standardPath(&self.graph, StandardRole.Order)))
  if let Option<ExecutionStorage>.Some {value: storage} = &self.storage {
    run List<ModuleId>.append(&mut roots, ModuleId.copy(&storage.create.module))
    run List<ModuleId>.append(&mut roots, ModuleId.copy(&storage.acquire.module))
    run List<ModuleId>.append(&mut roots, ModuleId.copy(&storage.release.module))
    run List<ModuleId>.append(&mut roots, ModuleId.copy(&storage.destroy.module))
  }
  let retained = List<RetentionRoot>.asSlice(&self.retention)
  let mut at = usize.ZERO
  while at < retained.length {
    run List<ModuleId>.append(&mut roots, ModuleId.copy(&retained[at].module))
    at = at + usize.ONE
  }
  // The package's exported modules are checked even when its root imports none of them.
  let mut exported = run exportedModules(&self.*)
  while List<ModuleId>.length(&exported) > usize.ZERO {
    run List<ModuleId>.append(&mut roots, List<ModuleId>.remove(&mut exported, usize.ZERO))
  }
  return run preload(&mut self.*, List<ModuleId>.asSlice(&roots))
}

/// The modules the root package's `[package].exports` lists, in manifest order.
pub effect fn exportedModules(self: &ModuleSources) -> List<ModuleId> ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let mut modules = List<ModuleId>.make()
  let listed = PackageSources.rootExports(&self.packages)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<ModuleId>.append(&mut modules, run ModuleId.sibling(&self.entry, Bytes.asSlice(&listed[at])))
    at = at + usize.ONE
  }
  return move modules
}

fn listed(modules: &[ModuleId], module: &ModuleId) -> bool {
  let mut at = usize.ZERO
  while at < modules.length {
    if ModuleId.equals(&modules[at], module) { return true }
    at = at + usize.ONE
  }
  return false
}

/// Reports whether a semantic store read a module this build never published. Preloading
/// publishes every module the store can demand, so this is a driver defect.
pub fn missedSource(self: &ModuleSources, events: &[Event]) -> bool {
  return missedModule(self, events) != usize.MAX
}

/// The event of the first read [`missedSource`] reports, or `usize.MAX`.
pub fn missedModule(self: &ModuleSources, events: &[Event]) -> usize {
  let mut at = usize.ZERO
  while at < events.length {
    let event = &events[at]
    if event.kind == EventKind.SourceRead && !event.present && !attempted(self, &event.module) {
      // Operator discovery observes this implicit source's absence when no module names it.
      if !ModuleId.withPath<bool>(&event.module, SealedOperators.isPath) { return at }
    }
    at = at + usize.ONE
  }
  return usize.MAX
}
