//! `silk lsp`: a language server speaking JSON-RPC over standard input and output.
//!
//! The server runs on two native threads. The transport thread reads and decodes framed messages
//! from standard input and hands them over an inbox to the compiler thread, which owns the server
//! state and writes every response to standard output.

import lsp.Inbox as Inboxes { Inbox, Receiver, Sender }
import lsp.Server
import lsp.Transport
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.json_scanner { JsonError }
import silk.native_thread { NativeThread, SpawnError }
import silk.os_standard_input { OsStandardInput }
import silk.os_writer { StderrWriter, StdoutWriter }
import silk.result { Result }
import silk.standard_input { StandardInput }
import silk.writer { Writer, WriterError }

/// Runs the server until the client sends `exit` or closes the input, and returns the exit status.
pub effect fn runHost() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let started = run Effect.result(start() |> Effect.provideMut<Allocator>(&mut allocator))
  return match move started {
    Result<i32, OutOfMemoryError | SpawnError>.Success { value } => value
    Result<i32, OutOfMemoryError | SpawnError>.Failure { error: _ } => {
      let mut diagnostics = StderrWriter.make()
      let reported = run Effect.result(
        Writer.writeAll(b"silk lsp: cannot start the server threads\n")
          |> Effect.provideMut<Writer>(&mut diagnostics)
      )
      drop reported
      return 1
    }
  }
}

effect fn start() -> i32
  ! OutOfMemoryError | SpawnError
  ? &mut Allocator {
  let inbox = run Inboxes.make()
  let Inbox { sender, receiver } = move inbox
  let compiler = run NativeThread.spawn(
    fn() -> i32 {
      return serve(move receiver)
    }
  )
  let transport = run NativeThread.spawn(
    fn() -> i32 {
      return forward(move sender)
    }
  )
  let status = compiler.join()
  let forwarded = transport.join()
  return status
}

// The compiler thread.
fn serve(receiver: Receiver) -> i32 {
  let mut output = StdoutWriter.make()
  let served = run Effect.result(Server.serve(&receiver) |> Effect.provideMut<Writer>(&mut output))
  return match move served {
    Result<i32, JsonError | WriterError>.Success { value } => value
    Result<i32, JsonError | WriterError>.Failure { error: _ } => 1
  }
}

// The transport thread.
fn forward(sender: Sender) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut input = OsStandardInput.make()
  let forwarded = run Effect.result(
    Transport.forward(&sender) |> Effect.provideMut<StandardInput>(&mut input)
      |> Effect.provideMut<Allocator>(&mut allocator)
  )
  return match move forwarded {
    Result<(), OutOfMemoryError>.Success { value: _ } => 0
    Result<(), OutOfMemoryError>.Failure { error: _ } => {
      sender.close()
      return 1
    }
  }
}
