//! `silk lsp`: a language server speaking JSON-RPC over standard input and output.
//!
//! The server runs on two native threads. The transport thread reads and decodes framed messages
//! from standard input and hands them over an inbox to the compiler thread, which owns the server
//! state and writes every response to standard output. A build that cannot start threads, such as
//! single-threaded wasm in a browser Worker, runs the server alone on the main thread, reading
//! standard input between its checks.

import lsp.Inbox as Inboxes { Inbox, Sender }
import lsp.Server as Servers { Input }
import lsp.Transport
import lsp.Workspace as Workspaces { Workspace }
import semantic.Target { Target }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.system.filesystem { FileSystem, Path }
import silk.json.scanner { JsonError }
import silk.concurrency.thread_native { NativeThread, SpawnError }
import silk.system.filesystem_machine { MachineFileSystem }
import semantic.Types { TypeTable, Types }
import silk.io.standard_input_native { OsStandardInput }
import silk.io.writer_native { StderrWriter, StdoutWriter }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.standard_input { StandardInput }
import silk.io.writer { Writer, WriterError }

/// Runs the server until the client sends `exit` or closes the input, and returns the exit status.
/// Packages read the standard library at `standardLibrary` and their git dependencies' checkouts
/// in `store` (driver/GitCheckouts), and are analyzed for `target`.
pub effect fn runHost(standardLibrary: Option<Path>, store: Option<Path>, target: Target) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let started = run Effect.result(
    start(move standardLibrary, move store, target) |> Effect.provideMut<Allocator>(&mut allocator)
  )
  return match move started {
    Result<i32, OutOfMemoryError | SpawnError>.Success { value } => value
    Result<i32, OutOfMemoryError | SpawnError>.Failure {..} => {
      let mut diagnostics = StderrWriter.make()
      let reported = run Effect.result(
        Writer.writeAll(b"silk lsp: cannot start the server threads\n")
          |> Effect.provideMut<Writer>(&mut diagnostics)
      )
      drop reported
      return 1
    }
  }
}

effect fn start(standardLibrary: Option<Path>, store: Option<Path>, target: Target) -> i32
  ! OutOfMemoryError | SpawnError
  ? &mut Allocator {
  // Single-threaded wasm refuses every spawn (`NativeThread`).
  static if Intrinsic.targetObjectFormat() == "wasm" && Intrinsic.profileText("threading") != "multi" {
    let reader = run Transport.make()
    return run serve(Input.Direct { reader: move reader }, move standardLibrary, move store, target)
  } else {
    return run startThreads(move standardLibrary, move store, target)
  }
}

effect fn startThreads(standardLibrary: Option<Path>, store: Option<Path>, target: Target) -> i32
  ! OutOfMemoryError | SpawnError
  ? &mut Allocator {
  let inbox = run Inboxes.make()
  let Inbox { sender, receiver } = move inbox
  let compiler = run NativeThread.spawn(
    fn() -> i32 {
      return run serve(Input.Queued { receiver: move receiver }, move standardLibrary, move store, target)
    }
  )
  let transport = run NativeThread.spawn(
    fn() -> i32 {
      return run forward(move sender)
    }
  )
  let status = compiler.join()
  let _forwarded = transport.join()
  return status
}

// The compiler thread's task. Each thread's task is a self-contained Effect that provides its own
// services, so it can move onto a thread pool unchanged. The workspace, whose stores never leave
// this thread, is made here. Standard input is read here only from `Input.Direct`.
effect fn serve(input: Input, standardLibrary: Option<Path>, store: Option<Path>, target: Target) -> i32 {
  let workspace = Workspaces.make(move standardLibrary, move store, target)
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut output = StdoutWriter.make()
  let mut standardInput = OsStandardInput.make()
  let mut source = move input
  let served = run Effect.result(
    analyze(&mut source, move workspace) |> Effect.provideMut<Writer>(&mut output)
      |> Effect.provideMut<StandardInput>(&mut standardInput)
      |> Effect.provideMut<Allocator>(&mut allocator)
  )
  return match move served {
    Result<i32, JsonError | WriterError | OutOfMemoryError>.Success { value } => value
    Result<i32, JsonError | WriterError | OutOfMemoryError>.Failure {..} => 1
  }
}

effect fn analyze(input: &mut Input, workspace: Workspace) -> i32
  ! JsonError | WriterError | OutOfMemoryError
  ? &mut Writer | &mut StandardInput | &mut Allocator {
  let mut files = run MachineFileSystem.make()
  let mut types = TypeTable.make()
  return run Servers.serve(&mut input.*, move workspace) |> Effect.provideMut<FileSystem>(&mut files)
    |> Effect.provideMut<Types>(&mut types)
}

// The transport thread's task. It blocks on standard input, so it keeps a native thread of its own.
effect fn forward(sender: Sender) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut input = OsStandardInput.make()
  let forwarded = run Effect.result(
    Transport.forward(&sender) |> Effect.provideMut<StandardInput>(&mut input)
      |> Effect.provideMut<Allocator>(&mut allocator)
  )
  return match move forwarded {
    Result<(), OutOfMemoryError>.Success {..} => 0
    Result<(), OutOfMemoryError>.Failure {..} => {
      sender.close()
      return 1
    }
  }
}
