//! What a written name at a source offset refers to.
//!
//! A name in a type position, in a header or a body, resolves at module scope as language lookup
//! does: an enclosing declaration's generic parameter first, then the module's declarations and
//! imports, then the members of what each earlier segment named. A name in a body expression
//! reads the resolution table its checked body keeps for an editor (`TypedBody.resolutionSlice`).
//! Every lookup demands answers the store caches, so a name costs one table walk once its body
//! and the modules it names are checked.

import hir.Hir { HirId, Module, Node, OwnerKind, Range }
import lexer.Span { Span }
import semantic.Anchor { Anchor }
import semantic.DeclarationId { DeclarationId }
import semantic.ModuleId { InvalidModulePath, ModuleId }
import semantic.ModuleIndex { IndexedDeclaration, ModuleIndex }
import semantic.Query { Cycle }
import semantic.Rejection { Rejection }
import semantic.Semantic {
  Answer,
  Dependency,
  DocumentationBinding,
  Outcome,
  Semantic,
  StaticPort,
  Value,
}
import semantic.SourceIndex { AuthoredCursor, IndexedSource, NoRejection, RevisionMismatch }
import semantic.Type { Type }
import semantic.TypedBody { Local, NodeKind, Referent, Resolution, TypedBody }
import semantic.SourceUnit { SourceUnit }
import semantic.Types { Types }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.list { List }
import silk.option { Option }
import silk.result { Result }
import silk.shared { Shared }
import silk.slice { Slice }
import silk.usize

/// What a name refers to.
pub union Named {
  /// A declaration: a type, function, constant or member.
  Declaration { pub identity: DeclarationId },
  /// A module that a namespace import names.
  Namespace { pub module: ModuleId },
  /// A parameter or binding of the enclosing body: its binder's span and its type.
  Local { pub binder: Span, pub ty: Shared<Type> },
  /// A generic parameter of an enclosing declaration, by its binder's span.
  Binder { pub binder: Span },
  /// A field of a record type, by its declaration ordinal.
  Field { pub owner: Shared<Type>, pub index: usize },
}

/// A written name and what it refers to.
pub struct NameAt {
  /// The name's span in its module.
  pub span: Span
  pub named: Named
}

/// The innermost written name at `offset` in `module` and what it refers to; absent when the
/// offset is not on a name or the name does not resolve.
pub effect fn at(store: &mut Semantic, module: &ModuleId, offset: usize) -> Option<NameAt>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  let cursor = match move run StaticPort.authoredCursor(&mut port, module) {
    Option<AuthoredCursor>.Some { value } => move value
    Option<AuthoredCursor>.None => {
      return Option<NameAt>.none()
    }
  }
  let written = match move run writtenAt(&port, &cursor, offset) {
    Option<Written>.Some { value } => move value
    Option<Written>.None => {
      return Option<NameAt>.none()
    }
  }
  match move written {
    Written.InBody { span, identity, declaration } => {
      return run bodyName(&mut port, &cursor, span, &identity, declaration, offset)
    }
    Written.TypePath { span, segments, binder } => {
      if let Option<Span>.Some { value } = move binder {
        return Option<NameAt>.some(NameAt { span: span, named: Named.Binder { binder: value } })
      }
      if let Option<Named>.Some { value } = move run pathTarget(&mut port, module, List<Bytes>.asSlice(&segments)) {
        return Option<NameAt>.some(NameAt { span: span, named: move value })
      }
    }
  }
  return Option<NameAt>.none()
}

// What the syntax at an offset shows before anything is demanded.
union Written {
  // A segment of a type's written path: the path's segments up to and including it, and the
  // binder it names when it is a lone generic parameter of an enclosing declaration.
  TypePath { span: Span, segments: List<Bytes>, binder: Option<Span> },
  // A name inside the body of the declaration at `declaration`.
  InBody { span: Span, identity: DeclarationId, declaration: usize },
}

effect fn writtenAt<'s>(port: &StaticPort<'s>, cursor: &AuthoredCursor, offset: usize) -> Option<Written>
  ! OutOfMemoryError
  ? &mut Allocator {
  let indexed = match move StaticPort.sourceAtCursor(port, cursor) {
    Option<&IndexedSource>.Some { value } => value
    Option<&IndexedSource>.None => {
      return Option<Written>.none()
    }
  }
  let hir = IndexedSource.authored(indexed)
  let name = match move innermostName(hir, offset) {
    Option<HirId>.Some { value } => value
    Option<HirId>.None => {
      return Option<Written>.none()
    }
  }
  let span = Module.span(hir, name)
  if let Option<Range>.Some { value: path } = move typePath(hir, name) {
    let mut segments = List<Bytes>.make()
    let mut at = usize.ZERO
    let mut through = true
    while at < path.length && through {
      let segment = Module.child(hir, path, at)
      if let Node.Name { text } = Module.node(hir, segment) {
        run List<Bytes>.append(&mut segments, run Bytes.copy(Module.text(hir, text)))
      }
      through = segment.index != name.index
      at = at + usize.ONE
    }
    let mut binder = Option<Span>.none()
    if List<Bytes>.length(&segments) == usize.ONE {
      binder = genericBinder(hir, IndexedSource.moduleIndex(indexed), offset, Bytes.asSlice(&List<Bytes>.asSlice(&segments)[0]))
    }
    return Option<Written>.some(Written.TypePath { span: span, segments: move segments, binder: move binder })
  }
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
  let mut chosen = usize.MAX
  let mut width = usize.MAX
  let mut at = usize.ZERO
  while at < declarations.length {
    if let Option<Span>.Some { value: block } = move bodyBlock(hir, declarations[at].local) {
      if block.start <= offset && offset < block.end && block.end - block.start < width {
        chosen = at
        width = block.end - block.start
      }
    }
    at = at + usize.ONE
  }
  if chosen == usize.MAX {
    return Option<Written>.none()
  }
  return Option<Written>.some(
    Written.InBody { span: span, identity: DeclarationId.copy(&declarations[chosen].identity), declaration: chosen }
  )
}

// The innermost `Name` node whose span holds `offset`, end inclusive so a cursor just after a
// name still names it.
fn innermostName(hir: &Module, offset: usize) -> Option<HirId> {
  let mut found = Option<HirId>.none()
  let mut width = usize.MAX
  let mut at = usize.ZERO
  let count = Module.length(hir)
  while at < count {
    let id = HirId { index: at }
    if let Node.Name { .. } = Module.node(hir, id) {
      let span = Module.span(hir, id)
      if span.start <= offset && offset <= span.end && span.end - span.start < width {
        found = Option<HirId>.some(id)
        width = span.end - span.start
      }
    }
    at = at + usize.ONE
  }
  return move found
}

// The segments of the path that names a type, when `name` is one of them. The arena is
// postorder, so a node's parent comes after it.
fn typePath(hir: &Module, name: HirId) -> Option<Range> {
  let count = Module.length(hir)
  let mut at = name.index + usize.ONE
  while at < count {
    if let Node.Path { segments } = Module.node(hir, HirId { index: at }) {
      if holds(hir, segments, name) {
        let path = HirId { index: at }
        let mut parent = at + usize.ONE
        while parent < count {
          if let Node.NamedType { path: named, .. } = Module.node(hir, HirId { index: parent }) {
            if named.index == path.index {
              return Option<Range>.some(segments)
            }
          }
          parent = parent + usize.ONE
        }
        return Option<Range>.none()
      }
    }
    at = at + usize.ONE
  }
  return Option<Range>.none()
}

fn holds(hir: &Module, range: Range, id: HirId) -> bool {
  let mut at = usize.ZERO
  while at < range.length {
    if Module.child(hir, range, at).index == id.index {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// The binder of a generic parameter named `name` that an enclosing declaration of `offset`
// writes, innermost first.
fn genericBinder(hir: &Module, index: &ModuleIndex, offset: usize, name: &[u8]) -> Option<Span> {
  let declarations = ModuleIndex.listDeclarations(index)
  let mut found = Option<Span>.none()
  let mut width = usize.MAX
  let mut at = usize.ZERO
  while at < declarations.length {
    let local = declarations[at].local
    let span = Module.span(hir, local)
    if span.start <= offset && offset <= span.end && span.end - span.start < width {
      if let Option<HirId>.Some { value: first } = move Module.declarationStart(hir, local) {
        let mut node = first.index
        while node < local.index {
          if let Node.TypeParameter { name: binder, .. } = Module.node(hir, HirId { index: node }) {
            if let Node.Name { text } = Module.node(hir, binder) {
              if same(Module.text(hir, text), name) {
                found = Option<Span>.some(Module.span(hir, binder))
                width = span.end - span.start
              }
            }
          }
          node = node + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return move found
}

// The span of a callable declaration's body block; absent for any other declaration.
fn bodyBlock(hir: &Module, declaration: HirId) -> Option<Span> {
  if let Node.Declaration { body, .. } = Module.node(hir, declaration) {
    if let Node.CallableBody { block } = Module.node(hir, body) {
      if block.present {
        return Option<Span>.some(Module.span(hir, block.id))
      }
    }
  }
  return Option<Span>.none()
}

// Resolves a written path segment by segment, as language lookup does from `module`.
effect fn pathTarget<'s>(port: &mut StaticPort<'s>, module: &ModuleId, segments: &[Bytes]) -> Option<Named>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  if segments.length == usize.ZERO {
    return Option<Named>.none()
  }
  let mut named = match move run StaticPort.documentationBinding(&mut port.*, module, Bytes.asSlice(&segments[0]), false) {
    Result<Option<DocumentationBinding>, Shared<Rejection>>.Success { value: Option<DocumentationBinding>.Some { value } } => move value
    _ => {
      return Option<Named>.none()
    }
  }
  let mut at = usize.ONE
  while at < segments.length {
    let next = match move named {
      DocumentationBinding.Namespace { module: namespace, .. } => run namespaceMember(&mut port.*, &namespace, Bytes.asSlice(&segments[at]))
      DocumentationBinding.Declaration { identity, .. } => run declarationMember(&mut port.*, &identity, Bytes.asSlice(&segments[at]))
    }
    named = match move next {
      Option<DocumentationBinding>.Some { value } => move value
      Option<DocumentationBinding>.None => {
        return Option<Named>.none()
      }
    }
    at = at + usize.ONE
  }
  return match move named {
    DocumentationBinding.Declaration { identity, .. } => Option<Named>.some(Named.Declaration { identity: move identity })
    DocumentationBinding.Namespace { module: namespace, .. } => Option<Named>.some(Named.Namespace { module: move namespace })
  }
}

// A public declaration of the module `namespace` names.
effect fn namespaceMember<'s>(port: &mut StaticPort<'s>, namespace: &ModuleId, name: &[u8]) -> Option<DocumentationBinding>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  if let Result<Option<DocumentationBinding>, Shared<Rejection>>.Success { value } = move run StaticPort.documentationBinding(
    &mut port.*,
    namespace,
    name,
    true
  ) {
    return move value
  }
  return Option<DocumentationBinding>.none()
}

// An inherent member of the declaration `owner`, as `make` in `List.make`.
effect fn declarationMember<'s>(port: &mut StaticPort<'s>, owner: &DeclarationId, name: &[u8]) -> Option<DocumentationBinding>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let spelling = run DeclarationId.copySpelling(owner)
  let member = run StaticPort.documentationMember(&mut port.*, DeclarationId.moduleId(owner), Bytes.asSlice(&spelling), name)
  if let Result<Option<DeclarationId>, Shared<Rejection>>.Success { value: Option<DeclarationId>.Some { value } } = move member {
    return Option<DocumentationBinding>.some(DocumentationBinding.Declaration { identity: move value, isPublic: true })
  }
  return Option<DocumentationBinding>.none()
}

// Reads a body name from the resolution table of the checked body that holds it.
effect fn bodyName<'s>(
  port: &mut StaticPort<'s>,
  cursor: &AuthoredCursor,
  span: Span,
  identity: &DeclarationId,
  declaration: usize,
  offset: usize,
) -> Option<NameAt>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let answer = match move run StaticPort.demandBody(&mut port.*, identity, span) {
    Option<Shared<Result<Answer, NoRejection>>>.Some { value } => move value
    Option<Shared<Result<Answer, NoRejection>>>.None => {
      return Option<NameAt>.none()
    }
  }
  let body = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&answer, checkedBody) {
    Option<Shared<TypedBody>>.Some { value } => move value
    Option<Shared<TypedBody>>.None => {
      return Option<NameAt>.none()
    }
  }
  let anchor = match move anchorOf(&port.*, cursor, declaration) {
    Option<Anchor>.Some { value } => move value
    Option<Anchor>.None => {
      return Option<NameAt>.none()
    }
  }
  return Shared<TypedBody>.with<Option<NameAt>>(&body, fn(checked: &TypedBody) -> Option<NameAt> {
    return tableName(checked, &anchor, offset)
  })
}

fn anchorOf<'s>(port: &StaticPort<'s>, cursor: &AuthoredCursor, declaration: usize) -> Option<Anchor> {
  if let Option<&IndexedSource>.Some { value } = move StaticPort.sourceAtCursor(port, cursor) {
    return IndexedSource.anchorOf(value, declaration)
  }
  return Option<Anchor>.none()
}

// The narrowest table entry whose name holds `offset`.
fn tableName(body: &TypedBody, anchor: &Anchor, offset: usize) -> Option<NameAt> {
  let table = TypedBody.resolutionSlice(body)
  let mut chosen = usize.MAX
  let mut width = usize.MAX
  let mut at = usize.ZERO
  while at < table.length {
    let span = Anchor.span(anchor, table[at].origin.location)
    if span.start <= offset && offset <= span.end && span.end - span.start < width {
      chosen = at
      width = span.end - span.start
    }
    at = at + usize.ONE
  }
  if chosen == usize.MAX {
    return Option<NameAt>.none()
  }
  let span = Anchor.span(anchor, table[chosen].origin.location)
  let locals = TypedBody.localSlice(body)
  return match &table[chosen].referent {
    Referent.Declaration { declaration } => Option<NameAt>.some(NameAt { span: span, named: Named.Declaration {
      identity: Shared<DeclarationId>.with<DeclarationId>(&declaration, DeclarationId.copy),
    } })
    Referent.Local { local } => localName(span, locals, local.index, anchor)
    Referent.Field { owner, index } => Option<NameAt>.some(NameAt { span: span, named: Named.Field { owner: Shared<Type>.clone(&owner), index: index } })
    Referent.Type { .. } => Option<NameAt>.none()
  }
}

fn localName(span: Span, locals: &[Local], index: usize, anchor: &Anchor) -> Option<NameAt> {
  if index < locals.length {
    return Option<NameAt>.some(NameAt { span: span, named: Named.Local {
      binder: Anchor.span(anchor, locals[index].origin.location),
      ty: Shared<Type>.clone(&locals[index].ty),
    } })
  }
  return Option<NameAt>.none()
}

fn checkedBody(answer: &Result<Answer, NoRejection>) -> Option<Shared<TypedBody>> {
  if let Result<Answer, NoRejection>.Success { value } = &answer.* {
    if let Outcome.Success { value: Value.Body { body } } = &value.outcome {
      return Option<Shared<TypedBody>>.some(Shared<TypedBody>.clone(&body))
    }
  }
  return Option<Shared<TypedBody>>.none()
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// Where a declaration is written and what its header says.
pub struct Site {
  pub module: ModuleId
  /// The declaration's name in its module.
  pub name: Span
  /// The header as written.
  pub header: Bytes
  /// Where the header starts in its module.
  pub headerStart: usize
  /// The written parameters, in order, as spans in the module.
  pub parameters: List<Span>
  /// The doc comment the source attached, empty when it has none.
  pub documentation: Bytes
  /// The module's text, which the spans index.
  pub text: Bytes
}

/// Where `identity` is written in the store's current source, and its header.
pub effect fn site(store: &mut Semantic, identity: &DeclarationId) -> Option<Site>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  let module = DeclarationId.moduleId(identity)
  let cursor = match move run StaticPort.authoredCursor(&mut port, module) {
    Option<AuthoredCursor>.Some { value } => move value
    Option<AuthoredCursor>.None => {
      return Option<Site>.none()
    }
  }
  let indexed = match move StaticPort.sourceAtCursor(&port, &cursor) {
    Option<&IndexedSource>.Some { value } => value
    Option<&IndexedSource>.None => {
      return Option<Site>.none()
    }
  }
  let hir = IndexedSource.authored(indexed)
  let text = SourceUnit.bytes(IndexedSource.sourceUnit(indexed))
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
  let mut at = usize.ZERO
  while at < declarations.length {
    if DeclarationId.equals(&declarations[at].identity, identity) {
      let local = declarations[at].local
      if let Node.Declaration { header, documentation, .. } = Module.node(hir, local) {
        let spelling = run DeclarationId.copySpelling(identity)
        let first = match move Module.declarationStart(hir, local) {
          Option<HirId>.Some { value } => value
          Option<HirId>.None => header
        }
        let headerSpan = Module.span(hir, header)
        let mut name = headerSpan
        let mut parameters = List<Span>.make()
        let mut named = false
        let mut node = first.index
        while node <= header.index {
          let id = HirId { index: node }
          match Module.node(hir, id) {
            Node.Name { text: written } => {
              if !named && same(Module.text(hir, written), Bytes.asSlice(&spelling)) {
                name = Module.span(hir, id)
                named = true
              }
            }
            Node.Parameter { .. } => run List<Span>.append(&mut parameters, Module.span(hir, id))
            _ => ()
          }
          node = node + usize.ONE
        }
        let mut doc = Bytes.make()
        if documentation.present {
          doc = run commentText(Module.text(hir, documentation.symbol))
        }
        // A callable's header ends where its body block starts.
        let mut end = headerSpan.end
        if let Option<Span>.Some { value: block } = move bodyBlock(hir, local) {
          if block.start < end {
            end = block.start
          }
        }
        if end > text.length {
          end = text.length
        }
        while end > headerSpan.start && (text[end - usize.ONE] == 32 || text[end - usize.ONE] == 10 || text[end - usize.ONE] == 9 || text[end - usize.ONE] == 13) {
          end = end - usize.ONE
        }
        return Option<Site>.some(Site {
          module: ModuleId.copy(module),
          name: name,
          header: run Bytes.copy(Slice.view<u8>(text, headerSpan.start, end - headerSpan.start)),
          headerStart: headerSpan.start,
          parameters: move parameters,
          documentation: move doc,
          text: run Bytes.copy(text),
        })
      }
    }
    at = at + usize.ONE
  }
  return Option<Site>.none()
}

/// The declaration whose own name is written at `offset` in `module`, as a cursor on a
/// declaration's name sees it; absent elsewhere.
pub effect fn declaredAt(store: &mut Semantic, module: &ModuleId, offset: usize) -> Option<NameAt>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  let cursor = match move run StaticPort.authoredCursor(&mut port, module) {
    Option<AuthoredCursor>.Some { value } => move value
    Option<AuthoredCursor>.None => {
      return Option<NameAt>.none()
    }
  }
  let indexed = match move StaticPort.sourceAtCursor(&port, &cursor) {
    Option<&IndexedSource>.Some { value } => value
    Option<&IndexedSource>.None => {
      return Option<NameAt>.none()
    }
  }
  let hir = IndexedSource.authored(indexed)
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
  let mut at = usize.ZERO
  while at < declarations.length {
    if let Option<Span>.Some { value: name } = move run declarationName(hir, &declarations[at]) {
      if name.start <= offset && offset <= name.end {
        return Option<NameAt>.some(NameAt {
          span: name,
          named: Named.Declaration { identity: DeclarationId.copy(&declarations[at].identity) },
        })
      }
    }
    at = at + usize.ONE
  }
  return Option<NameAt>.none()
}

/// The span of the name `declared` is written with in `hir`; absent for an import, an `impl`, an
/// unnamed declaration and damage, whose headers write no name of their own.
pub effect fn declarationName(hir: &Module, declared: &IndexedDeclaration) -> Option<Span>
  ! OutOfMemoryError
  ? &mut Allocator {
  let named = match DeclarationId.kind(&declared.identity) {
    OwnerKind.Import => false
    OwnerKind.Conditional => false
    OwnerKind.Implementation => false
    OwnerKind.Anonymous => false
    OwnerKind.EffectBlock => false
    OwnerKind.Damaged => false
    _ => true
  }
  if !named {
    return Option<Span>.none()
  }
  let spelling = run DeclarationId.copySpelling(&declared.identity)
  if Bytes.length(&spelling) == usize.ZERO {
    return Option<Span>.none()
  }
  if let Node.Declaration { header, .. } = Module.node(hir, declared.local) {
    let first = match move Module.declarationStart(hir, declared.local) {
      Option<HirId>.Some { value } => value
      Option<HirId>.None => header
    }
    let mut node = first.index
    while node <= header.index {
      let id = HirId { index: node }
      if let Node.Name { text } = Module.node(hir, id) {
        if same(Module.text(hir, text), Bytes.asSlice(&spelling)) {
          return Option<Span>.some(Module.span(hir, id))
        }
      }
      node = node + usize.ONE
    }
  }
  return Option<Span>.none()
}

/// What `name` means at the top level of `module`: its own declaration or the one an import
/// brings in.
pub effect fn scoped(store: &mut Semantic, module: &ModuleId, name: &[u8]) -> Option<Named>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut segments = List<Bytes>.make()
  run List<Bytes>.append(&mut segments, run Bytes.copy(name))
  return run pathNamed(&mut store.*, module, List<Bytes>.asSlice(&segments))
}

/// What the written path `segments` means at the top level of `module`, each segment a member of
/// what the one before it names.
pub effect fn pathNamed(store: &mut Semantic, module: &ModuleId, segments: &[Bytes]) -> Option<Named>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  return run pathTarget(&mut port, module, segments)
}

/// Whether `name` is a public declaration of `module`.
pub effect fn exported(store: &mut Semantic, module: &ModuleId, name: &[u8]) -> bool
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  if let Option<DocumentationBinding>.Some { .. } = move run namespaceMember(&mut port, module, name) {
    return true
  }
  return false
}

// A doc comment's text without its `///` markers: each line loses its leading blanks, the
// marker and one space after it.
effect fn commentText(written: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  let mut at = usize.ZERO
  while at < written.length {
    let mut end = at
    while end < written.length && written[end] != 10 {
      end = end + usize.ONE
    }
    let mut start = at
    while start < end && (written[start] == 32 || written[start] == 9) {
      start = start + usize.ONE
    }
    let mut slashes = usize.ZERO
    while start < end && slashes < 3 && written[start] == 47 {
      start = start + usize.ONE
      slashes = slashes + usize.ONE
    }
    if slashes == 3 && start < end && written[start] == 32 {
      start = start + usize.ONE
    }
    if slashes != 3 {
      start = at
    }
    if Bytes.length(&text) > usize.ZERO {
      run Bytes.append(&mut text, b"\n")
    }
    run Bytes.append(&mut text, Slice.view<u8>(written, start, end - start))
    at = end + usize.ONE
  }
  return move text
}

/// The type of the narrowest checked expression at an offset, and its span.
pub struct Typed {
  pub span: Span
  pub ty: Shared<Type>
}

/// The type of the narrowest checked expression at `offset` in `module`; absent outside a
/// checked body.
pub effect fn typeAt(store: &mut Semantic, module: &ModuleId, offset: usize) -> Option<Typed>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  let cursor = match move run StaticPort.authoredCursor(&mut port, module) {
    Option<AuthoredCursor>.Some { value } => move value
    Option<AuthoredCursor>.None => {
      return Option<Typed>.none()
    }
  }
  let enclosing = match move enclosingBody(&port, &cursor, offset) {
    Option<Enclosing>.Some { value } => move value
    Option<Enclosing>.None => {
      return Option<Typed>.none()
    }
  }
  let body = match move run checked(&mut port, &enclosing) {
    Option<Shared<TypedBody>>.Some { value } => move value
    Option<Shared<TypedBody>>.None => {
      return Option<Typed>.none()
    }
  }
  let anchor = match move anchorOf(&port, &cursor, enclosing.ordinal) {
    Option<Anchor>.Some { value } => move value
    Option<Anchor>.None => {
      return Option<Typed>.none()
    }
  }
  return Shared<TypedBody>.with<Option<Typed>>(&body, fn(checked: &TypedBody) -> Option<Typed> {
    let nodes = TypedBody.nodeSlice(checked)
    let mut found = Option<Typed>.none()
    let mut width = usize.MAX
    let mut at = usize.ZERO
    while at < nodes.length {
      if let NodeKind.Expression { ty, .. } = &nodes[at].kind {
        let span = Anchor.span(&anchor, nodes[at].origin.location)
        if span.start <= offset && offset <= span.end && span.end - span.start < width {
          found = Option<Typed>.some(Typed { span: span, ty: Shared<Type>.clone(&ty) })
          width = span.end - span.start
        }
      }
      at = at + usize.ONE
    }
    return move found
  })
}

/// A binding whose type the source left to inference: where its name ends and its type.
pub struct Inferred {
  pub end: usize
  pub ty: Shared<Type>
}

/// The bindings of `module`'s checked bodies whose types were inferred, in body order.
pub effect fn inferred(store: &mut Semantic, module: &ModuleId) -> List<Inferred>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut found = List<Inferred>.make()
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  let cursor = match move run StaticPort.authoredCursor(&mut port, module) {
    Option<AuthoredCursor>.Some { value } => move value
    Option<AuthoredCursor>.None => {
      return move found
    }
  }
  let bodies = run bodiesOf(&port, &cursor)
  let listed = List<Enclosing>.asSlice(&bodies)
  let mut at = usize.ZERO
  while at < listed.length {
    if let Option<Shared<TypedBody>>.Some { value: body } = move run checked(&mut port, &listed[at]) {
      if let Option<Anchor>.Some { value: anchor } = move anchorOf(&port, &cursor, listed[at].ordinal) {
        run appendInferred(&body, &anchor, listed[at].block, &mut found)
      }
    }
    at = at + usize.ONE
  }
  return move found
}

effect fn appendInferred(body: &Shared<TypedBody>, anchor: &Anchor, block: Span, found: &mut List<Inferred>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let count = Shared<TypedBody>.with<usize>(body, fn(checked: &TypedBody) -> usize {
    return TypedBody.localSlice(checked).length
  })
  let mut at = usize.ZERO
  while at < count {
    let entry = Shared<TypedBody>.with<Option<Typed>>(body, fn(checked: &TypedBody) -> Option<Typed> {
      let local = &TypedBody.localSlice(checked)[at]
      if local.written {
        return Option<Typed>.none()
      }
      return Option<Typed>.some(Typed { span: Anchor.span(anchor, local.origin.location), ty: Shared<Type>.clone(&local.ty) })
    })
    if let Option<Typed>.Some { value } = move entry {
      if block.start <= value.span.start && value.span.end <= block.end {
        run List<Inferred>.append(&mut found.*, Inferred { end: value.span.end, ty: move value.ty })
      }
    }
    at = at + usize.ONE
  }
  return ()
}

/// The call whose arguments hold an offset: the declaration it calls, the argument the offset is
/// in, and whether a receiver fills the first parameter.
pub struct CallAt {
  pub identity: DeclarationId
  pub active: usize
  pub receiver: bool
}

/// The innermost call in `module` whose argument list holds `offset`.
pub effect fn callAt(store: &mut Semantic, module: &ModuleId, offset: usize) -> Option<CallAt>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let syntax = match move run callSyntax(&mut store.*, module, offset) {
    Option<CallSyntax>.Some { value } => move value
    Option<CallSyntax>.None => {
      return Option<CallAt>.none()
    }
  }
  if let Option<NameAt>.Some { value: found } = move run at(&mut store.*, module, syntax.name) {
    if let Named.Declaration { identity } = move found.named {
      return Option<CallAt>.some(CallAt { identity: move identity, active: syntax.active, receiver: syntax.receiver })
    }
  }
  return Option<CallAt>.none()
}

struct CallSyntax {
  name: usize
  active: usize
  receiver: bool
}



effect fn callSyntax(store: &mut Semantic, module: &ModuleId, offset: usize) -> Option<CallSyntax>
  ! Cycle | OutOfMemoryError
  ? &mut Allocator {
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  let cursor = match move run StaticPort.authoredCursor(&mut port, module) {
    Option<AuthoredCursor>.Some { value } => move value
    Option<AuthoredCursor>.None => {
      return Option<CallSyntax>.none()
    }
  }
  let hir = match move StaticPort.authoredAtCursor(&port, &cursor) {
    Option<&Module>.Some { value } => value
    Option<&Module>.None => {
      return Option<CallSyntax>.none()
    }
  }
  let mut found = Option<CallSyntax>.none()
  let mut width = usize.MAX
  let count = Module.length(hir)
  let mut at = usize.ZERO
  while at < count {
    let id = HirId { index: at }
    if let Node.CallExpression { callee, arguments, .. } = Module.node(hir, id) {
      let span = Module.span(hir, id)
      let calleeSpan = Module.span(hir, callee)
      if calleeSpan.end < offset && offset < span.end && span.end - span.start < width {
        let mut name = calleeSpan.start
        let mut receiver = false
        match Module.node(hir, callee) {
          Node.FieldExpression { subject, field } => {
            name = Module.span(hir, field).start
            receiver = true
            if let Node.IdentifierExpression { binding, .. } = Module.node(hir, subject) {
              receiver = binding.present
            }
          }
          Node.IdentifierExpression { name: written, .. } => {
            name = Module.span(hir, written).start
          }
          _ => ()
        }
        let mut active = usize.ZERO
        let mut argument = usize.ZERO
        while argument < arguments.length {
          if Module.span(hir, Module.child(hir, arguments, argument)).end < offset {
            active = argument + usize.ONE
          }
          argument = argument + usize.ONE
        }
        if arguments.length > usize.ZERO && active >= arguments.length {
          active = arguments.length - usize.ONE
          if lastArgumentClosed(hir, arguments, offset) {
            active = arguments.length
          }
        }
        found = Option<CallSyntax>.some(CallSyntax { name: name, active: active, receiver: receiver })
        width = span.end - span.start
      }
    }
    at = at + usize.ONE
  }
  return move found
}

// Whether a comma follows the last argument before `offset`, so the cursor starts a new one.
fn lastArgumentClosed(hir: &Module, arguments: Range, offset: usize) -> bool {
  return Module.span(hir, Module.child(hir, arguments, arguments.length - usize.ONE)).end < offset
}

// One callable body of a module: its declaration, ordinal and block.
struct Enclosing {
  identity: DeclarationId
  ordinal: usize
  span: Span
  block: Span
}

fn enclosingBody<'s>(port: &StaticPort<'s>, cursor: &AuthoredCursor, offset: usize) -> Option<Enclosing> {
  let indexed = match move StaticPort.sourceAtCursor(port, cursor) {
    Option<&IndexedSource>.Some { value } => value
    Option<&IndexedSource>.None => {
      return Option<Enclosing>.none()
    }
  }
  let hir = IndexedSource.authored(indexed)
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
  let mut chosen = usize.MAX
  let mut width = usize.MAX
  let mut at = usize.ZERO
  while at < declarations.length {
    if let Option<Span>.Some { value: block } = move bodyBlock(hir, declarations[at].local) {
      if block.start <= offset && offset < block.end && block.end - block.start < width {
        chosen = at
        width = block.end - block.start
      }
    }
    at = at + usize.ONE
  }
  if chosen == usize.MAX {
    return Option<Enclosing>.none()
  }
  return Option<Enclosing>.some(enclosingAt(hir, declarations, chosen))
}

fn enclosingAt(hir: &Module, declarations: &[IndexedDeclaration], at: usize) -> Enclosing {
  let mut block = Span { start: usize.ZERO, end: usize.ZERO }
  if let Option<Span>.Some { value } = move bodyBlock(hir, declarations[at].local) {
    block = value
  }
  return Enclosing {
    identity: DeclarationId.copy(&declarations[at].identity),
    ordinal: at,
    span: Module.span(hir, declarations[at].local),
    block: block,
  }
}

effect fn bodiesOf<'s>(port: &StaticPort<'s>, cursor: &AuthoredCursor) -> List<Enclosing> ! OutOfMemoryError ? &mut Allocator {
  let mut bodies = List<Enclosing>.make()
  if let Option<&IndexedSource>.Some { value: indexed } = move StaticPort.sourceAtCursor(port, cursor) {
    let hir = IndexedSource.authored(indexed)
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let mut at = usize.ZERO
    while at < declarations.length {
      if let Option<Span>.Some { .. } = move bodyBlock(hir, declarations[at].local) {
        run List<Enclosing>.append(&mut bodies, enclosingAt(hir, declarations, at))
      }
      at = at + usize.ONE
    }
  }
  return move bodies
}

effect fn checked<'s>(port: &mut StaticPort<'s>, enclosing: &Enclosing) -> Option<Shared<TypedBody>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  if let Option<Shared<Result<Answer, NoRejection>>>.Some { value } = move run StaticPort.demandBody(
    &mut port.*,
    &enclosing.identity,
    enclosing.span
  ) {
    return Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&value, checkedBody)
  }
  return Option<Shared<TypedBody>>.none()
}
