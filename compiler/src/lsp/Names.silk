//! What a written name at a source offset refers to.
//!
//! A name in a type position, in a header or a body, resolves at module scope as language lookup
//! does: an enclosing declaration's generic parameter first, then the module's declarations and
//! imports, then the members of what each earlier segment named. A name in a body expression
//! reads the resolution table its checked body keeps for an editor (`TypedBody.resolutionSlice`).
//! Every lookup demands answers the store caches, so a name costs one table walk once its body
//! and the modules it names are checked.

import hir.Directive as Directive { Kind }
import hir.Hir { HirId, Module, Node, OwnerKind, Range }
import lexer.Span { Span }
import semantic.Anchor { Anchor }
import semantic.DeclarationId { DeclarationId }
import semantic.FieldSyntax as FieldSyntax
import semantic.ModuleId { InvalidModulePath, ModuleId }
import semantic.ModuleIndex { IndexedDeclaration, ModuleIndex }
import semantic.Query { Cycle }
import semantic.Rejection { Rejection }
import semantic.Semantic {
  Answer,
  Dependency,
  DocumentationBinding,
  Outcome,
  Semantic,
  StaticPort,
  Value,
}
import semantic.SourceIndex { AuthoredCursor, IndexedSource, NoRejection, RevisionMismatch }
import semantic.Type { Type }
import semantic.TypedBody { Environment, Expression, Local, NodeKind, Referent, Resolution, TypedBody }
import semantic.SourceUnit { SourceUnit }
import semantic.Types { Types }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.shared { Shared }
import silk.collections.slice { Slice }
import silk.num.usize

/// What a name refers to.
pub union Named {
  /// A declaration: a type, function, constant or member.
  Declaration { pub identity: DeclarationId },
  /// A module that a namespace import names.
  Namespace { pub module: ModuleId },
  /// A parameter or binding of the enclosing body: its binder's span and its type.
  Local { pub binder: Span, pub ty: Shared<Type> },
  /// A generic parameter of an enclosing declaration, by its binder's span.
  Binder { pub binder: Span },
  /// A field of a record type, by its declaration ordinal.
  Field { pub owner: Shared<Type>, pub index: usize },
}

/// A written name and what it refers to.
pub struct NameAt {
  /// The name's span in its module.
  pub span: Span,
  pub named: Named,
}

/// The innermost written name at `offset` in `module` and what it refers to; absent when the
/// offset is not on a name or the name does not resolve.
pub effect fn at(store: &mut Semantic, module: &ModuleId, offset: usize) -> Option<NameAt>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  let cursor = match move run StaticPort.authoredCursor(&mut port, module) {
    Option<AuthoredCursor>.Some { value } => move value
    Option<AuthoredCursor>.None => {
      return Option<NameAt>.none()
    }
  }
  let written = match move run writtenAt(&port, &cursor, offset) {
    Option<Written>.Some { value } => move value
    Option<Written>.None => {
      return Option<NameAt>.none()
    }
  }
  match move written {
    Written.InBody { span, identity, declaration, unbound, pattern, qualified } => {
      if let Option<NameAt>.Some { value } = move run bodyName(&mut port, &cursor, span, &identity, declaration, offset) {
        return Option<NameAt>.some(move value)
      }
      // The table has no entry for a read of a match pattern's binder, which is a place of the
      // matched value rather than a body local, nor for reads inside a closure; the binder says
      // what they read.
      if let Option<PatternBinder>.Some { value: binder } = move pattern {
        if let Option<IntroducedAt>.Some { value: bound } = move run binderAt(&mut port, &cursor, binder.name, binder.node) {
          if let Introduced.Local { ty } = move bound.introduced {
            return Option<NameAt>.some(NameAt { span: span, named: Named.Local { binder: binder.name, ty: move ty } })
          }
        }
      }
      // A member a qualifier selects, as `fieldLabel` in `Reflect.fieldLabel(field)`, resolves by
      // its path when its body has no checked table, as a generic static body whose static work
      // waits for an instance.
      if List<Bytes>.length(&qualified) > usize.ZERO {
        if let Option<Named>.Some { value } = move run pathTarget(&mut port, module, List<Bytes>.asSlice(&qualified)) {
          return Option<NameAt>.some(NameAt { span: span, named: move value })
        }
      }
      // A type or namespace written as a value's qualifier, as `Logger` in `Logger.make()`,
      // resolves in the module's scope; the checked body records only what it selects.
      if let Option<Bytes>.Some { value: spelling } = move unbound {
        if let Option<Named>.Some { value } = move run pathTarget(&mut port, module, &[move spelling]) {
          return Option<NameAt>.some(NameAt { span: span, named: move value })
        }
      }
    }
    Written.Import { span, declaration, member } => {
      return match move run StaticPort.documentationImport(&mut port, module, declaration, move member, span) {
        Option<DocumentationBinding>.Some { value: DocumentationBinding.Declaration { identity, .. } } => Option<NameAt>.some(
          NameAt { span: span, named: Named.Declaration { identity: move identity } }
        )
        Option<DocumentationBinding>.Some { value: DocumentationBinding.Namespace { module: namespace, .. } } => Option<NameAt>.some(
          NameAt { span: span, named: Named.Namespace { module: move namespace } }
        )
        Option<DocumentationBinding>.None => Option<NameAt>.none()
      }
    }
    Written.TypePath { span, segments, binder } => {
      if let Option<Span>.Some { value } = move binder {
        return Option<NameAt>.some(NameAt { span: span, named: Named.Binder { binder: value } })
      }
      if let Option<Named>.Some { value } = move run pathTarget(&mut port, module, List<Bytes>.asSlice(&segments)) {
        return Option<NameAt>.some(NameAt { span: span, named: move value })
      }
    }
  }
  return Option<NameAt>.none()
}

// The binder an identifier reads: a parameter, binding or pattern binder node and its name's span.
struct PatternBinder {
  node: HirId,
  name: Span,
}

// What the syntax at an offset shows before anything is demanded.
union Written {
  // A segment of a type's written path: the path's segments up to and including it, and the
  // binder it names when it is a lone generic parameter of an enclosing declaration.
  TypePath { span: Span, segments: List<Bytes>, binder: Option<Span> },
  // A name inside the body of the declaration at `declaration`, and its spelling when it is an
  // identifier no lexical binder holds.
  InBody { span: Span, identity: DeclarationId, declaration: usize, unbound: Option<Bytes>, pattern: Option<PatternBinder>, qualified: List<Bytes> },
  // A name an import at `declaration` writes: its module path or alias, or else the selected
  // member at ordinal `member`, by the member's name or alias.
  Import { span: Span, declaration: usize, member: Option<usize> },
}

effect fn writtenAt<'s>(port: &StaticPort<'s>, cursor: &AuthoredCursor, offset: usize) -> Option<Written>
  ! OutOfMemoryError
  ? &mut Allocator {
  let indexed = match move StaticPort.sourceAtCursor(port, cursor) {
    Option<&IndexedSource>.Some { value } => value
    Option<&IndexedSource>.None => {
      return Option<Written>.none()
    }
  }
  let hir = IndexedSource.authored(indexed)
  let name = match move innermostName(hir, offset) {
    Option<HirId>.Some { value } => value
    Option<HirId>.None => {
      return Option<Written>.none()
    }
  }
  let span = Module.span(hir, name)
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
  if let Option<Written>.Some { value } = move importAt(hir, declarations, name) {
    return Option<Written>.some(move value)
  }
  if let Option<Range>.Some { value: path } = move typePath(hir, name) {
    let mut segments = List<Bytes>.make()
    let mut at = usize.ZERO
    let mut through = true
    while at < path.length && through {
      let segment = Module.child(hir, path, at)
      if let Node.Name { text } = Module.node(hir, segment) {
        run List<Bytes>.append(&mut segments, run Bytes.copy(Module.text(hir, text)))
      }
      through = segment.index != name.index
      at = at + usize.ONE
    }
    let mut binder = Option<Span>.none()
    if List<Bytes>.length(&segments) == usize.ONE {
      binder = genericBinder(hir, IndexedSource.moduleIndex(indexed), offset, Bytes.asSlice(&List<Bytes>.asSlice(&segments)[0]))
    }
    return Option<Written>.some(Written.TypePath { span: span, segments: move segments, binder: move binder })
  }
  let mut chosen = usize.MAX
  let mut width = usize.MAX
  let mut at = usize.ZERO
  while at < declarations.length {
    if let Option<Span>.Some { value: block } = move bodyBlock(hir, declarations[at].local) {
      if block.start <= offset && offset < block.end && block.end - block.start < width {
        chosen = at
        width = block.end - block.start
      }
    }
    at = at + usize.ONE
  }
  if chosen == usize.MAX {
    return Option<Written>.none()
  }
  return Option<Written>.some(
    Written.InBody {
      span: span,
      identity: DeclarationId.copy(&declarations[chosen].identity),
      declaration: chosen,
      unbound: run unboundIdentifier(hir, name),
      pattern: patternBinderOf(hir, name),
      qualified: run qualifiedMember(hir, name),
    }
  )
}

// The path `Qualifier.member` when `name` is the member of a field expression whose subject is an
// identifier no lexical binder holds; empty otherwise. The arena is postorder.
effect fn qualifiedMember(hir: &Module, name: HirId) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut segments = List<Bytes>.make()
  let count = Module.length(hir)
  let mut at = name.index + usize.ONE
  while at < count {
    if let Node.FieldExpression { subject, field } = Module.node(hir, HirId { index: at }) {
      if field.index == name.index {
        if let Node.IdentifierExpression { name: qualifier, binding } = Module.node(hir, subject) {
          if !binding.present {
            if let Node.Name { text } = Module.node(hir, qualifier) {
              run List<Bytes>.append(&mut segments, run Bytes.copy(Module.text(hir, text)))
            }
            if let Node.Name { text } = Module.node(hir, name) {
              run List<Bytes>.append(&mut segments, run Bytes.copy(Module.text(hir, text)))
            }
          }
        }
        return move segments
      }
    }
    at = at + usize.ONE
  }
  return move segments
}

// The binder that the identifier expression written with `name` reads, when it reads one.
// The arena is postorder, so the expression comes after its name.
fn patternBinderOf(hir: &Module, name: HirId) -> Option<PatternBinder> {
  let count = Module.length(hir)
  let mut at = name.index + usize.ONE
  while at < count {
    if let Node.IdentifierExpression { name: written, binding } = Module.node(hir, HirId { index: at }) {
      if written.index == name.index {
        if binding.present {
          let mut bound = Option<HirId>.none()
          match Module.node(hir, binding.id) {
            Node.BindingPattern { name: binder, .. } => {
              bound = Option<HirId>.some(binder)
            }
            Node.Parameter { name: binder, .. } => {
              bound = Option<HirId>.some(binder)
            }
            Node.BindingStatement { name: binder, .. } => {
              bound = Option<HirId>.some(binder)
            }
            _ => ()
          }
          if let Option<HirId>.Some { value } = move bound {
            return Option<PatternBinder>.some(PatternBinder { node: binding.id, name: Module.span(hir, value) })
          }
        }
        return Option<PatternBinder>.none()
      }
    }
    at = at + usize.ONE
  }
  return Option<PatternBinder>.none()
}

// The spelling of `name` when it is an identifier expression with no lexical binder. The arena
// is postorder, so the expression comes after its name.
effect fn unboundIdentifier(hir: &Module, name: HirId) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let count = Module.length(hir)
  let mut at = name.index + usize.ONE
  while at < count {
    if let Node.IdentifierExpression { name: written, binding } = Module.node(hir, HirId { index: at }) {
      if written.index == name.index {
        if binding.present {
          return Option<Bytes>.none()
        }
        if let Node.Name { text } = Module.node(hir, name) {
          return Option<Bytes>.some(run Bytes.copy(Module.text(hir, text)))
        }
        return Option<Bytes>.none()
      }
    }
    at = at + usize.ONE
  }
  return Option<Bytes>.none()
}

// The import that writes `name`, when one does. Any segment of the module path names the whole
// path's module.
fn importAt(hir: &Module, declarations: &[IndexedDeclaration], name: HirId) -> Option<Written> {
  let mut at = usize.ZERO
  while at < declarations.length {
    if let Node.ImportHeader { path, alias, members, .. } = Module.node(hir, declarations[at].header) {
      if alias.present && alias.id.index == name.index {
        return Option<Written>.some(Written.Import { span: Module.span(hir, name), declaration: at, member: Option<usize>.none() })
      }
      if let Node.Path { segments } = Module.node(hir, path) {
        if holds(hir, segments, name) {
          return Option<Written>.some(Written.Import { span: Module.span(hir, path), declaration: at, member: Option<usize>.none() })
        }
      }
      if members.present {
        let mut ordinal = usize.ZERO
        while ordinal < members.range.length {
          if let Node.ImportMember { name: member, alias: renamed } = Module.node(hir, Module.child(hir, members.range, ordinal)) {
            if member.index == name.index || (renamed.present && renamed.id.index == name.index) {
              return Option<Written>.some(
                Written.Import { span: Module.span(hir, name), declaration: at, member: Option<usize>.some(ordinal) }
              )
            }
          }
          ordinal = ordinal + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return Option<Written>.none()
}

// The innermost `Name` node whose span holds `offset`, end inclusive so a cursor just after a
// name still names it.
fn innermostName(hir: &Module, offset: usize) -> Option<HirId> {
  let mut found = Option<HirId>.none()
  let mut width = usize.MAX
  let mut at = usize.ZERO
  let count = Module.length(hir)
  while at < count {
    let id = HirId { index: at }
    if let Node.Name { .. } = Module.node(hir, id) {
      let span = Module.span(hir, id)
      if span.start <= offset && offset <= span.end && span.end - span.start < width {
        found = Option<HirId>.some(id)
        width = span.end - span.start
      }
    }
    at = at + usize.ONE
  }
  return move found
}

// The segments of the path that names a type, when `name` is one of them. The arena is
// postorder, so a node's parent comes after it.
fn typePath(hir: &Module, name: HirId) -> Option<Range> {
  let count = Module.length(hir)
  let mut at = name.index + usize.ONE
  while at < count {
    if let Node.Path { segments } = Module.node(hir, HirId { index: at }) {
      if holds(hir, segments, name) {
        let path = HirId { index: at }
        let mut parent = at + usize.ONE
        while parent < count {
          if let Node.NamedType { path: named, .. } = Module.node(hir, HirId { index: parent }) {
            if named.index == path.index {
              return Option<Range>.some(segments)
            }
          }
          parent = parent + usize.ONE
        }
        return Option<Range>.none()
      }
    }
    at = at + usize.ONE
  }
  return Option<Range>.none()
}

fn holds(hir: &Module, range: Range, id: HirId) -> bool {
  let mut at = usize.ZERO
  while at < range.length {
    if Module.child(hir, range, at).index == id.index {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// The binder of a generic parameter named `name` that an enclosing declaration of `offset`
// writes, innermost first.
fn genericBinder(hir: &Module, index: &ModuleIndex, offset: usize, name: &[u8]) -> Option<Span> {
  let declarations = ModuleIndex.listDeclarations(index)
  let mut found = Option<Span>.none()
  let mut width = usize.MAX
  let mut at = usize.ZERO
  while at < declarations.length {
    let local = declarations[at].local
    let span = Module.span(hir, local)
    if span.start <= offset && offset <= span.end && span.end - span.start < width {
      if let Option<HirId>.Some { value: first } = move Module.declarationStart(hir, local) {
        let mut node = first.index
        while node < local.index {
          if let Node.TypeParameter { name: binder, .. } = Module.node(hir, HirId { index: node }) {
            if let Node.Name { text } = Module.node(hir, binder) {
              if same(Module.text(hir, text), name) {
                found = Option<Span>.some(Module.span(hir, binder))
                width = span.end - span.start
              }
            }
          }
          node = node + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return move found
}

// The span of a callable declaration's or closure's body block; absent for any other declaration.
fn bodyBlock(hir: &Module, declaration: HirId) -> Option<Span> {
  if let Node.CallableExpression { body, .. } = Module.node(hir, declaration) {
    if let Node.Block { .. } = Module.node(hir, body) {
      return Option<Span>.some(Module.span(hir, body))
    }
    return Option<Span>.none()
  }
  if let Node.Declaration { body, .. } = Module.node(hir, declaration) {
    if let Node.CallableBody { block } = Module.node(hir, body) {
      if block.present {
        return Option<Span>.some(Module.span(hir, block.id))
      }
    }
  }
  return Option<Span>.none()
}

// Resolves a written path segment by segment, as language lookup does from `module`.
effect fn pathTarget<'s>(port: &mut StaticPort<'s>, module: &ModuleId, segments: &[Bytes]) -> Option<Named>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  if segments.length == usize.ZERO {
    return Option<Named>.none()
  }
  let mut named = match move run StaticPort.documentationBinding(&mut port.*, module, Bytes.asSlice(&segments[0]), false) {
    Result<Option<DocumentationBinding>, Shared<Rejection>>.Success { value: Option<DocumentationBinding>.Some { value } } => move value
    _ => {
      return Option<Named>.none()
    }
  }
  let mut at = usize.ONE
  while at < segments.length {
    let next = match move named {
      DocumentationBinding.Namespace { module: namespace, .. } => run namespaceMember(&mut port.*, &namespace, Bytes.asSlice(&segments[at]))
      DocumentationBinding.Declaration { identity, .. } => run declarationMember(&mut port.*, &identity, Bytes.asSlice(&segments[at]))
    }
    named = match move next {
      Option<DocumentationBinding>.Some { value } => move value
      Option<DocumentationBinding>.None => {
        return Option<Named>.none()
      }
    }
    at = at + usize.ONE
  }
  return match move named {
    DocumentationBinding.Declaration { identity, .. } => Option<Named>.some(Named.Declaration { identity: move identity })
    DocumentationBinding.Namespace { module: namespace, .. } => Option<Named>.some(Named.Namespace { module: move namespace })
  }
}

// A public declaration of the module `namespace` names.
effect fn namespaceMember<'s>(port: &mut StaticPort<'s>, namespace: &ModuleId, name: &[u8]) -> Option<DocumentationBinding>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  if let Result<Option<DocumentationBinding>, Shared<Rejection>>.Success { value } = move run StaticPort.documentationBinding(
    &mut port.*,
    namespace,
    name,
    true
  ) {
    return move value
  }
  return Option<DocumentationBinding>.none()
}

// An inherent member of the declaration `owner`, as `make` in `List.make`.
effect fn declarationMember<'s>(port: &mut StaticPort<'s>, owner: &DeclarationId, name: &[u8]) -> Option<DocumentationBinding>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let spelling = run DeclarationId.copySpelling(owner)
  let member = run StaticPort.documentationMember(&mut port.*, DeclarationId.moduleId(owner), Bytes.asSlice(&spelling), name)
  if let Result<Option<DeclarationId>, Shared<Rejection>>.Success { value: Option<DeclarationId>.Some { value } } = move member {
    return Option<DocumentationBinding>.some(DocumentationBinding.Declaration { identity: move value, isPublic: true })
  }
  return Option<DocumentationBinding>.none()
}

// Reads a body name from the resolution table of the checked body that holds it.
effect fn bodyName<'s>(
  port: &mut StaticPort<'s>,
  cursor: &AuthoredCursor,
  span: Span,
  identity: &DeclarationId,
  declaration: usize,
  offset: usize,
) -> Option<NameAt>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let answer = match move run StaticPort.demandBody(&mut port.*, identity, span) {
    Option<Shared<Result<Answer, NoRejection>>>.Some { value } => move value
    Option<Shared<Result<Answer, NoRejection>>>.None => {
      return Option<NameAt>.none()
    }
  }
  let body = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&answer, checkedBody) {
    Option<Shared<TypedBody>>.Some { value } => move value
    Option<Shared<TypedBody>>.None => {
      return Option<NameAt>.none()
    }
  }
  let anchor = match move anchorOf(&port.*, cursor, declaration) {
    Option<Anchor>.Some { value } => move value
    Option<Anchor>.None => {
      return Option<NameAt>.none()
    }
  }
  return Shared<TypedBody>.with<Option<NameAt>>(&body, fn(checked: &TypedBody) -> Option<NameAt> {
    return tableName(checked, &anchor, offset)
  })
}

fn anchorOf<'s>(port: &StaticPort<'s>, cursor: &AuthoredCursor, declaration: usize) -> Option<Anchor> {
  if let Option<&IndexedSource>.Some { value } = move StaticPort.sourceAtCursor(port, cursor) {
    return IndexedSource.anchorOf(value, declaration)
  }
  return Option<Anchor>.none()
}

// The narrowest table entry whose name holds `offset`.
fn tableName(body: &TypedBody, anchor: &Anchor, offset: usize) -> Option<NameAt> {
  let table = TypedBody.resolutionSlice(body)
  let mut chosen = usize.MAX
  let mut width = usize.MAX
  let mut at = usize.ZERO
  while at < table.length {
    let span = Anchor.span(anchor, table[at].origin.location)
    if span.start <= offset && offset <= span.end && span.end - span.start < width {
      chosen = at
      width = span.end - span.start
    }
    at = at + usize.ONE
  }
  if chosen == usize.MAX {
    return Option<NameAt>.none()
  }
  let span = Anchor.span(anchor, table[chosen].origin.location)
  let locals = TypedBody.localSlice(body)
  return match &table[chosen].referent {
    Referent.Declaration { declaration } => Option<NameAt>.some(NameAt { span: span, named: Named.Declaration {
      identity: Shared<DeclarationId>.with<DeclarationId>(&declaration, DeclarationId.copy),
    } })
    Referent.Local { local } => localName(span, locals, local.index, anchor)
    Referent.Field { owner, index } => Option<NameAt>.some(NameAt { span: span, named: Named.Field { owner: Shared<Type>.clone(&owner), index: index } })
    Referent.Type { .. } => Option<NameAt>.none()
  }
}

fn localName(span: Span, locals: &[Local], index: usize, anchor: &Anchor) -> Option<NameAt> {
  if index < locals.length {
    return Option<NameAt>.some(NameAt { span: span, named: Named.Local {
      binder: Anchor.span(anchor, locals[index].origin.location),
      ty: Shared<Type>.clone(&locals[index].ty),
    } })
  }
  return Option<NameAt>.none()
}

// A body that failed some statements still answers for the ones it checked.
fn checkedBody(answer: &Result<Answer, NoRejection>) -> Option<Shared<TypedBody>> {
  if let Result<Answer, NoRejection>.Success { value } = &answer.* {
    if let Outcome.Success { value: Value.Body { body } } = &value.outcome {
      return Option<Shared<TypedBody>>.some(Shared<TypedBody>.clone(&body))
    }
    if let Outcome.Rejected { partial: Option<Shared<TypedBody>>.Some { value: body }, .. } = &value.outcome {
      return Option<Shared<TypedBody>>.some(Shared<TypedBody>.clone(&body))
    }
    if let Outcome.Unavailable { partial: Option<Shared<TypedBody>>.Some { value: body }, .. } = &value.outcome {
      return Option<Shared<TypedBody>>.some(Shared<TypedBody>.clone(&body))
    }
  }
  return Option<Shared<TypedBody>>.none()
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// Where a declaration is written and what its header says.
pub struct Site {
  pub module: ModuleId,
  /// The declaration's name in its module.
  pub name: Span,
  /// The header as written.
  pub header: Bytes,
  /// Where the header starts in its module.
  pub headerStart: usize,
  /// The written parameters, in order, as spans in the module.
  pub parameters: List<Span>,
  /// The doc comment the source attached, empty when it has none.
  pub documentation: Bytes,
  /// The module's text, which the spans index.
  pub text: Bytes,
}

/// Where `identity` is written in the store's current source, and its header.
pub effect fn site(store: &mut Semantic, identity: &DeclarationId) -> Option<Site>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  let module = DeclarationId.moduleId(identity)
  let cursor = match move run StaticPort.authoredCursor(&mut port, module) {
    Option<AuthoredCursor>.Some { value } => move value
    Option<AuthoredCursor>.None => {
      return Option<Site>.none()
    }
  }
  let indexed = match move StaticPort.sourceAtCursor(&port, &cursor) {
    Option<&IndexedSource>.Some { value } => value
    Option<&IndexedSource>.None => {
      return Option<Site>.none()
    }
  }
  let hir = IndexedSource.authored(indexed)
  let text = SourceUnit.bytes(IndexedSource.sourceUnit(indexed))
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
  let mut at = usize.ZERO
  while at < declarations.length {
    if DeclarationId.equals(&declarations[at].identity, identity) {
      let local = declarations[at].local
      if let Node.Declaration { header, documentation, .. } = Module.node(hir, local) {
        let spelling = run DeclarationId.copySpelling(identity)
        let first = match move Module.declarationStart(hir, local) {
          Option<HirId>.Some { value } => value
          Option<HirId>.None => header
        }
        let headerSpan = Module.span(hir, header)
        let mut name = headerSpan
        let mut parameters = List<Span>.make()
        let mut named = false
        let mut node = first.index
        while node <= header.index {
          let id = HirId { index: node }
          match Module.node(hir, id) {
            Node.Name { text: written } => {
              if !named && same(Module.text(hir, written), Bytes.asSlice(&spelling)) {
                name = Module.span(hir, id)
                named = true
              }
            }
            Node.Parameter { .. } => run List<Span>.append(&mut parameters, Module.span(hir, id))
            _ => ()
          }
          node = node + usize.ONE
        }
        let mut doc = Bytes.make()
        if documentation.present {
          doc = run commentText(Module.text(hir, documentation.symbol))
        }
        // A callable's header ends where its body block starts.
        let mut end = headerSpan.end
        if let Option<Span>.Some { value: block } = move bodyBlock(hir, local) {
          if block.start < end {
            end = block.start
          }
        }
        if end > text.length {
          end = text.length
        }
        while end > headerSpan.start && (text[end - usize.ONE] == 32 || text[end - usize.ONE] == 10 || text[end - usize.ONE] == 9 || text[end - usize.ONE] == 13) {
          end = end - usize.ONE
        }
        return Option<Site>.some(Site {
          module: ModuleId.copy(module),
          name: name,
          header: run Bytes.copy(Slice.view<u8>(text, headerSpan.start, end - headerSpan.start)),
          headerStart: headerSpan.start,
          parameters: move parameters,
          documentation: move doc,
          text: run Bytes.copy(text),
        })
      }
    }
    at = at + usize.ONE
  }
  return Option<Site>.none()
}

/// The declaration whose own name is written at `offset` in `module`, as a cursor on a
/// declaration's name sees it; absent elsewhere.
pub effect fn declaredAt(store: &mut Semantic, module: &ModuleId, offset: usize) -> Option<NameAt>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  let cursor = match move run StaticPort.authoredCursor(&mut port, module) {
    Option<AuthoredCursor>.Some { value } => move value
    Option<AuthoredCursor>.None => {
      return Option<NameAt>.none()
    }
  }
  let indexed = match move StaticPort.sourceAtCursor(&port, &cursor) {
    Option<&IndexedSource>.Some { value } => value
    Option<&IndexedSource>.None => {
      return Option<NameAt>.none()
    }
  }
  let hir = IndexedSource.authored(indexed)
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
  let mut at = usize.ZERO
  while at < declarations.length {
    if let Option<Span>.Some { value: name } = move run declarationName(hir, &declarations[at]) {
      if name.start <= offset && offset <= name.end {
        return Option<NameAt>.some(NameAt {
          span: name,
          named: Named.Declaration { identity: DeclarationId.copy(&declarations[at].identity) },
        })
      }
    }
    at = at + usize.ONE
  }
  return Option<NameAt>.none()
}

/// A written directive, `@` through its name, and the table entry it names.
pub struct DirectiveAt {
  pub span: Span,
  pub kind: Kind,
}

/// The directive whose `@` or name holds `offset` in `module`; absent off a directive and for a
/// name the directive table does not know.
pub effect fn directiveAt(store: &mut Semantic, module: &ModuleId, offset: usize) -> Option<DirectiveAt>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  let cursor = match move run StaticPort.authoredCursor(&mut port, module) {
    Option<AuthoredCursor>.Some { value } => move value
    Option<AuthoredCursor>.None => {
      return Option<DirectiveAt>.none()
    }
  }
  let indexed = match move StaticPort.sourceAtCursor(&port, &cursor) {
    Option<&IndexedSource>.Some { value } => value
    Option<&IndexedSource>.None => {
      return Option<DirectiveAt>.none()
    }
  }
  let hir = IndexedSource.authored(indexed)
  let mut at = usize.ZERO
  while at < Module.length(hir) {
    let id = HirId { index: at }
    if let Node.Directive { name, .. } = Module.node(hir, id) {
      let start = Module.span(hir, id).start
      let end = Module.span(hir, name).end
      if start <= offset && offset <= end {
        if let Option<Kind>.Some { value } = Directive.kindOf(hir, id) {
          return Option<DirectiveAt>.some(DirectiveAt { span: Span.make(start, end), kind: value })
        }
        return Option<DirectiveAt>.none()
      }
    }
    at = at + usize.ONE
  }
  return Option<DirectiveAt>.none()
}

/// The span of the name `declared` is written with in `hir`; absent for an import, an `impl`, an
/// unnamed declaration and damage, whose headers write no name of their own.
pub effect fn declarationName(hir: &Module, declared: &IndexedDeclaration) -> Option<Span>
  ! OutOfMemoryError
  ? &mut Allocator {
  let named = match DeclarationId.kind(&declared.identity) {
    OwnerKind.Import => false
    OwnerKind.Conditional => false
    OwnerKind.Implementation => false
    OwnerKind.Anonymous => false
    OwnerKind.EffectBlock => false
    OwnerKind.Damaged => false
    _ => true
  }
  if !named {
    return Option<Span>.none()
  }
  let spelling = run DeclarationId.copySpelling(&declared.identity)
  if Bytes.length(&spelling) == usize.ZERO {
    return Option<Span>.none()
  }
  if let Node.Declaration { header, .. } = Module.node(hir, declared.local) {
    let first = match move Module.declarationStart(hir, declared.local) {
      Option<HirId>.Some { value } => value
      Option<HirId>.None => header
    }
    let mut node = first.index
    while node <= header.index {
      let id = HirId { index: node }
      if let Node.Name { text } = Module.node(hir, id) {
        if same(Module.text(hir, text), Bytes.asSlice(&spelling)) {
          return Option<Span>.some(Module.span(hir, id))
        }
      }
      node = node + usize.ONE
    }
  }
  return Option<Span>.none()
}

/// What a name says about itself where it is written, when no use resolves it and it is no
/// declaration's own name.
pub union Introduced {
  /// The binder of a parameter or binding: the local's type.
  Local { pub ty: Shared<Type> },
  /// A field, enum case or union variant a type declares, written as `written` in `module`.
  Member { pub module: ModuleId, pub written: Span },
  /// A declaration a pattern's path names, as `Payment` in `Payment.Cash`.
  Declaration { pub identity: DeclarationId },
  /// A binder whose body has no checked table, as in a generic static function whose static work
  /// waits for an instance: how the binder is written, at `written`.
  Written { pub written: Span },
  /// A generic parameter where its declaration writes it.
  TypeParameter,
  /// A type the compiler provides, as `Intrinsic.StaticSequence`, spelled `spelling`, and the
  /// standard-library module that documents it, when one does.
  Intrinsic { pub spelling: Bytes, pub module: Option<ModuleId> },
  /// A key of a record literal: its value's type.
  Key { pub ty: Shared<Type> },
  /// A primitive type, and the standard-library module that declares its operations.
  Primitive { pub module: ModuleId },
}

/// A written name and what it introduces.
pub struct IntroducedAt {
  /// The name's span in its module.
  pub span: Span,
  pub introduced: Introduced,
}

/// What the name at `offset` of `module` introduces: a local's binder, a member a type declares,
/// a record key or a primitive type; absent for any other name.
pub effect fn introducedAt(store: &mut Semantic, module: &ModuleId, offset: usize) -> Option<IntroducedAt>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  let cursor = match move run StaticPort.authoredCursor(&mut port, module) {
    Option<AuthoredCursor>.Some { value } => move value
    Option<AuthoredCursor>.None => {
      return Option<IntroducedAt>.none()
    }
  }
  let indexed = match move StaticPort.sourceAtCursor(&port, &cursor) {
    Option<&IndexedSource>.Some { value } => value
    Option<&IndexedSource>.None => {
      return Option<IntroducedAt>.none()
    }
  }
  let hir = IndexedSource.authored(indexed)
  let name = match move innermostName(hir, offset) {
    Option<HirId>.Some { value } => value
    Option<HirId>.None => {
      return Option<IntroducedAt>.none()
    }
  }
  let span = Module.span(hir, name)
  // A variant or enum case a pattern names, as `Card` in `Payment.Card { limit }`, or a type
  // the pattern's path names on the way to it.
  if let Option<PatternPath>.Some { value: written } = move run patternPath(hir, name) {
    let segments = List<Bytes>.asSlice(&written.segments)
    if written.member {
      let owner = Slice.view<Bytes>(segments, usize.ZERO, segments.length - usize.ONE)
      if let Option<Named>.Some { value: Named.Declaration { identity } } = move run pathTarget(&mut port, module, owner) {
        if let Option<Span>.Some { value: case } = move run structural(&mut port, &identity, Bytes.asSlice(&segments[segments.length - usize.ONE]), true) {
          return Option<IntroducedAt>.some(IntroducedAt {
            span: span,
            introduced: Introduced.Member { module: ModuleId.copy(DeclarationId.moduleId(&identity)), written: case },
          })
        }
      }
      return Option<IntroducedAt>.none()
    }
    if let Option<Named>.Some { value: Named.Declaration { identity } } = move run pathTarget(&mut port, module, segments) {
      return Option<IntroducedAt>.some(IntroducedAt { span: span, introduced: Introduced.Declaration { identity: move identity } })
    }
    return Option<IntroducedAt>.none()
  }
  if let Option<Range>.Some { value: path } = move typePath(hir, name) {
    if path.length == usize.ONE {
      if let Node.Name { text } = Module.node(hir, name) {
        let spelled = Module.text(hir, text)
        if primitiveName(spelled) {
          let mut written = run Bytes.copy(b"silk/")
          run Bytes.append(&mut written, spelled)
          run Bytes.append(&mut written, b".silk")
          let home = run StaticPort.standardModule(&port, module, Bytes.asSlice(&written))
          return Option<IntroducedAt>.some(IntroducedAt { span: span, introduced: Introduced.Primitive { module: move home } })
        }
      }
    }
    // A type the compiler provides, as `Intrinsic.StaticSequence<T>`, has no declaration to show.
    if FieldSyntax.sealedTypeName(hir, path) {
      let mut spelling = run Bytes.copy(b"Intrinsic.")
      let mut home = Option<ModuleId>.none()
      if let Node.Name { text } = Module.node(hir, Module.child(hir, path, usize.ONE)) {
        let family = Module.text(hir, text)
        run Bytes.append(&mut spelling, family)
        if same(family, b"StaticSequence") {
          home = Option<ModuleId>.some(run StaticPort.standardModule(&port, module, b"silk/core/static_sequence.silk"))
        }
        if same(family, b"Type") || same(family, b"Field") || same(family, b"Fields") || same(family, b"Variant") ||
          same(family, b"Variants") {
          home = Option<ModuleId>.some(run StaticPort.standardModule(&port, module, b"silk/core/reflect.silk"))
        }
      }
      return Option<IntroducedAt>.some(IntroducedAt { span: span, introduced: Introduced.Intrinsic { spelling: move spelling, module: move home } })
    }
    return Option<IntroducedAt>.none()
  }
  // The arena is postorder, so the node that writes the name comes after it.
  let count = Module.length(hir)
  let mut writer = Writer.Other
  let mut writing = span
  let mut binderName = span
  let mut searching = true
  let mut at = name.index + usize.ONE
  while at < count && searching {
    let id = HirId { index: at }
    writer = writerOf(hir, id, name)
    match &writer {
      Writer.Key { value } => {
        writing = Module.span(hir, value)
        searching = false
      }
      Writer.Binder { node } => {
        writing = binderWritten(hir, node)
        searching = false
      }
      Writer.Read { binder } => {
        writing = binderWritten(hir, binder)
        binderName = binderNameSpan(hir, binder)
        searching = false
      }
      Writer.Other => ()
      _ => {
        writing = Module.span(hir, id)
        searching = false
      }
    }
    at = at + usize.ONE
  }
  return match move writer {
    Writer.Member => Option<IntroducedAt>.some(IntroducedAt { span: span, introduced: Introduced.Member { module: ModuleId.copy(module), written: writing } })
    Writer.Binder { node } => run boundAt(&mut port, &cursor, span, span, node, writing)
    Writer.Read { binder } => run boundAt(&mut port, &cursor, span, binderName, binder, writing)
    Writer.TypeParameter => Option<IntroducedAt>.some(IntroducedAt { span: span, introduced: Introduced.TypeParameter })
    Writer.Key { .. } => match move run typeOver(&mut port, &cursor, writing) {
      Option<Typed>.Some { value: typed } => Option<IntroducedAt>.some(IntroducedAt { span: span, introduced: Introduced.Key { ty: move typed.ty } })
      Option<Typed>.None => Option<IntroducedAt>.none()
    }
    Writer.Other => Option<IntroducedAt>.none()
  }
}

// How a node writes `name`: as a member a type declares, a local's binder, a record key whose
// value is `value`, or not at all.
union Writer {
  Member,
  Binder { node: HirId },
  Read { binder: HirId },
  TypeParameter,
  Key { value: HirId },
  Other,
}

fn writerOf(hir: &Module, id: HirId, name: HirId) -> Writer {
  match Module.node(hir, id) {
    Node.Field { name: written, .. } => {
      if written.index == name.index {
        return Writer.Member
      }
    }
    Node.EnumMember { name: written, .. } => {
      if written.index == name.index {
        return Writer.Member
      }
    }
    Node.Variant { name: written, .. } => {
      if written.index == name.index {
        return Writer.Member
      }
    }
    Node.Parameter { name: written, .. } => {
      if written.index == name.index {
        return Writer.Binder { node: id }
      }
    }
    Node.StaticForStatement { binding, .. } => {
      if binding.index == name.index {
        return Writer.Binder { node: binding }
      }
    }
    Node.TypeParameter { name: written, .. } => {
      if written.index == name.index {
        return Writer.TypeParameter
      }
    }
    Node.IdentifierExpression { name: written, binding } => {
      if written.index == name.index && binding.present {
        return Writer.Read { binder: binding.id }
      }
    }
    Node.BindingStatement { name: written, .. } => {
      if written.index == name.index {
        return Writer.Binder { node: id }
      }
    }
    Node.BindingPattern { name: written, .. } => {
      if written.index == name.index {
        return Writer.Binder { node: id }
      }
    }
    // A shorthand field pattern, `{ limit }`, writes its name once for the field and the binder.
    Node.PatternField { name: written, pattern } => {
      if written.index == name.index {
        if let Node.BindingPattern { .. } = Module.node(hir, pattern) {
          return Writer.Binder { node: pattern }
        }
      }
    }
    Node.FieldInitializer { name: written, value } => {
      if written.index == name.index {
        return Writer.Key { value: value }
      }
    }
    _ => ()
  }
  return Writer.Other
}

// The path a pattern writes to select a case, through `name`, and whether `name` is the case.
struct PatternPath {
  segments: List<Bytes>,
  member: bool,
}

// The pattern path `name` is written in: the selector of a variant pattern, `Payment.Card`, or
// the path of an enum pattern, `Color.Red`. The arena is postorder, so a parent comes after its
// children.
effect fn patternPath(hir: &Module, name: HirId) -> Option<PatternPath> ! OutOfMemoryError ? &mut Allocator {
  let count = Module.length(hir)
  let mut at = name.index + usize.ONE
  while at < count {
    let id = HirId { index: at }
    match Module.node(hir, id) {
      Node.MemberSelector { subject, member } => {
        if member.index == name.index {
          if !selectsVariant(hir, id) {
            return Option<PatternPath>.none()
          }
          let mut segments = List<Bytes>.make()
          if let Node.NamedType { path, .. } = Module.node(hir, subject) {
            if let Node.Path { segments: written } = Module.node(hir, path) {
              run appendSegments(hir, written, written.length, &mut segments)
            }
          }
          if List<Bytes>.length(&segments) == usize.ZERO {
            return Option<PatternPath>.none()
          }
          if let Node.Name { text } = Module.node(hir, name) {
            run List<Bytes>.append(&mut segments, run Bytes.copy(Module.text(hir, text)))
          }
          return Option<PatternPath>.some(PatternPath { segments: move segments, member: true })
        }
      }
      Node.Path { segments: written } => {
        if holds(hir, written, name) {
          if !namesEnumPattern(hir, id) && !namesVariantPattern(hir, id) {
            return Option<PatternPath>.none()
          }
          let mut through = usize.ZERO
          while Module.child(hir, written, through).index != name.index {
            through = through + usize.ONE
          }
          let mut segments = List<Bytes>.make()
          run appendSegments(hir, written, through + usize.ONE, &mut segments)
          let member = through + usize.ONE == written.length && written.length > usize.ONE
          return Option<PatternPath>.some(PatternPath { segments: move segments, member: member })
        }
      }
      _ => ()
    }
    at = at + usize.ONE
  }
  return Option<PatternPath>.none()
}

// Appends the spellings of the first `count` names of `range`.
effect fn appendSegments(hir: &Module, range: Range, count: usize, segments: &mut List<Bytes>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < count {
    if let Node.Name { text } = Module.node(hir, Module.child(hir, range, at)) {
      run List<Bytes>.append(&mut segments.*, run Bytes.copy(Module.text(hir, text)))
    }
    at = at + usize.ONE
  }
  return ()
}

// Whether the member selector `selector` is a variant pattern's.
fn selectsVariant(hir: &Module, selector: HirId) -> bool {
  let count = Module.length(hir)
  let mut at = selector.index + usize.ONE
  while at < count {
    if let Node.VariantPattern { selector: written, .. } = Module.node(hir, HirId { index: at }) {
      if written.index == selector.index {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Whether the path `path` names the type of a record pattern or of a variant pattern's selector,
// which can spell the variant too, as `Payment.Card` in `Payment.Card { limit }`.
fn namesVariantPattern(hir: &Module, path: HirId) -> bool {
  let count = Module.length(hir)
  let mut named = usize.MAX
  let mut at = path.index + usize.ONE
  while at < count {
    match Module.node(hir, HirId { index: at }) {
      Node.NamedType { path: written, .. } => {
        if written.index == path.index {
          named = at
        }
      }
      Node.MemberSelector { subject, .. } => {
        if named != usize.MAX && subject.index == named {
          return selectsVariant(hir, HirId { index: at })
        }
      }
      Node.NominalPattern { annotation, .. } => {
        if named != usize.MAX && annotation.index == named {
          return true
        }
      }
      _ => ()
    }
    at = at + usize.ONE
  }
  return false
}

// Whether the path `path` is an enum pattern's.
fn namesEnumPattern(hir: &Module, path: HirId) -> bool {
  let count = Module.length(hir)
  let mut at = path.index + usize.ONE
  while at < count {
    if let Node.EnumPattern { path: written } = Module.node(hir, HirId { index: at }) {
      if written.index == path.index {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Whether `name` spells a primitive type whose operations a `silk.<name>` module declares.
fn primitiveName(name: &[u8]) -> bool {
  return same(name, b"i8") || same(name, b"i16") || same(name, b"i32") || same(name, b"i64") || same(name, b"isize")
    || same(name, b"u8") || same(name, b"u16") || same(name, b"u32") || same(name, b"u64") || same(name, b"usize")
    || same(name, b"f32") || same(name, b"f64") || same(name, b"bool") || same(name, b"char") || same(name, b"string")
}

// What the binder `node`, whose name is at `name`, binds: its local, or else the type a match
// pattern binds there.
// What the binder `node`, whose name is at `name`, binds, for a hover at `at`: what `binderAt`
// finds, or else how the binder is written, at `written`, when its body has no checked table.
effect fn boundAt<'s>(port: &mut StaticPort<'s>, cursor: &AuthoredCursor, at: Span, name: Span, node: HirId, written: Span)
  -> Option<IntroducedAt>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  if let Option<IntroducedAt>.Some { value } = move run binderAt(&mut port.*, cursor, name, node) {
    return Option<IntroducedAt>.some(IntroducedAt { span: at, introduced: move value.introduced })
  }
  return Option<IntroducedAt>.some(IntroducedAt { span: at, introduced: Introduced.Written { written: written } })
}

// The name a binder node writes: a parameter's, a binding's or a pattern binder's name, or the
// node itself for a `static for` name.
fn binderNameSpan(hir: &Module, binder: HirId) -> Span {
  return match Module.node(hir, binder) {
    Node.Parameter { name, .. } => Module.span(hir, name)
    Node.BindingStatement { name, .. } => Module.span(hir, name)
    Node.BindingPattern { name, .. } => Module.span(hir, name)
    _ => Module.span(hir, binder)
  }
}

// How a binder is written: a parameter or pattern binder whole, a binding statement, or a
// `static for` header up to its body. A caller shows its first line.
fn binderWritten(hir: &Module, binder: HirId) -> Span {
  if let Node.Name { .. } = Module.node(hir, binder) {
    let count = Module.length(hir)
    let mut at = binder.index + usize.ONE
    while at < count {
      if let Node.StaticForStatement { binding, body, .. } = Module.node(hir, HirId { index: at }) {
        if binding.index == binder.index {
          return Span { start: Module.span(hir, HirId { index: at }).start, end: Module.span(hir, body).start }
        }
      }
      at = at + usize.ONE
    }
  }
  return Module.span(hir, binder)
}

effect fn binderAt<'s>(port: &mut StaticPort<'s>, cursor: &AuthoredCursor, name: Span, node: HirId) -> Option<IntroducedAt>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  if let Option<IntroducedAt>.Some { value } = move run localAt(&mut port.*, cursor, name) {
    return Option<IntroducedAt>.some(move value)
  }
  let enclosing = match move declarationAround(&port.*, cursor, name.start) {
    Option<Enclosing>.Some { value } => move value
    Option<Enclosing>.None => {
      return Option<IntroducedAt>.none()
    }
  }
  if let Option<Shared<Type>>.Some { value: ty } = move run patternType(&mut port.*, cursor, &enclosing, node) {
    return Option<IntroducedAt>.some(IntroducedAt { span: name, introduced: Introduced.Local { ty: move ty } })
  }
  return Option<IntroducedAt>.none()
}

// The type the match pattern binder `binder` binds in the checked body of `enclosing`.
effect fn patternType<'s>(port: &mut StaticPort<'s>, cursor: &AuthoredCursor, enclosing: &Enclosing, binder: HirId) -> Option<Shared<Type>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let body = match move run checked(&mut port.*, enclosing) {
    Option<Shared<TypedBody>>.Some { value } => move value
    Option<Shared<TypedBody>>.None => {
      return Option<Shared<Type>>.none()
    }
  }
  let anchor = match move anchorOf(&port.*, cursor, enclosing.ordinal) {
    Option<Anchor>.Some { value } => move value
    Option<Anchor>.None => {
      return Option<Shared<Type>>.none()
    }
  }
  return Shared<TypedBody>.with<Option<Shared<Type>>>(&body, fn(checked: &TypedBody) -> Option<Shared<Type>> {
    let nodes = TypedBody.nodeSlice(checked)
    let mut at = usize.ZERO
    while at < nodes.length {
      if let NodeKind.Expression { ty, form: Expression.PatternBinding { .. } } = &nodes[at].kind {
        if Anchor.hir(&anchor, nodes[at].origin.node).index == binder.index {
          return Option<Shared<Type>>.some(Shared<Type>.clone(&ty))
        }
      }
      at = at + usize.ONE
    }
    return Option<Shared<Type>>.none()
  })
}

// The local whose binder writes the name at `name`: the narrowest local of the body around it
// whose binder holds the name.
effect fn localAt<'s>(port: &mut StaticPort<'s>, cursor: &AuthoredCursor, name: Span) -> Option<IntroducedAt>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let enclosing = match move declarationAround(&port.*, cursor, name.start) {
    Option<Enclosing>.Some { value } => move value
    Option<Enclosing>.None => {
      return Option<IntroducedAt>.none()
    }
  }
  let body = match move run checked(&mut port.*, &enclosing) {
    Option<Shared<TypedBody>>.Some { value } => move value
    Option<Shared<TypedBody>>.None => {
      return Option<IntroducedAt>.none()
    }
  }
  let anchor = match move anchorOf(&port.*, cursor, enclosing.ordinal) {
    Option<Anchor>.Some { value } => move value
    Option<Anchor>.None => {
      return Option<IntroducedAt>.none()
    }
  }
  return Shared<TypedBody>.with<Option<IntroducedAt>>(&body, fn(checked: &TypedBody) -> Option<IntroducedAt> {
    let locals = TypedBody.localSlice(checked)
    let mut found = Option<IntroducedAt>.none()
    let mut width = usize.MAX
    let mut at = usize.ZERO
    while at < locals.length {
      let binder = Anchor.span(&anchor, locals[at].origin.location)
      if binder.start <= name.start && name.end <= binder.end && binder.end - binder.start < width {
        found = Option<IntroducedAt>.some(IntroducedAt { span: name, introduced: Introduced.Local { ty: Shared<Type>.clone(&locals[at].ty) } })
        width = binder.end - binder.start
      }
      at = at + usize.ONE
    }
    return move found
  })
}

// The type of the narrowest checked expression that holds all of `written`.
effect fn typeOver<'s>(port: &mut StaticPort<'s>, cursor: &AuthoredCursor, written: Span) -> Option<Typed>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let enclosing = match move enclosingBody(&port.*, cursor, written.start) {
    Option<Enclosing>.Some { value } => move value
    Option<Enclosing>.None => {
      return Option<Typed>.none()
    }
  }
  let body = match move run checked(&mut port.*, &enclosing) {
    Option<Shared<TypedBody>>.Some { value } => move value
    Option<Shared<TypedBody>>.None => {
      return Option<Typed>.none()
    }
  }
  let anchor = match move anchorOf(&port.*, cursor, enclosing.ordinal) {
    Option<Anchor>.Some { value } => move value
    Option<Anchor>.None => {
      return Option<Typed>.none()
    }
  }
  return Shared<TypedBody>.with<Option<Typed>>(&body, fn(checked: &TypedBody) -> Option<Typed> {
    let nodes = TypedBody.nodeSlice(checked)
    let mut found = Option<Typed>.none()
    let mut width = usize.MAX
    let mut at = usize.ZERO
    while at < nodes.length {
      if let NodeKind.Expression { ty, .. } = &nodes[at].kind {
        let span = Anchor.span(&anchor, nodes[at].origin.location)
        if span.start <= written.start && written.end <= span.end && span.end - span.start < width {
          found = Option<Typed>.some(Typed { span: span, ty: Shared<Type>.clone(&ty) })
          width = span.end - span.start
        }
      }
      at = at + usize.ONE
    }
    return move found
  })
}

/// What `name` means at the top level of `module`: its own declaration or the one an import
/// brings in.
pub effect fn scoped(store: &mut Semantic, module: &ModuleId, name: &[u8]) -> Option<Named>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut segments = List<Bytes>.make()
  run List<Bytes>.append(&mut segments, run Bytes.copy(name))
  return run pathNamed(&mut store.*, module, List<Bytes>.asSlice(&segments))
}

/// What the written path `segments` means at the top level of `module`, each segment a member of
/// what the one before it names.
pub effect fn pathNamed(store: &mut Semantic, module: &ModuleId, segments: &[Bytes]) -> Option<Named>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  return run pathTarget(&mut port, module, segments)
}

/// Where a doc comment's code link is written: a byte offset in `module`'s current text.
pub struct Place {
  pub module: ModuleId,
  pub offset: usize,
}

/// Where a doc comment's code link, such as [`FileSystem.providerCode`] or [`map`], leads when it
/// is written in `module` on a declaration whose `Self` is `owner`, resolved as the documentation
/// generator resolves it: `Self` or one of its members, a path at the module's top level, a case
/// or field of the type a path names, or else the one inherent member, and then the one case or
/// field, of the module's own types with that name.
pub effect fn documented(store: &mut Semantic, module: &ModuleId, owner: &Option<DeclarationId>, spelling: &[u8]) -> Option<Place>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut segments = List<Bytes>.make()
  let mut start = usize.ZERO
  let mut at = usize.ZERO
  while at <= spelling.length {
    if at == spelling.length || spelling[at] == 46 {
      if at == start {
        return Option<Place>.none()
      }
      run List<Bytes>.append(&mut segments, run Bytes.copy(Slice.view<u8>(spelling, start, at - start)))
      start = at + usize.ONE
    }
    at = at + usize.ONE
  }
  let written = List<Bytes>.asSlice(&segments)
  let last = Bytes.asSlice(&written[written.length - usize.ONE])
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  if let Option<DeclarationId>.Some { value: subject } = &owner.* {
    if same(Bytes.asSlice(&written[0]), b"Self") {
      if written.length == usize.ONE {
        return run placeOf(&mut port, &subject)
      }
      if written.length == 2 {
        return run memberPlace(&mut port, &subject, last)
      }
      return Option<Place>.none()
    }
    if written.length == usize.ONE {
      if let Option<Place>.Some { value } = move run memberPlace(&mut port, &subject, last) {
        return Option<Place>.some(move value)
      }
    }
  }
  match move run pathTarget(&mut port, module, written) {
    Option<Named>.Some { value: Named.Declaration { identity } } => {
      return run placeOf(&mut port, &identity)
    }
    Option<Named>.Some { value: Named.Namespace { module: space } } => {
      return Option<Place>.some(Place { module: move space, offset: usize.ZERO })
    }
    _ => ()
  }
  if written.length > usize.ONE {
    // A case or field of the type the path before it names.
    if let Option<Named>.Some { value: Named.Declaration { identity } } = move run pathTarget(
      &mut port,
      module,
      Slice.view<Bytes>(written, usize.ZERO, written.length - usize.ONE)
    ) {
      if let Option<Span>.Some { value } = move run structural(&mut port, &identity, last, false) {
        return Option<Place>.some(Place { module: ModuleId.copy(DeclarationId.moduleId(&identity)), offset: value.start })
      }
    }
    return Option<Place>.none()
  }
  let types = run moduleTypes(&mut port, module)
  let owners = List<DeclarationId>.asSlice(&types)
  let mut found = Option<Place>.none()
  let mut count = usize.ZERO
  at = usize.ZERO
  while at < owners.length {
    if let Option<DocumentationBinding>.Some { value: DocumentationBinding.Declaration { identity, .. } } = move run declarationMember(&mut port, &owners[at], last) {
      count = count + usize.ONE
      found = run placeOf(&mut port, &identity)
    }
    at = at + usize.ONE
  }
  if count == usize.ZERO {
    at = usize.ZERO
    while at < owners.length {
      if let Option<Span>.Some { value } = move run structural(&mut port, &owners[at], last, false) {
        count = count + usize.ONE
        found = Option<Place>.some(Place { module: ModuleId.copy(module), offset: value.start })
      }
      at = at + usize.ONE
    }
  }
  // Members of several types that share the name leave the link unresolved.
  if count != usize.ONE {
    return Option<Place>.none()
  }
  return move found
}

// Where `identity`'s name is written.
effect fn placeOf<'s>(port: &mut StaticPort<'s>, identity: &DeclarationId) -> Option<Place>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let module = DeclarationId.moduleId(identity)
  let cursor = match move run StaticPort.authoredCursor(&mut port.*, module) {
    Option<AuthoredCursor>.Some { value } => move value
    Option<AuthoredCursor>.None => {
      return Option<Place>.none()
    }
  }
  let indexed = match move StaticPort.sourceAtCursor(&port.*, &cursor) {
    Option<&IndexedSource>.Some { value } => value
    Option<&IndexedSource>.None => {
      return Option<Place>.none()
    }
  }
  let hir = IndexedSource.authored(indexed)
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
  let mut at = usize.ZERO
  while at < declarations.length {
    if DeclarationId.equals(&declarations[at].identity, identity) {
      let mut offset = Module.span(hir, declarations[at].local).start
      if let Option<Span>.Some { value } = move run declarationName(hir, &declarations[at]) {
        offset = value.start
      }
      return Option<Place>.some(Place { module: ModuleId.copy(module), offset: offset })
    }
    at = at + usize.ONE
  }
  return Option<Place>.none()
}

// Where `owner`'s inherent member, case or field `name` is written.
effect fn memberPlace<'s>(port: &mut StaticPort<'s>, owner: &DeclarationId, name: &[u8]) -> Option<Place>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  if let Option<DocumentationBinding>.Some { value: DocumentationBinding.Declaration { identity, .. } } = move run declarationMember(&mut port.*, owner, name) {
    return run placeOf(&mut port.*, &identity)
  }
  if let Option<Span>.Some { value } = move run structural(&mut port.*, owner, name, false) {
    return Option<Place>.some(Place { module: ModuleId.copy(DeclarationId.moduleId(owner)), offset: value.start })
  }
  return Option<Place>.none()
}

// Where the case or field `name` of the type `owner` declares is written: its name, or with
// `whole` the whole case or field.
effect fn structural<'s>(port: &mut StaticPort<'s>, owner: &DeclarationId, name: &[u8], whole: bool) -> Option<Span>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let cursor = match move run StaticPort.authoredCursor(&mut port.*, DeclarationId.moduleId(owner)) {
    Option<AuthoredCursor>.Some { value } => move value
    Option<AuthoredCursor>.None => {
      return Option<Span>.none()
    }
  }
  let indexed = match move StaticPort.sourceAtCursor(&port.*, &cursor) {
    Option<&IndexedSource>.Some { value } => value
    Option<&IndexedSource>.None => {
      return Option<Span>.none()
    }
  }
  let hir = IndexedSource.authored(indexed)
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
  let mut at = usize.ZERO
  while at < declarations.length {
    if DeclarationId.equals(&declarations[at].identity, owner) {
      let local = declarations[at].local
      let first = match move Module.declarationStart(hir, local) {
        Option<HirId>.Some { value } => value
        Option<HirId>.None => local
      }
      let mut node = first.index
      while node < local.index {
        let mut written = Option<HirId>.none()
        match Module.node(hir, HirId { index: node }) {
          Node.Variant { name: case, .. } => {
            written = Option<HirId>.some(case)
          }
          Node.EnumMember { name: case, .. } => {
            written = Option<HirId>.some(case)
          }
          Node.Field { name: field, .. } => {
            written = Option<HirId>.some(field)
          }
          _ => ()
        }
        if let Option<HirId>.Some { value } = move written {
          if let Node.Name { text } = Module.node(hir, value) {
            if same(Module.text(hir, text), name) {
              if whole {
                return Option<Span>.some(Module.span(hir, HirId { index: node }))
              }
              return Option<Span>.some(Module.span(hir, value))
            }
          }
        }
        node = node + usize.ONE
      }
      return Option<Span>.none()
    }
    at = at + usize.ONE
  }
  return Option<Span>.none()
}

// The struct, union, enum and interface declarations at the top level of `module`.
effect fn moduleTypes<'s>(port: &mut StaticPort<'s>, module: &ModuleId) -> List<DeclarationId>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut types = List<DeclarationId>.make()
  let cursor = match move run StaticPort.authoredCursor(&mut port.*, module) {
    Option<AuthoredCursor>.Some { value } => move value
    Option<AuthoredCursor>.None => {
      return move types
    }
  }
  if let Option<&IndexedSource>.Some { value: indexed } = move StaticPort.sourceAtCursor(&port.*, &cursor) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let mut at = usize.ZERO
    while at < declarations.length {
      if let Option<usize>.None = &declarations[at].parent {
        let kind = DeclarationId.kind(&declarations[at].identity)
        if kind == OwnerKind.Struct || kind == OwnerKind.Union || kind == OwnerKind.Enumeration || kind == OwnerKind.Interface {
          run List<DeclarationId>.append(&mut types, DeclarationId.copy(&declarations[at].identity))
        }
      }
      at = at + usize.ONE
    }
  }
  return move types
}

/// Whether `name` is a public declaration of `module`.
pub effect fn exported(store: &mut Semantic, module: &ModuleId, name: &[u8]) -> bool
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  if let Option<DocumentationBinding>.Some { .. } = move run namespaceMember(&mut port, module, name) {
    return true
  }
  return false
}

// A doc comment's text without its `///` markers: each line loses its leading blanks, the
// marker and one space after it.
effect fn commentText(written: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  let mut at = usize.ZERO
  while at < written.length {
    let mut end = at
    while end < written.length && written[end] != 10 {
      end = end + usize.ONE
    }
    let mut start = at
    while start < end && (written[start] == 32 || written[start] == 9) {
      start = start + usize.ONE
    }
    let mut slashes = usize.ZERO
    while start < end && slashes < 3 && written[start] == 47 {
      start = start + usize.ONE
      slashes = slashes + usize.ONE
    }
    if slashes == 3 && start < end && written[start] == 32 {
      start = start + usize.ONE
    }
    if slashes != 3 {
      start = at
    }
    if Bytes.length(&text) > usize.ZERO {
      run Bytes.append(&mut text, b"\n")
    }
    run Bytes.append(&mut text, Slice.view<u8>(written, start, end - start))
    at = end + usize.ONE
  }
  return move text
}

/// The type of the narrowest checked expression at an offset, and its span.
pub struct Typed {
  pub span: Span,
  pub ty: Shared<Type>,
}

/// The type of the narrowest checked expression at `offset` in `module`; absent outside a
/// checked body.
pub effect fn typeAt(store: &mut Semantic, module: &ModuleId, offset: usize) -> Option<Typed>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  let cursor = match move run StaticPort.authoredCursor(&mut port, module) {
    Option<AuthoredCursor>.Some { value } => move value
    Option<AuthoredCursor>.None => {
      return Option<Typed>.none()
    }
  }
  let enclosing = match move enclosingBody(&port, &cursor, offset) {
    Option<Enclosing>.Some { value } => move value
    Option<Enclosing>.None => {
      return Option<Typed>.none()
    }
  }
  let body = match move run checked(&mut port, &enclosing) {
    Option<Shared<TypedBody>>.Some { value } => move value
    Option<Shared<TypedBody>>.None => {
      return Option<Typed>.none()
    }
  }
  let anchor = match move anchorOf(&port, &cursor, enclosing.ordinal) {
    Option<Anchor>.Some { value } => move value
    Option<Anchor>.None => {
      return Option<Typed>.none()
    }
  }
  return Shared<TypedBody>.with<Option<Typed>>(&body, fn(checked: &TypedBody) -> Option<Typed> {
    let nodes = TypedBody.nodeSlice(checked)
    let mut found = Option<Typed>.none()
    let mut width = usize.MAX
    let mut at = usize.ZERO
    while at < nodes.length {
      if let NodeKind.Expression { ty, .. } = &nodes[at].kind {
        let span = Anchor.span(&anchor, nodes[at].origin.location)
        if span.start <= offset && offset <= span.end && span.end - span.start < width {
          found = Option<Typed>.some(Typed { span: span, ty: Shared<Type>.clone(&ty) })
          width = span.end - span.start
        }
      }
      at = at + usize.ONE
    }
    return move found
  })
}

/// A binding whose type the source left to inference: where its name ends and its type.
pub struct Inferred {
  pub end: usize,
  pub ty: Shared<Type>,
}

/// The bindings of `module`'s checked bodies whose types were inferred, in body order.
pub effect fn inferred(store: &mut Semantic, module: &ModuleId) -> List<Inferred>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut found = List<Inferred>.make()
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  let cursor = match move run StaticPort.authoredCursor(&mut port, module) {
    Option<AuthoredCursor>.Some { value } => move value
    Option<AuthoredCursor>.None => {
      return move found
    }
  }
  let bodies = run bodiesOf(&port, &cursor)
  let listed = List<Enclosing>.asSlice(&bodies)
  let mut at = usize.ZERO
  while at < listed.length {
    if let Option<Shared<TypedBody>>.Some { value: body } = move run checked(&mut port, &listed[at]) {
      if let Option<Anchor>.Some { value: anchor } = move anchorOf(&port, &cursor, listed[at].ordinal) {
        run appendInferred(&body, &anchor, listed[at].block, &mut found)
      }
    }
    at = at + usize.ONE
  }
  return move found
}

effect fn appendInferred(body: &Shared<TypedBody>, anchor: &Anchor, block: Span, found: &mut List<Inferred>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let count = Shared<TypedBody>.with<usize>(body, fn(checked: &TypedBody) -> usize {
    return TypedBody.localSlice(checked).length
  })
  let mut at = usize.ZERO
  while at < count {
    let entry = Shared<TypedBody>.with<Option<Typed>>(body, fn(checked: &TypedBody) -> Option<Typed> {
      let local = &TypedBody.localSlice(checked)[at]
      // A closure body's first local is its hidden environment, which the source never binds.
      let environment = at == usize.ZERO && Option<Environment>.isSome(TypedBody.environmentOf(checked))
      if local.written || environment {
        return Option<Typed>.none()
      }
      return Option<Typed>.some(Typed { span: Anchor.span(anchor, local.origin.location), ty: Shared<Type>.clone(&local.ty) })
    })
    if let Option<Typed>.Some { value } = move entry {
      if block.start <= value.span.start && value.span.end <= block.end {
        run List<Inferred>.append(&mut found.*, Inferred { end: value.span.end, ty: move value.ty })
      }
    }
    at = at + usize.ONE
  }
  return ()
}

/// The call whose arguments hold an offset: the declaration it calls, the argument the offset is
/// in, and whether a receiver fills the first parameter.
pub struct CallAt {
  pub identity: DeclarationId,
  pub active: usize,
  pub receiver: bool,
}

/// The innermost call in `module` whose argument list holds `offset`.
pub effect fn callAt(store: &mut Semantic, module: &ModuleId, offset: usize) -> Option<CallAt>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let syntax = match move run callSyntax(&mut store.*, module, offset) {
    Option<CallSyntax>.Some { value } => move value
    Option<CallSyntax>.None => {
      return Option<CallAt>.none()
    }
  }
  if let Option<NameAt>.Some { value: found } = move run at(&mut store.*, module, syntax.name) {
    if let Named.Declaration { identity } = move found.named {
      return Option<CallAt>.some(CallAt { identity: move identity, active: syntax.active, receiver: syntax.receiver })
    }
  }
  return Option<CallAt>.none()
}

struct CallSyntax {
  name: usize,
  active: usize,
  receiver: bool,
}



effect fn callSyntax(store: &mut Semantic, module: &ModuleId, offset: usize) -> Option<CallSyntax>
  ! Cycle | OutOfMemoryError
  ? &mut Allocator {
  let mut dependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut store.*, &mut dependencies)
  let cursor = match move run StaticPort.authoredCursor(&mut port, module) {
    Option<AuthoredCursor>.Some { value } => move value
    Option<AuthoredCursor>.None => {
      return Option<CallSyntax>.none()
    }
  }
  let hir = match move StaticPort.authoredAtCursor(&port, &cursor) {
    Option<&Module>.Some { value } => value
    Option<&Module>.None => {
      return Option<CallSyntax>.none()
    }
  }
  let mut found = Option<CallSyntax>.none()
  let mut width = usize.MAX
  let count = Module.length(hir)
  let mut at = usize.ZERO
  while at < count {
    let id = HirId { index: at }
    if let Node.CallExpression { callee, arguments, .. } = Module.node(hir, id) {
      let span = Module.span(hir, id)
      let calleeSpan = Module.span(hir, callee)
      if calleeSpan.end < offset && offset < span.end && span.end - span.start < width {
        let mut name = calleeSpan.start
        let mut receiver = false
        match Module.node(hir, callee) {
          Node.FieldExpression { subject, field } => {
            name = Module.span(hir, field).start
            receiver = true
            if let Node.IdentifierExpression { binding, .. } = Module.node(hir, subject) {
              receiver = binding.present
            }
          }
          Node.IdentifierExpression { name: written, .. } => {
            name = Module.span(hir, written).start
          }
          _ => ()
        }
        let mut active = usize.ZERO
        let mut argument = usize.ZERO
        while argument < arguments.length {
          if Module.span(hir, Module.child(hir, arguments, argument)).end < offset {
            active = argument + usize.ONE
          }
          argument = argument + usize.ONE
        }
        if arguments.length > usize.ZERO && active >= arguments.length {
          active = arguments.length - usize.ONE
          if lastArgumentClosed(hir, arguments, offset) {
            active = arguments.length
          }
        }
        found = Option<CallSyntax>.some(CallSyntax { name: name, active: active, receiver: receiver })
        width = span.end - span.start
      }
    }
    at = at + usize.ONE
  }
  return move found
}

// Whether a comma follows the last argument before `offset`, so the cursor starts a new one.
fn lastArgumentClosed(hir: &Module, arguments: Range, offset: usize) -> bool {
  return Module.span(hir, Module.child(hir, arguments, arguments.length - usize.ONE)).end < offset
}

// One callable body of a module: its declaration, ordinal and block.
struct Enclosing {
  identity: DeclarationId,
  ordinal: usize,
  span: Span,
  block: Span,
}

fn enclosingBody<'s>(port: &StaticPort<'s>, cursor: &AuthoredCursor, offset: usize) -> Option<Enclosing> {
  let indexed = match move StaticPort.sourceAtCursor(port, cursor) {
    Option<&IndexedSource>.Some { value } => value
    Option<&IndexedSource>.None => {
      return Option<Enclosing>.none()
    }
  }
  let hir = IndexedSource.authored(indexed)
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
  let mut chosen = usize.MAX
  let mut width = usize.MAX
  let mut at = usize.ZERO
  while at < declarations.length {
    if let Option<Span>.Some { value: block } = move bodyBlock(hir, declarations[at].local) {
      if block.start <= offset && offset < block.end && block.end - block.start < width {
        chosen = at
        width = block.end - block.start
      }
    }
    at = at + usize.ONE
  }
  if chosen == usize.MAX {
    return Option<Enclosing>.none()
  }
  return Option<Enclosing>.some(enclosingAt(hir, declarations, chosen))
}

// The narrowest declaration with a body whose whole text, header included, holds `offset`.
fn declarationAround<'s>(port: &StaticPort<'s>, cursor: &AuthoredCursor, offset: usize) -> Option<Enclosing> {
  let indexed = match move StaticPort.sourceAtCursor(port, cursor) {
    Option<&IndexedSource>.Some { value } => value
    Option<&IndexedSource>.None => {
      return Option<Enclosing>.none()
    }
  }
  let hir = IndexedSource.authored(indexed)
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
  let mut chosen = usize.MAX
  let mut width = usize.MAX
  let mut at = usize.ZERO
  while at < declarations.length {
    if let Option<Span>.Some { .. } = move bodyBlock(hir, declarations[at].local) {
      let span = Module.span(hir, declarations[at].local)
      if span.start <= offset && offset < span.end && span.end - span.start < width {
        chosen = at
        width = span.end - span.start
      }
    }
    at = at + usize.ONE
  }
  if chosen == usize.MAX {
    return Option<Enclosing>.none()
  }
  return Option<Enclosing>.some(enclosingAt(hir, declarations, chosen))
}

fn enclosingAt(hir: &Module, declarations: &[IndexedDeclaration], at: usize) -> Enclosing {
  let mut block = Span { start: usize.ZERO, end: usize.ZERO }
  if let Option<Span>.Some { value } = move bodyBlock(hir, declarations[at].local) {
    block = value
  }
  return Enclosing {
    identity: DeclarationId.copy(&declarations[at].identity),
    ordinal: at,
    span: Module.span(hir, declarations[at].local),
    block: block,
  }
}

effect fn bodiesOf<'s>(port: &StaticPort<'s>, cursor: &AuthoredCursor) -> List<Enclosing> ! OutOfMemoryError ? &mut Allocator {
  let mut bodies = List<Enclosing>.make()
  if let Option<&IndexedSource>.Some { value: indexed } = move StaticPort.sourceAtCursor(port, cursor) {
    let hir = IndexedSource.authored(indexed)
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let mut at = usize.ZERO
    while at < declarations.length {
      if let Option<Span>.Some { .. } = move bodyBlock(hir, declarations[at].local) {
        run List<Enclosing>.append(&mut bodies, enclosingAt(hir, declarations, at))
      }
      at = at + usize.ONE
    }
  }
  return move bodies
}

effect fn checked<'s>(port: &mut StaticPort<'s>, enclosing: &Enclosing) -> Option<Shared<TypedBody>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  if let Option<Shared<Result<Answer, NoRejection>>>.Some { value } = move run StaticPort.demandBody(
    &mut port.*,
    &enclosing.identity,
    enclosing.span
  ) {
    return Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&value, checkedBody)
  }
  return Option<Shared<TypedBody>>.none()
}
