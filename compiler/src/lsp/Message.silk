//! JSON-RPC 2.0 messages: reading a decoded message's method and id, and writing framed responses.

import ReleaseVersion
import silk.box { Box }
import silk.effect { Effect }
import silk.json_output { JsonOptions, JsonOutput }
import silk.json_scanner { JsonError }
import silk.json_value { Json, JsonChild, Value }
import silk.list { List }
import silk.option { Option }
import silk.result { Result }
import silk.slice { Slice }
import silk.string { InvalidUtf8, String }
import silk.usize
import silk.writer { Writer, WriterError }

/// The JSON-RPC and language server error codes the server reports.
pub enum ErrorCode {
  ParseError,
  InvalidRequest,
  MethodNotFound,
  ServerNotInitialized,
}

/// How positions count columns: UTF-8 bytes when the client offers it, else UTF-16 code units.
pub enum PositionEncoding {
  Utf8,
  Utf16,
}

/// The content of one response.
pub union Reply {
  /// The `initialize` result: the server's capabilities and identity.
  Initialized { pub encoding: PositionEncoding },
  /// A `null` result.
  Null,
  /// An error response.
  Failure { pub code: ErrorCode, pub message: string<'static> },
}

/// The message's method, absent for a response or a malformed message.
pub fn method<'a>(message: &'a Value) -> Option<string<'a>> {
  return Json.asString(Json.field(message, "method"))
}

/// The request id; a notification has none.
pub fn id<'a>(message: &'a Value) -> Option<&'a Value> {
  return Json.field(message, "id")
}

/// Reports whether `message` is the `exit` notification.
pub fn isExit(message: &Value) -> bool {
  return names(&method(message), "exit")
}

/// Reports whether `method` is present and spells `name`.
pub fn names(method: &Option<string>, name: string) -> bool {
  return match &method.* {
    Option<string>.Some { value } => same(String.utf8Bytes(value), String.utf8Bytes(name))
    Option<string>.None => false
  }
}

/// The encoding `initialize` selects from the client's `general.positionEncodings`.
pub fn negotiate(initialize: &Value) -> PositionEncoding {
  let offered = Json.fieldAt(
    Json.fieldAt(Json.fieldAt(Json.field(initialize, "params"), "capabilities"), "general"),
    "positionEncodings"
  )
  return match move offered {
    Option<&Value>.Some { value } => match &value.* {
      Value.Array { values } => {
        let listed = List<JsonChild>.asSlice(&Box<List<JsonChild>>.get(&values)[0])
        let mut at = usize.ZERO
        while at < listed.length {
          if let JsonChild.Item { value: item } = &listed[at] {
            if names(&Json.asString(Option<&Value>.some(&item)), "utf-8") {
              return PositionEncoding.Utf8
            }
          }
          at = at + 1
        }
        return PositionEncoding.Utf16
      }
      _ => PositionEncoding.Utf16
    }
    Option<&Value>.None => PositionEncoding.Utf16
  }
}

/// Writes one framed response to the request whose id is `id`, which is `null` for a parse error.
///
/// # Details
///
/// The content is written twice, once to count its bytes for the header and once for real, so
/// nothing is buffered.
pub effect fn respond(id: &Value, reply: &Reply) -> ()
  ! JsonError | WriterError
  ? &mut Writer {
  let mut counter = Counter { length: usize.ZERO }
  run content(id, reply) |> Effect.provideMut<Writer>(&mut counter)
  run Writer.writeAll(b"Content-Length: ")
  run writeDecimal(counter.length)
  run Writer.writeAll(b"\r\n\r\n")
  run content(id, reply)
  return run Writer.flush()
}

effect fn content(id: &Value, reply: &Reply) -> ()
  ! JsonError | WriterError
  ? &mut Writer {
  run Writer.writeAll(b"{\"jsonrpc\":\"2.0\",\"id\":")
  run Json.write(id)
  match &reply.* {
    Reply.Initialized { encoding } => {
      run Writer.writeAll(b",\"result\":{\"capabilities\":{\"positionEncoding\":")
      match encoding {
        PositionEncoding.Utf8 => run JsonOutput.writeString("utf-8")
        PositionEncoding.Utf16 => run JsonOutput.writeString("utf-16")
      }
      run Writer.writeAll(b"},\"serverInfo\":{\"name\":\"silk\",\"version\":")
      match String.fromUtf8(ReleaseVersion.value()) {
        Result<string, InvalidUtf8>.Success { value } => run JsonOutput.writeString(value)
        Result<string, InvalidUtf8>.Failure { error: _ } => run Writer.writeAll(b"null")
      }
      run Writer.writeAll(b"}}")
    }
    Reply.Null => run Writer.writeAll(b",\"result\":null")
    Reply.Failure { code, message } => {
      run Writer.writeAll(b",\"error\":{\"code\":")
      run Writer.writeAll(codeText(code))
      run Writer.writeAll(b",\"message\":")
      run JsonOutput.writeString(message)
      run Writer.writeAll(b"}")
    }
  }
  return run Writer.writeAll(b"}")
}

fn codeText(code: ErrorCode) -> &'static [u8] {
  return match code {
    ErrorCode.ParseError => b"-32700"
    ErrorCode.InvalidRequest => b"-32600"
    ErrorCode.MethodNotFound => b"-32601"
    ErrorCode.ServerNotInitialized => b"-32002"
  }
}

effect fn writeDecimal(value: usize) -> ()
  ! WriterError
  ? &mut Writer {
  let mut divisor: usize = 1
  while value / divisor >= 10 {
    divisor = divisor * 10
  }
  while divisor > 0 {
    run Writer.writeAll(Slice.view<u8>(b"0123456789", value / divisor % 10, 1))
    divisor = divisor / 10
  }
  return ()
}

// Counts the bytes written through it.
struct Counter {
  length: usize
}

impl Counter {
  effect fn writeAll(self: &mut Self, bytes: &[u8]) -> ()
    ! WriterError {
    self.length = self.length + bytes.length
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError {
    return ()
  }
}

impl Writer for Counter {
  writeAll: Counter.writeAll

  flush: Counter.flush
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + 1
  }
  return true
}
